  ISSN={},
  month={Nov},}@INPROCEEDINGS{11290366,
  author={Sun, Ruihan and Li, Dian and Yan, Yan and Wu, Kui},
  booktitle={2025 5th International Conference on Artificial Intelligence, Automation and High Performance Computing (AIAHPC)}, 
  title={Research on of Heterogeneous Parallel Algorithm for High-Dimensional FFT on GPGPU}, 
  year={2025},
  volume={},
  number={},
  pages={893-897},
  abstract={The Fast Fourier Transform (FFT), as a fundamental algorithm in signal processing, has long been a focus of research on efficient computational methods. Given that General-Purpose Graphics Processing Units (GPGPUs) possess significantly more independent computing units than CPUs, they are well-suited for parallel computing tasks. Accordingly, an optimized radix-2 Stockham FFT algorithm based on the GPGPU architecture has been developed. The optimization employs a multi-step approach to enhance computational parallelism, incorporates a step-merging strategy to reduce kernel launch overhead and global memory access frequency, and utilizes the Stockham algorithm to improve global memory access patterns while minimizing shared memory bank conflicts. Experimental evaluation conducted on an Intel Xeon W5 and NVIDIA RTX A6000 platform demonstrated significant performance improvements over FFTW (v3.3.10). Maximum speedups of 5.40× for one-dimensional real-number transforms and 12.07× for multidimensional real-number transforms were achieved. For complex-number FFTs, speedups reached 6.52× (one-dimensional) and 19.06× (multidimensional).},
  keywords={Systematics;Fast Fourier transforms;Signal processing algorithms;Transforms;Signal processing;Parallel architectures;Resource management;Parallel algorithms;Optimization;Testing;GPGPU;Fast Fourier Transform;Stockham algorithm;Multi-step FFT algorithm;Parallel computing},
  doi={10.1109/AIAHPC66801.2025.11290366},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11350094,
  author={Fan, Yunge},
  booktitle={2025 IEEE 5th International Conference on Data Science and Computer Application (ICDSCA)}, 
  title={Performance Optimization of Knowledge Transfer-based Personalized Federated Learning Algorithm KT_PFL for Image Classification}, 
  year={2025},
  volume={},
  number={},
  pages={342-348},
  abstract={With the rapid development of artificial intelligence, communication between different users and clients is becoming increasingly close. Federated learning is a novel approach that allows multiple clients to train models on their own devices and then upload the trained models to a centralized server for merging, effectively protecting user data and privacy. This paper implements a personalized federated learning algorithm, KT_PFL, based on knowledge drift. This innovatively combines the advantages of federated learning and skillfully balances the conflict between global knowledge and local model training at the client level, improving the model's personalized performance and generalization capabilities. This paper uses the MNIST and Cifar100 image classification datasets as typical datasets, and employs a convolutional neural network (CNN) to validate the KT_PFL algorithm. This paper examines in detail the impact of changes in three key hyperparameters of KT_PFL—global knowledge weight (alpha), knowledge distillation temperature (T), and momentum—on KT_PFL's performance. This study demonstrates that KT_PFL effectively addresses the performance degradation of federated learning due to data heterogeneity.},
  keywords={Training;Privacy;Accuracy;Federated learning;Classification algorithms;Convolutional neural networks;Protection;Knowledge transfer;Optimization;Image classification;federated learning;personalized federated learning;knowledge transfer;knowledge distillation;convolutional neural network},
