  abstract={Summary <p>Artificial Intelligence (AI) builds machines to work as human beings by communicating the intelligence to the machines. AI highlights the creation of intelligent machines that accept the desired input data, work on it, operate, and respond like human beings. It is also used for making decisions by reading the real&#x2010;time data, recognizing the given scenario, and finally responding to the structured set of data fed to interpret the conclusion. To build intelligent machines it is vital to understand the function of the human brain. The machines can only act, operate and react according to the information available about the scenario under which it works. Thus the AI must contain sufficient information which is a tedious task. Hence, to make a machine into a computer&#x2010;controlled robot or designing software that performs and responds exactly the way a human being does, began the development of AI. The set of inputs will have many classifications and hence requires supervision that is mathematically analyzed by Machine Learning technology. This technology has higher challenges where the information required for the intelligent system will be of higher volume and each time the information must be updated. The set of software programs has no proper guidelines which makes it inefficient in some cases. These challenges can be controlled by some techniques that rectify the error, alter the data depending on scenarios and boost the speed of execution by optimizing the efficiency. Some frameworks come up with the implementation of various intelligent systems. Feature extraction framework identifies a minimal set of informative attributes from the provided dataset assuring zero correlation. A deep learning framework drastically reduces the learning time of models with the usage of parallel&#x2010;computing GPUs. A Neural Network framework consists of interconnections where each node calculates the weighted sum of values passed on to its input and after a series of epochs the other network parameters merge to optimal values ending up with the appropriate model. AI plays a major role in many sectors. With the enhancement, it improves the quality of our lives or it may show the negative effects of it.</p>},
  keywords={Biomedical monitoring;Wireless communication;Medical services;Diabetes;Mesh networks;Wireless sensor networks;Medical diagnostic imaging;Patient monitoring;Biosensors;Servers},
  doi={10.1002/9781119792161.ch9},
  ISSN={},
  publisher={Wiley},
  isbn={9781119792154},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10954807},}@INPROCEEDINGS{11402669,
  author={Lim, Kimsreng and Prum, Sophea},
  booktitle={2025 International Conference on Advances in Machine Intelligence, and Cybersecurity Technologies (AMICT)}, 
  title={A Hybrid Data Collection Framework for Anomaly Detection in Modbus-Based IIoT Networks}, 
  year={2025},
  volume={},
  number={},
  pages={60-65},
  abstract={The lack of realistic and protocol-agnostic datasets remains a challenge for anomaly detection under Industrial Internet of Things (IIoT) settings, especially for traditional protocols like Modbus/TCP. This paper presents a modular framework that merges simulated industry operations, controlled internal attacks, and spontaneous real-world adversarial interactions captured through a publicly exposed honeypot. The architecture uses a multi-node structure to aggregate benign and malicious Modbus traffic with automated labeling and detailed protocol feature extraction. Our dataset contains over 47 million flows with a benign-to-malicious ratio of about 1:19, resulting from the combination of honeypot captures and internal simulations. Using this dataset, multiple conventional machine learning algorithms (RandomForest, XGBoost, KNN) achieved around 0.99 F1-scores and 0.97 AUC, while deep learning models (MLP, LSTM) reached up to 0.9864 AUC. Unlike research focused around detection algorithms or isolated honeypots, our research combines architectural construction, scalable dataset acquisition, and extensive empirical analysis, demonstrating its effectiveness for IIoT anomaly detection. Additional benchmarking using TON IoT and CICIDS2018 datasets confirmed superior F1-scores and AUC, thereby confirming the dataset’s robustness and generalization capability.},
  keywords={Protocols;Machine learning algorithms;Data collection;Nearest neighbor methods;Robustness;Computer security;Anomaly detection;Machine intelligence;Long short term memory;Industrial Internet of Things;Industrial IoT (IIoT);Modbus/TCP;Honeypot;Anomaly Detection;Data Collection Framework;SCADA Security;Industrial Protocol Security;Cybersecurity Testbed},
  doi={10.1109/AMICT65811.2025.11402669},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11429383,
  author={Amin, Md. Tahsin and Ahmmod, Tanim and Naem, Talukder Naemul Hasan},
  booktitle={2026 5th International Conference on Electrical, Computer & Telecommunication Engineering (ICECTE)}, 
  title={Integrating Machine Learning Ensembles and Large Language Models for Heart Disease Prediction Using Voting Fusion}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Cardiovascular disease is the primary cause of death globally, necessitating early identification, precise risk classification, and dependable decision-support technologies. The advent of large language models (LLMs) provides new zero-shot and few-shot reasoning capabilities, even though machine learning (ML) algorithms, especially ensemble approaches like Random Forest, XGBoost, LightGBM, and CatBoost, are excellent at modeling complex, non-linear patient data and routinely beat logistic regression. This research predicts cardiovascular disease using a merged dataset of 1,190 patient records, comparing traditional machine learning models (95.78% accuracy, ROC-AUC 0.96) with open-source large language models via OpenRouter APIs. Finally, a hybrid fusion of the ML ensemble and LLM reasoning under Gemini 2.5 Flash achieved the best results (96.62 % accuracy, 0.97 AUC), showing that LLMs (78.9 % accuracy) work best when combined with ML models rather than used alone. Results show that ML ensembles achieved the highest performance (95.78% accuracy, ROC-AUC 0.96), while LLMs performed moderately in zero-shot (78.9%) and slightly better in few-shot (72.6%) settings. The proposed hybrid method enhanced the strength in uncertain situations, illustrating that ensemble ML is considered the best structured tabular prediction case, but it can be integrated with hybrid ML-LLM systems to provide a minor increase and open the way to more reliable clinical decision-support tools.},
  keywords={Heart;Accuracy;Large language models;Zero shot learning;Predictive models;Cognition;Data models;Ensemble learning;Cardiovascular diseases;Reliability;Machine Learning;Large Language Models;Voting Fusion;Heart Disease Prediction;Ensemble Learning;Zero-shot Learning;Few-shot Learning},
  doi={10.1109/ICECTE69292.2026.11429383},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11251840,
  author={Babu, D Vidyanadha and Prasad, G Siva and Al-Safarini, Maram Y. and Manideep, B and Reddy, Uma and Shankar, S. Vijay},
  booktitle={2025 International Conference on Recent Innovation in Science Engineering and Technology (ICRISET)}, 
  title={Resource Efficient Image Super-Resolution for FPGA-Based Optimized Deep Learning – An Innovative Target Detection Model}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The Resource Efficient Image Super-Resolution for FPGA-Based Optimized Deep Learning – An Innovative Target Detection Model (REISFD) model is a deep learning model that uses FPGA acceleration for real-time image classification on devices with limited resources. It merges advanced convolutional neural networks with FPGA optimizations to ensure fast and energy-efficient performance without sacrificing accuracy. The model is designed for 10-class tasks using the CIFAR-10 dataset and relies on pre-trained VGG16 and VGG19 networks that have been improved through techniques like data augmentation and normalization. The model uses Xilinx's DPUCZDX8G for efficiency and low power on an Avnet Ultra96-V2 board with a Zynq UltraScale MPSoC FPGA. It includes optimized LSTM structures to process sequential data. Evaluation results show that REISFD outperforms traditional models in classification accuracy while minimizing hardware needs and inference times. REISFD model achieves over 90% accuracy in most CIFAR-10 classes, making it ideal for IoT, embedded AI, and edge computing applications, showcasing the benefits of deep learning with FPGA acceleration.},
  keywords={Accuracy;Computational modeling;Superresolution;Object detection;Hardware;Real-time systems;Internet of Things;Field programmable gate arrays;Optimization;Long short term memory;Internet of Things (IoT);Artificial Intelligences (AI)},
  doi={10.1109/ICRISET64803.2025.11251840},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11465541,
  author={Totare, Reshma and Gonjari, Sneha and Uttekar, Siddhi and Abuj, Ishwari},
  booktitle={2026 IEEE International Conference on Interdisciplinary Approaches in Technology and Management for Social Innovation (IATMSI)}, 
  title={Mockhire: Adaptive Interview Training and Recruitment Automation Through Objective AI Assessment}, 
  year={2026},
  volume={4th},
  number={},
  pages={1-6},
  abstract={The rapid growth of competitive hiring environments has increased the need for effective interview preparation and objective candidate evaluation methods. Traditional mock interview practices often depend on human evaluators, which limits scalability, provides subjective feedback, and leads to inconsistent assessment standards. To tackle these issues, this paper introduces MockHire, an AI-driven platform for interview training and recruitment support. It aims to improve candidate readiness and recruiter efficiency. The system allows candidates to take adaptive mock interviews, receive structured, data-driven feedback, and monitor their progress through performance analytics. At the same time, recruiters get tools to manage job postings, track applications, and assess candidate responses using standardized AI-generated insights. MockHire combines resume analysis, dynamic question changes, automated scoring, and visual feedback dashboards to support decision-making based on evidence. By merging interview simulation, assessment, and application tracking into a single framework, this platform reduces evaluation bias, saves recruiter time, and provides a scalable solution for modern recruitment processes.},
  keywords={Feedback;Circuits;Integrated circuits;MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits;Protocols;Routing;Communication systems;HTTP;AI-assisted Recruitment;Mock Interview Simulation;Candidate Performance Evaluation;Intelligent Hiring Systems},
  doi={10.1109/IATMSI68868.2026.11465541},
  ISSN={},
  month={March},}@INPROCEEDINGS{11436440,
  author={Mescarenhas, Jones and Dhas, Julia Punitha Malar and Isravel, Deva Priya},
  booktitle={2026 5th International Conference on Communication, Computing and Electronics Systems (ICCCES)}, 
  title={Adaptive Micro-Break Scheduling Using Reinforcement Learning and Multi-Modal Fatigue Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1575-1581},
  abstract={Modern digital workplaces demand intelligent solutions, while prolonged computer usage leads to cognitive and physical exhaustion. A framework for adaptive learning is presented in this research, which can determine the intervals for micro-breaks that are most beneficial for user ergonomics and wellness. The proposed method involves the use of multimodal sensing to monitor posture, typing rhythm, mouse movement, and noise levels in the environment, thus allowing very precise identification of mental load and fatigue. Reinforcement learning acts as the decision-making engine that alters its actions in real-time based on continuous user feedback and thus gives personalized and context-aware break recommendations. A hybrid structure merges the current ergonomic standards with adaptive, data-driven refinement to achieve a kind of compromise between scientific reasoning and personal experience. The model considers environmental and behavioral inputs and, while supporting user productivity, it also prevents the occurrence of physical discomfort. A large language model that can explain fast cognitive state assessments based on the surrounding context is integrated into the system and thus increases transparency. The entire framework operates as a continuous feedback loop that customizes itself according to user behavior and workspace mobility, hence ensuring that performance and wellness outcomes are continuously increased.},
  keywords={Productivity;Ergonomics;Multimodal sensors;Employment;Reinforcement learning;Fatigue;Rhythm;Real-time systems;Telecommunication computing;Standards;Digital ergonomics;reinforcement learning;multimodal sensing;human-computer interaction;workplace wellness},
  doi={10.1109/ICCCES62661.2026.11436440},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{9991392,
  author={Tao, Wei and Wen, Yuanqiao and Zhu, Man and Sui, Zhongyi and Cheng, Xu and Zhang, Weidong and Shao, Yangyang},
  booktitle={2022 International Conference on High Performance Big Data and Intelligent Systems (HDIS)}, 
  title={Vessel Behavior Decision-making and Planning for Autonomous Surface Vessels in Inland Waterway}, 
  year={2022},
  volume={},
  number={},
  pages={259-265},
  abstract={For collision avoidance in waterway channels, Autonomous surface vessels (ASVs) need a collision-avoidance planning algorithm, but increasing sailing efficiency while ensuring safety is challenging. Because collision avoidance is a process involving numerous behaviors, achieving optimum trajectory outcomes in all cases with a single algorithm is difficult. We present a vessel behavior decision and motion planning framework for ASVs that considers impediments in this study's waterway. Our study uses a combination of state machines (SM) and model predictive control (MPC) to develop behavior and motion plans in real-time that meet kinodynamic and collision constraints in waterway channels. The suggested planning algorithm aims to maximize sailing efficiency while maintaining safety. The suggested algorithm makes use of each approach to achieve optimality and real-time performance by merging two methods in a hierarchical structure. The SM method identifies maneuver states of vessel behavior that can provide safety and establishes the best obstacles and limitations in each state using the SM. The MPC devises an ideal path that takes into account forecast uncertainty, safety, and efficiency. Simulation results indicate the vessel is more successful in regulation-compliance avoidance of impediments. The best trajectory was developed in a multivessel scenario while assuring superior safety to the system. The autonomous decision and planning system for vessels increases control performance while boosting traffic organization capacity and efficiency.},
  keywords={Decision making;Prediction algorithms;Real-time systems;Behavioral sciences;Safety;Planning;Trajectory;Autonomous surface vessels;Vessel behavior;Decision-making;Collision avoidance},
  doi={10.1109/HDIS56859.2022.9991392},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11234172,
  author={Anjum, Ayesha and K, Spoorthi C and Kumar, Sujeet and S, Swetha and Veena},
  booktitle={2025 2nd International Conference on New Frontiers in Communication, Automation, Management and Security (ICCAMS)}, 
  title={Efficient Medical Analysis using High Resolution Images with Text and Image GAN}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={One of the promising recent advances in medical imaging is indeed the successful exploration of GANs for applications such as image super-resolution and text enhancement. Most GAN-based approaches, however, have been driven for a single modality: enhancing the quality of images or text clarity-while simultaneously eliciting little attention towards the two interrelated aspects. A new dual GAN framework is therefore proposed to overcome this limitation by combining the merits of both Image Super Resolution GAN and Text Enhancement GAN. In this merged approach, both the resolution of images and the adequacy of the textual annotation improved to enhance diagnostic accuracy as well as improve the visualization of small lesions and tissue structures in medical images. The system works on the principle of cross-domain benefit sharing; enhancement in either quality, the image, or the text, naturally boosts the quality of the other. The performance of the proposed dual GAN system is measured through some key metrics, such as Peak Signal-to-Noise Ratio (PSNR), Structural Similarity Index (SSIM) and Optical Character Recognition (OCR) accuracy to provide clear evidence of significant improvement in both image and text qualities as compared with other conventional methods. This innovation improves the process of clinical decision-making in the sense that clearer images and text are more accurate. The approach has tremendous potential for much wider practical applications: document scanning, surveillance, astronomy, and microscopy-all applications where textual and visual clarity are important for precision and analysis.},
  keywords={Visualization;Accuracy;PSNR;Annotations;Forensics;Superresolution;Optical character recognition;Generative adversarial networks;Lesions;Cancer;Medical imaging;super-resolution;generative adversarial networks;image processing;PSNR;SSIM;SRGAN;DualGAN},
  doi={10.1109/ICCAMS65118.2025.11234172},
  ISSN={},
  month={July},}@ARTICLE{11266901,
  author={Rahman, Aqeel Ur and Campagna, Nicola and Pellitteri, Filippo and Tommaso, Antonino Oscar Di and Miceli, Rosario},
  journal={IEEE Open Journal of Industry Applications}, 
  title={Cascaded Lyapunov-Based Hybrid Control of Multiphase Interleaving Converters for Power-to-Hydrogen in DC Microgrid}, 
  year={2025},
  volume={6},
  number={},
  pages={836-851},
  abstract={In this article, the control of a photovalatic (PV)-battery-based dc microgrid is presented to power an electrolyzer-based hydrogen system. The three-phase interleaving topology is considered for three different converters: an interleaving boost converter, an interleaving four-switch single-inductor buck–boost converter, and an interleaving buck converter. MPPT and droop-based control are recommended for maximum power extraction from the PV system and regulation of the dc-bus voltage. A cascaded hybrid nonlinear controller is developed for current and voltage control, merging the advantages of both linear and nonlinear control theory. The design ensures an uninterrupted power supply to the electrolyzer for hydrogen production. The algorithm is simulated in MATLAB/Simulink and validated through rapid control prototyping using a TI C2000 microcontroller unit (MCU) and a Typhoon 404 device for real-time results. Moreover, a comparative analysis with other state-of-the-art control structures is also presented to show the efficiency of the proposed controller. The simulation results, comparative analysis, and hardware results under different conditions confirm the adaptability of the proposed control algorithms for real applications.},
  keywords={Microgrids;Inductors;Batteries;Stability analysis;Hydrogen;Topology;Production;Power system stability;Capacitance;Voltage control;DC microgrids (MGs);multiphase interleaving converters;hydrogen systems;dc–dc converter;current sharing control;Lyapunov theory;cascaded control},
  doi={10.1109/OJIA.2025.3635867},
  ISSN={2644-1241},
  month={},}@ARTICLE{11270010,
  author={Lehmann, Dirk J. and Blum, Kai M. and Rubio-Sánchez, Manuel and Simon, Konrad},
  journal={IEEE Transactions on Visualization and Computer Graphics}, 
  title={Interactive Composition Operators An Alternative Approach for Selecting Linear Embedding Parameters}, 
  year={2026},
  volume={32},
  number={1},
  pages={385-395},
  abstract={Linear embeddings support interactive visual exploration by mapping high-dimensional (nD) data into a two-dimensional space. Despite their popularity, selecting meaningful projection parameters remains a key challenge due to the infinite 2$n$-dimensional parameter space. Once an informative projection is found, users often seek similar ones that emphasize specific items differently while preserving global structure. For instance: Do clusters become outliers under slight changes? Can grouped items separate-or merge-through parameter adjustments? Which changes to the embedding parameters lead to such projections - and do they exist at all? Answering these questions efficiently is critical for effective visual search. Yet, current methods-such as projection tours or manual parameter tuning-are time-consuming and risk overlooking important views, including those of specific interest. We propose Composition Operators, a mathematical foundation for a novel set-of-point manipulation concept for linear embeddings-such as Star Coordinates-as an alternative approach to selecting informative embedding parameters in a more controllable manner with respect to the desired outcome. Users specify item-based constraints on the projection result; the corresponding 2n parameters are then derived automatically, eliminating the need to exhaustively search the entire parameter space to get a similar outcome. Neither the embedding space nor the set of parameters is altered - only the mechanism for navigating and selecting parameters is redefined. We provide closed-form solutions for this and demonstrate our interactive prototype on nD datasets from the UCI repository.},
  keywords={Stars;Iterative methods;Aerospace electronics;Visualization;Navigation;Manuals;Closed-form solutions;Tuning;Prototypes;Optimization;Star Coordinates;Multivariate Projections;Composition Operators;Multidimensional Data},
  doi={10.1109/TVCG.2025.3634874},
  ISSN={1941-0506},
  month={Jan},}@INPROCEEDINGS{11341293,
  author={Yasaswini, Vanapalli and G M, Harshitha. and Kotla, Praneetha and Janakamma, Ch. and E, Dilipkumar.},
  booktitle={2025 International Conference on Communication, Computer, and Information Technology (IC3IT)}, 
  title={Hierarchical Convolutional Neural Network based Transformer for AI-Assisted Optical Character Recognition in Low-Resource Languages}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={From the past few years, accurate recognition of low-resource non-Latin scripts, like Khmer, remained challenging because of the complex character structures, variable textline lengths and limited annotated datasets. In this research, Hierarchical CNN-Transformer Network (Hi-CTNet) is proposed which is a unified and modular framework for Khmer text recognition that efficiently handles arbitrarily long textlines by preserving fine-grained character details. The proposed Hi-CTNet integrates hierarchical Convolutional Neural Network (CNN) backbone to extract multi-level visual features, multi-scale dynamic patching module to adaptively encode dense and sparse character regions and a transformer encoder with multi-scale attention for capturing local and global dependencies. To reduce computational complexity for long sequences, an enhanced chunking and hierarchical selfattention strategy is utilized by allowing linear-scale processing without loss of context. The autoregressive transformer decoder utilizes context-aware attention among all chunks for predicting Khmer character sequences with high accuracy, while soft chunk-merging and global context recalibration ensures the seamless recognition across boundaries. The proposed HiCTNet achieved better results in terms of Params (42.50), FLOPS (12.75) and Character Error Rate (CER) (0.35%) when compared with existing models.},
  keywords={Visualization;Accuracy;Ultraviolet sources;Optical character recognition;Transformers;Feature extraction;Decoding;Convolutional neural networks;Character recognition;Computational complexity;chunking;hierarchical convolutional neural network;low-resource languages;optical character recognition;transformer},
  doi={10.1109/IC3IT66137.2025.11341293},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11209608,
  author={Manju, A. and Rani, J. Jhansi and Vyshnavi, S. Sri and Nadh, A. Kedhar},
  booktitle={2025 2nd International Conference on Computing and Data Science (ICCDS)}, 
  title={High-Resolution Pneumonia Detection and Multi-Class Classification Using VGGNet-19 with Transfer Learning and Explainable AI for Medical Imaging}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Pneumonia is a major global health burden requiring rapid and accurate diagnosis for effective treatment. Deep learning, specifically Convolutional Neural Networks (CNNs), has shown excellent potential in automating pneumonia discovery. However, most existing models focus on binary classification (normal vs. pneumonia) and plan out veracity over explainability, confining real-experience acceptance. This study presents a novel multi-class pneumonia classification foundation resorting to VGG19 with transfer learning to vary between normal, bacterial pneumonia, and viral pneumonia—ensuring a more clinically relevant diagnosis. To improve model generalization, we merge leading preprocessing techniques, containing wavelet transformation for noise reduction and elastic transformation for improved robustness. Unlike prior methods that depend on complex attention-based mechanisms, our approach prioritizes effectiveness and interpretability through Grad-CAM, admitting visualization of crucial areas in chest X-ray images. By balancing accuracy, generalizability, and explainability, our foundation supports a more honest AI-driven diagnostic tool for pneumonia classification. Our methods undergo rigorous evaluation on a structured pneumonia dataset, demonstrating competitive performance. The results climax the trade-off between interpretability and model accuracy, emphasizing the need for clinically transportable AI answers. By trying real-world challenges in medical imaging, it contributes to the emergence of robust, see-through, and reliable AI-compelled diagnostic orders, paving the way for improved patient outcomes and automated radiology progress.},
  keywords={Wavelet transforms;Deep learning;Pneumonia;Accuracy;Explainable AI;Computational modeling;Transfer learning;Noise reduction;Data models;X-ray imaging;Pneumonia Classification;VGG19;Transfer Learning;Chest X-ray Analysis;Multi-Class Classification;Grad-CAM;Wavelet Transformation;Elastic Transformation},
  doi={10.1109/ICCDS64403.2025.11209608},
  ISSN={},
  month={July},}@ARTICLE{11180916,
  author={Yan, Ying and Zhang, Huaguang and Sun, Jiayue and Ming, Zhongyang},
  journal={IEEE Transactions on Neural Networks and Learning Systems}, 
  title={Virtual Target-Oriented Neural Learning for Robust Optimal Tracking Control of Discrete Strict-Feedback Systems}, 
  year={2026},
  volume={37},
  number={1},
  pages={261-273},
  abstract={This article proposes a hierarchical neural learning (HNL) algorithm for optimal tracking control (OTC) of nonlinear strict-feedback systems (SFSs) with unmatched disturbances (uMDs) and unknown dynamics. Leveraging the recursive structure of SFSs, we introduce the virtual target (VT) construction scheme in which each VT is a nonlinear mapping of the current state and desired output, thereby eliminating the noncausal that typically plagues discrete-time SFS control. The VTs serve as auxiliary inputs for low-order subsystems, while a time-varying affine Hamilton–Jacobi–Isaacs (HJI) formulation establishes an explicit relationship between the auxiliary control and the disturbance. The controller is synthesized directly from input–output data, removing the need for an accurate plant model. Within an adaptive dynamic programming (ADP) framework, we further enhance the neural architecture by replacing the conventional action network with a tracking network (T-network) whose energy function merges gradient information with future tracking errors, ensuring that each policy update simultaneously reduces control effort and improves tracking accuracy. Simulations confirm that the proposed HNL scheme achieves outstanding performance in both (optimal) tracking modes, exhibiting strong robustness to uMDs and significant model uncertainties.},
  keywords={Target tracking;Backstepping;Accuracy;Mathematical models;Trajectory;Optimal control;Dynamic programming;Adaptation models;Sun;Heuristic algorithms;Adaptive dynamic programming (ADP);hierarchical neural learning (HNL);optimal tracking control (OTC);strict-feedback systems (SFSs);virtual targets (VTs)},
  doi={10.1109/TNNLS.2025.3604566},
  ISSN={2162-2388},
  month={Jan},}@INPROCEEDINGS{11468815,
  author={Mansoori, Aftab and Sharma, Urvashi and Chaudhary, Ritik and Ahsan, Md},
  booktitle={2026 International Conference on Computing, Sciences and Communications (ICCSC)}, 
  title={Pet Connect: A Multimodal AI and ML Framework for Proactive Pet Disease Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The conventional vets diagnostic procedures tend to be mostly reactive and in most of the cases when a disease is detected, the companion animal has already exhibited some form of symptoms and thus the delay in treatment. Recent developments in artificial intelligence (AI) and machine learning (ML) provide the possibility of the prevention and non-invasive detection of diseases based on continuous health monitoring. The given paper provides an overview of AI-based solutions to pet disease detection that are identified in the literature of 2019 to 2025 and refers to three main modalities, namely, computer vision, wearable sensor-based physiological surveillance, and vocal and respiratory signals acoustic analysis. The paper identifies the drawbacks of unimodal systems and stress the technical benefits of multimodal fusion structures in the minimization of false negatives and enhanced diagnostic robustness. The paper, founded on this analysis, presents the conceptual framework of Pet Connect that merges heterogeneous data streams with deep learning-based fusion tactics to facilitate the early detection of diseases and make timely veterinary interventions. The main issues such as the lack of data, the ability to explain the model, and the use of all models on resourcerestricted edge computers are addressed, and the future perspectives of scalable and clinically viable multimodal veterinary AI systems are presented.},
  keywords={Sensor systems;Aerospace and electronic systems;Contacts;Filtering;Circuits and systems;Filters;Internet of Things;Videos;Communication systems;Protocols;Acoustic Analysis;Artificial Intelligence;Companion Animals;Computer Vision;Multimodal AI;Wearable Sensors},
  doi={10.1109/ICCSC67078.2026.11468815},
  ISSN={},
  month={Feb},}@ARTICLE{11271854,
  author={Wu, Zirui and Cao, Sheng and Xia, Shuyin and Huang, Butian and Wang, Guoyin and Zhang, Xiaosong},
  journal={IEEE Transactions on Network Science and Engineering}, 
  title={GBShard: Adaptive Sharding for Blockchain Network via Granular-Ball Partitioning}, 
  year={2026},
  volume={13},
  number={},
  pages={4107-4123},
  abstract={Blockchain scalability remains constrained by cross-shard transaction overhead and workload imbalance in conventional sharding architectures. To address these limitations, we propose GBShard, an adaptive sharding method grounded in granular-ball computing theory. The method partitions blockchain transactions to shards through iterative splitting and merging of coarse-grained granular-ball structures, enabling adaptive shard formation with minimized cross-shard transactions. A multi-granularity dynamic sharding algorithm further optimizes topology by redistributing granular-ball groups in dynamic scenarios, achieving incremental sharding adjustment while reducing the overhead of global-repartitioning. Experimental validation using real-world Ethereum transaction traces demonstrates GBShard’s superiority over Monoxide-based sharding schemes: it achieves 1.3–1.8× higher throughput, 34–42% lower transaction latency, and reduces cross-shard transactions by 23–50%. These results suggest granular-ball partitioning as a viable strategy for adaptive blockchain scaling.},
  keywords={Sharding;Blockchains;Throughput;Resource management;Scalability;Heuristic algorithms;Partitioning algorithms;Costs;Adaptive systems;Topology;Blockchain sharding;granular-ball computing;adaptive sharding;account allocation},
  doi={10.1109/TNSE.2025.3639250},
  ISSN={2327-4697},
  month={},}@INPROCEEDINGS{11449325,
  author={Zhuang, You-Yuan and Chen, Yi-Shen and Hsieh, Jen-Wei and Chang, Yuan-Hao},
  booktitle={2025 IEEE 14th Non-Volatile Memory Systems and Applications Symposium (NVMSA)}, 
  title={SplitLSM: Unlocking Write Efficiency with Zone-Aware Compaction for LSM-Trees on Zoned Namespace SSDs}, 
  year={2025},
  volume={},
  number={},
  pages={18-23},
  abstract={Zoned Namespace SSDs (ZNS SSDs) have emerged as a promising solution for write-intensive workloads due to their sequential write model, which aligns well with the characteristics of Log-Structured Merge-Tree (LSM-tree) commonly used in key-value (KV) stores. However, directly applying LSM-tree-based KV stores on ZNS SSDs may result in performance degradation. Our investigation reveals that data across different LSM-tree levels exhibit distinct characteristics and lifetimes, which are not adequately considered in general storage systems. To address these issues, we propose SplitLSM, a zone-aware optimization framework designed to improve the performance of LSM-tree-based key-value stores on ZNS SSDs. SplitLSM introduces a novel data allocation strategy that improves data locality and zone utilization in compaction. In addition, we enhance the compaction mechanism by considering data lifetime and zone characteristics, thus reducing unnecessary compactions and mitigating I/O overhead. Experimental results show that SplitLSM achieves up to 32.3% improvement in throughput and reduces compaction time by up to 28% over ZenFS on ZNS SSDs.},
  keywords={Degradation;Nonvolatile memory;Throughput;Compaction;Resource management;Optimization;Zoned Namespace SSDs;LSM-Trees;Key-Value Stores;Write Efficiency;Write amplification},
  doi={10.1109/NVMSA66678.2025.00011},
  ISSN={2575-257X},
  month={Aug},}@INPROCEEDINGS{10957772,
  author={Hao, Wu and Jian, Zheng},
  booktitle={2024 International Conference on Image Processing, Computer Vision and Machine Learning (ICICML)}, 
  title={AMCU-Net: Adaptive Multi-Scale ConvMixer U-Net for Breast Ultrasound Lesion Segmentation}, 
  year={2024},
  volume={},
  number={},
  pages={1001-1006},
  abstract={Breast cancer is the most common malignant tumor affecting women globally, with early detection crucial to improving patient outcomes. Traditional segmentation methods, while proficient in global feature extraction, often fail to capture fine-grained local features across varying scales, resulting in missed detections and inaccurate segmentation of small lesions. To tackle these challenges, a network architecture, AMCU-Net, is proposed, which is designed to enhance segmentation accuracy for lesions of diverse scales and shapes. AMCU-Net adopts a multi-module structure to improve sensitivity to lesions at different scales, thereby enhancing small-lesion capture and optimizing segmentation across multiple resolutions. Furthermore, AMCU-Net integrates Convolutional Block Attention Module and Multi-Scale Attention Gate, dynamically focusing on essential spatial and channel features to bolster feature extraction and ensure effective small-lesion delineation. This approach enables precise boundary segmentation and high accuracy under various resolutions. Additionally, the ConvMixer module is employed to effectively merge multi-scale features through mixed convolution operations, boosting the model's capability to accurately segment complex heterogeneous lesions and adapt to images of different sizes. Experimental results demonstrate that AMCU-Net excels in multi-scale segmentation tasks, significantly advancing small-lesion delineation and overall segmentation performance.},
  keywords={Image segmentation;Adaptation models;Accuracy;Ultrasonic imaging;Sensitivity;Shape;Feature extraction;Breast cancer;Lesions;Spatial resolution;breast ultrasound image;Convolutional Block Attention Module;ConvMixer},
  doi={10.1109/ICICML63543.2024.10957772},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11160589,
  author={Liang, Mingyu and Lin, Guangyi and Guo, Hanlin and Su, Lumei},
  booktitle={2025 6th International Conference on Artificial Intelligence and Electromechanical Automation (AIEA)}, 
  title={A Hybrid Ensemble Learning Approach with Sample and Feature Selection for Imbalanced Classification}, 
  year={2025},
  volume={},
  number={},
  pages={366-373},
  abstract={When handling datasets with class imbalance where there is a significant disparity in the distribution of class labels, traditional classification techniques are often biased towards the majority class, resulting in poor recognition performance for the minority class. To improve classifier performance on imbalanced data, this paper proposes a hybrid ensemble learning strategy called “Hybrid Ensemble Learning strategy of Sample and Feature selection” (HELSF) that integrates a Random Forest classifier. The core idea of the strategy involves two main components. Firstly, a sliding window mechanism is employed to construct multiple distinct feature subsets to increase model diversity. Secondly, a clustering-based hierarchical undersampling technique is utilized to select representative samples from the majority class for each feature subset. By training a base classifier on each such structured subset (comprising a feature subset and a corresponding majority class subsample), HELSF enhances the model's diversity. During the training phase, a weight is assigned to each base classifier based on the performance on a validation set. The overall prediction is made through a weighted vote that merges the predictions from base classifiers. This strategy not only improves classification performance but also enhances interpretability and practicability by reflecting the importance of different feature subsets through the weighting mechanism. Experimental results show that HELSF achieves average Accuracy, F1-score, and AUC of 0.9485, 0.5491, and 0.8891, respectively, on selected KEEL datasets. This indicates that HELSF can achieve optimal classification results in various application scenarios.},
  keywords={Training;Measurement;Accuracy;Optimization methods;Feature extraction;Stability analysis;Windows;Ensemble learning;Tuning;Random forests;Feature Selecting;Ensemble Learning;K-Means;Undersampling;Pareto Front},
  doi={10.1109/AIEA66061.2025.11160589},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11086294,
  author={Saxena, Aditya},
  booktitle={2025 Second International Conference on Cognitive Robotics and Intelligent Systems (ICC - ROBINS)}, 
  title={Enhancing Financial Latent Factor Analysis: Application of Instrumented Principal Component Analysis (IPCA) and Procrustes Alignment}, 
  year={2025},
  volume={},
  number={},
  pages={8-13},
  abstract={This study examines the application of Instrumented Principal Component Analysis (IPCA) to financial datasets, including synthetic data and real-world data from the Wharton CRSP/Compustat Merged Database. By leveraging observable characteristics like volatility, moving averages, and trading volume, IPCA enhances the estimation of latent factors in high-dimensional financial datasets. To address the non-uniqueness of factor loadings across cross-validation folds, Procrustes alignment is employed to standardize the Gamma matrices, ensuring consistency and interpretability across time periods. Findings indicate that, while IPCA captures certain latent structures, the variance explained by the identified factors is modest, highlighting the influence of unobserved dynamics. The alignment of Procrustes significantly improves consistency, reducing discrepancies by more than 70 %. The research underscores the potential of IPCA for financial analysis, particularly when combined with alignment techniques, while emphasizing the limitations of using a restricted set of characteristics.},
  keywords={Sentiment analysis;Instruments;Loading;Noise;Stability analysis;Complexity theory;Macroeconomics;Reliability;Principal component analysis;Synthetic data;Instrumented Principal Component Analysis (IPCA);Latent Factors;Procrustes Alignment;Variance Explained;Financial Econometrics;Cross-Validation;Stock Returns},
  doi={10.1109/ICC-ROBINS64345.2025.11086294},
  ISSN={},
  month={June},}@INPROCEEDINGS{11200451,
  author={Zia, Muhammad Bilal and Zhou, Xujuan and Gururajan, Raj and Chan, Ka Ching},
  booktitle={2025 10th International Conference on Image, Vision and Computing (ICIVC)}, 
  title={P2P-NET: A PSO-Vision Framework for Accurate Detection and Multi-Class Classification of Parasitic Eggs in Human and Animal in Microscopy Images}, 
  year={2025},
  volume={},
  number={},
  pages={81-87},
  abstract={Parasitic infections affecting both humans and animals, particularly gastrointestinal helminths in livestock such as Sheep remain a persistent threat to health systems and agricultural economies around the world. Rapid and accurate identification of parasite eggs on fecal microscopy images is essential for effective diagnosis and intervention. Manual microscopy, still the dominant diagnostic method, remains inherently subjective, time-intensive, and poorly suited to high throughput or remote screening environments. To address these limitations, we present P2P-Net (Pixel-to-Parasite Network), a deep learning framework developed for the high-precision detection and multi-class classification of parasitic eggs. The architecture integrates dual-path feature extraction modules that capture both fine-grained textures and broader contextual structures, feeding into a YOLO-based detection head. Model training is enhanced through dynamic learning rate adjustment via Particle Swarm Optimization (PSO), promoting faster convergence and improved generalization. P2P-Net was initially trained on the Chula-ParasiteEgg-11 dataset encompassing 11 morphologically diverse parasite egg classes, and further evaluated on a curated set of Sheep parasite egg dataset grouped into two classes for evaluation: Egg Class 1 (Haemonchus) and Egg Class 2 (a merged category of Teladorsagia and Trichostrongylus), based on their morphological similarities and the balance of dataset. The proposed method achieved 98. 55\% precision, 98.54\% precision, 98. 45 、% recall and an F1 score of 98. $54 \backslash \%$, exceeding existing state-of-the-art benchmarks. The improved diagnostic reliability offered by P2P-Net holds direct implications for more effective treatment selection and better infection control in both medical and veterinary applications.},
  keywords={YOLO;Training;Accuracy;Head;Microscopy;Computational modeling;Feature extraction;Throughput;Particle swarm optimization;Context modeling;Particle Swarm Optimization (PSO);YOLO Architecture;Dual-Branch Feature Extraction},
  doi={10.1109/ICIVC66358.2025.11200451},
  ISSN={},
  month={July},}@INPROCEEDINGS{10816745,
  author={Vankayala, Shilpita and Shrivastava, Harsda and Borikar, Jiya and Kanisettypalli, Lohitha and K V, Vineetha and S, Ullas},
  booktitle={2024 8th International Conference on Computational System and Information Technology for Sustainable Solutions (CSITSS)}, 
  title={SmartSort Visualizer: Interactive Tool for Optimal Data Sorting and Algorithm Recommendation}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={SmartSort Visualizer, integrating Data Structures and Algorithms with Java, offers a tool for sorting and algorithm analysis. Users can choose from various algorithms, including Bubble Sort, Selection Sort, Insertion Sort, Merge Sort, Radix Sort, Heap Sort, Shell Sort, and Quick Sort, to visualize the sorting process for integers, doubles, and strings. It operates in two modes: Sorting Visualization, which shows how algorithms sort data in ascending or descending order, and Optimal Sorting Method, which recommends the best algorithm based on performance metrics. This paper introduces a novel sorting recommendation system that evaluates the efficiency of algorithms in real-time, offering the best option for both ascending and descending orders.},
  keywords={Measurement;Visualization;Java;Data visualization;Real-time systems;Information technology;Recommender systems;Optimization;Engines;Sorting;Sorting algorithms;Visualization;Time complexity;Space Complexity;Execution time;Best algorithm},
  doi={10.1109/CSITSS64042.2024.10816745},
  ISSN={2767-1097},
  month={Nov},}@INPROCEEDINGS{11377782,
  author={Kopera, Jyothsna and Goguru, Sathvik Reddy and Yarram, Vivek Reddy and Farhat, Shaista and Jabbar, M. A.},
  booktitle={2025 Global Conference on Information Technology and Communication Networks (GITCON)}, 
  title={An Accelerated Sudoku Solver Using Deep Q-Learning with Heuristic Assistance}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper introduces a hybrid method for solving Sudoku puzzles by combining Deep Q-Learning (DQN) with heuristic backtracking. Sudoku is treated as a Constraint Satisfaction Problem (CSP), and the solution approach merges the flexibility of reinforcement learning with the reliability of logic-based reasoning. A Deep Q-Network is trained in a custom Gym environment to develop strategies through interactive learning. When the agent is unable to proceed typically due to sparse rewards or more complex puzzle scenarios a heuristic backup is activated to finish the puzzle using rule-based logic. Experimental results show that the isolated DQN agent only managed to get an accuracy of 73.3% on simple puzzles, while only 31.4% and 14.3% on medium and hard puzzles, respectively. But the hybrid model obtained a 100% overall success rate by completing all 100 test puzzles at all difficulty levels. These system integrates the learning potential of DQN with deterministic reasoning, thus overcoming the constraints of learning-based techniques that are purely reliant in structured problem spaces like Sudoku.},
  keywords={Backtracking;Q-learning;Accuracy;Cognition;Reliability;Logic;Communication networks;Information technology;Reinforcement Learning;Constraint Satisfaction;Deep Q-Network (DQN);Heuristic Methods;Sudoku Solving},
  doi={10.1109/GITCON65266.2025.11377782},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11393209,
  author={Zayandra, Ahmad Fauzi and Haryadi, Deny and Adidrana, Demi},
  booktitle={2025 8th International Seminar on Research of Information Technology and Intelligent Systems (ISRITI)}, 
  title={Hybrid LSTM–Random Forest Model for Forecasting Lettuce Leaf Growth in Hydroponic Systems During the Rainy Season}, 
  year={2025},
  volume={},
  number={},
  pages={1048-1053},
  abstract={Hydroponic lettuce cultivation in Indonesia suffers from unpredictable growth during the rainy season due to fluctuating temperature, humidity, pH, and nutrient levels, leading to inefficiencies and losses of yield. The classic approaches ARIMA and Prophet were unable to model nonlinear relationships, which for Prophet indicated MAE 1.475 and a lower RMSE 1.808 for identical 2024 NFT data. This research aims to merge LSTM and Random Forest in a hybrid model capable of providing precise and practical predictions for farmers. 344 daily values for data regarding months of Jan to May 2024 were prepared for training with time series creation, selection with a hole based on standard deviation values of less than 1.5, MinMax value normalization, and split data division based on seasons 1 to 3 for training and season 4 for validation. The hybrid model boasts LSTM for extracting temporal relationships and Random Forest for correcting nonlinear relationships for univariate and multivariate approaches. In several experiments based on differing data structures and other parameters, multivariate clearly outperformed others with MAE 1.256 and a lower RMSE 1.822 for 14.6 percent absolute improvement in MAE performance with 14.85 percent improvement in MAE values for identical data when compared with Prophet. This model clearly indicates major contributing factors for droughts in hydroponic systems for practical future creation of low-cost action rules for straightforward and immediate actions via existing IoT equipment for tropical hydroponic farming.},
  keywords={Radio frequency;Training;Temperature sensors;Time series analysis;Hydroponics;Humidity;Predictive models;Data models;Forecasting;Long short term memory;LSTM-RF hybrid;hydroponic forecasting;rainy season;residual correction;time-series forecasting},
  doi={10.1109/ISRITI68345.2025.11393209},
  ISSN={2832-1456},
  month={Dec},}@INBOOK{9986178,
  author={Blanciak, François},
  booktitle={Tokyoids: The Robotic Face of Architecture}, 
  title={Diagram and Face}, 
  year={2022},
  volume={},
  number={},
  pages={9-69},
  abstract={Fraught with metallic frames, rotors, and circuitry, the technological world of the roboticist may at first glance seem to be the antithesis of the whimsical universe of the artist, more traditionally associated with randomly placed easels and paint stains. But on closer inspection aren&#x0027;t these two realms of endeavor more similar than they appear.? The robot is an obvious attempt to mimic the human body. So is the painted portrait. These could in fact be comprehended as separate branches of the same project. The normative schemas that have occupied the architectural imagination for centuries may facilitate the perception of this shared interest in the recurring image of the robotic face. &#x0022;Within the perceptible world,&#x0022; wrote the philosopher Georg Simmel, &#x0022;there is no other structure like the human face which merges such a great variety of shapes and surfaces into an absolute unity of meaning.&#x0022; And &#x0022;in order to make this unity aesthetically effective,&#x0022; he added, &#x0022;it is essential that the spatial relation among the facial elements be allowed to shift only within very narrow limits.&#x0022;<superscript>1</superscript> Why the face may have been of importance to architectural theory can, in light of Simmel&#x0027;s thought, be better fathomed. But where are the narrow limits he referred to? And to what extent did their delineation affect architectural morphology, or imply anything robotic?},
  keywords={},
  doi={},
  ISSN={},
  publisher={MIT Press},
  isbn={9780262370967},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/9986178},}@INPROCEEDINGS{11202057,
  author={Rossi, Marta and Michalakos, Christos},
  booktitle={2025 Immersive and 3D Audio: from Architecture to Automotive (I3DA)}, 
  title={Athanasius Kircher’s Sonic Playground - An Acoustic Virtual Reality Installation}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Athanasius Kircher’s Sonic Playground is an interactive virtual reality (VR) installation that explores architectural acoustics through spatial sound simulation and realtime user engagement. Developed in Unreal Engine 5.4.4 using the Meta XR plugin, the project employs acoustic ray tracing for realistic auralisation and six degrees of freedom (6DoF) binaural audio rendering, enabling users to interact with acoustically responsive virtual spaces. Inspired by seventeenth-century polymath Athanasius Kircher, one of the first scholars to formalise the analogies between sound and light propagation, the project reimagines his acoustic theories and studies within a virtual environment. It features a series of four architecturally resonant spaces: a reconstructed model of the Ear of Dionysius, an elliptical domed chamber, a labyrinth, and a minimalist cathedral-like structure. These environments are designed to recreate acoustic phenomena characteristic of historic architecture such as whispering gallery effects, echo layering, and reverberant decay. Users engage with the environments through controller-triggered impulses, theoretical instruments, and live voice input captured via the headset’s microphone, receiving real-time auditory feedback shaped by the scene’s geometry and materials. By combining early modern acoustic theory with contemporary VR design, Athanasius Kircher’s Sonic Playground provides a playful yet acoustically rigorous framework for investigating architectural acoustics and the relationship between spatial form and auditory perception. The project contributes to current work in immersive cultural heritage, virtual acoustics, and design-led research, proposing a model of interactive auralisation that merges scientific inquiry with speculative reconstruction.},
  keywords={Geometry;Solid modeling;Computational modeling;Instruments;Ear;Ray tracing;Acoustics;Real-time systems;Cultural differences;Engines;virtual acoustics;virtual reality;archaeoacoustics;virtual heritage;unreal engine;meta xr},
  doi={10.1109/I3DA65421.2025.11202057},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11505194,
  author={Hari Kishan, B and Saadhvi, R and Sakthi Sudarsen, J and Poonkodi, M},
  booktitle={2026 International Conference on Data Science, Agents and Artificial Intelligence (ICDSAAI)}, 
  title={Hierarchical Agent Architecture for Clinical Decision Support in Drug-Drug Interaction (DDI) Analysis}, 
  year={2026},
  volume={1},
  number={},
  pages={1-6},
  abstract={Adverse (Drug-Drug Interactions) DDIs are a critical concern for patient safety, and they contribute to a significant proportion of preventable morbidity and hospital admissions. However, the continuing stream of new pharmacotherapies and evolving clinical evidence makes manual monitoring of this ever-expanding body of pharmacological data infeasible. Most prior LLM-based systems attempt to manage conversation, retrieval, and reasoning simultaneously, which often leads to hallucinations, loss of temporal context, and limited interpretability. This paper addresses the limitations mentioned above by introducing an agentic, graph-augmented decision support architecture. It combines Neo4j, a graph database, with a multi-agent reasoning framework based on LangGraph. Drugs and their interactions are modelled as nodes and edges, respectively, with metadata that enables semantically rich and computationally efficient discovery of relationships. Specialised agents for retrieval and response generation are orchestrated through a stateful LangGraph workflow with temporal memory. A validation checkpoint ensures relevance and factual integrity via iterative refinement of retrieved evidence. The proposed hierarchical architecture effectively merges the structured, factually precise nature of graph databases with the adaptive reasoning capabilities of LLMs. This leads to a trustworthy, explainable, and temporally aware clinical decision-support system that enhances reliability in pharmacological analysis and provides a framework for safe, data-driven decision-making in healthcare.},
  keywords={Drugs;Modeling;Drug interactions;Knowledge graphs;Retrieval augmented generation;Printing;Cognition;Cognitive systems;Architecture;Computer architecture;Drug-drug interactions;dual-agent architecture;clinical decision support system;knowledge graph retrieval},
  doi={10.1109/ICDSAAI69492.2026.11505194},
  ISSN={},
  month={March},}@ARTICLE{11293079,
  author={Jiao, Jiajia and Wen, Ran and Yang, Hong},
  journal={Frontiers of Information Technology & Electronic Engineering}, 
  title={An End-to-End Automatic Methodology to Accelerate the Accuracy Evaluation of Deep Neural Networks Under Hardware Transient Faults}, 
  year={2025},
  volume={26},
  number={7},
  pages={1099-1114},
  abstract={Hardware transient faults are proven to have a significant impact on deep neural networks (DNNs), whose safety-critical misclassification (SCM) in autonomous vehicles, healthcare, and space applications is increased up to four times. However, the inaccuracy evaluation using accurate fault injection is time-consuming and requires several hours and even a couple of days on a complete simulation platform. To accelerate the evaluation of hardware transient faults on DNNs, we design a unified and end-to-end automatic methodology, A-Mean, using the silent data corruption (SDC) rate of basic operations (such as convolution, addition, multiply, ReLU, and max-pooling) and a static two-level mean calculation mechanism to rapidly compute the overall SDC rate, for estimating the general classification metric accuracy and application-specific metric SCM. More importantly, a max-policy is used to determine the SDC boundary of non-sequential structures in DNNs. Then, the worst-case scheme is used to further calculate the enlarged SCM and halved accuracy under transient faults, via merging the static results of SDC with the original data from one-time dynamic fault-free execution. Furthermore, all of the steps mentioned above have been implemented automatically, so that this easy-to-use automatic tool can be employed for prompt evaluation of transient faults on diverse DNNs. Meanwhile, a novel metric “fault sensitivity” is defined to characterize the variation of transient fault-induced higher SCM and lower accuracy. The comparative results with a state-of-the-art fault injection method TensorFI+ on five DNN models and four datasets show that our proposed estimation method A-Mean achieves up to 922.80 times speedup, with just 4.20% SCM loss and 0.77% accuracy loss on average. The artifact of A-Mean is publicly available at https://github.com/breatrice321/A-Mean.},
  keywords={Accuracy;Sensitivity;Upper bound;Estimation;Artificial neural networks;Static analysis;Hardware;Topology;Transient analysis;Vehicle dynamics;Analytical model;Deep neural networks;Hardware transient faults;Fast evaluation;Automatic evaluation tool},
  doi={10.1631/FITEE.2400547},
  ISSN={2095-9230},
  month={July},}@INPROCEEDINGS{11283794,
  author={Yang, Sung-Pei and Shih, Fong-Ruei and Huang, Chao-Ming and Chen, Shin-Ju and Chiua, Cheng-Hsuan},
  booktitle={2025 14th International Conference on Renewable Energy Research and Applications (ICRERA)}, 
  title={A Deep Learning-Based Ensemble Method for Parameter Estimation of Photovoltaic Modules Using a Physical Model}, 
  year={2025},
  volume={},
  number={},
  pages={395-400},
  abstract={Precise estimation of photovoltaic (PV) module parameters is essential for detecting early-stage faults in PV installations. Recent studies have introduced a power-generation model grounded in a triple-diode configuration to enhance estimation precision. Nevertheless, parameter identification remains difficult due to the nonlinear and feedback-driven interactions between internal characteristics and output power, alongside long-term operational effects such as aging, drift, and efficiency loss. To overcome these challenges, this work presents an ensemble framework based on deep learning, designed to merge the results from various optimization strategies to achieve more reliable and accurate parameter estimation. The methodology includes three main components. First, a PV output model adopting the triple-diode structure is constructed. Second, a set of optimization techniques-each operating with its own exploration and exploitation strategy-is applied to obtain a broad range of solution candidates. Third, the system trains a composite deeplearning framework that couples convolutional layers with LSTM units, enabling it to learn from these candidate outputs and ultimately generate the final forecast. The proposed system is evaluated on a $733-\mathrm{kW}$ PV installation. Experimental findings reveal that the ensemble approach delivers better accuracy and improved stability compared with standalone optimization algorithms and traditional LSTM-only models.},
  keywords={Deep learning;Parameter estimation;Accuracy;Computational modeling;Estimation;Predictive models;Prediction algorithms;Stability analysis;Ensemble learning;Long short term memory;Triple-dioder model;PV power estimation;ensemble model;physical model},
  doi={10.1109/ICRERA66237.2025.11283794},
  ISSN={2572-6013},
  month={Oct},}@ARTICLE{11450492,
  author={Pan, Haiyan and Yu, Hao and Hong, Zhonghua and Zhou, Ruyan and Tao, Jiang and Jiang, Chenchen and Han, Yanling and Zhang, Yun},
  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={Elevation-CVMamba: Elevation Estimation of Single-View Remote Sensing Image by Integrating CNN and VMamba}, 
  year={2026},
  volume={19},
  number={},
  pages={11844-11859},
  abstract={Accurate elevation estimation from a single remote sensing image is pivotal for applications such as 3-D city modeling. However, state-of-the-art (SOTA) deep learning methods face a critical trade-off: Convolutional neural networks (CNNs) excel at preserving local details but struggle with global context, while Transformers capture long-range dependencies but often oversmooth fine structures and are computationally expensive. This architectural dilemma frequently leads to blurred elevation boundaries and structurally inconsistent estimations in complex scenes. To address this, we introduce elevation-CVMamba, an innovative dual-branch network that effectively synergizes these complementary strengths. One branch employs a CNN to preserve high-fidelity local textures, while the other leverages a vision Mamba encoder to efficiently model long-range spatial relationships. Critically, these parallel feature streams are intelligently merged by our novel content-aware channelwise fusion module, which learns to dynamically arbitrate the contribution of local and global features based on scene content. Extensive evaluations on the DFC2019, ISPRS Potsdam, and Vaihingen datasets demonstrate that elevation-CVMamba outperforms SOTA methods. Specifically, our approach reduces the MAE by 18.54% on DFC2019, 2.44% on Potsdam, and 14.75% on Vaihingen compared to the strongest baselines. This performance is achieved with exceptional efficiency, requiring 75.33% fewer parameters than a strong baseline such as DepthFormer. Qualitatively, the framework shows a superior ability to reconstruct distinct building boundaries and subtle terrain details, confirming its practical value for real-world applications.},
  keywords={Remote sensing;Transformers;Convolutional neural networks;Estimation;Computer architecture;Image reconstruction;Feature extraction;Accuracy;Urban areas;Earth;Deep learning;dual-branch architecture;elevation estimation;feature fusion;single-view remote sensing;vision mamba (VMamba)},
  doi={10.1109/JSTARS.2026.3676428},
  ISSN={2151-1535},
  month={},}@INPROCEEDINGS{11469838,
  author={Lakshmi, M. Sri and Reddy, N Sai Simha and Reddy, Gnaneswar and Keshava, K Sri and Maneesh, Ketha},
  booktitle={2026 International Conference on Visual Analytics and Data Visualization (ICVADV)}, 
  title={Adaptive Real-Time Ransomware Detection Using Processor-Disk Behavior Analysis with Intelligent Threat Response Mechanisms}, 
  year={2026},
  volume={},
  number={},
  pages={498-505},
  abstract={The paper describes BEAST (Behavior-based Extraction and Anomaly Scoring Technique), a multi-layered anomaly detection system which aims at detecting complex and subtle threats in systems by performing the analysis of behavior in a unified manner. The suggested approach collects and merges features in five important areas, processor activity, memory usage, disk I/O, file entropy and network behavior, into structured behavior vector at deterministic time points. The features are standardized and the results are compared with an Isolation Forest model to assign the anomaly scores and identify any anomalous operation with respect to normal working system behaviour. Adaptive learning is also facilitated through feedback-based labeling; returning the modeled response distilled through the input of analysts. As experimentally shown, BEAST is superior or comparable to multiple baseline models in terms of precision and F1-score that empirically eliminates false positives and keeps high sensitivity of detection. The framework has interpretable results and can be deployed in dynamic computing environments in real-time applications.},
  keywords={Telemetry;Aerospace and electronic systems;Payloads;Central Processing Unit;Feedback;Circuits;Electronic circuits;Communication systems;Internet of Things;Software defined networking;anomaly detection;behavioral analysis;isolation forest;feature extraction;feedback learning;system monitoring},
  doi={10.1109/ICVADV67766.2026.11469838},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10968546,
  author={Sonal, Deeksha and Pattanaik, Srinibas and Nayak, Kanishk and Vyas, Rudraksh Raj and Sharma, Tanya and Kohli, Ayush},
  booktitle={2025 IEEE 14th International Conference on Communication Systems and Network Technologies (CSNT)}, 
  title={An Approach for Detecting and classification of Lung Cancer Using Deep Learning and Machine Learning}, 
  year={2025},
  volume={},
  number={},
  pages={53-58},
  abstract={Lung cancer is one of the top causes of cancer-related fatalities worldwide, demanding early and accurate detection for better patient outcomes. This work addresses the merging of neural network (ML) along with deep learning (DL) approaches to increase lung cancer diagnosis and classification. Using sophisticated convolution neural networks (CNNs) for image analysis and standard machine learning (ML) models like random forest algorithms and supported vector machines (SVMs) for structured data, the suggested technique achieves excellent diagnostic accuracy, avoiding false positives and negatives. Enhanced CNNs give higher efficiency with precision of 93%, recall of 98.5%, and an accuracy of 97%. Key indicators include cumulative risk, age, and weariness, whereas demographic characteristics have a modest influence. Visualization methods such as feature significance charts and confusion matrices verify model dependability. This hybrid AI-driven approach indicates great promise in transforming lung cancer diagnoses, however problems including data privacy, computing needs, and validation in clinical trials remain and This work utilizes artificial intelligence (AI) (ML) in conjunction with deep learning (DL) technology to produce a more precise and automated approach for lung cancer diagnosis and categorization.},
  keywords={Deep learning;Visualization;Schedules;Accuracy;Neural networks;Confusion matrices;Lung cancer;Vectors;Convolutional neural networks;Standards;AI in Healthcare;Machine learning;Deep learning;Predictive Analysis;Convolutional Neural Network (CNN);Logistic Regression},
  doi={10.1109/CSNT64827.2025.10968546},
  ISSN={2473-5655},
  month={March},}@INPROCEEDINGS{11522359,
  author={R, Kiruba and J, Boobalan and Saranya, M. and R, Sumitharaj},
  booktitle={2026 4th International Conference on Artificial Intelligence and Machine Learning Applications Theme: Healthcare and Internet of Things (AIMLA)}, 
  title={Physics-Informed Neural Networks for Nonlinear Model Predictive Control: A Comprehensive Framework with Evolutionary Optimization}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Physics-Informed Neural Networks (PINNs) are a potential paradigm for solving large differential equations that incorporate controlling physics into neural structures. Leveraging this capability, an integrated framework that unites PINNs with Nonlinear Model Predictive Control (NMPC) is proposed to improve the regulation of nonlinear dynamical systems. A key innovation lies in replacing conventional gradient-based training, which is prone to spectral bias and local minima, with an evolutionary optimization strategy that enhances convergence reliability and model stability. This hybrid learning-control approach merges data-driven approximation with physics-guided constraints, yielding predictive models that are both accurate and physically consistent. The framework is validated on a mass-springdamper benchmark, where the PINN-enhanced NMPC demonstrates faster convergence, better generalization across varying conditions, and improved control precision compared to standard methods. Importantly, the reduced computational overhead enables real-time trajectory tracking, highlighting the practicality of the approach. By linking machine learning with physics-informed control, this work establishes a pathway toward scalable and intelligent control architectures for advanced engineering systems.},
  keywords={Modeling;Optimization;Training;Physics;Printing;Machine learning;Predictive control;Neural networks;Timing;Real-time systems;PINN;NMPC;Evolutionary Optimization;Control Systems;Machine Learning},
  doi={10.1109/AIMLA67915.2026.11522359},
  ISSN={},
  month={April},}@INPROCEEDINGS{10748523,
  author={S, Karthigeyan and Diviya, M and Bhuvaneswari, R and T, Sabhanayagam},
  booktitle={2024 5th International Conference on Circuits, Control, Communication and Computing (I4C)}, 
  title={QCVNET - Leveraging Quantum Technology in Convolutional Neural Networks for Improved Cardiovascular Disease Prediction}, 
  year={2024},
  volume={},
  number={},
  pages={495-502},
  abstract={The primary issue of global health today is Cardio-vascular diseases (CVDs) and thus requires accurate predictive models for detecting it early. Quantum technology combined with regular deep learning techniques are used by researchers here to improve the accuracy of forecast on heart diseases. While using an expanded dataset with clinical and demographic records, an innovative approach was found to use Quantum Convolutional Neural Network (QCVNET) structure that merged quantum layers into classical CNN framework with Principal Component Analysis (PCA) that allowed for consistency of features with respect to the quantum bits' number. The performance of the QCVNET was evaluated by comparing it to Quantum LSTM, Quantum DNN, Quantum GRU, and Quantum RNN, which are other quantum models enhanced with conventional neural networks, and other traditional non-quantum models like SVM, RF, RNN and DNN, using different indicators of quality like f1-score or recall. In early CVD prediction, the QCVNET model produced an impressive accuracy of 91.73%, beating all other models, showcasing the potential impact of quantum-enhanced deep learning for timely diagnosis and personalized treatment strategies while providing means to reduce the global burden of cardiovascular diseases.},
  keywords={Heart;Support vector machines;Radio frequency;Deep learning;Accuracy;Neural networks;Predictive models;Feature extraction;Convolutional neural networks;Principal component analysis;Cardiovascular Disease;Quantum Layers;Convolutional Neural Network},
  doi={10.1109/I4C62240.2024.10748523},
  ISSN={2473-7690},
  month={Oct},}@INPROCEEDINGS{11318777,
  author={Rattan, Sonal and Swathi, Chilukamukku and Maram, Balajee and Nayyer, Bhavna and Chandrasekhar, M.V.B. and Gill, Satinderjit Kaur},
  booktitle={2025 7th International Symposium on Advanced Electrical and Communication Technologies (ISAECT)}, 
  title={Revolutionizing Cervical Cancer Screening: A Multimodal AI Approach Using Visual, Genomic and Clinical Features}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper suggests a new multimodal artificial intelligence (AI) framework, which combines colposcopic imaging, genomic biomarkers, and structured clinical parameters, in order to enhance early-stage cervical cancer risk stratification. The model uses a unified deep learning network incorporating cross modal attention to extract and merge discriminative features in a cross modal manner. 5,000 records of three global cohorts were utilized, and generalizability was ensured by displaying rigorous preprocessing and 5-fold cross-validation and external validation. The multimodal solution reached up to AUC 0.96 and was significantly better than unimodal. SHAP and Grad-CAM were also applied to provide interpretability and help clinicians trust them and be transparent. Such results confirm that multimodal AI has translational effects to enhance the accuracy of screening, shorten the time to diagnosis, and scale deployment in locations with and without substantial resources.},
  keywords={Visualization;Biological system modeling;Genomics;Imaging;Biomarkers;Feature extraction;Robustness;Bioinformatics;Artificial intelligence;Cervical cancer;Cervical Cancer;Multimodal AI;Genomic Biomarkers;Colposcopic Imaging;Risk Stratification},
  doi={10.1109/ISAECT68904.2025.11318777},
  ISSN={},
  month={Dec},}@ARTICLE{11421034,
  author={Xia, Yuyang and Liu, Shuncheng and Zhao, Yan and Su, Han and Zhou, Xiaofang and Zheng, Kai},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={Impact-Aware Maneuver Decision With Driving Style Tuning for Autonomous Vehicle}, 
  year={2026},
  volume={38},
  number={5},
  pages={2898-2913},
  abstract={Autonomous driving is an emerging technology that has developed rapidly over the last decade, with decision-making remaining a critical challenge, particularly due to its significant role in traffic congestion. In this paper, we propose a novel perception-and-decision framework, called HEAD, which consists of an enhanced perception module and a maneuver decision module to address this challenge. In the enhanced perception module, a graph-based state prediction model with a strategy of phantom vehicle construction is proposed to address incomplete vehicle features and predict future states in parallel. Then in the maneuver decision module, a deep reinforcement learning-based model is designed to learn a driving policy based on a parameterized action Markov decision process. A hybrid reward function takes into account aspects of safety, efficiency, comfort, and impact to guide the autonomous vehicle to make optimal maneuver decisions. To make our framework applicable to more scenarios, we further propose an improved HEAD (HEAD++) framework that makes the autonomous vehicle adapt to various road structures, such as lane merging and diverging scenarios. Besides, we develop a style tuning module in HEAD++, which supports personalized driving style tuning. To mitigate high training costs, an efficient style tuning method with approximate gradient descent is proposed to reduce the number of training iterations. Extensive experiments demonstrate the effectiveness of our framework. Compared to state-of-the-art methods, HEAD++ reduces overall traffic disturbance by 23.3%–40.9%, lowers collision risk by 4.5%–17.8%, and improves passenger comfort by 13.1%–30.5%, while maintaining high traffic efficiency.},
  keywords={Autonomous vehicles;Tuning;Roads;Safety;Traffic congestion;Predictive models;Vehicles;Phantoms;Computational modeling;Optimization;Autonomous vehicle;reinforcement learning;style tuning},
  doi={10.1109/TKDE.2026.3668787},
  ISSN={1558-2191},
  month={May},}@INPROCEEDINGS{11403636,
  author={Fan, Hongming and Pei, Xuejun and Zhou, Peng and Fu, Wenpei},
  booktitle={2025 IEEE 3rd International Power Electronics and Application Symposium (PEAS)}, 
  title={Simplified Modeling Method of Dual-port CM Noise for High-power Phase-Shifted Full-Bridge Converter}, 
  year={2025},
  volume={},
  number={},
  pages={737-742},
  abstract={The common-mode (CM) electromagnetic interference (EMI) noise generated in high-power phase-shift full-bridge (PSFB) converter can transmit into both the upstream and downstream DC power grids, significantly compromising the reliability of DC grid systems. Aiming at the modeling challenges such as complex ground paths and multiple noise sources in high-power isolated converters, this paper proposes a simplified modeling method to characterize the CM noise at the input and output ports of the converter. The method leverages the merged equivalent properties of symmetric paths and the actual physical properties of noise sources to represent CM noise behavior using only two noise sources and a capacitive network. The proposed model features a simple structure and a straightforward, user-friendly modeling approach. Its accuracy and effectiveness are validated through comparative spectrum analysis of CM noise between the time-domain model and the simplified model on a 40 kW PSFB simulation platform.},
  keywords={Analytical models;Accuracy;Noise;Electromagnetic interference;Predictive models;Power grids;Reliability;Integrated circuit modeling;Time-domain analysis;Spectral analysis;high-power isolated converter;phase-shifted full-bridge;dual-port CM noise;simplified modeling},
  doi={10.1109/PEAS66638.2025.11403636},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10603177,
  author={Nawaz, Amjad and Chen, Jingyi and Yang, Wei},
  booktitle={2024 4th International Conference on Computer Communication and Artificial Intelligence (CCAI)}, 
  title={Deep Transfer Model Based Local Climate Zone Classification Using SAR/Multispectral Images}, 
  year={2024},
  volume={},
  number={},
  pages={81-86},
  abstract={The deep transfer model described in this research is made up of several sub-networks that are individually optimized by an unsupervised consistency loss and a supervised task-oriented loss. Annotations are used by the supervised loss function to achieve the intended outcome. The consistency loss promotes various sub-networks to communicate gained knowledge and motivates the network to learn the target domain data distribution. We employ the suggested model to deal with a classification of local climate zones worldwide. The dataset comprises 48,307 samples from 10 additional cities in the target domain and 352,366 training samples from 42 locations in the source domain. We provide a unique method for local climate zone (LCZ) categorization utilizing deep learning and big data analytics to merge publically available global radar and multi-spectral satellite data, gathered by the Sentinel-1 and Sentinel-2 satellites. A consistent classification scheme for characterizing the local physical structure worldwide is provided by LCZ. Due to the rapid advancement of satellite imaging techniques, multispectral (MS) and synthetic aperture radar (SAR) data have become increasingly common in LCZ classification jobs. As demonstrated by our experiments; the suggested model improves the performance as compared to baseline model.},
  keywords={Training;Adaptation models;Satellites;Accuracy;Computational modeling;Radar imaging;Task analysis;deep learning;local climate zone;classification Sentinel-1;Sentinel-2},
  doi={10.1109/CCAI61966.2024.10603177},
  ISSN={},
  month={May},}@INPROCEEDINGS{11507559,
  author={Ramya, R S and Akshaya and Priyanka, B H and L D, Chandana and B, Charan},
  booktitle={2026 IEEE International Conference for Convergence in Computing Technology (I3CTCON)}, 
  title={TRIPLE-NET Fusion for Deepfake Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The generation of deepfakes has progressed at a very high rate, thus making it possible to develop extremely realistic manipulated videos that pose a threat to the digital security of media content. The single-stream detection systems in use today that are based on traditional methods, which use purely spatial features, have not been able to withstand modern deepfakes. To address these shortcomings, TNFDD(Triple-Net Fusion for Deepfake Detection) is introduced. It is a deepfake detection model, which is a combination of CNN, GNN, and RNN architectures, which will be implemented as a single multi-stream architecture. The CNN module computes fine-grained spatial textures and pixel-level artifacts, whereas the GNN module conditions relational inconsistencies across patches of the face by modeling depictions of each frame as a structured graph. Simultaneously, the RNN (LSTM) module also responds to time anomalies like unnatural motion patterns and inconsistent dynamics of the face across sequential frames. Further, a fusion layer is used to merge features of all three streams to form a high-discriminative representation. The proposed Triple-Net system is shown to be much more generally and stability-wise robust with Celeb-DF dataset with an overall accuracy of 99.8%, a high level of precision, recall and F1 Score as well as adds to the credibility of AI and safe online media.This work presents a scalable and reliable approach for real-world deepfake forensics, contributing toward trustworthy AI and secure digital media environments.},
  keywords={Modeling;Deepfakes;Convolutional neural networks;Videos;Signal detection;Graph neural networks;Training;Faces;Long short term memory;Printing;Celeb-DF;Graphs;LSTM;MTCNN;ResNet50},
  doi={10.1109/I3CTCON68242.2026.11507559},
  ISSN={},
  month={March},}@INPROCEEDINGS{11355066,
  author={Ocampo, Ruth and Palomino-Flores, Paola},
  booktitle={2025 IEEE 5th International Conference on Advanced Learning Technologies on Education & Research (ICALTER)}, 
  title={Scrolling One More Time: How TikTok Is Redefining News Consumption and Journalistic Practices among Peruvian Youth}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This study examines how TikTok has transformed news consumption habits and journalistic practices among Peruvian youth aged 18-25. Using an interpretive qualitative design based on 20 semi-structured interviews, the research reveals that TikTok has become a dominant gateway for news, displacing traditional media through short, visual, and emotionally engaging formats that merge information with entertainment. Participants described the platform as both informative and expressive, valuing immediacy, authenticity, and emotional connection over institutional credibility. Findings reveal a profound shift toward fragmented, algorithm-driven news exposure and the emergence of hybrid journalism, where traditional values of truthfulness, objectivity, and credibility intersect with newer logics of affect, visibility, and digital participation. Although young users are aware of misinformation risks, they display developing forms of critical and participatory media literacy, verifying, remixing, and contextualizing content within their social networks. This suggests that informational judgment is no longer anchored solely in institutional authority but is increasingly coconstructed through emotional resonance, peer validation, and platform-specific cues. Ultimately, TikTok functions not merely as a news channel but as a cultural and symbolic arena where information, identity, and emotion converge-transforming news consumption into a shared meaning-making practice and redefining what it means to be informed, to trust, and to practice journalism in the age of algorithms.},
  keywords={Visualization;Video on demand;Social networking (online);Shape;Navigation;Journalism;Resonance;Web sites;Cultural differences;Fake news;TikTok;digital journalism;youth audiences;news consumption;media credibility},
  doi={10.1109/ICALTER69698.2025.11355066},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9202637,
  author={Jin, Rize and Paik, Joon-Young and Wang, Jianming and Biadgie, Yenewondim and Rao, Yunbo and Chung, Tae-Sun},
  booktitle={2020 IEEE 44th Annual Computers, Software, and Applications Conference (COMPSAC)}, 
  title={Managing Massive Amounts of Small Files in All-Flash Storage}, 
  year={2020},
  volume={},
  number={},
  pages={386-393},
  abstract={All-flash array is a popular memory device available for use in modern high-performance storage systems. Compared with other types of devices such as DRAM, NVRAM, and EEPROM, flash array combines the best features: shock resistance, low cost, low power consumption, and fast access. Moreover, the ever-increasing density of flash memory has led to a dramatic increase in the capacity, which allows the storage of large volume of data. However, flash memory is not optimal for managing a large number of small files because: 1. the small and random write operation is inefficient in flash memory; 2. massive metadata information occupies a significant portion of the namespace, which is relatively limited or scarce in big data storage systems. This paper introduces a novel approach, hash partitioning-based file compaction (HFC), to improve the efficiency of storing and accessing small files in all-flash storage systems. HFC consists of a file compaction tool and an access interface. The compaction tool merges a group (usually a directory) of small files into a set of "big files" to reduce the metadata required to be maintained in the on-chip memory. The data locality and tree structure of those small files are preserved. The access interface is designed to provide transparent access to the small files in the HFC big files. Experimental results confirm that the proposed method significantly enhances the efficiency of managing massive amounts of small files in flash memory in terms of namespace usage and access speed.},
  keywords={Flash memories;Metadata;Compaction;Hybrid fiber coaxial cables;Memory management;Random access memory;Tools;Big data storage, Small file, Flash memory, File compaction, Metadata management},
  doi={10.1109/COMPSAC48688.2020.0-217},
  ISSN={0730-3157},
  month={July},}@ARTICLE{11271008,
  author={Tang Evans, Valdemar and Gomes, Cláudio and Lucani, Daniel E.},
  journal={IEEE Internet of Things Journal}, 
  title={When Every Transmission Counts: Event-Trigger Threshold Regulation for STL Properties}, 
  year={2026},
  volume={13},
  number={4},
  pages={7040-7051},
  abstract={We propose a novel event-trigger threshold (ETT) regulation mechanism  $\text {ETT}^{\rho } $  based on signal temporal logic (STL) properties, significantly extending recent work on ETT regulation for propositional logic (PL) properties. We utilize the quantitative semantics of STL to construct a method for computing and merging suitable ETTs for different requirements in complex STL specifications. Contrary to related work on event-triggered control for STL properties, we apply the event-triggering logic to the measured signals individually rather than the control output and assume that an existing periodic controller is defined. By exploiting the early satisfaction detection (ESD) capabilities of STL and analyzing the property structure, our method aims to reduce the number of triggered events, while maintaining the satisfaction of system properties. To evaluate  $\text {ETT}^{\rho } $ , we consider a simulated adaptive cruise control case-study where STL is used to encode complex safety and performance properties and the ETTs of measured signals are regulated accordingly. We test three different properties in two different scenarios to showcase how STL and  $\text {ETT}^{\rho } $  can identify intricate circumstances where it is possible to significantly reduce the number of triggered events relative to a constant ETT.},
  keywords={Regulation;Logic;Robustness;Semantics;Runtime;Event detection;Safety;Translation;Monitoring;Specification languages;Cyber–physical systems (CPSs);event-triggering mechanisms;signal temporal logic (STL)},
  doi={10.1109/JIOT.2025.3637893},
  ISSN={2327-4662},
  month={Feb},}@ARTICLE{10974916,
  author={Zhang, Youming and Chu, Xinyi and Wei, Zhennan and Tang, Xusheng and Cao, Yunqi and Huang, Fengyi},
  journal={IEEE Transactions on Microwave Theory and Techniques}, 
  title={Analysis and Design of Ultra-Wideband mm-Wave Injection-Locked Frequency Multiplier Based on Complementary-Phase Cascade-Parallel Resonator}, 
  year={2025},
  volume={73},
  number={9},
  pages={6491-6503},
  abstract={A complementary-phase resonator (CPR) consisting of two parallel sub-networks based on complementary-phase concept is presented, whose phase frequency responses are designed to counteract each other so as to obtain an ultra-wide continuous phase plateau with small ripples and an injection current boosting (ICB) characteristic, allowing significant extension of the locking range (LR) for the millimeter-wave (mm-wave) injection-locked frequency multipliers (ILFMs). Subsequently, the widely used output buffer (cascaded with the ILFM core and incorporating a transformer as its load) is merged into the CPR to form a complementary-phase cascade-parallel resonator (CP2R), which poses a cascaded signal transmission path and a parallel complementary structure similar to the CPR, inheriting the advantages of complementary phases and facilitating an increased resonator impedance magnitude and a compact chip area. The proof-of-concept design of an injection-locked frequency doubler relying on the CP2R is fabricated in a 40-nm CMOS process. It achieves a LR of 41.7% from 72 to 110 GHz under 0-dBm injection power, covering the entire W-band without resonator tuning or multi ratio mode switching. As the injection power is reduced to −3 dBm, the LR of the CP2R-ILFM remains competitive, spanning from 78 to 106 GHz. The measured output power is above −12 dBm from 80 to 102 GHz with a maximal output power of −6.2 dBm at 88 GHz. The chip occupies a core area of 0.039 mm2 and dissipates 9.4 mW from a 0.9-V voltage supply.},
  keywords={Resonant frequency;Switches;Tuning;Transformers;Phase noise;Power generation;Q-factor;Couplings;Power demand;Multicore processing;Complementary-phase;complementary-phase cascade-parallel resonator (CP²R);injection current boosting (ICB);injection-locked frequency multiplier (ILFM);phase plateau;W-band},
  doi={10.1109/TMTT.2025.3559895},
  ISSN={1557-9670},
  month={Sep.},}@INPROCEEDINGS{11022565,
  author={Ali, Md Rayhan and Bhuiyan, Esmay and Mishu, Sadia Zaman and Hossain, Md. Ali},
  booktitle={2024 27th International Conference on Computer and Information Technology (ICCIT)}, 
  title={A Hybrid 3D-2D Convolutional Neural Network with Spatial Attention for Enhanced Spectral-Spatial Classification of Hyperspectral Images}, 
  year={2024},
  volume={},
  number={},
  pages={1458-1463},
  abstract={Hyperspectral image (HSI) classification using deep learning (DL) has proven to be highly effective. However, efficiently learning highly discriminative features from HSI is an open issue for the large dimensionality and complex spectral-spatial properties. The 2D Convolutional Neural Network (CNN) is an effective method for classifying Hyperspectral Images based on their spatial or spectral features. But HSI depends on both spectral and spatial classification. On the other hand, the 3D CNN is superior to the 2D CNN as it leverages both spectral and spatial features of the HSI. Nevertheless, in this case, computational complexity increases. This paper introduces a novel approach that utilizes a hybrid 3D-2D CNN structure with a spatial attention mechanism that specifically emphasizes spatial attributes. We utilize Z-score normalization followed by Incremental Principal Component Analysis (IPCA) for efficient dimensionality reduction and optimized memory usage on large datasets. Next, we use a spatial attention mechanism and a hybrid 3D-2D CNN to extract the features. In the hybrid CNN architecture, the 3D-2D branch merges the 3D CNN’s capability to capture detailed spectral-spatial features with the 2D CNN’s spatial refinement, further enhanced by a spatial attention mechanism. This approach balances comprehensive feature extraction with computational efficiency, improving accuracy and reducing overfitting. This results in great accuracy at a limited number of parameters. We have implemented the proposed hybrid CNN with attention mechanism on three hyperspectral datasets and it showcases exceptional performance in both accuracy and computational efficiency than other state-of-the-art methods.},
  keywords={Attention mechanisms;Three-dimensional displays;Accuracy;Memory management;Feature extraction;Computational efficiency;Convolutional neural networks;Hyperspectral imaging;Principal component analysis;Overfitting;Hyperspectral images (HSIs);CNN;3D CNN;IPCA;Dimentionality Reduction;Spatial Attention;Z score normalization},
  doi={10.1109/ICCIT64611.2024.11022565},
  ISSN={2474-9656},
  month={Dec},}@ARTICLE{11359322,
  author={Li, Yuxing and Cheng, Xuanming},
  journal={IEEE Transactions on Instrumentation and Measurement}, 
  title={Double-Refined Symplectic Geometry Mode Decomposition}, 
  year={2026},
  volume={75},
  number={},
  pages={1-10},
  abstract={Symplectic geometric mode decomposition (SGMD) can preserve signal structure more stably and robustly than traditional amplitude modulation and frequency modulation (AM–FM)-based mode decomposition algorithms. However, it focuses solely on the oscillatory modes of the signal, overlooking the presence of trends and noise, which leads to inaccurate oscillatory mode isolation and mode mixing. To address these issues, the double-refined SGMD (DRSGMD) is proposed. DRSGMD establishes a refined signal-decomposition framework that supersedes single-oscillatory-mode framework of SGMD by explicitly incorporating trend and noise modes. Within this framework, the trend mode is proactively extracted to preliminarily refine the oscillatory mode and alleviate mode mixing. Furthermore, the oscillatory mode undergoes further refinement: the noise mode is isolated via the principal component analysis prop erties of singular value decomposition, and single components are merged using time–frequency domain information. Simulation results demonstrate that DRSGMD accurately decomposes all components of the simulated signal, yielding superior decomposition fidelity and robustness. Empirical validation on real-world datasets further confirms that DRSGMD effectively extracts artifact-free oscillatory modes from EEG recordings and attains high accuracy in fault detection of measured bearing dataset.},
  keywords={Noise;Market research;Matrix decomposition;Accuracy;Time series analysis;Interference;Symmetric matrices;Covariance matrices;Singular value decomposition;Robustness;Bearing fault diagnosis;double-refined symplectic geometry mode decomposition (DRSGMD);EEG;mode decomposition;signal analysis;symplectic geometry mode decomposition (SGMD)},
  doi={10.1109/TIM.2026.3655946},
  ISSN={1557-9662},
  month={},}@INPROCEEDINGS{10993840,
  author={Bale, Ajay Sudhir and Kumar, T N Siva and Lal, Keerthana and S, Arulananth T and Ghorpade, Naveen and P, Sinchana. K.},
  booktitle={2024 International Conference on Communication, Computing and Energy Efficient Technologies (I3CEET)}, 
  title={Driver Behavior Identification with Facial Recognition and Deep Learning}, 
  year={2024},
  volume={},
  number={},
  pages={867-872},
  abstract={Driving entails a series of actions demanding intense focus. Some- times, these actions get overshadowed by other behaviors such as enjoy engaging in ingesting activities, conversing, using a cellphone, tuning the radio, or even drowsiness. These behaviors stand as the primary culprits behind today's traffic accidents. Thus, it's imperative to create applications that can forewarn drivers. This study proposes a streamlined convolutional neural network structure for identifying driver behaviors, thereby enhancing the accuracy of the alert system and minimizing traffic collisions. This network combines modules for extracting features and making classifications. By merging these components, the feature extraction within the neural network is designed to be more potent and efficient. The model aims to decrease computational costs and amplify data flow within the network by employing depth-wise separable convolutions. Additionally, the Convolution Block Attention Module aids the network in prioritizing vital features, resulting in improved performance for various computer vision tasks. The classifier unit includes global average pooling and a softmax layer to compute class probabilities. The overall architecture optimizes network parameters while upholding classification precision. Three standard datasets are used for both training and assessing the whole network.},
  keywords={Training;Accuracy;Computational modeling;Feature extraction;Real-time systems;Telecommunication computing;Convolutional neural networks;Driver behavior;Tuning;Videos;Incident;Convolutional Neural Network (CNN);driver actions;facial identification},
  doi={10.1109/I3CEET61722.2024.10993840},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11459530,
  author={C, Jansi Sophia Mary and P, Mariya Nithiya and S, Soundarya and V, Mahalakshmi and V, Sathya Swetha and S, Thilagavathi},
  booktitle={2025 6th International Conference on Smart Electronics and Communication (ICOSEC)}, 
  title={Cervical Cancer Prediction using Deep Learning Algorithms}, 
  year={2025},
  volume={},
  number={},
  pages={2140-2146},
  abstract={Cervical cancer is still an important women's wellness problem worldwide, and early diagnosis is essential for its prognosis. Classification of cervical cell abnormalities is complex due to variations in cell morphology and similar overlapping structures of Pap smear images. Segmentation accuracy and classification performance are significant challenges for most existing approaches. The cervical cancer detection system using deep learning suggests a new automated system by merging advanced image preprocessing. The Pap smear images are initially subjected to the Wiener filtering to minimize the uncleared area. Subsequently, watershed transform is handy to discrete the cervical area from the background, which assists in precisely determining cell areas. The filtered images are then run through a CNN, and VGG-19 classifies them into one of five categories: normal, metaplastic, dyskeratotic, parabasal, and superficial. This categorization helps to differentiate the various stages of abnormal cervical cells, ranging from normal to precancerous and cancerous. Experimental outputs show the system's effectiveness, reaching a classification accuracy of 95.68% and following precision, recall, and F1-score are 94.8%, 96.2%, and 95.5%, correspondingly. These results validate the model's effectiveness in correctly calculated cervical cell abnormalities and helping in the early finding and analysis of cervical cancer. This method provides early intervention and a better prognosis for the patient with cervical cancer.},
  keywords={Radio broadcasting;Frequency modulation;Filtering;Filters;Filtering theory;Circuits and systems;Image filtering;Pixel;Protocols;Modulation;Cervical Cancer;Deep Learning;Convolutional Neural Network (CNN);Image Classification;Wiener Filter;Watershed Segmentation;Medical Image Processing;Early Diagnosis},
  doi={10.1109/ICOSEC67334.2025.11459530},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10709110,
  author={Fan, Lin and Chu, Tianze and Zhang, Qianyu and He, Xi},
  booktitle={2024 IEEE 2nd International Conference on Image Processing and Computer Applications (ICIPCA)}, 
  title={From Passive Access to Intelligent Regulation-Optimization Design of Active Distribution Network Based on Demand Side Response}, 
  year={2024},
  volume={},
  number={},
  pages={1978-1987},
  abstract={With the rapid development of social economy, the nation strongly develops renewable energy power generation, but the inherent limitations of renewable energy, such as randomness, volatility, and remote geographic position, have a profound influence on the stability and safety of the distribution network system. Faced with the problem of merging large-scale distributed renewable energy into the distribution system, the traditional distribution network relying on predetermined mode for allocation has significant limitations, which cannot accurately regulate power distribution and connection optimally, and it is prone to cause an imbalance between supply and demand. In order to solve this kind of problem, a second- order cone algorithm that can optimize and regulate distributed generation energy, energy storage system, demand side response balance, and a design was implemented for the reactive power compensation device in an active distribution network, and to validate the second-order cone algorithm's effectiveness in optimizing reactive power, the IEEE33 node distribution structure was engineered. Furthermore, considering the demand side end, the nature of load was used to distinguish three types of load, and to solve and confirm the real-time electricity price load response, the chaotic particle swarm algorithm was developed and applied. Finally, the algorithm optimization solved the reactive network loss optimization problem and improved the economic benefits of the active distribution network, respectively. Moreover, it made the power purchase cost of the users decrease, and improved the capacity to consume the renewable power generation energy, which guaranteed the reliability and security of the active distribution network's operations.},
  keywords={Renewable energy sources;Reactive power;Processor scheduling;Power supplies;Electricity;Distribution networks;Active distribution networks;Security;Optimization;Energy storage;active distribution network;demand side response;photovoltaic power generation model;second order cone relaxation;optimal scheduling},
  doi={10.1109/ICIPCA61593.2024.10709110},
  ISSN={},
  month={June},}@INPROCEEDINGS{11331416,
  author={Ji, Haichao and Wang, Zibo and Pan, Cheng and Han, Meng and Zhu, Yifei and Wang, Dan and Han, Zhu},
  booktitle={2025 IEEE International Conference on Cloud Computing Technology and Science (CloudCom)}, 
  title={LAFA: Agentic LLM-Driven Federated Analytics Over Decentralized Data Sources}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Large Language Models (LLMs) have shown great promise in automating data analytics tasks by interpreting natural language queries and generating multi-operation execution plans. However, existing LLM-agent-based analytics frameworks operate under the assumption of centralized data access, offering little to no privacy protection. In contrast, federated analytics (FA) enables privacy-preserving computation across distributed data sources, but lacks support for natural language input and requires structured, machine-readable queries. In this work, we present LAFA, the first system that integrates LLM-agent-based data analytics with FA. LAFA introduces a hierarchical multi-agent architecture that accepts natural language queries and transforms them into optimized, executable FA workflows. A coarse-grained planner first decomposes complex queries into sub-queries, while a fine-grained planner maps each sub-query into a Directed Acyclic Graph of FA operations using prior structural knowledge. To improve execution efficiency, an optimizer agent rewrites and merges multiple DAGs, eliminating redundant operations and minimizing computational and communicational overhead. Our experiments demonstrate that LAFA consistently outperforms baseline prompting strategies by achieving higher execution plan success rates and reducing resource-intensive FA operations by a substantial margin. This work establishes a practical foundation for privacy-preserving, LLM-driven analytics that supports natural language input in the FA setting.},
  keywords={Privacy;Cloud computing;Directed acyclic graph;Data analysis;Soft sensors;Large language models;Natural languages;Computer architecture;Transforms;Protection;LLM agents;federated analytics;privacy computing},
  doi={10.1109/CloudCom67567.2025.11331416},
  ISSN={2380-8004},
  month={Nov},}@INPROCEEDINGS{11351355,
  author={Pandi, V.Samuthira and A, Iyswariya and J, Johnsi Rani and Al-Shaikh, Ala'a and Chadge, Rajkumar and Dinesh, M},
  booktitle={2025 IEEE International Conference on Advanced Computing Technologies (ICACT)}, 
  title={Optimizing Performance, Charge Cycles, and Resource Efficiency Through Energy-Efficient Battery Management in Electric Vehicles}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The growing need for sustainable transport has led to increased research into energy-efficient battery management systems (BMS) for electric vehicles (EVs). To overcome issues pertaining to energy storage, energy utilization, and long-term operational sustainability of EV batteries, this study proposes optimal performance design, charge cycles, and resource-efficient usage of EV batteries. The BMS in electric vehicles monitors and manages the state of charge (SoC), state of health (SoH), and power delivered to the vehicle to ensure safe and efficient operation. But extending the battery lifespan while improving energy efficiency is still a challenge, with variable driving patterns, charging cycles, thermal management, and degradation of battery cells all contributing to the issue. In this sense, this study contributes with a broad framework which merges advanced energycost efficient algorithms, dynamic SoC/SoH models and real-time optimization techniques to enhance battery utilization. It combines front and rear frame optimization, model structure optimization, model pruning, and many model compression routine optimization techniques to strike a balance between system performance by reducing power loss, prolonging the available battery life of an electric vehicle, and reducing resource consumption, such as charging infrastructure and material consumption. The study specifically covers the theoretical use of both regenerative braking (top off writing) and adaptive (data-driven) control strategies, dictated by driving conditions, environmental factors, and energy consumption value. The presented results indicate that the efficiency potential of the proposed approach in normal driving conditions can be up to 20 % battery performance improvement with less thermal stress compared to the base case thus increasing overall battery lifecycle for the usual application of the technology by reducing degradation effects. EVs could see an additional energy per mile reduction of 15 % on average by incorporating optimized charge cycles. These findings offer valuable guidance for developing next-gen BMS that can facilitate greener and more sustainable EV adoption, leading to wider long-term environmental improvements and benefits. This study, therefore, provides a fresh viewpoint for battery utilization performance, charge cycle, and resource savings, which can help accelerate the evolution of sustainable energy in the automotive sector. This work could affect future BMS designs and pave the way for energy-aware EV technologies.},
  keywords={Degradation;Thermal management;Electric vehicles;Energy efficiency;Real-time systems;Batteries;Solid state batteries;Sustainable development;Optimization;Thermal degradation;Battery Degradation;Resource Efficiency;Thermal Management;Predictive Modeling;Machine Learning;Adaptive Control Strategies;Rare Earth Materials;Energy Storage;Sustainability},
  doi={10.1109/ICACT67549.2025.11351355},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11491723,
  author={Ramisa, Nishat Tasneem and Farshi, Md. Salman and Tabashoum, Sinthiya and Bhuiyan, Md. Kaiyum Al Rifat and Sakib, Md. Taimur Rahman and Debnath, Joy},
  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={Attention Guided Temporal Fusion with TCN-BiLSTM-BiGRU for Financial and Power-Load Forecast Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1900-1905},
  abstract={Time series forecasting underpins decisions in areas such as equity trading and grid operation. We introduce a compact hybrid forecaster that couples a temporal convolutional stem (TCN) for local, dilated causal patterns with stacked bidirectional LSTMs to capture extended temporal structure and a BiGRU head to refine recent dynamics. A single softmax attention layer adaptively reweights channels and time steps, concentrating the model on informative regions. A unified pipeline-feature fusion with MinMax normalization-is applied across domains; in finance we additionally merge a macroeconomic cue (e.g., credit growth) with market features. On four real financial indices and power-load dataset, the approach reaches up to 99.15% accuracy and consistently reduces MAPE, MAE, RMSE relative to strong baselines and non-attention mechanisms. Attention maps provide transparent temporal attributions, yielding an accurate yet interpretable cross-domain forecaster.},
  keywords={Feeds;Filtering;Filters;Circuits and systems;Protocols;LoRa;HTTP;Wide area networks;Data communication;Communication systems;Attention;TCN;BiLSTM;BiGRU;MAPE;MAE;MinMax;RMSE;Stock Prediction},
  doi={10.1109/ICCIT68739.2025.11491723},
  ISSN={2474-9656},
  month={Dec},}@ARTICLE{11137374,
  author={Chen, Yingjie and Xie, Qi and Cui, Wenxuan and Chen, Liming and Song, Houbing Herbert and Zhu, Tao},
  journal={IEEE Transactions on Artificial Intelligence}, 
  title={P-Mix: A Data Augmentation Method for Contrastive Learning Based Human Activity Recognition}, 
  year={2026},
  volume={7},
  number={3},
  pages={1500-1511},
  abstract={Supervised human activity recognition (HAR) with sensor data typically demands substantial labeled datasets to train robust models. Contrastive learning offers a self-supervised alternative by leveraging data augmentation to improve representation learning. However, most existing augmentation methods operate independently on either the time or channel dimension and often introduce unstructured noise, which can distort meaningful temporal and spectral patterns. To address these limitations, we present a novel P-Mix data augmentation method for contrastive learning in HAR tasks, specifically designed to be compatible with the SimCLR framework. P-Mix is a customized data augmentation method tailored to sensor data for HAR, which slices and recombines both the time and channel dimensions, merging multiple temporal segments to encourage the model to explore the underlying relationships and variations in the data in an unsupervised setting. To capture motion cycles and long-term dependencies, we employ shorter temporal segments as fundamental processing units along the time dimension. By incorporating structured noise patterns based on motion cycle characteristics within these segments, we effectively enhance the model’s robustness and generalization capabilities. Extensive evaluations across five HAR benchmarks demonstrate that P-Mix achieves consistent improvements over the strongest baseline (resample), delivering relative F1-score gains ranging from 1.87% (USC-HAD: 85.63% versus 83.93%) to 6.53% (DSADS: 97.24% versus 91.28%) through controlled multidimensional fusion. These results demonstrate the effectiveness of our approach in optimizing data generation and augmentation strategies for HAR tasks.},
  keywords={Data augmentation;Noise;Human activity recognition;Data models;Contrastive learning;Artificial intelligence;Motion segmentation;Computer science;Feature extraction;Data mining;Activity recognition;contrastive learning;data augmentation;self-supervised learning;sensor data},
  doi={10.1109/TAI.2025.3601599},
  ISSN={2691-4581},
  month={March},}@INPROCEEDINGS{11375509,
  author={Xia, Yan and Ji, Wenbo and Chen, Weirong and Cremers, Daniel},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision Workshops (ICCVW)}, 
  title={CSG-Fusion: Consistent Sparse-View Gaussian Splatting via Matching-based Fusion}, 
  year={2025},
  volume={},
  number={},
  pages={2653-2662},
  abstract={Recent developments in Gaussian splatting have enabled high-fidelity 3D reconstruction from multi-view images, but pixel-aligned methods such as MASt3R often produce redundant primitives and inconsistent geometry under few-view settings. We propose CSG-Fusion, a feed-forward framework that mindfully integrates pixel-aligned pointmap to reduce redundant primitives and produce compact and consistent 3D structures. Our approach leverages a matching prior with spatial thresholds to prune overlapping Gaussians, forming a coherent base 3D model, and then applies a mask-based feature aggregation module to merge local features and improve photometric consistency with fewer primitives. To enforce cross-view agreement after fusion, we further incorporate context-view supervision to align appearance and geometry across perspectives. Experiments on the large-scale ScanNet++ and object-level DTU benchmarks demonstrate both the efficiency and generalization of our method. Compared to the leading pose-known and pose-free approaches, our method achieves higher rendering quality with substantially fewer Gaussians.},
  keywords={Geometry;Solid modeling;Computer vision;Three-dimensional displays;Conferences;Benchmark testing;Rendering (computer graphics);Image reconstruction;Videos;Consistent Gaussian Splatting;Sparse View},
  doi={10.1109/ICCVW69036.2025.00276},
  ISSN={2473-9944},
  month={Oct},}@INPROCEEDINGS{11448259,
  author={M, Duwara Kishore and G, Gowtham and R, Arun and M, Vanitha},
  booktitle={2025 1st International Conference on Data Science and Intelligent Network Computing (ICDSINC)}, 
  title={Innovations in Cardiovascular Monitoring: Utilizing Hybrid Temporal-Causal Modeling for Advanced Warning Systems}, 
  year={2025},
  volume={},
  number={},
  pages={237-242},
  abstract={The primary cause of death worldwide at present is mostly due to cardiovascular diseases, affecting individuals of all ages. The primary objective of this research is to present a novel hybrid deep learning model that merges the Mobile Net and GoogleNet architectures to improve cardiovascular prediction accuracy and with high confidence so that the image prediction for new data gives a high confidence class label. The model has lightweight MobileNet and efficient feature extraction abilities in conjunction with a structured Google deep learning approach. This method gives the confidence to the patients to check for any abnormalities by simply uploading their ECG images to this application. This study utilized the Adam optimizer to enhance the model performance and achieve optimal results with the feature fusion approach. While many deep learning models are available, our hybrid approach has demonstrated superior outcomes compared to others, achieving an accuracy rate of 98 percent. The proposed approach has classified patient conditions into four categories abnormal, normal, myocardial infarction, and a history of myocardial infarction.},
  keywords={Deep learning;Performance evaluation;Myocardial infarction;Accuracy;Predictive models;Electrocardiography;Feature extraction;Data models;Internet;Overfitting;Cardiovascular Disease Prediction;Deep Learning;Google Net;Mobile Net;Image Data Generator;Freeze Layer;Adam Compiler},
  doi={10.1109/ICDSINC66221.2025.11448259},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11323134,
  author={Zhou, Hao and Zeng, Wu and Wang, Gang and Liu, Xiaoguang},
  booktitle={2025 IEEE 31th International Conference on Parallel and Distributed Systems (ICPADS)}, 
  title={GCLComp: A GPU-Centric Compaction Strategy for LSM-Based KV Store}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={The Log-Structured Merge (LSM) tree is a widely used storage engine in key-value systems, but its compaction process is a major performance bottleneck due to high computational and I/O demands. While GPU-accelerated compaction (GPU Compaction) has emerged as an efficient solution, state-of-the-art approaches rely on CPU-centric GPU-SSD direct I/O stacks, suffering from synchronization overhead between IO and GPU Computation and limited GPU-SSD IO bandwidth. To address these limitations, we propose GCLComp, a GPUCentric LSM Compaction Strategy based on GPU-Initiated Direct Storage (GIDS). It is a computational storage architecture application based on GPU and GIDS. GCLComp introduces MiniFS, an efficient user-space Host-GPU shared-driver file storage system specifically designed for GPU-accelerated LSM compaction. It enables GPU-initiated I/O for compaction and higher GPU-SSD IO throughput. This allows the GPU to independently read the input files required for compaction from the SSD, perform compaction, and write the output to SSD, minimizing CPU involvement. GCLComp further employs a GPU IO-Computation Pipeline using CUDA streams to seamlessly orchestrate I/O and computation, eliminating synchronization overhead. The experimental results show that MiniFS improves read and write throughput by 52 % and 34 %, respectively, over the state-of-the-art. Based on that, GCLComp achieves up to 19.16 % higher compaction throughput, 21.98 % higher average Fillrandom throughput, 17.59 % lower average Fillrandom latency, 97.27 % lower Fillrandom P999 tail latency and 31.85% higher ReadWriteMix throughput under the KV store, compared to SOTA. We also find that compaction throughput scales nearly linearly with pipeline batch size by a sensitivity analysis.},
  keywords={Sensitivity analysis;Trees (botanical);Pipelines;Graphics processing units;Telecommunication traffic;Throughput;Compaction;Synchronization;Engines;Communication switching;GPU-Centric;GPU-Initiated Direct Storage;LSM Tree;Compaction;KV store},
  doi={10.1109/ICPADS67057.2025.11323134},
  ISSN={2690-5965},
  month={Dec},}@INPROCEEDINGS{11395132,
  author={Zargariasl, Hamid and Khan, Siddique Reza and Borck, Christian and Behm, Martin and Herglotz, Christian},
  booktitle={2025 IEEE Smart World Congress (SWC)}, 
  title={Threat Analysis in Real World Computer Networks Possessing a Digital Twin: Graph Visualization and Markov Clustering}, 
  year={2025},
  volume={},
  number={},
  pages={1561-1567},
  abstract={This paper presents the threat analysis of a real-world network incorporating a digital twin, with a particular focus on prioritizing necessary cybersecurity measures through graph analysis methods. This method not only helps prioritize necessary actions but also identifies which threats are most dominant in specific parts of the network. This work examines a network comprising various real-world physical assets as one part of a big production line, integrated with an Asset Administration Shell (AAS) server. The server hosts the AAS as a digital twin, facilitating the representation and management of these assets in a virtual environment. To analyze such a system, we employ graph theory to visualize the topology and identify potential threats within the network. This approach not only enhances threat detection but also provides a comprehensive understanding of the system's structure and vulnerabilities. This study merges the topology of tangible assets and its associated threat matrix into an integrated mathematical graph. We propose an optimization-based clustering strategy to streamline security mitigation tools. By segmenting the network into granular components with similar protection requirements, we streamline security management for experts. This method minimizes resource usage in scenarios with constrained budgets. The advantages of our approach are discussed, providing valuable insights into the practical application of digital twins and their secure deployment. Summarizing, our findings offer a framework for enhancing cybersecurity, especially in digital twin implementations.},
  keywords={Visualization;Analytical models;Prevention and mitigation;Virtual environments;Graph theory;Digital twins;Topology;Servers;Security;Computer crime;Cyber Security;Threat Modelling;Digital Twin;Asset Administration Shell;Visualization;Graph Theory;Node Centrality;Clustering},
  doi={10.1109/SWC65939.2025.00246},
  ISSN={2993-396X},
  month={Aug},}@ARTICLE{11404243,
  author={Hu, Yunhao and Li, Keqiang and Zhao, Xiang and Li, Pengfei and Kong, Weiwei and Luo, Yugong},
  journal={IEEE Transactions on Intelligent Transportation Systems}, 
  title={Plausible High-Risk Scenario Generation for Verification of Multi-CAV Cooperation via Bidirectional and Auto-Regressive Transformers}, 
  year={2026},
  volume={},
  number={},
  pages={1-16},
  abstract={A major obstacle to the rapid maturation and real-world deployment of cooperative connected and automated vehicles (CAVs) is the prohibitive cost and extensive on-road testing mileage required to validate safety in natural traffic, where genuinely high-risk scenarios are exceedingly rare. Although existing scenario-generation methods can generate high-risk scenarios at scale, such scenarios frequently violate real-world physics or driver-behavior patterns, making them implausible and unsuitable for rigorous evaluation. To bridge this critical gap, we propose a plausible high-risk scenario generation method utilizing a bidirectional and autoregressive transformer (BART). Continuous vehicle trajectories from extensive naturalistic datasets are tokenized into a concise behavioral vocabulary, enabling the model to capture latent plausibility structures and realistically reproduce vehicle maneuvers. An iterative risk-feedback mechanism further steers scenario generation toward aggressive yet physically plausible driving conditions, effectively escalating cumulative risk within each simulation and thus yielding more plausible high-risk scenarios. Across cooperative lane-change and merging verification, the proposed BART-driven plausible high-risk generator yields markedly more high-risk and informative test scenarios than the Markov Decision Process (MDP) baseline, an Adaptive Stress Testing with a Deep Q-Network (AST-DQN), and a BART variant without risk-guided decoding, while maintaining a practical balance between scenario plausibility and risk elevation.},
  keywords={Trajectory;Scenario generation;Safety;Decoding;Vehicle dynamics;Testing;Iterative decoding;Current transformers;Intelligent transportation systems;Generators;Connected and automated vehicles;plausible high-risk scenario generation;multi-CAV cooperation;verification;bidirectional-autoregressive transformer},
  doi={10.1109/TITS.2026.3664834},
  ISSN={1558-0016},
  month={},}@INPROCEEDINGS{11504877,
  author={A, Vishnukumar and Kavitha, M and Amsavalli, K and V, Govarthan and S, Barath and K, Suvathika},
  booktitle={2026 International Conference on Recent Advances in Electrical, Electronics, Ubiquitous Communication, and Computational Intelligence (RAEEUCCI)}, 
  title={Self-Supervised Vision Transformers for Few-Shot Medical Image Segmentation in Resource-Constrained Edge Devices}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Segmentation of medical images requires a large amount of annotated data, which is hard to obtain in limited resources environments. SST-ViT introduces self-supervised Vision Transformer (ViT) based few-shot segmentation with a dice score of ${8 7. 2 \%}$ for 5-shot ACDC segmentation task as opposed to ${7 2. 4 \%}$ of ViT-Tiny with supervised learning. It runs at 28 FPS on Jetson Nano with only 5.2M parameters. SST-ViT applies the technique of masked image modeling for dense representation learning. Adaptation to a few-shot support set images is carried out using prototypical contrastive alignment. Anatomical structure detection at different levels is done using self-attention while optimized edge-aware patch merging reduces the memory cost by 68%. Training is done on the following datasets: ACDC (heart), Synapse (8 organ types), and EdgeMed (mobile ultrasound). With self-supervision, there is no need for annotations. Prototypical networks can be utilized for enabling few-shot adaptation in power-limited systems.},
  keywords={Feeds;Protocols;Location awareness;Pixel;Videos;HTTP;Mobile communication;Video equipment;Communication systems;LoRa;Self-supervised learning;Vision Transformers;few-shot segmentation;medical imaging;edge AI;Jetson Nano},
  doi={10.1109/RAEEUCCI67649.2026.11504877},
  ISSN={},
  month={April},}@ARTICLE{10645213,
  author={Yang, Qian and Li, Caizi and Ou, Chubin and Li, Kang and Liao, Xiangyun and Duan, Chuanzhi and Yu, Lequan and Si, Weixin},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={Synthesizing Feature-Aligned and Category-Aware Electronic Medical Records for Intracranial Aneurysm Rupture Prediction}, 
  year={2024},
  volume={28},
  number={12},
  pages={7420-7433},
  abstract={Rupture prediction is crucial for precise treatment and follow-up management of patients with intracranial aneurysms (IAs). Considerable machine learning (ML) methods have been proposed to improve rupture prediction by leveraging electronic medical records (EMRs), however, data scarcity and category imbalance strongly influence performance. Thus, we propose a novel data synthesis method i.e., Transformer-based conditional GAN (TransCGAN), to synthesize highly authentic and category-aware EMRs to address above challenges. Specifically, we first align feature-wise context relationship and distribution between synthetic and original data to enhance synthetic data quality. To achieve this, we first integrate the Transformer structure into GAN to match the contextual relationship by processing the long-range dependencies among clinical factors and introduce a statistical loss to maintain distributional consistency by constraining the mean and variance of the synthesis features. Additionally, a conditional module is designed to assign the category of the synthesis data, thereby addressing the challenge of category imbalance. Subsequently, the synthetic data are merged with the original data to form a large-scale and category-balanced training dataset for IAs rupture prediction. Experimental results show that using TransCGAN's synthetic data enhances classifier performance, achieving AUC of 0.89 and outperforming state-of-the-art resampling methods by 5$\%$–33$\%$ in F1 score.},
  keywords={Transformers;Predictive models;Generative adversarial networks;Aneurysm;Data models;Generators;Synthetic data;Intracranial aneurysm;rupture prediction;generative adversarial network;data synthesis},
  doi={10.1109/JBHI.2024.3448459},
  ISSN={2168-2208},
  month={Dec},}@ARTICLE{10799156,
  author={Chen, Xiaoliang and Ouyang, Zhenlin and Gao, Hanyu and Lin, Qunzhi and Zhu, Zuqing},
  journal={Journal of Optical Communications and Networking}, 
  title={Meta-learning-aided QoT estimator provisioning for a dynamic VNT configuration in optical networks}, 
  year={2025},
  volume={17},
  number={1},
  pages={A103-A111},
  abstract={Machine learning (ML)-based quality-of-transmission (QoT) estimation tools will be desirable for operating virtual network topologies (VNTs) that disclose only abstracted views of connectivity and resource availability to tenants. Conventional ML-based solutions rely on laborious human effort on model selection, parameter tuning, and so forth, which can cause prolonged model building time. This paper exploits the learning-to-learn nature by meta learning to pursue automated provisioning of QoT estimators for a dynamic VNT configuration in optical networks. In particular, we first propose a graph neural network (GNN) design for network-wide QoT estimation. The proposed design learns global VNT representations by disseminating and merging features of virtual nodes (conveying transmitter-side configurations) and links (characterizing physical line systems) according to the routing schemes used. Consequently, the GNN is able to predict the QoT for all the end-to-end connections in a VNT concurrently. A distributed collaborative learning method is also applied for preserving data confidentiality. We train a meta GNN with meta learning to acquire knowledge generalizable across tasks and realize automated QoT estimator provisioning by fine tuning the meta model with a few new samples for each incoming VNT request. Simulation results using data from two realistic topologies show our proposal can generalize QoT estimation for VNTs of arbitrary structures and improves the estimation accuracy by up to 18.7% when compared with the baseline.},
  keywords={Estimation;Optical fiber networks;Training;Substrates;Heuristic algorithms;Data models;Accuracy;Maximum likelihood estimation;Automation;Tuning},
  doi={10.1364/JOCN.534417},
  ISSN={1943-0639},
  month={January},}@INPROCEEDINGS{11437134,
  author={Nagamani, Sikhinam and Renugadevi, N.},
  booktitle={2025 International Conference on Signal Processing, Computation, Electronics, Power and Telecommunication (IConSCEPT)}, 
  title={Robust Face Recognition for Smart Surveillance Using MRFE–GLCM and LTP Variants}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Surveillance systems play a vital role in the safety and protection of people, although they are often faced with problems such as inadequate lighting, occlusions, and pose variations. Conventional face recognition methods typically fail in this kind of setting and deep learning algorithms require significant computational resources, which is incompatible with real time use on a compact IoT device. We present a lightweight texture-feature-based smart surveillance framework in this paper, combining Max-Regional Fuzzy Encoding (MRFE) and the Gray-Level Co-occurrence Matrix (GLCM) statistics and the variations of Local Ternary Pattern (LTP). The MRFE-GLCM component is complementary to enhance strength, as it combines fuzzy regional encoding with global texture encoding, whereas LTP variants are resilient to illumination and noise variations. These characteristics are merged into a small form and categorized with the help of SVM, KNN, and Decision Tree classifiers. It is experimented on benchmark datasets (ORL, YALE, Extended Yale B) that the proposed hybrid has better accuracy than traditional LBP variants and CNN-LBP hybrids, with low computational complexity. Based on a light weight structure, the framework can be used in real time smart surveillance applications, such as secure access control, smart monitoring, and IoT-based public safety systems.The proposed framework should be computationally lean and efficient.Extended performance analysis confirms the robustness and suitability of the model for real-time IoT-based surveillance.},
  keywords={Smart cities;Surveillance;Face recognition;Computational modeling;Noise;Lighting;Fingerprint recognition;Benchmark testing;Real-time systems;Encoding;Smart surveillance;Face recognition;Local Ternary Pattern (LTP);Max-Regional Fuzzy Encoding (MRFE);Gray-Level Co-occurrence Matrix (GLCM)},
  doi={10.1109/IConSCEPT66142.2025.11437134},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11285963,
  author={Chegini, Ali Godarzvand and Arabian, Mohammad and Siavash, Mahdi},
  booktitle={2025 11th International Conference on Control, Instrumentation and Automation (ICCIA)}, 
  title={Design and Implementation of a ROS-Based Intelligent Surveillance System with Real-Time Facial Recognition and Data Logging}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This project explores the development of an intelligent surveillance system capable of real-time video monitoring, facial recognition, and secure appearance data logging. At its core lies the Robot Operating System (ROS), which provides a flexible framework for integrating computer vision, data management, and automated observation functionalities. The study begins with a technical overview of ROS and its modular architecture, detailing essential components' setup, configuration, and deployment. Computer vision algorithms are employed to identify and process human faces from live video streams, enabling the system to build a dynamic visual profile database for security analysis. Experimental results demonstrate the system's effectiveness in recognizing individuals with high accuracy and storing structured data efficiently. This work lays the foundation for future security platforms that merge autonomy, perception, and data intelligence-ushering in a new era of responsive, AI-driven monitoring solutions.},
  keywords={Computer vision;Visualization;Surveillance;Face recognition;Robot kinematics;Heuristic algorithms;Thermal sensors;Real-time systems;Security;Visual databases;-ROS;Robot Guard;Facial Recognition;Surveillance System;Data Logging},
  doi={10.1109/ICCIA69223.2025.11285963},
  ISSN={2688-0229},
  month={Nov},}@INPROCEEDINGS{11132895,
  author={Lu, Shaoqiang and Yu, Xuliang and Zhao, Tiandong and Miao, Siyuan and Sheng, Xinsong and Wu, Chen and Zhao, Liang and Lin, Ting-Jung and He, Lei},
  booktitle={2025 62nd ACM/IEEE Design Automation Conference (DAC)}, 
  title={MambaOPU: An FPGA Overlay Processor for State-space-duality-based Mamba Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={State-space models (SSMs), such as Mamba, have emerged as a promising alternative to Transformers. However, the recently developed Mamba2, based on state space duality (SSD), is highly memorybound and suffers from limited computation efficiency. This inefficiency arises from its irregular broadcast element-wise multiplications and structured sparse computations. In this work, we propose MambaOPU, an FPGA overlay processor, to accelerate SSD. First, to reduce memory overhead, we introduce a software-hardware co-optimized operator fusion framework. Specifically, operator merging combines adjacent broadcast multiplication and summation operations into a single descriptor, while operator backward shifting embeds segment multiplication into subsequent operations. Both techniques shorten the computation path and improve computation efficiency. Second, to enhance sparse computation efficiency, we skip zero-region computations using a tensor-reorder-and-group algorithm combined with a sparse-predefined data fetcher. Additionally, since Mamba integrates linear operations with SSD, we develop a reconfigurable systolic array to improve data reuse across different computation modes. Extensive experiment results demonstrate that MambaOPU achieves up to $1812 \times$ and $880.79 \times$ higher normalized throughput and up to $12908 \times$ and $24.27 \times$ higher energy efficiency over Intel Xeon Gold 6348 CPU and NVIDIA A100 GPU, respectively.},
  keywords={Computational modeling;Graphics processing units;Throughput;Transformers;Energy efficiency;Systolic arrays;Computational efficiency;State-space methods;Resource management;Field programmable gate arrays},
  doi={10.1109/DAC63849.2025.11132895},
  ISSN={},
  month={June},}@ARTICLE{11501928,
  author={D’Andrea, Carmen and Buzzi, Stefano and Fresia, Maria and Wu, Xiaofeng},
  journal={IEEE Open Journal of the Communications Society}, 
  title={Doppler-Resilient UFMC (DR-UFMC): A Beyond-OTFS Waveform for Improved Spectral Efficiency in High-Mobility Scenarios}, 
  year={2026},
  volume={7},
  number={},
  pages={5268-5282},
  abstract={In recent years, alternative methods to orthogonal frequency division multiplexing (OFDM) have emerged to enhance link-level performance of wireless networks in high-mobility environments. This paper introduces a new modulation technique called Doppler-Resilient Universal Filtered MultiCarrier (DR-UFMC). The goal is to merge the enhanced spectral containment of Universal Filtered MultiCarrier (UFMC) modulation with the Doppler shift resilience characteristic of Orthogonal Time Frequency Space (OTFS) modulation. Initially, we present the mathematical framework and the detailed transceiver structure for DR-UFMC modulation. Following this, a novel pilot pre-distortion approach is introduced for channel estimation, allowing the use of conventional schemes designed for OTFS modulation. An iterative method for channel estimation and data detection is also proposed, which iteratively improves the accuracy of the channel estimate and the detected symbols. The numerical evaluation compares DR-UFMC with OTFS and two versions of OFDM. The performance assessment demonstrates DR-UFMC’s superior spectral containment as well as its robustness. Furthermore, both DR-UFMC and OTFS deliver comparable results concerning signal detection and channel estimation, validating the effectiveness of the proposed modulation and of the related transceiver signal processing methods.},
  keywords={Low earth orbit satellites;Artificial satellites;Antennas;Filtering;Filters;Digital filters;Finite impulse response filters;Circuits and systems;Phase noise;Oscillators;OTFS;UFMC;Doppler-resilient modulation;subband filtering;DR-UFMC},
  doi={10.1109/OJCOMS.2026.3689248},
  ISSN={2644-125X},
  month={},}@INPROCEEDINGS{11295144,
  author={Rajagopalan, Srinidhi and M, Harshitha},
  booktitle={2025 9th International Conference on Computational System and Information Technology for Sustainable Solutions (CSITSS)}, 
  title={DishDelight: Your Friendly Indian Culinary Assistant}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={DishDelight is a smart culinary application developed to merge traditional Indian culinary wisdom with modern technological innovations. The project addresses the increasing gap between traditional cooking methods and the modern lifestyle by providing users with features such as AI-driven vegetable identification using deep learning models, millet-based recipe recommendations, and a structured repository of Grandma's traditional home remedies. A dataset of 8,441 images spanning 29 vegetable classes was used to train and evaluate three prominent convolutional neural network architectures: ResNet18, EfficientNet-B0, and DenseNet121. One of the standout features is the intelligent multi-vegetable recipe recommendation system, where users can upload up to five vegetables. The system dynamically displays recipes containing all the selected vegetables, then recipes with additional ingredients, and finally, individual vegetable-based recipes. The application also includes interactive features such as recipe uploads, chef verification, and a quiz module to enhance user engagement. DishDelight aims to serve as a one-stop culinary solution that promotes healthy dietary habits, preserves traditional knowledge, and provides an intelligent and user-friendly cooking experience.},
  keywords={Deep learning;Technological innovation;Computer architecture;Computational efficiency;Convolutional neural networks;Information technology;Artificial intelligence;Recommender systems;Image classification;Smart Culinary Application;Vegetable Identification;Image Classification;Deep Learning;ResNet18;EfficientNet-B0;DenseNet121;Millet Recipes;Multi-Ingredient Recipe Recommendation;Traditional Indian Cooking;Home Remedies;Interactive Learning;AI in Cooking},
  doi={10.1109/CSITSS67709.2025.11295144},
  ISSN={2767-1097},
  month={Nov},}@ARTICLE{11428222,
  author={Mesleh, Raed and Eltira, Khadiga and Abudayah, Mohammad and Ghanem, Manal and Althunibat, Saud and Younis, Abdelhamid},
  journal={IEEE Transactions on Communications}, 
  title={TFTS-Obfuscation: A Combinatorial Spatial-Mapping Framework for Key-Free Physical-Layer Concealment in MIMO Systems}, 
  year={2026},
  volume={74},
  number={},
  pages={6107-6116},
  abstract={This article proposes a two-fold triple system (TFTS)-based obfuscation scheme as a structured physical-layer transmission technique for multiple-input multiple-output (MIMO) systems. TFTS is a class of combinatorial block designs that enables index-based spatial signaling without cryptographic keys or additional computational overhead. The proposed scheme constructs a space-modulation matrix derived from a TFTS of order  $v$ , where each row corresponds to a unique antenna activation pattern transmitting unmodulated carriers. The TFTS combinatorial space is generated by merging two non-isomorphic Steiner triple systems, yielding a mapping space that grows super-exponentially with  $v$ . This growth becomes extreme even for moderate dimensions; for example, at  $v=40$ , the number of valid TFTS realizations exceeds  $10^{10258}$ , rendering exhaustive reconstruction computationally infeasible. The TFTS constellation matrix is assumed to be pre-shared and securely stored at the legitimate transceivers, while an eavesdropper is modeled as a fully informed and computationally unbounded adversary that lacks the correct TFTS mapping and therefore operates under mismatched decoding. Under this adversary model, Eve’s demodulation decisions degrade to random guesses, resulting in an average bit error rate (ABER) approaching 0.5 and negligible exploitable information. Accordingly, the proposed framework is explicitly positioned as a physical-layer obfuscation mechanism rather than a secrecy-capacity or cryptographic security scheme. The obfuscation strength of the system is evaluated through information-leakage analysis, quantifying the mutual information between transmitted indices and Eve’s observations, as well as detectability analysis based on hypothesis testing. Simulation results demonstrate that the proposed TFTS-obfuscation scheme preserves strong performance for the intended receiver in terms of ABER, mutual information, and achievable rate, while maintaining minimal information leakage and low detectability at the eavesdropper.},
  keywords={Receivers;Transmitting antennas;Vectors;Synchronization;Symbols;Spectral efficiency;Mutual information;Reliability engineering;Indexes;Antenna accessories;Obfuscation communication;MIMO;two-fold triple system;combinatorial mathematics;Steiner triple system;performance analysis},
  doi={10.1109/TCOMM.2026.3672592},
  ISSN={1558-0857},
  month={},}@INPROCEEDINGS{11264400,
  author={Bayoumi, Noureldin and Schmitt, Robin and Raissi, Tina and Zeyer, Albert and Schlueter, Ralf and Ney, Hermann},
  booktitle={Speech Communication; 16th ITG Conference}, 
  title={A Comparative Analysis on ASR System Combination for Attention, CTC, Factored Hybrid, and Transducer Models}, 
  year={2025},
  volume={},
  number={},
  pages={86-90},
  abstract={Combination approaches for speech recognition (ASR) systems cover structured sentence-level or word-based merging techniques as well as combination of model scores during beam search. In this work, we compare model combination across popular ASR architectures. Our method leverages the complementary strengths of different models in exploring diverse portions of the search space. We rescore a joint hypothesis list of two model candidates. We then identify the best hypothesis through log-linear combination of these sequence-level scores. While model combination during first-pass recognition may yield improved performance, it introduces variability due to differing decoding methods, making direct comparison more challenging. Our two-pass method ensures consistent comparisons across all system combination results presented in this study. We evaluate model pair candidates with varying architectures and label topologies and units. Experimental results are provided for the Librispeech 960h task.},
  keywords={},
  doi={},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11229296,
  author={Chen, Zhiyue and Yang, Yunfeng and Xu, Huahu and Man, Xueping and Xue, Shuwen and Wang, Hailan},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Optimizing Multi-Scale and Multi-Modal Fusion for Medical Image Segmentation: A Novel MedSwin-UNet Architecture}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Accurate medical image segmentation is crucial in clinical applications. The existing Swin-UNet model overcomes the limitations of traditional Transformers in handling local details and high-frequency information by introducing the Swin Transformer. However, there is still room for improvement in feature fusion and multi-scale information processing. U-shaped segmentation models typically fuse features from different levels using element-wise addition or feature concatenation. However, these fusion strategies fail to fully exploit the complementary nature of features at different levels, resulting in blurry lesion boundary segmentation and thus reducing overall segmentation performance. To overcome these limitations, we propose MedSwin-UNet, a general framework for multi-modal medical image segmentation. Specifically, we equip the model with two key modules: Cross-modal Feature Injection (CFI) and Inter-level Multi-scale Perception (IMP). The CFI module effectively merges local and global features by combining CNN encoder layers with the Swin-UNet encoder, utilizing multi-modal information to enhance the model’s performance in complex medical image tasks. The core component of the IMP module is Deep Feature Enhancement (DFE), which employs a pyramid-style feature enhancement strategy to improve the fusion of deep and shallow features in Swin-UNet, thereby strengthening the model’s ability to capture both image details and overall structure. Our study surpasses most existing state-of-the-art methods on four different medical image segmentation task datasets, achieving excellent performance across multiple evaluation metrics.},
  keywords={Measurement;Image segmentation;Accuracy;Neural networks;Information processing;Transformers;Lesions;Biomedical imaging;medical image segmentation;Swin-UNet;Cross-Modality Feature Injection;Inter-Level Multi-Scale Perception},
  doi={10.1109/IJCNN64981.2025.11229296},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{10171096,
  author={Liu, Qing and Li, Wei and Yu, Shaoyong and Song, Yuping and Zhou, Qidi and Zou, Weilin},
  booktitle={2023 5th International Conference on Intelligent Control, Measurement and Signal Processing (ICMSP)}, 
  title={An Algorithm on Monocular 3D Object Detection Based on Depth Estimation}, 
  year={2023},
  volume={},
  number={},
  pages={1171-1178},
  abstract={The traditional 2D convolution approaches are inappropriate for capturing information about local objects and their scale changes. To better depict 3D structures, the fundamental concept behind it is to mix depth information with RGB data to understand 3D space via depth estimations for creating depth maps of 2D images. However, it places a great deal of reliance on the precision of depth estimate, which results in subpar performance. In this paper, a monocular 3D object detection algorithm is proposed to resolve the issues mentioned earlier. The algorithm depends on the estimation of depth, which is essential for accurately detecting objects using a single camera. To begin with, a Normalization-based Attention Module has been deployed to a backbone network with two branches to extract RGB and depth maps separately. To merge the RGB and depth map features, a depth-guided dynamic local convolutional module is subsequently implemented. Depth map learns exemplar kernels from RGB images using a weight learning submodule and dilation convolution. Then it acts locally on the corresponding RGB images to solve the scale-sensitive problem of objects. By utilizing this approach, it becomes possible to extract feature representations from 2D images and map them onto 3D space, minimizing the disparity between the 2D and 3D representations. Experiments indicate that under the moderate setting of the class car - which is the most significant level of the KITTI dataset - our method outperforms other cutting-edge algorithms.},
  keywords={Three-dimensional displays;Pedestrians;Convolution;Signal processing algorithms;Estimation;Object detection;Feature extraction;Monocular 3D Object Detection;Depth Estimation;2D-3D;NAM;Autonomous Driving},
  doi={10.1109/ICMSP58539.2023.10171096},
  ISSN={},
  month={May},}@INPROCEEDINGS{11487302,
  author={Jiang, Changjiang and Teng, Zhaojun and He, Xuying},
  booktitle={2025 China Automation Congress (CAC)}, 
  title={An improved YOLOv8n model for dense pedestrian detection}, 
  year={2025},
  volume={},
  number={},
  pages={6160-6165},
  abstract={Aiming at the problems of missed and false detections in pedestrian detection tasks in dense scenes, a dense pedestrian detection architecture called EAIA-YOLO is proposed in this work. Incorporation of EfficientNetB0 as the backbone architecture serves to boost the framework’ s feature mining capability and realize more balanced network expansion; The neck component is engineered with the ASFS module, which integrates the hierarchical feature merging component SDI as well as the ASF-YOLO weighted bidirectional feature pyramid networkthereby addressing the issue of inadequate contextual information fusion in the neck; Design an iEMA attention mechanism module that combines self attention mechanism and inverse residual structure to enhance the accuracy of feature extraction; Using ASFF to improve the detection head, solve the problem of object scale changes, achieve accurate feature extraction from images, and effectively integrate global information. Compared to YOLOv8n, the EAIA-YOLO model performs better on the CrowdHuman dataset, mAP@0.5 has registered a gain of 3.4%, mAP@0.5 0.95 has registered a gain of 3.6%, accompanied by merely a slight rise in parameter count. Perform generalization tests on the open-source WiderPerson dataset; mean average precision at IoU 0.5 secures a 1.6% boost relative to YOLOv8n, and mean average precision over the IoU 0.5 - 0.95 range attains a 2.1 % gain. The improved model can effectively complete dense pedestrian detection tasks and has good robustness.},
  keywords={Filtering;Filters;Circuits and systems;Location awareness;Protocols;Mobile communication;Communications technology;Telecommunications;HTTP;Modulation;pedestrian detection;dense pedestrians;YOLOv8n;attention mechanism},
  doi={10.1109/CAC67268.2025.11487302},
  ISSN={2688-0938},
  month={Sep.},}@INPROCEEDINGS{10853557,
  author={Pan, Wenjing and Chen, Xinrong},
  booktitle={6th International Conference on Artificial Intelligence and Advanced Manufacturing (AIAM 2024)}, 
  title={Hand-object interaction reconstruction method based on diffusion model and SDFs}, 
  year={2024},
  volume={2024},
  number={},
  pages={466-475},
  abstract={In this paper, we propose a novel hand-object interaction reconstruction method based on diffusion model and signed distance fields (SDFs). This method uses a multi-scale feature extractor, an attention bridge, a segmentation branch module based on vector merging, and reconstructs the 3D structure of hand and object from monocular color RGB images. In this study, a multi-scale feature extractor is used to extract image features, and the feature representation ability is enhanced by the attention mechanism. In addition, a diffusion model is introduced into the hand and object shape estimation in HOI to optimize the feature extraction, and the Marching Cubes algorithm is used to extract zero isosurfaces from the signed distance field and convert them into grid form to obtain the reconstruction result of the three dimensional surface. Through ObMan data set, we verified the HOI method, and the reconstruction results showed obvious improvement in detail and quality.},
  keywords={},
  doi={10.1049/icp.2024.4266},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11507257,
  author={Mittal, Saksham and B, Santhosh and Namasivayam, B and Muzrapova, Shakhnoza and Matchanova, Barno and O'g'iljon, Artiqova},
  booktitle={2025 IEEE 1st International Conference on Recent Trends in Computing and Smart Mobility (RCSM)}, 
  title={Data Accounting in Agriculture: Satellite, Station & IoT Fusion for Reliable Forecasts}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={A structured assessment and weighting of heterogeneous sensing streams of data accounting enable more reliable agricultural forecasts by exposing and correcting biases, gaps and redundancy across satellite, station and IoT inputs. This paper presents a reproducible pipeline that integrates an explicit data-accounting layer with a physically consistent fusion backbone (ESM–GAMS) and a learned ensemble-weight (EW) operator implemented as an LSTM. This study defines a Data-Value Index (DVI) and a Data-Value Ratio (DVR) to quantify per-source contribution and used those diagnostics inside both the fusion step and a crop-model ensemble merge. Weather-map forecasts were generated with a physics-led downscaling ensemble and a convolutional residual corrector. Crop yields were simulated with a process model and weighted by LSTM-derived EWs that depend on historical and recent data-quality diagnostics. Experiments over three southern India districts for 2010–2022 showed that data accounting reduced precipitation RMSE by 8–16% and decreased crop-model yield bias by 6– 12% relative to naïve fusion.},
  keywords={Internet of Things;Modeling;Long short term memory;Satellites;Crops;Forecasting;Printing;Image sensors;Equations;Weathering;Data Accounting;Data fusion;Satellite;IoT;Weather Forecasting;LSTM;Agriculture},
  doi={10.1109/RCSM67767.2025.11507257},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{8930770,
  author={Bricage, Pierre},
  booktitle={2019 4th World Conference on Complex Systems (WCCS)}, 
  title={Grammar of living systems: allometric scaling laws: Power Laws of Nature: Random, Chance, Limits and Limitations of Emergence}, 
  year={2019},
  volume={},
  number={},
  pages={1-8},
  abstract={The structures and functions of living systems are linked by scaling independent characteristics [1] and quantitative laws [2]. Systems merging into `Associations for the Reciprocal and Mutual Sharing of Advantages and Dis-Advantages' (ARMSADA) allows the emergence of new blueprints. Actors become together more and more mutually integrated into their new Whole and more and more independent from the previous situations [3]. Reversely the Whole is more and more integrating actors. According to the gauge invariance paradigm, not the Kleiber's law but another scaling invariance relation between actors is evidenced: a 2/3 exponent power-law. At every level of organisation, every living system is described with 4 dimensions: VA, the Adult system Volume, and tg, the time of generation, the duration that is necessary to acquire the reproduction capacity [4]. Considering the gauge invariance paradigm as a system, an analysis of a database of interactions allows to quantify 45×18 relations, from the quantum of Planck to the whole Universe, and a `grammar' of processes was evidenced: invariant processes (power laws with exponent € = 0), simultaneous limiting processes (€ = +1), feedbacks (€ = -1), competitions between actors (€ = 1/2) and optimal exchanges (€ = 2/3). The true process governing all functions is Brownian motion [5]. The regulation increase allows more and more autonomy. Living systems optimise input and output of matter and energy at the interfaces [6]. A greater diversity of processes occurs for throughput flows. Whatever the level, living systems optimise the survival by adjusting `the capacity to be hosted' of the endophysiotope (HOSTED) to the changes of `the hosting capacity' of the ecoexotope (HOSTING) [7] (Fig. 10).},
  keywords={Fractals;Organisms;Bidirectional control;Hip;Grammar;ARMSADA;Brownian motion;interface;iteration;interactions;organisation levels;power law;regulation;system},
  doi={10.1109/ICoCS.2019.8930770},
  ISSN={},
  month={April},}@INPROCEEDINGS{10594267,
  author={Fang, Pengwei and Xu, Zhigang},
  booktitle={2024 IEEE 4th International Conference on Electronic Technology, Communication and Information (ICETCI)}, 
  title={YOLOv7-WDD: An Efficient Bi-directional Feature Aggregation Method for Workpiece Defect Detection}, 
  year={2024},
  volume={},
  number={},
  pages={352-357},
  abstract={The efficiency of workpiece defect detection is closely related to ensuring product quality, production safety, and cost savings, making the improvement of workpiece defect detection efficiency of paramount importance as an indispensable part of industrial production processes. This paper introduces YOLOv7-WDD, an efficient algorithm for defect detection. Firstly, it introduces the Re-parameterized Bi-directional Concatenation (Rep-BiC) Module to merge multi-scale contextual features and reconstructs the Neck into a Re-parameterized Bi-directional Path Aggregation Network (RepBiC-PAN), which alleviates the problem of losing key features in traditional feature fusion structures. Secondly, it incorporates DECA (Deformable Coordinate Attention) to expand the model’s overall shape perception of defects in feature extraction and enhance the expression capability of channel and position features. Lastly, it refines the CIoU loss function used in bounding box regression to improve the detection performance for low-quality samples. Experimental analysis shows that for workpiece surface defect detection tasks using the NEU-DET dataset, the proposed method surpasses other similar algorithms in both accuracy and speed, achieving a mAP of 79.5% and a real-time frame rate of 238.1 FPS. Compared to the baseline YOLOv7, it achieves a 3.1% mAP improvement and a 5.5 FPS increase. The proposed method achieves high accuracy in identifying defects on workpiece surfaces while maintaining sufficient real-time performance.},
  keywords={Accuracy;Shape;Bidirectional control;Production;Feature extraction;Real-time systems;Neck;deep learning;computer vision;object detection;workpiece surface defects;YOLOv7;Bi-directional PAN;Loss Function},
  doi={10.1109/ICETCI61221.2024.10594267},
  ISSN={},
  month={May},}@INPROCEEDINGS{10987245,
  author={Kim, Byungchul},
  booktitle={2025 15th International Conference on Power, Energy, and Electrical Engineering (CPEEE)}, 
  title={Decentralized Distributed Online Multiagent Systems Frequency Control}, 
  year={2025},
  volume={},
  number={},
  pages={307-311},
  abstract={Paper suggests a distributed online structure recognition-based summation model predictive control approach for the frequency management. The benefit of the suggested scheme is fundamentally adjustable to the varying system status. As the distributed system global and local variables are recognized via online estimation, the system is robust against exotic system agitation. Paper is employing a split-KalmanNet filter that synchronous the states of recognized model, facilitating a plug and play. The controller is using the recognizing enlargement incremental model, which merges optimal summation performance to reduce the frequency steady state errors. Also, quadratic optimized controller produces constraints restriction to the control inputs not beyond limits during faults, in which supporting controller in executing frequency ride through. The suggested scheme is proved via the IEEE 123 bus regarding the communication delay. Simulation results show enhancement of transient performance, in contrast to the PI.},
  keywords={Time-frequency analysis;Simulation;Robustness;Real-time systems;Delays;Steady-state;Transient analysis;Voltage control;Frequency control;Predictive control;frequency regulation;voltage regulation;Kalman filter;decentralized control;microgrid},
  doi={10.1109/CPEEE64598.2025.10987245},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{9602012,
  author={Yu, Xiao and Wei, Zou and Zhi, Ye and Xiaoping, Liu and Taoming, Zeng and Huang, Rui and Wenwei, Zeng and Weijie, Zeng},
  booktitle={2021 IEEE International Conference on Electrical Engineering and Mechatronics Technology (ICEEMT)}, 
  title={A new method of short-term load forecasting based on the selection of compound variables}, 
  year={2021},
  volume={},
  number={},
  pages={612-618},
  abstract={Accurate short-term load forecasting is an important guarantee for achieving lean operation and management of the power grid. However, there are difficulties in precise forecasting such as short-term load variability and selecting key factors of load forecasting. We establish a short-term load forecasting method based on variational modal decomposition and compound variable selection. The method is used to decompose the original power load data into multiple sub-sequences, and mine short-term load change characteristics while avoiding mode aliasing problems. Meanwhile, a complex variable selection algorithm is proposed to analyze and screen the key factors affecting load changes, effectively eliminating undesired data and further simplifying the complexity of the prediction model. Each sub-sequence is predicted and merged through the long and short-term memory neural network, achieving the final short-term load forecast. The verification results of the actual data of Changsha City selected for the entire year of 2019 show that the algorithm proposed here can accurately select the key influencing factors of load forecasting under complex external influence factors. With traditional forecasting models, the proposed model structure is simpler. The prediction accuracy is higher.},
  keywords={Load forecasting;Input variables;Neural networks;Urban areas;Predictive models;Prediction algorithms;Data models;short-term load forecasting;variational modal decomposition;compound variable selection method;long and short-term memory neural network},
  doi={10.1109/ICEEMT52412.2021.9602012},
  ISSN={},
  month={July},}@INPROCEEDINGS{11156450,
  author={Saw, Indradev and Sahoo, Soumya and Priyanka, Prachi and Jha, Shashwati and Anand, Arpit},
  booktitle={2025 International Conference on Innovations in Intelligent Systems: Advancements in Computing, Communication, and Cybersecurity (ISAC3)}, 
  title={HSTM: Decoding Humor in Memes Through Multimodal Intelligence}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Humor plays an essential role in human communication, impacting emotions, social interaction, and cultural articulation. In the digital age, memes have arisen as a prevailing form of humorous expression by imaginatively combining text and images. Nevertheless, understanding humor in memes is difficult owing to their inherently multimodal structure and the frequent use of sarcasm, irony, and cultural context. Standard sentiment analysis methods often rely on single-modal inputs and find it difficult to capture this complexity. To tackle these limitations, we suggest the humor-specific multimodal transformer (HSMT) a deep learning architecture that merges visual and textual features using an attention-based fusion mechanism. The model incorporates a bidirectional encoder representation from transformers (BERT)-based text encoder and a ResNet-Based image encoder to capture subtle linguistic and visual hints. Furthermore, we incorporate a dedicated sarcasm detection module to boost interpretation of sentiment conveyed in reverse or ironic ways. Evaluated on the Memotion dataset, HSMT shows significant enhancements in classifying humor-related sentiment compared to baseline models. The model demonstrates practical applicability in areas such as social media monitoring, content moderation, brand analysis, and intelligent conversational systems. Future directions involve multilingual humor detection, real-time meme analysis, and adaptive learning strategies to deal with the changing nature of humor.},
  keywords={Visualization;Sentiment analysis;Adaptation models;Technological innovation;Social networking (online);Transformers;Real-time systems;Global communication;Cultural differences;Standards;Humor Detection;Memes;Multimodal Sentiment Analysis;Transformer;Sarcasm Detection;Deep Learning;Memotion Dataset},
  doi={10.1109/ISAC364032.2025.11156450},
  ISSN={},
  month={July},}@INPROCEEDINGS{10704533,
  author={Jiang, Meng and Deng, Qiyuan and Dong, Zhiming and Wang, Xianpeng},
  booktitle={2024 6th International Conference on Data-driven Optimization of Complex Systems (DOCS)}, 
  title={Spatiotemporal Network Model for Prediction of Silicon Content in Hot Metal of Blast Furnace}, 
  year={2024},
  volume={},
  number={},
  pages={767-772},
  abstract={In addressing the prediction issue of silicon content in blast furnace hot metal, previous studies often overlooked the analysis of operational mechanisms in the blast furnace. In response, this study integrates mechanistic knowledge to construct a spatial-temporal network structure (K-STN) that reflects the dynamic interactions of various factors during the smelting process. This approach uses a knowledge graph to represent the spatial relationships among variables within the blast furnace, and combines Graph Convolutional Networks (GCN) with self-attention mechanisms to create a spatial-temporal feature extraction module. This method merges mechanistic analysis with data mining, and improves the model's interpretability. Through practical application, this method has demonstrated superior accuracy and stability in predicting the silicon content of hot metal.},
  keywords={Knowledge engineering;Smelting;Metals;Knowledge graphs;Predictive models;Blast furnaces;Silicon;Stability analysis;Spatiotemporal phenomena;Optimization;blast furnace smelting;spatial-temporal network;prediction model;deep learning},
  doi={10.1109/DOCS63458.2024.10704533},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10895545,
  author={Kumar, Arvind and Dhatterwal, Jagjit Singh and Kumar, Santosh},
  booktitle={2024 1st International Conference on Advances in Computing, Communication and Networking (ICAC2N)}, 
  title={MAS for Autonomous Vehicle Coordination in Engineering}, 
  year={2024},
  volume={},
  number={},
  pages={659-664},
  abstract={The combination of multi-agent systems (MAS) into autonomous vehicle coordination offers a promising means for increasing the efficiency, safety, and sustainability of transportation systems. The purpose of this article is to explore an area of MAS application, namely autonomous vehicle coordination, within the domain of mechanical engineering. Using MAS, autonomous vehicles demonstrate cooperative mechanisms, allowing them to go through difficult roads while observing safety rules and improving traffic flow. The research commences with a discussion of the current literature on autonomous vehicles and MAS, drawing attention to their tight cooperation. We suggest a MAS structure constructed specifically for the specific challenges of vehicle coordination, which subsumes the agent architecture, communication protocols, decision-making algorithms, and coordination strategies. Using real-time data from case studies and simulated experiments, we analyse how MAS framework performs in a heterogeneous environments such as urban traffic control and highway merging. For instance, travel time, congestion reduction, and energy efficiency are the metrics used to evaluate the proposed approach. Issues like scaling up, real-time decision-making, and the inclusion of transportation systems in place are considered, along with possible suggestions for future research. The implications of our research indicate the integrity of MAS in the field of autonomous vehicle coordination engineering at the level of designing, implementing, and optimizing intelligent transportation systems. This research is still an important part of the ongoing conversation on autonomous vehicle technology, and it is still significant in order to help engineers, policymakers, and researchers uncover the potential of MAS for enhancing the safety and efficiency of future transportation networks.},
  keywords={Measurement;Protocols;Decision making;Transportation;Oral communication;Real-time systems;Safety;Mechanical engineering;Autonomous vehicles;Multi-agent systems;Multi-agent Systems;Cooperative Behavior;Intelligent Transport Systems;Mechanical Engineering;Decision Making},
  doi={10.1109/ICAC2N63387.2024.10895545},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11279075,
  author={Dang, Haoran and Ye, Chongnan and Hu, Yanpeng and Wang, Chundong},
  booktitle={2022 59th ACM/IEEE Design Automation Conference (DAC)}, 
  title={NobLSM: An LSM-tree with Non-blocking Writes for SSDs}, 
  year={2022},
  volume={},
  number={},
  pages={403-408},
  abstract={Solid-state drives (SSDs) are gaining popularity. Meanwhile, keyvalue stores built on log-structured merge-tree (LSM-tree) are widely deployed for data management. LSM-tree frequently calls syncs to persist newly-generated files for crash consistency. The blocking syncs are costly for performance. We revisit the necessity of syncs for LSM-tree. We find that Ext4 journaling embraces asynchronous commits to implicitly persist files. Hence, we design NobLSM that makes LSM-tree and Ext4 cooperate to substitute most syncs with non-blocking asynchronous commits, without losing consistency. Experiments show that NobLSM significantly outperforms state-of-the-art LSM-trees with higher throughput on an ordinary SSD. CCS CONCEPTS † Software and its engineering $\rightarrow$ File systems management; † Information systems $\rightarrow$ Key-value stores.},
  keywords={Design automation;Solid state drives;File systems;Throughput;Software;Computer crashes;Synchronization;Information systems;LSM-tree;Key-Value Store;Fsync;Asynchronous Commit},
  doi={},
  ISSN={0738-100X},
  month={June},}@INPROCEEDINGS{11496078,
  author={Elumalai, Saravanan and R, Surendran},
  booktitle={2026 World Conference on Computational Science and Technology (WcCST)}, 
  title={Multi-Scale Sparse Diagnostic Path Learning for Interpretable Histopathological Image Classification}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Deep learning methods currently face significant issues such as feature over, aggregation, varying scales, and lack of interpretability. In order to overcome these limitations, the authors of this paper present a Multi, Scale Sparse Diagnostic Path Learning (MS, SDPL) methodology for classifying histopathological images as benign or malignant. The proposed model combines the encoding of patch features by transformers and a sparse uncertainty, aware routing method to selectively pass on the most reliable evidence for diagnosis. The diagnostic paths are used to represent structured relationships among tissue regions that are spatially separated, while the multi, scale consistency learning method establishes concordance at different magnification levels from $40 x$ to $400 x$. Besides, a hierarchical diagnostic path aggregation mechanism is utilized to merge the local and global tissue information into a concise slide, level feature. The experimental findings reveal that the proposed sparse routing method not only reduces the unnecessary spread of features but also the active diagnostic path (ADP) ratio drops from 0.83 to 0.66 when the patch density is raised. A high diagnostic path consistency above 0.90 is preserved even at different magnifications, thus it is confirmed that there is solid reasoning across scales. Equally, sparse routing leads to a lesser routing entropy around 0.42 as opposed to 0.78 for dense routing, thus it can be inferred that there are less uncertainty and better interpretability. It is these outcomes that prove the capability of MS, SDPL to enable robust, scale, consistent, and interpretable histopathological diagnosis.},
  keywords={Feeds;Antennas;Circuits;Routing;LoRa;Protocols;Communication systems;HTTP;Telecommunications;Data communication;Diagnostic path learning;Histopathological image analysis;Multi-scale learning;Diseases;Transformer-based encoding;Uncertainty modelling;Whole-slide imaging},
  doi={10.1109/WcCST67302.2026.11496078},
  ISSN={},
  month={March},}@INPROCEEDINGS{11504206,
  author={Mahin, Samiha Muntaha and Hasan, Tahmina and Omi, Shamima Sharif and Kabir, Farjana and Ahmed, Jahur and Mahiya, Shafwat},
  booktitle={2025 IEEE International Conference on Signal Processing, Information, Communication and Systems (SPICSCON)}, 
  title={Multimodal approach for PCOS Detection: Integrating Clinical Data and Ovarian Ultrasound with Grad-CAM Interpretability}, 
  year={2025},
  volume={},
  number={},
  pages={634-639},
  abstract={Polycystic Ovary Syndrome (PCOS) is a complex endocrine disorder that benefits from multi-modal diagnostic approaches. In this study, we investigated both clinical tabular data and ovarian ultrasound images to develop an integrated predictive framework. Initially, we analyzed each modality independently: a multilayer perceptron (MLP) was trained on the tabular clinical dataset, while an EfficientNet-B0 network classified ultrasound images into infected and clean categories. To enhance interpretability of the image model, we generated visual explanations using Grad-CAM heatmaps. Finally, we merged the clinical and imaging features into a unified dataset and implemented a hybrid deep-learning model to exploit the complementary information from both modalities. The combined approach demonstrated improved diagnostic performance compared with single-modality models, highlighting the value of fusing structured clinical data with imaging features for more accurate and explainable PCOS detection.},
  keywords={Modeling;Signal detection;Ultrasonic imaging;Accuracy;Printing;Training;Cams;Computer aided manufacturing;Machine learning;Deep learning;Polycystic Ovary Syndrome;multimodal learning;EfficientNet-B0;Grad-CAM;multilayer perceptron;hybrid model;clinical data;ultrasound imaging},
  doi={10.1109/SPICSCON69221.2025.11504206},
  ISSN={},
  month={Nov},}@ARTICLE{8744576,
  author={Zeng, Xianyou and Xu, Long and Cen, Yigang and Zhao, Ruizhen and Hu, Shaohai and Xiao, Guohui},
  journal={IEEE Access}, 
  title={Visual Tracking Based on Multi-Feature and Fast Scale Adaptive Kernelized Correlation Filter}, 
  year={2019},
  volume={7},
  number={},
  pages={83209-83228},
  abstract={Tracking methods based on a correlation filter have attracted much attention because of their high efficiency and strong robustness. However, a tracker based on a single feature is obviously not sufficient to adapt to the complex appearance changes of the target. Besides, rapid and exact scale estimation is still a challenging problem in the field of visual tracking. In this paper, we introduce an independent scale filter for the estimation of the scale of an object and merge two complementary features to further boost the performance of the tracker. At the same time, a dimension reduction strategy is adopted to decrease the computational load. Finally, a dynamic learning rate-based model update mechanism is inserted to effectively alleviate model degradation problem by suppressing the influence of noisy appearance changes. The extensive experiments were conducted on the object tracking benchmark (OTB) dataset and Temple color 128 dataset. The quantitative and qualitative results exhibit that compared with other popular trackers, the tracker proposed in this paper acquires favorable results in tracking accuracy, efficiency, and robustness. On the OTB-2015 benchmark dataset, it obtains precision scores of 0.773, 0.782, and 0.714 and success scores of 0.585, 0.606, and 0.534 in the three indexes of OPE, TRE, and SRE. On the Temple color 128 dataset, it acquires precision scores of 0.641, 0.681, and 0.606 and success scores of 0.478, 0.515, and 0.445 in the three indexes of OPE, TRE, and SRE, surpassing many well-known tracking methods. In terms of tracking efficiency, it runs at a speed of 42.3 frames/s on a single CPU, making it suitable for real-time applications.},
