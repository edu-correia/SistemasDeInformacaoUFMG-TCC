  title={Mastering Concealment: Dual-Veil and the Evolution of Secure Data Transmission}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The increasing prevalence of digital health records and the rise in data breaches necessitate robust security measures to safeguard sensitive patient information. Current methods often fail to ensure confidentiality and integrity, leaving healthcare organizations vulnerable to unauthorized access and potential legal repercussions. The proposed dual-image least significant bit (LSB) based steganography algorithm, Dual-Veil, addresses these challenges by embedding encrypted patient data within dual-channel medical images. In digital imagery, channels represent layers of visual information, evolving from simple monochromatic images to complex multi-channel compositions. The dual-channel image allows for concealing and revealing elements, merging visual components, and conveying nuanced narratives. Our approach utilizes a Stegokey-dependent function to select non-overlapping cover pixels and incorporates encryption before embedding, enhancing dynamism and improving outcomes. This methodology distinguishes between detectability and imperceptibility, concealing data similarly to LSB techniques while adhering to the Kerckhoff principle, thereby establishing new standards for digital steganographic security. Test results demonstrate enhanced algorithmic efficiency, making our contribution notably innovative compared to existing methods. Ultimately, Dual-Veil aligns with regulatory standards, such as HIPAA, and fosters trust between patients and providers by ensuring the secure transmission and storage of critical health information, significantly advancing the quest for comprehensive healthcare data protection. This methodology distinguishes between detectability and imperceptibility while establishing new standards for digital steganographic security. Test results show enhanced algorithmic efficiency, making our contribution notably innovative compared to existing methods.},
  keywords={Visualization;Steganography;Digital images;Standards organizations;Data protection;Algorithmic efficiency;Electronic healthcare;Secure storage;Biomedical imaging;Resilience;data security;digital health records;Isb steganography;dual-channel imagery;healthcare data protection},
  doi={10.1109/ICACS64902.2025.10937884},
  ISSN={2616-3330},
  month={Feb},}@INPROCEEDINGS{10538547,
  author={Sun, Xiuwen and Zhang, Guangzheng and Wu, Di and Yu, Qingying and Cui, Jie and Zhong, Hong},
  booktitle={2023 IEEE 22nd International Conference on Trust, Security and Privacy in Computing and Communications (TrustCom)}, 
  title={Parallel Pattern Matching over Brotli Compressed Network Traffic}, 
  year={2023},
  volume={},
  number={},
  pages={477-484},
  abstract={Pattern matching is a crucial technique for network traffic detection applications. As a fundamental computation model used by pattern matching, the finite state automata execute sequential matching due to the state dependence among transitions. Meanwhile, most services tend to compress their data to improve transmission or storage efficiency. The increased compressed data challenges the straightforward method of matching the whole decompressed data and incurs data dependence among the compression encodings. The related approaches either leverage techniques to break the state dependence of matching uncompressed data or accelerate matching compressed data in a single-threaded manner without considering the state and data dependence. None of them can perform parallel matching over compressed data. This paper provides PETALS, a parallel pattern matching method over Brotli compressed network traffic. PETALS partitions the original compressed traffic into fixed- length blocks for parallel matching and patches the broken compression encodings crossing blocks to break the data dependence. Then, it merges the compressed traffic matching method into path fusion, an enumerative parallelization of finite state automata, to present parallel matching over compressed traffic. Evaluation using real-world network traffic and regular expressions shows that PETALS can raise the speedup from 1.53x to 3.53x of the state-of-the-art parallelization schemes on a 56-cores machine.},
  keywords={Privacy;Instruction sets;Computational modeling;Automata;Telecommunication traffic;Programming;Parallel processing;Parallelization;Compressed Traffic Matching;Brotli;Regular Expression Matching;Pattern Matching},
  doi={10.1109/TrustCom60117.2023.00079},
  ISSN={2324-9013},
  month={Nov},}@INPROCEEDINGS{11506762,
  author={Sinha, Kumari Priyanka and Bhagyalakshmi, L. and T.Haripriya and Bagawan, Irfan and Voddi, Swathi and Suman, Sanjay Kumar},
  booktitle={2025 IEEE 1st International Conference on Recent Trends in Computing and Smart Mobility (RCSM)}, 
  title={Integrating Psychoanalysis with AI for Cognitive Threat Detection in Cyber Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Neuro-Symbolic Adaptive Resonance Framework (NSARF) presented in this research briefs provides the distinctiveness of a project proposed to obtain the cyber identifying threats by merging the advanced modelling (cognition) and artificial intelligence. Conventional cyber defensive strategies are largely geared towards recognizing anomalies that could be identified and signature-like attack mechanism is not always capable of detecting some covert KB of malicious intent. NSARF can address this problem by simulating fundamental cognitive/emotional mechanisms that can assist this solution in determining aggressive real intentionality and the behavior of predicting future assault techniques. The parts of the offered framework are a behaviour-based encoder (the hidden physiological signals), the element of neural representation fusion (combining deep learning extractor and symbol evaluation), and the flexible psychological resonant three-part (perpetual adjustment of the identification and mitigation actions in real-time). This is carried out in layers which not only makes it difficult to be detected, but is also available to a system which is not rivaled in viewing information on sub-reactance goals and tactics that cyber criminals be transporting in their attack. Analytical assessments reveal that NSARF is not less comparable to the classical methods in the sense of detecting and recognising complex and not obvious threats by low levels of false positive rates. The suggested way is an effective solution to meet the contemporary cybersecurity issues - flexible, robust and transparent - as it integrates cognitive analysis with human-like approach and ML. NSARF is a notable forward step in the automated technologies, which can identify threats pro-actively, that can suit rapidly changing emerging and even in highly risky cyber settings. The techniques of NSARF had reached the level of 94.5 percent total accuracy.},
  keywords={Modeling;Printing;Equations;Computer security;Artificial intelligence;Conferences;Cognition;Machine learning;Timing;Context;RF;SVM;DNN;HNFM;NSARF},
  doi={10.1109/RCSM67767.2025.11506762},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11189393,
  author={Ghosh, Soubhik and Paul, Atanu Kumar},
  booktitle={2025 International Conference on Computing, Intelligence, and Application (CIACON)}, 
  title={A Secure Image Encryption Algorithm Based on 3D Logistic Map Hash Function and LFSR}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={To ensure the confidentiality and integrity of image data, image encryption is obligatory in modern digital world. In this paper, we have proposed a novel image encryption algorithm using 3-D Logistic chaotic maps, Hash function and LFSR for generation of secret key sequences. Here the original image of size 128*128 is partitioned into four equal parts of size 64*64 each and then repeatedly partitioning each part until we got 2*2. Keys are used on each 2*2 matrix and then merge all 2*2 matrices to form the 128*128 cipher image. Experimental results showed that the proposed encryption scheme reaches optimum parameter values and it is highly sensitive to minor differences in both secret key and plain image. The effectiveness and performance of this proposed method has been evaluated using several assessments, in which the outcomes confirm that the suggested algorithm shows excellent results in Correlation Coefficient analysis, Histogram analysis, NPCR, UACI, Key sensitivity analysis, PSNR and MSE analysis. This indicates that the proposed scheme not only exhibits excellent encryption but also resists various typical attacks.},
  keywords={Hash functions;Correlation coefficient;Histograms;Ciphers;Three-dimensional displays;PSNR;Sensitivity analysis;Encryption;Partitioning algorithms;Logistics;Linear-Feedback Shift Register;Number of Pixel Change Rate;Unified Average Changing Intensity;Peak Signal-To-Noise Ratio;Mean-Square Error},
  doi={10.1109/CIACON65473.2025.11189393},
  ISSN={},
  month={July},}@INPROCEEDINGS{10633490,
  author={Hu, Yamin and Jiang, Hao},
  booktitle={2024 IEEE 48th Annual Computers, Software, and Applications Conference (COMPSAC)}, 
  title={Predicting Change-Proneness with a Deep Learning Model: Incorporating Structural Dependencies}, 
  year={2024},
  volume={},
  number={},
  pages={1218-1229},
  abstract={Change-proneness prediction aims to identify source files that deserve developers' attention for early quality improvement, ultimately reducing future maintenance costs. Existing studies have utilized diverse change features and machine learning techniques to construct effective prediction models. However, these approaches do not leverage the grouping of change features for the learning of feature representations; and the roles of dependency files in influencing the change-proneness of the target file are not adequately exploited. To this end, in this paper, we propose a novel approach called DeepCP, which utilizes a deep learning model to predict the change-proneness of source files. The key rationale of DeepCP is that the grouping of change features should be considered when constructing deep learning models, given that feeding the sequence of features directly into models has a detrimental impact on the learning of feature representations. To achieve this, DeepCP utilizes different subnetworks to learn different categories of features and merges the resulting representations with a multi-head attention network to generate the source file representation. Another key rationale of DeepCP is that the features of dependency files should be exploited because the change-proneness of dependency files influences that of the target file due to ripple effects. To accomplish this, DeepCP first learns the representations of the target file and its structurally dependent files and then integrates the resulting representations with an attention network. Our evaluation results demonstrate that DeepCP outperforms the state-of-the-art approach in predicting change-proneness.},
  keywords={Deep learning;Costs;Semantics;Predictive models;Software;Graph neural networks;Data models;Change-proneness;software quality;deep learning;structural dependencies},
  doi={10.1109/COMPSAC61105.2024.00162},
  ISSN={2836-3795},
  month={July},}@ARTICLE{11311133,
  author={Sun, Haifeng and Li, Jiaheng and He, Jintao and Gui, Jie and Huang, Qun},
  journal={IEEE Transactions on Networking}, 
  title={Enabling General and Efficient Window Mechanism for In-Network Telemetry}, 
  year={2026},
  volume={34},
  number={},
  pages={2685-2700},
  abstract={Recent network telemetry solutions typically target programmable switches to achieve high performance and in-network visibility. They partition the packet stream into windows and then apply various stream processing techniques to summarize flow-level statistics. However, existing studies focus on the measurement within each window. Window management is still a missing piece due to the resource limitation of programmable switches. In this paper, we propose OmniWindow, a general and efficient window mechanism framework. OmniWindow splits the original window into fine-grained sub-windows such that the sub-windows can be merged into various window types. To deal with the resource restriction, OmniWindow carefully designs its data plane memory layout and proposes a window synchronization method. It also employs a collaborative architecture that can collect and reset stateful data in sub-windows within a limited time. We prototype OmniWindow on Tofino. We incorporate OmniWindow into a SOTA query-driven telemetry system and eight sketch-based telemetry algorithms. Our experiments demonstrate that OmniWindow enables these telemetry solutions to achieve higher accuracy than conventional window mechanism.},
  keywords={Telemetry;Pipelines;Synchronization;Accuracy;Monitoring;Layout;Telecommunication traffic;System-on-chip;Prototypes;Optimization;Window mechanism;network telemetry},
  doi={10.1109/TON.2025.3646730},
  ISSN={2998-4157},
  month={},}@INPROCEEDINGS{9526961,
  author={Yao, Wei and Li, Chao},
  booktitle={2021 6th International Conference on Image, Vision and Computing (ICIVC)}, 
  title={A Distributed Face Retrieval System for Large-Scale Social Networking Avatars}, 
  year={2021},
  volume={},
  number={},
  pages={289-294},
  abstract={In order to solve the problems of poor accuracy and slow speed in face retrieval for large-scale social networking avatars, this paper proposes a real-time distributed face retrieval system supporting hundreds of millions for face images. Firstly, we detect face and learn the face feature vector by combined convolutional neural network models. Secondly, the locality sensitive hash algorithm is used to transform the high-dimensional feature into low-dimensional. Meanwhile, a distributed face feature vector database is proposed to balance the storage pressure for one single server node as well as to accelerate query speed by computing similarity score in parallel and merging sort results from all distributed server nodes. Experimental results show that the distributed system designed in this paper can efficiently, accurately and timely retrieve faces from large-scale social networking avatars.},
  keywords={Deep learning;Image recognition;Social networking (online);Avatars;Face recognition;Transforms;Feature extraction;face retrieval;face recognition;convolutional neural network;locality sensitive hashing;distributed computing},
  doi={10.1109/ICIVC52351.2021.9526961},
  ISSN={},
  month={July},}@INPROCEEDINGS{11452337,
  author={Sarraf, Gaurav},
  booktitle={2026 International Conference on Computing, Communication, Control and Cyber-Physical Systems (I5CPS)}, 
  title={EdgeIDS: Distributed Machine Learning Framework for Scalable IoT Network Protection}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Detection and prevention of network attacks have become important in the industrial sector in the fast-changing cybersecurity environment. The research offers a robust intrusion detection architecture for IoT environments using a CNN-GRU deep learning framework, which stands for hybrid Convolutional Neural Network and Gated Recurrent Unit. Using the Edge-IIoT-2022 dataset, the research applies class imbalance (Random Under-Sampling) and feature importance (Random Forest-based selection). The proposed model shows better performance with accuracy of 99.99%, precision of 99.87%, recall of 99.99% and F1score of 99.32% as compared to the baseline models like DT (Decision Tree), LDA (Linear Discriminant Analysis), RNN (Recurrent Neural Network) and AdaBoost (Adaptive Boosting). The model achieves high convergence rates and low loss rates, and AUC scores are perfect across all classes, which validates its generalization ability. These results support the validity of the merging of spatial and temporal learning based on CNN and GRU layers supported by robust preprocessing and feature selection. The findings demonstrate that the hybrid CNN-GRU is the most reliable and accurate choice for intrusion detection in IIoT scenarios.},
  keywords={Adaptation models;Analytical models;Accuracy;Image edge detection;Prevention and mitigation;Network intrusion detection;Convolutional neural networks;Reliability;Computer security;Protection;Internet of Things (IoT);Network Intrusion Detection System (NIDS);Cybersecurity;Machine Learning (ML);Edge Computing;IoT Security},
  doi={10.1109/I5CPS67958.2026.11452337},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10722178,
  author={Mohamed Ali, E A and M, Vinoth and Kalpanadevi, G and Subbulakshmi, M and Dharani, R},
  booktitle={2024 5th International Conference on Smart Electronics and Communication (ICOSEC)}, 
  title={A Detailed Analysis of Wavelet based Multi-Focus Image Fusion Techniques}, 
  year={2024},
  volume={},
  number={},
  pages={2021-2026},
  abstract={Image fusion combines multiple images of a single scene or object, captured by various sensors or from different angles, to create an enhanced composite image with greater informational content. This process has applications across diverse fields, including remote sensing, medical diagnostics, security systems, robotics, augmented reality, and stereovision. Its primary objectives include improving visual details, overall image quality, and offering novel perspectives. Among the various fusion methods, wavelet-based techniques have gained popularity due to their ability to preserve crucial details, minimize noise, and enhance visual quality. This study aims to compare the efficacy of eight distinct wavelet-based multi-focus image fusion approaches. To assess the spectral and spatial characteristics of the resulting fused images, the research employs eight performance metrics, providing a comprehensive analysis of these techniques. The findings of this comparative study are important for deciding which method is the simplest, most effective, and fastest to produce high-quality merged images. This will enable it to be used with a variety of imaging modalities, especially those that have limited hardware resources or produce images with a high level of quality.},
  keywords={Location awareness;Measurement;Visualization;Time-frequency analysis;Image resolution;Noise;Wavelet analysis;Discrete wavelet transforms;Stereo vision;Image fusion;Wavelet transform;Image fusion;Multi resolution;Performance metrics},
  doi={10.1109/ICOSEC61587.2024.10722178},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{9297542,
  author={Roy, Sovan and Siddiquee, Shah Md. Tanvir and Rahman, Md. Khalidur and Marouf, Ahmed Al},
  booktitle={2020 4th International Conference on Electronics, Communication and Aerospace Technology (ICECA)}, 
  title={A Novel Authentication Method for Password Encryption}, 
  year={2020},
  volume={},
  number={},
  pages={780-785},
  abstract={Data hacking has become one of the anxiety issue in this modern era. Therefore, we have to prevent this illegal data hacking, theft at any cost. For ensuring data integrity, there are many methods including backups, encryption, access control, etc. We have presented an encryption methodology without merging the existing methods. By using the number conversion system and a defined mathematical calculation equation is the key to encrypt the password of the users. The password and date of birth are inputted by the users during the signup process. The encryption of the passwords has been stored into the database and manual calculation for the same cardinalities provides the same result. We have achieved an accuracy of 96% which is good as well as promising. Encryption is using in every sector to protect data and it has a wide range of future to work with it.},
  keywords={Password;Encryption;Three-dimensional displays;Databases;Authentication;Software algorithms;Hardware;Password Encryption;Personalized Authentication;RSA Algorithm;Diffie-Helman algorithm},
  doi={10.1109/ICECA49313.2020.9297542},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10245224,
  author={Dhanya, G.S. and Celestin Vigila, S. Maria},
  booktitle={2023 International Conference on Circuit Power and Computing Technologies (ICCPCT)}, 
  title={Fog Computing with Optimized Block Chain Technique for IoT Based Data Security}, 
  year={2023},
  volume={},
  number={},
  pages={1142-1147},
  abstract={The Internet of Things (IoT) for medical purposes offers a number of benefits, including the aptitude to follow the individual's physical state over a range of time intervals and transmitting data in real time. Using gadgets like glucose meters, heart monitoring implants, Electrocardiogram (ECG), blood pressure monitors, Electroencephalography (EEG) and Electromyography (EMG) wearable strategies, medical personnel can gather local patient wellness data and make choices based on it. The IoT devices' weak authentication and encryption procedures make them readily hackable and may expose users to a number of risks, some of which could be fatal. The Quality of Service (QoS) needs for healthcare IoT devices, such as dependability, authorization, identity and security, cannot be met by current algorithms using machine learning or blockchain approaches operating in the cloud computing environment. Henceforth the proposed work develops an advanced Fog computing (FC) to oppose advance cloud computing at an edge of networks together with Block chain topology. Fog computing has been emphasized as promising method for low-cost remote monitoring, limiting down on latency, and boosting efficiency, while blockchain has been touted for guaranteeing the security of private data, building a decentralized database, and improving data interoperability. The problem of healthcare IoT device recognition, permission and confirmation for scalability often broadcast of data in a distributed setting can be handled by merging FC with block chain. So, leveraging FC and blockchain, a creative solution to the aforementioned issue.},
  keywords={Cloud computing;Authentication;Medical services;Quality of service;Electromyography;Electroencephalography;Blockchains;IoT- Internet of Things;FC-Fog Computing;CSA-Crow Search Algorithm;GKA-Group Key Authentication;SDN- Software defined Networks;PHD-Patient Health Data},
  doi={10.1109/ICCPCT58313.2023.10245224},
  ISSN={},
  month={Aug},}@ARTICLE{11459403,
  author={Liu, Shizhe and Dai, Haipeng and Song, Shaoxu and Li, Meng and Zhang, Yuemeng and Wang, Hancheng and Zhang, Du and Gu, Rong and Chen, Guihai},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={Accelerating Complex Event Recognition via Range Bitmap-Based Indexes With Window-Wise Filtering}, 
  year={2026},
  volume={38},
  number={6},
  pages={3385-3400},
  abstract={Complex event recognition (CER) refers to identifying specific patterns composed of several primitive events in event stores. Since full-scanning event stores to identify primitive events that hold query constraint conditions incurs costly I/O overhead, a mainstream and practical approach is to use index techniques to obtain these events. However, prior index-based approaches suffer from significant I/O and sorting overhead when processing the query with high predicate selectivity or long query window, which leads to high query latency. To address this issue, we propose ACER, a Range Bitmap-based index, to accelerate CER. First, ACER achieves a low index space overhead by grouping the events with the same type into a cluster and compressing the cluster data, reducing I/O overhead when reading indexes. Second, ACER builds Range Bitmaps for queried attributes and ensures that the events of each cluster in the index block are chronologically ordered. Then, ACER can always obtain ordered query results for a specific event type through merge operations, avoiding sorting overhead. Most importantly, ACER avoids unnecessary disk accesses in indexes and events via window-wise filtering, thus reducing the I/O overhead further. Lastly, we propose an enhanced version of ACER (ACER-E) by optimizing the read/write operation of index blocks and variable query order. Our extensive experiments demonstrate that ACER and ACER-E reduce the query latency by up to one order of magnitude compared with SOTA techniques.},
  keywords={Feeds;Filtering;Filters;Circuits and systems;Event detection;Radio access networks;Regional area networks;Wireless sensor networks;Communication systems;Internet;Complex event recognition;bitmap indexes;window-wise filtering},
  doi={10.1109/TKDE.2026.3679736},
  ISSN={1558-2191},
  month={June},}@INPROCEEDINGS{9710951,
  author={Shenga, Hualian and Cai, Sijia and Liu, Yuan and Deng, Bing and Huang, Jianqiang and Hua, Xian-Sheng and Zhao, Min-Jian},
  booktitle={2021 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Improving 3D Object Detection with Channel-wise Transformer}, 
  year={2021},
  volume={},
  number={},
  pages={2723-2732},
  abstract={Though 3D object detection from point clouds has achieved rapid progress in recent years, the lack of flexible and high-performance proposal refinement remains a great hurdle for existing state-of-the-art two-stage detectors. Previous works on refining 3D proposals have relied on human-designed components such as keypoints sampling, set abstraction and multi-scale feature fusion to produce powerful 3D object representations. Such methods, however, have limited ability to capture rich contextual dependencies among points. In this paper, we leverage the high-quality region proposal network and a Channel-wise Transformer architecture to constitute our two-stage 3D object detection framework (CT3D) with minimal hand-crafted design. The proposed CT3D simultaneously performs proposal-aware embedding and channel-wise context aggregation for the point features within each proposal. Specifically, CT3D uses proposal’s keypoints for spatial contextual modelling and learns attention propagation in the encoding module, mapping the proposal to point embeddings. Next, a new channel-wise decoding module enriches the query-key interaction via channel-wise re-weighting to effectively merge multi-level contexts, which contributes to more accurate object predictions. Extensive experiments demonstrate that our CT3D method has superior performance and excellent scalability. Remarkably, CT3D achieves the AP of 81.77% in the moderate car category on the KITTI test 3D detection benchmark, outperforms state-of-the-art 3D detectors.},
  keywords={Point cloud compression;Three-dimensional displays;Object detection;Detectors;Transforms;Transformers;Encoding;Detection and localization in 2D and 3D},
  doi={10.1109/ICCV48922.2021.00274},
  ISSN={2380-7504},
  month={Oct},}@ARTICLE{9475913,
  author={Blasch, Erik and Pham, Tien and Chong, Chee-Yee and Koch, Wolfgang and Leung, Henry and Braines, Dave and Abdelzaher, Tarek},
  journal={IEEE Aerospace and Electronic Systems Magazine}, 
  title={Machine Learning/Artificial Intelligence for Sensor Data Fusion–Opportunities and Challenges}, 
  year={2021},
  volume={36},
  number={7},
  pages={80-93},
  abstract={During Fusion 2019 Conference (https://www.fusion2019.org/program.html), leading experts presented ideas on the historical, contemporary, and future coordination of artificial intelligence/machine learning (AI/ML) with sensor data fusion (SDF). While AI/ML and SDF concepts have had a rich history since the early 1900s—emerging from philosophy and psychology—it was not until the dawn of computers that both AI/ML and SDF researchers initiated discussions on how mathematical techniques could be implemented for real-time analysis. ML, and in particular deep learning, has demonstrated tremendous success in computer vision, natural language understanding, and data analytics. As a result, ML has been proposed as the solution to many problems that inherently include multi-modal data. For example, success in autonomous vehicles has validated the promise of ML with SDF, but additional research is needed to explain, understand, and coordinate heterogeneous data analytics for situation awareness. The panel identified opportunities for merging AI/ML and SDF such as computational efficiency, improved decision making, expanding knowledge, and providing security; while highlighting challenges for multi-domain operations, human-machine teaming, and ethical deployment strategies.},
  keywords={Uncertainty;Data analysis;Psychology;Reinforcement learning;Big Data;Data models;Robustness},
  doi={10.1109/MAES.2020.3049030},
  ISSN={1557-959X},
  month={July},}@INPROCEEDINGS{10611018,
  author={Chen, Long and Sinavski, Oleg and Hünermann, Jan and Karnsund, Alice and Willmott, Andrew James and Birch, Danny and Maund, Daniel and Shotton, Jamie},
  booktitle={2024 IEEE International Conference on Robotics and Automation (ICRA)}, 
  title={Driving with LLMs: Fusing Object-Level Vector Modality for Explainable Autonomous Driving}, 
  year={2024},
  volume={},
  number={},
  pages={14093-14100},
  abstract={Large Language Models (LLMs) have shown promise in the autonomous driving sector, particularly in generalization and interpretability. We introduce a unique objectlevel multimodal LLM architecture that merges vectorized numeric modalities with a pre-trained LLM to improve context understanding in driving situations. We also present a new dataset of 160k QA pairs derived from 10k driving scenarios, paired with high quality control commands collected with RL agent and question answer pairs generated by teacher LLM (GPT-3.5). A distinct pretraining strategy is devised to align numeric vector modalities with static LLM representations using vector captioning language data. We also introduce an evaluation metric for Driving QA and demonstrate our LLM-driver’s proficiency in interpreting driving scenarios, answering questions, and decision-making. Our findings highlight the potential of LLM-based driving action generation in comparison to traditional behavioral cloning. We make our benchmark, datasets, and model available1 for further exploration.},
  keywords={Measurement;Large language models;Decision making;Cloning;Quality control;Benchmark testing;Vectors},
  doi={10.1109/ICRA57147.2024.10611018},
  ISSN={},
  month={May},}@ARTICLE{8988175,
  author={Afrasiabi, Mousa and Mohammadi, Mohammad and Rastegar, Mohammad and Stankovic, Lina and Afrasiabi, Shahabodin and Khazaei, Mohammad},
  journal={IEEE Transactions on Smart Grid}, 
  title={Deep-Based Conditional Probability Density Function Forecasting of Residential Loads}, 
  year={2020},
  volume={11},
  number={4},
  pages={3646-3657},
  abstract={This paper proposes a direct model for conditional probability density forecasting of residential loads, based on a deep mixture network. Probabilistic residential load forecasting can provide comprehensive information about future uncertainties in demand. An end-to-end composite model comprising convolution neural networks (CNNs) and gated recurrent unit (GRU) is designed for probabilistic residential load forecasting. Then, the designed deep model is merged into a mixture density network (MDN) to directly predict probability density functions (PDFs). In addition, several techniques, including adversarial training, are presented to formulate a new loss function in the direct probabilistic residential load forecasting (PRLF) model. Several state-of-the-art deep and shallow forecasting models are also presented in order to compare the results. Furthermore, the effectiveness of the proposed deep mixture model in characterizing predicted PDFs is demonstrated through comparison with kernel density estimation, Monte Carlo dropout, a combined probabilistic load forecasting method and the proposed MDN without adversarial training.},
  keywords={Load modeling;Forecasting;Uncertainty;Predictive models;Probability density function;Load forecasting;Time series analysis;Residential load forecasting;conditional probabilistic load forecasting;deep mixture network;convolutional neural network;gated recurrent unit},
  doi={10.1109/TSG.2020.2972513},
  ISSN={1949-3061},
  month={July},}@INPROCEEDINGS{9880012,
  author={Yang, Gengshan and Vo, Minh and Neverova, Natalia and Ramanan, Deva and Vedaldi, Andrea and Joo, Hanbyul},
  booktitle={2022 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)}, 
  title={BANMo: Building Animatable 3D Neural Models from Many Casual Videos}, 
  year={2022},
  volume={},
  number={},
  pages={2853-2863},
  abstract={Prior work for articulated 3D shape reconstruction often relies on specialized multi-view and depth sensors or pre-built deformable 3D models. Such methods do not scale to diverse sets of objects in the wild. We present a method that requires neither of them. It aims to create high-fidelity, articulated 3D models from many casual RGB videos in a differentiable rendering framework. Our key in-sight is to merge three schools of thought: (1) classic deformable shape models that make use of articulated bones and blend skinning, (2) canonical embeddings that establish correspondences between pixels and a canonical 3D model, and (3) volumetric neural radiance fields (NeRFs) that are amenable to gradient-based optimization. We introduce neural blend skinning models that allow for differentiable and invertible articulated deformations. When combined with canonical embeddings, such models allow us to establish dense correspondences across videos that can be self-supervised with cycle consistency. On real and synthetic datasets, our method shows higher-fidelity 3D reconstructions than prior works for humans and animals, with the ability to render realistic images from novel viewpoints. Project page: https://banmo-www.github.io/.},
  keywords={Deformable models;Solid modeling;Three-dimensional displays;Tracking;Shape;Pose estimation;Rendering (computer graphics);3D from single images; 3D from multi-view and sensors; Motion and tracking; Pose estimation and tracking; Vision + graphics},
  doi={10.1109/CVPR52688.2022.00288},
  ISSN={2575-7075},
  month={June},}@ARTICLE{9819830,
  author={Cai, Peide and Wang, Hengli and Sun, Yuxiang and Liu, Ming},
  journal={IEEE Transactions on Intelligent Transportation Systems}, 
  title={DQ-GAT: Towards Safe and Efficient Autonomous Driving With Deep Q-Learning and Graph Attention Networks}, 
  year={2022},
  volume={23},
  number={11},
  pages={21102-21112},
  abstract={Autonomous driving in multi-agent dynamic traffic scenarios is challenging: the behaviors of road users are uncertain and are hard to model explicitly, and the ego-vehicle should apply complicated negotiation skills with them, such as yielding, merging and taking turns, to achieve both safe and efficient driving in various settings. Traditional planning methods are largely rule-based and scale poorly in these complex dynamic scenarios, often leading to reactive or even overly conservative behaviors. Therefore, they require tedious human efforts to maintain workability. Recently, deep learning-based methods have shown promising results with better generalization capability but less hand engineering efforts. However, they are either implemented with supervised imitation learning (IL), which suffers from dataset bias and distribution mismatch issues, or are trained with deep reinforcement learning (DRL) but focus on one specific traffic scenario. In this work, we propose DQ-GAT to achieve scalable and proactive autonomous driving, where graph attention-based networks are used to implicitly model interactions, and deep Q-learning is employed to train the network end-to-end in an unsupervised manner. Extensive experiments in a high-fidelity driving simulator show that our method achieves higher success rates than previous learning-based methods and a traditional rule-based method, and better trades off safety and efficiency in both seen and unseen scenarios. Moreover, qualitative results on a trajectory dataset indicate that our learned policy can be transferred to the real world for practical applications with real-time speeds. Demonstration videos are available at https://caipeide.github.io/dq-gat/.},
