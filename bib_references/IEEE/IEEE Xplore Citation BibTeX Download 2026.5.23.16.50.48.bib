@ARTICLE{10445792,
  author={Fang, Hongliang and Xiao, Jiang-Wen and Wang, Yan-Wu and Chung, C. Y.},
  journal={IEEE Transactions on Instrumentation and Measurement}, 
  title={A New Binary Encoding Method for Energy Consumption Patterns Quantification}, 
  year={2024},
  volume={73},
  number={},
  pages={1-12},
  abstract={Extracting users’ energy consumption patterns (ECPs) from smart meter data is an important work for retailers. The existing literature usually describe these patterns by clustering the daily load curves (DLCs), but lack a clear and quantified representation to explain what the exact schema of a user is. Therefore, this article proposes a new binary encoding method for ECPs quantification. Specifically, first, both time and value intervals are divided for dimensionality reduction based on the similarity of adjacent timestamp loads. Then, a binary aggregate approximation (BAX) method is proposed to encode each DLC into a BAX word, and the BAX words of users are merged to obtain the schemas with a three-element alphabet. Finally, based on the schemas, the stability scores of users’ patterns are quantified and are used to select target users for demand response (DR) measures. Case studies on a real dataset with 5566 users show that each target user averagely contributes to 0.172% of peak reduction, while each unselected user only contributes to 0.026%. Furthermore, to obtain target schemas and to find new users in future DR measures, a  $K$ -means symbolic algorithm is designed to cluster BAX words of target users. The proposed encoding method and the findings can provide guidance of finding typical target users for DR measures.},
  keywords={Stability analysis;Meters;Encoding;Dimensionality reduction;Clustering methods;Numerical stability;Clustering algorithms;Binary aggregate approximation (BAX);dimension reduction;energy consumption pattern (ECP);K-means symbolic algorithm;stability quantification},
  doi={10.1109/TIM.2024.3370803},
  ISSN={1557-9662},
  month={},}@INPROCEEDINGS{10276056,
  author={Gowda, Pourav P and Gawade, Hrishikesh Shankar and Patro, K Abhimanyu Kumar},
  booktitle={2023 International Conference on Network, Multimedia and Information Technology (NMITCON)}, 
  title={A Fast and Secure Diffusion Key-Based Colour Image Encryptions Using One-Dimensional Chaotic Maps}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Images are a highly valuable medium for communicating data, as they possess the unique capability to visually represent information and convey a multitude of messages. Unfortunately, there is currently a deficiency in the development and research of rapid encryption methods specifically designed for colour images. This paper proposes a rapid and reliable scheme for encrypting colour images through the utilisation of one-dimensional (1D) chaotic maps in diffusion key-based encryption. The proposed technique involves an initial step of separating the three parts, namely blue, green, and red. Following this, the three components are horizontally concatenated. Chaotic key-based diffusion operations are performed on individual pixels that have been selected by indexing sequences based on chaotic maps. This process is repeated for each selected pixel. The diffused output is partitioned into three constituents and merged to produce the cipher images. The proposed method is deemed to be efficient due to its utilisation of a straightforward and effective colour image encryption procedure, coupled with the repeated use of a single 1D chaotic map. This approach results in a notably fast encryption process. The security of the proposed method is attributed to the utilisation of individual pixel diffusion operations based on chaotic keys. Based on the computer simulations and analysis on security, it has been determined that the suggested scheme is both efficient and secure in its ability to encrypt colour images of varying dimensions.},
  keywords={Ciphers;Chaotic communication;Image color analysis;Computer simulation;Encryption;Reliability;Information technology;security;image encryption;chaos;SHA algorithm},
  doi={10.1109/NMITCON58196.2023.10276056},
  ISSN={},
  month={Sep.},}@ARTICLE{11493738,
  author={Xie, Dongdong and Wang, Pinghui and Yang, Chengjin and Chen, Tianjunjie and Zhao, Junzhou and Guan, Xiaohong},
  journal={IEEE Transactions on Dependable and Secure Computing}, 
  title={Flexible Privacy-Preserving Cardinality Query for Massive Distributed Datasets}, 
  year={2026},
  volume={},
  number={},
  pages={1-18},
  abstract={Counting distinct elements (cardinality) across multiple data holders (DHs) privately is fundamental with broad applications, ranging from crowd counting to network monitoring. It is referred to as private distributed cardinality estimation (PDCE). Similarly, determining the intersection cardinality between the unions of two DH groups holds practical significance, a problem we call private distributed intersection cardinality estimation (PDICE). While many efficient methods (e.g., FM and LL sketches) exist, their differential privacy relies on secret hash functions. In PDCE, DHs must share the functions to enable sketch merging, which breaks this assumption and invalidates such guarantees. Although a recent protocol implements the FM sketch on a secret-sharing-based multiparty computation (MPC) framework for PDCE, we observe that it lacks differential privacy guarantees and is computationally expensive. To address these limitations, we propose DP-DICE-Bino, a novel protocol that is computationally efficient and differentially private for PDCE. DP-DICE-Bino is flexible in that it can compute the cardinality of any group of DHs without repeatedly interacting with the DHs. Furthermore, DP-DICE-Bino can also handle PDICE. Experiments show that DP-DICE-Bino achieves orders-of-magnitude speedups and reduces the estimation error by several times compared with the state of the art under the same security requirements.},
  keywords={Frequency modulation;Radio broadcasting;Broadcasting;Broadcast technology;Filtering;Filters;Circuits;Circuits and systems;Protocols;Communication systems;cardinality estimation;differential privacy;secure multi-party computation},
  doi={10.1109/TDSC.2026.3687031},
  ISSN={1941-0018},
  month={},}@ARTICLE{10084459,
  author={Matzko, William and Satyapal, Shobita and Ellison, Sara L and Sexton, Remington O and Secrest, Nathan J and Canalizo, Gabriela and Blecha, Laura and Patton, David R and Scudder, Jillian M},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Galaxy pairs in the Sloan Digital Sky Survey – XV. Properties of ionized outflows}, 
  year={2021},
  volume={514},
  number={4},
  pages={4828-4844},
  abstract={Powerful outflows are thought to play a critical role in galaxy evolution and black hole growth. We present the first large-scale systematic study of ionized outflows in paired galaxies and post-mergers compared to a robust control sample of isolated galaxies. We isolate the impact of the merger environment to determine if outflow properties depend on merger stage. Our sample contains ∼4000 paired galaxies and ∼250 post-mergers in the local universe (0.02 ≤ z ≤ 0.2) from the Sloan Digital Sky Survey Data Release 7 (SDSS DR 7) matched in stellar mass, redshift, local density of galaxies, and [O III] λ5007 luminosity to a control sample of isolated galaxies. By fitting the [O III] λ5007 line, we find ionized outflows in ∼15 per cent of our entire sample. Outflows are much rarer in star-forming galaxies compared to active galactic nuclei (AGNs), and outflow incidence and velocity increase with [O III] λ5007 luminosity. Outflow incidence is significantly elevated in the optical + mid-infrared selected AGN compared to purely optical AGN; over 60 per cent show outflows at the highest luminosities ($L_{\mathrm{[OIII]~\lambda 5007}}\, \gtrsim$ 1042 erg s−1), suggesting mid-infrared AGN selection favours galaxies with powerful outflows, at least for higher [O III] λ5007 luminosities. However, we find no statistically significant difference in outflow incidence, velocity, and luminosity in mergers compared to isolated galaxies, and there is no dependence on merger stage. Therefore, while interactions are predicted to drive gas inflows and subsequently trigger nuclear star formation and accretion activity, when the power source of the outflow is controlled for, the merging environment has no further impact on the large-scale ionized outflows as traced by [O III] λ5007.},
  keywords={ISM: jets and outflows;galaxies: active;galaxies: evolution;galaxies: interactions},
  doi={10.1093/mnras/stac1506},
  ISSN={1365-2966},
  month={Nov},}@INPROCEEDINGS{10270081,
  author={Nikhade, Suraj and Patil, Wani},
  booktitle={2023 3rd Asian Conference on Innovation in Technology (ASIANCON)}, 
  title={Advanced Android Based In-Vehicle Infotainment (IVI) Software Testing}, 
  year={2023},
  volume={},
  number={},
  pages={1-9},
  abstract={Manufacturers from all over the world are vying now to create the most cutting-edge digital cockpits for their next vehicles. These characteristics are derived mostly from other related technologies now in use by consumers. As high-tech safety systems are being built into automobiles these days, the future of the cockpit is changing. Users will expect connected, secure, and improved mobility interfaces from the digital cockpit of the future. Without sacrificing security or performance, a digital cockpit controller system allows for the simultaneous operation of Infotainment, Instrument Cluster, and ADAS functions in real time from a single SoC. It is capable of powering several HuD and other high-resolution monitors. New connected features, intuitive HMI, on-the-go entertainment, and safety features are drawing in customers, making it crucial for OEMs to set themselves apart in the realm of Cockpit electronics. The modern digital cockpit is defined by features such as internet-connected infotainment systems with a virtual assistant and streaming media, larger and higher resolution 3D displays, all-digital instrument clusters, Augmented reality-based head-up displays, and other advanced driver assistance systems (ADAS) like surround-view, eMirror, etc. Expansion opportunities exist for suppliers of linked digital cockpits thanks to the development of a cockpit domain controller architecture that consolidates these disparate functions onto a single multi-core SoC and ECUs. Centralized computer technologies that merge previously independent fields into the automobile's control panel are the driving force behind the current mobility revolution.},
  keywords={Instruments;Entertainment industry;Transportation;Streaming media;Safety;Automobiles;Advanced driver assistance systems;Infotainment testing;Software testing;Android based In-Vehicle system;Modern concept of testing},
  doi={10.1109/ASIANCON58793.2023.10270081},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{9213653,
  author={Peizhe, Li and Chaoqun, Liu and Kai, Yang and Mingjie, Zhang and Fei, Gao and Jingwen, Xu and Yunwei, Zhang},
  booktitle={2020 IEEE International Conference on Advances in Electrical Engineering and Computer Applications( AEECA)}, 
  title={SDN-based traffic scheduling scheme for energy storage data center based on differential algorithm and congestion degree}, 
  year={2020},
  volume={},
  number={},
  pages={75-80},
  abstract={In recent years, energy storage power stations gradually merge into data centers. This paper studies the traffic scheduling problem of the energy storage data center network to improve network performance. A traffic scheduling scheme based on differential algorithms and congestion is proposed with the idea of separating the control plane from the data plane of the Software Defined Network. This scheme is divided into two parts: the introduction and improvement of the differential algorithm for unified scheduling of multiple traffic with the same sources and sinks; the concept of congestion degree is proposed for the remaining single traffic to be processed. This paper uses the Mininet network simulation platform and Ryu controller to perform simulation verification in four aspects of standardized throughput, link utilization, load balancing, and link bandwidth utilization. The comparative experiments show that the strategy proposed in this paper can greatly improve the network performance in the above aspects.},
  keywords={Data centers;Computer networks;Energy storage;Bandwidth;Scheduling;Optimization;Sociology;energy storage data center;software defined network;traffic scheduling;differential algorithm;congestion},
  doi={10.1109/AEECA49918.2020.9213653},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11448136,
  author={U, Vijetha and Pais, Spurthy Maria and Patil, Shruti},
  booktitle={2025 1st International Conference on Data Science and Intelligent Network Computing (ICDSINC)}, 
  title={Machine Learning for Android Malware Detection: A Closer Look at Model Performance and Generalization}, 
  year={2025},
  volume={},
  number={},
  pages={783-788},
  abstract={Machine learning algorithms have emerged as a popular choice of tool for Android malware detection. Many research efforts have been reported in literature with exceptional malware detection performance on well-known datasets. But, malware problems are still on the rise, forcing us to question the reliability of the models for malware detection. We experiment with ML models on standard datasets, as well as merged and de-biased datasets. Our analysis reveal that good performance of models on selected datasets may not necessarily mean effective malware detection, rather it may indicate that the models may be exploiting dataset specific traits and learning shortcuts to prediction. We performed feature activation analysis on various datasets to reveal biases and specific traits that may be misleading the models to make certain predictions. Our work highlights the need for a careful consideration of dataset bias and distribution traits when developing malware detection models for real-world applicability},
  keywords={Analytical models;Intelligent networks;Machine learning algorithms;Predictive models;Feature extraction;Malware;Data models;Reliability;Standards;Overfitting;Android Malware Detection (AMD);Machine Learning (ML);Feature Analysis},
  doi={10.1109/ICDSINC66221.2025.11448136},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10021710,
  author={Al Zadjali, Hilal and Al Riyami, Hisham and van Dyk, Chris and Boshoff, Sep and Al Siyabi, Musabah and Al Hasni, Mohammed},
  booktitle={2022 23rd International Middle East Power Systems Conference (MEPCON)}, 
  title={Optimization Assessment for 400 kV Shunt Reactors Sizing and Locations in Oman Power Grid}, 
  year={2022},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper discusses the assessment of installing shunt reactor in the new 400 kV North-South Interconnector Phase I which will connect the Main Interconnected System (MIS) to the Duqm area and PDO network in the Sultanate of Oman. The project is still under construction and expected to be completed by June 2023. Several study scenarios have been evaluated to clarify the necessity of introducing the high voltage shunt reactors at selected locations. The objective is to determine the best sizes and locations of the required shunt reactor to mitigate overvoltage issues. Steady-state simulation studies are performed using the professional DIgSILENT software. Frequency-dependent distributed parameters models are used to simulate overhead lines. Different operating scenarios and contingencies are considered, and the so-called “Compare and Merge Tool” is used in DIgSILENT to establish which of the cases lead to the best reactive power compensation arrangement. Resonance analysis between the shunt line reactor and line capacitance is performed to to avoid adverse effects of possible high secondary arc current and recovery voltage.},
  keywords={Shunts (electrical);Reactive power;Contingency management;Voltage;Software;Power grids;Steady-state;Interconnector;Shunt Reactor;Renewable;Spinning Reserve;NPV},
  doi={10.1109/MEPCON55441.2022.10021710},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11445483,
  author={Sung-Bin, Kim and Choi, Jeongsoo and Peng, Puyuan and Chung, Joon Son and Oh, Tae-Hyun and Harwath, David},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={VoiceCraft-Dub: Automated Video Dubbing with Neural Codec Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={14623-14632},
  abstract={We present VoiceCraft-Dub, a novel approach for automated video dubbing that synthesizes high-quality speech from text and facial cues. This task has broad applications in filmmaking, multimedia creation, and assisting voice-impaired individuals. Building on the success of Neural Codec Language Models (NCLMs) for speech synthesis, our method extends their capabilities by incorporating video features, ensuring that synthesized speech is time-synchronized and expressively aligned with facial movements while preserving natural prosody. To inject visual cues, we design adapters to align facial features with the NCLM token space and introduce audio-visual fusion layers to merge audio-visual information within the NCLM framework. Additionally, we curate CelebV-Dub, a new dataset of expressive, real-world videos specifically designed for automated video dubbing. Extensive experiments show that our model achieves high-quality, intelligible, and natural speech synthesis with accurate lip synchronization, outperforming existing methods in human perception and performing favorably in objective evaluations. We also adapt VoiceCraft-Dub for the video-to-speech task, demonstrating its versatility for various applications.},
  keywords={Feeds;Antennas;Motion pictures;Broadcasting;Filtering;Filters;Videos;Codecs;Protocols;Video equipment;automated video dubbing;neural codec language model;speech synthesis;generative model},
  doi={10.1109/ICCV51701.2025.01357},
  ISSN={2380-7504},
  month={Oct},}@ARTICLE{11479930,
  author={Zaidi, Amir and Marroquim, Ricardo and Weinmann, Michael and Eisemann, Elmar},
  journal={IEEE Transactions on Visualization and Computer Graphics}, 
  title={Local Surface Approximation Contours for Virtual Reality Stylisation}, 
  year={2026},
  volume={32},
  number={5},
  pages={4113-4122},
  abstract={Line art is an illustrative technique with a wide use in education and art. In the context of image abstraction, its potential for increasing memorisation and recognition has been demonstrated, which motivates its use in scientific illustrations. While much work has focused on the conversion of 3D models into a line-art representation, there is a lack of solutions for virtual reality. Applying existing methods for each eye independently turns out to fall short due to cost constraints, distracting artifacts due to inconsistencies, or limitations regarding the input geometry. To address these limitations, we present a contour renderer for virtual reality. It operates in screen space, making it flexible, yet it relies on a local surface approximation combined with a registration error metric for robustness. Inconsistent occluding contours are continuously merged, and lines with no correspondence between both eyes are culled. The method is easy to implement, highly efficient even for high-resolution imagery, and, according to user evaluations, avoids the noticeable artifacts produced by existing work.},
  keywords={Filtering;Filters;Circuits and systems;Pixel;Electronic mail;Digital images;Radio access networks;Regional area networks;Video equipment;Amplitude modulation;Contours;stylisation;virtual reality;stereoscopy},
  doi={10.1109/TVCG.2026.3680650},
  ISSN={1941-0506},
  month={May},}@INPROCEEDINGS{11354264,
  author={Ma, Liang and Wang, Shihao and Lv, Depin and Mi, Yuanze and Xiao, Shenyang},
  booktitle={2025 5th International Conference on Mobile Networks and Wireless Communications (ICMNWC)}, 
  title={Temporal Attention-based Multi-Class Fault Diagnosis Network for Power Communication Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={In modern times, Power Communication Networks (PCNs) become crucial for scalable monitoring, control and data exchange in modern power systems. However, existing Neighbour Selection and Merge Fault Diagnosis (NSMFD) which uses Graph Neural Network (GNN)- approach is restricted by its binary fault detection ability, lack of temporal modeling for alarm behavior. To overcome these limitations, Temporal Attention-based Multi-class Fault Diagnosis Network (TAM-FDNet) is proposed which improved GNN approach for PCN fault diagnosis. Initially, data collected from two real PCN datasets and processed through temporal alarm encoding for capturing how each device evolves through time. Next, encoded temporal features are integrated with static node attributes during graph construction to make enriched representations of node. Then, features passed to attention-based aggregation through GNN that learns relative influence of neighboring devices. Therefore, proposed TAM-FDNet framework enhances fault diagnosis accuracy, GridGraph achieved lower false alarm rates (0.214) and false negative rate (0.041) and Texas2000 also achieved better results in false alarm rates (0.011), and false negative rate $(0.052)$. Finally, proposed TAM-FDNet framework introduces dedicated temporal alarm encoder that model’s evolution of device status over time and attentiondriven neighbor selection strategy which assigns various importance to communication dependencies. These two modules form core novelty of our approach and are not present in existing GNN-based PCN diagnosis mechanisms.},
  keywords={Fault diagnosis;Wireless communication;Accuracy;Network topology;Transformers;Graph neural networks;Encoding;Real-time systems;Topology;Communication networks;attention-based aggregation;fault diagnosis;graph neural network;power communication networks;temporal alarm encoding},
  doi={10.1109/ICMNWC66779.2025.11354264},
  ISSN={},
  month={Dec},}@ARTICLE{11226939,
  author={Jardak, Nabil and Adam, Ronan and Jault, Quentin},
  journal={IEEE Access}, 
  title={Referenceless Doppler Shift and Rate Estimation for Opportunistic Positioning With OneWeb Signals}, 
  year={2025},
  volume={13},
  number={},
  pages={189482-189493},
  abstract={We propose a technique for extracting the Doppler shift and its rate from OneWeb’s Ku-band user downlink signals and demonstrate its suitability for opportunistic positioning. Since the downlink waveform and synchronization sequences are not publicly documented, the method exploits the periodicity inherent in the transmitted frames. By performing cross-correlation in the time domain between two consecutive bursts over several frame periods, we obtain an approximate estimate of the Doppler shift and a better accuracy estimate of the Doppler rate, when the signal is received using a universal LNB (low noise block) without a parabolic reflector. The two estimates are merged in a Kalman filter, resulting in an unambiguous Doppler shift that can be used in positioning calculation. Field experiments show that, for satellites above 67° elevation, the Doppler rate can be estimated with a standard deviation of 13.25 Hz s −1 (0.359 m s −2) and the Doppler shift with a standard deviation of 86.3 Hz (2.34 m s −1). Frequency tracking is feasible down to 55° elevation, and simultaneous processing of three operational OneWeb frequency channels should provide continuous measurement availability, with up to 50 % overlap between adjacent beams that further improves Doppler shift accuracy. Positioning using derived Doppler shift resulted in a horizontal error of 384 m based on approximate satellite orbits, which can be reduced using accurate satellite orbit and clock models.},
  keywords={Doppler shift;OFDM;Low earth orbit satellites;Satellites;Synchronization;Satellite constellations;Accuracy;Satellite broadcasting;Orbits;Delays;Doppler shift;Doppler rate;low earth orbit;OneWeb;positioning;signals of opportunity},
  doi={10.1109/ACCESS.2025.3628200},
  ISSN={2169-3536},
  month={},}@ARTICLE{11436035,
  author={Lee, Hyunsoo and Kim, Gyu Seon and Roh, Emily Jimin and Jung, Soyi and Park, Soohyun and Duong, Trung Q. and Kim, Joongheon},
  journal={IEEE Network}, 
  title={Quantum Jump to Connected Worlds: Paradigm Shifts in Mobility and Network Applications via Quantum Neural Networks}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={With the rapid advancement of quantum and artificial intelligence technologies, there is a growing trend to merge these two fields, a movement that is gaining momentum across both industry and academia. This emerging quantum artificial intelligence (QAI) is expected to achieve optimization and performance improvements in various mobility and network applications. The purpose of this article is to introduce quantum neural networks (QNNs) and explore applications of QAI in distributed network use cases. We begin by thoroughly investigating how QAI is being researched in the industry. Next, we discuss the fundamentals of quantum computing and QNNs. Following that, we examine QNN-based neural learning models for network and mobility applications, including quantum reinforcement learning, quantum convolutional neural networks, and quantum distributed learning. Finally, we consider the implications that QAI may have for future network and mobility applications.},
  keywords={Qubit;Training;Neural networks;Artificial intelligence;Encoding;Convergence;Logic gates;CubeSat;Computational modeling;Reinforcement learning},
  doi={10.1109/MNET.2026.3671113},
  ISSN={1558-156X},
  month={},}@ARTICLE{10607910,
  author={Zhang, Shiding and Yang, Jianye and Zhang, Wenjie and Yang, Shiyu and Zhang, Ying and Lin, Xuemin},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={BigSet: An Efficient Set Intersection Approach}, 
  year={2024},
  volume={36},
  number={12},
  pages={7677-7691},
  abstract={Set intersection is a fundamental operation in many applications, such as common neighbor computation in graph-based algorithms, set similarity computation, item recommendation, etc. In the literature, many set intersection methods are proposed. We observe that the state-of-the-art algorithm ${\sf RCode}$RCode bears several limitations, such as high index time complexity, inefficient for large-sized sets, and not friendly to the generic set intersection. In this paper, we introduce the Bucket Signature for Set (${\sf BigSet}$BigSet), an efficient generic set intersection algorithm. ${\sf BigSet}$BigSet consists of two phases, namely the preprocessing phase and the query phase. In the preprocessing phase, ${\sf BigSet}$BigSet partitions the elements of a record into $O(2^{k})$O(2k) buckets and uses a bitmap to indicate the status of the buckets where $n$n is the record length and $k$k is the number of bits in the signature. In the query phase, ${\sf BigSet}$BigSet calculates the results using a candidate generating-and-verification framework. Specifically, a set of candidate elements is identified as those falling in the same buckets. Then, for each bucket, ${\sf BigSet}$BigSet collects the common elements using a merge-based method. To improve the performance, we introduce two optimizations, including bucket sharing and size-aware signature construction techniques. We conduct experiments on 10 real graph datasets and 5 real generic set datasets to evaluate the performance of our proposals. The experiment results show that ${\sf BigSet}$BigSet is 20× faster than the leading generic set intersection algorithms. Besides it outperforms the ${\sf RCode}$RCode with 5× speedup, and while uses up to 8× less memory.},
  keywords={Electronic mail;Time complexity;Reviews;Optimization;Labeling;Cyberspace;Computer science;Bitmap signature;bitwise operation;generic set intersection;set intersection},
  doi={10.1109/TKDE.2024.3432595},
  ISSN={1558-2191},
  month={Dec},}@INPROCEEDINGS{11063971,
  author={Al-obaidi, Sumia and Lighvan, Mina Zolfy and Asadpour, Mohammad and Alnaseri, Mustafa Talal},
  booktitle={2024 10th International Engineering Conference on Advances in Computer and Civil Engineering (IEC)}, 
  title={Image Steganalysis Scheme based on Fusion of CNN and BiLSTM}, 
  year={2024},
  volume={},
  number={},
  pages={161-166},
  abstract={In the field of information security, steganography and steganalysis play crucial roles. Steganography refers to the technique of hiding secret information within other non-suspicious data, often within images, while steganalysis is the process of detecting and extracting these hidden messages. The ability to accurately identify images that conceal encrypted or hidden data has become increasingly important in today's digital landscape, particularly in areas such as cybersecurity and secure communication. This study focuses on enhancing the detection of such hidden messages by utilizing advanced deep learning techniques, specifically (CNN) and (BiLSTM) networks. This fusion approach involves merging the strengths of both CNNs and BiLSTMs, which leads to better performance compared to using either technique in isolation. The combined model's accuracy is notably higher than that of previous works, as demonstrated in comparisons on trained datasets. To train these models, the study employs Adam’s optimization algorithm, a widely used and efficient method for training deep learning models. To ensure the robustness and reliability of the proposed model, the researchers utilize K-Fold cross-validation with k=2, which allows for better dataset utilization and reduces the risk of overfitting. The proposed techniques were evaluated using three well-known datasets in the steganography and steganalysis community: HILL, BOSSbase 1.01, and providing a solid benchmark for testing the effectiveness of the model. The results indicate that the proposed methodology not only outperforms existing approaches but also provides a highly efficient solution for detecting hidden data in images, with minimal computational overhead.},
  keywords={Deep learning;Training;Steganography;Accuracy;Bidirectional long short term memory;Computer architecture;Feature extraction;Solids;Data mining;Computer security;Data Hiding;Image Security;Image Steganography;Image Steganalysis;Convolution Neural Networks;BiLSTM;Fusion;Deep learning},
  doi={10.1109/IEC61018.2024.11063971},
  ISSN={2832-8310},
  month={Oct},}@INPROCEEDINGS{11470202,
  author={Song, Jia and Zheng, Ke and Wang, Botong and Qin, Kongjian},
  booktitle={2025 2nd International Conference on Intelligent Driving and Smart Transportation (IDST)}, 
  title={Vehicle Early Lane Change Model Based on Driving Safety Field in Complex Scenarios}, 
  year={2025},
  volume={},
  number={},
  pages={167-171},
  abstract={The complex traffic environment formed by the coexistence of Connected and Automated Vehicles (CAV) and Human-driven Vehicles (HDV) has inherent issues such as unclear traffic rules and ambiguous safety mechanisms. In previous research, the authors constructed a driving safety field for connected vehicles to characterize the degree of influence of various elements (human-vehicle-road) in the vehicle driving environment on driving risk. Simultaneously, considering the bottlenecks in merging areas, such as complex traffic conditions and speed disparities, this paper, from the vantage point of proactive traffic stewardship and targeting CAVs as the control object, constructs an early lane change model for mixed vehicular throughput. Firstly, the automotive safety realm constructed based on past research is used to analyze microscopic conflicts during vehicle lane changes, and the minimum safe interval for lane maneuvering is improved using the CAV field model. Secondly, with CAV platoon strength as the early lane change goal, CAVs meeting the lane change conditions are encouraged to change lanes early to the adjacent lane during the pre-merging phase and form CAV platoons with CAVs in the adjacent lane to enhance road section traffic efficiency. Finally, the SUMO simulation software will be used to simulate and analyze the early lane change model and evaluate its effectiveness, assessing whether early lane change can become an effective means for managing merging area traffic by utilizing the control of free lane changes in the pre-merging area.},
  keywords={Feedback;Circuits;Protocols;HTTP;Communications technology;Radio access networks;Regional area networks;Autonomous vehicles;Autonomous systems;Expert systems;The Safety Field;Intelligent Connected Vehicles;Platooning;Lane Change Model},
  doi={10.1109/IDST67888.2025.11470202},
  ISSN={},
  month={Nov},}@ARTICLE{11328769,
  author={Chen, Zongnan and Liang, Yan and Li, Jingcong and Bai, Chenyu and Xie, Qiuyou and Pan, Jiahui},
  journal={IEEE Transactions on Affective Computing}, 
  title={EEG- and Micro-Expression-Based Emotion Recognition and Consciousness Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1-18},
  abstract={In the field of Disorders of Consciousness (DoC), traditional diagnostic methods often struggle with high misdiagnosis rates and lack the sensitivity needed to discern subtle emotional responses, necessitating more accurate and comprehensive assessment tools. Current emotion recognition techniques, primarily using single-modality data such as electroencephalography (EEG) or facial expressions, fail to capture the complex interplay of emotional states in patients with DoC, leading to incomplete assessments. To address these challenges, this study proposes a novel multimodal fusion framework that integrates heterogeneous EEG and micro-expression data through an innovative spatio-temporal attention mechanism. This approach significantly enhances the detection and classification of emotional states by leveraging differential entropy features from EEG and temporal features from micro-expressions, fused using deep learning techniques. The proposed method not only achieves mainstream models in terms of accuracy but also demonstrates potential for broad application in medical diagnostics, providing a basis for more personalized patient care and opening avenues for future research in clinical practice settings. We found that two patients had significantly better indicators than the others, indicating better brain activity levels and outcomes in these two patients, which is also consistent with the clinical results one month after the experiment. By effectively merging data from multiple sources, our study sets a new benchmark for emotion recognition in DoC, contributing to more accurate clinical assessments and enhancing the quality of life for affected patients.},
  keywords={Electroencephalography;Emotion recognition;Accuracy;Feature extraction;Brain;Motors;Medical diagnostic imaging;Functional magnetic resonance imaging;Deep learning;Brain modeling;Electroencephalogram (EEG);micro-expression;emotion recognition;consciousness detection;disorders of consciousness (DoC)},
  doi={10.1109/TAFFC.2025.3650482},
  ISSN={1949-3045},
  month={},}@INPROCEEDINGS{11408466,
  author={Liang, Shuang and Lu, Yuncheng and Guo, Ce and Kelly, Paul H. J. and Luk, Wayne and Fan, Hongxiang},
  booktitle={2026 IEEE International Symposium on High Performance Computer Architecture (HPCA)}, 
  title={Advancing Full-Stack Acceleration for SchröDinger-Style Quantum Simulation}, 
  year={2026},
  volume={},
  number={},
  pages={1-15},
  abstract={Recent developments in quantum hardware, including the scaling of physical qubits and advanced quantum error correction techniques, have increased the number of reliable logical qubits. However, this progress has introduced new challenges for quantum algorithm developers. Limited access to physical quantum machines and the insufficient performance of classical quantum simulators for near-term scales ($\sim 30$ logical qubits) hinder the simulation and validation of quantum algorithms. To address this urgent need for improving simulation performance, we propose a novel end-to-end full-stack solution for Schrödingerstyle simulation that jointly explores algorithm, software, and hardware optimizations. At the algorithmic level, by identifying the inefficiency in executing complex signed permutations and complex unitary permutation gates, we introduce index redirection and pre-compute merging that significantly reduce data movement and computational complexity. At the hardware level, we propose a reconfigurable dataflow architecture with adaptive memory scheduling and swapping optimizations. At the software level, an end-to-end toolchain is introduced to jointly explore both algorithmic and hardware optimizations. A comprehensive evaluation across a large suite of quantum circuits demonstrates that our work achieves a maximum speedup exceeding $50 \times$ over the GPU-based Qiskit baseline.},
  keywords={Quantum algorithm;Processor scheduling;Qubit;Software algorithms;Logic gates;Dynamic scheduling;Hardware;Software;Computational complexity;Optimization},
  doi={10.1109/HPCA68181.2026.11408466},
  ISSN={2378-203X},
  month={Jan},}@ARTICLE{10084847,
  author={Borre, Camilla C and Aguirre Børsen-Koch, Víctor and Helmi, Amina and Koppelman, Helmer H and Nielsen, Martin B and Rørsted, Jakob L and Stello, Dennis and Stokholm, Amalie and Winther, Mark L and Davies, Guy R and Hon, Marc and Kruijssen, J M Diederik and Laporte, Chervin F P and Reyes, Claudia and Yu, Jie},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Age determination of galaxy merger remnant stars using asteroseismology}, 
  year={2022},
  volume={514},
  number={2},
  pages={2527-2544},
  abstract={The Milky Way was shaped by the mergers with several galaxies in the past. We search for remnant stars that were born in these foreign galaxies and assess their ages in an effort to put upper limits on the merger times and thereby better understand the evolutionary history of our Galaxy. Using 5D-phase space information from Gaia eDR3, radial velocities from Gaia DR2 and chemical information from APOGEE DR16, we kinematically and chemically select 21 red giant stars belonging to former dwarf galaxies that merged with the Milky Way. With added asteroseismology from Kepler and K2 , we determine the ages of the 21 ex situ stars and 49 in situ stars with an average σage/age of ∼31 per cent. We find that all the ex situ stars are consistent with being older than 8 Gyr. While it is not possible to associate all the stars with a specific dwarf galaxy, we classify eight of them as Gaia-Enceladus/Sausage stars, which is one of the most massive mergers in our Galaxy's history. We determine their mean age to be 9.5 ± 1.3 Gyr consistent with a merger time of 8–10 Gyr ago. The rest of the stars are possibly associated with Kraken, Thamnos, Sequoia, or another extragalactic progenitor. The age determination of ex situ stars paves the way to more accurately pinning down when the merger events occurred and hence provide tight constraints useful for simulating how these events unfolded.},
  keywords={asteroseismology;stars: abundances;stars: kinematics and dynamics;Galaxy: evolution},
  doi={10.1093/mnras/stac1498},
  ISSN={1365-2966},
  month={Feb},}@INPROCEEDINGS{10821869,
  author={Zhang, Yutong and Zhong, Jiang and Lei, Qin},
  booktitle={2024 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={A Dual-Branch Network for Accurate Retinal Vessel Segmentation Combining Cross-Domain Features}, 
  year={2024},
  volume={},
  number={},
  pages={3987-3992},
  abstract={Accurate segmentation of retinal blood vessels is crucial for diagnosing and treating various ophthalmic conditions. Although existing deep learning methods have shown promising results, background pixel noise in images often affects segmentation outcomes to varying degrees. Currently, effectively utilizing features from different domains within an image remains an underexplored yet promising research direction. In this paper, we propose a novel dual-branch network architecture, termed LIONet, which extracts features from RGB images and Local Intensity Order Transform (LIOT) images in two separate branches, and merges them in a Cross-Domain Fusion Module (CDFM). This approach effectively combines the global color information from the RGB domain and the local intensity variation information from the LIOT domain within retinal vessel images. Additionally, we integrate a Residual Excitation Module (REM) into the down-sampling layers of each branch to enhance feature representation and reduce the impact of redundant and irrelevant information. Detailed result analysis and comparisons on three publicly available retinal vessel datasets demonstrate the effectiveness of our approach compared to state-of-the-art methods.},
  keywords={Deep learning;Image segmentation;Accuracy;Image color analysis;Noise;Transforms;Network architecture;Feature extraction;Retinal vessels;Diseases;Retinal Vessel Segmentation;Local Intensity Order;Cross-Domain Fusion},
  doi={10.1109/BIBM62325.2024.10821869},
  ISSN={2156-1133},
  month={Dec},}@INPROCEEDINGS{10605172,
  author={Song, Jiale and Chi, Cheng and Wu, Faguo and Yin, Zihang},
  booktitle={2024 IEEE 11th International Conference on Cyber Security and Cloud Computing (CSCloud)}, 
  title={Game Theory-Based Rational Secret Sharing Scheme with Quantum Resistant}, 
  year={2024},
  volume={},
  number={},
  pages={159-164},
  abstract={Traditional threshold secret sharing scheme provides a mechanism to prevent the over-concentration of secrets while allowing for flexibility through the distribution and reconstruction of sub-secrets. However, this approach often simplifies participant behavior into categories of complete honesty or continuous deceit, neglecting the nuances of rational decision-making. To address this limitation, the rational secret sharing scheme merges threshold secret sharing with game theory, where each participant is considered rational and acts solely in self-interest. Nonetheless, existing schemes encounter challenges such as the prisoner's dilemma and the inability to reconstruct secrets due to the prioritization of individual interests. To mitigate these issues, our proposed scheme integrates a reward and punishment mechanism that balances short-term gains with long-term incentives, effectively deterring malicious behavior among participants. Moreover, traditional solutions based on elliptic curves and bilinear pairs lack resilience against quantum attacks. In response, our solution incorporates lattice-based cryptography to enhance security in the face of quantum threats. Additionally, we introduce an attribute access control tree to empower secret dealers in selecting suitable participants based on attribute restrictions, ensuring a more flexible, convenient, and secure rational secret sharing plan. This comprehensive approach improves participant selection and strengthens security measures in secret sharing scenarios.},
  keywords={Resistance;Protocols;Elliptic curves;Quantum mechanics;Games;Particle measurements;Cryptography;Threshold secret sharing scheme;Rational secret sharing;Lattice-based},
  doi={10.1109/CSCloud62866.2024.00035},
  ISSN={2693-8928},
  month={June},}@ARTICLE{11299086,
  author={Yang, Wenjie and Li, Tao and Zhang, Futai and Zheng, Yun and Liu, Zhiquan},
  journal={IEEE Internet of Things Journal}, 
  title={Practical Certificateless Aggregate Signcryption With Public Verification for IoMT}, 
  year={2026},
  volume={13},
  number={3},
  pages={5266-5278},
  abstract={In the Internet of Medical Things (IoMT), ensuring the confidentiality, integrity, and authenticity of sensitive medical data poses a significant challenge. Signcryption, merging digital signature and public-key encryption into one logical step, offers a promising solution for such resource-constrained networks. Most existing signcryption schemes inherently lack public verification, which prevents third parties (such as routers) from early identifying illegal messages without decryption. In this article, we propose a practical certificateless aggregate signcryption (CLASC) scheme with public verification for the IoMT. Our design uses elliptic curves and follows the certificateless cryptosystem framework. Thus, it not only avoids time-consuming pairing operations but also addresses the issues of certificate management and key escrow. Meanwhile, individual signcryptions can be compressed into a single aggregate signcryption, optimizing computational and communication overheads. Furthermore, both the preaggregated and aggregated signcryptions support public verification, effectively enabling the early elimination of illegal messages. We further present formal security proofs for our construction and reduce its security to the hardness of the one-sided gap Diffie–Hellman (OGDH) and the elliptic curve discrete logarithm (ECDL) problems. Performance analysis reveals that, compared with prior studies, this scheme preemptively blocks illegal message spread, reduces receiving-end load, and better suits resource-constrained IoMT.},
  keywords={Security;Aggregates;Public key;Elliptic curves;Elliptic curve cryptography;Electronic mail;Monitoring;Medical diagnostic imaging;Rendering (computer graphics);Receivers;Certificateless aggregate signcryption (CLASC);elliptic curves;Internet of Medical Things (IoMT);public verification},
  doi={10.1109/JIOT.2025.3643472},
  ISSN={2327-4662},
  month={Feb},}@ARTICLE{11483344,
  author={Li, Xinyang and Yang, Songjie and Ning, Boyu and He, Zongmiao and Ling, Xiang and Yuen, Chau},
  journal={IEEE Transactions on Wireless Communications}, 
  title={Indirect and Direct Multiuser Hybrid Beamforming for Far-Field and Near-Field Communications: A Deep Learning Approach}, 
  year={2026},
  volume={25},
  number={},
  pages={15199-15215},
  abstract={Hybrid beamforming for extremely large-scale multiple-input multiple-output (XL-MIMO) systems is challenging in the near field because the channel depends jointly on angle and distance, and the multiuser interference (MUI) is strong. Existing deep learning methods typically follow either a decoupled design that optimizes analog beamforming without explicitly accounting for MUI, or an end-to-end (E2E) joint analog–digital optimization that can be unstable under nonconvex constant-modulus (CM), pronounced analog–digital coupling, and gradient pattern of sum-rate loss. To address both issues, we develop a complex-valued E2E framework based on a variant minimum mean square error (variant-MMSE) criterion, where the digital precoder is eliminated in closed form via Karush–Kuhn–Tucker (KKT) conditions so that analog learning is trained with a stable objective. The network employs a grouped complex-convolution sensing front-end for uplink (UL) measurements, a shared complex multi-layer perceptron (MLP) for per-user feature extraction, and a merged constant-modulus head to output the analog precoder. In the indirect mode, the network designs hybrid beamformers from estimated channel state information (CSI). In the direct mode where explicit CSI is unavailable, the network learns the sensing operator and the analog mapping from short pilots, after which additional pilots estimate the equivalent channel and enable a KKT closed-form digital precoder. Simulations show that the indirect mode approaches the performance of iterative variant-MMSE optimization with a complexity reduction proportional to the antenna number. In the direct mode, the proposed method improves spectral efficiency over sparse-recovery pipelines and recent deep learning baselines under the same pilot budget.},
  keywords={Antennas;Apertures;Antenna arrays;Antennas and propagation;Planar arrays;Feeds;Aperture antennas;Radio broadcasting;Frequency modulation;Circuits;Hybrid beamforming;extremely large-scale MIMO (XL-MIMO);near-field communications;multiuser interference;deep learning;deep complex neural networks},
  doi={10.1109/TWC.2026.3682746},
  ISSN={1558-2248},
  month={},}@INPROCEEDINGS{11444166,
  author={Sun, Yuan and Wang, Xuan and Wang, Cong and Zhang, WeiLi and Fan, Yanbo and Guo, Yu and Wang, Fei},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Fine-Grained 3D Gaussian Head Avatars Modeling from Static Captures Via Joint Reconstruction and Registration}, 
  year={2025},
  volume={},
  number={},
  pages={14293-14304},
  abstract={Recently, 3D head avatar modeling based on 3D Gaussians has demonstrated significant advantages in rendering quality and efficiency, given sufficient data. Some efforts have begun to train prior models on large datasets to develop generalizable 3D Gaussian head avatar modeling methods. Unfortunately, due to the limited expressive power of identity-shared 3D representations, prior-based modeling often results in degenerate rendering quality. To overcome this limitation, we propose to formulate the 3D Gaussian head avatar modeling as a joint reconstruction and registration problem. Given static input images (e.g., a short mobile phone capture), we optimize two sets of 3D Gaussians: the prior-based one possesses complete animation rigging information inferred from the prior model and pro-duces plausible modeling results, while the prior-free one is used to more freely capture the fine-grained geometric and texture details in the input images. Additionally, we simultaneously solve the registration problem between the two 3D Gaussian sets. On the one hand, the registration results will provide binding information for the prior-free reconstruction to make it animatable. On the other hand, during optimization, the prior-based Gaussian can regularize the prior-free reconstruction to resist overfitting and perform well in novel expressions. Finally, we merge the parts of the prior-based reconstruction that are occluded in the input images with the prior-free reconstruction set and then apply appropriate post-processing strategies (such as teeth enhancement) to produce a complete head avatar. We evaluated our method on the public Nersemble dataset and our own in-the-wild data. The experiments demonstrate that, under the same experimental settings, our method significantly improves modeling quality and provides better support for detailed modeling at higher resolutions.},
  keywords={Avatars;Graphical user interfaces;Videos;Mobile handsets;Communication systems;Protocols;Smart phones;Video equipment;HTTP;Instant messaging},
  doi={10.1109/ICCV51701.2025.01326},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{9757696,
  author={Ehrlich, Nea},
  booktitle={2022 IEEE Conference on Virtual Reality and 3D User Interfaces Abstracts and Workshops (VRW)}, 
  title={Virtual Veracity: Animated Documentaries and Mixed Realities}, 
  year={2022},
  volume={},
  number={},
  pages={7-14},
  abstract={Do we currently exist in animated realities? And how does virtualized culture shape new forms of animated documentaries? This paper analyzes non-photorealistic animated documentaries in the 21st century in relation to the virtualization of culture. I discuss animation as a leading virtual aesthetic, map out three kinds of virtual documentaries and explain animation's importance as documentary imagery in an era of mixed realities, i.e. the merging of the physically and digitally real. I cover animated documentaries of online game realities; the use of games as a platform to create cinematic documentaries about non-game physical realities; and the rise of VR and documentary games. These three forms of animated hybrid documentaries each use animation differently and contribute to the discourse about animation's use and status as a believable non-fiction aesthetic in today's media sphere. My main claims are that a) animation is a central visual language for virtual environments due to its dynamic nature and ability to reflect interactive user input in real-time; b) since online animated platforms function as animated realities and often converge with physical reality, today's mixed realities require animation as a documentary aesthetic that exceeds the capacity of photography as more traditional documentary imagery.},
  keywords={Photography;Visualization;Solid modeling;Three-dimensional displays;Conferences;Mixed reality;Games;Animation;Documentary;Virtual;Mixed realities;Games;Digital;Simulation;VR;Metaverse},
  doi={10.1109/VRW55335.2022.00009},
  ISSN={},
  month={March},}@ARTICLE{11184395,
  author={Wu, Qinhao and Lin, Hong and Ma, Xiaoshan and Cai, Chenxiao},
  journal={IEEE Transactions on Industrial Informatics}, 
  title={State Estimation for Smart Grid Under Hybrid Cyberattacks: Analysis of Attack Stealthiness and Estimator Stability}, 
  year={2026},
  volume={22},
  number={1},
  pages={328-335},
  abstract={This article investigates state estimation in a smart grid subject to hybrid denial-of-service (DoS) and false data injection (FDI) attacks. The contributions are threefold. Estimator design: An approximate optimal state estimator (AOSE) is designed by merging the exponentially growing Gaussian-mixture into a single Gaussian density. The resulting AOSE balances estimation accuracy and online computational burden, making it implementable for real-world applications. Stealthiness analysis of attacks: Unobservable hybrid DoS and FDI attacks can be exactly detected in some cases. It is proved that the unobservable hybrid attacks are stealthy for a stable smart grid. Stability of AOSE: It is proved that, despite accumulated approximation errors, the AOSE for a smart grid under the stealthy hybrid attacks is stable with a mild initial condition. Finally, some simulations on a three-generator six-bus system validate the performance and stability of the AOSE.},
  keywords={Smart grids;State estimation;Power system stability;Vectors;Computer crime;Stability criteria;Monitoring;Mathematical models;Covariance matrices;Real-time systems;Hybrid cyberattack;smart grid;stability;state estimation;stealthiness analysis},
  doi={10.1109/TII.2025.3609212},
  ISSN={1941-0050},
  month={Jan},}@INPROCEEDINGS{11334251,
  author={Wu, Zehao and Zhao, Yanjie and Wang, Haoyu},
  booktitle={2025 40th IEEE/ACM International Conference on Automated Software Engineering (ASE)}, 
  title={TensorGuard: Gradient-Based Model Fingerprinting for LLM Similarity Detection and Family Classification}, 
  year={2025},
  volume={},
  number={},
  pages={445-456},
  abstract={As Large Language Models (LLMs) become integral software components in modern applications, unauthorized model derivations through fine-tuning, merging, and redistribution have emerged as critical software engineering challenges. Unlike traditional software where clone detection and license compliance are well-established, the LLM ecosystem lacks effective mechanisms to detect model lineage and enforce licensing agreements. This gap is particularly problematic when open-source model creators, such as Meta’s LLaMA, require derivative works to maintain naming conventions for attribution, yet no technical means exist to verify compliance.To fill this gap, treating LLMs as software artifacts requiring provenance tracking, we present TensorGuard, a gradient-based fingerprinting framework for LLM similarity detection and family classification. Our approach extracts model-intrinsic behavioral signatures by analyzing gradient responses to random input perturbations across tensor layers, operating independently of training data, watermarks, or specific model formats. TensorGuard supports the widely-adopted safetensors format and constructs high-dimensional fingerprints through statistical analysis of gradient features. These fingerprints enable two complementary capabilities: direct pairwise similarity assessment between arbitrary models through distance computation, and systematic family classification of unknown models via the K-Means clustering algorithm with domain-informed centroid initialization using known base models. Experimental evaluation on 58 models comprising 8 base models and 50 derivatives across five model families (Llama, Qwen, Gemma, Phi, Mistral) demonstrates 94% classification accuracy under our centroid-initialized K-Means clustering. Our work establishes a new paradigm for model similarity detection, bridging traditional software engineering practices with modern LLM distribution and compliance challenges.},
  keywords={Computational modeling;Ecosystems;Training data;Watermarking;Fingerprint recognition;Licenses;Software;Data models;Data mining;Software engineering;large language models;model fingerprinting;model similarity detection;model family classification},
  doi={10.1109/ASE63991.2025.00044},
  ISSN={2643-1572},
  month={Nov},}@INPROCEEDINGS{11473992,
  author={Aqqad, Kamilia and Aqqad, Karmel and Khdeir, Naeema and Zabade, Raha and Ghanem, Wasel and Lwas, Ali Kadhim and Al-Rimawi, Ashraf and Habaebi, Mohamed Hadi and Zyoud, Alhareth Mohammed},
  booktitle={2025 10th International Conference on Computer and Communication Engineering (ICCCE)}, 
  title={A Deep Learning Lora-Based Indoor Localization Technique}, 
  year={2025},
  volume={},
  number={},
  pages={151-156},
  abstract={Indoor localization is crucial for many applications where Global Positioning System (GPS) signals are frequently poor or unreliable, such as asset tracking and interior navigation. This study uses deep learning algorithms and the benefits of long-range wireless communication offered by Long Range (LoRa) to produce an accurate indoor locating system. The initial step towards constructing a wireless communication network is positioning LoRa-based devices at specified locations. A dataset is produced by merging the signal strength measurements acquired from each of these LoRa devices. Each location in the data set is within an environment, and measurements of the signal strength from LoRa devices related to those locations are included. The collected dataset is used to train the deep learning model. To increase accuracy, techniques like data augmentation and cross-validation were included. The experiment's results demonstrate the effectiveness of the deep learning-based LoRa indoor localization technique. Among the many possible applications for the suggested method are location-based services, asset monitoring, and precise indoor positioning.},
  keywords={Antennas;Microcontrollers;Microprocessors;Communication systems;Internet of Things;LoRa;Location awareness;Received signal strength indicator;Receivers;Transmitters;Indoor Localization;Deep learning;LoRa;GPS;Internet of Things},
  doi={10.1109/ICCCE66530.2025.11473992},
  ISSN={2836-1911},
  month={Aug},}@INPROCEEDINGS{11387686,
  author={Sahu, Shashwata and Sethi, Ramesh Chandra and Pattnayak, Parthasarathi and Mohanty, Arpeeta and Das, Tulip},
  booktitle={2025 IEEE 2nd International Conference on Green Industrial Electronics and Sustainable Technologies (GIEST)}, 
  title={Legal and Ethical Dimensions of Healthcare 4.0: Emerging Applications, Challenges and Future Development of Healthcare Metaverse}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Healthcare 4.0, an entirely new healthcare era, combines medical education, diagnosis, and therapy through computers and the metaverse, the Internet. Besides bettering medical education experience with realistic simulation, and speeding up research with collaborative virtual laboratories, the Healthcare Metaverse enables remote consultation, interactive rehabilitation, and VR/AR psychotherapy. Blockchain protects personal privacy at the root by achieving secure data transmission. However, challenges such as interoperability, data privacy, and ethical concerns persist, and vigilant legal frameworks and systems must be anticipated and maintained. This is especially true concerning liability for AI-based diagnosis and the protection of virtual patients’ privacy, areas in which the legal community is trailing even more. Soon, merging AI, IoT, and haptic feedback will ensure early diagnosis and personalised treatments. The need for global regulations, increased data protection, and ethical standards to strike a balance between patient safety and innovation is emphasised in this article. The task will be an interdisciplinary cooperation to realise the potential of Healthcare 4.0 in surgery, diagnosis, and rehabilitation. This will guarantee its safe and fair utilisation in a clinical setting. This review highlights ethical challenges and defects in the law in exascale computing and the metaverse in health care and provides models and legislative solutions for proper AI applications.},
  keywords={Training;Ethics;Metaverse;Law;Surgery;Data protection;Medical services;Blockchains;Artificial intelligence;Medical diagnostic imaging;Healthcare 4.0;Metaverse;Virtual reality;Medicine;Artificial intelligence;Blockchain},
  doi={10.1109/GIEST66547.2025.11387686},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11199103,
  author={Rajiv, Asha and S, Safinaz and Antran Vijay, S. Arul and Madan, Praney and Sahu, Geet and Gupta, Mohit},
  booktitle={2025 World Skills Conference on Universal Data Analytics and Sciences (WorldSUAS)}, 
  title={Enhanced Privacy-Preserving and Trust Model for Secure Access Control and Data Transmission in Edge Computing}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Edge computing serves as a fundamental solution to handle the mounting requirements for immediate IoT data processing. Security together with privacy issues stands as a major hurdle at present. The proposed research develops a Multi-Layer Privacy-Preserving Model which merges TPM technology with CP-ABE to boost security measures as well as gain control of access for edge computing capabilities. The proposed model enhances operational effectiveness through a 83% performance increase during load measurement together with improved execution time and enhanced security performance. The use of CP-ABE surpasses FH-CP-ABE and LLWG19 with 41 computational overhead points fewer than its competitors and shorter encryption processing time at 5.9 seconds. The system provides secure keyword search and preserves data integrity together with fine-grained access control features that also optimize bandwidth usage and storage expenses. Studies using NS-2.34 showed that the system delivered 81% faster encryption along with 80% better intrusion protection capabilities. The model delivers enhanced IoT security through edge computing protection because it implements a multi-level decentralized encryption system.},
  keywords={Access control;Privacy;Computational modeling;Keyword search;Encryption;Timing;Security;Protection;Edge computing;Load modeling;Edge Computing;IoT Security;CP-ABE;TPMs;Data Encryption;Secure Keyword Search;Multi-Layer Security and Decentralized Security},
  doi={10.1109/WorldSUAS66815.2025.11199103},
  ISSN={},
  month={Aug},}@ARTICLE{9204962,
