  month={Jan},}@INPROCEEDINGS{11522485,
  author={Vijayalakshmi, V. and Sivaganesan, D.},
  booktitle={2026 4th International Conference on Artificial Intelligence and Machine Learning Applications Theme: Healthcare and Internet of Things (AIMLA)}, 
  title={An Efficient Predictive Scoring-Based Method for DFA Construction from Input Strings}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Deterministic Finite Automata (DFA) are widely used in applications such as pattern recognition, compiler design, lexical analysis, and text processing. However, classical DFA construction methods often suffer from state explosion and sensitivity to noisy input sequences. This paper proposes PSM-DFA, a predictive scoring-guided state merging approach for efficient DFA construction from labeled input strings. The proposed framework first constructs a Prefix Tree Acceptor (PTA) from input sequences and then applies a structured predictive scoring mechanism to guide state merging decisions. The scoring model evaluates candidate merges using transition similarity, prefix-suffix structural patterns, and conflict penalties to prevent incorrect merges while controlling state growth. Experimental evaluation on binary string datasets, palindromic patterns, and protocol-like sequences demonstrates that PSM-DFA produces more compact DFAs compared to classical state merging approaches while maintaining high classification accuracy. Furthermore, under simulated noisy input conditions, the proposed method maintains robust performance with accuracy above 85%. The results indicate that predictive scoring-guided merging provides an interpretable and efficient strategy for practical DFA construction tasks in pattern recognition and language processing applications.},
  keywords={Doped fiber amplifiers;Merging;Construction;Printing;Automata;Machine learning;Sequential analysis;Sequences;Learning (artificial intelligence);Noise measurement;Deterministic finite automata;DFA construction;Predictive scoring;State merging;Noise robustness;Automata learning},
  doi={10.1109/AIMLA67915.2026.11522485},
  ISSN={},
  month={April},}@INPROCEEDINGS{10426967,
  author={Roshinta, Trisna Ari and Widagdo, Tricya Esterina and Azizah, Fazat Nur},
  booktitle={2023 8th International Conference on Information Technology and Digital Applications (ICITDA)}, 
  title={Hypernym and Hyponym Improve the Conformed Dimension Identification of Fusion Cube in Self-Service Business Intelligence}, 
  year={2023},
  volume={},
  number={},
  pages={1-8},
  abstract={In the present day, the business and social landscape is characterized by intricate complexities, intense competition, and constant changes. Consequently, the need for making timely decisions based on dependable, precise, and promising data has become paramount. Fusion cube is a solution for analyzing top-level management needs without the intervention of data analysts and programmers. The current problems in the fusion cube are the small accuracy and not many studies that explain the steps in doing the fusion cube at each stage. In this paper, we will explain how the fusion cube is carried out and how hypernym and hyponym influence the accuracy of the fusion cube. The conformed dimension search approach with hypernyms and hyponyms can improve accuracy in forming a new cube, because the search area in matching semantic similarity is wider in hypernyms and hyponyms. The precision value using synonyms, hypernyms and hyponyms for 15 cubes is 92%.},
  keywords={Semantics;Merging;Buildings;Complexity theory;Business intelligence;Information technology;Self-service;fusion cubes;data cube;conformed dimension;semantic similarity},
  doi={10.1109/ICITDA60835.2023.10426967},
