  title={Semantic labeling of soccer video}, 
  year={2003},
  volume={3},
  number={},
  pages={1787-1791 vol.3},
  abstract={As traditional shot segmentation may not produce video segments that possess one-to-one correspondence to semantic views, we present an integrated segmentation and classification approach to label soccer video into semantic units in this paper. In our system, each P frame is divided to a 6 /spl times/ 4 blocks with color and motion features extracted on both block and frame levels. First, a threshold is used to divide the video stream into relatively static parts and active parts. Then every active part is segmented into sub-parts according to 4 view types and the motion features are used to classify segments with support vector machines. Finally, static parts are merged with classified active sub-parts to form labeled segments. Four 10-minute test clips from the World Cup 2002 are used to evaluate our system resulting in a promising classification rate of 79.8%.},
  keywords={Labeling;Streaming media;Event detection;Image segmentation;Feature extraction;Support vector machines;Support vector machine classification;Sun;System testing;Bridges},
  doi={10.1109/ICICS.2003.1292774},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{4662873,
  author={Lu, Huimin and Feng, Boqin and Zhao, Yingliang and Zheng, Qinghua and Liu, Jun},
  booktitle={2008 Seventh International Conference on Grid and Cooperative Computing}, 
  title={A New Model for Distributed Knowledge Organization Management}, 
  year={2008},
  volume={},
  number={},
  pages={261-265},
  abstract={The conventional model for knowledge organization management is based on resource; index and metadata catalog. It is difficult to express the concept of knowledge resource, the information contained in knowledge elements and the inner relevance of information. In an attempt to solve this problem, a new model for distributed knowledge organization management is proposed based on extended topic maps. The association of subject-knowledge element-occurrence and the relevance between the subjects and between the knowledge elements are established. The expression of multi-level, multi-granularity and inner relevant characteristics of knowledge is improved. The knowledge logic organization framework based on extended topic maps is presented. Additionally, a new similarity measure algorithm based on comprehensive information theory for topic maps is proposed. The methods of topic maps merging and dynamic updating are also introduced.},
  keywords={Knowledge management;Resource management;Merging;Conference management;Engineering management;Logic;Information theory;Search engines;Software libraries;Distributed computing;knowledge organization management;topic map;extended topic map},
  doi={10.1109/GCC.2008.79},
  ISSN={2160-4916},
  month={Oct},}@INPROCEEDINGS{5592075,
  author={Šimko, Jakub and Tvarožek, Michal and Bieliková, Mária},
  booktitle={2010 Workshops on Database and Expert Systems Applications}, 
  title={Semantic History Map: Graphs Aiding Web Revisitation Support}, 
  year={2010},
  volume={},
  number={},
  pages={206-210},
  abstract={We present a novel approach intended to reduce user effort required to retrieve and/or revisit previously discovered information by exploiting web search and navigation history. In our approach, we collect streams of user actions during search and navigation sessions, identify individual user goals and construct and persistently store visual trees representing session history. We provide users with a History Map - a scrutable graph of semantic terms and web resources with full-text search capability over individual history entries, constructed by merging individual session history trees and the associated web resources. The Map semantically organizes a user's browsing history (with the help of the Delicious folksonomy) and enables him to quickly recall information distributed over several documents and/or sessions. We present experimental results of session identification and also evaluate our prototype over generic web pages and as well in conjunction with our personalized faceted semantic browser Factic with promising initial results.},
  keywords={History;Semantics;Browsers;Web search;Navigation;Context;USA Councils;history;exploratory;search;graphs},
