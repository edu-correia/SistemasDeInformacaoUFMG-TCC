  booktitle={Conference Record of the Thirty-first IEEE Photovoltaic Specialists Conference, 2005.}, 
  title={Lattice mismatched dual junction tandem cells}, 
  year={2005},
  volume={},
  number={},
  pages={728-730},
  abstract={High performance solar cells with capabilities covering a broad range of mission parameters are of great interest to the space photovoltaic community. Current areas of interest include improving efficiency of multi-junction cells by adjusting bandgaps to more optimum values, adding junctions to existing structures and investigating the effects of various substrate materials. The goal is to merge the highest efficiency multijunction solar cell with a low cost, lightweight substrate. This paper focuses on developing a multijunction solar cell with optimum bandgaps by relaxing the constraint for lattice matching between the substrate and the epitaxial cell structure. A III-V lattice mismatched dual junction solar cell composed of a 1.6 eV InGaP top cell and a 1.1 eV InGaAs bottom cell has been grown with an Air Mass Zero (AM0) efficiency of 16.4% without an antireflective coating (ARC). An AM0 efficiency of 23% is anticipated when a dual layer antireflective coating is applied. Both sub-cells are lattice matched to each other but mismatched to the GaAs substrate. Accommodation of the lattice strain was accomplished via an InGaAs buffer structure. Extension of the lattice mismatched approach to three junction devices holds the promise to demonstrate AM0 efficiencies in excess of 30%.},
  keywords={Lattices;Photovoltaic cells;Substrates;Photonic band gap;III-V semiconductor materials;Indium gallium arsenide;Coatings;Space missions;Photovoltaic systems;Solar power generation},
  doi={10.1109/PVSC.2005.1488235},
  ISSN={0160-8371},
  month={Jan},}@INPROCEEDINGS{1329531,
  author={Meng Zhao and Xinjie Wei and Yici Cai and Xianlong Hong},
  booktitle={2004 IEEE International Symposium on Circuits and Systems (ISCAS)}, 
  title={Quick and effective buffered legitimate skew clock routing}, 
  year={2004},
  volume={5},
  number={},
  pages={V-V},
  abstract={We propose a new quick and effective buffered legitimate skew clock routing algorithm BLST. We analyze the optimal buffer position in the clock path, and conclude the sufficient and heuristic condition for buffer insertion in clock net. During the routing process, this algorithm integrates topology generation, buffer insertion, and node merge together, and performs them parallel. Compared with the method of X. Zheng et al. (1999) of buffer insertion after skew clock routing, BLST improves the maximal clock delay by at least 22%. Compared with legitimate skew clock routing algorithm of M. Zhao et al. (2003) with no buffer, this algorithm further decreases the total wire length and gets from 42% to 82% reduction on the maximal clock delay. The experimental results show our algorithm is quick and effective.},
  keywords={Clocks;Routing;Delay;Wire;Topology;Very large scale integration;Scheduling;Algorithm design and analysis;Capacitance;Computer science},
  doi={10.1109/ISCAS.2004.1329531},
  ISSN={},
  month={May},}@INPROCEEDINGS{7603890,
  author={Pérez Cisneros, Marco A. and García Arreola, Alicia and Morán, L. J. Miguel},
  booktitle={2016 IEEE 11th Conference on Industrial Electronics and Applications (ICIEA)}, 
  title={Forecast of pollutants in the rio santiago, using data fusion technique using statistical and regression methods}, 
  year={2016},
  volume={},
  number={},
  pages={1858-1862},
  abstract={Data fusion aims at combining the results of sample shots in order to get a forecast on the concentration of pollutants in water, based on the presence of another. This paper presents the relationship between pollutants in the Santiago River by merging of data using statistical analysis methods.},
  keywords={Sodium;Data integration;Correlation;Water pollution;Linear regression;Solids;Correlation coefficient;Forecast;Pollutants;Rio Santiago;Data FusionLineal Regression;Statistical methods},
  doi={10.1109/ICIEA.2016.7603890},
