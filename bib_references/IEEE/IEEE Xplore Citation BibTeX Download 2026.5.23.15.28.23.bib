  month={Dec},}@INPROCEEDINGS{6566494,
  author={Xin, Zhou and Wei, Zhou},
  booktitle={2013 IEEE 8th Conference on Industrial Electronics and Applications (ICIEA)}, 
  title={Fast inter prediction block mode decision approach for H.264/AVC based on all-zero blocks detection}, 
  year={2013},
  volume={},
  number={},
  pages={896-899},
  abstract={H.264/AVC video coding standard employs multiple coding-modes and significantly improves coding efficiency. As a result, the complexity and computation load of video coding increase drastically, which make it very difficult for real-time applications. To reduce the computation burden, a fast inter prediction block mode decision approach for H.264/AVC based on all-zero blocks detection is proposed. Many coding modes can be skipped through checking the best matching block of the current block by using adaptive threshold before transform and quantization in the mode decision process. Experimental results show that the coding speeds up greatly with the proposed algorithm without considerable performance degradation and bit-rate increase compared with full-mode decision algorithm and reference [2] algorithm.},
  keywords={Video coding;Encoding;Prediction algorithms;Quantization (signal);Software algorithms;Transforms;Algorithm design and analysis;H.264/AVC;Inter prediction;Motion estimation;Fast mode decision;All-zero blocks detection},
  doi={10.1109/ICIEA.2013.6566494},
  ISSN={2158-2297},
  month={June},}@INPROCEEDINGS{7814035,
  author={Kassis, Majeed and El-Sana, Jihad},
  booktitle={2016 15th International Conference on Frontiers in Handwriting Recognition (ICFHR)}, 
  title={Word Spotting Using Radial Descriptor Graph}, 
  year={2016},
  volume={},
  number={},
  pages={31-35},
  abstract={In this paper we present, the Radial Descriptor Graph, a novel approach to compare pictorial representation of handwritten text, which is based on the radial descriptor. To build a radial descriptor graph, we compute the radial descriptor and generate feature points. These points are the nodes of the graph, and each adjacent points are connected to its adjacent node to form a planar graph. Then we iteratively reduce the edges of the graph, by merging adjacent nodes, to form a multilevel hierarchical representation of the graph. To compare two pictorial representations, we measure the distance between their correspondence planar graphs, after calculating the dominant signal for each node. The graph matching is based on optimizing the function that takes into account the distance between the feature points and the structure of the graphs. The distance between two radial descriptors is computed by measuring the difference between their corresponding dominant signals. We have tested our approach on three different datasets and obtained encouraging results.},
  keywords={Feature extraction;Merging;Image segmentation;Measurement;Training;Computer science;Learning systems;local feature;radial descriptor;graph;learning-free},
  doi={10.1109/ICFHR.2016.0019},
