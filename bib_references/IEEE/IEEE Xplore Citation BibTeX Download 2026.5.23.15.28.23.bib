  title={The Study of Structure Analysis Strategy in Handwritten Recognition of General Mathematical Expression}, 
  year={2009},
  volume={2},
  number={},
  pages={101-107},
  abstract={Mathematical expression recognition is an important problem about pattern recognition, because mathematical expression is an essential part of scientific literature. About the recognition of on-line handwritten mathematical expressions, this article elaborates the structural analysis strategy from the perspective of the general mathematical expression, we bring forward a feasible solution to the overall structural analysis by using some pretreatment methods, such as dominating relationships, hard-regulations, function merging, and so on. The results show that this method can overcome some shortcomings of traditional structure analysis methods, and also it can dispose some recognition errors that often appear in the space structure and logical structure of the on-line handwriting recognition system effectively, such as symbol overlapping and handshaking, complex layer structure, the table structure and so on.},
  keywords={Handwriting recognition;Pattern recognition;Character recognition;Information technology;Application software;Information analysis;Pattern analysis;Computer science;Merging;Image recognition;general mathematical expression;handwriting recognition;pretreatment methods;analysis of the structure;solutions},
  doi={10.1109/IFITA.2009.169},
