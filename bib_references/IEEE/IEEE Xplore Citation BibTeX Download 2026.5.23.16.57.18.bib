  author={Dixit, Abhishek and Mani, Ashish and Gorbachev, Sergey},
  booktitle={2024 IEEE International Conference on Intelligent Signal Processing and Effective Communication Technologies (INSPECT)}, 
  title={Hybrid Framework for Medical Image Classification: Integrating Quantum DE and Deep Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper 1 presents an innovative hybrid framework for medical image classification, combining Quantum Differential Evolution (QDE) with deep learning techniques. Initially, wavelet and Gaussian filters are applied in the preprocessing stage to enhance image features. Otsu thresholding is then used for image segmentation to identify regions of interest. The main novelty of this approach is the integration of the Quantum Differential Evolution algorithm, an optimization technique inspired by quantum computing principles. This framework utilizes QDE's global exploration abilities to optimize key features from segmented medical images. These optimized features are subsequently input into a Convolutional Neural Network-Long Short-Term Memory (CNN-LSTM) architecture for accurate classification. The core innovation of this approach lies in employing Quantum Differential Evolution for an efficient and adaptive optimization process, enhancing feature extraction. Experimental results highlight the effectiveness of this Quantum Differential Evolution-based framework, demonstrating improved classification accuracy and robustness. This model represents a significant advancement in medical image classification, illustrating the benefits of merging quantum-inspired optimization with deep learning. This unique hybrid methodology contributes to the progress of medical image analysis and classification systems.},
  keywords={Deep learning;Image segmentation;Technological innovation;Thresholding (Imaging);Quantum computing;Feature extraction;Convolutional neural networks;Medical diagnostic imaging;Optimization;Image classification;Quantum Differential evolution algorithm;Deep learning;Image classification},
  doi={10.1109/INSPECT63485.2024.10896054},
  ISSN={},
  month={Dec},}@ARTICLE{10620654,
  author={Shah, Sayed Kifayat and Yuan, Jingbo and Wang, Wenchao and Yuan, Jiandong},
  journal={IEEE Transactions on Engineering Management}, 
  title={Adoption of Bionic Soft Robots in Organizations: The Role of Information Disclosure and Government Support}, 
  year={2024},
  volume={71},
  number={},
  pages={14145-14154},
  abstract={Bionic soft robots (BSRs) present notable benefits in their versatility, adaptability, and seamless integration across various sectors and societal contexts. However, the widespread adoption of these robots is impeded by regulatory obstacles, sustainability concerns, a shortage of exhaustive research, and inadequate support systems. To address this gap, in this article, an extended unified theory of acceptance and use of technology framework is applied to analyze quantitative data from 320 organizational users applying the partial least square structural equation modeling (PLS-SEM) approach. The research discovers that government support (GS), effort expectancy, facilitating conditions (FCs), and information discourse (ID) have a substantial impact on BSR adoption. These outcomes also reveal that GS favorably regulated the FC and behavior relationships, while ID negatively correlated with social influence and intention relationships. These findings provide researchers and policymakers with theoretical and practical insights for establishing methods to optimize, integrate, and assess the merging of technology and organizational policies.},
  keywords={Government;Stakeholders;Soft robotics;Companies;Sustainable development;Biomimetics;Technology acceptance model;Bionic soft robots (BSRs);government support (GS);information discourse (ID);unified theory of acceptance and use of technology (UTAUT) model},
  doi={10.1109/TEM.2024.3436819},
  ISSN={1558-0040},
  month={},}@ARTICLE{9465364,
  author={Liu, Qian and Wu, Zebin and Du, Qian and Xu, Yang and Wei, Zhihui},
  journal={IEEE Transactions on Geoscience and Remote Sensing}, 
  title={Multiscale Alternately Updated Clique Network for Hyperspectral Image Classification}, 
  year={2022},
  volume={60},
  number={},
  pages={1-15},
  abstract={Recently, deep learning has drawn significant attention in hyperspectral image (HSI) classification. With the growth of network depth and feature integration, deep learning demands abundant labeled samples to optimize many parameters. Unfortunately, most hyperspectral data are unlabeled and the available labeled samples are extremely limited. How to obtain richer features under limited training samples is a challenge for HSI classification. To tackle this issue, a new supervised multiscale alternately updated clique network (MSCN) is proposed for HSI classification to fully employ HSI features in different scales. Based on the Clique Block, we design the multiscale alternately updated clique block (MSCB) that applies convolution kernels of various sizes to adaptively exploit the multiscale HSI information and merge them within the block. Meanwhile, the recurrent feedback architecture is introduced to reuse high-level visual information and network parameters. The proposed MSCN includes two MSCBs to capture the multiscale spectral and spatial information in turn. The MSCN improves the information flow and the efficiency of parameter tuning through the feedback mechanism and the cross-utilization of multiscale feature. It not only obtains more abstract HSI information, but also reduces the network depth and the number of parameters, thereby improving the classification accuracy under limited samples. To certify the validity of the proposed MSCN, experiments are conducted on three real HSI datasets and compared with multiple state-of-the-art deep learning-based approaches. The experimental results demonstrate that the presented multiscale network achieves superior performance, especially in the case of a small number of training samples.},
  keywords={Feature extraction;Training;Deep learning;Hyperspectral imaging;Convolution;Data mining;Computational modeling;CliqueNet;deep learning;hyperspectral image (HSI) classification;multiscale},
  doi={10.1109/TGRS.2021.3090413},
  ISSN={1558-0644},
  month={},}@ARTICLE{10981960,
  author={Xie, Shiwei and Xie, Longtao and Wu, Qiuwei and Shu, Shengwen and Chen, Yuanyi and Yang, Qiang and Shao, Zhenguo},
  journal={IEEE Transactions on Power Systems}, 
  title={Charging Pricing in Power-Traffic Systems With Price-Elastic Demand: A Quasi-Variational Inequality Approach}, 
  year={2025},
  volume={40},
  number={6},
  pages={5013-5026},
  abstract={The rise of electric vehicles (EVs) fosters closer integration between the power and transportation sectors. While implementing a fair EV charging pricing strategy optimizes the system economic performance, modeling EV users’ behaviors and their elastic demand in response to charging prices remains a significant challenge. This paper proposes a novel pricing scheme for EV charging within power-transportation systems using a tri-level framework that considers the interactions among the power distribution network (PDN), charging network operator (CNO), and EVs. To capture the responsive behaviors of EVs, a user equilibrium (UE) model with price-elastic demand is formulated as a quasi-variational inequality (QVI). This approach reduces the tri-level pricing problem to a bi-level optimization problem by merging the middle and lower levels into an optimization problem with QVI constraints, thereby achieving mathematical tractability. The outer level optimizes energy dispatch in the PDN, while the inner level focuses on the CNO's pricing optimization in response to elastic EV demand. To solve the problem, a projection gradient algorithm and a tailored fixed-point algorithm are developed. Simulation results confirm the effectiveness and superiority of the proposed model and algorithms. Sensitivity analysis further shows that elasticity and regulation significantly affect system efficiency, demonstrating the model's robustness.},
  keywords={Pricing;Regulation;Game theory;Costs;Electric vehicle charging;Optimization;Elasticity;Upper bound;Reactive power;Load shedding;Electric vehicles;Price-elastic demand;EV user behavior;market regulation;quasi-variational inequality;projection gradient algorithm},
  doi={10.1109/TPWRS.2025.3566413},
