@ARTICLE{8765708,
  author={Liu, Jichao and Wang, Chuanxu and Gong, Yuting and Xue, Hao},
  journal={IEEE Access}, 
  title={Deep Fully Connected Model for Collective Activity Recognition}, 
  year={2019},
  volume={7},
  number={},
  pages={104308-104314},
  abstract={Group activity recognition is a challenging task because there is an exponentially large number of semantic and geometrical relationships among individuals. This makes it difficult to model these interactions and merge them as a whole for group activity classification. In this paper, we propose a deep fully-connected model for group recognition, first we use the spatial-temporal model based on convolution neural network (CNN) and long short-term memory networks (LSTM) network to capture the dynamic features of each person. Then, we use the fully-connected conditional random field (FCCRF) to learn the interactions between people. Finally, with FCCRF potential functions we re-fine the activity recognition predicted by the spatial-temporal model. The experimental results on collective activity data-set and collective activity extended data-set show that our model improves recognition accuracy over baseline methods and gets competitive results in comparison to the state-of-the-art models.},
  keywords={Activity recognition;Deep learning;Predictive models;Graphical models;Neural networks;Analytical models;Logic gates;Group behavior recognition;fully-connected conditional random field;interaction modeling;potential function},
  doi={10.1109/ACCESS.2019.2929684},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{8923042,
  author={Abdel-Nabi, Heba and Al-Naymat, Ghazi and Awajan, Arafat},
  booktitle={2019 2nd International Conference on new Trends in Computing Sciences (ICTCS)}, 
  title={Content Based Image Retrieval Approach using Deep Learning}, 
  year={2019},
  volume={},
  number={},
  pages={1-8},
  abstract={In a world that seeks perfect results of any search query, an information retrieval system that produces an accurate and relevant output is desired. However, because of the famous semantic gab problem of image representation, a Content Based Image Retrieval (CBIR) system faces some difficulties, since it highly depends on the extracted image features as basis for a similarity check between the query image and database images. This purposed approach overcomes these difficulties with the aid of the most fast growing technology, namely Deep Learning. In addition, it explores the effects of merging the features extracted from the latter layers of the deep network to achieve better retrieval results. The experimental results demonstrate the effectiveness of the proposed scheme in terms of the number of relevant retrieved images of the query results, and the mean average precision, while keeping low computational complexity since it uses an already trained deep convolutional model called AlexNet. Thus in turn, a reduction in the complexity that combines training a deep model from the scratch has been achieved.},
  keywords={Feature extraction;Image retrieval;Machine learning;Convolutional neural networks;Semantics;Training;Image Retrieval;Content Based;Deep Learning;AlexNet},
  doi={10.1109/ICTCS.2019.8923042},
  ISSN={},
  month={Oct},}@ARTICLE{9406585,
  author={Lapierre-Landry, Maryse and Liu, Zexuan and Ling, Shan and Bayat, Mahdi and Wilson, David L. and Jenkins, Michael W.},
  journal={IEEE Access}, 
  title={Nuclei Detection for 3D Microscopy With a Fully Convolutional Regression Network}, 
  year={2021},
  volume={9},
  number={},
  pages={60396-60408},
  abstract={Advances in three-dimensional microscopy and tissue clearing are enabling whole-organ imaging with single-cell resolution. Fast and reliable image processing tools are needed to analyze the resulting image volumes, including automated cell detection, cell counting and cell analytics. Deep learning approaches have shown promising results in two- and three-dimensional nuclei detection tasks, however detecting overlapping or non-spherical nuclei of different sizes and shapes in the presence of a blurring point spread function remains challenging and often leads to incorrect nuclei merging and splitting. Here we present a new regression-based fully convolutional network that located a thousand nuclei centroids with high accuracy in under a minute when combined with V-net, a popular three-dimensional semantic-segmentation architecture. High nuclei detection F1-scores of 95.3% and 92.5% were obtained in two different whole quail embryonic hearts, a tissue type difficult to segment because of its high cell density, and heterogeneous and elliptical nuclei. Similar high scores were obtained in the mouse brain stem, demonstrating that this approach is highly transferable to nuclei of different shapes and intensities. Finally, spatial statistics were performed on the resulting centroids. The spatial distribution of nuclei obtained by our approach most resembles the spatial distribution of manually identified nuclei, indicating that this approach could serve in future spatial analyses of cell organization.},
  keywords={Computer architecture;Microprocessors;Three-dimensional displays;Image segmentation;Shape;Microscopy;Organizations;3D microscopy;cell detection;cell segmentation;centroid detection;deep learning;regression;spatial statistics;V-net;whole tissue},
  doi={10.1109/ACCESS.2021.3073894},
  ISSN={2169-3536},
  month={},}@ARTICLE{10109131,
  author={Sun, Bangyong and Ma, Ming and Yuan, Nianzeng and Li, Junhuai and Yu, Tao},
  journal={IEEE Transactions on Intelligent Transportation Systems}, 
  title={Detecting the Background-Similar Objects in Complex Transportation Scenes}, 
  year={2024},
  volume={25},
  number={3},
  pages={2920-2932},
  abstract={With the development of intelligent transportation systems, most human objects can be accurately detected in normal road scenes. However, the detection accuracy usually decreases sharply when the pedestrians are merged into the background with very similar colors or textures. In this paper, a camouflaged object detection method is proposed to detect the pedestrians or vehicles from the highly similar background. Specifically, we design a guide-learning-based multi-scale detection network (GLNet) to distinguish the weak semantic distinction between the pedestrian and its similar background, and output an accurate segmentation map to the autonomous driving system. The proposed GLNet mainly consists of a backbone network for basic feature extraction, a guide-learning module (GLM) to generate the principal prediction map, and a multi-scale feature enhancement module (MFEM) for prediction map refinement. Based on the guide learning and coarse-to-fine strategy, the final prediction map can be obtained with the proposed GLNet which precisely describes the position and contour information of the pedestrians or vehicles. Extensive experiments on four benchmark datasets, e.g., CHAMELEON, CAMO, COD10K, and NC4K, demonstrate the superiority of the proposed GLNet compared with several existing state-of-the-art methods.},
  keywords={Feature extraction;Semantics;Roads;Object detection;Meteorology;Pedestrians;Detection algorithms;Autonomous driving;Intelligent transportation systems;Pedestrian detection;automatic driving;guide-learning},
  doi={10.1109/TITS.2023.3268378},
  ISSN={1558-0016},
  month={March},}@ARTICLE{10555423,
  author={Ge, Yueqin and Gao, Yali and Li, Xiaoyong and Cai, Binsi and Xi, Jinwen and Yu, Shui},
  journal={IEEE Internet of Things Journal}, 
  title={EMTD-SSC: An Enhanced Malicious Traffic Detection Model Using Transfer Learning Under Small Sample Conditions in IoT}, 
  year={2024},
  volume={11},
  number={19},
  pages={30725-30741},
  abstract={In the Internet of Things (IoT) scenario, the device diversity and data sparsity present a significant challenge for malicious traffic detection, notably the “small sample problem” where insufficient data hampers the performance of the deep learning methods that depend on large volumes of labeled data for training. Transfer learning (TL) has the capability to transfer knowledge from a label-rich but heterogeneous domain to a label-sparse domain, making it a powerful tool for addressing challenges in IoT malicious traffic detection. To address these challenges, we introduce the EMTD-SSC model, a novel enhanced malicious traffic detection model that leverages TL under small sample conditions in IoT environments. Initially, our approach includes a comprehensive labeled data set that merges a small-scale IoT intrusion detection domain with the traditional intrusion detection domain to enrich semantic information transfer from the source to target domains. The EMTD-SSC model employs dual residual convolutional autoencoders for robust feature extraction and transfer, incorporating skip connections to expedite the model convergence and minimize information loss. Furthermore, to optimize transfer efficiency, we minimize the multilayer multi kernel maximum mean discrepancy (MLMK-MMD) across corresponding network layers, facilitating effective domain adaptation. Through unsupervised training and subsequent fine tuning on the target domain data, the model significantly enhances anomaly detection capabilities. Extensive experiments on the two well-known public data sets demonstrate that the EMTD-SSC model’s effectiveness, achieving an impressive 94.8% accuracy in the binary classification tasks.},
  keywords={Internet of Things;Intrusion detection;Adaptation models;Transfer learning;Data models;Computational modeling;Deep learning;Domain adaptation;malicious traffic detection;residual convolutional autoencoder (RCAE);small sample;transfer learning (TL)},
  doi={10.1109/JIOT.2024.3413580},
  ISSN={2327-4662},
  month={Oct},}@ARTICLE{9313990,
  author={Kim, Taehung and Kim, Hoseong and Byun, Hyeran},
  journal={IEEE Access}, 
  title={Localization-Aware Adaptive Pairwise Margin Loss for Fine-Grained Image Recognition}, 
  year={2021},
  volume={9},
  number={},
  pages={8786-8796},
  abstract={Fine-grained image recognition is a highly challenging problem due to subtle differences between images. There are many attempts to solve fine-grained image recognition problems using data augmentation, jointly optimizing deep metric learning. CutMix is one of the excellent data augmentation strategies which crops and merges to generate new images. However, it sometimes generates meaningless and obscured object images that degrade recognition performance. We propose a novel framework that solves the above problem and expands the CutMix leveraging localizing method. Also, we improve the recognition accuracy to joint optimizing with a pairwise margin loss using generated images from the improved CutMix. There are some images similar to the reference image among the generated images. They are generated by replacing similar parts from the reference image. Those generated images should not be located much farther than the margin value in embedding space because those generated images and a reference image have similar semantic meaning. However, the conventional margin loss can not consider those images which are located much farther than the margin. To solve this problem, we propose an additional margin loss to consider those generated images. The proposed framework consists of two stages: the part localization-aware CutMix and an adaptive pairwise margin loss. The proposed method achieves state-of-the-art performance on the CUB-200-2011, FGVC-Aircraft, Stanford Cars, and DeepFashion datasets. Furthermore, extensive experiments demonstrate that each stage improves the final performance.},
  keywords={Image recognition;Measurement;Task analysis;Semantics;Location awareness;Training;Adaptive margin;deep neural networks;fine-grained image recognition;metric learning;image augmentation;image generation},
  doi={10.1109/ACCESS.2021.3049305},
  ISSN={2169-3536},
  month={},}@ARTICLE{9573443,
  author={Tong, Chaodong and Peng, Huailiang and Bai, Xu and Dai, Qiong and Zhang, Ruitong and Li, Yangyang and Xu, Hanjie and Gu, Xian-Ming},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={Learning Discriminative Text Representation for Streaming Social Event Detection}, 
  year={2023},
  volume={35},
  number={12},
  pages={12295-12309},
  abstract={Event detection on social platforms can help people perceive essential events and make actionable decisions. Existing document-pivot streaming social event detection methods generally embed documents and perform text clustering. They face the challenges of constantly changing context and unknown event categories and struggle by designing compound text representation methods and various similarity measures. However, phased, well-designed methods are excessively fragile and unable to utilize the potential of text representations fully. Meanwhile, their complex threshold settings result in clustering-based event detection suffering the pain of ever-changing environments. We propose a text representation learning method namely Text Similarity Contrastive Learning Neural Network (Text-SimCLNN) to tackle these challenges. Text-SimCLNN uses smaller parts to learn the similarity probability of text pairs from semantic and structural perspectives, effectively bridging the gap between text representation learning and similarity measure in streaming event detection. Event discovery and merging in streams can be easily performed based on the learned representations, and we use various techniques to speed up such processes. Furthermore, we introduce an online update mechanism that uses heterogeneous graphs to generate high-quality samples to enable stable and reliable inductive learning. Extensive experiments on two real-world datasets demonstrate that our method far exceeds state-of-the-art (SOTA).},
  keywords={Event detection;Clustering methods;Electronic mail;Feature extraction;Task analysis;Stability analysis;Social networking (online);Contrastive learning;graph neural network;streaming event detection;text clustering;text representation;text similarity},
  doi={10.1109/TKDE.2021.3119686},
  ISSN={1558-2191},
  month={Dec},}@ARTICLE{10766612,
  author={Wu, Qiwei and Wang, Haidong and Zhou, Jiayu and Xiong, Xiaogang and Lou, Yunjiang},
  journal={IEEE Robotics and Automation Letters}, 
  title={TARS: Tactile Affordance in Robot Synesthesia for Dexterous Manipulation}, 
  year={2025},
  volume={10},
  number={1},
  pages={327-334},
  abstract={In the field of dexterous robotic manipulation, integrating visual and tactile modalities to inform manipulation policies presents significant challenges, especially in non-contact scenarios where reliance on tactile perception can be inadequate. Visual affordance techniques currently offer effective manipulation-centric semantic priors focused on objects. However, most existing research is limited to using camera sensors and prior object information for affordance prediction. In this study, we introduce a unified framework called Tactile Affordance in Robot Synesthesia (TARS) for dexterous manipulation that employs robotic synesthesia through a unified point cloud representation. This framework harnesses the visuo-tactile affordance of objects, effectively merging comprehensive visual perception from external cameras with tactile feedback from local optical tactile sensors to handle tasks involving both contact and non-contact states. We simulated tactile perception in a simulation environment and trained task-oriented manipulation policies. Subsequently, we tested our approach on four distinct manipulation tasks, conducting extensive experiments to evaluate how different modules within our method optimize the performance of these manipulation policies.},
  keywords={Robots;Robot kinematics;Visualization;Affordances;Point cloud compression;Tactile sensors;Cameras;Robot vision systems;Optical sensors;Encoding;Force and tactile sensing;perception for grasping and manipulation;dexterous manipulation},
  doi={10.1109/LRA.2024.3505783},
  ISSN={2377-3766},
  month={Jan},}@INPROCEEDINGS{9923041,
  author={Kumar, Naresh and Jilani, Abdul Khadar and Kumar, Pavan and Nikiforova, Anastasija},
  booktitle={2022 International Conference on Intelligent Data Science Technologies and Applications (IDSTA)}, 
  title={Improved YOLOv3-tiny Object Detector with Dilated CNN for Drone-Captured Images}, 
  year={2022},
  volume={},
  number={},
  pages={89-94},
  abstract={The research problems on Object detection have been attracted with major issues in the computer vision domain. Object detection based on images from unmanned aerial vehicles (UAV) - drones, has versatile applications in both defence security, agriculture and GIS. However, real-time object detection in UAV scenarios remains quite a tedious problem due to environmental obstructions such as occlusion and view-invariant conditions despite the high number of solutions proposed to solve this task. This paper proposes an improved YOLOv3-tiny object detector by introducing a multi-dilated module between the convolution unit and the receptive field, where the problem of a small number of positive training samples is solved by a larger size of the predicted feature map thereby reducing the rate of label rewriting in YOLOv3-tiny. We find that the fusion of multi-scale receptive fields is effective in detecting even every single tiny object. We introduce a path aggregation module that merges the semantic information in a deeper layer and detailed information in an earlier layer. The analysis of the proposed solution shows that on the VisDrone2019-Det test set, our proposed model is more efficient and effective, running 2.96% times faster and increasing 4.0% AP50 than YOLOv3.},
  keywords={Analytical models;Convolution;Object detection;Detectors;Autonomous aerial vehicles;Feature extraction;Real-time systems;Convolutional Neural Network;Dilated CNN;Feature Fusion;Object Detection;Real-Time Object Detection;Unmanned Aerial Vehicle;YOLOv3},
  doi={10.1109/IDSTA55301.2022.9923041},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{9742060,
  author={Yu, Xiaosheng and Gong, Ruxin and Chen, Peng},
  booktitle={2021 IEEE 21st International Conference on Software Quality, Reliability and Security Companion (QRS-C)}, 
  title={Question Classification Method in Disease Question Answering System Based on MCDPLSTM}, 
  year={2021},
  volume={},
  number={},
  pages={381-387},
  abstract={In disease question answering system, question text has some characteristics of diverse expression forms, close semantic connection and uneven distribution of key features. These characteristics make it difficult to extract information and lead to low information utilization. In order to solve the problems, a question classification method based on Merge-Convolutional Neural Networks - Deep Pyramid Convolutional Neural Networks-Long-Short Term Memory (MCDPLSTM) model is proposed. Firstly, question text is vectorized by BERT language model. Secondly, Convolutional Neural Networks (CNN), Deep Pyramid Convolutional Neural Networks (DPCNN) and Bidirectional Long-Short Term Memory (BiLSTM) constitute a multi-channel model to process feature vectors concurrently. And a method based on attention mechanism is used to fuse processed vectors of three channels. Finally, Softmax classifier is used for classification. The experimental results show that MCDPLSTM model has less time cost. Compare with the other models, precision of MCDPLSTM rose by 0.18%-5.43%, recall of MCDPLSTM rose by 0.42%-7.42% and F1-Score of MCDPLSTM rose by 0.47%-7.23%.},
  keywords={Costs;Bit error rate;Text categorization;Semantics;Software quality;Software reliability;Convolutional neural networks;Healthy Medical Text Classification;LSTM;CNN;DPCNN;Attention Mechanism},
  doi={10.1109/QRS-C55045.2021.00063},
  ISSN={2693-9371},
  month={Dec},}@ARTICLE{9350591,
  author={Liu, Zhiyuan and Wu, Linghui and Fu, Weina},
  journal={IEEE Access}, 
  title={System Quality of Human Physiological Signal Based Medical Auxiliary Diagnosis}, 
  year={2021},
  volume={9},
  number={},
  pages={27130-27139},
  abstract={In order to improve the quality of mobile medical assistant diagnosis, this paper proposes the quality research of medical assistant diagnosis system based on human physiological signal. Firstly, the human physiological signal is preprocessed by wavelet transform, and the signal is decomposed and reconstructed. Then, the feature extraction method based on windowing is used to extract the peak valley feature of the hyperbolic pulse of the denoised signals. Iterative self-organizing data analysis method is used to classify the extracted signal features. In addition, by changing the parameters between and within clusters, updating the cluster center and cluster category, and splitting or merging them, the quality of medical auxiliary diagnosis is improved. In the experimental part, 80 patients in Department of cardiovascular medicine and Department of cardiovascular surgery of a hospital were selected as the experimental objects, and 80 physiological signals were collected. Compared with the maximum likelihood method and semantic knowledge base method, the experimental results show that this method improves the quality of traditional medical auxiliary diagnosis. The diagnostic accuracy rate is higher than 98.5%, and the diagnostic sensitivity is higher than 96.5%.},
  keywords={Physiology;Feature extraction;Medical diagnostic imaging;Biomedical monitoring;Wavelet domain;Noise reduction;Discrete wavelet transforms;Human body;physiological signal;mobile medical;auxiliary diagnosis;system quality},
  doi={10.1109/ACCESS.2021.3058222},
  ISSN={2169-3536},
  month={},}@ARTICLE{11165183,
  author={Shi, Jingjia and Zhi, Shuaifeng and Xu, Kai},
  journal={IEEE Transactions on Pattern Analysis and Machine Intelligence}, 
  title={PlaneRecTR++: Unified Query Learning for Joint 3D Planar Reconstruction and Pose Estimation}, 
  year={2026},
  volume={48},
  number={1},
  pages={962-981},
  abstract={The challenging task of 3D planar reconstruction from images involves several sub-tasks including frame-wise plane detection, segmentation, parameter regression and possibly depth prediction, along with cross-frame plane correspondence and relative camera pose estimation. Previous works adopt a divide and conquer strategy, addressing above sub-tasks with distinct network modules in a two-stage paradigm. Specifically, given an initial camera pose and per-frame plane predictions from the first stage, further exclusively designed modules relying on external plane correspondence labeling are applied to merge multi-view plane entities and produce refined camera pose. Notably, existing work fails to integrate these closely related sub-tasks into a unified framework, and instead addresses them separately and sequentially, which we identify as a primary source of performance limitations. Motivated by this finding and the success of query-based learning in enriching reasoning among semantic entities, in this paper, we propose PlaneRecTR++, a Transformer-based architecture, which for the first time unifies all tasks of multi-view planar reconstruction and pose estimation within a compact single-stage framework, eliminating the need for the initial pose estimation and supervision of plane correspondence. Extensive quantitative and qualitative experiments demonstrate that our proposed unified learning achieves mutual benefits across sub-tasks, achieving a new state-of-the-art performance on the public ScanNetv1, ScanNetv2, NYUv2-Plane, and MatterPort3D datasets.},
  keywords={Three-dimensional displays;Cameras;Image reconstruction;Pose estimation;Transformers;Image segmentation;Training;Pipelines;Optimization;Geometry;Planar reconstruction;query learning;relative pose estimation;sparse views reconstruction},
  doi={10.1109/TPAMI.2025.3610500},
  ISSN={1939-3539},
  month={Jan},}@INPROCEEDINGS{11291979,
  author={Kumar, S. Senthil and Kriplani, Khushbu and Riadhusin, Rame and Sahoo, Nigama Prasan and Srinivas, Varanasi and Salaman, Zahraa N. and Meqdad, Maytham N. and Jasim Abushraida, Abdulkareem A.},
  booktitle={2025 3rd International Conference on Cyber Resilience (ICCR)}, 
  title={Swin Transformer Architecture for Accurate Brain Tumor Classification and Localization in MRI-Based Medical Diagnosis}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Medical imaging is fundamental for early illness diagnosis and tumor identification, providing essential visual information on anatomical and pathological features. The increasing need for automated, precise, and scalable diagnostic tools has propelled the development of advanced deep-learning (DL) models for image classification and object recognition. Though proficient in spatial feature extraction, traditional Convolutional Neural Networks (CNNs) are fundamentally constrained in their capability to simulate long-range relationships and multi-scale contextual information. These limitations result in inadequate performance in intricate medical situations characterized by nuanced textural differences, uneven tumor margins, and diverse imaging techniques. Moreover, current models often have elevated false positive rates and restricted generalization across various datasets. This study introduces a novel design utilizing the Swin Transformer-Based Medical Image Diagnosis and Detection Network (Swin-MedNet), a hierarchical Vision Transformer architecture that employs self-attention mechanisms for detecting and classifying brain tumors. This architecture effectively integrates local and global features with linear computing complexity. The model has a multi-stage encoder that gradually merges patches, facilitating scalable representation learning. The design incorporates a Feature Pyramid Network (FPN) and a Region Proposal Network (RPN) to improve semantic localization and tumor segmentation precision for item recognition. Experimental validation on benchmark datasets, including BraTS (brain tumor), showed enhanced performance, elevated classification accuracy, mean Average Precision (mAP), and reduced false detection rates compared to existing methodologies.},
  keywords={Location awareness;Accuracy;Computational modeling;Brain tumors;Computer architecture;Transformers;Brain modeling;Proposals;Medical diagnostic imaging;Image classification;Medical Imaging;Image Classification;Object Detection;Swin Transformer;Attention Mechanism;Brain Tumor Detection},
  doi={10.1109/ICCR67387.2025.11291979},
  ISSN={},
  month={July},}@INPROCEEDINGS{9710738,
  author={Sun, Shuyang and Yue, Xiaoyu and Qi, Xiaojuan and Ouyang, Wanli and Prisacariu, Victor and Torr, Philip},
  booktitle={2021 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Aggregation with Feature Detection}, 
  year={2021},
  volume={},
  number={},
  pages={507-516},
  abstract={Aggregating features from different depths of a network is widely adopted to improve the network capability. Lots of modern architectures are equipped with skip connections, which actually makes the feature aggregation happen in all these networks. Since different features tell different semantic meanings, there are inconsistencies and incompatibilities to be solved. However, existing works naively blend deep features via element-wise summation or concatenation with a convolution behind. Better feature aggregation method beyond summation or concatenation is rarely explored. In this paper, given two layers of features to be aggregated together, we first detect and identify where and what needs to be updated in one layer, then replace the feature at the identified location with the information of the other layer This process, which we call DEtect-rePLAce (DEPLA), enables us to avoid inconsistent patterns while keeping useful information in the merged outputs. Experimental results demonstrate our method largely boosts multiple baselines e.g. ResNet, FishNet and FPN on three major vision tasks including ImageNet classification, MS COCO object detection and instance segmentation.},
  keywords={Image segmentation;Visualization;Convolution;Feature detection;Semantics;Object detection;Computer architecture;Recognition and classification;Detection and localization in 2D and 3D;Representation learning},
  doi={10.1109/ICCV48922.2021.00057},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{11351389,
  author={Ghatala, Vivek and Kurada, Sai Bhuvana and Singh, Sangeeta and Majety, Shashank and Nair, Preeti Sharma},
  booktitle={2025 IEEE International Conference on Advanced Computing Technologies (ICACT)}, 
  title={Cross-Domain Knowledge Transfer in Multimodal AI Systems for Enhanced Predictive Accuracy}, 
  year={2025},
  volume={},
  number={},
  pages={556-561},
  abstract={Recently, cross-domain knowledge transfer in multimodal AI systems has proven problematic. The issue applies especially to apps that must correctly and scalably merge text, graphics, and audio. This paper proposes a three-step approach that allows learning in diverse modes while remaining semantically aligned and domain-invariant. First, deep networks encode each modality. For semantic unification, each modality is projected onto a shared latent space. Domain discriminators generalize features, whereas reconstruction routes and attention approaches protect contextual information and reduce over-fitting. The second phase improves representations with intra- and inter-modal attention modules. It improves learning using contrastive goals, entropy regularization, and domain-based consistency. Finally, a meta-optimization layer, adaptive scoring algorithms, and uncertainty-guided ensemble outputs improve forecasts for confident decision-making. We checked how well the technique works by comparing it to five other models using classification measures (accuracy, precision, recall, F1-score, and AUC-ROC) and system efficiency indicators. The Contrastive Multimodal Knowledge Distillation Approach has the highest adaptability, lowest errors, and 94.6% accuracy while spending less time and money. Contrastive learning and knowledge distillation jointly improve cross-domain transfer in multimodal situations, according to this study. The findings help us create smart, efficient, and scalable AI systems that can handle many real-world data sets.},
  keywords={Representation learning;Training;Adaptation models;Accuracy;Semantics;Memory management;Decision making;Transfer learning;Artificial intelligence;Knowledge transfer;Adaptability;Accuracy;Cross-Domain Learning;Efficiency;Knowledge Distillation;Memory Optimization;Modality Alignment;Multimodal AI;Performance Evaluation;Transfer Learning},
  doi={10.1109/ICACT67549.2025.11351389},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11379069,
  author={Hakkem, B. and Babu, A. Suresh},
  booktitle={2025 International Conference on Intelligent Innovations in Engineering and Technology (ICIIET)}, 
  title={Multi-Scale Feature Fusion and Context Module for Lung Cancer Detection in RetinaNet}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={In many nations throughout the world, One of the most horrible diseases is lung cancer, and it's still challenging to detect it early. To evaluate the tumors, the oncologists take into account the results of blood tests and CT scans, which takes time and requires additional human labor. Therefore, in order to lower mortality, an automated system that effectively detects lung cancers and evaluates their severity should be created. Even though a number of researchers have put out methods for detecting lung diseases, the current methods still fall far short in terms of early-stage tumor detection accuracy. Therefore, our work proposes Lung-RetinaNet is a new and effective lung tumor detector based on RetinaNet. To simultaneously improve the semantic information from the shallow prediction layer, a multi-scale feature fusion-based module is proposed to merge many network layers. Additionally, by simply and lightweightly integrating contextual information with each network stage layer, the context module improves features and efficiently locates the small tumors. The suggested approach achieved 0.989 Auc, 99.8% accuracy, 99.3% recall, 99.4% precision, and 99.5% F1-score. The performance of our proposed model was compared to the state-of-the-art DL-based techniques. Our strategy produces more significant results than existing approaches, as the results show.},
  keywords={Technological innovation;Accuracy;Computed tomography;Semantics;Lung cancer;Mortality;Feature extraction;Reliability;Tumors;Testing;Early discovery of lungs cancer via artificial intelligence and RetinaNet},
  doi={10.1109/ICIIET65921.2025.11379069},
  ISSN={},
  month={Dec},}@ARTICLE{11007583,
  author={Peng, Weilong and Chen, Qingfeng and Tang, Keke and Yu, Zhaoyang and Wang, Yangtao and Xie, Yanzhao and Fang, Meie},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={LactFormer: Language-Aware Context Learning With Multi-Cue Transformers for HOI Detection}, 
  year={2025},
  volume={71},
  number={2},
  pages={3617-3630},
  abstract={Human-Object Interaction (HOI) detection is critical for advancing machine understanding of complex visual environments involving human activities and their interactions with objects. Existing Transformer-based approaches have achieved significant progress but often fall short in fully leveraging prior knowledge and semantic context. To address these challenges, we propose language-aware context learning with multi-cue Transformers (LactFormer), a novel two-stage framework that enhances HOI detection by integrating multi-granularity cues from both visual and linguistic domains. LactFormer comprises three key components: the Language-aware Context Learning Module (LCLM), Vision-based Interactive Query Generation (VIQG), and the Language-aware Interaction Embedding Module (LIEM). The LCLM encodes positional language descriptions and merges them with visual context via a Transformer Encoder, forming a rich, language-aware context. This language-aware context provides a robust foundation for the queries obtained by VIQG, which are then processed by the Transformer Decoder in LIEM to generate effective interaction embeddings for human-object pairs. LactFormer overcomes the limitations of previous Transformer-based models by leveraging a comprehensive understanding of both visual and linguistic information. Extensive experiments demonstrate that LactFormer significantly improves interaction recognition accuracy, achieving state-of-the-art performance.},
  keywords={Transformers;Feature extraction;Visualization;Decoding;Three-dimensional displays;Semantics;Training;Accuracy;Linguistics;Detectors;Human-object interaction detection;Transformer;multi-granularity clues;language-aware context learning},
  doi={10.1109/TCE.2025.3571778},
  ISSN={1558-4127},
  month={May},}@INPROCEEDINGS{11344009,
  author={Venu Gopal Reddy, A. and Wahaj Mohsin, Syed and Jain, Neha and Subhashini, R. and Jyothi Preshiya, D. and Karthik, M.},
  booktitle={2025 International Conference on Responsible, Generative and Explainable AI (ResGenXAI)}, 
  title={Self-Supervised Multiview Contrastive Learning for Enhanced Contextual Word Sense Disambiguation in Natural English Text}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Word Sense Disambiguation within NLP is one of the important tasks of assigning the correct meaning of a polysemous word via its context. Accurate WSD is very important for many NLP applications including MT, information retrieval and sentiment analysis just to name few. Yet succeeding in WSD is difficult, since natural English itself presents great word ambiguity, especially where words can have more than one meaning, depending on types of very subtle contextual clues. Usually, traditional supervised methods need a lot of labeled data, which is expensive and laborious to get. For this purpose, we introduce an innovative approach based on the use of the self-supervised Multiview contrastive learning for WSD. This method merges three distinct views of the context of a word, namely semantic, syntactic, and global, and encodes and fuses them into a holistic word representation. It's a framework that leverages the contrastive learning that helps the model learn robust word representations unassisted supervised data. The results of our experiments are consistent with improvements over baseline models in terms of WSD accuracy, suggesting the usefulness of this approach. Second, it allows for an improvement in WSD in resource constrained environments as the dependency on large labeled datasets can be lowered. In addition, the model achieves the self-supervised nature, which enables the model to be applicable in a variety of NLP tasks and is a valuable solution to research and practical purpose of text understanding and machine translation.},
  keywords={Deep learning;Sentiment analysis;Accuracy;Fuses;Explainable AI;Semantics;Contrastive learning;Syntactics;Information retrieval;Machine translation;Word Sense Disambiguation;Self-Supervised Learning;Multiview Contrastive Learning;NLP;Deep Learning},
  doi={10.1109/ResgenXAI64788.2025.11344009},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11209173,
  author={Raj, T Saju and Thangam, S. Alagu and Balakrishnan, T. Suresh and Ponnaian, Geetha and Vimal, V.R.},
  booktitle={2025 2nd International Conference on Computing and Data Science (ICCDS)}, 
  title={Improving Object Detection in Low Light Surveillance Using Hybrid Image Fusion Techniques Over Traditional Filtering Methods}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The modern surveillance systems face a critical issue to enhance the accuracy of object detection in low-light environments. The classic filtering methods for enhancement fail to maintain crucial detection features like edge points and details with textures as well as illumination differences. A new innovative image fusion framework gets presented within this research because it unites multi-exposure image fusion with guided filtering alongside deep learning-based denoising features to advance object detection accuracy during low-light situations. The system uses wavelet transforms to merge visible and infrared images by CNN-based fusion approaches which enhances spatial definition while preserving semantic fidelity. The proposed system demonstrates superior outcomes against traditional filtering approaches when it comes to detection precision and recall as well as processing efficiency. The proposed method proves its ability to boost feature visibility across different surveillance datasets through multiple experimental evaluations. Experiments on the ExDark (10 117 images) and FLIR-ADAS (13 192 frames) datasets show a mean-Average-Precision (mAP@0.5) of 79.3 %, a+17.9 pp gain over Gaussian filtering and +9.6 pp over CLARE baselines while sustaining 59 ms inference latency on an NVIDIA RTX 4080. These results confirm the framework's suitability for real-time urban surveillance.},
  keywords={Wavelet transforms;Visualization;Accuracy;Filtering;Surveillance;Lighting;Object detection;Feature extraction;Security;Image fusion;Low-light surveillance;Object detection;Hybrid image fusion;Multi-modal imaging;Wavelet transform;Deep learning;Traditional filtering;Image enhancement;CNN-based fusion;Smart security systems},
  doi={10.1109/ICCDS64403.2025.11209173},
  ISSN={},
  month={July},}@INPROCEEDINGS{11386639,
  author={Devarapalli, Thejasree and Yarlagadda, Nagalakshmi and Sivaramakrishnan, A and Haldorai, Anandakumar and Ali, Guma and Sharma, Vinod},
  booktitle={2025 5th International Conference on Advancement in Electronics & Communication Engineering (AECE)}, 
  title={BERT and CNN for Automated Detection of Detrimental Discourse}, 
  year={2025},
  volume={},
  number={},
  pages={196-201},
  abstract={The modern online age is competitive and full of information that requires sensing dangerous materials in order to maintain online honesty and facilitate positive forms of communication. This paper presents a new model that takes a hybrid approach to using BERT Base embeddings and convolutional neural networks (CNNs) to deal with the problem of detecting harmful material in a variety of settings. BERT Base embeddings are used to dynamically gain the fined tuned features of semantics of text that is then processed by a CNN to classify. Compared to the previous studies mainly concentrated on individual contexts with LSTM, RNN, or more advanced transformer models, we use the effectiveness of CNNs to recognize patterns in contexts and also work with different types of harmful content at the same time. To evaluate it, we applied benchmark datasets a reputable Mendeley dataset of hate speech detection, as well as Kaggle datasets of cyberbullying and emotional distress. The experimental results point to the power of our method, which reached almost 92 percent of accuracy in categories. This study merges semantic expressiveness and CNN effectiveness and contributes to content moderation policies and meaningful insights to create safer and more inclusive websites.},
  keywords={Training;Accuracy;Semantics;Hate speech;Cyberbullying;Speech recognition;Feature extraction;Natural language processing;Convolutional neural networks;Context modeling;BERT;CNN;Detrimental Content;Multi Context;Hate Speech;Cyberbullying;Emotional Turmoil},
  doi={10.1109/AECE67531.2025.11386639},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11362415,
  author={Kumari, Chandani and Gourisaria, Mahendra Kumar and Jena, Junali Jasmine},
  booktitle={2025 IEEE 4th International Conference for Advancement in Technology (ICONAT)}, 
  title={Machine Learning-Based Multi-Class Non-Functional Requirement Classification}, 
  year={2025},
  volume={},
  number={},
  pages={01-07},
  abstract={Classification of Multi-Class Non-Functional Requirements in SE is crucial yet difficult job because of diverse linguistic patterns and overlapping semantic subgroups available in requirement documents. This study describes a theoretical ML based path for “multi-class NFR classification” using the software_extended.csv datasets, which contain various NFR subgroups in software requirements. To increase classification performance, we implemented 4 different feature extraction methods such as $\text{BOW}+\text{CHI} 2, \text{BOW}$, TF-IDF+CHI2 and TF-IDF etc., in combination with 10 ML algorithms like KNN, SVM, RF, Stacking, Voting, D-tree, LR, Naive Bayes, AdaBoost, and Gradient Boost etc. In our investigation we have observed that Voting, LR and SVM constantly giving best result than other models across all feature classes. Additionally, SVM using TF-IDF achieved the best accuracy of approximately 80%, followed nearly by LR and Voting representing that esemble methods and linear classifier are well performed with text-based feature or sparse areas. Classifiers such as KNN, Stacking and Naive Bayes describes infirmed performance, especially on TFIDF feature, because of their demerits in dealing with realvalued and high-dimensionaility data. In this paper we have observed that a merging the Chi-Squared feature selection method and TF-IDF vectorization methods, combined with esemble models or SVM, gives a robust performance in NFR classification. This research leads to the foundation of combining intelligent requirement classification into software development piplines, that is the reason we are able to improve software design and analysis phase in the beginning.},
  keywords={Software design;Stacking;Software algorithms;Semantics;Nearest neighbor methods;Feature extraction;Software;Bayes methods;Software engineering;Software development management;ML classifier;Non-Functional Requirement;TFIDF;BOW;CHI2;Software Engineering;Classification;Software Design;Software Analysis},
  doi={10.1109/ICONAT66879.2025.11362415},
  ISSN={},
  month={Sep.},}@ARTICLE{11361148,
  author={Shao, Shuai and Xu, Rui and Zhang, Bingfeng and Liu, Baodi and Liu, Weifeng and Zhou, Yicong},
  journal={IEEE Transactions on Circuits and Systems for Video Technology}, 
  title={CO+3: Improved Collaborative Consortium of Foundation Models for Open-World Few-Shot Learning}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={Open-World Few-Shot Learning (OFSL) is a critical research domain focused on accurately identifying target samples under conditions where data is scarce and labels are unreliable. This field is highly relevant to real-world scenarios, holding significant practical implications. Currently, the field has only a few solutions, primarily relying on conventional methods such as metric learning and feature aggregation. However, these methods often struggle in more complex scenarios. Recent breakthroughs in foundation models such as CLIP and DINO have demonstrated their strong representational capabilities, even in resource-limited environments. These advancements have led to a shift from “training model from scratch” towards “exploiting the extensive capabilities and expertise of these pre-trained foundation models for OFSL”. Inspired by this shift, we introduce the Improved Collaborative Consortium of Foundation Models (CO+3), an extension of CO3, first presented in AAAI 2024. CO+3 significantly improves the accuracy of OFSL by integrating the strengths of four foundational models. It includes three decoupled blocks: (1) The Label Correction Block (LC-Block) rectifies unreliable labels, (2) the Data Augmentation Block (DA-Block) enriches the available data, and (3) the Text-guided Fusion Adapter (TeFu-Adapter) merges various features and reduces the impact of noisy labels through semantic constraints. We evaluate CO+3 across eleven benchmark datasets, comparing it against recent state-of-the-art methods. Our thorough evaluations demonstrate that the proposed CO+3 consistently surpasses existing methods by a substantial margin, particularly in high-noise scenarios.},
  keywords={Foundation models;Few shot learning;Noise;Adaptation models;Visualization;Videos;Training;Noise measurement;Circuits and systems;Accuracy;Open-world few-shot learning;foundation model;adapter},
  doi={10.1109/TCSVT.2026.3656950},
  ISSN={1558-2205},
  month={},}@INPROCEEDINGS{11470339,
  author={Thatha, Venkata Nagaraju and Reddy, B. Veera Sekhar and Meghana, Nadella Lalitha and Madhu, Mulka and Kumar, Muthyapu Pranith and Jokhana, Gunta},
  booktitle={2026 International Conference on Visual Analytics and Data Visualization (ICVADV)}, 
  title={Hybrid Machine Learning Approaches for Passive Blind Image Splicing Forensics}, 
  year={2026},
  volume={},
  number={},
  pages={667-672},
  abstract={Digital image editing technology is moving so fast that it might completely destroy the visual content credibility. First of all, forensic specialists have trouble spotting image collisions and mixing when the edited areas are perfectly integrated and then the image is post-processed. Moreover, the passive detection using DCT, DWT, and LBP has been not very successful and, in fact, has often failed to provide even the slightest evidence that could point to a global forgery in realworld cases. In coping with these trials, the present research brings forth an innovative hybrid machine learning framework for passive blind image splicing detection that relies on the uniting of the handcrafted forensic descriptors with the deep learning-based feature representations. The technique is featured by the merging of texture, frequency, and noise-related cues, while the CNN embeddings grasp the semantic inconsistencies that splicing has introduced via fusing. The combination of these complementary features indeed enhances the capability of the system to detect tampering even after the images have undergone the aforementioned attacks like compression, rescaling, filtering, and illumination variations. The framework is tested on standard datasets such as CASIA v2.0 and the Columbia Image Splicing Dataset allowing both image-level detection and pixel-level localization. The results from the experiment show that the method outperforms both the handcrafted and deep learning approaches in terms of detection performance measures such as precision, recall, and the F1-score. The present study also points out major drawbacks of current splicing detection methods and opens up new pathways towards the trustworthiness of forensic applications in the areas of journalism, law enforcement, and social media authenticity verification.},
  keywords={Filtering;Filters;Circuits and systems;Digital images;Location awareness;Pixel;HTTP;Protocols;Mobile communication;Communication networks;Passive blind image splicing;hybrid machine learning;digital image forensics;handcrafted descriptors;CNN embeddings;image tampering localization;CASIA v2.0;Columbia dataset},
  doi={10.1109/ICVADV67766.2026.11470339},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11409633,
  author={Zhang, Guohao},
  booktitle={2025 5th International Conference on Electronic Information Engineering and Computer Communication (EIECC)}, 
  title={Research on Image Classification Based on Deep Learning Technologies}, 
  year={2025},
  volume={},
  number={},
  pages={835-840},
  abstract={Image classification, a fundamental task in computer vision, has rapidly progressed from shallow models based on handcrafted features to advanced deep learning architectures. To overcome the limitations of conventional convolutional neural networks (CNNs) in global modeling and the high computational complexity associated with pure Transformers, this paper introduces a hybrid classification model that integrates ResNet with Vision Transformer (ViT). This model combines the local feature extraction strengths of ResNet with the global semantic modeling capabilities of ViT, enabling a synergistic representation of features at multiple levels. Experiments conducted on the Intel Image Classification dataset demonstrate that the model achieves Top- 1 and Top- 5 accuracy rates of 91.70% and 99.93 %, respectively, significantly surpassing the performance of models using ResNet or ViT independently. Further analysis indicates that the model maintains high precision and recall across all categories, showing particularly strong robustness in complex backgrounds characterized by noise and occlusion. These results validate the effectiveness of merging ResNet with Transformers in image classification and offer new insights for multimodal feature learning and visual representation research.},
  keywords={Deep learning;Computer vision;Visualization;Computational modeling;Semantics;Computer architecture;Feature extraction;Transformers;Computational complexity;Image classification;Image classification;residual neural networks;Vision Transformer;deep learning},
  doi={10.1109/EIECC67963.2025.11409633},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11378509,
  author={Satrawada, Jai and Satravada, Baby Anusha},
  booktitle={2025 IEEE Pune Section International Conference (PuneCon)}, 
  title={Genetic Ancestry and Cancer Genomics: An LLM-Based Framework for Equitable Precision Oncology}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The incidence of cancer, its genetic mutations, and treatment effectiveness depend heavily on genetic ancestry. Yet existing cancer genomics datasets underrepresent non-European populations, which restricts the application of precision oncology results to diverse patient groups. In this study, a retrieval-augmented generation (RAG) framework used large language models (LLMs) to analyze 30 PubMed-indexed cancer genomics studies that contained ancestry-related underrepresented groups in genomic research. The system used document chunking, embeddings, and semantic retrieval to find connections between ancestry, mutations, and treatment effects. Our system achieved 92% retrieval precision and 0.87 F1-score in mutation-ancestry mapping, validated against The Cancer Genome Atlas (TCGA) datasets. The platform successfully detected how different ancestry groups relate to cancer mutations and drug responses through its analysis of TP53 mutations in African breast cancer patients and better EGFR-inhibitor effectiveness in East Asian lung cancer patients. The study revealed two important findings, which showed that people of African ancestry have a higher risk of clear-cell renal carcinoma when they carry VHL variants, and survival rates differ based on ancestry. The research proves that AI-based literature analysis can merge scattered ancestry-cancer data to discover fresh connections between genetic background and cancer. The implementation of ancestry-based frameworks in precision oncology practice will help achieve fair cancer treatment for all patients.},
  keywords={Drugs;Large language models;Retrieval augmented generation;Cancer treatment;Semantics;Genomics;Oncology;Reliability;Bioinformatics;Cancer;genetic ancestry;cancer genomics;precision oncology;large language models;retrieval-augmented generation;health disparities},
  doi={10.1109/PuneCon67554.2025.11378509},
  ISSN={2831-5022},
  month={Dec},}@INPROCEEDINGS{10695678,
  author={Zhang, Meiheng},
  booktitle={2024 Asia-Pacific Conference on Image Processing, Electronics and Computers (IPEC)}, 
  title={Research on Basketball Player Tracking Method Based on Multi-Feature Fusion}, 
  year={2024},
  volume={},
  number={},
  pages={214-220},
  abstract={Multi-object tracking is a hot topic in the field of computer vision, which is widely used in intelligent transportation, intelligent surveillance, autonomous driving, and other fields. With the rapid development of the sports industry, the problem of athlete tracking in sports has gradually attracted attention. Unlike pedestrian tracking in ordinary surveillance scenarios, athlete tracking in sports scenarios faces great challenges due to frequent occlusion, large pose changes, and the similar appearance of athletes. This article takes basketball player tracking as the research object, focusing on the methods of athlete detection and tracking. To address the problem of low accuracy due to the similarity of athletes’ appearance, this paper proposes a basketball player tracking algorithm based on multi-feature fusion. First, a multi-branch re-identification model for athletes is designed. The global branch learns the global semantic information of the athletes; the local branch horizontally partitions the body parts of the athletes to learn fine-grained features; the feature deletion branch deletes the most activated part of the features, forcing the network to learn the remaining significant features. Then, the features of the three branches are merged to improve the discriminability of the athletes. Finally, experiments are conducted on the dataset, and the results show that the proposed method achieves good performance.},
  keywords={Accuracy;Pedestrians;Surveillance;Semantics;Transportation;Feature extraction;Trajectory;Partitioning algorithms;Time factors;Sports;Multi-feature fusion;Athlete tracking;Athlete detection;Hybrid attention},
  doi={10.1109/IPEC61310.2024.00044},
  ISSN={},
  month={April},}@INPROCEEDINGS{10831669,
  author={Cao, Feng and Yang, Shuiyuan and Li, Deyu and Tao, Chongben},
  booktitle={2024 IEEE International Conference on Systems, Man, and Cybernetics (SMC)}, 
  title={MAFEN: Multiattention Feature Extraction Network for Remote Sensing Scene Classification}, 
  year={2024},
  volume={},
  number={},
  pages={4997-5002},
  abstract={The scene classification of high-resolution remote sensing images (HRSIs) provides crucial information for the high-level semantic understanding of the complicated earth's surface. Some existing methods concatenate local features with global features to complete the classification task. However, simple feature concatenation cannot fully exploit the advantages of the above two features. This study proposes a novel multiattention feature extraction network (MAFEN) for the scene classification of HRSIs. First, a dual-branch network is proposed to extract local and global features from the scene images. Subsequently, an interattention fusion module is utilized to merge the local and global features. In addition, the multilevel feature fusion module helps avoid the loss of shallow and middle-layer features. Finally, an aggregated loss is employed to enhance the feature fusion of the dual-stream feature extractor by considering the contributions of different features. Experimental evaluations are conducted on three widely used public datasets for scene classification. Results confirm the potential of MAFEN for remote sensing scene classification tasks when compared with currently advanced methods in the field.},
  keywords={Training;Earth;Scene classification;Fuses;Semantics;Feature extraction;Complexity theory;Remote sensing;Cybernetics;Convergence},
  doi={10.1109/SMC54092.2024.10831669},
  ISSN={},
  month={Oct},}@ARTICLE{11533605,
  author={Wu, Jinhong and Wang, Haihui and Qin, Zhenhai and Dai, Jinyang and Zhang, Qixing},
  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={SmokeNeXt: Dual-Stream CNN-Transformer Hybrid Architecture With Multiscale Adaptation for Satellite Remote Sensing Smoke Image Classification}, 
  year={2026},
  volume={},
  number={},
  pages={1-20},
  abstract={Smoke detection by remote sensing plays a vital role in forest fire monitoring due to its wide coverage and fast update frequency. At present, two main challenges remain: 1) the spatio-temporal variability of smoke's shape and color, and 2) the drastic scale differences of smoke instances across images, both of which hinder the generalization of existing approaches. Traditional CNNs are effective in capturing local details but struggle with large-scale context modeling. Transformers offer global self-attention and long-range dependency modeling but often miss fine-grained information, especially for small targets. To address these issues, we propose SmokeNeXt, a dual-stream, multiscale adaptive model tailored for smoke classification. By fusing the Conv-branch's local detail extraction with the Trans-branch's global context modeling, a semantic merge module with a self-designed multi-axis convolutional cross-attention enables cross-stream feature complementation. In addition, A gated redundancy suppression module is introduced to dynamically filter out irrelevant background noise, enhancing robustness to appearance variability. Experiments on the FASDD_RS and USTC_SmokeRS datasets demonstrate that SmokeNeXt effectively mitigates both challenges. On FASDD_RS, it achieves 97.8% accuracy and 99.1% AR@$\bf {\phi _{0.04\%\rm{--}0.8\%}}$, with high recall even under extreme small-scale smoke conditions, and consistently focusing on smoke regions across diverse appearances and backgrounds. On USTC_SmokeRS, SmokeNeXt achieves an accuracy of 96.2%. Compared with ResNet-50, ConvNeXt-B, and MobileNetV3, SmokeNeXt improves AR by 8.0%, 1.5%, and 6.6%, respectively, indicating strong generalization under extreme scale variation and morphological diversity.},
  keywords={Modeling;Transformers;Remote sensing;Convolutional neural networks;Signal detection;Grounding;Earth;Fires;Firing;Design methodology;CNN-Transformer hybrid;deep learning;multiscale adaptability;remote sensing smoke detection},
  doi={10.1109/JSTARS.2026.3695155},
  ISSN={2151-1535},
  month={},}@INPROCEEDINGS{11157268,
  author={Akmal, Muhammad Farhan and Romadhony, Ade},
  booktitle={2025 International Conference on Data Science and Its Applications (ICoDSA)}, 
  title={Data Augmentation with Synonym Replacement and Random Insertion for Fake News Classification}, 
  year={2025},
  volume={},
  number={},
  pages={237-243},
  abstract={The spread of fake news or hoaxes remains a significant issue in today’s digital world. Detecting fake news becomes even more challenging when dealing with limited data. This study looks at how to use data augmentation techniques such as Synonym Replacement (SR) and Random Insertion (RI) to improve the performance of fake news classification models. Accuracy and F1 Score are used to evaluate the effectiveness of these techniques at three different augmentation levels: low (0.25), medium (0.5), and high (1). The results of this study show that SR and RI significantly enhance model performance than the original dataset. SR outperforms RI due to its ability to preserve semantic meaning, especially at higher augmentation levels. On the other hand, RI makes some changes that generalize better, especially at lower augmentation levels. The ISOT Dataset (Dataset 1) has 23,502 fake and 21,417 real news articles for binary classification. The WELFake Dataset (Dataset 2) contains 72,134 articles (35,028 real, 37,106 fake), merging multiple sources to improve diversity and reduce overfitting. Experimental results show that the Accuracy score increased from 0.81 to 0.93 and the F1 Score improved from 0.82 to 0.93 on Dataset 1, and for Dataset 2, the Accuracy increased from 0.81 to 0.93, and the F1 Score improved from 0.80 to 0.93. However, the techniques have limitations, as they have not yet been tested in real-world applications, where domain-specific challenges and scalability could impact their performance. Overall, the results show that data augmentation gives positive improvements over the fake news classification task by solving issues related to imbalanced datasets and enhancing the model’s ability to generalize effectively.},
  keywords={Accuracy;Scalability;Text categorization;Semantics;Data augmentation;Data models;Real-time systems;Fake news;Testing;Overfitting;data augmentation;synonym replacement;random insertion;fake news;hoaxes},
  doi={10.1109/ICoDSA67155.2025.11157268},
  ISSN={},
  month={July},}@INPROCEEDINGS{11437521,
  author={Pandey, Deepa and Dalvi, Aryan and Bedse, Ankita and Jain, Dhruv and Patil, Aarya and Deshpande, Himani},
  booktitle={2026 6th Biennial International Conference on Nascent Technologies in Engineering (ICNTE)}, 
  title={HyT5: A Novel Architecture for Improved Text Summarization}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Automatic text summarization remains a very challenging task, especially in producing summaries that are semantically faithful and structurally well formed. Transformer models like T5 excel at capturing global contextual knowledge but tend to perform less effectively in handling subtle sequential dependencies in long documents. On the other hand, recurrent models like bidirectional LSTMs are proficient at modeling sequential order but are limited in capturing broader contextual relationships. To enhance these aspects, there is a proposed novel hybrid architecture HyT5 that combines the contextual power of Transformers with the sequential precision of LSTMs. By merging these complementary strengths, HyT5 generates summaries that are globally coherent while maintaining key sequential continuity. The model is trained and tested on the CNN/Daily Mail dataset, with preprocessing involving tokenization, truncation, and normalization to standardize input. Model optimization was stabilized through iterative check pointing during training. ROUGE-1, ROUGE-2, ROUGE-L, and BERTScore evaluations show that HyT5 outperforms existing architectures consistently. The results highlight the strength of novel architectures in text summarization and position HyT5 as a promising approach for improved accuracy, fluency, and semantic fidelity in automatic summarization.},
  keywords={Measurement;Training;Semantics;Text summarization;Transformers;Tokenization;Standards;Optimization;Context modeling;Postal services;Text summarization;LSTM;Transformer;CNN},
  doi={10.1109/ICNTE66387.2026.11437521},
  ISSN={2836-9750},
  month={Jan},}@INPROCEEDINGS{11108589,
  author={Song, Huacui and Kong, Weizhi and Zhang, Maqun and Yu, Chuanhui and Han, Rui and Yin, Jiayi},
  booktitle={2025 IEEE International Conference on Pattern Recognition, Machine Vision and Artificial Intelligence (PRMVAI)}, 
  title={MHCAF-Net:The Mamba-Hierarchical Channel-Attention Fusion Network for Multi-Source Remote Sensing Image Classification}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={To address issues such as feature discrepancies across modalities, long-range channel dependency modeling, local detail loss, and to enhance the generalization ability of the model, this paper proposes the HMCFA-Net for joint classification of HSI and LiDAR. Specifically, the Mambabased Heterogeneous Channel-Attention Merge Module (HCMMamba) is introduced, which dynamically adjusts the weights of multi-modal features and facilitates their efficient fusion, thereby enhancing complementary feature representation, improving channel-wise feature extraction, and mitigating detail loss. To enhance the generalization ability of the network, this paper designs a Hierarchical Multi-Modal Loss (HMML) function, aiming to jointly achieve global semantic modeling and local cross-modal feature optimization. Experiments were designed to show the effectiveness of HMCFA-Net.},
  keywords={Laser radar;Machine vision;Semantics;Hidden Markov models;Feature extraction;Pattern recognition;Artificial intelligence;Optimization;Remote sensing;Image classification;HSI;LiDAR;Mamba;Multi-Modal},
  doi={10.1109/PRMVAI65741.2025.11108589},
  ISSN={},
  month={June},}@INPROCEEDINGS{11330012,
  author={Limantara, Rudi and Witanto, Elizabeth Nathania and Andreas, Christopher and Nugraha, Satria Adi and Paramita, Adi Suryaputra and Andreas, Christopher},
  booktitle={2025 8th International Conference on Informatics and Computational Sciences (ICICoS)}, 
  title={Multi Channel Fusion Framework for Tomato Leaf Disease Classification Using Modified Cnn Backbones and Preprocessing Aware Input Design}, 
  year={2025},
  volume={},
  number={},
  pages={98-102},
  abstract={This research develops a deep learning system for identifying tomato leaf diseases by combining multiple image processing techniques with advanced neural networks. The approach takes input images and creates three different versions: the original RGB photo, a segmentation mask that isolates just the leaf area, and contrast-enhanced version made using Contrast Limited Adaptive Histogram Equalization (CLAHE). These three image types get merged together and fed into modified versions of established CNN models - ResNet50, EfficientNetB0, and MobileNetV2. The models also use data augmentation with various geometric and lighting changes to help them work better on new images. Results show that using this combined input approach boosts classification performance across all the neural network models, with EfficientNetB0 reaching the best F 1 -score of 0.999. The leaf segmentation part, done with U-Net and U-Net using FP32 precision, accurately separates leaves from backgrounds with Dice scores over 0.98. The complete system handles real-world challenges well, including different surface textures, lighting conditions, and leaf orientations that farmers encounter in the field. The main contribution here is bringing together semantic understanding, structural information, and visual details in one classification system, creating a practical tool for automated disease detection in modern farming. Future work could focus on making this run on mobile devices and adding AI explanation features so farmers can understand and trust the system's decisions better.},
  keywords={Deep learning;Image segmentation;Visualization;Adaptation models;Neural networks;Lighting;Data augmentation;Data models;Diseases;Residual neural networks;fusion images;multi channel fusion;tomato leaf diseases},
  doi={10.1109/ICICoS68590.2025.11330012},
  ISSN={2767-7087},
  month={Oct},}@ARTICLE{11449925,
  author={Vaishnavi, J. and Vinila Jinny, S.},
  journal={IEEE Access}, 
  title={Adaptive Self-Attention Across Domains for Music Genre Estimation: Deep Learning-Based Framework}, 
  year={2026},
  volume={14},
  number={},
  pages={49383-49397},
  abstract={Understanding music in many contexts and in addition to genre depends on systems that can adjust to cultural, user-specific, and multi-modal information. Context-Aware Multi-Modal Music Understanding via Adaptive Self-Attention and Cross-Domain Learning aims to improve music tagging and recommendation across many listening environments. Although contemporary music classification systems show good performance on carefully chosen datasets, they often cannot extend to other fields and neglect variations in culture, context, and personal listening behaviour. Here, a framework CD-MMAN (Context-Driven Multi-Modal Attention Network), an adaptable architecture using multi-stream attention techniques to unite audio signals with user context (such as cultural origin, listening history, and optional lyrical content) in response to these inadequacies. Using a Multi-modal Attention Fusion Layer to merge spectral-temporal audio data with contextual embeddings, CD-MMAN enhances genre and tag prediction. It guarantees that semantic alignment stays preserved across domains by use of a consistency-aware loss function with contextual regularization. The proposed approach is applied for real-time music identification and customized recommendation to produce Music Information Retrieval (MIR) systems that are broadly applicable, context-sensitive, and culturally flexible. CD-MMAN significantly beats previous models on recommendation tasks using enhanced datasets that include user and contextual information. This is true in terms of classification accuracy (4.2–7.5%), cross-cultural consistency (a substantial margin), and user satisfaction (a substantial margin). Based on the results, there is a lot of room for improvement in global streaming platforms and cross-cultural music information retrieval systems.},
  keywords={Adaptation models;Cultural differences;Semantics;Transformers;Accuracy;Music;Context modeling;Videos;Recommender systems;Music information retrieval;Cross-domain learning;music recommendation;adaptive attention;multi-modal fusion;cultural music understanding;deep learning},
  doi={10.1109/ACCESS.2026.3676049},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11258435,
  author={Mahmood, Mohammed Thakir and UCAN, Osman Nuri},
  booktitle={2025 3rd International Conference on Business Analytics for Technology and Security (ICBATS)}, 
  title={An Investigation for Glaucoma and Segmentation Using Deep Network}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Glaucoma is a prevalent ocular condition that can lead to irreversible vision loss if left untreated in its early stages. Although optic imaging and machine learning have made significant advancements, there is still a gap in effectively and efficiently diagnosing glaucoma using fundus pictures. This research aims to address the existing gap in the field by introducing a novel deep learning approach for diagnosing glaucoma. We aim to develop a method that can precisely locate the optic disc in fundus photos, classify normal and glaucomatous photographs as healthy or glaucomatous with great precision, and effectively segment the optic disc region. To construct a multi-spatial network based on semantic links, it is crucial to merge a thorough collection of 12,000 fundus pictures obtained from seven distinct sources. The system we developed incorporates a convolutional neural network to extract features and perform classification tasks. This approach yields superior results compared to previous methods, achieving an accuracy of up to 94% on the ORIGA dataset. An automated diagnosis for glaucoma can have a substantial impact on therapy by enabling early intervention and improving outcomes.},
  keywords={Glaucoma;Integrated optics;Optical losses;Biomedical optical imaging;Semantics;Optical computing;Optical imaging;Feature extraction;Optical fiber communication;Security;Glaucoma;Medical Imaging;Machine Learning;DCNN},
