  author={Hebbar, Nagaveni and Kunte, Ashwini},
  booktitle={2022 IEEE 3rd Global Conference for Advancement in Technology (GCAT)}, 
  title={A Deep Learning Framework with Transfer Learning Approach for Image Forgery Localization}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={Altering digital content is one of the major concerns experienced in the digital environment. Because of the developments in image modification applications in this digital era, the tampering of images for harmful reasons has proliferated, necessitating the detection of such manipulation before it misleads in any of the applications. A framework based on DeepLabv3+ is presented in this paper for detecting several forms of forgeries and locating the altered areas precisely within the images. To pre-process the forged photos, Error Level Analysis (ELA) is used, which differentiates the areas with varying quantization error levels. The complete framework is trained using the pre-processed images as input. The encoder side of the DeepLabv3+ architecture uses a pre-trained ResN et50 network for transfer learning. DeepLabv3+ uses Atrous convolution that helps to get the broader field of view and extracts contextual features for enhancing the precision of localization. At the decoder, the output features of the encoder are merged with the low-level features of the input image to appropriately locate the forged area. With high precision, this framework can identify and locate many types of manipulations. The findings illustrate that the proposed framework outperforms several existing forged area localization techniques.},
  keywords={Location awareness;Training;Deep learning;Quantization (signal);Image coding;Transfer learning;Feature extraction;forgery localization;transfer learning;copy-move Detection;splicing Detection;error level analysis},
  doi={10.1109/GCAT55367.2022.9971986},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9843406,
  author={Seeliger, Robert and Bassbouss, Louay},
  booktitle={2022 IEEE 47th Conference on Local Computer Networks (LCN)}, 
  title={Dynamic Ad Substitution in Hybrid Broadband Broadcast Environments}, 
  year={2022},
  volume={},
  number={},
  pages={248-250},
  abstract={Technology environments are fragmented, hybrid and broadcast merge along online and digital paths, orchestration and distribution of individual content streams are evolving rapidly; DAI, SSAI, CSAI, DAS, targeted advertising and addressable TV are terms with different techniques but at the same time often used for similar use cases. There are standards such as HbbTV and MPEG-DASH available, but they meet these requirements only partially and require enhancements before they can be adopted by the industry. While HbbTV 2.0.3 is the latest version of the specification, it still has limitations in providing a seamless and personalized ad experience across broadcast and broadband. This demo showcases a real world, deployed and almost product ready implementation of Dynamic Ad Substitution for HbbTV Versions 1.5 and 2.0.X showcasing the feasibility for individual content replacements via broadband in broadcast environments.},
  keywords={Measurement;Industries;TV;Tuners;Transform coding;Switches;Streaming media;DAI;Ad Insertion;HbbTV;DAS;Stream Events;streaming workflow optimization;adaptive bitrate streaming},
  doi={10.1109/LCN53696.2022.9843406},
  ISSN={0742-1303},
  month={Sep.},}@INPROCEEDINGS{9693549,
  author={Hui, Yuanyuan and Liu, Han and Fang, Pengfei},
  booktitle={2021 CAA Symposium on Fault Detection, Supervision, and Safety for Technical Processes (SAFEPROCESS)}, 
  title={Neuron perceptron-driven image encryption incorporating hyper-chaotic system}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={An algorithm of image encryption based on hyper-chaotic system and neuron mechanism as well as encryption sequence encoding of image high and low bit plane diffusion and zigzag scrambling fusion is proposed. First, the plaintext image is divided into eight-bit planes, and then the high and low four-bit planes are randomly exchanged and merged to obtain a diffusion image. The diffusion image is encrypted and encoded using the neuron mechanism, and then the Zigzag scrambling operation is performed. Perform further forward and backward diffusion operations on the scrambled image to get the ciphertext image. The analysis of the experimental results can prove that the encryption algorithm of this paper has a large key space, strong anti-attack ability, and excellent cryptographic performance.},
  keywords={Image coding;Correlation;Fault detection;Neurons;Information security;Resists;Encryption;hyper-chaotic system;image encryption;neuron mechanism;bit manipulation},
  doi={10.1109/SAFEPROCESS52771.2021.9693549},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{8974706,
  author={Seeliger, Robert and Bassbouss, Louay and Arbanowski, Stefan and Steglich, Stephan},
  booktitle={2019 23rd International Computer Science and Engineering Conference (ICSEC)}, 
  title={Towards Personalized Content Replacements in Hybrid Broadcast Broadband Environments}, 
  year={2019},
  volume={},
  number={},
  pages={385-389},
  abstract={Nowadays web-based over-the-top streaming and traditional broadcast merges along the digital and online path enabling new hybrid use cases and services. In addition, content orchestration services and its distribution as individual content to a fragmented set of end devices evolves rapidly. Favored by those developments, new services and solutions for dynamic content replacements have arised and partially already been introduced – Client-Side AD-Insertion (CSAI), Server-Side Ad-Insertion (SSAI), Dynamic Ad-Insertion (DAI) Dynamic Ad-Substitution (DAS), targeted advertising, addressable TV, Playout-Side Ad-Insertion (PSAI) are just some of those terms used for similar use cases but with different techniques and meaning. Standards like HbbTV and MPEG-DASH are available but address the new requirements only partially and require enhancements to be adoptable by the industry. HbbTV 2.0.2 is the newest version of the HbbTV specification but still has limitations to provide a seamless and personalized content and ad experience in hybrid broadcast broadband environments. This work analyses those technologies regarding their implementation of different Dynamic Ad Insertion (DAI) use cases and describes opportunities as well as application limitations. It also evaluates the feasibility for individual content replacements and gives recommendations for future enhancements.},
  keywords={Industries;Computer science;TV;Transform coding;Broadband communication;Advertising;Standards;DAI;Ad Insertion;HbbTV;PSAI;CSAI;SSAI;DAS},
  doi={10.1109/ICSEC47112.2019.8974706},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11022253,
  author={Fan, Zhipeng and Su, Jianpo and Xu, Jingrui and Zeng, Ling-Li and Hu, Dewen},
  booktitle={2024 8th Asian Conference on Artificial Intelligence Technology (ACAIT)}, 
  title={A Multibranch Cross-Attention Transformer Model for Psychiatric Disorders Diagnosis Using Multi-Modal MRI Data}, 
  year={2024},
  volume={},
  number={},
  pages={126-132},
  abstract={With powerful feature extraction and representation ability, deep learning (DL) methods have became effective approaches for brain disorders diagnosis based on magnetic resonance imaging (MRI) data. Due to the limitation of MRI scanners, it is difficult to obtain a MRI scan that contains both functional metabolic information and sufficient structural details. Therefore, it poses the challenges for DL methods to learn better spatio-temporal representations in single modality data for identifying brain disorders. Multimodal MRI data fusion, has become an effective way to merge the complementary information in multi modalities. However, most MRI fusion methods mix features extracted from the single modality data into fused representation by learning simple linear combination, which may not well merge the high resolution of structure into temporal function pattern in latent space. To solve this problem, we propose an efficient method to fuse the structural MRI (sMRI) and functional MRI (fMRI) data into joint representations to utilize the cross-modality complementary information. In proposed method, we introduce the ROIs convolution based on the brain atlas to extract the sparse structural features from sMRI data and align to the time-series in fMRI data. A Multibranch Cross-attention Transformer (MBCAT) model is proposed to fuse multi-modal ROI-aligned features and further extract spatiotemporal representation for brain disorders diagnosis.The experiments on identifying schizophrenia (SCZ) demonstrate that our proposed method achieves a significant improvement over the single modality data with only sMRI data and only fMRI data. Furthermore, the DL models trained by proposed method outperform the previous multimodal MRI fusion methods and achieve the average accuracy of 86.88%.},
  keywords={Fuses;Functional magnetic resonance imaging;Schizophrenia;Feature extraction;Transformers;Brain modeling;Data models;Spatiotemporal phenomena;Data mining;Periodic structures;MRI;multimodal fusion;brain atlas;cross-attention transformer;schizophrenia},
  doi={10.1109/ACAIT63902.2024.11022253},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9266182,
  author={Todoran, Eneia Nicolae},
  booktitle={2020 IEEE 16th International Conference on Intelligent Computer Communication and Processing (ICCP)}, 
  title={Metric Semantics for Concurrent Languages Designed in Continuation-Passing Style}, 
  year={2020},
  volume={},
  number={},
  pages={521-528},
  abstract={We present a semantic domain for designing concurrent languages in continuation-passing style (CPS). We offer denotational semantics designed in CPS for languages based on Milner's CCS extended with mechanisms which support multiparty interactions. We establish a collection of properties which can describe the behavior of concurrent systems with multiparty interactions. The semantic investigation is accomplished in the mathematical framework of complete metric spaces.},
  keywords={Semantics;Measurement;Extraterrestrial measurements;Concurrent computing;Syntactics;Mathematical model;Algebra;metric spaces;continuations;concurrent languages},
  doi={10.1109/ICCP51029.2020.9266182},
  ISSN={},
  month={Sep.},}@ARTICLE{11006506,
  author={Lee, Jeongho and Kim, Sangjun and Lee, Jaeyong and Kang, Jaeyoung and Lee, Sungjin and Kim, Nam Sung and Kim, Jihong},
  journal={IEEE Computer Architecture Letters}, 
  title={srNAND: A Novel NAND Flash Organization for Enhanced Small Read Throughput in SSDs}, 
  year={2025},
  volume={24},
  number={2},
  pages={197-200},
  abstract={Emerging data-intensive applications with frequent small random read operations challenge the throughput capabilities of conventional SSD architectures. Although Compute Express Link enabled SSDs allow for fine-grained data access with reduced latency, their read throughput remains limited by legacy block-oriented designs. To address this, we propose ${\sf srNAND}$srNAND, an advanced NAND flash architecture for CXL SSDs. It uses a two-stage ECC decoding mechanism to reduce read amplification, an optimized read command sequence to boost parallelism, and a request merging module to eliminate redundant operations. Our evaluation shows that ${\sf srSSD}$srSSD can improve read throughput by up to 10.4× compared to conventional CXL SSDs.},
  keywords={Flash memories;Error correction codes;Decoding;Bandwidth;Throughput;Sensors;System-on-chip;Data transfer;Parallel processing;Optimization;Compute Express Link;CXL.mem;flash read sequence;NAND flash architecture;partial flash read;SSD;NAND flash memory},
