@INPROCEEDINGS{10502435,
  author={Ancilotto, Alberto and Farella, Elisabetta},
  booktitle={2024 IEEE International Conference on Pervasive Computing and Communications Workshops and other Affiliated Events (PerCom Workshops)}, 
  title={Painting the Starry Night using XiNets}, 
  year={2024},
  volume={},
  number={},
  pages={684-689},
  abstract={Neural style transfer (NST) is a powerful technique that merges the content of one image with the artistic style of another. However, existing NST models often suffer from computational inefficiency, limiting their practical applicability. In this paper, we propose a lightweight NST approach based on XiNets, neural networks especially developed for microcontrollers and embedded applications. Our XiNet-based pipeline achieves an extremely lightweight transfer style mechanism and high-quality stylized outputs, significantly reducing computational complexity. Furthermore, we explore various optimizations and loss functions to optimize network generation performance. The combination of our novel loss factors and an extremely lightweight generative network enables performance comparable to those offered by networks of larger orders of magnitude. Experimental results demonstrate comparable style transfer quality to state-of-the-art approaches while running on embedded devices like a Raspberry Pi 4 single-board computer and an STM32H7 microcontroller. Our lightweight NST framework allows for real-time style transfer applications on resource-constrained devices without compromising visual fidelity.},
  keywords={Performance evaluation;Pervasive computing;Visualization;Microcontrollers;Conferences;Neural networks;Semantics;Neural Style Transfer;Neural Networks;Edge AI;Tiny ML;Hardware-Aware Scaling;Generative Networks},
  doi={10.1109/PerComWorkshops59983.2024.10502435},
  ISSN={2766-8576},
  month={March},}@INPROCEEDINGS{9526781,
  author={Tian, Chenjing and Du, Huadong and Zhou, Zeming and Yang, Pinglv and Zhao, Xiaofeng},
  booktitle={2020 13th International Conference on Intelligent Computation Technology and Automation (ICICTA)}, 
  title={Mesoscale Eddy Detection Based on the Deep Learning Method}, 
  year={2020},
  volume={},
  number={},
  pages={127-130},
  abstract={Mesoscale eddies play an essential role in ocean momentum, energy, heat, and mass transport. Thus, it can also significantly affect the distribution of nutrients, phytoplankton, as well as the shoal of fish. In order to quickly and accurately locate the mesoscale eddies in the ocean, we fused the velocity, divergence, vorticity, and Okubo-Weiss (OW) parameter information with the sea surface height anomalies (SSHA) data, respectively. Then, the feature pyramid network (FPN) in the deep learning method was adopted to extract the eddy position from fused information. The experiment shows that the proposed method can effectively detect the mesoscale eddy locations. Besides, it can also be concluded that, compared with the merged data with velocity and divergence, the FPN performs better on fused data with vorticity and OW information.},
  keywords={Deep learning;Heating systems;Sea surface;Automation;Feature extraction;Fish;Data mining;Mesoscale Eddy Detection;Deep Learning Method;Object Detection;SSHA Data},
  doi={10.1109/ICICTA51737.2020.00035},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11272297,
  author={Dzakpasu, Selorm and Overbye, Thomas J. and Snodgrass, Jonathan M.},
  booktitle={2025 57th North American Power Symposium (NAPS)}, 
  title={Visualization and Analysis of United States Independent System Operator Generator Interconnection Requests}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper explores the process of consolidating interconnection queue data from seven Independent System Operators (ISOs), CAISO, SPP, PJM, ERCOT, ISO-NE, NYISO, and MISO, into a comprehensive and unified database for use in power systems research. The goal is to create a single, large-scale dataset that captures all interconnection requests across these ISOs, facilitating in-depth analysis of trends in generation capacity seeking to connect to the U.S. grid. This unified database enables the visualization of the evolving energy mix within these requests, assesses potential impacts on the US transmission network, and supports informed decision making on future investments in the regions governed by these ISOs. In addition to merging these data sources, this paper details the data cleaning and processing steps necessary to ensure the resulting data set is accurate, reliable, and actionable for stakeholders in grid planning, energy policy, and infrastructure development.},
  keywords={Wind;Wind energy;Data visualization;Market research;Generators;Planning;Visual databases;Stakeholders;Queueing analysis;Investment;Independent System Operators (ISOs);Generator Interconnection Queues;Transmission Planning;Transmission Network Impact;Renewable Energy Integration;Energy Source Trends},
  doi={10.1109/NAPS66256.2025.11272297},
  ISSN={2833-003X},
  month={Oct},}@INPROCEEDINGS{9345152,
  author={Jie, Zhu and Muqing, Wu and Weiyao, Xu},
  booktitle={2020 IEEE 6th International Conference on Computer and Communications (ICCC)}, 
  title={A Two-Pathway Convolutional Neural Network with Temporal Pyramid Network for Action Recognition}, 
  year={2020},
  volume={},
  number={},
  pages={2448-2452},
  abstract={In order to solve the problem of imperfect capture of visual rhythm in action recognition, this paper proposes a novel model which is a combination of a two-pathway network and temporal pyramid networks (TPNs). Specifically, our work involves two aspects, on the one hand, we integrate TPNs into the fast pathway and the slow pathway of SlowFast network to capture multi-level features, and then merge the prediction results of the two pathways in the final recognition stage, which boosts performance of our network by enhancing the semantics extraction at input layer and feature layer. On the other hand, we apply a ConvLSTM module to improve the capability of temporal modeling in TPN, which can further strengthen the capture of features in the long-term dimensions, and the advanced TPN promotes the fusion of temporal and spatial features. Experiments on the Kinetics-400 dataset demonstrate the superiority of our novel architecture combining two-pathway network and advanced TPN in action recognition.},
  keywords={Visualization;Computational modeling;Semantics;Neural networks;Feature extraction;Rhythm;Convolutional neural networks;action recognition;convolutional neural networks;temporal pyramid network;ConvLSTM},
  doi={10.1109/ICCC51575.2020.9345152},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10456252,
  author={Liu, Ya and Yang, Nan and Yao, Shuanglong and Wang, Xing},
  booktitle={2023 5th International Conference on Frontiers Technology of Information and Computer (ICFTIC)}, 
  title={Additive Attention for Medical Visual Question Answering}, 
  year={2023},
  volume={},
  number={},
  pages={932-935},
  abstract={Medical visual question answering is a prominent research area, presenting significant challenges within the domain of visual question answering. In traditional medical visual question answering, the initial step commonly involves employing Convolutional Neural Network (CNN) for image information extraction. Subsequently, bilinear attention mechanisms are employed to merge textual question characteristics with image visual features. However, the method of extracting visual attributes through convolutional neural networks often overlooks the global contextual within the image, which is crucial for answering questions accurately. Consequently, this paper introduces an Additive Attention Network (AANet) to capture comprehensive image information features. Specifically, CNN is employed to obtain local visual features of images, while the additive attention mechanism serves to acquire global contextual features of images. These components complement each other, enhancing the representation of visual features and augmenting the model’s global contextual awareness capability. The proposed method demonstrated superior performance on the VQA-RAD dataset, achieving an overall accuracy of 72.5%, especially for closed questions, achieving an accuracy of 81.9%.},
  keywords={Visualization;Additives;Decision making;Information retrieval;Feature extraction;Question answering (information retrieval);Convolutional neural networks;medical VQA;additive attention;classification},
  doi={10.1109/ICFTIC59930.2023.10456252},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9001799,
  author={Sadiq, Muhammad and Ali, Syed Imran and Bilal Amin, Muhammad and Lee, Sungyoung},
  booktitle={2020 14th International Conference on Ubiquitous Information Management and Communication (IMCOM)}, 
  title={A Vertex Matcher for Entity Resolution on Graphs}, 
  year={2020},
  volume={},
  number={},
  pages={1-4},
  abstract={Entity resolution (ER) is widely studied and a well-defined problem, often used for data management. ER identify and merge the redundant mentions of the same entity across multiple datasets. ER has been addressed with a variety of supervised, unsupervised, and probabilistic approaches to maintain data quality and reliability. ER is crucial and yet very useful for resolving records that refer to the same real-world entity. Traditionally, pairwise comparisons have been used for matching entities across databases, which is a computation-intensive task. Also, these approaches usually do not consider the structural similarity between the records during the comparison. To address these challenges, we proposed a vertex matcher (vMatcher), a graph-based approach that effectively represents the structural similarity between the entities and match entities only in their neighborhood that significantly improve the performance and efficiency. Also, we will learn the threshold value for matching similarity by a subset of training data in a supervised manner.},
  keywords={Erbium;Task analysis;Bipartite graph;Reliability;Electronic commerce;Computer science;Probabilistic logic;entity resolution;bipartite graph matching;data integration;data management;neighborhood matching;vertex matcher},
  doi={10.1109/IMCOM48794.2020.9001799},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{10692256,
  author={Li, Xia and Han, Tao and Fan, Xudong and Zhao, Wei},
  booktitle={2024 2nd International Conference on Algorithm, Image Processing and Machine Vision (AIPMV)}, 
  title={Chinese Traffic Guide Panel Text Detection Based on Pixel Aggregation}, 
  year={2024},
  volume={},
  number={},
  pages={249-252},
  abstract={The detection and recognition of road traffic signs has always been a key research project in the fields of assisted driving and intelligent transportation, which has ignited the enthusiasm of many researchers. However, most methods focus on the study of symbolic traffic signs, the study of detecting and recognizing textual traffic signs is still challenging. In order to realize the efficient and accurate detection of text in Chinese traffic guide panels, a text detection network based on pixel aggregation (PA) is proposed, which can detect text kernels and precisely aggregate their surrounding text pixels using similarity vectors. More specifically, the model neck is composed of one Single-scale Transformer Encoder (STE) and one Cross-scale Feature Fusion Module (CFFM). STE can explore the position-aware feature representation with self-attention mechanism. CFFM is a light-weight U-shaped module, which can merge multi-level information to guide better segmentation. After CFFM, the features from different levels are gathered into a final feature for segmentation. Experimental results on CTST-1600 show that our proposed method outperforms other text detection methods while ensuring real-time performance.},
  keywords={Text detection;Transportation;Object segmentation;Transformers;Feature extraction;Vectors;Road traffic;Real-time systems;Neck;Kernel;Text detection;Segmentation;Transformer},
  doi={10.1109/AIPMV62663.2024.10692256},
  ISSN={},
  month={July},}@INPROCEEDINGS{10989333,
  author={Khayyat, Mashael M.},
  booktitle={2025 4th International Conference on Computing and Information Technology (ICCIT)}, 
  title={The Implementation of Indoor Navigation Using Augmented Reality to Enhance Users Experience (UX)}, 
  year={2025},
  volume={},
  number={},
  pages={643-646},
  abstract={Nowadays, the Global Positioning System (GPS) is used in outdoor environments as a navigation system, but there is still a need for an indoor navigation system. Thus, this paper describes a proposed application that uses the augmented reality (AR) navigation system and creates a virtual character as guidance in a real-world view. The focus is on how the user can follow a virtual character to reach the desired indoor destination. The proposed method supports indoor and outdoor environments using a computer vision system to identify places. The application uses AR to render points of interest and navigation paths in the camera view. It has been found that AR provides a unique user interface for mobile applications that create human-computer interaction (HCI); therefore, smartphones are starting to embrace this HCI. The merge of AR, computer vision, and navigation technology will provide opportunities to adopt and develop new felids to create a new user experience. Navigation has been integrated with AR to enhance navigation usage. Besides that, adding a virtual character improved the user experience. As a result of using the proposed application, users reached their destinations interactively and enjoyably.},
  keywords={Human computer interaction;Computer vision;Indoor navigation;Solids;User experience;Mobile applications;Information technology;Augmented reality;Smart phones;Global Positioning System;Indoor Navigation;Augmented Reality;user experience (UX);GPS;computer vision system;human-computer interaction (HCI)},
  doi={10.1109/ICCIT63348.2025.10989333},
  ISSN={},
  month={April},}@INPROCEEDINGS{10641879,
  author={Zhu, Renke and Xiong, Mingkang and Zhang, Tao and Wei, Feiming and Quan, Sinong and Yu, Wenxian},
  booktitle={IGARSS 2024 - 2024 IEEE International Geoscience and Remote Sensing Symposium}, 
  title={An Approach for Integrating SAR Imagery in Sea-Land Segmentation and Coastline Detection}, 
  year={2024},
  volume={},
  number={},
  pages={9525-9529},
  abstract={Segmentation of Synthetic Aperture Radar (SAR) imagery constitutes the cornerstone of SAR image analysis, with sea-land segmentation in SAR images playing a crucial role in determining the precision of subsequent sea surface target detection. This study introduces an integrated approach for sea-land segmentation and coastline detection in SAR imagery, aiming to overcome the limitations posed by the traditional separation of these two tasks. In essence, the proposed method merges a segmentation module and an edge detection module, employing a hollow convolution and a global context mechanism. Additionally, the approach utilizes a cross-entropy loss function incorporating multiple losses with adaptive weighting, thereby enhancing the richness of the extracted feature information. To validate the algorithm’s efficacy, a specialized dataset for sea-land segmentation and coastline detection is constructed, utilizing the GRD data format from the Sentinel-1 satellite. Experimental outcomes show that the presented algorithm achieves scores of 0.988 and 0.981 on the Intersection over Union (IOU) metrics for sea-land segmentation, and 0.569 and 0.401 on the Optimal Dataset Scale (ODS) F1 and ODS IOU metrics for coastline detection.},
  keywords={Measurement;Image segmentation;Coastlines;Satellites;Image edge detection;Sentinel-1;Feature extraction;Synthetic aperture radar (SAR);Sea-land segmentation;Coastline detection},
  doi={10.1109/IGARSS53475.2024.10641879},
  ISSN={2153-7003},
  month={July},}@INPROCEEDINGS{11499512,
  author={V P, Tamil Selvan and S, Vignesh and Rajamanickam, Siranjeevi and Palani, Balasubramanian},
  booktitle={2026 International Conference on Innovative Trends in Information Technology (ICITIIT)}, 
  title={AI-Generated Fake News Detection Using a Multimodal Approach on the MiRAGeNews Dataset}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={As social platforms evolve and AI-generated visuals become very common, the risk of fake news spreading increases, impacting public opinion and sentiments. Most of the current fake news detection methods relying solely on text overlook important visual cues, which can also be manipulated using AI. In this work, a multimodal fake news detection approach using the MiRAGeNews dataset is introduced that integrates both textual and visual features through advanced deep learning techniques. Social media now spreads stories faster than ever, and AI can create lifelike pictures and convincing captions that fool people in seconds. To fight this, an AI-generated fake news detector is built that checks words and images together. The model is trained on the MiRAGeNews set of $\mathbf{1 2, 0 0 0}$ posts made from real news and AI-made look-alike photos from Midjourney and captions written by GPT-4. The model tries three ways to mix what it reads and sees: a simple merge, Concatenation layer on RoBERTa + ViT acheives 0.985 accuracy that lets text and picture features interact, and a deeper bilinear blend. In every test, using both text and images worked better than using only one, helping to catch fake news more often. This tool aims to help people spot AIgenerated fake news and to keep public news and conversations honest.},
  keywords={Feeds;Antennas;Protocols;LoRa;Pixel;HTTP;Communication systems;Internet;Data communication;Radio access networks;Fake news detection;multimodal;RoBERTa;Vision Transformer (ViT);deep learning},
  doi={10.1109/ICITIIT68860.2026.11499512},
  ISSN={},
  month={March},}@INPROCEEDINGS{11368025,
  author={B, Dharun Pranaav K and Sosale, Eshaan and D’costa, Jaikumar Emannuel and Ugarakhod, Rashmi},
  booktitle={2025 IEEE 17th International Conference on Computational Intelligence and Communication Networks (CICN)}, 
  title={Image Captioning Using Xception and LSTM with Refinement and Beam Search for Accuracy Improvement}, 
  year={2025},
  volume={},
  number={},
  pages={1444-1448},
  abstract={Generating image captions is a very important task in the field of AI. The rise of deep learning methods has driven the development of advanced models that merge image feature extraction with natural language processing, enabling systems to generate captions that are both coherent and meaningful. Image captioning requires identifying key objects, understanding their relationships, and creating a description that flows naturally, with proper grammar. Our approach uses a convolutional neural network (CNN) for extracting visual features and a long short-term memory (LSTM) network for generating natural language captions. The model is trained and evaluated on the Flickr8k dataset. Additionally, beam search and T5 refinement have been included to enhance fluency and coherence.},
  keywords={Training;Visualization;Adaptation models;Accuracy;Computational modeling;Feature extraction;Convolutional neural networks;Long short term memory;Context modeling;Videos;Image Captioning;CNN;Xception;LSTM;Beam search},
  doi={10.1109/CICN67655.2025.11368025},
  ISSN={2472-7555},
  month={Dec},}@INPROCEEDINGS{10674916,
  author={Roychoudhury, Srimanti and Shariar, Jabed and Alam, Rahimul},
  booktitle={2024 IEEE International Conference on Smart Power Control and Renewable Energy (ICSPCRE)}, 
  title={Analyzing Fractional Order Systems of RLβCα Circuits: An HF-Based Efficient Approach}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The use of fractional calculus in dynamical system modeling and control has grown in popularity. When modeling real-world electrical circuits and systems, standard integer ordering cannot precisely take place. All systems in reality point to equations with fractional or non-integer orders. The modeling and analysis of fractional-order real-life systems can be somewhat challenging if the typical assumptions that simplify system modeling are not taken into account. To handle fractional order systems, like RCα, RLβ, and combinational RLβCα circuits, a sample-based digitally compatible technique is presented in this paper. The proposed approach has used an orthogonal hybrid function (HF) set that is linearly merged with the SHF and TF sets. This work introduces and examines a few predominant fractional-order electrical systems, goes to great lengths to explain how the problem was addressed, and demonstrates the effectiveness of the recommended solution. To validate and demonstrate the effectiveness of the proposed method, a few numerical examples are provided along with relevant graphs and tables, and the results are compared with the exact answer.},
  keywords={Hafnium;Mathematical models;Circuits;Integrated circuit modeling;DH-HEMTs;Systems modeling;Nonhomogeneous media;Fractional order circuits;Fractional order differential equation;Integration operational matrices;Orthogonal hybrid function;Fractional circuit analysis},
  doi={10.1109/ICSPCRE62303.2024.10674916},
  ISSN={},
  month={July},}@INPROCEEDINGS{10331515,
  author={Yin, Yiqun and Mou, Qianying},
  booktitle={2023 International Conference on Power System Technology (PowerCon)}, 
  title={Eigen-Analysis Consistency of Two Discrete State Space Forms for Typical RLC Electric Circuits}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={With the proposal of the carbon peaking and carbon neutrality, high proportion of new energy sources and power electronic devices are more and more integrated into power systems. In this situation, a series of oscillation problems have been triggered. Eigenvalue analysis is one of effective methods for studying oscillations in power systems. However, for eigenvalue analysis based on continuous state space, the modeling may become complex when topology changes. In this paper, two discrete state space forms are built for typical RLC electric circuits. One is modeled by separate RLC element, and the other is implemented by merged RL and RC models. Subsequently, four typical circuits are selected to verify the consistency, by comparing actual eigenvalues derived from two discrete forms.},
  keywords={Computational modeling;RLC circuits;Power system stability;Systems modeling;Eigenvalues and eigenfunctions;Stability analysis;Topology;discrete state space;historical current term;RC;RL;RLC;trapezoidal integration method},
  doi={10.1109/PowerCon58120.2023.10331515},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10900497,
  author={Xie, Zhibin and Chen, Jingteng and Zheng, Xianghan and Xie, Weipeng and Huang, Yiwei and Wang, Huang and Li, Yunliang},
  booktitle={2024 Fourth International Conference on Digital Data Processing (DDP)}, 
  title={Early Warning Method for Road Construction Based on Natural Language Processing}, 
  year={2024},
  volume={},
  number={},
  pages={152-155},
  abstract={In advancing smart city construction, the real-time and accurate extraction of road construction information has become crucial for urban traffic management and power grid maintenance. Traditional methods, which rely on manual reporting and government announcements for information gathering, are time-consuming and inefficient. This paper proposes integrating data mining and natural language processing (NLP) technologies to merge multi-source heterogeneous road construction information to predict the risks associated with power grid lines. Using advanced NLP techniques and pre-trained models, key information such as construction sites, timings, and reasons are effectively extracted from the collected data, providing an efficient solution for proactive construction risk management.},
  keywords={Smart cities;Roads;Manuals;Natural language processing;Power grids;Real-time systems;Timing;Maintenance;Data mining;Risk management;NLP;Road Construction;Risk Prediction},
  doi={10.1109/DDP64453.2024.00037},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10131792,
  author={Singh, Kriti Bhaswar and Singh, S. K. and Patil, Deepak Tulsiram},
  booktitle={2023 International Conference on Computational Intelligence and Knowledge Economy (ICCIKE)}, 
  title={Post-Merger & Acquisition Financial Performance of Selected Indian Firms}, 
  year={2023},
  volume={},
  number={},
  pages={495-498},
  abstract={As a business restructuring tactic, mergers and acquisitions (M&A), has significantly drawn attention of practitioners as well as researchers around the world. Firms across different economies including the Indian firms have invested billions in M&A activities. Whilst corporate M&A are widely believed of as the primary method for growth and expansion, related research have shown that M&A can occur for a variety of other reasons. The majority of these studies have a market-based (also known as a stock market-based) approach and are accounting-based. In this research, we aim to determine if Indian mergers have been successful. Samples of twelve companies have been selected for the purpose of the study. We used average financial ratio data from the three years before (Pre-merger) and three years after (Post-merger) the merger to compare and test for differences using a paired "t" test. We conclude that profitability ratios have increased during the post-merger period compared to the pre-merger period. Further, solvency of the merged companies has deteriorated after mergers due to greater reliance on debt for financing merger deals.},
  keywords={Corporate acquisitions;Profitability;Finance;Companies;Computational intelligence;Business;Mergers and Acquisition;Financial performance;Post-merger integration;Synergy;Corporate restructuring},
  doi={10.1109/ICCIKE58312.2023.10131792},
  ISSN={},
  month={March},}@INPROCEEDINGS{9441774,
  author={Chaudhari, Chaitrali Prasanna and Devane, Satish},
  booktitle={2021 7th International Conference on Advanced Computing and Communication Systems (ICACCS)}, 
  title={Evaluating Precision and Context in Image Captions}, 
  year={2021},
  volume={1},
  number={},
  pages={1592-1595},
  abstract={Captioning images is the process of generating the image description in a textual format that has wide applications in various domains. The research in this area is ongoing and seeking increasing attention as it merges the fields of computer vision and natural language processing. In the presented work, an image caption generation model consisting of a probabilistic and neural framework is built following an encoder-decoder scheme. The image is inputted to the deep learning classifier called Convolutional Neural Network (CNN) and to generate a set of sentences, a Long-Short Term Memory (LSTM) model is used. The captions generated by the proposed captioning model are compared over the other conventional models with respect to statistical analysis using standard and popular similarity metrics called Cosine Similarity, Precision and Recall. The results of evaluation of the predicted image captions compared to the actual captions are presented and the applicability of evaluation methods in context of image captioning is discussed and justified.},
  keywords={Measurement;Deep learning;Analytical models;Computer vision;Statistical analysis;Computational modeling;Probabilistic logic;Image captioning;CNN;LSTM;Evaluation;Cosine Similarity;Precision;Recall},
  doi={10.1109/ICACCS51430.2021.9441774},
  ISSN={2575-7288},
  month={March},}@INPROCEEDINGS{9667563,
  author={Sinha, Leena and Nirmala, S Jaya},
  booktitle={2021 IEEE 8th Uttar Pradesh Section International Conference on Electrical, Electronics and Computer Engineering (UPCON)}, 
  title={Combining Document Embedding Techniques for Clustering and Analysis of Extractive Summaries}, 
  year={2021},
  volume={},
  number={},
  pages={1-7},
  abstract={In today’s fast-paced world, where we are flooded with massive amounts of unstructured and written data every second, a streamlined approach to make these documents readable is required. We need to cluster these documents in such a way that documents with comparable contexts and categories are automatically grouped. Therefore, it is of interest to understand and study how various algorithms in existence merge together to provide us with a suitable approach to group subjects of similar nature. This work aims at stacking different algorithms to propose an alignment to find out which stack works best for the given use case. Here documents of different categories have been utilized, which undergoes different embedding techniques along with dimensionality reduction, which are later clustered using k-means clustering, to compare which stack works best. The dataset contains news article from five different categories namely entertainment, sports, business, politics, and technology. We can observe how well the different embedding algorithms preserve semanticity and context of the given document. The performance of different stacks in each category of the documents has been analyzed using clustering and the best results have been observed from TF-IDF and word2vec embeddings.},
  keywords={Manifolds;Dimensionality reduction;Conferences;Bibliographies;Bit error rate;Stacking;Clustering algorithms;Clustering;Embedding;TF-IDF;Word2vec;Dimensionality Reduction},
  doi={10.1109/UPCON52273.2021.9667563},
  ISSN={2687-7767},
  month={Nov},}@INPROCEEDINGS{11463976,
  author={Taveras, Carlos A. and Segarra, Santiago and Uribe, César A.},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Gromov-Wasserstein Graph Coarsening}, 
  year={2026},
  volume={},
  number={},
  pages={646-650},
  abstract={We study graph coarsening in the Gromov-Wasserstein geometry. Specifically, we propose two algorithms that leverage a novel representation of the distortion induced by merging pairs of nodes. The first method, Greedy Pair Coarsening (GPC), iteratively merges pairs of nodes that locally minimize a distortion measure until the desired size is reached. The second method, termed k-means Greedy Pair Coarsening (KGPC), leverages clustering based on pairwise distortion metrics to directly merge node clusters. We provide conditions that guarantee optimal coarsening for our methods and validate their performance across six large-scale datasets and a downstream clustering task. Results show that the proposed methods outperform existing approaches on a wide range of parameters and scenarios.},
  keywords={Circuits;Protocols;HTTP;Regional area networks;Wireless communication;Radio access networks;Communication systems;Radio frequency;Graph neural networks;Machine learning;Graphs;Coarsening;Gromov-Wasserstein},
  doi={10.1109/ICASSP55912.2026.11463976},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{10220773,
  author={V, Soundari D. and G, Rabin and S, Rishiyugan and P, Pravinkumar},
  booktitle={2023 5th International Conference on Inventive Research in Computing Applications (ICIRCA)}, 
  title={Image Processing For LDR To HDR Image Conversion Using Deep Learning}, 
  year={2023},
  volume={},
  number={},
  pages={146-150},
  abstract={High Dynamic Range images and High Dynamic Range displays are getting popular nowadays. To attain the benefit of the High Dynamic Range, a lot of Low Dynamic Range images are to be converted to images with better ranges. Due to the reflection, the image may lose its visibility in some specific area and such area is called a highlight. The information will not be clear for the areas in highlight. The highlight should be removed in order to increase the image's visibility. It is not easy to obtain an image having dynamic range at high level for most of the people as it requires a pricey tool which can be used to function beyond the parameters that are present in the sensor technology of the conventional camera. Many low dynamic range images are combined to create a single HDR image. In the existing system the bright regions are brightened and the dark regions are darkened and the ranges with the extended brightness are merged in order to construct an image with High Dynamic Range. For Example, while capturing a crime scene in the camera with certain details that are absent in the image captured, the criminal investigation could be handled better by reconstructing the lost details of the image using this strategy. The exposure of the image is increased along with the brightness of the pixels that are highly dense and the output image is constructed with the properties necessary for a HDR image.},
  keywords={Deep learning;Brightness;Cameras;Reflection;High dynamic range;Image reconstruction;High Dynamic Range image;Low Dynamic Range image;Deep Learning;Log exposure;Radiance mapping;Pixel value},
  doi={10.1109/ICIRCA57980.2023.10220773},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{9421957,
  author={Wei, Wang and Xiaolin, Li and Yao, Luo},
  booktitle={2020 2nd International Conference on Information Technology and Computer Application (ITCA)}, 
  title={News text classification based on attention mechanism}, 
  year={2020},
  volume={},
  number={},
  pages={462-466},
  abstract={News text is often divided into two parts: title and content. In the research of news text classification, many studies have not considered the characteristics of news text classification. It is unscientific to merge the title and content as input hastily. The title is of great value to news text, and its importance is ignored in text classification, which has a certain impact on the classification effect. Aiming at this problem, this article designs a word vector weighting method based on attention mechanism, and builds a bidirectional long short memory neural network (BiLSTM) model for text classification. The experimental results show that BiLSTM news text classification with the introduction of attention mechanism improves the classification effect.},
  keywords={Training;Databases;Design methodology;Computational modeling;Text categorization;Neural networks;Memory management;Text classification;attention mechanism;long and short memory neural network;convolutional neural network},
  doi={10.1109/ITCA52113.2020.00103},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10348781,
  author={Streckert, Tim and Fromme, Dominik and Kaupenjohann, Matti and Thiem, Jörg},
  booktitle={2023 IEEE 12th International Conference on Intelligent Data Acquisition and Advanced Computing Systems: Technology and Applications (IDAACS)}, 
  title={Using Synthetic Data to Increase the Generalization of a CNN for Surgical Instrument Segmentation}, 
  year={2023},
  volume={1},
  number={},
  pages={336-340},
  abstract={Surgical instrument segmentation is a key step in robot assisted minimally invasive surgery and can enable other applications such as augmented reality. However, accurate instrument segmentation is still challenging due to the complex environment. With the growth of deep learning, the results have improved significantly. However, due to small data sets, the generalization of the trained networks needs to be improved, as the results drop significantly when applied to new, unseen data. To increase the generalization of a CNN for instrument segmentation, a synthetic data set is created for further training. The data set is created with images of surgical instruments in front of a green screen and background images of surgical procedures that do not contain any instruments. In addition to the background images from real procedures, a GAN is trained to generate more background images. The instruments are merged with the background using three different blending functions. A total of 15,000 new images are generated. Two models are trained, model 1 with the EndoVis17 data set and model 2 with the EndoVis17 and the synthetic data set. The models are based on the SegNet architecture with pretrained parameters and differ only in the training data used. Both models achieve a mIoU above 90% on the EndoVis17 test data. Additionally, both models are tested on the EndoVis15 data set, which provides a new environment compared to the training data. model 1 achieves a mIoU of 56.75% and model 2 of 76.15%. The additional training with the synthetic data set has improved the generalization of the CNN by about 20 percentage points on the new unseen data.},
  keywords={Training;Deep learning;Minimally invasive surgery;Instruments;Robot kinematics;Training data;Data models;surgical instrument segmentation;deep learning;generalization;robot assisted surgery;simulation},
  doi={10.1109/IDAACS58523.2023.10348781},
  ISSN={2770-4254},
  month={Sep.},}@BOOK{11435031,
  author={Balbus, Steven A.},
  booktitle={An Introduction to General Relativity and Cosmology: Theory, Observations, and Applications},
  year={2026},
  volume={},
  number={},
  pages={},
  abstract={An engaging and authoritative introduction to general relativity and cosmology for graduate students and advanced undergraduatesGeneral relativity has entered a new phase of its development as technical advances have led to the direct detection of gravitational radiation from the merging of single pairs of stellar-sized black holes. The exquisite sensitivity of pulsar signal timing measurements has also been exploited to reveal the presence of a background of gravitational waves, most likely arising from the mergers of supermassive black holes thought to be present at the center of most galaxies. This book demonstrates how general relativity is central to understanding these and other observations while explaining the role of relativity in modern cosmology. An Introduction to General Relativity and Cosmology is an essential entrée to the subject, combining full discussions of underlying principles with detailed derivations as well as an accessible treatment of the mathematical foundations of singularity theorems and more advanced topics.Combines rigor with a conversational, highly pedagogical approachEmphasizes connections with other areas of physics to sharpen intuition while emphasizing general relativity’s unique contributions to modern theoretical physicsPresents a novel derivation of the energy flux of gravitational wavesProvides detailed and explicit derivations of important results, including binary star evolution by gravitational radiation lossesFeatures a detailed treatment of the Hellings-Downs formula, key to understanding pulsar timing array results for gravitational radiationProvides a reexamination of the equivalence principle for relativistic particlesPresents new results on the mathematical solutions of the innermost orbits of the gaseous disks that surround black holesIncludes a wealth of exercisesSolutions manual (available only to instructors)},
  keywords={Angular;Binary;Calculation;Circular;Classical;Components;Constant;Coordinates;Cosmological;Covariant;Covariant derivative;Curvature;Density;Derivatives;Dimensional;Divergence;Dwarf;Einstein;Energy;Equation;Equilibrium;Euclidean;Event horizon;Expansion;Expression;Factor;Field;Final;Finite;Flat;Frame;Frequency;Function;Galaxies;Gauge;Geodesic;Geometry;Gravitational;Gravity;Hole;Horizon;Indices;Inertial;Integral;Integration;Invariant;Kerr;Limit;Linear;Lorentz;Mass;Mathematical;Metric;Minkowski;Momentum;Motion;Neutron;Newtonian;Notation;Orbit;Orbital;Partial derivatives;Particle;Photon;Physics;Plane;Pressure;Proportional;Pulsar;Quantity},
  doi={},
