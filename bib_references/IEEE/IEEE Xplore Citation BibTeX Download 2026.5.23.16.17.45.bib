  booktitle={2024 54th European Microwave Conference (EuMC)}, 
  title={A 19-32.8 GHz Low Power Down-Conversion Mixer with 8.2 dBm IP1dB for 5G Communication}, 
  year={2024},
  volume={},
  number={},
  pages={51-54},
  abstract={This paper presents a 19-32.8 GHz high linearity and low power down-conversion mixer for 5G communications. To improve the linearity, the proposed mixer addresses the nonlinearity from RF and IF domains, which correspond to the transconductance (gm) stage and the IF buffer stage. A passive transformer is utilized as the gm stage, which enormously benefits to the linearity and wideband RF impedance matching. The IF buffer stage consists of a common-gate (CG) path and a cascode path to enhance the IF linearity. Furthermore, a current-reuse technique merging the IF stage with the mixer core is introduced to reduce the power consumption. Fabricated in a 65-nm SOI process, the mixer realizes a peak gain of -0.5 dB at 25.4 GHz with a 3-dB RF bandwidth of 13.8 GHz from 19 to 32.8 GHz. The measured 3-dB IF bandwidth is from 3.2 to 8 GHz. With the dc power of 15.2 mW, the mixer achieves an extremely high input 1-dB compression point (IP1dB) of 8.2 dBm at 25.4 GHz, which can support the 5G millimeter wave (mmWave) massive phase-array system.},
  keywords={Radio frequency;Power demand;5G mobile communication;Impedance matching;Linearity;Transformer cores;Transformers;Millimeter wave communication;Mixers;Wideband;Linearity;low power;mixer;down-conversion;5G;mmWave},
  doi={10.23919/EuMC61614.2024.10732638},
  ISSN={},
  month={Sep.},}@ARTICLE{10858001,
  author={Wu, You and Qian, Xuehai},
  journal={IEEE Transactions on Dependable and Secure Computing}, 
  title={Low-Overhead Reversible Coherence Protocol}, 
  year={2025},
  volume={22},
  number={4},
  pages={3647-3660},
  abstract={This paper proposes RCP, a new reversible coherence protocol that ensures invisible speculative load execution (ISLE) with low overhead. The protocol is designed by systematically extending the existing coherence protocol to incorporate speculative loads and states. Instead of considering the protocol as a black-box and adding external structures or applying patches in previous work, the protocol modifications overcome the key drawbacks in recent schemes that contribute to unnecessary overhead. RCP can be combined with processor mechanisms highlighted in recent work that eliminate the effects of speculative instructions on other instructions to comprehensively protection against speculative execution attacks (a.k.a. ideal invisible speculation or IIS), as strong as speculative taint tracking (STT). The protocol is implemented in Gem5 and verified with Murphi. The results show that, RCP only incurs average overhead of 7.7% and 7.4% for SPEC2017 and PARSEC, respectively. In comparison, MuonTrap, the existing solution with the lowest overhead, incurs 10.7% and 9.3% on average for the two with the same hardware resource. When used as a component for the comprehensive protection, the design based on RCP reduces the overhead of STT by 1.59× (8.4% vs 22.5%).},
  keywords={Protocols;Coherence;Protection;Interference;Privacy;Microarchitecture;Load modeling;Delays;Codes;Transmitters;Hardware security;microarchitecture;coherence protocol;side channel},
  doi={10.1109/TDSC.2025.3535374},
  ISSN={1941-0018},
  month={July},}@INPROCEEDINGS{10773616,
  author={Kılıç, Yasir and Kılıç, Vahide Nida and İnan, Ali},
  booktitle={2024 9th International Conference on Computer Science and Engineering (UBMK)}, 
  title={White-Box Style Intrusion Detection System Integration into Industrial Metaverses}, 
  year={2024},
  volume={},
  number={},
  pages={737-742},
  abstract={The Metaverse is an expansive digital realm that merges enhanced physical reality with persistent virtual spaces, encompassing virtual worlds, augmented reality, and the Internet. Its popularity is driven by its ability to offer immersive expe-riences and interactive environments that transcend traditional digital interactions. Within this broad concept, the Industrial Metaverse is particularly significant as it revolutionizes industrial processes through real-time data integration, predictive main-tenance, and advanced simulations, thereby boosting efficiency, reducing costs, and fostering innovation in manufacturing and supply chain management. However, the reliance on Industrial Internet of Things (IIoT) devices introduces significant cyber threats, as these devices often have minimal security measures and can serve as entry points for attackers. Therefore, the security of the Industrial Metaverse is crucial, requiring sophisticated protection mechanisms to safeguard against these evolving cyber threats and ensure the integrity of industrial operations. Furthermore, the transparency of these protection systems is vital for the effective reporting and managing of such attacks. To address the specific security needs of the Industrial Metaverse environment, a White-Box style Intrusion Detection System (IDS) model has been introduced, integrated into the Metaverse through the use of avatars. This model gives promising result as F1-micro of 0.95, reaching the performance of the best existing black-box model in the literature. Additionally, the effectiveness of the developed IDS model is also evaluated by detailed experiments, which not only validate its high accuracy but also underscore its potential to enhance security within complex industrial environments. These comprehensive experiments indicate that the proposed solution could be effective for the cybersecurity of the Industrial Metaverse environment.},
  keywords={Technological innovation;Accuracy;Metaverse;Intrusion detection;Closed box;System integration;Data models;Protection;Glass box;Industrial Internet of Things;Cyber Security;Industrial Metaverse(IM);Intrusion Detection System(IDS);Industrial Internet of Things(IIOT);Explainable AI(xAI)},
  doi={10.1109/UBMK63289.2024.10773616},
  ISSN={2521-1641},
  month={Oct},}@ARTICLE{9749834,
  author={Zhou, Wujie and Dong, Shaohua and Lei, Jingsheng and Yu, Lu},
  journal={IEEE Transactions on Intelligent Vehicles}, 
  title={MTANet: Multitask-Aware Network With Hierarchical Multimodal Fusion for RGB-T Urban Scene Understanding}, 
  year={2023},
  volume={8},
  number={1},
  pages={48-58},
  abstract={Understanding urban scenes is a fundamental ability requirement for assisted driving and autonomous vehicles. Most of the available urban scene understanding methods use red-green-blue (RGB) images; however, their segmentation performances are prone to degradation under adverse lighting conditions. Recently, many effective artificial neural networks have been presented for urban scene understanding and have shown that incorporating RGB and thermal (RGB-T) images can improve segmentation accuracy even under unsatisfactory lighting conditions. However, the potential of multimodal feature fusion has not been fully exploited because operations such as simply concatenating the RGB and thermal features or averaging their maps have been adopted. To improve the fusion of multimodal features and the segmentation accuracy, we propose a multitask-aware network (MTANet) with hierarchical multimodal fusion (multiscale fusion strategy) for RGB-T urban scene understanding. We developed a hierarchical multimodal fusion module to enhance feature fusion and built a high-level semantic module to extract semantic information for merging with coarse features at various abstraction levels. Using the multilevel fusion module, we exploited low-, mid-, and high-level fusion to improve segmentation accuracy. The multitask module uses boundary, binary, and semantic supervision to optimize the MTANet parameters. Extensive experiments were performed on two benchmark RGB-T datasets to verify the improved performance of the proposed MTANet compared with state-of-the-art methods.1},
  keywords={Semantics;Thermal sensors;Feature extraction;Decoding;Image segmentation;Lighting;Visualization;RGB-T data;urban scene understanding;hierarchical multimodal fusion;high-level semantic information;multilevel fusion;multiple supervision},
  doi={10.1109/TIV.2022.3164899},
