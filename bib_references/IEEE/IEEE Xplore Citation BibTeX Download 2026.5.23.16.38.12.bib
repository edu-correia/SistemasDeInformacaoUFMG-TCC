@INPROCEEDINGS{11291270,
  author={Kongara, Naga Nirmala and Krishna, Bhukya and Sujatha, B.},
  booktitle={2025 Third International Conference on Cyber Physical Systems, Power Electronics and Electric Vehicles (ICPEEV)}, 
  title={Hybrid AI Framework for Accurate Diagnostics: Merging Deep Learning with Rule-Based and Explainable Techniques Across Imaging Modalities}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a robust hybrid artificial intelligence (AI) framework designed to improve diagnostic accuracy in medical imaging tests such as magnetic resonance imaging (MRI), computed tomography (CT), and positron emission tomography (PET) scans. The enhancement is achieved by combining deep learning methods with rule-based reasoning and model-agnostic explainability techniques. The proposed hybrid architecture integrates convolutional neural networks (CNNs) and transformer models for feature extraction, while incorporating expert-defined rule-based logic to strengthen interpretability and ensure consistency in decision-making. To improve transparency, model-agnostic explainability approaches such as SHAP (Shapley Additive Explanations) and LIME (Local Interpretable Model-Agnostic Explanations) are applied, offering deeper insights into AI-driven diagnoses. This integration addresses critical clinical concerns related to trust, traceability, and adoption of AI systems. Experimental evaluations conducted on benchmark medical imaging datasets achieved an accuracy of 94.2%, which is 3.8% higher than conventional deep learning approaches, demonstrating improved robustness. Additionally, the proposed system enhances clinical interpretability, with a 21% increase in explainability ratings provided by healthcare professionals. These findings highlight the novelty and clinical relevance of hybrid AI models by combining automation with decision support, thereby promoting greater trust and adoption of AI in diagnostic workflows across healthcare facilities.},
  keywords={Deep learning;Accuracy;Computational modeling;Magnetic resonance imaging;Computed tomography;Medical services;Transformers;Artificial intelligence;Positron emission tomography;Biomedical imaging;Hybrid AI;Deep Learning;Explainability Techniques;Medical Imaging;CNN;Transformer Architecture;Rule-Based Systems;Diagnostic Accuracy},
  doi={10.1109/ICPEEV67897.2025.11291270},
  ISSN={},
  month={Sep.},}@ARTICLE{11203875,
  author={Zhang, Pengyi and Ma, Pengxuan and Guo, Chaopeng and Gu, Yu and Song, Jie},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={Consensus and Computing Integration for Processing Transactional Graphs in Consortium Blockchain}, 
  year={2026},
  volume={38},
  number={1},
  pages={152-169},
  abstract={Recent research and practical scenarios demonstrate that integrating transaction-based graph computing into blockchain has become a critical focus in consortium networks. The on-chain Transactional Graph Processing Applications (TGPAs) have become popular in the blockchain. TGPA leverages blockchain consensus mechanisms to prevent malicious peer attacks while utilizing graph computing to enable powerful analytical capabilities. However, a fundamental challenge exists: blockchain operates on a computation-before-consensus principle, while graph computing requires intermediate result-sharing based on mutual trust. This isolation between the two mechanisms fails to ensure both computational trustworthiness and consensus efficiency. Thus, TGPA necessitates an integrated solution combining consensus and graph computing. Besides, the trusted high-communication environment of graph computing conflicts with the untrusted high-communication environment of blockchain. Communication efficiency and data trustworthiness are existing challenges of the solution. This paper presents a Graph partitioning-based Byzantine Fault Tolerance ($\mathsf {GBFT}$GBFT) mechanism for the computing-consensus integration. $\mathsf {GBFT}$GBFT integrates graph computing’s shuffling and merging phases with the consensus phase to achieve parallel computation and synchronized consensus. Additionally, $\mathsf {GBFT}$GBFT incorporates a grouping-partitioning strategy and granular communication methods to enhance both trustworthiness and efficiency. Theoretical analysis proves that $\mathsf {GBFT}$GBFT reduces communication and latency complexity to $O(x)$O(x) ($x$x represents the number of peers). Experimental evaluations demonstrate that $\mathsf {GBFT}$GBFT achieves superior consensus capacity, graph computing capacity, and communication scalability performance. It also supports various graph algorithms across different data scales.},
  keywords={Peer-to-peer computing;Consensus protocol;Sharding;Parallel processing;Synchronization;Real-time systems;Security;Scalability;Consensus algorithm;Throughput;Blockchain;graph computing;consensus;grouping;partitioning},
  doi={10.1109/TKDE.2025.3621621},
  ISSN={1558-2191},
  month={Jan},}@INBOOK{10896543,
  author={Khan, Burhan and Mir, Aabid A. and Almutairi, Naser S. and Goh, Khang W.},
  booktitle={IoT for Smart Grid: Revolutionizing Electrical Engineering: Revolutionizing Electrical Engineering}, 
  title={Transactive IoT: Merging Transactions and Connectivity}, 
  year={2025},
  volume={},
  number={},
  pages={63-85},
  abstract={Summary <p>Modern energy management has experienced a paradigm shift by incorporating the Internet of Things (IoT) into smart grids. This incorporation serves as a foundational step toward realizing transactive energy systems (TESs), where dynamic and efficient energy management is facilitated by IoT&#x2010;enabled real&#x2010;time data collection and processing. Due to IoT&#x2010;enabled dynamic energy management, modern economic and market&#x2010;based models are triggered. These models include dynamic pricing and demand response (DR) management. Energy demand fluctuations in such models are addressed intelligently, besides the integration of renewable energy resources. The significance of transactive IoT in modern applications has been discussed extensively in this chapter. Special focus is placed on resource allocation, optimization, and grid reliability. The architecture of transactive IoT systems is discussed. The software layer of a transactive IoT system contains network administration, data analysis, and security, and the physical layer contains hardware components such as IoT devices and sensors and actuators. These components constitute a comprehensive framework for a robust, secure, and reliable energy management system. This model facilitates a proactive energy management approach where the participation of energy service providers and consumers is essential. Incorporating these approaches with technology will lead to a sustainable, clean, and economically viable energy future. This chapter presents an in&#x2010;depth overview of how transactive IoT has played a transformative role in smart grid systems and provides solutions to the challenges faced by the modern energy landscape.</p>},
  keywords={Real-time systems;Internet of Things;Electricity;Smart grids;Pricing;Energy consumption;Automation;Turning;Time measurement;Thermostats},
  doi={10.1002/9781394279401.ch4},
  ISSN={},
  publisher={IEEE},
  isbn={9781394279395},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10896543},}@INPROCEEDINGS{10489570,
  author={Kaushik, Prashant and Saxena, Vikas and Prajapati, Amarjeet},
  booktitle={2024 2nd International Conference on Disruptive Technologies (ICDT)}, 
  title={A Novel Method for Sequence Generation for Video Captioning by Estimating the Objects Motion in Temporal Domain}, 
  year={2024},
  volume={},
  number={},
  pages={1510-1514},
  abstract={For disruption in video based ai tasks, we need better understanding of features and their sequences. Sequence generation for video captioning has been a tedious task for better and relevant feature mapping for tasks like mapping to objects or text generation. It has gone from sequence to selective sequence, merged sequences, then reweighted sequence based on sematic positions of objects in video. Mostly the sequence is objects position detected in frames & aligned as sequence and merged sequence in based on some event. This paper is estimating the relative motion of object as path. These paths are merged to generate a path of group of objects, and converted to sequence in temporal domain. This way generating the sequence which are better and semantically similar to the ground truth of the text of video for object-oriented video captioning datasets. To prove the workability of methods, some synthetic videos with few objects and background blurring with GMM is used. Lastly, we have calculated and shown the similarity of the generated sequence to the ground truth of the video, and compared it with the sequence generated by the earlier methods of the sequence generation with various features. The comparison of the sequence is done on 4 kinds of videos like synthetic, real videos and the result paths are also shown as plots of the comparison.},
  keywords={Workability;Chatbots;Generators;Task analysis;Disruptive technologies;object speed estimation;temporal domain object estimation;sequence generation;video captioning;video understanding;structured trajectory;object-oriented estimation;video sequence generation;video annotation;video classification},
  doi={10.1109/ICDT61202.2024.10489570},
  ISSN={},
  month={March},}@INPROCEEDINGS{11376743,
  author={Y, Alwin Fredrick and Sundaram, Asha and Helen, Frederick Ruby},
  booktitle={2025 Global Conference on Information Technology and Communication Networks (GITCON)}, 
  title={A Cognitive-Analytical Framework Merging Doctrinal and Empirical Approaches in Cyberspace}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Digital intellectual property rights (IPR) management in cyberspace faces numerous challenges, including cross-border enforcement complexities, fair use ambiguities, and emerging technology disputes. This study proposes a Cognitive-Analytical Framework integrating doctrinal and empirical approaches with advanced technologies such as artificial intelligence (AI) and blockchain to enhance IPR enforcement. Using survey data, case studies, and scenario-based simulations, the framework demonstrated its effectiveness in resolving key issues. The refined framework improved infringement detection accuracy from 85% to 92%, reduced dispute resolution time by 22% (from 7.4 to 5.8 months), and increased stakeholder satisfaction from 73% to 89%. Technologies like image recognition AI and blockchain were found to be highly effective, achieving simulated effectiveness of 93% and 87%, respectively. Legal text mining revealed that fair use disputes (34%) and cross-border issues (29%) are the most frequent challenges. The results validate the proposed framework's ability to address diverse IPR challenges while promoting harmonized global standards. This study paves the way for future integration of quantum encryption and predictive analytics to further enhance digital IPR management.},
  keywords={Text mining;Surveys;Image resolution;Cyberspace;Intellectual property;Blockchains;Stakeholders;Artificial intelligence;Predictive analytics;Standards;Intellectual Property Rights;Cognitive-Analytical Framework;Artificial Intelligence;Blockchain;Cross-Border Enforcement;Digital Content},
  doi={10.1109/GITCON65266.2025.11376743},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11228563,
  author={Wang, Bin and Zhang, Ziyan and Chen, Lexi and Li, Hui},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={A Low-Noise Web Content Extraction Framework for LLM Data Pipelines: Integrating XGBoost Classification and Reverse Coloring}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Low-Information-density webpages present significant challenges for web content extraction, often yielding fragmented text and high noise levels—issues that become especially critical when preparing large-scale corpora for training Large Language Models (LLMs). In this paper, we introduce a low-noise content extraction framework that integrates node-level XGBoost classification with a global reverse coloring procedure. Specifically, our method first classifies noisy nodes by learning localized DOM features, then refines these predictions via subtree-level merging and pruning to enforce structural consistency. Experimental results show that this approach outperforms a variety of baseline tools and LLM-driven extraction methods across multiple metrics. Notably, the reverse coloring step substantially mitigates local misclassifications while improving coherence in extracted text blocks. Our findings underscore the value of combining local classification signals with global DOM constraints, thereby enabling more robust, efficient extraction of high-quality web data—an essential requirement for large-scale LLM training pipelines.},
  keywords={Training;Accuracy;Pipelines;Refining;Noise;Neural networks;Feature extraction;Robustness;Data mining;Noise measurement;Web Content Extraction;XGBoost;structured data extraction},
  doi={10.1109/IJCNN64981.2025.11228563},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{11198287,
  author={Zhang, Boyuan and Zhu, Shuyuan and Yang, Xibang and Zeng, Bing and Xiong, Lei},
  booktitle={2025 2nd International Conference on Intelligent Perception and Pattern Recognition (IPPR)}, 
  title={TSCL: Two-Stage Self-Supervised Contrastive Learning for Spoken Language Identification}, 
  year={2025},
  volume={},
  number={},
  pages={332-336},
  abstract={Spoken language identification (SLI) is an important field of acoustic classification. As the front-end technology of many multilingual systems, it is widely applied. However, the field of language identification based on acoustic features lacks adaptive methods akin to image augmentation and feature distillation techniques prevalent in the image domain for enhancing the category-specificity of the obtained features. To address this, we propose innovations in two aspects. On the one hand, considering the characteristics of acoustic features, we propose Phoneme-Level Unit Replacement (UPLR) and Temporal Co-location Merging (TCM) for data augmentation. On the other hand, we subject both the augmented data and the original data to a Contrastive-aware Dual Attention Feature Distillation (CDAFD) framework for feature enhancement, yielding a reusable feature enhancement apparatus. This two-stage feature enhancer comprises two phases. In the first stage, we employ our proposed Swin Transformer model, where calculating the InfoNCE loss for input sample pairs belonging to the same category and perform backpropagation to update the structure of this Swin Transformer model. Within the traditional Swin Transformer architecture, we integrate three novel structures: Gated Cross-stage Propagation (GCSP), Modality-aware Cross-Attention (MACA), and Local Feature Retention Pathway (LFRP). In the second stage, we construct a Self-Attention layer and a Down-Projection layer to perform feature enhancement, where updating the parameters of these aforementioned structures by calculating the Category Aggregation Loss (CAL). Ultimately, we obtain a feature extractor. We validated the effectiveness of the proposed methods through experiments.},
  keywords={Hands;Technological innovation;Merging;Contrastive learning;Speech recognition;Transformers;Feature extraction;Acoustics;Robustness;Multilingual;Spoken language identification;Feature distillation;Contrastive learning;Swin transformer;Category Aggregation Loss (CAL)},
  doi={10.1109/IPPR66507.2025.11198287},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11461486,
  author={Qian, Yukun and Zhang, Wenjie and Zhuang, Xuyi and Xu, Shiyun and Zhou, Lianyu and Wang, Mingjiang},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Arbitrarily Settable Frame Rate Neural Speech Codec with Content Adaptive Variable Length Segmentation}, 
  year={2026},
  volume={},
  number={},
  pages={14452-14456},
  abstract={Recent speech quantization and compression models predominantly adopt residual vector quantization. However, they typically operate at a fixed frame rate, imposing uniform temporal granularity across all segments. Real world audio often contains simple or low variation regions, for which a fixed frame rate wastes sequence length and reduces efficiency in real time applications. We therefore introduce Content Adaptive Variable Length Segmentation (CAVLS), which supports arbitrary frame rates. CAVLS merges adjacent frames into variable-length segments based on audio content and local similarity, thereby inducing a variable frame rate. Experimental results show that a CAVLS-equipped codec achieves state-of-the-art reconstruction quality at low frame rates, maintains competitive performance at high frame rates, and provides substantial flexibility.},
  keywords={Feeds;Motion pictures;Broadcasting;Broadcast technology;Codecs;Modulation;Videos;Protocols;Communications technology;Video equipment;neural speech codec;variable frame rate;speech coding},
  doi={10.1109/ICASSP55912.2026.11461486},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{10673432,
  author={Rajora, Ricky and Banerjee, Deepak and Upadhyay, Deepak and Dangi, Sarishma and Sunil, G},
  booktitle={2024 Asia Pacific Conference on Innovation in Technology (APCIT)}, 
  title={Precision in Cassava Root Disease Diagnosis: Merging CNN and Random Forest Techniques}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Their abstract presents a novel method for identifying cassava root disease by creating a sophisticated model. Using Convolutional Neural Networks (CNNs) in combination with Random Forest, the model achieves high recall, high precision, and F1-Score values of more than 97.7% for a few disease classes: cassava Mosaic Disease, cassava Brown Streak Disease, cassava Bacterial Blight, cassava Anthracnose Disease, or cassava Root Rot. The macro-, weighted--, & micro-average accuracy metrics, which add up to an astounding 97.80%, all demonstrate how resilient the model is. With its thorough insights into the model's classification performance, Figure 3 offers a nuanced breakdown of true positives, false positives, false negatives, and true negatives. Furthermore, the complex CNN architecture behind this achievement is explored in Table 3. The research involved examining a dataset of 6810 images. The model demonstrated impressive performance, achieving an accuracy of 97.79% in overall classification. The model's dependability across a range of disease cases is highlighted by these metrics, even though macro, weighted, and micro-average support and support proportion values were missing. The cumulative effect of these results highlights the revolutionary effect of the model on the identification of diseases in cassava production. Enhancing crop health and advancing precision agriculture is made possible by the precision and accuracy of the methodology. The useful tool for farmers to maximize cassava production and secure a more secure and resilient agricultural future, this creative integration of cutting-edge technologies not only transforms disease identification but also makes a significant contribution to the larger goal of sustainable agricultural practices.},
  keywords={Measurement;Precision agriculture;Accuracy;Microorganisms;Electric breakdown;Crops;Production;Precision;Diseases;Discrimination;Production},
  doi={10.1109/APCIT62007.2024.10673432},
  ISSN={},
  month={July},}@INPROCEEDINGS{11330398,
  author={Palanisamy, Vishnuraja and Kokulavani, K. and Sakkarai, Jeevitha and Radhika, K. and Gnanamani, Maria Kalavathy and Alagarsamy, Manjunathan},
  booktitle={2025 International Conference on Electrical Engineering and Informatics (ICEEI)}, 
  title={Topological Deep Learning for Recognizing Manufacturing Defects in High-Precision Semiconductor Fabrication Lines}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The quality and yield of a product rely on detecting production defects during high-precision semiconductor fabrication. As semiconductor components become more complex and smaller, existing pixel based defect detection approaches generally overwhelm the complex spatial connectivity and topological structures of semiconductor images. There is a need for new sophisticated, computationally feasible defect detection algorithms that can detect defects even with small size and in real-time for an industrial setting. Non-Euclidean defect patterns found on semiconductor surfaces poses a challenge for Convolutional Neural Networks (CNNs) and standard deep learning (DL) algorithms to perform reliably. These faults have more complex shapes and localized variations that historical methods struggle to recognize. These methods also have slower processing times, limited opportunity for adapting to new types of defects, and most significantly did not employ the topological properties of the data effectively. A real-time, scalable and reliable approach is necessary to overcome these challenges. This study addresses these challenges by proposing a Topological Defect Recognition Network (TDR-Net) which integrates DL and Topological Data Analysis (TDA). TDR-Net applies topological data analysis in the form of a Persistent Homology-Based Feature Extraction (PHFE) method, allowing it to capture multi-scale topological characteristics of defect patterns and preserves the geometric structure that they may have been overlooked in previous methods. Again, the “shape” and “structure” of defects can be recognized by extracting and learning topological features directly from raw images without a prior processing step. A Graph Convolutional Layer (GCL) indicates the connections between the recovered topological properties while merging the structural context of the image for higher-order fault structural reasoning. Identifying defects in real time with minimal computing overhead is vital for production. Based on experiments from an established semiconductor production line, TDR-Net provides a superior identification performance over implementations using CNN approaches. The proposed method achieves a defect identification accuracy improvement of 15%, a processing time improvement of 20%, and improved generalization to a new defect type.},
  keywords={Semiconductor device modeling;Fabrication;Accuracy;Shape;Computational modeling;Fault detection;Merging;Feature extraction;Real-time systems;Defect detection;Topological Data Analysis (TDA);Persistent Homology;Semiconductor Defect Detection;Topological Defect Recognition Network (TDR-Net);Graph Convolutional Layer (GCL);Real-Time Defect Recognition},
  doi={10.1109/ICEEI68459.2025.11330398},
  ISSN={2155-6830},
  month={Nov},}@ARTICLE{11015257,
  author={Koç, Emirhan and Kulkul, Emre and Kaynar, Gülara and Çukur, Tolga and Acar, Murat and Koç, Aykut},
  journal={IEEE Transactions on Signal and Information Processing over Networks}, 
  title={scGraPhT: Merging Transformers and Graph Neural Networks for Single-Cell Annotation}, 
  year={2025},
  volume={11},
  number={},
  pages={505-519},
  abstract={The invention of single-cell RNA sequencing (scRNA-seq) has enabled transcriptomic examination of cells on an individual basis, uncovering cell-to-cell phenotypic heterogeneity within isogenic cell populations. Inevitably, cell type annotation has emerged as a fundamental, albeit challenging task in scRNA-seq data analysis, which involves identifying and characterizing cells based on their unique molecular profiles. Recently, deep learning techniques with their data-driven priors have shown significant promise in this task. On the one hand, task-agnostic transformers pre-trained on large-scale biological databases capture generalizable representations but cannot characterize intricate relationships between genes and cells. Contrarily, task-specific graph neural networks (GNNs) trained on target datasets can characterize entity relationships, but they can suffer from poor generalizability. Furthermore, existing GNNs focus on either homogeneous or heterogeneous relationships, failing to capture the full cellular complexity. Here, we propose scGraPhT, a unified transformer–graph model that combines pre-trained transformer embeddings of scRNA-seq data with a multilayer GNN to capture cell-cell, cell-gene, and gene-gene relationships. Different from previous GNNs, scGraPhT examines both homogeneous and heterogeneous relationships through subgraph layers to offer a more comprehensive assessment. Since the graph construction uses transformer-derived embeddings, scGraPhT does not require costly training procedures and can also be adapted to leverage any transformer-based single-cell annotation method, such as scGPT or scBERT. Demonstrations on three scRNA-seq benchmark datasets indicate that scGraPhT outperforms state-of-the-art annotation methods without compromising efficiency. Utilizing Grad-CAM, we demonstrate how the GNN and transformer components complement each other to enhance performance. We share our source codes and datasets for reproducibility.},
  keywords={Annotations;Transformers;Graph neural networks;Information processing;Gene expression;Analytical models;Training;Cells (biology);Transcriptomics;Sequential analysis;Graph neural networks (GNNs);transformers;foundation models;scRNA sequencing;cell type annotation},
  doi={10.1109/TSIPN.2025.3573591},
  ISSN={2373-776X},
  month={},}@INPROCEEDINGS{11354441,
  author={L, Nisha. S and Raga, Ganesh and Shivam, Kumar and Raga, Sarika Sunilraj},
  booktitle={2025 5th International Conference on Mobile Networks and Wireless Communications (ICMNWC)}, 
  title={Design and Implementation of Textile-Based Broadband Antenna for 5G Wearable Applications}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The expansion of $\mathbf{5 G}$ communication and the rise of wearable technologies have driven the need for compact, flexible, and efficient antenna systems. This paper presents the design and implementation of a textile-based broadband antenna for 5 G wearable applications, using denim fabric as the dielectric substrate. The antenna employs a 0.5 mm thick denim layer for its mechanical flexibility and comfort, making it suitable for integration into clothing. As the conductive material, graphene ink is utilized due to its high conductivity, lightweight nature, and compatibility with textile surfaces, ensuring reliable RF performance without compromising wearability. This multidisciplinary integration supports both high-speed $\mathbf{5 G}$ communication and low-power applications in a wearable format. Simulation and prototyping validate the antenna’s performance, demonstrating acceptable gain, radiation efficiency, and flexibility. The resulting system shows promise for applications in smart healthcare, environmental monitoring, and emergency response, providing users with realtime data transmission over vast distances while maintaining comfort and wearability. This paper contributes toward the development of advanced wearable systems that merge communication, sensing, and smart textiles for next generation connected solutions.},
  keywords={Wireless communication;Smart textiles;5G mobile communication;Dielectric substrates;Mobile antennas;Conductivity;Broadband communication;Sensors;Broadband antennas;Biomedical monitoring;5G communication;textile-based broadband antenna;dielectric substrate;high conductivity radiation efficiency and advanced wearable systems},
  doi={10.1109/ICMNWC66779.2025.11354441},
  ISSN={},
  month={Dec},}@ARTICLE{11071918,
  author={Qu, Hongyu and Yan, Rui and Shu, Xiangbo and Gao, Hailiang and Huang, Peng and Xie, Guosen},
  journal={IEEE Transactions on Multimedia}, 
  title={MVP-Shot: Multi-Velocity Progressive-Alignment Framework for Few-Shot Action Recognition}, 
  year={2025},
  volume={27},
  number={},
  pages={6593-6605},
  abstract={Recent few-shot action recognition (FSAR) methods typically perform semantic matching on learned discriminative features to achieve promising performance. However, most FSAR methods focus on single-scale (e.g., frame-level, segment-level, etc.) feature alignment, which ignores that human actions with the same semantic may appear at different velocities. To this end, we develop a novel Multi-Velocity Progressive-alignment (MVP-Shot) framework to progressively learn and align semantic-related action features at multi-velocity levels. Concretely, a Multi-Velocity Feature Alignment (MVFA) module is designed to measure the similarity between features from support and query videos with different velocity scales and then merge all similarity scores in a residual fashion. To avoid the multiple velocity features deviating from the underlying motion semantic, our proposed Progressive Semantic-Tailored Interaction (PSTI) module injects velocity-tailored text information into the video feature via feature interaction on channel and temporal domains at different velocities. The above two modules compensate for each other to make more accurate query sample predictions under the few-shot settings. Experimental results show our method outperforms current state-of-the-art methods on multiple standard few-shot benchmarks (i.e., HMDB51, UCF101, Kinetics, SSv2-full, and SSv2-small).},
  keywords={Videos;Semantics;Visualization;Training;Prototypes;Accuracy;Transformers;Predictive models;Image recognition;Image classification;Action recognition;few-shot action recognition;few-shot learning;mutli-velocity feature matching},
  doi={10.1109/TMM.2025.3586118},
  ISSN={1941-0077},
  month={},}@ARTICLE{10210304,
  author={Li, Zejie and Wang, Xiongfei and Zhao, Fangzhou and Munk-Nielsen, Stig and Geske, Martin and Grune, Rayk and Bo Rønnest Andersen, Daniel and Garnelo Rodriguez, Miguel},
  journal={IEEE Journal of Emerging and Selected Topics in Power Electronics}, 
  title={Power-Hardware Design and Topologies of Converter-Based Grid Emulators for Wind Turbines}, 
  year={2023},
  volume={11},
  number={5},
  pages={5001-5017},
  abstract={Power-electronic-based grid emulators (GEs) emerge as a favorable method for testing grid-code compliances of wind turbines (WTs), thanks to their full controllability and improved efficiency. To accommodate the increasing power and voltage levels of WTs, scalability becomes a critical requirement for the topologies of converter-based GEs. This article identifies first the power rating of future GEs based on the system architecture and the evolution of WTs, followed by evaluating converter topologies of GEs for high scalability. Design considerations of power semiconductor devices, step-up transformers, dc chopper, and dc capacitors are also discussed for existing and prospective GEs.},
  keywords={Germanium;Voltage;Transformers;Power harmonic filters;Topology;Scalability;Inverters;Converter topologies;grid-code compliance;grid emulators (GEs);power hardware;testing},
  doi={10.1109/JESTPE.2023.3302808},
  ISSN={2168-6785},
  month={Oct},}@INPROCEEDINGS{9576262,
  author={Real-Moreno, Oscar and Rodríguez-Quiñonez, Julio C. and Sergiyenko, Oleg and Flores-Fuentes, Wendy and Mercorelli, Paolo and Ramírez-Hernández, Luis R.},
  booktitle={2021 IEEE 30th International Symposium on Industrial Electronics (ISIE)}, 
  title={Obtaining Object Information from Stereo Vision System for Autonomous Vehicles}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={Autonomous navigation is a task that requires the most information it can get from its surroundings for safety, accuracy and decision making. This paper presents a stereo vision system capable of obtaining object information for autonomous vehicles. The stereo vision system is merged with an object detection algorithm to carry out this task. The merge between these systems is a proposal to create a vision system for autonomous navigation tasks that provides information about objects of interest in the field of view, such as object description, distance, height and width.},
  keywords={Industrial electronics;Machine vision;Decision making;Object detection;Stereo vision;Safety;Proposals;Camera calibration;stereo vision;object detection;object information;autonomous vehicles;pixel to angle},
  doi={10.1109/ISIE45552.2021.9576262},
  ISSN={2163-5145},
  month={June},}@ARTICLE{11146827,
  author={Zhang, Yongquan and Chen, Yuanhao and Yu, Haoqi and Dai, Jingrong and Liu, Bo and Li, Nannan and Wang, Changmiao and Elazab, Ahmed},
  journal={IEEE Transactions on Geoscience and Remote Sensing}, 
  title={Frequency-Domain Convolutional Network With Historical Data Fusion Module for Regional Streamflow Prediction}, 
  year={2025},
  volume={63},
  number={},
  pages={1-14},
  abstract={Accurate runoff prediction is essential for effective water resource management, particularly in addressing flood control and monitoring drought conditions. However, the diverse nature of land types and varying climate conditions often complicate this task, requiring frequent adaptations to prediction models for local applications. Existing methods primarily focus on modeling for individual regions, while regional runoff prediction models often cannot learn long-term patterns, limiting their regional adaptability. To overcome this challenge, we present the temporal fusion runoff network (TFRN), a new framework designed to enhance long short-term memory (LSTM) models by enabling them to incorporate distant historical information. This innovation offers a promising framework for regional runoff prediction by enhancing model performance and minimizing computational demands. In this study, the proposed TFRN utilizes convolutional networks to extract and integrate both long- and short-term trends from input sequences, and by merging the strengths of LSTM and Transformer architectures, the TFRN achieves a thorough integration of historical data. Specifically, our method employs convolutional networks across both time and frequency domains to capture multiscale features. In the Transformer component, we introduce an adaptive fusion module to improve the integration of historical information. We validated the effectiveness of our model using two extensive hydrological datasets for a seven-day runoff prediction task. The results underscore the superiority of our approach, demonstrating its advantages over several leading methods. The source code is available at https://github.com/redtea-code/TFRN},
  keywords={Predictive models;Transformers;Feature extraction;Adaptation models;Long short term memory;Time series analysis;Biological system modeling;Frequency-domain analysis;Data models;Computational modeling;Long short-term memory (LSTM);runoff forecasting;streamflow prediction;time series;Transformer},
  doi={10.1109/TGRS.2025.3605332},
  ISSN={1558-0644},
  month={},}@INPROCEEDINGS{9752422,
  author={Singh, Sourav and Sharma, Sachin and Bhadula, Shuchi},
  booktitle={2022 International Conference on Electronics and Renewable Systems (ICEARS)}, 
  title={Automated Deep Learning based Disease Prediction Using Skin Health Records: Issues, Challenges and Future Directions}, 
  year={2022},
  volume={},
  number={},
  pages={638-643},
  abstract={Due to recent breakthroughs in Artificial Intelligence (AI) and automation in the healthcare industry, people have been able to see an increased possibility for merging deep learning with healthcare. Automated deep learning and healthcare integration have been found as a feasible technique for enhancing disease prediction accuracy, which will aid in disease prevention and control. AI-enabled skin health data could be used as a unique technique for preliminary body health prediction by matching symptoms and influenced skin photos to a pool of current disease databases. The goal of this research is to offer an automated deep learning framework for predicting illness outcomes based on changes in skin characteristics. Various issues and challenges are also investigated, with the purpose of anticipating the integration of deep learning into healthcare in future medical research.},
  keywords={Deep learning;Industries;Renewable energy sources;Automation;Databases;Merging;Medical services;Deep learning;Disease prediction;Artificial Intelligence},
  doi={10.1109/ICEARS53579.2022.9752422},
  ISSN={},
  month={March},}@INPROCEEDINGS{9413007,
  author={Isaac-Medina, Brian K. S. and Willcocks, Chris G. and Breckon, Toby P.},
  booktitle={2020 25th International Conference on Pattern Recognition (ICPR)}, 
  title={Multi-view Object Detection Using Epipolar Constraints within Cluttered X-ray Security Imagery}, 
  year={2021},
  volume={},
  number={},
  pages={9889-9896},
  abstract={Automatic detection for threat object items is an increasing emerging area of future application in X-ray security imagery. Although modern X-ray security scanners can provide two or more views, the integration of such object detectors across the views has not been widely explored with rigour. Therefore, we investigate the application of geometric constraints using the epipolar nature of multi-view imagery to improve object detection performance. Furthermore, we assume that images come from uncalibrated views, such that a method to estimate the fundamental matrix using ground truth bounding box centroids from multiple view object labels is proposed. In addition, detections are given a confidence probability based on its similarity with respect to the distribution of the distance to the epipolar line. This probability is used as confidence weights for merging duplicated predictions using non-maximum suppression. Using a standard object detector (YOLOv3), our technique increases the average precision of detection by 2.8% on a dataset composed of firearms, laptops, knives and cameras. These results indicate that the integration of images at different views significantly improves the detection performance of threat items of cluttered X-ray security images.},
  keywords={Training;Portable computers;Merging;Object detection;Detectors;Random variables;Pattern recognition;Multi-view;X-ray security imagery;object detection;epipolar geometry},
  doi={10.1109/ICPR48806.2021.9413007},
  ISSN={1051-4651},
  month={Jan},}@ARTICLE{11123763,
  author={Zhuang, Feng and Huang, Ting and Liu, Jing},
  journal={IEEE Robotics and Automation Letters}, 
  title={TaskSimLF: Efficient Leader-Follower Multi-Agent Path Finding With Clustered Pickup and Delivery}, 
  year={2025},
  volume={10},
  number={10},
  pages={10210-10217},
  abstract={Multi-Agent Path Finding (MAPF) aims at finding a set of conflict-free and cost-optimal paths for agents from pickup to delivery locations. Most existing MAPF research focus on exhaustively search for path set for the agents with conflict-free paths, which often results in high computational costs. In this letter, we aim to accelerate the path-finding process by considering the distribution of pickup-delivery pairs and leveraging task similarity. We propose TaskSimLF, a task-similarity based leader-follower path finding method. Specifically, the algorithm first employs an adaptive clustering of tasks to group them based on spatial similarity. For each group, we generate the representative leader’s path by maximizing the spatial separation of inter-group and minimizing spatiotemporal overlap. The agents within each group, referred to as followers, find their paths by following the leader's trajectory, using topological features of the leader's path to reduce intra-group conflicts. Experimental results demonstrate that our proposed algorithm shows superior performance while significantly improves runtime efficiency with fewer node expansion in different map scenarios.},
  keywords={Clustering algorithms;Planning;Path planning;Complexity theory;Spatial resolution;Search problems;Clustering methods;Training;Runtime;Merging;Clustered tasks;collision avoidance;leader-follower;multi-agent path planning;multi-robot systems},
  doi={10.1109/LRA.2025.3598672},
  ISSN={2377-3766},
  month={Oct},}@INPROCEEDINGS{10698592,
  author={Bencherki, Zakaria and Benfriha, Khaled and Meyrueis, Vincent and Cachot, Laurent and Soares, Philippe},
  booktitle={2024 International Conference on Electrical, Computer and Energy Technologies (ICECET}, 
  title={IEC 61499: A Key Enabler for Distributed Automation in Industry 4.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The industrial world is undergoing a major transformation as operational technology (OT) and information technology (IT) converge. This trend is being driven by the much faster evolution of IT compared to OT. This paper examines how these two technologies have evolved, with IT advancing rapidly and creating a strong case for merging them in industrial environments. The IEC 61499 standard is seen as a key driver for this integration. It acts as a blueprint for the design of distributed control systems, emphasizing clear communication and adaptability - critical aspects for modern industrial systems. The active involvement of various companies in promoting this standard highlights the collaborative effort required to achieve widespread adoption. Looking ahead, the paper explores new research areas driven by IT-OT convergence. It also discusses future work aimed at addressing current limitations and maximizing the benefits of this powerful integration. This rewrite uses simpler language and avoids technical jargon where possible. It emphasizes the key points: the acceleration of IT development, the importance of IT-OT convergence in industry, and the role of the IEC 61499 standard.},
  keywords={Industries;Merging;Decentralized control;Companies;Market research;Fourth Industrial Revolution;IEC Standards;Information technology;Standards;Convergence;IEC 61499 Standard;Automation;Industry 4.0;PLCs;UniversalAutomation.org},
