  booktitle={2024 4th International Conference on Technological Advancements in Computational Sciences (ICTACS)}, 
  title={Advancing the Connectivity and Automation of Smart Devices by Merging Artificial Intelligence with the Internet of Things}, 
  year={2024},
  volume={},
  number={},
  pages={1940-1945},
  abstract={This paper focuses at the achievement of AI with loT to improve the communication and control of smart devices in different sectors. Therefore, different machine learning models such as DQN, SVM, Random Forest, PCA, CNNs, and LSTM networks are used to enhance the smart home automation, industrial loT, health, and smart city sector to enhance the efficiency, and accuracy rates of the consumers. In smart homes AI models control energy and light based on people's activities in their home, say researchers. In industries, more enhanced version of machine learning enhances predictive maintenance as well the improvement of processes. As for the healthcare industry, it avails itself of AI in the detection of anomalies and in recommending a patient-specific treatment plan. This is a key aspect since in the smart cities AI models perform traffic and waste management, improving their effectiveness and, at the same time, their sustain ability. Therefore, the outcomes provide the evidence of the effectiveness of integrating AI and loT in order to expand the notions of the more effective and responsible systems. Recognizing that there is still work to be done on providing structure for the application these technologies collectively under head Artificial Intelligence as well as loT, at the conclusion of the paper, the author presses for more work that will endeavor to sharpen the described models as well as search for other opportunities that might exist for these technologies.},
  keywords={Industries;Support vector machines;Waste management;Automation;Smart cities;Machine learning;Smart homes;Medical services;Artificial intelligence;Optimization;Artificial Intelligence (AI);Predictive Algorithms;Deep Q-Networks (DQN);Vector-Based Classification;Random Forests;Internet of Things (loT)},
  doi={10.1109/ICTACS62700.2024.10840692},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11120102,
  author={Bashir, Ahmad Armghan and Tariq, Noshina},
  booktitle={2024 IEEE 9th International Conference on Engineering Technologies and Applied Sciences (ICETAS)}, 
  title={Comparison of Mod-Evasive and Modsecurity Modules for Apache Web Server in Lamp Environment}, 
  year={2024},
  volume={},
  number={},
  pages={1-10},
  abstract={One of the most widely used technologies for delivering information and services over the Internet is the website, which can update and maintain web applications without requiring software installation on potentially millions of client computers. Due to their growing use for vital services, web apps are becoming a visible and significant target for security breaches. Strong security measures are required to enhance the security of web applications. This research aims to merge two powerful Apache modules, namely ModSecurity and ModEvasive, to im- prove the safety of applications that are used online. The thesis provides a detailed explanation of each module's capabilities, features, and benefits. It gives a combined deployment strategy that will maximize the synergistic potential of each module. Ac- cording to the research findings, the combined use of ModEvasive and ModSecurity modules enhances website security, and many critical and high-severity vulnerabilities can be eliminated with the combined use of both Apache modules. This research also reveals the most common website vulnerabilities and highlights the use of Detectify for assessing website security.},
  keywords={Knowledge engineering;Firewalls (computing);Cross-site scripting;Government;Denial-of-service attack;Web servers;Software;Safety;Internet;Security;ModSecurity;Web Applications;Security},
  doi={10.1109/ICETAS62372.2024.11120102},
