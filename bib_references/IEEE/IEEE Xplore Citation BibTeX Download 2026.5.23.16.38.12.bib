  ISSN={},
  month={July},}@INPROCEEDINGS{11028807,
  author={Guerrero-Munuera, María-Dolores and Sanchez-Iborra, Ramon and Skarmeta, Antonio},
  booktitle={2024 IEEE Future Networks World Forum (FNWF)}, 
  title={On the Convergence of C-ITS Services in 5G Infrastructures}, 
  year={2024},
  volume={},
  number={},
  pages={135-140},
  abstract={Amid the era of hyperconnectivity and the widespread adoption of 5G technology, there is a compelling need to integrate different communication ecosystems within cellular networks; this is the case of vehicular communications. This need arises from the high interest on merging both worlds to enrich the Cooperative-Intelligent Transport Systems (C-ITS) paradigm with the novel features brought by 5G networks. This integration, known as Cellular-Vehicular to Everything (C-V2X), is being actively promoted from the academia and the industry, however, there is still a lack of functional architectures addressing such an integration. This paper presents an effective integrated architecture and the technologies to implement it, aiming at supporting heterogeneous vehicular services in 5G systems. The most novel resource orchestration and traffic handling paradigms are leveraged to provide the solution with adequate levels of flexibility and performance, hence coping with the stringent requirements of the vehicular vertical.},
  keywords={Cellular networks;Performance evaluation;Industries;5G mobile communication;Merging;Ecosystems;Computer architecture;Resource management;Vehicle dynamics;Edge computing;5G;C-ITS;C-V2X;vehicular communications},
  doi={10.1109/FNWF63303.2024.11028807},
  ISSN={2770-7679},
  month={Oct},}@INPROCEEDINGS{11042985,
  author={Wang, Jin and Guo, Qingbin and Gu, Haoran and Wang, Handing},
  booktitle={2025 IEEE Congress on Evolutionary Computation (CEC)}, 
  title={A Parallel Surrogate-Assisted Multi-Penalty Function Search for Simulation-Driven Antenna Design}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={High-fidelity electromagnetic simulation-driven optimization are crucial in modern antenna design. However, many antenna optimization models involve multiple expensive constraints, which can be formulated as expensive constrained optimization problems (ECOPs). Currently, surrogate-assisted evolutionary algorithms are widely used to solve ECOPs. However, existing methods face significant challenges in addressing errors in constraint surrogate models and the strong conflicts among constraints and the objective, making it difficult to find feasible solutions with optimal objective value within a limited number of simulations. We propose a parallel surrogate-assisted multiple penalties search method for simulation-driven antenna design problems with expensive conflicting constrains. In the proposed method, a multi-penalty function search mechanism is designed, followed by an adaptive parallel sampling approach to collect multiple samples for the parallel simulation. The experimental results applied to the design of the three-layer filtering antenna demonstrate the effectiveness and great potential of the proposed method in addressing simulation-driven antenna design problems with expensive conflicting constrains.},
  keywords={Adaptation models;Filtering;Design methodology;Search methods;Patch antennas;Optimization models;Merging;Evolutionary computation;Antennas;Optimization;Antenna optimization;multiple penalty functions;surrogate-assisted;parallel sampling},
  doi={10.1109/CEC65147.2025.11042985},
