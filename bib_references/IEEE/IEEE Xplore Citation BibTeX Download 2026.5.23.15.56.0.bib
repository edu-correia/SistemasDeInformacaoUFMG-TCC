  author={Ren, Zhilei and Jiang, He and Xuan, Jifeng and Luo, Zhongxuan},
  journal={IEEE Transactions on Systems, Man, and Cybernetics, Part B (Cybernetics)}, 
  title={An Accelerated-Limit-Crossing-Based Multilevel Algorithm for the $p$-Median Problem}, 
  year={2012},
