  booktitle={2023 29th International Workshop on Thermal Investigations of ICs and Systems (THERMINIC)}, 
  title={An Advanced Integrated Cooling Solution for High Voltage and Power Density Modules}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={This study investigated the thermal performance of a packaging solution designed to manage the electrical isolation and cooling of high voltage (> 3300 V) SiC power semiconductor devices. The proposed packaging merges the ceramic substrate and the heat exchanger into a single component, streamlining the overall design. Specifically, a novel heat exchanger is developed for a multi-chip module (20kV), utilizing a combination of jet impingement and channel-flow cooling techniques. Computational fluid dynamics (CFD) simulations and experimental validation are conducted on a multi-chip module to assess the thermal resistance of this new cooling solution. The results demonstrate a low thermal resistivity of 0.118cm 2K/W, indicating the potential for improved cooling performance in high voltage and power density semiconductor applications.},
  keywords={Power system measurements;Density measurement;Thermal resistance;Computational fluid dynamics;High-voltage techniques;Packaging;Thermal management;High voltage;insulation;packaging;computational fluid dynamics (CFD);Cooling;power electronics;high power density},
  doi={10.1109/THERMINIC60375.2023.10325867},
  ISSN={2474-1523},
  month={Sep.},}@INBOOK{9466328,
  author={Bai, Ying},
  booktitle={Oracle Database Programming with Visual Basic.NET: Concepts, Designs, and Implementations}, 
  title={Introduction to ADO.NET}, 
  year={2021},
  volume={},
  number={},
  pages={77-122},
  abstract={ActiveX Data Object (ADO) is developed based on Object Linking and Embedding and Component Object Model (COM) technologies. This chapter provides a detailed introduction to ActiveX Data Object (ADO).NET and its components. ADO.NET provides a rich set of components for creating distributed, data&#x2010;sharing applications. The ADO.NET Common Language Runtime provides bi&#x2010;directional, transparent integration with COM. The ADO.NET architecture can be divided into two logical pieces: command execution and caching. Command execution requires features like connectivity, execution, and reading of results. These features are enabled with ADO.NET Data Providers. The Data Provider enables connectivity and command execution to underlying data sources. ADO.NET is composed of three major components: Data Provider, DataSet, and DataTable. The Data Provider is physically composed of a binary library file, and this library is in the DLL file format. The .NET Framework Data Provider for Open Database Connectivity uses native ODBC Driver Manager through COM interop to enable data access.},
