@INPROCEEDINGS{10377481,
  author={Jain, Rishabh and Hemani, Mayur and Ceylan, Duygu and Singh, Krishna Kumar and Lu, Jingwan and Sarkar, Mausoom and Krishnamurthy, Balaji},
  booktitle={2023 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={UMFuse: Unified Multi View Fusion for Human Editing applications}, 
  year={2023},
  volume={},
  number={},
  pages={7148-7157},
  abstract={Numerous pose-guided human editing methods have been explored by the vision community due to their extensive practical applications. However, most of these methods still use an image-to-image formulation in which a single image is given as input to produce an edited image as output. This objective becomes ill-defined in cases when the target pose differs significantly from the input pose. Existing methods then resort to in-painting or style transfer to handle occlusions and preserve content. In this paper, we explore the utilization of multiple views to minimize the issue of missing information and generate an accurate representation of the underlying human model. To fuse knowledge from multiple viewpoints, we design a multi-view fusion network that takes the pose key points and texture from multiple source images and generates an explainable per-pixel appearance retrieval map. Thereafter, the encodings from a separate network (trained on a single-view human reposing task) are merged in the latent space. This enables us to generate accurate, precise, and visually coherent images for different editing tasks. We show the application of our network on two newly proposed tasks - Multi-view human reposing and Mix&Match Human Image generation. Additionally, we study the limitations of single-view editing and scenarios in which multi-view provides a better alternative. Datasplits and results can be found at Project Webpage.},
  keywords={Knowledge engineering;Computer vision;Image synthesis;Fuses;Pipelines;Encoding;Task analysis},
  doi={10.1109/ICCV51070.2023.00660},
  ISSN={2380-7504},
  month={Oct},}@ARTICLE{10684728,
  author={Xie, Min and Zhao, Jieyu and Shen, Kedi},
  journal={IEEE Transactions on Circuits and Systems for Video Technology}, 
  title={A Novel SO(3) Rotational Equivariant Masked Autoencoder for 3D Mesh Object Analysis}, 
  year={2025},
  volume={35},
  number={1},
  pages={329-342},
  abstract={Equivariant networks have recently made significant strides in computer vision tasks related to robotic grasping, molecule generation, and 6D pose tracking. In this paper, we explore 3D mesh object analysis based on an equivariant masked autoencoder to reduce the model dependence on large datasets and predict the pose transformation. We employ 3D reconstruction tasks under rotation and masking operations, such as segmentation tasks after rotation, as pretraining to enhance downstream task performance. To mitigate the computational complexity of the algorithm, we first utilize multiple non-overlapping 3D mesh patches with a fixed face size. We then design a rotation-equivariant self-attention mechanism to obtain advanced features. To improve the throughput of the encoder, we design a sparse token merging strategy. Our method achieves comparable performance on equivariant analysis tasks of mesh objects, such as 3D mesh pose transformation estimation, object classification and part segmentation on the ShapeNetCore16, Manifold40, COSEG-aliens, COSEG-vases and Human Body datasets. In the object classification task, we achieve superior performance even when only 10% of the original sample is used. We perform extensive ablation experiments to demonstrate the efficacy of critical design choices in our approach.},
  keywords={Three-dimensional displays;Transformers;Convolutional neural networks;Point cloud compression;Neurons;Pose estimation;Rotation-equivariance;3D mesh masked autoencoder;pose transformation estimation;sparse token},
  doi={10.1109/TCSVT.2024.3465041},
  ISSN={1558-2205},
  month={Jan},}@ARTICLE{10814723,
  author={Zhang, Kaiwei and Zhu, Dandan and Min, Xiongkuo and Duan, Huiyu and Zhai, Guangtao},
  journal={IEEE Transactions on Multimedia}, 
  title={Explain Vision Focus: Blending Human Saliency Into Synthetic Face Images}, 
  year={2025},
  volume={27},
  number={},
  pages={489-502},
  abstract={Synthetic faces have been extensively researched and applied in various fields, such as face parsing and recognition. Compared to real face images, synthetic faces engender more controllable and consistent experimental stimuli due to the ability to precisely merge expression animations onto the facial skeleton. Accordingly, we establish an eye-tracking database with 780 synthetic face images and fixation data collected from 22 participants. The use of synthetic images with consistent expressions ensures reliable data support for exploring the database and determining the following findings: (1) A correlation study between saliency intensity and facial movement reveals that the variation of attention distribution within facial regions is mainly attributed to the movement of the mouth. (2) A categorized analysis of different demographic factors demonstrates that the bias towards salient regions aligns with differences in some demographic categories of synthetic characters. In practice, inference of facial saliency distribution is commonly used to predict the regions of interest for facial video-related applications. Therefore, we propose a benchmark model that accurately predicts saliency maps, closely matching the ground truth annotations. This achievement is made possible by utilizing channel alignment and progressive summation for feature fusion, along with the incorporation of Sinusoidal Position Encoding. The ablation experiment also demonstrates the effectiveness of our proposed model. We hope that this paper will contribute to advancing the photorealism of generative digital humans.},
  keywords={Face recognition;Faces;Solid modeling;Visualization;Three-dimensional displays;Predictive models;Synthetic data;Databases;Facial features;Training;Eye tracking;saliency prediction;synthetic face image;visual attention},
  doi={10.1109/TMM.2024.3521670},
  ISSN={1941-0077},
  month={},}@ARTICLE{11471027,
  author={Zheng, Kaiyuan and He, Guojin and Yin, Ranyu and Wang, Guizhou and Long, Tengfei and Zhang, Zhaoming},
  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={A 2 m Resolution Impervious Surface Distribution Product of the Qinghai–Xizang Plateau Based on SegformerAT Model}, 
  year={2026},
  volume={19},
  number={},
  pages={13714-13733},
  abstract={High-resolution impervious surface data is essential for studies related to urban development, human activities, carbon emissions, and ecological environments. Owing to the unique geographic and climatic conditions, impervious surfaces in the Qinghai-Xizang (Tibet) Plateau (QXP) are often surrounded by sparsely vegetated areas with low canopy cover and highland exposure. In addition, the QXP is characterized by numerous, scattered small-scale impervious surfaces (SSIS). Existing impervious surface products, primarily at global or national scales, typically provide medium spatial resolutions (30-m or 10-m) and exhibit significant omission and commission errors for impervious surfaces in QXP, particularly in mapping SSIS. Consequently, a 2 m impervious surface distribution product for QXP in 2020 (QXP-ISD2m product) was created using Gaofen imagery. This product categorizes roads as a separate class to enhance the data’s applicability and defines nonroad impervious surfaces as primary impervious surfaces (PIS). Specifically, a framework for large-scale impervious surface mapping was proposed. Initially, the QXP 2 m impervious surface unique dataset, consisting of 2235 samples, was constructed using a target-scale-based stratified sampling strategy and augmented to 4807 samples by incorporating spatially overlapping multitemporal and multisensor images (2 m resolution, 512 × 512 pixels). This dataset accommodates various scales of impervious surface types in the QXP and ensures accurate impervious surface extraction. To address significant scale discrepancies between PIS and road targets, an improved Segformer model, named SegformerAT, was introduced. This model employs patch-wise normalization and utilizes the augmented dataset for training, thus ensuring high accuracy in PIS extraction and significantly improving road detection accuracy. Finally, the posterior-knowledge-based merging rule was employed to achieve effective large-scale mapping. Validation of the QXP-ISD2m product with a set of 7000 independent samples yielded F1 scores of 0.894 for PIS and 0.895 for roads. Comparative experiments with other algorithms further confirmed the superiority of the SegformerAT model.},
  keywords={Earth Observing System;Landsat;Satellite images;Sentinel-2;Pixel;Mobile ad hoc networks;Ad hoc networks;Communication systems;Internet;Computer networks;High resolution;impervious surface (IS);qinghai–xizang plateau (QXP);satellite remote sensing data;segformer},
  doi={10.1109/JSTARS.2026.3680288},
  ISSN={2151-1535},
  month={},}@INPROCEEDINGS{9270456,
  author={Liu, Liqiang and Wei, Shian and Jiang, Long and Wang, Yatao},
  booktitle={2020 International Conference on Computer Vision, Image and Deep Learning (CVIDL)}, 
  title={Weighted Aggregating Feature Pyramid Network for Object Detection}, 
  year={2020},
  volume={},
  number={},
  pages={347-353},
  abstract={Feature pyramid is crucial to state-of-the-art object detection methods. In contrast to traditional feature pyramid network, which adopts layer-by-layer architecture, we propose an end-to-end network, weighted aggregating feature pyramid network (WAFPN), which aggregates multi-scale features by rescaling these maps to single size. WAFPN aims at generating more discriminative pyramidal representations efficiently via fusing the features from different levels of backbone network. First, we apply learnable weights to WAFPN for recalibrating the features rather than directly merging them by summation or concatenation operations. Second, we use a lightweight convolutional module to reconstruct the representations of different scale features. To evaluate the proposed method, we mainly implement WAFPN in basic RetinaNet system. Besides, we also apply WAFPN to SSD framework for verifying its extensiveness. Our proposed method achieves more significant performance over the comparable detection approaches on PASCAL VOC 2007 benchmark.},
  keywords={Feature extraction;Semantics;Object detection;Software;Fuses;Convolution;Business;Weighted feature aggregation;Feature pyramid;Object detection},
  doi={10.1109/CVIDL51233.2020.00-73},
  ISSN={},
  month={July},}@INPROCEEDINGS{9857131,
  author={Graber, Colin and Jazra, Cyril and Luo, Wenjie and Gui, Liangyan and Schwing, Alexander},
  booktitle={2022 IEEE/CVF Conference on Computer Vision and Pattern Recognition Workshops (CVPRW)}, 
  title={Joint Forecasting of Panoptic Segmentations with Difference Attention}, 
  year={2022},
  volume={},
  number={},
  pages={2558-2567},
  abstract={Forecasting of a representation is important for safe and effective autonomy. For this, panoptic segmentations have been studied as a compelling representation in recent work. However, recent state-of-the-art on panoptic segmentation forecasting suffers from two issues: first, individual object instances are treated independently of each other; second, individual object instance forecasts are merged in a heuristic manner. To address both issues, we study a new panoptic segmentation forecasting model that jointly forecasts all object instances in a scene using a transformer model based on ‘difference attention.’ It further refines the predictions by taking depth estimates into account. We evaluate the proposed model on the Cityscapes and AIODrive datasets. We find difference attention to be particularly suitable for forecasting because the difference of quantities like locations enables a model to explicitly reason about velocities and acceleration. Because of this, we attain state-of-the-art on panoptic segmentation forecasting metrics.},
  keywords={Measurement;Computer vision;Conferences;Predictive models;Transformers;Pattern recognition;Forecasting},
  doi={10.1109/CVPRW56347.2022.00288},
  ISSN={2160-7516},
  month={June},}@INPROCEEDINGS{10027726,
  author={Wang, Pengkun and Wang, Xu and Wang, Binwu and Zhang, Yudong and Bai, Lei and Wang, Yang},
  booktitle={2022 IEEE International Conference on Data Mining (ICDM)}, 
  title={Countering Modal Redundancy and Heterogeneity: A Self-Correcting Multimodal Fusion}, 
  year={2022},
  volume={},
  number={},
  pages={518-527},
  abstract={Fusing multimodal heterogeneous data plays a vital role in recognition and prediction tasks in various fields, e.g., action recognition and traffic accident forecast. Yet, there remain some key challenges, such as heterogeneous feature interaction and feature redundancies, that significantly affect the performance of multimodal fusion. To tackle these challenges, we first devise a Unified Feature Interaction Module (UFIM) in which a novel orthogonal attention component is designed to obtain fine-grained inter-modal interaction information among heterogeneous features. Then, we propose a novel Self-Correcting Transformer Module (SCTM) which employs a modified transformer to obtain the one-to-many correlation information between the current modal feature and the merged features of other modalities to alleviate the redundancy problem. Extensive experiments on four cross-domain tasks demonstrate the effectiveness and generalization ability of our proposed method.},
  keywords={Costs;Correlation;Termination of employment;Gesture recognition;Transformers;Data mining;Task analysis;multimodal fusion;redundancy;heterogeneity;feature interaction;transformer},
  doi={10.1109/ICDM54844.2022.00062},
  ISSN={2374-8486},
  month={Nov},}@INPROCEEDINGS{10602066,
  author={Anitha Selvasofia, S.D. and Shri, S. Deepa and Sudarvizhi, S.Meenakshi and Sundarsingh Jebaseelan, S.D. and Saranya, K. and Arthisree, M.},
  booktitle={2024 International Conference on Advances in Computing, Communication and Applied Informatics (ACCAI)}, 
  title={Experimental Evaluation of Learning Based River Path Sensing and Classification Using Digital Satellite Images}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The river system is constantly stressed out by the demands for electricity, water, and food, despite its crucial role in the planet’s long-term viability. Automatic river mapping using satellite data has tremendous potential, according to recent advancements in machine learning. For sound management and policy choices, precise and up-to-date water extent data may be provided via surface river mapping. Nevertheless, due to imperfect labeling, geographical variability, and noise in satellite data, precise large-scale river mapping continues to be a formidable challenge. The accessibility of excellent quality imagery from satellites, user-friendly programming tools, and high-end consumer computing power have all contributed to the recent alignment of the information analytics and satellite imagery groups. The area of remote sensing and image processing faces a formidable obstacle in the process of water body segmentation. The generation of index characteristics by merging distinct spectra is a common component of classical strategies for countering this problem. On the other hand, these approaches rely heavily on rules and don’t account for context. This paper introduces a novel approach to river path identification and classification using the Estimated Learning for Path Sensing and Classification (ELPSC) model. To assess the effectiveness of the proposed scheme, it is cross-validated with the conventional Support Vector Machine (SVM) classification model. Even with sparse and noisy data, we show that the suggested contrasting model of learning can successfully map a number of rivers.},
  keywords={Support vector machines;Satellites;Uncertainty;Vectors;Rivers;Sensors;Satellite images;Deep Learning;River Path Sensing;Classification;Satellite Images;Estimated Learning;ELPSC;Support Vector Machine;SVM},
  doi={10.1109/ACCAI61061.2024.10602066},
  ISSN={},
  month={May},}@INPROCEEDINGS{11280985,
  author={Amin, Kaushal Girishkumar and Patidar, Mukesh and Patidar, Praveen Kumar and Rafaliya, Navneet Kumar Rameshbhai and Joshi, Jayesh and Mishra, Dron},
  booktitle={2025 IEEE International Conference on Advances in Computing Research On Science Engineering and Technology (ACROSET)}, 
  title={A Review on Robotics and Automation Techniques for Quality Inspection in Industry 4.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Industry 4.0 is revolutionizing the world of manufacturing by merging modern digital technologies with conventional production techniques. One of the most crucial advancements is the use of robotics and automated systems for quality checking, which improves accuracy, consistency, and real-time sensitivity. In this paper, deep robotics-based quality control systems are presented with an in-depth analysis focusing on the incorporation of artificial intelligence (AI), machine vision, and sensor networks. The transformation towards Industry 4.0 has heightened the demand for smart and automated quality inspection systems that can work with speed, accuracy, and flexibility. Traditional inspection methods tend to fail in meeting the increasing complexity and amount of contemporary manufacturing processes. Robotics and automation, enabled by machine learning, computer vision, and sensor fusion, offer a revolutionary solution to such issues. This paper contribution acknowledges the manner in which these technologies are transforming industrial quality assurance in the context of Industry 4.0.},
  keywords={Accuracy;Sensitivity;Service robots;Quality control;Inspection;Sensor fusion;Robot sensing systems;Real-time systems;Fourth Industrial Revolution;Smart manufacturing;Industry 4.0 (I.4.0);Artificial Intelligence;Robotics and Automation;Smart Manufacturing;Quality Inspection;Digital Twin;Edge AI},
  doi={10.1109/ACROSET66531.2025.11280985},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10827628,
  author={Yi, Wenbin and Xu, Dan and Zhou, Yang},
  booktitle={2024 7th International Conference on Pattern Recognition and Artificial Intelligence (PRAI)}, 
  title={A Polyp Segmentation Method Combining Cross-Layer Attention and Boundary Refinement}, 
  year={2024},
  volume={},
  number={},
  pages={143-149},
  abstract={Accurate segmentation of polyps provides an important basis for detecting and preventing colorectal cancer. However, due to the notable variations in the position, size, and number of polyps across different images, and certain images depict polyps with indistinct boundaries, a higher false negative rate was observed in existing algorithms for colorectal polyp segmentation. In this study, we propose a novel colorectal polyp segmentation algorithm that leverages cross-layer attention and boundary refinement techniques. Firstly, a multi-scale feature enhancement module targeting deep features has been designed to accurately locate polyp targets within deep feature maps. In addition, during the decoding phase, spatial attention is extracted from deep features and utilized to weight shallow features, allowing for a progressive fusion from deep to shallow layers, thereby refining the segmentation instances. Finally, the merged features undergo boundary refinement to produce the segmentation map. We performed comprehensive experiments on five widely utilized public datasets. Our algorithm demonstrates superior capabilities in reducing false negative in challenging polyp images compared to existing mainstream polyp segmentation networks.},
  keywords={Image segmentation;Cross layer design;Semantics;Refining;Lighting;Feature extraction;Real-time systems;Pattern recognition;Decoding;Iterative decoding;Medical image segmentation;Colorectal polyps;Convolutional neural network;Attention mechanism;Boundary refinement},
  doi={10.1109/PRAI62207.2024.10827628},
  ISSN={},
  month={Aug},}@ARTICLE{10938896,
  author={Xu, Chen and Lan, Tian and Ji, Yu and Yu, Changlong and Wang, Wei and Gao, Jun and Dong, Qunxi and Qian, Kun and Li, Piji and Bi, Wei and Hu, Bin},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={Decider: A Dual-System Rule-Controllable Decoding Framework for Language Generation}, 
  year={2025},
  volume={37},
  number={7},
  pages={3976-3990},
  abstract={Constrained decoding approaches aim to control the meaning or style of text generated by a Pre-trained Language Model (PLM) for various task-specific objectives at inference time. However, these methods often guide plausible continuations by greedily and explicitly selecting targets, which, while fulfilling the task requirements, may overlook the natural patterns of human language generation. In this work, we propose a novel decoding framework, Decider, which enables us to program high-level rules on how we might effectively complete tasks to control a PLM. Differing from previous works, our framework transforms the encouragement of concrete target words into the encouragement of all words that satisfy the high-level rules. Specifically, Decider is a dual system in which a PLM is equipped and controlled by a First-Order Logic (FOL) reasoner to express and evaluate the rules, along with a decision function that merges the outputs from both systems to guide the generation. Experiments on CommonGen and PersonaChat demonstrate that Decider can effectively follow given rules to guide a PLM in achieving generation tasks in a more human-like manner.},
  keywords={Decoding;Logic;Libraries;Training;Oral communication;Adaptation models;Wheels;Probability distribution;Vocabulary;Vectors;Controllable text generation;constrained decoding;first order logic;neuro-symbolic;knowledge graph},
  doi={10.1109/TKDE.2025.3554819},
  ISSN={1558-2191},
  month={July},}@INPROCEEDINGS{9185412,
  author={Tapp, Austin and Audette, Michel},
  booktitle={2020 Spring Simulation Conference (SpringSim)}, 
  title={“Surgical Gps” Proof of Concept for Scoliosis Surgery}, 
  year={2020},
  volume={},
  number={},
  pages={1-12},
  abstract={Scoliotic deformities may be addressed with either anterior or posterior approaches for scoliosis correction procedures. While typically quite invasive, the impact of these operations may be reduced through the use of computer-assisted surgery. A combination of physician-designated anatomical landmarks and surgical ontologies allows for real-time intraoperative guidance during computer-assisted surgical interventions. Predetermined landmarks are labeled on an identical patient model, which seeks to encompass vertebrae, intervertebral disks, ligaments, and other soft tissues. The inclusion of this anatomy permits the consideration of hypothetical forces that are previously not well characterized in a patient-specific manner. Updated ontologies then suggest procedural directions throughout the surgical corridor, observing the positioning of both the physician and the anatomical landmarks of interest at the present moment. Merging patient-specific models, physician-designated landmarks, and ontologies to produce real-time recommendations magnifies the successful outcome of scoliosis correction through enhanced pre-surgical planning, reduced invasiveness, and shorted recovery time.},
  keywords={Solid modeling;Surgery;Ontologies;Deformable models;Computational modeling;Ligaments;Finite element analysis;Scoliosis Surgery Planning;Surgical Process;Deformable Surface;Robot Assisted Surgery;Surgical Ontologies},
  doi={10.22360/SpringSim.2020.MSM.007},
  ISSN={},
  month={May},}@INPROCEEDINGS{11336139,
  author={Venkatesh, Kummari and Yajjala, Anitha and Raju, Muntha. and Prasad, Akku Naga and Vamshi, Kusuma and Manvithx, Cheppal},
  booktitle={2025 Third International Conference on Emerging Applications of Material Science and Technology (ICEAMST)}, 
  title={AnatoViz3D: AI-Powered Human Body Visualization from Medical Reports}, 
  year={2025},
  volume={},
  number={},
  pages={1585-1590},
  abstract={Medical imaging reports such as CT, MRI, and X-ray scans often contain complex medical terminology that can be challenging for patients to understand and time-intensive for doctors to interpret. To address this gap, this study presents AnatoViz 3D, an AI-powered, web-based framework that converts traditional two-dimensional (2D) medical reports into interactive three-dimensional (3D) anatomical visualizations. The system combines deep learning and natural language processing (NLP) techniques to extract diagnostic details from both text and image data. A Flask/FastAPI backend supports model inference using TensorFlow and PyTorch, while the front-end, built with React.js and Three.js, dynamically highlights detected abnormalities on a 3D human model. All information is securely managed through MongoDB/PostgreSQL databases with encrypted transactions, ensuring compliance with healthcare data standards. By merging AI-driven intelligence, interactive visualization, and an explainable design, AnatoViz 3D offers an efficient, transparent, and patient-friendly solution for medical report interpretation, ultimately enhancing doctor-patient communication and improving diagnostic understanding.},
  keywords={Deep learning;Solid modeling;Three-dimensional displays;Terminology;Two-dimensional displays;Data visualization;Medical services;Natural language processing;Medical diagnostic imaging;X-ray imaging;Artificial Intelligence;Medical Visualization;Deep Learning;3D Anatomy;Natural Language Processing;Healthcare Informatics;Human-Computer Interaction},
  doi={10.1109/ICEAMST67459.2025.11336139},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11385716,
  author={Ali, Hassan Mohamed and Roy, Lincy and Subburam, S. and Durga, J.M. and Kalidas, N. and Musurmanova, Shakhnoza and Dolikhonovich, Turgunov Sherali},
  booktitle={2025 International Conference on Innovations and Emerging Technologies In AI & Communication Systems (IETACS)}, 
  title={Voice-Activated Meeting Assistant for Real-Time Agenda Tracking and Summarization}, 
  year={2025},
  volume={},
  number={},
  pages={1521-1527},
  abstract={Meeting management plays a vital role in organizational productivity, yet challenges such as agenda drift, time wastage, and inefficient note-taking often hinder effective discussions. Traditional meeting assistants primarily perform transcription but lack contextual understanding, making them incapable of managing dynamic meeting flows. To address these issues, this paper introduces VAMAR (Voice-based Adaptive Meeting Assistant for Real-time), a context-aware system designed to ensure real-time adaptive agenda tracking and on-the-fly summarization. VAMAR integrates advanced speech recognition with a transformer-based intent detection model to interpret conversational context, detect topic shifts, and adapt agendas accordingly. The Adaptive Agenda Model (AAM) dynamically restructures discussion points by merging or dividing topics, while the Participant Engagement Module (PEM) minimizes agenda deviation through subtle, non-intrusive voice prompts. Simultaneously, the Real-Time Summarization Engine (RTSE) generates concise, context-sensitive summaries and action points accessible during the meeting. Evaluation results demonstrate over 90% accuracy in agenda tracking and high user satisfaction due to improved focus and reduced interruptions. By combining real-time understanding, adaptability, and automation, VAMAR represents a next-generation intelligent meeting management framework that enhances collaboration efficiency and decision-making quality.},
  keywords={Training;Adaptation models;Adaptive systems;Accuracy;Oral communication;Transformers;Real-time systems;Hazards;Engines;Context modeling;Voice-Activated Assistant;Real-Time Agenda Tracking;Adaptive Agenda Model;Meeting Summarization;Context-Aware Intent Detection;Proactive Participant Engagement;Dynamic Meeting Management},
  doi={10.1109/IETACS68750.2025.11385716},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11518941,
  author={Pal, Vibhor},
  booktitle={2026 3rd International Conference on Research Methodologies in Knowledge Management, Artificial Intelligence and Telecommunication Engineering (RMKMATE)}, 
  title={Adaptive Hierarchical Reinforcement and Meta-Learning for Dynamic Load Balancing in 5G-Integrated Smart Grids: A Study Using Real-Time Load Monitoring Data}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={The increasing sophistication of contemporary smart grids, compounded by the inclusion of renewable energy sources, and 5G supporting communication networks, requires smart and dynamic load management system. This paper uses the Smart Grid Real-Time Load Monitoring Dataset to create a reinforcement learning (RL)-based model of efficient energy distribution. This methodology utilizes Hierarchical Reinforcement Learning (HRL) using multi-agent coordination and meta-learning and is compared with Flat RL and Traditional Load Balancing Heuristic methods. The experimental findings prove that HRL has the best performance, with the mean reward of 346.98, the smallest load variation (0.000529), and a maximum electricity cost reduction of 15%, and is stable despite the changing 5G latency and variable renewable generation. HRL displays better adaptability, better load balancing, better utilization of renewable energy and better real-time response compared to Flat RL and heuristic approaches. A scalable, resilient, and practically applicable approach for next-generation energy systems is provided by the research, which emphasizes the need to merge hierarchical control with meta-learning in smart grid operations. These results provide a way forward for smart grid management that is intelligent, dependable, and sustainable, which is essential for making electrical networks more resilient and efficient.},
  keywords={Loading;Modeling;Smart grids;Timing;Renewable energy sources;Load management;Metalearning;Printing;Costing;Costs;Smart grid;load management;renewable energy integration;5G communication;meta-learning},
  doi={10.1109/RMKMATE69073.2026.11518941},
  ISSN={},
  month={April},}@INPROCEEDINGS{11491963,
  author={Ghafouri, Saeid and Fayyaz, Mohsen and Li, Xiangchen and John, Deepu and Ji, Bo and Nikolopoulos, Dimitrios S. and Vandierendonck, Hans},
  booktitle={2026 IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)}, 
  title={Polymorph: Energy-Efficient Multi-Label Classification for Video Streams on Embedded Devices}, 
  year={2026},
  volume={},
  number={},
  pages={6432-6441},
  abstract={Real-time multi-label video classification on embedded devices is constrained by limited compute and energy budgets. Yet, video streams exhibit structural properties such as label sparsity, temporal continuity, and label co-occurrence that can be leveraged for more efficient inference. We introduce Polymorph, a context-aware framework that activates a minimal set of lightweight Low Rank Adapters (LoRA) per frame. Each adapter specializes in a subset of classes derived from co-occurrence patterns and is implemented as a LoRA weight over a shared backbone. At runtime, Polymorph dynamically selects and composes only the adapters needed to cover the active labels, avoiding fullmodel switching and weight merging. This modular strategy improves scalability while reducing latency, and energy overhead. Polymorph achieves 40% lower energy consumption and improves mAP by 9 points over strong baselines executing the TAO dataset.},
  keywords={Feeds;Internet of Things;LoRa;Streaming media;Videos;Communication systems;Routing;Internet;Radio access networks;Regional area networks;video streams;multi-label classification;embedded devices;lora;energy efficiency},
  doi={10.1109/WACV61042.2026.00622},
  ISSN={2642-9381},
  month={March},}@ARTICLE{11313050,
  author={Zhang, Qing and Zeng, Sizhe and Chen, Yingru and Sun, Guanghui and Wen, Junhao},
  journal={IEEE Access}, 
  title={Adaptive Fusion of Dual-Scale Preference Disentanglement for Next POI Recommendation}, 
  year={2026},
  volume={14},
  number={},
  pages={5855-5868},
  abstract={Next point-of-interest (POI) recommendation has emerged as a key research topic within location-based social networks. Prior studies suggest that combining users’ enduring preferences with their short-term behaviors can substantially improve recommendation quality. However, since manually annotated labels distinguishing these two forms of interest are usually unavailable, many existing models tend to merge them during training, resulting in less accurate representations. In addition, the interaction between stable and dynamic interests is complex, and current approaches often struggle to model the evolving dependency. To overcome these challenges, we introduce a novel recommendation framework. Specifically, we adopt two bidirectional Transformer encoders to separately model general tastes and dynamic preferences. Preference labels are derived from users’ historical trajectories, and contrastive learning is applied to realize self-supervised separation of long- and short-term interests. Moreover, an attention mechanism with adaptive weighting is designed to integrate these two types of preferences to capture their dynamically changing dependencies. By leveraging spatio-temporal correlations across short-term and long-term sequences, our method generates more robust and distinctive preference representations. According to our review of prior studies, this work is the first POI recommendation study to employ a self-supervised strategy to explicitly distinguish between long- and short-term user preferences. Extensive experiments on three real-world datasets demonstrate that our method consistently outperforms both classical recommendation models and recent deep learning–based state-of-the-art baselines, achieving significant gains in HR@K and NDCG@K with average improvements of 21.73% (HR@5), 16.69% (HR@10), 12.97% (NDCG@5), and 5.90% (NDCG@10).},
  keywords={Trajectory;Accuracy;Contrastive learning;Transformers;Correlation;Attention mechanisms;User preference;Semantics;Adaptation models;Social networking (online);Contrastive learning;next POI recommendation;preferences disentanglement},
  doi={10.1109/ACCESS.2025.3647754},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11283772,
  author={Gaikwad, Rahul and Satpute, Monika and Phapale, Swejal and Patil, Harshada and Phapale, Bharati},
  booktitle={2025 9th International Conference on Computing, Communication, Control and Automation (ICCCBEA)}, 
  title={Multimodal Sentiment Analysis Using Deep Learning and Attentive Mechanism}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In today's digital era, interpreting human emotions from online content has become vital in sectors like marketing, customer support, healthcare, and social media analytics. This paper presents a robust multimodal sentiment analysis framework that combines textual and visual data to gain deeper emotional understanding. The approach employs Long Short-Term Memory (LSTM) networks to grasp contextual and sequential patterns in text, while EfficientNet, a cutting-edge convolutional neural network, is used to extract high-level features from images, including facial expressions and relevant visual cues. By merging the outputs from both modalities, the model accurately classifies emotions into five categories: very positive, positive, neutral, negative, and very negative. This dual-modality setup addresses the shortcomings of single-source sentiment analysis-such as the vagueness in text or the lack of depth in standalone images. Experimental results reveal that this integrated model delivers significantly higher accuracy and precision compared to traditional unimodal systems. Designed with real-time applications in mind, the system is well-suited for scenarios like monitoring social media trends, analyzing customer opinions, and improving virtual assistant interactions. The model's performance has been thoroughly validated using standard multimodal datasets, ensuring its adaptability and reliability. Ultimately, this research highlights the effectiveness of deep learning-based multimodal systems in decoding complex human emotions across a wide range of real-world applications.},
  keywords={Deep learning;Sentiment analysis;Visualization;Adaptation models;Social networking (online);Virtual assistants;Feature extraction;Reliability;Long short term memory;Standards;Multimodal sentiment analysis;deep learning;image-text integration;machine learning},
  doi={10.1109/ICCUBEA65967.2025.11283772},
  ISSN={2771-1358},
  month={Aug},}@INPROCEEDINGS{11071208,
  author={Choubey, Siddhartha and Choubey, Abha and Tiwari, Bhumi and Sharma, Samriddhi and Singh, Shubham},
  booktitle={2025 4th OPJU International Technology Conference (OTCON) on Smart Computing for Innovation and Advancement in Industry 5.0}, 
  title={Examining Concepts Design and Scheduling Techniques of Home Energy Management Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Growing demand for efficient residential energy management systems has led to better energy planning tools. This research employs recurrent neural networks (RNNs) to accurately predict household energy consumption. The system predicts energy usage based on prior data, surroundings, and user behavior. Energy managers may utilize this information. We use gradient descent and Adam optimization methods to improve accuracy and reduce errors during iterative improvements. The algorithm considers recurring patterns and outside elements, like weather and time of day, to produce reliable forecasts. Regularization prevents overfitting and ensures model performance with fresh data. Performance indicators like R2 and MAPE evaluate model accuracy, whereas confidence intervals provide a range of probable outcomes for more precise predictions. The recommended strategy prioritizes minimizing energy usage, making it cheaper, lowering high loads, and merging energy production. Easy battery storage with renewable energy sources makes the process environmentally friendly. Finally, the proposed strategy saves money, energy, and the environment while providing a complete and versatile solution for contemporary households.},
  keywords={Energy consumption;Renewable energy sources;Recurrent neural networks;Costs;Machine learning;Predictive models;Batteries;Reliability;Energy management systems;Load modeling;Adam;Battery storage;Cost efficiency;Environmental impact;Energy consumption;Energy generation integration;Machine learning;Peak load shaving;Predictive modeling;Recurrent neural networks},
  doi={10.1109/OTCON65728.2025.11071208},
  ISSN={},
  month={April},}@INPROCEEDINGS{10561186,
  author={S, Subhasri and T, Seyad Reesman and B, Dharshini and D, Saranya and D, Priyangababy},
  booktitle={2024 International Conference on Science Technology Engineering and Management (ICSTEM)}, 
  title={Performance Comparative Analysis of the Accuracy of CNN and RNN in Identifying Photovoltaic Cell Malfunctions}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The goal of this study is to minimize dimensionality in vibration data obtained from rotating machinery through the use of Principal Component Analysis (PCA) for feature extraction, hence enabling prompt failure identification in bearings. After PCA is used to handle the denoised signals, a hybrid deep learning model consisting of CNN and RNN is implemented. This combined method efficiently detects and categorizes different bearing problems by utilizing the temporal dependencies that RNNs learn and the spatial information that CNNs record. This methodology presents a comprehensive framework for proactive bearing health monitoring and maintenance by merging CNN and RNN architectures with PCA-based feature extraction. This might potentially optimize resource allocation and minimize downtime in industrial settings.},
  keywords={Fault diagnosis;Deep learning;Vibrations;Scalability;Feature extraction;Maintenance;Resource management;Photovoltaic(PV)cells;CNN;RNN;Deep learning;Principal component analysis;solar energy;performance analysis},
  doi={10.1109/ICSTEM61137.2024.10561186},
  ISSN={},
  month={April},}@INPROCEEDINGS{11339712,
  author={Zhou, Yalei and Liu, Junqiao and Wang, Jinkai},
  booktitle={2025 IEEE 3rd International Conference on Control, Electronics and Computer Technology (ICCECT)}, 
  title={Edge-Guided Camouflage-Based Target Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1912-1921},
  abstract={Focusing on camouflaged object detection, an emerging technology visual inspection task, this paper aims to develop a visual inspection system that can effectively localize and distinguish camouflaged targets in complex backgrounds. A series of innovative models are designed to achieve this goal. The network employs an edge detector to effectively integrate the feature map, which significantly enhances the Ability of model to capture edge information, the multi-scale contextual feature extractor module not only improves the accuracy of saliency detection, but also enhances the Ability of model ability. An edge guidance module is introduced, which injects the edge information into the feature learning, and further enhances the structural features of the target by merging the additional boundary information that thereby optimizing the detection performance at the intersection of foreground and background, the context aggregation module is designed to aggregate contextual information at different locations of the input data, which effectively enhances the Performance of model performance and generalization capability. The experimental results show that the method proposed in this paper achieves significant performance improvement on all three mainstream datasets, COD10K, CAMO and CHAMELEON, with $S_{\alpha}{-}$ values improved by 0.24%, 2.54% and 0.78%, respectively. Compared with the current state-of-the-art SINet method, the $F_{\beta}^{\omega}$ -values of this Performance of paper method on the above datasets are improved by 14.1%, 13.3% and 10.5%, respectively. These results fully validate the effectiveness and complexity of this paper's method in the camouflaged object detection task.},
  keywords={Representation learning;Analytical models;Visualization;Image edge detection;Object detection;Detectors;Inspection;Feature extraction;Data mining;Context modeling;Visual Inspection;Camouflage target;Edge detection;Multi-scale features;Feature learning},
  doi={10.1109/ICCECT64621.2025.11339712},
  ISSN={},
  month={April},}@INPROCEEDINGS{8981512,
  author={Smirnov, Alexander and Ponomarev, Andrew},
  booktitle={2019 25th Conference of Open Innovations Association (FRUCT)}, 
  title={Human-Machine Collective Intelligence Environment for Adaptive Decision Support}, 
  year={2019},
  volume={},
  number={},
  pages={285-291},
  abstract={Crowd computing has become an important and widely used way to solve various problems by joint effort of humans and machines. In most of the systems, leveraging elements of crowd computing, workflow or algorithm (how to split the original problem into parts, how to distribute them between human participants and how to merge the results received from different human participants) is defined as a part of system design. While it pays back in a wide range of tasks (usually simple ones), it is widely recognized that rigid workflows turn out to be very limiting when applied to complex problems (e.g., decision support). The paper proposes an approach to create flexible and adaptive decision support systems on the basis of an environment, supporting human-machine collective intelligence. The distinctive features of the proposed environment are: a) fusion of elements of collective intelligence and artificial intelligence, b) support for natural self-organization processes in the community of participants (supported by self-organization protocols, convenient for different kinds of participants of a heterogeneous human-machine system), c) interoperability of participants (both human and machine), achieved via multi-aspect ontologies, d) soft guidance in the process of self-organization.},
  keywords={Decision support systems;Technological innovation;Protocols;Limiting;Human-machine systems;Collective intelligence;Ontologies;Artificial intelligence;System analysis and design;Interoperability},
  doi={10.23919/FRUCT48121.2019.8981512},
  ISSN={2305-7254},
  month={Nov},}@ARTICLE{11449244,
  author={Vespa, Thiago GALBIATTI and Eleutério, Igor A. R. and Traina, Agma J. M. and Bertato, Fabio M. and Junior, Caetano Traina},
  journal={IEEE Open Journal of the Computer Society}, 
  title={A Framework for Predictive Similarity Queries Over Heterogeneous Metric Spaces}, 
  year={2026},
  volume={7},
  number={},
  pages={635-646},
  abstract={In this paper, we introduce the concept of predictive multimodal queries within the framework of multi-metric spaces, establishing a foundation for predictive analysis through similarity-based retrieval. We present a reverse regression algorithm specifically designed to exploit the expressiveness of multi-metric queries, enabling the merging and comparative analysis of results across distinct metric spaces. Two fundamental operations are formalized: the multi-metric intersection and union queries, which serve as the foundation for predictive analysis. Building upon these, we define three advanced types of multi-metric queries: the Union-Representative Query (URQ), the Multi-Representative Query (MRQ), and the Headed-Representative Query (HRQ), each supporting a distinct predictive strategy. These methods bridge the gap between similarity-based retrieval and attribute prediction, extending the analytical capability of metric-space models toward multimodal predictive analysis. To ensure practical applicability, we developed a computational framework, including both an engine and an open-source library, providing tools for the implementation of multi-metric queries and reverse regression techniques.},
  keywords={Extraterrestrial measurements;Semantics;Vectors;Predictive analytics;Predictive models;Nearest neighbor methods;Feature extraction;Computational modeling;Numerical models;Indexes;Content-based retrieval;database queries;metric spaces;multi-metric queries;multi-metric spaces;multimodal analysis;predictive queries;regression analysis;similarity queries},
  doi={10.1109/OJCS.2026.3676153},
  ISSN={2644-1268},
  month={},}@INPROCEEDINGS{10578433,
  author={Sharma, Abhilasha and Kansal, Vaibhav},
  booktitle={2024 5th International Conference on Recent Trends in Computer Science and Technology (ICRTCST)}, 
  title={Comprehensive Evaluation of CNN, RNN, and CRNN for document retrieval in Healthcare Systems}, 
  year={2024},
  volume={},
  number={},
  pages={491-496},
  abstract={Document Retrieval (DR) is pivotal in unlocking valuable insights from the ever-growing volume of medical literature. However, precise knowledge extraction from complicated clinical notes, discharge summaries, and research papers is still difficult. However, capturing these distinct dimensions of medical discourse and the complex interdependencies between entities with the currently used approaches becomes difficult. This work solves these shortcomings by introducing a convolutional recurrent neural network (CRNN) framework that merges the advantages of CNNs and RNNs to achieve very high accuracy in medical document extraction tasks. In the CRNN model, the spatial feature extraction capacity of CNNs is integrated with the sequential learning capabilities of RNNs to successfully find medical entities and understand their complex interrelationships, which leads to high-performance document classification. As shown in the case of CORD-19, our CRNN model significantly outperforms individual CNN and RNN models on its entity recognition and relationship extraction tasks (98.93% accuracy), demonstrating that using CRNN in medical documents can yield much better results, thus increasing opportunities for informed clinical decisions, advanced drug discovery, and improved public health interventions.},
  keywords={Accuracy;Recurrent neural networks;Computational modeling;Scalability;Computer architecture;Feature extraction;Convolutional neural networks;Document retrieval;CNN;RNN;CRNN;CORD-19},
  doi={10.1109/ICRTCST61793.2024.10578433},
  ISSN={},
  month={April},}@INPROCEEDINGS{11327746,
  author={Chadha, Mayank and Chen, Guodong and Balamurugan, Barath and Yang, Zhewen and Mishra, Alok and Dasari, Mallesham},
  booktitle={2025 IEEE International Symposium on Emerging Metaverse (ISEMV)}, 
  title={XRFab: Immersive Cleanroom Training with Digital Twins and XR for Semiconductor Manufacturing}, 
  year={2025},
  volume={},
  number={},
  pages={55-61},
  abstract={Semiconductor manufacturing requires high-precision workflows performed in controlled cleanroom environments, making operator training both essential and logistically challenging. Traditional training approaches like classroom/video lectures or equipment simulations often fail to capture the spatial complexity, safety constraints, and decision-making properties of cleanroom tasks like silicon wafer handling. In this paper, we present XRFab, an immersive training system that integrates Extended Reality (XR) with Digital Twin modeling to provide a data-driven, interactive cleanroom simulation. XRFab enables users to experience and manipulate cleanroom workflows under dynamic environmental conditions. We have built a prototype of XRFab using the Meta Quest 3 headset and the Unity platform with haptic feedback. Our system lays the groundwork for safe and low-cost training tools for semiconductor fabrication and highlights a promising direction for merging XR and Digital Twin technologies in industrial education.},
  keywords={Training;Semiconductor device modeling;Fabrication;Translation;Extended reality;Semiconductor device manufacture;Silicon;Digital twins;Telemetry;System implementation;Extended Reality;Digital Twins;Silicon Wafer Locking;Cleanroom Training;Semiconductor Manufacturing},
  doi={10.1109/ISEMV67326.2025.00020},
  ISSN={},
  month={Oct},}@ARTICLE{11397710,
  author={Ahmad, Tanveer and Al-Ammar, Essam A.},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={Adaptive Hybrid Energy Harvesting with Integrated Sensing and Communication for Consumer IoT Networks}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={The growth of IoT in smart cities, industry, and consumer electronics requires energy-efficient solutions. This study presents the Adaptive Hybrid Energy Harvesting Algorithm (AHEHA) equipped with Integrated Sensing and Communication (ISAC). AHEHA-ISAC merges solar, thermal, and vibration energy harvesting with dynamic resource management, adaptive scheduling, and joint sensing–communication. Unlike traditional approaches, the proposed technique adopted entropy-maximizing strategies to diversify energy sources that minimize variability and balance sensing quality. The simulation shows the AHEHA-ISAC technique not only increases the network lifetime but also increases residual battery by 27.6%, and packet delivery by 14.9%. It also gains an average energy efficiency of 2.31± joules of work per joule (sensing-communication workload) harvested, surpassing the best reinforcement learning at 1.64 joules. Additionally, the joint optimization reduces latency by 37.7% at high traffic λ = 0.8, with delays below 60 ms, and boosts task completion by over 20%.},
  keywords={Internet of Things;Sensors;Resource management;Wireless sensor networks;Energy harvesting;Energy efficiency;Radio frequency;Adaptive systems;Intelligent sensors;Dynamic scheduling;Internet of Things (IoT);Energy Harvesting;Energy Efficiency;Renewable Energy Integration},
  doi={10.1109/TCE.2026.3665569},
  ISSN={1558-4127},
  month={},}@INPROCEEDINGS{11469331,
  author={S, Manikandan and D, Abinaya and E, Sathesh Abraham Leo and Babu, M. Harish and Ravivarman, G. and Thomas, Aby K},
  booktitle={2026 Second International Conference on Multi-Agent Systems for Collaborative Intelligence (ICMSCI)}, 
  title={A Comprehensive Review of Hybrid Solar-Powered EV Charging Stations: Advanced MPPT and Converter Technologies}, 
  year={2026},
  volume={},
  number={},
  pages={1325-1332},
  abstract={The global transition to electric vehicles is crucial for decarbonizing transport, but it risks straining power grids and increasing emissions if electricity demand is met conventionally. Hybrid Solar-Powered EV Charging Stations (HSPECS) address this by using solar energy, backed by the grid or storage, for clean mobility. Their efficiency relies on two key power electronic components: Maximum Power Point Tracking (MPPT) controllers to optimize solar energy harvest, and DC-DC converters to condition this power for batteries. This review systematically analyses modern MPPT algorithms-from classic methods to advanced AI-based techniques-and their implementation with various DCDC converters. Through detailed comparisons, it finds that a hybrid MPPT approach, merging conventional robustness with AI-driven precision, implemented via a multi-port isolated DC-DC converter, is the most promising path for developing efficient, reliable, and intelligent HSPECS.},
  keywords={Low earth orbit satellites;Artificial satellites;Oscillators;Zero voltage switching;Capacitors;Zero current switching;Voltage multipliers;Switching circuits;Diodes;Filtering;Electric Vehicle (EV);Photovoltaic (PV);Hybrid Charging;Maximum Power Point Tracking (MPPT);DC-DC Converters;Grid Integration;Power Electronics},
  doi={10.1109/ICMSCI67830.2026.11469331},
  ISSN={},
  month={March},}@ARTICLE{11348025,
  author={Alzamil, Ahmed and Guesmi, Ramzi and Alghadhban, Amer and Guesmi, Tawfik and Kachouri, Abdennaceur},
  journal={IEEE Access}, 
  title={DualBERT: Fusing Symbolic and Temporal Dynamics for High-Precision Log Anomaly Detection}, 
  year={2026},
  volume={14},
  number={},
  pages={11369-11384},
  abstract={Anomaly detection in system logs has attracted considerable interest with the development of deep learning and big data. Many methods and approaches have achieved good results in log anomaly detection, but exploiting the rich dependencies hidden in log data remains an extremely challenging task. Recently, Transformer-based models, such as LogBERT, represent a strong and promising foundation thanks to their ability to capture rich contextual information within log sequences. The limitation of these models is that they mainly treat logs as a sequence of discrete tokens, neglecting the crucial and continuous information embedded in the temporal and numerical dynamics between events. This limitation can lead to a high false positive rate, thus reducing the practical utility of the model. In this work, we propose DualBERT, a hybrid framework designed to address this gap. Our approach leverages a dual-model architecture: 1) a primary Transformer (LogBERT) to analyze the log’s symbolic key sequence; 2) a parallel and specialized parameter model represented by an LSTM-based regressor that analyzes inter-event features such as temporal deltas and cyclic patterns. The anomaly scores of both models are then fused using an XGBoost classifier to produce a final robust decision. We conduct a rigorous and fully supervised evaluation on the HDFS benchmark dataset. Our results demonstrate that DualBERT achieves an F1 score of 98.75%, significantly surpassing the satisfactorily evaluated LogBERT benchmark (98.29%). This improvement is mainly due to a substantial increase in accuracy (from 96.64% to 97.70%) and a 43% reduction in the false positive rate. Our results confirm that merging symbolic sequence analysis with dedicated inter-event dynamic modeling is an effective strategy to create a more reliable and practical system for real-world logarithmic anomaly detection.},
  keywords={Anomaly detection;Transformers;Deep learning;Adaptation models;Training;Numerical models;Benchmark testing;Analytical models;Accuracy;Semantics;Log anomaly detection;deep learning;transformer;LogBERT;feature fusion;dual-model architecture;time-series analysis;XGBoost},
  doi={10.1109/ACCESS.2026.3653996},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11374361,
  author={Aggarwal, Bhuvan and More, Amit and Soni, Mudit and Bhat, S Divakar},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision Workshops (ICCVW)}, 
  title={Model Ensemble to Fuse Geometric and Learning Solutions for Camera Rotation Estimation}, 
  year={2025},
  volume={},
  number={},
  pages={159-168},
  abstract={Camera rotation estimation is an important task in many computer vision applications, such as Bird's Eye View (BEV) generation for autonomous driving to better understand the surroundings. In this work we focus on single-image camera rotation estimation, particularly roll and pitch. Recently, many deep learning based approaches are proposed to solve this task with complex pipelines to fuse geometric information into the learning process. Contrary to this common approach, we present a simple model ensemble approach to merge learning based and geometric solutions. This approach allows us to take advantage of the best of both worlds, i.e. stability of learning-based solutions and high accuracy of geometric solutions. In particular, the proposed geometric solution has very high accuracy when parallel lines are present and detected, whereas a learning-based solution still provides stable estimates when geometric approach fails in the absence of such conditions. Such a simple approach is highly robust and accurate at the same time and outperforms all the complex pipelines in the literature. Our method achieves state-of-the-art performance on the Google Street View, TartanAir and MegaDepth datasets giving a median error of 0.71°, 0.89° and 0.94° for pitch angle and 0.27°, 0.40° and 0.32° for roll angle estimation.},
  keywords={Computer vision;Accuracy;Fuses;Pipelines;Semantics;Estimation;Cameras;Stability analysis;Robustness;Internet},
  doi={10.1109/ICCVW69036.2025.00023},
  ISSN={2473-9944},
  month={Oct},}@INPROCEEDINGS{10074381,
  author={Srivastava, Ayushi and Meena, Isha and Manisha, K. and Bansal, Ankita},
  booktitle={2022 4th International Conference on Advances in Computing, Communication Control and Networking (ICAC3N)}, 
  title={Comparison of CNN models for picture description application}, 
  year={2022},
  volume={},
  number={},
  pages={1579-1585},
  abstract={Blindness makes life tough for those who suffer from it, but machine learning can assist the visually impaired with their day - to - day tasks. Presently, image to speech is a relatively new and naïve topic. It’s a machine learning problem that requires both natural language processing and computer vision to analyze visual content. In this context, this work focuses on the development of a photo-to-speech application for the visually impaired people. The work’s ideology aims to make an impact on society so that visually impaired people can achieve equality. We merged picture and text processing in this work to build a practical deep learning application.},
  keywords={Deep learning;Visualization;Computer vision;Neural networks;Transforms;Feature extraction;Natural language processing;Convolutional neural network;deep learning;image captioning;machine learning;word embedding},
  doi={10.1109/ICAC3N56670.2022.10074381},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11033246,
  author={Wan, Yan and Wu, Yanzhen and Hu, Xiao and Yao, Li},
  booktitle={2025 28th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={Advanced Methods for Text Detection and Recognition in Customs Declaration Forms: The EFF-DBNet and SKSVTR}, 
  year={2025},
  volume={},
  number={},
  pages={564-569},
  abstract={Customs documents contain a large amount of information. The image quality of customs declaration forms is often poor, with issues such as blurred characters, missing strokes, stroke merging, and noise contamination, which increase the difficulty of detection and recognition. Previous approaches for text detection and recognition have already achieved promising performances across various benchmarks. However, they usually fall short when dealing with customs declaration forms. In this paper, we propose EFF-DBNet, an efficient text detector, and SKSVTR, an advanced text recognition model. In the detection stage, we redesign the network based on the DBNet. We introduce the Efficient Channel Attention to extract features from image and utilize Feature Pyramid Enhancement Modules (FPEMs) for feature enhancement, then use a Feature Fusion Module to gather the features given by FPEMs of different depths into a final feature. For the recognition stage, we improve the SVTR model by replacing the local mixing in the backbone network with convolutional modules, and then introduce the Selective Kernel Attention to effectively capture multi-scale features in the image space. Experimental results on customs declaration forms demonstrate the effectiveness of our methods, which outperform existing methods.},
  keywords={Visualization;Image recognition;Attention mechanisms;Text recognition;Optical character recognition;Noise;Text detection;Benchmark testing;Feature extraction;Character recognition;Optical character recognition;text detection;text recognition;customs declaration forms;attention mechanism},
  doi={10.1109/CSCWD64889.2025.11033246},
  ISSN={2768-1904},
  month={May},}@INPROCEEDINGS{11294702,
  author={Sridharan, Shrihari and Selvam, Surya and Roy, Kaushik and Raghunathan, Anand},
  booktitle={2024 61st ACM/IEEE Design Automation Conference (DAC)}, 
  title={Ev-Edge: Efficient Execution of Event-based Vision Algorithms on Commodity Edge Platforms}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Event cameras have emerged as a promising sensing modality for autonomous navigation systems, owing to their high temporal resolution, high dynamic range and negligible motion blur. To achieve the best performance across a range of vision tasks using the asynchronous temporal event streams from such sensors, recent research has shown that a mix of Artificial Neural Networks (ANNs), Spiking Neural Networks (SNNs), as well as hybrid SNN-ANN algorithms are desirable. However, we observe that such workloads achieve poor utilization and performance on commodity edge platforms which feature heterogeneous processing elements such as CPUs, GPUs and neural accelerators. This is due to the mismatch between the irregular nature of event streams and diverse characteristics of algorithms on the one hand and the underlying hardware platform on the other. We propose Ev-Edge, a framework that contains three key optimizations to boost the performance of event-based vision algorithms on edge platforms: (1) An Event2Sparse Frame converter directly transforms raw event streams into sparse frames, enabling the use of sparse libraries with minimal encoding overheads (2) A Dynamic Sparse Frame Aggregator merges sparse frames at runtime by trading off the temporal granularity of events and computational demand, thereby improving hardware utilization, and (3) A Network Mapper maps concurrently executing tasks to different processing elements while also selecting layer precision while considering both compute and communication overheads. On several state-of-art networks for a range of autonomous navigation tasks, Ev-Edge achieves 1.28x-2.05x improvements in latency and 1.23x-2.15x in energy over an all-GPU implementation on the NVIDIA Jetson Xavier AGX platform for single-task execution scenarios. Ev-Edge also achieves 1.43x-1.81x latency improvements over round-robin scheduling methods in multi-task execution scenarios.},
  keywords={Runtime;Event detection;Heuristic algorithms;Transforms;Multitasking;Hardware;Inference algorithms;Sensors;Optimization;Autonomous robots},
  doi={},
  ISSN={},
  month={June},}@INPROCEEDINGS{10831983,
  author={Rong, Chunyu and Li, Yi},
  booktitle={2024 IEEE International Conference on Systems, Man, and Cybernetics (SMC)}, 
  title={LB-VTON: Lower-Body Virtual Try-On via Differential Constraints and Adversarial Training Strategies}, 
  year={2024},
  volume={},
  number={},
  pages={121-127},
  abstract={Recently, significant progress has been made in image-based virtual try on systems, but their recent advances have mainly focused on upper-body cloths at the expense of lower-body cloth try on. Problems such as the complexity of leg poses and inappropriate regularization parameters lead to the remaining challenges in virtual try on of lower-body cloths. Here, we propose a novel lower-body virtual try on network called LB-VTON, which synthesizes realistic images given images of the wearer and the target cloth. To better preserve cloth and body features, LB-VTON employs a four-stage design strategy. First, it preprocesses the image to delineate body parts and cloth regions using methods such as human parsing. Secondly it uses a regression network approach to improve the resolution and fidelity of the try on images by estimating the parameter L of the thin-sheet spline transform using second-order differential constraints derived from actual mesh data. In the third step, to overcome the problem of fabric blurring and texture loss, it employs a generative adversarial training strategy that seamlessly merges the deformed cloths with the target model by utilizing the U-Net architecture as the generator and the enhanced DC-GAN as the discriminator. Finally, all images are zoomed to higher resolution $(768\times 1024)$ using Real-ESRGAN super-resolution technique. In addition, we present a novel lower body cloth try on dataset - the first of its kind specifically designed to improve the accuracy of lower body cloth try on. Experiments with this method on CP-VTON and its dataset show that the results produced by LB-VTON are significantly better than existing methods.},
  keywords={Training;Legged locomotion;Deformation;Superresolution;Transforms;Generative adversarial networks;Generators;Fabrics;Complexity theory;Splines (mathematics)},
  doi={10.1109/SMC54092.2024.10831983},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{8909533,
  author={Kwon, Jingun and Kobayashi, Naoki and Kamigaito, Hidetaka and Takamura, Hiroya and Okumura, Manabu},
  booktitle={2019 IEEE/WIC/ACM International Conference on Web Intelligence (WI)}, 
  title={Bridging Between Emojis and Kaomojis by Learning Their Representations from Linguistic and Visual Information}, 
  year={2019},
  volume={},
  number={},
  pages={116-123},
  abstract={Small images of emojis have unique characteristics as additional information in understanding writers' intentions. They enable social media users to emphasize their emotions and to express gestural movements in their posts. In addition to emojis, kaomojis (emoticons or facemarks) also behave in a similar way. They are composed of a sequence of characters, which are popularized especially in Asian countries. Although both emojis and kaomojis fulfill similar functions and share the same meaning that can be clues in opinion mining or sentiment analysis, the previous researches have been biased to explore emojis and kaomojis separately. In this paper, we align emojis and kaomojis together as a single token in the Japanese context to offer a bridge between them. Specifically, we aim to judge whether emojis and kaomojis share the same meaning or are similar with each other. We assume that emojis and kaomojis are both a single word in order to obtain their linguistic information with the skip-gram model. Furthermore, we present a new approach to consider the appearances of emojis and kaomojis in themselves, meaning that we explore the information of their visually similar shapes. We regard both of them as a single image to take into account their visual information with the CNN model. We merge two different perspectives toward emojis and kaomojis by exploring their linguistic and visual information simultaneously on the same space. The experimental results showed that we can align an unlimited number of emojis and kaomojis together with their representations (embeddings), and adding the visual information to the linguistic information can improve their representations.},
  keywords={Visualization;Linguistics;Twitter;Task analysis;Logic gates;Sentiment analysis;social media;Twitter;emojis;kaomojis;deep learning},
  doi={},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11445504,
  author={Feng, Qian and Tu, JiaHang and Kang, Mintong and Zhao, Hanbin and Zhang, Chao and Qian, Hui},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={FG-OrIU: Towards Better Forgetting via Feature-Gradient Orthogonality for Incremental Unlearning}, 
  year={2025},
  volume={},
  number={},
  pages={1957-1967},
  abstract={Incremental unlearning (IU) is critical for pre-trained models to comply with sequential data deletion requests, yet existing methods primarily suppress parameters or confuse knowledge without explicit constraints on both feature and gradient level, resulting in superficial forgetting where residual information remains recoverable. This incomplete forgetting risks security breaches and disrupts retention balance, especially in IU scenarios. We propose FGOrIU (Feature-Gradient Orthogonality for Incremental Unlearning), the first framework unifying orthogonal constraints on both features and gradients level to achieve deep forgetting, where the forgetting effect is irreversible. FGOrIU decomposes feature spaces via Singular Value Decomposition (SVD), separating forgetting and remaining class features into distinct subspaces. It then enforces dual constraints: feature orthogonal projection on both forgetting and remaining classes, while gradient orthogonal projection prevents the reintroduction of forgotten knowledge and disruption to remaining classes during updates. Additionally, dynamic subspace adaptation merges newly forgetting subspaces and contracts remaining subspaces, ensuring a stable balance between removal and retention across sequential unlearning tasks. Extensive experiments demonstrate the effectiveness of our method.},
  keywords={LoRa;Protocols;Quality of service;HTTP;Communication systems;Data communication;Radio communication;Videos;Video equipment;Electronics packaging;incremental unlearning;machine unlearning;complete forgetting;ai safety},
  doi={10.1109/ICCV51701.2025.00190},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{11485199,
  author={Wang, Xiyu and Chen, Changlin and Zhang, Bohao and Xu, Jia and Liu, Jiali and Zhang, Ye and Liu, Haijun and Li, Zhiwei},
  booktitle={2026 5th International Conference on Electronics Technology and Artificial Intelligence (ETAI)}, 
  title={Neural Network Quantization Based on 4-Bit Bivariate Lookup Table Activation*}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={With the deployment of deep neural networks to edge devices, low-bit (e.g., 4-bit) quantization has become a key technology for reducing computational and storage overhead. However, at low bit-widths, conventional one-dimensional activation functions face the challenge of numerical diversity loss, where a large number of features are merged into a limited number of quantization levels, resulting in significant information loss. For 4-bit quantized neural networks, this paper proposes Bivariate Lookup Table Activation, based on adaptive channel grouping. This method utilizes the channel locality of memory layout to design a channel cyclic shift operator without additional copies. Crucially, it introduces a correlation-based static reordering mechanism. By employing a spatial flattening strategy and a greedy sequence construction algorithm, the method maps semantically correlated channels to physically adjacent positions offline, thereby maximizing the validity of context information without increasing inference overhead. Coupled with a differentiable training technique based on bilinear interpolation it achieves the joint optimization of LUT parameters and network weights, overcoming the context-independent limitation of traditional one-dimensional activation functions. By introducing features from physically adjacent channels as context inputs, this paper constructs a two-dimensional mapping relationship that expands the theoretical input combinations from 16 to 256 without increasing the input bit-width, thereby enhancing the diversity of output feature representation. Experimental results demonstrate that this paper achieves $\mathbf{4}$-bit quantization performance of $\mathbf{6 9. 1 \%}$ (Top-1 accuracy) on ResNet-18 (ImageNet) and 77.5% ($\text{mAP}_{0.5}$) on YOLOv5s (Pascal VOC), respectively, outperforming existing methods such as LSQ. Furthermore, it adds a negligible storage overhead of only 128 bytes per layer, effectively balancing accuracy and efficiency in edge inference.},
  keywords={Field programmable gate arrays;Circuits;Logic gates;Integrated circuits;Network topology;Protocols;Network architecture;Pixel;Communications technology;HTTP;Neural Network Quantization;4-bit Quantization;Differentiable LUT;Bilinear Interpolation},
  doi={10.1109/ETAI68332.2026.11485199},
  ISSN={},
  month={March},}@INPROCEEDINGS{11486083,
  author={Lande, Jayapal and Chitkara, Arpanpreet Kaur and Sharma, Neha and Raina, Kartikeya and Vij, Suhail},
  booktitle={2026 Contemporary Computing Innovations Conference (CCIC)}, 
  title={Skies Decoded: Enhancing Weather Classification with Fine-Tuned ResNet50 and Deep Learning Insights}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Applications include transportation, disaster management, and agriculture depending on automated weather classification since accurate and timely forecasts can improve operational efficiency and decision-making. Using a carefully adjusted ResNet50 v1 model, this work categories meteorological conditions: dew, fog or smog, frost, glazing, hail, lightning, rain, rainbow, rime, sandy, snow. This work features $\mathbf{6, 8 6 2}$ images across eleven various weather categories. A balanced representation in the dataset is essential to reduce bias during model training considering the different complexity of every class. By meticulous study of class distribution and strict preprocessing techniques like normalization and resizing, effective learning-that is, that which addressed variations in picture quality, brightness, and resolution observed in real-world scenarios-was achieved. With general accuracy of 82%, the model evaluation based on precision and recall showed good performance over several classes. Major measurements include precision scores of 0.94 for dew and 0.97 for hail and a recall score of 0.92 for fog/smog, therefore reflecting the ability of the model to properly classify various meteorological situations. Future studies will concentrate on merging real-time meteorological data with looking at advanced deep learning architectures to raise classification accuracy even higher. Strong models developed by means of the acquired knowledge from this research could improve our knowledge and response to weather events, so benefiting many sectors and so improving safety and efficiency in operations depending on the weather.},
  keywords={Filtering;Filters;Streaming media;Videos;Protocols;Video equipment;HTTP;High frequency;Pixel;Radio access networks;Disaster management;normalization;real-time data integration;agricultural applications;predictive modelling;deep learning;convolutional neural networks},
  doi={10.1109/CCIC68129.2026.11486083},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10849498,
  author={Yu, Ting and Liu, Jiahui},
  booktitle={2024 IEEE 36th International Conference on Tools with Artificial Intelligence (ICTAI)}, 
  title={Multi-Task Learning of Visual Attributes for Image Aesthetics Assessment}, 
  year={2024},
  volume={},
  number={},
  pages={350-354},
  abstract={The complexity of individual aesthetic preferences for images is still not fully understood, making image aesthetic assessment a difficult challenge in AI. While many factors contribute to these preferences, certain aesthetic attributes play a key role. We also found that image composition significantly affects these preferences. Composition involves arranging different parts of an image, such as regions or objects, to create harmony and unity. In this research, we present a multi-task convolutional neural network that integrates these aesthetic attributes. This approach promotes better generalization by using shared representations. We propose a fully connected adaptor based on deep features to represent image composition, enabling end-to-end training with Pairwise Ranking loss and Euclidean loss. Additionally, we use a gate linear unit to merge composition and other aesthetic features for prediction. Our experiments show that the proposed model achieves the highest Spearman's rank correlation coefficient (SRCC) and linear correlation coefficient (LCC) for both overall aesthetic score and attribute score predictions across multiple datasets.Moreover, the multi-task network consistently outperforms in SRCC and LCC, highlighting the benefit of learning multiple aesthetic attributes simultaneously.},
  keywords={Correlation coefficient;Training;Visualization;Neural networks;Predictive models;Logic gates;Multitasking;Complexity theory;Convolutional neural networks;Artificial intelligence;deep learning;image aesthetics;image aesthetic assessment;multi-task learning;regression;Convolutional neural network},
  doi={10.1109/ICTAI62512.2024.00058},
  ISSN={2375-0197},
  month={Oct},}@INPROCEEDINGS{11334534,
  author={Yang, Yizhuo and Xu, Lingyun and Zhou, Mingyi and Li, Li},
  booktitle={2025 40th IEEE/ACM International Conference on Automated Software Engineering (ASE)}, 
  title={Context-Sensitive Pointer Analysis for ArkTS}, 
  year={2025},
  volume={},
  number={},
  pages={3262-3273},
  abstract={Current call graph generation methods for ArkTS, a new programming language for OpenHarmony, exhibit precision limitations when supporting advanced static analysis tasks such as data flow analysis and vulnerability pattern detection, while the workflow of traditional JavaScript(JS)/TypeScript(TS) analysis tools fails to interpret ArkUI component tree semantics. The core technical bottleneck originates from the closure mechanisms inherent in TypeScript’s dynamic language features and the interaction patterns involving OpenHarmony’s framework APIs. Existing static analysis tools for ArkTS struggle to achieve effective tracking and precise deduction of object reference relationships, leading to topological fractures in call graph reachability and diminished analysis coverage. This technical limitation fundamentally constrains the implementation of advanced program analysis techniques.Therefore, in this paper, we propose a tool named ArkAnalyzer Pointer Analysis Kit (APAK), the first context-sensitive pointer analysis framework specifically designed for ArkTS. APAK addresses these challenges through a unique ArkTS heap object model and a highly extensible plugin architecture, ensuring future adaptability to the evolving OpenHarmony ecosystem. In the evaluation, we construct a dataset from 1,663 real-world applications in the OpenHarmony ecosystem to evaluate APAK, demonstrating APAK’s superior performance over CHA/RTA approaches in critical metrics including valid edge coverage (e.g., a 7.1% reduction compared to CHA and a 34.2% increase over RTA). The improvement in edge coverage systematically reduces false positive rates from 20% to 2%, enabling future exploration of establishing more complex program analysis tools based on our framework. Our proposed APAK has been merged into the official static analysis framework ArkAnalyzer for OpenHarmony.},
  keywords={Measurement;Computer languages;Technological innovation;Trees (botanical);Ecosystems;Semantics;Static analysis;Syntactics;Optimization;Software engineering},
  doi={10.1109/ASE63991.2025.00269},
  ISSN={2643-1572},
  month={Nov},}@INPROCEEDINGS{11499823,
  author={S, Monesh and C, Senthilkumar N},
  booktitle={2026 IEEE International Research Conference on Smart Computing and Systems Engineering (SCSE)}, 
  title={MATAN: Mixed Attention-Based Transformer Network with Visformer Features for Visual Relationship Modeling}, 
  year={2026},
  volume={9},
  number={},
  pages={1-8},
  abstract={This study presents a Mixed Attention-based Transformer Network (MATAN), which is introduced as an alternative novel method for scene graph generation, merging Visformer feature extraction with mixed attention-based transformer architectures. Existing scene graph generation methods are restricted to modeling complex relationships and handling various visual contexts. To address these issues, we propose a multi-scale visual feature extraction-based pipeline that combines different attention mechanisms, such as self-attention, positional encoding, and cross-attention, with transformer models. Our approach utilizes Visformer to generate rich visual representations which are fed into transformer modules to model object relationships. We validated MATAN on the Visual Relationship Detection dataset and achieved significant gains over baseline approaches, 94.067% accuracy, 95.654% True Positive Rate, 94.837% True Negative Rate, 92.755% precision and 93.126% F-measure by MATAN model though experiment result. Visformer feature extraction combined with mixed attention-based architectures is an effective method for scene graph generation, improving the accuracy and relationship modeling capabilities. This study facilitates scene understanding for subsequent vision-language applications.},
  keywords={Feeds;Antennas;Circuits;Circuits and systems;Videos;Protocols;Location awareness;Video equipment;HTTP;Mobile communication;Scene Graph Generation;Visformer;Transformer;Visual Relationship Detection;Self-attention;Positional encoding;Cross-attention},
  doi={10.1109/SCSE70081.2026.11499823},
  ISSN={2997-7363},
  month={March},}@INPROCEEDINGS{9412943,
  author={Gao, Pan and Wan, Qi and Gao, RenWu and Shen, LinLin},
  booktitle={2020 25th International Conference on Pattern Recognition (ICPR)}, 
  title={Feature Embedding Based Text Instance Grouping for Largely Spaced and Occluded Text Detection}, 
  year={2021},
  volume={},
  number={},
  pages={1709-1716},
  abstract={A text instance can be easily detected as multiple ones due to the large space between texts/characters, curved shape and partial occlusion. In this paper, a feature embedding based text instance grouping algorithm is proposed to solve this problem. To learn the feature space, a TIEM (Text Instance Embedding Module) is trained to minimize the within instance scatter and maximize the between instance scatter. Similarity between different text instances are measured in the feature space and merged if they meet certain conditions. Experimental results show that our approach can effectively connect text regions that belong to the same text instance. Competitive performance of our approach has been achieved on CTW1500, Total-Text, IC15 and a subset consists of texts selected from the three datasets, with large spacing and occlusions.},
  keywords={Shape;Detectors;Benchmark testing;Feature extraction;Pattern recognition},
  doi={10.1109/ICPR48806.2021.9412943},
  ISSN={1051-4651},
  month={Jan},}@INPROCEEDINGS{11076660,
  author={Ghatage, A K and Ramesh, Cindhe and G, Yasika and S, Rajalakshmi and Rajam, P Subha and Perada, Anvesh},
  booktitle={2025 Global Conference in Emerging Technology (GINOTECH)}, 
  title={Enhancing WSN Performance with a Hybrid Key Management Protocol Using Multitask Deep Learning in IoT Cloud Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={WSNs help the Internet of Things (IoT) progress by gathering data in areas with limited resources, such as the civilian and military sectors. Authentication and key management at the edge devices are crucial for the security of real-time processing in the IoT. Unfortunately, conventional cryptography techniques are ineffective, leaving WSNs open to eavesdropping. Key sizes that are currently used for key management are quite large, which increases computing and communication costs, and is necessary because sensor nodes have limited resources. In order to lessen the burden on resources while increasing security, this study suggests a Hybrid Key Management Protocol. To reduce features, the system uses KMC-IG, a preprocessing method that combines Standard Scaler and Label Encoding. For limited datasets, the prediction accuracy can be enhanced by utilizing the Boosted Tree Model with DL architecture, which merges GBDT with Minimum MDL. After receiving BTMDL data from MDL, they construct BTMDL models and augment them with features. By outperforming existing methods, the suggested solution enhances WSN performance, reaching an accuracy of 95.75% and an F1-score of 95.87%. An efficient and secure WSN security solution that is computationally cheap is proposed in this work.},
  keywords={Deep learning;Wireless sensor networks;Accuracy;Protocols;Random access memory;Predictive models;Feature extraction;Real-time systems;Internet of Things;Standards;Wireless Sensor Network (WNS);Multitask Deep Learning (MDL);Boosting Tree Multitask Deep Learning (BTMDL);K-Means Clustering (KMC);Information Gain (IG)},
  doi={10.1109/GINOTECH63460.2025.11076660},
  ISSN={},
  month={May},}@INPROCEEDINGS{10073838,
  author={Indirani, M. and Anitha, Cuddapah and Goswami, Sohan and Baranitharan, K. and Govindaraju, S and R, Mahaveerakannan},
  booktitle={2023 Third International Conference on Artificial Intelligence and Smart Energy (ICAIS)}, 
  title={Detection of Salient Objects in a Video using a Hybrid Neural Network Model}, 
  year={2023},
  volume={},
  number={},
  pages={641-646},
  abstract={Salient detection is an active and critical area that is designed within the detection of items of a video recording, nonetheless, it attracts elevated interest among scientists. With rising powerful video clip information, the overall performance of saliency item detection techniques is degrading with typical item detection techniques. The problems lie with blurry moving goals, super-fast motion of items as well as dynamic background or background occlusion alteration on foreground areas within the video clip frames. This kind of obstacle leads to bad saliency detection. This paper models a full mastering design to deal with the difficulties, and that works on an advanced framework by merging the thought of Convolutional Neural Network (CNN) and Recurrent Neural Network (RNN) with firefly Optimization technique for video clip saliency detection. Good utilization of the firefly algorithm together with CRNN is completed for the removal of characteristics by the video clips for item recognition. The primary objective of this newspaper is to present an effective hyperparameter choice framework for Convolution Recurrent Neural Networks (CRNNs) that employ one of the more popular swarm intelligence methods, the firefly algorithm. The suggested technique goals at creating a spatiotemporal design that exploits temporal, local, and spatial restriction cues to attain worldwide SEO. The process of locating the salient items in deep benchmark powerful video recording datasets will be completed by recording the temporal, local, and spatial restriction characteristics with all the CRNN. The CRNN is examined on benchmark datasets from typical video clip salient item detection techniques within the terminology of accuracy and load of Computation. The tests show that the proposed design accomplishes enhanced overall performance compared to some other existing versions which prove to significantly satisfy all the traditional object detection models.},
  keywords={Recurrent neural networks;Terminology;Computational modeling;Benchmark testing;Spatiotemporal phenomena;Convolutional neural networks;Video recording;Computer Vision;Convolution networks;Deep Learning;Firefly algorithm;Object detection;Artificial intelligence},
  doi={10.1109/ICAIS56108.2023.10073838},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11444388,
  author={Li, Handong and Zhang, Yiyuan and Guo, Longteng and Yue, Xiangyu and Liu, Jing},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Breaking the Encoder Barrier for Seamless Video-Language Understanding}, 
  year={2025},
  volume={},
  number={},
  pages={23167-23176},
  abstract={Most Video-Large Language Models (Video-LLMs) adopt an encoder-decoder framework, where a vision encoder extracts frame-wise features for processing by a language model. However, this approach incurs high computational costs, introduces resolution biases, and struggles to capture fine-grained multimodal interactions. To overcome these limitations, we propose ELVA, an encoder-free Video-LLM that directly models nuanced video-language interactions without relying on a vision encoder. ELVA employs token merging to construct a bottom-up hierarchical representation and incorporates a video guidance supervisor for direct spatiotemporal representation learning. Additionally, a hybrid-resolution mechanism strategically integrates highand low-resolution frames as inputs to achieve an optimal balance between performance and efficiency. With only 7M publicly available video-text pairs, ELVA achieves competitive performance compared to encoder-based Video-LLMs while reducing FLOPs by up to 95% and inference latency by 92%, offering a scalable and efficient solution for realtime video understanding.},
  keywords={Feeds;Pixel;Videos;Product development;Protocols;Video equipment;HTTP;Modulation;Digital images;Graphical user interfaces},
  doi={10.1109/ICCV51701.2025.02151},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{11076340,
  author={R, Deepa and Rambabu, Bandi and G, Senthilkumar and J, Thresa Jeniffer and R, Surendran},
  booktitle={2025 7th International Conference on Intelligent Sustainable Systems (ICISS)}, 
  title={Application of Natural Language Processing Methods to Automated Ontology Building for Domain-Dependent Information Acquisition}, 
  year={2025},
  volume={},
  number={},
  pages={1418-1425},
  abstract={Ontology is an emerging field with massive potential for improving information organization, management, and understanding. The ontology representation model is utilized for knowledge representation sharing and reusing in Natural Language Processing (NLP). Easy classification of the information is the main feature of the ontology construction. Regardless, there is still an issue in automatically building ontologies from unorganised data. Intelligent association collection from ontologies, hyponymy creation across ontology categories, and dialogue between data providers and domain specialists all contribute to this difficulty. Furthermore, concept, modality and context are the three major dimensions of the knowledge-based ontology construction. The problems concerning ontology construction, mapping, and maintenance are essential areas that must be addressed and focused on. This paper comprehensively reviews the automatic ontology construction methods for predictive analysis. Various automatic ontology construction methods are studied, and the research gap in the existing methods such as Accuracy in prediction, response time and computational complexity are addressed and presented. Based on the literature review, a novel incremental algorithm is proposed for merging the related domain ontologies into a cluster that can strengthen the knowledge base, thereby providing automated inferences and increasing the efficiency of the automated ontology construction.},
  keywords={Training;Accuracy;Systematics;Collaborative software;Measurement uncertainty;Knowledge based systems;Ontologies;Prediction algorithms;Natural language processing;Time factors;Accuracy;Agriculture domain;Automatic ontology construction;Incremental Algorithm;Natural Language Processing;Prediction},
  doi={10.1109/ICISS63372.2025.11076340},
  ISSN={},
  month={March},}@INPROCEEDINGS{10409101,
  author={Li, Yu and Huang, Hui},
  booktitle={2023 IEEE 11th Joint International Information Technology and Artificial Intelligence Conference (ITAIC)}, 
  title={Human Action Recognition Method Based on Bag-of-Words Model}, 
  year={2023},
  volume={11},
  number={},
  pages={1871-1879},
  abstract={The dictionary constructed by the traditional bag-of-words model is unstable and ignores the order of word vectors. When it is used for human action recognition, the recognition effect is unstable, especially for reverse action recognition. Aiming at these problems, a method of action classification based on space-temporal joint frequency histogram is proposed. Firstly, the key angle information of the limb is extracted, and the inter-frame difference of the key angle is used as the time feature descriptor. Then, according to the characteristics of joint movement, the human body is divided into five main active parts, and each part constructs a stable time word bag and a space word bag respectively. Then the joint frequency histograms of each part are merged to represent the action sequence. Finally, the action classification is realized by using support vector machine (SVM). Experiments are carried out on a challenging dataset-UTKinect dataset. The results show that compared with the traditional bag-of-words model and some existing methods, this method can effectively improve the accuracy of action recognition.},
  keywords={Support vector machines;Histograms;Dictionaries;Feature extraction;Human activity recognition;Data mining;Information technology;action recognition;angle feature;joint frequency histogram;bag-of-words model},
  doi={10.1109/ITAIC58329.2023.10409101},
  ISSN={2693-2865},
  month={Dec},}@INPROCEEDINGS{10922466,
  author={Wang, Sicheng and Huang, Yan and Wang, Qu},
  booktitle={2024 IEEE PES 16th Asia-Pacific Power and Energy Engineering Conference (APPEEC)}, 
  title={Medium-Term Jointly Load Forecasting via an Enhanced KAN-Based MTL Framework}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Electricity load forecasting involves predicting future power demand based on historical data and related factors. Accurate forecasting is crucial for energy distribution and system management. This study introduces a novel multi-task learning (MTL) framework that integrates Kolmogorov-Arnold Networks (KAN) with a multi-head self-attention (MHSA) with a both hard and soft parameter sharing strategy to effectively merge different types of inputs for joint load forecasting. The KAN layer is tasked with cross-feature learning and output fitting while the MHSA mechanism captures the temporal information from multiple perspectives, aiming to facilitate comprehensive nonlinear feature learning. Experimental results show that the proposed method can attains better forecasting accuracy, with an average mean absolute percentage error of 3.842% for 10-day medium-term forecasts.},
  keywords={Representation learning;Accuracy;Load forecasting;Electricity;Neural networks;Predictive models;Multitasking;Data models;Forecasting;Load modeling;electricity load forecasting;KAN;MHSA MTL;nonlinear integration},
  doi={10.1109/APPEEC61255.2024.10922466},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11182550,
  author={Balaji, K. and Seshagiri Rao, P.},
  booktitle={2025 International Conference on Modern Sustainable Systems (CMSS)}, 
  title={Harnessing the Internet of Things for Sustainable Urbanization: A Framework for Resilient Smart Cities}, 
  year={2025},
  volume={},
  number={},
  pages={1176-1181},
  abstract={The Internet of Things (IoT) represents a revolutionary technology, which facilitates the emergence of dynamic network of inter-connected devices that can flawlessly communicate and share information. It also merges various technologies, hardware systems, and software frameworks to form an all-embracive ecosystem, which comprises data, people, devices, and smart communication. In a country like India, which exhibits major regional differences in the degree of technology and IoT adoption, it can easily be considered that the idea of IoT has the enormous potential to transform the urban development process and introduce it into the paradigm of improvability, cost-efficient, and maintenance friendly solutions. The issues of smart cities are central to the development of a country and better life of citizens. In India, use of IoT in smart city projects makes it easier to provide core services to constituents, implement transparent governance strategies, and build sustainable urbanization. With the help of IoT, different systems may correlate effectively which will provide a reliable access to the data and the establishment of new opportunities in the form of innovative digital services that would meet the requirements of city residents. The present research paper explores the centrality of IoT in the development of smart cities in India. It discusses the policy framework of IoT in the country, outlines major drivers of and benefits of IoT-based smart city solutions, analyzes consumer preferences and demographics. With this comprehension, the paper would like to suggest practical insights concerning the use of IoT in creating inclusive and technology-driven cities of India.},
  keywords={Smart cities;Transforms;Medical services;Traffic control;Market research;Software;Safety;Maintenance;Internet of Things;Sustainable development;Internet of Things (IoT);Smart Cities;Sustainable Urbanization;Technology Integration;Digital Services},
  doi={10.1109/CMSS66566.2025.11182550},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10669645,
  author={Leinen, Fabian and Perathoner, Alexander and Pretschner, Alexander},
  booktitle={2024 IEEE/ACM International Flaky Tests Workshop (FTW)}, 
  title={On the Impact of Hitting System Resource Limits on Test Flakiness}, 
  year={2024},
  volume={},
  number={},
  pages={14-19},
  abstract={Regression testing aims to determine whether a change to a system introduces new bugs or can be merged safely. Flaky tests, which are tests that fail non-deterministically and unrelated to the change, can undermine this effort. In research and practice alike, it is often assumed that limited test execution resources can lead to test flakiness. We hypothesize that hitting resource limits during test execution can lead to changed timing behavior, which in turn promotes timing-related flakiness. However, there is no empirical evidence indicating whether hitting these resource limits increases the likelihood of test flakiness. To shed light on this, we created a dataset of 20 open-source projects for macOS, which contains a total of 232 UI test cases, with 23 of them being flaky. For all tests, we measured the CPU usage continuously during test execution. We discovered that executions of flaky tests spend significantly more time at the CPU limit than executions of non-flaky tests. Contrary to our expectations, we found that failing runs of flaky tests spend less time at the CPU limit than passing runs.CCS CONCEPTS• Software and its engineering → Empirical software validation.},
  keywords={Conferences;Computer bugs;Software;Timing;Testing;Software development management;Flaky Tests;Regression Testing;Software Testing;Continuous Integration},
  doi={},
  ISSN={},
  month={April},}@INPROCEEDINGS{11384963,
  author={Zeeshan, Rana and Bogue, John and Asghar, Mamoona Naveed},
  booktitle={2025 Cyber Research Conference - Ireland (Cyber-RCI)}, 
  title={Beyond ASR: Achieving Privacy-Aligned Low Diarization Error Rates in Psychiatric Transcripts Using Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The transition to digital psychiatric records introduces distinctive challenges, due to the sensitivity of content and the conversational style of clinician-patient dialogues. Prior evaluations of Automatic Speech Recognition (ASR) systems in psychiatry showed that while Word Error Rate (WER) remains consistently low, Diarization Error Rate (DER) is highly variable. Although synchronous speaker diarization is desirable for real-time transcription, it suffers from processing instability and limited platform availability. On the other hand, asynchronous diarization requires audio recording, introducing serious privacy risks and regulatory barriers in Mental Health Services (MHS). Both approaches also rely on voice-based separation and identification of speakers, which is less effective when speakers share similar demographic traits, such as gender or age, leading to elevated diarization error rates. These aspects position diarization as the main bottleneck in the adoption of ASR workflows in psychiatry. This study addresses these challenges by combining synchronous speech-to-text (STT) transcription with large language model (LLM) based diarization. This approach removes the reliance on voice-based speaker separation and eliminates the need to store or process raw audio, which improves privacy protection for highly sensitive clinical data. Six state-of-the-art LLMs: GPT-5, Grok-4, DeepSeek Reasoner, Perplexity Sonar Pro, Gemini 2.5 Pro, and Claude Sonnet-4 were evaluated on three psychiatric session transcripts without labels, representing female-female (FF), female-male (FM), and male-male (MM) speaker pairs. Each transcript was merged into unsegmented text, and models were tasked with assigning labels based on provided context of psychiatric treatment sessions. DER was computed using the punctuation-segmented method from prior ASR research. The results show that LLM based DER ranged between $0-4 \%$, compared to ASR based diarization where DER reached up to $\mathbf{5 2. 2 \%}$ in some cases. Moreover, the persistent minor errors were largely benign affirmations that did not alter the factual meaning or clinical interpretation. This demonstrates that synchronous STT combined with LLM diarization functions as Privacy Enhancing Technology (PET). This approach provides a more accurate, stable, and privacy-aligned alternative for psychiatric documentation, enhancing clinical workflow efficiency while addressing the limitations of both synchronous and asynchronous speaker diarization.},
  keywords={Technological innovation;Data privacy;Accuracy;Error analysis;Large language models;Sonar;Mental health;Psychiatry;Speech to text;Automatic speech recognition;Automatic speech recognition;data privacy;mental health services;speaker diarization;large language models;psychiatry case notes;speech to text transcription;technological innovation},
  doi={10.1109/Cyber-RCI68134.2025.11384963},
  ISSN={},
  month={Dec},}@ARTICLE{11455997,
  author={Baka, Ebtesam Mus A. and Ata, Oğuz},
  journal={IEEE Access}, 
  title={Topic Modeling and Sentiment Classification: Perspectives From Libyan Flood Conversations on Social Media}, 
  year={2026},
  volume={14},
  number={},
  pages={49862-49884},
  abstract={Social media streams related to disasters are a key but difficult source of data to use in real-time situational awareness. This study presents a merged sentiment analysis model, which is based on classical machine learning, transformer models, and a metaheuristic optimization approach, which integrates the Salp Swarm Optimization (SSO) algorithm. The suggested ensemble uses SSO to optimize the hyperparameters and decision-fusion weights of a harmonized model with a balance between interpretability, computational resources, and predictive strength. Extensive experiments along historical baselines (1982–2024) have shown that the SSO-improved ensemble achieves state-of-the-art performance with 97% accuracy, which is superior to both of the individual deep models and previously used ensemble techniques. Quantitative findings indicate better speed-accuracy trade-offs and cost efficiency, whereas qualitative findings indicate that the model can reflect sentiment change in four phases of disaster. Experiments on cross-disaster generalization also support the high level of transferability with an average accuracy of 90.7% in various crisis events. The results demonstrate that optimization-based ensemble design has provided a methodical and ethically viable route for real-time humanitarian monitoring, changing the social media sentiment into action-related crisis intelligence.},
  keywords={Social networking (online);Floods;Disasters;Sentiment analysis;Analytical models;Blogs;Accuracy;Pipelines;Computational modeling;Real-time systems;Sentiment analysis;salp swarm optimization (SSO);disaster informatics;ensemble learning;computational efficiency;transformer models;real-time analytics;cross-disaster generalization},
  doi={10.1109/ACCESS.2026.3677530},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11324405,
  author={Shylaja, Mushika and Sheshikala, M},
  booktitle={2025 4th International Conference on Automation, Computing and Renewable Systems (ICACRS)}, 
  title={Adaptive Multimodal Deep Learning for Emotion Recognition via Facial Micro-Expressions and Physiological Signals}, 
  year={2025},
  volume={},
  number={},
  pages={1496-1504},
  abstract={This paper examines the challenge of recognizing emotions by combining fleeting facial micro-expressions with slower physiological responses, acknowledging that each modality alone often provides an incomplete picture of human affect. To address this, the study adopts an adaptive deep-learning framework designed to align sub-second facial events with incremental physiological signals, adjust its fusion strategy according to real-time reliability and generalize across subjects and datasets. The methodology integrates high-frame-rate micro-expression sequences captured at 200 frames per second with synchronized physiological windows, processed through separate encoders and merged through a gating mechanism that learns how much emphasis each modality deserves at different moments. Using this framework, the fused model achieved an accuracy of 85.2 percent and an F1 score of 0.84, outperforming facial only and physiology only models and maintaining 80.3 percent accuracy even when one modality was intentionally removed during inference. Cross dataset tests further confirmed strong generalization, with the fused model reaching 78.6 percent accuracy on unseen data while preserving stable temporal alignment and improved calibration behavior. The paper concludes that the proposed approach offers a more resilient and trustworthy solution for emotion recognition, especially in settings where signals fluctuate or user conditions vary widely.},
  keywords={Emotion recognition;Adaptation models;Accuracy;Adaptive systems;Self-supervised learning;Physiology;Stability analysis;Calibration;Synchronization;Thermal stability;Multimodal emotion recognition;micro expression analysis;physiological signal integration;adaptive fusion mechanism;cross dataset generalization},
  doi={10.1109/ICACRS67045.2025.11324405},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9579713,
  author={Naik, Dinesh and Jaidhar, C D},
  booktitle={2021 12th International Conference on Computing Communication and Networking Technologies (ICCCNT)}, 
  title={Weakly Supervised Image Annotation and Segmentation}, 
  year={2021},
  volume={},
  number={},
  pages={1-8},
  abstract={The various aspects in the processing of an image include object recognition, object classification, image segmentation, and attribute learning, are closely related to each other. In this paper, we proposed a Bayesian Non-parametric (BN) approach to solve the complex visual tasks using the non-parametric property to regulate the model's constraint. A Chinese Restaurant Process Stacked with Weakly Supervised Markov Random Field (WS-MRF-CRP) is developed, which uses Markov Random Field (MRF) for low-level and Chinese Restaurant Process (CRP) for high-level. The proposed approach learns and incorporates association between various object and attribute classes. The input image is clustered into individual components using the MRF, and then the CRP is used for merging the components and generating the image-attribute association. Experiments performed on the Berkeley Segmentation dataset demonstrated that the proposed model performs better than other existing weakly supervised models.},
  keywords={Image segmentation;Solid modeling;Feature detection;Computational modeling;Semantics;Clustering algorithms;Prediction algorithms;Bayesian Non-Parametric Model;Chinese Restaurant Process;Image Segmentation;Markov Random Field;Object-Attribute Association;Weakly Supervised},
  doi={10.1109/ICCCNT51525.2021.9579713},
  ISSN={},
  month={July},}@INPROCEEDINGS{11404750,
  author={Nithish Kumar, S and N, Lalithamani},
  booktitle={2025 13th International Conference on Intelligent Systems and Embedded Design (ISED)}, 
  title={Risk-Aware Restaurant Profiling via Aspect-Based Sentiment Analysis and Temporal Trend Detection}, 
  year={2025},
  volume={},
  number={},
  pages={313-320},
  abstract={Websites that provide reviews of restaurants are an excellent way of knowing consumer opinion, but the overall ratings do not reveal dissatisfaction with particular service features. Our solution involves a global analysis method for detecting restaurant failures using Aspect Based Sentiment Analysis and multi-dimensional sentiment profiling. We extract the aspect terms at a fine level and their corresponding polarities, i.e. positive, neutral, and negative, from the review text by employing the FAST-LCF-ATEPC model that is available in the PyABSA library. After that, the aspects are assigned under the five operational categories of food, service, ambiance, price, and location by utilizing a hybrid classification method that merges BERT-based embeddings with regexaugmented similarity scoring. Furthermore, we construct a new Restaurant Aspect Matrix, a weighted sentiment distribution over restaurants and aspects, to monitor the performance for each restaurant. For representing and visualizing the said information, dimensionality reduction is performed by using Uniform Manifold Approximation and Projection, while clustering is done through KMeans. The risk score is calculated by means of negative sentiment penalties, and a 3D sentiment cube is created to filter out those sentiment areas that are associated with poor service quality. The historic pattern of sentiment change is also monitored by employing Change Point Detection for a few key features. Our study indicates that restaurants with a high rating can still hear the voices of persistent discontent in some areas. The suggested pipeline provides a clear and interpretable method for the detection of such hidden threats and, consequently, better benchmarking and quality control for restaurant platforms and aggregators.},
  keywords={Manifolds;Sentiment analysis;Visualization;Three-dimensional displays;Reviews;Pipelines;Quality control;Market research;Feature extraction;Monitoring;ABSA;Sentiment Analysis;Temporal Trend;Restaurant},
  doi={10.1109/ISED67359.2025.11404750},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11253304,
  author={Wang, Sizhe and Peiris, Himashi and Chen, Zhaolin},
  booktitle={2025 47th Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)}, 
  title={Dual-path Learning via Optimal Transport Fusion for Precise Brain Tumour Segmentation}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Accurate brain tumour segmentation in Multimodal Multi-parametric Magnetic Resonance Imaging is critical for clinical intervention but remains challenging due to complex boundaries and heterogeneous morphology. Existing U-Net architectures often struggle to capture global context and accurately delineate tumours with irregular or diffuse boundaries, limiting their clinical applicability. To mitigate these challenges, We introduce a novel dual-path 3D U-Net framework that integrates Optimal Transport (OT) theory into feature fusion, enabling improved alignment of global and local features. The architecture includes a Global Context Path (via Pyramid Pooling) and a Local Detail Path (with multi-scale convolutions), capturing complementary spatial features. The Optimal Transport Fusion module leverages Optimal Transport theory to efficiently align and merge features from both paths, offering a principled alternative to traditional fusion strategies such as concatenation or attention mechanisms. Additionally, we incorporate an edge-aware loss function based on 3D Sobel operators, which refines boundary precision in segmentation masks. Evaluated on the BraTS 2023 glioma dataset, our model outperforms standard U-Net and other recent state-of-the-art models, demonstrating the effectiveness of Optimal Transport-based feature fusion in enhancing brain tumour segmentation accuracy.},
  keywords={Image segmentation;Three-dimensional displays;Accuracy;Limiting;Magnetic resonance imaging;Morphology;Computer architecture;Brain modeling;Standards;Tumors;Brain Tumour Segmentation;Multimodal MRI;Dual-path 3D U-Net;Optimal Transport},
  doi={10.1109/EMBC58623.2025.11253304},
  ISSN={2694-0604},
  month={July},}@INPROCEEDINGS{10555875,
  author={Mahe, Erwan and Bannour, Boutheina and Gaston, Christophe and Lapitre, Arnault and Le Gall, Pascale},
  booktitle={2024 IEEE/ACM 12th International Conference on Formal Methods in Software Engineering (FormaliSE)}, 
  title={Finite Automata synthesis from interactions}, 
  year={2024},
  volume={},
  number={},
  pages={12-22},
  abstract={Interactions are graphical models representing communication flows between actors. Well-known interaction languages include UML Sequence Diagrams or Message Sequence Charts. Even though interactions allow for concise and intuitive specifications, their use remains limited in formal verification, partly because the subsets of formalized languages often lack expressiveness. As many verification methods, such as model-checking or runtime verification, are routinely available for finite automata, we propose a new approach to generate finite automata from an expressive interaction language with operators such as the concurrent region. Our approach leverages an operational semantics to compute derivatives of an interaction and assimilate them to states of a finite automata. In addition, we use term rewriting to merge states on-the-fly so as to obtain small automata without relying on costly a-posteriori minimization techniques.},
  keywords={Sequential analysis;Runtime;Graphical models;Instruments;Computational modeling;Unified modeling language;Semantics;Interaction language;Sequence Diagram;Message Sequence Chart;Non-deterministic Finite Automaton;Operational Semantics;Term Rewriting},
  doi={},
  ISSN={2575-5099},
  month={April},}@ARTICLE{10897870,
  author={Xi, Weijie and Chen, Xuejin},
  journal={Computational Visual Media}, 
  title={Reconstructing piecewise planar scenes with multi-view regularization}, 
  year={2019},
  volume={5},
  number={4},
  pages={337-345},
  abstract={Reconstruction of man-made scenes from multi-view images is an important problem in computer vision and computer graphics. Observing that manmade scenes are usually composed of planar surfaces, we encode plane shape prior in reconstructing man-made scenes. Recent approaches for single-view reconstruction employ multi-branch neural networks to simultaneously segment planes and recover 3D plane parameters. However, the scale of available annotated data heavily limits the generalizability and accuracy of these supervised methods. In this paper, we propose multi-view regularization to enhance the capability of piecewise planar reconstruction during the training phase, without demanding extra annotated data. Our multi-view regularization enables the consistency among multiple views by making the feature embedding more robust against view change and lighting variations. Thus, the neural network trained by multi-view regularization performs better on a wide range of views and lightings in the test phase. Based on more consistent prediction results, we merge the recovered models from multiple views to reconstruct scenes. Our approach achieves state-of-the-art reconstruction performance compared to previous approaches on the public ScanNet dataset.},
  keywords={Image reconstruction;Three-dimensional displays;Feature extraction;Computational modeling;Training;Annotations;Reactive power;Solid modeling;Lighting;Deep learning;scene modeling;multi-view;regularization;neural network},
  doi={10.1007/s41095-019-0159-7},
  ISSN={2096-0662},
  month={Dec},}@INPROCEEDINGS{10849884,
  author={Chen, Zixin and Yao, Xincheng and Luo, Yan and Liu, Zhenyu and Zhang, Baozhu and Zhang, Chongyang},
  booktitle={2024 IEEE International Conference on Visual Communications and Image Processing (VCIP)}, 
  title={IRAD: Input-Reference Joint Driven Reconstruction for Unified Anomaly Detection}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Unified (multi-class and cross-class) anomaly detection (AD) is a growing area of interest in real-world applications. However, the popular reconstruction-based AD approach usually faces two significant challenges: the "identical shortcut" issue (copying the input as output) and the lack of class adaptability (the AD model cannot be directly applied to new classes). To address these challenges, we propose a novel unified AD method, named IRAD (Input-Reference Joint Driven). Our core insight is to effectively incorporate both input and references into the reconstruction process. Our IRAD consists of three components: 1) A Suspicious Anomaly Substituting module that replaces the potential abnormal regions of input with anomaly-free reference patches to prevent abnormal information leakage, effectively addressing the "identical shortcut". 2) An Input-Reference Fusing module that merges reference embeddings with input, which urges the subsequent Decoder to effectively utilize the normal reference patterns to reconstruct anomaly-free samples, making our model more class-adaptive. 3) A Rich Feature Preserving Decoder that efficiently preserves low-level details, mitigating low-level information degradation during reverse construction from high to low level. In multi-class AD, IRAD achieves better results on Mvtec-AD, BTAD, and VisA. In cross-class AD, IRAD also outperforms the baesline methods on Mvtec-AD and VisA.},
  keywords={Degradation;Adaptation models;Visual communication;Benchmark testing;Information leakage;Decoding;Image reconstruction;Anomaly detection;Faces;Multi-class;cross-class;anomaly detection},
  doi={10.1109/VCIP63160.2024.10849884},
  ISSN={2642-9357},
  month={Dec},}@INPROCEEDINGS{10825835,
  author={Shih, Yu-Fei and Yen, An-Zi and Huang, Hen-Hsen and Chen, Hsin-Hsi},
  booktitle={2024 IEEE International Conference on Big Data (BigData)}, 
  title={Visual Lifelog Retrieval through Captioning-Enhanced Interpretation}, 
  year={2024},
  volume={},
  number={},
  pages={479-486},
  abstract={People often struggle to remember specific details of past experiences, which can lead to the need to revisit these memories. Consequently, lifelog retrieval has emerged as a crucial application. Various studies have explored methods to facilitate rapid access to personal lifelogs for memory recall assistance. In this paper, we propose a Captioning-Integrated Visual Lifelog (CIVIL) Retrieval System for extracting specific images from a user’s visual lifelog based on textual queries. Unlike traditional embedding-based methods, our system first generates captions for visual lifelogs and then utilizes a text embedding model to project both the captions and user queries into a shared vector space. Visual lifelogs, captured through wearable cameras, provide a first-person viewpoint, necessitating the interpretation of the activities of the individual behind the camera rather than merely describing the scene. To address this, we introduce three distinct approaches: the single caption method, the collective caption method, and the merged caption method, each designed to interpret the life experiences of lifeloggers. Experimental results show that our method effectively describes first-person visual images, enhancing the outcomes of lifelog retrieval. Furthermore, we construct a textual dataset that converts visual lifelogs into captions, thereby reconstructing personal life experiences.},
  keywords={Visualization;Big Data;Cameras;Vectors;Image reconstruction;Lifelogging;Visual Lifelog Captioning;Visual Lifelog Retrieval},
  doi={10.1109/BigData62323.2024.10825835},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11343007,
  author={Yan, Kaiyue and Wang, Fayu},
  booktitle={2025 IEEE International Conference on Systems, Man, and Cybernetics (SMC)}, 
  title={BiADet: Dual-Path Adaptive Aerial Small-Object Detection Network}, 
  year={2025},
  volume={},
  number={},
  pages={2498-2505},
  abstract={With the growing use of UAVs in surveillance and rescue, accurate small object detection in low light condition remains a major challenge due to poor contrast. To address this, we designed a dual-path adaptive small object detection network, BiADet. It is built upon an innovative dual-backbone feature enhancement architecture: One backbone adaptively optimises reflectance to extract fine-grained edge information and high-frequency details. The other captures the overall semantics and spatial contours of targets. They complement each other in this process. Their outputs are combined by the Adaptive Feature Aggregation Module (AFAM), which dynamically merges and enhances the features and emphasises critical regions. We also optimize the hybrid encoder and detection head for tiny object scales and redesign a Multi-Scale Feature Selection (MSFS) module for cross-level feature fusion and noise suppression. Experiments on VisDrone2019 show that BiADet improves mAP50 by 5.1% and mAP50-95 by 3.6% over the RT-DETR-R18 baseline. Tests on ExDark and real-world data further demonstrate its robustness and generalization under varying illumination conditions.},
  keywords={Reflectivity;Adaptive systems;Sensitivity;System performance;Surveillance;Semantics;Noise reduction;Object detection;Feature extraction;Robustness;RT-DETR;dual-backbone feature enhancement;feature selection;small object detection},
  doi={10.1109/SMC58881.2025.11343007},
  ISSN={},
  month={Oct},}@ARTICLE{11303352,
  author={Na, Jungjo and Kim, Miso and Kim, Hyeon Gyu},
  journal={Journal of Mobile Multimedia}, 
  title={A Real-Time Data-Driven Multimedia Platform Integrating Public Data and AI-Based Facial Generation for Personalized Interaction}, 
  year={2025},
  volume={21},
  number={6},
  pages={1135-1166},
  abstract={This study proposes a data-driven interactive multimedia platform that integrates real-time environmental and demographic data visualization with AI-based facial generation to deliver dynamic and immersive user experiences. The system combines image generation AI with data visualization in a unified framework, enabling real-time, personalized interaction. Real-time weather and demographic data are collected and processed through public APIs provided by Seoul Metropolitan Government, and these data streams are mapped to visual parameters such as sky color, cloud density, and background environments to reflect local conditions dynamically. Facial generation is carried out using a fine-tuned stable diffusion model trained on a Korean facial dataset categorized by age and gender. The generated face meshes are refined using detailed expression capture and animation (DECA) and implemented as MetaHuman characters within Unreal Engine to produce expressive real-time avatars. The platform adopts a client—server architecture and leverages cloud-based asset management to efficiently handle real-time data and 3D resources. This approach demonstrates a novel form of interactive media experience that merges real-time public data with AI-driven personalization and presents new opportunities for interdisciplinary HCI research that bridges art, design, urban data, and artificial intelligence.},
  keywords={Visualization;Three-dimensional displays;Image synthesis;Image color analysis;Clouds;Government;Data visualization;Media;Real-time systems;Artificial intelligence;Real-time data visualization;AI-based facial generation;stable diffusion;public data APIs;interactive multimedia platform;human—computer interaction (HCI);urban data integration},
  doi={10.13052/jmm1550-4646.2166},
  ISSN={1550-4654},
  month={November},}@INPROCEEDINGS{11345047,
  author={Faiz, Muhammad and Budi Setiawan, Erwin},
  booktitle={2025 8th International Conference on Information and Communications Technology (ICOIACT)}, 
  title={Multimodal Depression Detection on Social Media X Using CNN-BiGRU and GloVe Feature Expansion}, 
  year={2025},
  volume={},
  number={},
  pages={274-279},
  abstract={Depression is a mental illness that can interfere with daily life, causing emotional problems such as sadness and leading sufferers to post about their health conditions on social media. The social media platform X is often used to communicate with friends and the community, with a total of 25.2 million users. The large number of X users in Indonesia and the variety of topics discussed mean that user tweets can be used as a source of data, especially on the topic of depression. Therefore, this study aims to detect depression through multimodal tweet data consisting of text and images by utilizing a Convolutional Neural Network (CNN) and a Bidirectional Gated Recurrent Unit (BiGRU) model, combined with GloVe feature expansion and measuring the performance resulting from the application of these stages. The dataset used consists of 24,235 multimodal data, 127,579 IndoNews corpus data. In this study, three scenarios are going to be investigated, such as splitting data for searching with a standard model, implementing the feature expansion to each model, and merging different types of data into the hybrid deep learning model. The results were obtained by comparing a 90:10 split data, using GloVe Top 5 feature expansion on a combination of Tweet+IndoNews corpus and Multimodal data. The CNN+BiGRU hybrid model produced the best accuracy of 77.62%, an increase of 1.71% from the base model, and precision of 91.42%, an increase of 5.96%. Furthermore, the BiGRU+CNN model produced an accuracy of 77.06%, an increase of 1.29%, and a precision of 92.29%, an increase of 4.67%, showing a significant improvement using multimodal data.},
  keywords={Deep learning;Accuracy;Social networking (online);Depression;Feature extraction;Transformers;Data models;Reliability;Labeling;Convolutional neural networks;Depression;X;Tweet;Multimodal;GloVe;Hybrid Deep Learning},
  doi={10.1109/ICOIACT67584.2025.11345047},
  ISSN={2770-4661},
  month={Dec},}@ARTICLE{9298842,
  author={Zhang, Pei and Liu, Xinwang and Xiong, Jian and Zhou, Sihang and Zhao, Wentao and Zhu, En and Cai, Zhiping},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={Consensus One-Step Multi-View Subspace Clustering}, 
  year={2022},
  volume={34},
  number={10},
  pages={4676-4689},
  abstract={Multi-view clustering has attracted increasing attention in multimedia, machine learning and data mining communities. As one kind of the essential multi-view clustering algorithm, multi-view subspace clustering (MVSC) becomes more and more popular due to its strong ability to reveal the intrinsic low dimensional clustering structure hidden across views. Despite superior clustering performance in various applications, we observe that existing MVSC methods directly fuse multi-view information in the similarity level by merging noisy affinity matrices; and isolate the processes of affinity learning, multi-view information fusion and clustering. Both factors may cause insufficient utilization of multi-view information, leading to unsatisfying clustering performance. This paper proposes a novel consensus one-step multi-view subspace clustering (COMVSC) method to address these issues. Instead of directly fusing multiple affinity matrices, COMVSC optimally integrates discriminative partition-level information, which is helpful to eliminate noise among data. Moreover, the affinity matrices, consensus representation and final clustering labels matrix are learned simultaneously in a unified framework. By doing so, the three steps can negotiate with each other to best serve the clustering task, leading to improved performance. Accordingly, we propose an iterative algorithm to solve the resulting optimization problem. Extensive experiment results on benchmark datasets demonstrate the superiority of our method against other state-of-the-art approaches.},
  keywords={Clustering methods;Kernel;Task analysis;Redundancy;Fuses;Clustering algorithms;Sparse matrices;Multi-view clustering;subspace clustering;data fusion},
  doi={10.1109/TKDE.2020.3045770},
  ISSN={1558-2191},
  month={Oct},}@ARTICLE{8821314,
  author={Baik, Jin Woo and Kim, Jin Young and Cho, Seonghee and Choi, Seongwook and Kim, Jongbeom and Kim, Chulhong},
  journal={IEEE Transactions on Medical Imaging}, 
  title={Super Wide-Field Photoacoustic Microscopy of Animals and Humans In Vivo}, 
  year={2020},
  volume={39},
  number={4},
  pages={975-984},
  abstract={Acoustic-resolution photoacoustic micro-scopy (AR-PAM) is an emerging biomedical imaging modality that combines superior optical sensitivity and fine ultrasonic resolution in an optical quasi-diffusive regime (~1-3 mm in tissues). AR-PAM has been explored for anatomical, functional, and molecular information in biological tissues. Heretofore, AR-PAM systems have suffered from a limited field-of-view (FOV) and/or slow imaging speed, which have precluded them from routine preclinical and clinical applications. Here, we demonstrate an advanced AR-PAM system that overcomes both limitations of previous AR-PAM systems. The new AR-PAM system demonstrates a super wide-field scanning that utilized a 1-axis water-proofing microelectromechanical systems (MEMS) scanner integrated with two linear stepper motor stages. We achieved an extended FOV of $36 \times 80$ mm2 by mosaicking multiple volumetric images of $36 \times 2.5$ mm2 with a total acquisition time of 224 seconds. For one volumetric data (i.e., $36 \times 2.5$ mm2), the B-scan imaging speed over the short axis (i.e., 2.5 mm) was 83 Hz in humans. The 3D volumetric image was also provided by using MEMS mirror scanning along the X-axis and stepper-motor scanning along the Y-axis. The super-wide FOV mosaic image was realized by registering and merging all individual volumetric images. Finally, we obtained multi-plane whole-body in-vivo PA images of small animals, illustrating distinct multi-layered structures including microvascular networks and internal organs. Importantly, we also visualized microvascular networks in human fingers, palm, and forearm successfully. This advanced MEMS-AR-PAM system could potentially enable hitherto not possible wide preclinical and clinical applications.},
  keywords={Micromechanical devices;Mice;Acoustics;Optical imaging;Image resolution;Animal imaging;high-speed imaging;human imaging;MEMS scanning;microvasculature;photoacoustic microscopy;wide-field scanning},
  doi={10.1109/TMI.2019.2938518},
  ISSN={1558-254X},
  month={April},}@ARTICLE{10011559,
  author={Chen, Weidong and Xing, Xiaofen and Xu, Xiangmin and Pang, Jianxin and Du, Lan},
  journal={IEEE/ACM Transactions on Audio, Speech, and Language Processing}, 
  title={SpeechFormer++: A Hierarchical Efficient Framework for Paralinguistic Speech Processing}, 
  year={2023},
  volume={31},
  number={},
  pages={775-788},
  abstract={Paralinguistic speech processing is important in addressing many issues, such as sentiment and neurocognitive disorder analyses. Recently, Transformer has achieved remarkable success in the natural language processing field and has demonstrated its adaptation to speech. However, previous works on Transformer in the speech field have not incorporated the properties of speech, leaving the full potential of Transformer unexplored. In this paper, we consider the characteristics of speech and propose a general structure-based framework, called SpeechFormer++, for paralinguistic speech processing. More concretely, following the component relationship in the speech signal, we design a unit encoder to model the intra- and inter-unit information (i.e., frames, phones, and words) efficiently. According to the hierarchical relationship, we utilize merging blocks to generate features at different granularities, which is consistent with the structural pattern in the speech signal. Moreover, a word encoder is introduced to integrate word-grained features into each unit encoder, which effectively balances fine-grained and coarse-grained information. SpeechFormer++ is evaluated on the speech emotion recognition (IEMOCAP & MELD), depression classification (DAIC-WOZ) and Alzheimer's disease detection (Pitt) tasks. The results show that SpeechFormer++ outperforms the standard Transformer while greatly reducing the computational cost. Furthermore, it delivers superior results compared to the state-of-the-art approaches.},
  keywords={Transformers;Speech processing;Task analysis;Computer vision;Computational modeling;Feature extraction;Standards;Neurocognitive disorder detection;paralinguistic speech processing;speech emotion recognition;transformer},
  doi={10.1109/TASLP.2023.3235194},
  ISSN={2329-9304},
  month={},}@ARTICLE{9445394,
  author={Fu, Houqiang and Fu, Kai and Chowdhury, Srabanti and Palacios, Tomás and Zhao, Yuji},
  journal={IEEE Transactions on Electron Devices}, 
  title={Vertical GaN Power Devices: Device Principles and Fabrication Technologies—Part II}, 
  year={2021},
  volume={68},
  number={7},
  pages={3212-3222},
  abstract={Vertical gallium nitride (GaN) power devices are enabling next-generation power electronic devices and systems with higher energy efficiency, higher power density, faster switching, and smaller form factor. In Part I of this review, we have reviewed the basic design principles and physics of building blocks of vertical GaN power devices, i.e., Schottky barrier diodes and p-n diodes. Key topics such as materials engineering, device engineering, avalanche breakdown, and leakage mechanisms are discussed. In Part II of this review, several more advanced power rectifiers are discussed, including junction barrier Schottky (JBS) rectifiers, merged p-n/Schottky (MPS) rectifiers, and trench metal-insulator-semiconductor barrier Schottky (TMBS) rectifiers. Normally- OFF GaN power transistors have been realized in various advanced device structures, including current aperture vertical electron transistors (CAVETs), junction field-effect transistors (JFETs), metal-oxide-semiconductor field-effect transistors (MOSFETs), and fin field-effect transistors (FinFETs). A detailed analysis on their performance metrics is provided, with special emphasis on the impacts of key fabrication processes such as etching, ion implantation, and surface treatment. Lastly, exciting progress has been made on selective area doping and regrowth, a critical process for the fabrication of vertical GaN power devices. Various materials characterization techniques and surface treatments have proven to be beneficial in aiding this rapid development. This timely and comprehensive review summarizes the current progress, understanding, and challenges in vertical GaN power devices, which can serve as not only a gateway for those interested in the field but also a critical reference for researchers in the wide bandgap semiconductor and power electronics community.},
  keywords={Gallium nitride;Leakage currents;Schottky diodes;Schottky barriers;Fabrication;Transistors;Power electronics;Gallium nitride (GaN);junction barrier Schottky (JBS);power electronics;power transistors;selective area doping;wide bandgap (WBG) semiconductors},
  doi={10.1109/TED.2021.3083209},
  ISSN={1557-9646},
  month={July},}@INPROCEEDINGS{9596032,
  author={Zhu, Yicheng and Ye, Zichao and Ge, Ting and Abramson, Rose and Pilawa-Podgurski, Robert C. N.},
  booktitle={2021 IEEE Energy Conversion Congress and Exposition (ECCE)}, 
  title={A Multi-Phase Cascaded Series-Parallel (CaSP) Hybrid Converter for Direct 48 V to Point-of-Load Applications}, 
  year={2021},
  volume={},
  number={},
  pages={1973-1980},
  abstract={The rapid growth in data-center electricity consumption has created an imperative need for more energy-efficient solutions to data center power delivery. This work proposes a multi-phase hybrid switched-capacitor (SC) converter for direct 48 V to point-of-load (PoL) conversion with high performance. The proposed topology can be viewed as a 6to-1 cascaded series-parallel (CaSP) converter merged with a three-phase interleaved buck converter with automatic current balancing. Due to multi-phase operation, the CaSP stage is able to achieve a higher conversion ratio compared to twophase SC converters with the same number of components as well as lower turn-on voltage for switching devices. Moreover, the proposed CaSP-PoL topology benefits from the frequency multiplication effect similar to that in flying capacitor multilevel converters, which allows for lower frequency operation of higher voltage rated switches and doubled frequency operation of buck inductors, contributing to a further reduction in switching loss and inductor size. A 48 V-to-PoL hardware prototype was built in vertical assembly structure for compact packaging and tested up to 90 A output current, achieving 94.1% peak efficiency (93.2% including gate drive loss) and 702 W/in 3 power density (by box volume) at 2.0 V output voltage.},
  keywords={Power system measurements;Density measurement;Prototypes;Switching loss;Voltage;Switches;Packaging},
  doi={10.1109/ECCE47101.2021.9596032},
  ISSN={2329-3748},
  month={Oct},}@ARTICLE{10243113,
  author={Peng, Chen and Li, Xiaoyu and Wang, Yulong},
  journal={IEEE Transactions on Instrumentation and Measurement}, 
  title={TD-YOLOA: An Efficient YOLO Network With Attention Mechanism for Tire Defect Detection}, 
  year={2023},
  volume={72},
  number={},
  pages={1-11},
  abstract={Tire quality is crucial for vehicle safety, and thus, delivery inspection is necessary. However, detecting internal tire defects from X-ray images is still a challenging task due to its complex texture background, diverse types of defects, small defect areas, and so on, which make it difficult for existing methods to achieve high accuracy and real-time performance simultaneously. In this article, a novel tire detection approach is proposed to address these problems by integrating the advantages of improved yolo network and attention mechanism (TD-YOLOA). In particular, the following holds: 1) an efficient layer aggregation network (ELAN) backbone structure is proposed to improve the ability of model detection for feature extraction, where grouped convolution is applied to enhance the information interaction and reduce computational complexity; 2) a spatial pyramid pooling with cross-stage partial convolution (SPPCSPC) is adopted to improve the efficiency of feature fusion, where the SPP module is retained for enlarging receptive field and CSPC is designed to merge features from different operations; and 3) a convolutional block attention module (CBAM) is introduced to improve the detection accuracy of small tire defects, which combines channel and spatial attention. Finally, the experimental results on a tire common defects dataset have demonstrated the superiority of the proposed TD-YOLOA method over other methods, achieving a 91.3% mean average precision (mAP) and 9.28 ms for a tire subimage, which is 0.5% and 0.65 ms better. Also, the actual industrial application verifies the effectiveness of the proposed method.},
