  title={Rule Restriction in Event Descriptive Unit Identify}, 
  year={2010},
  volume={},
  number={},
  pages={329-332},
  abstract={In the research of events description in the identification unit based on rules, formulation of rules becomes a core issue. This thesis selects 3751 information corpus of TCT corpus for the study, summarizes 9 predicate identification rules and 14 phrases merger rules, and quantify the importance of the rules by the contribution. Furthermore, the relationship between the binding rules is studied by a large number of experiments. Experimental results show that the binding between the different rules has different influence on event description unit. The paper is supported by Science and Technology Department of Shanxi Province international cooperation and exchange project ”China-Japan Cooperation Research on Chinese Intelligent Interactive Question and Answer System Based on Web ”(Grant No.2009g18).},
  keywords={Merging;Syntactics;Semantics;Training;Algorithm design and analysis;Testing;Corporate acquisitions;event descriptive unit;predicate;consolidation;rule},
  doi={10.1109/CASoN.2010.80},
