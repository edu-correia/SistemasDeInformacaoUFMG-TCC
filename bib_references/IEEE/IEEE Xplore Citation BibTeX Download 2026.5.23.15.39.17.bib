  abstract={We present a technique in image segmentation based on a hierarchical analysis of scale-space. The image hierarchy is a tree of critical lakes and provides a set of nested partitions. We analyze the scale-space from fine to coarse levels according to specific attributes.},
  keywords={Image segmentation;Image analysis;Merging;Lakes;Image coding;Buildings;Joining processes;Taxonomy;Background noise;Noise figure},
  doi={10.1109/SIBGRA.2002.1167175},
  ISSN={1530-1834},
  month={Oct},}@INPROCEEDINGS{5595853,
  author={Fourey, Sebastien and Brun, Luc},
  booktitle={2010 20th International Conference on Pattern Recognition}, 
