  abstract={An efficient kernel independent methodology to accelerate matrix multiplication in integral equation solver is presented. The proposed methodology builds on the idea of nested adaptive skeletonization and employs further compression using merged interaction list and adaptive cross approximation to demonstrate superior performance over a traditional low rank decomposition technique while preserving accuracy.},
  keywords={Integral equations;Parallel processing;Software;Error correction;Matrix decomposition;Reliability;Iterative methods;Kernel;Method of moments;Electronics packaging;Fast iterative solvers;low-rank compression;method of moments;nested skeletonization;kernel independent},
  doi={10.1109/EPEPS63858.2025.11346685},
  ISSN={2165-4115},
  month={Oct},}@INPROCEEDINGS{8874819,
  author={Huang, Jui-Chi and Hsu, Keng-Chi and Wang, Sen},
  booktitle={2019 European Microwave Conference in Central Europe (EuMCE)}, 
  title={A Wide-Tuning-Range CMOS VCO Using Current-Reuse and Resonator-Switching Techniques}, 
  year={2019},
  volume={},
  number={},
  pages={354-357},
  abstract={This letter presents a wide-tuning-range voltage-controlled oscillator (VCO) implemented by a standard 0.18-μm CMOS process. The negative-resistance part of the VCO consisting of a NMOS and a PMOS transistor forms a current-reuse topology, and the resonator-switching topology is also adopted to achieve wide-tuning range. Operating at 1.2-V supply voltage, the power consumption of the VCO is 3.54 mW. The resulting phase noise in the low-frequency band is -110.9 dBc/Hz at 1-MHz offset from the 4.05-GHz oscillation frequency, and that in the high-frequency band is estimated as -100.4 dBc/Hz at 5.66-GHz. Finally, a 3.3~5.7-GHz VCO can be obtained by merging the dual bands and the figure of merit with tuning rang (FOMT) is - 192.9 dBc/Hz.},
  keywords={Voltage-controlled oscillators;Phase noise;Tuning;Frequency measurement;MOSFET;Switching circuits;VCO;CMOS;wide-tuning-range;current-reuse;resonator-switching},
  doi={},
  ISSN={},
  month={May},}@INPROCEEDINGS{10941464,
  author={M, Ramya and K, Nagarajan K},
  booktitle={2025 International Conference on Electronics and Renewable Systems (ICEARS)}, 
  title={Enhancing Radiation Hardness of Reconfigurable RingFETs using Numerical Device Simulations}, 
  year={2025},
  volume={},
  number={},
  pages={352-356},
  abstract={The reconfigurable ringFET (RringFET), which merges the concepts of ringFET and reconfigurable FET, proves beneficial in radiation-prone environments. Several techniques, such as the use of alternate gate oxide materials, stacking gates, and device architecture modifications, further reduce the effect of irradiation on the device by making it radiation tolerant. When utilizing alternative gate oxide material, Qcollect’s value has been decreased by 75%; when stacking gates are used, Qcollect’s value has been decreased by 86%; and when modifying the device arrangement, i.e., when the arrangement is changed from OD to ID, Qcollect’s value has been decreased by 92% for a radiation dose of 10 MeV/(mg/cm2). As a result, when the arrangement of the device is modified, RringFET is illustrated to be radiation-resistant and dependable for use in irradiation-prone situations when compared to other mitigation strategies.},
  keywords={Resistance;Renewable energy sources;Radiation effects;Prevention and mitigation;Stacking;Switches;Hafnium;Logic gates;Hafnium oxide;Numerical models;RFET;ringFET;Reconfigurable ringFET;TCAD;LET;Mitigation},
  doi={10.1109/ICEARS64219.2025.10941464},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{9020638,
