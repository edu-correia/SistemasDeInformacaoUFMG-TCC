  title={Chroma Keying Literature Survey and Bibliometric Analysis Review Article}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={This study presents a comprehensive bibliometric and literature survey of research on chroma keying. Chroma keying being a fundamental technique in visual effects and video compositing where the foreground object is separated from a foreground border that is merged with a background border to generate a new combination structure for a unique result [1]–[3]. The process of isolating or extracting a foreground object from its background in an image video is known a matting [4], [5], [3]. In chroma keying the matte is achieved by the application of a solid colour (blue or green) that can be easily distinguished from the foreground subject. In live outdoor sports broadcasts, one of the major challenges lies is applying chroma keying in non consistant or different lighting conditions. The difference in lighting result to different shades of colour in the background to be used. Natural light changes throughout the day, affecting how colours appear on camera. The wide range of colours present in outdoor environments can often lead to blending or overspill effects, where the hues of foreground elements closely resemble those of the background. By analyzing publications from databases such as Scopus and Web of Science, this work identifies key trends, influential authors, research hotspots, and thematic evolutions in chroma keying research. The results provide a quantitative overview and qualitative insights into the progression of chroma keying technologies, algorithms, and applications in film and digital media in the African continent. With these results from the database, different approaches to matting applications have been discovered that can be independent from colour sampling which the author can adopt to address his challenge. Analysis drawn from these data shows that only a certain part of the world has been involved in this study, thus the African continent has a huge gap of research in this area as television productions are on the rise.},
  keywords={Surveys;TV;Image color analysis;Bibliometrics;Production;Africa;Rendering (computer graphics);Market research;Real-time systems;Videos;Chroma-Keying;Alpha Matting;Classification;Compositing},
  doi={10.1109/IMITEC67386.2025.11410490},
  ISSN={},
  month={Nov},}@ARTICLE{11421975,
  author={Bartoletti, Stefania and Focarelli, Giulia and Palamà, Ivan and Zanini, Samuele and Melazzi, Nicola Blefari and Bianchi, Giuseppe},
  journal={IEEE Journal on Selected Areas in Communications}, 
  title={Practical Blind Full-Frame Replay Attacks on OFDM-Based ISAC Systems}, 
  year={2026},
  volume={44},
  number={},
  pages={4239-4253},
  abstract={Integrated Sensing and Communication (ISAC) systems promise unprecedented capabilities by merging connectivity and situational awareness, but also expose new attack surfaces at the physical layer. In this work, we demonstrate a blind full-frame OFDM replay attack that manipulates sensing outputs by injecting false targets and concealing real ones, without disrupting communication. The blind nature of our threat model lies in the fact that it requires neither synchronization nor any knowledge of the signal structure, reference signals, or sensing parameters, making it not only practically viable, but even (somewhat) straightforward to execute. By replaying entire OFDM frames with a controlled delay and a frequency shift, the attacker can distort range estimations and induce Doppler shifts, mimicking the presence of moving targets. We present a general analytical framework to characterize the attack’s impact on range-Doppler processing and validate it through both system-level simulations with 5G NR parameters and real-world experiments. Experimental results build directly on a working 5G testbed with software-defined radios and commercial off-the-shelf hardware, which we extend with sensing capabilities, thereby demonstrating the attack’s feasibility and impact in a realistic ISAC scenario.},
  keywords={OFDM;Synchronization;Symbols;Location awareness;Radar;Integrated sensing and communication;Transmitting antennas;Threat modeling;Radar antennas;Delays;Integrated sensing and communication;security;threat models;replay attack;integrity},
