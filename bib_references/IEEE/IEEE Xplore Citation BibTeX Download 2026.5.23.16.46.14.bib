  ISSN={},
  month={Nov},}@INPROCEEDINGS{11209396,
  author={Alqarafi, Abdulrahman},
  booktitle={2025 2nd International Conference on Computing and Data Science (ICCDS)}, 
  title={Lesion-Feed: Adaptive Feed-Forward Network Integrated with Representation Learning for Skin Lesion Analysis and Segmentation}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Background-Skin cancer (SC) ranks among the most predominant kind of cancer worldwide. Existing limitations in traditional approaches for skin lesion segmentation include high computational costs of Transformers, limiting their use in real-time or resource-constrained environments. Methods - Lesion-Feed, designed to optimize segmentation performance. The input fed into the Localized Attention Module (LAM), which capture rich spatial features and the extracted features are then refined using a Gated Convolutional Feed-Forward Network integrated with a Transformer. The framework incorporates a Global Attention Integration with Residual Block (GAR-B) to enhance representation learning. Additionally, the Long Skip-Fusion Enhancement Module (LSFE) facilitates seamless information flow by merging spatial details Finally, the upsampling block paired with LSFE ensures accurate alignment achieving SC analysis and segmentation Results-Our model attains accuracy of 99.25 and precision of 0.98 and recall of 0.99 Conclusion- Finally, Lesion-Feed shows strong performance and the model was a promising tool for real-time SC diagnosis.},
  keywords={Representation learning;Analytical models;Accuracy;Feature extraction;Transformers;Real-time systems;Skin;Computational efficiency;Lesions;Cancer;Deep Learning;Attention Module;Image processing;Image segmentation;Convolution Neural Network},
  doi={10.1109/ICCDS64403.2025.11209396},
  ISSN={},
  month={July},}@INPROCEEDINGS{11019782,
  author={Arun, Lathika and John, Smitha},
  booktitle={2025 Fourth International Conference on Smart Technologies, Communication and Robotics (STCR)}, 
  title={Automated Esophageal Cancer Detection using Convolutional Neural Networks for Early Diagnosis}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Successful therapy of esophageal cancer, Based on precise and timely detection, effective treatment of esophagus cancer, which is a highly severe condition, is possible. Traditional modes of diagnostic endoscopy and biopsy procedures are considerably time-intensive which leads to procrastinated diagnoses. With this in mind, attempts have been made to overcome these boundaries through the use of convolutional neural networks (CNN) for neural computation of esophageal cancer detection. The system employes both CNN and VGG-19 models for analyzing medical images that include both endoscopic and histopathologic images, as well as differentiating cancerous tissue from non-cancerous ones. The combination of feature extraction through CNN and classification of the images using the deeper network of VGG-19 results in enhanced accuracy of diagnosis and assists physicians in making better decisions. Steps of the proposed system are feature extraction, classification and image preparation. Others include model hyperparameter fine-tuning, such as augmentation, normalization, and resizing, which increases generalization and efficiency of the model. The CNN and VGG-19 architectures enable spatially and structurally patterns to be detected autonomously, thereby decreasing the need for manual feature engineering. Subsequent to the deeply learned features, the final classifier easily dicriminates between non-cancerous and cancerous images. The last classification layer allows for the rapid and accurate differentiation of images for cancerous and non-cancerous tissues. This new technique helps the pathologist and radiologist in making decisions by reducing the margin for error, speeding up the diagnosis, and merging with clinical routine. The use of CNN and VGG-19 in the detection of esophagus cancer has numerous advantages such as increased accuracy, speedier diagnosis, and lower reliance on human judgment. Technology improves the survival rate of patients by improving the early detection capabilities. Future studies may focus on the integration of clinical data and multimodal data for a holistic analysis, and could also make use of more refined architectures like ResNet or Inception for better results. This study allows for more refined methods of early intervention with the understanding that deep learning fundamentally changes how cancer detection is done.},
  keywords={Deep learning;Accuracy;Computer architecture;Feature extraction;Cancer detection;Convolutional neural networks;Reliability;Robots;Cancer;Esophagus;Convolutional neural networks (CNN);VGG-19;ResNet;DeepLearning;Esophagus cancer},
  doi={10.1109/STCR62650.2025.11019782},
  ISSN={},
  month={May},}@ARTICLE{9530866,
  author={Wang, Minghui and Li, Qingpeng and Gu, Yunchao and Fang, Leyuan and Zhu, Xiao Xiang},
  journal={IEEE Geoscience and Remote Sensing Letters}, 
  title={SCAF-Net: Scene Context Attention-Based Fusion Network for Vehicle Detection in Aerial Imagery}, 
  year={2022},
  volume={19},
  number={},
  pages={1-5},
  abstract={In recent years, deep learning methods have achieved great success for vehicle detection tasks in aerial imagery. However, most existing methods focus only on extracting latent vehicle target features, and rarely consider the scene context as vital prior knowledge. In this letter, we propose a scene context attention-based fusion network (SCAF-Net), to fuse the scene context of vehicles into an end-to-end vehicle detection network. First, we propose a novel strategy, patch cover, to keep the original target and scene context information in raw aerial images of a large scale as much as possible. Next, we use an improved YOLO-v3 network as one branch of SCAF-Net, to generate vehicle candidates on each patch. Here, a novel branch for the scene context is utilized to extract the latent scene context of vehicles on each patch without any extra annotations. Then, these two branches above are concatenated together as a fusion network, and we apply an attention-based model to further extract vehicle candidates of each local scene. Finally, all vehicle candidates of different patches, are merged by global nonmax suppress (g-NMS) to output the detection result of the whole original image. Experimental results demonstrate that our proposed method outperforms the comparison methods with both high detection accuracy and speed. Our code is released at https://github.com/minghuicode/SCAF-Net.},
  keywords={Vehicle detection;Feature extraction;Task analysis;Remote sensing;Computer architecture;Training;Testing;Attention-based model;deep learning;fusion network;remote sensing;vehicle detection},
