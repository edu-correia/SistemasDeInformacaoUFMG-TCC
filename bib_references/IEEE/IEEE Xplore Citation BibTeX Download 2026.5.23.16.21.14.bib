  title={Shared-memory implementation of the Karp-Sipser kernelization process}, 
  year={2021},
  volume={},
  number={},
  pages={71-80},
  abstract={We investigate the parallelization of the Karp-Sipser kernelization technique, which consti-tutes the central part of the well-known Karp-Sipser heuristic for the maximum cardinality matching problem. The technique reduces a given problem instance to a smaller but equivalent one, by repeated applications of two operations: vertex removal, and merging two vertices. The operation of merging two vertices poses the principal challenge in parallelizing the technique. We describe an algorithm that min-imizes the need for synchronization and present an efficient shared-memory parallel implementation of the kernelization technique for bipartite graphs. Using extensive experiments on a variety of multicore CPUs, we show that our implementation scales well up to 32 cores on one socket.},
  keywords={Multicore processing;Sockets;Instruction sets;High performance computing;Conferences;Merging;Bipartite graph;mathching;shared memory;data reduction},
  doi={10.1109/HiPC53243.2021.00021},
  ISSN={2640-0316},
  month={Dec},}@ARTICLE{11245486,
  author={Lee, Byeongyeong and Byun, Kyeongsu and Kwon, Joonho},
  journal={IEEE Access}, 
  title={LSM HB-Tree: An LSM Tree Augmented With Hierarchical B-Tree for Efficient Range Query Processing on Blockchain Data}, 
  year={2025},
  volume={13},
  number={},
  pages={194596-194613},
  abstract={With the rapid proliferation of blockchain technology, the volume of stored data has increased dramatically. Existing blockchain systems typically employ a key–value storage model, which is efficient for single-key lookups but inadequate for complex queries such as value-based conditional searches and range queries. Although several studies have attempted to support complex queries by integrating external databases, such approaches inherently suffer from integrity and synchronization issues. To address these limitations, we propose and implement an LSM-Tree augmented with hierarchical, level-specific B-tree indexes (referred to as LSM HB-tree). The proposed architecture augments the conventional LSM-Tree hierarchy with level-specific B-tree indexes, thereby supporting composite key indexing and improving the efficiency of data retrieval within on-chain storage. Index construction builds a B-tree index for SSTables at each level, thereby reducing disk access costs and significantly improving the performance of equality and range queries. We evaluate the system by varying the SSTable threshold from 2 MiB to 32 MiB and observe that an 8 MiB threshold provides the best trade-off between write latency and query efficiency. Under this configuration, experiments with equality and range queries under selectivity levels ranging from 0.01% to 100% demonstrate that LSM HB-tree substantially reduces query latency compared to the conventional LSM-Tree. Furthermore, multi-threaded experiments with up to 16 threads reveal that the best performance for both equality and range queries is achieved with four threads. Collectively, these results confirm that LSM HB-tree is a practical and effective index structure for supporting efficient complex queries entirely within the internal blockchain architecture.},
  keywords={Blockchains;Trees (botanical);Indexing;Query processing;Synchronization;Databases;Compaction;Research and development;Metadata;Throughput;Blockchain;LSM-tree;B-tree;range query processing;hierarchical indexing;parallel query execution},
  doi={10.1109/ACCESS.2025.3632512},
  ISSN={2169-3536},
  month={},}@ARTICLE{11208813,
  author={Yin, Huilin and Zhen, Pengju and Zhang, Linchuan and Betz, Johannes},
  journal={IEEE Transactions on Aerospace and Electronic Systems}, 
  title={HSR-VINS: Hybrid Structural Regularities for Robust Visual–Inertial Navigation System}, 
  year={2026},
  volume={62},
  number={},
  pages={556-570},
  abstract={Visual–inertial navigation systems (VINS) are critical for aerial vehicles and robotics. However, traditional sparse point-based VINS are limited by the number of tracked points and do not effectively utilize structural information in the environment. To address this, we propose a visual–inertial navigation system with hybrid structural regularities (HSR-VINS). This system integrates camera and inertial measurement unit (IMU) data and leverages multiple structural features in a nonindependent manner. In the front-end, HSR-VINS introduces plane feature extraction and merging methods, ensuring robust detection and tracking of planes. It also develops a direction-guided merging approach to efficiently generate reliable line features and extracts vanishing points using a two-line exhaustive search to capture the structural regularities. In addition, the coplanarity of lines is determined using a 2-D convex hull-based method to avoid feature redundancy. In the back-end, multiple structural regularities are integrated into the pose estimation process through residuals including line reprojection, vanishing points, point-plane, and line-plane residuals. Our method achieves an average root-mean-square error APE of 0.07 m on the EuRoC dataset and 3.41 m on the KITTI dataset.},
  keywords={Feature extraction;Simultaneous localization and mapping;Three-dimensional displays;Merging;Cameras;Accuracy;Optimization;Navigation;Aerospace and electronic systems;Vectors;Feature extraction;sensor fusion;visual-inertial navigation},
