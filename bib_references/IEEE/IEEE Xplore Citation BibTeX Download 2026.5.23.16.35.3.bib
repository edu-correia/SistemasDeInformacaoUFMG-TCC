  author={Rangu, Sridhar and Chadha, Kawaljeet Singh and Samala, Srilatha},
  booktitle={2025 Tenth International Conference on Science Technology Engineering and Mathematics (ICONSTEM)}, 
  title={AI-Powered Cloud Architecture, Agile Analytics, and Enterprise DevOps -Enabled Framework for Healthcare and Insurance Ecosystem Optimisation}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This framework introduces a transformative AI driven architecture based on GPT 4 powered intelligent automation and Azure machine learning pipelines to revolutionise healthcare insurance ecosystem interoperability. The solution merges the use of real time predictive analytics using TensorFlow-based neural networks for claims processing optimization resulting in a shortened approval process down by 73 %. Kubernetes orchestrated microservices to be deployed with CI/CD pipelines via Jenkins then gitops with 99.9 % availability of the system. NLP using BERT models is used in the framework for the automated interpretation of the medical records improving the diagnostic accuracy by 41 %. Apache Kafka makes it possible to stream data easily between Electronic Health Records (EHR) and insurances and MLOps workflows making it possible to update the existing model continuously. Security compliance, that meets HIPAA standards with audit trails created with blockchain technology activities. Performance evidence demonstrating Operational Expenditure 58% Patient Claim Reconciliation efficiency 65 % is established Startling Scalable FHIR compliant Healthcare Digitalization infrastructure of next generation.},
  keywords={Biological system modeling;Pipelines;Ecosystems;Neural networks;Microservice architectures;Medical services;Computer architecture;Real-time systems;Security;Optimization;AI-Powered Healthcare Analytics;DevOps Microservices Architecture;Predictive Claims Processing;FHIR-Compliant Interoperability;MLOps Pipeline Optimization;Blockchain Healthcare Security},
  doi={10.1109/ICONSTEM65670.2025.11374414},
  ISSN={2996-2986},
  month={Nov},}@INPROCEEDINGS{11188344,
  author={Gupta, Akhil and Bakshi, Aditya and Rakesh, Nitin},
  booktitle={2025 Third International Conference on Networks, Multimedia and Information Technology (NMITCON)}, 
  title={UAV-Based Surveillance of Endangered Wildlife Using Machine Learning and Artificial Intelligence}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The Unmanned Aerial Vehicles (UAVs), together with Machine Learning (ML) and Artificial Intelligence (AI), are the emerging technologies for the transformation of wildlife conservation. EcoDroneNet is introduced in this paper as a novel framework integrating drone surveillance with advanced AI analytics to detect, classify, and protect endangered wildlife. The system utilizes high-resolution aerial imagery and sensor data, analyzed through Convolutional Neural Networks (CNNs) and bioacoustics algorithms, to realize real-time species detection, behavior tracking, and threat identification. The present framework achieves a near 98 percent accuracy when implemented for population estimation, habitat mapping, and robber detection. Thus, the study argues for using UAVs in data collection in inaccessible terrains and AI to gain actionable insights through pattern recognition, thermal and light detection and ranging (LiDAR) analyses, and predictive modeling. Furthermore, considerations have been made regarding environmental ethics, including airspace regulations, data protection, and factors concerning wildlife disturbance. EcoDroneNet is a scalable, non-intrusive, low-cost biodiversity monitoring solution that merges new technology with eco-goals. Ultimately, the work aims to give a strong motivation for proactive conservation measures and the formulation of sustainable protection operations for wildlife.},
  keywords={Laser radar;Surveillance;Wildlife;Machine learning;Regulation;Real-time systems;Thermal analysis;Convolutional neural networks;Environmental management;Protection;UAVs;Machine Learning;Artificial Intelligence;CNN;LiDAR},
  doi={10.1109/NMITCON65824.2025.11188344},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11469759,
  author={KS, Akshaya and A, Harshita and M, Suriya Lakshmi and S, Padma Devi},
  booktitle={2026 Second International Conference on Multi-Agent Systems for Collaborative Intelligence (ICMSCI)}, 
  title={Hybrid Deep Learning Architecture for Non-Invasive MGMT Methylation Prediction in Glioblastoma Using Multi-Modal MRI}, 
  year={2026},
  volume={},
  number={},
  pages={697-702},
  abstract={Glioblastoma is still the most invasive type of primary brain tumor in adults, accounting for highly elevated mortality rates, and median survival times hardly ever go above 15 months with current therapies. The methylation status of the MGMT promoter is a major biomarker for predicting the response of a patient to a temozolomide, based chemotherapy, thus it allows for the tailoring of treatment plans and providing precise prognosis. One of the ways to carry out MGMT tissue biopsy determination has been through surgery which comes with substantial risks for patients, therefore causing diagnostic delays and a sampling problem due to intratumoral heterogeneity. Hence, a novel hybrid architecture is proposed in this paper which combines different paradigms of representation learning such as: a two-dimensional slice analysis based on the Swin Transformer, a volumetric three-dimensional ResNet encoding, and traditional handcrafted radiomic descriptors, which are then combined through an attention-driven fusion mechanism. The technique uses advanced training methods such as mixup regularization, smooth label calibration, focal loss optimization, test, time augmentation, and stratified k-fold cross-validation. In total, 585 glioblastoma cases were used for a thorough experimental study that showed the way our combined multipath method achieves an overall accuracy of 87.16%, which is way more than the accuracies of standalone radiomics pipelines and deep learning architectures. The model showed remarkable performance stability in cross-validation, thus it demonstrated the robustness that is required for clinical usage. This multi-scale representation model successfully merges the visual abstractions learned and the domain-specific engineered features, thus it can be considered a promising clinical virtual assistant.},
  keywords={Filtering;Filters;Circuits and systems;Protocols;LoRa;Radio frequency;HTTP;Radio communication;Data communication;Information and communication technology;Glioblastoma;MGMT Methylation;Radiogenomics;Swin Transformer;3D ResNet;Hybrid Deep Learning;Medical Image Analysis},
  doi={10.1109/ICMSCI67830.2026.11469759},
  ISSN={},
  month={March},}@INPROCEEDINGS{11368350,
  author={Dang, Gurnoor Singh and Rodgar, Majid and Snyder, Michael},
  booktitle={2025 4th International Conference on Computing, Management and Telecommunications (ComManTel)}, 
  title={Engineering Imaging Systems Using AI for Advanced Biotechnological Visualization}, 
  year={2025},
  volume={},
  number={},
  pages={258-263},
  abstract={The use of robotics in the medical field has been growing. But these unmanned systems lack the intelligence layer for automated diagnostics and cure. Imaging is at the core of this problem. Modern medical imaging plays a central role in diagnostics, yet each modality carries unique strengths alongside unavoidable limitations. Drawing on insights from Stanford’s Mini-Fellowship in Molecular Imaging Techniques, this study introduces FusionScan, a novel framework that unites Magnetic Resonance Imaging (MRI) and Computed Tomography (CT) with an AI-driven enhancement system. The goal is to evaluate whether this combination can achieve greater depth, resolution, and functional detail by harnessing the complementary advantages of both modalities, offering a more comprehensive solution for complex diagnostic needs. The approach involves merging MRI and CT data and applying AI algorithms to refine resolution and increase molecular specificity. Particular emphasis is placed on the challenge of multimodal alignment, with strategies proposed to ensure precise registration between imaging outputs. Publicly available medical imaging datasets will serve as the testing ground for assessing how AI improves reconstruction, resolution, and adaptive adjustment of imaging parameters. An integrated feedback mechanism is also planned, allowing the system to modify scanning parameters in real time based on preliminary AI assessments. This feature is designed to minimize radiation exposure, shorten scan durations, and concentrate detail on regions requiring closer examination. Ultimately, this study envisions an equitable, autonomous imaging ecosystem that combines AI, robotics, and multimodal data fusion to make advanced diagnostics more accessible across healthcare systems worldwide. The proposed architecture demonstrates how intelligent imaging and robotic coordination can extend highperformance diagnostics beyond traditional hospital settings, aligning with global goals of healthcare equity and sustainability.},
  keywords={Image resolution;Magnetic resonance imaging;Computed tomography;Robot kinematics;Surgery;Real-time systems;Planning;Artificial intelligence;Medical diagnostic imaging;X-ray imaging;Magnetic Resonance Imaging;Molecular Imaging Techniques;X-Ray Computed Tomography;Artificial Intelligence;Medical Imaging;Oncology;Disease Detection},
  doi={10.1109/ComManTel68363.2025.11368350},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11440652,
  author={Yadav, Ram Kumar and Kumar, Manoj and Sakhare, Apeksha and Moriwal, Rahul},
  booktitle={2025 International Conference on Artificial Intelligence and Quantum Computation-Based Sensor Application (ICAIQSA)}, 
  title={A Multi-Input Deep Learning Framework for Prediction of Parkinson Disease Using Voice, Gait and Neuroimaging Data}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Parkinson's disease (PD) is a progressive high impact neurodegenerative irregular marked by motor and non-motor features. Earlier diagnosis is crucial for successful medication. This research explores combining three distinguish datasets voice, gait, and neuroimaging to improve medication accuracy. We design and develop machine learning frameworks for every dataset, utilizing their identified unique features to recognize PD patients. Using the proposed model the predictions from these models had merged into an ensemble model, leveraging the strengths of this multimodal approach. The proposed ensemble model showed higher accuracy than the models. This approach provides a viable avenue for developing trustworthy accurate and therapeutically applicable testing devices for Parkinson’s disease.},
  keywords={Neuroimaging;Deep learning;Analytical models;Accuracy;Three-dimensional displays;Parkinson's disease;Predictive models;Data models;Convolutional neural networks;Medical diagnostic imaging;Gait Analysis;Parkinson’s Disease;Deep Learning;Multimodal;CNN;Social Impact},
  doi={10.1109/ICAIQSA67794.2025.11440652},
