  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/9865062},}@INPROCEEDINGS{11337017,
  author={M, Ajitha and P, Harini and J, Martin Leo Manickam},
  booktitle={2025 10th International Conference on Communication and Electronics Systems (ICCES)}, 
  title={Harnessing AI and EI Sensor Fusion for Real-Time Detection of Emotional Distress and Personalized Mental Health Intervention in Stress-Prone Individuals}, 
  year={2025},
  volume={},
  number={},
  pages={532-539},
  abstract={Mental health disorders, such as Distress Hyperactivity Disorder (DHD) and Obsessive-Compulsive Disorder (OCD), are on the rise due to occupational stress, trauma, and lifestyle behaviors, making high-risk populations–including train drivers, trauma patients, and individuals experiencing hormonal changes–particularly susceptible. Existing interventions rely predominantly on unimodal systems, namely facial recognition or single biometric inputs, which are insufficient for delivering timely, specific, and individualized support, especially during episodes of acute distress. To address this gap, the project proposes a multimodal, real-time emotion detection sys- tem capable of merging facial expression input with physiological signals from temperature, sweat, and accelerometer sensors. This combination enables effective monitoring even in the absence of usable facial input, thereby ensuring continuous observation for signs of stress, anxiety, or emotional dysregulation. The goal is to deliver instant, non-invasive supportive therapies. The novelty of this work lies in its independence from singular data sources, its capacity for adaptive individualization based on historical trends, and its seamless provision of context-aware mental health support.},
  keywords={Temperature sensors;Emotion recognition;Occupational stress;Face recognition;Medical treatment;Mental health;Real-time systems;Electronic healthcare;Biomedical monitoring;Monitoring;real-time emotion detection;facial recognition;physiological sensors;mental health;distress intervention;OCD;DHD;occupational stress;adaptive therapy;continuous monitoring;personalized support;biofeedback;non-invasive;high-risk populations;digital healthcare},
  doi={10.1109/ICCES67310.2025.11337017},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10337372,
  author={Leibold, Patrick and Diller, Nikolaj and Reißmann, Sylvia and Faber, Claas},
  booktitle={OCEANS 2023 - MTS/IEEE U.S. Gulf Coast}, 
  title={BELUGA: An Integrated Marine Multi-Platform Infrastructure and Near Real-Time Ocean Data Visualization Tool}, 
  year={2023},
  volume={},
  number={},
  pages={1-10},
  abstract={In addition to sampling the ocean by conventional platforms such as research vessels, a wide variety of instruments and autonomous vehicles, today's marine research increasingly relies on measurements by private individuals known as citizen scientists. To provide decision-makers, scientists and instrument operators with a comprehensive picture of the situation at any time during a marine field campaign, data from all involved sources and parties must be immediately merged and visualized. The challenge of bringing together a large number of different devices, sensor platforms, interfaces and data formats has been our motivation for the development of BELUGA since 2019. BELUGA, our modular data infrastructure, offers capabilities to integrate local devices and autonomous sensor platforms operating in the vicinity of research vessels as well as remote data sources via satellite networks and the Internet. Common tasks such as locating and communicating with underwater platforms are also handled. A web-based, intuitive user interface visualizes all aggregated data for different user groups and allows a media-supported presentation for the interested public. BELUGA has already proven itself during international campaigns and is being actively developed in ongoing projects. We present the current state of our infrastructure, detail the function and interaction of key components and outline our vision for BELUGA's future.},
  keywords={Satellites;Oceans;Soft sensors;Instruments;Data visualization;Sea measurements;Real-time systems;data aggregation;data visualization;web-based applications;situational awareness;campaign monitoring;underwater networks;autonomous vehicles;citizen science},
  doi={10.23919/OCEANS52994.2023.10337372},
  ISSN={0197-7385},
