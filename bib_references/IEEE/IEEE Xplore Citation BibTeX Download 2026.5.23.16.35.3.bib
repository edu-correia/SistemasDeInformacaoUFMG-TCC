@INPROCEEDINGS{11132058,
  author={Hasanović, Amar and Pozderac, Damir and Cogo, Ehlimana and Cogo, Emir and Bešić, Ingmar},
  booktitle={2025 MIPRO 48th ICT and Electronics Convention}, 
  title={Comparison of MSP-EXP432P401R Program Performances by Using Different Development Environments}, 
  year={2025},
  volume={},
  number={},
  pages={2073-2076},
  abstract={Texas Instruments development kits have a wide application in practical and scientific experiments due to their small size, processing power, available booster packs, and compatibility with different environments. The most popular integrated development environments for programming these development kits are Energia and Code Composer Studio. Unfortunately, there are no existing studies that compare the benefits and drawbacks of these environments and their performances. Conversely, the performances of the FreeRTOS environment are well-explored, making it a suitable baseline for embedded systems execution. In this paper, we performed the experimental evaluation of the performance of Texas Instruments MSP-EXP432P401R when using Energia, Code Composer Studio, and FreeRTOS for program execution. Three different sorting algorithms (bubble sort, radix sort, merge sort) and three different search algorithms (binary search, random search, linear search) were used for this purpose. The results show that Energia sorting algorithms outperform other environments with a maximum of 400 elements. On the other hand, FreeRTOS search algorithms far outperform other environments with a maximum of $\mathbf{2 5 5, 0 0 0}$ elements (whereas this maximum was $\mathbf{1 0, 0 0 0}$ elements for other environments). Code Composer Studio resulted in the largest processing time, which indicates that the lowlevel registry editing performed in this environment leads to significant performance issues.},
  keywords={Hands;Codes;Embedded systems;Memory management;Process control;Energy measurement;Programming;Real-time systems;Registers;Sorting;real-time systems;performance analysis;Texas Instruments;IDE comparison},
  doi={10.1109/MIPRO65660.2025.11132058},
  ISSN={1847-3938},
  month={June},}@INPROCEEDINGS{9212133,
  author={Company-Corcoles, Joan P. and Garcia-Fidalgo, Emilio and Ortiz, Alberto},
  booktitle={2020 25th IEEE International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={Towards Robust Loop Closure Detection in Weakly Textured Environments using Points and Lines}, 
  year={2020},
  volume={1},
  number={},
  pages={1313-1316},
  abstract={SLAM approaches rely on loop closure strategies to correct the inconsistencies of the generated map. These inconsistencies are mainly caused by the effect of sensor noise in odometry sources. For the case of visual SLAM, loop detection typically rely on the repetitive detection and matching of texture-based keypoints. Weakly textured environments, however, can lead to scenes lacking these kind of points and, hence, poor-performing loop detectors. An alternative for these environments is the use of geometrical cues such as line segments, which are frequently present within human-made, structured environments. Under this context, in this work, we introduce a novel appearance-based loop closure detection method that integrates lines and points to enhance performance in these scenarios. For this purpose, we build an incremental Bag-of-Binary-Words scheme for each visual cue to retrieve previously seen images from the two complementary perspectives. Furthermore, we rely on a late fusion strategy to combine the image candidates resulting for both visual vocabularies. An effective mechanism to group similar images close in time is applied next to reduce the effort of the image candidate search. Finally, we propose a novel scheme to validate geometrically the loop candidates, integrating lines into the procedure. The proposed approach compares favourably with other state-of-the-art methods for several datasets.},
  keywords={Visualization;Vocabulary;Simultaneous localization and mapping;Conferences;Merging;Detectors;Proposals},
  doi={10.1109/ETFA46521.2020.9212133},
  ISSN={1946-0759},
  month={Sep.},}@INPROCEEDINGS{9433772,
  author={Sprenger, J. and Saathoff, T. and Schlaefer, A.},
  booktitle={2021 IEEE 18th International Symposium on Biomedical Imaging (ISBI)}, 
  title={Automated Robotic Surface Scanning With Optical Coherence Tomography}, 
  year={2021},
  volume={},
  number={},
  pages={1137-1140},
  abstract={Optical coherence tomography (OCT) is a near-infrared light based imaging modality that enables depth scans with a high spatial resolution. By scanning along the lateral dimensions, high-resolution volumes can be acquired. This allows to characterize tissue and precisely detect abnormal structures in medical scenarios. However, its small field of view (FOV) limits the applicability of OCT for medical examinations. We therefore present an automated setup to move an OCT scan head over arbitrary surfaces. By mounting the scan head to a highly accurate robot arm, we obtain precise information about the position of the acquired volumes. We implement a geometric approach to stitch the volumes and generate the surface scans. Our results show that a precise stitching of the volumes is achieved with mean absolute errors of 0.078 mm and 0.098 mm in the lateral directions and 0.037 mm in the axial direction. We can show that our setup provides automated surface scanning with OCT of samples and phantoms larger than the usual FOV.},
  keywords={Head;Optical coherence tomography;Merging;Phantoms;Surgery;Coherence;Manipulators;Surface scanning;volume stitching;optical coherence tomography;robotic surgery},
  doi={10.1109/ISBI48211.2021.9433772},
  ISSN={1945-8452},
  month={April},}@INPROCEEDINGS{9884727,
  author={Taskin, Gulsen},
  booktitle={IGARSS 2022 - 2022 IEEE International Geoscience and Remote Sensing Symposium}, 
  title={A Model Distillation Approach for Explaining Black-Box Models for Hyperspectral Image Classification}, 
  year={2022},
  volume={},
  number={},
  pages={3592-3595},
  abstract={Recent studies in remote sensing reveal that complex nonlinear learning models such as deep learning or ensemble-based learning are mostly preferred compared to shallow machine learning methods in solving many problems such as classification, image fusion, change detection, unmixing, and object recognition. The fact that much remote sensing data can be obtained quickly, abundantly, and free of charge, and the increasing computing power of computers with developing technology, are why such methods are preferred. With the emergence of big data, these methods provide more effective solutions than in past years, and they can outperform shallow machine learning methods in many remote sensing applications. Despite their high accuracy, such learning models have several limitations due to their black-box structure. Because of the high nonlinearity in predictive models, these models cannot explain why and how decisions are made. This paper presents a global model distillation approach to replace a black-box model with a fully explainable surrogate model utilizing polynomial chaos expansion. Preliminary results show that the proposed method can accurately replace a complex nonlinear model with a simpler one in hyperspectral image classification.},
  keywords={Chaos;Deep learning;Merging;Predictive models;Object recognition;Random forests;Monitoring;Explainable AI;Hyperspectral image classification;surrogate modeling;model distillation},
  doi={10.1109/IGARSS46834.2022.9884727},
  ISSN={2153-7003},
  month={July},}@INPROCEEDINGS{10490734,
  author={You, Zengying and Wang, Xian and Yan, Yunan and Xu, Jiawen},
  booktitle={2023 International Conference on Sensing, Measurement & Data Analytics in the era of Artificial Intelligence (ICSMD)}, 
  title={Transformer-Based Bolt Looseness Detection with Data Augmentation by Variational Autoencoders}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Bolt looseness would lead to hazardous damage to engineering structures. Neural network-based algorithms can effectively monitor health conditions using the impedance signal. On the other hand, the impedance data is difficult to obtain, and the data has an imbalanced distribution. In this research, we propose a data augmentation method based on the Variational Autoencoder (VAE) model with channel attention and spatial attention mechanisms. This model takes advantage of the VAE model to generate additional data to resolve the issue of an imbalanced sample. The new dataset is then fed into the Transformer model for training and fault identification. Experimental results demonstrate that this method performs well in enhancing and classifying imbalanced data, increasing accuracy from 81.82% to 87.01%.},
  keywords={Training;Merging;Training data;Fasteners;Transformers;Data augmentation;Data models;Bolt looseness;Variational autoencoder;Data augmentation;Transformer model},
  doi={10.1109/ICSMD60522.2023.10490734},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10992108,
  author={Wang, Penghui and Zhou, Yang and Yang, Ge and Wu, Haixiang},
  booktitle={2024 4th International Conference on Digital Society and Intelligent Systems (DSInS)}, 
  title={ResSCFuse: A Fusion Network for Infrared and Visible Images Based on Restormer Attention and Semi-Coupled Feature Reconstruction Net}, 
  year={2024},
  volume={},
  number={},
  pages={243-249},
  abstract={The aim of fusing infrared and visible images is to produce a composite image that features both significant targets and detailed textures. The existing CNN-based and AutoEncoder(AE) fusion methods are not effective at capturing information from distant pixels, and when performing feature modeling within the same scene, they overlook the shared and private characteristics of cross-modal features. In this paper, we present a new approach for fusing infrared and visible images. The method utilizes a multi-scale features fusion structure, which comprise an encoder network, Semi-Coupled Feature Reconstruction Nets, fusion layers, and a decoder network. The encoder based on Restormer attention mechanism can extract multi-scale global-local features from the source images. Features at different scales are processed by the Semi-Coupled Feature Reconstruction Network (SCFRNet) to extract shared and private features. Then these features are input into a fusion layer for convolutional fusion. This allows for effective reconstruction of images from the feature maps. Experiments on public datasets show that this method outperforms other advanced fusion techniques methods in both objective and subjective assessments.},
  keywords={Measurement;Attention mechanisms;Merging;Lighting;Feature extraction;Image restoration;Intelligent systems;Image reconstruction;Image fusion;Image enhancement;Image fusion;Restormer;Semi-Coupled Feature Reconstruction Net;Deep learning},
  doi={10.1109/DSInS64146.2024.10992108},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{8902915,
  author={Yen, Li-Hsing and Chang, Chi-Han and Chen, Yi Chia},
  booktitle={2019 IEEE Wireless Communications and Networking Conference Workshop (WCNCW)}, 
  title={Profit Maximization by Forming Federations of Geo-Distributed MEC Platforms}, 
  year={2019},
  volume={},
  number={},
  pages={1-6},
  abstract={Multi-access edge computing (MEC) as an emerging technology which provides cloud service in the edge of multi-radio access networks aims to reduce the service latency experienced by end devices. When individual MEC systems do not have adequate resource capacity to fulfill service requests, forming MEC federations for resource sharing could provide economic incentive to MEC operators. To this end, we need to maximize social welfare in each federation, which involves efficient federation structure generations, federation profit maximization by resource provisioning configuration, and fair profit distribution among participants. We model the problem as a coalition game with difference from prior work in the assumption of latency and locality constraints and also in the consideration of various service policies/demand preferences. Simulation results show that the proposed approach always increases profits. If local requests are served with local resource with priority, federation improves profits without sacrificing request acceptance rates.},
  keywords={Resource management;Merging;Cloud computing;Servers;Energy efficiency;Mobile communication;Edge computing},
  doi={10.1109/WCNCW.2019.8902915},
  ISSN={},
  month={April},}@INPROCEEDINGS{9068992,
  author={Betting, Jan-Harm L.F. and Romano, Vincenzo and Bosman, Laurens W.J. and Al-Ars, Zaid and De Zeeuw, Chris I. and Strydis, Christos},
  booktitle={2020 IEEE 11th Latin American Symposium on Circuits & Systems (LASCAS)}, 
  title={Stairway to Abstraction: an Iterative Algorithm for Whisker Detection in Video Frames}, 
  year={2020},
  volume={},
  number={},
  pages={1-4},
  abstract={Automated whisker tracking is important for researching active touch in rodents. Earlier efforts to detect whiskers and represent them in a small set of parameters were either not accurate enough to enable tracking over time, or computationally expensive. In this article we propose an algorithm to cluster whisker centerline points, detected through a curvilinear structure algorithm, using the shape of smaller clusters to form bigger clusters of centerline points. After that, a least-squares approach is used to define each whisker by a set of four parameters. We implemented the algorithm in MATLAB in a parallelized fashion, and found that the processing time per frame is reasonable in MATLAB, and is likely to be short when ported to a lower-level language. When tested on a 33,634-frame segment, 89.2% of the whiskers could be represented in an abstract fashion by four parameters with a mean-squares fitting error of lower than 10 pixels, and visual inspection shows that crossing whiskers are detected and parameterized in an accurate way.},
  keywords={Clustering algorithms;Matlab;Merging;Detection algorithms;Shape;Mice;Visualization;Biology computing;Clustering methods;High performance computing;Image processing;MATLAB;Parallel algorithms;Parallel processing},
  doi={10.1109/LASCAS45839.2020.9068992},
  ISSN={2473-4667},
  month={Feb},}@INPROCEEDINGS{9245428,
  author={Skračić, K. and Rukavina, F. and Miličić, K. and Petrović, J. and Pale, P.},
  booktitle={2020 43rd International Convention on Information, Communication and Electronic Technology (MIPRO)}, 
  title={File Fragment Classification with Focus on OLE and OOXML classes}, 
  year={2020},
  volume={},
  number={},
  pages={1250-1253},
  abstract={Classification of file fragments is a crucial step in digital forensics and determining file types based on available data fragments. Currently explored file fragment classification methods other than forensic hand-examination rely on machine learning techniques. Those methods most commonly use features based on byte frequency distribution as inputs in artificial neural networks. In this paper, some new approaches to file fragment classification are explored. Older MS Office file format files (doc, ppt, and xls), and the new MS Office format (docx, pptx, and xlsx), which were previously shown to be difficult to differentiate between, were joined into two separate higher-level classes due to similarities in the included files' structure. Different approaches to specifically differentiating between subtypes in each of those two higher-level classes are further explored in the paper. The results suggest small increases in classification accuracy can be achieved using the proposed approach.},
  keywords={Merging;Digital forensics;Machine learning;Artificial neural networks;file fragment classification;file type detection;OLE;OOXML;artificial neural network;feedforward neural network},
  doi={10.23919/MIPRO48935.2020.9245428},
  ISSN={2623-8764},
  month={Sep.},}@INPROCEEDINGS{9247709,
  author={Chursin, A.A. and Promakhina, I.M.},
  booktitle={2020 13th International Conference "Management of large-scale system development" (MLSD)}, 
  title={The Effect of Coalition Compositions on Mortgage Lending Parameters}, 
  year={2020},
  volume={},
  number={},
  pages={1-4},
  abstract={The work continues researches on self-financing of the coalition of borrowers. The main stages of work are stated: problem definition, examples of possible strategy, and computing experiments. A coalition of borrowers is being considered, which in its organizational structure looks like a traditional bank. We formulate a discrete-time model, and the corresponding control problem boils down to solving a bilevel optimization problem. The choice of optimal deposit and loan rates is proposed using the parameter space investigation method. The result of a computational experiment is given.},
  keywords={Loans and mortgages;Computational modeling;Merging;Conference management;Aerospace electronics;Large-scale systems;Optimization;a coalition of borrowers;self-financing;dynamics;turn;queue balance;computational experiment},
  doi={10.1109/MLSD49919.2020.9247709},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10858893,
  author={Sun, Yunge and Du, Gaolei and Qu, Junpeng and Fu, Yong},
  booktitle={2024 IEEE 9th International Conference on Data Science in Cyberspace (DSC)}, 
  title={An Encryption Algorithm Cycle Identification Method Based on Bit Execution}, 
  year={2024},
  volume={},
  number={},
  pages={7-12},
  abstract={Ransomware uses symmetric encryption algorithms to lock user files to extort money. This paper proposes a cryptographic algorithm loop identification method based on bit-precise execution, aiming to solve the problem of identifying unknown loops. The structure of the loop body of encryption algorithms is fixed and usually includes nonlinear operations and linear operations. This article converts the loop body in the unknown software into a set of Boolean formulas, and converts the malware into a register data flow through the symbolic executor, thereby converting it into a set of Boolean formulas for execution. Execute known encryption algorithms with bit accuracy and establish a Boolean formula input-output relationship library for cryptographic components. The two sets of Boolean formulas are passed through a designed input matrix to achieve the Boolean formula mapping and input variable mapping of the confirmation algorithm, which can effectively judge the encryption algorithms in some malware.},
  keywords={Deformation;Input variables;Software algorithms;Merging;Data science;Libraries;Encryption;Registers;Ransomware;Matrix converters;symmetric encryption algorithm;malware;nonlinear cryptographic component;algorithm loop body;boolean formula},
  doi={10.1109/DSC63484.2024.00009},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11219896,
  author={Shivakumara, Shreyas and Eilertsen, Gabriel and Palmerius, Karljohan Lundin},
  booktitle={2025 17th International Conference on Quality of Multimedia Experience (QoMEX)}, 
  title={Exploring Metric Fusion for Evaluation of NeRFs}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Neural Radiance Fields (NeRFs) have demonstrated significant potential in synthesizing novel viewpoints. Evaluating the NeRF-generated outputs, however, remains a challenge due to the unique artifacts they exhibit, and no individual metric performs well across all datasets. We hypothesize that combining two successful metrics, Deep Image Structure and Texture Similarity (DISTS) and Video Multi-Method Assessment Fusion (VMAF), based on different perceptual methods, can overcome the limitations of individual metrics and achieve improved correlation with subjective quality scores. We experiment with two normalization strategies for the individual metrics and two fusion strategies to evaluate their impact on the resulting correlation with the subjective scores. The proposed pipeline is tested on two distinct datasets, Synthetic and Outdoor, and its performance is evaluated across three different configurations. We present a detailed analysis comparing the correlation coefficients of fusion methods and individual scores with subjective scores to demonstrate the robustness and generalizability of the fusion metrics.},
  keywords={Measurement;Correlation;Pipelines;Neural networks;Merging;Neural radiance field;Reliability engineering;Robustness;Quality assessment;Videos;Neural Radiance Field;VMAF;DISTS;Perceptual Quality Assessment;Metric Fusion},
  doi={10.1109/QoMEX65720.2025.11219896},
  ISSN={2472-7814},
  month={Sep.},}@INPROCEEDINGS{8749677,
  author={Lu, Yao and Xiong, Hao and Wu, Qiang and Zhang, Deng and Zhang, Qi and Wang, Ride and Zhao, Wenjuan and Xu, Jingjun},
  booktitle={2019 Conference on Lasers and Electro-Optics (CLEO)}, 
  title={Repair of pseudo time-reversal broken by topological phase transition in a photonic crystal slab}, 
  year={2019},
  volume={},
  number={},
  pages={1-2},
  abstract={We demonstrated a repair of pseudo time-reversal broken by topological phase transition in a photonic crystal slab. By changing the spatial structures, the unidirectional topological edge states transit to bidirectional trivial ones. © 2019 The Author(s)},
  keywords={Lattices;Photonics;Merging;Photonic crystals;Slabs;Physics;Standards},
  doi={10.1364/CLEO_AT.2019.JTh2A.30},
  ISSN={2160-8989},
  month={May},}@INPROCEEDINGS{11210646,
  author={Sun, Zhichao and Lv, Xiaojing and Yang, Yang},
  booktitle={2025 IEEE 13th Asia-Pacific Conference on Antennas and Propagation (APCAP)}, 
  title={Compact Metal-Dielectric Co-Printed Millimeter-Wave Dual-Polarized Phased Array Antenna}, 
  year={2025},
  volume={},
  number={},
  pages={30-31},
  abstract={A compact dual-polarized phased array antenna based on metal-dielectric co-printing technology is proposed in this paper. Each antenna element comprises a conventional dielectric-substrate feeding layer topped by a pyramid-shaped metal-dielectric co-printed radiation layer. The radiation part consists of four obliquely elliptically-shaped patches, coupled by two L-shaped probes. Compared with the traditional PCB processes with horizontal patches, this design shrinks the element volume and delivers a significantly larger scan angle. With a $0.42 \lambda_{0}$ element spacing, the 1D phased array achieves a wide $\pm 60^{\circ}$ scanning angle with only 3 dB scan loss. Its exceptional scan performance and compact structure make it a promising candidate for millimeter-wave (mm-wave) communication and sensing applications.},
  keywords={Phased arrays;Millimeter wave technology;Merging;Layout;Antenna feeds;Sensors;Millimeter wave communication;Probes;Next generation networking},
  doi={10.1109/APCAP65837.2025.11210646},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10864009,
  author={Huang, Qinghan and Nie, Lei and Qi, Dandan and Ai, Qiuming},
  booktitle={2024 5th International Conference on Artificial Intelligence and Computer Engineering (ICAICE)}, 
  title={An Optimization Method for Traffic Signals Oriented Towards Multi-Priority Vehicles}, 
  year={2024},
  volume={},
  number={},
  pages={119-123},
  abstract={The traditional traffic signal control system usually relies on fixed or dynamic preset time period regulation schemes, which has a limited response to the real-time changes in traffic flow and the demand of different vehicle priorities. Existing control strategies are difficult to ensure the fast passage of high-priority vehicles while providing sufficient passage guarantees for normal vehicles. In this paper, we propose a deep reinforcement learning traffic signal control method for multi-priority vehicles. Firstly, we improve the DQN by using the dueling structure. Secondly, we assign different weights to different priority vehicles and redesign the agent's state information and reward function. In simulation experiments, we compare four similar traffic signal control methods, and the experimental results prove the effectiveness of our proposed method.},
  keywords={Costs;Computational modeling;Roads;Merging;Optimization methods;Deep reinforcement learning;Control systems;Regulation;Real-time systems;Vehicle dynamics;traffic signal control;reinforcement learning;priority vehicle;Double Dueling DQN},
  doi={10.1109/ICAICE63571.2024.10864009},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9028379,
  author={Rosiene, Joel A. and Rosiene, Carolyn Pe},
  booktitle={2019 IEEE Frontiers in Education Conference (FIE)}, 
  title={Design Patterns for Sorting Algorithms}, 
  year={2019},
  volume={},
  number={},
  pages={1-4},
  abstract={This Innovative Practice Work-in-Progress Paper presents an alternative approach to teach algorithms using design patterns. The traditional approach to teaching different algorithms is to introduce each algorithm as a stand-alone approach. For example, when one goes over different sorting algorithms, one may start with logically simpler sorts like bubble sort or selection sort, and progress to the more challenging algorithms like heap sort or merge sort. We argue that there is another way to introduce a family of algorithms - identify the design patterns common to a group of algorithms, introduce the patterns first, before differentiating one approach from another. In this way, we focus on overall constructs and operations required, rather than how to complete each one of the sorts separately.This approach allows for an abstract class, such as Sort, to be first identified from a top-down approach, followed by the introduction and identification of which design patterns an actual algorithm falls - say divide-and-conquer for merge sort. The advantage of the approach is to allow the student to explore new realizations of solutions to problems developed from the abstract class, rather than studying a specific implementation of an algorithm.},
  keywords={Sorting;Monte Carlo methods;Data structures;Education;Programming;Rivers;Object-oriented design;Design patterns;Algorithms},
  doi={10.1109/FIE43999.2019.9028379},
  ISSN={2377-634X},
  month={Oct},}@ARTICLE{10777920,
  author={Lin, Jhe-En and Liu, Shen-Iuan},
  journal={IEEE Transactions on Very Large Scale Integration (VLSI) Systems}, 
  title={A 0.875–0.95-pJ/b 40-Gb/s PAM-3 Baud-Rate Receiver With One-Tap DFE}, 
  year={2025},
  volume={33},
  number={1},
  pages={168-178},
  abstract={This article presents a 40-Gb/s (25.6-GBaud) three-level pulse amplitude modulation (PAM-3) baud-rate receiver with one-tap decision-feedback equalize (DFE). A baud-rate phase detector (BRPD) that locks at the point with zero first postcursor is proposed. In addition, by reusing the BRPD’s error samplers, a weighting coefficient calibration is presented to select the DFE weighting coefficient that maximizes the top level of the eye diagram, thereby improving eye height across different channel losses. An inductorless continuous-time linear equalizer (CTLE) and a variable gain amplifier (VGA) are also included. The VGA adjusts the output common-mode resistance to control data swing, reducing power consumption when the required swing is small. Furthermore, by using the modified summer-merged slicers, the capacitance from the slicers to the VGA is reduced. Finally, a digital clock/data recovery (CDR) circuit is presented, which includes a demultiplexer (DeMUX) with a short delay time to reduce the loop latency. The 40-Gb/s PAM-3 receiver is fabricated in 28-nm CMOS technology. For a 25.6-Gbaud pseudorandom ternary sequence of  $3^{7}$ –1, the measured bit error rate (BER) is below  $10^{-12}$  for channel losses of 9 and 17.5 dB. At a 9-dB loss, total power consumption is 35-mW with a calculated FoM of 0.875-pJ/bit. At 17.5-dB loss, total power consumption is 38-mW with a calculated FoM of 0.95-pJ/bit.},
  keywords={Decision feedback equalizers;DH-HEMTs;Receivers;Calibration;Bit error rate;Power demand;Signal to noise ratio;Logic;Detectors;Indexes;Baud-rate;continuous time linear equalizer;decision feedback equalizer (DFE);phase detector;pseudorandom ternary sequence;three-level pulse amplitude modulation (PAM)},
  doi={10.1109/TVLSI.2024.3507714},
  ISSN={1557-9999},
  month={Jan},}@ARTICLE{11268448,
  author={Liu, Yuning and Ma, Yongtao and Li, Weiming and Guo, Shiliang},
  journal={IEEE Geoscience and Remote Sensing Letters}, 
  title={CSMNet: Channel-Spatial Mamba UNet for Continuous Remote Sensing Image Super Resolution}, 
  year={2026},
  volume={23},
  number={},
  pages={1-5},
  abstract={Remote sensing image (RSI) super resolution (SR) is crucial for enhancing geospatial recognition accuracy, yet the existing methods based on deep learning (DL) present significant bottlenecks, such as low computational efficiency, insufficient preservation for local details, and global semantics. To address these challenges, we propose a novel CSMNet framework, which pioneers the integration of Mamba and implicit neural representation (INR) within UNet. We model long range dependencies of spatial and channel information based on the visual state space (VSS) model. In order to promote multiscale feature interaction and preservation, we propose a fusion strategy to merge the upsampled features from bottom to top. Experiments on UCMerced and AID datasets demonstrate that our method averagely achieves prominent PSNR(dB)/SSIM values of 30.81/0.8535 and 33.30/0.8666 and 40.2% inference speed increasement than recent continuous SR methods.},
  keywords={Decoding;Superresolution;Visualization;Sensors;LoRa;Convolution;Computational modeling;Codes;Remote sensing;Logic gates;Implicit neural representation (INR);remote sensing images (RSIs);super resolution (SR);visual state space (VSS)},
  doi={10.1109/LGRS.2025.3637136},
  ISSN={1558-0571},
  month={},}@INPROCEEDINGS{9833721,
  author={Bose, Priyanka and Das, Dipanjan and Chen, Yanju and Feng, Yu and Kruegel, Christopher and Vigna, Giovanni},
  booktitle={2022 IEEE Symposium on Security and Privacy (SP)}, 
  title={SAILFISH: Vetting Smart Contract State-Inconsistency Bugs in Seconds}, 
  year={2022},
  volume={},
  number={},
  pages={161-178},
  abstract={This paper presents SAILFISH, a scalable system for automatically finding state-inconsistency bugs in smart contracts. To make the analysis tractable, we introduce a hybrid approach that includes (i) a light-weight exploration phase that dramatically reduces the number of instructions to analyze, and (ii) a precise refinement phase based on symbolic evaluation guided by our novel value-summary analysis, which generates extra constraints to over-approximate the side effects of whole-program execution, thereby ensuring the precision of the symbolic evaluation. We developed a prototype of SAILFISH and evaluated its ability to detect two state-inconsistency flaws, viz., reentrancy and transaction order dependence (TOD) in Ethereum smart contracts. Our experiments demonstrate the efficiency of our hybrid approach as well as the benefit of the value summary analysis. In particular, we show that SAILFISH outperforms five state-of the-art smart contract analyzers (SECURIFY, MYTHRIL, OYENTE, SEREUM and VANDAL) in terms of performance, and precision. In total, SAILFISH discovered 47 previously unknown vulnerable smart contracts out of 89,853 smart contracts from ETHERSCAN.},
  keywords={Data privacy;Smart contracts;Computer bugs;Prototypes;Hybrid power systems;Security;smart-contract;symbolic-execution;blockchain},
  doi={10.1109/SP46214.2022.9833721},
  ISSN={2375-1207},
  month={May},}@ARTICLE{9534710,
  author={Jing, Xuyang and Yan, Zheng and Han, Hui and Pedrycz, Witold},
  journal={IEEE Transactions on Dependable and Secure Computing}, 
  title={ExtendedSketch: Fusing Network Traffic for Super Host Identification With a Memory Efficient Sketch}, 
  year={2022},
  volume={19},
  number={6},
  pages={3913-3924},
  abstract={Super host refers to the host that has a high cardinality or exhibits a big change in a network. Facing big-volume network traffic, sketches have been widely applied to identify super hosts in an efficient and accurate way. However, most sketches cannot flexibly balance memory usage and accuracy in host cardinality estimation. Setting an inappropriate counter size for a sketch could either lead to inaccurate host cardinality estimation or cause memory waste. In order to solve this issue, we propose a novel extensible and reversible sketch, named ExtendedSketch, to achieve accurate super host identification with high memory efficiency. The core idea of ExtendedSketch is to monitor low-cardinality hosts with small-sized counters while dynamically extending the size of counters when monitoring high-cardinality hosts by applying an adaptive extension strategy. Such the strategy can adaptively increase counter size according to network traffic status at runtime, which not only ensures the accuracy of high-cardinality host estimation but also avoids unnecessary memory consumption. We perform theoretical analysis and conduct a series of experimental evaluations on ExtendedSketch based on real world network traffic. Experimental results show that under same memory usage, compared to the state-of-the-art, ExtendedSketch achieves $1.4{ \sim }7.5$1.4∼7.5 times smaller error rate in estimating host cardinality with $1.9{ \sim }26.7$1.9∼26.7 times better accuracy on super host identification and $95 {\sim }2^{15}$95∼215 times faster speed on abnormal address reconstruction. Its advance in accuracy and efficiency demonstrates the practical significance of ExtendedSketch for super host identification.},
