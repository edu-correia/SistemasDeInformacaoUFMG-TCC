  booktitle={2022 1st International Conference on Computational Science and Technology (ICCST)}, 
  title={Intra Zoo Expedition with AR}, 
  year={2022},
  volume={},
  number={},
  pages={808-812},
  abstract={The zoo is an area with a tremendous region and various spots to explore. The goal of the organizer is to make the path inside a zoo more functional as a venue for community events. In this suggestion, we offer a strategy for an intra-zoo excursion based on GIS applications. The Google Maps API can be used to develop the 2D satellite navigation systems. With the help of ARcore, a Google SDK that enables the creation of augmented reality applications, the virtual and physical worlds can be merged. Using the Marker Based AR capabilities of expanded reality, the locations inside the zoo may be planned. We'll use Android studio development to build a smooth and accurate route framework for our application. By doing this, visual media content is produced, and the client's comprehension of how to relate to that information in the real world is improved.},
  keywords={Location awareness;Visualization;Social networking (online);Scientific computing;Pandemics;Media;Satellite navigation systems;Augmented reality;outdoor navigation;marker based AR;android augmented reality;AR Core;Gmap API;Geospatial localization},
  doi={10.1109/ICCST55948.2022.10040327},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10675673,
  author={Rani, Shreenagamanjula and B V, Santhosh Krishna and S, Tejaswini and A, Uma Maheshwari and A, Triveni},
  booktitle={2024 Second International Conference on Inventive Computing and Informatics (ICICI)}, 
  title={Securing Information Transfer with Hybrid Cryptography via Cloud}, 
  year={2024},
  volume={},
  number={},
  pages={715-719},
  abstract={Security of data is the foremost concern within cloud environments, given the prevalent trend among organizations to store their data there. This study concentrates on hybrid encryption methods, analyzing their implementation and effectiveness in cloud environments with a focus on performance enhancement, algorithm speed, efficacy evaluation, and comparison with existing methods. The research introduces a new hybrid algorithm that merges symmetric (Twofish) and asymmetric (RSA) cryptographic techniques. The study demonstrates the heightened security potential of the proposed Twofish+RSA hybrid algorithm. Additionally, it contrasts this with the AES+RSA approach, aiming to provide a balanced and secure data protection solution across different applications. Notably, the Twofish+RSA hybrid method excels in computation time, ciphertext size, and memory usage. The proposal of a multilayered cryptography-based security solution is driven by the increasing emphasis on cloud computing security in research. Security concerns are pervasive in today's technology-driven landscape, particularly in the realm of cloud computing, where vulnerabilities can be exploited by attackers. The transition from local to cloud storage further exacerbates these security challenges.},
  keywords={Computational modeling;Cloud computing security;Standards organizations;Random access memory;Data protection;Organizations;Market research;Twofish;RSA (Rivest;Shamir;and Adleman);AES (Advanced Encryption Standard);Cloud Computing;Hybrid Encryption;Comparison of Cryptosystems},
  doi={10.1109/ICICI62254.2024.00121},
  ISSN={},
  month={June},}@BOOK{10251331,
  author={Molak, Aleksander and Jaokar, Ajit},
  booktitle={Causal Inference and Discovery in Python: Unlock the secrets of modern causal machine learning with DoWhy, EconML, PyTorch and more},
  year={2023},
  volume={},
  number={},
  pages={},
  abstract={Demystify causal inference and casual discovery by uncovering causal principles and merging them with powerful machine learning algorithms for observational and experimental data Purchase of the print or Kindle book includes a free PDF eBookKey FeaturesExamine Pearlian causal concepts such as structural causal models, interventions, counterfactuals, and moreDiscover modern causal inference techniques for average and heterogenous treatment effect estimationExplore and leverage traditional and modern causal discovery methodsBook DescriptionCausal methods present unique challenges compared to traditional machine learning and statistics. Learning causality can be challenging, but it offers distinct advantages that elude a purely statistical mindset. Causal Inference and Discovery in Python helps you unlock the potential of causality. You’ll start with basic motivations behind causal thinking and a comprehensive introduction to Pearlian causal concepts, such as structural causal models, interventions, counterfactuals, and more. Each concept is accompanied by a theoretical explanation and a set of practical exercises with Python code. Next, you’ll dive into the world of causal effect estimation, consistently progressing towards modern machine learning methods. Step-by-step, you’ll discover Python causal ecosystem and harness the power of cutting-edge algorithms. You’ll further explore the mechanics of how “causes leave traces” and compare the main families of causal discovery algorithms. The final chapter gives you a broad outlook into the future of causal AI where we examine challenges and opportunities and provide you with a comprehensive list of resources to learn more.What you will learnMaster the fundamental concepts of causal inferenceDecipher the mysteries of structural causal modelsUnleash the power of the 4-step causal inference process in PythonExplore advanced uplift modeling techniquesUnlock the secrets of modern causal discovery using PythonUse causal inference for social impact and community benefitWho this book is forThis book is for machine learning engineers, data scientists, and machine learning researchers looking to extend their data science toolkit and explore causal machine learning. It will also help developers familiar with causality who have worked in another technology and want to switch to Python, and data scientists with a history of working with traditional causality who want to learn causal machine learning. It’s also a must-read for tech-savvy entrepreneurs looking to build a competitive edge for their products and go beyond the limitations of traditional machine learning.},
  keywords={},
  doi={},
  ISSN={},
  publisher={Packt Publishing},
  isbn={9781804611739},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10251331},}@INPROCEEDINGS{11390440,
  author={Jayaram, Ammisetti and Jasmine, Shaik Hamsha and Archana, Gunakala and Satyasai, Brundavanam},
  booktitle={2025 International Conference on Intelligent Computing, Information and Control Systems (ICOIICS)}, 
  title={Early Detection of Diabetic Retinopathy Using a Hybrid SIFT–CNN Framework on Multimodal Datasets}, 
  year={2025},
  volume={},
  number={},
  pages={1503-1509},
  abstract={Diabetic Retinopathy is a severe microvascular complication of diabetes and a leading cause of preventable blindness worldwide. Early detection and accurate grading of DR are critical for timely intervention and treatment. In this approach, a deep learning-based approach for automated DR classification using a merged dataset created by combining two publicly available sources: the Diabetic Retinopathy 224×224 Gaussian Filtered dataset and the Messidor-2 dataset. The integration of these datasets significantly increased the volume and diversity of retinal fundus images, encompassing variations in image quality, illumination, and patient demographics, thereby enhancing the model's generalization capability. The merged dataset was pre-processed through contrast enhancement, resizing, and noise reduction to standardize image quality. Data augmentation techniques were employed to address class imbalance and improve robustness. A image feature extraction method SIFT is used to extract the features and then applied to the model. A convolutional neural network (CNN) architecture was implemented and fine-tuned to classify diabetic retinopathy into five severity grades, ranging from No DR to Proliferative DR. Experimental results demonstrated that training on the combined dataset improved accuracy, sensitivity, and specificity compared to models trained on individual datasets. The proposed approach highlights the effectiveness of dataset merging in improving DR detection performance and suggests its potential for deployment in realworld screening systems to aid ophthalmologists in large-scale diabetic eye care programs.},
  keywords={Image quality;Deep learning;Diabetic retinopathy;Accuracy;Lighting;Computer architecture;Transforms;Feature extraction;Retina;Convolutional neural networks;Diabetic Retinopathy;Deep Learning;Merged Dataset;Diabetic Retinopathy 224*224 Gaussian Filtered;Messidor-2;CNN;Image Classification;Fundus Images},
  doi={10.1109/ICOIICS67115.2025.11390440},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9270334,
  author={Lee, Seongmin},
  booktitle={2020 IEEE/ACM 42nd International Conference on Software Engineering: Companion Proceedings (ICSE-Companion)}, 
  title={Scalable and Approximate Program Dependence Analysis}, 
  year={2020},
  volume={},
  number={},
  pages={162-165},
  abstract={Program dependence is a fundamental concept to many software engineering tasks, yet the traditional dependence analysis struggles to cope with common modern development practices such as multilingual implementations and use of third-party libraries. While Observation-based Slicing (ORBS) solves these issues and produces an accurate slice, it has a scalability problem due to the need to build and execute the target program multiple times. We would like to propose a radical change of perspective: a useful dependence analysis needs to be scalable even if it approximates the dependency. Our goal is a scalable approximate program dependence analysis via estimating the likelihood of dependence. We claim that 1) using external information such as lexical analysis or a development history, 2) learning dependence model from partial observations, and 3) merging static, and observation-based approach would assist the proposition. We expect that our technique would introduce a new perspective of program dependence analysis into the likelihood of dependence. It would also broaden the capability of the dependence analysis towards large and complex software.},
  keywords={Software engineering;Software;Analytical models;Task analysis;Conferences;Static analysis;History;Program Analysis;ORBS;Program Slicing},
  doi={},
  ISSN={2574-1926},
  month={Oct},}@INPROCEEDINGS{11233597,
  author={Dholvan, Mohan and Mantha, Shailaja and Shanmukh, Sunku Giridhar and Bhuvanagiri, Bharath Chandra and Balaji, Abhishek},
  booktitle={2025 11th International Conference on Smart Computing and Communications (ICSCC)}, 
  title={Fake Product and Fake Review Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper aims to develop a corroborative or synergisticsolutionthat combines product verification and reviewing authenticating techniques to address the everchanging issues in counterfeit products.The application’s primary objective is to analyse product reviews and provide a numerical score to aid the product’s overall score after verifying its supply chain and identity. The First step uses the BiSLTM model to analyze the pre-processed reviews based on linguistic and statistical patterns. It also considers purchase verification, review length and versatility in authentication. After which these results are tabulated and marked with a numerical score. The second step involves using CNN and blockchain approaches to verify product identity and supply chain history. The products are verified by analysing past purchases, retailer history, and Imaging. They are then optimised by adjusting their dynamic learning rate. The preceding results are then collaborated/merged to provide an accurate and precise value to a given product or review data set.It includes multimodal authentication, mapping review frequency, and implementing an efficient and scalable mechanism for detecting Dubious practices in online marketplaces. The application ensures high accuracy and precision in identifying fraudulent elements, while also verifying real-time IDs.},
  keywords={Deep learning;Analytical models;Reviews;Supply chains;Bidirectional long short term memory;Authentication;Linguistics;Blockchains;Numerical models;History;deep learning;BiLSTM;blockchain;CNN Technology;authentication;supply chain;Product and review},
  doi={10.1109/ICSCC66177.2025.11233597},
  ISSN={},
  month={July},}@INPROCEEDINGS{10974851,
  author={Coran, Giacomo and Costantini, Massimo and Gelsumini, Sara and Busonero, Deborah and Knapic, Cristina and Adelfio, Andrea and Ciangottini, Diego},
  booktitle={2025 33rd Euromicro International Conference on Parallel, Distributed, and Network-Based Processing (PDP)}, 
  title={Spoke 3 Big Data Management, Storage, and Archive Infrastructure}, 
  year={2025},
  volume={},
  number={},
  pages={464-470},
  abstract={The project aims to develop innovative data management solutions (database and file system archive) for the Spoke 3 division of the Italian National Center for HPC, Big Data, and Quantum Computing, rigorously applying the FAIR principles and Open Science methodologies. This system provides a robust and scalable framework designed to address big data challenges in astrophysics, which requires customized data models and management solutions. It focuses on managing observations from the Gaia and Fermi space missions, as well as simulations generated using the Pluto and Ramses codes, with the goal of supporting requests from the astrophysical Italian community on particular scientific cases.For Gaia data, we identified the HDF5 as a suitable format to improve data access and analysis outside the data reduction pipelines. The HDF5 format allows the nesting of primitive fields, arrays, and complex objects, thereby enhancing accessibility and computational efficiency. For the data management of the FT1 and FT2 data products from the Fermi Observatory, a common data model has been chosen to provide a unique point of access to the scientific data, employing logic for database queries and offering access to data products over a long observing period. Finally, to facilitate user interaction, a custom web application has been developed, providing a user-friendly interface for accessing and querying the archived metadata, additional “Cut & Merge” and “Transits” services, and supporting also secure authentication methods to ensure data privacy and compliance. These comprehensive resources enhance data accessibility and usability through the Spoke3 Archive Infrastructure, empowering the scientific community to explore and analyze astronomical data more effectively.},
  keywords={Quantum computing;Observatories;Databases;Space missions;Pipelines;Restful API;Big Data;Metadata;Usability;Pluto;big data;data storage systems;archives;information management;management system;database technology;interoperability;astrophysical data;data models;databases},
  doi={10.1109/PDP66500.2025.00072},
  ISSN={2377-5750},
  month={March},}@INPROCEEDINGS{11431514,
  author={Rupok, Md. Humayan Kabir and Hasan, Rakibul and Islam, Md. Masudul and Islam, Md. Shafiqul},
  booktitle={2026 28th International Conference on Advanced Communications Technology (ICACT)}, 
  title={Ecosupplychain: a Blockchain-Enabled Dual-Flow Framework for Counterfeit Prevention, Profit Transparency, and Sustainable Recycling}, 
  year={2026},
  volume={},
  number={},
  pages={199-204},
  abstract={Modern supply chains promise efficiency and global connectivity, yet continue to face persistent challenges such as counterfeit infiltration, opaque profit distribution, and the lack of sustainable recycling mechanisms. To address these issues, this paper presents EcoSupplyChain, a unified blockchain-based framework that integrates forward (production to consumer) and reverse (recycling) logistics into a transparent and tamperresistant ecosystem. The system involves five primary actors: government authority, factory, supplier, store, and buyer, operating on the Ethereum blockchain through smart contracts for automated verification and reward distribution. The framework tackles three major challenges: (1) product authenticity verification using cryptographic signatures and QR-based traceability, (2) transparent profit margin validation without compromising commercial confidentiality, and (3) incentivized recycling through cryptocurrency rewards and tax waivers for manufacturers. The forward chain ensures immutable tracking and profit verification across all supply stages, while the reverse chain promotes recycling participation and material recovery. By merging financial fairness, counterfeit prevention, and sustainability within a single decentralized architecture, EcoSupplyChain establishes a scalable model for secure, transparent, and environmentally responsible supply chain management.},
  keywords={Supply chain management;Prevention and mitigation;Supply chains;Smart contracts;Government;Ecosystems;Finance;Recycling;Blockchains;Sustainable development;Blockchain;Counterfeit Detection;Profit Monitoring;Recycling Incentives;Smart Contracts;Product Traceability;Sustainable Supply Chain},
  doi={10.23919/ICACT68090.2026.11431514},
  ISSN={1738-9445},
  month={Feb},}@INPROCEEDINGS{11145984,
  author={Jing, Ziqian and Liang, Yutong and Hou, Wenyan},
  booktitle={2024 International Conference on Internet of Things, Robotics and Distributed Computing (ICIRDC)}, 
  title={Research on Pricing and Restocking Strategies Based on Hierarchical Clustering and ARIMA Model}, 
  year={2024},
  volume={},
  number={},
  pages={1023-1026},
  abstract={This study aims to explore pricing and restocking strategies based on hierarchical clustering and ARIMA modeling. After conducting in-depth analysis of supermarket vegetable sales data, we initially preprocessed the data, including data merging, categorization, and calculation of sales volumes. Utilizing hierarchical clustering analysis, we categorized products into three groups, revealing the correlation between the sales volumes of different products. Correlation analysis indicated that there is no significant correlation between vegetable sales volumes, suggesting insensitivity to price. We further applied the ARIMA model for time series forecasting of vegetable sales volumes to predict the upper limits of sales for the upcoming week. The parameters of the ARIMA model were determined through auto-correlation and partial auto-correlation analysis, and the model's effectiveness was validated through model fitting and residual white noise testing.},
  keywords={Analytical models;Adaptation models;Correlation;Accuracy;Computational modeling;Pricing;Predictive models;White noise;Data models;Optimization;Hierarchical clustering;ARIMA modeling;Pricing strategy;Restocking optimization;Vegetable sales},
  doi={10.1109/ICIRDC65564.2024.00187},
  ISSN={},
  month={Dec},}@ARTICLE{8627371,
  author={Liu, Yu and Chen, Xun and Ward, Rabab K. and Wang, Z. Jane},
  journal={IEEE Signal Processing Letters}, 
  title={Medical Image Fusion via Convolutional Sparsity Based Morphological Component Analysis}, 
  year={2019},
  volume={26},
  number={3},
  pages={485-489},
  abstract={In this letter, a sparse representation (SR) model named convolutional sparsity based morphological component analysis (CS-MCA) is introduced for pixel-level medical image fusion. Unlike the standard SR model, which is based on single image component and overlapping patches, the CS-MCA model can simultaneously achieve multi-component and global SRs of source images, by integrating MCA and convolutional sparse representation (CSR) into a unified optimization framework. For each source image, in the proposed fusion method, the CSRs of its cartoon and texture components are first obtained by the CS-MCA model using pre-learned dictionaries. Then, for each image component, the sparse coefficients of all the source images are merged and the fused component is accordingly reconstructed using the corresponding dictionary. Finally, the fused image is calculated as the superposition of the fused cartoon and texture components. Experimental results demonstrate that the proposed method can outperform some benchmarking and state-of-the-art SR-based fusion methods in terms of both visual perception and objective assessment.},
  keywords={Image fusion;Biomedical imaging;Standards;Convolution;Image coding;Signal processing algorithms;Dictionaries;Medical image fusion;sparse representation (SR);morphological component analysis (MCA);convolutional sparse representation (CSR);dictionary learning},
  doi={10.1109/LSP.2019.2895749},
  ISSN={1558-2361},
  month={March},}@ARTICLE{10081217,
  author={Godinho, Daniel Almeida and Alves Neto, Armando and Mozelli, Leonardo Amaral and de Oliveira Souza, Fernando},
  journal={IEEE Transactions on Intelligent Transportation Systems}, 
  title={A Strategy for Traffic Safety of Vehicular Platoons Under Connection Loss and Time-Delay}, 
  year={2023},
  volume={24},
  number={6},
  pages={6627-6638},
  abstract={Autonomous platoons are good alternatives for cargo transportation, with many approaches to safety and efficiency issues. In the last decades, much effort has been employed in this context, with solutions ranging from low-level control laws to learning strategies. Although some papers have concentrated on methods robust to disturbances or resilient to disruptions, most of the current literature assumes that the platoon starts and remains connected all the time, even when subjecting vehicles to limited communication ranges and time-delay. Therefore, in this paper, we address the problem of connectivity maintenance and stability of platoons under the complete disconnection of vehicles. The main goal is to increase the tolerance to agent exits, external elements (such as traffic lights and human-driven vehicles), and non-ideal initial conditions, improving traffic safety in mixed traffic scenarios. By modeling the network connection as a Directed Acyclic Graph, we use a state-machine policy to recover connectivity and regulate the spacing distance to other vehicles under heterogeneous time-delays. We demonstrate that this state alteration can be interpreted as a reference tracking problem and propose a design procedure that provides stability and zero spacing error in steady-state. Our control protocol allows vehicles to reach a consensus with the team, even when they start disconnected from other ones. Results with agent-based and nonlinear simulations illustrate the effectiveness of our approach.},
  keywords={Protocols;Resilience;Topology;Delays;Stability criteria;Safety;Robustness;Autonomous vehicular platoon;self-healing systems;robotic resilience;connection loss},
  doi={10.1109/TITS.2023.3258633},
  ISSN={1558-0016},
  month={June},}@INPROCEEDINGS{10183582,
  author={Kumar, Ankit and Pandey, Saroj Kumar and Prakash, Sunny and Singh, Kamred Udham and Singh, Teekam and Kumar, Gaurav},
  booktitle={2023 International Conference on Computational Intelligence and Sustainable Engineering Solutions (CISES)}, 
  title={Enhancing Web Application Efficiency: Exploring Modern Design Patterns within the MVC Framework}, 
  year={2023},
  volume={},
  number={},
  pages={43-48},
  abstract={The growing demand for web applications across various sectors has led to challenges in developing efficient and high-performance online apps. The traditional approach to web app development may struggle to meet the performance requirements of modern online applications. To address this, the Model-View-Controller (MVC) framework has become an essential tool for creating interactive online apps. While the MVC framework has limitations, several new design patterns have emerged from its architecture that offers improvements. This paper explores some of the thoroughly researched design patterns of the MVC framework. The Composite View pattern merges several views to facilitate the development of complex user interfaces, while the Intercepting Filter design pattern filters and processes requests before they reach the controller, enhancing security and speed. The Service Layer design pattern creates an abstraction layer between the data access layer and the controller to increase scalability and maintainability. Employing MVC-based design patterns can help developers enhance the functionality and efficiency of web apps, ensuring they meet the expectations of modern consumers.},
  keywords={Codes;Databases;Scalability;Process control;Debugging;User interfaces;Information filters;Framework;Web Development;MVC;Spring;Design Pattern;Architectural Pattern;Model;View;Controller},
  doi={10.1109/CISES58720.2023.10183582},
  ISSN={},
  month={April},}@ARTICLE{9816104,
  author={Alahmadi, Mohammad D.},
  journal={IEEE Transactions on Software Engineering}, 
  title={VID2XML: Automatic Extraction of a Complete XML Data From Mobile Programming Screencasts}, 
  year={2023},
  volume={49},
  number={4},
  pages={1726-1740},
  abstract={Developers often refer to video-hosting online platforms to find screencasts that provide a step-by-step guide to help them solve a programming task at hand or learn a new concept. More specifically, developers search for resources that help them design and implement effective mobile graphical user interfaces (GUI) using XML. Although mobile programming screencasts contain a vast amount of XML data at developers’ disposal, they cannot be easily found and copied-pasted due to the image nature of videos. Given that the most common task developers perform online is copy-pasting, mobile programming screencasts must support that and be complemented with XML data in a textual format. To overcome this challenge and aid developers, this paper presents vid2XML, which is a three-phase approach that leverages both visual and textual information of video frames to locate XML region in video frames, locate the currently opened file, and extract XML data for each file presented in video frames. We evaluated each phase of vid2XML in a comprehensive empirical evaluation on videos collected from YouTube. The results reveal that vid2XML is able to accurately (i) locate XML regions, outperforming four previous work, (ii) locate the bounding box of the selected file, and (iii) extract, fix, and merge XML data for each file opened/created in a video.},
  keywords={Videos;XML;Data mining;Programming;Codes;Feature extraction;Optical character recognition software;Programming screencasts;computer vision;Android programming;programming video tutorials;video mining},
  doi={10.1109/TSE.2022.3188898},
  ISSN={1939-3520},
  month={April},}@INPROCEEDINGS{10185352,
  author={Kang, Gyuseong and Shin, Hyunjin and Jung, Hyuntaek and Lee, Sunkyu and Choi, Jaeseung and Baek, Sangyeop and Jung, Hyunsung and Kim, Daeshik and Hwang, Sohee and Han, Shinhee and Ji, Yongsung and Yoon, Sei Seung},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 14nm 128Mb Embedded MRAM Macro achieved the Best Figure-Of-Merit with 80MHz Read operation and 18.1Mb/mm² implementation at 0.64V}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={This paper describes an embedded spin transfer torque magnetic random access memory (STT-MRAM) focusing on minimizing macro area. By exploiting bit write operating condition, a merged source follower write driver (MSWD) is proposed to reduce write driver size and minimize write voltage mismatch. With a boosted pass-gate column mux (BPCM), additional local inverter for switching logic is eliminated. The proposed gated WL driver (GWLD) achieves faster wordline voltage settling time without increasing its size. Cell-based read offset compensation (CROC) is employed to improve read window for high-density memory and low Vdd operation. The proposed MRAM tolerant to solder-reflow process has been fabricated in a 14nmFinFET process, and the area of 128Mb macro is 18.1Mb/mm2. The measurement results show that the proposed MRAM achieves 80MHz read access time in 0.64V core voltage at 150°C temperature.},
  keywords={Temperature measurement;Voltage measurement;Torque;Regulators;Random access memory;Switches;Very large scale integration},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185352},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{10185366,
  author={Xu, Kai and Yu, Bowen and Hu, Jun and Li, Yubin and Staszewski, Robert Bogdan and Xu, Hongtao},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A 50μW Ring-Type Complementary Inverse-Class-D Oscillator with 191.4dBc/Hz FoM and 205.6dBc/Hz FoMA}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={There are long-standing trade-offs between the ring [1, 2] and LC-tank [4–5] oscillators in terms of power consumption (PDC), area, phase noise (PN) and sensitivity to supply perturbations. A recent work to merge the two—a ring of series-LC tanks [3, 7]—has attained considerably improved PN and supply pushing insensitivity, while occupying comparable system area to the conventional inverter-based ring-oscillators (RO); however, it still burns several milliwatt with limited FoM. In this paper, we greatly reduce $\mathrm{PDC}_{\mathrm{D}}$ in LC-assisted tiny ring-type VCOs into as low as $50 \mu \mathrm{W}$, while demonstrating high FoM approaching that of LC-VCOs by means of a highly efficient complementary class-$\mathrm{D}^{-1}$ topology. To shrink consumed $\mathrm{PDC}_{\mathrm{DC}}$, transformer-based resonant tanks are employed to replace the series-LC tanks used in [3, 7], as proposed in Fig.1(b-c). They are capable of generating a 180° or 0° phase shift by configuring the transformer as inverting or non-inverting, respectively, thus reducing the number of stages required to start the oscillation to two or ultimately one (‘degenerated’ case). The normally expected start-up circuit [3] can also be averted as the dc feedback is avoided thanks to the transformer’s isolation. A $2 \times$ to $4 \times$ reduction in power can be readily expected. Furthermore, the resulting “single-stage RO” in Fig.1(c) is configured into a complementary class-$\mathrm{D}^{-1}$ switching operation, which not only obtains high energy efficiency due to non-overlapping voltage and current waveforms, but also minimizes the drain parasitic discharge power loss as the transistor’s CDS capacitance is absorbed into the parallel resonant tank.},
  keywords={Phase noise;Partial discharges;Sensitivity;Power demand;Perturbation methods;Voltage;Very large scale integration},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185366},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{9078527,
  author={Cho, Kyunghwan and Kim, Jihye and Oh, Hyunggoy and Lee, Sangjun and Kang, Sungho},
  booktitle={2019 International SoC Design Conference (ISOCC)}, 
  title={A New Scan Chain Reordering Method for Low Power Consumption based on Care Bit Density}, 
  year={2019},
  volume={},
  number={},
  pages={134-135},
  abstract={Scan-based testing, though widely used in modern digital designs, causes more power consumption than in functional mode. This excessive power consumption can cause severe hazards such as circuit reliability and yield loss. To solve this problem, a new scan chain reordering method based on care bit density is proposed in this paper. This proposed method helps merging care bits toward the front end of scan chains. Thus, it can reduce scan cell switching activities during scan shift operation. Experimental results on ISCAS’89 benchmark circuits show that the proposed scan chain reordering method reduces test power consumption compared to the previous work.},
  keywords={Power demand;Benchmark testing;Vectors;Computer architecture;Very large scale integration;Switches;Power dissipation;formatting;Scan testing;Scan cell reordering;low power test},
  doi={10.1109/ISOCC47750.2019.9078527},
  ISSN={2163-9612},
  month={Oct},}@INPROCEEDINGS{10533112,
  author={Akhtar, Samia and Aftab, Shabib and Ahmad, Munir and Ihnaini, Baha},
  booktitle={2024 2nd International Conference on Cyber Resilience (ICCR)}, 
  title={A Transfer Learning Based Framework for Diabetic Retinopathy Detection Using Data Fusion}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Diabetic retinopathy is a condition associated with diabetes that damages the blood vessels within the retina resulting in vision impairment or even blindness. Early detection and classification of DR enables timely intervention, which is crucial for preventing vision loss and blindness in diabetic patients. This research presents a framework for binary classification, employing transfer learning to identify diabetic retinopathy in individuals with diabetes. APTOS19 and IDRiD, two datasets containing fundus images, are merged together for training the transfer learning models to predict the presence or absence of the disease. Many preprocessing techniques have been applied to these images like resizing, Gaussian filtering, and dataset splitting. After the split, training set is augmented using zooming, rotation, flipping etc. to increase diversity. The transfer learning models used are: ResNet50 and DenseNet121. These models are fine tuned for classification. The results highlight that the DenseNet121 model achieved a superior test accuracy of 97.22% as compared to ResNet50.},
  keywords={Training;Diabetic retinopathy;Transfer learning;Visual impairment;Data integration;Blindness;Retina;Diabetic retinopathy;Transfer learning;Artificial intelligence;Diabetes;Fusion},
  doi={10.1109/ICCR61006.2024.10533112},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{8983638,
  author={Zou, Peng and Bai, Xiqiong and Wu, Yingjie and Wu, Lifeng and Chen, Jianli},
  booktitle={2019 IEEE 13th International Conference on ASIC (ASICON)}, 
  title={An Effective Detailed Routing Algorithm Considering Advanced VLSI Technologies}, 
  year={2019},
  volume={},
  number={},
  pages={1-4},
  abstract={Detailed routing has become more challenging in modern circuit designs due to the extreme scaling of chip size and the additional complicated design rules. In this paper, we present an effective detailed routing algorithm for advanced technology nodes with the aim to optimize the total routing wirelength. Under the constraints of blockages and pin information, we first present a shape-based connection candidates generation to generate crucial connection points, which significantly reduces searching connection points for the following detailed routing process. Then, a valid net's connection edges selection strategy is presented to choose routing direction edges, and a fast scanning line technique is applied to remove invalidate edges. Finally, considering the complex design rules in the advanced technology nodes, we introduce a Steiner minimal tree based algorithm to obtain an initial detailed routing result, and further propose a complexity-driven post-processing and refinement stage to strike out redundant points and merge adjacent edges. Experimental results on industry benchmarks show that, comparing with classical algorithms, our proposed algorithm not only achieves 100% routability on real industrial cases but also obtains shorter total wirelength.},
  keywords={Industries;Steiner trees;Benchmark testing;Very large scale integration;Routing;Pins;Manufacturing;Circuit synthesis;Detailed routing;Advanced technology nodes;Steiner tree;Routability},
  doi={10.1109/ASICON47005.2019.8983638},
  ISSN={2162-755X},
  month={Oct},}@INPROCEEDINGS{10185381,
  author={Kaiser, Karl and Patil, Dinesh and Beigne, Edith},
  booktitle={2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)}, 
  title={A prototype 5nm custom sensor SoC for Augmented Reality/Virtual Reality targeting Smartglasses with embedded computer vision, audio, security and ML}, 
  year={2023},
  volume={},
  number={},
  pages={1-2},
  abstract={Augmented and Virtual Reality (AR/VR) are disruptive technologies poised to become the next generation compute platforms. It represents a merging of the physical and the digital domains into a rich, context aware and accessible user interface delivered in real-time through a socially acceptable form factor. Innovations in the key technical areas of Power/Performance, Form Factor, and Thermal are essential to produce all-day wearable AR products. We present a research prototype sensor SoC, optimized for AR/VR and Smartglasses prototypes, aiming at reducing future product size and power. It allows substantial computational capabilities, through specialized accelerators, at very low power levels. It is architected to allow data locality and reuse, as well as power efficient data movement.},
  keywords={Technological innovation;Thermal factors;Prototypes;Virtual reality;Very large scale integration;User interfaces;Real-time systems},
  doi={10.23919/VLSITechnologyandCir57934.2023.10185381},
  ISSN={2158-9682},
  month={June},}@INPROCEEDINGS{9513214,
  author={Ai, Changsheng and Qi, Zhengguang and Zheng, Lei and Geng, Dunyang and Feng, Zhiquan and Sun, Xuan},
  booktitle={2021 4th International Conference on Advanced Electronic Materials, Computers and Software Engineering (AEMCSE)}, 
  title={Research on mapping method based on data fusion of lidar and depth camera}, 
  year={2021},
  volume={},
  number={},
  pages={360-365},
  abstract={At present, mobile robots equipped with a single sensor in an indoor environment suffer from insufficient mapping accuracy and limited scanning range. Therefore, this paper proposes a method for data fusion mapping with three sensors, single-line lidar, depth camera and IMU. First, the depth data collected by the depth camera is reduced by dimensionality processing to make it two-dimensional, and then the environmental feature data scanned in the lidar, the pseudo laser data of the depth camera, and the pose information collected and calculated by the IMU are passed through Kalman. Filtering performs data fusion, that is, compensating the position and attitude errors caused by the lidar measurement. In the mapping phase, under the open source SLAM algorithm Gmapping, the two-dimensional local raster maps generated by the lidar that fuse multi-source data and the depth camera are merged with the local map based on the Bayes rule. Experiments show that the global map obtained by this method contains richer environmental information than a single sensor, which improves the accuracy of map construction and is beneficial to subsequent navigation obstacle avoidance research.},
  keywords={Laser radar;Navigation;Filtering;Robot vision systems;Data integration;Cameras;Indoor environment;Mobile robot;multi-sensor fusion;indoor environment;SLAM;Kalman filter;Bayes’ rule},
  doi={10.1109/AEMCSE51986.2021.00082},
  ISSN={},
  month={March},}@INPROCEEDINGS{10248871,
  author={Lu, Yang and Deng, Zhian},
  booktitle={2023 8th International Conference on Intelligent Computing and Signal Processing (ICSP)}, 
  title={A recursive sorting method based on multi-station TDOA vector}, 
  year={2023},
  volume={},
  number={},
  pages={1024-1027},
  abstract={With increasingly fierce electronic countermeasures, the modulation methods of radiation source signals are becoming increasingly complex. In the face of complex electromagnetic environments, current signal multi-station collaborative sorting algorithms have problems such as high difficulty in data fusion and low sorting accuracy. To address the above issues, this paper proposes a recursive sorting method based on the multi-station time difference vector. Firstly, the location information of the reconnaissance station is used for time difference constraints, and then the multi-parameter Euclidean distance of the pulses is combined to accurately match the multi-station pulses. Finally, based on the distance average of the k-nearest neighbors of the time difference vector, the pulses within the range threshold are merged, the time difference center is updated in real time, and the pulses are recursively extracted and sorted. Simulation results show that the proposed algorithm has a high sorting accuracy.},
  keywords={Histograms;Simulation;Signal processing algorithms;Collaboration;Data integration;Modulation;Reconnaissance;electronic countermeasures;recursion;multi-station TDOA sorting},
  doi={10.1109/ICSP58490.2023.10248871},
  ISSN={},
  month={April},}@INPROCEEDINGS{9171791,
  author={Vinta, Manisha and Sivanantham, S.},
  booktitle={2020 IEEE International Test Conference India}, 
  title={Modeling and Test Generation for Combinational Hardware Trojans}, 
  year={2020},
  volume={},
  number={},
  pages={1-4},
  abstract={Because of globalization in the semiconductor industry and manufacturing processes, integrated circuits are more exposed to harmful attacks called hardware Trojan. This can be considered as a serious threat to the Integrated circuits. Due to the inclusion of hardware Trojan into the existing circuit, it causes the possible effects like changing the functionality of the circuit and discharges some-secret information to the attacker. In this paper, we designed a hardware Trojan, which consists of two parts namely Trigger used to activate Trojan and payload, which changes the functionality of the chip normally the payload is an XOR gate. 2K×(K-1) Trojans are generated for a one-line trigger merged with one payload line for a circuit with K signal lines. The Trojan is detected by generating test patterns by using standard ATPG Tools which detects conditional stuck-at faults-and allows us to find the Trojan coverage and in addition to that this model is effective in finding out the real Trojans.},
  keywords={Manufacturing processes;Very large scale integration;Hardware;Trojan horses;Circuit faults;Test pattern generators;Integrated circuit modeling;Standards;Payloads;Testing;Hardware Trojans;ATPG;conditional stuck-at faults;VLSI Testing;Design for Testability},
  doi={10.1109/ITCIndia49857.2020.9171791},
  ISSN={},
  month={July},}@INPROCEEDINGS{9294359,
  author={Epple, N. and Hankofer, T. and Riener, A.},
  booktitle={2020 IEEE 23rd International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={Scenario Classes in Naturalistic Driving: Autoencoder-based Spatial and Time-Sequential Clustering of Surrounding Object Trajectories}, 
  year={2020},
  volume={},
  number={},
  pages={1-6},
  abstract={Surrounding vehicles are among the essential features to describe traffic scenarios. Besides maneuver (e.g., turn) and scene (e.g., highway), these features are hard to capture in words or labels. The recognition and evaluation of these scenario features are important for road safety. Consequently, when analyzing naturalistic driving data, the composition of the scenarios is essential in order to be able to evaluate driver behavior, and the effects of the overall system quantitatively. In this work, we propose a method to group surrounding vehicles from the perspective of the ego-vehicle and use it for an improved scenario classification. In a two-step approach, we group each vehicle within a scenario independently. We separate the spatial domain (driving tube) from the time domain (performance style). The spatial domain is clustered using a hierarchical ward algorithm to allow for variation of the cluster depth. With the merged result, we realize an outlier detection and a method to quantify the frequency of trajectories within scenarios. From this, the uniqueness of scenarios, e.g., for resimulation, is quantified. This enables us to identify clusters of similar maneuvers of surrounding vehicles up to, for example, lane change maneuver groups of the same speed and acceleration course.},
  keywords={Clustering algorithms;Electron tubes;Classification algorithms;Trajectory;Shape;Convolutional codes;Unsupervised learning},
  doi={10.1109/ITSC45102.2020.9294359},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{9088612,
  author={Obod, Ivan and Svyd, Iryna and Maltsev, Oleksandr and Zavolodko, Ganna and Pavlova, Daria},
  booktitle={2020 IEEE 15th International Conference on Advanced Trends in Radioelectronics, Telecommunications and Computer Engineering (TCSET)}, 
  title={Evaluation of Measuring Accuracy of the Airborne Object Azimuth when Fusion the Primary Data Radar Observation Systems}, 
  year={2020},
  volume={},
  number={},
  pages={644-648},
  abstract={In the paper, a model for data fusion from primary radars and the Identification Friend or Foe (IFF) system, from the airspace control system, is proposed and investigated. It calculates the azimuth of an air object for which there are IFF systems response signals, this allows for a fusion based on Bayesian azimuth data algorithms taking into account the weight merge of the azimuth of an air object estimated from both primary radar and IFF systems. This makes it possible to improve the quality of measuring the coordinates of airborne objects and, as a result, the quality of information support for decision makers.},
  keywords={Weight measurement;Coordinate measuring machines;Azimuth;Radar measurements;Atmospheric modeling;Surveillance;Airborne radar;Data integration;Data models;Radar signal processing;primary radar;IFF;air object (AO);aircraft responder;response signal;probability of information support},
  doi={10.1109/TCSET49122.2020.235511},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10560153,
  author={Kali, Anil and Khuntia, B. S. and Sabat, S. L. and Meher, P. K.},
  booktitle={2024 IEEE 4th International Conference on VLSI Systems, Architecture, Technology and Applications (VLSI SATA)}, 
  title={A Low-Complexity Design for Complex Multiplication Using Radix-4 Booth Encoding}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={In this paper, we present a novel design strategy for complex-number multiplication where the real part, as well as the imaginary part, are considered as a 2-point inner-product, and those inner-products are computed by radix-4 modified Booth-encoded distributed arithmetic approach where the partial inner products are reduced by the carry-save reduction process. Reduction of area complexity is achieved by sharing of Booth encoders by the pair of inner-product units. Time complexity is reduced by avoiding the vector-merging adder, which conventionally follows the carry-save reduction of partial products. The post-layout synthesis results using Cadence Innovus with a GPDK 90nm technology library and FPGA synthesis show that the proposed complex multiplier offers significant advantages in area-delay product and energy consumption over the real-number multiplier-based reference architecture.},
  keywords={Power demand;Neural networks;Systems architecture;Very large scale integration;Encoding;Libraries;Hardware;complex multiplier;Inner-product;Radix-4 modified Booth encoding;Adder tree},
  doi={10.1109/VLSISATA61709.2024.10560153},
  ISSN={},
  month={May},}@ARTICLE{10623236,
  author={Murali, Aniruddhan and Alfadel, Mahmoud and Nagappan, Meiyappan and Xu, Meng and Sun, Chengnian},
  journal={IEEE Transactions on Software Engineering}, 
  title={AddressWatcher: Sanitizer-Based Localization of Memory Leak Fixes}, 
  year={2024},
  volume={50},
  number={9},
  pages={2398-2411},
  abstract={Memory leak bugs are a major problem in C/C++ programs. They occur when memory objects are not deallocated. Developers need to manually deallocate these objects to prevent memory leaks. As such, several techniques have been proposed to automatically fix memory leaks. Although proposed approaches have merit in automatically fixing memory leaks, they present limitations. Static-based approaches attempt to trace the complete semantics of memory object across all paths. However, they have scalability-related challenges when the target program has a large number of paths (path explosion). On the other hand, dynamic approaches can spell out precise semantics of memory object only on a single execution path (it does not consider multiple execution paths). In this paper, we complement prior approaches by designing and implementing a novel framework named AddressWatcher. AddressWatcher allows the semantics of a memory object to be tracked on multiple execution paths. Addresswatcher accomplishes this by using a leak database that allows one to store and compare different execution paths of a leak over several test cases. Also, AddressWatcher performs lightweight instrumentation during compile time that is utilized during the program execution to watch and track memory leak read/writes. We conduct an evaluation of AddressWatcher over five popular packages, namely binutils, openssh, tmux, openssl and git. In 23 out of 50 real-world memory leak bugs, AddressWatcher correctly points to a free location to fix memory leaks. Finally, we submit 25 Pull Requests across 12 popular OSS repositories using AddressWatcher suggestions. Among these, 21 were merged leading to 5 open issues being addressed. In fact, our critical fix prompted a new version release for the calc repository, a program used to find large primes. Furthermore, our contributions through these PRs sparked intense discussions and appreciation in various repositories such as coturn, h2o, and radare2.},
  keywords={Instruments;Computer bugs;Codes;Semantics;Resource management;Memory management;Leak detection;Memory leak;dynamic analysis;vulnerability},
  doi={10.1109/TSE.2024.3438119},
  ISSN={1939-3520},
  month={Sep.},}@INPROCEEDINGS{10900626,
  author={N, Nirmala and D, Gracia Nirmala Rani},
  booktitle={2025 38th International Conference on VLSI Design and 2024 23rd International Conference on Embedded Systems (VLSID)}, 
  title={Enhancing Digital Microfluidic Biochip Operations with Scheduling Interval Method}, 
  year={2025},
  volume={},
  number={},
  pages={564-568},
  abstract={Lab-on-Chip (LoC) device that makes use of electro-wetting-on-dielectric (EWoD) technology is called a Digital Microfluidic Biochip (DMFB). DMFBs provide numerous benefits over the conventional laboratory setup and are capable of performing biochemical analysis with efficiency. It employs fewer chemicals and automates labor-intensive procedures that were previously prone to human error. This results in significant savings in terms of lab space, material costs, and assay (biochemical protocol) completion time. Using electrical actuation techniques, the DMFB enables sample preparation, including mixing, separation, merging, and washing. During the preparation process, various chemical solutions are combined in specific volume ratios, resulting in the creation of solutions with predetermined volumes. Focus on reducing fluid usage, mixing counts, process time, and fluid waste; produce precise ratios; increase use of resources while sample preparation. These goals are crucial since several scheduling techniques have been developed to optimize mixing operation sequences. Therefore, we propose an algorithm for DMFB that aims to minimize the use of input pipes, mixer units, and storage units while simultaneously reducing the number of mixing counts, storage counts, and fluid shifting operations. The duration required to complete a mixing process is denoted by “mixing count,” whereas “mixing tree” refers to the overall process of sample preparation. Meanwhile, our proposed scheduling algorithm with interval method reduces the mixing count by an average of 21% after scheduling when compared to a Reservoir Minimizing Scheduling (RMS). In addition, it shows a 10% decrease in average shifting when compared to the RMS.},
  keywords={Digital microfluidic biochips;Fluids;Protocols;Scheduling algorithms;Simulation;Very large scale integration;Lab-on-a-chip;Reservoirs;Scheduling;Chemicals;Sample preparation;Digital Micro Fluidic Biochip;Dilution & Mixing tree;Minimum Shifting},
  doi={10.1109/VLSID64188.2025.00109},
  ISSN={2380-6923},
  month={Jan},}@INPROCEEDINGS{10536238,
  author={Li, Ke and Schmidt, Susanne and Rolff, Tim and Bacher, Reinhard and Leemans, Wim and Steinicke, Frank},
  booktitle={2024 IEEE Conference on Virtual Reality and 3D User Interfaces Abstracts and Workshops (VRW)}, 
  title={Interactive Data Fusion of Neural Radiance Fields for Industrial Facility Inspection in Virtual Reality}, 
  year={2024},
  volume={},
  number={},
  pages={815-816},
  abstract={Real-world industrial facilities often present complex equipment that requires extensive inspection and maintenance for their operations. In this work, we present a virtual reality (VR) framework that supports virtual facility inspection and maintenance tasks by using neural radiance fields (NeRF) models to replicate, store, and visualize the appearance of complex industrial facilities. To overcome the performance bottleneck of VR NeRF rendering, we present two novel interactive data fusion techniques that can merge a NeRF model with its' corresponding CAD model through a mixed reality tunneling effect and contextual 3D NeRF drawing interaction. Technical benchmarking results and preliminary expert feedback are presented for the initial evaluation of our framework.},
  keywords={Solid modeling;Three-dimensional displays;Data integration;Virtual reality;Inspection;Rendering (computer graphics);Industrial facilities;Virtual Reality—Human-computer Interaction—Neural Radiance Field—},
  doi={10.1109/VRW62533.2024.00204},
  ISSN={},
  month={March},}@INPROCEEDINGS{9081705,
  author={d'Apolito, Francesco and Sulzbachner, Christoph and Bruckmueller, Felix},
  booktitle={2019 IEEE/AIAA 38th Digital Avionics Systems Conference (DASC)}, 
  title={A Multiple Hypothesis Tracking Approach to Collision Detection for Unmanned Aerial Vehicles}, 
  year={2019},
  volume={},
  number={},
  pages={1-5},
  abstract={It is obvious that future unmanned aerial vehicle (UAV) applications will have a high degree of automation, up to autonomy, and will be integrated into civil airspace to go beyond line of sight. To ensure the safe operation of these systems, new technologies are required. Currently, the regulatory and technological frameworks are insufficient. For instance, there are no standards for sensors required to detect obstacles and avoid possible collisions. It is evident that data from several sensors need to be combined to obtain a robust environmental map in order to cope with the high standards of aviation. This paper aims to introduce a Multiple Hypothesis Tracking (MHT) approach to multi-sensor data fusion for future collision avoidance systems. The data from several sensors are merged to obtain new and more accurate measurement data to capture the environment more robustly. The sensors consist of several optical and thermal sensors, radar and transponder systems. This combined measurement data is processed by an avoidance algorithm to calculate avoidance maneuvers. So far, simulations and ground based tests have shown that the implemented MHT approach provides qualitatively better results than conventional probabilistic data fusion approaches. In a next step, test flights will be performed to evaluate the proposed MHT data fusion approach in an airborne environment.},
  keywords={Laser radar;Data integration;Thermal sensors;Radar tracking;Autonomous aerial vehicles;Sensor systems;Complexity theory;Optical sensors;Collision avoidance;Standards;Collision Detection;Umanned Aerial Vehicles;Sensor Fusion},
  doi={10.1109/DASC43569.2019.9081705},
  ISSN={2155-7209},
  month={Sep.},}@INPROCEEDINGS{9621064,
  author={Ullah, Ihsan and Lim, Hyun-Kyo and Han, Youn-Hee},
  booktitle={2021 International Conference on Information and Communication Technology Convergence (ICTC)}, 
  title={Feature Correlation-based Data Fusion using Dempster-Shafer Evidence Theory for WSN}, 
  year={2021},
  volume={},
  number={},
  pages={1208-1212},
  abstract={In wireless sensor networks, data fusion is widely used to merge data obtained from heterogeneous sensors. Since sensors provide uncertain information and containing redundant and irrelevant features, it is imperative to avoid undesired features and select the subset of relevant features for use in data fusion. In this paper, a novel data fusion scheme is proposed based on Pearson correlation and Dempster-Shafer Theory to properly quantify the correlation of features and uncertainty of sensors data. The proposed FCDS (Feature correlation-based fusion using Dempster-Shafer) scheme utilizes the correlated features and available information in the body of evidence (BoE). The BoE obtained from the correlated features of sensor data are then processed using belief entropy to fused the evidence and make a decision. Extensive computer simulation shows that the proposed scheme significantly outperforms the existing schemes for multisensor data fusion in terms of fusion accuracy, degree of uncertainty, and energy efficiency.},
  keywords={Wireless sensor networks;Correlation;Data integration;Reinforcement learning;Sensor fusion;Sensor phenomena and characterization;Entropy;sensor data fusion;dempster-shafer theory;uncertainty measurement;feature correlation;wireless sensor network},
  doi={10.1109/ICTC52510.2021.9621064},
  ISSN={2162-1233},
  month={Oct},}@INPROCEEDINGS{10823047,
  author={Qi, Shufei and Zong, Yonggang},
  booktitle={2024 6th International Conference on Artificial Intelligence and Computer Applications (ICAICA)}, 
  title={Research on the Algorithm of Multi-Sensor Data Fusion in Intelligent Ship Performance Monitoring}, 
  year={2024},
  volume={},
  number={},
  pages={121-125},
  abstract={A new approach is presented in this paper, which is based on multisensory data fusion to enhance the precision and robust of the surveillance system. This thesis can solve the uncertainty of multisource sensor data efficiently based on Dempster-Shafer evidence theory. Furthermore, fuzzy reasoning is applied to improve the fuzzy and uncertain degree of fusion, which makes it more accurate and stable under complicated operating conditions. Firstly, the multisensory data is preprocessed, which includes de-noising and characteristic extracting. Then, the Dempster-Shafer Proof Theory is applied to merge the sensor data to assure coherence and consistency among the various data sources. Fuzzy reasoning is applied to deal with uncertainty in the process of fusion, and further enhance the decision reliability. To prove the validity of the method, the paper builds an Intelligent Vessel Performance Monitoring Model and perform several sets of experiments. Finally, it is proved that the proposed approach is superior to the conventional one in terms of precision of multisensory data fusion, and its robust performance can be improved by 8.7%.},
  keywords={Accuracy;Evidence theory;Surveillance;Soft sensors;Simulation;Data integration;Reliability theory;Marine vehicles;Monitoring;Fuzzy reasoning;Multi-sensor data fusion;intelligent ship performance monitoring;dempster-Shafer evidence theory algorithm;uncertainty processing;fuzzy reasoning},
  doi={10.1109/ICAICA63239.2024.10823047},
  ISSN={2833-8413},
  month={Nov},}@INPROCEEDINGS{11204885,
  author={Sansot, Grégoire and Négrier, Romain and Labarthe, Christophe and Menudier, Cyrille},
  booktitle={2025 IEEE Radar Conference (RadarConf25)}, 
  title={Radar Auto-Calibration Using Kalman Filter Data-Fusion}, 
  year={2025},
  volume={},
  number={},
  pages={467-471},
  abstract={Accurate antenna array calibration is essential for radar systems, as precise gain and phase compensation are key to effective target detection and tracking. Traditional calibration techniques encounter challenges due to component aging, environmental influences, and operational wear, creating a need for auto-calibration methods that allow recalibration throughout the array's lifespan. This paper introduces a novel auto-calibration approach utilizing a Kalman filter to merge complex gain estimates from multiple calibration cycles. This method minimizes reliance on costly hardware while ensuring sustained performance. Simulation results highlight its effectiveness in improving calibration accuracy, a crucial factor for contemporary radar systems.},
  keywords={Antenna measurements;Accuracy;Data integration;Radar;Radar antennas;Radar tracking;Calibration;Kalman filters;Arrays;Antenna arrays;antenna array;auto-calibration;data fusion;Kalman filter},
  doi={10.1109/RadarConf2559087.2025.11204885},
  ISSN={2375-5318},
  month={Oct},}@INPROCEEDINGS{10249054,
  author={Matharia, Ajay Singh and Kaity, Sourav and Das, Lalatendu and Bharti, Js},
  booktitle={2023 3rd International Conference on Range Technology (ICORT)}, 
  title={Improvement of Position Measurement by TDOA Technique using K-Means Clustering}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Time difference of arrival(TDOA) is one of the well-defined techniques for passive detection and localization. TDOA required four receivers to determine the position measurement of the aerial target. Single position measurement does not fulfill all requirements for aerial target tracking, such as reliability and verifiability of the position measurement. In order to increase reliability, more target position measurements need to be made. In traditional ways, eight receivers are required for two target position measurements. A tracking system’s receiver is one of the expansive components. Instead of taking a new set of four receivers to get a positional measurement, combinations of receivers can yield more position measurements about the target with the same number of receivers. In data fusion, multiple data are merged together to produce more accurate, reliable, and usable information than can be obtained from any single source alone. In this paper, Clustering is used to fuse the data to obtain more accurate position measurements than those provided by only a single source. Since the TDOA system is a real-time system, the time complexity is one of the most crucial parameters of the proposed system. The K-means clustering algorithm is the fastest out of all the clustering algorithms that can be used since it is more computationally efficient than other clustering algorithms. The proposed method provides more accurate measurements than the highest accuracy measurement possible with TDOA using one of the combinations of receivers.},
  keywords={Location awareness;Target tracking;Measurement uncertainty;Data integration;Clustering algorithms;Receivers;Position measurement;TDOA;clustering;K-means;tracking;data fusion},
  doi={10.1109/ICORT56052.2023.10249054},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{9547212,
  author={Xia, Yu and Liao, Yue and Zhang, Hongyan and Yang, Guangyi},
  booktitle={IGARSS 2020 - 2020 IEEE International Geoscience and Remote Sensing Symposium}, 
  title={Land Cover Mapping Based On Multi-Branch Fusion Of Object-Based And Pixel-Based Segmentation With Filtered Labels}, 
  year={2020},
  volume={},
  number={},
  pages={7050-7053},
  abstract={In this paper, a multi-branch fusion framework is proposed to address the land cover mapping issue with low-resolution labels. To obtain homogeneous target objects, a multi-resolution segmentation (MRS) algorithm is applied to yield unsupervised object-based segmentation maps. Through an index-based judgement mechanism, a label filtering principle was designed and employed to screen out samples with noisy labels while retaining samples with clean labels, thus acquiring more accurate training data. A patch-to-point classification network was established based on these filtered training patches, which fully extracts the contextual features and generates pixel-based prediction results. A post-processing step, consisting of fusion and voting operations, was developed to merge the pixel-based and object-based results, and produce a final segmentation map. Verified through the competition website, the proposed method achieved an average accuracy (AA) of 57.22%, ranking second in the first track of 2020 IEEE GRSS Data Fusion Contest.},
  keywords={Training;Training data;Geoscience and remote sensing;Data integration;Filtering algorithms;Information filters;Feature extraction;Data fusion;multi-resolution segmentation;label filtering;land cover mapping},
  doi={10.1109/IGARSS39084.2020.9547212},
  ISSN={2153-7003},
  month={Sep.},}@INPROCEEDINGS{9604840,
  author={Naaman, Farah and Zakaria, Firas and Zaylaa, Amer and Khalil, Mohamad and Mechref, Khaled},
  booktitle={2021 Sixth International Conference on Advances in Biomedical Engineering (ICABME)}, 
  title={Automatic segmentation of uterine contractions in EHG signals: Hardware implementation with Raspberry Pi and Arduino Mega}, 
  year={2021},
  volume={},
  number={},
  pages={15-18},
  abstract={Premature birth is one of the major problems in obstetrics. Early detection of preterm birth is an important key to prevent and reduce its consequences. As a result, it has been a subject of interest for many researchers. The current work is placed as part of the development of a non-invasive clinical aid tool. We implement a portable and easy-to-use device for pregnant women be able to automatically detect signs associated with uterine contractions. The device is able to detect EHG segments associated with uterine contractions during pregnancy. EHG signals are acquired, in real time, from 12 bipolar electrodes placed on the abdomen of pregnant women. The data are then analyzed and processed with a powerful processor. The technique used for detection is based on the Dynamic Cumulative Sum (DCS) method which has already demonstrated its strong potential in event detection when applied to non-stationary signals. The DCS method is followed by a data fusion method to merge the segments of all bipolar channels. A technique based on Fisher's test has been implemented and applied between two consecutive segments in order to reduce the over-segmentation problem. This strategy was proposed in previous studies and was proved to be accurate and efficient. The results show that a prototype based on the Raspberry Pi board and the Arduino Mega board is very promising for setting up a final prototype.},
  keywords={Pregnancy;Electrodes;Pediatrics;Electric potential;Event detection;Prototypes;Data integration;preterm birth;DCS;Raspberry Pi;Arduino Mega},
  doi={10.1109/ICABME53305.2021.9604840},
  ISSN={2377-5696},
  month={Oct},}@INPROCEEDINGS{8819731,
  author={Ulabhaje, Kalyani S. and Arya, Meenakshi S.},
  booktitle={2019 3rd International Conference on Computing Methodologies and Communication (ICCMC)}, 
  title={A Proposed Methodology for the Fusion of Microwave and Optical Remote Sensing Data}, 
  year={2019},
  volume={},
  number={},
  pages={731-736},
  abstract={The merging of images obtained by satellites through remote sensing has evolved into an established protocol. In popular parlance such blending is known as image fusion. This is done chiefly because it gives myriad advantages. Image fusion comes in extremely useful in the observation, study and analysis of diverse fields, including environment, agriculture and other related areas. In essence, what happens in image fusion is that the needed data or information is gleaned from numerous images. These images then are coalesced to form fewer pictures. The ideal, of course, is the blending of them into a lone picture. This is highly sought-after because the image thus intermingled is said to contain all relevant data and, moreover, is more suitable and error-free than an image secured from one single source. Needless to say, it also incorporates all the information that is needed. Besides this, there are other benefits. For one, it curtails the volume of data. For another, it produces images that are pertinent and apt. This paper's chief objective is to proffer a suggested methodology on the fusion between the capabilities of optical and microwave satellite images and to improve the visible quality of Landsat image.},
  keywords={Remote sensing;Sensor fusion;Radar imaging;Data integration;Image fusion;Image Fusion;Remote Sensing;Satellite Images;Wavelet Transforms;Image Processing;Landsat;Sentinel;PSNR;Estimated Parameters;Quality},
  doi={10.1109/ICCMC.2019.8819731},
  ISSN={},
  month={March},}@INPROCEEDINGS{11022878,
  author={Shi, Rui and Ogrenci, Seda},
  booktitle={2025 IEEE 43rd VLSI Test Symposium (VTS)}, 
  title={SPRING: Systematic Profiling of Randomly Interconnected Neural Networks Generated by HLS}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Profiling is important for performance optimization by providing real-time observations and measurements of important parameters of hardware execution. Existing profiling tools for High-Level Synthesis (HLS) IPs running on FPGAs are far less mature compared with those developed for fixed CPU and GPU architectures and they still lag behind mainly due to their dynamic architecture. This limitation is reflected in the typical approach of extracting monitoring signals off of an FPGA device individually from dedicated ports, using one BRAM per signal for temporary information storage, or embedding vendor specific primitives to manually analyze the waveform. In this paper, we propose a systematic profiling method tailored to the dynamic nature of FPGA systems, particularly suitable for streaming accelerators. Instead of relying on signal extraction, the proposed profiling stream flows alongside the actual data, dynamically splitting and merging in synchrony with the data stream, and is ultimately directed to the processing system (PS) side. We conducted a preliminary evaluation of this method on randomly interconnected neural networks (RINNs) using the FIFO fullness metric, with co-simulation results for validation.},
  keywords={Measurement;Systematics;Neural networks;Pipelines;Very large scale integration;Real-time systems;Data mining;Springs;Field programmable gate arrays;Optimization;FPGA SoC;High-Level Synthesis;Profiling;FIFO;Benchmarks},
  doi={10.1109/VTS65138.2025.11022878},
  ISSN={2375-1053},
  month={April},}@INPROCEEDINGS{11397882,
  author={Punith, T. and Yasovardhan, A. and Victor, K. and Vallathan, G. and Harikumar, B. and Rama Chandram, V.V.S.V.S.},
  booktitle={2025 Fourth International Conference on Smart Technologies and Systems for Next Generation Computing (ICSTSN)}, 
  title={Symmetric Bit Stacking: A High-Speed, Low-Power Design Paradigm for Binary Counters}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents a novel symmetric bit stacking method for the design of faster and more power-efficient binary counters. Traditional counter architectures introduce significant latency and power overhead in high-speed digital circuits, particularly in multipliers, due to the presence of XOR gates and multiplexers along the critical path. The proposed approach eliminates these delay-inducing components by employing a foundational 3-bit stacking circuit, which is subsequently extended to larger counters through a systematic merging of smaller stacks. Experimental analysis demonstrates that the proposed $6: 3$ counter achieves a 0.4 % improvement in overall performance compared to conventional designs. These results validate the effectiveness of symmetric bit stacking in reducing latency, lowering power consumption, and enhancing the efficiency of large-scale multipliers, thereby addressing a critical bottleneck in modern high-performance computing systems.},
  keywords={Multiplexing;Power demand;Systematics;Stacking;Computer architecture;Digital signal processing;Very large scale integration;Transistors;Next generation networking;Arithmetic;Binary Counters;Symmetric Bit Stacking;Low-Power Design;High-Speed Multipliers},
  doi={10.1109/ICSTSN67075.2025.11397882},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11102336,
  author={Li, Teng and Xu, Yuan},
  booktitle={2025 6th International Conference on Computer Engineering and Application (ICCEA)}, 
  title={An Improved Data Fusion Model for Secondary Return Water Temperature of Heating System Employing EKF}, 
  year={2025},
  volume={},
  number={},
  pages={2052-2056},
  abstract={Predicting the secondary return water temperature in district heating systems is vital for boosting energy efficiency. The intricate nature, nonlinear dynamics, and pronounced time delays in these systems, however, complicate precise forecasting. To overcome these obstacles, we introduce an enhanced data fusion approach rooted in heat transfer fundamentals, coupled with the extended Kalman filter (EKF) for handling nonlinear state estimation. This method adeptly captures time delays and estimates return water temperature using physical principles, while minimizing reliance on extra sensors in the secondary network. Experimental findings reveal that our approach surpasses alternative techniques, delivering reduced Root Mean Squared Error (RMSE) and superior prediction precision, all with straightforward computation. By merging physical insights with EKF, this solution effectively resolves challenges posed by nonlinearity and delays, providing a practical tool for optimizing heating system performance.},
  keywords={Temperature measurement;Temperature distribution;Delay effects;Computational modeling;Data integration;Water heating;Thermocouples;Mathematical models;Kalman filters;Forecasting;Extended Kalman Filter;Unscented Kalman Filter;Centralized Heating System;Secondary Network Forecasting},
  doi={10.1109/ICCEA65460.2025.11102336},
  ISSN={2159-1288},
  month={April},}@INPROCEEDINGS{10862441,
  author={Prakash, Mangali Bhanu and Ravi Kumar, E. and Anitha, Banavath and Bansilal, Boda and Mukkamall, Babu Reddy and Pranaya Sanjana, Gudipati},
  booktitle={2024 Global Conference on Communications and Information Technologies (GCCIT)}, 
  title={LSB based Image Steganography with Password-Protected SMTP Transmission}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Picture steganography plays a crucial role in secure communication by discreetly altering images for various purposes such as data authentication, privacy protection, and watermarking. However, traditional methods often lack resistance to manipulation. To address this, we propose a solution that merges automated password generation with the Least Significant Bit (LSB) approach. This method involves embedding text within images and automatically generating an encryption password to safeguard data security. By employing Simple Mail Transfer Protocol (SMTP) credentials, encrypted photos can be directly sent to recipients, significantly expediting the process. This automated approach eliminates the necessity for separate transfers of the image and decryption password, thereby enhancing simplicity and security. This new technology seamlessly integrates encryption, ensuring a trustworthy and secure communication channel. With this innovative solution, users can transmit sensitive information confidently, knowing that it is shielded from unauthorized access or manipulation. By combining the strengths of automated password generation, LSB steganography, and SMTP transmission, our approach provides a robust framework for safeguarding digital communication in various context.},
  keywords={Resistance;Steganography;Protocols;Transform coding;Passwords;Watermarking;Streaming media;Real-time systems;Encryption;Postal services;Image Steganography;Least Significant Bit (LSB);Modified Least Significant Bit (MLSB);Simple Mail Transfer Protocol (SMTP);Encryption;Decryption},
  doi={10.1109/GCCIT63234.2024.10862441},
  ISSN={},
  month={Oct},}@ARTICLE{10685464,
  author={Li, Fang and Wang, Linfei and He, Hui and Yan, Haofei},
  journal={IEEE Geoscience and Remote Sensing Letters}, 
  title={Delineation of Complex Basement Relief Simultaneously With Smooth and Rifted Features Using Gravity Data Based on CNN}, 
  year={2024},
  volume={21},
  number={},
  pages={1-5},
  abstract={Gravity inversion for basement relief is an important method to depict the structure of the sedimentary basin. At present, researches on this topic are mainly based on the assumption of minimum structure using different norms. However, in practical applications, it is often difficult for these methods to determine appropriate norms. Hence, errors are easily introduced, especially for complex relief. To solve this problem, this study presents a CNN-based gravity inversion method for complex basement relief with both rifted and smooth features. A multitask learning neural network has been designed, which can extract rifted and smooth features through different subnetworks. Then, a converged subnetwork is constructed to merge different features for getting undulations of the basement. The presented method is tested on a synthetic model. The results show that, compared with traditional L2-norm-based methods, this method exhibits improvement in accuracy and ease of use in recovering complex basement relief. Finally, the method is applied to gravity data collected in the Los Angeles Basin in California. The obtained structure shows good consistency with known structure.},
  keywords={Gravity;Feature extraction;Training;Meters;Mathematical models;Ellipsoids;Morphology;Basement relief;CNN;complex features;gravity inversion},
  doi={10.1109/LGRS.2024.3465514},
  ISSN={1558-0571},
  month={},}@INPROCEEDINGS{11170105,
  author={Chen, Songjiang and Chen, Xiao and Huang, Xukun and Fang, Zhen and Wang, Junbo and Huo, Xiaoye and Chen, Xianxiang and Chen, Jian},
  booktitle={2025 IEEE 20th International Conference on Nano/Micro Engineered and Molecular Systems (NEMS)}, 
  title={Bimodal Fusion of Single-Cell Impedance and Imaging Data Using Three Deep Neural Networks of Data-Level Direct Modeling, Feature-Level Joint Fusion and Decision-Level Meta-Learning, a Comparative Study}, 
  year={2025},
  volume={},
  number={},
  pages={250-253},
  abstract={This paper presented bimodal fusion of singlecell impedance and imaging data using three deep neural networks of data-level direct modeling, feature-level joint fusion and decision-level meta-learning. The merged pictures of single-cell impedance and imaging were directly processed by convolutional neural network as data-level direct modeling. Recurrent and convolutional neural networks were used to extract recessive features from single-cell impedance and imaging data, respectively, which were further processed by feedforward neural network for feature-level joint fusion or translated into prediction results as decision-level metalearning. Classification accuracies of 4-part leukocyte differential were quantified as 98.9% of data-level direct modeling, 99.1% of feature-level joint fusion and 99.5% of decision-level meta-learning, which were significantly higher than 90.4% of recurrent neural network and 90.2% of convolutional neural networks only. These results validated the capabilities of bimodal fusion in improving classification accuracies of single-cell impedance and imaging data.},
  keywords={Metalearning;Accuracy;Recurrent neural networks;Nanoelectromechanical systems;Imaging;Data integration;Feature extraction;Data models;Impedance;Convolutional neural networks},
  doi={10.1109/NEMS67320.2025.11170105},
  ISSN={2474-3755},
  month={May},}@INPROCEEDINGS{11379118,
  author={Solanki, Ajaykumar and Vekariya, Vipul and Patel, Warish},
  booktitle={2025 IEEE Pune Section International Conference (PuneCon)}, 
  title={A Comprehensive Review of YOLO Object Detection Models Across Diverse Domains: Evolution, Adaptations, and Performance Benchmarks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Object detection is a core computer vision problem that requires real-time performance as an indispensable companion of accuracy. The YOLO family (You Only Look Once) has gained popularity as it merges detection with the single-stage paradigm of detection being set side by side with speed. In this article, all developments of the YOLO model, from their seminal formulation to the current state-of-the-art in 2018–2025 publications by colleagues in areas such as aerial imagery, infrared/low illumination scenarios, underwater detection applications, agriculture and medical imaging applications, and safety/surveillance applications are critically surveyed. Instead of submitting the results in the results, performance measures such as mAP, FPS, number of parameters, and FLOPs are critically reasoned using comparative lenses. We exhibit trends such as lightweight network architecture, anchor-free detection, and preprocessing-directed variations as well as identify open challenges, including heterogeneity of the datasets, absence of reproducibility, and lack of generalization of the domain. The analysis reveals that post-2018 YOLO variants reduce computational cost by 40–70% while preserving $\geq 85 \%$ of COCO mAP, a trade-off quantified in Fig. 1. Future prospects indicate the use of the multimodal fusion, transformer-based YOLOs, federated learning for applications promoting the augmentation of privacy along with interactions using the large-scale language models.},
  keywords={YOLO;Adaptation models;Computational modeling;Surveillance;System integration;Benchmark testing;Streaming media;Transformers;Safety;Biomedical imaging;This study explores YOLO-based object detection within deep learning;emphasizing applications in aerial remote sensing;infrared and low-light imaging;underwater detection;agricultural and medical imaging;as well as safety;surveillance;defense;while evaluating performance benchmarks},
  doi={10.1109/PuneCon67554.2025.11379118},
  ISSN={2831-5022},
  month={Dec},}@INPROCEEDINGS{11242526,
  author={Trihantoro, Nur Fajar and Jones, Simon and Reinke, Karin},
  booktitle={IGARSS 2025 - 2025 IEEE International Geoscience and Remote Sensing Symposium}, 
  title={Optimising Background Temperatures for Fire Detection: A Weight Function Framework for Multi-Sensor Data Fusion}, 
  year={2025},
  volume={},
  number={},
  pages={1828-1832},
  abstract={We propose a novel weight-function approach for multi-sensor Brightness Temperature (BT) data fusion to estimate background temperature for fire detection. The study merges data from the Advanced Himawari Imager (AHI) onboard Himawari-8, the Advanced Meteorological Imager (AMI) onboard GeoKompsat-2A, and the Sea and Land Surface Temperature Radiometer (SLSTR) onboard Sentinel-3. To reconcile disparities in spatial resolution, temporal sampling, and spectral response, we introduce a weighting scheme inspired by the original STARFM concept integrated into a Kalman filter framework. We assign an equal weighting to the dynamic model (diurnal temperature cycle, DTC) and measurement model (observations), with measurements down-weighted if Spatio-Temporal-Spectral (STS) attributes diverge from those of Himawari-8 AHI. Experiments using two representative Himawari-8 pixels (non-fire and fire areas) between 1 August 2019 and 26 October 2019 demonstrate that this approach produces a more reliable background temperature, enabling simple threshold-based fire detection while minimizing false alarms.},
  keywords={Temperature measurement;Weight measurement;Temperature distribution;Sea measurements;Data integration;Brightness temperature;Land surface temperature;Kalman filters;Reliability;Ocean temperature;brightness temperature;Kalman filter;weight function;middle infrared;Himawari-8 AHI;Sentinel3 SLSTR;GeoKompsat-2A AMI},
  doi={10.1109/IGARSS55030.2025.11242526},
  ISSN={2153-7003},
  month={Aug},}@INPROCEEDINGS{10864608,
  author={Yang, Yifei and Wang, Zihao and Li, Zhen and Deng, Fang and Huang, Yidian},
  booktitle={2024 China Automation Congress (CAC)}, 
  title={D2VT: Better Detection and Description of Local Features with Vision Transformers}, 
  year={2024},
  volume={},
  number={},
  pages={7110-7115},
  abstract={Constrained by the local nature of CNNs, existing local feature description methods often overlook global and contextual spatial information. Vision Transformers (ViT) address this by leveraging self-attention to capture long-range dependencies and preserve spatial details more effectively than CNNs. Our work introduces a hybrid architecture that merges CNNs for local feature extraction with ViT for global feature capture, enhancing performance across diverse vision tasks. We propose a novel hierarchical Transformer encoder adaptable to various image resolutions, yielding multi-scale features without positional encoding. Additionally, we introduce a consistent attention-weighted triple loss to get the attention map and to optimize and match local descriptors. Utilizing a feature pyramid, our method predicts keypoints at multiple scales, leading to improved localization accuracy. Experiments have shown that our approach is competitive with the leading contrastive learning methods in image matching benchmarks and demonstrates robust generalization in tasks like visual odometry.},
  keywords={Location awareness;Visualization;Image resolution;Image coding;Accuracy;Image matching;Contrastive learning;Transformers;Feature extraction;Visual odometry;Feature Detection;Feature Description;Global Information;Vision Transformer;Deep Learning},
  doi={10.1109/CAC63892.2024.10864608},
  ISSN={2688-0938},
  month={Nov},}@INPROCEEDINGS{10966713,
  author={Gao, PingLi and Lu, Yang and Yi, ChuPeng and Zhao, ZiYue and Liu, Xin and Feng, Ting and Ma, XiaoHua},
  booktitle={2024 IEEE MTT-S International Microwave Workshop Series on Advanced Materials and Processes for RF and THz Applications (IMWS-AMP)}, 
  title={18-25 GHz Cascode Low Noise Amplifier in 0.15-μm GaN/SiC HEMT Process}, 
  year={2024},
  volume={},
  number={},
  pages={1-3},
  abstract={In this paper, we present a low noise amplifier designed using WIN $0.15 \mu \mathrm{~m}$ GaN HEMT process for operation at $18-25 \mathrm{GHz}$. The designed LNA adopts a two-stage Cascode structure, and an improved band-pass filtering structure for inter-stage matching, to realize an LNA with good gain flatness in the K-band, achieving a gain of $25 \pm 0.2 \mathrm{~dB}$. In order to reduce the noise and improve the matching performance, the core amplifier adopts the source simple merge inductor structure, which realizes a noise figure of $\mathbf{2. 1 - 2. 6 d B}$ in the operating frequency band, and stable operation in the full frequency band. The overall LNA chip area is $1.38 \times 0.64 \mathrm{~mm}^{2}$.},
  keywords={Radio frequency;Noise figure;Low-noise amplifiers;K-band;Noise;HEMTs;Microwave amplifiers;Microwave filters;Gain;Terahertz communications;Low Noise Amplifier;GaN;K-band;Cascode},
  doi={10.1109/IMWS-AMP62793.2024.10966713},
  ISSN={2694-2992},
  month={Nov},}
