  number={},
  pages={32-43},
  abstract={The performance of many accelerator architectures depends on the communication with external memory. During execution, new I/O data is continuously fetched forth and back to memory. This data exchange is very often performance-critical and a careful orchestration thus vital. To satisfy the I/O demand for accelerators of loop nests, it was shown that the individual reads and writes can be merged into larger blocks, which are subsequently transferred by a single DMA transfer. Furthermore, the order in which such DMA transfers must be issued, was shown to be reducible to a real-time task scheduling problem to be solved at run time. Rather than just concepts, we investigate in this paper efficient algorithms, data structures and their implementation in hardware of such a programmable Loop I/O Controller architecture called LION that only needs to be synthesized once for each processor array size and I/O buffer configuration, thus supporting a large class of processor arrays. Based on a proposed heap-based priority queue, LION is able to issue every 6 cycles a new DMA request to a memory bus. Even on a simple FPGA prototype running at just 200 MHz, this allows for more than 33 million DMA requests to be issued per second. Since the execution time of a typical DMA request is in general at least one order of magnitude longer, we can conclude that this rate is sufficient to fully utilize a given memory interface. Finally, we present implementations on FPGA and also 22nm FDX ASIC showing that the overall overhead of a LION typically amounts to less than 5% of an overall processor array design.},
  keywords={Processor scheduling;Process control;Prototypes;Accelerator architectures;Parallel processing;Real-time systems;Hardware;Massively Parallel Processor Arrays;TCPA;I/O Scheduling;Data Transfers;Priority QueueZ},
  doi={10.1145/3487212.3487349},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9260051,
  author={Luo, Yongping and Jin, Peiquan and Wan, Shouhong},
  booktitle={2020 IEEE 7th International Conference on Data Science and Advanced Analytics (DSAA)}, 
  title={Optimal Data Placement for Data-Centric Algorithms on NVM-Based Hybrid Memory}, 
  year={2020},
  volume={},
  number={},
  pages={226-235},
  abstract={Non-volatile memory (NVM) as a new kind of future memory has several special properties such as non-volatility, read/write asymmetry, and byte address-ability. This makes it difficult to directly replace DRAM with NVM in the current memory hierarchy. Thus, a practical way is to construct a hybrid memory composed of both NVM and DRAM. Such hybrid memory architecture introduces many new challenges for existing algorithms. In this paper, we focus on the data placement issue in NVM-based hybrid memory systems, i.e., how to place the data on DRAM and NVM for a data-centric algorithm so that it can achieve high performance on hybrid memory. Particularly, we propose an optimal data placement model (ODP) to properly store data structures on DRAM and NVM during the execution of an algorithm. We present the theoretical proof to ODP to ensure the correctness of the model. To demonstrate the efficiency of ODP, we apply the ODP to two kinds of data-centric algorithms, namely sorting and database join. For sorting algorithms, we implement four ODP-based sorting algorithms, including Insertion Sort, Selection Sort, Heapsort, and Merge Sort. For join algorithms, we implement four ODP-based join strategies, including Nested Loops Join, Sort Join, Hash Join, and Virtual Partitioning Join. We conduct comparative experiments to evaluate the performance of the sorting/join algorithms. The results show that the ODP-based sorting/join strategies are much faster than the classical sorting/join algorithms that are not NVM-aware. In addition, the ODP-based implementation can reduce more NVM writes, showing that it is more NVM-friendly.},
  keywords={Sorting;Nonvolatile memory;Data models;Radio frequency;Performance evaluation;Handheld computers;Electromagnetics;Data placement model;Join algorithms;Nonvolatile memory;Performance evaluation;Sorting},
  doi={10.1109/DSAA49011.2020.00035},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10651547,
  author={Liu, Ziao and Li, Xuyang and Zhao, Lin and Gao, Zhongquan and Zheng, Yu},
  booktitle={2024 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Industrial Surface Defect Detection via Multi-scale Mask Cross-layer Fusion Network}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper presents a multi-scale mask cross-layer fusion network (MMCF) for industrial surface defect detection. MMCF exploits the transformer’s ability to preserve global information, but replaces the large-kernel large-stride convolution in the patches embedding with a small-kernel small-stride convolution stacking to reduce redundancy. Moreover, MMCF uses different scale complementarily masks to occlude normal images and employs an encoder-decoder structure with cross-layer feature fusion to reconstruct the occluded regions. After smoothing the complementary reconstructed parts using pixel attention, merge them together to form a complete reconstructed image. The anomaly score is computed based on the gradient magnitude similarity between the input image and the reconstruction image. Experiments on the MVTec AD dataset with 15 product categories show that MMCF outperforms other surface defect detection methods in terms of AUC values.},
  keywords={Training;Cross layer design;Surface reconstruction;Smoothing methods;Convolution;Stacking;Termination of employment;surface defect detection;transformer;multi-scale mask;cross-layer feature fusion},
  doi={10.1109/IJCNN60899.2024.10651547},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{9911157,
  author={Zhang, Ze and Farnsworth, Michael and Tiwari, Divya and Jewell, Geraint and Tiwari, Ashutosh},
  booktitle={2022 27th International Conference on Automation and Computing (ICAC)}, 
  title={Sensorformer: A Memory-efficient Transformer for Industrial Sensor Fusion}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={The deep learning model, Transformer, and its variants have achieved state-of-the-art performance in many domains, such as natural language processing, vision recognition, protein structure prediction, as well as industrial multi-sensor data processing tasks. However, the high memory usage and $O(N^{2})$ computational complexity of Transformer can result in the high cost and low efficiency in industrial scenarios, especially in the case of edge computing. To mitigate this problem, we propose a novel auto-decorrelation block based on the Fast Fourier Transform and the self-attention mechanism of Transformer to reduce memory occupation and computational complexity. Instead of removing the related data, this model merges the correlated channels progressively throughout the whole inference process. The proposed method was tested on a public dataset based on condition monitoring of a hydraulic system. Results demonstrated that our proposed method reduced memory usage to around one-fifth of its original size while maintaining similar inference accuracy. The inference time can also be 2 times faster. This allows the transformer to be used for industrial multi-sensor data processing tasks in a more resource-efficient and faster manner.},
  keywords={Deep learning;Fast Fourier transforms;Computational modeling;Sensor fusion;Transformers;Data processing;Data models;Deep Learning;Transformer;Fast Fourier Transform;Smart Manufacturing;Sensor Fusion;Process Monitoring},
  doi={10.1109/ICAC55051.2022.9911157},
  ISSN={},
  month={Sep.},}@ARTICLE{10980282,
  author={Zhang, Zheng and Xu, Tingfa and Lou, Peng and Lv, Peng and Tian, Tiehong and Li, Jianan},
  journal={IEEE Geoscience and Remote Sensing Letters}, 
  title={BiMAConv: Bimodal Adaptive Convolution for Multispectral Point Cloud Segmentation}, 
  year={2025},
  volume={22},
  number={},
  pages={1-5},
  abstract={Multispectral point cloud segmentation, leveraging both spatial and spectral information to classify individual points, is crucial for applications such as remote sensing, autonomous driving, and urban planning. However, existing methods primarily focus on spatial information and merge it with spectral data without fully considering their differences, limiting the effective use of spectral information. In this letter, we introduce a novel approach, bimodal adaptive convolution (BiMAConv), which fully exploits information from different modalities, based on the divide-and-conquer philosophy. Specifically, BiMAConv leverages the spectral features provided by the spectral information divergence (SID) and the weight information provided by the modal-weight block (MW-Block) module. The SID highlights slight differences in spectral information, providing detailed differential feature information. The MW-Block module utilizes an attention mechanism to combine generated features with the original point cloud, thereby generating weights to maintain learning balance sharply. In addition, we reconstruct a large-scale urban point cloud dataset GRSS_DFC_2018_3D based on dataset GRSS_DFC_2018 to advance the field of multispectral remote sensing point cloud, with a greater number of categories, more precise annotations, and registered multispectral channels. BiMAConv is fundamentally plug-and-play and supports different shared-multilayer perceptron (MLP) methods with almost no architectural changes. Extensive experiments on GRSS_DFC_2018_3D and Toronto-3D benchmarks demonstrate that our method significantly boosts the performance of popular detectors.},
  keywords={Point cloud compression;Kernel;Remote sensing;Feature extraction;Convolution;Three-dimensional displays;Laser radar;Training;Loss measurement;Data mining;Adaptive convolution;dataset processing;multispectral;point cloud semantic segmentation},
  doi={10.1109/LGRS.2025.3565739},
  ISSN={1558-0571},
  month={},}@ARTICLE{11077722,
  author={Zhang, Jianshun and Wang, Fang and Ou, Jiaxin and Wang, Yi and Zhao, Ming and Qiu, Sheng and Huang, Junxun and Li, Baoquan and Fang, Peng and Feng, Dan},
  journal={IEEE Transactions on Computers}, 
  title={Scavenger+: Revisiting Space-Time Tradeoffs in Key-Value Separated LSM-Trees}, 
  year={2025},
  volume={74},
  number={10},
  pages={3332-3346},
  abstract={Key-Value Stores (KVS) based on log-structured merge-trees (LSM-trees) are widely used in storage systems but face significant challenges, such as high write amplification caused by compaction. KV-separated LSM-trees address write amplification but introduce significant space amplification, a critical concern in cost-sensitive scenarios. Garbage collection (GC) can reduce space amplification, but existing strategies are often inefficient and fail to account for workload characteristics. Moreover, current key-value (KV) separated LSM-trees overlook the space amplification caused by the index LSM-tree. In this paper, we systematically analyze the sources of space amplification in KV-separated LSM-trees and propose Scavenger+, which achieves a better performance-space trade-off. Scavenger+ introduces (1) an I/O-efficient garbage collection scheme to reduce I/O overhead, (2) a space-aware compaction strategy based on compensated size to mitigate index-induced space amplification, and (3) a dynamic GC scheduler that adapts to system load to make better use of CPU and storage resources. Extensive experiments demonstrate that Scavenger+ significantly improves write performance and reduces space amplification compared to state-of-the-art KV-separated LSM-trees, including BlobDB, Titan, and TerarkDB.},
  keywords={Indexes;Compaction;Costs;Computers;Aerospace electronics;Micromechanical devices;Dynamic scheduling;Bandwidth;Writing;Training;Key-value store;LSM-tree;storage},
  doi={10.1109/TC.2025.3587513},
  ISSN={1557-9956},
  month={Oct},}@ARTICLE{11421916,
  author={Uliarte, Jorge and Freire, Eduardo Oliveira and Vázquez, Fernando Ulloa and Camargo, Federico and Secchi, Humberto and Carelli, Ricardo and Rossomando, Francisco},
  journal={IEEE Access}, 
  title={Trajectory Tracking of a WMR Using a Neuro-Adaptive MRAC Control With Dynamic Uncertainties}, 
  year={2026},
  volume={14},
  number={},
  pages={37871-37884},
  abstract={This work presents a Neuro-Adaptive Model Reference Adaptive Control (NA-MRAC) strategy for trajectory tracking in wheeled mobile robots (WMRs) subject to nonlinear dynamics, load-dependent variations, and unmodeled uncertainties. The proposed approach integrates an inverse-kinematics controller with a dynamic NA-MRAC structure that merges a radial-basis-function neural network and a regressor-based adaptive mechanism, enabling simultaneous compensation of parametric deviations and nonlinear residual dynamics. A complete stability analysis of the cascade kinematic–dynamic architecture is provided, establishing bounded-error behavior under the derived adaptation laws. The method is assessed in simulation using a Pioneer 3DX platform in MobileSim, including scenarios with sudden payload changes, nonsmooth trajectories with directional discontinuities, and a comparative evaluation against a non-adaptive MRAC implementation and a regression-based MRAC controller. The results show that the NA-MRAC provides improved robustness and disturbance rejection, with faster transient response and reduced tracking error in the evaluated scenarios, compared to the other approaches.},
  keywords={Adaptation models;Mobile robots;Kinematics;Robots;Uncertainty;Trajectory tracking;Adaptive control;Stability analysis;Neural networks;Aerodynamics;Wheeled mobile robots;adaptive control;MRAC;neural networks;nonlinear systems},
  doi={10.1109/ACCESS.2026.3670760},
  ISSN={2169-3536},
  month={},}@ARTICLE{9585688,
  author={Li, Peng and Gao, Jing and Zhai, Bin and Zhang, Jianing and Chen, Zhikui},
  journal={IEEE Access}, 
  title={Multi-View Representation Learning via Dual Optimal Transportation}, 
  year={2021},
  volume={9},
  number={},
  pages={144976-144984},
  abstract={Recently, multi-view representation learning has gained rapid growth in various fields. Most of previous multi-view learning methods rely on strong notions of distances that often provide no useful gradients in deep network training, which greatly degrades the performance in merging complementary information of views. To address this challenge, a multi-view representation learning network with dual optimal transportation (MDOT-Net) is proposed to capture fusion representations embedded in a common manifold with the weak topology. In MDOT-Net, the multi-view representation learning is modelled as an optimal transportation (OT) problem in manifold fitting, which is further decomposed into the intra-view OT and the inter-view OT. The intra-view OT is implemented by a view-specific adversarial variational network, which accurately captures local manifold structures within views by leveraging fusion knowledge. The inter-view OT is implemented by a view-fusion adversarial inference network, which models fusion representations compatible with diversities of sub-manifolds by utilizing view-specific knowledge. The two OTs boost mutually by providing prior knowledge to each other in multi-view representation learning. Finally, numerous experiments are conducted on four benchmark datasets, and the results demonstrate MDOT-Net is competitive against state-of-the-art algorithms.},
  keywords={Manifolds;Transportation;Correlation;Knowledge engineering;Kernel;Training;Topology;Machine learning;multi-modal learning;representation learning;unsupervised learning},
  doi={10.1109/ACCESS.2021.3123078},
  ISSN={2169-3536},
  month={},}@ARTICLE{11079865,
  author={Cao, Yuanyu and Cao, Jiayin and Xing, Linyan and Zhu, Bo and Bao, Qiao and Li, Tianyi and Wang, Qiang},
  journal={IEEE Sensors Journal}, 
  title={An Enhanced-RANSAC-Fusion and Kd-Tree-Filtering Pipeline Method for Multiscale 3-D Substation Components Extraction}, 
  year={2025},
  volume={25},
  number={16},
  pages={30897-30905},
  abstract={The construction, operation, and maintenance of smart grids typically rely on high-precision 3-D models of substations, for which 3-D scanning and object extraction based on laser point cloud technology offer a feasible approach to accurate modeling in complex environments. Due to the structural complexity and occlusion in substations, the extraction of centimeter- to meter-scale components from large-scale laser point cloud data remains challenging. Representative components at different scales are selected in this study, with insulators at the centimeter scale and crossarms at the meter scale. An enhanced-RANSAC-fusion and Kd-Tree-filtering pipeline method (ERKF) is proposed to address the limitations of traditional random sample consensus (RANSAC), which often fails to capture fine-scale structures due to geometric mismatch. In the proposed method, pass-through filter and point cloud clipping were adopted to reduce background noise and preserve critical details, and then the processed data with the initial RANSAC output are merged to recover accessory components. Next, a Kd-Tree is used to search for and remove nontarget points. This enables a more complete extraction of substation components from the 3-D point cloud. Experimental validation demonstrates that in substation environments, the accuracy precision of insulator and crossarm extraction improves by approximately 24.5% compared with the traditional RANSAC algorithm, providing substation monitoring personnel with an intuitive method for equipment fault diagnosis and defect identification.},
  keywords={Point cloud compression;Substations;Feature extraction;Filtering;Noise;Data mining;Accuracy;Fitting;Three-dimensional displays;Computational efficiency;Components;point cloud segmentation;random sample consensus (RANSAC) algorithm;substation},
  doi={10.1109/JSEN.2025.3586852},
  ISSN={1558-1748},
  month={Aug},}@INPROCEEDINGS{10069612,
  author={Chen, Yan-Bin and Tiong, Khong-Loon and Yeang, Chen-Hsiang},
  booktitle={2022 21st IEEE International Conference on Machine Learning and Applications (ICMLA)}, 
  title={Clustering image data with a fixed embedding}, 
  year={2022},
  volume={},
  number={},
  pages={891-896},
  abstract={Clustering unlabeled image data using deep neural network (DNN) models is under active investigation. Most existing approaches transform the data through embedding operations and cluster the embedded data, and the embedding is learned to fit the data. In some applications, the embedding model is explicitly given due to the concerns of generalizability, transferability, privacy and security. Despite rapid progress in self-supervised learning, clustering data with a fixed embedding is rarely explored. We propose an Merge & Expand (ME) algorithm to cluster image data using a fixed embedding and a DNN classification model. ME achieves a comparable level of accuracy with some state-of-the-art algorithms. It further demarcates the "clean" and "unclean" images where their geometric relations in the embedded space are compatible and incompatible with their cluster structure respectively. Finally, we validate ME with three datasets and discuss its potential extension.},
  keywords={Deep learning;Privacy;Neural networks;Clustering algorithms;Transforms;Self-supervised learning;Data models;Clustering;CNN;Embedding},
  doi={10.1109/ICMLA55696.2022.00148},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9060241,
  author={Skartados, Evangelos and Kostavelis, Ioannis and Giakoumis, Dimitrios and Tzovaras, Dimitrios},
  booktitle={2019 IEEE SmartWorld, Ubiquitous Intelligence & Computing, Advanced & Trusted Computing, Scalable Computing & Communications, Cloud & Big Data Computing, Internet of People and Smart City Innovation (SmartWorld/SCALCOM/UIC/ATC/CBDCom/IOP/SCI)}, 
  title={Automatic Subsurface Map Generation Based on GPR Data Processing}, 
  year={2019},
  volume={},
  number={},
  pages={231-236},
  abstract={In the domain of subsurface scanning, an abundance of GPR data are typically acquired by exploiting technologically advanced Ground Penetrating Radar (GPR) devices. However, the processing and representation of these data in a concise manner that can be easily interpreted by non-experts is still an active research topic. To this end, the paper at hand introduces a new method for automatic registration of sequences of GPR data into a common reference frame. It starts from an elementary GPR scanning session, relied on the existence of a GPR antenna array in a structured device, and proposes a sequential registration approach for multiple elementary scans, by exploiting a similarity measure, that utilizes the multilevel discrete wavelet transform decomposition. The data are processed in the 3D-space to achieve convergence during merging the scans, formulating thus a 3D map of the subsurface. In this map, data of selected depth range are top-down projected to formulate C-Scans in a parametric manner that can be easily interpreted by non-experts. The method has been evaluated in three different datasets and exhibited promising results in the task of automated GPR scans registration and corresponding large-scale subsurface map generation.},
  keywords={Ground penetrating radar;Antenna measurements;Discrete wavelet transforms;Two dimensional displays;Robots;Antenna arrays;Inspection;multi-array GPR imaging;DWT decomposition;robotic subsurface mapping;registration},
  doi={10.1109/SmartWorld-UIC-ATC-SCALCOM-IOP-SCI.2019.00082},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11281859,
  author={Ashrafi, Adnan Ferdous and Kabir, Md. Hasanul},
  booktitle={2025 40th International Conference on Image and Vision Computing New Zealand (IVCNZ)}, 
  title={Enhanced Graph Convolutional Network with Chebyshev Spectral Graph and Graph Attention for Autism Spectrum Disorder Classification}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={ASD is a complicated neurodevelopmental disorder marked by variation in symptom presentation and neurological underpinnings, making early and objective diagnosis extremely problematic. This paper presents a Graph Convolutional Network (GCN) model, incorporating Chebyshev Spectral Graph Convolution and Graph Attention Networks (GAT), to increase the classification accuracy of ASD utilizing multimodal neuroimaging and phenotypic data. Leveraging the ABIDE I dataset, which contains resting-state functional MRI (rs-fMRI), structural MRI (sMRI), and phenotypic variables from 870 patients, the model leverages a multi-branch architecture that processes each modality individually before merging them via concatenation. Graph structure is encoded using site-based similarity to generate a population graph, which helps in understanding relationship connections across individuals. Chebyshev polynomial filters provide localized spectral learning with lower computational complexity, whereas GAT layers increase node representations by attention-weighted aggregation of surrounding information. The proposed model is trained using stratified five-fold cross-validation with a total input dimension of 5,206 features per individual. Extensive trials demonstrate the enhanced model's superiority, achieving a test accuracy of 74.82% and an AUC of 0.82 on the entire dataset, surpassing multiple state-of-the-art baselines, including conventional GCNs, autoencoder-based deep neural networks, and multimodal CNNs.},
  keywords={Autism;Adaptation models;Accuracy;Graph convolutional networks;Convolution;Computational modeling;Magnetic resonance imaging;Computer architecture;Chebyshev approximation;Videos;Autism Spectrum Disorder;Chebyshev Spectral Graph;Graph Attention;Graph Convolution Network;Multimodal data;ABIDE I},
  doi={10.1109/IVCNZ67716.2025.11281859},
  ISSN={2151-2205},
  month={Nov},}@INPROCEEDINGS{11427142,
  author={Novischi, Dan M. and Florea, Adina M.},
  booktitle={2025 IEEE 21st International Conference on Intelligent Computer Communication and Processing (ICCP)}, 
  title={Consensus Line Formations in Non-Holonomic Multi-Robot Systems Enabled by Decentralized Approximate MST}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={We introduce a fully decentralized strategy enabling teams of non-holonomic mobile robots to autonomously form and maintain stable, configurable line-shaped formations during navigation. Central to our approach is a lightweight communication backbone implemented as an approximate minimum spanning tree (MST), constructed efficiently in two stages. First, robots use local geometric criteria to rapidly form initial spanning fragments, which are then incrementally merged through a decentralized, multi-scale Boruvka-inspired process. Leveraging this structure, we extend a potential field-based formation controller to incorporate local alignment behaviors, allowing each robot to dynamically adjust its orientation and inter-robot spacing according to user-defined configurations. This framework ensures robust and scalable formation control without relying on global knowledge or predefined network topologies. Extensive simulations confirm the strategy’s effectiveness, demonstrating rapid convergence, adaptability to evolving formation configurations, and guaranteed asymptotic stability.},
  keywords={Robot kinematics;Spanning trees;Robot sensing systems;Topology;Sensors;Mobile robots;Root mean square;Dispersion;Convergence;Testing;decentralized coordination;approximate minimum spanning tree;multi-robot formation;aggregation and dispersion;non-holonomic mobile robots},
  doi={10.1109/ICCP68926.2025.11427142},
  ISSN={2766-8495},
  month={Oct},}@INPROCEEDINGS{11451082,
  author={Hole, Shreyas Rajendra and Ahmed Khan, Mubeen and Sardar, Tanvir Habib and V S, Devi Priya and Naresh, P and R, Nivetha},
  booktitle={2025 International Conference On Emerging Computation and Information Technologies (ICECIT)}, 
  title={Hybrid CNN-XGBoost Framework for Enhanced Urban Sound Classification Using MFCC Features}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The novel hybrid CNN-XGBoost model is designed to work with the UrbanSound8K dataset and MFCCs, in which a CNN is used for temporal and spectral feature extraction from urban noise samples, and XGBoost is used for classification based on the learned complex and quieter boundary features. The combination of these two techniques surpasses the accuracies of other models such as Random Forest (89.8%) and K-Nearest Neighbors (88.1%) by achieving an accuracy of 90%. The model performs exceptionally well with structured sounds like Car Horn (0.99) and Engine Idling (0.97); however, it struggles with more complicated sounds, like Children Playing (0.84). By merging feature extraction from CNNs with boost tree classification from XGBoost, the model accounts for noisy data and complex tasks. This removes the hurdles experienced in solely using handcrafted feature reliant models, or models using simple decision tree paths. This multifaceted method improves sound classification in smart cities for purposes like noise pollution tracking or public danger signaling. Possible refinements could be attention mechanisms to aid in the classification of variable sounds, or transfer learning to increase versatility. This being the first of its kind, the CNN-XGBoost model leaves room for further advancements and better practicality in urban noise classification.},
  keywords={Accuracy;Pollution;Smart cities;Noise;Transfer learning;Nearest neighbor methods;Feature extraction;Convolutional neural networks;Noise measurement;Random forests;Urban Sound Classification;Convolutional Neural Networks (CNNs);Mel-frequency Cepstral Coefficients (MFCCs);UrbanSound8K Dataset,Smart City Applications},
  doi={10.1109/ICECIT67774.2025.11451082},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11115562,
  author={Varavdekar, Sairaj and Vartak, Shravani and Dhuka, Ilf and Pingle, Yogesh},
  booktitle={2025 12th International Conference on Computing for Sustainable Global Development (INDIACom)}, 
  title={Harmonix: A Comprehensive Approach for Advance Music Composition Using AI-ML}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Traditional music composition often requires expertise in musical theory and substantial time investment, posing challenges for creators without formal training. Composing traditional music often requires music theory knowledge and commensurate effort, which is hard for non-trained creators. The avoidance of traditional composition methods excludes many talented creators due to the amount of theoretical knowledge and practice needed in order to create music with the traditional compositional processes. Although current tools do not consider the enormous richness of non-Western musical forms, computational approaches provide new options for music creation. We present Harmonix, a system that solves this problem by blending the principles of Indian classical music with modern technology. Our strategy focuses on a framework of composition that is flexible such that users take two of the three components, lyrics, theme or melody, while the system provides the complementary third element. Using mathematical patterns of taal (rhythm), tonal richness of swara (notes) and the dynamic use of lay (tempo), Harmonix preserves the composition structure of Indian classical music with contemporary music influences. The system's neural architecture, which exhibits a unique strength in sustaining long-term melodic coherence, a longstanding challenge in music composition, merges bidirectional LSTM technology with attention mechanisms.},
  keywords={Training;Information science;Attention mechanisms;Bidirectional long short term memory;Computer architecture;Coherence;Rhythm;Creativity;Investment;Music Composition Systems;Indian Classical Music;Melody Generation;Computational Creativity;Musical Heritage Preservation;Neural Music Processing;Cross-Cultural music Information Science;Interactive Composition Tools},
  doi={10.23919/INDIACom66777.2025.11115562},
  ISSN={},
  month={April},}@INPROCEEDINGS{11403812,
  author={Dubey, Krati and Suman, Alpana and Saurabh, Praneet and Boghey, Rajesh Kumar and Sharma, Animesh Kumar},
  booktitle={2025 2nd International Conference on Artificial Intelligence for Innovations in Healthcare Industries (ICAIIHI)}, 
  title={Drug Interaction Modeling using Graph Neural Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Drug-drug interactions (DDIs) present significant hurdles in clinical practice, making it essential to develop strong predictive models that can improve patient safety and streamline drug development. Recently, advancements in graph neural networks (GNNs) have shown impressive effectiveness in capturing the intricate relationships between drugs, targets, and molecular structures. This review brings together the latest research on GNN-based methods for predicting DDIs, focusing on techniques that utilize molecular graphs, knowledge graphs, and heterogeneous networks. Approaches such as dual-graph architectures, attention mechanisms, multi-scale GNNs, and contrastive learning have all contributed to better predictive accuracy and interpretability. By integrating structural, chemical, and pharmacological features, these models can predict interactions between drugs and targets. Additionally, automated GNN frameworks and self-supervised learning techniques make feature extraction and model optimization much easier. Comparative studies indicate that GNN-based methods outperform traditional machine learning and similarity-based approaches when it comes to handling large-scale and multi-relational biomedical data. The review also tackles challenges like data sparsity, scalability, and the need for explainable predictions. Future research will likely focus on merging multi-omics data, enhancing model generalization, and supporting real-time clinical decision-making, positioning GNNs as a groundbreaking tool for precision medicine and drug safety assessment..},
  keywords={Drugs;Accuracy;Reviews;Biological system modeling;Precision medicine;Computer architecture;Knowledge graphs;Predictive models;Graph neural networks;Safety;Drug interaction;graph neural networks;molecular graph;knowledge graph;deep learning;predictive modeling},
  doi={10.1109/ICAIIHI67124.2025.11403812},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11321687,
  author={Wang, Pao-Kai and Lin, Yu-Chen and Wei, Bo-Yu and Xiao, Wen-De},
  booktitle={2025 11th International Conference on Control, Decision and Information Technologies (CoDIT)}, 
  title={Hierarchical Reinforcement Learning with Spatial-Temporal Attention for Ramp Cut-In/Cut-Out}, 
  year={2025},
  volume={1},
  number={},
  pages={1876-1881},
  abstract={Turbulence in highways or expressways often arises from vehicles merging onto the main road from entrance ramps (cut-in) or exiting onto exit ramps (cut-out). These maneuvers, dictated by road geometry, significantly disrupt traffic flow, leading to speed variations, turbulence, and reduced capacity. To address these challenges, this paper proposes a spatial-temporal attention-based framework for Cut-in/Cut-out lane-changing strategies. The framework integrates graph attention networks (GAT), safety potential fields, and long short-term memory (LSTM) networks to extract dynamic traffic interactions and risk levels as spatiotemporal features. Built on these features, a hierarchical reinforcement learning (HRL) structure is adopted, dividing the lane-changing task into high-level decision-making, which determines the timing and feasibility of lane changes, and low-level trajectory planning, which generates smooth and collision-free paths. Prioritized experience replay is employed to improve learning efficiency, while a multi-level reward function balances lane-changing success, safety, and efficiency. Experiments conducted on the CARLA simulation platform validate the framework's effectiveness in optimizing lane-changing strategies, demonstrating significant improvements in traffic safety and operational efficiency.},
  keywords={Trajectory planning;Roads;Decision making;Reinforcement learning;Feature extraction;Safety;Spatiotemporal phenomena;Timing;Vehicle dynamics;Long short term memory;cut-in;cut-out;spatial-temporal;safety potential field;hierarchical reinforcement learning;CARLA},
  doi={10.1109/CoDIT66093.2025.11321687},
  ISSN={2576-3555},
  month={July},}@INPROCEEDINGS{10583191,
