  number={},
  pages={8002-8015},
  abstract={Image splicing is a common technique used in image forgery. With the rapid development of digital image processing technology, detecting image splicing forgery has become increasingly challenging. Existing splicing forgery localization methods lack exploration in effectively utilizing tampered region boundary information. To address this issue, we propose a novel model for detecting image splicing forgery called boundary-assisted network (BASNet). We introduce a boundary-motivated module (BMM) to explore valuable and additional boundary features related to tampered regions, enhancing representation learning for detecting tampered regions. Additionally, we present a boundary-enhanced module (BEM) to enhance boundary information using the cross-channel attention mechanism. To efficiently merge features from various levels and boundary features, we further present the feature fusion module (FFM). To optimize performance, the BASNet incorporates weighted binary cross-entropy loss, dice loss, and boundary loss, which can effectively leverage edge supervision while mitigating imbalance between positive and negative samples. Evaluation of five widely-used forgery detection datasets demonstrates the state-of-the-art performance of the BASNet. Robustness experiments verify that the BASNet is robust enough to detect image splicing forgery across various common attacks.},
  keywords={Forgery;Splicing;Feature extraction;Noise;Location awareness;Image coding;Data mining;Training;Image edge detection;Deep learning;Splicing forgery;boundary feature;and fusion module},
  doi={10.1109/TMM.2025.3604911},
  ISSN={1941-0077},
  month={},}@INPROCEEDINGS{10122049,
  author={Baeyens, Arne and Van Raemdonck, Bert and Milana, Edoardo and Reynaerts, Dominiek and Gorissen, Benjamin},
  booktitle={2023 IEEE International Conference on Soft Robotics (RoboSoft)}, 
  title={FONS: a Python framework for simulating nonlinear inflatable actuator networks}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Soft robots designed within a conventional robotic framework typically consist of individually addressable compliant actuators that are merged together into a deformable body. For inflatable soft robots, this comes at a high cost of tethering which drastically limits their autonomy and versatility. This cost can be decreased by connecting multiple actuators in a fluidic network and partially offloading control to the passive interactions within the network. This type of morphological control necessitates some of the elements in the network to have nonlinear characteristics. However a standardized simulation framework for such networks is lacking. Here, we introduce the open-source python library FONS (Fluidic object-oriented network simulator), a tool for simulating fluidic interactions in lumped fluidic networks of arbitrary size. It is compatible with both gaseous and liquid fluids and supports analytical, simulated and measured characteristics for all components. These components can be defined using a library of standard components or can be implemented as custom objects following a modular object-oriented framework. We show that FONS is capable of simulating a multitude of systems with highly non-linear components exhibiting morphological control.},
  keywords={Actuators;Costs;Software libraries;Liquids;Source coding;Object oriented modeling;Soft robotics},
  doi={10.1109/RoboSoft55895.2023.10122049},
  ISSN={2769-4534},
  month={April},}@INPROCEEDINGS{10677742,
  author={Chen, Huan-Yu and Lin, Chuen-Horng and Lin, Yan-Yu and Chan, Yung-Kuan},
  booktitle={2024 8th International Conference on Imaging, Signal Processing and Communications (ICISPC)}, 
  title={An Integrated Model for Generating 3D Point Clouds and Segmentation from 2D Images}, 
  year={2024},
  volume={},
  number={},
  pages={94-101},
  abstract={This study presents a cost-effective approach to constructing simulation systems by integrating 2D visual processing with neural network technology for simultaneous 3D point cloud generation and part segmentation, thereby reducing time and costs. We propose multiple task-specific models using 2D RGB images, incorporating attention mechanisms, feature encoding, decoding layers, and innovative loss functions. The optimal models are merged to form an integrated system, evaluated using public and self-built datasets. Our experiments demonstrate that the integrated model effectively reduces training time and Floating Point Operations (FLOP) values while maintaining high accuracy in Critical Hole Distance (CHD), Earth Mover’s Distance (EMD), and Intersection over Union (IOU) metrics. This advancement enhances applications in military training, aerospace technology, and disaster response simulation, facilitating faster 3D object construction.},
  keywords={Training;Point cloud compression;Image segmentation;Solid modeling;Adaptation models;Visualization;Three-dimensional displays;Image coding;Data models;Decoding;Deep learning;2D image;point cloud;integrated learning;reconstruction;part segmentation},
  doi={10.1109/ICISPC63824.2024.00025},
  ISSN={2831-3984},
  month={July},}@INPROCEEDINGS{11167380,
  author={Nandu, Avula and Goud, B.PruthviRaj and Kumar, K. Praveen and Reddy, G. Sekhar and Basha, Shaik Abid and Reddy, D.Yamuna},
  booktitle={2025 5th International Conference on Intelligent Technologies (CONIT)}, 
  title={A Hybrid Approach to Image Fusion Using Wavelet Transform and Weighted Arithmetic Optimization}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The exponential increase in digital imagery has amplified the demand for effective tools to identify similar images and merge them into richer informative outputs. with the applications as crossing image Enhancement, digital forensic science and content management. This work proposes an Advanced Image Similarity Detection and Fusion approach that combines computer vision, wavelet transform and adaptive optimization to respond for such demands. It adopts histogram and edge-based feature extraction and cosine similarity to find the similar image pairs from a folder with robust detection by the equipping a configurable threshold (default: 0.85). It uses multi-level wavelet decomposition with the symlet 8 wavelet technique for fusion, adaptively weights coefficients from energy variance, and reconstructs images using unsharp masking for better clarity. Implemented in Python using libraries such as OpenCV, PyWavelets, and NumPy, the system handles various image formats (PNG, JPG, JPEG, BMP) in real-time, producing fused outputs with metadata. This work provides a scalable, highfidelity solution that surpasses conventional approaches, making a contribution to the area of image processing by achieving accuracy, quality, and efficiency.},
  keywords={Wavelet transforms;Histograms;Accuracy;Image edge detection;Transform coding;Real-time systems;Usability;Optimization;Image fusion;Arithmetic;Image fusion;Weighted wavelet transform;Arithmetic optimization algorithm},
  doi={10.1109/CONIT65521.2025.11167380},
  ISSN={},
  month={June},}@INPROCEEDINGS{9568430,
  author={Al-Haboobi, Ali and Al-Haboobi, Hayder},
  booktitle={2021 International Conference on Communication & Information Technology (ICICT)}, 
  title={Bezier Curve Extraction and Compression from Fingerprints Using New Method}, 
  year={2021},
  volume={},
  number={},
  pages={55-61},
  abstract={Nowadays, Fingerprint image process techniques have become one of the cornerstones of the world of data security. A lot of methods have been dedicated to the purpose of getting the most accurate representation of the fingerprint images with the minimizing file size resulted from the extraction. This paper will summarize the new method for Figureprint extraction that takes advantage of the cubic Bezier curve technique as it is one of the best ways for fingerprint representation. Also, the paper will present an original curve fitting technique that works on determining how many Bezier curves are necessary to accurately represent each one of the ridgelines and from which point to which point each one of those Bezier curves should be applied. The purposed method will analyze each ridge by dividing it into equal-length parts. The straight-line angle drawn between each sequenced control point will determine “for each part” whether it is required to present a new Bezier or this part can be merged with the previous and represent them in one Bezier curve. The resulting data of the purposed method will be compared with the other conventional methods used by the Bezier curve representation. The results obtained show the ability of the purposed method to reduce the number of Bezier curves however the number of Bezier curves and the quality of the resulted image are dependants on the number of segments.},
  keywords={Image segmentation;Image coding;Shape;Image matching;Data security;Fingerprint recognition;Information technology;Figureprint;Bezier curves;Ridges;Biometrics},
  doi={10.1109/ICICT52195.2021.9568430},
  ISSN={},
  month={June},}@INPROCEEDINGS{10412157,
  author={Cavalli, Ana Rosa and Montes De Oca, Edgardo},
  booktitle={2023 Fourteenth International Conference on Mobile Computing and Ubiquitous Network (ICMU)}, 
  title={Cybersecurity, Monitoring, Explainability and Resilience}, 
  year={2023},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper introduces a comprehensive study fo-cused on prominent cyber resilience methods. Resilience is defined as a system's capacity to function despite attacks or breaches. Our aim is to highlight techniques that guarantee sys-tem security and performance, even in compromised conditions. While detecting intrusions and attacks is vital, there is an absence of methods addressing accountability and system robustness. By merging monitoring with explainability and resilience methods, as well as AI techniques, we foster intrusion detection and create protective strategies. Our resilience model emphasizes self-repair and introspection, drawing inspiration from techniques like Moving Target Defence (MTD). We provide real-world examples to demonstrate anomaly detection, explainability and system robustness, including the detection of autonomous vehicle communication anomalies, explainable AI techniques, and an electric vehicle charging scenario.},
  keywords={Codes;Robustness;Weaving;Computer security;Task analysis;Resilience;Testing;Cyber-resilience;Cyber-security;Mitigation actions;Critical Systems;Security Monitoring;Moving Target Defense;Explainable AI},
