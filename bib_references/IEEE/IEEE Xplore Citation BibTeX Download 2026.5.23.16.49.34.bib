  abstract={This study explores how agentic language models (Llama-3.2-3B, Gemma-2-9B, DeepSeek-R1-14B, and Phi-4-14B) detect and refactor test smells. Multiagent workflows outperformed single-agent setups in 3 of 5 cases, with Phi-4-14B achieving the best accuracy and merged open source contributions.},
  keywords={Codes;Logic;Accuracy;Encoding;Testing;Static analysis;Python;Natural language processing;Machine learning;Java;Large language models},
  doi={10.1109/MS.2025.3621356},
  ISSN={1937-4194},
  month={Jan},}@INBOOK{10950641,
  author={Davenport, Thomas H. and Barkin, Ian and Davenport, Chase},
  booktitle={All Hands on Tech: The AI-Powered Citizen Revolution}, 
  title={The Citizen Journey}, 
  year={2025},
  volume={},
  number={},
  pages={33-48},
  abstract={Summary <p>Every citizen is unique in some respects, but there are patterns in how they develop their technical capabilities and apply them to their jobs and organizations. This chapter discusses the typical progression of citizen activity over time and also discusses the longer&#x2010;term career implications of citizen activities. It describes lawyers who become AI application developers, English majors who become citizen data scientists, and front&#x2010;line operations people who become translators interfacing with professional data scientists. One of the first attributes of an effective citizen, then, is a positive orientation toward technology experimentation and a willingness to employ it in her or his work. One path to automation is from process improvement. In a growing number of companies, process improvement groups are adding automation capabilities or merging with other groups that already possess them. The &#x201c;citizen data scientist&#x201d; is among the rarer breeds of citizen developers.</p>},
  keywords={Business;Companies;Engineering profession;Supply chains;Data science;Codes;Transforms;History;Digital transformation;Data visualization},
  doi={},
  ISSN={},
  publisher={Wiley},
  isbn={9781394245925},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10950641},}@INPROCEEDINGS{11351772,
  author={Patel, Sagar B. and Nigam, Sajal and Mahale, Shrikanth},
  booktitle={2025 IEEE International Conference on Data and Software Engineering (ICoDSE)}, 
  title={Reverse-Engineering and Automating BDD for Modern Software Development with LLMs}, 
  year={2025},
  volume={},
  number={},
  pages={437-442},
  abstract={Behavior-Driven Development (BDD) frameworks like Cucumber and Behave align business requirements with executable tests but remain costly to author and maintain, especially for legacy or evolving systems [1], [2]. We present a novel LLM-driven approach, leveraging LLaMA to reverse-engineer requirements from schemas, API payloads, and partial tests to automatically generate Gherkin feature files with corresponding step definitions. Generated artifacts are drafted into automated pull requests and merged into the repositories via human review [3]. Our proposed method when tested across two enterprise systems, over six sprints, reduced authoring time by about 75%, expanded negative test coverage by 30%, and achieved cost savings ranging from $7,725 in conservative adoption to over $40,000 in high-volume adoption, maintaining infrastructure overhead costs below 3%. Beyond efficiency gains, the approach lowers barriers for teams new to BDD and demonstrates a practical, cost-effective path for industry adoption while opening avenues for research in adaptive prompting, coverage-aware generation, and retrieval-augmented workflows. [3].},
  keywords={Industries;Software testing;Costs;Codes;Automation;Reviews;Pipelines;Natural language processing;Distance measurement;Payloads;Behavior-Driven Development (BDD);Generative AI;Gherkin;Human-in-the-Loop;Inference;Large Language Models (LLMs);Llama;Natural Language Processing (NLP);Software Testing Frameworks;Test Automation},
  doi={10.1109/ICoDSE68111.2025.11351772},
  ISSN={2640-0227},
  month={Oct},}@ARTICLE{10962186,
  author={Xin, Xin and Li, Yuchen and Zhao, Shimei and Sun, Dingyu and Tong, Xingyuan},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={A 1st-Order NS-SAR⋅ADC With DCMS Switching Scheme for Smart Consumer Electronics Device}, 
  year={2025},
  volume={71},
  number={1},
  pages={1298-1306},
  abstract={A novel Dual-Capacitor Merge-and-Split (DCMS) capacitor switching scheme is proposed for a Noise-Shaping (NS) Successive-Approximation-Register Analog-to-Digital-Converter (SAR ADC) for smart consumer electronics device. In comparison to the  $V_{\mathrm { cm}}$ -based method, the proposed DCMS scheme significantly decreases the average switching energy by 93.7%, while optimizing integral and differential non-linearity by factors of  $\surd 3$ / $4\times $  and  $\surd 1$ / $2\times $ , respectively. By employing only  $V_{\mathrm { cm}}$  reference, the DCMS scheme can avoid the  $V_{ref}$  generation circuit and mismatch between the  $V_{ref}$  and  $V_{\mathrm { cm}}$  compared to the tri-level or multiple-level switching schemes. Moreover, it maintains a stable common-mode output voltage, simplifying comparator design by aiding in dynamic offset suppression. A  $1{^{\text {st}}}$ -order NS-SAR ADC is implemented with the proposed DCMS scheme in a 0.18- $\mu $ m CMOS process. Measurement results indicate it can achieve a Signal-to-Noise-and-Distortion Ratio (SNDR) of 66.5 dB with a power consumption of  $19.22~\mu $ W from a 1-V supply, at a sampling rate of 1 MS/s. This yields a Schreier Figure-of-Merit (FoMs) of 161.6 dB and a Walden Figure-of-Merit (FoMw) of 89.28 fJ/conversion-step.},
  keywords={Switches;Capacitors;Parasitic capacitance;Consumer electronics;Energy consumption;Codes;Linearity;Energy efficiency;Power demand;Training;Successive-approximation-register;analog-to-digital converter;dual-capacitor merger-and-split switching scheme;noise-shaping;energy efficiency},
  doi={10.1109/TCE.2025.3559687},
  ISSN={1558-4127},
  month={Feb},}@ARTICLE{10962546,
  author={Tang, Yutian and Luo, Xiapu and Zhou, Yuming},
  journal={IEEE Transactions on Software Engineering}, 
  title={A Systematic Study on Real-World Android App Bundles}, 
  year={2025},
  volume={51},
  number={5},
  pages={1615-1628},
  abstract={Android app developers currently mainly attempt to merge all functions into one app to fit different types of devices. However, this “one-size-fits-all” strategy can introduce various problems to both developers and end-users, such as slower download speed, and a larger attack surface. To resolve this issue, Google promotes the App Bundle framework and requires all new apps must adopt this framework after August 2021. The app bundle framework allows developers to organize their apps in modules. As a new framework, building an app bundle can be time-consuming and error-prone for developers. To fill this gap, in this paper, we discuss how developers build app bundles in practice. By investing in over 200,000 apps from Google Play, we find that 30% of apps have already adopted app bundles. The adoption ratio of large-size apps is even higher than 90%. We also find hands-on programming practices for building feature modules and dynamic assets in app bundles. This study also finds 12 common design practices, which assist developers in building app bundles.},
  keywords={Internet;Static analysis;Feature extraction;Buildings;Instruments;Training;Target tracking;Source coding;Software;Runtime;Android app bundle;android apps;empirical software engineering},
  doi={10.1109/TSE.2025.3560026},
  ISSN={1939-3520},
  month={May},}@INPROCEEDINGS{11443836,
  author={Parikh, Dhruv and Arockiaraj, Jebacyril and Prasanna, Viktor},
  booktitle={2025 59th Asilomar Conference on Signals, Systems, and Computers}, 
  title={Primitive-Driven Acceleration of Hyperdimensional Computing for Real-Time Image Classification}, 
  year={2025},
  volume={},
  number={},
  pages={1557-1563},
  abstract={Hyperdimensional Computing (HDC) represents data using extremely high-dimensional, low-precision vectors— termed hypervectors (HVs)—and performs learning and inference through lightweight, noise-tolerant operations. However, the high dimensionality, sparsity, and repeated data movement involved in HDC make these computations difficult to accelerate efficiently on conventional processors. As a result, executing core HDC operations—binding, permutation, bundling, and similarity search—on CPUs or GPUs often leads to suboptimal utilization, memory bottlenecks, and limits on real-time performance.In this paper, our contributions are two-fold. First, we develop an image-encoding algorithm that, similar in spirit to convolutional neural networks, maps local image patches to hypervectors enriched with spatial information. These patch-level hypervectors are then merged into a global representation using the fundamental HDC operations, enabling spatially sensitive and robust image encoding. This encoder achieves 95.67% accuracy on MNIST and 85.14% on Fashion-MNIST, outperforming prior HDC-based image encoders. Second, we design an end-to-end accelerator that implements these compute operations on an FPGA through a pipelined architecture that exploits parallelism both across the hypervector dimensionality and across the set of image patches. Our Alveo U280 implementation delivers 0.09ms inference latency, achieving up to 1300× and 60× speedup over state-of-the-art CPU and GPU baselines, respectively.},
  keywords={Image coding;Accuracy;Graphics processing units;Computer architecture;Parallel processing;Real-time systems;Inference algorithms;Central Processing Unit;Field programmable gate arrays;Image classification;Hyperdimensional Computing;Hypervectors;FPGA Acceleration;Image Classification;Real-Time Systems;Patch-Based Encoding;Parallel Processing;Low-Power Computing},
  doi={10.1109/IEEECONF67917.2025.11443836},
  ISSN={2576-2303},
  month={Oct},}@ARTICLE{11345580,
  author={Cui, Ziqiang and Xu, Jianze and Wang, Huaxiang},
  journal={IEEE Transactions on Instrumentation and Measurement}, 
  title={Design and Implementation of Electrical Resistance Tomography System Based on Zynq Heterogeneous System}, 
  year={2026},
  volume={75},
  number={},
  pages={1-11},
  abstract={For decades, the performance of data acquisition systems in electrical resistance tomography (ERT) technology has steadily improved. These have evolved from early data acquisition systems based on digital signal processors (DSPs) to current systems based on field programmable gate arrays (FPGAs). Due to the difficulty of flexibly and conveniently implementing complex communication protocols on FPGAs, the combination of FPGAs and DSP merged as the mainstream design. Recently, some heterogeneous platforms have attracted attention. These platforms integrate microprocessors with FPGAs, utilizing the microprocessors to implement complex communication protocol stacks and the FPGAs for highly parallel tasks. This article presents an approach to developing tomographic systems by using the Zynq heterogeneous platform and Python. The Zynq platform combines the capabilities of a dual-core ARM Cortex-A9 processor and FPGA fabric, serving as the control unit for the ERT system. The implementation of the PYNQ framework on the Zynq platform enables the use of Python to achieve the necessary functions, such as logic control, impedance measurement, and online image reconstruction and visualization. In addition, the hardware acceleration of image reconstruction could be conveniently realized by using a high-level synthesis (HLS) tool, enabling overall performance optimization. With the PYNQ framework, all essential ERT functions, including data acquisition, image reconstruction, and visualization, can be accomplished within a much shorter development cycle. Performance comparisons have been carried out between the integrated PYNQ solution and the so-called “bare-metal and host computer” approach. Test results demonstrated that the integrated PYNQ solution not only fulfills all the functions that could be offered by the bare-metal solution, but also provides great potential in boosting the development cycle and Python productivity. In the experiment, PYNQ achieved color image rendering results similar to those of computer software and a grayscale image refresh rate of 26 frames per second (FPS), even with hardware conditions significantly inferior to a computer.},
  keywords={Field programmable gate arrays;Python;Image reconstruction;Codes;Electrical impedance tomography;Logic;Software;Impedance measurement;Hardware design languages;Linux;Electrical resistance tomography (ERT);field programmable gate arrays (FPGAs);system design;Zynq heterogeneous system},
  doi={10.1109/TIM.2026.3652697},
  ISSN={1557-9662},
  month={},}@INPROCEEDINGS{9902438,
  author={Gao, Tianshi and Deng, Bin and Wang, Jixuan and Wang, Jiang and Yi, Guosheng},
  booktitle={2022 41st Chinese Control Conference (CCC)}, 
  title={Pedestrian Identification Based on Spatio-temporal Feature of Plantar Pressure}, 
  year={2022},
  volume={},
  number={},
  pages={6444-6451},
  abstract={Gait is an important biometric feature to identify individuals, which has a wide range of needs in the fields of anti-terrorism security inspection and criminal investigation. Previous studies have proved that using the platform with pressure sensors to record Ground Reaction Forces (GRF) when pedestrians walk is an effective way to collect gait Spatio-temporal information. However, it is difficult to extract behavior features directly from such high-dimensional Spatio-temporal sequences, which leads to unsatisfying classification accuracy. Here, we propose a dual-channel convolutional neural network based on the Gramian angular field (GAF), which provides an efficient and simple way to recognize Spatio-temporal information and realize the identification of pedestrians' identities. In the proposed method, there are two independent channels composed of convolutional blocks. The input of the first channel is the peak pressure image (PPI) that is used to extract spatial features. By encoding the GRF sequence using the GAF algorithm, the GAF image is obtained as the input of the second channel and used for the temporal features extraction of the walking pattern of individuals. Then, the spatial and temporal features are merged and used for pedestrian identification by a fully connected network. An adaptive optimizer is used to train the dual-channel network model. In a classification task for 33 pedestrians, the recognition rate of the proposed method achieves 98%. Compared with the models only using spatial features, the accuracy of recognition of the proposed method is significantly improved. The results indicate that the recognition of pedestrians is well realized through the hierarchical extraction and fusion of Spatio-temporal features by a dual-channel model.},
  keywords={Pressure sensors;Legged locomotion;Adaptation models;Image coding;Biometrics (access control);Inspection;Feature extraction;Gait recognition;convolutional neural networks;Gramian angular field;Plantar pressure},
  doi={10.23919/CCC55666.2022.9902438},
  ISSN={1934-1768},
  month={July},}@ARTICLE{11145143,
  author={Bez Rocha, Lucas and Sant’Ana, Jean Michel De Souza and Asad Ullah, Muhammad and Montejo-Sánchez, Samuel and Luiz Rebelatto, João and Souza, Richard Demo},
  journal={IEEE Open Journal of the Communications Society}, 
  title={Toward Improving the Scalability of LR-FHSS: Transmission Policies and Performance Analysis}, 
  year={2025},
  volume={6},
  number={},
  pages={7075-7090},
  abstract={Low power wide area networks (LPWANs) have revolutionized IoT connectivity by enabling long-range communication with low cost end devices and minimal power consumption. LoRaWAN is the prominent LPWAN technology, while long range-frequency hopping spread spectrum (LR-FHSS) is a newly introduced modulation scheme within the LoRaWAN framework designed to offer improved scalability than the conventional LoRa modulation. There remains a need for research to mature the technology further. Particularly, in massive networks, ensuring reliability remains a challenge. This study examines three message transmission techniques, concatenation, embedded retransmission, and replication, in LR-FHSS networks under different traffic loads, using both theoretical and simulation-based approaches, while measuring success probability, delay, and energy consumption. Concatenation merges multiple messages into a single payload, reducing the number of transmissions, packet overhead, and alleviating network congestion. However, it increases latency, making it more suitable for delay-tolerant applications. Embedded retransmission attaches copies of previous messages to subsequent packets, balancing reliability and delay, and performing well in low to moderate-density networks. Replication, which involves transmitting independent copies of the same packet, enhances reliability but can contribute to network congestion, limiting its effectiveness in high-density environments. Overall, the results indicate that concatenation offers a clear advantage over the other investigated techniques in the analyzed scenarios, while achieving up to 44% higher message success probability compared to regular LR-FHSS at 50,000 end devices.},
  keywords={Payloads;Scalability;LoRaWAN;Reliability;Low-power wide area networks;Internet of Things;Uplink;Codes;Physical layer;Interference;Internet-of-Things;LPWAN;LR-FHSS;scalability;transmission policies},
  doi={10.1109/OJCOMS.2025.3604277},
  ISSN={2644-125X},
  month={},}@INPROCEEDINGS{11420522,
  author={Fu, Desheng and Jiang, Jingbo and Wang, Xiaomeng and Zhu, Jingyang and Chen, Xizi and Tsui, Chi-Ying},
  booktitle={2026 31st Asia and South Pacific Design Automation Conference (ASP-DAC)}, 
  title={Exploiting the Irregular Input Sparsity in Systolic Array-based DNN Accelerators via Local Soft Pooling}, 
  year={2026},
  volume={},
  number={},
  pages={1315-1321},
  abstract={One promising approach to mitigating the computational complexity of deep neural networks is to leverage the sparsity of input activations that results from the application of the ReLU function. However, the irregular distribution of zero-valued inputs poses a challenge for efficient implementation in existing regular architectures, such as systolic arrays. Previous works usually depend on specialized architectures to bypass the redundant computations during runtime. In contrast to these prior strategies, we propose a local soft pooling method to efficiently exploit the irregular input sparsity in systolic array-based architectures. Through local soft pooling, adjacent input rows can be safely merged at runtime, compressing the sparse input matrix into a compact format that is only 1/3 to 1/2 of its original size. The compact matrix can then be directly fed into the systolic array for computation. A computation saving of 67.78% is achieved across various networks on both CIFAR-10 and ImageNet with negligible accuracy loss. As a result, the throughput and energy efficiency are improved by 2.72 and 2.07 times, respectively.},
  keywords={Runtime;Image coding;Design automation;Computer architecture;Artificial neural networks;Throughput;Systolic arrays;Energy efficiency;Sparse matrices;Computational complexity;Neural network;sparsity;systolic array},
  doi={10.1109/ASP-DAC66049.2026.11420522},
  ISSN={2153-697X},
  month={Jan},}@INPROCEEDINGS{8713651,
  author={el Shehaby, Mohamed and Youssef, Sherin and Fayed, Salema},
  booktitle={2019 International Conference on Communications, Signal Processing, and their Applications (ICCSPA)}, 
  title={An Efficient Multi-View Panoramic Imaging and Extra Compression of Surveillance Cameras’ Footage Using Stitching}, 
  year={2019},
  volume={},
  number={},
  pages={1-8},
  abstract={Saving data stored and transferred is a critical topic in modern era, especially after the evolution in the numbers of surveillance cameras in the world. So an extra level of compression is needed to contribute in solving the problem of the huge data produced by those cameras. The proposed system: “An Efficient multi-view panoramic imaging and Extra Compression of surveillance cameras' footage using Stitching” (ECS) aims to contribute in the solution of this problem by merging feature extraction stitching techniques with geometric relational matrix calculations. ECS creates a new real-time efficient stitching algorithm to minimize the sending and storing of the redundant pixels between the footage of the surveillance cameras. The limitations of using stitching on video footage and not on still images is due to the high complexities of stitching algorithms; the proposed system, in this paper, uses the projective affine transformation matrix between images of camera footage to reduce this limitations. The work presented in this paper introduces, for the first time, an algorithm to reconstruct images of each camera from the panoramic view. The experimental work of this research tests multiple feature extraction algorithms for stitching; Scale Invariant Feature Transform (SIFT), Speed Up Robust Feature (SURF) and Oriented FAST and Rotated BRIEF (ORB) with different order of stitching, and the amount of compression per image after reconstruction is analyzed. Moreover, the panoramic view is mostly a better monitoring option rather than multiple monitors in complex surveillance cameras' control rooms. Experimental results show that the proposed method could be faster than other state-of-the-art image stitching methods and accurate panoramic image. The system also gives a better visual effect in a large view panorama due to the high speed real time stitching introduced in this paper.},
  keywords={Cameras;Image coding;Feature extraction;Surveillance;Real-time systems;Image reconstruction;Surveillance Camera;Compression;Stitching;Reconstruction;Projective Transformation Matrix;Homography},
  doi={10.1109/ICCSPA.2019.8713651},
  ISSN={},
  month={March},}@INPROCEEDINGS{8988400,
  author={Kumar, B. P. Santosh and Ramanaiah, K. Venkata},
  booktitle={2019 5th International Conference on Signal Processing, Computing and Control (ISPCC)}, 
  title={An Algorithmic Analysis on Optimized Image Compression Model}, 
  year={2019},
  volume={},
  number={},
  pages={235-242},
  abstract={“Image compression is the process of reducing the size of the image without deteriorating the image quality to an intolerable level”. The minimization of file size permits more storage in a given memory space. However, to develop the quality of the images during compression, this paper intends to present an enhanced image compression model, which is dependent on hybrid optimization algorithm by merging Lion Algorithm (LA) and Jaya Algorithm (JA). Here, the input image that has to be compressed is subjected to segmentation using Adaptive Active Contour Model (ACM) that split the image into Region of Interest (ROI) and non-ROI regions. Further, the ROI regions are compressed using JPEG-LS scheme and non-ROI regions are compressed by means of wavelet-oriented lossy compression scheme. After compression process, the decompression of the image is carried out by performing the reverse process of compression. Here, the adaptiveness of the presented scheme is influenced with the aid of proposed Jaya based Cubpool Formation in LA (JCF-LA). In addition, an algorithmic analysis is done for the adopted JCF-LA-based compression model to analyze its performance.},
  keywords={Adaptation models;Analytical models;Image segmentation;Image coding;Computational modeling;Measurement uncertainty;Signal processing algorithms;Signal processing;Wavelet analysis;Active contours;Image compression;Adaptive Active Contour Model-based Segmentation;JPEG-LS;Wavelet-based lossy compression;Algorithmic Analysis},
