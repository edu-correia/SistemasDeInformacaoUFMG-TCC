  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={GCFC: Graph Convolutional Fusion CNN Network for Cross-Domain Zero-Shot Extraction of Winter Wheat Map}, 
  year={2024},
  volume={17},
  number={},
  pages={9069-9089},
  abstract={Accurate extraction of winter wheat and its planted area holds significance for agricultural research and government real-time food monitoring. Traditional machine learning methods often demand extensive data and corresponding labels for training in cross-domain classification problems. The heterogeneity of land cover types causes an uneven distribution of samples, leading to unsatisfactory results when these methods are applied directly to other regions. This article introduces a two-branch Graph Convolutional Fusion CNN network incorporating dynamic weighted stratified loss to address these challenges. To reduce the weight of losses generated by easily classified pixels, this loss function adds task masks and category dynamic weights to the cross-entropy loss. Dual branching merges global insights from graph convolutional networks with local emphasis from convolutional neural networks. It enhances the handling of cross-domain classification problems. The first branch introduces an adaptive mechanism and applies it to the graph's adjacency matrix to enhance the model's adaptability to different domain graph structures. The second branch alleviates the oversmoothing problem of edge clustering caused by graph convolution and handles multiscale and spectral information more efficiently. The experimental results showed that the proposed method achieved 99.98% accuracy and good classification results on the Zhoukou dataset. The zero-shot cross-domain prediction on the Suixian dataset achieved 96.11% accuracy. Ultimately, the entire winter wheat planting area of Shangqiu City was extracted with an accuracy of 91.92%. Numerous experiments and practical applications confirm that the proposed method is feasible and effective for winter wheat cross-domain extraction.},
  keywords={Feature extraction;Remote sensing;Task analysis;Image edge detection;Data mining;Convolutional neural networks;Transfer learning;Cross-domain;graph convolution;oversmoothing;winter wheat},
  doi={10.1109/JSTARS.2024.3392448},
  ISSN={2151-1535},
  month={},}@ARTICLE{8812901,
  author={Shamloo, Hassan and Nazari, Atefeh and Faez, Rahim and Haji-Nasiri, Saeed},
  journal={IEEE Transactions on Nanotechnology}, 
  title={A Functional Study of a Bilayer Graphene Nanoribbon FET With Four Different Gate Insulators}, 
  year={2019},
  volume={18},
  number={},
  pages={890-895},
  abstract={Bilayer graphene like monolayer graphene has a zero bandgap. To use as a channel material of FETs, its band gap should be open which is crucial for its application in logic circuits. Several methods have been developed to open the band gap in graphene. The simple way is cutting graphene into ribbons. In this paper, a novel structure for a dual-gated bilayer graphene nanoribbon field-effect transistor (BLGNRFET) is suggested, which merges the advantages of high and low dielectric constants. The gate insulator of FET is divided into four parts with different dielectric materials, so the proposed device is called FDI-BLGNRFET. All of the possible state of gate insulators which can happen for these four different parts are surveyed. The simulations are conducted by means of the self-consistent solution of the Poisson and Schrödinger equations within the NonEquilibrium Green Function (NEGF) and a tightbinding Hamiltonian, in the real space approach. Regarding to the results, for the proposed FDI-BLGNRFET with K1 = K2 = 25 and K3 = K4 = 3.9, the maximum ION/IOF F ratio 119% higher than the conventional BLGNRFET is achieved which is still remains inadequate for getting an acceptable (ION/IOF F ) ratio in CMOS performance.},
  keywords={Logic gates;Insulators;Graphene;Dielectric constant;Mathematical model;Field effect transistors;Bilayer Graphene Nanoribbon;FET;NEGF;Real Space Approach;Tight-Binding;Thermionic Emission;Gate Insulator;Band-to-Band Tunneling},
  doi={10.1109/TNANO.2019.2936521},
  ISSN={1941-0085},
  month={},}@ARTICLE{11127079,
  author={Tian, Yanbing and Cao, Huidong and Liu, Yanli and Tian, Cewen and Wang, Ruihua},
  journal={IEEE Transactions on Geoscience and Remote Sensing}, 
  title={WB-Former: A Hybrid Model of CNN and Transformer for Water Body Extraction in Complex Scenes}, 
  year={2025},
  volume={63},
  number={},
  pages={1-18},
  abstract={Extracting small, narrow, or irregularly shaped water bodies from high-resolution remote sensing images is challenging. We introduce a novel framework that merges convolutional neural networks (CNNs) with Vision Transformers (ViTs) to extract complex-shaped water bodies. Extract data from the encoder and decoder, and integrate the ViT into the final downsampling layer to handle long-range dependencies. To better extract boundary information, we designed a boundary-aware edge enhancement module with a dedicated edge attention mechanism. Next, we developed an adaptive information enhancement module (AIEM). To handle complex data flows, we introduced a redundancy attenuation module. Furthermore, by using external outputs to generate queries for the ViT, we integrated features from different network levels, enabling it to fuse both local and global contextual information. Finally, we proposed a novel loss function that incorporates Rolle’s theorem and adaptive distance, making the smoothness constraint more flexible and enhancing sensitivity to object boundaries, thereby effectively improving segmentation accuracy in boundary regions. Extensive experiments on the WD_dataset, Wuhan High-resolution Dense-Labeling Dataset (WHDLD), and Sentinel-2 datasets demonstrate that our model outperforms existing state-of-the-art methods, including those based on CNN and Transformer architectures. Extensive experiments on the WD_dataset, WHDLD, and Sentinel-2 datasets demonstrate that our model outperforms existing state-of-the-art methods, including those based on CNN and Transformer architectures. Specifically, WB-Former achieves a 3% improvement in intersection over union (IoU) and a 1% increase in average precision over the WaterDeep model on the WHDLD dataset. On the WD_dataset, it shows a 7% improvement in IoU and a 3% increase in average precision. On the Sentinel-2 dataset, it achieves a 6% improvement in IoU and a 3% increase in average precision.},
  keywords={Feature extraction;Transformers;Remote sensing;Convolution;Accuracy;Deep learning;Data mining;Convolutional neural networks;Adaptation models;Image edge detection;Convolutional neural network (CNN);deep learning;semantic segmentation;Transformer;WB-Former},
  doi={10.1109/TGRS.2025.3599510},
  ISSN={1558-0644},
  month={},}@ARTICLE{11345467,
  author={Anuranjani, Priya and Singh, Vishal and Giri, Pushpa and Varshney, Gaurav},
  journal={IEEE Transactions on Plasma Science}, 
  title={Thermally Electrically Controlled and Brewster Operated Broadband/Multiband Ultrathin Metal-Free THz Absorber}, 
  year={2026},
  volume={54},
  number={2},
  pages={759-765},
  abstract={The hybrid resonator of graphene and phase change material, vanadium dioxide (VO2), can provide a controllable electric-wall boundary for obtaining the multicontrolled resonances in a terahertz (THz) absorber. In the metallic phase, the electric wall-boundary is established through the VO2 resonator, which provides multiple resonances with a merged spectrum resulting in a broad absorption band. In the insulating phase, the VO2 layer acts as an impedance match layer, and an electric wall boundary is established through a graphene sheet. A large area graphene sheet can provide multiple plasmonic resonances with a narrow and separated spectrum depending on its Fermi energy. Thus, multiple electrically controlled narrow absorption bands are obtained. The resonance intensity of graphene can also be controlled through the angle of incidence through Brewster’s effect for a particular polarization of the incident wave. The proposed absorber can provide a way to implement an ultrathin structure of metal-free geometry which can be utilized in THz electromagnetic (EM) shielding and sensing applications.},
  keywords={Graphene;Absorption;Terahertz communications;Geometry;Graphite;Dielectrics;Conductivity;Sensors;Resonant frequency;Plasma temperature;Absorber;broadband;metal-free;narrowband;refractive index sensing;shielding effectiveness (SE);tunability;ultrathin},
  doi={10.1109/TPS.2025.3644226},
  ISSN={1939-9375},
  month={Feb},}@INPROCEEDINGS{9971179,
  author={Fahmy, Ghazal A. and Abd-Elrahman, Emad and Zorkany, M.},
  booktitle={2022 39th National Radio Science Conference (NRSC)}, 
  title={COVID-19 Detection Using Multimodal and Multi-model Ensemble Based Deep Learning Technique}, 
  year={2022},
  volume={1},
  number={},
  pages={241-253},
  abstract={COVID-19 is a fatal disease that threatens the people’s health worldwide in the last few years. Although the testing techniques for COVID-19 had become more widespread, they still lack the speed and accuracy of disease pattern detection. Thanks to Artificial Intelligence (AI) as it can accelerate the detection process by deep learning techniques that can be used to achieve high performance in COVID-19 identification. Many types of Convolutional Neural Networks (CNN) as the most image classification deep learning techniques are used for automatically diagnosing this disease using X-ray or Computerized Tomography (CT-scan) medical images. The individual CNN types can obtain good results with a specific type of images like X-ray or CT-scan images in a certain dataset but, it could not give the same quality for other types of images or datasets. Through this paper, multiple standards model and custom CNN model have been merged using ensemble method to enhance the overall performance, while the accuracy of each model is a parameter in majority voting. Consequently, the proposed method will started with an initial simple classifier to classify between X-ray image and CT-image then followed by the ensemble model, and lasted by the decision making algorithm. Using different image types like X-ray and CT-scan images from different dataset sources enhance the overall performance as will be cleared in our results. The proposed model has three main parts: Multimodal imaging data, Multi-model based CNN structure, and decision-making diffusion based on the Multi-model output part. The main objective of using multiple models or multiple algorithms in detecting COVID-19 is to decrease the error percentage and increase the validation accuracy. Testing and validation results assure that the performance of the proposed method for COVID-19 chest X-rays and CT-scan images outperforms the individual and classical CNN learners’ design.},
  keywords={COVID-19;Deep learning;Decision making;Convolutional neural networks;Artificial intelligence;X-ray imaging;Standards;Artificial Intelligence (AI);Deep Learning;Convolutional Neural Networks (CNN);COVID-19},
  doi={10.1109/NRSC57219.2022.9971179},
  ISSN={},
  month={Nov},}@ARTICLE{9261111,
  author={Hohn, Fabian and Nordström, Lars},
  journal={IEEE Transactions on Power Delivery}, 
  title={Integrating Signals With High Sampling Rates for Transmission Line Protection in Digital Substations}, 
  year={2021},
  volume={36},
  number={6},
  pages={3299-3308},
  abstract={Travelling wave based protection functions require significantly higher sampling rates than protection functions based on time-domain superimposed quantities or fundamental frequency phasors. Integrating these high sampling rates in digital substations leads to a significant increase of the communication load of process-level networks and causes high computational cost for centralized protection systems. This paper builds on a distributed signal processing approach, which allocates the filtering operations among standalone merging units (SAMU). In particular, the paper presents a decimation filter design to integrate signals with high sampling rates at the process-level. Thereby, signal sequences with high, medium and low sampling rates are provided according to the requirements of the respective protection function. The decimation filter structure is optimized with respect to time delay by the Remez exchange algorithm and with respect to computational cost by a multistage approach and a sparse filter design algorithm. In addition, the filter response is verified against the accuracy constraints defined in IEC 61869-6 and IEC 61869-13. The paper shows that it is feasible to distribute the filtering operations among SAMUs, while keeping the time delay below the maximum allowable processing delay of 2 ms.},
  keywords={Substations;Delay effects;Computational efficiency;IEC Standards;Delays;Time-frequency analysis;Time-domain analysis;Computational cost;delay estimation;field programmable gate arrays;finite impulse response filters;power system protection;signal analysis;substation automation},
  doi={10.1109/TPWRD.2020.3038258},
  ISSN={1937-4208},
  month={Dec},}@INPROCEEDINGS{11092964,
