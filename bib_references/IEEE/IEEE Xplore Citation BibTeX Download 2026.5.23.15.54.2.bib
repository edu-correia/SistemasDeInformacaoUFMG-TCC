  title={An Evolutionary Clustering Algorithm Based on Adaptive Fuzzy Weighted Sum Validity Function}, 
  year={2010},
  volume={2},
  number={},
  pages={357-361},
  abstract={In this paper, we propose a novel objective function called the adaptive Fuzzy Weighted Sum Validity Function(FWSVF), which is a merged weight of the several fuzzy cluster validity functions, including XB, PE, PC and PBMF. The improved validity function is more efficient than others. Furthermore, we present a Mixed Strategy Evolutionary Clustering Algorithm based adaptive validity function(AMSECA), which is merged from Evolutionary Algorithm along with Mixed Strategy and Fuzzy C-means Algorithm. Moreover, in the experiments, we show the effectiveness of AMSECA, AMSECA could find the proper number of clusters automatically as well as appropriate partitions of the data set and avoid local optima.},
  keywords={Clustering algorithms;Partitioning algorithms;Iterative algorithms;Clustering methods;Genetic programming;Evolutionary computation;Functional programming;Computer science;Optimization methods;Genetic algorithms;fuzzy C-means algorithm;evolutionary algorithm;the adaptive fuzzy weighted sum validity function;evolutionary clustering algorithm},
