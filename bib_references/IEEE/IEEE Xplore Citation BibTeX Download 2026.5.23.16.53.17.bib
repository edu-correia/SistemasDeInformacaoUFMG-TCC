  number={},
  pages={213-218},
  abstract={Accurate product price prediction is a crucial challenge in modern e-commerce, where visual aesthetics, textual descriptions, and categorical attributes together influence perceived value. This work presents a dual architecture multimodal deep learning model that combines these features for robust and interpretable price regression. Two approaches were designed and compared: an attention-based Functional API model using EfficientNetB3 for visual features, pre-trained GloVe embeddings with Bi-LSTM for text, and trainable categorical embeddings; and a lightweight Sequential API model with a simpler convolutional network and dense layers to merge features. The same preprocessed dataset was used to train both models, which ensured that given data quality and balanced category representation were kept, and splits were stratified. The Functional API model emphasizes late fusion, combining modality-specific embeddings for stronger semantic alignment and higher predictive power. In contrast, the Sequential API emphasizes computational efficiency, offering a low-latency option for resource-limited settings. Evaluation used Mean Absolute Error (MAE), Root Mean Squared Error (RMSE), and $\mathbf{R}^{\mathbf{2}}$ on the original price scale. The Functional API (MAE 5.46, RMSE 7.58, $\mathrm{R}^{2} \mathbf{0. 6 8}$) has outperformed the Sequential API (MAE 6.78, RMSE 9.08, $\mathrm{R}^{2} 0.55$), but at the cost of training time and memory usage. There are, however, other things to consider instead of accuracy, such as ethical concerns of transparency, fairness, reproducibility, etc., and economic trade-offs between accuracy and deployment cost. With the integration of both, these two models create a basis for benchmarking multimodal retail price prediction on grounds of performance and feasibility.},
  keywords={Modeling;Pricing;Application programming interfaces;Training;Printing;Timing;Visualization;Accuracy;Architecture;Computer architecture;Multimodal deep learning;retail price prediction;functional api;sequential api;efficientnetb3;glove embeddings;bi-lstm;late fusion;computational efficiency;interpretability;transparency;reproducibility},
  doi={10.1109/SPICSCON69221.2025.11504160},
  ISSN={},
  month={Nov},}@ARTICLE{11162687,
  author={Confalonieri, Federica and Colombo, Alessandro and Mansoori, Amirfereydoon and Travagliati, Marco and Baldasarre, Leonardo},
  journal={IEEE Sensors Letters}, 
  title={A CMOS Integrated PZT Piezoelectric Micromachined Ultrasound Transducer (PMUT) With Large Bandwidth}, 
  year={2025},
  volume={9},
  number={10},
  pages={1-4},
  abstract={Conventional piezoelectric micromachined ultrasound transducers (PMUTs) operating at the fundamental flexural mode of a single square or circular membrane are typically limited by their inherently narrow bandwidth for use in imaging applications. Moreover, the integration of PMUTs based on lead zirconate titanate (PZT) with complementary metal-oxide-semiconductor (CMOS) technology has yet to be demonstrated. This article presents the design and characterization of a large bandwidth PZT PMUT bonded to a CMOS die utilizing a eutectic bonding process. Large bandwidth response is achieved at the single PMUT level by combining six rectangular membranes of different aspect ratios designed such that their resonant modes merge when the PMUT is coupled to a low acoustic impedance material such as polydimethylsiloxane or it is immersed in a liquid. The fabricated PMUT was characterized by electrical impedance measurements in air revealing the membrane modes and pulse-echo experiment in liquid demonstrating the large bandwidth frequency response. The characterized frequency response displays a center frequency of 3.11 MHz and a 65% fractional bandwidth appropriate for many imaging applications.},
  keywords={Bandwidth;Biomembranes;Impedance;Electrodes;Sensitivity;Ultrasonic imaging;Lead zirconate titanate;Transducers;Surface impedance;Finite element analysis;Mechanical sensors;bandwidth;microelectro-mechanical-system (MEMS);piezoelectric micromachined ultrasound transducers (PMUT);ultrasound device},
  doi={10.1109/LSENS.2025.3609660},
  ISSN={2475-1472},
  month={Oct},}@INPROCEEDINGS{9672963,
  author={Trolle, J. and Raudberget, D. and Rösiö, C.},
  booktitle={2021 IEEE International Conference on Industrial Engineering and Engineering Management (IEEM)}, 
  title={Exploring Barriers for Software Development in Agile and Integrated Development of Production Systems}, 
  year={2021},
  volume={},
  number={},
  pages={639-643},
  abstract={The amount of software elements that need to be considered and developed for products and production systems require a closer and more agile collaboration between organizational functions and departments since the interface is becoming increasingly merged. Previous research has identified the advantages of closer integration between various functions but has not yet investigated the barriers that emerge within software development for production systems. This paper aims to explain the way of working in agile and integrated production system development by exploring these barriers through a case study within a manufacturing company. The findings identify barriers related to both technological, work-cultural, and organizational aspects.},
  keywords={Agile manufacturing;Industries;Production systems;Conferences;Companies;Industrial engineering;Market research;Agile project;Changeability;Integrated product and production development;Manufacturing;Reconfigurability},
  doi={10.1109/IEEM50564.2021.9672963},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10252447,
  author={Cocco, Gabriel M. and Bisogno, Fábio E. and De Camargo, Robinson F. and Woldu, Tahaguas A. and Ziegler, Christian and Wolter, Martin},
  booktitle={2023 IEEE Power & Energy Society General Meeting (PESGM)}, 
  title={Analysis and Control of an Isolated Multi-Source Renewable Microgrid Employing the Multi-Input Split-Source Inverter}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper proposes a standalone microgrid with multiple renewable energy sources employing a three-phase three-leg multi-input split-source inverter (MISSI). The MISSI merges the inversion and boost stages in one single power conversion system and allows the connection of multiple independent sources with reduced number of active switches. In addition, the control strategy ensures regulation of ac voltages, load disturbance rejection and harmonic compensation for the self-excited induction generator (SEIG) based system. From the finite set model predictive control (FS-MPC) strategy, an optimal switching state is defined by minimizing a proper cost function through a system model. Moreover, the integration of three independent PV generation sources and an Electronic Load Controller (ELC) in the microgrid provides flexibility and reliability, enabling power flow management and frequency regulation. Simulation results are presented to demonstrate the operation of the proposed topology and controller performance.},
  keywords={Renewable energy sources;Simulation;Microgrids;Switches;Power system harmonics;Harmonic analysis;Inverters;microgrid;renewable energy;multi-input split-source inverter;model predictive control;distributed power systems},
  doi={10.1109/PESGM52003.2023.10252447},
  ISSN={1944-9933},
  month={July},}@INPROCEEDINGS{10818882,
  author={Dharmarathna, Saminda and Fleuriel, Sean and Zhang, Fengqi and Forese, Andrew and Kim, Leslie and Gokey, Brian and Long, Ernie},
  booktitle={2024 19th International Microsystems, Packaging, Assembly and Circuits Technology Conference (IMPACT)}, 
  title={Advanced Electroplating Processes for IC Substrates - Redistribution Layer and Embedded Trenches}, 
  year={2024},
  volume={},
  number={},
  pages={261-263},
  abstract={The rapid developments in the electronics sector have increasingly merged the worlds of printed circuit boards (PCB) and integrated circuit (IC) substrates/semiconductors. This fusion is anchored by the IC substrate, which forms the critical link between IC chips and PCBs, utilizing a network of conductive copper (Cu) traces and vias for connectivity. The advanced IC substrate market is expected to double to $34 billion by 2028, being propelled by the increasing complexity of electronic devices, driven by advancements in GPUs, AI accelerators, and cloud computing technologies. This growth is further amplified by over $15 billion in investments since 2021, reflecting the sector's dynamic potential and the strategic emphasis on high-density connectivity solutions. IC substrates are at the forefront of the electronics industry's drive towards greater miniaturization, higher yield, and lower costs. The quest for minimizing the distance between Cu traces to achieve maximum substrate utilization underscores the industry's push towards advanced wafer-level technologies with $\leq 2\ \mu \mathrm{m}$ line and space (L/S) with strict uniformity within unit (WIU) and within panel (WIP). The emerging challenges and opportunities presented by scale mismatch and smaller L/S distances necessitate innovations like fan-out panel-level packaging (FOPLP). The development of new plating solutions, focusing on uniformity and planarity, is crucial for overcoming the hurdles in multilayer processing, preventing signal transmission loss, and ensuring the reliability of increasingly complex electronic systems. The integration of cutting-edge additive packages for DC Cu electroplating, emphasizing trench and via filling capabilities, exemplifies the industry's commitment to pushing the boundaries of IC substrate technology, paving the way for the next generation of electronics manufacturing.},
  keywords={Integrated circuits;Electrochemical deposition;Internal stresses;Printed circuits;Plating;Packaging;Copper;Substrates;Consumer electronics;Next generation networking},
