  title={Web Interface Design for the Intelligent Management of a Differential Robot Applied to IoT Systems}, 
  year={2025},
  volume={},
  number={},
  pages={68-73},
  abstract={Human-robot interaction is a core pillar in mobile robotics for efficient and diverse product development. This paper provides an advanced web-based control interface for a differential robot which allows full management and real-time monitoring of its behavior. It operates through an ESP32 microcontroller where both sides communicate with a web client using the WebSocket protocol. There are three operating modes: manual by sliders, autonomous navigation toward distinct (X, Y) coordinates, and a pioneering trajectory-tracking mode that lets the operator generate a path directly on a digital canvas. Also, the user interface has a monitoring panel with real-time information on such things as motor RPM, position, and robot orientation, all supported by dynamic charts. Differential kinematics and sensor fusion enable hardware and software integration by merging encoder-based odometry with an IMU for more precise positioning. The final outcome is a powerful, intuitive, and flexible platform which serves as a solid basis for future applications in autonomous exploration, logistics, and educational environments.},
  keywords={Robot kinematics;Sensor fusion;Real-time systems;Hardware;Software;Routing protocols;Trajectory;Odometry;Robots;Monitoring;Differential robot;web interface;control;monitoring;WebSocket;ESP32;odometry;IMU;sensor fusion},
  doi={10.1109/COMRob68109.2025.11264804},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11039906,
  author={Pandey, Rishi and Tiwari, Sakshi and Singh, Aryan and Pandey, Umesh Kumar},
  booktitle={2024 International Conference on Control, Computing, Communication and Materials (ICCCCM)}, 
  title={Ensembling Naive Bayes and Random Forest for Lung Cancer Prediction}, 
  year={2024},
  volume={},
  number={},
  pages={314-318},
  abstract={This study enhances the precision of lung cancer predictions by introducing an innovative ensemble approach that merges the capabilities of the Naive Bayes and Random Forest algorithms. The foundation of this method is the integration of Random Forest’s exceptional ability to select relevant features and Naive Bayes’ strength in probabilistic predictions. Initially, Random Forest analyzes and ranks the relevance of features within the lung cancer dataset, identifying the most critical indicators of the disease. The Naive Bayes classifier then utilizes these key features to create a probability matrix, significantly improving lung cancer prediction accuracy. This blend aims to address the limitations of each algorithm when used alone, particularly the assumption of feature independence and the challenge of analyzing complex data sets. The performance of this hybrid technique was verified through comprehensive dataset analysis, demonstrating its effectiveness and superiority as a tool for healthcare prediction. Notably, the combined approach achieved a marked increase in predictive accuracy compared to the individual application of each algorithm. The findings reveal that integrating feature selection with probabilistic modeling substantially enhances the detection accuracy of lung cancer.},
  keywords={Technological innovation;Accuracy;Lung cancer;Probabilistic logic;Prediction algorithms;Feature extraction;Naive Bayes methods;Ensemble learning;Medical diagnosis;Random forests},
  doi={10.1109/ICCCCM61016.2024.11039906},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11045591,
  author={Fyntanidis, Theodosios - Konstantinos and Gkanetsos, Theodoros},
  booktitle={2025 18th International Conference on Engineering of Modern Electric Systems (EMES)}, 
  title={Design, Programming, and Construction of an Unmanned Surface Vehicle for Underwater Mine Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={This paper describes the design, development, and construction of an Unmanned Surface Vehicle (USV) aimed at underwater mine detection. The project proposes a solution to the urgent need for safe and efficient demining operations, reducing the risk to human life in hazardous maritime operations. While the USV's performance is entry-level, it merges advanced engineering principles with innovative design, prioritizing affordability and simplicity. The vehicle features a dual-motor propulsion system powered by brushed DC motors, chosen for their reliability and cost-effectiveness. Directional control is achieved through differential motor operation, which removes the necessity for complex rudder systems. The hull and structural elements are 3D-printed, designed to optimize water resistance and maintain a lightweight profile within the limits of current fabrication technology. A metal detection system is integrated into the USV, utilizing its capability to locate submerged metallic mines. This method is significantly more cost effective compared to sonar systems while still remaining effective. The electronics, including an Arduino Uno R3 microcontroller and an L298N motor driver, facilitate precise navigation and remote operation. Two dedicated power supply systems guarantee the continuous operation of both propulsion and detection components. The design and integration of all parts were modeled and validated using SOLIDWORKS, ensuring both structural integrity and operational efficiency. Extensive testing confirmed the USV's capability to detect submerged metallic objects and navigate effectively in controlled environments. This project underscores the potential of unmanned systems to lower the costs and risks associated with demining, while also paving the way for future advancements in autonomous maritime technologies.},
  keywords={Technological innovation;Costs;Metals;Propulsion;Sonar navigation;DC motors;Three-dimensional printing;Autonomous vehicles;Vehicles;Testing;Arduino project;Maritime robotics;Mine detection;Unmanned Surface Vehicle (USV);3D Printing},
  doi={10.1109/EMES65692.2025.11045591},
  ISSN={2836-9866},
  month={May},}@BOOK{11130863,
  author={Ginn, Jeremiah},
  booktitle={Diving into Secure Access Service Edge: A technical leadership guide to achieving success with SASE at market speed},
  year={2022},
  volume={},
  number={},
  pages={},
  abstract={Implement Secure Access Service Edge (SASE) for secure network and application communications, exploring SASE services including SD-WAN, ZTF, and more with expert Jeremiah Ginn who helps CxO leaders achieve SASE successKey FeaturesMerge networking and security services into a single architecture to simplify network infrastructureExplore how zero trust network access (ZTNA) restricts access to provide native application segmentationFocus on a native, multitenant cloud architecture that scales dynamically with demandBook DescriptionThe SASE concept was coined by Gartner after seeing a pattern emerge in cloud and SD-WAN projects where full security integration was needed. The market behavior lately has sparked something like a "space race" for all technology manufacturers and cloud service providers to offer a "SASE" solution. The current training available in the market is minimal and manufacturer-oriented, with new services being released every few weeks. Professional architects and engineers trying to implement SASE need to take a manufacturer-neutral approach. This guide provides a foundation for understanding SASE, but it also has a lasting impact because it not only addresses the problems that existed at the time of publication, but also provides a continual learning approach to successfully lead in a market that evolves every few weeks. Technology teams need a tool that provides a model to keep up with new information as it becomes available and stay ahead of market hype. With this book, you’ll learn about crucial models for SASE success in designing, building, deploying, and supporting operations to ensure the most positive user experience (UX). In addition to SASE, you’ll gain insight into SD-WAN design, DevOps, zero trust, and next-generation technical education methods.What you will learnDevelop a comprehensive understanding of SASE from a market and technical perspectiveUnderstand SASE services and components included in SASE solutionsMove logically from prescriptive design to policy-based design and orchestrationUnderstand standard SASE use cases and how to integrate future componentsConvert from a legacy network design model to a secure DevOps model for future projectsUse a functional design overlay to eliminate inter-service competition for the control plane of the SASE serviceWho this book is forThis book is for technology and security leaders and specifically for any CTO, CSO, CISO, or CIO looking for an executive approach to SASE for their organization. Anyone implementing SD-WAN, SASE, and SASE services for cloud, network, and security infrastructure will also find this book helpful.},
  keywords={},
  doi={},
  ISSN={},
  publisher={Packt Publishing},
  isbn={9781803237534},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/11130863},}@INPROCEEDINGS{11496520,
  author={Saravanan, G. and Siva Magesh, G and Kavin Kumar, T and Arun Kumar, P and Vasathakumar, K},
  booktitle={2026 International Conference on Electronic Systems and Intelligent Computing (ICESIC)}, 
  title={Electromagnetic Design for Secured Nonlinear Robot with Triple Mode and Signal Jamming Using Neural Networks and Multimodal Locomotion}, 
  year={2026},
  volume={},
  number={},
  pages={746-750},
  abstract={To enable the design of a parts-moving robotic system for engineers are designing electromagnetic components to produce sufficient amounts of magnetic force to handle items in a robot while minimizing energy consumption and mechanical constraints. A new model has been developed, referred to as an Electromagnetically Secured Nonlinear Robot with Triple Mode Signal Jamming (ESNRTS). This new model offers a more advanced methodology for safely and securely performing robotic manipulation without having to worry about interference caused by the presence of non-linear fields. One of the key features of this system is that it presents an optimized design of an electromagnetic actuator which ensures stable operation over different weights and distances by using Bulk Robotic Manipulation Robot (BRMR) to make discrete representations of non-linear hydraulic models, thus enabling a control system of higher performance through greater fidelity. The control fidelity of the ESNRTS was enhanced by the integration of two extra layers into a hybrid control architecture that merges a Nonlinear Model Predictive Controller with an Artificial Neural Network (ANN).},
  keywords={Jamming;Electronic warfare;Payloads;Filtering;Location awareness;Wireless Access in Vehicular Environments;Protocols;Mobile communication;HTTP;Data communication;Nonlinear Model Predictive Controller (NMPC);Artificial Neural Network (ANN);Multi-Modal Approaches and Nonlinear Robots;Bulk Robotic Manipulation Robot (BRMR)},
  doi={10.1109/ICESIC67389.2026.11496520},
  ISSN={},
  month={March},}@INPROCEEDINGS{11380273,
  author={G.G.Sreeja and Prasath, M.Guru and Shivani, S.S.Jeiya and M.Kawin and M.Pradeepa},
  booktitle={2025 5th International Conference on Ubiquitous Computing and Intelligent Information Systems (ICUIS)}, 
  title={CryDecode: An AI-based Multimodal System for Interpreting Infant Emotions and Health Needs}, 
  year={2025},
  volume={},
  number={},
  pages={1253-1256},
  abstract={This paper suggests an integrated infant state monitoring system that involves both an image-based model and an audio-based cry classification model with a fusion model that combines their outputs for steady, real-time inference. The audio branch employs time–frequency representations (Mel-Frequency cepstral coefficients, MFCCs, and Mel-Spectrograms) of infant cries to predict four classes (discomfort, hunger, pain, fatigue) using a convolutional neural network. The image branch makes predictions on facial frames and predicts the same states. A late-fusion approach averages probabilities of classes computed from both branches to decide. The models are trained and run in Colab notebooks ('image', 'cry2') and merged in 'full'. We present data preprocessing, model architectures, training procedures, and deployment strategies for real-time deployment. Empirical analysis demonstrates that the integration offers greater stability compared to individual-modality models, projecting the promise of multimodal learning to infant-care solutions.},
  keywords={Training;Pediatrics;Pain;Computational modeling;Surveillance;Ubiquitous computing;Real-time systems;Stability analysis;Convolutional neural networks;Mel frequency cepstral coefficient;Infant cry analysis;Multimodal learning;MFCC;Mel-Spectrogram;Convolutional neural networks;Late fusion;Real-Time surveillance. ensuring the uninterrupted continuity of operations},
  doi={10.1109/ICUIS67429.2025.11380273},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11135550,
  author={Song, Jiashuang and Wu, Yuxi},
  booktitle={2025 International Conference on Mechatronics, Robotics, and Artificial Intelligence (MRAI)}, 
  title={Design of dynamic weighing system based on LabVIEW}, 
  year={2025},
  volume={},
  number={},
  pages={568-571},
  abstract={With the advancement of science and technology, the demands on measurement techniques have become increasingly stringent. Electronic measurement technology has found widespread application across various fields. Traditional electronic measurement instruments, limited by their single-functionality and large size, can no longer meet the diverse and multifunctional requirements of modern measurement tasks. New types of virtual instruments leverage the powerful hardware and software capabilities of computers, integrating computer technology with measurement techniques [1]. This integration merges electronic measurement, computer science, and network technology into an innovative measurement solution. This design combines sensor technology, data acquisition techniques, and virtual instrumentation to develop a dynamic weighing system based on LabVIEW. The system performs data acquisition of measured weights, processes this data in real-time, and displays the results, offering a comprehensive and efficient measurement solution.},
  keywords={Weight measurement;Computers;Instruments;Data acquisition;Measurement techniques;Trend analysis;Big Data;Size measurement;Hardware;Artificial intelligence;virtual instrument;LabVIEW;Dynamic weighing system},
  doi={10.1109/MRAI65197.2025.11135550},
  ISSN={},
  month={June},}@INPROCEEDINGS{10681830,
  author={Zhao, Chuanbin and Lin, Bo and Gao, Feifei},
  booktitle={2024 IEEE/CIC International Conference on Communications in China (ICCC)}, 
  title={Multi-Sensor Fusion Based Environment Reconstruction in Integrated Sensing and Communications}, 
  year={2024},
  volume={},
  number={},
  pages={1116-1120},
  abstract={Integrated sensing and communications (ISAC) has been deemed as a key technology for the sixth generation (6G) wireless communications system. Environment reconstruction, as one of the key technologies of ISAC, enables the deep integration of sensing and communication by providing the environment mapping service. In this paper, we propose a fusion network to merge communications signalling with camera image to increase the accuracy and robustness of environment reconstruction. The simulation results demonstrate that the fusion of communications data and vision data leads to a threefold accuracy improvement over the image only method, especially under challenging weather conditions like rainy and snowy.},
  keywords={Wireless communication;Training;Accuracy;Fuses;Simulation;Reconstruction algorithms;Integrated sensing and communication;ISAC;environment reconstruction;multi-sensor fusion},
  doi={10.1109/ICCC62479.2024.10681830},
  ISSN={2377-8644},
  month={Aug},}@INPROCEEDINGS{11205671,
  author={Hieb, Michael and Lohweg, Volker},
  booktitle={2025 IEEE 30th International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={Optimizing Cyber-Physical Production Systems with Deep Learning and Information Fusion}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The integration of deep learning and information fusion into Cyber-Physical Production Systems offers significant opportunities to increase manufacturing efficiency, enable real-time root cause analysis, improve process monitoring, and support quality prediction. This work-in-progress publication explores a novel approach that combines deep learning for image-based quality inspection with multi-source information fusion to optimize complex manufacturing processes, with a particular focus on injection molding. Traditionally, automated visual inspection systems and industrial condition monitoring are not self-adaptive and are operated in data silos, requiring continuous intervention and parameterization by industrial engineers - often based on expert intuition rather than empirical data. This reliance on expert knowledge limits scalability and responsiveness to process variations. By merging industrial computer vision techniques with heterogeneous sensors and information data, a robust hybrid information fusion framework is proposed. This approach enables Cyber-Physical Production Systems to correlate visual defect classification with underlying process parameters, facilitating autonomous learning from increasing amounts of production data. As a result, Cyber-Physical Production Systems can dynamically adapt without manual input, leading to improved process stability and product quality. Initial proposals in this publication highlight the potential of this method to deliver practical, AI-driven improvements for industrial environments, underscoring the transformative value of intelligent and data-centric manufacturing systems.},
  keywords={Deep learning;Visualization;Computer vision;Root cause analysis;Scalability;Inspection;Injection molding;Sensor fusion;Stability analysis;Sensors;Cyber-Physical Production Systems;Information Fusion;Computer Vision;Deep Learning;Injection Molding},
  doi={10.1109/ETFA65518.2025.11205671},
  ISSN={1946-0759},
  month={Sep.},}@INPROCEEDINGS{11437130,
  author={Sa, Asmitha and S, Avinarasi and L, Sabiksha K and Primya, T. and Kanagaraj, G.},
  booktitle={2026 5th International Conference on Communication, Computing and Electronics Systems (ICCCES)}, 
  title={Intelligent Whatsapp Chatbot for E Commerce and Learning Support}, 
  year={2026},
  volume={},
  number={},
  pages={2192-2197},
  abstract={Conversational AI merged with popular messaging platforms brings easy and real-time assistance to users from various domains. This paper describes a smart WhatsApp chatbot that goes beyond academic assistance to also provide shopping guidance in a single seamless interaction. The system incorporates Twilio for WhatsApp messaging, an Express-based backend server, Firebase Firestore for sessions and chat history, SerpAPI for getting product links from e-commerce stores, and Google's Gemini API for generating conversational responses. The system determines user intent through a straightforward keyword-based classifier that distinguishes academic messages from shopping ones. It sends academic questions to Gemini (Gemini-2.5-flash) with a tutor-style prompt. If there are shoppingrelated queries, the bot employs a mixed flow that not only retrieves product links through SerpAPI but also generates user guidance via AI. Additionally, a summarization capability is present through which users can ask for a well-organized report of their previous interactions, which Gemini generates based on their complete chat history saved in Firestore. Replies are sent by the system to the user via the Twilio API. If the message is too long, it is divided into smaller segments for WhatsApp compatibility. The whole arrangement is about ensuring seamless message handling, maintaining the context, and providing assistance in different areas, thus, demonstrating a perfect integration of cloud services and AI models for an interactive WhatsApp-based user aid instrument.},
  keywords={Freeware;Computational modeling;Chatbots;Real-time systems;Telecommunication computing;History;Electronic commerce;Servers;Internet telephony;Context modeling;Conversational AI;WhatsApp Chatbot;Gemini Model;Twilio;Firebase;SerpAPI;E-Commerce;Learning Support;Natural Language Processing;Context-Aware System;Multi-Domain Chatbot},
  doi={10.1109/ICCCES62661.2026.11437130},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11504160,
