  title={Performance Tuning of Queries in Distributed System using Secure Materialized View Approach}, 
  year={2020},
  volume={},
  number={},
  pages={216-218},
  abstract={Data warehouse is technique to collect and process data from heterogenous, distributed repository in distinct manner so that knowledge can extract from it's this information are stored in autonomous system there must be some defined way to access it. To access this information we must consider the time and space complexity as data warehouse include historical data that means data from decades so there must be some efficient way to access it. To enhance query performance different approaches are there like hybrid integration system is one of the alternative where most frequent used data are stored in intermediate table i.e. the space from where distributed system can access data commonly, query optimized techniques, implementation of appropriate data type, minimal time query complexity which indirectly effect to accelerate performance of query. We are focused on materialized view that is the provision where you can store the most recent data which extracted for commonly used query in avg transaction into a specialized space or we say MV table so that later on when query fire it will map with table query and resultant data will be extracted. Ultimately we are trying to reduce access time of query. As rather than going to base table every time it will search in MV table and return to user it reduce the access time of complex operation like merge, join and aggregation.},
  keywords={Data warehouses;Distributed databases;Heuristic algorithms;Data mining;Conferences;Warehousing;Time complexity;Data warehousing;performance of query;materialized view table etc.},
  doi={10.1109/ICSIDEMPC49020.2020.9299642},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11447636,
  author={Badhel, Indrajeet and Ingle, Harshal and Ingle, Sanvi and Ingle, Tushar and Ingole, Kalyani and Gupta, Ishan and Desai, Sharada},
  booktitle={2026 International Conference on Emerging Trends and Innovations in ICT (ICEI)}, 
  title={Automation of Power Management for Electrical Appliances Image Processing}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={A smart solution for home automation and power preservation is presented in this article. All new technologies which merge image control, IoT, and AI were utilized as critical points of research within these papers. This also aims to optimize energy utilization mainly in household and public occupation through activating soul and motion dependent controls of electrical gadgets. Various approaches and technologies, mainly targeting image processing algorithms and motion detection, were used by these new systems in controlling energy appliances. Additionally, human-presence-detection accuracy is being maintained through integration of action recognition and object detection means, as those appliances result in changes in room occupancy and human actions (sitting, standing, or lying). Processes are more efficient with the advent of image processing and make the operations much smoother by detecting any event whatsoever. These technologies are particularly beneficial in settings like classrooms, auditoriums, offices, and homes, where human intervention is minimized, and energy consumption is optimized. By combining various smart automation approaches, the proposed systems offer a cost-effective and scalable solution for modern home automation and power management.},
  keywords={Home appliances;Technological innovation;Home automation;Automation;Accuracy;Image recognition;Power system management;Object detection;Market research;Motion detection;Power management;Image recognition;home automation;Image Processing},
  doi={10.1109/ICEI65890.2026.11447636},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11236242,
  author={Spera, Simone and Santosuosso, Otino Pio and Sepe, Aurelio and Vitiello, Giuliana and Cantone, Andrea Antonio and Brewster, Stephen},
  booktitle={2025 IEEE International Symposium on Mixed and Augmented Reality Adjunct (ISMAR-Adjunct)}, 
  title={cARdefender: a Mixed Reality Game for Vehicle Passengers}, 
  year={2025},
  volume={},
  number={},
  pages={692-695},
  abstract={Mixed Reality is transforming the gaming landscape by merging the real and virtual worlds into immersive, interactive experiences. In this poster, we present cARdefender, a mixed reality game designed specifically for vehicle passengers. The design and development of mixed reality games in this context pose unique challenges, such as creating intuitive interfaces for limited environments, optimizing performance on mobile devices, and minimizing motion sickness. This poster outlines the design and implementation process of cARdefender, focusing on key aspects such as MR technology integration, game mechanics, and interaction design tailored for use inside vehicles. Our work offers insights into the development of MR applications for non-traditional gaming contexts and highlights the potential of MR to enhance the passenger travel experience through fun and engaging interaction.},
  keywords={Performance evaluation;Roads;System performance;Mixed reality;Games;Motion sickness;User experience;Real-time systems;Automobiles;Testing;Mixed Reality;In-car XR;User experience;Artificial Intelligence;Computer Vision},
  doi={10.1109/ISMAR-Adjunct68609.2025.00146},
  ISSN={2771-1110},
  month={Oct},}@INPROCEEDINGS{9885324,
  author={Madankar, Abhishek A. and Kapare, Rashmi and Jadhav, Sagar and Patil, Minal S. and Telrandhe, Shital and Chaudhary, Neha},
  booktitle={2022 3rd International Conference on Electronics and Sustainable Communication Systems (ICESC)}, 
  title={Design of KVM Switch using USB Technology}, 
  year={2022},
  volume={},
  number={},
  pages={211-214},
  abstract={A KVM switch (KVM is the abbreviation for keyboard, video (monitor and mouse) allows a user to control several computers from a single device. It is generally known that the normal switches cannot be connected with laptops and computers, as the KVM switches are originally made for connecting with laptops and computers. It is difficult to connect one or more devices with laptops and computers with the help of the KVM switches. Recent advancement in KVM switch technology is the integration of Universal Serial Bus (USB) items. USB gives PCs true plug-and-play capabilities. USB-ready PCs can be connected to any external de vice without including an inside card or setting up the gear manually. When you plug in a USB-viable gadget, it is recognized by the USB PC. The proposed scaled-down system will plan a USB Hub KVM Switch. This USB innovation permits the KVM change to introduce the console and mouse's supported presence to every appended PC. This gives an extraordinary advantage – every appended PC, PC, Macs, and Suns, can be booted up all the while. It can also be used as a captive to control USB PCs in numerous stage setups. This permits clients to merge control of both inheritance and USB-empowered PCs in a single design.},
  keywords={Computers;Technological innovation;Portable computers;Keyboards;Switches;Universal Serial Bus;Mice;Keyboard Video Mouse (KVM) Switch;Personal Computer (PC);Media Access Control (Macs);Universal Serial Bus (USB) Hub;Plug-and-play},
  doi={10.1109/ICESC54411.2022.9885324},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11147383,
  author={Moore, John D. and Kramer, Mason and Gallant, John and Khatri, Aarav and Elango, Sriram},
  booktitle={2025 IEEE Integrated STEM Education Conference (ISEC)}, 
  title={Creating the Earth SySTEM Observatory: Integrating Spaceborne and Ground-Based Environmental Research}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The Earth SySTEM Observatory introduces an innovative STEM education framework integrating satellite imagery and data with localized environmental investigations, offering students a dual perspective for exploring Earth's interconnected systems. This approach enables students to connect global-scale satellite observations with ground-level measurements, fostering the ability to investigate environmental phenomena from both vantage points. By aligning data from spaceborne platforms with field studies, students can conduct detailed research at the pixel level, creating vertical profiles that provide a comprehensive understanding of environmental processes at specific geo-referenced locations. At the core of this initiative is the Space to Earth: Earth to Space (SEES) Educational Model, which combines real-time satellite data with hands-on investigations in living laboratories. Programs like the GLOBE Program empower students to collect and analyze atmosphere, hydrosphere, and biosphere data in their local environments. This integration encourages students to engage in authentic research, from monitoring air and water quality to examining biodiversity and seasonal changes, while simultaneously analyzing corresponding satellite data to identify larger patterns and trends. This innovative approach is exemplified through the A3Sat Emulator, which brings aerospace science to life by replicating satellite missions in accessible and scalable formats. Students gain experience acquiring, analyzing, and applying satellite data, bridging classroom concepts with real-world applications. This dual perspective equips students to conduct studies that merge satellite imagery with field-based data, providing insights into environmental challenges at both micro and macro scales. By linking satellite technology with ground-based research, the Earth SySTEM Observatory empowers students to conduct comprehensive, systems-thinking investigations, cultivating the next generation of STEM leaders.},
  keywords={Earth;Satellites;Observatories;Atmospheric modeling;Education;Terrestrial atmosphere;Water quality;Market research;Satellite images;STEM;A3Sat;GLOBE;Precollege;Remote Sensing},
  doi={10.1109/ISEC64801.2025.11147383},
  ISSN={2473-7623},
  month={March},}@INPROCEEDINGS{11322475,
  author={Nawito, Moustafa},
  booktitle={2025 37th International Conference on Microelectronics (ICM)}, 
  title={A $\Delta \mathrm{T}$-Triggered Spiking Temperature Sensor for Neuromorphic and Edge Applications}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This work presents a compact, low-power temperature sensor with a native spiking output, suitable for integration in neuromorphic and event-driven systems. Unlike conventional approaches that rely on analog front ends, comparators, or ADCs to digitize temperature, the proposed circuit merges sensing and encoding by directly proposing tunable proportional-to-absolute-temperature (PTAT) sensing. The tunable PTAT voltage is applied to a single adjustable Schmitt trigger, which generates spikes only when the temperature deviates by a programmable threshold $\Delta T$, enabling event-driven operation with minimal static energy overhead. Implemented in a 45 nm CMOS process with a 1 V supply, the design consumes 650 nW of power. Simulated results demonstrate correct spiking across 0° C to 80° C with $\Delta \mathrm{T}$ steps of a few degrees Celsius, while maintaining robustness under process and mismatch variations. The entire system occupies a small footprint of $\text{1 0 0} \mu \mathrm{m}^{\mathrm{2}}$.},
  keywords={Temperature sensors;Neuromorphics;CMOS process;Encoding;Threshold voltage;Robustness;Sensors;Microelectronics;temperature to spike encoding;tunable PTAT sensor;tunable Schmitt trigger;neuromorphic applications;$\Delta T$-Triggered sensor},
  doi={10.1109/ICM66518.2025.11322475},
  ISSN={2159-1679},
  month={Dec},}@INPROCEEDINGS{11382395,
  author={Yang, Hao and Gao, Jianyong and Liu, Shaobo and Xiong, Yipeng and Dong, Rui},
  booktitle={2025 6th International Conference on Artificial Intelligence and Computer Engineering (ICAICE)}, 
  title={An Intelligent Predictive Resource Management Framework for Cloud-Native Systems Based on Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={832-835},
  abstract={As cloud-native architectures gained ubiquity, microservices enhance system flexibility. But because of their distributed nature, they are also confronted with intricate inter-service dependencies. The result is that fault identification is challenging and conventional reactive resource capacity expansion strategies have response lags, compromising operations and maintenance. As a response to such challenges, this paper puts forward an intelligent predictive resource management framework for cloud-native systems using a large oracle model. This architecture amalgamates open source libraries such as OpenTelemetry, Prometheus, and Loki to capture and process three types of observability data consistently: logs, metrics, and tracebacks. A visualization dashboard is also built to offer improved operational visibility. The novelty in this paper relies on adding a predictive autoscaling framework with the use of the LLM. Six scenarios for loading are proposed, merging the LLM with mathematical classification definitions. Based on the integration of text and image information, a bimodal analysis method is employed to intelligently identify load patterns and select the optimal prediction model. Experiments indicate that compared with previous practices, this approach significantly improves prediction accuracy and efficiency in resource utilization, and it provides a new technical means for cloud-native system operation and maintenance.},
  keywords={Measurement;Analytical models;Accuracy;Large language models;Systems operation;Predictive models;Maintenance;Resource management;Observability;Monitoring;Large Language Model;Predictive Auto-scaling;Cloud-Native;Multimodal Learning;Intelligent Resource Management},
  doi={10.1109/ICAICE68195.2025.11382395},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10898595,
  author={Chen, Jintao and Xing, Bowei and Zhang, Kun and Yu, Qian},
  booktitle={2024 International Conference on Advances in Electrical Engineering and Computer Applications (AEECA)}, 
  title={Research on the Detection Method of Small Fastener Defects in Aerial Transmission Lines Based on YOLOV10N}, 
  year={2024},
  volume={},
  number={},
  pages={252-258},
  abstract={To address the challenge of low accuracy in detecting small targets during unmanned aerial vehicle (UAV) aerial transmission line inspection, we propose an enhanced target detection algorithm derived from the You Only Look Once Version 10 Nano (yolov10n) model. Here's a revised version of the algorithm description: Firstly, to enhance the network's adaptability to geometric variations, we introduce the Deformable Convolutional Network (DCN) to replace certain standard convolutions in the CSPDarknet53 backbone and 2-Stage Feature Pyramid Network (C2F). This modification allows the network to better capture deformations in small targets. Secondly, we embed the Shallow Feature Enhancement Module (SFEM) to merge the shallow spatial details from the input features with the deep semantic information from the network's neck section. This integration enriches the representation of small targets. Additionally, we utilize the Global Context Block (GC block) to recalibrate the fused features, effectively suppressing background noise and highlighting the target information. Next, to further boost the model's ability to detect targets at various scales, we incorporate the Advanced Spatial Pyramid Pooling Fast (ASPPF) module. This module enhances the multi-scale feature representation, thereby reducing the missed detection rate, especially for small targets. Finally, we integrate the Similarity-based Attention Module (SimAM) to strengthen the model's feature extraction capabilities. By focusing on salient regions, SimAM helps the model identify small targets more precisely. In summary, this enhanced yolov10n-based algorithm provides robust technical foundations for UAVs to conduct intelligent inspections and fault detection on high-voltage transmission lines, particularly in scenarios involving small targets.},
  keywords={YOLO;Power transmission lines;Semantics;Focusing;High-voltage techniques;Inspection;Feature extraction;Autonomous aerial vehicles;Neck;Standards;transmission line;yolov10n;C2FCIB_DCN;ASPPF;SimAM},
  doi={10.1109/AEECA62331.2024.00052},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11493161,
  author={Pratap, A Raghuvira and Vellanki, Sanjana and Shainy, Shaik Nageen},
  booktitle={2026 International Conference on Emerging Smart Computing and Informatics (ESCI)}, 
  title={UPI CryptoConnect: Unifying Fiat and Crypto for Seamless Digital Payments}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The rapid expansion of digital payment systems in India has been driven by the widespread adoption of the Unified Payments Interface. The system enables people to send and receive money through its ability to process transactions in a quick, secure, and user-friendly manner. The world now sees cryptocurrencies as an additional method of using digital currency because their popularity continues to grow. The two systems now require solutions that will establish connections between traditional currencies like the Indian Rupee and digital currencies.This paper discusses developing a unified platform that enables different types of currency to function together without any interruptions. The system needs to deliver secure payment processing and transparent payment methods while providing efficient payment processing and multiple payment options for users. The paper uses this integration method to demonstrate how upcoming payment systems will merge UPI and cryptocurrency features, which will create new hybrid financial solutions to advance digital finance worldwide.},
  keywords={Interoperability;Protocols;Smart contracts;Internetworking;Communication systems;HTTP;Smart phones;Routing;Communications technology;Information and communication technology;Unified Payments Interface (UPI);Cryptocurrencies;Digital Payments;Hybrid Financial Systems;Secure Payment Processing},
  doi={10.1109/ESCI68015.2026.11493161},
  ISSN={2996-1815},
  month={March},}@INPROCEEDINGS{11167682,
