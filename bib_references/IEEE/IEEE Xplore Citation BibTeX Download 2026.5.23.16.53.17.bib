  ISSN={2576-7046},
  month={May},}@INPROCEEDINGS{10983177,
  author={Shafiei, Kasra and Seifi, Ali and Hagh, Mehrdad Tarafdar},
  booktitle={2024 14th Smart Grid Conference (SGC)}, 
  title={Optimal Design of a Grid-Connected Renewable Energy System with Battery Energy Storage for an Office Building}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Power systems are crucial for operators to increase productivity and support the growing integration of renewable energy sources (RES). However, demand swings and nonlinear limitations exacerbate renewable energy sources' intermittent and unpredictable nature. This paper presents a way for merging wind farms with battery energy storage systems to optimize the management of output and carbon emissions costs in conventional power plants. This improvement considers the costs incurred by traditional fossil fuel-dependent units and the costs connected with carbon emissions. The simulation includes five traditional generating sources and office load consumers. The results show that the improved problem formulation significantly improves the capacity and effectiveness of power plant production schedule optimization.},
  keywords={Renewable energy sources;Schedules;Costs;Battery energy storage system;Simulation;Carbon dioxide;Wind farms;Smart grids;Power generation;Optimization;Office loads;Battery energy storage system;Various generation systems;Renewable energy sources;Demand response program},
  doi={10.1109/SGC64640.2024.10983177},
  ISSN={2572-6927},
  month={Dec},}@INPROCEEDINGS{11264804,
