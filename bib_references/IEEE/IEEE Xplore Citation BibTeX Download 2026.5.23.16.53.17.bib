  title={Topology and Harmonic reduction of Integrated onboard charging Unit for Electric Vehicles}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={This research offers a revolutionary included minimal voltage DC to DC conversion (LDC) and battery built inside the vehicle (OBC) for electric cars (xEVs), which possess heatsinks, platforms, sensor circuits, and circuit components. By altering the vehicle's internal connections, the suggested OBC-LDC unified electricity (OLPU) may be made easier, avoiding the expense of high-power cables. Furthermore, by merging alternatively, exchanging heatsinks, and connections, detecting wiring, and wiring parts, the OLPU's reduces the quantity of electronic parts is reduced while the overall electricity efficiency is increased. Furthermore, the suggested circuit meets the execution requirements of traditional LDCs and OBCs and may be used as such. Furthermore, a further operating mode that comes from the integration suggests a heating at the same time approach for an inexpensive charge as well as a high-current charger. This document also explains the operational characteristics and design technique for each mode in detail. Design issues are given, including potential difficulties having the form of a semiconductor, and an extra compensating circuitry is proposed to alleviate such issues. The initial version is constructed, and exploration are carried out validate a legitimacy and the efficacy of suggested level of power.},
  keywords={Wiring;Electricity;Circuits;Windings;Zero voltage switching;Topology;Automobiles;Heat sinks;Voltage control;Testing;Wind energy;hydropower;fossil fuel. Energy demand},
  doi={10.1109/ICERCS63125.2024.10895401},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11316733,
  author={Uza, Megumi and Kunita, Itsuki},
  booktitle={2025 10th International Conference on Intelligent Informatics and Biomedical Sciences (ICIIBMS)}, 
  title={Fusion Edge Selection Method Using a Slime Mold Model}, 
  year={2025},
  volume={10},
  number={},
  pages={234-238},
  abstract={Adaptive structural changes in biological systems have attracted increasing attention in the field of information engineering, particularly in the context of network operations. These biological mechanisms have been applied to the design of various algorithms and optimization techniques. In network optimization, merging and integrating multiple networks requires careful selection of edges to ensure overall network stability and efficiency. In this study, we focus on the network formation behavior of the unicellular organism Physarum polycephalum, and propose a heuristic method for selecting fusion edges. Numerical simulations demonstrate that the proposed method enables the selection of candidate fusion edges and the formation of fusion paths. Furthermore, the distribution of flow along the fusion paths formed by the proposed method was found to be rapid. However, the shortest path property of the fusion routes is not guaranteed, and parameter tuning is required depending on the network size and the number of nodes and edges. In future work, we aim to incorporate automatic parameter adjustment mechanisms and dynamic extraction of path candidates, which may enable gradual and adaptive network integration.},
  keywords={Adaptive systems;Urban planning;Redundancy;Transportation;Stability analysis;Robustness;Organisms;Planning;Tuning;Numerical stability;metaheuristic;edge selection;fusion system},
  doi={10.1109/ICIIBMS66230.2025.11316733},
