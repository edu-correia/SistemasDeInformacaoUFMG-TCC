  ISSN={},
  month={Nov},}@ARTICLE{11520845,
  author={Ding, Xin-Hao and Wang, Lei and Yang, Wen-Wen and Chen, Jian-Xin},
  journal={IEEE Antennas and Wireless Propagation Letters}, 
  title={Wideband Four-Element MIMO Antenna System for 5G Mobile Terminals using Radiator-Sharing Technology}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={This letter proposes a wideband four-element multiple-input multiple-output (MIMO) antenna system designed for direct integration onto mobile terminal back covers. The design includes four main radiation patches (MP), four parasitic patches (PP) and a center patch. Between two adjacent MPs lies a PP, and through radiator-sharing technology, a single PP can serve both adjacent MPs simultaneously. One MP generates two modes: TM10 and TM01, and a slot is introduced to control the TM10 mode. The two PPs adjacent to the MP produce two additional modes, respectively. Two metallized vias are added to the PP to adjust impedance matching, merging the four modes into a wideband four-mode operation. Finally, the central grounding patch further enhances impedance matching of elements.},
  keywords={MIMO;Antennas;Modeling;5G mobile communication;Wideband;Design methodology;Substrates;Polarization;Bandwidth;Patch antennas;multiple-input multiple-output (MIMO);wideband;patch antenna;radiator sharing;mobile terminal},
  doi={10.1109/LAWP.2026.3693838},
  ISSN={1548-5757},
  month={},}@INPROCEEDINGS{9299642,
