  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/5487874},}@INPROCEEDINGS{8368346,
  author={Chen, Lina and Cao, Zhichao},
  booktitle={2017 IEEE 23rd International Conference on Parallel and Distributed Systems (ICPADS)}, 
  title={Concatenating Road Take Me Home: Indoor Navigation Without Infrastructure Support}, 
  year={2017},
  volume={},
  number={},
  pages={41-48},
  abstract={Though outdoor navigation has been used for a long time, indoor navigation has not yet been put into practice. Recent works based on geomagnetic information require a user to follow the exact path of previous users, which limits its applicability. Meanwhile, the optimal navigation path may not be provided given a large number of paths with different sources and destinations. We present MeshMap, an efficient indoor navigation system by merging geomagnetic information of crowdsourcing paths. MeshMap combines geomagnetic information from multiple users' paths to construct a global navigation map. Then, MeshMap supports to find the optimal navigation path on the navigation map. Finally, MeshMap proposes a real-time tracking method to map user's position on the navigation path and provides real-time navigation hints. We implement MeshMap on Android and evaluate its performance in different environments including campus building, parking area and shopping mall. The evaluation results show the effectiveness of MeshMap.},
  keywords={Magnetometers;Legged locomotion;Indoor navigation;Real-time systems;Wireless fidelity;Magnetic separation;Indoor Navigation;Smartphone;Sensory Data},
  doi={10.1109/ICPADS.2017.00017},
  ISSN={1521-9097},
  month={Dec},}@INPROCEEDINGS{7889782,
  author={Bonato, Marco and Goge, Philippe},
  booktitle={2017 Annual Reliability and Maintainability Symposium (RAMS)}, 
  title={Synergistic methods and tools for robust design of automotive heat exchangers}, 
  year={2017},
  volume={},
  number={},
  pages={1-7},
  abstract={The high level of competitiveness of the automotive industry requires the capability to predict in-service durability during multiple stages of product development: initial design phase, design modification and/or optimization, change of materials (metals, plastics and polymers) or suppliers, use of new testing facilities, etc. Some commonly known methods and tools are often applied for reliability purposes. This includes in particular: i) the acquisition and analysis of road load data (mechanical or climatic stresses), ii) the use of accelerated bench tests, iii) the measurements of the local deformation using strain sensors, and iv) structural simulations. Whereas in the past these methods were used separately, the novelty of this paper is that both commonly applied and innovative tools are used in synergy to predict and improve the reliability of automotive components and merged into a Synergetic Design for Reliability (SRD). A case study that investigates the reliability of an intercooler (charge air cooler) undergoing pressure pulsation fatigue loadings is here presented. Starting from in-service road load data, a design of experiments (DOE) approach is applied to the identification the main factors that influence the fatigue life of the component. Measurements during bench tests are then used to ameliorate the existing validation specification, and to correlate the results from structural simulation.},
  keywords={Strain;Stress;Loading;Reliability;Fatigue;Load modeling;Strain measurement;Automotive;Heat exchangers;Road load Data;Accelerated Tests;Structural simulation;Models correlation},
  doi={10.1109/RAM.2017.7889782},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{5685096,
  author={Stojmenovic, Milos and Solis-Montero, Andres and Nayak, Amiya},
  booktitle={2010 International Conference on Audio, Language and Image Processing}, 
  title={Colour and texture based pyramidal image segmentation}, 
  year={2010},
  volume={},
  number={},
  pages={778-786},
  abstract={The goal of image segmentation is to partition an image into regions that are internally homogeneous and heterogeneous with respect to other neighbouring regions. We build on the pyramid image segmentation work proposed by [BHR] and [SSN] by introducing a mixture of colour and texture cues in order to more accurately group regions. Statistical comparison of each colour channel separately along with edge intensity and orientation histogram comparison were the cues used for region merging. The input image size is no longer constrained as in [BHR], [SSN] and other similar regular pyramid based approaches due to a modification of the pyramid construction rule. The new algorithm is tested on a set of images from the Berkeley image segmentation benchmark set. Our algorithm is fast (produces segmentations within seconds), results in the correct segmentation of elongated and large regions, very simple compared to plethora of existing algorithms, and appears competitive in segmentation quality with the best publicly available implementations.},
  keywords={Image segmentation;Pixel;Image color analysis;Image edge detection;Joining processes;Laplace equations;Histograms},
  doi={10.1109/ICALIP.2010.5685096},
  ISSN={},
