  title={Le Festin: Shop sign recognition assisted food recommendation system}, 
  year={2010},
  volume={},
  number={},
  pages={1-8},
  abstract={As the popularity of smart phone, Web 2.0 data, and 3G mobile networks, people are getting used to search for information from the Internet anytime and everywhere. However, typing text query on mobile device and digesting a large number of retrieved user-generated data are both inconvenient for users. To overcome these troubles, we develop a wearable system, Le Festin, which is a shop sign recognition assisted food recommendation system. In Le Festin, food recommendation list and restaurant-related information can be easily obtained by just snapping restaurant signboard. The system is composed of two main techniques: Chinese character recognition (CCR) and blog mining. We integrate a powerful CCR algorithm which has the accuracy about 90% and propose a new blog mining method which is combined with food name extraction and sentiment analysis. By merging the above two functions, a convenient system is built.},
  keywords={Histograms;Feature extraction;Viterbi algorithm;Servers;Image recognition;Humans},
  doi={10.1109/ISWC.2010.5665875},
  ISSN={2376-8541},
  month={Oct},}@INPROCEEDINGS{7846816,
  author={Matricon, Adrien and Filliat, David and Oudeyer, Pierre-Yves},
  booktitle={2016 Joint IEEE International Conference on Development and Learning and Epigenetic Robotics (ICDL-EpiRob)}, 
  title={An iterative algorithm for forward-parameterized skill discovery}, 
  year={2016},
  volume={},
  number={},
  pages={186-192},
  abstract={We introduce COCOTTE (COnstrained Complexity Optimization Through iTerative merging of Experts), an iterative algorithm for discovering discrete, meaningful parameterized skills and learning explicit models of them from a set of behaviour examples. We show that forward-parameterized skills can be seen as smooth components of a locally smooth function and, framing the problem as the constrained minimization of a complexity measure, we propose an iterative algorithm to discover them. This algorithm fits well in the developmental robotics framework, as it does not require any external definition of a parameterized task, but discovers skills parameterized by the action from data. An application of our method to a simulated setup featuring a robotic arm interacting with an object is shown.},
  keywords={Complexity theory;Robots;Kernel;Minimization;Context;Iterative methods;Planning},
  doi={10.1109/DEVLRN.2016.7846816},
  ISSN={2161-9484},
  month={Sep.},}@INPROCEEDINGS{1213212,
