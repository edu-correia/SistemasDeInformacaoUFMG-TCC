  author={Gal, Zoltan and Korteby, Amine and Talbi, Djamila},
  booktitle={2023 IEEE 6th International Conference on Knowledge Innovation and Invention (ICKII)}, 
  title={Impact of Modulated Routing Mechanism on Wireless Sensor Network Systems: A Comprehensive Analysis}, 
  year={2023},
  volume={},
  number={},
  pages={70-76},
  abstract={Wireless Sensor Networks (WSNs) have been hugely advanced in recent years, driven by the growth of equipment types and numbers and the reduction of cost. Various services have been provided based on application requirements and network services. Among the energy-saving solutions in WSN environments, the Low Energy Adaptive Clustering Hierarchy (LEACH) mechanism stands out. This hierarchical protocol makes cluster heads aggregate and switches data sent by the cluster entity nodes toward a fixed Sink node. In this study, we proposed Cost Balanced LEACH (CBLEACH), a novel set of routing mechanisms that introduce the mobility aspect to the Sink node (SN) and balances the decision of cluster head (CH) election by considering the distances between nodes and the residual energy of expected CH candidates. CB-LEACH allows nodes to be close to the SN to transmit data directly, ensuring non-collapsing energy and achieving the greatest efficiency in the WSN. The functionalities and features of the CB-LEACH routing mechanism were explored to provide valuable insights for researchers and practitioners in WSNs. We introduced a balance factor variable that merged the two impacting and time-dependent properties of nodes: distance and energy. The CH election in each cluster was based on a cost rule derived from a linear Eq. of the balance factor. We presented four different modulation schemes for the balance factor, each with its own rule, and analyzed their impact on the CB-LEACH mechanism. We examined the system's functionalities and compared the lifetime and transmitted number of frames in different scenarios involving the epoch number, the speed of SN, and various systems including Direct Sequence, basic LEACH, enhanced LEACH with mobile SN, and CB-LEACH. The findings in this study demonstrated that the modulated CB-LEACH routing mechanism outperformed other routing cases, offering superior features and capabilities to the WSNs.},
  keywords={Wireless communication;Wireless sensor networks;Technological innovation;Costs;Protocols;Voting;Modulation;wireless sensor network;low energy adaptive clustering hierarchy;cost balanced LEACH;cost balance modulation},
  doi={10.1109/ICKII58656.2023.10332593},
  ISSN={2770-4785},
  month={Aug},}@INPROCEEDINGS{11245314,
  author={Jiang, Zijian and Jin, Peiquan},
  booktitle={2025 IEEE International Symposium on Parallel and Distributed Processing with Applications (ISPA)}, 
  title={TopcDB: Two-Phase Compactable Lossy Compression for Timeseries Databases}, 
  year={2025},
  volume={},
  number={},
  pages={739-746},
  abstract={Timeseries data compression is a critical issue in timeseries databases. So far, many compression algorithms have been proposed, in which lossy compression algorithms generally achieve superior compression ratios compared to their lossless counterparts. However, existing lossy compression algorithms do not account for the storage characteristics of timeseries databases. This paper proposes a novel two-phase compatible lossy compression method named TopcDB for LSM-tree-based timeseries databases. TopcDB addresses two critical challenges in existing approaches: error accumulation during compaction and inefficient compression for small data chunks. It employs an adaptive two-phase compression architecture: Phase 1 utilizes quantization-based error-bounded compression for in-memory chunks. Phase 2 applies entropy encoding with level-aware chunk sizing for LSM-tree-based persistent storage. The novelty of TopcDB includes a merge-friendly Lorenzo predictor, linearscale quantization with mathematical error guarantees, and geometric chunk scaling aligned with compaction patterns. Experimental results show that TopcDB achieves $4.1-8.3 \times$ higher compression ratios than Prometheus while improving write throughput by 147%. Compared to state-of-the-art lossy compressors, TopcDB maintains 1.1-2.8 $\times$ and 1.1-1.4 $\times$ higher compression ratios for in-order and out-of-order data, respectively. Our proposal eliminates error propagation during compaction through phase-isolated compression strategies, making it particularly suitable for industrial timeseries workloads with strict precision requirements.},
  keywords={Out of order;Quantization (signal);Distributed databases;Data compression;Throughput;Entropy;Encoding;Compaction;Proposals;Compression algorithms;Data compression;Timeseries database;LSMtree;Two-Phase compression},
  doi={10.1109/ISPA67752.2025.00100},
