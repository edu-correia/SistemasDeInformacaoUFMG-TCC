  number={},
  pages={1-5},
  abstract={With the development of technology, data is becoming an extremely valuable resource. Data is being created, analyzed and used in a massive scale in every modern system. As a result, data analysis and data mining are very essential in each aspect of social applications. The value of data will be more useful if it can be linked and merged with other different data resources, especially for solving current social problems. In order to make a reality of this big challenge, data transformation is a crucial step that we have to overcome. Among data conversion methods, the intermediate method is to be a preferable one due to its expandable ability. However, for this type of model, finding the intermediate data type for the system is the crucial problem that needs to be solved firstly. In this paper, we will make comparisons among some popular data formats to find the appropriate data type for this elastic data conversion system.},
  keywords={Data conversion;Scalability;Loading;XML;Relational databases;Data models;Load modeling;data format;data type;data conversion;data integration system;data transformation;open data},
  doi={10.1109/IMCOM51814.2021.9377366},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{10889309,
  author={Dong, Aimei and Xu, Jingyuan and Wang, Long and Lv, Guohua and Zhao, Guixin and Cheng, Jinyong},
  booktitle={ICASSP 2025 - 2025 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={TDMF: Text-Guided Denoising and Interactive Medical Image Fusion}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Multimodal image fusion aims to merge features from different modalities to create a comprehensively representative image. However, existing medical image fusion methods often struggle to handle noise generated during image acquisition, significantly diminishing their impact on visual quality. To address these challenges, we propose a semantically text-guided medical image fusion model, named TDMF. Specifically, TDMF guides classical image fusion through textual semantics and effectively coordinates the resolution of degradation and interaction issues during the fusion process. By integrating text encoders and interactive fusion modules, TDMF establishes a unified framework for denoising and interactive fusion of medical images. Extensive experiments have demonstrated that our proposed text-guided image fusion strategy offers significant advantages over state-of-the-art methods in medical image fusion performance.},
  keywords={Visualization;Image resolution;Semantics;Noise reduction;Noise;Pipelines;Noise measurement;Speech processing;Image fusion;Biomedical imaging;Medical image fusion;text-guided fusion;denoising},
  doi={10.1109/ICASSP49660.2025.10889309},
  ISSN={2379-190X},
  month={April},}@INPROCEEDINGS{10499080,
  author={Zhao, Huirong and Yu, Ying and Zhao, Nan and Wang, Qi},
  booktitle={2024 4th International Conference on Neural Networks, Information and Communication Engineering (NNICE)}, 
  title={Detection of Damaged Areas in Ancient Murals Based on Multi-Scale Dual Channel Attention U-Net}, 
  year={2024},
  volume={},
  number={},
  pages={1069-1074},
  abstract={To address the issue that existing methods for detecting damage in ancient murals struggle to accurately identify damaged areas, this paper proposes a detection model based on a multi-scale dual channel attention U-Net. Firstly, a multi-scale dual channel module is designed to replace the encoder-decoder of the original U-Net, creating a network capable of detecting damaged areas of different scales in complex backgrounds. Secondly, an attention guidance module is designed to effectively merge the features of higher and lower layers. This enables the network to emphasize the prominent features of the damaged areas in murals. Additionally, this paper proposes a multi-stage loss summation strategy to enhance the performance of the network model. Experimental results on the DHMural and YNMural datasets show that this model surpasses other comparative methods in both subjective visual perception and objective evaluation metrics.},
  keywords={Measurement;Buildings;Artificial neural networks;Feature extraction;Visual effects;Image restoration;Visual perception;mural damage detection;U-Net;multi-scale dual channel;attention guidance},
  doi={10.1109/NNICE61279.2024.10499080},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{10986370,
  author={Maheshwari, Vanshika and Khandelwal, Tanvi and Gulati, Drishti and Agarwal, Divya},
  booktitle={2025 3rd International Conference on Disruptive Technologies (ICDT)}, 
  title={Smart Helmet: A Comprehensive Solution for Rider Safety}, 
  year={2025},
  volume={},
  number={},
  pages={922-926},
  abstract={Smart helmets: The merging of the conventional head- gears for the protection of one's head, with modern technology, may be said to be one of the breakthroughs in the motorcycling, cycling, construction, and emergency services industries. This paper deals with the history, components, applications, and advantages of smart helmets, showing how these impact user safety and connectivity in a wide context. This paper involves a feasibility study and problem statement for a project using smart helmet technology to integrate solutions with the prevalent social problems. The research focuses on three systems, including helmet recognition and reminders, emergency message sending, drowsiness detection. The article argues that each of these systems contributes in bringing about road safety, providing emergency help, and safe distance in drowsy riding. Smart helmets integrate cutting edge technology with the inclusion of sensors and communication systems thus giving the wearers much situational awareness with proactive safety measures. Through this research, it brings out the importance of smart helmets in preventing losses while outlining the construction of a safer connected future.},
  keywords={Industries;Transportation;Helmets;Road safety;Real-time systems;User experience;Safety;Protection;Optimization;Accidents;Smart helmets;safety equipment;technology integration;connectivity;drowsiness detection;real-time notifications;road safety},
  doi={10.1109/ICDT63985.2025.10986370},
  ISSN={},
  month={March},}@INPROCEEDINGS{10491652,
  author={Cao, Zhiyuan and Liu, Hu},
  booktitle={2023 International Conference on Artificial Intelligence and Automation Control (AIAC)}, 
  title={ICFusion: An Infrared and Visible Image Fusion Network Based on Illumination Aware and Convolutional Attention}, 
  year={2023},
  volume={},
  number={},
  pages={151-155},
  abstract={Infrared and visible image fusion plays a pivotal role in image enhancement, aiming to merge the unique attributes of both imaging modalities: the comprehensive scene understanding of infrared image and the detailed visual cues of visible image. However, many current fusion techniques are designed for single-illumination settings, overlooking the challenges of diverse illuminance conditions and the intricacies of modality fusion. In this paper, we present ICFusion, a cutting-edge image fusion network anchored by illumination aware and convolutional attention mechanisms. This framework integrates two key modules: the Illumination Probability Computation Module (IPCM) to gauge scene illuminance and the Convolutional Attention Fusion Module (CAFM) to discern latent features and reduce redundancy. By capitalizing on illumination aware, our approach deftly combines information from both imaging modes. Experimental outcomes underscore ICFusion’s edge over contemporary methods, especially in retaining fine textural nuances.},
  keywords={Visualization;Automation;Image edge detection;Redundancy;Lighting;Imaging;Probability;Image fusion;multimodal fusion;attention mechanism;illumination-based},
  doi={10.1109/AIAC61660.2023.00030},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9204215,
  author={Vynokurova, Olena and Peleshko, Dmytro},
  booktitle={2020 IEEE Third International Conference on Data Stream Mining & Processing (DSMP)}, 
  title={Hybrid Multidimensional Deep Convolutional Neural Network for Multimodal Fusion}, 
  year={2020},
  volume={},
  number={},
  pages={131-135},
  abstract={The Hybrid Multidimensional Deep Convolutional Neural Network (HMDCNN) topology for the multimodal recognition of the speech, the face, the lips, and human gestures behavior is proposed. In this case a hybridization is understood to be compatible use of 2D and 3D convolutional neural networks in one multimodal architecture. Conducted researches relate to improving the understanding of complex dynamic scenes. The basic unit of the proposed hybrid system is deep neural network topology, which combines 2D and 3D convolutional neural network (CNN) for each modality with proposed intermediate-level feature fusion subsystem. Such a feature map fusion method is based on scaling procedure with a specific combination of pooling operation with non-square kernels and allows merging different type of modalities.},
  keywords={Kernel;Network topology;Three-dimensional displays;Convolutional neural networks;Two dimensional displays;Streaming media;Topology;Multimodal fusion;hybrid system;deep convolutional neural network;2D and 3D convolution and pooling},
  doi={10.1109/DSMP47368.2020.9204215},
  ISSN={},
  month={Aug},}@ARTICLE{10972111,
  author={Yu, Dawen and Cheng, Hao},
  journal={IEEE Geoscience and Remote Sensing Letters}, 
  title={Building Extraction From Multi-View RGB-H Images With General Instance Segmentation Networks and a Grouping Optimization Algorithm}, 
  year={2025},
  volume={22},
  number={},
  pages={1-5},
  abstract={Bird’s-eye-view (BEV) building mapping from remote sensing images is a studying hotspot with broad applications. In recent years, deep learning (DL) has significantly advanced the development of automatic building extraction methods. However, most existing research focuses on segmenting buildings from a single perspective, such as orthophotos, overlooking the rich information of multi-view images. In surveying and mapping, individual building instances need to be separated even when they are adjacent or touching. Since orthophotos cannot capture building walls due to self-occlusion, distinguishing between closely connected buildings in densely built areas becomes challenging. To tackle this issue, we propose a multi-view collaborative pipeline for instance-level building segmentation. This pipeline utilizes a grouping optimization algorithm to merge segmentation results from multiple views, which are predicted by general instance segmentation networks and projected onto the BEV, to produce the final building instance polygons. Both qualitative and quantitative results show that the proposed multi-view collaborative pipeline significantly outperforms the popular orthophoto-based pipeline on the InstanceBuilding dataset.},
  keywords={Pipelines;Buildings;Instance segmentation;Collaboration;Image segmentation;Optimization;Clustering algorithms;Training;Data mining;Annotations;Building extraction;convolutional neural networks (CNNs);grouping optimization algorithm;instance segmentation;multi-view aerial images},
  doi={10.1109/LGRS.2025.3562892},
  ISSN={1558-0571},
  month={},}@INPROCEEDINGS{10009555,
  author={Ramadan, Hamed and Alqahtani, Mohammad and Algoson, Abdullah},
  booktitle={2022 20th International Conference on Language Engineering (ESOLEC)}, 
  title={Identifying Equivalent Words from Different Arabic Dialects Using Deep Learning Techniques}, 
  year={2022},
  volume={20},
  number={},
  pages={124-128},
  abstract={The Arabic language comprises many spoken dialects. These dialects vary from a standard written Modern Standard Arabic (MSA) in terms of syntactic, lexical, phonological, and morphological. Arabic Dialects differ, not only along a geographical continuum, but also with other sociolinguistic factors such as the urban, rural, Bedouin dimension. Currently, Dialectal Arabic (DA) is the essential written language of unofficial communication in the Arab World. These Dialects can be found on social media platforms, emails, Twitter, etc. There has been a high interest in research on computational models of Arabic dialects in the last decade. Most of these studies focus on Arabic dialect identification (classification) and building Arabic dialect corpora. However, finding Arabic dialect word synonyms from another Arabic dialects has received limited attention. To bridge this gap, this study will develop a model to identify the equivalent words from different Arab world dialects using deep learning techniques such as word2vec. This research merged and extended the existing Arabic dialects corpora and then applied some deep learning techniques to achieve the best results for dialectal word synonyms. The outcomes of this research are a new dataset of Arabic dialectical word synonyms and a model with acceptable accuracy of 81%.},
  keywords={Deep learning;Bridges;Social networking (online);Computational modeling;Buildings;Blogs;Syntactics;Arabic;dialectal;word2vec;deep learning techniques;synonyms},
  doi={10.1109/ESOLEC54569.2022.10009555},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10864088,
  author={He, Nan and Wang, Wengwang and Wu, Jing},
  booktitle={2024 5th International Conference on Artificial Intelligence and Computer Engineering (ICAICE)}, 
  title={Forecasting Shanghai Containerized Freight Index by CPO-VMD-PE-ELM Model}, 
  year={2024},
  volume={},
  number={},
  pages={619-622},
  abstract={Accurate forecasting of freight rate index can provide decision-making basis for shipping market practitioners. To improve the prediction accuracy of container freight index, this paper takes Shanghai Containerized Freight Index (SCFI) as the research object and constructs a forecasting framework combining decomposition algorithm and machine learning model. Firstly, SCFI is decomposed into Intrinsic Mode Function (IMF) using Crested Porcupine Optimizer (CPO) optimized Variational Mode Decomposition (VMD) model. Secondly, IMFs with approximate entropy values are merged according to the idea of Permutation Entropy (PE) to reduce the computational scale; finally, IMFs are predicted separately using Extreme Learning Machine (ELM) model, and their prediction results are superimposed as the final prediction results of SCFI. The empirical analysis results show that the model constructed in this paper has high forecasting accuracy and robustness and can provide a new technical reference for container freight index forecasting.},
  keywords={Accuracy;Supply and demand;Computational modeling;Decision making;Predictive models;Containers;Entropy;Robustness;Indexes;Forecasting;freight rate index forecast;decomposition-integration;variational mode decomposition;extreme learning machine},
  doi={10.1109/ICAICE63571.2024.10864088},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10642525,
  author={Aroca, José Manuel and Pastor, José Francisco Díez and Latorre-Carmona, Pedro and Oneto, Antonio Canepa and Rad, Juan Carlos and Camps-Valls, Gustau and Elvira, Víctor and García-Osorio, César},
  booktitle={IGARSS 2024 - 2024 IEEE International Geoscience and Remote Sensing Symposium}, 
  title={WALGREEN: Web Based Platform for Soil Organic Carbon Inference Applications}, 
  year={2024},
  volume={},
  number={},
  pages={3992-3996},
  abstract={Remote sensing data management and its use for classification and inference purposes is at the forefront of research tasks nowadays. There are, however, some inherent drawbacks and difficulties when dealing with, and understanding how satellite information is provided (particularly when referring to multiband/multispectral satellite platforms) and how different and disparate datasets related to soil content can be used and merged with this imagery.We present WALGREEN. The aim of this tool is to provide a secure environment to handle the whole process to use polygons or, geographical coordinates in tiff/geotiff images, have real-time access to images, save and get soil organic carbon real measurements, and generate datasets for machine learning training and inferential methods. We also aim to providing a framework to preprocess soil organic carbon information from different but accepted sources, like the Land Use/Cover Area frame statistical Survey database, so that even without real measurements, researchers may be able to start training different machine learning methodologies.},
  keywords={Training;Water;Surveys;Visualization;Satellites;Soil measurements;Machine learning;Soil organic carbon;machine learning;datasets;Sentinel integration;Tiff and Geo Tiff;Spring boot Framework;Java Persistance API;Python API;Flask},
  doi={10.1109/IGARSS53475.2024.10642525},
  ISSN={2153-7003},
  month={July},}@INPROCEEDINGS{9208643,
  author={Zhou, Boxi and Shang, Lingling and Song, Xinxin and Wang, Jinliang and Xu, Jiaheng},
  booktitle={2020 IEEE/IAS Industrial and Commercial Power System Asia (I&CPS Asia)}, 
  title={Logical Causal Model of Power System Fault Alarm and Its Application}, 
  year={2020},
  volume={},
  number={},
  pages={964-969},
  abstract={This paper studies a logic causal model and an intelligent alarm analysis method for power system fault alarm. First of all, to describe the relationship of fault alarms, a logical cause and effect model is established, in addition, a knowledge base with the cause and effect set of both of the relay actions and the over- limited electrical quantity alarms is built; secondly, to process the fault alarms, an algorithm for the cause and effect relationship discovery of the alarm is proposed, the algorithm can merge large batch of alarms into a concise and brief alarm sequence demonstrating the fault developing process. The algorithm is tested with the 110 kV system fault case, the results show that the model can greatly compress the associated alarm signal and accurately obtain the alarm sequence, which can improve the work efficiency of the dispatcher.},
  keywords={Switching circuits;Circuit breakers;Circuit faults;Power transformers;Voltage measurement;Accidents;Fault diagnosis;Intelligent alarm;regulation integration;causal logic;timing characteristics},
  doi={10.1109/ICPSAsia48933.2020.9208643},
  ISSN={},
  month={July},}
