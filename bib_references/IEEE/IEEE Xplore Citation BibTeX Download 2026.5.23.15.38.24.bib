  month={Aug},}@INPROCEEDINGS{1602416,
  author={Tan Yan and Nojima, T. and Nakatake, S.},
  booktitle={IEEE Computer Society Annual Symposium on Emerging VLSI Technologies and Architectures (ISVLSI'06)}, 
  title={Formulating the empirical strategies in module generation of analog MOS layout}, 
  year={2006},
  volume={},
  number={},
  pages={6 pp.-},
  abstract={In module generation for analog cell layout, it is necessary to incorporate the designers' empirical techniques to achieve small area as well as high performance. This paper presents the formulation of two types of module generation problems, faithful to expert's empirical knowledge, to ease such incorporation. One is series module generation problem, where we introduce equivalent circuit modifications to maximize the diffusion merging and minimize the number of diffusion contacts. The other is the common-centroid module generation problem which is formulated as a mathematical optimization problem taking coincidence, symmetry, dispersion and compactness into consideration. A greedy algorithm is also presented to solve this problem.},
  keywords={Merging;Fusion power generation;Research and development;Greedy algorithms;Circuit optimization;Humans;Guidelines;Stacking;Circuit topology;Technological innovation},
