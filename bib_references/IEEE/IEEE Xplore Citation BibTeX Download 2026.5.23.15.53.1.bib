  year={2008},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents an integrated framework that allows us to build 3 Tiers application in just 2 steps Specify and Deploy. This framework merges the power of model driven architecture (MDA), the simplicity of Business Process Management Notation (BPMN), the breadth of the web and the flexibility of service oriented architecture (SOA). Applications are specified using UML and BPMN and can be deployed on any platform. Actually eliXir can be deployed on J2EE platform, using MySql or Oracle as database, using Jboss or BEA Weblogic as application server and Windows or Linux as operating system.},
  keywords={Service oriented architecture;Buildings;Energy management;Unified modeling language;Databases;Linux;Operating systems},
  doi={10.1109/ICTTA.2008.4529980},
