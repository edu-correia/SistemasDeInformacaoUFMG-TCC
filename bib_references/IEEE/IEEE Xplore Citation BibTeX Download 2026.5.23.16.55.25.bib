  author={Abdeljabbar, Nourhene and Mhenni, Faïda and Choley, Jean-Yves},
  booktitle={2020 21st International Conference on Research and Education in Mechatronics (REM)}, 
  title={A categorical framework for Safety critical mechatronic systems modeling}, 
  year={2020},
  volume={},
  number={},
  pages={1-5},
  abstract={Systems engineering relies on a diversity of views of the same system representing the involved domains at different abstraction levels. These views need to be and remain consistent throughout the whole engineering process. To this end, a unified and formal framework is needed to model these different views together with their dependencies and relationships. Furthermore, this framework will be used to ensure collaboration between domains and consistency between different models that represent the same mechatronic system. In this paper, we propose that this framework can rely mathematically in a declarative form via category theory (CT). The use of CT therefore will support the collaboration between different models. The main objective of applying category theory in the current research is to model interaction, transformation, synchronization, considering that all this model management scenarios can be seen as category specification applications. Moreover, a model that merge different models according to three points of view (requirement, behavior and structure) within systems engineering is going to be defined. To this end, a Meta-Model is established for the collaboration between systems engineering (SE) and safety assessment (SA). The categorical framework ensures the connection and the consistency between models relevant categories via morphisms and functors. Therefore this proposed categorical framework might be generalized and enhanced to represent any other model involved in systems engineering such as the 3D model category that can be created following a standard norm to integrate emerging flows phenomena.},
  keywords={Modeling;Unified modeling language;Mathematical model;Safety;Mechatronics;Collaboration;Synchronization;Category Theory;Systems Engineering;MBSE;MBSA;Modeling;Mechatronic Systems},
  doi={10.1109/REM49740.2020.9313928},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9653635,
  author={Zhu, Liang and Li, Peng and Wei, Yonggang and Song, Xin and Wang, Yu},
  booktitle={2021 International Conference on Intelligent Computing, Automation and Applications (ICAA)}, 
  title={Processing Approximate KNN Query Based on Data Source Selection}, 
  year={2021},
  volume={},
  number={},
  pages={672-676},
  abstract={A KNN query over a relation is to find its $K$ nearest neighbors/tuples from a dataset/relation according to a distance function. In this paper, we discuss approximate KNN query processing based on the selection of many data sources with various dimensions. We propose algorithms to construct a UBR- Tree and a Centroid Base for selecting related data sources and retrieving $K$ NN tuples. For a $K$ NN query $Q$, (1) the related data sources are selected by using the Centroid Base, (2) these data sources are sorted according to their representative tuple in the Centroid Base, (3) local $K$ NN tuples in the related data sources are retrieved, and (4) a heap structure is used to merge the local $K$ NN tuples to form global $K$ NN tuples of $Q$. Extensive experiments over low-dimensional and high-dimensional datasets are conducted to demonstrate the performances of our proposed approaches.},
  keywords={Automation;Soft sensors;Query processing;Approximation algorithms},
  doi={10.1109/ICAA53760.2021.00121},
  ISSN={},
  month={June},}@INPROCEEDINGS{8971529,
  author={Do, Haggi and Kim, Jinwhan},
  booktitle={2019 19th International Conference on Control, Automation and Systems (ICCAS)}, 
  title={Robust Loop Closure Selection for Multi-robot Mapping Under Perceptual Aliasing}, 
  year={2019},
  volume={},
  number={},
  pages={475-479},
  abstract={Robust loop closure detection is crucial in simultaneous localization and mapping (SLAM) as failure to correctly choose the loop closures can severely distort the map. This applies not only to single-robot cases but also for multi-robot systems. When initial relative poses between robots are unknown, inter-robot loop closures must be found in order to merge their local maps and produce a global map. This becomes an even more challenging issue in the presence of perceptual aliasing that arises from repetitive features and patterns in highly structured settings such as indoor environments. In this paper, we propose a robust inter-robot loop closure selection method that finds the inlier loop closure set that maximizes the consistencies between measurements. We show that this can be formulated and solved as a maximum weight clique problem in graph theory. To demonstrate the performance of the algorithm, simulation is performed using synthetic data and the result is compared to a recent method dealing with the same problem.},
  keywords={Performance evaluation;Simultaneous localization and mapping;Image analysis;Control systems;Probability distribution;Graph theory;Indoor environment;Multi-robot systems;Optimization;Synthetic data;Multi-robot system;Simultaneous localization and mapping (SLAM);Map fusion},
