  title={Improving the Application of YOLOv8 in Image Object Detection}, 
  year={2024},
  volume={},
  number={},
  pages={668-673},
  abstract={As deep learning develops, the use of object detection to analyze image content has achieved stage-by-stage success. However, due to the problems of spatial occlusion and slow convergence, the accuracy is poor and models are complex. To address the above problems, a new YOLOv8s network structure that improves the accuracy with almost no increase in training overhead is proposed. First, the hierarchical feature extraction is utilized to enhance the positional information of the feature map by adding Coordinate Attention at backbone and neck networks layer-by-layer. Then, GCNet is introduced at the last layer of neck network to model global context and merge hierarchical features. Finally, SIOU Loss is used to accelerate the convergence speed to further improve the accuracy. The experimental results demonstrate that the enhanced model improves mAP by +4.6% over YOLOv8s and accuracy by +2.7% over YOLOv9s. Additionally, it slightly decreases model complexity and training overhead by 0.2 GFLOPs.},
  keywords={Training;Accuracy;Computational modeling;Semantics;Object detection;Feature extraction;Neck;YOLOv8s;Coordinate Attention;GCNet;SIOU},
  doi={10.1109/CISCE62493.2024.10653313},
  ISSN={2833-2423},
  month={May},}@INPROCEEDINGS{10798383,
  author={Gu, Guanjie and Wang, Weixiao and Luo, Yuxuan and Zhao, Bo},
  booktitle={2024 IEEE Biomedical Circuits and Systems Conference (BioCAS)}, 
  title={A Zero-Standby-Power WBAN Wake-Up Receiver Self-Adaptive to Flexible Data Rates}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={A wake-up receiver (WuRX) enables the sensor nodes to operate in an event-driven way for a wireless body area network (WBAN), which helps to extend the lifetime and minimize the battery size. However, the existing WuRX chips consume standby power in the idle state, which still limits the lifetime of WBAN. In addition, the conventional low-power WuRX structures can only process a fixed data rate, which is not able to adapt to various IoT infrastructures. In this work, a power-data link-merging technique is proposed to recycle the energy of incident wake-up signal, powering up the receiving chain under a 0.3 V ultra-low power supply. In this way, the WuRX is totally shut down in the listening state, resulting in zero standby power. Moreover, an all-digital self-adaptive clock-data-recovery (CDR) technique is also proposed to support a flexible data rate of $100 \mathrm{bps}-10 \mathrm{kbps}$. Based on the proposed techniques, we demonstrate a zero-standby-power WuRX chip for WBAN applications. The chipis fabricated in 55nm CMOS process, and measured results show that the proposed WuRX achieves the best figure of merit (FoM) in the state of the arts.},
  keywords={Wireless communication;Wireless sensor networks;Semiconductor device measurement;Circuits and systems;Low power electronics;Receivers;Body area networks;CMOS process;Recycling;Energy harvesting;Wireless body area network;wake-up receiver;standby power;self-adaptive;clock-data recovery},
  doi={10.1109/BioCAS61083.2024.10798383},
  ISSN={2766-4465},
  month={Oct},}@INPROCEEDINGS{10348757,
  author={Son, J.Y. and Lee, S.G. and Park, J.W. and Lee, Y.W. and Jung, S.B.},
  booktitle={2023 18th International Microsystems, Packaging, Assembly and Circuits Technology Conference (IMPACT)}, 
  title={Enhancement of Thermal cycle and Drop Shock Reliability at Board Level with Developed Solder Composition by Optimized Bi, Cu, Ni Contents in Lead Free Solder Composition}, 
  year={2023},
  volume={},
  number={},
  pages={106-110},
  abstract={We did study for development of new solder composition to cover the positive reliability of SAC305 as high thermal shock and SAC1205N as high drop shock reliability. However, general Sn-Ag-Cu solder composition have limitation of stable material property in thermal affecting condition because solder hardness is easily changed by microstructure due to merging of Ag3Sn particles which makes decreasing of precipitation hardening mechanism [1]. So, Sn-Ag-Cu-Ni-Bi solder has broadly studying at IDMs, OSATs and universities for application of FOWLP, FCBGA, SiP and DSP [2]–[7]. However, it must show lower drop shock reliability than SAC1205N solder composition due to high brittle property. The material hardness of new solder composition is controlled by substitutional hardening mechanism by Bi element instead of precipitation hardening in Sn based solder composition. The high contents of Bi in SNC (Sn-0.065Ni-0.75Cu) makes the high brittle property compare to non-Bi solder composition. However, we find that optimum Bi contents in SNC composition as below 2wt%. The 3wt% Bi solder also has reasonable ductile property at fractured area after tensile test. However, brittle fracture was seriously increased over Bi 5 wt% in SNC solder composition due to Bi segregation by excessive Bi element which is high brittle property as rhombohedral structure [8]. So, we find that when Bi contents is the 1.5 to 2.0 wt% in SNC solder (JY T2), that compositions can overcome the higher thermal shock reliability than SAC305 and higher drop reliability than SAC1205N solder composition. Even 3wt% Bi in SNC solder (JY T4) had lower elongation property than SAC305, it shown higher drop shock reliability because Ni additive makes more stable interfacial IMC layer than that of SAC305 after drop shock test. Our developed solder composition called JY T2(1.5Bi) and JYT4(3.0Bi) The optimized Bi content in JY solder composition shown higher drop than SAC1205N about 2 times on Cu OSP pad finish. And also, Thermal shock reliability of optimized Bi contents solder shown higher than SAC305 solder composition around 2 times on Cu-OSP pad finish. Therefore, the optimized Bi in JY composition can be replace of all lead-free solder composition because it shown satisfaction of drop and thermal shock reliability.},
  keywords={Young's modulus;Precipitation;Electric shock;Environmentally friendly manufacturing techniques;Thermal shock;Lead;Nickel},
  doi={10.1109/IMPACT59481.2023.10348757},
  ISSN={2150-5942},
  month={Oct},}@INPROCEEDINGS{8779212,
  author={Zou, Yun-Yong and Kong, Yong-Dan},
  booktitle={2019 IEEE International Conference on Computational Electromagnetics (ICCEM)}, 
  title={A Wideband Substrate Integrated Waveguide Slot Antenna with Quad Modes}, 
  year={2019},
  volume={},
  number={},
  pages={1-3},
  abstract={This paper presents a quad-mode slot antenna based on the substrate integrated waveguide (SIW) structure. A SIW antenna is designed at first, and two slots are etched on the patch, to radiate energy in the same phase. By analyzing the electric field distributions of the selected mode, several pairs of shorting vias are arranged inside the SIW cavity. Consequently, the lower modes (TE310 mode and TE120 mode) are moved upward and merged with the TE320 mode and a high-order mode. Hence, a wideband SIW slot antenna with quad modes is achieved. The proposed antenna shows an impedance bandwidth of 16.4% and a peak gain of 9 dBi from the simulated results.},
  keywords={Broadband antennas;Slot antennas;Substrates;Cavity resonators;Wideband;Substrate integrated waveguide (SIW);slot antenna;quad-mode;wideband},
  doi={10.1109/COMPEM.2019.8779212},
  ISSN={},
  month={March},}@INPROCEEDINGS{8868823,
  author={Li, Mo and Hua, Yuxiang and Zhang, Guoan and Zha, Jie and Zhu, Yanhe},
  booktitle={2019 IEEE/ASME International Conference on Advanced Intelligent Mechatronics (AIM)}, 
  title={Mechanical Design of a Paraplegic-Oriented Assistive Exoskeleton Combined with Wheelchair}, 
  year={2019},
  volume={},
  number={},
  pages={1485-1490},
  abstract={This paper deals with the mechanical design of a novel assistive exoskeleton for the paraplegic and the elderly. In order to reduce the inconvenience that traditional devices have in long distance travel, this paper developed a deformable exoskeleton which merges the exoskeleton and the wheelchair. What have been taken into consideration include the characteristics of human joints, DOF configuration, actuator characteristics and human-machine interaction. Then according to these factors, this paper introduced the deformation principle based on the four-bar linkage and designed the hip and knee joint structures. Finally, this paper analyzed the stability of the deformation process with CoG judgement, proved the feasibility and introduced an adjustment method to improve the stability margin to avoid the risk of turnover when facing slopes.},
