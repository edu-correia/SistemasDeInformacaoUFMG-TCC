  month={},}@INPROCEEDINGS{9780991,
  author={Yao, Jiangyuan and Jiang, Zheng and Yang, Weiping and Wang, Minrui and Li, Deshun},
  booktitle={2021 IEEE 23rd Int Conf on High Performance Computing & Communications; 7th Int Conf on Data Science & Systems; 19th Int Conf on Smart City; 7th Int Conf on Dependability in Sensor, Cloud & Big Data Systems & Application (HPCC/DSS/SmartCity/DependSys)}, 
  title={Forwarding Policy Verification of Hybrid Multi-domain Software-Defined Network}, 
  year={2021},
  volume={},
  number={},
  pages={2371-2378},
  abstract={Software-Defined Network (SDN) is now widely used in the industry and the exploration of multi-domain SDN is currently underway. Because of the different manager, the forwarding policy conflict occurs frequently in multi-domain SDN. However, the previous verification of network policy conflicts is only limited to traditional networks or single domain SDN. Therefore, we carry out our work on hybrid multi-domain SDN which is a type of multi-domain SDN. We merge the SDN flow table entries with border router configuration files to construct a formal model HM-SDN of hybrid multi-domain SDN, and then generate a graph structure SDNIG according to HM-SDN which can depict the real network environment, finally present a verifier VeriGraph based on graph algorithms. After evaluation, we can construct our graph structure no more than 0.13s and can verify common attributes less than 3s in the small and medium networks.},
  keywords={Industries;Smart cities;Hybrid power systems;Servers;Network verification;multi-domain SDN;graph algorithm},
