  ISSN={},
  month={Aug},}@INPROCEEDINGS{11349771,
  author={Xiao, Junyu and Liu, Jinyu and Cui, Jingwen and Ding, Zhihao},
  booktitle={2025 IEEE 5th International Conference on Data Science and Computer Application (ICDSCA)}, 
  title={An Efficient Contour Extraction Algorithm Based on Dual-Stage Semi-Tracing and Multidimensional Feature Enhancement}, 
  year={2025},
  volume={},
  number={},
  pages={682-690},
  abstract={This paper proposes an innovative two-stage contour-tracing algorithm for digitized binary images. Our algorithm scans and justifies every pixel first and creates or combines labels that are assigned to a connected component. If current pixel is contour pixel, algorithm creates new contour set, combines different labels or not change set and label, based on the pixels surrounding the current one, and adds the current pixel to the set of its entity. When different labels are found to be connected, all labels are changed to the smallest label together. After the first scan, all contour pixels are extracted to its entity’s set and every entity only has one set. Next, we record pixels that are connected in current line to contour run datas and merge different run datas that are connected in upper line and current line. The step distinguishes between inner and outer contour for pixels of the same entity. In the end, a sub - pixel subdivision mapping are proposed to make the algorithm distinguish inner and outer contour perfectly. Experimental results on various types of images demonstrate that our algorithm outperforms all conventional contour-tracing algorithms.},
  keywords={Computer applications;Data science;Feature extraction;Encoding;Data mining;Contour Extraction;Semi-Tracing Algorithm;Run-Data Encoding;Multi-Dimensional Feature Enhancement;Sub-Pixel Subdivision Mapping},
  doi={10.1109/ICDSCA67083.2025.11349771},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10516559,
  author={Chen, Yufeng and Jiang, Ping and Qu, Yida and Wu, Mengqi and Luo, Lu and Yang, Ming and Lu, Wenqian},
  booktitle={2023 Eleventh International Conference on Advanced Cloud and Big Data (CBD)}, 
  title={Point-Multipoint Communication Scheduling in Industrial Internet: A Quick Survey}, 
  year={2023},
  volume={},
  number={},
  pages={291-296},
  abstract={The industrial Internet represents a significant innovation merging Internet technologies, big data, artificial intelligence, and advanced manufacturing, which is characterized by high technological and commercial value. Industrial communication systems need to satisfy precision manufacturing, including the expansive connections and tight requirements such as real time, determinism, and reliability. Hence, an efficient communication scheduling mechanism is essential. In contrast to conventional separate point-to-point (P2P) scheduling, point-to-multipoint multicasting and multipoint-to-point data aggregation are proven to be more effective in alleviating network congestion, enhancing throughput, and improving efficiency in the context of the ubiquitous point-to-multipoint communication in the industrial Internet. This paper focuses on communication in intra-datacenter and inter-datacenter subject to industrial quality of service (QoS) demands. Initially, we introduce a mathematic model for network and point-to-multipoint communication requests. Subsequently, we provide a comprehensive analysis of multicast route selection and traffic rate allocation algorithms that are deadline-aware and delay-aware. Additionally, we discuss the benefits of in-network data aggregation, including insights into aggregation pathways and aggregator placement algorithms, which are valuable for reference in data transfer scheduling in the industrial Internet.},
  keywords={Point-to-multipoint communications;Technological innovation;Job shop scheduling;Multicast algorithms;Processor scheduling;Quality of service;Data aggregation;industrial Internet;multicast;data aggregation;in-network computing;flow scheduling},
  doi={10.1109/CBD63341.2023.00058},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9921905,
  author={Zhang, Xinyi and Chai, Ming and Chen, Lijie and Wang, Hai-Feng and Cui, Junfeng and Chai, Jinchuan},
  booktitle={2022 IEEE 25th International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={Model-based Design and Testing for Route Control of Railway Virtual Coupling}, 
  year={2022},
  volume={},
  number={},
  pages={1522-1527},
  abstract={Virtual coupling is a next-generation signalling concept that separates trains by relative braking distances, allowing the follower to pursue the leader train safely and ensuring good transient dynamics. One of the main challenges in virtual coupling is trains coupling/decoupling at merging/diverging junctions. With the increased complexity of route protections and controls, conventional software developments methods for virtual coupling interlocking suffers from difficulties in safety guarantee, in which testing starts too late. To solve these problems, we propose an interlocking design approach for virtual coupling using model-based system engineering (MBSE) methods. The core logic of interlocking is designed with the UML conceptual models. In addition, a model-based test approach is investigated for automatically generating and optimizing test cases. The experimental results show the effectiveness and adequateness of the proposed MBSE-based interlocking development methods for virtual coupling.},
  keywords={Couplings;Unified modeling language;Semantics;Syntactics;Systems engineering and theory;Generators;Software},
  doi={10.1109/ITSC55140.2022.9921905},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10989074,
  author={Wanyi, Chen and Lei, Qiu and Feng, Chen},
  booktitle={2025 International Conference on Digital Analysis and Processing, Intelligent Computation (DAPIC)}, 
  title={Application of Cors Trajectory Library in Engineering Monitoring}, 
  year={2025},
  volume={},
  number={},
  pages={747-753},
  abstract={This paper focuses on the application of CORS trajectory database in the monitoring and management of engineering projects, with emphasis on its high-precision positioning service. By analyzing the coordinates of control points, it is committed to improving the monitoring efficiency of engineering projects, which covers data preprocessing, error analysis, and area division. In the data preprocessing stage, the CORS data are screened and cleaned so as to construct a data set that meets the experimental requirements. In the error analysis stage, the DBSCAN algorithm is used to identify and merge the error points to improve the accuracy of the data. After trying various clustering algorithms in the area division, the K-method algorithm is finally selected, and the results are close to the real data after the example test, but there are still some errors, which are caused by the lack of precision in the screening, the proximity of the construction areas, and the errors in the estimation of the coordinates, etc. The study is a good example of the use of CORS data in precision project management and urban planning. This study has application value in the fields of precision engineering management and urban infrastructure, but also faces the challenges of complex data processing, high dependence on high quality data sources, and high implementation cost. It can be improved in the future through multi-source data fusion and intelligence.},
  keywords={Accuracy;Error analysis;Clustering algorithms;Process control;Precision engineering;Real-time systems;Trajectory;Planning;Safety;Monitoring;corrs trajectory data;dbscan algorithm;k-means algorithm;engineering monitoring},
  doi={10.1109/DAPIC66097.2025.00143},
  ISSN={},
  month={Feb},}@INBOOK{9622503,
  author={Massaro, Alessandro},
  booktitle={Electronics in Advanced Research Industries: Industry 4.0 to Industry 5.0 Advances}, 
  title={Information Technology Infrastructures Supporting Industry 5.0 Facilities}, 
  year={2022},
  volume={},
  number={},
  pages={51-101},
  abstract={This chapter provides important solutions about digitalized information and data monitoring of production lines, merging informatic with electronic aspects. The hardware solutions are combined with the software ones allowing big data analytics, augmented reality facilities, and predictive maintenance of production machines. According to the new Industry 5.0 facilities, the chapter also provides the details about electronic elements useful for the design of advanced information technology infrastructures, including circuit implementations describing feedback logics to apply improving intelligent production systems. A tool suitable to model production processes is the business process modeling. The chapter provides an overview of electronic logic and its possible implementation in neuron basic models. It describes the implementation of predictive maintenance in industries, by discussing a methodology to perform corrective actions avoiding machine failures and potential break down. Predictive maintenance is an important upgrade of the production quality assessment.},
  keywords={Unified modeling language;Production;Object oriented modeling;Artificial intelligence;Standards;Industries;Business},
  doi={10.1002/9781119716907.ch2},
  ISSN={},
  publisher={IEEE},
  isbn={9781119716884},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/9622503},}@INPROCEEDINGS{9371628,
  author={Sun, Hanbo and Zhu, Zhenhua and Cai, Yi and Zeng, Shulin and Qiu, Kaizhong and Wang, Yu and Yang, Huazhong},
  booktitle={2021 26th Asia and South Pacific Design Automation Conference (ASP-DAC)}, 
  title={Reliability-Aware Training and Performance Modeling for Processing-In-Memory Systems}, 
  year={2021},
  volume={},
  number={},
  pages={847-852},
  abstract={Memristor based Processing-In-Memory (PIM) systems give alternative solutions to boost the computing energy efficiency of Convolutional Neural Network (CNN) based algorithms. However, Analog-to-Digital Converters’ (ADCs) high interface costs and the limited size of the memristor crossbars make it challenging to map CNN models onto PIM systems with both high accuracy and high energy efficiency. Besides, it takes a long time to simulate the performance of large-scale PIM systems, resulting in unacceptable development time for the PIM system. To address these problems, we propose a reliability-aware training framework and a behavior-level modeling tool (MNSIM 2.0) for PIM accelerators. The proposed reliability-aware training framework, containing network splitting/merging analysis and a PIM-based non-uniform activation quantization scheme, can improve the energy efficiency by reducing the ADC resolution requirements in memristor crossbars. Moreover, MNSIM 2.0 provides a general modeling method for PIM architecture design and computation data flow; it can evaluate both accuracy and hardware performance within a short time. Experiments based on MNSIM 2.0 show that the reliability-aware training framework can improve 3.4× energy efficiency of PIM accelerators with little accuracy loss. The equivalent energy efficiency is 9.02 TOPS/W, nearly 2.6~4.2× compared with the existing work. We also evaluate more case studies of MNSIM 2.0, which help us balance the trade-off between accuracy and hardware performance.},
  keywords={Training;Computational modeling;Memristors;Tools;Reliability engineering;Energy efficiency;Hardware},
  doi={},
  ISSN={2153-697X},
  month={Jan},}@INPROCEEDINGS{11135029,
  author={Guttikonda, Kranthi Kumar and Chundru, Sri Dwaraka Vasu and Chintapalli, Manikanta Reddy},
  booktitle={2025 6th International Conference on Data Intelligence and Cognitive Informatics (ICDICI)}, 
  title={CaseBrief AI: Advanced Legal Summarization Explainability Engine}, 
  year={2025},
  volume={},
  number={},
  pages={503-508},
  abstract={Legal text analysis automation requires performing two essential operations that include role labeling and legal document summarization. Complex legal language surpasses standard methods in its ability to process both diversity and complexity. The authors propose a new methodology that unites XGBoost for role identification as well as hybrid summarization techniques with an optimized legal document model built using Legal-BERT. The proposed method commences with Legal-BERT to detect legal entities. The proposed summarization system merges extractive and abstractive methods for creating logical and concise summaries after role annotation has occurred. The model adopts SHAP and LIME XAI techniques for its decisionmaking process, which provides transparency and interpretability in its operations. The model demonstrates its effectiveness through experimental results done on extensive legal data, which exceeded basal methods during role tagging and summarization processes. The model's resistance is strengthened through the implementation of XGBoost, and it delivers intelligible explanations for its output using XAI techniques. This method enables legal professionals to obtain powerful tools that both enhance AI decision transparency and minimize the time needed for document analysis.},
  keywords={Resistance;Text analysis;Law;Explainable AI;Tagging;Data models;Complexity theory;Labeling;Standards;Engines;Legal document summarization;role labeling;Legal-BERT;XGBoost;Explainable AI;SHAP;LIME},
  doi={10.1109/ICDICI66477.2025.11135029},
  ISSN={},
  month={July},}@INPROCEEDINGS{11076507,
  author={Devapriya, T and Ganesan, V and Velmurugan, S},
  booktitle={2025 7th International Conference on Intelligent Sustainable Systems (ICISS)}, 
  title={An Enhanced Fibonacci Pascal Triangle to Protect the Eavesdropping Attacks in Wireless Sensor Network}, 
  year={2025},
  volume={},
  number={},
  pages={399-404},
  abstract={Safeguarding Wireless Sensor Networks (WSNs) from eavesdropping threats is crucial for maintaining secure communication in resource-limited settings. A cryptographic system using the Enhanced Fibonacci Pascal Triangle (EFPT) is presented to enhance security against unauthorized interception. The primary objective is to safeguard WSNs from eavesdropping attacks by using the features of the Fibonacci Pascal Triangle for secure key generation and encryption. The objective is to provide a lightweight and computationally efficient cryptographic method that improves data secrecy while reducing processing overhead. The goal is to provide an adaptive encryption framework that creates safe keys dynamically using Fibonacci-based binomial coefficients, guaranteeing unpredictability and robustness against cryptographic threats. The EFPT-based methodology provides enhanced resilience against brute force attacks, differential cryptanalysis, and pattern recognition methods, making it exceptionally appropriate for real-time WSN applications. EFPT improves security by merging mathematical concepts with contemporary cryptographic techniques, ensuring maximum performance for limited sensor nodes. The suggested paradigm maintains an equilibrium between security robustness and computing performance, facilitating smooth encryption and decryption in dynamic network settings. The EFPT architecture mitigates eavesdropping hazards, offering a robust and scalable solution for secure data transmission in wireless networks and laying a solid platform for future cryptographic developments.},
  keywords={Resistance;Wireless sensor networks;Computer architecture;Robustness;Real-time systems;Encryption;Computational efficiency;Cryptography;Security;Eavesdropping;Fibonacci Pascal Triangle;Eavesdropping Attacks;Wireless Sensor Networks;Cryptographic Key Generation;Data Security and Encryption},
  doi={10.1109/ICISS63372.2025.11076507},
  ISSN={},
  month={March},}@ARTICLE{11097074,
  author={Xiang, Xue-Kun and Yuan, Yu-Jie and Hu, Wen-Bo and Liu, Yu-Tao and Ma, Yue-Wen and Gao, Lin},
  journal={IEEE Transactions on Visualization and Computer Graphics}, 
  title={PGT-NeuS: Progressive-Growing Tri-Plane Representation for Neural Surface Reconstruction}, 
  year={2025},
  volume={31},
  number={10},
  pages={9213-9224},
  abstract={3D reconstruction from multi-view images is a long-standing problem in computer graphic. Neural 3D reconstruction, especially NeuS and its variants, has improved reconstruction quality compared to traditional methods. However, it is still a challenge for these methods to reconstruct fine-grained geometric details since the spherical harmonic positional encoding lacks the ability to express high-frequency signals. In this paper, we propose a multi-resolution tri-plane feature encoding that leverages the detail reconstruction capabilities of high-resolution tri-plane while using the smoothness of low-resolution tri-plane to suppress high-frequency artifacts. Additionally, a progressive training strategy is introduced, gradually merging scene details from coarse to fine granularity, enhancing reconstruction quality while maintaining training stability and reducing difficulty. Furthermore, to address reconstruction challenges arising from sparse viewpoints and inconsistent lighting in image datasets, we introduce normal priors as supervision and propose consistency verification for multi-view normal priors, which assesses the accuracy of normal priors and effectively supervise the reconstructed surfaces. Moreover, we propose a perturbing and fine-tuning strategy on regions of unreliable normal priors to further improve the quality of geometric surface reconstruction.},
  keywords={Image reconstruction;Surface reconstruction;Neural radiance field;Encoding;Training;Rendering (computer graphics);Accuracy;Three-dimensional displays;Image color analysis;Refining;Neural radiance field;surface reconstruction;progressive learning;normal priors verification},
  doi={10.1109/TVCG.2025.3590394},
  ISSN={1941-0506},
  month={Oct},}@ARTICLE{11417966,
  author={Jiang, Jingnan and Jiang, Mengjiao and Zhao, Ping and Shi, Wei and Chen, Dandan and Gui, Zhicheng and Wen, Xiaohang},
  journal={IEEE Transactions on Geoscience and Remote Sensing}, 
  title={Tracking Tibetan Plateau Mesoscale Convective Systems During the Warm Season and Their Impact on Sichuan Heavy Rainfall}, 
  year={2026},
  volume={64},
  number={},
  pages={1-14},
  abstract={Mesoscale convective systems (MCSs) over the Tibetan Plateau (TP) strongly influence downstream rainfall. In plateau regions, existing single-threshold identification algorithms often have high misidentification rates in plateau regions, because cold cirrus can be misclassified as convection when using only blackbody brightness temperature (TBB), and the complete evolution of MCSs is not fully represented by conventional area-overlap tracking. This study improves an area-overlap with Kalman-filtering (AOL-KF) tracking algorithm for the warm seasons (May–October) of 2019–2023 over the TP by introducing a rainfall constraint, in which Fengyun-4A (FY-4A) TBB is coupled with GMCP merged rainfall through a rain-rate threshold (Rrt), and FY-4A cloud type (CLT) is incorporated as auxiliary cloud information. This study improves MCS identification by integrating GMCP precipitation data, and the rainfall constraint is further evaluated using ground-based Ka-band millimeter-wave cloud radar (GB-MMCR) observations at Naqu and Yushu during July–August 2020. The results show that cirrus-induced misidentification is suppressed, and the resulting satellite-based MCS identification and tracking are more consistent with radar diagnostics. From the reconstructed trajectories, potential MCSs (PMCSs) that subsequently develop into MCSs are mainly concentrated east of 85°E and south of 35°N in TP. Overall, 61.14% of TP MCSs propagate toward the east (eastward-leaning directions); relative to all TP MCS events, 1.85% move out of the plateau and 0.93% further enter Sichuan. A pronounced meridional gradient in TP MCS translation speed is indicated, with a mean speed of 60.50 km h−1 north of 30°N, approximately 1.25 times that to the south. Based on ERA5 winds, statistically significant links between 200 and 400 hPa flow and MCS motion are identified: wind speed is weakly but significantly correlated with MCS speed (r = 0.18–0.20%, 99% significance), whereas wind direction exhibits a stronger correlation with MCS movement direction (r = 0.29–0.34, 99% significance). A representative high-impact event was selected from TP-origin MCSs entering Sichuan. The case study indicates that these systems experienced significant enhancement upon entering Sichuan, attributable to merger with locally generated or stalled convection and to an environment with enhanced low-level moisture convergence, strengthened secondary circulation, and increased instability; these conditions intensify the coupling among ascent, condensation-related moisture sink, and latent heating, thereby improving organization and expanding the rainfall-affected area.},
  keywords={Clouds;Rain;Radar tracking;Spatial resolution;Satellites;Radar;Weather;Spaceborne radar;Satellite broadcasting;Millimeter wave radar;Fengyun-4A (FY-4A) satellite;heavy rainfall in Sichuan;mesoscale convective systems (MCSs);Tibetan Plateau (TP);tracking algorithm improvement},
  doi={10.1109/TGRS.2026.3669296},
  ISSN={1558-0644},
  month={},}@ARTICLE{9928153,
  author={Janssen, Miriam and LeWarne, Christopher and Burk, Diana and Averbeck, Bruno B.},
  journal={Journal of Cognitive Neuroscience}, 
  title={Hierarchical Reinforcement Learning, Sequential Behavior, and the Dorsal Frontostriatal System}, 
  year={2022},
  volume={34},
  number={8},
  pages={1307-1325},
  abstract={To effectively behave within ever-changing environments, biological agents must learn and act at varying hierarchical levels such that a complex task may be broken down into more tractable subtasks. Hierarchical reinforcement learning (HRL) is a computational framework that provides an understanding of this process by combining sequential actions into one temporally extended unit called an option. However, there are still open questions within the HRL framework, including how options are formed and how HRL mechanisms might be realized within the brain. In this review, we propose that the existing human motor sequence literature can aid in understanding both of these questions. We give specific emphasis to visuomotor sequence learning tasks such as the discrete sequence production task and the M × N (M steps × N sets) task to understand how hierarchical learning and behavior manifest across sequential action tasks as well as how the dorsal cortical–subcortical circuitry could support this kind of behavior. This review highlights how motor chunks within a motor sequence can function as HRL options. Furthermore, we aim to merge findings from motor sequence literature with reinforcement learning perspectives to inform experimental design in each respective subfield.},
  keywords={},
  doi={10.1162/jocn_a_01869},
  ISSN={0898-929X},
  month={July},}@ARTICLE{11433403,
  author={Singh, Pankaj Kumar and Varshney, Gaurav},
