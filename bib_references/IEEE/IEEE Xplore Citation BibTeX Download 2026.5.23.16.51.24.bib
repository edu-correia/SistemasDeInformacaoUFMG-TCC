  author={Zhu, Yeqing and Zhao, Liangyu and Zhao, Qingjie and Wu, Zhenyu and Shen, Hongming and Wang, Danwei},
  booktitle={2024 18th International Conference on Control, Automation, Robotics and Vision (ICARCV)}, 
  title={PLP-SLAM: Point-Line-Plane Simultaneous Localization and Mapping}, 
  year={2024},
  volume={},
  number={},
  pages={245-250},
  abstract={For indoor environments, prior point-based visual SLAM cannot be processed in real time under low texture and illumination. To address this issue, this work proposes PLP-SLAM (Point-Line-Plane-SLAM) with RGB-D camera. Firstly, point and line features are detected in RGB images. For line features, establish length suppression and near line merge strategy to improve the line extraction quality. Secondly, plane features are extracted based on agglomerative hierarchical clustering method in point cloud obtained by RGB-D camera. Point clouds are divided into several nodes, unlike prior methods spend a lot of time to estimate the normal vector for each individual point, this work assumes that points within each node sharing the same plane normal vector, which can significantly improve the computational efficiency. Thirdly, sparse maps including points, lines and planes are established, meanwhile the scenes are reconstructed by creating the dense maps to show plan features directly. Finally, the performance of proposed method is compared against the state-of-the-art SLAM on public datasets to evaluate the pose estimation. All modules are run in real-time on a CPU, experiments clarify that PLP-SLAM can significantly enhance the robustness of 6DoF pose of the camera and simultaneously creating more detailed maps of the environment.},
  keywords={Visualization;Simultaneous localization and mapping;Pose estimation;Robot vision systems;Feature extraction;Cameras;Robustness;Real-time systems;Vectors;Robots},
  doi={10.1109/ICARCV63323.2024.10821614},
  ISSN={2474-963X},
  month={Dec},}@ARTICLE{11419808,
  author={Chakrabarty, Sourav and Chakraborty, Anirvan and De, Shyamal K.},
  journal={IEEE Transactions on Pattern Analysis and Machine Intelligence}, 
  title={Near-Perfect Clustering Based on Recursive Binary Splitting Using Max-MMD}, 
  year={2026},
  volume={},
  number={},
  pages={1-14},
  abstract={We develop novel clustering algorithms for functional data when the number of clusters $K$ is unspecified and also when it is specified. These algorithms are developed based on the Maximum Mean Discrepancy (MMD) measure between the empirical distributions associated with two sets of observations. The algorithms recursively use a binary splitting strategy to partition the dataset into two subgroups such that they are maximally separated in terms of an appropriate weighted MMD measure. When $K$ is unspecified, the proposed clustering algorithm has an additional step to check whether a group of observations obtained by the binary splitting technique consists of observations from a single population. We also learn $K$ directly from the data using this algorithm. When $K$ is specified, a modification of the previous algorithm is proposed which consists of an additional step of merging subgroups which are similar in terms of the weighted MMD distance. The theoretical properties of the proposed algorithms are investigated in an oracle scenario that requires the knowledge of the empirical distributions of the observations from different populations involved. In this setting, we prove that the algorithm proposed when $K$ is unspecified achieves perfect clustering while the algorithm proposed when $K$ is specified has the perfect order preserving (POP) property. Extensive real and simulated data analyses using a variety of models having location difference as well as scale difference show near-perfect clustering performance of both the algorithms which improve upon the state-of-the-art clustering methods for functional data.},
  keywords={Clustering algorithms;Partitioning algorithms;Kernel;Indexes;Q measurement;Hilbert space;Hands;Data models;Data analysis;Clustering methods;Characteristic kernel;empirical distributions;functional data;maximum mean discrepancy;oracle analysis;perfect order preserving;rand index},
  doi={10.1109/TPAMI.2026.3669975},
  ISSN={1939-3539},
  month={},}@INPROCEEDINGS{10411583,
  author={Moon, Hyung-Jun and Cho, Sung-Bae},
  booktitle={2023 IEEE International Conference on Data Mining Workshops (ICDMW)}, 
  title={Exploiting Local Information with Subgraph Embedding for Graph Neural Networks}, 
  year={2023},
  volume={},
  number={},
  pages={1113-1120},
  abstract={Graph neural networks (GNNs) have shown success in various data mining tasks, including graph classification. Yet, as GNNs progress through deeper layers, they face a significant challenge: the dilution of local information across the graph. This is especially problematic for graph classification tasks, which integrate node features to produce a single graph embedding. In this paper, we introduce a subgraph embedding method for GNNs that aims to balance global and local information, thereby mitigating information dilution. Our method explicitly partitions a graph by removing edges between nodes, selecting subgraphs based on the minimal external degree. This method ensures limited information exchange and maintains local node characteristics, even with additional layers. An algorithm considers subgraph-level characteristics to strike a balance between global and local information. Multiple independent GNNs then process these subgraphs, and their features merge for graph classification. Rigorous testing on 11 benchmark datasets against 14 leading methods reveals that our method excels in 95 out of 154 instances, achieving a peak performance increase of 5.4%p. Notably, with increasing layers, our method consistently outshines traditional techniques, underlining its prowess in countering information dilution in GNNs.},
  keywords={Training;Graph neural networks;Classification algorithms;Partitioning algorithms;Data mining;Reliability;Task analysis;Graph Classification;Graph Neural Networks (GNNs);Graph Partitioning;Local Information Preserving;Over-smoothing},
  doi={10.1109/ICDMW60847.2023.00146},
  ISSN={2375-9259},
  month={Dec},}@INPROCEEDINGS{10074024,
  author={Agarwal, Akshat and Kumar Agarwal, Mohit and Shankar, Aditya and Singh Parihar, Anil},
  booktitle={2022 4th International Conference on Advances in Computing, Communication Control and Networking (ICAC3N)}, 
  title={Low-Light Image Enhancement Using Multi-Branch Deep Fusion Enhancement Network}, 
  year={2022},
  volume={},
  number={},
  pages={914-919},
  abstract={Deficiencies like lack of visibility, blurry images, and noise affect almost all images captured in less-than-ideal lighting conditions. To cope with this issue, we propose the multi-branch Deep Fusion Enhancement Network (DFEN) that utilizes artificially generated multi-exposure images for the image enhancement operation. The model extracts feature from various levels from the different multi-exposure images and then combine the re-calibrated features to generate an overall enhanced low-light image. The model makes use of the Feature Extraction Module (FEM) to draw out features from different levels of the image, Feature Enhancement Module (EM) to enhance the features extracted, and Feature Fusion and Re-calibration Module (FFRM) to re-calibrate enhanced features, and finally merge them into an enhanced low-light image. The proposed model was evaluated on various datasets and showed to outperform various state-of-the-art techniques significantly. Additionally, numerical results for the proposed DFEN model show it outperforms other approaches in either qualitative or quantitative metrics.},
  keywords={Measurement;Computational modeling;Lighting;Feature extraction;Numerical models;Finite element analysis;Image enhancement;Low-Light Image Enhancement;Deep-Learning;Multi-Image Fusion},
  doi={10.1109/ICAC3N56670.2022.10074024},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10633036,
  author={Qiao, Lingfeng and Liu, Guodong and Lu, Cheng and Lu, Binghui},
  booktitle={2024 IEEE International Conference on Mechatronics and Automation (ICMA)}, 
  title={Research on Target Localization Technology based on Depth of field fusion of generative adversarial networks}, 
  year={2024},
  volume={},
  number={},
  pages={1868-1874},
  abstract={Target positioning is a crucial step in beam target coupling, but the multi channel imaging system of the beam target coupling sensor struggles to obtain reliable target position information due to its small depth of field and poor illumination. This paper proposes a depth of field fusion algorithm based on generative adversarial networks that can merge multiple partially clear target images into a single image with higher clarity, thereby extending the depth of field and improving the accuracy of target positioning. Specifically, we first use OpticalFlow Net to estimate the optical flow to warp the source image and defocused image to a unified camera view, then generate an image with clear target edges using Fusion Net; finally, we extract the target position parameters through post processing methods such as edge detection to assist in high precision positioning. Additionally, to train our network, we created a multi focus pixel misaligned dataset based on the principle of point spread. Experimental results show that our algorithm outperforms existing advanced methods in both quality and effectiveness, being able to control the target positioning accuracy within 2.7μm, meeting the accuracy requirements.},
  keywords={Couplings;Location awareness;Accuracy;Shape;Image edge detection;Generative adversarial networks;Cameras;Depth of field fusion;Target positioning;GANs;PSF},
  doi={10.1109/ICMA61710.2024.10633036},
  ISSN={2152-744X},
  month={Aug},}@INPROCEEDINGS{11265638,
  author={Kumar, Munish and V, Vijaya Kumar A and T, Shahida and Sharma, Yogesh Kumar and Kumar, Ramakrishna},
  booktitle={2025 International Conference on Intelligent and Secure Engineering Solutions (CISES)}, 
  title={Swarm Intelligence-Based Image Reconstruction: A Bio-Inspired Optimization Framework}, 
  year={2025},
  volume={},
  number={},
  pages={28-33},
  abstract={The reconstruction of images represents a critical process within computer vision since it helps restore deteriorated images with excellent quality. The effectiveness of deep learning-based approaches exists while the methods encounter problems because they trigger high computational expenses along with delayed convergence together with local minimum features. This paper develops Swarm Intelligence-Based Image Reconstruction which adopts Particle Swarm Optimization (PSO) and Ant Colony Optimization (ACO) to improve reconstruction optimization. By merging bio-inspired optimization techniques the proposed framework gives enhanced results with cleaner images alongside better structural quality. The DIV2K dataset served as the test platform for extensive experimentation in image super-resolution studies because researchers consider it a standard benchmark. The proposed method demonstrated PSNR measurement of 32.8 dB and SSIM result of 0.94 which surpassed deep learning approaches for standard image reconstruction tasks. The proposed system surpassed foremost approaches through a 15% improvement in accuracy measurements together with a reduction in computational demands by 20%. The proposed model showed enhanced generalization abilities when dealing with various levels of image deterioration. The achieved results validate Swarm Intelligence-based optimization as it operates as a sustainable method to serve instead of deep learning for image reconstruction tasks.},
  keywords={Deep learning;Ant colony optimization;Accuracy;Visual systems;Particle swarm optimization;Image reconstruction;Optimization;Standards;Biomedical imaging;Convergence;Swarm Intelligence;Image Reconstruction;Bio-Inspired Optimization;Particle Swarm Optimization;Ant Colony Optimization;PSNR;SSIM;Machine Learning;Deep Learning;Image Processing},
