  author={Li, Zhuoyi and Yip, Tsz Leung and Lee, JungWook and Zhang, Fan},
  booktitle={2025 8th International Conference on Transportation Information and Safety (ICTIS)}, 
  title={Hierarchical Multi-Plan Decision-making in Merging Mixed Waterways Based on Stackelberg Game}, 
  year={2025},
  volume={},
  number={},
  pages={1692-1699},
  abstract={This paper introduces a hierarchical multi-plan model predictive control (MPB-MPC) framework combining Stackelberg Game and risk-aware decision-making as a solution to the challenge of integrating maritime autonomous surface ship (MASS) in mixed scenarios involving both human-operated ships (HOS) and MASS. The framework models interactions between a leader ship (LS) and a follower ship (FS) as a Stackelberg Game, where the LS plans trajectories anticipating the FS’s responses, either cooperative or non-cooperative, while optimizing merging efficiency. A dual-planning sequence mechanism balances trajectory optimality with safety margins by fusing an efficient path and a conservative risk-averse path, adjusting safety constraints dynamically based on probabilistic intent estimates of the FS. The LS adaptively updates its belief state of the FS’s behavioral intention using observations of the FS’s motion state, enabling real-time strategy adaptation. Simulations show the proposed method achieves efficient collision-free merging in both cooperative and non-cooperative scenarios: in cooperation, the LS minimizes control effort via FS alignment; in competition, it counters adversarial actions by acceleration. This approach demonstrates a systematic solution balancing safety and operational efficiency in mixed maritime traffic scenarios involving merging into navigable channels maneuvers of both MASSs and HOVs.},
  keywords={Merging;Decision making;Estimation;Games;Probabilistic logic;Real-time systems;Safety;Trajectory;Marine vehicles;Predictive control;Stackelberg game;Intelligent ship navigation;Risk-aware control;Cooperative-competitive interaction},
