  month={Dec},}@INPROCEEDINGS{6141651,
  author={Mohamed, Hasimah Hj and Kheng, Tee Leong and Collin, Chee and Lee, Ong Siong},
  booktitle={2011 First International Conference on Informatics and Computational Intelligence}, 
  title={E-Clean: A Data Cleaning Framework for Patient Data}, 
  year={2011},
  volume={},
  number={},
  pages={63-68},
  abstract={We need to prepare quality data by pre-processing the raw data. Data cleaning, also called data cleansing or scrubbing, deals with detecting and removing errors and inconsistencies from data in order to improve the quality of data. Data cleaning system are needed to support any changes in the structure, representation or content of data. There are three parts in the cleaning process, i.e. extract the invalid value, matching attributes with valid values and data cleaning algorithm. Our system uses the extract, transform and load model as the system main process model to serve as a guideline for the implementation of the system. Besides that, parsing techniques is also use for the identification of dirty data. The method that we choose for matching attributes is regular expression. Among those data cleaning algorithms, k-Nearest Neighbor algorithm is selected for the data cleaning part of this project because it is simple to understand and easy to implement.},
  keywords={Databases;Cleaning;Knowledge based systems;Load modeling;Transforms;Data mining;Classification algorithms;data cleaning;regular expression;k-Nearest Neighbor},
  doi={10.1109/ICI.2011.21},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{4063778,
  author={Lv, Ertao and Duan, Zhenhua and Qi, Jian-jun and Cao, Yang and Peng, Zhuo},
  booktitle={First International Conference on the Digital Society (ICDS'07)}, 
  title={Incorporating Clusters into Hybrid P2P Network}, 
  year={2007},
  volume={},
  number={},
  pages={17-17},
  abstract={Structured P2P network is popular nowadays. However, the network needs reorganized when the peers are joining or leaving. To reduce the performance degradation caused by the reorganizations, we proposed a two-layer hybrid P2P network (HP2P). The upper layer is chord network and the lower layer is cluster in HP2P. In this paper, the cluster is described in detail. Peers are organized into clusters, and the network reorganizations are restricted within the clusters where a peer can join or leave. Besides, each cluster is also enhanced through some specific mechanisms such as Supernode, metadata redundancy and gossip flooding. Consequently, the two layers P2P become more robust. Further, the high efficiency of distributed hash tables(DHTs) can be retained, and the churn caused by excessive node joining and leaving can be reduced.},
  keywords={Peer to peer computing;Floods;Robustness;Internet;Computer networks;Degradation;Network topology;Keyword search;Humans;Geography},
