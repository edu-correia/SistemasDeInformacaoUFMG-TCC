  year={2006},
  volume={},
  number={},
  pages={339-342},
  abstract={Views have long been used as a means to structure and manage conceptual models. Model management aims to keep track of the relationships between a set of views as they evolve, and to describe the manipulations performed over them in terms of a set of predefined operators. A major challenge in model management is handling the incompleteness and inconsistency of views. In this extended abstract, we describe a general framework for the management of incomplete and inconsistent views. We use our framework as a basis for exploring the systematic application of important design principles, such as traceability, reusability and separation of concerns, in model management},
  keywords={Engineering management;Logic;Software engineering;Conference management;Databases;Computer science;Terminology;Context modeling;Application software},
  doi={10.1109/ASE.2006.48},
  ISSN={1938-4300},
  month={Sep.},}@INPROCEEDINGS{4673598,
  author={Wang, Xiaofei and Fang, Ming},
  booktitle={First International Multi-Symposiums on Computer and Computational Sciences (IMSCCS'06)}, 
  title={Two Post-Scheduling Optimization Algorithms for Distributed Real-Time Tasks Based on Scheduled Cluster Tree}, 
  year={2006},
  volume={1},
  number={},
  pages={510-517},
  abstract={To overcome the disadvantages of the existing task duplication-based algorithms, this paper discusses the scheduling objectives of distributed real-time tasks, presents a novel structure called scheduled cluster tree, and proposes a general optimization method for various task duplication-based algorithms. According to the result of experiments, PSO_I and PSO_II are both general algorithms that improve the schedules generated by various task duplication-based algorithms. PSO_I aims to optimize the schedules in minimizing the number of required processors without affecting the optimal scheduling length acquired. PSO_II aims to increase the utilization of processors at the acceptable expense of the scheduling length (i.e., in the range of deadline) besides minimizing the number of required processors. The time complexities of both methods match approximately that of the typical task duplication-based algorithms, e.g., the task duplication based scheduling algorithm and the optimal scheduling algorithm based on task duplication},
  keywords={Clustering algorithms;Scheduling algorithm;Optimal scheduling;Processor scheduling;Costs;Real time systems;Computational efficiency;Distributed computing;Optimization methods;Computer networks},
  doi={10.1109/IMSCCS.2006.138},
  ISSN={},
  month={June},}@INPROCEEDINGS{5364279,
  author={Du, Ming and Guo, Yongming and Wang, Zhijun and Le, Jiajin},
  booktitle={2009 International Conference on Information Engineering and Computer Science}, 
  title={The Design of a Logging Approach for B+-Tree Index on Flash-Based DBMS}, 
  year={2009},
  volume={},
  number={},
  pages={1-4},
  abstract={Flash memory is being rapidly deployed as data storage for mobile devices. With its capacity increasing and price dropping, flash memory will finally take the place of magnetic disk. It is possible for us to consider running a database system on the flash computing platforms. Therefore, this requires an efficient index structure to locate a particular item quickly from a huge amount of database records. However, disk-based database index can not be used on flash memory directly because of different characteristics between flash memory and magnetic disk. In this paper, we propose a logging approach for B+-tree index on flash-based DBMS. This new approach makes use of the characteristics of flash memory effectively to acquire more benefits from using traditional database index technology on flash memory.},
  keywords={Flash memory;Indexes;Delay;Magnetic devices;Database systems;Computer aided manufacturing;Portable computers;Sun;Technology management;Educational institutions},
  doi={10.1109/ICIECS.2009.5364279},
  ISSN={2156-7387},
  month={Dec},}@INPROCEEDINGS{7077653,
  author={Pikrakis, Aggelos and Theodoridis, Sergios},
  booktitle={2009 17th European Signal Processing Conference}, 
  title={Adaptive structural analysis of music recordings}, 
  year={2009},
  volume={},
  number={},
  pages={919-923},
  abstract={This paper presents a structure mining scheme for music recordings. The term adaptive refers to the fact that the method relies on an adaptive scheme to detect similarity on the diagonals of the self-similarity matrix of the recording and removes the need for hard thresholds during this processing stage. Structural analysis is subsequently cast in a clustering framework. The output of the adaptive scheme is used to initialize a hierarchical data clustering algorithm whose output is a representation of the recording in terms of non-overlapping repeating patterns. The proposed method has been evaluated on a corpus of popular music recordings and various performance measures have been computed.},
  keywords={Multiple signal classification;Abstracts;Vectors;Virtual private networks;Multimedia communication},
  doi={},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{7232165,
  author={Li-li, Wang and Yue, Wu and Wan-le, Wang},
  booktitle={2015 International Conference on Transportation Information and Safety (ICTIS)}, 
  title={A decision making approach at an air highway ramp}, 
  year={2015},
  volume={},
  number={},
  pages={787-791},
  abstract={In order to alleviate the increasingly serious air traffic congestion problem, a new airspace structure named air highway was proposed by researchers, who have been designing and improving the operation methods and rules for air highway ever since. According to the operation characteristics of air highway, this paper proposes a slot allocation method for aircraft to enter an air highway. Taking into consideration the delay costs and route utilization costs for both the air highway and the conventional route, a mathematical decision making model based on the minimum cost is established, and the appropriate algorithm is described. In the last section this paper presents a simulation case, which calculates the times for aircraft to enter the air highway and provides the results of using the decision making model. The simulation results show that the model and algorithm are effective.},
  keywords={Aircraft;Road transportation;Atmospheric modeling;Delays;Air traffic control;Decision making;air transportation;air highway;slot allocation;decision making},
  doi={10.1109/ICTIS.2015.7232165},
  ISSN={},
  month={June},}@INPROCEEDINGS{1552935,
  author={Pu Huang},
  booktitle={IEEE International Conference on e-Business Engineering (ICEBE'05)}, 
  title={Capacity allocation for business processes with QoS requirements: a heavy traffic approach}, 
  year={2005},
  volume={},
  number={},
  pages={488-495},
  abstract={The Business Process Execution Language for Web services (BPEL) provides a common standard for modeling and sharing business processes across enterprises via Web services. Business applications that handle different operations within a business process usually share computational capacity. In this paper, we provide a method to allocate computational capacity across these applications. Our method takes the following factors into consideration: random arrivals of business process instances, service time fluctuations of business applications, quality of service (QoS) requirements, and the composition structure of the business process specified by BPEL. Using heavy traffic approximations, we formulate and solve the capacity allocation problem as a nonlinear optimization problem with QoS constraints; our method also gives a pessimistic bound on the maximum sustainable request rate the system can support},
  keywords={Web services;Quality of service;Traffic control;Telecommunication traffic;Fluctuations;Constraint optimization;Network servers;Databases;Resource management;Queueing analysis},
  doi={10.1109/ICEBE.2005.36},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{5533293,
  author={Lin, Shan and Wang, Han and Hu, Yanzhong},
  booktitle={2010 2nd International Symposium on Information Engineering and Electronic Commerce}, 
  title={Research on Undetermined Value of First Use Based on Lattice Framework}, 
  year={2010},
  volume={},
  number={},
  pages={1-4},
  abstract={This paper reports on the theoretical principle and many applications of data-flow analysis. However, current developments of data flow analysis are primarily undertaken by individual problem and lead to a plethora of specific solutions. We formulate a general framework with lattice theory, which provides a single formal model for various data-flow analyses. It helps us focus on the specific details of different data flow problems. Furthermore, we take a common data flow problem detecting variables' undetermined value of first use as an instance and give a structured approach to solve these problems based on lattice framework for data-flow analysis.},
  keywords={Lattices;Data analysis;Equations;Paper technology;Information analysis;Algorithm design and analysis;Computer science;Application software;Transfer functions;Optimizing compilers},
  doi={10.1109/IEEC.2010.5533293},
  ISSN={},
  month={July},}@INPROCEEDINGS{6653447,
  author={Herrera, Costanza and Vandenbosch, Guy A. E.},
  booktitle={2013 International Symposium on Electromagnetic Compatibility}, 
  title={Systematic study of double-layered ultra-thin stacked patch absorbers}, 
  year={2013},
  volume={},
  number={},
  pages={998-1003},
  abstract={We present a sensitivity study of a double-layered metamaterial absorber with two stacked patches. Two parameters of the topology are systematically tuned: the thickness of the top layer, and the size of the top patch. When parameters are tuned properly, a single-resonance-like behaviour with two resonators can be seen. Absorptions of more than 99 % can be achieved, despite the simplicity of the structure.},
  keywords={Absorption;Reflectivity;Bandwidth;Resonant frequency;Electromagnetic compatibility;Metamaterials;Frequency response},
  doi={},
  ISSN={2325-0364},
  month={Sep.},}@INPROCEEDINGS{6744760,
  author={Micoli, Laura and Guidi, Gabriele and Angheleddu, Davide and Russo, Michele},
  booktitle={2013 Digital Heritage International Congress (DigitalHeritage)}, 
  title={A multidisciplinary approach to 3D survey and reconstruction of historical buildings}, 
  year={2013},
  volume={2},
  number={},
  pages={241-248},
  abstract={The aim of this research is to suggest a methodology based on 3D survey and reconstructive modeling, suitable to increase the actual knowledge of an historical building and supporting its historical interpretation. The case study used for testing the proposed methodology is the huge Chartreuse of Pavia, with a special focus on a relatively unexplored portion of the monument. The survey, based on 3D laser scanning and orthoimages, integrated by historical studies and other complementary information (thermoluminescence dating, IR imaging, hystorical analysis), allowed to read all the architectural aspects hidden in this highly architecturally stratified monument, improving in this way the comprehension of the building's transformations in time. A 3D reconstruction approach was then suggested, merging several information of different nature, from the actual geometry of the building to the interpretation of historical documents, suggesting a sequence of diachronic models as virtual narration of the historical evolution. On other hand the 3D models were used to obtain a cross-validation of the historical evolution hypotheses developed by experts in the various disciplines involved in the project. The data collected were exploited through a web portal in order to enhance the readability of tangible and intangible heritage associated to that Chartreuse portion, nowadays not accessible to common public.},
  keywords={Three-dimensional displays;Buildings;Solid modeling;Libraries;Image reconstruction;Data models;Analytical models;Multi-scale approach;3D survey;point cloud analysis;virtual reconstruction;diachronic reconstruction;promotion of Cutural Heritage},
  doi={10.1109/DigitalHeritage.2013.6744760},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{5402564,
  author={Ayadi, Rami and Maraoui, Mohsen and Zrigui, Mounir},
  booktitle={2009 International Conference for Internet Technology and Secured Transactions, (ICITST)}, 
  title={Intertextual distance for Arabic texts classification}, 
  year={2009},
  volume={},
  number={},
  pages={1-6},
  abstract={Our researches works are interested on the application of the intertextual distance theory on the Arabic language as a tool for the classification of texts. This theory assumes the classification of texts according to criteria of lexical statistics, and it is based on the lexical connection approach. Our objective is to integrate this theory as a tool of classification of texts in Arabic language. It requires the integration of a metrics for the classification of texts using a database of lemmatized and identified corpus which can be considered as a literature reference for times, kinds, literary themes and authors and this in order to permit the classification of anonymous texts.},
  keywords={Text categorization;Laboratories;Statistics;Databases;Indexing;Character recognition;Text recognition;Merging;Fusion power generation},
  doi={10.1109/ICITST.2009.5402564},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{1494027,
  author={Kuang, J.B. and Buchholtz, T.C. and Dance, S.M. and Warnock, J.D. and Storino, S.N. and Wendel, D. and Bradley, D.H.},
  booktitle={ISSCC. 2005 IEEE International Digest of Technical Papers. Solid-State Circuits Conference, 2005.}, 
  title={A double-precision multiplier with fine-grained clock-gating support for a first-generation CELL processor}, 
  year={2005},
  volume={},
  number={},
  pages={378-605 Vol. 1},
  abstract={The feasibility of a fully integrated RF front-end using an above-IC BAW integration technique is demonstrated for WCDMA applications. The circuit has a voltage gain of 31.3dB, a noise figure of 5.3dB, an in-band IIP3 of -8dBm and IIP2 of 38dBm, with a total power consumption of 36mW. The BAW filter area is 0.45mm/sup 2/ and the total circuit area including the BAW filter is 2.44mm/sup 2/.},
  keywords={Clocks;Delay;Latches;Circuits;Scalability;Wires;Merging;Hardware;Capacitors;Logic devices},
  doi={10.1109/ISSCC.2005.1494027},
  ISSN={2376-8606},
  month={Feb},}@INPROCEEDINGS{5583564,
  author={Cho, Seongho and Wang, Jingwei and Kuo, C.-C. Jay and Cha, Byung-Ho},
  booktitle={2010 IEEE International Conference on Multimedia and Expo}, 
  title={Block-based image steganalysis for a multi-classifier}, 
  year={2010},
  volume={},
  number={},
  pages={1457-1462},
  abstract={Traditional image steganalysis techniques for classification of steganograhic algorithms are conducted with respect to the entire image. In this work, we aim to design a multi-classifier which classifies stego images depending on their steganographic algorithms in addition to distinguishing stego images from cover images. This classification is based on steganalysis results of decomposed image blocks. As a natural image often consists of heterogeneous regions, its decomposition will lead to smaller image blocks, each of which is more homogeneous. We classify these image blocks into multiple classes and find a classifier for each class to decide whether a block is from a cover image or a stego image with a specific steganographic algorithm. Consequently, the steganalysis of the whole image can be conducted by fusing weighted steganalysis results of all image blocks through a voting process. Experimental results will be given to show the advantage of using the proposed block-based image steganalysis for a multi-classifier.},
  keywords={Accuracy;Feature extraction;Training;Markov processes;Discrete cosine transforms;Classification algorithms;Testing;Steganalysis;Multi-Classifier;Steganography;Tree-Structured Vector Quantization (TSVQ)},
  doi={10.1109/ICME.2010.5583564},
  ISSN={1945-788X},
  month={July},}@INPROCEEDINGS{7119160,
  author={Gellerman, Nicholas and Kaabouch, Naima and Semke, William},
  booktitle={2015 IEEE Aerospace Conference}, 
  title={A terrain avoidance algorithm based on the requirements of terrain awareness and warning systems}, 
  year={2015},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper describes a method in which databases of terrain and obstacles maintained by government agencies are combined into a single database with the final goal of implementation into a sense-and-avoid algorithm currently in development at the University of North Dakota. With the new regulations set forth by the Federal Aviation Administration, strict requirements have to be met before unmanned aerial vehicles are allowed integration into the national airspace. Amongst these requirements is an ability to automatically avoid large obstacles, i.e., buildings, hills, mountains, and airports.},
  keywords={Databases;Meters;Aircraft;Poles and towers;FAA;Buildings;Stacking;Military aircraft;Merging;Indexes;Sense-and-Avoid;UAV;UAS;large obstacles},
  doi={10.1109/AERO.2015.7119160},
  ISSN={1095-323X},
  month={March},}@INPROCEEDINGS{7984452,
  author={Leibin Guan and Jizheng Chu},
  booktitle={2017 2nd International Conference on Image, Vision and Computing (ICIVC)}, 
  title={Natural scene text detection based on SWT, MSER and candidate classification}, 
  year={2017},
  volume={},
  number={},
  pages={26-30},
  abstract={This paper presents a novel scene text detection algorithm based on Stroke Width Transform (SWT), Maximally Extremal Regions (MSER) and candidate classification. Firstly, utilize the SWT and MSER to extract the candidate characters at the same time. Secondly, preliminary filtering the candidate connected components based on heuristic rules. Thirdly, using mutual verification and integration to class all candidate into two categories: strong candidates, weak candidates. If the weak candidate has similar properties with strong candidate, then the weak candidate is changed into strong candidate. Finally, the text area is aggregated into text lines by text line aggregation algorithm. The experiment results on public datasets show that the proposed method can detect text lines effectively.},
  keywords={Image edge detection;Feature extraction;Filtering theory;Computational efficiency;Merging;text detection;connected component;Maximally Extremal Regions (MSER);Stroke Width Transform (SWT);candidate classification},
  doi={10.1109/ICIVC.2017.7984452},
  ISSN={},
  month={June},}@INPROCEEDINGS{5381303,
  author={Kook, Youn-Gyou and Lee, Joon and Kim, Jae-Soo},
  booktitle={2009 International Conference on Innovation Management}, 
  title={E-Government Grid System Based on Multi-agent for Interoperability}, 
  year={2009},
  volume={},
  number={},
  pages={7-10},
  abstract={In this paper, we present e-government grid system to provide the seamless services to the public. The main goal of e-government systems is to promote the accessibility of government's information created by the various processing among the public sectors. The needs of sharing data and processes from the legacy systems are currently increased. However, it is difficult to convert the interoperable infrastructure from distributed and independent legacy systems in governments. Further, it requires more cost, labor and times to gain the advantages from the legacy. In this paper, we suggest the grid based integrated environments to use the distributed legacy systems in ease, as to solve the issued problems. The grid environments consist of a set of grid-middleware that connects to database and systems. The grid-middleware should be light-weight and flexible to guarantee the integrity of the independent legacy systems. Therefore we describe the middleware based on the multi-agents and consequently show data interoperation from e-government grid system through the integration of legacy systems. It is expected to reduce cost and time, as well as easily builds the cooperating environments on government's legacy systems.},
  keywords={Electronic government;Costs;Middleware;Distributed databases;Innovation management;Merging;Intserv networks;Face;Portals;Standardization},
  doi={10.1109/ICIM.2009.41},
  ISSN={},
  month={Dec},}
