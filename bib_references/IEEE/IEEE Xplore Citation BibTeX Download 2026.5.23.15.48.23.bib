@ARTICLE{11293409,
  author={Feng, Zhi-Qiang and Liu, Cun-Gen and Huang, Hu},
  journal={Journal of Zhejiang University-SCIENCE C (Computers & Electronics)}, 
  title={Knowledge Modeling based on Interval-Valued Fuzzy Rough Set and Similarity Inference: Prediction of Welding Distortion}, 
