  year={2011},
  volume={},
  number={},
  pages={1273-1276},
  abstract={The work presented here proposes a new Binary Partition Tree pruning strategy aimed at the segmentation of hyperspectral images. The BPT is a region-based representation of images that involves a reduced number of elementary primitives and therefore allows to design a robust and efficient segmentation algorithm. Here, the regions contained in the BPT branches are studied by recursive spectral graph partitioning. The goal is to remove subtrees composed of nodes which are considered to be similar. To this end, affinity matrices on the tree branches are computed using a new distance-based measure depending on canonical correlations relating principal coordinates. Experimental results have demonstrated the good performances of BPT construction and pruning.},
  keywords={Merging;Image segmentation;Hyperspectral imaging;Correlation;Partitioning algorithms;Symmetric matrices;Hyperspectral imaging;Binary Partition Tree;canonical correlations;segmentation;graph partitioning},
  doi={10.1109/ICIP.2011.6115666},
