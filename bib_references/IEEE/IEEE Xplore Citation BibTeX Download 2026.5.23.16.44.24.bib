  abstract={Clustering in wireless sensor networks (WSNs) is a process designed to group sensors into clusters, thereby minimizing energy consumption, extending network lifetime, and reducing redundant data collection in areas with densely packed sensors. Several protocols, including LEACH, FEECS, CHEF, and k-means, have been developed to optimize this clustering process. These protocols vary in their approach to determining the number of clusters, with some choosing randomly and others allowing user specification based on network requirements. The DBSCAN algorithm, a machine learning technique, determines the number of clusters based on the data point structure, which can significantly impact cluster formation. This paper presents a comparative analysis of DBSCAN variants for cluster formation in wireless sensor networks (WSN). Experimental results show that DBSCAN and its variants exhibited similar performance, with slight variations in the rate of decline in the number of live nodes. DBSCAN-L achieved the best performance when the sink was located at the center of the network, while HDBSCAN demonstrated better performance when the sink was located at the edge or outside the network.},
  keywords={Broadcasting;Broadcast technology;Filtering;Filters;Communication systems;Internet of Things;Protocols;Wireless sensor networks;Routing;Routing protocols;Wireless sensor networks;Clustering;DBSCAN;Lifetime extension;Energy optimization},
  doi={10.1109/ICECET63943.2025.11472117},
  ISSN={},
  month={July},}@ARTICLE{8555546,
  author={Lu, Wei and Meng, Xianyu and Guo, Guanfei},
  journal={IEEE Internet of Things Journal}, 
  title={Fast Service Migration Method Based on Virtual Machine Technology for MEC}, 
  year={2019},
  volume={6},
  number={3},
  pages={4344-4354},
  abstract={In the era of the Internet of Things (IoT), mobile edge computing (MEC) has become an effective solution to meet the energy efficiency and delay requirements of IoT applications. In MEC systems, tasks can be offloaded from lightweight mobile devices to edge nodes that are nearer to the users. To improve user experience, we combine remote loading and redirection to accelerate the service migration. By tracing historic access patterns, the proposed method first generates a loading request list that locates the core codes in the image file of service applications for booting. The core codes are then be prefetched and cached automatically. Furthermore, to avoid the potential UI lagging caused by incomplete service migration, edge nodes can continuously load the remaining codes in the image file. Once the image file is completely migrated, the file will be reconstructed. The running virtual machine (VM) then switches data access to the merged image file. Experiments show that this method can observably reduce the loading time of a VM-based application.},
  keywords={Internet of Things;Image edge detection;Loading;Delays;Hard disks;Virtual machining;Mobile handsets;Internet of Things (IoT);mobile edge computing (MEC);service migration;trace-driven prediction;virtual machine (VM)},
  doi={10.1109/JIOT.2018.2884519},
  ISSN={2327-4662},
  month={June},}@ARTICLE{11031107,
  author={Song, Mengke and Li, Luming and Yu, Xu and Chen, Chenglizhao},
  journal={IEEE Transactions on Image Processing}, 
  title={Pushing the Boundaries of Salient Object Detection: A Denoising-Driven Approach}, 
  year={2025},
  volume={34},
  number={},
  pages={3903-3917},
  abstract={Salient Object Detection (SOD) aims to identify the most attention-grabbing regions in an image and focuses on distinguishing salient objects from their backgrounds. Current SOD methods primarily use a discriminative approach, which works well for clear images but struggles in complex scenes with similar colors and textures between objects and backgrounds. To address these limitations, we introduce the diffusion-based salient object detection model (DiffSOD), which leverages a noise-to-image denoising process within a diffusion framework, enhancing saliency detection in both RGB and RGB-D images. Unlike conventional fusion-based SOD methods that directly merge RGB and depth information, we treat RGB and depth as distinct conditions, i.e., the appearance condition and the structure condition, respectively. These conditions serve as controls within the diffusion UNet architecture, guiding the denoising process. To facilitate this guidance, we employ two specialized control adapters: the appearance control adapter and the structure control adapter. Moreover, conventional denoising UNet models may struggle when handling low-quality depth maps, potentially introducing detrimental cues into the denoising process. To mitigate the impact of low-quality depth maps, we introduce a quality-aware filter. This filter selectively processes only high-quality depth data, ensuring that the denoising process is based on reliable information. Comparative evaluations on benchmark datasets have shown that DiffSOD substantially surpasses existing RGB and RGB-D saliency detection methods, improving average performance by 1.5% and 1.2% respectively, thus setting a new benchmark for diffusion-based dense prediction models in visual saliency detection.},
  keywords={Noise reduction;Visualization;Saliency detection;Object detection;Background noise;Diffusion models;Transformers;Noise;Process control;Feature extraction;Visual saliency detection (VSD);diffusion;control adapter;quality-aware},
