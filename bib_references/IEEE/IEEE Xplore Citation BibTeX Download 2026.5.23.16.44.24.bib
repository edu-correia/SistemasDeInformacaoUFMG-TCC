  ISSN={},
  month={Nov},}@ARTICLE{11175208,
  author={Yang, Xi and Shi, Haoyuan and Wang, Zihan and Wang, Nannan and Gao, Xinbo},
  journal={IEEE Transactions on Circuits and Systems for Video Technology}, 
  title={CSHNet: A Novel Information Asymmetric Image Translation Method}, 
  year={2026},
  volume={36},
  number={2},
  pages={1862-1875},
  abstract={Despite the considerable advancements in cross-domain image translation, a significant challenge remains in addressing information asymmetric translation tasks such as SAR-to-Optical and Sketch-to-Instance conversions. These tasks involve transforming data from a domain with limited information into one with more detailed and richer content. Traditional CNN-based methods, while effective at capturing intricate details, often struggle to grasp the overall structural composition of the image, leading to unintended blending or merging of distinct regions within the generated images. In light of these limitations, research has increasingly turned toward Transformers. Though Transformers excel at capturing global structures, they often lack the ability to preserve fine-grained details. Recognizing the importance of both detailed features and structural relationships in information asymmetric translation tasks, we introduce the CNN-Swin Hybrid Network (CSHNet). This network employs a novel bottleneck architecture featuring two key modules: Swin Embedded CNN (SEC) and CNN Embedded Swin (CES), which together form the SEC-CES-Bottleneck (SCB). Within this structure, SEC capitalizes on CNN’s capability for detailed feature extraction while incorporating the Swin Transformer’s inherent structural bias. In contrast, CES preserves the Swin Transformer’s strength in maintaining global structural integrity, while compensating for CNN’s tendency to emphasize detail. In addition to the SCB architecture, CSHNet integrates two essential components designed to improve cross-domain information retention and ensure structural consistency. The Interactive Guided Connection (IGC) fosters dynamic information exchange between SEC and CES, encouraging a deeper understanding of image details. At the same time, Adaptive Edge Perception Loss (AEPL) is implemented to preserve well-defined structural boundaries throughout the translation process. Experimental evaluations demonstrate that CSHNet surpasses current state-of-the-art methods, achieving superior results in both visualization and performance metrics across scene-level and instance-level datasets. Our code is available at: https://github.com/XduShi/CSHNet},
  keywords={Transformers;Translation;Convolutional neural networks;Feature extraction;Computer vision;Generative adversarial networks;Training;Image synthesis;Stacking;Semantics;CNN;swin transformer;SEC-CES-bottleneck (SCB);interactive guided connection (IGC);adaptive edge perception loss (AEPL)},
  doi={10.1109/TCSVT.2025.3612484},
  ISSN={1558-2205},
  month={Feb},}@INPROCEEDINGS{10632927,
  author={Zhang, Yuanfan and Nie, Zhixi and Wang, Zhenjie},
  booktitle={2024 IEEE International Conference on Mechatronics and Automation (ICMA)}, 
  title={Integration of GNSS and Strong Motion Accelerometer based on Robust Adaptive Recursive Noise Kalman Filter by Variational Bayesian Approximations}, 
  year={2024},
  volume={},
  number={},
  pages={1653-1658},
  abstract={Global Navigation Satellite System (GNSS) allows for precise monitoring of ground displacements, offering accuracies ranging from millimeters to centimeters, and sample rates varying between 1Hz and 50Hz. However, the GNSS observation signal is susceptible to the presence of a complex seismic environment with vegetation cover and strong external dynamic interference, in which case its accuracy and reliability cannot meet the requirements of coseismic deformation monitoring. Strong motion (SM) accelerometers, as a kind of inertial sensor, are capable of recording middle-rate to high-rate ground accelerations without electromagnetic signal interference and demonstrate stable working performance. An accurate displacement series can be obtained by combining GNSS and SM accelerometers. Usually, a Kalman filter is employed to merge GNSS displacements and SM acceleration data, using priori fixed noise values for both datasets. However, due to the time-varying errors introduced by the aforementioned disturbances, employing fixed noise for GNSS displacements is inappropriate. In this study, a recursive noise Kalman filter using variational Bayesian approximations is employed. The GNSS displacement noise covariances' sufficient statistics are adaptively estimated through iterative processes. Additionally, robust equivalent weight functions and adaptive factor scaling based on predicted residuals are incorporated into the estimation process to mitigate outliers. The proposed method's performance is validated through a shake table experiment. In standard shake table test, it shows an accuracy enhancement of up to 21% compared to the conventional Kalman filter, achieving a correlation coefficient (CC) of 0.97. When outliers are introduced into GNSS displacement data, the proposed method yields up to 49% greater accuracy than the Kalman filter, with a CC of 0.96 relative to references.},
  keywords={Accelerometers;Global navigation satellite system;Accuracy;Noise;Earthquakes;Vegetation mapping;Interference;GNSS;Strong motion accelerometer;Kalman filter;Variational bayesian approximations;Coseismic displacement},
  doi={10.1109/ICMA61710.2024.10632927},
  ISSN={2152-744X},
  month={Aug},}@INPROCEEDINGS{11387836,
  author={Hariani, Ritesh and Shingare, Pratibha and Bartakke, Prashant and Kolhare, Neelima and Kapse, Yogita},
  booktitle={2025 IEEE 3rd International Symposium on Sustainable Energy, Signal Processing and Cybersecurity}, 
  title={Technological Integration of Marma Chikitsa: An Embedded-AI Based Therapeutic Device}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={While modern medicine has progressed through rigorous experimentation and technological advancement, traditional healing systems like Ayurveda—particularly Marma therapy—remain underexplored in terms of empirical validation and intelligent system design. Marma therapy, based on the stimulation of vital energy points, offers significant potential for non-invasive wellness solutions but lacks standardized, technology-assisted implementations. This paper presents the conceptual development of a personalized therapeutic system that integrates artificial intelligence, computer vision, and embedded control with the principles of Marma therapy. The system begins by collecting user inputs or inferred symptom data, followed by AI-driven mapping of relevant Marma points and identification of the corresponding body region. A vision-based scanning module localizes precise Marma point locations tailored to individual anatomy. Based on the therapeutic goal, the system recommends suitable stimulation methods—including vibration, press-release, kneading motions, thermal applications (hot/cold), and low-intensity electrical pulses. After user confirmation, adaptive stimulation is applied in a controlled and gradually intensifying manner, with real-time feedback and safety controls. The visual interface assists the user throughout the session and concludes with a report that includes stimulation summary and personalized dosage recommendations. This work demonstrates the potential of merging ancient therapeutic wisdom with modern intelligent technologies to create accessible, safe, and user-centric wellness systems. The system's design and early simulations indicate its feasibility for applications in chronic pain management, stress relief, and personalized home-based care.},
  keywords={Location awareness;Vibrations;Computer vision;Visualization;Medical treatment;Signal processing;Real-time systems;Safety;System analysis and design;Stress;Marma Therapy;Energy Point Localization;Computer Vision in Healthcare;AI-Assisted Therapeutic Systems;Embedded Health Technology},
  doi={10.1109/iSSSC66652.2025.11387836},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11455848,
  author={Libini, P. and Durgalasya, Devalla Srisatya and Thrishalya, S. and Rajagopal, Shinu M},
  booktitle={2026 4th International Conference on Intelligent Data Communication Technologies and Internet of Things (IDCIoT)}, 
  title={Blockchain-Backed Router Logs for Security Forensics with Machine Learning Anomaly Detection and IoT Integration}, 
  year={2026},
  volume={},
  number={},
  pages={545-552},
  abstract={Cyberattacks continue to evolve in scale and sophistication, with adversaries increasingly targeting network logs to remove their traces or manipulate digital evidence. Even though network devices regularly generate a large number of logs, standard logging infrastructures are still susceptible to unauthorized changes and single-point failures; thus, they cannot be trusted fully for forensic analysis. This study presents a comprehensive forensic logging framework that merges blockchain-supported immutability, machine-learning-driven anomaly detection, and IoT device trust scoring to overcome this problem. The entire setup acts as a digital black box for contemporary networks. Blockchain guarantees that logs cannot be altered once they are recorded, while machine learning models spot abnormal behaviors and attacks in real-time, and IoT devices are continually assigned trust scores similar to credit ratings to authenticate the trustworthiness of their contributions. The proposed system generates log artifacts, real-time threat alerts, and automated forensic documentation, which can be used in legal cases. The experimental evaluation reveals that the combination of decentralized storage with predictive analytics substantially reduces the chances of log tampering and lowers detection latency compared to conventional centralized logging systems. Earlier research has focused on blockchain-based logging or machine learning anomaly detection separately. By combining permanence, smart detection, and device trust evaluation, the proposed system achieves better resistance, reliability, and readiness for forensics. The output points to tangible enhancements in preserving log integrity, attack detection accuracy, and investigative efficiency; thus, this architecture is a significant leap forward compared to existing methods of secure network logging.},
  keywords={Forensics;Scalability;Machine learning;Real-time systems;Robustness;Blockchains;Internet of Things;Security;Anomaly detection;Standards;Blockchain;Log Management;Anomaly Detection;IoT Trust Scores;Digital Forensics;Cyber-Attack Detection},
  doi={10.1109/IDCIoT67589.2026.11455848},
  ISSN={},
  month={Feb},}@ARTICLE{11222100,
  author={Li, Xiaolong and Ma, Huifang and Guo, Shuheng and Zhang, Di and Li, Zhixin},
  journal={IEEE Transactions on Geoscience and Remote Sensing}, 
  title={Dual-Graph Knowledge Distillation Meets Multiscale CNN: A Novel Ensemble Approach for Few-Shot Hyperspectral Image Classification}, 
  year={2025},
  volume={63},
  number={},
  pages={1-22},
  abstract={Hyperspectral image (HSI) classification aims at categorizing each pixel in an HSI, facilitating precise identification and differentiation of various land cover types. In recent years, graph neural networks (GNNs)-based methods for HSI classification have exhibited impressive performance when abundant labeled samples are available. However, their effectiveness is notably constrained in real-world scenarios with limited labeled samples. Furthermore, current approaches predominantly concentrate on extracting global features at the superpixel level, overlooking the efficient exploration of pixel-level local features, leading to incomplete feature representations. To address these challenges, we introduce a novel ensemble approach termed dual-graph knowledge distillation integrated with multiscale convolutional neural network (KDMSC), specifically designed for few-shot HSI classification. Specifically, at the superpixel level, a graph structure is initially constructed for segmented superpixels, enhancing two distinct graph views. To amalgamate the dual-graph model, a dual-student graph knowledge distillation (DSGKD) module is introduced. This module intelligently merges the dual-graph structures based on superpixels, creating an ensemble teacher model that utilizes superpixel predictions as supplementary supervisory signals, thereby bolstering the model’s feature learning capabilities. At the pixel level, a multiscale convolutional neural network (CNN) module is integrated to capture local spatial and spectral information across various receptive fields. This effectively explores pixel-level local features and enriches the pixel-level feature representation. Finally, an adaptive weighted fusion strategy is proposed, dynamically adjusting the contribution of global and local features. This enables the effective fusion of superpixel-level and pixel-level features, significantly enhancing the completeness and discriminability of the feature representations. Moreover, ensemble learning is introduced to further enhance the method’s robustness. Experimental results on four benchmark datasets, each with only five labeled samples per class, demonstrate that the proposed method surpasses existing deep learning techniques in terms of classification accuracy and generalization performance. The source code is available online at: https://github.com/AXTX725/KDMSC},
  keywords={Feature extraction;Prototypes;Adaptation models;Accuracy;Convolutional neural networks;Few shot learning;Ensemble learning;Transfer learning;Noise;Convolution;Convolutional neural network (CNN);graph knowledge distillation;graph neural networks (GNNs);hyperspectral image (HSI) classification;limited labeled samples},
  doi={10.1109/TGRS.2025.3627204},
  ISSN={1558-0644},
  month={},}@ARTICLE{8734145,
  author={Dixit, Shilp and Montanaro, Umberto and Dianati, Mehrdad and Oxtoby, David and Mizutani, Tom and Mouzakitis, Alexandros and Fallah, Saber},
  journal={IEEE Transactions on Intelligent Transportation Systems}, 
  title={Trajectory Planning for Autonomous High-Speed Overtaking in Structured Environments Using Robust MPC}, 
  year={2020},
  volume={21},
  number={6},
  pages={2310-2323},
  abstract={Automated vehicles are increasingly getting main-streamed and this has pushed development of systems for autonomous manoeuvring (e.g., lane-change, merge, and overtake) to the forefront. A novel framework for situational awareness and trajectory planning to perform autonomous overtaking in high-speed structured environments (e.g., highway and motorway) is presented in this paper. A combination of a potential field like function and reachability sets of a vehicle are used to identify safe zones on a road that the vehicle can navigate towards. These safe zones are provided to a tube-based robust model predictive controller as reference to generate feasible trajectories for combined lateral and longitudinal motion of a vehicle. The strengths of the proposed framework are: 1) it is free from non-convex collision avoidance constraints; 2) it ensures feasibility of trajectory even if decelerating or accelerating while performing lateral motion; and 3) it is real-time implementable. The ability of the proposed framework to plan feasible trajectories for high-speed overtaking is validated in a high-fidelity IPG CarMaker and Simulink co-simulation environment.},
  keywords={Trajectory;Planning;Roads;Vehicle dynamics;Collision avoidance;Lead;Autonomous vehicles;Trajectory planning;autonomous overtaking;MPC;robust MPC;autonomous vehicles},
  doi={10.1109/TITS.2019.2916354},
  ISSN={1558-0016},
  month={June},}@INPROCEEDINGS{8887408,
  author={Huang, Yujun and Weng, Yunpeng and Yu, Shuai and Chen, Xu},
  booktitle={2019 18th IEEE International Conference On Trust, Security And Privacy In Computing And Communications/13th IEEE International Conference On Big Data Science And Engineering (TrustCom/BigDataSE)}, 
  title={Diffusion Convolutional Recurrent Neural Network with Rank Influence Learning for Traffic Forecasting}, 
  year={2019},
  volume={},
  number={},
  pages={678-685},
  abstract={With the rapid development of urban road traffic, accurate and timely road traffic forecasting becomes a critical problem, which is significant for traffic safety and urban transport efficiency. Many methods based on graph convolutional network (GCNs) are proposed to deal with the graph-structured spatio-temporal forecasting problem, since GCNs can model spatial dependency with high efficiency. In order to better capture the complicated dependencies of traffic flow, we introduce rank influence factor to the Diffusion Convolutional Recurrent Neural Network model. The rank influence factor could adjust the importance of neighboring sensor nodes at different proximity ranks with the target node when aggregating neighborhood information. Experiments show a considerable improvement when rank influence factor is used in GCNs with a tolerable time consumption.},
  keywords={Roads;Convolution;Computational modeling;Mathematical model;Adaptation models;Forecasting;Predictive models;Graph Convolutional Network, Spatio-temporal model, Traffic forecasting},
