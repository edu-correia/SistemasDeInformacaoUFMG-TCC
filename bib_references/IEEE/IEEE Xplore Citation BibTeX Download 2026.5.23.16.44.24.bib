  pages={54-59},
  abstract={Emotion detection plays a critical role in diagnosing mental health illnesses, supporting humans with learning disabilities, helping businesses detect customer sentiment, and enhancing human-computer interaction. However, despite recent progress being made and the high accuracy that neural networks have managed to achieve, the high complexity and parameter count makes them quite unreliable in practical applications. This paper proposes a new multimodal approach for emotion detection using both complementary audio and video stimuli. The proposed model has the advantage of using two stimuli that directly complement each other, leading to relatively high accuracy, while also being lightweight enough to be readily applied in real-world settings. For proving a concept, the RAVDESS dataset was used to create a KNN merged late fusion model that combines audio-based and video-based emotion predictions. The audio predictions were generated using a CNN-LSTM model, while video predictions used a 3D CNN model. The resulting approach achieved 90.7% accuracy, surpassing previous studies with accuracies in the range of 65.71%-86.70%. Additionally, the proposed model has the advantage of utilizing only 1.4 million parameters, compared with previous studies that used 6.1 to 11.3 million parameters. This significant decrease in computing power needed means that the proposed model can run faster on resource-constrained devices. This enables our model to perform real-time emotion-recognition applications in practical settings, an improvement on previous models.},
  keywords={Emotion recognition;Solid modeling;Accuracy;Computational modeling;Neural networks;Predictive models;Nearest neighbor methods;Complexity theory;Videos;Overfitting;Emotion Detection;RAVDESS;Multimodal;Cross Attention;KNN;CNN;Audio-visual},
  doi={10.1109/PRML66062.2025.11159827},
  ISSN={},
  month={June},}@INPROCEEDINGS{10456185,
  author={Khurana, Saniya},
  booktitle={2023 IEEE International Conference on ICT in Business Industry & Government (ICTBIG)}, 
  title={Improving Internet of Things Application Efficiency via Synergistic Integration of LoRaWAN MAC Protocols for Enhanced Performance}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Internet of Things' (IoT) tremendous expansion, there are now more linked devices than at any other time in history. Because of their huge coverage area and low power consumption, low-power wide-area networks, or LoRaWAns, have swiftly taken over as the norm for Internet of Things installations. The present LoRaWAn Mac (Medium Access Control) protocols struggle to accommodate many devices while maintaining optimal performance. This is true even though these strategies have a number of advantages. This paper proposes a unique method for improving the performance of LoRaWAn-based Internet of Things applications by merging three difficult MAC protocols in a synergistic manner. The adaptive data rate (ADR) algorithm is used to make real-time data rate adjustments; the dynamic channel allocation (DCA) algorithm is used to effectively allocate channels; and the priority-based channel access (PCA) algorithm is used to prioritize critical data transmissions. All three of these algorithms are referred to as “algorithms.” All these algorithms are combined into a tiny package known as priority-based channel access (PCA). The integrated solution outperforms more standard MAC protocols in terms of efficacy, scalability, and dependability. The purpose of this essay is to offer a comprehensive response to the challenges associated with adopting LoRaWAn for general use in IoT.},
  keywords={Performance evaluation;Heuristic algorithms;Scalability;Media Access Protocol;Internet of Things;Security;Reliability;Adaptive Data Rate;Dynamic Channel Allocation;Internet of Things;LoRaWan;Mac Protocols;Network Efficiency;Priority-based Channel Access},
