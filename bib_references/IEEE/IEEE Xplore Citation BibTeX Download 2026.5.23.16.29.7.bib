  month={Dec},}@INPROCEEDINGS{11344692,
  author={Gulfshan and Kumar, Ashok},
  booktitle={2025 IEEE 4th International Conference on Data, Decision and Systems (ICDDS)}, 
  title={Application of Blockchain Technology in Modern Power Systems and Power Electronics- A Brief Review}, 
  year={2025},
  volume={},
  number={},
  pages={31-36},
  abstract={In the context of advancing modern power systems and power electronics to facilitate the transition to green energy, numerous challenges and issues arise that demand innovative solutions. In recent years, incorporating decentralized Blockchain Technology alongside power electronics has merge as a promising approach to address the issues and gain attention in Research. This paper introduces the concept of Blockchain and provides a concise review of existing literature on its applications in power systems and power electronics fields.},
  keywords={Green energy;Electric potential;Supply chain management;Reviews;Virtual power plants;Electric vehicles;Power electronics;Blockchains;Power systems;Power system;Power Electronics;Blockchain technology;Electric Vehicle;P2P(peer to peer)},
