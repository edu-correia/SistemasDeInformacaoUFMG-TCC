  number={},
  pages={980-987},
  abstract={Smart City Digital Twin (SCDT), a virtual representation of a physical city, is an emerging technology for optimizing urban services and enhancing urban planning and decision-making. The integration of Machine Learning (ML) and social sensing provides valuable insights into public feedback to policymakers and for informed decision-making and responsive urban governance. This study aims to explore the use of social media data and topic modeling algorithms in the context of SCDT to highlight the concerns of citizens in Saskatoon, Canada. In this work, we use the Uniform Manifold Approximation and Projection (UMAP) and K-means clustering algorithm in the BERTopic architecture to extract 30 topics from comments collected through the Saskatoon subreddit posts. The topics were then merged into 15 themes to discover the concerns. A pretrained transformer model, SiEBERT was used to determine the sentiments of the Reddit comments. The research findings highlighted concerns such as - unreliable public transit, high cost of living, long wait times in emergency rooms, shortage of family doctors, drug addiction, and lack of mental awareness.},
  keywords={Manifolds;Analytical models;Machine learning algorithms;Social networking (online);Smart cities;Clustering algorithms;Medical services;Machine Learning;Social Media Sensing;BERTopic;Sentiment Analysis;Smart City Digital Twin;Smart Governance;Reddit},
  doi={10.1109/HPCC-DSS-SmartCity-DependSys60770.2023.00141},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11120154,
  author={R, Vinston Raja and R, Surendran and Franklin, Ramya G and Balamurugan, K S and Gnanaselvam, R},
  booktitle={2024 IEEE 9th International Conference on Engineering Technologies and Applied Sciences (ICETAS)}, 
  title={Machine Learning Techniques for Accurate Staging of Lung Carcinoma from Low-Radiation CT Scans}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Early detection of lung cancer is paramount for improved patient outcomes and reduced mortality rates. This research presented an innovative methodology combining machine learning with low-dose CT scans for this purpose. The objective was to retain diagnostic accuracy while significantly reducing radiation exposure, merging patient safety with effective disease detection. Our results showed a high true positive rate, reaching up to 98 % at specific thresholds, and a false positive rate that decreased to a mere 4 % in stringent testing conditions. This performance is not only promising but also rivals, and in certain parameters surpasses, traditional high-dose CT scans. A notable aspect of this study was the use of a deep learning-based image reconstruction algorithm, enhancing the clarity of low-radiation scans, ensuring they retain diagnostic reliability. When juxtaposed with the risks associated with high-dose CT scans, the proposed methodology offers a groundbreaking alternative that doesn't compromise on efficacy. While the findings are robust and promising, a broader real-world application and validation are crucial. The integration of machine learning with low-dose CT scans heralds a potential paradigm shift in lung cancer detection, championing a future of enhanced safety and precision in diagnostics.},
  keywords={Accuracy;Computed tomography;Lung cancer;Machine learning;Sensitivity and specificity;Safety;Reliability;Image reconstruction;Standards;Testing;Lung cancer detection;Low-dose CT scans;Machine learning;Image reconstruction;Radiation exposure},
  doi={10.1109/ICETAS62372.2024.11120154},
  ISSN={2769-4518},
  month={Nov},}@INPROCEEDINGS{10339704,
  author={Rajić, Milena and Milosavljević, Peđa and Pavlović, Dragan and Kostić, Zorana},
  booktitle={2023 International Conference on Big Data, Knowledge and Control Systems Engineering (BdKCSE)}, 
  title={Lean Six Sigma: Integrating Knowledge, Data, and Innovation for Organizational Excellence}, 
  year={2023},
  volume={},
  number={},
  pages={1-7},
  abstract={Lean Six Sigma presents a prominent methodology for organizations seeking to improve efficiency, eliminate waste, and improve overall performance. The integration of knowledge, data, and innovation within Lean Six Sigma plays a crucial role in driving organizational excellence. Lean Six Sigma represents an important business improvement method which merges the basics principles of Lean manufacturing and Six Sigma. It aims to streamline processes, reduce variation, and maximize value for customers. In the pursuit of excellence, organizations must integrate knowledge, data, and innovation to facilitate informed decision-making, promote learning, and drive transformative change. Knowledge management involves capturing, sharing, and utilizing organizational insights, best practices, and lessons learned. In Lean Six Sigma, effective knowledge management ensures that valuable information generated during improvement projects is documented and disseminated. This knowledge repository serves as a foundation for future projects, enabling teams to build upon past successes and avoid repeating mistakes.},
  keywords={Technological innovation;Decision making;Organizations;Transforms;Production;Knowledge management;Product design;lean six sigma;knowledge management;data management;innovation;organizational excellence},
  doi={10.1109/BdKCSE59280.2023.10339704},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10957088,
  author={Thakur, Ankita and Abidi, Shabeeh Asghar and Kataria, Ansh and Panda, Monalisa and Jain, Romil and S, Mithun Kumar},
  booktitle={2025 International Conference on Automation and Computation (AUTOCOM)}, 
  title={Maximizing Renewable Energy Utilization in a Hybrid Grid-Connected PV-Biomass System with Demand Response Strategies}, 
  year={2025},
  volume={},
  number={},
  pages={935-940},
  abstract={Over recent years, the world has been increasingly fundus of renewable energy avenues to respond to the global thirst for electricity. Among these sources, solar photovoltaic (PV) systems have become popular due to their cost and ease of integration. Nevertheless, the irregular nature of PV systems makes it very difficult to merge them with grid-connected systems. In this study, through research, we work towards achieving the dream of utilizing the highest possible renewable energy in a Hybrid grid-connected PV -Biomass System. It can integrate intermittent PV power well with controllable and dispatch able biomass power and has solved many problems for stable and reliable energy supply (grid side). Demand response programs will be used to improve overall system efficiency, allowing consumers to adapt their electricity consumption to the availability of renewable energy. The performance of the proposed system will be benchmarked using simulations for different PV and biomass generation capacities, battery storage, and demand response scenarios. The outcomes will show what the system can achieve regarding increased fossil-free energy use and lower dependence on conventional, fossil-fuel-based energy providers. This study will help create new avenues for sustainable energy and encourage using renewable resources in the electricity grid.},
  keywords={Photovoltaic systems;Electricity;Power system stability;Demand response;Hybrid power systems;Stability analysis;Biomass;Smart grids;Batteries;Reliability;Demand;Hybrid;Battery;Electricity;Biomass},
  doi={10.1109/AUTOCOM64127.2025.10957088},
  ISSN={},
  month={March},}@INPROCEEDINGS{10381906,
  author={Dömény, Martin Ferenc and Szűcs, Tamás Dániel and Drexler, Dániel András and Kovács, Levente},
  booktitle={2023 IEEE 23rd International Symposium on Computational Intelligence and Informatics (CINTI)}, 
  title={Mastering Control: A Digital Toolkit for Understanding PID Controllers}, 
  year={2023},
  volume={},
  number={},
  pages={000019-000024},
  abstract={Control engineering education plays a pivotal role in shaping the competency of future engineers. However, the traditional educational approach predominantly emphasizes theoretical knowledge, often overlooking practical real-world applications. The evolving landscape of engineering education necessitates a shift towards dynamic learning methods that can effectively captivate the interest of students and facilitate a profound comprehension of concepts. Presently, numerous academic institutions that provide instruction in control systems tend to lack practical demonstrations using real-world systems. To address this educational gap comprehensively, we have developed an innovative application designed to empower users with the capability to experiment with real-time control scenarios. Through direct interaction with the application, users can acquire an enhanced insight into the behaviors exhibited by PID controllers. This application is crafted by integrating Arduino hardware with MATLAB software, resulting in a user-friendly interface. This interface not only enables real-time adjustment of control parameters but also provides an intuitive platform for the visualization of system responses. By offering such a versatile tool, the application fills a void in control systems education, granting students the opportunity to understand fundamental principles underlying control theory, particularly those related to the PID controller. In conclusion, the integration of this application into control engineering curricula stands to improve the way students comprehend complex control concepts. By merging theory with practical experimentation, the application creates an engaging and effective learning environment that equips aspiring engineers with invaluable skills for their future careers.},
  keywords={Temperature measurement;Visualization;Trajectory tracking;Pulse width modulation;DC motors;Real-time systems;Software;PID control;control education;DC motor control;serial communication},
  doi={10.1109/CINTI59972.2023.10381906},
  ISSN={2471-9269},
  month={Nov},}@INPROCEEDINGS{10847575,
  author={Kumar, Prem},
  booktitle={2024 IEEE 16th International Conference on Computational Intelligence and Communication Networks (CICN)}, 
  title={Sculpting with Algorithms: A Computational Approach to Analyzing Digital and Traditional Methods}, 
  year={2024},
  volume={},
  number={},
  pages={1157-1161},
  abstract={In an era where artistry meets technology, the realm of sculpting is undergoing a revolutionary transformation. This paper delves into the integration of digital tools such as Maxon ZBrush and Autodesk Maya with traditional sculpting methods, examining how this combination enhances precision, speed, and artistic flexibility. These digital tools, once solely complementary, are now pivotal in pushing the boundaries of sculptural design and execution across industries ranging from fine arts to industrial manufacturing. Central to this transformation is the role of artificial intelligence (AI), which is automating labor-intensive processes, enabling generative design, and reshaping creative workflows. The paper addresses the ethical concerns tied to AI's creative involvement, including issues of intellectual property, biases in algorithmic design, and the inherent limitations in material handling. Real-world examples, including the Statue of Unity and AI-driven projects like Joris Laarman's Bone Chair, highlight how art, technology, and sustainability are merging. Finally, future directions emphasize the importance of collaborative frameworks, eco-friendly practices, and the development of transparent AI systems that amplify, rather than undermine, human creative agency.},
  keywords={Ethics;Technological innovation;Art;Collaboration;Process control;Turning;Three-dimensional printing;Artificial intelligence;Sustainable development;Creativity;Traditional Sculpting;Digital Sculpting;Artificial Intelligence;AI in Sculpting;Generative Design},
  doi={10.1109/CICN63059.2024.10847575},
  ISSN={2472-7555},
  month={Dec},}@INPROCEEDINGS{10721938,
  author={Radhika, R. and Muthukumaravel, A.},
  booktitle={2024 International Conference on Intelligent Algorithms for Computational Intelligence Systems (IACIS)}, 
  title={Video Surveillance and Deep Learning Enhancing Security through Suspicious Activity Detection}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This study explores the potential of integrating deep learning technologies with video surveillance to detect suspicious behaviors and thereby enhance security measures. By employing sophisticated artificial intelligence methodologies, specifically Convolutional Neural Networks (CNNs), this study seeks to improve the surveillance systems' ability to detect threats in real-time. Through the implementation of an innovative strategy that merges deep learning models with video analytics, the suggested method enhances the precision of suspicious activity detection. Initial data indicates that security protocols have been enhanced, as there is now greater vigilance towards abnormal behavior and fewer false alarms. The integration of deep learning with video surveillance has the capacity to fundamentally transform security frameworks, potentially safeguarding individuals, and averting attacks in advance. The model has performed accuracy of 0.95, precision of 0.92, recall of 0.94 and processing time of 20ms.},
  keywords={Deep learning;Protocols;Visual analytics;Transforms;Video surveillance;Real-time systems;Safety;Security;Personnel;Artificial intelligence;video surveillance;deep learning;threat identification;convolutional neural network (CNN);alarm triggering},
  doi={10.1109/IACIS61494.2024.10721938},
  ISSN={},
  month={Aug},}@ARTICLE{10665939,
  author={Fu, Qingxu and Qiu, Tenghai and Yi, Jianqiang and Pu, Zhiqiang and Ai, Xiaolin},
  journal={IEEE Transactions on Emerging Topics in Computational Intelligence}, 
  title={Self-Clustering Hierarchical Multi-Agent Reinforcement Learning With Extensible Cooperation Graph}, 
  year={2025},
  volume={9},
  number={2},
  pages={1688-1698},
  abstract={Multi-Agent Reinforcement Learning (MARL) has been successful in solving many cooperative challenges. However, classic non-hierarchical MARL algorithms still cannot address various complex multi-agent problems that require hierarchical cooperative behaviors. The cooperative knowledge and policies learned in non-hierarchical algorithms are implicit and not interpretable, thereby restricting the integration of existing knowledge. This paper proposes a novel hierarchical MARL model called Hierarchical Cooperation Graph Learning (HCGL) for solving general multi-agent problems. HCGL has three components: a dynamic Extensible Cooperation Graph (ECG) for achieving self-clustering cooperation; a group of graph operators for adjusting the topology of ECG; and an MARL optimizer for training these graph operators. HCGL's key distinction from other MARL models is that the behaviors of agents are guided by the topology of ECG instead of policy neural networks. ECG is a three-layer graph consisting of an agent node layer, a cluster node layer, and a target node layer. To manipulate the ECG topology in response to changing environmental conditions, four graph operators are trained to adjust the edge connections of ECG dynamically. The hierarchical feature of ECG provides a unique approach to merge primitive actions (actions executed by the agents) and cooperative actions (actions executed by the clusters) into a unified action space, allowing us to integrate fundamental cooperative knowledge into an extensible interface. In our experiments, the HCGL model has shown outstanding performance in multi-agent benchmarks with sparse rewards. We also verify that HCGL can easily be transferred to large-scale scenarios with high zero-shot transfer success rates.},
  keywords={Electrocardiography;Topology;Reinforcement learning;Heuristic algorithms;Training;Network topology;Multi-agent systems;Hierarchical MARL;multi-agent system;reinforcement learning},
  doi={10.1109/TETCI.2024.3449873},
  ISSN={2471-285X},
  month={April},}@ARTICLE{11302810,
  author={Huang, Hualong and Duan, Hancong and Zhan, Wenhan and Min, Geyong and Peng, Kai and Lei, Yuchuan},
  journal={IEEE Transactions on Mobile Computing}, 
  title={Cost-Aware Dependent Task Offloading and Resource Allocation for Satellite Edge Computing: An Asynchronous Deep Reinforcement Learning Approach}, 
  year={2026},
  volume={25},
  number={6},
  pages={7782-7799},
  abstract={The integration of satellite communications with mobile edge computing (MEC) into space-air-ground integrated networks, known as satellite edge computing (SEC), has become a crucial research field for future communication systems to provide extensive global coverage services. This paper investigates the joint dependent task offloading and resource allocation problem for remote Internet-of-Things (IoT) applications within the SEC architecture. The proposed system leverages uncrewed aerial vehicles (UAVs) as mobile access points and edge servers and utilizes low-earth orbit (LEO) satellites and ground stations as cloud computing resources. Multiple applications with dependent tasks from IoT devices (IoTDs) are modeled as directed acyclic graphs (DAGs). To address the challenges of reducing the system cost in UAV-assisted SEC, we first propose a one-to-many matching algorithm to associate IoTDs with UAVs. Then, a multi-application task sequence algorithm is devoted to merging the multiple DAGs and sorting the task order. Finally, a graph-aware asynchronous multi-agent reinforcement learning approach empowers the agents to autonomously discover optimal offloading and resource allocation strategies. Extensive simulations based on real-world datasets demonstrate the effectiveness of the proposed approach in minimizing the system costs while meeting application latency requirements, outperforming other benchmark algorithms.},
  keywords={Satellites;Resource management;Low earth orbit satellites;Autonomous aerial vehicles;Optimization;Energy consumption;Trajectory;Internet of Things;Costs;Servers;Satellite edge computing (SEC);task offloading;resource allocation;deep reinforcement learning;space-air-ground integrated network},
  doi={10.1109/TMC.2025.3645456},
  ISSN={1558-0660},
  month={June},}@INPROCEEDINGS{11267726,
  author={Madahana, Milka C. I. and Marakalala, Mmatlou and Ekoru, John E. D.},
  booktitle={2025 IEEE 16th Annual Ubiquitous Computing, Electronics & Mobile Communication Conference (UEMCON)}, 
  title={Integrated Digital Twin Systems in Mining Operations: A Holistic Review of the Current State, Challenges, and Future Prospects}, 
  year={2025},
  volume={},
  number={},
  pages={0479-0485},
  abstract={This review provides a systematic synthesis of the current state, challenges, and future prospects of integrated digital twin systems in the mining industry. Utilizing a comprehensive search of major electronic databases, we analysed peerreviewed literature published from January 2009 to August 2025. The study highlights that while digital twins are increasingly adopted for siloed applications—such as optimizing individual machines or specific processes—their full potential as holistic, integrated, mine-wide systems remain untapped. Key challenges identified include the high cost of implementation, complex data integration, and a lack of skilled personnel and robust cybersecurity protocols. Looking ahead, the paper suggests that future development will involve merging digital twins with artificial intelligence and machine learning to enable advanced applications like predictive maintenance and real-time optimization of the entire mining value chain, ultimately leading to smarter, safer, and more sustainable operations.},
  keywords={Text mining;Systematics;Protocols;Reviews;Mobile communication;Real-time systems;Digital twins;Personnel;Optimization;Predictive maintenance;Digital twins;advanced technologies;mining industry},
  doi={10.1109/UEMCON67449.2025.11267726},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10749949,
  author={Ismail, Mohammed Nuther and Abbas, Haider Hadi and Mejbel, Basim Ghalib and Najm, Nahlah M. A. M. and Abedah, Maher and Kramarenko, Olexii and Zalzala, Ali Mahdi},
  booktitle={2024 36th Conference of Open Innovations Association (FRUCT)}, 
  title={Complex Dynamics at the Intersection of Computer Algorithms and Robotic Function}, 
  year={2024},
  volume={},
  number={},
  pages={527-537},
  abstract={Background: The merging of computer science and robotic technology creates a synergistic environment where advances are changing healthcare, manufacturing, and service industries. Although some publications have shown their successes, complete research on the fusion and interface of computer science algorithms and robotic tasks is still needed.Objective: Combining computer science with robotics improves cooperation and integration. It also illustrates how linking these technologies might boost robotic entities' computational and operational capacities, making them more valuable and versatile.Methods: This mixed-methods research uses quantitative data from technical and computational performance metrics and qualitative insights from expert interviews and sector case studies. A critical study examines practical applications, issues of computer science and robotics.Results: Advanced computer algorithms may enhance robotic technologies by increasing autonomous decision-making, sensorimotor functions, and machine learning. However, the inquiry finds significant obstacles, notably in security, and implementation of these developments.Conclusion: The merger of computer science and robotic technology signals new possibilities and advancements, enabling the production of intelligent, adaptable, and autonomous robots. Combining these fields may improve robotic capabilities, but security, and practical application issues must be addressed to ensure sustainable and responsible technological growth.},
  keywords={Computer science;Technological innovation;Service robots;Heuristic algorithms;Robot sensing systems;Data transfer;Computer security;Robots;Manipulator dynamics;Convergence},
  doi={10.23919/FRUCT64283.2024.10749949},
  ISSN={2305-7254},
  month={Oct},}@INPROCEEDINGS{10924994,
  author={Anthis, Zach and Basiakoulis, Alexandros and Efstathiou, Kyriakos and Efstathiou, Marianna},
  booktitle={2024 IEEE Smart World Congress (SWC)}, 
  title={Sound of Reason: Using AI to build a Digital Twin after the Kanon of Pythagoras in school settings}, 
  year={2024},
  volume={},
  number={},
  pages={2157-2162},
  abstract={This paper presents ongoing work on kanON, an AI-driven EdTech tool designed to foster interactive learning and support Digital Cultural Heritage (DCH) preservation. kanON facilitates the digital reconstruction of the infamous Pythagorean monochord, by allowing users to seamlessly manipulate parameters such as origin (location and epoch), materials, and shape/dimensions. Through the integration of Machine Learning (ML) algorithms, the tool predicts missing archaeological data and generates real-time 3D renderings based on user input, accompanied by corresponding confidence metrics. A mixed-methods (pilot) study was conducted in classroom environments to evaluate its educational impact via quantitative Likert scale assessments and qualitative content analysis of educator feedback. Preliminary results demonstrate high levels of student engagement and reflect positive educator responses, highlighting its potential to enhance the in-class accessibility and understanding of complex historical concepts, as well as to enable the preservation and exploration of cultural artifacts through digital means. Future work will focus on refining kanON and expanding its applicability within both educational and DCH contexts, by introducing the capability of outputting a fully operational digital twin, that integrates mixed reality functionalities. The idea is to enable users to later engage with their (personalized) model dynamically (e.g., readjusting string length and tension), thus allowing them to produce different soundscapes in real-time. This advancement aims to deepen the pedagogical impact by merging tactile interaction with visual and auditory feedback, further enhancing the educational experience via immersive, experiential learning.},
  keywords={Visualization;Uncertainty;Three-dimensional displays;Machine learning;Educational technology;Real-time systems;User experience;Digital twins;Cultural differences;Usability;Educational Technology (EdTech);Artificial Intelligence (AI);Machine Learning (ML);Digital Cultural Heritage (DCH)},
  doi={10.1109/SWC62898.2024.00329},
  ISSN={2993-396X},
  month={Dec},}@INPROCEEDINGS{11390237,
  author={Bisht, Amita and Bhagat, Sukesh Kumar and Kumar, Rahul and Yamsani, Nagendar and Kukreti, Riya and Dhiman, Diksha},
  booktitle={2025 1st IEEE Uttar Pradesh Section Women in Engineering International Conference on Electrical Electronics and Computer Engineering (UPWIECON)}, 
  title={AI in Sustainable Development and Climate Change Mitigation}, 
  year={2025},
  volume={},
  number={},
  pages={251-258},
  abstract={The use of Ai in sustainable development practices presents a very big opportunity to address effective transformation and multifaceted challenges of climate change mitigation. In this paper the aim is to explore the potential of AI technologies across various sectors for the sustainable development and mitigation in climate change including energy sector, agriculture, transportation, and waste management system. Highlighting the ability of AI to enhance efficiency, reduce emissions and more. By implementing machine learning algorithms and predictive analytics, AI can optimize resource management, improve renewable energy system, and improve real time monitoring of environment changes. AI technologies offer innovative solutions that can significantly enhance the way of responding towards the challenges. AI can help in modelling and predicting climate related risk; it informs local governments and organizations to implement proactive measures. AI integration in sustainable development and climate change mitigation in not merely an option but a necessity. However, the implementation of AI in sustainable development and climate change mitigation is not without challenges. Issues like data privacy, energy consumption, and the potential for algorithmic biases require careful consideration. The merging of AI with sustainable development offers a hopeful path for climate action, with the potential to drive us faster towards a greener, low carbon future.},
  keywords={Smart agriculture;Hands;Ethics;Climate;Biological system modeling;Predictive models;Climate change mitigation;Artificial intelligence;Sustainable development;Optimization;Artificial Intelligence (AI);Sustainable Development;Climate Change Mitigation;Renewable Energy;Environmental Monitoring;Smart Agriculture;Smart Cities;Machine Learning;Climate Risk Prediction;Resource Optimization 5},
  doi={10.1109/UPWIECON67212.2025.11390237},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11392886,
  author={Jayakumar, Akshay and Mathews, Anna and Yacob, Anna and Sunil, Gourinandini and C V, Priya},
  booktitle={2025 IEEE 22nd India Council International Conference (INDICON)}, 
  title={Autonomous Utility Robotic Assistant}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Material handling is vital for productivity and safety in industrial and commercial settings, yet traditional manual methods cause physical strain, especially for workers and the elderly. In industries, fatigue and accidents are common, while elderly shoppers struggle to navigate crowded spaces and carry heavy loads. This paper presents a dual-domain autonomous smart cart system with human-following and obstacle avoidance capabilities to tackle both scenarios. Using advanced tracking and sensor fusion, the cart adapts to user movements and cluttered environments, autonomously or under manual control for precision. In industrial contexts, it reduces worker fatigue by transporting heavy items, improving safety and consistency. In retail, it helps elderly users by minimizing physical effort and enabling independent shopping through smooth navigation and item handling. Initial implementations show 20–30% faster task completion for industrial workers and better accessibility for elderly users, including less strain and increased confidence. The modular design of the system ensures seamless integration into existing infrastructures without major updates, focusing on scalability and user adaptability. By merging assistive robotics with automation, this smart cart provides a practical, versatile solution to modern material handling needs—enhancing safety, inclusion, and efficiency across diverse environments.},
  keywords={Automation;Service robots;Navigation;Tracking;Materials handling;Fatigue;Safety;Older adults;Collision avoidance;Strain;Human-robot collaboration;autonomous navigation;obstacle avoidance;assistive robotics;elderly assistance;industrial automation},
  doi={10.1109/INDICON68490.2025.11392886},
  ISSN={2325-9418},
  month={Dec},}@INPROCEEDINGS{11336542,
  author={Yadav, Sneha and Joshi, Raunak and Raut, Neha and Gharat, Kshitija},
  booktitle={2025 International Conference on Future Technologies (ICFT)}, 
  title={Geo-IQ: Prompt Based Natural Language Retrieval for Geo-Spatial Data}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={As part of the research carried on in GeoIQ, which aims to provide information on the population, vegetation, and disaster distribution in the the country of India, Geo-Spatial Data Retrieval has been created to provide an easy to use, sophisticated, and geo-spatial data on population and vegetation index, and the occurrence of disaster. This is made possible through the use of the LLMs and the LangChain based natural language query of the platform, which allows users to ask questions conversationally and does not require technical skills. Integration of different data sets, such as census demographic data, vegetation index data, and disaster data, allows GeoIQ to provide multiple data dimensions to improving the understanding of human population, ecology, and disaster risks, which improves human population. GeoIQ aims to provide intuitive aids, and as such, employs dynamic maps, dynamic representations, and layers and styles which users can control, to improve the ease of understanding and the effectiveness of geo-spatial data. This allows GeoIQ to assist the users in environment resource management, and disaster readiness GeoIQ to assist the user in urban resource management and disaster readiness. GeoIQ is the first to successfully merge AI-led language analysis and geospatial analytics, hence democratizing spatial intelligence.},
  keywords={Disasters;Large language models;Urban planning;Vegetation mapping;Data visualization;Natural language processing;Geospatial analysis;Systems support;Resource management;Indexes;Geospatial Data;Geographic Information Systems (GIS);Interactive Mapping;Large Language Models},
  doi={10.1109/ICFT66708.2025.11336542},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11434466,
  author={Dhanush, Kotra and Akshitha, Tanda and Sundhar, Undralla Shyam and Jagdish, Mukta},
  booktitle={2025 3rd International Conference on Advances in Computation, Communication and Information Technology (ICAICCIT)}, 
  title={SecureCHAT: A Cryptographically Secure, End-to-End Encrypted Communication Framework Leveraging Ionic and Firebase Firestore}, 
  year={2025},
  volume={1},
  number={},
  pages={1327-1332},
  abstract={As the demand for real-time communication in mobile apps continues to increase, it is essential to ensure scalability, security, and low latency. This paper introduces SecureCHAT, a real-time chat application developed using the Ionic Framework and Firebase Realtime Database. The system utilizes Firebase Authentication for secure logins and Angular signals for dynamic UI updates, facilitating seamless and responsive user interactions. Notable features include real-time message synchronization, user authentication, chat status management, and encrypted data storage. Performance analysis highlights Firebase's capability to manage multiple users simultaneously with minimal delay, while database query optimization techniques further boost scalability. Security measures, such as encrypted authentication and database rules, are implemented to protect user data. The findings confirm that Firebase offers a dependable cloud-based backend for real-time messaging, and its integration with cross-platform frameworks like Ionic supports the creation of secure, scalable, and efficient communication systems. This work provides practical insights into merging cloud-based services with mobile development frameworks for the next generation of secure messaging platforms.},
  keywords={Databases;Scalability;Query processing;Authentication;Real-time systems;Mobile applications;Encryption;Performance analysis;Synchronization;Reliability;Real-time chat;SecureCHAT;Ionic Framework;Firebase Realtime Database;Mobile Application Security;Cloudbased Messaging;End-to-End Encryption},
  doi={10.1109/ICAICCIT68829.2025.11434466},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11500627,
  author={V, Sumathy and P, Manikandan and J, Omana and E, Balraj},
  booktitle={2025 3rd International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={A Longitudinal Analysis of Public Perception on Migration From Youtube Comments}, 
  year={2025},
  volume={},
  number={},
  pages={1213-1217},
  abstract={Migration is affected by many environmental, political, economic, and social factors. Events such as wars, economic crises, and refugee movements have caused significant changes in the way people talk about migration around the world. YouTube is a great place to study how people’s opinions about migration have changed over time because it has a lot of user-generated content. The main contribution of this research is to provide a multi-year, large-scale sentiment and topic analysis of YouTube migration discourse, merging Robustly Optimized BERT Pretraining Approach (RoBERTa), Valence Aware Dictionary and sEntiment Reasoner (VADER), Latent Dirichlet allocation (LDA), and Bidirectional Encoder Representations for Topic Modeling (BERTopic) to capture shifts in public perception and link them to global actions. This study examines YouTube comments from five different years (2010, 2015, 2019, 2021, and 2025) by collecting a dataset through web scraping. The study uses VADER and RoBERTa for sentiment analysis and LDA and BERTopic for topic modeling. The results show that public opinion has changed significantly over the years. In the past, people were neutral or positive, but by 2019, they were more divided and negative. This was due to rising concerns about migration security and political discourse. Topic modeling showed that there were important themes over time, such as the effects on the economy and humanitarian issues (2010–2015), the integration of refugees and cultural tensions (2015–2019), health security and border control issues, especially because of the COVID-19 pandemic (2019–2021), and a growing focus on making migration a crime in the last period (2021–2025). These results show how the conversation about migration has changed from humanitarian to more politically charged stories. They also show how digital platforms have changed the way people think about things over time. The use of NLP techniques effectively captured these changes, showing how global events have a significant impact on how people feel about migration.},
  keywords={Motion pictures;Broadcasting;Feedback;Circuits;Videos;Video equipment;Protocols;HTTP;Telematics;Unsolicited e-mail;Migration;YouTube;Sentiment analysis;Topic modelling;Web scraping;Public Opinion},
  doi={10.1109/ICSCSS64956.2025.11500627},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11282842,
  author={Hemmuang, Chonnapat and Phdungsilp, Aumnad and Wetchakama, Somboon},
  booktitle={2025 International Conference on Power, Energy and Innovations (ICPEI)}, 
  title={Strategic Energy Forecasting and Policy Design for Carbon-Neutral University Campuses in KMUTT}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Higher education institutions in developing economies now function as key drivers to help their countries achieve carbon neutrality goals. These institutions as major energy users and innovation centers enable the combination of data forecasting with sustainable policy development for the long-term. This research introduces a strategic energy planning system which merges AI-based forecasting with policy evaluation scenarios to direct university campus decarbonization efforts. The research at King Mongkut’s University of Technology Thonburi (KMUTT) in Thailand implements a deep learning system which combines Convolutional Neural Networks (CNN) with Bidirectional Long Short-Term Memory (BiLSTM) and Transformer-based attention mechanisms. The model achieved R2 = 0.96 predictive accuracy after being trained with high-resolution energy and meteorological data from 2020 to 2024. The model allows to predict three policy-oriented scenarios, including Energy Efficiency (EE), Renewable Integration (RE), and Behavioral Change to determine their extended effects on campus energy usage. This research shows that EE measures will decrease the total energy consumption by 20% until 2040, while RE and behavioral strategies will decrease the energy usage by 15–18% and 8–10%, respectively. The research combines these findings into a strategic roadmap that follows the National Energy Plan (NEP), the Power Development Plan (PDP), and the Energy Efficiency Plan (EEP) of Thailand. The research establishes a transferable method which enables universities across ASEAN to use high-performance AI forecasting for institutional policy design to guide stakeholders in their higher education carbon neutrality transition.},
  keywords={Deep learning;Technological innovation;Education;Carbon neutral;Predictive models;Energy efficiency;Planning;Convolutional neural networks;Forecasting;Vehicles;Carbon Neutrality;Strategic Energy Planning;Deep Learning Forecasting;Higher Education Policy;Scenario-Based Decision-Making},
  doi={10.1109/ICPEI66116.2025.11282842},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11485561,
  author={Yadav, Golla Anil Kumar and Vikaas, Maile and Mallesh, Gangapuri and Kumar, T. Venkata Naga Rohith and Rao, C. Madhusudhana},
  booktitle={2026 6th International Conference on Expert Clouds and Applications (ICOECA)}, 
  title={An Efficient Hybrid Ensemble Intrusion Detection Framework for Resource-Constrained IoT Environments}, 
  year={2026},
  volume={},
  number={},
  pages={1363-1370},
  abstract={The increased connectivity of Internet of Things (IoT) networks has made them more susceptible to dynamic cyber-attacks, highlighting the need for reliable and efficient intrusion detection systems (IDS). This paper proposes a hybrid ensemble IDS that combines XGBoost and LightGBM with a mutual information–based adaptive feature selection mechanism to effectively handle high-dimensional network traffic. A two-layer stacking architecture is employed, where probabilistic outputs of the base classifiers are fused using a logistic regression meta-classifier. The proposed IDS is evaluated on NSL-KDD, UNSW-NB15, CICIDS2017, and BoT-IoT datasets, including experiments on a merged NSL-KDD + BoT-IoT dataset to assess performance under heterogeneous traffic integration. Experimental results demonstrate strong detection performance with 97.02% accuracy and an F1-score of 97.41% on the combined dataset, an AUC close to 0.98, and sub-millisecond inference latency. While cross-dataset and real-time evaluations highlight generalization challenges under dynamic traffic conditions, the overall results indicate that the proposed hybrid ensemble IDS achieves robust performance across diverse traffic characteristics while maintaining computational efficiency suitable for resource-constrained IoT environments.},
  keywords={Central Processing Unit;Bot (Internet);Communication systems;Internet;Internet of Things;Telecommunication traffic;Wireless sensor networks;Software defined networking;Computer networks;Protocols;Intrusion Detection System;XGBoost;LightGBM;Ensemble Learning;Feature Selection;NSL-KDD Dataset;BOT-IoT Dataset;IoT Security;Network Security;Machine Learning etc},
  doi={10.1109/ICOECA68095.2026.11485561},
  ISSN={},
  month={March},}@INPROCEEDINGS{11505157,
  author={Sugumar, S and Prakash, S and Radha, N and Swathika, R and Mary, L Jenitha},
  booktitle={2026 International Conference on Data Science, Agents and Artificial Intelligence (ICDSAAI)}, 
  title={Multimodal Speech Recognition Using Video and Neural Signals}, 
  year={2026},
  volume={1},
  number={},
  pages={1-6},
  abstract={Silent speech recognition is designed to facilitate communication without use of audible speech and it has huge advantages to people with speech problems like aphasia, apraxia and dysarthria. Although there have been encouraging studies on multimodal based techniques that utilize both neural and visual cues, there are still practical challenges associated with data availability, complexity of the system, and practical viability. The present paper will describe a multimodal silent speech recognition system combining the electroencephalography (EEG) signals and the video of lip movement with the assistance of modality-specific encoders and a cross-attention-based fusion system. The proposed structure aims to match complementary neural and visual codes to decode word pronunciations or speech images which are articulated or imagined silently. Experimental assessment, within the framework of this research, is concerned with proving the inner speech decoding part of the suggested architecture with the use of EEG. EEG signals are preprocessed and enhanced, and multi-domain feature extraction and ensemble-based classification is performed. The research results are evidenced by experimentation on an inner speech dataset which shows strong decoding behavior in various word classes with the best classification accuracy of $78.2 \%$. The architecture proposed will enable future multimodal merging, customization, and privacy conscious implementation to give a scalable platform to the upcoming generation of silent speech interfaces.},
  keywords={Electroencephalography;Modeling;Speech;Speech recognition;Videos;Lips;Decoding;Printing;Visualization;Accuracy;Multimodal speech recognition;EEG;lip read- ing;silent speech interfaces;cross-attention;deep learning},
  doi={10.1109/ICDSAAI69492.2026.11505157},
  ISSN={},
  month={March},}@INPROCEEDINGS{10601929,
  author={Nagaraj, S and Malathy, R and Merlin Sheeba, G},
  booktitle={2024 International Conference on Advances in Computing, Communication and Applied Informatics (ACCAI)}, 
  title={Real Time Spatial Sound Scene Analysis-AlertNet}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This project introduces a groundbreaking approach to enhance the accuracy of acoustic scene classification and ensures user safety within music player applications. It provides a combined model of deep learning by merging Convolutional Neural Networks (CNN) with Bidirectional Long Short-Term Memory (Bi-LSTM).The model uses Mel-Frequency Cepstral Coefficients (MFCC) and Gammatone Frequency Cepstral Coefficients (GFCC) features as feature extractors, and processes these features to predict scenes.Furthermore, this paper integrates the advanced scene classification model into music player applications. Users can enjoy their favourite music while the system continuously analyses the audio environment. When a potentially dangerous situation is detected, such as sirens, alarms, or other alerting sounds, the music playback is momentarily attenuated or paused, and users are promptly alerted to pay attention to their surroundings. Performance evaluation demonstrates $97 \%$ accuracy in a noisy environment and $98 \%$ accuracy in clean environment.The CNN-Bi-LSTM hybrid model, named AlertNet, excels in capturing both fine-grained and contextual audio information. Its seamless integration into music players enhances safety and user experience. Finally, it exemplifies the fusion of cutting-edge deep learning techniques with everyday technology to ensure safety and situational awareness for users, especially in scenarios where distractions are common.},
  keywords={Deep learning;Performance evaluation;Scene classification;Accuracy;Predictive models;Feature extraction;User experience;Audio feature extraction;MFCC;GFCC;acoustic signal processing;CNN;Bi-LSTM;Alerting system},
