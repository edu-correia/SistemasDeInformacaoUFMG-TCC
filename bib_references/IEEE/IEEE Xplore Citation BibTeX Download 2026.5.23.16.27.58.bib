  author={Kavudamalya, R and Nithish Kumar, J and Mathiarasi, B.},
  booktitle={2025 10th International Conference on Smart Structures and Systems (ICSSS)}, 
  title={Emotion-Aware Multimodal Healthcare Chatbot with Contextual Memory and Symptom-Based Assistance}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={We present an emotion-aware multimodal medical chatbot that will help provide medical assistance based on symptoms, using contextual memory and natural dialogue. Under the system, users are free to speak using a microphone or simply type in the Streamlit interface. In speech, audio will be captured using the sound device module and chopped into manageable segments and encoded using the Whisper model of OpenAI. BioBERT is applied with Named Entity Recognition (NER) to extract the symptom so that the medical and emotional intent of the user can be detected, and BioBERT GoEmotionsEkman is applied to classify emotional states using the core emotions taxonomy of Ekman. The chatbot is conversational and contextually sound through LangChain Runnable with Message History, and persistent and pseudonymized storage is stored at SQLite. Long and short interaction is scaled on context summarization and dynamic retrieval, and the processes are merged into a structured prompt and inputted to a fine-tuned BART encoder-decoder model. The MedDialogues dataset is first transformed to the medical domain with BART, and then further training on empathy with the EmpatheticDialogues dataset is performed. The model yields answers that are clinically correct, context and context-sensitive answers in a human-like flow of conversation. Any contact, including all the signs and symptoms distinguished, emotions, and responses of any nature, is safely documented to promote enhancement. An integrative model of privacy-aware, caring, and smart communication in the domain of digital healthcare is demonstrated in this architecture.},
  keywords={Training;Biological system modeling;Taxonomy;Oral communication;Named entity recognition;Chatbots;Intelligent structures;History;Context modeling;Microphones;BioBERT;BERT GoEmotions;BART;LangChain;Medical Chatbot;Contextual Memory;Multimodal Dialogue;Symptom Detection;Healthcare NLP},
  doi={10.1109/ICSSS66939.2025.11346109},
  ISSN={},
  month={Dec},}@ARTICLE{8477161,
  author={Alizadeh, Vahid and Kessentini, Marouane and Mkaouer, Mohamed Wiem and Ó Cinnéide, Mel and Ouni, Ali and Cai, Yuanfang},
  journal={IEEE Transactions on Software Engineering}, 
  title={An Interactive and Dynamic Search-Based Approach to Software Refactoring Recommendations}, 
  year={2020},
  volume={46},
  number={9},
  pages={932-961},
  abstract={Successful software products evolve through a process of continual change. However, this process may weaken the design of the software and make it unnecessarily complex, leading to significantly reduced productivity and increased fault-proneness. Refactoring improves the software design while preserving overall functionality and behavior, and is an important technique in managing the growing complexity of software systems. Most of the existing work on software refactoring uses either an entirely manual or a fully automated approach. Manual refactoring is time-consuming, error-prone and unsuitable for large-scale, radical refactoring. On the other hand, fully automated refactoring yields a static list of refactorings which, when applied, leads to a new and often hard to comprehend design. Furthermore, it is difficult to merge these refactorings with other changes performed in parallel by developers. In this paper, we propose a refactoring recommendation approach that dynamically adapts and interactively suggests refactorings to developers and takes their feedback into consideration. Our approach uses NSGA-II to find a set of good refactoring solutions that improve software quality while minimizing the deviation from the initial design. These refactoring solutions are then analyzed to extract interesting common features between them such as the frequently occurring refactorings in the best non-dominated solutions. Based on this analysis, the refactorings are ranked and suggested to the developer in an interactive fashion as a sequence of transformations. The developer can approve, modify or reject each of the recommended refactorings, and this feedback is then used to update the proposed rankings of recommended refactorings. After a number of introduced code changes and interactions with the developer, the interactive NSGA-II algorithm is executed again on the new modified system to repair the set of refactoring solutions based on the new changes and the feedback received from the developer. We evaluated our approach on a set of eight open source systems and two industrial projects provided by an industrial partner. Statistical analysis of our experiments shows that our dynamic interactive refactoring approach performed significantly better than four existing search-based refactoring techniques and one fully-automated refactoring tool not based on heuristic search.},
  keywords={Manuals;Tools;Software quality;Maintenance engineering;Optimization;Search-based software engineering;Refactoring;interactive optimization;software quality},
  doi={10.1109/TSE.2018.2872711},
  ISSN={1939-3520},
  month={Sep.},}@ARTICLE{10298256,
