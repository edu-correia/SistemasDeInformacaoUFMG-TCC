  month={Dec},}@ARTICLE{11525399,
  author={Bhatnagar, Gaurav},
  journal={IEEE Access}, 
  title={A Policy-Driven Branching and Environment Isolation Strategy for Enterprise DevSecOps: An Empirical Industrial Case Study}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={As enterprise software systems transition toward rapid delivery cycles, traditional branching models often introduce significant merge choreography and environment-specific bottlenecks that impede developer velocity. This paper presents a novel, single-Main streamlined branching strategy designed for high-compliance enterprise payment portals. Implemented within an AdonisJS and Google Cloud Platform (GCP) ecosystem, the proposed methodology moves beyond legacy environment-based models by leveraging a single long-lived branch synchronized with automated GitLab CI/CD pattern matching. This approach effectively decouples development testing from release stabilization by leveraging temporary release branches, enabling parallel User Acceptance Testing (UAT) without interrupting the primary delivery pipeline. The framework is operationalized via a GitLab CI/CD pipeline featuring manual authorization gates (visualized in Fig. 5), ensuring rigorous auditability for production releases. Empirical data gathered over a 12-month production evaluation involving a team of 5-8 developers reveals significant performance gains, including a 71.7% reduction in merge conflict incidence and a 70.8% improvement in deployment autonomy. Furthermore, the strategy enabled a 181.0% increase in deployment frequency, moving from a legacy baseline of 6.3 to 17.7 deployments per month. By formalizing the orchestration between branch patterns and cloud-native infrastructure, this research provides a scalable framework for maintaining high-frequency delivery in compliance-heavy, multi-region enterprise environments. These results validate recent pragmatic DevOps theories and offer a reproducible blueprint for streamlined application delivery in regulated industries.},
  keywords={Licenses;Modeling;Nuclear facility regulation;Merging;Security;Production;Pipelines;Manuals;Testing;Clouds;Branching strategies;Cloud computing;Continuous delivery;Continuous integration;Developer velocity;DevOps;GitLab;Google Cloud Platform (GCP);Network security;Payment Card Industry Data Security Standard (PCI DSS);Software configuration management;Software engineering},
  doi={10.1109/ACCESS.2026.3694956},
  ISSN={2169-3536},
  month={},}@ARTICLE{11352863,
  author={Nitulescu, Ioana-Victoria and Korodi, Adrian and Curiac, Daniel-Ioan},
  journal={IEEE Access}, 
  title={Industry 5.0: An Extended Experimental Case for Implementing a Multi-Level Framework for Enterprise Integration}, 
  year={2026},
  volume={14},
  number={},
  pages={8839-8853},
  abstract={With the rapid momentum of the Industry 5.0 paradigm due to its projected socio-economic impact, it has become essential to interpret its requirements into a concrete form. This study concentrates on an extended experimental use case, constructing a multi-level approach to address the identified challenges concerning system integration, digital transformation, interoperability, and OT-IT convergence at enterprise level. The experiment aims to evaluate a functional framework for the adoption of Industry 5.0, enhancing cooperation and collaboration, improving stability for future development and integration objectives, while respecting the general architectural design of the organizational infrastructure. The prototype involved the successful formation of a highly available enterprise infrastructure, introducing a modular development structure for Node-RED flows, augmenting system compatibility, transfer mechanisms, and protocols, including a fully dynamic data acquisition and standardization phase. The refined solution facilitates informed decision-making processes for involved personnel, while merging the OT and IT domains within an open-source, scalable, dynamic, highly-customizable and flexible framework, with minimal implementation and operational costs. This scholarly work underscores the importance of advancing towards contemporary data architectures that support and sustain growing data volumes, enhance user experience, and usability in operational processes. It champions an ideology that places scalability at the core of enterprise architecture strategies, thereby promoting advancements, performance, and growth opportunities through a single-source-of-truth (SSOT).},
  keywords={Fifth Industrial Revolution;Aging;Convergence;Scalability;Protocols;Sustainable development;Interoperability;Complexity theory;Technological innovation;Standards organizations;Data;Industry 5.0;integration;interoperability;node-RED;OT-IT convergence;standardization;virtualization},
  doi={10.1109/ACCESS.2026.3654252},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11320722,
  author={J, Johnsi Rani and K, Suresh},
  booktitle={2025 International Conference on Digital Innovations for Sustainable Solutions (ICDISS)}, 
  title={Integration of Electric Vehicles with Smart Grids: Adaptive Control Mechanisms for Suitable and Sustainable EV Charging Governance}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={As Electric Vehicles (EVs) are connected to the smart grid, this can provide both a transformational opportunity and a considerable challenge to the future sustainable energy infrastructure. With the growing deployment of EVs around the world, the strain on the power grids is increasing, especially during peak times of change. We consider the coordination of EVs within the smart grid context, with an emphasis on adaptive control strategies for a more efficient, green, and customer-oriented charging management. The proposed study presents a multilayered adaptive control framework using real-time data analytics, prediction and decentralized decision making for the optimal charging of electric vehicles. The system adapts in real-time to grid demand, supply of renewable, user needs and price signals. The framework improves the grid resilience with the increased energy efficiency and reduced carbon emissions by applying V2G communication, demand-side management, and machine learning-based forecasting. One of the most important strengths of this solution is its capability to adjust to heterogeneous users and dynamic grid status. The control structure combines demand response algorithms and distributed energy resource management to select charging according to priority, battery lifetime and environmental considerations. Policy-based charging rules and incentive mechanisms for off-peak charging and renewable energy consumption are also considered by this governance model. Simulation using realworld datasets show that the system can achieve up to 30 % reduced peak load, 22 % more renewable energy integration, and over 90 % users are satisfied with respect to charging sufficiency and flexibility. The proposed framework is scalable and interoperable providing the integration of various smart grid architectures, EV models, and energy markets. The research contributes to the advancement of intelligent and scalable EV charging ecosystems and is in line with global sustainability objectives and smart city goals. The suggested adaptive control solutions provide promise for a seamless control of the increasing EV population without sacrificing grid stability or user satisfaction. Moreover, the model can help the policy maker and the utility in designing a data-driven charging policy that considers the technical, economic, and environmental goals. And with the two worlds of mobility and energy increasingly merging, such flexible systems are key enablers to allow for smooth and sustainable transition to electrified transportation infrastructures.},
  keywords={Vehicle-to-grid;Renewable energy sources;Smart cities;Transportation;Electric vehicle charging;Real-time systems;Adaptive control;Sustainable development;Resilience;Load modeling;Renewable Energy Integration;Vehicle-to- Grid (V2G);Demand Side Management (DSM);EV Charging Optimization;Adaptive Control;Sustainable Energy Governance},
  doi={10.1109/ICDISS68238.2025.11320722},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11490959,
  author={Kumar, Gaurav and Mikkili, Suresh},
  booktitle={2025 IEEE 4th International Conference on Smart Technologies for Power, Energy and Control (STPEC)}, 
  title={Protection of Battery Management System of Electric Vehicles During Charging Using Hyperledger Fabric Blockchain}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The world is shifting from ICE engines to electric vehicles (EVs). Since electric vehicles are increasing, charging stations (CS) are also increasing. EVs must be protected from cyberattacks during charging. Because CS are connected to the public Internet. In this paper, a blockchain-integrated framework is proposed to protect battery voltage, current, and state of charge (SoC). The authentication and data storage of EVs is done using a smart contract written in JavaScript for real-time data of EVs. The Internet of Things (IoT)-enabled ESP32 is connected to the battery to communicate with the Hyperledger Fabric network. The performance of this network is analyzed for real-time data in terms of transactions per second. To validate the integration of blockchain technology with BMS data, a hardware prototype was developed. The mean execution time is 1.104 ms when Fabric runs on an i9 PC, and 9.38 ms when run on a Raspberry Pi 4.},
  keywords={Payloads;Broadcasting;Broadcast technology;System-on-chip;Circuits;Microcontrollers;Central Processing Unit;Field programmable gate arrays;Microprocessors;Application specific integrated circuits;Battery Management System;Hyperledger Fabric;Electric Vehicles;Blockchain Technology},
  doi={10.1109/STPEC66316.2025.11490959},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9287790,
  author={Jost, Ferdinand and Peter, Pascal and Weickert, Joachim},
  booktitle={2020 28th European Signal Processing Conference (EUSIPCO)}, 
  title={Compressing Piecewise Smooth Images with the Mumford-Shah Cartoon Model}, 
  year={2021},
  volume={},
  number={},
  pages={511-515},
  abstract={Compressing piecewise smooth images is important for many data types such as depth maps in 3D videos or optic flow fields for motion compensation. Specialised codecs that rely on explicitly stored segmentations excel in this task since they preserve discontinuities between smooth regions. However, current approaches rely on ad hoc segmentations that lack a clean interpretation in terms of energy minimisation. As a remedy, we derive a generic region merging algorithm from the Mumford- Shah cartoon model. It adapts the segmentation to arbitrary reconstruction operators for the segment content. In spite of its conceptual simplicity, our framework can outperform previous segment-based compression methods as well as BPG by up to 3 dB.},
  keywords={Image segmentation;Adaptation models;Image coding;Three-dimensional displays;Motion segmentation;Task analysis;Videos;Compression;segmentation;inpainting},
  doi={10.23919/Eusipco47968.2020.9287790},
  ISSN={2076-1465},
  month={Jan},}@INPROCEEDINGS{9803458,
