  title={Design and Verification of Autonomous Task Management for Remote Sensing Satellites}, 
  year={2024},
  volume={7},
  number={},
  pages={1364-1368},
  abstract={The remote sensing SAR satellites have built two rate level distributed information networks for the control, information transmission, and operational management of the entire satellite system. The article introduces the satellite’s requirements for ease of use and ease of use. It adopts layered and distributed autonomous task management architecture, providing users with advanced task interfaces and shielding the internal design status of the satellite, greatly simplifying satellite control. To meet the requirements of stable operation of satellites in orbit, task management measures such as autonomous task conflict and merging have been adopted. Finally, the testing verification and in orbit application of remote sensing SAR satellites in the development process of autonomous mission management system were introduced.},
  keywords={Satellites;Merging;Process control;Orbits;Reliability;Task analysis;Information technology;SAR satellite;autonomous task management;architecture},
  doi={10.1109/IAEAC59436.2024.10503618},
  ISSN={2689-6621},
  month={March},}@INPROCEEDINGS{10376949,
  author={Chen, Mengzhao and Shao, Wenqi and Xu, Peng and Lin, Mingbao and Zhang, Kaipeng and Chao, Fei and Ji, Rongrong and Qiao, Yu and Luo, Ping},
  booktitle={2023 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={DiffRate : Differentiable Compression Rate for Efficient Vision Transformers}, 
  year={2023},
  volume={},
  number={},
  pages={17118-17128},
  abstract={Token compression aims to speed up large-scale vision transformers (e.g. ViTs) by pruning (dropping) or merging tokens. It is an important but challenging task. Although recent advanced approaches achieved great success, they need to carefully handcraft a compression rate (i.e. number of tokens to remove), which is tedious and leads to sub-optimal performance. To tackle this problem, we propose Differentiable Compression Rate (DiffRate), a novel token compression method that has several appealing properties prior arts do not have. First, DiffRate enables propagating the loss function’s gradient onto the compression ratio, which is considered as a non-differentiable hyperparameter in previous work. In this case, different layers can automatically learn different compression rates layer-wisely without extra overhead. Second, token pruning and merging can be naturally performed simultaneously in DiffRate, while they were isolated in previous works. Third, extensive experiments demonstrate that DiffRate achieves state-of-the-art performance. For example, by applying the learned layer-wise compression rates to an off-the-shelf ViT-H (MAE) model, we achieve a 40% FLOPs reduction and a 1.5× throughput improvement, with a minor accuracy drop of 0.16% on ImageNet without fine-tuning, even outperforming previous methods with fine-tuning. Codes and models are available at https://github.com/OpenGVLab/DiffRate.},
  keywords={Computer vision;Image coding;Codes;Art;Merging;Transformers;Throughput},
  doi={10.1109/ICCV51070.2023.01574},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{10480162,
