  title={Symmetric region growing}, 
  year={2003},
  volume={12},
  number={9},
  pages={1007-1015},
  abstract={Of the many proposed image segmentation methods, region growing has been one of the most popular. Research on region growing, however, has focused primarily on the design of feature measures and on growing and merging criteria. Most of these methods have an inherent dependence on the order in which the points and regions are examined. This weakness implies that a desired segmented result is sensitive to the selection of the initial growing points. We define a set of theoretical criteria for a subclass of region-growing algorithms that are insensitive to the selection of the initial growing points. This class of algorithms, referred to as symmetric region growing algorithms, leads to a single-pass region-growing algorithm applicable to any dimensionality of images. Furthermore, they lead to region-growing algorithms that are both memory- and computation-efficient. Results illustrate the method's efficiency and its application to 3D medical image segmentation.},
  keywords={Image segmentation;Merging;Biomedical imaging;Image analysis;Image edge detection;Algorithm design and analysis;Instruments;Biology;Councils;Information management},
  doi={10.1109/TIP.2003.815258},
  ISSN={1941-0042},
  month={Sep.},}@INPROCEEDINGS{1467303,
  author={Hassouna, M.S. and Farag, A.A.},
  booktitle={2005 IEEE Computer Society Conference on Computer Vision and Pattern Recognition (CVPR'05)}, 
  title={Robust centerline extraction framework using level sets}, 
  year={2005},
  volume={1},
  number={},
  pages={458-465 vol. 1},
  abstract={In this paper, we present a novel framework for computing centerlines for both 2D and 3D shape analysis. The framework works as follows: an object centerline point is selected automatically as the point of global maximum Euclidean distance from the boundary, and is considered a point source (Ps) that transmits a wave front that evolves over time and traverses the object domain. The front propagates at each object point with a speed that is proportional to its Euclidean distance from the boundary. The motion of the front is governed by a nonlinear partial differential equation whose solution is computed efficiently using level set methods. Initially, the P/sub S/ transmits a moderate speed wave to explore the object domain and extract its topological information such as merging and extreme points. Then, it transmits a new front that is much faster at centerline points than non central ones. As a consequence, centerlines intersect the propagating fronts at those points of maximum positive curvature. Centerlines are computed by tracking them, starting from each topological point until the Ps is reached, by solving an ordinary differential equation using an efficient numerical scheme. The proposed method is computationally inexpensive, handles efficiently objects with complex topology, and computes centerlines that are centered, connected, one point thick, and less sensitive to boundary noise. In addition, the extracted paths form a tree graph without additional cost. We have extensively validated the robustness of the proposed method both quantitatively and qualitatively against several 2D and 3D shapes.},
  keywords={Robustness;Level set;Shape;Euclidean distance;Partial differential equations;Data mining;Merging;Differential equations;Topology;Noise shaping},
  doi={10.1109/CVPR.2005.306},
  ISSN={1063-6919},
  month={June},}@INPROCEEDINGS{6830999,
