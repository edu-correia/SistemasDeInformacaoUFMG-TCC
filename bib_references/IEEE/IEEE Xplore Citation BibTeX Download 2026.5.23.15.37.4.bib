  title={Metadata in a data grid construction}, 
  year={2004},
  volume={},
  number={},
  pages={315-316},
  abstract={The paper is focused on necessary metadata definitions, playing the key role in the grid construction. We briefly describe a realistic grid development scenario and necessary programming and metamodel abstractions.},
  keywords={Information technology;Peer to peer computing;Paper technology;Computer science;Databases;Data structures;Contracts;Data models;Merging;Conferences},
  doi={10.1109/ENABL.2004.42},
