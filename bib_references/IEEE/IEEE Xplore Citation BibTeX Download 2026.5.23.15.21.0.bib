  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={The nature of the giant diffuse non-thermal source in the A3411–A3412 complex}, 
  year={2013},
  volume={435},
  number={1},
  pages={518-523},
  abstract={Very Large Array deep radio images at 1.4 GHz in total intensity and polarization reveal a diffuse non-thermal source in the interacting clusters A3411–A3412. Moreover, a small-size low-power radio halo at the centre of the merging cluster A3411 is found. We present here new optical and X-ray data and discuss the nature and properties of the diffuse non-thermal source. We suggest that the giant diffuse radio source is related to the presence of a large-scale filamentary structure and to multiple mergers in the A3411–A3412 complex.},
  keywords={Galaxies: clusters: individual: Abell 3411;Galaxies: clusters: individual: Abell 3412;large-scale structure of Universe},
  doi={10.1093/mnras/stt1314},
  ISSN={1365-2966},
  month={Oct},}@ARTICLE{8179285,
  author={Chao, Daniel Yuh},
  journal={IMA Journal of Mathematical Control and Information}, 
  title={Improvement on ‘A merging method for the siphon-based flexible manufacturing systems maximally permissive controllers with simpler structures’}, 
  year={2016},
  volume={33},
  number={2},
  pages={163-171},
  abstract={Recent maximally permissive deadlock prevention controls for systems of simple sequential processes with resources (S3PR) also aim at constructing simplest structures in the shortest amount of time for flexible manufacturing systems modelled by Petri nets. The paper in Liu et al. (2013, IMA J. Math. Control Inf., doi:10.1093/imamci/dnt029) proposes a method to merge several monitors into a single one while not losing the live states. It achieves the same best results in the existing literature while avoiding the time-consuming reachability analysis which does not scale well with the large size of the nets. For a well-known benchmark, the method needs one more monitor than other approaches. Thus, siphon-based merging may not achieve minimal configuration. Although we could reduce one monitor, which monitor to choose to merge seem to be ad hoc. It is unclear how to select a monitor to reduce for large nets. This paper tackles such an issue successfully.},
  keywords={flexible manufacturing system;Petri net;deadlock;siphon},
  doi={10.1093/imamci/dnu034},
  ISSN={1471-6887},
  month={June},}@INPROCEEDINGS{4343473,
  author={Shafaat, Tallat M. and Ghodsi, Ali and Haridi, Seif},
  booktitle={Seventh IEEE International Conference on Peer-to-Peer Computing (P2P 2007)}, 
  title={Handling Network Partitions and Mergers in Structured Overlay Networks}, 
  year={2007},
  volume={},
  number={},
  pages={132-139},
  abstract={Structured overlay networks form a major class of peer- to-peer systems, which are touted for their abilities to scale, tolerate failures, and self-manage. Any long-lived Internet-scale distributed system is destined to face network partitions. Although the problem of network partitions and mergers is highly related to fault-tolerance and self-management in large-scale systems, it has hardly been studied in the context of structured peer-to-peer systems. These systems have mainly been studied under churn (frequent joins/failures), which as a side effect solves the problem of network partitions, as it is similar to massive node failures. Yet, the crucial aspect of network mergers has been ignored. In fact, it has been claimed that ring-based structured overlay networks, which constitute the majority of the structured overlays, are intrinsically ill-suited for merging rings. In this paper, we present an algorithm for merging multiple similar ring-based overlays when the underlying network merges. We examine the solution in dynamic conditions, showing how our solution is resilient to churn dur- ng the merger, something widely believed to be difficult or mpossible. We evaluate the algorithm for various scenar- os and show that even when falsely detecting a merger, the algorithm quickly terminates and does not clutter the network with many messages. The algorithm is flexible as the tradeoff between message complexity and time complexity can be adjusted by a parameter.},
  keywords={Corporate acquisitions;Merging;Routing;Peer to peer computing;IP networks;Partitioning algorithms;Bandwidth;Silicon carbide;Fault tolerant systems;Large-scale systems},
  doi={10.1109/P2P.2007.42},
  ISSN={2161-3567},
  month={Sep.},}@INPROCEEDINGS{5558910,
  author={Marshall, Brandeis},
  booktitle={2010 IEEE International Conference on Information Reuse & Integration}, 
  title={Determining result quality for vertical result merging}, 
  year={2010},
  volume={},
  number={},
  pages={350-354},
  abstract={Vertical search engines (VSEs) serves as a good alternative to irrelevant results retrieved by general-purpose search engines. However, a best VSE does not exist for all VSE domains. VSEs can have distributed and disjoint information within a specific domain. We introduce this emerging issue, vertical result merging. We identify issues uniquely related to vertical result merging and present a domain-oriented re-ranking method. We also develop a novel content quality measure to assess the usefulness of our approach as compared to traditional metasearch result merging.},
  keywords={Merging;Search engines;Metasearch;Computer science;Portals;Decision support systems;Google;content quality;vertical search engines;rank aggregation methods;experimentation},
  doi={10.1109/IRI.2010.5558910},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{1047646,
  author={Iqbal, R. and James, A. and Gatward, R.},
  booktitle={The 7th International Conference on Computer Supported Cooperative Work in Design}, 
  title={A framework for integration of CSCW}, 
  year={2002},
  volume={},
  number={},
  pages={43-48},
  abstract={This paper reports on the need for integration and different aspects of interoperability in CSCW. This is a part of our research towards investigating and developing an integrative framework for CSCW applications. The framework will enable different applications to communicate with each other to share information and to support organizational activities. It will be flexible enough to accommodate the various and varying needs of the user community. We discuss different types of integration and interoperability in CSCW and consider different models of CSCW systems. A framework for CSCW integration is presented. The framework includes ontological, coordination, user interface, security and transaction models. An example application scenario involving integration is given. The work is novel as no integrative framework for CSCW exists currently.},
  keywords={Application software;Ontologies;User interfaces;Calendars;Voting;Open systems;Usability;Privacy;Merging},
