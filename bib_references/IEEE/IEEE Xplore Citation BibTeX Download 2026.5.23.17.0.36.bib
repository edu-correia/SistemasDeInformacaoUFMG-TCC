  author={Chowdhary, Yuvraj Singh and Singh, Geetika},
  booktitle={2024 Second International Conference on Intelligent Cyber Physical Systems and Internet of Things (ICoICI)}, 
  title={The Convergence of IoT and 5G: Transforming Connectivity in Smart City Applications}, 
  year={2024},
  volume={},
  number={},
  pages={311-318},
  abstract={5G technology is a noteworthy achievement in developing wireless communication, offering unparalleled speed, little delay, and extensive connection. This article examines the profound influence of 5G on the (IoT), emphasizing how 5G's advanced features enable the smooth incorporation of IoT devices in several industries. 5G facilitates real-time data processing and transmission, which is essential for applications in smart cities, healthcare, industrial automation, and autonomous cars, due to its improved data transfer speeds and dependability. The study explores the technological connections between 5G and IoT, analyzing how network slicing, edge computing, and massive MIMO enhance the effectiveness and scalability of IoT systems. Moreover, it examines the difficulties and possibilities brought about by this merging, including issues of security, distribution of spectrum, and the need for novel regulatory structures. In conclusion, this article highlights the capacity of 5G to completely transform the (IoT), by stimulating progress and promoting a more interconnected and smarter global society.},
  keywords={Wireless communication;Accuracy;5G mobile communication;Smart cities;Scalability;Transforms;Data models;Internet of Things;Security;Edge computing;5G;Internet of Things (IoT);Connectivity;Low latency;Real-time data processing;Smart cities},
  doi={10.1109/ICoICI62503.2024.10696019},
  ISSN={},
  month={Aug},}@ARTICLE{10554552,
  author={Song, Wenhao and Zeng, Xiangqin and Abdelmoniem, Ahmed M. and Zhang, Housheng and Gao, Mingliang},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={Cross-Modality Interaction Network for Medical Image Fusion}, 
  year={2025},
  volume={71},
  number={1},
  pages={1385-1392},
  abstract={Multi-modal medical image fusion maximizes the complementary information from diverse modality images by integrating source images. The fused medical image could offer enhanced richness and improved accuracy compared to the source images. Unfortunately, the existing deep learning-based medical image fusion methods generally rely on convolutional operations, which may not effectively capture global information such as spatial relationships or shape features within and across image modalities. To address this problem, we propose a unified AI-Generated Content (AIGC)-based medical image fusion, termed Cross-Modal Interactive Network (CMINet). The CMINet integrates a recursive transformer with an interactive Convolutional Neural Network. Specifically, the recursive transformer is designed to capture extended spatial and temporal dependencies within modalities, while the interactive CNN aims to extract and merge local features across modalities. Benefiting from cross-modality interaction learning, the proposed method can generate fused images with rich structural and functional information. Additionally, the architecture of the recursive network is structured to reduce parameter count, which could be beneficial for deployment on resource-constrained devices. Comprehensive experiments on multi-model medical images (MRI and CT, MRI and PET, and MRI and SPECT) demonstrate that the proposed method outperforms the state-of-the-art fusion methods subjectively and objectively.},
  keywords={Feature extraction;Transformers;Image fusion;Biomedical imaging;Magnetic resonance imaging;Convolutional neural networks;Computational modeling;AI-generated content;medical image fusion;recursive neural network;transformer;deep learning},
  doi={10.1109/TCE.2024.3412879},
  ISSN={1558-4127},
  month={Feb},}@ARTICLE{10762792,
  author={Tian, Fengshi and Chen, Jinbo and Zheng, Jiakun and Wu, Hui and He, Jingyu and Wang, Xiaomeng and Fang, Chaoming and Yao, Yuan and Yang, Jie and Sawan, Mohamad and Tsui, Chi-Ying and Cheng, Kwang-Ting},
  journal={IEEE Transactions on Circuits and Systems for Artificial Intelligence}, 
  title={BioPI: An Energy Efficient and Low-Latency Neuromorphic Pipelined System With Joint Design Optimizations of Sensor-Algorithm-Processor for Wearable Healthcare}, 
  year={2025},
  volume={2},
  number={1},
  pages={64-78},
  abstract={Extensive research has been conducted on accurate classification of bio-signals for wearable healthcare applications, such as the detection of arrhythmia. Artificial Intelligence (AI) based methods utilizing dedicated neural networks (NN) have shown potential in classifying multi-class bio-signals. However, the separate designs of processors and sensors has introduced interaction overheads in existing studies, limiting their practicality and efficiency. Furthermore, there is a lack of detailed discussion on the joint design and optimization of bio-signal sensing, NN training, and NN acceleration. To address these challenges in wearable healthcare, this work proposes an efficient and low-latency neuromorphic system, BioPI, from a joint design perspective of sensor, algorithm, and processor. Inspired by biological neural systems, BioPI employs fully-spike dataflow with a hierarchical pipelined architecture, combining a mixed-signal analog-to-spike converter (ASC) and a compact pipelined spiking neural network (SNN) processor with event-triggered power gating. A unique duplicate-merge (DM) SNN algorithm is also presented to optimize the processing of ASC generated data during inference by converting the required SNN structures from 2-D to 1-D, which reduces on-chip memory size and operation numbers for inference by 2.02x and 1.98x, respectively, measured on ECG classification task while maintaining state-of-the-art accuracy. To validate the system functionality, we built an end-to-end verification platform including a fabricated 40nm ASC chip and a FPAG implementation of the SNN processor. To evaluate the overall energy efficiency of the entire system on silicon, a complete design of BioPI is also implemented in 40nm process and post-layout simulations are conducted. In arrhythmia detection tasks using the MIT-BIH ECG dataset, BioPI achieves an overall accuracy of 97.5% in 4-class classification and an energy efficiency of 0.767uJ/classification, with a merely 12.54us execution latency.},
  keywords={Sensors;Energy efficiency;Event detection;Biosensors;System-on-chip;Neuromorphic engineering;Spiking neural networks;Biomedical signal processing;Wearable devices;Program processors;Wearable healthcare;bio-signal processing;neuromorphic computing;spiking neural network;accelerator;system-on-chip;joint design of sensor-algorithm-processor},
  doi={10.1109/TCASAI.2024.3502573},
  ISSN={2996-6647},
  month={March},}@INPROCEEDINGS{10211259,
  author={Huang, Rui and Huang, Lican},
  booktitle={2023 6th International Conference on Electronics Technology (ICET)}, 
  title={Breast Cancer Pathological Image Classification Based on Deep Learning}, 
  year={2023},
  volume={},
  number={},
  pages={1323-1328},
  abstract={Breast cancer is a very serious disease, but the breast cancer cure rate is very high if it can be detected at early stage. Recently, various AI technologies are used for diagnosis and prediction of breast cancer. In this paper, we have investigated breast cancer for image classification and detection by different convolutional neural networks and parameters using BreaKHis dataset. We merge all different magnifying factor images and shuffle their orders to get more image data and construct trained network model to fit the specific zones of breast tumors. Among 12 experimental cases which classify 8 sub-types the highest test accuracy is 0.8635. And the experiments show that Neural Structured Learning paradigm has no effective to enhance test accuracy, the suitable enhancement methods and more effective data can enhance test accuracy, and image sizes cropped by data preprocess are important to enhance test accuracy rates.},
  keywords={Deep learning;Pathology;Breast tumors;Neurons;Medical services;Breast cancer;Data models;Breast Cancer;BreaKhis;medical AI;Deep Learning;Tensorflow},
  doi={10.1109/ICET58434.2023.10211259},
  ISSN={2768-6515},
  month={May},}@INPROCEEDINGS{10821466,
  author={Dehaghani, Nahid Binandeh and Aguiar, A. Pedro and Wisniewski, Rafal},
  booktitle={2024 IEEE International Conference on Quantum Computing and Engineering (QCE)}, 
  title={A Hybrid Quantum-Classical Physics-Informed Neural Network Architecture for Solving Quantum Optimal Control Problems}, 
  year={2024},
  volume={01},
  number={},
  pages={1378-1386},
  abstract={This paper proposes an integrated quantum-classical approach that merges quantum computational dynamics with classical computing methodologies tailored to address control problems based on Pontryagin's minimum principle within a Physics-Informed Neural Network (PINN) framework. By lever-aging a dynamic quantum circuit that combines Gaussian and non-Gaussian gates, the study showcases an innovative approach to optimizing quantum state manipulations. The proposed hybrid model effectively applies machine learning techniques to solve optimal control problems. This is illustrated through the design and implementation of a hybrid PINN structure to solve a quantum state transition problem in a two and three-level system, highlighting its potential across various quantum computing applications.},
  keywords={Quantum system;Target tracking;Neural networks;Stationary state;Optimal control;Computer architecture;Quantum state;Metrology;Trajectory;Quantum circuit;Quantum neural networks;Quantum control;Physics-informed neural networks;Optimal control},
  doi={10.1109/QCE60285.2024.00164},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10643896,
  author={Kim, Jeeseob and Yoo, Honghyeon and Lee, Seungjae and Byun, Hongsu and Park, Sungyong},
  booktitle={2024 IEEE 17th International Conference on Cloud Computing (CLOUD)}, 
  title={Coordinating Compaction Between LSM-Tree Based Key-Value Stores for Edge Federation}, 
  year={2024},
  volume={},
  number={},
  pages={419-429},
  abstract={Edge computing environments increasingly demand real-time data processing, leading to the adoption of log-structured merge-tree based key-value stores (LSM-KVS) for efficient data handling. LSM-KVS periodically runs compaction operations in the background to manage the database. However compaction delays cause write stalls, which lead to degraded throughput of LSM-KVS and system performance on resource-limited edge servers. An edge federation environment, which shares resources and tasks between edge servers, can alleviate the resource limitations. Such environments can leverage com-paction offloading where another server performs CPU-intensive compaction operations instead. But coordinating compaction offloading is an important challenge, as the performance of the server performing the compaction can be degraded. In this paper, we propose Edgepilot. Edgepilot is scheduling mechanism of compaction offloading that is designed for LSM-KVS within edge federation. Edgepilot schedules where to reallocate compactions among the edge servers. This is achieved by considering the resource and computing power of each server. As a result, the overall resource efficiency and compaction throughput are increased. In addition, Edgepi-lotprovides Edgecode to determine the effectiveness of compaction offloading. Edgecode is a mathematical modeling based on compaction processing data to approximate inter-server compaction processing times. Edgepilot is implemented on the prominent LSM-KVS, RocksDB v8.3.2, and demonstrates notable improvements compared to the conventional RocksDB. The overall write stall duration of the system is reduced by up to 71 %, and throughput is increased by 17%.},
  keywords={Cloud computing;Schedules;Processor scheduling;Computational modeling;System performance;Throughput;Real-time systems;Infrastructure;Edge Computing;Cloud Storage;Key-Value Store;LSM-tree},
  doi={10.1109/CLOUD62652.2024.00054},
  ISSN={2159-6190},
  month={July},}@INPROCEEDINGS{9880666,
  author={Guo, Wei and Huang, Chuan and Qin, Xiaoqi and Yang, Lian and Zhang, Wei},
  booktitle={2022 IEEE/CIC International Conference on Communications in China (ICCC)}, 
  title={Dynamic Clustering and Power Control for Two-Tier Over-the-Air Federated Learning}, 
  year={2022},
  volume={},
  number={},
  pages={494-499},
  abstract={Federated learning (FL) has been recognized as a promising distributed learning paradigm to support intelligent applications at the wireless edge. However, direct computing based on the information from the devices may not be resource efficient due to the relatively large communication cost between the devices and parameter server (PS). This paper studies the joint communication and learning design for the over-theair computation (AirComp)-based two-tier wireless FL scheme, where the lead devices first collect the local gradients from their nearby subordinate devices, and then send the merged results to the PS for the second round of aggregation. We establish a convergence result for the proposed scheme and derive the upper bound on the optimality gap between the expected and optimal global loss values. Next, based on the device distance and data importance, we propose a hierarchical clustering method to build the two-tier structure. Then, with only the instantaneous channel state information (CSI), we formulate the optimality gap minimization problem and solve it by using an efficient alternating minimization method. Numerical results show that the proposed scheme outperforms the baseline ones.},
  keywords={Wireless communication;Minimization methods;Upper bound;Distance learning;Clustering methods;Power control;Lead},
  doi={10.1109/ICCC55456.2022.9880666},
  ISSN={2377-8644},
  month={Aug},}@INPROCEEDINGS{10272859,
  author={Ge, Yifei and Li, Zhuo and Wang, Xiangheng and Yue, Xuebin and Meng, Lin},
  booktitle={2023 International Conference on Advanced Mechatronic Systems (ICAMechS)}, 
  title={YOLO-OR: a lightweight cross-stage object detection model for dish recycling robot}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={With the development of deep learning, object detection technology has been widely used in various areas. However, the large size of the model and the high computation cost limit the deployment on the devices of the robot. To address these problems, this study proposes a slight cross-stage object detection model YOLO-OR for the dish recycling robot. In detail, the cross-stage octave convolution combines with the residual structure to build a novel convolution block ORBlock, improving feature extraction capability through cross-stage convolution operations. Moreover, ORBlock significantly reduces the parameters via splitting the traditional convolution into two-dimension. In particular, the four outputs of the backbone’s last two ORBlocks are merged and transmitted to the YOLO neck for feature fusion. Based on the Dish-20 dataset, YOLO-OR achieves excellent performance with 99.56% mAP, 189.42 FPS, 4.64 G FLOPs and 3.29 MB parameters. Meanwhile, the performance of YOLO-OR outperforms other state-of-the-art YOLO models. These demonstrate the effectiveness of the proposal.},
  keywords={Deep learning;Mechatronics;Convolution;Computational modeling;Feature extraction;Recycling;Neck;Dish recycling robot;octave convolution;object detection;YOLO-OR},
  doi={10.1109/ICAMechS59878.2023.10272859},
  ISSN={2325-0690},
  month={Sep.},}@INPROCEEDINGS{10674287,
  author={Yang, Chun and Xie, Haijun and Wang, Jiahang and Liang, Haohua and Zhang, Yuting and Deng, Yi},
  booktitle={2024 4th International Conference on Machine Learning and Intelligent Systems Engineering (MLISE)}, 
  title={AquaAE: A Lightweight Deep Learning Network for Underwater Image Restoration}, 
  year={2024},
  volume={},
  number={},
  pages={138-144},
  abstract={Due to the physical properties of water and the presence of suspended particles, underwater images often exhibit a bluish-green tint, reduced contrast, and uneven light distribution. Many researchers strive for better image restoration techniques, but they often overlook the high computational demands of these models, limiting their application in resource-constrained scenarios. To address this, we have introduced a model named AquaAE for image restoration. This model adopts a simple autoencoder structure, utilizing skip connections to merge features from the encoder and decoder, and incorporates a red channel enhancement to improve image restoration quality. Compared to advanced deep learning networks like U- Transformer, Twin-UIE, and Semi-UIR, our model is more straightforward, employing only simple convolution and upsampling. Combined with our specially calculated red channel enhancement coefficients tailored for different water conditions, AquaAE efficiently captures local features and spatial relationships, thereby better restoring image colors. AquaAE excels in classical evaluation metrics such as Mean Squared Error (MSE), Peak Signal-to-Noise Ratio (PSNR), and Structural Similarity Index Measure (SSIM). More critically, our model demonstrates outstanding computational efficiency, with its FLOPs being only 2.6% of Twin-UIE's (1.32G) and its parameter count merely 2.8% of U-Transformer's (0.88M), highlighting the lightweight nature of the model. This lightweight design is crucial not only for improving image restoration effectiveness but also for underwater mobile devices with limited computational resources and battery life. We trained AquaAE on the underwater scenes subset of the EUVP dataset and tested it on the underwater ImageNet subset of the EUVP dataset. The results show that AquaAE performs exceptionally well in underwater image restoration.},
  keywords={Deep learning;Water;PSNR;Image color analysis;Computational modeling;Streaming media;Transformers;AquaAE;U-shaped net;Image restoration},
  doi={10.1109/MLISE62164.2024.10674287},
  ISSN={},
  month={June},}@INPROCEEDINGS{9926321,
