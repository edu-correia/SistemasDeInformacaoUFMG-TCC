  journal={IEEE Transactions on Software Engineering}, 
  title={A Retrospective on the Source Code Control System}, 
  year={2025},
  volume={51},
  number={3},
  pages={695-699},
  abstract={The Source Code Control System (SCCS) was first introduced in 1975 (Rochkind, 1975). It controlled computer program source code by tracking versions and recording who made changes, when, and why. The present retrospective paper assesses the strengths and weaknesses of SCCS and traces its influence on software engineering over the past fifty years.},
  keywords={Software;Software engineering;Merging;Control systems;Programming;Source coding;Mainframes;Codes;Software reliability;Software development management;Software development management;software engineering;software reliability;software tools;version control systems;software configuration management;source control management},
  doi={10.1109/TSE.2024.3524947},
  ISSN={1939-3520},
  month={March},}@INPROCEEDINGS{10006804,
  author={Ikama, Aurel and Du, Vincent and Belias, Philippe and Muse, Biruk Asmare and Khomh, Foutse and Hamdaqa, Mohammad},
  booktitle={2022 IEEE 22nd International Working Conference on Source Code Analysis and Manipulation (SCAM)}, 
  title={Revisiting the Impact of Anti-patterns on Fault-Proneness: A Differentiated Replication}, 
  year={2022},
  volume={},
  number={},
  pages={56-65},
  abstract={Anti-patterns manifesting on software code through code smells have been investigated in terms of their prevalence, detection, refactoring, and impact on software quality attributes. In particular, leveraging heuristics to identify fault-fixing commits, Khomh et al. have found that anti-patterns and code smells have an impact on the fault-proneness of a software system. Similarly, Saboury et al. found a relationship between anti-pattern occurrences and fault-proneness, using heuristic to identify fault-fixing commits and fault-inducing changes. However, recent studies question the accuracy of heuristics, and thus the validity of empirical studies that leverage it. Hence, in this work, we would like to investigate to what extent the results of empirical studies using heuristics to identify bug fix commits are affected by the limitations of the heuristics based approach using manually validated bug fix commits as a ground truth. In particular, we conduct a differentiated replication of the work by Khomh et al. We particularly focused on the impact of anti-patterns on fault-proneness as it is the only dependent variable that may be affected by noise in the collected faults data. In our differentiated replication study, (1) we expanded the number of subject systems from 5 to 38, (2) utilized a manually validated dataset of bug-fixing commits from the work of Herbold et al., and (3) answered research questions from Khomh et al., that are related to the relationship between anti-pattern occurrences and fault-proneness. (4) We added an additional research question to investigate if combining results from several heuristic-based approaches could help reduce the impact of noise. Our findings show that the impact of the noise generated by the automatic algorithm heuristic based is negligible for the studied subject systems; meaning that the reported relation observed on noisy data still holds on the clean data. However, we also observed that combining results from several heuristic based approaches do not reduce this noise, quite the contrary.},
  keywords={Fault diagnosis;Codes;Source coding;Heuristic algorithms;Computer bugs;Merging;Software quality;Anti-patterns;Fault-proneness;Heuristic},
  doi={10.1109/SCAM55253.2022.00012},
  ISSN={2470-6892},
  month={Oct},}@INPROCEEDINGS{9061939,
  author={Ouyang, Fan and Zhu, Weijun and Li, Hui and Liang, Wenwu and Xu, Hao and Xu, Liqiang},
  booktitle={2019 IEEE 3rd Conference on Energy Internet and Energy System Integration (EI2)}, 
  title={Study on Calibration System for Merging Unit Test Equipments}, 
  year={2019},
  volume={},
  number={},
  pages={165-170},
  abstract={Today the problem of lacking effective calibration means for two key test function Indicators(delay characteristics and precision) of substation merging unit (MU) performance test equipment still exists. Under the background, this paper presents a calibration method for MU performance test equipment, develops a relevant calibration system and introduces the structure and technical indicators of the calibration system. The calibration system is based on the hardware system of high performance ARM processor, field programmable gate array (FPGA) and high precision AD chip. Then, a pre-circuit for quick sampling of voltage and current is designed to reduce sampling delay error, a high precision amplitude and phase algorithm of fixed frequency sampling is applied to realize high precision measurement of sampling signals, and a precise and flexible test strategy for delay characteristics is adopted. Finally, the comparative test of MU test equipment is carried out by using this calibration system, which basically solves the practical problem that the core performance of substation MU test equipment cannot be detected.},
  keywords={Merging;Test equipment;Calibration;Delays;Voltage measurement;Power systems;Generators;delay characteristics;precision;calibration system;MU test equipment},
