  month={},}@INPROCEEDINGS{11326635,
  author={Feng, Ji and Chen, Jing},
  booktitle={2025 6th International Conference on Big Data, Artificial Intelligence and Internet of Things Engineering (ICBAIE)}, 
  title={A hierarchical clustering algorithm based on granular-ball and shared natural nearest neighbour}, 
  year={2025},
  volume={},
  number={},
  pages={426-430},
  abstract={Currently, there are relatively few studies that combine the granular-balls with clustering. Existing approaches mainly rely on the distance or density between granular-balls, which may overlook the internal data connections within each granular-ball, leading to reduced clustering accuracy. To address this issue, we propose a novel hierarchical clustering algorithm based on granular-balls and shared natural nearest neighbors. First, the dataset is divided into multiple granular-balls using a granular-ball splitting method. Simultaneously, the natural neighbor eigenvalues, which contain characteristic information of the dataset, are adaptively obtained using the natural neighbor algorithm. These eigenvalues are then used to construct a shared natural nearest neighbor matrix among the granular-balls. Based on the similarity information derived from this matrix, granularballs are iteratively merged until the desired clustering results are achieved. A comprehensive evaluation on both synthetic and realworld datasets validates the consistently superior performance of our method.},
  keywords={Accuracy;Heuristic algorithms;Scalability;Merging;Clustering algorithms;Big Data;Data structures;Eigenvalues and eigenfunctions;Internet of Things;Time complexity;Granular-balls;Natural neighbor algorithm;Hierarchical clustering;Similarity merging},
  doi={10.1109/ICBAIE66852.2025.11326635},
  ISSN={},
