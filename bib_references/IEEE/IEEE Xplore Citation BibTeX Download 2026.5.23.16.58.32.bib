  year={2025},
  volume={},
  number={},
  pages={698-706},
  abstract={MetaEdit+ is a mature language workbench that supports merge-free collaborative modeling with user-defined domain-specific modeling languages. We describe how MetaEdit+ supports the Model Management Challenge 2025 (https://doi-org.ez27.periodicos.capes.gov.br/10.5281/zenodo.15285132). The modeling solution presented enables collaborative simultaneous work directly in high-level models, minimizes the effort of modeling and integration, provides fast feedback on changes, keeps artefacts consistent, traceable and up-to-date, and provides hassle-free versioning.},
  keywords={Collaboration;Systems modeling;Model driven engineering;Model management;system modeling;MetaEdit+;metamodel;language engineering},
  doi={10.1109/MODELS-C68889.2025.00114},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11282648,
  author={Hemmuang, Chonnapat and Phdungsilp, Aumnad and Wetchakama, Somboon},
  booktitle={2025 International Conference on Power, Energy and Innovations (ICPEI)}, 
  title={Scenario-Based and Sensitivity-Driven Energy Management for Carbon-Neutral University Campuses in KMUTT}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The planning of carbon-neutral university campuses requires precise forecasting tools that provide interpretable results and handle uncertainties to make effective decisions. The research presents an extensive AI-based methodological framework that merges scenario analysis with sensitivity evaluation and uncertainty quantification to boost the technical reliability of long-term energy forecasting. The hybrid deep learning model consisting of Convolutional Neural Networks (CNN), Bidirectional Long Short-Term Memory (BiLSTM) and Transformer-based attention mechanisms received training from five years (2020–2024) of detailed energy and meteorological and occupancy data from King Mongkut’s University of Technology Thonburi (KMUTT) in Thailand. The model demonstrated excellent predictive performance (R2 = 0.96) and received validation through Monte Carlo Dropout for generating probabilistic prediction intervals which captured model-based epistemic uncertainty. Four policy-aligned scenarios were simulated: Business-as-Usual (BAU), Energy Efficiency (EE), Renewable Integration (RE), and Behavioral Change. The EE scenario projected a 20% decrease in energy consumption for 2040 while RE and behavioral interventions led to 15–20% and 8–10% reductions respectively. The most influential variables according to SHAP (Shapley Additive Explanations) analysis were historical energy consumption and ambient temperature and occupancy. The Tornado chart-based sensitivity analysis demonstrated that model outputs remain highly sensitive to ±10–30% variations in these inputs which underscores the importance of maintaining high-quality data and robust monitoring systems. The study provides a replicable technical framework for university energy governance by linking high-resolution forecasting with scenario-driven energy planning under uncertainty. The proposed approach enables data-driven sustainable campus operations that scale toward carbon neutrality throughout ASEAN and additional regions.},
  keywords={Deep learning;Energy consumption;Uncertainty;Predictive models;Carbon neutral;Transformers;Data models;Planning;Convolutional neural networks;Forecasting;Carbon Neutrality;Deep Learning Forecasting;Scenario Analysis;Uncertainty Quantification;SHAP Interpretability},
  doi={10.1109/ICPEI66116.2025.11282648},
  ISSN={},
  month={Oct},}@ARTICLE{11435382,
  author={Trinh, Ha Linh and Lim, Jing Xian and Kieu, Hieu Trung and Er, Jenn Wei and Pang, Dawn Sok Cheng and Law, Adrian Wing-Keung},
  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={Multisensor Fusion for Monitoring Shorelines and Coastal Environments: A Review and Perspective With Satellite Imagery}, 
  year={2026},
  volume={19},
  number={},
  pages={10910-10935},
  abstract={Satellite-derived remote sensing has emerged as an indispensable tool for monitoring dynamic shorelines and coastal environments. However, persistent challenges remain with single-satellite adoptions, including limited spatial resolutions, spectral constraints, low revisit cycles, and atmospheric interferences, which hinder their efficacy. This review summarizes recent advancements in multisatellite fusion, which integrates data derived from different available satellites that can be equipped with multispectral or hyperspectral cameras, synthetic aperture radar (SAR), and light detection and ranging (LiDAR), to enhance accuracy and reliability in coastal monitoring. New strategies that synergize pixel-level and feature-level fusion techniques can address critical challenges in coastal remote sensing. Improvements in pixel-level fusion techniques, such as pan-sharpening, can also significantly enhance spatial resolution by merging high-resolution commercial satellites (e.g., WorldView-3, PlanetScope, SPOT) with lower-resolution public satellites (e.g., Sentinel-2, Landsat). Complementary feature-level fusion techniqueshelp to perceive contextual integrity through spectral indices, texture analysis, and machine learning. The synergistic integration of cloud-penetrating SAR (e.g., Sentinel-1) and precise LiDAR (e.g., ICESat-2) with optical data (e.g., Landsat, Sentinel-2) further enables all-weather monitoring capabilities, particularly valuable for tropical coasts with persistent cloud cover. These advancements in multisensor fusion highlight the potential for further precise and scalable satellite-based coastal monitoring, which can aid in climate-resilient solutions for sustainable coastal management.},
  keywords={Sea measurements;Monitoring;Satellites;Spatial resolution;Optical sensors;Optical imaging;Synthetic aperture radar;Laser radar;Water quality;Landsat;Coastal environments;dynamic shorelines;multisatellite;remote sensing;sensor fusion},
  doi={10.1109/JSTARS.2026.3674566},
  ISSN={2151-1535},
  month={},}@INPROCEEDINGS{10917242,
  author={Han, Yaru and Zhu, Yafang and Zhang, Shiming and Ye, Nan},
  booktitle={2024 IEEE International Conference on Energy Internet (ICEI)}, 
  title={A Research of Trading Liberty in Power Market Considering Carbon-Marginal Cost and Unit Carbon Emission Allowance}, 
  year={2024},
  volume={},
  number={},
  pages={478-483},
  abstract={in this study, a model containing multiple types of power plants based on realistic data is constructed, to solve for minimum power purchase cost with the total carbon emission not exceeding the regional carbon emission cap. Carbon costs are merged into power generation marginal costs to represent true marginal costs under carbon emission regulation after carbon allowance and green certificate trading rules are set. The new concept of unit carbon allowance is explored extensively to promote the advancement of carbon reduction technology of coal-fired power plants by unit carbon emission responsibility. The key points are to build a logical integration of carbon trades and conventional marginal costs, as well as meaningfully express the trading liberty in carbon emission and reserve market for optimized resources allocation. Experiments of three scenarios with different trading mechanisms are conducted, to contrast the effects of regulations. Through establishing the relationship between the trading liberty and results, this research aims to present new ideas for achieving minimum power purchase cost while limiting the regional carbon emission and improve the consumption of renewable power via market administration.},
  keywords={Renewable energy sources;Costs;Limiting;Green products;Energy Internet;Carbon dioxide;Power markets;Regulation;Distributed power generation;Resource management;power market;trading model;distributed energy resources;carbon emission;green certificate},
  doi={10.1109/ICEI63732.2024.10917242},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11307018,
  author={Luo, Xiaoqing},
  booktitle={2025 6th International Conference on Modern Education and Information Management (ICMEIM)}, 
  title={A Dummy Variable Regression Study of the Relationship Between Formative and Summative Assessments in the Data Mining Course}, 
  year={2025},
  volume={},
  number={},
  pages={149-153},
  abstract={To explore the quantitative relationship between formative and summative assessment, this study constructed a regression model with interaction terms using assessment data from 131 students in the Data Mining course. In this model, Assignment, Check-in, and Bonus Points were treated as numerical variables, while Quiz and Discussion/Group Task (merged into a dummy variable $D / G$) were set as dummy variables. We then implemented stepwise regression analysis using the $\text{lm}()$ and step() functions in $\mathbf{R}$ (version 4.4.2) for model optimization. The results showed that Assignment and Check-in were significantly positively correlated with Summative Assessment. After introducing dummy variables and interaction terms, the explanatory power of the model significantly improved ($\boldsymbol{R}^{\mathbf{2}}$ increased from 0.1408 to 0.4798). The dummy variable Quiz was significantly negatively correlated with Summative Assessment (Coefficient $=-48.4187, t=-4.0202, p <0.01$), but its interaction effect with Bonus Points was significantly positive (Coefficient $=0.3256, t=2.1210, p<0.05$), indicating a high dependency between Quiz and students' classroom participation. Although the main effect of $D / G$ was not significant, its interaction effect with Bonus Points was significantly positive (Coefficient $=0.6099, t=3.6993, p<0.01$), and its interaction effect with Assignment was significantly negative (Coefficient $=-0.2961, t=-2.0534, p<0.05$), revealing complex interdependencies and substitution relationships among different formative assessment items. The findings of this study indicate that it is insufficient to evaluate the effectiveness of a single assessment method in isolation, and assessment design must be optimized from a perspective of systematic integration. This study provides empirical evidence for optimizing curriculum evaluation systems using data-driven methods. (Abstract)},
  keywords={Analytical models;Systematics;Education;Data models;Numerical models;Regression analysis;Information management;Data mining;Optimization;formative assessment;summative assessment;data mining;regression analysis;dummy variable (key words)},
  doi={10.1109/ICMEIM66684.2025.11307018},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11321885,
  author={Mathlouthi, Moez and Trimech, Imen Hamrouni and Amara, Najoua Essoukri Ben},
  booktitle={2025 11th International Conference on Control, Decision and Information Technologies (CoDIT)}, 
  title={Enhanced Multimodal approach for Parkinson’s Disease Detection: fusing deep handwriting and Voice Features with Optimized Classification}, 
  year={2025},
  volume={1},
  number={},
  pages={1-6},
  abstract={Parkinson’s disease (PD) is a progressive neurodegenerative disorder that leads to motor impairments. Early detection is crucial for effective treatment; however, conventional diagnostic methods are often costly, time-consuming, and inaccessible, limiting their widespread clinical adoption. To address these challenges, we propose a novel hybrid approach that merges Deep Learning (DL) features extrated from handwriting images with voice characteristics using an optimized machine learning (ML) classification technique. The integration of multimodal data enhances robustness by reducing dependency on a single biomarker, making PD diagnosis more reliable. We begin by augmenting both of the datasets size to expand samples diversity. Then, we combine DenseNet201’s detailed features with ResNet50’s robust spatial features to enhance analytical precision and capture both fine-grained and high-level patterns of handwriting images. The obtained DL features are fused with voice characteristics leveraging complementary information. Afterwards, feature selection is performed using Fisher’s score to retain the most relevant attributes, further boosting classification accuracy. We achieve an accuracy of 92.31%, demonstrating superior performance compared to state-of-the-art methods.},
  keywords={Deep learning;Accuracy;Limiting;Soft sensors;Feature extraction;Motors;Boosting;Robustness;Information technology;Diseases;Parkinson disease detection;Deep features;Feature fusion;Fisher score;Extratrees},
  doi={10.1109/CoDIT66093.2025.11321885},
  ISSN={2576-3555},
  month={July},}@INPROCEEDINGS{10762263,
  author={Nury Safitri, Safira and Fauziati, Silmi and Hidayah, Indriana},
  booktitle={2024 International Conference on Information Technology and Computing (ICITCOM)}, 
  title={Analyzing Sentiment's Impact on Stock Price Prediction: A Comprehensive Survey}, 
  year={2024},
  volume={},
  number={},
  pages={160-165},
  abstract={Stock price movements are crucial subject in modern economic discussions, significantly affecting both academic and practical financial strategies. Predicting accurately stock prices is vital for investors, as it aids in making informed decisions that ensure sustainable profitability. Nevertheless, the stock market's unpredictable and non-stationary nature, along with its susceptibility to random disturbances, presents substantial forecasting challenges. Various approaches, including sentiment analysis, have been developed to address these challenges. Sentiment analysis, particularly, has proven effective in predicting stock prices by analyzing the emotions and opinions from news platforms and social media. This approach offers a unique perspective on how public sentiment impacts market reactions to news and events. This research delves into how the integration of sentiment analysis with other predictive models influences stock price predictions. A systematic literature review was conducted using the PICOC framework (Population, Intervention, Comparison, Outcomes, and Context) from 2020 to 2024, examining the effects of sentiment on stock predictions, used methods, and evaluation metrics. Our analysis of 38 selected studies indicates that merging sentiment analysis with traditional financial models not only enhances prediction accuracy but also offers strategic market insights, especially under volatile conditions.},
  keywords={Measurement;Surveys;Support vector machines;Sentiment analysis;Analytical models;Accuracy;Social networking (online);Computational modeling;Predictive models;Data models;Stock Price Prediction;Stock Forecasting;Sentiment Analysis;Sentiment Impact on Stock Market},
  doi={10.1109/ICITCOM62788.2024.10762263},
  ISSN={},
  month={Aug},}@INBOOK{9866597,
  author={Loskot, Pavel},
  booktitle={Emerging Computing Paradigms: Principles, Advances and Applications}, 
  title={Mobile Networks}, 
  year={2022},
  volume={},
  number={},
  pages={161-175},
  abstract={The user mobility has been supported since the early generations of mobile cellular networks. Other types of mobile ad&#x2010;hoc networks (MANETs) evolved independently as the special purpose communication networks. The recent 5G revolution aims to merge all communication networks into one ubiquitous global network with a seamless integration of communication services that are transparent to the mobile end users and devices. This chapter reviews main principles of mobile networks, and the strategies and challenges in designing mobile networks with 5G support. In particular, the concepts, design challenges, and key developments in vehicle ad&#x2010;hoc networks (VANETs) including connected cars, unmanned aerial vehicles (UAVs), and low&#x2010;Earth orbit (LEO) satellites are outlined. Tactical networks encompassing different types of mobile networks are also considered.},
  keywords={Protocols;Ad hoc networks;Mobile computing;Base stations;Cellular networks;Telecommunication network reliability;Scalability},
  doi={10.1002/9781119813439.ch9},
  ISSN={},
  publisher={Wiley},
  isbn={9781119813415},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/9866597},}@INPROCEEDINGS{11415983,
  author={Prabhune, Sonal and Padmanabhan, Balaji and Dutta, Kaushik},
  booktitle={2025 IEEE International Conference on Data Mining Workshops (ICDMW)}, 
  title={Measuring and Mitigating Gender Entropy Bias in Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={2237-2246},
  abstract={We investigate gender bias in the form of differences in information content in some of the popular LLMs and contribute a new benchmark dataset (released on HuggingFace) developed from real-world questions across four key domains in business and health contexts: education, jobs, personal financial management, and general health. Specifically, we introduce entropy bias, which we define as a discrepancy in the amount of information generated by an LLM in response to real questions users have asked. Grounded in authentic user questions and guided by quantitative metrics, our benchmark enables systematic and reproducible analysis of gender entropy biases in language model outputs, which we test using multiple LLMs. Our analyses (metric-based comparisons and “LLM-as-judge” evaluation) suggest that there is no significant bias in LLM responses for men and women at a category level. However, at a finer granularity (the individual question level) there are substantial differences in LLM responses for men and women in the majority of cases, which “cancel” each other out often due to some responses being better for males and vice versa. To address this, we suggest a simple debiasing approach that iteratively merges the responses for the two genders to produce a final result. Our approach demonstrates that a simple, prompt-based debiasing strategy can effectively debias LLM outputs, thus producing responses with higher information content than both gendered variants more than 77% of the cases, and consistently achieving a balanced integration in the remaining cases.},
  keywords={Measurement;Systematics;Generative AI;Large language models;Conferences;Education;Benchmark testing;Financial management;Entropy;Data mining;Fairness;Bias;Generative AI;GenAI;Entropy Bias;Large Language Models;LLMs;LLM Bias;Gender Bias},
  doi={10.1109/ICDMW69685.2025.00272},
  ISSN={2375-9259},
  month={Nov},}@ARTICLE{11503819,
  author={Huang, Shaoyuan and Wang, Zheng and Zhang, Heng and Wang, Xiaofei and Zhang, Cheng and Wang, Wenyu},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={DynEformer: a Unified Framework for Robust Workload Prediction under Dynamic Environment}, 
  year={2026},
  volume={},
  number={},
  pages={1-14},
  abstract={Workload prediction in multi-tenant edge cloud platforms (MT-ECP) is crucial for efficient application deployment and resource provisioning. However, the heterogeneous application patterns, variable infrastructure performance, and frequent deployments in MT-ECP pose significant challenges for accurate prediction. Existing clustering-based methods often incur excessive costs due to maintaining multiple data clusters and models, while end-to-end time-series prediction methods struggle with dynamic environments. To address these challenges, we perform a comprehensive analysis on a large-scale workload dataset in real-world MT-ECP and propose DynEformer, an end to-end framework with global pooling and static context aware ness, offering a unified workload prediction scheme for dynamic MT-ECP. Meticulously designed global pooling and information merging mechanisms can effectively identify and utilize global application patterns to drive local workload predictions. The integration of static content-aware mechanisms enhances model robustness in real-world scenarios. We also extend DynEformer's capabilities to Long-term workload forecasting (LTLF) and Long-period service (LPS) tasks. Experiments on six real-world datasets demonstrate that DynEformer achieves state-of-the-art performance, with a 32% relative improvement on nine baselines and a 52% improvement in application switching and new entity scenarios. Additional experiments on long-term prediction and online learning further confirm its effectiveness for LTLF and LPS tasks.},
  keywords={Feeds;Central Processing Unit;Electronic circuits;Cloud computing;Internet;Communication systems;Computer networks;Regional area networks;Radio access networks;LoRa;Edge cloud;workload prediction;Transformer;dynamic time series},
  doi={10.1109/TKDE.2026.3689812},
  ISSN={1558-2191},
  month={},}@INPROCEEDINGS{11390254,
  author={Manchana, RamaKrishna and Swaleh, Mohd Abu and K., Vasumathi A. and Vekariya, Vipul and L, Natrayan and SivaramKrishnan, M.},
  booktitle={2025 International Conference on Intelligent Computing, Information and Control Systems (ICOIICS)}, 
  title={Black-Winged Kite Algorithm-Optimized Probabilistic Spiking Networks for IoT-Enabled Smart Grid Stability Prediction}, 
  year={2025},
  volume={},
  number={},
  pages={442-448},
  abstract={An intensified integration of intermittent renewables and time-sensitive loads compels power systems to adopt stochastic stability forecasts that harmonise operational integrity and the economic sustainment of legacy transmission grids. Existing forecasting paradigms, notwithstanding their theoretical soundness, exhibit persistent deficiencies: they frequently mischaracterise abrupt-controlled-device ramps, inadequately condense extraneous feature dimensions, and fail to produce almost real-time analytical guidance as data streams interrogate structural changes. The present contribution articulates a Probabilistic Spiking Neural Network, fine-tuned via the Black-Winged Kite Algorithm (PSNN-BKA), that multiplies forecasting agility whilst tightening uncertainty bandwidth. Standard UCI benchmark datasets are channelled through an ordered preprocessing workflow. Fast Correlation-Based Normalisation Filters (FCNF) prune superfluous dimensions. In tandem, pluralitybalanced bootstrap samplings attenuate the overfitting risk inherently implicatory of these curated subsets. Feature relevance attains additional verification via a Multi-View Fuzzy Clustering linked to an Anchor Graph (MVFCAG), which synthesises multi-feature correlation visualisation while permitting the extraction of hyperevident influential triads. Spiking time encodings, restrained to binary impulses and inter-spike intervals, transport dynamic events through a temporal contour. Parallelly, the Black-Winged Kite Algorithm concentrates stochastic excursions around the palaeocycle incumbents exhibiting the strongest posterior expected gain, thereby accelerating convergence and effecting tighter hyperparameter coatings. When merged with edgecomputing Internet-of-Things sensors, the proposed architecture furnishes continuous, real-time observability, executes autonomous anomaly detection that eliminates the delays of human intervention, and effectively secures traditional SCADA systems against false-data and measurement-inertia threats. Experimental trials, using a large observational dataset, demonstrate that the model outperforms established benchmark systems published in the current literature. Key performance indicators indicate a sustained accuracy that resides well above operationally critical thresholds, precision values are consistently elevated, recall metrics disclose a concordance of 99.85% with externally validated stability regimes, and the derived F1 score is 99.82%. Collectively, these metrics substantiate the architecture's capacity to project the stability of the smart grid in operational time with a marginal false-alarm rate bordering zero and no undetected stability violations.},
  keywords={Stochastic processes;Spiking neural networks;Power system stability;Probabilistic logic;Feature extraction;Stability analysis;Real-time systems;Smart grids;Forecasting;Thermal stability;Black-Winged Kite Algorithm;Fast Correlation-Based Filter;Multi-View Fuzzy Clustering with Anchor Graph;Probabilistic Spiking Neural Network;Smart grid stability},
  doi={10.1109/ICOIICS67115.2025.11390254},
  ISSN={},
  month={Nov},}@INBOOK{10954240,
  author={Tapscott, Bob},
  booktitle={Trivergence: Accelerating Innovation with AI, Blockchain, and the Internet of Things}, 
  title={Introduction to the Era of Trivergence}, 
  year={2024},
  volume={},
  number={},
  pages={1-16},
  abstract={Summary <p>This book discusses the three technologies: artificial intelligence (AI), the blockchain, and the Internet of Things (IoT), that will define the next era of technology innovation, disruption, and transformation, and what impacts they will have on work, leisure, transportation, education, and other aspects of our daily lives. It explores how industries such as healthcare, transportation, finance, and education stand on the precipice of radical transformation, propelled by the inventive solutions and immense possibilities brought forth by AI. The book takes us to the IoT&#x2014;a world where the physical and digital realms merge. It explores how blockchain has evolved from its origins in cryptocurrency to transform industries and redefine how we interact with information and create value. It guides us through the transformative realm of cloud computing&#x2014;a catalyst for innovation, collaboration, and the integration of advanced tools like AI, IoT, and blockchain. This introduction presents an overview of the key concepts discussed in this book.</p>},
  keywords={Artificial intelligence;Urban areas;Blockchains;Medical services;Internet of Things;Technological innovation;Monitoring;Medical diagnostic imaging;Industries;Information age},
  doi={},
  ISSN={},
  publisher={Wiley},
  isbn={9781394226634},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10954240},}@INPROCEEDINGS{10677226,
  author={Telang, Suhit and Basavaraju, K.S and N, Sravya and Lal, Shyam},
  booktitle={2024 IEEE International Conference on Electronics, Computing and Communication Technologies (CONECCT)}, 
  title={An Effective Deep Learning Model for Pan-Sharpening of Satellite Images}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Image fusion techniques are widely used to enhance images by combining two or more remote sensing images. The fusion task of "pan-sharpening" is to merge low resolution Multispectral (MS) and High resolution Panchromatic (PAN) satellite images of the same scene obtained by the same satellite. This paper presents proposed an effective deep learning model leveraging a combination of novel techniques for feature enhancement and aggregation. The proposed model named as Efficient Non-local Feature Enhancement Network (ENFE-Net) integrates the PAN guided band-aware feature enhancement module with an Efficient Non-local Attention (ENLA) mechanism and Spectral Aggregation Module (SpecAM). The PAN guided band-aware feature enhancement module facilitates effective feature extraction, leverages PAN features to conduct band-aware multi-spectral feature modulation, selectively enhancing the information of each spectral band. Additionally, the integration of the ENLA mechanism enables the model to capture similar contextual dependencies in the input data efficiently, enhancing its discriminative power. Furthermore, the SpecAM is employed to aggregate spectral information effectively, improving the model’s effectiveness to adjust the spectral information. Performance of proposed ENFE-Net model is evaluated on PAirMax datasets and demonstrate its superior performance compared to existing traditional and recent deep learning methods. Experimental results of proposed ENFE-Net model show significant improvements over existing pan-sharpening methods.},
  keywords={Deep learning;Measurement;Image resolution;Satellites;Computational modeling;Forestry;Benchmark testing;Non-local attention;pan-sharpening;spectral aggregation},
  doi={10.1109/CONECCT62155.2024.10677226},
  ISSN={2766-2101},
  month={July},}@INPROCEEDINGS{10433835,
  author={Chu, Wenhui and Jin, Aobo and Gohel, Hardik A.},
  booktitle={2024 IEEE 3rd International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Simulations and Advancements in MRI-Guided Power-Driven Ferric Tools for Wireless Therapeutic Interventions}, 
  year={2024},
  volume={},
  number={},
  pages={1-10},
  abstract={Designing a robotic system that functions effectively within the specific environment of a Magnetic Resonance Imaging (MRI) scanner requires solving numerous technical issues, such as maintaining the robot’s precision and stability under strong magnetic fields. This research focuses on enhancing MRI’s role in medical imaging, especially in its application to guide intravascular interventions using robot-assisted devices. A newly developed computational system is introduced, designed for seamless integration with the MRI scanner, including a computational unit and user interface. This system processes MR images to delineate the vascular network, establishing virtual paths and boundaries within vessels to prevent procedural damage. Key findings reveal the system’s capability to create tailored magnetic field gradient patterns for device control, considering the vessel’s geometry and safety norms, and adapting to different blood flow characteristics for finer navigation. Additionally, the system’s modeling aspect assesses the safety and feasibility of navigating pre-set vascular paths. Conclusively, this system, based on the Qt framework and C/C++, with specialized software modules, represents a major step forward in merging imaging technology with robotic aid, significantly enhancing precision and safety in intravascular procedures.},
  keywords={Wireless communication;Navigation;Magnetic resonance imaging;User interfaces;Safety;Magnetic fields;Robots;MRI;medical imaging;robot-assisted devices;magnetic field gradient},
  doi={10.1109/ICAIC60265.2024.10433835},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11386151,
  author={Kumar, Shivam and Singh, Prabhdeep and Singh, Amardeep},
  booktitle={2025 2nd International Conference on Intelligent Systems for Cybersecurity (ISCS)}, 
  title={Adaptive and Sustainable Cloud Security for Small and Medium Enterprises}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Most of the global economy consists of small and medium-sized enterprise (SMEs), which are not able to migrate to the cloud due to their lack of concrete cloud-security solutions. This huge disconnection between people and processes is what makes us require a sustainable security framework that will discuss in this review. The current systematic literature review outlines four key themes-Zero Trust Architecture (ZTA), Governance Risk and Compliance (GRC), the merge of artificial intelligence and machine learning (AI/ML), and disaster recovery sustainability. All these identified themes are the foundation of the creation of security frameworks that are flexible to the context of SMEs. The synthesis provided below is based on academic articles and reports that were published between 2023 and 2025, but also includes the background standards, including those issued by NIST and ISO, in order to offer consistent definitions irrespective of the date of publication. By combining these new frameworks, the research sheds some light on the gaps in research that should be filled by other researchers. Finally, the review suggests a research agenda in the future that includes cross-regional comparative studies, integration of qualitative knowledge, and longitudinal studies on the resilience, thus providing organisations with a strategic roadmap to flexible and resilient security architectures.},
  keywords={Disasters;Cloud computing security;Machine learning;NIST;Zero Trust;Sustainable development;Intelligent systems;Standards;Systematic literature review;Resilience;Cloud security;SMEs;Zero Trust;Governance;Risk;and Compliance (GRC);Business Continuity Disaster Recovery (BCDR);Multi-tenant;Multi-cloud;AI/ML;Sustainability},
  doi={10.1109/ISCS69371.2025.11386151},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11156660,
  author={Lalithakumari, S. and Malhotra, Abhiraj and Mahakud, Rina and Pandey, Noopur and R, Manjunatha and Dore, Aruna},
  booktitle={2025 2nd International Conference On Multidisciplinary Research and Innovations in Engineering (MRIE)}, 
  title={Hybrid CNN Optimization for Efficient ECG Signal Classification in IoT-Based Healthcare Monitoring}, 
  year={2025},
  volume={},
  number={},
  pages={189-193},
  abstract={An innovative adaptive optimization method for ECG signal classification, CNN-RFD-PSO, is introduced in this study. The framework overcomes significant flaws in conventional optimized methods, including computing inefficiency, early integration and optimal locality, by merging Convolutional Neural Networks. RFD improves worldwide search efficiency with unpredictable river creation influenced by nature, CNNs are used for efficient collecting features, and PSO enhances efficiency of computation utilizing swarm intelligence. The suggested approach combines RFD and PSO capabilities to enhance neighbourhood optimization and worldwide exploration, rendering it appropriate for tackling intricate and multidimensional issues such as arrhythmia identification. Effortless hyperparameter adjustment, reliable classification, and decreased computing efficiency are the goals of the hybrid method, which should allow for scalable medical apps that make use of the Internet of Things. Superior electrocardiogram (ECG) tracking systems that can accurately detect and track cardiac arrhythmias are based on this architecture. If this strategy proves effective in hospital care and other fields, it might find use in other areas where hybrid optimization tools are necessary to tackle difficult categorization problems. Compared with both CNN-PSO and CNN-RFD, the suggested CNN-RFD-PSO model attains the best overall accuracy of 96.64%.},
  keywords={Arrhythmia;Pattern classification;Electrocardiography;Real-time systems;Rivers;Convolutional neural networks;Internet of Things;Reliability;Artificial intelligence;Particle swarm optimization;ECG;CNN-RFD-PSO;CNN-PSO;CNN-RFD;IoT;SVM},
  doi={10.1109/MRIE66930.2025.11156660},
  ISSN={},
  month={July},}@INPROCEEDINGS{11203747,
  author={Cherif, Anas and Cardenas, Julian and Rahimi, Tohid},
  booktitle={2025 IEEE 13th International Conference on Smart Energy Grid Engineering (SEGE)}, 
  title={Advanced and Optimized Forecasting Techniques for Wind Power Generation: A Comparative Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={263-269},
  abstract={Wind power forecasting and subsequently ramp event detection are vital for maintaining the stability and efficiency of modern power grids that increasingly rely on renewable energy sources. This study presents a new hybrid forecasting framework that combines Long Short-Term Memory (LSTM) networks with Extreme Gradient Boosting (XGBoost) to address the limitations of each model individually. While LSTMs are effective at capturing temporal dependencies, they tend to perform poorly in detecting rapid changes such as ramp events. Conversely, XGBoost provides accurate point predictions but lacks inherent temporal awareness. By merging these models, our framework leverages LSTM’s ability to model time sequences and XGBoost’s strength in predicting sharp transitions. This integration markedly improves short-term forecasting accuracy, especially during dynamic ramp conditions. The framework focuses on short-term forecasting with a 12 -hour horizon using 24 hours of historical and forecasted exogenous data. Tested on a four-year meteorological dataset from Atlantic Canada, our results show that this integrated approach, leveraging the complementary strengths of hybrid deep learning (Dual Transformer-LSTM) and tree-based models (XGBoost), achieve a $30 \%$ relative improvement in deterministic and a $40 \%$ improvement in deterministic accuracy when capturing both general and ramp-specific features of wind power signals compared to the other two methods.},
  keywords={Accuracy;Time series analysis;Wind power generation;Predictive models;Power system stability;Transformers;Stability analysis;Forecasting;Wind forecasting;Long short term memory;Wind power;Time series forecast;Ramp detection;Grid stability},
  doi={10.1109/SEGE65970.2025.11203747},
  ISSN={2575-2693},
  month={Aug},}@INPROCEEDINGS{10578797,
  author={Tobias, Roberto Gomez and Alvarez, Jorge},
  booktitle={2024 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={Engineering Virtue: A Behavioral Approach to Ethical Challenges in Engineering Education}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={This study introduces a transformative educational model that merges behavioral economics and ethics within the engineering ethics curriculum. This integration aims to address the ethical complexities arising from rapid technological advancements. Our primary finding reveals that embedding an ethics curriculum within the broader educational framework significantly boosts ethical decision-making competencies among engineering students. By promoting diversity and inclusivity, the study demonstrates that incorporating varied perspectives leads to improved ethical decision outcomes, essential for the global impact of engineering practices. The research validates the effectiveness of challenge-based learning in instilling ethical competencies and examines the role of e-learning environments in upholding ethical standards. Significantly, the paper re-evaluates assessment methodologies, emphasizing behavioral measures to capture the practical application of ethical principles in realistic scenarios. Ultimately, the paper argues for a shift in engineering education towards active engagement in ethical reasoning, highlighting the complex interplay of psychological influences on behavior. This approach is posited to cultivate a generation of engineers capable of navigating the moral dimensions of their profession with acumen and integrity.},
  keywords={Economics;Training;Ethics;Navigation;Decision making;Psychology;Reflection;Educational Innovation;Higher Education;Behavioral Economics;Behavioral Ethics},
  doi={10.1109/EDUCON60312.2024.10578797},
  ISSN={2165-9567},
  month={May},}@INPROCEEDINGS{10692468,
  author={Li, Weilin and Zhang, Zhongjie and Jiang, Yangming and Wang, Keyu},
  booktitle={2024 6th International Conference on Internet of Things, Automation and Artificial Intelligence (IoTAAI)}, 
  title={Prediction and Degradation Analysis Revolutionizing Electric Vehicle Reducer Prognostics: An Advanced Deep Learning Framework for Accurate RUL Prediction and Degradation Analysis}, 
  year={2024},
  volume={},
  number={},
  pages={58-64},
  abstract={This paper presents an advanced framework for predicting and analyzing the Remaining Useful Life (RUL) of electric vehicle reducers using a novel combination of deep learning techniques tailored for mechanical health monitoring. The proposed methodology leverages the strengths of Convolutional Long Short-Term Memory (Conv-LSTM) networks, which uniquely merge spatial understanding with temporal dependency modeling to accurately forecast the degradation process of electric vehicle reducers over time. This integration ensures that both the spatial patterns captured from sensor data and the sequential information essential for time-series analysis are comprehensively addressed. A key innovation is the incorporation of the Convolutional Block Attention Module (CBAM) into the model architecture. CBAM facilitates selective attention to significant features at multiple levels, enhancing the network's ability to discern critical wear patterns from less pertinent data. This multi-level feature extraction capability significantly boosts the model's interpretability and predictive power in identifying precursors to reducer failure. Furthermore, the implementation of dilated convolutions enriches the model's feature receptive field without escalating computational demands. By strategically increasing the spacing between kernel elements, the network gains a broader perspective of the input data, allowing it to detect global patterns indicative of impending failure without sacrificing resolution. This paper represent a significant advancement in the predictive maintenance of mechanical systems, particularly in handling complex, high-dimensional sensor data streams. The enhanced accuracy of RUL estimations, coupled with insights into the mechanisms driving reducer degradation, supports proactive maintenance strategies that aim to minimize operational downtime and reduce maintenance costs. This research underscores the potential of deep learning architectures in revolutionizing maintenance practices for critical machinery, demonstrating their efficacy in real-world applications.},
  keywords={Degradation;Deep learning;Accuracy;Computational modeling;Predictive models;Electric vehicles;Maintenance;Monitoring;Long short term memory;Predictive maintenance;Conv-LSTM;RUL Prediction;CBAM;Dilated Convolutions;Electric Vehicle Reducer},
  doi={10.1109/IoTAAI62601.2024.10692468},
