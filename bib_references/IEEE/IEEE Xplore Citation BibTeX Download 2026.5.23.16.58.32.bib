  author={Maathuis, Clara},
  booktitle={2025 IEEE Space, Aerospace and Defence Conference (SPACE)}, 
  title={Human-AI Teaming in Military Space Operations Model}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Since the space domain becomes increasingly important for modern military operations, real-time data and context driven knowledge need to be accounted in their execution. At the same time, equally important is the integration of intelligent, adaptive, and robust methods and models that merge human expertise and the capabilities of the AI systems in order to accomplish shared goals. On this behalf, a computational ontology is introduced in this research for modelling human-AI teaming in military space operations, by providing a framework to represent and reason about individual agents, the team formed by these agents as a collective agent, and account socio-technical aspects such as autonomy, feedback, trust, relationships, and behaviors. To this end, the Design Science Research methodological approach is taken guided by the Knowledge Representation and Reasoning domain principles to build the proposed model as a contribution that supports the ongoing development of responsible and trustworthy AI solutions aimed at effective and ethical decision-making in the military domain.},
  keywords={Space vehicles;Adaptation models;Analytical models;Adaptive systems;Military computing;Computational modeling;Decision making;Ontologies;Cognition;Artificial intelligence;human-AI teaming;human-autonomy teaming;AI;ontology;military operations;military space},
