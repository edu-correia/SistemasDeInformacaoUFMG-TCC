  title={Public Sentiment Analysis Proposal for Beyond-5G Deployment and Reconstructing Confidence in 6G Wireless Systems with Liquid Crystal Reconfigurability and Ethical AI}, 
  year={2025},
  volume={},
  number={},
  pages={132-137},
  abstract={We pioneer the application of sentiment analysis as a diagnostic framework for evaluating public perceptions of $\mathbf{5 G}$ wireless networks, identifying critical gaps in performance, accessibility, and trust. By systematically analysing discourse trends-spanning health concerns, infrastructural limitations, and economic barriers-we derive actionable insights for $\mathbf{6 G}$ innovation. A key contribution is the integration of liquid crystalbased reconfigurable systems, which enable adaptive, energyefficient hardware for next-generation networks. Furthermore, we advocate for explainable AI to enhance transparency in network decision-making, ensuring ethical compliance and reducing the prevalence of scope creep. Our findings propose a holistic 6 G development paradigm, merging tunable materials, AI-driven optimization, and responsible governance to foster resilient and socially attuned communication ecosystems.},
  keywords={6G mobile communication;Sentiment analysis;Ethics;Technological innovation;Explainable AI;Social networking (online);Wireless networks;Reconfigurable intelligent surfaces;Security;Proposals;5G;6G;Ethical AI;Explainable AI;IoT;Liquid Crystal Systems;Public Sentiment;Reconfigurable Intelligent Surfaces;Sentiment Analysis;Wireless Networks},
  doi={10.1109/SNAMS67467.2025.11391010},
  ISSN={2831-7343},
  month={Nov},}@ARTICLE{11474904,
  author={Shou, Zhenyi and Chai, Nianyao and Yang, Xiao and Li, Lin and Pan, Kewen},
  journal={IEEE Open Journal of Antennas and Propagation}, 
  title={Tri-Mode Hybrid Dielectric Resonator Antenna Fabricated via Laser-Based Selective Material Processing for WLAN Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={In this paper, a novel tri-mode hybrid dielectric resonator antenna (DRA) designed for wireless local area network (WLAN) applications is presented. Through a special DRA design, the antenna profile is compressed to 0.05 λ0. TEy 1+δ11 and TEy 2+δ11 modes of a complex, irregular dielectric resonator are merged to provide the coverage of WLAN 5.2/5.8-GHz bands, while a quarter-wavelength monopole mode of an F-shaped metal strip is excited for the WLAN 2.4-GHz band. Meanwhile, a hybrid fabrication method has been developed including stereolithography (SLA)-based ceramic 3D printing for irregular dielectric resonator fabrication and laser-based selective metal patterning to achieve high-precision integration of metal strip lines (< 20 μm accuracy). Measured and simulated results of reflection coefficients along with radiation patterns show good agreement. 6.87% and 23.16% bandwidth coverage have been achieved for WLAN 2.4-GHz and WLAN 5.2/5.8-GHz bands respectively.},
  keywords={Antennas;Dielectric resonator antennas;Feeds;Antenna radiation patterns;Antennas and propagation;Antenna arrays;Microstrip antenna arrays;Microstrip antennas;Motion pictures;Radio broadcasting;Dielectric resonator antenna (DRA);stereolithography (SLA);3D printing;femtosecond laser ablation;WLAN communications},
  doi={10.1109/OJAP.2026.3680933},
  ISSN={2637-6431},
  month={},}@INPROCEEDINGS{10245921,
  author={Nagpal, Manish},
  booktitle={2023 International Conference on Data Science and Network Security (ICDSNS)}, 
  title={Water Use Analaysis for Irrigation Management using NDLI Measures}, 
  year={2023},
  volume={},
  number={},
  pages={01-08},
  abstract={Agricultural management relies heavily on the early identification and measurement of plant responses to situations such as disease and water scarcity. The dimensionalfree Normalization Divided Moist Heat Index (NDLI) is being used to plant health for the first time in this study. To further examine crop conditions and water restrictions in rice-growing regions, we propose merging NDLI using infrared radiation and solar energy balance components. There is a strong association (r = 0.82) between the residual of the frequently employed Surface Radiation Balance Algorithm for Field model and crop evapotranspiration calculated through the integration of NDLI and land surface temperature. Significant relationships with the canopy plant biophysical variables generally described and anticipated by the a multispectral sensor indices were also found, suggesting that the ET method provides accurate information on the state of paddy fields. Optimization of the Soil-Adapted Vegetation Index (OSAVI) had a correlation coefficient of 0.84 with SEB-derived ET; NDVI and NDWI both had correlation values of 0.55; and NDVI had a correlation coefficient of 0.84 with NDLI. In most cases, the percentage of information that is different between NDLI- and SEB-derived ET and SEBAL-determined ET for the agricultural areas at issue is less than 10%. Disease-infected sections of paddy fields show unusually low ET signatures in NDLI and SEB derived ET maps, but not in SEBAL derived ET maps. This research shows promise for NDLI as an indication of crop health and stress from water for more efficient food supply management.},
  keywords={Correlation coefficient;Temperature sensors;Irrigation;Plants (biology);Crops;Land surface;Vegetation mapping;Irrigation Management;Water Use Efficiency;Water Sustainability;Drought;Soil Moisture;Plant Disease;Soilborne Disease;Plant Pathology;Fungi;Oomycete;Irrigation-Pathogen Interaction Science},
  doi={10.1109/ICDSNS58469.2023.10245921},
  ISSN={},
  month={July},}@INPROCEEDINGS{11448607,
  author={Singh, Sneh and Joshi, Preksha and Shah, Ramya},
  booktitle={2025 2nd International Conference on Recent Trends in Electrical, Electronics and Computing Technologies (ICRTEECT)}, 
  title={A Neuro-Symbolic Multi-Agent Framework for Adaptive Threat Detection in Financial Cyber-Physical Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The financial services sector finds itself at a crucial juncture where rapid digital transformation has drastically altered both operational processes and security vulnerabilities. The merging of conventional banking infrastructure with cloud-based fintech solutions, algorithmic trading platforms, and interconnected cyber-physical systems has resulted in exceptional efficiency gains, while simultaneously expanding the threat landscape in ways that typical security protocols struggle to address. This research gap has inspired the development of AIM-XDR, an advanced neuro-symbolic Extended Detection and Response (XDR) framework tailored specifically for the integrated financial-cyber landscape. This strategy satisfies the essential need for a thorough, adaptable, and transparent defense mechanism against hybrid threats through the integration of advanced multi-agent AI techniques, strong explainability frameworks, comprehensive data governance, ongoing feedback loops, and sophisticated threat modeling capabilities. The aim of this framework is to bridge the significant gaps in the cybersecurity strategies of financial institutions, targeting the disconnect between academic progress and real-world application. This paper outlines a case study of a banking organization with a vast customer network and high transaction activity that encounters various cyber threats, such as AI-driven fraud, lateral movement, polymorphic malware, and synthetic identity fraud. The findings reveal considerable, conceptually comparative, and evaluative benchmarking improvements regarding detection precision, resilience, and adherence to regulations within this framework, thereby establishing a solid foundation for the security of financial ecosystems in the future.},
  keywords={Ecosystems;Organizations;Computer architecture;Cyber-physical systems;Benchmark testing;Real-time systems;Malware;Fraud;Engines;Resilience;Artificial Intelligence;Cyber Defense;Financial Organizations;Machine learning},
  doi={10.1109/ICRTEECT67512.2025.11448607},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11240837,
  author={Pu, Yuan and Ji, Yuhao and Yu, Siying and Zhang, Zuodong and Guo, Zizheng and He, Zhuolun and Lin, Yibo and Pan, David and Yu, Bei},
  booktitle={2025 IEEE/ACM International Conference On Computer Aided Design (ICCAD)}, 
  title={GPU Acceleration for Versatile Buffer Insertion}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={With the advancement of circuit design complexity and technology nodes, buffer insertion has become pivotal in mitigating timing violations, significantly impacting the physical design development cycle and highlighting the necessity for acceleration methodologies. In this paper, we present BIGX, a GPU-accelerated algorithmic framework for buffer insertion. BIGX is versatile and can be adapted to implement different dynamic programming (DP) based buffering algorithms for repairing various types of timing violations. In particular, we introduce MCDP, a dedicated DP-based buffering algorithm for repairing maximum capacitance violations, and propose a parallel version of Van Ginneken’s algorithm for setup violations, both algorithms are incorporated and implemented in BIGX. Furthermore, to overcome the runtime limitations of DP-based buffering algorithms, BIGX adopts a distributed Branch Merge algorithm based on bucket sorting, which fully leverages the hierarchical memory architecture of modern GPUs to achieve substantial speedups while preserving solution quality. Experimental results on industrial benchmarks demonstrate that, with the integration of MCDP, BIGX repairs 96.6% of maximum capacitance violations. Compared to OpenROAD, BIGX with MCDP repairs 2.54x more maximum capacitance violations and delivers a 3.37x speedup. Additionally, BIGX accelerates the Van Ginneken’s algorithm by 11.68x while maintaining comparable solution quality to its CPU-based counterpart.},
  keywords={Runtime;Heuristic algorithms;Memory architecture;Graphics processing units;Maintenance engineering;Capacitance;Timing;Dynamic programming;Sorting;Physical design},
  doi={10.1109/ICCAD66269.2025.11240837},
  ISSN={1558-2434},
  month={Oct},}@INPROCEEDINGS{11390169,
  author={L, Natrayan and Devi, S. Dhivya and Koppisetty, Indumathi and Parikh, Swapnil M and Kaushal, Rajanish Kumar and SivaramKrishnan, M.},
  booktitle={2025 International Conference on Intelligent Computing, Information and Control Systems (ICOIICS)}, 
  title={Efficient Breast Cancer Detection Using a Dilated Convolutional Network with Walk-Spread-Based Optimization}, 
  year={2025},
  volume={},
  number={},
  pages={948-953},
  abstract={Successful breast cancer prognosis hinges upon timely and precise imaging diagnostics. Conventional methodologies, augmented by standard neural networks, frequently falter due to heterogeneous growth patterns across diverse tumor phenotypes and prohibitive energy expenditure required for iterative learning cycles. This study advances a streamlined detection architecture wherein a Dilated Convolutional Network (DCN) is synergistically coupled to Walk-Spread-Based Optimization (WSBO) to foreground pertinent histopathological features while concurrently calibrating learning parameters. Embedded dilated filters sample multiple receptive fields and merge pixelwise indicators with wide-ranging spatial context, thereby preserving pixel-level histological fidelity and subsampling apparent and latent tumor signs at heterogeneous scales. Simultaneously, the WSBO mechanism modulates the encroachment-versus-innovation ratio of search agents toward meta-parameter convergence, thereby avoiding overfitting through adaptive, cycled perturbation and resampling. Rigorous validation against publicly curated, multicentric breast cancer archives yields statistically significant gains in classification efficacy, diminished classification bias over undetected micro-calcifications, and acceleration of the convergence surface. This evidence substantiates the capacity of the composite DCN-WSBO pipeline to furnish clinicians with robust, computationally economical breast cancer stratification manifestly suited for integration within hospital-grade imaging and episodic, edge-based diagnostic modalities.},
  keywords={Accuracy;Adaptive systems;Pipelines;Imaging;Feature extraction;Breast cancer;Convolutional neural networks;Optimization;Tumors;Convergence;Adaptive Bilateral Texture Filtering;Anatomy-Aware Hover-Transformer;Breast cancer detection;Dilated Convolutional Network;Walk-Spread Algorithm},
  doi={10.1109/ICOIICS67115.2025.11390169},
  ISSN={},
  month={Nov},}@ARTICLE{11218045,
  author={Choi, Jin-Young and Ma, Jun-Seok and Kim, Wook-Sung},
  journal={IEEE Access}, 
  title={Tunable High-Selectivity Wideband Bandpass Filter Using Triple-Mode Stub-Loaded Resonators Based on Liquid Crystals}, 
  year={2025},
  volume={13},
  number={},
  pages={186090-186102},
  abstract={This paper presents the design and realization of a tunable wideband triple-mode bandpass filter (BPF) with two transmission zeros (TZs) using liquid crystal (LC). The proposed filter employs a capacitively coupled open-ended stub-loaded resonator (SLR) to realize the extinct resonant characteristics. In addition, a high-impedance line loaded with a radial stub is introduced to preserve the resonant characteristics and to enable the operation of the LC director under bias voltage, despite the use of open-ended SLRs at both ends simultaneously. Through simulations with respect to the stub length and the dielectric constant of the LC, the proposed filter demonstrates advantages in bandwidth design flexibility and stable frequency-agile tunable response without pole merging or pole isolation. Experimental results show that the center frequency can be tuned from 10.61 GHz to 9.48 GHz with a maximum bias voltage of 30 V, while maintaining a triple-mode response with two TZs. Regardless of the applied voltage, the normalized 3-dB fractional bandwidth remains between 29.11 % and 29.55 %, the peak attenuation level exceeds 24 dB, and the shape factor is less than 1.48, which is the lowest reported value among LC-based BPFs. With its wideband and highly selective response, substantial frequency tuning capability, saturation achieved at moderate bias levels (10–12 V), and consistently low passband insertion loss, the proposed filter demonstrates practical advantages and makes a notable contribution to the integration of reconfigurable RF front-end platforms such as cognitive radio and radar systems.},
  keywords={Resonators;Microwave filters;Band-pass filters;Dielectrics;Resonator filters;Transmission line matrix methods;Attenuation;Wideband;Tuning;Resonant frequency;Wideband bandpass filter;tunable;liquid crystal;stub-loaded resonator;high selectivity;triple-mode;microwave filter},
  doi={10.1109/ACCESS.2025.3625633},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11167023,
  author={Kharatmol, Keerti and Mhatre, Piyush and Khairnar, Sakshi and Bhosle, Sanjana},
  booktitle={2025 5th International Conference on Intelligent Technologies (CONIT)}, 
  title={AI – Driven Finance Advisor for Personalized Investment Strategies}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The “AI-Driven Financial Advisor for Personalized Investment Strategies” is an initiative aimed at revolutionizing financial decision-making process and investment strategies. Advanced Machine learning systems are employed to deliver financial guidance to the person. The system provides financial advices based on user inputs, by leveraging artificial intelligence and machine learning. It takes inputs such as financial goals, time period, risk tolerance and amount needed to invest. The major functionalities include investment recommendation, risk analysis, market news, financial education and chatbot for further assistance and support. This platform features stock visualizer, a news market sentiment analyzer, and a financial planning tool, with personalized tailored requirements this all helps make comprehensive financial decision. The integration of real-time data is accessed from APIs, these are processed using libraries in python such as Pandas and Plotly, which helps in visualizing accurate data insights. The information of user merged with Chatbot, which assists user interaction and provides them recommendations enhancing decision-making. It gathers numerous numbers of investment options, promoting confident and decision making. Project presents financial advisor services by providing financial literacy by giving the options to learn from current scenarios and making decision making simpler. Overall, achieving user’s financial goals and objectives empowering them with market trends and financial literacy.},
  keywords={Decision making;Finance;Data visualization;Machine learning;Chatbots;Market research;Real-time systems;Libraries;Risk management;Investment;Financial Planning;Investment Strategies;Machine Learning in Finance;Financial Risk Management},
  doi={10.1109/CONIT65521.2025.11167023},
  ISSN={},
  month={June},}@INPROCEEDINGS{11388032,
  author={Sireesha, Moturi and Siva Rama Krishna Vinay, Yelchuri and Sai Manikanta, Hari Lakshmi and Satyanarayana, Prajapathi},
  booktitle={2025 IEEE 3rd International Symposium on Sustainable Energy, Signal Processing and Cybersecurity}, 
  title={A Meta-Ensemble Deep Learning Approach Using EfficientFormerV2 and Swin Tiny Transformer for Skin Lesion Classification}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Timely recognition of skin cancers improves survival chances, yet automated diagnosis is hindered by subtle lesion similarities and uneven class distributions. This study proposes a dual-stream ensemble that integrates EfficientFormerV2 with the Swin Tiny Transformer for multiclass dermoscopic classification using the HAM10000 dataset. Both networks were pretrained on ImageNet and subsequently fine-tuned; their predictions were merged through two strategies: (1) probability-level fusion via weighted soft voting and (2) a meta-ensemble in which a logistic regression model learns from the concatenated logits of both backbones. Unlike earlier works that rely on a single CNN or transformer, this framework leverages the complementary strengths of a lightweight CNN–transformer hybrid and a hierarchical vision transformer. Experiments show that the Swin Tiny model achieves the highest accuracy (∼90%), whereas the logistic-regression ensemble delivers the best balance across classes (macro F1 = 0.8800) and strong discrimination capability (ROC-AUC = 0.9814), with clear improvements on infrequent lesion types such as AKIEC and DF. We also assess inference cost and model size, highlighting EfficientFormerV2’s suitability for resource-limited deployment. While evaluation is restricted to HAM10000, future work will include cross-dataset studies and integration of clinical metadata. Overall, the proposed approach demonstrates potential as a reliable, scalable decision-support tool in dermatological practice.},
  keywords={Deep learning;Logistic regression;Accuracy;Costs;Metadata;Signal processing;Transformers;Skin;Robustness;Lesions;Skin lesion classification;deep learning;meta-ensemble;EfficientFormerV2;Swin Tiny Transformer;logistic regression;HAM10000;ROC-AUC},
  doi={10.1109/iSSSC66652.2025.11388032},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10775456,
  author={Huang, Yangfan and Ling, Long and Liu, Yaodong},
  booktitle={2024 5th International Conference on Computer Engineering and Intelligent Control (ICCEIC)}, 
  title={Integrating AI into Biology Education: Classifying Edible and Poisonous Mushrooms Using Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={346-352},
  abstract={As artificial intelligence (AI) becomes increasingly prevalent in various domains, its integration into education offers unique opportunities to enhance learning experiences. This paper explores the application of AI, specifically machine learning, in biology education through the classification of edible and poisonous mushrooms. Leveraging a dataset of gilled mushrooms from the Agaricus and Lepiota families, this study demonstrates how AI techniques can be used to classify species based on morphological features such as cap shape, gill attachment, and color. The use of AI not only improves students' understanding of species identification and biological classification but also introduces them to key concepts in data science, such as feature selection, model training, and validation. By implementing machine learning algorithms like decision trees and support vector machines, students can engage in interactive learning experiences that merge biology with modern technological tools. The results show that integrating AI into biology curricula can foster both scientific literacy and computational thinking, offering a more comprehensive and engaging approach to science education. This paper outlines a practical framework for educators to incorporate AI in biology lessons, preparing students for future academic and career challenges in an increasingly digital world.},
  keywords={Support vector machines;Biological system modeling;Computational modeling;Education;Learning (artificial intelligence);Data models;Decision trees;Artificial intelligence;Random forests;Context modeling;Artificial Intelligence;Biology education;Educational Development;Machine Learning},
