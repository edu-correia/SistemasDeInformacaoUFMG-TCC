@INPROCEEDINGS{11502643,
  author={Surya, Yug and K, Suresh and T, Cynthia},
  booktitle={2026 7th International Conference on Computational Intelligence and Networks (CINE)}, 
  title={Intelligent Trading Systems: Integrating Finbert Sentiment Analysis with Deep Reinforcement Learning for Enhanced Stock Market Performance}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Traditional algorithmic trading systems relying solely on technical indicators inadequately capture sentimentdriven market forces that significantly influence stock price movements. This research presents a novel hybrid intelligent trading framework merging FinBERT-powered financial sentiment assessment with deep reinforcement learning techniques for autonomous trading execution. The platform processes realtime financial news streams and social media discourse alongside technical market signals to generate optimal trading actions. Principal contributions encompass: (1) Multi-modal data integration combining technical metrics with sentiment analysis for comprehensive market understanding, (2) Adaptive learning through deep reinforcement learning responding to shifting market conditions, (3) Superior risk mitigation featuring reduced drawdowns and enhanced capital preservation, (4) Real-time sentiment processing enabling rapid response to market-moving news, and (5) Rigorous performance verification via extensive backtesting with realistic market data incorporating transaction costs and microstructure considerations.},
  keywords={Filtering;Filters;Feedback;Circuits;Circuits and systems;Protocols;HTTP;Internet;High frequency;Instant messaging;Algorithmic Trading;Financial Sentiment Analysis;Deep Reinforcement Learning;FinBERT;Multi-Modal Learning;Risk Management;Quantitative Finance},
  doi={10.1109/CINE68769.2026.11502643},
  ISSN={},
  month={March},}@ARTICLE{11421931,
  author={Chao, Peng},
  journal={IEEE Access}, 
  title={Parallel Dual-Path Network for Clarity Restoration of Scanned Posters via Frequency Decomposition}, 
  year={2026},
  volume={14},
  number={},
  pages={36202-36225},
  abstract={Scanned poster materials frequently exhibit blur degradation arising from scanner hardware constraints, document manipulation movements, and optical apparatus imperfections. This research introduces PDPNet, a parallel dual-path network framework designed for clarity recovery in digitized graphic documents, with particular emphasis on poster and print media scenarios. The architecture operates via two autonomous processing channels: a spatial pathway preserving layout organization and textual content integrity, alongside a frequency pathway recovering fine printing details through wavelet-based decomposition mechanisms. An adaptive integration strategy dynamically merges outputs from both channels according to regional content characteristics. Experimental assessments on poster scanning collections demonstrate that our methodology attains PSNR of 31.82 dB (mean over 3 runs) and SSIM of 0.943, constituting statistically significant improvements (p<0.01) of 0.11 dB and 0.015 respectively compared to state-of-the-art approaches. Critically, document-specific evaluations reveal substantial enhancements in text recognition: Character Error Rate reduced to 4.23% (12.8% relative improvement) and Word Error Rate to 10.12% (10.8% relative improvement), directly validating practical usability for document digitization applications. The framework demonstrates superior performance in maintaining text legibility and graphical sharpness within scanned documents while requiring only 5.2M parameters.},
  keywords={Feature extraction;Frequency-domain analysis;Computer architecture;Deblurring;Wavelet transforms;Layout;Encoding;Digitization;Spatial resolution;Degradation;Scanned document restoration;print clarity enhancement;parallel processing;wavelet decomposition;poster deblurring},
  doi={10.1109/ACCESS.2026.3670769},
  ISSN={2169-3536},
  month={},}@INBOOK{11460283,
  author={Tariq, Yuman and Pindoo, Irfan Ahmad},
  booktitle={Biochip Design and Health Informatics Using IoT and SDN}, 
  title={Drug Discovery Using Biochip Technology}, 
  year={2026},
  volume={},
  number={},
  pages={63-85},
  abstract={Summary <p>Traditional drug discovery faces significant challenges, including prolonged timelines, high costs, and high attrition rates due to inefficacy or safety issues. Biochip technology emerges as a transformative solution, leveraging microfabricated devices to enable high&#x2010;throughput biological analyses with minimal reagent use. Key biochip variants&#x2014;DNA microarrays, protein microarrays, lab&#x2010;on&#x2010;a&#x2010;chip (LOC), and organ&#x2010;on&#x2010;a&#x2010;chip (OOC) systems&#x2014;facilitate rapid genomic profiling, protein interaction studies, toxicity assessments, and physiologically relevant drug testing. These technologies enhance target validation, lead optimization, and preclinical toxicity evaluations, while integration with artificial intelligence (AI) accelerates data analysis and predictive modeling for personalized therapies. Despite their potential, challenges persist, including translational gaps between in vitro models and human outcomes, standardization of biochip data, and ethical&#x2010;regulatory hurdles. Future advancements in multiplexed biochips and real&#x2010;time monitoring promise to refine precision medicine and streamline pharmaceutical workflows. By merging traditional methodologies with cutting&#x2010;edge biochip platforms, the pharmaceutical industry can overcome existing inefficiencies, reduce development costs, and deliver safer, more effective therapeutics tailored to individual patient needs.</p>},
  keywords={MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits;System-on-chip;Lab-on-a-chip;Integrated circuits;Internet of Things;Communication systems;Internet;Software defined networking},
  doi={10.1002/9781394360796.ch5},
  ISSN={},
  publisher={IEEE},
  isbn={9781394360789},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/11460283},}@INPROCEEDINGS{11330207,
  author={Agarwal, Trapty and Sridhar, G. and Nagappan, Beemkumar and Patra, Bichitrananda and Baskar, V. Vijaya and Kumar, Ajit},
  booktitle={2025 International Conference on Electrical Engineering and Informatics (ICEEI)}, 
  title={Advancing Augmented Reality in Leisure and Gaming with 5G Technology}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Users' gaming experiences are evolving as a result of the integration of augmented reality (AR) with fifth-generation (5G) wireless networks. This is because highly responsive, immersive, and scalable experiences are now within reach. In this article, we will discuss 5G-based augmented reality gaming. This essay is here to discuss ARG-5G. It is a method that utilizes network slicing, increased bandwidth, and low-latency communication to enhance the performance of augmented reality entertainment apps. In comparison to the typical end-to-end latency of traditional 4G networks, experimental simulations indicate that ARG-5G can achieve a median latency of 11 milliseconds, representing a 71.6% reduction. Typical 4G networks have an average latency that is different from this. There were no hiccups when connecting with numerous individuals or showing at a higher quality, thanks to the 64.3% increase in bandwidth utilization. System stress test results further demonstrate that ARG-5G is robust enough for massively multiplayer online gaming, showing that session stability increases by 52.8% under heavy user loads. An additional benefit of the comparative performance evaluation is the 39.5% improvement in energy efficiency, which lends support to the idea of developing environmentally friendly infrastructures that utilize edge computing. This enhancement is emphasized in the rating. By merging 5G with augmented reality engines, ARG-5G paves the path for the next iteration of gaming and leisure settings. Never before have engagement, scalability, and realism been offered by these ecosystems. This study's findings provide credence to the idea that ARG-5G has the potential to encourage innovation in digital entertainment by bridging the gap between virtual immersion and real-world responsiveness.},
  keywords={Technological innovation;5G mobile communication;Network slicing;Wireless networks;Entertainment industry;Bandwidth;Low latency communication;Augmented reality;Stress;Edge computing;augmented reality (ar);5g networks;immersive gaming;low-latency communication;edge computing;interactive entertainment},
  doi={10.1109/ICEEI68459.2025.11330207},
  ISSN={2155-6830},
  month={Nov},}@INPROCEEDINGS{10821269,
  author={Kreppel, Fabian and Melzer, Christian and Wagner, Janis and Hilder, Janine and Poschinger, Ulrich and Schmidt-Kaler, Ferdinand and Brinkmann, André},
  booktitle={2024 IEEE International Conference on Quantum Computing and Engineering (QCE)}, 
  title={Shuttling Compiler for a Trapped-Ion Quantum Computer Architecture with Junctions}, 
  year={2024},
  volume={01},
  number={},
  pages={1065-1076},
  abstract={Current trapped-ion quantum computer architectures based on segmented traps utilize shuttling operations to establish connectivity between multiple sub-registers within one quantum processing unit. Complex trap architectures, including racetrack loops and junctions, offer prospects for increased scalability and have been successfully built and demonstrated. As hardware capabilities evolve, the need arises for additional automated software layers within the control stack for managing qubit routing. We present the automated generation of shuttling schedules for a branched ID architecture within a shuttling compiler that requires the integration of junctions. This not only provides the means for leveraging future new hardware advances, but also allows guiding the development of future architecture via resource estimation. Testing a wide range of quantum circuits, the junction-enabled shuttling compiler is able to reduce the necessary operations by a factor > 50 for translations and > 20 for separation/merge as compared to a linear architecture.},
  keywords={Schedules;Scalability;Qubit;Computer architecture;Routing;Hardware;Software;Junctions;Quantum circuit;Testing;quantum computing;compiler;ion trap architecture;ion shuttling},
  doi={10.1109/QCE60285.2024.00126},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11442243,
  author={E, Logapriya and R, Surendran and Mohana, M and Navaneethakrishnan, Sundara Rajulu},
  booktitle={2025 International Conference on Innovation and Intelligence for Informatics, Computing, and Technologies (3ICT)}, 
  title={Opposition Learning Integrated Red Panda Optimization for Deep Neural Feature in Menopausal Nutrition Intelligence}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The growing prevalence of menopausal health issues highlights the need for personalized nutrition recommendation systems beyond generalized clinical guidelines. This study proposes an Opposition LearningBased Red Panda Optimization (OL-RPO) framework combined with a deep learning classifier for feature selection and nutrition prediction in menopausal women. Using a dataset of 4910 records covering dietary patterns, symptoms, and health indicators, OL-RPO enhances exploration and exploitation by merging opposition learning with Red Panda Optimization, effectively avoiding premature convergence. Experimental results show that OL-RPO surpasses Genetic Algorithm, Particle Swarm Optimization, Whale Optimization Algorithm, and standard RPO, achieving 98.1% accuracy with higher precision, recall, and F1-score. Additionally, irrelevant features are reduced by 43%, ensuring robust high-dimensional analysis. The study contributions include OL-RPO-based feature selection, integration with deep learning, and clinical validation of nutrition-related factors, demonstrating its value as a decision-support tool for personalized menopausal healthcare.},
  keywords={Deep learning;Accuracy;Medical services;Artificial neural networks;Feature extraction;Whale optimization algorithms;Informatics;Optimization;Convergence;Genetic algorithms;Menopause;Nutrition Recommendation;Feature Selection;Opposition Learning;Red Panda Optimization;Deep Learning;Women's Health},
  doi={10.1109/3ict68299.2025.11442243},
  ISSN={2770-7466},
  month={Nov},}@INPROCEEDINGS{11378268,
  author={Muthulingam, Gurusigaamani Ayyanar and Karthik M, Dinesh and P, Aathi Seshan and Aditya R S, Ganesh and M, Vijaya Nivas},
  booktitle={2025 5th International Conference on Emerging Research in Electronics, Computer Science and Technology (ICERECT)}, 
  title={Design and Implementation of a Trust-Based Peer-to-Peer Lending Platform for Hyperlocal Academic Communities}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The growth of the sharing economy has become a prime area for resource optimization, but a gap exists for safe, trustworthy systems at the hyperlocal level, such as university campuses. The present paper outlines the design and development of CampusLend, a full-stack web application built to enable safe peer-to-peer (P2P) lending and swapping of tangible items. The ultimate mission is to establish a closed-loop, sustainable system that optimizes resource use and reduces wastage for the consumer on a university-wide scale. The system is built on a hybrid cloud infrastructure, merging a MERN stack (MongoDB, Express.js, React, Node.js) for the primary application logic and a Firebase backend-as-a-service (BaaS) for strong authentication, file storage, and in-real-time database operations. One significant achievement of this work is the integration of a dynamic Trust Scoring Algorithm that gives a measurable indicator of the user trustworthiness through a history of transactions and completeness of the profile, consequently reducing associated P2P exchange risks. It has a real-time alert system, implemented using Socket.IO, that ensures immediate communication for item requests, acceptances, and updates on status between borrowers and lenders. The React-based web application also has a clean, responsive, and easy-to-use item listing, browsing, and profile interface, making the whole experience smooth and seamless. The paper outlines the system design, trust model, real-time communication protocol, and general implementation, illustrating a scalable and a safe solution for ensuring a sharing and collaborative ecosystem that is sustainable and workable within a school setting.},
  keywords={Protocols;Heuristic algorithms;Computational modeling;Collaboration;Sharing economy;Real-time systems;Peer-to-peer computing;Security;Resource management;System analysis and design;Peer-to-Peer Lending;Sharing Economy;Trust Model;MERN Stack;Firebase;Real-Time Systems;Web Application;Sustainable Computing},
  doi={10.1109/ICERECT65215.2025.11378268},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11080799,
  author={Selvaraj, Kailasam and Perumal, M. Kubendra and Akash, C.Renga and Kumar, V. Madhan and Sobika, M. and Suruthi, S.},
  booktitle={2025 3rd International Conference on Self Sustainable Artificial Intelligence Systems (ICSSAS)}, 
  title={Safeguarding Heritage: Acoustic Fire Suppression with IoT for Museum Applications}, 
  year={2025},
  volume={},
  number={},
  pages={111-116},
  abstract={Protecting cultural heritage in museums necessitates the use of advanced fire suppression technologies to shield irreplaceable artifacts from damage caused by fire and traditional extinguishing methods. This paper examines the integration of acoustic fire suppression technology with the Internet of Things (IoT) to safeguard historical items in museums. Acoustic fire extinguishers use low-frequency sound waves (30-60 Hz) to disrupt combustion without requiring water, chemicals, or physical contact, ensuring the safety of fragile objects. The suggested IoT-enabled system improves on existing technologies by including real-time fire detection sensors, thermal imaging, and automated control units. These components provide precise targeting and early intervention, while IoT connectivity enables remote monitoring and alarms, allowing for rapid response during emergencies. The strategy is intended to minimize damage to artifacts by concentrating suppression efforts on damaged places. By merging non-invasive acoustic methodologies with IoT-driven automation, our technology provides a sustainable, efficient, and artifact-safe alternative to traditional fire suppression methods. The study emphasizes the unique system's potential to improve fire safety standards in museum settings, saving precious historical relics from both fire and extinguishing-related damage.},
  keywords={Technological innovation;Thermal sensors;Museums;Acoustics;Sensor systems;Real-time systems;Internet of Things;Standards;Remote monitoring;Fire safety;Museum fire safety;acoustic fire suppression;the Internet of Things (IoT);historical item protection;innovation;and case studies},
  doi={10.1109/ICSSAS66150.2025.11080799},
  ISSN={},
  month={June},}@INBOOK{10953563,
  author={Meenakshi and Sharma, Preeti},
  booktitle={Blockchain and Deep Learning for Smart Healthcare}, 
  title={AI&#x2010;Enabled Techniques for Intelligent Transportation System for Smarter Use of the Transport Network for Healthcare Services}, 
  year={2024},
  volume={},
  number={},
  pages={205-233},
  abstract={Summary <p>Although intelligent transportation systems (ITS) and e&#x2010;healthcare are two different fields, they can be integrated to offer a seamless and efficient experience to patients, attendants, relatives, and other relevant individuals. ITS can play a crucial role in supporting healthcare services by optimizing the use of transportation networks for treatment and e&#x2010;healthcare logistic purposes. The combination of ITS and e&#x2010;healthcare can provide patients with better and more efficient healthcare while also improving the overall transport experience. The biggest challenge in this integration is addressing the existing issues of a complex transportation system. Traffic administration organizations worldwide face the challenge of managing road traffic and networks. ITS, being an excellent mix of data and correspondence systems, seems the best solution that could contribute toward an effective and safe logistic environment alongside the long&#x2010;term feasibility of transportation systems. For quicker implementation of ITS, electronic media, hardware, programming tools, and automation are necessary. The support of specific specializations such as civil, electrical, mechanical, and industrial engineering might additionally contribute to ensuring that these technologies prove productive and supportive. The rapid advancement of artificial intelligence (AI) offers immense opportunities for enhancing the effectiveness of various areas and ventures, including the transportation sector. Recently, an advanced computational algorithm that imitates the human brain has been introduced by AI. The information, communications, and control (ICT) technology could also be utilized to make the transportation system more effective, smooth, and safety oriented. These steps will act as the base for the fusion of ITS and e&#x2010;healthcare, which will assist in reducing the medical support response time to routine and critical patients and in further developing public interest in ITS&#x2010;based healthcare support. A detailed perspective of AI&#x2010;based ITS merging with e&#x2010;healthcare is covered in this chapter.</p>},
  keywords={Routing;Routing protocols;Wireless mesh networks;Costs;Wireless sensor networks;Wireless networks;Measurement;Transmitters;Spread spectrum communication;Logic gates},
  doi={10.1002/9781119792406.ch9},
  ISSN={},
  publisher={Wiley},
  isbn={9781119792390},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10953563},}@ARTICLE{11314710,
  author={Huang, Min and Yang, Yunzhao and Sun, Qiuhong},
  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={RSS-Net: A Mamba-Based Network for SAR Image Denoizing}, 
  year={2026},
  volume={19},
  number={},
  pages={3539-3551},
  abstract={Synthetic aperture radar (SAR), with its outstanding features, has developed into a vital technical method for the global detection of maritime and terrestrial targets. However, the unique imaging mechanism intrinsic to SAR inherently produces coherent speckle noise. This noise significantly deteriorates the quality of the image, thereby adversely affecting downstream applications like target recognition and classification. Therefore, research on SAR image denoizing holds significant practical and theoretical value. However, due to the limitations of the local receptive field of channel attention block (CNN), it is difficult for it to capture global spatial features. Although Transformer can achieve global spatial modeling, its quadratic complexity results in a large amount of computational overhead. To tackle these issues, this article introduces RSS-Net, a new denoizing network for SAR images, built on an encoder-decoder architecture. RSS-Net demonstrates significant improvements in SAR image denoizing performance, due to its ability to extract multi-scale feature information. The network incorporates the residue state-space block (RSSB), which fuses Mamba's vision state space module (VSSM) and a CNN-based channel attention block. VSSM leverages 2D-selective scan better acquires spatial information features in SAR images by scanning in four directions. RSSB efficiently merges Mamba's ability to model long-range dependencies and conventional convolution's strengths in extracting local features. This integration effectively alleviates the common detail blurring problem in existing SAR denoizing methods and strengthens the restoration of high-frequency image details. The novel application of the Mamba to SAR image denoizing enables the proposed method to attain both long-range contextual dependency modeling and linear computational cost, thus resolving the balance between global modeling capacity and efficiency in computation, while also pointing to new avenues for future research. Experimental evaluations confirm the superior denoizing efficacy of the proposed algorithm.},
  keywords={Noise reduction;Radar polarimetry;Noise;Speckle;Feature extraction;Computational modeling;Transformers;Computational efficiency;Imaging;Deep learning;Image denoizing;Mamba;synthetic aperture radar (SAR);speckle noise},
  doi={10.1109/JSTARS.2025.3647971},
  ISSN={2151-1535},
  month={},}@INPROCEEDINGS{11466218,
  author={Wang, Yu-Qing and Ren, Zheng-Yi and Ao, Da-Cheng and Yu, Le-Yuan and Jia, Wen-Jie and Xi, Zhen-Hua and Zhang, Hu-Zhong and Zhang, Jiang},
  booktitle={2026 6th International Conference on Neural Networks, Information and Communication Engineering (NNICE)}, 
  title={Autonomous joint multi-factor sensing platform design for lunar space environment}, 
  year={2026},
  volume={},
  number={},
  pages={1358-1364},
  abstract={To address the critical need for collaborative sensing of multiple factors of the lunar space environment, this paper developed and implemented an autonomous joint intelligent sensing platform for multiple factors of the lunar space environment. The platform adopted an integrated technical architecture that seamlessly combined component sensing, whole-machine collaboration, model-driven analysis, and software integration, deeply merging high-performance sensing payloads such as Laser-induced Breakdown Spectroscopy-Raman Spectroscopy-Infrared (LIBS-RS-IR), Confocal Laser Scanning Microscope (CLSM), Time-of-flight mass spectrometry (TOF), and a Dust Analyzer (DCA). Key technologies such as high-precision spatiotemporal alignment of multi-source heterogeneous data and autonomous intelligent collaborative detection and control were emphasized. By constructing an autonomous decision-making algorithm based on deep reinforcement learning, the platform achieved tightly coupled collaborative detection and intelligent scheduling of multiple environmental factors, including lunar surface material composition and morphology, neutral and charged particles, and charged dust. Combining a volatile matter migration dynamics model with multi-source data fusion and inversion technology, the platform possessed the capability for three-dimensional visualization and dynamic simulation of the spatiotemporal distribution of important lunar surface volatiles (i.e. H2, H2O, He, Ar, K, Na etc.). The platform was helpful for effectively monitoring payload health status, performing intelligent fault diagnosis, data fusion analysis, and scientific visualization, providing advanced intelligent sensing and decision support tools for revealing the lunar surface volatile transport mechanism and supporting subsequent lunar exploration and resource development missions.},
  keywords={Payloads;Space technology;Military aircraft;Radio broadcasting;Frequency modulation;Field programmable gate arrays;Pixel;Protocols;Communication systems;Modulation;Lunar surface environment;Multi-factor sensing;Autonomous collaboration;Platform design;Data fusion;Volatile matter migration},
  doi={10.1109/NNICE68970.2026.11466218},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{10602271,
  author={Sofia, A. Sathya and Kalaiselvi, T and Kavi Priya, R S and Krupashini, S},
  booktitle={2024 International Conference on Advances in Computing, Communication and Applied Informatics (ACCAI)}, 
  title={ASP-DSRN: Accurate Seizure Prediction Using Dual Self-Attention Residual Networking Model}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={The abstract outlines a novel system for seizure prediction, featuring the integration of an ASP-DSRN: Accurate seizure prediction using dual self-attention residual networking model for effective seizure prediction. This system utilizes a hybrid approach merging residual network and self-attention mechanisms thus enhancing the precision and efficacy of seizure prediction. Atmost grueling steps in prevailing brain illness involves the prediction of adverse toll in the persisting medical condition, epileptic seizure prediction has attracted expansive attention from numerous experimenters owing to its ability to address this task. Anticipating seizures in epileptic patients holds significant potential to improve patients quality of life across various dimensions, including averting accidents and mitigating the risks associated with epileptic episodes while also helping oneself to be prepared ahead of time. The system illustrates the efficacy of the seizure prediction mechanism and highlights its eventuality as a useful tool in the early prediction of seizures for people with epilepsy by analyzing the EEG (Electroencephalogram) data of the patients. The dual self attention mechanism within RDANet comprises modules that accomplishes the objective of the system. There are two modules involved, a spectrum attention module and a channel attention module. The spectrum attention module competently conflates original and global features, thus comprehending the system’s understanding of the complex frequency patterns present in the EEG signals. Contemporaneously, the other module, channel attention delves into the correlations among various channels in EEG data, whilst the dual self-attention mechanism enhances the model’s ability to discern and cope with intricate patterns. The effective Self attention residual network for seizure prediction system is aimed to achieve a perceptivity of $89.33 \%$, a particularity of $93.02 \%$, an AUC of $91.26 \%$ and a delicacy of $92.07 \%$ on a public CHB-MIT EEG dataset. The efficacy of the system showcased from the performance analysis of CHB-MIT scalp EEG dataset underscores its ability to achieve exceptional sensitivity, specificity, AUC, and precision which are the essential benchmarks for evaluating the reliability of the seizure prediction system. Thus the ASP-DSRN: Accurate seizure prediction using dual self-attention residual networking model for Seizure Prediction system showcases a strong competitive edge and resilient performance, obviating the necessity for specific patient-tailored engineering while maintaining the ethical integrity of system’s performance. The system exhibits great promise in substantially improving the functioning and quality of life for people living with epilepsy whilst playing a pivotal role in pushing forward the boundaries of seizure prediction mechanisms.},
  keywords={Accuracy;Sensitivity;Scalp;Epilepsy;Predictive models;Brain modeling;Electroencephalography;Self attention mechanism;Machine learning;Residual network},
  doi={10.1109/ACCAI61061.2024.10602271},
  ISSN={},
  month={May},}@INPROCEEDINGS{11310417,
  author={Bandara, Eranga and Bouk, Safdar H. and Mukkamala, Ravi and Rahman, Abdul and Liang, Xueping and Gore, Ross and Shetty, Sachin},
  booktitle={MILCOM 2025 - 2025 IEEE Military Communications Conference (MILCOM)}, 
  title={Slice-MCP — Fine-Tuned Llama-4 LLM and MCP Enabled 5G Network Slice Orchestration Platform}, 
  year={2025},
  volume={},
  number={},
  pages={1506-1511},
  abstract={5G network slicing presents a transformative approach to deliver customizable, isolated virtual networks over shared infrastructure, tailored to meet diverse application requirements such as ultra-low latency, high reliability, or massive connectivity. However, orchestrating these network slices dynamically and efficiently remains a complex challenge due to the need for precise configuration, real-time responsiveness, and seamless coordination across heterogeneous domains (radio access network, core, and transport). In this paper, we present Slice-MCP, a novel 5G network slice orchestration platform that integrates the Model Context Protocol (MCP) with a fine-tuned Meta’s Llama-4 large language model (LLM) to simplify and automate the slice orchestration process. Slice-MCP allows users to invoke natural language queries which are interpreted by the fine-tuned LLM and mapped to the corresponding MCP functions to configure and deploy the appropriate network slices. To ensure accurate intent recognition and robust function mapping, the LLM was fine-tuned on a custom dataset comprising real-world user intents paired with their corresponding MCP server operations. The integration of MCP provides a standardized interface for dynamic context management, enabling a consistent and extensible way to translate high-level user goals into orchestrator-level instructions across network domains. To the best of our knowledge, this is the first work to apply the MCP for 5G network slice orchestration, merging AI-driven natural language interaction with telecom-grade infrastructure management. The effectiveness of the Slice-MCP is demonstrated through a real-world test-bed deployment in a sliced network scenario, utilizing multiple 5G cores (i.e., Open5GS) across Ericsson’s new RAN. Our results demonstrate that Slice-MCP significantly reduces the operational complexity of 5G slice management while enhancing responsiveness, scalability, and user accessibility.},
  keywords={Military communication;Translation;Protocols;5G mobile communication;Scalability;Network slicing;Real-time systems;Telecommunication network reliability;Servers;Radio access networks;5G;6G;Generative-AI;LLM;MCP;Llama-4},
  doi={10.1109/MILCOM64451.2025.11310417},
  ISSN={2155-7586},
  month={Oct},}@INPROCEEDINGS{11232188,
  author={Firdaus, Idam and Nurfaizi, Muhammad Muflih and Perwita, Ade Yoan and Alfisyah, Muhammad Naim and Tobing, Victor Lumban and Muhajir},
  booktitle={2025 International Conference on Technology and Policy in Energy and Electric Power (ICT-PEP)}, 
  title={Bekasi Digital Substation: An Overview of Indonesia’s Largest Digital Substation}, 
  year={2025},
  volume={},
  number={},
  pages={131-136},
  abstract={Enabled by IEC 61850 and advances in fiber-optic communication, Substation Automation now offers cost-effective and interoperable solutions for modern power systems. This paper presents a case study of the Bekasi Digital Substation (GID Bekasi), the largest in Indonesia with a 27-bay configuration. The project demonstrates the integration of conventional primary equipment with digital technology through Merging Units (MUs). The transition from a conventional to a digital substation has yielded measurable improvements in operational efficiency and maintenance safety. In particular, test preparation time per bay was reduced from approximately 60 minutes to 15 minutes (~75%), while panel counts decreased by more than 50%. Several technical lessons also emerged: the importance of validating digital signals post-migration to prevent misconfigurations, the risks associated with generic logical nodes, and challenges linked to incomplete SCD files. To address these issues, a validation framework aligned with IEC 61850-8-1 is proposed, ensuring consistent testing and configuration practices. Scalability considerations—including VLAN design, network bandwidth, and IED counts—are also outlined to enable replication in future projects.},
  keywords={Wiring;Substations;Substation automation;Scalability;Reliability engineering;Maintenance;Safety;Planning;IEC Standards;Testing;digital substation;IEC 61850;maintenance},
  doi={10.1109/ICT-PEP67281.2025.11232188},
  ISSN={},
  month={Sep.},}@INBOOK{9430818,
  author={Berry, John},
  booktitle={The Digital Transformation of Logistics: Demystifying Impacts of the Fourth Industrial Revolution}, 
  title={Logistics in the Cloud&#x2010;Powered Workplace}, 
  year={2021},
  volume={},
  number={},
  pages={129-146},
  abstract={Cloud technologies such as Software as a Service (SaaS) are fundamentally changing the way logistics organizations operate. The SaaS model overcomes many challenges faced by conventional logistics software like Warehouse Management Systems (WMS) and Transportation Management Systems (TMS). By offering improved user experiences, application programmer interfaces (API), and sophisticated analytics capabilities, SaaS products are helping organizations automate operations and optimize supply chains. However, leveraging these cloud tools requires a new type of talent. Modern workers in the supply chain field need logistics domain knowledge, expertise with key SaaS applications, proficiency in data integration, and the analytic skills necessary to leverage data for improved business results. In the cloud&#x2010;powered workplace, business value will be created in new ways by a new class of worker that merges logistics expertise with functions traditionally handled by the IT department.},
  keywords={Cloud computing;Software as a service;Software;Logistics;Business;Servers;Organizations},
  doi={10.1002/9781119646495.ch9},
  ISSN={},
  publisher={IEEE},
  isbn={9781119646457},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/9430818},}@INPROCEEDINGS{10569469,
  author={Vejin, Marija and Đoćoš, Miroslav and Bučko, Sandra and Katona, Jaroslav and Kojić, Sanja and Stojanović, Goran},
  booktitle={2024 47th MIPRO ICT and Electronics Convention (MIPRO)}, 
  title={Fabrication and Characterization of a Resistor Made of Carbon Film}, 
  year={2024},
  volume={},
  number={},
  pages={2115-2120},
  abstract={Evolution of edible electronics has paved the way for groundbreaking advancements in the realm of electronics, fostering innovations that merge sustainability with functionality. As the field of edible electronics continues to flourish, the integration of biocompatible materials and ingestible designs opens doors to applications in healthcare and beyond. Development of edible LRC (inductance, resistance, capacitance) components further extends this vision, and brings us closer to a more sustainable world with green and renewable electronics that are not harmful to the human body. The research focuses on the fabrication of films incorporating activated carbon aimed to innovate edible electronics. The films were prepared using a blend composed of activated carbon, propylene glycol, and zein. These films, created by combining these materials, are the basis for the production of edible electronic components. The fabrication involved the design of the resistor, its fabrication and comprehensive characterization. Through precise fabrication techniques, these films were tailored to meet the unique requirements of ingestible electronics, showcasing the potential for customizable and biodegradable electronic elements. The findings reveal the viability of edible resistors, offering a promising pathway for sustainable and biodegradable electronic applications, effectively linking technology with environmental sustainability in the electronics domain.},
  keywords={Fabrication;Resistors;Electric potential;Technological innovation;Films;Green products;Production;component;formatting;edible electronics;carbon film;resistor},
  doi={10.1109/MIPRO60963.2024.10569469},
  ISSN={2623-8764},
  month={May},}@INPROCEEDINGS{10719749,
  author={Abadi, Mohammad Hossein Bamorovat and Alashti, Mohammadreza Shahabian and Holthaus, Patrick and Menon, Catherine and Amirabdollahian, Farshid},
  booktitle={2024 10th IEEE RAS/EMBS International Conference for Biomedical Robotics and Biomechatronics (BioRob)}, 
  title={Robotic Vision and Multi-View Synergy: Action and Activity Recognition in Assisted Living Scenarios}, 
  year={2024},
  volume={},
  number={},
  pages={789-794},
  abstract={The significance of Human-Robot Interaction (HRI) is increasingly evident when integrating robotics within human-centric settings. A crucial component of effective HRI is Human Activity Recognition (HAR), which is instrumental in enabling robots to respond aptly in human presence, especially within Ambient Assisted Living (AAL) environments. Since robots are generally mobile and their visual perception is often compromised by motion and noise, this paper evaluates methods by merging the robot's mobile perspective with a static viewpoint utilising multi-view deep learning models. We introduce a dual-stream Convolutional 3D (C3D) model to improve vision-based HAR accuracy for robotic applications. Utilising the Robot House Multiview (RHM) dataset, which encompasses a robotic perspective along with three static views (Front, Back, Top), we examine the efficacy of our model and conduct comparisons with the dual-stream ConvNet and Slow-Fast models. The primary objective of this study is to enhance the accuracy of robot viewpoints by integrating them with static views using dual-stream models. The metrics for evaluation include Top-1 and Top-5 accuracy. Our findings reveal that the integration of static views with robotic perspectives significantly boosts HAR accuracy in both Top-1 and Top-5 metrics across all models tested. Moreover, the proposed dual-stream C3D model demonstrates superior performance compared to the other contemporary models in our evaluations.},
  keywords={Measurement;Solid modeling;Accuracy;Ambient assisted living;Three-dimensional displays;Biological system modeling;Human-robot interaction;Human activity recognition;Robots;Visual perception},
  doi={10.1109/BioRob60516.2024.10719749},
  ISSN={2155-1782},
  month={Sep.},}@INPROCEEDINGS{10960048,
  author={Nimma, Divya and Khan, Shamim Ahmad and Chhabra, Gunjan and Parida, Prasanta and Kiran, Ajmeera and Bala, B Kiran},
  booktitle={2024 IEEE 2nd International Conference on Innovations in High Speed Communication and Signal Processing (IHCSP)}, 
  title={Predictive Resilience Framework for Energy Management Systems in Next-Generation Smart Grids Using a Hybrid LSTM-ARIMA Model}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The Predictive Resilience Framework for Energy Management Systems in Next-Generation Smart Grids integrates advanced forecasting and modeling techniques to enhance grid stability and efficiency. This framework uses Long Short Term Memory (LSTM) network with AutoRegressive Integrated Moving Average (ARIMA) models as the backbone to make the accurate predictions and understanding the dynamics of the energy system. The use of ARIMA befits a number of time series forecasting requirements, which consists of identifying patterns based on past data, and mitigating non-stationary beliefs as load forecasting, renewable integration, fault identification, and demand response. On the other hand, LSTM networks are effective at modelling the long-term dependencies in the sequences hence enhancing the way the model produces future state from previous sequences. The hybrid LSTM-ARIMA approach merges the strengths of both models: ARIMA gives a stable framework on which to build the prediction and LSTM gives an improvement on these predictions due to its ability to deal with complex patterns and temporal attributes. This combination also helps fundamental predictive resilience by allowing for prevision of both energy demand and renewable production, standout of system abnormalities, and direction of peak loads and response programmes. Furthermore, the framework helps in analysing the ability of the grid to operate under various stress conditions such as weather conditions and cyber attacks. By including such superior modelling approaches the framework has been designed to enhance the utility of the grid, balance the energy provision and strengthen the general resource of the system to new threats and instability within the future and more complex smart grid systems.},
  keywords={Fault diagnosis;Renewable energy sources;Predictive models;Smart grids;Forecasting;Energy management systems;Long short term memory;Next generation networking;Load modeling;Resilience;Predictive Resilience;Hybrid Model;Long Short-Term Memory (LSTM);AutoRegressive Integrated Moving Average (ARIMA);Smart Grids},
  doi={10.1109/IHCSP63227.2024.10960048},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10607469,
  author={Jalali, Seyed Mohammad Jafar and Fahiman, Fateme and Khodayar, Mahdi},
  booktitle={2024 16th International Conference on Electronics, Computers and Artificial Intelligence (ECAI)}, 
  title={RLIDT: A Novel Reinforcement Learning-Infused Deep Transformer Model for Multivariate Electricity Load Forecasting}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Electricity load forecasting plays a crucial role in the management of electricity power grids, enhancing operational efficiency, ensuring network reliability, facilitating infrastructure planning, and promoting energy sustainability As the complexity of energy consumption patterns increases traditional forecasting techniques struggle to accommodate the intricate and nonlinear temporal dynamics characteristics present within the data. This paper introduces a novel hybrid model called RLIDT that merges reinforcement learning (RL) with the deep transformer architecture to address the complicated challenges associated with load forecasting effectively. The integration of RL for hyperparameter optimization within the transformer framework not only utilizes their respective advantages but also provides a dynamic, adaptive model that exhibits versatility, robustness, and enhanced predictive accuracy through continuous learning. The experimental investigations conducted on real-world datasets have clearly demonstrated the remarkable advantage of the proposed RLIDT model when compared to traditional methods.},
  keywords={Adaptation models;Load forecasting;Electricity;Computational modeling;Power system dynamics;Predictive models;Transformers;Electricity load forecasting;Deep Transformer Neural Network;Reinforcement learning;Time series forecasting;Hyperparameter tuning},
  doi={10.1109/ECAI61503.2024.10607469},
  ISSN={},
  month={June},}@INPROCEEDINGS{11375969,
  author={Ahamed, B Shamreen and Virdee, Bal and Khanna, Ashish and Vidhya, R G and Sivashankar, S},
  booktitle={2025 International Conference on NexGen Networks and Cybernetics (IC2NC)}, 
  title={Noise-Resistant Deep Ensemble Learning with Optimization-Driven Feature Fusion for Heart Disease Diagnosis}, 
  year={2025},
  volume={},
  number={},
  pages={550-555},
  abstract={Heart disease is still one of the major causes of mortality across the globe, and its forecast in patients with diabetes is an onerous job owing to the intricate integration of clinical, lifestyle, and multi-source health data. Conventional Machine Learning (ML) and shallow Deep Learning (DL) models become ineffective while dealing with noisy, imbalanced, and heterogeneous datasets, which compromises their accuracy and generalizability. To overcome these difficulties, this research proposes a new Pufferfish Optimized Multi-Sensor Information Fusion Deep Ensemble Learning Network (PO-MIFDELN) for the strength and precise prediction of heart disease. The MIFDELN model integrates multi-source data by weighted fusion, convolution-pooling and attention modules for richer feature learning, and a temporal learning module to learn spatial-temporal dependencies. Ensemble stacking is utilized to merge multiple base learners, and an SVM is utilized as the meta-learner. The hyperparameters are tuned by utilizing the Pufferfish Optimization Algorithm (POA) for the optimal model performance. Experimental outcomes validate the model’s enhanced performance with accuracy of 0.980, precision of 0.970, recall of 0.990, and F1-score of 0.950 on Dataset 1; and accuracy of 0.990, precision of 0.980, recall of 0.970, and F1score of 0.980 on the Cleveland dataset. On the same values of hyperparameters (learning rate $=0.001$, batch size $=32$, dropout rate $=0.2$), the model showed good convergencetraining in 120 seconds and testing in 8 seconds for Dataset 1, and 65 seconds and 5 seconds respectively for the Cleveland dataset. In summary, PO-MIFDELN offers a noise-tolerant, computationally low-cost, and very reliable system for heart disease prediction among diabetics, greatly improving diagnostic reliability and accuracy over traditional approaches.},
  keywords={Heart;Deep learning;Accuracy;Computational modeling;Prediction algorithms;Diabetes;Reliability;Ensemble learning;Optimization;Diseases;Ensemble Learning;Preprocessing;Golden Jackal Optimization Algorithm;Heart disease prediction;Pufferfish Optimization Algorithm},
  doi={10.1109/IC2NC67409.2025.11375969},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10943565,
  author={Kim, Donggeun and Jo, Yujin and Lee, Myungjoo and Kim, Taesup},
  booktitle={2025 IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)}, 
  title={Retaining and Enhancing Pre-trained Knowledge in Vision-Language Models with Prompt Ensembling}, 
  year={2025},
  volume={},
  number={},
  pages={5550-5559},
  abstract={The advancement of vision-language models, particularly the Contrastive Language-Image Pre-training (CLIP) model, has revolutionized the field of machine learning by enabling robust zero-shot learning capabilities. These capabilities allow models to understand and respond to previously unseen data without task-specific training. However, adapting CLIP to integrate specialized knowledge from various domains while retaining its zero-shot capabilities remains a significant challenge. To address this, we introduce a novel prompt ensemble learning approach called Group-wise Prompt Ensemble (GPE). This method aims to enhance CLIP's zero-shot capabilities by incorporating new domain knowledge while improving its adaptability and robustness against data distribution shifts. Our approach hinges on three main strategies: prompt grouping with masked attention to optimize CLIP's adaptability while safeguarding its zero-shot capabilities; the incorporation of auxiliary prompts for the seamless integration of new domain insights without disrupting the original model's representation; and an ensemble learning strategy that effectively merges original and new knowledge. Through rigorous experimentation, including more challenging cross-dataset transfer evaluations, our GPE method redefines the benchmarks for the adaptability and efficiency of vision-language models, surpassing existing models across various scenarios.},
  keywords={Training;Adaptation models;Computer vision;Computational modeling;Zero shot learning;Fasteners;Benchmark testing;Robustness;Data models;Ensemble learning},
  doi={10.1109/WACV61041.2025.00542},
  ISSN={2642-9381},
  month={Feb},}@INPROCEEDINGS{11291199,
  author={Laverty, David and Rawn, Barry and Aguto, Ateny and Kwizera, Jasper and Iradakunda, Dieudonne and Agon, Rock},
  booktitle={2025 35th Irish Signals and Systems Conference (ISSC)}, 
  title={OpenPMU: Open Source Measurement Workflow Supporting Power System Measurement in Rwanda}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents the design, implementation, and real-world application of OpenPMU, an open-source, modular platform for power system measurement. OpenPMU supports both conventional synchrophasor estimation and continuous recording of Time-Synchronised Sampled Values (TSSVs), offering functionality comparable to that of a Merging Unit. The system is designed for flexibility, supporting a wide range of hardware—from low-cost, homebrew solutions to professional-grade equipment—and facilitating plug-and-play integration of additional measurement or logging modules. Communication between modules is achieved using MQTT for transport and JSON or XML data formats, enabling robust, connectionless operation and parallel execution of diverse estimation algorithms.In partnership with the Kigali Collaborative Research Centre (KCRC) and with the support of Rwanda Energy Group (REG), OpenPMU is being deployed in the Rwandan grid to support fault analysis, protection diagnostics, and monitoring of grid stability, particularly in the context of increasing regional interconnections. This paper outlines the system architecture, deployment experience, and practical insights gained from applying open measurement systems in a developing power system context. The work demonstrates the potential of open-source measurement tools to improve observability, enhance situational awareness, and support innovation in grid operations.},
  keywords={Technological innovation;Power system measurements;Power measurement;Estimation;Collaboration;Power system stability;Phasor measurement units;Protection;Observability;Monitoring;IEC 61850-9-2;Time Synchronised Sampled Values;Middleware;Rust;Python},
  doi={10.1109/ISSC67739.2025.11291199},
  ISSN={2688-1454},
  month={June},}@ARTICLE{10781314,
  author={Peixoto, João and Martins, José and Cerdeira, David and Pinto, Sandro},
  journal={IEEE Access}, 
  title={BiRtIO: VirtIO for Real-Time Network Interface Sharing on the Bao Hypervisor}, 
  year={2024},
  volume={12},
  number={},
  pages={185434-185447},
  abstract={The push to reduce size, weight, power, and cost (SWaP-C) has led to the integration of multiple subsystems with different criticality levels onto a single hardware platform. Virtualization has played a crucial role in merging real-time capabilities with complex environments, facilitating the creation of Mixed-Criticality Systems (MCS). However, consolidating various workloads on a single platform often requires shared peripheral access, such as Network Interface Controllers (NICs), among guest Virtual Machines (VMs). VirtIO provides a standardized interface for device para-virtualization, enabling us to deploy device drivers and sharing logic within dedicated VMs. Despite its advantages, VirtIO can introduce latency and reduced throughput due to its reliance on the hypervisor or other VMs for network access, which may exacerbate resource contention and affect time isolation between VMs. Time-Sensitive Networking (TSN) techniques can mitigate these issues by ensuring reliable, low-latency, and deterministic network communication, although its implementation often depends on proprietary Linux-based solutions. In this paper, we present BiRtIO, an infrastructure designed to support a virtual real-time network for VMs on the Bao hypervisor without compromising safety and security. It leverages the VirtIO standard and incorporates TSN mechanisms available in mainline Linux, such as bandwidth limitation, to enhance performance and predictability in a saturated virtualized network. Experiments conducted on the Xilinx ZCU102 high-performance multicore platform demonstrate that our solution achieves performance and predictability levels suitable for real-time workloads on MCS with limited Ethernet ports.},
  keywords={Virtual machine monitors;Real-time systems;Standards;Linux;Security;Network interfaces;Performance evaluation;Safety;Protocols;Limiting;Mixed-criticality systems;real-time;security;time-sensitive networks;VirtIO;virtualization},
  doi={10.1109/ACCESS.2024.3512777},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11338258,
  author={Sutichavengkul, Chutchatut and Goldin, Sally E.},
  booktitle={2025 17th International Conference on Information Technology and Electrical Engineering (ICITEE)}, 
  title={Multi-Dimensional Road Extraction from Medium Resolution Imagery using U-Net and YOLO Concepts}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Digital geographic databases support vital applications such as navigation, disaster response and urban planning. Accurate road network information is especially important for many of these uses. Recognizing that remotely sensed data offer broad geographic coverage and temporal currency, recent research has successfully applied deep learning (DL) techniques to extract roads from satellite imagery. However, almost all these studies have used high resolution images which are expensive to acquire and to process. Furthermore, these DL models produce segmentation maps that indicate only the presence or absence of a road in each output pixel. We introduce a novel methodology which uses more economical medium resolution satellite imagery and produces a rich, multi-dimensional result. Our approach integrates a U-Net segmentation backbone with enhancements inspired by single-stage object detection models to produce a multi-channel output comprising a pixel-level probability map, sub-pixel offset coordinates for refined road alignment and orientation angles that capture local directional trends. The framework generates independent vector centerline proposals without merging them into existing maps. While it does not currently perform integration, these proposals can be used as input to downstream workflows, such as manual validation or OSM updates, for more reliable large-scale mapping.},
  keywords={Deep learning;Image segmentation;Accuracy;Databases;Roads;Biological system modeling;Satellite images;Proposals;Data mining;Remote sensing;Remote Sensing;Machine Learning;Deep Learning;Road Extraction;Open Street Map (OSM);Satellite Imagery;Sub-pixel Alignment;U-Net;Sentinel-2},
  doi={10.1109/ICITEE66631.2025.11338258},
  ISSN={2766-0419},
  month={Oct},}@INPROCEEDINGS{10691758,
  author={Deng, Xuhao and Lin, Zekai and Dong, Guangzhong},
  booktitle={2024 IEEE 25th China Conference on System Simulation Technology and its Application (CCSSTA)}, 
  title={Data-Driven Wind Farm Layout Optimization Using Bayesian Adaptive Direct Search}, 
  year={2024},
  volume={},
  number={},
  pages={762-769},
  abstract={With a burgeoning global appetite for clean energy, wind energy has swiftly risen to become the second most burgeoning renewable energy source, characterized by a notable annual growth rate, and has secured a position of about 6.3% in the global energy landscape. Optimizing the layout of wind farms is critical to maximizing power generation and reducing costs, a process that involves challenges such as complex multivortex wake effects, increased design variables, and non-convex objective function spaces. To overcome these challenges, the authors propose a new optimization framework. The framework includes the analysis of the vortex wake model, the eddy deflection model and the partial eddy interference effect considering the vortex superposition effect, and transforms the wind farm layout optimization into a constrained black-box optimization problem. By merging Bayesian optimization techniques with the Mesh Adaptive Direct Search (MADS) methodology, a novel algorithm known as Bayesian Adaptive Direct Search (BADS) has been developed. As a model-independent, gradient-free, efficient sample utilization and fast convergence optimization tool, BADS can effectively solve the non-smoothness in layout optimization and avoid the local optimal trap. The results not only confirm the important role of wind farm layout in improving efficiency, but also highlight the efficiency and potential of the BADS framework in dealing with actual complex models, and provide compatibility for further integration of advanced vortex wake models and high-fidelity simulations of topographic wind field interaction, indicating that wind energy utilization will be further improved in the future.},
  keywords={Green energy;Adaptation models;Analytical models;Wind energy;Atmospheric modeling;Layout;Wind farms;Bayes methods;Optimization;Convergence;Wind farm layout optimization;Wind energy;Wind farm modeling;Bayesian optimization;Data-driven},
  doi={10.1109/CCSSTA62096.2024.10691758},
  ISSN={},
  month={July},}@INPROCEEDINGS{11171384,
  author={S., Ananya M. and Aparna, Gaini and V., Manitha P.},
  booktitle={2025 5th International Conference on Soft Computing for Security Applications (ICSCSA)}, 
  title={FPGA-based Real-Time Fault Suppression and Secure Smart Grid for Smart City Emulation}, 
  year={2025},
  volume={},
  number={},
  pages={723-728},
  abstract={As the world progresses towards cleaner and more intelligent energy systems, developing a secure and dependable smart grid becomes essential. A smart grid merges with advanced communication, control, and automation technologies to manage the generation, distribution, and consumption of electricity in an effective way. However, the speed of integration speeds up by making the systems face a high risk of faults, cyber threats, and scalability challenges. This study mainly introduces a fault current suppression method that uses a city-wide emulation platform designed to improve the security and reliability of the smart grid. In case it is not managed properly, the fault current can cause damage to electrical components and threaten human safety. Moreover, this project focuses on a smart city simulation platform that models, such as residential loads, electric vehicles, distributed energy resources, and smart meters within a secure and scalable framework. This feature allows for emulation and assessment of grid performance under realistic scenarios, by promoting the development of more resilient urban energy management approaches. To safeguard grid communications, the system integrates embedded cryptographic algorithms, namely AES, ChaCha20, and Blowfish, that provide secure and efficient data encryption and decryption. All these implementations enable robust cybersecurity across communication channels. By combining the simulation-based systems with intelligent, scalable smart grid modeling, this project mainly addresses key challenges in fault tolerance, cyber-physical security, and energy efficiency at a city scale, paving the way for future resilient smart cities by providing a novel holistic framework that can be uniquely integrated with a real-time encryption and scalable urban testbed simulation.},
  keywords={Smart cities;Scalability;Emulation;Electric vehicles;Real-time systems;Smart grids;Encryption;Computer security;Field programmable gate arrays;Fault currents;Smart Grids;Cybersecurity;Communication;Electric Vehicle;AES;ChaCha20;Blowfish},
  doi={10.1109/ICSCSA66339.2025.11171384},
  ISSN={},
  month={Aug},}@ARTICLE{11475682,
  author={Chen, Chao and Xiang, Wenchen and Su, Xiaodong and Chen, Jiuchun},
  journal={IEEE Transactions on Circuits and Systems I: Regular Papers}, 
  title={A 0.65-V 2-mW Multi-Mode CMOS GNSS Receiver With Gm-C RF Quadrature-Current-Generation Technique and Folded Class-AB Amplifier}, 
  year={2026},
  volume={},
  number={},
  pages={1-13},
  abstract={This paper presents a low-voltage, ultra-low-power multi-mode CMOS GNSS RF receiver fabricated in 28nm CMOS. Two key technologies are proposed for this design: a Gm-C RF quadrature-signal generator and a folded floating current mirror, aiming to systematically reduce power dissipation and overcome the obstacles to implementing ultra-low voltage IF amplifiers. Specifically, the RF quadrature current generator is embedded within the gm stage of a passive mixer, where the frequency-translation-induced virtual AC ground significantly mitigates phase mismatch in the I&Q paths. The virtual ground also suppresses current leakage due to parasitic capacitors and impedances, thereby improving the phase balance. Amplitude balance is well maintained through interstage bias current regulation, achieving a 40-dB IRR. To further optimize power efficiency, the mixer switches are merged into the VCO. This integration physically eliminates both the quadrature frequency divider by two and the LO buffer, thereby fully eliminating their associated power consumption. Additionally, to address the cramp voltage headroom issues of the IF circuit under low-voltage operation, a low voltage class-AB OTA based on the folded floating current mirror is proposed. This circuit serves as the fundamental OTA for both the filter and the IF amplifier. Ultimately, the entire GNSS receiver achieves a minimum supply voltage of 0.65 V and a power consumption of only 2 mW—ranking among the most energy-efficient GNSS RF receivers reported. Concurrently, it achieves competitive performance metrics including 3.2 dB NF, −5 dBm OB-IIP3, −164 dBm tracking sensitivity and −148 dBm acquisition sensitivity.},
  keywords={Jamming;Synthetic aperture sonar;Electronic warfare;Phased arrays;Frequency modulation;Frequency shift keying;Circuits;Circuits and systems;Capacitors;Voltage multipliers;Ultra-low power;ultra-low-voltage;GNSS RF receiver;quadrature-current-generator;Gm-C;IRR;phase and amplitude balance;folded-floating-current-mirror;class-AB driver},
  doi={10.1109/TCSI.2026.3679351},
  ISSN={1558-0806},
  month={},}@INBOOK{11081929,
  author={Surve, Tanuj and Tyagi, Amit Kumar and Kumari, Shabnam and Palaniyandi, Muthulakshmi and Arumugam, Abirami},
  booktitle={Next Generation Data Science and Blockchain Technology for Industry 5.0: Concepts and Paradigms}, 
  title={Blockchain Technology &#x2013; Basics}, 
  year={2025},
  volume={},
  number={},
  pages={15-36},
  abstract={Abstract <p>In the recent decade, blockchain has emerged as popular technology or concept to revolutionize many sectors. This chapter on blockchain technology offers a thorough examination of decentralized systems, addressing core principles, integration complexities, and transformative opportunities. It discusses the challenges of merging blockchain with traditional systems, emphasizing collaboration, regulatory engagement, and scalability solutions. The chapter provides few lessons like user education, ethical issue, and adaptability to technological evolution. The chapter highlights blockchain's impact on security, privacy, and consensus mechanisms, with a focus on lessons learned and continuous learning. The transformative opportunities presented by blockchain include decentralized finance, supply chain transparency, and identity management. The chapter discusses the basic components, features, and dynamic evolution of blockchain technology in detail.</p>},
  keywords={Blockchains;Finance;Consensus protocol;Decentralized applications;Bitcoin;Proof of stake;Technological innovation;Smart contracts;Proof of Work;Industries},
  doi={10.1002/9781394245215.ch02},
  ISSN={},
  publisher={IEEE},
  isbn={9781394245208},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/11081929},}@INPROCEEDINGS{11295027,
  author={Sagar, Renuka and Saniya, N J and Narayan, Meghana and M, Mala and Supriya, M},
  booktitle={2025 International Conference on Sustainability, Innovation & Technology (ICSIT)}, 
  title={CelestAI: Virtual Reality AI Assistant for Everyday Tasks}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={CelestAI merges the functionalities of a virtual reality and an AI-powered assistant to improve productivity on various tasks, including management and communication. CelestAI addresses the issue of traditional virtual assistants' limited immersive interaction, and in the context of VR applications, they lack an engaging AI assistant. By combining AI-powered Assistants into a VR environment, users are more engaged. CelestAI, our assistant, and users are represented as avatars created using Ready Player Me, while the RPM SDK for Unity enhances the functionalities of these avatars. Additionally, we have integrated OpenAI's API, allowing users to converse with the assistant. Preliminary evaluations indicate that CelestAI facilitates text-based conversations with the assistant within an immersive VR environment. This advancement improves VR interactivity by incorporating artificial intelligence. Integration with voice interactions and multilingual capability are two additional use cases. It also has applications in education, healthcare, and entertainment, making CelestAI a versatile AI-powered virtual assistant.},
  keywords={Productivity;Avatars;Virtual assistants;Education;Entertainment industry;Medical services;Oral communication;Speech recognition;Multilingual;Artificial intelligence;CelestAI;Virtual Reality;AI-powered Assistant;OpenAI API;Unity;Ready Player Me;RPM SDK;Interactive Avatar;AI-driven Support;Conversational AI;Task Management;Virtual Assistant;VR Interactivity;Voice-Based Interaction;Multilingual capability;Education;Healthcare;Entertainment},
  doi={10.1109/ICSIT65336.2025.11295027},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10911664,
  author={Kulshrestha, Deepansh and Mansuri, Mohmmad Suaib and Panse, Gautam and Trivedi, Ikshita and Rajput, Saurabh Kumar and Sagwal, Rahul},
  booktitle={2024 4th International Conference on Advancement in Electronics & Communication Engineering (AECE)}, 
  title={Performance and Cash-flow Study of Rooftop Photovoltaic Plant for Dispensary Building Energy Demand}, 
  year={2024},
  volume={},
  number={},
  pages={935-940},
  abstract={This research paper presents a dual-part analysis of a 6 kWp rooftop Photovoltaic (RPV) plant for the medical dispensary building. The study aims to assess RPV plant’s performance in supplying power to dispensary lighting and medical equipment, and evaluate its economic feasibility. The performance analysis scrutinizes operational efficiency under composite environment conditions of Gwalior (India) location, calculating metrics like performance ratio and energy yields. The economic analysis focuses on investment, operational costs, and energy bill savings. The outcomes indicate that the plant achieves a performance ratio of 78% under an annual average ambient temperature of 25°C. The analysis of cash flow demonstrates that the plant attains a simple payback period of 9 years in relation to its 25-year lifespan. By merging performance and economic results, the paper provides a comprehensive understanding of the RPV system’s effectiveness at medical dispensary building. This research informs healthcare facilities about technical performance, energy potential, and financial gains linked with RPV integration. It contributes to promoting sustainable energy adoption in hospitals, fostering cleaner and resilient power solutions. The full system has a 78% performance ratio, with winter efficiency at 82% and summer at 73%. Generates: 8,383 kWh per year returning to Grid: 5,087 kWh per year A 9-year payback time makes it also an attractive financial commitment for sustainability energy in healthcare.},
  keywords={Photovoltaic systems;Energy consumption;Fluctuations;Hospitals;Buildings;Performance analysis;Solar radiation;Sustainable development;Standards;Investment;Rooftop PV;Performance analysis;Economic feasibility;Hospital/dispensary energy supply;Sustainability impact},
  doi={10.1109/AECE62803.2024.10911664},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11081190,
  author={Rebba, Vardhan and Kamepalli, Sujatha},
  booktitle={2025 International Conference on Advances in Modern Age Technologies for Health and Engineering Science (AMATHE)}, 
  title={Gastro Intestinal Disease Detection Using RegNet, MobileNetV2, EfficientNetB2, and ResNet-152 with Transformers}, 
  year={2025},
  volume={},
  number={},
  pages={1-11},
  abstract={The early detection of gastrointestinal (GI) diseases is crucial for effective treatment and improved patient outcomes. The application of advanced deep learning techniques has shown promise in detecting gastrointestinal diseases through the analysis of medical images. This study presents a novel hybrid deep learning approach by integrating RegNet with Swin Transformer, aiming to enhance the accuracy and contextual understanding of medical endoscopic images. Additionally, other model combinations-MobileNetV2 + Swin Transformer, EfficientNetB2, and ResNet152 + Vision Transformer-were also evaluated to benchmark performance. We fine-tuned our proposed model, RegNet with Swin Transformer. This combination allows us to recognize important details in medical images while also understanding the overall context, which is crucial for accurate diagnoses. By merging RegNet’s ability to recognize patterns and Swin Transformer’s skill in understanding context, our system can effectively identify key details in medical images. Our method achieved an accuracy of $90 \%$, demonstrating that this approach can improve the early detection of gastrointestinal disorders, ultimately leading to better care and outcomes for patients. This research demonstrates that combining scalable CNN backbones with hierarchical vision transformers can significantly improve the detection and classification of GI diseases. The findings support the integration of such hybrid models into clinical decision-making tools.},
  keywords={Deep learning;Computer vision;Accuracy;Image recognition;Computational modeling;Transformers;Gastrointestinal tract;Convolutional neural networks;Medical diagnostic imaging;Diseases;Convolutional Neural Networks (CNN);Wireless Capsule Endoscopy (WCE);Gastrointestinal Disease Detection;Swin Transformer;Vision Transformer (ViT)},
  doi={10.1109/AMATHE65477.2025.11081190},
  ISSN={},
  month={April},}@INBOOK{9966300,
  author={Lei, Shunbo and Wang, Chong and Hou, Yunhe},
  booktitle={Power Grid Resilience against Natural Disasters: Preparedness, Response, and Recovery}, 
  title={Microgrids with Flexible Boundaries for Service Restoration}, 
  year={2023},
  volume={},
  number={},
  pages={189-225},
  abstract={Network reconfiguration is an efficient strategy of microgrids (MGs) and distribution systems (DSs) for different purposes including resilience improvement. Specifically, MG technology development, distributed generation integration, and DS automation, etc., are enabling much more flexible operation and reconfiguration of power networks, e.g. MGs and DSs with flexible boundaries. Nonetheless, the formulation of optimization problems considering MG and DS reconfiguration and including such new flexibilities is not trivial, especially for the topology issue, that is the topology needs to be radial. In fact, formulating radiality constraints with existing methods can lead to under&#x2010;utilization of MG and DS flexibilities. This chapter presents a new method for formulating radiality constraints to fully include topological and related flexibilities in reconfiguration&#x2010;related MG and/or DS optimization problems, whose feasibility and optimality thus are extended and enhanced, respectively. The method's theoretical validity is certified by graph&#x2010;theoretic analyses. As it involves integer variables, this chapter further analyzes the tightness and compactness issues. The new radiality constraints are particularly used for post&#x2010;disaster MG formation that is involved in many resilience&#x2010;enhancing service restoration and infrastructure recovery problems of MGs and DSs. The new MG formation model allows much more flexible separation and/or merge of sub&#x2010;grids with flexible boundaries. The model also establishes superiority over the models in the literature. Two test systems are used to conduct demonstrative case studies.},
  keywords={Optimization;Topology;Resilience;Search problems;Load modeling;IEEE Regions;Automation},
  doi={10.1002/9781119801504.ch8},
  ISSN={},
  publisher={IEEE},
  isbn={9781119801511},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/9966300},}@INPROCEEDINGS{11428036,
  author={Eljack, Aseel and Matraf, Ahmed Ba and Aghbari, Zaher Al},
  booktitle={2025 Advances in Science and Engineering Technology International Conferences (ASET)}, 
  title={RuleNet: Association Rules Mining for Enhanced Deep Learning Explainability}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Recent advancements in Deep Learning (DL) have underscored the critical need for explainability in model predictions. The ability to understand and interpret the decisions made by DL models is essential for ensuring their trustworthiness and widespread adoption, especially in high-stakes domains such as healthcare and finance. Traditional DL models often operate as “black boxes,” making it challenging for users to comprehend how inputs are transformed into outputs. In response to this challenge, there has been a recent rise in techniques such as Association Rule Mining (ARM) for explainability. ARM provides transparent and intuitive explanations that users can easily grasp. ARM can uncover insights into the decision-making process of these models by analyzing patterns and associations in data. In this paper, RuleNet, a novel architecture for enhancing explainability in DL models through the integration of ARM is proposed. RuleNet employs the Apriori algorithm for generating class-specific rules from encoded training data, then trains a Deep Neural Network (DNN) to predict test instances. An Agreement component then aligns these predictions with corresponding ARM-derived rules, identifying the most relevant explanations based on the highest confidence levels, to explain the decisionmaking process of the DNN model. The results indicate that merging these methodologies significantly enhances the ability to uncover the patterns recognized by the model and evaluate its performance across various scenarios via error analysis. This approach is proposed to increase the transparency and interpretability of black-box models, thereby augmenting their dependability for practical applications.},
  keywords={Deep learning;Computational modeling;Decision making;Closed box;Finance;Artificial neural networks;Medical services;Predictive models;Data models;Association rule learning;Deep Learning;Association Rule Mining;Explainable AI;Neural Networks;Apriori Algorithm;Model Interpretability;Rule-based Explanations;Black-box Models},
  doi={10.1109/ASET66891.2025.11428036},
  ISSN={2831-6878},
  month={Sep.},}@INPROCEEDINGS{11453783,
  author={P, Usha and M, Sathish Kumar T and S, Suruthi and S, Ranjith Kumar B and T, Pavithra and M, Magudeshwaran},
  booktitle={2026 8th International Conference on Intelligent Sustainable Systems (ICISS)}, 
  title={Hybrid Convolutional Neural Network Approach for Accurate Detection of Retinoblastoma Using Retinal Image}, 
  year={2026},
  volume={},
  number={},
  pages={1402-1408},
  abstract={The research that is being proposed is about a Hybrid Convolutional Neural Network (CNN) model that can provide highly accurate diagnostic results for Retinoblastoma through the use of retinal fundus imaging. The approach merges different pretrained CNN models, namely Res-Net, Dense-net, and Mobile-net, into a single model which boosts the diagnostic accuracy by providing the extraction of complementary spatial and structural features of the retinal images. Moreover, the systematic implementation of transfer learning and sophisticated data augmentation techniques will not only be helpful in dealing with the limited size of medical datasets and the matter of class disparity but also in assuring the model's generalization to various image samples. The facsimile's presentation was determined using stratified data splits for both training and validation, with the help of evaluation metrics such as accuracy, precision, recall, F1-score, and AUC which are very important factors. The use of explicable AI tools like GradCAM and SHAP will greatly assist in demystifying the regions that have an impact on model predictions while at the same time fostering clinical interpretability and trust. The deployment of the system is done via the Stream-lit web framework which offers an interactive and easy-to-use interface where clinicians and researchers can upload retinal scans, see prediction probabilities, and simultaneously access heat-mapped explanations of the results. The combined approach of hybrid deep learning and Stream-lit integration is meant to be a great help to ophthalmologists for early detection of Retinoblastoma, it will save time in the manual screening process and also increase the reliability of automated medical image analysis.},
  keywords={Training;Accuracy;Systematics;Error analysis;Transfer learning;Streaming media;Retina;Feature extraction;Convolutional neural networks;Medical diagnostic imaging;Hybrid Convolutional Neural Network (CNN);Retinoblastoma Detection;Explainable Artificial Intelligence (XAI);Retinal Fundus Imaging},
  doi={10.1109/ICISS67859.2026.11453783},
  ISSN={},
  month={March},}@INPROCEEDINGS{10592332,
  author={De Matos, Everton and Lunardi, Willian Tessaro and Ukkonen, Jouni and Salminen, Tero},
  booktitle={2024 International Wireless Communications and Mobile Computing (IWCMC)}, 
  title={An seL4-based Trusted Execution Environment on RISC-V}, 
  year={2024},
  volume={},
  number={},
  pages={712-717},
  abstract={In an era where digital security is paramount, the concept of Trusted Execution Environments (TEEs) is crucial for safeguarding sensitive data within computing systems. This paper introduces an implementation of seL4 as a secure operating system in a TEE on RISC-V hardware. We address integration challenges, offering insights for future secure system designs. A comprehensive performance evaluation of the seL4-based TEE shows enhanced security and operational efficiency. This includes assessments of the Linux Rich Execution Environment’s (REE) performance and analyses of essential TEE services: Random Number Generation, Key Pair Generation, and Digital Signing Operations. Our deployment on the PolarFire SoC Icicle kit demonstrates practicality and viability in a real-world environment. This research contributes to trusted computing area by merging seL4’s robust microkernel architecture with RISC-V’s open-source flexibility, fostering secure, efficient, and adaptable computing solutions.},
  keywords={Performance evaluation;Wireless communication;Trusted computing;Operating systems;Computer architecture;Open source hardware;Virtualization;Trusted Execution Environment;seL4;RISC-V;microkernel;CAmkES},
  doi={10.1109/IWCMC61514.2024.10592332},
  ISSN={2376-6506},
  month={May},}@INPROCEEDINGS{11215105,
  author={Konopiński, Jakub and Świetlicka, Aleksandra and Góral, Piotr and Pawłowski, Paweł},
  booktitle={2025 Signal Processing: Algorithms, Architectures, Arrangements, and Applications (SPA)}, 
  title={Adaptive Hysteresis Thresholding & Shape Detection Using Artificial Neural Networks}, 
  year={2025},
  volume={},
  number={},
  pages={68-74},
  abstract={This paper presents a method of adaptive hysteresis thresholding aimed at shape detection and classification using a neural network micromodel. The research is focused on analyzing the impact of modifying hysteresis thresholds (±10%, ±20%, ±30% relative to reference values) on contour segmentation quality and classification performance. The generated binary images were merged and filtered to obtain averaged edge representations, based on which a dataset of 1245 images depicting basic geometric figures was created. The developed neural network model was trained on data from various binarization variants and evaluated in terms of classification accuracy. The results show that extending the thresholding range to ±30% and using averaged contours improves classification performance while maintaining low computational complexity. The proposed method constitutes an effective integration of classical segmentation techniques with CNN-based approaches, making it suitable for embedded applications.},
  keywords={Deep learning;Image segmentation;Thresholding (Imaging);Adaptive systems;Shape;Image edge detection;Feature extraction;Stability analysis;Convolutional neural networks;Hysteresis;Adaptive thresholding;Edge detection;Image segmentation;Binary image processing;Contour extraction;Convolutional neural network (CNN);Shape classification;Image preprocessing;Local threshold modification;Overfitting in deep learning;Feature representation;Noise reduction in images;Image gradient maps;Segmentation stability;Deep learning for image analysis},
  doi={10.23919/SPA65537.2025.11215105},
  ISSN={2326-0319},
  month={Sep.},}@INPROCEEDINGS{11395781,
  author={Satyam, Venkata Nagendra and Mahapatra, Braja Gopal and Mishra, Devisharan},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Software Engineering Challenges in the Deployment of Generative AI Models at Scale}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The rapid development of one of the biggest advances in the sphere of Generative AI has led to natural language generation still being limited to large-scale implementation due to latency, reproducibility, integration complexity, and scalability challenges. This project offers a simple and repeatable deployment pipeline which is based on the Kaggle Fitness Exercises dataset. The final corpus was then fine-tuned with GPT-2 on Hugging Face and PyTorch using extensive preprocessing, that is, data cleaning, instruction merging, normalization, tokenization, and outlier filtering. The model was evaluated on five configurations with a loss of evaluation of approximately 0.4083, 0.4094, and perplexity of 1.5043, 1.5058, and sensitivity and ablation studies indicate the most sensitive hyperparameter is the learning rate. The fine-tuning of the model was performed through a FastAPI service, and it was then containerized using Docker, which made it suitable for deployment on any cloud provider. The outcome was an even training process, low perplexity, and excellent performance reproducibility, while the tests in the production environment showed moderate in inference and throughput, which in turn led to the decision to carry out further optimization on the runtime. The proposed method offers excellent reproducibility, minimum operational cost, and easy deployment compared to the more complex orchestration and full MLOps pipelines.},
  keywords={Training;Sensitivity;Runtime;Generative AI;Scalability;Pipelines;Production;Throughput;Reproducibility of results;Tokenization;Generative AI;software engineering;model deployment;docker;FastAPI;scalability;reproducibility},
  doi={10.1109/ICAIC67076.2026.11395781},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{9852832,
  author={Holzmann, Helge and Ruest, Nick and Bailey, Jefferson and Dempsey, Alex and Fritz, Samantha and Lee, Peggy and Milligan, Ian},
  booktitle={2022 ACM/IEEE Joint Conference on Digital Libraries (JCDL)}, 
  title={ABCDEF - The 6 key features behind scalable, multi-tenant web archive processing with ARCH: Archive, Big Data, Concurrent, Distributed, Efficient, Flexible}, 
  year={2022},
  volume={},
  number={},
  pages={1-11},
  abstract={Over the past quarter-century, web archive collection has emerged as a user-friendly process thanks to cloud-hosted solutions such as the Internet Archive’s Archive-It subscription service. Despite advancements in collecting web archive content, no equivalent has been found by way of a user-friendly cloud-hosted analysis system. Web archive processing and research require significant hardware resources and cumbersome tools that interdisciplinary researchers find difficult to work with. In this paper, we identify six principles the ABCDEFs (Archive, Big data, Concurrent, Distributed, Efficient, and Flexible) - used to guide the development and design of a system. These make the transformation of, and working with, web archive data as enjoyable as the collection process. We make these objectives - largely common sense - explicit and transparent in this paper. They can be employed by every computing platform in the area of digital libraries and archives and adapted by teams seeking to implement similar infrastructures. Furthermore, we present ARCH (Archives Research Compute Hub 1, the first cloud-based system designed from scratch to meet all of these six key principles. ARCH is an interactive interface, closely connected with Archive-It, engineered to provide analytical actions, specifically generating datasets and in-browser visualizations. It efficiently streamlines research workflows while eliminating the burden of computing requirements. Building off past work by both the Internet Archive (Archive-It Research Services) and the Archives Unleashed Project (the Archives Unleashed Cloud), this merged platform achieves a scalable processing pipeline for web archive research. It is open-source and can be considered a reference implementation of the ABCDEF, which we have evaluated and discussed in terms of feasibility and compliance as a benchmark for similar platforms.CCS CONCEPTS • Information systems $\rightarrow$ Digital libraries and archives; Data extraction and integration. 1https://github.com/internetarchive/arch},
  keywords={Cloud computing;Pipelines;Distributed databases;Big Data;Feature extraction;Libraries;Hardware;web archives;big data;data processing;distributed computing},
  doi={},
  ISSN={},
  month={June},}@INPROCEEDINGS{11042592,
  author={Reddy, Konda Achi and Reddy, Satti Jaswanth and Reddy, Dwarampudi Sivaji Srinu Sai Rama and S, Indra Priyadharshini},
  booktitle={2025 2nd International Conference on Research Methodologies in Knowledge Management, Artificial Intelligence and Telecommunication Engineering (RMKMATE)}, 
  title={Dehazing of Remote Sensing Images using Deep Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Image Dehazing in remote sensing is essential to enhance clarity and improve precision in feature and data analysis, which is vital for tasks such as land monitoring, environmental research, and object detection. This study introduces an innovative deep learning methodology for dehazing images, employing a hybrid architecture that merges convolutional neural networks (CNNs) with Transformer models. The suggested model incorporates a pre-trained ResNet50V2 to extract features alongside strategically positioned Transformer blocks within the network, aimed at capturing global context and long-range relationships in images. By utilizing multi-head self-attention mechanisms, the Transformer blocks significantly boost the model’s capability to recover intricate details in hazy images, surpassing traditional CNN-based dehazing methods. Our dehazing approach utilizes ResNet50V2 to develop robust hierarchical representations from hazy images, which are then refined by Transformer blocks. The implementation of Conv2D transpose layers guarantees precise upsampling and reconstruction of high-quality clear images. This integration of CNN and Transformer layers enables the model to better maintain structural information and restore clarity while preventing overfitting through multi-scale feature fusion.The model is assessed using a dataset comprising pairs of hazy and clear images, with performance gauged by metrics such as Peak Signal-to-Noise Ratio (PSNR) and Structural Similarity Index Measure (SSIM). The results highlight exceptional dehazing performance, reflected in high PSNR and SSIM values, demonstrating notable enhancements in image quality. This study emphasizes the efficacy of Transformer models in tasks related to image restoration and presents a novel architecture that could be utilized in various image enhancement applications.},
  keywords={PSNR;Transformers;Feature extraction;Satellite images;Image restoration;Convolutional neural networks;Indexes;Remote sensing;Image reconstruction;Context modeling;Resnet50V2;Transformers;Upsampling;Conv2DTranspose;Structural Similarity Index (SSIM);Convolutional Neural Networks (CNN);Atmospheric correction;haze},
  doi={10.1109/RMKMATE64874.2025.11042592},
  ISSN={},
  month={May},}@ARTICLE{11353904,
  author={Khan, Ameer Tamoor and Li, Shuai},
  journal={IEEE Journal of Selected Areas in Sensors}, 
  title={Robotic Haircutting Systems: A Survey of Methods, Challenges, and Hair Modeling Insights}, 
  year={2026},
  volume={3},
  number={},
  pages={104-112},
  abstract={The field of robotic haircutting is rapidly evolving, merging advances in service robotics, computer vision, force sensing, and deep learning. This survey article highlights the growing importance of robotic systems in personal grooming, driven by demographic shifts, technological innovation, and increasing demand for hygienic, consistent services. We review the historical evolution of robotic haircutting technologies, including DIY solutions, academic prototypes, and emerging commercial systems. Core technologies, such as robotic arms, hair modeling, motion planning, and tactile sensing are discussed in detail. Key challenges including hair variability, real-time decision-making, user customization, and safety considerations are analyzed. Furthermore, we explore the transformative role of virtual hairstyle modeling and the integration of multimodal perception and AI-driven personalization. Future research directions emphasize the incorporation of large language models, vision-language models, reinforcement learning, and diffusion models to advance human–robot collaboration in salons, while addressing ethical, societal, and inclusivity considerations.},
  keywords={Robots;Robot sensing systems;Hair;Service robots;Sensors;Safety;Planning;Manipulators;Three-dimensional displays;Real-time systems;Computer vision;deep learning;force sensing;human-robot collaboration;large language models;robotic haircutting;virtual hairstyle modeling},
  doi={10.1109/JSAS.2026.3654480},
  ISSN={2836-2071},
  month={},}@INPROCEEDINGS{10751638,
  author={Ambarura, Chiu Citra Anugrata and Pramono, Andi and Azzahri, Ellina Fahra and Halim, Trixie Ordelia and Prabowo, Riefky and Azis, Baskoro},
  booktitle={2024 International Conference on ICT for Smart Society (ICISS)}, 
  title={Implementing a 360 Degree Virtual Tour in the Interior of an E-Grocery Start-Up to Increase Consumer Buying Impulse}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The e-grocery sector has experienced substantial growth due to recent advancements in technology and the internet. Nevertheless, current e-grocery enterprises require assistance in addressing individuals' challenges pertaining to recipe expertise, menu selection, and ingredient preparation in cooking. Thus, the e-grocery startup Healthin presents itself as a remedy to this issue by offering ingredient kits and using a hybrid sales strategy that combines online channels and physical storefronts. This study intends to analyse the interior design and deployment of 360° virtual tour technology in startup retail establishments in order to merge online and offline shopping experiences. In order to do this, the author utilised Sketchup software to construct an interior design for a retail store, along with a mood board as a design reference. Subsequently, the WeboBook platform was employed to develop a prototype of a 360° virtual tour. Subsequently, the author proceeded to employ the questionnaire method to gather feedback from the intended users regarding the integration of 360° virtual tours in startup retail stores. Studies indicate that the utilisation of 360° virtual tour technology enhances the consumer experience by offering a comprehensive view of products and store layout. The survey results indicated a favourable response from participants regarding the implementation of 360° virtual tour technology in startup retail outlets. However, some participants offered suggestions for future enhancement. The outcome of this study is a high-fidelity prototype of a 360° virtual tour for a startup retail company designed to enhance the digital shopping experience by providing a more immersive and visually captivating environment.},
  keywords={Surveys;Mood;Layout;Prototypes;Color;User experience;Software;Electronic commerce;Floors;Creativity;E-Grocery;Interior Design;Prototype;Retail Store;360 degree Virtual Tour},
  doi={10.1109/ICISS62896.2024.10751638},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11500061,
  author={Tran, Trien Phat and Din, Fareed Ud and Brankovic, Ljiljana and Sanin, Cesar and Hester, Susan M.},
  booktitle={2025 Conference on AI, Science, Engineering, and Technology (AIxSET)}, 
  title={Vietnamese Medicinal Species Identification: A Curated Dataset with Enhanced Metadata for AI-Based Classification}, 
  year={2025},
  volume={},
  number={},
  pages={134-139},
  abstract={The proper identification of medicinal species is crucial for effective conservation strategies, ethnobotanical studies, and subsequent medical applications. This article presents a dataset of medicinal species, featuring multi-kingdom and curated imagery, from Vietnam. In addition to a sub-collection from the PlantCLEF 2022 benchmark, we have added adjacent images from our dataset based on the PlantGBIF Occurrence API. This is possible because we taxonomically linked the scientific names from the Vietnamese medicinal plant library to GBIF species keys, which allowed us to merge our imagery across datasets. In total, we constructed a dataset with more than 173,000 images for 2,787 species across four kingdoms (Plantae, Fungi, Chromista, and Bacteria). We established a baseline of performance by training convolutional neural networks using transfer learning to conduct two tasks: 1) fine-grained species-level classification, and 2) coarse kingdom classification. For species prediction, we achieved a Top-1 accuracy of 40.12% and Top-5 accuracy of 60.66%, due primarily to the dominant class imbalance and visual similarity between many of the taxa. For kingdom prediction, we achieved 96.14% accuracy and demonstrated that coarse-level classification is feasible. The findings from this work demonstrate the potential to combine local knowledge with a global dataset, advancing the development of artificial intelligence-supported tools for tracking biodiversity and traditional medicine. Future work will focus on hierarchical classification, the integration of ethnobotanical metadata, and the implementation of optimised models on mobile platforms.},
  keywords={Motion pictures;Filtering;Filters;Filtering theory;Image filtering;Circuits and systems;HTTP;Protocols;Pixel;Mobile handsets;Medicinal Species Identification;Biodiversity Informatics;Deep Learning;PlantCLEF;Vietnamese Herbal Plants},
  doi={10.1109/AIxSET65682.2025.00025},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11324376,
  author={P, Shanmugam and S, Keerthika and A, Kamali K},
  booktitle={2025 4th International Conference on Automation, Computing and Renewable Systems (ICACRS)}, 
  title={AI-Driven Intelligent Automation Framework for Driver Behavior Analysis and Safety Control}, 
  year={2025},
  volume={},
  number={},
  pages={1164-1171},
  abstract={Road safety is an enduring worldwide problem, with numerous mishaps due to driver conduct and deficient preemptive integration of automation in support systems. This document introduces a smart automation schema combining computer vision and generative language models for improved driving safety via instant perception, processing, and dynamic feedback. Differing from classic sensor-centric driver monitoring, our system utilizes vehicle detection via YOLOv8, DeepSORT tracking, and spatio-temporal behavioral analysis to autonomously identify dangerous behaviors including tailgating, sudden lane switching, and risky overtaking. The incidents are fed into a generative AI-supported feedback system converting behavioral metrics into human-readable safety instructions, merging perception with control. It functions as a cyber-physical control tier that can provide instant notifications or dynamic driver support via conventional dashcams or smartphones. Empirical assessment on authentic vehicular footage repositories yielded 91% precision in hazardous actions retrieval, whereas questionnaires unveiled a notable progress in vehicular obediance and cognition. The suggested architecture provides a budget-friendly, expandable and language-agnostic automation framework integrating deep learning, smart control and generative AI to power the upcoming class of driver assistance systems.},
  keywords={Intelligent automation;Deep learning;Computer vision;Generative AI;Computational modeling;Road safety;Safety;Vehicle dynamics;Driver behavior;Vehicles;Driver behavior analysis;Intelligent automation;Cyber-physical systems;Computer vision;YOLOv8;DeepSORT;Generative AI;Real-time safety control;Human-in-the-loop automation;Road safety},
  doi={10.1109/ICACRS67045.2025.11324376},
  ISSN={},
  month={Dec},}@ARTICLE{11373670,
  author={Wang, Yu and Ma, Zhanying and Li, Mengmeng and Li, Yu and Shi, Xue and Zhao, Xuemei},
  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={Adaptive Superpixel Segmentation-Based Coastline Extraction Method for PolSAR Images}, 
  year={2026},
  volume={19},
  number={},
  pages={7251-7263},
  abstract={To improve the accuracy of coastline extraction for polarimetric synthetic aperture radar (PolSAR) images, an adaptive superpixel segmentation-based method is proposed. First, multiple polarimetric and texture features are extracted to characterize the complexity for PolSAR image. Then, the image complexity and dimension are used to determine the optimal number of superpixels, followed by segmenting superpixels through the integration of the simple linear iterative clustering (SLIC) algorithm. The segmented superpixels are merged to extract the coastlines using the superpixel similarity-based fractal network evolution algorithm (FNEA). Ultimately, the proposed method is validated using PolSAR images with varying complexity levels. Experimental results demonstrate its effectiveness, achieving an average undersegmentation error of 0.1269 for adaptive superpixel segmentation and a high average Kappa coefficient of 0.9889 for coastline extraction. Furthermore, the method exhibits strong adaptability in superpixel segmentation while maintaining high precision in coastline extraction.},
  keywords={Coastlines;Sea measurements;Pixel;Land surface;Geologic measurements;Image segmentation;Complexity theory;Accuracy;Scattering;Feature extraction;Adaptive superpixel segmentation;coastline extraction;polarimetric synthetic aperture radar (PolSAR) Image;superpixel similarity},
  doi={10.1109/JSTARS.2026.3662412},
  ISSN={2151-1535},
  month={},}@INPROCEEDINGS{11385887,
  author={Kamath, Deepika and Baligar, Gayatri and Gajendra, A and Manjula, H and Karjagi, Raghavendra},
  booktitle={2025 2nd International Conference on Intelligent Systems for Cybersecurity (ISCS)}, 
  title={Integrating Mobile and IoT Solutions for Public Safety: A Review with an Emergency Button Framework}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Guaranteeing public safety has emerged as an escalating issue due to the rising frequency of harassment and crime occurrences in communities. To tackle this issue, scientists have investigated numerous mobile apps, wearable gadgets, and IoT-driven systems aimed at providing swift and dependable emergency assistance. Leveraging these insights, this project suggests a comprehensive emergency button system for public safety that merges live communication, location data, and cloud integration. The system can make hands-free SOS calls, produce geofencing alerts, capture audio and video evidence, and alert nearby trusted contacts. Extra protections comprise battery and signal backup systems, secure one-to-one communication, chatbot help, safety tools, and a simulated calling option for subtle intervention. This comprehensive strategy enhances response time in emergencies while also equipping individuals with preventive and proactive security tactics in daily situations.},
  keywords={Privacy;Cloud computing;Technological innovation;Chatbots;Public security;Safety;Mobile applications;Time factors;Wearable devices;Videos;Emergency button;public safety;SOS alert;geofencing;wearable devices;IoT security;cloud connectivity;audio/video evidence;mobile application;chatbot support},
  doi={10.1109/ISCS69371.2025.11385887},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11349482,
  author={Carloni, Filippo and Tulumello, Angelo and Castelli, Andrea and Montesa, Javier and Antichi, Gianni and Bianchi, Giuseppe and Lettieri, Giuseppe and Procissi, Gregorio},
  booktitle={2025 IEEE Conference on Network Function Virtualization and Software-Defined Networking (NFV-SDN)}, 
  title={Design Principles for Accelerated Programmable Edge Computing in Future 6G Architectures}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The growing demand for high throughput and ultra-low latency in emerging 6G networks requires moving service processing closer to end users and enabling powerful computational offloading within the network infrastructure. This work proposes Accelerated Programmable Edge Computing (APEC), a unified, flexible framework that combines high-performance CPU processing with hardware offloading capabilities provided by programmable network interface cards (NICs). APEC aims to enhance network performance with an adaptable platform merging high-level programming expressiveness with specialized hardware acceleration. Its architecture exposes custom primitives optimized for hardware and kernel-level offloading or user-space acceleration, via a Programmable Abstraction Interface, facilitating efficient execution of network functions. The framework provides high performance via multiple acceleration strategies. It optimizes data handling through high-speed software while advanced kernel-level processing further reduces latency, whereas performance-critical tasks are executed on specialized network hardware. This position paper provides the core components of the APEC framework, discussing their rationale and integration.},
  keywords={6G mobile communication;Program processors;Runtime;Semantics;Computer architecture;Throughput;Software;Software defined networking;Hardware acceleration;Edge computing;data plane;in-network computing;SmartNIC;domain-specific compilers;high-level abstractions},
  doi={10.1109/NFV-SDN66355.2025.11349482},
  ISSN={2832-2231},
  month={Nov},}@INPROCEEDINGS{11220351,
  author={Lin, Junjian and Sun, Wenzhuo and Zhang, Xiangyu and Wang, Jianjian and Feng, Pingfa and Yu, Dingwen and Zhang, Jianfu},
  booktitle={2025 IEEE International Symposium on Mixed and Augmented Reality (ISMAR)}, 
  title={SAMR: A Spatial-Augmented Mixed Reality Method for Enhancing Vision-Language Models in 3D Scene Understanding}, 
  year={2025},
  volume={},
  number={},
  pages={857-866},
  abstract={Understanding 3D scenes in mixed reality (MR) is crucial for advancing human-computer interaction, especially in MR applications that demand spatial awareness and contextual reasoning. While Vision-Language Models (VLMs) perform well in 2D image interpretation, they struggle to incorporate spatial context from 3D settings, which limits their effectiveness in MR scenarios. To address this issue, we introduce SAMR, a Spatial-Augmented Mixed Reality method designed to enhance VLMs for 3D scene understanding. Our system consists of three key modules. The first module, a spatial-segmented fusion module, uses FastSAM-based segmentation to create objectlevel meshes from head-mounted display (HMD) images. It maps extracted feature points to 3D coordinates through ray casting on the HMD-captured mesh and applies triangular facet fitting. The second module, a multimodal interaction module, combines gestures, gaze, and voice commands to enable intuitive interaction with 3D meshes for annotating prompts. The third module, a VLM integration module, processes data by merging annotated 2D images with user queries to form standardized prompts for the VLM. The VLM then generates responses linked to user-specified object meshes. By enhancing VLMs with spatial context and multimodal capabilities, SAMR greatly improves 3D scene interpretation. We demonstrate SAMR's effectiveness across six key application scenarios: object identification, relationship analysis, distance estimation, targeted object questioning, and cognitive assistance. This approach provides a robust framework for MR applications with AI agents.},
  keywords={Solid modeling;Three-dimensional displays;Accuracy;Mixed reality;Resists;Feature extraction;Real-time systems;Natural language processing;Object recognition;Artificial intelligence;I.3.7 [Computer Graphics]: Three-Dimensional Graphics and Realism—Virtual Reality;H.5.2 [Information Interfaces and Presentation]: User Interfaces-Interaction Techniques;I.4.5 [Image Processing and Computer Vision]: Reconstruction;I.2.7 [Artificial Intelligence]: Natural Language Processing},
  doi={10.1109/ISMAR67309.2025.00094},
  ISSN={2473-0726},
  month={Oct},}@INPROCEEDINGS{10925150,
  author={Shen, Maoxin and Li, Weimin and Wang, Jingchao},
  booktitle={2024 IEEE Smart World Congress (SWC)}, 
  title={AMMFNet: An Attention-Based Multimodal Multiscale Fusion Framework for Alzheimer’s Disease Diagnosis}, 
  year={2024},
  volume={},
  number={},
  pages={713-720},
  abstract={Deep learning-based methods provide a non-invasive, efficient, and convenient approach for diagnosing Alzheimer’s disease (AD). However, most deep learning approaches concentrate on single-modal data, leading to instability in capturing disease traits and neglecting the multimodal aspects essential for accurate medical diagnosis in Alzheimer’s disease. Secondly, current multimodal methods exhibit relatively independent feature extraction processes for each modality and lack low-level feature interactions, thus limiting the expressive power of the features, thereby affecting the model’s performance. Furthermore, contemporary research on multimodality often employs a single scale to model brain features, hindering the adequate perception of local disease information within the brain. To overcome these challenges, we introduce a Multimodal Fusion Model with Attention (MFMA) for diagnosing Alzheimer’s disease. This framework utilizes a self-attention mechanism to merge the global features of both imaging modalities within their respective feature extraction pathways. By doing so, it facilitates a thorough multiscale integration of features from both imaging modalities, while also incorporating clinical indicator data from the patient to arrive at a final diagnosis. Experiments on the ADNI dataset demonstrate that the proposed method is highly competitive compared to current approaches.},
  keywords={Deep learning;Learning systems;Limiting;Image resolution;Magnetic resonance imaging;Feature extraction;Brain modeling;Medical diagnosis;Alzheimer's disease;Positron emission tomography;alzheimer’s disease;multimodal multiscale fusion;convolutional neural network;attention mechanism;deep learning},
  doi={10.1109/SWC62898.2024.00126},
  ISSN={2993-396X},
  month={Dec},}@INPROCEEDINGS{11071049,
  author={Basavaraja, Venkappanavara and S, Shiva Prasad M and S, Ganga Shirisha M and Naikodi, Chandrakant and Srinivas, Badrinath G and Rao, B Bhaskara},
  booktitle={2025 4th OPJU International Technology Conference (OTCON) on Smart Computing for Innovation and Advancement in Industry 5.0}, 
  title={Physical File Locking System Using IoT}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Combining the Internet of Things (IoT) and biometric authentication has transformed security solutions across various sectors. This paper introduces a novel method for securing physical file access through an IoT-enabled fabric belt equipped with biometric finger sensors. To ensure thorough user identification, finger sensors are strategically placed on the top left, top right, bottom left, and bottom right side of the belt. This innovative approach offers significant benefits over conventional access control systems. Biometric verification adds robust security by requiring authentication from multiple positions. The method also reduces the risk of unauthorized entry by eliminating the need for traditional keys or access cards, which can be lost or stolen. Additionally, IoT integration allows for remote monitoring and management of access logs, improving accountability and audit ability. For enhanced security, the system can mandate that fingerprints from different users match on opposite sides of the belt to unlock the file. By merging IoT and biometric technology, this solution provides a reliable and intuitive way to manage access to physical files. Its scalability and adaptability make it suitable for applications demanding high-security measures while maintaining convenience and efficiency for authorized users.},
  keywords={Access control;Technological innovation;Scalability;Fingerprint recognition;Belts;Biometric authentication;Sensor systems;Internet of Things;Biosensors;Remote monitoring;Fingerprint Sensor;Digital File Locking System;Security;Sensors},
  doi={10.1109/OTCON65728.2025.11071049},
  ISSN={},
  month={April},}@INBOOK{10952458,
  author={Sethi, Sarabjeet Singh and Sharma, Priyanka},
  booktitle={Artificial Intelligence-Enabled Businesses: How to Develop Strategies for Innovation}, 
  title={Industry Augmented Reality Along with Artificial Intelligence}, 
  year={2025},
  volume={},
  number={},
  pages={311-332},
  abstract={Summary <p>Augmented reality (AR) is a technically augmented depiction that mimics the actual surroundings that exists from the incorporation of computerized visual, auditory, and other different sensory inputs. It is one of the key innovations of Industry 4.0, ranks as one of the greatest intriguing as well as facilitating technologies for facilitating manufacturing facilities. Artificial intelligence (AI) techniques are making remarkable strides and are currently being used in many different industries. The next big development in the next years will be the merging of AR with AI, as numerous industries and educational establishments realize how important this integration is. In the years ahead, computers will become affordable, more effective, plus energy optimized. This serves as an important catalyst and prerequisite for growth in AR, so with the backing of AI, it is feasible. Smart businesses have a great opportunity to boost production speed and staff training, as well as improve manufacturing, error management, assembly, and packing. We present a thorough assessment of current achievements in addition to platforms of AI&#x2010;powered AR, as well as the complications of smearing AI in AR usages. It is going to function as a foundation for forthcoming research on AR using AI support in industries.</p>},
  keywords={Artificial intelligence;Augmented reality;Industries;Business;Fourth Industrial Revolution;Technological innovation;Rendering (computer graphics);Object recognition;Global Positioning System;Cameras},
  doi={10.1002/9781394234028.ch17},
  ISSN={},
  publisher={Wiley},
  isbn={9781394234004},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10952458},}@INPROCEEDINGS{11484002,
  author={P, Priya and N, Abinayasri and A, Divya Dharshini and S, Hariharan},
  booktitle={2026 International Conference on Machine Learning and Autonomous Systems (ICMLAS)}, 
  title={A Survey on IoT-Based Water Quality Monitoring Enhanced by Deep Learning}, 
  year={2026},
  volume={},
  number={},
  pages={1488-1494},
  abstract={This project showcases a hybrid system that can detect and quantify microplastics in water by merging deep learning and IoT-enabled sensor integration. Water sample images are processed by state-of-the-art convolutional neural network models to detect and derive microplastic particle counts and sizes concurrently with low-cost sensors measuring water quality parameters: Total Dissolved Solids (TDS), pH, turbidity and electrical conductivity. Current water testing practices, generally through sampling to a laboratory for tests, may take time and thus are not typically rapid, expensive and do not enable an immediate understanding of the quality. It is a smart monitoring system, providing water quality monitoring using IoT-based sensors and deep learning for continuous monitoring, in real-time. It will assess physical properties of water including Total Dissolved Solids (TDS), pH, turbidity and electrical conductivity to provide information on the safety of water quality and provides for monitoring for potential events of water quality before contamination occurs and is observed. It contains predictive intelligence using deep learning to provide the ability to provide information of future potential contamination before the conditions become hazardous level. It does not replace traditional threshold-based assessment systems that notify the user when a single value crosses a threshold, but it is selflearning for patterns for historical data and real-time data. The technology of the system (CNNs, RNNs) will assess complex fluid dynamics of water properties and provide possible alerts to the scientist for contamination events when they develop before they become hazardous condition first.},
  keywords={Optical waveguides;Optical planar waveguides;Optical propagation;Motion pictures;Programmable logic arrays;Internet of Things;Protocols;Radio frequency;Communication systems;Internet;Microplastic Detection;Deep Learning;IoT Sensors;Water Quality Monitoring;Convolutional Neural Networks (CNNs);Recurrent Neural Networks (RNNs);Predictive Intelligence;Real- time Analysis;Environmental Monitoring},
  doi={10.1109/ICMLAS67792.2026.11484002},
  ISSN={},
  month={March},}@INPROCEEDINGS{10493481,
  author={K, Shreyas and V, Manjula},
  booktitle={2024 Second International Conference on Emerging Trends in Information Technology and Engineering (ICETITE)}, 
  title={Adaptive Edge Computing for Autonomous Vehicles in Varying Environment}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={This research offers an in-depth analysis of the integration of Autonomous Vehicle Platooning, Vehicle-to-Everything (V2X) communication, Edge Analytics, and Real-time Traffic Management. Central to the study is “Platooning,” where autonomous vehicles optimize road space, fuel efficiency, and safety. V2X communication, a silent yet critical interaction between vehicles and their surroundings, lays the foundation for advanced safety and navigation in autonomous vehicles. When combined with V2X, platooning generates vast data, making Edge Analytics essential for filtering realtime intelligence for swift decisions. The study emphasizes the importance of Real-time Traffic Management in managing urban congestion, with Edge Analytics providing dynamic route planning. By focusing on algorithms and practical applications, the research aims to merge these technologies for efficient, safe, and responsive Autonomous vehicles (AV) operations, offering insights for urban planning and traffic management, and setting the stage for a sustainable transportation future.},
  keywords={Space vehicles;Technological innovation;Urban planning;Transportation;Vehicular ad hoc networks;Real-time systems;Security;autonomous vehicles;Edge Analytics;platooning;dynamic route planning;V2X communication},
  doi={10.1109/ic-ETITE58242.2024.10493481},
  ISSN={},
  month={Feb},}@ARTICLE{11408260,
  author={Yin, Chongxi and Liu, Baojian},
  journal={IEEE Transactions on Geoscience and Remote Sensing}, 
  title={Reconstruction of 500-m Resolution CYGNSS Water Map Using Physics-Constrained Interpolation and Three-Parameter Exponential Threshold Algorithm}, 
  year={2026},
  volume={64},
  number={},
  pages={1-12},
  abstract={Surface water detection using global navigation satellite system reflectometry (GNSS-R) has received growing research interest. There is a consensus that the resolution of cyclone global navigation satellite system (CYGNSS) is about 500 m in the inland water regions, but the along-track resolution is downsampled to 3.5 km due to the 2 Hz incoherent integration of delay-Doppler map (DDM). This study presents the first attempt to reconstruct CYGNSS-based inland water maps at 500 m resolution using only DDM data. Multitrack CYGNSS observations are first merged on a 500 m grid with a physics-constrained interpolation (PCI) algorithm, and water/land classification is then performed with a three-parameter exponential threshold (3-PET) model. When evaluated against the global surface water (GSW) dataset, the resulting 500 m retrieval reaches an overall accuracy (OA) of 0.958 and shows negligible loss relative to a 1 km PCI benchmark, with a slightly higher  $F1$  score (0.563 versus 0.548). Compared with the Berkeley-RWAWC product, it attains a higher  $F1$  (0.563 versus 0.434) while substantially reducing the false-alarm rate (0.424 versus 0.666). The framework requires no auxiliary data, highlighting the potential of simple, DDM-only GNSS-R retrievals for high-resolution inland water mapping.},
  keywords={Scattering;Vegetation mapping;Spatial resolution;Sea surface;Rivers;Wetlands;Lakes;Reflectivity;Interpolation;Heuristic algorithms;Cyclone Global Navigation Satellite System (CYGNSS);global navigation satellite system reflectometry (GNSS-R);surface water mapping},
  doi={10.1109/TGRS.2026.3667400},
  ISSN={1558-0644},
  month={},}@INPROCEEDINGS{11133778,
  author={Wen, Yuqiang and Eddie Law, K. L.},
  booktitle={2025 34th International Conference on Computer Communications and Networks (ICCCN)}, 
  title={Cell-Expansion and Region-Cut-Split Algorithms for Steiner Tree Problem in HAPS Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The High Altitude Platform Station (HAPS) mesh network can cover a large surface area on Earth, making it an excellent choice for broadcasting signals to a vast number of recipients distributed across extensive regions simultaneously. Different applications may attract different sets of audiences, leading to various groups of recipients subscribing to different content services. We refer to data delivery among these subscribers as Selected Group Broadcasting (SGB). Essentially, SGB routing is a Steiner Tree Problem in Graphs (STPG). In this paper, we propose a Cell-Expansion algorithm that provides a generic exact solution for hop-constrained STPG and functions as a reduction-integration framework. The HAPS mesh follows the concept of a small-world network, characterized by its unique topological properties. Accordingly, we introduce the Region-Cut-Split algorithm for merging inter-regional networks. By combining these algorithms, we achieve an exact solution for SGB routing. The distributed parallel runtimes of our algorithms enable feasible real-time, QoS-assured SGB services for data delivery across a HAPS mesh network. Rigorous simulations and verification confirm the efficacy of our proposed mechanisms for constructing SGB routing on arbitrary random HAPS topologies. In HAPS mesh simulations, our solution consistently outperforms state-of-the-art heuristics in both accuracy and efficiency, and surpasses exact solvers in real-time performance.},
  keywords={Steiner trees;Wide area networks;Mesh networks;Accuracy;Computational modeling;Broadcasting;Routing;Real-time systems;Topology;Time factors;High Altitude Platform Station (HAPS);Steiner Tree Problem in Graph (STPG);small-world network},
  doi={10.1109/ICCCN65249.2025.11133778},
  ISSN={2637-9430},
  month={Aug},}@INPROCEEDINGS{11389970,
  author={Yuan, Xue and Wang, Shu and Han, Lina},
  booktitle={2025 8th International Conference on Data Science and Information Technology (DSIT)}, 
  title={A Meteorological Prediction Model Based on Spatio-Temporal Graph Neural Networks and Meta-Model}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Accurate meteorological forecasting can mitigate the impact of disasters and associated losses, and is of paramount importance for government decisionmaking and public safety. However, conventional methods struggle in regions with high climate variability. To address this issue, this study proposes a hybrid deep learning framework named TTAMLP-Meta(TCNTransformer-STGCN+AttentionMLP+Meta). This method integrates multiple forecasting methodologies to enhance predictive performance. It significantly improves spatio-temporal feature extraction within meteorological environments. By merging spatial feature extraction with long-term temporal modeling capabilities, the framework effectively captures dynamic correlations across multidimensional climate data. The attention mechanism enables the model to concentrate on critical meteorological patterns. Furthermore, a multi-model prediction fusion strategy leverages complementary information among different forecast outputs. This integration significantly enhances prediction accuracy and operational reliability. By combining these approaches, the framework improves both interpretability and performance in complex forecasting tasks. The model was subsequently validated using climate data from Gansu Province, China, a region known for its significant climatic diversity. The results clearly show that the method not only boosts predictive precision in areas with high climate variability but also significantly strengthens the ability to model complex spatio-temporal relationships.},
  keywords={Deep learning;Accuracy;Climate variability;Weather forecasting;Predictive models;Feature extraction;Data models;Graph neural networks;Reliability;Forecasting;Deep learning;Graph Neural Network;MetaModel;Meteorological prediction},
  doi={10.1109/DSIT67006.2025.11389970},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10893368,
  author={Kurdekar, Arpita and Burkey, Daniel and Young, Michael F.},
  booktitle={2024 IEEE Frontiers in Education Conference (FIE)}, 
  title={Innovation Unleashed: A Qualitative Study on Nurturing Creativity through Virtual Reality and Integrated Engineering and Visual Arts Education}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={This research category full paper is about a study that investigates the integration of virtual reality (VR) technology to enhance creativity in a multidisciplinary design context, merging engineering and visual arts education. By immersing students in a VR learning environment, it explores how this approach positively influences creativity, breaking down traditional educational silos and providing a blueprint for incorporating A (art) into STEM (science, technology, engineering, mathematics) education - STEAM. Addressing the global imperative for creativity for problem-solving, the study systematically integrates teaching creativity into education using VR technology and blended curricula. The research investigates factors contributing to embodiment, flow state, and intrinsic motivation experienced during multidisciplinary VR learning. Methodologically, a fully immersive VR environment guided by constructivist learning theory was developed, and 7 undergraduate students from civil, mechanical, and multidisciplinary engineering participated in (virtual) hands-on activities focused on building kinetic sculptures in the developed VR environment using HTC Vive. Based on the participants' experiences, preliminary findings from qualitative interviews indicated positive influences on creative performance, with heightened embodiment, flow, and intrinsic motivation observed among participants. Beneficial outcomes included knowledge gain, enhanced creativity expression through active project-based learning, and recognition of connections between engineering and art fields. Despite challenges like equipment learning curves and stress impact, these findings lay the groundwork for innovative STEAM and VR pedagogy, offering insights for further quantitative/ qualitative studies and advancing creativity development in engineering education.},
  keywords={Surveys;Visualization;Technological innovation;Art;Instruments;Education;Virtual reality;Creativity;Stress;STEM;virtual reality;multidisciplinary design;creativity;STEM;flow state;intrinsic motivation},
  doi={10.1109/FIE61694.2024.10893368},
  ISSN={2377-634X},
  month={Oct},}@INPROCEEDINGS{11012009,
  author={Xu, Feiyang and Wang, Ziping and Jin, Baisuo and Li, Zhongjie and Li, Xin and Li, Yunxia},
  booktitle={2024 12th International Conference on Bioinformatics and Computational Biology (ICBCB)}, 
  title={Comprehensive Evaluation Index System for Multi-Dimensional Cognitive Impairment Screening}, 
  year={2024},
  volume={},
  number={},
  pages={107-112},
  abstract={Alzheimer's disease is a cognitive disorder, which is more common in the elderly. With the increasing number of the elderly, it is quite necessary to screen the cognitive impairment of the elderly. Compared with the conventional, more laborious single-task methods, we have merged multiple speaking tasks including Picture Description Task (PDT), Five-Word Test (FWT), and Clock Drawing Test (CDT). This integration allows for extracting 319 pertinent features from subjects' vocal output, ASR transcribed texts, and track maps. Subsequently, we screened these features and determined their weights, culminating in the development of a comprehensive evaluation index system. This system includes dimensions of language, memory, execution and visual-spatial, is designed to examine the cognitive ability of the subjects. The F1 value of the binary classification task of healthy control (HC) people and patients with cognitive impairment (CI) was 80.86%, which increased by 1.57% compared with the other best method XGBoost. With our comprehensive evaluation index system, we can more comprehensively and quickly carry out early cognitive impairment screening and clinical research.},
  keywords={Accuracy;Feature extraction;Visual effects;Data models;Cognition;Indexes;Data mining;Older adults;Alzheimer's disease;Computational biology;comprehensive evaluation index system;multidimensional;cognition;Alzheimer's disease},
  doi={10.1109/ICBCB61507.2024.11012009},
  ISSN={},
  month={March},}@INPROCEEDINGS{10493232,
  author={Mubeena, S and Jawahar, P. K},
  booktitle={2024 Second International Conference on Emerging Trends in Information Technology and Engineering (ICETITE)}, 
  title={Analyzing Computational Performance of Blockchain and Internet of Things in Healthcare}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={In recent years, blockchain networks have expanded their relevance beyond cryptocurrency applications. The integration of blockchain and the Internet of Things (IoT) has gained considerable attention. This merge leverages blockchain's features, such as decentralization, immutability, and traceability to bolster IoT system security, introducing the concept of “BIo'T.” This paper offers an updated review of blockchain technology's recent advancements and its wide-ranging applications. It starts with a primer on blockchain and IoT, highlighting their real-world implementations. The paper also explores ongoing work within data security, with a focus on healthcare systems where blockchain plays a vital role. The critical assessment of the current state of blockchain technology is made by emphasizing its computational speed, which is particularly pertinent in healthcare applications, where efficiency is crucial. In conclusion, the paper not only summarizes the current landscape but also identifies research challenges and future directions to encourage further exploration in this promising field.},
  keywords={Industries;Reviews;Data security;Medical services;Market research;Blockchains;Cryptocurrency;Internet of Things (IoT);Blockchain;BIoT;Hyperledger;eClinical;Data security;Authentication},
  doi={10.1109/ic-ETITE58242.2024.10493232},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11176534,
  author={Mahajaishree, R and Dhanalakshmi, M and Karthiha, K and Eswaramoorthy, K and Veni, S H.Krishna and Umamaheswari, S.},
  booktitle={2025 8th International Conference on Circuit, Power & Computing Technologies (ICCPCT)}, 
  title={Enhancing Accessibility in Banking Services for Visually Impaired Users Using Deep Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1926-1931},
  abstract={An innovative solution designed to enhance banking accessibility for visually impaired individuals by combining handwritten recognition technology with a talkback system. The integration of these technologies addresses the significant barriers that visually impaired people face in digital banking, offering a more inclusive approach. Handwritten recognition allows users to input information via handwriting, which is then interpreted by advanced machine learning algorithms, while the talkback system provides auditory feedback, guiding users through banking processes with voice commands. The role of Convolutional Neural Networks (CNNs) is crucial in this setup. CNNs, a class of deep learning models, are exceptionally proficient in processing and recognizing image-based data, including handwritten inputs. These networks analyze the strokes and patterns of handwriting, translating them into digital text that the banking system can understand. This capability is complemented by natural language processing and speech synthesis technologies that power the talkback system. By merging these advanced technologies, the proposed solution not only aims to empower visually impaired individuals with greater financial independence but also promotes broader inclusion within the digital banking landscape.},
  keywords={Deep learning;Handwriting recognition;Accuracy;Translation;Visual impairment;Banking;Speech recognition;Natural language processing;Text to speech;Convolutional neural networks;Digital Banking;Convolution Neural network;Visually Impaired Users;Deep Learning},
  doi={10.1109/ICCPCT65132.2025.11176534},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10851102,
  author={Belguechi, Rima Ouidad and Rosenberger, Christophe},
  booktitle={2024 1st International Conference on Electrical, Computer, Telecommunication and Energy Technologies (ECTE-Tech)}, 
  title={A Comprehensive Comparison of CNN-Based Deep Learning Architectures for Fingerprint Authentication}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This study explores the integration of CNNs in fingerprint biometric systems, tackling the primary challenge of biometric authentication by accurately matching similar pairs while discarding the dissimilar ones. Three different deep learning frameworks are compared. The first model employs custom CNN-based classification model. The second includes transfer learning approach from the VGG-16 network, while the third implements an image similarity learning strategy based on merging CNN sub-networks. To increase confidence in the results, we assess the models using unlabeled data, providing a more accurate representation of the impostor distribution. In contrast to both the first and second models, the third model achieves a competitive EER score of 1.7%, highlighting an effective strategy for authentication with CNN-driven biometric systems.},
  keywords={Deep learning;Accuracy;Biological system modeling;Computational modeling;Transfer learning;Authentication;Fingerprint recognition;Biometric authentication;Data models;Similarity learning;Biometrics;Fingerprint authentication;deep learning;CNN},
  doi={10.1109/ECTE-Tech62477.2024.10851102},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11507913,
  author={R.Velvizhi and Reddy, Mallidi Sai Krishna and Srujan, Vechham Shivaram and Nair, Manju C and Dharani, V},
  booktitle={2026 International Conference on Smart Futuristic Technology}, 
  title={Advanced U-Net Framework for Multi-Modal Brain Tumor Segmentation and Interactive Clinical Visualization}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper presents a new architectural deep learning model of automated brain tumor segmentation that merges the precision modeling with the real-time clinical utility. This system takes advantage of an optimized U-Net architecture with adaptive multimodal fusion to detect and delineate various tumor subregions in scans of magnetic resonance images. An elegant preprocessing and normalisation pipeline will guarantee homogeneous anatomical representation whereas the network will use a high-tech learning-rate normalisation and multi-metric assessment to improve segmentation stability and readability. Notably, this study achieves the connection between algorithmic intelligence and human-oriented design by providing an interactive inference interface, within which clinicians can visualize, manipulate, and interpret the results of segmentation in a direct manner. Through the combination of deep learning efficiency with the ability to control user-related data, the suggested system would turn the traditional segmentation into a smooth, usable, and repeatable process of diagnostic results. The strategy shows a great potential of expediting radiological processes and increasing the intelligent neuro-oncological instruments to clinical integration.},
  keywords={Modeling;Tumors;Visualization;Training;Brain tumors;Magnetic resonance imaging;Dies;Optimization;Manuals;Timing;Brain Tumor Segmentation;Deep Learning;Multimodal MRI;U-Net;Adaptive Learning;Medical Image Analysis;Clinical Interface;Human–AI Collaboration;Real-Time Segmentation;Neuro-Oncology},
  doi={10.1109/ICSFT66733.2026.11507913},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11400109,
  author={Queiroz-Neto, José P. and Nascimento, José F. L. and Gouvea, Nelson A. and Júnior, José C. Lacerda and Rodrigues, Marlos A. S. and Carvalho, Dominique V.},
  booktitle={2025 IEEE 14th International Conference on Engineering Education (ICEED)}, 
  title={Building Competencies for Industry 4.0: Integrated Approach Using Competency-Based, Project-Based, and Design Thinking Methods in Applied Industrial Robotics}, 
  year={2025},
  volume={},
  number={},
  pages={132-137},
  abstract={This work presents the integration of Competency-Based Learning (CBL), Project-Based Learning (PBL), and Design Thinking (DT) as a methodology to develop both hard and soft skills, as well as competencies, in the field of automation engineering. In response to the government's limited investment in education and technology, LG Electronics and IFAM launched a project aimed at training engineering students in industrial robotics. The integrated CBL/PBL/DT methodology merges educational and industrial innovation practices by following the principles of active learning and involves practical classes conducted in both a university and a factory setting, with students organized into two groups of 15. The results demonstrate the significant potential of these integrated methods, as they successfully achieved the project's proposed objectives.},
  keywords={Training;Technological innovation;Service robots;Design methodology;Buildings;Active learning;Production facilities;Fourth Industrial Revolution;Engineering students;Investment;competency-based learning;Industrial Robotics;Academic-industrial partnership},
  doi={10.1109/ICEED66794.2025.11400109},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11013209,
  author={Sudhakar, A. and Nandini, Dirisala Chaitanya and Bhavani, Pingala Ganga and Priyanka, Lamu Lakshmi},
  booktitle={2025 8th International Conference on Trends in Electronics and Informatics (ICOEI)}, 
  title={Hybrid Crime Prediction Using GRU and ARIMAX Models}, 
  year={2025},
  volume={},
  number={},
  pages={1510-1516},
  abstract={Crime prediction and analysis are crucial for enhancing public safety and optimizing law enforcement strategies. This paper proposes a hybrid crime forecasting framework that integrates deep learning and statistical modeling to analyze crime patterns across Indian states and districts. The approach combines a Bidirectional Gated Recurrent Unit (GRU) model and Seasonal Auto-Regressive Integrated Moving Average with Exogenous Variables (SARIMAX) to leverage historical crime data spanning 12 years. The GRU model effectively captures long-term temporal dependencies and complex patterns, while SARIMAX incorporates historical trends and seasonal variations. Their predictions are merged through a weighted hybrid model to enhance forecasting accuracy. To improve predictive performance, feature engineering techniques such as cyclical encoding and MinMax scaling are applied to preprocess temporal and numerical data. The model demonstrates its effectiveness in predicting crime distributions across 30+ categories, including violent crimes, property crimes, and other offenses. Performance is evaluated using Mean Absolute Error (MAE), Mean Squared Error (MSE), and $R^{2}$ Score, ensuring robust validation. Additionally, visualization tools provide intuitive insights into predicted crime trends, aiding policymakers and law enforcement agencies in resource allocation and preventive measures. This study introduces a novel integration of deep learning and statistical models for crime prediction, offering a data-driven decision-support system to address a critical societal challenge in predictive analytics.},
  keywords={Deep learning;Analytical models;Law enforcement;Predictive models;Market research;Public security;Numerical models;Resource management;Forecasting;Predictive analytics;Crime Prediction;Crime Analysis;Hybrid Model;Bidirectional GRU;SARIMAX;Machine Learning;Predictive Analytics;Temporal Data;Crime Trends;Deep Learning;Feature Engineering;Law Enforcement;Public Safety;Resource Allocation;Crime Forecasting},
  doi={10.1109/ICOEI65986.2025.11013209},
  ISSN={},
  month={April},}@INPROCEEDINGS{11120758,
  author={Fan, Yuhe and Zhang, Lixun and Wang, Keyi and Liu, Yi and Li, Jinghang and Wang, Zhenhan and Xue, Feng and Che, Huaiyu},
  booktitle={2025 IEEE International Conference on Mechatronics and Automation (ICMA)}, 
  title={An Integrated Neural Network Model for Classifying Dysphagia Intensity from Facial Expressions}, 
  year={2025},
  volume={},
  number={},
  pages={511-515},
  abstract={Facial dysphagia intensity classification is an important technique in the fields of human-robot interaction of intelligent meal-assisting robotics. However, traditional single deep neural network models struggle to capture subtle facial changes and sequential information, hindering accurate hierarchical classification of dysphagia intensity levels. This paper presents an integrated neural network model (INNM) which combines the feature extraction abilities of convolutional neural networks (CNN) and the sequential comprehension of bidirectional long short-term memory networks (BiLSTM). The INNM comprises a feature extraction network and a converged CNN-ConvBiLSTM network. In the feature extraction phase, we enhance the YOLOv8s-cls architecture by integrating deformable convolutions to better capture fine spatial details of facial expressions. Furthermore, we incorporate the CloFormer attention mechanism to effectively perceive both local high-frequency and global low-frequency information. In the converged CNN-ConvBiLSTM network, we develop an algorithm that merges a triple-layer hybrid CNN with ConvBiLSTM, utilizing a jumping-connection strategy to bolster the capacity for memorizing long-term and short-term sequences while enhancing spatial information integration. Extensive experiments reveal that the INNM significantly outperforms baseline models and current state-of-the-art methods in dysphagia intensity classification, achieving remarkable accuracy. Ablation studies further validate the effectiveness of each enhancement.},
