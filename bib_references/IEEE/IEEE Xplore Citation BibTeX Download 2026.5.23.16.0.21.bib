  abstract={The presentation of slides shows the Chinese DTTB standard. In August 2006, the merged standard called "Frame structure, channel coding and modulation for digital television terrestrial broadcasting system - GB20600-2006" was issued. It contains both single carrier and multi-carrier options. And supports various multiprogram SDTV/HDTV terrestrial broadcasting services. It was mandatory on August 1st, 2007.},
  keywords={Communication system security;Protocols;Risk analysis;Information security;Copyright protection;Robustness;Sections;Jacobian matrices;Global communication;Watermarking},
  doi={10.1109/ISBMSB.2009.5133756},
  ISSN={2155-5052},
  month={May},}@INPROCEEDINGS{4634262,
  author={Chinellato, Eris and Grzyb, Beata J. and del Pobil, Angel P.},
  booktitle={2008 IEEE International Joint Conference on Neural Networks (IEEE World Congress on Computational Intelligence)}, 
  title={Brain mechanisms for robotic object pose estimation}, 
  year={2008},
  volume={},
  number={},
  pages={3268-3275},
  abstract={Integration of multiple visual cues provides natural systems with superior abilities in dealing with nearby objects. This research is aimed at verifying if robotic systems could also benefit from the merging of different visual cues of the same stimulus. A computational model of stereoscopic and perspective orientation estimators, merged according to different criteria, is implemented on a robotic setup and tested in different conditions. Experimental results suggest that the principle of cue integration can make robot sensory systems more reliable and robust. The same results compared with data from human studies show that the model is able to reproduce some well-known neuropsychological effects.},
  keywords={Estimation;Distance measurement;Robots;Visualization;Computational modeling;Retina;Reliability},
  doi={10.1109/IJCNN.2008.4634262},
  ISSN={2161-4407},
  month={June},}@INBOOK{8506001,
  author={Jurgen, Ronald},
  booktitle={Autonomous Vehicles for Safer Driving}, 
