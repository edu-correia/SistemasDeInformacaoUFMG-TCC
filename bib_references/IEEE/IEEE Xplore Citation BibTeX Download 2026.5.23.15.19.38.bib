  month={Nov},}@INPROCEEDINGS{1341111,
  author={Lezoray, O.},
  booktitle={Proceedings of the 3rd IEEE International Symposium on Signal Processing and Information Technology (IEEE Cat. No.03EX795)}, 
  title={Unsupervised 2D multiband histogram clustering and region for color image segmentation}, 
  year={2003},
  volume={},
  number={},
  pages={267-270},
  abstract={A segmentation method for color images is presented in this work. A morphological unsupervised 2D multiband histogram clustering provides an initial segmentation of the image. Region information is then used and a novel technique is introduced to simplify the region adjacency graph by merging candidate regions until the stabilization of a "good" segmentation criterion. Merged regions are refined by a color watershed. The whole method requires the definition of only one single parameter which acts as a multiscale parameter.},
  keywords={Histograms;Merging;Image segmentation;Roentgenium;Image color analysis;Image edge detection;Filtering;Digital images;Image databases;Image coding},
  doi={10.1109/ISSPIT.2003.1341111},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{4108783,
  author={Takatsuka, Hiromasa and Tanaka, Masayuki and Okutomi, Masatoshi},
  booktitle={2006 SICE-ICASE International Joint Conference}, 
  title={Spatial Merging for Face Detection}, 
  year={2006},
  volume={},
  number={},
  pages={5587-5592},
  abstract={Face detection is a useful technique in computer vision. Many face detectors have been developed in the literature. These detectors to evaluate a face likelihood of a given sub-window. The sub-window must be scanned through an input image to detect faces. Since the detectors evaluate the scanned sub-windows independently, non-faces with high face likelihood are often misdetected. In this paper, we propose a novel face detection algorithm which explicitly uses difference of face likelihood distribution between faces and non-faces. The proposed algorithm can correctly classify the non-faces misdetected by the existing algorithm. The face likelihood distribution is generated and integrated to emphasize the difference between faces and non-faces. Experiments with pre-scanned data set and real-world images show that the proposed algorithm improves the detection rate approximately 20% and 10%, respectively},
  keywords={Merging;Face detection;Detectors;Computer vision;Object detection;Surveillance;Biometrics;Neural networks;Training data;Web sites;face detection;object detection;AdaBoost;merging algorithm},
  doi={10.1109/SICE.2006.315782},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{8393293,
  author={Zhu, Tingting and Peng, Manman},
  booktitle={2017 13th International Conference on Natural Computation, Fuzzy Systems and Knowledge Discovery (ICNC-FSKD)}, 
  title={A two-stage hierarchical community structure detected algorithm in complex network}, 
  year={2017},
  volume={},
  number={},
  pages={353-359},
  abstract={Series of algorithms have been devised in detecting community. To make the detected community structure match better with the real network, we propose a new hierarchical community detection algorithm called Perm-Mod. The algorithm includes two stages. In the first stage, using the heuristic method, we optimize an objective function. When the function achieves maximum value, a few small communities are precisely detected. In the second stage, we estimate whether the network has community structure based on the maximum value. If yes, we merge the above small communities. Compared to other algorithms, our algorithm solves three problems at the same time: (i) we estimate whether the network has community structure (ii) the community structure found by our algorithm matches well with the ground-truth network and (iii) the process of merging reflects the hierarchy.},
  keywords={Linear programming;Complex networks;Detection algorithms;Merging;Heuristic algorithms;Image edge detection;Measurement;network;community structure;two stage;Perm-Mod;objective function;hierarchy},
  doi={10.1109/FSKD.2017.8393293},
  ISSN={},
  month={July},}@INPROCEEDINGS{7950254,
  author={Xing, Huanlai and Song, Fuhong and Wang, Zhaoyuan and Li, Tianrui and Yang, Yan},
  booktitle={2016 12th International Conference on Mobile Ad-Hoc and Sensor Networks (MSN)}, 
  title={On Minimizing Network Coding Resource: A Modified Particle Swarm Optimization Approach}, 
  year={2016},
  volume={},
  number={},
  pages={330-334},
  abstract={This paper studies the problem of how to efficiently minimize network coding resource. A modified particle swarm optimization (PSO) algorithm is proposed to tackle the problem, with the concept of path-relinking (PR) integrated into the evolutionary framework. As an efficient local search heuristic that makes use of problem-specific domain knowledge, PR helps strike a better balance between global exploration and local exploitation for the evolutionary search. Simulation results demonstrate that the proposed algorithm overweighs a number of existing and commonly used evolutionary algorithms (EAs) in terms of the solution quality, convergence, and computational time.},
  keywords={Sociology;Statistics;Encoding;Merging;Network coding;Optimization;Particle swarm optimization;multicast;network coding;particle swarm optimization;path relinking},
  doi={10.1109/MSN.2016.060},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{1499559,
  author={Li Li and Hong Chen and Jinfa Wang and Qiuxun Xu},
  booktitle={Proceedings of ICSSSM '05. 2005 International Conference on Services Systems and Services Management, 2005.}, 
  title={Military supply chain integration}, 
  year={2005},
  volume={1},
  number={},
  pages={674-679 Vol. 1},
  abstract={Military supply chain management is a brand-new subject. In a series of theoretical questions needing to be answered, it is one of the key problems how to realize the synchronization and coordination of the nodes in military supply chain. To integrate military supply chain is a feasible way to solve this problem. This paper thinks that military supply chain integration can be considered from three respects, the vertical integration, the horizontal integration and the information integration. The goal, content and research approaches of these three kinds of integration are discussed in this paper separately.},
  keywords={Supply chains;Logistics;Supply chain management;Technology management;Manufacturing;Merging;Globalization;Psychology;Management information systems;Modems},
  doi={10.1109/ICSSSM.2005.1499559},
  ISSN={2161-1904},
  month={June},}@INPROCEEDINGS{6153233,
  author={Shah, D. U. and Vithlani, C. H.},
  booktitle={2011 Nirma University International Conference on Engineering}, 
  title={FPGA realization of DA-based 2D-Discrete Wavelet Transform for the proposed image compression approach}, 
  year={2011},
  volume={},
  number={},
  pages={1-6},
  abstract={The lack of disk space seems to be a major challenge during transmission and storage of raw images, which in turn pushes the demand for an efficient technique for compression of images. Although, lot of compression techniques are available today, any upcoming technique which is faster, memory efficient and simple surely has the greatest probability to hit the user requirements. In this paper, we have developed wavelet-based image compression algorithm using well-known Distributed Arithmetic (DA) technique. Here, to increase the compression rate, the reduction of wavelet coefficients is carried out in each level of computation with the help of RW block proposed in the paper. After computing the DWT coefficients, we apply DPCM (Differential pulse-code modulation) which is a transformation technique for increasing the compressibility of an image. Finally, the transformed coefficients are given to Huffman-encoder that is designed by merging the lowest probable symbols in such a way that, the images will get compressed. For decompression, the Huffman decoding procedure is applied in the compressed image. Furthermore, the inverse DPCM and inverse DWT is applied on the decoded data to obtain the decompressed image. For implementation, the DA-based wavelet is simulated in Active HDL tool and the final design is verified with verilog test benches.},
  keywords={Image coding;Computer architecture;Discrete wavelet transforms;Wavelet coefficients;Hardware design languages;Very large scale integration;Differential Pulse-Code Modulation (DPCM);Discrete Wavelet Transform;Distributed Arithmetic;Huffman-coding;Image compression},
  doi={10.1109/NUiConE.2011.6153233},
  ISSN={2375-1282},
  month={Dec},}@INPROCEEDINGS{1493431,
  author={Rong He and Xuming Fang},
  booktitle={Proceedings. 2005 International Conference on Communications, Circuits and Systems, 2005.}, 
  title={A scatternet formation algorithm for dynamic multi-hop environments}, 
  year={2005},
  volume={1},
  number={},
  pages={388-391 Vol. 1},
  abstract={Scatternet formation is an open issue, which is not specified in the Bluetooth system specifications. The paper presents an efficient distributed scatternet topology formation algorithm - DMSFA (dynamic multi-hop scatternet formation algorithm). Unlike earlier work, our protocol is designed to work well within multi-hop dynamic environments where nodes may arrive and leave arbitrarily. DMSFA works in a completely distributed mode, and connects nodes in a tree structure which simplifies packet routing and scheduling significantly. DMSFA adopts several methods to avoid producing self-loops or multi-hop loops, which is very important for a tree structure. Besides, DMSFA detects link connection periodically to heal possible partitions automatically. Finally, simulation results are provided which evaluate the performance of the protocol.},
  keywords={Scattering;Heuristic algorithms;Protocols;Topology;Bluetooth;Tree data structures;Personal area networks;Spread spectrum communication;Routing;Merging},
  doi={10.1109/ICCCAS.2005.1493431},
  ISSN={},
  month={May},}@ARTICLE{5506001,
