  abstract={This paper extends some first steps given in merging radar and rain gauge data for a better understanding of rainfall rate spatial structure. The study has been performed analyzing spatial correlation between sites within a densely meshed rain gauge network and also with their corresponding pixels in weather radar images.},
  keywords={Rain;Radar;Correlation;Radar imaging;Meteorological radar;Meteorology;Pixel;weather radar;rain gauges;rainfall spatial model;spatial correlation},
