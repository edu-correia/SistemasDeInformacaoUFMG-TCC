  author={Fang, Borui and Chen, Li and Wang, Weidong},
  booktitle={2024 16th International Conference on Wireless Communications and Signal Processing (WCSP)}, 
  title={Merged-r Luby Transform Coded Computation for Non-Linear Tasks in Wireless Networks}, 
  year={2024},
  volume={},
  number={},
  pages={30-35},
  abstract={Coded computation has garnered considerable attention for its ability to eliminate the stragglers' effect. Most existing works of coded computation are designed for linear tasks. They cannot handle the nonlinear tasks directly, leading to high computation, transmission and decoding latency. In this paper, considering a nonlinear task in wireless networks, we propose an efficient merged-r Luby transform (LT) coded computation scheme. First, we give the merged-r LT coding strategy to reduce the computation and transmission costs. Then, the maximum degree decoding (MDD) strategy is proposed to speed up the decoding process. Finally, we analyze and optimize the latency performance for the whole network by designing the merging parameter. Theoretical analysis and simulation results show that our proposed scheme has significant advantages over the existing ones for nonlinear tasks.},
  keywords={Costs;Upper bound;Wireless networks;Simulation;Merging;Transforms;Signal processing;Encoding;Decoding;Low latency communication;Coded computation;maximum degree decoding;merged-r LT coding;nonlinear tasks;wireless networks},
  doi={10.1109/WCSP62071.2024.10827212},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9412879,
  author={Flood, Gabrielle and Gillsjö, David and Persson, Patrik and Heyden, Anders and Åström, Kalle},
  booktitle={2020 25th International Conference on Pattern Recognition (ICPR)}, 
  title={Generic Merging of Structure from Motion Maps with a Low Memory Footprint}, 
  year={2021},
  volume={},
  number={},
  pages={4385-4392},
  abstract={With the development of cheap image sensors, the amount of available image data have increased enormously, and the possibility of using crowdsourced collection methods has emerged. This calls for development of ways to handle all these data. In this paper, we present new tools that will enable efficient, flexible and robust map merging. Assuming that separate optimisations have been performed for the individual maps, we show how only relevant data can be stored in a low memory footprint representation. We use these representations to perform map merging so that the algorithm is invariant to the merging order and independent of the choice of coordinate system. The result is a robust algorithm that can be applied to several maps simultaneously. The result of a merge can also be represented with the same type of low-memory footprint format, which enables further merging and updating of the map in a hierarchical way. Furthermore, the method can perform loop closing and also detect changes in the scene between the capture of the different image sequences. Using both simulated and real data — from both a hand held mobile phone and from a drone — we verify the performance of the proposed method.},
  keywords={Structure from motion;Statistical analysis;Merging;Memory management;Tools;Robustness;Mobile handsets},
  doi={10.1109/ICPR48806.2021.9412879},
