  title={Tracking of Spline Modeled Extended Targets Using a Gaussian Mixture PHD Filter}, 
  year={2019},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper presents the integration of a spline based extension model into a probability hypothesis density (PHD) filter for extended targets. Using this filter the position and extension of each object as well as the number of present objects can jointly be estimated. Therefore, the spline extension model and the PHD filter are addressed and merged in a Gaussian mixture (GM) implementation. Simulation results using artificial laser measurements are used to evaluate the performance of the presented filter. Finally, the results are illustrated and discussed.},
