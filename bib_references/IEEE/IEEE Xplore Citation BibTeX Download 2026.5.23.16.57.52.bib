  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Detached eclipsing binaries in compact hierarchical triples: triple-lined systems BD+442258 and KIC 06525196}, 
  year={2022},
  volume={521},
  number={2},
  pages={1908-1923},
  abstract={Compact hierarchical triples (CHTs) are systems with the tertiary star orbiting the inner binary in an orbit shorter than 1000 d. CHT with an eclipsing binary as its inner binary can help us extract a multitude of information about all three stars in the system. In this study, we use independent observational techniques to estimate the orbital, stellar, and atmospheric parameters of two triple-lined CHT: BD+44 2258 and KIC 06525196. We find that the masses of stars in BD+44 2258 are $1.011\pm 0.029$, $0.941\pm 0.033$, and $0.907\pm 0.065 \, {\rm M}_{\odot }$ while in KIC 06525196 the estimated masses are $1.0351\pm 0.0055$, $0.9712\pm 0.0039 $, and $0.777\pm 0.012 \, {\rm M}_{\odot }$. Using spectral disentangling, we obtained individual spectra of all the stars and combined it with light-curve modelling to obtain radii, metallicities, and temperatures. Using stellar evolution models from MESA, we constrain the log(age) of BD+44 2258 to be 9.89 and 9.49 for KIC 06525196. Two stars in BD+44 2258 are found to be sub-giants while all three stars in KIC 06525196 are main-sequence stars. We constrain the mutual inclinations to certain angles for BD+44 2258 and KIC 06525196 using numerical integration. Integrating with tidal interaction schemes and stellar evolution models, we find that KIC 06525196 is a stable system. But the inner binary of BD+44 2258 merges within 550 Myr. The time of this merger is affected by the orientation of the tertiary, even rushing the collapse by ∼100 Myr when the mutual inclination is close to 90○.},
  keywords={binaries: eclipsing;binaries: spectroscopic;stars: evolution;stars: fundamental parameters;stars: individual: BD+44 2258;KIC 06525196;stars: kinematics and dynamics},
  doi={10.1093/mnras/stad622},
  ISSN={1365-2966},
  month={Dec},}@INPROCEEDINGS{11423822,
  author={Mohan, Adithya and Rößle, Dominik and Cremers, Daniel and Schön, Torsten},
  booktitle={2025 IEEE 28th International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={Advancing Robustness in Deep Reinforcement Learning with an Ensemble Defense Approach}, 
  year={2025},
  volume={},
  number={},
  pages={878-883},
  abstract={Recent advancements in Deep Reinforcement Learning (DRL) have demonstrated its applicability across various domains, including robotics, healthcare, energy optimization, and autonomous driving. However, a critical question remains: How robust are DRL models when exposed to adversarial attacks? While existing defense mechanisms such as adversarial training and distillation enhance the resilience of DRL models, there remains a significant research gap regarding the integration of multiple defenses in autonomous driving scenarios specifically. This paper addresses this gap by proposing a novel ensemble-based defense architecture to mitigate adversarial attacks in autonomous driving. Our evaluation demonstrates that the proposed architecture significantly enhances the robustness of DRL models. Compared to the baseline under FGSM attacks, our ensemble method improves the mean reward from 5.87 to 18.38 (over 213% increase) and reduces the mean collision rate from 0.50 to 0.09 (an 82% decrease) in the highway scenario and merge scenario, outperforming all standalone defense strategies.},
  keywords={Training;Road transportation;Perturbation methods;Scalability;Deep reinforcement learning;Robustness;Autonomous vehicles;Robots;Optimization;Resilience},
  doi={10.1109/ITSC60802.2025.11423822},
  ISSN={2153-0017},
  month={Nov},}@INPROCEEDINGS{11066289,
  author={Bertolasi, Jessica and Garcia Hernandez, Nadia Vanessa and Gori, Monica},
  booktitle={2025 IEEE Medical Measurements & Applications (MeMeA)}, 
  title={Assessing Human Size Perception in Real and Mixed-Reality Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Mixed Reality (MR) technologies are becoming increasingly prevalent across various domains, including medical education, the automotive industry, and aerospace engineering. These systems allow for the integration of virtual objects into real- world scenarios, creating immersive and interactive environments. However, despite their widespread adoption, relatively little is known about how humans perceive subtle variations in the size of virtual objects when merged with real-world contexts, particularly in comparison to real physical objects. Understanding these perceptual differences is essential for identifying potential limitations of MR systems and optimizing their effectiveness in precision-critical applications. This study aimed to investigate human size perception within an MR environment using the HoloLens 2 headset, specifically assessing how accurately individuals can discriminate object size at different distances. To achieve this, a psychophysical experiment was conducted employing a two-alternative forced- choice (2AFC) paradigm to measure size discrimination thresholds. Participants were asked to compare real and virtual spheres presented at two different distances, allowing researchers to determine whether MR technology alters size perception relative to real-world conditions. The findings revealed that size discrimination accuracy for virtual objects in MR was highly comparable to that of real objects. This suggests that the HoloLens 2 effectively preserves size-related perceptual cues, ensuring reliable spatial judgments. These results validate the use of MR for applications requiring precise size perception, reinforcing its potential for medical simulations, industrial training, and psychophysical research. The study highlights the robustness of MR in maintaining perceptual fidelity, confirming its viability as a tool for experimental and professional applications where accurate object perception is essential.},
  keywords={Visualization;Accuracy;Surgery;Mixed reality;Virtual reality;Size measurement;Software;Robustness;Psychophysics;Visual perception;human perception;mixed reality environment;visual size perception;HoloLens2;perceptual equivalence},
  doi={10.1109/MeMeA65319.2025.11066289},
