  month={June},}@INPROCEEDINGS{10917864,
  author={Prutphongs, Ponrapee and Kataoka, Yuto and Hara, Motoaki and Iwami, Kentaro},
  booktitle={2025 IEEE 38th International Conference on Micro Electro Mechanical Systems (MEMS)}, 
  title={Merging Mems Vapor Cells with Metasurfaces for Next-Gen Chip-Scale Atomic Clocks}, 
  year={2025},
  volume={},
  number={},
