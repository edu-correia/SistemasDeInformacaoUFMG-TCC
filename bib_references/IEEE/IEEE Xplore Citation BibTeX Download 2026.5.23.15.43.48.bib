  keywords={Method of moments;Integral equations;Convergence;Matrix decomposition;Linear systems;Tin;Accuracy;Integral equations;Domain-Decomposition;Tear-and-Interconnect;Preconditioning;Fast solvers;Moment methods;Domain decomposition (DD);fast solvers;integral equations;moment methods;preconditioning;tear-and-interconnect},
