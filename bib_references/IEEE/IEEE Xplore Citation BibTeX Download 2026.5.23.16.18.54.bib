  isbn={9780768091960},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/8859054},}@INPROCEEDINGS{11346215,
  author={Sarumathi, S. and Gokila, R and Maghaaswanth, M S},
  booktitle={2025 10th International Conference on Smart Structures and Systems (ICSSS)}, 
  title={Automated Bird Species Recognition with Transformer Architectures}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={For ecological research, conservation, and biodiversity monitoring, accurate bird species identification is essential. However, when species exhibit similar visual characteristics or overlapping sound patterns, manual identification is slow, dependent on knowledge, and frequently wrong. In order to overcome these constraints, this research presents an improved Automated Bird Species Recognition Framework that uses Transformer-based encoders to combine aural and visual data. While an Audio Spectrogram Transformer (AST) analyzes the temporal-spectral aspects of bird sounds, a Vision Transformer (ViT) extracts fine-grained visual data.The suggested approach uses a Cross-Attention Multi-Modal Fusion Transformer (CAMFT), which allows bidirectional interaction between visual and audio embeddings, to enhance traditional multimodal fusion. By aligning complementary cues across modalities, this crossattention mechanism creates a more reliable and discriminative classification representation. CAMFT provides a scalable, interpretable, and high-accuracy solution for automated bird species detection in real-world ecological situations. Experimental results on benchmark datasets demonstrate that CAMFT greatly outperforms singlemodality baselines and basic fusion techniques.},
  keywords={Visualization;Computer vision;Merging;Transformers;Birds;Robustness;Biodiversity;Usability;Monitoring;Spectrogram;Bird Species Recognition;Vision Transformer (ViT);Audio Spectrogram Transformer (AST);Cross-Attention Fusion;Multi-Modal Learning;Transformer Architectures;Biodiversity Monitoring},
  doi={10.1109/ICSSS66939.2025.11346215},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10312167,
  author={Senoo, Taku and Konno, Atsushi and Kishi, Norimasa},
  booktitle={IECON 2023- 49th Annual Conference of the IEEE Industrial Electronics Society}, 
  title={Virtual 3D Viewpoint Control Based on Integration of Around-View and Back-View Monitors}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper proposes a method of presenting intuitively easy-to-grasp images by merging the images of an around view monitor and a back-view monitor into a single image. In the proposed method, the viewpoint automatically changes as the vehicle moves, enabling the display of an overhead 3D image that always shows the vehicle. This video generation is composed of simple image deformation by projective transformation, which serves as a distortion correction as well as a viewpoint change. Experiments conducted in a parking situation showed that the system automatically switches the 3D viewpoint depending on the distance to the parking position to present an easy-to-understand image including the surrounding environment.},
  keywords={Industrial electronics;Three-dimensional displays;Deformation;Image synthesis;Merging;Distortion;Automobiles;Car monitor;Driving support;Parking interface;Viewpoint transformation;Image processing},
