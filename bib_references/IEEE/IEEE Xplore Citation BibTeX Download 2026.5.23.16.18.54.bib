  author={Luo, Zhaojing and Yeung, Sai Ho and Zhang, Meihui and Zheng, Kaiping and Zhu, Lei and Chen, Gang and Fan, Feiyi and Lin, Qian and Ngiam, Kee Yuan and Chin Ooi, Beng},
  booktitle={2021 IEEE 37th International Conference on Data Engineering (ICDE)}, 
  title={MLCask: Efficient Management of Component Evolution in Collaborative Data Analytics Pipelines}, 
  year={2021},
  volume={},
  number={},
  pages={1655-1666},
  abstract={With the ever-increasing adoption of machine learning for data analytics, maintaining a machine learning pipeline is becoming more complex as both the datasets and trained models evolve with time. In a collaborative environment, the changes and updates due to pipeline evolution often cause cumbersome coordination and maintenance work, raising the costs and making it hard to use. Existing solutions, unfortunately, do not address the version evolution problem, especially in a collaborative environment where non-linear version control semantics are necessary to isolate operations made by different user roles. The lack of version control semantics also incurs unnecessary storage consumption and lowers efficiency due to data duplication and repeated data pre-processing, which are avoidable.In this paper, we identify two main challenges that arise during the deployment of machine learning pipelines, and address them with the design of versioning for an end-to-end analytics system MLCask. The system supports multiple user roles with the ability to perform Git-like branching and merging operations in the context of the machine learning pipelines. We define and accelerate the metric-driven merge operation by pruning the pipeline search tree using reusable history records and pipeline compatibility information. Further, we design and implement the prioritized pipeline search, which gives preference to the pipelines that probably yield better performance. The effectiveness of MLCask is evaluated through an extensive study over several real-world deployment cases. The performance evaluation shows that the proposed merge operation is up to 7.8x faster and saves up to 11.9x storage space than the baseline method that does not utilize history records.},
  keywords={Performance evaluation;Data analysis;Pipelines;Semantics;Merging;Collaboration;Machine learning;Machine Learning Pipelines;Version Control Semantics;Scientific Data Management;Data Analytics},
  doi={10.1109/ICDE51399.2021.00146},
  ISSN={2375-026X},
  month={April},}@INPROCEEDINGS{10849294,
  author={Wei, Cong and Wei, Rongshan and Zhou, Qikun and Huang, Lijie and Lu, Xiaoqiang and Tan, Zhichao},
  booktitle={2024 31st IEEE International Conference on Electronics, Circuits and Systems (ICECS)}, 
  title={A Power-Area Efficient New Merged Capacitor Switching Scheme for SAR ADC}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={This article introduces a power-area efficient new merged capacitor switching (NMCS) scheme for successive approximation register (SAR) analog-to-digital converters (ADCs). It addresses the drawback of conventional CDAC switching schemes, where energy is consumed with each decision. In this scheme, energy is consumed during the first decision, no energy is consumed during the second decision, and energy is released during the remaining conversion process. Therefore, the scheme offers the advantage of low average switching energy. In addition, the largest capacitor supports weight configuration as MSB or MSB-1, which effectively reduces the total capacitance. The NMCS scheme has the power efficiency advantage of unidirectional switching and achieves constant common-mode voltage at the beginning and end of the conversion. Taking the example of 10-bit SAR ADC, the proposed NMCS scheme, when driving a single CDAC capacitor array, saves 98.8% of the average switching energy and reduces total capacitance by 75% compared to conventional schemes.},
  keywords={Power demand;Capacitors;Switches;Voltage;Capacitance;Registers;Electronic circuits;Analog-digital conversion;Switching circuits;Power-area efficient;small-area;successive approximation register (SAR);switching scheme;CDAC},
