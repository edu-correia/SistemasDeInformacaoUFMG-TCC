  booktitle={2025 International Conference on Innovations and Emerging Technologies In AI & Communication Systems (IETACS)}, 
  title={Automated Student Attendance System Using Real-Time Facial Recognition}, 
  year={2025},
  volume={},
  number={},
  pages={555-561},
  abstract={This study delineates the design and assessment of an attendance system predicated on facial recognition, utilizing the MERN stack (MongoDB, Express.js, React.js, Node.js) and face-api.js API. Traditional attendance methods often face issues of inaccuracy and inefficiency. In addition to its accuracy and real-time capabilities, the biometric facial recognition system also improves the prevention of fraud and proxy attendance in areas where there is little adherence to the information key held inside the software. Key features are a scalable architecture, secure user authentication, and seamless integration. Performance evaluation shows high reliability and usability, which proves the system to be superior to traditional methods in terms of accuracy, security, and efficiency. This abstract is concise and to the point yet captures the essential points of your research. Key feature include a scalable architecture, secure user authentication, seamless integration and machine learning-based recognition with the use of KNN and RestNet embeddings. The merging of ML models further enhanced accuracy and consistency under changing conditions.},
  keywords={Performance evaluation;Accuracy;Face recognition;Prevention and mitigation;Authentication;Real-time systems;Software;Software reliability;Security;Usability;component;formatting;style;styling;insert},
  doi={10.1109/IETACS68750.2025.11385586},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10883614,
  author={Akilan and Daniel, E. and P, Alwin Infant and G R, Jainish},
  booktitle={2025 6th International Conference on Mobile Computing and Sustainable Informatics (ICMCSI)}, 
  title={Boosting Software Quality: A Machine Learning Technique for Predicting Defects}, 
  year={2025},
  volume={},
  number={},
  pages={1062-1070},
  abstract={In order to increase automation, strengthen decision- making, and improve efficiency while reducing costs and maintaining precision, the development of intelligent machinery is becoming more and more dependent on the integration of data, embedded software, and modern technologies. Reliability of embedded software becomes essential for guaranteeing high system performance and an improved user experience as technology and hardware merge to build smart devices. This work explores methods to quantify software reliability, which measures the likelihood of residual failures in a system. The objective is to build a statistical relationship between quality parameters and product or process metrics through the analysis of software metrics produced from development data. These indicators aid in evaluating the software's dependability and performance, enabling developers to spot and fix possible problems early on. Using pattern recognition algorithms to pinpoint software's fault-prone areas is a crucial strategy for enhancing software reliability prediction. These algorithms enable developers to focus attention on software areas that have a higher likelihood of failure by identifying patterns in the product's code or structure that suggest increased risk. In summary, these methods focus on enhancing the reliability of intelligent machines by equipping developers with advanced tools to reduce defects, improve dependability, and ensure that smart systems perform optimally. This approach aligns with modern trends in using machine learning and data-driven models to tackle complex technological challenges.},
  keywords={Computational modeling;Software algorithms;Software quality;Predictive models;Prediction algorithms;Data models;Software reliability;Decision trees;Software measurement;Embedded software;Software reliability;Fault prediction;Statistical model;Embedded systems;Reliability estimation;Machine learning;Data-driven models;Software development lifecycle;SRGM},
  doi={10.1109/ICMCSI64620.2025.10883614},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11428758,
  author={Luo, Zibin and Zhang, Yiping and Liu, Baiquan},
  booktitle={2025 International Conference on Energy, Materials, and Photonics (EMP)}, 
  title={Principles and Research Progress of Artificial Lightemitting Synaptic Devices}, 
  year={2025},
  volume={},
  number={},
  pages={1-11},
  abstract={Artificial light-emitting synaptic devices, serving as the fundamental hardware foundation for building brain-inspired computers and artificial intelligence systems, have made significant strides in achieving high-efficiency, low-power neuromorphic computing by emulating the optoelectronic cooperative plasticity of biological synapses. These devices integrate the high-speed transmission and parallel processing advantages of optical signals with the precise modulation capabilities of electrical signals, offering a revolutionary solution to overcome the “memory wall” bottleneck inherent in traditional von Neumann architectures. This review summarizes the latest research progress in artificial light-emitting synaptic devices, with a focus on analyzing the design principles and performance characteristics of representative devices, including long-afterglow organic light-emitting transistors (LAOLETs), light-emitting electrochemical artificial synapses (LEEASs), quantum dot-based light-emitting synapses, and lightemitting memristors (LEMs). These devices not only successfully replicate core synaptic functionalities such as short-term/long-term plasticity and spike-timing-dependent plasticity (STDP) but also enable integrated information processing and display through dual optoelectronic outputs, laying the hardware groundwork for braininspired intelligent systems that merge sensing, memory, computing, and display functions. Although challenges remain in device stability, large-scale integration, and inhibitory synaptic emulation, artificial lightemitting synaptic devices have demonstrated immense potential in applications such as biomimetic vision and neuromorphic displays. Future advancements in material optimization, structural innovation, and system integration, along with the development of optically reconfigurable synapses and multimodal cooperative modulation technologies, will drive brain-inspired computing hardware toward higher levels of intelligence and adaptability, providing core hardware support for next-generation artificial intelligence systems.},
  keywords={Integrated optics;Biomedical optical imaging;Neuromorphic engineering;Artificial light;Hardware;Optical sensors;Optical modulation;Transistors;Synapses;High-speed optical techniques;artificial light-emitting synaptic;neuromorphic computing;LAOLET;LEEAS;LEM;QLED},
  doi={10.1109/EMP67345.2025.11428758},
  ISSN={},
  month={Aug},}@INBOOK{10952349,
  author={Gupta, Sunita and Janu, Neha and Nawal, Meenakshi and Goswami, Anjali},
  booktitle={Genomics at the Nexus of AI, Computer Vision, and Machine Learning}, 
  title={Genomics and Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={437-457},
  abstract={Summary <p>The chapter of the book &#x201c;Genomics and Machine Learning: ML Approaches, Future Directions and Challenges in Genomics&#x201d; delves into the burgeoning intersection of genomics and machine learning (ML). With the advent of high&#x2010;throughput sequencing technologies, genomics has witnessed a data explosion, necessitating advanced computational techniques to unlock its full potential. This chapter presents an overview of the introduction to genomics, genomics data and its unique characteristics, and the significance of genomics data in artificial intelligence (AI) and ML. It also presents an overview of ML approaches applied in genomics research and their applications, highlighting their contributions to genomic data analysis, gene expression prediction and disease classification. Moreover, it explores the exciting potential of ML in personalized medicine, offering insights into patient&#x2010;specific treatments and disease risk assessments. As the field of genomics continues to progress, the chapter explores future directions that hold promise for enhancing genomic research. These include multi&#x2010;omics integration, leveraging ML models to merge diverse biological data sources and utilizing transfer learning techniques to improve predictive power with limited data. However, this integration of ML into genomics research is challenging. The chapter addresses the ethical considerations surrounding using genomic data in ML models and the need to ensure data privacy and security. Additionally, it examines issues related to the interpretability and reproducibility of ML&#x2010;based genomic analyses, emphasizing the importance of developing transparent and reliable models.</p> <p>In conclusion, this chapter provides a comprehensive overview of genomics, genomics data, and symbiotic relationship between genomics and ML. It serves as a valuable resource for researchers, bioinformaticians, and clinicians interested in harnessing the power of ML to unravel the mysteries of the genome and usher in a new era of precision medicine.</p>},
  keywords={Bioinformatics;Genomics;RNA;Proteins;Sequential analysis;Machine learning;Gene expression;Diseases;Evolution (biology);Epigenetics},
  doi={10.1002/9781394268832.ch20},
  ISSN={},
  publisher={Wiley},
  isbn={9781394268825},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10952349},}@INPROCEEDINGS{9438167,
  author={Short, Robert and Hylton, Alan and Cardona, Robert and Green, Robert and Bainbridge, Gabriel and Moy, Michael and Cleveland, Jacob},
  booktitle={2021 IEEE Aerospace Conference (50100)}, 
  title={Towards Sheaf Theoretic Analyses for Delay Tolerant Networking}, 
  year={2021},
  volume={},
  number={},
  pages={1-9},
  abstract={The goal of Delay Tolerant Networking (DTN) is to take a collection of heterogeneous, disparate connections between satellites, space assets, ground stations, and ground infrastructure and bring it together into a cohesive, functioning overlay network. Depending on the systems being considered, one can find links with a one-way light time exceeding minutes (and hours), periodic links which can sometimes be predicted by orbital mechanics, and restrictions based on the variety of capabilities built into these systems. These characteristics preclude traditional network models and routing techniques and have classically led to either rigid routing tables or purely probabilistic models. As the deeper underlying structures remain unknown, development of more DTN-optimized algorithms has lacked the necessary foundation. In a continuation of previous work, the goal of this paper is to identify and study these fundamental structures that exist in delay tolerant networks (DTN), with a focus on space networks. The current routing methodology has been to use contact graph routing (CGR) algorithms. CGR models a series of known contacts as a static graph. For CGR to work, this graph must be globally consistent and must have an accurate picture of the network. Because this is a globally controlled structure, there is little room for flexibility in the event of changes to the network which would naturally occur as the network grows. As a response to the desire for flexibility as the network changes, we introduced the mathematical structure known as sheaves to DTNs last year. The tag-line for sheaves is that they are a mathematically precise way of gluing local data together into unique global data. Thus, sheaves lend extra power to traditional models (and routing algorithms) by taking additional information and merging it, in as consistent a manner as possible, with the representation itself. The clearest example of how Earth-bound networks exhibit behavior that is “sheafy” is link state routers, which build a local-to-global picture of their network by gluing local information together into a global network, exactly as a sheaf would do. For routing within delay tolerant networks to truly exploit this structure, a deeper structure than a graph is required. In this paper, we develop sheaves that can work over directed graphs such as temporal flow networks, we construct a sheaf representation for Dijkstra's algorithm, and we outline a construction for routing sheaves capable of modeling multicast scenarios. Finally, there is a section of future work suggesting follow-on research.},
  keywords={Space vehicles;Satellites;Protocols;Overlay networks;Tools;Routing;Probabilistic logic},
  doi={10.1109/AERO50100.2021.9438167},
  ISSN={1095-323X},
  month={March},}@INPROCEEDINGS{11452794,
  author={Krishnamoorthi, G and Surendhar, M S and Harshini, R P and Rajan, C},
  booktitle={2026 2nd International Conference on Advances in Intelligent Computing and Applications (AICAPS)}, 
  title={Multimodal Knowledge-Enhanced Misinformation Detection with Adversarial Robustness and Explainable AI}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The out-of-control growth of misinformation spreading across social media is creating critical problems for information integrity and public trust. Traditional detection systems often fall short because they look at only one thing at a timejust text or just images-which badly limits their usefulness against clever deceptions that mix both channels. This paper puts forward a complete framework that merges multimodal learning with knowledge-powered verification and strong adversarial defenses to catch misinformation in both text and pictures. Our architecture pairs BERT-based language encoders with ResNet visual extractors, using a novel cross-modal attention method to capture the semantic ties between textual claims and their accompanying images. To provide external factual grounding, we bring in knowledge graph embeddings through structured relationship modeling, making the system much better at identifying inconsistencies. To ensure it is resilient against intentional manipulations, our framework includes defense mechanisms we’ve tested against Fast Gradient Sign Method (FGSM) and Projected Gradient Descent (PGD) attacks. What’s more, an explainable AI module produces understandable predictions with SHAP and LIME visualizations, creating transparency in the decision process. Our experimental tests on benchmark datasets like Weibo and GossipCop show it performs much better than unimodal and existing multimodal systems, reaching solid accuracy while staying efficient enough for deployment in realtime. Bringing together adversarial training, knowledge checking, and explainability creates a well-rounded answer for the difficult, multi-layered challenges of finding fake news in today’s digital world.},
  keywords={Training;Ethics;Deepfakes;Visualization;Accuracy;Explainable AI;Transfer learning;Knowledge graphs;Robustness;Reproducibility of results;adversarial robustness;cross-modal attention;explainable AI;knowledge graph embeddings;misinformation detection;multimodal deep learning;natural language processing;social media analysis},
  doi={10.1109/AICAPS68631.2026.11452794},
  ISSN={},
  month={Feb},}@ARTICLE{9847345,
  author={Gao, Xi and Yin, Sijie and Wang, Guofu and Xue, Chunhua and Xie, Xianming},
  journal={IEEE Antennas and Wireless Propagation Letters}, 
  title={Broadband Low-RCS Circularly Polarized Antenna Realized by Nonuniform Metasurface}, 
  year={2022},
  volume={21},
  number={12},
  pages={2417-2421},
  abstract={A broadband circularly polarized metasurface antenna with low radar cross section (RCS) is proposed. Four metasurface elements are arranged orthogonally in a 2×2 array and fed with a 90° phase difference to achieve circular polarization radiation. Each metasurface element is a nonuniform subarray of 4×4 metallic patches. Attributed to the nonuniform property of the metasurface element, two characteristic modes with different resonant frequencies but with similar surface current distributions are formed. By optimizing the geometric parameters of the nonuniform element, the two modes are merged with each other, resulting in bandwidth (BW) broadening of the proposed antenna. Simulated and measured results show that the designed antenna has a −10 dB impedance BW of 49.60%, 3 dB axial ratio BW of 33.13%, and peak gain of 13.17 dBic. Moreover, the RCS reduction is higher than 6 dB in the entire operation frequency band. Additionally, the antenna has a low profile of 0.08λ (λ is the free-space wavelength at an operation frequency of 8.25 GHz).},
  keywords={Metasurfaces;Polarization;Broadband antennas;Antenna measurements;Current distribution;Antenna feeds;Radar cross-sections;Broadband antenna;circular polarization;low radar cross section (RCS);nonuniform metasurface},
  doi={10.1109/LAWP.2022.3195782},
  ISSN={1548-5757},
  month={Dec},}@INPROCEEDINGS{8919399,
  author={Han, Xian-Hua and Chen, Yen-Wei},
  booktitle={2019 IEEE Fifth International Conference on Multimedia Big Data (BigMM)}, 
  title={Deep Residual Network of Spectral and Spatial Fusion for Hyperspectral Image Super-Resolution}, 
  year={2019},
  volume={},
  number={},
  pages={266-270},
  abstract={Fusing a low-resolution hyperspectral image with the corresponding high-resolution multispectral image to obtain a high-resolution hyperspectral image is an important research topic for capturing comprehensive scene information in both spatial and spectral domains. Existing approaches estimate high-resolution hyperspectral image via minimizing the reconstruction errors of the available low-resolution hyperspectral and high-resolution multispectral images with different constrained prior knowledge such as representation sparsity, spectral physical properties, spatial smoothness and so on, where the performance of the recovered hyperspectral image greatly depends on the previously defined constraints and has still a large space to be enhanced. Recently, deep convolutional neural network (DCNN) has been applied to resolution enhancement of natural images, and proven to achieve promising performance. However, the architecture of the used DCNN for natural images takes a single low-resolution image only as input, and cannot be applied to fusion the two available low-resolution hyperspectral and high-resolution multispectral images for hyperspectral image super-resolution. This study proposes a novel deep residual network of spatial and spectral Fusion to merge the two available images for hyperspectral image super-resolution. Experiment results on benchmark datasets validate that the proposed residual CNN for hyperspectral super-resolution outperforms the state-of-the-art methods in both quantitative values and visual effect.},
  keywords={Spatial resolution;Image reconstruction;Hyperspectral imaging;Databases;Signal resolution;Hyperspectral reconstruction, residual network, deep learning, ResNet, spatial and spectral fusion},
  doi={10.1109/BigMM.2019.00-13},
  ISSN={},
  month={Sep.},}@ARTICLE{10185022,
  author={Wu, Jingbiao and Tong, Changwu and Yang, Nan and Leung, Kwok Wa and Lu, Kai and Hu, Pengfei},
  journal={IEEE Antennas and Wireless Propagation Letters}, 
  title={Radiation Pattern Decoupled Patch Antennas Based on TM01 and TM11 Modes}, 
  year={2023},
  volume={22},
  number={11},
  pages={2695-2699},
  abstract={In this letter, 1 × 2 L-probe fed patch antennas are decoupled with undistorted radiation patterns, based on the TM01 and TM11 modes of the patch. Metallic vias are employed to increase the resonant frequency of the TM01 mode, whereas slots can be cut on the patch to decrease the frequency of the TM11 mode. When the E-fields of these two modes are with appropriate amplitude ratio and phase difference, the E-fields inside the excited patch will be superposed whereas those inside the coupled patch will be canceled to a relatively low level. Further fine tuning the vias and slots can merge the resonant frequencies together and restore the maximum radiation along the boresight direction. To verify the effectiveness of the design idea, a prototype with zero edge-to-edge spacing is designed for 2.4-GHz WLAN applications. Good agreement can be observed between the measured and simulated results. The measured overlapping 10 dB impedance bandwidth is 5.7%, over which the isolation is larger than 20 dB. It should be highlighted that undistorted radiation patterns can be obtained with this approach.},
  keywords={Antenna measurements;Antenna radiation patterns;Patch antennas;Impedance;Bandwidth;Transmitting antennas;Scattering parameters;  $H$  -plane decoupling;patch antenna;radiation pattern decoupling (RPD);zero edge-to-edge spacing},
  doi={10.1109/LAWP.2023.3296353},
  ISSN={1548-5757},
  month={Nov},}@INPROCEEDINGS{8793487,
  author={Sun, Bo and Mordohai, Philippos},
  booktitle={2019 International Conference on Robotics and Automation (ICRA)}, 
  title={Oriented Point Sampling for Plane Detection in Unorganized Point Clouds}, 
  year={2019},
  volume={},
  number={},
  pages={2917-2923},
  abstract={Plane detection in 3D point clouds is a crucial pre-processing step for applications such as point cloud segmentation, semantic mapping and SLAM. In contrast to many recent plane detection methods that are only applicable on organized point clouds, our work is targeted to unorganized point clouds that do not permit a 2D parametrization. We compare three methods for detecting planes in point clouds efficiently. One is a novel method proposed in this paper that generates plane hypotheses by sampling from a set of points with estimated normals. We named this method Oriented Point Sampling (OPS) to contrast with more conventional techniques that require the sampling of three unoriented points to generate plane hypotheses. We also implemented an efficient plane detection method based on local sampling of three unoriented points and compared it with OPS and the 3D-KHT algorithm, which is based on octrees, on the detection of planes on 10,000 point clouds from the SUN RGB-D dataset.},
  keywords={Three-dimensional displays;Sun;Surface treatment;Clustering algorithms;Octrees;Estimation;Image segmentation},
  doi={10.1109/ICRA.2019.8793487},
  ISSN={2577-087X},
  month={May},}@INPROCEEDINGS{9313412,
  author={Hu, Ji-Li and Wang, Yong-Kang and Che, Zeng-Yang and Li, Qian-Qian and Jiang, Hong-Kun and Liu, Ling-Jie},
  booktitle={2020 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={Image Recognition of Chinese herbal pieces Based on Multi-task Learning Model}, 
  year={2020},
  volume={},
  number={},
  pages={1555-1559},
  abstract={The automatic identification of traditional Chinese medicine decoction pieces is of great significance in the objectification of Chinese medicine quality control. Common methods are traditional features of artificial design and machine learning algorithms represented by convolutional networks, but both have certain limitations in certain situations. This paper refers to the concept of multi-task learning, based on neural network and supplemented by traditional features, so that the two can be merged, establish a new deep learning model, and collect 200 kinds of medicine tablets (total 30437 images). The model is in different experimental tasks. The accuracy rate is up to 86.2%, and both of them maintain a good generalization effect. The multi-task learning model can be used to identify the Chinese medicine decoction pieces, which can effectively improve the accuracy and stability of the decoction piece identification, and has good application value.},
  keywords={Task analysis;Biomedical imaging;Multitasking;Image texture;Feature extraction;Training;Standards;Traditional Chinese medicine decoction pieces;Automatic recognition;Araditional features;Convolutional neural nenvork;Multitask learning},
  doi={10.1109/BIBM49941.2020.9313412},
  ISSN={},
  month={Dec},}@ARTICLE{10661220,
  author={Varshney, Gaurav and Mahak, Maitri},
  journal={IEEE Transactions on Plasma Science}, 
  title={Phase Transition Driven and Angle Multiplexed Broad/Narrowband THz Absorber}, 
  year={2024},
  volume={52},
  number={7},
  pages={3079-3082},
  abstract={An absorber containing a vanadium dioxide (VO2) resonator is designed and numerically studied to provide the thermally switchable response between the broad and narrow absorption spectrum. In the insulating phase, VO2 resonator supports the dielectric resonance through the creation of standing waves to provide the narrow absorption spectrum with a high quality factor of more than 300. In the metallic phase, the surface charge distribution on the resonator remains responsible to excite the fundamental and higher order magnetic dipoles with the nearby and merged spectrum hence a broad absorption band covering 2.19–5.56 THz is achieved. The absorber response can be thermally switchable. The geometry of the absorber can excite the multiple narrow resonances based on Brewster’s effect. Also, the scanning of incident angle can provide a tunable narrow spectrum over a broad spectral range. The absorber operation is validated through the theory of multiple reflections.},
  keywords={Absorption;Switches;Dielectrics;Reflection;Graphene;Terahertz communications;Q-factor;Absorber;angle tunability;Brewster’s effect;phase change material;thermal switching},
  doi={10.1109/TPS.2024.3447868},
  ISSN={1939-9375},
  month={July},}@INPROCEEDINGS{9162366,
  author={Tonu, Md. Anisur Rahman and Hridoy, Sharfuzzaman and Ali, M. Ameer and Azad, Salahuddin A.},
  booktitle={2019 IEEE Asia-Pacific Conference on Computer Science and Data Engineering (CSDE)}, 
  title={Block - NID: A Conceptual Secure Blockchain Based National Identity Management System Model}, 
  year={2019},
  volume={},
  number={},
  pages={1-7},
  abstract={Blockchain technology is becoming more and more popular day-by-day with an escalating interest in numerous applications ranging from data management, financial services, cyber security, Internet of things (IoT) and food science to healthcare industry and brain research. There has been a remarkable interest witnessed in utilizing applications of blockchain for the delivery of safe and secure National Identity (ID) management. Also, blockchain can reform the traditional ID management practices to a more reliable means in terms of effective use and distribution through safe and secure data sharing. In the future blockchain could be a technology that may potentially help in personalized, authentic, and secure ID management by merging the entire real-time user data of a citizen and presenting it in an up-to-date secure setup. In this paper we review both the existing and latest developments in the field of ID card system by implementing blockchain as a model. We also discuss the applications of blockchain along with the challenges faced and future perspectives.},
  keywords={Xenon;Blockchain;National Identification Number;Personally identifiable information;Interplanetary File System;Smart City},
  doi={10.1109/CSDE48274.2019.9162366},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{8997171,
  author={Pan, Ge and Song, YongHong and Wei, ShengHua},
  booktitle={2019 Chinese Automation Congress (CAC)}, 
  title={Combining Pose and Trajectory for Skeleton Based Action Recognition using Two-Stream RNN}, 
  year={2019},
  volume={},
  number={},
  pages={4375-4380},
  abstract={The changes of skeleton joint positions in skeleton sequences are caused by pose evolution and human body movements in the 3D space over time, which are both essential for action recognition. Most existing methods use relative coordinate system dependent on specific skeleton joint to track the action. However, because of the relative coordinate system,so the movements of action are eliminated. In this paper, the original coordinate system for raw skeleton sequences is transformed into the pose coordinate system and the trajectory coordinate system. Then the salient pose descriptor and trajectory descriptor of action sequence are extracted in the pose coordinate system and the trajectory system, respectively. The salient pose descriptor models the pose evolution over time while the salient trajectory descriptor describes the human body movements in the 3D space. Our method use a two-stream LSTM network to describe the changes of the temporal sequences. The salient pose and trajectory descriptors are fed into pose stream and trajectory stream separately. In order to merge the features from the pose stream and trajectory stream,we concatenate those features and use a fully connected network to de the next step. We evaluated our experiment on two benchmark datasets. Our experiment shows that our method gets good performance on two datasets.},
  keywords={Skeleton;Trajectory;Feature extraction;Three-dimensional displays;Biological system modeling;Pattern recognition;Legged locomotion;LSTM;Action Recognition;Skeleton},
  doi={10.1109/CAC48633.2019.8997171},
  ISSN={2688-0938},
  month={Nov},}@INPROCEEDINGS{9113569,
  author={Kumar, Amit and Bhaskar, S. and Singh, A. K. and Khan, A. and Singh, Amit Kumar},
  booktitle={2020 URSI Regional Conference on Radio Science ( URSI-RCRS)}, 
  title={A Wideband Dual-Resonance SIW Cavity-Backed Slot Antenna for 5G Applications}, 
  year={2020},
  volume={},
  number={},
  pages={1-4},
  abstract={In this paper, a wideband dual resonance cavity-backed slot antenna based on substrate integrated waveguide for the fifth-generation (5G) applications are designed and simulated to cover both Europe (24.25 – 27.5 GHz ) and USA region (27.5 – 28.35 GHz). With the proper positioning of multi-resonant slots on the bottom metal cladding of the SIW cavity, the hybrid modes are generated in the frequency band of interest. These modifications can be adjusted by varying the parameters of the slots, which result in the merging of different resonance frequencies. The results show that the bandwidth of 4.6 GHz (17.24%) ranging from 24.2 GHz – 28.8 GHz, a gain of 7.8 dBi and 9.2 dBi over the bandwidth, and cross-polarization level less than −35 dB have been achieved. The proposed antenna is compared in terms of antenna performances including reflection coefficient, bandwidth, gain, optimized parameter values, and radiation pattern with previously reported work in the literature. The overall volume occupied by the proposed design including feedline is 18 mm x 12 mm x 0.508 mm.},
  keywords={Slot antennas;5G mobile communication;Resonant frequency;Reflector antennas;Distance measurement;Topology;Broadband antennas},
  doi={10.23919/URSIRCRS49211.2020.9113569},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10567180,
  author={Liu, Zeyuan and Liang, Jiawei and Wang, Haoyu},
  booktitle={2024 IEEE 10th International Power Electronics and Motion Control Conference (IPEMC2024-ECCE Asia)}, 
  title={Optimal Design of Hexagonal Matrix Transformer for 48V-1V Switched-Capacitor and Series-Resonant Converter}, 
  year={2024},
  volume={},
  number={},
  pages={1346-1351},
  abstract={Switched-capacitor and series-resonant converter (SCSRC) is a promising topology to achieve single stage 48V-1V power conversion in 48V data center applications. This is mainly because of its high step down ratio, excellent soft-switching characteristics, and high efficiency. However, it is challenging to optimal design its transformer due to the high step down ratio and large output current. To address this challenge, in this paper, we propose a hexagonal matrix transformer and its optimal design methodology. The hexagonal matrix planar transformer is derived by merging multiple EI cores, which results in 40% reduction in primary side winding loss and 10% reduction in footprint. A guideline is detailed to facilitate the design process. A hardware prototype that operates at 950kHz, 48V input and 1V/100A output is designed and tested. Experimental results validate the design methodology and functionality of the transformer with an 87.73% peak efficiency.},
  keywords={Transmission line matrix methods;Windings;Prototypes;Switches;Transformer cores;Transformers;Hardware;data center;matrix transformer;resonant converter;single-stage voltage regulator module},
  doi={10.1109/IPEMC-ECCEAsia60879.2024.10567180},
  ISSN={},
  month={May},}@INPROCEEDINGS{10435037,
  author={Barkataki, Nairit and Mahanta, Pritha and Mazumdar, Sharmistha and Sarma, Utpal},
  booktitle={2023 Second International Conference on Advances in Computational Intelligence and Communication (ICACIC)}, 
  title={Efficient Hyperbola Detection and Fitting using Image Processing Techniques and Column-Connection Clustering}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Ground Penetrating Radar (GPR) is a preferred non-destructive method used for the identification and localisation of subsurface targets. Hyperbolic signatures present in GPR B-Scans can provide valuable insights about the shape, material and the distance at which target objects are buried below the surface. This paper presents an innovative approach to enhance GPR data analysis, specifically focusing on hyperbola detection within GPR B-Scans. Preprocessing steps, such as dewow filtering, frequency filtering, and gain compensation, are used to improve GPR data quality. A comparative analysis is conducted on the performance of Canny, Sobel, and Scharr edge detectors in identifying hyperbolic signatures. By merging the Canny edge detection algorithm with the Column-Connection Clustering (C3) method, common limitations of conventional clustering, particularly their sensitivity to noise and outliers are addressed. Finally, the efficacy of the proposed method is evaluated by calculating the R-squared values of the fitted hyperbolas which was found to be > 0.93.},
  keywords={Sensitivity;Filtering;Image edge detection;Fitting;Clustering algorithms;Detectors;Radar imaging;ground penetrating radar;edge detection algorithm;hyperbola detection;column-connection clustering (C3);sub-surface imaging},
  doi={10.1109/ICACIC59454.2023.10435037},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{8903760,
  author={Chernov, A. V. and Butakova, M. A. and Kartashov, O. O. and Alexandrov, A. A.},
  booktitle={2019 XXII International Conference on Soft Computing and Measurements (SCM))}, 
  title={Intelligent Decision Support by Means of Dynamic Description Logic}, 
  year={2019},
  volume={},
  number={},
  pages={138-141},
  abstract={Intelligent decision support tools using distributed dynamic description logic are proposed. Decision-making methods under uncertainty and semistructured input data are considered. Intelligent decision support in complex computing infrastructures is considered. The formats of semistructured data suitable for decision-making are determined. A formal definition of a new type logic called distributed dynamic descriptive logic is given. The architecture and the general scheme of the proposed approach are determined based on the situational knowledge base with merge into distributed situational knowledge base. The decision support system has an inference mechanism and rules of evolution, and by means of the context switching service planning of the query situation makes decisions. Users of the distributed situational knowledge base can fulfill requests about the current situation of their knowledge base. The interval analog of the hierarchy analysis method for direct decision-making is used.},
  keywords={Decision support systems;Uncertainty;Inference mechanisms;Description logic;Current measurement;Knowledge based systems;Distributed databases;Switches;Planning;Logic;intelligent decision support;dynamic descriptive logic;distributed knowledge base},
  doi={10.1109/SCM.2019.8903760},
  ISSN={},
  month={May},}@INPROCEEDINGS{9306641,
  author={Sun, Yuwei and Esaki, Hiroshi and Ochiai, Hideya},
  booktitle={2020 Joint 9th International Conference on Informatics, Electronics & Vision (ICIEV) and 2020 4th International Conference on Imaging, Vision & Pattern Recognition (icIVPR)}, 
  title={Visual Analytics for Anomaly Classification in LAN Based on Deep Convolutional Neural Network}, 
  year={2020},
  volume={},
  number={},
  pages={1-6},
  abstract={Information systems accelerate the advancement of society. However, malicious manipulation of information would bring great harm. Recently, criminal groups are increasingly involved in cybercrime, especially in the Local Area Network (LAN). Several methods are being used to analyze network traffic in LAN such as extracting the transition patterns in traffic flows, however, research on visualization of network traffic, thus detecting and classifying various abnormal events, is insufficient. In this research, we propose visual analytics for generating feature maps of network events based on protocol information. We extract protocol information of ARP, TCP, and UDP from network traffic and generate each type of feature maps. Then for each event, we merge these three types into one image by putting them into different channels, to represent features. We simulate and visualize eight types of network events in LAN which are the normal, arp scan, tcp scan, scan of tcp port 23, scan of tcp port 80, udp scan, scan of udp port 137 and scan of udp port 1900. Then for this multiclass classification problem, we adopt a deep convolutional neural network (CNN) to differentiate between these network events, with these eight types as labels and generated feature maps as inputs. We evaluated the scheme using precision, recall, and F-measure in two LANs, at last, achieving an average F-measure of 0.76.},
  keywords={Local area networks;Telecommunication traffic;Feature extraction;Protocols;Machine learning;Convolution;Visual analytics;visual analytics;LAN;cybersecurity;machine learning;convolutional neural network},
  doi={10.1109/ICIEVicIVPR48672.2020.9306641},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10529696,
  author={Wei, Xiaohui and Hao, Jieyun and Xu, Zhewen and Han, Junze},
  booktitle={2023 International Conference on Networks, Communications and Intelligent Computing (NCIC)}, 
  title={DCPGRN: A Dynamic Climate Pattern Graph Recurrent Network for Weather Forecasting}, 
  year={2023},
  volume={},
  number={},
  pages={41-45},
  abstract={Currently, to understand and predict the weather still faces a significant issue due to the inherent non-linearities and the involvement of dynamical spatio-temporal auto-correlation over time, causing an interdisciplinary challenge for researchers. We propose a Dynamic Climate Pattern Graph Recurrent Network (DCPGRN) for meteorological forecasting to address such challenge. It combines a topology learner through a deep generative layer with domain knowledge enhancement into the spatio-temporal network. We merge a node-embedding-based similarity metric learning and the superposition principle as physical assistant into the dynamic graph module to capture the optimal topology. Besides, we evaluate the DCPGRN with some real-world weather datasets and achieve outstanding performance with obvious improvements compared with the representative algorithms in this field. Moreover, we conduct a city insights in 7 typical city stations, revealing the interpretability, advantages, and insidious discussions of our model.},
  keywords={Measurement;Network topology;Atmospheric modeling;Urban areas;Weather forecasting;Sea measurements;Predictive models;Spatio-temporal Forecasting;Graph Neural Network;Weather Forcasting;Dynamic Graph},
  doi={10.1109/NCIC61838.2023.00012},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9678674,
  author={Telenyk, Sergii and Pogorilyy, Sergiy and Kramov, Artem},
  booktitle={2021 IEEE 3rd International Conference on Advanced Trends in Information Theory (ATIT)}, 
  title={The Complex Method of Coreferent Pairs Detection in a Ukrainian-language Text Based on a BiLSTM Neural Network}, 
  year={2021},
  volume={},
  number={},
  pages={205-210},
  abstract={Coreference resolution is one of the background tasks in the area of natural language processing. As this task falls into the category of AI-complete problems, different machine learning techniques are used in order to solve it with sufficient accuracy. In this paper, a new complex method of coreferent clusters detection based on a BiLSTM neural network has been suggested. The state-of-the-art methods of coreference resolution have been considered. The impact of the different features of a text on the accuracy of the detection of coreferent pairs has been investigated. It has been shown that the semantic representation of mentions should be considered as the main component during the preparation of input data for a model. The neural network based on a shared BiLSTM layer has been designed and trained using a SEARN-based approach. The set of filtering sieves has been used as an additional instrument for the detection of explicit connections between coreferent objects. The experimental verification of the effectiveness of the suggested method has been performed using corresponding metrics. The results obtained may indicate that the proposed method can be utilized in order to group the coreferent objects into clusters for the different Slavic language corpora.},
  keywords={Measurement;Instruments;Neural networks;Semantics;Object detection;Machine learning;Propagation losses;coreferent pairs detection;BiLSTM neural network;natural language processing;Extremely Randomized Trees;deep learning;binary classifier},
  doi={10.1109/ATIT54053.2021.9678674},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10600176,
  author={Toennies, Michael and Wang, Rabi and Diener, William and Matsko, Andrey},
  booktitle={2024 IEEE/MTT-S International Microwave Symposium - IMS 2024}, 
  title={Microwave Frequency Comb Generator for Radio Astronomy Applications}, 
  year={2024},
  volume={},
  number={},
  pages={521-524},
  abstract={This paper describes a successful application of conventional RF synthesis techniques for the development of a low noise and high stability X-/Ka-band frequency comb generator which historically were forced to use bespoke designs to meet the performance requirements. We implement the multi-octave clustered high frequency comb by merging a low frequency comb generation technology with numerous parallel low-noise frequency synthesizers. The complexity of our system is substantially reduced by shifting to mass-market surface mount components.},
  keywords={Frequency synthesizers;Costs;Radio astronomy;Noise;Surface mount technology;Microwave frequencies;Generators;phase locked loops;microwave circuits;phase noise;pulse generation;frequency conversion},
  doi={10.1109/IMS40175.2024.10600176},
  ISSN={2576-7216},
  month={June},}@INPROCEEDINGS{10781976,
  author={Lin, Qing and Oglić, Dino and Lam, Hak-Keung and Curtis, Michael J. and Cvetkovic, Zoran},
  booktitle={2024 46th Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)}, 
  title={A Hybrid GCN-LSTM Model for Ventricular Arrhythmia Classification Based on ECG Pattern Similarity}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Accurate differentiation between Ventricular Tachycardia (VT) and Ventricular Fibrillation (VF) is essential in the field of cardiology. Recent advancements in deep learning have facilitated automated arrhythmia recognition, surpassing traditional electrocardiogram (ECG) methods that depend on manual feature extraction. Building on our previous work, which emphasized the importance of identifying patterns of regularity, we have developed a model that merges Graph Convolutional Networks (GCN) with Long Short-Term Memory (LSTM) networks. This GCN-LSTM model employs a trainable weighted ϵ-neighborhood graph to capture the similarity among time series within ECG segments. This approach has demonstrated substantial improvement in the classification of VT, VF, and non-ventricular rhythms.},
  keywords={Tachycardia;Heart beat;Arrhythmia;Time series analysis;Manuals;Electrocardiography;Data models;Labeling;Long short term memory;Standards},
  doi={10.1109/EMBC53108.2024.10781976},
  ISSN={2694-0604},
  month={July},}@INPROCEEDINGS{10011935,
  author={Li, Weilin and Wu, Jing and Long, Chengnian},
  booktitle={2022 IEEE International Conference on Robotics and Biomimetics (ROBIO)}, 
  title={Formation Control for Unmanned Surface Vehicles Based on Integrative APF and MPC}, 
  year={2022},
  volume={},
  number={},
  pages={201-206},
  abstract={This paper takes the dual water jet propulsion USV as the research object, and studies formation obstacle avoidance optimization problem. An integrative APF algorithm is proposed to merge path planning and trajectory tracking into one optimization problem, where adaptive searching step is adopted to guarantee that the planned trajectory is reachable. In addition, a distance-triggered codesign of integrative APF and MPC is presented to maintain formation during the obstacle avoidance process. Finally, the results in MATLAB simulation demonstrate the validity and efficiency of the algorithm.},
  keywords={Space vehicles;Trajectory tracking;Heuristic algorithms;Simulation;Transforms;Propulsion;Trajectory;dual water jet propulsion USV;formation control;integrative APF;MPC},
  doi={10.1109/ROBIO55434.2022.10011935},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9846263,
  author={Zeng, Rongtao and Zhao, Jinghong and Huang, Chuibing and Ding, Anming},
  booktitle={2022 IEEE 5th International Electrical and Energy Conference (CIEEC)}, 
  title={A Permanent Magnet Synchronous Linear Motor ADRC Position Control Algorithm Research}, 
  year={2022},
  volume={},
  number={},
  pages={742-747},
  abstract={In order to improve the servo performance of the permanent magnet synchronous linear motor, a vector control system based on the ADRC position control algorithm is designed. The traditional PI controller is used for the current and speed loops, and the simplified control model is merged and simplified by the transfer function. More ever, the motor controller parameters are adjusted by using the traditional control theory method, and the speed regulation performance of the linear motor is verified by simulation. In the motor position loop, the control performance of the ADRC controller is verified by comparing it with the PI controller in simulation, which shows that it has some anti-tampering and compensation ability for the variation of the given position.},
  keywords={PI control;Simulation;Velocity control;Position control;Transfer functions;Synchronous motors;Permanent magnet motors;PMLSM;ADRC Controller},
  doi={10.1109/CIEEC54735.2022.9846263},
  ISSN={},
  month={May},}@INPROCEEDINGS{9899987,
  author={Chemweno, Emmanuel K and Kumar, Pradeep and Afullo, Thomas J. O.},
  booktitle={2022 International Conference on Electromagnetics in Advanced Applications (ICEAA)}, 
  title={Bandwidth Enhancement of a Substrate Integrated Waveguide Dielectric Resonator Antenna using Metallic Shorting Vias}, 
  year={2022},
  volume={},
  number={},
  pages={302-305},
  abstract={A D-band Substrate Integrated Waveguide (SIW) fed Dielectric Resonator Antenna (DRA) is proposed. The dielectric resonator (DR) is designed to operate in higher order modes. Impedance matching techniques are used to merge these resonance modes to increase the bandwidth of the antenna. Simulation results show that the antenna exhibits a-10 dB impedance bandwidth between 138.27GHz and 150.95GHz, equivalent to 9%. The proposed antenna has a maximum gain of 8.79dBi and a radiation efficiency of 81%.},
  keywords={Structural rings;Simulation;Impedance matching;Resonant frequency;Electromagnetic waveguides;Bandwidth;Dielectric resonator antennas;Dielectric Resonator Antenna (DRA);Substrate Integrated Waveguide (SIW)},
  doi={10.1109/ICEAA49419.2022.9899987},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10981136,
  author={Joseph, Naomi and Marshall, Ian and Seckler, James and Petranka, Nathan and Moon, Juri and Yu, Kaichen and More, Suyash and Chi, Vo Linh and Pelot, Nicole A. and Shoffstall, Andrew and Jenkins, Michael W. and Wilson, David},
  booktitle={2025 IEEE 22nd International Symposium on Biomedical Imaging (ISBI)}, 
  title={Few-Shot Sample-Specific Deep Learning Multiclass Segmentation and Fiber Tractography using 3D-Microscopy with Ultraviolet Surface Excitation (3D-Muse) Images of Human Vagus Nerve}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={At CWRU, the Reconstructing Vagal Anatomy (REVA) project images the vagal complex from brainstem to abdomen using multiple modalities and resolutions. Here we describe the analysis of 3D Microscopy with Ultraviolet Surface Excitation (3D-MUSE), a section-and-image system that enables microscopic visualization and quantification of the morphology and microanatomy of 15-mm vagus nerve samples. Variations in staining, tissue, and image quality across samples require few-shot training of sample-based neural networks to segment fascicles, perineurium, and epineurium. After pre-training a Vision Transformer on all unlabeled images, we fine-tuned a U-Net Transformer with 1-10% segmented images. Highest performance achieved mean Dice scores of 0.91±0.02 with 1% (10) training images, and 0.94±0.01 with 4% (40) MUSE image segmentations reveal nerve density variations, positive correlation between perineurium thickness and fascicle diameter, and thickness variation due to fascicle splits and merges. Fiber tractography reveals dynamic fascicular organization and requires further investigation into small fascicle (<150µm-diameter) behavior.},
  keywords={Training;Image quality;Image segmentation;Three-dimensional displays;Microscopy;Heuristic algorithms;Surface morphology;Organizations;Optical fiber networks;Transformers;3D-MUSE Imaging;vagus nerve segmentation;fiber tractography},
  doi={10.1109/ISBI60581.2025.10981136},
  ISSN={1945-8452},
  month={April},}@INPROCEEDINGS{9835857,
  author={Rao, B. Sai Nithish and Raju, N. Vinay Kumar and Dhanush, M. and Harshith, P.N.S.M. and Mehdi, Mohammed Javeed},
  booktitle={2022 7th International Conference on Communication and Electronics Systems (ICCES)}, 
  title={MRI and Spect Medical Image Fusion using Wavelet Transform}, 
  year={2022},
  volume={},
  number={},
  pages={1690-1696},
  abstract={Image fusion’s goal is to merge material from multiple images of the same scene into a single image that preserves the essential and required features of each original image. Today, with the rapid development of high-tech and modern instrumentation, medical imaging has become a vital component of a wide range of applications including diagnosis, research, and treatment. Medical picture fusion is the principle to enhance image quality by fusing pictures obtained from different imaging instruments such as computed tomography (CT), magnetic resonance imaging (MRI), positron emission tomography (PET) and computed tomography (SPECT) with single photon emission. SPECT contains the details about the functioning and blood flow of our tissues and organs for medical diagnosis. Magnetic Resonance Image (MRI) offers stronger, more distortion information on soft tissue. In this case, just one type of image may not be enough to provide the physicians with accurate clinical requirements. The fusion of the multimodal medical images is therefore needed. This paper introduces an image fusion approach that is based on discrete wavelet transformation. 2-Dimensional DWT for decomposing an image. The fusion performance is evaluated using Mutual Information (MI) and Correlation of Fused Image and Reference Image.},
  keywords={Magnetic resonance imaging;Instruments;Discrete wavelet transforms;Medical diagnosis;Single photon emission computed tomography;Positron emission tomography;Medical diagnostic imaging;Computed Tomography (CT);Magnetic Resonance Imaging(MRI);2-Dimensional DWT;Mutual Information (MI)},
  doi={10.1109/ICCES54183.2022.9835857},
  ISSN={},
  month={June},}@INPROCEEDINGS{9180677,
  author={Cochran, Zachary and Ytterdal, Trond and Madan, Akul and Rizkalla, Maher},
  booktitle={2020 IEEE International Symposium on Circuits and Systems (ISCAS)}, 
  title={Emerging Josephson Junction/Graphene Device Technologies towards THz Signal Generation}, 
  year={2020},
  volume={},
  number={},
  pages={1-5},
  abstract={A novel approach to merge superconducting Josephson Junction (JJ) devices with nanoscale Graphene devices in order to achieve high gain-bandwidth-product on the order of THz was addressed. JJs are ultra-fast devices that consist of two superconducting plates separated by a nanoscale layer of nonconducting material which exhibits quantum tunneling phenomenon. While JJ-based devices have existed since nearly 1962, interfacing them with standard electrical systems has been a challenge for several reasons, including operating temperature, switching speed, and low-signal sensitivity. In this study, we investigated the possibility of utilizing JJ's so-called AC-effect in order to generate high frequency signals that can be accommodated by high speed nanoscale devices. Graphene Nano Ribbon Field Effect Transistors (GNRFET) have been emphasized for their very high frequency operation that is appropriate to accommodate the very high switching speed of the JJ devices. The study is based on the AC JJ effet with generating a sinusoidal current whose frequency directly scales with voltage. For a single-stage GNRFET CS amplifier, a gain of 35.7dB with a bandwidth of 217GHz was achieved, while 10.8dB with a unitary gain of 2.5THz was also accomplished. The paper details the design and interfacing of the JJ with GNRFET devices, targeting high frequency signal generation on the order of hundreds of GHz to THz.},
  keywords={Junctions;Graphene;Josephson junctions;Resistance;High-temperature superconductors;Capacitance;Josephson Junctions;Josephson Effect;AC Effect;DC Effect;graphene;GNRFET;terahertz;superconductivity;nanoribbon},
  doi={10.1109/ISCAS45731.2020.9180677},
  ISSN={2158-1525},
  month={Oct},}@ARTICLE{9638326,
  author={Gassenq, Alban and Duchemin, Ivan and Niquet, Yann-Michel and Glière, Alain and Pauc, Nicolas and Chelnokov, Alexei and Reboud, Vincent and Calvo, Vincent},
  journal={IEEE Photonics Journal}, 
  title={Modeling of the Bandgap Distribution in Bi-Axially Strained Germanium Crossbeam for Laser Applications}, 
  year={2022},
  volume={14},
  number={1},
  pages={1-4},
  abstract={High tensile strained Ge cavities in crossbeam are promising for the development of integrated laser sources on Si. However, the optimization of such cavities remains more challenging than the uniaxial beams. Indeed, the spatial distributions of both the optical field and the material gain have to be simultaneously defined by the nuances of complex cavity geometry. In this work, we simulate spatial distribution of the bandgap in bi-axially strained Ge crossbeams. Starting from stress map calculations, we achieved the bandgaps mapping for all possible suspended strain configuration (i.e ϵxx, ϵyy and ϵxy), when merged with bandgaps modeling. A trade-off is evidenced between membrane orientation and arm curvature to reach the largest possible volume of amplifying material. Our work highlights the fundamental importance of these two parameters for Ge crossbeam design and presents a relevant modeling tool to define suitable cross designs for laser applications.},
  keywords={Strain;Photonic band gap;Germanium;Laser modes;Laser applications;Stress;Silicon;Germanium;strain;photonics;crossbeam},
  doi={10.1109/JPHOT.2021.3132790},
  ISSN={1943-0655},
  month={Feb},}@INPROCEEDINGS{9224013,
  author={Mansoorzare, Hakhamanesh and Abdolvand, Reza},
  booktitle={2020 IEEE/MTT-S International Microwave Symposium (IMS)}, 
  title={Non-Reciprocal Lithium Niobate-on-Silicon Acoustoelectric Delay Lines}, 
  year={2020},
  volume={},
  number={},
  pages={532-534},
  abstract={This work demonstrates the first implementation of lithium niobate-on-silicon (LNoSi) non-reciprocal acoustic delay lines (ADL) with tunable insertion loss (IL) utilizing the acoustoelectric (AE) effect. Due to the AE effect, the direction-and the intensity-dependent momentum exchange between the drifting electrons in the Si layer and the acoustic phonons can be utilized to break the intrinsic reciprocity of the ADLs in order to control their frequency response. A 5.2 dB improvement in the IL and a 14.2 dB increase in the reverse isolation (i.e. a 19.4 dB non-reciprocal transmission ratio) is achieved through injecting a 400 µA current in one of the ADLs presented here. This opens up possibilities of merging long delays, tunable attenuators, and switches in a single miniaturized device which is a critical stepping stone in fulfillment of full-duplexed microwave systems.},
  keywords={Phonons;Microwave devices;Insertion loss;Switches;Delay lines;Lithium;Acoustics;acoustic delay line;acoustoelectric effect;Lamb wave;lithium niobate;non-reciprocal},
  doi={10.1109/IMS30576.2020.9224013},
  ISSN={2576-7216},
  month={Aug},}@INPROCEEDINGS{10781717,
  author={Gupta, Pragya and Jain, Nishant},
  booktitle={2024 IEEE International Conference on Computer Vision and Machine Intelligence (CVMI)}, 
  title={Segmentation of CT images for efficient fusion with MR images}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The fusion of computed tomography (CT) image and magnetic resonance (MR) image is a crucial step in many medical imaging applications. However, fused image quality depends on the fusion methods used to extract relevant information from each modality. This paper presents an image fusion method based on segmentation, and presents the significance of selecting an efficient segmentation method in achieving superior image fusion results. A novel approach is proposed that utilizes Otsu’s Method to segment the skull region from the CT image. Soft tissue region is then extracted from the MR image using the extracted skull region. The skull region and soft tissue region extracted are merged to obtain a fused image. The proposed method is evaluated on a dataset of ten registered pairs of CT and MR images. Superiority of Otsu’s segmentation method over ACM and FCM segmentation methods for the fusion of CT image and MR image is demonstrated using Qualitative and quantitative analysis methods.},
  keywords={Image quality;Image segmentation;Computer vision;Statistical analysis;Computed tomography;Biological tissues;Magnetic resonance;Data mining;Image fusion;Machine intelligence;Image Fusion;Segmentation;Otsu Method;Active Contour Method;Fuzzy C-Mean},
  doi={10.1109/CVMI61877.2024.10781717},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11299613,
  author={Nagarkoti, Shashi Kala and Yadav, Richa and Bhati, Pooja},
  booktitle={2025 International Conference on Emerging Trends in Networks and Computer Communications (ETNCC)}, 
  title={Wearable Sweat Sensors for Personalised Healthcare}, 
  year={2025},
  volume={},
  number={},
  pages={898-905},
  abstract={Non-invasive health monitoring is the most promising breakthroughs with the emergence of sweat analysis as a powerful diagnostic tool. Sweat, a noninvasive and continuously available biofluid, has numerous biomarkers that can indicate a person's health condition, thus providing a one-on-one, real-time, health monitoring platform. Last few years, new advancements in wearable sensor systems have made it possible to continuously and non-invasively measure these biomarkers to offer real-time information on different variables affecting health. Integration of Internet of Things (IoT) infrastructure enables smooth capture, transfer, and storage of data, providing a good framework for data analytics. Moreover, since this dataset is provided with machine learning algorithms, prediction analytics are possible and lead to customized health treatment and early health risk management. This paper reviews the latest advancements in sweat biomarker detection methods, exploring cutting-edge sensor technologies, IoT integration strategies, multiple possible applications of the proposed techniques in clinical practice, and challenges and limitations in wearable sweat sensing. The merging of these technologies allows for the radical enhancement of personalized medicine, with apt diagnosis, better therapeutic outcomes, and individual responsibility for health status.},
  keywords={Reviews;Precision medicine;Biomarkers;Real-time systems;Internet of Things;Risk management;Biomedical monitoring;Wearable devices;Monitoring;Wearable sensors;Sweat Biomarkers;IoT integration;Machine learning},
  doi={10.1109/ETNCC66224.2025.11299613},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{8755430,
  author={Kunert, Georg and Pawletta, Thorsten and Pawletta, Sven and Simanski, Olaf},
  booktitle={2019 International Interdisciplinary PhD Workshop (IIPhDW)}, 
  title={Accelerating Reinforcement Learning for Robot Controls Using Interim Rewards and Master/Slave Computing}, 
  year={2019},
  volume={},
  number={},
  pages={95-100},
  abstract={Reinforcement-Learning (RL) has become a bigger task in engineering. The advantage of RL is the ability to learn without known datasets, only with rules included in an environment. If the task becomes bigger, the learning phase grows enormously. Two approaches for accelerating the time of learning are discussed in this work. Introducing interim rewards offers the possibility to split a big task into several smaller tasks. With the master/slave approach, multiple instances learn individually and the knowledge of each of them is merged afterwards into one behavior strategy. Both of these approaches are demonstrated by means of a case study.},
  keywords={Q-learning;Conferences;Robot control;Main-secondary;Reinforcement Learning;Q-Learning;Master/Slave Computing;Robotic Control},
  doi={10.1109/IIPHDW.2019.8755430},
  ISSN={},
  month={May},}@INPROCEEDINGS{10071163,
  author={Ren, Jianxin and Zhao, Manfei and Wang, Haofeng and Gao, Tong and Yao, Peng and Shao, Zonglin},
  booktitle={2022 International Symposium on Advances in Informatics, Electronics and Education (ISAIEE)}, 
  title={A Time Sensitive Network-Based Data Distribution Service Implementation Method}, 
  year={2022},
  volume={},
  number={},
  pages={156-160},
  abstract={This paper proposes a TSN-based data distribution service (DDS) implementation method for solving the application flexibility problem of Time Sensitive Network (TSN). First, we propose stream monitoring method for a system-level network controlling; Second, a network management methods is proposed, which adjusts the gate control strategy in accordance with real-time flow; Finally, we have merged TSN driver to DDS for improving the publishing and subscription performance. The experiment results show that the proposed method has established a certainty DDS system with great communication efficient and flexibility.},
  keywords={Switches;Logic gates;Dynamic scheduling;Real-time systems;Software;Regulation;Software reliability;time sensitive network;data distribution service;stream monitoring method;network management method},
  doi={10.1109/ISAIEE57420.2022.00040},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{8784724,
  author={Ma, Chenxi and Tan, Weimin and Bare, Bahetiyaer and Yan, Bo},
  booktitle={2019 IEEE International Conference on Multimedia and Expo (ICME)}, 
  title={A Multi-level Aggregated Network for Image Restoration}, 
  year={2019},
  volume={},
  number={},
  pages={1156-1161},
  abstract={Recently, significant progress has been witnessed in image restoration benefited from the development of deep convolutional neural networks (CNN). However, we note that many state-of-the-art image restoration networks can be unfolded as a one-level architecture, which is constructed by stacking multiple convolution layers or blocks. As the depth of network grows, the information flow is weakened. And, existing skip connection has restricted ability to pass the previous state to the latter layers in the network. Based on above observations, we explore a multi-level aggregated network (MLAN) to fully exploit features of deeper layers. The proposed MLAN can extract more features by merging layers at different levels progressively, and can better aggregate the features by the augmented connection manner. Experimental results demonstrate a satisfactory performance of the proposed model on different image restoration tasks.},
  keywords={Feature extraction;Convolution;Image restoration;Aggregates;Training;Local area networks;Task analysis;Image Restoration, Deep Convolutional Neural Networks, Multi-Level Aggregated Network},
  doi={10.1109/ICME.2019.00202},
  ISSN={1945-788X},
  month={July},}@INPROCEEDINGS{8910823,
  author={Kurvinen, Joni and Kähkönen, Henri and Lehtovuori, Anu and Ala-Laurinaho, Juha and Viikari, Ville},
  booktitle={2019 49th European Microwave Conference (EuMC)}, 
  title={Co-Designed Handset Antennas with Wide Angular mm-Wave Coverage and LTE MIMO}, 
  year={2019},
  volume={},
  number={},
  pages={730-733},
  abstract={The co-existence of mm-wave and LTE antennas in modern handsets is yet an unsolved challenge in the phone industry and antenna research community. The different antenna types merged together in a shared volume easily hinder each other's performance. This paper extends the work published recently, showing how high-gain mm-wave antennas at 28 GHz can be incorporated in the same volume with LTE MIMO antennas. The results show that with small compromises a decent performance can be achieved at both mm-wave and LTE bands.},
  keywords={Antenna arrays;Long Term Evolution;MIMO communication;Metals;Gain;Telephone sets;beam-steering;handset antenna;LTE;metal frame;millimeter-wave;multiple-input multiple-output (MIMO)},
  doi={10.23919/EuMC.2019.8910823},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10684964,
  author={Li, Peilei and Yu, Hanqing and Zhang, Yijin},
