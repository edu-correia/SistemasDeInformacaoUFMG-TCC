  title={An Improved Label Propagation Algorithm for Undirected Weighted Networks}, 
  year={2024},
  volume={},
  number={},
  pages={97-101},
  abstract={In recent years, with the rapid development of network technology, the scale of social networks has become increasingly large and diversified. The detection of community has become a hot spot in the research of social network. Label propagation algorithm (LPA) has been widely concerned since it has the advantages of linear time complexity. However, the randomness of LPA affects the accuracy and stability of the community. This paper proposes an improved label propagation algorithm for undirected weighted networks. In the first stage, considering both node importance and local topological information, an improved LPA is designed to divide the undirected weighted network into initial communities, thereby reducing the instability of LPA. In the second stage, a strategy for increasing modularity is designed to merge small communities, thereby improving the quality of community partitioning. Experimental results show that the proposed community detection algorithm has better community detection quality compared to LPA and four classical community detection algorithms.},
  keywords={Wireless communication;Accuracy;Social networking (online);Optical fiber communication;Partitioning algorithms;Detection algorithms;Time complexity;Community detection;LeaderRank algorithm;Label propagation algorithm},
  doi={10.1109/ICWOC62055.2024.10684964},
  ISSN={},
  month={June},}@INPROCEEDINGS{10096456,
  author={Lyu, Juhyun and Yang, Jinseok and Kim, Junghee and Lim, Woohyung and Ahn, Wonbin and Kang, Dongwan and Kim, Minjae and Kim, Nam Soo},
  booktitle={ICASSP 2023 - 2023 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Multi-Resolution Sequence Aggregation and Model-Agnostic Framework for Time-Series Forecasting}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={In time-series forecasting, signals such as traffic volume collected in the real world are noisy and irregularly sampled due to sensor malfunctions, so it is difficult to make accurate prediction. To resolve such difficulty, downsampling can be used to reduce noise and allow capturing slow trend of signals. In addition, upsampling can fill the missing data of irregularly sampled signals to catch fine details. Although extracting multi-resolution temporal features such as down or upsampling can improve prediction accuracy, the existing time-series forecasting approaches have used the original and/or downsampled signals only, so they cannot detect fine details of upsampled one. Moreover, these methods merge multi-resolution inputs without carefully concern to chronological order of time-series, which is very important in the time-series. To overcome this challenge, we propose a framework that can fully utilize multi-resolution time-series signals in up, original, and downscale, and sequentially aggregate them, named multi-resolution sequence aggregation and model-agnostic (MAMA) framework. Note that i) MAMA aggregates the multi-resolution signals without breaking its sequential characteristics, whose effectiveness was verified by the experiment results, and ii) it can adopt any existing forecasting algorithms. From experiments with the real-world datasets, it was observed that the prediction accuracy of the well-known forecasting models (i.e., LSTNet, TCN, and Informer) were improved by 11.5% on average when the proposed architecture is used. In ablation study, we showed that a performance improvement of 1.5% was achieved with the help of sequential aggregation module.},
  keywords={Heuristic algorithms;Aggregates;Signal processing algorithms;Predictive models;Prediction algorithms;Feature extraction;Noise measurement;Multi-resolution;upsampling;time-series forecasting;model-agnostic;modular architecture;cross attention;deep learning},
  doi={10.1109/ICASSP49357.2023.10096456},
  ISSN={2379-190X},
  month={June},}@INPROCEEDINGS{11283318,
  author={Carrasco-Guerrero, Daniela and Riquelme, Patricio and Hernández, Cecilia and Guevara, Pamela},
  booktitle={2025 21st International Symposium on Biomedical Image Processing and Analysis (SIPAIM)}, 
  title={Atlas of Cerebellar Connections Based on ROIs and dMRI Tractography}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The cerebellum plays a crucial role in cognitive, autonomic, and motor functions, as well as in its interactions with the rest of the central nervous system. Understanding its structural connectivity is essential for both neuroscience research and neurosurgical planning. However, detailed population-based atlases of cerebellar pathways remain limited. In this study, we present a novel cerebellar fiber atlas derived from diffusion MRI data of 10 healthy subjects. Twenty cerebellar connections were identified, and corresponding regions of interest (ROIs) were manually segmented using DSI Studio. Deterministic tractography was performed to reconstruct individual tracts, which were subsequently merged across subjects to generate the group atlas of fiber bundles. Visual inspection by an anatomist expert confirmed correspondence with established anatomical references, while also revealing fine-grained pathway delineations not captured in existing atlases. As a preliminary reference, this atlas opens the way for more comprehensive investigations of cerebellar connectivity and the development of improved strategies for neurosurgical planning.},
  keywords={Cerebellum;Visualization;Neuroscience;Magnetic resonance imaging;Manuals;Probabilistic logic;Motors;Planning;Neurosurgery;White matter;Diffusion Magnetic Resonance Imaging;Cerebellum;Tractography;White Matter},
  doi={10.1109/SIPAIM67325.2025.11283318},
  ISSN={},
  month={Nov},}@INBOOK{9930692,
  author={Lian, Yaguang},
  booktitle={Semiconductor Microchips and Fabrication: A Practical Guide to Theory and Manufacturing}, 
  title={Introduction of Etching and RIE System}, 
  year={2023},
  volume={},
  number={},
  pages={179-196},
  abstract={From a chemical point of view, dry etching and chemical vapor deposition are essentially the same. The fundamental difference is that the product is volatile after chemical reaction, which is the etching; the product is nonvolatile after chemical reaction, which is the deposition. RIE is the most used dry etching equipment. This chapter discusses RIE equipment. RIE requires a high vacuum, the turbo pump can meet this requirement. Different size of RIE chamber, the capacitance is different. So with different sizes and frequencies, the impedance of the system is also different. Because the working frequency of the supply is very high, when a supply is connected to a process chamber, it is easy to cause a problem called impedance mismatch. If more than one gas used in the etching, they are merged to one gas line after passing through the mass flow controllers and enter the process chamber through the gas inlet.},
  keywords={Silicon;Substrates;Resists;Ions;Chemicals;Wet etching;Plasmas},
  doi={10.1002/9781119867814.ch14},
  ISSN={},
  publisher={IEEE},
  isbn={9781119867791},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/9930692},}@ARTICLE{9111411,
  author={Das, Payel and Hawkins, Keith and Jofré, Paula},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Ages and kinematics of chemically selected, accreted Milky Way halo stars}, 
  year={2020},
  volume={493},
  number={1},
  pages={5195-5207},
  abstract={We exploit the [Mg/Mn]-[Al/Fe] chemical abundance plane to help identify nearby halo stars in the 14th data release from the APOGEE survey that have been accreted on to the Milky Way. Applying a Gaussian Mixture Model, we find a ‘blob’ of 856 likely accreted stars, with a low disc contamination rate of ∼7 per cent. Cross-matching the sample with the second data release from Gaia gives us access to parallaxes and apparent magnitudes, which place constraints on distances and intrinsic luminosities. Using a Bayesian isochrone pipeline, this enables us to estimate new ages for the accreted stars, with typical uncertainties of ∼20 per cent. This does not account for systematic uncertainties. Our new catalogue is further supplemented with estimates of orbital parameters. The blob stars span [Fe/H] between −2.5 to −0.5, and [Mg/Fe] between −0.1 to 0.5. They constitute ∼30 per cent of the metal-poor ([Fe/H] < −0.8) halo at [Fe/H] ∼ −1.4. Our new ages mainly range between 8 to 13 Gyr, with the oldest stars the metal-poorest, and with the highest [Mg/Fe] abundance. If the blob stars are assumed to belong to a single progenitor, the ages imply that star formation lasted 5 Gyr after which the system merged with our Milky Way around 8 Gyr ago. Dynamical arguments suggest that such a single progenitor would have had a total mass of $\sim 10^{11}\, \mathrm{M}_{\odot }$, similar to that found by other authors using chemical evolution models and simulations.},
  keywords={Galaxy: abundances;Galaxy: evolution;Galaxy: halo;Galaxy: kinematics and dynamics},
  doi={10.1093/mnras/stz3537},
  ISSN={1365-2966},
  month={Jan},}@INPROCEEDINGS{9730164,
  author={Hu, Xiangben and Jiang, Jielin and Hu, Zhichen and Huang, Tao and Xue, Shengjun and Xu, Xiaolong},
  booktitle={2021 IEEE Intl Conf on Dependable, Autonomic and Secure Computing, Intl Conf on Pervasive Intelligence and Computing, Intl Conf on Cloud and Big Data Computing, Intl Conf on Cyber Science and Technology Congress (DASC/PiCom/CBDCom/CyberSciTech)}, 
  title={DeshengNet: An Information Extraction Model for Table in Digital Documents}, 
  year={2021},
  volume={},
  number={},
  pages={567-573},
  abstract={In the scholarly literature, tables carry a huge amount of information. In the traditional information extraction of the table, researcher often spend a lot of manpower to intergrate information. Using computer vision technology can imporve the efficiency of gathering data. However, in the literature of academic, too many negative samples often lead to poor result. In response to the previous problem, this paper proposes DeshengNet based on deep learning table information extraction in digital documents. Firstly, the feature map of literature pictures is obtained through the deep residual network. Then, the multi-scale features are merged with the feature pyramid network. Afterwards, the class box subnet is used for table positioning. Aiming at the problem of too many negative samples in the paper. The focal loss method is used for training. After detection, the spatial features of the table are used for heuristic extraction. The experimental results show that the method proposed in this paper can be applied to the industrial field and serve the researcher.},
  keywords={Training;Computer vision;Fitting;Object detection;Information retrieval;Portable document format;Feature extraction;object detection;table information extraction;focal loss},
  doi={10.1109/DASC-PICom-CBDCom-CyberSciTech52372.2021.00099},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11469026,
  author={Kovvuru, Aruna Kumari and Londhe, Narendra D. and Sonawane, Rajendra S.},
  booktitle={2026 2nd International Conference on Cognitive Computing in Engineering, Communications, Sciences and Biomedical Health Informatics (IC3ECSBHI)}, 
  title={Shape Prior U-Net: Integrating Global Shape Knowledge for Accurate Psoriasis Lesion Segmentation}, 
  year={2026},
  volume={},
  number={},
  pages={675-680},
  abstract={It is challenging to segment psoriasis lesions accurately due to their irregular boundaries, heterogeneous textures, and variable shapes across different patients. The goal of this study is to create better tools for illness evaluation and determination by focusing on segmentation of psoriasis lesions, which assist in assessing the size and severity of lesions of the illness. Most typical U-Net models that are used for segmentation base their approaches on local intensity and texture features, so they are unable to capture the structural consistency of lesion shapes. To address this, we propose an advanced version of U-Net that includes a Shape Prior Module (SPM) at the bottleneck layer. By utilizing learned tokens which capture the global shape of lesions, the SPM facilitates the segmentation process. Through self-attention, these tokens are refined and used to create spatial prior maps, which assist the decoder in accurately reconstructing lesion boundaries. The model is able to merge the global shape of lesions with local features of the image, which creates a better alignment of structural and contextual features, resulting in enhanced segmentation that is resistant to noise. Experimental results show that the suggested SPM U-Net performs better than the plain U-Net, offering more accurate, consistent, and structurepreserving psoriasis lesion segmentation, with an accuracy of 0.9936 and a Dice Index (DI) of 0.9889.},
  keywords={Filtering;Filters;Central Processing Unit;System-on-chip;Circuits and systems;Pixel;Protocols;Location awareness;HTTP;Mobile communication;Self-attention;U-Net;Shape Prior Module (SPM);Psoriasis Lesion Segmentation;Deep Learning},
  doi={10.1109/IC3ECSBHI67834.2026.11469026},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{9527676,
  author={Yi, Huimin and Zhu, Ziqi and Gu, Yangwei},
  booktitle={2021 4th International Conference on Intelligent Autonomous Systems (ICoIAS)}, 
  title={Dynamic Texture Feature Extraction Based on multi-scale Convolutional Autoencoder}, 
  year={2021},
  volume={},
  number={},
  pages={108-112},
  abstract={Aiming at the difficult problem of dynamic texture feature extraction in complex scenes, this paper proposes a dynamic texture modeling method based on multi-scale convolutional autoencoder. It merges information on multiple scales of convolutional neural networks and uses an attention mechanism to increase the weight of the main channel. Finally, the loss function is optimized by calculating the errors of multiple network levels. We have conducted experiments on the DynTex database. Compared with several other typical dynamic texture feature extraction methods, the dynamic texture reconstructed by this model has the best comprehensive effect. It solves the problems of blur, noise, and residual image in the reconstruction of dynamic texture features. At the same time, the effectiveness of the modeling method is verified.},
  keywords={Databases;Autonomous systems;Feature extraction;Convolutional neural networks;Image reconstruction;dynamic texture;feature extraction;multi-scale convolutional autoencoder;texture modeling;information fusion},
  doi={10.1109/ICoIAS53694.2021.00027},
  ISSN={},
  month={May},}@INPROCEEDINGS{11453019,
  author={Zhang, Liangxing and Wang, Jian},
  booktitle={2026 International Conference on Communication Networks and Machine Learning (CNML)}, 
  title={An Efficient Helmholtz Equation Solver via Dynamic Physics-Informed Neural Networks}, 
  year={2026},
  volume={},
  number={},
  pages={1075-1080},
  abstract={Physics-Informed Neural Networks have shown great potential for solving partial differential equations. However, they face the challenge of spectral bias when addressing problems with highly oscillatory solutions, such as the Helmholtz equation. While multi-scale PINNs mitigate this issue by employing a predefined frequency dictionary, their performance heavily relies on a prior frequency selection, often resulting in initial dictionaries laden with redundant frequencies. This paper introduces a dynamic dictionary construction mechanism designed for intelligent allocation of network resources. The core of this methodology is a two-stage process: First, by applying a non-uniform fast fourier transform to analyze the spectral characteristics of the source term and boundary conditions, the dominant frequency can be automatically and reliably identified, thereby only constructing the relevant basis functions and eliminating redundancy at the source; Then, through an iterative process of training, residual analysis, and dictionary expansion, the necessary high-frequency components missing in the current solution are discovered and adaptively merged. Crucially, the dictionary expansion is guided by a criterion of relative energy contribution, ensuring that only the most significant frequencies are added at each step. Numerical experiments on 1D and 2D Helmholtz equations demonstrate that our method maintains high accuracy while significantly reducing the number of required sub-networks, effectively lowering model complexity and computational overhead.},
  keywords={Training;Dictionaries;Accuracy;Fast Fourier transforms;Neural networks;Mathematical models;Numerical models;Resource management;Reliability;Spectral analysis;Physics-informed neural networks;Helmholtz equations;High-frequency problem;Spectral bias},
  doi={10.1109/CNML68938.2026.11453019},
  ISSN={},
  month={Jan},}@ARTICLE{9521070,
  author={Pavan, Andrea and Ciolfi, Riccardo and Kalinani, Jay V and Mignone, Andrea},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Short gamma-ray burst jet propagation in binary neutron star merger environments}, 
  year={2021},
  volume={506},
  number={2},
  pages={3483-3498},
  abstract={The multimessenger event GW170817/GRB 170817A confirmed that binary neutron star (BNS) mergers can produce short gamma-ray burst (SGRB) jets. This evidence promoted new investigations on the mechanisms through which a BNS merger remnant can launch such a powerful relativistic outflow and on the propagation of the latter across the surrounding post-merger environment. In particular, great strides have been made in jet propagation models, establishing connections between the initial jet launching conditions, including the incipient jet launching time (with respect to merger) and the injection parameters, and the observable SGRB prompt and afterglow emission. However, present semi-analytical models and numerical simulations (with one notable exception) adopt simple handmade prescriptions to account for the post-merger environment, lacking a direct association with any specific merging BNS system. Here, we present the first three-dimensional relativistic hydrodynamics simulations of incipient SGRB jets propagating through a post-merger environment that is directly imported from the outcome of a previous general relativistic BNS merger simulation. Our results show that the evolution and final properties of the jet can be largely affected by the anisotropies and the deviations from axisymmetry and homologous expansion characterizing more realistic BNS merger environments. In addition, we find that the inclusion of the gravitational pull from the central compact object, often overlooked, can have a major impact. Finally, we consider different jet launching times referred to the same BNS merger model and discuss the consequences for the ultimate jet properties.},
  keywords={hydrodynamics;relativistic processes;methods: numerical;stars: jets;gamma-ray bursts;neutron star mergers},
  doi={10.1093/mnras/stab1810},
  ISSN={1365-2966},
  month={July},}@INPROCEEDINGS{9270503,
  author={Jing, KE and Fuwei, WANG and Dong, LI and Yu, KE and Buying, LI},
  booktitle={2020 International Conference on Computer Vision, Image and Deep Learning (CVIDL)}, 
  title={Research on Tree Classification Algorithm Based on Morphology and Leaf}, 
  year={2020},
  volume={},
  number={},
  pages={227-231},
  abstract={For a long time, forestry workers carry out forestry field investigation work, when they do not know the tree species, they can only search the relevant literature such as “tree annals”. The query procedure is tedious and the accuracy is not high, which seriously affects the efficiency of forestry production. In this paper, after data augmentation of tree images, GAP (Global Average Pooling) was used to fine-tune Inception-V3, ResNet50 and Xception for transfer learning. Feature vectors of the model were extracted and merged, and two feature vectors of tree overall shape and leaves were obtained through training. After feature fusion, SoftMax was used for classification, and the result of tree species determination was obtained. The practice has proved that the tree classification method proposed in this paper has a great advantage and the accuracy is higher.},
  keywords={Feature extraction;Vegetation;Training;Computational modeling;Convolution;Image recognition;Forestry;Tree Classification;Feature Extraction;Feature Fusion;Transfer Learning},
  doi={10.1109/CVIDL51233.2020.00-96},
  ISSN={},
  month={July},}@INPROCEEDINGS{9513794,
  author={Berraute, Paul and Albera, Laurent and Rochette, Michel and Merlet, Isabelle and Kachenoura, Amar},
  booktitle={2021 IEEE Statistical Signal Processing Workshop (SSP)}, 
  title={How Beamforming Can Solve The Brain Source Imaging Problem?}, 
  year={2021},
  volume={},
  number={},
  pages={171-175},
  abstract={Localizing and reconstructing the time course of spatially distributed sources from electroencephalographic recordings is a challenging task in beamforming. Indeed, the location of the dipoles constituting a given spatially distributed source must be known in advance to create a filter that will not cancel them out. In this paper, we present a new scheme named SABLE which uses Sparsity And Beamforming for brain source Localisation and Estimation without requiring such a prior. SABLE shows how the two beamforming steps (i.e. filtering and localization) can be merged and extended to deal with spatially distributed sources by modeling the hyper synchronous nature of their activity. Numerical experiments show the good behaviour of the SABLE technique in the context of epilepsy.},
  keywords={Location awareness;Array signal processing;Imaging;Epilepsy;Signal processing algorithms;Numerical models;Task analysis;Brain source imaging;inverse problem in EEG;beamforming;epilepsy},
  doi={10.1109/SSP49050.2021.9513794},
  ISSN={2693-3551},
  month={July},}@INPROCEEDINGS{10843485,
  author={Luo, Jiapeng and Chen, Xiaobing},
  booktitle={2024 IEEE International Conference on Cognitive Computing and Complex Data (ICCD)}, 
  title={An Improved NGO Algorithm for Optimizing VMD-CNN-BILSTM-Cross Attention Bearing Fault Diagnosis Method}, 
  year={2024},
  volume={},
  number={},
  pages={341-346},
  abstract={Precisely identifying the fault-related operating state of the gear-box bearing represents a vital problem within industrial production. A bearing fault diagnosis method based on effectively improved NGO algorithm optimized VMD and CNN-BILSTM-Cross Attention is proposed for bearing fault diagnosis. The method improves the NGO algorithm by introducing the SMP chaotic mapping to initialize the eagle swarm distribution, introducing the sine function and the inverse learning strategy to enhance the algorithm’s computational precision and search ability. The CNN-BILSTM model is integrated with the Cross Attention module, which aims to merge the bearing signal features in multiple ways and boost the model’s accuracy and robustness. The improved SCNGO algorithm is utilized to iteratively optimize crucial parameters, namely the intrinsic mode coefficient, and the quadratic penalty term [K, α]within the VMD denoising technology. The CNN is responsible for seizing the spatial features of the bearing vibration signal at diverse frequencies, while the BILSTM is in charge of capturing the temporal features of the same signal. Moreover, the Cross Attention mechanism is introduced to blend the spatial features extracted by the CNN and the temporal features obtained by the BILSTM. In comparison to other models, the proposed model demonstrates stronger generalization and robustness.},
  keywords={Fault diagnosis;Vibrations;Accuracy;Chaotic mapping;Computational modeling;Switched mode power supplies;Feature extraction;Data models;Robustness;Optimization;Fault diagnosis;CNN;BILSTM;VMD;Northern Goshawk Algorithm},
  doi={10.1109/ICCD62811.2024.10843485},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11409741,
  author={Sarkar, Amit and Ghoshal, Pulak and Srinivasan, P. and Dixit, Abhisek},
  booktitle={2025 IEEE 7th International Conference on Emerging Electronics (ICEE)}, 
  title={Comparative Analysis of FinFET-LDMOS Device Types for wireless RF communications and high voltage applications}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Reliability of FinFET-based LDMOS is characterized, merging FinFET scalability with LDMOS high-voltage handling for power RF and CMOS applications. Two key designs are compared: STI FinFET LDMOS and Extended Drain FinFET. Effect of Temperature on STI n-FinFET is also analyzed. It was found that with increasing temperature, device on-resistance RON and interface traps increases, threshold voltage, mobility and drift velocity decreases, while BVDSS improves. Additionally, the role of gate bias (VGS) in modulating breakdown characteristics is explored, with negative VGS shown to improve BVDSS voltage while positive VGS degrades it.},
  keywords={Wireless communication;Radio frequency;Performance evaluation;Temperature;High-voltage techniques;Logic gates;FinFETs;Threshold voltage;System-on-chip;Reliability;FinFET-based LDMOS;system-on-chip;wireless communication},
  doi={10.1109/ICEE67165.2025.11409741},
  ISSN={},
  month={Dec},}@ARTICLE{9584064,
  author={Jana, Arghajit and Kumari, Neeraj and Nandi, Prantik and Naik, Sachindra and Chatterjee, Arka and Jaisawal, Gaurava K and Hayasaki, Kimitake and Ricci, Claudio},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Broad-band X-ray observations of the 2018 outburst of the changing-look active galactic nucleus NGC 1566}, 
  year={2021},
  volume={507},
  number={1},
  pages={687-703},
  abstract={We study the nature of the changing-look active galactic nucleus NGC 1566 during its 2018 June outburst. During the outburst, the X-ray intensity of the source rises up to ∼25–30 times compared to its quiescent state intensity. We perform timing and spectral analysis of the source during pre-outburst, outburst, and post-outburst epochs using semisimultaneous observations with the XMM–Newton, Nuclear Spectroscopic Telescope Array(NuSTAR), and Neil Gehrels Swift Observatories. We calculate variance, normalized variance, and fractional rms amplitude in different energy bands to study the variability. The broad-band 0.5–70 keV spectra are fitted with phenomenological models, as well as physical models. A strong soft X-ray excess is detected in the spectra during the outburst. The soft-excess emission is found to be complex and could originate in the warm Comptonizing region in the inner accretion disc. We find that the increase in the accretion rate is responsible for the sudden rise in luminosity. This is supported by the ‘q’-shape of the hardness-intensity diagram that is generally found in outbursting black hole X-ray binaries. From our analysis, we find that NGC 1566 most likely harbours a low-spinning black hole with the spin parameter a* ∼ 0.2. We also discuss a scenario where the central core of NGC 1566 could be a merging supermassive black hole.},
  keywords={galaxies: active;galaxies: Seyfert;X-rays: galaxies;X-rays: individual: NGC 1566},
  doi={10.1093/mnras/stab2155},
  ISSN={1365-2966},
  month={Jul},}@INPROCEEDINGS{10429175,
  author={He, Qibo and Zheng, Ling and Tang, Zheng and Yang, Kun and Jiang, Nian and Wu, Qian},
  booktitle={2023 3rd International Conference on New Energy and Power Engineering (ICNEPE)}, 
  title={Layout and Wiring Algorithm for Distribution Grid Geographic Wiring Diagram Based on GIS}, 
  year={2023},
  volume={},
  number={},
  pages={1211-1216},
  abstract={There has always been an urgent demand for GIS graphic aesthetics technology among Smart Grid planner. This article proposes a distribution network GIS graphic beautification algorithm based on Tyson polygons. Firstly, several feeders with similar distances are merged into a single feeder group through buffering processing to obtain an envelope buffer zone; Then use the Tyson polygon to obtain the centerline of the buffer zone and the specific feeder segments contained in each "corridor", and arrange all feeder segments within this corridor at equal intervals; Then, the "forward and backward" method is used to obtain the connection relationship between the upper and lower segments of the entire feeder line. Finally, the relevant distribution equipment and switchgear are connected to their respective feeder segments, completing the beautification of the entire feeder line. This algorithm solves the technical difficulty of beautifying single line diagrams in distribution network GIS, enabling it to be directly used in the planning and compilation of geographical wiring diagrams in distribution networks.},
  keywords={Wiring;Substations;Switchgear;Layout;Distribution networks;Smart grids;Geographic information systems;Tyson polygon;Skeleton line;GIS geographic wiring diagram;Envelope line;Buffer},
  doi={10.1109/ICNEPE60694.2023.10429175},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11517066,
  author={Song, Zhibang and Tong, Zhiguo and Sin, Sai-Weng and Lu, Yan},
  booktitle={2026 IEEE Applied Power Electronics Conference and Exposition (APEC)}, 
  title={A Single-Stage Regulated Resonant Switched-Capacitor Converter}, 
  year={2026},
  volume={},
  number={},
  pages={2170-2174},
  abstract={Resonant switched-capacitor (ReSC) converters offer high power density and soft-charging benefits but inherently lack output-voltage regulation. Two-stage solutions address this limitation but require multiple inductors and a large intermediate capacitor, degrading efficiency and volumetric density. This work proposes a single-stage regulated ReSC that merges a direct-type ReSC with an inductor-first buck stage, eliminating the intermediate capacitor and one inductor while preserving the intrinsic soft-charging behavior of ReSC. Voltage regulation is achieved by introducing an additional duty-controlled current delivered through a switched-capacitor network. A 15V-to-5V, 10A prototype validates the concept, achieving 97.8% peak efficiency and demonstrating reduced inductor-current ripple under appropriate frequency ratios. The proposed architecture provides efficient alternative to conventional ReSC converters.},
  keywords={Current;Capacitors;Inductors;Switches;Converters;Voltage;Architecture;Computer architecture;Printing;Voltage control;DC-DC converter;resonant switched-capacitor converter;regulated ReSC},
