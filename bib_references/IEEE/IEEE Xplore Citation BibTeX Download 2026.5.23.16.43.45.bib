  author={Hamad, Khaled and Harahsheh, Bashar A. Al and Abuowaida, Suhaila and Malkawi, Mo’men and Alshdaifat, Nawaf and Alzboon, Mowafaq Salem and Al-Harahsheh, Amer},
  booktitle={2026 International Conference on Smart Multidomain Integrated Learning Environments (ICSMILE)}, 
  title={Enhanced Arabic Document Understanding Using Vision-Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Arabic Document Understanding has its own challenges, mainly due to Right-to-Left (RTL) Text Rendering Complexity, Diverse Layouts, and Merging Multi-modal Content into One Single Document. In this paper we propose a new framework for Enhanced Arabic Document Understanding based on the Qwen2-VL-2B-Instruct Vision-Language Model, which addresses the most important challenges that are related to Repetition of Text and Optimization of RTL Display. We evaluate our method on the KITAB-Bench dataset, which is a large-scale benchmark for Arabic document analysis containing optical character recognition (OCR), table extraction, and chart interpretation tasks. Our methodology consists of two main components: the adaptive repetition penalty mechanism and the specialized RTL pipeline for processing Arabic text. Our experimental results show that our framework has significantly improved the quality of the output and reduced redundancy by 67%. While Maintaining Semantic Coherence. Therefore, our proposed framework achieved competitive performance across multiple document understanding tasks, especially in the case of mixed Arabic and English content and complex tabular structures. Our contributions are as follows: (1) New Strategy to Reduce Repetition of Arabic-Generated Text, (2) Optimized RTL Rendering Pipeline to Represent Visual Representation Accurately and (3) Comprehensive Evaluation Protocols for Arabic Multi-task Document Understanding.},
  keywords={Modeling;Printing;Aluminum;Register transfer level;Optical character recognition;Equations;Visualization;Computers;Displays;Pipelines;Arabic NLP;Vision-Language Models;OCR;Table Extraction;Text Processing},
  doi={10.1109/ICSMILE69273.2026.11519242},
  ISSN={},
  month={March},}@ARTICLE{11396644,
  author={Xiao, Dedong and Wang, Yitong and Xing, Lanjing and Han, Zhongyi and Li, Tong and Wang, Chao and Chen, Sihao},
  journal={IEEE Access}, 
  title={Integrated Deep Reinforcement Learning Agent Approach for Multi-Lane Cooperative Variable Speed Limit Control}, 
  year={2026},
  volume={14},
  number={},
  pages={26278-26296},
  abstract={Given the advancements in intelligent highway management systems and connected and autonomous vehicles, precise traffic flow control via highway gantries has become feasible. Bottleneck zones caused by construction or accidents, as a primary source of highway congestion and crashes, have emerged as a key focus in proactive traffic flow management. To address the issue of conflicting gantry decisions in the context of sparse gantries, multi-lane highways, and mixed traffic flows within bottleneck zones, a coordinated speed limit control model utilizing the gantry system is proposed. This model aims to enhance safety and efficiency while maintaining energy consumption levels. Building upon this coordinated control framework, an improved neural network-based Proximal Policy Optimization integrated-agent algorithm is introduced for centralized training and decision-making. The algorithm incorporates elite experience replay, enhanced exploration, entropy regularization, and gradient clipping to improve deep reinforcement learning performance and avoid local optima. Finally, simulation via SUMO and PyTorch demonstrates that the proposed control strategy improves safety metrics by 11.6%, increases space-mean speed by 6.7%, and achieves a 1.02% reduction in energy consumption compared to real-world control strategies. The effectiveness of the proposed coordinated speed limit control model and the integrated-agent training and decision-making framework is validated against traditional models and multi-agent distributed control approaches.},
  keywords={Road transportation;Safety;Optimization;Accidents;Energy consumption;Decision making;Merging;Data models;Velocity control;Vehicle dynamics;Variable speed limit (VSL);deep reinforcement learning (DRL);centralized control;mixed traffic flow;multi-objective optimization},
  doi={10.1109/ACCESS.2026.3664403},
  ISSN={2169-3536},
  month={},}@ARTICLE{10227255,
  author={Al-Tameemi, Israa Khalaf Salman and Feizi-Derakhshi, Mohammad-Reza and Pashazadeh, Saeid and Asadpour, Mohammad},
  journal={IEEE Access}, 
  title={Interpretable Multimodal Sentiment Classification Using Deep Multi-View Attentive Network of Image and Text Data}, 
  year={2023},
  volume={11},
  number={},
  pages={91060-91081},
  abstract={Multimodal data can convey user emotions and feelings more effectively and interactively than unimodal content. Thus, multimodal sentiment analysis (MSA) research has recently acquired great significance as a field of study. However, most current approaches either acquire sentimental features independently for each modality or simply combine multiple modal features. Thus, semantic details pertinent to sentiment analysis and the relationship between visual and textual content are neglected. Furthermore, most available multimodal datasets are sentiment-annotated, although user emotions are usually rich and unlimited. Motivated by these observations, this paper proposes a novel deep multi-view attentive network (DMVAN) for robust multimodal sentiment and emotion classification. The DMVAN model has three phases: feature learning, attentive interaction learning, and cross-modal fusion learning. During the feature learning phase, visual features from a multi-view perspective (region and scene) and textual features from various levels of analysis (word, sentence, and document) are extracted to capture information effectively for accurate classification. In the attentive interaction learning phase, the image-text interaction learning mechanism is employed to enhance visual and textual information interaction by extracting sentimental and discriminative visual features and utilizing the textual information to guide the learning process of image features. Moreover, a cross-modal fusion learning module is developed to incorporate different features into a comprehensive framework that takes advantage of the complementary aspects of multiple modalities. Then, a multi-head attention mechanism is employed to extract and merge sufficient data from the intermediate features, thereby aiding in developing a robust joint representation. Finally, a multi-layer perceptron with multiple stacking-fully connected layers is used to deeply fuse the modal features, thereby enhancing sentiment classification performance. An interpretable multimodal sentiment classification model is further developed utilizing the local interpretable model-agnostic explanation model (LIME) to ensure the model’s explainability and strength. To perform a multimodal emotion classification, an image-text emotion dataset named Emotion-Getty (EMO-G) is constructed from Getty Images and labeled by distinct emotions. The proposed model is tested on three real-world datasets, attaining 99.801% accuracy on Binary_Getty (BG), 96.867% on Twitter, and 96.174% on the EMO-G dataset. These results show that the suggested model outperforms single-model techniques and current state-of-the-art methodologies based on model evaluation criteria.},
  keywords={Visualization;Feature extraction;Task analysis;Semantics;Data mining;Representation learning;Correlation;Sentiment analysis;Deep learning;Multisensory integration;Multimodal sentiment analysis;attention mechanism;deep learning;deep multi-view attentive network;interpretability},
  doi={10.1109/ACCESS.2023.3307716},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11176710,
  author={Wasnik, Harsh Homdeo and Shrivastava, Tushar},
  booktitle={2025 8th International Conference on Circuit, Power & Computing Technologies (ICCPCT)}, 
  title={Adaptive Machine Learning Frameworks Integrating LLMs and Knowledge Graphs for Tailored Education}, 
  year={2025},
  volume={},
  number={},
  pages={1509-1514},
  abstract={Recent advancements in artificial intelligence have paved the way for innovative personalized education through Interactive Machine Learning Systems (IMLS). This study explores how combining large language models (LLMs) with knowledge graphs (KGs) within IMLS can create adaptive, customized learning experiences. Leveraging the sophisticated natural language understanding and generation capabilities of LLMs, the system enables dynamic interactions between learners and educational content, offering real-time feedback and personalized guidance. At the same time, knowledge graphs provide a well-organized framework for structuring educational materials, detailing the relationships among concepts, skills, and learner profiles. By integrating these technologies, the system can intelligently assess individual learner needs, predict learning trajectories, and tailor instructional strategies accordingly. Empirical evaluations across various educational settings have shown significant enhancements in learner engagement, knowledge retention, and overall academic performance. This research highlights the promising potential of merging advanced language models with semantic knowledge representations to develop scalable and effective personalized education solutions that cater to the unique needs of every learner. This study addresses the existing gap in combining large language models and knowledge graphs for personalized education by proposing a novel integrated framework. Our empirical results demonstrate significant improvements in learner engagement and knowledge retention, highlighting the robustness and scalability of the approach.},
  keywords={Adaptive learning;Large language models;Scalability;Semantics;Knowledge graphs;Robustness;Real-time systems;Natural language processing;Trajectory;Standards;Personalized education;Interactive machine learning systems;Large language models;Knowledge graphs;Adaptive learning;Semantic knowledge representation},
  doi={10.1109/ICCPCT65132.2025.11176710},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11379082,
  author={Sarkar, Sujit and Jayadevan, R and Sharma, Neha and Pandey, Mrityunjoy},
  booktitle={2025 IEEE Pune Section International Conference (PuneCon)}, 
  title={Enhancing Handwritten Answer Sheet Evaluation Through Large Language Models and Multi-Agent Reasoning}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Accurate and timely evaluation of handwritten exam answer sheets remains a major challenge in educational institutions, especially for large-scale assessments. Manual grading is time-consuming, prone to inconsistencies, and often leads to delayed feedback for students. Although OCR-based grading systems exist, their accuracy is often insufficient for realworld deployment due to handwritten script variability. Recent advances in artificial intelligence, particularly large language models (LLMs), offer promising solutions to this problem. This paper presents an automated grading system that combines image preprocessing, advanced OCR, and LLM-based evaluation. Gemini Flash Thinking is employed for OCR, achieving up to 98% character-level accuracy on a benchmark of 100 answer scripts. Each extracted answer block is mapped to its respective question using a likelihood-based merge sort prompt augmented with semantic entailment scoring. This ensures contextual accuracy in matching even for incomplete or misaligned responses. Following mapping, a multi-agentic evaluation strategy is introduced using simulated professor agents for collaborative grading. These agents assess content relevance, coverage, and structure, while providing constructive feedback and rubricbased scoring. The proposed pipeline significantly reduces human intervention while maintaining grading consistency and fairness. It offers a scalable, explainable, and institution-ready solution for automated subjective answer evaluation.},
  keywords={Technological innovation;Accuracy;Large language models;Optical character recognition;Semantics;Pipelines;Manuals;Writing;Reliability;Multi-agent systems;Automated Grading System;Optical Character Recognition (OCR);Large Language Models (LLMs);Gemini API;Multi-Agent Systems;Zero-Shot OCR Prompting;Semantic Answer Evaluation},
  doi={10.1109/PuneCon67554.2025.11379082},
  ISSN={2831-5022},
  month={Dec},}@INPROCEEDINGS{11385550,
  author={Morasani, Lavanya and G, Mamatha and Upendra, Badana and Veeraiah, Vivek and Gupta, Ankur and Mishra, Krishna Nand},
  booktitle={2025 International Conference on Innovations and Emerging Technologies In AI & Communication Systems (IETACS)}, 
  title={Deploying Context-Aware AI Tools for Internal Organizational Communication}, 
  year={2025},
  volume={},
  number={},
  pages={932-937},
  abstract={As the use of hybrid workplaces and digital transformation becomes more widespread, organizations are in need of intelligent technologies that are able to collaborate in ways that traditional artificial intelligence is unable to. The purpose of this study is to analyze the approach that context-aware artificial intelligence systems use to evaluate user roles, activities, locations, task statuses, and interaction histories in order to revolutionize interpersonal communication. With the purpose of determining the most successful methods in which context-aware artificial intelligence improves communication via enhanced customization, efficiency, and appropriateness, this study conducts an analysis of twenty-five current research originating from academic and industrial sources. We want a multi-level system that merges machine learning, natural language processing, and semantic reasoning in order to achieve better and more real-time communication. It has been shown by the results of the review that there have been significant shifts in the amount of time required to complete tasks, the level of contentment experienced by users, and the degree of discomfort experienced by users when conversing with other individuals. The study investigates the safety of data, the degree to which individuals have faith in the system, the way in which the system functions as whole, and the methods for dealing with ambiguity. By doing a substantial amount of research and putting prototypes through rigorous testing, businesses have the potential to design communication systems that are honest, adaptable, and ready to expand. In this study, we present novel approaches to learning that safeguard individuals' privacy, provide light on artificial intelligence, and include multi-modal context modeling.},
  keywords={Communication systems;Reviews;Industrial communication;Semantics;Machine learning;System integration;Remote working;Safety;Artificial intelligence;Testing;Organizational Communication;AI;Internal Communication Systems;Machine Learning;NLP;Human-AI Collaboration},
  doi={10.1109/IETACS68750.2025.11385550},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11318908,
  author={Wattanasuwan, Kittipat and Mangkala, Atikan and Kitchon, Panat and Fugkeaw, Somchart},
  booktitle={2025 Thirteenth International Symposium on Computing and Networking Workshops (CANDARW)}, 
  title={A Dynamic XSS Attack Detection System with Realtime and Fast Response based on Transformer Learning Model and Adaptive Rule-based System}, 
  year={2025},
  volume={},
  number={},
  pages={210-216},
  abstract={Cross-site scripting (XSS) is a prevalent vulnerability found in web applications, allowing attackers to compromise user sessions, manipulate, read, and delete business data within web applications, insert malicious code, and manipulate victims into launching attacks on other specified servers. While existing solutions typically rely on machine learning techniques to identify both evident and sophisticated attacks, many of these approaches neglect the detection performance. This paper presents an innovative approach to identify XSS attacks in web applications. It merges rule-based defenses employing regular expressions to filter out prevalent attack patterns with a Transformer-based anomaly detection model, leveraging CodeBERT as the pretrained language model to detect diverse malicious XSS codes. The detected and recognized attack patterns are adaptively stored in the rule-based system to support fast detection. The segmentation of web access inputs using regular expressions significantly aids in training the Transformer engine model. The model is additionally capable of learning and retaining the attack patterns, utilizing them as signatures for prompt detection in subsequent instances. Experiments show that our proposed approach can both efficiently speed up the detection of the attack and significantly enhance the accuracy of the detection of XSS attacks compared to related techniques.},
  keywords={Training;Adaptation models;Cross-site scripting;Computational modeling;Machine learning;Transformers;Information filters;Malware;Pattern recognition;Servers;Cross-site Scripting;XSS Attack;Transformer;CodeBERT;Machine Learning Model;Rule-based},
  doi={10.1109/CANDARW68385.2025.00044},
  ISSN={2832-1324},
  month={Nov},}@ARTICLE{9269397,
  author={Qi, Wenlong and Wang, Minghao and Li, Sinan},
  journal={IEEE Journal on Emerging and Selected Topics in Circuits and Systems}, 
  title={Transformerless Three-Level Flying-Capacitor Step-Up PV Micro-Inverter Without Electrolytic Capacitors}, 
  year={2021},
  volume={11},
  number={1},
  pages={49-58},
  abstract={Voltage step-up, DC/AC inversion, and active pulsating-power-buffering are three indispensable functions of next-generation PV micro-inverters. Conventionally, these three functions are realized by separate power-conversion stages, resulting in lower conversion efficiency and a higher cost. In this paper, a new hybrid topology capable of merging all three functions into a single power-conversion stage is proposed. The topology enjoys all the benefits of system integration, including simple circuit structure and low bill-of-materials. It also features low voltage stresses, significantly reduced energy storage requirement of the passive components, and low leakage current, potentially leading to highly compact and high efficiency design. A 60-W hardware prototype is built to demonstrate the feasibility of the proposed inverter. An efficiency over 95% across a wide load range has been experimentally obtained.},
  keywords={Inverters;Capacitors;Topology;Power system measurements;Density measurement;Switches;Inductors;Active power decoupling;three-level flying capacitor;micro-inverter},
  doi={10.1109/JETCAS.2020.3039284},
  ISSN={2156-3365},
  month={March},}@INPROCEEDINGS{10934416,
  author={Huang, Lingyan and Zheng, Yuhuang},
  booktitle={2025 International Conference on Intelligent Systems and Computational Networks (ICISCN)}, 
  title={Design and Application of Experiential Music Teaching System based on Java 2 Enterprise Edition Architecture}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={With the rapid advancement of artificial intelligence (AI) and web-based technologies, music education has evolved beyond conventional teaching methodologies, offering more interactive and adaptive learning experiences. This paper presents the design and application of an Experiential Music Teaching System based on J2EE (Java 2 Enterprise Edition) architecture, integrating AI-driven techniques to enhance personalized learning, automatic assessment, and real-time feedback. The system is structured using a three-tier architecture, consisting of a presentation layer (UI), business logic layer (middleware), and data layer (database), ensuring scalability, flexibility, and seamless user interaction. To deliver personalized learning experiences, AI algorithms Reinforcement Learning (RL) are leveraged to recommend music lessons tailored to an individual's progress, learning style, and skill level. The AI models analyse user performance data, adjusting lesson plans dynamically to optimize the learning curve. Additionally, deep learning techniques enable automatic assessment of instrumental and vocal performances, analyzing audio features such as pitch, rhythm, and tone for accurate evaluation. The J2EE-based system ensures seamless integration of AI models through RESTful APIs, allowing real-time data exchange between the front-end and back-end services. This architecture facilitates an efficient and responsive environment where students can practice, receive instant feedback, and track their progress over time. By merging AI-powered analytics with modern music pedagogy, the system bridges the gap between traditional music instruction and digital learning environments, offering students an interactive, self-paced, and feedback-driven approach to mastering musical skills. Future enhancements may incorporate gesture recognition for instrument training, AI-assisted composition tools, and adaptive tutoring strategies to further refine the learning process.},
  keywords={Java;Adaptive learning;Scalability;Instruments;Education;Reinforcement learning;Rhythm;Real-time systems;Data models;Artificial intelligence;artificial intelligence (AI);J2EE-based implementation;automatic assessment;reinforcement learning (RL)},
  doi={10.1109/ICISCN64258.2025.10934416},
