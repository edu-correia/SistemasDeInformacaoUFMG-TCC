@ARTICLE{11214163,
  author={Chi, Fangyuan and Wang, Yixiao and Nasiopoulos, Panos and Leung, Victor C. M.},
  journal={IEEE Internet of Things Journal}, 
  title={Multiagent Collaborative Decision-Making Using Small Vision–Language Models for Autonomous Driving}, 
  year={2025},
  volume={12},
  number={24},
  pages={55344-55355},
  abstract={Autonomous vehicles face challenges in complex environments due to the computational inefficiency of large language models (LLMs) and the lack of multiagent collaboration in existing decision-making approaches. This article proposes a small vision–language model (VLM)-based framework for connected autonomous vehicles (CAVs), balancing computational efficiency with robust reasoning and perception. The framework integrates a perception module with mapping and annotation layers to provide visual and contextual information. To enhance decision-making, we introduce domain-augmented chain-of-thought (DACoT), enabling context-aware planning and negotiation for multiagent coordination. In intersection scenarios, DACoT improves success steps (SS) by 28.9% and pass rate (PR) by 24.2% over CoT and SS by 57.2% and PR by 48.2% over direct prompting. In highway merging, DACoT achieves 19.6% higher SS and 99.97% higher PR than CoT. These results highlight DACoT’s adaptability in complex multiagent interactions, establishing an efficient, scalable, and collaborative decision-making framework for real-time autonomous driving.},
  keywords={Decision making;Cognition;Autonomous vehicles;Collaboration;Visualization;Real-time systems;Computational efficiency;Planning;Accuracy;Safety;Autonomous driving;collaborative;decision-making;large language models (LLMs);multiagent;vision–language models (VLMs)},
  doi={10.1109/JIOT.2025.3624038},
  ISSN={2327-4662},
  month={Dec},}@INPROCEEDINGS{11383074,
  author={Dargar, Abha and Reddy, Burjukati Govardhan and Navylatha, Madaka and S, Devadharshini},
  booktitle={2025 5th International Conference on Evolutionary Computing and Mobile Sustainable Networks (ICECMSN)}, 
  title={Solar-Powered Hand Gesture-Controlled Compact Lawn Mower}, 
  year={2025},
  volume={},
  number={},
  pages={1538-1545},
  abstract={Continuous innovation in embedded systems and renewable energy integration has transformed automation in both agricultural and domestic sectors. This work presents the design and development of a solar-powered, hand gesture– controlled compact lawn mower for efficient and sustainable garden maintenance. The system employs an ADXL335 accelerometer to detect hand gestures and an HT12E, HT12D RF communication module to transmit directional commands to the mower, enabling forward, reverse, left, and right motion through simple hand tilts. An ultrasonic sensor monitors the ground and triggers the cutting motor only when grass or obstacles are detected within a defined threshold, optimizing energy consumption and ensuring safety. The entire system is powered by a solar panel charging an onboard battery, enabling off-grid operation and eliminating dependence on conventional electricity or fossil fuels. All subsystems including direction control logic, obstacle detection, solar charging circuitry, and embedded Arduino programming were designed, simulated, and tested to verify stable real-world performance. Integration of wireless gesture control with automatic grass cutting significantly reduces manual effort and environmental impact while enhancing accessibility for people with reduced mobility. This prototype represents an environmentally friendly and user-oriented approach to lawn care, merging renewable energy, embedded programming, and intelligent control for future fully autonomous, energy-efficient lawn maintenance systems.},
  keywords={Hands;Wireless communication;Wireless sensor networks;Renewable energy sources;Automation;Prototypes;Solar energy;Programming;Robot sensing systems;Maintenance;Solar energy;Hand gesture control;Embedded systems;Renewable automation;Arduino;Wireless communication;Sustainable robotics;Smart lawn mower},
  doi={10.1109/ICECMSN68058.2025.11383074},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11385586,
