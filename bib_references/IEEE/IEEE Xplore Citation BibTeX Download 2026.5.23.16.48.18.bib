  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10830658},}@INPROCEEDINGS{11403899,
  author={Latif, Rana Muhammad Amir and Ullah, Farhan and Raza, Umar and Fatima, Areej and Zhao, Yue and Touray, Barra},
  booktitle={2025 International Conference on AI-Driven STEM Education and Learning Technologies (AISTEMEDU)}, 
  title={Optimization Algorithms for Renewable Energy Resource Allocation in Urban STEM Camps}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Allocation of renewable energy through efficient means is paramount to sustainable urban infrastructures, especially in active learning settings like STEM camps. This paper compares the five optimization algorithms of Mixed- Integer Linear Programming (MILP), Genetic Algorithms (GA), Particle Swarm Optimization (PSO), Ant Colony Optimization (ACO), and Reinforcement Learning (RL) to a simulated microgrid of solar PV, wind turbine, battery storage, and limited grid backup. The algorithms are differentiated in terms of cost efficiency, use of renewable energy, reliability, carbon reduction, and computation time. Findings indicate that MILP is better at maintaining consistency and poor at dealing with uncertainty, whereas PSO is better at maintaining the best speed and efficiency. With the increased computational cost, RW is the most systematic and reliable, with the most significant renewable utilization (83.7%). The results indicate the trade- offs between accuracy, adaptability, and computation, and the significance of environment-sensitive algorithm choice. The research paper ends with suggesting hybrid frameworks, which merge deterministic and learning-based models to maximize scalability, transparency, and sustainability in practical STEM- camp microgrids.},
  keywords={Renewable energy sources;Uncertainty;Systematics;Microgrids;Reinforcement learning;Computational efficiency;Wind turbines;Resource management;Reliability;Genetic algorithms;Renewable Energy Optimization;STEM Camps;Metaheuristic Algorithms;Reinforcement Learning;Sustainable Microgrids},
  doi={10.1109/AISTEMEDU67077.2025.11403899},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10921993,
  author={Mohandas, Parthiban and Duraipandian, Amaravathi and Durgarao, Vasa Sai and Sujith, Kada Rama and Girjhan, Dulapalli and Pramod, Toleti},
  booktitle={2024 International Conference on Computing and Intelligent Reality Technologies (ICCIRT)}, 
  title={Harnessing Machine Learning and Image Processing for Prompt Disease Detection in Ocimum tenuiflorum Cultivation}, 
  year={2024},
  volume={},
  number={},
  pages={171-176},
  abstract={The agricultural landscape of India, a cornerstone of its economy, faces significant challenges in the early detection of leaf diseases, particularly in the cultivation of Ocimumtenuiflorum, widely revered for its medicinal properties. This study innovatively employs advanced image-processing techniques combined with machine learning algorithms to enhance the accuracy and efficiency of identifying infections in Holy Basil plants. Utilizing a comprehensive dataset sourced from Plant Village, which includes various infected leaf types and healthy specimens, we implemented a robust framework for image augmentation, preprocessing, and feature extraction. Our evaluation of multiple machine learning classifiers reveals that the random forest algorithm achieves the highest accuracy of $\mathbf{99.86\%}$, effectively outperforming other models such as linear discriminant analysis and support vector machines. By merging traditional agricultural knowledge with modern computational tools, this research not only demonstrates a novel approach to disease management in Ocimumtenuiflorum but also underscores the potential for technology to transform agricultural practices, promoting sustainability and enhancing crop productivity in India.},
  keywords={Support vector machines;Productivity;Accuracy;Machine learning algorithms;Computational modeling;Crops;Linear discriminant analysis;Internet of Things;Random forests;Diseases;Ocimumtenuiflorum;Machine Learning;Disease Management;Image Processing;Internet of Things},
  doi={10.1109/ICCIRT59484.2024.10921993},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11233435,
  author={S, Nishanthini and Albeez, Syed Fakruddin and Manikandan, G. and Chandra Dev, Nakka Kishore and Chatterjee, Banashree and Kaliappan, S.},
  booktitle={2025 3rd World Conference on Communication & Computing (WCONF)}, 
  title={A Deep Learning-Based Predictive Policing Model for Real-Time Crime Risk Assessment in Urban India}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The proposed solution to the increase in urban crime in India is to employ artificial intelligence to predict criminal behavior. As a result, this study presents a novel artificial intelligence-based system that uses a mix of machine learning, computer vision, and natural language processing to predict criminal activities. It uses a variety of data sources, including social media, socioeconomic factors, past crime reports, CCTV video, and others, to generate real-time forecasts of where crime is most likely to occur. The suggested solution, which merges CNN and RNN, improves the accuracy of predictions and boosts the techniques employed in law enforcement. These indicate that crime rates in high-risk regions have decreased by 15%, police response times have decreased by 35%, and the accuracy of predictions has decreased by 28%. Consequently, this technology has the ability to change the way that crime is prevented in cities across India by using a data-driven and proactive approach to policing. In addition, it will improve public safety and make better use of scarce resources.},
  keywords={Accuracy;Law enforcement;Social networking (online);Soft sensors;Heuristic algorithms;Urban areas;Prediction algorithms;Real-time systems;Time factors;Videos;Predictive Policing;Artificial Intelligence;Crime Prediction;Urban India;Machine Learning},
  doi={10.1109/WCONF64849.2025.11233435},
  ISSN={},
  month={July},}@INPROCEEDINGS{11437277,
  author={M, Suresh and Jayaprakash, M},
  booktitle={2026 5th International Conference on Communication, Computing and Electronics Systems (ICCCES)}, 
  title={Blockchain-Enabled Iot Framework for Secure and Transparent Smart City Data Management}, 
  year={2026},
  volume={},
  number={},
  pages={719-726},
  abstract={The accelerating pace of urbanization and the increasing implementation of intelligent urban development projects have resulted in the widespread deployment of extensive Internet of Things (IoT) networks. These networks facilitate the continuous observation of transportation flow, power usage, waste disposal, and ecological states. Although these systems generate vast quantities of information, safeguarding the dependability, confidentiality, and protection of this information represents a significant impediment. Conventional, consolidated system designs are susceptible to electronic attacks, data manipulation, and singular failure instances, which may undermine public confidence and operational effectiveness. This paper introduces an IoT infrastructure for intelligent urban environments, fortified by blockchain technology. This architecture capitalizes on the unalterable and decentralized nature of distributed ledger technology to improve information protection and openness. The framework integrates IoT sensors with blockchain-based information repositories, facilitating secure, verifiable, and manipulation-resistant information exchange between diverse elements within the urban ecosystem. Moreover, the architecture employs intelligent agreements to automate continuous verification, service access regulation, and irregularity detection, thereby minimizing management burden and the necessity for human oversight. Experimental simulations suggest that the proposed architecture substantially enhances information dependability, robustness against electronic hazards, and openness compared to standard, consolidated IoT systems. The framework also promotes extensibility and compatibility across a spectrum of urban services, presenting a pragmatic solution for urban centers seeking secure, dependable, and citizen-focused IoT implementations. This investigation underscores the capacity of merging IoT and blockchain technologies to establish dependable intelligent urban ecosystems and provides a basis for forthcoming urban digital infrastructures.},
  keywords={Smart cities;Distributed ledger;Smart contracts;Ecosystems;Urban planning;Real-time systems;Blockchains;Internet of Things;Protection;Waste disposal;IoT;Blockchain;Smart Cities;Distributed Ledger;Data Security;Smart Contracts;Real-Time Monitoring;Urban Analytics;Cybersecurity;Transparent Systems},
  doi={10.1109/ICCCES62661.2026.11437277},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11335966,
  author={Tripathi, Pragati and Rahul, B and Saini, Mrinank Kumar and Kashyap, Sankalpa and Mukherjee, Jaydeep and Ghosh, Kiran},
  booktitle={2025 Third International Conference on Emerging Applications of Material Science and Technology (ICEAMST)}, 
  title={Climate - Adaptive IoT Drip Irrigation System}, 
  year={2025},
  volume={},
  number={},
  pages={437-442},
  abstract={Traditional irrigation methods are inefficient and unsustainable due to unpredictable weather conditions and limited water resources, making traditional irrigation methods inefficient and unsustainable. Most of the existing IoT-based irrigation systems fail to fully integrate environmental data or provide reliable remote control and scalability. To overcome these gaps, this study proposes a Climate-Adaptive IoT Drip Irrigation System that uses real-time soil moisture readings and live weather information from APIs to automate water delivery. The system employs a network of soil moisture and climate sensors connected to a scalable microcontroller, communicating through the lightweight MQTT protocol with a Node.js or GO lang based cloud backend. A user-friendly web dashboard enables farmers to monitor field conditions and manually override irrigation when necessary. Simulations demonstrate improved water efficiency, reduced manual intervention, and enhanced reliability compared to conventional setups. By merging IoT technology with adaptive climate awareness, this system offers a sustainable and scalable solution that supports precision agriculture and promotes responsible water management in modern farming.},
  keywords={Weather;Precision agriculture;Irrigation;Climate;Adaptive systems;Soil moisture;Internet of Things;Reliability;Water resources;Farming;Internet of Things (IoT);Smart Irrigation;Drip Irrigation;Climate-Adaptive Agriculture;Soil Moisture Sensor;MQTT;Node.js;Remote Monitoring;Sustainable Farming;Precision Agriculture},
  doi={10.1109/ICEAMST67459.2025.11335966},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10775003,
  author={Kurnala, Vishnu},
  booktitle={2024 3rd International Conference for Advancement in Technology (ICONAT)}, 
  title={Enhancing Healthcare Data Security through Blockchain-Enhanced IDPS and Multi-Layered Firewall System}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper introduces a novel security framework to fortify healthcare data against cyber threats, incorporating blockchain technology and ledger tokenization within an integrated Intrusion Detection and Protection System (IDPS). Faced with escalating cybersecurity challenges, our approach merges traditional protection mechanisms with cutting-edge technologies to offer unparalleled data integrity and security. By leveraging blockchain for immutable data trails and enhancing IDPS with advanced machine learning techniques, our solution provides a robust defense against a range of cyber threats, including ransomware and data breaches. Extensive testing in simulated environments confirms the effectiveness of our system, suggesting it as a viable blueprint for future developments in healthcare cybersecurity. This study not only demonstrates the application of blockchain in enhancing data security but also sets the stage for further innovative practices in protecting sensitive healthcare information.},
  keywords={Firewalls (computing);Data integrity;Intrusion detection;Medical services;Machine learning;Tokenization;Blockchains;Ransomware;Protection;Testing;Blockchain;Ledger Tokenization;IDPS;Data Integrity;Ransomware Protection},
  doi={10.1109/ICONAT61936.2024.10775003},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11459793,
  author={Meenakshisundaram, N. and Sajiv.G},
  booktitle={2025 6th International Conference on Smart Electronics and Communication (ICOSEC)}, 
  title={A Fuzzy Logic-Driven GAN Architecture for Personalized Diagnostics in 6G-Enabled Healthcare Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1013-1018},
  abstract={Intelligent, real-time, and individualized medical solutions are becoming possible because to the merging of next-generation technologies like 6G connection, fuzzy logic, and generative adversarial networks (GANs). This is revolutionizing healthcare diagnostics. Developed with 6G-enabled healthcare systems in mind, this study introduces a new architecture for generative adversarial networks called FL-GAN. The suggested architecture makes use of 6G’s enormous bandwidth and extremely low latency to analyze and transmit high-dimensional medical data without any hitches. By efficiently addressing clinical data’ ambiguity and imprecision, fuzzy logic improves diagnostic decision-making. Data augmentation and privacy preservation are both facilitated by GANs, which are used to create synthetic medical images and patient data that look realistic. The combination of these elements allows for diagnostics that are adaptable, cognizant of context, and customized to each patient’s profile. When compared to traditional deep learning methods, experimental tests on benchmark datasets show that the FL-GAN architecture improves diagnostic accuracy, interpretability, and latency. For future communication infrastructures, the suggested paradigm provides an intelligent and scalable solution for precision-driven healthcare in real-time.},
  keywords={Radio broadcasting;Frequency modulation;Filtering;Filters;MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits;Communication systems;Internet of Things;Internet;6G-enabled healthcare;Fuzzy logic;Generative Adversarial Networks (GANs);FL-GAN;Personalized diagnostics;medical data augmentation;Real-time healthcare;Privacy-preserving AI;Context-aware systems;Precision medicine},
  doi={10.1109/ICOSEC67334.2025.11459793},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11031751,
  author={Ashok, P and Durge, Abhijit Sambhaji},
  booktitle={2025 International Conference on Data Science and Business Systems (ICDSBS)}, 
  title={Fraud Detection and Prevention in Healthcare Insurance Claims Using Machine Learning Regression Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Health insurance fraud is a serious problem that upsets much of the financial stability among insurance companies and policyholders in general. It's estimated that healthcare fraud costs the U.S. health care system around $68 billion each year, as it drives up premiums and limits access to care for legitimate patients in search of care. Traditional methods such as manual review and also rule-based systems have shown to be very weak in regard to the sophisticated natures of illicit schemes that have dynamic characteristics. This research paper discusses how machine learning regression models aid in fraud detection and prevention applications in healthcare insurance claims. By minimizing advanced use in real-time data processing and advanced analytics, patterns of behavior that reflect fraud are recognizably detected, thus providing more accuracy in fraud detection. The paper goes further to cover the theoretical framework of machine learning in fraud detection, which includes data preprocessing, engineering the features, and evaluating the models. It emphasizes the merging of historical claims data with external sources to build a holistic dataset that will train a more powerful machine learning model. It discusses the need for continuous adaptability of models due to fraud changes over time. Besides, the paper gives some industry statistics that help illustrate healthcare fraud's financial effects and its incremental benefits from using machine learning technology. The research contributes to the continuing conversation regarding innovative solutions to fraud detection in health care, creating pathways for future research and development in this important domain.},
  keywords={Adaptation models;Accuracy;Prevention and mitigation;Insurance;Machine learning;Medical services;Data science;Real-time systems;Data models;Fraud;Machine Learning;Fraud detection;intelligent systems;healthcare insurance;data science;artificial intelligence},
  doi={10.1109/ICDSBS63635.2025.11031751},
  ISSN={},
  month={April},}@ARTICLE{11099528,
  author={Xu, Yuan and Jiang, Lin and Li, Yunfei and Wan, Le and Zhu, Jianyang},
  journal={IEEE Transactions on Industrial Informatics}, 
  title={Real-Time HSV Transparent Object Shape Extraction and Projection}, 
  year={2025},
  volume={21},
  number={11},
  pages={8518-8528},
  abstract={The existing mapping strategy based on Lidar and camera cannot support transparent object avoidance that is hard to recognize. To overcome this, we present a real-time and reliable detection approach to project transparent obstacle shapes in true size into map. To distinguish transparent object from environment, an extraction algorithm is proposed. Object shapes and sizes are kept in high accuracy by processing the extracted image in hue, saturation, and value channels to refine and merge candidate regions with different value and saturation under continuity constraints. We then build a projection map of transparent objects to facilitate obstacle avoidance. The size and shape comparison experiments in a series of pitch angle at different distances are conducted as the supplementary of angle selection to ensure high shape and size accuracy. Experiments indicate that proposed methods enable robot to conduct map construction and transparent obstacle avoidance in real-time.},
  keywords={Cameras;Reflection;Shape measurement;Feature extraction;Image edge detection;Accuracy;Image segmentation;Glass;Collision avoidance;Visualization;Map construction;obstacle avoidance;shape extraction;transparent object recognition},
  doi={10.1109/TII.2025.3584463},
  ISSN={1941-0050},
  month={Nov},}@INPROCEEDINGS{11381739,
  author={Ahmed, Rahik and Aurnima, Samma-E-Aunjum and Pranto, Md. Appel Mahmud and Tamanna, Rafia and Hossain, A. B. M. Kabir},
  booktitle={2025 IEEE 2nd International Conference on Computing, Applications and Systems (COMPAS)}, 
  title={Machine Learning-Driven Early Warning System for Epidemic and Pandemic Outbreaks with Explainable AI}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper describes a machine learning–driven early warning system for predicting hospitalizations and outbreak trends of diseases like COVID-19, Influenza, and RSV. Using a merged CDC dataset containing 257,388 records, the system leverages advanced feature engineering and a novel outbreak labeling strategy based on disease-specific thresholds. Models including LSTM, Random Forest, LightGBM, and XGBoost were evaluated, achieving 93.6 percent classification accuracy and 97 percent regression accuracy. To enhance interpretability, SHAP-based Explainable AI techniques were integrated, offering transparent insights into feature importance and model decisions. The combination of high accuracy and explainability ensures practical utility in real-time epidemic surveillance and public health readiness.},
  keywords={COVID-19;Accuracy;Pandemics;Explainable AI;Surveillance;Time series analysis;Influenza;Alarm systems;Labeling;Random forests;Epidemic Prediction;Pandemic Surveillance;Machine Learning;Explainable AI;SHAP;XGBoost;Influenza;COVID-19;RSV},
  doi={10.1109/COMPAS67506.2025.11381739},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11430118,
  author={Hazarika, Anakhi and Dilip, Deepthi M. and Rahman, Raziur and Deka, Aniruddha},
  booktitle={2025 IEEE International Conference on Advanced Networks and Telecommunications Systems (ANTS)}, 
  title={A Physics-Informed Digital Twin for Asphalt Pavement Health Monitoring in IoT Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Asphalt pavements are aging under rising traffic loads and increasingly extreme climates, yet most asset-management workflows remain reactive, relying on periodic surveys or empirical models that do not continuously reflect evolving material states. This paper presents a physics-informed neural network (PINN) framework for structural health monitoring of asphalt pavements subjected to extreme environmental stressors such as temperature, moisture, water-logging, rainfall, and UV exposure. A hybrid dataset is assembled by merging Long-Term Pavement Performance and TxDOT records with synthetically generated extreme-event scenarios and accelerated testing surrogates. The proposed PINN model augments data with mechanistic features and employs physics-based regularization to enforce monotonic and saturation behaviors. Trained and evaluated with scikit-learn and PyTorch, the model predicts remaining service life (RSL) with high fidelity (test R2 =0.92, RMSE = 1.5 years) that outperforms standard ANN and a mechanistic-empirical regression. Case studies show accurate RSL adjustment after a flood and sensitivity to heat and UV aging. The approach enables proactive, climate-aware pavement maintenance decision-making and demonstrates how AI-driven digital twins, when coupled with distributed sensing and edge computing can enable scalable, communication-aware solutions for infrastructure resilience in future 6G IoT networks.},
  keywords={Knowledge engineering;Asphalt;Neural networks;Moisture;Machine learning;Predictive models;Aging;Data models;Digital twins;Monitoring;Asphalt pavement;Internet-of-Things (IoT) Machine Learning;Remaining service life prediction;Structural Health Monitoring (SHM)},
  doi={10.1109/ANTS66931.2025.11430118},
  ISSN={2153-1684},
  month={Dec},}@ARTICLE{8915773,
  author={Song, Weidong and Jia, Guohui and Jia, Di and Zhu, Hong},
  journal={IEEE Access}, 
  title={Automatic Pavement Crack Detection and Classification Using Multiscale Feature Attention Network}, 
  year={2019},
  volume={7},
  number={},
  pages={171001-171012},
  abstract={Pavement crack detection and characterization is a fundamental part of road intelligent maintenance systems. Due to the high non-uniformity of cracks, topological complexity, and similar noise from crack texture, the challenge arises in this domain with automated crack detection and classification in a complex environment. In this work, an overarching framework for a universal and robust automatic method that simultaneously characterizes the type of crack and its severity level was developed. For crack detection, we propose a novel and efficient crack detection network that captures the crack context information by establishing a multiscale dilated convolution module. On this foundation, an attention mechanism is introduced to further refine the high-level features. Moreover, the rich features at different levels are fused in an upsampling module to generate more detailed crack detection results. For crack classification, a novel characterization algorithm is developed to classify the type of crack after detection. The crack segment branches are then merged and classified into four types: transversal, longitudinal, block, and alligator; the severity levels of cracks are assessed by calculating the average width and distance between the crack branches. The proposed crack detection method effectively detects crack information in a complex environment, and achieves the current state-of-the-art accuracy. Compared to manual classification results, the classification accuracy of transversal and longitudinal cracks is higher than 95%, and the classification accuracy of block and alligator is above 86%.},
  keywords={Feature extraction;Roads;Surface cracks;Semantics;Convolution;Classification algorithms;Task analysis;Pavement crack detection;crack classification;convolutional neural network;multiscale feature extraction;attention mechanism},
  doi={10.1109/ACCESS.2019.2956191},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{8953235,
  author={Zeng, Jin and Tong, Yanfeng and Huang, Yunmu and Yan, Qiong and Sun, Wenxiu and Chen, Jing and Wang, Yongtian},
  booktitle={2019 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)}, 
  title={Deep Surface Normal Estimation With Hierarchical RGB-D Fusion}, 
  year={2019},
  volume={},
  number={},
  pages={6146-6155},
  abstract={The growing availability of commodity RGB-D cameras has boosted the applications in the field of scene understanding. However, as a fundamental scene understanding task, surface normal estimation from RGB-D data lacks thorough investigation. In this paper, a hierarchical fusion network with adaptive feature re-weighting is proposed for surface normal estimation from a single RGB-D image. Specifically, the features from color image and depth are successively integrated at multiple scales to ensure global surface smoothness while preserving visually salient details. Meanwhile, the depth features are re-weighted with a confidence map estimated from depth before merging into the color branch to avoid artifacts caused by input depth corruption. Additionally, a hybrid multi-scale loss function is designed to learn accurate normal estimation given noisy ground-truth dataset. Extensive experimental results validate the effectiveness of the fusion strategy and the loss design, outperforming state-of-the-art normal estimation schemes.},
  keywords={Scene Analysis and Understanding;Deep Learning},
  doi={10.1109/CVPR.2019.00631},
  ISSN={2575-7075},
  month={June},}@ARTICLE{8764019,
  author={Li, Huaguang and Nie, Rencan and Cao, Jinde and Guo, Xiaopeng and Zhou, Dongming and He, Kangjian},
  journal={IEEE Sensors Journal}, 
  title={Multi-Focus Image Fusion Using U-Shaped Networks With a Hybrid Objective}, 
  year={2019},
  volume={19},
  number={21},
  pages={9755-9765},
  abstract={Multi-focus image fusion (MFIF) is a fundamental task in image processing. It generates an all-in-focus image through multiple partly focused source images. There are common schemes that are based on focused region detection and activity-level measurement, and fusion rule. We found that it is difficult to directly map between source images and focus maps. In this paper, we investigate the use of U-shape networks for the end-to-end modeling of MFIF. The novelty of our framework is two-fold. First, it uses a U-shaped network as a feature extractor that captures low-frequency information through feature extraction and high-frequency texture information through high-frequency texture extraction. Compared with the common convolutional neural network, the proposed network has better representation ability so that the most visually distinctive features can be extracted, fused, and enhanced. Second, the hybrid objective with ℓ1 and perceptual losses enables the framework to yield fused results that are consistent with human beings' perception. In addition, we employ a weighted strategy to merge the chrominance components in the YCbCr color space so that color distortion is almost eliminated in the color fused result. We investigate the performance through extensive experiments to verify the effectiveness of the proposed method. Through qualitative and quantitative assessment, the proposed method has performance comparable to the recent state-of-the-art methods.},
  keywords={Task analysis;Feature extraction;Transforms;Image color analysis;Image segmentation;Image fusion;Semantics;Hybrid objective;multi-focus image fusion;U-shape networks},
  doi={10.1109/JSEN.2019.2928818},
  ISSN={1558-1748},
  month={Nov},}@ARTICLE{9154366,
  author={Li, Weiqian and Xu, Bugao},
  journal={IEEE Access}, 
  title={Aspect-Based Fashion Recommendation With Attention Mechanism}, 
  year={2020},
  volume={8},
  number={},
  pages={141814-141823},
  abstract={With the rapid growth of fashion e-commerce, fashion recommendation has become a main digital marketing tool that is built on customer reviews and ratings. Online review is a powerful source for understanding users’ shopping experiences, preferences and feedbacks on product/item performances, and thus is useful for enhancing personalized recommendations for future purchases. However, most extant fashion recommendation methods lack effective frameworks to integrate local and global aspect representations extracted from customers’ ratings and reviews. In this paper, we proposed an aspect-based fashion recommendation model with attention mechanism (AFRAM) to predict customer ratings based on online reviews of fashion products. This model can extract latent aspect features about users and items separately through two parallel paths of convolutional neural networks (CNN), long short-term memory networks (LSTM), and attention mechanisms. One path processes user reviews and the other copes with item reviews. On each path, CNN and LSTM are both coupled with an attention mechanism to capture local aspect features and global aspect features respectively, which are combined through a mutual operation module. The mutual operations on both paths can enhance the generalization of the AFRAM model. The extracted features from the two paths are further merged to predict users’ ratings. Real-world customer reviews and ratings collected from two renowned business websites were used to train and test AFRAM. The experiment results demonstrate that AFRAM is more effective in customer rating predictions, as compared to several state-of-the-art fashion recommenders.},
  keywords={Feature extraction;Semantics;Predictive models;Clothing;Data mining;Sentiment analysis;Aspect-based fashion recommendation;attention mechanism;CNN;LSTM},
  doi={10.1109/ACCESS.2020.3013639},
  ISSN={2169-3536},
  month={},}@ARTICLE{9662661,
  author={Xie, Yutong and Zhang, Jianpeng and Liao, Zhibin and Verjans, Johan and Shen, Chunhua and Xia, Yong},
  journal={IEEE Transactions on Image Processing}, 
  title={Intra- and Inter-Pair Consistency for Semi-Supervised Gland Segmentation}, 
  year={2022},
  volume={31},
  number={},
  pages={894-905},
  abstract={Accurate gland segmentation in histology tissue images is a critical but challenging task. Although deep models have demonstrated superior performance in medical image segmentation, they commonly require a large amount of annotated data, which are hard to obtain due to the extensive labor costs and expertise required. In this paper, we propose an intra- and inter-pair consistency-based semi-supervised (I2CS) model that can be trained on both labeled and unlabeled histology images for gland segmentation. Considering that each image contains glands and hence different images could potentially share consistent semantics in the feature space, we introduce a novel intra- and inter-pair consistency module to explore such consistency for learning with unlabeled data. It first characterizes the pixel-level relation between a pair of images in the feature space to create an attention map that highlights the regions with the same semantics but on different images. Then, it imposes a consistency constraint on the attention maps obtained from multiple image pairs, and thus filters low-confidence attention regions to generate refined attention maps that are then merged with original features to improve their representation ability. In addition, we also design an object-level loss to address the issues caused by touching glands. We evaluated our model against several recent gland segmentation methods and three typical semi-supervised methods on the GlaS and CRAG datasets. Our results not only demonstrate the effectiveness of the proposed due consistency module and Obj-Dice loss, but also indicate that the proposed I2CS model achieves state-of-the-art gland segmentation performance on both benchmarks.},
  keywords={Glands;Image segmentation;Semantics;Feature extraction;Histopathology;Training;Data models;Gland segmentation;semi-supervised learning;pairwise learning;deep convolutional neural network},
  doi={10.1109/TIP.2021.3136716},
  ISSN={1941-0042},
  month={},}@INPROCEEDINGS{10657301,
  author={Zhang, Yichi and Ma, Ziqiao and Gao, Xiaofeng and Shakiah, Suhaila and Gao, Qiaozi and Chai, Joyce},
  booktitle={2024 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)}, 
  title={Groundhog Grounding Large Language Models to Holistic Segmentation}, 
  year={2024},
  volume={},
  number={},
  pages={14227-14238},
  abstract={Most multimodal large language models (MLLMs) learn language-to-object grounding through causal language modeling where grounded objects are captured by bounding boxes as sequences of location tokens. This paradigm lacks pixel-level representations that are important for fine-grained visual understanding and diagnosis. In this work, we introduce Groundhog, an MLLM developed by grounding Large Language Models to holistic segmentation. GROUNDHOG incorporates a masked feature extractor and converts extracted features into visual entity tokens for the MLLM backbone, which then connects groundable phrases to unified grounding masks by retrieving and merging the entity masks. To train GROUNDHOG, we carefully curated M3G2, a grounded visual instruction tuning dataset with Multi-Modal Multi-Grained Grounding, by harvesting a collection of segmentation-grounded datasets with rich annotations. Our experimental results show that GROUNDHOG achieves superior performance on various language grounding tasks without task-specific fine-tuning, and significantly reduces object hallucination. GROUNDHOG also demonstrates better grounding towards complex forms of visual input and provides easy-to-understand diagnosis in failure cases.},
  keywords={Training;Visualization;Grounding;Shape;Large language models;Semantics;Feature extraction;Multi-Modal;Language Grounding;Vision-Language Model},
  doi={10.1109/CVPR52733.2024.01349},
  ISSN={2575-7075},
  month={June},}@INPROCEEDINGS{10658542,
  author={Yan, Mi and Zhang, Jiazhao and Zhu, Yan and Wang, He},
  booktitle={2024 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)}, 
  title={MaskClustering: View Consensus Based Mask Graph Clustering for Open-Vocabulary 3D Instance Segmentation}, 
  year={2024},
  volume={},
  number={},
  pages={28274-28284},
  abstract={Open-vocabulary 3D instance segmentation is cuttingedge for its ability to segment 3D instances without prede-fined categories. However, progress in 3D lags behind its 2D counterpart due to limited annotated 3D data. To ad-dress this, recent works first generate 2D open-vocabulary masks through 2D models and then merge them into 3D instances based on metrics calculated between two neigh-boring frames. In contrast to these local metrics, we pro-pose a novel metric, view consensus rate, to enhance the utilization of multi-view observations. The key insight is that two 2D masks should be deemed part of the same 3D instance if a significant number of other 2D masks from different views contain both these two masks. Using this metric as edge weight, we construct a global mask graph where each mask is a node. Through iterative clustering of masks showing high view consensus, we generate a series of clusters, each representing a distinct 3D instance. Notably, our model is training-free. Through extensive ex-periments on publicly available datasets, including Scan-Net++, ScanNet200 and MatterPo rt3D, we demonstrate that our method achieves state-of-the-art performance in open-vocabulary 3D instance segmentation. Our project page is at https://pku-epic.github.ioIMaskClustering.},
  keywords={Measurement;Instance segmentation;Solid modeling;Computer vision;Three-dimensional displays;Shape;Navigation;3D instance segmentation;open-vocabulary},
