  booktitle={2022 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)}, 
  title={Joint Forecasting of Panoptic Segmentations with Difference Attention}, 
  year={2022},
  volume={},
  number={},
  pages={2617-2626},
  abstract={Forecasting of a representation is important for safe and effective autonomy. For this, panoptic segmentations have been studied as a compelling representation in recent work. However, recent state-of-the-art on panoptic segmentation forecasting suffers from two issues: first, individual object instances are treated independently of each other; second, individual object instance forecasts are merged in a heuristic manner. To address both issues, we study a new panoptic segmentation forecasting model that jointly forecasts all object instances in a scene using a transformer model based on ‘difference attention.’ It further refines the predictions by taking depth estimates into account. We evaluate the proposed model on the Cityscapes and AIODrive datasets. We find difference attention to be particularly suitable for forecasting because the difference of quantities like locations enables a model to explicitly reason about velocities and acceleration. Because of this, we attain state-of-the-art on panoptic segmentation forecasting metrics.},
  keywords={Measurement;Computer vision;Image analysis;Shape;Predictive models;Transformers;Pattern recognition;Scene analysis and understanding; Segmentation;grouping and shape analysis},
  doi={10.1109/CVPR52688.2022.00265},
  ISSN={2575-7075},
  month={June},}@INPROCEEDINGS{10828657,
  author={Saini, Radhika and Jain, Nishtha and Diwakar, Manoj and Mishra, Amit Kumar and Singh, Prabhishek and Pandey, Neeraj Kumar},
  booktitle={2024 7th International Conference on Contemporary Computing and Informatics (IC3I)}, 
  title={Image Matting Using Objective Decomposition and Cascading Residual Network}, 
  year={2024},
  volume={7},
  number={},
  pages={944-950},
  abstract={In this work we focus on the comprehensive review of Image Matting using concepts of Deep Learning algorithms. To achieve the objective, we have mainly focused on Neural Network based technique of Image Matting called objective decomposition (MOD Net) and Cascading Residual Network (CRN). The merging of these algorithmic approaches is performed to achieve the same goal. MOD net is used in extracting foreground objects with soft boundaries from the background image. Whereas CRN enhances the resolution of an imaging system. Till now, we have achieved the Statistical analysis on both the working models and performed experimental procedures including testing on challenging scenarios like different resolution images, low-light images, motion blurred images etc. We also worked on modifying the program by adding the logistics for foreground and background multiplication of the generated matte image which sanctioned us to change the background image of any generated matte.},
  keywords={Degradation;Deep learning;Statistical analysis;Reviews;Computational modeling;Superresolution;Noise reduction;Neural networks;Residual neural networks;Testing;Image matting;Super resolution;Deep learning;Pre-processing},
  doi={10.1109/IC3I61595.2024.10828657},
  ISSN={},
  month={Sep.},}@ARTICLE{10720775,
  author={Duan, Xuliang and Li, Zhiyao and Liu, Lingqi and Liu, Yuhai},
  journal={IEEE Access}, 
  title={Multimodal Chinese Agricultural News Classification Method Based on Interactive Attention}, 
  year={2024},
  volume={12},
  number={},
  pages={161718-161731},
  abstract={Most current research on Chinese agricultural news is limited to text analysis and seldom integrates images, leading to a scarcity of multimodal Chinese agricultural news datasets and an evident gap in multimodal Chinese agricultural news research. To address this, we propose the VECO method, a novel multimodal Chinese agricultural news classification approach that leverages interactive attention mechanisms. This algorithm uses ERNIE for text feature extraction and ViT(Vision Transformer) for image feature extraction, focusing on the interplay of features across modalities to uncover the congruent emotional content present in both the images and text. The integrated features are merged with individual image and text features and subsequently processed through a softmax layer to determine the classification outcomes. Our experiments, conducted on an in-house multimodal Chinese agricultural news dataset, demonstrate that the VECO method outperforms the baseline model, with improvements of 3.27% in precision, 0.59% in recall, and 1.92% in f1-score. The multimodal classification of Chinese agricultural news yields superior performance compared to text-only classification, and the results of the VECO model are notably better than those of other multimodal classification models. Future research can focus on optimizing the multimodal feature fusion algorithm to adapt to more complex agricultural news scenarios.},
  keywords={Feature extraction;Fake news;Data models;Agricultural machinery;Visualization;Training;Attention mechanisms;Semantics;Fisheries;Annotations;Multimedia computing;Multimodal learning;multimodal classification;multimodal Chinese agricultural news dataset;interactive attention mechanism;attention mechanism;feature fusion;Chinese agricultural news classification;Chinese agricultural news},
  doi={10.1109/ACCESS.2024.3482868},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9470553,
  author={Carette, Titouan and de Visme, Marc and Perdrix, Simon},
  booktitle={2021 36th Annual ACM/IEEE Symposium on Logic in Computer Science (LICS)}, 
  title={Graphical Language with Delayed Trace: Picturing Quantum Computing with Finite Memory}, 
  year={2021},
  volume={},
  number={},
  pages={1-13},
  abstract={Graphical languages, like quantum circuits or ZX-calculus, have been successfully designed to represent (memoryless) quantum computations acting on a finite number of qubits. Meanwhile, delayed traces have been used as a graphical way to represent finite-memory computations on streams, in a classical setting (cartesian data types). We merge those two approaches and describe a general construction that extends any graphical language, equipped with a notion of discarding, to a graphical language of finite memory computations. In order to handle cases like the ZX-calculus, which is complete for post-selected quantum mechanics, we extend the delayed trace formalism beyond the causal case, refining the notion of causality for stream transformers. We design a stream semantics based on stateful morphism sequences and, under some assumptions, show universality and completeness results. Finally, we investigate the links of our framework with previous works on cartesian data types, signal flow graphs, and quantum channels with memories.},
  keywords={Computer science;Quantum channel;Semantics;Refining;Qubit;Quantum mechanics;Flow graphs},
  doi={10.1109/LICS52264.2021.9470553},
  ISSN={},
  month={June},}@ARTICLE{10970104,
  author={Vo, Xuan-Thuy and Nguyen, Duy-Linh and Priadana, Adri and Cao, Ge and Choi, Jehwan and Jo, Kang-Hyun},
  journal={IEEE Transactions on Industrial Informatics}, 
  title={Local Self-Attention With Mixing Abstract Tokens for Urban Autonomous Driving}, 
  year={2025},
  volume={21},
  number={7},
  pages={5420-5430},
  abstract={Although local self-attentions exhibit translation equivariance and locality similar to convolution, the model has limited receptive fields and weak modeling ability. The main reason is that self-attention is computed within nonoverlapped windows. To overcome this issue, common methods need further operations to communicate the information across windows, such as window shifting, and sliding. These operations are memory unfriendly, not well supported, and optimized by modern deep-learning frameworks. Alternatively, this article exchanges information across nonoverlapped windows via efficiently mixing abstract tokens (MAT). The MAT block includes the following steps. First, the image tokens are partitioned into windows and each window is merged with an abstract token. Second, in each window, interactions of image tokens and the abstract token to image tokens are performed. Third, because the abstract token learns abstract information from each corresponding window, mixing all abstract tokens via transformer encoder helps to exchange information between local windows and result in global context modeling. Fourth, the global information of the mixed tokens is propagated back to the image tokens through transformer decoder. The MAT block is efficient and easy to implement, only containing matrix multiplications. In addition, this article also proposes a bilinear patch embedding that samples relevant regions of the input tokens based on learned offsets. Extensive experiments are conducted and evaluated with various tasks such as image classification, object detection, and segmentation. As a result, our method achieves promising performances across tasks. For example, MAT-2 accomplishes 79.0% top-1 accuracy on ImageNet-1 K with 0.7 GFLOPs and outperforms the baseline Swin-0.7 G by 4.6% while reducing 15.2 ms on CPU and 0.53 ms on GPU devices. The MAT-4 surpasses Swin-T by 1.8% mIoU with only 70% GFLOPs.},
  keywords={Transformers;Convolutional neural networks;Graphics processing units;Computational modeling;Complexity theory;Visualization;Feature extraction;Computer vision;Predictive models;Image analysis;Road traffic;Computer vision tasks;efficient vision transformers (ViT);urban driving scene segmentation;window self-attention},
  doi={10.1109/TII.2025.3555982},
  ISSN={1941-0050},
  month={July},}@ARTICLE{10705688,
  author={Cai, Miaomiao and Liu, Xiaoyu and Xiong, Zhiwei and Chen, Xuejin},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={BioSAM: Generating SAM Prompts From Superpixel Graph for Biological Instance Segmentation}, 
  year={2025},
  volume={29},
  number={1},
  pages={273-284},
  abstract={Proposal-free instance segmentation methods have significantly advanced the field of biological image analysis. Recently, the Segment Anything Model (SAM) has shown an extraordinary ability to handle challenging instance boundaries. However, directly applying SAM to biological images that contain instances with complex morphologies and dense distributions fails to yield satisfactory results. In this work, we propose BioSAM, a new biological instance segmentation framework generating SAM prompts from a superpixel graph. Specifically, to avoid over-merging, we first generate sufficient superpixels as graph nodes and construct an initialized graph. We then generate initial prompts from each superpixel and aggregate them through a graph neural network (GNN) by predicting the relationship of superpixels to avoid over-segmentation. We employ the SAM encoder embeddings and the SAM-assisted superpixel similarity as new features for the graph to enhance its discrimination capability. With the graph-based prompt aggregation, we utilize the aggregated prompts in SAM to refine the segmentation and generate more accurate instance boundaries. Comprehensive experiments on four representative biological datasets demonstrate that our proposed method outperforms state-of-the-art methods.},
  keywords={Biological information theory;Instance segmentation;Image segmentation;Feature extraction;Morphology;Biomedical imaging;Biological system modeling;Graph neural networks;Decoding;Accuracy;Biological Instance Segmentation;segment anything;prompt generation;superpixel},
  doi={10.1109/JBHI.2024.3474706},
  ISSN={2168-2208},
  month={Jan},}@INPROCEEDINGS{9931594,
  author={Lichouri, Mohamed and Lounnas, Khaled and Djeradi, Rachid and Djeradi, Amar},
  booktitle={2022 International Conference on Advanced Aspects of Software Engineering (ICAASE)}, 
  title={Performance of End-to-End vs Pipeline Spoken Language Understanding Models on Multilingual Synthetic Voice}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={This work conducts a comparative investigation of two architectures in the domain of Spoken Language Understanding (SLU), which were evaluated on a synthesized corpus of three languages: Modern Standard Arabic (MSA), French, and English. The first architecture employs a simple SLU system based on classical machine learning algorithms (E2E SLU), whereas the second architecture (Pipeline SLU) merges the textual output of a speech recognition system (ASR) with that of a textual classification system by transmitting it to a ”Natural Language Understanding” (NLU) model, allowing us to compare the predictions of the two systems. The obtained results were encouraging where we found that the Pipeline approach has given us better results than the E2E approach},
  keywords={Machine learning algorithms;Pipelines;Speech recognition;Computer architecture;Predictive models;Natural language processing;Standards;End-to-End;ASR;NLU;SLU;Pipeline;Transliteration;Synthetic},
  doi={10.1109/ICAASE56196.2022.9931594},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11167587,
  author={Mangayarkarasi, T. and Krishnaswamy, R and M, Joly and Bharathi, B. and Muthulekshmi, M. and Vinodha, R.},
  booktitle={2025 3rd International Conference on Sustainable Computing and Data Communication Systems (ICSCDS)}, 
  title={Neural Network Approaches to Predicting Vector-Borne Disease Spread with IoT Environmental Sensors}, 
  year={2025},
  volume={},
  number={},
  pages={279-284},
  abstract={Vector-borne diseases (VBDs) are significant public health issues globally and are influenced by complex interactions between environmental variables and pathogen dynamics. This research investigates using neural network methodologies to improve the predictive modeling of VBDs dissemination, using data gathered from Internet of Things (IoT) environmental sensors. It created a robust neural network model to find trends and forecast outbreaks by merging real-time environmental data, including temperature, humidity, and rainfall, with historical disease incidence records. The model’s architecture was refined to enhance accuracy and mitigate overfitting, including dropout and batch normalization methods. Empirical findings indicate that the methodology performs traditional statistical techniques, yielding prompt forecasts that may guide public health measures and vector control efforts. It highlights the possibility of integrating machine learning algorithms with IoT technology to enable proactive management of VBDs, hence improving public health monitoring and response systems.},
  keywords={Temperature measurement;Temperature sensors;Temperature distribution;Accuracy;Neural networks;Predictive models;Data models;Sensors;Public healthcare;Diseases;Vector-borne diseases;Disease prediction;Environmental sensors;public health;Data integration;Outbreak forecasting},
  doi={10.1109/ICSCDS65426.2025.11167587},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11158752,
  author={Panchani, Ajaykumar Devrajbhai},
  booktitle={2025 International Conference on Computing Technologies & Data Communication (ICCTDC)}, 
  title={Enhancing Video Summarization Using Object and Action Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-11},
  abstract={Video content consumption has surged in recent years, with over 500 million hours of video watched daily on YouTube alone. This trend underscores the growing dominance of video as a primary medium for information exchange. As textual content continues to yield ground to visual and video-based formats, the need for effective video management tools, such as video summarization, becomes increasingly evident. Video summarization is a vital process that condenses lengthy videos into keyframes or essential segments, preserving the video's main content. This paper redefines video summarization as “a technique to create a short skim of the original video while preserving the main contents,” akin to skimming through textual information. The applications of video summarization are diverse, with a primary focus on gauging user interest and enhancing content sharing on social media. This research project endeavors to harness the power of neural networks to comprehend the semantics of video content for improved video summarization. The core concept involves leveraging object detection and action detection algorithms to achieve a deeper understanding of video semantics. The proposed video summarization system integrates two key components: a PyTorch implementation of the YOLOv3 model for object detection and a pre-trained Epic Kitchens model for action detection. These components work in tandem to extract vital information from video frames. Following the detection of objects and actions, the system seamlessly merges and compresses the results, ultimately generating a text file that captures the temporal, verb, noun, and object attributes of all detected keyframes. This research sets the stage for enhancing video summarization techniques by harnessing the capabilities of object and action detection, marking a significant stride toward more efficient and informative video content management and sharing in an era where video dominates the information exchange landscape.},
  keywords={YOLO;Visualization;Technological innovation;Video on demand;Social networking (online);Semantics;Neural networks;Web sites;Information exchange;Videos;Artificial intelligence;machine learning;video processing;image processing;algorithms},
  doi={10.1109/ICCTDC64446.2025.11158752},
  ISSN={},
  month={July},}@ARTICLE{10220071,
  author={Cai, Xichang and Gan, Yanggang and Wu, Menglong and Wu, Juan},
  journal={IEEE Access}, 
  title={Weak Supervised Sound Event Detection Based on Puzzle CAM}, 
  year={2023},
  volume={11},
  number={},
  pages={89290-89297},
  abstract={The sound event detection method based on deep learning has achieved excellent performance. However, the training of high-performance sound event detection models depends on high-quality strong-label datasets, which brings great pressure and cost to the labeling work of datasets. In this paper, we propose a weakly supervised sound event detection method based on Puzzle Class Activation Map(CAM), which aims to obtain the timestamp information of sound events from a sound event classification network trained by weak labels. Specifically, the method discovers more complete regions of sound events by minimizing the difference between the CAM of the original features and the merged CAM of the separated feature blocks. CAM highlights the feature capture in the time dimension during the model decision-making process. We determine the occurrence time of the sound event based on the position of the frame where the feature is located, and use the model classification prediction to guide the CAM output to achieve weakly supervised sound event detection. Experiments on the Domestic Environment Sound Event Detection Dataset demonstrate that our proposed method exhibits superior performance compared to the baseline system in the task of sound event detection. Specifically, The CAM of a single system achieves the best PSDS2 value of 0.732. Furthermore, when utilizing the CAM ensemble of multiple systems, the PSDS2 value improves to 0.751. Both of these values are higher than those achieved by the baseline system.},
  keywords={Event detection;Task analysis;Convolutional neural networks;Feature extraction;Spectrogram;Recurrent neural networks;Class activation map;object localization;sound event detection;weak supervision},
  doi={10.1109/ACCESS.2023.3305633},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10625555,
  author={Raza, Syed Muhammad and Masuduzzaman, Md and Shin, Soo Young},
  booktitle={2024 Fifteenth International Conference on Ubiquitous and Future Networks (ICUFN)}, 
  title={UxV-Swarm based Automated Fruits Disease Instance Segmentation for Smart Farming using Deep Learning Model}, 
  year={2024},
  volume={},
  number={},
  pages={274-279},
  abstract={Smart farming is a revolutionary method in agriculture that utilizes advanced technologies to improve crop monitoring and disease segmentation. This research study investigates the usage of unmanned vehicles (UxV), such as Unmanned Aerial Vehicles (UAVs) and Unmanned Ground Vehicles (UGVs), in a swarm-based system to segment fruit diseases in smart farming automatically. The proposed technique utilizes deep learning (DL), notably YOLOv8 instance segmentation, to segment diseases in various fruit datasets accurately and efficiently. The suggested approach improves the efficiency and precision of disease segmentation and enables immediate monitoring and action. The UxVs collaborate using a swarm strategy, resulting in a scalable solution for extensive agricultural activities. By using DL models, notably YOLOv8, one may achieve the level of accuracy necessary for complex tasks like fruit disease segmentation. The study integrates a wide range of datasets that include many types of fruits and their linked diseases, such as Strawberry, Tomato, and numerous leaf diseases. The DL model is trained on a merged dataset, resulting in a remarkable overall accuracy of 95%. Furthermore, the model's strong performance in disease segmentation across diverse crops is evident from the individual dataset assessments, which indicate high accuracy compared with other existing studies.},
  keywords={Smart agriculture;Instance segmentation;Deep learning;Accuracy;Crops;Autonomous aerial vehicles;Land vehicles;Deep Learning;Fruit Disease;Segmentation;Smart Framing;Unmanned any Vehicles},
  doi={10.1109/ICUFN61752.2024.10625555},
  ISSN={2165-8536},
  month={July},}@INPROCEEDINGS{10649201,
  author={Singh, Kamred Udham and Singh, Niharika and Chaudhary, Varun and Paliwal, Deepika and Singh, Teekam and Dewangan, Amit kumar},
  booktitle={2024 IEEE International Conference on Contemporary Computing and Communications (InC4)}, 
  title={Enhancing Social Media Sarcasm Detection Using Chicken Swarm Optimization and Graph Neural Networks}, 
  year={2024},
  volume={1},
  number={},
  pages={1-6},
  abstract={Understanding social media sarcasm is a difficult but crucial NLP issue. Machine learning (ML) algorithms are needed to effectively discern sarcastic undertones in text due to its contextual and linguistic complexity. Traditional ML models distinguish sarcasm from sincerity via sentiment analysis, context-specific variables, and language markers. As online communication evolves, more complex technologies are needed to understand language's subtleties. The merging of deep learning (DL) approaches with contextual embedding has greatly improved sarcasm detection systems, allowing them to analyze text more precisely and contextually. The CSOA-GNN model, which combines the Chicken Swarm Optimization Algorithm (CSOA) with Graph Neural Networks to identify sarcasm. After rigorous data pre-processing, the model embeds words using TF-IDF (Term Frequency-Inverse Document Frequency). Sarcasm's unique language traits are vectorized for ML analysis using this method. GNN is then used to classify. Its ability to map out and grasp the complicated network of contextual links and dependencies among words inside sentences improves the model's sarcasm detection accuracy. CSOA is crucial to optimizing GNN performance in this model. CSOA optimizes the GNN hyperparameters to match social media text's sarcastic expressions. This unique technique relies on GNN-based classification, CSOA-based parameter optimization, and TF-IDF word embeddings, which provide encouraging results that demonstrate their efficacy. As they increase social media sarcasm detection accuracy and advance NLP. This study introduces the CSOA-GNN paradigm, enabling more advanced, contextually aware, and nuanced language interpretation systems. It advances our understanding of the complicated world of online communication, where sarcasm, frequently laced with nuanced indications and contextual richness, is a constant challenge. This model shows that powerful optimization methods may be integrated with neural network topologies, enabling new research and development opportunities for more refined and intelligent NLP systems.},
  keywords={Deep learning;Sentiment analysis;Accuracy;Social networking (online);Graph neural networks;Swarm intelligence;Classification algorithms;Topology;Tuning;Context modeling;Sarcasm Recognition;Social Media;Chicken Swarm Optimization;Natural Language Processing;Deep Learning;Word Embedding},
  doi={10.1109/InC460750.2024.10649201},
  ISSN={},
  month={March},}@INPROCEEDINGS{10939972,
  author={K, Prabhavathi and M N, Anusha and G, Manjunatha and N B, Sowjanya and Puttegowda, Kiran and K B, Naveen},
  booktitle={2024 International Conference on Distributed Systems, Computer Networks and Cybersecurity (ICDSCNC)}, 
  title={Next-Gen AI-Embedded Vision Systems: Real-Time Optimization for Surveillance, Autonomous Vehicles, and Industry 4.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={AI-powered embedded vision systems are transforming visual data processing by enabling real-time decision-making across critical applications such as autonomous vehicles, industrial automation, and surveillance. This paper introduces a system that merges advanced machine learning algorithms with energy-efficient hardware, designed to optimize performance and minimize power consumption. The system achieves a detection accuracy of 94.5%, processes images at 30 FPS, and maintains computational efficiency at 2.5 MB/Watt. These results underscore the system’s effectiveness in real-time object detection with minimal latency. Despite these advances, challenges remain in maintaining accuracy under varying conditions and further optimizing the system. Future work will focus on improving robustness, exploring new applications, and integrating emerging technologies. This research highlights the significant impact and future potential of AI-driven vision technology, providing a framework for advancing capabilities in embedded vision systems.},
  keywords={Accuracy;Machine vision;Surveillance;Object detection;Real-time systems;Robustness;Hardware;Energy efficiency;Autonomous vehicles;Optimization;AI-powered embedded vision systems;real-time processing;machine learning;object detection;energy-efficient hardware;performance optimization;autonomous vehicles;industrial automation},
  doi={10.1109/ICDSCNC62492.2024.10939972},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10145167,
  author={Zhang, Yu and Dong, Miao},
  booktitle={2023 International Conference on Pattern Recognition, Machine Vision and Intelligent Algorithms (PRMVIA)}, 
  title={Research on visual SLAM algorithm based on improved point-line feature fusion}, 
  year={2023},
  volume={},
  number={},
  pages={245-251},
  abstract={SLAM (simultaneous localization and mapping), will further known as synchronous localization and mapping, is a technology that is used to tackle the issue of localization and map building while a robot travels in an unfamiliar environment. Traditional SLAM relies on point features to estimate camera pose, which makes it difficult to extract enough point features in low-texture scenes. When the camera shakes violently or rotates too fast, the robustness of a point-based SLAM system is poor. Aiming at the problem of poor robustness of the existing visual SLAM (synchronous localization and mapping technology) system, based on the ORB-SLAM3 framework, the point feature extractor is replaced with a self-supervised deep neural network, and a matching filtering algorithm based on threshold and motion statistics is proposed to eliminate point mismatch, this significantly accelerates the system’s real- time and accuracy. Likewise, linear activities are integrated into the front-end information extraction, a linear feature extraction model is established, approximation linear features are merged and processed, and the linear feature description and mismatching eradication process are simplified. Finally, the weight allocation idea is introduced into the construction of the point and line error model, and the weight of the point and line is reasonably allocated according to the richness of the scene. Experiments on absolute error trajectory on the TUM dataset emphasize that the revised algorithm increased efficiency and stability when compared to the ORB-SLAM3 system.},
  keywords={Location awareness;Visualization;Simultaneous localization and mapping;Robot vision systems;Feature extraction;Cameras;Approximation algorithms;Visual SLAM;Deep learning;Mismatch elimination;GCNV2},
  doi={10.1109/PRMVIA58252.2023.00046},
  ISSN={},
  month={March},}@INPROCEEDINGS{9287829,
  author={Pascal, Barbara and Mauduit, Vincent and Pustelnik, Nelly and Abry, Patrice},
  booktitle={2020 28th European Signal Processing Conference (EUSIPCO)}, 
  title={Scale-free Texture Segmentation: Expert Feature-based versus Deep Learning strategies}, 
  year={2021},
  volume={},
  number={},
  pages={1367-1371},
  abstract={Texture segmentation constitutes a central task in image processing, classically based on two-step procedures consisting first in computing hand-crafted features devised from a priori expert knowledge and second in combining them into clustering algorithms. Deep learning approaches can be seen as merging these two steps into a single one with both discovering features and performing segmentation. Using fractal textures, often seen as relevant models in real-world applications, the present work compares a recently devised texture segmentation algorithm incorporating expert-driven scale-free features estimation into a Joint TV optimization framework against convolutional neural network architectures. From realistic synthetic textures, comparisons are drawn not only for segmentation performance, but also with respect to computational costs, architecture complexities and robustness against departures between training and testing datasets.},
  keywords={Deep learning;TV;Signal processing algorithms;Computer architecture;Robustness;Complexity theory;Optimization;Deep learning;CNN;Texture;Segmentation;Fractal;Total variation;Wavelets},
  doi={10.23919/Eusipco47968.2020.9287829},
  ISSN={2076-1465},
  month={Jan},}@INPROCEEDINGS{11042541,
  author={Sminage, Amxson and B, Delvin P and Davies, Derick and J, Vivek K and Davies, Jasmy},
  booktitle={2025 2nd International Conference on Trends in Engineering Systems and Technologies (ICTEST)}, 
  title={SafeDrive: Intelligent Pothole Detection and Mapping System}, 
  year={2025},
  volume={1},
  number={},
  pages={1-6},
  abstract={Potholes represent a substantial challenge impacting road safety and infrastructure durability, leading to increased vehicle wear, escalated maintenance expenses, and heightened safety risks. The SafeDrive: Intelligent Pothole Detection and Mapping System introduces an innovative, AI-enhanced methodology aimed at automating pothole detection and reporting. Leveraging YOLOv7, a cutting-edge object detection model trained using 11,068 images from the Roboflow dataset, including 1,808 validation images and 891 test images, the system processes video feeds to accurately identify potholes and geotag them for further analysis, achieving a precision of 87.72%, a recall of 77.03%, and an F1-score of 82.03%, ensuring effectiveness in real-world scenarios. Furthermore, the system categorizes detected potholes based on their occurrence frequency within video frames, enabling authorities to allocate resources efficiently by prioritizing critical areas. Additionally, it includes a user-friendly online application that allows users to report potholes with geotagged images and track repair progress, fostering community participation and enhancing transparency. Designed with scalability in mind, SafeDrive integrates cloud-based computing and sophisticated analytical tools to provide an efficient framework for road maintenance management, merging AI automation with active public involvement to significantly enhance road safety and set a new standard for monitoring urban infrastructure.},
  keywords={Adaptation models;Visualization;Clouds;Scalability;Road safety;Real-time systems;Maintenance;Standards;Vehicles;Radio spectrum management;Pothole Detection;YOLOv7;Road Safety;Cloud Integration;Web Application;Automated Mapping;Urban Mobility;Public Engagement;Infrastructure Management;Hazard Prioritization},
  doi={10.1109/ICTEST64710.2025.11042541},
  ISSN={},
  month={April},}
