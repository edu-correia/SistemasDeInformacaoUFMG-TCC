@INPROCEEDINGS{11375268,
  author={Zou, Kaifeng and Feng, Xiaoyi and Huang, Tao and Huang, Zizhou and Haihang, Zhang and Zou, Yuntao and Li, Dagang},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision Workshops (ICCVW)}, 
  title={Zero-Shot Subject-Centric Generation for Creative Application Using Entropy Fusion}, 
  year={2025},
  volume={},
  number={},
  pages={6195-6204},
  abstract={Generative models are widely used in visual content creation. However, current text-to-image models often face challenges in practical applications—such as textile pattern design and meme generation—due to the presence of unwanted elements that are difficult to separate with existing methods. Meanwhile, subject-reference generation has emerged as a key research trend, highlighting the need for techniques that can produce clean, high-quality subject images while effectively removing extraneous components. To address this challenge, we introduce a framework for reliable subject-centric image generation. In this work, we propose an entropy-based feature-weighted fusion method to merge the informative cross-attention features obtained from each sampling step of the pretrained text-to-image model FLUX, enabling a precise mask prediction and subject-centric generation. Additionally, we have developed an agent framework based on Large Language Models (LLMs) that translates users' casual inputs into more descriptive prompts, leading to highly detailed image generation. Simultaneously, the agents extract primary elements of prompts to guide the entropy-based feature fusion, ensuring focused primary element generation without extraneous components. Experimental results and user studies demonstrate our methods generates high-quality subjectcentric images, outperform existing methods or other possible pipelines, highlighting the effectiveness of our approach.},
  keywords={Training;Visualization;Translation;Image synthesis;Pipelines;Text to image;Predictive models;Feature extraction;Reliability;Textiles;Segmentation;image generation;visual element;generation diffusion transformers},
  doi={10.1109/ICCVW69036.2025.00645},
  ISSN={2473-9944},
  month={Oct},}@INPROCEEDINGS{11341580,
  author={U, Sarala Devi and M, Sivasakthi},
  booktitle={2025 International Conference on Communication, Computer, and Information Technology (IC3IT)}, 
  title={Evaluating Negation Detection in Sentiment Analysis of Doctor Reviews Using NLP}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Sentiment Analysis (SA) is a main sub field of Natural Language Processing (NLP). In which, the text can be classified as positive, Negative or neutral. The digital message can be in any form, that can be identified by human, but here the critical task is the machine, that should understand in a way like human. In this article, mainly focus the Negation finding in the sentence and also Negation plays a vital role in the SA. Negation can change the meaning of the sentence like positive as negative and negative as positive, in such a case it will affect the entire domain. Here, finds the Negation in a review given by patient, identify the sentiment then assigns the polarity to the sentence. There are number of existing negation handling techniques are discussed for various kinds of reviews using ML techniques and proven SVM is the better choice for SA, those are general purpose. But here, unlike general approach focusing Negation detection in the healthcare field of Doctor Reviews Dataset. The main goal is improving the reliability in the sensitive field. In this paper, the proposed techniques are SVM (Support Vector Machine) which is a machine Learning Technique, train the model to learn negation, that is compare with the RNN (Recurrent Neural Network) Which is Deep Learning Technique, automatically learn the feature of negation from trained input. These two algorithms merged with Rule-Base method “VADER” for finding the sentiment label in the context and assign the polarity. The dataset is doctor's review given by the public. The Dataset having one review column of 997 entries. The Dataset is devised for training and testing working models for finding negation and Producing Accuracy in the prediction. In the existing SVM alone and some Machine Learning technique's given less accuracy compare to SVM+VADER., for this VADER combined with TFIDF Vectorization technique. Herein VADER with SVM gives the good result of 95% accuracy compare to the RNN, which gives 78%.},
  keywords={Support vector machines;Deep learning;Sentiment analysis;Recurrent neural networks;Accuracy;Reviews;Medical services;Space vector modulation;Emojis;Testing;Sentiment Analysis (SA);Natural Language Processing (NLP);VADER (Valence Aware Dictionary for Sentiment Reasoning);Machine Learning (ML);Deep Learning (DL);Support Vector Machine (SVM);Recurrent Neural Network (RNN)},
  doi={10.1109/IC3IT66137.2025.11341580},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10429228,
  author={Lu, Qianqi and Xie, Yuxiang and Zhang, Qiuhong and Zeng, Yunjv},
  booktitle={2023 9th International Conference on Big Data and Information Analytics (BigDIA)}, 
  title={Utilizing Heterogeneous Feature Dimensionality Reduction and Stacking Model for Hematoma Expansion Diagnosis}, 
  year={2023},
  volume={},
  number={},
  pages={528-535},
  abstract={Hematoma expansion (HE) in hemorrhagic stroke (HS) patients has been showed to be an important indicator for clinical monitoring and prognostic control of stroke patients. However, on the one hand, manual diagnosis exist shortcomings such as inefficiency and inaccuracy. On the other hand, in the data mining of intelligent diagnosis, people usually downsize the data from a single source, through the coarse-grained method of single feature selection, which makes a large amount of useful information not being fully utilized. On top of that, there is a lack of technique to merge the effects of various state-of-the-art models. Consequently, this study develops a novel integrated learning HE prediction system based on multi-source data that automates the determination of whether a HS patient would have the risk of HE with higher precision and interpretability. The key contribution of this paper is to accurately, efficiently and robustly predict the HE by multi-stage feature engineering with heterogeneous integrated features as inputs for stacking integrated learning. In addition, the unbalanced dataset is optimized by employing the Synthetic Minority Over-sampling Technique (SMOTE) algorithm. The model constructed in this paper based on the ten selected features performs well in predicting HE, with 89.74% accuracy and 95.38% AUC on the test set.},
  keywords={Stacking;Manuals;Stroke (medical condition);Predictive models;Prediction algorithms;Hemorrhaging;Monitoring;Hematoma expansion;Heterogeneous feature dimensionality reduction;multisource data;Ensemble Learning},
  doi={10.1109/BigDIA60676.2023.10429228},
  ISSN={2771-6902},
  month={Dec},}@INPROCEEDINGS{11420684,
  author={Akhter, Israr and Dekan, Martin and Duchon, Frantisek},
  booktitle={2026 IEEE 24th World Symposium on Applied Machine Intelligence and Informatics (SAMI)}, 
  title={Integrated Machine Learning and Data Optimization for Sensing Roadway Motion Objects}, 
  year={2026},
  volume={},
  number={},
  pages={000125-000130},
  abstract={In the era of smart robotics and automated frameworks, object recognition plays an essential role in enabling machines to make robust decisions. This project presents a robust and efficient method for object classification using image and video data. The methodology combines basic preprocessing method to improve identification accuracy in complex environments. Conventional deep learning approaches require high computational resources; meanwhile, the proposed system is lightweight and appropriate for utilization on edge devices and limited computational power. Current research, including innovative object detection systems and hybrid feature patterns, has inspired our design via highlighting the value of merging motion signals with contextual data. Through a systematic multi-stage framework, our model effectively recognizes vehicles and non-vehicle objects. The findings demonstrate promising accuracy over two state-of-the-art datasets, highlighting the model’s capability for use in surveillance, smart transport, and robotic applications. This research extends intelligent visual approaches and provides a robust solution and a meaningful contribution.},
  keywords={Visualization;Accuracy;Systematics;Surveillance;Object detection;Robot sensing systems;Feature extraction;Sensors;Object recognition;Videos;Computer Vision;Contextual features;Deep Belief Network;Machine Learning Object detection;object segmentation;Object tracking;principal component analysis;Robotic era;Robotic Vision},
  doi={10.1109/SAMI68106.2026.11420684},
  ISSN={2767-9438},
  month={Jan},}@INPROCEEDINGS{11168808,
  author={Niranjana, P M and Sonial, Devika and Vijayakumar, Ashwin and Abhijith, T S and Sindhu, S},
  booktitle={2025 Advanced Computing and Communication Technologies for High Performance Applications (ACCTHPA)}, 
  title={DiskSpaceX}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Traditional cloud storage systems have intrinsic limitations such as central control, security vulnerability, high cost and inefficient resource utilization, and are therefore inappropriate for reliable secure data storage system. In order to address these issues, DiskSpaceX proposes a blockchain-based, decentralized disk space renting system that is secure, efficient, and cost-effective in terms of storage. When a file is uploaded, it is encrypted, fragmentized into multiple pieces, spread across a distributed network, and the path to where it stores registered on the blockchain to prevent tampering. Upon retrieval, the fragments are merged and decrypted and data integrity and security are maintained. Utilizing smart contracts allows DiskSpaceX to automate storage transactions, remove intermediaries, reduce transaction costs, and increase transparency and trust. The advantage of this approach is that it eliminates the presence of single points of failure, improves resource usage, and preferably, it cuts cost than traditional clouds. DiskSpaceX is a cryptographic secure, immutable and scalable solution to the modern data storage problems, and thus, is a great alternative to modern storage systems.},
  keywords={Cloud computing;Costs;Data integrity;Scalability;Smart contracts;Memory;Blockchains;Resource management;Reliability;Protection;Decentralized;Blockchain;Storage;Trust;Decryption;Transparency;Cryptographic Security;Smart Contracts;Scalable;Immutable},
  doi={10.1109/ACCTHPA65749.2025.11168808},
  ISSN={},
  month={July},}@ARTICLE{8858224,
  author={Mora, Marcelo D and Torres-Flores, Sergio and Firpo, Verónica and Hernandez-Jimenez, Jose A and Urrutia-Viscarra, Fernanda and Mendes de Oliveira, Claudia},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Clues on Arp 142: The spiral–elliptical merger}, 
  year={2019},
  volume={488},
  number={1},
  pages={830-846},
  abstract={Nearby merging pairs are unique laboratories in which one can study the gravitational effects on the individual interacting components. In this manuscript, we report the characterization of selected H II regions along the peculiar galaxy NGC 2936, member of the galaxy pair Arp 142, an E+S interaction, known as ‘The Penguin’. Using Gemini South spectroscopy, we have derived a high enhancement of the global star formation rate (SFR) = 35.9 M⊙ yr−1 probably stimulated by the interaction. Star-forming regions on this galaxy display oxygen abundances that are consistent with solar metallicities. The current data set does not allow us to conclude any clear scenario for NGC 2936. Diagnostic diagrams suggest that the central region of NGC 2936 is ionized by active galactic nucleus (AGN) activity and the eastern tidal plume in NGC 2936 is experiencing a burst of star formation, which may be triggered by the gas compression due to the interaction event with its elliptical companion galaxy: NGC 2937. The ionization mechanism of these sources is consistent with shock models of low velocities of 200–300 km s −1. The isophotal analysis shows tidal features on NGC 2937: at inner radii non-concentric (or off-centring) isophotes, and at large radii, a faint excess of the surface brightness profile with respect to de Vaucouleurs law. By comparing the radial velocity profiles and morphological characteristics of Arp 142 with a library of numerical simulations, we conclude that the current stage of the system would be about 50 ± 25 Myr after the first pericentre passage.},
  keywords={galaxies: interactions;ISM: H II regions},
  doi={10.1093/mnras/stz1744},
  ISSN={1365-2966},
  month={June},}@INPROCEEDINGS{11452847,
  author={Doshi, Arya and Inamdar, Chinmay and Gote, Tanmay and Shilaskar, Swati},
  booktitle={2025 1st International Conference on Advancement in Futuristic Technologies (ICAFT)}, 
  title={TrialTransparency.AI: A Hybrid Rules-Based and LLM-Enhanced Framework for Clinical Trial Data Validation}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Data validation in clinical trials remains a key bottleneck in pharmaceutical development: 23.7% of the critical fields suffer from data integrity issues, and the manual approach requires 375 person-hours per 1,000 subjects. Herein, this paper presents TrialTransparency.AI, a hybrid approach that merges deterministic, rules-based validation with large language model capabilities. The framework consists of a Python-based preprocessing pipeline using xml.etree. ElementTree to parse XMLs and PostgreSQL for data storage; a hierarchical validation engine implementing 389 rules across five categories; explainability, powered by Mixtral-8x7B-Instruct-v0.1, to provide natural language explanations on a per-role basis; and several optimization strategies involving chunked processing and parallel execution. Testing on 87,432 records from 14 Phase II and Phase III trials showed 94.7% overall error detection accuracy, good performance in logical contradiction detection (92.8% sensitivity), and cross-record inconsistency detection (89.4% sensitivity). The system achieved a 78.3% reduction in error resolution time and reduced the average processing from 33.7 to 6.33 minutes per error, translating to a saving of 11,280 person-hours in a typical 500-patient Phase III trial.},
  keywords={Sensitivity;Translation;Large language models;Pipelines;XML;Memory;Clinical trials;Optimization;Testing;Pharmaceuticals;clinical trials;data validation;large language models;regulatory compliance;explainable AI;healthcare informatics},
  doi={10.1109/ICAFT66710.2025.11452847},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11382231,
  author={Liu, Yongheng and Li, Lu},
  booktitle={2025 6th International Conference on Artificial Intelligence and Computer Engineering (ICAICE)}, 
  title={A Method for Achieving Secure KNN Similarity Set Search with an Honest Majority}, 
  year={2025},
  volume={},
  number={},
  pages={893-899},
  abstract={NN set similarity search is a fundamental operation across numerous cloud computing applications. However, for security, the sensitive data processed in these searches must typically be encrypted prior to upload to a cloud server. Existing solutions for KNN set similarity search on encrypted datasets primarily rely on hybrid encryption schemes and operate under the assumption that cloud service providers are semi-honest. Yet, malicious actors could potentially infiltrate cloud platforms, representing a threat significantly beyond that posed by the semi-honest model. This paper introduces a novel computational framework leveraging multi-party secret sharing and garbled circuits. Designed to resist single-server compromise within cloud service providers, the scheme provably safeguards both data confidentiality and integrity in adversarial environments. The application scenario we envision is that the server is not regarded as the data owner. Each server can represent an independent party or a subset of data owners. In other words, as long as we ensure that at most one of the three servers is compromised, any number of data owners can merge their data into the framework. Experimental validation confirms our scheme satisfies formal security requirements for data privacy while demonstrating practical feasibility and operational robustness under tested conditions.},
  keywords={Cloud computing;Data privacy;Computational modeling;Resists;Nearest neighbor methods;Robustness;Encryption;Servers;Integrated circuit modeling;Computer security;KNN set similarity search;Encrypted data;Secure 3PC},
  doi={10.1109/ICAICE68195.2025.11382231},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10941803,
  author={Shang, Wenli and Yang, Xiaojun and Gu, Zhaojun and Wang, Shuang and Ding, Lei},
  booktitle={2024 10th International Conference on Computer and Communications (ICCC)}, 
  title={An Intrusion Detection System for the Internet of Vehicles Based on Multi-Level Hybrid Feature Analysis}, 
  year={2024},
  volume={},
  number={},
  pages={1976-1981},
  abstract={The rapid advancement of Internet of Vehicles (IoV) technology has increasingly automated and intelligentized modern vehicles. The connection between vehicle networks and external networks has become much closer, significantly increasing the risks of intrusions and threats, making vehicle network security more critical. This paper propose an intrusion detection model based on multi-level hybrid feature analysis to identify intrusions and threats in the IoV. The model utilizes parallel Long Short-Term Memory (LSTM), and One-Dimensional Convolution (Conv1D) to extract global and local features from input data separately and then merges these features to provide comprehensive and integrated hybrid features. It employs a multi-head attention mechanism to extract relationships at different positions in the sequence from multiple perspectives, and an improved emporal Convolutional Network (TCN) to further capture long-distance dependencies in the sequence, thereby extending the model's awareness of long-term dependencies. Finally, malicious traffic is identified through multi-classification. The proposed model was evaluated on two publicly available IoV security datasets, CICIoV2024 and CICIDS2017, achieving accuracy rates of 100% and 99.821 %, respectively. These findings underscore the effectiveness of our proposed model.},
  keywords={Analytical models;Attention mechanisms;Accuracy;Computational modeling;Intrusion detection;Network security;Feature extraction;Data models;Long short term memory;Internet of Vehicles;Internet of Vehicles;Intrusion Detection System;Conv1D;TCN;LSTM;PSO;Attention Mechanism},
  doi={10.1109/ICCC62609.2024.10941803},
  ISSN={2837-7109},
  month={Dec},}@INPROCEEDINGS{11156418,
  author={Panda, Susmita and Gadepally, Krishna Chaitanya and Dhal, Sambandh Bhusan and Nowka, Kevin and Kalafatis, Stavros},
  booktitle={2025 International Conference on Innovations in Intelligent Systems: Advancements in Computing, Communication, and Cybersecurity (ISAC3)}, 
  title={A Privacy First Path Analysis using Clickstream Data}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In the modern digital economy, data-driven decision-making is crucial for effectively meeting the ever-evolving demands of consumer engagement and satisfaction. Clickstream data has become invaluable for understanding customer behavior, yet concerns over privacy and security persist, especially with some internet service providers profiting from its sale. This article introduces an innovative methodology that blends experiential learning with advanced cryptographic techniques, including differential privacy and graph analytics. The core objective of this methodology is to estimate Customer Lifetime Value (CLV) by analyzing clickstream data, achieving an average prediction accuracy of 92.4% in user engagement levels while ensuring user anonymity through Recency, Frequency, and Monetary (RFM) analysis. Our study introduces the concept of a "data depositor" and a privacy manager, employing the composition theorem to merge non-adaptive queries effectively. Privacy budgets (ϵ =1.0, δ = 10−5), sensitivity-specific techniques, and data partitioning were applied. Randomization and noise addition protect data integrity, with special handling for categorical values. This approach, differing from prior studies, offers a 12.6% improvement in privacy-preserving targeting accuracy while maintaining strict confidentiality, presenting a novel path forward in data-driven decision-making.},
  keywords={Differential privacy;Privacy;Technological innovation;Accuracy;Decision making;Web and internet services;Time series analysis;Standards organizations;Regulation;Cryptography;Clickstream;cryptographic techniques;differential privacy;graph analytics;Customer Lifetime Value;RFM analysis},
  doi={10.1109/ISAC364032.2025.11156418},
  ISSN={},
  month={July},}@INPROCEEDINGS{10752172,
  author={Gupta, Shreya and Patiyar, Kartikey and Shrivastava, Ankit and Bairwa, Amit Kumar},
  booktitle={2024 IEEE Region 10 Symposium (TENSYMP)}, 
  title={Infusing Data Feeds and Models on Blockchain Contracts Through Oracle Based Infrastructure}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Recent technological advancements have made many industries more reliant on technology, which has led to an exponential increase in the amount of data generated every day. However, this surge in data has been driven by concerns including data breaches and lack of data management. Data security, integrity, efficient management, and advanced data analysis are the issues that are yet to be solved effectively. The extensive use of Artificial Intelligence (AI) and Centralized data storage have made it more accessible to sensitive information on computer networks and data breaches. This paper aims to address these challenges by ensuring secure data storage, sharing and computation within the systems, services and web browsers by using Big Data tools and frameworks along with AI and merge of Blockchain. The adoption of Blockchain Technology is of paramount importance in providing tamper-proof, ownership-guaranteed data, ensuring secure and dependable data sharing. Additionally, onchain Oracles have been used to improve connectivity from real-world data sources. The use of Big Data frameworks and tools, creates a strong infrastructure for data administration, monitoring, predictions, and analysis. The approach provides increased security, efficient management, and better connection in a decentralized manner.},
  keywords={Industries;Soft sensors;Memory;Data breach;Big Data;Data models;Blockchains;Artificial intelligence;Surges;Monitoring;Blockchain;Big Data;AI;Oracles;Apache Hadoop},
  doi={10.1109/TENSYMP61132.2024.10752172},
  ISSN={2642-6102},
  month={Sep.},}@ARTICLE{9982636,
  author={Tseng, Jerry C. C. and Hsieh, Sun-Yuan and Tseng, Vincent S.},
  journal={IEEE Access}, 
  title={A Scalable Analytical Framework for Complex Event Episode Mining With Various Domains Applications}, 
  year={2022},
  volume={10},
  number={},
  pages={130672-130685},
  abstract={With the ubiquity of sensor networks and smart devices that continuously collect data, we face the challenge of analyzing the growing stream of data in real time. In recent years, there has been a huge need to gain useful knowledge by incrementally analyzing event sequence data. Although episode pattern mining techniques have existed for years, people have recently become more aware of their practical value in solving real-life domain problems such as manufacturing records, stock markets, and weather forecasts. The effective and efficient application of episode pattern mining techniques to analyze complex event data is becoming increasingly important for solving real-life problems in wide domains. However, few studies have focused on developing a scalable framework based on episode pattern mining of complex event sequences for applications in various domains. In this work, we propose a novel framework named SAAF (Scalable Analytical Application Framework) based on complex event episode mining techniques, including batch episode mining, delta episode mining, incremental episode mining, and pattern merging, to consider both efficiency and accuracy. Moreover, to enhance scalability, we adopt the lambda architecture with Apache Spark and Apache Spark Streaming as the system development framework. Finally, the experimental results on three real datasets of different domains and two benchmark datasets showed that the proposed SAAF framework exhibits excellent performance in terms of efficiency, accuracy, and scalability.},
  keywords={Data mining;Scalability;Cluster computing;Urban areas;Systems architecture;Sparks;Smart devices;Pattern recognition;Complex event sequence;data stream;episode pattern mining;incremental mining;lambda architecture},
  doi={10.1109/ACCESS.2022.3228962},
  ISSN={2169-3536},
  month={},}@ARTICLE{8801873,
  author={Zhang, Linfeng and Jia, Hongfei and Forcadel, Nicolas and Ran, Bin},
  journal={IEEE Access}, 
  title={Junction Conditions for Hamilton–Jacobi Equations for Solving Real-Time Traffic Flow Problems}, 
  year={2019},
  volume={7},
  number={},
  pages={114334-114348},
  abstract={In this paper, we propose junction conditions for discontinuities due to local perturbation, diverging, merging, and multi-in-multi-out junctions. Traffic flows on junctions can be described by a system of coupled Hamilton-Jacobi equations. At their connection points, it is necessary to propose appropriate junction conditions to close the system. Then, we provide an effective numerical method to compute approximate solutions to these Hamilton-Jacobi equations on junctions. The numerical boundary conditions to close the Hamilton-Jacobi system are also proposed. Numerical tests demonstrate the effectiveness of both the proposed junction conditions and the numerical method.},
  keywords={Junctions;Mathematical model;Perturbation methods;Roads;Numerical models;Microscopy;Real-time systems;Hamilton-Jacobi equation;junction condition;traffic flow;local perturbation;macroscopic model},
  doi={10.1109/ACCESS.2019.2935535},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11388782,
  author={Kumar, K. Sheshu and Prasad, N. Bhanu and Vemuganti, Hari Priya},
  booktitle={2025 IEEE 3rd International Symposium on Sustainable Energy, Signal Processing and Cybersecurity}, 
  title={Synthesis of Stacked HSC-L RSC Topology for Enhanced Multilevel Inverter Performance}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Motivated by the thrust need and significance of Fault tolerant, redundant, modular, compact and efficient topologies of multilevel inverter (MLI), this paper introduces synthesis of a novel stacked HSC-L configuration to enhance the performance of Reduced Switch Count Multilevel Inverters (RSC-MLI). The proposed topology merges the concept Hexagonal Switched Cell (HSC) and Level Doubling Network (LDN), to achieve elevated voltage levels using fewer switches, while improving harmonic performance and fault tolerance. Utilizing the redundancies of the HSC and, level-doubling features of LDN, the developed HSC-L performs efficiently under both symmetrical and asymmetrical DC voltage conditions, for both healthy and open circuit (OC) switch fault conditions. A Hybrid Pulse Width Modulation (PWM) technique, combining simplified reduced carrier-based and switching function PWM, is developed to optimize switching logic to support fault tolerant operation. Simulation of the output voltage and current affirm the superiority of the HSC-LDN synthesis over traditional MLI and RSC-MLI configurations. Furthermore, the compact, modular design and its ability to double voltage levels without increasing device stress highlight its potential for applications in photovoltaic systems and electric vehicle charging.},
  keywords={Photovoltaic systems;Performance evaluation;Network topology;Fault tolerant systems;Switches;Voltage;Computer architecture;Pulse width modulation;Multilevel inverters;Topology;Hexagonal switched Cell (HSC);LDN (Level Doubling Network);Reduced Carrier (RC);Total Harmonic Distortion (THD);Reduced switch count (RSC);Switch function PWM;Multilevel Inverters (MLI)},
  doi={10.1109/iSSSC66652.2025.11388782},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11318681,
  author={Ayad, Manal Ait and Kissi, Chaïmaâ and Moumen, Idriss and Boujiha, Tarik},
  booktitle={2025 7th International Symposium on Advanced Electrical and Communication Technologies (ISAECT)}, 
  title={Invisible and Resilient Digital Watermarking of Multimedia Using AI}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The digital multimedia knows an exponential growth which leads to major problems associated to privacy, authenticity, data protection, copyright protection, and data integrity. A brief survey has shown that traditional digital watermarking methods such as LSB, DCT, DWT, and SVD do not tolerate compression, geometric distortions, noise and hybrid/combined attacks. Furthermore, these conventional techniques lack of adaptability to various media formats. Recently, with the exponential developments in the fields artificial intelligence (AI) and Deep Learning, it has been proven to strengthen and help the creation of robust and invisible digital watermarking systems that jointly optimize imperceptibility and resilience. At this regard, this article proposes a novel simplified AIbased digital watermarking approach that exceeds the performance of the commonly used approaches such as HiDDeN and InvisMark by taking into account their computational complexity, reproducibility, and deployment in complex and constrained environments. The proposed method in this study is focused on the use of an encoder-decoder pipline merged with latent space insertion, adversarial learning, and resilient perturbation simulation. These components involvement was considered in the design of the solution to achieve an optimal balance between robustness, efficiency and invisibility. In contrast, available approaches focuse merely and basically on processing images, while this study also extend digital watermaking to videos by implementing 3D CNNs and ConvLSTMs. Improvements over the original study, these include conserving the core concept of the idea behind the study: temporal consistency and stability due to distortion and codec reencoding. Other issues including security and regulatory considerations are discussed in this work with respect to responsible use in real-world applications. compliance with data protection frameworks. Further, The concerns should be checked and verified with regard to resilience and critical ethical against removal attacks using AI Advanced techniques. Hence, by considering all these aspects, this work presents a demonstrate the potential of AI-based watermarking to provide scalable, invisible, and robust protection for digital media both in academics, science, and industries.},
  keywords={Deep learning;Noise;Watermarking;Streaming media;Media;Distortion;Robustness;Artificial intelligence;Videos;Resilience;Digital watermarking;Artificial intelligence;Deep learning;Encoder–decoder architectures;Latent space embedding;Generative Adversarial Networks;Robustness;Imperceptibility;Video watermarking;Temporal consistency;Blockchain;Multimedia security;Copyright protection},
  doi={10.1109/ISAECT68904.2025.11318681},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11209274,
  author={Dhakshunhaamoorthiy and Gupta, Sriram Avinash and Sai Rithvik, Nettem Chiranjeevi and Likhith Kumar, Naga Poola},
  booktitle={2025 2nd International Conference on Computing and Data Science (ICCDS)}, 
  title={AI-Driven Health Portal: Machine Learning for Chronic Disease Prediction and Personalized Care}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Chronic disease is on the rise-anaemia, hypertension, diabetes, and hypercholesterolemia- it, thus, demands continuous monitoring and early diagnosis. We present an AI-based Health Portal System integrating machine learning, predictive analytics, telemedicine, and a chatbot assistant for personalized health insights. Trained on more than 10,000 clinical records, the system employs Logistic Regression, Random Forest, and Decision Tree classifiers, with an accuracy of 90.50%-100% and precision over 97%. The anaemia model predicts severity levels and polycythaemia, the hypertension model analyses blood pressure readings, and the cholesterol model detects hyperlipidaemia. The diabetes model had real-world validation and was very high in predictability, achieving 100% accuracy. The RAG-propelled chatbot powered by FAISS indexing enables rapid retrieval of medical data and telemedicine services. The evaluation metrics authenticate the reliability of the models. Future works will include the expansion of the datasets, hyperparameter tuning, merging with deep learning, and conducting clinical validation for AI's great disruptive role in digital health.},
  keywords={Hypertension;Analytical models;Accuracy;Telemedicine;Anemia;Predictive models;Chatbots;Diabetes;Portals;Diseases;Anaemia;diabetes;hypertension;hypercholesterolemia;RAG-based chatbot;FAISS indexing;predictive analytics},
  doi={10.1109/ICCDS64403.2025.11209274},
  ISSN={},
  month={July},}@INPROCEEDINGS{11376703,
  author={Sen, Sumit and Chauhan, Lokendra},
  booktitle={2025 Global Conference on Information Technology and Communication Networks (GITCON)}, 
  title={Predictive Analytics using Geolocation in Logistics: A Review}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Geolocation-based predictive analytics is revolutionizing logistics by merging real-time spatial intelligence with advanced forecasting models to enable smarter, faster, and more adaptive decision-making. This review synthesizes key technologies—such as GPS, RFID, UAVs, and IoT—that underpin this transformation, and explores how they integrate with machine learning, edge computing, blockchain, and big data platforms. We examine predictive modeling techniques applied to demand forecasting, dynamic routing, fleet maintenance, and anomaly detection. Sector-specific applications in commercial freight, cold chain logistics, and military supply chains are highlighted to demonstrate practical value. Emerging paradigms, including digital twins, federated learning, and explainable AI, are discussed as critical enablers for secure, scalable, and privacy-aware logistics infrastructures. The paper concludes by identifying persistent challenges such as data quality, system interoperability, and model interpretability—offering a roadmap for future research and implementation. This comprehensive review underscores the need for integrated, resilient, and data-driven logistics systems capable of operating at scale in dynamic environments.},
  keywords={Reviews;Geology;Computational modeling;Predictive models;Real-time systems;Data models;Digital twins;Predictive analytics;Edge computing;Radiofrequency identification;Predictive analytics;geolocation;logistics;machine learning;edge computing;digital twins;IoT},
  doi={10.1109/GITCON65266.2025.11376703},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11497223,
  author={Panda, Sneha and Panwar, Ruby},
  booktitle={2026 IEEE International Conference on Emerging Computing and Intelligent Technologies (ICoECIT)}, 
  title={From Detection to Perception: AI vs Human Content and Its Impact on News Trustworthiness}, 
  year={2026},
  volume={},
  number={},
  pages={1-10},
  abstract={The explosive growth of artificial intelligence (AI) has impacted the newsrooms arena via rendering it attainable to crank out contents on a broad spectrum that occasionally exceeds remarks composed manually on the basis of cohesiveness and elegance. No matter their prospects for attainment and convenience, these breakthroughs spell major issues regarding the audience’s solidity, decency, and devotion. The research presented here separates nuances of synthetically intelligent and human-composed content, illustrating how detection mechanisms—both analytical and subjective prejudicial influence—consumers’ attitudes toward legitimacy. By tracking spectator impressions, topical features, and assessment robustness, the empirical investigation demonstrates that however AI systems might deliver remarkably exact outcomes, patrons are prone to embrace human-generated narrative due to its implied realness and deep heritage. The exploration additionally points to the demand for multifaceted detection mechanisms that merge human assessments with Artificial Intelligence-based strategies for classification in an endeavor to hedge against erroneous assertions and boost civility. The primary objective of this research is to utilize Natural Language Processing (NLP) and Machine Learning (ML) techniques to experimentally differentiate among news articles created by AI versus those generated by humans. Additionally, it examines the relationship among audience perceptions of news authenticity and language usage and visual aspects found by algorithmic detection. This study extends our knowledge of how AI-mediated news influences the legitimacy of information by combining detection performance with intellectual aspects related to trust.},
  keywords={Feeds;Antennas;Broadcasting;Broadcast technology;Motion pictures;Feedback;MIMICs;Circuits;Millimeter wave integrated circuits;Monolithic integrated circuits;Data tracking;trust among readers;narrative legitimacy;computerized publication;ethics in journalism;recognition procedures;substance created via AI;and content published by mankind},
  doi={10.1109/ICoECIT68303.2026.11497223},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{10968525,
  author={Sengupta, Arijit and Ramteke, Vidyavati},
  booktitle={2025 IEEE 14th International Conference on Communication Systems and Network Technologies (CSNT)}, 
  title={Leveraging Next-Generation Business Intelligence for Proactive Cybersecurity Defense}, 
  year={2025},
  volume={},
  number={},
  pages={414-419},
  abstract={This paper explores how Business Intelligence operates better for protecting cybersecurity through its capability to merge predictive analytics methods with real-time data detection. A qualitative research design enables us to study how BI systems fit into present-day cybersecurity practices, specifically through predictive threat prevention alongside real-time database data. The evaluation process of BI tools leads organizations to select the most valuable system for detecting threats and minimizing risks. We introduce a data-oriented defense system that uses BI tools to implement proactive cybersecurity protection methods. The assessment focuses on implementing obstacles by understanding the main obstacles that stem from data privacy regulations, data overload, and worker skill gaps. The research establishes an orga- nized method which helps organizations use data analytics and automated threat identification to boost their security position through BI-based security tactics. The research shows that BI tools should be incorporated into cybersecurity approaches since they build robust security protocols and decrease vulnerability risks while fostering better resistance against modern security threats.},
  keywords={Resistance;Protocols;Prevention and mitigation;Organizations;Real-time systems;Threat assessment;Regulation;Business intelligence;Computer security;Protection;Business Intelligence (BI);Cybersecurity;Threat Detection},
