  ISSN={2474-9745},
  month={March},}@INPROCEEDINGS{11426429,
  author={Shams, Amiruddin and Bharathi, A. and Reddy, G. Ravi Shankar and Kumar, Navneet},
  booktitle={2025 IEEE Microwaves, Antennas, and Propagation Conference (MAPCON)}, 
  title={Compact Wideband Meta-Material Inspired E Shape Stub Resonator ZOR Antenna}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Compact size and wide bandwidth are increasingly vital for antennas in modern wireless systems, where volume, space, and efficiency are at a premium. This paper presents a compact antenna based on a zeroth-order resonator (ZOR) configuration suitable for broadband applications. The proposed design utilizes a coplanar waveguide (CPW) fed novel E-shaped stub resonator and a rectangular patch etched on an FR4 Epoxy substrate to achieve Composite Right/Left-Handed (CRLH) characteristics. The structure supports ZOR behavior around 4.06 GHz, enabling significant size reduction while maintaining efficient performance. It also supports a conventional $\lambda / 2$ resonance at 5.5 GHz and contributes to 7.12 GHz from its hybrid mode behavior. Additionally, the design incorporates narrow slots on the ground plane to merge the three resonant frequencies, thereby enhancing the bandwidth. The antenna is simulated in High Frequency Structure Simulator (HFSS) EM simulation software tool and validated through experimental measurements. The simulated and measured results depict close correlation in terms of impedance bandwidth, gain and radiation pattern characteristics. The antenna achieves a 4.3 GHz impedance bandwidth in a compact form factor while maintaining an omnidirectional radiation pattern. The proposed ZOR antenna is well suited for satellite communication and compact wireless applications.},
  keywords={Microwave antennas;Antenna measurements;Wireless communication;Shape;Resonance;Coplanar waveguides;Broadband antennas;Impedance;Wideband;Antenna radiation patterns;Wideband Antenna;Metamaterial Antenna;E Shape Stub Resonator;Zeroth Order Resonance Antenna;Composite Right/Left Handed},
  doi={10.1109/MAPCON65020.2025.11426429},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10446016,
  author={Yang, Lei and Liu, Wei and Meng, Ruijie and Lee, Gunwoo and Baek, Soonho and Moon, Han-Gil},
  booktitle={ICASSP 2024 - 2024 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Fspen: an Ultra-Lightweight Network for Real Time Speech Enahncment}, 
  year={2024},
  volume={},
  number={},
  pages={10671-10675},
  abstract={Deep learning-based speech enhancement methods have shown promising result in recent years. However, in practical applications, the model size and computational complexity are important factors that limit their use in end-products. Therefore, in products that require real-time speech enhancement with limited resources, such as TWS headsets, hearing aids, IoT devices, etc., ultra-lightweight models are necessary. In this paper, an ultra-lightweight network FSPEN is proposed for real-time speech enhancement task. We propose a full-band and sub-band network structure for extracting global and local features, and an inter-frame path extension method that can enhance network modeling capacity while preserving complexity. Experiments demonstrate that the proposed FSPEN achieves a performance of PESQ 2.97 on the VoiceBank+Demand dataset at 89M multiply-accumulate operation per second (MAC) and 79k parameters.},
  keywords={Performance evaluation;Headphones;Quantization (signal);Computational modeling;Speech enhancement;Feature extraction;Hearing aids;Speech enhancement;noise suppression;lightweight;dual-path;deep learning},
  doi={10.1109/ICASSP48485.2024.10446016},
  ISSN={2379-190X},
  month={April},}@INPROCEEDINGS{9621192,
  author={Son, Jeong-Woo and Lee, Sunghee and Han, Min-ho},
  booktitle={2021 International Conference on Information and Communication Technology Convergence (ICTC)}, 
  title={Supervised Service Classification using Downlink Control Indicator in LTE Physical Downlink Control Channel}, 
  year={2021},
  volume={},
  number={},
  pages={1533-1536},
  abstract={Service classification for mobile traffic is an essential task for traffic management and service improvements. This paper proposed a supervised model based on multi-modal deep neural networks to classify mobile traffic into their services. Specifically, the proposed model is specialized to handle Downlink Control Indicator (DCI) obtained from Long Term Evolution (LTE) Physical Downlink Control CHannel (PDCCH). DCI contains control information such as Radio Network Temporary Identifier (RNTI), Resource Block (RB) assignment, and so on. Thus, it can observe which RNTI used an LTE Cell and the corresponding device used how many RBs. It is natural to regard the information in DCI as a sequential vector, the proposed model is designed with Recurrent Neural Networks (RNNs). Furthermore, dual modalities in DCI (downlink and uplink control information) are efficiently co-working by the hierarchical structure of the proposed model. With evaluations of the proposed model, we proved the efficiency of the model in the real-world data manually gathered during sixteen hours. The analysis of the experimental results suggested more problems to handle DCIs for service classification as well.},
  keywords={Deep learning;Training;Analytical models;Recurrent neural networks;Downlink;Throughput;Data models;LTE traffic;service classification;DCI;Hierarchical Deep Neural Networks},
  doi={10.1109/ICTC52510.2021.9621192},
  ISSN={2162-1233},
  month={Oct},}@INPROCEEDINGS{9038959,
  author={Vasilyev, Nikolay O. and Tiunov, Ivan V. and Ryzhova, Daria I.},
  booktitle={2020 IEEE Conference of Russian Young Researchers in Electrical and Electronic Engineering (EIConRus)}, 
  title={The Simulated Annealing Based Logical Resynthesis Method for LUT-based FPGAs}, 
  year={2020},
  volume={},
  number={},
  pages={1892-1894},
  abstract={The paper proposes the simulated annealing based method of logical resynthesis for LUT-based FPGAs. For this method special graph model and transition logical operators on this graph were developed. To solve the resynthesis problem simulated annealing algorithm is used. It is applied over small subgraphs of the original circuit within an iterative cycle. While annealing procedure the developed logical operators change the structure of the graph without changing its logical function. The objective function for the area optimization of the circuit by reducing number of graph nodes was developed. The considered method was tested on the set of the combinational circuits from the ISCAS-85 benchmark. The test results show the maximum area reduction up to 34% and 16% of an average area reduction compared to circuits obtained by FlowMap algorithm.},
  keywords={Annealing;Conferences;Simulated annealing;Benchmark testing;Linear programming;Combinational circuits;Integrated circuit modeling;FPGA;resynthesis;LUT},
  doi={10.1109/EIConRus49466.2020.9038959},
  ISSN={2376-6565},
  month={Jan},}@INPROCEEDINGS{11170138,
  author={Cao, Wei and Zhang, Yuhan and Xia, Congzi and Yang, Zhongming},
  booktitle={2025 International Conference on IOT, Data Science and Advanced Computing (IDSAC)}, 
  title={A adaptive color space merged feature enhancing framework for underwater image enhancement}, 
  year={2025},
  volume={},
  number={},
  pages={129-134},
  abstract={In response to the core challenges of single color space modeling and low feature fusion efficiency in underwater image enhancement, this paper proposes an adaptive instance feature enhancement bottleneck framework named AIF-FBE. This framework integrates the collaborative learning of Red Green Blue (RGB) and CIELab dual branches. The AIF-FBE uses a dual-branch structure to parallelly extract the intuitive color features (RGB branch) and structural semantic features (Lab branch) of underwater images. Basic blurred features are extracted using ResBlock, and the AIF module is used to achieve adaptive alignment and deep fusion of cross-space features. The AIF module utilizes the AdaIN technique to calibrate the feature distribution differences of the dual branches and combines lightweight convolution and residual connections for precise fusion. The FBE module adopts a "multi-scale convolution encoding attention decoding" structure to restore the blurred features. The encoding end enhances feature interaction and suppresses noise through ConvBlock, and the decoding end improves the spatial resolution through upsampling, the Efficient Local Attention (ELA) mechanism, and deconvolution operations. This method enhances the structural texture details in the blurred areas. AIF-FBE achieved scores of 0.629 and 1.444 on the underwater color image quality evaluation (UCIQE) and non-reference underwater image quality measure (UIQM) quantitative metrics respectively, significantly outperforming existing algorithms. Visually, it can also present more natural seabed textures, clearer object boundaries, and better color balance. This method can provide key technical support for downstream underwater vision applications in practical scenarios.},
  keywords={Measurement;Image color analysis;Convolution;Federated learning;Lighting;Feature extraction;Distortion;Decoding;Image restoration;Image enhancement;Underwater Image Enhancement;Underwater;Dual-Color Space;Adaptive instance feature enhancement;Multi-Scale convolution encoding attention decoding},
  doi={10.1109/IDSAC65763.2025.11170138},
  ISSN={},
  month={July},}@INPROCEEDINGS{10718593,
  author={Nagarubini, K. Hari and Suthendran, K.},
  booktitle={2024 Third International Conference on Electrical, Electronics, Information and Communication Technologies (ICEEICT)}, 
  title={Beyond Boundaries: Region Filling with Image Data Clustering}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Original region filling algorithms for image processing face challenges in computational complexity, limiting their use in real-time and resource-constrained applications. The proposed two-step method priorities efficiency. To streamline clustering, the image preprocessing first removes all-zero rows and columns, focusing the algorithm on informative data for identifying fill regions, without the need for explicit boundary detection. After filling occurs, it reintroduces the initially removed rows and columns to retain the original structure. This temporary zero removal boosts clustering efficiency while preserving data integrity. The proposed algorithm surpasses traditional methods, especially when dealing with large and single hole images, as evidenced by experimental results.},
  keywords={Image segmentation;Limiting;Noise;Clustering algorithms;Streaming media;Filling;Real-time systems;Information and communication technology;Time complexity;Image reconstruction;Clustering;Computational Complexity;Efficient Algorithm;Image Processing;Region filling},
  doi={10.1109/ICEEICT61591.2024.10718593},
  ISSN={},
  month={July},}@ARTICLE{9491477,
  author={Nandi, S and Das, M and Dwarakanath, K S},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Tracing the evolution of ultraluminous infrared galaxies into radio galaxies with low frequency radio observations}, 
  year={2021},
  volume={503},
  number={4},
  pages={5746-5762},
  abstract={We present radio observations of ultraluminous infrared galaxies (ULIRGs) using the Giant Metrewave Radio Telescope (GMRT) and combine them with archival multifrequency observations to understand whether ULIRGs are the progenitors of the powerful radio loud galaxies in the local Universe. ULIRGs are characterized by large infrared luminosities (LIR > 1012 L⊙), large dust masses (∼108 M⊙), and vigorous star formation (star formation rates ∼10–100 M⊙ yr−1). Studies show that they represent the end stages of mergers of gas-rich spiral galaxies. Their luminosity can be due to both starburst activity and active galactic nuclei (AGNs). We study a sample of 13 ULIRGs that have optically identified AGN characteristics with 1.28 GHz GMRT observations. Our aim is to resolve any core-jet structures or nuclear extensions and hence examine whether the ULIRGs are evolving into radio loud ellipticals. Our deep, low frequency observations show marginal extension for only one source. However, the integrated radio spectra of 9 ULIRGs show characteristics that are similar to that of GPS/CSS/CSO/young radio sources. The estimated spectral ages are 0.4–20 Myr and indicate that they are young radio sources and possible progenitors of radio galaxies. Hence, we conclude that although most ULIRGs do not show kpc scale extended radio emission associated with nuclear activity, their radio spectral energy distributions do show signatures of young radio galaxies.},
  keywords={galaxies: active;galaxies: evolution;galaxies: jets;galaxies: nuclei;radio continuum: galaxies},
  doi={10.1093/mnras/stab275},
  ISSN={1365-2966},
  month={Dec},}@ARTICLE{8861113,
  author={Barman, Debaditya and Bhattacharya, Subhayan and Sarkar, Ritam and Chowdhury, Nirmalya},
  journal={IEEE Transactions on Computational Social Systems}, 
  title={ $k$ -Context Technique: A Method for Identifying Dense Subgraphs in a Heterogeneous Information Network}, 
  year={2019},
  volume={6},
  number={6},
  pages={1190-1205},
  abstract={Most real-life problems can be modeled using heterogeneous networks, as they consist of several interconnected entities. However, researchers often study most of these problems as projected homogeneous networks. In such networks, different entities can be merged, some entities can be removed, or interactions among some entities can be overlooked, which results in a significant information loss. Moreover, these networks often overlook different structural possibilities in heterogeneous networks. Different structural possibilities may include a hierarchical network topology or a centralized network topology. Mining on different structural topologies of a heterogeneous information network may lead to a better understanding of the behavior and characteristics of the individual entities and the network as a whole. This article proposes a novel approach named k-context technique for extracting dense subgraphs from different structural topologies of the heterogeneous information network. The approach has been evaluated using both synthetic and real-life data sets, and it compared the results with an existing algorithm for finding dense subgraphs from a homogeneous information network.},
  keywords={Network topology;Data mining;Heterogeneous networks;Social networking (online);Clustering algorithms;Sun;Topology;Dense subgraphs;graph mining;heterogeneous networks;homogeneous networks;information retrieval},
  doi={10.1109/TCSS.2019.2942323},
  ISSN={2329-924X},
  month={Dec},}@INPROCEEDINGS{10763224,
  author={Shahade, Aniket K and Deshmukh, Priyanka V},
  booktitle={2024 4th International Conference on Sustainable Expert Systems (ICSES)}, 
  title={Enhancing Natural Language Processing: A Comprehensive Review of Retrieval Augmented Generation}, 
  year={2024},
  volume={},
  number={},
  pages={609-611},
  abstract={Retrieval augmented generation (RAG) has emerged as a promising approach in natural language processing, combining retrieval and generation techniques to produce high-quality text. By incorporating external knowledge into the generation process, RAG addresses the limitations of generative models that rely solely on learned information. This review explores the foundational principles and architecture of RAG, which typically involves a two-step process: retrieving relevant information based on the input query and generating text informed by both the query and the retrieved knowledge. The review discusses key considerations for the retriever and generator components, as well as the integration of retrieved knowledge into the generative model. By understanding the underlying principles and architecture of RAG, researchers and practitioners can leverage this powerful technique to improve the quality and contextual relevance of text generation tasks.},
  keywords={Ethics;Reviews;Refining;Merging;Information processing;Reliability engineering;Question answering (information retrieval);Generators;Protection;Expert systems;Naïve Bayes;K Nearest Neighbor;Exploratory data analysis;ANN},
  doi={10.1109/ICSES63445.2024.10763224},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{8981411,
  author={Nidhom, Ahmad Mursyidun and Smaragdina, Azhar Ahmad and Dyah, K N Gres and Andika, Bagus Nur R P and Setiadi, Cahyono P and Yunos, Jailani Md},
  booktitle={2019 International Conference on Electrical, Electronics and Information Engineering (ICEEIE)}, 
  title={Markerless Augmented Reality (MAR) through Learning Comics to Improve Student Metacognitive Ability}, 
  year={2019},
  volume={6},
  number={},
  pages={201-205},
  abstract={This study aims to apply the concept of markerless augmented reality through learning comics to improve students' metacognitive abilities, metacognitive abilities need to be improved because they relate to creativity, creativity and the correlation of other abilities in learning. This study uses the Borg and Gall development method with the aim of developing consistent and disseminated products, the result of this research is the development of Augmented Reality applications with the Markerless AR concept coupled with learning comics that have passed expert validation tests with an average percentage validity of 98.3%, then the material developed in this study also fulfills the learning outcomes with an average percentage of validity from material experts at 97.9%. Besides that, the development of AR Application with the concept of Markless AR has an average value of the percentage of prospective user trials of 98.1%, it is said to be high in the level of usability and level of flexibility of use. with a test value of 0.981. This increase is possible because other factors namely imaginative abilities and integration capabilities also increased due to the use of Markerless AR. It can be concluded that markerless augmented reality research through learning comics can improve students' metacognitive abilities.},
  keywords={Technological innovation;Merging;Metacognition;Media;Hybrid learning;Usability;Augmented reality;Creativity;Videos;Testing;Learning Comics;Augmented Reality},
  doi={10.1109/ICEEIE47180.2019.8981411},
  ISSN={},
  month={Oct},}@ARTICLE{10252148,
  author={Shi, Gang and Wang, Xianglong and Ouyang, Yichen and Yao, Ruoheng and Chen, Zhuoyu and Zhang, Wei and Chen, Lei and An, Fengwei},
  journal={IEEE Transactions on Circuits and Systems I: Regular Papers}, 
  title={A Spatio-Temporal Video Denoising Co-Processor With Adaptive Codec}, 
  year={2023},
  volume={70},
  number={11},
  pages={4223-4234},
  abstract={With the increasing demand for high-resolution video and real-time processing, the limited efficiency of video-denoising algorithms has become a critical factor. This paper proposes a spatio-temporal video denoising co-processor to suppress an image sequence’s spatial and temporal noise. Temporal denoising is achieved by merging the current and previous frames at the pixel level in which the current frame is processed by a spatial filter. After exploiting noise estimation and motion detection, the Wiener filter calculates the merge ratio. Rather than buffering the entire previous frame, the JPEG-like codec can dynamically adjust the compression ratio through a predefined quantization table to satisfy the designed on-chip storage. The experimental results demonstrate that the spatio-temporal denoising co-processor can effectively eliminate the fluctuation of the grayscale value of the noise in videos. Simultaneously, the adaptive codec can reduce the storage space consumption for the frame buffer by at least 80% of the original size. To the best of our knowledge, this is the first fully integrated spatio-temporal denoising co-processor without any external memory. Additionally, the grayscale, RGB, and RAW versions of the co-processor are also implemented on the Stratix V FPGA platform and synthesized in 28nm CMOS technology.},
  keywords={Streaming media;Wiener filters;Image coding;Hardware;Estimation;Real-time systems;Low-pass filters;Noise reduction;FPGA;image compression;motion estimation},
  doi={10.1109/TCSI.2023.3311486},
  ISSN={1558-0806},
  month={Nov},}@ARTICLE{11058960,
  author={He, Jianjun and Ji, Xiao and Chen, Zhipeng and Shen, Ling and Gui, Weihua},
  journal={IEEE Transactions on Automation Science and Engineering}, 
  title={High-Definition Light and Shadow Reconstruction of Blast Furnace Burden Surface Images Based on a Spatiotemporal Multi-Domain Guided Generative Model}, 
  year={2025},
  volume={22},
  number={},
  pages={18243-18254},
  abstract={The blast furnace (BF) is the most energy-consuming and emission-intensive equipment in the steel industry. Burden surface images provide reliable and concrete information that is crucial for real-time monitoring, understanding burden distribution, and ensuring efficient and green operations. However, the high-temperature, enclosed, dusty, and low-light environment within the BF results in images captured by high-temperature industrial endoscopes that suffer from unevenly illumination, abnormal light and shadow, and blurriness, limiting their application. This paper proposes a method for high-definition reconstruction of BF surface images based on a spatiotemporal multi-domain guided generative model (STMGG). This method constructs a deep image prior (DIP) network with an encoder-decoder mechanism to decompose the original burden surface image into illumination and reflectance maps across multiple domains. For the illumination maps, a multi-frequency-attention fusion block (MFAFB) extracts extreme bright and dark features from the original image, calculates the appropriate fusion weights for the illumination maps of each domain, and synthesizes an optimal distributed total illumination map to accurately restore light and shadow. For the reflectance maps, global temporal and multi-spatial domain local structural texture information guidance based on wavelet transform is introduced, along with a structural texture entropy loss, to ensure the generated reflectance maps focus on both global contours and local details, thus reducing blur. The final high-brightness, high-definition reconstruction of the BF burden surface is achieved by merging the total illumination and reflectance maps. Experimental results demonstrate that STMGG significantly enhances the quality of BF burden surface images and exhibits strong adaptability in general scene images, highlighting its broad applicability and significant practical value. Note to Practitioners—The motivation for this paper arises from the challenges of acquiring clear BF burden surface images using high-temperature endoscopes due to uneven lighting, abnormal light and shadow, and blurriness. These unclear images hinder accurate extraction of burden surface morphology, challenging precise BF control. A STMGG method leverages depth image priors and an encoder-decoder mechanism to reconstruct burden surface images with global temporal information and multi-frequency domain local detail information. BF operators can convert original images into high-definition, high-brightness images using STMGG, aiding in monitoring burden distribution and BF operations, thereby improving smelting process control. STMGG method has been tested in industrial settings, with future work focusing on optimizing performance for reliable and efficient use in harsh environments.},
  keywords={Surface morphology;Lighting;Endoscopes;Surface treatment;Surface reconstruction;Reflectivity;Optical surface waves;Optical imaging;Data mining;Image reconstruction;Blast furnace (BF);burden surface;spatiotemporal multi-domain;illumination map;reflectance map},
  doi={10.1109/TASE.2025.3584202},
  ISSN={1558-3783},
  month={},}@INPROCEEDINGS{10467595,
  author={Chatchalermpun, Surachai and Pornpongtechavanich, Phisit and Phanrattanachai, Kritphon and Daengsi, Therdpong},
  booktitle={2023 6th International Seminar on Research of Information Technology and Intelligent Systems (ISRITI)}, 
  title={Comparison of 5G-QoS After Merger Between Two Mobile Network Operators in Urban Areas Using Mobility Tests}, 
  year={2023},
  volume={},
  number={},
  pages={164-168},
  abstract={In late Q1/2023, DTAC and TRUE, two of major mobile network operators in Thailand, officially completed their merger. Consequently, this study was initiated to ascertain whether their respective 5G networks had also been seamlessly integrated several months following the merger. This investigation involved conducting drive tests along two predefined routes within the urban areas of Bangkok, employing the G-NetTrack Pro tool for testing and data collection. Subsequently, an array of Quality of Service (QoS) metrics, including Reference Signal Received Power (RSRP), Reference Signal Received Quality (RSRQ), Signal to Noise Ratio (SNR), and latency, were meticulously analyzed and presented. The findings of this study revealed that, despite the successful completion of the DTAC and TRUE mergers from a business standpoint, the technical integration of their respective 5G networks had not been finalized. Remarkably, roaming functionalities were still operational between the two networks.},
  keywords={Seminars;Measurement;Corporate acquisitions;5G mobile communication;Urban areas;Merging;Quality of service;QoS;RSRP;SNR;latency;drive tests},
  doi={10.1109/ISRITI60336.2023.10467595},
  ISSN={2832-1456},
  month={Dec},}@INPROCEEDINGS{8985010,
  author={Montoya-Arias, José Andrés and Tobar-Rosero, Oscar Andrés and Zapata-Madrigal, Germán D.},
  booktitle={2019 FISE-IEEE/CIGRE Conference - Living the energy Transition (FISE/CIGRE)}, 
  title={Automatic Configuration of Distance Relays with Process Bus under a Hardware in the Loop Scheme}, 
  year={2019},
  volume={},
  number={},
  pages={1-6},
  abstract={A wide area protection scheme can integrate adaptive protections through Ethernet communication links within power systems infrastructure. This integration permits the implementation of a decentralized control where each IED has the ability to change its own protections parameters when it detects a change in the electric grid topology. This topology change is provoked by fault occurrences that imply the operation outage of some line of the power system. In this work, the behavior of a SEL 421 protection device subscribed to GOOSE messages published by other IED in the network is exhibit. Those GOOSE messages indicate the relay operation and the opening of the line breaker, and then immediately change its protection parameters to others more adequate programmed in the relay configuration groups. Each configuration group has defined parameters for some power system topologies of the implemented electric grid. This process is accomplished through the emulation of a power system with an OP4510 real time simulation platform and a communications network that integrates IEDs operating under the standard IEC 61850. In this way, a contribution about the incorporation of these technologies with the mentioned standard is performed by virtue to increase the experiences concerning to the implementation and automation of digital substations in Colombia.},
  keywords={Power systems;IEC Standards;Software packages;Network topology;Topology;Monitoring;Merging;Power systems;Hardware in the loop;Electric protections;Adaptive protections;Real-time simulation;Wide area protections},
  doi={10.1109/FISECIGRE48012.2019.8985010},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10972786,
  author={Dos Santos, Wallesa D. M. Q. and Peretti, Adriano and Teixeira, João Marcelo X. N. and Peres, Fabiana F. F. and Mauricio, Claudio R. M. and Da Silva, Manoela M. O.},
  booktitle={2025 IEEE Conference on Virtual Reality and 3D User Interfaces Abstracts and Workshops (VRW)}, 
  title={Mixed Reality as a Tool to Enhance Mathematics Education in Elementary School}, 
  year={2025},
  volume={},
  number={},
  pages={224-227},
  abstract={This paper investigates the use of mixed reality technology to support mathematics instruction at the elementary level. An MR-based educational game focused on the four basic operations was developed and tested with a group of elementary school teachers, who provided feedback on its usability and potential for classroom integration. The results suggest that MR-based learning not only supports a deeper conceptual understanding of mathematics but also addresses a variety of learning preferences, creating a more inclusive and engaging educational environment. The study highlights the necessity for ongoing teacher training and resource development to fully harness the potential of MR in elementary school mathematics education.},
  keywords={Training;Headphones;Visualization;Three-dimensional displays;Merging;Mixed reality;Games;User interfaces;Mathematics;Usability;Augmented Reality;quiz;game;headset},
  doi={10.1109/VRW66409.2025.00055},
  ISSN={},
  month={March},}@INPROCEEDINGS{11232044,
  author={Elmaghraby, Ziad and Nassif, David and El-Badawy, Ayman},
  booktitle={2025 7th Novel Intelligent and Leading Emerging Sciences Conference (NILES)}, 
  title={L1-PID Control Strategy for Enhanced Path Tracking in UGVs}, 
  year={2025},
  volume={},
  number={},
  pages={494-499},
  abstract={Autonomous path tracking remains a critical component in the design of intelligent driving systems and has attracted extensive interest in recent years. This paper proposes a hybrid control approach that combines L1 Guidance Logic with a Proportional-Integral-Derivative (PID) controller to improve path tracking precision and lateral performance. While L1 Guidance Logic alone provides accurate geometric path following with low cross-track error, the integration of a PID controller—targeting the error between the desired and actual angular velocities—enhances the system’s responsiveness. The proposed method is evaluated through simulations under identical conditions alongside two widely used geometric guidance algorithms: Stanley and Pure Pursuit. Results demonstrate that the L1–PID hybrid approach achieves lower tracking errors and smoother trajectory following compared to conventional methods. This study highlights the benefits of combining geometric guidance laws with classical control to achieve improved performance in autonomous vehicle navigation.},
  keywords={Accuracy;Navigation;Merging;Trajectory;Logic;Reliability;PD control;Oscillators;Autonomous vehicles;L1 Guidance Logic;PID;Stanley;Pure Pursuit;Path tracking},
  doi={10.1109/NILES68063.2025.11232044},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{8917336,
  author={Yu, Xianghua and Zhang, Siyu and Wang, Yibing},
  booktitle={2019 IEEE Intelligent Transportation Systems Conference (ITSC)}, 
  title={Preventing Freeway Capacity Drop via MTFC and Ramp Metering}, 
  year={2019},
  volume={},
  number={},
  pages={1761-1767},
  abstract={Capacity drop at congested freeway bottlenecks is well known with a lot of field observations and accounts for severe performance degradation of road infrastructure. This paper addresses freeway ramp metering and mainstream traffic flow control (MTFC) at active bottlenecks, with an aim of avoiding capacity drop. A special attention was paid to the effects of capacity drop on the performance of control measures. Via mathematical analyses, it was first shown that the significance and usefulness of the control measures are justified by the presence of capacity drop in field. This was then verified via macroscopic simulation studies, with ramp metering, MTFC, and their integration formulated in a framework of coordinated and integrated optimal control. It was also demonstrated that an appropriate usage of the control measures can effectively prevent the activation of potential bottlenecks on freeways and hence avoid capacity drop there.},
  keywords={Traffic control;Optimal control;Merging;Analytical models;Trajectory;Numerical models;Intelligent transportation systems},
  doi={10.1109/ITSC.2019.8917336},
  ISSN={},
  month={Oct},}@ARTICLE{10965725,
  author={Li, Shuangxu and Zhu, Lei and Ma, Kaixue},
  journal={IEEE Transactions on Components, Packaging and Manufacturing Technology}, 
  title={Synthesis Design of Low-Loss and Self-Packaged Bandpass Filter on λ/4 SISL Resonators Using the Short-Open-Load (SOL) Technique}, 
  year={2025},
  volume={15},
  number={6},
  pages={1328-1336},
  abstract={In this article, an efficient and accurate synthesis design method for bandpass filters (BPFs) based on low-loss quarter-wavelength ( $\lambda $ /4) substrate integrated suspended line (SISL) resonators is proposed, using the short-open-load (SOL) calibration technique. The BPF topology is comprised of SISL with two volumes of vias on both side walls and alternating SISL-based J/K inverters. First, with the help of full-wave simulation, the propagation characteristics of the SISL with periodically loaded pins are analyzed and extracted by SOL. Afterward, to facilitate the filter synthesis design, the equivalent circuit parameters of each J/K inverter with symmetrical/asymmetrical feed lines are accurately extracted. Herein, the extra transition for circuit measurement can be directly merged into the input port of the  $J_{01}$  inverter and then be regarded as an error box to be calibrated out by SOL. Therefore, the efficient co-design of the resultant SISL BPF containing the feed transition can be achieved. Finally, two 4th-order all-pole Chebyshev SISL BPFs with  $\lambda $ /4 resonators are designed and fabricated. The synthesized, simulated, and measured results of all the implemented SISL BPFs are found in good agreement, evidently demonstrating the effectiveness of the SOL technique for designing the SISL circuits. In addition, the SISL BPFs have the advantages of low loss and self-packaging against traditional planar BPFs.},
  keywords={Band-pass filters;Resonators;Microwave filters;Inverters;Calibration;Topology;Resonator filters;Equivalent circuits;Standards;Microwave circuits;Bandpass filter (BPF);quarter-wavelength resonator;short-open-load (SOL) technique;substrate integrated suspended line (SISL);synthesis design},
  doi={10.1109/TCPMT.2025.3560983},
  ISSN={2156-3985},
  month={June},}@INPROCEEDINGS{10779539,
  author={Ciungan, Diana-Alexandra and Goga, Nicolae and Bratosin, Ioan-Alexandru and Popa, Ramona-Cristina},
  booktitle={2024 IEEE SmartBlock4Africa}, 
