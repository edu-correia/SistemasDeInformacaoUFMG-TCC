@INPROCEEDINGS{10770627,
  author={Kannikaklang, Nikorn and Wongthanavasu, Sartra},
  booktitle={2024 28th International Computer Science and Engineering Conference (ICSEC)}, 
  title={BiG: Bidirectional Graph Convolutional Networks for Social and Sequential Recommendation}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Graph convolutional networks have obviously influenced recommender systems. However, we argue that previous research has limitations: 1) unidirectional approaches are not enough to explicitly capture the representation learning, 2) social influence is ignored to extract the user preference drifts, and 3) simple and crude fusion methods are not enough to seamlessly amalgamate the diverse behavioral perspective. To address these limitations, this research proposes a novelty of Bidirectional Graph convolutional networks for social and sequential recommendation (BiG). A novel graph convolutional networks are modified into bidirectional graphs to explicitly learn the representation of dynamic user preference at social level and sequential level. A novel Bidirectional Gate (BiGate) is designed to amalgamate the diverse preferences of social and sequential influences. Empirical experiment illustrates that BiG outperforms state-of-the-art methods.},
  keywords={Representation learning;Computer science;Graph convolutional networks;Computational modeling;Merging;Logic gates;User preference;Recommender systems;bidirectional graph;graph convolutional network;gate;sequential recommendation;social recommendation},
  doi={10.1109/ICSEC62781.2024.10770627},
  ISSN={2768-0592},
  month={Nov},}@INPROCEEDINGS{8870917,
  author={Cupec, Robert and Filko, Damir and Đurović, Petra},
  booktitle={2019 European Conference on Mobile Robots (ECMR)}, 
  title={Segmentation of Depth Images into Objects Based on Polyhedral Shape Class Model}, 
  year={2019},
  volume={},
  number={},
  pages={1-8},
  abstract={A novel approach for object detection in depth images based on a polyhedral shape class model is proposed. The proposed segmentation algorithm decides whether a subset of image points represents a physical object on the scene or not by comparing its 3D shape to several shape classes. The algorithm is designed for cluttered scenes with simple convex or hollow convex objects. The proposed algorithm is trained using a set of 3D models of objects belonging to several shape classes, which are expected to appear in the scene. The presented method is experimentally evaluated using a publicly available benchmark dataset and compared to three state-of-the art approaches.},
  keywords={Image segmentation;Shape;Three-dimensional displays;Merging;Computational modeling;Face;Cameras},
  doi={10.1109/ECMR.2019.8870917},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11117006,
  author={Yang, Weiwei and Zeng, Qianru and Lin, Zijing and Zhong, Xiaoting and Luo, Hanfang and Yuan, Junying and Zhang, Shihui and Zhang, Jianxin and Liu, Yizhi},
  booktitle={2024 5th International Conference on Big Data, Artificial Intelligence and Internet of Things Engineering (ICBAIE)}, 
  title={CRWMTR: Causal Reasoning and Weighting Mechanisms of Thought Reasoning in Large Language Models}, 
  year={2024},
  volume={},
  number={},
  pages={751-754},
  abstract={Large Language Models (LLMs) have profoundly improved the performance in natural language tasks and recently Chain of Thoughts (CoTs) combining Knowledge Graphs (KGs) has further improved reasoning. However, LLMs lack effective causality identification and weight adjustment mechanisms when dealing with complex problems, limiting the accuracy of multi-hop reasoning. To address the challenge, we propose the Causal Reasoning and Weighting Mechanisms of Thought Reasoning in Large Language Models (CRWMTR), which first brings the Key factor identification into complex multi-hop reasoning. For complex problem solving task, we recursively optimise the inference paths in the KGs by assigning weights $W$ and scores $S$ to the initial and candidate entities to guide the ‘merge’ and ‘delete’ operations. We propose a new self-correcting mechanism that can quantify and unify causal factors step by step during multi-hop reasoning, Experiments show CRWMTR outperform the state-of-the-art methods.},
  keywords={Accuracy;Limiting;Large language models;Natural languages;Cause effect analysis;Knowledge graphs;Big Data;Cognition;Problem-solving;Internet of Things;Large Language Models (LLMs);Causal Reasoning;Knowledge Graphs (KGs);Multi-hop Reasoning},
  doi={10.1109/ICBAIE63306.2024.11117006},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10307158,
  author={Gupta, Krati and Parmar, Mahesh},
  booktitle={2023 14th International Conference on Computing Communication and Networking Technologies (ICCCNT)}, 
  title={Comparative Analysis of Multi-Model and Uni-Model Approaches using Time Distributed Bidirectional LSTM for Multidata Sentiment Analysis}, 
  year={2023},
  volume={},
  number={},
  pages={1-7},
  abstract={The sentiment of the data contained in a text can be determined by analysis. This sentiment can be good, negative, or neutral. When carrying out this research, one may choose to employ either a uni-model or a multi-model technique. In the uni-model method, both the training and the analysis are performed using just a single model. The application of this strategy is uncomplicated and uncomplicated, but it might not be able to make sense of complicated or different facts, which would lead to wrong findings. Instead, the multi-model technique utilizes a number of different models, each of which is designed to examine a particular aspect of the data or a particular kind of attitude. This allows the multi-model strategy to produce more accurate results. The results of several different models might be combined in order to obtain a more in-depth understanding of feelings. This method is more accurate overall and captures more complex expressions of emotion, but it requires more time and money to train personnel and put into practice. The evaluation of metrics was carried out using Multimodal and mono Model with Time Distributed Bidirectional LSTM in this research. Both the loss and the accuracy. The Multi-Model achieves the highest accuracy of 99.71 percent for the train, while the validation accuracy achieves 99.32 percent, and the Multi-Model achieves the least loss of 0.010 percent.},
  keywords={Training;Measurement;Analytical models;Sentiment analysis;Computational modeling;Merging;Data models;Bidirectional LSTM;Uni-Model;Multi Model;Deep learning;Sentiment Analysis},
  doi={10.1109/ICCCNT56998.2023.10307158},
  ISSN={2473-7674},
  month={July},}@INPROCEEDINGS{10266504,
  author={Qu, Huiyan and Zhao, Wei},
  booktitle={2023 International Seminar on Computer Science and Engineering Technology (SCSET)}, 
  title={Image Segmentation Edge Detection Technology Based on Optimization Model}, 
  year={2023},
  volume={},
  number={},
  pages={131-134},
  abstract={To meet the requirement of realtime and correct edge detection in complicated image segmentation, a speedy edge detection technological know-how based totally on optimization mannequin was once proposed. The optimization mannequin of deep mastering is adopted, the image object is taken as the segmentation unit, the image is divided through pixel, and then the segmentation image is merged based totally on certain rules. A giant wide variety of spots or noise after image segmentation are reduced, and the variety of pixel factors in the incorrect division is reduced It shortens the detection time and improves the detection efficiency, and has sure benefits in contrast with the classical Log, Canny and Pal. King algorithms.},
  keywords={Seminars;Deep learning;Computer science;Image segmentation;Error analysis;Image edge detection;Computational modeling;Optimization model;Image segmentation;Edge detection;Image processing},
  doi={10.1109/SCSET58950.2023.00038},
  ISSN={},
  month={April},}@INPROCEEDINGS{10038266,
  author={Zahaf, Ahmed and Fellah, Aissa and Malki, Mimoun},
  booktitle={2022 First International Conference on Big Data, IoT, Web Intelligence and Applications (BIWA)}, 
  title={Premises of Conservativity Violations in Ontology Alignments}, 
  year={2022},
  volume={},
  number={},
  pages={37-41},
  abstract={we improve the quality of ontology alignments by detecting and repairing conservativity violations that arise from interactions of ontologies through alignments. An alignment of ontologies which only states equivalent relations between entities of ontologies is an ontological signature isomorphism if and only if it preserves the logical closures of ontologies. Otherwise, it violates the isomorphism constraint. In this paper, we show that isomorphism violations constitute the premises of violations. Hence, conservativity violations repair can be reduced to repairing isomorphism violations. Isomorphism violations have the advantage of being detectable by local reasoning over each ontology, which is particularly relevant since most approaches require reasoning over the merge of both ontologies, an operation with high computational cost. We compare the result of our approach and the result of the approaches applied on the reference alignments used in the conference organization track provided by the Ontology Alignment Evaluation Initiative (OAEI). The experimental results show that the number of violations detected by our method is strongly reduced which might heavily change the results of this track.},
  keywords={Organizations;Ontologies;Maintenance engineering;Big Data;Cognition;Computational efficiency;Ontology Alignment;Conservativity violations;Isomorphism violations;Alignment repair},
  doi={10.1109/BIWA57631.2022.10038266},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10426609,
  author={Shah, Pushti and Shah, Jainam and Patel, Bansari},
  booktitle={2023 Global Conference on Information Technologies and Communications (GCITC)}, 
  title={Exploring Recent Innovations in Text Summarization: Constructing a Sequence-to-Sequence Model for Enhanced Summarization}, 
  year={2023},
  volume={},
  number={},
  pages={1-8},
  abstract={The practice of condensing a larger text into a summarized version while keeping the major ideas and important details is known as text summarizing. Either a human being can accomplish this manually or computer algorithms can do it automatically. Text summary techniques have been developed by researchers since the 1950s. However, more recent summarizing initiatives also produced summaries from collections of publications. Most summarizing involves summaries of a single document. This paper assesses contemporary ways to summarize text in following categories: extractive, abstractive, and hybrid text summarizing. It also discusses specific strategies within each category. Furthermore, it discusses about implementation of text summarizer developed using sequence-to-sequence model and Long short-term memory (LSTM) model.},
  keywords={Surveys;Technological innovation;Merging;Data mining;Information technology;Robots;Long short term memory;extractive summarization;abstractive summarization;hybrid summarization},
  doi={10.1109/GCITC60406.2023.10426609},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10831172,
  author={He, Jiaxing and Li, Liang and Mao, Xingbin},
  booktitle={2024 IEEE International Conference on Systems, Man, and Cybernetics (SMC)}, 
  title={News Session Recommendation Based on Long and Short-Term User Interest Representation and Multi-View Learning}, 
  year={2024},
  volume={},
  number={},
  pages={4011-4016},
  abstract={In the current context of proliferation of news information, personalised news recommendation is important to help users quickly access content of interest. Existing approaches tend to ignore the diversity of users' reading behaviours and the variability of news topics within a session. They tend to assume that all the news read or clicked within a session are attributed to one main interest, while in reality, each news session may cover a variety of news with different interests corresponding to different topics. The paper introduces a news session recommendation approach that utilizes both long-and short-term representations of user interests, incorporating multi-view learning techniques, and the method treats the clicking behaviours of anonymous users as a session: initially, a multi-scale convolutional neural network is employed to capture the features of user-clicked news articles from mul-tiple viewpoints; Subsequently, a GRU multi-channel interest decoupler is crafted to identify potential interests within each clicked news item, enabling the modeling of diverse interests to capture the user's long-term preferences. Concurrently, recent user-clicked news items are considered as short-term interests. These long and short-term interests are then amalgamated to create the ultimate user interest representation; Finally, the user's preference value for the candidate news is calculated by click-summing and the final recommendation result is generated. By comparing with the benchmark method on the real data set, the findings demonstrate strong performance on objective evaluation metrics such as Area Under the ROC Curve (AUC) and Normalised Discounted Cumulative Gain (NDCG), affirming the efficacy of the proposed method for news recommendation.},
  keywords={Measurement;Accuracy;Fuses;Merging;Benchmark testing;Data models;User preference;Convolutional neural networks;Cybernetics;Context modeling},
  doi={10.1109/SMC54092.2024.10831172},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9776664,
  author={Prasad, K. Mohana and Pravin, A. and Jacob, T. Prem and Rajakumar, R.},
  booktitle={2022 Second International Conference on Power, Control and Computing Technologies (ICPC2T)}, 
  title={Semantics Accommodated K-Anonymization (SAKA) Technique for Assorted Data}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={Techniques approaching k-anonymity for shielding the mini data privacy over data mining. Mini gatherings and abstraction are two conventional techniques for deploying the k-anonymity method. However, the above two methodologies lead to major errors over the anonymity of combined small data gathering. To approach this problem, we propose an efficient and new anonymity method SAKA that accommodates extra semantics than abstraction and mini data gatherings that can handle combined small data combinations. SAKA is the abbreviation for Semantics Accommodated K-Anonymity technique implied for anonymization of assorted data. The concept of SAKA is to merge the mean assorted vector of arithmetic data with abstraction values of classified data as a grouping centroid. It uses its epitome of tuples along with its equivalent clusters. Here we propose efficient algorithms to anonymize assorted data. An empirical result proves that SAKA can anonymize the assorted mini data persuasively and the algorithm implemented will provide good rapport between the quality of data and effectiveness of the algorithm thus it correlates anonymization algorithms with anonymous data.},
  keywords={Computers;Data privacy;Heuristic algorithms;Semantics;Power control;Clustering algorithms;Process control;k-anonymity;mini data gathering;abstraction;SAKA;grouping centroid;anonymization algorithm},
  doi={10.1109/ICPC2T53885.2022.9776664},
  ISSN={},
  month={March},}@INPROCEEDINGS{11352665,
  author={Chen, Li},
  booktitle={2025 22nd International Computer Conference on Wavelet Active Media Technology and Information Processing (ICCWAMTIP)}, 
  title={A Decoupled Fine-Tuning Approach for Integrating Medical Expertise and Affective Competence in Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Large Language Models in medical applications often exhibit “technical rationality”, excelling in expert knowledge but lacking affective competence., while conventional multi-task fine-tuning can lead to skill interference. To address this., this paper proposes a Component-Decoupled Orthogonal LoRA approach., grounded in the hypothesis of functional specialization where Feed-Forward Networks store factual knowledge and Multi-Head Attention (MHA) captures stylistic patterns. This method applies two distinct LoRA modules: a medical adapter targeting only FFNs for expertise., and a psychological adapter targeting only MHAs for empathy. These adapters are trained concurrently with an orthogonal update rule., where gradients are selectively applied based on the data source of each batch to prevent interference. Experiments on the Qwen3-1.7B model demonstrate that this method outperforms the base model and standard naive merging., and successfully achieves a balanced performance that approaches the efficacy of models fine-tuned exclusively on either single domain., effectively integrating medical expertise with affective competence.},
  keywords={Adaptation models;Wavelet domain;Navigation;Large language models;Soft sensors;Psychology;Interference;Multitasking;Transformers;Standards;Large language models;Low-Rank adaptation;Parameter-Efficient Fine-Tuning},
  doi={10.1109/ICCWAMTIP68645.2025.11352665},
  ISSN={2576-8964},
  month={Dec},}@INPROCEEDINGS{10805178,
  author={Eddahab-Burke, Fatima-Zahra Abou},
  booktitle={2024 SICE Festival with Annual Conference (SICE FES)}, 
  title={Towards Building a Next-Generation Data Analytics Toolbox: Application of the Axiomatic Theories Fusion Methodology}, 
  year={2024},
  volume={},
  number={},
  pages={432-437},
  abstract={Reliable development of next-generation data analytics toolboxes (N-GDATs) requires robust underpinning theories, which cannot necessarily be inductively generated. Based on the axiomatic theories fusion (ATF) methodology we deductively developed a comprehensive theory supporting the development of a N-GDAT for white goods design based on middle-of-life data. Accordingly, theories about designer's needs, advanced technologies, data analytics, creative problem-solving, decision-making, and interoperability were fused following the ATF steps: (i) selection of component theories, (ii) axiomatic discretization of foundational theories, (iii) establishing relationships among axioms and postulates, (iv) transcription of system of axiomatic propositions into a textual format, and (v) validation of explanatory theory. The obtained new theory provides a robust basis for the targeted knowledge platform. It provides (i) decision-making, (ii) algorithmic concepts, (iii) learning, (iv) data management, (v) interfacing, (vi) reasoning, (vii) data types and characteristics, (viii) design issues, (ix) analytics techniques and methods, and (x) outputs requirements to develop N-GDATs.},
  keywords={Data analysis;Buildings;Decision making;Merging;Manuals;Reliability theory;Skeleton;Iron;Problem-solving;Next generation networking;Data analytics tools;axiomatizations;theories fusion;middle-of-life data},
  doi={},
  ISSN={},
  month={Aug},}@ARTICLE{10113883,
  author={Zhou, Heng and Tian, Chunna and Zhang, Zhenxi and Li, Chengyang and Ding, Yuxuan and Xie, Yongqiang and Li, Zhongbo},
  journal={IEEE Transactions on Image Processing}, 
  title={Position-Aware Relation Learning for RGB-Thermal Salient Object Detection}, 
  year={2023},
  volume={32},
  number={},
  pages={2593-2607},
  abstract={Salient object detection (SOD) is an important task in computer vision that aims to identify visually conspicuous regions in images. RGB-Thermal SOD combines two spectra to achieve better segmentation results. However, most existing methods for RGB-T SOD use boundary maps to learn sharp boundaries, which lead to sub-optimal performance as they ignore the interactions between isolated boundary pixels and other confident pixels. To address this issue, we propose a novel position-aware relation learning network (PRLNet) for RGB-T SOD. PRLNet explores the distance and direction relationships between pixels by designing an auxiliary task and optimizing the feature structure to strengthen intra-class compactness and inter-class separation. Our method consists of two main components: A signed distance map auxiliary module (SDMAM), and a feature refinement approach with direction field (FRDF). SDMAM improves the encoder feature representation by considering the distance relationship between foreground-background pixels and boundaries, which increases the inter-class separation between foreground and background features. FRDF rectifies the features of boundary neighborhoods by exploiting the features inside salient objects. It utilizes the direction relationship of object pixels to enhance the intra-class compactness of salient features. In addition, we constitute a transformer-based decoder to decode multispectral feature representation. Experimental results on three public RGB-T SOD datasets demonstrate that our proposed method not only outperforms the state-of-the-art methods, but also can be integrated with different backbone networks in a plug-and-play manner. Ablation study and visualizations further prove the validity and interpretability of our method.},
  keywords={Transformers;Feature extraction;Decoding;Object detection;Merging;Task analysis;Level set;Salient object detection;RGB-thermal images;swin transformer;position-aware relation learning},
  doi={10.1109/TIP.2023.3270801},
  ISSN={1941-0042},
  month={},}@INPROCEEDINGS{9156909,
  author={Xu, Zhenyu and Liu, Yiguang and Shi, Xuelei and Wang, Ying and Zheng, Yunan},
  booktitle={2020 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)}, 
  title={MARMVS: Matching Ambiguity Reduced Multiple View Stereo for Efficient Large Scale Scene Reconstruction}, 
  year={2020},
  volume={},
  number={},
  pages={5980-5989},
  abstract={The ambiguity in image matching is one of main factors decreasing the quality of the 3D model reconstructed by PatchMatch based multiple view stereo. In this paper, we present a novel method, matching ambiguity reduced multiple view stereo (MARMVS) to address this issue. The MARMVS handles the ambiguity in image matching process with three newly proposed strategies: 1) The matching ambiguity is measured by the differential geometry property of image surface with epipolar constraint, which is used as a critical criterion for optimal scale selection of every single pixel with corresponding neighbouring images. 2) The depth of every pixel is initialized to be more close to the true depth by utilizing the depths of its surrounding sparse feature points, which yields faster convergency speed in the following PatchMatch stereo and alleviates the ambiguity introduced by self similar structures of the image. 3) In the last propagation of the PatchMatch stereo, higher priorities are given to those planes with the related 2D image patch possesses less ambiguity, this strategy further propagates a correctly reconstructed surface to raw texture regions. In addition, the proposed method is very efficient even running on consumer grade CPUs, due to proper parameterization and discretization in the depth map computation step. The MARMVS is validated on public benchmarks, and experimental results demonstrate competing performance against the state of the art.},
  keywords={Three-dimensional displays;Geometry;Image reconstruction;Merging;Benchmark testing;Image matching;Surface texture},
  doi={10.1109/CVPR42600.2020.00602},
  ISSN={2575-7075},
  month={June},}@ARTICLE{10313955,
  author={Zürn, Jannik and Posner, Ingmar and Burgard, Wolfram},
  journal={IEEE Robotics and Automation Letters}, 
  title={AutoGraph: Predicting Lane Graphs From Traffic Observations}, 
  year={2024},
  volume={9},
  number={1},
  pages={73-80},
  abstract={Lane graph estimation is a long-standing problem in the context of autonomous driving. Previous works aimed at solving this problem by relying on large-scale, hand-annotated lane graphs, introducing a data bottleneck for training models to solve this task. To overcome this limitation, we propose to use the motion patterns of traffic participants as lane graph annotations. In our AutoGraph approach, we employ a pre-trained object tracker to collect the tracklets of traffic participants such as vehicles and trucks. Based on the location of these tracklets, we predict the successor lane graph from an initial position using overhead RGB images only, not requiring any human supervision. In a subsequent stage, we show how the individual successor predictions can be aggregated into a consistent lane graph. We demonstrate the efficacy of our approach on the UrbanLaneGraph dataset and perform extensive quantitative and qualitative evaluations, indicating that AutoGraph is on par with models trained on hand-annotated graph data.},
  keywords={Annotations;Task analysis;Estimation;Data models;Merging;Trajectory;Autonomous vehicles;Computer vision for transportation;deep learning for visual perception;semantic scene understanding},
  doi={10.1109/LRA.2023.3331653},
  ISSN={2377-3766},
  month={Jan},}@INPROCEEDINGS{10208472,
  author={Lafenetre, Jamy and Nguyen, Ngoc Long and Facciolo, Gabriele and Eboli, Thomas},
  booktitle={2023 IEEE/CVF Conference on Computer Vision and Pattern Recognition Workshops (CVPRW)}, 
  title={Handheld Burst Super-Resolution Meets Multi-Exposure Satellite Imagery}, 
  year={2023},
  volume={},
  number={},
  pages={2056-2064},
  abstract={Image resolution is an important criterion for many applications based on satellite imagery. In this work, we adapt a state-of-the-art kernel regression technique for smartphone camera burst super-resolution to satellites. This technique leverages the local structure of the image to optimally steer the fusion kernels, limiting blur in the final high-resolution prediction, denoising the image, and recovering details up to a zoom factor of 2. We extend this approach to the multi-exposure case to predict from a sequence of multi-exposure low-resolution frames a high-resolution and noise-free one. Experiments on both single and multi-exposure scenarios show the merits of the approach. Since the fusion is learning-free, the proposed method is ensured to not hallucinate details, which is crucial for many remote sensing applications.},
  keywords={Satellites;Superresolution;Noise reduction;Neural networks;Merging;Satellite images;Pattern recognition},
  doi={10.1109/CVPRW59228.2023.00199},
  ISSN={2160-7516},
  month={June},}@INPROCEEDINGS{9838237,
  author={Leu, Jessica and Wang, Michael and Tomizuka, Masayoshi},
  booktitle={2022 European Control Conference (ECC)}, 
  title={Long-Horizon Motion Planning via Sampling and Segmented Trajectory Optimization}, 
  year={2022},
  volume={},
  number={},
  pages={538-545},
  abstract={This paper presents a hybrid robot motion planner that generates long-horizon motion plans for robot navigation in environments with obstacles. We propose a hybrid planner, RRT* with segmented trajectory optimization (RRT*-sOpt), which combines the merits of sampling-based planning, optimization-based planning, and trajectory splitting to quickly plan for a collision-free and dynamically-feasible motion plan. When generating a plan, the RRT* layer quickly samples a semi-optimal path and sets it as an initial reference path. Then, the sOpt layer splits the reference path and performs optimization on each segment. It then splits the new trajectory again and repeats the process until the whole trajectory converges. We also propose to reduce the number of segments before convergence with the aim of further reducing computation time. Simulation results show that RRT*-sOpt benefits from the hybrid structure with trajectory splitting and performs robustly in various robot platforms and scenarios.},
  keywords={Robot motion;Navigation;Motion segmentation;Simulation;Merging;Europe;Hybrid power systems},
  doi={10.23919/ECC55457.2022.9838237},
  ISSN={},
  month={July},}@ARTICLE{11194135,
  author={Yang, Bing and Yu, Wenke and Guo, Ziyang and Sun, Weiwei and Peng, Jiangtao},
  journal={IEEE Transactions on Geoscience and Remote Sensing}, 
  title={Progressive Hybrid-Order Hypergraph Framework for Hyperspectral Image Classification}, 
  year={2025},
  volume={63},
  number={},
  pages={1-13},
  abstract={Hypergraph neural networks (HGNNs) have garnered considerable attention in hyperspectral image (HSI) classification for their ability to model higher order nonlinear relationships. However, most existing HGNN-based HSI classification methods adopt simple hypergraph structures, which fail to fully leverage low-order and high-order information within HSIs. Moreover, these methods are constrained by rigid single-scale superpixel segmentations, which fail to fully capture rich spectral–spatial features of HSIs. To overcome these limitations, this article proposes a progressive hybrid-order hypergraph framework (PHHF) that establishes a graph-hypergraph collaborative learning paradigm to learn multiscale hybrid-order features across hierarchical graphs. Specifically, by synergistically modeling multiple structural information, we develop a progressive HGNN framework to enhance the extraction of hierarchical representations of HSIs. Second, at each level, a novel hybrid-order hyperedge generation strategy is designed to enhance spectral–spatial consistency across scales and overcome the limitations of existing hypergraph methods. Finally, a novel heterogeneous kernel-based convolution (HetConv) is introduced to enhance pixel-level feature extraction for the PHHF. Compared with conventional convolution, HetConv offers richer spatial–spectral details with lower computational cost. Extensive experiments on widely used HSI datasets demonstrate that our proposed method achieves state-of-the-art HSI classification performance.},
  keywords={Feature extraction;Hyperspectral imaging;Convolution;Neural networks;Kernel;Data mining;Merging;Land surface;Topology;Spread spectrum communication;Hybrid-order hypergraph;hypergraph neural network (HGNN);hyperspectral image (HSI) classification},
  doi={10.1109/TGRS.2025.3618456},
  ISSN={1558-0644},
  month={},}@INPROCEEDINGS{10825947,
  author={Guo, Peilin and Tang, Qian and Guo, Jiaqi},
  booktitle={2024 IEEE International Conference on Big Data (BigData)}, 
  title={Community Detection Using An Improved Label Propagation Algorithm}, 
  year={2024},
  volume={},
  number={},
  pages={7031-7040},
  abstract={Label propagation is a promising engine for community detection, widely utilized in anomaly analysis and recommendation systems. However, traditional label propagation algorithms struggle with large-scale networks due to poor stability, slow convergence, and low accuracy. Despite its advancements, the state-of-the-art variant LBLD (Local Balanced Label Diffusion) also faces challenges, such as limited utilization of similarity and a rudimentary approach to constructing the initial community framework, which diminishes the quality of the final results.To address these limitations, we introduce PNLP, a novel similarity-based label propagation algorithm. The key innovations of PNLP include: (i) Integrating similarity throughout the entire process of label propagation, enhancing the robustness and accuracy of community detection. (ii) Defining a Node Importance metric (NI) to provide a more comprehensive assessment of node influence. (iii) Introducing a novel method for identifying rough seed nodes and constructing a tighter initial framework for communities using conductance.Furthermore, PNLP employs a similarity-based influence metric to guide the label updating process, ensuring a more refined and accurate detection of community structures. Extensive experiments conducted on both real-world and synthetic networks demonstrate the superior performance of PNLP, which significantly outperforms established methods such as Infomap, Louvain, Leiden, LPA, and LBLD in terms of accuracy by factors of up to 1.39 times, 1.48 times, 1.44 times, 2.05 times and 1.25 times, respectively.},
  keywords={Measurement;Technological innovation;Accuracy;Merging;Network analyzers;Robustness;Stability analysis;Recommender systems;Faces;Engines;Community detection;Label propagation;Conductance},
  doi={10.1109/BigData62323.2024.10825947},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{10022285,
  author={Qu, Jia and Miwa, Shotaro and Domae, Yukiyasu},
  booktitle={2022 IEEE Symposium Series on Computational Intelligence (SSCI)}, 
  title={Learning Landmark-Oriented Subgoals for Visual Navigation Using Trajectory Memory}, 
  year={2022},
  volume={},
  number={},
  pages={708-714},
  abstract={In many deep reinforcement learning (DRL) applications, agents must perform complex and long-horizon tasks that are still challenging in DRL because of temporally ex-tended tasks with sparse rewards. Goal-conditioned hierarchical reinforcement learning (HRL) is a promising approach for control at multiple time scales via a hierarchical structure with subgoals. One of the key issues of goal-conditioned HRL is the definition of subgoals. In this study, we propose a DRL model for learning landmark-oriented subgoals using attention-augmented trajectory memory. In our approach the agent is trained to make decisions based on both 1) current perception, which is a short-term temporal history derived from vanilla long short-term memory (LSTM) and 2) trajectory memory, which represents a contextual summary of long-term historical LSTM states augmented by attention. The experiment on a visual navigation task shows that the short-term LSTM state of the current perception module extracts landmark subgoals as clusters that correspond to lower-level policies, and the long-term context states of trajectory memory extract subgoal transitions that correspond to higher-level policies. Furthermore, the proposed method demonstrated superior adaptability to environmental changes,},
  keywords={Visualization;Adaptation models;Navigation;Memory management;Merging;Reinforcement learning;Trajectory;hierarchical reinforcement learning;subgoals;attention;trajectory memory},
  doi={10.1109/SSCI51031.2022.10022285},
  ISSN={},
  month={Dec},}@ARTICLE{9438617,
  author={Chen, Lei and Sun, Li},
  journal={IEEE Communications Letters}, 
  title={Self-Attention-Based Real-Time Signal Detector for Communication Systems With Unknown Channel Models}, 
  year={2021},
  volume={25},
  number={8},
  pages={2639-2643},
  abstract={In this letter, a deep-learning-assisted signal detector is developed for communication systems with unknown channel models. By embedding domain knowledge into a self-attention model, a novel detection unit is devised that enables both reliable estimation and fast training. Furthermore, a sliding-window structure is in combined use with the detection unit to realize real-time signal recovery. We evaluate the performance of the proposed detector using a chemical communication experimental platform, and show the superiority of our design in terms of detection accuracy as well as implementation complexity.},
  keywords={Detectors;Real-time systems;Training;Receivers;Signal detection;Merging;Computer architecture;Signal detection;deep learning;self-attention;real-time detector},
  doi={10.1109/LCOMM.2021.3082708},
  ISSN={1558-2558},
  month={Aug},}@INPROCEEDINGS{10580861,
  author={Chen, Zixuan and Zhao, Shengjie and Zeng, Jin and Dong, Shilong and Zu, Geyunqian},
  booktitle={2024 27th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={CASTNet: Convolution Augmented Graph Sampling Transformer Network for Traffic Flow Forecasting}, 
  year={2024},
  volume={},
  number={},
  pages={1292-1297},
  abstract={Accurate and efficient traffic flow forecasting plays an essential role in urban management which is conductive to traffic safety and travel experience. Despite the tremendous progress of attention-based traffic flow forecasting methods, complicated spatial and temporal correlations of traffic data pose difficulty for the network in simultaneously capturing the long-range contexts and the local feature details, leading to limited performance. To this end, we propose Convolution Augmented Graph Sampling Transformer Network (CASTNet) for accurate traffic flow prediction. Specifically, we design a hybrid graph transformer module to utilize the graph convolutions to perceive local structural details, which are incorporated into the transformer to augment the attention computation for more accurate global dependency modeling. Moreover, we develop a sampling-based attention layer based on the approximated sampling strategy to further optimize the graph structure, which is implemented with linear complexity. Finally, the spatial features from the graph transformer module are fused with the temporal features from the sample convolution and interaction network. Experimental results on three real-world traffic flow datasets demonstrate the superiority of the proposed CASTNet over existing schemes.},
  keywords={Accuracy;Convolution;Computational modeling;Merging;Predictive models;Transformers;Complexity theory;Traffic prediction;graph convolution network;graph transformer;spatio-temporal networks},
  doi={10.1109/CSCWD61410.2024.10580861},
  ISSN={2768-1904},
  month={May},}@INPROCEEDINGS{10763215,
  author={Akhyar, Amany and Khodra, Masayu Leylia},
  booktitle={2024 11th International Conference on Advanced Informatics: Concept, Theory and Application (ICAICTA)}, 
  title={Automatic Single Document Summarization For Indonesian News Article Using Abstract Meaning Representation}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={With the increasing number of online news sources, effective summarization becomes essential to provide readers with concise and informative content. This study focuses on developing an automatic summarization system for single Indonesian news articles using Abstract Meaning Representation (AMR). Leveraging a machine learning-based AMR parser, the system constructs sentence representations, selects subgraphs to build summary graphs, and generates summary texts. The baseline uses retrained Word2Vec and selects the top three most similar sentences via cosine similarity for ROUGE evaluation against IndoSum's abstractive summary. Despite not surpassing baseline performance, the proposed system achieves an average ROUGE-l of 0.62833, ROUGE-2 of 0.54449, and ROUGE-L of 0.58889. The findings indicate that while the proposed system effectively summarizes, it tends to prioritize initial sentences during subgraph selection, which is crucial for constructing accurate summary graphs. This tendency highlights areas for further improvement. Future research can build upon these findings by employing advanced graph construction algorithms for summary graphs and alternative text generation techniques. This study contributes to ongoing efforts to enhance text summarization systems and provides valuable lessons for future research in this field.},
  keywords={Accuracy;Large language models;Merging;Text summarization;Data models;Generators;Labeling;Informatics;Abstract Meaning Representation (AMR);Extractive Summarization;Semantic Graphs;Sentence Scoring;IndoSum},
  doi={10.1109/ICAICTA63815.2024.10763215},
  ISSN={2996-2552},
  month={Sep.},}@ARTICLE{11408779,
  author={Zhao, Jie and Cheong, Kang Hao},
  journal={IEEE Transactions on Systems, Man, and Cybernetics: Systems}, 
  title={Multidomain Evolutionary Optimization on Adversarial Link Perturbation in Imbalanced-Size Complex Systems}, 
  year={2026},
  volume={56},
  number={4},
  pages={2708-2719},
  abstract={Real-world complex systems usually share structural characteristics such as the small-world property, power-law distributions, and community structure. Multidomain evolutionary optimization (MDEO) leverages these commonalities to search for optimal solutions in multiple domains simultaneously. However, it still faces challenges in achieving effective cooperation when the networks involved are of highly imbalanced sizes. To address this issue, we propose the harmonized MDEO (HMDEO), in which two graph coarsening strategies are developed to jointly coarsen the large network to a fine level, acting as the bridge between the large network and the small network for knowledge exchange. Following that, we propose a bidirectional optimization framework incorporating two cases: large-to-small and small-to-large, allowing solutions optimized in one domain to be seamlessly transferred to another domain of varied scales. To enhance applicability, we also tailor the measurement of network similarity and the network alignment strategy targeted to imbalanced-size scenarios. The effectiveness of HMDEO is demonstrated through experiments on several pairs of networks of differing scales, where HMDEO outperforms other optimization approaches in addressing adversarial edge perturbation against community detection in complex systems.},
  keywords={Optimization;Complex systems;Knowledge transfer;Silicon;Perturbation methods;Merging;Resilience;Knowledge engineering;Complex networks;Bridges;Combinatorial optimization;complex network;knowledge transfer;multidomain evolutionary optimization (MDEO)},
  doi={10.1109/TSMC.2026.3652853},
  ISSN={2168-2232},
  month={April},}@ARTICLE{9399270,
  author={Liu, Peng and Jiang, Wen and Hu, Wei and Sun, Shang-Yi and Gong, Shu-Xi},
  journal={IEEE Transactions on Antennas and Propagation}, 
  title={Wideband Multimode Filtering Circular Patch Antenna}, 
  year={2021},
  volume={69},
  number={11},
  pages={7249-7259},
  abstract={A wideband circular patch antenna (CPA) is proposed and fabricated in this article. Based on the cavity mode theory of circular patch, four resonant modes of quasi-TM01, quasi-TM02, quasi-TM03, and quasi-TM04 are merged together to obtain a wide passband through cutting slots and adding short pins on the driven patch. In order to generate low stopband radiation nulls, two circles of defected ground structures (DGSs) are designed. Meanwhile, a stacked patch is added above the driven patch to obtain an upper edge radiation null. The experimental results achieve the 10 dB impedance bandwidth of 30.3% from 5.3 to 7.19 GHz with an overall size of  $1.84\,\,\lambda _{0} \times 1.84\lambda _{0} \times 0.05 \lambda _{0}$  ( $\lambda _{0}$  is the free space wavelength at 6 GHz). Without any extra filtering circuit, the proposed antenna obtains the sharp band edge with a stopband suppression level of 15.7 dB. The out-of-roundness of the radiation pattern in the H-plane is less than 2.7 dB in passband. With good performance in wideband, omnidirectivity, low profile, and high stopband suppression, the proposed antenna has great application prospects in the high-integration microwave systems of large unmanned aerial vehicles.},
  keywords={Antennas;Filtering;Broadband antennas;Slot antennas;Wideband;Unmanned aerial vehicles;Resonant frequency;Cavity mode theory;circular patch antenna (CPA);defected ground structure (DGS);filtering antenna;low profile;multiresonant modes;wideband},
  doi={10.1109/TAP.2021.3070717},
  ISSN={1558-2221},
  month={Nov},}@INPROCEEDINGS{8792908,
  author={D’Emilia, Giulio and Gaspari, Antonella and Natale, Emanuela},
  booktitle={2019 II Workshop on Metrology for Industry 4.0 and IoT (MetroInd4.0&IoT)}, 
  title={Integration of model and sensor data for smart condition monitoring in mechatronic devices}, 
  year={2019},
  volume={},
  number={},
  pages={365-370},
  abstract={In this paper the use of features is described in order to individuate the best set-up conditions of a mechatronic system. In particular, features are obtained from data of quantities measured in different positions of the kinematic linkage, the operation of the system is based on. A kinematic and dynamic model of the device is realized and used in order to obtain the features of interest also in positions different from the ones the measurements are carried out throughout the kinematic link. This procedure allows us to merge information from both internal and external sensors, in order to identify the best features for identification of working conditions, taking into account their resolution, selectivity, easiness of calculation, and data processing time and load. The most efficacious features are identified with reference to the time and frequency domain and the most suitable position and quantity the information is originated from. This methodology step is also a preliminary action toward the use of neural networks for smart identification of specific statuses of interest of a mechatronic system, during both the set-up phase and the functioning of the system for its condition monitoring.},
  keywords={Data models;Current measurement;Mechatronics;Kinematics;Position measurement;Data processing;Robot sensing systems;condition monitoring;features;dynamic model;sensors;data processing;electrical and mechanical quantities;accuracy},
  doi={10.1109/METROI4.2019.8792908},
  ISSN={},
  month={June},}@INPROCEEDINGS{10441950,
  author={Bhattacharya, Shreyasi and Raman, Ramakrishnan},
  booktitle={2023 3rd International Conference on Smart Generation Computing, Communication and Networking (SMART GENCON)}, 
  title={Speed Violation Detection and Enforcement with CNN and IoT Integration}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={Worldwide traffic accidents and deaths are largely attributable to drivers going too fast for conditions. This research introduces a unique method for detecting and enforcing speeding violations using Convolutional Neural Networks (CNNs) and the Internet of Things (IoT). The system employs deep learning and collects data in real-time from IoT devices. In this case, it describes developing a CNN–based method for analyzing traffic camera footage in real-time. The CNN model reliably detects moving objects and estimates their velocity. Accurate vehicle tracking is achieved by integrating data from IoT sensors, such as global positioning and vehicle identification systems. Cloud computing allows for the transfer and processing of data in near real-time. It shows that this combined method may successfully identify speeding violations. The IoT data verified the results, indicating that the CNN model had an accuracy of over 90% in speed estimation, which allowed for automated enforcement measures. Enforcement response times can also be drastically reduced by including real-time monitoring and alerting. The system provides a viable approach for speed violation identification and enforcement by merging CNN image processing with IoT data, leading to safer road environments and fewer accidents. It predicts this technique will significantly improve road safety on a global scale, which will, in turn, revolutionize traffic management.},
  keywords={Law enforcement;Image processing;Real-time systems;Road safety;Internet of Things;Convolutional neural networks;Accidents;Speed Violation;Real-time Monitoring;Automated Enforcement;Road Safety;Speed Estimation},
  doi={10.1109/SMARTGENCON60755.2023.10441950},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10107040,
  author={Wu, Yueyang and Liu, Long and Deng, Lianwen and Qiu, Lei-Lei},
  booktitle={2022 IEEE MTT-S International Microwave Workshop Series on Advanced Materials and Processes for RF and THz Applications (IMWS-AMP)}, 
  title={Electromagnetically Manipulated Dual-band Metasurface Based on Loaded Multimode Resonant Structure}, 
  year={2022},
  volume={},
  number={},
  pages={1-3},
  abstract={The electromagnetically manipulated dual-band metasurface based on the loaded multimode resonant structure is proposed in this paper. Through stub- and slot-loading techniques, patch resonator can obtain additional resonant modes for multimode characteristics, which are suitable for the construction of dual-band metasurface. A variety of multimode metasurfaces based on cross-stub-loaded-patch resonator and cross-slot-loaded-patch resonator are simulated and analyzed. Combined with the surface current distributions at the resonant frequency, the generation principle of the multi-mode characteristic is revealed. The independent resonant modes can be merged to form dual-wideband with proper tuning of the resonator parameters. Finally, the method has been well validated by two sets of experimental results.},
  keywords={Radio frequency;Design methodology;Conferences;Dual band;Resonant frequency;Metasurfaces;Microwave theory and techniques;Dual-band;metasurface;multimode;slot-loaded;stub-loaded},
  doi={10.1109/IMWS-AMP54652.2022.10107040},
  ISSN={2694-2992},
  month={Nov},}@INPROCEEDINGS{10618214,
  author={Kang, Yilin and Feng, Naixing and Zhang, Yuxian and Feng, Xiaoli and Wang, Huan and Fan, Jiuyang and Yang, Lixia and Huang, Zhixiang},
  booktitle={2024 Photonics & Electromagnetics Research Symposium (PIERS)}, 
  title={Analysis of Transmission Coefficients in Multilayer Media Structures Using Scale Compressed Finite-Difference Time-Domain Method}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Depending on conventional finite-difference time-domain (FDTD) method, we develop a scale-compressed technique to implement the rapid calculation for capturing the reflection coefficients and transmission coefficients through multilayered structure under the plane wave. Based on the Maxwell’s curl equations and the corresponding constitutive relationship between the field flux (D, B) and field intensity (E, H), curl operator can be assembled as a transition matrix for different modes when using the transverse wave vectors. After the preliminary analysis, we incorporate and merge the incident field into the curl matrix to derive electric field and magnetic field updating equations with only one upward space variable through grid matching. The required field quantities for updating electromagnetic fields through multilayered media can be clearly demonstrated by combining those fields’ components in these algorithmic equations using matrix representation. Our proposed algorithm achieves one-dimensional (1-D) compression to solve higher-dimensional problems while determining reflection and transmission coefficients under the various transverse wave vectors. With comparison from commercial software COMSOL, we can validate its accuracy and feasibility. As a results, for the complex cases, the proposed algorithm holds more potential applications in exploring multi-layered models under the condition of preset conditions.},
  keywords={Accuracy;Software algorithms;Mathematical models;Vectors;Software;Reflection;Reflection coefficient},
  doi={10.1109/PIERS62282.2024.10618214},
  ISSN={2831-5804},
  month={April},}@INPROCEEDINGS{10936201,
  author={Wang, Dong and Huang, Fuquan and Gong, Juqiang and Li, Yang and Xu, Boyang and Sun, Jiandong and Shi, Zhengxiang and Hong, Canmei},
  booktitle={4th Energy Conversion and Economics Annual Forum (ECE Forum 2024)}, 
  title={Research on power distribution network state estimation algorithm based on deep integration of LSTM and extended Kalman filter}, 
  year={2025},
  volume={2024},
  number={},
  pages={980-985},
  abstract={In the context of managing and operating distribution networks, state estimation serves as a vital tool for gaining comprehensive insights into the state of network and constructing real-time digital twins. The precision of this estimation directly influences the optimization of grid scheduling and the formulation of control decisions. However, the measurement data used in state estimation often encounters quality challenges, undermining the accuracy and reliability of conventional methods. Addressing this, the paper introduces an advanced algorithm that merges Long Short-Term Memory (LSTM) networks with the Extended Kalman Filter (EKF). By employing LSTM, the model extracts temporal and network-dependent features from measurement data, thereby compensating for data quality deficiencies and robust model. Meanwhile, the EKF effectively tackles the nonlinear attributes of the distribution network, minimizing the detrimental effects of noise and system disruptions. Through validation using the IEEE 33-bus system, the LSTM-EKF algorithm has shown remarkable improvements in accuracy and robustness. This research not only presents a potent algorithmic framework to address data quality concerns in state estimation but also supports the digital grid in accurately capturing and reflecting the real-time state of the physical network.},
  keywords={},
  doi={10.1049/icp.2025.0659},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10809044,
  author={Yu, Jun and Zhang, Yuan},
  booktitle={2024 7th International Conference on Information Communication and Signal Processing (ICICSP)}, 
  title={Autonomous Ground Vehicle Navigation with GNSS/5G Integration}, 
  year={2024},
  volume={},
  number={},
  pages={248-252},
  abstract={In this paper, we introduce a novel integrated navigation system that merges the capabilities of the global navigation satellite systems (GNSS) and fifth-generation (5G) wireless technology to deliver precise location-based services. Our approach entails the development of an integrated navigation framework adept at addressing nonlinear implicit constraints and multipath environments, resulting in a highly resilient and accurate navigation solution. The framework concurrently assesses the vehicle's position, velocity, and acceleration states, alongside determining the disparity between the dynamic stochastic clock error states (bias and drift) of the vehicle-mounted receiver and the generation Node B (gNB) clock. Within this framework, we propose a practical adaptive iterative extend Kalman filter (AIEKF) method that efficiently manages nonlinear implicit constraints and multipath propagation within a 5G environment. Simulation outcomes demonstrate the superiority of our AIEKF method over the traditional IEKF method, particularly in handling 5G multipath scenarios. Our results underscore that the proposed GNSS/5G method markedly enhances navigation accuracy in both urban junctions and highway scenarios, showcasing a 61.71% and 47.51% reduction in RMSE, respectively, compared to the 5G-only navigation solution.},
  keywords={Wireless communication;Global navigation satellite system;Accuracy;5G mobile communication;Signal processing algorithms;Switches;Kalman filters;Iterative methods;Vehicle dynamics;Clocks;GNSS/SG;autonomous ground vehicle;non-linear constraints;adaptive iterative extend Kalman filter;multipath},
  doi={10.1109/ICICSP62589.2024.10809044},
  ISSN={2770-792X},
  month={Sep.},}@INPROCEEDINGS{10949455,
  author={Shukla, Supriya H.},
  booktitle={8th IET Smart Cities Symposium (SCS 2024)}, 
  title={Integration of renewable energy in smart cities}, 
  year={2024},
  volume={2024},
  number={},
  pages={361-365},
  abstract={All smart cities need to integrate renewable energies if they want to grow steadily without any problems in the future. This study looks at the difficulties, plans, and tools that are used when these sources are merged into the smart city system. Through evaluating different research and advances in technology, the article shows us how smart cities could use RE effectively to achieve their sustainability objectives. Greater stress has been laid on smart grid, electricity storage facilities, and sophisticated stuff like IoT, blockchain, or AI for successful renewables connection in terms of efficiency and reliability.},
  keywords={},
  doi={10.1049/icp.2025.0939},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11074620,
  author={Bera, Saikat and Shrivastava, Ruchi},
  booktitle={Parul University International Conference on Engineering and Technology 2025 (PiCET 2025)}, 
  title={Exploring the synergy of digital twins: integration of AI, AR, VR, and BIM}, 
  year={2025},
  volume={2025},
  number={},
  pages={976-982},
  abstract={In today’s world with rapid transition, the construction industry especially in infrastructure management has undergone a major digital transformation.where One of the most groundbreaking developments is the use of digital twins’ technology: virtual models that merge technologies such as artificial intelligence (AI), augmented reality (AR), virtual reality (VR), and building information modelling (BIM). these tools provide innovative ways to boost sustainability, streamline operations, and support better decision-making in civil engineering projects. The research paper offers an overall in-depth exploration that how BIM, AI, AR, and VR can work together within digital twin Automation systems for managing civil infrastructure facilities. It covers the all-unique benefits of technology, the challenges of integrating all of them together, the potential improvements they offer with in, and their overall long-term impact on the field.},
  keywords={},
  doi={10.1049/icp.2025.1521},
  ISSN={},
  month={May},}@INPROCEEDINGS{11308528,
  author={Zhao, Xiumeng and Hu, Zheng and Jin, Yabin and Xiang, Yanxun},
  booktitle={2025 4th International Symposium on Sensor Technology and Control (ISSTC)}, 
  title={Optimization of Unidirectional Lamb Wave EMAT Based on Narrow-magnet Structure}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Based on double coils excited by signals with a phase difference of a quarter wavelength, unidirectional electromagnetic acoustic transducer (EMAT) can concentrate the energy in a single propagation direction. This not only improves the signal-to-noise ratio of the system but also avoids possible echo interference from the other direction. In this work, the narrow-magnet EMAT concept is merged into the unidirectional scheme, to generate Lamb waves of 230 kHz. According to the simulation analyses, the signal peak amplitude is hence enhanced by 177.01%, while obvious waveform distortion is observed. Then, a coil conductor spacing calibration approach is carried out, so that the signal center frequency deviation is suppressed from 13.65% to 1.91%, and the transceiver efficiency is further increased by 15.39%. The simulated EMAT design concepts are fabricated and testified in practical scenarios, where the modified unidirectional EMAT using a narrow-magnet structure brings a waveform amplitude improvement of 110.30%, and its frequency shift is only 2.09%. Hence, the practicability of the proposed solutions is also verified.},
  keywords={Coils;Acoustic transducers;Acoustic distortion;Simulation;Electromagnetic scattering;Magnetoacoustic effects;Conductors;Transceivers;Calibration;Electromagnetics;electromagnetic acoustic transducer;unidirectional Lamb wave;narrow-magnet;transceiver efficiency},
  doi={10.1109/ISSTC67929.2025.11308528},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9026268,
  author={Wakasa, Takuma and Nagatani, Yoshiki and Sawada, Kenji and Shin, Seiichi},
  booktitle={2020 IEEE/SICE International Symposium on System Integration (SII)}, 
  title={Switched Pinning Control for Vehicle Platoons via Mixed Logical Dynamical Modeling}, 
  year={2020},
  volume={},
  number={},
  pages={449-454},
  abstract={This paper considers a velocity control problem of vehicle platoons using pinning control. We assume that all vehicles can get velocity information of the front vehicle. External control inputs are applied only to some vehicles called pinning agents, and the others adjust their velocities autonomously. As a result, velocities of all vehicles converge to the target value. Here, we propose a switched pinning control method for the situation that the vehicle platoons merge according to their relative positions. Our method consists of two sub-methods. The first is an optimal switching method of pinning agents based on MLD (Mixed Logical Dynamical) system model and MPC (Model Predictive Control). The second is an MPC algorithm for the dynamical network structure of the platoon. Our proposed method enables us to improve consensus speed and to control multiple vehicle platoons separately at the same time.},
  keywords={Dynamical systems;Nonlinear control systems;Mobile robots;Predictive control;Multi-agent systems;Switching systems;Multi-Agent Systems;Pinning Control;Mixed Logical Dynamical System;Model Predictive Control},
  doi={10.1109/SII46433.2020.9026268},
  ISSN={2474-2325},
  month={Jan},}@INPROCEEDINGS{9587231,
  author={Ran, Xingxing and Yang, Fuping},
  booktitle={2021 IEEE 5th Information Technology,Networking,Electronic and Automation Control Conference (ITNEC)}, 
  title={Chinese Relation Extraction with Phrase Component Representations}, 
  year={2021},
  volume={5},
  number={},
  pages={454-458},
  abstract={Recently, the Lattice structure has been proved to be effective for Chinese entity relation extraction by incorporating the word information. However, this method cannot utilize phrases that contain sentence structure information. In order to solve the problem, we introduced a Lattice model with phrase component representation, which can merge word, phrase and character input. We also apply the multi-head self-attention mechanism in the classification layer to effectively learn the dependencies between distant words. After comparative experiments, our model achieves better results.},
  keywords={Analytical models;Automation;Conferences;Lattices;Feature extraction;Data mining;NRE;Multi-Head Attention;Lattice},
  doi={10.1109/ITNEC52019.2021.9587231},
  ISSN={2693-3128},
  month={Oct},}@INPROCEEDINGS{10749898,
  author={Younis, Marwa Mahmood and Habib, Bassam H. and Nassrat Al-Ubaidi, Manar Adnan and Saeed Issa, Samer and Hamodi Aljanabi, Yaser Issam and Soloviova, Tetiana and Jameel Al-Obaidi, Moamin Ibrahim},
  booktitle={2024 36th Conference of Open Innovations Association (FRUCT)}, 
  title={Assessing the Compatibility of Arduino with 6G for Real-Time Patient Monitoring}, 
  year={2024},
  volume={},
  number={},
  pages={445-459},
  abstract={Background: The adoption of sixth generation (6G) networks is expected to revolutionize various sectors like health care by providing unprecedented data transfer capabilities and reliability. This transition is particularly applicable to real-time health monitoring where the speed and consistency of data transmission matters.Objective: The article explores the integration of Arduino Bluetooth modules, specifically the Bluetooth HC-05 module, with 6G technologies for betterment in remote health monitoring systems. By merging the ultra-reliable, low-latency communication (URLLC) characteristics of 6G with the relatively cheap and user-friendly nature of Arduino platforms, a more intelligent health monitoring system could be established.Methodology: The article proposes Arduino sensor modules with a 6G-based real-time uplink to transmit high-resolution biometric data. The study also uses machine learning and edge computing methodologies to improve data processing for patient diagnosis. Factors such as power usage, scalability, and network integration are thoroughly explored to reach a holistic strategy.Results: The results suggest that the use of Arduino Bluetooth and 6G together can enable much better monitoring of many categories in health metrics to meet very different patient profiles. In this collaboration, we are also going to include the two main things that need everyone's attention, data privacy and security. Moreover, the utilization of artificial intelligence (AI) and edge computing led to improved diagnoses and quicker responses.Conclusions: The study demonstrates the promise of Arduino Bluetooth for future healthcare monitoring over 6G networks, and serves as a benchmark toward such ends. It paves the way for cheaper, more available, and innovative healthcare options in the era of the Internet of Things (IoT) and beyond, transforming patient treatment.},
  keywords={6G mobile communication;Bluetooth;Scalability;Medical services;Transforms;Ultra reliable low latency communication;Real-time systems;Internet of Things;Monitoring;Edge computing},
  doi={10.23919/FRUCT64283.2024.10749898},
  ISSN={2305-7254},
  month={Oct},}@INPROCEEDINGS{11245530,
  author={Iida, Yoshiho and Nakamura, Satoru and Fuchida, Masashi},
  booktitle={2025 Pacific Neighborhood Consortium Annual Conference and Joint Meetings (PNC)}, 
  title={Genetic Encoding of Jean-Jacques Rousseau's Writing Process}, 
  year={2025},
  volume={},
  number={},
  pages={53-57},
  abstract={This project develops a digital critical genetic edition of Rousseau's manuscripts using TEI. It encodes spatial structures with <zone> and writing stages with <1-listChange>, revealing the evolution of Rousseau's thought. By treating textual variants as structured data, it visualizes concept formation through writing. This approach merges philological accuracy with dynamic manuscript representation, contributing to Enlightenment studies and digital humanities.},
  keywords={Humanities;Accuracy;Conferences;Data visualization;Writing;Genetics;Encoding;TEI markup;genetic criticism;manuscript analysis;codicological study;modern Western political thought;Jean-Jacques Rousseau},
  doi={10.23919/PNC67749.2025.11245530},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11013753,
  author={Mani, Dhanabal and Thota, Sai Chandra Reddy and Gonzalez, Abel},
  booktitle={2025 78th Annual Conference for Protective Relay Engineers (CFPR)}, 
  title={Field Testing Challenges and Innovations for LPITs in Relay Protection Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={The integration of Low Power Instrument Transformers (LPITs) into medium and high-voltage switchgear marks a significant advancement in relay protection systems. Offering notable advantages over conventional instrument transformers, such as reduced size, absence of saturation, and enhanced safety, LPITs are becoming increasingly prevalent. This paper explores the challenges and innovations in field-testing protection systems equipped with LPITs. Unlike traditional systems, LPITs do not utilize standard 1A/5A and 100V/110V outputs, necessitating the development of specialized test kits that accommodate LPIT-specific analog outputs. We detail the creation and application of a new secondary injection test kit designed to support LPITs effectively. Additionally, the paper discusses various testing methodologies that have been adapted to validate the functionality and accuracy of LPITs within operational settings. Our findings highlight the critical role of precise testing equipment and methodologies in ensuring the reliability and effectiveness of modern protection systems enhanced by LPIT technology.},
  keywords={Technological innovation;Accuracy;Voltage transformers;Protective relaying;High-voltage techniques;Reliability;Protection;IEC Standards;Standards;Testing;Low Power Instrument Transformer (LPIT);secondary injection test kit;Low Power Relay Test set;LPRT;Low Power Voltage Transformer;LPVT;MU;Merging Units;IED;Intelligent Electronic Device;Fault Recorder;IEC 61850-9-2;IEC 61869-10;IEC 61869-11},
