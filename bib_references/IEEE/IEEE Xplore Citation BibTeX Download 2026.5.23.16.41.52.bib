  journal={IEEE Sensors Journal}, 
  title={HyCrackNet: A Multisensor-Based Framework for Accurate Pavement Crack Segmentation}, 
  year={2025},
  volume={25},
  number={22},
  pages={42154-42170},
  abstract={Accurate and timely detection of pavement cracks is crucial for traffic safety and extending infrastructure service life. Nevertheless, existing crack detection algorithms generally suffer from limitations, including inadequate extraction of fine-grained crack features and insufficient fusion of multiscale information. To~solve these problems, this study proposes a crack segmentation framework named HyCrackNet. It~consists of three core modules: the dual branch-aware semantic attention (DBSA) block, dilated depthwise feature enhancement (DDFE) block, and cross-level feature synthesis (CLFS) block. The DBSA block can enhance shallow crack-edge features while suppressing background noise, and the DDFE block can capture diverse crack patterns without significantly increasing computational complexity. Furthermore, the CLFS block dynamically selects and merges high-and low-level features based on crack sizes and characteristics, achieving an optimal balance between positional accuracy and semantic consistency. Experimental results demonstrate that HyCrackNet significantly surpasses state-of-the-art methods in both segmentation accuracy and generalization performance. These results indicate that HyCrackNet provides a highly robust, precise, and efficient solution for automated pavement crack segmentation, thus advancing practical applications of semantic segmentation in pavement condition assessment.},
  keywords={Feature extraction;Accuracy;Semantics;Lighting;Transformers;Roads;Inspection;Image edge detection;Decoding;Visualization;Crack segmentation;data augmentation;feature fusion;structural health monitoring},
  doi={10.1109/JSEN.2025.3616032},
