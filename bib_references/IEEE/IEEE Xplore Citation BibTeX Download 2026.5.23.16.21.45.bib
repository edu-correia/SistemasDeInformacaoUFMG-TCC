  author={Jiang, Lanxiang and Cai, Bin and Zhang, Wanning},
  booktitle={2024 10th International Conference on Computer and Communications (ICCC)}, 
  title={Cross-Cultural Expression Spotting Method Based on Optical Flow and Sliding Window}, 
  year={2024},
  volume={},
  number={},
  pages={171-175},
  abstract={One of the anticipated attributes of artificial intelligence is its ability to possess human-like characteristics, particularly in analyzing and understanding facial emotions. The challenge of the video macro/micro expression Cross-Cultural Spotting (CCS) task lies in the subtlety, brevity, and difficulty of accurately pinpointing micro-expressions. This paper proposes a macro/micro expression spotting framework based on Main Directional Mean Optical-flow (MDMO). The framework amplifies micro-expression motion information, significantly enhancing the recognizability of expression intervals in optical flow feature maps. By employing a sliding window localization method, the framework accurately captures the start and end frames of expressions, enabling effective merging and post-processing of expression intervals. This approach achieves an optimized balance between precision and recall while reducing the false positive rate. Our method achieved state-of-the-art results on the CAS(ME)2 and SAMM-LV datasets and secured third place on the MEGC2024 testing set, demonstrating both the effectiveness and transferability capabilities of our approach. Our code is available at https://github.com/ceasorcaiIMEGC2024},
  keywords={Optical filters;Integrated optics;Location awareness;Stimulated emission;Noise reduction;Merging;Interference;Feature extraction;Optical flow;Testing;Expression Spotting;Cross-Cultural Spotting},
  doi={10.1109/ICCC62609.2024.10941771},
  ISSN={2837-7109},
  month={Dec},}@INPROCEEDINGS{10795277,
  author={Li, Xinke and Zhu, Xiaojing and Wang, Yuhuai},
  booktitle={2024 3rd International Conference on Service Robotics (ICoSR)}, 
  title={Research on Cargo Palletizing Problem Based on Hybrid Genetic Algorithm}, 
  year={2024},
  volume={},
  number={},
  pages={183-188},
  abstract={In the field of logistics and transportation, the problem of cargo palletizing is a key link, which directly affects the transportation efficiency and cost. In order to maximize the space utilization rate of palletizing, a hybrid genetic algorithm, which combines heuristic algorithm and GA, is proposed. On the basis of satisfying multiple constraints, the heuristic algorithm improves the space utilization by space segmentation and merging, and obtains the initial loading scheme by combining the complex block generation and other operations. In genetic algorithm, the initial population is generated by block coding. An elite retention strategy is used to introduce biased random keys for cross-operation to enhance the search efficiency of the algorithm. Finally, genetic algorithm combined with heuristic algorithm is used to find the optimal palletizing scheme. Multiple sets of simulation experiments were conducted based on BR classic cases, and the results showed that the hybrid genetic algorithm could improve the space utilization rate of the pallet more efficiently.},
  keywords={Costs;Service robots;Heuristic algorithms;Space debris;Loading;Merging;Transportation;Mathematical models;Pallets;Genetic algorithms;space utilization rate;stacking;heuristic algorithm;genetic algorithm},
  doi={10.1109/ICoSR63848.2024.00046},
  ISSN={},
  month={July},}@INPROCEEDINGS{11239829,
  author={Wang, Zisheng and Peng, Cong and Xing, Yulong and Zhang, Leilei and Shao, Yunfei and Xuan, Jianping},
  booktitle={2025 International Conference on Equipment Intelligent Operation and Maintenance (ICEIOM)}, 
  title={A Prompt-Driven Industrial Large Model for Intelligent Operation and Maintenance of High-End Equipment}, 
  year={2025},
  volume={},
  number={},
  pages={1418-1421},
  abstract={Intelligent Operation and Maintenance (IO&M) of high-end equipment faces challenges such as a lack of annotated data, weak generalization capability, and insufficient integration of domain knowledge. To address these issues, we propose an Industrial Large Model (ILM) that unifies the time-frequency visual representation of sensor signals with textual maintenance knowledge within a large decoder-based language model framework. ILM uses a visual transformer as a visual encoder to extract semantic embeddings from the spectrograms generated by the sensor, which are then projected and merged into a prompt template together with the domain text. Through prompt engineering, ILM effectively fuses multimodal information to achieve flexible and explainable fault diagnosis without complex multi-stage training. Experiments on benchmark datasets and real industrial datasets show that ILM has higher accuracy, robustness, and reasoning ability than baseline methods, highlighting its potential as a next-generation intelligent IO&M solution.},
  keywords={Fault diagnosis;Visualization;Time-frequency analysis;Accuracy;Semantics;Benchmark testing;Transformers;Robustness;Maintenance;Machinery;High-end equipment;Intelligent operation and maintenance;Industrial large model;Multimodal learning;Transformer},
  doi={10.1109/ICEIOM65271.2025.11239829},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10502509,
