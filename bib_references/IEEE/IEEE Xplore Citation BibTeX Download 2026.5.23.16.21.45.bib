  number={7},
  pages={2073-2093},
  abstract={The explosive growth of RDF data makes it difficult to be efficiently queried, understood and used. RDF graph (RDFG) summarization aims to extract the most relevant and crucial data as summaries according to different criteria. Current summarization approaches mainly apply single strategies such as graph structure, pattern mining or relevance metrics to calculate RDFG summaries. Different to the existing approaches, this paper proposes a summarization approach to automatically generating RDFG summary, which can capture both structure and centrality information. Specifically, we present three algorithms, Sum W (merging nodes based on node characteristics or similar types), SumS (merging nodes based on typed node characteristics) and SummaryFL (retrieving central nodes by combining node frequency and bridging coefficient). The three algorithms can be used by two summarization strategies: SumS or SumW only, and SumS+SummaryFL or SumW+SummaryFL. We conducted experiments over large and real-world RDF datasets to verify the effectiveness of our method with respect to time complexity, compression capability and coverage of the summary. The experiment results demonstrate that our approach outperformed the comparative algorithms.},
  keywords={Measurement;Merging;Knowledge graphs;Resource description framework;Explosives;Data mining;Time complexity;Knowledge graph summarization;node centrality;knowledge graph compression;node characteristic set;graph summarization},
  doi={10.13052/jwe1540-9589.2174},
  ISSN={1544-5976},
  month={October},}@ARTICLE{11476990,
  author={Zhang, Zhihao and Kieu, Minh and Wang, Yunlong and Ranjitkar, Prakash and Vu, Hai L.},
  journal={IEEE Transactions on Vehicular Technology}, 
  title={A Mixed Platoon Guided Control Model for Efficient and Safer Merging in Mixed Traffic With Low Penetration of Autonomous Vehicles}, 
  year={2026},
  volume={},
  number={},
  pages={1-14},
  abstract={Traditional ramp merging relies on drivers' observation and cooperation, which creates efficiency bottlenecks and accident hotspots. Existing mixed-traffic strategies offer improvements, many remain limited by requirements for high AV penetration and strong driver cooperation. This paper introduces the Mixed Platoon Guided Control (MPGC) model, a hierarchical AV-guided merging framework that combines protocol, prediction, and optimisation within a rolling MPC structure. MPGC applies a platoon-interleaving mechanism where AV leaders manage most merging actions, allowing human-driven followers to simply follow without complex decision-making. The framework integrates a dual-rule protocol for dynamic traffic, a data-driven prediction layer accounting for human driving heterogeneity, and a trajectory optimisation layer based on merging time window search. SUMO simulations demonstrate that at 10% AV penetration, MPGC increases throughput by up to 33% and 12% compared to FIFO and RM, respectively. For safety, MPGC achieves an 86% reduction in risky time-to-collision (TTC) events compared to FIFO, reaching a safety level comparable to RM. The system also remains robust under human driving heterogeneity, incomplete platoon formation, and V2X failures, showing good scalability in low-penetration scenarios.},
  keywords={Jamming;Electronic warfare;System-on-chip;Circuits;Feedback;Application specific integrated circuits;Radio frequency;Protocols;Communication systems;Vehicle-to-everything;Cooperative merging;mixed traffic;autonomous vehicles;model predictive control;random forest},
