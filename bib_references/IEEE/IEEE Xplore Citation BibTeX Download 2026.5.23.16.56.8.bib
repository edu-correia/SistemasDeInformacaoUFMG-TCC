  booktitle={2025 2nd International Conference on Computational Intelligence, Communication Technology and Networking (CICTN)}, 
  title={Decoding Cyber Fraud Schemes and the Rise of ‘Fraud-as-a-Service’}, 
  year={2025},
  volume={},
  number={},
  pages={538-542},
  abstract={Dark web marketplaces have over time become the center of all illegitimate actions and a major challenge to law enforcement and cybersecurity professionals. This study will detail the dynamics within such platforms, with a narrow focus on prevalent cyber fraud schemes. Through digital ethnography and records analysis, merged data mining and forensic tools in studying 50 dark web marketplaces over 18 months. Our results have defined five main schemes, namely credential stuffing, RaaS, phishing kits, carding, and money mulling services. Organizational structures, cost models, and changes in tactics of each were subjected to systematic analysis. Observed the emergence of a 'fraud-as-a-service' model with relatively low barriers to entry for new entrants. The paper also draws attention to emerging gaps in modern cybersecurity practices and legislation that must form the basis of further work that should also bring in more active international cooperation, robust AI-based monitoring, and focused awareness campaigns. This study extends the existing knowledge of cybercriminal activities and provides practical policy recommendations for stakeholders, such as decision-makers, police authorities, or IT security professionals.},
  keywords={Dark Web;Systematics;Law enforcement;Biological system modeling;Phishing;Market research;Fraud;Data mining;Computer crime;Monitoring;Cybersecurity;data mining;dark web;ethnography;RaaS},
  doi={10.1109/CICTN64563.2025.10932616},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11519397,
  author={Munzir, Mohammad and Khan, Mohammad Shadab and Kumaresan, Prabha and Yee, Lee Fong and Kamal, Shahid},
  booktitle={2026 Second International Conference on Emerging Computational Intelligence (ICECI)}, 
  title={Traditional to Transformer TabPFN for ASD Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Autism Spectrum Disorder (ASD) is a neurodevelopmental condition that typically includes challenges in communication, eye contact, social interaction and repetitive behaviors. Machine Learning approaches whether it be traditional or modern have been widely used for structured autism datasets; however, they require extensive feature engineering and may not work properly with small or imbalanced data. The dataset was preprocessed, merged and cleaned to form a unified dataset of 5,584 samples. TabPFN, a transformer-based model was evaluated alongside state-of-the-art models XGBoost and CatBoost. The models were evaluated on accuracy, R2 score, Mean Square Error (MSE), and Mean Absolute Error (MAE). The results show that TabPFN performed the best with accuracy of 88% test accuracy and 0.52 of R2 score. The improvement compared to CatBoost and XGBoost in terms of accuracy is 2% and 1518% in error reduction. These findings indicate that TabPFN has strong generalization capabilities with minimum tuning required and hold high potential for ASD diagnosis. This work also show potential for deep learning architecture for ASD screening. Future work can focus on working on large dataset with use of multimodal approach.},
  keywords={Modeling;Accuracy;Autism;Pediatrics;Testing;Training;Algorithms;Medical diagnosis;Optimization;Printing;Autism;Autism Spectrum Disorder;ASD;ASD screening;Deep Learning;Machine Learning;TabPFN;CatBoost;XGBoost},
