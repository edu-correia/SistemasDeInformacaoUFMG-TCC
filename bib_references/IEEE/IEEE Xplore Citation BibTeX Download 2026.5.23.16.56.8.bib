@INPROCEEDINGS{10450973,
  author={Zhang, Lei and Ren, Guofeng and Li, Yinhua and Su, Ziqi and Xu, Dayong and Li, Shanlian},
  booktitle={2023 China Automation Congress (CAC)}, 
  title={A novel deep CGRU model with feature attention for prediction of moisture content in Leaf moistening}, 
  year={2023},
  volume={},
  number={},
  pages={3975-3979},
  abstract={The moisture content at the outlet of the leaf moistening process is an important process indicator in the production process, and its stability and accuracy directly affect the product quality. To address the issues, this paper proposes a moisture content prediction method based on feature attention mechanism and deep spatio-temporal representation. First, feature attention is applied to dynamically adjust the importance of different process variables based on their relevance to the target quality variable. Convolutional Neural Networks (CNN) and Gated Recurrent Unit (GRU) structure is utilized to capture the coupling and correlation among the variables, and capture the long-term temporal dependencies. Additionally, a parallel GRU is constructed to explore the autocorrelation properties among historical quality variables. Finally, the paper utilizes a concatenation layer to merge the parallel information into a deep spatio-temporal representation, which is then fed into a fully connected layer network to predict the moisture content at the outlet. The experimental results demonstrate that the proposed method outperforms the baseline methods in terms of prediction accuracy and stability, and provides effective decision support for operators and meets the requirements of industrial production.},
  keywords={Technological innovation;Moisture;Production;Predictive models;Logic gates;Stability analysis;Product design;dynamic prediction;moisture content;gated recurrent unit;convolutional neural network;feature attention},
  doi={10.1109/CAC59555.2023.10450973},
  ISSN={2688-0938},
  month={Nov},}@INPROCEEDINGS{10396645,
  author={Sverdlov, Viktor and Selberherr, Siegfried},
  booktitle={2023 IEEE 15th International Conference on ASIC (ASICON)}, 
  title={Charge and Spin Transport in Semiconductor Devices}, 
  year={2023},
  volume={},
  number={},
  pages={1-4},
  abstract={As the scaling of CMOS-based technology comes to a saturation, using the electron spin is the only alternative to increasing the performance of integrated circuits. Indeed, the spins are attractive for quantum applications. In digital applications, the electron spin offers an additional functionality to electron charge-based devices. As spin injection and spin manipulation by the gate voltage in semiconductors were successfully demonstrated, spin-enhanced SpinFETs and SpinMOSFETs will likely appear on the market in the non-distant future.Emerging spin-based memories -spin-transfer torque (STT) and the spin-orbit torque (SOT) magnetoresistive random access memories (MRAMs) - are nonvolatile and CMOS-compatible. MRAM already competes with flash and is a potential nonvolatile contender for SRAM. Merging nonvolatile elements with CMOS circuitry allows data processing close to the memory, thereby creating novel low power computational paradigms.Technology Computer-Aided Design (TCAD) is an important enabler of microelectronics' development. Considering examples of spin-augmented switches and ultra-scaled MRAM, we demonstrate how the drift-diffusion transport approach can be generalized to model complex multi-layered structures consisting of semiconductors and normal and ferromagnetic metal layers separated by tunnel barriers.},
  keywords={Semiconductor device modeling;Torque;Nonvolatile memory;Computational modeling;Magnetoresistive devices;Random access memory;Magnetoresistance;charge and spin currents;TCAD;digital spintronics;SpinFET;SpinMOSFET;STT-MRAM;SOT-MRAM},
  doi={10.1109/ASICON58565.2023.10396645},
  ISSN={2162-755X},
  month={Oct},}@INPROCEEDINGS{10740866,
  author={Yoo, Honghyeon and Byun, Hongsu and Park, Sungyong},
  booktitle={2024 IEEE International Conference on Cluster Computing Workshops (CLUSTER Workshops)}, 
  title={Refining Compaction Offloading I/O Stack for LSM-Based Key-Value Stores with SPDK}, 
  year={2024},
  volume={},
  number={},
  pages={204-205},
  abstract={We analyze the compaction I/O characteristics and the resulting I/O time amplification problem in log-structured merge-tree based key-value stores. We also propose an I/O stack refinement using SPDK and NVMe-oF for compaction offloading. Using our proposed I/O stack, preliminary experimental results show a 37.7% improvement in compaction throughput.},
  keywords={Conferences;Refining;Cluster computing;Throughput;Compaction;Key-Value Store;LSM-tree;SPDK},
  doi={10.1109/CLUSTERWorkshops61563.2024.00060},
  ISSN={},
  month={Sep.},}@ARTICLE{8943473,
  author={Nath, V. and Kumar, M.},
  journal={Radio Science}, 
  title={A compact flower-shaped printed monopole MIMO antenna for wideband applications}, 
  year={2019},
  volume={54},
  number={11},
  pages={963-974},
  abstract={This paper presents a 2 × 1 flower-shaped (FS) multiple-input multiple-output (MIMO) monopole antenna with enhanced bandwidth and compact dimensions for modern wireless wideband applications. The proposed FS-MIMO antenna is formed by merging multiple ellipses, each of which has a different value of semimajor axis length and eccentricity. These ellipses are used to obtain resonances at different frequencies, which cumulatively give a wideband behavior. The antenna characteristics such as reflection coefficient (S11), peak gain, surface current distribution at different resonating frequencies, and 2-D radiation patterns are investigated. The measured impedance bandwidth (for S11 below−10 dB) of the implemented antenna is around 126% (2.52–11.12 GHz). The measured peak gain varies from 2.16 to 6.57 dB in the entire impedance bandwidth. Furthermore, the measured values of diversity performance parameters such as envelope correlation coefficient, diversity gain, total active reflection coefficient, and mutual coupling (S21) are found within their acceptable limit. The more compact dimensions of 22 × 24 mm2 (or about 0.15λ0 × 0.16 λ0) as compared to the latest state-of-art along with the good diversity performance makes the proposed antenna a capable contender for antenna structures supporting wide impedance bandwidth wireless applications. The proposed antenna shows the good matching characteristics under various scenarios such as an extended ground plane, USB connector, and device housing (both vertical and horizontal).},
  keywords={MIMO communication;Impedance;Microstrip antennas;Wideband;Broadband antennas},
  doi={10.1029/2019RS006884},
  ISSN={1944-799X},
  month={Nov},}@INPROCEEDINGS{9436764,
  author={Jia, Shuyuan and Wang, Chao and Qing, Xinyu and Ma, Zhien},
  booktitle={2021 IEEE 8th International Conference on Industrial Engineering and Applications (ICIEA)}, 
  title={Organization Design of Production Line for an Enterprise}, 
  year={2021},
  volume={},
  number={},
  pages={252-256},
  abstract={On the basis of the previous research, the organization design of the assembly line is carried out. With constraint conditions, according to the standard time and the considered wide time, assembly line takt time is calculated, and found the bottleneck process with the longest processing time, designed for the assembly line load. According to the process capacity and process rate, calculated each process needs to be completed in the system time of processing task, time quota, interval number, and work time, and drew out the standard work instruction chart. Through hours restructured, station merged, to reduce the bottleneck process and intermittent time, improve the assembly line load, finally the assembly line workplaces are redistributed, and the workers are arranged reasonably, and then the organization structure design of the assembly line is carried out, a production line is formed for the enterprise.},
  keywords={Productivity;Standards organizations;Employment;Transportation;Process control;Production;Industrial engineering;assembly line takt time;assembly line load;assembly line balance},
  doi={10.1109/ICIEA52957.2021.9436764},
  ISSN={},
  month={April},}@INPROCEEDINGS{11413023,
  author={Xu, Yunhong and Zong, Yikai and Shi, Peng and Cai, Maolin},
  booktitle={2025 7th International Symposium on Robotics and Intelligent Manufacturing Technology (ISRIMT)}, 
  title={Product Manufacturing Information Recognition from Engineering Drawings}, 
  year={2025},
  volume={},
  number={},
  pages={11-14},
  abstract={Product Manufacturing Information (PMI) plays a vital role in engineering drawings for intelligent manufacturing, as its precise and efficient extraction is essential for automating process planning. This research introduces a hybrid approach that merges computer vision techniques with deep learning to address the difficulties in extracting PMI, including dispersed text layout and intricate technical symbols. The proposed framework features a multi-phase processing pipeline, which involves object detection, rotation correction and text extraction. Notably, it utilizes oriented bounding box detection along with a four-category classification model to greatly enhance the accuracy of identifying PMI regions. Additionally, the study presents a combined text analysis structure that integrates object detection with Optical Character Recognition (OCR), enabling the effective extraction of specialized elements such as dimensional tolerances and surface texture annotations.},
  keywords={Accuracy;Engineering drawings;Optical character recognition;Process planning;Pipelines;Symbols;Quality control;Object detection;Feature extraction;Manufacturing;Product Manufacturing Information;Engineering drawings;Quality control;OCR},
  doi={10.1109/ISRIMT67769.2025.11413023},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10069473,
  author={Wu, Lin Ling and Su, Huafeng and Zhang, Jun and Zhang, Xiu Yin},
  booktitle={2022 IEEE 10th Asia-Pacific Conference on Antennas and Propagation (APCAP)}, 
  title={Equivalent Lumped-circuit Analysis of the Filtering Two-Elements Series-Fed Array Antenna}, 
  year={2022},
  volume={},
  number={},
  pages={1-2},
  abstract={A filtering two-elements series-fed vertical array antenna is presented in this paper, and the equivalent filtering lumped-circuit of the antenna is analyzed. The antenna consists of the dipoles for radiation and double-sided parallel strip line (DSPSL) for feeding. The dipoles are designed as the series resonators. The DSPSL is shorted in both ends and served as a parallel resonance. Because dipoles are fed in-phase by the DSPSL structure, the series resonators are excited in parallel. By introducing the J-inverter, the series resonators are transformed to the parallel resonators. Then these lumped-circuits are merged into a second-order filtering network by applying the network theory. Eventually, the proposed antenna can be regarded as the second order filter.},
  keywords={Filtering;Dipole antennas;Antenna theory;Simulation;Resonator filters;Antenna feeds;Filtering theory;Series-fed array antenna;filtering antenna;filtering circuits},
  doi={10.1109/APCAP56600.2022.10069473},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11117094,
  author={Yang, Shuaitao and Fu, Wenwen},
  booktitle={2025 8th International Symposium on Big Data and Applied Statistics (ISBDAS)}, 
  title={GraphGLA: Enhancing Graph Neural Networks with Generative Local Feature Augmentation for Anomaly Detection}, 
  year={2025},
  volume={},
  number={},
  pages={140-143},
  abstract={Graph Neural Networks (GNNs) are commonly applied in graph anomaly detection. Despite their success in mining structured data, traditional GNNs often encounter issues like over-smoothing and information loss. when dealing with sparse and heterogeneous neighborhoods, limiting their effectiveness in anomaly detection. To tackle these challenges, we introduce a new framework, GraphGLA which improves node representation by enhancing homogeneous neighbor features. Specifically, we design a node discriminator to classify neighbors as homogeneous or heterogeneous, and then leverage a Conditional Variational Autoencoder (CVAE)[1] to generate additional homogeneous neighbor features. The generated features are subsequently merged with the original feature set and used for anomaly detection via a Graph Attention Network (GAT). Experiments on three public anomaly detection datasets show that GraphGLA greatly outperforms existing methods. This approach effectively mitigates the impact of sparse and heterogeneous neighborhoods on anomaly detection, providing robust and accurate detection capabilities.},
  keywords={Limiting;Accuracy;Autoencoders;Big Data;Feature extraction;Graph neural networks;Sparse matrices;Anomaly detection;Gaph Neural Networks;Anomaly Detection;Conditional Variational Autoencoder},
  doi={10.1109/ISBDAS64762.2025.11117094},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11454738,
  author={Liu, Rong},
  booktitle={2025 International Conference on Computing, Robotics and System Sciences (ICRSS)}, 
  title={An Intelligent Accounting Computerization System Based on Catastrophe Series Method for Financial Data Evaluation and Decision-Making}, 
  year={2025},
  volume={},
  number={},
  pages={213-218},
  abstract={The traditional computerized system only realizes paperless office, and some computerized systems realize data mining functions through data mining, but they lack basic data evaluation and decision-making functions. Therefore, this paper improves the functionality and innovation of the traditional accounting computerized system through the catastrophe series method evaluation model, combines the catastrophe series method evaluation model for data processing, and merges the data processing flow in the traditional computerized accounting model. In the construction of the merger model and the ownership model, it is necessary to sort out the organizational structure of the group. In addition, this paper combines with experimental research to verify the effectiveness of the model proposed in this paper. Through experimental analysis, we can know that the model proposed in this paper can effectively improve the efficiency of accounting information processing and decision-making, and has a certain role in promoting the intelligent development of accounting computerized systems. Therefore, it can help enterprises play an important role in financial process reengineering and financial data processing and decision-making.},
  keywords={Weight measurement;Analytical models;Technological innovation;Computational modeling;Decision making;Evaluation models;Information processing;Data processing;Data models;Data mining;Data mining;finance;accounting;computerization;catastrophe series method},
  doi={10.1109/ICRSS67786.2025.00048},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10332118,
  author={Xiaopan, Wang and Aixia, Wang and Gang, Yang and Jingjiao, Li},
  booktitle={2023 IEEE 6th International Conference on Pattern Recognition and Artificial Intelligence (PRAI)}, 
  title={A Kidney Tumor Segmentation Method Based on the Combination of U-Net and Transformer}, 
  year={2023},
  volume={},
  number={},
  pages={395-400},
  abstract={According to the characteristics of kidney tumours in abdominal multi-organ CT images, analyzing the CNN network to deal with long-distance connection defects and the shortage of Transformer structure detail processing, we designed a multimodal residual continuous convolution CNN and an improved multiscale dual-path multi-head attention Transformer combined with an encoder, deconvolution up-sampling, and learnable attention gating mechanism of the decoder with a jump junction introduced into the multiscale convolutional fusion module to form an asymmetric U-Net model framework for kidney tumour segmentation. Experimental comparison results show that the proposed method achieves an average dice coefficient of 0.9352, an average cross-merge rate of 0.9894, and a class-average pixel accuracy of 0.98235 for kidney segmentation metrics, which are more accurate and detailed than the existing and newer network models for segmentation.},
  keywords={Measurement;Computed tomography;Transformers;Decoding;Pattern recognition;Convolutional neural networks;Kidney;Residual continuous convolution;multi-scale fusion block;patched dual-path;multi-head attention},
  doi={10.1109/PRAI59366.2023.10332118},
  ISSN={},
  month={Aug},}@ARTICLE{9267283,
  author={Nathanail, Antonios and Fromm, Christian M and Porth, Oliver and Olivares, Hector and Younsi, Ziri and Mizuno, Yosuke and Rezzolla, Luciano},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Plasmoid formation in global GRMHD simulations and AGN flares}, 
  year={2020},
  volume={495},
  number={1},
  pages={1549-1565},
  abstract={One of the main dissipation processes acting on all scales in relativistic jets is thought to be governed by magnetic reconnection. Such dissipation processes have been studied in idealized environments, such as reconnection layers, which evolve in merging islands and lead to the production of ‘plasmoids’, ultimately resulting in efficient particle acceleration. In accretion flows on to black holes, reconnection layers can be developed and destroyed rapidly during the turbulent evolution of the flow. We present a series of two-dimensional general-relativistic magnetohydrodynamic simulations of tori accreting on to rotating black holes focusing our attention on the formation and evolution of current sheets. Initially, the tori are endowed with a poloidal magnetic field having a multiloop structure along the radial direction and with an alternating polarity. During reconnection processes, plasmoids and plasmoid chains are developed leading to a flaring activity and hence to a variable electromagnetic luminosity. We describe the methods developed to track automatically the plasmoids that are generated and ejected during the simulation, contrasting the behaviour of multiloop initial data with that encountered in typical simulations of accreting black holes having initial dipolar field composed of one loop only. Finally, we discuss the implications that our results have on the variability to be expected in accreting supermassive black holes.},
  keywords={accretion, accretion discs;black hole physics;magnetic reconnection},
  doi={10.1093/mnras/staa1165},
  ISSN={1365-2966},
  month={Feb},}@BOOK{11145988,
  author={Kelly, Jaime},
  booktitle={3D Character Rigging in Blender: Bring your characters to life through rigging and make them animation-ready},
  year={2024},
  volume={},
  number={},
  pages={},
  abstract={Leverage expert advice, step-by-step guidance, and comprehensive visual aids to pave your way towards excellence in the art of 3D character rigging with the help of this part-color guideKey FeaturesLearn how to use automatic and manual weight painting to merge skin and boneEnhance any rig with a sweeping host of automatic controls and aids for animationKeep your rigs efficient and clean for an optimal end user experiencePurchase of the print or Kindle book includes a free PDF eBookBook DescriptionIn the intricate world of 3D character rigging with Blender, aspiring artists often find themselves grappling with the daunting challenge of achieving results akin to seasoned professionals. This book is your guide to overcoming that very challenge, providing you with the necessary knowledge and skills to excel in this complex art form. As you embark on this creative journey, this book will guide you through a carefully crafted flow. Beginning with the basics, the first part of the book will teach you how to add structure to an empty canvas and master the art of weight painting in Blender. You'll delve into the intricacies of rigging humanoid characters, gain a deep understanding of the essential buttons and techniques, and discover invaluable success-boosting tips. Starting with simple mesh deformation using a single bone, you'll progress steadily toward the mastery of fully rigging a human character, all while comprehending the reasons behind each step in the process. Furthermore, the book leaves you with a selection of advanced techniques, fully explained, paving the way for a natural progression in your artistic journey and allowing you to continuously refine and enhance your skills. By the end of the book, you'll excel at crafting character rigs, seamlessly meeting professional pipeline demands in diverse teams and studios.What you will learnUnderstand the basic terminology of rigging and learn how to create and modify rigsFind out how bones interact with topologyGet to grips with weight painting through the meshKnow when and how to add constraints such as Inversion Kinetics, Point To, and Child OfMake rigs visually appealing with advanced techniques such as shape keys and bone driversFamiliarize yourself with advanced techniques used by industry leadersWho this book is forIf you are an animator, modeler, or someone who wants to start rigging with a solid foundation, then this book is for you. You’ll need no prior knowledge of Blender to get started with this book, as we’ll go step by step with shortcuts and UI pointers provided.},
  keywords={},
  doi={},
  ISSN={},
  publisher={Packt Publishing},
  isbn={9781803248257},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/11145988},}@ARTICLE{10148654,
  author={Lim, Jeong-Taek and Choi, Han-Woong and Song, Jae-Hyeok and Choi, Sunkyu and Park, Changkun and Kim, Choul-Young},
  journal={IEEE Microwave and Wireless Technology Letters}, 
  title={Ka-Band CMOS ×5 Frequency Multiplier With Current-Reuse Technique}, 
  year={2023},
  volume={33},
  number={8},
  pages={1227-1230},
  abstract={In this study, we propose a Ka-band  $\times 5$  frequency multiplier implemented through a 65-nm CMOS process. The frequency quintupler core is merged with the common-source (CS) amplifier in a current-reuse structure to achieve low power consumption. To further improve harmonic suppression, the interstage matching network of the frequency quintupler core is constructed using a third-order high-pass filter (HPF). The proposed quintupler core was implemented as a high conversion gain  $\times 5$  frequency multiplier along with input/output buffer and notch filter. The size of the proposed  $\times 5$  frequency multiplier was  $0.81\times0.95$  mm, including the input and output buffers. Furthermore, the measurement results of the  $\times 5$  frequency multiplier showed that the conversion gain for the 27.3–28.6 GHz range was 30.7–31.3 dB at input power values of −34 dBm, and the harmonic suppression is in the 30.9–37.5 dBc. In the operating frequency band, the input and output return losses are greater than 10 dB, and the power consumption was 23 mW.},
  keywords={Power harmonic filters;Gain;Frequency conversion;Harmonic analysis;Power demand;Harmonics suppression;Microwave filters;CMOS;frequency multiplier;frequency quintupler;Ka-band;low power},
  doi={10.1109/LMWT.2023.3276412},
  ISSN={2771-9588},
  month={Aug},}@INPROCEEDINGS{11393971,
  author={Agarwal, Shobit and Kashif, Muhammad Fayyaz and Yaseen, Junaid and Mazaheri, Zahra and Riccio, Daniele and Andreone, Antonello and Iodice, Antonio},
  booktitle={2025 Photonics & Electromagnetics Research Symposium - Fall (PIERS-Fall)}, 
  title={Angularly Stable Wheel Shaped VO2 Controlled Cross Polarization Converter for THz Applications}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={In this work, a reflective linear-to-linear (L2L) cross polarization converter (CPC) for terahertz (THz) applications is proposed. The proposed unit cell consists of a modified wheel shaped structure achieved by merging different circular rings having different radii. The proposed CPC is designed on a polyimide substrate suitable for THz application and offers an impedance bandwidth of 153.6% within the frequency range $345-715 \text{GHz}$. A phase change material, vanadium dioxide $(\text{VO}_{2})$ is used to control the polarization conversion process. The polarization conversion operates below the threshold temperature (68 °C) due to the insulating state of $\text{VO}_{2}$, whereas above this temperature the process is not present. The polarization conversion ratio (PCR) of the proposed CPC is above 75% within the operating band. The angular stability analysis indicates that the proposed design can handle oblique waves impinging on the surface up to an incident angle of 50°.},
  keywords={Structural rings;Surface impedance;Surface waves;Wheels;Bandwidth;Vanadium;Switches;Surface treatment;Substrates;Terahertz communications},
  doi={10.23919/PIERS-Fall62445.2025.11393971},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9153502,
  author={Samoylichenko, Maria A.},
  booktitle={2020 21st International Conference of Young Specialists on Micro/Nanotechnologies and Electron Devices (EDM)}, 
  title={Additional Pulses in the Time Response of a Modal Filter with a Passive Conductor in the Reference Plane Cutout}, 
  year={2020},
  volume={},
  number={},
  pages={159-164},
  abstract={The paper considers the technique for improving the protection against an ultrashort pulse with the help of a modal filter made by cutting a passive conductor in the reference plane of a microstrip line. The influence of the asymmetry of the cross section on the difference between the mode delays and the amplitudes of the decomposition pulses is studied. The decomposition of the first and second pulses, which merged at symmetry, is achieved. The appearance of additional pulses was revealed. It is shown that the delays of additional pulses are determined by a linear combination of the per-unit-length delays of the line multiplied by its length. The influence of boundary conditions at the ends of a passive conductor with an asymmetric structure is investigated. The appearance of additional pulses was detected, the amplitude of which is greater than the amplitude of the pulses of three main modes. The optimum value of separation between the conductors is obtained, which gives the attenuation by 10.4 times.},
  keywords={Conductors;Delays;Electron devices;Microstrip filters;Optical pulse generation;Boundary conditions;Attenuation;modal filter;ultrashort pulse;electronic equipment;protection device;microstrip line.},
  doi={10.1109/EDM49804.2020.9153502},
  ISSN={2325-419X},
  month={June},}@INPROCEEDINGS{10139133,
  author={Choudhary, Komal and Kupriyanov, Alexander and Boori, Mukesh Singh and Valiev, Ayrat},
  booktitle={2023 IX International Conference on Information Technology and Nanotechnology (ITNT)}, 
  title={Land Sustainability Evaluation Using Remote Sensing Techniques with Google Earth Engine}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={Agricultural sustainability is essential in the moderate Republic of Tatarstan region to improve land agriculture production and preserve natural resources, which must adapt to the increasing population with the expansion of newly reclaimed land. The purpose of this study is to assess agricultural sustainability conditions and possibilities by assimilating economic viability and biophysical viability into a sustainable agricultural structure. In determining the suitability classes, topographic features such as slope, aspect, and elevation, as well as soil texture, pH, and soil depth, were applied as criteria. Weighted overlay analysis was applied to merge various thematic layers to find suitable areas for crop production. The Analytic Hierarchy Process (AHP) model is used to determine the weights for all features. The highest weights were acquired for elevation (0.201) and soil (0.223), and the lowest weights were calculated for aspect (0.045). The findings showed that assimilating the AHP method with GIS technology is a practical way to accurately analyze the suitability of land for the production of a particular crop and reduce the harmful environmental effects of farming methods. This research finding has implications for developing a management plan for sustainable agriculture, which will increase crop productivity in a sustainable way. It can assist in maintaining the ecosystem to enhance the potential for agricultural production and independent village economies throughout the district as well as the Tatarstan region.},
  keywords={Productivity;Sociology;Crops;Analytic hierarchy process;Soil texture;Agriculture;Planning;The Analytic Hierarchy Process (AHP);GIS;sustainable agriculture;ecosystem},
  doi={10.1109/ITNT57377.2023.10139133},
  ISSN={},
  month={April},}@INPROCEEDINGS{10105258,
  author={Chang, Chao-Kai and Yeh, Feng-Ming and Lue, Jiann-Hwa and Wang, Hsuan-Fu and Hsieh, Ya-Hui and Chiang, Chun-Yu and Chen, Der-Chin and Tien, Chuen-Lin},
  booktitle={2023 IEEE 6th Eurasian Conference on Educational Innovation (ECEI)}, 
  title={Design of Optical System of Augmented Reality Near Eye Device}, 
  year={2023},
  volume={},
  number={},
  pages={333-335},
  abstract={Augmented reality (AR) is a technology that instantly merges digital pictures with the real scene. The perspective near-eye display is a key module of AR, through which computer-generated pictures or videos can be displayed in the existing environment. The purpose of this research is to establish the system structure of an augmented reality near-eye display device and to design the off-axis two-piece reflective aspherical mirror. Because AR glasses are wearable and are worn close to the eyes, not only the optical performance of the display but also the clear vision of the user needs to be considered. In this study, an off-axis two-piece reflective aspherical mirror is used as the optical system of the AR for displaying the digital image. The micro-display is placed at the focal point of the optical system to form a digital image, and the horizontal movement of the micro-display along the optical axis is controlled by a precise displacement mechanism so that the patient with uncorrected myopia or hyperopia can see the digital picture and real scene. Because the right and left micro-displays move horizontally independently, the user can see the images on the AR device, which becomes the biggest feature of this study.},
  keywords={Performance evaluation;Technological innovation;Optical design;Digital images;Optical imaging;Optical reflection;Augmented reality;Augmented reality;parabolic;focal length},
  doi={10.1109/ECEI57668.2023.10105258},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11499251,
  author={Lin, Ya-Ting and Ker, Ming-Dou and Huang, Ta-Yi and Li, Jih-San},
  booktitle={2026 IEEE International Reliability Physics Symposium (IRPS)}, 
  title={Robust Power-Rail Clamp Circuit for ESD and Surge Protection in FinFET Integrated Circuits}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={A novel FinFET device structure is proposed to achieve a balanced design between Electrostatic Discharge (ESD) robustness and Electrical Overstress (EOS) Surge immunity for FinFET integrated circuits (ICs). FinFET devices become increasingly susceptible to long pulse EOS events due to reduced effective silicon volume, worse thermal dissipation, and lower breakdown voltage. Currently, industry practices primarily depend on circuit design methodologies to mitigate EOS Surge events. However, several critical challenges must be addressed in circuit design, including design complexity, response delay, and power consumption. To overcome these issues, a component-level solution on the FinFET device with merged LDD implantation under the dummy gate was proposed to effectively enhance HBM robustness and Surge immunity of the power-rail clamp circuit. Notably, these improvements were achieved without the necessity for additional mask or process step, simplifying the fabrication process, and reducing both manufacturing costs and complexity for using in FinFET ICs.},
  keywords={Earth Observing System;Artificial satellites;Radio broadcasting;Frequency modulation;Circuits;Integrated circuits;System-on-chip;Contacts;Circuit synthesis;Circuits and systems;- Electrostatic discharge (ESD);electrical overstress (EOS);FinFET;power-rail clamp circuit;surge},
  doi={10.1109/IRPS61424.2026.11499251},
  ISSN={1938-1891},
  month={March},}@INPROCEEDINGS{11092090,
  author={Chen, Hongliang and Shi, Weiwei},
  booktitle={2025 21st International Conference on Synthesis, Modeling, Analysis and Simulation Methods, and Applications to Circuits Design (SMACD)}, 
  title={A Cost-Efficient Implementation of an SSVEP-Based Brain-Controlled Robotic Arm System}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={This study presents a low-cost FPGA implementation of a single channel SSVEP-BCI system, achieved real-time control of the robotic arm. The proposed architecture integrates a hybrid preprocessing chain that merges differential filtering with a coefficient-symmetric FIR design, achieving the reduction in hardware resource of 42.8%. A radix-4 DIF FFT module is implemented using a four-stage pipelined SDF structure, optimized by a surface-fitting-based approximate complex multiplier to achieve 70.6% reduction in DSPs resource while preserving spectral analysis precision. This system demonstrates the accuracy of the classification 83.4% with 176mW power consumption on Xilinx Artix-7 FPGA (xc7a35tcsg324-1). Experimental validation using both proprietary datasets and open datasets confirms superior performance. Compared to conventional PC-based solutions in robotic arm control tasks, this study establishes a hardware-efficient framework that effectively balances real-time operation, classification accuracy, and low-power constraints for practical BCI deployments.},
  keywords={Accuracy;Power demand;Manipulators;Real-time systems;Hybrid power systems;Time factors;Wearable devices;Integrated circuit modeling;Field programmable gate arrays;Spectral analysis;BCI;SSVEP;FPGA;FFT;robotic arm},
  doi={10.1109/SMACD65553.2025.11092090},
  ISSN={2575-4890},
  month={July},}@INPROCEEDINGS{11426413,
  author={Dwivedi, Yadvendra Prasad and Singh, Raghvenda Kumar and Gupta, Ashish and Ranjan, Pinku and Kumar, Somesh and Chowdhury, Rakesh},
  booktitle={2025 IEEE Microwaves, Antennas, and Propagation Conference (MAPCON)}, 
  title={Compact Multiband SIW Monopole Antenna With Crescent-Shaped Slot for Ka-Band and 5G FR2 Applications}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={This paper presents a compact multiband monopole antenna based on substrate integrated waveguide (SIW) technology, designed for millimeter-wave applications including Ka-band and 5G FR2 systems. The proposed antenna features a crescent-shaped radiating patch with a slot-fed configuration, enabling the excitation of four distinct resonant modes at $30.63 \text{GHz}, 32.21 \text{GHz}, 36.83 \text{GHz}$, and 39.53 GHz. The antenna achieves impedance bandwidths of $5.50 \%(30.03-31.74 \text{GHz})$, $3.02 \%(32.65-33.70 \text{GHz}), 5.00 \%(35.64-37.47 \text{GHz})$, and $3.17 \% (38.75-40.00 \text{GHz})$, respectively. Directional radiation patterns are observed across all bands, with side lobes merging into the main lobe as frequency increases. The SIW-based design ensures low insertion loss, compact form factor, and enhanced radiation efficiency. The reflection coefficient remains below -10 dB over all operational bands, indicating good impedance matching. Due to its planar structure, stable multiband performance, and suitability for mass production, the antenna is well-suited for next-generation mmWave communication and sensing applications.},
  keywords={Microwave antennas;Slot antennas;5G mobile communication;Impedance matching;Resonant frequency;Millimeter wave communication;Ka-band;Substrates;Next generation networking;Antenna radiation patterns;Multiband antenna;substrate integrated waveguide (SIW);monopole antenna;Ka-band;5G FR2;millimeter-wave (mmWave)},
  doi={10.1109/MAPCON65020.2025.11426413},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9054354,
  author={Wijnings, Patrick W.A. and Stuijk, Sander and de Vries, Bert and Corporaal, Henk},
  booktitle={ICASSP 2020 - 2020 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Approximate Inference by Kullback-Leibler Tensor Belief Propagation}, 
  year={2020},
  volume={},
  number={},
  pages={5850-5854},
  abstract={Probabilistic programming provides a structured approach to signal processing algorithm design. The design task is formulated as a generative model, and the algorithm is derived through automatic inference. Efficient inference is a major challenge; e.g., the Shafer-Shenoy algorithm (SS) performs badly on models with large treewidth, which arise from various real-world problems. We focus on reducing the size of discrete models with large treewidth by storing intermediate factors in compressed form, thereby decoupling the variables through conditioning on introduced weights. This work proposes pruning of these weights using Kullback-Leibler divergence. We adapt a strategy from the Gaussian mixture reduction literature, leading to Kullback-Leibler Tensor Belief Propagation (KL-TBP), in which we use agglomerative hierarchical clustering to subsequently merge pairs of weights. Experiments using benchmark problems show KL-TBP consistently achieves lower approximation error than existing methods with competitive runtime.},
  keywords={Adaptation models;Tensors;Signal processing algorithms;Inference algorithms;Task analysis;Standards;Belief propagation;Bayes methods;Tensors;Dimensionality reduction;Approximation algorithms},
  doi={10.1109/ICASSP40776.2020.9054354},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11032885,
  author={S, Mohandass and R, Akilan and M, Gowsic P and E, Madhuleika and J, Shirin Shiffra},
  booktitle={2025 International Conference on Computational Innovations and Engineering Sustainability (ICCIES)}, 
  title={CNN-Based Classification of Cardiovascular Disease: A Hyperparameter Optimization and Dimensionality Reduction Approach}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This work presents a comprehensive two-stage model that integrates structured clinical datasets and electrocardiogram (ECG) data to predict Cardiovascular disease (CVD) with greater precision. The first stage employs classical ML methods, utilizing a Random Forest algorithm on merged and pruned clinical datasets, including Framingham and Statlog, to derive initial predictions. The second stage refines these predictions using a Convolutional Neural Network (CNN) trained on ECG image data, enabling deeper insights and improved classification performance. The model was developed on the Jupyter Notebook platform using Python, leveraging libraries such as TensorFlow, Keras, Scikit-learn, and Pandas. Preprocessing involves converting ECG images into 1D signals, followed by dimensionality reduction. Techniques like Principal Component Analysis (PCA) and Linear Discriminant Analysis (LDA) are used for dimensionality reduction. These techniques streamlined the feature set, retaining only the most discriminative information and enhancing model efficiency. Hyperparameter optimization for the CNN was performed using GridSearchCV, fine-tuning key parameters such as filters, activation functions, batch size, and epochs to maximize performance. By integrating clinical and ECG data through a multi-layered approach, this study demonstrates the potential for an advanced, highly accurate model for CVD prediction. The results underline the effectiveness of combining traditional ML techniques with DL-based analysis for holistic and robust healthcare solutions.},
  keywords={Dimensionality reduction;Accuracy;Medical services;Electrocardiography;Predictive models;Hyperparameter optimization;Data models;Convolutional neural networks;Cardiovascular diseases;Principal component analysis},
  doi={10.1109/ICCIES63851.2025.11032885},
  ISSN={},
  month={April},}@INPROCEEDINGS{11308524,
  author={Siddharth, Dangeti and Sariki, Tulasi Prasad},
  booktitle={2025 International Conference on Sustainable Communication Networks and Application (ICSCN)}, 
  title={Fusion-based Multimodal Deep Learning for E-commerce Product Attribute Classification}, 
  year={2025},
  volume={},
  number={},
  pages={1268-1273},
  abstract={Product catalog organization has grown to be a significant difficulty due to the quick expansion of online marketplaces. In addition to providing accurate search results, trustworthy categorization is also necessary to support recommendation engines and enhance the general purchasing experience. We present a multimodal deep learning approach, in this study that uses a fusion-based model to merge structured attribute information with product images. To handle noisy and incomplete metadata, we apply preprocessing steps such as one-hot encoding and class balancing, while convolutional neural networks (CNNs) are used to extract rich visual features. Our experiments show that the fusion model consistently outperforms image-only and attribute-only baselines, reaching 84.2% ± 2.1 test accuracy and a macro F1-score of 0.87 across five folds. Techniques like dropout, batch normalization, and data augmentation helped the model generalize better and avoid overfitting. Overall, the results demonstrate that combining multiple modalities improves both accuracy and fairness across imbalanced categories, making the method well suited for large-scale e-commerce catalog management.},
  keywords={Visualization;Accuracy;Pipelines;Feature extraction;Transformers;Robustness;Real-time systems;Electronic commerce;Convolutional neural networks;Batch normalization;Product Attribute Classification;E-commerce;Multimodal Deep Learning;Fusion-Based Model;Convolutional Neural Networks;Catalog Management;Class Balancing;Accuracy},
  doi={10.1109/ICSCN67106.2025.11308524},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10442483,
  author={Lee, Kyoungmin and Choi, Stellar and Joo, Siheon and Jung, Haeun and Bae, Seonggeon},
  booktitle={2023 International Conference on Electrical, Communication and Computer Engineering (ICECCE)}, 
  title={A Study on High-Quality Style Transfer Using Edge-Enhanced Gaussian Smoothing Technique(EEGST) for Minimizing Perceptual Loss}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Recent advancements in image generation technologies, particularly those involving style transfer, have garnered significant attention. Style transfer involves merging the characteristics of one stylistic image with the content of another to produce a novel image. Most image generation techniques, including style transfer, heavily rely on neural networks. However, the use of neural networks, particularly during processes such as up-sampling, can introduce artifacts. This paper proposes a method to mitigate artifacts in models utilizing neural networks, specifically focusing on the style transfer model proposed in "Perceptual Losses for Real-Time Style Transfer and SuperResolution" [5]. The mentioned model exhibits advantages in terms of speed but suffers from checkerboard artifacts or similar issues. The proposed approach effectively addresses these concerns, reducing artifacts while preserving the overall form of the image. The method involves combining Gaussian smoothing to handle artifacts introduced by neural networks while ensuring the preservation of edges. The simplicity and versatility of the proposed method make it applicable to various models. This paper presents a method to reduce artifacts in neural networkbased models, with a particular focus on the style transfer model benchmarked against "Perceptual Losses for Real-Time Style Transfer and Super-Resolution." The proposed approach proves effective in maintaining image structure while mitigating artifacts, showcasing its potential applicability across different models.},
  keywords={Smoothing methods;Image synthesis;Image edge detection;Neural networks;Superresolution;Transforms;Real-time systems;Style Transfer;Perceptual Loss;Checkerboard Artifacts;Deconvolution;Gaussian Smoothing},
  doi={10.1109/ICECCE61019.2023.10442483},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10809197,
  author={Quan-Wei, Ding and Qing, Huang and Jia-Heng, Feng},
  booktitle={2024 7th International Conference on Mechatronics, Robotics and Automation (ICMRA)}, 
  title={U3D-BCD Network Based on Weak Supervision Learning: An Algorithm for Accurate Segmentation of Dense 3D Microscopic Optical Neurons}, 
  year={2024},
  volume={},
  number={},
  pages={142-146},
  abstract={Accurately segmenting 3D optical micro-neurons is crucial for a deep understanding of neural structure and function, investigating disease mechanisms, and fostering innovation in neuroscience. Currently, accurate segmentation of 3D neuronal cells faces two major challenges. One is the difficulty in obtaining 3D labels for training deep learning models. The other is the poor segmentation performance for images with low signal-to-noise ratio and densely packed cells with adhesion. This article proposes a weakly supervised learning-based U3D-BCD network for dense 3D optical micro-neuron segmentation, aiming to address these two challenges. Firstly, to tackle the issue of difficult 3D label acquisition, we use the Cellpose algorithm to automatically label 2D slice cells, then optimize the labeling results using morphological algorithms, requiring manual correction of only a small number of mislabeled regions, and finally merge the 2D slice results to form pseudo labels for 3D segmentation. As for the problem of inaccurate segmentation of low signal-to-noise ratio and densely adherent cells, we employ a U3D-BCD multitask learning model with a fusion residual attention mechanism for segmentation. The introduction of attention mechanism in residual blocks improves segmentation results. The model simultaneously learns the foreground mask, instance contour, and distance transform of neural nuclei, and integrates the predictions of three types of maps, combined with post-processing algorithms like 3D watershed, to achieve segmentation of dense signals. Test results on the 3D fMOST dataset demonstrate that the algorithm in this article achieves manual identification accuracy (Recall 97%, Precision 95%, F1 96%), outperforming most current algorithms and obtaining good segmentation results on low signal-to-noise ratio dense cell images.},
  keywords={Image segmentation;Solid modeling;Three-dimensional displays;Accuracy;Weak supervision;Watersheds;Prediction algorithms;Optical imaging;Adaptive optics;Signal to noise ratio;3D neuron recognition;watershed;deep learning;weak supervision},
  doi={10.1109/ICMRA62519.2024.10809197},
  ISSN={2996-380X},
  month={Sep.},}@INPROCEEDINGS{9105164,
  author={},
  booktitle={2019 IEEE 19th International Symposium on Computational Intelligence and Informatics and 7th IEEE International Conference on Recent Achievements in Mechatronics, Automation, Computer Sciences and Robotics (CINTI-MACRo)}, 
  title={Data Analytics for Health-Care Risk Predictions based on Ensemble Classifiers and Subjective Projection: PLENARY TALK}, 
  year={2019},
  volume={},
  number={},
  pages={000011-000012},
  abstract={Discovering patterns from big data attracts a lot of attention due to its importance in discovering accurate patterns and features that are used in predictions of decision making in health care. The challenges in big data analytics are the high dimensionality and complexity in data representation. Granular computing and feature selection are among the challenge to deal with big data analytics that is used for Decision making. We will discuss these challenges in this talk and provide new projection on ensemble learning for health care risk prediction. In decision making most approaches are taking into account objective criteria, however the subjective correlation among different ensembles provided as preference utility is necessary to be presented to provide confidence preference additive among it reducing ambiguity and produce better utility preferences measurement for good quality predictions. Most models in Decision support systems are assuming criteria as independent. Different type of data (time series, linguistic values, interval data, etc.) imposes some difficulties to data analytics due to preprocessing and normalization processes which are expensive and difficult when data sets are raw and imbalanced. We will highlight these issues though project applied to health-care for elderly, by merging heterogeneous metrics for providing health care predictions for elderly at home. We have utilized ensemble learning as multi-classification techniques on multi-data streams that collected from multi-sensing devices. Subjectivity (i.e., service personalization) would be examined based on correlations between different contextual structures that are reflecting the framework of personal context, for example in nearest neighbor based correlation analysis fashion. Some of the attributes incompleteness also may lead to affect the approximation accuracy. Attributes with preference-ordered domain relations properties become one aspect in ordering properties in rough approximations. We outline issues on Virtual Doctor Systems, and highlights its innovation in interactions with elderly patients, also discuss these challenges in granular computing and decision support systems research domains. In this talk I will present the current state of art and focus it on health care risk analysis with examples from our experiments.},
  keywords={},
  doi={10.1109/CINTI-MACRo49179.2019.9105164},
  ISSN={2471-9269},
  month={Nov},}@INPROCEEDINGS{11102146,
  author={Cheng, Xi},
  booktitle={2025 6th International Conference on Computer Engineering and Application (ICCEA)}, 
  title={A Three-Stage Feature Selection Method Based on Particle Swarm Optimization with Dynamic Granularity Clustering}, 
  year={2025},
  volume={},
  number={},
  pages={01-04},
  abstract={Multi-stage feature selection methods have attracted increasing attention due to the ability to integrate the advantages of filtering, clustering, and evolutionary algorithms. However, existing methods still face several challenges. Firstly, most feature clustering approaches require computing mutual information between features, which causes high computational cost. Secondly, fixed clustering granularity fails to adapt feature group structures based on performance feedback during the optimization process, which reduces search efficiency. To address these issues, a three-stage feature selection method based on particle swarm optimization with dynamic granularity clustering (DGCPSO-FS) is proposed. First, ReliefF, Maximal Information Coefficient, and Kullback-Leibler divergence are combined to filter out irrelevant features. Then, instead of relying on mutual information between features, relevant features are grouped based on their importance differences. Finally, a novel particle swarm optimization algorithm with dynamic granularity clustering is proposed. It removes low-quality features from poorly-performing feature groups and merges these groups with the most similar high-performing ones. The experimental results show that DGCPSO-FS could achieve better classification accuracy with a lower computational overhead compared to state-of-the-art FS algorithms on highdimensional datasets.},
  keywords={Accuracy;Heuristic algorithms;Clustering algorithms;Feature extraction;Classification algorithms;Computational efficiency;Reliability;Particle swarm optimization;Mutual information;Optimization;feature selection;particle swarm optimization;dynamic granularity;high-dimensional data},
  doi={10.1109/ICCEA65460.2025.11102146},
  ISSN={2159-1288},
  month={April},}@INPROCEEDINGS{8973533,
  author={Pandzic, Kristina and Pandzic, Hrvoje and Kuzle, Igor},
  booktitle={2019 IEEE Power & Energy Society General Meeting (PESGM)}, 
  title={Coordination of Regulated and Merchant Energy Storage Investments}, 
  year={2019},
  volume={},
  number={},
  pages={1-1},
  abstract={Distributed transmission-scale energy storage is becoming economically feasible due to the growing share of renewable generation and cost reduction of specific storage technologies, primarily batteries. Under these circumstances, independent merchants may start investing in storage facilities. On the other hand, system operators, besides investing in transmission lines, may, under certain conditions, invest in storage units as well. This paper formulates a trilevel model where the upper-level problem optimizes the system operator's transmission line and energy storage investments, the middle-level problem determines merchant energy storage investment decisions, while the lower level problem simulates market clearing process for representative days. After replacing the lower level problem with its primal dual equivalent conditions, the middle- and lower level problems are merged into a mixed-integer problem with equilibrium constraints. The resulting bilevel structure is iteratively solved using a cutting plane algorithm. The proposed formulation is first applied to a six-bus system to present the mechanics of the model and then to the IEEE RTS-96 test system. The results show that even at the low cost of energy storage, the system operator (SO) still prefers line investments, while merchant investments are driven by the volatility of LMPs. Both the SO and merchant investments increase the social welfare, although this increase is mostly driven by the SO investments.},
  keywords={Hands;Renewable energy sources;Power transmission lines;Costs;Batteries;Investment},
  doi={10.1109/PESGM40551.2019.8973533},
  ISSN={1944-9933},
  month={Aug},}@INPROCEEDINGS{10995192,
  author={Krishnamoorthy, Barkavi and Krishnasamy, Vijayakumar},
  booktitle={2024 IEEE 11th Power India International Conference (PIICON)}, 
  title={Design of buck boost converter using single switch and positive output voltage for electric vehicle applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Quadratic boost converter plus a D2LC structure merges to give a unprecedented topology of a buck boost converter is proposed in this article. The topology is benefited with the following features. A single switch with continuous input current and can deliver non-inverting output voltage to the load. Higher voltage gain combined with larger effectiveness index is obtained. The blocking voltage across the switch is low. Only less number of elements are used. All these combined makes the topology aspiring for fuel cell vehicle applications. In steady state converter is analyzed in continuous conduction mode (CCM). Simulation is done in MATLAB environment and verified against theoretical values. Suitability of the topology proposed is elaborated in detail for electric vehicle applications.},
  keywords={Simulation;Capacitors;Voltage;Switches;Fuel cell vehicles;Topology;Steady-state;Indexes;Inductors;Stress;buck boost converter;higher voltage gain;one switch;fuel cell},
  doi={10.1109/PIICON63519.2024.10995192},
  ISSN={2642-5289},
  month={Dec},}@INPROCEEDINGS{9095678,
  author={Li, Guangrong and Cao, Yuanguo and Bao, Yongqiang and Chen, Haofeng and Zhao, Sufang},
  booktitle={2020 IEEE 5th International Conference on Cloud Computing and Big Data Analytics (ICCCBDA)}, 
  title={Design and Research of Analog Data Pool of Intelligent Manufacturing Oriented to Impeller}, 
  year={2020},
  volume={},
  number={},
  pages={561-565},
  abstract={Impeller data is investigated and understood including the data information content, data type and characteristics in the process of intelligent manufacturing of enterprises. The data information of the whole life cycle of impeller is the research object. The characteristics and functions of data pool are analyzed based on the analysis of data Lake structure. It is analyzed and designed of the big data analog data pool of intelligent manufacturing for impeller. And the framework of the data pool is constructed for impeller. It is achieved of the design requirements of big data analog data pool processing system by Hadoop, Java, MapReduce and other components. They are processed for data merging, data sorting, data extraction and other functions. A lot of data is analyzed and extracted more clearly in the process of impeller intelligent manufacturing, which achieve the purpose of data processing. The establishment of analog data pool not only plays an important role in the research of data storage and processing, but also plays an important role in improving the efficiency of intelligent manufacturing industry.},
  keywords={Impellers;Data mining;Inspection;Big Data;impeller;intelligent manufacturing;analog data pool;data processing},
  doi={10.1109/ICCCBDA49378.2020.9095678},
  ISSN={},
  month={April},}@INBOOK{9822598,
  author={Ghlala, Riadh},
  booktitle={Analytic SQL in SQL Server 2014/2016}, 
  title={Operators}, 
  year={2019},
  volume={},
  number={},
  pages={65-86},
  abstract={This chapter presents the operators for transposing data between the rows and columns of a table to simulate the pivot operator applicable to multidimensional data stored in cubes. Joining in relational databases means extracting data from multiple linked tables. The data to be searched is distributed over several tables to comply with the normalization rules of the relational model. The JOIN operator reflects considerable processing by the DBMS to improve performance. These efforts are materialized by three optimization algorithms which are NESTED LOOP, MERGE SORT and HASH. These concepts fall within the theme of Structured Query Language (SQL) query performance generally referred to as SQL Tuning. The set operations, which are UNION, INTERSECT, EXCEPT, CROSS JOIN and division, allow tables to be treated as sets. The operators used, although not standardized, exist in most database management systems under different names. Pivoting operators, also known as Rotation Operators, are new features integrated into the relational model.},
  keywords={Image color analysis;Servers;Standards;Data mining;Tuning;Technological innovation;Semantics},
  doi={10.1002/9781119649540.ch3},
  ISSN={},
  publisher={Wiley},
  isbn={9781119649274},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/9822598},}@INPROCEEDINGS{11257969,
  author={Mangara, Bernard Tonderayi},
  booktitle={2025 International Conference on Electrical, Communication and Computer Engineering (ICECCE)}, 
  title={Optimal Assignment of Interchangeable Components in Multi-State Network Systems for Enhanced Reliability and QoS}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Complex networks consisting of communications, transportation and power grids have components that operate at different performance levels rather than being either on or off. This study uses multi-state components to achieve maximum performance while optimizing network dependability and quality of service (QoS). The main contribution is an integrated and practical structure that merges UI/CUI guided rules, with validation for optimal component allocation, in multi-state network systems. It also incorporates analysis and a replicable MATLAB execution to facilitate adoption, by practitioners. We introduce two utility metrics which assess individual component effects and their combined effects under different load or failure conditions through Utility Importance (UI) and Conditional Utility Importance (CUI). The heuristic uses UI/CUI-based criteria to perform an initial ranking of components before a comprehensive search begins. The verification of our methodology occurs through examination of a five-component “bridge” network which contains three states per element (0= failed, 0.5= degraded, and 1= functioning). A MATLAB script performs the following steps: 1) it counts all $5!=120$ component-to-label permutations; 2) it calculates joint state probabilities for all $3^{\wedge} 5$ combinations; 3) it assesses system performance using maximum flow across four parallel paths; and 4) it determines the best / worst assignments and an expected performance metric. The exhaustive search produces 0.78855 which represents a 7.7% improvement over random selection and a 3.8% increase above the UI/CUI heuristic while the UI/CUI heuristic results in a 3.7% improvement from 0.73220 (random baseline) to 0.75950. The article also discusses scalability to larger networks using symmetrical exploitation and importance-based pruning to control combinatorial expansion and provides visual analytics tools for evaluating assignments. We end with recommendations for integrating multi-state component allocation into reliabilitycentered maintenance, cost-benefit analysis, and future research on dynamic reconfiguration under time-varying loads.},
  keywords={Bridges;Computer network reliability;Visual analytics;Scalability;Metaheuristics;Quality of service;Reliability engineering;Resource management;MATLAB;Network systems;multi-state systems;Component utility importance (UI);Conditional utility importance (CUI);Heuristic swapping algorithm;Exhaustive enumeration;Bridge network topology;Reliability optimization;Visual analytics},
  doi={10.1109/ICECCE67514.2025.11257969},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11019332,
  author={Jiang, Yinwen and Ye, Tangwei},
  booktitle={2025 8th International Conference on Advanced Algorithms and Control Engineering (ICAACE)}, 
  title={Multi-Task Road Extraction Leveraging Hybrid Global-Local Modeling: A Transformer-CNN Approach}, 
  year={2025},
  volume={},
  number={},
  pages={1261-1265},
  abstract={Accurate road network extraction is essential for urban applications such as navigation and urban planning. Traditional methods relying on clustering or trace-merging often struggle with noisy GPS data and low sampling rates, while convolutional neural networks (CNNs) are limited by their inability to model global contexts. Transformers, on the other hand, excel at capturing long-range dependencies but suffer from high computational complexity. To address these challenges, we propose a hybrid framework that combines CNNs and Transformers to leverage their respective strengths. The framework features a Hybrid Attention Block (HAB) to efficiently integrate global and local contexts, enhancing the model's ability to handle complex road structures. Additionally, we introduce a multitask learning strategy, where road centerline extraction is the primary task, and road region segmentation acts as an auxiliary task to improve prediction accuracy.},
  keywords={Accuracy;Roads;Computational modeling;Urban planning;Transformers;Data models;Trajectory;Convolutional neural networks;Noise measurement;Context modeling;component;trajectory;road extraction;map},
  doi={10.1109/ICAACE65325.2025.11019332},
  ISSN={},
  month={March},}@INPROCEEDINGS{9060075,
  author={Li, Sui and Zhu, Manman and Li, Danyang and Gao, Qi and Bian, Zhaoying and Zeng, Dong and Ma, Jianhua},
  booktitle={2019 IEEE Nuclear Science Symposium and Medical Imaging Conference (NSS/MIC)}, 
  title={Task-driven Deep Learning Network for Dynamic Cerebral Perfusion Computed Tomography Protocol Determination}, 
  year={2019},
  volume={},
  number={},
  pages={1-3},
  abstract={Dynamic cerebral perfusion computed tomography (DCPCT) imaging has the ability to detect ischemic stroke via hemodynamic maps. However, due to multiple acquisitions protocol, DCPCT scanning imposes high radiation doses on patients and might increase their potential cancer risks. The DCPCT protocol that decreases DCPCT samples by increasing sampling intervals can greatly reduce radiation dose, but this may introduce bias in the hemodynamic maps estimation, affecting the diagnosis. To address this issue, in this study, we present a deep learning network to determine the DCPCT protocol to realize the dose-reduction task, i.e., decreasing DCPCT samples, and the diagnosis-quality task, i.e., improve hemodynamic maps accuracy. Specifically, one interpolation convolutional neural network is fully designed to estimate the DCPCT images at the sampling interval, termed as dynamic cerebral perfusion interpolation network (DCPIN). The present network treats the DCPCT measurements as a "video" to characterize the maximum temporal coherence of spatial structure among phases, and interpolates a frame at any arbitrary time step between any two frames. First, a flow computation network is used to estimate the bi-directional optical flow between two input DCPCT frames by linearly fusing to approximate the required intermediate optical flow. Second, another flow interpolation network is designed to refine the flow approximations and predict soft visibility maps. Finally, the estimated flow approximations and visibility maps are merged together to jointly predict the intermediate DCPCT frame. Experimental results on patient data clearly demonstrate that the present DCPIN can achieve promising reconstruction performance, i.e., high-quality DCPCT images and high-accuracy hemodynamic maps.},
  keywords={Computed tomography;Interpolation;Hemodynamics;Protocols;Optical flow;Image reconstruction;Biomedical imaging},
  doi={10.1109/NSS/MIC42101.2019.9060075},
  ISSN={2577-0829},
  month={Oct},}@INPROCEEDINGS{9671433,
  author={Banesh, Divya and Klein, Natalie and Morley, Steven and Biswas, Ayan and Jordanova, Vania and Henderson, Michael and Lawrence, Earl},
  booktitle={2021 IEEE International Conference on Big Data (Big Data)}, 
  title={Topological Segmentation and Tracking for Space Weather Modeling}, 
  year={2021},
  volume={},
  number={},
  pages={3784-3788},
  abstract={The segmentation and temporal tracking of fast flow structures called bursty bulk flows is an integral part of space weather study. This paper presents the first known topological segmentation and tracking technique to analyze bursty bulk flows. We apply contour tree-based segmentation to identify regions of high plasma velocity from data output from space weather simulations. We then employ a Kuhn-Munkers assignment algorithm with a modified Wasserstein metric to match features in adjacent time steps. A newly implemented algorithm to determine splits and merges of segments results in a fully topological framework for feature detection and tracking of fast flow channels.},
  keywords={Measurement;Feature detection;Conferences;Big Data;Data models;Plasmas;Meteorology;space weather;bursty bulk flow;contour tree},
  doi={10.1109/BigData52589.2021.9671433},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10960841,
  author={Kuntal, Heena and Siddiqui, Ebtasam Ahmad},
  booktitle={2024 First International Conference on Data, Computation and Communication (ICDCC)}, 
  title={Classification of Brain Tumours in Medical Images Through the Application of Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={744-750},
  abstract={Early detection of brain tumors is crucial, yet existing segmentation methods have not yielded satisfactory results. Brain tumors are deadlier than many other cancers, primarily because their complex structures often merge with normal tissues, complicating classification. This study explores machine learning techniques to classify brain tumors—specifically Glioma, Meningioma, and Pituitary tumors—using an MRI scan dataset. We employ convolutional neural networks (CNNs) and ensemble approaches, integrating advanced pre-processing, feature extraction, and model optimization for improved accuracy. Our models achieve state-of-the-art precision, recall, and F1 scores, outperforming traditional methods. Future work will expand the dataset and incorporate multimodal imaging and federated learning to improve generalization and privacy.},
  keywords={Support vector machines;Training;Accuracy;Magnetic resonance imaging;Brain tumors;Nearest neighbor methods;Brain modeling;Convolutional neural networks;Reliability;Medical diagnostic imaging;Machine Learning;Artificial Intelligence;Brain Tumour;Convolutional Neural Network;Magnetic Resource Imaging},
  doi={10.1109/ICDCC62744.2024.10960841},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9993557,
  author={Itoi, Kiyoaki and Nakabayashi, Hiroaki},
  booktitle={2022 IEEE International Workshop on Electromagnetics: Applications and Student Innovation Competition (iWEM)}, 
  title={Basic Study of Map Image Processing for Simple Path Loss Prediction Using CNN}, 
  year={2022},
  volume={},
  number={},
  pages={164-165},
  abstract={Many models have been proposed for path loss in mobile communications. Conventionally, multiple regression analysis and theoretical formulas have been used, but in recent years, methods using machine learning have been proposed to solve these problems. We analyzed the parameters of the conventional typical propagation model and proposed to effectively merge the conventional models to predict the path loss by machine learning before. The prediction accuracy for Narashino-shi by proposed method is 4.39 dB in root mean square error (RMSE). In this report, we propose a prediction method using convolutional neural network (CNN) with only image input. For the purpose, we examined the structure of the map image input to CNN and the initial value of CNN training. The prediction accuracy 4.09 dB in RMSE was obtained.},
  keywords={Training;Analytical models;Technological innovation;Urban areas;Machine learning;Predictive models;Feature extraction;path loss prediction;propagation model;machine learning;convolutional neural network},
  doi={10.1109/iWEM52897.2022.9993557},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{9377934,
  author={Tatis, David and Sierra, Heidy and Arzuaga, Emmanuel},
  booktitle={2020 IEEE International Conference on Big Data (Big Data)}, 
  title={Residual Neural Network Architectures to Improve Prediction Accuracy of Properties of Materials}, 
  year={2020},
  volume={},
  number={},
  pages={2915-2918},
  abstract={Properties in material composition and crystal structures have been explored by density functional theory (DFT) calculations, using databases such as the Open Quantum Materials Database (OQMD). Databases like these have been used currently for the training of advanced machine learning and deep neural network models, the latter providing higher performance when predicting properties of materials. However, current alternatives have shown a deterioration in accuracy when increasing the number of layers in their architecture (over-fitting problem). As an alternative method to address this problem, we have implemented residual neural network architectures based on Merge and Run Networks, IRNet and UNet to improve performance while relaxing the observed network depth limitation. The evaluation of the proposed architectures include a 9:1 ratio to train and test as well as 10 fold cross validation. In the experiments we found that our proposed architectures based on IRNet and UNet are able to obtain a lower Mean Absolute Error (MAE) than current strategies. The full implementation (Python, Tensorflow and Keras) and the trained networks will be available online for community validation and advancing the state of the art from our findings.},
  keywords={Training;Databases;Neural networks;Computer architecture;Big Data;Predictive models;Residual neural networks;material properties;elemental compositions;residual neural networks},
  doi={10.1109/BigData50022.2020.9377934},
  ISSN={},
  month={Dec},}@ARTICLE{10084834,
  author={Mandhai, S and Lamb, G P and Tanvir, N R and Bray, J and Nixon, C J and Eyles-Ferris, R A J and Levan, A J and Gompertz, B P},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Exploring compact binary merger host galaxies and environments with zELDA}, 
  year={2022},
  volume={514},
  number={2},
  pages={2716-2735},
  abstract={Compact binaries such as double neutron stars or a neutron star paired with a black hole, are strong sources of gravitational waves during coalescence and also the likely progenitors of various electromagnetic phenomena, notably short-duration gamma-ray bursts (SGRBs), and kilonovae. In this work, we generate populations of synthetic binaries and place them in galaxies from the large-scale hydrodynamical galaxy evolution simulation, EAGLE. With our ZELDA code, binaries are seeded in proportion to star formation rate, and we follow their evolution to merger using both the BPASS and COSMIC binary stellar evolution codes. We track their dynamical evolution within their host galaxy potential, to estimate the galactocentric distance at the time of the merger. Finally, we apply observational selection criteria to allow comparison of this model population with the legacy sample of SGRBs. We find a reasonable agreement with the redshift distribution (peaking at 0.5 < z < 1), host morphologies, and projected galactocentric offsets (modal impact parameter ≲10 kpc). Depending on the binary simulation used, we predict $\sim 16\!-\!35{{\ \rm per\ cent}}$ of SGRB events would appear ‘host-less’, i.e. sources that merge with high impact parameters or have hosts fainter than the detection limit (H > 26).},
  keywords={transients: gamma-ray bursts;transients: neutron star mergers;transient: black hole - neutron star mergers;galaxies: general;stars: kinematics and dynamics;binaries: close},
  doi={10.1093/mnras/stac1473},
  ISSN={1365-2966},
  month={Feb},}@INPROCEEDINGS{10337589,
  author={Fkih, Hèdi and Kallel, Abdelaziz and Chtourou, Zied},
  booktitle={2023 International Conference on Cyberworlds (CW)}, 
  title={Super-Resolution of UAVs Thermal Images Guided by Visible Images}, 
  year={2023},
  volume={},
  number={},
  pages={40-45},
  abstract={Thermal imaging of unmanned aerial vehicles (UAVs) can sometimes suffer from a lack of information due to their small sizes. Therefore, the ability to understand and analyze such images of drones will be limited. Nevertheless, high-resolution (HR) visible images are often available and could be useful for improving the resolution of thermal images from UAVs. In recent years, Deep learning has been increasingly used in several computer vision tasks such as super-resolution (SR), where it has shown promising results for image resolution enhancement as it allows for creating high-quality detailed images. In this paper, we propose a Guidance Super-Resolution Network (GSRNet), that improves the spatial resolution of thermal UAVs images by taking advantage of the textures of the visible images. We adapt a Convolutional Neural Network (CNN) model that has an encoder-decoder architecture to translate visible images into thermal images as well as an auto-attention mechanism to allow the network to selectively focus on relevant structures of the image while ignoring irrelevant parts. Moreover, to preserve the low frequency information such as the brightness level and the body that are present in the low-resolution (LR) thermal image, we propose to merge the letter image with the translated one, such that the obtained HR thermal image when downsampled it equals the original LR one. Experimental results on the custom UAVs image dataset prove the higher performance of the proposed model on both qualitative and quantitative evaluations when compared to several state-of-the-art (SOTA) methods.},
  keywords={Surveillance;Superresolution;Imaging;Computer architecture;Feature extraction;Probabilistic logic;Convolutional neural networks;UAVs;Thermal Image;Super-Resolution;Image Translation;U-Net Architecture;Self-Attention},
  doi={10.1109/CW58918.2023.00016},
  ISSN={2642-3596},
  month={Oct},}@INPROCEEDINGS{10932616,
