  month={},}@INPROCEEDINGS{9044000,
  author={Zhang, Dongxu and Weng, Zhenyu and Zhang, Ya and Dai, Haozheng and Wu, Jiageng and Min, Xiaoping and Ge, Shengxiang},
  booktitle={2019 IEEE International Conference on Real-time Computing and Robotics (RCAR)}, 
  title={A hot embossing robot for bonding microfluidic chips: design, control and test}, 
  year={2019},
  volume={},
  number={},
  pages={679-684},
  abstract={The microfluidic technology proposed in recent years has been applied in many fields because of its advantages, such as integration, automation, miniaturization and low cost. Microfluidic chips, which are a realization way for the microfluidic technology, have become a research hotspot and their manufacturing process is studied thoroughly. Bonding is a key step that used for sealing a chip in the manufacturing process, and the bonding quality determines whether the chip can be used in practice. This study developed a hot embossing robot for bonding microfluidic chips: first, the mechanical structure of the robot was designed according to the physical characteristics of microfluidic chips and requirements of the hot embossing process; second, an intelligent temperature control method was established to predict and self-adaptively adjust the operating temperature; at last, multilevel experiments merging engineering and biology were designed and performed. The results showed the great and stabilized bonding effect, and proved the validity and practicability of this hot embossing robot.},
  keywords={Robots;Embossing;Temperature control;Substrates;Bonding;Microfluidics},
  doi={10.1109/RCAR47638.2019.9044000},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{9861805,
  author={Latif, Ehsan and Parasuraman, Ramviyas},
  booktitle={ISR Europe 2022; 54th International Symposium on Robotics}, 
  title={Multi-Robot Synergistic Localization in Dynamic Environments}, 
  year={2022},
  volume={},
  number={},
  pages={1-8},
  abstract={A mobile robot’s precise location information is critical for navigation and task processing, especially for a multi-robot system (MRS) to collaborate and collect valuable data from the field. However, a robot in situations where it does not have access to GPS signals, such as in an environmentally controlled, indoor, or underground environment, finds it difficult to locate using its sensor alone. As a result, robots sharing their local information to improve their localization estimates benefit the entire MRS team. There have been several attempts to model-based multi-robot localization using Radio Signal Strength Indicator (RSSI) as a source to calculate bearing information. We also utilize the RSSI for wireless networks generated through the communication of multiple robots in a system and aim to localize agents with high accuracy and efficiency in a dynamic environment for shared information fusion to refine the localization estimation. This estimator structure reduces one source of measurement correlation while appropriately incorporating others. This paper proposes a decentralized Multi-robot Synergistic Localization System (MRSL) for a dense and dynamic environment. Robots update their position estimation whenever new information receives from their neighbors. When the system senses the presence of other robots in the region, it exchanges position estimates and merges the received data to improve its localization accuracy. Our approach uses Bayesian rule-based integration, which has shown to be computationally efficient and applicable to asynchronous robotics communication. We have performed extensive simulation experiments with a varying number of robots to analyze the algorithm. MRSL’s localization accuracy with RSSI outperformed others on any number of robots, 66% higher than autonomous robot localization (ARL) (which works without collaboration between robots) and 32% higher than the collaborative multi-robot algorithm from the literature. Nevertheless, simulation results have shown significant promise in localization accuracy for many collaborating robots in a dynamic environment.},
  keywords={},
  doi={},
  ISSN={},
  month={June},}@INPROCEEDINGS{10499593,
  author={Vera, Maria Concepcion S.},
  booktitle={2024 International Conference on Advances in Computing, Communication, Electrical, and Smart Systems (iCACCESS)}, 
  title={Blueprinting User-Centric Design for Developing Herbal Plant Location-Based Recommendation System Applying TOGAF ADM and Agile Sprints}, 
  year={2024},
  volume={},
  number={},
  pages={01-06},
  abstract={This study presents “MedPlantFinder,” a pioneering mobile application developed through a unique integration of The Open Group Architecture Framework (TOGAF) Architecture Development Method (ADM) and Agile methodologies, termed “TOGAF-ADM+Agile.” This design approach enables the app to offer personalized medicinal plant recommendations, leveraging machine learning for tailored healthcare advice and incorporating geospatial data to provide location-specific plant suggestions. The application stands out for its ability to deliver detailed navigational maps and preparation instructions for various medicinal plants, addressing specific health conditions of users. By combining TOGAF ADM's structured framework with Agile's flexibility and iterative nature, MedPlantFinder achieves a responsive and scalable architecture. This methodical fusion significantly enhances data management, optimizes recommendation algorithms, and ensures precise alignment with user feedback and health requirements. The app is a step forward in digital healthcare, designed to lower healthcare expenses and promote natural treatments by merging traditional medicine with modern technology for personalized health solutions.},
  keywords={Navigation;Scalability;Standards organizations;Systems architecture;Medical services;Organizations;Mobile applications;Agile;architecture framework;location-based;mobile application recommendation system;medicinal plants;TOGAF ADM},
  doi={10.1109/iCACCESS61735.2024.10499593},
  ISSN={},
  month={March},}@INPROCEEDINGS{11211776,
  author={Singh, Gurbhej and Sharma, Geetika and Mittal, Anupam},
  booktitle={2025 International Conference on Engineering Innovations and Technologies (ICoEIT)}, 
  title={Multi-Scale CNN-Based Lung Cancer Classification: Integrating Deep Learning, Texture Analysis, Bayesian Optimization and Ensemble Learning for Enhanced Diagnostic Accuracy}, 
  year={2025},
  volume={},
  number={},
  pages={272-278},
  abstract={A proper classification system of lung cancer stands vital for early-stage diagnosis along with therapy planning. This research presents a combination of multi-scale Convolutional Neural Networks with feature fusion and Bayesian optimization-based feature weighting and Random Forest classification through boosting and bagging techniques for multiclass detection of lung cancer. The pre-processing stage of the methodology starts with lung CT image resizing followed by CLAHE enhancement then min-max normalization to achieve better image visualization. The deep hierarchical features extracted by a multi-scale CNN provide representation of global and local image patterns. Various texture features derive from Gray Level Co-occurrence Matrix (GLCM), Local Binary Pattern (LBP), and Wavelet Transform to boost classification discrimination. Bayesian optimization applies optimal weighting techniques to merge these features prior to obtaining maximum classification outcomes. A decision-making process powered by Random Forest with boosting and bagging works as the final classification step. Research testing performed on LIDC-IDRI and LUNA16 datasets showed that the proposed model outperformed deep learning structures ResNet-50, VGG-16, DenseNet-121 and EfficientNet-B0. The proposed model reaches a remarkable accuracy level of $\mathbf{9 7. 8 \%}$ alongside 97.1 % sensitivity and 97.5 % specificity and an AUC value of 0.98 which surpasses existing contemporary approaches. The model shows enhanced capability for generalization in addition to greater classification reliability than standard 3D-CNN and fusion models. This approach becomes a highly successful lung cancer detection method because multiple feature extraction scales along with texture analysis integration with ensemble learning and Bayesian optimization optimization techniques significantly improve classification output. The assessment methodology produces exact distinctions between benign along with probably benign and indeterminate and probably malignant lung nodules which helps to enhance diagnostic accuracy in clinical settings.},
  keywords={Deep learning;Accuracy;Lungs;Lung cancer;Feature extraction;Bayes methods;Ensemble learning;Convolutional neural networks;Optimization;Random forests;lung cancer;nodule;segmentation;classification;deep learning;machine learning},
  doi={10.1109/ICoEIT63558.2025.11211776},
  ISSN={},
  month={July},}@INPROCEEDINGS{10506005,
  author={Hiremath, Uma M and Chickerur, Satyadhyan},
  booktitle={2023 Third International Conference on Ubiquitous Computing and Intelligent Information Systems (ICUIS)}, 
  title={Deep Learning Based Blood Flow Analysis in MRI Images}, 
  year={2023},
  volume={},
  number={},
  pages={219-227},
  abstract={The study, deep learning algorithms, and compu-tational fluid dynamics (CFD) are combined to analyze blood flow patterns in MRI images. Due to complicated physiological structures and turbulent flows, traditional approaches for blood flow analysis in medical imaging frequently face challenges. In the current study, a deep learning architecture is suggested to accurately extract flow data from MRI scans, offering thorough insights into vascular behavior. Following the extraction, the data are merged into a CFD simulation, allowing for accurate hemodynamic modeling. The combination of deep learning and CFD improves the precision and effectiveness of blood flow analysis, paving up the possibility of potential developments in cardiovascular disease diagnosis and treatment planning. The suggested method employs deep learning-based techniques for flow analysis, ROI extraction, and image pre-processing. It's significant that the method presents a possible classification system for both normal and abnormal aortas. Fundamental flow characteristics, such as velocity, pressure, and turbulence, may be calculated using CFD and are crucial for understanding the underlying flow patterns. It is now possible to analyze and identify a variety of aortic issues with the aid of MRI images and the integration of CFD and deep learning, improving diagnosis and patient care. Experimental findings show the effectiveness with which the suggested method captures complex flow patterns and advances our knowledge of vascular dynamics.},
  keywords={Deep learning;Magnetic resonance imaging;Heuristic algorithms;Fluid dynamics;Ubiquitous computing;Physiology;Planning;Magnetic Resonance Imaging (MRI) images;Computational Fluid Dynamics (CFD);Deep Learning;Blood Flow Analysis},
  doi={10.1109/ICUIS60567.2023.00045},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11199051,
  author={S, RanjithKumar. and Tiwari, Bhupendra Bahadur and Shankarasa Raibagi, Poonum},
  booktitle={2025 World Skills Conference on Universal Data Analytics and Sciences (WorldSUAS)}, 
  title={A Novel Ensemble Learning Approach for Stock Market Forecasting Using Socio-Economic Insights}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This work proposes a new ensemble learning structure of stock market prediction that combines socio-economic indicators with state-of-the-art machine learning procedures. The proposed method combines several base learners, such as RF, GB, and SVM by a meta-learner to improve predictive accuracy and robustness. Economic-socio variables like GDP growth, unemployment rates, inflation, and geopolitical events are included as main characteristics to account for external drivers of behavior in markets. An exhaustive preprocessing piping guarantees data normalization, feature selection and dimensionality reduction. The model is trained and validated upon historical stock data with the conformity of socio-economic datasets, with RMSE 0.0871, MAE 0.0643 and accuracy 0.9224. The performance is measured. From experimental results, it is shown that the use of ensemble overcomes the prediction ability and generalization capacity of individual models. The focus of this work is on the need to merge financial and macroeconomic perspectives for more credible prediction of the market, a practical tool for investors and policymakers. The framework provides the foundation for future works on real-time data streams, and integration with deep learning.},
  keywords={Accuracy;Economic indicators;Predictive models;Data models;Real-time systems;Ensemble learning;Socioeconomics;Stock markets;Forecasting;Long short term memory;Stock Market Forecasting;Socio-Economic Factors;Fuzzy-EDL;ARAS-based Model;and Machine Learning},
  doi={10.1109/WorldSUAS66815.2025.11199051},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11469229,
  author={Chakravarthy, B. Dilip and Reddy, M. Ananda Gopal and Fareedha, D. and Charitha, Yama and Reddy, L. Ganesh Kumar},
  booktitle={2026 3rd International Conference on Emerging Trends in Engineering and Medical Sciences (ICETEMS)}, 
  title={Hybrid Quantum-Machine Learning Framework for Precision Farming: Optimizing Crop Yield and Profitability}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper introduces a hybrid machine learning and quantum, inspired framework for the prediction of crop yield and profit in precision agriculture. The presented system combines classical machine learning models with quantum, inspired learning such that the model's predictability and generalization can be increased. Random Forest regressors are employed to estimate crop yield and economic profit, thus providing a stable and reliable baseline for the performance. Quantum Kernel Ridge Regression and a Variational Quantum Circuit have been added to this framework as corrective components to enhance the model's generalization. The proposed technique involves methodical data preprocessing: categorical attributes are encoded (soil type, season, crop name, and disease status), and numerical features are scaled (rainfall, nutrient level, fertilizer usage, and cultivated area). Instead of using image, based disease detection methods, disease condition is considered as a structured input feature and is merged with the yield and profit estimation process. The quantum-inspired module, which is implemented with Qiskit, employs Principal Component Analysis for reducing dimensions and utilizes a ZZFeatureMap to encode quantum features to construct quantum kernels. By providing an effective framework for data-driven agricultural decision support, the current system is deployed via an interactive Streamlit application for dataset uploading, model training and prediction, and visual analysis through correlation heatmaps and yield-profit trend plots. Experimental results have shown that a hybrid integration of classical machine learning and quantum- inspired methodology could enhance predictability, interpretability, and practical usability, thus offering this framework suitable for data-driven agricultural decision support.},
  keywords={Feeds;Circuits;Quantum circuit;Recommender systems;Information filtering;Circuits and systems;Internet of Things;Quantum circuit;Quantum communication;Radio frequency;Machine Learning;Quantum Computing;Crop Yield Prediction;Random Forest;Kernel Ridge Regression;Qiskit;Agricultural Forecasting;Hybrid Models},
  doi={10.1109/ICETEMS66917.2026.11469229},
  ISSN={},
  month={March},}@INPROCEEDINGS{11470787,
  author={Song, MingYang and Lawanna, Thacha},
  booktitle={2025 International Conference on Artificial Intelligence, Blockchain, Cloud Computing, and Data Analytics (ICoABCD)}, 
  title={Transforming Financial Engineering through AI-Enhanced Case-Based Reasoning for Digital Innovation}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The rapid evolution of digital finance has heightened the demand for intelligent systems capable of adapting to dynamic market behaviors and complex regulatory environments. Financial institutions such as banks, fintech firms, and credit agencies increasingly rely on advanced decision models for credit risk assessment, fraud detection, and portfolio optimization. Traditional models including Rule-Based Systems, Bayesian Networks, Decision Trees, and Markov Decision Processes remain constrained by limited adaptability, lack of transparency, and poor integration of heterogeneous data. To address these issues, this study proposes an AIenhanced Case-Based Reasoning (AICBR) framework that merges symbolic reasoning with adaptive machine intelligence. The framework comprises five stages: case acquisition from structured and unstructured financial sources, machinelearning-based case indexing using feature embeddings and clustering, neural similarity retrieval via cosine and probabilistic metrics, reinforcement-learningdriven solution adaptation, and feedback-based continual learning for realtime improvement. Evaluation across five benchmark datasets Adult, Bank Marketing, Car Evaluation, Student Performance, and Online Retail demonstrates an average accuracy of 91.6% and latency under 3.5 seconds per transaction, surpassing traditional models that average below 78 %. The results validate AI-CBR's superiority in adaptability, transparency, and computational efficiency, establishing it as a robust and explainable framework for intelligent, data-driven, and regulatory-compliant financial decision-making.},
  keywords={Feedback;Circuits;Cloud computing;Protocols;Feedback loop;Internet;HTTP;Feedback communications;Artificial intelligence;Cognitive systems;case-based reasoning;financial engineering;enforcement learning;explainable ai;predictive modeling;digital innovation},
  doi={10.1109/ICoABCD67551.2025.11470787},
  ISSN={},
  month={Dec},}@INBOOK{11173726,
  author={Nachiappan, Balusamy and Viji, C. and Rajkumar, N. and Mohanraj, A. and Karthikeyan, N. and Judeson Antony Kovilpillai, J. and Vidyullatha, Pellakuri},
  booktitle={Artificial Intelligence and Machine Learning for Industry 4.0}, 
  title={Industry 4.0 and the AI/ML Era}, 
  year={2025},
  volume={},
  number={},
  pages={1-27},
  abstract={Summary <p>The emergence of enterprise 4.0 signs a transformative era in manufacturing, wherein digital technology seamlessly merges with traditional business methods. This precis explores the profound impact of Industry 4.0, highlighting the synergy of the various Industrial Internet of Things (IoT) and its implications for clever production. At its core, business enterprise 4.0 allows the mixing of physical and virtual structures, fostering heightened interconnectivity and transparency. The IoT permits actual&#x2010;time facts change among interconnected gadgets, supplying manufacturer with comprehensive insights into their production ecosystems. Decentralized selection&#x2010;making, a key function of enterprise 4.0, is made viable with the aid of cyber&#x2010;physical systems, empowering machines with independent choice&#x2010;making capabilities and enhancing operational performance.</p> <p>Even as AI is absent from the narrative, the point of interest stays at the transformative electricity of enterprise 4.0. Predictive preservation algorithms preemptively understand and prevent device failures, making sure ultimate performance and minimizing downtime. Actual&#x2010;time quality manipulation mechanisms contribute to product consistency through early illness detection. The concept of smart automation outcomes in adaptive and self&#x2010;optimizing manufacturing strategies involves responding in real&#x2010;time to changing conditions. Past the manufacturing facility, the strategic integration of the digital era optimizes delivery chain dynamics, facilitating smart forecasting, stock management, and logistics.</p>},
  keywords={Fourth Industrial Revolution;Production;Artificial intelligence;Manufacturing;Machine learning;Industries;Convergence;Mass production;Interoperability;Computer science},
  doi={10.1002/9781394275076.ch1},
  ISSN={},
  publisher={Wiley},
  isbn={9781394275069},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/11173726},}@INPROCEEDINGS{11267898,
  author={Demirkaya, Yağmur and Gencer, Kerem and Meydan, Sude and Guven, Murat Okan and Savran, İsmail},
  booktitle={2025 9th International Symposium on Multidisciplinary Studies and Innovative Technologies (ISMSIT)}, 
  title={Forecasting Flight Delays From Operational and Weather Data: A Regression-Based Machine Learning Application}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={In this study, a machine learning-based prediction system for forecasting flight arrival delays has been developed. Increasing air traffic, operational complexity, and uncertainties in weather conditions have made predicting flight delays progressively more critical [1]. In this context, our study aims not only to produce short- term forecasts but also to provide meaningful delay predictions to contribute to airline management processes [2]. The prediction system, developed as a web application using the Flask framework, enables users to access model outputs through an internet browser; thus, delay predictions can be presented dynamically in minutes via the trained models.In the study, extensive preprocessing steps including data cleaning, outlier correction (IQR), conversion of categorical variables using one-hot encoding, and basic feature engineering were applied on a large dataset of U.S. flights [3]. The dataset, obtained from the official website of the United States Department of Transportation / Bureau of Transportation Statistics, consists of approximately 454,414 rows and 40 columns [4]. To better analyze the impact of weather conditions on flight delays, weather data was collected using the Meteostat Python package [5]. The acquired data was processed in Python as DataFrames and merged with existing flight data to create a more advanced and comprehensive dataset [6]. Thanks to this integration, the accuracy of the prediction model was significantly improved. During the prediction process, the XGBoost algorithm achieved an R2 score of 91.9%, while the Random Forest algorithm reached 91.7%, representing the best performing models [7], [8]. These two methods were preferred due to their compatibility with large datasets, advantages regarding data structure, and successful application in previous studies [9]. These models stood out in the task of predicting delay durations.Other advanced algorithms such as CatBoost, LightGBM, and LSTM were also tested and included in the model comparisons [10]. However, the performance of these models remained lower compared to XGBoost and Random Forest [11]. All models were evaluated using regression metrics such as R2, MAE, and RMSE, and model-based variable importance analyses identified key factors influencing delays [12].In conclusion, this study demonstrates that data-driven prediction approaches enhance the capability to forecast flight delays in advance, enabling airlines to make more effective and proactive decisions in critical processes such as operational planning, customer notification, and resource allocation [13].},
  keywords={Atmospheric modeling;Wind speed;Data preprocessing;Predictive models;Prediction algorithms;Data models;Delays;Planning;Random forests;Airline industry;Flight delay prediction;XGBoost;LightGBM;Machine learning;Regression;Data preprocessing;Feature engineering;Model comparison},
  doi={10.1109/ISMSIT67332.2025.11267898},
  ISSN={2770-7962},
  month={Nov},}@ARTICLE{11208534,
  author={Shen, Yang and Gao, Zhenglong and Wang, Jiaqi and Zhang, Zhiwei and Zhang, Yujie and Postolache, Octavian and Mi, Chao},
  journal={IEEE Sensors Journal}, 
  title={Point Cloud Surface Registration for Cargo Hold Material Matching via Sparse Line-Based Sensing Method}, 
  year={2025},
  volume={25},
  number={23},
  pages={43305-43318},
  abstract={In the automated unloading operations at port terminals, portal cranes move through a multiline laser radar to dynamically sense the material surface in cargo holds. The laser radar sensors provide detailed 3-D point cloud data, enabling precise surface detection. However, a single scan is prone to interference from equipment vibration and grab bucket occlusion, leading to sparse point cloud data and blind spots in the scan. To construct a complete material surface model, multiple frame registration is required. Through the integration of sensor data from multiple scans, a more complete and accurate material surface model can be reconstructed. By merging data from multiple sensing scans, the system gains a deeper understanding of the material surface structure, significantly enhancing the overall sensing accuracy. Traditional registration methods, which rely on manually designed feature extraction rules, often fail under the conditions of irregular surfaces and sparse, line-shaped point clouds. Such methods, lacking dynamic adaptability to sensor data, struggle to process real-world complexities efficiently. While the deep learning algorithm RPMNet can handle sparse data, it is insensitive to rotational errors around the vertical axis (yaw angle), resulting in significant yaw angle errors. This insensitivity reduces the system’s ability to sense precise spatial transformations, leading to errors in material alignment. To tackle this issue, an improved RPMNet + iterative closest point (ICP) fusion algorithm is considered in this work. The initial registration of the material surface point cloud is performed by RPMNet, and then edge features are used to build a local coordinate system. High-discriminative edge points are extracted via sector segmentation to generate posture vectors, and a masking mechanism is employed to filter out corner interference. The edge features, as sensed through sector segmentation, play a crucial role in defining accurate positional orientation. Finally, the ICP algorithm is used for precise registration to optimize errors. Through iterative refinements based on sensor inputs, ICP enhances the system’s alignment capabilities, significantly reducing residual errors. In simulated conditions, experimental results indicate that, regarding accuracy and robustness, the proposed method remarkably surpasses mainstream registration algorithms. Moreover, it demonstrates stable performance in real scenarios, and the corresponding data comes from different types of ships and under various weather conditions. The robustness of the method is validated under diverse real-world sensing conditions, showcasing its practical application in dynamic, sensor-based environments.},
  keywords={Point cloud compression;Surface treatment;Sensors;Laser radar;Accuracy;Portals;Cranes;Surface reconstruction;Feature extraction;Three-dimensional displays;Bulk terminal;cargo hold;point cloud registration;RPMNet;sparse line-based sensing method},
  doi={10.1109/JSEN.2025.3620816},
  ISSN={1558-1748},
  month={Dec},}@INPROCEEDINGS{10700900,
  author={Agnihotri, Alka and Grover, Veena and Balusamy, Balamurugan and Gite, Shilpa and Arockiam, Daniel and Shankar, Achyut},
  booktitle={International Conference on AI and the Digital Economy (CADE 2024)}, 
  title={Utilizing the potential of AI to Revolutionize talent management in contemporary organizations}, 
  year={2024},
  volume={2024},
  number={},
  pages={1-11},
  abstract={Artificial Intelligence (AI) refers to an umbrella of technologies, from machine translation and chatbots to self-learning algorithms and self-driving cars. Individuals using these technologies gain a better understanding of their surroundings and make informed decisions, while organizations increasingly turn to AI innovations as ways to adapt or disrupt ecosystems while strengthening strategic and competitive positions. AI achieves its full potential by streamlining existing operations, improving automation, data utilization and transformative capabilities - it outperforms at tasks such as recognising patterns, making predictions and interfacing with humans thereby realising its full potential. Thus, our research findings highlight the numerous advantages AI brings to organizations. AI improves performance across various dimensions such as finance, marketing, and administration while simultaneously increasing process efficiency resulting in enhanced outcomes and simplified operations. Also, it holds great promise for improving talent management strategies through sophisticated workforce management systems. This study seeks to outline the necessary conditions for creating an AI-powered solution capable of effectively meeting talent management challenges. Research in this area centers around creating an intelligent Human Resource Management (HRM) automation tool with a talent intelligence module as its cornerstone, with the primary goal of optimizing integration between professional assessment and planning features. A design science methodology and structured machine learning techniques serve as cornerstones of this comprehensive AI solution framework. Additionally, the proposed framework is enhanced by merging insights from Digital Transformation Triad (DTT) theory and Dissemination of Innovation (DOI). This combination provides a robust strategy for effectively addressing AI-related challenges. Moving beyond automation aspects of talent management solutions, this research offers practical recommendations to researchers so that their approaches meet organizational-specific talent growth requirements. Ultimately, this research investigates AI's transformative potential within talent management while outlining a holistic strategy to use AI for workforce planning and professional assessment within contemporary business environments.},
  keywords={},
  doi={10.1049/icp.2024.2519},
  ISSN={},
  month={June},}@INPROCEEDINGS{11309979,
  author={Shakya, Dipankar and Abbasi, Naveed A. and Ying, Mingjun and Jariwala, Isha and Qin, Jason J. and Gupte, Ishaan S. and Meier, Bridget and Qian, Guanyue and Abraham, Daniel and Rappaport, Theodore S. and Molisch, Andreas F.},
  booktitle={MILCOM 2025 - 2025 IEEE Military Communications Conference (MILCOM)}, 
  title={Standardized Machine-Readable Point-Data Format for Consolidating Wireless Propagation Across Environments, Frequencies, and Institutions}, 
  year={2025},
  volume={},
  number={},
  pages={232-237},
  abstract={The necessity of new spectrum for 6G has intensified global interest in radio propagation measurements across emerging frequency bands, use cases, and antenna types. These measurements are vital for understanding the fundamentals of radio channel properties in diverse environments, and involve time-consuming, labor-intensive, and expensive campaigns. A major challenge for the effective utilization of the data generated from propagation measurement campaigns has been the lack of a standardized format for reporting and archiving results. Although organizations such as NIST, NGA, and 3GPP have made commendable efforts toward data pooling, a unified machine-readable data format for consolidating measurements across different institutions and frequencies remains a critical missing piece in advancing global standardization efforts and maximizing the utility of collected data. This paper introduces a new, standardized point-data format for wireless propagation measurements and demonstrates how multiple institutions may merge disparate measurement campaigns into a common format for global access. This data format, when used alongside an environmental map and a measurement summary metadata table, enables the seamless integration of radio propagation data from disparate sources by using a structured representation of key propagation parameters. Here, we show the efficacy of the proposed point-data format standard using data gathered from two independent sub-THz urban microcell (UMi) campaigns: 142 GHz measurements at New York University (NYU) and 145 GHz measurements at the University of Southern California (USC). A joint path loss analysis using the close-in path loss model with a 1 m reference distance yields a refined estimate of the path loss exponent (PLE) employing the proposed standard to pool measurements from the two different organizations. Other key statistics such as RMS delay spread and angular spread are determined using datasets from the two different institutions cast in the standardized format. Adopting this simple, unified format will accelerate comprehensive channel model development, build multi-institutional datasets, and feed AI/ML applications with reliable training data in a common format from many sources.},
  keywords={Wireless communication;Antenna measurements;Industries;Statistical analysis;Organizations;Radio propagation;Loss measurement;Frequency measurement;Delays;Reliability;Wireless propagation;channel sounding;standardized data format;6G;machine learning},
  doi={10.1109/MILCOM64451.2025.11309979},
  ISSN={2155-7586},
  month={Oct},}@INPROCEEDINGS{10822478,
  author={Guo, Maotao and Zhou, Ye and Tang, Siyuan and Li, Xianglong},
  booktitle={2024 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={Explainable Multimodal Framework for Brain Imaging with 3D MRI and Age Data}, 
  year={2024},
  volume={},
  number={},
  pages={4521-4528},
  abstract={Advanced volumetric neuroimaging modalities, particularly structural Magnetic Resonance Imaging (sMRI), are widely utilized in the clinical assessment of neurodegenerative conditions such as Alzheimer’s Disease (AD). Neuroradiologists examine three-dimensional sMRI datasets to detect and evaluate morphological alterations in the brain linked to AD, encompassing both widespread and region-specific atrophy, along with changes in the morphology of certain brain structures. Recent studies have progressively concentrated on creating diagnostic frameworks that employ Deep Learning (DL) techniques to analyze sMRI data for the identification of AD. However, it remains essential to interpret the anatomical characteristics obtained from sMRI within the context of the patient’s age to distinguish between AD-associated patterns and those resulting from typical aging processes. In this context, part-prototype neural networks present a viable strategy by merging the computational capabilities of DL with a transparent architecture, showing promise in medical imaging applications. In this study, we present ADNet, a novel interpretable multimodal system that combines three-dimensional imaging information with demographic data for the binary classification of AD, utilizing both 3D sMRI and patient age. Although the integration of age-informed prototypes does not significantly enhance the predictive accuracy beyond that of unimodal models, this research lays the groundwork for the future development of model architectures and multimodal prototype training approaches in forthcoming investigations.},
  keywords={Neuroimaging;Solid modeling;Three-dimensional displays;Magnetic resonance imaging;Prototypes;Computer architecture;Predictive models;Brain modeling;Data models;Alzheimer's disease;Medical Image;Multimodal Deep Learning;Alzheimer MRI},
  doi={10.1109/BIBM62325.2024.10822478},
  ISSN={2156-1133},
  month={Dec},}@INPROCEEDINGS{11501101,
  author={Likitha, Balamuri and Sravani, Bandi and Sreenija, Chinnahyata and Jayanthi, Chandamala and Nayomi, B. Deena Divya},
  booktitle={2025 3rd International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={Deep Learning-Driven Smart Framework for Accurate Drought Forecasting via Satellite Imagery Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={759-766},
  abstract={Drought develops gradually before becoming a natural hazard which generates substantial environmental damage and social-economic impacts mainly affecting agricultural areas. The exact and on-time prediction of drought conditions remains difficult because of complex climatic patterns and insufficient ground observation data particularly in underdeveloped regions. A deep learning-based smart framework will be developed to forecast droughts by utilizing satellite-derived precipitation data according to this research. A hybrid Long Short-Term Memory (LSTM) and Convolutional Neural Network (CNN) structure makes up the proposed model which detects short and long temporal patterns within precipitation sequence data. The framework adopts CHIRPS (Climate Hazards Group InfraRed Precipitation with Station data) dataset for its public availability and high-resolution long-term rainfall historical information. The data preparation process includes merging data into monthly periods while normalizing values followed by drought classification through SPI algorithms. Multiple performance metrics evaluate the model which demonstrates better results than ARIMA and Random Forest along with standalone LSTM models. The proposed CNN-LSTM model achieved an accuracy of 91.3%, precision of 89.7%, recall of 90.4%, F1-score of 90.0%, and an RMSE of 1.29, outperforming the LSTM (accuracy: 84.2%, RMSE: 1.76) and Random Forest (accuracy: 78.6%, RMSE: 2.14). Inference time remained low at 8.7 ms/sample, demonstrating potential for real-time deployment. The research develops a sound scalable drought forecasting system which applies only satellite-based precipitation measurements and runs at computational speed. The model’s high accuracy and low latency make it suitable for integration into early warning systems, particularly in data-scarce or climate-vulnerable regions.},
  keywords={Satellite images;Earth Observing System;Feeds;Filtering;Central Processing Unit;Filters;Communication systems;Internet;Protocols;Radio access networks;Drought Forecasting;Deep Learning;CNN-LSTM;Satellite Imagery;CHIRPS Dataset;Climate Resilience},
  doi={10.1109/ICSCSS64956.2025.11501101},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11051710,
  author={Durga, B Kanaka and Hassa, Mahasen Abdulqader and Singla, Er Rubani and Jyothsna, Goundla and Mukesh, Kuppannagari Sai and Reddy, K Nithish},
  booktitle={2024 International Conference on Augmented Reality, Intelligent Systems, and Industrial Automation (ARIIA)}, 
  title={A Transparent SIWS LOT Antenna for KA-Band Applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={This study addresses the challenge of developing high-performance, aesthetically integrated antennas for Ka-band (24.31–27.81 GHz) applications, essential in 5G networks and automotive systems where transparency is advantageous. We propose a novel transparent substrate-integrated waveguide (SIW) slot antenna that utilizes a polyethylene terephthalate (PET) substrate integrated with a conductive mesh, achieving high optical transparency (approximately 71%) alongside superior electrical conductivity. The antenna's SIW structure is modified by selectively omitting specific metallic vias and incorporating resonant I-shaped and U-shaped slots to enhance hybrid resonance generation, broadening operational bandwidth significantly. Our design exhibits a peak gain of 7.8 dBi at 26.5 GHz and maintains a front-to-back ratio and cross-polarization ratio exceeding 20 dB, making it highly suitable for millimeter-wave applications. Empirical validation demonstrates a measured impedance bandwidth from 24 to 28.55 GHz with a fractional bandwidth of 17.3%, surpassing simulated predictions due to minor design optimizations. Despite slight manufacturing discrepancies, the agreement between simulated and measured results confirms the design's robustness and reliability. This research underscores the potential of transparent antennas in next-generation communication systems, offering a functional solution that merges transparency with high-frequency performance, paving the way for seamless integration in modern, visually sensitive applications.},
  keywords={Antenna measurements;Slot antennas;Polyethylene;Impedance measurement;Bandwidth;Optical sensors;Ka-band;Substrates;Optical waveguides;Gain;Transparent antenna;Ka-band applications;5G networks;High gain antennas},
  doi={10.1109/ARIIA63345.2024.11051710},
  ISSN={},
  month={Dec},}@INBOOK{10790746,
  author={Gowda V, Dankan and Kumar, Avinash and Ananth, Belsam Jeba M. and Vasanthakumar, G. U. and Singh, Mandeep},
  booktitle={Quantum Machine Learning: Quantum Algorithms and Neural Networks}, 
  title={3 Quantum machine learning in healthcare: diagnostics and drug discovery}, 
  year={2024},
  volume={},
  number={},
  pages={39-64},
  abstract={The awareness of quantum machine learning (QML) as a possible catalyst for redefining the healthcare industry is fast increasing. This chapter provides an analysis of the transformational potential of QML in the context of healthcare diagnostics and drug development. The confluence of quantum computing with machine learning in the field of diagnostics offers significant prospects for the analysis of extensive and intricate biological datasets at unparalleled velocities. This has the potential to improve the precision and promptness of illness diagnosis and monitoring. This chapter explores the ways in which quantum algorithms might augment imaging methodologies, hence facilitating more accurate and noninvasive diagnostic procedures. QML presents a transformative change within the domain of drug discovery. The considerable computing capabilities of quantum systems have the potential to greatly expedite the process of drug creation and screening. These systems can efficiently navigate extensive chemical databases in a substantially shorter timeframe compared to conventional systems. Through the examination of intricate molecular structures and their interactions on a quantum scale, novel therapeutic interventions might be discerned for illnesses that now lack efficacious remedies. This chapter examines the promising prospects of QML in the medical field while also highlighting the current challenges and limitations it faces upon integration. Key points of consideration include the vulnerability of quantum computing devices to environmental interference and the nascent stage of quantum algorithms tailored for healthcare data. The merging of quantum computing with the healthcare industry is poised to have profound effects on patient treatment, medical investigations, and the drug development industry. The content herein provides a comprehensive review of the current state, potential benefits, and challenges of employing QML within healthcare diagnostics and pharmaceutical innovation. Moreover, it charts an optimistic trajectory for the evolution of medical research going forward.},
