  ISSN={},
  month={Dec},}@INPROCEEDINGS{10937568,
  author={Bordia, Anav and Leuze, Christoph},
  booktitle={2024 IEEE MIT Undergraduate Research Technology Conference (URTC)}, 
  title={Vascular segmentation of kidney CT-scans through 2.5D model}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The Vascular Common Coordinate Framework (VCCF) standardizes vascular structure representation, advancing medical diagnoses and research. This study introduces a 2.5D vascular segmentation model by combining U-Net and ResNet. The 2.5D model merges the benefits of 3D models with the efficiency of 2D approaches, achieving a Dice score of 0.805. It leverages information from adjacent slices, enhancing accuracy and detail compared to 2D methods, though it does not match the performance of full 3D models. Its computational efficiency makes it ideal for vascular segmentation, aiding the VCCF development and supporting disease research and clinical applications.},
  keywords={Solid modeling;Image segmentation;Three-dimensional displays;Accuracy;Computational modeling;Computer architecture;Computational efficiency;Kidney;Standards;Optimization;2.5D convolution;U-Net;ResNet;CT scans;vasculature},
  doi={10.1109/URTC65039.2024.10937568},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11502194,
  author={Chanagoni, Venkanna and Noorullah, Syed and Babu, K Prasad and Ahalya, C and Himabindu, R and Mohebbanaaz},
  booktitle={2026 IEEE 15th International Conference on Communication Systems and Network Technologies (CSNT)}, 
  title={Early Alzheimer Detection from MRI Scan Using Hybrid DeepCNN}, 
  year={2026},
  volume={},
  number={},
  pages={1353-1358},
  abstract={Timely clinical intervention is necessary for all types of Alzheimer's disease (AD) clinical intervention. However, early medical diagnostics often miss or do not notice small, yet important, structural changes to the brain, so we will focus on early detection of Alzheimer's disease. This research aims to change the way structural MRIs are analyzed. A specialized CNN, merged with a pre-trained VGG16 architecture, should increase the accuracy and reliability of structural MRIs. The proposed candidate hybrid model contributes vanguard domain-centered CNN to capture the exact localized alterations of the brain's anatomy. The VGG16 will give it the graded deep intricate feature representations obtained from a wide array of images. This two-part architecture will enable the machine to use altered brain in an Alzheimer's MRI to more efficiently use its features to classify the MRI. We hope to successfully classify early, and more advanced, Alzheimer's based on changes to the structure of the brain. Standalone CNN and transfer-learning baselines will, we hope, be more efficiently and successfully classified by this hybrid architecture in all markers associated with early Alzheimer's detection. The hope is to provide a model that can be efficiently used for the early detection of structural markers associated with Alzheimer's in a largely automated and MRI based system.},
  keywords={Filtering;Filters;Circuits and systems;Communication systems;Communications technology;Protocols;Pixel;HTTP;Digital images;Convolutional neural networks;MRI Images;Alzheimers detection;Deep Network;CNN;Medical Imaging},
  doi={10.1109/CSNT69054.2026.11502194},
  ISSN={2473-5655},
  month={April},}@INPROCEEDINGS{9406992,
  author={Tan, Yumeng and Fu, Xupeng and Zhu, Jianbo and Chen, Lina},
  booktitle={2020 Eighth International Conference on Advanced Cloud and Big Data (CBD)}, 
  title={Multi-scale 3D convolutional neural network lung nodule detection method}, 
  year={2020},
  volume={},
  number={},
  pages={219-224},
  abstract={In order to solve the problem of low detection sensitivity and high false positives of traditional lung nodule detection models, a multi-scale three dimensional (3D) convolutional neural network (CNN) based lung nodule detection method was proposed. First, in order to improve the operating speed and network flexibility, a single-stage mode was adopted, and there was no false positive reduction stage. Secondly, based on the above model, we built a new network structure, innovatively used the 3D UNet++-like architecture as the backbone of the region proposal network (RPN), and adopted the flexible nesting mode of residual blocks. Finally, the three input sizes were input into the 3D neural network, and their classification results were merged. Experiments showed that our model had an average sensitivity of 87.3% in false positive screening based on the LUNA16 datasets, which was an increase of 7.8% compared with the UNet++ network. The total sensitivity was as high as 96.2%. It can be seen that our model can significantly improve detection sensitivity and reduce false positives, which can provide a theoretical reference for clinical applications.},
  keywords={Solid modeling;Three-dimensional displays;Sensitivity;Computed tomography;Neural networks;Lung;Feature extraction;pulmonary nodule detection;convolutional neural network;multi-feature fusion},
  doi={10.1109/CBD51900.2020.00047},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10922007,
  author={Panigrahi, Guru Prasad and Naomi Mannas, Britney and Banerjee, Utsab},
  booktitle={2024 International Conference on Recent Innovation in Smart and Sustainable Technology (ICRISST)}, 
  title={Embedded Patch Dielectric Resonator Antenna for Ku and K Band Applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={The antenna focuses on achieving wideband performance in the antenna designed by utilizing the combination of dielectric resonator and an ‘V’ shaped embedded patch. By incorporating a dielectric resonator and an ‘V’ shaped embedded patch, the antenna's bandwidth is extensively enhanced, leading to improved overall performance. A suitable dielectric material is chosen, considering its permittivity and loss tangent to optimize the antenna's bandwidth. Additionally, a ‘V’ shaped embedded patch structure is integrated into the design to further enhance the antenna's performance. The antenna consisting of strip line feed is merged with the ‘V’ shaped patch embedded in between the two substrates. The antenna design is modelled and simulated to analyze key characteristics like the impedance matching, radiation pattern, and gain. The simulations enable the fine-tuning of a dielectric resonator and ‘V’ shaped embedded patch parameters, ensuring wideband operation and optimal performance. The impedance bandwidth of the antenna ranging from 15.6Ghz to 21.98Ghz has thus been partially covering the Ku band (12-18Ghz) and the K band (18- 27Ghz). The antenna proves to have a good VSWR, efficiency and gain over the given range.},
  keywords={Technological innovation;Surface impedance;Dielectric resonator antennas;Ku-band;Dielectrics;Broadband antennas;Impedance;Permittivity;Wideband;Substrates;Embedded patch;Dielectric resonator;Wideband},
  doi={10.1109/ICRISST59181.2024.10922007},
  ISSN={},
  month={March},}@INPROCEEDINGS{9849562,
  author={Fan, DaWei and Hu, Yi and Li, YanXin and Liu, WeiRan},
  booktitle={2022 11th International Conference of Information and Communication Technology (ICTech))}, 
  title={State Recognition Method of Heat Treatment Process Based on PLR}, 
  year={2022},
  volume={},
  number={},
  pages={471-475},
  abstract={Temperature can change the chemical composition and internal structure of metals during heat treatment processing, which is the decisive factor affecting the quality of processing devices. Aiming at the trend change of temperature in the process of heat treatment, a state recognition method based on piecewise linear representation of time series is proposed. The method first extracts the turning point according to the angle change of the time series temperature data, then divides the trend segment of the original data by turning point, then uses bottom-Up algorithm to merge the trend segment to obtain the segmented linear representation, trains the SVM classification by the statistical characteristics of the segmented data, and finally obtains the processing state of the heat treatment process. Taking the actual data of a unit heat treatment workshop site as an example, the effectiveness of this method is verified by experimenting with the proposed method.},
  keywords={Support vector machines;Temperature distribution;Heat treatment;Time series analysis;Metals;Linearity;Production;time series;PLR;industrial heat treatment;state recognition;turning point},
  doi={10.1109/ICTech55460.2022.00100},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10072982,
  author={Gu, Juping and Hu, Junjie and Jiang, Ling and Wang, Zixu and Zhang, Xinsong and Xu, Yiming and Zhu, Jianhong},
  booktitle={2022 12th International Conference on Power and Energy Systems (ICPES)}, 
  title={Object Detection of Overhead Transmission Lines Based on Improved YOLOv5s}, 
  year={2022},
  volume={},
  number={},
  pages={388-392},
  abstract={Given that the aerial image to scan overhead transmission line contains complex backgrounds and small objects, it is difficult for traditional algorithms to accurately identify the details of power transmission lines, so this paper develops an object detection method based on improved YOLOv5s. To improve the detecting accuracy of small objects, the network structure is optimized by adding a larger scale detection layer and jump connections. Then, a self-attention mechanism is introduced to merge the feature relationships between spatial and channel dimensions. The self-attention mechanism could suppress the interference of complex backgrounds and boost the salience of objects. In addition, this paper proposes a small object enhanced complete intersection-over-union as the loss function of the bounding box regression. This loss function could adjust the derived loss for objects of different sizes automatically, therefore, improving the detection of small samples. The experimental results demonstrate that compared to classic YOLOv5s, the detection accuracy of our algorithm is improved by 4.2%.},
  keywords={Power transmission lines;Object detection;Interference;Real-time systems;Object recognition;overhead transmission line;object detection;larger scale detection layer;self-attention;bounding box regression},
  doi={10.1109/ICPES56491.2022.10072982},
  ISSN={2767-732X},
  month={Dec},}@ARTICLE{9584232,
  author={Davison, Thomas A and Norris, Mark A and Leaman, Ryan and Kuntschner, Harald and Boecker, Alina and van de Ven, Glenn},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Mapping accreted stars in early-type galaxies across the mass–size plane}, 
  year={2021},
  volume={507},
  number={1},
  pages={3089-3112},
  abstract={Galaxy mergers are instrumental in dictating the final mass, structure, stellar populations, and kinematics of galaxies. Cosmological galaxy simulations indicate that the most massive galaxies at z = 0 are dominated by high fractions of ‘ex-situ’ stars, which formed first in distinct independent galaxies, and then subsequently merged into the host galaxy. Using spatially resolved MUSE spectroscopy we quantify and map the ex-situ stars in thirteen massive early-type galaxies. We use full spectral fitting together with semi-analytic galaxy evolution models to isolate the signatures in the galaxies’ light which are indicative of ex-situ populations. Using the large MUSE field of view we find that all galaxies display an increase in ex-situ fraction with radius, with massive and more extended galaxies showing a more rapid increase in radial ex-situ fraction (reaching values between ∼30 per cent and 100 per cent at 2 effective radii) compared to less massive and more compact sources (reaching between ∼5 per cent and 40 per cent ex-situ fraction within the same radius). These results are in line with predictions from theory and simulations which suggest ex-situ fractions should increase significantly with radius at fixed mass for the most massive galaxies.},
  keywords={galaxies: elliptical and lenticular, cD;galaxies: evolution;galaxies: formation;galaxies: kinematics and dynamics;galaxies: stellar content},
  doi={10.1093/mnras/stab2362},
  ISSN={1365-2966},
  month={Jul},}@INPROCEEDINGS{11154154,
  author={Xu, Zihan},
  booktitle={2025 5th International Conference on Computer Science and Blockchain (CCSB)}, 
  title={Meta-Learning Curriculum Agent (MLCA): A Hierarchical Framework for Cross-Environment Adaptation in Reinforcement Learning}, 
  year={2025},
  volume={},
  number={},
  pages={89-92},
  abstract={We propose the Meta-Learning Curriculum Agent (MLCA), a hierarchical framework designed to address the challenge of cross-environment adaptation in reinforcement learning (RL). Traditional transfer learning methods often rely on static pre-training or manually designed curricula, which struggle to generalize across diverse and dynamic environments. The MLCA merges meta-learning with curriculum learning via a three-part structure: a Meta-Learner that deduces task relevance from environmental features, alongside a dynamically adjusting Curriculum Generator for task difficulty, and a Policy Adaptation Module supporting swift fine-tuning. The Meta-Learner employs a Transformer-based encoder to capture temporal and taskspecific patterns, while the Curriculum Generator optimizes task selection by balancing performance improvement and knowledge retention. Additionally, the Policy Adaptation Module employs gradient-based meta-learning to adjust policies effectively with limited retraining. The framework functions by means of asynchronous data pipelines and establishes a closed-loop system in which curriculum modifications are directed by real-time agent performance. MLCA differs from prior methods by employing a dual-loop optimization that simultaneously refines task ordering and policy adjustment, avoiding dependence on predetermined schedules. Initial experiments on algorithmically constructed benchmarks show better generalization than traditional approaches. The MLCA's ability to autonomously generate adaptive curricula makes it particularly suitable for applications requiring robust RL agents in non-stationary environments, such as robotics and autonomous systems.},
  keywords={Metalearning;Adaptive systems;Autonomous systems;Transfer learning;Reinforcement learning;Benchmark testing;Transformers;Generators;Robots;Optimization;Reinforcement Learning;Meta-Learning;Curriculum Learning;Transfer Learning;Domain Adaptation},
  doi={10.1109/CCSB66722.2025.11154154},
  ISSN={},
  month={Aug},}@ARTICLE{9579318,
  author={Maghdour-Mashhour, Reza and Hayes, Ben},
  journal={Journal of Petrology}, 
  title={A Turbulent Magmatic Density Current and the Origin of the Anastomosing UG-1 Chromitites at Dwars River in the Bushveld Complex}, 
  year={2021},
  volume={62},
  number={7},
  pages={1-23},
  abstract={The origin of the enigmatic UG-1 chromitites at Dwars River in the eastern limb of the Bushveld Complex has been vigorously debated. The UG-1 chromitites form an anastomosing network of multiple layers that are hosted in poikilitic anorthosites and their formation has previously been explained by depositional, erosional, and intrusive processes. We propose that the UG-1 chromitites formed in response to the emplacement of a turbulent magmatic density current into the developing chamber. We use theoretical constraints in fluid mechanics to describe the evolution of the current and in this context, we provide an explanation for the enigmatic igneous features that are preserved at Dwars River. The current was emplaced as an instantaneous single pulse (fixed volume) of dense plagioclase-charged magma (i.e. a plagioclase slurry) that turbulently propagated along the chamber floor. Settling of the initial cargo of entrained plagioclase laths resulted in the formation of a thick sequence of feldspathic mush. The remaining melt turbulently outruns on the chamber floor ahead of the feldspathic mush. This led to the density current becoming stratified into two layers: (1) a basal granular layer, and (2) an upper melt-rich layer. Both layers evolved in a viscous-dominated regime from a Newtonian to a non-Newtonian behaviour (i.e. a power law fluid). In the current's propagation stage, the resident magma in the chamber was entrained and efficiently admixed into the melt-dominated upper layer, producing a superheated chromite-saturated hybrid melt. Chromite precipitation from this hybrid melt led to the formation of a series of chromite-laden slurries that flowed in the turbulent current and were split (‘bifurcated’) as they passed around rising buoyant plagioclase diapirs that were developing in the back of the current. This led to the anastomosing and bifurcating nature of the UG-1 chromitites. The chromite slurries merged in the tail of the current and eventually back-injected into the deposited plagioclase cumulates on the chamber floor—forming the main ∼2-m thick UG-1 chromitite layer. The cooling and crystallization of the propagating upper layer of the current led to an increase in its viscosity that slowed its velocity until it eventually stagnated on the chamber floor. The mechanical sorting of crystals in plume structures became dominant at the stagnation stage. We argue that spatial variations in crystal packing controlled the heterogeneous distribution of brittle and ductile deformation features that are observed at Dwars River. In situ crystallization of trapped pore melts led to the nucleation of large orthopyroxene and plagioclase oikocrysts that cemented the anorthosite and the chromitite layers, respectively. The emplacement of magmatic density currents and intra-chamber magma mixing may be pertinent to the development of stratiform chromitites in incrementally constructed magma chambers.},
  keywords={layered intrusions;Bushveld Complex;magmatic density current;magma mixing;chromitites},
  doi={10.1093/petrology/egab056},
  ISSN={1460-2415},
  month={Jan},}@INPROCEEDINGS{10987282,
  author={P, Ajith Kumar B and Suresh, Shilpa and S, Asha C and Vincent, Shweta and Bhat, Ganesh V},
  booktitle={2025 International Conference on Artificial Intelligence and Data Engineering (AIDE)}, 
  title={The study on the impact of activation function and pooling strategies on U-Net-based medical image fusion of traumatic brain images}, 
  year={2025},
  volume={},
  number={},
  pages={951-955},
  abstract={Image fusion is the technique in which two or more images are merged to enrich the information content of the image. In this study fusion of CT and MRI images is carried out using U-net architecture-based CNN model. In CNN, activation function and pooling strategies play a main role in determining the quality enrichment of fused images. Activation functions (AF) provide non-linear learning, helping build robust training models with a wide range of feature extraction improving the model performance. Pooling is a technique used in CNN to down-sample the image and to improve the spatial dimension by retaining the information in the image. In this study, we aim to identify the combinations of activation function and pooling strategy to improve the neural network performance, we inspect the effectiveness of the ReLU and Sigmoid functions with a combination of max pooling and average pooling techniques. These combinations are evaluated using a series of metrics: Peak Signal Noise Ratio (PSNR), Structure Similarity Index (SSIM), Mean Squared Error (MSE), Entropy, Fusion Factor, Mutual Information (MI), and Edge Preservation with the best values of 70.0073, 0.8547, 15.61, 1.2205, 0.8546, 0.2559, 0.3388 respectively. The results imply that the ReLU activation function, when united with max pooling, consistently improves the performance of the U-Net model in most measures. This combination provides better performance extraction and preserves important details in the processed image.},
  keywords={Training;Measurement;PSNR;Magnetic resonance imaging;Noise;Feature extraction;Entropy;Indexes;Image fusion;Mutual information;CNN;Activation function;pooling;image fusion},
  doi={10.1109/AIDE64228.2025.10987282},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11386654,
  author={Rani, Santosh and Mangla, Neeraj},
  booktitle={2025 5th International Conference on Advancement in Electronics & Communication Engineering (AECE)}, 
  title={Bipolar Prediction Multimodal Network: A Machine Learning Model for Euthymic Bipolar Disorder Disease}, 
  year={2025},
  volume={},
  number={},
  pages={659-664},
  abstract={The early identification of Euthymic Bipolar Disorder (BD) is extremely important to gain quick intervention and better patient outcomes, but it is still a difficult task because of the very slight symptoms exhibited during the euthymic phase. The paper puts forth the Bipolar Prediction Multimodal Network (BPMNet), which is an efficient Machine Learning (ML) framework that employs clinical, physiological, and behavioral data for the exact BD prediction. BPM-Net merges a Clinical Encoder for structured health records with a Time-Series Encoder for behavioral patterns, along with a Fusion Layer that brings together multimodal features for final classification. BPM-Net, after being trained on a wide-ranging dataset made up of Electronic Health Records (EHRs) and survey responses, attained 98.7% accuracy, and thus surpassed traditional models like Logistic Regression (LR), Long Short-Term Memory (LSTM), and Recurrent Neural Network (RNN). The results reveal that BPM-Net can be beneficial in the early BD diagnosis, offer support to personalized treatment, and make continuous monitoring easier. This study highlights the importance of multimodal ML in the psychiatric diagnostics and clinical decision-making area transformation.},
  keywords={Surveys;Logistic regression;Recurrent neural networks;Accuracy;Mood;Medical services;Predictive models;Biomedical monitoring;Long short term memory;Monitoring;Machine Learning;Euthymic Bipolar Disorder;BPM-Net;Recurrent Neural Network;Long Short-Term Memory;Logistic Regression},
