  month={Sep.},}@INPROCEEDINGS{8274120,
  author={Wang, Biyang and Wang, Xifan and Wang, Xiuli and Shao, Chengcheng},
  booktitle={2017 IEEE Power & Energy Society General Meeting}, 
  title={Reliability evaluation of offshore wind power plants considering environmental effect}, 
  year={2017},
  volume={},
  number={},
  pages={1-1},
  abstract={The equipment in offshore wind power plants suffers from harsh environmental impact which could induce common cause failures (CCFs). However, it has not attracted enough attention until now. A reliability model of offshore wind power plants considering CCF is proposed in this paper, to include the long-term effect of strong wind, ocean waves and air corrosion. For general application to various collector system topologies, an analytical protection zone and equivalent power unit model is proposed with CCF model merged via implicit method rigorously. At last, the proposed approach has been verified by the case study. Compared with other two simplified methods, the necessity of considering CCF is displayed. The effect of failure data error is also analyzed.},
  keywords={Reliability;Indexes;Periodic structures;Topology;Erbium;Probability;Manganese;offshore wind plant;reliability evaluation;common cause failure;environmental effect},
  doi={10.1109/PESGM.2017.8274120},
