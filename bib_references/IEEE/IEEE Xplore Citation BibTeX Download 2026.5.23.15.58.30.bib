  booktitle={2010 IEEE International Conference on Intelligent Computing and Intelligent Systems}, 
  title={Complete 3D model reconstruction using two types of depth sensors}, 
  year={2010},
  volume={1},
  number={},
  pages={162-166},
  abstract={We propose a fast and simple application system of 3D model reconstruction. We acquire range images by using a combination of a regular camera and two types of depth sensors. The reconstruction of a 3D model consists of four key steps: (i) Initial alignment either feature tracking or the 4-points congruent sets algorithm is used to align surfaces captured at different frames. (ii)The iterative closest point (ICP) method is applied to further align the piecewise surfaces from the last step. (iii) The surfaces are merged into a whole 3D model by the volumetric method. (iv) In the refinement step, we fill holes and produce a complete 3D model that approximates the original model with robust repair of polygonal models. At last, we present the experimental results which show that the errors between our reconstructed model and the ground truth are less than 1%.},
  keywords={Biological system modeling;Economics;Biomedical imaging;Reflection;Computers;Image recognition;3D model;reconstruction;range image integration},
  doi={10.1109/ICICISYS.2010.5658733},
  ISSN={},
