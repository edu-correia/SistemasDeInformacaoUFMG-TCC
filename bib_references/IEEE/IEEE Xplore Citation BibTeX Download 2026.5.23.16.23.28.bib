  booktitle={2023 8th South-East Europe Design Automation, Computer Engineering, Computer Networks and Social Media Conference (SEEDA-CECNSM)}, 
  title={Accelerate Processing of Image with the Keccak-512 Algorithm on Cryptoprocessor}, 
  year={2023},
  volume={},
  number={},
  pages={1-4},
  abstract={Image hashing is a crucial technique for content authentication and image retrieval in various applications, including multimedia databases and copyright protection. This study introduces a novel approach to image hashing that leverages the capabilities of FPGAs and harnesses the cryptographic strength and computational efficiency of the Keccak-512 algorithm. Our experimentations were conducted on the Intel Arria 10 GX FPGA board, and the versatile Nios II enhanced micropro-cessor. The results gleaned from these experiments underscore the tremendous potential of our FPGA-based image-hashing approach. It presents an alluring solution, merging efficiency with security, effectively addressing the burgeoning demands for content authentication and image integrity verification across diverse image-centric applications. This approach provides a powerful tool for addressing the increasing demand for image authentication and integrity verification in the digital age.},
  keywords={Design automation;Social networking (online);Merging;Image retrieval;Authentication;Europe;Multimedia databases;Cryptography;Keccak-512;NIOS II enhanced microprocessor;Image hashing;FPGA},
  doi={10.1109/SEEDA-CECNSM61561.2023.10470528},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11452785,
