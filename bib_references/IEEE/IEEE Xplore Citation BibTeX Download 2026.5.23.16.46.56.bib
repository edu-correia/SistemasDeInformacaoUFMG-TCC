  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The large model size and high computational cost of the Document Understanding Transformer (Donut) and other OCR-free architectures from the Visual Document Understanding (VDU) models pose significant obstacles to scalable and practical deployment. In this paper, we present Slim-Donut, a new lightweight and scalable framework designed for high-throughput generation of ToCs (Table of Contents). Slim-Donut optimizes the standard Donut architecture through a two-pronged approach: first, it incorporates a dynamic token slimming module into the Swin Transformer encoder to reduce computational complexity by adaptively merging redundant visual features; second, it employs post-training quantization and knowledge distillation to significantly compress the model size while preserving high fidelity. By fine-tuning the comprehensive DocLayNet dataset, Slim-Donut learns to accurately identify and structure hierarchical headers. Our experimental evaluation shows that Slim-Donut achieves an $8 \times$ improvement in CPU inference speed, a $3 \times$ reduction in model parameters, and a $2.5 \times$ reduction in GFLOPs compared to the baseline Donut model, while maintaining comparable accuracy. Furthermore, it outperforms other leading architectures like LayoutLMv3 in scalability and deployment readiness. Crucially, this efficiency is achieved with only a minimal trade-off in extraction accuracy, establishing a new, highly favorable point on the performance efficiency frontier for document indexing tasks. This work demonstrates the immense potential of architectural optimization and model compression to create practical, scalable solutions for automated document structuring.},
  keywords={Visualization;Accuracy;Quantization (signal);Computational modeling;Scalability;Computer architecture;Transformers;Model compression;Standards;Optimization;Table of Contents Generation;Visual Document Understanding;Lightweight Model;Donut model;DocyLayNet dataset},
  doi={10.1109/SCI68648.2025.11333857},
  ISSN={},
  month={Dec},}@ARTICLE{11520675,
  author={Li, Zhongbin and Yue, Kun and Li, Jianyu and Yu, Lixing and Tang, Zhiwen},
  journal={IEEE Transactions on Emerging Topics in Computational Intelligence}, 
  title={Box Embedding With Probabilistic Reasoning for FOL Queries Over Knowledge Graph}, 
  year={2026},
  volume={},
  number={},
  pages={1-13},
  abstract={The limitations of existing approaches for modeling first-order logic (FOL) queries over knowledge graphs (KGs) have motivated the development of probabilistic reasoning methods. While box embedding techniques provide a flexible geometric framework for complex query answering, they primarily rely on local operator-level transformations. As a result, it becomes difficult to strictly preserve logical constraints, particularly for negation and compositional reasoning under complex query structures. Moreover, approximation strategies such as simple averaging or neural merging operations may introduce accumulated errors during multi-step inference. To address these challenges, we propose an MLN-enhanced box embedding framework that integrates probabilistic logical reasoning into geometric query modeling. Specifically, we construct logical expressions from relations in KG and predicates in FOL queries, and develop corresponding Markov Logic Network (MLN) structures to capture global dependencies among entities and relations. These MLN-derived dependencies are then leveraged to guide the execution of projection, intersection, union, and negation operators in the box embedding space. To ensure scalability on large knowledge graphs with numerous entities, we further introduce a variational expectation–maximization (VEM) based MLN learning strategy, enabling efficient parameter estimation and inference. By jointly modeling the correlations between input boxes and newly generated boxes through MLN parameters, our approach aligns local geometric operations with global relational semantics. Extensive experimental results demonstrate that the proposed method consistently outperforms existing approaches across multiple benchmark datasets.},
  keywords={Modeling;Cognition;Cognitive systems;Knowledge graphs;Learning (artificial intelligence);Educational institutions;Distance measurement;Logic;Graph neural networks;Labeling;Knowledge graph;probabilistic reasoning;description logics;Markov logic network;box embedding},
  doi={10.1109/TETCI.2026.3690060},
  ISSN={2471-285X},
