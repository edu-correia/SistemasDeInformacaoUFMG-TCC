  month={},}@INPROCEEDINGS{11182088,
  author={Zou, Bo and Cui, Shaoguo},
  booktitle={2025 7th International Conference on Next Generation Data-driven Networks (NGDN)}, 
  title={HC-C0NG: A Hierarchical Clustering Algorithm Based on Co-nearest Natural Graph for Complex Data Distributions}, 
  year={2025},
  volume={},
  number={},
  pages={309-315},
  abstract={Clustering complex-structured datasets—characterized by clusters of varying shapes, densities, and scales—poses a significant challenge for traditional algorithms, particularly in noisy environments and when cluster boundaries are ambiguous. Existing natural neighbor-based clustering methods often struggle with such data due to sensitivity to density fluctuations and noise interference. In this paper, we propose a hierarchical clustering based on co-nearest natural graph (HC-C0NG) to address these challenges. First, we introduce a C0NG construction strategy that sparsifies neighbor relations, effectively reducing the impact of noise and outliers. Using the constructed C0NG, HC-C0NG partitions the dataset into multiple subgraphs. These subgraphs are then progressively merged based on a newly defined subgraph similarity metric, which enhances the accuracy of grouping similar substructures, even under varying densities. Additionally, we improve the construction of the natural neighborhood graph to better capture underlying structures in datasets with blurred cluster boundaries. Extensive experiments on synthetic and real-world datasets demonstrate that HC-C0NG achieves superior performance in identifying complex and noisy clusters compared to several state-of-the-art hierarchical and density-based clustering algorithms.},
  keywords={Sensitivity;Shape;High dimensional data;Clustering methods;Noise;Clustering algorithms;Interference;Robustness;Noise measurement;Next generation networking;Hierarchical Clustering;Natural Neighbor Graph;Co-nearest Natural Graph},
  doi={10.1109/NGDN66208.2025.11182088},
  ISSN={},
  month={June},}@ARTICLE{11515044,
  author={Nayak, Srikumar and Kumar, Rohit},
  journal={IEEE Access}, 
  title={Quantum-Enhanced AML: Hybrid Quantum–Classical Graph Learning With Entity Resolution and Evidence Subgraph Discovery for Transaction Screening}, 
  year={2026},
  volume={14},
  number={},
  pages={74837-74850},
  abstract={Anti-money laundering (AML) monitoring must detect hidden illicit fund flows from large, noisy, and highly connected financial transactions. In practice, laundering behavior is rarely visible in a single transaction; it appears as multi-hop paths across accounts, devices, merchants, and services. However, real AML graphs are unreliable because identities are fragmented (duplicate customers, shared devices, reused phone numbers), and many systems still generate alerts without strong evidence trails. This reduces both detection quality and investigation speed, especially when the network structure changes over time. To address this, we propose Quantum-Enhanced AML, a hybrid quantum–classical graph learning pipeline for transaction screening. First, we build a transaction–entity graph and apply graph-based entity resolution to merge duplicate identities and recover a cleaner actor-level structure. Next, we learn temporal graph embeddings using a classical encoder enhanced with a lightweight quantum embedding layer, so the model captures compact relational patterns even under noisy links. We further add a contrastive self-supervised objective to stabilize representations across time windows. Finally, for every flagged case, the system extracts an evidence subgraph that highlights key paths and neighbors responsible for the risk decision, which supports audit and analyst review. Experiments on a time-aware split show that Quantum-Enhanced AML achieves strong screening performance, with F1 up to 0.969 and AUC up to 0.995, while consistently producing case-ready evidence graphs. Ablation results confirm that entity resolution improves actor consistency and that temporal self-supervision improves generalization. Overall, the proposed pipeline provides accurate detection with practical explainability for compliance-focused deployment.},
  keywords={Modeling;Automated machine learning;Learning (artificial intelligence);Timing;Training;Signal detection;Erbium;Joining processes;Labeling;Graph neural networks;Anti-money laundering;financial transaction graphs;entity resolution;heterogeneous graphs;temporal graph learning;quantum machine learning;hybrid quantum–classical models;contrastive self-supervision;suspicious subgraph discovery;explainable fraud detection},
  doi={10.1109/ACCESS.2026.3692342},
