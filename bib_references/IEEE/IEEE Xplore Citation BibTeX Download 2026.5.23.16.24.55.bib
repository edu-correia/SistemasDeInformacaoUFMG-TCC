  abstract={Ancient community detection, it's tougher to seek out overlapping communities complicated networks, particularly once the multimedia system social networks however, actual covering group revelation with swarm intelligence oftentimes induce covering group structures with extreme tiny group. To review with the difficulty, during this paper, associate degree economical formula (LEPSO) is suggest for covering group finding that is predicated on line chart hypothesis, learning method improvement. Particularly, a separate PSO, together with associate degree cryptography theme with ordered neighbors and strategy of node change with ensemble bunch, is concocted for rising the improvement capability to go looking communities which are unseen in social networks. then, a postprocessing approach is provided for combining the finer-grained and imperfect covering communities. The contribution work is Weak Cliques Percolation Method (W-PCM) for overlapping community detection that may be a new live for distinguishing similitude between weak cliques, is additionally steered to ascertain whether or not the weak cliques can be combined into a community.},
  keywords={Learning systems;Social networking (online);Reviews;Multimedia systems;Instruments;Image edge detection;Merging;Clustering algorithms;Robustness;Particle swarm optimization;Social Network;Particle Swarm Optimization (PSO);Ensemble learning;Line Graph;Overlapping Communities Detection;Clique percolation;Weak Clique},
  doi={10.1109/ICICICT46008.2019.8993262},
  ISSN={},
  month={July},}@INPROCEEDINGS{9224774,
  author={Yan, Zhihui and Lv, Lijuan and Wu, Shuanghui and Su, Yaxin and Wang, Zhenyu and Zhang, Zhen},
  booktitle={2019 IEEE 8th International Conference on Advanced Power System Automation and Protection (APAP)}, 
  title={Research on the sampling reliability of process layer device in smart substation}, 
  year={2019},
  volume={},
  number={},
  pages={248-252},
  abstract={The double A/D sampling circuit is applied in the traditional substation to improve the reliability of relay equipment. In the process layer, the double A/D sampling circuit of the smart substation have differences with the traditional substation, the malfunction of relay protection is possibility caused by the abnormal operation of a single component. In this paper, by analyzing the structure of the smart substation sampling circuit, the weaknesses of sampling circuit in the smart substation would be found out. This paper points out two hardware redundancy design methods and analyzes the advantages and disadvantages of these two methods. The application of these two methods could solve the malfunction of relay protection device which is caused by the damage of single component in smart substation.},
  keywords={Substations;Hardware;Merging;Analog-digital conversion;Protective relaying;Redundancy;Sensors;Double A/D sampling;Process layer device;Reliability;Smart substation},
  doi={10.1109/APAP47170.2019.9224774},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10979152,
  author={Mutti, Stefano and Fausti, Roberto and Pedrocchi, Nicola and Valente, Anna},
  booktitle={2025 IEEE International Conference on Simulation, Modeling, and Programming for Autonomous Robots (SIMPAR)}, 
  title={Augmented Costmap-Based Path Planning and Control for Multi-Mobile Robot Rigid Formation}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This work proposes a novel method to generate an environment costmap to plan a feasible path for multiple autonomous mobile robots in a rigid formation using a leader-follower approach and a regulation algorithm to control the mobile robots during navigation. The method is based on a costmap merging technique in which the involved robots’ two-dimensional costmaps are merged into a three-dimensional one that embeds the environment description and the rigid structure of the multi-robot formation by means of sampling the leader’s rotations on the additional dimension of the generated costmap. The resulting three-dimensional grid is then employed to plan an optimal path for the robots’ formation, using a graph-based path-finding algorithm such as A∗ or Theta∗. This enables the whole planning task to be pursued only with respect to the leader while generating feasible trajectories also for followers. Finally, the method includes a control method to regulate the following mobile platforms in the nominal configuration during the navigation. The devised model is tested in different simulated scenarios and on a real setup.},
  keywords={Three-dimensional displays;Navigation;Computational modeling;Green products;Programming;Regulation;Planning;Trajectory;Mobile robots;Autonomous robots},
  doi={10.1109/SIMPAR62925.2025.10979152},
  ISSN={},
  month={April},}@INPROCEEDINGS{11492372,
  author={Nehdi, Taha Mustapha and Mrabah, Nairouz and Belal, Atif and Pedersoli, Marco and Granger, Eric},
  booktitle={2026 IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)}, 
  title={Low-Rank Expert Merging for Multi-Source Domain Adaptation in Person Re-Identification}, 
  year={2026},
  volume={},
  number={},
  pages={1809-1819},
  abstract={Adapting person re-identification (reID) models to new target environments remains a challenging problem that is typically addressed using unsupervised domain adaptation (UDA) methods. Recent works show that when labeled data originates from several distinct sources (e.g., datasets and cameras), considering each source separately and applying multi-source domain adaptation (MSDA) typically yields higher accuracy and robustness compared to blending the sources and performing conventional UDA. However, state-of-the-art MSDA methods learn domain-specific backbone models or require access to source domain data during adaptation, resulting in significant growth in training parameters and computational cost. In this paper, a Source-free Adaptive Gated Experts (SAGE-reID) method is introduced for person reID. Our SAGE-reID is a cost-effective, source-free MSDA method that first trains individual source-specific low-rank adapters (LoRA) through source-free UDA. Then, a lightweight gating network is introduced and trained to dynamically assign optimal merging weights for fusion of LoRA experts, enabling effective cross-domain knowledge transfer. While the number of backbone parameters remains constant across source domains, LoRA experts scale linearly but remain negligible in size (ď 2% per source), reducing both the memory consumption and risk of overfitting. Extensive experiments conducted on three challenging benchmarks – Market-1501, DukeMTMC-reID, and MSMT17 – indicate that SAGE-reID can outperform state-of-the-art methods while remaining computationally efficient. Our code is available: https://github.com/nehdiii/SAGE-reID},
  keywords={Through-silicon vias;Filtering;Filters;Integrated circuits;LoRa;Protocols;Communication systems;Data communication;HTTP;Telecommunications;person re-identification;multi-source domain adaptation;source-free adaptation;low-rank adapters;expert merging},
  doi={10.1109/WACV61042.2026.00181},
  ISSN={2642-9381},
  month={March},}@INPROCEEDINGS{9816187,
  author={Li, Qi and Qi, Peng and Min, JiangSong and Sun, Yan},
  booktitle={2021 Ninth International Conference on Advanced Cloud and Big Data (CBD)}, 
  title={An Automatic Question Classification Model Based on Solving Programs for Online Judge Platforms}, 
  year={2022},
  volume={},
  number={},
  pages={164-169},
  abstract={Nowadays, online judge platforms are popular among programming learners. However, the questions of online judge platforms are usually arranged randomly and without regard to their knowledge relations, which makes it inefficient for users to learn to program. To solve this issue, we develop an automatic question classification model based on the knowledge points of question-solving programs. First, the question-solving programs are processed to abstract syntax trees. Based on the abstract syntax trees, three different sampling schemes are designed to extract token sequences while preserving semantic and structural information of programs. Then, the token sequences are input into Word2Vec for learning program representations. After that, the TextCNN is adopted to generate significant program features from program representations. Finally, the program features are merged and input to a linear classifier for classifying predictions. Experimental results show that our model can effectively preserve the semantic and structural features of programs, and our model performs better than other competing methods in the question classifying task.},
  keywords={Semantics;Syntactics;Programming;Big Data;Feature extraction;Data models;Classification algorithms;question classification;path sampling;program representation},
  doi={10.1109/CBD54617.2021.00036},
  ISSN={},
  month={March},}@INPROCEEDINGS{10055918,
  author={Feng, Liying and Zhang, Xiaoli and Peng, Xiafu and Zhuang, Mingxi},
  booktitle={2022 China Automation Congress (CAC)}, 
  title={Monocular Visual-Inertial Odometry with Point and Line Features Using Improved Line Feature Extraction}, 
  year={2022},
  volume={},
  number={},
  pages={4107-4112},
  abstract={Visual-inertial odometry that uses point features only has poor localization performance in the low-texture environments, or even fails. The introduction of line features can improve this situation, because line features have richer scene structure information and can appropriately improve the positioning accuracy. We propose a real-time optimized tightly coupled visual-inertial algorithm, which based on point-line features. It can achieve a good balance in the positioning accuracy and the real-time performance. The front-end part proposes an algorithm for adjusting image brightness based on image preprocessing to increase the number of image feature extractions in low-light environments. In order to reduce the wrong segmentation of long line features, the least squares method is used to combine short line segments with similar directions and distances, thereby reducing the difficulty of matching line features. Experiments on the EuRoc dataset show that, under the same experimental environment, our algorithm has higher stability and positioning accuracy compared with the mainstream VIO algorithm based only on point features. At the same time, compared with PL-VINS which uses point-line features, our algorithm improves the positioning accuracy by 6%-7%.},
  keywords={Location awareness;Image segmentation;Tracking loops;Brightness;Merging;Feature extraction;Real-time systems;visual-inertial odometry;point and line features;nonlinear optimization;image preprocessing;extraction of line features},
  doi={10.1109/CAC57257.2022.10055918},
  ISSN={2688-0938},
  month={Nov},}@INPROCEEDINGS{10717202,
  author={Akash, A and Ramana, A and Sivapalanirajan, M and Kishore, J and Kishore Kumar, P and Willjuice Iruthayarajan, M},
  booktitle={2024 10th International Conference on Advanced Computing and Communication Systems (ICACCS)}, 
  title={Gyroscopic Control of Tankbot with Obstacle Avoidance and Performance Comparison in Different Terrains}, 
  year={2024},
  volume={1},
  number={},
  pages={450-454},
  abstract={Robot structure plays a vital role in handling different terrains. TankBot is a rugged design that uses sensors for navigation through sloppy surfaces. In this work, the Gyro sensor provides information to the robot pose and propagates to the target point through the environment. TankBot needs to handle obstacles for wheel safety by collision detection avoidance mechanism. It is equipped with a cliff sensor for collision detection and an ultrasonic sensor for static obstacle avoidance. The robot is in a start position in the workspace, and it proceeds to the target point without collision using various controllers through gyro reference. Controller performance comparison shows that PID controller performance is 13.3% better in handling obstacle environments and 8% faster in handling sloppy surfaces. The robot performance is validated using LEGO Mindstorm EV3 as TankBot design.},
  keywords={Navigation;Merging;Wheels;Robot sensing systems;Sensors;Gyroscopes;Safety;Performance analysis;Mobile robots;Collision avoidance;TankBot;PID controller;Gyroscope;Obstacle avoidance;Target tracking},
  doi={10.1109/ICACCS60874.2024.10717202},
  ISSN={2575-7288},
  month={March},}@INPROCEEDINGS{9008810,
  author={Chen, Jiacheng and Liu, Chen and Wu, Jiaye and Furukawa, Yasutaka},
  booktitle={2019 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Floor-SP: Inverse CAD for Floorplans by Sequential Room-Wise Shortest Path}, 
  year={2019},
  volume={},
  number={},
  pages={2661-2670},
  abstract={This paper proposes a new approach for automated floorplan reconstruction from RGBD scans, a major milestone in indoor mapping research. The approach, dubbed Floor-SP, formulates a novel optimization problem, where room-wise coordinate descent sequentially solves shortest path problems to optimize the floorplan graph structure. The objective function consists of data terms guided by deep neural networks, consistency terms encouraging adjacent rooms to share corners and walls, and the model complexity term. The approach does not require corner/edge primitive extraction unlike most other methods. We have evaluated our system on production-quality RGBD scans of 527 apartments or houses, including many units with non-Manhattan structures. Qualitative and quantitative evaluations demonstrate a significant performance boost over the current state-of-the-art. Please refer to our project website http://jcchen.me/floor-sp/ for code and data.},
  keywords={Image reconstruction;Optimization;Topology;Image edge detection;Shortest path problem;Merging;Image segmentation},
  doi={10.1109/ICCV.2019.00275},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{10205148,
  author={Jin, Peng and Huang, Jinfa and Xiong, Pengfei and Tian, Shangxuan and Liu, Chang and Ji, Xiangyang and Yuan, Li and Chen, Jie},
  booktitle={2023 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)}, 
  title={Video-Text as Game Players: Hierarchical Banzhaf Interaction for Cross-Modal Representation Learning}, 
  year={2023},
  volume={},
  number={},
  pages={2472-2482},
  abstract={Contrastive learning-based video-language representation learning approaches, e.g., CLIP, have achieved outstanding performance, which pursue semantic interaction upon pre-defined video-text pairs. To clarify this coarse-grained global interaction and move a step further, we have to encounter challenging shell-breaking interactions for fine-grained cross-modal learning. In this paper, we creatively model video-text as game players with multivariate cooperative game theory to wisely handle the uncertainty during fine-grained semantic interaction with diverse granularity, flexible combination, and vague intensity. Concretely, we propose Hierarchical Banzhaf Interaction (HBI) to value possible correspondence between video frames and text words for sensitive and explainable cross-modal contrast. To efficiently realize the cooperative game of multiple video frames and multiple text words, the proposed method clusters the original video frames (text words) and computes the Banzhaf Interaction between the merged tokens. By stacking token merge modules, we achieve cooperative games at different semantic levels. Extensive experiments on commonly used text-video retrieval and video-question answering bench-marks with superior performances justify the efficacy of our HBI. More encouragingly, it can also serve as a visualization tool to promote the understanding of cross-modal interaction, which have a far-reaching impact on the community. Project page is available at https://jpthu17.github.io/HBI/.},
  keywords={Representation learning;Visualization;Computer vision;Uncertainty;Semantics;Stacking;Games;Vision;language;and reasoning},
  doi={10.1109/CVPR52729.2023.00244},
  ISSN={2575-7075},
  month={June},}@ARTICLE{9207830,
  author={Menon, Prashanth and Qadah, Thamir M. and Rabl, Tilmann and Sadoghi, Mohammad and Jacobsen, Hans-Arno},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={LogStore: A Workload-Aware, Adaptable Key-Value Store on Hybrid Storage Systems}, 
  year={2022},
  volume={34},
  number={8},
  pages={3867-3882},
  abstract={Due to recent explosion of data volume and velocity, a new array of lightweight key-value stores have emerged to serve as alternatives to traditional databases. The majority of these storage engines, however, sacrifice their read performance in order to cope with write throughput by avoiding random disk access when writing a record in favor of fast sequential accesses. But, the boundary between sequential versus random access is becoming blurred with the advent of solid-state drives (SSDs). In this work, we propose our new key-value store, LogStore, optimized for hybrid storage architectures. Additionally, introduce a novel cost-based data staging model based on log-structured storage, in which recent changes are first stored on SSDs, and pushed to HDD as it ages, while minimizing the read/write amplification for merging data from SSDs and HDDs. Furthermore, we take a holistic approach in improving both the read and write performance by dynamically optimizing the data layout, such as deferring and reversing the compaction process, and developing an access strategy to leverage the strengths of each available medium in our storage hierarchy. Lastly, in our extensive evaluation, we demonstrate that LogStore achieves up to 6x improvement in throughput/latency over LevelDB, a state-of-the-art key-value store.},
  keywords={Compaction;Databases;Merging;Buffer storage;Throughput;Hardware;Performance evaluation;Information systems;database systems;data systems;data storage systems;adaptive algorithms;log-structured storage systems;key-value stores;compaction management;hybrid storage architecture},
  doi={10.1109/TKDE.2020.3027191},
  ISSN={1558-2191},
  month={Aug},}@INPROCEEDINGS{10594104,
  author={Chen, Zhen and Li, Wenjin and Yin, Fanjiao and Deng, Xun and Zhou, Guiming and Pan, Wangshi and Gu, Hao},
  booktitle={2024 IEEE 4th International Conference on Electronic Technology, Communication and Information (ICETCI)}, 
  title={Research on intelligent power grid operation and maintenance and fault prediction system based on artificial intelligence}, 
  year={2024},
  volume={},
  number={},
  pages={1281-1286},
  abstract={The growing complexity of power systems and the heightened need for stable power supply have made the study and creation of intelligent grid operation, maintenance, and fault prediction systems a critical technical priority. This study seeks to devise a sophisticated AI technology framework that seamlessly merges convolutional neural networks (CNN) and recurrent neural networks (RNN) for the real-time monitoring, smart diagnosis, and advance warning of faults in power grid equipment. This system first focuses on the collection and processing of large-scale power grid operation data, including equipment key parameters, environmental conditions, operation history and other dimensions of information. Big data analysis technology is used for efficient data cleaning, integration and deep mining, and then a detailed and accurate power grid operating state model is built. The core is to use convolutional neural network to capture spatial and local features in equipment data, and recurrent neural network to process time series data. The organic combination of the two can realize real-time monitoring of the operating status of power grid equipment and accurate assessment of its health status, so as to achieve early identification and accurate positioning of potential faults. At the same time, the system relies on the machine learning prediction model, especially the combination of historical fault cases and real-time monitoring data, and uses the rich features generated by CNN and RNN to make probabilistic prediction of the future fault possibility, providing scientific data support and decision-making reference for preventive maintenance measures. The intelligent operation and fault prediction system, which leverages both convolutional neural network and recurrent neural network, will significantly enhance the efficiency of power grid operation and maintenance. By lowering operational costs and mitigating the risk of significant power outages at their origin, it ensures the power grid system operates safely and reliably.},
  keywords={Recurrent neural networks;Accuracy;Time series analysis;Probabilistic logic;Power grids;Real-time systems;Data models;Deep learning;Artificial intelligence;Power grid operation and maintenance;Failure prediction},
  doi={10.1109/ICETCI61221.2024.10594104},
  ISSN={},
  month={May},}@INPROCEEDINGS{9615515,
  author={Taeb, Sepehr and Shahriar, Nashid and Chowdhury, Shihabur R. and Tornatore, Massimo and Boutaba, Raouf and Mitra, Jeebak and Hemmati, Mahdi},
  booktitle={2021 17th International Conference on Network and Service Management (CNSM)}, 
  title={Reoptimizing Network Slice Embedding on EON-enabled Transport Networks}, 
  year={2021},
  volume={},
  number={},
  pages={292-300},
  abstract={5G transport networks will support dynamic services with diverse requirements through network slicing. Elastic Optical Networks (EONs) facilitate transport network slicing by flexible spectrum allocation and tuning of transmission configurations such as modulation format and forward error correction. A major challenge in supporting dynamic services is the lack of a priori knowledge of future slice requests. In consequence, slice embedding can become sub-optimal over time, leading to spectrum fragmentation and skewed utilization. This in turn can block future slice requests, impacting operator revenue. Therefore, operators need to periodically re-optimize slice embedding for reducing fragmentation. In this paper, we address this problem of re-optimizing network slice embedding on EONs for minimizing fragmentation. The problem is solved in its splittable version, which significantly increases problem complexity, but offers more opportunities for a larger set of re-configuration actions. We employ simulated annealing for systematically exploring the large solution space. We also propose a greedy algorithm to address the practical constraint to limit the number of re-configuration steps taken to reach a defragmentated state. Our extensive simulations demonstrate that the greedy algorithm yields a solution very close to that obtained using simulated annealing while requiring orders of magnitude lesser number of re-configuration actions.},
  keywords={Greedy algorithms;Virtual links;Network slicing;Simulation;Merging;Modulation;Simulated annealing},
  doi={10.23919/CNSM52442.2021.9615515},
  ISSN={2165-963X},
  month={Oct},}@INPROCEEDINGS{11016597,
  author={Kakoun, Nathalie Al and Ali, Fatima El and Harb, Mohammad},
  booktitle={2025 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={Merging Studio-Based Learning With Flipped Classroom Techniques: Ensuring Support and Focus in Engineering Education}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={Numerous educators have emphasised the wideranging benefits of studio-based learning (SBL) within the context of engineering education, while others have praised the positive aspects of digitally enhanced, flipped learning methodologies. In this research, we investigate an innovative approach to teaching a technical engineering materials course that effectively combines these two pedagogical strategies. By incorporating both a flipped classroom model and a studiobased learning environment, our objective was to cultivate a more engaging, interactive, and effective educational experience for students. To assess the impact and overall effectiveness of this learning format, we meticulously analysed students' survey responses, academic engagement, and their perceptions regarding the newly structured course. Our findings revealed a pronounced preference among students for this new format in comparison to the traditional lecture-based approach. This strong preference was clearly indicated in their survey responses and was also evident in their high levels of engagement. The newly established learning environment fostered a significantly stronger sense of community and collaboration among the students. Participants reported feeling more connected to and supported by their peers, and contributed to creating a more productive, less distracted and more focused atmosphere within the studio. An indication of a significantly enhanced focus, as also seen from the perceptions reported by students, seemed to enable them to engage more deeply with the course material and collaborate effectively on various projects in the studios, thereby reinforcing the advantages inherent in the combined methodologies of SBL and flipped learning. In summary, our study demonstrates that reimagining engineering education through the integration of a combined studio-based learning and flipped classroom techniques can yield significant improvements in student engagement and academic success. By prioritising supportive, collaborative and hands-on learning experiences, educators can better equip students for the multifaceted challenges of the engineering profession, providing them with essential skills and a mindset necessary to thrive in an ever-evolving field. This innovative approach not only meets the diverse needs of today's learners but also provides valuable insights that can inform future developments in engineering education.},
  keywords={Surveys;Analytical models;Electronic learning;Engineering profession;Merging;Active learning;Collaboration;Atmosphere;Online services;Engineering education;Active Learning;Studio-Based Learning;Flipped Learning;Digitally Enhanced Learning;Engineering Education;Engineering Materials},
  doi={10.1109/EDUCON62633.2025.11016597},
  ISSN={2165-9567},
  month={April},}@INPROCEEDINGS{11418482,
  author={Dauletov, Adilbek and Abdurahmonova, Uldona and Matyakubova, Noila and Bakhrieva, Khurshida and Ganixodjayeva, Dilfuza},
  booktitle={2026 5th International Informatics and Software Engineering Conference (IISEC)}, 
  title={Syntactic Alignment of Simple Sentence in Uzbek-English Parallel Corpora}, 
  year={2026},
  volume={},
  number={},
  pages={332-337},
  abstract={In the field of natural language processing (NLP), accurate alignment of text units in a parallel corpus is important for tasks such as machine translation, cross-lingual information retrieval, and bilingual lexicon creation. However, identifying simple sentences and correctly assigning their types poses certain difficulties during the alignment process, especially at the paragraph and sentence levels. This article analyzes the problems encountered in identifying and matching simple sentences and their structural differences. Factors such as syntactic differences, sentence splitting or merging, and language-specific sentence structure increase the complexity of this process. The study considers problematic situations that arise during the alignment process, proposes criteria for determining the type of simple sentences, and describes the aligning process using a rule-based method to increase the accuracy and consistency of aligning, and provides a linguistic database. The results obtained serve to improve multilingual NLP systems by improving the quality of corpus-based language resources.},
  keywords={Accuracy;Merging;Surface morphology;Morphology;Lexicon;Syntactics;Information retrieval;Multilingual;Machine translation;Software engineering;parallel corpus;simple sentences;sentence structure;alignment;rule-based method;source language;target language},
  doi={10.1109/IISEC69317.2026.11418482},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11227319,
  author={Cai, Fapeng and Feng, Ji and Chen, Zhongshang and Yang, Degang},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Hierarchical clustering algorithm based on fusion rule of competitive neighborhood graph and genetic distance}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={Natural neighbor can adaptively identify clusters of arbitrary shape. However, it is often difficult to obtain satisfactory clustering results when dealing with complex datasets. To solve this issue, this paper proposes a Hierarchical clustering algorithm based on fusion rule of competitive neighborhood graph and genetic distance (HCCG-GD). Firstly, HCCG-GD uses the competitive neighborhood graph to divide datasets into sub-clusters, effectively identifying the core regions of the data and optimizing the performance of clustering. Then, it employs a novel fusion rule based on the concept of genetic distance from biology to allocate remaining points and dynamically merge sub-clusters. The fusion rule ensures that sparse region data are correctly allocated by using the minimum genetic distance to guide the merging process. Numerical experiments based on synthetic and real datasets demonstrate the effectiveness and superiority of HCCG-GD.},
  keywords={Accuracy;Shape;Heuristic algorithms;Neural networks;Merging;Clustering algorithms;Genetics;Faces;Hierarchical clustering;Competitive neighborhood graph;Fusion rule;Genetic distance},
  doi={10.1109/IJCNN64981.2025.11227319},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{10618185,
  author={Ni, Weicheng and Ren, Kaijun and Zhao, Yanlai and Wang, Wuxin},
  booktitle={2024 Photonics & Electromagnetics Research Symposium (PIERS)}, 
  title={Quality Assessment of MAXSS Global Merged Wind Products under Tropical Cyclone Conditions}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The continuous monitoring of Tropical Cyclones (TCs) plays a crucial role in exploring TC dynamics and enabling more timely disaster responses by coastal communities. However, a mature and widely recognized dataset depicting long-term TC development is still lacking, whether in terms of satellite observations or reanalyses. The Marine Atmosphere eXtreme Satellite Synergy (MAXSS) project recently released a new global merged wind product, offering hourly 10-m stress-equivalent wind maps on a 0.25◦ grid. The project aims to enhance understanding of multi-scale air-sea interactions under extreme conditions, making the new wind product an excellent option for long-term TC research. In this study, the quality of MAXSS winds under TC conditions was assessed through statistical analysis, morphological analysis, and spatial variance evaluation. The statistical comparison among SAR, ASCAT, and MAXSS winds indicates a good consistency between SAR and MAXSS wind speeds, but an apparent overestimation of MAXSS winds compared to ASCAT results, aligning with our expectations. Notably, the wind sensitivity of MAXSS winds can be up to approximately 45m/s meanwhile in relatively lower noise or uncertainties. It suggests the great potential of the MAXSS products in TC research. However, the blurring effects persist in the products, behaving as the extension of TC eyewall structures and the loss of small-scale information. In summary, MAXSS has introduced a new and powerful global merged wind product suitable for TC studies. The preliminary quality assessment presented in the paper proves the value of these products. Nevertheless, some further improvements in TC inner structures could contribute to the more effective application of these products in the future.},
  keywords={Satellites;Uncertainty;Sensitivity;Tropical cyclones;Statistical analysis;Wind speed;Noise},
  doi={10.1109/PIERS62282.2024.10618185},
  ISSN={2831-5804},
  month={April},}@ARTICLE{10510482,
  author={Chang, Weng-Long and Wong, Renata and Chen, Yu-Hao and Chung, Wen-Yu and Chen, Ju-Chin and Vasilakos, Athanasios V.},
  journal={IEEE Transactions on NanoBioscience}, 
  title={Bioinspired Quantum Oracle Circuits for Biomolecular Solutions of the Maximum Cut Problem}, 
  year={2024},
  volume={23},
  number={3},
  pages={499-506},
  abstract={Given an undirected, unweighted graph with n vertices and m edges, the maximum cut problem is to find a partition of the n vertices into disjoint subsets  ${V}_{{1}}$  and  ${V}_{{2}}$  such that the number of edges between them is as large as possible. Classically, it is an NP-complete problem, which has potential applications ranging from circuit layout design, statistical physics, computer vision, machine learning and network science to clustering. In this paper, we propose a biomolecular and a quantum algorithm to solve the maximum cut problem for any graph G. The quantum algorithm is inspired by the biomolecular algorithm and has a quadratic speedup over its classical counterparts, where the temporal and spatial complexities are reduced to, respectively,  ${O}\text {(}\sqrt {{2}^{n}/{r}}\text {)}$  and  ${O}\text {(}{m}^{{2}}\text {)}$ . With respect to oracle-related quantum algorithms for NP-complete problems, we identify our algorithm as optimal. Furthermore, to justify the feasibility of the proposed algorithm, we successfully solve a typical maximum cut problem for a graph with three vertices and two edges by carrying out experiments on IBM’s quantum simulator.},
  keywords={Registers;Quantum algorithm;Qubit;Data structures;NP-complete problem;Quantum circuit;Bio-inspired engineering;Data structures and algorithms;the maximum cut problem;quantum algorithms;quantum computing;quantum speedup},
  doi={10.1109/TNB.2024.3395420},
  ISSN={1558-2639},
  month={July},}@ARTICLE{10492497,
  author={Wang, Bowen and Gong, Xinle and Lyu, Peiyuan and Liang, Sheng},
  journal={IEEE Transactions on Intelligent Transportation Systems}, 
  title={Iterative Learning-Based Cooperative Motion Planning and Decision-Making for Connected and Autonomous Vehicles Coordination at On-Ramps}, 
  year={2024},
  volume={25},
  number={7},
  pages={8105-8120},
  abstract={This paper proposes an iterative learning-based cooperative motion planning and decision-making approach to achieve time-optimal coordination control of connected and autonomous vehicles (CAVs) at on-ramps. In this work, a decentralized learning-based iterative optimization method (DLIO) is first developed to offline train the vehicle merging trajectories in space-time. To guarantee safety and convergence properties at each iteration, the collision-free terminal constraint set and approximated merging time cost are designed using the historical vehicle states as a dataset. For adapting the trained trajectories into dynamic traffic flow at on-ramps online, we systematically analyze the arrival time of inter-vehicle potential actions and model a decision tree to express all possible vehicle cluster passing sequences. Then, a heuristic Monte-Carlo tree search (HMCTS) algorithm with a modified searching principle is presented to derive a minimum-time passing sequence. Also, a customized two-stage velocity planning method is used to regulate the vehicle flow following the optimal sequence and trained condition. The proposed approach is verified on the SUMO and compared with three baselines under different on-ramps traffic demands. Results show that our approach enables the conflicting vehicles to merge into the mainline without queuing, rendering both robust and high efficiency multi-vehicle coordination.},
