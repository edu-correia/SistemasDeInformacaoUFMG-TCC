  month={},}@INPROCEEDINGS{9648835,
  author={Nguyen, Hoang-Gia and Le, Hoang-Dat and Nguyen, Vu},
  booktitle={2021 13th International Conference on Knowledge and Systems Engineering (KSE)}, 
  title={Prioritizing automated test cases of Web applications using reinforcement learning: an enhancement}, 
  year={2021},
  volume={},
  number={},
  pages={1-8},
  abstract={Test prioritization helps reduce the time needed to perform testing on the target application under test. It is even more critical when there are lots of tests to be tested within a short period. This paper presents a test prioritization method that enhances our previous method for prioritizing automated tests of Web-based applications using reinforcement learning. The main improvements are focused on the reward function of reinforcement learning and the graph merge-discount factor. We evaluate our method and other six recent test prioritization methods using eleven data sets. The results show that the proposed method outperforms the other methods on most data sets.},
  keywords={Measurement;Knowledge engineering;Automation;Reinforcement learning;Systems engineering and theory;Optimization;Open source software;Test case ranking;coverage graph;reinforcement learning;graphical user interface;automated testing},
  doi={10.1109/KSE53942.2021.9648835},
  ISSN={2694-4804},
  month={Nov},}@INPROCEEDINGS{9377392,
  author={Thao Nguyen, Thi Ai and Dang, Tran Khanh and Nguyen, Dinh Thanh},
  booktitle={2021 15th International Conference on Ubiquitous Information Management and Communication (IMCOM)}, 
  title={Non-Invertibility for Random Projection based Biometric Template Protection Scheme}, 
  year={2021},
  volume={},
  number={},
  pages={1-8},
  abstract={Nowadays, biometric-based authentication systems are widely used. This fact has led to increased attacks on biometric data of users. Therefore, biometric template protection is sure to keep the attention of researchers for the security of the authentication systems. Many previous works proposed the biometric template protection schemes by transforming the original biometric data into a secure domain, or establishing a cryptographic key with the use of biometric data. The main purpose was that fulfill the all three requirements: cancelability, security, and performance as many as possible. In this paper, using random projection merged with fuzzy commitment, we will introduce a hybrid scheme of biometric template protection. We try to limit their own drawbacks and take full advantages of these techniques at the same time. In addition, an analysis of non-invertibility property will be exercised with regards to the use of random projection aiming at enhancing the security of the system while preserving the discriminability of the original biometric template.},
  keywords={Biometrics (access control);Authentication;Information management;Cryptography;biometric template protection;non-invertibility;random projection;fuzzy commitment;discriminability},
  doi={10.1109/IMCOM51814.2021.9377392},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{10724792,
  author={Amruth, A and Ramanan, R and Paul, Rhea and Vimal, C and Belwal, Meena},
  booktitle={2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)}, 
  title={Advancements in String-Searching Algorithms Fastrack-StringSearch: A Novel Approach}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={String matching plays a crucial role in applications, such involving retrieval of information, data mining, natural language processing, and biology with computation. However, existing string-matching algorithms, including the Naïve Method, KMP Algorithm, Rabin-Karp Algorithm, and Suffix Array, often suffer from limitations in terms of time complexity or space complexity. Considering these shortcomings, this paper presents a novel string-searching algorithm that harnesses Merge sort and binary search techniques to optimize time complexity, while maintaining the same space complexity as traditional approaches. Drawing on compiler analysis, the proposed algorithm demonstrates a major improvement in computational time, The proposed algorithm demonstrates a major improvement in time complexity, outperforming sophisticated methods by up to 50% in the best-case scenario and matches the other algorithms in terms of speed in the worst case scenario. This advancement makes the proposed algorithm -Fastrack-StringSearch-suited for large-scale text processing.},
  keywords={Dictionaries;Natural language processing;Distance measurement;Biology;Complexity theory;Indexes;Data mining;Arrays;Time complexity;Text processing;String Matching/ Searching;Binary Search;Merge Sort;Compiler Analysis},
  doi={10.1109/ICCCNT61001.2024.10724792},
  ISSN={2473-7674},
  month={June},}@INPROCEEDINGS{11327119,
  author={A, Antonia Anne Mary and Devi, V. Anjana and A, Aby Thomas and Augasthega, R.},
