  number={},
  pages={592-601},
  abstract={Social coding environments have been consistently growing since the popularization of the contribution model known as pull-based. This model has facilitated how developers make their contributions; developers can easily place a few pull requests without further commitment. Developers without strong ties to a project, the so-called casual contributors, often make a single contribution before disappearing. Interestingly, some studies about the topic use the number of commits made to identify the casual contributors, while others use the number of merged pull requests. Does the method used influence the results? In this paper, we replicate a study about casual contributors that relied on commits to identify and analyze these contributors. To achieve this goal, we analyzed the same set of GitHub-hosted software repositories used in the original paper. By using pull requests, we found an average of 66% casual contributors (in comparison to 48.98% when using commits), who were responsible for 12.5% of the contributions accepted (1.73% when using commits). We used a sample of 442 developers to investigate the accuracy of the method. We found that 11.3% of the contributors identified using the pull requests were misclassified (26.2% using commits). We also evidenced that using pull requests is more precise for determining the number of contributions, given that GitHub projects mostly follow the pull-based process. Our results indicate that the method used for mining contributors' data has the potential to influence the results. With this replication, it may be possible to improve previous results and reduce future efforts for new researchers when conducting studies that rely on the number of contributions.},
  keywords={Conferences;Software;Encoding;Data mining;Software development management;Replication;Open source;Casual contributors},
  doi={10.1109/SANER48275.2020.9054855},
  ISSN={1534-5351},
  month={Feb},}@ARTICLE{10879049,
  author={Mohr, Philipp and Bauch, Gerhard},
  journal={IEEE Communications Letters}, 
  title={Memory-Assisted Quantized LDPC Decoding}, 
  year={2025},
  volume={29},
  number={5},
  pages={888-892},
  abstract={We enhance coarsely quantized LDPC decoding by reusing computed check node messages from previous iterations. Typically, variable and check nodes update and replace old messages every iteration. We show that, under coarse quantization, discarding old messages entails a significant loss of mutual information. The loss is avoided with additional memory, improving performance by up to 0.23 dB. We optimize quantization with a modified information bottleneck algorithm that considers the statistics of old messages. A simple merge operation reduces memory requirements. Depending on channel conditions and code rate, memory assistance enables up to 32% better area efficiency for 2-bit decoding.},
  keywords={Decoding;Iterative decoding;Quantization (signal);Reliability;Optimization;Mutual information;Complexity theory;Random variables;Memory management;5G mobile communication;LDPC;5G NR;decoding;message passing;layered schedule;coarse quantization;information bottleneck},
  doi={10.1109/LCOMM.2025.3540277},
  ISSN={1558-2558},
  month={May},}@ARTICLE{11512075,
  author={Wen, Dawei and Wang, Hengyu and Gan, Wenxia and Chen, Deng and Li, Xinghua},
  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={DSDRN: A Dual-Stream Dual-Refinement Network with Superpixel and Location Semantics for Building Damage Classification}, 
  year={2026},
  volume={},
  number={},
  pages={1-12},
  abstract={Building damage assessment aims to rapidly and safely localize buildings in disaster-affected areas and classify damage severity using high-resolution remote sensing imagery acquired by satellites or unmanned aerial vehicles. Although convolutional neural networks provide strong feature extraction capability, they often suffer from insufficient change modeling and semantic inconsistency within building regions. Meanwhile, existing object-based methods primarily address semantic inconsistency through post-processing, which is prone to errors in dense urban scenes where nearby small buildings may be merged due to inaccurate boundary delineation. In this paper, we propose DSDRN, a Dual-Stream Dual-Refinement Network with Superpixel and Location Semantics, built upon a two-stage Building Damage Assessment framework, the proposed network adopts a dual-stream structure in the encoding stage, where both post-disaster images and concatenated bi-temporal images are used as inputs. This design enables the model to simultaneously capture complementary deep single-temporal features and multi-scale bi-temporal change information. To alleviate intra-building semantic inconsistency and boundary fragmentation caused by locally dominant damage patterns, we introduce dual-refinement modules, including Superpixel Semantic Refine (SSR) and Location Semantic Refine (LSR). The SSR module models semantic relationships among superpixels at the regional level, encouraging semantically similar regions to converge toward consistent representations, thereby enhancing structural coherence across building areas. The LSR module incorporates building mask priors to suppress background noise and preserves accurate building boundaries in the final predictions. Extensive experiments on the xBD dataset demonstrate the effectiveness of the proposed network and its individual components.},
  keywords={Buildings;Disasters;Remote sensing;Modeling;Modules (abstract algebra);Bismuth;Business intelligence;Pixel;Location awareness;Decoding;Building damage;convolutional neural network;deep learning;remote sensing;superpixel segmentation},
  doi={10.1109/JSTARS.2026.3691372},
  ISSN={2151-1535},
  month={},}@INPROCEEDINGS{10980746,
  author={Hu, Wenzheng and Guan, Zhenghua and Cheng, Nina and Zhang, Ao and Liu, Yi and Wang, Tianfu and Lei, Baiying},
  booktitle={2025 IEEE 22nd International Symposium on Biomedical Imaging (ISBI)}, 
  title={Multi-Modal Fusion Network Integrating Imaging and Clinical Tabular Data for Alzheimer's Disease Classification}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Accurate diagnosis of Alzheimer's disease relies on the integration of multimodal data, with imaging providing structural and functional insights, and clinical tabular data capturing patient-specific variables. Together, these sources offer a comprehensive view of the disease. However, traditional approaches often fail to take advantage of the complex relationships between clinical data and neuroimaging, limiting the effective use of complementary information. Common methods for spatial and channel feature extraction struggle to capture deeper interactions within structural magnetic resonance imaging and positron emission tomography data. Additionally, these methods often overlook critical intermodality relationships. To address these challenges, we propose the image-table cross-merging network, a multimodal framework that integrates spatial and channel features from sMRI and PET via cross-attention. The framework employs an innovative image-table fusion module with multilayer cross-attention and self-attention, enabling robust interactions between clinical and imaging data to enhance multimodallearning. Experimental results demonstrate significant improvements in AD classification accuracy, highlighting its diagnostic effectiveness.},
  keywords={Representation learning;Neuroimaging;Accuracy;Limiting;Magnetic resonance imaging;Nonhomogeneous media;Feature extraction;Medical diagnosis;Alzheimer's disease;Positron emission tomography;Alzheimer's Disease Diagnosis;Multi-modal Data Integration;Image-Tabular Representation Learning;Cross Attention},
  doi={10.1109/ISBI60581.2025.10980746},
  ISSN={1945-8452},
  month={April},}@ARTICLE{9466525,
  author={Bickley, Robert W and Bottrell, Connor and Hani, Maan H and Ellison, Sara L and Teimoorinia, Hossen and Yi, Kwang Moo and Wilkinson, Scott and Gwyn, Stephen and Hudson, Michael J},
  journal={Monthly Notices of the Royal Astronomical Society}, 
  title={Convolutional neural network identification of galaxy post-mergers in UNIONS using IllustrisTNG}, 
  year={2021},
  volume={504},
  number={1},
  pages={372-392},
  abstract={The Canada–France Imaging Survey (CFIS) will consist of deep, high-resolution r-band imaging over ∼5000 deg2 of the sky, representing a first-rate opportunity to identify recently merged galaxies. Because of the large number of galaxies in CFIS, we investigate the use of a convolutional neural network (CNN) for automated merger classification. Training samples of post-merger and isolated galaxy images are generated from the IllustrisTNG simulation processed with the observational realism code RealSim. The CNN's overall classification accuracy is 88 per cent, remaining stable over a wide range of intrinsic and environmental parameters. We generate a mock galaxy survey from IllustrisTNG in order to explore the expected purity of post-merger samples identified by the CNN. Despite the CNN's good performance in training, the intrinsic rarity of post-mergers leads to a sample that is only ∼6 per cent pure when the default decision threshold is used. We investigate trade-offs in purity and completeness with a variable decision threshold and find that we recover the statistical distribution of merger-induced star formation rate enhancements. Finally, the performance of the CNN is compared with both traditional automated methods and human classifiers. The CNN is shown to outperform Gini–M20 and asymmetry methods by an order of magnitude in post-merger sample purity on the mock survey data. Although the CNN outperforms the human classifiers on sample completeness, the purity of the post-merger sample identified by humans is frequently higher, indicating that a hybrid approach to classifications may be an effective solution to merger classifications in large surveys.},
  keywords={methods: statistical;techniques: image processing;galaxies: evolution;galaxies: interactions;galaxies: peculiar},
  doi={10.1093/mnras/stab806},
  ISSN={1365-2966},
  month={March},}@INPROCEEDINGS{11171155,
  author={Babu, A. Aalan and Elumalai, M. and Dinesh Hynes, N. Samuel and Swetha, S. and M, Karthikeyan and M, Nalini},
  booktitle={2025 5th International Conference on Soft Computing for Security Applications (ICSCSA)}, 
  title={Deep Learning for Enhancing Efficiency and Optimization in Modern Communication Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1831-1837},
  abstract={Deep learning technology transforms network communications by delivering innovative solutions to handle modern network problems. This report studies deep learning technology use within communication systems by presenting its benefits for channel coding and decoding plus channel estimation and resource allocation. The research evaluates how deep learning improves communication operations with better results while using resources more efficiently than traditional systems. Our research shows how deep learning works better than traditional methods in dynamic networks and we analyze its use in current 5G systems. Our survey examines the different neural network types including CNNs, RNNs, and reinforcement learning alongside their applications in DL. Despite these advances deep learning technologies face difficulties with processing power requirements and data availability while also needing more secure protection. The research provides suggestions for future work by showing how to merge deep learning with edge and fog computing platforms while also using quantum computing and privacy protection methods. Deep learning technology will keep getting better to create next-level network systems that think smarter and work better.},
  keywords={Deep learning;Surveys;Quantum computing;5G mobile communication;Channel estimation;Communication networks;Security;Resource management;Protection;Edge computing;Deep Learning;Communication Systems;MIMO;Channel Estimation;5G Networks;Resource Allocation},
  doi={10.1109/ICSCSA66339.2025.11171155},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11136037,
  author={Amgothu, Shanthi and Mathangi, Reeswanth and Vijanagiri, Divya and Palnati, Devi Yamini and Kumar. S, Satheesh},
  booktitle={2025 International Conference on Sensors and Related Networks (SENNET) Special Focus on Digital Healthcare(64220)}, 
  title={Revolutionizing Plant Care: A Plant E-Commerce Platform with AI Disease Diagnosis and Expert Recommendations}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The Plant E-commerce Website is a revolutionary platform designed to combine e-commerce with advanced plant care solutions, catering to plant enthusiasts, hobbyists, and professionals. It offers a wide range of plants, seeds, and fertilizers. One of the main features of the platform is the AI plant disease detection system, where users can upload images of their plants to receive quick and accurate diagnoses of any health problems. The platform uses the EfficientNetB5 model for plant disease detection, known for its high accuracy and efficiency in image classification tasks. Based on the analysis, the platform provides recommendations for suitable fertilizers and products, ensuring proper treatment. In addition, the platform features a premium subscription service that connects users with plant care specialists or freelancing students who offer personalized advice and monthly plant health evaluations. This model fosters a community-driven approach to plant care, benefiting plant owners, freelancers, and the platform itself. The integration of AI technology with e-commerce makes the platform unique and efficient in addressing the challenges faced by plant owners. By merging product sales, plant disease detection, and personalized consultations, the platform not only promotes sustainable gardening practices but also improves the accessibility of plant care for all users.},
  keywords={Deep learning;Plant diseases;Accuracy;Plants (biology);User experience;Real-time systems;Seeds (agriculture);Electronic commerce;Reliability;Fertilizers;Plant E-Commerce;AI-Powered Disease Detection;EfficientNetB5;Machine Learning;Plant Health Diagnosis;Personalized Recommendations;Django Framework;MongoDB;Plant Disease Classification;Image Processing;Deep Learning;Sustainable Gardening;Agricultural Technology;E-Commerce Integration;User Experience;Plant Care Community},
  doi={10.1109/SENNET64220.2025.11136037},
  ISSN={},
  month={July},}@INPROCEEDINGS{11486388,
  author={Izadkhah, Saba and Kotthapalli, Manikanta and Rekabdar, Banafsheh and Wagner, Andrew and Kothuri, Sirisha and McNeil, Nathan},
  booktitle={2026 International Conference on Semantic Computing (ICSC)}, 
  title={Cyclist Detection in Urban Traffic Using Fine-Tuned YOLO Models and Diverse Real-World Video Data}, 
  year={2026},
  volume={},
  number={},
  pages={140-147},
  abstract={Reliable detection of cyclist and person samples in urban traffic is critical for high-safety autonomous driving systems, traffic analytics, and intelligent transportation systems. These classes present complementary challenges, as pedestrians vary widely in pose and scale, while cyclists show high intra-class variation, frequent occlusions, and ambiguous context, similar to pedestrians walking bicycles. We built a cyclist detector for urban traffic by combining COCO, a cyclist-focused image set, and in-house driving videos. Because most public datasets lack an explicit cyclist label, we extract it from person and bicycle detections, merge them into a single cyclist box if their Intersection over Union (IoU) exceeds $\tau=0.3$, and then perform targeted manual corrections. Using these cyclist-enriched data, we fine-tune YOLOv8n, YOLOv11n, and Faster R-CNN under the same training and evaluation protocol to jointly detect person and cyclist. On a held-out test split, fine-tuning with enriched labels significantly improves cyclist detection over off-the-shelf models. YOLOv11n obtains mAP@ 0.5 $=0.818$, cyclist $\mathrm{AP} \text{@} 0.5: 0.95=0.47$, and 74 FPS, achieving the best accuracy-latency balance; YOLOv8n runs at 84 FPS, which is faster with a small drop in recall, while Faster R-CNN yields the highest recall but lower precision and much higher latency. We report detailed per-class precision-recall curves, mAP scores at multiple IoU thresholds, and discuss common failure modes such as occlusion, rider–bicycle disambiguation, and crowded scenes. The code and scripts required for data preparation, training, and evaluation, to ensure repeatability, are available on GitHub at https://github.com/manikantakotthapalli/Cyclist-detection-using-YOLO.},
  keywords={Internet of Things;Protocols;Videos;Location awareness;Radio access networks;Regional area networks;Communication systems;Internet;Video equipment;Mobile communication;Cyclist detection;Person detection;YOLO;Faster R-CNN;Urban perception;Object detection},
  doi={10.1109/ICSC67292.2026.00027},
  ISSN={2472-9671},
  month={Feb},}@INPROCEEDINGS{9709970,
  author={Cao, Qingxing and Wan, Wentao and Wang, Keze and Liang, Xiaodan and Lin, Liang},
  booktitle={2021 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Linguistically Routing Capsule Network for Out-of-distribution Visual Question Answering}, 
  year={2021},
  volume={},
  number={},
  pages={1594-1603},
  abstract={Generalization on out-of-distribution (OOD) test data is an essential but underexplored topic in visual question answering. Current state-of-the-art VQA models often exploit the biased correlation between data and labels, which results in a large performance drop when the test and training data have different distributions. Inspired by the fact that humans can recognize novel concepts by composing existed concepts and capsule network’s ability of representing part-whole hierarchies, we propose to use capsules to represent parts and introduce "Linguistically Routing" to merge parts with human-prior hierarchies. Specifically, we first fuse visual features with a single question word as atomic parts. Then we introduce the "Linguistically Routing" to reweight the capsule connections between two layers such that: 1) the lower layer capsules can transfer their outputs to the most compatible higher capsules, and 2) two capsules can be merged if their corresponding words are merged in the question parse tree. The routing process maximizes the above unary and binary potentials across multiple layers and finally carves a tree structure inside the capsule network. We evaluate our proposed routing method on the CLEVR compositional generation test, the VQA-CP2 dataset and the VQAv2 dataset. The experimental results show that our proposed method can improve current VQA models on OOD split without losing performance on the in-domain test data.},
  keywords={Visualization;Computer vision;Correlation;Fuses;Computational modeling;Merging;Training data;Vision + language},
  doi={10.1109/ICCV48922.2021.00164},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{9306612,
  author={Saha, Somrita and Biswas, Arindam},
  booktitle={2020 Joint 9th International Conference on Informatics, Electronics & Vision (ICIEV) and 2020 4th International Conference on Imaging, Vision & Pattern Recognition (icIVPR)}, 
  title={Polygonization of 3D Objects using Norm Similarity}, 
  year={2020},
  volume={},
  number={},
  pages={1-6},
  abstract={This work proposes a method of polygonization of the surface of triangulated 3D digital objects by merging the edge-adjacent face triangles having similar norms. Least square method is applied to the boundary vertices of the set of the merged face triangles, which yields a new norm optimizing the norms of the individual face triangles constituting the merged set. The coordinates of the boundary vertices are recalculated with respect to this new norm. Finally, all the instances of each vertex is averaged to obtain the final coordinates. In this process, many of the vertices of the original input object are dropped, giving rise to a number of polygons describing the object, which is substantially less than the number of original face triangles. Thus, a considerable amount of compression is achieved, Also, polygons representing the object can reveal its structure and shape and are amenable to improved shape analysis. Contribution: It proposes an algorithm to polygonize 3D digital object surface achieving significant compression. Contribution: It proposes an algorithm to polygonize 3D digital object surface achieving significant compression.},
  keywords={Faces;Color;Merging;Three-dimensional displays;Clustering algorithms;Surface treatment;Least mean squares methods;Polygonization;Mesh Simplification;Approximations;Data Compression},
