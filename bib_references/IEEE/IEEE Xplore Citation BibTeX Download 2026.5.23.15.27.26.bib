  abstract={We introduce a novel technique for the visualization of data at various levels of detail. This is based on a colour-based representation of the data, where "high level" views of the data are obtained by merging colours together to obtain a summary-colour which represents a number of data-points. This is applied to the problem of visualizing biomolecular sequence data and picking out features in such data at various scales.},
  keywords={Merging;Data visualization;DNA;Proteins;Bioinformatics;Amino acids;Sequences;Organisms;Humans;Genomics},
  doi={10.1109/IV.2003.1217975},
  ISSN={},
