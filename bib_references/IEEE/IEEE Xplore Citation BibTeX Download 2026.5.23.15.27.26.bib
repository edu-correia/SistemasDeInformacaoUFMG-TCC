  abstract={A concept for a SOI motherboard is introduced. AuSn solder technology is used for hybrid integration. The device adjustment on the board is realised by passive self-alignment. First results on fabricated boards are very encouraging.},
  keywords={Silicon on insulator technology;Optical devices;Optical waveguides;Optical receivers;Optical transmitters;Optical filters;High speed optical techniques;Integrated optics;Etching;Optical materials},
  doi={10.1109/GROUP4.2004.1416719},
