  title={Media Encoding}, 
  year={2008},
  volume={},
  number={},
  pages={341-357},
  abstract={This chapter contains sections titled: <list style="bulleted" xml:id="l1"> <listItem> Speech Encoding </listItem> <listItem> Video Encoding </listItem> <listItem> Text Encoding </listItem> <listItem> Mandatory Codecs in the IMS </listItem> </list>},
  keywords={Codecs;Speech;Pulse modulation;Bandwidth;Quantization (signal);Speech coding},
  doi={10.1002/9780470695135.ch15},
  ISSN={},
  publisher={Wiley},
  isbn={9780470695128},
  url={https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/8040861},}@INPROCEEDINGS{5290996,
  author={Vajk, Tamás and Mezei, Gergely and Levendovszky, Tihamér},
  booktitle={2009 First IEEE Eastern European Conference on the Engineering of Computer Based Systems}, 
  title={Incremental Type Checking in OCL Compilers}, 
  year={2009},
  volume={},
  number={},
  pages={9-18},
  abstract={In software engineering, modeling tools have become widely accepted to increase application reliability and decrease development time. The UML and the OCL became industry standards and are supported by many Computer-Aided Software Engineering tools. The increasing number of modeled functionalities results in complex models that need more and more textual constraints to express the hidden restrictions applying to the systems. The usual scenario of model development is to create an initial model of the system, and then fine-tune it with simple modifications. During development, rebuilding all the constraints is unnecessary when only a few changes have been applied. In this paper, we present an algorithm that handles changes incrementally on expression level, thus required rebuilds are kept to a minimum. The background and implementation framework for the discussed compiler is the Visual Modeling and Transformation System, but the algorithm is general enough to support any tree-based compiler integrated into an IDE.},
  keywords={Unified modeling language;Tree graphs;Computer aided software engineering;Database languages;Automation;Informatics;Software systems;Software tools;USA Councils;Software engineering;OCL;VMTS;Incremental compilation},
  doi={10.1109/ECBS-EERC.2009.21},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{1371000,
  author={Apsel, A. and Pappu, A. and Tao Yin},
  booktitle={Proceedings of the Lightwave Technologies in Instrumentation and Measurement Conference, 2004.}, 
  title={Merging traditional VLSI with photonics}, 
  year={2004},
  volume={},
  number={},
  pages={91-99},
  abstract={This tutorial paper looks at the possibilities for integrated photonic VLSI systems. It examines the need for "disruptive" technologies to solve the very problems that feature size scaling has introduced in traditional VLSI electronics and the potential for photonics and hybridized systems to solve these problems. It also considers the various challenges involved in constructing a photonic VLSI system as well as the potential pitfalls and disadvantages of this approach. The paper concludes with a discussion of these challenges and benefits by showing steps toward realizing such a system and how addressing problems in computer architecture with an innovative photonics approach can lead to benefits in system wide performance not previously seen with existing approaches.},
  keywords={Merging;Very large scale integration;Costs;Stimulated emission;Optical design;Vertical cavity surface emitting lasers;Optical polymers;Integrated optics;Photonic integrated circuits;Packaging},
  doi={10.1109/LTIMC.2004.1371000},
  ISSN={},
