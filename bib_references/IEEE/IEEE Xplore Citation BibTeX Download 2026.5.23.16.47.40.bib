  author={Sugiura, Naoto and Fujiki, Daichi},
  journal={IEEE Access}, 
  title={SharK: Enabling High-Performance Range Queries in Key-Value Store Through Vlog Resharding}, 
  year={2025},
  volume={13},
  number={},
  pages={203041-203056},
  abstract={Modern key-value stores often utilize Log-Structured Merge Trees (LSM-trees) to achieve high write throughput. However, LSM-trees inherently suffer from high read and write amplification. Keyvalue separation, a technique that isolates large values from keys and stores them in a separate value log, has emerged as a promising solution to mitigate these issues. Despite its potential, existing key-value separation designs have struggled to simultaneously optimize for both update and range queries. To overcome this limitation, we introduce SharK, a new key-value store design that excels in both update and range query performance. SharK partitions the value log into shards and stores values based on their ranges, employing adaptive value management through resharding to maintain consistent performance even under varying key distributions. By performing garbage collection on a per-shard basis with dynamic resharding, SharK ensures efficient update performance. Range-based sharding also directly improves the performance of range queries. Through evaluations, SharK demonstrates superior query performance compared to RocksDB and other key-value separation designs while maintaining comparable update performance.},
  keywords={Sharks;Compaction;Trees (botanical);Sharding;Throughput;Optimization;Interpolation;Hands;Filters;Databases;LSM-tree;key-value store;key-value separation;range query;SSD;storage},
  doi={10.1109/ACCESS.2025.3638766},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11264985,
  author={R, Arya Devi M and P, Abdul Jabbar},
  booktitle={2025 International Conference on Intelligent and Secure Engineering Solutions (CISES)}, 
  title={Automated Test Case Generation Using Machine Learning And Natural Language Processing}, 
  year={2025},
  volume={},
  number={},
  pages={345-350},
  abstract={Software testing is a prominent step in software quality assurance, as it helps to provide high quality software product with reliability. Traditional methods for creation of test cases are not efficient to handle complex problems in which causing error and resulting in difficulties in the overall testing method. Automated test case generation is an approach to solve these difficulties in testing and helps to increase efficiency and software quality. This paper presents a method to improve the test case development process by integrating machine learning (ML) and natural language processing (NLP) techniques. ML methods, such as supervised and reinforcement learning, are used to predict ideal test cases based on the past defect patterns, while NLP methods will process and understand the software requirements and user stories to automatically generate relevant test scenarios. Transformer-based language models and deep learning classifiers are used inorder to extract and structure test cases from natural language specifications. The results obtained show a considerable increase in test coverage, defect detection rates, and overall reliability. A comparative analysis of Machine Learning and Natural Language Processing-based models such as combinations of classification algorithms and language representations shows that combining both approaches helps to enhance the overall performance of test case generation, as measured by evaluation metrics showing improvements in test coverage, defect detection rate, execution time, precision, recall, and a reduction in the false positive rate. The proposed method reduces human labor and speeds up the testing process while retaining accuracy and effectiveness. Finally, deal with the potential for merging advanced deep learning models with large language models (LLMs) to refine automated test case production and increase software quality.},
  keywords={Software testing;Deep learning;Accuracy;Scalability;Software quality;Transformers;Natural language processing;Time measurement;Software reliability;Defect detection;Automated Test Case Generation;Software Testing;Machine Learning;Natural Language Processing},
  doi={10.1109/CISES66934.2025.11264985},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11366980,
  author={Maheshwari, Pawan and Gupta, Sunil},
  booktitle={2025 6th International Conference on Communication, Computing & Industry 6.0 (C2I6)}, 
  title={Integrating Self-Signed Key Cryptography with Blockchain for Decentralized Digital Record Authentication}, 
  year={2025},
  volume={},
  number={},
  pages={1-11},
  abstract={In a world where decentralized trust and data integrity are essential, it is very important to protect secure and verifiable digital records. This work aims to enhance authentication, traceability, and access control of decentralized records through the proposal of a cryptographic framework: Self-Keyed Verifiable Record Authentication (SKVRA). SKVRA merges the features of self-signed key cryptography with blockchain technology to facilitate Decentralized Identifiers (DIDs), secure off-chain storage, and Verifiable Credentials (VCs) for access control. The proposed algorithm makes sure that each digital record is hashed, signed, and linked to a metadata package anchored by a DID. The Blockchain keeps an unchangeable record of these links. Encrypted records are stored off-chain using IPFS to keep data private while still being able to be checked. SKVRA calculates trust scores through peer-to-peer attestations and keeps a version history using Merkle tree audit trails. Empirical evidence showed that the proposed method outperformed the venerated state-of-the-art methods. It showed 0.28 seconds of latency with a throughput of $3,988.57$ records per second and an average time of 0.08 milliseconds for the creation of a DID. It also showed a VC verification accuracy of 90.54% and a Content Identifier (CID) retrieval success of $\mathbf{9 4. 5 9 \%}$. In essence, SKVRA manages to provide a robust and adaptable structure for the handling of digitized records on a distributed ledger. It suits highly trust and integrity-dependent fields like, but not limited to, healthcare, education, and legal records.},
  keywords={Access control;Trees (botanical);Authentication;Medical services;Metadata;Throughput;Blockchains;Peer-to-peer computing;Proposals;Secure storage;Decentralized Identifiers;Verifiable Credentials;Blockchain Authentication;Digital Record Security;Self-Signed Key Cryptography},
  doi={10.1109/C2I666499.2025.11366980},
  ISSN={},
  month={Dec},}@ARTICLE{11216145,
  author={Wang, Guohui and Chen, Zhengang and Shi, Zhiping and Guan, Yong and Wang, Tianyu},
  journal={IEEE Transactions on Computers}, 
  title={Region-Based Collaborative Caching With Joint Latency and Lifetime Optimization for Hybrid SMR-Flash Storage}, 
  year={2026},
  volume={75},
  number={1},
  pages={219-232},
  abstract={Shingled Magnetic Recording (SMR) disks have been improved significantly over traditional Hard Disk Drives (HDDs) in storage capacity and cost by a shingled-like structure that overlaps with adjacent tracks. However, the overall system performance is severely sacrificed due to the large portion of Read-Merge-Write (RMW) operations triggered by the non-sequential nature of SMR disks. To handle such performance degradation, Persistent Cache (PC) and built-in NAND flash cache are applied to absorb non-sequential writes. However, when the cache is full, triggering write-back operations extends the I/O response time. Additionally, the erase of NAND flash also compromises its lifetime. This paper aims to manage the NAND flash region and the original SMR band region uniformly instead of only adopting NAND flash as a cache layer. To achieve this, we propose a Region-based Co-optimized strategy named Multi-Regional Collaborative Management (MCM). Our approach segments I/O requests using a fast and efficient Bloom filter alongside a Band-based partitioning module. Additionally, the NAND flash memory region is managed based on the characteristics of the segmented data, enabling maximum control over frequent data updates in the NAND flash memory. The NAND flash cache will not serve as the first-level cache as before. Meanwhile, through Region-aware Wear-leveling (WL) and garbage collection (GC) strategies, the lifetime of NAND flash memory is extended, and cleaning efficiency is improved. In addition, further analysis of the impact of the wear-leveling parameters on RMWs and NAND flash lifetime under different workloads. According to the experimental results, compared with the typical Skylight (baseline), our scheme reduces the average response time and write amplification by 74.56% and 98.99%, respectively. At the same time, our approach also outperforms some state-of-the-art solutions, such as MU-RMW, RMW-F, and FC.},
  keywords={Flash memories;Time factors;Optimization;Electronic mail;Collaboration;Hard disks;Data models;Aerospace electronics;System performance;Shingled magnetic recording;Shingled magnetic recording;flash memory;bloom filter;data identification},
  doi={10.1109/TC.2025.3625183},
  ISSN={1557-9956},
  month={Jan},}@INPROCEEDINGS{11240920,
  author={Chen, Chen and Yin, Jiaqi and Yu, Cunxi},
  booktitle={2025 IEEE/ACM International Conference On Computer Aided Design (ICCAD)}, 
  title={Revisit Choice Network for Synthesis and Technology Mapping}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={Choice network construction is a critical technique for alleviating structural bias issues in Boolean optimization, equivalence checking, and technology mapping. Previous works on lossless synthesis utilize independent optimization to generate multiple snapshots, and use simulation and SAT solvers to identify functionally equivalent nodes. These nodes are then merged into a subject graph with choice nodes. However, such methods often neglect the quality of these choices—raising the question of whether they truly contribute to effective technology mapping. This paper introduces CRISTAL, a novel methodology and framework to constructing Boolean choice networks. Specifically, CRISTAL introduces a novel flow of choice network-based synthesis and mapping, includes representative logic cone search, structural mutation for generating diverse choice structures via equality saturation, and priority-ranking choice selection along with choice network construction and validation. Through these techniques, CRISTAL constructs fewer but higher-quality choices. Our experimental results demonstrate that CRISTAL outperforms the state-of-the-art Boolean choice network construction implemented in ABC in the post-mapping stage, achieving average reductions of 3.85%/8.35% (area/delay) in delay-oriented mode, 0.11%/2.74% in area-oriented mode, and a 63.77% runtime reduction on large-scale cases, across a diverse set of combinational circuits from the IWLS 2005, ISCAS’89, and EPFL benchmark suites.},
  keywords={Measurement;Technological innovation;Runtime;Redundancy;Fingerprint recognition;Hybrid power systems;Polynomials;Logic;Optimization;Formal verification},
  doi={10.1109/ICCAD66269.2025.11240920},
  ISSN={1558-2434},
  month={Oct},}@ARTICLE{11242129,
  author={Zhou, Shuyi and Zhu, Ming},
  journal={IEEE Access}, 
  title={Enhancing Athlete Performance Using Deep Learning Techniques in Sports Analytics}, 
  year={2025},
  volume={13},
  number={},
  pages={210758-210771},
  abstract={Conventional techniques in sports data analysis typically depend on fixed attributes and singular occurrences, which constrains their capacity to reflect the evolving and intricate dynamics of athletic competition. Such methodologies encounter challenges when attempting to represent sequential patterns and inter-player relationships—elements that are essential for reliable forecasting of performance and tactical decision-making. In response to these challenges, we introduce an innovative architecture that merges a Temporal-Interaction Transformer (TITAN) with a strategy-enhancing module enriched by domain-specific knowledge, termed PlayNet-Augment. TITAN employs a dual-stream encoder to jointly model temporal event sequences and player interaction graphs, capturing both short-term and long-range dependencies inherent in sports data. PlayNet-Augment enhances interpretability by integrating structured playbooks and strategic hierarchies into the learning process, facilitating human-in-the-loop decision-making. Our approach demonstrates superior performance in predictive accuracy and provides actionable insights for coaches and analysts, thereby contributing to the advancement of applied sciences in the realm of sports analytics.},
  keywords={Sports;Adaptation models;Training;Deep learning;Data models;Analytical models;Injuries;Predictive models;Accuracy;Computer architecture;Deep learning;sports analytics;temporal modeling;player;strategic optimization},
  doi={10.1109/ACCESS.2025.3631851},
