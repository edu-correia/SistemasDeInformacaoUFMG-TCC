  author={Yang, Yiran and Gao, Xu and Wang, Tong and Hao, Xin and Shi, Yifeng and Tan, Xiao and Ye, Xiaoqing},
  booktitle={2025 IEEE International Conference on Robotics and Automation (ICRA)}, 
  title={Explore the LiDAR-Camera Dynamic Adjustment Fusion for 3D Object Detection}, 
  year={2025},
  volume={},
  number={},
  pages={6291-6298},
  abstract={Camera and LiDAR serve as informative sensors for accurate and robust autonomous driving systems. However, these sensors often exhibit heterogeneous natures, resulting in distributional modality gaps that present significant challenges for fusion. To address this, a robust fusion technique is crucial, particularly for enhancing 3D object detection. In this paper, we introduce a dynamic adjustment technology aimed at aligning modal distributions and learning effective modality representations to enhance the fusion process. Specifically, we propose a triphase domain aligning module. This module adjusts the feature distributions from both the camera and LiDAR, bringing them closer to the ground truth domain and minimizing differences. Additionally, we explore improved representation acquisition methods for dynamic fusion, which includes modal interaction and specialty enhancement. Finally, an adaptive learning technique that merges the semantics and geometry information for dynamical instance optimization. Extensive experiments in the nuScenes dataset present competitive performance with state-of-the-art approaches. Our code will be released in the future.},
  keywords={Geometry;Adaptive learning;Technological innovation;Three-dimensional displays;Laser radar;Semantics;Object detection;Cameras;Sensors;Autonomous vehicles},
  doi={10.1109/ICRA55743.2025.11128091},
  ISSN={},
  month={May},}@INPROCEEDINGS{11270141,
  author={Direk, Tugay},
  booktitle={2025 Medical Technologies Congress (TIPTEKNO)}, 
  title={Optimized Radix Sort for Efficient Health Data Sorting in Biomedical Backend Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Efficient data processing is essential in modern biomedical systems, especially as hospital information systems, genomic pipelines, and centralized clinical data platforms generate increasingly large volumes of health related information. This paper presents an optimized variant of the radix sort algorithm tailored for use in backend biomedical data handling systems. The algorithm maintains linear time complexity O(n) and offers improved performance over comparison based algorithms in specific scenarios involving high volume, mixed digit size integer inputs typical of centralized health data aggregation. Our method outperforms quicksort in runtime efficiency under large scale, heterogeneous numeric inputs, such as those found in genomic data sorting or patient record integration. However, due to its use of additional memory buffers, including an extra bucket for digit length categorization, our approach incurs moderately higher memory usage compared to in place quicksort implementations. We evaluate this trade off and demonstrate the performance advantage in use cases where memory availability is not a primary constraint. This contribution supports the development of faster biomedical informatics infrastructures, enabling more responsive analytics and scalable integration of heterogeneous medical data sources.},
  keywords={Runtime;Instruction sets;Soft sensors;Merging;Pipelines;Genomics;Parallel processing;Bioinformatics;Time complexity;Sorting;Radix Sort;Biomedical Informatics;Health Data Processing;Sorting Algorithms;Backend Systems;Genomic Data Analytics},
  doi={10.1109/TIPTEKNO68206.2025.11270141},
  ISSN={2687-7783},
  month={Oct},}@ARTICLE{11316173,
  author={Yao, Zhuo and Wang, Wei and Cai, Yueri},
  journal={IEEE Transactions on Automation Science and Engineering}, 
  title={Decomposing the Multi-Agent Pathfinding Problem for Large Agents: Accelerating Solving Without Compromising Solvability}, 
  year={2026},
  volume={23},
  number={},
  pages={1994-2019},
  abstract={Multi-Agent Path Finding (MAPF) has been widely studied in recent years. However, most existing MAPF algorithms assume that an agent occupies only a single cell in a grid-based map. This assumption limits their applicability in many real-world domains where agents have geometric shapes rather than being point-like. These agents, which can occupy multiple cells simultaneously, are referred to as “large” agents. When considering the shape and size of agents in MAPF, i.e., MAPF for large agents (LA-MAPF), the computational complexity increases significantly as the number of agents increases, primarily because of the increased overhead in conflict detection between geometric agents. This paper introduces Layered Decomposition, a method that decomposes a MAPF problem into subproblems through iterative bipartitioning. This approach aims to reduce the time cost when solving LA-MAPF problems. To address unsolvable subproblems, we propose a solvability safeguard mechanism that merges subproblems until a solvable subproblem is formed. Experiments show that our LA-MAPF method with decomposition reduces time cost and increases the success rate of state-of-art MAPF methods significantly. To facilitate further research, we have made the source code for the Layered decomposition of LA-MAPF publicly available. Note to Practitioners—Motivated by the configuration space of MAPF’s solutions growing exponentially as the number of agents increases, we decompose an LA-MAPF problem into multiple smaller subproblems to reduce the time cost of solving it. To determine whether a subproblem is solvable quickly, we adopt an efficient but incomplete solvability checker, which may misjudge unsolvable subproblems as solvable, and this will result in unsolvable subproblems. To handle unsolvable subproblems, we adopt a merge mechanism which merges unsolvable subproblems with other subproblems until all subproblems are solvable. Our method is a general strategy that can be applied to various MAPF methods. In the results, we test our method on multiple maps with random shapes and numbers of agents to demonstrate our method’s advantages and disadvantages.},
  keywords={Shape;Robots;Costs;Search problems;Computational efficiency;Automation;Spatiotemporal phenomena;Planning;Image edge detection;Artificial intelligence;MAPF (multi-agent path finding);LA-MAPF (MAPF for large agents);graph theory},
  doi={10.1109/TASE.2025.3648677},
  ISSN={1558-3783},
