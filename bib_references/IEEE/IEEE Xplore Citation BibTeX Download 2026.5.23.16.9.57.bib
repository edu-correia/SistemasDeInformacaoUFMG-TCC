  title={Modification of IRI-2016 source code: improvements, parallelization}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Scientific community actively uses the International Reference Ionosphere (IRI). Our experience revealed some shortcomings in IRI source code. This paper describes improvements and modifications to the IRI-2016 code, including overcoming the problem of parallelization. The code can be found at GitLab.},
  keywords={Codes;Algorithms;Source coding;Instruction sets;Merging;Ions;Rough surfaces},
  doi={10.46620/URSIATRASC24/COMM1727},
  ISSN={},
  month={May},}@INPROCEEDINGS{11352661,
  author={Junxin, Zhu},
  booktitle={2025 22nd International Computer Conference on Wavelet Active Media Technology and Information Processing (ICCWAMTIP)}, 
  title={Incremental Cardinality Estimation via Transformer-Encoded Merge-Tree}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Accurate cardinality estimation is critical for query optimization in big data engine. Existing learning-based estimation methods struggle with real-world dynamic data, facing issues like poor adaptation to data changes, the cold start problem, and inefficient reuse of historical query results due to shifting data distributions. We propose ITEM (Incremental Cardinality Estimator with Transformer-Encoded Merge-Tree), a novel hybrid model for single-table cardinality estimation designed specifically for these dynamic scenarios. ITEM first utilizes an encoder-decoder structure, pre-trained on synthetic data, to extract robust data distribution features. To handle continuous data growth and evolution, the model employs a Merge Tree-based incremental learning mechanism with an eager merge strategy to efficiently manage a collection of incremental models, leveraging the additive property of single-table cardinalities. By incorporating historical queries during fine-tuning as a regularization term, ITEM effectively prevents knowledge forgetting and maximizes the utilization of past query experience. Experiments on real-world and synthetic datasets demonstrate that ITEM achieves competitive performance in cardinality estimation.},
  keywords={Incremental learning;Query processing;Estimation;Information processing;Media;Transformers;Feature extraction;Data models;Reliability;Synthetic data;Cardinality Estimation;Database System;Incremental Learning},
  doi={10.1109/ICCWAMTIP68645.2025.11352661},
