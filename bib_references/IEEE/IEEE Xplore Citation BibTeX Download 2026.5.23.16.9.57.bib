  month={Dec},}@INPROCEEDINGS{10949886,
  author={Li, ChenQi and Holmes, Ricardo and Yao, JingTao},
  booktitle={2024 9th International Conference on Control, Robotics and Cybernetics (CRC)}, 
  title={Resolving Conflicts Among Multiple Classifiers Using Game-Theoretic Soft Sets}, 
  year={2024},
  volume={},
  number={},
  pages={77-81},
  abstract={Addressing uncertainty is a challenge in decisionmaking. Soft set theory aids in complex scenarios involving multiple opinions. We propose a game-theoretic soft set model to resolve conflicts in soft sets, particularly when merging multiple classifiers. This model allows each classifier to make strategic selections from objects associated with conflicting opinions. The experimental results demonstrated that the model effectively balances the decisions of all classifiers while maintaining satisfactory classification performance.},
  keywords={Uncertainty;Merging;Games;Pareto optimization;Set theory;Iterative algorithms;Classification algorithms;Game theory;Robots;Cybernetics;Decision-making;Merging multi-classifiers;Soft sets;Game Theory;Game-theoretic soft sets},
  doi={10.1109/CRC63701.2024.10949886},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9213973,
  author={Balachandran, Swee and Manderino, Christopher and Muñoz, César and Consiglio, María},
  booktitle={2020 International Conference on Unmanned Aircraft Systems (ICUAS)}, 
  title={A Decentralized Framework to Support UAS Merging and Spacing Operations in Urban Canyons}, 
  year={2020},
  volume={},
  number={},
  pages={204-210},
  abstract={This paper presents a distributed consensus algorithm for autonomous merging and spacing that enables unmanned aircraft systems (UAS) to coordinate their passage through an aerial intersection (i.e., merging fix) via a distributed control mechanism. The algorithm is incorporated into the Independent Configurable Architecture for Reliable Operations of Unmanned Systems (ICAROUS). In-trail spacing between aircraft is achieved with the integration of sense and avoid functionality (SAA) within the ICAROUS framework. This approach allows vehicles to maintain required spacing while entering or exiting the merging fix. Enabling autonomously coordinating vehicles in merging and spacing operations is a key capability in facilitating vehicle traffic in urban airspace and air-mobility operations involving small UAS and other Electrical-Vertical Takeoff/Landing (E-VTOL) vehicles.},
  keywords={Merging;Schedules;Aircraft;Trajectory;NASA;Heart beat;Urban areas},
  doi={10.1109/ICUAS48674.2020.9213973},
