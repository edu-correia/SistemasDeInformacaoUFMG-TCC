@INPROCEEDINGS{9678698,
  author={Tinnes, Christof and Kehrer, Timo and Joblin, Mitchell and Hohenstein, Uwe and Biesdorf, Andreas and Apel, Sven},
  booktitle={2021 36th IEEE/ACM International Conference on Automated Software Engineering (ASE)}, 
  title={Learning Domain-Specific Edit Operations from Model Repositories with Frequent Subgraph Mining}, 
  year={2021},
  volume={},
  number={},
  pages={930-942},
  abstract={Model transformations play a fundamental role in model-driven software development. They can be used to solve or support central tasks, such as creating models, handling model co-evolution, and model merging. In the past, various (semi-)automatic approaches have been proposed to derive model transformations from meta-models or from examples. These approaches require time-consuming handcrafting or the recording of concrete examples, or they are unable to derive complex transformations. We propose a novel unsupervised approach, called Ockham, which is able to learn edit operations from model histories in model repositories. Ockham is based on the idea that meaningful domain-specific edit operations are the ones that compress the model differences. It employs frequent subgraph mining to discover frequent structures in model difference graphs. We evaluate our approach in two controlled experiments and one real-world case study of a large-scale industrial model-driven architecture project in the railway domain. We found that our approach is able to discover frequent edit operations that have actually been applied before. Furthermore, Ockham is able to extract edit operations that are meaningful to practitioners in an industrial setting.},
  keywords={Merging;Computer architecture;Software;Rail transportation;Data mining;History;Task analysis;Artificial intelligence for software engineering;Maintenance and evolution;Model driven development;Reverse engineering and re engineering;Recommender systems for software engineering;Software product line engineering},
  doi={10.1109/ASE51524.2021.9678698},
  ISSN={2643-1572},
  month={Nov},}@INPROCEEDINGS{9340951,
  author={Sun, Ke and Schlotfeldt, Brent and Chaves, Stephen and Martin, Paul and Mandhyan, Gulshan and Kumar, Vijay},
  booktitle={2020 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)}, 
  title={Feedback Enhanced Motion Planning for Autonomous Vehicles}, 
  year={2020},
  volume={},
  number={},
  pages={2126-2133},
  abstract={In this work, we address the motion planning problem for autonomous vehicles through a new lattice planning approach, called Feedback Enhanced Lattice Planner (FELP). Existing lattice planners have two major limitations, namely the high dimensionality of the lattice and the lack of modeling of agent vehicle behaviors. We propose to apply the Intelligent Driver Model (IDM) [1] as a speed feedback policy to address both of these limitations. IDM both enables the responsive behavior of the agents, and uniquely determines the acceleration and speed profile of the ego vehicle on a given path. Therefore, only a spatial lattice is needed, while discretization of higher order dimensions is no longer required. Additionally, we propose a directed-graph map representation to support the implementation and execution of lattice planners. The map can reflect local geometric structure, embed the traffic rules adhering to the road, and is efficient to construct and update. We show that FELP is more efficient compared to other existing lattice planners through runtime complexity analysis, and we propose two variants of FELP to further reduce the complexity to polynomial time. We demonstrate the improvement by comparing FELP with an existing spatiotemporal lattice planner using simulations of a merging scenario and continuous highway traffic. We also study the performance of FELP under different traffic densities.},
  keywords={Runtime;Merging;Lattices;Planning;Complexity theory;Brakes;Autonomous vehicles},
  doi={10.1109/IROS45743.2020.9340951},
  ISSN={2153-0866},
  month={Oct},}@INPROCEEDINGS{10020698,
  author={Ispirova, Gordana and Eftimov, Tome and Seljak, Barbara Koroušić},
  booktitle={2022 IEEE International Conference on Big Data (Big Data)}, 
  title={Predefined domain specific embeddings of food concepts and recipes: A case study on heterogeneous recipe datasets}, 
  year={2022},
  volume={},
  number={},
  pages={4074-4083},
  abstract={Although recipe data are very easy to come by nowadays, it is really hard to find a complete recipe dataset – with list of ingredients, nutrient values per ingredients, and per recipe, allergens, etc. Recipe datasets are usually collected from social media websites where users post and publish recipes. Usually written with little to no structure, using both standardized and non-standardized units of measurement. We collect six different recipe datasets, publicly available, in different formats and some including data in different languages. Bringing all of these datasets to the needed format for applying a machine learning (ML) pipeline for nutrient prediction [1], [2], includes data normalization using dictionary based named entity recognition (NER), rule based NER, as well as conversions using external domain specific resources. From the list of ingredients, domain-specific embeddings are created using the same embedding space for all recipes – one ingredient dataset is generated. The result from this normalization process are two corpora – one with predefined ingredient embeddings and one with predefined recipe embeddings. On all six recipe dataset the ML pipeline is evaluated. The results from this use case also confirm that the embeddings merged using the domain heuristic yield better results than the baselines.},
  keywords={Training;Dictionaries;Measurement units;Social networking (online);Pipelines;Merging;Predictive models;recipe embeddings;ingredient embeddings;predefined corpus;ML pipeline;domain knowledge;predictive modelling},
  doi={10.1109/BigData55660.2022.10020698},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9927790,
  author={Mattiello, Hamid and Langari, Zeinab Ghasabzadeh and Castro, Manuel and Wittberg, Volker},
  booktitle={2022 IEEE Learning with MOOCS (LWMOOCS)}, 
  title={A Study of MOOCs Project (MODE IT), Techniques, and Know How-Do How Best Practices and Lessons from the Pandemic through the Tomorrow Age Theory}, 
  year={2022},
  volume={},
  number={},
  pages={179-191},
  abstract={MODE IT, Curricular modernization by implementing MOOCs model is a new Erasmus Plus project which use the MOOCs (Massive Open Online Courses) model which will define as: as: 1-) online courses designed for large numbers of participants, 2-) accessible by anyone, anywhere, as long as they have an internet connection, 3-) open to everyone without entry qualifications, 4-) offering a full/complete course experience online for free. There are some reasons to show the importance of MOOCs project because of the situation at the labour market: (1-)Job profiles are merging, (2-)Knowledge and innovations are exponentially growing. (3-)Hence, requirements to the employees are being complex, too, so that they must constantly improve their qualification (lifelong learning), (4-)Solution is however present: a plenty of open online learning provisions are available (such as MOOCs and its variations) but only about 3-5% of registered learners successfully complete them. The situation at many Higher Educational Institutes (HEIs): 1-Compulsory attendance of classes does not stimulate self-organized learning, 2-Blended learning - still very teacher-cantered, 3-Missing skills of educators and supporting structures to design and deliver effective student-cantered learning scenarios, 4-Thus, needs for new and innovative pedagogical approaches at HEIs that promote self-organized, student-cantered learning. MODE IT responds to these needs through integrating MOOCs-based instructional approaches into HEI practices. The objectives of the MOOCs are as: 1)To raise awareness of HEI students for and improve their learning experiences through MOOCs-based approaches, 2)To develop and integrate innovative MOOCs-based instructional approaches into HEI's curriculum design & delivery, 3)To boost HEI educators' awareness and skills for MOOCs-based curriculum design and delivery techniques to achieve online self-assessment tool, online training program for educators and redesigned MOOCs-based HEI curricula. The goal of MODE IT is to introduce innovative MOOC-based pedagogical approaches to the design and delivery of higher education courses. The MODE IT online self-assessment tool allows teaching staff at higher education institutions to check their competence level in the design and development of MOOCs, and to get immediate feedback for possible improvements. The self-assessment tool not only provides real-time feedback on your individual competences related to the design and development of MOOCs. It also offers concrete suggestions for competence improvement in a specific domain! Moreover, you will get the opportunity to increase your competence level by enrolling in the corresponding online training program that will be developed by MODE IT team. Depending on the identified proficiency level, you might be suggested to complete either the entire training or only specific module(s). In this paper we study a MOOCs Project which called MODE IT, to learn the techniques, and Know How-Do How best practices and lessons from the pandemic through the 5thwave/tomorrow age theory which is about readiness for the educational future concerns.},
  keywords={Technological innovation;Computer aided instruction;Electronic learning;Pandemics;Merging;Real-time systems;Educational courses;The 5th Wave/Tomorrow Age Theory;MOOCs Project;MODE IT;Know How-Do How;Best Practices;Lessons from the Pandemic;Pandemic;through the Tomorrow Age Theory;Higher Educational Institutes (HEIs)},
  doi={10.1109/LWMOOCS53067.2022.9927790},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10646768,
  author={Espiritu, Zachary and George, Marilyn and Kamara, Seny and Qin, Lucy},
  booktitle={2024 IEEE Symposium on Security and Privacy (SP)}, 
  title={Synq: Public Policy Analytics Over Encrypted Data}, 
  year={2024},
  volume={},
  number={},
  pages={146-165},
  abstract={Data analytics is a core part of modern decision making, especially in public policy. However, there exists a tension between data privacy and otherwise socially beneficial analytics when data sources contain personal information. We design Synq, a system that supports analytics over encrypted data while accounting for the usability considerations institutions may have when conducting studies that affect public policy. We specifically use an application-centric approach and model Synq’s design requirements from a large-scale series of studies conducted on the opioid epidemic in Massachusetts. We systematize the design considerations of the public policy context and demonstrate how the combination of design considerations that Synq addresses is novel through a survey of the literature. We then present our protocol which combines structured encryption, somewhat homomorphic encryption, and oblivious pseudorandom functions to support a complex query language that includes filtering (retrieving rows by attribute/value pairs), linking (merging rows from different tables that represent the same individual) and aggregate functions (sum, count, average, variance, regression). We formally express the security of our protocol and show that Synq is efficient in practice while satisfying usability considerations that are critical to deployment in the setting of public policy studies.},
  keywords={Surveys;Data privacy;Protocols;Filtering;Soft sensors;Merging;Opioids},
  doi={10.1109/SP54263.2024.00085},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{10312286,
  author={Gohari, Homayoun Soltani and Tarzamni, Hadi and Sergeant, Peter and Vansompel, Hendrik},
  booktitle={IECON 2023- 49th Annual Conference of the IEEE Industrial Electronics Society}, 
  title={PV-Grid Integrated Multifunctional Buck-boost On-board EV Charger with CCM-DCM Operation}, 
  year={2023},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper delves into the development of on-board EV chargers with the purpose of using the energy of the vehicle-roof photovoltaic panels and merging charging and driving modes power converters. In pursuit of this objective, a novel high step-up coupled inductor-based DC-DC converter is proposed, which enables the proposed charger to use the PV panel energy in an efficient way. From utility grid point of view, a bridgeless AC-DC converter is considered that is able to operate in continuous and discontinuous conduction modes (CCM and DCM), providing the chance to achieve natural power factor correction in DCM operation in addition to control the power factor in CCM operation. The sources participate in charging process via the proposed dual-input single-output SEPIC based DC-DC converter. In addition to the charging mode, in which the battery is charged using grid and/or PV panel, the proposed charger can deliver energy from the battery and PV panel to the motor drive system during driving mode. It should be noted that the buck-boost structure of the proposed converter enables the control system to manage the power sources and load efficiently according to their characteristics. All stages of the proposed multifunctional multiport on-board charger are analyzed thoroughly and simulation results are given to validate the analysis.},
  keywords={Photovoltaic systems;Motor drives;Reactive power;Simulation;Merging;DC-DC power converters;Power factor correction;Discontinues conduction mode;electric vehicle;high step-up converter;on-board charger;power factor correction;PV panel},
  doi={10.1109/IECON51785.2023.10312286},
  ISSN={2577-1647},
  month={Oct},}@INPROCEEDINGS{9833865,
  author={Grushin, Alexander and Woods, Walt},
  booktitle={2022 IEEE Security and Privacy Workshops (SPW)}, 
  title={Anomaly Detection with Neural Parsers That Never Reject}, 
  year={2022},
  volume={},
  number={},
  pages={88-97},
  abstract={Reinforcement learning has recently shown promise as a technique for training an artificial neural network to parse sentences in some unknown format, through a body of work known as RL-GRIT. A key aspect of the RL-GRIT approach is that rather than explicitly inferring a grammar that describes the format, the neural network learns to perform various parsing actions (such as merging two tokens) over a corpus of sentences, with the goal of maximizing the estimated frequency of the resulting parse structures. This can allow the learning process to more easily explore different action choices, since a given choice may change the optimality of the parse (as expressed by the total reward), but will not result in the failure to parse a sentence. However, this also presents a limitation: because the trained neural network can successfully parse any sentence, it cannot be directly used to identify sentences that deviate from the format of the training sentences, i.e., that are anomalous. In this paper, we address this limitation by presenting procedures for extracting production rules from the neural network, and for using these rules to determine whether a given sentence is nominal or anomalous. When a sentence is anomalous, an attempt is made to identify the location of the anomaly. We empirically demonstrate that our approach is capable of grammatical inference and anomaly detection for both non-regular formats and those containing regions of high randomness/entropy. While a format with high randomness typically requires large sets of production rules, we propose a two pass grammatical inference method to generate parsimonious rule sets for such formats. By further improving parser learning, and leveraging the presented rule extraction and anomaly detection algorithms, one might begin to understand common errors, either benign or malicious, in practical formats.},
  keywords={Training;Merging;Production;Reinforcement learning;Inference algorithms;Frequency estimation;Grammar;Machine Learning;Reinforcement Learning;Artificial Neural Networks;Grammatical Inference;Anomaly Detection},
  doi={10.1109/SPW54247.2022.9833865},
  ISSN={2770-8411},
  month={May},}@INPROCEEDINGS{10627917,
  author={Kumar, T G Keerthan and Ogare, Mukesh Kumar and Koolagudi, Shashidhar. G.},
  booktitle={2024 International Conference on Signal Processing, Computation, Electronics, Power and Telecommunication (IConSCEPT)}, 
  title={ECG Signal Classification using Continuous Wavelet Transform Scalogram and Convolutional Neural Network}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Automated classification of electrocardiogram (ECG) signals is pivotal for timely and accurate diagnosis of cardiac abnormalities. In this work weintroduces a new method for classifying electrocardiogram (ECG) signals by merging signal processing and deep learning techniques. We utilize Continuous Wavelet Transform (CWT) to convert one-dimensional ECG signals into scalogram images, capturing both temporal and frequency details. By employing transfer learning, we fine-tune a pre-trained AlexNet Convolutional Neural Network (CNN) to categorize ECG signals into three types: arrhythmia, congestive heart failure, and normal sinus rhythm. We extensively compare our method with existing approaches, demonstrating its superior performance with an accuracy of 96%. The hierarchical structure of AlexNet enables the extraction of intricate features from ECG signals, surpassing other models that suffer from shallow architectures and reliance on manual feature engineering. Our approach not only improves automated ECG analysis but also holds promise for enhancing clinical diagnosis and management of cardiovascular conditions.},
  keywords={Continuous wavelet transforms;Accuracy;Transfer learning;Merging;Pattern classification;Electrocardiography;Signal processing;Electrocardiogram;Arrhythmia;Continuous Wavelet Transform;Scalogram;AlexNet},
  doi={10.1109/IConSCEPT61884.2024.10627917},
  ISSN={},
  month={July},}@INPROCEEDINGS{10065005,
  author={Khan, Soma and Basu, Tulika and Basu, Joyanta and Pal, Madhab and Roy, Rajib and Bepari, Milton S.},
  booktitle={2022 4th International Conference on Artificial Intelligence and Speech Technology (AIST)}, 
  title={Data Collection and Development of Bengali ASR and TTS for Conversational AI-based Automated Advisories in the Agriculture domain}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents an indigenous work of text and speech data collection and organization in the agriculture domain and developing a structured Agriculture Knowledge Repository (AKR), Automatic Speech Recognition (ASR), and Text-To-Speech synthesis (TTS) systems in Bengali language, applicable to agriculture-related automated advisory systems. Authors have searched available data sources, interacted with real farmers and experts at local farming fields and agriculture institutes, collected feedback on actual advisory requirements, and designed an initial text corpus which is then used to prepare 10,000 numbers of unique query-answer pairs with 5000 agri-keywords in the final AKR. The DNN-HMM based ASR is trained by merging general domain speech data with 40.5 hours of agriculture data newly collected using a mobile app, web-based and Interactive Voice Response (IVR) based data collection setups. TTS is developed in one male and one female voice with 20 hours of studio speech data using DNN-based architecture. Both the ASR and TTS are tested with end users in real environments and are having encouraging results. Corpus collection and system development methodology is language invariant and developed sub-systems can be readily used for web or mobile chatbot-based and IVR-based automated advisory applications in the agriculture domain.},
  keywords={Soft sensors;Merging;Organizations;Data collection;Telephony;Agriculture;Mobile handsets;Knowledge Repository;Agriculture data collection;DNN-based ASR;TTS},
  doi={10.1109/AIST55798.2022.10065005},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10104674,
  author={Laboso, Patrick Kipkorir and Martin, A and Thiyagarajan, P},
  booktitle={2023 International Conference on Sustainable Computing and Data Communication Systems (ICSCDS)}, 
  title={Blockchain Technologies in Data Science: Challenges and Benefits}, 
  year={2023},
  volume={},
  number={},
  pages={1323-1328},
  abstract={The rapid expansion of data in the modern era is primarily due to the emergence of social networks and information. Because of the number and diversity of data available, researchers are more likely to employ big data analysis to make business judgments. Additionally, this has contributed to the data science sector’s explosive growth. Many problems still need to be resolved, notably those involving data security and privacy. Concerns for data security and confidentiality arise at every stage of the data science sector, ranging from data extraction, gathering, preparation, and dissemination. The underlying reasons for risk are closely intertwined. Because of its distributed structure, privacy, protection, and other features, blockchain technology is highly regarded and acknowledged. This could alter the way the information is obtained and distributed. Even though experts think blockchain technology will assist data science in advancing and conquering some of its current obstacles, there may be some unintended consequences. Therefore, it is essential to investigate how blockchain technology and data science are related. Then examine blockchain technology challenges and its benefits that will be of great importance to data science. This discussion and its drawbacks will open up the future research direction in blockchain technology when it merges with data science.},
  keywords={Data privacy;Privacy;Power demand;Social networking (online);Data security;Merging;Data science;Big Data;Blockchains;Monitoring;Big Data Analysis;Blockchain;Data Science;Security;and Privacy},
  doi={10.1109/ICSCDS56580.2023.10104674},
  ISSN={},
  month={March},}@INPROCEEDINGS{11375343,
  author={He, Qingdong and Peng, Jinlong and Jiang, Zhengkai and Hu, Xiaobin and Zhang, Jiangning},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision Workshops (ICCVW)}, 
  title={PointSeg: A Training-Free Paradigm for 3D Scene Segmentation via Foundation Models}, 
  year={2025},
  volume={},
  number={},
  pages={2678-2688},
  abstract={Recent success of vision foundation models have shown promising performance for the 2D perception tasks. However, it is difficult to train a 3D foundation network directly due to the limited dataset and it remains under explored whether existing foundation models can be lifted to 3D space seamlessly. In this paper, we present PointSeg, a novel training-free paradigm that leverages off-the-shelf vision foundation models to address 3D scene perception tasks. PointSeg can segment anything in 3D scene by acquiring accurate 3D prompts to align their corresponding pixels across frames. Concretely, we design a two-branch prompts learning structure to construct the 3D point-box prompts pairs, combining with the bidirectional matching strategy for accurate point and proposal prompts generation. Then, we perform the iterative post-refinement adaptively when cooperated with different vision foundation models. Moreover, we design a affinity-aware merging algorithm to improve the final ensemble masks. PointSeg demonstrates impressive segmentation performance across various datasets, all without training. Specifically, our approach significantly surpasses the state-of-the-art specialist training-free model by 16.3%, 14.9%, and 15% mAP on ScanNet, ScanNet++, and KITTI-360 datasets, respectively. On top of that, PointSeg can incorporate with various foundation models and even surpasses the specialist training-based methods by 5.6%-8% mAP across various datasets, serving as an effective generalist model.},
  keywords={Training;Solid modeling;Computer vision;Three-dimensional displays;Accuracy;Foundation models;Conferences;Merging;Iterative methods;Proposals;3D Point Cloud Learning;Training-Free},
  doi={10.1109/ICCVW69036.2025.00279},
  ISSN={2473-9944},
  month={Oct},}@INPROCEEDINGS{10859204,
  author={Leopold, Mario and Schoeffmann, Klaus},
  booktitle={2024 International Conference on Content-Based Multimedia Indexing (CBMI)}, 
  title={diveXplore at IVR4B 2024}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={The ability of contrastive language-image pretraining (CLIP) to pair text and image embeddings has notably enhanced the performance of video retrieval, enabling systems to efficiently utilize free-text searches within a CLIP-based embeddings index. Despite these technological improvements, disparities in user performance have been observed in recent video retrieval competitions, such as the Video Browser Showdown 2024 (VBS2024). We conclude that not only a highly accurate search index is important, but also factors such as runtime performance, system usability, browsing context, and interaction features. Addressing these issues, we introduce an enhanced version of the diveXplore system, merging the features of diveXplore 2024 and diveXB, our previously used systems for VBS2024 and IVR4B 2023. The system is designed for simple usage by video retrieval beginners, and optimized for fast and accurate search with clear content structuring and browsing context. The current diveXplore system uses an index of CLIP embeddings as the basic search method, including temporal queries, but also allows other search types (e.g., OCR, speech, metadata, etc.). It integrates a new video preview component with enriched browsing context, including a video summary of the related video, a video player, and a list of similar videos.},
  keywords={Accuracy;Runtime;Search methods;Multimedia systems;Merging;Optical character recognition;Streaming media;Metadata;Usability;Indexing;video retrieval;similarity search;user experience;novice users},
  doi={10.1109/CBMI62980.2024.10859204},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{9117275,
  author={Naveed, Quadri Noorulhasan and Ahmad, Naim and Qamar, Shamimul and Khan, Nawsher and Naim, Arshi and Hussain, Mohammad Rashid and Qureshi, Mohamed Rafik N. and Alsayed, Alhuseen Omar and Mohiuddin, Khalid},
  booktitle={2019 IEEE 6th International Conference on Engineering Technologies and Applied Sciences (ICETAS)}, 
  title={Relationship modeling for OSN-based E-Learning Deployment}, 
  year={2019},
  volume={},
  number={},
  pages={1-7},
  abstract={The-Learning provides an opportunity to educate people in a cost-effective manner. It is preferred by the society that doesn't have access to traditional education system. The online social networking site (OSN) is playing a significant role in removing digital divide by making a new tech-savvy generation. E-Learning system can become wider and more effective if online social media tools are also included. In this research, 15 factors of OSN based E-learning have been identified through literature review and expert opinion was sought to enhance productivity and performance of OSN based E-Learning by merging social media in it. Interpretive Structure Modeling (ISM) has been used and validated through interviews with experts. In the present research, E-Learning factors for OSN are quantified and classified through MICMAC analysis. This study will help E-Learning stakeholders in organizing and prioritizing resources in the right direction to enhance its effectiveness, productivity and sustainability in OSN based E- Learning.},
  keywords={Productivity;Analytical models;Electronic learning;Social networking (online);Merging;Education;Stakeholders;Sustainable development;Interviews;Systematic literature review;Enabling Factors;E-Learning System;Interpretive Structural Modeling (ISM);MICMAC Analysis;Productive OSN based E-Learning},
  doi={10.1109/ICETAS48360.2019.9117275},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9936532,
  author={Saranya, S. S. and Fatima, N. Sabiyath},
  booktitle={2022 International Conference on Edge Computing and Applications (ICECAA)}, 
  title={Exploration on IoT based Edge Cloud Computing Techniques for Improving the Patient Information Management System}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={Clinics around the globe are adopting newer, highly advanced technologies. The Internet of Things (IoT) has emerged due to advancements in information and communication technology. Integration of the IoT with accessible medical devices, and patients and their surroundings has opened up new possibilities for data collecting and more intelligent decisions in recent years. IoT technologies benefit healthcare professionals and patients in today’s medical context because they are used in several treatment domains (like real-time monitoring, patient information and healthcare management). Diverse and distributed devices will gather, analyse, and transmit real-time medical data to open clouds in the upcoming world of IoT for healthcare, allowing for the accumulation, piling, and analysis of elementary data streams in many new procedures and the activation of context-dependent intimations. Healthmonitoring and remote treatment are possible with an IoT paradigm that uses sensors (environmental, wearable, implanted) distributed throughout the local environment.It has been critical to create new technology for storing large amounts of clinical data in recent years. Cloud storage has become enormous, and it is managed by merging IoT and Edge Computing (EC) technologies. According to recent research, the integration of IoT and the cloud has a considerable impact on remote healthcare. This survey report focuses on howIoT devices with EC can enhance people’s health while guaranteeing that medicines and medicine delivery are error-free. This research will act as a source and reference of knowledge regarding smart healthcare for healthcare professionals, researchers, and others interested in learning more about IoT with EC-based healthcare applications.},
  keywords={Cloud computing;Technological innovation;Distributed databases;Data integration;Medical services;Real-time systems;Internet of Things;Internet of Things (IoT);data mining;cloud edge computing;data processing;health care systems},
  doi={10.1109/ICECAA55415.2022.9936532},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{8904369,
  author={Celik, Ahmet and Gursoy, Mustafa Can and Basar, Ertugrul and Pusane, Ali Emre and Tugcu, Tuna},
  booktitle={2019 IEEE 30th Annual International Symposium on Personal, Indoor and Mobile Radio Communications (PIMRC)}, 
  title={A Low-Complexity Solution to Angular Misalignments in Molecular Index Modulation}, 
  year={2019},
  volume={},
  number={},
  pages={1-6},
  abstract={Multiple-input multiple-output (MIMO) transmission approaches have been recently considered in the context of molecular communications due to desirable improvements they provide in terms of communication efficiency. Among these methods, molecular index modulation (molecular-IM) schemes yield a significant improvement in throughput and show promising results for future molecular MIMO research. However, existing molecular-IM methods rely on perfect spatial alignment between corresponding antennas, which may not be the case in a possible practical scenario. Motivated by this practical constraint, this study proposes a novel receiver design for molecular-IM. The proposed decoder is an augmented version of the maximum count decoder (MCD) and operates by merging MCD with a simple linear combining technique. Our numerical results show that the proposed approach yields a desirable robustness against antenna misalignments while still maintaining a simplistic receiver structure.},
  keywords={Diversity reception;Merging;Modulation;Receiving antennas;Molecular communication;Mobile antennas;Throughput;Robustness;Decoding;Indexes;Molecular communications;index modulation;molecular MIMO;robust receiver design;antenna misalignment},
  doi={10.1109/PIMRC.2019.8904369},
  ISSN={2166-9589},
  month={Sep.},}@INPROCEEDINGS{10826591,
  author={Badoni, Akhil and Kaushal, Gaurav and Tiwari, Alok Kumar and Tripathi, Pawan},
  booktitle={2024 International Conference on Computer, Electronics, Electrical Engineering & their Applications (IC2E3)}, 
  title={Graph Convolution Network with Temporal Features for Autism Disorder Classification}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Autism Spectrum Disorder (ASD) is a significant developmental brain disorder. Recently, several advanced deep learning techniques leveraging functional magnetic resonance imaging (FMRI) data have emerged for ASD classification. Notably, graph neural networks, extending deep neural network models to graph-structured data, have demonstrated considerable benefits. Various GNN models have been proposed in the past, including the latest Heterogeneous Graph Convolution Attention Network (HCAN), which combines the phenotype features of patients and generates a graph. While some studies make use of temporal features in FMRI data, few integrate these features with phenotype data. This study presents a novel approach by adapting the state-of-the-art HCAN architecture to incorporate temporal features. By merging these two methodologies, the research seeks to propel the field towards improved accuracy and reliability in ASD detection.},
  keywords={Deep learning;Autism;Phenotypes;Convolution;Merging;Functional magnetic resonance imaging;Propulsion;Brain modeling;Graph neural networks;Reliability},
  doi={10.1109/IC2E362166.2024.10826591},
  ISSN={},
  month={June},}@INPROCEEDINGS{9782671,
  author={Rudolf, Thomas and Gao, Mingxiao and Schürmann, Tobias and Schwab, Stefan and Hohmann, Sören},
  booktitle={2022 8th International Conference on Control, Automation and Robotics (ICCAR)}, 
  title={Fuzzy Action-Masked Reinforcement Learning Behavior Planning for Highly Automated Driving}, 
  year={2022},
  volume={},
  number={},
  pages={264-270},
  abstract={Highly-automated driving relies on informed decision making and safe control in a dynamic environment which is regulated by traffic rules. This complex environment can be formulated as a map-based problem where the driving task is constrained by kinematics, obstacles, traffic, and road structure. Though, solving the problem with a monolithic approach additionally can lead to infeasible conditions which are difficult to bypass. Therefore, we expect a separate layer for sequential decision making to be a more suitable approach to derive a lateral and longitudinal behavior. In this area of decision making, reinforcement learning (RL) is a viable approach to complex and nonlinear problems. However, the learning convergence to a reasonable behavior in a critical and constrained environment can be slow. To overcome this challenge, we propose an action-masked RL agent utilizing fuzzy traffic rule descriptions. The agent outputs are hybrid lateral and longitudinal actions based on the environment observations. These driving decisions interface the subsequent trajectory planner and control for optimal execution. In exemplary merging scenarios, we show the effectiveness of the masked agent to increase convergence speed toward a reasonable behavior.},
  keywords={Roads;Decision making;Merging;Reinforcement learning;Behavioral sciences;Trajectory;Planning;behavior planning;reinforcement learning;fuzzy logic;action masking;highly automated driving},
  doi={10.1109/ICCAR55106.2022.9782671},
  ISSN={2251-2454},
  month={April},}@INPROCEEDINGS{10822409,
  author={Liu, Jun and Wang, Wenyi and Wang, Wei and Luo, Gongning and Li, Yacong and Wang, Kuanquan},
  booktitle={2024 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={EdgeReg: Edge-assisted Unsupervised Medical Image Registration}, 
  year={2024},
  volume={},
  number={},
  pages={3543-3548},
  abstract={Medical image registration (MIR) is essential for various clinical diagnoses and treatments. Despite the rapid progress in deep learning-based MIR techniques, most methods focus on directly optimizing the raw image intensity information. In this paper, we explore the usage of edge information of anatomical structures associated with the spatial location of image intensities to assist in registration, termed EdgeReg. The intuition is that the edge information can provide additional rich boundary information to the raw images, enhancing the network’s feature representation. Additionally, as the edge images are strictly spatially consistent with the raw images, additional supervised information can be added to network training. Specifically, we first extract the edge images from the raw moving and fixed images using the Sobel operator and feed these images into a lightweight feature extractor to merge the image intensity and edge information. The enriched features are subsequently input into established registration networks. Finally, similarity loss is applied to both the raw and edge images. Extensive experiments show that EdgeReg is compatible with various networks across diverse datasets and dimensions (2D and 3D), achieving superior registration performance. In particular, EdgeReg does not rely on segmentation labels and is trained in an unsupervised paradigm. Therefore, edge information is a beneficial assistance for unsupervised MIR. The code is available at https://github.com/PerceptionComputingLab/EdgeReg.},
  keywords={Training;Image registration;Image segmentation;Three-dimensional displays;Image edge detection;Anatomical structure;Feature extraction;Data mining;Feeds;Optimization;edge image;medical image registration;unsupervised learning},
  doi={10.1109/BIBM62325.2024.10822409},
  ISSN={2156-1133},
  month={Dec},}@INPROCEEDINGS{10940484,
  author={Padhiary, Mrutyunjay and Powar, Swati and Asokan, Anju and Sundar Rajan, M. and Al-Said, Khaleel and Al Said, Nidal},
  booktitle={2025 International Conference on Pervasive Computational Technologies (ICPCT)}, 
  title={Combining Convolutional Neural Networks with Reinforcement Learning for Autonomous Robotics}, 
  year={2025},
  volume={},
  number={},
  pages={421-425},
  abstract={The use of artificial intelligence (AI) in robotics, particularly in the advancement of gaming robotics, has drawn a lot of interest as technological and scientific developments continue to advance. This innovation opens up new possibilities for creating smart autonomous robots for gaming. Nevertheless, there is more work to be done to achieve great accuracy and consistency in motion management. The challenges of the robotics' level of smart and the motion-capturing structure's capacity to prevent interruption still require resolution, although numerous methods have been put out to improve monitoring accuracy by merging various data. This study proposes an adaptable reinforcement learning (RL)-oriented multifaceted data combination (AdRL-MDC) system for training a robotic hand to play games alongside humans. It incorporates an adaptable training process for updating the ensemble classification algorithm, an RL paradigm that provides the robots with smart knowledge, and a multifaceted data combination framework that is resistant to interruption. The following studies demonstrate the AdRL-MDC system's previously indicated functionality. The ensemble framework, which combines a convolutional neural network (CNN), performs well in terms of accuracy and computing duration. Furthermore, the depth vision-oriented CNN classification algorithm achieves one hundred percent recognition accuracy, implying that the forecasted motions are the real value.},
  keywords={Training;Resistance;Technological innovation;Accuracy;Merging;Reinforcement learning;Classification algorithms;Convolutional neural networks;Monitoring;Autonomous robots;Reinforcement Learning;Convolutional neural network;Autonomous robots;Gaming;Motion management},
  doi={10.1109/ICPCT64145.2025.10940484},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11113084,
  author={Yao, Zhongming and Li, Tianyi and Xin, Junchang and Li, Yushuai and Wang, Chenxu and Wang, Zhiqiong and Srivastava, Divesh and Jensen, Christian S.},
  booktitle={2025 IEEE 41st International Conference on Data Engineering (ICDE)}, 
  title={VGQ: Enabling Verifiable Graph Queries on Blockchain Systems}, 
  year={2025},
  volume={},
  number={},
  pages={3602-3614},
  abstract={Blockchain technology has transformed financial services sectors by providing security, transparency, and immutability through decentralized ledger systems. However, while blockchain data can support a range of applications-such as user quality analysis, illegal activity detection, and transaction pattern identification-existing systems are restricted to basic queries on blocks and transactions due to their sequential data storage. To support queries more generally, we propose VGQ, the first verifiable graph query (VGQ) framework that enables efficient graph queries on blockchain systems without altering blockchain storage structures. VGQ integrates a query layer with an external graph database system and represents blockchain data as a directed transaction graph to improve the efficiency of graph query execution. To ensure reliable results, VGQ includes result verification with three key performance enhancing optimizations: (i) computing connected components to exclude irrelevant vertices and edges during verification; (ii) merging information from edges to accelerate completeness verification; and (iii) employing a dual pointer algorithm for efficient soundness verification. Experiments offer evidence that VGQ can improve on the state-of-the-art framework in terms of query efficiency by up to one order of magnitude and in terms of verification efficiency by up to two orders of magnitude.},
  keywords={Merging;Memory;Data engineering;Database systems;Blockchains;Security;Reliability;Data mining;Optimization;Financial services;blockchain;graph query;verifiable query;graph database},
  doi={10.1109/ICDE65448.2025.00269},
  ISSN={2375-026X},
  month={May},}@INPROCEEDINGS{9834409,
  author={Ravi, Aditya Narayan and Vahid, Alireza and Shomorony, Ilan},
  booktitle={2022 IEEE International Symposium on Information Theory (ISIT)}, 
  title={Capacity of the Shotgun Sequencing Channel}, 
  year={2022},
  volume={},
  number={},
  pages={210-215},
  abstract={Most DNA sequencing technologies are based on the shotgun paradigm: many short reads are obtained from random unknown locations in the DNA sequence. A fundamental question, studied in [1], is what read length and coverage depth (i.e., the total number of reads) are needed to guarantee reliable sequence reconstruction. Motivated by DNA-based storage, we study the coded version of this problem; i.e., the scenario in which the DNA molecule being sequenced is a codeword from a predefined codebook. Our main result is an exact characterization of the capacity of the resulting shotgun sequencing channel as a function of the read length and coverage depth. In particular, our results imply that while in the uncoded case, O(n) reads of length greater than 2logn are needed for reliable reconstruction of a length-n binary sequence, in the coded case, only O(n/log n) reads of length greater than log n are needed for the capacity to be arbitrarily close to 1.},
  keywords={Sequential analysis;DNA;Reliability theory;Genetic communication;DNA shotgun sequencing;DNA-based storage;channel capacity},
  doi={10.1109/ISIT50566.2022.9834409},
  ISSN={2157-8117},
  month={June},}@ARTICLE{11271764,
  author={Xing, Yile and Chen, Donglong and Yan, Hong and Cheung, Ray C.C.},
  journal={IEEE Transactions on Signal Processing}, 
  title={Fast Weighted Transforms for Linear Convolution}, 
  year={2025},
  volume={73},
  number={},
  pages={5003-5014},
  abstract={Convolution is fundamental in digital signal processing across many applications. Existing works enable  $ N $ -point linear convolution via  $ N $ -point right-angle circular convolution (RCC) based on weighted transforms, effectively removing the need for zero padding. However, these methods are constrained by their choice of weights, which impacts the complexity of weight-related multiplications at the start of the transform and the end of the inverse transform. This limitation leads to either reduced accuracy or increased complexity in weighted Fourier transform (WFT)-based convolution, as well as restricted transform lengths in weighted Fermat number transform (WFNT)-based convolution. In this work, we address these challenges by merging the multiplications by weights into the butterfly structures with arbitrary power-of-2 radix for both WFT and WFNT. We also propose an extraction method to accommodate negative and complex numbers. Our work ensures that weights do not increase complexity, thereby improving accuracy and reducing complexity in WFT-based convolution, while allowing for a broader range of transform lengths in WFNT-based convolution.},
  keywords={Convolution;Transforms;Laplace equations;Discrete Fourier transforms;Complexity theory;Galois fields;Fast Fourier transforms;Accuracy;Merging;Electronic mail;Linear convolution;discrete Fourier transform;number theoretic transform;fast weighted transform;weighted Fourier transform;weighted Fermat number transform},
  doi={10.1109/TSP.2025.3637157},
  ISSN={1941-0476},
  month={},}@INPROCEEDINGS{10919917,
  author={Luo, Ruikang and Song, Yaofeng and Lu, Yun and Zhao, Nanbin and Su, Rong},
  booktitle={2024 IEEE 27th International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={STGIN: A Spatial Temporal Graph-Informer Network for Long Sequence Traffic Speed Forecasting}, 
  year={2024},
  volume={},
  number={},
  pages={3221-3226},
  abstract={Accurate long series forecasting of traffic information is critical for the development of intelligent traffic systems. We may benefit from the rapid growth of neural network analysis technology to better understand the underlying functioning patterns of traffic networks as a result of this progress. Due to the fact that traffic data and facility utilization circumstances are sequentially dependent on past and present situations, several related neural network techniques based on temporal dependency extraction models have been developed to solve the problem. The complicated topological road structure, on the other hand, amplifies the effect of spatial interdependence, which cannot be captured by pure temporal extraction approaches. Additionally, the typical Deep Recurrent Neural Network (RNN) topology has a constraint on global information extraction, which is required for comprehensive long-term prediction. This study proposes a new spatial-temporal neural network architecture, called Spatial-Temporal Graph-Informer (STGIN), to handle the long-term traffic parameters forecasting issue by merging the Informer and Graph Attention Network (GAT) layers for spatial and temporal relationships extraction. The attention mechanism potentially guarantees long-term prediction performance without significant information loss from distant inputs. On two real-world traffic datasets with varying horizons, experimental findings validate the long sequence prediction abilities, and further interpretation is provided.},
  keywords={Recurrent neural networks;Attention mechanisms;Network topology;Roads;Time series analysis;Merging;Transformers;Stability analysis;Topology;Forecasting},
  doi={10.1109/ITSC58415.2024.10919917},
  ISSN={2153-0017},
  month={Sep.},}@INPROCEEDINGS{11302443,
  author={Wang, Chaohan and Chen, Qi and Xie, Yutong and Wu, Qi},
  booktitle={2025 International Conference on Digital Image Computing: Techniques and Applications (DICTA)}, 
  title={Filling in the Missing Piece: Advancing Automated Radiology Report Generation with Clinical Insights}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Radiology reports synthesize a radiologist's insights into a patient's condition, serving as vital tools for directing patient care. Despite advances in automated report generation, existing approaches often oversimplify this task, lacking consensus on input selection, ground-truth usage, and output structure. Most methods rely solely on imaging data, merging findings and the impression as a combined output, or incorporate indications as input but generate only the findings. Drawing insights from established medical literature, we clarify the roles and interconnections of report sections and provide definitive answers to some critical questions: (1) What should be the inputs and outputs of a report generation model and why? (2) Can modeling inter-section relationships enhance model performance? We validate our perspective through statistical analyses on MIMIC-CXR, demonstrating universal interdependencies among report sections. We further introduce MIMIC-1V3, a curated dataset derived from MIMIC-CXR where each report is segmented into three sections: the indication, findings, and impression. Furthermore, we propose a R adiologist-L ike P rogressive G eneration (RLPG) framework, explicitly modeling relationships among report sections. RLPG mirrors the real-world clinical workflow in two stages: visual understanding to produce factual observations (findings) of the $X$-ray images, and diagnostic reasoning to interpret the implications of findings (impression), addressing the clinical question in the indication.},
  keywords={Visualization;Image segmentation;Statistical analysis;Digital images;MIMICs;Merging;Radiology;Filling;Mirrors;Medical diagnostic imaging},
  doi={10.1109/DICTA68720.2025.11302443},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11133000,
  author={Wang, Gang and Cai, Siqi and Li, Zhenyu and Li, Wenjie and Lyu, Dongxu and Sun, Yanan and Jiang, Jianfei and He, Guanghui},
  booktitle={2025 62nd ACM/IEEE Design Automation Conference (DAC)}, 
  title={BitPattern: Enabling Efficient Bit-Serial Acceleration of Deep Neural Networks through Bit-Pattern Pruning}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Bit-serial computation shows promise for accelerating deep neural networks (DNNs) by exploiting inherent bit sparsity. However, the original unstructured bit sparsity poses two major challenges for existing bit-serial accelerators (BSA): (1) workload imbalance from irregular bit distribution, and (2) inefficient memory access due to unpredictable non-zero bit locations. To address these issues, this paper proposes BitPattern, an algorithm/hardware co-design to efficiently accelerate bitserial computation through bit-pattern pruning. At the algorithm level, we employ bit-pattern pruning to identify optimal combinations of predefined patterns and apply compression encoding to minimize weight storage. We further devise a pattern-similaritybased merging method to balance the bit-serial workload. At the hardware level, we co-design a bit-serial accelerator with a dedicated bit-pattern decoder and PE to leverage the potential of structured bit-pattern sparsity. The evaluation on several deep learning benchmarks shows that BitPattern can achieve $1.72 \times$ memory reduction with negligible accuracy loss, and up to $2.11 \times$ speedup and $1.86 \times$ energy saving compared to state-of-the-art bit-serial accelerators.},
  keywords={Design automation;Merging;Memory management;Energy conservation;Artificial neural networks;Hardware;Encoding;Computational efficiency;Decoding;Optimization;Bit-serial computation;DNN acceleration;Sparsity;Algorithm/hardware co-design;Compression},
  doi={10.1109/DAC63849.2025.11133000},
  ISSN={},
  month={June},}@INPROCEEDINGS{11223343,
  author={Lopez-Cabrejos, Josue and Leher, Quefren and Ferreti, Gustavo and Costa Carvalho, Lucas Hildelbrano and Paixão, Thuanne and Alvarez, Ana Beatriz and Luque, D. B.},
  booktitle={2025 38th SIBGRAPI Conference on Graphics, Patterns and Images (SIBGRAPI)}, 
  title={PavicHDR: An Efficient Architecture for HDR Image Reconstruction Based on CNN and Attention Mechanisms}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={High dynamic range (HDR) image reconstruction is a technique that consists of merging multiple low dynamic range (LDR) images of the same scene in order to increase the quality of the image. One of the main challenges in this process is the movement present in each frame, which can generate ghosting artifacts in the resulting image. This paper proposes the PavicHDR architecture, designed to eliminate ghosting due to movement while maintaining a low computational cost. To do this, efficient feature extraction, alignment, refinement and fusion techniques were used. The quantitative and qualitative experiments carried out with the Kalantari and Tel datasets show the superior performance of PavicHDR in terms of reconstruction quality, reduction of distortions and preservation of structures. Moreover, it stands out for its reduced inference time compared to the state-of-the-art, including methods based on diffusion, vision transformers and adversarial neural networks.},
  keywords={Graphics;Computer vision;Neural networks;Merging;Computer architecture;Transformers;Feature extraction;Distortion;High dynamic range;Image reconstruction},
  doi={10.1109/SIBGRAPI67909.2025.11223343},
  ISSN={2377-5416},
  month={Sep.},}@INPROCEEDINGS{10661740,
  author={Zhou, Yangtong and Wang, Han and Wang, Shaochu and Liu, Yu},
  booktitle={2024 43rd Chinese Control Conference (CCC)}, 
  title={Nested U-Net with Separable 3D Convolution for Hyperspectral Image Super-Resolution}, 
  year={2024},
  volume={},
  number={},
  pages={7996-8001},
  abstract={Hyperspectral visible-band image acquisition currently encounters challenges of low spatial resolution, which arises from the necessary trade-offs between achieving higher spectral resolution and ensuring rapid data capture. Deep learning-based single-modality image super-resolution methods have proven effective in recovering the resolution of hyperspectral image sequences and garnered considerable attention. The main challenge in hyperspectral image super-resolution lies in leveraging spectral relevance across successive bands and spatial details in a three-dimensional (3D) image cube. To address this issue, this paper introduces a Nested U-Net (NUNet) for single-modality hyperspectral image super-resolution. NUNet utilizes interval grouping to minimize information redundancy and incorporates a nested U-shaped structure with skip and residual connections to deepen the network and enhance multi-level information utilization. We also develop a separable residual 3D unit featuring parallel separable 3D convolutions to effectively extract and integrate spatial and spectral features. The method includes a feature context fusion module for merging feature information across groups and employs pixel shuffle for high-resolution image reconstruction. Experimental evidence demonstrates NUNet’s strengths over existing state-of-the-art techniques.},
  keywords={Measurement;Three-dimensional displays;Superresolution;Neural networks;Merging;Termination of employment;Feature extraction;hyperspectral image;super-resolution;separable 3D convolution;convolutional neural network},
  doi={10.23919/CCC63176.2024.10661740},
  ISSN={1934-1768},
  month={July},}@INPROCEEDINGS{11316027,
  author={Zhu, Zhan-Yang and Xu, Ning and Wu, Hao-Ying and Lu, Chenglin},
  booktitle={2025 10th International Conference on Integrated Circuits and Microsystems (ICICM)}, 
  title={Topology Evaluation-Based Layer Assignment Method for Free-assignment Routing in InFO Packages}, 
  year={2025},
  volume={},
  number={},
  pages={384-390},
  abstract={With the increasing complexity of system designs, advanced packaging technologies continue to emerge. Among them, the Integrated Fan-Out (InFO) Wafer-Level Chip-Scale Package (WLCSP) has gained significant attention as a cuttingedge solution that enables high-density and flexible system integration through multi-chip integration and multi-layer interconnection. As the physical size of InFO-WLCSP packages expands, the I/O pad density increases exponentially, making the topological crossover of free-assignment nets a critical bottleneck that severely constrains routing quality. Existing methods typically address topological crossover issues during the routing stage through iterative approaches, which often fail to provide satisfactory solutions. In this paper, we propose, for the first time, a predictive approach to anticipate topological crossovers of freeassignment nets prior to routing. This approach incorporates layer assignment considerations while aiming to minimize total wire length. We introduce a Voronoi Diagram-based iteration algorithm to effectively resolve the topology-compatible allocation problem in the fan-in region. Additionally, we propose a novel Voronoi region merging strategy to adaptively partition the fanout region across multiple chips. A novel model is developed to address the topology-compatible allocation problem, and a final layer assignment is derived using the Longest Common Subsequence (LCS) algorithm. Experimental results demonstrate the high quality and efficiency of our algorithm.},
  keywords={Solid modeling;Three-dimensional displays;System integration;Routing;Prediction algorithms;Partitioning algorithms;Topology;Resource management;Wire;System analysis and design;Free-assignment routing;integrated fan-out (InFO) wafer-level chip-scale package (WLCSP);topology evaluation},
  doi={10.1109/ICICM66614.2025.11316027},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11069603,
  author={Liao, Yu and Li, Sinan and Zhu, Xuyang and Tan, Hao and Wu, Chunjiang},
  booktitle={2025 10th International Conference on Computer and Communication System (ICCCS)}, 
  title={Research and Application on Real Road Network Construction of Micro Traffic Simulation Engine}, 
  year={2025},
  volume={},
  number={},
  pages={1301-1308},
  abstract={In response to the lack of real road network support in the self-developed micro traffic simulation engine, research was conducted on the differences between simulated road networks and OSM (OpenStreetMap) road network data. We create a road network data relationship model and propose a road network construction method based on the road network data relationship model; And we propose a single intersection and its associated sections as the basic units for road network construction, and include the method of constructing unit road intersections and merging roads in the road network construction method. The feasibility of OSM road network in micro traffic simulation was verified through simulation experiments using a micro traffic simulation engine, which improved the authenticity of micro traffic simulation; Comparing the OSM road network with the simulated road network, the advantages of the real road network in describing the geometric state and topological structure of the road network are obtained.},
  keywords={Communication systems;Roads;Computational modeling;Merging;Telecommunication traffic;Traffic control;Data models;Engines;data relational model;road network construction;simulation engine;simulated road network;traffic simulation},
  doi={10.1109/ICCCS65393.2025.11069603},
  ISSN={2995-3251},
  month={April},}@INPROCEEDINGS{10617084,
  author={Edison, D. and Goswami, Sudarshan and Janakiraman, V. and Almusawi, Muntather and Kuppuraj, T. and Ramesh, Azmeera},
  booktitle={2024 4th International Conference on Advance Computing and Innovative Technologies in Engineering (ICACITE)}, 
  title={An Intensive Role of Chatbot Services in the field of Healthcare}, 
  year={2024},
  volume={},
  number={},
  pages={21-26},
  abstract={Machine learning (AI) has gained popularity in the healthcare industry, with a specific emphasis on the usage of AI-based robot systems. These systems become automated talking bots, playing a crucial part in improving health, education spread, and possibly causing behavioral changes. Despite the growing merging of these advances, only a limited study has looked into the acceptance of health robots. This study, combining semi-structured conversations (N-29) and a web-based questionnaire (N-216), aims to explore subjects’ desire to interact with AI-led health apps. The conversations, taped and written exactly, guided the formation of a thorough poll advertised through various online platforms. Analysis of both subjective and numeric data showed a general acceptance among web users toward through health robots. However, reservations surrounding technological advances could impede broad involvement. To handle this, creators of AI-led health apps must take user-centric and theory-based methods. These methods should not only address patients’ worries but also improve user experience and guarantee maximum growth and usage. In the creation and assessment of health robots, knowing patients’ views, goals, and skills is crucial for building successful and widely accepted solutions in the healthcare environment.},
  keywords={Industries;Service robots;Merging;Oral communication;Machine learning;Chatbots;User experience;Chatbot Services;Healthcare;Artificial Intelligence;Machine Learning;Acceptance;Technology Adoption;Health Robots;Patient Engagement;AI Reluctance;User-centred Methods},
  doi={10.1109/ICACITE60783.2024.10617084},
  ISSN={},
  month={May},}@ARTICLE{11168226,
  author={Lamalem, Yasser and Hamida, Soufiane and Housni, Khalid},
  journal={IEEE Access}, 
  title={Efficient Enumeration of d-Minimal Paths Under Capacity Constraints: A Zero-Suppressed Decision Diagram Approach}, 
  year={2025},
  volume={13},
  number={},
  pages={163302-163312},
  abstract={We study the enumeration of all d-minimal paths in a multistate two-terminal network, where each arc has a specific capacity limit. Classical approaches based on generating functions or incremental enumeration tend to suffer from severe combinatorial explosion and require costly post-processing to recover feasible combinations. To address these limitations, we introduce a new construction method using Zero-Suppressed Binary Decision Diagrams (ZDDs) that integrates capacity constraints directly during the decision process. Our approach prunes infeasible branches on the fly and merges identical residual-capacity states to guarantee that each feasible combination is enumerated exactly once, without duplication. We show that the resulting structure is significantly more compact than conventional slot-based Binary Decision Diagrams (BDDs), especially when the feasible solution space is sparse. Experimental comparisons demonstrate that our capacity-aware ZDD achieves orders-of-magnitude improvements in both time and memory efficiency over BDD-based enumeration, even on networks with moderate size and demand values. Beyond performance, our framework provides a canonical and reusable representation of all feasible d-minimal-path combinations, which can be leveraged in reliability analysis, path planning, or network design. These findings support the relevance of ZDD-based models for exact enumeration tasks under resource constraints in real-world infrastructures.},
  keywords={Reliability;Boolean functions;Binary decision diagrams;Costs;Fast Fourier transforms;Directed acyclic graph;Benchmark testing;Vectors;Reliability engineering;Merging;Reliability;d-MPs;zero-suppressed decision diagrams (ZDDs);binary decision diagrams (BDDs);capacity constraints;combinatorial enumeration},
  doi={10.1109/ACCESS.2025.3611227},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10651536,
  author={Su, Shixiang and Du, Songlin and Wang, Dezhou and Tong, Shuzhen and Lu, Xiaobo},
  booktitle={2024 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Single-Domain Generalization Combining Geometric Context Toward Instance Segmentation of Track Components}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={A stable track components segmentation model should have consistent performance across a broad spectrum of railroad conditions, particularly in unfamiliar locations. Despite this, satisfying this requirement proves challenging when working with a limited track dataset, as there is a substantial domain shift between the given dataset and unobserved distributions. The goal of this paper is to improve the generalization ability of track component segmentation in situations where single-domain training data is available. Toward this end, a novel track component instance segmentation method combining the geometric context is proposed. First, we design an initial mask prediction head (IMPH) that utilizes predicted box output from the object detector to generate initial masks by merging the geometric priors of track components. Meanwhile, a multiscale feature fusion structure is introduced to encourage IMPH to better capture the geometric context. Then, a final mask refinement head (FMRH) is introduced to get higher quality masks with a geometry-gated aggregation strategy. On the basis of experiments on track datasets, it was determined that the heads can be incorporated with several types of detection frameworks and have demonstrated consistent generalization enhancements across multiple object detectors. Furthermore, our method substantially enhances segmentation performance on various unobserved domains.},
  keywords={Instance segmentation;Geometry;Accuracy;Neural networks;Merging;Training data;Detectors;Domain generalization;geometric context;instance segmentation;track component},
  doi={10.1109/IJCNN60899.2024.10651536},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{10568898,
  author={Gopalan, Anitha and Chandra, I. and Meeha, D.},
  booktitle={2024 Ninth International Conference on Science Technology Engineering and Mathematics (ICONSTEM)}, 
  title={An Intelligent Underwater Image Color Correction Principles Using Modified Filtration Array With Distinct Pixel Evaluation Strategy}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={Due to a number of circumstances, including absorption, scattering, and the presence of suspended particles, etc., underwater images typically experience quality deterioration and aberrations. In order to tackle these issues, underwater vision tasks use a suite of technologies for improving and restoring underwater images. A variety of techniques, such as filtration, colour modification, combining images, and deep acquiring knowledge, may be utilized to enhance underwater photographs and these techniques are only some of the many options available. Within the scope of this article, we will take a look at various methods for improving images, and we present one called Modified Filtration Array based Pixel Evaluation (MPAPE). To test how well it works, we will use a cross-validation procedure with the traditional Color Correction based Filter Array (CCFA) model. With the enhancements suggested, the algorithm can save more texture information and edge characteristics while still being able to reduce noise. To start, the suggested MPAPE model improves color by adjusting for color shift. Secondly, to address the issue of low contrast, through the use of the adaptive masking factor together with the regional unsharp disguise, we implement to distinguish between the foreground and background. This increases picture contrast while simultaneously improving underwater object and background identification. The objective is to combining the four weights complete the balanced merging of the stochastic pyramidal structure. According to various independent metrics, the method suggested in this paper achieves the best outcomes, and the experimental findings demonstrate that it has strong generalizability and may enhance the clarity of the image in various scenes involving water.},
  keywords={Adaptation models;Image color analysis;Filtration;Merging;Stochastic processes;Scattering;Object recognition;Underwater Image;Color Correction;Modified Filtration Array;Distinct Pixel Evaluation;MPAPE;Filter Array;CCFA},
  doi={10.1109/ICONSTEM60960.2024.10568898},
  ISSN={},
  month={April},}@INPROCEEDINGS{11383753,
  author={Shivanshu and Rai, Saatvik and Kumar, Utkarsh and Raman, Pratyush and Mittal, Mandeep},
  booktitle={2025 Second International Conference on Pioneering Developments in Computer Science & Digital Technologies (IC2SDT)}, 
  title={Bridging Silent Worlds: Advanced Computer Vision Approaches to Indian Sign Language Recognition}, 
  year={2025},
  volume={},
  number={},
  pages={154-159},
  abstract={Those with hearing or speech impairments have a hard time communicating in their learning, professional,and social environments because of the lack of public awareness of Indian Sign Language (ISL). Presently sign language interpretation technologies have limitations due to their inaccuracies and small datasets making them less viable. We have created an elaborate gesture recognition system of the ISL that is a two way converter of gestures to text, emotionally identifying the input for the context. Our method involves a tailor made dataset of 2000 images merged with the Sign Language MNIST dataset from Kaggle (34,627 images) and ISL CSLTR dataset (video frames) to increase the model's stability. By employing YOLOv5 and YOLOv8 structures with transfer learning,we have raised the accuracy to 92%,precision to 95% and recall to 97% on the extended dataset,which is a considerable enhancement of the performance of the baseline models trained only on the custom data.},
  keywords={YOLO;Sign language;Computer vision;Accuracy;Computational modeling;Merging;Data models;Stability analysis;Videos;Testing;Sign Language Recognition (SLR);ISL;YOLO Algorithm;Computer Vision;Machine Learning},
  doi={10.1109/IC2SDT68218.2025.11383753},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10361412,
  author={Chen, Shi and Li, Qianmu and Wang, Qi and Zhao, Xinjian and Ge, Hao and Li, Nianzhe},
  booktitle={2023 IEEE Intl Conf on Dependable, Autonomic and Secure Computing, Intl Conf on Pervasive Intelligence and Computing, Intl Conf on Cloud and Big Data Computing, Intl Conf on Cyber Science and Technology Congress (DASC/PiCom/CBDCom/CyberSciTech)}, 
  title={A Multi-Channel Composite Recommendation Method in Federated Learning}, 
  year={2023},
  volume={},
  number={},
  pages={0698-0705},
  abstract={There are various data security risks in power grid systems, and recommendation systems are a good solution to the selection of security strategies. Federated learning is a machine learning framework that can protect the data privacy of each participant and can effectively solve the data security external collaborative training modeling challenges. This paper proposed a flexible implantable recommendation algorithm based on knowledge graph and multi-channel composite to enhance federated learning on demand. The algorithm designs three different feature extraction modules to learn to construct multi-dimensional features on multi-attribute collaborative knowledge graphs. Among them, the distance translation module utilizes the Trans R recommendation algorithm to learn the internal semantic structure information in knowledge graph triples and terminal-security policy selection history; the random walk module uses the Node2Vec algorithm to learn the homogeneous and Structured information in the multi-attribute collaborative knowledge graph; the graph convolutional network module learns the high-order neighborhood multi-attribute collaborative information of terminal/security policy nodes through multi-layer feature propagation and aggregation. The composite network module adopts a convolutional neural network-like operation to first locally optimize the three modules, and then extracts the highly informative elements to obtain the final feature representation of the terminal/security policy. Finally, the algorithm merges the vectors of terminal-security policy pairs into the multi-layer perceptron to learn and calculate the prediction score for recommendation.},
  keywords={Training;Machine learning algorithms;Federated learning;Data security;Semantics;Collaboration;Knowledge graphs;Recommender System;Compound Channel;Distance Translatio;Graph Random Walk;Graph Convolutional Network},
  doi={10.1109/DASC/PiCom/CBDCom/Cy59711.2023.10361412},
  ISSN={2837-0740},
  month={Nov},}@INPROCEEDINGS{11471492,
  author={ElSayed, Zag and Erickson, Craig and Pedapati, Ernest},
  booktitle={2025 International Conference on Machine Learning and Applications (ICMLA)}, 
  title={MCP-AI: Protocol-Driven Intelligence Framework for Autonomous Reasoning in Healthcare}, 
  year={2025},
  volume={},
  number={},
  pages={1446-1451},
  abstract={Healthcare AI systems have historically faced challenges in merging contextual reasoning, long-term state management, and human-verifiable workflows into a cohesive framework. This paper introduces a completely innovative architecture and concept: combining the Model Context Protocol (MCP) with a specific clinical application, known as MCP-AI. This integration allows intelligent agents to reason over extended periods, collaborate securely, and adhere to authentic clinical logic, representing a significant shift away from traditional Clinical Decision Support Systems (CDSS) and prompt-based Large Language Models (LLMs). As healthcare systems become more complex, the need for autonomous, context-aware clinical reasoning frameworks has become urgent. We present MCP-AI, a novel architecture for explainable medical decision-making built upon the Model Context Protocol (MCP) a modular, executable specification for orchestrating generative and descriptive AI agents in real-time workflows. Each MCP file captures clinical objectives, patient context, reasoning state, and task logic, forming a reusable and auditable memory object. Unlike conventional CDSS or stateless prompt-based AI systems, MCP-AI supports adaptive, longitudinal, and collaborative reasoning across care settings. MCP-AI is validated through two use cases: (1) diagnostic modeling of Fragile X Syndrome with comorbid depression, and (2) remote coordination for Type 2 Diabetes and hypertension. In either scenario, the protocol facilitates physician-in-the-loop validation, streamlines clinical processes, and guarantees secure transitions of AI responsibilities between healthcare providers. The system connects with HL7/FHIR interfaces and adheres to regulatory standards, such as HIPAA and FDA SaMD guidelines. MCP-AI provides a scalable basis for interpretable, composable, and safety-oriented AI within upcoming clinical environments.},
  keywords={Circuits;Feedback;Protocols;HTTP;Semantic Web;Internet;Biomedical communication;Communication systems;Microservice architectures;Smart contracts;MCP;Clinical AI;Generative AI;Descriptive AI;Decision Support Systems;Healthcare;Informatics;Model Context Protocol;Autonomous Reasoning},
  doi={10.1109/ICMLA66185.2025.00220},
  ISSN={1946-0759},
  month={Dec},}@INPROCEEDINGS{11311258,
  author={Galanis, Charalampos and Tsipianitis, Dimitris and Michou, Emilia},
  booktitle={2025 16th International Conference on Information, Intelligence, Systems & Applications (IISA)}, 
  title={A Cost-Effective, Portable, and Non-Invasive Dual-Axis Swallowing Accelerometry System for Dysphagia Assessment}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This work presents the development of a portable, cost-effective system for dual-axis swallowing accelerometry, designed to support non-invasive dysphagia assessment. The proposed platform is based on the Arduino Nano RP2040 Connect, which integrates the LSM6DSOX inertial sensor for capturing anterior-posterior ($A-P$) and superior-inferior ($S-I$) laryngeal vibrations. Raw accelerometry signals are wirelessly transmitted and processed offline through a digital pipeline incorporating bandpass filtering, spline-based detending, and wavelet-based denoising. Swallowing events are automatically segmented using a percentile-based thresholding method applied to the variance of both axes, combined with envelope-based trimming and post-segmentation merging. Experimental sessions were conducted under structured conditions with dry swallows of varying effort. Statistical features—including amplitude, symmetry, and energy-based descriptors—were extracted from each detected segment and analyzed to evaluate the internal consistency and physiological plausibility of the results. The goal of the system is not real-time classification, but rather the generation of clear, temporally accurate swallowing representations suitable for clinical interpretation by speech-language pathologists. Although clinical validation with gold-standard techniques such as FEES is pending, the presented results demonstrate the feasibility of a fully digital, embedded-friendly solution for swallowing monitoring. The system lays the groundwork for future multimodal extensions incorporating surface electromyography (sEMG) or audio sensing.},
  keywords={Vibrations;Pipelines;Noise reduction;Merging;Signal processing;Feature extraction;Real-time systems;Splines (mathematics);Surface treatment;Monitoring;swallowing accelerometry;dysphagia assessment;signal processing;segmentation},
  doi={10.1109/IISA66859.2025.11311258},
  ISSN={},
  month={July},}@INPROCEEDINGS{11231278,
  author={van Kempen, Philipp and Hager-Clukas, Andreas and Mueller-Gritschneder, Daniel and Schlichtmann, Ulf},
  booktitle={2025 IEEE Nordic Circuits and Systems Conference (NorCAS)}, 
  title={GenIE: Reuse-Oriented Generation of Domain-Specific Instruction Extensions}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Custom instruction set extensions (ISEs) can boost efficiency in embedded systems but are often narrowly tailored to specific workloads. We propose GenIE (Generation of Instruction Extensions), a fully automated framework for generating, selecting, and reusing microarchitecture-aware ISEs. By introducing a specialization graph, GenIE structures the candidate space for efficient filtering, merging, and reuse across applications. Our end-to-end RISC-V flow integrates profiling, candidate extraction, and retargeting. Experiments on CVA5 with Embench-IoT benchmarks show runtime reductions of up to 42.9 % (avg. 14.3%), while preserving low hardware and encoding overhead. GenIE enables compact, reusable ISEs with strong cross-workload generalization.},
  keywords={Runtime;Microarchitecture;Embedded systems;Filtering;Instruction sets;Merging;Encoding;Hardware;Table lookup;Software development management;ASIP;Custom Instruction Synthesis;RISC-V.},
  doi={10.1109/NorCAS66540.2025.11231278},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11143368,
  author={Tang, Zhiyun and Li, Yahui and Ruan, Ke and Zhu, Yongqing and Ye, Yingjun and Wang, Jilong and Yin, Xia and Shi, Xingang and Zhang, Han},
  booktitle={2025 IEEE/ACM 33rd International Symposium on Quality of Service (IWQoS)}, 
  title={Probabilistic Analysis of Overload-Free Property for Critical Traffic}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Network structures are sophisticated and hence vulnerable to errors. Link failures and traffic load fluctuations lead to complexity in network states. Different failure scenarios can result in varying network traffic distribution patterns. Meanwhile, the load on links within the same failure scenario dynamically changes with fluctuations in traffic. Network administrators are particularly concerned about whether links along the paths traversed by critical traffic are overload-free guaranteed when link failures occur. Yet, no attention was ever paid to overload-free property analysis for critical traffic. We propose Offaela, an efficient and accurate probabilistic analysis framework that verifies an overload-free property for critical traffic. We prudently formulate the problem and prove its computational hardness, then storm this fortification by proffering a failure scenario merging algorithm and adopting a randomized approximation method. Evaluations on real networks show that Offaela outperforms the state-of-the-art solution by 4.83 x and can provide availability analysis assistance such as identifying vulnerable failure scenarios.},
  keywords={Fluctuations;Accuracy;Storms;Merging;Telecommunication traffic;Quality of service;Probabilistic logic;Approximation algorithms;Telecommunications;Approximation methods},
  doi={10.1109/IWQoS65803.2025.11143368},
  ISSN={2766-8568},
  month={July},}@INPROCEEDINGS{10617123,
  author={Shalini, M and Sharma, Rupesh and Bhuvaneswari, M. and Badhoutiya, Arti and Mohan, M Madan and Rao, S P V Subba},
  booktitle={2024 4th International Conference on Advance Computing and Innovative Technologies in Engineering (ICACITE)}, 
  title={A Detailed Review on Challenges in the Computational Frameworks in Building 6G for Healthcare System}, 
  year={2024},
  volume={},
  number={},
  pages={286-291},
  abstract={In the modern age of Sixth-generation (6G) connections, the merging of the Intellect Internet of Issues (IIoT) plays a crucial part in improving storage and processing of data powers. The core goal of 6 G is to provide extremely small delay, high speed, and improved quality of service so as to enable smooth contact among network points. Within the medical industry, it is important to fit all facilities at state-ofthe-art technology to allow clever diagnoses, patient-centric therapies, and a range of healthcare services, outside the confines of a medical facility and online. To ensure the health care sector’s readiness and flexibility to cutting-edge technology, giving varied uses from robotic treatments to remote patient tracking via portable technologies in Active Adaptive Living (AAL) environments is important. The intelligent connecting platform serves as the backbone, managing various networking hubs and input devices to offer time-sensitive healthcare services. This paper presents a new reference layered communication system designed for realtime conversation among nodes and devices. By studying the future aspects of the 6 G system, the paper shows its potential uses in healthcare, hoping to improve treatment effectiveness and smartly combine services. The suggested structure attempts to build a strong basis for the changing world of healthcare apps in the framework of 6 G technology.},
  keywords={6G mobile communication;Industries;Technological innovation;Wireless networks;Merging;Virtual environments;Medical services;6G;healthcare;AI-driven network;real-time communication;robotic surgery;remote patient tracking;Active Adaptive Living (AAL);intelligent connecting platform;layered communication system;wireless communication},
  doi={10.1109/ICACITE60783.2024.10617123},
  ISSN={},
  month={May},}@INPROCEEDINGS{11082238,
  author={Wang, Hongyuan},
  booktitle={2025 IEEE 34th Wireless and Optical Communications Conference (WOCC)}, 
  title={Green Transformation and New Quality Productivity: A Triple Difference Approach with Double Machine Learning}, 
  year={2025},
  volume={},
  number={},
  pages={149-154},
  abstract={This paper proposes an integrated causal inference framework combining triple difference (DDD) and double machine learning (DML) to evaluate the impact of green technological innovation on new quality productivity growth. Grounded in Porter's hypothesis and technological innovation theory, the study addresses key challenges in environmental policy evaluation by merging quasi-experimental designs with machine learning techniques. The methodology employs propensity score matching to construct comparable treatment and control groups, followed by DDD estimation to identify causal effects across multiple dimensions, while leveraging DML to control for high-dimensional co-founders and uncover heterogeneous treatment effects. Focusing on China's manufacturing sector, the analysis demonstrates that green technology adoption significantly enhances productivity, with substantial variation across firm ownership structures and regional characteristics. The methodological contribution lies in demonstrating how machine learning augments traditional difference-in-differences approaches through improved covariate balancing, detection of nonlinear treatment effects, and refined subgroup analysis. The findings offer theoretical insights into the mechanisms of green productivity growth and provide empirical evidence for policymakers to design targeted environmental innovation strategies.},
  keywords={Productivity;Wireless communication;Technological innovation;Green products;Merging;Estimation;Machine learning;Solids;Optical fiber communication;Sustainable development;Triple difference model;machine learning;Green transformation},
  doi={10.1109/WOCC63563.2025.11082238},
  ISSN={2379-1276},
  month={May},}@ARTICLE{10935320,
  author={Dong, Yinglei and Yuan, Jia and Qiao, Shushan and Zhao, Ye},
  journal={IEEE Access}, 
  title={An Ultra-Low-Power Fully-Static Contention-Free Single-Phase-Clock Flip-Flop With Low Area}, 
  year={2025},
  volume={13},
  number={},
  pages={64719-64726},
  abstract={This paper introduces a Fully-Static, Contention-Free Single-Phase-Clock Flip-Flop for IoT devices. The design objectives are accomplished through three main components. Firstly, the elimination of invalid toggling of internal nodes significantly reduces power consumption. Secondly, a Fully-Static and a Contention-Free structure are achieved by eliminating floating nodes and contention paths, respectively, enhancing robustness. Lastly, area is reduced through logic merging and topology compression. This Flip-Flop is implemented in a 28nm process. Post-simulation results indicate that, at 0.9V, 1GHz and activity rate of 10%/20%, dynamic power of this design is only  $0.44~\mu $  W/ $0.88~\mu $  W, resulting in 86.95%/76.44% power reduction compared to traditional MSFF. This design focuses on static power. Static power of this design achieves 0.07nW/0.77nW at 10MHz, 0%, 0.4V/0.9V, 98.91%/97.59% less than MSFF. 10K Monte Carlo simulation confirms that this design maintains 100% functional integrity within the voltage range of 0.4-0.9V. Layout results indicate this design achieves an extremely low area.},
  keywords={Robustness;Transistors;Clocks;Power demand;Internet of Things;Circuits;Layout;Flip-flops;Topology;Merging;Flip-flop (FF);low power;near-threshold voltage (NTV);fully-static;contention-free;single-phase-clock (SPC)},
  doi={10.1109/ACCESS.2025.3553240},
  ISSN={2169-3536},
  month={},}@ARTICLE{11395311,
  author={Chen, Pinzhi and Li, Xinyu and Zhou, Peizhao and Han, Ye and Guo, Xiaojie and Li, Tong and Liu, Xiaotao and Liu, Zheli},
  journal={IEEE Transactions on Dependable and Secure Computing}, 
  title={SecureCA: Communication- and Round-Efficient Join and Group-By-Aggregation in Secure Database Services}, 
  year={2026},
  volume={23},
  number={3},
  pages={6378-6395},
  abstract={Today, secure collaborative analytics has been a basic functionality of private and distributed database services. Efficiently handling multi-table SQL queries, whose underlying pivotal operators are join and group-by-aggregation, creates particular challenges for building a large-scale service in a practical way. However, previous works fail to implement operators with low communications, as they rely on costly oblivious operators such as sorting and merging. In this work, we propose SecureCA, a series of communication-efficient protocols for unique-key join and group-by-aggregation. Our protocols support semi-honest three-party join queries, as well as common aggregation methods such as Sum, Avg, and Max/Min. In these protocols, we make a trade-off between efficiency and security and design a novel server-aided architecture that breaks the symmetric structure among computation nodes, transforming high-cost multi-party oblivious operators and correlated randomness generation into local computations while also eliminating redundant sorting for join and group-by operations. Compared to state-of-the-art works, when scaled to millions of records, our protocols perform closed-source work, $\text{AHK}^{+}$AHK+, by $3 \sim 16 \times$3∼16× under a wide-area network, and existing open-source work, Secrecy, by $9 \sim 364 \times$9∼364×.},
  keywords={Protocols;Sorting;Complexity theory;Cryptography;Vectors;Servers;Collaboration;Payloads;Outsourcing;Merging;Secure collaborative analytics;join;group-by-aggregation;secret sharing},
  doi={10.1109/TDSC.2026.3655006},
  ISSN={1941-0018},
  month={May},}@INPROCEEDINGS{11226274,
  author={Garcia-Cardona, Johanna and Arias, Kevin and Ortega, Antonio and Arguello, Henry},
  booktitle={2025 33rd European Signal Processing Conference (EUSIPCO)}, 
  title={Graph-Based Image Fusion: Enhancing Multi-Modal Remote Sensing Data with GCNs}, 
  year={2025},
  volume={},
  number={},
  pages={2182-2186},
  abstract={Multi-modal satellite data fusion is a key challenge in remote sensing, requiring the integration of data with differing spatial and temporal resolutions. Fusion methods must enhance image resolution while preserving the physical integrity of the underlying phenomena. Traditional fusion techniques, such as interpolation and statistical downscaling, often disrupt spatial consistency and introduce artifacts that distort physical representations. Graph-based methods offer a robust alternative by modeling diverse data sources into node-based signals and edge connections based on ancillary data. This work proposes a novel Graph Convolutional Network (GCN) framework for satellite image fusion, leveraging ancillary variables such as terrain elevation and vegetation indices to enhance spatially consistent data integration. A key advantage of this GCN approach is its ability to learn transferable edge relationships, enabling adaptation to new regions using ancillary data without retraining. Experimental results demonstrate that our GCN framework effectively captures spatial dependencies within the graph embedding while merging heterogeneous data sources, leading to improved image resolution and enhanced feature representation.},
  keywords={Satellites;Graph convolutional networks;Soft sensors;Image edge detection;Data integration;Vegetation mapping;Spatial databases;Spatial resolution;Remote sensing;Signal resolution;Data Fusion;Graph Signal Processing (GSP);Graph Convolutional Networks (GCNs);Remote Sensing},
  doi={10.23919/EUSIPCO63237.2025.11226274},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11453362,
  author={Mirza, Qurat ul Ain Zam Zam and Kanwal, Rimsha and Ashraf, Humaira and Jhanjhi, NZ. and Saepudin, Sudin},
  booktitle={2025 15th International Conference on Mathematics, Actuarial Science, Computer Science and Statistics (MACS)}, 
  title={A Quantitative Study on Social Media Use and Academic Performance}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The fast rate of social media adoption by university students has raised concern over its possible effects on the performance of learning. This is a research that explores the correlation between the time spent on social media, efficiency in learning, and the quality of sleep in a quantitative, data-based study. An online questionnaire in a structured form was issued to 35 students, and 34 valid answers were obtained representing different academic fields. Python-based data processing and Pearson correlation analysis gave the results which indicated three significant patterns: (1) the time of using social media was significantly and negatively related to the learning efficiency (r = −0.72, p¡ 0.01); (2) the more the exposure to social media on a daily basis, the lower was the productivity of the study (r = −0.68, p¡ 0.01); and (3) the higher the quality of sleep, the higher was the learning efficiency ($\mathrm{r}=+0.74$, p¡ 0.0 These results affirm the hypothesis that the long-term use of social media enhances cognitive load and attention discontinuity, and poor sleep quality lowers academic concentration and memory. The research study empirically supports the Cognitive Load Theory and states that sleep quality is a mediating factor between digital behavior and learning outcomes. Some of the recommendations comprise of not spending more than four hours a day on social media and not using a device within a year before sleep. The findings can add to the digital learning literature by merging behavioral, psychological, and physiological aspects of digital learning into a data science plan.},
  keywords={Productivity;Performance evaluation;Correlation;Social networking (online);Statistical analysis;Merging;Psychology;Predictive models;Cognitive load;Physiology;Social media;learning efficiency;cognitive load;sleep quality;Pearson correlation;digital distraction;academic performance},
  doi={10.1109/MACS68476.2025.11453362},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11364682,
  author={Kabbaj, Omar Abdelaaziz and Péan, Louis-Marie and Masson, Jean-Baptiste and Marhic, Bruno and Delahoche, Laurent},
  booktitle={2025 IEEE 22nd International Conference on Sciences and Techniques of Automatic Control and Computer Engineering (STA)}, 
  title={Adaptive Constrained-Hidden Markov Model (C-HMM) for Multi-Room Occupancy Prediction}, 
  year={2025},
  volume={},
  number={},
  pages={371-376},
  abstract={Accurate occupancy forecasting in buildings is the main solution for optimizing energy consumption and improving indoor comfort. This paper presents an approach for multi-room occupancy prediction using a Hidden Markov Model (HMM) under emission constraints, designed to capture both discrete spatial transitions between rooms and continuous temporal dynamics through the von Mises distribution. Unlike conventional HMMs, the proposed model enforces structured emission probabilities that remain invariant during training, ensuring interpretability and stability. Furthermore, an adaptive structural optimization algorithm is introduced to automatically determine the optimal number of hidden states, that model a specific observation by iteratively merging states based on temporal similarity and concentration criteria. Tests conducted on two simulated multi-room datasets demonstrate that this adaptive HMM achieves higher accuracy compared to fixed-state configurations.},
  keywords={Training;Adaptation models;Analytical models;Accuracy;Computational modeling;Merging;Hidden Markov models;Predictive models;Data models;Optimization;Hidden Markov Model (HMM);occupancy prediction;von Mises distribution;circular data;temporal modeling},
  doi={10.1109/STA66620.2025.11364682},
  ISSN={2573-539X},
  month={Dec},}@ARTICLE{11523479,
  author={Xu, Lingwei and Shen, Xiao and Tian, Chenglong and Shen, Yuan},
  journal={IEEE Journal of Selected Topics in Signal Processing}, 
  title={Distributed Multi-Agent Relative Localization via Reference Frame Coordination}, 
  year={2026},
  volume={},
  number={},
  pages={1-14},
  abstract={Accurate and robust relative position information is fundamental for enabling self-organized cooperation in multi-agent systems, particularly for unmanned aerial vehicle (UAV) swarms in the emerging low-altitude economy. However, achieving high-performance relative localization remains challenging, primarily due to the critical issues of reference frame coordination which establishes and maintains a reference frame consensus across the network. In this paper, we establish an optimization framework that bridges performance bounds and algorithm designs, enabling the derivation of optimization structures for centralized relative localization, which facilitates an alternating direction optimization algorithm for subnetwork-oriented scenarios. We then propose a distributed relative localization scheme that integrates an orientation-aware and dynamics-aware state merging mechanism for coordination across different inertial reference frames. Furthermore, we develop a spatial-temporal cooperation approach through real-time adaptive frame alignment and multi-source information fusion, effectively suppressing error accumulation. Simulation and real-world experiments demonstrate that the proposed algorithms achieve superior accuracy and robustness, providing an effective solution for relative localization and enabling key applications in the low-altitude economy.},
  keywords={Location awareness;Measurement;Optimization;Algorithms;Distance measurement;Merging;Matrices;Modeling;Timing;Vectors;Multi-agent systems;relative localization;distributed network;reference frame coordination},
  doi={10.1109/JSTSP.2026.3694573},
  ISSN={1941-0484},
  month={},}@INPROCEEDINGS{9824715,
  author={Qi, Shanshan and Yang, Luxi and Li, Chunguo and Huang, Yongming},
  booktitle={2022 11th International Conference on Communications, Circuits and Systems (ICCCAS)}, 
  title={Dual Relation-Aware Synergistic Attention Network for Image-Text Matching}, 
  year={2022},
  volume={},
  number={},
  pages={251-256},
  abstract={The image and text matching task plays an essential role in bringing the semantic gulf between language and vision. It still remains challenging since previous methods lack a detailed comprehension of the contextual interplays reflected in diverse visual relationships between objects. In this work, we present one novel dual relation-aware synergistic attention (DRSA) network to produce visual representations that incorporate crucial semantic concepts and salient objects of image scenes. First, we construct each image as two subgraphs and perform the multi-type inter-object interactions utilizing the sentence-guided graph attention mechanism. Specially, two types of visual relations are exploited: Implicit Relations extracting the latent dynamics between objects and Explicit Relations capturing the semantic dependencies and relative geometric positions. Second, a synergistic fusion module is designed to adaptively merge the implicit, explicit, and all-mixed relation features based on the sentence contexts, which works like multi-head attention. Third, adversarial learning is conducted to reinforce the interaction of implicit and explicit relation encoding modules to explore more effective multi-view associations between images and sentences. Experiments show that DRSA outperforms existing state-of-the-art approaches on two widely used datasets (i.e., MSCOCO, Flickr30K), proving the efficacy of our proposed elaborate matching technique.},
  keywords={Visualization;Image coding;Circuits and systems;Semantics;Feature extraction;Adversarial machine learning;Task analysis;visual relationships;synergistic fusion;multi-view associations;adversarial learning},
  doi={10.1109/ICCCAS55266.2022.9824715},
  ISSN={},
  month={May},}@ARTICLE{9393912,
  author={Sadawi, Alia Al and Hassan, Mohamed S. and Ndiaye, Malick},
  journal={IEEE Access}, 
  title={A Survey on the Integration of Blockchain With IoT to Enhance Performance and Eliminate Challenges}, 
  year={2021},
  volume={9},
  number={},
  pages={54478-54497},
  abstract={Internet of things IoT is playing a remarkable role in the advancement of many fields such as healthcare, smart grids, supply chain management, etc. It also eases people's daily lives and enhances their interaction with each other as well as with their surroundings and the environment in a broader scope. IoT performs this role utilizing devices and sensors of different shapes and sizes ranging from small embedded sensors and wearable devices all the way to automated systems. However, IoT networks are growing in size, complexity, and number of connected devices. As a result, many challenges and problems arise such as security, authenticity, reliability, and scalability. Based on that and taking into account the anticipated evolution of the IoT, it is extremely vital not only to maintain but to increase confidence in and reliance on IoT systems by tackling the aforementioned issues. The emergence of blockchain opened the door to solve some challenges related to IoT networks. Blockchain characteristics such as security, transparency, reliability, and traceability make it the perfect candidate to improve IoT systems, solve their problems, and support their future expansion. This paper demonstrates the major challenges facing IoT systems and blockchain's proposed role in solving them. It also evaluates the position of current researches in the field of merging blockchain with IoT networks and the latest implementation stages. Additionally, it discusses the issues related to the IoT-blockchain integration itself. Finally, this research proposes an architectural design to integrate IoT with blockchain in two layers using dew and cloudlet computing. Our aim is to benefit from blockchain features and services to guarantee a decentralized data storage and processing and address security and anonymity challenges and achieve transparency and efficient authentication service.},
  keywords={Internet of Things;Blockchain;Security;Sensors;Reliability;Performance evaluation;Wireless sensor networks;Blockchain;IoT;smart contract;trust;IoT challenges;IoT security;decentralized IoT;cloudlet computing;dew computing;cloudlet-dew architecture},
  doi={10.1109/ACCESS.2021.3070555},
  ISSN={2169-3536},
  month={},}@ARTICLE{10323331,
  author={Chacko, Namrata Marium and Narendra, V. G. and Balachandra, Mamatha and Rathinam, Suryaansh},
  journal={IEEE Access}, 
  title={Exploring IoT-Blockchain Integration in Agriculture: An Experimental Study}, 
  year={2023},
  volume={11},
  number={},
  pages={130439-130450},
  abstract={The incorporation of Internet of Things (IoT) technology with agriculture has transformed several farming practices, bringing unparalleled simplicity and efficiency. This article explores the robust integration of IoT and blockchain technology(BIoT) in agricultural operations, offering insight into the resulting BIoT system’s design. This study investigates the potential benefits of merging the IoT and blockchain technologies in agriculture. A system for tracking plant growth using sensors and blockchain-integrated IoT has been developed and analyzed. Through empirical investigation, the report highlights greater efficiency, transparency, and security as significant benefits of BIoT architecture. A cost analysis is also conducted, showing that the system is cost-effective. The paper also proposes a mathematical formula for the calculation of infrastructure cost. It also looks at the problems of integrating BIoT in agricultural contexts, such as technological complications and the need for stakeholder participation. The findings indicate that the IoT can potentially revolutionize agricultural practices drastically, but its practical implementation would need careful consideration of technological, economic, and societal considerations. Empirical analysis is conducted to analyze the latency, throughput, and transaction scalability. The paper concludes with research suggestions, emphasizing the significance of interdisciplinary collaboration and the consequences of BIoT deployment in agriculture.},
  keywords={Blockchains;Internet of Things;Computer architecture;Sensors;Security;Peer-to-peer computing;Crops;Cost benefit analysis;Smart agriculture;Blockchain;Internet of Things;cost analysis},
  doi={10.1109/ACCESS.2023.3334726},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{8893316,
  author={Frattini, Flavio and Giordano, Ugo and Conti, Vincenzo},
  booktitle={2019 15th European Dependable Computing Conference (EDCC)}, 
  title={Facing Cyber-Physical Security Threats by PSIM-SIEM Integration}, 
  year={2019},
  volume={},
  number={},
  pages={83-88},
  abstract={Physical Protection Systems are Physical Systems that evolved towards the cyber world. Sensors, cameras, barriers and control panels are now networked, making up a monitoring system subject to cyber attacks. Physical Security Information Management (PSIM) software systems are used for managing physical security information; Security Information and Event Management (SIEM) systems are used for cyber security information and events. Considering cyber-physical risks, they can not remain separated. In this paper, we describe our experience in merging PCMS, a PSIM system widely used by Banks in Italy, with QRadar, the well known IBM SIEM. Their integration helps physical security personnel in figuring out hidden threats, as well as the cyber security team for understanding risks related to the Physical Protection System.},
  keywords={Security;Videos;Monitoring;Cameras;Servers;Phase change materials;Connectors;Cyber Physical Systems;Physical Protection Systems;Security;Monitoring},
  doi={10.1109/EDCC.2019.00026},
  ISSN={2641-810X},
  month={Sep.},}@INPROCEEDINGS{9922029,
  author={Niing, Zheng and Ou, Dongxiu and Zhang, Lei},
  booktitle={2022 IEEE 25th International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={Virtual Coupling Formation Scheduling Method for Y -type Rail Transit Lines}, 
  year={2022},
  volume={},
  number={},
  pages={3673-3678},
  abstract={The train Virtual Coupling technology is considered an effective system to increase the rail transit benefits. Most relevant studies focus on the control method based on a definitive coupling structure. In practice, different coupling structures will lead to various effectiveness under distinct scenarios. It may be more efficient in the scene of Y-type lines with branches and trunk bottleneck section. This study analyzed the harmony between the rail transit periodic operation characteristics or system constraints and Virtual Coupling technology. It proposed a cooperative speed and distance adjustment strategy that satisfying the virtual coupling condition. A mixed integer programming model is established to calculate the train formation structure and the corresponding scheduled time, based on the coordination process of the train coupling state. The simulation results show that the proposed method can select the proper scheduled time within the time window to form a reasonable coupling platoon according to different transportation requirements, and the system capacity can be improved by compressing the train density in a certain extent.},
  keywords={Couplings;Rails;Integer programming;Technological innovation;System performance;Simulation;Merging},
  doi={10.1109/ITSC55140.2022.9922029},
  ISSN={},
  month={Oct},}@ARTICLE{10704624,
  author={Liu, Jinsha and Li, Boning and Yamazaki, Takaharu and Cao, Jianting},
  journal={IEEE Access}, 
  title={Developing an SSVEP-Based BCI System for Multi-Objective Control via IoT Integration}, 
  year={2024},
  volume={12},
  number={},
  pages={186586-186596},
  abstract={This paper explores the integration of Electroencephalography (EEG) with Brain-Computer Interface (BCI) technologies, highlighting the application in facilitating communication and control for individuals with severe motor disabilities. We focus on the capabilities of EEG to decode brain signals using modalities such as SSVEP, which is enhanced through Canonical Correlation Analysis (CCA) algorithm to improve classification accuracy. Additionally, we discuss the merging of these technologies with the Internet of Things (IoT) to extend BCI applications into daily activities through multi-device control system. Traditional BCI systems are typically designed for fixed, single-task scenarios, and often do not account for the complexities of multi-objective, cross-device tasks encountered in real-world environments. By integrating BCI technology with IoT, we address the limitations of single-task scenarios, enabling the use of independent BCI systems to perform tasks such as making phone dialing, moving wheelchairs, controlling robots, and transporting objects across different devices. This advancement provides effective support for the deployment of BCI technology in real-world applications. Our study demonstrates the implementation of a robust SSVEP-based BCI system that achieves a 97.0% classification accuracy across 500 trials, proving its efficacy in real-world scenarios. This research addresses the challenges of adapting BCI system to complex, varied environments and provides a viable solution for improving the quality of life for those with severe motor disabilities.},
  keywords={Electroencephalography;Visualization;Correlation;Control systems;Motors;Frequency control;Machine learning;Accuracy;Training;Resonant frequency;Brain-computer interfaces;BCI;IoT;EEG;machine learning;SSVEP},
  doi={10.1109/ACCESS.2024.3472909},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9669342,
  author={Chen, Yaoran and Zhu, Yuanyuan and Zhong, Ming and Liu, Juan},
  booktitle={2021 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={COMNA: Core-attachment based protein complex detection via multiple network alignment}, 
  year={2021},
  volume={},
  number={},
  pages={241-244},
  abstract={Protein complexes are important functional units for performing biological functions and revealing cellular organization principles, and its detection is a fundamental problem in computational biology. In this paper, we present a novel algorithm COMNA by using orthology relationship across different species to complement the complex detection of a single protein-protein interaction (PPI) network, which can identify protein complexes from multiple PPI networks simultaneously. First, we propose a novel measure, high-order edge closure coefficient, to assess the reliability of interactions and then identify core-attachment based complexes from each PPI network. Second, we cooperate with the orthology information from multiple PPI network alignment to mine more complementary complexes. Finally, we merge the highly overlapping complexes by constructing an overlapping graph. We compare COMNA with eight state-of-the-art protein complex identification algorithms on three datasets, and the experimental results show that COMNA can detect complexes from PPI networks with higher accuracy.},
  keywords={Proteins;Protein engineering;Image edge detection;Conferences;Organizations;Biomedical measurement;Biology;PPI network;protein complexes;core-attachment structure;multiple network alignment},
  doi={10.1109/BIBM52615.2021.9669342},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10421466,
  author={Chaturvedi, Abhay and Vimal, Vrince and Rana, Samir and Pande, Rajesh and Maaliw III, Renato R. and Gupta, Abhijit},
  booktitle={2023 International Conference on Communication, Security and Artificial Intelligence (ICCSAI)}, 
  title={Green IoT for Eco-Friendly and Sustainable Smart Cities: Computer Integration in sustainability}, 
  year={2023},
  volume={},
  number={},
  pages={658-663},
  abstract={The evolution of the Internet of Things this technology and its integration into smart cities has changed every people's life and their working system. IoT technologies face several kinds of challenges or issues, such as power consumption boosting, and creating various pollutions which are toxic, as well as this IoT produces many kinds of E-waste which is harmful to the smart cities. Environmentally friendly the smart city applications must be demanded to move to a green IoT, this friendly environment leads by the Green IoT which is sustainable for the smart cities. Therefore, it is very introductory to facilitate pollution, traffic waste, consumption of energy, the safety provided to the public, hazards, usage of resources, life quality, environment sustaining, and management of the cost to address those techniques and strategies. Those kinds of surveys help to focus on providing exhaustive reviews of the advanced techniques and also strategies because the Green IoT wants to make the city into a smarter city, eco-friendly, and sustainable for the city people. Furthermore, to address the requirements of the smart cities that merge into the IoT and its capabilities with the probable characteristics and that is the main focus of this survey. IoT wants to be added everything that needs to build a smarter city that could be connected at any time or anywhere by using any medium. Finally, in this research study, the researchers discuss the challenges and also look at the opportunities for their future help to build a smart city by taking the help of Green IoT.},
  keywords={Surveys;Pollution;Smart cities;Green products;Electronic waste;Internet of Things;Sustainable development;Smart City;Technology;Energy;Iot;Network;Environment;Harmful},
  doi={10.1109/ICCSAI59793.2023.10421466},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9884897,
  author={Li, Yuhui and Yu, Xindi and Pei, Jifang and Huo, Weibo and Zhang, Yin and Huang, Yulin and Yang, Jianyu},
  booktitle={IGARSS 2022 - 2022 IEEE International Geoscience and Remote Sensing Symposium}, 
  title={A Learning-Based Multi-Type Noise Suppressing Method for Remote Sensing Images}, 
  year={2022},
  volume={},
  number={},
  pages={3299-3302},
  abstract={Remote sensing images (RSIs) play an important role in a wide range of applications. However, they are frequently contaminated by multiple kinds of noises and existing methods are mostly applied to suppressing single noise type and performs poorly for various noises. To deal with above deficiencies, we propose a learning-based multi-type noise suppressing method (MNSM). Firstly, “Parallel” denoising approach is utilized to obtain partially denoised images that supply sufficient information for the subsequent fusion task. Mean-while, the noise recognition net identifies noise type and adjusts the brightness of every partially denoised image, realizing the adaptivity for different noises. The fusion net lastly merges these images to acquire one clean image. Experimental results show that this approach obtains higher peak-signal-to-noise ratio (PSNR) than existing methods.},
  keywords={Deep learning;Image recognition;Simulation;Noise reduction;Brightness;Task analysis;Remote sensing;Remote sensing;multiple noises;denoising;parallel structure},
  doi={10.1109/IGARSS46834.2022.9884897},
  ISSN={2153-7003},
  month={July},}@ARTICLE{10105531,
  author={Huang, Ouhan and Rao, Huanle and Zhang, Zhongyi and Gu, Renshu and Xu, Hong and Jia, Gangyong},
  journal={IEEE Transactions on Sustainable Computing}, 
  title={Boosting Research for Carbon Neutral on Edge UWB Nodes Integration Communication Localization Technology of IoV}, 
  year={2024},
  volume={9},
  number={3},
  pages={341-353},
  abstract={Reducing carbon emission to improving the economy of fuel vehicle is one of the effective ways to achieve Carbon Neutrality. The Internet of Vehicles (IoV) is a developing technology for deep integration of the Internet of Things (IoT) and transportation. The Industrial Internet of Things (IIoT) can incorporate vehicle information to pinpoint vehicle carbon emissions and provide a foundation for the subsequent carbon-neutral decision-making process. To achieve the precision needs of IoT, however, more than conventional Global Navigation Satellite Systems (GNSS) are required. To achieve carbon emission detection, provide high-precision positioning, and provide a foundation for subsequent carbon-neutral decision-making, it is essential to design a carbon emission detection and positioning system with the capability of vehicle networking. The geographic proximity of edge Ultra Wide Band (UWB) nodes and the merging of various data sources are two methods we suggest employing in this study to increase location accuracy in IIoT situations. After carefully examining the positioning error of the single-edge node and the range error achieved in the UWB communication system, we choose a suitable filtering strategy to enhance single-node accuracy. Following the improvement of single-node accuracy, we fuse the location information of multiple edge nodes using a Weighted Least Squares algorithm in the spatial dimension; in the temporal dimension, we use Extended Kalman filtering to fuse the data over a period of time due to the temporal correlation of inter-node communication. Experimental results demonstrate that our co-localization method, which combines temporal and spatial information, achieves higher localization accuracy in comparison with previous work.},
  keywords={Location awareness;Global navigation satellite system;Distance measurement;Kalman filters;Automobiles;Industrial Internet of Things;Internet of Vehicles;Industrial Internet of Things;Internet of Vehicles;carbon neutrality;ultra-bandwidth;weighted least squares;extended kalman filter},
  doi={10.1109/TSUSC.2023.3266729},
  ISSN={2377-3782},
  month={May},}@INPROCEEDINGS{9614407,
  author={Liu, Ying and Li, Xu Wang and Zhou, Changfei and Li, Hui and Guo, Lei},
  booktitle={2021 International Symposium on Antennas and Propagation (ISAP)}, 
  title={Low-Profile and Broadband Dielectric Resonator Antenna By Using Air Regions}, 
  year={2021},
  volume={},
  number={},
  pages={1-2},
  abstract={A low profile dielectric resonator antenna (DRA) with wide impedance bandwidth is proposed by introducing the air regions. This proposed DRA is fed by two symmetrical slots. The DRA modes can be excited and merged to broaden the impedance bandwidth by inserting air regions insider the DRA. This DRA can achieve impedance bandwidth of 45.8% covering the frequency band of 3.2-5.1GHz. At the same time, it has very low profile of about 0.07λ0. A relatively stable gain is obtained around 6.25 dBi.},
  keywords={Resonant frequency;Bandwidth;Dielectric resonator antennas;Dielectrics;Broadband communication;Impedance;Broadband antennas;dielectric resonator antenna;multiple-layer structure;multiple modes;wide bandwidth;low profile},
  doi={10.23919/ISAP47258.2021.9614407},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10776550,
  author={Tahir, H. Ahmed and Nabi, Fahad and Tariq, Muhammad Ziad and Khan, Ahmad Fasih and Mahmud, Azwan},
  booktitle={2024 Multimedia University Engineering Conference (MECON)}, 
  title={Insights Into the Future: XAI Integration in O-RAN and Space Communication Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper outlines the merging of Explainable Artificial Intelligence (XAI) with Open Radio Access Network (O-RAN) and space communication systems. The usage of AI drives decision-making in critical domains of telecommunications and space explorations requires transparency and interpretability. However, traditional AI models often operate as “black boxes,” making it difficult to understand their decision-making processes. This lack of explainability poses significant risks, including misinterpretation of signals, undetected anomalies, and erroneous decision-making, which can compromise the integrity of communication systems. Specifically, the challenges include accurately distinguishing between legitimate signals and attacks in anti-jamming scenarios, understanding the behaviour of complex models like LSTM in traffic prediction, and ensuring the reliability of telemetry data despite errors and noise. Integration of XAI techniques within O-RAN architecture and space communication protocols can ensure trust, reliability and safety in AI-enabled systems. This paper investigates the opportunities and challenges of incorporating XAI in O-RAN and space communications. Additionally, it presents the implications of XAI, the need for interpretability in autonomous spacecraft operations, anomaly detection and decision support for mission-critical tasks. By bridging the gap in AI transparency and advanced communication technology, this paper aims to present a detailed analysis of implemented AI and Machine Learning (ML) in the telecommunication domain. It also presents the challenges currently faced in the intersection of XAI and communication. Use cases of XAI in the domain of Open Radio Access Network and Space Communications in light of LIME and SHAP techniques were presented to give a hypothetical modelling for future experimentation to provide local and global interpretation and explanations for the currently employed AI/ML models in the respective domains. Overall, this survey concludes by summarizing the general progress of AI and the benefits of utilizing XAI for O-RAN and Space communication.},
  keywords={Surveys;Space vehicles;Explainable AI;Space communications;Decision making;Open RAN;Reliability;Telemetry;Artificial intelligence;Virtualization;Explainable Artificial Intelligence (XAI);Machine Learning (ML);Key Performance Indicators (KPIs);Open Access Radio Network (O-RAN);Space Systems;Autonomous Space Systems},
  doi={10.1109/MECON62796.2024.10776550},
  ISSN={},
  month={July},}@ARTICLE{11133439,
  author={Ardekani, Mohammad Hadi Moradi and Dastranj, Aliakbar and Pashangeh, Shima},
  journal={IEEE Open Journal of Antennas and Propagation}, 
  title={Integration of Modified Degenerate Second-Order and Dominant Modes to Design a Broadband Single-Fed Circularly Polarized Patch Antenna}, 
  year={2025},
  volume={6},
  number={6},
  pages={1787-1798},
  abstract={This paper presents a novel broadband single-fed circularly polarized (CP) patch antenna that achieves unprecedented bandwidth performance by leveraging the interaction between dominant (TM10, TM01) and second-order (TM20, TM02) modes. Unlike conventional designs, this antenna achieves simultaneous excitation and mode merging by strategically increasing the air gap between a suspended radiator and the ground plane. This alignment transforms the typical dual-beam radiation of second-order modes into a desirable single-beam broadside pattern. To achieve CP, a square slot, corner truncations, and feed displacement are used to excite orthogonal modes with appropriate phase shifts. Further, the integration of a capacitive probe feed and a capacitive shorting pin significantly enhances impedance bandwidth (IBW) and axial ratio bandwidth (ARBW), respectively. Measured results confirm the effectiveness of the proposed design, demonstrating an exceptional 71.8% IBW and 48.1% ARBW—the widest reported for a single-feed CP patch antenna to date. This work introduces a new strategy for mode control and polarization synthesis in compact patch antennas, offering a structurally simple yet high-performance solution for next-generation wireless communication systems.},
  keywords={Patch antennas;Resonant frequency;Broadband antennas;Substrates;Q-factor;Broadband communication;Electric fields;Impedance;Polarization;Circular polarization (CP);patch antenna;single-fed;modes;fringing field},
  doi={10.1109/OJAP.2025.3601195},
  ISSN={2637-6431},
  month={Dec},}@INPROCEEDINGS{11291510,
  author={A, Harsha Ragini. and G, Ramana Murthy.},
  booktitle={2025 Third International Conference on Cyber Physical Systems, Power Electronics and Electric Vehicles (ICPEEV)}, 
  title={Innovative Device Modeling of Ferroelectric FETs for Intelligent Memory-Logic Integration}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Logic-in-memory (LIM) computing, which merges logic and memory operations within a single framework, presents a transformative approach to mitigating the memory bottleneck. Ferroelectric Field-Effect Transistors (FeFETs), particularly those based on hafnium-zirconium oxide (HZO), offer promising prospects for LIM architectures due to their non-volatility, CMOS compatibility, and scalability. This research develops a multi-scale simulation and modeling framework from material to circuit level to explore and optimize FeFET behavior for next-generation logic-in-memory systems. Utilizing density functional theory, phase-field modeling, and TCAD simulations augmented by Landau-Khalatnikov theory, the study captures ferroelectric switching dynamics and retention behavior. Compact Verilog-A models are proposed for circuit-level simulations. The integration strategy emphasizes the atomic layer deposition of HZO, rapid thermal annealing for stabilizing the orthorhombic phase, and gate stack optimization. Experimental benchmarking validates simulation outcomes and demonstrates the feasibility of FeFET-based LIM blocks, highlighting their superior energy-delay performance compared to conventional memory solutions. The findings offer essential insights into the co-design of materials, devices, and processes for future in-memory computing platforms.},
  keywords={Semiconductor device modeling;Scalability;Computer architecture;Switches;Logic gates;Transistors;Integrated circuit modeling;Vehicle dynamics;FeFETs;Standards;Ferroelectric Field-Effect Transistors (FeFETs);Logic-in-Memory (LIM);Hafnium-Zirconium Oxide (HZO);Retention and Endurance},
  doi={10.1109/ICPEEV67897.2025.11291510},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10888582,
  author={Dong, Linhua and Zhou, Xiaofei and Zhu, Qiannan and Bai, Xu and Xiong, Gang},
  booktitle={ICASSP 2025 - 2025 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Efficient Non-Sequential Relational Modeling for Temporal Knowledge Graph Link Predictions}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Temporal Knowledge Graphs (TKGs) are being widely explored to predict the future for they record multi-relational knowledge and the happening time of real-life facts. Existing works learn sequential patterns to infer the future from past facts in TKGs for predictions. Although achieving promising results, they are restricted by the sequential modeling in both efficiency and effectiveness. To resolve these limitations, we propose our efficient and effective non-sequential relational modeling (NoSeq). NoSeq works non-sequentially for temporal patterns where it transforms the happening time into time intervals. Time intervals are the period of time between happening time and prediction time which state the temporal distance clearly. Both time intervals and relations are represented using embeddings and merged non-sequentially into entity embeddings for future predictions. We evaluate NoSeq on four datasets from the perspective of effectiveness, efficiency, sensitivity, and the ability to transfer. Consistent better performances verify our idea.},
  keywords={Sensitivity;Knowledge graphs;Transforms;Predictive models;Signal processing;Acoustics;Speech processing;Graph-structured data;Temporal Knowledge Graph;Temporal Knowledge Graph Link Predictions},
  doi={10.1109/ICASSP49660.2025.10888582},
  ISSN={2379-190X},
  month={April},}@INPROCEEDINGS{11074206,
  author={Srilatha, A and Praveen, Pappula},
  booktitle={2025 7th International Conference on Inventive Material Science and Applications (ICIMA)}, 
  title={Integration of UAV-based Imaging and Machine Learning for Smart Crop Classification and Agricultural Optimization}, 
  year={2025},
  volume={},
  number={},
  pages={1005-1010},
  abstract={The combination of AI and smart devices has provided people with techniques for controlling and enhancing the yield of crops. Conventional methods for crop identification are typically resource-intensive, slow, and vulnerable to inaccuracies from manual handling. This study aims to resolve sluggish crop recognition by merging aerial imaging from UAV with data driven machine learning method for automated analysis in agriculture. UAV acquired aerial data with fine spatial detail was using machine learning technique, including CNN, KNN, SVM, and Random Forest classifiers. The empirical analysis confirms that the proposed method strategy significantly elevates classification results, with CNN recording the highest accuracy of 95.7%. This method not only reduces the reliance on manual effort but also provides farmers with practical insights to support informed decision making, thereby optimizing crop yield and field management. The study also highlights technical obstacles like managing extensive datasets, integrating complex systems, and ensuring scalability, while proposing future prospects for real time deployment and IoT integration improve smart farming solutions.},
  keywords={Support vector machines;Accuracy;Imaging;Manuals;Streaming media;Soil;Autonomous aerial vehicles;Spatial databases;Spatial resolution;Smart devices;AI;CNN;UAV;Image Processing;ML;IoT},
  doi={10.1109/ICIMA64861.2025.11074206},
  ISSN={},
  month={May},}@INPROCEEDINGS{10629279,
  author={Song, Zicheng and Zhu, Xiaoqing},
  booktitle={2024 5th International Conference on Mechatronics Technology and Intelligent Manufacturing (ICMTIM)}, 
  title={A Novel Deformable Wheel-leg Robot Design and Simulation}, 
  year={2024},
  volume={},
  number={},
  pages={468-473},
  abstract={This paper presents the design and simulation of a novel deformable wheel-leg robot, a cutting-edge advancement in robotic mobility. Merging the stability of wheel-based locomotion with the versatility of legged movement, this robot stands as a significant innovation in crossing complex terrains. The research encompasses a comprehensive design approach, focusing on a unique transformation mechanism that facilitates seamless transition between wheel and leg modes. Utilizing SOLIDWORKS2020 and Adams View 2018, the design process involved extensive simulations to validate the robot's dynamics and functional capabilities. The outcome demonstrates a versatile robot with superior adaptability, capable of efficient movement in diverse environments. This study contributes valuable insights into wheel-leg robotics, offering potential applications in areas like disaster rescue and exploration of challenging terrains.},
  keywords={Legged locomotion;Technological innovation;Service robots;Disasters;Wheels;Focusing;Stability analysis;wheel-leg robot;deformable structure;dynamic simulation;mechanical design;obstacle crossing},
  doi={10.1109/ICMTIM62047.2024.10629279},
  ISSN={},
  month={April},}@INPROCEEDINGS{9798544,
  author={Zhang, Zongke and Xu, Shengjie and Tang, YuJia and Xiong, Yifan},
  booktitle={2021 6th International Conference on Transportation Information and Safety (ICTIS)}, 
  title={Updating of Complex FEM Model of Air-cushion-vehicle Flexible Skirt in Abaqus}, 
  year={2021},
  volume={},
  number={},
  pages={726-732},
  abstract={Based on the configuration of air cushion vehicle flexible skirt and its loaded force, a solution to update complex model of skirt was presented. Through application developments by Visual LISP in AutoCAD and by VBA in CATIA, it can automatically parse nodes with same coordinate on neighbor ear flaps of neighbor fingers and differentiate to form independent left and right ear flap, and merge finger foreface with left / right side ears to form a whole finger mesh. It can also parse skirt outer / inner attach edge to add hull bottom and side cline into mesh model. Finally, it can extract finger deformation from analysis result file (*.odb) in Abaqus and parse boundary edge of finger contacting with ground. For the updated FEM model, each whole finger from hundred could be selected easily, loaded by force, assert un-penetrate restriction between neighbor ear flaps, parse finger position touching with ground during post-process, then form basis for further analysis.},
  keywords={Visualization;Analytical models;Atmospheric modeling;Fingers;Force;Transportation;Ear;flexible skirt;complex spatial structure;nonlinear analysis;Meshed model updating in Abaqus;application development},
  doi={10.1109/ICTIS54573.2021.9798544},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{8995365,
  author={Liang, Yi and Changjian, Wang and Fangzhao, Li and Yuxing, Peng and Qin, Lv and Yuan, Yuan and Zhen, Huang},
  booktitle={2019 IEEE 31st International Conference on Tools with Artificial Intelligence (ICTAI)}, 
  title={TFPN: Twin Feature Pyramid Networks for Object Detection}, 
  year={2019},
  volume={},
  number={},
  pages={1702-1707},
  abstract={FPN (Feature Pyramid Networks) is one of the most popular object detection networks, which can improve small object detection by enhancing shallow features. However, limited attention has been paid to the improvement of large object detection via deeper feature enhancement. One existing approach merges the feature maps of different layers into a new feature map for object detection, but can lead to increased noise and loss of information. The other approach adds a bottom-up structure after the feature pyramid of FPN, which superimposes the information from shallow layers into the deep feature map but weakens the strength of FPN in detecting small objects. To address these challenges, this paper proposes TFPN (Twin Feature Pyramid Networks), which consists of (1) FPN+, a bottom-up structure that improves large object detection; (2) TPS, a Twin Pyramid Structure that improves medium object detection; and (3) innovative integration of these two with FPN, which can significantly improve the detection accuracy of large and medium objects while maintaining the advantage of FPN in small object detection. Extensive experiments using the MSCOCO object detection datasets and the BDD100K automatic driving dataset demonstrate that TFPN significantly improves over existing models, achieving up to 2.2 improvement in detection accuracy (e.g., 36.3 for FPN vs. 38.5 for TFPN on COCO Val-17). Our method can obtain the same accuracy as FPN with ResNet-101 based on ResNet-50 and needs fewer parameters.},
  keywords={Object Detection FPN TFPN Twin-Pyramid Structure},
  doi={10.1109/ICTAI.2019.00251},
  ISSN={2375-0197},
  month={Nov},}@ARTICLE{10636344,
  author={Wang, Sai and Fan, Fenglei},
  journal={IEEE Transactions on Geoscience and Remote Sensing}, 
  title={STINet: Vegetation Changes Reconstruction Through a Transformer-Based Spatiotemporal Fusion Approach in Remote Sensing}, 
  year={2024},
  volume={62},
  number={},
  pages={1-16},
  abstract={Filling gaps in high-resolution satellite imagery is essential for tracking vegetation changes over time. Spatiotemporal fusion (STF) aims to create fusion products that improve both spatial resolution and temporal coverage by using images from various remote sensing sources. However, most existing STF methods rely on the assumption that reflectance values for the same land-cover type remain constant between base and prediction dates, a premise often invalidated by the variability in vegetation disturbance and recovery scenarios, where differences in disturbance intensity, patterns, and phenological stages challenge this uniformity. Therefore, we propose a novel Transformer-based method, the spatiotemporal integration network (STINet), which is effective in fusing multiscale spatiotemporal dynamic features. STINet is structured around three key components. The feature fusion (FF) block effectively integrates multiscale spatiotemporal information into a deep learning (DL) framework. The adaptive feature extraction (AFE) block significantly improves the precision of pixel-level features, essential for detecting subtle changes in diverse vegetation patterns. The spatiotemporal-wise multihead self-attention (ST-MSA) module through its innovative self-attention mechanism across spatiotemporal dimensions, facilitated the reconstruction of vegetation dynamics. To verify the effectiveness and robustness of the proposed method, we conducted experiments in three carefully selected scenarios using multisensor and multitemporal imagery to reconstruct the dynamic changes in vegetation due to various disturbances and recovery processes. Compared to the four typical fusion methods [enhanced spatial and temporal adaptive reflectance fusion model (ESTARFM), flexible spatiotemporal data fusion method (FSDAF), extended super-resolution convolutional neural network (ESRCNN), and multiscene spatiotemporal fusion network (MUSTFN)], STINet achieved the best performance in preserving both spatial texture and spectral value. Furthermore, we showcased the applicability and effectiveness of STINet in accurately capturing phenological changes and distinguishing various farming activities.},
  keywords={Spatiotemporal phenomena;Spatial resolution;Vegetation mapping;Reflectivity;Feature extraction;MODIS;Landsat;Multisensor satellite data;spatiotemporal fusion (STF);time-series data;transformer},
  doi={10.1109/TGRS.2024.3443258},
  ISSN={1558-0644},
  month={},}@INPROCEEDINGS{9691432,
  author={Abdelrasoul, Maher and Shaban, Ahmed Sayed and Abdel-Kader, Hala},
  booktitle={2021 9th International Japan-Africa Conference on Electronics, Communications, and Computations (JAC-ECC)}, 
  title={FPGA Based Hardware Accelerator for Sorting Data}, 
  year={2021},
  volume={},
  number={},
  pages={57-60},
  abstract={Sorting data is one of the most important processes in data processing. Fast processing is urgently needed for real time data access. Therefore, hardware accelerator is used to fasten the data processing. In this paper, we present FPGA based hardware accelerators for data sorting using bubble, selection, insertion and merge sorting algorithms. Further, we provide a fair comparison between them in terms of execution time, and area. Our implementations result in that for small data set, merge sort is the best sorting algorithm in terms of execution time. Therefore, it can be used as a parallel cooperative system with CPU for high speed data processing.},
  keywords={Computer architecture;Cooperative systems;Data processing;Real-time systems;Hardware acceleration;Field programmable gate arrays;Sorting;Sorting Algorithms;FPGA;Hardware Accelerator},
  doi={10.1109/JAC-ECC54461.2021.9691432},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9769556,
  author={Frey, Thomas and Döring, Maximilian and Waldschmidt, Christian and Chaloun, Tobias},
  booktitle={2022 16th European Conference on Antennas and Propagation (EuCAP)}, 
  title={Towards Holographic Antenna Systems for MIMO Radar and Communication Applications}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={A novel synthesis method using an incident angle dependent impedance mapping for holographic multi-feed antennas is presented. Since the unit cells of the holographic antenna are shared with all feeds, it is necessary to merge all of the sub-holograms to a common physical geometry. In the proposed multi-beam synthesis, a individual merged impedance hologram for each feeding point is determined, which has the lowest impedance error to the corresponding analytical holograms. Subsequently, a non pixel-based genetic optimization is used to account for global error minimization across all feeds. The antenna is going to be realized on glass due its lower loss and dispersive properties compared to Teflon-based materials at mm-wave frequencies. In addition to the incident angle dependent hologram synthesis method, an appropriate sub-wavelength pixel has been design and optimized with enhanced anisotropic properties. The implemented holographic multi-feed antenna design has an antenna gain of 23.3 dBi and 23.0 dBi, a polarization purity of 20.3 dB and 23.0 dB and a side-lobe level of −18.5 dB and −19.0 dB with 2 feeds at 77 GHz.},
