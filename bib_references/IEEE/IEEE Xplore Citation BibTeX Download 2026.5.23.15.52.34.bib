  ISSN={},
  month={March},}@INPROCEEDINGS{6599726,
  author={Dashti, Hamideh and Neshati, Mohammad H.},
  booktitle={2013 21st Iranian Conference on Electrical Engineering (ICEE)}, 
  title={Numerical investigation of a broadband dielectric resonator antenna backed by SIW cavity}, 
  year={2013},
  volume={},
  number={},
  pages={1-4},
  abstract={In this paper an slot excited cylindrical Dielectric Resonator Antenna (DRA) backed by a substrate integrated waveguide (SIW) cavity is numerically investigated based on Finite Element Method (FEM). It consists of a DRA placed on the conducting back plane of the SIW cavity. A resonator slot is used to couple energy from the cavity to the DRA. By merging two resonant frequencies of the slot and the DR, a wide operating bandwidth is achieved. A parametric study of the slot size, feed line length and dimensions of the DRA on the radiation performance of the antenna is carried out. Results show that the proposed structure exhibits as much as bandwidth of 26% for S11<; -10 dB. Gain of the antenna structure is at least 5 dB over the whole operation band and its radiation efficiency is more than 95%.},
  keywords={Dielectric resonator antennas;Cavity resonators;Dielectrics;Slot antennas;Bandwidth;Broadband antennas;Substrates;Dielectric resonator antenna (DRA);Substrate Integrated Waveguide (SIW);Cavity;Slot},
  doi={10.1109/IranianCEE.2013.6599726},
