  author={Tasdemir, Kasim and Kurugollu, Fatih and Sezer, Sakir},
  booktitle={2015 23nd Signal Processing and Communications Applications Conference (SIU)}, 
  title={A steganalysis system utilizing temporal pixel correlation of HEVC video}, 
  year={2015},
  volume={},
  number={},
  pages={2446-2449},
  abstract={High Efficiency Video Coding (HEVC) is the most recent video codec coming after currently most popular H.264/MPEG4 codecs and has promising compression capabilities. It is conjectured that it will be a substitute for current video compression standards. However, to the best knowledge of the authors, none of the current video steganalysis methods designed or tested with HEVC video. In this paper, pixel domain steganography applied on HEVC video is targeted for the first time. Also, its the first paper that employs accordion unfolding transformation, which merges temporal and spatial correlation, in pixel domain video steganalysis. With help of the transformation, temporal correlation is incorporated into the system. Its demonstrated for three different feature sets that integrating temporal dependency substantially increased the detection accuracy.},
  keywords={Correlation;Feature extraction;Unsolicited electronic mail;Payloads;Security;Video codecs;Accuracy;video steganalysis;video steganography;HEVC},
