  author={Elmore, Paul A. and Petry, Frederick E. and Yager, Ronald R.},
  journal={IEEE Transactions on Emerging Topics in Computational Intelligence}, 
  title={Dempster–Shafer Approach to Temporal Uncertainty}, 
