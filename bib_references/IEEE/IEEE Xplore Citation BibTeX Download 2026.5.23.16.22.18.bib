  booktitle={2024 6th International Conference on Intelligent Control, Measurement and Signal Processing (ICMSP)}, 
  title={SVGACrack: Sparse Vision Graph Attention Segmentation Networks Enabling Precise Pavement Crack Detection}, 
  year={2024},
  volume={},
  number={},
  pages={349-354},
  abstract={Most current pavement crack detection tasks depend on Convolutional Neural Networks (CNNs) and Vision Transformer Networks (ViT) for feature extraction, and this dependency often makes it difficult to effectively capture irregular and complex cracks, which in turn affects crack detection performance. To tackle this challenge, this paper proposes a novel graph-based sparse attention mechanism encoder-decoder structure model for pavement crack detection (SVGACrack), which utilizes a hybrid CNN-GNN architecture MobileViG as the encoder backbone for multi-scale feature extraction in multiple stages, and the decoder adopts a lightweight multilayer perceptron structure, which uses an MLP layer first to unify the number of channels of the feature maps generated in each stage. The feature maps are then up-sampled and merged to capture both semantic abstraction and local details, improving detection accuracy. Finally, on the DeepCrack and Crack500 dataset, our proposed SVGACrack model obtains the highest F1-score, which outperforms current the state-of-the-art methods and proves its effectiveness in pavement crack detection.},
  keywords={Image segmentation;Attention mechanisms;Semantics;Signal processing;Multilayer perceptrons;Feature extraction;Transformers;Hybrid power systems;Convolutional neural networks;Intelligent control;component;Crack Detection;Graph-Based Sparse Attention;Encoder-Decoder Structure;Pixel-Wise segmentation},
  doi={10.1109/ICMSP64464.2024.10866040},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10583082,
  author={Jia, Lei and Chen, Xipeng and Qi, Ruihan and Xiao, Xiaobing and Li, Yue and Yeung, Chakhung and Lyu, Jiahua},
  booktitle={2024 IEEE 7th International Electrical and Energy Conference (CIEEC)}, 
  title={Impedance Calculation of Twisted Cores in Power Lines at High Frequency by a Multi-Level PEEC Method}, 
  year={2024},
  volume={},
  number={},
  pages={883-888},
  abstract={Power lines are essential components of the electrical grid that transport electricity from power plants to homes, businesses, and industries. These lines typically consist of core, sheath, and armor. The core is usually made of several twisted copper strands, and its complex structure leads to a difficult impedance analysis for transient analysis in lightning protection. The analytical method and numerical method are two common strategies for twisted core impedance analysis. However, the analytical method does not consider the impact of helix pitch on the eddy current, and it leads to the calculation error. It is hard for the numerical method to build the model of twisted cores with hundreds of strands. It is also time-consuming for the numerical method to solve the impedance of the complex structure at high frequency. This work proposes a multi-level PEEC method to solve the impedance of twisted cores of power lines. The method can depict the helix structure of twisted cores and can calculate the impedance within a considerable time.},
  keywords={Accuracy;Power cables;Lightning protection;Numerical models;Impedance;High frequency;Wire;power line;eddy effect;twisted structure;impedance analysis;numerical calculation},
  doi={10.1109/CIEEC60922.2024.10583082},
  ISSN={},
  month={May},}@INPROCEEDINGS{11171576,
  author={Xu, Gaotian and Zhang, Tinghao and Li, Shasha and Li, Zhihui},
  booktitle={2025 10th International Conference on Signal and Image Processing (ICSIP)}, 
  title={An Accelerated Back Projection Algorithm via Recursive Spectrum Fusion for High-Speed High-Squint SAR Imaging with Curved Trajectory}, 
  year={2025},
  volume={},
  number={},
  pages={521-525},
  abstract={For high-speed-high-squint synthetic aperture radar (HSHS-SAR) with curved trajectory, the ineffectively aligned spectrum is inevitably involved in state-of-the-art fast back projection algorithms (FBPAs), which degrades their imaging performance both in efficiency and accuracy. In this paper, the polar coordinates (PC) based-FBPA is proposed for HSHS-SAR with curved trajectory, which is referred to as PC-FBPA. In the designed PC, the spectra of different scatterers exhibit consistent support regions, which significantly facilitates the spectrum alignment for the non-interpolated sub-image merging process. This approach achieves high performance both in efficiency and accuracy for HSHS-SAR with curved trajectory. Simulation and raw data experiments are provided and analyzed to validate the performance superiority of the proposed algorithm.},
  keywords={Accuracy;Image coding;Merging;Imaging;Radar imaging;Radar polarimetry;Trajectory;Projection algorithms;Synthetic aperture radar;Fast back projection algorithm (FBPA);polar coordinate (PC);high-speed-high-squint synthetic aperture radar (HSHS-SAR) with curved trajectory},
  doi={10.1109/ICSIP65915.2025.11171576},
  ISSN={2642-6471},
  month={July},}@ARTICLE{8681515,
  author={Fresnedo, Óscar and Suárez-Casal, Pedro and Castedo, Luis},
  journal={IEEE Access}, 
  title={Transmission of Analog Information Over the Multiple Access Relay Channel Using Zero-Delay Non-Linear Mappings}, 
  year={2019},
  volume={7},
  number={},
  pages={48405-48416},
  abstract={We consider the zero-delay encoding of discrete-time analog information over the Multiple Access Relay Channel (MARC) using non-linear mapping functions. On the one hand, zero-delay non-linear mappings are capable to deal with the multiple access interference (MAI) caused by the simultaneous transmission of the information. On the other, the relaying operation is a Decode-and-Forward (DF) strategy where the decoded messages are merged into a single message using a specific continuous mapping depending on the correlation level of the source information. At the receiver, an approximated Minimum Mean Squared Error (MMSE) decoder is developed to obtain an estimate of the transmitted source symbols which exploits the information received from the relay node in combination with the messages received from the transmitters through the direct links. The resulting system provides better performance than the other alternative encoding strategies for the MARC with similar complexity and delay and also approaches the performance of theoretical strategies which require a significantly higher delay and computational cost.},
  keywords={Relays;Decoding;Delays;Encoding;Receivers;Complexity theory;Network coding;Combined source-channel coding;relay networks;multiuser channels;network coding},
  doi={10.1109/ACCESS.2019.2909318},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10001357,
  author={Zhang, Xi and Huang, Cheng and Su, Ye and Qin, Jing and Shen, Xuemin},
  booktitle={GLOBECOM 2022 - 2022 IEEE Global Communications Conference}, 
  title={Divertible Searchable Symmetric Encryption for Secure Cloud Storage}, 
  year={2022},
  volume={},
  number={},
  pages={3785-3790},
  abstract={Searchable Symmetric Encryption (SSE) is a promising method for users to store data in remote clouds securely and search them using keywords over an encrypted index. In this paper, we explore a new function named “keyword diverting” and propose a variant of SSE named Divertible Searchable Symmetric Encryption (DivSSE). Specifically, the index in DivSSE is encoded into an inverted, compressed, and encrypted format, by using the super-increasing sequence, symmetric homomorphic encryption (SHE), and a secure hash function. According to the homomorphic properties of SHE, users can construct a unique keyword diverting token, which can be utilized to update the encrypted index by obliviously merging data identifiers corresponding to different keywords without searching in advance and thus achieve keyword diverting. Moreover, based on function secret sharing, DivSSE can protect users' search patterns and reduce communication costs with the assistance of two independent clouds. Detailed security proof demonstrates that DivSSE can achieve parallel privacy, forward privacy, and backward privacy. Extensive performance evaluation also shows that DivSSE is efficient in terms of computational and communication overheads.},
  keywords={Performance evaluation;Cloud computing;Privacy;Data privacy;Costs;Heuristic algorithms;Merging;diverting;Searchable symmetric encryption;Parallel privacy;Encrypted data management},
  doi={10.1109/GLOBECOM48099.2022.10001357},
