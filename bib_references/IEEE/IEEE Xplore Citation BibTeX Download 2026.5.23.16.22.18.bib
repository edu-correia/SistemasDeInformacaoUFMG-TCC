  journal={IEEE Internet of Things Journal}, 
  title={Toward Accurate Federated Graph Learning Via Layer-Wised Clustering for Social Internet of Things}, 
  year={2025},
  volume={12},
  number={17},
  pages={35025-35036},
  abstract={federated graph learning (FGL) has emerged as a promising paradigm for privacy-preserving collaborative learning in Social Internet of Things (SIoT), where nodes form complex interconnected networks. Existing FGL approaches face significant challenges including model degradation in handling nonindependent and identically distributed (non-IID) data and maintaining model performance across heterogeneous nodes. This article proposes framework via layer-wised clustering (FedLWC), a novel layer-wised clustering framework inspired by evolutionary processes is proposed to enhance the effectiveness of FGL. FedLWC designs three key aspects: 1) a fisher information matrix-based layer selection mechanism that identifies and evaluates critical model layers, which can reduce parameter redundancy; 2) a layer intersection clustering algorithm that preserves common key layers while accommodating local features; and 3) an adaptive layer merge strategy that effectively combines global shared layers with clustered key layers. To make sure that the proposed approach is rigorous, we conduct theoretical convergence analysis for the proposed framework under non-IID conditions. Extensive experiments on multiple benchmark graph datasets demonstrate FedLWC’s performance, achieving an average accuracy improvement of 7.01% compared to state-of-the-art federated learning methods.},
  keywords={Federated learning;Training;Data models;Computational modeling;Adaptation models;Social Internet of Things;Servers;Convergence;Clustering algorithms;Data privacy;federated learning (FL);fisher matrix;layer selection;layer-wised clustering;Social Internet of Things (SIoT)},
