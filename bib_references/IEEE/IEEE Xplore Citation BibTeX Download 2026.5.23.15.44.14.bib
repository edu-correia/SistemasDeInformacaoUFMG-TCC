  title={Improvement of spectral and spatial information using WAMM and bi-cubic interpolation method in Non-subsampled contourlet transform domain}, 
  year={2015},
  volume={},
  number={},
  pages={1-5},
  abstract={Pan-sharpening is widely used as a tool toconstruct remotely sensed image, which is rich in both spectral and spatial contents. Panchromatic sharpening is used to improve the spatial resolution and provide an enhanced visualization of a multiband image using the high-resolutions, single-band image. The main scope of pan-sharpening is to maximize the spatial content simultaneously and minimize the spectral distortions which occur during processing. There are many approaches to implement pan-sharpening like principal component analysis (PCA), Intensity, hue and saturation (HIS), and WAVELET. The main drawback of these approaches is the distortion of spectral resolutions. However, Non-subsampled contourlet-transform (NSCT) approach is proved to be efficient. It is alsovery efficient in representing directional information and to capture intrinsic geometrical structure of the object. It combines features like high resolutions, shift-invariance and high-directionality. In this paper modified bi-cubic interpolation method and weighted average merging method (WAMM) are used. By using these methods the image issharper and there is no softening of details in the image, thus improving the quality. In the proposed paper it is possible to improve the efficiency of an image both spectrally and spatially with better efficiency compared to existing methods. The evaluation of efficiency of these methods is done by simulation, using performance metrics like RGE and Q4.},
  keywords={Interpolation;Spatial resolution;Transforms;Remote sensing;Merging;Image fusion;WAMM;NSCT;CT;HIS;GIS},
  doi={10.1109/RACE.2015.7097248},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{1515386,
  author={Jian Yang and Han Zhang and Mark Dencler and Chao Lu},
  booktitle={Fourth Annual ACIS International Conference on Computer and Information Science (ICIS'05)}, 
  title={Comparison of shape-based and stroke-based methods for segmenting handwritten Chinese characters}, 
  year={2005},
  volume={},
  number={},
  pages={114-119},
  abstract={The segmentation of handwritten Chinese text into Chinese characters is an important preprocessing step to the offline Chinese character recognition. It is also a very difficult task due to so many Chinese characters and their handwritten structures can be very complex. Many researchers have developed various algorithms during the past decade by Darning Shi, R. I. Damper, S. R. Gunn (2003), L.Y. Tseng, C.T. Chuang (1997), L.Y. Tseng, R.C. Chen (1997), Feng Lin, Xiaoou Tang (2002), Han Zhang, Chao Lu (2004), S.Y. Zhao, Z.R. Chi, P.F. Shi and Q. Wang (2001). In this paper, we compare two of the existing algorithms. The first one is spatial shape-based algorithm proposed by Han Zhang, Chao Lu (2004), which segments the character strings into radicals, not dealing with stroke identification. The second algorithm is stroke-based by L.Y. Tseng, C.T. Chuang (1997), L.Y. Tseng, R.C. Chen (1997), Feng Lin, Xiaoou Tang (2002), which traces each stroke and draws the stroke-bounding box, then merges the boxes by a set of rules. Based on the algorithms presented by L.Y. Tseng, C.T. Chuang (1997), L.Y. Tseng, R.C. Chen (1997), Feng Lin, Xiaoou Tang (2002), Han Zhang, Chao Lu (2004), we wrote C++ programs for time complexity, accuracy performance comparisons using different handwritten Chinese character texts. Our experimental result shows that the spatial shape-based algorithm by Han Zhang, Chao Lu (2004) is faster and more accurate.},
  keywords={Character recognition;Image segmentation;Computer vision;Dynamic programming;Chaos;Image processing;Writing;Joining processes;Data mining;Merging;Segmentation;character recognition;computer vision;image processing},
  doi={10.1109/ICIS.2005.38},
  ISSN={},
  month={July},}@INPROCEEDINGS{1349244,
  author={Tianyang Dong and Ruofeng Tong and Jinxiang Dong and Ling Zhang},
  booktitle={8th International Conference on Computer Supported Cooperative Work in Design}, 
  title={Knowledge-based assembly sequence planning system}, 
  year={2004},
  volume={2},
  number={},
  pages={516-521 Vol.2},
  abstract={This work presents a knowledge-based approach to assembly sequence planning problem. This research shows that the typical or standard CSBAT (connection semantics based assembly tree) can be applied to a given assembly problem. The structure of the KBASP (knowledge-based assembly sequence planning system) is proposed, there are three ways to construct plans for a CSBAT: (1) by retrieving the typical base; (2) by retrieving standard base; and (3) by geometry reasoning. Compared with other system based on the reuse philosophy the approach can generate assembly sequences for each CSBAT directly without the problem of merging plans for different child CSBATs. By integrating geometry-based reasoning with knowledge-based reasoning, the computation complexity is reduced drastically and the assembly sequences obtained are more feasible and practical.},
  keywords={Assembly systems;Connectors;Manufacturing industries;Laboratories;Character generation;Geometry;Merging;Manufacturing automation;Project management;Technology management},
  doi={10.1109/CACWD.2004.1349244},
  ISSN={},
  month={May},}@INPROCEEDINGS{4439950,
  author={Takao, M. and Masaki, M. and Schimizu, J. and Soutome, K. and Takano, S.},
  booktitle={2007 IEEE Particle Accelerator Conference (PAC)}, 
  title={On skew nonlinear resonance in the SPring-8 storage ring}, 
  year={2007},
  volume={},
  number={},
  pages={4003-4005},
  abstract={Recently we accomplish the matrix formulation for the canonical perturbation theory of the linear betatron coupling resonance in circular accelerators. By merging the perturbation theory with the matrix formalism, we manifest the symplectic structure of the former theory, and conversely derive the analytical representation for the latter. The formulation for the coupled betatron motion explicitly implies that the linear coupling causes the excitation of skew resonances through nonlinear fields with mid-plane symmetry. The third order skew coupling resonance is observed in the SPring-8 storage ring, for example, as the blow-up of the vertical beam size. For the purpose of studying the impact of the linear coupling on the skew nonlinear resonance, we investigate the characteristic behavior of the nonlinear resonance deduced from the matrix formulation of the perturbation theory.},
  keywords={Resonance;Storage rings;Matrix converters;Linear accelerators;Motion analysis;Equations;Merging;Optical coupling;Nonlinear dynamical systems;Nonlinear distortion},
  doi={10.1109/PAC.2007.4439950},
  ISSN={2152-9582},
  month={June},}@INPROCEEDINGS{5366318,
  author={Wang, Xiaoyu and Ouyang, Dantong and Feng, Yuxuan and Zhao, Jian},
  booktitle={2009 International Conference on Information Engineering and Computer Science}, 
  title={An Approach to Accelerate Diagnosis by Isomorphic Determining}, 
  year={2009},
  volume={},
  number={},
  pages={1-4},
  abstract={When diagnosing dynamic system represented as discrete-event systems, it needs to find what happened to the systems from observations. The behavior of system could be represented by automaton model. The diagnostic task consists in determining the models compatible with the observations, but the global computation which is needed in synchronization costs exponential time. In this paper we propose a new method to simplify the automaton by isomorphic determining. The cost of computation will be significantly cut down by merging the automatons with the same structure, and the time-complexity of the diagnosis process could be reduced by the method.},
  keywords={Acceleration;Automata;Discrete event systems;Educational institutions;Computer science;Laboratories;Knowledge engineering;Costs;Computational efficiency;Merging},
  doi={10.1109/ICIECS.2009.5366318},
  ISSN={2156-7387},
  month={Dec},}@INPROCEEDINGS{5452089,
  author={Zhang Dong and Zeng Wenhua},
  booktitle={2010 The 2nd International Conference on Computer and Automation Engineering (ICCAE)}, 
  title={An improved MRI Brain Segmentation algorithm based on AntPart}, 
  year={2010},
  volume={3},
  number={},
  pages={533-535},
  abstract={In this paper, a new algorithm for MRI Brain Segmentation is proposed, which is based on the AntPart algorithm [1]. This algorithm proposed partitiones the brain structure into three parts-white matter, grey matter, and cerebrospinal fluid according to the grayvalues of pixels. The main algorithm compares each pixel with the nearest class center C, all the data belonging to class C, all the data carried by one ant chosen randomly and all the data at(at most) four steps in order, and optimize the performance by recalculating the class centers, merging the close classes and reclassfying the data classified wrongly. The performances of this algorithm are compared with those of two other ones: K-means and FCM. The results show that the method proposed is more accurate.},
  keywords={Magnetic resonance imaging;Clustering algorithms;Image segmentation;Partitioning algorithms;Brain;Merging;Software algorithms;Laboratories;Information technology;Image edge detection;segmentation;antPart;MRI;brainIntroduction},
  doi={10.1109/ICCAE.2010.5452089},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{5365352,
  author={Wang, Zhigang and Zhao, Yuelong and Wang, Zhigang},
  booktitle={2009 International Conference on Computational Intelligence and Software Engineering}, 
  title={Research and Improvement of Mechanism of Searching Resource in Chord Network}, 
  year={2009},
  volume={},
  number={},
  pages={1-4},
  abstract={Chord is a typical model of structured P2P network. However, there are some problems for the mechanism of searching resources in Chord, such as too much redundant information in the routing tables of nodes, the deviation of needed times of forwarding lookup messages among searching resources whose key values are located in different areas of identifier space, some available routing information being not used and the difficulty for supporting complex lookup, e.t. This paper proposes a scheme to add routing information to the routing tables. Meanwhile, it holds down the scale of routing tables by merging the items that have redundant information. In most cases, it makes the nodes actually have even less items in the routing tables than they used to. It also has the advantage that the deviation of time of routing a lookup message becomes smaller. Thus, it makes the performance of resource search more stable, the average hops of routing a lookup message diminished, the memory needed by the routing tables much less and the time of the transact shorter.},
  keywords={Fingers;Educational institutions;Redundancy;Clocks;Computer networks;Steady-state;Intelligent networks;Merging;Routing protocols;Heuristic algorithms},
  doi={10.1109/CISE.2009.5365352},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{6765581,
  author={Numakunai, Satoshi and Jamsaid, Afshan and Yoon, Dong Hyun and Sekiguchi, Tetsushi and Shoji, Shuichi},
  booktitle={2014 IEEE 27th International Conference on Micro Electro Mechanical Systems (MEMS)}, 
  title={Multiple size-oriented passive droplet sorting device and basic approach for digital chemical synthesis}, 
  year={2014},
  volume={},
  number={},
  pages={92-95},
  abstract={This paper presents a multiple size-oriented passive droplet sorting utilizing a balance between surface free energy and flow force. We proposed a simple multi-stage sorting structure which consists of a microchannel and guide grooves formed in parallel. Passive five different-sized droplets sorting of up to 200 droplets/s is achieved without any active elements. Also, we fabricated a prototype of the integrated micro fluidic system for droplet generation, merging and sorting for digital chemical synthesis.},
  keywords={Sorting;Merging;Microfluidics;Force;Chemicals;Microchannel;Scanning electron microscopy},
  doi={10.1109/MEMSYS.2014.6765581},
  ISSN={1084-6999},
  month={Jan},}
