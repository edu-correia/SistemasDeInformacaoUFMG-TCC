  author={Blaizot, Jérémy and Wadadekar, Yogesh and Guiderdoni, Bruno and Colombi, Stéphane T. and Bertin, Emmanuel and Bouchet, François R. and Devriendt, Julien E. G. and Hatton, Steve},
