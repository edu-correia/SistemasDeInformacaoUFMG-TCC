@incollection{FAUDZI202171,
title = {5 - Nanoparticle in composite material},
editor = {Subash C.B. Gopinath and Fang Gang},
booktitle = {Nanoparticles in Analytical and Medical Devices},
publisher = {Elsevier},
pages = {71-82},
year = {2021},
isbn = {978-0-12-821163-2},
doi = {https://doi.org/10.1016/B978-0-12-821163-2.00005-4},
url = {https://www.sciencedirect.com/science/article/pii/B9780128211632000054},
author = {Fatin Nabilah Mohd Faudzi and Azrul Azlan Hamzah},
keywords = {Nanocomposite, nanoparticle-assisted composite, in situ preparation, ex situ preparation, nanocomposite applications},
abstract = {Nanomaterials have been known for their highly attentive attributes that could be of use in various fields of applications. It could be merged with other types of materials to form a high performance composite material. Nanoparticle is a type of material that employs an almost spherical 3D shape with diameter in the range of 1–100nm. Nanoparticle-assisted composite could be prepared by chemically or physically integrating nanoparticles in other materials. This chapter discusses various nanoparticle-assisted composite preparation techniques which could be classified into in situ and ex situ. In situ preparation includes the common method of polymerization reaction, sol–gel preparation, chemical vapor, and physical vapor deposition methods while ex situ preparation includes dip coating, spin coating, and spray coating. The application of nanoparticle-assisted composite has been addressed in medical, healthcare, and other fields as well.}
}
@article{BACHELART2011485,
title = {Les courants intégratifs en psychothérapie},
journal = {Annales Médico-psychologiques, revue psychiatrique},
volume = {169},
number = {8},
pages = {485-489},
year = {2011},
issn = {0003-4487},
