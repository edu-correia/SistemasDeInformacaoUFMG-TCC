url = {https://www.sciencedirect.com/science/article/pii/B9780443214417002338},
author = {Yanko Georgiev Kolev},
keywords = {Bulgaria, Forensic medicine, History, Legal medicine, Medico-legal examination, Organization, Regulations, Roles, Specialty recognition, Statutes},
abstract = {Forensic medicine in Bulgaria is a well-developed and recognized medical specialty with a history dating back to the 19th century, evolving concurrently with European forensic medicine. The country has a robust network of forensic units, conducting forensic pathology, clinical forensic medicine, and specialized laboratory analyses, including DNA and toxicological examinations. Forensic medicine, taught to medical and dental students, is also available for law and police students. Embedded in Bulgarian legislation, it upholds human rights. Currently, about 65 forensic doctors are practicing, with some nearing retirement age, highlighting the need for better funding, motivation, and continued specialization in this essential field.}
}
@article{MIALON2008861,
title = {Efficient horizontal mergers: The effects of internal capital reallocation and organizational form},
journal = {International Journal of Industrial Organization},
volume = {26},
number = {4},
pages = {861-877},
year = {2008},
issn = {0167-7187},
doi = {https://doi.org/10.1016/j.ijindorg.2007.07.004},
url = {https://www.sciencedirect.com/science/article/pii/S0167718707000847},
author = {Sue H. Mialon},
keywords = {Capital reallocation, Horizontal mergers, The M-form},
abstract = {This paper analyzes the resource reallocation problem in merged firms when the merged firms have a choice to retain competition between the merging partners. We consider horizontal mergers between firms that differ only in their initial capital levels. When initial capital levels are unequal, evenly distributing total capital between merging partners improves the overall cost efficiency of the merged firm. In this case, the merger often results in the multidivisional structure (the M-form) rather than the conventional structure of completely integrating merging partners because, under the M-form, the profits from aggressive production expansion backed by efficiency-improving capital reallocation is higher than the profits from output contraction and rationalization under complete integration. Such a merger enhances market competition. On the contrary, mergers between identical firms always induce complete integration.}
}
@article{HU2024109376,
title = {Numerical study of head-on collisions between two glass microsphere droplets},
journal = {International Journal of Heat and Fluid Flow},
volume = {107},
pages = {109376},
year = {2024},
issn = {0142-727X},
doi = {https://doi.org/10.1016/j.ijheatfluidflow.2024.109376},
url = {https://www.sciencedirect.com/science/article/pii/S0142727X24001012},
author = {Xiaolei Hu and Huilin Li and Huangwei Zhang and Shangpeng Li and Chuanhua Xu and Nenggang Xie},
keywords = {Multiphase flow, Glass microsphere droplet, Droplet collision, Droplet morphology, Collision regime},
abstract = {The collision of molten glass microsphere droplets represents a fundamental phenomenon in spheronization, yet a comprehensive understanding of this process remains elusive. A numerical simulation is conducted to investigate the head-on collision dynamics of two molten glass microsphere droplets at varying Weber numbers, by integrating the level set and volume of fluid methods. Three distinct collision regimes are identified: merging, separation into satellite-free droplets, and separation leading to the formation of satellite droplets. Furthermore, the critical Weber numbers delineating the different regimes are presented. Examination of axial and radial variations in the droplets reveals the existence of five distinct states spanning the three collision regimes. The distribution of external vortices around the droplets directly influences the outcomes of droplet collisions. High-pressure regions and high-pressure liquid bridges within droplets serve as key factors in determining the merging or separation of the droplets. Region of high pressure at the end of the liquid bridge acts as a critical indicator for distinguishing between collision separations with and without satellite droplet generation. Observations of velocity and pressure distributions in separations that produce satellite droplets are consistent with the end pinch-off mechanism. This study holds significant implications for controlling high sphericity during the spheronization of glass microsphere droplets.}
}
@article{NIU2026121004,
title = {Decarbonizing district heating via industrial-urban symbiosis: a two-stage optimization and assessment framework},
journal = {Energy Conversion and Management},
volume = {350},
pages = {121004},
year = {2026},
issn = {0196-8904},
doi = {https://doi.org/10.1016/j.enconman.2025.121004},
url = {https://www.sciencedirect.com/science/article/pii/S0196890425015286},
author = {Zihao Niu and Yanxue Li and Xiaoyi Zhang},
keywords = {Industrial-urban symbiosis, District heating, Decarbonization, High-temperature heat pump, Multi-objective optimization, Model predictive control},
abstract = {Industrial–urban symbiosis that reuses low-temperature industrial waste heat in district heating networks is a promising pathway to decarbonize space heating in cold regions. Yet existing planning tools often use fixed heat pump efficiencies or merge design and operation into a single optimization, so they cannot quantify how much decarbonization is lost when systems designed for climate targets are later operated to minimize costs. This study tests the hypothesis that a multi-scale, two-stage framework that explicitly separates environmentally driven capacity planning from economically driven operational dispatch, while preserving physics-based heat pump behavior, can reveal and quantify these hidden trade-offs. The framework couples a high-fidelity vapor-compression cycle model, reduced to a polynomial surrogate and linearized for mixed-integer programming, with capacity planning and an annual model predictive dispatch simulation for a coal-based district heating network in Qingdao, China, including scenarios with on-site wind and solar generation. Compared with the existing coal-fired combined heat and power supply, industrial waste heat recovery with a high-temperature heat pump reduces annual carbon dioxide emissions by up to 62.8 percent, while an economic dispatch strategy cuts annual operating costs by 11.9–27.7 percent at the expense of 33.6–61.0 percent higher emissions than an environmentally driven rule-based strategy, implying a marginal operational cost of 130–154 Chinese yuan for each additional ton of carbon dioxide. These results demonstrate that explicitly decoupling design and operation exposes the decarbonization gap created by market-driven dispatch, provides quantitative benchmarks for carbon pricing and green financing, and offers a transferable, physically grounded tool for planning industrial waste heat integration in district heating systems.}
}
@article{HE2023104352,
title = {Toward personalized decision making for autonomous vehicles: A constrained multi-objective reinforcement learning technique},
journal = {Transportation Research Part C: Emerging Technologies},
volume = {156},
pages = {104352},
year = {2023},
issn = {0968-090X},
doi = {https://doi.org/10.1016/j.trc.2023.104352},
url = {https://www.sciencedirect.com/science/article/pii/S0968090X2300342X},
author = {Xiangkun He and Chen Lv},
keywords = {Autonomous vehicle, Personalized decision making, Reinforcement learning, Multi-objective optimization},
abstract = {Reinforcement learning promises to provide a state-of-the-art solution to the decision making problem of autonomous driving. Nonetheless, numerous real-world decision making problems involve balancing multiple conflicting or competing objectives. In addition, passengers may typically prefer to explore diversified driving modes through their specific preferences (i.e., relative importance of different objectives). Taking into account these demands, traditional reinforcement learning algorithms with applications in personalized self-driving vehicles remain challenging. Consequently, here we present a novel constrained multi-objective reinforcement learning technique for personalized decision making in autonomous driving, with the goal of learning a single model for Pareto optimal policies across the space of all possible user preferences. Specifically, a nonlinear constraint incorporating a user-specified preference and a vectorized action–value function is introduced to ensure both diversity in learned decision behaviors and efficient alignment between the user-specified preference and the corresponding optimal policy. Additionally, a constrained multi-objective actor–critic approach is advanced to approximate the Pareto optimal policies for any user-specified preferences while adhering to the nonlinear constraint. Finally, the proposed personalized decision making scheme for autonomous driving is assessed in a highway on-ramp merging scenario with dynamic traffic flows. The results demonstrate the effectiveness of our method by comparing it with classical and state-of-the-art baselines.}
}
@article{GORZALCZANY2026131359,
title = {Discovering minimal sets of informative genes via multi-step clustering of SRBC-tumor gene expression data using generalized self-organizing neural networks},
journal = {Expert Systems with Applications},
volume = {311},
pages = {131359},
year = {2026},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2026.131359},
url = {https://www.sciencedirect.com/science/article/pii/S0957417426002721},
author = {Marian B. Gorzałczany and Filip Rudziński},
keywords = {SRBC tumors, Gene expression data, Minimal sets of informative genes, Self-organizing neural networks with evolving structures},
abstract = {Molecular diagnostic procedures for tumors – employing microarray technologies – become effective tools for performing precise and early diagnosis of tumors. However, informative genes, i.e., the disease relevant genes constitute only a small fraction of the overall number of the available genes. Therefore, the selection of minimal subsets of highly informative genes is essential in designing accurate tumor classification/prediction systems. This paper aims at designing a two-stage procedure for effective uncovering of collections of such genes. In the first stage of our approach, we apply our tool, i.e., generalized self-organizing neural networks (SONNs) with evolving, splitting-merging structures to the gene data clustering to detect big, dominating clusters of non-informative/noisy genes to be removed from the original data. Drastically reduced – in the first stage – gene expression data set creates an excellent point of departure for effective uncovering – in the second stage and using conventional tools (e.g., decision trees) – of different minimal subsets of highly informative genes. Our approach is able to select – out of original 2308 SRBCT genes – several 4-gene and one 3-gene subsets containing genes characterized by the highest level of informativeness that result in 100%-accuracies of categorizing particular types of tumors. A broad comparative analysis of our approach and 22 available alternative methods (providing 26 different solutions) demonstrates that our approach definitely outperforms all alternative methods in terms of uncovering gene subsets containing minimal numbers of genes characterized by the earlier-mentioned highest level of informativeness.}
}
@article{YANG2026242,
title = {LCVD repair of step surfaces with various rotation angles in additively manufactured SiC ceramics: nanomechanics and interfacial bonding},
journal = {Journal of Manufacturing Processes},
volume = {165},
pages = {242-256},
year = {2026},
issn = {1526-6125},
doi = {https://doi.org/10.1016/j.jmapro.2026.03.011},
url = {https://www.sciencedirect.com/science/article/pii/S1526612526002616},
author = {Chenqian Yang and Ce Sun and Peng Chen and Xiaolong Gong and Song Zhang and Meijun Yang and Kai Liu},
keywords = {Additive manufacturing, Silicon carbide, Laser chemical vapor deposition, Coating},
abstract = {During laser powder bed fusion (LPBF) of complex structures, different inclined angles are unavoidable to form the curved surfaces or overhangs, which results in step textures and degraded surface performance. Therefore, this study proposes an innovative method based on laser chemical vapor deposition (LCVD) that achieves effective filling of the step gaps in the LPBF-fabricated silicon carbide (SiC) substrates. The effects of deposition temperature and substrate rotation angles on coating morphology, mechanical properties and bonding strength are studied in depth. With the increase of deposition temperature, grains in the step grooves grow faster and the grain size becomes more uniform. As the rotation angle increases, the step gaps decrease, which promotes grain merging to fill the gaps and the growth of (111)-oriented grains. The nanomechanical properties are significantly enhanced, with an elastic modulus of 404 GPa and a hardness of 48.7 GPa. In addition, the critical interfacial adhesion increases from 19.4 N for the 0° substrate to 27.4 N for the 90° substrate, indicating a 41% enhancement with increasing surface step orientation. This study provides a practical solution for improving surface quality in additively manufactured SiC components for high-end applications.}
}
@article{WANG2025112683,
title = {A skin lesion segmentation network with edge and body fusion},
journal = {Applied Soft Computing},
volume = {170},
pages = {112683},
year = {2025},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2024.112683},
url = {https://www.sciencedirect.com/science/article/pii/S1568494624014571},
author = {Gao Wang and Qisen Ma and Yiyang Li and Keming Mao and Lisheng Xu and Yuhai Zhao},
keywords = {Skin lesion segmentation, Feature fusion, Multi-scale, Transformer, CNNs},
abstract = {Purpose:
In this paper, a novel local cross-attention Unet(LCAUnet) is proposed to enhance the completeness of representation with the fusion of edge and body features, which are often paid little attention in traditional methods.
Method:
First, two separate branches are set for edge and body segmentation with convolutional neural networks(CNNs) and Transformer based architectures, respectively. Then, the local cross-attention feature fusion(LCAF) module is utilized to merge feature maps of the edge and body of the same level via local cross-attention operation in the encoder stage, and the edge-body interactions can be captured hierarchically. Furthermore, the prior guided multi-scale knowledge fusion(PGMF) module is embedded for feature integration with prior guided multi-scale adaption.
Result:
Comprehensive experiments on publicly available datasets ISIC 2017, ISIC 2018, and PH2 demonstrate that LCAUnet outperforms most state-of-the-art methods in metrics such as 1.31% improvement in Dice. The ablation studies also verify the effectiveness of the proposed fusion techniques.}
}
@article{ZHANG2026109048,
title = {Classification and recognition of brain tumors from MRI images based on improved YOLOv6},
journal = {Biomedical Signal Processing and Control},
volume = {113},
pages = {109048},
year = {2026},
issn = {1746-8094},
doi = {https://doi.org/10.1016/j.bspc.2025.109048},
url = {https://www.sciencedirect.com/science/article/pii/S1746809425015599},
author = {Hongkang Zhang and Shao-Lun Huang and Ercan Engin Kuruoglu},
keywords = {Brain tumor, MRI, Classification, YOLOv6, Transformer, Self-attention},
abstract = {Accurate automated categorization of brain tumors from MRI scans is crucial for clinical diagnosis but remains challenging due to minor inter-class variations, pronounced heterogeneity, and unbalanced class distributions. The study introduces BoT-YOLOv6, a hybrid model derived from YOLOv6 that integrates Bottleneck Transformer (BoT) units into the backbone, combining localized convolutional feature learning with global context representation based on self-attention. BoT modules are embedded within the final RepBlocks of stages C3, C4, and C5, and the system is trained with a class-weighted Binary Cross-Entropy objective to mitigate the effects of data imbalance. Extensive testing with stratified 5-fold cross-validation on the Kaggle Brain Tumor MRI collection reveals strong outcomes, achieving an average accuracy of 96.37% ± 0.99% and a macro-F1 of 96.21% ± 1.02%, which surpasses modern CNN, Transformer, and hybrid reference models (p<0.05). The framework also transfers effectively, obtaining 94.87% ± 1.29% accuracy and 94.92% ± 1.29% macro-F1 on the external Figshare dataset under a three-class protocol. Moreover, resilience to distributional shifts is verified through evaluation on BraTS 2021 glioma grading, where accuracy reaches 90.25% ± 1.44% and F1-score 90.03% ± 1.49%. With compact computational demands (3.6M parameters, 9.1 GFLOPs, and an inference delay of 7.1 ± 0.4 ms), the design sustains efficiency while providing interpretability via Grad-CAM++ visualizations that highlight alignment of model attention with clinically meaningful tumor regions such as cores and edema boundaries. These findings demonstrate the potential of transformer-enhanced hybrid architectures for accurate and efficient brain tumor recognition.}
}
@article{FENG2025165175,
title = {Fully self-powered flexible sensing system via coupled energy harvesting for adolescent skipping rope health monitoring},
journal = {Chemical Engineering Journal},
volume = {519},
pages = {165175},
year = {2025},
issn = {1385-8947},
doi = {https://doi.org/10.1016/j.cej.2025.165175},
url = {https://www.sciencedirect.com/science/article/pii/S1385894725060115},
author = {Qingyang Feng and Zihang Cheng and Hengzhi Guo and Yunlu Wang and Shuzheng Zou and Dongsheng Liu and Leo N.Y. Cao and Yupeng Mao and Chongle Zhao},
keywords = {Triboelectric nanogenerator, Fully self-powered, Silk fibroin, Sodium alginate, Coupled energy harvesting},
abstract = {Youth athletic development confronts three major challenges of infrastructure deficits, educational marginalization, and health disparities in resource-limited zones. These zones face inadequate sports infrastructure, inadequate funding for sports programs, a shortage of qualified teachers, and widespread malnutrition and health problems, all of which severely hamper the sporting potential of adolescents. To address these issues, skipping rope is highly suitable for promotion due to its low cost, easy accessibility, and multiple benefits. In this work, natural biomaterials (silk fibroin and sodium alginate) were combined with conductive sponge to develop a non-toxic, flexible, and recyclable self-powered triboelectric nanogenerator (SMP-TENG). The SMP-TENG exhibits stable electrical output (∼23–100 V) and converts low-frequency touch (∼6 Hz) to power commercial LEDs and hygrometers. The SMP-TENG system comprises SMP-TENG, TENG energy pack, wireless Bluetooth module, and upper computer system, monitoring adolescents' movement status during skipping rope in real-time. By analyzing data with support vector machine learning technology, the system achieves 95% accuracy in motion recognition. Integrating triboelectric nanogenerator technology with skipping rope addresses both energy supply and posture monitoring, improving adolescents' physical and mental health and promoting educational development in impoverished zones.}
}
@article{DOU2023129506,
title = {A framework for merging precipitation retrievals and gauge-based observations based on a novel concept namely virtual gauges},
journal = {Journal of Hydrology},
volume = {620},
pages = {129506},
year = {2023},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2023.129506},
url = {https://www.sciencedirect.com/science/article/pii/S0022169423004481},
author = {Yanhong Dou and Lei Ye and Jiaqi Ai and Chi Zhang and Huicheng Zhou},
keywords = {Precipitation merging, Gauge density, Rainfall field distribution, Virtual gauges, Multi-source precipitation products},
abstract = {The merging of multi-source precipitation retrievals (PRs) and gauge-based observations (GO) provides a new opportunity for precipitation field estimation. However, the uncertainties associated with PRs may become relatively more evident when the gauge network better captures the spatial distribution of the rainfall fields. To dynamically balance the utilisation of PRs, we propose a merging framework based on a novel concept; namely, the virtual gauge, where the grid cells utilising PRs are regarded as virtual gauges, and the framework is henceforth referred to as VG. The main steps were as follows: i) determine the locations of virtual gauges from multi-source PRs, ii) estimate rainfall at virtual gauges using a basic merging method, and iii) spatially interpolate using both actual and virtual gauges. Accordingly, the case study employed random forest and inverse distance weight as the basic merging and interpolation methods of VG. Evaluation using real world data over a region where nearly each 0.1° grid cell contains a ground gauge indicates that VG improves around 7–11% over its basic methods and improves around 32–240% over its inputting PRs. VG performed better and was more stable than the basic methods under various gauge densities, rainfall intensities, and rainfall distributions. The results showed that VG could supplement the spatial information of rainfall fields missed by the gauge network and reduce interference caused by the uncertainties of PRs. Overall, the framework integrates the advantages of existing merging and spatial interpolation methods by adjusting the number, locations, and rainfall estimations of virtual gauges.}
}
@article{GOPALAKRISHNAN2023133398,
title = {Electronic-free and low-cost wireless sensor tag for monitoring fish freshness},
journal = {Sensors and Actuators B: Chemical},
volume = {381},
pages = {133398},
year = {2023},
issn = {0925-4005},
doi = {https://doi.org/10.1016/j.snb.2023.133398},
url = {https://www.sciencedirect.com/science/article/pii/S0925400523001132},
author = {Sarath Gopalakrishnan and Sina Nejati and Sotoudeh Sedaghat and Krish Gupta and Rupesh Kumar Mishra and Rahim Rahimi},
keywords = {Laser processing, Paper-based sensors, Wireless passive sensors, Smart food packaging, Biosensor, Stimuli-responsive polymers},
abstract = {Real-time monitoring of fish products throughout the supply chain is critically important for proper tracking of fish quality and spoilage to eliminate food waste. However, most of the existing food freshness monitoring technologies are based on complex and costly sensors that lack specificity to direct biomarkers of product quality rendering them impractical for scalable low-cost production and integration into standard food packaging products. To address these issues, we present an electronic-free wireless sensor tag that can selectively monitor hypoxanthine (HX) as a specific biomarker to indicate the spoilage of fish products. The sensor tag is composed of a working and reference coil in a self-calibrating, dual-resonator configuration. The working coil is covered with a stimuli-responsive bilayer polymer structure that degrades only when high levels of HX are produced in spoiled fish products, resulting in a discernible change in the resonant characteristics of the coil. Detecting this change with respect to the reference antenna using a contactless external reader provides a differential mode of sensing to avoid environmental noise and enhance accuracy. The sensor fabrication process takes advantage of scalable and cost-effective manufacturing technologies including laser processing of metalized films and solution casting approaches. Systematic design of resonant coils and optimization of functional HX responsive coatings were performed to identify structures that provided the required spoilage detection threshold of (>2.25 mM HX) which is an indicator of fish spoilage in package products. As a proof of concept, the sensor tag’s performance was validated in a commercially packaged fish product, highlighting its ability to effectively differentiate spoiled products from fresh products in refrigerated conditions. The high selectivity exhibited by this technology puts forth a new platform that merges stimuli-responsive sensing with electronic-free wireless telemetry to develop biomarker-specific sensors for a wide range of intelligent food packaging applications.}
}