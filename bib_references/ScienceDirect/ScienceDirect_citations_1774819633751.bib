author = {Rituraj Buragohain and Hemanta Medhi and Kamal Uddin Ahamad},
keywords = {Lumped model, Hillslope process, Model complexity, Hypothesis testing},
abstract = {Necessity of considering multiple processes involved in runoff generation at sub-hourly time scale is investigated using a flexible, lumped model structure. Runoff generation processes at hillslope scale are conceptualized at various levels of complexity and the contribution of the hillslopes is routed through the stream network to obtain the discharge at the basin outlet. Runoff generation is modelled using four conceptual interconnected reservoirs representing an interception storage, a high permeability storage of topsoil, a soil matrix storage, and a ground water storage. Alternate model versions are derived by eliminating or merging one or more of these storage components and adopting linear and nonlinear variations of the relationships of evaporation, infiltration and drainage with the storage. Split sample validation of each model version in three test catchments showed the contribution of individual model hypotheses and the associated components. A few hypotheses were found to be insignificant while others were found to have varying degree of influence on the accuracy of model predictions. Model parameters for the dominant processes could be reliably calibrated and less significant parameters are found to suffer from non-uniqueness. Comparison between two slow-responding and one fast-responding catchment showed that the relatively complex versions of the model were able to produce greater accuracy in all three test catchments, while the simpler versions showed good performance only in the slow responding catchments, failing to capture the quicker hydrological dynamics. Additionally, the redundant or non-dominant components were not found to be detrimental to model performance by any significant measure, however, computational effort or cost may be a consideration when deciding between a simple vs complex model structure.}
}
@article{HUSSAIN20151366,
title = {Implementation of OGC Compliant Framework for Data Integration in Water Distribution System},
journal = {Procedia Engineering},
volume = {119},
pages = {1366-1374},
year = {2015},
note = {Computing and Control for the Water Industry (CCWI2015) Sharing the best practice in water management},
issn = {1877-7058},
doi = {https://doi.org/10.1016/j.proeng.2015.08.984},
