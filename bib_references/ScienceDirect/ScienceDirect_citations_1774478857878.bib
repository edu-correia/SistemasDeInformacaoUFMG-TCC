@article{LACASA2025127169,
title = {Towards certification: A complete statistical validation pipeline for supervised learning in industry},
journal = {Expert Systems with Applications},
volume = {277},
pages = {127169},
year = {2025},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2025.127169},
url = {https://www.sciencedirect.com/science/article/pii/S0957417425007912},
author = {Lucas Lacasa and Abel Pardo and Pablo Arbelo and Miguel Sánchez-Domínguez and Noelia Bascones and Pablo Yeste and Alejandro Martínez-Cava and Gonzalo Rubio and Ignacio Gómez and Eusebio Valero and Javier {de Vicente}},
keywords = {Surrogate model analysis, Supervised learning, Statistical validation, Aerospace certification, Structural design},
abstract = {Machine and Deep Learning methods are gradually being integrated into industrial operations, although at different speeds for different types of industries. The aerospace and aeronautical industries have been recently pushing to develop a roadmap for concepts of design assurance and integration of neural network-related technologies in the aeronautical sector. Within such a roadmap, there is currently no clear definition of what would constitute a certifiable validation protocol for an industrial surrogate model. This paper aims to bridge this gap and contribute to the paradigm of AI-based certification in the context of supervised learning, by proposing a practical and comprehensible validation pipeline of a surrogate model that integrates concepts and methods from deep learning, mathematical optimization and statistical data science. This pipeline is represented as a directed graph of ten logical steps/nodes, incorporating both linear-sequential procedures and feedback loops to iteratively refine the surrogate model. Each of these logical steps solves specific machine learning problems by merging previously scattered key statistical methods with some novel algorithmic solutions. We provide details and best practices for each of the steps and we illustrate the application of this pipeline in a realistic supervised problem arising in aerostructural design: predicting the likelihood of different stress-related failure modes during different flight maneuvers based on a (large) set of features characterizing the aircraft internal loads and geometric parameters.}
}
@article{WANG2025109904,
title = {Archaeobotanical insights on the change of subsistence from the Eastern Zhou to Han Dynasty: A case study of the Luojiaba site (Sichuan, China)},
journal = {Quaternary International},
volume = {744},
pages = {109904},
year = {2025},
issn = {1040-6182},
doi = {https://doi.org/10.1016/j.quaint.2025.109904},
url = {https://www.sciencedirect.com/science/article/pii/S1040618225002472},
author = {Xiaobin Wang and Weidong Chen and Luhong Zheng and Yu Dong},
keywords = {Bronze age, Archaeobotanical analysis, Southwestern China, Subsistence study, Peripheral area},
abstract = {Northeastern Sichuan, located in southwestern China, was an overlooked area in Chinese history compared to the Central Plains. It was the core region of the Ba State during the Eastern Zhou Dynasty until conquered by the Qin in 316 B.C. This region went through critical transformations from the Eastern Zhou Dynasty to the Han Dynasty. Studying the subsistence strategies of northeastern Sichuan can not only shed light on the living environment, diet, economy of Ba people, but also help us understand the transformations they underwent. The Luojiaba (罗家坝) site is the best-preserved and largest Ba settlement found so far in the region and provides us an invaluable opportunity to investigate the subsistence in this region. We systematically collected flotation samples from Luojiaba site during the excavations from 2020 to 2022. Our analysis results showed that foxtail millet was the main crop, along with broomcorn millet, rice, and a small amount of wheat and pulses; however, the proportion of wheat and rice increased notably from the Warring States to the Western Han Dynasty. By integrating evidence from the fauna assemblage and production tools, we infer that Luojiaba people mainly obtained food resources through farming and fishing, foraging and animal husbandry only serve as supplements. The subsistence pattern at Luojiaba is likely shaped by both the economic traditions of the Ba people and the expanded influence of the Qin and Han central governments. The current research provided critical evidence on the cultural history of Ba people and how it gradually merged into the Han culture.}
}
@article{NGUYEN2025111999,
title = {Containerized IEC 61850-based protection in smart grid – Lab demonstration and performance assessment for large scale deployment},
journal = {Electric Power Systems Research},
volume = {249},
pages = {111999},
year = {2025},
issn = {0378-7796},
doi = {https://doi.org/10.1016/j.epsr.2025.111999},
url = {https://www.sciencedirect.com/science/article/pii/S0378779625005905},
author = {Van Hoa Nguyen and Houda Abil and David Ramsey Herrera and Rémi Thomas and Thierry Coste},
keywords = {Virtualization, Containerization, Virtual IED, IEC 61850, Large-scale deployment, Communication bottleneck},
abstract = {This paper explores the applicability of containerization technology in electrical protection automation, particularly in a highly centralized context. The deployment of up to 400 virtual Intelligent Electronic Devices within a single server is demonstrated, and their performance is analyzed with respect to protection requirements in terms of determinism and rapidity. The potential communication bottlenecks related to sampled value streams from standalone merging units are also considered, along with their potential impacts on the virtual Intelligent Electronic Devices performance. The obtained experimental results highlight the potential of containerization for increased flexibility, scalability, and cost-effectiveness without compromising performance. While this represents a transformative shift in electrical grid protection, extra-technical aspects must be considered for the technology's adoption.}
}
@article{LIU2025127250,
title = {Review-enhanced contrastive learning on knowledge graphs for recommendation},
journal = {Expert Systems with Applications},
volume = {277},
pages = {127250},
year = {2025},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2025.127250},
url = {https://www.sciencedirect.com/science/article/pii/S0957417425008723},
author = {Yun Liu and Natthawut Kertkeidkachorn and Jun Miyazaki and Ryutaro Ichise},
keywords = {Recommender system, Knowledge graph, Graph neural networks, Contrastive learning},
abstract = {Knowledge graphs (KGs) have been shown to be effective in improving recommendation quality by introducing rich item properties as auxiliary information. The success of current KG-based recommender systems (RSs) lies in the capability of modeling high-quality item representations. This is achieved by identifying significant properties for items and exploring the intrinsic correlation between items on the KG. However, since current KG-based works only focus on learning user implicit knowledge from KGs through items, the limited user-item interaction behavior is still an obstacle to learning high-quality user representations. Furthermore, irrelevant connections in the KG may lead to erroneous messaging during the process of high-order graph feature learning of users and items. This could subsequently result in the inaccurate recommendation of items to users. To overcome above limitations, we propose a Review-enhanced Contrastive Learning on KGs (RCLKG) model for high-quality recommendation. We first construct a review-enhanced KG by exploring user explicit preferences in reviews with the extracted review entities. Then, we design a review-aware self-augmentation mechanism that seamlessly integrates explicit review knowledge with item-aligned KGs to discard irrelevant neighbor nodes of users and items. Furthermore, we develop a global-level graph aggregation schema with a refined constraint on the merged denoising KG to further optimize the denoising KG generation by considering high-order connections with less erroneous messaging. Finally, experimental results on the rating prediction and the click-through rate prediction (CTR) tasks with three real-word datasets demonstrate the superiority of our proposed RCLKG model in comparison with the state-of-the-art baselines.}
}
@article{ZHANG2025104324,
title = {Sustainable drying technologies for forage: A comprehensive review of research progress, strategies, opportunities, and future developments},
journal = {Sustainable Energy Technologies and Assessments},
volume = {77},
pages = {104324},
year = {2025},
issn = {2213-1388},
doi = {https://doi.org/10.1016/j.seta.2025.104324},
url = {https://www.sciencedirect.com/science/article/pii/S2213138825001559},
author = {Jun Zhang and Chen Cai and Cuiqiang Yan and Guanghui Wang},
keywords = {Forage drying, Sustainable drying technologies, Renewable energy, Energy-mass coupling optimization, Interdisciplinary system integration},
abstract = {Sustainable forage drying technology is crucial for maintaining nutritional quality, reducing post-harvest losses, and mitigating energy-environment trade-offs. This review systematically analyzes advancements in drying principles, technologies, and optimization strategies, including hybrid systems integrating renewable energy, data-driven process control, and pre-drying treatments, aiming to enhance efficiency and nutrient retention. We evaluate the efficacy, limitations, and applicability of various technologies and highlight innovative approaches such as solar-thermal hybrid systems, artificial intelligence-driven process control, and pre-drying interventions to improve drying uniformity and nutrient preservation. Additionally, challenges like high energy consumption, uneven drying, nutrient degradation, and economic barriers are assessed, with proposed solutions encompassing solar hybridization, adaptive sensor networks, and waste heat recovery. Emerging strategies emphasize interdisciplinary collaboration, merging advanced materials science, automation, and life cycle analysis to foster scalable and eco-friendly drying solutions. This review aims to provide strategic guidance for the future development of forage drying technologies, thereby promoting sustainable livestock farming and green innovation.}
}
@article{RILEY2025111058,
title = {O05 - EXAMINING STRUCTURAL RACISM AS A DRIVER OF TIMING OF ABORTION CARE IN WASHINGTON},
journal = {Contraception},
volume = {151},
pages = {111058},
year = {2025},
issn = {0010-7824},
doi = {https://doi.org/10.1016/j.contraception.2025.111058},
url = {https://www.sciencedirect.com/science/article/pii/S0010782425002495},
author = {T Riley and A Hassan and A Khattar and L Benson},
abstract = {Objectives
We aimed to examine structural racism as a determinant of abortion timing and delays to care, and how this might be changing after Dobbs v Jackson Women’s Health Organization.
Methods
Data included all abortions performed at a high-volume reproductive healthcare clinic network in Washington state from January 1, 2017, to July 31, 2023 (n=18,331). We used the American Community Survey to calculate the index of concentration at the extremes (ICE), a proxy measure of structural racism that captures racialized economic spatial polarization. ICE scores, ranging from - 1 to 1, were categorized into quintiles (quintile 1: most marginalized to quintile 5: most privileged), and then merged into the clinical data by patient zip code. Generalized linear models estimated the association between structural racism and gestational duration (days) and time from calling the clinic to abortion appointment (days).
Results
A higher proportion of individuals in the most privileged ICE quintile had private insurance, received a medication abortion, and had a fetal indication (eg, genetic abnormalities) compared to those in the most marginalized ICE quintile. Individuals in the most privileged ICE quintile received their abortion, on average, 10 days (95% CI, -13, -7) earlier in gestation and had a shorter time to appointment (-1.7 days, 95% CI: -2.2, -1.1) than those in the most marginalized ICE quintile. This relationship stayed consistent across pre-and-post Dobbs time periods.
Conclusions
Racially and economically segregated communities experience greater delays to abortion care both before and after the Dobbs decision.}
}
@article{PAN2025111034,
title = {Three-way decision-based label integration for crowdsourcing},
journal = {Pattern Recognition},
volume = {158},
pages = {111034},
year = {2025},
issn = {0031-3203},
doi = {https://doi.org/10.1016/j.patcog.2024.111034},
url = {https://www.sciencedirect.com/science/article/pii/S0031320324007854},
author = {Can Pan and Liangxiao Jiang and Chaoqun Li},
keywords = {Crowdsourcing, Label integration, Three-way decision},
abstract = {In crowdsourcing learning, label integration is often used to infer instances’ integrated labels from their multiple noisy labels. However, almost all existing label integration algorithms apply the same strategy to infer different instances’ integrated labels, which limits their performance. This paper argues that different instances should enjoy different label integration strategies alone. Thanks to the three-way decision theory, a three-way decision-based label integration (TDLI) algorithm is proposed. In TDLI, we at first evaluate the label qualities of each instance and its K-nearest neighbors, and then utilize them to divide the whole crowdsourced datasets into three disjoint subsets, called positive set, boundary set and negative set, respectively. For each instance in the positive set, we directly apply the simplest majority voting (MV) to infer its integrated label. For each instance in the boundary set, we absorb its K-nearest neighbors’ multiple noisy labels to infer its integrated label by the weighted MV. For each instance in the negative set, we merge the positive and boundary sets to train a classifier to infer its integrated label by fusing its own multiple noisy label distribution and the predicted label distribution. Extensive experiments demonstrate that TDLI distinctly outperforms all the other existing label integration algorithms used to compare.}
}
@article{XU2026109412,
title = {High sensitivity fiber MZI strain sensor with low temperature crosstalk},
journal = {Optics and Lasers in Engineering},
volume = {196},
pages = {109412},
year = {2026},
issn = {0143-8166},
doi = {https://doi.org/10.1016/j.optlaseng.2025.109412},
url = {https://www.sciencedirect.com/science/article/pii/S0143816625005974},
author = {Chenyu Xu and Chunlan Liu and Yong Wei and Chao Guo and Zhihai Liu},
keywords = {High sensitivity strain sensor grating, Low temperature crosstalk, Length of the sensing area, N-type fiber core structure},
abstract = {The current Mach Zehnder (MZI) fiber strain sensors increase strain sensitivity while also increasing temperature sensitivity, thereby increasing the impact of temperature crosstalk on strain detection. To solve this problem, this article proposes a high-sensitivity and low temperature crosstalk fiber MZI strain sensor. By using a carbon dioxide laser to etch a long groove on the cladding of a single-mode fiber, and then heating the long groove area, a fiber MZI strain sensor with an n-type core structure is fabricated. When the sensor is subjected to axial strain, the offset distance of the fiber core from the axis gradually decreases with the increase of stress, resulting in the positions of the beam splitting and merging points of the transmitted light gradually approaching each other, and the length of the sensing area decreases. By significantly changing the change in the length of the sensing area, high-sensitivity and low-temperature crosstalk fiber MZI strain sensing can be achieved. The experimental results indicate that the strain sensitivity of the sensor is as high as -49.88 pm/με, and the temperature strain cross sensitivity is only 0.676 με/ °C. This article provides a new method for reducing temperature crosstalk by changing the length of the sensing area during the strain process to achieve strain sensitization without increasing temperature sensitivity. It is expected to be applied in fields such as high-speed rail tracks and oil and gas pipelines.}
}
@article{LI2023772,
title = {Reliability analysis for vertical integration of protection, measurement, merge unit, and intelligent terminal device},
journal = {Global Energy Interconnection},
volume = {6},
number = {6},
pages = {772-784},
year = {2023},
issn = {2096-5117},
doi = {https://doi.org/10.1016/j.gloei.2023.11.010},
url = {https://www.sciencedirect.com/science/article/pii/S2096511723001019},
author = {Ying Li and Weiquan Wang and Liang Zhang and Zhujian Liang and Zhenli Xu and Yuansheng Liang},
keywords = {Vertical integration of secondary system device, Reliability of secondary system, IEC 61850-based substation, Relay protection},
abstract = {The reliability analysis of vertically integrated protection devices is crucial for designing International Electrotechnical Commission (IEC) 61850-based substations. This paper presents the hardware architecture of a four-in- one vertically integrated device and the information transmission path of each function based on the functional information transmission chain of protection devices, measurement and control devices, merging units, and intelligent terminals. Additionally, a reliability analysis model of the protection device and its protection system is constructed using the fault tree analysis method while considering the characteristics of each module of the vertically integrated device. The stability probability of the protection system in each state is analyzed by combining the state-transfer equations of line and busbar protection with a Markov chain. Finally, the failure rate and availability of the protection device and its protection system are calculated under different ambient temperatures using a 110 kV intelligent substation as an example. The sensitivity of each device module is analyzed.}
}