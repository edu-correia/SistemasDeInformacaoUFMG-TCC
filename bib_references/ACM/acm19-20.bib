editor = {Patricia Derler, Klaus Schneider and Jean-Pierre Talpin},
title = {Guest Editorial: Special Issue of ACM TECS on the ACM-IEEE International Conference on Formal Methods and Models for System Design (MEMOCODE 2017)},
