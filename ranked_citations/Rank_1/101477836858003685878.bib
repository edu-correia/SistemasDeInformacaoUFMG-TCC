@article{10.14778/3685800.3685878,
 abstract = {We demonstrate Rock, a system for cleaning relational data. Rock highlights the following unique features: (1) it extends logic rules by embedding machine learning models as predicates, to benefit from both ML and logic deduction; (2) it supports entity resolution, conflict resolution, timeliness deduction and missing data imputation in a unified process; and (3) it provides parallelly scalable algorithms for rule discovery, error detection and error correction, in batch and incremental modes. We will demonstrate Rock for its (a) easy-to-use interface, (b) scalability when cleaning large datasets, (c) accuracy for detecting and correcting errors across multiple tables, and (d) applications at banks and HR departments.},
 author = {Bao, Zian and Bie, Binbin and Fan, Wenfei and Li, Daji and Li, Mengyun and Lin, Kaiwen and Lin, Wei and Liu, Peijie and Liu, Peng and Lv, Zhicong and Ouyang, Mingliang and Sun, Chenyang and Tang, Shuai and Wang, Yaoshu and Wei, Qiyuan and Wu, Xiangqian and Xie, Min and Zhang, Jing and Zhao, Runxiao and Zhu, Jie and Zhu, Yilin},
 doi = {10.14778/3685800.3685878},
 issn = {2150-8097},
 issue_date = {August 2024},
 journal = {Proc. VLDB Endow.},
 month = {August},
 number = {12},
 numpages = {4},
 pages = {4373–4376},
 publisher = {VLDB Endowment},
 title = {Rock: Cleaning Data with both ML and Logic Rules},
 url = {https://doi.org/10.14778/3685800.3685878},
 volume = {17},
 year = {2024}
}
