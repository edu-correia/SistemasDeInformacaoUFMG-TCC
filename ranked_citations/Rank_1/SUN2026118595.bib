@article{SUN2026118595,
 abstract = {Magnetic particle imaging (MPI) is an innovative medical imaging modality that allows for quantitative visualization of magnetic nanoparticles (MNPs). In this work, we develop a mixing-frequency MPI scanner that uses coprime orthogonal drive fields at 4.98  kHz and 97  Hz to realize a dense, non–uniform 2D Lissajous scanning of the field–free point (FFP). The high- and low-frequency AC magnetic fields drive the MNPs to generate high-order harmonics and their mixing-frequency components. All the mixing-frequency spectra of the MNPs are measured for image reconstruction. Compared to conventional Lissajous sequences, this design reduces the hardware complexity in the drive chain since no decoupling networks are required. Additionally, only one single band–pass filter and impedance matching are needed in the high–frequency transmit side. Phantom experiments are performed to demonstrate the feasibility of the developed mixing-frequency MPI scanner for the visualization of MNPs. Experimental results show that the designed cost–effective MPI scanner achieves an imaging speed of 1 frame per second, a spatial resolution of better than 1.5  mm at gradients of 0.64  T/m and 1.28  T/m in x- and y-direction. The experiments with a series of MNPs with different iron concentration indicate that the scanner achieves a limit of detection of 34.9  µmol/L Fe (195  ng Fe) using synomag–D Plain (hydrodynamic diameter 70 nm) MNPs.},
 author = {Shaoqi Sun and Shijie Sun and Yongyan Wang and Penghui Wang and Rong Cai and Wenzhong Liu and Lijun Xu and Jing Zhong},
 doi = {https://doi.org/10.1016/j.measurement.2025.118595},
 issn = {0263-2241},
 journal = {Measurement},
 keyword = {Magnetic particle imaging, Magnetic nanoparticle, Mixing-frequency spectra, Cost–effective},
 pages = {118595},
 title = {A cost-effective magnetic particle imaging scanner based on mixing-frequency spectra},
 url = {https://www.sciencedirect.com/science/article/pii/S0263224125019542},
 volume = {257},
 year = {2026}
}
