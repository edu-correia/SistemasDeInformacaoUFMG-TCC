@conference{Shen2013,
 abstract = {Heterogeneous platforms integrating different processors like GPUs and multi-core CPUs become popular in high performance computing. While most applications are currently using the homogeneous parts of these platforms, we argue that there is a large class of applications that can benefit from their heterogeneity: massively parallel imbalanced applications. Such applications emerge, for example, from variable time step based numerical methods and simulations. In this paper, we present Glinda, a framework for accelerating imbalanced applications on heterogeneous computing platforms. Our framework is able to correctly detect the application workload characteristics, make choices based on the available parallel solutions and hardware configuration, and automatically obtain the optimal workload decomposition and distribution. Our experiments on parallelizing a heavily imbalanced acoustic ray tracing application show that Glinda improves application performance in multiple scenarios, achieving up to 12× speedup against manually configured parallel solutions. Copyright 2013 ACM.},
 author = {Shen, Jie and Varbanescu, Ana Lucia and Arntzen, Michael and Simons, Dick G.},
 doi = {10.1145/2482767.2482785},
 journal = {Proceedings of the ACM International Conference on Computing Frontiers, CF 2013},
 note = {Cited by: 21},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Glinda: A framework for accelerating imbalanced applications on heterogeneous platforms},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84879527970?origin=resultslist},
 year = {2013}
}
