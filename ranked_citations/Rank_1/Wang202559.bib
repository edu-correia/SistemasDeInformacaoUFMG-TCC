@conference{Wang202559,
 abstract = {Liver tumour edges are fuzzy and difficult to distinguish, making it challenging to clearly define the boundary. The traditional deep learning-based liver tumour segmentation method has limited segmentation accuracy due to its inability to comprehensively extract the tumour’s feature information. In this paper, we propose a liver tumor segmentation approach based on Global and Local Information Cross-Fusion Attention(GLCFA). Firstly, a bi-feature extractor module(BEM) is designed, which introduces dilated convolution combined with transformer to extract global features. At the same time, a CNN-based gated convolution block is designed to extract local features. Secondly, a bi-feature cross fusion module(BCFM) is proposed to cross-merge global and local information. This module adopts feature grouping and cross-splicing strategies, and then utilizes a channel global and local convolutional attention mechanism to dynamically calculate their feature importance weight coefficients, thereby effectively fusing the tumour features. Finally, a U-shaped segmentation architecture is employed to complete liver tumour segmentation. The proposed method is evaluated on the LITS2017 dataset and the 3DIRCADb-01 dataset, with the Dice coefficients improved by 3.54% and 5.35%, respectively. This proves the superiority of the method in segmenting liver tumours with ambiguous boundaries and is expected to provide a quantitative basis for accurate diagnosis of liver tumours. © 2024 Copyright held by the owner/author(s).},
 author = {Wang, Ge and Jiang, Huiqin and Ma, Ling and Yang, Lei and Gao, Jianbo and Jiang, Yaojun},
 doi = {10.1145/3706890.3706900},
 journal = {Proceedings of 2024 5th International Symposium on Artificial Intelligence for Medicine Science, ISAIMS 2024},
 note = {Cited by: 1},
 pages = {59 - 65},
 publication_stage = {Final},
 source = {Scopus},
 title = {GLCFANet: Liver Tumor Segmentation with Global and Local Information Cross-Fusion Attention},
 type = {Conference paper},
