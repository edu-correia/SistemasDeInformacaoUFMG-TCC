@inproceedings{1688793,
 abstract = {Dynamic BDD reordering is usually a computationally-demanding process, and may slow down BDD-based applications. We propose a novel algorithm for distributing this process over a number of computers, improving both reordering time and application time. Our algorithm is based on Rudell's popular sifting algorithm, and takes advantage of a few empirical observations we make regarding Rudell's algorithm. Experimental results show the efficiency and scalability of our approach, when applied within an industrial model checker.},
 author = {Nevo, Z. and Farkash, M.},
 booktitle = {2006 43rd ACM/IEEE Design Automation Conference},
 doi = {10.1145/1146909.1146969},
 issn = {0738-100X},
 keyword = {Binary decision diagrams;Data structures;Boolean functions;Application software;Distributed computing;Design automation;Runtime;Computer applications;Heuristic algorithms;Scalability;Algorithms;Performance;Experimentation;Verification;Model checking;BDD;reordering;distributed computing},
 month = {July},
 number = {},
 pages = {223-228},
 title = {Distributed dynamic BDD reordering},
 volume = {},
 year = {2006}
}
