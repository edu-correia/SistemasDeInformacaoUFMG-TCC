@inproceedings{11366980,
 abstract = {In a world where decentralized trust and data integrity are essential, it is very important to protect secure and verifiable digital records. This work aims to enhance authentication, traceability, and access control of decentralized records through the proposal of a cryptographic framework: Self-Keyed Verifiable Record Authentication (SKVRA). SKVRA merges the features of self-signed key cryptography with blockchain technology to facilitate Decentralized Identifiers (DIDs), secure off-chain storage, and Verifiable Credentials (VCs) for access control. The proposed algorithm makes sure that each digital record is hashed, signed, and linked to a metadata package anchored by a DID. The Blockchain keeps an unchangeable record of these links. Encrypted records are stored off-chain using IPFS to keep data private while still being able to be checked. SKVRA calculates trust scores through peer-to-peer attestations and keeps a version history using Merkle tree audit trails. Empirical evidence showed that the proposed method outperformed the venerated state-of-the-art methods. It showed 0.28 seconds of latency with a throughput of $3,988.57$ records per second and an average time of 0.08 milliseconds for the creation of a DID. It also showed a VC verification accuracy of 90.54% and a Content Identifier (CID) retrieval success of $\mathbf{9 4. 5 9 \%}$. In essence, SKVRA manages to provide a robust and adaptable structure for the handling of digitized records on a distributed ledger. It suits highly trust and integrity-dependent fields like, but not limited to, healthcare, education, and legal records.},
 author = {Maheshwari, Pawan and Gupta, Sunil},
 booktitle = {2025 6th International Conference on Communication, Computing & Industry 6.0 (C2I6)},
 doi = {10.1109/C2I666499.2025.11366980},
 issn = {},
