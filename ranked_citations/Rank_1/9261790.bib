@inproceedings{9261790,
 abstract = {Data hiding technique is the process of anti-computer forensic for making the data difficult to accessible. Steganography is merging texts, files, or other multimedia files within another texts, files, or other multimedia files to reduce the visible attack and it is an approach of data hiding technique. Cryptography is changing the readable text to illegible information. This paper presents about secure communication media which is used in transferring text, multimedia or relevant digital file between sender and receiver securely. To have securing communication media, the media required to reduce the possible threats and vulnerabilities. Therefore, transferred media is main thing to consideration for having communication system firmly. Data hiding techniques are used to improve the security of communication media using salt encryption. This paper is proposed the methodology to develop the secure communication media using combination of cryptography and steganography techniques by describing experimental results from difference technical analysis.},
 author = {Oo, Bo Bo and Aung, May Thu},
 booktitle = {2020 International Conference on Advanced Information Technologies (ICAIT)},
