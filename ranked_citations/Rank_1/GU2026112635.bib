@article{GU2026112635,
 abstract = {ABSTRACT
The pursuit of high-performance energy-storage systems has driven intensive efforts to develop rechargeable batteries with higher energy density, faster charge–discharge capability, and longer cycle life. Conversion- and alloy-type electrode materials have therefore garnered considerable attention owing to their substantially higher theoretical capacities relative to conventional intercalation-type materials. However, their multi-electron reaction pathways are intrinsically associated with sluggish kinetics and poor electrochemical reversibility, severely hindering their practical performance. Recently, electrocatalysis has emerged as a key solution to address these challenges by accelerating reaction kinetics, enhancing reaction reversibility, and improving cycling stability. Beyond electrode reactions, it can also lower electrolyte desolvation energy barriers and stabilize electrode-electrolyte interfaces to maximize overall battery efficiency. Herein, we present an overview of recent progress on merging catalysis into rechargeable batteries. We first examine catalytic regulations at cathodes to accelerate electrode redox reactions, followed by emerging catalytic phenomena at anodes that enhance electrochemical reversibility. We then highlight the critical role of catalysis at electrode-electrolyte interfaces in governing solid electrolyte interphase formation, lowering desolvation energy barriers, and regulating electrode reaction pathways. Finally, a short review is offered about the possible future directions of how to make better use of catalysis in rechargeable batteries.},
 author = {Xinyu Gu and Yifan Jiang and Rongrong Wu and Chenxin Cai and Yawen Tang and Peng Xiao and Hualin Ye},
 doi = {https://doi.org/10.1016/j.cclet.2026.112635},
 issn = {1001-8417},
 journal = {Chinese Chemical Letters},
 keyword = {Electrocatalysis, Reaction kinetics, Multi-electron reactions, Electrode-electrolyte interfaces, Rechargeable batteries},
 pages = {112635},
 title = {Emerging opportunities and advances in integrating catalysis into rechargeable batteries},
 url = {https://www.sciencedirect.com/science/article/pii/S1001841726002780},
 year = {2026}
}
