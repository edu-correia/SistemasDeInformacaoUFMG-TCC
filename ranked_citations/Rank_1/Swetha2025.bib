@conference{Swetha2025,
 abstract = {Modern infrastructure relies heavily on CyberPhysical Systems (CPS), which merge computing capabilities with real-world physical operations in domains such as healthcare, energy, industry, and transportation. The increasing interconnection among these systems exposes them to diverse and advanced forms of cyber threats. Ensuring the security of CPS is critical to maintaining system reliability, data privacy and real-time operational safety. This study compiles and analyzes recent developments in cyber-attack detection strategies for CyberPhysical Systems (CPS), with particular emphasis on approaches based on Machine Learning (ML), Deep Learning (DL), and Federated Learning (FL). The review covers research contributions published between 2021 and 2024, sourced from prominent academic repositories. The findings indicate that while ML and DL models offer effective detection mechanisms, Federated Learning stands out by achieving high detection accuracy while preserving data privacy across distributed environments. This review outlines prominent algorithms, benchmark datasets, and evaluation metrics, concluding with unresolved issues and future research pathways in securing cyber-physical systems. © 2025 IEEE.},
 author = {Swetha, C.B. and Shelke, Chetan J. and Mano Paul, P.},
 doi = {10.1109/DECoN67170.2025.11447924},
 journal = {IC-DECON 2025 - 2025 International Conference on Data, Energy and Communication Network, Proceedings},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Federated Learning for Cyber-Physical System Security: A Survey on AI-Based Threat Detection Techniques},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105037320514?origin=resultslist},
 year = {2025}
}
