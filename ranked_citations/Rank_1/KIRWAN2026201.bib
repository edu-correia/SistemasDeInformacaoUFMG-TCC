@incollection{KIRWAN2026201,
 abstract = {The idea of the Smart City has moved beyond promotional rhetoric into a genuine transformation at the intersection of the physical and digital worlds, marking both an economic opportunity and a systems-level challenge. This evolution demands adaptable and inclusive business models that integrate natural, human, and technological systems to slow global entropy while enhancing collective well-being. Emerging frameworks grounded in commons-based economics, planetary accounting, and distributed technologies such as blockchain and holochain enable transparent and equitable exchanges across public–private–people partnerships, fostering “glocally” balanced ecosystems that merge sustainability with innovation. Within this continuum, the concept of Flow—as expressed through the intelligent orchestration of smart city operating systems—embodies the synthesis of collective intelligence, resource optimization, and purposeful technological evolution toward a more resilient and enlightened urban future.},
 author = {Christopher Grant Kirwan and Fu Zhiyong},
 booktitle = {Smart Cities and Artificial Intelligence (Second Edition)},
 doi = {https://doi.org/10.1016/B978-0-443-23621-1.00004-7},
 edition = {Second Edition},
 editor = {Christopher Grant Kirwan and Fu Zhiyong},
 isbn = {978-0-443-23621-1},
 keyword = {Blockchain, Circular data economy, Commons-based economics, Crowdfunding, Crowdsourcing, Cryptocurrency, Digital value chains, ESG, Ethical investment, Flow theory, Holochain, Innovation, IP, Living lab, Peer-to-peer, Planetary accounting, Public–private partnerships},
 pages = {201-223},
 publisher = {Elsevier},
 series = {Smart Cities},
 title = {Chapter 9 - Smart city business models},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443236211000047},
