@conference{Fan2025265,
 abstract = {This study aims to enhance entity relationship extraction in the power field to improve knowledge management, predictive maintenance, and fault diagnosis. The paper proposes a document-level relationship extraction method using large language models (LLMs) to identify relationships between new and known entities in power standard knowledge documents. It generates documents through prompt chains, extracts relationship evidence, and constructs an entity relationship graph. The LLM is fine-Tuned with historical power data to build a comparative knowledge graph, and a consistency denoising method is used to merge and clarify the graphs. Experiments on a Chinese power knowledge dataset show that the method effectively extracts accurate entity relationships, especially between new and known entities. This approach improves the precision of relationship extraction, offering both theoretical and practical benefits for managing and utilizing power knowledge. © 2025 IEEE.},
 author = {Fan, Xiaoxuan and An, Ningyu and Liang, Xiao and Wang, Xiaohui and Wang, Zhihao and Fei, Bin},
 doi = {10.1109/ICBASE66587.2025.11181287},
 journal = {2025 6th International Conference on Big Data and Artificial Intelligence and Software Engineering, ICBASE 2025},
 note = {Cited by: 1},
 pages = {265 - 272},
