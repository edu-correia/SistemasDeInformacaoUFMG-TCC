@inproceedings{11417583,
 abstract = {In the cutting-edge video coding standard Versatile Video Coding, affine merge mode has been integrated to precisely represent non-linear motion, which could account for rotational and zoom in/out simultaneously besides translational motion of objects. In recent studies, chained motion vector prediction (CMVP) has been incorporated into the regular merge mode, which offers a novel methodology for generating new merge candidates by accumulating the recursively tracked motion vectors or block vectors with prederived candidates. This paper advocates for the application of CMVP for constructing affine merge candidates to improve the diversity of affine merge lists. For each control point of an affine block, a new motion vector is obtained by accumulating the original motion vector with the traced motion vectors or block vectors. Experimental results indicate that the proposed method attains overall $0.11 \%$ luma gains with only minor complexity increases on version 15 of the Enhanced Compression Model, a common software for exploring coding techniques beyond Versatile Video Coding.},
 author = {Li, Chen and Liao, Ru-Ling and Chen, Jie and Ye, Yan and Li, Xi},
 booktitle = {2025 Picture Coding Symposium (PCS)},
 doi = {10.1109/PCS65673.2025.11417583},
 issn = {2472-7822},
 keyword = {Video coding;Adaptation models;Tracking;Predictive models;Vectors;Encoding;Software;Motion compensation;Complexity theory;Standards;Affine Motion Compensation;Chained Motion Vector Prediction;Enhanced Compression Model},
 month = {Dec},
 number = {},
 pages = {1-5},
 title = {Chained Motion Vector Prediction for Constructing Affine Candidates},
 volume = {},
 year = {2025}
}
