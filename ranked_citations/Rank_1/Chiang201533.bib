@article{Chiang201533,
 abstract = {Numerical programs usually include type-casting instructions which convert data among different types. Identifying unsafe type-casting is important for preventing undefined program behaviors which cause serious problems such as security vulnerabilities and result non-reproducibility. While many tools had been proposed for handling sequential programs, to our best knowledge, there isn't a tool geared toward GPUS. In this paper, we propose a static analysis based method which points out all potentially unsafe type-casting instructions in a program. To reduce false alarms (which are commonly raised by static analysis), we employ two techniques, manual hints and pre-defined function contracts, and we empirically show that these techniques are effective in practice. We evaluated our method with artificial programs and samples from CUDA SDK. Our implementation is currently being integrated into a GPU program analysis framework called GKLEE. We plan to integrate dynamic unsafe type-casting checks also in our future work. © 2015 The Authors. Published by Elsevier B.V.},
 author = {Chiang, Wei-Fan and Gopalakrishnan, Ganesh and Rakamarić, Zvonimir},
 doi = {10.1016/j.entcs.2015.10.005},
 journal = {Electronic Notes in Theoretical Computer Science},
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 pages = {33 - 45},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unsafe Floating-point to Unsigned Integer Casting Check for GPU Programs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84960127425?origin=resultslist},
 volume = {317},
 year = {2015}
}
