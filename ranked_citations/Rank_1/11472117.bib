@inproceedings{11472117,
 abstract = {Clustering in wireless sensor networks (WSNs) is a process designed to group sensors into clusters, thereby minimizing energy consumption, extending network lifetime, and reducing redundant data collection in areas with densely packed sensors. Several protocols, including LEACH, FEECS, CHEF, and k-means, have been developed to optimize this clustering process. These protocols vary in their approach to determining the number of clusters, with some choosing randomly and others allowing user specification based on network requirements. The DBSCAN algorithm, a machine learning technique, determines the number of clusters based on the data point structure, which can significantly impact cluster formation. This paper presents a comparative analysis of DBSCAN variants for cluster formation in wireless sensor networks (WSN). Experimental results show that DBSCAN and its variants exhibited similar performance, with slight variations in the rate of decline in the number of live nodes. DBSCAN-L achieved the best performance when the sink was located at the center of the network, while HDBSCAN demonstrated better performance when the sink was located at the edge or outside the network.},
 author = {Fatima, Harrouz and Mohammed, Omari and Mohammed, Kaddi},
 booktitle = {2025 5th International Conference on Electrical, Computer and Energy Technologies (ICECET)},
 doi = {10.1109/ICECET63943.2025.11472117},
 issn = {},
 keyword = {Broadcasting;Broadcast technology;Filtering;Filters;Communication systems;Internet of Things;Protocols;Wireless sensor networks;Routing;Routing protocols;Wireless sensor networks;Clustering;DBSCAN;Lifetime extension;Energy optimization},
 month = {July},
 number = {},
 pages = {1-7},
 title = {Comparative Analysis of DBSCAN Variants for Energy-Efficient Clustering in Wireless Sensor Networks},
 volume = {},
 year = {2025}
}
