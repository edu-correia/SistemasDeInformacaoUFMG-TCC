@conference{Karmokar2022114,
 abstract = {This paper presents an overview of common-centroid (CC) layout styles, used in analog designs to overcome the impact of systematic variations. CC layouts must be carefully engineered to minimize the impact of mismatch. Algorithms for CC layout must be aware of routing parasitics, layout-dependent effects (for active devices), and the performance impact of layout choices. The optimal CC layout further depends on factors such as the choice of the unit device and the relative impact of uncorrelated and systematic variations. The paper also examines scenarios where non-CC layouts may be preferable to CC layouts.  © 2022 IEEE.},
 author = {Karmokar, Nibedita and Madhusudan, Meghna and Sharma, Arvind K. and Harjani, Ramesh and Lin, Mark Po-Hung and Sapatnekar, Sachin S.},
 doi = {10.1109/ASP-DAC52403.2022.9712576},
 journal = {Proceedings of the Asia and South Pacific Design Automation Conference, ASP-DAC},
 note = {Cited by: 20},
 pages = {114 - 121},
 publication_stage = {Final},
 source = {Scopus},
 title = {Common-Centroid Layout for Active and Passive Devices: A Review and the Road Ahead},
 type = {Conference paper},
