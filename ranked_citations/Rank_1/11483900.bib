@inproceedings{11483900,
 abstract = {The problem of restoring clear visibility from a single hazy image continues to poses a major challenge in computer vision. Atmospheric scattering and light absorption caused by suspended particles often leads to the loss of contrast, color distortions, and the disappearance of fine textures. Although several deep learning models has been proposed, most of them operates purely in the spatial domain and therefore struggle to recover the high-frequency details that are being suppressed during haze formation. To address this issue, we propose FreqSpatial GAN-a Dual-Domain Frequency-Spatial Generative Adversarial Network that combines pixel-level reconstruction with spectral-domain reasoning in an unified framework. The architecture contains two cooperative generators: one dedicated for spatial recovery of structure and illumination, and another that reconstruct amplitude-phase features within the Fourier domain. These outputs are adaptively merged using a domain-alignment fusion mechanism, while two discriminators jointly enforces perceptual realism and spectral consistency. Extensive evaluations conducted on benchmarks, including RESIDE, SOTS-Out, I-HAZE, O-HAZE, D-HAZY, and NH-HAZE, demonstrates that Freq-Spatial GAN consistently produce clearer and more natural results compared to the existing methods. The framework restores edges and textures effectively, maintains physical plausibilities, and generalizes well across both synthetic and real-world haze conditions.},
 author = {Mishra, Sarthak and Dwivedi, Pulkit},
 booktitle = {2026 International Conference on Machine Learning and Autonomous Systems (ICMLAS)},
 doi = {10.1109/ICMLAS67792.2026.11483900},
 issn = {},
 keyword = {High frequency;Pixel;Protocols;Radio access networks;Regional area networks;HTTP;Telecommunications;Indoor environment;Videos;Digital images;Single Image Dehazing;Generative Adversarial Networks;Frequency–Spatial Domain Learning;Spectral Consistency;Dual-Discriminator Framework},
 month = {March},
 number = {},
 pages = {67-72},
 title = {Freq-Spatial GAN: Dual-Domain Frequency–Spatial GAN for Physically Consistent Single Image Dehazing},
 volume = {},
