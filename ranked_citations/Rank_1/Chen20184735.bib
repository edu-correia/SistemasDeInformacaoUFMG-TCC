@article{Chen20184735,
 abstract = {High-efficiency video coding encoders provide great improvements in coding efficiency and can also support higher resolution and multiple coding tools. The new coding structures such as coding unit (CU) and prediction unit (PU) have helped a lot, but the computational complexity is much higher than those of previous standards. This paper proposes a fast algorithm combining with CU and PU early termination decisions to reduce computational demand. Based on the analytic results, we can set up an adaptive threshold that can be obtained for early termination. Meanwhile, we also develop an adaptive search range determination according to the motion vector (MV). Compared with HM 12.0, our proposed method achieves an approximate 57% time saving, whereas the average Bjontegaard-Delta Bit-rate (BDBR) increase is only 0.43%. In addition, our fast algorithm outperforms the previous works in both coding speed and coding performance. © 2017 IEEE.},
 author = {Chen, Mei-Juan and Wu, Yu-De and Yeh, Chia-Hung and Lin, Kao-Min and Lin, Shinfeng D.},
 doi = {10.1109/TII.2018.2801852},
 journal = {IEEE Transactions on Industrial Informatics},
 note = {Cited by: 24; All Open Access; Bronze Open Access},
 number = {11},
 pages = {4735 - 4745},
 publication_stage = {Final},
 source = {Scopus},
 title = {Efficient CU and PU Decision Based on Motion Information for Interprediction of HEVC},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85041541400?origin=resultslist},
 volume = {14},
 year = {2018}
}
