@article{Essallami2026111,
 abstract = {The world is facing a significant challenge in terms of water stress, and water desalination using renewable energy is considered an effective solution that contributes to enhancing water security for countries and achieving sustainable development goals. Therefore, this study was conducted to provide a comprehensive review of scientific articles on this topic through bibliometric analysis. The “Scopus” database was used as a reference for the studied and highly cited research topics, along with the use of VOSviewer software and R software, specifically the Biblioshiny library, to present an integrated and comprehensive view of the studied topic in the form of scientific maps. In this context, the study period was set to ten years, from 2013 to 2023, and English was adopted as the primary language for the research. As a result of this study, 1629 publications were identified. The findings revealed that the United States, China, and Iran are the leading countries in terms of the number of citations. Moreover, the study identified the most commonly used keywords and the most productive journals, providing a deeper understanding of the current state of this topic and the potential for its development by interested parties in the future. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
 author = {Essallami, Ngueya and Khouya, Ahmed},
 doi = {10.1007/978-3-032-01536-5_17},
 journal = {Lecture Notes in Networks and Systems},
 note = {Cited by: 0},
 pages = {111 - 116},
 publication_stage = {Final},
 source = {Scopus},
 title = {Desalination Based on Renewable Energy: A Bibliometric Analysis},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105020251488?origin=resultslist},
 volume = {1584 LNNS},
 year = {2026}
}
