@article{Piasecki2014336,
 abstract = {A corpus-based Measure of Semantic Relatedness can be calculated for every pair of words occurring in the corpus, but it can produce erroneous results for many word pairs due to accidental associations derived on the basis of several context features. We propose a novel idea of a partial measure that assigns relatedness values only to word pairs well enough supported by corpus data. Three simple implementations of this idea are presented and evaluated on large corpora and wordnets for two languages. Partial Measures of Semantic Relatedness are shown to perform better in tasks focused on wordnet development than a state-of-the-art 'full' Measure of Semantic Relatedness. A comparison of the partial measure with a globally filtered measure is also presented. © 2014 Springer International Publishing.},
 author = {Piasecki, Maciej and Wendelberger, Michał},
 doi = {10.1007/978-3-319-10816-2_41},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {336 - 343},
 publication_stage = {Final},
 source = {Scopus},
 title = {Partial measure of semantic relatedness based on the local feature selection},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84906987308?origin=resultslist},
 volume = {8655 LNAI},
 year = {2014}
}
