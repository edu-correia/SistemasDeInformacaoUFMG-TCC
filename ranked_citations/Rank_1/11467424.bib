@inproceedings{11467424,
 abstract = {In the modern landscape of digital recruitment, a well-crafted resume is crucial for advancing past Applicant Tracking Systems (ATS) and reaching hiring professionals1. However, manual resume editing often falls short due to a lack of insight into recruiter expectations, non-compliance with ATS criteria, and insufficient personalization2. This paper introduces the Smart AI Resume Analyzer. This deep learning-based candidate profiling system addresses these limitations by employing Artificial Intelligence (AI) and Natural Language Processing (NLP) for real-time resume optimization33. The system offers contextual analysis, job-specific feedback, and improved alignment with job descriptions through an intuitive web interface4. It supports multi-format resume uploads, provides dynamic suggestions for formatting, keyword inclusion, and skills alignment, and offers valuable services to job seekers, career counsellors, recruitment agencies, HR departments, and educational institutions5. Merging NLP with ATS-aware design, the Smart Resume Analyzer represents a next-generation solution for intelligent, adaptive, and scalable resume evaluation6. This paper details its architecture, implementation, and evaluation, demonstrating its effectiveness in automating resume analysis and streamlining recruitment workflows.},
 author = {G, Swetha and N, Shruthi K and R, Sushma and C, Kruthi T and S, Veena M and K, Tejaswini},
 booktitle = {2025 IEEE 4th International Conference on Technology, Engineering, Management for Societal impact using Marketing, Entrepreneurship and Talent (TEMSMET)},
 doi = {10.1109/TEMSMET65536.2025.11467424},
 issn = {},
 keyword = {Feedback;Filters;Filtering;Recommender systems;Collaborative filtering;Circuits;System-on-chip;Information filtering;Filtering theory;Application specific integrated circuits;Candidate Profiling;Natural Language Processing (NLP);Deep Learning;Resume Parsing;Recruitment Automation;Named Entity Recognition (NER);Streamlit},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {AI-Powered Smart Resume Analyzer: An NLP and Deep Learning-Based Framework for Automated Candidate Profiling and Recruitment Optimization},
 volume = {},
 year = {2025}
