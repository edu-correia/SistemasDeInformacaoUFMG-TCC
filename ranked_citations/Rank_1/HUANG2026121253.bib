@article{HUANG2026121253,
 abstract = {The catalyst layer (CL) critically governs the performance and durability of water electrolyzers in renewable energy conversion. However, there is a lack of fundamental understanding of the mechanisms underlying the commonly observed mechanical degradation of CL induced by electrochemical bubbles. This study demonstrates that bubble-induced CL degradation originates from accumulative plastic damage caused by periodic fluid loading during bubble merging. The mechanism is first studied experimentally using macroscopic bubbles to characterize bubble-induced fluid traction and then analyzed in a multi-scale numerical model of microscopic bubble merging at the interface between porous transport layer (PTL) and CL to evaluate the resultant CL damage evolvement. The results show that bubbles merging events cause liquid “rush-in” to implode bubble volume, leading to focused compressive tractions that generates MPa scale stresses within the CL. These periodical stresses induce plasticity development in CL binders, accumulating damage manifested as catalyst delamination, CL fracture, and pore closure, with catalyst delamination being the dominant failure mode. Consequently, CL fails rapidly under high gas saturation and high current densities due to strong and frequent fluid traction from small-sized bubbles. The structural basis for the damage mechanism is further discussed to evaluate superior designs such as microporous layers and gradient PTLs in protecting CL from mechanical degradation. This study reveals the mechanical origin of bubble-induced CL degradation, laying a foundation for developing durable water electrolyzers for renewable energy conversion.},
 author = {Yunqiao Huang and Haoran Zhang and Shengfeng Xue and Samaneh Shahgaldi and Zhongchao Tan and Xianguo Li},
 doi = {https://doi.org/10.1016/j.enconman.2026.121253},
 issn = {0196-8904},
 journal = {Energy Conversion and Management},
 keyword = {Catalyst layer, Waterelectrolyzer, Damage, Bubble, Fluid-structure interaction, Plasticity},
 pages = {121253},
 title = {Mechanical degradation of catalyst layer in water electrolyzers due to bubble-induced damage},
 url = {https://www.sciencedirect.com/science/article/pii/S0196890426002220},
 volume = {354},
 year = {2026}
}
