@conference{Walia2025608,
 abstract = {Digital advancement and smart production have been made possible via artificial intelligence (AI) and computing in the cloud (CC) because of the fifth-generation wireless network (5G), which is a key enabler of the fourth industrial revolution. Nevertheless, beyond 5G (B5G) is seen as a watershed moment that will radically alter current worldwide tendencies in mobile phone practices and impact the lives of many. Physical and digital worlds will eventually merge, according to B5G. The focus of this research is on the future of technology for wireless communications, specifically the evolution from 5G into 6G. Still, mankind hasn't arrived to the age of instantaneous contact with aliens, lightning-fast internet, plus zero latency, despite a number of advancements. In order to accomplish these more elevated goals, this article investigates the potential obstacles and hurdles that the shift from 5G to 6G may encounter. The article lays out the plan for 6G, the enabling infrastructures, the problems, and the research that will lead to the realization of the 'technology for humanity' goal and improved assistance for the poor. © 2025 IEEE.},
 author = {Walia, Anita and Das, Neeraj},
 doi = {10.1109/CE2CT64011.2025.10941277},
 journal = {1st International Conference on Advances in Computer Science, Electrical, Electronics, and Communication Technologies, CE2CT 2025},
 note = {Cited by: 0},
 pages = {608 - 613},
 publication_stage = {Final},
 source = {Scopus},
 title = {5G to 6G Shaping and Effect of the Wireless Data Transmission},
 type = {Conference paper},
