@article{10.5555/1858583.1858587,
 abstract = {In this paper we describe our very positive experience in teaching a game design and development course with Alice as a 3D game development platform. We describe why Alice was chosen as our 3D game development platform, what material was covered, how the course was conducted, the quality of the students' game projects, features of Alice that students liked for game development, problems that students had when using Alice, and the evaluation of the course.},
 address = {Evansville, IN, USA},
 author = {Villaverde, Karen and Jaramillo, Daniel},
 issn = {1937-4771},
 issue_date = {December 2010},
 journal = {J. Comput. Sci. Coll.},
 month = {December},
 number = {2},
 numpages = {8},
 pages = {22–29},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Game design and development course taught with Alice},
 volume = {26},
 year = {2010}
}
