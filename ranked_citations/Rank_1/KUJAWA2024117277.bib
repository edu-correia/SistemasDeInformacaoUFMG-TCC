@article{KUJAWA2024117277,
 abstract = {The review concludes with a broad spectrum of practical applications of concerted PVDF-CNM membrane materials dedicated for liquid and gas separation, with significant focus on the desalination process. The research is carried out in diverse science fields, merging materials chemistry and engineering toward frequently multimodal functionalities. Hence, there is a high demand for a comprehensive review of these cutting-edge-materials from across fundamental sciences and technologies. The main goals of the work are focused on linking the structure of PVDF (phases) and CNMs (carbon atom hybridization) with physico-chemical properties of PVDF-CNMs materials. Moreover, attention was paid on the simplicity of the PVDF-CNMs generation having a huge potential in the tuning of various features of the obtained materials (e.g., hydrophilicity, mechanical properties, catalytic activity, bioactivity). Additionally, the new directions of exploration have been indicated.},
 author = {Joanna Kujawa and Sławomir Boncel and Samer Al-Gharabli and Stanisław Koter and Wojciech Kujawski and Katsumi Kaneko and Kang Li and Emil Korczeniewski and Artur P. Terzyk},
 doi = {https://doi.org/10.1016/j.desal.2023.117277},
 issn = {0011-9164},
 journal = {Desalination},
 keyword = {PVDF, Carbon nano materials, Material science, Separation materials, Desalination, Membrane distillation},
 pages = {117277},
 title = {Concerted role of PVDF and carbon nanomaterials for membrane science},
 url = {https://www.sciencedirect.com/science/article/pii/S0011916423009098},
 volume = {574},
 year = {2024}
}
