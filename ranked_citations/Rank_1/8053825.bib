@article{8053825,
 abstract = {This brief presents a two-way time-interleaved two-step pipelined analog-to-digital converter (ADC) architecture built upon a new concept of virtual-ground sampling, featuring merged front-end track-and-hold, residue generation, input termination, and buffering. This architecture is investigated to alleviate the front-end performance tradeoff among the total-harmonic-distortion, bandwidth, and sampling rate (interleaving factor). A 2-GS/s 8b ADC using the new architecture was designed and fabricated in 28-nm CMOS, achieving 43-dB SNDR and 55-dB SFDR up to Nyquist frequency.},
 author = {Wang, X. Shawn and Jin, Xin and Du, Jieqiong and Li, Yilei and Du, Yuan and Wong, Chien-Heng and Kuan, Yen-Cheng and Chan, Chi-Hang and Chang, Mau-Chung Frank},
 doi = {10.1109/TCSII.2017.2758323},
 issn = {1558-3791},
 journal = {IEEE Transactions on Circuits and Systems II: Express Briefs},
 keyword = {Switches;Linearity;Clocks;Timing;Bandwidth;Distortion;Signal resolution;Analog-to-digital converter (ADC);virtual-ground sampling;SAR;time-interleaved},
 month = {Nov},
 number = {11},
 pages = {1534-1538},
 title = {A 2-GS/s 8-Bit ADC Featuring Virtual-Ground Sampling Interleaved Architecture in 28-nm CMOS},
 volume = {65},
 year = {2018}
}
