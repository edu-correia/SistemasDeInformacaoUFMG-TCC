@inproceedings{11211776,
 abstract = {A proper classification system of lung cancer stands vital for early-stage diagnosis along with therapy planning. This research presents a combination of multi-scale Convolutional Neural Networks with feature fusion and Bayesian optimization-based feature weighting and Random Forest classification through boosting and bagging techniques for multiclass detection of lung cancer. The pre-processing stage of the methodology starts with lung CT image resizing followed by CLAHE enhancement then min-max normalization to achieve better image visualization. The deep hierarchical features extracted by a multi-scale CNN provide representation of global and local image patterns. Various texture features derive from Gray Level Co-occurrence Matrix (GLCM), Local Binary Pattern (LBP), and Wavelet Transform to boost classification discrimination. Bayesian optimization applies optimal weighting techniques to merge these features prior to obtaining maximum classification outcomes. A decision-making process powered by Random Forest with boosting and bagging works as the final classification step. Research testing performed on LIDC-IDRI and LUNA16 datasets showed that the proposed model outperformed deep learning structures ResNet-50, VGG-16, DenseNet-121 and EfficientNet-B0. The proposed model reaches a remarkable accuracy level of $\mathbf{9 7. 8 \%}$ alongside 97.1 % sensitivity and 97.5 % specificity and an AUC value of 0.98 which surpasses existing contemporary approaches. The model shows enhanced capability for generalization in addition to greater classification reliability than standard 3D-CNN and fusion models. This approach becomes a highly successful lung cancer detection method because multiple feature extraction scales along with texture analysis integration with ensemble learning and Bayesian optimization optimization techniques significantly improve classification output. The assessment methodology produces exact distinctions between benign along with probably benign and indeterminate and probably malignant lung nodules which helps to enhance diagnostic accuracy in clinical settings.},
 author = {Singh, Gurbhej and Sharma, Geetika and Mittal, Anupam},
 booktitle = {2025 International Conference on Engineering Innovations and Technologies (ICoEIT)},
 doi = {10.1109/ICoEIT63558.2025.11211776},
 issn = {},
 keyword = {Deep learning;Accuracy;Lungs;Lung cancer;Feature extraction;Bayes methods;Ensemble learning;Convolutional neural networks;Optimization;Random forests;lung cancer;nodule;segmentation;classification;deep learning;machine learning},
 month = {July},
 number = {},
 pages = {272-278},
 title = {Multi-Scale CNN-Based Lung Cancer Classification: Integrating Deep Learning, Texture Analysis, Bayesian Optimization and Ensemble Learning for Enhanced Diagnostic Accuracy},
 volume = {},
 year = {2025}
}
