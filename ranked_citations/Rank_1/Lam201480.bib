@article{Lam201480,
 abstract = {Traditional learning in face-to-face mode has been the majority learning mode until the end of last Century. With the advent of using Internet technology, e-learning has been intensively used in higher education to enhance teaching and learning. In order to maximize the benefits and offset the constraints of both learning in pure face-to-face mode and e-learning mode, blended learning was advocated by the researchers as a solution. Throughout the years of blended learning development, the understanding on the context of blended learning was varied. This paper aims at identifying the context of blended learning in its evolution by reviewing the researches in the literature. A blended learning model, TIPS, was demonstrated as a holistic view to cover the perspectives of the context of blended learning. The TIPS blended learning model can be served as tips in designing and developing blended learning. © 2014 Springer International Publishing.},
 author = {Lam, Jeanne},
 doi = {10.1007/978-3-319-08961-4_9},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 7},
 pages = {80 - 92},
 publication_stage = {Final},
 source = {Scopus},
 title = {The context of blended learning: The TIPS blended learning model},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84905844078?origin=resultslist},
 volume = {8595 LNCS},
 year = {2014}
}
