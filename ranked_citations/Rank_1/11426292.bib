@inproceedings{11426292,
 abstract = {In this article, a Terahertz Metamaterial Absorber (TMA) for early detection of cancerous cells has been proposed. Here, the proposed design is made of several circular ring resonators which are merged together. The merged structure is based on a gallium arsenide (GaAs)-based substrate of 105 um length and 8 um thickness. The structure has been observed to achieve a peak absorption of 98.75% at 4.71 THz, with a high-quality factor (Q-factor) of 71.5 and sensitivity of 2404 GHz/RiU. With the shift in the refractive index of the encompassing medium, the resonance peak also shifts; thereby indicating whether the cell is benign or malignant. The stability of the structure has been studied under incident angle variation and is found to be independent with respect to the changes in polarization angles; thereby making the structure polarization independent. The structure is found to behave like an epsilon negative material with plasmonic resonance and has been compared with existing works to validate the structure's superiority in terms of high sensitivity and FoM; thereby finding several bio-sensing applications across the terahertz regime.},
 author = {Sengupta, Arjab and Chakraborty, Sagnik and Nandi, Sayak and Gangopadhyaya, Malay and Sen, Gobinda},
 booktitle = {2025 IEEE Microwaves, Antennas, and Propagation Conference (MAPCON)},
 doi = {10.1109/MAPCON65020.2025.11426292},
 issn = {},
 keyword = {Q-factor;Terahertz metamaterials;Sensitivity;Absorption;Refractive index;Resonance;Metamaterials;Sensors;Biosensors;Cancer;Sensor;cell detection;absorber;terahertz;TMA;FoM;Q-Factor;sensitivity},
 month = {Dec},
 number = {},
 pages = {1-4},
 title = {Design of a Terahertz Metamaterial Absorber (TMA)-Based Bio-Sensor using GaAs towards Cancer Detection with Improved Sensitivity and FoM},
