@conference{Yang2019387,
 abstract = {Lane detection system is an important part of many intelligent transportation systems. However, lane recognition is often affected by curvature of lane, worn lane marking, lane change, appearance, and end, merge and split lanes, which results in the decline of recognition accuracy. In order to solve the problem of insufficient recognition rate of traditional lane recognition algorithms, we propose a lane detection algorithm based on deep learning. Based on the combination of deep convolution network and lane features, a lane segmentation network model based on full convolution network is constructed to realize fast lane recognition. Experiments show that the proposed algorithm has strong robustness and reliability. © 2019 IEEE.},
 author = {Yang, Zhuoyuan},
 doi = {10.1109/AIAM48774.2019.00082},
 journal = {Proceedings - 2019 International Conference on Artificial Intelligence and Advanced Manufacturing, AIAM 2019},
 note = {Cited by: 4},
 pages = {387 - 391},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on Lane Recognition Algorithm Based on Deep Learning},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85084766635?origin=resultslist},
 year = {2019}
}
