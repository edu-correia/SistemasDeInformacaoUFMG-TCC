@article{Löhner20082173,
 abstract = {Embedded mesh, immersed body or fictitious domain techniques have been used for many years as a way to discretize geometrically complex domains with structured grids. The use of such techniques within adaptive, unstructured grid solvers is relatively recent. The combination of body-fitted functionality for some portion of the domain, together with embedded mesh or immersed body functionality for another portion of the domain offers great advantages, which are increasingly being exploited. The present paper reviews the methodologies pursued so far, addresses implementational issues and shows the possibilities such techniques offer. © 2007.},
 author = {Löhner, Rainald and Cebral, Juan R. and Camelli, Fernando E. and Appanaboyina, S. and Baum, Joseph D. and Mestreau, Eric L. and Soto, Orlando A.},
 doi = {10.1016/j.cma.2007.09.010},
 journal = {Computer Methods in Applied Mechanics and Engineering},
 note = {Cited by: 95},
 number = {25-28},
 pages = {2173 - 2197},
 publication_stage = {Final},
 source = {Scopus},
 title = {Adaptive embedded and immersed unstructured grid techniques},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/41949092689?origin=resultslist},
 volume = {197},
 year = {2008}
}
