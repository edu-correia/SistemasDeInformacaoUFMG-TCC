@article{Zhou2018641,
 abstract = {In this paper, a fast Sample Adaptive Offset (SAO) method is proposed to reduce the high computational complexity in SAO estimation process. On the frame level, the relationship between SAO and the quantization parameter or the layer information due to the hierarchical coding structure is explored. A fuzzy control method is proposed to decide how to perform the SAO operation. On the CTU level, an asymmetric EO/BO skipping method is proposed. The complexity measurement of a coding tree unit (CTU) is inferred by the number of coding units (CU). Edge offset (EO) or band offset (BO) is asymmetrically skipped while the CTU is of low complexity, thus the SAO process time can be reduced. Experimental results show that the proposed method can reduce about 63.89% SAO encoding time on average under the common test conditions with negligible loss compared with the original SAO method in HEVC reference software HM16.2. © Springer International Publishing AG, part of Springer Nature 2018.},
 author = {Zhou, Yan and Chen, Zhenzhong},
 doi = {10.1007/978-3-319-77380-3_61},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {641 - 651},
 publication_stage = {Final},
 source = {Scopus},
 title = {A fast sample adaptive offset algorithm for H.265/HEVC},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85047464374?origin=resultslist},
 volume = {10735 LNCS},
 year = {2018}
}
