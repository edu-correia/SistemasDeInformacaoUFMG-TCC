@inproceedings{1181137,
 abstract = {A novel rate-controllable model-aided hybrid codec is proposed in this paper, which is more adaptive with the controllable frame-rate. We also proposed a new self-adaptable merging algorithm to improve the subjective quality of the synthetic B-frame (bi-direction prediction frame) image. The use of P-frame (prediction frame) and B-frame enhances the video compression ratio, and an affine transform makes the synthesis algorithm fast and easy. The high efficiency of this codec was demonstrated in two experiments.},
 author = {Yang Xiaohui and Li Zhongke and Wu Lenan},
 booktitle = {6th International Conference on Signal Processing, 2002.},
 doi = {10.1109/ICOSP.2002.1181137},
 issn = {},
 keyword = {Codecs;Motion estimation;Decoding;Image coding;Network synthesis;Financial advantage program;Video compression;Image generation;Image sequences;Streaming media},
 month = {Aug},
 number = {},
 pages = {640-643 vol.1},
 title = {A novel rate-control model-aided hybrid coding},
 volume = {1},
 year = {2002}
}
