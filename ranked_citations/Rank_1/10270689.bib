@inproceedings{10270689,
 abstract = {With the expansion of the scale of urban power grid, the requirements for signal communication system are becoming higher and higher. In these high-speed information data, we usually use multiple master chips to complete the isolation and control of multi-source data. Therefore, in order to achieve the requirements of stability, reliability, efficiency and energy saving of the system, a set of complex low pressure platform communication topology scheme based on HPLC signal isolation technology is proposed. In this paper, the principal component analysis and experimental testing methods are mainly used to investigate and test the communication topology scheme of the HPLC signal isolation and attenuation control station. The experimental results show that in T-SNE+K and T-SNE+B methods, the highest accuracy is 87.5% and the lowest is 75.6%. Although T-SNE reduces its size according to the original distribution characteristics of the data, it can also maintain its distribution characteristics when the size is small to maintain more effective features.},
 author = {Jiang, Jianfeng and Huang, Ruili and Zhao, Xuepeng},
 booktitle = {2023 IEEE 4th Annual Flagship India Council International Subsections Conference (INDISCON)},
 doi = {10.1109/INDISCON58499.2023.10270689},
 issn = {},
 keyword = {Substations;Communication systems;Data integration;Attenuation;Stability analysis;Topology;Signal analysis;Multi-Source Data Fusion;Complex Low Pressure Platform Area;HPLC Signal;Communication Topology Scheme;Isolation Attenuation},
 month = {Aug},
 number = {},
 pages = {1-5},
 title = {Communication Topology Scheme of Complex Low-Pressure Platform Area HPLC Signal Isolation and Attenuation Control Station Area Based on Cross-Platform Multi-Source Data Fusion},
 volume = {},
 year = {2023}
}
