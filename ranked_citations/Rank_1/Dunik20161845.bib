@conference{Dunik20161845,
 abstract = {The paper addresses state estimation of nonlinear stochastic dynamic systems. In particular, the stress is laid on the selection and performance monitoring of estimators based on measures assessing the validity of the assumptions under which the estimators have been proposed. The main focus is placed on summary and unification of the measures of nonlinearity and non-Gaussianity which might be used in state estimation. Discussions include analysis of the measures for stability, consistency, and validity. Using both local and global measures of nonlinearity (MoNL) include differential geometry, least squares, and convex optimisation while measures of non-Gaussianity (MoNG) include moment matching and volume differencing. © 2016 ISIF.},
 author = {Dunik, J. and Straka, O. and Mallick, Mahendra and Blasch, Erik},
 journal = {FUSION 2016 - 19th International Conference on Information Fusion, Proceedings},
 note = {Cited by: 17},
 pages = {1845 - 1852},
 publication_stage = {Final},
 source = {Scopus},
 title = {Survey of nonlinearity and non-Gaussianity measures for state estimation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84992145927?origin=resultslist},
 year = {2016}
}
