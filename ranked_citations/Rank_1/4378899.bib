@inproceedings{4378899,
 abstract = {In this paper we integrate several spatial texture tools into a texture-based video coding scheme. We implemented texture techniques and segmentation strategies in order to detect texture regions in video sequences. These textures are analyzed using temporal motion techniques and are labeled as skipped areas that are not encoded. After the decoding process, frame reconstruction is performed by inserting the skipped texture areas into the decoded frames. We are able to show an improvement over previous texture-based implementations in terms of compression efficiency.},
 author = {Bosch, Marc and Zhu, Fengqing and Delp, Edward J.},
 booktitle = {2007 IEEE International Conference on Image Processing},
 doi = {10.1109/ICIP.2007.4378899},
 issn = {2381-8549},
 keyword = {Video compression;Decoding;Image reconstruction;Image coding;Image segmentation;Image texture analysis;Video coding;Feature extraction;Synthesizers;Video sequences;Video coding;image segmentation;texture modeling;feature extraction},
 month = {Sep.},
 number = {},
 pages = {I - 93-I - 96},
 title = {Spatial Texture Models for Video Compression},
 volume = {1},
 year = {2007}
}
