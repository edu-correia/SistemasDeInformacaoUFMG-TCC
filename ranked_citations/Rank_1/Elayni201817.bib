@article{Elayni201817,
 abstract = {A single source of intrusion detection dataset involves the analyze of Big Data, recent attempts focus on Big Data techniques in order to combine heterogeneous data sets and solve the problems of analyzing the huge amounts of data. The main objective of this paper is to present a method to train and combine several datasets from semi-structured sources with the MapReduce programming paradigm under MongoDB. It aims to increase the intrusion detection rates. In our work, we will focus on KDD99, DARPA 1998 and DARPA 1999 dataset and with the big data technique MapReduce in MongoDB: First, we will select the most pertinent attributes and eliminate the redundancies from the previous datasets. Then, we will merge them vertically into the same collection. Finally, to analyze the dataset we will use a Bayesian network as K2 algorithm implemented in WEKA. © Springer International Publishing AG 2018.},
 author = {Elayni, Marwa and Jemili, Farah},
 doi = {10.1007/978-3-319-62048-0_2},
 journal = {Studies in Computational Intelligence},
 note = {Cited by: 8},
 pages = {17 - 29},
 publication_stage = {Final},
 source = {Scopus},
 title = {Using MongoDB databases for training and combining intrusion detection datasets},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85022016944?origin=resultslist},
 volume = {721},
 year = {2018}
}
