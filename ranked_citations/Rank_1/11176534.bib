@inproceedings{11176534,
 abstract = {An innovative solution designed to enhance banking accessibility for visually impaired individuals by combining handwritten recognition technology with a talkback system. The integration of these technologies addresses the significant barriers that visually impaired people face in digital banking, offering a more inclusive approach. Handwritten recognition allows users to input information via handwriting, which is then interpreted by advanced machine learning algorithms, while the talkback system provides auditory feedback, guiding users through banking processes with voice commands. The role of Convolutional Neural Networks (CNNs) is crucial in this setup. CNNs, a class of deep learning models, are exceptionally proficient in processing and recognizing image-based data, including handwritten inputs. These networks analyze the strokes and patterns of handwriting, translating them into digital text that the banking system can understand. This capability is complemented by natural language processing and speech synthesis technologies that power the talkback system. By merging these advanced technologies, the proposed solution not only aims to empower visually impaired individuals with greater financial independence but also promotes broader inclusion within the digital banking landscape.},
 author = {Mahajaishree, R and Dhanalakshmi, M and Karthiha, K and Eswaramoorthy, K and Veni, S H.Krishna and Umamaheswari, S.},
 booktitle = {2025 8th International Conference on Circuit, Power & Computing Technologies (ICCPCT)},
 doi = {10.1109/ICCPCT65132.2025.11176534},
 issn = {},
 keyword = {Deep learning;Handwriting recognition;Accuracy;Translation;Visual impairment;Banking;Speech recognition;Natural language processing;Text to speech;Convolutional neural networks;Digital Banking;Convolution Neural network;Visually Impaired Users;Deep Learning},
 month = {Aug},
 number = {},
 pages = {1926-1931},
 title = {Enhancing Accessibility in Banking Services for Visually Impaired Users Using Deep Learning},
 volume = {},
 year = {2025}
}
