@inproceedings{11235375,
 abstract = {Modern clock tree synthesis (CTS) for million-flip-flop designs faces a critical trilemma: minimizing skew, latency, and buffer count simultaneously. While conventional H-tree variants enforce rigid symmetry at the cost of buffer overhead, existing buffer insertion methods fail to address path-dependent delay accumulation in very-large-scale clock networks. This paper introduces a bi-partition four-branch hierarchical topology that breaks this barrier through two key innovations: First, A bottom-up clock-aware clustering algorithm with geometric Boolean legalization, reducing baseline skew through Manhattan-distance-constrained buffer reselection. Second, A top-down symmetric path merging strategy that eliminates redundant buffers across H-tree branches while preserving delay balance. Validated on 100K-200K flip-flop industrial benchmarks, our method achieves 9.8ps global skew—57.54% lower than GH-Tree and 32.96% better than OpenROAD, while maintaining below-0.48ns latency with 29.2% and 30.2% fewer buffers. This CTS framework enables <10ps skew without sacrificing routability or power efficiency, making it particularly compelling for low-power high-performance ICs where clock integrity dictates system energy proportionality.},
 author = {Liu, Runkan and Yang, Junwei and Guo, Jingjing},
 booktitle = {2025 IEEE 38th International System-on-Chip Conference (SOCC)},
 doi = {10.1109/SOCC66126.2025.11235375},
 issn = {2164-1706},
 keyword = {Technological innovation;Network topology;Trees (botanical);Merging;Topology;Delays;System-on-chip;Faces;Clocks;Flip-flops;Bi-Partition Four-Branch Tree;Buffer Insertion;Path Merging;Clock Skew;Clock Latency;Clock Tree Synthesis},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Bi-Partition Four-Branch Tree: Topologies for Sub-10ps Skew with Co-Optimized Latency Buffer},
 volume = {},
 year = {2025}
}
