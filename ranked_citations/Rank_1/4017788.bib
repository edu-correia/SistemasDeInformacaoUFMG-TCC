@inproceedings{4017788,
 abstract = {In this paper we have proposed new real coded genetic algorithm with species and sexual selection (GAS3). GAS3 is a distributed quasi steady-state real-coded genetic algorithm. GAS3 uses sex determination method (SDM) to determine the sex (male or female) of members in population. Each female member is considered as a niche in population and the species formation take place around these niches. Sexual selection strategy selects female and required number of male members from species to perform the recombination operation. The parent-centric recombination operators are used to generate offspring. If species is not performing well, then the merging of species to the nearby species takes place. Performance of GAS3 is tested on unimodal and multi-modal test functions. It got success in solving wide range of problems. Its performance is also compared with other real-coded genetic algorithm and evolutionary strategies},
 author = {Raghuwanshi, M.M. and Kakde, O.G.},
 booktitle = {2006 IEEE Conference on Cybernetics and Intelligent Systems},
 doi = {10.1109/ICCIS.2006.252229},
 issn = {2326-8239},
 keyword = {Genetic algorithms;Evolution (biology);Biological cells;Steady-state;Merging;Testing;Probability distribution;Convergence;Polynomials;Genetic mutations;real-coded genetic algorithms;parent-centric crossover operators;chromosome differentiation;Clustering;sexual selection scheme;distributed genetic algorithm;niche and species},
 month = {June},
 number = {},
 pages = {1-8},
 title = {Genetic Algorithm With Species And Sexual Selection},
 volume = {},
 year = {2006}
}
