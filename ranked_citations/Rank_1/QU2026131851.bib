@article{QU2026131851,
 abstract = {Referring image segmentation aims to segment specific regions in images based on descriptive language expressions. Recent advances have leveraged multimodal Transformers, such as vision-language models (VLMs), to align visual and linguistic features more effectively than simply merging models from different domains. However, most existing approaches rely on direct multimodal fusion or single-directional alignment, often overlooking intricate correlations between image and text modalities. This can lead to suboptimal segmentation due to redundant or ineffective feature integration. To address these challenges, we propose a novel Bi-directional Feature Filter & Enhanced Fusion with Adaptive Selection Encoder (BFEA). BFEA models bidirectional cross-modal interactions and incorporates enhanced fusion to capture complementary information between modalities. An adaptive selection decoder further refines feature integration by selectively retaining relevant information, thereby improving segmentation accuracy and efficiency. Extensive experiments on diverse real-world datasets demonstrate that BFEA consistently outperforms state-of-the-art baselines with lower computational costs. Our code is available at https://github.com/Qu-W/BFEA.},
 author = {Wen Qu and Xiao Li and Xiaocui Yang and Yonggong Ren},
 doi = {https://doi.org/10.1016/j.neucom.2025.131851},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {Referring image segmentation, Cross-modal alignment, Bidirectional feature fusion, Adaptive feature selection},
 pages = {131851},
 title = {Advancing referring image segmentation with bidirectional feature enhancement and adaptive multimodal fusion},
 url = {https://www.sciencedirect.com/science/article/pii/S0925231225025238},
 volume = {663},
 year = {2026}
}
