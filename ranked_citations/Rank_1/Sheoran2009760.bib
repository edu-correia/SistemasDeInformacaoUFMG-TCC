@conference{Sheoran2009760,
 abstract = {With the recent increase in availability of quad polarization (HH, HV, VH and VV) radar data, the need to assess the utility of these datasets for land cover/use classification is crucial and was the premise of this study. Historically, most spaceborne radars were single wavelength and single polarization. For this study, the Japanese ALOS PALSAR quad polarization radar data was obtained at 12.5 m spatial resolution. The second data set to be used in this study was acquired by Landsat TM at a 28.5 m spatial resolution. The purpose of this study was to evaluate the classification of various land covers/uses using spaceborne quad polarization radar and optical TM data. Secondly, the study analyzed the utility and improvements that can be made to the radar and TM data with the help of using radar texture and multi sensor fusion techniques, e.g. layer stacking and Principal Component Analysis (PCA). The central valley of California has been chosen for analysis in this study. The primary methodology was to evaluate texture (Kurtosis, Mean Euclidean distance, Skewness, and Variance) at four window sizes. Supervised signature extraction and classification (maximum likelihood) was used to classify different land covers/uses, followed by an accuracy assessment. The combination of radar and Landsat consistently provided excellent classification accuracies, well over 90%. During a comparison of the two datasets, Landsat provided higher classification accuracies as compared to radar and radar texture analyzed individually. The use of texture was not able to help provide higher classification accuracies for the different classes.},
 author = {Sheoran, Arjun and Haack, Barry and Sawaya, Salim},
 journal = {American Society for Photogrammetry and Remote Sensing Annual Conference 2009, ASPRS 2009},
 note = {Cited by: 4},
 pages = {760 - 770},
