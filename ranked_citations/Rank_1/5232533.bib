@inproceedings{5232533,
 abstract = {The M&A stage identification of enterprises refers to the systematic analysis on various activities in the overseas M&As of Chinese enterprises. As a growth means for Chinese enterprises, the overseas M&As of Chinese enterprises can be divided as three stages according to their characteristics, i.e. the early stage of M&As, middle stage of M&As, late stage of M&As. The early stage of M&As includes strategy making and overseas M&A target selection; the middle stage of M&As includes negotiation; the late stage of M&As mainly refers to the integration.},
