@article{Adrian2010640,
 abstract = {Because there is so much money involved in virtual worlds these days, there has been an increase in criminal activity in these worlds as well. The gaming community calls people who promote conflict &quot;griefers&quot;. Griefers are people who like nothing better than to kill team-mates or obstruct the game's objectives. Griefers scam, cheat and abuse. Recently, they have begun to set up Ponzi schemes. In games that attempt to encourage complex and enduring interactions among thousands of players, &quot;griefing&quot; has evolved from being an isolated nuisance to a social disease. Much in the same way crime has become the real world's social disease. Grief is turning into crime. © 2010 Elsevier Inc. All rights reserved.},
 author = {Adrian, Angela},
 doi = {10.1016/j.clsr.2010.09.003},
 journal = {Computer Law and Security Review},
 note = {Cited by: 15},
