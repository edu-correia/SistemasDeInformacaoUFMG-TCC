@article{10.1145/2070781.2024164,
 abstract = {We present a method for replacing facial performances in video. Our approach accounts for differences in identity, visual appearance, speech, and timing between source and target videos. Unlike prior work, it does not require substantial manual operation or complex acquisition hardware, only single-camera video. We use a 3D multilinear model to track the facial performance in both videos. Using the corresponding 3D geometry, we warp the source to the target face and retime the source to match the target performance. We then compute an optimal seam through the video volume that maintains temporal consistency in the final composite. We showcase the use of our method on a variety of examples and present the result of a user study that suggests our results are difficult to distinguish from real video footage.},
 address = {New York, NY, USA},
 author = {Dale, Kevin and Sunkavalli, Kalyan and Johnson, Micah K. and Vlasic, Daniel and Matusik, Wojciech and Pfister, Hanspeter},
 doi = {10.1145/2070781.2024164},
 issn = {0730-0301},
 issue_date = {December 2011},
 journal = {ACM Trans. Graph.},
 keyword = {face replacement, facial animation, video compositing},
 month = {December},
 number = {6},
 numpages = {10},
 pages = {1–10},
 publisher = {Association for Computing Machinery},
 title = {Video face replacement},
 url = {https://doi.org/10.1145/2070781.2024164},
 volume = {30},
 year = {2011}
}
