@conference{Hoang2025,
 abstract = {Recent advances in 3D NAND memory hole etch cryo chemistry has significantly improved etch rates and aspect ratio dependent etch (ARDE) to lower scaling costs; however, ARDE inherent in plasma etch processes cannot be eliminated. As a result, continuous co-optimized improvements in 3DNAND architecture, integration, and process innovations are needed to continue cost effective 3D NAND scaling. In this work, deposition and etch co-optimization (DECO) is explored to merge memory hole and contact etches to reduce patterning steps and costs. The interlayer dielectric oxide (ILD) is doped allowing modulation of the etch depth and profile during cryo memory hole. The doped ILD oxide wet etch properties and leakage current are also compared to a baseline ILD to ensure integration compatibility.  © 2025 IEEE.},
 author = {Hoang, John and Matamis, George and Pham, Calvin and Chi, Hao and Church, Jonathan and Subramonium, Pramod},
 doi = {10.1109/IMW61990.2025.11026958},
 journal = {2025 IEEE International Memory Workshop, IMW 2025 - Proceedings},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Enabling Merged 3D NAND Memory Hole and Interlayer Dielectric (ILD) Contact Etches with Deposition and Etch Co-Optimization (DECO)},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105009244330?origin=resultslist},
 year = {2025}
}
