@incollection{CASTILLOACERO2018585,
 abstract = {The main challenge of morphing wings is to design a system that is able to withstand the applied loads while being capable of adapting its shape. A multidisciplinary approach is necessary for merging properly with integrated structural actuation systems, starting from the early design development, then increasing the overall configuration complexity from the preliminary stages. There is a multiplicity of alternatives to the benchmark configuration. Structural morphing rose to prominence recently due to increasing demand for satellite and unmanned aerial vehicle performance, spurring many studies on the topic. Design implications aside, morphing wings give rise to a number of new manufacture, assembly, and verification challenges for structural systems. The number of components drastically increases as traditional frozen architectures are supplanted by kinematic chains or compliant systems. The increased number of parts comprising the mechanical system results in an increased number of difficulties, as well as an attendant increase in the required manufacturing effort and design attention devoted to tolerances and assembly. As a result, manufacture and design scientists are expected to cooperate even more than normal due to the massive growth in schematic complexity. Furthermore, because the structure is movable, special assembly rigs must be designed to preserve the kinematic possibilities and avoid local and permanent deformations. Specialized tools must be created to execute certain specific operations on these newly-complicated components. In this chapter, significant examples of the manufacture process of morphing wing components are illustrated. Specifically, attention is focused on technological projects such as the one in which Aernnova used their own background to develop innovations in the development of adaptive modules. Under the European Union's Seventh Programme project SARISTU, this approach permitted the creation of a full-scale wing section for operative wind tunnel tests. In 3AS and CURVED projects, Aernnova focused on developing structured materials with innovative characteristics suitable for integration in morphing constituents. These experiences have been exploited in the assessment of a breakthrough adaptive rudder.},
 author = {Miguel Á. {Castillo Acero} and Federico Martín {de la Escalera} and Yasser Essa},
 booktitle = {Morphing Wing Technologies},
 doi = {https://doi.org/10.1016/B978-0-08-100964-2.00019-8},
 editor = {Antonio Concilio and Ignazio Dimino and Leonardo Lecce and Rosario Pecora},
 isbn = {978-0-08-100964-2},
 keyword = {Frozen architecture, Aircraft, Kinematic chains, Aerodynamics, Morphing systems, Assembly},
 pages = {585-618},
 publisher = {Butterworth-Heinemann},
 title = {Chapter 19 - Morphing Technology for Advanced Future Commercial Aircrafts},
 url = {https://www.sciencedirect.com/science/article/pii/B9780081009642000198},
 year = {2018}
}
