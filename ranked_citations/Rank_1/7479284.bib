@inproceedings{7479284,
 abstract = {In recent years, many works using ontologies for generating graphical interfaces have emerged. In other hand, various UI description Models have been proposed, the most detailed and which describes well the graphical interfaces is the new OMG abstract model of user interfaces: Interaction Flow Modeling Language (IFML). In this paper, we propose a new model-driven development approach based on MDE that merges the logical description UIs components and their interactions captured with IFML in order to enhance the presentation of user interface web applications. The approach is illustrated with an example of a simple real user interface; the process starts with abstract models, in order to produce an html5 model as a target model.},
 author = {Laaz, Naziha and Mbarki, Samir},
 booktitle = {2016 International Conference on Information Technology for Organizations Development (IT4OD)},
 doi = {10.1109/IT4OD.2016.7479284},
 issn = {},
 keyword = {Containers;Biological system modeling;Ontologies;Unified modeling language;Graphical user interfaces;Syntactics;Ontology Definition Metamodel (ODM);Interaction Flow Modeling Language (IFML);Web Applications (WA);Platform Independent Model (PIM);Model Driven Engineering (MDE);User Interfaces (UI);ontologies},
 month = {March},
 number = {},
 pages = {1-6},
 title = {Integrating IFML models and owl ontologies to derive UIs web-Apps},
 volume = {},
 year = {2016}
}
