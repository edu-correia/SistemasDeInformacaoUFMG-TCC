@article{MA2026110160,
 abstract = {Breast cancer remains a leading cause of mortality among women worldwide. Accurate segmentation of breast ultrasound (BUS) images is essential for early diagnosis and treatment planning, yet remains challenging due to blurred boundaries, speckle noise, and complex tumor morphology. To address these issues, we propose Edge-Aware Multi-Scale Hybrid Attention U-Net (EAMSHA-UNet), a novel architecture that integrates edge-aware mechanisms with multi-scale semantic modeling. EAMSHA-UNet incorporates four key modules: (1) a Multi-Scale Hybrid Attention (MSHA) module to capture global contextual information via channel and spatial attention; (2) an Adaptive Dual-Branch Enhancement (ADBE) module that fuses convolutional and self-attention features for robust encoding; (3) an Edge Guidance Block (EGB) that leverages Sobel filters, spatial attention, and progressive boundary supervision to enhance edge features; and (4) an Adaptive Boundary-Semantic Fusion (ABSF) module for lightweight, confidence-guided feature merging. Experimental results on the BUSI and UDIAT datasets demonstrate that EAMSHA-UNet achieves superior segmentation performance, with Dice scores of 82.53% and 83.72%, respectively. Ablation studies confirm the effectiveness of each component. Moreover, qualitative comparisons show that EAMSHA-UNet provides finer delineation of tumor boundaries than existing methods, especially in cases with indistinct or irregular lesions. These findings suggest that EAMSHA-UNet is a promising approach for precise and robust boundary modeling in BUS image segmentation, with potential for real-world clinical applications.},
 author = {Lei Ma and Xiaolin Lin and Weiping Liang and Wangwang Liu},
 doi = {https://doi.org/10.1016/j.bspc.2026.110160},
 issn = {1746-8094},
 journal = {Biomedical Signal Processing and Control},
 keyword = {Breast cancer segmentation, Edge-aware mechanism, Adaptive boundary-semantic fusion, Multi-scale hybrid attention, Breast ultrasound segmentation},
 pages = {110160},
 title = {EAMSHA-UNet: A breast cancer ultrasound image segmentation model based on edge-aware multi-scale hybrid attention},
 url = {https://www.sciencedirect.com/science/article/pii/S1746809426007147},
 volume = {120},
 year = {2026}
}
