@article{10.1145/3638757,
 abstract = {Deep learning (DL) has demonstrated its remarkable success in a wide variety of fields. The development of a DL model is a time-consuming and resource-intensive procedure. Hence, dedicated GPU accelerators have been collectively constructed into a GPU datacenter. An efficient scheduler design for a GPU datacenter is crucially important to reduce operational cost and improve resource utilization. However, traditional approaches designed for big data or high-performance computing workloads can not support DL workloads to fully utilize the GPU resources. Recently, many schedulers are proposed to tailor for DL workloads in GPU datacenters. This article surveys existing research efforts for both training and inference workloads. We primarily present how existing schedulers facilitate the respective workloads from the scheduling objectives and resource utilization manner. Finally, we discuss several promising future research directions including emerging DL workloads, advanced scheduling decision making, and underlying hardware resources. A more detailed summary of the surveyed paper and code links can be found at our project website:},
 address = {New York, NY, USA},
 articleno = {146},
 author = {Ye, Zhisheng and Gao, Wei and Hu, Qinghao and Sun, Peng and Wang, Xiaolin and Luo, Yingwei and Zhang, Tianwei and Wen, Yonggang},
 doi = {10.1145/3638757},
 issn = {0360-0300},
 issue_date = {June 2024},
 journal = {ACM Comput. Surv.},
 keyword = {Deep learning systems, datacenter scheduling},
 month = {January},
 number = {6},
 numpages = {38},
 publisher = {Association for Computing Machinery},
 title = {Deep Learning Workload Scheduling in GPU Datacenters: A Survey},
 url = {https://doi.org/10.1145/3638757},
 volume = {56},
 year = {2024}
}
