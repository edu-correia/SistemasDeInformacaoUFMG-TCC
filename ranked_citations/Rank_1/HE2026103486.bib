@article{HE2026103486,
 abstract = {Fusing significant features from multimode data is essential for building learning methods in Alzheimer’s disease (AD) diagnosis. Sparse graph-based learning methods can catch the complex characteristics implied in data well. However, the existing methods have overly strict constraints on the linear projection of data and are inherently too restrictive to manage data sampled from nonlinear manifolds effectively. The detrimental effects of noise and outliers that arise during the sampling and processing of medical data are overlooked. This study designs a sparse graph-based Alzheimer’s disease diagnosis learning method by integrating the flexible projection and optimal graph into a unified framework to capture the data structure better. Specifically, the method first integrates MRI and PET data through multimodal fusion. A Low-rank regression model is then introduced to enhance robustness to noise and outliers. Next, an optimal graph with flexible projection is learned, combining the graph learning process with the multimodal feature selection framework to derive an adaptive similarity matrix. Finally, l2,1−norm is applied to constrain the weight matrix, which facilitates the selection of discriminative features. In addition, this paper proposes a new iterative optimization algorithm to solve the target expressions of the above methods and ensure their convergence. A series of comprehensive tests conducted on the ADNI neuroimaging datasets reveal that the newly introduced approach provides notable benefits for the early detection of Alzheimer’s disease, outperforming other existing methods.},
 author = {Yuqian He and Hongmei Chen and Biao Xiang and Zhong Yuan and Chuan Luo and Shi-Jinn Horng and Tianrui Li},
 doi = {https://doi.org/10.1016/j.inffus.2025.103486},
 issn = {1566-2535},
 journal = {Information Fusion},
 keyword = {Alzheimer’s disease, Sparse feature selection, Multimodal fusion, Flexible optimal graph, Low-rank representation learning},
 pages = {103486},
 title = {Alzheimer’s disease detection based on flexible optimal graph fusion of multimodal low rank sparse feature selection},
 url = {https://www.sciencedirect.com/science/article/pii/S1566253525005597},
 volume = {125},
 year = {2026}
}
