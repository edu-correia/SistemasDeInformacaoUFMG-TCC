@inproceedings{11436865,
 abstract = {With the merging of synthetic biology and digital technology, new vectors of threat, like malware resides in DNA sequences, have presented increased dangers to the pipelines of bioinformatics. The framework we present in this paper is SeqSecure, a web-based malware detection system that endorses the analysis of DNA sequence files (e.g. .fasta, .gb) on binary-encoded malicious payloads. Seeded in SeqSecure is our own development of a detection algorithm named BioHexa where the DNA nucleotides (A,T,C,G) base calls are encoded to binary bit states using a fixed standardized encoding of 2-bit per base call. This binary stream is further hashed by SHA256 and the signature verified through the VirusTotal API so that the results can be compared to a massive international database of malware. With a very interactive, as well as graphical interface, SeqSecure offers real-time analysis, report of the verdict of the file, and a set of animated feedback. To test realistic behavior, the structure will show the detection of two controlled DNA samples, one of which is benign, and the sample with a large amount of high-entropy code resembling malware. The BioHexa algorithm can increase the security efforts through static DNA-binary transformation together with threat intelligence API verification, which presents an enhanced and lightweight scanning paradigm.The system presents a unique idea of protecting the synthetic biology infrastructure and creates a baseline method to include cybersecurity in DNA sequence processing chain.},
 author = {Preethi.K.A and Swetha.L and D.Geethanjali and N.Umasankari},
 booktitle = {2025 International Conference on Signal Processing, Computation, Electronics, Power and Telecommunication (IConSCEPT)},
 doi = {10.1109/IConSCEPT66142.2025.11436865},
 issn = {},
 keyword = {Pipelines;Merging;Signal processing algorithms;Signal processing;Synthetic biology;Vectors;Real-time systems;Encoding;DNA sequencing;Payloads;Synthetic biology;Binary-encoded payloads;Bio-Hexa algorithm;DNA-to-binary conversion},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {SeqSecure: A Novel Web-Based Framework for Detecting Binary-Encoded Malware in DNA Sequences Using the BioHexa Algorithm},
 volume = {},
 year = {2025}
}
