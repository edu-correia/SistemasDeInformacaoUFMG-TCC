@article{Bento2020_45,
 abstract = {Abstract This study investigates the influence of supplier integration and lean practices on operational performance indicators: cost, quality, delivery, flexibility and speed of new products introduction. The proposed relationships are analyzed using survey data from a sample of 112 medium-sized textile companies in Brazil. The results suggest that supplier integration is significantly and positively associated with the speed of new products introduction, while lean practices are significantly and positively associated with operational performance indicators, except delivery. In addition, supplier integration does not support lean practices for any of operational performance indicators tested.},
 author = {Bento, Graziela dos Santos and Schuldt, Klaus Siegmar and Carvalho, Luciano Castro de},
 doi = {10.1590/0104-530x3339-20},
 number = {1},
 pages = {e3339--e3339},
 title = {The influence of supplier integration and lean practices adoption on operational performance},
 volume = {27},
 year = {2020}
}
