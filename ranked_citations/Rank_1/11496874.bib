@inproceedings{11496874,
 abstract = {Complementary FET (CFET) has emerged as a leading candidate for advanced nodes, enabling vertical nFET/pFET stacking for superior electrostatics and footprint reduction. However, conventional sequential CFET SRAM layouts remain limited by gate-to-gate spacing and routing constraints, leaving further footprint scaling underexploited. This work demonstrates a monolithic vertical four-layer CFET-based 6T SRAM cell, extending CFET stacking into a multilayer configuration. By introducing dummy-gate–assisted interconnect alignment and wordline merging, the proposed cell achieves 57% footprint reduction compared with sequential CFET SRAM. Full design technology co-optimization (DTCO) evaluation, including TCAD-to-SPICE flow and parasitic extraction, confirms 21.8% faster write delay, 25% shorter read delay, and >50% reduction in read power. To the best of our knowledge, this represents the most compact 6T SRAM reported at the 1-nm technology node, highlighting the potential of 3D device-level stacking as a key enabler for continued memory scaling.},
 author = {Zhang, Yutian and Sarfraz, Khawar and Chan, Mansun},
 booktitle = {2026 10th IEEE Electron Devices Technology & Manufacturing Conference (EDTM)},
 doi = {10.1109/EDTM65772.2026.11496874},
 issn = {},
 keyword = {Circuits;Contacts;Circuit simulation;Three-dimensional integrated circuits;Circuits and systems;Integrated circuits;Latches;Very large scale integration;Routing;Protocols;CFET;DTCO;3DIC;SRAM},
 month = {March},
 number = {},
 pages = {1-3},
 title = {DTCO-based Monolithic Vertical four-layer 6T Complementary FET SRAM Design},
 volume = {},
 year = {2026}
}
