@inproceedings{10704450,
 abstract = {In this paper, a new Merged PIN Schottky (MPS) diode concept realizing low reverse time, low specific on-resistance and good trade-off between dynamic and static characteristics is proposed. Multi-Buffer Layers (MBL) structure is implemented at the N- drift region between the N+ substrate of MPS diode, which gradually varying the doping concentration can smooth the charge distribution, reduce local electric field peaks, and decrease the interface resistance, allowing carriers to pass through more easily and lowering the forward voltage drop. Through Silvaco TCAD simulation, the proposed structure achieved a reverse recovery time of 49.13ns and a reverse recovery peak current of 16.24A, which is improved by 11.86% and 44.67% compared with the MPS diode. Moreover, the specific on-resistance of $\boldsymbol{6.98}\ \mathbf{m}\mathbf{\Omega}\cdot \mathbf{cm^{2}}$, which is improved by 34.46% compared with the MPS diode.},
 author = {Liu, Bolin and Wang, Zaixing and Jiang, Jiachi and Wang, Linchang and Wang, Bingqi and Cai, Yi},
 booktitle = {2024 6th International Conference on Electronics and Communication, Network and Computer Technology (ECNCT)},
 doi = {10.1109/ECNCT63103.2024.10704450},
 issn = {},
 keyword = {Resistance;Performance evaluation;Schottky diodes;Power transmission;High-voltage techniques;Inverters;Registers;Pins;Substrates;Optimization;MBL structure;MPS diode;specific on-resistance;reverse recovery},
 month = {July},
 number = {},
 pages = {279-282},
 title = {Performance Optimization of 4H-SiC MBL MPS Diode},
 volume = {},
 year = {2024}
}
