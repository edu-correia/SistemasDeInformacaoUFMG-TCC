 issn = {1747-3616},
 journal = {Young Consumers: Insight and Ideas for Responsible Marketers},
 keyword = {Luxury brand, Brand personality, Gen Z, Taylor Swift},
 number = {6},
 pages = {1029-1045},
 title = {Luxury brand personality: the phenomenon of Taylor Swift},
