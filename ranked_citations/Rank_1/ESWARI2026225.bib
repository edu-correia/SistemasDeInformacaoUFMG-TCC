@incollection{ESWARI2026225,
 abstract = {The Internet of Bio Nano Things (IoBNT) merges biotechnologies, nanotechnologies, and the Internet of Things to produce networked systems that monitor biological processes and respond in real time. In the fields of food safety or biocomputing, it also promotes progress in early detection, monitoring, or automation. The bio-nanosensors being used for food production can detect bacteria such as Salmonella, Escherichia coli, and many others in real time. Dangerous microorganisms can be continuously monitored through sensors embedded in food packaging or equipment. Incorporating protein or DNA-based biological receptors facilitates the early detection of contamination from pathogenic microorganisms and helps to avert cases of foodborne illnesses and unit outbreaks. IoBNT also monitors other aspects of food safety during transportation and storage, especially perishable produce. Smart packaging with bio-nanosensors can track the temperature, humidity, and pH levels of food. Products within safe parameters are continuously monitored, and real-time data transmissions to cloud platforms ensure that unsafe conditions are immediately detected and reported. Nano-biosensors are incorporated in IoBNT within packaging to conduct DNA, protein, or variety-specific marker assessments to safeguard food authenticity. All these benefits include less food wastage and more environmental and economic gains occasioned by improved quality control. Integrating bio-computing further augments food safety by conveying predictions from biological data. By combining the IoBNT capabilities with bio-computing, it interprets environmental and behavioral data to eliminate any risks in food safety.},
 author = {M. Eswari and J. Kavitha and Jayachitra Sekar and Anand Nayyar},
 booktitle = {Future of Internet of Bio-Nano Things in Personalized Healthcare},
 doi = {https://doi.org/10.1016/B978-0-443-27604-0.00010-X},
 editor = {Jayachitra Sekar and Prasanth Aruchamy and Rajesh Kumar Dhanaraj and Seifedine Kadry},
 isbn = {978-0-443-27604-0},
 keyword = {IoBNT, food safety, biocomputing, bio-nanosensors, real-time monitoring},
 pages = {225-242},
 publisher = {Academic Press},
 title = {Chapter 12 - Use case of Internet of Bio Nano things in food safety and biocomputing applications},
 url = {https://www.sciencedirect.com/science/article/pii/B978044327604000010X},
 year = {2026}
}
