 publication_stage = {Final},
 source = {Scopus},
 title = {Evaluation of Multi-Source High-Resolution Remote Sensing Image Fusion in Aquaculture Areas},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85123447079?origin=resultslist},
