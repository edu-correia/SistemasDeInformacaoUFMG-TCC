@conference{Ding2024585,
 abstract = {Deep neural network based Outlier Detection (DOD) has seen a recent surge of attention thanks to the many advances in deep learning. In this paper, we consider a critical-yet-understudied challenge with unsupervised DOD, that is, effective hyperparameter (HP) tuning/model selection. While several prior work report the sensitivity of OD models to HP settings, the issue is ever so critical for the modern DOD models that exhibit a long list of HPs. We introduce HYPER for tuning DOD models, tackling two fundamental challenges: (1) validation without supervision (due to lack of labeled outliers), and (2) efficient search of the HP/model space (due to exponential growth in the number of HPs). A key idea is to design and train a novel hypernetwork (HN) that maps HPs onto optimal weights of the main DOD model. In turn, HYPER capitalizes on a single HN that can dynamically generate weights for many DOD models (corresponding to varying HPs), which offers significant speed-up. In addition, it employs meta-learning on historical OD tasks with labels to train a proxy validation function, likewise trained with our proposed HN efficiently. Extensive experiments on different OD tasks show that HYPER achieves competitive performance against 8 baselines with significant efficiency gains.  © 2024 Copyright held by the owner/author(s).},
 author = {Ding, Xueying and Zhao, Yue and Akoglu, Leman},
 doi = {10.1145/3637528.3672003},
 journal = {Proceedings of the ACM SIGKDD International Conference on Knowledge Discovery and Data Mining},
 note = {Cited by: 7; All Open Access; Gold Open Access},
 pages = {585 - 596},
 publication_stage = {Final},
 source = {Scopus},
 title = {Fast Unsupervised Deep Outlier Model Selection with Hypernetworks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85203702186?origin=resultslist},
 year = {2024}
}
