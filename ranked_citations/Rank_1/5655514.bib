@inproceedings{5655514,
 abstract = {A fundamental contribution to satisfying future demands in air transport like gain of capacity, reduction of environmental impact, improved flight efficiency and high predictability is often the term “4D”. However, having a look at today's fleet only one out of nine aircraft is currently able to, e.g., fulfill a requested time of arrival with high accuracy. Therefore, a successful transition to a 4D-trajectory based operations strongly depends on how especially the unequipped aircraft without an onboard flight management system fit into the concept. In 2007-2009, the FAGI (Future Air Ground Integration) project investigated a new concept facilitating the transition to 4D-trajectory based air traffic management operations.},
 author = {Kuenz, Alexander and Edinger, Christiane},
 booktitle = {29th Digital Avionics Systems Conference},
 doi = {10.1109/DASC.2010.5655514},
 issn = {2155-7209},
 keyword = {Aircraft;Air traffic control;Atmospheric modeling;Merging;Trajectory;Biological system modeling;Noise},
 month = {Oct},
 number = {},
 pages = {1.E.1-1-1.E.1-11},
 title = {Green approaches without trade-off: Final results from the FAGI-project},
 volume = {},
 year = {2010}
}
