@conference{Huber20222376,
 abstract = {With a growing number of BERTology works analyzing different components of pre-trained language models, we extend this line of research through an in-depth analysis of discourse information in pre-trained and fine-tuned language models. We move beyond prior work along three dimensions: First, we describe a novel approach to infer discourse structures from arbitrarily long documents. Second, we propose a new type of analysis to explore where and how accurately intrinsic discourse is captured in the BERT and BART models. Finally, we assess how similar the generated structures are to a variety of baselines as well as their distributions within and between models. © 2022 Association for Computational Linguistics.},
 author = {Huber, Patrick and Carenini, Giuseppe},
 doi = {10.18653/v1/2022.naacl-main.170},
 journal = {NAACL 2022 - 2022 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies, Proceedings of the Conference},
 note = {Cited by: 10; All Open Access; Hybrid Gold Open Access},
 pages = {2376 - 2394},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards Understanding Large-Scale Discourse Structures in Pre-Trained and Fine-Tuned Language Models},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85138346539?origin=resultslist},
 year = {2022}
}
