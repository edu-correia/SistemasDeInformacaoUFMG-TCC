@article{TONG2025213976,
 abstract = {CO2 flooding is a vital technology for enhanced oil recovery and CO2 sequestration. However, it is limited by early breakthrough and poor sweep efficiency, particularly in fractured reservoir. The innovative use of CO2 microbubbles (MBs) has been proposed to improve the displacement performance through controlling gas mobility in fractured reservoirs. However, the microscopic mechanisms of CO2 MBs flooding remain unclear. This study investigated MBs displacement oil process in fractured reservoirs through microfluidic experiments. It revealed that the stability of CO2 MBs was significantly enhanced due to their unique three-layer structure and polymer wormlike micelles. Preferential migration of MBs with partial bubble merging and aggregation as well as viscous effect increased the flow resistance, which extended sweep range and created synergistic plugging behavior. Moreover, MBs transport additionally facilitated the emulsification effect, which was combined with wettability alternation to improve the oil washing efficiency. It was firstly observed that the unique lipophilic surface of MBs can strip and spread oil droplets, and that MBs effectively removed the dead-end oil through various distinctive behaviors. With optimization, this novel MBs flooding could achieve a maximum oil recovery of 91.04 %. These findings provide unique insights into the application of CO2 MBs for deep resource development.},
 author = {Baocai Tong and Donglei Liu and Jintao Xu and Pengfei Lv and Lanlan Jiang and Yongchen Song},
 doi = {https://doi.org/10.1016/j.geoen.2025.213976},
 issn = {2949-8910},
 journal = {Geoenergy Science and Engineering},
 keyword = {Enhanced oil recovery, CO microbubbles, Fractured reservoirs, Pore scale flow behaviors, EOR mechanisms},
 pages = {213976},
 title = {CO2 microbubbles enhanced oil recovery in fractured reservoirs},
 url = {https://www.sciencedirect.com/science/article/pii/S2949891025003343},
 volume = {253},
 year = {2025}
}
