@inproceedings{11464251,
 abstract = {The hierarchical structure of the Swin Transformer is highly compatible with speech and enables multi-level modeling at frame, word, phrase, and utterance levels. However, speech signals involve significant temporal dynamics, which poses new challenges to hierarchical modeling. To this end, we propose a hierarchical Transformer based on shifted windows for efficient aggregation of speech emotional features. Specifically, the model learns emotional representations at multiple levels through windows of different scales and a local attention mechanism. Then, block merging operations are used to compress the time dimension between different levels while expanding the feature dimension, improving modeling efficiency. Furthermore, a global attention mechanism enhances the context modeling capability at the utterance level. Experimental results show that this method achieves excellent performance on multiple datasets of speech emotion recognition, such as IEMOCAP, MELD, and CASIA.},
 author = {Zhang, Wenhao and Zhang, Peng and Zhao, Wei and Wang, Fuqiang and Li, Ye and Wu, Xiaoming},
 booktitle = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP55912.2026.11464251},
 issn = {2379-190X},
 keyword = {Protocols;HTTP;TV;Transducers;Fuses;Electronic components;Attention mechanisms;Machine learning;Learning (artificial intelligence);Artificial intelligence;Speech emotion recognition;attention mechanism;hierarchical modeling},
 month = {May},
 number = {},
 pages = {17182-17186},
 title = {Speech Emotion Recognition based on Hierarchical Transformer with Shifted Windows},
 volume = {},
 year = {2026}
}
