@conference{Wang2025,
 abstract = {Prostate cancer is the most prevalent malignant neoplasm among men worldwide, with diagnosis and prognosis primarily reliant on the Gleason grading system. However, the diagnostic process is increasingly time-consuming and inconsistent due to the large volume of whole slide image (WSI) data and the difficulties associated with acquiring labeled data. In response to these challenges, computer-aided diagnostic (CAD) tools have rapidly evolved, with weakly supervised multi-instance learning (MIL) methods emerging as dominant techniques in pathological image analysis. Despite these advances, existing MIL methods continue to struggle with managing complex tissue structures and high-dimensional features, including underutilizing the diversity of sample features and inadequately establishing contextual relationships among instances. To address these limitations, we propose a novel multi-instance learning method, termed NLGF-MIL, based on the non-hierarchical Mamba architecture, which integrates local and global features. The framework incorporates the PlainMamba layer and a hierarchical spatial convolution network (HSConv) to effectively merge these features, generating more expressive feature representations and thus improving grading accuracy. We evaluated the method on prostate datasets from the Peking Union Medical College Hospital (PUMCH) and the publicly available PANDA dataset. The results show an accuracy of 84.15% and an average AUC of 93.0% on the PUMCH dataset, and an accuracy of 64.11% and an average AUC of 89.13% on the PANDA dataset. These results outperform those of existing classical algorithms, indicating that NLGF-MIL offers significant promise for improving diagnostic accuracy and holds potential for clinical applications. © 2025 SPIE.},
 author = {Wang, Qianwen and Zhang, Hongyi and Ke, Xiaopeng and Qin, Chuanbo and Zeng, Junying and Xie, Hao and Mai, Zhipeng and Hong, Xiaochun and Mai, Chaoyun},
 doi = {10.1117/12.3064916},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
