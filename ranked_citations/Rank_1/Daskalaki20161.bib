@article{Daskalaki20161,
 abstract = {The goal of this survey is to present the state of the art instance matching benchmarks for Linked Data. We introduce the principles of benchmark design for instance matching systems, discuss the dimensions and characteristics of an instance matching benchmark, provide a comprehensive overview of existing benchmarks, as well as benchmark generators, discuss their advantages and disadvantages, as well as the research directions that should be exploited for the creation of novel benchmarks, to answer the needs of the Linked Data paradigm. © 2016 Elsevier B.V.},
 author = {Daskalaki, Evangelia and Flouris, Giorgos and Fundulaki, Irini and Saveta, Tzanina},
 doi = {10.1016/j.websem.2016.06.002},
 journal = {Journal of Web Semantics},
 note = {Cited by: 29; All Open Access; Green Open Access},
 pages = {1 - 14},
 publication_stage = {Final},
 source = {Scopus},
 title = {Instance matching benchmarks in the era of Linked Data},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84990249678?origin=resultslist},
 volume = {39},
 year = {2016}
}
