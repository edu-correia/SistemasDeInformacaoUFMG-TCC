@inproceedings{11484002,
 abstract = {This project showcases a hybrid system that can detect and quantify microplastics in water by merging deep learning and IoT-enabled sensor integration. Water sample images are processed by state-of-the-art convolutional neural network models to detect and derive microplastic particle counts and sizes concurrently with low-cost sensors measuring water quality parameters: Total Dissolved Solids (TDS), pH, turbidity and electrical conductivity. Current water testing practices, generally through sampling to a laboratory for tests, may take time and thus are not typically rapid, expensive and do not enable an immediate understanding of the quality. It is a smart monitoring system, providing water quality monitoring using IoT-based sensors and deep learning for continuous monitoring, in real-time. It will assess physical properties of water including Total Dissolved Solids (TDS), pH, turbidity and electrical conductivity to provide information on the safety of water quality and provides for monitoring for potential events of water quality before contamination occurs and is observed. It contains predictive intelligence using deep learning to provide the ability to provide information of future potential contamination before the conditions become hazardous level. It does not replace traditional threshold-based assessment systems that notify the user when a single value crosses a threshold, but it is selflearning for patterns for historical data and real-time data. The technology of the system (CNNs, RNNs) will assess complex fluid dynamics of water properties and provide possible alerts to the scientist for contamination events when they develop before they become hazardous condition first.},
 author = {P, Priya and N, Abinayasri and A, Divya Dharshini and S, Hariharan},
 booktitle = {2026 International Conference on Machine Learning and Autonomous Systems (ICMLAS)},
 doi = {10.1109/ICMLAS67792.2026.11484002},
 issn = {},
 keyword = {Optical waveguides;Optical planar waveguides;Optical propagation;Motion pictures;Programmable logic arrays;Internet of Things;Protocols;Radio frequency;Communication systems;Internet;Microplastic Detection;Deep Learning;IoT Sensors;Water Quality Monitoring;Convolutional Neural Networks (CNNs);Recurrent Neural Networks (RNNs);Predictive Intelligence;Real- time Analysis;Environmental Monitoring},
 month = {March},
