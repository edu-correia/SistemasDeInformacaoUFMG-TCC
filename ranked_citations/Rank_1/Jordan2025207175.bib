@article{Jordan2025207175,
 abstract = {Operating nodes in an L1 blockchain remains costly despite recent advances in blockchain technology. One of the most resource-intensive components of a node is the blockchain database, also known as StateDB, that manages balances, nonce, code, and the persistent storage of accounts/smart contracts. Although the blockchain industry has transitioned from forking to forkless chains due to improved consensus protocols, forkless blockchains still rely on legacy forking databases that are suboptimal for their purposes. In this paper, we propose a forkless blockchain database that avoids costly operations associated with forking. Our improved database structure exhibits a 100x improvement in storage and a 10x improvement in throughput compared to the geth-based Fantom Blockchain client. © 2013 IEEE.},
 author = {Jordan, Herbert and Jezek, Kamil and Subotic, Pavle and Scholz, Bernhard},
 doi = {10.1109/ACCESS.2025.3639677},
 journal = {IEEE Access},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {207175 - 207187},
 publication_stage = {Final},
 source = {Scopus},
 title = {Efficient Forkless Blockchain Databases},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105023890533?origin=resultslist},
 volume = {13},
 year = {2025}
}
