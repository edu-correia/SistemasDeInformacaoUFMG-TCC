@article{Cóco2025_899,
 abstract = {Abstract This paper presents a methodology for the nonlinear analysis of reinforced concrete beam structures subjected to Brazilian seismic actions and safety standards. Specific constitutive relations for concrete and steel are employed to account for cyclic loading. The implicit time integration algorithm ensures the equilibrium conditions at the end of each time step. Model results are compared with experimental data from a test structure, confirming the model's applicability. An additional example evaluates a typical structure in Rio Branco, AC, Brazil, using the Brazilian standard ABNT NBR 15421:2023 and other applicable Brazilian codes. The methodology provides insights into structural performance during an earthquake, including stress, strain, and nodal displacement histories. The results indicate that the implemented methodology is a viable option for the seismic evaluation of reinforced concrete buildings in Brazil.},
 author = {Cóco, José Vittor Siqueira and Schulz, Mauro},
 doi = {10.1590/s1983-41952025000800015},
 number = {1},
 pages = {e18115--e18115},
 title = {Nonlinear seismic analysis of a reinforced concrete building for Brazilian conditions and standards},
 volume = {18},
 year = {2025}
}
