@article{LEE2026381,
 abstract = {This article describes a novel maxillary regional superimposition method using pre- and post-treatment Cone-Beam Computed Tomography (CBCT) images and intraoral scans (IOS). 10 pre- and post-treatment CBCT and IOS were utilized to create virtual 3D models. These models were generated by merging CBCT and IOS data within image processing software. The fused models were then exported in STL format for superimposition. Initial rough alignment of pre- and post-treatment models was performed automatically using the Iterative closest point (ICP) algorithm, followed by manual refinement. To ensure accuracy and reliability, a root mean square (RMS) error and intra- and inter-rater reliability test were conducted, respectively. Color-coded distance maps allow visualization of tooth positional changes. By employing this maxillary regional superimposition technique fusing CBCT and IOS scans, a more robust, precise and comprehensive assessment of skeletal and dental changes during treatment is possible.},
 author = {Sanghee Lee and Greg J. Huang and Hayley Cowan and Yushan Huang},
 doi = {https://doi.org/10.1053/j.sodo.2025.07.006},
 issn = {1073-8746},
 journal = {Seminars in Orthodontics},
 keyword = {Cone-beam computed tomography, Intraoral scan, Superimposition},
 note = {SEMINARS IN ORTHODONTICS 30th Anniversary Issue (Part 1) Scientific Insights},
 number = {2},
 pages = {381-386},
 title = {A novel technique for maxillary regional superimposition using merged CBCTs and intra-oral scans},
 url = {https://www.sciencedirect.com/science/article/pii/S1073874625000660},
 volume = {32},
 year = {2026}
}
