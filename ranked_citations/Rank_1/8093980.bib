@inproceedings{8093980,
 abstract = {The world is increasing the need of converting into e-documents from paper based documents. While converting into e-documents, the technology in a position has to provide a large amount of memory space to store the same data's. In order to manage the huge memory, the documents are compressing before store. In connection with the above points, in this paper, we have proposed a novel lossless compression scheme of pixel based technique for compressing the grayscale images. This proposed scheme can be classified into two different processes. One is compression process before store the image and other one is decompression while retrieving the same image back. The significant of this technique is that, the image pixels positions are interchanging as much as possible within the image itself. Due to these processes, the proposed technique can be achieved the high complexity, However, it's not an easy task to retrieve the same image by third parties. In addition, the pixel based technique has obtained good quality of the reconstructed image, it has taken minimum execution time for compression and decompression processes, 60% of the original image can be reduced during the compression process and an error rate is minimum, it mean that near to zero. Finally, the proposed compression technique has provided a lossless compression for given grayscale input images.},
 author = {Narmatha, C. and Manimegalai, P. and Manimurugan, S.},
 booktitle = {2017 International Conference on Innovations in Green Energy and Healthcare Technologies (IGEHT)},
 doi = {10.1109/IGEHT.2017.8093980},
 issn = {},
 keyword = {Image coding;Gray-scale;Image reconstruction;Biomedical imaging;Conferences;Technological innovation;Medical services;LS Compression;Grayscale image;Compression;Decompression;Compression ratio},
 month = {March},
 number = {},
 pages = {1-5},
 title = {A LS-compression scheme for grayscale images using pixel based technique},
 volume = {},
 year = {2017}
}
