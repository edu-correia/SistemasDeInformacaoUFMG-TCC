@inproceedings{10692468,
 abstract = {This paper presents an advanced framework for predicting and analyzing the Remaining Useful Life (RUL) of electric vehicle reducers using a novel combination of deep learning techniques tailored for mechanical health monitoring. The proposed methodology leverages the strengths of Convolutional Long Short-Term Memory (Conv-LSTM) networks, which uniquely merge spatial understanding with temporal dependency modeling to accurately forecast the degradation process of electric vehicle reducers over time. This integration ensures that both the spatial patterns captured from sensor data and the sequential information essential for time-series analysis are comprehensively addressed. A key innovation is the incorporation of the Convolutional Block Attention Module (CBAM) into the model architecture. CBAM facilitates selective attention to significant features at multiple levels, enhancing the network's ability to discern critical wear patterns from less pertinent data. This multi-level feature extraction capability significantly boosts the model's interpretability and predictive power in identifying precursors to reducer failure. Furthermore, the implementation of dilated convolutions enriches the model's feature receptive field without escalating computational demands. By strategically increasing the spacing between kernel elements, the network gains a broader perspective of the input data, allowing it to detect global patterns indicative of impending failure without sacrificing resolution. This paper represent a significant advancement in the predictive maintenance of mechanical systems, particularly in handling complex, high-dimensional sensor data streams. The enhanced accuracy of RUL estimations, coupled with insights into the mechanisms driving reducer degradation, supports proactive maintenance strategies that aim to minimize operational downtime and reduce maintenance costs. This research underscores the potential of deep learning architectures in revolutionizing maintenance practices for critical machinery, demonstrating their efficacy in real-world applications.},
 author = {Li, Weilin and Zhang, Zhongjie and Jiang, Yangming and Wang, Keyu},
 booktitle = {2024 6th International Conference on Internet of Things, Automation and Artificial Intelligence (IoTAAI)},
 doi = {10.1109/IoTAAI62601.2024.10692468},
 issn = {},
 keyword = {Degradation;Deep learning;Accuracy;Computational modeling;Predictive models;Electric vehicles;Maintenance;Monitoring;Long short term memory;Predictive maintenance;Conv-LSTM;RUL Prediction;CBAM;Dilated Convolutions;Electric Vehicle Reducer},
 month = {July},
 number = {},
 pages = {58-64},
 title = {Prediction and Degradation Analysis Revolutionizing Electric Vehicle Reducer Prognostics: An Advanced Deep Learning Framework for Accurate RUL Prediction and Degradation Analysis},
