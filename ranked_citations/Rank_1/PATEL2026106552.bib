@article{PATEL2026106552,
 abstract = {Biological entities encompass all living or once-living components of the natural world, including molecules, cells, and organisms. Recent advancements have demonstrated the potential of incorporating small molecules, living cells, and microorganisms into polymeric nanofibers for biomedical applications. This interdisciplinary method merges nanofibers' distinctive characteristics with living entities' biological functions to tackle issues in regenerative medicine. Methods like electrospinning have successfully incorporated biological components into nanofibrous structures while preserving their viability and activity. These hybrid constructs create a conducive microenvironment that encourages cell growth, proliferation, and differentiation, thus aiding tissue regeneration. Furthermore, this cutting-edge technique is helpful in the food sector and in biocatalytic contexts. This review examines the incorporation of biological entities into polymeric nanofibers and investigates their possible applications.},
 author = {Rajkumar Patel and Pratheep Kumar Annamalai and Ramanujam Brahmadesam Thoopul Srinivasa Raghava and Madhumita Patel},
 doi = {https://doi.org/10.1016/j.reactfunctpolym.2025.106552},
 issn = {1381-5148},
 journal = {Reactive and Functional Polymers},
 keyword = {Biological entities, Nanofibers, Living microorganisms, Small molecules, Bacteria, Probiotics},
 pages = {106552},
 title = {Polymeric nanofiber systems for the encapsulation and delivery of biological entities in food, pharmaceutical, and biomedical fields},
 url = {https://www.sciencedirect.com/science/article/pii/S1381514825004043},
 volume = {218},
 year = {2026}
}
