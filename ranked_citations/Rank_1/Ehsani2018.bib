@article{Ehsani2018,
 abstract = {In this article, we summarize the methodology and the results of our 2-year-long efforts to construct a comprehensive WordNet for Turkish. In our approach, we mine a dictionary for synonym candidate pairs and manually mark the senses in which the candidates are synonymous. We marked every pair twice by different human annotators. We derive the synsets by finding the connected components of the graph whose edges are synonym senses. We also mined Turkish Wikipedia for hypernym relations among the senses. We analyzed the resulting WordNet to highlight the difficulties brought about by the dictionary construction methods of lexicographers. After splitting the unusually large synsets, we used random walk-based clustering that resulted in a Zipfian distribution of synset sizes. We compared our results to BalkaNet and automatic thesaurus construction methods using variation of information metric. Our Turkish WordNet is available online. © 2018 ACM.},
 author = {Ehsani, Razieh and Solak, Ercan and Yildiz, Olcay Taner},
 doi = {10.1145/3185664},
 journal = {ACM Transactions on Asian and Low-Resource Language Information Processing},
 note = {Cited by: 41; All Open Access; Green Open Access},
 number = {3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Constructing a WordNet for Turkish Using Manual and Automatic Annotation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85060634808?origin=resultslist},
 volume = {17},
 year = {2018}
}
