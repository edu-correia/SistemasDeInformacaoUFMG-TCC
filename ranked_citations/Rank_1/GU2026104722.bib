@article{GU2026104722,
 abstract = {Gait recognition has attracted increasing attention owing to its non-contact nature, long-range applicability, and resistance to spoofing. Nevertheless, its performance is degraded markedly under clothing changes and partial occlusions. To address these issues, this paper proposes a dual-modal gait recognition framework that fuses silhouette and skeleton maps, while incorporating three key modules —Enhanced 3D Convolution (E3D), Spatio-Temporal Multi-Scale Aggregation (STM-SA), and Periodic Spatio-Temporal Feature Modeling (PSTFM). Specifically, E3D utilizes multi-branch 3D convolutions that postpone down-sampling and concurrently extract global dynamics, instantaneous local patterns, and strip-structured information, leading to notably higher robustness and accuracy under clothing-change scenarios. STM-SA adopts a global-local dual-branch design by combining multi-scale dilated convolutions with strip-based modeling to explicitly combat occlusion. PSTFM highlights key frames and motion periodicity through the use of strip-level MLP dynamic weighting and residual periodic aggregation. These three modules operate hierarchically to implement a “fine-grained refinement-cross-scale fusion-periodic enhancement” strategy, substantially improving robustness and discriminative power in complex scenarios. Extensive experiments show that the proposed method raises the average accuracy on SUSTech1K to 87.1%, surpassing current state-of-the-art approaches by 5.8%. In the challenging clothing and occlusion subsets, precision improves by 10.9% and 4.0%, respectively. Moreover, on the CCPG dataset, our framework achieves precisions of 93.3% and 94.8% under full-body clothing change scenarios (CL-Full) and lower-body clothing change scenarios (CL-DN), establishing new state-of-the-art results.},
 author = {Junhao Gu and Xiuhui Wang},
 doi = {https://doi.org/10.1016/j.cviu.2026.104722},
 issn = {1077-3142},
 journal = {Computer Vision and Image Understanding},
 keyword = {Gait recognition, Clothing variation, Occlusion, Multimodal fusion, Spatio-temporal modeling},
 pages = {104722},
 title = {Dual-modal gait recognition with enhanced 3D convolutions and multi-scale periodic modeling},
 url = {https://www.sciencedirect.com/science/article/pii/S1077314226000895},
 volume = {267},
 year = {2026}
}
