@incollection{JAISWAL202615,
 abstract = {Chapter 1 introduces the main concepts and theoretical backgrounds of multilevel quantum metaheuristics (MQMs), presenting their nature at the cusp of quantum-inspired computing and state-of-the-art optimization. The technique employed takes advantage of the multilevel search structures which are able to explore the huge solution spaces in a hierarchical manner and meanwhile quantum-inspired methods are bringing in the probabilistic encoding, quantum superposition, and properties similar to entanglement to speed up the merging of the solutions and increase the range of their different forms. The chapter further discusses the evolution of metaheuristics from classical ones (genetic algorithms and particle swarms, to name a few) to their quantum counterparts, emphasizing how MQMs can solve the issues of premature convergence, stagnation, and computational burden in data-heavy scenarios. This introductory overview sets the stage for domain-specific applications in the forthcoming chapters.},
 author = {Smriti Jaiswal and Neha Tyagi},
 booktitle = {Multilevel Quantum Metaheuristics},
 doi = {https://doi.org/10.1016/B978-0-443-33136-7.00015-3},
 editor = {Siddhartha Bhattacharyya and Hiranmoy Roy and Jan Platoš and Leo Mršic and Balamurugan Balusamy},
 isbn = {978-0-443-33136-7},
 keyword = {Quantum-inspired computing, metaheuristics multilevel optimization, probabilistic search, quantum encoding, combinatorial optimization, heuristic frameworks, exploration–exploitation balance},
 pages = {15-50},
 publisher = {Academic Press},
 series = {Hybrid Computational Intelligence for Pattern Analysis and Understanding},
 title = {Chapter 2 - Multilevel quantum metaheuristics: applications in data exploration},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443331367000153},
 year = {2026}
}
