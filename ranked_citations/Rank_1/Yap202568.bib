@article{Yap202568,
 abstract = {Sorters are needed when a set of numerical data has to be arranged from lowest value to highest value. Even in some artificial intelligence applications, sorting of data can be a part of data processing. In many instances, sorting is done using software approach. Hardware sorters on the other hand, have also been implemented in past research. This paper seeks to implement a hardware sorter that combines the data panning sorting algorithm and insertion sorting algorithm in just one hardware model. The design is done using hardware modeling with the use of Verilog as design entry and Field Programmable Gate Array (FPGA) as the target library. Emphasis is given to hardware reuse i.e. both sorting algorithms will share the same set of hardware components for the implementation. Through hardware reuse, the prototype will be more compact as compared to having two individual circuits. The resulting hardware model shows both algorithms are practically represented by just 1 circuit. The two algorithms would differ in number of clock cycles to generate the final output. Synthesis of the integrated design shows the number of sliced registers reduced by 135, sliced Look Up Tables (LUTs) reduced by 195 and fully used LUT-Flip Flop (FF) pairs reduced by 142 when compared to the total number of components needed for two individual sorters i.e. without any integration. Simulation result shows the data panning algorithm sorts the data a lot faster, reducing the total number of clock cycles to finish sorting by more than half, when compared to the number of clock cycles needed by the insertion sorting algorithm.  © 2025 IEEE.},
 author = {Yap, Roderick and Tolentino, Anthony S.},
 doi = {10.1109/ICRAMET67419.2025.11350105},
 journal = {International Conference on Radar, Antenna, Microwave, Electronics, and Telecommunications, ICRAMET},
 note = {Cited by: 0},
