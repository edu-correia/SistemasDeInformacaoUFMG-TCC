@conference{Kong20201067,
 abstract = {In this work, we introduce a novel local autoregressive translation (LAT) mechanism into non-autoregressive translation (NAT) models so as to capture local dependencies among target outputs. Specifically, for each target decoding position, instead of only one token, we predict a short sequence of tokens in an autoregressive way. We further design an efficient merging algorithm to align and merge the output pieces into one final output sequence. We integrate LAT into the conditional masked language model (CMLM; Ghazvininejad et al., 2019) and similarly adopt iterative decoding. Empirical results on five translation tasks show that compared with CMLM, our method achieves comparable or better performance with fewer decoding iterations, bringing a 2.5x speedup. Further analysis indicates that our method reduces repeated translations and performs better at longer sentences. The code for our model is available at https://github.com/shawnkx/NAT-with-Local-AT. © 2020 Association for Computational Linguistics},
 author = {Kong, Xiang and Zhang, Zhisong and Hovy, Eduard},
 journal = {EMNLP 2020 - 2020 Conference on Empirical Methods in Natural Language Processing, Proceedings of the Conference},
 note = {Cited by: 13},
 pages = {1067 - 1073},
 publication_stage = {Final},
 source = {Scopus},
 title = {Incorporating a local translation mechanism into non-autoregressive translation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85101711423?origin=resultslist},
 year = {2020}
}
