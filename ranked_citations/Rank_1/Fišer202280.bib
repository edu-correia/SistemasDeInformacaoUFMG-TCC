@conference{Fišer202280,
 abstract = {Symbolic search using binary decision diagrams is a state-of-the-art technique for cost-optimal planning. Heuristic search in this context has been problematic as even a very informative heuristic can be detrimental in case it induces difficult-to-represent state partitionings. It was recently shown that operator-potential heuristics can address this issue in forward search by computing a numeric potential for each operator corresponding to the change of the heuristic value induced by that operator. Forward search is, however, not the best known variant of symbolic search. Here we investigate the integration with backward and bi-directional search instead. We prove that forward search (distance-to-goal) operator-potential heuristics can be turned into backward search (distance-to-initial-state) heuristics elegantly in this context, by summing the backward search path operator-potentials with the initial state goal-distance estimate. We run exhaustive experiments on IPC benchmarks, showing that significant performance improvements can be obtained over symbolic forward search and other state-of-the-art techniques. © 2022, Association for the Advancement of Artificial Intelligence.},
 author = {Fišer, Daniel and Torralba, Álvaro and Hoffmann, Jörg},
 doi = {10.1609/icaps.v32i1.19788},
 journal = {Proceedings International Conference on Automated Planning and Scheduling, ICAPS},
 note = {Cited by: 4; All Open Access; Gold Open Access},
 pages = {80 - 89},
 publication_stage = {Final},
 source = {Scopus},
 title = {Operator-Potentials in Symbolic Search: From Forward to Bi-directional Search},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85142621353?origin=resultslist},
 volume = {32},
 year = {2022}
}
