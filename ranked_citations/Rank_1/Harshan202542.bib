@conference{Harshan202542,
 abstract = {The early identification of pulmonary nodules within CT scans serves as a crucial element for enhancing lung cancer patient outcomes. This research introduces an innovative dual deep learning system which combines two-dimensional (2D) and three-dimensional (3D) convolutional neural networks to detect and segment nodules simultaneously. The proposed architecture divides into parallel 2D and 3D feature extraction streams which merge through a size-Aware attention mechanism that adjusts weights according to nodule features. The approach uses multi-Task learning to optimize classification and segmentation jointly which results in better accuracy alongside improved computational efficiency. Our approach demonstrates superior performance on the LIDC-IDRI dataset by achieving an AUC of 0.92 for malignancy classification and a Dice coefficient of 0.89 for segmentation than all other state-of-The-Art 2D, 3D and hybrid models. The obtained results show how adaptive hybrid architectures can be used to create robust systems for clinical lung nodule analysis. © 2025 IEEE.},
 author = {Harshan and Kiran, K. and Singh, Upasana and Yadav, Hemant Kumar and Kuchipudi, Bhavik and Kapoor, Jolly Sneh},
 doi = {10.1109/SISIMPACT67725.2025.11439728},
 journal = {Proceedings - 2025 IEEE 1st International Conference on Smart Innovations in Systems, Infrastructure, Mechanical, Power, AI and Computing Technologies, SISIMPACT 2025},
 note = {Cited by: 0},
 pages = {42 - 47},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi-Task Pulmonary Nodule Detection and Segmentation in CT Scans Using Hybrid 2D-3D Deep Learning with Size-Aware Attention},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105037453521?origin=resultslist},
