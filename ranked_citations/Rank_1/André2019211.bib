@article{André2019211,
 abstract = {Parametric timed automata (PTA) extend timed automata by allowing parameters in clock constraints. Such a formalism is for instance useful when reasoning about unknown delays in a timed system. Using existing techniques, a user can synthesize the parameter constraints that allow the system to reach a specified goal location, regardless of how much time has passed for the internal clocks. We focus on synthesizing parameters such that not only the goal location is reached, but we also address the following questions: what is the minimal time to reach the goal location? and for which parameter values can we achieve this? We analyse the problem and present a semi-algorithm to solve it. We also discuss and provide solutions for minimizing a specific parameter value to still reach the goal. We empirically study the performance of these algorithms on a benchmark set for PTAs and show that minimal-time reachability synthesis is more efficient to compute than the standard synthesis algorithm for reachability. Data or code related to this paper is available at: [26]. © 2019, The Author(s).},
 author = {André, Étienne and Bloemen, Vincent and Petrucci, Laure and van de Pol, Jaco},
 doi = {10.1007/978-3-030-17465-1_12},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 7; All Open Access; Green Open Access; Hybrid Gold Open Access},
 pages = {211 - 228},
 publication_stage = {Final},
 source = {Scopus},
 title = {Minimal-time synthesis for parametric timed automata},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85064558611?origin=resultslist},
 volume = {11428 LNCS},
 year = {2019}
}
