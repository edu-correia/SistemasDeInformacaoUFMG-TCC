@conference{Ashkiani2018430,
 abstract = {We develop a dynamic dictionary data structure for the GPU, supporting fast insertions and deletions, based on the Log Structured Merge tree (LSM). Our implementation on an NVIDIA K40c GPU has an average update (insertion or deletion) rate of 225 M elements/s, 13.5x faster than merging items into a sorted array. The GPU LSM supports the retrieval operations of lookup, count, and range query operations with an average rate of 75 M, 32 M and 23 M queries/s respectively. The trade-off for the dynamic updates is that the sorted array is almost twice as fast on retrievals. We believe that our GPU LSM is the first dynamic general-purpose dictionary data structure for the GPU. © 2018 IEEE.},
 author = {Ashkiani, Saman and Li, Shengren and Farach-Colton, Martin and Amenta, Nina and Owens, John D.},
 doi = {10.1109/IPDPS.2018.00053},
 journal = {Proceedings - 2018 IEEE 32nd International Parallel and Distributed Processing Symposium, IPDPS 2018},
 note = {Cited by: 17; All Open Access; Green Open Access},
 pages = {430 - 440},
 publication_stage = {Final},
 source = {Scopus},
 title = {GPU LSM: A dynamic dictionary data structure for the GPU},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85052232891?origin=resultslist},
 year = {2018}
}
