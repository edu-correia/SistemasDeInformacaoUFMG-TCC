@inproceedings{10979735,
 abstract = {This paper presents the assessment process of a protection and control (PAC) scheme for DC microgrids, developed as part of the Horizon 2020 TIGON project. The project focuses on the deployment and integration of DC-based grid architectures, with two real-world demonstrators serving as case studies. One of these demonstrators, located in Spain, includes a 3 kV DC network protected by a novel PAC scheme designed and validated within the scope of TIGON. The proposed PAC scheme integrates current transducers and synchronized merging units for metering, contactors for fault isolation, and a general-purpose edge server for implementing two dedicated protection algorithms. To support the development and evaluation of the scheme, a laboratory testing platform was also created within the project. Both the laboratory platform and the protection algorithms are described in this paper. Prior to field deployment, the scheme was rigorously tested on the platform, which provided a controlled environment for performance evaluation and debugging. This platform enables the analysis of DC protection algorithms and the identification of potential weaknesses and opportunities for improvement. Additionally, the proposed protection algorithms for the Spanish TIGON demonstrator successfully detected faults in the DC microgrid with a response time of less than 1 milliseconds.},
 author = {Matute, Roberto M. and Villén, María T. and Ríos, Guillermo and Prada, Aníbal A. and Martínez, Eduardo and Oliván, Miguel A. and Fuentes, Ana M.},
 booktitle = {19th IET Conference on Developments in Power System Protection (DPSP Europe 2025)},
 doi = {10.1049/icp.2025.1048},
 issn = {},
 keyword = {},
 month = {April},
 number = {},
 pages = {81-85},
 title = {Assessment of PAC solutions on edge server for DC microgrids using a laboratory testing platform},
 volume = {2025},
 year = {2025}
}
