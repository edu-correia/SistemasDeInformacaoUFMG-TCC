@article{8215017,
 abstract = {We present an analysis of Chandra observations of the galaxy clusters A 2670 and A 2107. Their cD galaxies have large peculiar velocities ($>200 \,\mathrm{km} \,\mathrm{s}^{-1} >200 \,\mathrm{km} \,\mathrm{s}^{-1}$) and thus the clusters appear to be undergoing mergers. In A 2670, we find a comet-like structure around one of the brightest galaxies. At the leading edge of the structure, there is a cold front. The mass of the X-ray gas in the comet-like structure suggests that the galaxy was in a small cluster or group, and its intracluster medium is being stripped by ram-pressure. The regions of cool interstellar medium of the cD galaxies in A 2670 and A 2107 are very compact. This is similar to the brightest galaxies in the Coma cluster, which is also a merging cluster. In each galaxy, the short cooling time of the ISM requires a heating source; the compact nature of the ISM makes it unlikely that the heating source is a central active galactic nucleus.},
 author = {Fujita, Yutaka and Sarazin, Craig L. and Sivakoff, Gregory R.},
 doi = {10.1093/pasj/58.1.131},
 issn = {2053-051X},
 journal = {Publications of the Astronomical Society of Japan},
 keyword = {galaxies: clusters: intracluster medium;galaxies: clusters: general;galaxies: clusters: individual (Abell 2107, Abell 2670);intergalactic medium;X-rays: galaxies: clusters},
 month = {Feb},
 number = {1},
 pages = {131-141},
 title = {Chandra Observations of A 2670 and A 2107: A Comet Galaxy and cDs with Large Peculiar Velocities},
 volume = {58},
 year = {2006}
}
