@article{10.1145/3801971,
 abstract = {Video is an ideal medium for covert communication due to its traffic volume and the many possible embedding domains offered by motion-compensated compression. This review of 30 years of video steganography research, including steganalysis and deep learning approaches, proposes a unified taxonomy and uses it to map developments across 347 sources. Many of these sources simply apply image steganography to video, and only a few critically evaluate security. The review identifies connections between these papers and highlights common pitfalls that hinder comparability. The state-of-the-art is characterized by a discussion of selected landmark papers in each embedding domain, followed by recommendations for future work.},
 address = {New York, NY, USA},
 articleno = {281},
 author = {Lachner, Verena and B\"{o}hme, Rainer},
 doi = {10.1145/3801971},
 issn = {0360-0300},
 issue_date = {August 2026},
 journal = {ACM Comput. Surv.},
 keyword = {Video steganography, video steganalysis, video compression},
 month = {April},
 number = {11},
 numpages = {35},
 publisher = {Association for Computing Machinery},
 title = {A Critical Survey on Video Steganography: Trends, Pitfalls, and Recommendations},
 url = {https://doi.org/10.1145/3801971},
 volume = {58},
 year = {2026}
}
