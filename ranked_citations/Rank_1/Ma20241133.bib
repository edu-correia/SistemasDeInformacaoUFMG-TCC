@conference{Ma20241133,
 abstract = {In recent years, hybrid modeling approaches that integrate U-shaped networks with Transformer architectures have demonstrated significant potential in achieving precise and automatic segmentation of medical images. Nonetheless, these models exhibit a deficiency in extracting meaningful pixel features across both spatial and channel dimensions. To address these challenges and improve the model's capability to merge local attributes with overall context, while also accurately identifying spatial and channel dependencies, we propose the AMFF-NET, a new adaptive multi-layer feature fusion network. Specifically, AMFF-NET enhances the representation of foreground information in medical images by integrating a Partial Convolution and Attention Hybrid module (PCAH) with the Transformer framework. Moreover, the incorporation of an Upsampled Partial Convolution Block (UPCB) and a Parallel Channel and Spatial Attention module (PCSA) within the decoder facilitates further refinement of foreground details, while minimizing background distractions. This method allows the model to more efficiently grasp dependencies across channel and spatial dimensions. Extensive experimentations on publicly available datasets validate the superior performance of AMFF-NET. © 2024 Copyright held by the owner/author(s).},
 author = {Ma, Ruirui and Jiang, Shaochen and Wang, Liejun},
 doi = {10.1145/3690407.3690595},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 0},
 pages = {1133 - 1138},
 publication_stage = {Final},
 source = {Scopus},
 title = {AMFF-NET: Adaptive Multi-Layer Feature Fusion Network for Medical Image Segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85212583971?origin=resultslist},
 year = {2024}
}
