@article{XIAO2026172942,
 abstract = {The diamondback moth (Plutella xylostella), a highly destructive pest of cruciferous crops, has developed resistance to numerous commercial insecticides, prompting the need for sustainable and effective alternatives. This study aimed to construct a biocompatible Pickering emulsion gel (MO@PKEG) encapsulating white mustard essential oil (MO), stabilized by zein-tannic acid nanoparticles (ZT NPs) and sodium alginate (SA), to achieve dual “attract-and-kill” functionality. Mediated by anti-solvent precipitation and high-shear emulsification, MO@PKEG was obtained, with the high storage stability, uniform droplet size distribution (∼30 μm), and enhanced viscoelastic properties with SA addition. Confocal and cryo-SEM imaging revealed dense interfacial packing of ZT NPs and formation of a stable three-dimensional network. MO@PKEG(+SA) exhibited strong leaf adhesion across four cruciferous vegetable species for up to 2 h without runoff. Behavioral assays showed that MO@PKEG significantly attracted more P. xylostella larvae than controls, via host-mimicking olfactory cues, while simultaneously inducing a potent antifeedant effect upon contact/ingestion, reducing leaf feeding area (down to 14.1% vs. ∼70% in controls) and achieving 100% larval mortality within 24 h. Treated P. xylostella larvae with MO@PKEG exhibited growth inhibition, melanization, gut epithelial rupture, and complete failure in pupation and eclosion. 16S rRNA sequencing revealed a marked reduction in gut microbial diversity, significant shifts in community structure, and enrichment of taxa linked to gut barrier disruption and larval toxicity. In summary, MO@PKEG integrates host-mimicking olfactory cues and gut-targeted toxicity within a stable, biodegradable carrier, offering a promising strategy for eco-friendly control of P. xylostella. This work provides a mechanistically supported platform for developing next-generation green pesticides against P. xylostella.},
 author = {Meng Xiao and Xirui Chen and Xiaoqin Zhao and Qiuxia Li and Chaoyi Peng and Xiaozhuo Chen and Yanjun Lin and Jingjing Li and Jinming Zhang},
 doi = {https://doi.org/10.1016/j.cej.2026.172942},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {, Host-selection speciality, Mustard oil, Cruciferous vegetables, Environmentally friendly pesticide},
 pages = {172942},
 title = {An eco-friendly Pickering emulsion gel loading white mustard essential oil for attract-and-kill control of Plutella xylostella larvae},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894726003992},
 volume = {529},
 year = {2026}
}
