@conference{Ye20181,
 abstract = {This paper presents an efficient architecture of number Theoretical transform (NTT), targeting at fulfilling large integer multiplication for fully homomorphic encryption applications. A systematic memory management scheme is proposed for the pipelined shared-memory NTT architecture implemented with mixed-radix multi-path delay commutators (MDCs). The presented data relocation scheme along with the MDC can be applied to merge multiple banks with single-port memory for further reducing the area requirement. Experimental results show that a 1,179,648-bit multiplier implemented by the proposed solution, including seamless data transfer among the building blocks, can lead to more than 39.8% area reduction with even a lower computational time as compared with the related works. © 2018 IEEE.},
 author = {Ye, Jheng-Hao and Shieh, Ming-Der},
 doi = {10.1109/VLSI-DAT.2018.8373254},
 journal = {2018 International Symposium on VLSI Design, Automation and Test, VLSI-DAT 2018},
 note = {Cited by: 5},
 pages = {1 - 4},
 publication_stage = {Final},
 source = {Scopus},
 title = {High-performance NTT architecture for large integer multiplication},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85049310392?origin=resultslist},
 year = {2018}
}
