@conference{Nelson-Slivon2022368,
 abstract = {We present bundled references, a new building block to provide linearizable range query operations for highly concurrent lock-based linked data structures. Bundled references allow range queries to traverse a path through the data structure that is consistent with the target atomic snapshot. We demonstrate our technique with three data structures: a linked list, skip list, and a binary search tree. Our evaluation reveals that in mixed workloads, our design can improve upon the state-of-the-art techniques by 1.2x-1.8x for a skip list and 1.3x-3.7x for a binary search tree. We also integrate our bundled data structure into the DBx1000 in-memory database, yielding up to 40% gain over the same competitors.  © 2022 Owner/Author.},
 author = {Nelson-Slivon, Jacob and Hassan, Ahmed and Palmieri, Roberto},
 doi = {10.1145/3503221.3508412},
 journal = {Proceedings of the ACM SIGPLAN Symposium on Principles and Practice of Parallel Programming, PPOPP},
 note = {Cited by: 13; All Open Access; Gold Open Access},
 pages = {368 - 384},
 publication_stage = {Final},
 source = {Scopus},
 title = {Bundling Linked Data Structures for Linearizable Range Queries},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85127537091?origin=resultslist},
 year = {2022}
}
