 keyword = {Multiscan, tUS, musculoskeletal system},
 note = {The 20th Congress of World Federation for Ultrasound in Medicine and Biology},
 pages = {S230},
 title = {ULTRASOUND TOMOGRAPHY IN THE ASESSEMENT OF MUSCULOSCELETAL SYSTEM INJURIES},
