@inproceedings{4425534,
 abstract = {This paper presents an improved structure of Jump Index for trustworthy key search retention, called Random Jump Index. Unlike Jump Index, in which sequences must be strictly monotonically increased, this new jump index supports inserting of random sequences. This property enhances the efficiency of building index largely compared with Jump Index. Random Jump Index has the similar query efficiency of Jump Index. The structure of random jump ensures that every element has the unique and fixed path in this index, the index is fossilized. Therefore, Random Jump Index is a trustworthy index.},
 author = {Huang, He and Liu, Fengchen and Liu, Qingwen},
 booktitle = {2007 International Conference on Computational Intelligence and Security Workshops (CISW 2007)},
 doi = {10.1109/CISW.2007.4425534},
 issn = {},
 keyword = {Random sequences;Educational institutions;Intrusion detection;Buildings;Computational intelligence;Security;Helium;Computer science;Space technology;Merging},
 month = {Dec},
 number = {},
 pages = {464-467},
 title = {Random Jump Index: A Trustworthy Index for Random Insertion},
 volume = {},
 year = {2007}
}
