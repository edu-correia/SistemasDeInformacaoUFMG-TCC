@article{Dassow2021119,
 abstract = {In an external contextual grammar with selection, contexts are associated with selection languages, and the context (u,v) can be wrapped around a word w if and only if w belongs to the selection language associated with (u,v). In the papers [1], [3], [4], and [6], some hierarchies are presented if selection languages are taken from subregular language families, defined by automata-theoretic and combinatorial properties, codes, and ideals. In this paper we merge and complete the hierarchies. © 2020 Elsevier B.V.},
 author = {Dassow, Jürgen},
 doi = {10.1016/j.tcs.2020.07.028},
 journal = {Theoretical Computer Science},
 note = {Cited by: 5},
 pages = {119 - 129},
 publication_stage = {Final},
 source = {Scopus},
 title = {Remarks on external contextual grammars with selection},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85089013437?origin=resultslist},
 volume = {862},
 year = {2021}
}
