@article{KLAINA2026102039,
 abstract = {This paper presents an Extended Reality application developed for the Meta Quest headset to support precision irrigation in vineyards through immersive, real-time soil monitoring. The system integrates SDI-12 probes that monitor volumetric water content and temperature at four different depths (10–40 cm) in vineyard plots in Artajona, Navarra, transmitting data every 20 min to a cloud server using Narrowband Internet of Things (NB-IoT) connection. The application securely retrieves both real-time and historical measurements through a Representational State Transfer Application Programming Interface (REST API) and visualizes them in an interactive Extended Reality (XR) environment built in Unity using the Meta XR SDK. Users can navigate the vineyard digitally in Virtual Reality, or through Mixed Reality passthrough to simultaneously inspect real vines with superimposed analytical panels. The interface incorporates hand-tracking, ray, and poke interactions for intuitive data exploration, and includes features such as accumulated water estimation, depth-based soil visualization, satellite-derived indices, and real-time meteorological data. Virtual Reality (VR) mode provides an immersive space for remote exploration and situational assessment, while Mixed Reality (MR) mode enhances on-site decision-making by merging physical and digital information. Results from the deployment show that combining NB-IoT sensing with immersive XR is designed to improve situational awareness, enhance data interpretation, and support more informed and timely irrigation decisions. The primary innovation of this framework lies in the transition from abstract 2D dashboards to a hands-free, spatially contextualized environment that bridges the gap between digital analytics and physical field operations. This framework enables direct, intuitive, real-time correlation of subterranean moisture profiles and other in-situ sensor data with specific vines. This spatial synchronization facilitates immediate, data-driven decision-making, empowering users to execute precise agricultural interventions based on live telemetry without interrupting field operations. The system demonstrates a scalable and extensible approach for integrating XR with Low Power Wide Area Network (LPWAN)-based agricultural sensing, offering a promising pathway toward more efficient and sustainable vineyard management.},
 author = {Hicham Klaina and Amelia Bellosta-Diest and Peio Lopez-Iturri and Imanol Picallo and Francisco Falcone and Miguel Ángel Campo-Bescós},
 doi = {https://doi.org/10.1016/j.atech.2026.102039},
 issn = {2772-3755},
 journal = {Smart Agricultural Technology},
 keyword = {Extended reality, Precision irrigation, NB-IoT, Soil moisture monitoring, Vineyard management, Immersive monitoring},
 pages = {102039},
 title = {Immersive NB-IoT-enabled vineyard soil monitoring using extended reality},
 url = {https://www.sciencedirect.com/science/article/pii/S2772375526002625},
 volume = {14},
 year = {2026}
}
