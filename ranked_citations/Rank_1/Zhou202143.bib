@article{Zhou202143,
 abstract = {Privacy protection is an essential issue in biomedical natural language processing (BioNLP). Recently, some researchers apply federated learning (FL) in BioNLP to protect the privacy of biomedical data. However, their methods are only applicable for small NLP models, whose effectiveness is heavily limited in processing biomedical data. In this paper, we propose a novel memetic federated learning framework named Mem-Fed, which is tailored for federated learning of large-scale NLP models in the biomedical scenario. Experiments with large-scale BioNLP model on the public dataset show that the proposed framework significantly outperforms the state-of-the-art counterparts. © 2021, Springer Nature Switzerland AG.},
 author = {Zhou, Xinya and Tan, Conghui and Jiang, Di and Zhang, Bosen and Li, Si and Xu, Yajing and Xu, Qian and Gao, Sheng},
 doi = {10.1007/978-3-030-88483-3_4},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {43 - 55},
 publication_stage = {Final},
 source = {Scopus},
 title = {Memetic Federated Learning for Biomedical Natural Language Processing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85118134432?origin=resultslist},
 volume = {13029 LNAI},
 year = {2021}
}
