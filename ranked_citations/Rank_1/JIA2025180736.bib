@article{JIA2025180736,
 abstract = {Various compression-torsion (CT) deformation paths using the same strain were conducted on extruded AZ31 magnesium bars which had a strong basal texture. The optical microscopy (OM) and electron backscatter diffraction (EBSD) techniques were utilized to probe the effects of varying CT paths on the microstructure and texture. The findings demonstrated that, under the same strain, compression deformation resulted in significantly stronger grain refinement compared to torsion deformation. Compression deformation primarily refined the grains via the twinning mechanism, with twinning reaching growth completion and merging at a true strain of 0.5. Conversely, torsion deformation refined the grains through the activation of basal slip via shear force, followed by twinning and dynamic recrystallization (DRX) mechanisms. The primary deformation mechanisms observed in the C-T sample were continuous dynamic recrystallization (CDRX), discontinuous dynamic recrystallization (DDRX), and twinning. Meanwhile, both CDRX and DDRX were dominant in the T-C sample, and CDRX, DDRX, and twinning were the primary modes of deformation in the CT sample. Moreover, some grains in both T-C and CT samples were found to orient towards the easiest non-basal slip activation direction, which resulted in the presence of rare earth (RE) texture components. No RE texture component was detected in the C-T sample. The analysis of the grain size and texture distribution range and intensity in various paths led to the conclusion that CT deformation created the smallest grained structure and weakest texture, which was also widely distributed compared to C-T and T-C deformation.},
 author = {Leichen Jia and Zhimin Zhang and Yong Xue and Jingxin Sun and Feilong Mao and Baohui Xu},
 doi = {https://doi.org/10.1016/j.jallcom.2025.180736},
 issn = {0925-8388},
 journal = {Journal of Alloys and Compounds},
 keyword = {Compression-torsion, Texture, DRX},
 pages = {180736},
 title = {The twinning and DRX mechanisms of AZ31 Mg alloy by comparing compressive/shear/compressive-shear deformation},
 url = {https://www.sciencedirect.com/science/article/pii/S0925838825022972},
 volume = {1030},
 year = {2025}
}
