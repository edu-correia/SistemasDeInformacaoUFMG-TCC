@conference{Sun201815,
 abstract = {Enormous data are generated in the Internet of Things(IoT), and high-speed data transport methods are needed in the Smart IoT network. The parallel transmission techniques can greatly improve the throughput in wireless transmission systems. SCTP is a transport layer supports parallel transmissions and can cooperate with other layers' techniques. To achieve parallel transmission in the transport layer for the smart IoT networks, simulations compare the performance of SCTP and TCP in Smart IoT network under different packet error rate. The dynamic multi-path switching method for SCTP (MS-SCTP) is proposed to improve the transmission performance in error occurred network. MS-SCTP selects transmission paths based on packet error rate. The re-transport proportions in the send buffers can reflect the rate. Analysis and simulation results show that the MS-SCTP can improve the network throughput, reduce the packet loss rate in different networks packet error rates, which can be cooperated with other techniques as MIMO and channel assignment algorithms. © 2018 IEEE.},
 author = {Sun, Weifeng and Yu, Shumiao and Xing, Yuanxun and Zhang, Danchuang},
 doi = {10.1109/SmartIoT.2018.00013},
 journal = {Proceedings - 2018 IEEE International Conference on Smart Internet of Things, SmartIoT 2018},
 note = {Cited by: 3},
 pages = {15 - 22},
 publication_stage = {Final},
 source = {Scopus},
 title = {A multi-path switching method based on SCTP for heterogeneous wireless networks in smart IoT},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85054507271?origin=resultslist},
 year = {2018}
}
