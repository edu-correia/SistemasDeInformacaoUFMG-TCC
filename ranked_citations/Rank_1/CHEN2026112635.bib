@article{CHEN2026112635,
 abstract = {The performance of drone-view object detection (DroneDet) models significantly deteriorates in nighttime scenes. Although various low-light image enhancement (LIE) methods have been introduced, they often degrade the texture features of objects in nighttime images. However, combining the original images’ natural features with enhanced images’ visibility information for nighttime DroneDet is more efficacious. In this context, we propose a cross-domain feature fusion network (CFFN) to address the challenges of low illumination and poor recognition in nighttime scenarios. First, our network employs an offline LIE method to generate high-visibility images. Second, we design a dynamic spatial feature reconstruction module to align feature information across different domains. Third, we introduce a cross-domain feature fusion module (CDFFM) to promote mutual integration and compensation of feature information between the original and enhanced images. Additionally, we propose an adaptive spatial feature aggregation mechanism within CDFFM to reduce noise from enhanced images and control the fusion rate. We present a new paradigm for nighttime DroneDet and conduct extensive experiments on four publicly available datasets, demonstrating that our proposed CFFN model achieves state-of-the-art performance.},
 author = {Xiangqi Chen and Chengzhuan Yang and Jiashuaizi Mo and Yaxin Sun and Li Zhao and Hao Chen and Zhonglong Zheng},
 doi = {https://doi.org/10.1016/j.patcog.2025.112635},
 issn = {0031-3203},
 journal = {Pattern Recognition},
 keyword = {Drone-view object detection, Cross-domain, Nighttime scenes, Low-light image enhancement, Feature fusion},
 pages = {112635},
 title = {A cross-domain feature fusion network for nighttime drone-view object detection},
 url = {https://www.sciencedirect.com/science/article/pii/S0031320325012981},
 volume = {172},
 year = {2026}
}
