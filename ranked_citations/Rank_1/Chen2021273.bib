@conference{Chen2021273,
 abstract = {With the rapid development of information technology, the general courses of 'University Computer Foundation' in the non-computer major in western universities are facing many difficulties and higher requirements and challenges. In the context of teaching reform in Colleges and universities, blended teaching has become one of the effective ways to solve the above problems. In this regard, the teaching team of 'University Computer Foundation' of Yunnan Normal University, based on the modern education concept of students as the center, adopts the online and offline mixed teaching mode of 'MOOC +SPOC+ physical classroom', and obtains good teaching effect in the post epidemic period. © 2021 IEEE.},
 author = {Chen, Juan and Wang, Yong and Yang, Ying},
 doi = {10.1109/CSEI51395.2021.9477737},
 journal = {2021 IEEE 3rd International Conference on Computer Science and Educational Informatization, CSEI 2021},
 note = {Cited by: 0},
 pages = {273 - 276},
 publication_stage = {Final},
 source = {Scopus},
 title = {Application of SPOC Based Online and offline Hybrid Teaching Design in University Computer Foundation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85111681238?origin=resultslist},
 year = {2021}
