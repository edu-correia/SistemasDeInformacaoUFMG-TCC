@inproceedings{5286049,
 abstract = {Measuring Inconsistency in ontologies is an important topic in ontology engineering as it can provide extra information for dealing with inconsistency. Many approaches have been proposed to deal with this issue. However, the main drawback of these algorithms is their high computational complexity. One of the main sources of the high complexity is the intractability of the underlying Description Logics (DLs). In this paper, we focus on an important tractable DL family, \emph{DL-Lite}. We define an inconsistency degree of a \emph{DL-Lite} ontology based on a three-valued semantics. We also present an algorithm to compute this inconsistency degree and show that its time-complexity is PTime in the size of ABox and TBox.},
 author = {Zhou, Liping and Huang, Houkuan and Qi, Guilin and Ma, Yue and Huang, Zhisheng and Qu, Youli},
 booktitle = {2009 IEEE/WIC/ACM International Joint Conference on Web Intelligence and Intelligent Agent Technology},
 doi = {10.1109/WI-IAT.2009.61},
 issn = {},
 keyword = {Ontologies;Intelligent agent;Conferences;Computer science;Computational complexity;Merging;Debugging;Proposals;Automatic logic units;Time measurement;Measuring;Inconsistency Degree;DL-Lite;ontologies},
 month = {Sep.},
 number = {},
 pages = {349-356},
 title = {Measuring Inconsistency in DL-Lite Ontologies},
 volume = {1},
 year = {2009}
}
