@inproceedings{11210901,
 abstract = {Neural surface reconstruction has emerged as a powerful approach for 3D modeling but faces challenges in computational efficiency and handling dynamic scenes. Current methods struggle with long training times and inadequate handling of inter-frame relationships in dynamic reconstruction. We present Faster-Neus2, which introduces (1) a CUDA-optimized backpropagation kernel that merges forward pass and backpropagation into a single GPU kernel, and (2) an optimal frame selection strategy that identifies the most suitable reference frame for dynamic reconstruction. Experiments on the DTU, Lego, and Dynacap datasets demonstrate that Faster-Neus2 achieves up to 11.2% faster training times compared to Neus2 [1] while improving reconstruction quality, with PSNR improvements of up to 1.71 dB on dynamic scenes. The results suggest that our approach offers a promising direction for efficient and high-quality neural surface reconstruction in both static and dynamic scenarios, with code available at https://github.com/wilkinszhang/Faster-Neus2.},
 author = {Zhang, Weijian and Tao, Shuguang},
 booktitle = {2025 10th International Conference on Big Data Analytics (ICBDA)},
 doi = {10.1109/ICBDA65366.2025.11210901},
 issn = {2832-3734},
 keyword = {Backpropagation;Training;Surface reconstruction;Three-dimensional displays;Graphics processing units;Parallel processing;Computational efficiency;Kernel;Time complexity;Surface treatment;Surface reconstruction;Computer vision;Deformation;Graphics processing units;Parallel processing},
 month = {March},
 number = {},
 pages = {337-342},
 title = {Faster-Neus2: Neural Surface Representation Based on Cohesive Backpropagation Computation and Optimal Frame Selection},
 volume = {},
 year = {2025}
}
