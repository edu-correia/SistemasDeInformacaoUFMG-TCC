@article{ZHAO2026132577,
 abstract = {Open-domain question answering (ODQA) is a critical knowledge-intensive task. Recent efforts have explored integrating retrieved documents from external sources and generated documents produced by large language models (LLMs) to improve QA performance. However, the challenge of effectively combining the strengths of both types of sources remains an open issue, and relatively little is known about how to determine which one is more relevant to the question during interactive similarity comparison. In this paper, we propose a novel approach that integrates retrieved documents with generated ones by reranking them through a well-trained generative listwise reranker. Our method leverages knowledge distillation tailored for ODQA, followed by supervised fine-tuning to train a generative listwise reranking model that generates top-k documents list, improving relevance to the question and maximizing the likelihood of containing answers. In addition, to enhance the diversity and informativeness of documents generated by LLMs, we introduce a clustering-based retrieval method that groups in-context learning (ICL) demonstrations into distinct clusters. Subsequently, we retrieve ICL examples based on their similarity to the query from each cluster, with the aim of constructing prompts that facilitate the generation of documents offering a broad range of perspectives. We conduct comprehensive experiments on five widely used ODQA benchmarks, and the experimental results fully demonstrate the effectiveness of our approach in merging both external and internal knowledge.},
 author = {Yi Zhao and Yanxiang He and Xiaotong Zhang and Weidong Wen},
 doi = {https://doi.org/10.1016/j.neucom.2025.132577},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {Open-domain question answering, In-context learning, LLM, Information retrieval, NLP, Artificial intelligence},
 pages = {132577},
 title = {Combining retrieved with generated contexts via a listwise reranker for open-domain question answering},
 url = {https://www.sciencedirect.com/science/article/pii/S0925231225032497},
 volume = {670},
 year = {2026}
}
