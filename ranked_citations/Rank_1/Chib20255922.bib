@conference{Chib20255922,
 abstract = {Text-to-Image models have demonstrated remarkable performance in generating high-quality images from text prompts, but often struggle to conceptually interpret images by identifying their constituent components. The recently proposed problem of Unsupervised Concept Extraction addresses this limitation by learning embeddings of multiple concepts from a single image without requiring human annotations. Existing methods rely on generating intermediate masks for major concepts and iteratively refining embeddings using a pre-trained diffusion model. However, these approaches face challenges in producing accurate and comprehensive masks, which significantly degrades the quality of the learned embeddings. In this work, we present Auto Concept, a novel framework for generating tighter and more complete masks, resulting in improved inference capabilities. AutoConcept leverages features from image patches to form initial clusters, filters out background clusters, and merges relevant foreground clusters to construct concept masks. Our novel pipeline then iteratively refined the em-beddings associated with each localized concept. Extensive experiments on three datasets, containing diverse categories of images, demonstrate that AutoConcept offers a promising solution for Unsupervised Concept Extraction tasks and achieves a significant improvement in evaluation metries. © 2025 IEEE.},
 author = {Chib, Pranav Singh and Patel, Kirtankumar Vijaykumar and Gupta, Mudit and Kalidas, Pise Ashutosh and Singh, Pravendra},
 doi = {10.1109/ICCVW69036.2025.00617},
 journal = {Proceedings - 2025 IEEE/CVF International Conference on Computer Vision Workshops, ICCV-W 2025},
 note = {Cited by: 0},
 pages = {5922 - 5932},
 publication_stage = {Final},
 source = {Scopus},
 title = {AutoConcept: Unsupervised Extraction of Constituent Concepts from Single Image},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105035148461?origin=resultslist},
