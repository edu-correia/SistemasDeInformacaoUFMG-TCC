@inproceedings{11390361,
 abstract = {The proposed work introduces a planar ultra-wideband (UWB) antenna specifically with a fractal-shaped partial ground plane for microwave imaging (MWI) applications. The radiating structure consists of circular segment merged with rectangular horizontal-shaped open circuited stub and entire structure is fed by the 50 Ω microstrip line. On the opposite side of the substrate, a modified ground plane featuring a spiral-stepped type slot configuration is implemented to enable an ultra-impedance bandwidth of the proposed configuration. The spiral-stepped type slot design contributes to enhanced impedance matching across the entire UWB frequency range. The proposed designed antenna features compact dimensions of 34 mm x 28 mm x 0.8 mm. It demonstrates a wide-ranging impedance bandwidth of approximately 10.5 GHz, covering the frequency range from 3 to 13.5 GHz. The antenna achieves a wider -10 dB impedance bandwidth of 127.27% and shows a maximum gain of approximately 6.75 dBi across the achieved operating frequency range. Thus, the proposed antenna offers better low-dispersion performance across entire UWB, making it an excellent candidate for MWI applications.},
 author = {Malik, Ravi Kumar and Kaur, Mandeep and Kumar, Sachin},
 booktitle = {2025 1st IEEE Uttar Pradesh Section Women in Engineering International Conference on Electrical Electronics and Computer Engineering (UPWIECON)},
 doi = {10.1109/UPWIECON67212.2025.11390361},
 issn = {},
 keyword = {Microwave antennas;Image segmentation;Bandwidth;Microwave circuits;Ultra wideband antennas;Sensors;Impedance;Gain;Substrates;Microwave imaging;Microwave imaging;modified ground plane;planar antenna;sensing;ultra-wideband},
 month = {Oct},
 number = {},
 pages = {813-818},
 title = {Partial Ground Plane-Based UWB Antenna for Microwave Imaging Applications},
