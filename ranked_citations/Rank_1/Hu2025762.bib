@conference{Hu2025762,
 abstract = {In brain tumor segmentation, effectively fusing multi-scale features and accurately modeling contextual information are core challenges that determine segmentation precision. Existing methods, largely reliant on the U-Net architecture, employ simple skip connections to merge deep semantics with shallow details. However, this hard-wired connection easily introduces background noise from shallow encoder layers and possesses limited contextual modeling capabilities, often leading to blurred tumor boundaries. To address this, we propose the Dilated Gating Fusion Network (DGF-Net). This network follows the encoder-decoder paradigm but introduces a novel Dilated Gating Fusion Block (DGF Block) to replace traditional skip connections. The DGF Block utilizes a lightweight gating mechanism to adaptively filter the feature stream from the encoder, suppressing irrelevant information. Concurrently, it employs parallel multi-scale dilated convolutions to expand the receptive field, capturing rich contextual dependencies. Experimental results on the LGG dataset show that DGF-Net achieves an average Dice coefficient of 0.9235, outperforming several advanced methods and demonstrating the effectiveness of the proposed design. © 2025 IEEE.},
 author = {Hu, Qili},
 doi = {10.1109/ISCEIC67854.2025.11405572},
 journal = {2025 6th International Symposium on Computer Engineering and Intelligent Communications, ISCEIC 2025},
 note = {Cited by: 0},
 pages = {762 - 766},
 publication_stage = {Final},
 source = {Scopus},
 title = {DGF-Net: A Dilated Gating Fusion Network for Brain Tumor Segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105035370262?origin=resultslist},
 year = {2025}
}
