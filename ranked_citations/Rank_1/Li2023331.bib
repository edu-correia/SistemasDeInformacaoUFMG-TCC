@article{Li2023331,
 abstract = {The paper proposes a novel method called BPCNNER that enhances boundary information for Chinese nested named entity recognition using prompt learning. The method first involves populating the nested entities into a boundary prompt template based on predefined rules and combining it with the original text. The pre-trained BERT model is then used to obtain semantic features of the text, while the BiLSTM-CRF framework captures contextual information and calculates label dependencies. The experimental results demonstrate that the proposed method achieves an F1 score of 93.02% on the People's Daily dataset, outperforming other models. Therefore, the method is effective in improving Chinese nested named entity recognition, which is a challenging task due to the lack of effective boundary supervision. © 2023, The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd.},
 author = {Li, Zhun and Song, Mei and Zhu, Yi and Zhang, Lingyue},
 doi = {10.1007/978-981-99-6222-8_28},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 6},
 pages = {331 - 343},
 publication_stage = {Final},
 source = {Scopus},
 title = {Chinese Nested Named Entity Recognition Based on Boundary Prompt},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85172278021?origin=resultslist},
 volume = {14094 LNCS},
