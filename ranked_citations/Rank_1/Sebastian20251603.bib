@conference{Sebastian20251603,
 abstract = {In this paper, we propose antenna design considerations for intelligent automated assembly in high-volume manufacturing environments. We merge concepts of advanced manufacturing, such as digital twin development, with antenna theory for a practical approach to antenna element design, incorporating some of the latest trends in manufacturing automation. We present an application of the proposed design considerations using the sleeve monopole as a candidate antenna element, and we investigate practical scalability limitations by scaling the base design to operate at higher frequency. We also present simulation results to validate the design approach for the base design and the scaled high-frequency design. © 2025 IEEE.},
 author = {Sebastian, Lillian G. and McGuire, Lucas D. and Shehan, Joshua W.},
 doi = {10.1109/SoutheastCon56624.2025.10971275},
 journal = {Conference Proceedings - IEEE SOUTHEASTCON},
 note = {Cited by: 0},
 pages = {1603 - 1608},
 publication_stage = {Final},
 source = {Scopus},
 title = {Antenna Element Design Considerations for Intelligent Automated Assembly},
 type = {Conference paper},
