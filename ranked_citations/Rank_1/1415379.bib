@inproceedings{1415379,
 abstract = {The objective of this paper is the design of adaptive quincunx lifting schemes for lossless compression of multiband images. More precisely, the operators of the lifting scheme are modified according to the local activity of the multivariate input signal. To this respect, a block-based adaptive strategy is adopted: the image is partitioned into a quadtree structure and a couple of optimal operators is assigned to each resulting volumetric segmented block. Our main contribution consists of a suitable quadtree partitioning rule that takes into account simultaneously the spatial and spectral redundancies. Simulations performed on real satellite images show that the proposed adaptive method outperforms the conventional non-adaptive lifting schemes.},
 author = {Hattay, J. and Benazza-Benyahia, A. and Pesquet, J.-C.},
 booktitle = {Proceedings. (ICASSP '05). IEEE International Conference on Acoustics, Speech, and Signal Processing, 2005.},
 doi = {10.1109/ICASSP.2005.1415379},
 issn = {2379-190X},
 keyword = {Image coding;Remote sensing;Image sampling;Spatial resolution;Image generation;Image resolution;Statistics;Local activities;Image segmentation;Satellite broadcasting},
 month = {March},
 number = {},
 pages = {ii/213-ii/216 Vol. 2},
 title = {Adaptive lifting for multicomponent image coding through quadtree partitioning},
 volume = {2},
 year = {2005}
}
