@article{10.5555/2400161.2400178,
 abstract = {Among the multitude of courses that many college-level Computer Science educators may teach is commonly a computing technology or computing literacy course geared towards non-Computer Science majors. This service course is taken by a student population that is rather diverse in terms of age, prior knowledge about computers, and field of study. It is a challenge to present material in this type of setting that is relevant, interesting, and comprehensible for all students.This paper discuses and describes a course built on the idea of a scenario-based approach; introducing skills that all of these students may need once they enter the workforce. The material is presented not just in terms of skills that they may replicate if needed, but also how all students can take the material and expand on it with respect to their individual careers.The goal of this approach is to tie the different topics traditionally covered in CS0 together in ways that provide the students with tangible results as to how to apply this knowledge immediately for their other courses, as well as to experience how the knowledge will enhance their skills and will help them to advance in their own vocation.},
 address = {Evansville, IN, USA},
 author = {Hanebutte, Nadine},
 issn = {1937-4771},
 issue_date = {January 2013},
 journal = {J. Comput. Sci. Coll.},
 month = {January},
 number = {3},
 numpages = {8},
 pages = {86–93},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Applications of computing technology-combining tangible skills and theory in CS0},
 volume = {28},
 year = {2013}
}
