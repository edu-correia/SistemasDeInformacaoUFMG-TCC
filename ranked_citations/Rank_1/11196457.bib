@inproceedings{11196457,
 abstract = {This research examines the area of improved video steganography, specifically the DCT technique of hiding information in video frames. The proposed method achieves data concealment by covertly altering image values to sub physiological thresholds ensuring that communication is accomplished without raising suspicion. The focus is to maintain message confidentiality while in transmission by embedding messages within video content which is the limitation of typical cryptography. To improve the protection of the concealed messages, the system uses encryption which protects the system from advanced attacks and modifications. This paper details the envelope methodology that traces the system’s development over time for integration with security needs of individual users and businesses. The processing of the system was done in Java while the interface was developed in Java with a graphical user interface (GUI). It was necessary to use Java because the system is platform independent and can process very large video files. The paper pointed out available literature on cryptography and within it, the techniques of cryptographic steganography emphasizing its qualities for preserving secrecy without attracting attention. The system which merges encryption with video steganographic techniques comes with accuracy in terms of PSNR = 40DB and SSIM = 0.92. This makes it a powerful candidate for protecting critical information especially in emergency situations. Its applications potential extends to defense and security fields where privacy and confidentiality is crucial.},
 author = {Kaur, Jaspreet and Malik, Arun and Saepudin, Sudin},
 booktitle = {2025 International Conference on Metaverse and Current Trends in Computing (ICMCTC)},
 doi = {10.1109/ICMCTC62214.2025.11196457},
 issn = {},
 keyword = {Steganography;Java;Privacy;Metaverse;Physiology;Encryption;Discrete cosine transforms;Protection;Videos;Graphical user interfaces;DCT;Steganography;Encryption;Decryption;SSIM;PSNR},
 month = {April},
 number = {},
 pages = {1-6},
 title = {Enhanced Video Steganography Using Discrete Cosine Transform: A Secure Approach to Data Concealment},
