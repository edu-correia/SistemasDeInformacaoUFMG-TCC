@inproceedings{11206861,
 abstract = {Visual data, which plays a critical role in the field of computer vision, has become a fundamental component of state-of-the-art artificial intelligence systems and has enabled efficiency-oriented approaches in annotation workflows. The success of deep learning-based models largely depends on the availability of high-quality, accurately annotated datasets. However, the data annotation process remains a major bottleneck due to its high labor and time costs. This study investigates the impact of deep learning-based object detection approaches on enhancing the efficiency of data annotation workflows. In this work, two distinct scenarios are addressed. In the first scenario, pre-trained YOLOv8 models—trained on the 80-class COCO 2017 dataset—are utilized to perform class-aware object detection. In the second scenario, the same models are retrained in a class-agnostic configuration, where all object categories are merged into a single class, enabling the detection of object instances without requiring class-specific information. The proposed methods enable faster annotation by focusing solely on object localization within images. Both approaches have the potential to facilitate faster annotation in scenarios involving a high number of object instances per image. Our class-agnostic configuration achieved up to 0.54 mAP@0.5:0.95, demonstrating robust and generalizable performance across diverse object detection scenarios, with potential to accelerate annotation workflows.},
 author = {Usta, Şeyma and Güneş, Eren and Deniz, Ülkü İrem and Yıldız, Uğur and Küçük, Kerem and Akbulut, Orhan},
 booktitle = {2025 10th International Conference on Computer Science and Engineering (UBMK)},
 doi = {10.1109/UBMK67458.2025.11206861},
 issn = {2521-1641},
 keyword = {Training;Location awareness;Adaptation models;Visualization;Annotations;Computational modeling;Pose estimation;Object detection;Predictive models;Data models;smart annotation;data-labelling;class-agnostic;object detection},
 month = {Sep.},
 number = {},
 pages = {283-287},
 title = {Smart Data Annotation: Accelerating Data Labeling Processes through Deep Learning},
 volume = {},
