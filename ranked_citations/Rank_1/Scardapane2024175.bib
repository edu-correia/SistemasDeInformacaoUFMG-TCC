@article{Scardapane2024175,
 abstract = {This article summarizes principles and ideas from the emerging area of applying conditional computation methods to the design of neural networks. In particular, we focus on neural networks that can dynamically activate or de-activate parts of their computational graph conditionally on their input. Examples include the dynamic selection of, e.g., input tokens, layers (or sets of layers), and sub-modules inside each layer (e.g., channels in a convolutional filter). We first provide a general formalism to describe these techniques in an uniform way. Then, we introduce three notable implementations of these principles: mixture-of-experts (MoEs) networks, token selection mechanisms, and early-exit neural networks. The paper aims to provide a tutorial-like introduction to this growing field. To this end, we analyze the benefits of these modular designs in terms of efficiency, explainability, and transfer learning, with a focus on emerging applicative areas ranging from automated scientific discovery to semantic communication.  © 2024 - IOS Press. All rights reserved.},
 author = {Scardapane, Simone and Baiocchi, Alessandro and Devoto, Alessio and Marsocci, Valerio and Minervini, Pasquale and Pomponi, Jary},
 doi = {10.3233/IA-240035},
 journal = {Intelligenza Artificiale},
 note = {Cited by: 8; All Open Access; Bronze Open Access; Green Open Access},
 number = {1},
 pages = {175 - 190},
 publication_stage = {Final},
 source = {Scopus},
 title = {Conditional computation in neural networks: Principles and research trends},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85200778975?origin=resultslist},
 volume = {18},
 year = {2024}
}
