@article{SU2026217831,
 abstract = {Hydrogels merge biomimetic compatibility with microenvironmental responsiveness, enabling next-generation sensors. This progress, driven by the rational design of sensing strategies, has shifted the paradigm from passive substrates to active responsive units. This review highlights recent advances in hydrogel-based sensors, following a logical sequence from rational design principles to signal transduction mechanisms and finally to multidimensional application scenarios. Eight design strategies are dissected, including functional nucleic acid programming, enzymatic and biomimetic recognition, reversible interactions, nanocomposite integration, physical confinement, stimulus-responsive phase transition, microneedle (MN) integration, and flexible device assembly. In the meanwhile, the review systematically elucidates how these designs translate biorecognition events into readable signals via optical, electrical, mechanical, and multimodal signal transduction and fusion. Furthermore, the review discusses emerging applications in life health and environmental safety, covering five specific categories of targets: pathogens, inorganic pollutants, endogenous biomolecules, physical/chemical indicators and organic pollutants. Finally, current challenges are summarized, and future directions aimed at intelligent, integrated, and clinically practical hydrogel sensors are outlined.},
 author = {Yuan Su and Yangzi Zhang and Ziyi Zhao and Zaihui Du and Chongbin Lei and Qian Yang and Ning Liu and Ruobin Bai and Longjiao Zhu and Wentao Xu},
 doi = {https://doi.org/10.1016/j.ccr.2026.217831},
 issn = {0010-8545},
 journal = {Coordination Chemistry Reviews},
 keyword = {Hydrogels, Sensors, Rational design, Signal transduction, Detection},
 pages = {217831},
 title = {Advanced hydrogel sensing platforms: Rational design, signal transduction mechanisms, and multidimensional applications},
 url = {https://www.sciencedirect.com/science/article/pii/S0010854526002675},
 volume = {559},
 year = {2026}
}
