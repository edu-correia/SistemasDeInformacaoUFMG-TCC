@article{ZHANG2025169253,
 abstract = {Cyclodextrin (CD) possesses a characteristic amphiphilic truncated-cone architecture, featuring a hydrophilic exterior and a hydrophobic cavity, which makes it an ideal scaffold for functional supramolecular assemblies. In this review, we move beyond traditional summaries by explicitly linking CD's chemical modification sites, cavity inclusion kinetics and surface engineering to performance metrics such as targeted drug delivery, stimuli responsiveness and catalytic efficiency. We integrate classical strategies such as self-assembly, covalent grafting and hybrid complexation, and emerging methods such as microenvironment-responsive crosslinking and dynamic reversible networks within a single evaluative framework to clarify their applications and limitations. Key interdisciplinary advances are highlighted, including functionalization of living cell surfaces to maintain viability and efficacy, CD-based artificial enzymes leveraging substrate enrichment to accelerate catalysis, and AI-guided host-guest prediction, among others. By uniting molecular design principles, assembly paradigms and machine-learning methodologies, this integrative approach elevates CD systems from conventional carriers to intelligent platforms and provides an actionable roadmap for the rational development of next-generation CD materials in precision medicine and sustainable technology.},
 author = {Yu-han Zhang and Yuting Lin and Yihan Lin and Zheng Luo and Zibiao Li and Yun-Long Wu},
 doi = {https://doi.org/10.1016/j.cej.2025.169253},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Cyclodextrin, Cyclodextrin derivative, Host-guest inclusion, Biomaterials, Machine learning},
 pages = {169253},
 title = {Redefining cyclodextrin-based systems: A multiscale framework of structure, function and application interconnection},
 url = {https://www.sciencedirect.com/science/article/pii/S138589472510096X},
 volume = {524},
 year = {2025}
}
