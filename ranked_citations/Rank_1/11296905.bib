@article{11296905,
 abstract = {The electrothermal coupling analysis of multiscale electronic devices in modern electronic engineering presents increasing complexity. High computational resource consumption and the need for rapid convergence constitute major challenges in this area. To address these challenges, this study puts forward an electrical–thermal coupling algorithm. This algorithm is based on the tetrahedral spectral element time-domain method, and it successfully merges the high accuracy of the spectral element method (SEM) with the strong geometric adaptability of the finite element method (FEM). In the tetrahedral mesh-based SETD (TSETD), a collapse transformation method facilitates the conversion of orthogonal basis functions from a hexahedral to a tetrahedral reference element for simplified element matrix analysis and calculation. Moreover, nonequidistant Gauss–Lobatto–Legendre (GLL) spectral interpolation nodes for tetrahedral elements are produced by this study utilizing the Warp&Blend transformation. This approach makes direct nodal numerical integration calculation possible through Vandermonde matrices, leading to faster convergence when compared with traditional Gaussian integration. For addressing both electrical and thermal fields, the algorithm incorporates time-domain solvers. Representative cases derived from modern integrated circuit (IC) test series are utilized for validation. Results from these cases confirm the method’s ability to combine high accuracy with efficiency concerning complex electrothermal coupling challenges.},
 author = {Feng, Naixing and Xiao, Keshuang and Zheng, Fanghua and Wang, Wei and Huang, Zhixiang},
 doi = {10.1109/TCPMT.2025.3642783},
 issn = {2156-3985},
 journal = {IEEE Transactions on Components, Packaging and Manufacturing Technology},
 keyword = {Finite element analysis;Interpolation;Time-domain analysis;Polynomials;Couplings;Accuracy;Transient analysis;Temperature;Electric potential;Finite difference methods;Electrothermal coupling;tetrahedral mesh-based SETD (TSETD) method;Warp &Blend transformation},
 month = {April},
 number = {4},
 pages = {788-800},
 title = {Efficient Tetrahedral SETD Implementations of Transient Electrothermal Cosimulation for Electronic Devices},
 volume = {16},
 year = {2026}
}
