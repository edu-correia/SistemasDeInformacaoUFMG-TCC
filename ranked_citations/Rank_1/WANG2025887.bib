@article{WANG2025887,
 abstract = {This study introduces a combined numerical perturbation and frequency response system identification approach to linearize complex flight dynamics models in Simulink® using discrete-time integrators, higher-order actuator dynamics, and digital control elements. By uniting direct numeric linearization and black-box frequency response identification, the algorithm breaks integrators using user-specified linear analysis points and merges the results into a multilayer state-space representation. This method preserves the known system components while reducing the computational cost of extensive model simulations or parameter fitting. The implementation details and validation results confirm that the new approach strongly agrees with conventional linearization methods in relevant flight applications.},
 author = {Qite Wang and Yingao Zhang and Shengquan Xie and Song Han and Qian Guo},
 doi = {https://doi.org/10.1016/j.ifacol.2025.11.265},
 issn = {2405-8963},
 journal = {IFAC-PapersOnLine},
 keyword = {Linearization, System identification, State-space models, Nonlinear systems},
 note = {23th IFAC Symposium on Automatic Control in Aerospace ACA 20255},
 number = {20},
 pages = {887-892},
 title = {A Hybrid Methodology for Flight Systems Linearization via Numerical Perturbation and Frequency Response Identification},
 url = {https://www.sciencedirect.com/science/article/pii/S2405896325019378},
 volume = {59},
 year = {2025}
}
