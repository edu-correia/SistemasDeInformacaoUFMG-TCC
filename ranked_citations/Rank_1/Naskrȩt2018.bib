@conference{Naskrȩt2018,
 abstract = {The paper presents a new re-built and expanded, version 2.0 of WordnetLoom - an open wordnet editor. It facilitates work on a multilingual system of wordnets, is based on efficient software architecture of thin client, and offers more flexibility in enriching wordnet representation. This new version is built on the experience collected during the use of the previous one for more than 10 years of plWordNet development. We discuss its extensions motivated by the collected experience. A special focus is given to the development of a variant for the needs of MultiWordnet of Portuguese, which is based on a very different wordnet development model. © 2018 Global WordNet Association. All rights reserved.},
 author = {Naskrȩt, Tomasz and Dziob, Agnieszka and Piasecki, Maciej and Saedi, Chakaveh and Branco, António},
 journal = {GWC 2018 - 9th Global WordNet Conference},
 note = {Cited by: 13},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {WordnetLoom - A multilingual wordnet editing system focused on graph-based presentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85043706403?origin=resultslist},
 volume = {2018-January},
 year = {2018}
}
