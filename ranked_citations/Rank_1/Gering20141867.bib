@conference{Gering20141867,
 abstract = {A method for stabilization of known equilibria in recurrent fuzzy systems is presented, which particularly accounts for model uncertainties. Since the dynamics of recurrent fuzzy systems are defined over a rectangular grid, it is first observed that for stability analysis, only gradient conditions at grid points have to be considered given that the inputs are piecewise constant. Therefore, a robust structure variable controller is proposed, switching between constant inputs. In order to prevent the system from deadlock phenomena due to the switching of the system, the structure variable control is augmented by a piecewise polynomial controller, guaranteeing asymptotic stability. The proposed method is applied to the example of an inverted pendulum. © 2014 IEEE.},
 author = {Gering, Stefan and Krippner, Wolfgang and Adamy, Jurgen},
 doi = {10.1109/FUZZ-IEEE.2014.6891651},
 journal = {IEEE International Conference on Fuzzy Systems},
 note = {Cited by: 0},
 pages = {1867 - 1874},
 publication_stage = {Final},
 source = {Scopus},
 title = {Robust stabilization of recurrent fuzzy systems via switching control},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84912571171?origin=resultslist},
 year = {2014}
}
