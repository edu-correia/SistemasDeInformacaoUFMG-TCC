@inproceedings{5491541,
 abstract = {Five new chaotic attractors in a modified Sprott's jerk model are presented based on five new sets of a single coefficient and arcsine nonlinearity. In particular, compound structures of such chaotic attractors are demonstrated through the use of a half-image operation using a control parameter h. The positive value of an appropriate h isolates the right half-image attractors whilst the negative value of an appropriate h isolates the left half-image attractor. Both images can then be merged together as a compound structure.},
 author = {Srisuchinwong, Banlue and Siriburanon, Teerachot and Nontapradit, Teera},
 booktitle = {ECTI-CON2010: The 2010 ECTI International Confernce on Electrical Engineering/Electronics, Computer, Telecommunications and Information Technology},
 doi = {},
 issn = {},
 keyword = {Chaos;Chaotic communication;Oscillators;Communications technology;Electronic mail;Differential equations;Mechanical systems;Acceleration;Operational amplifiers},
 month = {May},
 number = {},
 pages = {16-19},
 title = {Compound structures of five new chaotic attractors based on sin−1(x) in a modified Sprott's jerk model},
 volume = {},
 year = {2010}
}
