@article{10.1007/s00778-012-0278-6,
 abstract = {Scaling the performance of shared-everything transaction processing systems to highly parallel multicore hardware remains a challenge for database system designers. Recent proposals alleviate locking and logging bottlenecks in the system, leaving page latching as the next potential problem. To tackle the page latching problem, we propose physiological partitioning (PLP). PLP applies logical-only partitioning, maintaining the desired properties of sharedeverything designs, and introduces a multi-rooted B+Tree index structure (MRBTree) that enables the partitioning of the accesses at the physical page level. Logical partitioning and MRBTrees together ensure that all accesses to a given index page come from a single thread and, hence, can be entirely latch free; an extended design makes heap page accesses thread private as well. Moreover, MRBTrees offer an infrastructure for easy repartitioning and allow us to have a lightweight dynamic load balancing mechanism (DLB) on top of PLP. Profiling a PLP prototype running on different multicore machines shows that it acquires 85 and 68%fewer contentious critical sections, respectively, than an optimized conventional design and one based on logical-only partitioning. PLP also improves performance up to almost 50 % over the existing systems, while DLB enhances the system with rapid and robust behavior in both detecting and handling load imbalances.},
 address = {Berlin, Heidelberg},
 author = {T\"{o}z\"{u}n, P\i{}nar and Pandis, Ippokratis and Johnson, Ryan and Ailamaki, Anastasia},
 doi = {10.1007/s00778-012-0278-6},
 issn = {1066-8888},
 issue_date = {April     2013},
 journal = {The VLDB Journal},
 keyword = {Dynamic load balancing, MRBtree, Multi-rooted B+Trees, PLP, Physiological partitioning, Re-partitioning},
 month = {April},
 number = {2},
 numpages = {25},
 pages = {151–175},
 publisher = {Springer-Verlag},
 title = {Scalable and dynamically balanced shared-everything OLTP with physiological partitioning},
 url = {https://doi.org/10.1007/s00778-012-0278-6},
 volume = {22},
 year = {2013}
}
