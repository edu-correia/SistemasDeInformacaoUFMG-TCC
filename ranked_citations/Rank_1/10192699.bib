@inproceedings{10192699,
 abstract = {At present, the need for efficient information search and analysis is essential for the computer-based legal case text analysis systems. For the common methods, their steps are more focused on text pattern analysis, which ignores the deep information of the large case data sets. Then, this paper proposes a novel deep information search algorithm for the legal case text recommendation system. The novelties are focused on 3 aspects: (1) The novel deep information search (DIS) algorithm considering the feature model is proposed. (2) The novel text recommendation scenario, the new structural optimal model, is designed. (3) The legal case text features are investigated, and the proposed model is applied to the legal case text datasets to validate the performance. Experimental results show that our method achieves satisfactory results, and different data sizes are considered to test the applicability.},
 author = {Wan, Hui},
 booktitle = {2023 8th International Conference on Communication and Electronics Systems (ICCES)},
 doi = {10.1109/ICCES57224.2023.10192699},
 issn = {},
 keyword = {Text analysis;Law;Merging;Robustness;Pattern analysis;Recommender systems;Testing;Text recommendation system;Deep information;Search algorithm;Information retrieval},
 month = {June},
 number = {},
 pages = {1744-1749},
 title = {A Novel Deep Information Search Algorithm for Legal Case Text Recommendation System},
 volume = {},
 year = {2023}
}
