@article{10.1145/3674156,
 abstract = {With the growing popularity of the Internet of Things (IoT), billions of devices are anticipated to be deployed in various industries without establishing trust between them. In environments without pre-established trust, reputation systems provide an effective method of assessing the trustworthiness of IoT devices. There has been considerable literature on deploying reputation systems in industries that have not yet established trust among themselves. Therefore, the article reviews published studies on reputation systems for IoT applications to date, focusing on decentralised systems and decentralised systems using blockchain technology. These studies are evaluated regarding security (including integrity and privacy) and non-security requirements to highlight open research challenges. In alignment with this, an analysis and summary of the existing review studies on reputation systems for particular IoT applications are presented, demonstrating the need for a review article to consider all IoT applications and those that have not been explored. The IoT applications and sub-applications are described, and their problem statement, literature to date and research gap are comprehensively evaluated. Finally, the open research challenges concerning reputation systems are reviewed and addressed to provide the researcher with a road map of potential research directions.},
 address = {New York, NY, USA},
 articleno = {31},
 author = {Mahmoud, Haitham and Arshad, Junaid and Aneiba, Adel},
 doi = {10.1145/3674156},
 issue_date = {December 2024},
 journal = {Distrib. Ledger Technol.},
 keyword = {Reputation systems, IoT, blockchain technology, privacy-preserving, decentralised reputation},
 month = {December},
 number = {4},
 numpages = {40},
 publisher = {Association for Computing Machinery},
 title = {A Systematic Review of Blockchain-Based Privacy-Preserving Reputation Systems for IoT Applications},
 url = {https://doi.org/10.1145/3674156},
 volume = {3},
 year = {2024}
}
