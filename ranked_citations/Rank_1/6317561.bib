@inproceedings{6317561,
 abstract = {The Qsolar Nano-Structure (QNS) cell is a three dimensional nano-structured silicon PV cell that merges well-known semiconductor processing technology and existing PV technology in a cost-effective way. The QNS cell structure significantly boosts energy output 1.8 times over conventional silicon solar cells by increasing junction area, maximizing light absorption, maximizing carrier capture, and minimizing contact resistance.},
