@inproceedings{8472641,
 abstract = {A circuit model of a periodic array of PT-symmetric (gain/loss coupled) waveguides is reported for the design of a novel tunable filter. This model consists of a pair of coupled LC circuits, one with amplification resistance -R and the other with an equivalent attenuation. By varying the value of the $\mathbf{gain}/\mathbf{loss}(\gamma)$, one can control the size of bandgap and hence the allowed frequencies propagating within the structure. For a critical value of gain/loss or $(\gamma=\gamma_{PT})$, the eigenvalues merge and the gap disappears. As a result, all frequencies can pass the structure i.e, an all pass filter. The Q-factor of reflected frequency can be varied such that, tunable Q from 20 to greatest has been successfully realized in the central frequency of 0. 21 MHz. The remarkable feature of this design lies with its tunability, high speed, and relative simplicity.},
 author = {Pilehvar, Elnaz and Moravvej-Farshi, Mohammad Kazem and Ramezani, Hamidreza},
 booktitle = {Electrical Engineering (ICEE), Iranian Conference on},
 doi = {10.1109/ICEE.2018.8472641},
 issn = {},
 keyword = {Optical waveguides;Integrated circuit modeling;Eigenvalues and eigenfunctions;Optical filters;Couplings;High-speed optical techniques;Transmission line matrix methods;Parity-Time (p7f Symmetry;Optical Waveguides;RLC Circuit Model;Band Stop Filter (BSF);Grating Waveguides},
 month = {May},
 number = {},
 pages = {228-231},
 title = {Tunable Filter by Using Parity Time (PT) Symmetric Periodic Array Electronic},
 volume = {},
 year = {2018}
}
