@article{DONG2024105643,
 abstract = {This paper presents a robust two-step deep-learning network that incorporates both object detection and optical character recognition, providing an efficient solution to the challenge of simultaneous detection and mileage positioning of multiple pavement distresses in complex highway scenes. The ShuttleYOLO model, proposed in this paper, effectively couples the modified ShuttleNet with YOLO heads to simultaneously detect broken pavement markings, sealed cracks, cracks, kilometer signs, and hectometer signs. The experimental results demonstrate that the ShuttleYOLO achieves a mean F1-score of 83.55% and a mean average precision of 86.66% on 1966 testing images. Additionally, the ShuttleOCR model integrates the modified ShuttleNet with a Transformer Module to automatically retrieve mileage text information from the detected mileage signs. The ShuttleOCR model achieves a mean accuracy of 99.51% on 1233 testing images, outperforming EasyOCR by 3.50%. ShuttleYOLO and ShuttleOCR work together in practice to ensure the synchronous execution of pavement distresses detection and mileage positioning.},
 author = {Zishuo Dong and Allen A. Zhang and Yue Ding and Xinyi Xu and Hang Zhang and Anzheng He},
 doi = {https://doi.org/10.1016/j.autcon.2024.105643},
 issn = {0926-5805},
 journal = {Automation in Construction},
 keyword = {Object detection, Optical character recognition, Pavement distresses, Mileage positioning, Pavement cracks, Deep learning, ShuttleNet},
 pages = {105643},
 title = {Intelligent detection and mileage positioning of multiple distresses using two-step deep learning},
 url = {https://www.sciencedirect.com/science/article/pii/S0926580524003790},
 volume = {166},
 year = {2024}
}
