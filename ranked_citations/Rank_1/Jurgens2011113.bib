@conference{Jurgens2011113,
 abstract = {Word Sense Induction (WSI) is an unsupervised learning approach to discovering the different senses of a word from its contextual uses. A core challenge to WSI approaches is distinguishing between related and possibly similar senses of a word. Current WSI evaluation techniques have yet to analyze the specific impact of similarity on accuracy. Therefore, we present a new WSI evaluation that quantifies the relationship between the relatedness of a word’s senses and the ability of a WSI algorithm to distinguish between them. Furthermore, we perform an analysis on sense confusions in SemEval-2 WSI task according to sense similarity. Both analyses for a representative selection of clustering-based WSI approaches reveals that performance is most sensitive to the clustering algorithm and not the lexical features used. © 2011 Association for Computational Linguistics},
 author = {Jurgens, David and Stevens, Keith},
 journal = {Workshop on Unsupervised Learning in NLP at the 2011 Conference on Empirical Methods in Natural Language Processing, EMNLP 2011 - Proceedings},
 note = {Cited by: 4},
 pages = {113 - 123},
 publication_stage = {Final},
 source = {Scopus},
 title = {Measuring the Impact of Sense Similarity on Word Sense Induction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84918577372?origin=resultslist},
 year = {2011}
}
