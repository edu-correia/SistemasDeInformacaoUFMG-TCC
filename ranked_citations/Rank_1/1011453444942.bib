 author = {Bhattacharyya, Arnab and Bonnet, \'{E}douard and Egri, L\'{a}szl\'{o} and Ghoshal, Suprovat and S., Karthik C. and Lin, Bingkai and Manurangsi, Pasin and Marx, D\'{a}niel},
 doi = {10.1145/3444942},
