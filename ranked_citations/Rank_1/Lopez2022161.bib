@article{Lopez2022161,
 abstract = {Peridynamics is a nonlocal theory for dynamic fracture analysis consisting in a second order in time partial integro-differential equation. In this paper, we consider a nonlinear model of peridynamics in a two-dimensional spatial domain. We implement a spectral method for the space discretization based on the Fourier expansion of the solution while we consider the Newmark-β method for the time marching. This computational approach takes advantages from the convolutional form of the peridynamic operator and from the use of the discrete Fourier transform. We show a convergence result for the fully discrete approximation and study the stability of the method applied to the linear peridynamic model. Finally, we perform several numerical tests and comparisons to validate our results and provide simulations implementing a volume penalization technique to avoid the limitation of periodic boundary conditions due to the spectral approach. © 2021 Elsevier Ltd},
 author = {Lopez, Luciano and Pellegrino, Sabrina Francesca},
 doi = {10.1016/j.camwa.2021.07.004},
 journal = {Computers and Mathematics with Applications},
 note = {Cited by: 33; All Open Access; Green Open Access},
 pages = {161 - 175},
 publication_stage = {Final},
 source = {Scopus},
 title = {A space-time discretization of a nonlinear peridynamic model on a 2D lamina},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85111933053?origin=resultslist},
 volume = {116},
 year = {2022}
}
