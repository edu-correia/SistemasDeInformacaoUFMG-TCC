@article{ABDULJAWAD2025130684,
 abstract = {A ternary composite formed by merging nickel and cerium oxides with graphitic carbon nitride (CeO2/NiO@g-C3N4) using a simplistic sol-gel approach. The crystalline structure characterization revealed the development of CeO2, NiO, and g-C3N4 phases which were further confirmed by the scanning and transmission electron microscopy that showed the dispersion of the nanoparticles with the graphitic nanosheets. The elemental composition was verified by the EDX and XPS analysis whereas the surface area investigation indicated a surface area of 26.79 m2. g−1, which enabled it to eliminate methyl violet dye efficiently. The methyl violet dye adsorption data fitted the Langmuir isotherm with a maximum qmax of 265 mg. g−1 and the adsorption kinetics followed the pseudo-second-order model. The postulated mechanism for the MV uptake by the composite occurred via n – π, π – π stacking, and hydrogen bonding. The research results proved the high adsorption competence of the CeO2/NiO@g-C3N4 (CeNiCN) composite for the elimination of MV dye at neutral and mild basic pH along with being effective for four regeneration cycles.},
 author = {Marwan M. Abduljawad and Abbas I. Alakhras and Mohammed Qasem Alfaifi and Musaad Aleid and Khaled Bin Bander and Weam Saleh Alanazi and Laila S. Alqarni and Eida S. Al-Farraj and Hajo Idriss and Kamal K. Taha and Abueliz Modwi},
 doi = {https://doi.org/10.1016/j.matchemphys.2025.130684},
 issn = {0254-0584},
 journal = {Materials Chemistry and Physics},
 keyword = {Ce@NiO@g-CN, Characterization, MV adsorption, Bonding mechanism},
 pages = {130684},
 title = {Combating up of methyl violet dye from aquatic media via novel Ce@NiO@g-C3N4 nano-sorbent},
 url = {https://www.sciencedirect.com/science/article/pii/S025405842500330X},
 volume = {339},
 year = {2025}
}
