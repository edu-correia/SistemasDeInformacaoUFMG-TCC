@conference{Zekavat2002742,
 abstract = {In this paper, a novel merger of DS-CDMA and smart antenna arrays is introduced. Specifically, we merge a smart antenna array with CI/DS-CDMA, a novel implementation of DS-CDMA where chips are decomposable into N narrowband frequency components. In the proposed antenna array, applying proper time-varying phases to the array elements, we create small movement (oscillation) in the antenna array's pattern, while steering the antenna pattern main lobe to the position of the intended user. The oscillating antenna pattern creates a time-varying channel with a controllable coherence time. This, in turn, provides transmit diversity in the form of a time diversity gain at the mobile receiver side. Thus, at the receiver, three stages of combining are available: 1) combining time components of the received signal within symbol duration T<sub>S</sub> (each experiencing a different fade) to enhance performance via time diversity; 2) combining frequency components which make up the CI/DS-CDMA chip to enhance the performance via frequency diversity; and 3) combining across chips to eliminate the interfering users on the system. Employing CI/DS-CDMA with the proposed smart antenna at the base station, we achieve: 1) very high capacity via the merger of SDMA (directionality of antenna array) and code division multiple access (inherent in CI/DS-CDMA); and 2) very high performance via the construction of receivers that exploit both transmit diversity and frequency diversity. We focus on the performance benefits of the proposed system.},
 author = {Zekavat, Seyed Alireza and Nassar, Carl R. and Shattil, Steve},
 journal = {IEEE International Conference on Communications},
 note = {Cited by: 0},
 pages = {742 - 747},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging DS-CDMA (with CI chip shapes) and oscillating-beam smart antenna arrays: Exploiting transmit diversity, frequency diversity and directionality},
 type = {Conference paper},
