@inproceedings{11385223,
 abstract = {This paper presents Hybrid-Attention U-Net (HAUNet) for crack segmentation, addressing severe foreground-background imbalance and wide variability in crack scale. HAUNet extends the U-Net backbone with three enhancements: a parallel dual-branch bottleneck combining a CNN branch and a Swin Transformer branch, a Selective Fusion Module for adaptive merging of heterogeneous features, and a Dual Up-sample Module for improved spatial and boundary recovery. Evaluated on a dataset composed of public and proprietary images, HA-UNet outperforms existing methods and achieves notable improvements in segmentation completeness and accuracy.},
 author = {Liu, Jie and Zhao, Feng},
 booktitle = {2025 5th International Conference on Artificial Intelligence, Robotics, and Communication (ICAIRC)},
 doi = {10.1109/ICAIRC68035.2025.11385223},
 issn = {},
 keyword = {Image segmentation;Merging;Morphology;Inspection;Transformers;Multitasking;Concrete;Robustness;Maintenance;Robots;Concrete Crack Segmentation;Unet;Swin Transformer;Selective Fusion Module},
 month = {Nov},
 number = {},
 pages = {169-173},
 title = {Hybrid-Attention U-Net (HA-UNet): Integrating CNNs AND SWIN Transformer for Concrete Crack Segmentation},
 volume = {},
 year = {2025}
}
