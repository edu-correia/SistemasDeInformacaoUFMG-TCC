@article{Cheng2024,
 abstract = {This paper is based on the VAR model, a regression analysis of the correlation between labor education and ideological and political education. Firstly, the LDA algorithm is used to speculate about the document to obtain the probability distribution of the subject, and this is used as the current subject feature. Then use the gray correlation algorithm to measure the distribution characteristics of each different indicator from the object dimension, and measure the correlation size and positive and negative by extracting the relative difference between indicators. Finally, the TF-IDF algorithm is used to determine the word weights, and text clustering is invoked to merge texts with the same theme. After the teaching of the VAR model, the significance of the learning motivation of the students in the experimental group is 0.009, the passing rate of the final grades is around 76%, and the significance of the dimensions of the learning effect is less than 0.05. It shows that the integration of labor education with ideological and political education can lead students to strengthen their concepts of labor so as to realize students' comprehensive development.  © 2023 Chun Cheng, published by Sciendo.},
 author = {Cheng, Chun},
 doi = {10.2478/amns.2023.2.01445},
 journal = {Applied Mathematics and Nonlinear Sciences},
