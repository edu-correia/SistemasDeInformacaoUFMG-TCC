@inproceedings{11386475,
 abstract = {The integration of deep learning technologies into Computer-Aided Diagnosis (CAD) has notably improved the accuracy and effectiveness of medical diagnostics. However, such advancements are often hampered by limitations when confronted with ambiguous or complex morphological features, thereby complicating the identification of minute lesions and heightening the risk of misdiagnosis. To address this challenge, we propose MedMM, a novel medical image classification network that synergistically combines deep learning methodologies with attention mechanisms. The MedMM consists of three parts, which are a local feature extraction network, a global feature extraction network, and a feature fusion classification network. The global branch uses shift windows and relative position deviation for enhanced data assimilation. Inspired by differential convolution, the local branch accurately captures image details to minimize misdiagnosis risks. The feature fusion classification network integrates a multi-scale channel shuffle attention mechanism and hierarchical feature fusion modules for coherent feature integration. Overall, MedMM effectively merges local and global features for precise medical image classification. To substantiate its efficacy, MedMM was tested across multiple prominent medical image datasets (COVID-19 and Kvasir) and exhibited superior performance. MedMM maintains this enhanced accuracy without compromising on other performance metrics, striking an optimal balance among them.},
 author = {Shen, Yinlan and Xiao, Wei and Jiang, Lei and Chen, Jie and Zhao, Keyi and Pan, Chao},
 booktitle = {2025 3rd International Conference on Intelligent Control and Computing (IC&C)},
