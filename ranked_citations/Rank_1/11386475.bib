 issn = {},
 keyword = {Deep learning;Attention mechanisms;Accuracy;Design automation;Feature extraction;Performance metrics;Lesions;Medical diagnostic imaging;Image classification;Data assimilation;CAD;Deep Learning;Medical Image Classification;Feature Fusion},
 month = {April},
 number = {},
 pages = {176-180},
 title = {MedMM: Multiscale Multibranch Networks for Medical Image Classification},
