 pages = {2539 - 2556},
 publication_stage = {Final},
 source = {Scopus},
 title = {Dynamic Hierarchical Aggregation for Vehicular Sensing},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85019033750?origin=resultslist},
