@inproceedings{9810702,
 abstract = {To address the problem of large computational redundancy in the geometric prediction merge mode with motion vector refinement (GPM with MMVD), a new decision algorithm based on CU gradient is proposed. By comparing the mean value of the gradient in four directions to determine whether GPM can be terminated early. The advance decision of GPM partition mode can be determined by the calculated gradient direction of CU. Meanwhile, the proposed algorithm saves coding time by reducing the number of candidate modes during the mode selection process.},
 author = {Zhang, Mengmeng and Deng, Siqi and Liu, Zhi},
 booktitle = {2022 Data Compression Conference (DCC)},
 doi = {10.1109/DCC52660.2022.00104},
 issn = {2375-0359},
 keyword = {Redundancy;Data compression;Prediction algorithms;Encoding;Partitioning algorithms},
 month = {March},
 number = {},
 pages = {01-01},
 title = {A fast geometric prediction merge mode decision algorithm based on CU gradient for VVC},
 volume = {},
 year = {2022}
}
