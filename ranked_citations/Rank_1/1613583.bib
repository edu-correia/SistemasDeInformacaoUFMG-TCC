@inproceedings{1613583,
 abstract = {Integration of Mobile IP (MIP) and Multiprotocol Label Switching (MPLS) networks has greatly gained achievement of Quality of Service (QoS) guarantees over dynamic mobile environment. Recovery technique is one significant requirement for traffic management to support QoS guaranteed tunnels, according to link/node failure or topology changes in mobile network. Therefore, a number of recovery schemes for MPLS has been proposed in recent years. However, most of the current schemes focus only on wire network and are short of solution for multiple failures recovery in such dynamic topologies. Hence, this research proposes a recovery scheme called Modified Flexible MPLS Signaling (MFMS) for Mobile IP (MIP) over Multiprotocol Label Switching (MPLS) network. It utilizes Merging Point of recovery Optimization (MPO) to evaluate the nearest active upstream node to be Merging Point of recovery (MP) node. This can achieve the multiple failures problem and gain faster rerouting response time. However, additional signaling overhead exchanging is concerned. The performance of the proposed signaling scheme is presented through simulations.},
 author = {Sa-Ngiamsak, W. and Krachodnok, P. and Varakulsiripunth, R.},
 booktitle = {2006 1st International Symposium on Wireless Pervasive Computing},
 doi = {10.1109/ISWPC.2006.1613583},
 issn = {},
 keyword = {Multiprotocol label switching;Tellurium;Topology;Merging;Ice;Ear;Uninterruptible power systems;Birth disorders;Routing;Mobile IP;MPLS;QoS;Path Recovery},
 month = {Jan},
 number = {},
 pages = {1-5},
 title = {A Recovery Scheme for QoS Guaranteed Mobile IP Over MPLS Network},
 volume = {},
 year = {2006}
}
