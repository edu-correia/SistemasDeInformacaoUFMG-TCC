@article{Zhou2020181,
 abstract = {Personalized recommendation has yield immense success in predicting user preference with heterogeneous implicit feedback (HIF), i.e., various user behaviors. However, existing studies consider less about the temporal dynamics and repeated patterns of HIF. They simply suppose: (1) a hard rule among user behaviors (e.g., add-to-cart must come before purchase and after view); (2) merge repeated behaviors into one (e.g., view several times is considered as view once only), thus failing to unveil user preferences from their real behaviors. To ease these issues, we, therefore, propose a novel end-to-end neural framework – TDRB, which automatically models the Temporal Dynamics and Repeated Behaviors to assist in capturing user preference, thus achieving more accurate recommendations. Empirical studies on three real-world datasets demonstrate the superiority of our proposed TDRB against other state-of-the-arts. © Springer Nature Switzerland AG 2020.},
 author = {Zhou, Xin and Sun, Zhu and Guo, Guibing and Liu, Yuan},
 doi = {10.1007/978-3-030-47426-3_15},
 journal = {Lecture Notes in Computer Science},
 note = {Cited by: 4; All Open Access; Bronze Open Access; Green Open Access},
 pages = {181 - 193},
 publication_stage = {Final},
 source = {Scopus},
 title = {Modelling Temporal Dynamics and Repeated Behaviors for Recommendation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85085731845?origin=resultslist},
 volume = {12084 LNAI},
 year = {2020}
}
