@article{CHENG2025106737,
 abstract = {Under the dual pressures of global climate change and rapid urbanization, flooding has become a major environmental management challenge. It seriously threatens regional ecological security, socio-economic development, and public safety, especially in China's Yangtze River Economic Belt (YREB). However, there is a lack of research on the spatio-temporal distribution of flood resilience and the driving factors of its spatial heterogeneity in this region. This study constructs an evaluation index system based on the PSR framework, integrating the four dimensions of economy, society, ecology and infrastructure. It integrates the improved CRITIC-Entropy weighting method, TOPSIS, kernel density estimation, and the Geographical Detector model to analyze the spatio-temporal evolution and driving factors of flood resilience in the YREB. The analysis covers 11 provinces from 2003 to 2023. The results show that: (1) From 2003 to 2023, flood resilience in YREB showed an upward trend, with the flood resilience index growing slowly from 2003 to 2010 and the average annual growth rate increasing by 47.6% from 2011 to 2023. (2) The spatial distribution of flood resilience presents a pattern of "high in the east and low in the west", and the regional differences first narrow and then expand. (3) The spatial heterogeneity of flood resilience is driven by multiple factors, among which GDP per capita, built-up area, length of urban drainage pipes, and government expenditure on public safety are the main drivers. The study provides scientific basis for formulating flood mitigation policies in YREB, emphasizing the need to integrate economic development, infrastructure improvement and ecological governance to enhance regional flood resilience and promote sustainable development.},
 author = {Lei Cheng and Zhaocai Wang and Renlin Pei and Junhao Wu},
 doi = {https://doi.org/10.1016/j.scs.2025.106737},
 issn = {2210-6707},
 journal = {Sustainable Cities and Society},
 keyword = {Flood resilience (FR), Improved CRITIC-entropy model, Geographical detector model, Yangtze river economic belt (YREB)},
 pages = {106737},
 title = {Sustainable urban management and flood resilience in China’s Yangtze river economic belt: Drivers, patterns, and policy synergies},
 url = {https://www.sciencedirect.com/science/article/pii/S2210670725006110},
 volume = {131},
 year = {2025}
}
