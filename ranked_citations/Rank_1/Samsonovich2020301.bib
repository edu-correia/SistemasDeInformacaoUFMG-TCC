@article{Samsonovich2020301,
 abstract = {Social virtual actors need to interact with users emotionally, convincing them in their ability to understand human minds. For this to happen, an artificial emotional intelligence is needed, capable of believable behavior in real-life situations. Summarizing recent work of the authors, the present paper extends the general state-of-the-art framework of emotional AGI, using the emotional Biologically Inspired Cognitive Architecture (eBICA) as a basis. In addition to appraisals, other kinds of fluents are added to the model: somatic markers, feelings, emotional biases, moods, etc. Their integration is achieved on the basis of semantic maps and moral schemas. It is anticipated that this new level of artificial general socially emotional intelligence will complement the next-generation AGI, helping it to merge into the human society on equal with its human members. © Springer Nature Switzerland AG 2020.},
 author = {Samsonovich, Alexei V. and Chubarov, Arthur A. and Tikhomirova, Daria V. and Eidln, Alexander A.},
 doi = {10.1007/978-3-030-52152-3_31},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {301 - 305},
 publication_stage = {Final},
 source = {Scopus},
 title = {Toward a general believable model of human-analogous intelligent socially emotional behavior},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85088512613?origin=resultslist},
 volume = {12177 LNAI},
 year = {2020}
}
