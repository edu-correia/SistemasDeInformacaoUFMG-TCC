@article{4271543,
 abstract = { We introduce an optimal topdown algorithm for computing and representing level line trees of 2-D intensity images. The running time of the algorithm is ${\rm O}(n + t)$, where $n$ is the size of the input image and $t$ is the total length of all level lines. The properties of level line trees are also investigated. The efficiency of the algorithm is illustrated by experiments on images of different sizes and scenes. },
 author = {Song, Yuqing},
 doi = {10.1109/TIP.2007.899616},
 issn = {1941-0042},
 journal = {IEEE Transactions on Image Processing},
 keyword = {Level set;Geographic Information Systems;Merging;Layout;Image representation;Image coding;Biomedical imaging;X-ray imaging;Crystallography;Topology;Contour tree;image representation;level line tree;level set;monotonic line tree},
 month = {Aug},
 number = {8},
 pages = {2107-2116},
 title = {A Topdown Algorithm for Computation of Level Line Trees},
 volume = {16},
 year = {2007}
}
