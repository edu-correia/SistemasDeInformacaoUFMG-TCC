@inproceedings{11511108,
 abstract = {Survival prediction in Head and Neck Cancer (HNC) disease is generally limited by feature flattening, where heterogeneous clinical variables ranging from tumor information to demographics are merged into unstructured, high-dimensional features space. This process ignores the fundamental semantic hierarchy of clinical data, forcing models to learn complex relationships and often leading to sub-optimal performance in small-cohort scenario. We propose the Semantically-Structured Bagging (SSB) framework, a representation learning approach formulated to preserve the clinical content. SSB partitions features into six unique functional domains: Demographics, Tumor Information, Treatment Details, Treatment Timelines, Survival Timing, and Disease Progression. This architecture employs independent, non-linear transformation branches for each bag, projecting raw data into a constrained latent space. This approach improves the relationships between each group while avoiding incorrect relation across the domains. SSB framework was evaluated against state-of-the-art flattened baselines approaches (XGBoost, SVM, and Logistic Regression) using a sample of 298 patients from the TCIA Head-Neck-PET-CT dataset. The results illustrate that SSB-informed representations consistently outperform traditional flattened baselines across all classifiers. Of all the classifiers, XGBoost achieved a statistically significant F1-score (0.76, p=0.034). These findings show that semantic structure of the data is important for cancer modeling and provides more reliable support for treatment decisions.},
 author = {M, Chanchal and TR, Swapna},
 booktitle = {2026 9th International Conference on Inventive Computation Technologies (ICICT)},
 doi = {10.1109/ICICT68280.2026.11511108},
 issn = {2767-7788},
 keyword = {Modeling;Bagging;Tumors;Cancer;Printing;Head;Neck;Timing;Medical diagnosis;Machine learning;Clinical variables;Feature Grouping;Head and Neck Cancer;Representation Learning;Semantically-Structured Bagging (SSB);Survival Analysis},
 month = {April},
 number = {},
 pages = {1848-1852},
 title = {A Semantically-Structured Representation Learning Framework for Head and Neck Cancer Survival Prediction},
 volume = {},
 year = {2026}
}
