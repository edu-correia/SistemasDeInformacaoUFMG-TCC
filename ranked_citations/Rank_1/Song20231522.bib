@conference{Song20231522,
 abstract = {Named entity recognition has received a lot of attention as a fundamental task in natural language processing, but somewhat less attention has been paid to the task of nested named entity recognition. In previous work, many approaches have been proposed to deal with the task of nested named entity recognition. For example, region-based approaches, hypergraph-based approaches, and transformation-based approaches, etc. The more popular approach is currently the span-based approach. Most of the previous span-based approaches were done by separating the nested named entity recognition task into two subtasks independently, first identifying entity boundaries and then classifying them. However, most of such methods suffer from error propagation, large computational cost, and inability to recognize long entities. So we borrowed the idea of two stage in target detection to generate a seed entity and then go through an iterative refinement process to obtain the final boundary and category. First, in the seed entity generation stage, high quality entities are generated by Iou and filters, which are fed to the seed entity refinement module. Let the richer semantic information be aggregated in the seed entity refinement module through the attention mechanism. In addition, we improve the attention mechanism in order to enhance the dependency between inputs and reduce the computational cost. It is experimentally demonstrated that our model achieves better performance than the previous model on the benchmark nested model.  © 2023 IEEE.},
 author = {Song, Ze and Fu, Fa},
 doi = {10.1109/ACAIT60137.2023.10528545},
 journal = {Proceedings of 2023 7th Asian Conference on Artificial Intelligence Technology, ACAIT 2023},
 note = {Cited by: 0},
 pages = {1522 - 1528},
 publication_stage = {Final},
 source = {Scopus},
 title = {Two-Stage Network Based on Attention Mechanism for Nested Named Entity Recognition},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85194183507?origin=resultslist},
