@article{Martin20111,
 abstract = {We propose an example-based approach for simulating complex elastic material behavior. Supplied with a few poses that characterize a given object, our system starts by constructing a space of prefered deformations by means of interpolation. During simulation, this example manifold then acts as an additional elastic attractor that guides the object towards its space of prefered shapes. Added on top of existing solid simulation codes, this example potential effectively allows us to implement inhomogeneous and anisotropic materials in a direct and intuitive way. Due to its example-based interface, our method promotes an art-directed approach to solid simulation, which we exemplify on a set of practical examples. © 2011, ACM. All rights reserved.},
 author = {Martin, Sebastian and Thomaszewski, Bernhard and Gross, Markus and Grinspun, Eitan},
 doi = {10.1145/2010324.1964967},
 journal = {ACM Transactions on Graphics},
 note = {Cited by: 32},
 number = {4},
 pages = {1 - 8},
 publication_stage = {Final},
 source = {Scopus},
 title = {Example-Based Elastic Materials},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84988957914?origin=resultslist},
 volume = {30},
 year = {2011}
}
