@article{1221754,
 abstract = {We present a new minimum description length (MDL) approach based on a deformable partition - a polygonal grid - for automatic segmentation of a speckled image composed of several homogeneous regions. The image segmentation thus consists in the estimation of the polygonal grid, or, more precisely, its number of regions, its number of nodes and the location of its nodes. These estimations are performed by minimizing a unique MDL criterion which takes into account the probabilistic properties of speckle fluctuations and a measure of the stochastic complexity of the polygonal grid. This approach then leads to a global MDL criterion without an undetermined parameter since no other regularization term than the stochastic complexity of the polygonal grid is necessary and noise parameters can be estimated with maximum likelihood-like approaches. The performance of this technique is illustrated on synthetic and real synthetic aperture radar images of agricultural regions and the influence of different terms of the model is analyzed.},
 author = {Galland, F. and Bertaux, N. and Refregier, P.},
 doi = {10.1109/TIP.2003.816005},
 issn = {1941-0042},
 journal = {IEEE Transactions on Image Processing},
 keyword = {Synthetic aperture radar;Image segmentation;Image edge detection;Speckle;Filters;Radar imaging;Stochastic resonance;Image analysis;Optical sensors;Layout},
 month = {Sep.},
 number = {9},
 pages = {995-1006},
 title = {Minimum description length synthetic aperture radar image segmentation},
 volume = {12},
 year = {2003}
}
