@article{Mah201831,
 abstract = {It is proposed to merge an infiltration facility to the conventional road curb system. Towards this end, a Storm Water Management Model (SWMM) is developed to explore the effectiveness of the proposed component at Riveria housing estate, Kota Samarahan, Sarawak. The findings show that the integration is effective in reducing peak runoff. The results indicate that a scenario of hollow infiltration trench achieves zero runoff, and a scenario of filled infiltration trench has a 43.6% reduction in runoff compared with existing road drainage condition. Furthermore, the hollow infiltration trench is found to be the best among all the given scenarios. The SWMM modelling results provide a tool to quantitatively measure the probable use of the proposed measures to improve the existing road drainage system. © 2018 Authors.},
 author = {Mah, Darrien Yau Seng and Ng, Tze Chiat and Putuhena, Frederik Josep},
 doi = {10.14419/ijet.v7i3.18.16668},
 journal = {International Journal of Engineering and Technology(UAE)},
 note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access},
 number = {3},
 pages = {31 - 35},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integrating infiltration facility to urban road drainage},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85082353815?origin=resultslist},
 volume = {7},
 year = {2018}
}
