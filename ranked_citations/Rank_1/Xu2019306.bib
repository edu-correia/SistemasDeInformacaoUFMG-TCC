@conference{Xu2019306,
 abstract = {Multilingual data-parallel pipelines, such as Microsoft’s Scope and Apache Spark, are widely used in real-world analytical tasks. While the involvement of multiple languages (often including both managed and native languages) provides much convenience in data manipulation and transformation, it comes at a performance cost Ð managed languages need a managed runtime, incurring much overhead. In addition, each switch from a managed to a native runtime (and vice versa) requires marshalling or unmarshalling of an ocean of data objects, taking a large fraction of the execution time. This paper presents Niijima, an optimizing compiler for Microsoft’s Scope/Cosmos, which can consolidate C#-based user-deined operators (UDOs) across SQL statements, thereby reducing the number of datalow vertices that require the managed runtime, and thus the amount of C# computations and the data marshalling cost. We demonstrate that Niijima has reduced job latency by an average of 24% and up to 3.3×, on a series of production jobs. © 2019 Copyright held by the owner/author(s).},
 author = {Xu, Guoqing Harry and Veanes, Margus and Barnett, Michael and Musuvathi, Madan and Mytkowicz, Todd and Zorn, Ben and He, Huan and Lin, Haibo},
 doi = {10.1145/3341301.3359649},
 journal = {SOSP 2019 - Proceedings of the 27th ACM Symposium on Operating Systems Principles},
 note = {Cited by: 6; All Open Access; Gold Open Access},
 pages = {306 - 321},
 publication_stage = {Final},
 source = {Scopus},
 title = {Niijima: Sound and automated computation consolidation for eicient multilingual data-parallel pipelines},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85076789327?origin=resultslist},
 year = {2019}
}
