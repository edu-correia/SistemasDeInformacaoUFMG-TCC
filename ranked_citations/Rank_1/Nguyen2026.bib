 publication_stage = {Final},
 source = {Scopus},
 title = {Bounded guaranteed algorithms for concave impurity minimization via maximum likelihood},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105010327443?origin=resultslist},
