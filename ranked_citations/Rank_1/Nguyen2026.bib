@article{Nguyen2026,
 abstract = {Partitioning algorithms are important in many scientific and engineering applications. A partitioning algorithm splits a set into disjoint partitions and the quality of the splitting is measured by the amount of impurity in each partition. In general, finding the minimum impurity partitions is an NP-hard problem for a given impurity measure specified by a real-valued partitions function. In particular, let M be the size of N-dimensional elements in a set and K be the number of partitions, an exhaustive search over all the possible partitions to find an optimal one with the lowest impurity will have the complexity of O(K<sup>M</sup>), which is an exponential function of the size of the dataset, and will require infeasible computing resources. To solve this problem, we first construct an upper bound and a lower bound for a class of impurity functions. Based on these bounds, we propose a low-complexity partitioning algorithm with a bounded performance guarantee based on the maximum likelihood principle. The theoretical analyses on the bounded guarantee of the algorithms are given for two well-known impurity functions, the Gini index and Entropy. Particularly, when K≥N, under certain conditions, the proposed algorithm achieves a 2-approximation for the Gini index, and a log<sup>2</sup>N-approximation for entropy impurity with a polynomial time complexity of O(NM). However, when K<N, to achieve the bounded approximation, the time complexity of the algorithm becomes O(2<sup>N/2</sup>NM). To resolve this problem, we propose a heuristic greedy-merge algorithm when K<N that has a linear time complexity of O((N−K)N<sup>2</sup>+NM). Although the greedy-merge algorithm is linear in the size of data M and its practical performance is comparable to the state-of-the-art algorithms, we do not guarantee a bounded performance for our proposed heuristic algorithm. Finally, our results also generalize some well-known information-theoretic bounds such as Fano's inequality and Boyd-Chiang's bound. © 2025},
 author = {Nguyen, Thuan and Le, Hoang and Nguyen, Thinh},
 doi = {10.1016/j.sigpro.2025.110151},
 journal = {Signal Processing},
 note = {Cited by: 0},
