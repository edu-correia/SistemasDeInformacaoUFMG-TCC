@article{11050988,
 abstract = {The decision tree, as an efficient data structure, is commonly used to perform packet classification due to its faster classification speed. During packet classification, all packets need to traverse each decision tree in descending order starting from the highest priority to match the rules. Therefore, the lookup performance of the decision tree with the highest priority has an important impact on the total classification performance. Moreover, reducing the number of decision trees to be accessed is an effective way to improve the classification performance further. In this regard, a new scheme called PartitionFilter is proposed in this paper. PartitionFilter adopts an adaptive rule set partition method (RSP) to reduce the lookup time of the decision trees (not only the highest-priority decision trees). A decision tree filtration method (DTF) is also proposed to reduce the number of traversals among decision trees. Experimental results show that the throughput of PartitionFilter is improved by an average of 54%, and the number of memory accesses is reduced by an average of 76% compared to PTTree.},
 author = {Li, Zhuo and Pei, Yuheng and Xun, Hao and Liu, Jindian and Luo, Peng and Zhang, Yu and Liang, Teng and Liu, Kaihua},
 doi = {10.1109/TNSE.2025.3582928},
 issn = {2327-4697},
 journal = {IEEE Transactions on Network Science and Engineering},
 keyword = {Decision trees;IP networks;Filtration;Classification algorithms;Training;Throughput;Performance evaluation;Microelectronics;Merging;Data structures;Packet classification;decision tree;partition},
 month = {},
 number = {},
 pages = {262-277},
 title = {PartitionFilter: A Fast Packet Classification Algorithm Based on Adaptive Partition and Filter},
 volume = {13},
 year = {2026}
}
