@article{Kılıç2018255,
 abstract = {In this paper, we analyze cooperation phenomena based on agent synthesis on merge of timed two-input discrete transition systems. The model allows handling of possible incomplete task environment descriptions and representation of nondeterministic directive effects and/or deviating (or blocking) disturbances defined over agent capabilities. Also, we propose an agent dependency measure that uses the result of additive Merge&Synthesis operation for quantification purpose. © Springer Nature Switzerland AG 2018.},
 author = {Kılıç, Hürevren},
 doi = {10.1007/978-3-030-03014-8_24},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {255 - 262},
 publication_stage = {Final},
 source = {Scopus},
 title = {An agent cooperation model and dependency measurement based on merge & synthesis on shared timed task environments},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85057096679?origin=resultslist},
 volume = {11248 LNAI},
 year = {2018}
}
