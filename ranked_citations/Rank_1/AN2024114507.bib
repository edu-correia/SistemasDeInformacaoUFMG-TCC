@article{AN2024114507,
 abstract = {This study investigates an innovative approach for designing novel materials with excellent non‑lithium storage properties. Using anhydrous cuprous iodide molten salt as an etchant, we treated the MAX phase to create a 3D MXene-based composite, 3D MXene-I-Cu, with iodine functional groups. This was then converted in situ to 3D MXene-I-Cu2Se through selenization. Characterization confirmed the successful synthesis of 3D MXene-I-Cu2Se. This material demonstrated impressive electrochemical performance as an anode in sodium-ion and potassium-ion batteries, and as a cathode in aluminum-ion batteries, showing high specific capacity, excellent multiplication capability, and outstanding cycling stability. Comprehensive tests revealed that the unique 3D structure facilitates rapid ion diffusion and efficient electron transport, while modified functional groups enhance structural stability and active site exposure. Additionally, we examined the impact of different electrochemical systems on the energy storage and sodium storage mechanism of 3D MXene-I-Cu2Se.},
 author = {Ruifeng An and Hongkun Niu and Zhiqiang Tian and Cong Wang and Bingliang Gao},
 doi = {https://doi.org/10.1016/j.est.2024.114507},
 issn = {2352-152X},
 journal = {Journal of Energy Storage},
 keyword = {3D MXene-based composites, Modified functional group, Sodium storage capacity, Potassium storage capacity, Aluminum storage capacity},
 pages = {114507},
 title = {Iodine-functionalized 3D MXene-I-Cu2Se, prepared via Lewis acid etching, achieves superior sodium/potassium/aluminum storage performance},
 url = {https://www.sciencedirect.com/science/article/pii/S2352152X24040933},
 volume = {104},
 year = {2024}
}
