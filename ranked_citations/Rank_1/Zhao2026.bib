@article{Zhao2026,
 abstract = {The coexistence of connected and automated vehicles (CAVs) and human-driven vehicles (HDVs) in mixed traffic presents significant challenges for the safe CAV platoon lane-change (CAV-PLC) maneuver. Due to the uncertainties of human drivers and their difficulty in understanding CAV-PLC maneuver, right-of-way conflict often arises between CAV platoon and HDVs. Therefore, this paper proposes a novel CAV-PLC strategy within a unified framework that integrates decision-making (Module I), trajectory planning (Module II), and motion control (Module III). By iteratively operating these modules, the CAV platoon can enhance the right-of-way competitiveness while ensuring safety in mixed traffic. In Module I, a Stackelberg game model-based multiple non-cooperative games (MNCG) method is developed to facilitate PLC decision-making considering human driving styles. Multiple parallel lateral lines are defined to generate decisions (e.g., changing to the next line, remaining at the current line, or returning to the previous line), which improves interpretability for HDVs and reduces conflict. To implement the decisions from MOdelue I, Module II builds an artificial fish swarm algorithm (AFSA)-based trajectory planning method, taking into account platoon size, lane-change safety, and driving comfort. Furthermore, Module III integrates a Barrier Lyapunov Function (BLF)-based lateral control with consensus-based longitudinal control to ensure stable and accurate execution of the Module II's outputs. Finally, extensive simulations are conducted to validate the feasibility of the proposed strategy. © 1967-2012 IEEE.},
 author = {Zhao, Hang and Liu, Ling and Li, Yongfu},
 doi = {10.1109/TVT.2026.3661283},
 journal = {IEEE Transactions on Vehicular Technology},
