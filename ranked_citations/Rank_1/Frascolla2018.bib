@conference{Frascolla2018,
 abstract = {One of the most important announced assets of the forthcoming 5G network is the capability to merge different technologies in an overarching much more effective telecommunication system. At the verge of 5G deployment, it's therefore key to have the right means to test and pre-develop the integration of two main pillars of 5G, i.e. wireless and optical systems. The target of this paper is to discuss some interesting aspects of performing experiments at the wireless-optical boundary, focusing on the activities of the EU-Brazil funded research project FUTEBOL. © 2018 IEEE.},
 author = {Frascolla, Valerio and Colman-Meixner, Carlos and Nejabati, Rezaw and Simeonidou, Dimitra and Slyne, Frank and Zhang, Yi and Dasilva, Luiz A. and Ruffini, Marco and Martinello, Magnos and Guimaraes, Rafael S. and Ribeiro, Moises Renato Nunes},
 doi = {10.1109/PS.2018.8751283},
 journal = {Proceedings of the 2018 Photonics in Switching and Computing, PSC 2018},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {When optical networks meet wireless systems: experiments at the boundary},
 type = {Conference paper},
