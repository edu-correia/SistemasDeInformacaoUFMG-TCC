@article{10.1145/1044731.1044735,
 abstract = {We study and further develop two language-based techniques for analyzing security protocols. One is based on a typed process calculus; the other, on untyped logic programs. Both focus on secrecy properties. We contribute to these two techniques, in particular by extending the former with a flexible, generic treatment of many cryptographic operations. We also establish an equivalence between the two techniques.},
 address = {New York, NY, USA},
 author = {Abadi, Mart\'{\i}n and Blanchet, Bruno},
 doi = {10.1145/1044731.1044735},
 issn = {0004-5411},
 issue_date = {January 2005},
 journal = {J. ACM},
 keyword = {Cryptographic protocols, logic programming, process calculi, secrecy properties, typing},
 month = {January},
 number = {1},
 numpages = {45},
 pages = {102–146},
 publisher = {Association for Computing Machinery},
 title = {Analyzing security protocols with secrecy types and logic programs},
 url = {https://doi.org/10.1145/1044731.1044735},
 volume = {52},
 year = {2005}
}
