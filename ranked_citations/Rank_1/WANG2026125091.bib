@article{WANG2026125091,
 abstract = {Flow-induced vibrations (FIVs) of side-by-side flexible cylinders were investigated using three-dimensional (3D) Large-Eddy Simulation (LES) coupled with the mode superposition method. Simulations were carried out at a Reynolds number Re = 1000 and four spacing ratios, Sy/D = 3, 4, 5, and 8, and conducted the first study one the effects of Sy/D on vibration amplitudes, flow structures, surface pressures, hydrodynamic forces and mean power (PWR). Pronounced FIV responses appear at small Sy/D during the amplitude-ascent stage, whereas the peak amplitudes are lower than those of an isolated cylinder during the near-peak and amplitude-descent stages. Within the critical interference region (3 ≤ Sy/D ≤ 5), the Venturi effect amplifies pressure magnitudes and leads to asymmetric surface pressure distributions. In-phase flip-flopping wake patterns with vortex merging weaken the negative pressure on the inner shear layers, while anti-phase synchronized wake patterns correspond to symmetric pressure distributions. The hydrodynamic energy transfer is found to vary significantly across different vibration stages. Intense gap vortices during the amplitude-ascent stage strengthen negative pressures and enhance positive PWR in the inner shear layers, thus promoting FIVs. During the near-peak stage, vortex merging reduces the positive PWR and suppresses structural responses. In the amplitude-descent stage, the Venturi effect plays a dominant stabilizing role, as the suppression effect induced by increased positive surface pressure exceeds the excitation effect from enhanced negative pressure.},
 author = {Yuqi Wang and Zhanbiao Zhang and Fuyou Xu},
 doi = {https://doi.org/10.1016/j.oceaneng.2026.125091},
 issn = {0029-8018},
 journal = {Ocean Engineering},
 keyword = {Flow-induced vibration, Side-by-side flexible cylinder, Wake-structure interaction, Wake pattern, Surface pressure distribution, Energy property},
 pages = {125091},
 title = {Numerical studies for the flow-induced vibrations of side-by-side dual flexible cylinders},
 url = {https://www.sciencedirect.com/science/article/pii/S002980182600925X},
 volume = {355},
 year = {2026}
}
