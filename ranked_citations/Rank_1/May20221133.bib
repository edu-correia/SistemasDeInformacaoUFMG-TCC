@conference{May20221133,
 abstract = {Global warming modifies the climate balance. Warming parameters are observed by many Earth Observation satellite systems, and the huge amount of data modifies the way to process them. This paper presents a few studies relative to damage detection on buildings, occurred during natural disasters. Recent advances in deep learning techniques are used for the building detection such as EfficientNet networks. Additional networks as Siamese models are used to evaluate the damage level with pre- and post-event images. Different techniques to merge detection masks are described and compared to a multiclass segmentation network. Results are presented and performances of the different solutions are compared.  © Authors 2022},
 author = {May, S. and Dupuis, A. and Lagrange, A. and De Vieilleville, F. and Fernandez-Martin, C.},
 doi = {10.5194/isprs-archives-XLIII-B3-2022-1133-2022},
 journal = {International Archives of the Photogrammetry, Remote Sensing and Spatial Information Sciences - ISPRS Archives},
 note = {Cited by: 10; All Open Access; Gold Open Access; Green Open Access},
 number = {B3-2022},
 pages = {1133 - 1138},
 publication_stage = {Final},
 source = {Scopus},
 title = {BUILDING DAMAGE ASSESSMENT WITH DEEP LEARNING},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85131922825?origin=resultslist},
 volume = {43},
 year = {2022}
}
