@article{MAJEWSKI2025416932,
 abstract = {Bismuth sesquioxide (Bi2O3) draws much attention due to the wide variety of phases in which it exists depending on the temperature. According to our best knowledge, pure Bi2O3 in bulk has not been synthesized in a laboratory in a glassy phase yet, even though this oxide is quite often used in various glass systems. It is the first time that molecular dynamics simulation is used to synthesize amorphous Bi2O3 by liquid-quenching. Structural analysis revealed that the local order in such obtained glass closely resembles that of crystalline phase δ. However, in the glass structure, the two first O-O coordination peaks characterizing δ structure appear to merge into a single peak. We varied the cooling rate by the order of magnitude and determined its role on structural characteristics revealing relatively minor changes for quenched structures within the studied cooling rate range. However, the heating rate impacts the apparent melting temperature and oxygen sublattice structure and dynamics in the crystal phase. Analogously, the cooling rate affects the glass transition temperature.},
 author = {Szymon Majewski and Maciej Nowagiel and Kacper Skelnik and Marek Wasiucionek and Pawel Keblinski and Tomasz K. Pietrzak},
 doi = {https://doi.org/10.1016/j.physb.2025.416932},
 issn = {0921-4526},
 journal = {Physica B: Condensed Matter},
 keyword = {Bismuth oxide, Glass structure, Liquid quenching, Molecular dynamics},
 pages = {416932},
 title = {Structural characterization of amorphous Bi2O3 obtained by molecular dynamics simulation of melt quenching},
 url = {https://www.sciencedirect.com/science/article/pii/S0921452625000493},
 volume = {701},
 year = {2025}
}
