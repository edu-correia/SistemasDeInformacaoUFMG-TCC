@article{Schmidt2014345,
 abstract = {The probabilistic real-time automaton (PRTA) is a representation of dynamic processes arising in the sciences and industry. Currently, the induction of automata is divided into two steps: the creation of the prefix tree acceptor (PTA) and the merge procedure based on clustering of the states. These two steps can be very time intensive when a PRTA is to be induced for massive or even unbounded datasets. The latter one can be efficiently processed, as there exist scalable online clustering algorithms. However, the creation of the PTA still can be very time consuming. To overcome this problem, we propose a genuine online PRTA induction approach that incorporates new instances by first collapsing them and then using a maximum frequent pattern based clustering. The approach is tested against a predefined synthetic automaton and real world datasets, for which the approach is scalable and stable. Moreover, we present a broad evaluation on a real world disease group dataset that shows the applicability of such a model to the analysis of medical processes. © 2014 Springer Science+Business Media New York & Science Press, China.},
 author = {Schmidt, Jana and Kramer, Stefan},
 doi = {10.1007/s11390-014-1435-8},
 journal = {Journal of Computer Science and Technology},
 note = {Cited by: 4},
 number = {3},
 pages = {345 - 360},
 publication_stage = {Final},
 source = {Scopus},
 title = {Online induction of probabilistic real-time automata},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84901651917?origin=resultslist},
 volume = {29},
 year = {2014}
}
