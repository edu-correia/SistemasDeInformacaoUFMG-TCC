@conference{Tsuboi2019,
 abstract = {Unlike traditional data such as relational databases and XML documents, most of graphs do not have their own schema. However, schema is a concise representation of a graph, and if we can extract a “good” schema from a graph, we can take advantage of the extracted schema for effective graph data management. In this paper, we focus on Shape Expression Schemas (ShEx) and consider extracting ShEx schemas from RDF/graph data. To manage both efficiency and quality of extracted schema, our algorithm consists of two schema extraction steps: (i) edge-label based clustering and (ii) type-merge method for target nodes of outgoing edges. We made preliminary experiments, which result suggests that our algorithm can extract ShEx schemas appropriately. © 2019 Association for Computing Machinery.},
 author = {Tsuboi, Yuroti and Suzuki, Nobutaka},
 doi = {10.1145/3342558.3345417},
 journal = {Proceedings of the ACM Symposium on Document Engineering, DocEng 2019},
 note = {Cited by: 8},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An algorithm for extracting shape expression schemas from graphs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85073328979?origin=resultslist},
 year = {2019}
}
