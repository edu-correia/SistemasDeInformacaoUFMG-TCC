@inproceedings{5138628,
 abstract = {An improved algorithm was proposed and applied to the fast and exact boundary extraction of high resolution PCB images. Firstly, two problems in the original algorithm were mentioned and solved respectively by introducing splitting points and merging points and by designing an extended data structure. Secondly, the MMX/SSE instructions were easily introduced to optimize the run-length encoding procedure of the improved algorithm, and a parameter called run average compression ratio was introduced and used to qualitatively analyze the range of application of the improved algorithm and the optimization efficiency to be achieved. Experimental results show that the optimization can make it run more than two times faster in the application of the boundary extraction for high resolution PCB images.},
 author = {Tao Hu and Baoping Guo},
 booktitle = {2009 4th IEEE Conference on Industrial Electronics and Applications},
 doi = {10.1109/ICIEA.2009.5138628},
 issn = {2158-2297},
 keyword = {Image resolution;Data mining;Algorithm design and analysis;Image coding;Merging;Computer aided manufacturing;Machine vision;Image processing;Testing;Pixel;boundary extraction;PCB;splitting point;merging point;MMX/SSE;run average compression ratio},
 month = {May},
 number = {},
 pages = {2392-2395},
 title = {Fast and exact boundary extraction of high resolution PCB images},
 volume = {},
 year = {2009}
}
