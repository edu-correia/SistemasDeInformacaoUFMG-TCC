@article{5401074,
 abstract = {One of the fundamental goals of computational neuroscience is the study of anatomical features that reflect the functional organization of the brain. The study of physical associations between neuronal structures and the examination of brain activity in vivo have given rise to the concept of anatomical and functional connectivity, which has been invaluable for our understanding of brain mechanisms and their plasticity during development. However, at present, there is no robust and accurate computational framework for the quantitative assessment of cortical connectivity patterns. In this paper, we present a quantitative analysis and modeling tool that is able to characterize anatomical connectivity patterns based on a newly developed coclustering algorithm, termed the business model-based coclustering algorithm (BCA). We apply BCA to diffusion tensor imaging (DTI) data in order to provide an automated and reproducible assessment of the connectivity patterns between different cortical areas in human brains. BCA not only partitions the cortical mantel into well-defined clusters, but also maximizes the connectivity strength between these clusters. Moreover, BCA is computationally robust and allows both outlier detection as well as parameter-independent determination of the number of clusters. Our coclustering results have showed good performance of BCA in identifying major white matter fiber bundles in human brains and facilitate the detection of abnormal connectivity patterns in patients suffering from various neurological diseases.},
 author = {Lin, Cui and Pai, Darshan and Lu, Shiyong and Muzik, Otto and Hua, Jing},
 doi = {10.1109/TITB.2010.2040286},
 issn = {1558-0032},
 journal = {IEEE Transactions on Information Technology in Biomedicine},
 keyword = {Image analysis;Diffusion tensor imaging;Brain;Robustness;Clustering algorithms;Partitioning algorithms;Humans;Neuroscience;In vivo;Pattern analysis;Coclustering;corticocortical connectivity;DTI;fiber tracking},
 month = {March},
 number = {2},
 pages = {514-525},
 title = {Coclustering for Cross-Subject Fiber Tract Analysis Through Diffusion Tensor Imaging},
 volume = {14},
 year = {2010}
}
