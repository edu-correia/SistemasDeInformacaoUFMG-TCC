@article{Wang20241813,
 abstract = {The emerging trend of memory disaggregation where CPU and memory are physically separated from each other and are connected via ultra-fast networking, e.g., over Remote Direct Memory Access (RDMA), allows elastic and independent scaling of compute (CPU) and main memory. This paper investigates how indexing can be efficiently designed in the memory disaggregated architecture. Although existing research has optimized the B-tree for this new architecture, its performance is unsatisfactory. This paper focuses on LSM-based indexing and proposes dLSM,the first highly optimized LSM-tree for disaggregated memory. dLSM introduces a suite of optimizations including reducing software overhead, leveraging near-data computing, tuning for byte-addressability, and an instantiation over RDMA as a case study with RDMA-specific customizations to improve system performance. Experiments illustrate that dLSM achieves 2.3× to 11.6× higher write throughput than running the optimized B-tree and four adaptations of existing LSM-tree indexes over disaggregated memory. dLSM is written in C++ (with approximately 54,400 LOC), and is open-sourced. © The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature 2024.},
 author = {Wang, Ruihong and Gao, Chuqing and Wang, Jianguo and Kadam, Prishita and TamerÖzsu, M. and Aref, Walid G.},
 doi = {10.1007/s00778-024-00863-y},
 journal = {VLDB Journal},
 note = {Cited by: 3},
 number = {6},
 pages = {1813 - 1836},
 publication_stage = {Final},
 source = {Scopus},
 title = {Optimizing LSM-based indexes for disaggregated memory},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85196417424?origin=resultslist},
