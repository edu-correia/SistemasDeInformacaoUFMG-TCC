@conference{Vandersanden2023333,
 abstract = {HTTP adaptive streaming is a demanding application requiring high throughput and low latency, with consumers expecting an ever-increasing quality of experience. This doctoral study proposes a novel methodology to analyze and guarantee these requirements through the establishment of a holistic cross-layer application view. By significantly increasing the amount of data points and sources available as well as combining them into a unified representation, the proposed holistic point of view facilitates root cause analysis. At the same time, it can support or even automate analysis of various (sub)processes in the end-To-end chain. Potential cross-layer optimizations in the workflow are also more easily identified and analyzed.  © 2023 ACM.},
 author = {Vandersanden, Mike},
 doi = {10.1145/3587819.3593026},
 journal = {MMSys 2023 - Proceedings of the 14th ACM Multimedia Systems Conference},
 note = {Cited by: 1; All Open Access; Green Open Access},
 pages = {333 - 337},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Holistic Approach to Understand HTTP Adaptive Streaming},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85163691654?origin=resultslist},
 year = {2023}
}
