@article{11417476,
 abstract = {This article presents a 3-Mpixel (Mp) three-stacked digital pixel sensor (DPS) featuring the world’s smallest pixel pitch of  $2.988~\mu $ m, achieving a low temporal random noise (RN) of 1.16 e-rms and a high dynamic range (HDR) of 123 dB in global-shutter (GS) operation mode for versatile applications. To realize both the low RN and HDR performance, the developed DPS employs a pixel-parallel analog-to-digital converter (P-ADC) architecture with an extremely narrow noise bandwidth (BW), as well as a split photodiode (PD) structure combined with signal chopping operation to mitigate the LED flicker phenomenon. In addition, the DPS leverages a three-stacked sensor architecture, which enables a compact pixel footprint while enhancing on-chip image signal processing (ISP) capabilities and supporting efficient HDR merging. Chip-level evaluations confirm the superior performance of the proposed DPS, demonstrating its potential for high-performance imaging in mobile, automotive, machine vision (MV), and other advanced applications.},
 author = {Seo, Min-Woong and Choi, Yong-Suk and Lee, Sanggwon and Shim, Yeongseok and Cho, Gihwan and Bae, Daehee and Ito, Masamichi and Jeong, Jaehun and Sugihara, Hiroyuki and Koo, Si-Gyoung and Byun, Sung-Jae and Kwon, Hyukbin and Lee, Youna and Kim, Bumjun and Han, Su-Hyun and Kim, Suksan and Ryu, Wonoh and Kim, Kwan-Sik and Kim, Yongjun and Kim, Seung-Sik and Jung, Junghoon and Yoo, Sun-Young and Heo, Jinkyeong and Shin, Seung-Chul and Shim, Heesung and Lee, Jae-Kyu and Go, Jonghyun and Song, Jaihyuk},
 doi = {10.1109/JSSC.2026.3663214},
 issn = {1558-173X},
 journal = {IEEE Journal of Solid-State Circuits},
 keyword = {Noise;Cogeneration;Light emitting diodes;Capacitors;Substrates;Cradle to cradle;Fluctuations;Transistors;System-on-chip;High dynamic range;CMOS image sensor (CIS);digital pixel sensor (DPS);global shutter (GS);high dynamic range (HDR);high speed;in-pixel Cu-to-Cu (C2C) bonding;LED flicker mitigation (LFM);low power consumption;low random noise (RN);pixel-parallel analog-to-digital converter (P-ADC);three-stacked sensor architecture},
 month = {April},
 number = {4},
 pages = {1319-1332},
 title = {A 1.16 e-rms Temporal Random Noise, 123-dB High Dynamic Range, 2.988-μm Pitch 3-Mpixel Three-Stacked Digital Pixel Sensor for Versatile Applications},
 volume = {61},
 year = {2026}
}
