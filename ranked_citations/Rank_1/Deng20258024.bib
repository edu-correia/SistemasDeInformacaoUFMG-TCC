@conference{Deng20258024,
 abstract = {Semantic segmentation of high-resolution UAV images is critical for online environmental awareness and rapid emergency response. However, many current network models are over-parameterized and require massive computational resources, making it difficult to balance segmentation accuracy and inference efficiency for large-scale and high-resolution UAV images. To address this issue, we proposed an efficient semantic segmentation network that employs the Local-Global-Local information exchange mechanism to achieve local information aggregation, global sparse attention, and local information propagation, which optimizes the processing efficiency of local-wise semantic information and global-wise contextual dependencies. In addition, we observed that many local-wise tokens extracted from high-resolution UAV images are highly similar. To exploit this property, we introduced an adaptive local-wise token merge strategy to further reduce the computational complexity of full matrix multiplications for the feed-forward layers. Compared to other lightweight semantic segmentation methods, our model achieved a better balance between segmentation accuracy and inference efficiency with an image size of 1024×2048. Experiments show that our network outperforms existing models on two high-resolution UAV image datasets, UAVid and FloodNet, achieving mean intersection over union (mIoU) of 69.62% and 77.37%, respectively. © 2025 IEEE.},
 author = {Deng, Changjian and Zhou, Zijing and Yang, Zhiguo and Zhang, Yijie and Xia, Ziying and Cheng, Jian},
 doi = {10.1109/IGARSS55030.2025.11242700},
 journal = {International Geoscience and Remote Sensing Symposium (IGARSS)  },
 note = {Cited by: 0},
 pages = {8024 - 8028},
 publication_stage = {Final},
 source = {Scopus},
 title = {EFFICIENT LOCAL-GLOBAL-LOCAL INFORMATION EXCHANGE WITH ADAPTIVE TOKEN MERGING FOR HIGH-RESOLUTION UAV IMAGE SEMANTIC SEGMENTATION},
 type = {Conference paper},
