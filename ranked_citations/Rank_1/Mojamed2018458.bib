@conference{Mojamed2018458,
 abstract = {MANET is a decentralized network optimized for an infrastructure-less area. Its applications are designed to operate in a distributed manner. Peer-to-peer (P2P) overlays are a possible addition to MANETs to aid in managing resources and information sharing in distributed networks. In this paper, the Kademlia P2P overlay is deployed over a dynamic and different MANET underlaying technologies. This overlay was combined with two different types of MANET routing: OLSR and AODV. An extensive evaluation is carried out for the performance of these combinations in different dynamic network settings. The results show that in most cases, Kademlia achieves its best performance when layered over AODV. However, OLSR-based Kademlia outperforms AODV in terms of delay and network load. © 2018 IEEE.},
 author = {Mojamed, Mohammad Al and Al-Shehri, Awwadh},
 doi = {10.1109/ICUFN.2018.8436723},
 journal = {International Conference on Ubiquitous and Future Networks, ICUFN},
 note = {Cited by: 1},
 pages = {458 - 463},
 publication_stage = {Final},
 source = {Scopus},
 title = {Performance Evaluation of Kademlia in Mobile Ad Hoc Networks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85052530101?origin=resultslist},
 volume = {2018-July},
 year = {2018}
}
