@article{Ye2019460,
 abstract = {Neuron reconstruction from anisotropic 3D Electron Microscopy (EM) images is a challenging problem. One often considers an input image as a stack of 2D image slices, and consider both intra and inter slice segments information. In this paper, we present a new segmentation algorithm which builds a unified energy function and jointly optimize the per-slice segmentation and the inter-slice consistency. To find an optimal solution from the huge solution space, we propose a novel diverse multiple prediction method which also encourages diversity in partial solutions. We demonstrate the strength of our method in several public datasets. © 2019, Springer Nature Switzerland AG.},
 author = {Ye, Ze and Chen, Cong and Yuan, Changhe and Chen, Chao},
 doi = {10.1007/978-3-030-32239-7_51},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {460 - 468},
 publication_stage = {Final},
 source = {Scopus},
 title = {Diverse multiple prediction on neuron image reconstruction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85075638599?origin=resultslist},
 volume = {11764 LNCS},
 year = {2019}
}
