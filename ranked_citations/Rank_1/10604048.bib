@inproceedings{10604048,
 abstract = {We presented a novel network architecture integrating Swin Transformer and Convolutional Neural Networks (CNNs) for enhanced local and global feature extraction and fusion. Combining Swin Transformer and CNNs within a dual encoder setup and featuring a novel Feature Fusion Module (FFM) and Contrast Attention Module (CAM), the network adeptly integrates local and global information, improving feature discernibility and segmentation accuracy. By incorporating a joint loss function of soft cross-entropy and Dice loss, the model shows notable results on the Beijing Land Use dataset, exceeding several top methods in semantic segmentation efficacy.},
 author = {He, Hongyu},
 booktitle = {2024 5th International Conference on Computer Vision, Image and Deep Learning (CVIDL)},
 doi = {10.1109/CVIDL62147.2024.10604048},
 issn = {},
 keyword = {Adaptation models;Accuracy;Semantic segmentation;Semantics;Computer architecture;Network architecture;Transformers;Semantic Segmentation;Remote Sensing Images;Feature Fusion;Contrast Attention},
 month = {April},
 number = {},
 pages = {1188-1192},
 title = {Remote sensing image semantic segmentation network with feature comparison and parallel fusion},
 volume = {},
 year = {2024}
}
