@inproceedings{1559789,
 abstract = {In the paper, the state assignment methods of the finite state machines for PAL-based structures are presented. A main feature of the PAL-cell is a limited number of product terms (k-AND-gates) that are connected to a single sum (OR-gate). Function, which is the sum of p-implicants, when p/spl ne/k, does not take full advantage of the cell. When p>k, implementation is multi-cell (so multi-level). The main idea of solving this problem is to count the number of product terms during the process of state assignment. First algorithm leads to automata which take advantage of the number of PAL-cell terms. Second approach is dedicated to state assignment of fast automata. Methods based on primary and secondary merging conditions are presented. In one of the most basic states of the logic synthesis of sequential devices, the elements referring to restrictions of PAL-based CPLDs are taken into account.},
 author = {Czerwinski, R. and Kania, D.},
 booktitle = {8th Euromicro Conference on Digital System Design (DSD'05)},
 doi = {10.1109/DSD.2005.71},
 issn = {},
 keyword = {Automata;Encoding;Merging;Logic devices;Paper technology;Flip-flops;Automatic logic units;Information technology;Genetic algorithms;Energy consumption},
 month = {Aug},
 number = {},
 pages = {127-134},
 title = {State assignment for PAL-based CPLDs},
 volume = {},
 year = {2005}
}
