@conference{Talburt2008394,
 abstract = {This paper describes a formal, set-theoretic framework for multi-source, entity-based data integration. The framework provides a structure and notation for defining and expressing solutions to problems related to entity-based integration. The expressiveness of the framework is illustrated by using it to define a commonly used integration operator (Native Accuracy Optimization).},
 author = {Talburt, John R. and Hashemi, Ray R.},
 journal = {Proceedings of the 2008 International Conference on Information and Knowledge Engineering, IKE 2008},
 note = {Cited by: 3},
 pages = {394 - 398},
 publication_stage = {Final},
 source = {Scopus},
 title = {A formal framework for defining entity-based, data source integration},
 type = {Conference paper},
