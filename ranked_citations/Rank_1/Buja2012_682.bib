@article{Buja2012_682,
 abstract = {This article points out through climate simulations from the National Center for Atmospheric Research (NCAR) that global warming will be increased by the end of the 21st century 3.3°C and in some areas as 7-8°C. This change will have an impact on agricultural production and human mortality. A new emphasis on the integration of social sciences with physical sciences will be fundamental to address the problem of climate adaptation; likewise, it will be important for decision-making to overcome the vulnerability and the challenges that brings a climate change},
 author = {Buja, Lawrence},
 number = {36},
 pages = {47--47},
 title = {CMIP5 Climate Simulations: Implications for Hydrology*},
 volume = {0},
 year = {2012}
}
