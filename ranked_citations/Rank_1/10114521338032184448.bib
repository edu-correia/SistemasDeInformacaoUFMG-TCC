@article{10.1145/2133803.2184448,
 abstract = {We present efficient algorithms that implement four local searches for the Steiner problem in graphs: vertex insertion, vertex elimination, key-path exchange, and key-vertex elimination. In each case, we show how to find an improving solution (or prove that none exists in the neighborhood) in &lt;it&gt;O&lt;/it&gt;(&lt;it&gt;m&lt;/it&gt; log &lt;it&gt;n&lt;/it&gt;) time on graphs with &lt;it&gt;n&lt;/it&gt; vertices and &lt;it&gt;m&lt;/it&gt; edges. Many of the techniques and data structures we use are relevant in the study of dynamic graphs in general, beyond Steiner trees. Besides the theoretical interest, our results have practical impact: These local searches have been shown to find good-quality solutions in practice, but high running times limited their applicability.},
 address = {New York, NY, USA},
 articleno = {2.2},
 author = {Uchoa, Eduardo and Werneck, Renato F.},
 doi = {10.1145/2133803.2184448},
 issn = {1084-6654},
 issue_date = {2012},
 journal = {ACM J. Exp. Algorithmics},
 keyword = {Steiner trees, algorithms, data structures, experimental evaluation, heuristics, local search},
 month = {May},
 numpages = {22},
 publisher = {Association for Computing Machinery},
 title = {Fast local search for the steiner problem in graphs},
 url = {https://doi.org/10.1145/2133803.2184448},
 volume = {17},
 year = {2012}
}
