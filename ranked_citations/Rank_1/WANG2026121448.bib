@article{WANG2026121448,
 abstract = {This study investigates a hybrid battery-flywheel energy storage system integrated with a permanent magnet synchronous motor (PMSM) to enhance regenerative braking in electric vehicles. Nonlinear and time-varying factors including state of charge (SOC), open-circuit voltage, thermal effects, along with PMSM dynamics are incorporated into the modeling framework. A metaheuristic optimization scheme has been used in which Genetic Algorithm (GA), Particle Swarm Optimization (PSO) and Differential Evolution (DE) were adopted to adjust Proportional-Integral (PI) controller gains. In addition, an adaptive dual neural-network PI regulator, merging Back-Propagation (BP) and Radial Basis Function (RBF) networks, has been formulated to enhance system robustness against disturbances. Simulation outcomes have indicated that this hybrid system surpasses a single battery storage setup that yield over 20 kJ of recovered energy while lowering peak charging current (3.0 A versus 3.7–4.0 A). Among the algorithms, PSO achieved the highest energy recovery (+1.0% compared to GA), DE provides comparable recovery with superior torque smoothness (±0.5 Nm ripple) and GA delivers acceptable but slower convergence with higher oscillations (±1.0 Nm). Overall, the proposed framework improved braking energy recovery by ∼15–20% and reduces torque ripple by up to 50% compared with a conventional mono-battery system using fixed-gain PI control. These findings confirm that the integration of metaheuristic optimization with adaptive Neural Network-PI (NN-PI) control enhances braking energy utilization, reduces battery stress and improves torque stability, offering a practical pathway for efficient energy management in next-generation electric vehicles. The proposed framework is validated via comprehensive simulation studies; experimental and hardware-in-the-loop validation is planned as future work.},
 author = {Chenyu Wang and Mingzhao Xue and Zhenhao Han},
 doi = {https://doi.org/10.1016/j.est.2026.121448},
 issn = {2352-152X},
 journal = {Journal of Energy Storage},
 keyword = {Permanent magnet synchronous motor, Battery-flywheel energy storage system, Neural network-PI control, Electric vehicle, State of charge, Differential evolution},
 pages = {121448},
 title = {Enhanced energy recovery in electric vehicles using genetic algorithm, particle swarm optimization and differential evolution-tuned proportional-integral controllers with adaptive neural network control of battery flywheel hybrid systems},
 url = {https://www.sciencedirect.com/science/article/pii/S2352152X26011126},
 volume = {155},
 year = {2026}
}
