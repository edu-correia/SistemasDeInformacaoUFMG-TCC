@conference{Cho2015424,
 abstract = {As the world's leading technology, Optical Carrier Ethernet System is a multi-layer convergence solution towards high bandwidth and optimized path control based GMPLS control plane and management plane. We show the one smart box with one protocol engine enabling the integration of packet and optical layer telecommunication in PTN, OTN TDM and WDM transmission technology. In this paper, the results of the lab test introduced to verify the efficiency and feasibility of the automatic path control for various reliable transport tunnels in real time. © 2014 IEEE.},
 author = {Cho, Eunyoung and Kwon, Taehyun and Han, Kyungeun and Byun, Sunhyuk and Kim, Taeil and Lee, Jonghyun},
 doi = {10.1109/ISCIT.2014.7011946},
 journal = {14th International Symposium on Communications and Information Technologies, ISCIT 2014},
