@inproceedings{6049203,
 abstract = {This paper presents a segmentation method that exploits object based region merging to delineate the context of the image under investigation. There are two main steps. Initially, primitive objects are obtained by morphological operations that generate spectrally homogenous primitives. We assume that primitives are components of semantic objects that are of interest. Next, these primitives therefore are modeled and merged based on expectation maximization. We presented the results of the experiments applied to QuickBird images of rural and urban areas taken from the city of Ankara, Turkey. Experimental results demonstrate the capabilities of these methods along with their limitations.},
 author = {Aytekin, Örsan and Rezaeitabar, Yousef and Ulusoy, İlkay},
 booktitle = {2011 IEEE International Geoscience and Remote Sensing Symposium},
 doi = {10.1109/IGARSS.2011.6049203},
 issn = {2153-7003},
 keyword = {Image segmentation;Morphology;Clustering algorithms;Urban areas;Remote sensing;Image reconstruction;Cities and towns;Differential morphological profile (DMP);expectation maximization;segmentation},
 month = {July},
 number = {},
 pages = {613-616},
 title = {VHR image segmentation using over segmented regions in a MRF model},
 volume = {},
 year = {2011}
}
