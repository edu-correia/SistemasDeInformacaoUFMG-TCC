@article{Fazzinga20142561,
 abstract = {Data heterogeneity in XML retrieval activities can be tackled by giving users the possibility to obtain approximate answers to their queries. XPath query relaxation has been proposed as a mechanism to provide approximate answers in the case of positive XPath queries. Under this mechanism, the "satisfaction score" of an answer is defined by looking at how the query must be relaxed to produce that answer, and the user is provided with the best k answers according to their satisfaction score (top-k query answering). In this paper we investigate the problem of top-k query answering for XPath queries with negation. We tackle the challenging issues that need to be carefully considered when dealing with the approximation of negated conditions and propose an incremental top-k query answering technique based on query relaxation. Specifically, after defining a weighted query language and its semantics, we develop a general incremental query evaluation framework, which is flexible enough to support different evaluation strategies. The experimental assessment confirms the effectiveness of the whole framework. © 2013 IEEE. Personal use is permitted, but republication/redistribution requires IEEE permission.},
 author = {Fazzinga, Bettina and Flesca, Sergio and Pugliese, Andrea},
 doi = {10.1109/TKDE.2013.150},
 journal = {IEEE Transactions on Knowledge and Data Engineering},
 note = {Cited by: 1},
 number = {10},
 pages = {2561 - 2573},
 publication_stage = {Final},
 source = {Scopus},
 title = {Top-k approximate answers to XPath queries with negation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84922759004?origin=resultslist},
 volume = {26},
 year = {2014}
}
