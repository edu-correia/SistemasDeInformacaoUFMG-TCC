@article{4063359,
 abstract = {The compression efficiency of an indexed image depends on the palette ordering. However, obtaining an optimal palette ordering is not an easy task, and approximate solutions are usually sought in practice. Among the available methods, the pairwise merging technique proposed by Memon is the best in terms of compression efficiency. However, this method needs extensive computations. In this letter, a novel algorithm is presented to find an approximate solution of the palette reordering problem. Combined with Pinho's method, our approach is better than the pairwise merging technique in terms of compression efficiency and computing time},
 author = {Lai, Jim Z. C. and Liaw, Yi-Ching},
 doi = {10.1109/LSP.2006.882106},
 issn = {1558-2361},
 journal = {IEEE Signal Processing Letters},
 keyword = {Color;Image coding;Merging;Indexing;Computational complexity;Computer science;Entropy;Computational modeling;Simulated annealing;Pixel;Color palette;indexed image;lossless compression;palette reordering},
 month = {Feb},
 number = {2},
 pages = {117-120},
 title = {A Novel Approach of Reordering Color Palette for Indexed Image Compression},
 volume = {14},
 year = {2007}
}
