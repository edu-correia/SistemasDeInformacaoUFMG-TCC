@inproceedings{11086111,
 abstract = {Digital signal and image processing depends heavily on the addition operations for real-time tasks, since the performance of addition determines the system efficiency. This research analyzes the Brent-Kung parallel prefix adder, because of its three key features (logarithmic delay, low fan-out, and regular architecture), as the fundamental element for executing multi-source image fusion operations. The extended Brent-Kung adder with three- operand capability and added approximate logic in the least significant bits, delivers powerful power savings and smaller logic area together with accurate result performance in essential bit areas. The research objective focuses on building hybrid adder-based image fusion algorithms that enable real-time processing for three grayscale inputs merging precise hardware performance with efficient results. This particular approximate design serves applications with noncritical precision demands, therefore optimizing operation for embedded systems and low- power platforms. The system delivers an integration of key input features through reduced operational complexity which makes it perfectly suited for VLSI applications running in real-time such as surveillance systems and biomedical imaging and autonomous vision operations.},
 author = {D, Madhumitha and S, Dhanasekar and RS, Shivanandham and M, Sharmila Parveen and K, SriSanjana and JS, Roshaan},
 booktitle = {2025 Second International Conference on Cognitive Robotics and Intelligent Systems (ICC - ROBINS)},
 doi = {10.1109/ICC-ROBINS64345.2025.11086111},
 issn = {},
 keyword = {Surveillance;Very large scale integration;Gray-scale;Real-time systems;Hardware;Delays;Logic;Adders;Image fusion;Standards;Brent-Kung adder;approximate computing;parallel prefix adder;low power;DSP;image fusion;VLSI},
 month = {June},
 number = {},
 pages = {79-84},
 title = {Energy-Efficient Low-Power Three-Operand Approximate Brent-Kung Adder for VLSI-Based Image Processing},
 volume = {},
 year = {2025}
}
