@conference{Messaoud20191408,
 abstract = {The real time Aircraft Landing Problem (ALP) within an Air Traffic Control (ATC) system is typically a large scale problem. Since the modeling is a crucial step in solving the ALP, we are concerned in this research with modeling the landing procedure of aircrafts for single and multiple runway system. In this respect, we proposed a detailed Mixed Integer Programming (MIP) model where we treat respectively the scheduling and sequencing of aircraft landings from the Entry Fix (EF) of the Terminal Maneuvering Area (TMA) to the Final Approach Fix (FAF) of the air segment to the Runway Threshold (RT) of the runway, whilst taking account of their assignment to the runway(s). The model solution for the static case using an exact method is presented. Computational experiments show the benefits of the proposed approach compared to the ATC rule applied to the aircrafts; the First Come First Served (FCFS) discipline. © 2019 Copyright held by the owner/author(s).},
 author = {Messaoud, Meriem Ben and Ghedira, Khaled},
 doi = {10.1145/3297280.3297422},
 journal = {Proceedings of the ACM Symposium on Applied Computing},
 note = {Cited by: 1},
 pages = {1408 - 1415},
 publication_stage = {Final},
 source = {Scopus},
 title = {A solution for a detailed mathematical model for the aircraft landing problem on a single and multiple runway system},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85065638458?origin=resultslist},
 volume = {Part F147772},
 year = {2019}
}
