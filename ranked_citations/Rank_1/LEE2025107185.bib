@article{LEE2025107185,
 abstract = {This study investigated the effects of heat treatment temperature on the structural, mechanical, and functional properties of spin-coated MIL-53 films. MIL-53 powder was synthesized via a solvothermal method and characterized by scanning electron microscopy (SEM), X-ray diffraction (XRD), and Brunauer-Emmett-Teller (BET) analysis, confirming its micro-mesoporous hierarchical structure with a specific surface area of 209.63 m²/g. The powder was then dispersed in ethanol to prepare coating solutions and applied to the substrates using spin coating, followed by heat treatment at temperatures ranging from 150 to 650 °C. Characterization revealed that increasing the heat-treatment temperature led to significant changes in the surface morphology, with particles beginning to merge at temperatures above 450 °C, while the crystal structure remained relatively stable, as evidenced by the XRD results. FTIR analysis revealed the partial decomposition of organic linkers at temperatures above 450 °C, correlating with the observed changes in surface properties, including decreased roughness, increased hydrophilicity, and improved optical transmittance. Tribological analysis demonstrated that heat treatment at 250 °C provided optimal wear resistance, with higher temperatures resulting in increased brittleness and reduced fracture toughness, despite higher hardness. CO₂ adsorption-desorption isotherms confirmed the capacity of the heat-treated MIL-53 coatings to capture CO₂, exhibiting characteristic breathing effects and hysteresis. This analysis provides practical guidelines for optimizing the MIL-53 coating preparation for CO₂ capture applications.},
 author = {Sung-Jun Lee and Chang-Lae Kim},
 doi = {https://doi.org/10.1016/j.surfin.2025.107185},
 issn = {2468-0230},
 journal = {Surfaces and Interfaces},
 keyword = {MIL-53 coating, Heat treatment, Tribological properties, Surface wettability, CO₂ adsorption},
 pages = {107185},
 title = {Effect of heat treatment on structural and tribological behavior of MIL-53 coatings},
 url = {https://www.sciencedirect.com/science/article/pii/S2468023025014373},
 volume = {72},
 year = {2025}
}
