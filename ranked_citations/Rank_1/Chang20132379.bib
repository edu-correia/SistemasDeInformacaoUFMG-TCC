@article{Chang20132379,
 abstract = {In recent years, cloud computing technology has matured significantly, as has the development of digital TV services. This, therefore, has led to an increased demand for improved quality TV services. In: this paper, cloud computing technology is used to build a program recommendation system for digital TV programs, and the Hadoop Fair Scheduler is utilized to improve processing performance. Historical data of watched TV programs are collected through an electronic program guide, and then processed using K-means clustering, term frequency/inverse document frequency and k-nearest neighbor algorithms, to obtain clusters of audience groups and to find popular TV programs for each cluster. The proposed system can process massive amounts of user data in real-time, and can easily be scaled up. © 2013 Elsevier Ltd. All rights reserved.},
 author = {Chang, Jui-Hung and Lai, Chin-Feng and Wang, Ming-Shi and Wu, Tin-Yu},
 doi = {10.1016/j.compeleceng.2013.04.025},
 journal = {Computers and Electrical Engineering},
 note = {Cited by: 13},
 number = {7},
 pages = {2379 - 2399},
 publication_stage = {Final},
 source = {Scopus},
 title = {A cloud-based intelligent TV program recommendation system},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84885574873?origin=resultslist},
 volume = {39},
 year = {2013}
}
