@inproceedings{10851570,
 abstract = {Point cloud clustering is a crucial approach to understand and analyze geometric information for both robotic systems and autonomous driving. To meet real-time requirements, several existing point cloud clustering algorithms are based on Connected Component Labeling. It means that classification decisions are made locally based on the geometric relationships among neighboring points. However, the existing neighborhood connection criterion lack robustness. This is because the difference in resolution between point clouds in the horizontal and vertical directions and various depth affect the distance between adjacent points, thereby affecting connectivity determination. In this paper, we propose a novel clustering algorithm LTM (includes Linearization, Trunk extraction and Merge). It processes the horizontal and vertical directions separately in two steps and innovatively utilizes three points to determine neighborhood connectivity. Thus, it can reduce the impact of these constraints on the effectiveness. We cascade the proposed clustering algorithm with existing semantic segmentation models and perform a panoptic segmentation task on the SemanticKITTI. Experimental results demonstrate that LTM achieved the best results among all published methods of the same category. Furthermore, the single-frame processing time for clustering is within 10 milliseconds.},
 author = {Wu, Peng and Hu, Zhengxi and Zhang, Qianyi and Guang, Jinzheng and Liu, Jingtai},
 booktitle = {2024 9th International Conference on Robotics and Automation Engineering (ICRAE)},
 doi = {10.1109/ICRAE64368.2024.10851570},
 issn = {},
 keyword = {Point cloud compression;Location awareness;Laser radar;Service robots;Semantic segmentation;Clustering algorithms;Vectors;Robustness;Real-time systems;Labeling;LiDAR Panoptic Segmentation;Point Cloud Clustering;Connected Component Labeling},
 month = {Nov},
 number = {},
 pages = {169-174},
 title = {LTM: A Fast and Error-sensitive Point Cloud Clustering Algorithm for LiDAR Panoptic Segmentation},
 volume = {},
