@article{11268448,
 abstract = {Remote sensing image (RSI) super resolution (SR) is crucial for enhancing geospatial recognition accuracy, yet the existing methods based on deep learning (DL) present significant bottlenecks, such as low computational efficiency, insufficient preservation for local details, and global semantics. To address these challenges, we propose a novel CSMNet framework, which pioneers the integration of Mamba and implicit neural representation (INR) within UNet. We model long range dependencies of spatial and channel information based on the visual state space (VSS) model. In order to promote multiscale feature interaction and preservation, we propose a fusion strategy to merge the upsampled features from bottom to top. Experiments on UCMerced and AID datasets demonstrate that our method averagely achieves prominent PSNR(dB)/SSIM values of 30.81/0.8535 and 33.30/0.8666 and 40.2% inference speed increasement than recent continuous SR methods.},
 author = {Liu, Yuning and Ma, Yongtao and Li, Weiming and Guo, Shiliang},
 doi = {10.1109/LGRS.2025.3637136},
 issn = {1558-0571},
 journal = {IEEE Geoscience and Remote Sensing Letters},
 keyword = {Decoding;Superresolution;Visualization;Sensors;LoRa;Convolution;Computational modeling;Codes;Remote sensing;Logic gates;Implicit neural representation (INR);remote sensing images (RSIs);super resolution (SR);visual state space (VSS)},
 month = {},
 number = {},
 pages = {1-5},
 title = {CSMNet: Channel-Spatial Mamba UNet for Continuous Remote Sensing Image Super Resolution},
 volume = {23},
 year = {2026}
}
