@article{YE2026114322,
 abstract = {Infrared Small Target Detection (IRSTD) has seen significant advancements in recent years, particularly with the application of convolutional neural networks (CNNs). However, existing techniques often face challenges in detecting distant small targets due to background complexity and noise, resulting in decreased detection performance. While some methods incorporate Transformers for global modeling, their quadratic computational complexity limits scalability. In contrast, the Mamba model offers efficient long-range dependency modeling with linear complexity, improving computational efficiency without compromising detection performance. Building on this, we propose the Mamba Residual Network (MRNet), which integrates CNN’s local feature extraction with the Mamba model’s long-range modeling capabilities for efficient small target detection. MRNet consists of two key modules: the Mamba Residual Interaction Module (MRIM) and the Attention Enhanced Module (AEM). MRIM enhances feature extraction progressively, improving the network’s ability to capture small targets while maintaining computational efficiency. With its hybrid attention mechanism, AEM reduces missed detections and false alarms in complex scenes. Additionally, we introduce a Center-Focused Strategy with an incentive and penalty mechanism, focusing the network on the target’s center to improve detection accuracy. Experimental results on the NUAA-SIRST, IRSTD-1 K, and NUDT-SIRST datasets demonstrate that MRNet outperforms existing IRSTD methods regarding detection performance, computational complexity, and inference time.},
 author = {Benzhang Ye and Guoxiang Tong and Quanquan Li},
 doi = {https://doi.org/10.1016/j.asoc.2025.114322},
 issn = {1568-4946},
 journal = {Applied Soft Computing},
 keyword = {Infrared small target detection, Deep learning, Vision Mamba, Loss function},
 pages = {114322},
 title = {Lightweight Mamba residual network integrating center-focused strategy for infrared small target detection},
 url = {https://www.sciencedirect.com/science/article/pii/S1568494625016357},
 volume = {187},
 year = {2026}
}
