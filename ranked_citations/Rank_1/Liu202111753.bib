@article{Liu202111753,
 abstract = {Spiking neural networks (SNNs) have the potential to closely mimic the information processing of biological brains, by using massive neurons that are interconnected in a complex network. Recent researches have considered using electronic hardware circuits to SNN implementations to meet real-time processing requirements. Network-on-Chips (NoCs) have been widely used to develop such SNN circuits as their interconnections can offer stable interconnectivity for neuron communications with high throughput and real-time execution. However, its scalability is limited due to expensive and complex NoC routers which leads to high energy consumption and large area utilization. Therefore, a minimally buffered deflection router (MBDR) is proposed in this work to address the scalability challenge of the hardware SNNs. It employs a deflection router technique to remove most of the inter-buffers and other expensive components of the conventional routers. Moreover, a novel flow controller is developed in MBDR to further reduce power consumption. Compared to existing approaches, experimental results show that based on 90-nm CMOS technology the area and power consumption of the proposed router are reduced by ~ 86% and ~ 88%, respectively. In the meantime, system throughput is maintained at a high level. © 2021, The Author(s), under exclusive licence to Springer-Verlag London Ltd., part of Springer Nature.},
 author = {Liu, Junxiu and Jiang, Dong and Luo, Yuling and Qiu, Senhui and Huang, Yongchuang},
 doi = {10.1007/s00521-021-05817-x},
 journal = {Neural Computing and Applications},
 note = {Cited by: 5},
 number = {18},
 pages = {11753 - 11764},
 publication_stage = {Final},
 source = {Scopus},
 title = {Minimally buffered deflection router for spiking neural network hardware implementations},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85102901393?origin=resultslist},
