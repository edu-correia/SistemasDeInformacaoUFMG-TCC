@conference{Fuertes2018203,
 abstract = {It is presented the methodology to place properly height antennas over the surface of a storage cellar, in a link of electromagnetic waves between an identification radio frequency antenna (RFID) and a Passive label starting from a radioelectric profile. It is described the effect of different external dimensions and distributions of the internal space over the signs of radio frequency; the parameters used and the analyzes of the system are adjusted to a dynamic real model of transmission. The main objective of this study is to determine the sturdiness of a genetic algorithm using a simple model of communication which finds the suitable position of the antenna and allows the needed polarization for the identification of all the passive RFID labels, using as measure the minimum power received by the RFID. Through a location model and with the help of a genetic algorithm (GA), it is searched the proper position of the antennas that allows the need polarization for the identification of all the labels, using as a measure the minimum power received by the RFID antenna. © 2018 IEEE.},
 author = {Fuertes, Guillermo and Alfaro, Miguel and Soto, Ismael and Carrasco, Raúl and Iturralde, Daniel and Lagos, Carolina},
 doi = {10.1109/ICCCC.2018.8390459},
 journal = {2018 7th International Conference on Computers Communications and Control, ICCCC 2018 - Proceedings},
 note = {Cited by: 8},
 pages = {203 - 209},
 publication_stage = {Final},
 source = {Scopus},
 title = {Optimization model for location of RFID antennas in a supply chain},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85050165105?origin=resultslist},
 year = {2018}
}
