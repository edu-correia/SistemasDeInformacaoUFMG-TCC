@article{PARRA2024851,
 abstract = {In this issue of Structure, Oot and Wilkens1 present new mechanistic insights to finally merge the function of V-ATPase and TLDc domain proteins. They show that TLDc proteins directly affect V-ATPase activity and assembly, expanding our understanding of how V-ATPase and TLDc proteins exert a plethora of biological functions.},
 author = {Karlett J. Parra},
 doi = {https://doi.org/10.1016/j.str.2024.06.008},
 issn = {0969-2126},
 journal = {Structure},
 number = {7},
 pages = {851-853},
 title = {The merger of two major families of proteins that regulate cellular processes},
 url = {https://www.sciencedirect.com/science/article/pii/S0969212624002260},
 volume = {32},
 year = {2024}
}
