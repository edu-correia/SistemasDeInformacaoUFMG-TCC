@inproceedings{4709400,
 abstract = {The data structure course is a core foundation stone in a computer science curriculum. There are many complicated algorithms in it. In order to help students to master these algorithms, the dynamic demo system with C++/MFC is developed in this paper. These complicated algorithms could be performed step by step. The output and variables in the algorithms can be observed based on these algorithms at the same time. It is a very intuitive studying method for data structure course.},
 author = {Liu, Zhi and Lu, Jian and Dai, Xiaochun},
