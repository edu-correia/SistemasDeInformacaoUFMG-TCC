@conference{Liu2023306,
 abstract = {Multi-focus image fusion is a technique used to merge two or more images with different focus regions into a single all-focus image. Previous MFIF methods have suffered from high fusion times and suboptimal fused image quality. In this study, we introduce a novel approach employing a multi-scale attention U-shaped network. The encoder conducts multi-scale feature extraction, while the decoder integrates and merges diverse levels of semantic information using channel and spatial attention mechanisms to produce a comprehensive all-focus image. Extensive subjective and objective experiments demonstrate the superiority of the proposed multi-focus image fusion algorithm over existing state-of-the-art methods. Furthermore, our approach significantly reduces fusion time. The experimental results reveal the superiority of the proposed method in both subjective visual quality and objective quantitative evaluation when compared to other existing fusion techniques. © 2023 ACM.},
 author = {Liu, Deyu and Ma, Changhao},
 doi = {10.1145/3652628.3652679},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 0},
 pages = {306 - 311},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi-focus image fusion method based on U-net and multi-scale pyramid attention mechanism},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85194853657?origin=resultslist},
 year = {2023}
}
