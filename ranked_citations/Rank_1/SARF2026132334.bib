@article{SARF2026132334,
 abstract = {Cobalt oxide–based materials are widely employed in energy storage, sensing, and dielectric applications due to their versatile structural and surface properties. In this study, an ultra-thick Co3O4 film was grown on In2O3:Sn (ITO) substrates via chemical bath deposition and subsequently annealed at 400 °C. The structural characteristics, surface morphology, and clustering behavior of the film were systematically investigated using XRD, AFM, and FE-SEM techniques. XRD analysis confirmed the formation of cubic Co3O4 alongside secondary cobalt oxide and hydroxide phases, while multiple analytical models were employed to assess crystallite size and internal strain. AFM observations revealed annealing-induced surface reorganization, where smaller clusters exhibited higher mobility and merged into larger, more stable agglomerates. SEM-based multi-scale analysis demonstrated a heterogeneous surface morphology composed of interacting and non-interacting cluster groups. Fractal and scaling analyses were applied to elucidate the surface cluster organization, indicating a complex hetero-morphological structure governed by Boltzmann-type statistical behavior. These findings provide important insights into the relationship between surface complexity and structural evolution in Co3O4 films, offering a useful framework for optimizing their performance in electronic and electrochemical applications.},
 author = {Fatma Sarf and Emin Yakar and Mehmet Bayırlı and Aykut Ilgaz},
 doi = {https://doi.org/10.1016/j.matchemphys.2026.132334},
 issn = {0254-0584},
 journal = {Materials Chemistry and Physics},
 keyword = {Cobalt oxide, Scaling theory, Structural analysis, Cluster structure, Fractal dimension},
 pages = {132334},
 title = {Structural evolution and scaling behavior of chemically deposited Co3O4 films},
 url = {https://www.sciencedirect.com/science/article/pii/S0254058426003251},
 volume = {356},
 year = {2026}
}
