@inproceedings{6620089,
 abstract = {Natural disaster management duo to its dynamic and evolving environment requires efficient knowledge management. Semantic ontology mapping is the focus of this research to address proper information management in such a catastrophic real world's problem. This paper considers several techniques and methodologies in semantic ontology mapping to find out the effective and appropriate method. For this reason, various techniques evaluated. Finally, based on the discussions and assessment, we conclude our work in this work by choosing GLUE as the most accurate and more precise solution.},
