@article{QEZELBASHCHAMAK2026132672,
 abstract = {This study presents a novel deep learning architecture named KANCaps that integrates Capsule Networks’ part–whole representation with spline-based Kolmogorov–Arnold Networks (KANs). By modeling each capsule-to-capsule transform as a univariate spline, KANCaps captures local nonlinearities both dimension-wise and cross-dimensionally, offering a more expressive yet interpretable mechanism for feature composition. We thoroughly evaluate KANCaps on three benchmark datasets—chest X-rays, brain MRIs, and CIFAR-10—and demonstrate that it consistently outperforms standard CapsNet as well as state-of-the-art architectures (e.g., ResNet, DenseNet, Vision Transformers) in terms of classification accuracy, precision, sensitivity, F1 score, and area under the ROC curve. Our ablation studies confirm that gating residuals and cross-dimensional summation significantly boost performance and stability, underscoring the synergy between spline-based transformations and capsule-based routing. These findings suggest that KANCaps is well-suited for medical image analysis and broader computer vision tasks where robust pose-awareness and data efficiency are essential.},
 author = {Jaber Qezelbash-Chamak and Karen Hicklin},
 doi = {https://doi.org/10.1016/j.neucom.2026.132672},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {Machine learning, Deep learning, Capsule networks, Kolmogorov-Arnold networks, Biomedical informatics},
 pages = {132672},
 title = {Spline-gated capsule networks with cross-dimensional transformations for nonlinear pose-aware recognition},
 url = {https://www.sciencedirect.com/science/article/pii/S092523122600069X},
 volume = {671},
 year = {2026}
}
