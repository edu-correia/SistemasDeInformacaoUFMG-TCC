@conference{Linhai20062923,
 abstract = {Spectral distortion in fused multispectral (MS) images is the main obstacle for the applications of the latter. At lower and higher-resolutions, a pixel usually has different digital numbers (DN) in MS images. This difference can be denoted as an B-D spectra change trend vector (SCT) of the coarse pixel previously expanded to match the pixel size of a panchromatic (PAN) band. Essentially, the unknown SCT of each coarse pixel is the implicit target of most current image fusion methods based on multiresolution analysis. For a coarse pixel, its SCT may be estimated from the pixel itself and the corresponding PAN pixel together. The estimated SCT determines how many PAN spatial details will be injected to the coarse pixel to synthesize a fused pixel. The better the estimate is, the less the spectra distortion in the resultant fused pixel is. Tested on a degraded IKONOS dataset and compared to some art-the-latest image fusion methods, the method proposed in this paper can considerably improve the spectra accuracy of the synthetic products.},
 author = {Linhai, Jing and Qiuming, Cheng},
 doi = {10.1109/IGARSS.2006.751},
 journal = {International Geoscience and Remote Sensing Symposium (IGARSS)},
 note = {Cited by: 2},
 pages = {2923 - 2926},
 publication_stage = {Final},
 source = {Scopus},
 title = {Image fusion based on pixel spectra change vector and multivariate regression of panchromatic and visible-near IR multispectral bands},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/34948859107?origin=resultslist},
 year = {2006}
}
