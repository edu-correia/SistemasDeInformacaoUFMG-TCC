@inproceedings{11135583,
 abstract = {The paper explores the application of Convolutional Neural Networks (CNNs) and Transformer models individually and hybrid to the application of weed detection in rice lands. The alternated structure that is proposed employs CNNs for feature maps and relies on the use of Transformer models in order to manage long-range relationships within the data. The hybrid model is evaluated on the publicly available dataset and accomplishes approximately 97% accuracy in classifying images of weeds and non-weeds. In comparison to traditional unidimensional classification models, the hybrid model outperforms them in all aspects. In addition, the section provides other comprehensive reports inclusive of a confusion matrix and classification reports that validate the claims of this model in practice.},
 author = {Krishnan, Sreedeep and Karuppasamypandiyan, M and Manoj, Ashvin},
 booktitle = {2025 4th International Conference on Advances in Computing, Communication, Embedded and Secure Systems (ACCESS)},
 doi = {10.1109/ACCESS65134.2025.11135583},
 issn = {},
 keyword = {Precision agriculture;Accuracy;Computational modeling;Merging;Pest control;Transformers;Feature extraction;Real-time systems;Computational efficiency;Convolutional neural networks;Precision Agriculture;Food Security;Weed Detection;Farmers;Pest Control},
 month = {June},
 number = {},
 pages = {1-7},
 title = {A Hybrid Transformer Model Approach for Precision Weed Detection},
 volume = {},
 year = {2025}
}
