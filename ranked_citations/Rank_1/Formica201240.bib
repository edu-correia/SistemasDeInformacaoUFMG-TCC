@article{Formica201240,
 abstract = {Fuzzy Formal Concept Analysis (FFCA) is a generalization of Formal Concept Analysis (FCA) for modeling uncertainty information. FFCA provides a mathematical framework which can support the construction of formal ontologies in the presence of uncertainty data for the development of the Semantic Web. In this paper, we show how rough set theory can be employed in combination with FFCA to perform Semantic Web search and discovery of information in the Web. © 2011 Elsevier B.V. All rights reserved.},
 author = {Formica, Anna},
 doi = {10.1016/j.knosys.2011.06.018},
 journal = {Knowledge-Based Systems},
 note = {Cited by: 91},
 pages = {40 - 47},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic Web search based on rough sets and fuzzy formal concept analysis},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84155181085?origin=resultslist},
 volume = {26},
 year = {2012}
}
