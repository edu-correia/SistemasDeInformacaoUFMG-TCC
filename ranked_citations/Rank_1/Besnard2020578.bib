@conference{Besnard2020578,
 abstract = {To design embedded systems, multiple models of their environments are typically required for different purposes such as simulation, verification, and actual execution. Some of these models abstract the actual physical environment to facilitate Verification and Validation (V&V) activities. Others capture the connection to hardware peripherals, necessary to deploy the systems on actual embedded boards. However, mapping a system to different environment models for different purposes remains a complex task for two main reasons. First, the environment is often tightly coupled with the system, and the board used for its execution. Second, formal properties verified during the design phase must be preserved at runtime. To tackle these issues, we propose an approach for designing UML models in a modular way and deploying them for V&V activities or embedded execution. This approach uses UML modularity mechanisms to specify the system in a generic way, and to connect it to a given (abstract or real) environment. This technique has been applied on several UML models of embedded systems to analyze their behaviors by simulation and LTL model-checking before deploying them on embedded STM32 boards.  © 2020 ACM.},
 author = {Besnard, Valentin and Jouault, Frédéric and Brun, Matthias and Teodorov, Ciprian and Dhaussy, Philippe and Delatour, Jérôme},
 doi = {10.1145/3417990.3419227},
 journal = {Proceedings - 23rd ACM/IEEE International Conference on Model Driven Engineering Languages and Systems, MODELS-C 2020 - Companion Proceedings},
 note = {Cited by: 3},
 pages = {578 - 587},
 publication_stage = {Final},
 source = {Scopus},
 title = {Modular deployment of UML models for V&V activities and embedded execution},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85096753907?origin=resultslist},
 year = {2020}
}
