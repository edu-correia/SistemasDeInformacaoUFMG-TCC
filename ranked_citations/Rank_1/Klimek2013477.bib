@conference{Klimek2013477,
 abstract = {Several basic techniques are known for QR Code detection in digital images. This paper presents an approach that utilizes a special line parameterization, along with a variant of the Hough-transform, called PClines. The premised parameterization uses a parallel coordinate system, which allows faster accumulation than the slope-intercept method used by the basic Hough-transform, due to simpler computation. The presented technique can be easily adapted to any kind of matrix code. Mathematical and algorithmic foundations of this approach are presented, along with an implementation on Microsoft's.NET framework. Test results are also presented, emphasizing the effect of different parameters on the overall detection rate. These results are then compared to other implementations using the same PClines technique. © 2013 IEEE.},
 author = {Klimek, Gabriel and Vamossy, Zoltan},
 doi = {10.1109/CINTI.2013.6705244},
 journal = {CINTI 2013 - 14th IEEE International Symposium on Computational Intelligence and Informatics, Proceedings},
 note = {Cited by: 22},
 pages = {477 - 481},
 publication_stage = {Final},
 source = {Scopus},
 title = {QR Code detection using parallel lines},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84893814169?origin=resultslist},
 year = {2013}
}
