@inproceedings{11139672,
 abstract = {The increasing size and complexity of geospatial datasets present significant challenges in processing, storage, and analysis. Managing these datasets efficiently requires advanced techniques to partition them into smaller, manageable subsets while maintaining geometric and topological accuracy. This study addresses the critical issue of segmenting large-scale geospatial shapefiles by introducing a robust framework for grid-based partitioning. By systematically dividing the parent shapefile into child shapefiles constrained by a predefined number of polygons (N) and vertices, the proposed methodology ensures both scalability and usability. This paper first explores the complexities associated with geospatial shapefile segmentation, emphasizing the need for precise control over polygonal subdivisions. The solution involves a grid-based segmentation strategy combined with aggregation and residual management to meet user-defined constraints. Implemented using Python and GeoPandas, the framework demonstrates efficiency, adaptability, and accuracy, providing a practical solution for large-scale geospatial data handling. The proposed framework holds significant relevance in energy, power, and environmental domains by enabling precise mapping and analysis of critical datasets. Applications include optimizing renewable energy siting through spatial assessments, managing energy transmission networks by segmenting infrastructure data, and conducting environmental impact assessments through detailed spatial analysis. This capability to handle and analyze large geospatial datasets is crucial for sustainable planning, resource management, and policy development in these sectors.},
 author = {Basak, Aakashneel and PV, Jayasri and Ryali HSV, Usha Sundari and Krishnan S, Murali},
 booktitle = {2025 7th International Conference on Energy, Power and Environment (ICEPE)},
 doi = {10.1109/ICEPE65965.2025.11139672},
 issn = {2832-8973},
 keyword = {Renewable energy sources;Accuracy;Scalability;Merging;Spatial databases;Geospatial analysis;Planning;Partitioning algorithms;Complexity theory;Usability;Grid-based segmentation;geospatial shapefiles;polygon partitioning;geospatial data processing},
 month = {May},
 number = {},
 pages = {1-5},
 title = {Algorithmic Approach for Grid-Based Segmentation of Large-Scale Geospatial Shapefiles: Enhancing Energy and Environmental Analytics},
 volume = {},
 year = {2025}
}
