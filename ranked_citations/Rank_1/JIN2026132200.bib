@article{JIN2026132200,
 abstract = {Hierarchical clustering is a fundamental technique in data analysis, yet traditional algorithms often rely on pairwise merging, resulting in inefficient hierarchical structure formation, and the calculation of pairwise distances is often computationally intensive. In this paper, we propose a novel approach based on the concept of granular balls, introducing two algorithms: Fixed Increment Granular Ball Hierarchical Clustering (FI-GBHC) and Percentile-based Granular Ball Hierarchical Clustering (PB-GBHC). FI-GBHC uses a fixed-radius increment to expand granular balls, allowing the clustering process to complete within a constant number of iterations while building a hierarchical structure through granular ball merging. Building on this foundation, PB-GBHC employs a percentile-based strategy for radius adjustment, enabling adaptive radius increments that respond to the spatial distribution of granular balls, thereby enhancing merging efficiency. Experimental results on both synthetic and real-world datasets demonstrate that our methods outperform other baseline algorithms in computational speed while maintaining high clustering accuracy.},
 author = {Taiyu Jin and Xu Sun and Bing Huang and Tianxing Wang},
 doi = {https://doi.org/10.1016/j.neucom.2025.132200},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {Clustering algorithms, Granular ball, Granular computing, Hierarchical clustering},
 pages = {132200},
 title = {A novel hierarchical clustering approach based on granular-ball computing},
 url = {https://www.sciencedirect.com/science/article/pii/S0925231225028723},
 volume = {665},
 year = {2026}
}
