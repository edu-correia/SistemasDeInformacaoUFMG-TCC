@inproceedings{9693549,
 abstract = {An algorithm of image encryption based on hyper-chaotic system and neuron mechanism as well as encryption sequence encoding of image high and low bit plane diffusion and zigzag scrambling fusion is proposed. First, the plaintext image is divided into eight-bit planes, and then the high and low four-bit planes are randomly exchanged and merged to obtain a diffusion image. The diffusion image is encrypted and encoded using the neuron mechanism, and then the Zigzag scrambling operation is performed. Perform further forward and backward diffusion operations on the scrambled image to get the ciphertext image. The analysis of the experimental results can prove that the encryption algorithm of this paper has a large key space, strong anti-attack ability, and excellent cryptographic performance.},
 author = {Hui, Yuanyuan and Liu, Han and Fang, Pengfei},
 booktitle = {2021 CAA Symposium on Fault Detection, Supervision, and Safety for Technical Processes (SAFEPROCESS)},
 doi = {10.1109/SAFEPROCESS52771.2021.9693549},
 issn = {},
 keyword = {Image coding;Correlation;Fault detection;Neurons;Information security;Resists;Encryption;hyper-chaotic system;image encryption;neuron mechanism;bit manipulation},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {Neuron perceptron-driven image encryption incorporating hyper-chaotic system},
 volume = {},
 year = {2021}
}
