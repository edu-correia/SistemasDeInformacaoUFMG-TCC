@article{Yuan2019915,
 abstract = {Traffic flow downstream of the congestion is generally lower than the pre-queue capacity. This phenomenon is called the capacity drop. Recent empirical observations show a positive relationship between the speed in congestion and the queue discharge rate. Literature indicates that variations in driver behaviors can account for the capacity drop. However, to the best of authors' knowledge, there is no solid understanding of what and how this variation in driver behaviors lead to the capacity drop, especially without lane changing. Hence, this paper fills this gap. We incorporate the empirically observed desired acceleration stochasticity into a car-following model. The extended parsimonious car-following model shows different capacity drop magnitudes in different traffic situations, consistent with empirical observations. All results indicate that the stochasticity of desired accelerations is a significant reason for the capacity drop. The new insights can be used to develop and test new measures in traffic control. © 2018, © 2018 The Author(s). Published by Informa UK Limited, trading as Taylor & Francis Group.},
 author = {Yuan, K. and Laval, Jorge and Knoop, Victor L. and Jiang, Rui and Hoogendoorn, Serge P.},
 doi = {10.1080/21680566.2018.1518169},
 journal = {Transportmetrica B},
 note = {Cited by: 42; All Open Access; Hybrid Gold Open Access},
 number = {1},
 pages = {915 - 927},
 publication_stage = {Final},
 source = {Scopus},
 title = {A geometric Brownian motion car-following model: towards a better understanding of capacity drop},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85053507715?origin=resultslist},
 volume = {7},
 year = {2019}
}
