@article{LEPINE2021_373,
 abstract = {Abstract IVIA is a joint initiative of at least 8 Latin-American countries plus Portugal and Spain to make good use of large telecommunications antennas that are out of service in these countries, because most international communications are now using submarine cables. The first step will be to refurbish the antennas and then to start doing single dish observations of radiosources. In a second step the antennas will be equipped with VLBI (Very Long Base Interferometry) equipment, to establish a VLBI network. This project will be able to effectively promote scientific integration in Ibero-America. The work is starting in several countries; here we present several scientific cases for the use of the antennas, and we report on the first Brasilian activities.},
 author = {LEPINE, JACQUES R.D. and RAULIN, JEAN PIERRE and DOMINICI, TANIA and CASTRO, CARLOS GUILLERMO G. DE and ROIG, FERNANDO VIRGILIO and WIERMANN, ANDRÉ and FERNANDES, MARCELO BORGES and HADANO, YASUCHI and CORRERA, FATIMA SALETE and BECCARO, WESLEY and LUQUEZE, MARCOS AURELIO and VERRI, ANTONIO SANDRO and ZANELLA, DANILO CESAR and MENÉNDEZ-DELMESTRE, KARIN and GONÇALVES, THIAGO SIGNORINI and ALMEIDA, ULISSES BARRES DE and FIGUEREDO, MILITÃO VIEIRA},
 doi = {10.1590/0001-3765202120201697},
 number = {suppl 1},
 pages = {e20201697--e20201697},
 title = {IVIA - Ibero-American VLBI Initiative -Progress on the Brazilian side},
 volume = {93},
 year = {2021}
}
