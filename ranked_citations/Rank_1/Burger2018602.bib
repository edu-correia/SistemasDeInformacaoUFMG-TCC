@conference{Burger2018602,
 abstract = {This paper considers the problem of cooperative trajectory planning for multiple, communicating, automated vehicles in general non-hazardous on-road scenarios. Cooperative behavior is introduced by optimizing a collective cost function for all automated vehicles. A novel approach based a Mixed-Integer Quadratic Programming is presented that guarantees to yield the globally optimal solution. Numerical experiments are provided to demonstrate the feasibility of our approach and the benefits compared to priority-based approaches and non-cooperative individual motion planning. © 2018 IEEE.},
 author = {Burger, Christoph and Lauer, Martin},
 doi = {10.1109/ITSC.2018.8569776},
 journal = {IEEE Conference on Intelligent Transportation Systems, Proceedings, ITSC},
 note = {Cited by: 50},
 pages = {602 - 607},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cooperative Multiple Vehicle Trajectory Planning using MIQP},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85060477343?origin=resultslist},
 volume = {2018-November},
 year = {2018}
}
