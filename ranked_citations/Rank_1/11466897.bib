@inproceedings{11466897,
 abstract = {Automatic sentence alignment plays an essential role in building parallel corpus and supporting empirical research in translation studies. The traditional alignment methods like Hunalign rely on sentence-length and dictionaries which perform well in normative texts. Recent embedding-based approaches like Vecalign show greater robustness and reliability in handling linguistically complex scenarios. The researcher compared the performance of the two aligners on two types of English-Chinese corpora: technical manual (e.g., a pressure gauge instruction) and an excerpt of The Old Man and the Sea. In result, by judging evaluation metrics, the researcher found that the performance of the two aligners was closely parallel in case of technical text. However, Hunalign's performance dropped obviously due to difficulties in handling sentence splitting, merging and paraphrasing in literal text. In contrast, Vecalign remained reliable in accuracy, showing its robustness in capturing semantic correspondence across more complex translation patterns. These findings indicate that while traditional alignment methods are sufficient for normative texts, advanced embedding-based approaches show advantages over traditional aligners for literal texts. The study provides empirical evidence for the choice of alignment tools in translation practices and studies and also demonstrates the potentials of the application of natural language processing (NLP) in real-world translation scenarios.},
 author = {Zhang, Qiantao},
 booktitle = {2025 9th International Conference on Electrical, Mechanical and Computer Engineering (ICEMCE)},
 doi = {10.1109/ICEMCE68156.2025.11466897},
