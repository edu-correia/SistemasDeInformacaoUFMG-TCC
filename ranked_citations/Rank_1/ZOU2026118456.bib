@article{ZOU2026118456,
 abstract = {On the basis of our previous work, a novel series of CA-4 derivatives as tubulin/HDAC6 dual-target inhibitors were discovered by merging hydroxamic acid or benzamide group into the olefin moiety. Among them, compound 9q exhibited satisfactory antiproliferative effects on both hematological malignancies and solid tumor cells with IC50 values ranging from 0.52 to 5.10 μM. The mechanism study revealed that 9q not only repressed tubulin polymerization, disrupted cellular microtubule networks but also inhibited HDAC6. Meanwhile, 9q could induce G2/M phase arrest, and caused cell apoptosis with a concentration-dependent manner, and also remarkably inhibited migration in HeLa cells. Most importantly, 9q effectively inhibited tumor growth in the HCT116 xenograft model without apparent toxicity. These findings indicate that 9q could be a potential lead compound for further development as an antitumor agent.},
 author = {Zhongkai Zou and Tangyang Ji and Yanting Zhang and Jianfan Cai and Yukang Lin and Bei Zhang and Peiliang Zhao},
 doi = {https://doi.org/10.1016/j.ejmech.2025.118456},
 issn = {0223-5234},
 journal = {European Journal of Medicinal Chemistry},
 keyword = {Tubulin, HDAC6, Antiproliferative activity, Structure-activity relationship},
 pages = {118456},
 title = {Design, synthesis and bioevaluation of novel combretastatin A-4 based derivatives as potent tubulin/HDAC6 dual-target inhibitors for cancer therapy},
 url = {https://www.sciencedirect.com/science/article/pii/S0223523425012218},
 volume = {303},
 year = {2026}
}
