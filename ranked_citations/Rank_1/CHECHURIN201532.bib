@article{CHECHURIN201532,
 abstract = {New idea generation is imperative for successful product innovation and technology development. This paper presents the development of a novel type of invention support software. The support tool integrates both function modeling and mathematical modeling, thereby enabling quantitative analyses on a relative high level of abstraction. The function and math-based models are derived from a CAD model in an automated manner to streamline the invention process. This allows innovators to perform multidisciplinary conceptual design studies more efficiently and effectively. The use of the software tool is demonstrated in two separate case studies, namely the dynamic function analysis of (1) a chemical reactor cooling system and (2) a remote controlled car for further redesign.},
 author = {Leonid S. Chechurin and Wessel W. Wits and Hans M. Bakker},
 doi = {https://doi.org/10.1016/j.cherd.2015.07.013},
 issn = {0263-8762},
 journal = {Chemical Engineering Research and Design},
 keyword = {Inventive design, Function analysis, TRIZ, Automated design},
 note = {Inventive Design and Systematic Engineering Creativity},
 pages = {32-39},
 title = {Invention software support by integrating function and mathematical modeling},
 url = {https://www.sciencedirect.com/science/article/pii/S0263876215002580},
 volume = {103},
 year = {2015}
}
