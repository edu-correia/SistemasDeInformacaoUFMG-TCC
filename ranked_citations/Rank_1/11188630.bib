@inproceedings{11188630,
 abstract = {As communication technologies advance, higher demands are placed on antenna performance. Dual - polarized antenna arrays boost spectrum utilization, yet element mutual coupling hampers performance. This paper presents a broadband decoupling solution merging neutralization line decoupling with the composite frequency selective surface structure. The former counteracts coupling current, and the latter blocks coupling signal propagation. After simulation based optimization, each antenna port achieves less than -30 dB isolation in a wide band with little impact on gain, supporting broadband communication applications.},
 author = {Ruan, Huiping and Yang, Haoran and Chen, Mengdie and Zhai, Huiqing and Wang, Nan},
 booktitle = {2025 International Conference on Microwave and Millimeter Wave Technology (ICMMT)},
 doi = {10.1109/ICMMT65948.2025.11188630},
 issn = {2994-3124},
 keyword = {Frequency selective surfaces;Couplings;Mutual coupling;Technological innovation;Software;Microwave antenna arrays;Broadband communication;Broadband antennas;Optimization;Gain;Frequency Selective Surface;Dual-Polarized;Neu tralization line;Antenna Array},
 month = {May},
 number = {},
 pages = {1-3},
 title = {A Broadband Decoupling Structure Based on Dual-Polarized Antenna Arrays},
 volume = {},
 year = {2025}
}
