@article{10.5555/2544322.2544327,
 abstract = {Public Health Informatics has been identified as one of the four domains of the National Health Information Infrastructure by the U.S. Department of Health and Human Services. Proposed is the design of a professional curriculum in Public Health Informatics leading to the professionally accredited Master of Public Health (M.P.H.) degree. The relevant literature is reviewed and discussed. The educational goals and objectives for the proposed Public Health Informatics curriculum are specified. The course of study is then outlined, with each of the educational goals and objectives tied to specific coursework. Directions for future efforts to implement advanced education and training opportunities in the proposed Public Health Informatics curriculum are presented.},
 address = {Evansville, IN, USA},
 author = {Berkowitz, Murray R.},
 issn = {1937-4771},
 issue_date = {January 2014},
 journal = {J. Comput. Sci. Coll.},
 month = {January},
 number = {3},
 numpages = {8},
 pages = {13–20},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Design of a public health informatics curriculum},
 volume = {29},
 year = {2014}
}
