@article{Zhang2022499,
 abstract = {Multi-focus image fusion aims to generate a clear image by fusing multiple source images. Existing deep learning-based fusion methods often neglect the context information resulting in the loss of detail information. To address this issue, a context fusion network to merge multi-focus images, namely CFNet, is proposed. Specifically, a context fusion module is proposed to make full use of low-level pixels and high-level semantic features. Particularly, the pyramid fusion mechanism and cross-scale transfer strategy are adopted to ensure the visual and semantic consistency of the fused image. Meanwhile, to extract salient features more effectively, a spatial attention mechanism is introduced to enhance these features. Further, the pyramid loss is used to progressively refine the fused features at each scale. Experimental results show that the proposed method is superior to some existing methods in both qualitative and quantitative evaluation. © 2021 The Authors. IET Image Processing published by John Wiley & Sons Ltd on behalf of The Institution of Engineering and Technology},
 author = {Zhang, Kang and Wu, Zhiliang and Yuan, Xia and Zhao, Chunxia},
 doi = {10.1049/ipr2.12363},
 journal = {IET Image Processing},
 note = {Cited by: 11; All Open Access; Gold Open Access; Green Open Access},
 number = {2},
 pages = {499 - 508},
 publication_stage = {Final},
 source = {Scopus},
 title = {CFNet: Context fusion network for multi-focus images},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85119185319?origin=resultslist},
 volume = {16},
