@inproceedings{9748730,
 abstract = {Next generation 3D VNAND Flash memory device with 176 Word-line (WL) layer has been successfully built. The Cell-Over-Peripheral (COP) architecture was used, which reduced tR (Read Latency) by 11% and tPROG (Program Latency) by 20%, respectively. The bit density has been enhanced by 70% over our previous device (6th generation) thanks to cell volume scaling and COP architecture. To create this new device, double stack process was successfully merged for higher bit density. In addition, the channel hole profile was greatly improved using the double stack method. As a result, compared to our earlier product, we were able to attain superior cell operation characteristics. The technology used in the 7th generation 3D VNAND device, as well as our ongoing efforts to expand it to QLC devices and their results will be discussed in this paper.},
 author = {Lim, Joonsung and Chung, Soochan and Ko, Dong-Hyeon and Sung, Suk-Kang and Noh, Kyungyoon and Ahn, Su Jin and Song, Jai Hyuk},
 booktitle = {2022 International Conference on Electronics, Information, and Communication (ICEIC)},
 doi = {10.1109/ICEIC54506.2022.9748730},
 issn = {2767-7699},
 keyword = {Three-dimensional displays;Microprocessors;Computer architecture;Flash memories;Optimization;Next generation networking;Consumer electronics},
 month = {Feb},
 number = {},
 pages = {1-4},
 title = {Development of 7th generation 3D VNAND Flash Product with COP structure for Growing Demand in Storage Market},
 volume = {},
 year = {2022}
}
