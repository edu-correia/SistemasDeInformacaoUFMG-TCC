 journal = {Diagnostic Microbiology and Infectious Disease},
 keyword = {Artificial intelligence, Clinical laboratories, Diagnostics, Machine learning, Biochemistry, Patient care},
 number = {4},
 pages = {116728},
 title = {Revolutionizing clinical laboratories: The impact of artificial intelligence in diagnostics and patient care},
