@article{Ravi2026,
 abstract = {We consider the problem of communicating over a channel that breaks the message block into fragments of random lengths, shuffles them out of order, and deletes a random fraction of the fragments. Such a channel is motivated by applications in molecular data storage and forensics, and we refer to it as the torn-paper channel. We characterize the capacity of this channel under arbitrary i.i.d. fragment length distributions and deletion probabilities. Precisely, we show that the capacity is given by a closed-form expression that can be interpreted as F−A, where F is the coverage fraction, i.e., the fraction of the input codeword that is covered by output fragments, and A is an alignment cost incurred due to the lack of ordering in the output fragments. We then consider a noisy version of the problem, where the fragments are corrupted by binary symmetric noise. We derive upper and lower bounds to the capacity, both of which can be seen as F−A expressions. These bounds match for specific choices of fragment length distributions, and they are approximately tight in cases where there are not too many short fragments. © 1963-2012 IEEE.},
 author = {Ravi, Aditya Narayan and Vahid, Alireza and Shomorony, Ilan},
 doi = {10.1109/TIT.2026.3686745},
 journal = {IEEE Transactions on Information Theory},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Article in press},
 source = {Scopus},
 title = {Recovering a Message from an Incomplete Set of Noisy Fragments},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105037152892?origin=resultslist},
 year = {2026}
