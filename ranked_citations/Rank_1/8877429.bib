@inproceedings{8877429,
 abstract = {This paper introduces a new raw-audio, environmental, kitchen-related, non-vocal dataset to fill what we consider as a gap in the context of audio datasets. Our so-called Kitchen20 dataset is compared to other datasets such as ESC-50 and shown that both datasets can be merged together in what we call ESC-70. A human quantitative appreciation of the audio samples contained in Kitchen20 is provided as well as several machine learning benchmarks on both Kitchen20 and ESC-70.},
 author = {Moreaux, Marc and Ortiz, Michael Garcia and Ferrané, Isabelle and Lerasle, Frederic},
 booktitle = {2019 International Conference on Content-Based Multimedia Indexing (CBMI)},
 doi = {10.1109/CBMI.2019.8877429},
 issn = {1949-3991},
 keyword = {Robots;Optimization;Benchmark testing;Task analysis;Convolutional codes;Europe;Support vector machines},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Benchmark for Kitchen20, a daily life dataset for audio-based human action recognition},
 volume = {},
 year = {2019}
}
