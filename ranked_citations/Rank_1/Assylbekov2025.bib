@conference{Assylbekov2025,
 abstract = {Sparse matrix multiplication (SpMM) is a critical kernel used in a wide range of applications, but irregular memory access patterns and memory bandwidth bottleneck as well as load imbalance make the efficient and scalable processing on parallel architectures a significant challenge. Motivated by the memory-bound nature of SpMM computation, we propose a cost-effective SpMM accelerator based on a DRAM processing-in-memory (PIM) approach. Our design introduces a novel dataflow to exploit high bank-level parallelism and reuse both input and output data even for highly sparse matrices. Our proposed architecture, SPIMA, features multiple input buffers for scheduling DRAM access, a output buffer and vector register files working holistically, co-designed to maximize the performance of our novel dataflow. Our experimental results using various sparse matrices demonstrate that our proposed dataflow and architecture are robust in terms of matrix size and sparsity. Compared with the state-of-the-art accelerators implemented on PIM, ASIC, and FPGA, we estimate that our PIM architecture can yield competitive performance with highly sparse matrices.  © 2025 IEEE.},
 author = {Assylbekov, Tairali and Yu, Minsang and Park, Jaewoo and Kim, Mingon and Kim, Seungsu and Lee, Jongeun},
 doi = {10.1109/ICCAD66269.2025.11240738},
 journal = {IEEE/ACM International Conference on Computer-Aided Design, Digest of Technical Papers, ICCAD},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {SPIMA: Scalable and Cost-Efficient Sparse Matrix Multiplication via Processing in DRAM Array},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105029394570?origin=resultslist},
 year = {2025}
}
