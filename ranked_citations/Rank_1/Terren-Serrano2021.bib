@conference{Terren-Serrano2021,
 abstract = {Moving clouds affect the Global Solar Irradiance (GSI) that reaches the surface of the Earth. As a consequence, the amount of resources available to meet the energy demand in a smart grid powered using Photovoltaic (PV) systems depends on the shadows projected by passing clouds. This research introduces an algorithm for tracking clouds to predict Sun occlusion. Using thermal images of clouds, the algorithm is capable of estimating multiple wind velocity fields with different altitudes, velocity magnitudes and directions. © 2021 IEEE.},
 author = {Terren-Serrano, Guillermo and Martinez-Ramon, Manel},
 doi = {10.1109/ISGTEurope52324.2021.9640045},
 journal = {Proceedings of 2021 IEEE PES Innovative Smart Grid Technologies Europe: Smart Grids: Toward a Carbon-Free Future, ISGT Europe 2021},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Wind Flow Estimation in Thermal Sky Images for Sun Occlusion Prediction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85123946689?origin=resultslist},
 year = {2021}
}
