@conference{Haloi2019501,
 abstract = {News video Indexing and story segmentation are one of the important steps for the creation of well categorized, organized and indexed video storage system. Such a system allows disciplined storage to cope with an increasing amount of data, and easier retrieval in the future for viewing. Keeping this approach in mind we proposed a News video Indexing and Story unit segmentation algorithm based on keywords obtained from the text displayed in the news frame during a news program. First with the help of our shot categorization algorithm we classify the news shots into commercial and news based on detection of spatial features of the particular News Channel. Then with the help of our shot indexing algorithm, we detect the presence of words in each frame of a shot and index each shot with a keyword. With the help of our Shot Combination algorithm, we combine the shots having similar keywords to form individual stories. The results obtained in this works were satisfactory and in accordance with the results depicted using manual visual observation. © 2019 IEEE.},
 author = {Haloi, Pranabjyoti and Gadde, Prathik and Bhuyan, M.K.},
 doi = {10.1109/WiSPNET45539.2019.9032814},
 journal = {2019 International Conference on Wireless Communications, Signal Processing and Networking, WiSPNET 2019},
 note = {Cited by: 3},
 pages = {501 - 507},
 publication_stage = {Final},
 source = {Scopus},
 title = {News video indexing and story unit segmentation using text cue},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85083238247?origin=resultslist},
 year = {2019}
}
