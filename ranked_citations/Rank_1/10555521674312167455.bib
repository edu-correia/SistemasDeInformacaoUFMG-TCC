@article{10.5555/2167431.2167455,
 abstract = {CAPTCHA is a popular protection mechanism used by many web sites to defend against attacks from software robots which attempt to gather information or automatically fill in forms and submit them assuming someone's identity. In this paper, the authors describe how students can be taught the basic concepts of CAPTCHA programming through hands-on coding activities. The authors also discuss sample PHP code examples that can be used to illustrate the coding techniques. Instructors can use these code examples to demonstrate the various types of CAPTCHA applications.},
 address = {Evansville, IN, USA},
 author = {Wu, Penn and Manrique, Pedro},
 issn = {1937-4771},
 issue_date = {April 2012},
 journal = {J. Comput. Sci. Coll.},
 month = {April},
 number = {4},
 numpages = {9},
 pages = {131–139},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Teaching captcha in a PHP programming course},
 volume = {27},
 year = {2012}
}
