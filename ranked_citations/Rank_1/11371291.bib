@inproceedings{11371291,
 abstract = {Accurate and prompt disease identification is crucial for efficient treatment of patients' health. However, identifying different diseases, particularly in their early phases, is challenging because of subtle and misleading symptoms. This paper highlights the fusion of two key medical data sources: medical images and clinical notes of patients. The model uses DenseNet-121 along with image normalization methods to capture complex visual details from medical images. Meanwhile, ClinicalBERT processes clinical text data using tokenization and contextual embeddings to extract important insights from patient records. A hybrid fusion model, which employs attention mechanisms, merges both medical records, enabling the system to evaluate the complete range of accessible patient data. This classification model predicts outcomes by distinguishing between healthy individuals and patients with diseases, further identifying specific disease types and analyzing the growth of the condition. By incorporating medical records and advanced ML methods, this model helps improve diagnostic accuracy and supports earlier disease detection.},
 author = {Narkhede, Maheshwary and Umbare, R.T. and Ninawe, Jaydeep and Patel, Deven and Mahajan, Shreyas and Karemore, Priya},
 booktitle = {2025 2nd International Conference on Integration of Computational Intelligent System (ICICIS)},
 doi = {10.1109/ICICIS65613.2025.11371291},
 issn = {},
 keyword = {Visualization;Accuracy;Soft sensors;Medical services;Predictive models;Nearest neighbor methods;Transformers;Tokenization;Medical diagnostic imaging;Diseases;DenseNet;ClinicalBert;Attention;Transformer KNN;SVM;Naïve Bayes;Random Forest},
 month = {Sep.},
 number = {},
 pages = {1-4},
 title = {MedFuse: Integrating Clinical Notes and Medical Imaging for Accurate Diagnosis},
 volume = {},
 year = {2025}
