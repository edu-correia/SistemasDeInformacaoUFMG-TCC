@article{ALASMARI2025145577,
 abstract = {This study explores the evolution of logistics research in Saudi Arabia, focusing on its alignment with sustainability, emerging technologies, and Vision 2030. Through a bibliometric analysis of 7627 Scopus-indexed articles from the 1970s to 2024, we identified a significant shift from traditional logistics themes, such as supply chain optimization, toward sustainable logistics, machine learning, and renewable energy as dominant research areas. Employing a machine learning forecasting model, our analysis reveals the current trajectory of the field, highlighting an increasing emphasis on supply chain resilience alongside the integration of advanced technologies like blockchain and artificial intelligence. The study underscores the growing importance of interdisciplinary approaches that merge cutting-edge technologies with conventional logistics to address complex challenges. Strong international collaborations, particularly with countries like the United States, United Kingdom, and China, have advanced research in sustainability and optimization. These findings not only reflect the global transition to sustainable and technology-driven logistics but also position Saudi Arabia as a leader in innovative logistics solutions, offering a roadmap for policymakers and industry to enhance economic resilience and achieve Vision 2030 goals.},
 author = {Talal Alasmari and Abdulrahman Alzahrani},
 doi = {https://doi.org/10.1016/j.jclepro.2025.145577},
 issn = {0959-6526},
 journal = {Journal of Cleaner Production},
 keyword = {Interdisciplinary logistics, Sustainability, Green logistics, Machine learning, Supply chain, AI-Driven logistics},
 pages = {145577},
 title = {Saudi Arabia's shifts towards green and sustainable Logistics: Bibliometric and machine learning-based insights and forecasts},
 url = {https://www.sciencedirect.com/science/article/pii/S0959652625009278},
 volume = {509},
 year = {2025}
}
