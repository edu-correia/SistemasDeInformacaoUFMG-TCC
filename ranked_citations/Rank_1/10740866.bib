@inproceedings{10740866,
 abstract = {We analyze the compaction I/O characteristics and the resulting I/O time amplification problem in log-structured merge-tree based key-value stores. We also propose an I/O stack refinement using SPDK and NVMe-oF for compaction offloading. Using our proposed I/O stack, preliminary experimental results show a 37.7% improvement in compaction throughput.},
 author = {Yoo, Honghyeon and Byun, Hongsu and Park, Sungyong},
 booktitle = {2024 IEEE International Conference on Cluster Computing Workshops (CLUSTER Workshops)},
 doi = {10.1109/CLUSTERWorkshops61563.2024.00060},
 issn = {},
 keyword = {Conferences;Refining;Cluster computing;Throughput;Compaction;Key-Value Store;LSM-tree;SPDK},
 month = {Sep.},
 number = {},
 pages = {204-205},
 title = {Refining Compaction Offloading I/O Stack for LSM-Based Key-Value Stores with SPDK},
 volume = {},
 year = {2024}
}
