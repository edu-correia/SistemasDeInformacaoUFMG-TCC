@article{Kemp20101185,
 abstract = {Learning to understand a single causal system can be an achievement, but humans must learn about multiple causal systems over the course of a lifetime. We present a hierarchical Bayesian framework that helps to explain how learning about several causal systems can accelerate learning about systems that are subsequently encountered. Given experience with a set of objects, our framework learns a causal model for each object and a causal schema that captures commonalities among these causal models. The schema organizes the objects into categories and specifies the causal powers and characteristic features of these categories and the characteristic causal interactions between categories. A schema of this kind allows causal models for subsequent objects to be rapidly learned, and we explore this accelerated learning in four experiments. Our results confirm that humans learn rapidly about the causal powers of novel objects, and we show that our framework accounts better for our data than alternative models of causal learning. © 2010 Cognitive Science Society, Inc.},
 author = {Kemp, Charles and Goodman, Noah D. and Tenenbaum, Joshua B.},
 doi = {10.1111/j.1551-6709.2010.01128.x},
 journal = {Cognitive Science},
 note = {Cited by: 76},
 number = {7},
 pages = {1185 - 1243},
 publication_stage = {Final},
 source = {Scopus},
 title = {Learning to Learn Causal Models},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/78650147550?origin=resultslist},
 volume = {34},
 year = {2010}
}
