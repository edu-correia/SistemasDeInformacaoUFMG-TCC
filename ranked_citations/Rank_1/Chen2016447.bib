@article{Chen2016447,
 abstract = {Traditionally, complex engineering applications (CEAs), which consist of numerous components (software) and require a large amount of computing resources, usually run in dedicated clusters or high performance computing (HPC) centers. Nowadays, Cloud computing system with the ability of providing massive computing resources and customizable execution environment is becoming an attractive option for CEAs. As a new type on Cloud applications, CEA also brings the challenges of dealing with Cloud resources. In this paper, we provide a comprehensive survey of Cloud resource management research for CEAs. The survey puts forward two important questions: 1) what are the main challenges for CEAs to run in Clouds? and 2) what are the prior research topics addressing these challenges? We summarize and highlight the main challenges and prior research topics. Our work can be probably helpful to those scientists and engineers who are interested in running CEAs in Cloud environment. © 2016, Higher Education Press and Springer-Verlag Berlin Heidelberg.},
 author = {Chen, Haibao and Wu, Song and Jin, Hai and Chen, Wenguang and Zhai, Jidong and Luo, Yingwei and Wang, Xiaolin},
 doi = {10.1007/s11704-015-4207-x},
 journal = {Frontiers of Computer Science},
 note = {Cited by: 3},
 number = {3},
 pages = {447 - 461},
 publication_stage = {Final},
 source = {Scopus},
 title = {A survey of cloud resource management for complex engineering applications},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84961614079?origin=resultslist},
 volume = {10},
 year = {2016}
}
