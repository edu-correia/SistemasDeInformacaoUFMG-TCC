@article{10.1145/3127585,
 abstract = {Divide-and-conquer recurrences of the form f(n) = f (⌊ n/2⌋ ) + f ( ⌈ n/2⌉ ) + g(n) (n⩾ 2), with g(n) and f(1) given, appear very frequently in the analysis of computer algorithms and related areas. While most previous methods and results focus on simpler crude approximation to the solution, we show that the solution always satisfies the simple identity f(n) = n P(log2n) − Q(n) under an optimum (iff) condition on g(n). This form is not only an identity but also an asymptotic expansion because Q(n) is of a smaller order than linearity. Explicit forms for the continuous periodic function P are provided. We show how our results can be easily applied to many dozens of concrete examples collected from the literature and how they can be extended in various directions. Our method of proof is surprisingly simple and elementary but leads to the strongest types of results for all examples to which our theory applies.},
 address = {New York, NY, USA},
 articleno = {47},
 author = {Hwang, Hsien-Kuei and Janson, Svante and Tsai, Tsung-Hsi},
 doi = {10.1145/3127585},
 issn = {1549-6325},
 issue_date = {October 2017},
 journal = {ACM Trans. Algorithms},
 keyword = {uniform continuity, sensitivity analysis, recurrence relation, periodic oscillation, master theorems, identity, functional equation, asymptotic linearity, asymptotic approximation, additivity, Analysis of algorithms},
 month = {October},
 number = {4},
 numpages = {43},
 publisher = {Association for Computing Machinery},
 title = {Exact and Asymptotic Solutions of a Divide-and-Conquer Recurrence Dividing at Half: Theory and Applications},
 url = {https://doi.org/10.1145/3127585},
 volume = {13},
 year = {2017}
}
