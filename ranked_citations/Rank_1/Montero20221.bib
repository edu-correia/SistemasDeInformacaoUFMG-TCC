@conference{Montero20221,
 abstract = {Information extraction on documents still remains a challenge, especially when dealing with unstructured documents with complex and variable layouts. Graph Neural Networks seem to be a promising approach to overcome these difficulties due to their flexible and sparse nature, but they have not been exploited yet. In this work, we present a multi-level graph-based model that performs entity building and linking on unstructured documents, purely based on GNNs, and extremely light (0.3 million parameters). We also propose a novel strategy for an optimal propagation of the information between the graph levels based on hypernodes. The conducted experiments on public and private datasets demonstrate that our model is suitable for solving the tasks, and that the proposed propagation strategy is optimal and outperforms other approaches. © 2022 Proceedings - International Conference on Computational Linguistics, COLING. All rights reserved.},
 author = {Montero, David and Martinez, Javier and Yebes, J. Javier},
 journal = {Proceedings - International Conference on Computational Linguistics, COLING},
 note = {Cited by: 0},
 number = {16},
 pages = {1 - 10},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multilevel Hypernode Graphs for Effective and Efficient Entity Linking},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85179140088?origin=resultslist},
 volume = {29},
 year = {2022}
}
