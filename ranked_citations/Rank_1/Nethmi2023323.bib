@conference{Nethmi2023323,
 abstract = {Being fluent in the mother tongue benefits a child in many ways; it helps in the development of a child's personal, social, and cultural identity and also aids in learning other languages. Kids would one day want to be proficient readers or writers in their own tongue, and children need help with language development in order to accomplish this. Therefore, it is the responsibility of parents to aid in their children's vocabulary development. But the problem is that many parents today are employed and therefore unable to interact with and educate their children. As a result, past research suggests that the best way to solve this issue is to develop an application that makes use of cutting-edge tools like computer vision and machine learning. However, the issue is that those applications support many other languages but not Sinhala language. The current study's main gap is creating a mobile application using the Sinhala image caption. Therefore, the present study implemented the' Narrataa' mobile application, which provides a caption for the relevant taken image in English, Sinhala, and Tamil. To develop the current application, the researcher employed computer vision, machine learning technologies, the Android Studio IDE. and the Java programming language. © 2023 IEEE.},
 author = {Nethmi, Dilum and Navarathna, Rajitha and Senanayake, Anutthra},
 doi = {10.1109/ICIIS58898.2023.10253493},
 journal = {2023 IEEE 17th International Conference on Industrial and Information Systems, ICIIS 2023 - Proceedings},
 note = {Cited by: 1},
 pages = {323 - 328},
 publication_stage = {Final},
 source = {Scopus},
 title = {Narrataa: Learning Tool for Generating Kid-Friendly Sinhala Names for Objects},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85173558230?origin=resultslist},
