@article{SITU2025103857,
 abstract = {Understanding travel constraints is essential to evaluating whether individuals can meet daily transportation needs. Prior studies often rely on single indicators, such as car ownership or travel costs. This study develops a multidimensional framework that integrates a household-level Housing and Transportation Cost-to-Income Ratio (HT CIR) with an individual-level Intra-personal Travel Constraints (ITC) propensity model. Drawing on regional housing and travel data merged with the Next-Generation National Household Travel Survey (NextGen NHTS), this study classify household types in Central Texas by constraint profiles. Households with high HT CIR face affordability challenges, while those with high ITC propensities encounter barriers related to health, safety, comfort, accessibility, and time. Findings show that high HT CIR and lower income suppress travel demand, particularly among households with high ITC propensities. Social and demographic factors—including limited income, insufficient car ownership, limited English proficiency, single-parent status, race, and retirement—increase the likelihood of high ITC propensities. Notably, single-mother households displayed distinct patterns of constraint, with a larger share experiencing health, comfort, affordability, accessibility, and time-related challenges compared with other household types. These disparities are compounded for Black and Hispanic/Latino single mothers, underscoring the intersection of race and gender in shaping mobility barriers. Policy implications vary by context. In areas with both high HT CIR and high ITC, interventions should prioritize alternatives to car use, affordability programs, and mobility services targeted at specific populations. Where high HT CIR dominates, financial support is most urgent. Expanding non-automobile access is critical to reducing car dependence and mitigating inequities across diverse populations.},
 author = {Minyu Situ},
 doi = {https://doi.org/10.1016/j.tranpol.2025.103857},
 issn = {0967-070X},
 journal = {Transport Policy},
 pages = {103857},
 title = {Who faces travel constraints? Analyzing household and individual travel challenges in automobile-dependent central Texas},
 url = {https://www.sciencedirect.com/science/article/pii/S0967070X25004007},
 volume = {174},
 year = {2025}
}
