@article{LU2025102902,
 abstract = {Lane detection involves recognizing lane markings as approximate curves and is widely used in lane departure warning and adaptive cruise control systems for autonomous vehicles. To address the issues of large model parameters and low computational efficiency in two-stage lane detection models, this paper develops an end-to-end lane detection with PnP compression and condition DETR. In order to enrich the low-level features, this paper first uses the Laplacian operator to extract more favorable lane features and then concatenates these features with the original image features. Then, the merged feature maps are fed into the feature extraction module. Next, to further enhance the recognition accuracy of the network, this paper modifies the feature extraction part of the DETR model, replacing it with Condition DETR. Subsequently, in order to reduce the overall model parameters without compromising detection accuracy, the PnP module is employed to compress the extracted feature maps into an abstract feature set composed of fine-grained feature vectors and a small number of coarse-grained feature vectors for subsequent lane line detection. This proposed method has been validated in the TuSimple benchmark test, and the accuracy of this paper has improved to 96.41%. Compared with other larger two-stage model methods, the parameters of the proposed model are reduced to 0.78M with a smaller model size and faster running speed.},
 author = {Fangfang Lu and Guxue Sun and Huiqun Yu and Yijie Huang and Tong Zhou and Sangyu Yao},
 doi = {https://doi.org/10.1016/j.displa.2024.102902},
 issn = {0141-9382},
 journal = {Displays},
 keyword = {Laplacian operator, PnP, Condition DETR, TuSimple},
 pages = {102902},
 title = {LPCNet: End-to-end lane detection with PnP compression and condition DETR},
 url = {https://www.sciencedirect.com/science/article/pii/S014193822400266X},
 volume = {87},
 year = {2025}
}
