@article{YAN2025111850,
 abstract = {Preforming and forging help refine and homogenize the metal structure and are often used as the first step in component manufacturing. Therefore, studying the hot deformation behavior of materials after preforming offers more practical guidance for engineering applications. This paper focuses on the high-strength Al-10.0Zn-3.0Mg-3.0Cu alloy, using the "upsetting-extrusion-upsetting" process for preforming (with a cumulative true strain of up to 4.5). Isothermal compression tests were conducted within a temperature range of 280 °C to 440 °C and a strain rate range of 10−3 s−1 to 10 s−1, and a constitutive equation and three-dimensional hot processing map were established to investigate the alloy's hot deformation behavior after preforming. The results show that the alloy exhibits a softening mechanism dominated by dynamic recrystallization (DRX) during hot deformation. Under high-temperature and low-strain-rate conditions, low-angle subgrains rotate or merge into high-angle continuous dynamic recrystallization (CDRX), leading to grain refinement. However, as the temperature decreases and the strain rate increases, the dislocation multiplication rate increases, and discontinuous dynamic recrystallization (DDRX) nucleated from grain boundaries becomes the dominant DRX mechanism. The optimal processing region was identified as 416 °C to 440 °C and 0.001 s−1 to 0.1 s−1. Comparative studies reveal that the "upsetting-extrusion-upsetting" alloy exhibits superior hot formability compared to the homogenized alloy. This is mainly because, during hot forming, the softening mechanism in the homogenized alloy is primarily dynamic recovery, whereas the "upsetting-extrusion-upsetting" alloy, with finer initial grains and a higher grain boundary density, provides more nucleation sites for dynamic recrystallization. Additionally, severe plastic deformation during preforming breaks up coarse insoluble phases, reduces dislocation accumulation and obstruction, and mitigates stress concentration. As a result, the activation energy for hot deformation is lower, and the power dissipation efficiency is higher.},
 author = {Shiliang Yan and Xi Zhao and Xianwei Ren and Dongchu Yang and Yihan Gao and Yanjun Liu},
 doi = {https://doi.org/10.1016/j.mtcomm.2025.111850},
 issn = {2352-4928},
 journal = {Materials Today Communications},
 keyword = {High-strength aluminum alloy, Open billet reforging, Hot deformation behavior, Hot formability},
 pages = {111850},
 title = {Study on the hot deformation behavior and mechanisms for enhanced hot formability of Al-10.0Zn-3.0Mg-3.0Cu alloy after open billet reforging},
 url = {https://www.sciencedirect.com/science/article/pii/S2352492825003629},
 volume = {44},
 year = {2025}
}
