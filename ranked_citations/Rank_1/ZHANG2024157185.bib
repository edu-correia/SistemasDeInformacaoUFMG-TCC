@article{ZHANG2024157185,
 abstract = {Both photocatalytic CO2 reduction and seawater desalination are powered by solar energy, while the development and application of the two reactions are generally studied independently. In this paper, an all-in-one and recyclable integrated system is designed and constructed utilizing polydopamine and V-Bi19Br3S27 as the photothermal materials, and S-scheme heterojunction V-Bi19Br3S27/Bi2WO6 with rich Br-S dual-vacancies as the catalyst, which are merged onto floatable natural wood supporter, achieving a coupling reaction of photocatalytic CO2 reduction in gas–solid phase and solar seawater desalination in liquid–solid phase. On the one hand, natural wood as supporter possesses the interpenetrating and macroporous structure, which is an important accessible channel for seawater evaporation. PDA and V-Bi19Br3S27 exhibit the efficient photothermal conversion ability due to the wide light respond range toward UV − vis − NIR light. The synergy effect of supporter and photothermal materials are beneficial to accelerate seawater evaporation. The H2O vapor as an important proton donor participates in CO2 reduction of the catalysts on wood surface. On the other hand, V-Bi19Br3S27 with abundant Br-S dual-vacancies enhance sunlight absorption and increase active sites, and incorporating with Bi2WO6 to construct S-scheme heterojunction quickens charge transport and maintains strong redox potentials, which is beneficial to CO2 conversion. As a result, sunlight driven coupling reaction including 14.44 μmol·h−1 of product yield from CO2 reduction and 0.90 kg·m−2·h−1 of evaporation efficiency from seawater desalination is realized. The integrated system also exhibits the strong durability and the excellent coupling performance under outdoor real sunlight and, together with simple recoverability, contributing to commercial applications.},
 author = {Yuanyuan Zhang and Shiye Lou and You Yin and Xing Lv and Hao Yu and Chendong Zhuge and Lina Zhang and Lili Liu and DongEn Zhang and Linxing Shi},
 doi = {https://doi.org/10.1016/j.cej.2024.157185},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Integrated system, Coupling reaction, Seawater desalination, Photocatalytic CO reduction, Wood/PDA/V-BBS/BWO},
 pages = {157185},
 title = {“One stone two birds”—Solar energy driven CO2 reduction and seawater desalination coupling reactions using floatable and recyclable integrated system},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894724086765},
 volume = {500},
 year = {2024}
}
