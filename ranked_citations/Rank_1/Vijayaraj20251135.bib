@article{Vijayaraj20251135,
 abstract = {Big data processing is crucial for extracting insights from large datasets, involving storage, cleansing, organization, modeling, analysis, and presentation. However, many face challenges with complex data systems, long provisioning times, and redundant boot disks. Containers, like Docker, address these issues by allowing distributed applications to run without full virtual machines. Despite this, Docker’s Swarmkit struggles with heterogeneity in clusters, where nodes vary in resource types and availability. To address this, we propose a resource-aware placement technique for heterogeneous Docker container clusters, using a Modified Log-Structured Merge (MLSM) data structure. This combines Cuckoo and Bloom Filters to efficiently distribute resources and maintain filter synchronization, providing better space utilization. Experimental results show that MLSM outperforms current methods in terms of performance and efficiency. ©2025 The authors.},
 author = {Vijayaraj, V. and Balamurugan, M. and Oberoi, Monisha},
 doi = {10.18280/isi.300503},
 journal = {Ingenierie des Systemes d'Information},
 note = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 number = {5},
 pages = {1135 - 1146},
 publication_stage = {Final},
 source = {Scopus},
 title = {Optimizing Docker Container Placement in Heterogeneous Clusters Using a Modified Log-Structured Merge Scheme},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105009934072?origin=resultslist},
 volume = {30},
 year = {2025}
}
