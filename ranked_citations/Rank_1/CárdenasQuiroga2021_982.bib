@article{CárdenasQuiroga2021_982,
 abstract = {Abstract The GIS smart campuses have been constituted as an efficient system that allows the integration of information from different agencies inside universities, with the use of geographic applications developed for different types of users. This research describes general considerations to begin implementation of a smart GIS at the Nueva Granada Campus, in Cajicá. This phase was developed based on the generation of a campus base map, which is used as a spatial reference for the elaboration of all applications that require associated geographic information, as well as the implementation of a Gisweb system for the monitoring, verification, and updating of the campus trees. The result of the work provides the basis for subsequent systems and applications of location, mobility and efficacy management related with the academic and administrative activities in the university campus.},
 author = {Cárdenas-Quiroga, Elsa Adriana},
 doi = {10.22395/rium.v20n38a2},
 number = {38},
 pages = {33--50},
 title = {Smart Campus at the Universidad Militar Nueva Granada: Creation of Base Map and Applications for Campus Tree Monitoring},
 volume = {20},
 year = {2021}
}
