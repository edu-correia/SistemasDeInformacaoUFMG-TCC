@conference{Wen2025153,
 abstract = {FSOD(Few-shot object detection) targets the recognition and accurate localization of unseen classes with only a handful of annotated instances, a problem still considered highly challenging in computer vision. To tackle this problem, we introduce MCM-FSOD, a new FSOD pipeline that synergizes Mamba-based spatial scanning with cross-attention modules. The proposed method enhances the model's feature representation and contextual modeling capabilities under data-scarce conditions. Concretely, MCM-FSOD leverages DINOv3 for multi-scale feature extraction and embeds an SS2D block to simultaneously encode short-range details and long-range interactions. A cross-attention branch is then appended to dynamically merge local cues with global context, boosting discrimination and generalization. Evaluations on MS-COCO show that MCM-FSOD surpasses prior arts under both 10 -shot and 30 -shot protocols. Notably, mAP75 gains reach 3.1 pp compared with the strongest competitor. Visualizations and ablations further verify that every module contributes positively and that attended regions are semantically reasonable. Overall, the proposed method exhibits strong detection accuracy and robustness in few-shot scenarios. © 2025 IEEE.},
 author = {Wen, Lili and Wu, Man and Lu, Liulin},
 doi = {10.1109/ECCST68196.2025.11440957},
 journal = {Proceedings of 2025 5th International Conference on Electronic Communication, Computer Science and Technology, ECCST 2025},
 note = {Cited by: 0},
 pages = {153 - 157},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improved Few-shot Object Detection via Mamba and Cross-Attention Mechanisms},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105037336422?origin=resultslist},
 year = {2025}
}
