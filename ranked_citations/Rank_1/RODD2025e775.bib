@article{RODD2025e775,
 abstract = {Purpose/Objective(s)
Small deviations in clinical attributes, particularly biomarkers, play a crucial role in oncology, affecting prognosis, diagnosis, and treatment decisions. This underscores the necessity for extremely precise and specific biomarker tests, as well as advanced interpretative models to translate these subtle variations into actionable clinical insights. Digital twins (DTs) offer a promising solution by simulating individual patient conditions in a controlled, virtual environment, enabling better prediction and management of disease outcomes. Integrating high-dimensional (HD) data resources through DTs could avoid the overlook of biomarkers with low specificity, thus, improving patient care. Our study aims to utilize a DT to integrate HD-to-LD (lower dimensional) data to assess and enhance the adaptability in decision-making processes in oncology.
Materials/Methods
A DT model is designed and utilized for large-scale multimodal imaging data across lung and breast cancer diseases to enhance adaptability of overall survival (OS) and diagnostic prediction. Our DT integrates diverse data types including imaging, genetic, and clinical information to simulate patient-specific disease progressions and treatment outcomes. We employed Parzen-Rosenblatt constrained isometric mapping through DT simulation to map complex HD data into a comprehensible LD space. This approach, demonstrated in our previous work, advances disease prognosis and diagnosis, enhances robustness in precision oncology through data-driven decision-making, and facilitates real-time updates and adjustments based on ongoing patient data.
Results
We comprehensively tested the proposed DT model across 1,713 cases from multiple datasets including 211 cases, 57,836 CT/PET images, 422 CT cases, 88 CT scans for non-small cell lung cancer (NSCLC), 780 breast cancer cases with ultrasound images, and 212 breast cancer screenings with mammography and thermography images. Initial embedding accuracies were 78.5% (±4.4), 88.4% (±1.4), and 61.4% (±11.4) for three lung cancer datasets, 80.3% (±5.5) for breast cancer with ultrasound, and 82.9% (±2.3) for breast cancer mammography+thermography, validated under biomarker fluctuations (±10%) in LD space using Parzen-Rosenblatt isometric embedding to ensure model fidelity (±4%) to patient variability.
Conclusion
The success of the DT model in handling large-scale multimodal data is a transformative progress in robust cancer management. As medicine and oncology continue to evolve with advancements in data science, the DT holds promise for redefining personalized healthcare and improving overall patient outcomes in oncology and beyond. Future developments aim to integrate our computational DT models with biological DTs derived from organoids to enhance predictive accuracy and personalize treatment plans further, merging cutting-edge bioengineering with informatics to create a comprehensive tool for precision medicine.},
 author = {B. Yousefi Rodd and R. Rahimi},
 doi = {https://doi.org/10.1016/j.ijrobp.2025.06.3244},
 issn = {0360-3016},
 journal = {International Journal of Radiation Oncology*Biology*Physics},
 note = {ASTRO 2025: 67th Annual Meeting},
 number = {1, Supplement },
 pages = {e775},
 title = {Digital Twins for High-Dimensional Data Integration in Clinical Decision Making},
 url = {https://www.sciencedirect.com/science/article/pii/S0360301625038490},
 volume = {123},
