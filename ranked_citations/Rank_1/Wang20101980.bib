@conference{Wang20101980,
 abstract = {Image fusion techniques can integrate the spatial detail of the panchromatic image and the spectral characteristics of the multispectral image into one image. Exiting image fusion techniques may not be optimization for fusing the new generation commercial satellite image such as ALOS. The most serious problem is that the fused image usually has a notable deviation in visual appearance and spectral values from the original image. In this paper, we proposed a new fusion method for ALOS images, which combines the standard IHS transform with HPF, when adding the detail information of panchromatic image to the intensity component of multispectral image, the weight coefficients are determined adaptively based on the window regional feature. Experimental results indicate that this method is effective when fusing ALOS panchromatic and multispectral images. ©2010 IEEE.},
 author = {Wang, Xiaoyan and Liu, Yong and Jiang, Zhiyong},
 doi = {10.1109/FSKD.2010.5569477},
 journal = {Proceedings - 2010 7th International Conference on Fuzzy Systems and Knowledge Discovery, FSKD 2010},
 note = {Cited by: 0},
 pages = {1980 - 1984},
 publication_stage = {Final},
 source = {Scopus},
 title = {An adaptive HPF-IHS fusion method for ALOS image},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78649288456?origin=resultslist},
 volume = {4},
 year = {2010}
}
