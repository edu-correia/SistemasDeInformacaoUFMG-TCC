@article{FATAHI2026132511,
 abstract = {Clustering with missing data remains a fundamental challenge in high-dimensional analysis. We propose a unified framework, Graph Convolutional Subspace-Neighbor Clustering with Missing Entries (GCSNCME), which jointly addresses subspace clustering and missing data recovery. At its core is a novel Graph Convolutional Self-expression Representation (GCSR) that integrates neighborhood information through graph convolution and projects the resulting features into subspaces using both ℓ1-norm (sparse) and weighted 0.5-Schatten norm (low-/high-rank) regularizations. We propose a convex bi-objective spectral clustering model that incorporates subspace and neighborhood Laplacians into a unified merged Laplacian for clustering. The proposed model is optimized via ADMM with theoretical convergence guarantees, where fewer approximations lead to a more accurate reduction of the objective function. Furthermore, the computational complexity is further reduced by discarding redundant zero entries and solving the weighted nonconvex rank subproblem in closed-form. Extensive experiments on synthetic and real-world data (Yale, ORL, YaleB, Hopkins155) show that GCSNCME consistently outperforms existing baselines in clustering accuracy and robustness to missing data, while better capturing intrinsic data structures.},
 author = {Jasem Fatahi and Mansoor Rezghi},
 doi = {https://doi.org/10.1016/j.neucom.2025.132511},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {Subspace clustering, Graph convolutional, Self-expression, Sparse representation, Rank-based representation, Subspace similarity, Neighbor similarity},
 pages = {132511},
 title = {Unified graph convolutional subspace-neighbor clustering with missing data via ADMM},
 url = {https://www.sciencedirect.com/science/article/pii/S0925231225031832},
 volume = {670},
 year = {2026}
}
