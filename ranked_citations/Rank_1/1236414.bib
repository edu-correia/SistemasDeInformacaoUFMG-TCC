@inproceedings{1236414,
 abstract = {Sorting is fundamental in algorithm design. A new architecture, the cell matrix/spl trade/, is illustrated on which Batcher's sorting networks are realized. The cell matrix/spl trade/ fits nanocomputers quite well for its reconfigurable structure of homogeneous cells. We introduce the realization and analysis of O-E sorting networks and bitonic-sorting networks on the Cell Matrix/spl trade/ to show how to program and analyze on it. The implementation reveals the convenience and unique programming style of the Cell Matrix/spl trade/.},
 author = {Yan Chao and Chen Guoliang and Zhong Cheng and Shen Yifei},
 booktitle = {Proceedings of the Fourth International Conference on Parallel and Distributed Computing, Applications and Technologies},
 doi = {10.1109/PDCAT.2003.1236414},
 issn = {},
 keyword = {Sorting;Computer architecture;Algorithm design and analysis;Manufacturing;Equations;Chaos;Computer networks;High performance computing;Topology;Content addressable storage},
 month = {Aug},
 number = {},
 pages = {784-788},
 title = {Sorting networks on a nanocomputing architecture},
 volume = {},
 year = {2003}
}
