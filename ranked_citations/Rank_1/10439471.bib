@inproceedings{10439471,
 abstract = {We present a versatile method to create 3-D surfaces with complex hierarchical microstructures that mimic the patterns found on springtail skin. Our method innovatively merges two fixed-spacing patterns at different scales to create patterns with varying spacing but does not require precise alignment. The key is to utilize localized stretching strain when gradually laminating a thin microstructured elastomer layer onto a wavy substrate. To demonstrate this new fabrication process, we laminated a micro-pillar thin polydimethylsiloxane (PDMS) film on a wavy PDMS substrate with millimeter-scale inverted pyramidal holes. This resulted in hierarchical surface micropillars that display varying spacings along the peaks and the valleys of the wavy substrate. To our best knowledge, this is the first report to generate controllable micro-patterns with a gradient spacing from fixed-spacing patterns. Our new process overcomes one of the major challenges in producing bio-inspired patterns with diverse variations for studies of biomimicry and biomutualism.},
 author = {Sun, Qingyang and Liu, Tingyi Leo},
 booktitle = {2024 IEEE 37th International Conference on Micro Electro Mechanical Systems (MEMS)},
 doi = {10.1109/MEMS58180.2024.10439471},
 issn = {2160-1968},
 keyword = {Fabrication;Visualization;Three-dimensional displays;Skin;Microstructure;Substrates;Surface treatment;Bio-mimicking;bio-mimetic;gradient spacing;hierarchical structures;alignment-free;batch fabrication},
 month = {Jan},
 number = {},
 pages = {658-660},
 title = {Engineering 3D Hierarchical Structures with Bio-Mimetic Solid Fraction Gradient},
 volume = {},
 year = {2024}
}
