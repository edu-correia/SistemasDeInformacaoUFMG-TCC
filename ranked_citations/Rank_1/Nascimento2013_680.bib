@article{Nascimento2013_680,
 abstract = {The portfolio management literature mainstream, the Project Selection Paradigm, regards projects as closed packages ready for choice. However, to generate a portfolio, such packages must be opened to reveal the inside sources of interdependencies among them. Then, the project elements so found may be recombined into new alternatives that better capture the synergies among projects and avoid negative interactions. Thus project selection can be superseded by a Project Portfolio Generation based on a projects' and portfolios' reformulation process.},
 author = {Nascimento, Paulo Tromboni de Souza},
 number = {1},
 pages = {13--22},
 title = {Portfolio generation goes beyond project selection: interdependencies must drive new alternatives creation},
 volume = {20},
 year = {2013}
}
