@inproceedings{11356279,
 abstract = {Low-resource biomedical event detection has received extensive research attention in recent years. Most existing studies improve the detection of biomedical events by integrating external knowledge, but their injection of rule-based knowledge often introduces irrelevant information and noise. To solve this problem, we propose a context-enhanced framework based on large language models (LLMs) for biomedical event detection. It employs a multi-module prompt framework that generates wordlevel, paragraph-level, and inference-level context to address lexical ambiguity, background knowledge deficits, and insufficient understanding of event relations in biomedical event detection. Extracting pertinent information while suppressing noise from the voluminous context produced by large language models is crucial for event-detection performance. To address this problem, we designed context selection and synthesis strategies to identify the most suitable context to enrich the prototype representation. Within the prototypical network we constructed, the selected context enriches the prototype embeddings. Experimental results on the MLEE dataset show that our method significantly improves the performance of existing prototype models, especially under data-scarce conditions, indicating the effectiveness of context information in trigger detection within the biomedical field.},
 author = {Peng, Xiang and Zhang, Yong and Zeng, Qinglei and Peng, Yiwen},
 booktitle = {2025 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)},
 doi = {10.1109/BIBM66473.2025.11356279},
 issn = {2156-1133},
 keyword = {Event detection;Large language models;Biological system modeling;Noise;Prototypes;Data mining;Bioinformatics;Context modeling;Biomedical Event Detection;Large Language Model;Contextual Information;Prototype Model;Low Resource},
 month = {Dec},
 number = {},
 pages = {2723-2729},
 title = {Low-Resource Biomedical Event Detection: Enhancement with Context Generated by Large Language Models},
 volume = {},
 year = {2025}
