@conference{Gupta20251746,
 abstract = {Potholes are a major factor in road traffic accidents, especially in developing nations like India. This study described the development of a real-time pothole detection, and condition monitoring system that uses a UAV and a battery powered embedded device. The system, includes a Raspberry Pi 5, USB camera, and YOLOv5 object detection model that was trained with transfer learning. A publicly available dataset containing annotated pothole images was transformed to YOLO format, and any unneeded pictures were deleted, then split into training, validation and testing sets. The trained YOLOv5 model obtained a precision of 0.807, recall of 0.743, mAP@0.5: mAP@0.5:0.95 is 0.819, and 0.526. After that, the last pipeline was run in real-time on the Raspberry Pi, and was effective at locating and counting potholes under dynamic lighting and vehicle motion. The hardware was mounted into a compact, 3D printed enclosure, and was effectively deployed on a drone platform that was powered by a portable battery. This approach demonstrates a relatively inexpensive and scalable method for fully autonomous infrastructure assessment. Future versions may incorporate GPS for geotagging, further cloud analytics, and multispectral imaging for robustness in cases of extreme weather. In all, this work illustrates how edge AI with UAV technology can merge to create an intelligent system for urban infrastructure monitoring. © 2025 IEEE.},
 author = {Gupta, Atishaya and Sharma, Suraj},
 doi = {10.1109/ICISC65841.2025.11188006},
 journal = {Proceedings of the 9th International Conference on Inventive Systems and Control, ICISC 2025},
 note = {Cited by: 0},
 pages = {1746 - 1753},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Battery-Powered Drone-Mounted System for Real-Time Pothole Detection and Road Condition Monitoring Using Deep Learning},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105020938027?origin=resultslist},
 year = {2025}
