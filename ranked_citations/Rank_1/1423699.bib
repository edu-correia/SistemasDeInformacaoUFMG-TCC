@inproceedings{1423699,
 abstract = {Recently, there has been some research emphasis on strategies to improve query functionality in distributed hash-table-based (DHT) peer-to-peer (P2P) systems, but no approach was able to define how complex schemas and queries can be implemented efficiently on top of it. In this paper, we propose a peer partitioned data management system (PPDM) for schema definition and query processing. We introduce "schema spaces" that allows complex schemas to be defined over a convenient set of nodes and define how simple and more complex schemas and queries are handled by the PPDM, laying the foundations for complex data management over P2P.},
 author = {Furtado, P.},
 booktitle = {19th International Conference on Advanced Information Networking and Applications (AINA'05) Volume 1 (AINA papers)},
 doi = {10.1109/AINA.2005.317},
 issn = {2332-5658},
 keyword = {Peer to peer computing;Conference management;Delta modulation;Routing;Samarium;Query processing;Indexing;Scalability;Fault tolerance;Floods},
 month = {March},
 number = {},
 pages = {303-306 vol.2},
 title = {Support for efficiently processing complex queries over a P2P substrate},
 volume = {2},
 year = {2005}
}
