@conference{Zayer202389,
 abstract = {In spite of the continuous work by researchers and companies to develop face recognition systems, they are still affected by various factors, most notably the environmental conditions of the images, especially the lighting conditions, whether bright, bad, or poor contrast. Therefore, Authors proposed a system that works to eliminate the effect of the lighting effect on the recognition rate, proposed image reprocessing the images based on Exposure Fusion technology to merge a set of images with different lighting, Gamma Correction and Histogram Equalization are relied upon to produce more than one image with different lighting, as changing gamma values in gamma correction can produce more than one image. These images with different lighting are merged based on Exposure Fusion technology, which is developed to deal with grayscale images to give final images with good lighting. These enhanced images are used for both test and training images in the normalized Eigenface algorithm. The performance of the proposed method was tested under different lighting conditions (good, bright, contrasting, dark, and changes in the background lighting of images) using different databases (Olivetti, AR, Extend Yale B, and Yale B databases). The proposed method improves the effectiveness of the Face Recognition system, as it achieved the best recognition rates in all lighting cases when compared to other methods.  © 2023 IEEE.},
 author = {Zayer, Mustafa and Abbas, Eyad Ibrahim},
 doi = {10.1109/ICEANS58413.2023.10630461},
 journal = {International Conference on Engineering, Applied and Nano Sciences, ICEANS 2023},
 note = {Cited by: 0},
 pages = {89 - 95},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improvement of Face Recognition Rate under Different Illumination by Using Exposure Fusion for Greyscale Images},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85203077759?origin=resultslist},
