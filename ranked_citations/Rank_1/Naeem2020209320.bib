@article{Naeem2020209320,
 abstract = {Due to the recent progress in Deep Neural Networks, Reinforcement Learning (RL) has become one of the most important and useful technology. It is a learning method where a software agent interacts with an unknown environment, selects actions, and progressively discovers the environment dynamics. RL has been effectively applied in many important areas of real life. This article intends to provide an in-depth introduction of the Markov Decision Process, RL and its algorithms. Moreover, we present a literature review of the application of RL to a variety of fields, including robotics and autonomous control, communication and networking, natural language processing, games and self-organized system, scheduling management and configuration of resources, and computer vision.  © 2013 IEEE.},
 author = {Naeem, Muddasar and Rizvi, Syed Tahir Hussain and Coronato, Antonio},
 doi = {10.1109/ACCESS.2020.3038605},
 journal = {IEEE Access},
 note = {Cited by: 237; All Open Access; Gold Open Access; Green Open Access},
 pages = {209320 - 209344},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Gentle Introduction to Reinforcement Learning and its Application in Different Fields},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85097338959?origin=resultslist},
 volume = {8},
 year = {2020}
}
