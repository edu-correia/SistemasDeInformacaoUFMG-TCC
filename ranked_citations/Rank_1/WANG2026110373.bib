@article{WANG2026110373,
 abstract = {Utility tunnel cable systems face critical fire safety challenges due to dense cable arrangements and complex flame spread dynamics. This study investigates the suppression efficiency of fireproof clapboards in mitigating cable flame spread risks within such confined spaces. The evolutionary patterns of flame spread parameters, flame shape, burning length, flame spread rate, and temperature distribution are systematically analyzed under varying clapboard widths and positions. Key findings reveal that placing fireproof clapboards on the 1st layer significantly enhances suppression efficiency by preventing cable ignition, whereas clapboards on upper layers allow overflow flames to interact and form intermittent merged flames that ignite upper cables. The burning length exhibits a non-monotonic trend with clapboard width, peaking at 30 cm for the 2nd layer, while upward position of clapboards consistently increases burning length. Flame spread rate decreases initially and then increases with width for the 2nd layer, but shows opposite trends for the 3rd and 4th layers. Importantly, clapboards on the 1st layer reduce the maximum ceiling temperature rise by 581 °C and delay the time to reach peak temperature by 1091 s compared to non-fire-resistant structures. The ceiling centerline temperature attenuation follows an exponential function, and a prediction model based on dimensionless width w/W is established. Additionally, clapboards lower sidewall temperatures near the ignition source, with the high-temperature zone's extent increasing with upward clapboard placement but minimized at 30 cm width. These results provide actionable guidelines for optimizing fireproof clapboard design in cable trays, offering significant implications for enhancing fire safety in dense underground infrastructure and advancing resilient urban development.},
 author = {Tao Wang and Haochuan Zhang and Hongya Zhu and Zhe Wang and Peng Liu and Lei Xu and Yan Wang and Weiguang An},
 doi = {https://doi.org/10.1016/j.ijthermalsci.2025.110373},
 issn = {1290-0729},
 journal = {International Journal of Thermal Sciences},
 keyword = {Utility tunnel, Cable tray fire, Fireproof clapboard, Width and position, Suppression efficiency},
 pages = {110373},
 title = {Suppression of cable tray fire in utility tunnel power compartments: Influence of fireproof clapboard widths and positions},
 url = {https://www.sciencedirect.com/science/article/pii/S1290072925006969},
 volume = {220},
 year = {2026}
}
