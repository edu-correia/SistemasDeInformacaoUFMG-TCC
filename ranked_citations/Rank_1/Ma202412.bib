@conference{Ma202412,
 abstract = {Advances in high-performance computing require new ways to represent large-scale scientific data to support data storage, data transfers, and data analysis within scientific workflows. Multivariate functional approximation (MFA) has recently emerged as a new continuous mesh-less representation that approximates raw discrete data with a set of piecewise smooth functions. An MFA model of data thus offers a compact representation and supports high-order evaluation of values and derivatives anywhere in the domain. In this paper, we present CPE-MFA, the first critical point extraction framework designed for MFA models of large-scale, high-dimensional data. CPE-MFA extracts critical points directly from an MFA model without the need for discretization or resampling. This is the first step toward enabling continuous implicit models such as MFA to support topological data analysis at scale. © 2024 IEEE.},
 author = {Ma, Guanqun and Lenz, David and Peterka, Tom and Guo, Hanqi and Wang, Bei},
 doi = {10.1109/TopoInVis64104.2024.00006},
 journal = {Proceedings - 2024 Topological Data Analysis and Visualization, TopoInVis 2024},
 note = {Cited by: 2},
 pages = {12 - 22},
 publication_stage = {Final},
 source = {Scopus},
 title = {Critical Point Extraction from Multivariate Functional Approximation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85212830892?origin=resultslist},
 year = {2024}
}
