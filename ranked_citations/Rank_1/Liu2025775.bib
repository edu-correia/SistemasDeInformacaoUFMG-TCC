@article{Liu2025775,
 abstract = {The Log-Structured Merge-tree (LSM-tree) has become a cornerstone of modern key-value stores (KVSs) due to its efficiency in handling write-intensive workloads. However, traditional monolithic LSM-tree designs suffer from write stalls caused by resource contention between Memtable flushing and SSTable compaction, while existing distributed systems adopt coarse-grained elasticity that limits resource utilization and responsiveness. This paper introduces ServerlessLSM, a kernelspace RDMA-odesigned Serverless workflow architecture for LSM-trees. By decoupling Memtable flushing and compaction into independent Serverless functions, ServerlessLSM enables fine-grained elasticity and low-latency state transfers through distributed OS primitives (e.g., remote fork, remote memory mapping). Evaluations demonstrate that ServerlessLSM reduces cold-start latency by 98% and achieves 2.4 higher throughput compared to state-of-the-art solutions, while maintaining space amplification below 11%, validating its efficiency and costeffectiveness in cloud environments. © 2025 IEEE.},
 author = {Liu, Mingxuan and Gu, Jianhua and Zhao, Tianhai},
 doi = {10.1109/ICWS67624.2025.00100},
 journal = {Proceedings of the IEEE International Conference on Web Services, ICWS},
 note = {Cited by: 1},
 number = {2025},
 pages = {775 - 781},
 publication_stage = {Final},
 source = {Scopus},
 title = {ServerlessLSM: Fast RDMA-Codesigned Disaggregated Compaction for Elastic Serverless LSM-Tree Key-Value Store},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105018801710?origin=resultslist},
 year = {2025}
}
