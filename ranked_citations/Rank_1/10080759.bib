@inproceedings{10080759,
 abstract = {The excessive usage of imaging data has created the essential need to design security algorithms for copyright protection. As a consequence, merging of two image security standards for more robustness has become a critical task. This research focuses on combining the encryption method along with the steganography standard for providing double security. The Laguerre Transform (LT) domain stego embedding based on LSB embedding is proposed to combine with RC4 fast encryption method. The speedy recovery of RC4 is the prime reason for adopting it for data encryption. The method is implemented in 2D domain. It is recommended to evaluate the performance of both cases based on quantitative evaluation using PSNR and SSIM as the parameters. It is found that the modified double layer security can improve data authenticity.},
 author = {Markam, Dayabati and Deoskar, Devashri and Saxena, Amit},
 booktitle = {2022 IEEE International Conference on Current Development in Engineering and Technology (CCET)},
 doi = {10.1109/CCET56606.2022.10080759},
 issn = {},
 keyword = {Steganography;Merging;Imaging;Transforms;Copyright protection;Robustness;Encryption;Image Security;Steganography;Laguerre Transform;RC4 Encryption;LSB;SSIM;PSNR},
 month = {Dec},
 number = {},
 pages = {1-7},
 title = {Design of Encrypted Steganography Double Secure Algorithm Using the Laguerre Transform},
 volume = {},
 year = {2022}
}
