@conference{Titsias2022,
 abstract = {Stochastic gradient-based optimization for discrete latent variable models is challenging due to the high variance of gradients. We introduce a variance reduction technique for score function estimators that makes use of double control variates. These control variates act on top of a main control variate, and try to further reduce the variance of the overall estimator. We develop a double control variate for the REINFORCE leave-one-out estimator using Taylor expansions. For training discrete latent variable models, such as variational autoencoders with binary latent variables, our approach adds no extra computational cost compared to standard training with the REINFORCE leave-one-out estimator. We apply our method to challenging high-dimensional toy examples and for training variational autoencoders with binary latent variables. We show that our estimator can have lower variance compared to other state-of-the-art estimators. © 2022 by the author(s).},
 author = {Titsias, Michalis K. and Shi, Jiaxin},
 journal = {Proceedings of Machine Learning Research},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Double Control Variates for Gradient Estimation in Discrete Latent Variable Models},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105019504618?origin=resultslist},
 volume = {151},
 year = {2022}
}
