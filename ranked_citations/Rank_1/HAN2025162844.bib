@article{HAN2025162844,
 abstract = {The immense potential of dielectric energy storage capacitors for high-power pulse device, especially the tetragonal tungsten bronze compounds, has spurred significant recent research and development. However, balancing the inverse correlation between polarization and electric breakdown field remains a challenging task for satisfactory energy storage performances. Here, we propose a feasible strategy of coupling ferroelectric polarization and relaxor behavior by incorporating non-equivalent cations Ho3+ and Ti4+ into Sr2Na0.8Ag0.2Nb5O15 matrix to enhance energy storage performances. Owing to the non-equivalent cation Ho3+ and Ti4+ incorporated into Sr2Na0.8Ag0.2Nb5O15 matrix for Sr2+ and Nb5+, as-obtained crystallographic structure evolved from orthorhombic to tetragonal phase and experienced a shrinkage in the volume of unit cell, which further induced the formation of polar nanoregions and the enhanced relaxor behavior as verified by TEM results and dielectric spectrum. Besides the ferroelectric to paraelectric transition at Tc, another low-temperature anomalous dielectric peak could also be observed, and two independent dielectric peaks merged into a broadened peak at higher contents substitution of Ho3+/Ti4+. The evolution of the above structure and the enhanced relaxor characteristics significantly increased maximum polarization (Pmax) and reduced remanent polarization (Pr). Benefited from the effective inhibition of abnormal grain growth by Ho3+and Ti4+, all samples presented an equiaxed grain with reduced grain size and uniformity in size distribution, as well as significantly suppressed leakage current confirmed by complex impedance results, all contributing to a remarkable improvement in breakdown electric field (Eb). As a result, Sr1.80Ho0.20Na0.8Ag0.2Nb4.80Ti0.20O15 sample exhibited an optimum recoverable energy storage density (Wrec) of 5.8J/cm3 and energy storage efficiency (ƞ) of 91.2 %, with excellent performance across different frequencies and fatigue cycles, significantly surpassing other tetragonal tungsten bronze compounds. This work presents a promising approach for developing new high-performance dielectric materials for high-power pulse devices.},
 author = {Mingzhe Han and Yan Wang and Yihan Tong and Zhiwei Feng and Xiaolian Chao and Zupei Yang and Bian Yang and Lingling Wei},
 doi = {https://doi.org/10.1016/j.cej.2025.162844},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Dielectric energy storage capacitors, High-power pulse devices, Tetragonal tungsten bronze compounds, Ferroelectric polarization, Relaxor behavior},
 pages = {162844},
 title = {Remarkable energy storage performances in tungsten bronze Sr2Ag0.2Na0.8Nb5O15-based ceramics through relaxor tuning},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894725036708},
 volume = {513},
 year = {2025}
}
