@article{WU2026109147,
 abstract = {The irradiation tolerance of amorphous AlCrTiNbSi high-entropy alloy coatings under 6 MeV Au2+ ions irradiation was studied. After irradiation, the coatings still maintained a complete amorphous phase structure, and the surface morphology became smoother. Slight hardness softening was observed under RT-irradiation, but significant hardness hardening was observed under 400 °C-irradiation. XRD results indicated that irradiation would introduce excessive free volume and destroy the short-range order in amorphous coatings. While increased temperature would induce atomic structural relaxation and consume abundant free volume. In addition, the excessive free volume introduced by irradiation contributed to the nucleation and growth of the voids, resulting in larger void size and density inside the RT-irradiated coating. With the increase of temperature, the mobility of FV was further enhanced, and more voids with small size encountered and merged with each other. As a result, the void size increased, but the void density decreased. Our results help to understand the mechanism of the irradiation effect in amorphous high-entropy alloy coatings.},
 author = {Juying Wu and Jian Yang and Yu Wang and Jijun Yang},
 doi = {https://doi.org/10.1016/j.intermet.2026.109147},
 issn = {0966-9795},
 journal = {Intermetallics},
 keyword = {LBE-Cooled fast reactor, High-entropy alloy, AlCrTiNbSi coatings, Au ions irradiation, Structure and performance evolution},
 pages = {109147},
 title = {Irradiation tolerance of amorphous AlCrTiNbSi high-entropy alloy coatings},
 url = {https://www.sciencedirect.com/science/article/pii/S0966979526000014},
 volume = {189},
 year = {2026}
}
