@article{PLOEGER2025100097,
 abstract = {Summary
Prototissues are synthetic three-dimensional (3D) constructs comprising protocells, non-living cell-like entities designed to mimic fundamental biological functions. Traditional in vitro tissue models and engineered tissues aim to replicate native tissues but face challenges in balancing complexity with precise physicochemical control. Prototissues have the potential to address this challenge by enabling modular, bottom-up assembly, which allows for fine-tuning of physicochemical features at multiple length scales. This review explores recent advancements in protocell and prototissue design, focusing on essential characteristics required to emulate native tissue microenvironments and facilitate the interaction with and the study of living cells. Key aspects include achieving precise spatiotemporal control over physicochemical features, engineering dynamic processes, and enabling communication with living cells. Furthermore, we discuss current limitations and the necessity of merging protocell technologies with biomaterials science to integrate cellular components and extracellular matrix elements into prototissues, thereby replicating the intricate structure and function of native tissues.},
 author = {Hidde Ploeger and Jordi Gonzalez-Molina},
 doi = {https://doi.org/10.1016/j.celbio.2025.100097},
 issn = {3050-5623},
 journal = {Cell Biomaterials},
 keyword = {prototissues, biomimetic biomaterials, smart biomaterials, synthetic biology, tissue models, microenvironment},
 number = {9},
 pages = {100097},
 title = {Designing biomimetic protocells and prototissues as smart biomaterials},
 url = {https://www.sciencedirect.com/science/article/pii/S3050562325000881},
 volume = {1},
 year = {2025}
}
