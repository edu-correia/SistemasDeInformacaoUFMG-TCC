@article{Murali201875,
 abstract = {Shadows are inescapable elements in a scene formed due to the presence of an object between the light source and the surface on which it is cast. Appearance of shadows often causes severe issues in computer vision applications like object extraction, and surveillance. Researchers have made effort to device techniques to locate and remove shadows from images and videos. This paper attempts to survey the various shadow detection algorithms for a single image. For the purpose of survey, the notable research work in the literature is classified under five major categories: invariant-based detection, feature-based detection, region-based detection, color model based detection and interactive shadow detection. The survey also includes a qualitative and quantitative evaluation of the methods discussed. As outcomes of the survey, it is observed that, (i) although the works discussed under each of these categories are capable of detecting shadows in different scenarios, the accuracy and time taken need further improvements to make the shadow detection process acceptable for practical applications; (ii) detection of self-shadows and heavily scattered shadows is challenging; (iii) the risk of mis-classifying dark objects as shadows should be addressed; (iv) soft shadows that span multiple surfaces pose challenge in accurate detection of shadows. © Kaunas University of Technology.},
 author = {Murali, Saritha and Govindan, V.K. and Kalady, Saidalavi},
 doi = {10.5755/j01.itc.47.1.17887},
 journal = {Information Technology and Control},
 note = {Cited by: 17; All Open Access; Gold Open Access},
 number = {1},
 pages = {75 - 92},
 publication_stage = {Final},
 source = {Scopus},
 title = {A survey on shadow detection techniques in a single image},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85042942031?origin=resultslist},
 volume = {47},
 year = {2018}
}
