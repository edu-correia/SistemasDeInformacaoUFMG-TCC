@conference{Mi20092663,
 abstract = {Outsourcing is an increasingly important issue pursued by corporations seeking improved efficiency. Logistics outsourcing or third-party logistics (3PL) involves the use of external companies to perform some or all of the firm's logistics activities. In this paper, by analyzing the feature and role of third-party logistics, for 3PL provider selection, we put forward basic principle of data integration, establish comprehensive evaluation model of 3PL supplier based on interval satisfaction, and give a kind of interval data weighted fuzzification method; furthermore, starting from the structural feature of fuzzy information, we propose the compound quantification description mode based on centralized quantification value, and establish a fuzzy information comparison method based on synthesizing effect and 3PL supplier selection model, and also analyze the feature through real case. All the results indicate that the 3PL supplier selection model proposed can effectively merge decision preference into decision process and has better operability. ©2009 IEEE.},
 author = {Mi, Xiang-Yun and Wang, Zhan-Jing and Jin, Chen-Xia},
 doi = {10.1109/ICMLC.2009.5212638},
 journal = {Proceedings of the 2009 International Conference on Machine Learning and Cybernetics},
 note = {Cited by: 7},
 pages = {2663 - 2668},
 publication_stage = {Final},
 source = {Scopus},
 title = {Selection method of the 3PL supplier based on interval satisfaction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70350707785?origin=resultslist},
 volume = {5},
 year = {2009}
}
