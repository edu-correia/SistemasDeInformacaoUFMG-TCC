@article{Yang20236147,
 abstract = {The COVID-19 pandemic has accelerated the transformation of education forms, and the combination of online and offline teaching has become the core development direction of university teaching at present and in the future. Therefore, appropriate teaching space is urgently needed to support the practice of blended teaching. Firstly, this paper introduces the practice of intelligent teaching space supporting blended teaching and analyzes its existing problems in China. Secondly, aiming at these problems and the new characteristics of blended teaching development, this paper designs the system architecture of the intelligent teaching space, and applied it to the construction of “Learning in ZJU” in Zhejiang University. Finally, the paper presents a variety of blended teaching cases of “Learning in ZJU” and their application effects, and analyzes them by SWOT. The SWOT analysis shows that the system architecture of the intelligent teaching space has advantages in the blended teaching application of space, time, method, evaluation and analysis. It can provide reference for the construction of intelligent teaching space and the application of blended teaching in other universities. © 2022 Informa UK Limited, trading as Taylor & Francis Group.},
 author = {Yang, Yuhui and Zhang, Hao and Chai, Huifang and Xu, Wei},
 doi = {10.1080/10494820.2022.2028857},
 journal = {Interactive Learning Environments},
 note = {Cited by: 20},
 number = {10},
 pages = {6147 - 6164},
 publication_stage = {Final},
 source = {Scopus},
 title = {Design and application of intelligent teaching space for blended teaching},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85123480018?origin=resultslist},
 volume = {31},
 year = {2023}
}
