@article{LONG2025,
 abstract = {In this work, by combining the energetic -NN-, -NO2, and N-NH2/N-NHNO2 groups with triazole, N-amino compound 3 and N-nitramino compound 4 were synthesized. Compound 3 has a unique crystal structure, exhibiting enhanced energetic properties (V = 8996 m s–1, and P = 34.0 GPa) and stability (T d = 202 °C, IS = 21 J, and FS = 216 N) comparable to that of hexogen (RDX). Compound 4 exhibits a high density (1.91 g cm–3) and excellent detonation performance (V = 9627 m s–1, and P = 41.0 GPa), and hydroxylammonium salt 5b exhibits exceedingly excellent detonation performance (V = 9677 m s–1, and P = 41.3 GPa).},
 author = {Yangyang Long and Dongshuai Su and Hui Zhang and Yingqi Xia and Qi Lai and Ping Yin and Siping Pang},
 doi = {https://doi.org/10.1021/acs.orglett.5c03115},
 issn = {1523-7060},
 journal = {Organic Letters},
 title = {Pushing the Performance Boundaries of Highly Energetic Bis(1,2,4-triazoles) through Merging Dual Strategies of C‑Azo Bridging and N‑Nitramino Functionalization},
 url = {https://www.sciencedirect.com/science/article/pii/S1523706025016220},
 year = {2025}
}
