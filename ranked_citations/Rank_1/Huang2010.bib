@conference{Huang2010,
 abstract = {In this paper, a new method to fuse SAR and Multi-spectral images based on Contourlet- HIS transform to increase the interpretability of SAR image, because Contourlet transform could makes up the defects that two-dimensional wavelet transform can not capture the spatial details of the image effectively. TM multi-spectral images and ERS-2 SAR image are used to fuse in order to evaluate the effect of the proposed method. At last, the fusion results are compared visually and statistically. The evaluation shows that better performance could be obtained by the method proposed in this paper than those methods based on stand-alone HIS transform and DWT-HIS transform. © 2010 IEEE.},
 author = {Huang, Dengshan and Yang, Minhua},
 doi = {10.1109/WICOM.2010.5601039},
 journal = {2010 6th International Conference on Wireless Communications, Networking and Mobile Computing, WiCOM 2010},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {SAR and Multi-spectral images fusion based on Contourlet and HIS transform},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78549288895?origin=resultslist},
 year = {2010}
}
