@article{MAVALURU2024104132,
 abstract = {This research work explores the integration of medical and information technology, particularly focusing on the use of data analytics and deep learning techniques in medical image processing. Specifically, it addresses the diagnosis and prediction of fetal conditions, including Down Syndrome (DS), through the analysis of ultrasound images. Despite existing methods in image segmentation, feature extraction, and classification, there is a pressing need to enhance diagnostic accuracy. Our research delves into a comprehensive literature review and presents advanced methodologies, incorporating sophisticated deep learning architectures and data augmentation techniques to improve fetal diagnosis. Moreover, the study emphasizes the clinical significance of accurate diagnostics, detailing the training and validation process of the AI model, ensuring ethical considerations, and highlighting the potential of the model in real-world clinical settings. By pushing the boundaries of current diagnostic capabilities and emphasizing rigorous clinical validation, this research work aims to contribute significantly to medical imaging and pave the way for more precise and reliable fetal health assessments.},
 author = {Dinesh Mavaluru and Sahithya Ravali Ravula and Jerlin Priya Lovelin Auguskani and Santhi Muttipoll Dharmarajlu and Amutha Chellathurai and Jayabrabu Ramakrishnan and Bharath Kumar Mamilla Mugaiahgari and Nadana Ravishankar},
 doi = {https://doi.org/10.1016/j.medengphy.2024.104132},
 issn = {1350-4533},
 journal = {Medical Engineering & Physics},
 keyword = {Ultrasound image analysis, Deep learning in medical diagnostics, Image enhancement techniques, Fetal anomaly detection, Down syndrome early diagnosis, Ethical considerations in AI, Transfer learning in healthcare},
 pages = {104132},
 title = {Advancing fetal ultrasound diagnostics: Innovative methodologies for improved accuracy in detecting down syndrome},
 url = {https://www.sciencedirect.com/science/article/pii/S135045332400033X},
 volume = {126},
 year = {2024}
}
