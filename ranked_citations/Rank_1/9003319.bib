@inproceedings{9003319,
 abstract = {The resistance to attacks on a key of code cryptosystems based on the merging of generating matrices of u(∈ ℕ) linear [ni, k, di]q-codes Ci(⊆ Fqn(i)), i = 1, ..., u, are considered. The resistance of such cryptosystems in particular is based on the assumption that for u ≥ 2 in the public key matrix G̃ it is computationally difficult to find such (k × ni)-submatrices composed of ni columns of the matrix G̃, which would be generating matrices of codes permutably equivalent to the codes Ci, i = 1, ..., u. In the present paper an algorithm is constructed which can be used to efficiently find such submatrices when a number of easily verified conditions are met. It is shown that the constructed algorithm can be used to clarify the strength of the Sidelnikov cryptosystem and its modification for u = 2.},
 author = {Deundyak, V.M. and Kosolapov, Yu.V.},
 booktitle = {2019 XVI International Symposium "Problems of Redundancy in Information and Control Systems" (REDUNDANCY)},
 doi = {10.1109/REDUNDANCY48165.2019.9003319},
 issn = {},
 keyword = {Decoding;Public key cryptography;Redundancy;Linear codes;Merging},
 month = {Oct},
 number = {},
 pages = {143-148},
 title = {On the strength of asymmetric code cryptosystems based on the merging of generating matrices of linear codes},
 volume = {},
 year = {2019}
}
