@article{Sala2020719,
 abstract = {This article presents a new stochastic computational model for determining freeway capacity reduction as a result of lane-changing activity. The probability density function for the maximum flow that can be sustained on a freeway for a given lane-changing level is obtained. The results can be used to support freeway management strategies aiming to mitigate the negative consequences of lane-changing in freeway capacity. A pilot test using empirical data obtained from the B-23 freeway accessing the city of Barcelona proves the validity of the modeling approach. © 2020 Computer-Aided Civil and Infrastructure Engineering},
 author = {Sala, Marcel and Soriguera, Francesc},
 doi = {10.1111/mice.12529},
 journal = {Computer-Aided Civil and Infrastructure Engineering},
 note = {Cited by: 7; All Open Access; Green Open Access},
 number = {7},
 pages = {719 - 733},
 publication_stage = {Final},
 source = {Scopus},
 title = {Lane-changing and freeway capacity: A Bayesian inference stochastic model},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85077865928?origin=resultslist},
 volume = {35},
 year = {2020}
}
