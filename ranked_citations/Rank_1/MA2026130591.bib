@article{MA2026130591,
 abstract = {Retinal vessel segmentation plays a pivotal role in the precise diagnosis and treatment of ophthalmic diseases. However, existing methods frequently suffer from feature degradation during the encoding stage, insufficient modeling of the multiscale complexity inherent in retinal vasculature, and inadequate contextual information integration during decoding. These limitations substantially hinder the accurate extraction of fine-scale vessels, particularly in anatomically complex regions. To address these challenges, we propose VasCA-Net, an innovative architecture tailored for retinal vessel segmentation. During encoding, an EConv module is introduced to enhance information propagation and alleviate feature degradation caused by progressive downsampling, thereby enabling more effective preservation of critical vascular features. To capture the pronounced scale variations present in retinal vessels, we design a Multi-Scale Channel Attention (MSCA) mechanism that employs convolutional kernels of varying sizes to adaptively extract multiscale representations, achieving robust characterization of both major vessels and thin capillaries. In the decoding phase, the DConv module integrates low-level spatial details with high-level semantic information, effectively bridging the semantic gap and improving the delineation of fine vascular structures while maintaining global contextual coherence. Experimental evaluations on three publicly available datasets-DRIVE, STARE, and CHASEDB1-demonstrate that VasCA-Net surpasses state-of-the-art methods, achieving superior specificity (0.9902 on STARE and 0.9905 on CHASEDB1) and F1 scores (0.8301 on DRIVE, 0.8311 on STARE, and 0.8354 on CHASEDB1). These findings validate the effectiveness of the proposed model and highlight its potential to advance clinical diagnosis and therapeutic decision-making in retinal disease management.},
 author = {Zhendi Ma and Xiaobo Li and Yuxin Zhao and Hui Wang},
 doi = {https://doi.org/10.1016/j.eswa.2025.130591},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Attention mechanism, Dconv block, Econv block, VasCA-Net, Retinal vessel segmentation},
 pages = {130591},
 title = {VasCA-Net: A vascular channel attention network for retinal vessel segmentation},
 url = {https://www.sciencedirect.com/science/article/pii/S095741742504206X},
 volume = {303},
 year = {2026}
}
