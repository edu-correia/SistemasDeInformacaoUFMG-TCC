@article{Abubahia201712205,
 abstract = {Dramatic advancements in Geographic Information Systems (GIS) and computer technologies resulted in a wide availability of rich-knowledge GIS digital vector maps that are easily accessible and downloadable through the world wide web. This led to the need of copyright protection systems to protect the rights of the producers of these maps. Unlike the research on copyright protection for raster/image data types, the research for vector map data is less documented. This article surveys and classifies the GIS vector map copyright protection research papers published between 2000 and 2014, towards a thorough understanding of the-state-of-the-art, addressing significant limitations of previous review articles, and outlining effective recommendations for future research directions. © 2016, The Author(s).},
 author = {Abubahia, Ahmed and Cocea, Mihaela},
 doi = {10.1007/s11042-016-3441-z},
 journal = {Multimedia Tools and Applications},
 note = {Cited by: 46; All Open Access; Green Open Access; Hybrid Gold Open Access},
 number = {10},
 pages = {12205 - 12231},
 publication_stage = {Final},
 source = {Scopus},
 title = {Advancements in GIS map copyright protection schemes - a critical review},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84964308709?origin=resultslist},
 volume = {76},
 year = {2017}
}
