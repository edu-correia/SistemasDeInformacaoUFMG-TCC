@article{ALIKHANI2024113301,
 abstract = {We report the electrochemical characteristics of honeycomb borophene (HB) heterostructure with various MXenes, including Ti3C2O2, Ti3C2F2, and Ti3C2(OH)2. The stability of these heterostructures is also investigated. Our approach involves utilizing joint density functional theory to merge electronic DFT with a solution model (CANDLE) for simulating immersed electrodes in a 1 M NaF electrolyte. We obtain the quantum capacitance, an essential component of total capacitance in 2D materials, as well as integral and differential capacitance. Furthermore, we determine adsorbed charges on surfaces and stored energies. Our findings demonstrate that bare HB exhibits superior performance as a supercapacitor compared to individual MXenes, and its capacity can be notably improved by integrating with Ti3C2(OH)2 by more than 30%.},
 author = {Mohammadreza Alikhani and Soheil Hajibaba and Mohsen Moayedi and Yaser Abdi},
 doi = {https://doi.org/10.1016/j.est.2024.113301},
 issn = {2352-152X},
 journal = {Journal of Energy Storage},
 keyword = {Borophene, MXene, 2D materials, Heterostructures, Supercapacitor, Energy storage, Computational materials, Density functional theory, JDFT},
 pages = {113301},
 title = {Borophene–MXene heterostructures as supercapacitor},
 url = {https://www.sciencedirect.com/science/article/pii/S2352152X24028871},
 volume = {99},
 year = {2024}
}
