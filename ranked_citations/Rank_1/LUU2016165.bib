@article{LUU2016165,
 abstract = {We present a new particle-merging algorithm for the particle-in-cell method. Based on the concept of the Voronoi diagram, the algorithm partitions the phase space into smaller subsets, which consist of only particles that are in close proximity in the phase space to each other. We show the performance of our algorithm in the case of the two-stream instability and the magnetic shower.},
 author = {Phuc T. Luu and T. Tückmantel and A. Pukhov},
 doi = {https://doi.org/10.1016/j.cpc.2016.01.009},
 issn = {0010-4655},
 journal = {Computer Physics Communications},
 keyword = {Particle merging, PIC, Voronoi, Clustering, Two-stream instability, Magnetic shower, QED cascade},
 pages = {165-174},
 title = {Voronoi particle merging algorithm for PIC codes},
 url = {https://www.sciencedirect.com/science/article/pii/S001046551600028X},
 volume = {202},
 year = {2016}
}
