@conference{Yang2014123,
 abstract = {In this paper, we propose a novel method for high dynamic environment sequence sampling. Without future frame information, our approach achieves temporal coherence by mapping sampling information from previous frame to current frame based on temporal superpixels. However, temporal superpixels have unbalanced importance for rendering, although light regions in environment sequences can be tracked across frames. To solve this issue, we develop an adaptive merge-and-split scheme to adjust sample segments to achieve a more importance-balanced sample distribution. Compared with several state-of-the-art methods, our approach gets consistently improved rendering quality across environment sequences. Experiment results also show decent temporal coherence of our approach in sequence rendering. 2014 Copyright held by the Owner/Author. Publication rights licensed to ACM.},
 author = {Yang, Ying and Yu, Changguo and Wan, Liang and Feng, Wei},
 doi = {10.1145/2670473.2670478},
 journal = {Proceedings - VRCAI 2014: 13th ACM SIGGRAPH International Conference on Virtual-Reality Continuum and Its Applications in Industry},
 note = {Cited by: 1},
 pages = {123 - 131},
 publication_stage = {Final},
 source = {Scopus},
 title = {High dynamic environment sequence sampling},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84920589855?origin=resultslist},
 year = {2014}
}
