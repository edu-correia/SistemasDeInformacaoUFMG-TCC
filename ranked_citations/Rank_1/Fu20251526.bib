@article{Fu20251526,
 abstract = {With the rapid development of intelligent vehicle (IV) technology, this field has gradually become the focus of attention in both the academic and industrial communities. This study has conducted a comprehensive bibliometric and collaboration network analysis on all papers published since the inception of the IEEE Transactions on Intelligent Vehicles (TIV). The analysis reveals that the research field of intelligent vehicles (IVs) is primarily led by scholars and institutions from China, with the USA and Germany following closely as the second and third most productive countries. The study also identifies Fei-Yue Wang and Mohan Manubhai Trivedi as the most productive and influential authors in TIV, while Tsinghua University, the University of California, San Diego, and Nanyang Technological University are the institutions with the greatest research productivity and influence. By constructing co-authorship network, co-keyword network, and author co-keyword, this research further analyzes the collaborative patterns within the field of IVs. Lastly, a comprehensive analysis of the important academic journals in the intelligent transportation system field outlines the leading countries and popular research themes.  © 2024 IEEE.},
 author = {Fu, Tiange and Yan, Jun and Ren, Shenyuan and Zhang, Hui and Wang, Yutong and Tian, Yonglin and Luo, Guiyang},
 doi = {10.1109/TIV.2024.3429239},
 journal = {IEEE Transactions on Intelligent Vehicles},
