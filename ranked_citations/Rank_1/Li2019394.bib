@article{Li2019394,
 abstract = {Nuclear segmentation is important and frequently demanded for pathology image analysis, yet is also challenging due to nuclear crowdedness and possible occlusion. In this paper, we present a novel bottom-up method for nuclear segmentation. The concepts of Center Mask and Center Vector are introduced to better depict the relationship between pixels and nuclear instances. The instance differentiation process are thus largely simplified and easier to understand. Experiments demonstrate the effectiveness of Center Vector Encoding, where our method outperforms state-of-the-arts by a clear margin. © 2019, Springer Nature Switzerland AG.},
 author = {Li, Jiahui and Hu, Zhiqiang and Yang, Shuang},
 doi = {10.1007/978-3-030-20351-1_30},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 12},
 pages = {394 - 404},
 publication_stage = {Final},
 source = {Scopus},
 title = {Accurate Nuclear Segmentation with Center Vector Encoding},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85066128560?origin=resultslist},
 volume = {11492 LNCS},
 year = {2019}
}
