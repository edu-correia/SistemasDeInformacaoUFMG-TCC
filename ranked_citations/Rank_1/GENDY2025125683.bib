@article{GENDY2025125683,
 abstract = {The single image super-resolution (SISR) task much consideration in the last few years. There are many image SR models that are developed based on advanced deep learning methods. However, these models extract features in image space limiting the ability to extract short and long dependencies. To solve this limitation, a graph mixer block (GMB) is designed based on merging the dynamic graph message passing network (DGMN) with the convolution mixer (ConvMix) for the task of image super-resolution (SR). By utilizing the designed GMB block and the concept of residual learning, we developed a graph mixer network (GMN) for SISR. The idea of this model is the integration to benefit from both types of graph features and traditional convolution features. Combining these features allows the model to capture both global graph structure and local patterns, leading to more comprehensive and expressive representations. The function of the DGMN is used to capture long-range structured relationships with efficient weight modules. This DGMN is conditioned on the input to make adaptively sampling nodes in the graph used for message passing. Then, the ConvMix is used to extract additional features that not is extracted by DGMN modules based on channel and spatial mixing. The ConvMix is designed based on using two depthwise convolutions with one pointwise convolution. The result shows that our GMN attained state-of-the-art results in multiple SR benchmarks},
 author = {Garas Gendy and Jingchao Hou and Nabil Sabor and Guanghui He},
 doi = {https://doi.org/10.1016/j.eswa.2024.125683},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Image super-resolution, Graph neural network, Convolution mixer, Dynamic graph message passing, Channel and spatial mixing},
 pages = {125683},
 title = {Lightweight image super-resolution network based on dynamic graph message passing and convolution mixer},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417424025508},
 volume = {263},
 year = {2025}
}
