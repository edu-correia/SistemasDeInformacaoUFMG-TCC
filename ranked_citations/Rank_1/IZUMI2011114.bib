@article{IZUMI2011114,
 abstract = {MicroRNA (miR)s are short non-coding RNAs that suppress the translation of target genes, and play an important role in gene regulation. Despite this prominence, there are few reports that refer to the expression of miRs after spinal cord injury (SCI). Previously, we reported on miR-223 expression after SCI in mice. The purpose of this study is to reveal the distribution of miR-223 and identify the cells that express miR-223 in the injured spinal cord. Quantitative polymerase chain reaction analysis revealed high expression of miR-223 at 12h after SCI. Double staining of in situ hybridization and immunohistochemistry showed that the signals of miR-223 merged with Gr-1 positive neutrophils. Our data indicate that miR-223 might regulate neutrophils in the early phase after SCI.},
 author = {Bunichiro Izumi and Tomoyuki Nakasa and Nobuhiro Tanaka and Kazuyoshi Nakanishi and Naosuke Kamei and Risako Yamamoto and Toshio Nakamae and Ryo Ohta and Yuki Fujioka and Keiichiro Yamasaki and Mitsuo Ochi},
 doi = {https://doi.org/10.1016/j.neulet.2011.01.068},
 issn = {0304-3940},
 journal = {Neuroscience Letters},
 keyword = {Spinal cord injury, MicroRNA, MicroRNA-223, Neutrophil, Inflammatory response},
 number = {2},
 pages = {114-118},
 title = {MicroRNA-223 expression in neutrophils in the early phase of secondary damage after spinal cord injury},
 url = {https://www.sciencedirect.com/science/article/pii/S0304394011001145},
 volume = {492},
 year = {2011}
}
