@conference{Rajagopalan2025,
 abstract = {DishDelight is a smart culinary application developed to merge traditional Indian culinary wisdom with modern technological innovations. The project addresses the increasing gap between traditional cooking methods and the modern lifestyle by providing users with features such as AI-driven vegetable identification using deep learning models, millet-based recipe recommendations, and a structured repository of Grandma's traditional home remedies. A dataset of 8,441 images spanning 29 vegetable classes was used to train and evaluate three prominent convolutional neural network architectures: ResNet18, EfficientNet-B0, and DenseNet121. One of the standout features is the intelligent multi-vegetable recipe recommendation system, where users can upload up to five vegetables. The system dynamically displays recipes containing all the selected vegetables, then recipes with additional ingredients, and finally, individual vegetable-based recipes. The application also includes interactive features such as recipe uploads, chef verification, and a quiz module to enhance user engagement. DishDelight aims to serve as a one-stop culinary solution that promotes healthy dietary habits, preserves traditional knowledge, and provides an intelligent and user-friendly cooking experience.  © 2025 IEEE.},
 author = {Rajagopalan, Srinidhi and Harshitha, M.},
 doi = {10.1109/CSITSS67709.2025.11295144},
 journal = {2025 9th International Conference on Computational System and Information Technology for Sustainable Solutions, CSITSS 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {DishDelight: Your Friendly Indian Culinary Assistant},
 type = {Conference paper},
