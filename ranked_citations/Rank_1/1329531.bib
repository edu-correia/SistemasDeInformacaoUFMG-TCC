@inproceedings{1329531,
 abstract = {We propose a new quick and effective buffered legitimate skew clock routing algorithm BLST. We analyze the optimal buffer position in the clock path, and conclude the sufficient and heuristic condition for buffer insertion in clock net. During the routing process, this algorithm integrates topology generation, buffer insertion, and node merge together, and performs them parallel. Compared with the method of X. Zheng et al. (1999) of buffer insertion after skew clock routing, BLST improves the maximal clock delay by at least 22%. Compared with legitimate skew clock routing algorithm of M. Zhao et al. (2003) with no buffer, this algorithm further decreases the total wire length and gets from 42% to 82% reduction on the maximal clock delay. The experimental results show our algorithm is quick and effective.},
 author = {Meng Zhao and Xinjie Wei and Yici Cai and Xianlong Hong},
 booktitle = {2004 IEEE International Symposium on Circuits and Systems (ISCAS)},
 doi = {10.1109/ISCAS.2004.1329531},
 issn = {},
 keyword = {Clocks;Routing;Delay;Wire;Topology;Very large scale integration;Scheduling;Algorithm design and analysis;Capacitance;Computer science},
 month = {May},
 number = {},
 pages = {V-V},
 title = {Quick and effective buffered legitimate skew clock routing},
 volume = {5},
 year = {2004}
}
