@article{Brandão2018_351,
 abstract = {Abstract This work reports a dual-band radar system composed of aphotonics-based transceiver and a unique dual-band antenna. The proposed antenna consists of an integration of conventional focal-point and Cassegrain parabolic antennas in the same structure, ensured by using a subreflector based on a frequency selective surface. Numerical and experimental results in terms of the antenna reflection coefficient, radiation pattern and gain are reported with excellent agreement over both frequency ranges. The innovative dual-band photonics-based radar transceiver operates simultaneously in the S- and X-bands. The radar system has been properlyvalidated by multiple detections of helicopters and airplanes in real conditions.},
 author = {Brandão, T. H. and Filgueiras, H.R.D. and Alves, A. A. C. and Scotti, F. and Melo, S. and Bogoni, A. and Arismar Cerqueira Jr., S.},
 doi = {10.1590/2179-10742018v17i41545},
 number = {4},
 pages = {567--578},
 title = {Dual-band System composed by a Photonics-based Radar and a Focal-Point/Cassegrain Parabolic Antenna},
 volume = {17},
 year = {2018}
}
