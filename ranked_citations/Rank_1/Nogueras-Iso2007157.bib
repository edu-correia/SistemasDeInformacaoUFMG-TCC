@article{Nogueras-Iso2007157,
 abstract = {In order to create the contents of an address gazetteer service that forms part of a city council Spatial Data Infrastructure, all the existent repositories containing address information in the different council offices must be analyzed and harmonized. The problem is that usually these repositories are constrained by the use of different taxonomies for the identification of urban network feature types. The objective of this work will be to describe how to establish a formal ontology enabling the interoperability among the different taxonomies, and facilitating the construction of the gazetteer contents. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Nogueras-Iso, J. and López, F.J. and Lacasta, J. and Zarazaga-Soria, F.J. and Muro-Medrano, P.R.},
 doi = {10.1007/978-3-540-71976-2_14},
 journal = {Studies in Computational Intelligence},
 note = {Cited by: 3},
 pages = {157 - 167},
 publication_stage = {Final},
 source = {Scopus},
 title = {Building an address Gazetteer on top of an urban network ontology},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/34249042868?origin=resultslist},
 volume = {61},
 year = {2007}
}
