@inproceedings{7856409,
 abstract = {A number of data-intensive systems require using random hash-based indexes of various forms, e.g., hash tables, Bloom filters, and locality sensitive hash tables. In this paper, we present general SSD optimization techniques that can be used to design a variety of such indexes while ensuring higher performance and easier tunability than specialized state-of-the-art approaches. We leverage two key SSD innovations: a) rearranging the data layout on the SSD to combine multiple read requests into one page read, and b) intelligently reordering requests to exploit inherent parallelism in the architecture of SSDs. We build three different indexes using these techniques, and we conduct extensive studies showing their superior performance, lower CPU/memory footprint, and tunability compared to state-of-the-art systems.},
 author = {Anand, Ashok and Gember-Jacobson, Aaron and Engstrom, Collin and Akella, Aditya},
 booktitle = {2014 ACM/IEEE Symposium on Architectures for Networking and Communications Systems (ANCS)},
 doi = {},
 issn = {},
 keyword = {Indexes;Parallel processing;Data structures;Memory management;Measurement;Optimization;Wide area networks;Solid state drives (SSDs);hashtables;bloom filters;memory efficiency;CPU efficiency;parallelism},
 month = {Oct},
 number = {},
 pages = {149-160},
 title = {Design patterns for tunable and efficient SSD-based indexes},
 volume = {},
 year = {2014}
}
