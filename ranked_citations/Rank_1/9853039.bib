@inproceedings{9853039,
 abstract = {The information has gained a big boom during cyber world. Hiding text into an image or adding a payload to the image is known as steganography. Steganography started in BC when the rulers send hidden text from one place to another. Steganography combines data compression, cryptography technologies to fulfill the need for privacy on the internet. Steganography (by definition) is the hiding of one file within another. In this paper, we have used the concept of image steganalysis which helps us to detect the image that is hidden within an image. This paper attempts to use image steganalysis with image decoder using LSB and MSB technique and analysis of various steganography techniques used in today's world.},
 author = {Chhabra, Abhishek and Shruti and Woeden, Tenzin and Singh, Dalwinder and Rakhra, Manik and Dahiya, Omdev and Gupta, Aditya},
 booktitle = {2022 3rd International Conference on Intelligent Engineering and Management (ICIEM)},
 doi = {10.1109/ICIEM54221.2022.9853039},
 issn = {},
 keyword = {Steganography;Data privacy;Merging;Data compression;Distortion;Decoding;Payloads;Steganography;Cryptography;Image decoder;Steg analyzer;crmiLTP (Local Texture Pattern);MSB (Most Significant Bit);LSB (Least Significant Bit)},
 month = {April},
