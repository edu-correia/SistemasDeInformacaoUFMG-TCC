@article{10.1007/s00165-005-0063-z,
 abstract = {Modal transition systems specify sets of implementations, their refining labelled transition systems, through Larsen &amp; Thomsen’s co-inductive notion of refinement. We demonstrate that refinement precisely captures the identification of a modal transition system with its set of implementations: refinement is reverse containment of sets of implementations. This result extends to models that combine state and event observables and is drawn from a SFP-domain whose elements are equivalence classes of modal transition systems under refinement [HJS04], and abstraction-based finite-model properties proved in this paper. As a corollary, validity checking is model checking for Hennessy-Milner formulas that characterize modal transition systems with bounded computation paths. We finally sketch how techniques developed in this paper can be used to detect inconsistencies between multiple modal transition systems and, if consistent, to verify properties of all common implementations.},
 address = {Berlin, Heidelberg},
 author = {Huth, Michael},
 doi = {10.1007/s00165-005-0063-z},
 issn = {0934-5043},
 issue_date = {Aug 2005},
 journal = {Form. Asp. Comput.},
 keyword = {Model checking, Refinement, Modal transition systems, Implementation relation},
 month = {August},
 number = {2},
 numpages = {25},
 pages = {113–137},
 publisher = {Springer-Verlag},
 title = {Refinement is complete for implementations},
 url = {https://doi.org/10.1007/s00165-005-0063-z},
 volume = {17},
 year = {2005}
}
