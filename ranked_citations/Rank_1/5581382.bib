@inproceedings{5581382,
 abstract = {In Personal Dataspace (PDS), documents containing a lot of useful information play an important role in our daily work. However, it is difficult to manage the information in these documents efficiently. In this paper, we first extract some frequent terms from documents, and then cluster these documents based on the terms. Thus users can query the documents based on their contents conveniently. The experiments demonstrate the accuracy and efficiency of the key techniques in our approach.},
 author = {Liu, Debao and Yang, Dan and Nie, Tiezheng and Kou, Yue and Shen, Derong},
 booktitle = {2010 Seventh Web Information Systems and Applications Conference},
 doi = {10.1109/WISA.2010.16},
 issn = {},
 keyword = {Clustering algorithms;Data mining;Contracts;Algorithm design and analysis;Databases;Classification algorithms;Merging;dataspaces;document clustering;FP-tree},
 month = {Aug},
 number = {},
 pages = {9-12},
 title = {Document Clustering in Personal Dataspace},
 volume = {},
 year = {2010}
}
