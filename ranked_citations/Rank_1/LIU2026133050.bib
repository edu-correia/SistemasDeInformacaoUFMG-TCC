@article{LIU2026133050,
 abstract = {Fatigue properties of ignition resistant coating and its effect on the fatigue properties of titanium alloy substrate are the key problems that limit its application. However, the effect of thermal barrier coatings (TBCs) on the fatigue characteristics of titanium alloys and its underlying mechanism have remained unclear. In this paper, the fatigue failure of TBCs with an abradable bentonite top coat and its effect on the titanium alloy substrate are investigated. Tension-tension fatigue results indicate that TBCs cause a side effect on the fatigue behavior of TC11. Based on fracture surface, cross-sectional morphology and electron backscatter diffraction (EBSD) analysis, coating crack appeared ahead of TC11 substrate. Furthermore, the interface structure fluctuations caused by the preparation process of TBCs coating result in stress concentration in the ZrO2 layer, causing fatigue cracks to originate in the ZrO2 layer. Subsequently, the fatigue cracks merge with the cracks in the ZrO2 layer, pass through the NiCrAl layer, and propagate to the substrate, accelerating the fatigue damage of the substrate. Finally, by introducing ductile Cr or Ni metal layers into TBCs, the fatigue crack propagation of ZrO2 layer can be effectively suppressed, the fatigue resistance of TBCs can be improved, and the fatigue damage of TBCs coating to the substrate can be alleviated.},
 author = {Shaobo Liu and Yao Zhang and Shunlai Zang and Zhaolu Zhang},
 doi = {https://doi.org/10.1016/j.surfcoat.2025.133050},
 issn = {0257-8972},
 journal = {Surface and Coatings Technology},
 keyword = {Thermal barrier coating, Fatigue performance, Crack propagation inhibition},
 pages = {133050},
 title = {Effect of ignition resistance thermal barrier coatings on the fatigue properties of titanium alloys},
 url = {https://www.sciencedirect.com/science/article/pii/S0257897225013246},
 volume = {520},
 year = {2026}
}
