@article{TANG2025137988,
 abstract = {Dielectric fluids, including polymers, oils, and organic solvents, are integral to applications such as microreactors, optical devices, and thermal management systems due to their stability and resistance to evaporation. However, precise manipulation of dielectric droplets, especially those with high viscosity, remains challenging due to low surface tension and small contact angles. This study introduces a novel corona discharge-driven platform designed for the precise formation, transport, and control of dielectric droplets on one-dimensional copper wires. Utilizing dual needle-tip electrodes, the system generates localized electric fields that facilitate non-contact charge deposition, enabling reliable manipulation of droplets with viscosities up to 30,000 cSt. Comprehensive experiments demonstrate synchronized droplet movement with electrode motion, effective handling of complex geometries, and advanced operations such as droplet merging and splitting. Moreover, dielectric droplets are utilized as micro-containers for performing on-droplet chemical and biological assays. The platform also enables efficient aspiration and release of high-viscosity dielectric fluids, surpassing the capabilities of conventional pipette-based methods. These results highlight the platform’s robustness, versatility, and strong potential for integration into next-generation microfluidic and lab-on-a-chip systems.},
 author = {Qiang Tang and Manfei Liu and Dengqin Tan and Yan Wang and Ziyi Wang and Xiaxia Cui and Jia-Han Zhang and Chengjun Wang and Changguo Xue},
 doi = {https://doi.org/10.1016/j.snb.2025.137988},
 issn = {0925-4005},
 journal = {Sensors and Actuators B: Chemical},
 keyword = {Corona discharge, High-viscosity fluids, Droplet manipulation, Droplet-based microreactor},
 pages = {137988},
 title = {Corona discharge-driven platform for precise manipulation of high-viscosity dielectric droplets on copper wires},
 url = {https://www.sciencedirect.com/science/article/pii/S0925400525007646},
 volume = {442},
 year = {2025}
}
