@inproceedings{10689175,
 abstract = {An effective node selection criterion (NSC) is paramount for the efficient reduction of networks in power systems. Unlike prior studies that primarily focus on structural attributes, this paper introduces a comprehensive NSC that encompasses both structural and electrical characteristics. This NSC is formulated using the evidential reasoning approach. Within this framework, quasi-one-hot encoding plays a pivotal role in establishing the evaluation grades for various criteria and attributes. Subsequent integration of these criteria is achieved through multi-evidence reasoning. Ultimately, a utility evaluation refines this into a definitive, quantitative NSC. The evidential reasoning can accommodate multiple criteria and address inherent uncertainties in the evaluation process. By merging the proposed NSC with existing model reduction techniques, more accurate reduced models can be derived. Case studies based on a standard power grid corroborate the applicability and effectiveness of the proposed NSC.},
 author = {Huang, Bin and Li, Jiayong and Guo, Han and Wang, Jianhui},
 booktitle = {2024 IEEE Power & Energy Society General Meeting (PESGM)},
 doi = {10.1109/PESGM51994.2024.10689175},
 issn = {1944-9933},
 keyword = {Uncertainty;Merging;Decision making;Complex networks;Electric variables;Cognition;Reduced order systems;Power grids;Encoding;Standards;complex networks;evidential reasoning;network reduction;multi-attribute decision-making},
 month = {July},
 number = {},
 pages = {1-5},
 title = {Evidential Reasoning for Enhanced Node Selection in Power Network Reduction: a Complex Network Perspective},
 volume = {},
 year = {2024}
}
