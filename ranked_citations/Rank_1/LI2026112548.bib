@article{LI2026112548,
 abstract = {Voltage control in integrated photovoltaic systems (PVS) and voltage control systems (VCS) faces significant challenges, such as convergence speed, chattering phenomenon, and tracking accuracy, within the sliding mode control (SMC) family of controllers. The presented study provides a novel controller, the Terminal Reaching Law-Based Fast Integral Sliding Mode Control (TRL-FITSMC), regarding an adaptive mechanism designed to tackle the mentioned obstacles. The presented controller employs a new integrated terminal sliding surface that increases tracking accuracy while increasing convergence speed. Particularly, this sliding surface merges derivative and integral components, which raises convergence speed and tracking precision, respectively. Furthermore, the controller lowers chattering and increases convergence speed by utilizing an adaptive mechanism-driven terminal reaching law. The controller's design computes the time needed for the tracking error to reach the sliding surface and thus, reach zero from that surface. Laboratory tests were carried out to investigate the operation of the proposed approach. The results showed that the proposed method reduced the convergence time by between 0.5 and 1 s compared to other methods. The results also indicated that the root mean square error (RMSE) rate was reduced by between 0.2 and 0.4 volts using the proposed method. In addition, using the proposed method, the chattering phenomenon has been reduced by 5%.},
 author = {Jinhu Li and Hanbin Ma and Qingsheng Liu and Lingting Wu and Feng Huang},
 doi = {https://doi.org/10.1016/j.epsr.2025.112548},
 issn = {0378-7796},
 journal = {Electric Power Systems Research},
 keyword = {Voltage control system, Photovoltaic unit, Fast integral terminal sliding surface, Terminal reaching law, Chattering, Speed convergence},
 pages = {112548},
 title = {Novel control strategy for voltage control system integrated with photovoltaic system using terminal reaching law-based fast integral terminal sliding mode concept},
 url = {https://www.sciencedirect.com/science/article/pii/S0378779625011356},
 volume = {253},
 year = {2026}
}
