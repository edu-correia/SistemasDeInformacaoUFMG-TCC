@inproceedings{9142093,
 abstract = {In the present information age, providing correct information to the query with a limited concept is a challenging task. The modern adaptive Information Retrieval (IR) system is needed to provide valid information. Ontology-based on IR can provide a better solution. Ontology is a perception of shared conceptualization, represented by classes, properties, and objects. Ontology mapping offers a solution to integrate inter-domain knowledge. This paper presents a method for using ontologies to handle inter-domain query in information retrieval. Using ontology in IR for Query Expansion (QE) and document ranking seems to be the ultimate goal. The Multi-Domain Specific Ontology Mapping (MDOM) proposes the concepts derived from ontology for query expansion and information retrieval. The result shows the improvement in terms of better document ranking.},
 author = {Ahamed, Bazeer and Najimaldeen, Razwan M.S. and Duraisamy, Yuvaraj},
 booktitle = {2020 International Conference on Computer Science and Software Engineering (CSASE)},
 doi = {10.1109/CSASE48920.2020.9142093},
 issn = {},
 keyword = {Ontologies;Semantics;Information retrieval;Computer science;Software engineering;Merging;Classification algorithms;Ontology;Query Expansion;Information Retrieval;Internet search},
 month = {April},
 number = {},
 pages = {56-60},
 title = {Enhancement Framework of Semantic Query Expansion Using Mapped Ontology},
 volume = {},
 year = {2020}
}
