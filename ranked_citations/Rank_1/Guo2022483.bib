@conference{Guo2022483,
 abstract = {With the advent of online chatting systems, conversation structure modeling has attracted increasing attention and can be beneficial to many downstream tasks such as topic summarization and dialog generation. Existing studies mainly focus on modeling the pairwise or thread-level text semantics in multiple interleaved conversations, and don't fully utilize the rich semantics such as the dialogue actions and speaker relationships. For this purpose, we propose to leverage broader semantics to better disentangle the conversations. Concretely, we devise a novel deep neural networks to capture the text contents, discourse structures and speaker attention in one framework, to better identify the utterance pairs with the 'reply-to' relationships. We evaluate our framework on two datasets, the publicly available Ubuntu IRC dataset and our proposed WeChat & QQ dataset. The results show that our model significantly outperforms the state-of-the-art baselines. © 2022 IEEE.},
 author = {Guo, Tuwen and Zhang, Xi and Qiu, Lirong},
 doi = {10.1109/DSC55868.2022.00073},
 journal = {Proceedings - 2022 7th IEEE International Conference on Data Science in Cyberspace, DSC 2022},
 note = {Cited by: 0},
 pages = {483 - 490},
 publication_stage = {Final},
 source = {Scopus},
 title = {Leveraging Multi-aspect Semantics for Conversation Structure Modeling},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85141421123?origin=resultslist},
 year = {2022}
}
