@conference{Titov20151,
 abstract = {We introduce a new approach to unsupervised estimation of feature-rich semantic role labeling models. Our model consists of two components: (1) an encoding component: a semantic role labeling model which predicts roles given a rich set of syntactic and lexical features; (2) a reconstruction component: a tensor factorization model which relies on roles to predict argument fillers. When the components are estimated jointly to minimize errors in argument reconstruction, the induced roles largely correspond to roles defined in annotated resources. Our method performs on par with most accurate role induction methods on English and German, even though, unlike these previous approaches, we do not incorporate any prior linguistic knowledge about the languages. © 2015 Association for Computational Linguistics.},
 author = {Titov, Ivan and Khoddam, Ehsan},
 doi = {10.3115/v1/n15-1001},
 journal = {NAACL HLT 2015 - 2015 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies, Proceedings of the Conference},
 note = {Cited by: 22; All Open Access; Gold Open Access; Green Open Access},
 pages = {1 - 10},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unsupervised induction of semantic roles within a reconstruction-error minimization framework},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84959928103?origin=resultslist},
 year = {2015}
}
