@article{WANG2025136931,
 abstract = {Interfacial coating has been regarded as an effective strategy for protecting zinc anode from dendrite growth and side reactions, thus improving the overall electrochemical performance of aqueous zinc ion battery. Herein, a novel Zn-(o-phenylenediamine) (O-Z) complex has been prepared for Zn anode protection, which has merged merits of organic coatings and metal/metal compounds coatings. O-Z coating presents good ionic conductivity and porous structure, which can modulate zinc ions flux and effectively control Zn plating/stripping. Owing to the abundant active groups of O-Z coating, it can promote the desolvation of zinc ions and accumulate plenty of zinc ions in the zinc anode interface, thus achieving a low nucleation resistance and uniform nucleation sites for zinc deposition. In addition, O-Z complex coating can effectively serve as a physical barrier for restraining the adverse side reactions and inhibiting the corrosion and passivation of zinc anode. O-Z@Zn anode demonstrates a long cycle life up to 2400 h with a low overpotential of 36 mV in the Zn symmetric cell. Furthermore, when an O-Z@Zn//V2O5 full cell is assembled, a high-capacity retention of 75 % is achieved over 1000 cycles at a current density of 1 A g–1. This work proposes a facile and low-cost strategy for the interface modification of zinc anode to realize long-cycled aqueous Zn-ion batteries.},
 author = {Jingtao Wang and Lin Liu and Jiahui Lu and Chengyin Wang and Tianyi Wang},
 doi = {https://doi.org/10.1016/j.colsurfa.2025.136931},
 issn = {0927-7757},
 journal = {Colloids and Surfaces A: Physicochemical and Engineering Aspects},
 keyword = {Aqueous zinc ion batteries, Zinc-(-phenylenediamine) complex, Zinc anode protection, Interfacial coating},
 pages = {136931},
 title = {Multifunctional Zn–complex as interfacial coating for constructing stable and dendrite-free Zn anodes},
 url = {https://www.sciencedirect.com/science/article/pii/S0927775725008349},
 volume = {718},
 year = {2025}
}
