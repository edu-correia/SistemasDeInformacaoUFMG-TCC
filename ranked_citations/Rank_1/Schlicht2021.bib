@conference{Schlicht2021,
 abstract = {Health misinformation on search engines is a significant problem that could negatively affect individuals or public health. To mitigate the problem, TREC organizes a health misinformation track. This paper presents our submissions to this track. We use a BM25 and a domain-specific semantic search engine for retrieving initial documents. Later, we examine a health news schema for quality assessment and apply it to re-rank documents. Finally, we merge the scores from the different components by using reciprocal rank fusion. Finally, we discuss the results and conclude with future works. © TREC 2021.All rights reserved.},
 author = {Schlicht, Ipek Baris and de Paula, Angel Felipe Magnossão and Rosso, Paolo},
 journal = {30th Text REtrieval Conference, TREC 2021 - Proceedings},
 note = {Cited by: 4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {UPV at TREC Health Misinformation Track 2021 Ranking with SBERT and Quality Estimators},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85137379432?origin=resultslist},
 year = {2021}
}
