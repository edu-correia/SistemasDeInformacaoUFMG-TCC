@conference{Will202454,
 abstract = {This paper describes the adaptation to a distributed computational setting of a well-scaling parallel algorithm for computing Morse-Smale segmentations based on path compression. Additionally, we extend the algorithm to efficiently compute connected components in distributed structured and unstructured grids, based either on the connectivity of the underlying mesh or a feature mask. Our implementation is seamlessly integrated with the distributed extension of the Topology ToolKit (TTK), ensuring robust performance and scalability. To demonstrate the practicality and efficiency of our algorithms, we conducted a series of scaling experiments on large-scale datasets, with sizes of up to 40963 vertices on up to 64 nodes and 768 cores.  © 2024 IEEE.},
 author = {Will, Michael and Lukasczyk, Jonas and Tierny, Julien and Garth, Christoph},
 doi = {10.1109/LDAV64567.2024.00007},
 journal = {Proceedings - 2024 IEEE 14th Symposium on Large Data Analysis and Visualization, LDAV 2024},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {54 - 64},
 publication_stage = {Final},
 source = {Scopus},
 title = {Distributed Path Compression for Piecewise Linear Morse-Smale Segmentations and Connected Components},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85213713797?origin=resultslist},
 year = {2024}
}
