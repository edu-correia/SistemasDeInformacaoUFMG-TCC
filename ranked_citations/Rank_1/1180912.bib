@inproceedings{1180912,
 abstract = {Abstraction is one of the most important concepts in computer science. It has been realized in object oriented programming as the form of class hierarchy. In this paper, new abstraction levels are introduced. This abstraction level can be applied in many fields of computer science, including computer graphics, image processing, database systems and design automation. In this paper the new abstraction level is applied to shape modeling. The abstraction level consists of homotopy, topological spaces, cellular structured spaces and Euclidean spaces. A teacup is used as an example of shape modeling using these abstraction levels.},
 author = {Ohmori, K. and Lee, W.},
 booktitle = {First International Symposium on Cyber Worlds, 2002. Proceedings.},
 doi = {10.1109/CW.2002.1180912},
 issn = {},
 keyword = {Shape;Object oriented modeling;Filtration;Skeleton;Computer science;Image processing;Design automation;Geometry;Merging;Joining processes},
 month = {Nov},
 number = {},
 pages = {447-454},
 title = {Shape modeling using cellular structured spaces},
 volume = {},
 year = {2002}
}
