@inproceedings{11295027,
 abstract = {CelestAI merges the functionalities of a virtual reality and an AI-powered assistant to improve productivity on various tasks, including management and communication. CelestAI addresses the issue of traditional virtual assistants' limited immersive interaction, and in the context of VR applications, they lack an engaging AI assistant. By combining AI-powered Assistants into a VR environment, users are more engaged. CelestAI, our assistant, and users are represented as avatars created using Ready Player Me, while the RPM SDK for Unity enhances the functionalities of these avatars. Additionally, we have integrated OpenAI's API, allowing users to converse with the assistant. Preliminary evaluations indicate that CelestAI facilitates text-based conversations with the assistant within an immersive VR environment. This advancement improves VR interactivity by incorporating artificial intelligence. Integration with voice interactions and multilingual capability are two additional use cases. It also has applications in education, healthcare, and entertainment, making CelestAI a versatile AI-powered virtual assistant.},
 author = {Sagar, Renuka and Saniya, N J and Narayan, Meghana and M, Mala and Supriya, M},
 booktitle = {2025 International Conference on Sustainability, Innovation & Technology (ICSIT)},
 doi = {10.1109/ICSIT65336.2025.11295027},
 issn = {},
 keyword = {Productivity;Avatars;Virtual assistants;Education;Entertainment industry;Medical services;Oral communication;Speech recognition;Multilingual;Artificial intelligence;CelestAI;Virtual Reality;AI-powered Assistant;OpenAI API;Unity;Ready Player Me;RPM SDK;Interactive Avatar;AI-driven Support;Conversational AI;Task Management;Virtual Assistant;VR Interactivity;Voice-Based Interaction;Multilingual capability;Education;Healthcare;Entertainment},
 month = {Aug},
 number = {},
 pages = {1-7},
 title = {CelestAI: Virtual Reality AI Assistant for Everyday Tasks},
 volume = {},
