@article{REN2026100600,
 abstract = {Software vulnerabilities, once exploited by attackers, pose significant threats to software security. Timely application of security patches for remediation helps improve the stability of the software. Currently, many existing security patch identification methods primarily focus on diff code, without fully considering the structure of the patch code and its description. To address this, we propose a security patch identification method based on dual feature fusion called PatchDFF. The method generates the Program Dependency Graph (PDG) of the code before and after applying the patch, slices and merges it to obtain the graph structure of the patch, and then feeds it into the Multi-Graph Attention Network (MGAT) to extract the structural features of the patch. This module conducts multi-level feature extraction on various PDG subgraphs to maximize the retention of graph structural features. Next, the description is embedded and input into the Convolutional Transformer Encoder (CTE) for semantic feature extraction. The CTE employs the Convolutional Neural Networks (CNN) and Transformer encoders to extract more comprehensive semantic features from the patch description. Finally, the structural and semantic features are fused to enhance the process of security patch identification. To assess the effectiveness of PatchDFF, we perform experiments using the public security patch dataset, PatchDB. The experimental results demonstrate that PatchDFF achieves improvements in Accuracy, Precision, Recall, and F1 score, with an Accuracy of 80.93%, Precision of 77.85%, Recall of 76.25%, and F1 score of 77.04%. This result demonstrates the effectiveness of PatchDFF in security patch identification.},
 author = {Jiadong Ren and Chunjiao Bao and Shuailin Yang and Jiazheng Li and Chenghao Zhi},
 doi = {https://doi.org/10.1016/j.bdr.2026.100600},
 issn = {2214-5796},
 journal = {Big Data Research},
 keyword = {Security patch identification, GAT, CNN, Transformer, Feature fusion},
 pages = {100600},
 title = {PatchDFF: A security patch identification method based on dual feature fusion},
 url = {https://www.sciencedirect.com/science/article/pii/S2214579626000122},
 volume = {44},
 year = {2026}
}
