@inproceedings{7876028,
 abstract = {The smart substation is an important part of smart grid. By transmitting GOOSE (Generic Object Oriented Substation Event) and MMS (Manufacturing Message Specification) message among devices, the smart substation can realize the functions including, protection, control, alarm etc. Currently available smart substation secondary system's operation and maintenance analysis doesn't take account of the correlation analysis around correlative devices of functions, and thus leads to an incompleteness functional analysis. The smart substation behavior analysis and acceptance inspection also need to be evaluated from the perspective of functional correlation, but there are limited work on functional correlation analysis. Based on the structure of smart substation, the network message information, and the relay protection principles, this paper develops a new approach to modeling smart substation functional correlation by using branch flow tree structure and implements the instantiation display on the equipment aspect.},
 author = {Wang, Jun and Zuo, Lin and Luo, Yi-Lan and Huang, Qi and Jing, Shi and Wu, Jie},
 booktitle = {2016 International Conference on Smart Grid and Clean Energy Technologies (ICSGCE)},
 doi = {10.1109/ICSGCE.2016.7876028},
 issn = {},
 keyword = {Substations;Correlation;Analytical models;Timing;Merging;Monitoring;Process control;smart substation;GOOSE;MMS;branch flow;tree;functional correlation model},
 month = {Oct},
 number = {},
 pages = {70-74},
 title = {An approach to modeling secondary system functional correlation of smart substation},
 volume = {},
 year = {2016}
}
