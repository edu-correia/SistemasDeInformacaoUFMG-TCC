@inproceedings{10704276,
 abstract = {To optimize the electrical performance of 4H-SiC MPS (Merged PiN Schottky) diodes, this paper proposes a semi-superjunction structure MPS diode (SemiSJ-MPS diode). Compared to the electrical performance of traditional MPS diodes, the SemiSJ-MPS diode achieves an 18.31% reduction in specific on-resistance and an 18.12% increase in reverse breakdown voltage. The device attains a maximum figure of merit (FOM) value of 1191.77 MW/cm2, representing an improvement of up to 70.80%. To further investigate the performance advantages of the SemiSJ-MPS diode, this paper provides a detailed analysis of the impact of the P pillar structure's doping concentration, width, and thickness on the device characteristics. By optimizing these structural parameters, the diode achieves low specific on-resistance while maintaining high breakdown voltage performance.},
 author = {Wang, Bingqi and Wang, Zaixing and Jiang, Jiachi and Cai, Yi and Wang, Linchang and Liu, Bolin},
 booktitle = {2024 6th International Conference on Electronics and Communication, Network and Computer Technology (ECNCT)},
 doi = {10.1109/ECNCT63103.2024.10704276},
 issn = {},
 keyword = {Performance evaluation;Couplings;Schottky diodes;Doping;High-voltage techniques;Structural engineering;Pins;Communication networks;Electric fields;Optimization;MPS diode;superjunction;specific on-resistance;reverse recovery},
 month = {July},
 number = {},
 pages = {332-336},
 title = {Performance Optimisation of 4H-SiC Semi-Superjunction MPS Diodes},
 volume = {},
 year = {2024}
}
