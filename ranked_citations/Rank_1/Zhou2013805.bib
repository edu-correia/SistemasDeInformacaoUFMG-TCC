@conference{Zhou2013805,
 abstract = {Remote sensing image semantic through exploiting classic image semantic building methods or geographic semantic creation approaches directly will be negative as result of remote sensing image holds significant characteristics compared with natural image. In this paper, there provides a novel approach to build remote sensing image semantic based on image content and recognition description. Firstly, semantic based remote sensing implementations and researches on remote sensing image semantic building are reviewed and discussed. In addition, several vital aspects of remote sensing image semantic are proposed from aspects of characteristics, specific concepts and crucial points. Then, the framework of RSemantic, which our own remote sensing semantic building software, are illustrated depend on hierarchical structure, image feature formalization and control lexicon. Finally, there are the conclusion and prospect about work related to remote sensing image semantic field. Compared with semantic building based on segmentation or classification, through experiment our remote sensing image semantic result is provided as semantic categorization. It realizes the transformation from semantic information only to semantic representing for knowledge system. The semantic building procedure is achieved based on remote sensing image processing and interpretation, as well as enduing with knowledge fitted for image content. Copyright © (2013) by the American Society for Photogrammetry & Remote Sensing.},
 author = {Zhou, Xiran and Shao, Zhenfeng and Cheng, Qimin},
 journal = {American Society for Photogrammetry and Remote Sensing Annual Conference, ASPRS 2013},
 note = {Cited by: 0},
 pages = {805 - 817},
 publication_stage = {Final},
 source = {Scopus},
 title = {A novel approach of building specific ontology for remote sensing image},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84887954265?origin=resultslist},
 year = {2013}
}
