@inproceedings{4595936,
 abstract = {XML-based data dissemination networks are rapidly gaining momentum. In these networks XML content is routed from data producers to data consumers throughout an overlay network of content-based routers. Routing decisions are based on XPath expressions (XPEs) stored at each router. To enable efficient routing, while keeping the routing state small, we introduce an advertisement-based routing algorithm for XML content, present a novel data structure for managing XPEs, especially apt for the hierarchical nature of XPEs and XML, and develop several optimizations for reducing the number of XPEs required to manage the routing state. The experimental evaluation shows that our algorithms and optimizations reduce the routing table size by up to 90%, improve the routing time by roughly 85%, and reduce overall network traffic by about 35%. Experiments running on PlanetLab show the scalability of our approach.},
 author = {Li, Guoli and Hou, Shuang and Jacobsen, Hans-Arno},
 booktitle = {2008 The 28th International Conference on Distributed Computing Systems},
 doi = {10.1109/ICDCS.2008.31},
 issn = {1063-6927},
 keyword = {XML;Subscriptions;Routing;Merging;Corporate acquisitions;Optimization;Data structures;Publish/Subscribe;Data Dissemination Networks;Covering;Merging},
 month = {June},
 number = {},
 pages = {627-638},
 title = {Routing of XML and XPath Queries in Data Dissemination Networks},
 volume = {},
 year = {2008}
}
