@inproceedings{4392424,
 abstract = {This paper deals with algorithms for determining well performing bandwidth expanding joint source-channel coding (JSCC) systems. The JSCC systems are realized as direct source-channel mappings. The algorithms presented are "power constrained channel optimized vector quantizers" (PCCOVQ). The PCCOVQ algorithm is a modified generalized Lloyd algorithm. Theory on PCCOVQ is presented, with the emphasis on bandwidth expansion. Examples and results concerning bandwidth expansion by a factor of 2 and 3 are given.},
 author = {Floor, Pal Anders and Ramstad, Tor A. and Wernersson, Niklas},
 booktitle = {2007 4th International Symposium on Wireless Communication Systems},
 doi = {10.1109/ISWCS.2007.4392424},
 issn = {2154-0225},
 keyword = {Constraint optimization;Bandwidth;Robustness;Channel capacity;Merging;Delay;Degradation;Error correction;Signal to noise ratio;Spirals},
 month = {Oct},
 number = {},
 pages = {667-671},
 title = {Power Constrained Channel Optimized Vector Quantizers used for Bandwidth Expansion},
 volume = {},
 year = {2007}
}
