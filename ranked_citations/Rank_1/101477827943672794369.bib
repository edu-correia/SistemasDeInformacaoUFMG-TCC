@article{10.14778/2794367.2794369,
 abstract = {Maintaining and querying hierarchical data in a relational database system is an important task in many business applications. This task is especially challenging when considering dynamic use cases with a high rate of complex, possibly skewed structural updates. Labeling schemes are widely considered the indexing technique of choice for hierarchical data, and many different schemes have been proposed. However, they cannot handle dynamic use cases well due to various problems which we investigate in this paper. We therefore propose our dynamic Order Indexes, which offer competitive query performance, unprecedented update efficiency, and robustness for highly dynamic workloads.},
 author = {Finis, Jan and Brunel, Robert and Kemper, Alfons and Neumann, Thomas and May, Norman and Faerber, Franz},
 doi = {10.14778/2794367.2794369},
 issn = {2150-8097},
 issue_date = {June 2015},
 journal = {Proc. VLDB Endow.},
 month = {June},
 number = {10},
 numpages = {12},
 pages = {986–997},
 publisher = {VLDB Endowment},
 title = {Indexing highly dynamic hierarchical data},
 url = {https://doi.org/10.14778/2794367.2794369},
 volume = {8},
 year = {2015}
}
