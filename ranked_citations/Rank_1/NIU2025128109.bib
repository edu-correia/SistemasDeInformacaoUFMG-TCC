@article{NIU2025128109,
 abstract = {The increasing deployment of small-capacity logistics cold storage facilities has led to a notable rise in greenhouse gas emissions, driven by refrigerant leakage and energy consumption. To address both direct and indirect emissions, this study proposes an environmentally friendly CO2-based refrigeration system and introduces a novel design methodology using the GraPHsep approach. Unlike conventional methods that optimize system configuration for a single condition, this work constructs and integrates optimal refrigeration cycles for four typical scenarios—frozen and chilled storage in both summer and winter. The resulting unified system enables efficient operation across variable ambient and cooling load conditions and allows seamless switching between storage modes. A simulation model is established to analyze system performance and control strategies. Results show that the double-stage compression flash tank system achieves superior COP in summer, while a single-stage system with an internal heat exchanger is optimal for winter. Under a chilled condition with 10  kW load and 20 °C outdoor temperature, the system achieves a maximum COP of 3.17 in single-stage mode. A lifecycle assessment reveals an 18 % reduction in TEWI compared to a conventional R404A system, avoiding approximately 102.7 tonnes of CO2 emissions.},
 author = {Heng Niu and Mengdi Cui and Baolong Wang and Wenxing Shi},
 doi = {https://doi.org/10.1016/j.applthermaleng.2025.128109},
 issn = {1359-4311},
 journal = {Applied Thermal Engineering},
 keyword = {Cold storage facility, GraPHsep method, Refrigeration system, CO},
 pages = {128109},
 title = {Numerical study on a multifunctional small-capacity refrigeration system for logistics cold storage based on the GraPHsep method},
 url = {https://www.sciencedirect.com/science/article/pii/S1359431125027012},
 volume = {280},
 year = {2025}
}
