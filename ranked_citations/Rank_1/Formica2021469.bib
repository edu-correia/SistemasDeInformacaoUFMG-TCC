@article{Formica2021469,
 abstract = {Formal Concept Analysis (FCA) is a mathematical framework which can also support critical activities for the development of the Semantic Web. One of them is represented by Similarity Reasoning, i.e., the identification of different concepts that are semantically close, that allows users to retrieve information on the Web more efficiently. In order to model uncertainty information, in this paper FCA with many-valued contexts is addressed, where attribute values are intervals, which is referred to as FCA with Interordinal scaling (IFCA). In particular, a method for evaluating concept similarity in IFCA is proposed, which is a problem that has not been adequately investigated, although the increasing interest in the literature in this topic. © 2021 Slovak Academy of Sciences. All rights reserved.},
 author = {Formica, Anna},
 doi = {10.31577/cai_2021_3_469},
 journal = {Computing and Informatics},
 note = {Cited by: 4; All Open Access; Gold Open Access},
 number = {3},
 pages = {469 - 488},
 publication_stage = {Final},
 source = {Scopus},
 title = {CONCEPT SIMILARITY in FORMAL CONCEPT ANALYSIS with MANY-VALUED CONTEXTS},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85121826752?origin=resultslist},
 volume = {40},
 year = {2021}
}
