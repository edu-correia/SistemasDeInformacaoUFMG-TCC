@inproceedings{7428568,
 abstract = {We propose a fast rectangle and triangle detection method applicable in the target recognition and pose estimation of spacecraft. The algorithm makes use of a new line segment detector based on orientation histogram and Bresenham's line drawing algorithm. The detected line segments are categorized into different groups according to their angles, by which we can quickly detect and locate rectangle and triangle in the image. The experimental results showed that this method reduced computation requirement compared to current algorithms.},
 author = {Huadong, Dai and Yang, Wang},
 booktitle = {2015 IEEE Advanced Information Technology, Electronic and Automation Control Conference (IAEAC)},
 doi = {10.1109/IAEAC.2015.7428568},
 issn = {},
 keyword = {Decision support systems;Histograms;Handheld computers;Merging;Shape;Image segmentation;Detectors;line segment;orientation histogram;rectangle;triangle;detection},
 month = {Dec},
 number = {},
 pages = {321-327},
 title = {A new method for detecting rectangles and triangles},
 volume = {},
 year = {2015}
}
