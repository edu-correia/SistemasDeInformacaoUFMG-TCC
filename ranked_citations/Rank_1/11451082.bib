@inproceedings{11451082,
 abstract = {The novel hybrid CNN-XGBoost model is designed to work with the UrbanSound8K dataset and MFCCs, in which a CNN is used for temporal and spectral feature extraction from urban noise samples, and XGBoost is used for classification based on the learned complex and quieter boundary features. The combination of these two techniques surpasses the accuracies of other models such as Random Forest (89.8%) and K-Nearest Neighbors (88.1%) by achieving an accuracy of 90%. The model performs exceptionally well with structured sounds like Car Horn (0.99) and Engine Idling (0.97); however, it struggles with more complicated sounds, like Children Playing (0.84). By merging feature extraction from CNNs with boost tree classification from XGBoost, the model accounts for noisy data and complex tasks. This removes the hurdles experienced in solely using handcrafted feature reliant models, or models using simple decision tree paths. This multifaceted method improves sound classification in smart cities for purposes like noise pollution tracking or public danger signaling. Possible refinements could be attention mechanisms to aid in the classification of variable sounds, or transfer learning to increase versatility. This being the first of its kind, the CNN-XGBoost model leaves room for further advancements and better practicality in urban noise classification.},
 author = {Hole, Shreyas Rajendra and Ahmed Khan, Mubeen and Sardar, Tanvir Habib and V S, Devi Priya and Naresh, P and R, Nivetha},
 booktitle = {2025 International Conference On Emerging Computation and Information Technologies (ICECIT)},
 doi = {10.1109/ICECIT67774.2025.11451082},
 issn = {},
 keyword = {Accuracy;Pollution;Smart cities;Noise;Transfer learning;Nearest neighbor methods;Feature extraction;Convolutional neural networks;Noise measurement;Random forests;Urban Sound Classification;Convolutional Neural Networks (CNNs);Mel-frequency Cepstral Coefficients (MFCCs);UrbanSound8K Dataset,Smart City Applications},
 month = {Dec},
