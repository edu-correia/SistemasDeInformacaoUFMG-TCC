@article{WANG2024213917,
 abstract = {Acute myocardial infarction (AMI) resulting from coronary artery occlusion stands as the predominant cause of cardiovascular disability and mortality worldwide. An all-encompassing treatment strategy targeting pathological processes of oxidative stress, inflammation, proliferation and fibrotic remodeling post-AMI is anticipated to enhance therapeutic outcomes. Herein, an up-down-structured bilayer microneedle (Ce-CLMs-BMN) with reactive oxygen species (ROS) and ultrasound (US) dual-responsiveness is proposed for AMI in-situ sequential therapy. The upper-layer microneedle is formulated by crosslinking ROS-sensitive linker with polyvinyl alcohol loaded with cerium dioxide nanoparticles (CeNPs) featuring versatile enzyme-mimetic activities. During AMI acute phase, prompted by ischemia-induced microenvironmental redox imbalance, this layer swiftly releases CeNPs, which aid in eliminating excessive ROS and catalyzing oxygen gas (O2) production through multiple enzymatic pathways, thereby alleviating oxidative stress-induced damage and modulating inflammation. In AMI chronic repair phase, micro-nano reactors (CLMs) situated in the lower-layer microneedle undergo cascade reactions with the assistance of US irradiation to generate nitric oxide (NO). As a bioactive molecule with pro-angiogenic and anti-fibrotic effects, NO expedites cardiac repair while attenuating adverse remodeling. Additionally, its antiplatelet-aggregating properties contribute to thromboprophylaxis. In-vitro and in-vivo results substantiate the efficacy of this integrated healing approach in AMI management, showcasing promising prospects for advancing infarcted heart repair.},
 author = {Qingqing Wang and Shuangyuan Cao and Teng Zhang and Fanzhen Lv and Mingfei Zhai and Danmeng Bai and Mengzhen Zhao and Haoxin Cheng and Xiaolei Wang},
 doi = {https://doi.org/10.1016/j.bioadv.2024.213917},
 issn = {2772-9508},
 journal = {Biomaterials Advances},
 keyword = {Acute myocardial infarction, Microneedles, Nanozymes, Oxidative stress resistance, Gas therapy, Myocardial repair},
 pages = {213917},
 title = {Reactive oxide species and ultrasound dual-responsive bilayer microneedle array for in-situ sequential therapy of acute myocardial infarction},
 url = {https://www.sciencedirect.com/science/article/pii/S2772950824001602},
 volume = {162},
 year = {2024}
}
