@inproceedings{11022296,
 abstract = {Building type information is crucial as it indicates the functional properties of structures. The accurate type classification of buildings holds significant importance in smart city development and estimation of carbon emissions. This research explores a novel framework, i.e., hierarchical feature interactive network (HFINet) based on dual-encoder architecture of CNN and Transformer, for the building type classification from Very-High-Resolution (VHR) remote sensing images. By merging two techniques, we can effectively enhance the learning of intricate spatial features and detailed characteristics of buildings within complex scenarios. Moreover, we created a building type dataset, i.e., an Urban Building Type Dataset (UBTD) to validate the effectiveness of our method, addressing the scarcity of datasets in current research. Extensive experiments conducted on the UBTD datasets demonstrate that HFINet outperforms popular CNN, Transformer methods, and dual encoder methods in building type classification across various regions, achieving the highest MIOU values of 72.20%, F1 values of 80.83% and ACC of 93.07%. Our approach, HFINet, excels in very-high-resolution remote sensing building type classification, offering improved accuracy and robustness, even in complex environments.},
 author = {Zhang, Shaofeng and Li, Mengmeng and Lou, Kangkai},
 booktitle = {2024 8th Asian Conference on Artificial Intelligence Technology (ACAIT)},
 doi = {10.1109/ACAIT63902.2024.11022296},
 issn = {},
 keyword = {Accuracy;Smart cities;Architecture;Buildings;Semantics;Estimation;Carbon dioxide;Transformers;Robustness;Remote sensing;remote sensing;building type classification;dual-encoder network;feature interaction},
 month = {Nov},
 number = {},
 pages = {496-500},
 title = {Building Type Classification Using Dual-Encoder Interaction Network from Very-High-Resolution Remote Sensing Images},
 volume = {},
