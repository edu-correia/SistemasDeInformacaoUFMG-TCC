@inproceedings{10074894,
 abstract = {Object detection methods have been widely used in various scenarios including automatic driving. However, existing methods are difficult to be deployed on terminals with weak computing power. In this paper, we propose a lightweight object detection model named EDCNet based on encoding feature sharing for drug driving detection with handheld terminals. The backbone of EDCNet is a segmentation network following the typical encoding-decoding segmentation structure, which extracts the region containing testing strips. The feature merging block in the encoding module reduces the number of parameters while fully leveraging image features at each scale. And the decoding part saves memory overhead by reusing max-pooling indexes. On the basis of object segmentation, a novel method named encoding feature sharing is introduced to intercept features of objects on feature maps. The intercepted features are then input into a classification network which judges whether and which drug the tester has taken. The amount of parameters of the EDCNet is 3.34M, and the performance of EDCNet is tested on a drug driving test dataset. Experimental results show that the segmentation accuracy (IoU) of EDCNet can reach 98.21% and the classification accuracy is 99.99%. The comprehensive performance of EDCNet outperforms other existing object detection algorithms and can meet the requirements of deployment on drug driving detection terminals.},
 author = {Wei, Junfei and Li, Yuan and Zhang, Bo},
 booktitle = {2022 IEEE 24th Int Conf on High Performance Computing & Communications; 8th Int Conf on Data Science & Systems; 20th Int Conf on Smart City; 8th Int Conf on Dependability in Sensor, Cloud & Big Data Systems & Application (HPCC/DSS/SmartCity/DependSys)},
 doi = {10.1109/HPCC-DSS-SmartCity-DependSys57074.2022.00160},
 issn = {},
 keyword = {Drugs;Strips;Image segmentation;Computational modeling;Object detection;Feature extraction;Encoding;object detection;lightweight model;encoding feature sharing;drug driving detection},
 month = {Dec},
