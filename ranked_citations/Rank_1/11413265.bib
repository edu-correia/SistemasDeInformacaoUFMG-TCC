@inproceedings{11413265,
 abstract = {Considering the highly theoretical and abstract nature of discrete mathematics, and taking the opportunity of the Construction of Emerging Engineering Education, we have calibrated and refined the course objectives in alignment with the goals of the Emerging Engineering Education. We have updated the course philosophy in accordance with the concept of Emerging Engineering Education. To achieve the course objectives, we propose a method of applying functional languages to discrete mathematics, and provide a course instructional design scheme integrating theory with practice. This design achieves a perfect connection between theory and practice within limited class hours. Furthermore, the objective of enabling students to internalize abstract knowledge as skills and qualities has been accomplished.},
 author = {Wang, Zhaoli and Han, Jingli and Wang, Meijuan and Xia, Qing},
 booktitle = {2025 International Conference on Educational Technology Management (ICETM)},
 doi = {10.1109/ICETM67477.2025.11413265},
 issn = {},
