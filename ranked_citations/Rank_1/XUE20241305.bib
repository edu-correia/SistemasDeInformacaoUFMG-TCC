 journal = {Journal of Surgical Education},
 keyword = {video-based learning, 3D digital animations, surgical education, cognitive load, orthopaedic and trauma surgery},
 number = {9},
 pages = {1305-1319},
 title = {Does a Video-Based and 3D Animation Hybrid Learning System Improve Teaching Outcomes in Orthopedic Surgery? A Randomized Controlled Trial},
