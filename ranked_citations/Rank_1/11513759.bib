@article{11513759,
 abstract = {This data paper documents and evaluates five major publicly accessible workplace injury datasets: OSHA Severe Injury Report (SIR), Occupational Safety and Health Administration (OSHA) Injury Tracking Application (ITA) Case Detail, Texas Institutional Medical Billing Services (SV2), Oregon Workers’ Compensation Record-Level Claims (OR_WC), and New York State Workers’ Compensation Injury Claims (NY_WC). Because occupational injury data are fragmented across jurisdictions and sources, analyzing dataset structure and harmonizing key fields is necessary to enable consistent cross-dataset measurements, analytics, and modeling. These sources comprise more than 7.5 million records from 2015 to 2024 across federal and state jurisdictions. We provide detailed dataset analyses, including data structures, reporting mechanisms, feature availability, limitations, and exploratory patterns useful for occupational safety research. We then present a cross-dataset harmonization (schema alignment) process that integrates the four incident- and claim-level datasets (SIR, ITA, OR_WC, NY_WC) into a single dataset using a constrained set of shared features. To demonstrate the potential machine learning utility of the harmonized dataset, we include a baseline decision-tree classification example, indicating generalizable predictions for fall-related injuries. Overall, our work provides a detailed reference for researchers seeking to understand, compare, and integrate heterogeneous workplace injury data for ongoing and future analytics and machine learning.},
 author = {Bauder, Richard and Billion-Polak, Preston and Khoshgoftaar, Taghi M.},
 doi = {10.1109/ACCESS.2026.3692037},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {Injuries;Employment;Codes;Modeling;Recording;Machine learning;Occupational safety;Medical services;Machining;Aging;Data harmonization;data merging;machine learning;workplace injury;workplace safety},
 month = {},
 number = {},
 pages = {73765-73791},
 title = {Characterizing and Harmonizing Five Public Workplace Injury Datasets for Research and Modeling},
 volume = {14},
 year = {2026}
}
