@article{10.1145/3649222,
 abstract = {This article introduces LinkStream, a liquidity analysis system based on multiple video streams designed and implemented for oilfield. LinkStream combines a variety of technologies to solve several problems in computing power and network latency. First, the system adopts an edge-central architecture and tailoring based on spatio-temporal correlation, which greatly reduces computing power requirements and network costs, and enables real-time analysis of large-scale video stream on limited edge devices. Second, it designed a set of liquidity information to describe the liquidity status in the oilfield. Finally, it uses object tracking technology to design a counting algorithm for the unique tubing object in the oilfield. We have deployed LinkStream in an oilfield in Iraq. LinkStream can perform real-time inference on over 200 video streams with acceptable resource overhead.},
 address = {New York, NY, USA},
 articleno = {65},
 author = {Ma, Qiang and Yuan, Hao and Hu, Zhe and Wang, Xu and Yang, Zheng},
 doi = {10.1145/3649222},
 issn = {1550-4859},
 issue_date = {May 2024},
 journal = {ACM Trans. Sen. Netw.},
 keyword = {Liquidity analysis, edge computing, object counting, cross-camera tracking},
 month = {April},
 number = {3},
 numpages = {22},
 publisher = {Association for Computing Machinery},
 title = {A Liquidity Analysis System for Large-scale Video Streams in the Oilfield},
 url = {https://doi.org/10.1145/3649222},
 volume = {20},
 year = {2024}
}
