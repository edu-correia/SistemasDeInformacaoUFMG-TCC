@article{11373192,
 abstract = {This article presents a 5–7.1-GHz four-channel CMOS Wi-Fi 7 transceiver front end for fiber-to-the-room (FTTR) applications with analog beamforming beamforming-FTTR (BF-FTTR), which can significantly alleviate indoor signal interference by enabling directional radiation and fine gain control. In addition, due to the introduction of support for digital predistortion (DPD), superior linearity has been achieved at a high output power. Furthermore, a broadband matching network merged transmitting/receiving (T/R) switch is designed, with an analog linearization technique adopted in the power amplifier to partially suppress the transmitter (TX) nonlinear distortion. Meanwhile, a passive–active hybrid network scheme is proposed in the power divider (PD) and power combiner (PC) to offset the insertion loss (IL) due to the passive structure. The phase and gain controls are realized by a 4-bit passive phase shifter (PS) and a 5-bit passive attenuator (ATT), respectively. Implemented in a 55-nm CMOS process, the measured  $P_{\mathrm {sat}}$  of each TX channel is better than 22.1 dBm. Error vector magnitude (EVM) of the TX with 320-MHz 4096-QAM MCS13 is better than −40.31 dB at 17.5-dBm output power. The TX EVM floor is below −38 dB from 5 to 7.1 GHz within the output power range of −16 to 20 dBm. The RX EVM at −19-dBm input power is better than −46.41 dB, and the noise figure (NF) is 4.5 dB.},
 author = {Feng, Bowei and Fu, Kun and Huang, Xinke and Lei, Xin and Teng, Lexuan and Zheng, Shuyao and Gui, Xiaoyan},
 doi = {10.1109/TMTT.2026.3655167},
 issn = {1557-9670},
 journal = {IEEE Transactions on Microwave Theory and Techniques},
 keyword = {Transceivers;Wireless fidelity;Gain;Switches;Attenuation;Power generation;Array signal processing;Topology;Optical fiber networks;Bandwidth;Beamforming-fiber-to-the-room (BF-FTTR);CMOS;digital predistortion (DPD);front-end module (FEM);transceiver front end;Wi-Fi 7},
 month = {April},
 number = {4},
 pages = {3636-3650},
 title = {A Four-Channel CMOS Wi-Fi 7 Transceiver Front End for Fiber-to-the-Room With Analog Beamforming and Digital Predistortion},
 volume = {74},
 year = {2026}
}
