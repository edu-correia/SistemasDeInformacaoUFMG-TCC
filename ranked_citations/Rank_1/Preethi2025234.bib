@conference{Preethi2025234,
 abstract = {Merge sort is a fundamental algorithm in the domain of data sorting and is widely used in various applications. Hardware implementations of FPGA often face challenges associated with high power consumption. In this work, we propose a systematic methodology for designing energy-efficient hardware merge sorters by strategically employing clock gating mechanisms. The key contributions of this research include the identification and exploitation of clock-gating opportunities within the merge sort algorithm, allowing for the selective deactivation of specific FPGA components during idle or non-critical phases. Through rigorous simulation and power analysis, we quantify the impact of clock gating on energy efficiency, considering various design parameters and tradeoffs. This research contributes to the ongoing efforts to develop energy-efficient hardware solutions for fundamental algorithms. The presented low-power merge sorter design in FPGA, augmented with clock gating strategies, holds promise for applications in resource-constrained environments, such as edge computing devices and Internet of Things (IoT) platforms, where power efficiency is paramount. This work provides intuitions into the synergy between algorithmic complexity, hardware design, and power optimization of 48.52% in the context of merge sort algorithms. This work provides power optimization of 48.52% by clock gating on the Merge sorter.  © 2025 IEEE.},
 author = {Preethi and Ulla, Mohammed Mujeer and Sapna, R. and Devadas, Raghavendra M. and Pavithra, N. and Manasa, C.M.},
 doi = {10.1109/INCIP64058.2025.11019960},
 journal = {Proceedings - International Conference on Next Generation Communication and Information Processing, INCIP 2025},
 note = {Cited by: 0},
 pages = {234 - 238},
 publication_stage = {Final},
 source = {Scopus},
 title = {Designing Low-Power Hardware Merge Sorters Using Clock Gating for IoT Applications},
 type = {Conference paper},
