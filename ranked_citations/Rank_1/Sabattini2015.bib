@conference{Sabattini2015,
 abstract = {This paper describes innovative sensing technologies and control techniques, that aim at improving the performance of groups of Automated Guided Vehicles (AGVs) used for logistics operations in industrial environments. We explicitly consider the situation where the environment is shared among AGVs, manually driven vehicles, and human operators. In this situation, safety is a major issue, that needs always to be guaranteed, while still maximizing the efficiency of the system. This paper describes some of the main achievements of the PAN-Robots European project. © 2015 IEEE.},
 author = {Sabattini, Lorenzo and Cardarelli, Elena and Digani, Valerio and Secchi, Cristian and Fantuzzi, Cesare and Fuerstenberg, Kay},
 doi = {10.1109/ETFA.2015.7301488},
 journal = {IEEE International Conference on Emerging Technologies and Factory Automation, ETFA},
 note = {Cited by: 12; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Advanced sensing and control techniques for multi AGV systems in shared industrial environments},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84952906715?origin=resultslist},
 volume = {2015-October},
 year = {2015}
}
