@article{SALVADORE2025109652,
 abstract = {We present STREAmS-2.1, an updated version of the flow solver STREAmS [1], lastly updated in Bernardini et al. Comput. Phys. Commun. 285 (2023) 108644. STREAmS-2.1 merges the features of the curvilinear solver FLEW [2] which is able to simulate three canonical cases, namely the circular arc channel, the curved boundary layer and the airfoil case. Moreover, three new backends are included, i.e., OpenMP (for CPUs), HIP (for AMD GPUs) and OpenMP-offload (tested on Intel GPUs but potentially portable). Finally, in situ visualization layer based on Catalyst2 technology is integrated into the solver to reduce the visualization effort, especially for huge computational grids. NEW VERSION PROGRAM SUMMARY Program Title: STREAmS CPC Library link to program files: https://doi.org/10.17632/hdcgjpzr3y.3 Developer's repository link: https://github.com/STREAmS-CFD/STREAmS-2 Licensing provisions: GPLv3 Programming language: Fortran, CUDA, HIP Journal reference of previous version: M. Bernardini, D. Modesti, F. Salvadore, S. Sathyanarayana, G. Della Posta, and S. Pirozzoli (2023). STREAmS-2.0: Supersonic turbulent accelerated Navier-Stokes solver version 2.0. Comput. Phys. Commun., 285, 108644. Does the new version supersede the previous version?: Yes Reasons for the new version: Curvilinear coordinates, new computing backends (OpenMP, HIP, OpenMP-offload), in situ visualization.Summary of revisions:•the STREAmS-2 solver [1], [3] has been merged to the FLEW solver [2] which features generalized curvilinear coordinate system along two axes, in which the surface coordinates are non necessarily orthogonal, whereas the third axis is normal to the surface. Canonical curvilinear cases supported and validated using the present version include the circular arc channel ([4]), the curved boundary layer (e.g., compression ramp [5]) and the airfoil case based on a C-mesh topology ([6]).•new computing backends, which have been thoroughly benchmarked, are available in addition to the original CUDA Fortran and pure MPI paradigms. Specifically, the OpenMP backend can be used for traditional CPUs, the HIP (Heterogeneous-computing Interface for Portability) backend is suitable to exploit AMD GPUs ([7]), and the OpenMP-offload backend was tested on Intel GPUs ([8]) but is potentially suitable for different kinds of accelerators.•in situ visualization support is now available as a layer within STREAmS connected to Catalyst2 technology. In situ management is well integrated into the code thanks to a set of predefined procedures to extract relevant flow quantities (e.g., swirling strength for the visualization of turbulent structures) and to a dedicated input file section. In situ visualization allows the user to extract visualizations from huge sets of data without excessive I/O usage ([9]). Nature of problem: The code solves the compressible Navier–Stokes equations in Cartesian or 2D-extruded curvilinear coordinates for a thermally perfect gas. The solver is designed for direct numerical simulation (DNS) of compressible supersonic turbulent boundary layers and various canonical configurations are supported, including (planar or circular) channel flow, boundary layer, shock-wave/boundary layer interaction and airfoil flow. Solution method: The equations are discretized using high-order finite difference approximations with hybrid low-dissipative/shock-capturing capabilities and the time advancement is performed using a third-order, low-storage Runge–Kutta scheme.},
 author = {Francesco Salvadore and Giulio Soldati and Alessandro Ceci and Giacomo Rossi and Antonio Memmolo and Giacomo {Della Posta} and Davide Modesti and Srikanth Sathyanarayana and Matteo Bernardini and Sergio Pirozzoli},
 doi = {https://doi.org/10.1016/j.cpc.2025.109652},
 issn = {0010-4655},
 journal = {Computer Physics Communications},
 keyword = {Compressible flows, Wall turbulence, GPUs, CUDA, HIP, OpenMP, In situ},
 pages = {109652},
 title = {STREAmS-2.1: Supersonic turbulent accelerated Navier-Stokes solver version 2.1},
 url = {https://www.sciencedirect.com/science/article/pii/S0010465525001547},
 volume = {314},
 year = {2025}
}
