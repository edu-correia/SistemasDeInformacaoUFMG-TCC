@article{1015693,
 abstract = {This paper describes the 32-Mb and the 64-Mb embedded DRAM core with high efficient redundancy, which is fabricated using 0.13-/spl mu/m triple-well 4-level Cu embedded DRAM technology. Core size of 18.9 mm/sup 2/ and cell efficiency of 51.3% for the 32-Mb capacity, and core size of 33.4 mm/sup 2/ and cell efficiency of 58.1% for the 64-Mb capacity are realized. This core can achieve 230-MHz burst access at 1.0-V power-supply condition by adopting a new data bus architecture: merged shift column redundancy. We implemented four test functions to improve the testability of the embedded DRAM core. It realizes the DRAM core test in a logic test environment.},
 author = {Kikukawa, H. and Tomishima, S. and Tsuji, T. and Kawasaki, T. and Sakamoto, S. and Ishikawa, M. and Abe, W. and Tanizaki, H. and Kato, H. and Uchikoba, T. and Inokuchi, T. and Senoh, M. and Fukushima, Y. and Nirro, M. and Maruta, M. and Shibayama, A. and Ooishi, T. and Takahashi, K. and Hidaka, H.},
 doi = {10.1109/JSSC.2002.1015693},
 issn = {1558-173X},
 journal = {IEEE Journal of Solid-State Circuits},
 keyword = {Random access memory;Large scale integration;System testing;Circuit testing;Logic testing;Paper technology;Logic circuits;Analog circuits;Logic gates;Energy consumption},
 month = {July},
 number = {7},
 pages = {932-940},
 title = {0.13-/spl mu/m 32-Mb/64-Mb embedded DRAM core with high efficient redundancy and enhanced testability},
 volume = {37},
 year = {2002}
}
