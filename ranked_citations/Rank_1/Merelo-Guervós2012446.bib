@article{Merelo-Guervós2012446,
 abstract = {This work presents the mapping of an evolutionary algorithm to the CouchDB object store. This mapping decouples the population from the evolutionary algorithm, and allows a distributed and asynchronous operation of clients written in different languages. In this paper we present initial tests which prove that the novel algorithm design still performs as an evolutionary algorithm and try to find out what are the main issues concerning it, what kind of speedups should we expect, and how all this affects the fundamentals of the evolutionary algorithm. © 2012 Springer-Verlag.},
 author = {Merelo-Guervós, Juan-Julián and Mora, Antonio and Cruz, J. Albert and Esparcia, Anna I.},
 doi = {10.1007/978-3-642-29178-4_45},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 4},
 pages = {446 - 455},
 publication_stage = {Final},
 source = {Scopus},
 title = {Pool-based distributed evolutionary algorithms using an object database},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84859341659?origin=resultslist},
 volume = {7248 LNCS},
 year = {2012}
}
