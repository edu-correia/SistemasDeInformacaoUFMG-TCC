@inproceedings{11018950,
 abstract = {SAFESPACE is an initiative aimed at enhancing the use of CCTV for safety by merging it with machine learning algorithms primarily to foster women's safety across public places. In this case, machine learning and computer vision serves the purpose of real robotic vision inspection sending real- time inspection reports in real-time. This way, it also can sense threats through gender classification, identification of weapons, and recognizing behavioral patterns involving group dynamics. It alerts the women's well-wishers, and they can immediately take action if harassment or violence is detected on them. Designing such systems relieve humans from the monotonous task of constant watching thereby increasing efficiency at automatic alerts to appropriate authorities such as security operatives or police stationed nearby. Proactive deployment to likely crime spots such as public transportation centers, lonely roads, and commercial buildings tries to deter women's related crimes and ensures peace in the public space across various locations. It has further promise in easy integration with the smart cities and urban security programs. Also, linking with future possibilities, applying more advanced AI algorithms would further make the system stronger and protect against future threats.},
 author = {K, Pushpavalli and B, Gomathi and T, Lakshna Devi},
 booktitle = {2025 International Conference on Computing and Communication Technologies (ICCCT)},
 doi = {10.1109/ICCCT63501.2025.11018950},
 issn = {2995-3197},
 keyword = {Computer vision;Machine learning algorithms;Smart cities;Weapons;Roads;Machine learning;Inspection;Real-time systems;Security;Public transportation;SAFESPACE;CCTV;safety;machine learning;women's safety;public places;computer vision;robotic vision;real-time inspection;threat detection;gender classification;weapon identification;behavioral patterns;group dynamics;harassment;violence detection;automatic alerts;security operatives;police;public transportation;lonely roads;commercial buildings;smart cities;urban security;AI algorithms},
 month = {April},
