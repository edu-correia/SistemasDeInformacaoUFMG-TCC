@inproceedings{11407719,
 abstract = {Autonomous legged locomotion within complex and partially observable domains demands a rigorous synthesis of geometric accuracy and semantic reasoning to ensure operational stability. Conventional geometric planners often fail to distinguish between terrain that is spatially navigable yet semantically hazardous which leads to path instability and potential mission failure. To overcome these limitations, we present a unified planning architecture that merges the representational capacity of deep learning with the systematic global consistency of a Floyd augmented A⋆ search strategy. The proposed framework utilizes a deep neural network to encode latent environmental features and terrain semantics into weighted graph transitions thereby embedding learned traversability priors directly into the search space. Building upon this semantically enriched representation, the Floyd enhanced mechanism computes all pairs shortest path estimates to guarantee connectivity and coherence across extended planning horizons. We theoretically validate the system convergence under conditions of bounded perceptual uncertainty and demonstrate its practical efficacy through high-fidelity dynamics simulations using a Unitree Go1 robot in cluttered environments. Comparative analysis against standard randomized and Euclidean heuristic baselines confirms that our approach generates trajectories with superior semantic optimality and reduced variance enabling reliable navigation across rugged topography where traditional methods falter.},
 author = {Zhan, Xiaoan},
 booktitle = {2025 7th International Conference on Intelligent Control, Measurement and Signal Processing (ICMSP)},
 doi = {10.1109/ICMSP68723.2025.11407719},
 issn = {},
 keyword = {Uncertainty;Systematics;Navigation;Semantics;Signal processing algorithms;Artificial neural networks;Stability analysis;Planning;Trajectory;Quadrupedal robots;Deep neural network;Floyd-enhanced A* search;Quadrupedal robot navigation;Semantic path planning},
 month = {Nov},
 number = {},
 pages = {244-250},
 title = {Deep Neural Floyd Search for Robust Quadrupedal Navigation in Unstructured Terrains},
 volume = {},
