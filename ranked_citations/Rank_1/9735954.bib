@inproceedings{9735954,
 abstract = {Since a large-scale wind farm is connected, it has an impact on the hybrid High Voltage Alternating Current/Direct Current (HV AC/DC) power grid with the characteristics of ‘strong DC and weak AC’. When the connected capacity of the wind farm drops instantaneously, it may cause the DC system commutation failure. In this paper, firstly, the impact of wind power grid connection on the converter bus voltage is analyzed. Then, the relationship between the commutation bus voltage variation and the critical commutation voltage reduction is established, the correlation factor of the DC commutation failure caused by the wind power grid connection is proposed, and the criterion for determining the DC commutation failure caused by the wind power grid connection is defined. As a result, the maximum variation of wind power access capacity could be obtained.},
 author = {Wei, Wu and Jia, Li and Wang, Wei},
 booktitle = {2021 IEEE Sustainable Power and Energy Conference (iSPEC)},
 doi = {10.1109/iSPEC53008.2021.9735954},
 issn = {},
 keyword = {Fluctuations;Correlation;Voltage fluctuations;Wind energy;Simulation;High-voltage techniques;Wind power generation;wind power;commutation failure;access capacity;hybrid HV AC/DC power grid},
 month = {Dec},
 number = {},
 pages = {1542-1547},
 title = {Research on the Influence of the Fluctuation of Wind Power Access Capacity on Commutation Failure of HVDC},
 volume = {},
 year = {2021}
}
