@conference{Su201988,
 abstract = {With the continuous improvement of people's requirements for vehicle performance, it not only improves the vehicle performance, but also increases the complexity of vehicle driving operation, which also brings unsafe hidden dangers to the driving process. With the rapid development of speech recognition technology, it is possible to use voice command instead of manual operation to control vehicle electrical appliances. Drivers can control vehicle electrical appliances through voice commands, thus reducing the driver's operating burden and greatly improving the driving safety factor. In this paper, the vehicle electrical appliances are taken as the control object, the hardware platform of single chip microcomputer is used as the carrier, the MFCC is used as the feature parameter of speech recognition, and the special speech recognition module based on LD3320 is used to realize the driver's control to vehicle audio, vehicle air conditioning, vehicle windows and so on. © 2019 Association for Computing Machinery.},
 author = {Su, Yuping},
 doi = {10.1145/3372047.3372105},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 2},
 pages = {88 - 92},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on vehicle control system based on speech recognition technology},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85078363018?origin=resultslist},
 year = {2019}
