@inproceedings{10775035,
 abstract = {The transition to electric vehicles (EVs) is critical for reducing carbon emissions and mitigating climate change. However, the widespread adoption of EVs faces challenges, particularly in establishing an efficient and sustainable charging infrastructure. This paper proposes a groundbreaking solution that merges renewable energy and wireless technology to revolutionize EV charging. Our approach centres on the integration of solar-powered wireless charging technology, marking a significant departure from conventional charging methods. Solar panels harness sunlight, converting it into electrical energy that is stored in batteries for on-demand usage. This renewable energy source ensures sustainability and reduces dependency on non-renewable power grids. The core innovation lies in the wireless power transmission mechanism, which utilizes magnetic induction between transmitter and receiver coils. This eliminates the need for physical connectors or cables, offering seamless and hassle-free charging experiences for EV owners. By leveraging wireless technology, our system enhances accessibility to charging points and reduces wear and tear associated with conventional plug-in methods. Moreover, our solution addresses key challenges in EV charging infrastructure. By leveraging solar energy, we significantly reduce the environmental impact associated with traditional charging methods, contributing to a cleaner and greener transportation ecosystem. Additionally, the reliability of our system is enhanced, as it operates independently of grid dependencies, thereby ensuring uninterrupted charging services even in remote or off-grid locations. We believe that our approach holds immense promise in accelerating the adoption of EVs and fostering a more environmentally conscious future.},
 author = {Saraf, Nikhil and Pachkale, Rina and Sherkhane, Mitali and Kulkarni, Sukanya},
