@article{CAI2026132231,
 abstract = {To address the critical challenge of data scarcity in prohibited item detection within security screening, this paper proposes XSC-DM, a novel conditional diffusion model for security image synthesis. Leveraging dual-energy X-ray imaging, we developed the GSXray dataset for generating X-ray images of prohibited items and security image synthesis. The XSC-DM framework integrates three key components: a random generation module, a dual-branch conditional feature generator, and a conditional diffusion model. The random generation module produces diverse X-ray prohibited item images, effectively overcoming the limitations imposed by the natural occurrence probability of prohibited items. The dual-branch feature generator separately processes prohibited items and packages via hierarchical downsampling, incorporating spatial-channel attention to capture multi-scale discriminative features. These conditioned features feed into the reverse denoising network in the conditional diffusion model, enabling iterative synthesis of high-quality X-ray security images. Comprehensive experimental evaluations, including qualitative, quantitative, and subjective comparisons with state-of-the-art methods, demonstrate the superior performance of our approach. By merging synthesized and real-world X-ray images into a composite dataset and using YOLOv11 for detection, the experimental results reveal that our synthesized X-ray security images significantly enhance data augmentation for prohibited item detection, leading to substantial improvements in detection performance. The code is available at https://github.com/caida123/XSC-DM.},
 author = {Da Cai and Tong Jia and Bowen Ma and Hao Wang and Mingyuan Li and Dongyue Chen},
 doi = {https://doi.org/10.1016/j.neucom.2025.132231},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {X-ray security image synthesis, Conditional diffusion model, Data augmentation, Random generation module, Prohibited item detection},
 pages = {132231},
 title = {Conditional diffusion models for X-ray security image synthesis: Addressing data scarcity in security inspection tasks},
 url = {https://www.sciencedirect.com/science/article/pii/S0925231225029030},
 volume = {669},
 year = {2026}
}
