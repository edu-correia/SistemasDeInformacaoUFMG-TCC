@inproceedings{10505984,
 abstract = {The semiconductor memories in an electronic circuit is used to store the binary information fed into it. In the present scenario, with the increase in the density of the digital circuit per mm2 area any slight variation in the powersupply causes MCU's (Multiple Cell Upsets) in the memory these are called soft errors which are temporary and can be corrected using EDAC (Error Detection and Correction Codes). In this research study, Decimal Matrix Code (DMC) for MBU's(Multiple Bit Upsets) detection and correction is selected and further analyzed by taking 32-bit data length arranged in two configurations 8×4 and 4×8 respectively. It was found that, the4×8 configuration also has multi bit error correcting capability for unique error patterns which are listed as Type 6 errors under 4×8 configuration and also with reduced overhead of 18.75% than the existing model. In this research study, the new error pattern of failure case in DMC technique is identified and has overcome by using switching technique with diagonal hamming method.},
 author = {B, Rajeshwari. and Gururaj, K.},
 booktitle = {2023 Third International Conference on Ubiquitous Computing and Intelligent Information Systems (ICUIS)},
 doi = {10.1109/ICUIS60567.2023.00049},
 issn = {},
 keyword = {Monte Carlo methods;Merging;Memory management;Switches;Ubiquitous computing;Error correction codes;Error correction;Decimal Matrix Code 8×4 and 4×8 Configuration;Diagonal Hamming;Switching Technique;Multi Bit Upsets;& Soft errors},
 month = {Sep.},
 number = {},
 pages = {244-250},
 title = {Switching ECC Techniques with Decimal Matrix Code and Diagonal Hamming Code},
 volume = {},
 year = {2023}
}
