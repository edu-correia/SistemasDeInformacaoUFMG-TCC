@conference{Sharma2025,
 abstract = {The integration of blockchain technology into smart grids presents a transformative approach to enhancing energy distribution efficiency, transparency, and security. However, existing blockchain platforms often suffer from scalability limitations, high transaction costs, and latency, making them unsuitable for real-time energy transactions This Paper presents a blockchain-based smart grid framework that utilizes the solana ledger. Solana is a high-throughput (50,000 TPS) and low-cost ($0.00025 per transaction) blockchain that utilizes Proof-of-History (PoH) as its consensus mechanism. PoH is a cryptographic primitive that enables the creation of a verifiable time-ordered sequence of events. Solana's architecture allows the decentralized execution of these smart contracts. Providing: (1) Peer-to-peer(P2P) real-time energy trading, and (2) Decentralized methods for real-time grid management, and (3) an automated way to perform settlements between these two types of agents.  © 2025 IEEE.},
 author = {Sharma, Kartik and Sharma, Monika},
 doi = {10.1109/ICRITO66076.2025.11241475},
 journal = {2025 12th International Conference on Reliability, Infocom Technologies and Optimization ,Trends and Future Directions, ICRITO 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Smart Grids on Blockchan Using Solana as a Ledger},
 type = {Conference paper},
