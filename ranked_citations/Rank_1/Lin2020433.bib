@article{Lin2020433,
 abstract = {Scene texts contain rich semantic information which may be used in many vision-based applications, and consequently detecting and recognizing scene texts have received increasing attention in recent years. In this paper, we first introduce the history and progress of scene text detection and recognition, and classify conventional methods in detail and point out their advantages as well as disadvantages. After that, we study these methods and illustrate the corresponding key issues and techniques, including loss function, multi-orientation, language model and sequence labeling. Finally, we describe commonly used benchmark datasets and evaluation protocols, based on which the performance of representative scene text detection and recognition methods are analyzed and compared. © 2019, CIMNE, Barcelona, Spain.},
 author = {Lin, Han and Yang, Peng and Zhang, Fanlong},
 doi = {10.1007/s11831-019-09315-1},
 journal = {Archives of Computational Methods in Engineering},
 note = {Cited by: 90},
 number = {2},
 pages = {433 - 454},
 publication_stage = {Final},
 source = {Scopus},
 title = {Review of Scene Text Detection and Recognition},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85059903516?origin=resultslist},
 volume = {27},
 year = {2020}
}
