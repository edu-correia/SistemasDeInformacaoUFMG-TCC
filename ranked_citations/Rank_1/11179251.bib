@inproceedings{11179251,
 abstract = {3D object detection based on LiDAR point clouds is crucial in autonomous driving systems. However, the sparsity and uneven density of object point clouds result in a significant lack of effective information in their sparse regions. In such scenarios, existing models are limited in capturing the global geometric structure of objects and contextual dependencies between points, and fail to learn key features in regions with dense point clouds. Inspired by the self-attention mechanism and masked language modeling (MLM) of BERT in natural language processing, we propose a new 3D object detection network, Detection-BERT. Specifically, we extend the MLM to the masked point modeling (MPM) task to learn the global geometric features and structural relations between regions with the self-attention mechanism. Additionally, we design a point density-aware masking module to guide the model in learning features of the critical regions with dense point clouds. Following MPM pre-training, the MPM encoder is fine-tuned during the bounding box refinement stage. To fully leverage the strengths of the MPM architecture for point cloud object detection, the fine-tuned features and original proposal features are merged dynamically by an attentionguided feature fusion module. Extensive experiments illustrate that our Detection-BERT achieves highly competitive detection results and outperforms the current mainstream algorithms.},
 author = {Zhang, Wanjing and Wang, Chenxing},
 booktitle = {2025 44th Chinese Control Conference (CCC)},
 doi = {10.23919/CCC64809.2025.11179251},
 issn = {1934-1768},
 keyword = {Point cloud compression;Solid modeling;Three-dimensional displays;Semantics;Object detection;Bidirectional control;Feature extraction;Encoding;Autonomous vehicles;Context modeling;3D Object Detection;Point Clouds;Masked Point Modeling;Self-Attention Mechanism},
 month = {July},
 number = {},
 pages = {8114-8119},
 title = {LiDAR-Based 3D Object Detection via Masked Point Modeling},
 volume = {},
