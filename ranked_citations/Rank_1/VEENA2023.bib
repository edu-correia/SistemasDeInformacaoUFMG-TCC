@article{VEENA2023,
 abstract = {Monovalent Lithium ions are co-doped in the perovskite crystal lattice of La1.98Dy0.02MgTiO6, synthesized via the combustion route. XRD data imply that merging of Li+ ions in the crystal lattice not only enhances the luminescence intensity but also improves the crystal structure by exploiting the flux nature of Li+. The morphology, crystallinity, and shape were confirmed by FE-SEM images. From the UV–Visible spectra, the band gap is found to be 3.55 eV. Photoluminescence studies show that the incorporation of Li+ ions significantly intensified the effulgence that when the doping concentration is 0.01, the emission intensity extended to a prime value, which is two times that of doped samples. The CIE chromaticity coordinates are ×  = 0.325 and y = 0.322, which show near-ideal white light emission, which makes it a potential matrix for WLED applications.},
 author = {V.P. Veena and N. Akshaya and C.K. Shilpa and S.V. Jasira and K.M. Nissamudeen},
 doi = {https://doi.org/10.1016/j.matpr.2023.03.307},
 issn = {2214-7853},
 journal = {Materials Today: Proceedings},
 keyword = {Double perovskite, Luminescence, White emitting phosphor},
 title = {The upshot of Li+ co-doping on white emission of La1.98Dy0.02MgTiO6 double perovskite nano phosphors},
 url = {https://www.sciencedirect.com/science/article/pii/S2214785323013500},
 year = {2023}
}
