@article{VACHHANI2025126531,
 abstract = {Heat transfer in pool boiling applications can be enhanced by surface modifications. Among the various potentially useful approaches that have been proposed, biphilic surfaces have shown promise as a relatively simple and cost effective thermal–enhancement approach. Biphilic surfaces are heterogeneous wettability surfaces comprised of a mix of hydrophobic and hydrophilic regions. Nucleate boiling experiments on biphilic surfaces often show an improvement in surface heat flux compared to homogeneous hydrophobic and hydrophilic surfaces. Using a uniform array of square hydrophobic islands on a hydrophilic background, we carry out direct numerical simulations to help identify the dominant mechanisms that affect heat transfer on biphilic surfaces. We characterize the thermal performance of biphilic surfaces as a function of the ratio of hydrophobic and hydrophilic surface areas using an isothermal heater while keeping all other parameters fixed. Our results indicate that, similar to experimental observations, a peak in the heat transfer rate occurs for an intermediate area ratio. We show that the nucleated bubbles are attracted preferentially to the hydrophobic islands where they become confined. When these bubbles grow, they merge to form large vapor structures which are anchored to the heater surface at multiple islands. As a result, a thin evaporating liquid layer is trapped under the vapor structure, between the wall and the vapor–liquid interface. We identify the steep temperature gradient within this liquid layer as the characteristic mechanism associated with the high heat flux on biphilic surfaces. Using local temperature profiles, turbulent heat flux and a heat flux partitioning approach, we show that this mechanism is most effective for an intermediate size of the hydrophobic islands.},
 author = {Shantanu Vachhani and Amir Riaz and Elias Balaras},
 doi = {https://doi.org/10.1016/j.ijheatmasstransfer.2024.126531},
 issn = {0017-9310},
 journal = {International Journal of Heat and Mass Transfer},
 keyword = {Pool boiling, Biphilic, Direct Numerical Simulations (DNS), Multiphase flow},
 pages = {126531},
 title = {Numerical simulation of pool boiling on biphilic surfaces},
 url = {https://www.sciencedirect.com/science/article/pii/S0017931024013590},
 volume = {239},
 year = {2025}
}
