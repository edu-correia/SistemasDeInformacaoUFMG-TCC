@article{HUANG2022167286,
 abstract = {The electron cooler at the experimental Cooler Storage Ring (CSRe) has been upgraded with an embedded electron energy fast detuning system for the merged-beams electron–ion collision experiments. A plastic scintillation detector (PSD) and a multi-wire proportional chamber (MWPC) detector have been developed and installed downstream of the electron cooler to detect the recombined and ionized ions in the electron–ion collision experiments at the CSRe. Both detectors have been tested successfully in a recent dielectronic recombination (DR) experiment of Na-like Kr25+ ions at the CSRe. In addition, the measured DR rate coefficients for Kr25+ ions from both detectors were compared with the flexible atomic code (FAC) calculations, and a very good agreement is achieved. The present experimental results demonstrate that the new experimental setups at the CSRe including the electron energy fast detuning system and the particle detectors have high stability and efficiency and meet the needs of the forthcoming electron–ion collision precision spectroscopy at the CSRe.},
 author = {Z.K. Huang and N. Khan and S.X. Wang and W.Q. Wen and H.B. Wang and W.L. Ma and L. Shao and H.K. Huang and X. Liu and D.Y. Chen and X.P. Zhou and D.M. Zhao and H.R. Yang and L.J. Mao and X.M. Ma and J. Li and M.T. Tang and Y.B. Zhou and K.M. Yan and D.Y. Yin and J.C. Yang and Y.J. Yuan and S.F. Zhang and L.F. Zhu and X. Ma},
 doi = {https://doi.org/10.1016/j.nima.2022.167286},
 issn = {0168-9002},
 journal = {Nuclear Instruments and Methods in Physics Research Section A: Accelerators, Spectrometers, Detectors and Associated Equipment},
 keyword = {Electron–ion collisions, Plastic scintillation detector, Multi-wire proportional chamber detector, Heavy-ion storage ring},
 pages = {167286},
 title = {Development of particle detectors for electron–ion collision spectroscopy with highly charged ions at the storage ring CSRe},
 url = {https://www.sciencedirect.com/science/article/pii/S016890022200612X},
 volume = {1040},
 year = {2022}
}
