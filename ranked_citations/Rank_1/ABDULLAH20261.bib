@incollection{ABDULLAH20261,
 abstract = {The rapid advancements in high-throughput omics technologies have revolutionized our understanding of plant biology by enabling the comprehensive analysis of genomes, transcriptomes, proteomes, metabolomes, and epigenomes. However, the independent study of these datasets often limits insights into the complex regulatory networks governing plant growth, development, and stress responses. Systems biology offers a powerful integrative framework to merge multiomics data, enabling the modeling and prediction of biological behavior from genotype to phenotype and vice versa. This chapter explores the application of integrative systems biology in crop science, highlighting how genomic, transcriptomic, proteomic, and metabolomic tools are utilized to decipher the molecular mechanisms underlying complex agronomic traits such as yield, nutrient use efficiency, and stress tolerance. We discuss network analysis, dynamic modeling, and machine learning as critical tools for understanding and predicting plant responses under varying environmental conditions. Additionally, we emphasize the significance of systems biology in sustainable agriculture by focusing on soil–plant–microbiome interactions, precision breeding, biomarker development, and climate resilience. Overall the chapter underscores the transformative potential of systems biology to guide future crop improvement strategies through a holistic, data-driven approach.},
 author = { Abdullah and Sania Rehman and Kaiser Iqbal Wani and M. Naeem and Tariq Aftab},
 booktitle = {Systems Biology in Crop Improvement},
 doi = {https://doi.org/10.1016/B978-0-443-36457-0.00013-4},
 editor = {Tariq Aftab},
 isbn = {978-0-443-36457-0},
 keyword = {Crop improvement, Epigenetics, Metabolomics, Omics analyses},
 pages = {1-16},
 publisher = {Academic Press},
 series = {Systems Biology in Agriculture and Plant Sciences},
 title = {Chapter 1 - Introduction to systems biology in crop improvement},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443364570000134},
 year = {2026}
}
