@inproceedings{11347945,
 abstract = {Steel are key materials in modern manufacturing. Surface defects like scratches, cracks, and dents greatly affect product quality and production speed. Traditional detection methods can be easily influenced by lighting and noise, making it hard to achieve high-precision, real-time detection. An enhanced detector, named YOLOv8 HD and incorporating the HSPAN and DySample mechanisms, is developed by extending the baseline YOLOv8 structure. By adding the Hierarchical Spatial Pyramid Attention Network (HSPAN) and the Energetic Upsampling Module (DySample), the model better detects defects in different sizes and complex backgrounds. The HSPAN module helps combine features from different scales more effectively. The C2f module improves how detailed and semantic features are merged. DySample enhances the detail in feature maps by using adaptive upsampling. Experiments on the NEU-DET steel surface defects dataset show that the proposed model outperforms the existing mainstream methods in key metrics such as computational complexity (GFLOPs) and average accuracy (mAP50 and mAP50-95), which verifies its superiority and practicability in the steel surface defects detection task.},
 author = {Lu, Xunqi and Cai, Jianhang and Feng, Yu and Lv, Zhongliang and Zhou, Chuande and Liu, Jiaqiong},
 booktitle = {2025 IEEE International Conference on Sensing, Diagnostics, Prognostics, and Control},
 doi = {10.1109/SDPC68151.2025.11347945},
 issn = {},
 keyword = {Measurement;Adaptation models;Technological innovation;Computational modeling;Semantics;Object detection;Real-time systems;Sensors;Steel;Surface cracks;Steel Surface Flaw;Yolov8;Multi-Scale Feature Fusion;Dynamic Upsampling},
 month = {Nov},
 number = {},
 pages = {469-474},
 title = {Based on the YOLOv8-HD Network Steel Surface Flaw Detection Method},
 volume = {},
