@inproceedings{4496987,
 abstract = {This paper first outlines an advanced integrated protection scheme based on the latest developments in protection and communication technologies. The paper then gives a description of the communication networks and systems in substations based on the IEC61850 standard. The paper emphasizes the construction of the information model and the analysis of communication capacity of IEC61850 for the integrated protection system. Studies indicate that the application of IEC61850 will provide a good opportunity for the development of the advanced integrated protection scheme, and make it easy to implement real time data exchange in substations, which will promote further development in the field of power system protection.},
 author = {Ren, Yingli and He, Jinghan and Bo, Z.Q. and Richards, S. and Klimek, A.},
 booktitle = {2008 IET 9th International Conference on Developments in Power System Protection (DPSP 2008)},
 doi = {10.1049/cp:20080039},
 issn = {0537-9989},
 keyword = {Relays;Substations;Protocols;Merging;Real time systems;Circuit faults;Circuit breakers},
 month = {March},
 number = {},
 pages = {218-223},
 title = {Research on Real-Time Communication Capacity of IEC61850 Applied in Integrated Protection Systems},
 volume = {},
 year = {2008}
}
