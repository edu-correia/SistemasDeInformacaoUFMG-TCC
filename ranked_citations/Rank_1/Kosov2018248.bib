@article{Kosov2018248,
 abstract = {The labeling of Environmental Microorganisms (EM) which help decomposing pollutants, plays a fundamental role for establishing sustainable ecosystem. We propose an environmental microorganism classification engine that can automatically analyze microscopic images using Conditional Random Fields (CRF) and Deep Convolutional Neural Networks (DCNN). First, to effectively represent scarce training images, a DCNN pre-trained for image classification using a large amount of data is re-purposed to our feature extractor that distils pixel-level features in microscopic images. In addition, pixel-level classification results by such features can be refined using global features that describe the whole image in toto. Finally, our CRF model localizes and classifies EMs by considering the spatial relations among DCNN-based features, and their relations to global features. The experimental results have shown 94.2% of overall segmentation accuracy and up to 91.4% mean average precision of the results. © 2017 Elsevier Ltd},
 author = {Kosov, Sergey and Shirahama, Kimiaki and Li, Chen and Grzegorzek, Marcin},
 doi = {10.1016/j.patcog.2017.12.021},
 journal = {Pattern Recognition},
 note = {Cited by: 81},
 pages = {248 - 261},
 publication_stage = {Final},
 source = {Scopus},
 title = {Environmental microorganism classification using conditional random fields and deep convolutional neural networks},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85044640362?origin=resultslist},
 volume = {77},
 year = {2018}
}
