@article{Manogaran202645,
 abstract = {Multimodality based medical image fusion is a developing technology in which medical images are fused with complementary details. In the existing multimodal fusion techniques, low contrast and color distortions are caused during image integration. Preserving significant detail in best contrast is still challenging one. In this work, a unique technique for multimodality based image fusion is proposed based on Essential Patch Corrosion (EPC) and Effective Compatible Cloud Model (CCM). First, the source images are decomposed into multiple sub-images in which the EPC technique is applied to retrieve salient features for discrimination. Second, the CCM is applied to fuse the significant details from the images. Additionally, Salience Equivalent Mechanism (SEM) along with CCM is used to merge the residual details. Finally, reconstructing the image is done using inverse EPC and the experimental demonstration for this proposed system is given. The proposed work shows the improvement significantly with maximum contrast and minimized color distortion in the target images. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
 author = {Manogaran, Nalini and Nair, Resmi R. and Annamalai, Suresh and Balusamy, Balamurugan and Veluvali, Parimala and Tanwar, Sushama},
 doi = {10.1007/978-3-032-00793-3_5},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 0},
 pages = {45 - 61},
 publication_stage = {Final},
 source = {Scopus},
 title = {EPC-CCM Based Salience Equivalent Mechanism for Multimodal Medical Image},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105015719105?origin=resultslist},
 volume = {2621 CCIS},
 year = {2026}
}
