@conference{Nazer201796,
 abstract = {Let X and Y be dependent random variables. We consider the problem of designing a scalar quantizer for Y to maximize the mutual information between its output and X, and study fundamental properties and bounds for this form of quantization. Our main focus is the regime of low I(X;Y), where we show that for a binary X, there always exists an M-level quantizer attaining mutual information of Ω(-M · I(X;Y)/log(I(X;Y)) and that there exist pairs of X, Y for which the mutual information attained by any M-level quantizer is O(-M · I(X; Y)/log(I(X; Y))). © 2017 IEEE.},
 author = {Nazer, Bobak and Ordentlich, Or and Polyanskiy, Yury},
 doi = {10.1109/ISIT.2017.8006497},
 journal = {IEEE International Symposium on Information Theory - Proceedings},
 note = {Cited by: 21; All Open Access; Green Open Access},
 pages = {96 - 100},
 publication_stage = {Final},
 source = {Scopus},
 title = {Information-distilling quantizers},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85034078577?origin=resultslist},
 year = {2017}
}
