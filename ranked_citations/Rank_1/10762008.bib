@inproceedings{10762008,
 abstract = {This article delves into the key technologies for time-series data storage in embedded environments. Time-series data, arranged in chronological order, is crucial for various applications such as IoT, finance, and industrial monitoring. Time Series Databases (TSDBs) excel in managing large-scale, high-frequency time-series data, leveraging column-store storage and partitioning techniques for efficient data compression and accelerated query speeds. However, deploying TSDBs in embedded systems poses challenges due to resource constraints, real-time requirements, and low power consumption needs. The article analyzes existing TSDB data models and data structures, focusing on cost-effective historical data storage and handling out-of-order data to reduce storage space and conserve computational resources. It highlights the challenges for adapting TSDBs to embedded environments.},
 author = {Yuan, Zelan and Ren, Dewang and Zhao, Yao and Wang, Yuyan},
 booktitle = {2024 5th International Conference on Big Data & Artificial Intelligence & Software Engineering (ICBASE)},
 doi = {10.1109/ICBASE63199.2024.10762008},
 issn = {},
 keyword = {Out of order;Power demand;Databases;Reviews;Time series analysis;Memory;Organizations;Real-time systems;Research and development;Software engineering;time series database;embedded environments;LSM-tree;data compression;out-of-order data handling},
 month = {Sep.},
 number = {},
 pages = {125-128},
 title = {A Review of Key Technologies for Time-Series Data Storage in Embedded Environments},
 volume = {},
 year = {2024}
}
