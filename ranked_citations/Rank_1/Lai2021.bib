@conference{Lai2021,
 abstract = {This article presents mixing receiver of the low noise amplifier with back-gated QVCO using double balance mixer with doublers to merge low noise amplifier and LC-resonator quadrature voltage-controlled oscillator (QVCO) form balun circuit. The proposed QVCO can degrade NMOS subthreshold voltage. The proposed double balance mixer with doublers describes broadband integrated design, operation principle and experimental of the mixing receiver from low noise amplifier (LNA) and QVCO with balun circuit. The proposed QVCO circuit is composed of an LC resonator (C is a parasitic capacitor), NMOS cross-coupled, back gate resister, bias resistor, and DC block of capacitors. The mixing receiver implemented in tsmc CMOS process can be used in wireless radio frequency communication systems. © 2021 IEEE.},
 author = {Lai, Wen-Cheng},
 doi = {10.1109/ICECET52533.2021.9698619},
 journal = {International Conference on Electrical, Computer, and Energy Technologies, ICECET 2021},
 note = {Cited by: 6},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mixing Wake-up Receiver of Low Noise Amplifier with Back-gated QVCO},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85127043944?origin=resultslist},
 year = {2021}
}
