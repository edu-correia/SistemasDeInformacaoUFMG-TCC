@inproceedings{11379269,
 abstract = {Accurate and earlier time prediction of cardiac risks that cover a hospital network with several facilities is increasingly demanding, but confirming patient privacy is a major challenge. A federated type deep learning model is the solution for this problem, as it allows multi-hospital collaboration without the requirement for centralizing the highly sensitive patient data. The proposed system will be a secure federated learning system where local models are trained independently at each health-related data-sets and are merged through privacy-preserving protocols to form a global predictive model. To improve the prediction's reliability, deep learning system are used for the integration of the framework to capture the complex, non-linear relations between clinical and its diagnostic data. With this approach, the system becomes better with the contribution of each institution while the data ownership remains with them only. The system uses sophisticated optimization strategies to ensure that the process of merging results from different hospital datasets that are not the same can be carried out efficiently thus minimizing the impacts of data imbalance and distributional variations. The key achievement is to bring multiple healthcare experts together under a privacy-preserving deep learning mechanism, thereby offering a cardiac risk prediction solution that is scalable and secure, and at the same time, enhances generalization, abides by patient confidentiality, and encourages data-driven medical care.},
 author = {Shaikh, Ummehani H. and Shah, Dev A. and Dhanwade, Pratham and Patel, Sudeep and Verma, Shanti},
 booktitle = {2025 3rd DMIHER International Conference on Artificial Intelligence in Healthcare, Education and Industry (IDICAIHEI)},
 doi = {10.1109/IDICAIHEI65991.2025.11379269},
 issn = {},
 keyword = {Deep learning;Training;Analytical models;Accuracy;Hospitals;Memory management;Collaboration;Predictive models;Optimization;Convergence;Federated based deep learning;privacy-preserving healthcare;multi-hospital collaboration;cardiac health risk prediction;distributed type learning;secure model collection;healthcare analytics;information confidentiality;medical AI;collaborative type prediction systems},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Federated Deep Learning on Privacy-Preserving Multi-Hospital Cardiac Health Risk Prediction},
 volume = {},
 year = {2025}
}
