@inproceedings{10129762,
 abstract = {Fan-out panel level packaging is a promising advanced packaging technology. It can easily achieve heterogenous integration by merging functional chips into a single module. However, the electrical quality and mechanical stress balances become more challenge. In a package structure, Cu redistribution layer (RDL) not only offers an interconnection platform but also plays a key role in affecting electrical and mechanical performance of whole system. Ideally a uniform Cu trace will lead to a better reliability performance. But when process area become larger, especially in fan-out panel level packaging (FOPLP), it is difficult to improve RDL thickness uniformity within panel (WIP) by sustaining a uniform electric and fluidic distributions in a large electroplating (ECP) system. This study proposes and experiments an effective way to diminish the trace thickness variation by adding and modulating pattern design. Via this technology the thickness variation can be optimized by each product, and thus enlarging the utilization area of panels.},
 author = {Chiang, Yuan-Feng and Wu, Boyin and Kuo, Mingtzung and Yang, Jeffrey and Fang, Jen-Kuang},
 booktitle = {2023 International Conference on Electronics Packaging (ICEP)},
 doi = {10.23919/ICEP58572.2023.10129762},
 issn = {},
 keyword = {Electrochemical deposition;Geometry;Firewalls (computing);Merging;Packaging;Hardware;Reliability;Electroplating;Panel;Uniformity;Fan-out},
 month = {April},
 number = {},
 pages = {63-64},
 title = {Electroplating Uniformity Enhancement for High Performance Fan-Out Panel Level Packaging},
 volume = {},
 year = {2023}
}
