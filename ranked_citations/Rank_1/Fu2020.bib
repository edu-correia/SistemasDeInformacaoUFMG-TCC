@conference{Fu2020,
 abstract = {This paper describes our product matching system developed for Semantic Web Challenge on Mining HTML-embedded Product Data 2020 (Task 1). Product matching is the task of identifying product offers deriving from different websites that refer to the same real-world product, which is a typical scenario of entity matching (EM). In our system, we implement four state-of-theart deep learning-based entity matching models and integrate their results to get the final product matching predictions. Competition results show that, our system obtains promising performance on this task.  Copyright © 2020 for this paper by its authors.},
 author = {Fu, Cheng and Wang, Tianshu and Nie, Hao and Han, Xianpei and Sun, Le},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {ISCAS_ICIP at MWPD-2020 task 1: Product matching based on deep entity matching frameworks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85095965227?origin=resultslist},
 volume = {2720},
 year = {2020}
}
