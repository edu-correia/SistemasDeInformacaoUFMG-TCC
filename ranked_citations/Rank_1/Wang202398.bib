@conference{Wang202398,
 abstract = {Aiming at the current problem of mobile robot navigation control accuracy, this paper proposes a control method based on fuzzy neural networks and PID. The image processing algorithm extracts the navigation line and calculates the robot position by using RTK-GPS/UWB after obtaining the visual information. A navigation controller based on a fuzzy neural network is designed to generate the target heading angle, calculated by the lower computer combined with the motion model. A PID-based controller is designed to control walking and steering. The deviation is calculated to adjust the position of the robot to further improve the navigation accuracy. This method is verified in a simulated farmland environment. The experiments show that the position calculation results are consistent with the measured results. The proposed method can improve the control accuracy of the robot. The whole navigation system has high real-time performance and can meet actual needs.  © 2023 IEEE.},
 author = {Wang, Zixiao and He, Chuangxin and Miao, Zhonghua},
 doi = {10.1109/ACCTCS58815.2023.00070},
 journal = {Proceedings - 2023 3rd Asia-Pacific Conference on Communications Technology and Computer Science, ACCTCS 2023},
 note = {Cited by: 3},
 pages = {98 - 102},
 publication_stage = {Final},
 source = {Scopus},
 title = {Navigation control of mobile robot based on fuzzy neural network},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85163774299?origin=resultslist},
 year = {2023}
}
