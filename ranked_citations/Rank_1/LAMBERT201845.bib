@incollection{LAMBERT201845,
 abstract = {Early genomic technologies, such as low-resolution cytogenetic testing, shaped worldviews which continue to influence our approach to decision making in genomic medicine as variant detection and reporting in clinical cytogenetics and whole-genome sequencing merge into a hybrid field of clinical cytogenomics. In particular, as our capacity to sequence the human genome has grown exponentially, our capacity to turn this data into understanding has not kept pace. Large signals detectable by early technologies such as extra copies of whole chromosomes, or 100% penetrant Mendelian monogenic mutations, could be reported as the “certain” cause for a disease. Higher-resolution assays have provided both more information and more uncertainty. As a result, in medical genetic decision making, the two poles of the central conflict may be verbalized as: “provide only the information that is certain in order to avoid making errors of commission” versus “provide as much information as possible in order to avoid making errors of omission.” That is, the conflict is one of specificity versus sensitivity. At the same time, what is “certain” is continuously being revised and subject to debate, and there are many diseases with complex genetic risk architectures, negating the fantasy that certainty can be achieved. The advent of high-resolution genome-wide microarrays, followed by whole-exome and whole-genome sequencing, has only exacerbated this conflict, as physicians attempt to perform decision making under uncertainty using a genomics knowledge base that exceeds the capacity of any one person to synthesize and comprehend.},
 author = {Christophe G. Lambert},
 booktitle = {Human Genome Informatics},
 doi = {https://doi.org/10.1016/B978-0-12-809414-3.00003-6},
 editor = {Christophe G. Lambert and Darrol J. Baker and George P. Patrinos},
 isbn = {978-0-12-809414-3},
 keyword = {Cytogenetics, Cytogenomics, Copy number variation, Whole-genome sequencing, Chromosomal microarrays (CMA), Bacterial artificial chromosome (BAC), Karyotyping, Mosaicism, Decision making, Errors of omission, Errors of commission},
 pages = {45-59},
 publisher = {Academic Press},
 title = {Chapter 3 - How Cytogenetics Paradigms Shape Decision Making in Translational Genomics},
 url = {https://www.sciencedirect.com/science/article/pii/B9780128094143000036},
 year = {2018}
}
