@inproceedings{5495190,
 abstract = {This paper proposes an efficient codebook design for tree-structured vector quantization (TSVQ), which is embedded in nature. We modify two speech coding standards by replacing their original quantizers for line spectral frequencies (LSF's) and/or Fourier magnitudes quantization with TSVQ-based quantizers. The modified coders are fine-granular bit-rate scalable with gradual change in quality for the synthetic speech.},
 author = {Djamah, Mouloud and O'Shaughnessy, Douglas},
 booktitle = {2010 IEEE International Conference on Acoustics, Speech and Signal Processing},
 doi = {10.1109/ICASSP.2010.5495190},
 issn = {2379-190X},
 keyword = {Vector quantization;Speech coding;Binary trees;Merging;Scalability;Frequency;Algorithm design and analysis;Code standards;Telecommunication traffic;Measurement;Speech coding;tree-structured vector quantization;embedded quantization;scalability},
 month = {March},
 number = {},
 pages = {4686-4689},
 title = {An efficient tree-structured codebook design for embedded vector quantization},
 volume = {},
 year = {2010}
}
