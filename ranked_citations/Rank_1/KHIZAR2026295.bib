@incollection{KHIZAR2026295,
 abstract = {Advancement of thin film assembly combining multicomponent hybrid nanomaterials is the most widespread and efficacious tool to prompt desired biological reactions at cellular and molecular level. Designing of nanostructured thin films needs the merging of investigation from chemistry, physics, material science, medicine, and biology. As compared to other techniques, layer-by-layer (LBL) self-assembly technology exists as an utmost encouraging and advantageous approach attributable to the adaptability of fabrication of diverse multiple shells with precise conformation and structures. LBL is an ecofriendly, simple, low-cost, and takes place in ambient conditions. It exhibits numerous benefits such as accurate and versatile regulation of coating of all available surfaces. The development of thin films onto the solid substrate delivers prescribed conditions for technical research, investigation, measurements, or trials without a formal laboratory for uses in tissue engineering, biosensors, drug delivery, hyperthermia, as well as in diagnostic tests. In view of this, we discuss the fabrication of thin films using different inorganic and organic and biomaterials and also provide the soundproof of concept on the potential thin films for biomedical utilizations.},
 author = {Sumera Khizar and Nadia Zine and Nicole Jaffrezic-Renault and Abdelhamid Errachid},
 booktitle = {Micro and Nano Colloids and Their Biomedical Applications},
 doi = {https://doi.org/10.1016/B978-0-443-26608-9.00007-X},
 editor = {Abdelhamid Elaissari and Sumera Khizar and Ebtesam A. Al-Suhaimi},
 isbn = {978-0-443-26608-9},
 keyword = {Biosensors, Drug delivery, Functionalization, Layer-by-layer, MRI, Polyelectrolytes, Thin films, Tissue engineering},
 pages = {295-310},
 publisher = {Elsevier},
 series = {Micro and Nano Technologies},
 title = {Chapter 10 - Functional layer-by-layer thin films: From self-assembly to biomedical applications},
 url = {https://www.sciencedirect.com/science/article/pii/B978044326608900007X},
 year = {2026}
}
