@article{10.1145/3527168,
 abstract = {We present StyleFusion, a new mapping architecture for StyleGAN, which takes as input a number of latent codes and fuses them into a single style code. Inserting the resulting style code into a pre-trained StyleGAN generator results in a single harmonized image in which each semantic region is controlled by one of the input latent codes. Effectively, StyleFusion yields a disentangled representation of the image, providing fine-grained control over each region of the generated image. Moreover, to help facilitate global control over the generated image, a special input latent code is incorporated into the fused representation. StyleFusion operates in a hierarchical manner, where each level is tasked with learning to disentangle a pair of image regions (e.g., the car body and wheels). The resulting learned disentanglement allows one to modify both local, fine-grained semantics (e.g., facial features) as well as more global features (e.g., pose and background), providing improved flexibility in the synthesis process. As a natural extension, StyleFusion allows one to perform semantically-aware cross-image mixing of regions that are not necessarily aligned. Finally, we demonstrate how StyleFusion can be paired with existing editing techniques to more faithfully constrain the edit to the user’s region of interest. Code is available at: .},
 address = {New York, NY, USA},
 articleno = {179},
 author = {Kafri, Omer and Patashnik, Or and Alaluf, Yuval and Cohen-Or, Daniel},
 doi = {10.1145/3527168},
 issn = {0730-0301},
 issue_date = {October 2022},
 journal = {ACM Trans. Graph.},
 keyword = {Generative Adversarial Network, image generation, disentangled representation},
 month = {October},
 number = {5},
 numpages = {15},
 publisher = {Association for Computing Machinery},
 title = {StyleFusion: Disentangling Spatial Segments in StyleGAN-Generated Images},
 url = {https://doi.org/10.1145/3527168},
 volume = {41},
 year = {2022}
}
