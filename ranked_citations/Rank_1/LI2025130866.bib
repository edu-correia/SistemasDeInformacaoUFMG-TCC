@article{LI2025130866,
 abstract = {The density peaks clustering (DPC) algorithm was introduced in 2014. It is a density-based method that quickly identifies density peaks. However, DPC still has certain limitations. It often struggles to determine accurate cluster centers in datasets containing both sparse and dense clusters. To overcome the problem, an innovative design enhances the algorithm to focus on sparse clusters. In this paper, we propose a density variation and inverse outliers clustering algorithm for datasets with large density differences (DVIOC), which aims to efficiently distinguish sparse and dense clusters while suppressing the occurrence of cascading errors. Firstly, we modify the local density calculation using a varying correlation coefficient formula to enhance the accuracy of the density computation. Then, the selected representative points are merged to determine the appropriate cluster centers. In a novel assignment strategy, the local outlier factor (LOF) is applied to identify normal points in reverse. These normal points constitute the main structure of the clusters and form microclusters. Ultimately, the residual points are assigned by dynamic fuzzy weighted, which uses an affiliation degree to assign each point into the appropriate clusters. A series of experiments on synthetic datasets and UCI datasets demonstrate the superiority of the DVIOC algorithm over other state-of-the-art algorithms. In particular, the algorithm demonstrates strong robustness to significant inter-cluster differences and outlier boundaries within the dataset.},
 author = {Xiangli Li and Yalin Kou and Yongqi Mi},
 doi = {https://doi.org/10.1016/j.neucom.2025.130866},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {Density peaks, Local outliers factor, Fuzzy weighted method, Clustering},
 pages = {130866},
 title = {A density variation and inverse outliers clustering algorithm for datasets with large density differences},
 url = {https://www.sciencedirect.com/science/article/pii/S0925231225015383},
 volume = {650},
 year = {2025}
}
