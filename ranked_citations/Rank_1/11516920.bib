@inproceedings{11516920,
 abstract = {As power demands in data centers escalate with the proliferation of artificial intelligence (AI) workloads and high-performance computing, high-efficiency, high–power-density DC-DC converters are becoming increasingly critical in power delivery systems. This paper proposes a novel integrated magnetic core geometry for a multiphase LLC converter. By merging two discrete EI cores into a single structure, the design eliminates the induced current in non-conducting windings caused by uncanceled flux and reduces the primary winding resistance by 50%. A 48V to 3V LLC converter prototype delivering 140A output is developed, achieving a power density of 1008W/in3 and a peak efficiency of 95.6%.},
 author = {Du, Jinshi and Sanusi, Bima Nugraha and Wang, Pinhe and Luo, Tianming and Ouyang, Ziwei},
 booktitle = {2026 IEEE Applied Power Electronics Conference and Exposition (APEC)},
 doi = {10.1109/APEC51134.2026.11516920},
 issn = {2470-6647},
 keyword = {Windings;Transformers;Wind;Current;Data centers;Tagging;Converters;Design methodology;Equations;Switches;LLC DCX;planar matrix transformer;magnetic integration;high power density},
 month = {March},
 number = {},
 pages = {2063-2068},
 title = {An LLC DCX with Matrix Transformer for Datacenter Application},
 volume = {},
 year = {2026}
}
