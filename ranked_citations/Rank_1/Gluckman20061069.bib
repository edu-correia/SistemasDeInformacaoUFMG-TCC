@conference{Gluckman20061069,
 abstract = {Multi-scale representations are motivated by the scale invariant properties of natural images. While many low level statistical measures, such as the local mean and variance of intensity, behave in a scale invariant manner, there are many higher order deviations from scale invariance where zero-crossings merge and disappear. Such scale variant behavior is important information to represent because it is not easily predicted from lower resolution data. A scale variant image pyramid is a representation that separates this information from the more redundant and predictable scale invariant information. © 2006 IEEE.},
 author = {Gluckman, Joshua},
 doi = {10.1109/CVPR.2006.265},
 journal = {Proceedings of the IEEE Computer Society Conference on Computer Vision and Pattern Recognition},
 note = {Cited by: 17},
 pages = {1069 - 1075},
 publication_stage = {Final},
 source = {Scopus},
 title = {Scale variant image pyramids},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33845564947?origin=resultslist},
 volume = {1},
 year = {2006}
}
