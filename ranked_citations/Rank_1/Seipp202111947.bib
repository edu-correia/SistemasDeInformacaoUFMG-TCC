@conference{Seipp202111947,
 abstract = {Saturated cost partitioning and post-hoc optimization are two powerful cost partitioning algorithms for optimal classical planning. The main idea of saturated cost partitioning is to give each considered heuristic only the fraction of remaining operator costs that it needs to prove its estimates. We show how to apply this idea to post-hoc optimization and obtain a heuristic that dominates the original both in theory and on the IPC benchmarks.  © 2021, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
 author = {Seipp, Jendrik and Keller, Thomas and Helmert, Malte},
 doi = {10.1609/aaai.v35i13.17419},
 journal = {35th AAAI Conference on Artificial Intelligence, AAAI 2021},
 note = {Cited by: 9; All Open Access; Gold Open Access; Green Open Access},
 pages = {11947 - 11953},
 publication_stage = {Final},
 source = {Scopus},
 title = {Saturated Post-hoc Optimization for Classical Planning},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85112548882?origin=resultslist},
 volume = {13B},
 year = {2021}
}
