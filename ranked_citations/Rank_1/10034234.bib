@inproceedings{10034234,
 abstract = {Learning Bayesian network from data is a non-deterministic polynomial-time (NP) hard problem. Experts’ knowledge is beneficial to determine the BN structure. In this paper, we propose a novel structure learning algorithm using experts’ knowledge. In the stage of experts’ knowledge fusion, in order to improve fusion results when knowledge from experts is contradictory, a conflict fusion method combining knowledge degree and support relationship between evidences is proposed. In the stage of structure optimization, fused knowledge is integrated with the decomposition structure learning algorithm by modifying the set of candidate neighbor nodes and constructing an improved merging rule to learn the structure. Experiments show that our proposed algorithm can own better performances.},
 author = {Guo, Huiping and Li, Hongru},
 booktitle = {2022 34th Chinese Control and Decision Conference (CCDC)},
 doi = {10.1109/CCDC55256.2022.10034234},
 issn = {1948-9447},
 keyword = {Knowledge engineering;NP-hard problem;Merging;Bayes methods;Optimization;Bayesian network;Structure learning;experts’ knowledge;conflict fusion;decomposition structure learning algorithm},
 month = {Aug},
 number = {},
 pages = {287-292},
 title = {A Bayesian Network structure learning algorithm using experts’ knowledge},
 volume = {},
 year = {2022}
}
