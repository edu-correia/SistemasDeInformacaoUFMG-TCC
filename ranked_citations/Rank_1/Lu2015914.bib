@article{Lu2015914,
 abstract = {A robust ellipse detector is proposed. The detector preprocesses the edge map by removing all the isolated points and conjunction points, and exploits polygonal curve to extract the elliptical arcs. A non-iterative geometric distance computation method is presented to serve a criterion which identifies the elliptical arcs belonging to the same ellipse by likelihood ratio test and fit ellipses to those merged arcs. The authors test their algorithm on both synthetic and real images, and the experimental results show a good performance of their algorithm. © 2015. The Institution of Engineering and Technology.},
 author = {Lu, Tingting and Liu, Chang and Yang, Daguang},
 doi = {10.1049/iet-cvi.2014.0347},
 journal = {IET Computer Vision},
 note = {Cited by: 16},
 number = {6},
 pages = {914 - 925},
 publication_stage = {Final},
 source = {Scopus},
 title = {Effective ellipse detector with polygonal curve and likelihood ratio test},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84947420604?origin=resultslist},
 volume = {9},
 year = {2015}
}
