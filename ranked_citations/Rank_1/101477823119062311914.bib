@article{10.14778/2311906.2311914,
 abstract = {This paper presents a novel static analysis technique to detect XML query-update independence, in the presence of a schema. Rather than types, our system infers chains of types. Each chain represents a path that can be traversed on a valid document during query/update evaluation. The resulting independence analysis is precise, although it raises a challenging issue: recursive schemas may lead to inference of infinitely many chains.A sound and complete approximation technique ensuring a finite analysis in any case is presented, together with an efficient implementation performing the chain-based analysis in polynomial space and time.},
 author = {Bidoit-Tollu, Nicole and Colazzo, Dario and Ulliana, Federico},
 doi = {10.14778/2311906.2311914},
 issn = {2150-8097},
 issue_date = {May 2012},
 journal = {Proc. VLDB Endow.},
 month = {May},
 number = {9},
 numpages = {12},
 pages = {872–883},
 publisher = {VLDB Endowment},
 title = {Type-based detection of XML query-update independence},
 url = {https://doi.org/10.14778/2311906.2311914},
 volume = {5},
 year = {2012}
}
