@article{XIE2024111335,
 abstract = {Boundary conditions are crucial for the construction of physical models of concrete-filled steel tube (CFST) arches, but the current model updating methods seldom consider boundary conditions and usually necessitate repeated modifications and recalculations of finite element models, which are not efficient enough. Moreover, the current physics-informed neural network (PINN) provides a new approach for solving physical equations through physical constraint merging into the neural network, but it is still limited by complex structures, multiple scales, and unknown physical model engineering problems. Therefore, this paper proposed a boundary recognition method for physically-enhanced machine learning. First, the basic variables of the physical equation and the variables to be optimized were taken as inputs to enhance the neural network’s ability to predict the target response. Then, similar to the handling of physical loss constraints in the PINN, the physical loss between the physical model (FE) and the neural network predictions was used to update the parameters. Then, a physical feedback-enhanced neural network (PFENN) meta-model was established, and modified mutation particle swarm optimization (MMPSO) was adopted to optimize the identification of boundary parameters. The identification process involves validation via mutual verification using a finite element model, meta-model, and experimental model. The prediction accuracy is higher than that of classical Kriging, response surface (RS), support vector machine regression (SVR), and neural network (NN) meta-models; additionally, the proposed model has good optimization stability, and reliable optimization results, and its computational efficiency is increased by 4.57 times compared with that of the traditional non-metamodel method. Moreover, the proposed method enhances the accuracy and interpretability of surrogate models by enhancing physical parameters and reducing physical losses, which is suitable for boundary recognition and physical model construction of different structures.},
 author = {Kaizhong Xie and Dong Liang and Yue Qin and Quanguo Wang and Heng Li},
 doi = {https://doi.org/10.1016/j.ymssp.2024.111335},
 issn = {0888-3270},
 journal = {Mechanical Systems and Signal Processing},
 keyword = {Concrete-filled steel tube arch, Boundary condition identification, Model updating, Machine learning, Model test, Physical enhancement},
 pages = {111335},
 title = {Method for identifying boundary conditions of CFST arches using physically enhanced machine learning},
 url = {https://www.sciencedirect.com/science/article/pii/S0888327024002334},
 volume = {213},
 year = {2024}
}
