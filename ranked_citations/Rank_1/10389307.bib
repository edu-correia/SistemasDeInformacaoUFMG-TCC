@inproceedings{10389307,
 abstract = {In recent years, the management of the distribution Grid changed, because the need for Renewable Energy Sources is increasing. Furthermore, the penetration of renewable energy sources (RES) especially in the distribution network becomes a challenge to the reliability and safety of operation. The random load variation greatly affects the power stability and quality, and the Energy Storage concept merged and becomes important. A distributed network is modeled, and it's chosen to be a hybrid system connected with a PV system combined with Energy Storage and make cases and scenarios with and without the Energy Storage and study the impact of the RESs on this system. This work presents a reality-based assessment and comparison of the impact of RES technologies on distribution grids. The study will be done using DIGSILENT-Power Factory, which offers comprehensive modeling and simulation for power systems. This study was done on a low-level power and focused on Energy Storage impact. At the end, we concluded that the integration of Energy Storage Battery System will enhance the stability, voltage profile and harmonics (power quality).},
 author = {Harb, Ahmad and Saliek, Wesam Abu and Alhusseini, Mutasem},
 booktitle = {2023 14th International Renewable Energy Congress (IREC)},
 doi = {10.1109/IREC59750.2023.10389307},
 issn = {2378-3451},
 keyword = {Renewable energy sources;Voltage fluctuations;Power quality;Power system stability;Power system harmonics;Stability analysis;Production facilities;Distribution power systems;stability analysis;power quality;Harmonics Analysis},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {On the Impacts of Renewable Energy on Distribution Power Systems and the Effects of Energy Storage Systems},
 volume = {},
 year = {2023}
}
