@article{Mao2026,
 abstract = {Model pruning, aiming to reduce computational costs for deep neural networks, is essential for deploying deep models in resource-limited scenarios. While significant progress has been witnessed in pruning techniques in recent years, existing methods predominantly focus on balanced datasets. Adapting these approaches to datasets with long-tailed data distributions remains challenging since their pronounced class imbalances often lead to under-learning of tail-class samples, resulting in inaccurate estimation for parameter importance. This causes notable performance degradation after pruning. To this end, we propose Class Importance Consistency (CIC) pruning by introducing a consistency-guided criterion that enhances parameter importance evaluation across all classes. By prioritizing model parameters with stable importance across all classes and pruning those with inconsistent contributions, CIC effectively mitigates the effects of skewed importance scores. Additionally, we introduce a Class-wise Batch Sampling (CBS) strategy to streamline the computation of class-wise importance scores, significantly improving pruning efficiency. Extensive experiments on CIFAR100-LT, ImageNet-LT, and iNaturalist2018 demonstrate that CIC consistently achieves Pareto-optimal parameter-accuracy trade-offs, surpassing state-of-the-art methods in average accuracy by a margin over 1%. © 1999-2012 IEEE.},
 author = {Mao, Junzhu and Sun, Zeren and Yao, Yazhou and Hua, Xiansheng and Shen, Hengtao},
 doi = {10.1109/TMM.2026.3675956},
 journal = {IEEE Transactions on Multimedia},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Article in press},
 source = {Scopus},
 title = {Class Importance Consistency Matters: Efficient Model Pruning for Long-tailed Recognition Models},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105033501703?origin=resultslist},
 year = {2026}
}
