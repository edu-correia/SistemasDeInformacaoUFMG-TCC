@inproceedings{11208424,
 abstract = {In this work, we investigate the influence of video bitrate reduction on the inference accuracy of YOLO models for human detection from unmanned aerial vehicles (UAVs). The study targets detection across both infrared (IR) and visible light spectrums, evaluating the model's robustness under varying compression levels. We explore bitrates ranging from 1 to 20 Mbps to assess the trade-off between compression and detection performance. Additionally, we compare two encoding strategies: a single merged stream combining IR and visible data versus two separate streams for each spectrum. Experimental results demonstrate how bitrate selection and stream configuration impact detection accuracy, providing insights for optimizing multi-spectral UAV-based human detection systems under bandwidth-constrained conditions.},
 author = {Vasile, Costin-Emanuel and Bira, Calin},
 booktitle = {2025 24th RoEduNet Conference: Networking in Education and Research (RoEduNet)},
 doi = {10.1109/RoEduNet68395.2025.11208424},
 issn = {2247-5443},
 keyword = {YOLO;Accuracy;Image coding;Bit rate;Bandwidth;Video compression;Autonomous aerial vehicles;Encoding;Resource management;Videos;Human detection;Video compression;Bitrate allocation;H.265;H.264;AV1;Multispectral video streaming},
 month = {Sep.},
 number = {},
 pages = {1-5},
 title = {Analyzing the Impact of Video Bitrate Reduction on Neural Networks Inference Accuracy},
 volume = {},
 year = {2025}
}
