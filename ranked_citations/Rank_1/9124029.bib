@inbook{9124029,
 abstract = {ActiveX Data Object (ADO) is developed based on Object Linking and Embedding (OLE) and Component Object Model (COM) technologies. COM is used by developers to create re&#x2010;usable software components, link components together to build applications, and take advantage of Windows services. This chapter deals with the ADO.NET and presents an overview, architecture, and components of the ADO.NET. The classes provided by ADO.NET are core to develop a professional data&#x2010;driven application and they can be divided into the following three major components: .NET Framework Data Provider, DataSet, and DataTable. Data Provider contains four classes: Connection, Command, DataAdapter and DataReader. These four classes can be used to perform the different functionalities. The ADO.NET architecture can be divided into two logical pieces: command execution and caching.},
 author = {Bai, Ying},
