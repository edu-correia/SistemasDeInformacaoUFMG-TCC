@inproceedings{10157646,
 abstract = {Every communication system's main issue is data security. For any business, educational institution, or defense force, communication has become a crucial instrument. Data transfer must be done safely and securely. Many cryptographic methods have been suggested and put into use as of late. Based on the quantity of keys employed, those algorithms are divided into asymmetric and symmetric algorithms. Although numerous algorithms are employed to protect data, they occasionally breach its security. At now, the goal is to combine a number of safe methods to create a highly secure data transmission environment. The RSA asymmetric method, the SHA256 hashing technique, and the symmetric cryptographic algorithms AES and Twofish will all be merged. These methods enable us to guarantee the secrecy, authentication, and data integrity of three cryptography fundamentals. For text encryption, a number of security analysts are utilized, including differential analysis, histogram, information entropy, secret key size and key sensitivity. The suggested technique offers a high degree of security, a rise in key size, and a better encryption scheme according to the findings of numerical simulation for text encryption.},
 author = {Aman and Aggarwal, R.K.},
 booktitle = {2023 2nd International Conference on Vision Towards Emerging Trends in Communication and Networking Technologies (ViTECoN)},
 doi = {10.1109/ViTECoN58111.2023.10157646},
 issn = {},
 keyword = {Histograms;Sensitivity;Instruments;Force;Numerical simulation;Market research;Data transfer;Cryptography;Encryption;Decryption;AES;RSA;SHA;Hybrid Cryptography},
 month = {May},
 number = {},
 pages = {1-5},
 title = {Data Security Optimization Using New Hybrid Cryptographic System},
 volume = {},
 year = {2023}
}
