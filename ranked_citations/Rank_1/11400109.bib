@inproceedings{11400109,
 abstract = {This work presents the integration of Competency-Based Learning (CBL), Project-Based Learning (PBL), and Design Thinking (DT) as a methodology to develop both hard and soft skills, as well as competencies, in the field of automation engineering. In response to the government's limited investment in education and technology, LG Electronics and IFAM launched a project aimed at training engineering students in industrial robotics. The integrated CBL/PBL/DT methodology merges educational and industrial innovation practices by following the principles of active learning and involves practical classes conducted in both a university and a factory setting, with students organized into two groups of 15. The results demonstrate the significant potential of these integrated methods, as they successfully achieved the project's proposed objectives.},
 author = {Queiroz-Neto, José P. and Nascimento, José F. L. and Gouvea, Nelson A. and Júnior, José C. Lacerda and Rodrigues, Marlos A. S. and Carvalho, Dominique V.},
 booktitle = {2025 IEEE 14th International Conference on Engineering Education (ICEED)},
 doi = {10.1109/ICEED66794.2025.11400109},
 issn = {},
 keyword = {Training;Technological innovation;Service robots;Design methodology;Buildings;Active learning;Production facilities;Fourth Industrial Revolution;Engineering students;Investment;competency-based learning;Industrial Robotics;Academic-industrial partnership},
 month = {Sep.},
 number = {},
 pages = {132-137},
 title = {Building Competencies for Industry 4.0: Integrated Approach Using Competency-Based, Project-Based, and Design Thinking Methods in Applied Industrial Robotics},
 volume = {},
 year = {2025}
}
