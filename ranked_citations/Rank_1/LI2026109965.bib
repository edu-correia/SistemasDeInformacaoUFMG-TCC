@article{LI2026109965,
 abstract = {Particle deposition degrades interfacial heat-transfer efficiency and increases hydraulic losses in energy systems, yet its multicomponent, polydisperse nature under turbulent flow continues to challenge reliable modeling. This study establishes a broadly applicable multiscale framework that integrates Computational Fluid Dynamics, Discrete Element Method, and Molecular Dynamics. By coupling intrinsic adhesion with flow-driven transport, the framework predicts deposition within ±16 % of benchmark experiments. The model is applied to insoluble Pb, Ag and Mo particles with diameters of 10–4000 nm in flowing molten salt at Reynolds numbers 5 × 104–2 × 105. Competition between inertia and adhesion yields a nearly linear relationship between the Stokes number and the ratio of adhesion to drag, indicating that adhesion is controlled by particle size and surface energy. Embedding this scaling in a diffusion-capture formulation produces an engineering correlation that forecasts regime transitions and deposition rates to ±20 %. Fast Fourier Transform and Power Spectral Density analyses track the evolution of wall roughness, showing a cascade of spectral energy toward lower wavenumbers as microscale asperities merge into mesoscale streaks. Low-frequency spectral energy remains almost linearly correlated with the friction factor, confirming mid- and low-frequency spectra as the primary drivers of roughness-induced resistance.},
 author = {Jinyang Li and Maolong Liu and Xiaowen Wang and Jinye Luo},
 doi = {https://doi.org/10.1016/j.icheatmasstransfer.2025.109965},
 issn = {0735-1933},
 journal = {International Communications in Heat and Mass Transfer},
 keyword = {CFD-DEM, Multiscale simulation, Metal particles, Molten salt reactor, Particle deposition, Surface roughness},
 pages = {109965},
 title = {Multiscale CFD-DEM investigation on deposition characteristics of metal particles in flowing molten salt},
 url = {https://www.sciencedirect.com/science/article/pii/S0735193325013910},
 volume = {170},
 year = {2026}
}
