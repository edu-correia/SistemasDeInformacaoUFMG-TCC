@conference{Chang20071193,
 abstract = {Image segmentation is an essential topic in a document processing system, and also is an important initial task for higher level image processing such as recognition or object tracking since recent years. In this paper we propose a method for segmentation and extraction of the regions of mathematical formulae and graphics in an academic paper. First, an academic paper image is transformed into a binary image by Ohtsu's method. Second, the boundary blank spaces of the binary image are removed and then the image is recursively segmented and extracted by vertical and horizontal projection profiles. We apply the proposed method to 150 academic paper images, and show that the method is adaptable, robust and effective for segmentation.},
 author = {Chang, Tzu-Yuan and Takiguchi, Yusuke and Okada, Minoru},
 doi = {10.1109/ICDAR.2007.4377104},
 journal = {Proceedings of the International Conference on Document Analysis and Recognition, ICDAR},
 note = {Cited by: 13},
 pages = {1193 - 1197},
 publication_stage = {Final},
 source = {Scopus},
 title = {Physical structure segmentation with projection profile for mathematic formulae and graphics in academic paper images},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/51149117043?origin=resultslist},
 volume = {2},
 year = {2007}
}
