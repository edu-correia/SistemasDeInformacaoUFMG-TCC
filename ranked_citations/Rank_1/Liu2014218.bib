@conference{Liu2014218,
 abstract = {Infinite hidden conditional random fields has been proposed for human behavior analysis which is a non-parametric discriminative model as the extension of HCRF. However, it only model one dimensional temporal relationship by using a chain structure imposed on latent state variables, and would involve huge number of parameters as the number of state increases. In order to solve the 2D object segmentation problem, we propose a novel model relying on hierarchical Dirichlet processes and hidden conditional random fields. Our model maintains properties of non-parametric Bayesian model but with only finite model parameters. Experimental results show the effectiveness of HDP-HCRF on MSRC-21 and VOC 2007 segmentation dataset. © 2014 IEEE.},
 author = {Liu, Tao and Cai, Anni},
 doi = {10.1109/ICNIDC.2014.7000297},
 journal = {Proceedings of 2014 4th IEEE International Conference on Network Infrastructure and Digital Content, IEEE IC-NIDC 2014},
 note = {Cited by: 0},
 pages = {218 - 222},
 publication_stage = {Final},
 source = {Scopus},
 title = {HDP-HCRF for object segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84929395457?origin=resultslist},
 year = {2014}
}
