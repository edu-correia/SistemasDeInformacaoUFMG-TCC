@article{ZENG2025169002,
 abstract = {This study presents an innovative MXene@zinc phthalocyanine tetra-aldehyde/chitosan (MXene@ZnPcTa/CS) hydrogel engineered to address irregular wound healing and bacterial infections through synergistic photodynamic-photothermal therapy (PDT/PTT) under single-wavelength 808 nm near-infrared (NIR) light. The hydrogel integrates zinc phthalocyanine tetra-aldehyde (ZnPcTa) as a dual-functional photosensitizer and dynamic Schiff base crosslinker with chitosan (CS), while MXene nanosheets enhance interfacial interactions via hydrogen bonding. This hierarchical design endows the hydrogel with injectability, rapid self-healing and robust tissue adhesion, enabling conformal coverage of complex wounds. The cationic surface facilitates bacterial entrapment, while the MXene/ZnPcTa heterojunction significantly enhances charge separation, boosting reactive oxygen species (ROS) generation by 3.8-fold compared to ZnPcTa alone for potent PDT. Simultaneously, MXene and ZnPcTa synergistically achieve mild photothermal conversion (T ≈ 45 °C at 0.5 W/cm2), enabling low-power PTT without thermal damage. Crucially, MXene's antioxidant capacity dynamically regulates ROS levels, preventing oxidative stress during therapy. In vitro studies demonstrate 99 % antibacterial efficiency against S. aureus and E. coli, while in vivo experiments reveal accelerated wound closure with reduced collagen deposition and scar formation. The hydrogel further exhibits rapid hemostasis and pro-angiogenic effects. This work establishes a multifunctional platform that combines precision antibacterial action, ROS homeostasis modulation, and regenerative microenvironments within a single material system, offering a transformative strategy for advanced wound care.},
 author = {Qin Zeng and Yuancheng Liu and Yuwei Hu and HuiYu Zou and Shuang Zhao and Yi Zhang and Heye Wang and Dai Li and Chunyan Deng},
 doi = {https://doi.org/10.1016/j.cej.2025.169002},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {MXene, ZnPcTa, Injectable hydrogel, Enhanced PDT/PTT Therapy, Sustained ROS},
 pages = {169002},
 title = {Injectable MXene@zinc phthalocyanine heterojunction engineered hydrogel with self-regulating ROS for single 808 nm-activated photodynamic/photothermal synergistic therapy in scar-reduced wound healing},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894725098444},
 volume = {524},
 year = {2025}
}
