@article{DEVASIA201113034,
 abstract = {Abstract
This article aims to avoid flow-capacity loss due to merges when rerouting air traffic around adverse-weather regions. However, rerouting without merges can increase the number of route intersections (potential conflicts) in the nearby sectors. To resolve such conflicts, the current work uses decentralized procedures, which can be designed in a decoupled manner without domino effects, and without the need to reduce aircraft-flow levels.},
 author = {Santosh Devasia},
 doi = {https://doi.org/10.3182/20110828-6-IT-1002.00713},
 issn = {1474-6670},
 journal = {IFAC Proceedings Volumes},
 keyword = {Air Traffic Control, Conflict Resolution, Decentralized, Intelligent transportation systems},
 note = {18th IFAC World Congress},
 number = {1},
 pages = {13034-13039},
 title = {Capacity-Maintaining Conflict Resolution for Adverse-Weather Air-Traffic Rerouting},
 url = {https://www.sciencedirect.com/science/article/pii/S1474667016457149},
 volume = {44},
 year = {2011}
}
