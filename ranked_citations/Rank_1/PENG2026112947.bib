@article{PENG2026112947,
 abstract = {Lifelong person re-identification (LReID) is a crucial task that meets the demand for deployment with the continuous data stream in real-world scenarios. Since all person data cannot be accessed at the same time, existing methods mainly focus on directly building cross-domain constraints to maintain the previous knowledge. However, it is uncontrollable and inefficient which hinders the generalization of the LReID model to new tasks due to the varied domain bias. To address the problem, this paper proposes an Adaptive Knowledge Transition (AKT) framework, which weakens the inhibition of generalization capacities by adaptively transferring knowledge. Specifically, the Transition Factor Estimation (TFE) is designed to fetch domain-specific styles from different domains, which conducts appropriate knowledge transfer paths for progressive distillation. Then the Knowledge Integration Module (KIM) merges the styles between domains to generate the intermediate transition knowledge. Moreover, Multi-Relation Distillation (MRD) is proposed to explore the relationship across domains from different perspectives for flexible knowledge distillation. It effectively preserves the learned knowledge by establishing distillation constraints in samples and classes separately. Comprehensive experiment results demonstrate an advanced performance on benchmark datasets compared to state-of-the-art LReID methods.},
 author = {Jinjia Peng and Chengjun Wang and Jican Tan and Huibing Wang and Xianping Fu},
 doi = {https://doi.org/10.1016/j.patcog.2025.112947},
 issn = {0031-3203},
 journal = {Pattern Recognition},
 keyword = {Person re-identification, Lifelong learning, Knowledge distillation},
 pages = {112947},
 title = {Bridging the gap : Learning adaptive knowledge transition for lifelong person re-identification},
 url = {https://www.sciencedirect.com/science/article/pii/S0031320325016103},
 volume = {174},
 year = {2026}
}
