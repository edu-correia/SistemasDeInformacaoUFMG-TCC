 issue_date = {June 2026},
 journal = {Proc. ACM Meas. Anal. Comput. Syst.},
 keyword = {streaming retrieval, performance measurement, freshness, staleness, tradeoffs, scalability, provenance, online indexing, retrieval-augmented generation},
 month = {May},
