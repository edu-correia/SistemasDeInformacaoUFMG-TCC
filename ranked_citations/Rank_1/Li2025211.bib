@conference{Li2025211,
 abstract = {The technology of infrared and visible light image fusion aims to extract and merge information from thermal imaging targets with the texture details of visible light images. However, existing fusion methods often neglect edge features and do not consider the differences in characteristics between different modalities, resulting in suboptimal fusion image quality. To address these issues, this paper proposes an edge-guided cross-modal Transformer fusion method, which utilizes edge operators to extract edge information from different modality images to enhance the texture information of the fused image. Additionally, the proposed cross-modal Transformer module leverages the long-range correlations of Transformers to model the interactions between features from different modalities, allowing the fused image to retain the texture and edge information from both modalities. Experimental results demonstrate that the proposed method performs excellently in both subjective and objective evaluations on public datasets.  © 2025 Copyright held by the owner/author(s).},
 author = {Li, Anyu},
 doi = {10.1145/3747912.3747945},
 journal = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications, SECA 2025},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {211 - 216},
 publication_stage = {Final},
 source = {Scopus},
 title = {Using Edge-Guided Cross-Modal Transformer for Infrared and Visible Light Image Fusion},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105016587658?origin=resultslist},
 year = {2025}
}
