@article{LI2025108326,
 abstract = {Recovering images from undersampled k-space data substantially reduces data acquisition time. However, the absence of partial ground truth easily leads to incorrect tissue structure or texture details. To address this issue, this paper proposes the AMC-Net, a parallel dual-domain crossing network combining hybrid attention enhancement and multimodal fusion for accelerated and high-quality MR imaging. Specifically, the AMC-Net simultaneously handles k-space and image-domain data during reconstruction, consisting of three specially designed modules. Firstly, a multimodal feature fusion (MMFF) module, which can capture and fuse shared features among multimodal MRI inputs, is developed. Useful structural information from the reference modality is accurately fused with the reconstruction target features to complement the missing features. Then, we propose to enhance the iterative shrinkage thresholding algorithm by incorporating self-attention, thus developing the AttISTA+ module for feature extraction. Moreover, we have developed the progressive interaction reconstruction network (PIRN), which effectively complements the missing global information in traditional convolutional networks. Unlike typical cascaded dual-domain reconstruction, the PIRN employs a parallel two-branch structure to achieve interactive fusion of these dual-domain features based on the potential link between the k-space and image domains. Furthermore, we design the multiple hybrid attention (MHA) module to refine the reconstruction outputs. This module emphasizes the importance of channel, spatial, and self-attention at the same time. Comprehensive studies on various sampling rates confirm that AMC-Net outperforms the latest methods, producing more realistic reconstruction images and fewer visual artifacts. The code for this project is available at https://github.com/YanQLi/AMC-Net.},
 author = {Yanqing Li and Hongqing Zhu and Tong Hou and Ning Chen and Bingcang Huang and Weiping Lu and Ying Wang and Suyi Yang},
 doi = {https://doi.org/10.1016/j.bspc.2025.108326},
 issn = {1746-8094},
 journal = {Biomedical Signal Processing and Control},
 keyword = {MRI reconstruction, Cross-domain parallel network, Multimodal feature fusion, Iterative shrinkage thresholding algorithm, Multiple hybrid attention},
 pages = {108326},
 title = {A parallel dual-domain crossing network combining attention enhancement and multimodal fusion for MRI reconstruction},
 url = {https://www.sciencedirect.com/science/article/pii/S1746809425008377},
 volume = {110},
 year = {2025}
}
