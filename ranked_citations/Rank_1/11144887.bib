@inproceedings{11144887,
 abstract = {The tail greatly boosts the robot's movement. Mass - concentrated rods and reaction wheels are two common robot tail structures. This paper presents a novel gyroscope - assisted tail, merging a tail with a gyroscope. The rod delivers significant torque, and the gyroscope supplies angular momentum in any spatial direction. Unlike other tails, the one designed here is broadly applicable. The paper details its design, and performs kinematic modeling and simulation. Results show the new tail mechanism is feasible, offering fresh ideas for future bionic tails.},
 author = {Cai, Likui and Wang, Gang and Zhang, Qi and Zhang, Chao and Qiao, Lin},
 booktitle = {2025 IEEE 15th International Conference on Power Electronics and Drive Systems (PEDS)},
 doi = {10.1109/PEDS63958.2025.11144887},
 issn = {2164-5264},
 keyword = {Torque;Robot kinematics;Wheels;Rotors;Kinematics;Aerospace electronics;End effectors;Power electronics;Gyroscopes;Mobile robots;Tail;Structural design;Gyroscope},
 month = {July},
 number = {},
 pages = {1-5},
 title = {Bionic Tail Structure Design Based on Gyroscope},
 volume = {},
 year = {2025}
}
