@conference{Naresh2020756,
 abstract = {Urban traffic scenario is a combination of different traffic elements and their interactions. Road, flow, and management are three subsystems which are considered in the present scenario. Traffic problems such as traffic congestion are mainly due to the uncoordinated behavior of these three systems. In this study, three different bottlenecks are analyzed for Human capital hour loss, Delay, and Occupancy for the bottleneck. Based on the result obtained different models like ANN and SVM are developed using MATLAB and R-Studios, These Machine learning models are developed to analyze the bottleneck condition and predict the delay, human capital hour loss, and percent occupancy. The utility equations were developed with the SVM model so that it can predict the delay, human capital hour losses, and percent occupancies. Based on the performance measures from the models it can concluded that the ANN model gives high accuracy when compared to the SVM model. © 2020 IEEE.},
 author = {Naresh, Pattepu and Tallam, Teja and Kumar Chikkakrishna, Naveen},
 doi = {10.1109/I-SMAC49090.2020.9243308},
 journal = {Proceedings of the 4th International Conference on IoT in Social, Mobile, Analytics and Cloud, ISMAC 2020},
 note = {Cited by: 3},
 pages = {756 - 762},
 publication_stage = {Final},
 source = {Scopus},
 title = {Analysis of urban traffic bottleneck in hyderabad city using machine learning techniques},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85097825190?origin=resultslist},
 year = {2020}
}
