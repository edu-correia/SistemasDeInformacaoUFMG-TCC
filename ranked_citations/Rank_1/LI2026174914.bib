@article{LI2026174914,
 abstract = {The chaotic electrodeposition on flat lithium-metal anodes, driven by intrinsic geometric flaws, remains a fundamental bottleneck. While rational structural design is pivotal to homogenize ion flux, prevailing methods struggle to concurrently achieve precise microstructure control and scalable fabrication. Herein, we bridge this gap by designing and fabricating a uniform, periodic groove microstructure on lithium foil via a novel yet simple mechanical patterning strategy. This approach uniquely employs a scalable roller-pressing and controlled “sandwich” process to imprint well-defined grooves (70 μm wide, 200 μm spacing), crucially enabling the fine-tuning of the depth-to-width ratio to an optimal range (0.5–1.0) for favorable electrochemical field distribution. This rationally designed architecture establishes a spatially ordered framework that effectively homogenizes local current density, guides uniform lithium-ion flux, and directs preferential lithium plating within the grooves. Consequently, the structured anode demonstrates exceptional stability by fundamentally suppressing dendrite initiation. Fabricated via a solvent-free, room-temperature process compatible with roll-to-roll manufacturing, this work provides a practical and scalable anode engineering solution, merging targeted structural design with industrial viability for high-performance lithium-metal batteries.},
 author = {Dongdong Li and Hai Pan and Qi Sun and Yanan Sun and Hao Liu and Yue He and Shengchen Yang and Wen-Yong Lai},
 doi = {https://doi.org/10.1016/j.cej.2026.174914},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Lithium-metal anodes, Mechanical patterning, Groove microstructure, Lithium deposition regulation, Roll-to-roll compatible},
 pages = {174914},
 title = {Structural engineering of lithium-metal anodes: guiding ordered deposition via scalable mechanically-patterned groove arrays},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894726023739},
 volume = {533},
 year = {2026}
}
