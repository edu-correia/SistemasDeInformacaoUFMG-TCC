@article{Shi20266054,
 abstract = {Cryptomining poses significant security risks, yet traditional detection methods like blacklists and Deep Packet Inspection (DPI) are often ineffective against encrypted mining traffic and suffer from high false positive rates. In this paper, we propose a practical encrypted cryptomining traffic detection mechanism. It consists of a two-stage detection framework, which can effectively provide fine-grained detection results by machine learning and reduce false positives from classifiers through active probing. Our system achieves an F1-score of 0.99 and identifies specific cryptocurrencies with a 99.39% accuracy rate. Extensive testing across various mining pools confirms the effectiveness of our approach, offering a more precise and reliable solution for identifying cryptomining activities.  © 2004-2012 IEEE.},
 author = {Shi, Ruisheng and Lin, Ziding and Sun, Haoran and Wang, Qin and Zhang, Shihan and Lan, Lina and Peng, Zhiyuan and Wang, Chenfeng},
 doi = {10.1109/TDSC.2026.3661145},
 journal = {IEEE Transactions on Dependable and Secure Computing},
 note = {Cited by: 0; All Open Access; Green Open Access},
 number = {3},
 pages = {6054 - 6067},
 publication_stage = {Final},
 source = {Scopus},
 title = {CryptoCatch: Cryptomining Hidden Nowhere},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105029255936?origin=resultslist},
 volume = {23},
