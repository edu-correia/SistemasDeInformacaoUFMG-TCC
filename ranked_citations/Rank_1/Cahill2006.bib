@conference{Cahill2006,
 abstract = {The most recent impetus for the convergence of photonics and silicon integrated circuit technology has been the looming communications bottleneck associated with chip-to-chip and on-chip high-speed data transfer. Whilst there have been significant separate improvements in the materials and technologies for both integrated optics and integrated electronics, there is now a real commercial interest in putting these pieces together to achieve functional circuits that take advantage of both technologies. It is the purpose of this paper to review the recent developments in both microelectronics and photonics that are causing these fields to merge in the area of on-chip and off-chip data links.},
 author = {Cahill, Laurence W. and Clapp, Terry V.},
 doi = {10.1117/12.647033},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {The convergence of photonics and microelectronics},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33646727523?origin=resultslist},
 volume = {6125},
 year = {2006}
}
