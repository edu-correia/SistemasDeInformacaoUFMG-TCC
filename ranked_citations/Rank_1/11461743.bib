@inproceedings{11461743,
 abstract = {Polyp segmentation is crucial for preventing colorectal cancer. Although many polyp segmentation methods have been developed and have made significant progress, their performance still suffers from the dramatic degradation in addressing blurry intestinal wall boundaries. To overcome this issue, we propose a Bidirectional Enhancement Network (BE-Net). In BE-Net, an Edge Prominent Module (EPM) is designed to reinforce the polyps’ edges by exploiting intra-feature boundary details and inter-feature context information under the dual guidance from the high-level features. In turn, these high-level features are strengthened by being integrated with the edge features from EPM in a Distinct Edge Generator Module (DEGM). Extensive experimental results on five benchmarked datasets demonstrate the superiority of our BE-Net in terms of both learning and generalization capacities.},
 author = {Wan, Huan and Liu, Jing and Zeng, Jinshan and Wei, Xin},
 booktitle = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP55912.2026.11461743},
 issn = {2379-190X},
 keyword = {Feeds;Antennas;Wide area networks;Protocols;Communication systems;Computer networks;HTTP;Videos;Video equipment;Learning (artificial intelligence);Medical image segmentation;polyp segmentation;bidirectional enhancement network;edge prominent module;distinct edge generator module},
 month = {May},
 number = {},
 pages = {6556-6560},
 title = {Bidirectional Enhancement Network for Colorectal Polyp Segmentation},
 volume = {},
 year = {2026}
}
