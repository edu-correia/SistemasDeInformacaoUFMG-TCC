@article{11012745,
 abstract = {The Cu-Cu bonding with formic acid-treated Co passivation layer was successfully achieved at  $230~^{\circ }$ C under atmospheric pressure, resulting in high bonding strength. TEM and energy-dispersive X-ray spectroscopy (EDS) characterization of the bonding interface has revealed that the reduction of oxides through formic acid treatment (FAT) promoted the merging of Co grains while concurrently minimizing the concentration of Cu in center area. The sample with FAT achieved ultralow contact resistance of  $3.58\times 10^{-{8}}~\Omega \cdot $ cm2 at  $250~^{\circ }$ C, lower than that without FAT. We analyzed the reasons for the decrease in contact resistance from the bonding interface and found that FAT reduced the surface roughness and oxides, resulting in better bonding of the Co passivation layer and reduced electron scattering. It was concluded that an ideal bonding interface necessitated minimal electron scattering.},
 author = {Shao, Yun-Hao and Chen, Gui and Wu, Xinwei and Xie, Haijiao and Qu, Xin-Ping},
 doi = {10.1109/TED.2025.3570671},
 issn = {1557-9646},
 journal = {IEEE Transactions on Electron Devices},
 keyword = {Bonding;Fats;Passivation;Annealing;Surface treatment;Contact resistance;Metals;Atmosphere;Atmospheric measurements;Surface morphology;3-D integration;contact resistance;Co passivation layer;Cu-Cu bonding;formic acid treatment (FAT)},
 month = {July},
 number = {7},
 pages = {3767-3773},
 title = {Low-Resistance Cu–Cu Bonding With the Formic Acid-Treated Co Passivation Layer},
 volume = {72},
 year = {2025}
}
