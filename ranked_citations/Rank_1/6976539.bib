@inproceedings{6976539,
 abstract = {To alleviate the encoder computation load in inter-frame coding of the High Efficiency Video Coding (HEVC), a new fast inter-frame prediction mode decision method is proposed by reducing the number of execution of the advanced motion vector prediction (AMVP) mode. Based on the correlation analysis between the corresponding located CU (Coding Unit) in the previous frame and the current CU, we first select the best one inter prediction mode by just performing merge mode decision process and then only perform the AMVP process on the selected one. Experimental results show that the proposed scheme provides 33.04% encoder time savings in Random Access (RA) configuration and 38.05% time savings in Low Delay (LD) configuration on average, and its increment in bit rate is 0.87% in RA and 1.29% in LD compared to the default encoding scheme in HM10.0.},
 author = {Xu, Qiuping and Hu, Dong},
 booktitle = {2014 IEEE Workshop on Advanced Research and Technology in Industry Applications (WARTIA)},
 doi = {10.1109/WARTIA.2014.6976539},
 issn = {},
 keyword = {Encoding;Correlation;Video coding;Vectors;Bit rate;Algorithm design and analysis;Copper;inter prediction mode;the advanced motion vector prediction (AMVP);HEVC},
 month = {Sep.},
 number = {},
 pages = {1375-1378},
 title = {A new inter prediction mode decision method based on temporal correlation for HEVC encoder},
 volume = {},
 year = {2014}
}
