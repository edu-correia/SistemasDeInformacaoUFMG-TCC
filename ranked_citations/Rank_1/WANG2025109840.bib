@article{WANG2025109840,
 abstract = {Digital watermarking algorithms and watermark attack algorithms evolve in a competitive dynamic, but the lack of progress in watermark attack algorithms is currently limiting the advancement of digital watermarking. This paper addresses this issue by leveraging the strengths of UNet to enhance the Denoising Spatial-Adaptive Network (SADNet), and proposes a Highly Applicable and Imperceptible Watermark Attack Network (HAI-WAN). Firstly, contextual modules based on skip connections and the UNet structure are integrated into the network, expanding the receptive field and enhancing the imperceptibility of the output image. Secondly, the residual network is improved, and the Fast and Precise block (FPblock) is introduced to increase training stability. Finally, the connection between image denoising and watermark attacks is explored, with targeted denoising techniques applied to effectively attack watermarks. The experimental results show that the proposed method effectively attacks watermarking algorithms while maintaining image visual quality. Comparisons with other methods further demonstrate the superiority of our method.},
 author = {Chunpeng Wang and Pengfei Tian and Zhiqiu Xia and Qi Li and Jian Li and Ziqi Wei and Ting Luo and Bin Ma},
 doi = {https://doi.org/10.1016/j.sigpro.2024.109840},
 issn = {0165-1684},
 journal = {Signal Processing},
 keyword = {Watermark attack, Imperceptibility, Convolutional Neural Network, Digital watermarking algorithm, Robustness evaluation},
 pages = {109840},
 title = {Highly applicable and imperceptible watermark attack network},
 url = {https://www.sciencedirect.com/science/article/pii/S0165168424004602},
 volume = {230},
 year = {2025}
}
