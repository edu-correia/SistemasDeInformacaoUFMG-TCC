 author = {GRIGOLETTO, E.C. and OLIVEIRA, E.C. and CAMARGO, R.F.},
 doi = {10.5540/tema.2019.020.02.0217},
 number = {2},
 pages = {217--228},
 title = {Integral Representations of Mittag-Leffler Function on the Positive Real Axis},
 volume = {20},
 year = {2019}
}
