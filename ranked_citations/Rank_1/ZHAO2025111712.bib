@article{ZHAO2025111712,
 abstract = {Accurate delineation of skin lesion regions in dermoscopic images is crucial for the early detection of melanoma, yet it presents challenges due to factors like irregular lesion shapes and indistinct boundaries. While conventional convolutional neural networks are commonly employed for segmenting lesion regions, they often struggle to capture global contextual features, leading to poor segmentation results. To address this challenge, this study proposes ETMA-Net (edge-and-threshold-guided multistage attention network), a lightweight parallel convolutional network architecture designed for automated skin lesion image segmentation in dermoscopic images. This framework effectively captures essential pixel dependencies and global contextual information by integrating a grouped multi-scale Hadamard attention module into the edge-threshold parallel structure, with minimal computational overhead. It also utilizes multistage aggregation bridges to merge high and low-level features, enhancing the model's understanding of both coarse-grained and fine-grained features, thereby improving segmentation accuracy. Through the repeated utilization of feature information at multiple levels and the continuous validation of extracted key features by the parallel convolutional network architecture, ETMA-Net demonstrates a robust understanding of skin lesion characteristics while maintaining computational efficiency. The study conducted comparative evaluations of ETMA-Net using the PH2, HAM10000 and ISIC (International Skin Imaging Collaboration) 2016, 2017, and 2018 datasets, yielding mIoU (mean Intersection over Union) test scores of 88.84 %, 84.41 %, 80.02 %, and 80.64 % respectively. With a parameter count of 0.63M and computational complexity of 0.38G, ETMA-Net outperformed existing state-of-the-art segmentation techniques. The model's efficacy was validated through comprehensive testing, including ablation studies, cross-dataset evaluations, and assessments on a polyp cross-medical segmentation dataset, showcasing ETMA-Net as a segmentation framework with superior performance, robust generalization capabilities, and high reliability.},
 author = {Shijie Zhao and Fanshuai Meng and Liang Cai and Yuanshuai Chen},
 doi = {https://doi.org/10.1016/j.engappai.2025.111712},
 issn = {0952-1976},
 journal = {Engineering Applications of Artificial Intelligence},
 keyword = {Skin lesion image segmentation, Parallel convolutional network, Grouping multi-scale hadamard attention module, Light-weight model},
 pages = {111712},
 title = {ETMA-Net: Edge-and-threshold-guided multistage attention network for skin lesion image segmentation},
 url = {https://www.sciencedirect.com/science/article/pii/S0952197625017142},
 volume = {159},
 year = {2025}
}
