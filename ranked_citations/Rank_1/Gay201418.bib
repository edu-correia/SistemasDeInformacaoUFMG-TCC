@article{Gay201418,
 abstract = {We suggest a simple yet effective and parameter-free feature construction process for time series classification. Our process is decomposed in three steps: (i) we transform original data into several simple representations; (ii) on each representation, we apply a coclustering method; (iii) we use coclustering results to build new features for time series. It results in a new transactional (i.e. object-attribute oriented) data set, made of time series identifiers described by features related to the various generated representations. We show that a Selective Naive Bayes classifier on this new data set is highly competitive when compared with state-of-the-art times series classification methods while highlighting interpretable and class relevant patterns. © 2014 Springer International Publishing.},
 author = {Gay, Dominique and Guigourès, Romain and Boullé, Marc and Clérot, Fabrice},
 doi = {10.1007/978-3-319-08407-7_2},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 4},
 pages = {18 - 34},
 publication_stage = {Final},
 source = {Scopus},
 title = {Feature extraction over multiple representations for time series classification},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84905283568?origin=resultslist},
 volume = {8399 LNAI},
 year = {2014}
}
