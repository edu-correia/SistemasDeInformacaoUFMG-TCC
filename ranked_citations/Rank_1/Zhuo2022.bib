 publication_stage = {Final},
 source = {Scopus},
 title = {CHMM Object Detection Based on Polygon Contour Features by PSM},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85137588211?origin=resultslist},
 volume = {22},
