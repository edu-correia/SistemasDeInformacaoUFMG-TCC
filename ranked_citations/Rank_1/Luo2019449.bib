@conference{Luo2019449,
 abstract = {The Log-Structured Merge-Tree (LSM-tree) has been widely adopted for use in modern NoSQL systems for its superior write performance. Despite the popularity of LSM-trees, they have been criticized for suffering from write stalls and large performance variances due to the inherent mismatch between their fast in-memory writes and slow background I/O operations. In this paper, we use a simple yet effective two-phase experimental approach to evaluate write stalls for various LSM-tree designs. We further identify and explore the design choices of LSM merge schedulers to minimize write stalls given an I/O bandwidth budget. We have conducted extensive experiments in the context of the Apache AsterixDB system and we present the results here. © VLDB Endowment.},
 author = {Luo, Chen and Carey, Michael J.},
 doi = {10.14778/3372716.3372719},
 journal = {Proceedings of the VLDB Endowment},
 note = {Cited by: 32},
 number = {4},
 pages = {449 - 462},
 publication_stage = {Final},
 source = {Scopus},
 title = {On performance stability in LSM-based storage systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85079326281?origin=resultslist},
 volume = {13},
 year = {2019}
}
