@article{SEO202485,
 abstract = {The evolution of the metaverse necessitates inventive solutions that can uphold data security. In this paper, we present a novel approach that seamlessly integrates blockchain and substitution cipher techniques to enhance the security landscape of the metaverse. The proposed approach encompasses the generation of the rule table for substitution encryption and decryption, as well as a methodology for data encryption and decryption utilizing the rule table. Furthermore, we conducted a comprehensive evaluation of the proposed approach’s security robustness, especially focusing on its resistance against potential security attacks, including the brute-force attack. Moreover, a series of performance experiments were meticulously conducted to comprehensively gauge the effectiveness and efficiency of the proposed technique. The findings revealed that the proposed approach outperforms asymmetric key algorithms in terms of encryption elapsed time. Additionally, the decryption process of the proposed approach is notably faster than both symmetric and asymmetric key algorithms. The results of security analysis and performance evaluations underscore the viability and efficiency of the proposed approach, positioning it as a promising solution for secure and swift data management within the metaverse environment.},
 author = {Jungwon Seo and Sooyong Park},
 doi = {https://doi.org/10.1016/j.future.2023.09.022},
 issn = {0167-739X},
 journal = {Future Generation Computer Systems},
 keyword = {Blockchain, Access control, Substitution cipher, Personal data protection, Metaverse},
 pages = {85-97},
 title = {SBAC: Substitution cipher access control based on blockchain for protecting personal data in metaverse},
 url = {https://www.sciencedirect.com/science/article/pii/S0167739X23003552},
 volume = {151},
 year = {2024}
}
