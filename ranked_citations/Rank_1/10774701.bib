@inproceedings{10774701,
 abstract = {Anemia is one of the diseases that can be easily acquired, but should not be underestimated, as it can be cured only after correct diagnosis and correct treatment. For this, in the present work, we propose a solid and robust approach based on ensemble modeling to machine learning that allows the accurate prediction of anemia. Merging Random Forest, Decision Tree, and logistic regression we enhance the model and its generality by providing more reliability and strengthening the methods used in this model by ensembling them. As for the choice of optimal model parameters, hyperparameter tuning is the key step that has to be conducted to maximize the effectiveness of each type of method. That is why our method achieves an accuracy of 96%, and the fine-tuning of all hyperparameters and ensemble structures shows the efficiency of the approach. The study proves that, in the context of medicine, machine learning may be quite effective, for example in early detection of anemia which can lead to better outcomes for the patient and more targeted therapies. This work presents a general approach to diagnosing anemia in several population groups, providing to the increasing literature area of prediction in health sciences.},
 author = {Rana, Anmol and Sharma, Nivedita},
 booktitle = {2024 3rd International Conference for Advancement in Technology (ICONAT)},
 doi = {10.1109/ICONAT61936.2024.10774701},
 issn = {},
 keyword = {Solid modeling;Accuracy;Merging;Medical treatment;Predictive models;Solids;Reliability;Tuning;Random forests;Medical diagnostic imaging;Hyperparameter Tuning;Decision Tree;Anemia Prediction;Ensemble Structure;Accurate Diagnose},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Predicting Anemia with Precision: Employing Machine Learning Ensemble Modeling and Hyperparameter Tuning},
 volume = {},
 year = {2024}
}
