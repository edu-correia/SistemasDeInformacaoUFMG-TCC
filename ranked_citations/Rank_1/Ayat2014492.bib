@article{Ayat2014492,
 abstract = {Entity resolution is the problem of identifying the tuples that represent the same real world entity. In this paper, we propose a complete solution to the problem of entity resolution over probabilistic data (ERPD), which arises in many applications that have to deal with probabilistic data. To deal with the ERPD problem, we distinguish between two classes of similarity functions, i.e. context-free and context-sensitive. We propose a PTIME algorithm for context-free similarity functions, and an approximation algorithm for context-sensitive similarity functions. We validated our algorithms through experiments over both synthetic and real datasets. Our extensive performance evaluation shows the effectiveness of our algorithms. © 2014 Elsevier Inc. All rights reserved.},
 author = {Ayat, Naser and Akbarinia, Reza and Afsarmanesh, Hamideh and Valduriez, Patrick},
 doi = {10.1016/j.ins.2014.02.135},
 journal = {Information Sciences},
 note = {Cited by: 18; All Open Access; Green Open Access},
 pages = {492 - 511},
 publication_stage = {Final},
 source = {Scopus},
 title = {Entity resolution for probabilistic data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84901754548?origin=resultslist},
 volume = {277},
 year = {2014}
}
