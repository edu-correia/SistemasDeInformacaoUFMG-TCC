@inproceedings{9960263,
 abstract = {WordNet is a crucial language resource associated with artificial intelligence activities, for instance, constructing building models for advancement of computational linguistics and natural language processing, or representing statistical insights through knowledge graphs that emulate cognition and human understanding. Thai WordNet has been developed in many approaches, e.g., a merge approach in gold standard, and semi-auto construction with a bilingual dictionary. However, existing Thai WordNet is not easy to find words fit with the definition of synsets; and cover cultural gaps between the different languages of which needed to be aware. This paper presents a methodology of Translation Equivalence in order to construct Thai language resource, called LST22 Thai WordNet.},
 author = {Leenoi, Dhanon and Alongkornchai, Alongkorn and Takhom, Akkharawoot and Boonkwan, Prachya and Sunnithi, Thenchai},
 booktitle = {2022 17th International Joint Symposium on Artificial Intelligence and Natural Language Processing (iSAI-NLP)},
 doi = {10.1109/iSAI-NLP56921.2022.9960263},
 issn = {2831-4565},
 keyword = {Dictionaries;Computational modeling;Linguistics;Natural language processing;Cognition;Computational linguistics;Cultural differences;WordNet;Language Resources;Computational Linguistic;Natural Language Processing;Translation Equivalence},
 month = {Nov},
 number = {},
 pages = {1-4},
 title = {A Construction of Thai WordNet through Translation Equivalence},
 volume = {},
 year = {2022}
}
