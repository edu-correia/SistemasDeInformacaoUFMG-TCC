@article{10.1145/3715904,
 abstract = {Service discovery matchmaking plays a vital role in the cyber marketplace for the Internet of Things (IoT), especially in peer-to-peer environments where buyers and sellers dynamically register and match resource profiles online. As the IoT marketplace expands, efficient resource allocation through matchmaking is increasingly important. However, the growing complexity of service discovery, coupled with data security and privacy challenges, complicates the identification of suitable services. To address these issues, this study conducts a comprehensive review of matchmaking algorithms within the IoT marketplace by examining their key attributes, strengths, and limitations as documented in academic literature. This paper categorizes and summarizes state-of-the-art approaches, identifying research gaps and proposing future directions. Our comparative analysis highlights the strengths and weaknesses of current methodologies, advocating for deep learning and context-aware solutions to improve service efficiency. Additionally, blockchain-based approaches are discussed for their potential to improve security, trust, and privacy-preserving transactions. This research lays a critical foundation for the advancement of secure, efficient IoT-enabled marketplaces.},
 address = {New York, NY, USA},
 articleno = {213},
 author = {An, Qi and Jiang, Frank and Neiat, Azadeh and Yeoh, William and Venayagamoorthy, Kumar and Zaslavsky, Arkady},
 doi = {10.1145/3715904},
 issn = {0360-0300},
 issue_date = {August 2025},
 journal = {ACM Comput. Surv.},
 keyword = {Internet of Things (IoT), matchmaking algorithms, semantic matchmaking, syntactic matchmaking, hybrid matchmaking, context-aware matchmaking, web service discovery, service-oriented architecture (SOA), peer-to-peer marketplace, blockchain},
 month = {March},
 number = {8},
 numpages = {35},
 publisher = {Association for Computing Machinery},
 title = {A Comprehensive Review on IoT Marketplace Matchmaking: Approaches, Opportunities and Challenges},
 url = {https://doi.org/10.1145/3715904},
 volume = {57},
 year = {2025}
}
