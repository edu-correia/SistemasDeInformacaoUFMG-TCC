@article{LI2025114298,
 abstract = {The increasing demand for seismic-resilience structures in high-risk areas has underscored the inadequacy of conventional damage assessment methods for advanced steel structural systems. This study focuses on a high-strength steel-composite K-shaped eccentrically-braced frame (HSS-K-EBF)—a hybrid system merging ordinary steel eccentrically braced frames and high-strength steel frames to achieve enhanced damage controllability ans seismic resilience. Although its superior energy dissipation capabilities, comprehensive evaluation frameworks for the global structural performance of HSS-K-EBF under extreme loads remain incomplete, hindering its practical implementation. To address this, the inter-story drift damage index and elastic-plastic energy dissipation difference story damage index were established and compared to evaluate the damage degree of the HSS-K-EBF model. A ten-story global structure of HSS-K-EBF designed using a performance-based plastic design method was analyzed. The validity of each damage index was verified using existing quasi-static test results and numerical model time history analysis results. Furthermore, a fragility analysis and collapse assessment of the HSS-K-EBF model were performed using an incremental dynamic analysis method. The analysis results reveal that the HSS-K-EBF structure has a high collapse-resistance safety reserve. For design safety, it is recommended to use the interstory drift damage index to judge the non-collapse damage limit state of the structure, and the elastic-plastic energy dissipation difference damage index to evaluate the collapse resistance of the structure.},
 author = {Tengfei Li and Mingzhou Su and Gang Shi and Jiangran Guo and He Zhao},
 doi = {https://doi.org/10.1016/j.jobe.2025.114298},
 issn = {2352-7102},
 journal = {Journal of Building Engineering},
 keyword = {High-strength steel, Eccentrically braced frame, Elastic-plastic energy dissipation difference, Damage index, Collapse assessment},
 pages = {114298},
 title = {Damage and collapse assessment of high-strength steel-composite K-shaped eccentrically-braced frame based on deformation and energy dissipation},
 url = {https://www.sciencedirect.com/science/article/pii/S2352710225025355},
 volume = {114},
 year = {2025}
}
