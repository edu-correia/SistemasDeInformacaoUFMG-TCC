@article{YE2026110982,
 abstract = {In response to the urgent demand for porous metallic sound-absorbing materials that combine structural strength with functional performance in industrial noise control, this study systematically investigates the acoustic absorption behavior of GASAR porous copper. An idealized numerical model was first established to correlate pore structure parameters with the sound absorption coefficient (α). Experimental results indicate that increasing porosity, reducing average pore diameter, and increasing material thickness all significantly enhance the peak sound absorption coefficient. Further reductions in pore size combined with increased thickness shift the absorption peak toward lower frequencies. The study finds that when pores are uniformly distributed, acoustic energy is primarily dissipated efficiently at a local scale. In contrast, a multi-scale pore distribution dominated by macropores results in acoustic behavior characterized mainly by low-frequency absorption. Computed tomography (CT) analysis identified four characteristic pore morphologies: cylindrical, conical, merged, and interconnected. These morphological features explain discrepancies between some experimental observations and the initial model’s predictions. Finite element simulations further validated the distinct effects of different pore morphologies. By incorporating proportional representations of these four pore types, the researchers transformed the original idealized model into a comprehensive framework, achieving significant improvements in experimental data fitting (goodness-of-fit increased from 0.65–0.87 to 0.87–0.99). The refined model demonstrates markedly reduced prediction-measurement deviations while effectively quantifying pore-type influences on acoustic performance. This research provides a theoretical foundation for optimizing metal porous sound-absorbing materials and advancing structure–function integrated design for industrial noise control applications.},
 author = {Yutong Ye and Pangwei He and Zaijiu Li and Hongyu Chen and Qiqi Zhou and Qinglin Jin},
 doi = {https://doi.org/10.1016/j.apacoust.2025.110982},
 issn = {0003-682X},
 journal = {Applied Acoustics},
 keyword = {GASAR process, Porous copper, Sound absorption performance, Pore structure parameters, X-ray computed tomograph},
 pages = {110982},
 title = {Sound absorption performance of GASAR porous copper with different pore structure parameters},
 url = {https://www.sciencedirect.com/science/article/pii/S0003682X25004542},
 volume = {241},
 year = {2026}
}
