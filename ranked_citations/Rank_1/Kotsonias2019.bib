@conference{Kotsonias2019,
 abstract = {The forward/backward sweep is the most commonly used power flow method in radial Low Voltage Distribution Grids (LVDGs). In most cases, Kron's reduction is used to merge the neutral conductor with the phase conductors. However, important information can be lost by ignoring the effect of the neutral conductor through the Kron's reduction method, since in LVDGs the majority of loads are single-phase connected and are supplied through a phase conductor and the neutral. In this paper, a modification to the forward/backward sweep method is proposed to account for the neutral voltage as well. Test results indicate the significance of knowing the exact configuration of the neutral conductor in an LVDG before conducting power flow studies as it can affect greatly the accuracy of the results. © 2019 IEEE.},
 author = {Kotsonias, Andreas and Hadjidemetriou, Lenos and Kyriakides, Elias},
 doi = {10.1109/ISGTEurope.2019.8905641},
 journal = {Proceedings of 2019 IEEE PES Innovative Smart Grid Technologies Europe, ISGT-Europe 2019},
 note = {Cited by: 3; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Power Flow for a Four-Wire Radial Low Voltage Distribution Grid with a Single Point Grounded Neutral},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85075879995?origin=resultslist},
 year = {2019}
}
