@article{Zhang2021126,
 abstract = {Sparse matrix-vector multiplication (SpMV) has always been a hot topic of research for scientific computing and big data processing, but the sparsity and discontinuity of the nonzero elements in a sparse matrix lead to the memory bottleneck of SpMV. In this paper, we propose aligned CSR (ACSR) and aligned ELL (AELL) formats and a parallel SpMV algorithm to utilize NEON SIMD registers on ARM processors. We analyze the impact of SIMD instruction latency, cache access, and cache misses on SpMV with different formats. In the experiments, our SpMV algorithm based on ACSR achieves 1.18x and 1.56x speedup over SpMV based on CSR and SpMV in PETSc, respectively, and AELL achieves 1.21x speedup over ELL. The deviations between the theoretical results and experimental results in the instruction latency and cache access are 10.26% and 10.51% in ACSR and 5.68% and 2.91% in AELL, respectively. © 2021 Elsevier Inc.},
 author = {Zhang, Yufeng and Yang, Wangdong and Li, Kenli and Tang, Dahai and Li, Keqin},
 doi = {10.1016/j.jpdc.2021.08.002},
 journal = {Journal of Parallel and Distributed Computing},
 note = {Cited by: 19},
 pages = {126 - 137},
 publication_stage = {Final},
 source = {Scopus},
 title = {Performance analysis and optimization for SpMV based on aligned storage formats on an ARM processor},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85113312600?origin=resultslist},
 volume = {158},
 year = {2021}
}
