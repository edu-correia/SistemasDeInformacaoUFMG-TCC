@conference{Cao2023151,
 abstract = {Infrared and visible image fusion plays a pivotal role in image enhancement, aiming to merge the unique attributes of both imaging modalities: the comprehensive scene understanding of infrared image and the detailed visual cues of visible image. However, many current fusion techniques are designed for single-illumination settings, overlooking the challenges of diverse illuminance conditions and the intricacies of modality fusion. In this paper, we present ICFusion, a cutting-edge image fusion network anchored by illumination aware and convolutional attention mechanisms. This framework integrates two key modules: the Illumination Probability Computation Module (IPCM) to gauge scene illuminance and the Convolutional Attention Fusion Module (CAFM) to discern latent features and reduce redundancy. By capitalizing on illumination aware, our approach deftly combines information from both imaging modes. Experimental outcomes underscore ICFusion's edge over contemporary methods, especially in retaining fine textural nuances.  © 2023 IEEE.},
 author = {Cao, Zhiyuan and Liu, Hu},
 doi = {10.1109/AIAC61660.2023.00030},
 journal = {Proceedings - 2023 International Conference on Artificial Intelligence and Automation Control, AIAC 2023},
 note = {Cited by: 3},
 pages = {151 - 155},
 publication_stage = {Final},
 source = {Scopus},
 title = {ICFusion: An Infrared and Visible Image Fusion Network Based on Illumination Aware and Convolutional Attention},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85191469909?origin=resultslist},
 year = {2023}
}
