@inproceedings{6206456,
 abstract = {The purpose of this paper is to study properties of various cylindrical cloak structures where the continuously-varying structure is realized as multilayer structure with the stepwise approximation of the constitutive parameters. In order to do that, the developed program for analyzing cylindrical cloaks has been merged with the global optimization routine based on the PSO algorithm. The influence of the selected cost function on the obtained cloak designs are discussed in the paper (minimum of the total scattering width; maximum obtainable bandwidth; minimum number of layers, outer cloak radius, angle of arrival of the incidence plane wave, etc.).},
 author = {Bojanjac, Dario and Ivšić, Branimir and Komljenovic, Tin and Sipus, Zvonimir},
 booktitle = {2012 6th European Conference on Antennas and Propagation (EUCAP)},
 doi = {10.1109/EuCAP.2012.6206456},
 issn = {2164-3342},
 keyword = {Scattering;Nonhomogeneous media;Metamaterials;Tensile stress;Optimization;Permeability;Antennas;anisotropic media;scattering;electromagnetic propagation in anisotropic media;finite difference method;electromagnetic analysis},
 month = {March},
 number = {},
 pages = {2664-2668},
 title = {Performance of uniaxial multilayer cylinders used for invisible cloak realization},
 volume = {},
 year = {2012}
}
