@inproceedings{11089916,
 abstract = {Home automation has changed the way of interacting with our environment, offering accessibility and more flexibility home. This project aims to establish an efficient smart home automation system through integration of gesture, voice, and face recognition control systems for operation and protection. Gestures enable users to interact with gadgets like switches to control gadgets such as the light and appliances through hand movements, so that persons with a mobility problem. Voice control allows hands-free operation through natural language enhancing accessibility further. Facial recognition makes certain that only the authorized persons should have access to important operations such as unlocking the door, increasing security. The system can be expanded in the future while it has the ability to be used in the cloud and saves energy by controlling the devices remotely. This is because it merges the aspects of ease of use, security, and the use of environmentally friendly smart home solutions to ensure that users of smart homes get their customized smart homes.},
 author = {M, Gayathri and Lohith, Ch and Vaibhav, Ch Nanda},
 booktitle = {2025 6th International Conference on Inventive Research in Computing Applications (ICIRCA)},
 doi = {10.1109/ICIRCA65293.2025.11089916},
 issn = {},
 keyword = {Hands;Automation;Face recognition;Natural languages;Smart homes;Speech recognition;Control systems;Turning;Security;Protection;Smart home;gesture recognition;speech recognition;facial recognition;home automation;security},
 month = {June},
 number = {},
 pages = {120-124},
 title = {Home Automation Using Gestures and Speech Recognition},
 volume = {},
 year = {2025}
}
