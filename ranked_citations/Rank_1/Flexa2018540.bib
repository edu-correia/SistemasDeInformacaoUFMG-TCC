@conference{Flexa2018540,
 abstract = {We propose a new non-parametric internal validity index based on mutual equidistant-scattering among within-cluster data for fine-tuning the number of clusters, i.e., the hyperparameter K. Most of the validity indexes found in the literature are considered to be dependent on the number of data objects in clusters and often tend to ignore small and low-density groups. Moreover, they select suboptimal clustering solutions when the clusters are in a certain degree of overlapping or low separation. We analysed our index performance with four of the most popular validity indexes. Experiments on both synthetic and real-world data show the effectiveness and reliability of our approach to evaluate the hyperparameter K. © 2018 IEEE.},
 author = {Flexa, Caio and Santos, Reginaldo and Gomes, Walisson and Sales, Claudomiro},
 doi = {10.1109/BRACIS.2018.00099},
 journal = {Proceedings - 2018 Brazilian Conference on Intelligent Systems, BRACIS 2018},
 note = {Cited by: 2},
 pages = {540 - 545},
 publication_stage = {Final},
 source = {Scopus},
 title = {A novel equidistant-scattering-based cluster index},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85060855899?origin=resultslist},
 year = {2018}
}
