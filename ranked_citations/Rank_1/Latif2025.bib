@conference{Latif2025,
 abstract = {Allocation of renewable energy through efficient means is paramount to sustainable urban infrastructures, especially in active learning settings like STEM camps. This paper compares the five optimization algorithms of Mixed- Integer Linear Programming (MILP), Genetic Algorithms (GA), Particle Swarm Optimization (PSO), Ant Colony Optimization (ACO), and Reinforcement Learning (RL) to a simulated microgrid of solar PV, wind turbine, battery storage, and limited grid backup. The algorithms are differentiated in terms of cost efficiency, use of renewable energy, reliability, carbon reduction, and computation time. Findings indicate that MILP is better at maintaining consistency and poor at dealing with uncertainty, whereas PSO is better at maintaining the best speed and efficiency. With the increased computational cost, RW is the most systematic and reliable, with the most significant renewable utilization (83.7%). The results indicate the trade- offs between accuracy, adaptability, and computation, and the significance of environment-sensitive algorithm choice. The research paper ends with suggesting hybrid frameworks, which merge deterministic and learning-based models to maximize scalability, transparency, and sustainability in practical STEM- camp microgrids.  © 2025 IEEE.},
 author = {Latif, Rana Muhammad Amir and Ullah, Farhan and Raza, Umar and Fatima, Areej and Zhao, Yue and Touray, Barra},
 doi = {10.1109/AISTEMEDU67077.2025.11403899},
 journal = {AISTEMEDU 2025 - 2025 International Conference on AI-Driven STEM Education and Learning Technologies, Proceedings},
 note = {Cited by: 0},
