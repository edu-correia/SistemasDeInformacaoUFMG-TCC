@article{VELMURUGAN2026116041,
 abstract = {The development of multifunctional catalysts that integrate sustainable synthetic performance with biological utility represents a major challenge in green chemistry. We report the first synthesis of mononuclear copper(I) halide complexes incorporating the rare N-heterocyclic chalcogenone ligand perimidine-2-thione (PmT), namely [CuI(PPh₃)₂(PmT)] (1), [CuBr(PPh₃)₂(PmT)] (2), and [CuCl(PPh₃)₂(PmT)] (3). These complexes efficiently catalyze the Knoevenagel condensation in water medium, a green solvent under base- and additive-free conditions at ambient temperature, achieving up to 99 % yield with only 0.5 mol% catalyst loading. The process demonstrates broad substrate scope, excellent functional group tolerance, and produces water as the sole by-product, fulfilling multiple green chemistry principles including safer solvents, high atom economy, and energy efficiency. Among the series, the CuBr complex (2) exhibited the highest catalytic activity. Notably, complex 2 exhibited unprecedented efficiency in the Knoevenagel condensation of benzaldehyde with malononitrile, achieving a TON of 108,000 and TOF of 216,000 h−1 at an ultralow catalyst loading of 0.00025 mol%. These record values underscore its potential as a sustainable and resource-efficient catalyst. Also, complex 2 shows excellent recyclability, retaining its catalytic efficiency over seven consecutive cycles. Antimicrobial evaluation revealed that all complexes displayed stronger activity than free PmT against Escherichia coli and Staphylococcus aureus, with 1 and 3 showing the highest inhibition zones. Molecular docking studies confirmed superior binding affinities (−8.2 to −9.7 kcal/mol) toward key bacterial targets compared to the free ligand. This dual-function platform establishes Cu(I)–PmT complexes as promising scaffolds for both sustainable catalysis and antimicrobial development, directly supporting Sustainable Development Goals 3, 9, and 12.},
 author = {Priyanka Velmurugan and Veilumuthu Pattapulavar and John Godwin Christopher and Natalia Fridman and Tapas Ghatak},
 doi = {https://doi.org/10.1016/j.inoche.2025.116041},
 issn = {1387-7003},
 journal = {Inorganic Chemistry Communications},
 keyword = {Cu(I) complex, Knoevenagel condensation, Perimidine-2-thione, Aryl halides, Antimicrobial activity, Antimicrobial resistance, Molecular docking},
 pages = {116041},
 title = {Halide-responsive bifunctional copper(I) catalysis: Merging aqueous carbon–carbon bond formation with potent antimicrobial applications},
 url = {https://www.sciencedirect.com/science/article/pii/S1387700325021598},
 volume = {184},
 year = {2026}
}
