@article{MISAKA2026128645,
 abstract = {Liquid spreading on surfaces with micro- and nanoscale structures is crucial for a variety of engineering applications—including wick-enabled heat pipes, drug delivery systems, and fuel cells. However, the underlying nanoscale interactions governing wicking remain poorly understood. In this study, by employing a straightforward measurement system that integrates atomic force microscopy (AFM) with coherence scanning interferometry (CSI), we captured the local interactions between nanofibers and the spreading liquid with nanoscale spatial resolution. Consequently, we demonstrated that the horizontal alignment of cellulose nanofibers (CNFs) influences precursor film propagation: in regions with high alignment, the precursor film advanced steadily, reaching an effective propagation distance of up to approximately 100 μm. In contrast, over areas with low alignment, the film’s progression suppressed, limiting its maximum extension to approximately 70 μm. In addition, in areas where CNFs exhibit relatively large diameters or increased thickness due to overlapping deposition, capillary forces draw water from the precursor film, leading to the formation of microdroplets. These microdroplets coalesce with the macroscopic contact line, inducing its deformation toward the direction of contact line motion. Our findings demonstrate the importance of nanoscale surface morphology in governing macroscopic liquid behavior and provide fundamental insights for optimizing surface designs in advanced liquid-transport devices.},
 author = {Masumi Misaka and Hideaki Teshima and Qin-Yi Li and Koji Takahashi},
 doi = {https://doi.org/10.1016/j.ijheatmasstransfer.2026.128645},
 issn = {0017-9310},
 journal = {International Journal of Heat and Mass Transfer},
 keyword = {Coherence scanning interferometry, Wetting, Cellulose nanofibers, Three-phase contact line, Hemiwicking, Precursor film},
 pages = {128645},
 title = {Hydrophilic nanofiber alignment governs precursor film propagation},
 url = {https://www.sciencedirect.com/science/article/pii/S0017931026003212},
 volume = {263},
 year = {2026}
}
