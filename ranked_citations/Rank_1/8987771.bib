@inproceedings{8987771,
 abstract = {Video streaming is extensively usedin our day-to-day exercise. Remotely assisted surgery, tele-medicine and transmission of medical images are some of the significant applications where loss on image is unbearable. Error resilience technique takes very important role in these kinds of applications. Error resilient technique is a classical area of research for which several techniques are already devised and are in use in various applications. There are still more possibilities to improve the performance of these techniques. Here a combined error resilience technique is proposed for the transmission of color mosaic images. The color mosaic images are usually captured by single sensor cameras with color filter array(CFA). Color mosaic image has only one component of RGB for each pixel captured thus the storage size, cost and camera size are considerably reduced.},
 author = {Star, R. Gracy and Dhanaseelan, F. Ramesh and Shajeena, J.},
 booktitle = {2019 International Conference on Smart Systems and Inventive Technology (ICSSIT)},
 doi = {10.1109/ICSSIT46314.2019.8987771},
 issn = {},
 keyword = {Video coding;Image color analysis;Surgery;Transforms;Cameras;Smart systems;Propagation losses;Robustness;Resilience;Sensor arrays;Mosaic Image;Error Resilience;Video Coding;Image Transform},
 month = {Nov},
 number = {},
 pages = {157-162},
 title = {Error Resilient Transmission of Color Mosaic Images Using Combined Approach},
 volume = {},
 year = {2019}
}
