@conference{Li200933,
 abstract = {In the distance learning program, students' emotions need to be recognized and interpreted so as to motivate students and deepen learning. This paper focuses on how to conduct interactive learning between learners and teachers, and also proposes our solution based on EEG signal processing. We have set up a simulated environment of distance education, and recorded EEG signals of learners when they are visiting the website. We extract alpha waves (i.e., a component of EEG signals), and then merge it with the ontology of the website. Copyright 2009 ACM.},
 author = {Li, Xiaowei and Hu, Bin and Zhu, Tingshao and Yan, Jingzhi and Zheng, Fang},
 doi = {10.1145/1631111.1631118},
 journal = {1st ACM International Workshop on Multimedia Technologies for Distance Learning, MTDL 2009, Co-located with the 2009 ACM International Conference on Multimedia, MM'09},
 note = {Cited by: 59},
 pages = {33 - 38},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards affective learning with an EEG feedback approach},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/72049101526?origin=resultslist},
 year = {2009}
}
