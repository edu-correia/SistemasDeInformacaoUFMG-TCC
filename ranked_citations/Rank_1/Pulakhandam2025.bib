@conference{Pulakhandam2025,
 abstract = {The work proposes a metal surface defect detection method based on Gradient Vector Flow (GVF) Snakes for precise localization and Gray Level Co-occurrence Matrix (GLCM). The idea combines GVF Snakes for accurate contour detection and GLCM for extracting spatial relationships among pixels in images, allowing for automated high-accuracy flaw detection in noisy industrial environments. Experimental results demonstrate that the method is 98.5 % accurate, 97.8 % precise, and 97.2 % recall, with a significantly lower Root Mean Squared Error (RMSE) of 1. 5%, outperforming conventional methods. The combination of GVF Snakes and GLCM enhances segmentation accuracy and reduces errors, making it a crucial tool for robotics-based industrial fault diagnosis. With the removal of human inspection inconsistencies, an automated method enhances efficiency, reliability, and precision in defect detection, leading to improved production quality. © 2025 IEEE.},
 author = {Pulakhandam, Winner and Shahwar, Tayyaba and Vallu, Visrutatma Rao and Jagathpally, Abhignya and Arulkumaran, G.},
 doi = {10.1109/SSITCON66133.2025.11341994},
 journal = {International Conference on Software, Systems and Information Technology, SSITCON 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Advanced Metal Surface Defect Localization Using GLCM and Gradient Vector Flow Snakes in Robotics-Based Systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105033142928?origin=resultslist},
