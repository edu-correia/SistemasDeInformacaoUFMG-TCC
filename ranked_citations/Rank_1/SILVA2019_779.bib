@article{SILVA2019_779,
 abstract = {Abstract In this paper, the Laplace’s equation is solved analytically in the complex plane for the field of hydrodynamic pressures generated by the rigid body movement of a dam against a reservoir with infinite domain and incompressible fluid. The force the reservoir fluid exerts on the face of the dam is determined through the integration of the hydrodynamic pressure in the complex plane. The conservative effects (real part) and dissipative effects (imaginary part) of the force are analyzed as a function of the Froude number. The asymptotic solution of the aforementioned effects are also presented in this paper.},
 author = {SILVA, S. F. da and PEDROSO, L. J.},
 doi = {10.1590/s1983-41952019000400008},
 number = {4},
 pages = {858--873},
 title = {Interaction dam-reservoir: study of conservative and dissipative effects},
 volume = {12},
 year = {2019}
}
