@inproceedings{10267667,
 abstract = {The massive feed-in and the upcoming demand for charging electric vehicles with its power-intensive, volatile and unpredictable charging processes will increase the number of network congestion events on the distribution grid level in the near future. The changed feed-in structures and purchase characteristics result in an increased need for flexibility and control on the consumption side to merge the power demand with the supply-dependent feed-in. To take the steadily increasing penetration of electric vehicles into account, a cluster-based procedure and control principle is developed, which allows an interpretation of the holistic grid load by monetary incentives based on aging models of main grid assets. An intelligent charging control enables the usage of these incentives to reduce the charging power in a grid serving way. This paper presents the approach of a funded research project and shows first results of an intelligent, class-based and grid serving charging control for electric vehicles of powerful central charging infrastructures in an agent-based model.},
 author = {Hertlein, T. and Ochs, J. and Blenk, T. and Weindl, C.},
 booktitle = {27th International Conference on Electricity Distribution (CIRED 2023)},
 doi = {10.1049/icp.2023.0673},
 issn = {},
 keyword = {},
 month = {June},
 number = {},
 pages = {1174-1178},
 title = {Grid serving charging control of electric vehicles},
 volume = {2023},
 year = {2023}
}
