@incollection{SOLTANIFAR2025279,
 abstract = {Mergers and acquisitions (M&As) are pivotal strategies for organizational growth and market consolidation, yet the complexities in assessing their efficiency often present significant challenges. Traditional methods for merger analysis frequently overlook the impact of negative data—whether in terms of negative inputs or outputs—which can distort performance evaluations. This chapter introduces a novel approach to handling mergers within the context of inverse DEA-R models, specifically designed to address and integrate negative data. By leveraging the flexibility of ratio data and extending the traditional data envelopment analysis (DEA) framework, we propose models that accommodate negative values and provide a robust method for evaluating merged entities based on real-world financial ratios. In this work, we outline both output-oriented and input-oriented models, each tailored to handle specific challenges posed by negative data. The output-oriented models address scenarios where negative inputs might obscure true performance. In contrast, the input-oriented models provide a framework for analyzing mergers with negative outputs, highlighting inefficiencies that could otherwise remain hidden. These models are particularly suited for industries such as banking, finance, and insurance, where risk management is critical and sensitive financial data must be handled carefully. Our approach extends beyond theoretical development; we demonstrate the practical application of the proposed models through a real-world case study in the banking sector, showcasing how these models can be used to evaluate the efficiency of merged units using financial ratios. This case study not only preserves data confidentiality but also provides a comprehensive understanding of how mergers can be analyzed through the lens of DEA, offering clear insights into the operational efficiencies of merged branches. This chapter's contribution lies in its ability to bridge the gap between traditional DEA methods and the real-world complexities of merging entities while addressing the challenges posed by negative data. Introducing these inverse DEA-R models provides decision-makers with an innovative tool that enhances merger evaluations, facilitates more informed decision-making, and contributes to more efficient resource allocation in various sectors. This work marks a significant step forward in applying DEA for merger and acquisition analysis, offering new pathways for performance assessment in an increasingly data-driven world.},
 author = {Mehdi Soltanifar and Mojtaba Ghiyasi and Farhad Hosseinzadeh Lotfi and Mohammadreza Shahriari},
 booktitle = {Advanced Topics in Inverse Data Envelopment Analysis},
 doi = {https://doi.org/10.1016/B978-0-443-36488-4.00005-7},
 editor = {Mehdi Soltanifar and Mojtaba Ghiyasi and Farhad Hosseinzadeh Lotfi and Mohammadreza Shahriari},
 isbn = {978-0-443-36488-4},
 keyword = {Mergers and acquisitions, negative data, inverse data envelopment analysis},
 pages = {279-303},
 publisher = {Academic Press},
 series = {Uncertainty, Computational Techniques, and Decision Intelligence},
 title = {Chapter ten - Inverse ratio-based data envelopment analysis models for mergers and acquisitions in the presence of negative data},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443364884000057},
 year = {2025}
}
