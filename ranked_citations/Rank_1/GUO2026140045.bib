@article{GUO2026140045,
 abstract = {Chilled-water distribution is a significant contributor to HVAC energy consumption in conventional valve-regulated systems. While DVSP systems eliminate throttling losses by replacing valves with pumps, their multi-degree-of-freedom (MDoF) control faces a core conflict: constant-flow operation lacks demand response, while demand regulation causes hydraulic imbalance due to flow maldistribution among terminals. Although existing optimization algorithms can address this conflict, they are computationally complex and challenging for lightweight deployment. To address this fundamental challenge, this study developed a novel single-degree-of-freedom coordinated control strategy. The core innovation of this approach lies in its explicit white-box algorithm, which effectively collapses the complex MDoF problem into a straightforward determination of all pump speeds from a single baseline input. This represents a significant departure from the computational complexity inherent in conventional black-box optimization methods. The proposed methodology inherently ensures hydraulic balance while also providing a natural interface for integrating demand response. Through a comprehensive field measurement campaign spanning the entire cooling season at Shanghai Pudong International Airport, the algorithm demonstrated exceptional predictive accuracy, exceeding 99.7 %, thereby confirming its practical viability and direct applicability in real-world, large-scale infrastructure applications. Furthermore, high-fidelity simulations provided additional confirmation that the proposed strategy maintains excellent temperature stability, limits hydraulic imbalance to below 1.2 %, and achieves substantial energy savings averaging 32.5 % and 13.1 % compared to conventional control modes across various system operating conditions. This study presents a unified and scalable control framework that significantly enhances both hydraulic stability and energy efficiency in DVSP systems.},
 author = {Weichen Guo and Jiexiao Zeng and Chengye Lin and Liecheng Shen and Wei Ye and Jun Gao},
 doi = {https://doi.org/10.1016/j.energy.2026.140045},
 issn = {0360-5442},
 journal = {Energy},
 keyword = {Chilled water system, DVSP system, Variable-speed operation, Single-degree-of-freedom control},
 pages = {140045},
 title = {A single-degree-of-freedom coordinated control strategy for distributed variable-speed pumping systems: Integrating hydraulic balance and demand response for enhanced energy efficiency},
 url = {https://www.sciencedirect.com/science/article/pii/S0360544226001477},
 volume = {344},
 year = {2026}
}
