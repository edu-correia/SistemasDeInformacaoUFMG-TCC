@inproceedings{11045591,
 abstract = {This paper describes the design, development, and construction of an Unmanned Surface Vehicle (USV) aimed at underwater mine detection. The project proposes a solution to the urgent need for safe and efficient demining operations, reducing the risk to human life in hazardous maritime operations. While the USV's performance is entry-level, it merges advanced engineering principles with innovative design, prioritizing affordability and simplicity. The vehicle features a dual-motor propulsion system powered by brushed DC motors, chosen for their reliability and cost-effectiveness. Directional control is achieved through differential motor operation, which removes the necessity for complex rudder systems. The hull and structural elements are 3D-printed, designed to optimize water resistance and maintain a lightweight profile within the limits of current fabrication technology. A metal detection system is integrated into the USV, utilizing its capability to locate submerged metallic mines. This method is significantly more cost effective compared to sonar systems while still remaining effective. The electronics, including an Arduino Uno R3 microcontroller and an L298N motor driver, facilitate precise navigation and remote operation. Two dedicated power supply systems guarantee the continuous operation of both propulsion and detection components. The design and integration of all parts were modeled and validated using SOLIDWORKS, ensuring both structural integrity and operational efficiency. Extensive testing confirmed the USV's capability to detect submerged metallic objects and navigate effectively in controlled environments. This project underscores the potential of unmanned systems to lower the costs and risks associated with demining, while also paving the way for future advancements in autonomous maritime technologies.},
 author = {Fyntanidis, Theodosios - Konstantinos and Gkanetsos, Theodoros},
 booktitle = {2025 18th International Conference on Engineering of Modern Electric Systems (EMES)},
 doi = {10.1109/EMES65692.2025.11045591},
 issn = {2836-9866},
 keyword = {Technological innovation;Costs;Metals;Propulsion;Sonar navigation;DC motors;Three-dimensional printing;Autonomous vehicles;Vehicles;Testing;Arduino project;Maritime robotics;Mine detection;Unmanned Surface Vehicle (USV);3D Printing},
 month = {May},
