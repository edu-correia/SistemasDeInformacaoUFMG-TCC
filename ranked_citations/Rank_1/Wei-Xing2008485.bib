@conference{Wei-Xing2008485,
 abstract = {Based on the statistical analysis of relation between CBP (Coded Block Pattern), MVD (Motion Vector Difference) and each coding mode, a fast mode selection algorithm based on macroblock-adaptive is proposed. In this algorithm, adaptive judgement strategies are adopted to filter partial coding mode quickly. The residual CBP, MVD information is used adequately to identify the relativity of intra and inter frame. It only needs to compute the radio distortion cost of mode with very high possibility according to judgement rule combining with RDcost. Experimental results show that at the expense of 3.8 percent increase of bit rate, the coding complexity is reduced and the efficiency of coding mode selection is increased greatly. The encoding speed and the PSNR (peak signal to noise ratio) increases 53.27% and 0.023 dB respectively in average. © 2008 IEEE.},
 author = {Wei-Xing, Zhu and Ri-Xia, Wang and Xin-cheng, Li},
 doi = {10.1109/iscsct.2008.279},
 journal = {Proceedings - International Symposium on Computer Science and Computational Technology, ISCSCT 2008},
 note = {Cited by: 0},
 pages = {485 - 488},
 publication_stage = {Final},
 source = {Scopus},
 title = {Search of fast mode selection algorithm based on macroblock-adaptive},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/62349120345?origin=resultslist},
 volume = {2},
 year = {2008}
}
