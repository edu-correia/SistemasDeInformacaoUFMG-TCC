@article{MEDINAMUSELLAS2025114014,
 abstract = {Accurate modelling of building energy is essential to turn existing buildings into climate-resilient buildings. Due to the large amount of information and computational resources required to model the entire building stock, alternative approaches are needed. This study proposes a structured, automated method for systematically identifying reference buildings and developing the corresponding energy models. The method is demonstrated through a case study to evaluate the potential of rooftop-based interventions to enhance climate resilience across the Spanish residential stock. To achieve this, reference buildings were identified by applying the k-means clustering technique to a merged database that combines cadastral data and energy performance certificates. Detailed energy models were constructed in DesignBuilder using the available 3D cadastral data and the information contained in the energy performance certificates. To streamline the modelling process, inconsistencies among 3D formats were resolved through a custom script that modified the cadastral models. To effectively represent the existing residential stock, and considering that the technical feasibility of rooftop interventions largely depends on the roof type, 14 reference buildings were identified (seven with sloped roofs and seven with flat roofs). This approach provides a solid foundation for future accurate assessment of potential retrofit strategies tailored to each building typology and roof configuration. The proposed method provides a scalable and efficient solution for analysing national-scale building stock and significantly reduces computational demands, while ensuring high accuracy in predicting the impacts of retrofit measures.},
 author = {Juan José Medina-Musellas and Nicolás Carrasco-Astudillo and Kàtia Gaspar and Marta Gangolells and Miquel Casals},
 doi = {https://doi.org/10.1016/j.jobe.2025.114014},
 issn = {2352-7102},
 journal = {Journal of Building Engineering},
 keyword = {Buildings, Automation, Clustering, Roofs, Climate resilience, Energy modelling},
 pages = {114014},
 title = {An automated approach for modelling national-scale reference buildings: A case study on the potential of rooftop-based interventions in Spain},
 url = {https://www.sciencedirect.com/science/article/pii/S235271022502251X},
 volume = {113},
 year = {2025}
}
