@article{Kim2016509,
 abstract = {The hierarchical Dirichlet processes (HDP) is a Bayesian nonparametric model that provides a flexible mixed-membership to documents. In this paper, we develop a novel mini-batch online Gibbs sampler algorithm for the HDP which can be easily applied to massive and streaming data. For this purpose, a new prior process so called the generalized hierarchical Dirichlet processes (gHDP) is proposed. The gHDP is an extension of the standard HDP where some prespecified topics can be included in the top-level Dirichlet process. By analyzing various datasets, we show that the proposed mini-batch online Gibbs sampler algorithm performs significantly better than the online variational algorithm for the HDP. © Springer International Publishing AG 2016.},
 author = {Kim, Yongdai and Chae, Minwoo and Jeong, Kuhwan and Kang, Byungyup and Chung, Hyoju},
 doi = {10.1007/978-3-319-46128-1_32},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 7},
 pages = {509 - 523},
 publication_stage = {Final},
 source = {Scopus},
 title = {An online gibbs sampler algorithm for hierarchical dirichlet processes prior},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84988592569?origin=resultslist},
 volume = {9851 LNAI},
 year = {2016}
}
