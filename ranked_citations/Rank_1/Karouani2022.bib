@article{Karouani2022,
 abstract = {In Morocco, several dairy factories are placed in rural regions with a bad road network, which means that milk collection has a significant impact on profit, affecting milk transport costs. Actually, the milk run logistics process has been transformed from a traditional farm to the new cheese factory, so it’s needed efficient methods and models to improve the process of production and collection of milk from those units. For that, the authors apply new technologies such as the internet of things (IoT) and big data to collect and analyze this information to optimize the milk delivery process. The main goal of this work is to design a new smart decision method using the internet of things and big data to optimize the milk run logistics, reduce the cost of transportation, and improve collection density. This method will be based on the swarm artificial intelligence concept to find and calculate the shortest path between units to optimize the collection of milk. © 2022 IGI Global. All rights reserved.},
 author = {Karouani, Yassine and Elgarej, Mouhcine},
 doi = {10.4018/IJISSCM.290018},
 journal = {International Journal of Information Systems and Supply Chain Management},
 note = {Cited by: 15; All Open Access; Hybrid Gold Open Access},
 number = {3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Milk-run collection monitoring system using the internet of things based on swarm intelligence},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85118292141?origin=resultslist},
 volume = {15},
 year = {2022}
}
