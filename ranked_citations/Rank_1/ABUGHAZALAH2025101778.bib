@article{ABUGHAZALAH2025101778,
 abstract = {In this article, the Dual Hesitant Fuzzy Set Multi-Criteria Decision Making (DHFS-MCDM) method is employed to extensively compare and rank a list of ten candidate materials for use in shielding against radiation. Eight critical performance criteria for evaluation include attenuation factor, cost, durability, weight, thermal stability, environmental impact, ease of manufacture, and neutron absorption. Both expert judgment and the Dual Hesitant Fuzzy Weighted Averaging (DHFWA) operator are merged, with entropy perspective weights for expressing the comparative importance of each criterion. This article contributes by combining the unification of the DHFS-MCDM method with entropy perspective weights to tackle the material selection complexity, by providing multi-dimensional performance comparison for radiation shielding material against functional as well as performance criteria, and by being able to provide insightful outcomes in technical performance versus practical applications involving shielding materials. The results authenticate the effectiveness and usefulness of the proposed method for multi-dimensional decision support for improving radiation shielding.},
 author = {Nabilah Abughazalah and Majid Khan},
 doi = {https://doi.org/10.1016/j.jrras.2025.101778},
 issn = {1687-8507},
 journal = {Journal of Radiation Research and Applied Sciences},
 keyword = {Dual hesitant fuzzy set, Multi-criteria decision making, Radiation shielding, Material, Entropy weights},
 number = {3},
 pages = {101778},
 title = {An intelligent multi-criteria decision making strategy for radiation shielding materials selection using dual hesitant fuzzy set and entropy weighting},
 url = {https://www.sciencedirect.com/science/article/pii/S168785072500490X},
 volume = {18},
 year = {2025}
}
