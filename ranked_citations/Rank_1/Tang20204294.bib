@conference{Tang20204294,
 abstract = {Vehicle and pedestrian detection has always been an important and challenging task in the autonomous driving technology. To solve this problem, this paper proposes an optimized method based on YOLOv3, which is utilized to detect vehicles, pedestrians and cyclists. On the basis of traditional YOLOv3, this algorithm increases the number of deep residual structure and feature map sizes. And then cascades feature maps of various sizes in the backbone network to obtain the Feature Map-Concat (FC) structure. We also optimize the regression loss function at the same time. The evaluation index of this algorithm was implemented on KITTI data set, the results showed that the proposed detection algorithm proposed in this paper achieved encouraging results. © 2020 IEEE.},
 author = {Tang, Kuan and Yan, Fei and Liu, Wenbo},
 doi = {10.1109/CAC51589.2020.9327192},
 journal = {Proceedings - 2020 Chinese Automation Congress, CAC 2020},
 note = {Cited by: 1},
 pages = {4294 - 4299},
 publication_stage = {Final},
 source = {Scopus},
 title = {Pedestrian-Vehicle Detection Model Based on Optimized YOLOv3},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85100944654?origin=resultslist},
 year = {2020}
}
