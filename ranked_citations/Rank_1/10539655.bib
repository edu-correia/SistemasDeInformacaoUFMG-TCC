 issn = {},
 keyword = {Graphics;Deep learning;Technological innovation;Limiting;Reviews;Image processing;Computational modeling;Multiscale image processing;Embroidered patterns and decorations;Graphic redesign},
 month = {Feb},
 number = {},
 pages = {939-942},
 title = {A Redesign Method for Embroidery Pattern Graphics Based on Multiscale Image Processing Technology},
 volume = {},
