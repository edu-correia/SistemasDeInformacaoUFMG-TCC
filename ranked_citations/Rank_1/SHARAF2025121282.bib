@article{SHARAF2025121282,
 abstract = {This work provides a new integrated model for the advanced analysis of steel frames subjected to span loads. The proposed model assumes plasticity to be distributed along the member span and uses the concept of one element per member during displacement based analysis. This model helps to overcome limitations related to one element approach in the stiffness-based advanced analysis, as most one element models allow nodal loads only, or concentrated plasticity. The suggested model can calculate the variation in fixed end forces due to material yielding along the span of the member. Unlike flexibility-based elements, the suggested element formulation is based on direct substitution in closed system of expressions without additional internal numerical integrations. The provided model can save much calculations during element formulation process and establishing the equilibrium condition. Plasticity spread along the member span is traced by monitoring yielding at a number of internal cross-sections along the span, then plasticity effects at these cross-sections are merged in the one element stiffness matrix. Second order effects are considered by incorporating fifth order displacement function that takes member lateral loads into consideration and accounts for the interaction between the axial force effect and flexural actions due to nodal forces and span loads. A finite element program is developed employing the proposed model with an appropriate nonlinear analysis procedure. Many steel frames are solved and the results are compared with solutions by other researches or by solutions from fine mesh analysis. The proposed model presented high accuracy without much calculation cost.},
 author = {Tarek Sharaf and Abbad-Elrahman Farag and Mohamed Elghandour and Ashraf ElSabbagh},
 doi = {https://doi.org/10.1016/j.engstruct.2025.121282},
 issn = {0141-0296},
 journal = {Engineering Structures},
 keyword = {Plasticity spread, Three-dimensional frames, Span loaded element, Second order analysis, Beam-column element},
 pages = {121282},
 title = {Large deflection analysis of steel frames subjected to lateral span loads considering distributed plasticity},
 url = {https://www.sciencedirect.com/science/article/pii/S0141029625016736},
 volume = {343},
 year = {2025}
}
