@article{10.1145/3817050,
 abstract = {The Heluo region's distinctive terrain is essential to its cultural legacy, yet conventional visualization techniques are still labor-intensive and semantically constrained. We suggest a semantic-aware framework for recreating cultural landscapes from natural language descriptions in order to overcome this difficulty. The technology converts implicit spatial semantics into 3D layouts that are culturally coherent by combining dependency parsing with a rule-governed scene graph architecture. When compared to manual modeling, experimental validation shows that the suggested method reduces scene construction time by more than 85% while maintaining spatial logic. This approach offers a scalable and comprehensible technical base for digital cultural heritage reconstruction instead of pursuing unrestricted generative synthesis.},
 address = {New York, NY, USA},
 author = {Liang, Hui and Wang, Xue},
 doi = {10.1145/3817050},
 issn = {1556-4673},
 journal = {J. Comput. Cult. Herit.},
 keyword = {Semantic Scene Graph, Semantic-Driven, Heluo Culture, 3D Modeling, Natural Language Processing, Cultural Landscape Reconstruction, Digital Heritage},
 month = {May},
 note = {Just Accepted},
 publisher = {Association for Computing Machinery},
 title = {Semantic-Driven and NLP-Powered Generation of the Heluo Cultural Landscape for Digital Heritage},
 url = {https://doi.org/10.1145/3817050},
 year = {2026}
}
