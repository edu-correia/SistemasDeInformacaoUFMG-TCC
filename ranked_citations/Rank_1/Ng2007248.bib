@conference{Ng2007248,
 abstract = {Non-uniform traffics can severely degrade the performance of code division multiple access (CDMA) and space division multiple access (SDMA) cellular systems. In this paper, we propose a novel interference cancellation scheme by using the joint multiple access system from the merge of CDMA and SDMA systems to form dynamic space code multiple access (DSCMA). This multiple access system uses a modified version of large area synchronous (LAS) sequence called LAS even-ternary (LAS-ET) sequence to increase its duty ratio. This sequence also exhibits a region called interference free window (IFW) near zero delay time offset. In order to ensure that all the signal components drop within the IFW, a narrow beam with higher directivity smart antenna system is exploited. The size of IFW is adapted to the smart antenna half-power beamwidth using DSC algorithm. By using this algorithm the spectrum efficiency is further increased. Finally, all the interferences induced in non-uniform traffics can be dramatically reduced in DSCMA system and thus resulting in a higher system capacity. ©2007 IEEE.},
 author = {Ng, Chee Kyun and Ali, Borhanuddin Mohd and Khatun, Sabira and Jamuar, Sudhanshu Shekhar and Ismail, Mahamod},
 doi = {10.1109/ICTMICC.2007.4448641},
 journal = {Proceeding - 2007 IEEE International Conference on Telecommunications and Malaysia International Conference on Communications, ICT-MICC 2007},
 note = {Cited by: 1},
 pages = {248 - 253},
 publication_stage = {Final},
 source = {Scopus},
 title = {An interference cancellation scheme using dynamic space code multiple access (DSCMA) system},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/48349126052?origin=resultslist},
 year = {2007}
}
