@conference{Parravicini2021799,
 abstract = {Top-K SpMV is a key component of similarity-search on sparse embeddings. This sparse workload does not perform well on general-purpose NUMA systems that employ traditional caching strategies. Instead, modern FPGA accelerator cards have a few tricks up their sleeve. We introduce a Top-KSpMV FPGA design that leverages reduced precision and a novel packet-wise CSR matrix compression, enabling custom data layouts and delivering bandwidth efficiency often unreachable even in architectures with higher peak bandwidth. With HBM-based boards, we are 100x faster than a multi-threaded CPU implementation and 2x faster than a GPU with 20% higher bandwidth, with 14.2x higher power-efficiency. © 2021 IEEE.},
 author = {Parravicini, Alberto and Cellamare, Luca Giuseppe and Siracusa, Marco and Santambrogio, Marco D.},
 doi = {10.1109/DAC18074.2021.9586203},
 journal = {Proceedings - Design Automation Conference},
 note = {Cited by: 11; All Open Access; Green Open Access},
 pages = {799 - 804},
 publication_stage = {Final},
 source = {Scopus},
 title = {Scaling up HBM Efficiency of Top-K SpMV for Approximate Embedding Similarity on FPGAs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85119440595?origin=resultslist},
 volume = {2021-December},
 year = {2021}
}
