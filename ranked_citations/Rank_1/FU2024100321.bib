@article{FU2024100321,
 abstract = {Summary
Recent advancements in integrating light into semiconductor integrated circuits have facilitated the implementation of optoelectronic logic operations (OELOs). However, the core components of OELOs (i.e., photodetectors) generally exhibit limited spectral range and immutable photoresponse, which restricts the expansion of the logic function. Herein, a sandwich-like photodetector composed of perovskite, graphene, and germanium is proposed, showcasing self-distinguishable dual-band photoresponse in the ultraviolet (UV) and near-infrared (NIR) regions. The device enables all-in-one OELOs via self-distinguishable photoresponse control. It offers three controllable current states (i.e., “1,” “0,” and “−1”) corresponding to UV, dark, and NIR conditions. The single device can perform five basic logical operations (i.e., “AND,” “OR,” “NOT,” “NAND,” and “NOR”).},
 author = {Jintao Fu and Lian Ji and Zichao Wu and Genglin Li and Changbin Nie and Wen Xiong and Fei Wang and Feiying Sun and Yecheng Zhou and Zhigang Zang and Tianshi Qin and Xingzhan Wei},
 doi = {https://doi.org/10.1016/j.device.2024.100321},
 issn = {2666-9986},
 journal = {Device},
 keyword = {graphene, perovskite, optoelectric logic operations, photodetector, dual-band photoresponse},
 number = {4},
 pages = {100321},
 title = {An all-in-one optoelectronic logic device with self-distinguishable dual-band photoresponse},
 url = {https://www.sciencedirect.com/science/article/pii/S2666998624001133},
 volume = {2},
 year = {2024}
}
