@inproceedings{10961099,
 abstract = {This research explores the innovative integration of eye and mouth-based interactions in Human-Computer Interaction (HCI) to enhance user engagement and system responsiveness. Leveraging advanced technologies such as eye-tracking and lip detection, our study focuses on developing a multimodal interface that interprets users' gaze and lip movements for intuitive and efficient interaction with digital systems. The eye-tracking component of the device allows for precise tracing of users' visual focus, facilitating natural cursor control and attention-based interactions. Concurrently, the lips detection system captures nuanced lip movements, expanding the input modalities to include non-verbal cues, gestures, and expressions. The integration of eye and mouth-based interactions introduces a dynamic and expressive dimension to HCI, catering to users with diverse abilities and preferences. Through a series of experiments and usability evaluations, we assess the system's effectiveness in tasks ranging from navigation to expressive communication. The findings showcase the potential for a more inclusive and adaptive HCI paradigm, where users can seamlessly navigate digital environments using a combination of eye gaze and facial expressions. This study adds to the growing landscape of HCI by proving the feasibility and benefits of adding eye and mouth-based interactions, paving the path for more natural and personalized human-computer interaction.},
 author = {Beevi, L Sherin and Joe Prathap, P. M. and G, Harsha and N, Jeeva and R, Jeevashree and Dani, W Vinil},
 booktitle = {2025 International Conference on Visual Analytics and Data Visualization (ICVADV)},
 doi = {10.1109/ICVADV63329.2025.10961099},
 issn = {},
 keyword = {Navigation;Lips;Visual analytics;Merging;Mouth;Gaze tracking;Speech recognition;User experience;Distance measurement;Usability;Human-Computer Interaction (HCI);Multimodal Technologies;Lips Detection;Eye tracing;Speech Recognition;Voice Conflation;Cursor Control;Auditory Feedback},
 month = {March},
 number = {},
 pages = {1415-1420},
 title = {Revolutionizing Mouse Cursor Control for Enhanced User Interaction},
