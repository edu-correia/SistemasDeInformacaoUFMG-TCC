@article{Duan2025,
 abstract = {AI-enhanced VR/AR technology creates unique opportunities for cultural remembrance by enabling immersive, adaptive, and interactive heritage experiences. Very few empirical studies are available exploring how technology-enabled cultural remembrance affects individual and collective memory. The current research study explored how artificial intelligence personalization, system interactivity, flow experience, and embodied presence encourage cultural remembrance in a virtual heritage context. Five thousand participants across provinces in China engaged with a custom-built AI–VR/AR platform, and completed structured surveys, through Google Forms, post-experience. Quantitative data were analyzed using descriptive statistics, multiple linear regression, and cluster analysis. Six hypotheses were supported with statistically significant results (p < 0.001). Flow experience (β = 0.32) and embodied presence (β = 0.30) were the strongest predictors of cultural remembrance. Overall cluster analysis revealed three profiles of engagement, with higher levels of immersion associated with improved memory outcomes. The findings indicate that immersive AI-enabled VR/AR environments make an important contribution to cultural memory, as they merge personalization, presence, and flow. This research demonstrates the experiential and educational value of AI–VR/AR systems intended for cultural preservation and the formation of identity in digital heritage learning spaces. © China Computer Federation (CCF) 2025.},
 author = {Duan, Limin and Zhang, Chao},
 doi = {10.1007/s42486-025-00218-8},
 journal = {CCF Transactions on Pervasive Computing and Interaction},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Article in press},
 source = {Scopus},
 title = {In what ways does the integration of AI and interactive technologies reshape the collective remembrance of cultural heritage in virtual and augmented reality experiences?},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105024799913?origin=resultslist},
 year = {2025}
}
