@article{10.5555/1060081.1060096,
 abstract = {This paper attempts to provide a solution to a seemingly simple grading problem. It introduces a notion of sorting for lists of weighted grades and puts forward an algorithmic candidate for this task. The paper then goes on to discuss the reliability of this algorithm and concludes with suggestions for student research. It is noted that the problem has similarities to both sorting and the knapsack problem and can be a nice addition to a course on algorithms.},
 address = {Evansville, IN, USA},
 author = {McGrail, Robert W. and McGrail, Tracey Baldwin},
 issn = {1937-4771},
 issue_date = {May 2004},
 journal = {J. Comput. Sci. Coll.},
 month = {May},
 number = {5},
 numpages = {11},
 pages = {97–107},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {A grading dilemma or the abyss between sorting and the knapsack problem},
 volume = {19},
 year = {2004}
}
