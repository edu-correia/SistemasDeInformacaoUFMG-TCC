@conference{Garg2012145,
 abstract = {We propose a probabilistic generative model for unsupervised semantic role induction, which integrates local role assignment decisions and a global role ordering decision in a unified model. The role sequence is divided into intervals based on the notion of primary roles, and each interval generates a sequence of secondary roles and syntactic constituents using local features. The global role ordering consists of the sequence of primary roles only, thus making it a partial ordering. © 2012 Association for Computational Linguistics.},
 author = {Garg, Nikhil and Henderson, James},
 journal = {50th Annual Meeting of the Association for Computational Linguistics, ACL 2012 - Proceedings of the Conference},
 note = {Cited by: 11},
 pages = {145 - 149},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unsupervised semantic role induction with global role ordering},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84878211946?origin=resultslist},
 volume = {2},
 year = {2012}
}
