@article{4115151,
 abstract = {In this paper we propose a technique to implement in a parallel fashion a turbo decoder based on an arbitrary permutation, and to expand its interleaver in order to produce a family of prunable S-random interleavers suitable for parallel implementations. We show that the spread properties of the obtained interleavers are almost optimal and we prove by simulation that they are very competitive in terms of error floor performance. A few details on the decoder architecture are also provided},
 author = {Tarable, Alberto and Dinoi, Libero and Benedetto, Sergio},
 doi = {10.1109/LCOMM.2007.061131},
 issn = {1558-2558},
 journal = {IEEE Communications Letters},
 keyword = {Turbo codes;Merging;Iterative decoding;Throughput;Delay;Multimedia systems;Read-write memory;Adaptive coding;Modulation coding;Algorithm design and analysis},
 month = {Feb},
 number = {2},
 pages = {167-169},
 title = {Design of Prunable Interleavers for Parallel Turbo Decoder Architectures},
 volume = {11},
 year = {2007}
}
