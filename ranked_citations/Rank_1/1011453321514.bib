@article{10.1145/3321514,
 abstract = {Multi-degree splines are smooth piecewise-polynomial functions where the pieces can have different degrees. We describe a simple algorithmic construction of a set of basis functions for the space of multi-degree splines with similar properties to standard B-splines. These basis functions are called multi-degree B-splines (or MDB-splines). The construction relies on an extraction operator that represents all MDB-splines as linear combinations of local B-splines of different degrees. This enables the use of existing efficient algorithms for B-spline evaluations and refinements in the context of multi-degree splines. A MATLAB implementation is provided to illustrate the computation and use of MDB-splines.},
 address = {New York, NY, USA},
 articleno = {43},
 author = {Speleers, Hendrik},
 doi = {10.1145/3321514},
 issn = {0098-3500},
 issue_date = {December 2019},
 journal = {ACM Trans. Math. Softw.},
 keyword = {B-splines, Extraction operator, MDB-splines, Multi-degree splines},
 month = {December},
 number = {4},
 numpages = {15},
 publisher = {Association for Computing Machinery},
 title = {Algorithm 999: Computation of Multi-Degree B-Splines},
 url = {https://doi.org/10.1145/3321514},
 volume = {45},
 year = {2019}
}
