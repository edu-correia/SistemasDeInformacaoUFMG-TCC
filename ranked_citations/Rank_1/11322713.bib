@article{11322713,
 abstract = {Infrared unmanned aerial vehicle (UAV) detection remains challenging due to thermal crossover (TC) interference, small target characteristics, and dynamic background clutter (DBC). Existing methods, such as Siamese trackers and single-frame detectors, often struggle to balance spatial discriminability and temporal continuity, leading to degraded robustness in complex environments. To address these issues, we propose an infrared spatial-temporal detection transformer (IRST-DETR), an endto- end video detection framework that integrates spatiotemporal features for robust UAV detection. IRST-DETR combines a spatial branch with a detail-enriched pyramid module (DEPM) for fine-grained feature extraction and a temporal branch using Video Swin Transformer to model motion dynamics. Hierarchical fusion modules, including the temporal gate fusion module (TGFM) and the spatial-temporal attention fusion module (STAFM), adaptively merge spatiotemporal information, enhancing robustness against thermal noise. To rigorously evaluate performance in challenging conditions, we construct a specialized evaluation subset from Anti-UAV410, focusing on cluttered infrared scenes with dynamic thermal interference. Extensive experiments on Anti- UAV300, Anti-UAV410, and the challenging subset demonstrate that IRST-DETR achieves state-of-the-art performance. It outperforms Siamese trackers by 2.8% in state accuracy (SA) and surpasses single-frame detectors by over 9% in complex scenarios, with ablation studies confirming its efficiency. This work advances practical infrared UAV detection in real-world environments. Code and models are available at https://github.com/henryHu-manboo/irst_detr.},
 author = {Hu, Hengrui and Li, Tianhui and Liu, Bo and Zeng, Hui},
 doi = {10.1109/JSEN.2025.3648169},
 issn = {1558-1748},
 journal = {IEEE Sensors Journal},
 keyword = {Feature extraction;Videos;Detectors;Spatiotemporal phenomena;Autonomous aerial vehicles;Transformers;Target tracking;Dynamics;Video sequences;Interference;Anti-unmanned aerial vehicle (UAV);infrared video;small target detection;spatiotemporal fusion;thermal crossover (TC)},
 month = {Feb},
 number = {4},
 pages = {5805-5817},
 title = {Robust Infrared UAV Detection Method Based on Spatiotemporal Transformer in Thermal Crossover Dynamic Scenarios},
 volume = {26},
 year = {2026}
}
