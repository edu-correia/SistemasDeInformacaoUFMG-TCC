@inproceedings{11256380,
 abstract = {The goal of this paper is to forecast startup success by combining textual, structured and network data in a multi-modal manner. Three models, each trained on a different type of data, are used: BERT for textual data, FFNN for structured data and GNN for network data. 99.15% accuracy is attained by BERT with a low loss of $0.03,93.82 \%$ accuracy is attained by FFNN with a loss of 0.16 and 70% accuracy is attained by GNN with a greater loss of 0.44. Using a stacking ensemble technique the outputs from all three models are merged and the predictions are integrated by a meta-model, achieving an overall accuracy of 88% with a minimal loss of 0.024. By utilizing the advantages of each model individually, this ensemble approach enhances the ability to predict company success and offers insightful information to all parties involved in the startup ecosystem.},
 author = {Rithani, M and Aparna, S and Sravani, Maddineni and SyamDev, R S},
 booktitle = {2025 IEEE International Conference on Contemporary Computing and Communications (InC4)},
 doi = {10.1109/InC465408.2025.11256380},
 issn = {},
 keyword = {Adaptation models;Accuracy;Biological system modeling;Computational modeling;Stacking;Ecosystems;Predictive models;Data models;Ensemble learning;Standards;Ensemble Learning;BERT;FFNN;GNN;Stacking Model;CrunchBase Dataset;GCN},
 month = {March},
 number = {},
 pages = {1-5},
 title = {Comprehensive Startup Success Prediction Using Textual, Structured and Network Data Models},
 volume = {},
 year = {2025}
}
