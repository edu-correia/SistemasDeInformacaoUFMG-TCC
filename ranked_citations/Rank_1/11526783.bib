@article{11526783,
 abstract = {The step-by-step evolution of strain ${}_{\textit {xx}}$  along the current direction of monolithic nanosheet (NS) complementary FET (CFET) is studied through finite element analysis (FEA). The defective merge of source/drain regrowth is modeled by an air gap, while the defect-free merge of S/D regrowth is modeled by seamless S/D. After channel release, the bottom Si0.8 Ge0.2 pFET with seamless Si0.6 Ge0.4 S/D is compressively strained, while the top Si nFET with seamed Si:P ( $3\times 10^{{21}}$  cm ${}^{-{3}}$ ) S/D is also slightly compressively strained due to inward bending of Si:P S/D regrowth. Seamless Si:P/Si0.95 C0.05 and seamed Si0.8 Ge0.2 S/D can provide the desired tensile strain ${}_{\textit {xx}}$  to top nFETs to boost mobility. The seamless Si:P and seamless Si0.6 Ge0.4 S/D of nFET and pFET, respectively, can provide strain-enhanced mobility and uniform inter-NS strain regardless of the n on p or p on n placement.},
 author = {Liu, Ying-Qi and Chou, Hung-Chun and Chou, Tao and Wu, Xuan-Hao and Huang, Bo-Wei and Tu, Chien-Te and Liu, Yi-Chun and Liu, C. W.},
 doi = {10.1109/TED.2026.3692629},
 issn = {1557-9646},
 journal = {IEEE Transactions on Electron Devices},
 keyword = {Strain;Silicon;Current;Silicon germanium;Calcium;Storage area networks;Very large scale integration;Electrons;Stacking;Air gaps;Finite element analysis (FEA);monolithic 3-D;nanosheet (NS) complementary FETs (CFETs);SiGe;strain},
 month = {},
 number = {},
 pages = {1-8},
 title = {Comprehensive Strain Study of Monolithic Nanosheet CFETs},
 volume = {},
 year = {2026}
}
