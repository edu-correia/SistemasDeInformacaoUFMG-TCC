@article{Arai2023403,
 abstract = {Nonlinear merge and split based image clustering method through changing the number of clusters is proposed. A nonlinear merge and split method for image clustering is proposed to overcome a complicated situation for the cluster’s distributions in a feature space which is relatively difficult to cluster with the linear approach like a k-means and ISODATA clustering algorithms. Through experiments, it is found that the proposed clustering method with the merge and split method by considering the within and between cluster variances, allows to overcome the complicated situation of the probability density function of clusters. It is also found that the proposed method is superior to the existing clustering method in terms of the similarity between the clustered resultant image and the topographic map of the corresponding map. Furthermore, the effectiveness of the proposed clustering method is shown with the real remote sensing satellite imagery data. © 2023, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Arai, Kohei},
 doi = {10.1007/978-3-031-28076-4_30},
 journal = {Lecture Notes in Networks and Systems},
 note = {Cited by: 0},
 pages = {403 - 416},
 publication_stage = {Final},
 source = {Scopus},
 title = {Nonlinear Merge and Split Based Image Clustering Method Through Changing the Number of Clusters},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85149979798?origin=resultslist},
 volume = {651 LNNS},
 year = {2023}
}
