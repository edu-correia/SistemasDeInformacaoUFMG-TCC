@conference{Schahn2024515,
 abstract = {In recent years, automated driving has become viable, and advanced driver assistance systems (ADAS) are now part of modern cars. These systems require highly precise positioning. In this paper, a cooperative approach to localization is presented. The GPS information from several road users is collected in a Mobile Edge Computing cloud, and the characteristics of GNSS positioning are used to provide lane-precise positioning for all participants by applying probabilistic filters and HD maps.  © 2024 IEEE.},
 author = {Schahn, Christopher and Kouril, Jorin and Schaeufele, Bernd and Radusch, Ilja},
 doi = {10.1109/ICOIN59985.2024.10572033},
 journal = {International Conference on Information Networking},
 note = {Cited by: 1; All Open Access; Green Open Access},
