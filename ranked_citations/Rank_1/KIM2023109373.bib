@article{KIM2023109373,
 abstract = {We present a broadband muffler using a metamaterial consisting of a membrane structure and a Helmholtz resonator. The membrane structure with ventilation exhibited negative effective density in the 290–435 Hz frequency range. The Helmholtz resonator exhibited negative effective compressibility in the 440–600 Hz range. We connected the two frequency ranges to continue the negativity by matching the end frequency of the negative effective density and the start frequency of the negative effective compressibility. The metamaterial muffler showed a wide range of imaginary components of wavenumbers from 290 to 600 Hz. The muffler exhibits 10 dB transmission loss or 10 % power transmission in the frequency range 275–500 Hz. The realization of a metamaterial muffler with a broad and low-frequency performance range is unprecedented when considering the resonant properties of the metamaterial.},
 author = {Minseok Kim and Kyuhyeon Lee and Eun Bok and Donghwa Hong and Jiwon Seo and Sam H. Lee},
 doi = {https://doi.org/10.1016/j.apacoust.2023.109373},
 issn = {0003-682X},
 journal = {Applied Acoustics},
 keyword = {Metamaterial, Muffler, Negative effective density, Negative effective compressibility},
 pages = {109373},
 title = {Broadband muffler by merging negative density and negative compressibility},
 url = {https://www.sciencedirect.com/science/article/pii/S0003682X23001718},
 volume = {208},
 year = {2023}
}
