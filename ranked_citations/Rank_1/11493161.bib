@inproceedings{11493161,
 abstract = {The rapid expansion of digital payment systems in India has been driven by the widespread adoption of the Unified Payments Interface. The system enables people to send and receive money through its ability to process transactions in a quick, secure, and user-friendly manner. The world now sees cryptocurrencies as an additional method of using digital currency because their popularity continues to grow. The two systems now require solutions that will establish connections between traditional currencies like the Indian Rupee and digital currencies.This paper discusses developing a unified platform that enables different types of currency to function together without any interruptions. The system needs to deliver secure payment processing and transparent payment methods while providing efficient payment processing and multiple payment options for users. The paper uses this integration method to demonstrate how upcoming payment systems will merge UPI and cryptocurrency features, which will create new hybrid financial solutions to advance digital finance worldwide.},
 author = {Pratap, A Raghuvira and Vellanki, Sanjana and Shainy, Shaik Nageen},
 booktitle = {2026 International Conference on Emerging Smart Computing and Informatics (ESCI)},
 doi = {10.1109/ESCI68015.2026.11493161},
 issn = {2996-1815},
 keyword = {Interoperability;Protocols;Smart contracts;Internetworking;Communication systems;HTTP;Smart phones;Routing;Communications technology;Information and communication technology;Unified Payments Interface (UPI);Cryptocurrencies;Digital Payments;Hybrid Financial Systems;Secure Payment Processing},
 month = {March},
 number = {},
 pages = {1-6},
 title = {UPI CryptoConnect: Unifying Fiat and Crypto for Seamless Digital Payments},
 volume = {},
 year = {2026}
