@article{ZHAO2026106425,
 abstract = {Transformative resilience has not yet been adequately established in fixed notions and research areas. This study endeavors to define transformative resilience through data-driven insights and explores trends in related research by mapping its topics and fields. We employed Latent Dirichlet Allocation (LDA) topic modeling, which extracts key terms and insights into topics from a large volume of literature. We traced the evolution of research topics from 1951 to 2024 based on connections between citations. The data were sourced from the Scopus database using the query term “transformative resilience”, encompassing titles, abstracts, and keywords of journal articles, book chapters, and conference papers. We collected a total of 3110 related pieces of literature. We defined transformative resilience as a change of system structure accompanied by a shift in socio-political values and policy. The results of LDA showed that transformative resilience research has developed into seven fields: Innovation and Economic Policy, Supply Chain and Technological Response, Health and Social Well-being, Agriculture and Environmental Impact, Community Resilience and Disaster Recovery, Sustainability Theory and Practice, and Urban Governance and Planning. Based on topic evolution relationships, topics anchored in a context perspective have grown increasingly specialized and productive, while those rooted in a theory perspective have stagnated or remained underexplored. Our findings suggest that transformative resilience studies should foster greater interdisciplinary connections to effectively integrate current research, merging mechanization-centered approaches with a focus on building context-centered resilience.},
 author = {Ru Zhao and Meiling Yang and Dongping Long and Xingang Fan and Zhengsheng Zhang and Yingping Duan and Zhihong Zhang and Yuhang Ye and Jinlin Chen},
 doi = {https://doi.org/10.1016/j.cities.2025.106425},
 issn = {0264-2751},
 journal = {Cities},
 keyword = {Transformative resilience, Text mining, Latent Dirichlet Allocation (LDA), Research evolutionary relationship, Transformative resilience knowledge mapping, Scopus},
 pages = {106425},
 title = {The evolution of transformative resilience research topics: A data-driven analysis},
 url = {https://www.sciencedirect.com/science/article/pii/S0264275125007267},
 volume = {168},
 year = {2026}
}
