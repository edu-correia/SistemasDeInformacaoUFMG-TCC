@inproceedings{5335660,
 abstract = {This paper describes a new mechanism for concurrent use of more functional units, without increasing the control path of a generic VLIW architecture. The proposed approach only requires small modifications in the architecture and a new code selection function in the instruction scheduler. The key idea of this approach is to search for similar independent operations inside a basic assembler code block and merge them in a single instruction, which executes the same operation with even and odd operand registers in two different functional units. A comprehensive evaluation of this mechanism with two multimedia tasks shows an improvement of the dynamic instructions-per-cycle, exceeding the theoretical maximum of the reference architecture.},
 author = {Payá-Vayá, Guillermo and Martín-Langerwerf, Javier and Giesemann, Florian and Blume, Holger and Pirsch, Peter},
 booktitle = {2009 International Symposium on System-on-Chip},
 doi = {10.1109/SOCC.2009.5335660},
 issn = {},
 keyword = {Merging;VLIW;Computer architecture;Parallel processing;Microelectronics;Registers;Processor scheduling;Hardware;Energy consumption;Decoding},
 month = {Oct},
 number = {},
 pages = {143-146},
 title = {Instruction merging to increase parallelism in VLIW architectures},
 volume = {},
 year = {2009}
}
