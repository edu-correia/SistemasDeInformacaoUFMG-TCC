@conference{BalaDhandayuthapani2025,
 abstract = {Predictive dental analytics are gaining opportunities due to the growing adoption of artificial intelligence in health care. In the present study, a framework of the Machine Learning-Based Predictive Analysis of Dental Treatment Outcomes framework is proposed based on Z-Score Normalization, Mutual Information, and Hybrid Deep Neural Network (HDNN) with CNN, BiLSTM, and Attention mechanisms, which can be trained in PyTorch Lightning. The system is suggested to merge imaging, clinical and behavioral data to provide an accurate prediction of the success of the treatment and finding factors that have an impact on the patient in particular. The CNN part is used to extract spatial representations of radiographs, the BiLSTM is used to extract the temporal representations of consecutive clinical notes, and the attention layer is used to improve the interpretability. Compared to traditional machine learning models, experimental evaluation is better, with an accuracy of 94.2% and AUC of 0.96. The findings confirm that this integrative framework is an efficient, interpretable, and scalable system of predicting outcomes in real-time dental care to assist in making clinical decisions and addressing patients individually. © 2025 IEEE.},
 author = {BalaDhandayuthapani, V. and Giri, Virat Vasantrao and Dodia, Manish and Sanjaya, P.R. and Arun, R.T. and Maity, Shreyasee},
 doi = {10.1109/ICONSTEM65670.2025.11374450},
 journal = {Proceedings of 2025 10th International Conference on Science Technology, Engineering and Mathematics, ICONSTEM 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Machine Learning-Based Predictive Analysis of Dental Treatment Outcomes},
 type = {Conference paper},
