@conference{Wei2024291,
 abstract = {This paper addresses the critical role of interoperability testing for launch and control electronic information systems and introduces a novel test case generation method leveraging the Whale Optimization Algorithm (WOA). With the increasing complexity of launch missions, ensuring seamless coordination between these systems is of paramount importance. By constructing state transition models and optimizing parameter combinations, WOA can efficiently generate high-coverage test cases that validate system interoperability. Experimental results demonstrate that WOA significantly outperforms traditional algorithms, such as Particle Swarm Optimization (PSO) and Genetic Algorithm (GA), in terms of the number of test cases generated, convergence speed, coverage rate, and fitness value. This method presents a robust solution for enhancing the testing efficiency and reliability of launch and control electronic information systems in the context of complex mission scenarios.  © 2024 IEEE.},
 author = {Wei, Changan and Xu, Ji and Bo, Zhong and Sheng, Yunlong and Wang, Feixuan},
 doi = {10.1109/ICFTIC64248.2024.10913072},
 journal = {2024 6th International Conference on Frontier Technologies of Information and Computer, ICFTIC 2024},
 note = {Cited by: 1},
 pages = {291 - 295},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Interoperability Test Case Generation Method for State Transition and Parameter Combination Coverage},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105001674084?origin=resultslist},
 year = {2024}
}
