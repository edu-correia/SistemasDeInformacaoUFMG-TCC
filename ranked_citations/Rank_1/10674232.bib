@inproceedings{10674232,
 abstract = {In this paper, a light-weight vision-transformer-based (ViT) semantic segmentation method with self-supervised learning (SSL) was developed for medical images. The proposed method is composed of three parts: encoder, decoder, and prediction head. The encoder is a light-weight ViT called M- iFormer developed based on iFormer and the split-and-merge strategy. A decoder is designed to fuse the multi-scale feature maps and a prediction head is developed to predict the semantic segmentation map. Furthermore, due to a small size of medical images, the proposed ViT-based method can be trained based on SSL. For performance evaluation, some medical images are selected. F1-score, pixel accuracy, and mIoU of the proposed method are 89.37%, 99.06%, and 82.6%, respectively. Moreover, the proposed method outperforms an existing method. These experimental results demonstrate that the proposed light-weight ViT-based method can achieve semantic segmentation well for medical images.},
 author = {Lin, Hsiu-Ming and Lin, Guo-Shiang and Chang, Chuan-Wang and Chang, Ku-Yaw and Yeh, Wei-Cheng},
 booktitle = {2024 International Conference on Consumer Electronics - Taiwan (ICCE-Taiwan)},
 doi = {10.1109/ICCE-Taiwan62264.2024.10674232},
 issn = {2575-8284},
 keyword = {Performance evaluation;Head;Accuracy;Fuses;Semantic segmentation;Self-supervised learning;Transformers},
 month = {July},
 number = {},
 pages = {719-720},
 title = {Light-Weight Semantic Segmentation Based on Vision Transformer and Self-Supervised Learning},
 volume = {},
 year = {2024}
}
