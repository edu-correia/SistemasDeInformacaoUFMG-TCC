@article{10.1145/3785144,
 abstract = {Travel within EU is subject to a number of laws, some of which require gathering of Passenger Name Records (PNRs) by airlines, later sent to specialized police task forces called Passenger Information Units (PIUs) for processing, with the aim of prevention, detection, investigation and prosecution of terrorist offenses and serious crime. The TENACITy (Travel Intelligence Against Crime and Terrorism) project is developing a set of tools to aid PIUs in effectively utilizing PNR data in their work. This extended paper showcases the blockchain subsystem developed within TENACITy. It intends to provide a way to exchange PNR data between PIUs while ensuring critical features such as data confidentiality, auditability, and non-repudiation, thereby maintaining a reliable chain of custody. The system combines blockchain technology and off-chain storage to enable secure management of sensitive information, tackling data retention challenges imposed by regulations regarding sensitive citizen data. This paper contributes to the field by illustrating the practical implementation of blockchain technology for sensitive data sharing, offering insights into the system’s design, deployment challenges, and opportunities for future enhancement.},
 address = {New York, NY, USA},
 author = {Koutensk\'{y}, Michal and Vesel\'{y}, Vladim\'{\i}r and Pere\v{s}\'{\i}ni, Martin and Dolej\v{s}ka, Daniel and Pluskal, Jan},
 doi = {10.1145/3785144},
 journal = {Distrib. Ledger Technol.},
 keyword = {blockchain, hyperledger fabric, smart contract, passenger name record, advanced passenger information, travel intelligence},
 month = {December},
 note = {Just Accepted},
 publisher = {Association for Computing Machinery},
 title = {Using Blockchain to Secure Passenger Name Records and Effectively Protect Citizen Rights: Director’s Cut},
 url = {https://doi.org/10.1145/3785144},
 year = {2025}
}
