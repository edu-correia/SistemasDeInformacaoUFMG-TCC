@inproceedings{11360372,
 abstract = {As cyberattacks grow increasingly sophisticated, modern Intrusion Detection Systems (IDS) demand more advanced techniques to detect malicious behavior. While heterogeneous graph neural networks (HGNNs) have emerged as a promising approach for modeling attack graphs, existing methods fail to effectively exploit domain-specific semantic connections, limiting their ability to capture discriminative attack patterns in real-world scenarios. In this paper, we propose a novel Meta-Graph enhanced Heterogeneous Graph Network for cyber malicious behavior detection. Our model first extracts metapath instances from target nodes and merges them into unified meta-graphs, explicitly encoding attack chains as higher-order semantic patterns. Then, we employ a dual attention mechanism to dynamically weigh both node-level features and cross-graph relationships, filtering noise while amplifying critical attack signals. Finally, we introduce contrastive importance learning with hinge loss to prioritize multi-semantic neighbors over mono-semantic ones, explicitly enhancing malicious pattern detection. Extensive experiments on the DARPA Transparent Computing dataset show our model outperforms state-of-the-art heterogeneous GNNs in detection accuracy.},
 author = {Bi, Saibing and Zeng, Liyi and Gu, Zhaoquan},
 booktitle = {2025 IEEE 10th International Conference on Data Science in Cyberspace (DSC)},
 doi = {10.1109/DSC67331.2025.00024},
 issn = {},
 keyword = {Limiting;Computational modeling;Semantics;Noise;Intrusion detection;Finance;Graph neural networks;Fraud;Noise measurement;Cyberattack;Heterogeneous Graph;Graph Neural Network;Cyber Attack Behavior Detection},
 month = {Aug},
 number = {},
 pages = {118-126},
 title = {Meta-Graph Enhanced Heterogeneous Graph Neural Network for Cyber Attack Behavior Detection},
 volume = {},
 year = {2025}
}
