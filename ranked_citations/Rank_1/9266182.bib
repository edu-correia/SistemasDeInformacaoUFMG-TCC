@inproceedings{9266182,
 abstract = {We present a semantic domain for designing concurrent languages in continuation-passing style (CPS). We offer denotational semantics designed in CPS for languages based on Milner's CCS extended with mechanisms which support multiparty interactions. We establish a collection of properties which can describe the behavior of concurrent systems with multiparty interactions. The semantic investigation is accomplished in the mathematical framework of complete metric spaces.},
 author = {Todoran, Eneia Nicolae},
 booktitle = {2020 IEEE 16th International Conference on Intelligent Computer Communication and Processing (ICCP)},
 doi = {10.1109/ICCP51029.2020.9266182},
 issn = {},
 keyword = {Semantics;Measurement;Extraterrestrial measurements;Concurrent computing;Syntactics;Mathematical model;Algebra;metric spaces;continuations;concurrent languages},
 month = {Sep.},
 number = {},
 pages = {521-528},
 title = {Metric Semantics for Concurrent Languages Designed in Continuation-Passing Style},
 volume = {},
 year = {2020}
}
