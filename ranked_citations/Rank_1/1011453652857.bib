@article{10.1145/3652857,
 abstract = {The proliferation of multimodal big data in cities provides unprecedented opportunities for modeling and forecasting urban problems, such as crime prediction and house price prediction, through data-driven approaches. A fundamental and critical issue in modeling and forecasting urban problems lies in identifying suitable spatial analysis units, also known as city region partition. Existing works rely on subjective domain knowledge for static partitions, which is general and universal for all tasks. In fact, different tasks may need different city region partitions. To address this issue, we propose JLPR, a task-oriented framework for Joint Learning of region Partition and Representation. To make partitions fit tasks, JLPR integrates the region partition into the representation model training and learns region partitions using the supervision signal from the downstream task. We evaluate the framework on two prediction tasks (i.e., crime prediction and housing price prediction) in Chicago. Experiments show that JLPR consistently outperforms state-of-the-art partitioning methods in both tasks, which achieves above 25% and 70% performance improvements in terms of mean absolute error for crime prediction and house price prediction tasks, respectively. Additionally, we meticulously undertake three visualization case studies, which yield profound and illuminating findings from diverse perspectives, demonstrating the remarkable effectiveness and superiority of our approach.},
 address = {New York, NY, USA},
 articleno = {210},
 author = {Deng, Mingyu and Zhang, Wanyi and Zhao, Jie and Wang, Zhu and Zhou, Mingliang and Luo, Jun and Chen, Chao},
 doi = {10.1145/3652857},
 issn = {1551-6857},
 issue_date = {July 2024},
 journal = {ACM Trans. Multimedia Comput. Commun. Appl.},
 keyword = {Region partition, partition learning, representation learning, prediction task, multimodal big data},
 month = {May},
 number = {7},
 numpages = {23},
 publisher = {Association for Computing Machinery},
 title = {A Novel Framework for Joint Learning of City Region Partition and Representation},
 url = {https://doi.org/10.1145/3652857},
 volume = {20},
 year = {2024}
}
