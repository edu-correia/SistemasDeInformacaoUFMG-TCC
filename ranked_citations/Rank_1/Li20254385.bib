 publication_stage = {Final},
 source = {Scopus},
 title = {A Novel Network Based on Dynamic Graph Convolution and Multi-head Attention Mechanism for End-to-End Multimodal Trajectory Prediction},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105020768564?origin=resultslist},
