@article{11085135,
 abstract = {Pulse repetition interval (PRI) is a critical parameter for identifying radar emitters. However, modern agile radar systems often employ complex PRI modulation patterns, posing significant challenges for accurate recognition. Existing methods may fail to maintain robust performance in nonideal electronic environments with high ratios of pulse loss and spurious pulses. Since different PRI modulation types have special periodicity of time sequences, this article proposes a domain-adapted radar PRI modulation recognition framework via Gramian angular summation field (GASF) and Gramian angular difference field (GADF) encoding. The combination of harmonic elimination and Polar coordinate mapping effectively preserves temporal correlations and structural patterns during PRI sequence transformation. Then, a dual-branch feature extraction and fusion strategy is designed based on the complementary characteristics of GASF and GADF encodings. Through midlevel feature merging, the intermediate fusion architecture could well fit into practical variable-length PRI sequences and effectively learns discriminate features. Finally, extensive experiments demonstrate that the proposed method achieves satisfying recognition accuracy and maintains stable performance even under extreme nonideal conditions. Particularly, the recognition accuracy achieves over 96% under a 50% pulse loss ratio. Tests on real-measured data further evaluate the method’s effectiveness in real-world radar signal scenarios.},
 author = {Tang, Shuting and Zhang, Zhaolin and Tao, Mingliang and Xie, Jian and Liu, Xiangyang and Wang, Ling},
 doi = {10.1109/TAES.2025.3590684},
 issn = {1557-9603},
 journal = {IEEE Transactions on Aerospace and Electronic Systems},
 keyword = {Modulation;Radar;Feature extraction;Encoding;Accuracy;Jitter;Radar antennas;Switches;Radar detection;Harmonic analysis;Gramian angular field (GAF);loss and spurious pulse;nonideal observations;pulse repetition interval (PRI) modulation recognition;radar emitter},
 month = {Dec},
 number = {6},
 pages = {15673-15689},
 title = {Radar PRI Modulation Recognition Under Nonideal Observations via Joint Encoding of Gramian Angular Field},
 volume = {61},
 year = {2025}
}
