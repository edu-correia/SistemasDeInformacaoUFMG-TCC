@article{Wang2018,
 abstract = {We proposed a new crash surrogate metric, i.e., the maximum disturbance that a car following scenario can accommodate, to represent potential crash risks with a simple closed form. The metric is developed in consideration of traffic flow dynamics. Then, we compared its performance in predicting the rear-end crash risks for motorway on-ramps with other two surrogate measures (time to collision and aggregated crash index). To this end, a one-lane on-ramp of Pacific Motorway, Australia, was selected for this case study. Due to the lack of crash data on the study site, historical crash counts were merged according to levels of service (LOS) and then converted into crash rates. In this study, we used the societal risk index to represent the crash surrogate indicators and built relationships with crash rates. The final results show that (1) the proposed metric and aggregated crash index are superior to the time to collision in predicting the rear-end crash risks for on-ramps; (2) they have a relatively similar performance, but due to the simple calculation, the proposed metric is more applicable to some real-world cases compared with the aggregated crash index. © 2018 Xu Wang and Kai Liu.},
 author = {Wang, Xu and Liu, Kai},
 doi = {10.1155/2018/9349418},
 journal = {Journal of Advanced Transportation},
 note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A crash surrogate metric considering traffic flow dynamics in a motorway corridor},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85049811295?origin=resultslist},
 volume = {2018},
 year = {2018}
}
