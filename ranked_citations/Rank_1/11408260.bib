@article{11408260,
 abstract = {Surface water detection using global navigation satellite system reflectometry (GNSS-R) has received growing research interest. There is a consensus that the resolution of cyclone global navigation satellite system (CYGNSS) is about 500 m in the inland water regions, but the along-track resolution is downsampled to 3.5 km due to the 2 Hz incoherent integration of delay-Doppler map (DDM). This study presents the first attempt to reconstruct CYGNSS-based inland water maps at 500 m resolution using only DDM data. Multitrack CYGNSS observations are first merged on a 500 m grid with a physics-constrained interpolation (PCI) algorithm, and water/land classification is then performed with a three-parameter exponential threshold (3-PET) model. When evaluated against the global surface water (GSW) dataset, the resulting 500 m retrieval reaches an overall accuracy (OA) of 0.958 and shows negligible loss relative to a 1 km PCI benchmark, with a slightly higher  $F1$  score (0.563 versus 0.548). Compared with the Berkeley-RWAWC product, it attains a higher  $F1$  (0.563 versus 0.434) while substantially reducing the false-alarm rate (0.424 versus 0.666). The framework requires no auxiliary data, highlighting the potential of simple, DDM-only GNSS-R retrievals for high-resolution inland water mapping.},
 author = {Yin, Chongxi and Liu, Baojian},
 doi = {10.1109/TGRS.2026.3667400},
 issn = {1558-0644},
 journal = {IEEE Transactions on Geoscience and Remote Sensing},
 keyword = {Scattering;Vegetation mapping;Spatial resolution;Sea surface;Rivers;Wetlands;Lakes;Reflectivity;Interpolation;Heuristic algorithms;Cyclone Global Navigation Satellite System (CYGNSS);global navigation satellite system reflectometry (GNSS-R);surface water mapping},
 month = {},
 number = {},
 pages = {1-12},
 title = {Reconstruction of 500-m Resolution CYGNSS Water Map Using Physics-Constrained Interpolation and Three-Parameter Exponential Threshold Algorithm},
 volume = {64},
 year = {2026}
}
