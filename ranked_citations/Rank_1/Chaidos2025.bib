@conference{Chaidos2025,
 abstract = {The prevalence of Artificial Intelligence (AI) applications has been undisputed in most fields of modern computing. As the paradigm shifts from high-performance Cloud computing infrastructure to decentralized smart Edge devices that offer higher reliability and lower latency, with no need for high-speed connectivity, more effort has been required to address resource and energy concerns. In this paper, we present the advancements of the HORIZON EU CONVOLVE project and focus on the development of flexible accelerators targeting several types of modern Edge AI applications. We outline the architectural decisions for the CONVOLVE SoC and highlight the various techniques employed in 4 of our developed accelerators. These steps mark a significant step toward enabling Ultra-Low Power (ULP) AI processing at the edge. Finally, we present quantitative hardware results and discuss the design trade-offs and performance characteristics of the proposed micro-architectures.  © 2025 IEEE.},
 author = {Chaidos, Panagiotis and Maras, Alexios and Alexandris, Georgios and Xiaoling and Arrassi, Asmae El and Ahn, Bas and Garside, James D. and Deng, Yunhao and Spyrou, Theofilos and Gebregiorgis, Anteneh and Taouil, Mottaqiallah and Gomony, Manil Dev and Xydis, Sotirios and Verhelst, Marian and Hamdioui, Said and Soudris, Dimitrios and Corporaal, Henk},
 doi = {10.1109/ISVLSI65124.2025.11130251},
 journal = {Proceedings of IEEE Computer Society Annual Symposium on VLSI, ISVLSI},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Flexible Hardware Accelerators for Ultra-Low Power Edge AI: The CONVOLVE Approach},
 type = {Conference paper},
