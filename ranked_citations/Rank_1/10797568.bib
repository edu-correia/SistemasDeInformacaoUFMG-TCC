@inproceedings{10797568,
 abstract = {Electric vehicles (EVs) are pivotal in the transition to sustainable urban mobility, yet their large-scale integration into existing grid infrastructures presents significant challenges. There is great potential for transportation electrification to address the issue of environmental pollution worldwide, plug-in electric vehicles (PEVs) have not yet gained much traction in the market. This poor adoption rate is mostly due to consumer worries about the scarcity of charging stations, the excessively long waiting time for charging, battery depletion anxiety and its hazards. In addition to residential load, the high rise in EV charging will increase the peak load demand and may have adverse effect on the electrical grid. Our motivation for the research was to resolve these problems through a well-planned charge method. This paper the charging behaviour and travel patterns of electric vehicles are analyzed to investigate the scheduling component of the EV charging challenges. The algorithm for scheduling Early Start Time (EST) and Early Finish Time (EFT) for optimal charging is introduced to address the charging issue which is compared with FCFS and NA algorithm.},
 author = {Yadav, Maneesh and Jena, Satyaranjan and Panigrahi, Chinmoy Kumar and Naik, Amiya Kumar},
 booktitle = {2024 3rd Odisha International Conference on Electrical Power Engineering, Communication and Computing Technology (ODICON)},
 doi = {10.1109/ODICON62106.2024.10797568},
 issn = {},
 keyword = {Plug-in electric vehicles;Pollution;Machine learning algorithms;Scheduling algorithms;Merging;Transportation;Machine learning;Charging stations;Electric vehicle charging;Scheduling;Electric Vehicles;Grid Integration;Fleet Management;Optimal Scheduling Algorithms;Charging Strategies;Energy management;Sustainability;Traveling Patterns},
 month = {Nov},
 number = {},
 pages = {1-5},
 title = {Comparative Analysis of Optimal EV Charging Strategies for Fleet Management, Based on Customer Perspective},
