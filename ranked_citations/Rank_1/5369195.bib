@inproceedings{5369195,
 abstract = {The paper selects listed companies which were merged or acquired in 2005 as the empirical samples, chooses 24 specific indexes related to financial condition and governance structure of firms. Then the logistic regression analysis is used to establish one forecast model with 73.6 percent general accuracy basing on success rate and another with 75.3 percent general accuracy basing on M&A performance. The study shows that the company with good governance structure, favorable government efficiency, but mired in short-term operation difficulties is apt to become M&A target; furthermore, the operation revenue growth ability of target firm before M&A has positive effect on M&A performance.},
 author = {Yang, Cai and Haifeng, Ma},
 booktitle = {2009 International Conference on Information Management, Innovation Management and Industrial Engineering},
 doi = {10.1109/ICIII.2009.160},
 issn = {2155-1472},
 keyword = {Predictive models;Companies;Corporate acquisitions;Technology forecasting;Cities and towns;Logistics;Merging;Marketing and sales;Information management;Innovation management;listed company;target firm;success rate;M&A performance;forecast model},
 month = {Dec},
 number = {},
 pages = {10-13},
 title = {On M&A Forecast Model of Target Firms Basing on Chinese Listed Companies},
 volume = {2},
 year = {2009}
}
