@conference{Lungu2025124,
 abstract = {The view of contemporary cybersecurity threats is dynamic, with training needs constantly changing. Traditionally, cybersecurity training participants have shown low concentration levels and poor retention of the material presented. Gamification methods represent a new and potentially practical approach to dealing with these combined challenges by introducing game-like elements into education. This paper provides a gamified adaptive architecture that modifies the training content based on user performance and learning behaviour. The system designed will merge machine learning algorithms with gamification mechanics that are individualised to engage users optimally and facilitate knowledge acquisition. A six-month experimental study with 240 participants in three different organisational settings confirmed the efficacy of the system. Results indicate significant improvements in user engagement metrics, thereby increasing completion rates by 73% compared to traditional approaches to training. Knowledge retention tests indicated sustained improvement after three months post-training, at 68%. Security awareness behaviours showed measurable improvement: incident reporting increased by 45%, and policy compliance increased by 52%. While meeting individual cognitive preferences and organisational security needs was a personalised learning experience, one had an adaptive framework, and engagement metrics were kept high. © 2025 IEEE.},
 author = {Lungu, Nelson and Dash, Bibhuti Bhusan and De, Utpal Chandra and Rout, Suchismita and Sardar, Tanvir Habib and Patra, Sudhansu Shekhar},
 doi = {10.1109/ICSCSA66339.2025.11171227},
 journal = {Proceedings of 5th International Conference on Soft Computing for Security Applications, ICSCSA 2025},
 note = {Cited by: 0},
 pages = {124 - 129},
 publication_stage = {Final},
 source = {Scopus},
 title = {Adaptive Gamified Cybersecurity Training for Enhanced User Engagement},
