@article{Molnár2016135,
 abstract = {A case study is described about a “Knowledge Warehouse” that stored originally a vast amount of texts about laws and other legal rules in spreadsheetlike structure; it permitted a full-text search to support public officers to give helping hand in various Life Events of citizens. The requirements for efficiency and effectiveness enforced a redesign and re-planning of the whole system. A preliminary conceptual design and a proof of concept prototype are developed that exploits the most recent database technologies with combination of ontologies and Description Logic. © Springer International Publishing Switzerland 2016.},
 author = {Molnár, Bálint and Béleczki, András and Benczúr, András},
 doi = {10.1007/978-3-319-44159-7_10},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 5; All Open Access; Hybrid Gold Open Access},
 pages = {135 - 149},
 publication_stage = {Final},
 source = {Scopus},
 title = {Application of legal ontologies based approaches for procedural side of public administration: A case study in Hungary},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84981489582?origin=resultslist},
 volume = {9831 LNCS},
 year = {2016}
}
