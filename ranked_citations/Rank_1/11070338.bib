@inproceedings{11070338,
 abstract = {The evolving landscape of digital education, there is a growing demand for intelligent systems that is adapt to complex content. This paper introduces a neural network-based platform for intelligent sharing of ideological and political teaching resources in academic courses. The framework combines BERT for text analysis, 3D-CNN for visual processing, and DNN for user profiling, integrated via a cross-modal attention mechanism. Results show exceptional performance (97.4% accuracy, 97.1% precision, 97.8% recall), surpassing text-only (88.2%), visual-only (85.7%), and fusion approaches (93.6%). The system dynamically weights multimodal features while ensuring explainability through attention visualization and SHAP analysis. Implemented with TensorFlow/Keras on GPU-accelerated hardware, it efficiently processes diverse materials including videos, articles, and presentations. Key innovations include adaptive political discourse analysis and robust handling of sparse user data, while maintaining 97.0% specificity for balanced perspective representation. The platform advances AI-assisted political education by merging neural networks with explainable AI, providing educators with an intelligent tool for curriculum development in dynamic socio-political environments.},
 author = {Zhang, Yujia},
 booktitle = {2025 3rd International Conference on Data Science and Information System (ICDSIS)},
 doi = {10.1109/ICDSIS65355.2025.11070338},
 issn = {},
 keyword = {Visualization;Technological innovation;Attention mechanisms;Accuracy;Text analysis;Education;Neural networks;Trend analysis;Standards;Videos;attention mechanism;cross-modal learning;deep learning;neural networks;political education;resource recommendation},
 month = {May},
 number = {},
 pages = {1-8},
 title = {Cross-Modal Neural Architecture Integrating BERT, 3D-CNN and DNN for Personalized Recommendation of Ideological and Political Educational Resources},
 volume = {},
