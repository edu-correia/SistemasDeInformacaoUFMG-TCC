@inproceedings{5360944,
 abstract = {Multiple pattern matching algorithms are essential engines of network intrusion detection systems (NIDSs) to inspect packets for occurrences of malicious patterns. For a set of patterns, the multiple pattern matching algorithms usually build a trie data structure. In this paper, we propose efficient implementations of the multiple pattern matching algorithms widely used in NIDSs by using a linearized compact trie. This linearized compact trie is an array representation of a compact trie and guarantees a size linear to the number of patterns with little loss of lookup time. Thus, our implementations achieve compact sizes with fast time, so it is useful to hardware embedding and cache exploiting.},
 author = {Lee, Sunho and Kim, Dong Kyue},
 booktitle = {2009 IEEE International Conference on Network Infrastructure and Digital Content},
 doi = {10.1109/ICNIDC.2009.5360944},
 issn = {2374-0272},
 keyword = {Pattern matching;Intrusion detection;Engines;Data structures;Hardware;Hydrogen;Embedded software;Adaptive arrays;Telephony;Merging;trie;multiple pattern matching;Aho-Corasick;Wu-Manber;network intrusion detection},
 month = {Nov},
 number = {},
 pages = {609-613},
 title = {Efficient multiple pattern matching algorithms for Network Intrusion Detection Systems},
 volume = {},
 year = {2009}
}
