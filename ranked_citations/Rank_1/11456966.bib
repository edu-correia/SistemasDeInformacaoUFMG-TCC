@article{11456966,
 abstract = {Compiler optimization may introduce information leakage (IL) in a program. This opens up the scope of side-channel attacks through which secret inputs, such as keys, may leak via intermediate variables in cryptographic applications. Taint analysis is a well-known approach that tracks the information flow in a program. However, it has the problem of either under-tainting, leading to false negatives, or over-tainting, leading to false positive scenarios. In this work, we overcome these problems by tracking the information flow in a C program using a bounded model checker. Conceptually, we create a miter program of the input program and add assertions to verify the security property related to information flow using a model checker. In our experiment, we run the proposed approach for various cryptographic applications and show that it can successfully track the IL. Our experiments reveal that LLVM actually introduces IL during optimizations.},
 author = {Panigrahi, Priyanka and Karfa, Chandan},
 doi = {10.1109/LES.2026.3677498},
 issn = {1943-0671},
 journal = {IEEE Embedded Systems Letters},
 keyword = {Optimization;Model checking;Information leakage;Benchmark testing;Codes;Side-channel attacks;Translation;Semantics;Observers;Merging;Security;information flow;model checking;CBMC},
 month = {},
 number = {},
 pages = {1-1},
 title = {MQIL: Model Checking based Quantification of Information Leakage},
 volume = {},
 year = {2026}
}
