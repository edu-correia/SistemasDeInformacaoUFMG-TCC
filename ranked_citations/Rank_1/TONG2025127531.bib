@article{TONG2025127531,
 abstract = {The growing dependence on fossil fuels for electricity generation has raised serious environmental concerns and marked the urgent requirement for sustainable alternatives. This assessment evaluates a novel solar-driven trigeneration structure that simultaneously generates electricity, cooling, and freshwater by combining a parabolic trough solar collector with thermal energy storage. The studied configuration merges a modified supercritical carbon dioxide Brayton cycle with a secondary organic Rankine cycle for excess power recovery, a dual-stage organic Rankine cycle integrated with a vapor compression refrigeration unit, and a multi-effect desalination subsystem supported by thermal vapor compression. Thermodynamic, economic, and environmental impact assessments are performed, comprising baseline evaluation, parametric investigations, and multi-objective optimization utilizing a particle swarm optimization algorithm. The outputs depict net outputs of 51.47 MW of electricity, 7.57 MW of cooling, and 22.17 kg/s of freshwater, with an environmental impact of 561.33 Pts/h and a payback period of 4.21 years for an investment of 128.6 $M. Optimization scenarios outline enhancements in efficiency, economic returns, and environmental performance. The main contribution of this assessment lies in the cascade integration of multiple subsystems by the use of zeotropic working fluids to investigate thermal matching and system operation, combined with a comprehensive multi-criteria assessment. This approach advances current studies by bringing out an integrated framework with improved energy recovery, environmental impact decrement, and economic viability.},
 author = {Naiwen Tong},
 doi = {https://doi.org/10.1016/j.applthermaleng.2025.127531},
 issn = {1359-4311},
 journal = {Applied Thermal Engineering},
 keyword = {Parabolic trough solar collector, Modified supercritical carbon dioxide cycle, Multi-effect desalination, Exergoenvironmental analysis, Multi-criteria optimization},
 pages = {127531},
 title = {Thermoeconomic and environmental assessment of a solar-based trigeneration unit},
 url = {https://www.sciencedirect.com/science/article/pii/S1359431125021234},
 volume = {279},
 year = {2025}
}
