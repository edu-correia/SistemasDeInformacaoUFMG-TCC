@conference{Kim2023298,
 abstract = {The size of the data is growing exponentially. Accordingly, the size of the temporary files also increases proportionally. Temporary files have different characteristics from regular files. They are used temporarily and then become obsolete within a short time. However, most SSDs do not consider this characteristic of temporary files. This paper proposes a new FTL architecture considering the features of temporary files: Dealloc FTL. As a result of comparing the transient file processing performance through the experiment, it showed a performance improvement of about 2 to 8 times compared to the original FTL. © 2023 IEEE.},
 author = {Kim, Joontae and Lee, Sangwon},
 doi = {10.1109/BigComp57234.2023.00059},
 journal = {Proceedings - 2023 IEEE International Conference on Big Data and Smart Computing, BigComp 2023},
 note = {Cited by: 0},
 pages = {298 - 303},
 publication_stage = {Final},
 source = {Scopus},
 title = {Dealloc FTL: Efficiently Managing Temporary Files on SSDs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85151561880?origin=resultslist},
 year = {2023}
}
