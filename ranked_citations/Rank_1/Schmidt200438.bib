@article{Schmidt200438,
 abstract = {The approach presented in this overview paper exploits that modal logics can be seen to be fragments of first-order logic and deductive methods can be developed and studied within the framework of first-order resolution. We focus on a class of extended modal logics very similar in spirit to propositional dynamic logic and closely related to description logics. We review and discuss the development of decision procedures for decidable extended modal logics and look at methods for automatically generating models. © Springer-Verlag Berlin Heidelberg 2003.},
 author = {Schmidt, Renate A. and Hustadt, Ullrich},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 11},
 pages = {38 - 67},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mechanised reasoning and model generation for extended modal logics},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/35248884485?origin=resultslist},
 volume = {2929},
 year = {2004}
}
