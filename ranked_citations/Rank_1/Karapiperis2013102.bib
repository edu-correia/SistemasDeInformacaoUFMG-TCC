@conference{Karapiperis2013102,
 abstract = {Privacy Preserving Record Linkage (PPRL) is the scientific field that explores methods of linking datasets in order to identify common entities efficiently and accurately by simultaneously preserving the privacy of the underlying data. In this paper we present a distributed Locality Sensitive Hashing-based framework for linking huge collections of records, by grouping similar records efficiently and by distributing computations among underutilized commodity hardware resources uniformly, without imposing an extra overhead on the existing infrastructure, thus promoting scalability. We also propose two methods of assessing computational cost, aiming to distribute workload evenly among compute nodes. Copyright 2013 ACM.},
 author = {Karapiperis, Dimitrios and Verykios, Vassilios S.},
 doi = {10.1145/2490257.2490258},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 12},
 pages = {102 - 109},
 publication_stage = {Final},
 source = {Scopus},
 title = {A distributed framework for scaling up LSH-based computations in privacy preserving record linkage},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84890482830?origin=resultslist},
 year = {2013}
}
