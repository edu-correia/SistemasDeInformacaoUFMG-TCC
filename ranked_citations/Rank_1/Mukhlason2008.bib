@conference{Mukhlason2008,
 abstract = {Manual ontology construction has proven to be very difficult task and is becoming a problem in the process of acquiring knowledge for ontology engineer. This article presents a semi-automatic ontological knowledge base construction framework and several aspects of evaluating the semi-automatic ontology generation tool in eLearning Management System setting. The framework combined an ontology learning tool called Text2Onto to construct ontology from scratch and an ontology mapping tool called PROMPT to map the ontology the existing ontology. Experiment on generating ontology from text corpus shows a significant result for knowledge concept extraction. © 2008 IEEE.},
 author = {Mukhlason, Ahmad and Mahmood, Ahmad Kamil and Arshad, Noreen Izza},
 doi = {10.1109/ITSIM.2008.4631664},
 journal = {Proceedings - International Symposium on Information Technology 2008, ITSim},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semi automatic ontological knowledge base construction from learning materials in eLearning Management System},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/57349095558?origin=resultslist},
 volume = {2},
 year = {2008}
}
