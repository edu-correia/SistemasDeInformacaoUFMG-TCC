@article{Zhou2018406,
 abstract = {Data processing framework is at the core of cloud computing. Firstly, to further specify the execution flow of data processing framework in cloud environments, this paper proposes SDAC (semantic distributed abstract configuration), a formal model introduced from the view of model definition and execution semantics. Then, to demonstrate the reasonability, the paper compares the proposed approach with the Aeolus model since they both concern configurations in cloud environments. And to evaluate the model, a MapReduce case and some applications of SDAC (i.e. the interpretation of fault tolerance and performance optimization) are presented. Finally, the future work about using SDAC to analyse other mechanisms in cloud are discussed. © 2018 Elsevier Ltd},
 author = {Zhou, Wenbo and Liu, Lei and Zhang, Peng and Lü, Shuai and Li, Jingyao},
 doi = {10.1016/j.cl.2018.07.005},
 journal = {Computer Languages, Systems and Structures},
 note = {Cited by: 2},
 pages = {406 - 426},
 publication_stage = {Final},
 source = {Scopus},
 title = {SDAC: A model for analysis of the execution semantics of data processing framework in cloud},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85053434743?origin=resultslist},
 volume = {54},
 year = {2018}
}
