@article{CHENG2025131072,
 abstract = {This study investigates the nonlinear dynamics of mixed traffic flow near the entrance zones of dedicated connected and autonomous vehicle (CAV) lanes under variable speed limit (VSL) control. An extended macroscopic model based on the classical METANET framework is developed, incorporating the effects of dynamic speed regulation, asymmetric upstream-downstream interactions, reaction time perturbations due to sequential lane-changing maneuvers, and disturbances from ramp merging flows. A multi-objective optimization approach, integrating traffic efficiency and safety considerations, is proposed to determine the optimal VSL strategies. Numerical simulations using a microscopic traffic platform validate the model, demonstrating that the proposed VSL control effectively mitigates spatiotemporal instabilities, reduces speed variance, shortens convergence times, and suppresses lane-changing conflicts. The results reveal that traffic flow evolution in the CAV entrance zones exhibits complex nonlinear behavior analogous to nonequilibrium dissipative systems, providing new insights into macroscopic traffic control under heterogeneous driving environments.},
 author = {Guozhu Cheng and Song Wang and Liang Xu and Yuzheng Guo and Qing Wang},
 doi = {https://doi.org/10.1016/j.physleta.2025.131072},
 issn = {0375-9601},
 journal = {Physics Letters A},
 keyword = {Nonlinear traffic dynamics, Mixed traffic flow, Variable speed limit control, Macroscopic modeling, Nonequilibrium systems},
 pages = {131072},
 title = {Nonlinear dynamics of mixed traffic flow under variable speed limit control at CAV dedicated lane entrances: A macroscopic modeling approach},
 url = {https://www.sciencedirect.com/science/article/pii/S0375960125008527},
 volume = {563},
 year = {2025}
}
