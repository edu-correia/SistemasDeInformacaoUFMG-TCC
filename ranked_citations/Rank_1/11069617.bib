@inproceedings{11069617,
 abstract = {To enhance the stability of the cluster structure and extend its lifetime, a stable neighbor-based clustering algorithm (SNB-CA) is proposed. The algorithm, which is based on the concept of “stable neighbors,” takes into account the mobility, connectivity, and distribution of surrounding stable neighbor nodes. It selects the vehicle with the minimum cluster lifetime (CL) value as the cluster head, thereby forming a stable cluster structure. Additionally, the algorithm defines an upper limit for cluster size, establishes strict conditions for cluster formation and joining, and applies relaxed criteria for cluster dissolution and node departure. This approach helps avoid frequent restructuring of the cluster, thereby increasing its stability and longevity. Furthermore, an adaptive beacon mechanism is incorporated, allowing vehicles to adjust their beacon intervals based on node status and the cluster head's speed range. This ensures accurate message transmission while reducing beacon overhead. Simulation results demonstrate that the proposed clustering algorithm successfully maintains a stable cluster structure and significantly reduces clustering overhead in both highway and urban environments.},
 author = {Wang, Yong and Li, Meng and Mu, Xiaotong},
 booktitle = {2025 10th International Conference on Computer and Communication System (ICCCS)},
 doi = {10.1109/ICCCS65393.2025.11069617},
 issn = {2995-3251},
 keyword = {Road transportation;Accuracy;Communication systems;Simulation;Stability criteria;Urban areas;Clustering algorithms;Vehicular ad hoc networks;Maintenance;vehicular ad hoc networks (VANETs);stability;mobile;clustering algorithm},
 month = {April},
 number = {},
 pages = {1031-1037},
 title = {A Stable Neighbor-Based Clustering Algorithm for Vehicular Ad Hoc Networks},
 volume = {},
 year = {2025}
}
