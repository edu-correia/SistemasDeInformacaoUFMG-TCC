@inproceedings{10665017,
 abstract = {To improve the vehicle active suspension performance under varying road and operational conditions, a T-S fuzzy merged optimal control strategy is introduced, which effectively balances the control objectives related to anti-rollover capability and ride comfort performance. Moreover, the integration of Bayesian theory facilitates the construction of fuzzy membership functions and enables rollover emergency prediction. The control objective can be flexibly switched between roll stability and ride comfort based on the Bayesian network technology for calculating rollover probability, in accordance with different operational requirements. The control method is validated through double lane change test, fishhook test, and ride comfort test. It is demonstrated that the roll angle can be explicitly reduced under both stability degree and harshness degree conditions, outperforming passive suspension. Moreover, the control objective effectively translates into enhanced ride comfort performance when rollover risk is minimized.},
 author = {Qingshuo, He and Yang, Li and Sha, Yi and Zhuopei, Liu and Xing, Zhang and Chenyu, Zhou},
 booktitle = {2024 IEEE 19th Conference on Industrial Electronics and Applications (ICIEA)},
 doi = {10.1109/ICIEA61579.2024.10665017},
 issn = {2158-2297},
 keyword = {Industrial electronics;Suspensions (mechanical systems);Rollover;Roads;Simulation;Optimal control;Switches;automobile;active suspension control;Bayesian network;rollover avoidance;T-S fuzzy method},
 month = {Aug},
 number = {},
 pages = {1-6},
 title = {Research on Anti-Rollover Intelligent Suspension Control Based on Dynamic Bayesian Network},
 volume = {},
 year = {2024}
}
