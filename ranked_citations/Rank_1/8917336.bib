@inproceedings{8917336,
 abstract = {Capacity drop at congested freeway bottlenecks is well known with a lot of field observations and accounts for severe performance degradation of road infrastructure. This paper addresses freeway ramp metering and mainstream traffic flow control (MTFC) at active bottlenecks, with an aim of avoiding capacity drop. A special attention was paid to the effects of capacity drop on the performance of control measures. Via mathematical analyses, it was first shown that the significance and usefulness of the control measures are justified by the presence of capacity drop in field. This was then verified via macroscopic simulation studies, with ramp metering, MTFC, and their integration formulated in a framework of coordinated and integrated optimal control. It was also demonstrated that an appropriate usage of the control measures can effectively prevent the activation of potential bottlenecks on freeways and hence avoid capacity drop there.},
 author = {Yu, Xianghua and Zhang, Siyu and Wang, Yibing},
 booktitle = {2019 IEEE Intelligent Transportation Systems Conference (ITSC)},
 doi = {10.1109/ITSC.2019.8917336},
 issn = {},
 keyword = {Traffic control;Optimal control;Merging;Analytical models;Trajectory;Numerical models;Intelligent transportation systems},
 month = {Oct},
 number = {},
 pages = {1761-1767},
 title = {Preventing Freeway Capacity Drop via MTFC and Ramp Metering},
 volume = {},
 year = {2019}
}
