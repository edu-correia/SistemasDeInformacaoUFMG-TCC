@inproceedings{9370413,
 abstract = {Dual-band operation for terahertz (THz) wireless systems to merge multiple systems into a single one is a challenging problem. We propose a dual-band THz polarization converter using metasurfaces in transmission modes. It is singly layered which makes it a very simple structure. Dual-band conversion from linear wave to circular wave is reported over 20% of centre frequencies (1.6-1.97 THz, 3.35-4.16 THz) which is very broadband. Idea is verified by simulation and experiment.},
 author = {Fahad, Ayesha Kosar and Ruan, Cunjun and Ul Haq, Tanveer and Ullah, Shahid},
 booktitle = {2020 45th International Conference on Infrared, Millimeter, and Terahertz Waves (IRMMW-THz)},
 doi = {10.1109/IRMMW-THz46771.2020.9370413},
 issn = {2162-2035},
 keyword = {Wireless communication;Dual band;Metasurfaces;Frequency conversion;Broadband communication;Periodic structures},
 month = {Nov},
 number = {},
 pages = {1-1},
 title = {Dual-Band Conversion Between Polarization States Based on Metasurface with Broadband Performance},
 volume = {},
 year = {2020}
}
