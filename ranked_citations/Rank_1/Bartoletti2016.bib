@article{Bartoletti2016,
 abstract = {We propose a type system for a calculus of contracting processes. Processes can establish sessions by stipulating contracts, and then can interact either by keeping the promises made, or not. Type safety guarantees that a typeable process is honest — that is, it abides by the contracts it has stipulated in all possible contexts, even in presence of dishonest adversaries. Type inference is decidable, and it allows to safely approximate the honesty of processes using either synchronous or asynchronous communication. © M. Bartoletti, A. Scalas, E. Tuosto, and R. Zunino.},
 author = {Bartoletti, Massimo and Scalas, Alceste and Tuosto, Emilio and Zunino, Roberto},
 doi = {10.2168/LMCS-12(4:7)2016},
 journal = {Logical Methods in Computer Science },
 note = {Cited by: 12; All Open Access; Gold Open Access; Green Open Access},
 number = {4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Honesty by typing},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85015904524?origin=resultslist},
 volume = {12},
 year = {2016}
}
