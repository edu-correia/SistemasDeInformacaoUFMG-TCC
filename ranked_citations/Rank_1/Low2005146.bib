@conference{Low2005146,
 abstract = {In this paper the solution to synthesising unseen context triphone speech units in concatenative text to speech (TTS) synthesisers is described. The first part of the paper discusses the unit selection method for selecting the (best' speech units to populate the inventory. The selection method is structured to minimise the possibility of unseen context triphone speech units. Inferences drawn from the distributions of the speech spectrum, fundamental frequency, duration and power are used during inventory population. Subsequently, a two-step process was presented to solve the problem of unseen context triphone speech units. Units with the required context are first selected using a decision-tree based linguistic clustering method. These selected (template' units are then pitch and time normalised using TD-PSOLA. An overlap and merge process is subsequently performed on the normalised speech units. The unseen context synthesis method presented could also be used for other (i.e. word) sized context dependent units.},
 author = {Low, Phuay Hui and Vaseghi, Saeed},
 journal = {2nd International Conference on Cybernetics and Information Technologies, Systems and Applications, CITSA 2005, 11th International Conference on Information Systems Analysis and Synthesis, ISAS 2005},
 note = {Cited by: 0},
 pages = {146 - 151},
 publication_stage = {Final},
 source = {Scopus},
 title = {Synthesising unseen context units using triphones in concatenative text to speech synthesisers},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84907062415?origin=resultslist},
 volume = {1},
 year = {2005}
}
