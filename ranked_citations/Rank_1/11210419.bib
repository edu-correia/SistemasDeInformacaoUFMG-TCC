@inproceedings{11210419,
 abstract = {This research presents a novel stress detection dataset that merges real-world physiological data from hospital nurses with synthetically generated stress events, resulting in a well-balanced distribution of low, moderate, and high stress states. The dataset is designed to support machine learning applications in continuous stress monitoring and includes comprehensive features such as electrodermal activity (EDA), heart rate (HR), body temperature, and orientation signals. Publicly released via GitHub, the dataset is intended to serve as a standard reference for future research on wearable-based mental health detection. In addition, this study introduces a multi-stage ensemble framework that integrates six specialized models: ROCKET transformation, Temporal Convolutional Network (TCN), NGBoost, GCForest, and a Passive-Aggressive meta-classifier. The ensemble pipeline operates in a structured flow to capture temporal, probabilistic, and ensemble-driven patterns from physiological data. Evaluation results indicate that the proposed model significantly outperforms standalone machine learning and deep learning approaches, achieving 90% accuracy, $93.5 \%$ precision, $91.8 \%$ recall, and $92.7 \%$ F1-score. In summary, this work contributes both a publicly accessible hybrid dataset and a powerful ensemble model capable of accurate realtime stress detection from wearable sensors, with direct applications in occupational health and remote physiological monitoring.},
 author = {Singh, Kamna and Bura, Deepa},
 booktitle = {2025 International Conference on Smart & Sustainable Technology (INCSST)},
 doi = {10.1109/INCSST64791.2025.11210419},
 issn = {},
 keyword = {Heart rate;Rockets;Accuracy;Hospitals;Human factors;Probabilistic logic;Biomedical monitoring;Wearable sensors;Stress;Monitoring;stress detection;wearable sensor data;hybrid dataset;machine learning;ensemble model;ROCKET;TCN;NGBoost;GCForest;passive-aggressive classifier},
 month = {July},
 number = {},
 pages = {1-10},
 title = {A Novel Wearable Sensor Dataset and Structured Ensemble Framework for Stress Detection in Healthcare Environment},
