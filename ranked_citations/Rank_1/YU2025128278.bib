@article{YU2025128278,
 abstract = {Deep learning, as a well-established technology, has been extensively applicated in the field of fusing low-resolution hyperspectral image (LR-HSI) with high-resolution multispectral image (HR-MSI). However, the existing fusion methods have cross-modal information interaction insufficient problem. Herein, we introduce a novel Transformer gate-based interactive U-Net (TGIU-Net), tailored for the fusion of HSI and MSI within an advanced deep network framework. TGIU-Net introduces the stackable cross-modality feature extraction module (CMFEM) to extract the feature of the data. Within CMFEM, we achieve sufficient cross-modal information interaction through the innovative cross-modality merging Transformer gate (CMMTG), which integrates merge Transformer and a gating mechanism. To alleviate computational burden of the Transformer, we strategically position the information interaction within the bottleneck layer of the U-Net structure in CMFEM. To validate the efficacy of our proposed TGIU-Net, we conduct extensive comparative experiments across five diverse datasets, demonstrating the superiority of our approach in generating hyperspectral images with excellent spatial clarity and spectral fidelity.},
 author = {Kai Yu and Yihao Fu and Lu Liu and Jun Wang and Jinye Peng},
 doi = {https://doi.org/10.1016/j.eswa.2025.128278},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Hyperspectral image, Multispectral image, Image fusion, Information interaction, Transformer},
 pages = {128278},
 title = {Transformer gate-based interactive U-Net for hyperspectral and multispectral image fusion},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417425018974},
 volume = {289},
 year = {2025}
}
