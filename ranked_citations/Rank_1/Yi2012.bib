 publication_stage = {Final},
 source = {Scopus},
 title = {Dynamic indexability and the optimality of b-trees},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84878574855?origin=resultslist},
 volume = {59},
 year = {2012}
}
