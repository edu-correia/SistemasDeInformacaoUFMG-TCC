@article{Turpin2021,
 abstract = {Zika virus (ZIKV) is an emerging mosquito-borne flavivirus considered as a threat to human health due to large epidemics and serious clinical outcomes such as microcephaly in new-borns. Like all flaviviruses, ZIKV relies on the cellular machinery to complete its viral cycle, with the endo-plasmic reticulum (ER) being the critical site of viral replication factories. The sudden high protein load in the ER induces an ER stress to which the cell responds with an appropriate unfolded protein response (UPR) in an attempt to restore its disturbed homeostasis. When the restoration fails, the cell signalling leads to a programmed cell death by apoptosis with the upregulation of the UPR-induced C/EBP homologous protein (CHOP) which acts as the main trigger for this fatal outcome. Our previous studies have shown the ability of ZIKV to manipulate various cellular responses in order to optimize virus production. ZIKV is able to delay apoptosis to its benefit and although ER stress is induced, the UPR is not complete. Here we discovered that ZIKV impairs the expression of CHOP/DDIT3, the main factor responsible of ER-stress driven apoptosis. Surprisingly, the mechanism does not take place at the transcriptional level but at the translational level. © 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
 author = {Turpin, Jonathan and El-Safadi, Daed and Lebeau, Grégorie and Frumence, Etienne and Desprès, Philippe and Viranaïcken, Wildriss and Krejbich-Trotot, Pascale},
 doi = {10.3390/ijms22073750},
 journal = {International Journal of Molecular Sciences},
 note = {Cited by: 29; All Open Access; Gold Open Access; Green Open Access},
 number = {7},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Chop pro-apoptotic transcriptional program in response to er stress is hacked by zika virus},
 type = {Article},
