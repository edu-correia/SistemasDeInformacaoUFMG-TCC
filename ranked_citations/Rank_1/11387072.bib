@inproceedings{11387072,
 abstract = {In propulsion structures that include battery-operated motors (BOCs) and hybrid-electric transports (HETs), energy storage components-especially electrochemical cells-play pivotal roles. These implementations call for improved powerelectricity ability ratios, compact designs, prolonged durability, and economic viability. A composite garage architecture merging high-electricity-density batteries with rapid-discharge capacitors was devised to cope with batteries’ common power deficiencies, compensated using capacitors’ burst-power abilities. Featuring a parallel configuration with voltage-step-up circuitry for lithiumion cells and bidirectional converters for supercapacitors, this research deploys PI regulators and fuzzy-good judgment manipulate structures inside the hybrid storage network to manipulate electricity necessities and recharge cycles primarily based on rate-stage monitoring. A novel strength distribution technique grounded in the equivalent usage discount technique (ECMS), bolsters the operational backbone. This examine employs proportional-essential and fuzzy-good judgment-based law techniques inside a vehicular strength allocation framework, implemented through MATLAB/Simulink’s virtual simulation platform.},
 author = {Siddula, Sundeep and Jayakrishna, Thatikonda and Bhanutej, J N},
 booktitle = {2025 IEEE 2nd International Conference on Green Industrial Electronics and Sustainable Technologies (GIEST)},
 doi = {10.1109/GIEST66547.2025.11387072},
 issn = {},
 keyword = {Fuzzy logic;PI control;Uncertainty;Supercapacitors;Minimization;Stability analysis;Automobiles;Energy management systems;Vehicle dynamics;Voltage control;Energy Management System (EMS);Hybrid Energy Storage System (HESS);Equivalent Consumption Minimization Strategy (ECMS);Electric Vehicles (EV);Fuzzy logic controller (FLC);Proportional-integral (PI) controller;Fuel Efficiency;State of charge (SoC)},
 month = {Oct},
 number = {},
 pages = {1-7},
 title = {Enhancing EV Efficiency with PI and Fuzzy Logic Control System using Energy Management System},
