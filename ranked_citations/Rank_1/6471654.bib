@inproceedings{6471654,
 abstract = {Due to trade-offs between the VLSI circuit parameters, chip suffers from reliability issues. It needs to be optimizing for better performance. Such problems are defined as NP-hard problems. In this paper a heuristic has been developed using genetic algorithm for solving the floorplan problem. The proposed algorithm is an improved floorplan algorithm, for optimizing simultaneously the trade-off parameters area and zonal peak power density. The initial populations are randomly chosen from a superset of large initial population & genetic algorithm is implemented to obtain the best floorplan solution. Randomized selection is taken to make the selection area flexible. The proposed algorithm has been validated with the ISCAS85 benchmark circuits for 65nm and 90nm.},
 author = {Das, Apangshu and Choudhury, Somnath Roy and Kumar, Balla Kiran and Pradhan, Sambhu Nath},
 booktitle = {2012 7th International Conference on Electrical and Computer Engineering},
 doi = {10.1109/ICECE.2012.6471654},
 issn = {},
 keyword = {Density measurement;Power system measurements;Biological cells;Genetic algorithms;Very large scale integration;Merging;Sociology;Area-power density trade-offs;NP-hard;heuristics;floorplan},
 month = {Dec},
 number = {},
 pages = {729-732},
 title = {An elitist area-power density trade-off in VLSI floorplan using genetic algorithm},
 volume = {},
 year = {2012}
}
