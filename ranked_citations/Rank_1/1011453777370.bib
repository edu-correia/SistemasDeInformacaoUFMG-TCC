 journal = {ACM Trans. Access. Comput.},
 keyword = {Autism, Stress Triggers, Stress Management},
 month = {December},
 number = {4},
 numpages = {34},
 publisher = {Association for Computing Machinery},
 title = {Gathering Requirements for Stress Management in Autistic Adults for the Development of Augmented Reality Self-Interventions},
