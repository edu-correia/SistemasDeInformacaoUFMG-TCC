@article{TALEBI2026217011,
 abstract = {The porous nature and tunable properties of covalent organic frameworks (COFs) have provoked much interest in their capabilities for environmental applications. Merging the high surface area and ordered structure of COFs with easy separability and the eco-friendly nature of the Fe3O4 (magnetite), as well as magnetite orientation, becomes an attractive field for environmental and materials science experts. In this review, we concentrate on the synthesis and characterization of magnetic covalent organic frameworks (MCOFs) and study the underlying principles of their interactions with organic and inorganic environmental contaminants. Exploring the advantages and the drawbacks of the composition routes to prepare the MCOFs, studying the nature of their interactions with the organic and inorganic contaminants, and surveying their recent application in the field are incorporated in this review to give readers a comprehensive view of the environmental applications of the MCOFs. First, the composition of Fe3O4 and COFs materials in decorated and core-shell structures, with the study of the superiority and deficiencies of each structure is presented. To reach a meaningful understanding of the strengths and the weaknesses of the MCOFs as adsorbents, it is imperative to discern the nature of the MCOFs-adsorbate interactions. For that purpose, the most influential interactions between the MCOFs adsorbent and the adsorbates are discussed in detail. Whenever necessary, the analytical tools to characterize the structure of the MCOFs or study their interactions with the analysts are conferred. Finally, a comprehensive survey of the environmental applications of the MCOFs for the remediation of organic and inorganic water contaminants is provided.},
 author = {Seyed Mahdi Talebi and Reza Taghavi and Amirhossein Khoshnevisan and Zahra Farajzadeh and Maryam Nazari-Matin and Mahdi Jafari and Kheibar Dashtian and Xiao Liu and Sadegh Rostamnia},
 doi = {https://doi.org/10.1016/j.ccr.2025.217011},
 issn = {0010-8545},
 journal = {Coordination Chemistry Reviews},
 keyword = {Covalent organic frameworks (COFs), Magnetic nanoparticles, Magnetic solid phase extraction (MSPE), Wastewater treatment, Adsorptive removal, Pollution control},
 pages = {217011},
 title = {Covalent organic frameworks-magnetite (COFs-magnetite) hybrid nanocomposites as sustainable sorbents: Preparation, characterization, and mechanism},
 url = {https://www.sciencedirect.com/science/article/pii/S0010854525005818},
 volume = {546},
 year = {2026}
}
