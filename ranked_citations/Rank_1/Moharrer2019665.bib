@article{Moharrer2019665,
 abstract = {Large-scale optimization problems abound in data mining and machine learning applications, and the computational challenges they pose are often addressed through parallelization. We identify structural properties under which a convex optimization problem can be massively parallelized via map-reduce operations using the Frank–Wolfe (FW) algorithm. The class of problems that can be tackled this way is quite broad and includes experimental design, AdaBoost, and projection to a convex hull. Implementing FW via map-reduce eases parallelization and deployment via commercial distributed computing frameworks. We demonstrate this by implementing FW over Spark, an engine for parallel data processing, and establish that parallelization through map-reduce yields significant performance improvements: We solve problems with 20 million variables using 350 cores in 79 min; the same operation takes 48 h when executed serially. © 2018, Springer-Verlag London Ltd., part of Springer Nature.},
 author = {Moharrer, Armin and Ioannidis, Stratis},
 doi = {10.1007/s10115-018-1294-7},
 journal = {Knowledge and Information Systems},
 note = {Cited by: 0},
 number = {2},
 pages = {665 - 690},
 publication_stage = {Final},
 source = {Scopus},
 title = {Distributing Frank–Wolfe via map-reduce},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85058678130?origin=resultslist},
 volume = {60},
 year = {2019}
}
