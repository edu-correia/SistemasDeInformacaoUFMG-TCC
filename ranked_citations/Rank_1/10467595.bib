@inproceedings{10467595,
 abstract = {In late Q1/2023, DTAC and TRUE, two of major mobile network operators in Thailand, officially completed their merger. Consequently, this study was initiated to ascertain whether their respective 5G networks had also been seamlessly integrated several months following the merger. This investigation involved conducting drive tests along two predefined routes within the urban areas of Bangkok, employing the G-NetTrack Pro tool for testing and data collection. Subsequently, an array of Quality of Service (QoS) metrics, including Reference Signal Received Power (RSRP), Reference Signal Received Quality (RSRQ), Signal to Noise Ratio (SNR), and latency, were meticulously analyzed and presented. The findings of this study revealed that, despite the successful completion of the DTAC and TRUE mergers from a business standpoint, the technical integration of their respective 5G networks had not been finalized. Remarkably, roaming functionalities were still operational between the two networks.},
 author = {Chatchalermpun, Surachai and Pornpongtechavanich, Phisit and Phanrattanachai, Kritphon and Daengsi, Therdpong},
 booktitle = {2023 6th International Seminar on Research of Information Technology and Intelligent Systems (ISRITI)},
 doi = {10.1109/ISRITI60336.2023.10467595},
 issn = {2832-1456},
 keyword = {Seminars;Measurement;Corporate acquisitions;5G mobile communication;Urban areas;Merging;Quality of service;QoS;RSRP;SNR;latency;drive tests},
 month = {Dec},
 number = {},
 pages = {164-168},
 title = {Comparison of 5G-QoS After Merger Between Two Mobile Network Operators in Urban Areas Using Mobility Tests},
 volume = {},
 year = {2023}
}
