@article{HUANG2024114185,
 abstract = {The NanChang Spherical Tokamak (NCST) is a new tokamak with low aspect ratio, which is designed to investigate merging compression startup methods. In this paper, 2D and 3D models are built to analyze eddy currents and optimize the vacuum vessel design. The structure of the vacuum vessel is analyzed by ANSYS Mechanical. The maximum stress and maximum displacement of vacuum vessel during plasma operation are 80 MPa and 0.85 mm respectively. The results show that the vacuum vessel can meet the design requirements.},
 author = {F.H. Huang and X.C. Chen and H. Chen and S.Q. Liu},
 doi = {https://doi.org/10.1016/j.fusengdes.2024.114185},
 issn = {0920-3796},
 journal = {Fusion Engineering and Design},
 keyword = {Vacuum vessel, Eddy currents, Electromagnetic forces, NCST},
 pages = {114185},
 title = {Electromagnetic and mechanical analyses for the vacuum vessel of NCST},
 url = {https://www.sciencedirect.com/science/article/pii/S0920379624000395},
 volume = {200},
 year = {2024}
}
