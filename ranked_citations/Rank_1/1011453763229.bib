@article{10.1145/3763229,
 abstract = {Vast amounts of genomic, proteomic, transcriptomics and other forms, commonly referred to as -omics data, are generated daily in an unprecedented way thanks to high-throughput Next Generation Sequencing technologies. One of the main processes to generate value and insights from this data in bioinformatics is “sequence alignment”, an algorithmic routine that matches a “reference” sequence to a larger sequence. Despite the plethora of approaches, pairwise and multiple sequence alignment remain a complex problem that requires high computational power.&nbsp; In this article, the most prominent sequence alignment approaches of the past three decades are reviewed and categorized, examining different aspects, such as their overall algorithmic synthesis, alignment quality and performance benchmarking tests in a uniform way. The latest trends reveal an increased specialization on biology-based directions, the need for alternative heuristic approaches and a promise in optics-enabled approaches and the quantum computing paradigm shift.},
 address = {New York, NY, USA},
 articleno = {70},
 author = {Prousalis, Konstantinos and Georgiou, Konstantinos and Kalogeropoulos, Andreas and Ntalaperas, Dimitrios and Konofaos, Nikos and Angelis, Lefteris and Papalitsas, Christos and Stavropoulos, Thanos and Gariboldi, Nico},
 doi = {10.1145/3763229},
 issn = {0360-0300},
 issue_date = {February 2026},
 journal = {ACM Comput. Surv.},
 keyword = {Bioinformatics, sequence alignment, sequence analysis, pairwise sequence alignment, multiple sequence alignment, short read alignment, progressive alignment, iterative refinement, evolutionary algorithms, genetic algorithms, omics, quantum computing, quantum shift, optics},
 month = {September},
 number = {3},
 numpages = {40},
 publisher = {Association for Computing Machinery},
 title = {A Survey on Sequence Alignment Algorithms and State-of-the-Art Aligners},
 url = {https://doi.org/10.1145/3763229},
 volume = {58},
 year = {2025}
}
