@article{GUO2026107002,
 abstract = {This paper proposes an engineered diaphragm that merges stress-concentrating micro-components with locally tuned stiffness; hierarchical coupling of multiple structural scales simultaneously boosts piezoresistive MEMS pressure sensor sensitivity and robustly suppresses nonlinear error. To enable inverse design of this complex architecture, we train a Radial Basis Function neural network (RBFNN) that maps user-specified performance targets directly onto optimal geometric parameters, realizing an end-to-end, data-driven dimension generator. The proposed tandem architecture resolves non-uniqueness in dimension determination, and Particle Swarm Optimization (PSO) is embedded to significantly improve training efficiency. Validation results demonstrate that diaphragms fabricated with the generated dimensions faithfully reproduce the target response: both sensitivity and nonlinear error remain below 2 %. Compared with conventional FEM trial-and-error iterations, the dimension generator delivers an order-of-magnitude acceleration in design efficiency. Leveraging the RBFNN-based dimension generator, this work delivers a high-performance sensing diaphragm for micro-pressure sensors. The proposed performance-driven parameterization framework furnishes a transferable methodology for the rapid development of analogous compliant architectures.},
 author = {Lei Guo and Peicang Chen and Yuqing Liu and Yan Liu and Weidong Wang},
 doi = {https://doi.org/10.1016/j.mejo.2025.107002},
 issn = {1879-2391},
 journal = {Microelectronics Journal},
 keyword = {Engineered diaphragm, Stress concentration, Partial stiffening, RBFNN, Dimension generator},
 pages = {107002},
 title = {Design of piezoresistive micropressure sensor with a RBFNN-based dimension generator},
 url = {https://www.sciencedirect.com/science/article/pii/S1879239125004527},
 volume = {168},
 year = {2026}
}
