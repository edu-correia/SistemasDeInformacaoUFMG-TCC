@inproceedings{11333184,
 abstract = {In electromagnetic (EM) shielding environments such as underground pipe galleries, communication bottlenecks in obstacle areas hinder perception and information exchange, leading to separation of perception and information layers. In order to accelerate the development of China’s smart grid, a fiber optic wireless heterogeneous communication and dedicated fiber optic cable technology has been developed in recent years for wireless communication shielding spaces in underground pipe galleries. The key component of intelligent fiber optic systems is the design of microwave filters. Presented a novel topology optimization strategy for microwave filters, aiming to optimize the shape and topology of electromagnetic (EM) structures. Traditional optimization techniques often fall short in achieving this goal as they struggle to effectively link various shapes and topologies through geometric parameter adjustments. To tackle this issue, this paper proposes an efficient electromagnetic topology optimization method specifically crafted for microwave device design. A new integration method is introduced, merging the benefits of Lanczos (MPVL) and Householder formulas. This method reduces the computational load associated with solving large finite element matrix equations across multiple frequencies. Moreover, a genetic algorithm (GA) with an inheritance model is employed to generate new computational formulas in each generation. These formulas are derived from shared factors between the new and parent EM structures, further cutting down computational costs. The proposed method’s effectiveness is demonstrated through a microwave example, showcasing its practical applicability.},
 author = {Liu, Hengjie and Yuan, Chao and Lv, Zhiyong and Wang, Chenxi and Zheng, Lianzhen and Zhao, Ziqi},
 booktitle = {2025 International Applied Computational Electromagnetics Society Symposium (ACES-China)},
 doi = {10.23919/ACES-China66523.2025.11333184},
 issn = {},
 keyword = {Optical fibers;Wireless communication;Optical filters;Shape;Microwave communication;Topology;Finite element analysis;Electromagnetics;Microwave filters;Genetic algorithms;Electromagnetic (EM) fast frequency sweep;finite element method (FEM);genetic algorithm (GA);matrix Padé via Lanczos (MPVL);topology optimization},
 month = {Aug},
