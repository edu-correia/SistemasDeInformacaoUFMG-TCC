@article{LI2026111094,
 abstract = {Multi-stage swirl combustion is widely employed to enhance the stability of lean swirl flames while maintaining excellent emission characteristics. The interaction between inner and outer flame configurations significantly influences the overall flame structure and combustion dynamics. This study experimentally investigates the structural and dynamic differences between stratified and merged flames using a novel dual-swirl combustor and synchronized 10 kHz PIV/OH* measurements. The results reveal that the stratified flame features an M-shaped inner flame and a V-shaped outer flame, accompanied by multiple radially distributed shear layers, including the central shear layer (CSL), inner shear layer (ISL), and outer shear layer (OSL). In contrast, the lifted V-shaped merged flame predominantly exhibits distinct ISL and OSL structures. Precessing vortex core (PVC) structures are observed in both flame configurations with different impacts: in the stratified flame, the PVC is generated downstream of the inner flame with its perturbation confined to the inner flame zone, whereas in the merged flame, it is distributed along the ISL and influences the entire flame. Stratified and merged flames can transition between each other, providing a stable flame front that forms near the ISL, allowing the burnt gases from the two stages to push the flame fronts apart. Increasing the equivalence ratios of the inner and outer premixed flows or blending hydrogen near the lip structure promotes stratified flame formation. These conditions enhance heat release, reduce heat loss, and accelerates flame propagation, stabilizing the flame front near the ISL and maintaining the stratified flame structure.},
 author = {Linye Li and Xiaojing Tian and Hui Xiao and Shengming Yin and Zhenzhen Feng and Liangliang Xu and Shuyue Lai and Mingming Gu and Guoqing Wang and Xi Xia and Fei Qi},
 doi = {https://doi.org/10.1016/j.ast.2025.111094},
 issn = {1270-9638},
 journal = {Aerospace Science and Technology},
 keyword = {Multi-stage swirl combustion, Stratified flame, Merged flame, Mode transition, Laser diagnostics},
 pages = {111094},
 title = {Experimental investigation on the transition dynamics of stratified and merged flames in a dual-stage swirl combustor},
 url = {https://www.sciencedirect.com/science/article/pii/S1270963825011575},
 volume = {168},
 year = {2026}
}
