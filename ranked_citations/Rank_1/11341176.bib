@inproceedings{11341176,
 abstract = {The behavior of the stock market has been one of the most difficult and most important research questions as far as investors, financial institutions, and policymakers are concerned. The present study attempts at an in-depth survey and conceptual integration of classical statistical, machine learning (ML), and deep learning (DL) prediction models in stock markets with references to hedonic price modeling widely applied in the housing market sector and urban analytics. Critical comparison takes place, comparing the strengths, weaknesses and performance metrics of the established methods of time series analysis including ARIMA and GARCH to more sophisticated hybrid deep-learning models including CNN-LSTM and Transformers. Comparative evidence indicates that as classical models record moderate predictive accuracy values of RMSE above 11.0 and R 2 which is below 0.80, models that use ML techniques such as Support Vector Machines and Random Forests reduce RMSE to less than 9.0 and increase R 2 to 0.88. The best improvements are seen in the hybrid ensemble/DL models, where the RMSE decreased to 6.2 and R 2 rose to above 0.93 indicating that, indeed, nonlinear learning and feature extraction based on data is very beneficial. The review also highlights the effect of multi-source data integration. Combining both automated structured financial as well as unstructured (sentiment analysis, macroeconomics, or even satellite imagery) data sources, however, has been found to decrease the RMSE by almost 30 percent and increase generalization scores. This predictive power, however, is at the cost of interpretability: more complex models are not able to maintain the interpretability usually required by the stakeholders. These housing studies insights support the usefulness of the explainable AI (XAI) tools, the strategies of variable selection, and the cross-domain transfer. Collectively, these findings show that in the future the modeling used to predict stock indices should be strong hybrid models with big data pipelines that are feature able and time-sensitive and output layer meant to be assessable. The synthesis provides an unambiguous way towards creating resilient, accurate and transparent organisational modules to create forecasting systems in an ever more volatile financial market.},
 author = {Singh, Sukhbir and Dhir, Vijay},
 booktitle = {2025 IEEE 2nd International Conference on Information Technology, Electronics and Intelligent Communication Systems (ICITEICS)},
 doi = {10.1109/ICITEICS64870.2025.11341176},
 issn = {},
 keyword = {Deep learning;Analytical models;Accuracy;Data integration;Predictive models;Transformers;Real estate industry;Data models;Stock markets;Random forests;Stock Market Prediction;Machine Learning;Deep Learning;Hedonic Pricing;Explainable AI;Hybrid Models;Data Fusion},
 month = {Aug},
