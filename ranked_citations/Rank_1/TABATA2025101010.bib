@article{TABATA2025101010,
 abstract = {We propose UniScore as a metric for integrating and standardizing the outputs of multiple search engines in the analysis of data-dependent acquisition (DDA) data from LC/MS/MS-based bottom-up proteomics. UniScore is calculated from the annotation information attached to the product ions alone by matching the amino acid sequences of candidate peptides suggested by the search engine with the product ion spectrum. The acceptance criteria are controlled independently of the score values by using the false discovery rate based on the target-decoy approach. Compared to other rescoring methods that use deep learning-based spectral prediction, larger amounts of data can be processed using minimal computing resources. When applied to large-scale global proteome data and phosphoproteome data, the UniScore approach outperformed each of the conventional single search engines examined (Comet, X! Tandem, Mascot, and MaxQuant). Furthermore, UniScore could also be directly applied to peptide matching in chimeric spectra without any additional filters.},
 author = {Tsuyoshi Tabata and Akiyasu C. Yoshizawa and Kosuke Ogata and Chih-Hsiang Chang and Norie Araki and Naoyuki Sugiyama and Yasushi Ishihama},
 doi = {https://doi.org/10.1016/j.mcpro.2025.101010},
 issn = {1535-9476},
 journal = {Molecular & Cellular Proteomics},
 keyword = {UniScore, search engine, peptide identification, Reanalysis, false discovery rate, chimera spectrum},
 number = {7},
 pages = {101010},
 title = {UniScore, a Unified and Universal Measure for Peptide Identification by Multiple Search Engines},
 url = {https://www.sciencedirect.com/science/article/pii/S1535947625001094},
 volume = {24},
 year = {2025}
}
