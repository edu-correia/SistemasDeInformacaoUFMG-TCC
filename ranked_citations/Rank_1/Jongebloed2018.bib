@conference{Jongebloed2018,
 abstract = {Previous research showed highly efficient compression results for low bit-rates using Steered Mixture-of-Experts (SMoE), higher rates still pose a challenge due to the non-convex optimization problem that becomes more difficult when increasing the number of components. Therefore, a novel estimation method based on Hidden Markov Random Fields is introduced taking spatial dependencies of neighboring pixels into account combined with a tree-structured splitting strategy. Experimental evaluations for images show that our approach outperforms state-of-the-art techniques using only one robust parameter set. For video and light field modeling even more gain can be expected. © 2018 IEEE.},
 author = {Jongebloed, Rolf and Verhack, Ruben and Lange, Lieven and Sikora, Thomas},
 doi = {10.1109/ICMEW.2018.8551561},
 journal = {2018 IEEE International Conference on Multimedia and Expo Workshops, ICMEW 2018},
 note = {Cited by: 8; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Hierarchical learning of sparse image representations using steered mixture-of-experts},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85053909139?origin=resultslist},
 year = {2018}
}
