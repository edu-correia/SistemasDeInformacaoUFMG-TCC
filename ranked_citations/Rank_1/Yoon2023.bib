@article{Yoon2023,
 abstract = {Adaptive and extreme changes in shape and configuration are the functional and morphological uniqueness of soft robots, but existing design approaches still rely on the predefined coordination of their “muscle” and “nerve” functions to produce such behaviors. Herein, a strategy is introduced for building modular soft machines that can be innervated in ways that conform to their body extension or shape changes, based on modular soft electronics. The development of soft electronic adhesive interlocking (SEAL) technology allows for instant, robust, and repeatable integration of soft electronic modules that can “innervate” and activate modular soft actuators and machines in a reconfigurable manner. Demonstrations of soft robotic tentacles and their grasping capability show that the robot function can be adapted to or reconfigured within the body with a length extended more than 10 times. The modular strategy presented herein can offer a unique promise to build up future robots with dynamic, reconfigurable functions. © 2023 The Authors. Advanced Intelligent Systems published by Wiley-VCH GmbH.},
 author = {Yoon, Jaeyoung and Byun, Junghwan and Park, Minjo and Kim, Hayun and Kim, Woongbae and Yoon, Jinsu and Cho, Kyu-Jin and Hong, Yongtaek},
 doi = {10.1002/aisy.202300013},
 journal = {Advanced Intelligent Systems},
 note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access},
 number = {8},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Reconfigurable Innervation of Modular Soft Machines via Soft, Sticky, and Instant Electronic Adhesive Interlocking},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85168398108?origin=resultslist},
 volume = {5},
 year = {2023}
}
