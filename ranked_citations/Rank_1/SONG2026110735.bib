@article{SONG2026110735,
 abstract = {In order to understand the complex flow structures in transonic compressor, flow factors in rotor cascade are modelled to explore their influence and evolution process. Flow factors including end wall effects (corner separation, tip leakage) and meridional effects (meridional flowpath, centrifugation effect) are added to two-dimension cascade to get four three-dimension cascades. Carry out the numerical simulation of five cascades, it is found that the performance lines of three-dimension cascade move to left and the working ranges near stall side are obviously wider than two-dimension cascade, and the influences from meridional effects are further deepened than end wall; end wall effects can reduce the pressure rising of cascades, but meridional effects also significantly reduce the flow loss. Analyze the internal flow structure, it is found that the severe corner separation can significantly reduce the aerodynamic flow area and accelerate the mainstream to broaden the working range near stall side, and it is also the instability factor of common three-dimension cascades; the meridional flowpath can suppress the corner separation by narrowing geometric flow area, resulting in separation at mainstream position, and the instability factor also changes from corner to shock wave/boundary layer interaction (SWBLI) separation; due to centrifugation effect, the SWBLI separation moves upwards, resulting in the change of instability factor to the accumulation of low-speed mass at tip region, also the instability factor of transonic rotor.},
 author = {Tianchu Song and Zhongyi Wang and Meng Wang and Zheng Li and Jingquan Xu},
 doi = {https://doi.org/10.1016/j.ast.2025.110735},
 issn = {1270-9638},
 journal = {Aerospace Science and Technology},
 keyword = {Transonic rotor cascade, Corner separation, Tip leakage, Meridional flowpath, Centrifugal migration, Flow structure},
 pages = {110735},
 title = {Modelling of flow structures in transonic rotor cascade},
 url = {https://www.sciencedirect.com/science/article/pii/S1270963825008065},
 volume = {168},
 year = {2026}
}
