@conference{Burger2017,
 abstract = {The potential of cooperative automated driving to increase traffic flow efficiency and safety has awakened broad interest. Although research in this field is increasing and algorithms are varied, existing literature lacks an accepted taxonomy of cooperative automated driving and cooperative driving systems remain unrated. This paper introduces a novel structure to make cooperative automated driving rateable and further classifies existing works on cooperative behavior. The novel structure and the benefits of different cooperation modes are illustrated by several use cases. © 2017 IEEE.},
 author = {Burger, Christoph and Orzechowski, Piotr F. and Taş, Ömer Şahin and Stiller, Christoph},
 doi = {10.1109/ITSC.2017.8317794},
 journal = {IEEE Conference on Intelligent Transportation Systems, Proceedings, ITSC},
 note = {Cited by: 21; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Rating cooperative driving: A scheme for behavior assessment},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85046265291?origin=resultslist},
 volume = {2018-March},
 year = {2017}
}
