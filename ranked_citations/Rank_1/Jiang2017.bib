@conference{Jiang2017,
 abstract = {We present a procedure that can estimate – with statistical consistency guarantees – any local-maxima of a density, under benign distributional conditions. The procedure estimates all such local maxima, or modal-sets, of any bounded shape or dimension, including usual point-modes. In practice, modal-sets can arise as dense low-dimensional structures in noisy data, and more generally serve to better model the rich variety of locally dense structures in data. The procedure is then shown to be competitive on clustering applications, and moreover is quite stable to a wide range of settings of its tuning parameter. Copyright 2017 by the author(s).},
 author = {Jiang, Heinrich and Kpotufe, Samory},
 journal = {Proceedings of the 20th International Conference on Artificial Intelligence and Statistics, AISTATS 2017},
 note = {Cited by: 21},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Modal-set estimation with an application to clustering},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85083938230?origin=resultslist},
 volume = {54},
 year = {2017}
}
