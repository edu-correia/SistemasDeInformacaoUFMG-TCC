@article{Yin20245456,
 abstract = {Multiview clustering (MVC) is a fundamental research topic in the field of machine learning and data mining, which has been developed rapidly and made significant progress recently. However, the current works tend to learn the individual representation of each view and then naviely merge or align them to achieve a shared representation of multiview data. By doing this, they often ignore the interference caused by the entanglement among multiple views, leading to the shared latent embedding cannot well model the correlation of all views. To this end, in this article, we propose a novel self-supervised adversarial learning-based view-common latent autoencoders for MVC, termed by multi-SSALvcAE. Specifically, the proposed method can effectively disentangle the unique and common information of each view by virtue of multiview adversarial latent autoencoders. And then only the common parts are fused to form the shared information, after being aligned deliberately on multiview semantic space. Experimental results show that our method achieved the promising results on several datasets, against the state-of-the-arts.  © 2013 IEEE.},
 author = {Yin, Ming and Chen, Rui and Lin, Renjun and Wang, Yonghua},
 doi = {10.1109/TSMC.2024.3405944},
 journal = {IEEE Transactions on Systems, Man, and Cybernetics: Systems},
 note = {Cited by: 10},
 number = {9},
 pages = {5456 - 5467},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi-SSALvcAE: Self-Supervised Adversarial Learning-Based View-Common Latent AutoEncoders for Multiview Clustering},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85196702993?origin=resultslist},
 volume = {54},
 year = {2024}
}
