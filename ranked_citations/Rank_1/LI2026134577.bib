@article{LI2026134577,
 abstract = {As one of the known causes inducing unstable wetting fronts, from a spatial order perspective, the role of heterogeneity in the preferential infiltration for unsaturated fracture networks is investigated. Specifically, for two-dimensional vertically orthogonal fracture sets, preferential pathways in finger-like profiles are observed in unsaturated seepage fields. The methodology of geological entropy, meanwhile, is employed to explore the sensitivity of heterogeneity-induced fingering to the spatial order of fracture structures. The nonmonotonic fingering behavior, known as pressure overshoot, is found to be related to the spatial association of fractures. The spatial–temporal dynamics of fingering, including the breakthrough time, the attractor zone proportion, as well as the fingering number and width, are the result of an integration from the spatial order and persistence of associations in fracture networks, which can be interpreted in terms of geological entropy. Moreover, the dynamic process of merged fingering and the formation of sub-fingering is additionally clarified. Correlation analysis indicates that the entropy scale and the breakthrough time have opposite effects on the fingering fraction. A quantitative relationship between heterogeneity-induced fingering fraction and geological entropy is proposed.},
 author = {Ce Li and Jianlong Sheng and Zonghuan Peng and Zuyang Ye},
 doi = {https://doi.org/10.1016/j.jhydrol.2025.134577},
 issn = {0022-1694},
 journal = {Journal of Hydrology},
 keyword = {Fracture network, Preferential infiltration, Heterogeneity-induced fingering, Geological entropy, Spatial order},
 pages = {134577},
 title = {Heterogeneity-induced gravitational fingering in unsaturated fracture networks: insights from geological entropy},
 url = {https://www.sciencedirect.com/science/article/pii/S0022169425019171},
 volume = {664},
 year = {2026}
}
