@inproceedings{7745280,
 abstract = {Static binary translation is a technique that allows an executable program for a given architecture to be translated into a different one, with a reduced overhead compared to emulators and dynamic binary translators. The main downside of the static approach lies in the absence of runtime information, which is available in other solutions. In particular, one of the key issues consists in the identification of data and code in the program, and, more specifically, in the detection of basic block start addresses (jump targets). The presence of indirect jump instructions whose target is not immediately evident, in particular due to C switch statements, makes the recovery of jump targets a challenging task.},
 author = {Di Federico, Alessandro and Agosta, Giovanni},
 booktitle = {2016 International Conference on Compliers, Architectures, and Sythesis of Embedded Systems (CASES)},
 doi = {10.1145/2968455.2968514},
 issn = {},
 keyword = {Switches;Registers;Runtime;Radiation detectors;Computer architecture;Target tracking;Emulation;Static Binary Translation;Data Flow Analysis;Jump Target Identification},
 month = {Oct},
 number = {},
 pages = {1-10},
 title = {A jump-target identification method for multi-architecture static binary translation},
 volume = {},
 year = {2016}
}
