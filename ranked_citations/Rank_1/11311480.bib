@article{11311480,
 abstract = {In the permanent magnet synchronous motor (PMSM) drive system, the control structure of speed-current loop merging has better response speed because it is not limited by the inner loop bandwidth. First, the feedback control law after loop merging is changed from the original first-order proportional control to the second-order proportional-differential control, in which the differential value of the error will amplify the noise and require additional filters. In light of this, the finite-time (FT) state observer based on error-variable estimation feedback is proposed. Compared with the conventional FT state observer based on the estimation of motor state variables, the proposed method takes the error and its differential value as the estimation variables, avoiding the adverse effects of differential calculations. Concurrently, the information of the reference signal is integrated into the high-order estimation state to compensate for the control law, thereby further enhancing the system response. Second, due to the increase in the model order caused by loop merging, the observed variables of the FT state observer become larger, leading to an increase in the observer’s estimation pressure and estimation spikes. Therefore, a dual-model cascaded FT control method based on error-variable estimation feedback is further proposed to effectively alleviate the estimation pressure and estimation spike of the state observer. Finally, the efficacy and dominance of the proposed scheme were validated through comprehensive experiments.},
 author = {Gao, Yixuan and Yin, Zhonggang and Li, Yuehan and Zhang, Yanping and Yuan, Dongsheng and Bai, Cong},
 doi = {10.1109/TTE.2025.3647109},
 issn = {2332-7782},
 journal = {IEEE Transactions on Transportation Electrification},
 keyword = {Merging;Motor drives;Mathematical models;Convergence;Control systems;Periodic structures;Feedback control;Torque;Bandwidth;Vehicle dynamics;Finite-time (FT) control;FT state observer;permanent magnet synchronous motor (PMSM) drive;speed-current loop merging},
 month = {April},
 number = {2},
 pages = {3690-3702},
 title = {Finite-Time Speed-Current Single-Loop Control of Permanent Magnet Synchronous Motor Based on Error-Variable Estimation Feedback},
 volume = {12},
 year = {2026}
}
