@inproceedings{8983838,
 abstract = {The AOI is an important means to improve the quality of PCB. One of its core technologies is how to plan the inspection path reasonably to ensure the full coverage of electronic components within the range allowed by the camera field of view, and to complete the path planning efficiently. It is found that hierarchical clustering and iterative self-organizing field planning algorithms have problems in sensitive initial conditions, large amount of computation and high overlap rate of different field of view components through the study of field of view and path planning. Therefore, an improved full coverage field of view planning method is proposed in this paper, which utilizes an area weight method in the process of merging grid to reduce the number of final clustering. Based on this, an insertion algorithm with variable neighborhood strategy is proposed to ensure the time complexity of the algorithm and to realize the local optimization of the photo path.},
 author = {XIAO, Zheng and WANG, Zhenan and LIU, Deng and NIU, Ziru and CAO, Dongsheng},
 booktitle = {2019 IEEE 3rd Advanced Information Management, Communicates, Electronic and Automation Control Conference (IMCEC)},
 doi = {10.1109/IMCEC46724.2019.8983838},
 issn = {},
 keyword = {Merging;Clustering algorithms;Inspection;Path planning;Iterative algorithms;Planning;Information management;Resource management;Time complexity;Optimization;Field of View Planning;Iterative Self-organizing-hierarchical Clustering Algorithm;Path Planning;Insertion Algorithm;Variable Neighborhood},
 month = {Oct},
 number = {},
 pages = {586-592},
 title = {A PCB-oriented Path Planning for AOI Full Coverage Field of View},
 volume = {},
 year = {2019}
}
