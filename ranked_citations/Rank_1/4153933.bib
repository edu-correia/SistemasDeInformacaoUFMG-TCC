@inproceedings{4153933,
 abstract = {In this paper we analyze dimension expanding joint source-channel coding (JSCC) systems. First 1:N dimension expanding systems are analyzed (scalar sources and vector channels). Kotel'nikov's theory on 1:N bandwidth expanding modulation systems is used for this purpose. These ideas are generalized to M:N dimension expanding mappings (M < N), to be able to consider more general mappings and exploit dimensionality. An example 1:2 mapping based on Archimedes' spirals is given},
 author = {Floor, Pal Anders and Ramstad, Tor A.},
 booktitle = {2006 IEEE 7th Workshop on Signal Processing Advances in Wireless Communications},
 doi = {10.1109/SPAWC.2006.346459},
 issn = {1948-3252},
 keyword = {Maximum likelihood estimation;Delay;Signal to noise ratio;Bandwidth;Spirals;Merging;Rate-distortion;Channel capacity;Gaussian noise},
 month = {July},
 number = {},
 pages = {1-5},
 title = {Noise Analysis for Dimension Expanding Mappings in Source-Channel Coding},
 volume = {},
 year = {2006}
}
