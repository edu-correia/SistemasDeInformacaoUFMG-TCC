@article{Apriceno2026384,
 abstract = {The demand for transparent and explainable AI solutions in healthcare has highlighted the limitations of purely data-driven models and emphasized the value of symbolic methods such as Fuzzy Inference Systems, which provide understandable rules and facilitate collaboration with human experts. To overcome the limitations and merge the strenghts of individual approaches, hybrid models that integrate sub-symbolic and symbolic reasoning have emerged as a promising direction. For example, Fuzzy Neural Networks merge the predictive strength of neural networks with the clarity of fuzzy systems, and their performance can be further enhanced through evolutionary techniques that optimize parameters and improve adaptability. In this study, we propose an evolutionary Fuzzy Neural Network framework that use a genetic algorithm to strengthen classification capabilities while maintaining interpretability. By incorporating the evolutionary optimization into the network’s parameter update process, the model achieves both robustness and transparency. Validation on the Maternal Health Risk dataset demonstrates that the proposed approach effectively balances predictive accuracy with explainability. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
 author = {Apriceno, Gianluca and Segala, Marina and Valer, Giovanni and Muraro, Nicola and Netti, Vincenzo and de Campos Souza, Paulo Vitor and Dragoni, Mauro},
 doi = {10.1007/978-3-032-16708-8_31},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 0},
 pages = {384 - 397},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Hybrid Evolutionary Fuzzy Neural Approach for Maternal Health Risk Prediction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105038437316?origin=resultslist},
 volume = {2830 CCIS},
 year = {2026}
}
