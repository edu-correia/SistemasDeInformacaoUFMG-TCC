@article{LI2026131927,
 abstract = {Multimodal intent recognition (MIR) uses complementary text, audio, and visual cues, yet real deployments frequently encounter missing data due to sensor failures, noise, or occlusion. Current solutions pad inputs or generate reconstructions but often treat imputed representations as definitive. This assumption causes overconfident predictions when restoration quality is uncertain. This paper presents CR-3WD to connect task-oriented latent regeneration with risk-aware decision logic. The Cross-modal Regenerative Feature Infusion Module (CRIPIM) rebuilds missing modality representations in the semantic feature space using learnable prompts and cross-modal priors. This method bypasses expensive raw-signal generation and directs regeneration toward intent discrimination. Furthermore, a Three-Way Decision Gate (TWDG) manages residual uncertainty by sorting samples into Accept, Defer, or Reject groups using adaptive confidence thresholds. Defer triggers a refinement pass, while Reject outputs Unknown to prevent unreliable data from affecting fusion. Evaluation on two benchmarks shows improvements over strong baselines. The model attained 76.85% Acc / 76.49% WF1 on MIntRec and 60.30% Acc / 59.33% WF1 on MIntRec2.0. These outcomes suggest merging semantic-space regeneration with three-way risk control produces more robust MIR given incomplete multimodal inputs.},
 author = {Senhao Li and Xiaoliang Chen and Duoqian Miao and Hongyun Zhang and Xiaolin Qin and Peng Lu},
 doi = {https://doi.org/10.1016/j.eswa.2026.131927},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Multimodal intent recognition, Cross-modal regeneration, Three way theory},
 pages = {131927},
 title = {Bridging modality gaps: Cross-modal complementary learning with three-way decision for multimodal intent recognition},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417426008407},
 volume = {316},
 year = {2026}
}
