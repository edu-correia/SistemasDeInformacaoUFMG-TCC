@article{7332933,
 abstract = {For a Gray code in the scheme of rank modulation for flash memories, the codewords are permutations, and two consecutive codewords are obtained using a push-to-the-top operation. We consider the snake-in-the-box code under Kendall’s  $\tau $ -metric, which is a Gray code capable of detecting one Kendall’s  $\tau $ -error. We answer two open problems posed by Horovitz and Etzion. First, we prove the validity of a construction given by them, resulting in a snake of size  $M_{2n+1}=({(2n+1)!}/{2})-2n+1$ . Second, we come up with a different construction aiming at a larger snake of size  $M_{2n+1}=({(2n+1)!}/{2})-2n+3$ . The construction is applied successfully to  $S_{7}$ .},
 author = {Zhang, Yiwei and Ge, Gennian},
 doi = {10.1109/TIT.2015.2502602},
 issn = {1557-9654},
 journal = {IEEE Transactions on Information Theory},
 keyword = {Reflective binary codes;Modulation;Ash;Programming;Measurement;Context;Indexes;Flash memory;rank modulation;permutations;Gray codes;snake-in-the-box codes;Flash memory;rank modulation;permutations;Gray codes;snake-in-the-box codes},
 month = {Jan},
 number = {1},
 pages = {151-158},
 title = {Snake-in-the-Box Codes for Rank Modulation Under Kendall’s  $\tau $ -Metric},
 volume = {62},
 year = {2016}
}
