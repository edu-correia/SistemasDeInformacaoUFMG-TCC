@conference{Paulus2020,
 abstract = {The Gumbel-Max trick is the basis of many relaxed gradient estimators. These estimators are easy to implement and low variance, but the goal of scaling them comprehensively to large combinatorial distributions is still outstanding. Working within the perturbation model framework, we introduce stochastic softmax tricks, which generalize the Gumbel-Softmax trick to combinatorial spaces. Our framework is a unified perspective on existing relaxed estimators for perturbation models, and it contains many novel relaxations. We design structured relaxations for subset selection, spanning trees, arborescences, and others. When compared to less structured baselines, we find that stochastic softmax tricks can be used to train latent variable models that perform better and discover more latent structure. © 2020 Neural information processing systems foundation. All rights reserved.},
 author = {Paulus, Max B. and Choi, Dami and Tarlow, Daniel and Krause, Andreas and Maddison, Chris J.},
 journal = {Advances in Neural Information Processing Systems},
 note = {Cited by: 55},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Gradient estimation with stochastic softmax tricks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85106118418?origin=resultslist},
 volume = {2020-December},
 year = {2020}
}
