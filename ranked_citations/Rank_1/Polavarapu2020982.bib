@conference{Polavarapu2020982,
 abstract = {Wireless sensors networks (WSNs) can be used in many domains, together with industrial automation when WSNs can be worn for industrial plant and equipment monitoring and organization. In the industrial structures, conversely, the specifications are different from those of the General WSN. Several industrial alliances have established requirements in recent years. These specifications are described as frames that can be defined based on WSN's particular application and have modifiable pieces. However, there has been minimal work on identifying particular protocols for an industry that could be worn as an ingredient of these values. In our survey, representative protocols that congregate some industry applications' specifications are addressed. Since the field of industrial applications itself is extensive, divide it into groups with related requirements. To comply with these criteria, these industrial classes, traditional demands and various modern WSN standards are addressed.In this paper, a detailed real-time survey of the implementation in a realistic scenario of a wireless sensor network is conducted, such as real-time intelligent temperature monitoring, border crimes and traffic monitoring, road traffic behaviour, water pressure and wireless patient monitoring. The Wireless Sensor Network has been widely deliberated in its implementation in the various fields of science. WSN has been identified in wireless areas not yet explored due to its risky existence and unaffordable locations to be the most successful solution. In the present article, a detailed and systematic approach to current updated research on the omnipresent use of WSN in various sectors is highlighted. © 2020 IEEE.},
 author = {Polavarapu, Sushma Chowdary and Panda, Sampad Kumar},
 doi = {10.1109/I-SMAC49090.2020.9243514},
 journal = {Proceedings of the 4th International Conference on IoT in Social, Mobile, Analytics and Cloud, ISMAC 2020},
 note = {Cited by: 10},
 pages = {982 - 986},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Survey on Industrial Applications using MEMS and WSN},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85097832738?origin=resultslist},
 year = {2020}
}
