@article{Tigelaar2012,
 abstract = {Peer-to-peer technology is widely used for file sharing. In the past decade a number of prototype peer-to-peer information retrieval systems have been developed. Unfortunately, none of these has seen widespread realworld adoption and thus, in contrast with file sharing, information retrieval is still dominated by centralized solutions. In this article we provide an overview of the key challenges for peer-to-peer information retrieval and the work done so far. We want to stimulate and inspire further research to overcome these challenges. This will open the door to the development and large-scale deployment of real-world peer-to-peer information retrieval systems that rival existing centralized client-server solutions in terms of scalability, performance, user satisfaction, and freedom. © 2012 ACM.},
 author = {Tigelaar, Almer S. and Hiemstra, Djoerd and Trieschnigg, Dolf},
 doi = {10.1145/2180868.2180871},
 journal = {ACM Transactions on Information Systems},
 note = {Cited by: 20; All Open Access; Green Open Access},
 number = {2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Peer-to-peer information retrieval: An overview},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84863750805?origin=resultslist},
 volume = {30},
 year = {2012}
}
