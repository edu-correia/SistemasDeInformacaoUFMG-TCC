@conference{Wingbermuehle201244,
 abstract = {ScalaPipe is a streaming application generator for heterogeneous platforms. By using a collection of domain-specific languages (DSLs) embedded in the Scala programming language, ScalaPipe allows creation of streaming applications that can run on a variety of hardware, including traditional processors, graphics processors, and field-programmable gate arrays (FPGAs). Its application DSL allows specification of the application topology and resource mapping. Its block DSL allows the authoring of implementations for processing kernels, or blocks, which are used in the streaming application. ScalaPipe makes it easy to generate, modify, and instrument large, complex topologies and resource mappings while also exposing optimization opportunities. © 2012 IEEE.},
 author = {Wingbermuehle, Joseph G. and Chamberlain, Roger D. and Cytron, Ron K.},
 doi = {10.1109/SAAHPC.2012.14},
 journal = {Symposium on Application Accelerators in High-Performance Computing},
 note = {Cited by: 2},
 pages = {44 - 53},
 publication_stage = {Final},
 source = {Scopus},
 title = {ScalaPipe: A streaming application generator},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84870681904?origin=resultslist},
 year = {2012}
}
