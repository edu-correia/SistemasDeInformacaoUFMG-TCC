@article{KUMAR2026139918,
 abstract = {In surface-cleaning formulations, mixed surfactant systems provide a versatile route to tune micellization and interfacial properties beyond what is achievable with single-surfactant systems. Here, we examine how headgroup compatibility in cationic–nonionic mixtures governs micellization and wetting performance. Accordingly, binary mixtures of the cationic benzalkonium chloride (BKC) with two nonionic surfactants, namely, alkyl polyglucoside (APG215) and lauryl alcohol ethoxylate (EO7), are investigated. The critical micelle concentrations (CMCs) of both pure and mixed systems remain invariant over a wide pH range (3–10.5), indicating robust micellization under acidic to alkaline conditions. Furthermore, the CMCs of the mixed surfactant solutions lie between those of the pure components. Dynamic contact angle measurements show that mixing improves wetting, demonstrating that adding the studied nonionic surfactants to the cationic surfactant accelerates spreading and reduces contact angles on the steel surface. Among the two explored nonionic surfactants, a clear hierarchy emerges, with the BKC+APG215 system consistently exhibiting improved wetting kinetics than the BKC+EO7 system. Proton NMR spectra give mechanistic insight and show that the BKC+APG215 system displays merged aliphatic environments and reciprocal shielding/deshielding near headgroups, leading to size-matched, complementary packing. In contrast, in the mixed system of BKC and EO7, the long ethoxylate headgroup of EO7 partially shrouds the BKC and weakens the packing. Overall, these results establish a design rule for cationic–nonionic formulations, suggesting that wetting efficacy is governed by headgroup compatibility and hydrophobe co-packing rather than CMC lowering alone.},
 author = {Vivek Kumar and Tulika Bhattacharyya and Shweta Sharma and Shanthi Appavoo and Samiran Mahapatra and Yogesh M. Joshi},
 doi = {https://doi.org/10.1016/j.colsurfa.2026.139918},
 issn = {0927-7757},
 journal = {Colloids and Surfaces A: Physicochemical and Engineering Aspects},
 keyword = {Surfactants, Cationic, Nonionic, Mixed micelle, Wetting, NMR},
 pages = {139918},
 title = {Micelle structure and dynamic wetting in cationic–nonionic surfactant systems for surface cleaning applications},
 url = {https://www.sciencedirect.com/science/article/pii/S0927775726004577},
 volume = {737},
 year = {2026}
}
