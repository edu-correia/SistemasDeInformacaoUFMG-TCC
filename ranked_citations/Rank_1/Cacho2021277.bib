@article{Cacho2021277,
 abstract = {In this paper, we introduce a set of approaches to building a n-gram corpus from the Wikipedia monthly XML dumps. We then apply these to build a 1 to 5-g corpus data set, which we then describe in detail, explaining its benefits as a supplement to larger n-gram corpora like Google Web 1T 5-g corpus. We analyze our algorithms and discuss efficiency in terms of space and time. The dataset is publicly available at www.unlv.edu. © 2021, Springer Nature Switzerland AG.},
 author = {Cacho, Jorge Ramón Fonseca and Cisneros, Ben and Taghva, Kazem},
 doi = {10.1007/978-3-030-55187-2_23},
 journal = {Advances in Intelligent Systems and Computing},
 note = {Cited by: 4},
 pages = {277 - 294},
 publication_stage = {Final},
 source = {Scopus},
 title = {Building a Wikipedia N-GRAM Corpus},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85090096313?origin=resultslist},
 volume = {1251 AISC},
 year = {2021}
}
