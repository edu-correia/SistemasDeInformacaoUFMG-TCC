@conference{Salzman20236759,
 abstract = {In the multi-objective shortest-path problem we are interested in computing a path, or a set of paths that simultaneously balance multiple cost functions. This problem is important for a diverse range of applications such as transporting hazardous materials considering travel distance and risk. This family of problems is not new with results dating back to the 1970's. Nevertheless, the significant progress made in the field of heuristic search resulted in a new and growing interest in the sub-field of multi-objective search. Consequently, in this paper we review the fundamental problems and techniques common to most algorithms and provide a general overview of the field. We then continue to describe recent work with an emphasis on new challenges that emerged and the resulting research opportunities. © 2023 International Joint Conferences on Artificial Intelligence. All rights reserved.},
 author = {Salzman, Oren and Felner, Ariel and Hernandez, Carlos and Zhang, Han and Chan, Shao-Hung and Koenig, Sven},
 doi = {10.24963/ijcai.2023/757},
 journal = {IJCAI International Joint Conference on Artificial Intelligence},
 note = {Cited by: 24; All Open Access; Gold Open Access},
 pages = {6759 - 6768},
 publication_stage = {Final},
 source = {Scopus},
 title = {Heuristic-Search Approaches for the Multi-Objective Shortest-Path Problem: Progress and Research Opportunities},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85170362407?origin=resultslist},
 volume = {2023-August},
