@conference{Song2009187,
 abstract = {To overcome the limitations of traditional text classification approaches based on bag-of-words representation and to effectively incorporate linguistic knowledge and conceptual index into text vector space model, based on two thesaurus HowNet and Tongyici Cilin(hereinafter referred to Cilin), we use semantic vector to describe a document instead of traditional keywords vector, which is based on merging words with high similarity and using a concept to describe the semantic feature rather than a series of words. It not only reduces feature dimension but also adds semantic information to the vector. We also use sentence (document) similarity based on simple vector distance to classify the text and three groups of experiments are made respectively. The results show that the accuracy rates are generally improved along with semantic treatment, which indicates that semantic mining is very important and necessary to text classification. © 2009 IEEE.},
 author = {Song, Xin and Huang, Jia and Zhou, Jing-Min and Chen, Xi},
 doi = {10.1109/IFCSTA.2009.167},
 journal = {IFCSTA 2009 Proceedings - 2009 International Forum on Computer Science-Technology and Applications},
 note = {Cited by: 9},
 pages = {187 - 190},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research of Chinese text classification methods based on semantic vector and semantic similarity},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77949856948?origin=resultslist},
 volume = {2},
 year = {2009}
}
