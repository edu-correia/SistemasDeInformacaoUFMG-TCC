@inproceedings{1394282,
 abstract = {Variable block size motion compensation has been adopted by the emerging video coding standard H.264. For a macroblock, motion estimation on each block type has to be tested in H.264 to find the best block size in use. It results in high computational complexity when examining all possible block types. Thus, a fast block type prediction is proposed to reduce the complexity. The proposed method predicts a suitable macroblock partition according to the motion field distribution and correlation within the macroblock. Therefore, only the predicted mode should be tested in motion estimation.},
 author = {Tien-Ying Kuo and Chen-Hung Chan},
 booktitle = {2004 IEEE International Conference on Multimedia and Expo (ICME) (IEEE Cat. No.04TH8763)},
 doi = {10.1109/ICME.2004.1394282},
 issn = {},
 keyword = {Automatic voltage control;Motion estimation;Video coding;Testing;Computational complexity;Motion compensation;Merging;Rate-distortion;Distance measurement;Bit rate},
 month = {June},
 number = {},
 pages = {675-678 Vol.1},
 title = {Fast macroblock partition prediction for H.264/AVC},
 volume = {1},
 year = {2004}
}
