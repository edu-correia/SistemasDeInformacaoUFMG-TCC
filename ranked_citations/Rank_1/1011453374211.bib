@article{10.1145/3374211,
 abstract = {In this work, we apply an activity theory lens to analyze nonvisual computing for blind and low-vision computer users. Our analysis indicates major challenges for users in translating the activities they are working towards into specific tasks to be completed in a system comprehensible manner. Specifically, blind and low-vision students learning to use accessible technologies struggled with organizing their activities, tracking the history and status of their operations, and understanding how the system was acting underneath these interactions. We discuss how activity-centered design can be applied to nonvisual interfaces to better match user behavior in a computational system.},
 address = {New York, NY, USA},
 articleno = {12},
 author = {Baldwin, Mark S. and Mankoff, Jennifer and Nardi, Bonnie and Hayes, Gillian},
 doi = {10.1145/3374211},
 issn = {1073-0516},
 issue_date = {April 2020},
 journal = {ACM Trans. Comput.-Hum. Interact.},
 keyword = {Accessibility, activity based computing, activity theory, assistive technology, blindness, visual impairment},
 month = {March},
 number = {2},
 numpages = {27},
 publisher = {Association for Computing Machinery},
 title = {An Activity Centered Approach to Nonvisual Computer Interaction},
 url = {https://doi.org/10.1145/3374211},
 volume = {27},
 year = {2020}
}
