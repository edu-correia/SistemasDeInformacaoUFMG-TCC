@incollection{WANG2025253,
 abstract = {Antibody−drug conjugates (ADCs) are a promising class of therapeutics that merge monoclonal antibodies’ targeted delivery with potent cytotoxic agents. The efficacy of ADCs largely hinges on their payloads, which have garnered significant attention. These payloads should be highly toxic, nonimmunogenic, stable, and have modifiable groups. Tubulin inhibitors are commonly used, dominating the ADCs under clinical development. However, traditional payloads face challenges such as subpar efficacy and drug resistance. To address these issues, research is now pivoting toward innovative payloads with varied targets and fewer side effects. Recent studies focus on understanding the structure−activity relationship, crystal structures, and design strategies. Future research aims to develop novel payloads that are effective, less toxic, stable, and capable of circumventing resistance, offering a resourceful guide for future ADC payload development.},
 author = {Yuxi Wang and Zhijia Wang and Ying Lu and Kunyu Shi and Jifa Zhang and Chengyong Wu},
 booktitle = {Drug Discovery Stories},
 doi = {https://doi.org/10.1016/B978-0-443-23932-8.00014-5},
 editor = {Bin Yu and Peng Zhan},
 isbn = {978-0-443-23932-8},
 keyword = {Tumor, drug development, therapeutic procedure, pharmaceutical chemistry, research activity},
 pages = {253-268},
 publisher = {Elsevier},
 title = {Chapter 14 - Novel payloads of antibody-drug conjugates},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443239328000145},
 year = {2025}
}
