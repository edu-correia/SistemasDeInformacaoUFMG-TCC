 author = {Cao, Yuan and Wang, Dong},
 doi = {10.1145/3764866},
 issn = {1551-6857},
 issue_date = {October 2025},
 journal = {ACM Trans. Multimedia Comput. Commun. Appl.},
 keyword = {Camouflaged object detection, Gating mechanism, Parallel branch},
 month = {October},
 number = {10},
