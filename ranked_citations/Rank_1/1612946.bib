@inproceedings{1612946,
 abstract = {In this paper we address the problem of segmenting complex handwritten pages such as novelist drafts or authorial manuscripts. We propose to use stochastic and contextual models in order to cope with local spatial variability, and to take into account some prior knowledge about the global structure of the document image. The models we propose to use are Markov Random Field models. After a formal description of the theoretical framework of Markov Random Fields and the principles of image segmentation using such models, we describe the implementation of our model and the proposed segmentation method. Then we discuss the results obtained with this approach on the drafts of the French novelist Gustave Flaubert, for different segmentation tasks. In conclusion, an extension of this work towards the use of discriminative models is discussed},
 author = {Nicolas, S. and Paquet, T. and Heutte, L.},
 booktitle = {Second International Conference on Document Image Analysis for Libraries (DIAL'06)},
 doi = {10.1109/DIAL.2006.8},
 issn = {},
 keyword = {Context modeling;Image segmentation;Markov random fields;Text analysis;Image analysis;Handwriting recognition;Production;Data mining;Hidden Markov models;Stochastic processes},
 month = {April},
 number = {},
 pages = {12 pp.-59},
 title = {Complex handwritten page segmentation using contextual models},
 volume = {},
 year = {2006}
}
