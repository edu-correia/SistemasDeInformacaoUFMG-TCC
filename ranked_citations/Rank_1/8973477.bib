@inproceedings{8973477,
 abstract = {The uncertainties of solar energy due to weather fluctuations will cause impact on photovoltaic (PV) integrated power system, limiting its further development. Hence, a novel probabilistic PV power forecasting approach based on lower upper bound estimation (LUBE) is proposed in this study, which consists of adaptive neuro-fuzzy inference system (ANFIS), modified grey wolf optimization (MGWO) algorithm and kernel density estimation (KDE). In the proposed method, two ANFIS models are combined as a group and optimized using MGWO. The output prediction intervals (PIs) from various groups are also merged together through KDE, which enhance the robustness and reliability of a sole optimized model. Owing to different quality indicators that measure diverse aspects of PIs, the proposed method achieves superior prediction results when compared with conventional forecasting methods.},
 author = {Cheng, Lilin and Zang, Haixiang and Ding, Tao and Wang, Miaomiao and Wei, Zhinong and Sun, Guoqiang},
 booktitle = {2019 IEEE Power & Energy Society General Meeting (PESGM)},
 doi = {10.1109/PESGM40551.2019.8973477},
 issn = {1944-9933},
 keyword = {Photovoltaic systems;Hands;Adaptation models;Adaptive systems;Upper bound;Estimation;Predictive models;Probabilistic logic;Forecasting;Optimization;Adaptive neuro-fuzzy inference system;modified grey wolf optimization;lower upper bound estimation;photovoltaic power;probabilistic forecasting},
 month = {Aug},
 number = {},
 pages = {1-5},
 title = {A Combined Optimization Structure of Adaptive Neuro-fuzzy Inference System for Probabilistic Photovoltaic Power Forecasting},
 volume = {},
 year = {2019}
}
