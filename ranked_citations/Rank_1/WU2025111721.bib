@article{WU2025111721,
 abstract = {Poly(p-phenylene-2,6-benzobisoxazole) (PBO) fibers have been widely used in aerospace and military applications due to their outstanding mechanical properties, yet the combined effects of temperature extremes, ultraviolet radiation, and high speed loads on their internal structure and mechanical response are not well understood. This study examined the failure mechanisms of PBO fibers under these combined conditions using synchrotron radiation techniques (wide-angle X-ray diffraction (WAXD) and small-angle X-ray scattering (SAXS)), dynamic mechanical analysis (DMA), and Fourier-transform infrared spectroscopy (FTIR). Our experimental results show that the tensile strength of PBO fiber bundles decreased from 1.7 GPa to 1.4 GPa as the temperature increased from -20 to 100 °C. Both crystallinity and crystallite dimensions show a non-monotonic trend, initially increasing and then decreasing due to microcrystal formation. We also observed distinct fracture morphologies at different temperatures. Contrary to previous studies that reported linear degradation with UV exposure, our UV aging experiments (0–360 h) revealed a temporary mechanical improvement, which is likely due to molecular chain rearrangement and microcrystalline domain formation. These findings offer fundamental insights into the structure-property relationships of PBO fibers under extreme environmental conditions. This establishes a theoretical basis for optimizing materials, predicting long-term performance, and developing advanced stabilization methods. The results also provide critical guidance for improving the durability of PBO fiber products in demanding service environments. Key contributions of this study include clarifying the non-monotonic temperature-dependent crystallinity evolution, identifying UV-induced microstructural reorganization mechanisms, demonstrating temporary mechanical enhancement under UV irradiation, and correlating microstructural evolution with macroscopic performance degradation. These contributions collectively advance the fundamental understanding of PBO fiber behavior under complex environments and loading conditions.},
 author = {Jiayi Wu and Jianbin Tang and Jianwei Zhou and Lufeng Deng and Jun Lei and Zhongming Li and Ganji Zhong and Hao Lin},
 doi = {https://doi.org/10.1016/j.polymdegradstab.2025.111721},
 issn = {0141-3910},
 journal = {Polymer Degradation and Stability},
 keyword = {PBO fibers, Microvoids, High speed load, X-ray scattering},
 pages = {111721},
 title = {Mechanical response of PBO fibers under combined high temperature and high speed load after ultraviolet exposure},
 url = {https://www.sciencedirect.com/science/article/pii/S0141391025005506},
 volume = {242},
 year = {2025}
}
