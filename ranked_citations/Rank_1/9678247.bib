@inproceedings{9678247,
 abstract = {This paper presents an innovative beam-scanning leaky-wave antenna (LWA), which enables scanning over a wide-angle from - 35° to + 345° between 57 and 62 GHz, with broadside radiation centred at 60 GHz The proposed LWA design is based on a metasurface thin compact unit cell The LWA structure consists of a typical coaxially fed patch antenna merged, for the first time, with a metasurface absorber acting as an artificial ground A ray optic methodology for the unit-cell design of the metasurface is proposed followed by structure analysis, which makes it possible to transform a unit cell with highly reflective characteristics to a perfect absorber for normal incident waves The three-layer antenna structure includes a matrix of 4x4 square slots that is printed on top of the dielectric substrate and printed on the bottom ground plane The X-shaped slots enhance the impedance bandwidth and radiation properties of the antenna The proposed antenna structure exhibits metamaterial property with a Gain (43-10 dBi) and radiation efficiency variation of 554-842% with an overall height of 253mm.},
 author = {Mingle, Solomon and Ahmad, Sarosh and Hassoun, Ihab and Liaqat, Maryam},
 booktitle = {2021 1st International Conference on Microwave, Antennas & Circuits (ICMAC)},
 doi = {10.1109/ICMAC54080.2021.9678247},
 issn = {},
 keyword = {Integrated optics;Slot antennas;Optical design;Optical device fabrication;Reflector antennas;Metasurfaces;Leaky wave antennas;Frequency scanning;Leaky-Wave Antenna;mm-wave},
 month = {Dec},
 number = {},
 pages = {1-3},
 title = {Enhancing Frequency-Scanning Leaky-Wave Antenna Design Base-metamaterial for Millimeter-wave application},
 volume = {},
