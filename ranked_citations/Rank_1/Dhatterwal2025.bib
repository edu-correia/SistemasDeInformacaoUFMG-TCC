@conference{Dhatterwal2025,
 abstract = {Achieving reliable Artificial General Intelligence (AGI) demands architectures that merge the stability of symbolic reasoning with the adaptability of neural networks. This work introduces a novel neuro-symbolic AGI framework that integrates hybrid model design specifically, knowledge fusion through a neural-symbolic attention mechanism with formal verification to enforce symbolic constraints. We analyze the limitations of purely neural and purely symbolic paradigms, benchmarking prior models such as DeepProbLog and Logic Tensor Networks against our approach. The proposed dynamic integration employs graph networks for relational reasoning and is validated through an ethical decision-making case study illustrating interpretable rule execution. Experimental results on AGI-scale tasks, including question answering and multiagent planning, reveal a 25% improvement in adversarial robustness and a 40% gain in explainability (via SHAP and logic-based audits). The framework advances scalable, verifiable AGI engineering with explicit attention to fairness, safety, and human-AI collaboration.  © 2025 IEEE.},
 author = {Dhatterwal, Jagjit Singh and Kumar, Sandeep and Choudhary, Shilpa},
 doi = {10.1109/ICMNWC66779.2025.11354374},
 journal = {5th IEEE International Conference on Mobile Networks and Wireless Communications, ICMNWC 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Neuro-Symbolic Computing Architectures for Trustworthy AGI Systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105033633663?origin=resultslist},
 year = {2025}
}
