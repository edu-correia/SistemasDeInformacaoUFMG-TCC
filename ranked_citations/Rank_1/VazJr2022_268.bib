@article{VazJr2022_268,
 abstract = {There are two different but equivalent ways of interpreting the integration of the Dirac delta function within the context of the theory of distributions. We discuss both of them and argue that the least known is the most suitable one for handling problems where integrals involving the Dirac delta function appear in physics and engineering. Examples are given to illustrate this point.},
 author = {Vaz Jr., Jayme},
 doi = {10.1590/1806-9126-rbef-2021-0378},
 pages = {e202100378--e202100378},
 title = {Some comments on integrals involving the Dirac delta function},
 volume = {44},
 year = {2022}
}
