@conference{Mironela2024,
 abstract = {This study proposes methods that can be used to examine and interpret comments that users have made after watching videos on YouTube on a particular topic. YouTube tutorials are very popular among young people. They have become an important pillar in informal education, thus contributing to the rapid acquisition of skills and knowledge. Under these circumstances, we were interested in analysing the YouTube videos comments, knowing that the platform has a continuous increase in popularity, which is also due to the opportunities of sharing them. Since ChatGPT-themed YouTube videos have seen a significant surge in popularity since 2022, we were interested to analyse some videos that approach the topics of 'ChatGPT, AI clone, AI robot and Deep Learning.'  © 2024 IEEE.},
 author = {Mironela, Pirnau and Iustin, Priescu and Mihaela, Priescu Catalina and Claudiu, Pirnau and Daniel, Ghiculescu Liviu},
 doi = {10.1109/ECAI61503.2024.10607575},
 journal = {Proceedings of the 16th International Conference on Electronics, Computers and Artificial Intelligence, ECAI 2024},
 note = {Cited by: 4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Analysis of YouTube Video Comments with NLP Methods},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85201178010?origin=resultslist},
 year = {2024}
}
