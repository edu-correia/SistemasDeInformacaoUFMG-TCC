@incollection{WARIS2025209,
 abstract = {Under the umbrella term of tissue engineering, biological, medical, and engineering proficiencies merge to reform the structure and function of soft tissues. In tissue engineering, synthesis of an appropriate scaffold is the basic requirement. Electrospun nanofibers are considered suitable scaffold owing to their great resemblance with the three-dimensional (3D) mesh of fine fibers and well-knitted micropores of natural extracellular matrix (ECM). This chapter presents a brief overview of the method of electrospinning and its vast applications and usage in the arena of tissue engineering (particularly for soft tissue tissues). First, it briefly introduced the process of electrospinning, ideal materials for electrospinning, and benefits of this advanced technology. Next, it described comprehensive details about the applications of electrospun fibers for soft tissues like muscles, fibrous tissues, blood vessels, and supporting tissues. Finally, it concluded with the future anticipations and expectations from the electrospun nanofibrous scaffolds for soft tissue regeneration.},
 author = {Tayyba Sher Waris and Amna Akhtar and Muhammad Yar},
 booktitle = {Electrospun Biomaterials for Tissue Engineering and Drug Delivery Applications},
 doi = {https://doi.org/10.1016/B978-0-443-29066-4.00020-2},
 editor = { Inamuddin and Tariq Altalhi and Maha Khan},
 isbn = {978-0-443-29066-4},
 keyword = {Extracellular matrix, three dimension, electrospun scaffolds, nanofiber scaffolds, soft tissues, tissue application},
 pages = {209-231},
 publisher = {Woodhead Publishing},
 series = {Woodhead Publishing Series in Biomaterials},
 title = {9 - Electrospun scaffolds for soft tissue (muscle, fibrous tissue, blood vessels, and supporting tissue) applications},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443290664000202},
 year = {2025}
}
