@incollection{MOTTAMONTESERRAT2021121,
 abstract = {We present a new concept of natural language, integrating axiomatic pattern of living organism to logical feature of grammatical rules. While for Linguists language mediates between reality and mind depending only on system of linguistic symbols and signs mechanically coded through rules, and our concept covers the contextual functioning of language, integrating dynamic to mechanical. There is meaning only if there is context. Although there are unknown parameters of the context influencing the whole language process, it presents regularity, which can be modeled mathematically. Parameters influence the whole language process increasing its complexity and the potential closeness of “match” between the system’s model of the environment and the (infinitely complex) environment itself. For this, our axiomatic-logical model comprises two temporal classifications: a fleeting reality, with a “before” and “after” that merges into the human phenomenon and an enduring classification of experience to determine which aspects of it should be expressed.},
 author = {Dioneia {Motta Monte-Serrat} and Carlo Cattani},
 booktitle = {The Natural Language for Artificial Intelligence},
 doi = {https://doi.org/10.1016/B978-0-12-824118-9.00002-3},
 editor = {Dioneia {Motta Monte-Serrat} and Carlo Cattani},
 isbn = {978-0-12-824118-9},
 keyword = {Natural language process, Coded rules, Axiomatic-logical model, Language temporal classification, Meaning construction},
 pages = {121-131},
 publisher = {Academic Press},
 series = {Cognitive Data Science in Sustainable Computing},
 title = {Chapter 6 - The structure of language and its axiomatic-logical nature},
 url = {https://www.sciencedirect.com/science/article/pii/B9780128241189000023},
 year = {2021}
}
