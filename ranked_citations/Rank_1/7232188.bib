@inproceedings{7232188,
 abstract = {In urban bus stop and its neighboring area, traffic conflicts among buses, other vehicles and non-motor vehicles happen frequently, and cause traffic accidents to occur easily. In this paper, traffic safety situation in urban bus stop was taken as study object. Method of traffic safety comprehensive evaluation based on traffic conflict technology being applied, some issues on traffic safety evaluation of urban bus stop were explored. In the process of traffic safety evaluation, the first task was the analysis of traffic conflict in urban bus stop. Secondly, traffic conflict survey in urban bus stop had been done and the traffic conflict data gotten. Finally, summarized the effects of two aspects of conflict rate and average conflict severity, traffic safety comprehensive evaluation model of urban bus stop had been proposed, and the effectiveness and practicability of this method had been verified by case study. The study results suggest that method of traffic safety comprehensive evaluation based on traffic conflict technology is an effective tool on traffic safety evaluation of urban bus stop.},
 author = {Feng, Lu and Yunlong, Wang},
 booktitle = {2015 International Conference on Transportation Information and Safety (ICTIS)},
 doi = {10.1109/ICTIS.2015.7232188},
 issn = {},
 keyword = {Safety;Vehicles;Roads;Merging;Acceleration;Data analysis;urban bus stop;traffic conflict;conflict rate;average conflict severity},
 month = {June},
 number = {},
 pages = {219-222},
 title = {Study on traffic safety evaluation of urban bus stop},
 volume = {},
 year = {2015}
}
