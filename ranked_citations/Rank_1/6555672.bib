@inproceedings{6555672,
 abstract = {This paper describes a new automated method for the detection and volumetric reconstruction of the wetting front based on computerized tomography (CT) imaging of soil samples. The wetting front detection and its volumetric representation are important for analyzing the advancement of humidity in soils. However, there are few existing methods for the analysis of humidity contents and the detection of the wetting front in three-dimensions. This is a very challenging task due to factors such as the stochastic nature of the humidity infiltration process and of the structure of porous media (soils), as well as artifacts in the CT imaging of these materials. The inputs to our proposed method are the CT slices, and CT sequences showing the fluid infiltration process. Experimental results indicate that our method is efficient and may lead to new measurements of the fluid infiltration process in soils.},
 author = {Vásquez, Dionicio and Scharcanski, Jacob and Wong, Alexander and Crestana, Silvio},
 booktitle = {2013 IEEE International Instrumentation and Measurement Technology Conference (I2MTC)},
 doi = {10.1109/I2MTC.2013.6555672},
 issn = {1091-5281},
 keyword = {Soil;Moisture;Computed tomography;Image segmentation;Merging;Image reconstruction;Humidity;Wetting front;Computerized tomography;Image analysis;3D image processing},
 month = {May},
 number = {},
 pages = {1540-1543},
 title = {A novel 3D approach for the extraction of the wetting front in CT images of soil profiles},
 volume = {},
 year = {2013}
}
