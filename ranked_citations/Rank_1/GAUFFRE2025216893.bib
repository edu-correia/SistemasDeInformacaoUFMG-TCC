@article{GAUFFRE2025216893,
 abstract = {In coordination chemistry, a molecule interacting with a metal is described as a ligand coordinating to the metal center. When such a molecule contains both a polar group and an apolar part (such as an alkyl tail), this ligand is also referred to as a surfactant in the field of soft matter science. This dual role suggests that coordination chemistry and soft matter are two overlapping scientific fields. In this review, we will highlight that this overlap occurs not only at the molecular level, where the ligand could be considered as a surfactant, but also at larger scales, when the molecular complex is used as a precursor to synthesize nanoparticles. Finally, the ligand can drive nanoparticles assembly. Thus, the concepts of coordination chemistry and soft matter enrich each other, leading to original combined properties as well as a better understanding of systems developed at the intersection of these two sciences.},
 author = {Fabienne Gauffre and Yannick Coppel and Jean-Daniel Marty and Christophe Mingotaud and Myrtil L. Kahn},
 doi = {https://doi.org/10.1016/j.ccr.2025.216893},
 issn = {0010-8545},
 journal = {Coordination Chemistry Reviews},
 keyword = {Ligand-metal interaction, NMR spectroscopy, Ligand-solution's interface, Stabilization, Structuring of nanoparticles},
 pages = {216893},
 title = {When coordination chemistry meets soft matter: From hybrid nanoparticles to assemblies},
 url = {https://www.sciencedirect.com/science/article/pii/S0010854525004631},
 volume = {543},
 year = {2025}
}
