@conference{Tang20231133,
 abstract = {Music creation based on deep learning has been participated by many researchers, and it is challenging to improve the musicality of artificial intelligence composition. This paper uses the Transformer network structure to generate musical note sequences and chord sequences. After obtaining the melody of the notes, the Transformer network architecture learns the time dependence from the data to generate chords, and finally stitches them into a piece of music. We use the method of chord recognition to separate the main melody and chord progression of a piece of music, and the melody event and chord event are respectively used as the input of the two networks. This method improves the harmony and musical structure of chords and main melodies by 1.4% and 0.7%, respectively, compared with ordinary Transformers. This study provides a music processing method and training method for the model to better learn music features.  © 2023 IEEE.},
 author = {Tang, Jiandong and Yin, Lanqing and Yu, Jinming},
 doi = {10.1109/ICSCSS57650.2023.10169184},
 journal = {International Conference on Sustainable Computing and Smart Systems, ICSCSS 2023 - Proceedings},
 note = {Cited by: 1},
 pages = {1133 - 1138},
 publication_stage = {Final},
 source = {Scopus},
 title = {Partially Trained Music Generation based on Transformer},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85166185792?origin=resultslist},
 year = {2023}
}
