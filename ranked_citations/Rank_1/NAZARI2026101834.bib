@article{NAZARI2026101834,
 abstract = {Double halide perovskites constitute a promising solution to the persistent stability-efficiency trade-off, combining exceptional structural tunability with enhanced durability for next-generation optoelectronic devices. The novel lead-free perovskite Cs2CuBiBr6 merges the photostability of an all-inorganic lattice with a tunable bandgap essential for efficient solar energy harvesting. This work systematically evaluates Cs2CuBiBr6-based photovoltaic devices employing various inorganic charge transport materials to establish superior device configurations. Following broad initial screening of different inorganic ETLs and HTLs, four promising device structures were selected for detailed performance optimization. Fundamental parameters encompassing absorber and HTL thickness, defect density and dopant concentration and back-contact work function were systematically analyzed. The optimized double halide perovskite solar cell featuring an Au/MoS2/Cs2CuBiBr6/Cd0.5Zn0.5S/ITO device architecture delivered exceptional photovoltaic performance with a Jsc of 35.82 mA/cm2, Voc of 1.06 V, fill factor of 81.16% and PCE of 30.68% at 300 K. Among the investigated configurations, this architecture emerged as the most promising for practical applications, owing to its high efficiency, favorable band alignment, and improved charge extraction characteristics. In comparison, with the ETL fixed as Cd0.5Zn0.5S, the Sb2Se3-based counterpart exhibited nearly equivalent performance with Jsc = 35.84 mA/cm2, Voc = 1.06 V, FF = 80.90% and PCE = 30.59%. Devices using CuO and Cu2Te as HTL’s also showed promising efficiencies of 30.13% and 26.68%, respectively. Notably, replacing the Au contact with Se in the Cu2Te-based device enhanced performance significantly, reaching a Jsc = 36.31 mA/cm2, Voc = 1.05 V, and FF = 81.78% and PCE = 31.12%. These results underscore the promise of all-inorganic Cs2CuBiBr6-based architectures in delivering efficient, stable, and environmentally benign double halide PSCs, providing a solid foundation for next-generation photovoltaic technology.},
 author = {S.m. Jawwad Nazari and Mehrin Islam and Arunangshu Saha and Safayat-Al Imam},
 doi = {https://doi.org/10.1016/j.nxmate.2026.101834},
 issn = {2949-8228},
 journal = {Next Materials},
 keyword = {Double Halide, Inorganic CTL's, ETL/HTL engineering, SCAPS-1D},
 pages = {101834},
 title = {Performance enhancement of Cs2CuBiBr6-based double halide perovskite solar cells via engineered inorganic charge transport layers},
 url = {https://www.sciencedirect.com/science/article/pii/S2949822826002510},
 volume = {11},
 year = {2026}
}
