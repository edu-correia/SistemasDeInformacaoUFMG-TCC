@inproceedings{11406861,
 abstract = {Transformer architectures in super-resolution often suffer from two issues: they incur quadratic computational complexity when modeling global information, or they rely on static, content-agnostic local windows. While recent content-aware methods attempt to solve this, they often depend on static, pre-learned priors, limiting their adaptability to novel image content. We propose a lightweight Dynamic Token Aggregation Network (DyTANet) to address these issues. We design an efficient dynamic token aggregation block that performs runtime role-based semantic clustering by grouping query and key vectors independently. This unique approach allows the network to model long-range dependencies based on functional roles. This is followed by a two-phase attention mechanism, where intra-cluster self-attention and centroid cross-attention are performed to capture global information effectively. In addition, we introduce a centroid evolution across layers mechanism. This mechanism enables the exchange of centroid information between layers, thereby reducing the computational overhead of dynamic clustering. Experiments show that DyTANet outperforms current mainstream lightweight models. On the Urban100 dataset, DyTANet’s PSNR is 0.45 dB higher than MambaIR-lt, while reducing the number of parameters by 32%.},
 author = {Lu, Linchao and Chen, Guo and Cai, Wenlu},
 booktitle = {2025 2nd International Conference on Image, Signal Processing and Communication Technology (ISPCT)},
 doi = {10.1109/ISPCT68220.2025.11406861},
 issn = {},
 keyword = {Adaptation models;Runtime;Computational modeling;Superresolution;Semantics;Pipelines;Merging;Transformers;Vectors;Standards;Image Super-Resolution;Transformer;Dynamic Attention;Token-Aggregation},
 month = {Dec},
 number = {},
 pages = {29-37},
 title = {DyTANet: Dynamic Token Aggregation Network for Lightweight Image Super-Resolution},
 volume = {},
