@incollection{SOMKUWAR2026231,
 abstract = {Knitted-based triboelectric nanogenerators (TENGs) represent a significant advancement in the field of wearable energy harvesting, merging the flexibility of textile structures with triboelectric energy generation mechanisms. This chapter explores the foundational principles of TENGs and their integration into knitted textile architectures, emphasizing innovative design strategies such as multilayer stitching, integrated dielectric-conductive knitting, and core-shell yarn-based systems. It further examines fabrication techniques, material selection based on triboelectric series, and the impact of textile structures on performance. A detailed comparison of existing knitted TENG designs highlights their output efficiency, scalability, and durability. The chapter also evaluates the sustainability potential of these systems and outlines the challenges related to material stability and energy conversion efficiency. Emerging trends and future research directions are discussed to guide further development of knitted TENGs for wearable electronics and smart textiles.},
 author = {Viraj U. Somkuwar and Bipin Kumar},
 booktitle = {Textile- and Fiber-Based Triboelectric Nanogenerators},
 doi = {https://doi.org/10.1016/B978-0-443-24074-4.00013-0},
 editor = {Shahid {Ul Islam} and Md. Milon Hossain and Daniel Mulvihill and Wazed Ali and Satyaranjan Bairagi},
 isbn = {978-0-443-24074-4},
 keyword = {Textile triboelectric nanogenerator, knitting, weaving, wearable electronics, self-powered monitoring},
 pages = {231-252},
 publisher = {Woodhead Publishing},
 series = {Woodhead Publishing Series in Electronic and Optical Materials},
 title = {9 - Knitted-based triboelectric nanogenerator},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443240744000130},
 year = {2026}
}
