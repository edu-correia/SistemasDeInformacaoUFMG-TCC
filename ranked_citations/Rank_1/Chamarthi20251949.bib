@conference{Chamarthi20251949,
 abstract = {The proliferation of cloud data warehousing has created critical challenges in maintaining both data security and query functionality. While encryption protects sensitive information, it traditionally impedes efficient query processing. This paper proposes a novel framework that integrates verifiable Boolean keyword searchable encryption specifically designed for cloud data warehouse environments. Our approach combines partial homomorphic encryption with blockchain-based verification and AI-enhanced caching to enable complex Boolean queries (AND, OR, NOT) over encrypted data while ensuring result verifiability and performance efficiency. The system employs bilinear map accumulators for lightweight verification and introduces a query fragment caching algorithm with predictive prefetching to optimize frequently accessed query patterns. Security analysis demonstrates the scheme's resilience against adaptive chosen-label attacks and ensures unforgeability under the bilinear q-strong Diffie-Hellman assumption. Performance evaluation shows significant improvements: up to 50% reduction in computational overhead through GPU acceleration and 35% faster response times for cached query fragments compared to existing schemes. Our solution provides a comprehensive approach to secure, verifiable, and efficient query processing in encrypted cloud data warehouses without compromising security guarantees. © 2025 IEEE.},
 author = {Chamarthi, Harish},
 doi = {10.1109/ICCES67310.2025.11336939},
 journal = {Proceedings of 10th International Conference on Communication and Electronics Systems, ICCES 2025},
 note = {Cited by: 0},
 pages = {1949 - 1954},
 publication_stage = {Final},
 source = {Scopus},
 title = {AI Integration Achieving Efficient & Secure Cloud Data Warehousing through Verifiable Boolean Keyword Searchable Encryption},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105033533354?origin=resultslist},
 year = {2025}
