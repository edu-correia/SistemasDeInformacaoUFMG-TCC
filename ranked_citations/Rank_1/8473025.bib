@inproceedings{8473025,
 abstract = {The introduction of Multiple Input Multiple Output(MIMO) systems and the implementation of Long Term Evolution(LTE) technology has greatly revolutionized the fields of communication but at the same time sets forth several challenge. One of the major challenges is the need of a turbo decoding technique to decode the huge amount of data. The paper proposes the hardware realization of a highly efficient parallel sorting mechanism that is the Odd-Even Merge Sort which has been implemented aiming to tackle the above problem statement. Virtex-V FPGA has been used for the same. The results were validated by cross verifying with MATLAB and various comparisons were made on the basis of speed, accuracy and hardware consumption.},
 author = {Sadangi, Sushant and Priyanka, Priti},
 booktitle = {2018 Second International Conference on Inventive Communication and Computational Technologies (ICICCT)},
 doi = {10.1109/ICICCT.2018.8473025},
 issn = {},
 keyword = {Sorting;Hardware;Field programmable gate arrays;Computer architecture;Long Term Evolution;Matlab;Approximation algorithms;MIMO;LTE;Odd-Evan Merge Sort;Virtex-V;FPGA;MATLAB},
 month = {April},
 number = {},
 pages = {359-362},
 title = {FPGA Implementation of Parallel Sorting Mechanism for Turbo Decoding in LTE System},
 volume = {},
 year = {2018}
}
