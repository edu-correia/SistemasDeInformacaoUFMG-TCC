@article{HOU2025,
 abstract = {Kleptosomes – specialized organelles in sea slugs that hijack chloroplasts – illuminate pathways for synthetic organelle engineering. Their unique mechanisms of organelle integration, energy coupling, and stress-responsive adaptation offer potential blueprints for bioenergy and medical applications, merging fundamental research and cutting-edge biotechnology to address global sustainability and health challenges.},
 author = {Yuyong Hou and Suihao Yan and Longjiang Yu and Lei Zhao},
 doi = {https://doi.org/10.1016/j.tibtech.2025.10.023},
 issn = {0167-7799},
 journal = {Trends in Biotechnology},
 keyword = {kleptosomes, synthetic organelle, photosynthesis, metabolic regulation},
 title = {Kleptosomes: biotechnological blueprints for organelle engineering},
 url = {https://www.sciencedirect.com/science/article/pii/S0167779925004512},
 year = {2025}
}
