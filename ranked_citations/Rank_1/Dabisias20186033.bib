@conference{Dabisias20186033,
 abstract = {This paper presents a simple and robust method for the automatic localisation of static 3D objects in large-scale urban environments. By exploiting the potential to merge a large volume of noisy but accurately localised 2D image data, we achieve superior performance in terms of both robustness and accuracy of the recovered 3D information. The method is based on a simple distributed voting schema which can be fully distributed and parallelised to scale to large-scale scenarios. To evaluate the method we collected city-scale data sets from New York City and San Francisco consisting of almost 400k images spanning the area of 40 km<sup>2</sup> and used it to accurately recover the 3D positions of traffic lights. We demonstrate a robust performance and also show that the solution improves in quality over time as the amount of data increases. © 2018 IEEE.},
 author = {Dabisias, Giacomo and Ruffaldi, Emanuele and Grimmett, Hugo and Ondruska, Peter},
 doi = {10.1109/ICRA.2018.8460196},
 journal = {Proceedings - IEEE International Conference on Robotics and Automation},
 note = {Cited by: 1},
 pages = {6033 - 6038},
 publication_stage = {Final},
 source = {Scopus},
 title = {VALUE: Large Scale Voting-Based Automatic Labelling for Urban Environments},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85057240128?origin=resultslist},
 year = {2018}
}
