@conference{Krüger2020,
 abstract = {The project EXtracting Product Lines from vAriaNTs (EXPLANT) funded by the German Research Foundation (DFG) is currently in its second phase. In this project, we are concerned with the stepwise migration of cloned variants into a software product line (i.e., the extractive approach of adopting systematic software reuse). While the extractive approach is the most common one in practice, many of its characteristics (e.g., processes, costs, best practices) are still unclear and tool support is limited (e.g., for feature location, refactoring, quality assurance). Within this extended abstract, we report on a selection of results we achieved in EXPLANT so far, and highlight our goals as well as opportunities for research collaborations in the second phase. © 2020 Copyright held by the owner/author(s).},
 author = {Krüger, Jacob and Krieter, Sebastian and Saake, Gunter and Leich, Thomas},
 doi = {10.1145/3377024.3377046},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Extracting product lines from variants (explant)},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85079851914?origin=resultslist},
 year = {2020}
