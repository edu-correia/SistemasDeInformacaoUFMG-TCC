@conference{Lee2004524,
 abstract = {We consider techniques for applying DC control (DCC) to a multilevel modulation data stream for optical data storage. We describe basic algorithms for controlling DC content, analyze their effectiveness in suppressing low-frequency and DC content, compare their performance and complexity against binary modulation schemes (EFM for CD and EFM+ for DVD), and prove that they guarantee bounded digital sum value for all input patterns. We also briefly discuss how these DCC codes are used within a larger system containing a multilevel modulation encoder.},
 author = {Lee, David C.},
 doi = {10.1117/12.556727},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 0},
 pages = {524 - 534},
 publication_stage = {Final},
 source = {Scopus},
 title = {DC control for multilevel modulation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/10044238100?origin=resultslist},
 volume = {5380},
 year = {2004}
}
