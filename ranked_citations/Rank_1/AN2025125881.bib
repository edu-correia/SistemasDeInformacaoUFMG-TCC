@article{AN2025125881,
 abstract = {To efficiently dissipate heat produced in micro electric equipment, the pool boiling heat transfer has drawn wide attentions because of its high efficiency. Different from the structures like foams which was mostly applied in previous works, we firstly cold-compressed micro copper powder into packed beds for pool boiling heat transfer in this work. Furthermore, the correlation between the heat flux and superheat was obtained by fitting experimental results of the bare beds (Bbeds) to Rohensow formula. This correlation is obviously different from that of foams, and the Bbeds have an obvious advantage in high (heat transfer coefficient) HTC when the superheat is lower than 10℃. To further improve the performances of Bbeds, the copper mesh was further covered on the Bbeds. Results turns out that: the optimal Bbed, which possesses a porosity of 50 % and a thickness of 1.5 mm, could have a maximum HTC of 4.9×104 W∙m−2∙K−1, which is about 3 times that of smooth copper for the same heat flux. By covering gradient copper meshes on this Bbed, the highest HTC could be further enhanced by 1.4 times, which is about 6.9×104 W∙m−2∙K−1. This gradient copper mesh coverings are composed of 60-meshes mesh as top layer and 80-meshed mesh as lower layer. The gradient copper mesh coverings could form a “micro chimney” structure, thus effectively accelerating the separation frequency of bubbles which is increased by about 20 %, and suppressing the merging of bubbles therefore the bubble diameter is reduced by about 50 %. This work is expected to supply more methods for improving the pool boiling heat transfer.},
 author = {Jiajun An and Bo Chen and Congliang Huang and Xiaodong Wang},
 doi = {https://doi.org/10.1016/j.applthermaleng.2025.125881},
 issn = {1359-4311},
 journal = {Applied Thermal Engineering},
 keyword = {Pool boiling heat transfer, Mesh covering, Porous copper, Copper powder},
 pages = {125881},
 title = {Boiling heat transfer enhanced by covering copper mesh on powder packed beds},
 url = {https://www.sciencedirect.com/science/article/pii/S1359431125004727},
 volume = {268},
 year = {2025}
}
