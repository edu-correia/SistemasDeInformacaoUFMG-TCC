@article{8211919,
 abstract = {This is the first in a series of papers studying the astrophysics and cosmology of massive, dynamically relaxed galaxy clusters. Here we present a new, automated method for identifying relaxed clusters based on their morphologies in X-ray imaging data. While broadly similar to others in the literature, the morphological quantities that we measure are specifically designed to provide a fair basis for comparison across a range of data quality and cluster redshifts, to be robust against missing data due to point source masks and gaps between detectors, and to avoid strong assumptions about the cosmological background and cluster masses. Based on three morphological indicators – symmetry, peakiness, and alignment – we develop the symmetry–peakiness–alignment (SPA) criterion for relaxation. This analysis was applied to a large sample of cluster observations from the Chandra and ROSAT archives. Of the 361 clusters which received the SPA treatment, 57 (16 per cent) were subsequently found to be relaxed according to our criterion. We compare our measurements to similar estimators in the literature, as well as projected ellipticity and other image measures, and comment on trends in the relaxed cluster fraction with redshift, temperature, and survey selection method. Code implementing our morphological analysis will be made available on the web (http://www.slac.stanford.edu/amantz/work/morph14).},
 author = {Mantz, Adam B. and Allen, Steven W. and Morris, R. Glenn and Schmidt, Robert W. and von der Linden, Anja and Urban, Ondrej},
 doi = {10.1093/mnras/stv219},
 issn = {1365-2966},
 journal = {Monthly Notices of the Royal Astronomical Society},
 keyword = {galaxies: clusters: general;X-rays: galaxies: clusters},
 month = {March},
 number = {1},
 pages = {199-219},
 title = {Cosmology and astrophysics from relaxed galaxy clusters – I. Sample selection},
 volume = {449},
 year = {2015}
}
