@inproceedings{6005963,
 abstract = {Isoline generating is often used in reservoir simulation, but the speed of data processing is likely to become slowly while the number of data is enormous. During the isoline generating, isoline tracing takes most of the time. In order to satisfy the requirement of real-time, an isoline tracing algorithm with CUDA is designed in this paper. In the algorithm designed here, equivalent points are stored in texture memory, and took an indexed array instead of link list structure. In order to make full use of multi-thread in GPU, a new method for tracing the isoline is designed in this paper. The experiment shows that the algorithm is high effective even if the number of data is enormous.},
 author = {Dong, Lanfang and Chen, Jiahui and Wang, Jin},
 booktitle = {2011 Sixth International Conference on Image and Graphics},
 doi = {10.1109/ICIG.2011.117},
 issn = {},
 keyword = {Graphics processing unit;Instruction sets;Indexes;Arrays;Real time systems;Algorithm design and analysis;Data visualization;Isoline Tracing;CUDA;Real-time},
 month = {Aug},
 number = {},
 pages = {864-867},
 title = {A Real-Time Isoline Tracing Algorithm Based on CUDA},
 volume = {},
 year = {2011}
}
