@article{LU2026187171,
 abstract = {Research on two-dimensional tin chalcogenides has gained considerable momentum due to their tremendous potential in advancing semiconductor technologies. The emergence of integrated architectures, particularly design-tailored heterojunctions and multilayer composites, has further invigorated this field. In this study, we synthesized a series of layered SnSe-SnSe2 composite semiconductors with controlled chemical compositions using a hybrid technique that merges solid-state and gas-phase reactions. The resulting layered framework is inherited by the stacking of hexagonal SnSe2 along the crystallographic c-axis, with orthorhombic SnSe oriented perpendicular to the (100) plane. As the SnSe2 concentration increases, the composites undergo a progressive contraction of the indirect bandgaps, accompanied by a rise in Urbach energy. The lattice compatibility and alternating arrangement of p-type SnSe and n-type SnSe2 foster the formation of dense quasi-p-n heterojunction arrays, promoting Fermi level equilibration. Remarkably, a transition from p-type to n-type semiconductor behavior occurs at higher SnSe2 ratios. These findings establish a foundation for the rational design and integration of layered tin chalcogenides, facilitating phase-engineered optical bandgap tuning and advancing the development of related device applications.},
 author = {Hong Lu and Haotong Zang and Siyuan Zhao and Yusheng Qiao and Wei An and Eryun Yan and Penghao Sang},
 doi = {https://doi.org/10.1016/j.jallcom.2026.187171},
 issn = {0925-8388},
 journal = {Journal of Alloys and Compounds},
 keyword = {Layered semiconductor, Tin chalcogenide composites, Optical bandgap, Phase engineering, Fermi level equilibration},
 pages = {187171},
 title = {Fermi level equilibration and phase-engineered optical bandgap in layered SnSe-SnSe2 composite semiconductors},
 url = {https://www.sciencedirect.com/science/article/pii/S0925838826012399},
 volume = {1059},
 year = {2026}
}
