 abstract = {With the widespread popularization of technologies such as mobile Internet, big data and artificial intelligence, massive data generated by various types of smart terminals are collected and analyzed by service providers, thereby improving service quality. However, the raw data of terminals contain sensitive information, and direct collection poses the risk of privacy leakage. As a recognized privacy protection standard, local differential privacy can provide strict and provable privacy protection under the premise that attackers have arbitrary background knowledge and computational power, and has less computational overhead and communication overhead. In the framework of local differential privacy, this paper investigates range queries as a fundamental task for data analysis and data mining. We propose the Adaptive Merging Grid (AMG) algorithm that provides strict privacy protection for data contributors while providing range query results with higher accuracy for query users. Since the existing methods targeting range queries are either difficult to choose the appropriate grid granularity or limited by the hierarchical structure. Therefore, this paper proposes to construct an adaptive merging grid by choosing the interval merging size and position reasonably to obtain more accurate frequency distribution data. Sufficient experimental results on real datasets show that the algorithm proposed in this paper outperforms the existing work for range query.},
 author = {Hu, Dazhi and Wang, Biyou and Zhao, Ping},
 booktitle = {2025 10th International Conference on Cyber Security and Information Engineering (ICCSIE)},
