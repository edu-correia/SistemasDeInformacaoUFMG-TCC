@article{11433396,
 abstract = {An absorber is implemented with the perturbed leafy structure of resonator made of phase change material, vanadium dioxide (VO ${}_{2}$ ) to obtain the multiple resonances in terahertz (THz) frequency domain. The quality factor of resonances can be controlled through thermal variation in dispersive properties of VO2. The resonances with high-quality factor can be excited in insulating phase of VO2 to achieve the multiple narrow absorption bands. The quality factor of excited resonances can be thermally tuned to lower values in the metallic phase of VO2 which merges their spectrum to provide a broad absorption band. Thus, absorber can provide a thermally switchable absorption spectrum from broad to nine narrow absorption peaks within frequency range from 3 to 8 THz using ultrathin geometry of thickness around  $\lambda /8$ ;  $\lambda $  is free space wavelength. The absorber structure is numerically analyzed and operation is validated through transmission line method prepared using circuit theory approach.},
 author = {Kishore, Kamlesh and Varshney, Gaurav},
 doi = {10.1109/TPS.2026.3669965},
 issn = {1939-9375},
 journal = {IEEE Transactions on Plasma Science},
 keyword = {Absorption;Q-factor;Resonant frequency;Dispersion;Dielectrics;Conductivity;Terahertz communications;Impedance;RLC circuits;Thermal factors;Absorber;dispersive;terahertz (THz);thermal conductivity;tunable;vanadium},
 month = {April},
 number = {4},
 pages = {1745-1749},
 title = {Thermal Dispersive Variation in Quality Factor of Resonances for Broad and Multiband THz Absorber},
 volume = {54},
 year = {2026}
}
