@article{CHEN2026100436,
 abstract = {Summary
Magnetic topological materials integrate topological electronic structures with magnetism, offering a promising platform for exploring novel physical phenomena and advancing next-generation spintronic devices. Given the rapid progress in this field, a comprehensive review is both timely and essential. This review covers the theoretical models of magnetic topological insulators; their associated phenomena, such as the quantum anomalous Hall effect, axion-insulating states, and topological phase transitions; and their potential applications, including spin-orbit torque-guided magnetization switching and artificial neural networks. Additionally, it discusses the Berry curvature-driven giant anomalous Hall effect and topological Hall phenomena observed in magnetic topological semimetals.},
 author = {Peng Chen and Hang Chi and Jagadeesh S. Moodera},
 doi = {https://doi.org/10.1016/j.newton.2026.100436},
 issn = {2950-6360},
 journal = {Newton},
 keyword = {magnetic topological materials, magnetic topological insulators, magnetic topological semimetals},
 pages = {100436},
 title = {Progress and prospects of magnetic topological materials for spintronic applications},
 url = {https://www.sciencedirect.com/science/article/pii/S2950636026000381},
 year = {2026}
}
