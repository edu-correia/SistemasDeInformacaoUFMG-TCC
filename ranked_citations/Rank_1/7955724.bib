@inproceedings{7955724,
 abstract = {A novel printed loop antenna is designed introducing a C-shape portion to the left arm of the circular loop antenna. The proposed antenna gives frequency range from 3.5 to 6.20 GHz. It is observed that lower frequency band depends on the C-shaped structure of circular loop antenna. However, the upper frequency band depends on the coupled tapered transmission line. Balun transformer of Z=50Ω to 80Ω is merged with the proposed antenna to enhance the bandwidth having frequency range of 2.7 to 7.1 GHz. Antenna is designed on FR4 substrate and can be used for various application such as ISM band, WLAN band and UWB application.},
 author = {Singh, Ravish R and Diwakar, Surendra P and Shastri, Shailendra},
 booktitle = {2016 International Conference on Signal Processing, Communication, Power and Embedded System (SCOPES)},
 doi = {10.1109/SCOPES.2016.7955724},
 issn = {},
 keyword = {Bandwidth;Power transmission lines;Impedance;Transmission line antennas;Signal processing;Circular Loop Antenna;Bandwidth Enhancement;Tapered transmission lines},
 month = {Oct},
 number = {},
 pages = {1660-1663},
 title = {Design of circular loop antenna with step change in loop width},
 volume = {},
 year = {2016}
}
