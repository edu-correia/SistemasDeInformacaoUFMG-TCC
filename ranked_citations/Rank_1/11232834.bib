@inproceedings{11232834,
 abstract = {Adaptive recommendation in the fashion space demands systems that can keep up with changing trends and user-specific contexts. This study presents a practical solution that merges Retrieval-Augmented Generation (RAG) with realtime vector similarity search to offer fashion suggestions that are both relevant and style-conscious. By converting product details such as descriptions and titles into high-dimensional vectors using transformer-based models and indexing them with FAISS, the system can quickly match them to user queries framed in natural language. To ensure the suggestions reflect real-world fashion needs like occasion, colour, and style, a generative language model refines the retrieval results with contextual awareness. The system also handles image-based inputs by incorporating CLIP-generated visual embeddings, making it useful for multimodal search. Tests run on a fashion dataset with over 40,000 labelled items show strong improvements in precision, diversity, and how well the recommendations match user context. These findings point toward a promising approach for building responsive and inclusive fashion recommendation tools by blending vector search with generative AI.},
 author = {E, Saranya. and B, Sabarinathan. and M, Mohaideen Arsath. and C, Shri Khishore. J and R, Sri Gurusankar.},
 booktitle = {2025 International Conference on Intelligent Communication Networks and Computational Techniques (ICICNCT)},
 doi = {10.1109/ICICNCT66124.2025.11232834},
 issn = {},
 keyword = {Visualization;Adaptive systems;Image color analysis;Retrieval augmented generation;Natural languages;Transformers;Market research;Vectors;Real-time systems;Indexing;fashion recommendation;retrieval-augmented generation;vector similarity search;multimodal embeddings},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Adaptive Fashion Recommendation Using Retrieval-Augmented Generation and Real-Time Vector Search},
 volume = {},
 year = {2025}
}
