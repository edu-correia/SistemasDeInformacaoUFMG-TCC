@inproceedings{5116343,
 abstract = {Capson proposed a run-based boundary extraction algorithm which can extract boundaries in one raster scan, the algorithm is very suitable for pipeline and parallel processing and can achieve high performance, but it has two problems which limit its application, one is the distortion at concave potion of the boundaries, and another is that it dose not address how to produce the detailed boundaries. This paper intends to solve the two problems respectively by introducing splitting point and merging point and by skillfully designing an extended data structure to produce both the 4-connected and 8-connected detailed boundaries expediently, and an improved algorithm is proposed to implement the fast and exact boundaries extraction. Experimental results show that the improved algorithm runs faster in comparison with the other two algorithms in ref..},
 author = {Hu, Tao and Guo, Baoping},
 booktitle = {2009 International Conference on Industrial and Information Systems},
 doi = {10.1109/IIS.2009.73},
 issn = {},
 keyword = {Data mining;Pipelines;Parallel processing;Merging;Algorithm design and analysis;Data structures;Pattern recognition;Information systems;Image coding;Application software;boundary extraction;RLE;splitting point;merging point;turning-points;pattern recognition},
 month = {April},
 number = {},
 pages = {240-243},
 title = {An Improved Run-Based Algorithm for Fast and Exact Boundary Extraction},
 volume = {},
 year = {2009}
}
