@inproceedings{11501881,
 abstract = {We present a compact substrate-integrated wearable antenna that simultaneously provides continuous frequency tuning and selectable orthogonal linear polarizations to improve communication reliability in dense and dynamic IoT environments. The proposed design merges two quarter-mode substrate-integrated waveguide (QMSIW) structures into a single aperture-shared radiating patch and uses PIN switches and varactor tuning to realize mode selection and continuous frequency agility. A PIFA mode extends the lower band coverage while sharing the same feed. Measurements on fabricated prototypes validate a 34% tuning range (1.83-2.58 GHz) and polarization switching at $\pm \text{4 5}^{\circ}$ in the QMSIW states. Its compact form ($70 ~\text{mm} \times 70 ~\text{mm} \times 1.57 ~\text{mm}$) and substrate-integrated packaging make it a practical option for wearable IoT modules.},
 author = {Yang, Xiantao and Wong, Sai-Wai and He, Yejun and Huang, Yi and Zhu, Lei},
 booktitle = {2026 IEEE International Workshop on Antenna Technology (iWAT)},
 doi = {10.1109/iWAT66946.2026.11501881},
 issn = {2770-4254},
 keyword = {Telemetry;Aerospace and electronic systems;Antennas;Wearable antennas;Apertures;Antenna radiation patterns;Antennas and propagation;Feeds;Textile antennas;Radio broadcasting;Communication reliability;interference;Internet of Things (IoT);substrate integrated antennas;wearable antennas},
 month = {March},
 number = {},
 pages = {1-3},
 title = {A Compact Multimode Wearable Antenna with Polarization and Frequency Agility for Future Advanced Internet of Things Applications},
 volume = {},
 year = {2026}
}
