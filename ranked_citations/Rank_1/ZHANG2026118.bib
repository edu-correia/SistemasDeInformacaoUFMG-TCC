@article{ZHANG2026118,
 abstract = {Managing tensions and conflicts in sales-marketing relationship plays a pivotal role in organizations' successful interactions with business customers. This paper investigates how digitalization creates tensions and task conflict at sales-marketing interface (SMI), as well as how B2B firms alleviate tensions and task conflict between sales and marketing functions at pre-tension stage and tension stage. Based on questionnaire survey among 534 B2B companies, the research findings reveal that firm's digitalization generates information-based and power-based tensions at SMI, leading to task conflict between sales and marketing functions. In addition, at the pre-tension stage, cross-functional integration and perceived usefulness of digital tools weaken the link between digitalization and SMI tensions, except that formal integration does not moderate the digitalization and information-based tension link; at the tension stage, cooperative management strategies alleviate the link between SMI tensions and task conflict, while competitive management strategies reinforce the impact of information-based tension on task conflict at SMI. This paper contributes to the SMI and digitalization literature by merging these two research streams and revealing potential negative consequences of digitalization from cross-functional perspective. It also provides managerial implications for B2B firms on how to manage the SMI tensions and conflict caused by firm's digitalization.},
 author = {Jing Zhang and Ei Ei Nyein and Monica Ren},
 doi = {https://doi.org/10.1016/j.indmarman.2026.02.017},
 issn = {0019-8501},
 journal = {Industrial Marketing Management},
 keyword = {Digitalization, Sales-marketing interface (SMI), Information-based tension, Power-based tension, Task conflict},
 pages = {118-133},
 title = {How to cope with conflicts at sales-marketing Interface in the context of B2B firm's digitalization: A tension-based view},
 url = {https://www.sciencedirect.com/science/article/pii/S0019850126000386},
 volume = {134},
 year = {2026}
}
