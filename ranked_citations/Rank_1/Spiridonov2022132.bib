@article{Spiridonov2022132,
 abstract = {The problem of creating a non-conflict aircraft queue from several incoming flows is considered in the situation of a cascade merge. In this case, groups of flows merge at their joining points, and further the resultant flows merge at some other points. Such a consideration covers, for example, an entire scheme of incoming aircraft flows of an airport zone, as well as taking into account the arriving and departing aircraft. This problem is formalized in the framework of mixed integer linear programming and is solved using the optimization library Gurobi. An approach is proposed to control the permutations of aircraft of the same type within one flow. A series of numerical simulations is carried out. They include both some model examples illustrating the ideas of the algorithm and statistical modeling to estimate the performance of the proposed procedure. © 2022, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Spiridonov, Arseniy A. and Kumkov, Sergey S.},
 doi = {10.1007/978-3-031-16224-4_9},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 2},
 pages = {132 - 146},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cascade Merge of Aircraft Flows as Mixed Integer Linear Programming Problem},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85140443032?origin=resultslist},
 volume = {1661 CCIS},
 year = {2022}
}
