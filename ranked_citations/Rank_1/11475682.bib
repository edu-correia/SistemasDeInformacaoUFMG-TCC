@article{11475682,
 abstract = {This paper presents a low-voltage, ultra-low-power multi-mode CMOS GNSS RF receiver fabricated in 28nm CMOS. Two key technologies are proposed for this design: a Gm-C RF quadrature-signal generator and a folded floating current mirror, aiming to systematically reduce power dissipation and overcome the obstacles to implementing ultra-low voltage IF amplifiers. Specifically, the RF quadrature current generator is embedded within the gm stage of a passive mixer, where the frequency-translation-induced virtual AC ground significantly mitigates phase mismatch in the I&Q paths. The virtual ground also suppresses current leakage due to parasitic capacitors and impedances, thereby improving the phase balance. Amplitude balance is well maintained through interstage bias current regulation, achieving a 40-dB IRR. To further optimize power efficiency, the mixer switches are merged into the VCO. This integration physically eliminates both the quadrature frequency divider by two and the LO buffer, thereby fully eliminating their associated power consumption. Additionally, to address the cramp voltage headroom issues of the IF circuit under low-voltage operation, a low voltage class-AB OTA based on the folded floating current mirror is proposed. This circuit serves as the fundamental OTA for both the filter and the IF amplifier. Ultimately, the entire GNSS receiver achieves a minimum supply voltage of 0.65 V and a power consumption of only 2 mW—ranking among the most energy-efficient GNSS RF receivers reported. Concurrently, it achieves competitive performance metrics including 3.2 dB NF, −5 dBm OB-IIP3, −164 dBm tracking sensitivity and −148 dBm acquisition sensitivity.},
 author = {Chen, Chao and Xiang, Wenchen and Su, Xiaodong and Chen, Jiuchun},
 doi = {10.1109/TCSI.2026.3679351},
 issn = {1558-0806},
 journal = {IEEE Transactions on Circuits and Systems I: Regular Papers},
 keyword = {Jamming;Synthetic aperture sonar;Electronic warfare;Phased arrays;Frequency modulation;Frequency shift keying;Circuits;Circuits and systems;Capacitors;Voltage multipliers;Ultra-low power;ultra-low-voltage;GNSS RF receiver;quadrature-current-generator;Gm-C;IRR;phase and amplitude balance;folded-floating-current-mirror;class-AB driver},
 month = {},
 number = {},
 pages = {1-13},
 title = {A 0.65-V 2-mW Multi-Mode CMOS GNSS Receiver With Gm-C RF Quadrature-Current-Generation Technique and Folded Class-AB Amplifier},
 volume = {},
 year = {2026}
}
