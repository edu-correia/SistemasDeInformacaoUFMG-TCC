@conference{Wang2011702,
 abstract = {As biomedical data grows rapidly nowadays, we are going to study how to efficiently apply cloud computing into biomedical problem. In this paper, the process of solving biomedical problem based on cloud computing is presented. First, the biomedical issue would be focus on the gene match and generation of large amount of the emulated data from real data. Second, a mathematical model is proposed to describe the problem. Third, the mathematical model is implemented into our MapReduce model, which means simulating the biomedical application rested on cloud computing. Finally, some experiments are conducted to test the performance of cloud computing on this issue. Besides, at the end of the paper, some advices are given to doctors and biomedical scientists. © 2011 IEEE.},
 author = {Wang, Zhiqiong and Chen, Hao and Huang, Yalu and Xu, Yu and Yang, Longwei and Xiao, Jingjing},
 doi = {10.1109/CSAE.2011.5952601},
 journal = {Proceedings - 2011 IEEE International Conference on Computer Science and Automation Engineering, CSAE 2011},
 note = {Cited by: 1},
 pages = {702 - 706},
 publication_stage = {Final},
 source = {Scopus},
 title = {Efficient similarity search on massive gene data based on cloud computing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/80051910422?origin=resultslist},
 volume = {2},
 year = {2011}
}
