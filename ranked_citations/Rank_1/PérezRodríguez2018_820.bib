@article{PérezRodríguez2018_820,
 abstract = {Abstract This work has as main objective to expose the unification of the analysis of the functional requirements of mechatronic products, in an integrated reference model of Product, Process and Manufacturing Systems. The scope of the research is defined in the conceptual design stage of mechatronic products, aimed at improving the design process. The Kano, QFD, DSM and CAD methods were used. The main result was the integration of the analysis of the functional requirements in the conceptual design of mechatronic products, using computational tools (CAD/CAM/CAE). The effectiveness of the use of the methodological tools of product design combined with computational tools in the area of mechatronics was demonstrated.},
 author = {Pérez-Rodríguez, Roberto and Molina, Arturo and Miranda, Jhonattan and Borja, Vicente and Wright, Paul K.},
 number = {3},
 pages = {145--152},
 title = {The requirements specification of mechatronic products based-on the Integrated product, process and manufacturing development model},
 volume = {21},
 year = {2018}
}
