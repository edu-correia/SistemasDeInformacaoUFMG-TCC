@conference{Nisha2025,
 abstract = {The expansion of 5G communication and the rise of wearable technologies have driven the need for compact, flexible, and efficient antenna systems. This paper presents the design and implementation of a textile-based broadband antenna for 5 G wearable applications, using denim fabric as the dielectric substrate. The antenna employs a 0.5 mm thick denim layer for its mechanical flexibility and comfort, making it suitable for integration into clothing. As the conductive material, graphene ink is utilized due to its high conductivity, lightweight nature, and compatibility with textile surfaces, ensuring reliable RF performance without compromising wearability. This multidisciplinary integration supports both high-speed 5G communication and low-power applications in a wearable format. Simulation and prototyping validate the antenna's performance, demonstrating acceptable gain, radiation efficiency, and flexibility. The resulting system shows promise for applications in smart healthcare, environmental monitoring, and emergency response, providing users with realtime data transmission over vast distances while maintaining comfort and wearability. This paper contributes toward the development of advanced wearable systems that merge communication, sensing, and smart textiles for next generation connected solutions.  © 2025 IEEE.},
 author = {Nisha, S.L. and Raga, Ganesh and Shivam, Kumar and Raga, Sarika Sunilraj},
 doi = {10.1109/ICMNWC66779.2025.11354441},
 journal = {5th IEEE International Conference on Mobile Networks and Wireless Communications, ICMNWC 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Design and Implementation of Textile-Based Broadband Antenna for 5G Wearable Applications},
 type = {Conference paper},
