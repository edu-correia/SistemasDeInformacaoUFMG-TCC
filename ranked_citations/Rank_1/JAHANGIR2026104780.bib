@article{JAHANGIR2026104780,
 abstract = {Image dehazing for remote sensing involves removing atmospheric haze from satellite images to recover a single, clear, and informative scene. Image dehazing is used for various purposes, including improving visibility, environmental monitoring, land use analysis, and disaster assessment. However, dehazing approaches frequently encounter challenges such as inaccurate estimation of haze thickness under varying illumination, over-smoothing of fine details, difficulty in handling dense haze regions, loss of true color fidelity, artifacts near object boundaries, and poor generalization across diverse hazing conditions. Solving these challenges is essential to developing efficient dehazing techniques that produce high-quality results across diverse remote sensing scenarios. The proposed technique introduces DSGM-NET, a U-Net-style architecture that addresses artifacts and fidelity in image dehazing. The method employs Depthwise Separable Convolutions (DSC) to extract efficient spatial and channel features, and a Multi-Scale Feature Module (MSFM) that captures fine textures, mid-level structure, and coarse haze through parallel convolutional branches. A Multi-Scale Perception block with Large Convolution Kernels (MSPLCK) expands the receptive field using dilated depthwise convolutions to capture global haze patterns, and channel and spatial attention branches compute per-channel and per-location importance weights. The features are adaptively merged using a Dynamic Gated Fusion Block (DGFB), followed by a final projection that predicts a residual correction which is added to the input to form the reconstructed image. The proposed method is thoroughly evaluated on the synthetic Haze1K dataset. Quantitative and qualitative results show that DSGM-Net delivers consistent improvements in fidelity and perceptual quality compared to several existing dehazing models.},
 author = {Kashif Jahangir and Benish Amin and Komal Nain Sukhia},
 doi = {https://doi.org/10.1016/j.jvcir.2026.104780},
 issn = {1047-3203},
 journal = {Journal of Visual Communication and Image Representation},
 keyword = {Remote sensing, Image dehazing, Deep learning, U-Net, Depthwise separable convolution (DSC), Multi-scale feature module (MSFM), Large convolution kernels (MSPLCK), Dynamic gated fusion block (DGFB), Attention mechanism},
 pages = {104780},
 title = {DSGM-NET: A depthwise separable and gated multi-scale network for remote sensing image dehazing},
 url = {https://www.sciencedirect.com/science/article/pii/S1047320326000751},
 volume = {117},
 year = {2026}
}
