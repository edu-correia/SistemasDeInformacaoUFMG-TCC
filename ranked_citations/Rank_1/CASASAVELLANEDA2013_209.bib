@article{CASASAVELLANEDA2013_209,
 abstract = {Smartphones currently have a large number of sensors and more processing capacity, allowing greater integration of a mobile architecture supported by an external Location Based System. The following paper will contextualize the architecture in a nature inventory with a strong mobile component in the data collection on site. It will integrate additional technologies like GPS, QR Codes and map deployment through the LBS.},
 author = {CASAS-AVELLANEDA, DIEGO A. and LÓPEZ-PARRA, JAVIER F.},
 number = {180},
 pages = {9--15},
 title = {A MOBILE ARCHITECTURE FOR INTEGRATION OF SMARTPHONES WITH LBS FOR FLORA AND FAUNA INVENTORIES},
 volume = {80},
 year = {2013}
}
