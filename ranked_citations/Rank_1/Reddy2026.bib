@conference{Reddy2026,
 abstract = {Big Data and Cloud Computing have become essential technologies in the IT industry as massive volumes of data are generated daily from diverse sources. These datasets are large, fast-moving, and varied, making them difficult for traditional processing tools to manage. Big Data focuses on storing, processing, and analyzing these large and complex datasets, while Cloud Computing provides scalable, cost-effective infrastructure to support such operations. Many sectors, including business, healthcare, and education, leverage Big Data to improve decision-making and operational efficiency. In healthcare, it helps reduce treatment costs, predict disease outbreaks, and support preventive care. The proposed system uses a serverless data warehouse to enable flexible and scalable analytics. Platform as a Service (PaaS) offers advanced querying capabilities that simplify data management and processing. A detailed experimental study was conducted using real-world datasets to measure average read, compute, and write times across multiple dataset sizes, evaluating system performance in different scenarios. To ensure reliability and visibility, the system integrates robust monitoring and centralized logging to track resource consumption, query performance, and service health in real time. These features help in early detection of issues, efficient debugging, and continuous performance optimization. This study also compares ETL and ELT approaches for real-time data processing. Experimental results demonstrate that ELT achieves lower latency and higher throughput than ETL, improving scalability and efficiency in large-scale streaming data scenarios. The proposed ELT-based methodology achieves up to 12% higher processing efficiency and reduces latency by 35% compared to traditional ETL, demonstrating its suitability for scalable and real-time analytics.  © 2026 IEEE.},
 author = {Reddy, M. Venkata Krishna and Kumar, P. Vineeth and Ramu, S. China},
 doi = {10.1109/CCIC68129.2026.11486031},
 journal = {CCIC 2026 - Contemporary Computing Innovations Conference 2026},
