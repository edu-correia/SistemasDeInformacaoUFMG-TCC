@inproceedings{11484566,
 abstract = {The reason for the failure of classical cryptographic techniques is the threats caused by quantum computers. This increases the demands of a quantum resistant system that can prevent the attacks in critical fields like military, IoT and more. In return to this, the study introduces an adaptive hybrid postquantum cryptographic way that merges Kyber (a lattice-based KEM) with BIKE (a code-based KEM) to construct a resilient encryption system which can withstand both traditional and quantum-era threats. By combining the complementary advantages of both algorithms-Kyber’s conciseness and BIKE’s high performance-the hybrid enables trust-weighted key derivation, fallback resilience, and compression-enabled performance tuning. Intended with constrained devices and future-proofing in mind, the presented system ensures robust data confidentiality and integrity in next-generation secure communication, including IoT and embedded systems. Experimental findings and architectural presentation explains its practical use and research potential.},
 author = {Tandey, Shreyansh and Dilliwar, Kislay and Singh, Dilpratap and Mazumdar, Sagnik and Sahu, Kamna and Vollala, Satyanarayana},
 booktitle = {2026 International Conference on Emerging Technologies and Future Innovations (ETFI)},
 doi = {10.1109/ETFI68128.2026.11484566},
 issn = {},
 keyword = {Low earth orbit satellites;Very large scale integration;Internet of Things;Communication systems;Internet;Protocols;Computer networks;Cloud computing;HTTP;Data communication;Post-Quantum Cryptography;Hybrid KEM;Kyber;BIKE;Secure Communication;Embedded Security;Cryptography from Lattice Hardness Assumptions;Cryptography Based on Error-Correcting Codes},
 month = {Feb},
 number = {},
 pages = {1-6},
 title = {Adaptive Hybrid Post-Quantum Cryptography with Kyber and BIKE for Secure Communication},
