@article{Galimberti2025,
 abstract = {Photographic methodologies are increasingly being integrated into biometric systems for identification and detection purposes. These systems leverage the capabilities of photographic and post-photographic interfaces to merge seamlessly with our body-mind continuum. Through analyzing artistic case studies, this paper advocates for a critical engagement with this transparency effect. By examining Trevor Paglen’s artwork Faces of ImageNet, the Peng! Collective’s hacking project Mask.ID, and Rafael Lozano-Hemmer’s installations, we explore the vulnerabilities of biometric identification systems and highlight the political implications of these technologies. This paper argues that these artistic interventions provide valuable insights into the critical potential of engaging with the transparency and opacity of biometric systems. Through these case studies, we aim to challenge the perceived neutrality and objectivity of photographic technologies, advocating for a more nuanced and informed discourse on their impacts on human identity. ©2025, Giulio Galimberti, Samuele Sartori.},
 author = {Galimberti, Giulio and Sartori, Samuele},
 doi = {10.7238/artnodes.v0i35.429000},
 journal = {Artnodes },
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 number = {35},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Personal identity and transparent media. Retooling, hacking and artistic détournements; [Identidad personal y medios transparentes. Retooling (reequipamiento), hacking y détournements artísticos]},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85217040148?origin=resultslist},
