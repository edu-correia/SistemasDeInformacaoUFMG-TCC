@conference{Lin2025244,
 abstract = {Virtual coupling is a promising technology for improving the efficiency, safety, and flexibility of autonomous train operations. This paper presents an Optimal Control Enhanced Reinforcement Learning (OCE-RL) framework designed to coordinate multiple trains under virtual coupling constraints. The proposed framework combines Reinforcement Learning (RL) with Model Predictive Control (MPC) to enable real-time adaptation between long-term trajectory planning and short-term motion optimization. To support the dynamic modeling of inter-train interactions, the system incorporates a moving baseline Real-Time Kinematic (RTK) positioning scheme, which provides high-precision relative position and velocity information essential for convoy-level coordination. The OCE-RL algorithm is evaluated through simulation experiments under various operating conditions. Results show that the framework achieves improved performance in speed synchronization, relative velocity regulation, and inter-train distance control. Compared to conventional control strategies, the proposed method demonstrates stronger adaptability and stability in dynamic environments. These findings highlight the effectiveness of the OCE-RL framework for virtual coupling control and its potential application in next-generation intelligent rail systems.  © 2025 IEEE.},
 author = {Lin, Wei and Zhao, Yang and Huang, Susu and Gao, Hongmin and Zhang, Miao and Xu, Dengke},
 doi = {10.1109/ICIRT66379.2025.11216770},
 journal = {2025 IEEE International Conference on Intelligent Rail Transportation, ICIRT 2025},
 note = {Cited by: 0},
 pages = {244 - 249},
 publication_stage = {Final},
 source = {Scopus},
 title = {An OCE-RL Framework for Coordinated Control of Autonomous Train Virtual Coupling},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105025166759?origin=resultslist},
 year = {2025}
