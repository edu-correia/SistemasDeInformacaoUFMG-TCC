@article{Le2019124,
 abstract = {Recently, the number of mobile users grow enormously. Even though hardware technologies have been taken to many advantages, which aim at increasing the battery capacity, people are still facing with the problem of battery shortage. An application that runs functionally correct and has a friendly graphic user interfaces still causes users frustrated if it drains the battery. In parallel with increasing the energy storage capability of mobile device, optimizing the source code to reduce power consumption is an emerging topic. This paper presents a new approach to modeling and evaluating power consumption of mobile applications. First, we introduce new definitions of power states and a power consumption automaton (PCA) for a hardware component. In the next step, we propose algorithms to optimize and merge these into an unified automaton. In order to estimate the power consumption amount, the power automaton is refined with time aspect and power coefficients. Finally, we develop a support tool, which is a plug-in for Android studio and IntelliJ for visualizing the power machines and estimating the accumulated power consumption of an application use-case. © 2018, Springer Science+Business Media, LLC, part of Springer Nature.},
 author = {Le, Hong Anh and Bui, Anh Tu and Truong, Ninh-Thuan},
 doi = {10.1007/s11036-018-1138-4},
 journal = {Mobile Networks and Applications},
 note = {Cited by: 7},
 number = {1},
 pages = {124 - 133},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Approach to Modeling and Estimating Power Consumption of Mobile Applications},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85055968203?origin=resultslist},
 volume = {24},
 year = {2019}
}
