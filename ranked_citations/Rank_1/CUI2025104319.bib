@article{CUI2025104319,
 abstract = {Steel bridge piers offer some significant structural advantages, thus they are widely used in the construction of urban viaducts and pedestrian bridges. However, bridge fire disasters are extremely common, especially fires caused by incidents involving hazardous chemical transport such as fuel oil. This study examines the flame behavior of pool fires surrounding a centrally positioned hollow steel column, a configuration relevant to bridge piers vulnerable to fuel fires. The experimental matrix systematically varied three pool diameters (180 mm, 220 mm, and 260 mm), three column diameters (60 mm, 90 mm, and 120 mm), and five column heights (200 mm, 400 mm, 600 mm, 800 mm, and 1000 mm). Experimental results show that annular pool fires transition to a merged flame state when the column’s outer diameter and height fall below critical thresholds. Flame height followed a non-monotonic relationship with column height, exhibiting a critical range between 400 mm and 600 mm. This behavior is attributed to competing thermal effects: heat conduction enhancing fuel feedback versus external heat dissipation reducing flame height. A modified flame height model incorporating column dimensions is proposed, improving accuracy over Thomas’s original equation. Flame merging probability was systematically quantified based on column diameter, height, and pool size, leading to a piecewise predictive function and critical threshold criteria. These findings support improved fire-risk assessment and suppression strategies for hollow-pier structures.},
 author = {Jinrong Cui and Ranran Li and Qiaosheng Hu and Manhou Li},
 doi = {https://doi.org/10.1016/j.tsep.2025.104319},
 issn = {2451-9049},
 journal = {Thermal Science and Engineering Progress},
 keyword = {Pool fire, Steel column, Flame height, Merging probability, Heat transfer},
 pages = {104319},
 title = {Experimental study on flame height and merging probability of n-heptane pool fire with centrally-positioned hollow steel column},
 url = {https://www.sciencedirect.com/science/article/pii/S2451904925011102},
 volume = {68},
 year = {2025}
}
