@conference{Bakhtiar2025778,
 abstract = {High bandwidth memory (HBM) equipped sparse accelerators are emerging as a new class of accelerators that offer concurrent accesses to data and parallel execution to mitigate the memory bound behavior of sparse kernels. However, because of their underlying non-zero scheduling scheme, state-of-the-art HBM-based sparse accelerators (e.g., Serpens) suffer from high resource underutilization causing suboptimal performance, and inefficiency. To solve this challenge, we propose ChasoÅ, an HBM-based streaming accelerator for sparse kernels, specifically sparse matrix vector multiplication. ChasoÅ supports our novel non-zero scheduling scheme called Cross-HBM Channel out-of-order (OoO) Scheduling (CrHCS) to enable data migration across HBM channels and mitigate resource underutilization. We implement ChasoÅ on AMD Alveo U55C, achieving 301MHz clock frequency and evaluate it based on SuiteSparse and SNAP matrix collections. ChasoÅ improves the resource utilization and achieves up to 8 ×, 20.33 ×, 11.65 ×, and 2.67 × performance improvement and 2.03 ×, 34.72 ×, 19.48 ×, and 14.61 × better energy efficiency over Serpens, Nvidia RTX 4090, Nvidia RTX 6000 Ada, and Intel Core i9-11980HK, respectively. The source code of ChasoÅ is available at https://github.com/UbaidHunts/Chason. © 2025 Copyright held by the owner/author(s).},
 author = {Bakhtiar, Ubaid and Namjoo, Amirmahdi and Asgari, Bahar},
 doi = {10.1145/3725843.3756086},
 journal = {Proceedings of the Annual International Symposium on Microarchitecture, MICRO},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {778 - 794},
 publication_stage = {Final},
 source = {Scopus},
 title = {ChasoÅ: Supporting Cross HBM Channel Data Migration to Enable Efficient Sparse Algebraic Acceleration},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105021324401?origin=resultslist},
 volume = {Part of 213862},
 year = {2025}
}
