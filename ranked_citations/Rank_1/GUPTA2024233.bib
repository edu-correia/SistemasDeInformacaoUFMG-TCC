@incollection{GUPTA2024233,
 abstract = {A significant problem that calls into question the animal models used in basic research is their inability to anticipate therapeutic responses in humans. Owing to multiple uses of organ on chip technology (OoCT) especially in personalized healthcare, these “tissue chips” have generated a great deal of attention in recent years. In regulated, dynamic microenvironments called “organs-on-chips,” cultured cells display behaviors that mimic the physiology of organs. Precision medicine, which combines the personalized aspects of medical technology with physiologically applicable read-outs, clears the way for individual drug safety/efficacy evaluations and personalized approaches to prevention of disease and therapeutics. Multiorgan chip complexes also enable the dynamic and systematic merging of more intricate sets of customized cell culture parameters. Precision medicine as such has not yet been applied to the current generation of customized OoC. The main obstacles preventing the adoption of OoC in precision medicine are limited approach to individual samples/health data, and getting data on patient outcomes for validation of the predictive value of personalized organ on a chip. The authors of this chapter advocate fusing contemporary genetics research with Ayurvedic ideas from Ayurgenomics, such as Prakriti. The advancement of Ayurgenomics could significantly enhance “P4 medicine (predictive, preventive, personalized, and participatory)” by providing holistic theoretical view of the patient and a practical integration of traditional and contemporary therapeutic and preventive modules to enhance health. It links the interaction of the tridosha (Vata, Kapha, Pitta) with the development of particular genes and bodily traits. It also deciphers Ayurveda as a 5000-year-old branch of epigenetics that evaluates the doshas’ current condition and makes tailored dietary and lifestyle suggestions to advance OoCT in precision medicine. The purpose of the Prakriti in personalized medicine is discussed in this chapter, along with integration strategies with programs for drug research and discovery.},
 author = {Vikas Gupta and Ravinder Sharma and Renu Bansal and Gunpreet Kaur and Sanjiv Kumar and Parveen Bansal},
 booktitle = {Human Organs-on-a-Chip Technology},
 doi = {https://doi.org/10.1016/B978-0-443-13782-2.00019-X},
 editor = {P.V. Mohanan},
 isbn = {978-0-443-13782-2},
 keyword = {Organs-on-a-chip, Ayurgenomics, microfluidic, Prakriti, personalized medicine},
 pages = {233-249},
 publisher = {Academic Press},
 title = {Chapter 12 - Organs-on-a-chip in precision medicine},
 url = {https://www.sciencedirect.com/science/article/pii/B978044313782200019X},
 year = {2024}
}
