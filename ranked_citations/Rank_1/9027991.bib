@article{9027991,
 abstract = {A novel double gate snap-back free reverse-conducting insulated-gate bipolar transistor (RC-IGBT) is proposed in this article, which merges a trench field stop IGBT and a trench barrier diode in a monolithic device. The backside n-channel works at weak inversion mode in forward conduction state and can be automatically turned into strong inversion mode in the reverse conduction state. Therefore, bidirectional conduction capability with snapback free characteristics is achieved in the novel RC-IGBT. Performance comparison with conventional RC-IGBT is carried out based on Sentaurus device simulations, the results show that the novel RC-IGBT device in this article exhibits excellent overall performance in both IGBT and diode modes, the reverse recovery performance is significantly improved owing to the topside trench barrier structure and backside self-controlled carrier injection, compared to the conventional RC-IGBT, the proposed device demonstrates 32% lower Irrm and 63% lower trr.},
 author = {Liu, Zhihong and Sheng, Kuang},
 doi = {10.1109/TED.2020.2974781},
 issn = {1557-9646},
 journal = {IEEE Transactions on Electron Devices},
 keyword = {Logic gates;Insulated gate bipolar transistors;Performance evaluation;Anodes;Semiconductor diodes;Current density;Electric potential;Double gate;reverse-conducting insulated-gate bipolar transistor (RC-IGBT);reverse recovery;snapback-free;trench barrier},
 month = {April},
 number = {4},
 pages = {1705-1711},
 title = {A Novel Self-Controlled Double Trench Gate Snapback Free Reverse-Conducting IGBT With a Built-in Trench Barrier Diode},
 volume = {67},
 year = {2020}
}
