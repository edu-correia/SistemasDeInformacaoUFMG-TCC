@article{ZHANG2026105961,
 abstract = {Medical image segmentation constitutes a central task across numerous clinical applications, yet the creation of large-scale, fully annotated datasets remains both labor-intensive and costly. Scribble annotations provide an efficient weak-labeling alternative and substantially reduce annotation effort; however, their sparse nature and absence of boundary detail limit a model’s capacity to learn complete organ structures and fine anatomical contours, creating major challenges for segmentation network training. To mitigate these limitations, TABNet is introduced as a scribble-guided weakly supervised medical image segmentation framework that integrates two core components: the Triplet Augmented Self-recovery (TAS) module and the Boundary-aware Pseudo-labeling (BAP) module. Specifically, the TAS Module employs three complementary augmentation strategies in conjunction with a self-recovery objective to support comprehensive acquisition of medical priors. Intensity augmentation simulates subtle imaging variations and encourages the learning of micro-level texture cues; Cutout obscures essential organ regions, compelling the network to infer local anatomical structure; and jigsaw augmentation disrupts spatial topology, facilitating improved modeling of global anatomical relationships. In addition, the BAP module produces pseudo-labels by adaptively merging multi-branch predictions through loss-guided weighting and incorporates a boundary-aware loss to enhance contour precision, leading to more reliable pseudo-supervision and improved boundary representation. Extensive evaluations on the ACDC and MSCMRseg public datasets show that TABNet substantially surpasses leading state-of-the-art approaches in scribble-based weakly supervised segmentation.Notably, its performance remains competitive with fully supervised baselines, highlighting TABNet as an effective solution for achieving accurate medical image segmentation with scribble-level supervision. Source code is accessible at https://github.com/IPMI-NWU/TABNet.},
 author = {Peilin Zhang and Shaouxan Wu and Jun Feng and Zhuo Jin and Zhizezhang Gao and Jingkun Chen and Yaqiong Xing and Xiao Zhang},
 doi = {https://doi.org/10.1016/j.imavis.2026.105961},
 issn = {0262-8856},
 journal = {Image and Vision Computing},
 keyword = {Scribble-supervised, Medical image segmentation, Triplet augmentation self-recovery, Boundary-aware pseudo-labels},
 pages = {105961},
 title = {TABNet: A Triplet Augmentation Self-recovery framework with Boundary-aware Pseudo-labels for scribble-based medical image segmentation},
 url = {https://www.sciencedirect.com/science/article/pii/S0262885626000685},
 year = {2026}
}
