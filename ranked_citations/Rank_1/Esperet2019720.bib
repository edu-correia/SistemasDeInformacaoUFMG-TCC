@article{Esperet2019720,
 abstract = {We study a restricted form of list colouring, for which every pair of lists that correspond to adjacent vertices may not share more than one colour. The optimal list size such that a proper list colouring is always possible given this restriction, we call separation choosability. We show for bipartite graphs that separation choosability increases with (the logarithm of) the minimum degree. This strengthens results of Molloy and Thron and, partially, of Alon. One attempt to drop the bipartiteness assumption precipitates a natural class of Ramsey-type questions, of independent interest. For example, does every triangle-free graph of minimum degree d contain a bipartite induced subgraph of minimum degree Ω(log d) as d→∞? © 2019 Cambridge University Press.},
 author = {Esperet, Louis and Kang, Ross and Thomassé, Stéphan},
 doi = {10.1017/S0963548319000026},
 journal = {Combinatorics Probability and Computing},
 note = {Cited by: 16; All Open Access; Green Open Access; Hybrid Gold Open Access},
 number = {5},
 pages = {720 - 732},
 publication_stage = {Final},
 source = {Scopus},
 title = {Separation Choosability and Dense Bipartite Induced Subgraphs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85062210599?origin=resultslist},
 volume = {28},
 year = {2019}
}
