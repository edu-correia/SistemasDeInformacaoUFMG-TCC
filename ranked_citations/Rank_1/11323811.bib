 abstract = {Affective computing furnishes a compelling methodology for capturing human emotional dynamics via technological instrumentation, and its deployment within literary studies affords a hermeneutic lens sensitive to the emotional sediment literary texts impose upon readers. This investigation merges biosensor instrumentation and machinelearning algorithms to delineate and render intelligible the emotional traces provoked while participants read canonical and contemporary British literary works. Physiological modalities-heart-rate variability, electrodermal activity, and facial action units-are longitudinally registered from a heterogeneous cohort as they traverse poetic, narrative, and dramatic forms. The resultant multimodal data are parsed through deep-learning classifiers operating on tripartite emotional axes: valence, arousal, and ruminative engagement. Correlational and temporal analyses evince pronounced emotional transitions concordant with narrative schemata, character arcs, and moments of thematic condensation, elucidating the differential affective acquisition afforded by distinct literary configurations. The data further indicate that specific genres elicit prolonged affective attunement, underscoring affective computing's prospective contributions to curriculum design, dynamic narrative adaptation, and a more empathetic pedagogy within the humanities. This study integrates computational methods with literary criticism in order to render reader experience a measurable and ethically analysable object in humanistic inquiry. By employing affective-sensing technologies and machine-learning analytics, we trace how biometric responses correlate with narrative structures, illuminating the valences of literary engagement. Our findings support an emergent space where computational tools serve not to replace interpretation but to deepen it, encouraging a responsible interfacing of method and matter in the humanities.},
 author = {Gomathi, P. and Srinivasan, V. C. and Anuradha, M. and Ramachandran, M. and M P, Malavika and Kavinkumar, P.},
 booktitle = {2025 IEEE 5th International Conference on ICT in Business Industry & Government (ICTBIG)},
 doi = {10.1109/ICTBIG68706.2025.11323811},
 issn = {},
 keyword = {Biometrics;Affective computing;Humanities;Ethics;Protocols;Instruments;Scholarships;Machine learning;Physiology;Biosensors;Affective sensing;biosensor-derived emotion profiling;machine learning;narrative engagement mapping;ethically-informed human-computer scholarship},
 month = {Dec},
