@conference{Xin2019134,
 abstract = {In order to analyze highway construction area of the traffic safety, we collected the jinan to Qingdao highway's subgrade phase construction area from the video. The reconstruction is obtained by computer image recognition technology to identify microscopic data, and vehicle traffic conflict technique was used to research the factors affecting highway construction area of traffic safety and speed difference before and after the car, based on vehicle type. We also analyze the influence on traffic conflict, and the results show that when the car speed is less than the velocity, the probability of traffic conflict is decreased; When the speed of the rear vehicle is greater than that of the front vehicle, the probability of traffic conflict increases with the increase of the speed difference. The probability of traffic conflicts when vehicles are overtaking and changing lanes increases. When the longitudinal distance between the front and rear vehicles is less than 50m, the probability of serious traffic conflicts is large. When there is a large vehicle between two vehicles of the conflict subject, the probability of two-vehicle conflict will be increased. Relevant research can provide a basis for highway management departments to get the point of traffic conflict inducing factors and improve the traffic safety level of expressway construction area. © 2019 IEEE.},
 author = {Xin, Zhang and Pan, Wang and Lei, Wang and Yong, Jia and Ruoxi, Jiang},
 doi = {10.1109/ICICTA49267.2019.00036},
 journal = {Proceedings - 2019 12th International Conference on Intelligent Computation Technology and Automation, ICICTA 2019},
 note = {Cited by: 1},
 pages = {134 - 139},
 publication_stage = {Final},
 source = {Scopus},
 title = {Study on micro influencing factors of traffic conflicts in subgrade stage of expressway construction area},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85082137192?origin=resultslist},
