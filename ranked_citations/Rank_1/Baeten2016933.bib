@article{Baeten2016933,
 abstract = {The languages accepted by finite automata are precisely the languages denoted by regular expressions. In contrast, finite automata may exhibit behaviours that cannot be described by regular expressions up to bisimilarity. In this paper, we consider extensions of the theory of regular expressions with various forms of parallel composition and study the effect on expressiveness. First we prove that adding pure interleaving to the theory of regular expressions strictly increases its expressiveness modulo bisimilarity. Then, we prove that replacing the operation for pure interleaving by ACP-style parallel composition gives a further increase in expressiveness, still insufficient, however, to facilitate the expression of all finite automata up to bisimilarity. Finally, we prove that the theory of regular expressions with ACP-style parallel composition and encapsulation is expressive enough to express all finite automata up to bisimilarity. Our results extend the expressiveness results obtained by Bergstra, Bethke and Ponse for process algebras with (the binary variant of) Kleene's star operation. © Cambridge University Press 2015.},
 author = {Baeten, Jos C. M. and Luttik, B.A.S. and Muller, T.I.M. and Van Tilburg, Paul},
 doi = {10.1017/S0960129514000309},
 journal = {Mathematical Structures in Computer Science},
 note = {Cited by: 10; All Open Access; Green Open Access},
 number = {6},
 pages = {933 - 968},
 publication_stage = {Final},
 source = {Scopus},
 title = {Expressiveness modulo bisimilarity of regular expressions with parallel composition},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84982836669?origin=resultslist},
 volume = {26},
 year = {2016}
}
