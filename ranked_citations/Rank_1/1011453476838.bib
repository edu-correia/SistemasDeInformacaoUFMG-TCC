@article{10.1145/3476838,
 abstract = {It is questionable whether DRAM will continue to scale and will meet the needs of next-generation systems. Therefore, significant effort is invested in research and development of novel memory technologies. One of the candidates for next-generation memory is Spin-Transfer Torque Magnetic Random Access Memory&nbsp;(STT-MRAM). STT-MRAM is an emerging non-volatile memory with a lot of potential that could be exploited for various requirements of different computing systems. Being a novel technology, STT-MRAM devices are already approaching DRAM in terms of capacity, frequency, and device size. Although STT-MRAM technology got significant attention of various major memory manufacturers, academic research of STT-MRAM main memory remains marginal. This is mainly due to the unavailability of publicly available detailed timing and current parameters of this novel technology, which are required to perform a reliable main memory simulation on performance and power estimation. This study demonstrates an approach to perform a cycle accurate simulation of STT-MRAM main memory, being the first to release detailed timing and current parameters of this technology from academia—essentially enabling researchers to conduct reliable system-level simulation of STT-MRAM using widely accepted existing simulation infrastructure. The results show a fairly narrow overall performance deviation in response to significant variations in key timing parameters, and the power consumption experiments identify the key power component that is mostly affected with STT-MRAM.},
 address = {New York, NY, USA},
 articleno = {6},
 author = {Asifuzzaman, Kazi and Verdejo, Rommel S\'{a}nchez and Radojkovi\'{c}, Petar},
 doi = {10.1145/3476838},
 issn = {1539-9087},
 issue_date = {January 2022},
 journal = {ACM Trans. Embed. Comput. Syst.},
 keyword = {STT-MRAM, main memory, high-performance computing},
 month = {January},
 number = {1},
 numpages = {25},
 publisher = {Association for Computing Machinery},
 title = {Performance and Power Estimation of STT-MRAM Main Memory with Reliable System-level Simulation},
 url = {https://doi.org/10.1145/3476838},
 volume = {21},
 year = {2022}
}
