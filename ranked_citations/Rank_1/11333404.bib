@inproceedings{11333404,
 abstract = {This paper proposes a parameter-free circular arc detection algorithm based on Canny edge detection to address the challenge that existing methods struggle to accurately estimate arc-specific parameters—such as start and end angles—when processing incomplete circles or minor arcs. The algorithm first adaptively determines Canny thresholds using saliency theory, extracts edges, and segments them into straight line segments. Adjacent segments are then merged into candidate arcs under distance and angular continuity constraints. Subsequently, least-squares circle fitting is performed, and a relative standard deviation of fitting errors is introduced to eliminate straight lines and composite structures composed of multiple arcs. Finally, neighboring arcs are fused based on consistency in center position, radius, and endpoint angles. Experimental results demonstrate that the proposed method outperforms OpenCV’s ed-circle algorithm on both the Mini and GH datasets, showing particular effectiveness in detecting fragmented circles and genuine arc-shaped objects.},
 author = {Wang, Xinquan and Wang, Xifeng and Xu, Bin and Zhao, Wenhui},
 booktitle = {2025 4th International Conference on Image Processing, Computer Vision and Machine Learning (ICICML)},
 doi = {10.1109/ICICML67980.2025.11333404},
 issn = {},
 keyword = {Measurement;Computer vision;Image edge detection;Fitting;Object segmentation;Machine learning;Detection algorithms;Standards;machine vision;arc detection;Canny edge detection;parameter fitting},
 month = {Nov},
 number = {},
 pages = {325-329},
 title = {Design of a Parameter-Free Arc Detection Algorithm Based on Canny Edge Detection},
 volume = {},
 year = {2025}
}
