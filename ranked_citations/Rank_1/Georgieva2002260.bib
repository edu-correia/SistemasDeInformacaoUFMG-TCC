@article{Georgieva2002260,
 abstract = {In this paper we define a new clausal class, called BU, which can be decided by hyperresolution with splitting. We also consider the model generation problem for BU and show that hyperresolution plus splitting can also be used as a Herbrand model generation procedure for BU and, furthermore, that the addition of a local minimality test allows us to generate only minimal Herbrand models for clause sets in BU. I n addition, we investigate the relationship of BU to other solvable classes. © Springer-Verlag Berlin Heidelberg 2002.},
 author = {Georgieva, Lilia and Hustadt, Ullrich and Schmidt, Renate A.},
 doi = {10.1007/3-540-45620-1_21},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 15},
 pages = {260 - 274},
 publication_stage = {Final},
 source = {Scopus},
 title = {A new clausal class decidable by hyperresolution},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84948970279?origin=resultslist},
 volume = {2392},
 year = {2002}
}
