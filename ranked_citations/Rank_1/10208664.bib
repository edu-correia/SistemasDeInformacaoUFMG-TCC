@inproceedings{10208664,
 abstract = {This paper proposes EyeNet, a novel semantic segmentation network for point clouds that addresses the critical yet often overlooked parameter of coverage area size. Inspired by human peripheral vision, EyeNet overcomes the limitations of conventional networks by introducing a simple but efficient multi-scale input and a parallel processing network with connection blocks between parallel streams. The proposed approach effectively addresses the challenges of dense point clouds, as demonstrated by our ablation studies and state-of-the-art performance on Large-Scale Outdoor datasets.},
 author = {Yoo, Sunghwan and Jeong, Yeonjeong and Jameela, Maryam and Sohn, Gunho},
 booktitle = {2023 IEEE/CVF Conference on Computer Vision and Pattern Recognition Workshops (CVPRW)},
 doi = {10.1109/CVPRW59228.2023.00699},
 issn = {2160-7516},
 keyword = {Point cloud compression;Representation learning;Computer vision;Three-dimensional displays;Semantic segmentation;Conferences;Merging},
 month = {June},
 number = {},
 pages = {6577-6586},
 title = {Human Vision Based 3D Point Cloud Semantic Segmentation of Large-Scale Outdoor Scenes},
 volume = {},
 year = {2023}
}
