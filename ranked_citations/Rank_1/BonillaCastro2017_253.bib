@article{BonillaCastro2017_253,
 abstract = {Abstract: This paper sets a methodology to integrate solar thermal systems in BIM-software for the early architectural design of single houses in Concepción, Chile, using parametric families, programming in Dynamo, energy calculation with LadyBug and piping design in MEP. The results obtained allowed to select products, insert and adapts automatically the parametric designs into the model, as well as to identify changes in the type and number of solar components when the solar orientation of the house is modified. It can be applied to more products, different geographic locations and designs of houses or buildings with a similar methodology.},
 author = {Bonilla Castro, Alejandro and García Alvarado, Rodrigo},
 doi = {10.7764/rdlc.16.2.323},
 number = {2},
 pages = {323--338},
 title = {BIM-Integration of solar thermal systems in early housing design},
 volume = {16},
 year = {2017}
}
