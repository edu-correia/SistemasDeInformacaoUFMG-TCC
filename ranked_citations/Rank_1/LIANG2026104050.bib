@article{LIANG2026104050,
 abstract = {To address grid management challenges in Adaptive Mesh Refinement (AMR), we introduce MortonTrie, a novel trie data structure based on Morton spatial encoding. MortonTrie offers a memory-efficient and cache-friendly alternative to conventional methods. Its performance is maximized through key optimizations, including a bitmap for existence queries, a Halfway Query algorithm to exploit spatial locality, a compressed format to flatten the tree, and template metaprogramming to eliminate neighbor-finding overhead. Our framework demonstrates superior performance, achieving up to a 3.5× speedup in static mesh generation. For dynamic adaptation, it is 5.3× faster than hash-based methods. When integrated into a Lattice Boltzmann (LBM) solver, our framework achieves a 7.31× total speedup over state-of-the-art hash-based methods in the vehicle simulation. MortonTrie provides a robust, high-performance solution for complex geometric and physical modeling.},
 author = {Yuechao Liang and Jie Liu and Hang Zou and Qingyang Zhang},
 doi = {https://doi.org/10.1016/j.cad.2026.104050},
 issn = {0010-4485},
 journal = {Computer-Aided Design},
 keyword = {Adaptive mesh refinement, Spatial indexing, Space-filling curve, Complex solid, Lattice Boltzmann method},
 pages = {104050},
 title = {MortonTrie: An efficient trie-based data structure for adaptive mesh refinement in geometric modeling},
 url = {https://www.sciencedirect.com/science/article/pii/S0010448526000205},
 volume = {194},
 year = {2026}
}
