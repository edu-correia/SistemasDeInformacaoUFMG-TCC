@inproceedings{10505645,
 abstract = {Coordination of connected automated vehicles (CAV) is promising to alleviate traffic conflicts in traffic bottlenecks, such as highway on-ramps. However, how to coordinate CAVs to merge safely and efficiently in dense traffic remains a challenge. To address this issue, this paper proposes DeepSequence, a deep reinforcement learning (DRL)-based algorithm integrating the Pointer Neural Network, for optimizing CAV merging sequences and trajectory. First, the merging sequence optimization problem is formulated as a combinatorial optimization problem (COP), which is solved by the proposed DeepSequence efficiently to generate a merging sequence. Then, the optimal CAV trajectory corresponding to each sequence is generated through optimal control theory. Finally, simulations are conducted to validate the proposed algorithm. The results demonstrate that the algorithm effectively enhances the traffic efficiency and reduces fuel consumption of vehicles in the merging area.},
 author = {Jiang, Chen and Liu, Haoji and Qiu, Chunlong and Zhang, Sunan and Zhuang, Weichao},
 booktitle = {2024 IEEE 18th International Conference on Advanced Motion Control (AMC)},
 doi = {10.1109/AMC58169.2024.10505645},
 issn = {1943-6580},
 keyword = {Road transportation;Connected vehicles;Trajectory planning;Merging;Neural networks;Optimal control;Deep reinforcement learning;CAV;Merge Optimization;Pointer Network;Deep Reinforcement Learning},
 month = {Feb},
 number = {},
 pages = {1-7},
 title = {Ramp Merging Sequence and Trajectory Optimization for Connected and Autonomous Vehicles using Deep Reinforcement Learning},
 volume = {},
 year = {2024}
}
