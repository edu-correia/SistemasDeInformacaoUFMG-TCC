@inproceedings{11324376,
 abstract = {Road safety is an enduring worldwide problem, with numerous mishaps due to driver conduct and deficient preemptive integration of automation in support systems. This document introduces a smart automation schema combining computer vision and generative language models for improved driving safety via instant perception, processing, and dynamic feedback. Differing from classic sensor-centric driver monitoring, our system utilizes vehicle detection via YOLOv8, DeepSORT tracking, and spatio-temporal behavioral analysis to autonomously identify dangerous behaviors including tailgating, sudden lane switching, and risky overtaking. The incidents are fed into a generative AI-supported feedback system converting behavioral metrics into human-readable safety instructions, merging perception with control. It functions as a cyber-physical control tier that can provide instant notifications or dynamic driver support via conventional dashcams or smartphones. Empirical assessment on authentic vehicular footage repositories yielded 91% precision in hazardous actions retrieval, whereas questionnaires unveiled a notable progress in vehicular obediance and cognition. The suggested architecture provides a budget-friendly, expandable and language-agnostic automation framework integrating deep learning, smart control and generative AI to power the upcoming class of driver assistance systems.},
 author = {P, Shanmugam and S, Keerthika and A, Kamali K},
 booktitle = {2025 4th International Conference on Automation, Computing and Renewable Systems (ICACRS)},
 doi = {10.1109/ICACRS67045.2025.11324376},
 issn = {},
 keyword = {Intelligent automation;Deep learning;Computer vision;Generative AI;Computational modeling;Road safety;Safety;Vehicle dynamics;Driver behavior;Vehicles;Driver behavior analysis;Intelligent automation;Cyber-physical systems;Computer vision;YOLOv8;DeepSORT;Generative AI;Real-time safety control;Human-in-the-loop automation;Road safety},
 month = {Dec},
 number = {},
 pages = {1164-1171},
 title = {AI-Driven Intelligent Automation Framework for Driver Behavior Analysis and Safety Control},
