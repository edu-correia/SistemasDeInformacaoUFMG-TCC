@conference{Jiang2011,
 abstract = {Based on the characteristics that B<sup>+</sup>- tree is not suitable for indexing large-scale dataset, which could cause random disk I/O increased and more pages split when a large number of random data is inserted, this paper presents a new data structure, which can not only index more than a billion records, but also has a higher efficiency when do random and sequential search. What's more, the performance is relatively stable for large-scale data updating. Experiments show that the new data structure performs well and valid when we index large-scale dataset. © 2011 IEEE.},
 author = {Jiang, Haiping and Fan, Xinghua},
 doi = {10.1109/ITAP.2011.6006132},
 journal = {2011 International Conference on Internet Technology and Applications, iTAP 2011 - Proceedings},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research and implementation of index scheme for large-scale dataset},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/80052838873?origin=resultslist},
 year = {2011}
}
