@article{Yacine20143894,
 abstract = {The implementation of digital image processing on electronic boards is a current problem. In this study, we present a Model-Based Design of video tracking based on Matlab/Simulink and DSP. The implementation on DSP, of multi-objects detection and tracking algorithms of two kinds of applications inside and outside, is obtained by using automatic code generation that is code composer studio. The transmission and reception of data is realized by a network connection via Ethernet port between DSP and PC. This allows us, in the future, to extend the number of DSP working in parallel and their IP addresses would be generated by a DHCP server. © Maxwell Scientific Organization, 2014.},
 author = {Yacine, Chachou Mohamed and Zhou, Zhiguo and Liu, Zhi Wen},
 doi = {10.19026/rjaset.7.748},
 journal = {Research Journal of Applied Sciences, Engineering and Technology},
 note = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 number = {18},
 pages = {3894 - 3905},
 publication_stage = {Final},
 source = {Scopus},
 title = {Model based design of video tracking based on MATLAB/Simulink and DSP},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84901387308?origin=resultslist},
 volume = {7},
 year = {2014}
