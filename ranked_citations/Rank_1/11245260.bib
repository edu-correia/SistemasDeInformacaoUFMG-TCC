@inproceedings{11245260,
 abstract = {Log-Structured Merge-Tree (LSM-Tree) enhances write efficiency by converting random write operations into batch sequential writes, making it widely adopted in key-value storage systems. However, its key-value pair based indexing approach incurs significant memory and computational overhead in large-scale data environments and suffers from high latency in point query scenarios. Although learned index can enhance query performance and compress index structures, they are often constrained by high training costs, low update efficiency, and poor adaptability to changing data distributions. To address these limitations, this paper proposes HTMdex, a Hierarchical Temporal Memory (HTM) based learned index for LSMTree. HTMdex shifts the indexing target from key-value pairs to SST blocks and introduces an index encoding based on key region method, significantly reducing model training data volume and index complexity. Leveraging the online learning capabilities of the HTM model, HTMdex implements a lazy update mechanism to avoid frequent retraining and associated resource consumption. Furthermore, an adaptive query strategy based on dynamic threshold is proposed, which adaptively adjusts prediction strength based on the index error rate during queries, further enhancing query robustness and model adaptability. Performance evaluations using YCSB and GRE benchmarking tools demonstrate that HTMdex achieves $\mathbf{1. 5} \times$ to $\mathbf{1. 7 6} \times$ improvement in query performance in high-concurrency, write-intensive, and dynamically changing data scenarios, with performance gains ranging from $1.06 \times$ to $20 \times$ across various read-write update workloads. Moreover, system memory overhead is reduced by $32 \times$.},
 author = {Cai, Tao and Yin, Yizihao and Niu, Dejiao and Zou, Danping and Deng, Yikang and Huang, Qiujing},
 booktitle = {2025 IEEE International Symposium on Parallel and Distributed Processing with Applications (ISPA)},
 doi = {10.1109/ISPA67752.2025.00146},
 issn = {2158-9208},
 keyword = {Training;Adaptation models;Solid modeling;Costs;Training data;Predictive models;Performance gain;Throughput;Robustness;Indexing;LSM-tree;Learned Index;HTM},
 month = {Oct},
 number = {},
 pages = {1067-1072},
 title = {The New Learned Index for LSM-Tree},
 volume = {},
 year = {2025}
}
