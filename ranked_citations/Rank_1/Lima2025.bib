@conference{Lima2025,
 abstract = {The aviation industry faces challenges from growing air traffic, necessitating improved arrival management strategies. This study investigates the performance benefits of the Point Merge System in arrival management at São Paulo-Guarulhos Airport (SBGR) using a data-driven approach. The analysis compares operational performance before and after the implementation of PMS at SBGR, evaluating metrics such as Additional Time in Terminal Airspace, Holding occurrences, and a proposed metric called Arrival Divergence Time. Furthermore, the study compares the performance of SBGR with Lisbon Airport (LPPT), which also uses PMS, to identify similarities and differences in operational impacts. The results provide valuable insights for improving arrival management and contribute to international performance benchmarking in airport operations. © 2025 IEEE.},
 author = {Lima, Jean and Quintanilha, Alef and Koelle, Rainer and Melo, Andre},
 doi = {10.1109/ICNS65417.2025.10976942},
 journal = {Integrated Communications, Navigation and Surveillance Conference, ICNS},
 note = {Cited by: 0},
