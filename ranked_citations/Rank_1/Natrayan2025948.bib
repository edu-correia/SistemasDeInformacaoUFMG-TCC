@conference{Natrayan2025948,
 abstract = {Successful breast cancer prognosis hinges upon timely and precise imaging diagnostics. Conventional methodologies, augmented by standard neural networks, frequently falter due to heterogeneous growth patterns across diverse tumor phenotypes and prohibitive energy expenditure required for iterative learning cycles. This study advances a streamlined detection architecture wherein a Dilated Convolutional Network (DCN) is synergistically coupled to Walk-Spread-Based Optimization (WSBO) to foreground pertinent histopathological features while concurrently calibrating learning parameters. Embedded dilated filters sample multiple receptive fields and merge pixelwise indicators with wide-ranging spatial context, thereby preserving pixel-level histological fidelity and subsampling apparent and latent tumor signs at heterogeneous scales. Simultaneously, the WSBO mechanism modulates the encroachment-versus-innovation ratio of search agents toward meta-parameter convergence, thereby avoiding overfitting through adaptive, cycled perturbation and resampling. Rigorous validation against publicly curated, multicentric breast cancer archives yields statistically significant gains in classification efficacy, diminished classification bias over undetected microcalcifications, and acceleration of the convergence surface. This evidence substantiates the capacity of the composite DCN-WSBO pipeline to furnish clinicians with robust, computationally economical breast cancer stratification manifestly suited for integration within hospital-grade imaging and episodic, edge-based diagnostic modalities. © 2025 IEEE.},
 author = {Natrayan, L. and Dhivya Devi, S. and Koppisetty, Indumathi and Parikh, Swapnil M. and Kaushal, Rajanish Kumar and SivaramKrishnan, M.},
 doi = {10.1109/ICOIICS67115.2025.11390169},
 journal = {Proceedings of the 4th International Conference on Intelligent Computing, Information and Control Systems, ICOIICS 2025},
 note = {Cited by: 0},
 pages = {948 - 953},
 publication_stage = {Final},
 source = {Scopus},
 title = {Efficient Breast Cancer Detection using a Dilated Convolutional Network with Walk-Spread-based Optimization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105036682259?origin=resultslist},
