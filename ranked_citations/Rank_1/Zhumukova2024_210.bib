@article{Zhumukova2024_210,
 abstract = {ABSTRACT The study aims to analyze the impact of education quality on economic processes within higher education institutions. The reliability and validity of research findings are ensured by theoretical analysis of pertinent scientific literature, an analysis of reference statistic materials on higher education in the Republic of Kyrgyzstan, and document analysis. Additionally, the research considers the findings of Kyrgyz scholars along with researchers from near and far abroad. As a result of the conducted investigation, the peculiar features of the impact produced by education quality on economic processes within universities of the Republic of Kyrgyzstan are analyzed. This influence is found to be contradictory because the orientation of competing public and private universities towards diversification of funding sources sets them back from solving the tasks of national education policy and achieving the country's sustainable development goals. Drawing on expert opinions, it is established that the local community views the policy of educational services quality management in relation to foreign students as discriminatory, as there is a significant gap in the quality of education (foreign teachers are invited, educational activities are organized using export educational programs rather than based on local standards of higher vocational education). This is the price of preparing the higher education of the Republic of Kyrgyzstan for global integration.},
 author = {Zhumukova, Aizada and Osmonbaeva, Kamelia and Dootaliev, Alik},
 number = {97},
 pages = {358--362},
 title = {Effect of the quality of education on economic processes within Higher Education institutions},
 volume = {20},
 year = {2024}
}
