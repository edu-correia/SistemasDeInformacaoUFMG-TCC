@inproceedings{10965448,
 abstract = {In the realm of increasingly crucial flow characteristics studies, the strategic adaptation of flow data compression for targeted flow characterization tasks presents a distinct advantage. This work introduces an innovative scheme for adaptive network flow compression and device identification, employing a synergy of feature engineering. This approach represents an advancement over existing compression methodologies rooted in Sketch data structures. The proposed scheme innovatively merges feature engineering techniques to dynamically filter flow feature data and adeptly determine sketch structure parameters. Empirical validation is conducted using an open-source dataset. The results from experimentation highlight the scheme's pronounced capability to significantly curtail storage requisites for flow data, all the while maintaining seamless integration with subsequent tasks like device identification. Remarkably, this scheme's applicability extends to diverse flow feature-based classification duties, underscored by its inherent portability.},
 author = {Zhang, Liyuan and Lu, Yucheng and Rui, Lanlan and Lei, Min},
 booktitle = {2023 International Conference on Information Processing and Network Provisioning (ICIPNP)},
 doi = {10.1109/ICIPNP62754.2023.00074},
 issn = {},
 keyword = {Adaptive systems;Accuracy;Data compression;Telecommunication traffic;Information processing;Data structures;Object recognition;Proposals;data compression;network flow feature engineering;device identification},
 month = {Oct},
 number = {},
 pages = {323-327},
 title = {An Adaptive Compression Based Device Identification Approach Combining Feature Engineering for Network Flow Data},
 volume = {},
 year = {2023}
}
