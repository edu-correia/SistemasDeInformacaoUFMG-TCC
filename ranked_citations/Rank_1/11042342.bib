@inproceedings{11042342,
 abstract = {Given the quick development in generative AI (artificial intelligence), It has grown more challenging to determine difference between images generated by AI and authentic ones, raising concerns about misinformation, digital forgeries, and ethical misuse. This paper introduces a novel framework for identifying images generated by AI by leveraging Contrastive Language–Image Pretraining (CLIP) and Frequency analysis. CLIP provides semantic understanding by aligning visual content with textual descriptions, enabling the assessment of contextual coherence. Concurrently, frequency analysis detects anomalies in spatial frequency patterns, such as unnatural textures and spectral inconsistencies, which are indicative of synthetic generation. By combining CLIP's contextual analysis with frequency-based structural insights, the proposed method achieves enhanced detection performance. Extensive experiments demonstrate the robustness and accuracy of this approach, offering a scalable and efficient solution to the growing challenges of AI image forensics.},
 author = {Balakrishnan, Mathiarasi and Reddy, Gopavaram Madhulika and Manickam, Akash Muthu and Venkatesan, Preethi},
 booktitle = {2025 2nd International Conference on Research Methodologies in Knowledge Management, Artificial Intelligence and Telecommunication Engineering (RMKMATE)},
 doi = {10.1109/RMKMATE64874.2025.11042342},
 issn = {},
 keyword = {Training;Visualization;Accuracy;Generative AI;Fast Fourier transforms;Semantics;Refining;Feature extraction;Robustness;Real-time systems;AI Generated Images;Contextual analysis;Contrastive Language Image Pretraining (CLIP);Fast Fourier Transforms (FFT) Frequency Analysis;Generative AI;Image Detection;Spatial frequency pattern},
 month = {May},
 number = {},
 pages = {1-6},
 title = {SpectraCLIP: Merging Vision and Frequency for Decoding AI-Generated Images},
 volume = {},
 year = {2025}
}
