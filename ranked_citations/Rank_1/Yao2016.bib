@conference{Yao2016,
 abstract = {The emerging security analysis challenge in big data environment is getting more attention of security industry and research institute. The current problems are mainly about the volume of security data and the understanding of the data. To solve the problems, we should employ the big data technology, and meantime, consider the semantic processing methods. In this paper, we combine the big data processing with semantic methods and propose a framework for security analysis in big data era with semantics. In this framework, we can merge multi-sources security data, and process and analyze data using semantic connection knowledge, which is supposed to understand security data semantically and process data with semantic association and inference methods. The proposed framework can be worked with current threat intelligence sharing and exchanging mechanism. © 2016 IEEE.},
 author = {Yao, Yuangang and Zhang, Lei and Yi, Jin and Peng, Yong and Hu, Weihua and Shi, Lei},
 doi = {10.1109/ICITCS.2016.7740303},
 journal = {2016 6th International Conference on IT Convergence and Security, ICITCS 2016},
 note = {Cited by: 6},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A framework for big data security analysis and the semantic technology},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85006247359?origin=resultslist},
 year = {2016}
}
