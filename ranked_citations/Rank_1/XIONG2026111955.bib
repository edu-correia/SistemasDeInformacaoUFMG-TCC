@article{XIONG2026111955,
 abstract = {A novel coupling model that integrates Isogeometric Analysis (IGA) with Non-Ordinary State-Based Peridynamics (NOSBPD) is introduced to effectively predict the brittle fracture response of rock-like materials subjected to static and dynamic loading conditions. The model’s core innovation lies in the direct and seamless integration of Peridynamics (PD) and IGA meshes, ensuring precise capture of geometric details while avoiding mesh overlap and force imbalances. Importantly, the coupling model significantly reduces ghost force and wave reflections at the coupling interface. To validate its accuracy, four benchmark cases are employed, demonstrating the model’s precision. Additionally, the model effectively simulates the initiation, growth, and merging of pre-existing cracks in rock-like materials under tensile or compressive loading conditions, accurately reproducing various crack patterns, including wing cracks, quasi-coplanar secondary cracks, secondary inclined cracks, and anti-wing cracks.},
 author = {Zhihui Xiong and Shuwei Zhou and Xiaoxiang Chen and Siyang He},
 doi = {https://doi.org/10.1016/j.engfracmech.2026.111955},
 issn = {0013-7944},
 journal = {Engineering Fracture Mechanics},
 keyword = {Isogeometric analysis, Peridynamics, Cracks, Coupling model, Numerical simulation},
 pages = {111955},
 title = {A coupling approach of the isogeometric analysis and the non-ordinary state-based peridynamics for fracture in rock-like materials},
 url = {https://www.sciencedirect.com/science/article/pii/S0013794426001177},
 volume = {336},
 year = {2026}
}
