@inproceedings{5070235,
 abstract = {In this paper, we have proposed a method to identify and track the drifted topics in the background of the social media through exploring the heated comments published, discussed, and voted by the participants of the social media. Based on this approach, we have further developed a way to optimize the recommendation of the relevant news to the readers of certain news by using the keywords generated from both news and comments. The challenge lies in how to select the keywords that are related with the drifted topics according to the userspsila preference. In our work, we have utilized the number of votes received by a reader as an implicit feedback from the social media users in determining the quality of the comment. Then the keywords extracted from the comments are ranked based on both the quantity and the quality of the comments they appears in. Finally top-ranked keywords are selected and merged with the keywords representative of the original topics to retrieve the relevant news. Our experiment on news and comments from social media shows this approach is quite effective and promising.},
 author = {Xue, Yuan and Zhang, Chen and Zhou, Changzheng and Lin, Xun and Li, Qing},
 booktitle = {2008 International Workshop on Education Technology and Training & 2008 International Workshop on Geoscience and Remote Sensing},
 doi = {10.1109/ETTandGRS.2008.298},
 issn = {},
 keyword = {Voting;Global warming;Educational technology;Geoscience and remote sensing;Finance;Feedback},
 month = {Dec},
 number = {},
 pages = {627-631},
 title = {An Effective News Recommendation in Social Media Based on Users' Preference},
 volume = {1},
 year = {2008}
}
