@conference{Saied2017127,
 abstract = {We describe the ATILF-LLF system built for the MWE 2017 Shared Task on automatic identification of verbal multiword expressions. We participated in the closed track only, for all the 18 available languages. Our system is a robust greedy transition-based system, in which MWE are identified through a MERGE transition. The system was meant to accommodate the variety of linguistic resources provided for each language, in terms of accompanying morphological and syntactic information. Using per-MWE Fscore, the system was ranked first for all but two languages (Hungarian and Romanian). © 2017 Association for Computational Linguistics},
 author = {Saied, Hazem Al and Candito, Marie and Constant, Matthieu},
 journal = {MWE 2017 - 13th Workshop on Multiword Expressions, Proceedings of the Workshop},
 note = {Cited by: 18},
 pages = {127 - 132},
 publication_stage = {Final},
 source = {Scopus},
 title = {The ATILF-LLF System for Parseme Shared Task: A Transition-based Verbal Multiword Expression Tagger},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85057750865?origin=resultslist},
 year = {2017}
}
