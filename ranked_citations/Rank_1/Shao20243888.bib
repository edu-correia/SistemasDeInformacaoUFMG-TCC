@conference{Shao20243888,
 abstract = {With the rapid development of Internet of Vehicles (IoV) technology, the number of smart vehicles and roadside units has increased dramatically, accelerating the rate of real-time data generation within the IoV environment. To optimize the storage efficiency of massive real-time IoV data, this paper proposes a new two-dimensional spatial-temporal index structure, named after LSM TR-Tree. As a spatial index, the TR-Tree not only determines the timing of Minimum Bounding Rectangle (MBR) adjustments based on the real-time trajectory of vehicles, but also incrementally updates the index structure based on changes in the relative positions of vehicles, significantly enhancing the efficiency of spatial index reconstruction. By integrating the TR-Tree with the LSM-Tree, a complete spatial-temporal index structure is formed. This study employs the NGSIM US101 dataset and conducts experiments in AsterixDB. The results demonstrate that the LSM TR-Tree shows significant performance advantages in terms of writing efficiency and spatial query response compared to the single temporal index LSM-Tree and traditional spatial-temporal index LSM R-Tree, effectively proving the feasibility and advanced nature of the LSM TR-Tree in handling massive real-time IoV data. © 2024 IEEE.},
 author = {Shao, Yiran and Chen, Zhenwu and Zhen, Yongfeng and Zhu, Fenghua and Peng, Lei},
 doi = {10.1109/ITSC58415.2024.10919968},
 journal = {IEEE Conference on Intelligent Transportation Systems, Proceedings, ITSC},
 note = {Cited by: 0},
 pages = {3888 - 3894},
 publication_stage = {Final},
 source = {Scopus},
 title = {LSM TR-Tree: An Efficient Spatial-Temporal Index for Real-Time IoV Data Storage},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105001672308?origin=resultslist},
