@conference{Shi2025399,
 abstract = {As Hybrid Transactional and Analytical Processing (HTAP) systems continue to evolve, storage engines must handle both high-throughput writes and efficient query processing. Traditional LSM-tree-based systems, though strong in write performance, often face performance bottlenecks under hybrid workloads due to uneven data distribution and inefficient query paths. This paper addresses these challenges by proposing a write-side optimization strategy based on LevelDB for HTAP scenarios. The core contribution of this work is a two-stage partitioning strategy. It pre-analyzes key distributions during MemTable flush to divide data by range and incorporates a background learning mechanism that dynamically adjusts partition boundaries according to workload patterns. This approach improves data locality, reduces unnecessary scanning, and enhances query performance. The strategy has been integrated into the LevelDB write path with extended metadata management. Experiments on the TPC-H dataset demonstrate substantial gains in latency and resource efficiency. This research offers a practical solution for optimizing LSM-tree systems under HTAP workloads, with both engineering and academic relevance.  © 2025 IEEE.},
 author = {Shi, Shengfei and Ai, Keyi and Xie, Xiaoxiao and Yi, Chao and Liu, Yue},
 doi = {10.1109/DSC67331.2025.00058},
 journal = {Proceedings - 2025 IEEE 10th International Conference on Data Science in Cyberspace, DSC 2025},
 note = {Cited by: 0},
 pages = {399 - 406},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mix-LSM: Research on Mixed Data Storage Strategies for HTAP Based on LSM Trees},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105033066822?origin=resultslist},
 year = {2025}
}
