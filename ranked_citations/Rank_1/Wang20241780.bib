@article{Wang20241780,
 abstract = {In recent years, there has been a rapid rise in interest in trajectory prediction in the field of autonomous driving. However, the domain generalization of current works is often neglected, and their performance tends to degrade when transferred to a different dataset or scenario. In this article, we present a solution to this problem that accounts for the realistic conditions necessary for autonomous driving. Specifically, we identify velocity and environment as possible causes for the decline in domain generalization. Then, we propose incorporating a module for velocity refinement as a solution to the velocity issue. As a response to the environmental issue, we propose both self-distillation and an environment-specific loss. Our new model is named Lane Transformer++, with one plus representing velocity issues and the other representing environmental concerns. Comprehensive evaluations on both the Argoverse and INTERACTION datasets demonstrate that the proposed method can significantly enhance the performance of prediction.  © 2016 IEEE.},
 author = {Wang, Zhibo and Guo, Jiayu and Zhang, Haiqiang and Wan, Ru and Zhang, Junping and Pu, Jian},
 doi = {10.1109/TIV.2023.3299600},
 journal = {IEEE Transactions on Intelligent Vehicles},
 note = {Cited by: 7},
 number = {1},
 pages = {1780 - 1791},
 publication_stage = {Final},
 source = {Scopus},
 title = {Bridging the Gap: Improving Domain Generalization in Trajectory Prediction},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85166327054?origin=resultslist},
 volume = {9},
 year = {2024}
}
