@inproceedings{11393201,
 abstract = {Over the past few years, quantum computing has been evolving, raising concerns about how long our existing encryption methods will remain reliable. Given this, random number generators that are both high entropy and secure from quantum threats are needed. In this research, we present a hybrid random number generator system designed to produce quantum-resistant cryptographic keys to mitigate the risk of future quantum adversaries. This HRNG design integrates true entropy of a quantum random number generator (QRNG) and combines it with the high-speed performance of a ChaCha20-based pseudo random number generator (PRNG). This approach successfully balances the speed of classical algorithms with quantum unpredictability. When integrated with symmetric (AES, Blowfish, Triple DES, IDEA) and asymmetric (RSA, ECC) encryption algorithms, it maintained high-speed encryption performance without any difficulties from the limitations of physical QRNG. By avoiding hardware constraints and performance bottlenecks, the HRNG provides a deployable entropy solution that easily integrates into existing cryptographic systems.},
 author = {Ng, Verren Angle and Haunafi, Marshia and Larasathi, Andira Dinda and Muliono, Yohan},
 booktitle = {2025 8th International Seminar on Research of Information Technology and Intelligent Systems (ISRITI)},
 doi = {10.1109/ISRITI68345.2025.11393201},
 issn = {2832-1456},
 keyword = {Seminars;Quantum computing;NIST;Throughput;Entropy;Generators;Hybrid power systems;Encryption;Reliability;Random number generation;random number generation;quantum computing;cryptography;encryption algorithms;hybrid systems;entropy source;quantum random number generator;cyber security},
 month = {Dec},
 number = {},
 pages = {701-706},
 title = {Merging Quantum Entropy with Classical Speed: Design and Evaluation of a Hybrid Random Number Generator for Secure Encryption},
 volume = {},
 year = {2025}
}
