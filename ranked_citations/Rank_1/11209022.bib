@inproceedings{11209022,
 abstract = {Morphing attacks have become a severe risk to secure systems, particularly for applications that use biometric authentication. Malicious actors can fabricate security systems that depend on face recognition by merging the facial traits of several people through these assaults. The only topic covered in this survey is morph-resistant style transfer methods for preventing morphing attacks. Techniques like adversarial regularization, feature regularization, and style preservation are used to successfully prevent morphing efforts without losing image quality. In adding up to evaluating numerous methods and emphasizing their advantages and disadvantages, the paper offers insights into the obstacles and capability trails ahead in the development of morph-resistant structures.},
 author = {Jeeva, K. and Niranjana, G.},
 booktitle = {2025 2nd International Conference on Computing and Data Science (ICCDS)},
 doi = {10.1109/ICCDS64403.2025.11209022},
 issn = {},
 keyword = {Surveys;Image quality;Prevention and mitigation;Face recognition;Merging;Data science;Biometric authentication;Security;Morphing prevention;biometric authentication;style transfer},
 month = {July},
 number = {},
 pages = {1-4},
 title = {Survey on Morphing Prevention with Morph-Resistant Style Transfer Techniques},
 volume = {},
 year = {2025}
}
