@inproceedings{7232146,
 abstract = {The purpose of analysis of conflicts within the urban intersection is to determine the degree of different types of conflicts within the intersection. Currently, the analysis of conflicts within urban intersections considers in general simply the conflicts between motorized vehicles and the influence of non-motorized vehicles and pedestrians is usually ignored. This paper summarizes the research findings on the conflict analysis in urban intersections, with the state-of-the-art and main issues to be investigated identified. On this basis, a new method is proposed in this paper to analyze the conflicts of urban intersections, which considers the impacts of non-motorized vehicles and pedestrians. Using a real world urban intersection as the example, the proposed method is demonstrated. The result shows that the new method proposed in this paper is much more comprehensive and reasonable, and is more close to our country's actual traffic conditions that non-motorized vehicles and pedestrians are of large numbers.},
 author = {Ning, Dan and Guo, Jianhua and Zhou, Xu},
 booktitle = {2015 International Conference on Transportation Information and Safety (ICTIS)},
 doi = {10.1109/ICTIS.2015.7232146},
 issn = {},
 keyword = {Vehicles;Roads;Computational modeling;Safety;Merging;Niobium;Urban road;intersection;non-motorized vehicle;pedestrian;the degree of the conflicts},
 month = {June},
 number = {},
 pages = {64-69},
 title = {Conflicts analysis for urban road intersection considering non-motor vehicles and pedestrians factor},
 volume = {},
 year = {2015}
}
