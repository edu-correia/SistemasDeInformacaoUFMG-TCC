@inproceedings{11434118,
 abstract = {In real time exam preparatory platforms is dependent on learners contribute significantly. For exam preparation, the student should focus on effectively learning, with better tracking of progress, and feedback. Similarly for educators, they must focus on a scale using data. This work adopts a Smart AI Exam Preparation SaaS, developed by merging of artificial intelligence with modern full-stack web technologies to address the current problem. The core is built with Next js and React to create a responsive frontend, styled with Tailwind CSS, for uniform UI and uses Neon PostgreSQL for data storage. Here the Clerk deals with secure, role-based authentication. Inngest covers background mechanism for tasks like tracking performance and setting up assessments. Gemini AI is integrated for quizzes and flashcards, which can be created dynamically along with intelligent feedback that adjusts based on real time learner performance. This platform is a cloud-based & AI-enabled platform which provides customized preparation to the students appearing for exams. It helps to increase student engagement and improves learning efficiency. It allows traditional models (LMS) to have flexibility, scalability and institutional readiness deployment. It's a good example of how to build it and it shows well the integration of AI and modern development tools combine those powerful insights to increase smart in education ecosystem.},
 author = {Chauhan, Divyanshu and Verma, Seema and Mahapatra, Madhumita and Pandey, Preeti},
 booktitle = {2025 3rd International Conference on Advances in Computation, Communication and Information Technology (ICAICCIT)},
 doi = {10.1109/ICAICCIT68829.2025.11434118},
 issn = {},
 keyword = {Neon;Scalability;Merging;Education;Ecosystems;Memory;Full stack;Real-time systems;Information and communication technology;Artificial intelligence;AI Exam Preparation;LMS;SaaS;Next.js;Tailwind CSS;Gemini AI;Clerk;Neon PostgreSQL;Inngest;Full Stack Development},
 month = {Oct},
 number = {},
 pages = {221-225},
 title = {Design of Smart AI Exam Preparation SaaS System Using Next-Gen Technologies},
 volume = {1},
