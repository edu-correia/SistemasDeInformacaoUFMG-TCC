@article{8173581,
 abstract = {We use high-resolution numerical simulations to study the physical properties of subhaloes when they merge into their host haloes. An improved algorithm is used to identify the subhaloes. We then examine their spatial and velocity distributions in spherical and triaxial halo models. We find that the accretion of satellites preferentially occurs along the major axis and perpendicular to the spin axis of the host halo. Furthermore, the massive subhaloes show a stronger preference to be accreted along the major axis of the host halo than the low-mass ones. Approximate fitting formulae are provided for the physical properties of subhaloes. Combined with analytical and semi-analytic techniques, these empirical formulae provide a useful basis for studying the subsequent evolution of subhaloes and satellite galaxies in their hosts. However, future studies should account for satellites that may not be undergoing the first infall in their evolution.},
 author = {Wang, H. Y. and Jing, Y. P. and Mao, Shude and Kang, Xi},
 doi = {10.1111/j.1365-2966.2005.09543.x},
 issn = {1365-2966},
 journal = {Monthly Notices of the Royal Astronomical Society},
 keyword = {cosmology: theory;dark matter;large-scale structure of Universe},
 month = {Dec},
 number = {2},
 pages = {424-432},
 title = {The phase-space distribution of infalling dark matter subhaloes},
 volume = {364},
 year = {2005}
}
