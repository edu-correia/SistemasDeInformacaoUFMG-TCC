@inproceedings{11496156,
 abstract = {ATMs are the primary tools for the modern financial world. Almost all citizens are making use of ATMs to withdraw small and large amounts of cash from their bank accounts. The extensive use of this technology by a large number of citizens has caught the attention of thieves and hackers. The increasing number of cyber and physical attacks on these systems is a clear proof that some loopholes are yet to be fixed in the existing security system of PIN and encryption codes. The evolving nature of these attacks is making them difficult to prevent and mitigate. This research goes into basic vulnerabilities found in the ATM systems. The aim is to design a secure ATM framework that merges cryptography and AI for enhanced data protection. Merging RSA, AES, ECC, and Hash functions for encryption, authentication, and transmission of the data/cash is proposed. The framework has a modular system architecture. The studies depict a significant reduction of about 4 % in successful attacks and overall fraud rates. This confirms that joining cryptography with smart AI monitoring will be effective. This system will illustrate the integration of cryptographic protocols with AI analytics that can enhance the security of the ATM systems to ensure better data privacy and rebuild trust in the use of the ATM services.},
 author = {Uniyal, Yash and Khekare, Ganesh},
 booktitle = {2026 World Conference on Computational Science and Technology (WcCST)},
 doi = {10.1109/WcCST67302.2026.11496156},
 issn = {},
 keyword = {Asynchronous transfer mode;Communication systems;Internet of Things;Protocols;Internet;Data communication;Cryptographic protocols;Radio access networks;Regional area networks;HTTP;cryptographic protocols;artificial intelligence;automated teller machine;attacks;RSA and ECC Encryption;fraud detection;banking transactions},
 month = {March},
 number = {},
 pages = {181-186},
 title = {Securing ATM Transactions: Integrating Cryptographic Protocols and AI-Enhanced Approaches},
