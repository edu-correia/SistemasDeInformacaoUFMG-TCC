@conference{Hanjaya202579,
 abstract = {Corporate social responsibility (CSR) has been viewed as one of the main channels for a company to build sustainable business operations, and along the way, these efforts also merge with the Sustainable Development Goals (SDGs). Throughout the years, there has been an implementation gap of CSR-artificial intelligence (AI) on the practicality of its ethical standards. This paper attempts to measure the effectiveness of AI on CSR with the systematic literature review method. Results stated that AI benefits the development of these CSR strategies. In line with effectivity, responsibility was assessed based on normative ethical stances, which described that CSR-AI efforts are morally permissible to be done in perpetuity. The analysis further leads to proposed elements to consider in complementing CSR with AI that goes hand in hand with nsormative ethics standards. For further studies, this study implies that CSR strategy ought to be further customized based on industry, company culture, governance practices, and moral offsetting.  © 2025 IEEE.},
 author = {Hanjaya, Aurelia Bianca and Husna, Nisrin},
 doi = {10.1109/ICIMTech67074.2025.11265259},
 journal = {Proceedings of 2025 International Conference on Information Management and Technology, ICIMTech 2025},
 note = {Cited by: 0},
 pages = {79 - 84},
 publication_stage = {Final},
 source = {Scopus},
 title = {Artificial Intelligence on Corporate Social Responsibility: Comparing Literature Review and Normative Ethical Stances},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105031430137?origin=resultslist},
 year = {2025}
}
