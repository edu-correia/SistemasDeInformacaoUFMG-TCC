@article{10.14778/3551793.3551868,
 abstract = {Answering connectivity queries is fundamental to fully dynamic graphs where edges and vertices are inserted and deleted frequently. Existing work proposes data structures and algorithms with worst case guarantees. We propose a new data structure, the dynamic tree (D-tree), together with algorithms to construct and maintain it. The D-tree is the first data structure that scales to fully dynamic graphs with millions of vertices and edges and, on average, answers connectivity queries much faster than data structures with worst case guarantees.},
 author = {Chen, Qing and Lachish, Oded and Helmer, Sven and B\"{o}hlen, Michael H.},
 doi = {10.14778/3551793.3551868},
 issn = {2150-8097},
 issue_date = {July 2022},
 journal = {Proc. VLDB Endow.},
 month = {July},
 number = {11},
 numpages = {14},
 pages = {3263–3276},
 publisher = {VLDB Endowment},
 title = {Dynamic spanning trees for connectivity queries on fully-dynamic undirected graphs},
 url = {https://doi.org/10.14778/3551793.3551868},
 volume = {15},
 year = {2022}
}
