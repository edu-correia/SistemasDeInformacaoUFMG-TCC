@conference{Singh201715,
 abstract = {Background: software inspection results in reviews that report the presence of faults. Requirements author must manually read through the reviews and differentiate between true-faults and false-positives. Problem: post-inspection decisions (fault or nonfault) are difficult and time consuming. It is difficult to employ machine learning (ML) techniques directly to raw (unstructured) data because of class imbalance problem and possible fault-slippage through misclassification of fault. Aim: The aim of this research is to solve this problem with the help of ensemble approach and priority analysis to achieve significant accuracy in determining true-fault and false-positive reviews without losing any listed fault. Method: We conducted empirical experiment using two trained models (with reviews from inspection domain vs. movies domain) to address class imbalance problem. Our approach uses ensemble methods to develop classification confidence of inspection reviews and assigns them to appropriate priority class. Results: The results showed that movies trained model performed better than inspection trained and restricted any possible fault-slippage. © 2017 IEEE.},
 author = {Singh, Maninder and Walia, Gursimran S. and Goswami, Anurag},
 doi = {10.1109/MLDS.2017.15},
 journal = {Proceedings - 2017 International Conference on Machine Learning and Data Science, MLDS 2017},
 note = {Cited by: 4},
 pages = {15 - 22},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Empirical Investigation to Overcome Class-Imbalance in Inspection Reviews},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85050998097?origin=resultslist},
 volume = {2018-January},
 year = {2017}
}
