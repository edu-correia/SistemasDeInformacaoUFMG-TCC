@conference{Sun2018,
 abstract = {In this paper, we are interested in building lightweight and efficient convolutional neural networks. Inspired by the success of two design patterns, i.e. composition of structured sparse kernels (like interleaved group convolutions-IGC) and composition of low-rank kernels (like bottle-neck modules), we study the combination of such two design patterns, using the composition of structured sparse low-rank kernels to form a convolutional kernel. Instead of introducing a complementary condition over channels, we introduce a loose complementary condition, which is formulated by imposing the complementary condition over super-channels, to guide the design for generating a dense convolutional kernel. The resulting network is named IGCV3. We empirically demonstrate that the combination of low-rank and sparse kernels boosts the performance and leads to the superiority of our proposed approach to the state-of-the-arts, IGCV2 and MobileNetV2 over image classification on CIFAR and ImageNet and object detection on COCO. Code and models are available at https://github.com/homles11/IGCV3. © 2018. The copyright of this document resides with its authors.},
 author = {Sun, Ke and Li, Mingjie and Liu, Dong and Wang, Jingdong},
 journal = {British Machine Vision Conference 2018, BMVC 2018},
 note = {Cited by: 58},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {IGCv3: Interleaved low-rank group convolutions for efficient deep neural networks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85084016089?origin=resultslist},
 year = {2018}
}
