@article{9808388,
 abstract = {It's a basic characteristic that there exists a phase singularity located at the center for pure vortex light. If combining several vortex lights belonging to the same eigenmode set, the central higher-order singularity may split into several singularities distributed around the space. In this paper, we propose a mechanism to reconfigure such splitting singularities. The splitting singularities can be manipulated to be close to or away from each other. Especially, they form a higher-order singularity or annihilate when two singularities coincide. Because all the combined lights are non-diffraction, the synthetic field is also non-diffraction. We realize the reconfiguration of splitting singularities in the experiment and verify the non-diffraction property at a 1m distance.},
 author = {Mao, Baiwei and Shi, Zekun and Chen, Liang and Chang, Wenzhe and Wang, Zhi and Wang, Pan and Liu, Yan-Ge},
 doi = {10.1109/JLT.2022.3186722},
 issn = {1558-2213},
 journal = {Journal of Lightwave Technology},
 keyword = {Periodic structures;Merging;Space vehicles;Laser modes;Fiber lasers;Diffraction;Color;Non-diffraction beam;orbital angular momentum;structured light;singularity reconfiguration;vortex array},
 month = {April},
 number = {7},
 pages = {2240-2245},
 title = {Singularity Reconfiguration of Non-Diffraction Structured Light},
 volume = {41},
 year = {2023}
}
