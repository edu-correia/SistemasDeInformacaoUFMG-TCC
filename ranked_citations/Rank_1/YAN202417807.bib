@article{YAN202417807,
 abstract = {Lightweight porous geopolymers are a widely researched system with diverse engineering applications. This study presents a comparative investigation on the strength and pore structure characteristics (including pore size distribution, porosity, morphology and pore wall structure) of porous geopolymers with the same densities (0.60, 0.75 and 0.90 g/cm3) synthesized using pre-foaming (PFG) and H2O2 foaming (HFG) methods for the first time. Various techniques, such as XCT, SEM and MIP, were used to characterise their pore structure at multiple scales. The experimental results demonstrate that PFG exhibits slightly higher compressive strength compared to that of HFG with the same density, which is attributed to the relatively lower macro-pore porosity and more uniform micron-scale (>10 μm) pore structure. Moreover, there are more micron-scale pores and less small capillaries and gel pores (<100 nm) in HFG compared to PFG. Stable foam bubbles can be introduced directly into fresh geopolymers through the pre-foaming method, whereas H2O2 foaming results in the formation of a more unevenly distributed porous system through the decomposition of hydrogen peroxide and the merging of bubbles. This study serves to deepen the comprehension of the foaming process and underlying mechanisms of these two foaming methods, offering new valuable insights into fabricating porous geopolymers with target pore structures in specific engineering applications.},
 author = {Dongming Yan and Yangpiaoxue Shi and Yajun Zhang and Wenxin Wang and Hao Qian and Shikun Chen and Yi Liu and Shengqian Ruan},
 doi = {https://doi.org/10.1016/j.ceramint.2024.02.270},
 issn = {0272-8842},
 journal = {Ceramics International},
 keyword = {Porous geopolymer, Pore structure characteristics, Pre-foaming, HO foaming, XCT},
 number = {10},
 pages = {17807-17817},
 title = {A comparative study of porous geopolymers synthesized by pre-foaming and H2O2 foaming methods: Strength and pore structure characteristics},
 url = {https://www.sciencedirect.com/science/article/pii/S0272884224007727},
 volume = {50},
 year = {2024}
}
