@article{Lersch2017326,
 abstract = {The rise of NVRAM technologies promises to change the way we think about system architectures. In order to fully exploit its advantages, it is required to develop systems specially tailored for NVRAM devices. Not only this imposes great challenges, but also developing full system architectures from scratch is undesirable in many scenarios due to prohibitive development costs. Instead, we analyze in this paper the behavior of an existing log-structured persistent key-value store, namely LevelDB, when run on top of an emulated NVRAM device. We investigate initial opportunities for improvement when adapting a system tailored for HDD/SSDs to run on top of an NVRAM environment. Furthermore, we analyze the behavior of the DRAM caching components of LevelDB and whether more suitable caching policies are required. © 2017, Springer International Publishing AG.},
 author = {Lersch, Lucas and Oukid, Ismail and Schreter, Ivan and Lehner, Wolfgang},
 doi = {10.1007/978-3-319-66917-5_22},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 9; All Open Access; Green Open Access},
 pages = {326 - 340},
 publication_stage = {Final},
 source = {Scopus},
 title = {Rethinking DRAM caching for LSMs in an NVRAM environment},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85030153509?origin=resultslist},
 volume = {10509 LNCS},
 year = {2017}
}
