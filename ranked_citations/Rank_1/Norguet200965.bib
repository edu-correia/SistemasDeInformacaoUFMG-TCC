@article{Norguet200965,
 abstract = {With the emergence of the World Wide Web, analyzing and improving Web communication has become essential to adapt the Web content to the visitors'expectations. Web communication analysis is traditionally performed by Web analytics software, which produce long lists of page-based audience metrics. These results suffer from page synonymy, page polysemy, page temporality, and page volatility. In addition, the metrics contain little semantics and are too detailed to be exploited by organization managers and chief editors, who need summarized and conceptual information to take high-level decisions. To obtain such metrics, we propose a method based on output page mining. Output page mining is a new kind of Web usage mining, between Web usage mining and Web content mining. In our method, we first collect the Web pages output by the Web server. Then, for a given taxonomy covering the Web site knwoledge domain, we aggregate the term weights in the output pages using OLAP tools, in order to obtain topic-based metrics representing the audience of the Web site topics. To demonstrate how our approach solves the cited problems, we compute topic-based metrics with SQL Server OLAP Analysis Service and our prototype WASA for real Web sites. Finally, we compare our results against those obtained with Google Analytics, a popular Web analytics tool. © 2009 Springer-Verlag Berlin Heidelberg.},
 author = {Norguet, Jean-Pierre and Zimányi, Esteban and Steinberger, Ralf},
 doi = {10.1007/978-3-540-88081-3_4},
 journal = {Studies in Computational Intelligence},
 note = {Cited by: 0},
 pages = {65 - 79},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic analysis of web site audience by integrating web usage mining and web content mining},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/57749185913?origin=resultslist},
 volume = {172},
 year = {2009}
}
