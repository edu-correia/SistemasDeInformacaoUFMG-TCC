@article{Huang2024145,
 abstract = {A four-lane model is put forward to explore the effects on vehicular fuel consumption of a freeway work zone which has a length of 100 m and occupies lanes III and IV. The model equations are solved numerically in the simulation of vehicular flows by a method called WENO5–RK3. A vehicular fuel consumption model is presented, with an additional fuel consumption defined in comparison with the case in the absence of a work zone. Simulation results show that the freeway work zone affects vehicular fuel consumption significantly, triggers a traffic jam as soon as initial density normalized by jam density is beyond 0.18. © The Author(s) 2023.},
 author = {Huang, Zhongmin and Smirnova, M.N. and Bi, Jiarui and Smirnov, N.N. and Zhu, Zuojin},
 doi = {10.1177/00375497231198859},
 journal = {Simulation},
 note = {Cited by: 2},
 number = {2},
 pages = {145 - 155},
 publication_stage = {Final},
 source = {Scopus},
 title = {Freeway work zone effects on vehicular fuel consumption explored by a four-lane model},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85172810087?origin=resultslist},
 volume = {100},
 year = {2024}
}
