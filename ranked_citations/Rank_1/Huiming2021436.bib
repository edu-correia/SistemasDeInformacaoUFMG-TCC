@conference{Huiming2021436,
 abstract = {As an important branch in the field of machine vision, target detection and recognition technology have important applications in various fields. In view of the fact that the general target detection and recognition model does not perform well in remote sensing images, and there're large amount of different size targets need to be recognized. On the basis of Mask R-CNN model, one of the classic target detection and recognition model, this paper proposes A target recognition and detection method that integrates data enhancement processing and improves the Mask R-CNN backbone network FPN to RFP. When inputting image data, perform random enhancement processing on the data, randomly cut the image, and randomly merge; when extracting features, improve the FPN in the original Mask R-CNN model to RFP to make the extracted features better Reflecting the original picture information, experiments have shown that this model has a good performance in fine-grained target recognition in remote sensing images. On the same data set, its evaluation indicators are superior to other comparison algorithms in all aspects. © 2021 IEEE.},
 author = {Huiming, Yu and Fuxin, Xu},
 doi = {10.1109/ICBAIE52039.2021.9389916},
 journal = {2021 IEEE 2nd International Conference on Big Data, Artificial Intelligence and Internet of Things Engineering, ICBAIE 2021},
 note = {Cited by: 12},
 pages = {436 - 439},
 publication_stage = {Final},
 source = {Scopus},
 title = {A remote sensing image target recognition method based on improved Mask-RCNN model},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85104425471?origin=resultslist},
 year = {2021}
}
