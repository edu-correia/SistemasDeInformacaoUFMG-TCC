@inproceedings{8070137,
 abstract = {In order to demonstrate benefits that NDN brings to distributed storage system, we design and implement an ndnDHT-based distributed storage system called Ndynamo. The architecture of Ndynamo is similar to the Dynamo system of Amazon and it takes advantage of many features of NDN. We introduce the architecture and functional modules of this system in this paper, including the detailed descriptions of the storage servers and the global identifier server. Besides, we discuss some preliminary optimizations of this system to improve performance under certain scenarios. In order to evaluate the access performance of Ndynamo and the optimization method performance, we implement Ndynamo on the NFD platform. The experimental results demonstrate the efficiency and capability of NDN to support data storage.},
 author = {Zhu, Shuai and Yuan, Meng and Lei, Kai},
 booktitle = {2016 5th International Conference on Computer Science and Network Technology (ICCSNT)},
 doi = {10.1109/ICCSNT.2016.8070137},
 issn = {},
 keyword = {Handheld computers;Distributed databases;Sun;Conferences;Computer science;System analysis and design;Fault diagnosis;Named Data Networking;distributed storage;NFD},
 month = {Dec},
 number = {},
 pages = {148-152},
 title = {Ndynamo: An ndnDHT-based distributed storage system over named data networking},
 volume = {},
 year = {2016}
}
