@article{10.1145/3786654,
 abstract = {In this paper, we present Learned-Less Index - a learned index built by merging existing linear regression models instead of training new ones from scratch. Learned-Less Index does not require scanning sorted keys, which makes it up to 615 times faster than traditional Greedy-PLR method, although it comes with higher prediction errors. Learned-Less Index is particularly effective in LSM tree-based KVStores in highly concurrent environments, where computational resources for learning are often limited. Merging existing linear regression models enables models to be created prior to compaction. This allows queries to benefit from model-based search without falling back to conventional index block searches since models are immediately available for use as soon as new SSTables are created. Additionally, these pre-built merged models can help improve the compaction process. Our experiments show that Learned-Less Index significantly reduces CPU overhead and improves query performance by a large margin in highly concurrent environments.},
 address = {New York, NY, USA},
 articleno = {40},
 author = {Koo, Hera and Moon, Sungho and Chae, Sangeun and Kim, Wook-Hee and Choi, Jongmoo and Nam, Beomseok},
 doi = {10.1145/3786654},
 issue_date = {February 2026},
 journal = {Proc. ACM Manag. Data},
 keyword = {learned indexes, merging linear models, lsm tree},
 month = {April},
 number = {1},
 numpages = {26},
 publisher = {Association for Computing Machinery},
 title = {From Learning to Recycling: A Log-Structured Learned-Less Index},
 url = {https://doi.org/10.1145/3786654},
 volume = {4},
 year = {2026}
}
