@article{Srivastava20226201,
 abstract = {Efficient feature extraction and its application in scene labelling is a rapidly growing field in the area of computer vision and image processing. Many applications such as semantic labelling, object tracking, and augmentative reality have required robust feature selection methods. This paper proposes a two-step robust LM-MFP method for pixel-wise semantic image parsing in a pixel-labelled environment. In step 1, we have generated the morphological features from an image using attribute filters. Firstly, the image features based on attributes like area, diagonal, and inertia have been extracted and arranged in the form of a min-tree and max-tree architecture. Then, we have decided on some iterative threshold for tree pruning and obtained several distinct and redundant features. Although these features are highly informative, many are redundant. Therefore in step 2, we have explored a feature pooling method to discard the redundant features using similarity measures. For the measurement of similarity between two features, we have taken three parameters, i.e. correlation (ρ), structural similarity (SSIM), and mutual information (MI). Subsequently, we formulated a hypothesis based upon the predicate containing ρ, SSIM, and MI as a variable. Based on the hypothesis, the redundant features are extracted, and a weighted average has taken for those features. This process has resulted in an exclusive and non-redundant features space. The reduced feature space has been used for pixel-based semantic classification for labelled images. Finally, we have applied a multi-class SVM to train the available pixel-label set model. The complete pixel set of the image has been used in the prediction of labelled objects by using the trained SVM model. The proposed LM-MFP approach has achieved 90.96, 89.03, 90.57, 91.12, and 93.63% accuracy for highway, house, sheep, horse rider, and horse keeper images, respectively, obtained from sift-flow and pascal-voc datasets. Conclusively in the comparative analysis section, the LM-MFP method has been observed to be state-of-art since it has significantly outperformed the previous techniques. © 2022, The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature.},
 author = {Srivastava, Vishal and Biswas, Bhaskar},
