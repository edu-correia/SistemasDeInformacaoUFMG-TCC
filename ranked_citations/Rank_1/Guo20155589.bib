@article{Guo20155589,
 abstract = {Researches on community detection in signed social networks focus on the assignment of positive and negative edges. However, the community detection approaches that positive and negative edges are handled separately in two phases cannot make full use of negative edges, which seriously affects the accuracy of community detection. To solve the problem, a new algorithm called CDA SM (Community Detection Algorithm Based on Statistics and Merger) is proposed: merge into the two phases as an unified process; in the process of community detection, the node shall be added to the community in which the node has the maximum contribution as well as the minimum interference degree. The accuracy and time efficiency of CDA SM have been demonstrated through a set of experiments including both un-weighted common networks and un-weighted signed social networks. © 2015 by Binary Information Press},
 author = {Guo, Jingfeng and Zhao, Yue and Hu, Xinzhuan and Liu, Yuanying},
 doi = {10.12733/jics20106718},
 journal = {Journal of Information and Computational Science},
 note = {Cited by: 0},
 number = {15},
 pages = {5589 - 5599},
 publication_stage = {Final},
 source = {Scopus},
 title = {Community detection algorithm in signed social networks based on statistics and merger},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84950159983?origin=resultslist},
 volume = {12},
 year = {2015}
}
