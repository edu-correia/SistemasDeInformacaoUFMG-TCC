@inproceedings{11120758,
 abstract = {Facial dysphagia intensity classification is an important technique in the fields of human-robot interaction of intelligent meal-assisting robotics. However, traditional single deep neural network models struggle to capture subtle facial changes and sequential information, hindering accurate hierarchical classification of dysphagia intensity levels. This paper presents an integrated neural network model (INNM) which combines the feature extraction abilities of convolutional neural networks (CNN) and the sequential comprehension of bidirectional long short-term memory networks (BiLSTM). The INNM comprises a feature extraction network and a converged CNN-ConvBiLSTM network. In the feature extraction phase, we enhance the YOLOv8s-cls architecture by integrating deformable convolutions to better capture fine spatial details of facial expressions. Furthermore, we incorporate the CloFormer attention mechanism to effectively perceive both local high-frequency and global low-frequency information. In the converged CNN-ConvBiLSTM network, we develop an algorithm that merges a triple-layer hybrid CNN with ConvBiLSTM, utilizing a jumping-connection strategy to bolster the capacity for memorizing long-term and short-term sequences while enhancing spatial information integration. Extensive experiments reveal that the INNM significantly outperforms baseline models and current state-of-the-art methods in dysphagia intensity classification, achieving remarkable accuracy. Ablation studies further validate the effectiveness of each enhancement.},
 author = {Fan, Yuhe and Zhang, Lixun and Wang, Keyi and Liu, Yi and Li, Jinghang and Wang, Zhenhan and Xue, Feng and Che, Huaiyu},
 booktitle = {2025 IEEE International Conference on Mechatronics and Automation (ICMA)},
 doi = {10.1109/ICMA65362.2025.11120758},
 issn = {2152-744X},
 keyword = {Analytical models;Accuracy;Human-robot interaction;Bidirectional long short term memory;Feature extraction;Safety;Convolutional neural networks;Robots;Optimization;Videos;Integrated neural network model;Facial expressions;Dysphagia intensity classification;Meal-assisting robotics;Human-robot interaction},
 month = {Aug},
 number = {},
 pages = {511-515},
 title = {An Integrated Neural Network Model for Classifying Dysphagia Intensity from Facial Expressions},
 volume = {},
 year = {2025}
