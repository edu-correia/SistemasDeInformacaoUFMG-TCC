@article{10966008,
 abstract = {Polygonal approximation (PA) techniques have been widely applied in the field of pattern recognition, classification, shape analysis, identification, 3D reconstruction, medical imaging, digital cartography, and geographical information system. In this paper, we focus on some of the key techniques used in implementing the PA algorithms. The PA can be broadly divided into three main category, dominant point detection, threshold error method with minimum number of break points and break points approximation by error minimization. Of the above three methods, there has been always a tradeoff between the three classes and optimality, specifically the optimal algorithm works in a computation intensive way with a complexity ranges from 0 (N2) to 0 (N3).The heuristic methods approximate the curve in a speedy way, however they lack in the optimality but have linear time complexity. Here a comprehensive review on major PA techniques for digital planar curve approximation is presented.},
 author = {Raja, Kiruba Thangam and Ray, Bimal Kumar},
 doi = {10.13052/jmm1550-4646.1815},
 issn = {1550-4654},
 journal = {Journal of Mobile Multimedia},
 keyword = {Three-dimensional displays;Reviews;Shape;Digital images;Integral equations;Approximation algorithms;Minimization;Classification algorithms;Pattern recognition;Time complexity;Contour;break points;split and merge;dominant points;polygonal approximation;digital planar curve;integral square error;chain code;digital image boundary},
 month = {January},
 number = {1},
 pages = {89-118},
 title = {An Analysis on Polygonal Approximation Techniques for Digital Image Boundary},
 volume = {18},
 year = {2022}
}
