@conference{Zhou2023,
 abstract = {This article proposes a brief review of decision-making technology for autonomous vehicles since it significantly impacts the safety and efficiency of autonomous vehicles. With the development of technology, vehicles with intelligent driving technology are already driving on our roads and streets, and most of them are partially autonomous vehicles. A complex, dynamic, and interactive environment poses significant hurdles to autonomous driving vehicles. Because of the strong interactions between different traffic participants, autonomous vehicles must consider interaction when making decisions. Therefore, this paper focuses on these practical challenges of decision-making: interaction with other traffic participants and human-machine cooperation. Popular practices and algorithms of decision-making methods in existing autonomous are summarized and analyzed. Moreover, this article also looks forward to the issues that future research should pay attention to. © 2023 IEEE.},
 author = {Zhou, Yuwei and Hu, Jin and Yang, Yuhua and Gao, Hang and Yang, Fan},
 doi = {10.1109/CVCI59596.2023.10397250},
 journal = {Proceedings of the 2023 7th CAA International Conference on Vehicular Control and Intelligence, CVCI 2023},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Advances in Decision-Making for Autonomous Vehicles: A Review},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85185380089?origin=resultslist},
 year = {2023}
}
