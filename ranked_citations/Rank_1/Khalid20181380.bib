@conference{Khalid20181380,
 abstract = {The Shortest Common Superstring (SCS) is an NP-hard problem in computer science with applications ranging from matrix compression to DNA Sequencing. In sequence assembly, the SCS can determine the precise order of DNA fragments. Previous implementations have adopted sequential approaches to the SCS problem. These approaches do not take advantage of massively parallel architectures and fail to reuse computed overlap values between fragments making them inefficient for large data sets. This paper presents a parallel approach to the SCS problem in DNA sequencing. The proposed method utilizes the concept of distributed cache to compute and store overlap values of fragments, and a reduction procedure to merge fragments with high overlapping values recursively until a superstring is obtained. The proposed method greatly reduces memory footprint and scales across multiple nodes in multi-core architectures. © 2018 IEEE.},
 author = {Khalid, Ali and Enem, Anthony and Colmenares, Eduardo},
 doi = {10.1109/CSCI46756.2018.00267},
 journal = {Proceedings - 2018 International Conference on Computational Science and Computational Intelligence, CSCI 2018},
 note = {Cited by: 1},
 pages = {1380 - 1385},
 publication_stage = {Final},
 source = {Scopus},
 title = {Distributed cache-reduction approach to DNA sequencing using a greedy algorithm for the shortest common superstring},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85078538135?origin=resultslist},
 year = {2018}
}
