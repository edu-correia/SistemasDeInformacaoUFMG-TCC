@article{Zhang201150,
 abstract = {Image tagging is a task that automatically assigns the query image with semantic keywords called tags. Since tags and image visual content are represented in different feature space, how to merge the multiple features by their correlation to tag the query image is an important problem. However, most of existing approaches merge the features by using a relatively simple mechanism rather than fully exploiting the correlations between different features. In this paper, we propose a new approach to fusing different features and their correlation simultaneously for image tagging. Specifically, we employ a Feature Correlation Graph to capture the correlations between different features in an integrated manner, which take features as nodes and their correlations as edges. Then, a revised probabilistic model based on Markov Random Field is used to describe the graph for evaluating tag's relevance to query image. Experiments on large real-life corpuses collected from Flickr indicate the superiority of our proposed approach. © 2011 Springer-Verlag.},
 author = {Zhang, Xiaoming and Li, Zhoujun},
 doi = {10.1007/978-3-642-24826-9_10},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {50 - 59},
 publication_stage = {Final},
 source = {Scopus},
 title = {Image tagging by exploiting feature correlation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/80455162352?origin=resultslist},
 volume = {7008 LNCS},
 year = {2011}
}
