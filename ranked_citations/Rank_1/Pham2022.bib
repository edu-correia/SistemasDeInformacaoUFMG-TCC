 publication_stage = {Final},
 source = {Scopus},
 title = {No Cell Left behind: Automated, Stochastic, Physics-Based Tracking of Every Cell in a Dense, Growing Colony},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85124077213?origin=resultslist},
 volume = {15},
