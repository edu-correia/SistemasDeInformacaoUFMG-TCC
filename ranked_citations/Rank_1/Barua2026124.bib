@conference{Barua2026124,
 abstract = {Semantic image segmentation has long been studied to identify regions of interest in a digital image semantically. Deep learning-based methods represent a major advancement in this field, achieving state-of-the-art results by automatically learning powerful representations from data. However, these methods often require a large amount of annotated data and struggle with complex scenes or objects that have detailed features. In contrast, traditional hand-crafted feature-based methods are robust to data variations but may lack the ability to capture highlevel semantic information. In this paper, we introduce a new fusion approach called Hybrid Modality Attention-based Fusion (HMAF), which combines the strengths of handcrafted and deeplearned features. Our method uses an innovative attention mechanism to dynamically assign importance to each feature modality, enabling the model to focus on the most relevant information for segmentation. This process involves an attention block that takes both feature sets and produces attention weights, which are then used to merge the features into a unified representation. We validate our approach through extensive experiments on a well-known benchmark dataset, demonstrating that HMAF outperforms individual hand-crafted and deep learning methods and provides competitive results compared to existing advanced fusion techniques. © 2026 IEEE.},
 author = {Barua, Shemonti and Yellu, Siri and Koganti, Sai Chandana and Yun, Jihoon and Lee, Sanghoon},
 doi = {10.1109/ICSC67292.2026.00024},
 journal = {Proceedings - IEEE International Conference on Semantic Computing, ICSC},
 note = {Cited by: 0},
 pages = {124 - 127},
 publication_stage = {Final},
 source = {Scopus},
 title = {HMAF: Hybrid Modality Attention for Fusing Hand-crafted and Deep-learned Features},
 type = {Conference paper},
