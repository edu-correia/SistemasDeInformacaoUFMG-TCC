@conference{Collins201737,
 abstract = {We describe a deep learning convolutional neural network (CNN) for enhancing low resolution multispectral satellite imagery without the use of a panchromatic image. For training, low resolution images are used as input and corresponding high resolution images are used as the target output (label). The CNN learns to automatically extract hierarchical features that can be used to enhance low resolution imagery. The trained network can then be effectively used for super-resolution enhancement of low resolution multispectral images where no corresponding high resolution image is available. The CNN enhances all four spectral bands of the low resolution image simultaneously and adjusts pixel values of the low resolution to match the dynamic range of the high resolution image. The CNN yields higher quality images than standard image resampling methods. © 2017 Association for Computing Machinery.},
 author = {Collins, Charles B. and Beck, John M. and Bridges, Susan M. and Rushing, John A. and Graves, Sara J.},
 doi = {10.1145/3149808.3149815},
 journal = {Proceedings of the 1st Workshop on GeoAI: AI and Deep Learning for Geographic Knowledge Discovery, GeoAI 2017},
 note = {Cited by: 15; All Open Access; Gold Open Access},
 pages = {37 - 44},
 publication_stage = {Final},
 source = {Scopus},
 title = {Deep learning for multisensor image resolution enhancement},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85040242092?origin=resultslist},
 year = {2017}
}
