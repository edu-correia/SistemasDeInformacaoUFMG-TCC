@inproceedings{11040339,
 abstract = {Blockchain technology has created a revolution in secure and decentralized data sharing; however, blockchain communication will face issues in confidentiality, integrity, and authenticity over the data running in blockchain networks. This research presents a method to Secure Blockchain Communication via Multi-Authentication Homomorphic Signature; this is intended to strengthen both security and scalability. Multi-Authentication Homomorphic Signature (MAHS) thus allows a decentralized authentication process in which several trusted authorities can simultaneously sign and verify data while retaining their individual control and autonomy. First, the homomorphic properties guarantee that sensitive knowledge is not revealed during data transmission, and second, it allows data to be data-enabled without Tampering. By embedding these signatures into the blockchain, the framework greatly reduces risks related to a single-point failure, insider attacks, or any unauthorized modifications of data. The system will be tested in regard to attack resilience, computational overhead, and compatibility with existing blockchain architectures. The experimental results show sufficiently low communication overhead while the security consideration remains quite solid under MAHS, thus this is the single choice for the secure communication purpose through an application, such as supply chain, healthcare, and financial system. The research sets the stage for next-generation blockchain frameworks, merging cryptographic ingenuity with decentralized trust.},
 author = {Kumar, Ragupathi Nithish and Kumar A, Santhosh and S M.E, Vadivel},
 booktitle = {2025 3rd International Conference on Artificial Intelligence and Machine Learning Applications Theme: Healthcare and Internet of Things (AIMLA)},
 doi = {10.1109/AIMLA63829.2025.11040339},
 issn = {},
 keyword = {Data privacy;Supply chain management;Scalability;Supply chains;Authentication;Medical services;Solids;Blockchains;Homomorphic encryption;Resilience;Blockchain;Multi-Authentication Homomorphic Signature (MAHS);decentralization;privacy;encryption;decryption},
 month = {April},
