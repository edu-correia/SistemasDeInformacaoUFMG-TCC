@conference{Russell201651,
 abstract = {We propose an approach to extracting information from text based on the hypothesis that text sometimes describes the world. The hypothesis is embodied in a generative probability model that describes (1) possible worlds and the facts they might contain, (2) how an author chooses facts to express, and (3) how those facts are expressed in text. Given text, information extraction is done by computing a posterior over the worlds that might have generated it. As a by-product, this unsupervised learning process discovers new relations and their textual expressions, extracts new facts, disambiguates instances of polysemous expressions, and resolves entity references. The probability model also explains and improves on Brin's bootstrapping heuristic, which underlies many open information extraction systems. Preliminary results on a small corpus of New York Times text suggest that the approach is effective. © Proceedings of the 5th Workshop on Automated Knowledge Base Construction, AKBC 2016 at the 2016 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies, NAACL-HLT 2016. All rights reserved.},
 author = {Russell, Stuart and Lassen, Ole Torp and Uang, Justin and Wang, Wei},
 doi = {10.18653/v1/w16-1310},
 journal = {Proceedings of the 5th Workshop on Automated Knowledge Base Construction, AKBC 2016 at the 2016 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies, NAACL-HLT 2016},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 pages = {51 - 56},
 publication_stage = {Final},
 source = {Scopus},
 title = {The physics of text: Ontological realism in information extraction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85120058566?origin=resultslist},
 year = {2016}
}
