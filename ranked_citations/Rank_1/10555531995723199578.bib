@article{10.5555/3199572.3199578,
 abstract = {This paper describes the implementation of a peer-teaching video system for entry-level computer science courses. The uniqueness and main contributions of the system are: 1) It provides a new form of active-learning, which has been proven to have positive influence on students. 2) Each video is created by our CS students rather than by professionals. 3) Each video only focuses on a challenging concept; and only lasts at most 10 minutes. The system provides an additional way for instructors to integrate with the traditional approaches by using the widely available high-speed internet and mobile devices. The collected results show that the system is effective and beneficial to our CS students.},
 address = {Evansville, IN, USA},
 author = {Phelps, Gita and Liu, Yi},
 issn = {1937-4771},
 issue_date = {April 2018},
 journal = {J. Comput. Sci. Coll.},
 month = {April},
 number = {4},
 numpages = {7},
 pages = {45–51},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {The study and investigation of a new form of active-learning for CS: peer-teaching with videos},
 volume = {33},
 year = {2018}
}
