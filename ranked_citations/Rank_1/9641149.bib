@inproceedings{9641149,
 abstract = {In Multi-user Multiple Input Multiple Output (MIMO) systems, Multiple Access Interference is a key problem caused by the simultaneous data transmission of different users which introduces error bits at the receiver side. Space Time Block Codes (STBC) are one of the probable solutions that mitigate time-varying channel fading. In Multi-user MIMO, Channel inversion is an efficient transmission method that precodes the symbols with the channel gain to cancel out the cochannel interference. These methods face problems of Channel State Information feedback to the transmitter, radiation power limitation, and low code rate. This paper proposes a method to overcome the fading and interference at lower signal or radiation power. Channel inversion technique of downlink of a massive Multi-user MIMO system and Alamouti 2×1 STBC were merged to increase the channel diversity and minimize the interferences at the same time. First, generalized form of STBC, Alamouti STBC, a model of Multi-user MIMO and its transmission with STBC were analyzed with mathematical descriptions. Then, channel inversion technique combining with Alamouti 2×1 STBC was mathematically analyzed. Finally, these techniques were simulated and analyzed the performance in terms of bit error rate (BER). BER analysis shows that increasing active users introduce additive fading and interferences. The proposed combination minimizes the co-channel interference and increases diversity with more power efficiency to solve radiation power limitation without throughput degradation.},
 author = {Abeden, Sharif Minhazul and Alam, S.M. Shamsul and Hasan, Md Khaled},
 booktitle = {2021 International Conference on Electronics, Communications and Information Technology (ICECIT)},
 doi = {10.1109/ICECIT54077.2021.9641149},
 issn = {},
 keyword = {Fading channels;Costs;Transmitters;Bit error rate;Diversity reception;Complexity theory;Block codes;MIMO;Multi-user MIMO;STBC;Alamouti STBC;Channel Inversion;Bit Error Rate},
 month = {Sep.},
 number = {},
 pages = {1-4},
 title = {Response of Channel Inversion Technique with Space Time Block Code in Multi-User MIMO},
 volume = {},
 year = {2021}
}
