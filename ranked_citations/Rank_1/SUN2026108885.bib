@article{SUN2026108885,
 abstract = {This study investigates how sea-breeze fronts (SBFs) and gust fronts (GFs) influence the initiation, intensification, and evolution of convective cells, focusing on a series of “back-building” supercells that occurred in Shanghai on 5 July 2017. Multiple observational and modeling datasets were investigated, including weather radar, sounding data, wind profilers, and the cloud-resolving model CM1. Results indicate that the development of the SBF significantly modified the boundary-layer wind structure and enhanced low-level vertical wind shear. When superimposed with the strong outflow boundary of the supercell, this leads to a substantial increase in storm-relative helicity, affecting convective cell intensity, lifespan, and propagation—key factors in supercell formation and development. The study also identifies a potential mechanism for backward propagation: intensification of the SBF and GF created an unstable Kelvin-Helmholtz layer atop the cold pool, which is inferred to have excited gravity waves. These waves likely contributed to enhanced updrafts and thickening of the cold pool. Additionally, interaction between the cold pool and the ambient southwesterly jet produced a new low-level jet, further strengthening the updraft. These findings advance the understanding of the back-building supercell dynamics in eastern coastal China and provide valuable insights for nowcasting and early warning.},
 author = {Min Sun and Jianhua Dai and Huiling Yuan and Jianming Xu and Haojun Chen and Jiakai Zhu},
 doi = {https://doi.org/10.1016/j.atmosres.2026.108885},
 issn = {0169-8095},
 journal = {Atmospheric Research},
 keyword = {Supercell, Sea-breeze front (SBF), Gust front (GF), Back-building, Convective evolution},
 pages = {108885},
 title = {Sea-breeze and gust front influences on supercell evolution: Observational and numerical insights},
 url = {https://www.sciencedirect.com/science/article/pii/S0169809526001493},
 volume = {336},
 year = {2026}
}
