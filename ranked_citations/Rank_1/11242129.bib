@article{11242129,
 abstract = {Conventional techniques in sports data analysis typically depend on fixed attributes and singular occurrences, which constrains their capacity to reflect the evolving and intricate dynamics of athletic competition. Such methodologies encounter challenges when attempting to represent sequential patterns and inter-player relationships—elements that are essential for reliable forecasting of performance and tactical decision-making. In response to these challenges, we introduce an innovative architecture that merges a Temporal-Interaction Transformer (TITAN) with a strategy-enhancing module enriched by domain-specific knowledge, termed PlayNet-Augment. TITAN employs a dual-stream encoder to jointly model temporal event sequences and player interaction graphs, capturing both short-term and long-range dependencies inherent in sports data. PlayNet-Augment enhances interpretability by integrating structured playbooks and strategic hierarchies into the learning process, facilitating human-in-the-loop decision-making. Our approach demonstrates superior performance in predictive accuracy and provides actionable insights for coaches and analysts, thereby contributing to the advancement of applied sciences in the realm of sports analytics.},
 author = {Zhou, Shuyi and Zhu, Ming},
 doi = {10.1109/ACCESS.2025.3631851},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {Sports;Adaptation models;Training;Deep learning;Data models;Analytical models;Injuries;Predictive models;Accuracy;Computer architecture;Deep learning;sports analytics;temporal modeling;player;strategic optimization},
 month = {},
 number = {},
 pages = {210758-210771},
 title = {Enhancing Athlete Performance Using Deep Learning Techniques in Sports Analytics},
 volume = {13},
 year = {2025}
}
