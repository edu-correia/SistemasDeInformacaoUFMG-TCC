@article{YUAN2025113550,
 abstract = {This paper proposes a low-light image enhancement algorithm integrating dual-stream collaborative optimization and domain adaptation mechanisms. By hierarchically coupling physics-driven and data-driven approaches, the method addresses luminance degradation, chromatic distortion, and cross-domain generalization in extreme dark scenarios. The physics-driven branch employs an improved dark channel prior model with atmospheric scattering modeling to achieve robust initial illumination estimation and chromatic pre-correction. A degradation-aware domain transfer strategy maps physics-based outputs to YCbCr space via differentiable color transformations, followed by an enhanced HR-Net architecture with shared front-end feature extraction and bifurcated back-end optimization: a high-dynamic-range feature module reconstructs texture details for luminance (Y) components, while a color-fidelity constraint unit suppresses chromatic deviations in chroma (Cb/Cr) components. The enhanced result is reconstructed through inverse transformation, forming a closed-loop framework from physics-guided global coarse correction to data-driven local fine restoration. Experiments demonstrate superior brightness enhancement and color fidelity preservation under extreme low-light conditions. The dual-stream architecture overcomes single-method limitations, and the gradient-differentiable cross-domain mapping enhances generalization. Validation across multiple datasets confirms outperformance of state-of-the-art methods in both quantitative metrics and visual quality.},
 author = {Bangzhe Yuan and Yuyang Li and Ying Liu and Jian Cheng and Junchao Zhang},
 doi = {https://doi.org/10.1016/j.optlastec.2025.113550},
 issn = {0030-3992},
 journal = {Optics & Laser Technology},
 keyword = {Low-light image enhancement, HR-Net, Dual-stream collaborative optimization, Atmospheric scattering model},
 pages = {113550},
 title = {Low-light image enhancement via collaborative dual-stream optimization with domain adaptation},
 url = {https://www.sciencedirect.com/science/article/pii/S0030399225011417},
 volume = {192},
 year = {2025}
}
