@article{MOON2026114826,
 abstract = {Urban density and energy consumption are closely interrelated, and investigating this relationship is critical for addressing urban energy and environmental challenges. The Floor Area Ratio (FAR) serves as a pivotal regulatory policy determining urban density. This study examines how FAR regulations affect building energy consumption per floor area. We develop a theoretical model where developers optimize energy consumption decisions under FAR constraints, showing that energy use intensity increases with allowed FAR. This relationship emerges from the increasing complexity and energy requirements of taller buildings. By leveraging the unique characteristics of New York City’s data, we merge information on building attributes and regulation levels, and integrate energy consumption data from the NYC Benchmarking Law (Local Law 84). Our findings empirically validate our theoretical prediction that stricter FAR regulations correlate with higher energy consumption per unit area, indicating that adjustments in regulatory intensity can affect urban energy use. These insights have profound implications for future urban policy development.},
 author = {Byunggeor Moon},
 doi = {https://doi.org/10.1016/j.enpol.2025.114826},
 issn = {0301-4215},
 journal = {Energy Policy},
 keyword = {Floor area ratio, Energy consumption, Urban density, Building regulations, New York city},
 pages = {114826},
 title = {The energy cost of height: How FAR regulations drive building energy consumption},
 url = {https://www.sciencedirect.com/science/article/pii/S0301421525003337},
 volume = {212},
 year = {2026}
}
