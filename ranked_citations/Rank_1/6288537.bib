@inproceedings{6288537,
 abstract = {A fine grain scalable coding for audio signals is proposed where the entropy coding of the quantizer outputs is made scalable. By constructing a Huffman-like coding tree where internal nodes can be mapped to reconstruction points, we can prune the tree to control the distortion of the quantizer. Our results show the proposed method improves existing similar work and significantly outperforms scalable coding based on reconstruction error quantization as used in practical systems, eg. MPEG-4 audio.},
 author = {Movassagh, Mahmood and Thiemann, Joachim and Kabal, Peter},
 booktitle = {2012 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP.2012.6288537},
 issn = {2379-190X},
 keyword = {Quantization;Entropy coding;Merging;Laplace equations;Bit rate;Distortion measurement;Scalable coding;Entropy coding;Quantization},
 month = {March},
 number = {},
 pages = {2961-2964},
 title = {Joint entropy-scalable coding of audio signals},
 volume = {},
 year = {2012}
}
