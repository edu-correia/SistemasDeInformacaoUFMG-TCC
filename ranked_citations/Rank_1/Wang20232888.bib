@article{Wang20232888,
 abstract = {This paper proposes a two-stage trajectory planning method for self-driving vehicles (SDVs) in intersection scenarios with uncertain social circumstances while considering other traffic participants, which are human-driving vehicles (HDVs) with different driving styles. The mixture-of-experts approach is first utilized to learn from human-driving trajectory data to construct a multimodal motion planner, which uses a Transformer to model the interactions between vehicles by explicitly considering their driving styles to facilitate the integrated network to achieve scene-consistent multimodal trajectory prediction and candidate trajectory generation. Second, based on the generated trajectories for the SDV and the predicted trajectories for the other HDVs, each candidate planning trajectory is evaluated via a safety-balanced value function. After that, the trajectory with the highest value is selected for implementation. Such a method plans a safe and efficient driving trajectory in complex and uncertain scenarios. The experimental results demonstrate the efficiency and effectiveness of the designed method as well as the robustness and reasonableness of the SDVs' maneuver decisions at an intersection considering the behavioral dynamics of HDVs.  © 2016 IEEE.},
 author = {Wang, Xiao and Tang, Ke and Dai, Xingyuan and Xu, Jintao and Xi, Jinhao and Ai, Rui and Wang, Yuxiao and Gu, Weihao and Sun, Changyin},
 doi = {10.1109/TIV.2023.3239903},
 journal = {IEEE Transactions on Intelligent Vehicles},
 note = {Cited by: 72; All Open Access; Hybrid Gold Open Access},
 number = {4},
 pages = {2888 - 2898},
 publication_stage = {Final},
 source = {Scopus},
 title = {Safety-Balanced Driving-Style Aware Trajectory Planning in Intersection Scenarios With Uncertain Environment},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85148454441?origin=resultslist},
