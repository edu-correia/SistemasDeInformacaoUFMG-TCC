@conference{Zheng2025459,
 abstract = {Cloud workload prediction is necessary for resource provisioning optimization and ensuring efficient operation of cloud computing systems. Traditional time-series prediction models have primarily relied on time-domain features, without the ability to comprehensively model the dependency of cloud workloads across multiple time scales. In this paper, we present WDBformer, a novel dual-branch framework that integrates both time-domain and frequency-domain features for accurate cloud workload prediction. The presented model uses a wavelet-enhanced branch to capture frequency-domain features and a time-domain branch for temporal dependency modeling, and adopts an efficient and simple fusion mechanism to merge time-frequency features to address the problem of multi-scale dependencies in cloud workload data. Evaluation on the Azure-2017 and Alibaba-2021 datasets shows that WDBformer is better than existing state-of-the-art models on long-term workload prediction with increased accuracy. Our approach provides a promising solution to the complex problem of cloud workload forecasting, and it can be used in dynamic resource planning and system optimization.  © 2025 Copyright held by the owner/author(s).},
 author = {Zheng, Weijian and Zheng, Weiping and Chen, Yiqi and Wang, Zichen},
 doi = {10.1145/3730436.3730513},
 journal = {Proceedings of 2025 International Conference on Artificial Intelligence and Computational Intelligence, AICI 2025},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {459 - 464},
 publication_stage = {Final},
 source = {Scopus},
 title = {Wavelet-enhanced Dual Branch Transformer for Accurate Cloud Workload Prediction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105013080285?origin=resultslist},
 year = {2025}
}
