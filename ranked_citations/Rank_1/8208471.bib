@article{8208471,
 abstract = {The coalescence of two white dwarfs in a close binary system was investigated using hydrodynamical simulations. The Godunov Smoothed Particle Hydrodynamics method was adopted for the calculations. We performed various models of binary systems with different masses and mass ratios of the white dwarfs. As a result of coalescence, an accretion disk is formed around the primary star. The characteristic quantities of the disks, such as the temperature and rotation profile, were found to be independent of the initial binary parameters. We also discuss the subsequent evolution of the accretion disk and the possibility of a Type Ia supernova explosion from the merging of two white dwarfs.},
 author = {Shioya, Toshinao and Sano, Takayoshi and Takabe, Hideaki and Tsuribe, Toru},
 doi = {10.1093/pasj/59.4.753},
 issn = {2053-051X},
 journal = {Publications of the Astronomical Society of Japan},
 keyword = {white dwarfs;binaries: close;supernovae: general},
 month = {Aug},
 number = {4},
 pages = {753-761},
 title = {The Structure of Accretion Disks Formed by Merging of White Dwarfs},
 volume = {59},
 year = {2007}
}
