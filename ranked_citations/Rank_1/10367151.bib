@inproceedings{10367151,
 abstract = {Reversible data hiding in encrypted images (RDHEI) has become a hot topic, and a lot of methods are proposed to optimize this technology. However, these methods do not make full use of image spatial correlation, which may cause their outcomes to be flawed. In this paper, we propose an advanced scheme, the main contributions of which include two points. First, we introduce the four-color theorem approach to the image processing field for the first time. Second, we extend the four-color theorem to facilitate RDHEI. Experiments show that the embedding rate of the proposed scheme can outperform other RDHEI algorithms, and the PSNR value of the recovered image can be infinite.},
 author = {Liu, Zi-Long and Pun, Chi-Man},
 booktitle = {2023 13th International Conference on Information Science and Technology (ICIST)},
 doi = {10.1109/ICIST59754.2023.10367151},
 issn = {2573-3311},
 keyword = {Information science;Correlation;Image processing;Cryptography;reversible data hiding;encrypted image;spatial correlation;four-color theorem},
 month = {Dec},
 number = {},
 pages = {663-667},
 title = {Reversible Data Hiding in Encrypted Images Using Four-Color Approach},
 volume = {},
 year = {2023}
}
