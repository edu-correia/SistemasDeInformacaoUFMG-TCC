@article{Tomaszuk2026,
 abstract = {Property-graph query languages have matured, but controlled materialization of reusable derived graph knowledge has remained comparatively under-specified. In many practical workloads, transient query answers are not enough: applications need persistent derived relationships, defaults, alerts, and provenance that can be reused and audited across downstream queries and services. We addressed this gap by presenting GQL Rules, a restricted rule layer for property graphs that combined a Cypher/GQL-style MATCH/WHERE body with an inflationary head based on MERGE and additive ENRICH. The framework targeted static finite graphs, preserved first-class edge identity, exposed explicit diagnostics and per-rule policies for imperfect inputs, and limited negation to stratified NOT EXISTS. We formalized a stratified fixpoint semantics and gave sufficient conditions for safety, finite generation, and deterministic saturated outcomes, together with a semi-naive evaluation strategy for recursive strata as part of the formal proposal. We also implemented a Neo4j/APOC wrapper-based proof of concept and reported preliminary results on representative workloads; these showed correct saturation behavior, deterministic final states under the stated conditions, and naive-fixpoint recursive-scaling trends that motivate the proposed semi-naive strategy. © 2013 IEEE.},
 author = {Tomaszuk, Dominik},
 doi = {10.1109/ACCESS.2026.3686122},
 journal = {IEEE Access},
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 pages = {},
 publication_stage = {Article in press},
 source = {Scopus},
 title = {GQL Rules: Deterministic and Safe Rule-Based Materialization for Property Graphs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105036830776?origin=resultslist},
 year = {2026}
}
