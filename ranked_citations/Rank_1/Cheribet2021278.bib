@article{Cheribet2021278,
 abstract = {Image segmentation remains as one of the most important tasks for image analysis and understanding. It deals with raw images in order to prepare them to be usable in automatic high-level processes, such as classification or information retrieval. We present in this paper a new adapted edge detector for range images. Its principle is inspired from the Canny detector, so the inherent features of range images will be considered. Usually, Canny detector is used with greyscale or color images, where its direct application with depths does not provide satisfactory results. From the raw image, containing measured depths, a relief image that consists of an image of normal vectors to the local surfaces is computed. So, angles between neighboring vectors are used to compute an angle-based gradient. The latter is integrated in the Canny algorithm, so an edge map is produced for the range image. Real images from the ABW database were used in experimentation, where the proposed new detector has outperformed the original Canny one by a ratio of 18 %. © 2021, Scientific Research Support Fund of Jordan. All rights reserved.},
 author = {Cheribet, Mohamed and Mazouzi, Smaine},
 doi = {10.5455/JJCIT.71-1620428305},
 journal = {Jordanian Journal of Computers and Information Technology},
 note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access},
 number = {3},
 pages = {278 - 291},
 publication_stage = {Final},
 source = {Scopus},
 title = {A new adapted canny filter for edge detection in range images},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85114715677?origin=resultslist},
 volume = {7},
 year = {2021}
}
