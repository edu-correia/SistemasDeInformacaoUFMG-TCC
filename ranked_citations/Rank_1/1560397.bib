@inproceedings{1560397,
 abstract = {Expanding the Internet infrastructure to span mobile devices is a challenging task. The Internet's addressing and routing scheme was originally designed for fixed devices making it inoperable without redirection and tracking functions such as those proposed by mobile IP. However, mobile IP requires prior network setup, and causes a large added overhead. In this paper, we propose a new approach to support mobile IP users using a peer-to-peer overlay network. The proposed overlay exploits locality to efficiently use the network resources and manage location data in a self-organizing and distributed fashion. The simulation results are presented.},
 author = {Le, H. and Hoang, D. and Simmonds, A. and Yousef, B. and Chan, J.},
 booktitle = {INDIN '05. 2005 3rd IEEE International Conference on Industrial Informatics, 2005.},
 doi = {10.1109/INDIN.2005.1560397},
 issn = {2378-363X},
 keyword = {Peer to peer computing;IP networks;Internet;Routing;Mobile computing;Information technology;Resource management;Humans;Earth;Merging},
 month = {Aug},
 number = {},
 pages = {325-330},
 title = {An efficient mechanism for mobility support using peer-to-peer overlay networks},
 volume = {},
 year = {2005}
}
