@article{Thaalbi2013407,
 abstract = {We propose a cross layer approach to achieve greater routing performance for applications with real time constraints in Mobile Ad Hoc Networks. Interactions between MAC, Network and Application layers are fully exploited to get accurate information about the end-to-end path quality, and the applications' characteristics. The improvements provided by our scheme come from considering a service class differentiation, a balanced routing protocol and a path quality cost function as well. It aims to enhance the routing performance for real time applications to meet the QoS requirements defined by the ITU-G1010 recommendation. The simulation results and analysis show that our contribution achieves a good performance and capacity gain. © 2013 Springer-Verlag.},
 author = {Thaalbi, Mariem and Tabbane, Nabil and Bejaoui, Tarek and Meddahi, Ahmed},
 doi = {10.1007/978-3-642-40316-3_36},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3},
 pages = {407 - 419},
 publication_stage = {Final},
 source = {Scopus},
 title = {A cross layer balanced routing protocol for differentiated traffics over mobile ad hoc networks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84885786158?origin=resultslist},
 volume = {8121 LNCS},
 year = {2013}
}
