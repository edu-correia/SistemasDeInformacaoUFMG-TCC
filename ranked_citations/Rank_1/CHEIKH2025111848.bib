@article{CHEIKH2025111848,
 abstract = {This paper examines the integration of renewable energy (RE) sources into national power grids, with a focus on solar energy in the Middle East and North Africa (MENA) region. The study highlights the potential and variability of solar energy in Algeria, Tunisia, and Saudi Arabia, three countries with significant solar exposure. To improve the accuracy of solar power forecasting, we propose a novel hybrid model called the Long Short-Term Memory (LSTM)-Transformer, which combines LSTM networks with the Encoder Transformer architecture. Extensive testing under two distinct scenarios across diverse regional settings demonstrates the model’s robustness and scalability. Remarkable performance was achieved in Mostaganem (Algeria), Sfax (Tunisia), and Riyadh (Saudi Arabia), with Mean Squared Errors (MSE) of 0.0047 , 0.0045, and 0.0023 , Root Mean Squared Errors (RMSE) of 0.0680, 0.0670, and 0.0512 , and coefficients of determination (R2) of 93%, 94%, and 97%, respectively. Comparative analysis with existing literature confirms that our proposed model outperforms previously reported approaches. These findings underscore the effectiveness of integrating LSTM and Transformer technologies for solar forecasting while demonstrating the model’s adaptability to different geographic locations with varying solar intensities. This research represents a significant step toward advancing renewable energy adoption by providing a reliable predictive tool to enhance the stability and efficiency of photovoltaic (PV) solar power integration into energy systems.},
 author = {Ghizlene Cheikh and Boudour Ammar and Naourez Benhadj and Kamil Amine Bentounes and Hadj Adda Bentounes and Amel Ksibi and Ala Saleh Alluhaidan},
 doi = {https://doi.org/10.1016/j.engappai.2025.111848},
 issn = {0952-1976},
 journal = {Engineering Applications of Artificial Intelligence},
 keyword = {Renewable energy, Middle East and North Africa regions, Artificial intelligence, Solar power forecasting, Deep learning, Long short-term memory-transformer},
 pages = {111848},
 title = {Transformer-based deep neural networks for short-term solar power prediction in the Middle East and North Africa regions},
 url = {https://www.sciencedirect.com/science/article/pii/S0952197625018500},
 volume = {160},
 year = {2025}
}
