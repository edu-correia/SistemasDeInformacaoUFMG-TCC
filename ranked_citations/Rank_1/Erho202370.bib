@conference{Erho202370,
 abstract = {Juggling rotation of sequence or array requires very few element assignments. Yet, its performance is very poor on the average, especially as the sequence or array size increases. It is desirous that such optimal algorithm should perform better in execution. Hence, the intent of this research is to study the properties of the algorithm by defining crucial concepts and formulating equations that represent facts about the algorithm. The resulting definitions and formulations promise to foster the creation of an improved algorithmic performance, either by designing cache memory with locality reference that accommodates the behavioral pattern of the algorithm or modifying the algorithm to perform better. In the discussion, increased significance of the study was demonstrated using possible model of cache-sensitive juggling rotation pattern. Such outcome could be very useful for many systems especially embedded/real-Time systems, which are usually constrained by execution time deadlines and limited memory availability.  © 2023 IEEE.},
 author = {Erho, Joseph A. and Japheth, Bunakiye R. and Consul, Juliana I. and Asagba, Prince O.},
 doi = {10.1109/ICCRD56364.2023.10080407},
 journal = {2023 15th International Conference on Computer Research and Development, ICCRD 2023},
 note = {Cited by: 2},
 pages = {70 - 78},
 publication_stage = {Final},
 source = {Scopus},
 title = {Number and Classes of Rotations on Juggling Sequence Rotation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85152387731?origin=resultslist},
 year = {2023}
}
