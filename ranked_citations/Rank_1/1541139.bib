@inproceedings{1541139,
 abstract = {One of the most serious problems of smart card system such as Java card, is about an amount of insufficient memory. Moreover, most of the embedded devices with Java VM support the post-issuance of new applications. These applications are usually stored in the memory, which is usually EEPROM. The key idea of our approach is to reduce the size of CAP file by grouping byte-codes. With our approach, the size of CAP file is reduced over 10% than that of typical CAP file. The size reduction of CAP file means that more available space of EEPROM in Java Card. It also enables an application to be downloaded more quickly in the case of an application sent to a mobile phone via the GSM network.},
 author = {Min-Sik Jin and Min-Soo Jung},
 booktitle = {11th IEEE International Conference on Embedded and Real-Time Computing Systems and Applications (RTCSA'05)},
 doi = {10.1109/RTCSA.2005.17},
 issn = {2325-1301},
 keyword = {Java;Smart cards;Application software;EPROM;Mobile handsets;GSM;Frequency;Virtual machining;Merging;Virtual manufacturing},
 month = {Aug},
 number = {},
 pages = {551-554},
 title = {A study on how to reduce time and space by redefining new bytecode for Java card},
 volume = {},
 year = {2005}
}
