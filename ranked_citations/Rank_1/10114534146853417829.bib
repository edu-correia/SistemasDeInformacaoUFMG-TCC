@article{10.1145/3414685.3417829,
 abstract = {In this paper, we present a novel semi-analytical boundary handling method for spatially adaptive and divergence-free smoothed particle hydrodynamics (SPH) simulations, including two-way coupling. Our method is consistent under varying particle resolutions and allows for the treatment of boundary features below the particle resolution. We achieve this by first introducing an analytic solution to the interaction of SPH particles with planar boundaries, in 2D and 3D, which we extend to arbitrary boundary geometries using signed distance fields (SDF) to construct locally planar boundaries. Using this boundary-integral-based approach, we can directly evaluate boundary contributions, for any quantity, allowing an easy integration into state of the art simulation methods. Overall, our method improves interactions with small boundary features, readily handles spatially adaptive fluids, preserves particle-boundary interactions across varying resolutions, can directly be implemented in existing SPH methods, and, for non-adaptive simulations, provides a reduction in memory consumption as well as an up to 2\texttimes{} speedup relative to current particle-based boundary handling approaches.},
 address = {New York, NY, USA},
 articleno = {173},
 author = {Winchenbach, Rene and Akhunov, Rustam and Kolb, Andreas},
 doi = {10.1145/3414685.3417829},
 issn = {0730-0301},
 issue_date = {December 2020},
 journal = {ACM Trans. Graph.},
 keyword = {SPH, boundary handling, physical simulation, semi-analytical methods, spatial adaptivity, two-way coupling},
 month = {November},
 number = {6},
 numpages = {17},
 publisher = {Association for Computing Machinery},
 title = {Semi-analytic boundary handling below particle resolution for smoothed particle hydrodynamics},
 url = {https://doi.org/10.1145/3414685.3417829},
 volume = {39},
 year = {2020}
}
