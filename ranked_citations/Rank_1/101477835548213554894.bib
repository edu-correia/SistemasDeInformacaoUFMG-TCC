@article{10.14778/3554821.3554894,
 abstract = {The last decade has seen an emergence of numerous specialized graph DBMSs (GDBMSs) as well as graph-optimized extensions of RDBMSs. In addition, several query processing techniques, such as worst-case optimal join algorithms and factorized query processing, have been introduced in the context of RDBMSs, which find their best applications on graph workloads. In this tutorial, we review the recent advances in query processing techniques for graph workloads. For each technique, we first overview the theoretical foundations. Then, we overview how DBMSs implement these techniques. Finally, we discuss the open challenges for existing implementation approaches.},
 author = {Mhedhbi, Amine and Saliho\u{g}lu, Semih},
 doi = {10.14778/3554821.3554894},
 issn = {2150-8097},
 issue_date = {August 2022},
 journal = {Proc. VLDB Endow.},
 month = {August},
 number = {12},
 numpages = {4},
 pages = {3762–3765},
 publisher = {VLDB Endowment},
 title = {Modern techniques for querying graph-structured relations: foundations, system implementations, and open challenges},
 url = {https://doi.org/10.14778/3554821.3554894},
 volume = {15},
 year = {2022}
}
