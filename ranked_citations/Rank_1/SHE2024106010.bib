@article{SHE2024106010,
 abstract = {Sleep staging is an essential component of sleep medicine. Traditional expert-based staging method is time-consuming and labor intensive, prompting research interest in automatic staging based on artificial intelligence in recent years. Among the existing automatic staging methods, traditional feature-based staging has strong interpretation and clinical acceptance but lack satisfactory accuracy, while deep learning model-based methods exhibit high performance but limited in interpretability and significant high computational cost. In this work, we propose a concise two-layer network based on the improved Broad Learning System (BLS), which demonstrates exceptional performance and extremely low computing cost. The network comprises a pre-training module and a contextual feature enhancement module. During pre-training, manual features and the improved BLS are employed to establish the fundamental model. Subsequently, the model is optimized by integrating the contextual information into the original features, and after running several training epochs, the final result is obtained. By combining the advantages of the improved BLS and the contextual-feature fusion, our model achieves the state-of-the-art performance on multiple datasets, and the traditional machine learning method with our context-feature method also shows significant improvement. Furthermore, the usage of manual features and our concise context-feature fusion method ensure the model interpretability and reduce the computational cost. Specifically, our model contain approximately 1/14 parameters than the best performing deep learning models.},
 author = {Yichong She and Di Zhang and Jinbo Sun and Xuejuan Yang and Xiao Zeng and Wei Qin},
 doi = {https://doi.org/10.1016/j.bspc.2024.106010},
 issn = {1746-8094},
 journal = {Biomedical Signal Processing and Control},
 keyword = {Sleep staging, Feature engine, Broad learning system, Contextual feature fusion},
 pages = {106010},
 title = {CBLSNet: A concise feature context fusion network for sleep staging},
 url = {https://www.sciencedirect.com/science/article/pii/S1746809424000685},
 volume = {91},
 year = {2024}
}
