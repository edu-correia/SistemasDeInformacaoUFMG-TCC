@inproceedings{11464684,
 abstract = {Multiple consistencies form the basis of audio-visual learning, but most audio-visual datasets are single-modality-centric and cannot fully satisfy them. We present a large-scale, high-quality audiovisual dataset centered on audio-visual objects. The resulting dataset can be used for various audio-visual learning tasks. We regard the audio and visual modalities as equal, organizing and annotating the data using a hierarchical tree. While ensuring semantic, temporal, and spatial consistency (multiple consistencies), we keep difficult cases such as modality-missing examples. All samples come from real-world videos and reflect complex in-the-wild environments. This work has three main contributions. First, we design a data collection and annotation pipeline with four stages: defining the class list and gathering videos; human verification and annotation; data checking and merging; multi-granularity hierarchical labeling. Second, we use this pipeline to construct AVO-65, which contains more than 30K videos across 65 classes spanning four levels. Third, we evaluate various CNN architectures with several feature-fusion approaches to establish multimodal recognition baselines on our dataset. We also study the performance of several state-of-the-art models on AVO-65. Compared to existing multi-modal datasets, AVO-65 ensures multiple consistencies and provides hierarchical multi-granularity labels. This promises to promote the audio-visual learning research. The code and dataset are publicly available at: https://github.com/siyunye/AVO-65},
 author = {Yao, Zehao and Zhang, Guanghui and Wang, Lei and Zhu, Dongchen},
 booktitle = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP55912.2026.11464684},
 issn = {2379-190X},
 keyword = {Motion pictures;Broadcasting;Filtering;Filters;Circuits and systems;Videos;Location awareness;Video equipment;Mobile communication;Protocols;Audio-visual recognition;audio-visual learning;multimodal;hierarchy;dataset},
 month = {May},
 number = {},
 pages = {13062-13066},
 title = {AVO-65: A Large-Scale Hierarchical Audio-Visual Object Dataset},
 volume = {},
