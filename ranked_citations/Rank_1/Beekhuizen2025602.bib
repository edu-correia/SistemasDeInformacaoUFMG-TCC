@conference{Beekhuizen2025602,
 abstract = {This paper introduces VORM, an unsupervised morphological segmentation system, leveraging translation data to infer highly accurate morphological transformations, including lessfrequently modeled processes such as infixation and reduplication. The system is evaluated on standard benchmark data and a novel, typologically diverse, dataset of 37 languages. Model performance is competitive and sometimes superior on canonical segmentation, but more limited on surface segmentation.  © 2025 Association for Computational Linguistics.},
 author = {Beekhuizen, Barend},
 doi = {10.18653/v1/2025.conll-1.39},
 journal = {CoNLL 2025 - 29th Conference on Computational Natural Language Learning, Proceedings of the Conference},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 pages = {602 - 626},
 publication_stage = {Final},
 source = {Scopus},
 title = {VORM: Translations and a constrained hypothesis space support unsupervised morphological segmentation across languages},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105040141766?origin=resultslist},
 year = {2025}
}
