@inproceedings{5701507,
 abstract = {Generating realistic world containing water is among the most challenging aspects in virtual reality. One important area in computer graphics simulations for water is the animation of droplets, which is vital for driver simulators. The method for rendering water droplets which is proposed in this paper originates from the method that is published by Yu et al. For speed and practicability purposes, we use GPU-based approaches to generate realistic images of water droplets. Modified metaball technique are used to approximate the merging of water droplets and this model can also be apply to the real-time systems completely due to our optimization for the 3D metaball.},
 author = {Chen, Dongfang and Zhang, Jiahuan},
 booktitle = {2010 International Conference on Digital Manufacturing & Automation},
 doi = {10.1109/ICDMA.2010.153},
 issn = {},
 keyword = {Computational modeling;Rendering (computer graphics);Animation;Merging;Mathematical model;Real time systems;Solid modeling;water droplets;metaball;merging;modeling;real-time rendering},
 month = {Dec},
 number = {},
 pages = {716-719},
 title = {The Merging of Water Droplets Base-on Metaball},
 volume = {2},
 year = {2010}
}
