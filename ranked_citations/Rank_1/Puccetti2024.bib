@conference{Puccetti2024,
 abstract = {Evaluating defensive solutions against adversarial evasion attacks means quantifying the defense' s capability to detect or tolerate attacks. Ideally, a defense should be tested against all the possible attacks: however, this is not achievable, and it is necessary to identify a representative attack set for the evaluation. Unfortunately, how to select such an attack set is an open question. Arguably, the selected a ttacks s hould a pply d iverse effects on the original image, interms of dimension and distribution of the perturbation. We propose to quantify the perturbation through Image Quality metrics in addition to L-norms, such that adversarial attacks can be grouped (and only one representative of the group can be selected to test the defense) if they i) similarly perturb the attacked image, and ii) have similar success rate and detectability rate. Disappointingly, the analysis reveals that attacks with similar image perturbation cannot be related. Substantial evidence discourages grouping attacks and suggests that any reduction of the attack set impacts the validity of the defense evaluation.  Copyright © 2024 for this paper by its authors.},
 author = {Puccetti, Tommaso and Zoppi, Tommaso and Ceccarelli, Andrea},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {On Attacks (Dis)Similarities to Test Adversarial Defense: Can We Reduce the Attack Set?},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85199559301?origin=resultslist},
 volume = {3731},
 year = {2024}
}
