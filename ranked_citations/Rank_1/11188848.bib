@inproceedings{11188848,
 abstract = {The frequency divider, as an important component of a Phase-Locked Loop (PLL), has its input frequency for normal operation as a critical issue. This paper presents a low-noise, high-speed programmable frequency divider with automatic retiming system. The divider utilizes a novel 2/3 prescaler based on Extended True Single Phase Clock (E-TSPC) structure with logic gate merged, employs 6 stages of 2/3 frequency divider cell based on the traditional True Single Phase Clock (TSPC) structure, and incorporates a D flip-flop (DFF) as a retiming element to reduce the output noise of the divider. Furthermore, an automatic retiming system is implemented to prevent metastability during the retiming process. The divider is implemented in a 28nm CMOS process and features a programmable frequency division ratio between 128 and 255. The proposed prescaler has only a power consumption of $475.6\mu \mathrm{W}$ in $\div 3$ mode with a maximum operating frequency of 25GHz. Under a 20 GHz input frequency with a division ratio of 200, the overall divider's output phase noise is -181.8 dBc/Hz at 10 MHz offset.},
 author = {Hou, Longxiang and Xie, Qian and Wang, Zheng},
 booktitle = {2025 International Conference on Microwave and Millimeter Wave Technology (ICMMT)},
 doi = {10.1109/ICMMT65948.2025.11188848},
 issn = {2994-3124},
 keyword = {Phase noise;Microwave technology;Microwave integrated circuits;Power demand;Millimeter wave technology;Frequency conversion;CMOS process;Phase locked loops;Periodic structures;Clocks},
 month = {May},
 number = {},
 pages = {1-3},
 title = {A High Speed Auto Retiming Programmable Divider Using a Novel 2/3 Prescaler},
 volume = {},
 year = {2025}
}
