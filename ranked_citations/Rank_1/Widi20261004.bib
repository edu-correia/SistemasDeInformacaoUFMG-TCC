 abstract = {Data quality issues, particularly duplicate records, pose significant challenges for national sports federations in maintaining accurate athlete registries. In Indonesia, the lack of standardized data entry protocols and linguistic variations in personal names create unique deduplication challenges that existing tools fail to adequately address. This study presents a comprehensive data deduplication pipeline specifically designed for Indonesian athlete registry data, evaluated using a synthetic dataset that captures realistic error patterns found in federation databases. We developed a synthetic dataset generator producing 10,000 records with controlled duplicate injection (10% duplicate rate) incorporating ten distinct error types based on observed patterns in Indonesian personal data. The pipeline implements a six-stage workflow: data profiling, preprocessing and standardization, blocking, similarity computation, classification, and merge resolution. Results: Experimental evaluation using five-fold cross-validation demonstrates that the proposed pipeline achieves 94.2% precision, 91.8% recall, and 93.0% F1-score on the synthetic benchmark dataset. The blocking strategy reduces comparison space by 95.3% while maintaining 98.7% pairs completeness. The synthetic data approach provides a privacy-preserving method for developing and evaluating deduplication systems. The proposed pipeline offers an effective solution for Indonesian sports federations seeking to improve data quality in their athlete management systems. © 2026 IEEE.},
 author = {Widi, Anugerah and Sediyono, Eko and Hendry, Hendry},
 doi = {10.1109/ISIBER68248.2026.11469995},
 journal = {Proceeding - ISIBER 2026: International Seminar on Intelligent Business and Edge-Computing Research},
