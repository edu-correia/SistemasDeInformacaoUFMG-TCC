@inproceedings{11232044,
 abstract = {Autonomous path tracking remains a critical component in the design of intelligent driving systems and has attracted extensive interest in recent years. This paper proposes a hybrid control approach that combines L1 Guidance Logic with a Proportional-Integral-Derivative (PID) controller to improve path tracking precision and lateral performance. While L1 Guidance Logic alone provides accurate geometric path following with low cross-track error, the integration of a PID controller—targeting the error between the desired and actual angular velocities—enhances the system’s responsiveness. The proposed method is evaluated through simulations under identical conditions alongside two widely used geometric guidance algorithms: Stanley and Pure Pursuit. Results demonstrate that the L1–PID hybrid approach achieves lower tracking errors and smoother trajectory following compared to conventional methods. This study highlights the benefits of combining geometric guidance laws with classical control to achieve improved performance in autonomous vehicle navigation.},
 author = {Elmaghraby, Ziad and Nassif, David and El-Badawy, Ayman},
 booktitle = {2025 7th Novel Intelligent and Leading Emerging Sciences Conference (NILES)},
 doi = {10.1109/NILES68063.2025.11232044},
 issn = {},
 keyword = {Accuracy;Navigation;Merging;Trajectory;Logic;Reliability;PD control;Oscillators;Autonomous vehicles;L1 Guidance Logic;PID;Stanley;Pure Pursuit;Path tracking},
 month = {Oct},
 number = {},
 pages = {494-499},
 title = {L1-PID Control Strategy for Enhanced Path Tracking in UGVs},
 volume = {},
 year = {2025}
}
