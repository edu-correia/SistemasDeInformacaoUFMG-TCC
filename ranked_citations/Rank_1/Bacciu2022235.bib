@article{Bacciu2022235,
 abstract = {Image captioning is a task typically approached by deep encoder-decoder architectures, where the encoder component works on a flat representation of the image while the decoder considers a sequential representation of natural language sentences. As such, these encoder-decoder architectures implement a simple and very specific form of structured transduction, that is a generalization of a predictive problem where the input data and output predictions might have substantially different structures and topologies. In this paper, we explore a generalization of such an approach by addressing the problem as a general structured transduction problem. In particular, we provide a framework that allows considering input and output information with a tree-structured representation. This allows taking into account the hierarchical nature underlying both images and sentences. To this end, we introduce an approach to generate tree-structured representations from images along with an autoencoder working with this kind of data. We empirically assess our approach on both synthetic and realistic tasks. © 2022, Springer Nature Switzerland AG.},
 author = {Bacciu, Davide and Serramazza, Davide},
 doi = {10.1007/978-3-031-08223-8_20},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 0},
 pages = {235 - 246},
 publication_stage = {Final},
 source = {Scopus},
 title = {Learning Image Captioning as a Structured Transduction Task},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85133028358?origin=resultslist},
 volume = {1600 CCIS},
 year = {2022}
}
