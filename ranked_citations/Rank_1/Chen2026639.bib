@conference{Chen2026639,
 abstract = {Accurate vegetation segmentation in large-scale urban environments is often hindered by high morphological variability, boundary ambiguities, and computational redundancy. In this paper, we propose VBT-Net, an efficient boundary-aware framework tailored for high-fidelity vegetation extraction. To optimize throughput, we introduce a vegetation-aware Voronoi Tokenizer that employs a non-overlapping partitioning strategy to eliminate redundant neighborhood queries while preserving canopy topological integrity. Furthermore, we develop a Boundary-Aware Graph Attention Layer to explicitly model geometric discontinuities and adaptively redistribute attention weights, effectively mitigating the "semantic sticking"between flora and man-made structures. Our results demonstrate that VBT-Net achieves an optimal balance between computational efficiency and segmentation fidelity, providing a robust solution for large-scale urban digital twin reconstruction. © 2026 IEEE.},
 author = {Chen, Pu and Wan, Fang and Zheng, Chaoxia and Xu, Li},
 doi = {10.1109/CNML68938.2026.11452503},
 journal = {2026 International Conference on Communication Networks and Machine Learning, CNML 2026},
 note = {Cited by: 0},
 pages = {639 - 643},
 publication_stage = {Final},
 source = {Scopus},
 title = {VBT-Net: A Voronoi-based Transformer Network for Efficient Urban Vegetation Segmentation in LiDAR Point Clouds},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105036659875?origin=resultslist},
 year = {2026}
}
