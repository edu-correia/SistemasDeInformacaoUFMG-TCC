@article{Yao2026,
 abstract = {Connected autonomous vehicle technology significantly enhances the operation and efficiency of merging behaviors. This paper proposes a hierarchical scheme for vehicle platoon to achieve trajectory planning and cooperative adaptive cruise control in adjacent parallel lane merging scenarios. The scheme be gins with a tactical layer, where yield trajectories for platoon vehicles are planned using Pontryagin's Minimum Principle, incorporating a trajectory adjustment method that considers road friction (RF) and riding comfort (RC). A two-phase approach is developed for merging vehicles, planning both longitudinal and lateral motion while taking into account RF and RC. At the planning layer, a multi-objective model is formulated to achieve integrated optimization of merging sequence and trajectory planning, with the aim of reducing merging duration and mitigating the disruption to the platoon and traffic flow. An iterative solution algorithm based on gradient descend method is presented to obtain optimal decision variables, which guide the determination of the desired trajectory according to the tactical layer. At control layer, an adaptive backstepping-based cooperative adaptive cruise control (CACC) strategy is proposed to maintain platoon stability while considering time delay, input saturation and uncertainties in dynamic parameters of vehicles related to road friction. Internal stability and string stability are analyzed theoretically. A trajectory tracking method is also employed to guide vehicles along desired trajectory, with a state machine facilitating coordination between CACC strategy and the trajectory tracking method. Numerical simulations and Hard-in-the-Loop (HIL) experiments verify the effectiveness of the proposed hierarchical scheme, demonstrating reduced merging duration, mitigated disruption to both the traffic flow and the platoon, and robust performance under varying road friction conditions. © 1967-2012 IEEE.},
 author = {Yao, Ye and Qi, Zhiquan and Sun, Ruixin and Zhang, Mingwei},
 doi = {10.1109/TVT.2026.3674768},
 journal = {IEEE Transactions on Vehicular Technology},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Article in press},
 source = {Scopus},
 title = {Integrated Trajectory Planning and Cooperative Adaptive Cruise Control for Platoon Merging Con-sidering Road Friction},
