@conference{Xiong2024677,
 abstract = {The purpose of this study is to design and implement an autonomous code scanning inventory system to improve the efficiency and accuracy of warehouse inventory. Therefore, this article plans the overall architecture of the system in detail, carefully selects the code scanning technology, optimizes the data processing and storage design, and provides users with a friendly operation interface. In the implementation stage, a suitable hardware platform is built, an efficient and stable software system is developed, and the performance of the system is ensured through rigorous testing and optimization. Through simulation experiments, the obvious advantages of the self-scanning code inventory system in speed, accuracy and path planning efficiency are verified. The experimental results show that compared with other inventory methods, this system can greatly improve the inventory efficiency, reduce human errors, and bring substantial improvement to modern warehouse management. This research not only provides strong technical support for the intelligent upgrading of the warehousing industry, but also lays a solid foundation for the wider application of the self-scanning code counting technology in the future. © 2024 IEEE.},
 author = {Xiong, Tao and Zhan, Guohui and Peng, Yunqian and Chen, Sivu and Wu, Yang},
 doi = {10.1109/TELEPE64216.2024.00127},
 journal = {Proceedings - 2024 International Conference on Telecommunications and Power Electronics, TELEPE 2024},
 note = {Cited by: 0},
 pages = {677 - 682},
 publication_stage = {Final},
 source = {Scopus},
 title = {Design and Implementation of Self-Scanning Code Inventory System in Warehouse Global Scene},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85208125519?origin=resultslist},
 year = {2024}
}
