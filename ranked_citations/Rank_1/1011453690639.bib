@article{10.1145/3690639,
 abstract = {The integration of the Internet of Things (IoT) and modern Artificial Intelligence (AI) has given rise to a new paradigm known as the Artificial Intelligence of Things (AIoT). In this survey, we provide a systematic and comprehensive review of AIoT research. We examine AIoT literature related to sensing, computing, and networking &amp; communication, which form the three key components of AIoT. In addition to advancements in these areas, we review domain-specific AIoT systems that are designed for various important application domains. We have also created an accompanying GitHub repository, where we compile the papers included in this survey: https://github.com/AIoT-MLSys-Lab/AIoT-Survey. This repository will be actively maintained and updated with new research as it becomes available. As both IoT and AI become increasingly critical to our society, we believe that AIoT is emerging as an essential research field at the intersection of IoT and modern AI. It is our hope that this survey will serve as a valuable resource for those engaged in AIoT research and act as a catalyst for future explorations to bridge gaps and drive advancements in this exciting field.},
 address = {New York, NY, USA},
 articleno = {9},
 author = {Siam, Shakhrul Iman and Ahn, Hyunho and Liu, Li and Alam, Samiul and Shen, Hui and Cao, Zhichao and Shroff, Ness and Krishnamachari, Bhaskar and Srivastava, Mani and Zhang, Mi},
 doi = {10.1145/3690639},
 issn = {1550-4859},
 issue_date = {January 2025},
 journal = {ACM Trans. Sen. Netw.},
 keyword = {Artificial Intelligence of Things, AIoT, edge AI},
 month = {January},
 number = {1},
 numpages = {75},
 publisher = {Association for Computing Machinery},
 title = {Artificial Intelligence of Things: A Survey},
 url = {https://doi.org/10.1145/3690639},
 volume = {21},
 year = {2025}
}
