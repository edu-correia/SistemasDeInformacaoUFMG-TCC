@article{7454878,
 abstract = {Free-electron laser (FEL) experiments, especially the seeded FEL related experiments at the Shanghai deep-ultraviolet FEL (SDUV-FEL) test facility during the past few years, are summarized. The main goals of these experimental studies are to gain first-hand experience on emerging novel FEL concepts, and to tackle the technical challenges related to X-ray FELs, which are of crucial importance to the future X-ray FEL user facilities in China.},
 author = {Zhao, Z. T. and Wang, D.},
 doi = {10.1109/TNS.2016.2527678},
 issn = {1558-1578},
 journal = {IEEE Transactions on Nuclear Science},
 keyword = {Undulators;Laser beams;Harmonic analysis;Electron beams;Linear particle accelerator;Measurement by laser beam;Tuning;Chirped pulse amplification (CPA);corrugated structure;crossed undulator;echo-enabled harmonic generation (EEHG);free-electron laser (FEL);high-gain harmonic generation (HGHG);phase-merging enhanced harmonic generation (PEHG);polarization control;self-amplified spontaneous emission (SASE);x-ray},
 month = {April},
 number = {2},
 pages = {930-938},
 title = {Seeded FEL Experiments at the SDUV-FEL Test Facility},
 volume = {63},
 year = {2016}
}
