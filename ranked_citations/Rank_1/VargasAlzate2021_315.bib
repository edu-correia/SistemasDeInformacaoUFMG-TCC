@article{VargasAlzate2021_315,
 abstract = {Abstract Open regionalism is a dominant feature within the regional integration mechanism known as the Pacific Alliance. Its members seek to strengthen the economic ties between them and obtain favorable outcomes vis-à-vis the Asia Pacific region. The aim of this article is to demonstrate the private sector's significance within the Pacific Alliance, while highlighting the role each one has played in the other's success. To this end, the authors undertook an extensive literature review and conducted numerous interviews with representatives of the Colombian private sector to gather their estimations regarding the Pacific Alliance, its various stages of conception and implementation, and its real significance for the private sectors within and among members. Additionally, the focus was directed to the specific case of the SURA Group, an international firm based in Colombia, to illustrate the objectives and benefits accruing to the private sector (and the SURA Group itself) via this integration initiative.},
 author = {Vargas-Alzate, Luis Fernando and Alviar, Ana María Amaya},
 doi = {10.12804/revistas.urosario.edu.co/desafios/a.8394},
 number = {2},
 pages = {245--284},
 title = {Open Regionalism and the Pacific Alliance: The Case of the SURA Group as a Private Sector Actor},
 volume = {33},
 year = {2021}
}
