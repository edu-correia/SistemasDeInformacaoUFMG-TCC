@article{Ryu2011219,
 abstract = {Similar entity search is the task of identifying entities that most closely resemble a given entity (e.g., a person, a document, or an image). Although many techniques for estimating similarity have been proposed in the past, little work has been done on the question of which of the presented techniques are most suitable for a given similarity analysis task. Knowing the right similarity function is important as the task is highly domain- and data-dependent. In this paper, we propose a recommender service that suggests which similarity functions (e.g., edit distance or jaccard similarity) should be used for measuring the similarity between two entities. We introduce the notion of "similarity function recommendation rule" that captures user knowledge about similarity functions and their usage contexts. We also present an incremental knowledge acquisition technique for building and maintaining a set of similarity function recommendation rules. © 2011 Springer-Verlag.},
 author = {Ryu, Seung Hwan and Benatallah, Boualem and Paik, Hye-Young and Kim, Yang Sok and Compton, Paul},
 doi = {10.1007/978-3-642-25535-9_15},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3; All Open Access; Green Open Access},
 pages = {219 - 234},
 publication_stage = {Final},
 source = {Scopus},
 title = {Similarity function recommender service using incremental user knowledge acquisition},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/82055183941?origin=resultslist},
 volume = {7084 LNCS},
 year = {2011}
}
