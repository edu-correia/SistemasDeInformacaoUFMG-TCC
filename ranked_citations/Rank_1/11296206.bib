@inproceedings{11296206,
 abstract = {As photovoltaic (PV) systems become increasingly integrated with smart grid infrastructure, they become more susceptible to cyber threats that can compromise data integrity, disrupt operation, and undermine energy security. This paper presents a deep learning-inspired anomaly detection framework using a one-dimensional convolutional neural network (1D-CNN) to detect cyberattacks in PV systems. A comprehensive, realworld dataset was created by merging year-long PV electrical measurements with high-resolution solar irradiance data. Three attack types, False Data Injection (FDI), Data Integrity Attack (DIA), and Replay Attack (RA), were emulated from recent threat models and strategically injected to simulate realistic attacker behavior. Sliding window segmentation and timestamp alignment were employed to transform the data into structured sequences viable for temporal learning. Class imbalance, resulting from inherent variation in attack durations, was addressed with class weighting to improve sensitivity for infrequent attack instances. The proposed 1D-CNN model, after hyperparameter tuning, achieved a test accuracy of 96% with high precision and recall for all classes. The performance demonstrates the model’s effectiveness in detecting both overt and subtle anomalies. The study lays the groundwork for future deployment of few-shot learning models for detecting emerging and unknown threats under limited supervision, promoting the security and resilience of PV-enabled smart energy systems.},
 author = {Hazera, Chowdhury Tasnuva and Ibrahem, Mohamed I. and Fouda, Mostafa M.},
 booktitle = {2025 3rd International Conference on Artificial Intelligence, Blockchain, and Internet of Things (AIBThings)},
 doi = {10.1109/AIBThings66987.2025.11296206},
 issn = {},
 keyword = {Photovoltaic systems;Accuracy;Data integrity;Feature extraction;Smart grids;Convolutional neural networks;Computer crime;Few shot learning;Anomaly detection;Tuning;Photovoltaic systems;cybersecurity;anomaly detection;False Data Injection;few-shot learning;smart grid},
 month = {Sep.},
 number = {},
 pages = {1-7},
 title = {Anomaly Detection in Photovoltaic Systems Using 1D Convolutional Neural Networks Under Realistic Cyberattack Scenarios},
 volume = {},
