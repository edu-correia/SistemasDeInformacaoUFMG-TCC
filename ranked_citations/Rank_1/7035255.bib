@article{7035255,
 abstract = {Nonconstituent coordination poses a particularly challenging problem for standard kinds of syntactic theories in which the notion of phrase structure (or constituency) is taken to be a primitive in some way or other. Previous approaches within such theories essentially equate nonconstituent coordination with coordination of full-fledged clauses at some level of grammatical representation. I present data from Japanese that pose problems for such approaches and argue for an alternative analysis in which the apparent nonconstituents are in fact surface constituents having full-fledged meanings, couched in a framework called Hybrid Type-Logical Categorial Grammar (Kubota 2010, Kubota and Levine 2012, Kubota 2014).},
 author = {Kubota, Yusuke},
 doi = {10.1162/LING_a_00174},
 issn = {0024-3892},
 journal = {Linguistic Inquiry},
 keyword = {nonconstituent coordination;Categorial Grammar;Hybrid Type-Logical Categorial Grammar;parasitic scope;Late Merge;Japanese},
 month = {Jan},
 number = {1},
 pages = {1-42},
 title = {Nonconstituent Coordination in Japanese as Constituent Coordination: An Analysis in Hybrid Type-Logical Categorial Grammar},
 volume = {46},
 year = {2015}
}
