@article{10.14778/3352063.3352076,
 abstract = {Privacy-preserving record linkage (PPRL) is increasingly demanded in real-world applications, e.g., in the health-care domain, to combine person-related data for data analysis while preserving the privacy of individuals. However, the adoption of PPRL is hampered by the absence of easy-to-use and powerful PPRL tools covering the entire PPRL process. We therefore demonstrate Primat, a flexible and scalable tool that enables the definition and application of tailored PPRL workflows as well as the comparative evaluation of different PPRL methods. We introduce the main requirements for PPRL tools and discuss previous tool efforts that do not fully meet the requirements and have not been applied in practice. By contrast, Primat covers the whole PPRL life-cycle and improves applicability by providing various components for data owners and the central linkage to be executed by a trusted linkage unit.},
 author = {Franke, Martin and Sehili, Ziad and Rahm, Erhard},
 doi = {10.14778/3352063.3352076},
 issn = {2150-8097},
 issue_date = {August 2019},
 journal = {Proc. VLDB Endow.},
 month = {August},
 number = {12},
 numpages = {4},
 pages = {1826–1829},
 publisher = {VLDB Endowment},
 title = {PRIMAT: a toolbox for fast privacy-preserving matching},
 url = {https://doi.org/10.14778/3352063.3352076},
 volume = {12},
 year = {2019}
}
