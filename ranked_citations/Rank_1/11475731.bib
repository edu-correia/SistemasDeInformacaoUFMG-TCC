@article{11475731,
 abstract = {As transistor dimensions continue to scale down aggressively, the lateral overgrowth of source/drain (S/D) epitaxy has emerged as a critical limitation. When the spacing between transistors becomes narrow, uncontrolled lateral overgrowth can cause the merging of S/D regions in adjacent transistors, leading to fatal errors such as electrical shorts. The introduction of a fence structure effectively suppresses this overgrowth, thereby enabling cell size reduction and improved integration density. However, it also introduces complex changes in device characteristics, including increased contact and S/D resistance, as well as reduced parasitic capacitance. In this work, we systematically analyzed the impact of the fence structure from a Design-Technology Co-Optimization (DTCO) perspective. The DC performance of transistors was evaluated based on the linear mode on-state current (IDS,LIN), effective drive current (IEFF), and saturation mode on-state current (IDS,SAT). For transient response characterization, we investigated the propagation delay (high-to-low; tpHL and low-to-high propagation delay; tpLH) of CMOS inverters under two configurations—Fan-Out 0 (FO0) and Fan-Out 3 (FO3)—to assess both intrinsic device characteristics and circuit-level behavior. The results demonstrate that optimized fence implementation can achieve performance gains while simultaneously enhancing integration density, thereby providing significant design advantages in advanced semiconductor technologies.},
 author = {Lim, Jaehyuk and Han, Donghwan and Han, Changwoo and Kim, Jungsu and Lim, Subin and Jeong, Seungjoon and Sung, Juho and Shin, Changhwan},
 doi = {10.1109/TCAD.2026.3681528},
 issn = {1937-4151},
 journal = {IEEE Transactions on Computer-Aided Design of Integrated Circuits and Systems},
 keyword = {CMOS technology;Circuits;Circuits and systems;Contacts;Integrated circuits;Very large scale integration;Contact resistance;Silicon-on-insulator;MOSFET circuits;Charge pumps;Gate-all-around field-effect transistor (GAAFET);Metal Oxide Semiconductor field-effect transistor (MOSFET);Source/Drain fence;Design-technology co-optimization (DTCO)},
 month = {},
 number = {},
 pages = {1-1},
 title = {Design-Technology Co-Optimization: Analysis of Source/Drain Fence for Performance Improvement and Cell Size Scaling in Gate-All-Around Field Effect Transistor-based Circuits},
 volume = {},
 year = {2026}
}
