@inproceedings{1023619,
 abstract = {We consider the problem of constructing an embedded scalable code stream from a given tree structured quantizer (TSQ) to minimize the expected distortion weighted over a range of operational rates. If the rate weighting function is exponential, the problem is solvable by a simple algorithm reminiscent to merge sort. The complexity of the algorithm is O(NlogN) where N is the number of internal nodes of the corresponding quantizer tree.},
 author = {Dumitrescu, S. and Xiaolin Wu},
 booktitle = {Proceedings IEEE International Symposium on Information Theory,},
 doi = {10.1109/ISIT.2002.1023619},
 issn = {},
 keyword = {Rate distortion theory;Interleaved codes;Embedded computing;Quantization;Radiofrequency identification},
 month = {June},
 number = {},
 pages = {347-},
 title = {On embedded scalable code stream of minimum expected distortion for variable rate channels},
 volume = {},
 year = {2002}
}
