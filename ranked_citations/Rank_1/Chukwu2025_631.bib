@article{Chukwu2025_631,
 abstract = {The burgeoning field of sustainable construction necessitates a profound re-evaluation of traditional building practices, with a transition towards eco-friendly, energy-efficient, and socially responsible methodologies in building construction. We studied a unique population of students in Building Technology Education (BTE) whose bi-directional training makes them relevant for environmental education both in classrooms and in actual building construction. We conveniently surveyed 171 students and 47 building construction experts using a 29-item questionnaire. "Restoring brownfields for low-cost habitable buildings" and "retraining manpower in sustainable methods" ranked highest in the Relative Importance Index. Validity checks confirmed participant sufficiency, and Principal Component Analysis revealed seven themed components: support for the local economy, manpower and social norms; value for humans and nature; reducing resource consumption and waste generation; use of integrated design approach and building site assessment; recycling and reusing of materials; attention to land use; and incremental green technology integration. These themes collectively offer a comprehensive framework for training future professionals to champion sustainability both in the classrooms and in the actual building construction operations. Thus, this study addressed diverse facets of construction sustainable behaviours, discovering the multifaceted and interconnected nature of sustainable construction and necessary behaviours.},
 author = {Chukwu, Daniel Uchenna and Ogbuanya, Theresa Chinyere},
 doi = {10.4314/sajee.v41si1.03},
 number = {1},
 pages = {1--20},
 title = {Identifying the Key Behaviours to Promote Sustainable Constructions in Nigeria: A Principal Component Analysis},
 volume = {41},
 year = {2025}
}
