@article{Budiu2025,
 abstract = {Incremental view maintenance (IVM) has long been a central problem in database theory and practice. Many solutions have been proposed for restricted classes of database languages (such as the relational algebra or Datalog), restricted classes of queries, and restricted classes of database changes. In this paper we give a general, heuristic-free solution to this problem in 4 steps: (1) we describe a simple but expressive language called DBSP for describing computations over data streams; (2) we give a new mathematical definition of IVM using DBSP; (3) we give an algorithm for converting any DBSP program into an incremental program; this algorithm reduces the problem of incrementalizing a complex query to the problem of incrementalizing the primitive operations that compose the query. Finally, (4) we show that practical database query languages, such as SQL and Datalog, can be directly implemented on top of DBSP, using primitives that have efficient incremental implementations. As a consequence, we obtain a general recipe for efficient IVM for essentially arbitrary queries written in all these languages. © The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature 2025.},
 author = {Budiu, Mihai and Ryzhyk, Leonid and Zellweger, Gerd and Pfaff, Ben and Suresh, Lalith and Kassing, Simon and Gyawali, Abhinav and Budiu, Matei and Chajed, Tej and McSherry, Frank and Tannen, Val},
 doi = {10.1007/s00778-025-00922-y},
 journal = {VLDB Journal},
 note = {Cited by: 1},
 number = {4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {DBSP: automatic incremental view maintenance for rich query languages},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105004573670?origin=resultslist},
 volume = {34},
 year = {2025}
}
