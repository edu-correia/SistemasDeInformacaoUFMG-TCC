@inproceedings{8650197,
 abstract = {Ascribed to better immunity to drain induced barrier lowering (DIBL) and enhanced analog/RF performance, tri-material double gate (TMDG) MOSFET proves to be superior over conventional DG MOSFET configurations. On the other hand, further improvement in various short channel effects (SCE) as well as high tolerance in gate misalignment can be achieved by using gate underlap design in typical DG structures. Merging these two features in this work, a TMDG MOSFET design with 20 nm physical gate length is studied for various symmetrical underlap lengths using 2D device simulation. Extensive analysis are performed to investigate notable analog/RF parameters like transconductance (gm), output conductance (gd), intrinsic gain (Av), intrinsic capacitance and cut-off frequency (fT) along with some SCEs like DIBL and subthreshold swing (SS) for various gate underlap designs. Additionally, some of the performance parameters are compared with single material (SM) and double material (DM) DG architectures. Thus this work provides a thorough investigation of the influence of gate material and gate underlap designs for DG MOSFET compatible for analog/RF application.},
 author = {Rahman, Md. Sazzadur and Ahmed, Nabil},
 booktitle = {TENCON 2018 - 2018 IEEE Region 10 Conference},
 doi = {10.1109/TENCON.2018.8650197},
 issn = {2159-3450},
 keyword = {Logic gates;MOSFET;Performance evaluation;Transconductance;Metals;Semiconductor process modeling;IEEE Regions;Tri-material Double Gate (TMDG) FET;Symmetrical Gate to Source/Drain Underlap;Short channel Effect (SCE);DIBL;Analog/RF Parameter},
 month = {Oct},
 number = {},
 pages = {1059-1064},
 title = {Impact of Gate Underlap Design on Analog and RF Performance for 20nm Tri-Material Double Gate(TMDG) MOSFET},
 volume = {},
 year = {2018}
}
