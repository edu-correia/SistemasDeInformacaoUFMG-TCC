@article{Ye2026,
 abstract = {Human-like and personalized decision-making is crucial for advancing the decision-making level of autonomous vehicles and increasing their acceptance among society and users, as well as for achieving information closed loop for autonomous driving. However, there are still challenges in achieving this, namely, there is currently no relatively complete framework that consider both human-likeness and personalization from training to deployment. In view of this, this paper proposes a virtual-real driver-augmented train-to-deploy reinforcement learning framework, which introduces a new paradigm of improved human-agent collaboration into the learning process to achieve human-like and personalized decision-making. A virtual driver model with uncertainty is proposed and introduced into the training loop to guide the RL agent to learn the common characteristics of human driving. A control authority transfer module integrating long-tail rate estimation is designed to provide flexible human-agent switching to achieve safe and efficient generic policy training. In the deployment phase, real drivers are allowed to intervene and provide guidance when preference conflicts occur, and a meaningful reception learning mechanism inspired by the field of educational psychology is proposed, which effectively screens personalized guidance and avoids catastrophic forgetting of acquired driving capabilities. Simulation experiments show that the proposed method significantly improves the human-likeness and personalization level of autonomous driving decision-making while ensuring training efficiency and safety; real-world experiments further verify its feasibility and engineering potential in practical applications. Copyright © 2026. Published by Elsevier Ltd.},
 author = {Ye, Yingnan and Zhao, Wanzhong and Zhou, Xiaochuan and Luan, Zhongkai and Zhang, Ziyu and Wang, Chunyan},
 doi = {10.1016/j.aei.2026.104727},
 journal = {Advanced Engineering Informatics},
