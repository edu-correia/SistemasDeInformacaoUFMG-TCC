@conference{Hidayatullah2019121,
 abstract = {This paper aims to discover topics from an Indonesian online shop chat. Moreover, we employed Latent Dirichlet Allocation to find out what kind of topics that are often discussed and conversation trends between buyers and customer service. Several tasks were performed, such as, collecting data, preprocessing, phrase aggregation, topic modeling, and topic analysis. We found several attracting findings during our experiments. In preprocessing task, product name extraction from URLs assisted to discover the intended product from the customer's conversation. On the other hand, the phrase aggregation task helped us to merge various terms which have same intended meaning, so that, we could obtain better topical model result and easier to determine the topic label. © 2019 Association for Computing Machinery.},
 author = {Hidayatullah, Ahmad Fathan and Kurniawan, Wisnu and Ratnasari, Chanifah Indah},
 doi = {10.1145/3342827.3342831},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 9},
 pages = {121 - 126},
 publication_stage = {Final},
 source = {Scopus},
 title = {Topic modeling on Indonesian online shop chat},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85071683327?origin=resultslist},
 year = {2019}
