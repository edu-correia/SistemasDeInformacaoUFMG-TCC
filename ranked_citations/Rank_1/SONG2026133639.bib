@article{SONG2026133639,
 abstract = {This study evaluates a composite adsorbent (RM-LL-BM) synthesized) from red mud (RM) and landfill leachate (LL) via a multi-step process combining ultrasonic homogenization, thermal decomposition, and microwave activation, focusing on its performance in removing heavy metals (HMs) under environmentally relevant conditions. This synergistic integration merges RM’s reactive metal oxides with ll-derived carbonaceous matrices, yielding a material tailored for efficient remediation of beryllium (Be) and antimony (Sb) from wastewater. The adsorption prowess of these composites was meticulously fine-tuned via orthogonal experimental design, culminating in optimized conditions that yielded maximum adsorption capacities: 156.73 mg·g−1 for Be and 135.45 mg·g−1 for Sb, achieved at a pH of 3, pyrolysis temperature of 900 °C, and an RM_Fe-to-LL_C mass ratio of 5:1. Delving into the mechanisms underpinning this enhanced performance, advanced analytical toolkit were deployed to confirm that the adsorptive processes were governed by a trifecta of redox reactions, coordination bonds, and surface complex formation phenomena. Of note, the composites demonstrated explicit reusability, maintaining a robust adsorption capacity exceeding 85 % of their original efficacy even after three consecutive regeneration cycles. This innovative “waste-to-resource” paradigm mitigates environmental burdens from RM and LL disposal and furnishes an economically viable and high-performance remedy for the mitigation of industrial wastewater pollutants.},
 author = {Dongping Song and Tao Huang and Xiaolong Sun and Yun Xia and Kai Chen and Jialin Cui and Qingyang Xu and Chengyu Yan and Chengzhe Yang},
 doi = {https://doi.org/10.1016/j.biortech.2025.133639},
 issn = {0960-8524},
 journal = {Bioresource Technology},
 keyword = {Red mud, Landfill leachate, Beryllium and antimony removal, Adsorption mechanism, Waste-to-resource strategy},
 pages = {133639},
 title = {Novel composite materials preparation from red mud and landfill leachate and their utilization and mechanism exploration for the removal of beryllium and antimony from wastewater},
 url = {https://www.sciencedirect.com/science/article/pii/S0960852425016062},
 volume = {441},
 year = {2026}
}
