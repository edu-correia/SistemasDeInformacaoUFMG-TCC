@incollection{KAUR2026123,
 abstract = {Immersion technologies in healthcare’s metaverse are a promising future technology that merges the real or physical world with a virtual or digital one to create unique experiences that have yet to enter the mainstream. Augmented reality, which overlays computer-generated content over the user’s actual surroundings, and virtual reality employ computer-generated content to create a completely immersive experience, but possess numerous similarities. These technologies have made significant progress in the fields of medical education, healthcare, industry, and recreation sectors by integrating numerous video games to offer individuals a more dynamic and immersive experience. Additionally, these technologies provide vibrant and stimulating activities that can activate the brain’s reward system, elevate various neurotransmitter levels like dopamine, endorphins, and oxytocin, promote feelings of contentment in response to stress, and facilitate social interactions. Furthermore, several researchers have established immersive technology as a potentially ground-breaking tool for pain management through distraction mechanisms, as well as for psychological therapy for cognitive diseases by addressing psychological problems, mental health therapy, and meditation techniques. Although immersive technology constitutes a very flexible and effective application, it has some obvious constraints and drawbacks. Furthermore, the drawbacks of immersive technology should not overshadow its benefits, nor should they impede the advancement of current, ground-breaking technology. Future designs should take this factor into account, achieving this through a broadened evaluation that considers not only the immediate impact but also the longer-term effects that occur outside or beyond the technology. Thus, by considering its advancement factors in the healthcare field, this chapter aims to provide an overview of the current state of immersive technology in healthcare, list the various types of immersive approaches or techniques, describe the components required for these systems, and discuss their applications in pain management and mental therapies.},
 author = {Manpreet Kaur and Namandeep Kaur and Nidhi Sharma and Anand Sharma},
 booktitle = {Metaverse in the Healthcare Industry},
 doi = {https://doi.org/10.1016/B978-0-443-30182-7.00010-5},
 editor = {Hemachandran Kannan and Shahid Mohammad Ganie and Raul Villamarin Rodriguez and Manjeet Rege and Suresh Babu Munuswamy},
 isbn = {978-0-443-30182-7},
 keyword = {Healthcare, developmental psychology, cognitive psychology, behavioral psychology, technology management, therapeutic procedure, cognitive process, medical education, human-centered computing, digital signal processing},
 pages = {123-156},
 publisher = {Elsevier},
 title = {Chapter 7 - Immersive experiences for pain management and mental health therapy},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443301827000105},
 year = {2026}
}
