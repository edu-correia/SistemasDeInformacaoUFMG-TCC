@article{7876738,
 abstract = {Quadrature-polarimetric (quad-pol) synthetic aperture radar (SAR) is a well-established technique which has numerous applications in remote sensing. However, spaceborne quad-pol SAR systems are often constrained by severe range and azimuth ambiguities. A deep understanding of the nature of ambiguities in conventional, hybrid, and ±π/4 quad-pol SAR allows a correct evaluation of the ambiguity-to-signal ratio and the design of systems optimized for ambiguity suppression. In that respect azimuth phase coding and merging data available from both cross-polarized channels play an important role. The results of this paper are relevant not only for the design of future spaceborne quad-pol SAR systems, including staggered SAR ones, but also for the optimal exploitation of quad-pol SAR systems currently in operation.},
 author = {Villano, Michelangelo and Krieger, Gerhard and Moreira, Alberto},
 doi = {10.1109/TGRS.2017.2667886},
 issn = {1558-0644},
 journal = {IEEE Transactions on Geoscience and Remote Sensing},
 keyword = {Synthetic aperture radar;Azimuth;Spaceborne radar;Backscatter;Doppler effect;Merging;Ambiguities;azimuth phase coding (APC);circular polarization;quadrature polarimetric (quad-pol);synthetic aperture radar (SAR)},
 month = {June},
 number = {6},
 pages = {3287-3308},
 title = {New Insights Into Ambiguities in Quad-Pol SAR},
 volume = {55},
 year = {2017}
}
