@conference{Humbert2019,
 abstract = {This article presents a new approach for processing and subsampling multivariate time-vertex graph signals. The main idea is to model the relationships within each dimension (time, space, feature space) with different graphs and to merge these structures. A new technique based on tensor formalism is provided, which aims to identify the frequency support of the graph signal in order to preserve its content after subsampling. Results are provided on real EEG data for data interpolation and reconstruction. © 2019 IEEE},
 author = {Humbert, Pierre and Oudre, Laurent and Vayatis, Nicolas},
 doi = {10.23919/EUSIPCO.2019.8902836},
 journal = {European Signal Processing Conference},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Subsampling of multivariate time-vertex graph signals},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85075596028?origin=resultslist},
 volume = {2019-September},
 year = {2019}
}
