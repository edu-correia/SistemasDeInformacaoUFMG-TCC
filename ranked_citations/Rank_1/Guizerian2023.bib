@conference{Guizerian2023,
 abstract = {Wearable technologies aim to merge computational elements into the user's daily life through integration with clothing. This type of technology distances itself from traditional computer models by its variety of communication options with the user and its need to integrate into clothing without drawing too much attention. Since the model diverges from conventional interfaces, there is a need to create a new set of heuristics to verify the quality of the interaction concerning usability. This paper discusses the problems related to wearable technologies and presents a set of formulated heuristics to meet this product type. It also offers the results of applying this set in a real scenario with a commercial device to validate it.  © 2023 ACM.},
 author = {Guizerian, Mario and Farinazzo Martins, Valéria},
 doi = {10.1145/3612783.3612791},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Proposal of a set of heuristics for evaluation of wearable interfaces usability},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85183576883?origin=resultslist},
 year = {2023}
}
