@inproceedings{1333336,
 abstract = {This paper describes VLSI architecture for the region-merging algorithm for image segmentation applications. This algorithm uses the region adjacency graph (RAG), which represents regions and their edges. The final segmentation provided by the RAG represents localized contours or surfaces. The architecture is proposed by making use of the concepts of parallelism and pipelining in order to improve the performance in terms of speed. The architecture has been coded in Verilog and synthesized using Synplify tools for FPGA implementation.},
 author = {Kranthi Kumar, J.D. and Srinivasan, S.},
 booktitle = {Euromicro Symposium on Digital System Design, 2004. DSD 2004.},
 doi = {10.1109/DSD.2004.1333336},
 issn = {},
 keyword = {Very large scale integration;Merging;Image segmentation;Partitioning algorithms;Computer architecture;Cost function;Surface topography;Parallel processing;Image edge detection;Pipeline processing},
 month = {Aug},
 number = {},
 pages = {620-623},
 title = {A novel VLSI architecture to implement region merging algorithm for image segmentation},
 volume = {},
 year = {2004}
}
