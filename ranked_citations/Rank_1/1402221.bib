@inproceedings{1402221,
 abstract = {Summary form only given. We present a parallel algorithm for the construction of minimum redundancy length-restricted codes that is based on the package-merge algorithm of Larmore and Hirschberg (1990). Our algorithm constructs a length-restricted code in O(L) time with n processors on a CREW PRAM. Thus our algorithm has the same time-processor product as the sequential algorithm of (1990). We also consider the problem of constructing the almost-optimal length-restricted codes.},
 author = {Karpinski, M. and Nekricht, Y.},
 booktitle = {Data Compression Conference},
 doi = {10.1109/DCC.2005.12},
 issn = {2375-0359},
 keyword = {Redundancy;Packaging;Computer science;Parallel algorithms;Phase change random access memory;Data compression},
 month = {March},
 number = {},
 pages = {464-},
 title = {Algorithms for construction of optimal and almost-optimal length-restricted codes},
 volume = {},
 year = {2005}
}
