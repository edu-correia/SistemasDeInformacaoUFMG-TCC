@article{10.1145/3806828,
 abstract = {Human life, infrastructures, and environment can all suffer greatly from disasters, whether man-made or natural. The growing prevalence of Big Data Analytics (BDA) techniques and Internet of Things (IoT) technologies as well as Artificial Intelligence (AI) methods presents significant opportunities and solutions for Emergency Management (EM) authorities. These technologies provide cutting-edge supports and foundations that enable a better understanding of events. In this article, we review relevant existing research works dealing with EM and we propose an innovative two-level classification: the first level refers to the type of disasters and the second one represents the specific emergency situations for each level-one type. This classification serves as a systematic framework to organize and structure the current state-of-the-art in this field, in particular, it summarizes the main challenges encountered and addressed in the literature. Furthermore, the discussion and the comparison of the main literature works according to this proposed classification allowed us to easier identify key and relevant trends, issues and gaps of the existing contributions. Thus, we identified and highlighted various open issues and proposed future research directions that would be very interesting to explore and investigate in order to improve different aspects related to this important and highly concerning area.},
 address = {New York, NY, USA},
 articleno = {307},
 author = {Bouafia, Khedoudja and Slimani, Hachem and Nacer, Hassina and Seba, Hamida},
 doi = {10.1145/3806828},
 issn = {0360-0300},
 issue_date = {September 2026},
 journal = {ACM Comput. Surv.},
 keyword = {Emergency management, big data analytics, internet of things, artificial intelligence, communication system, team coordination, preventive strategies, decision-making},
 month = {May},
 number = {12},
 numpages = {43},
 publisher = {Association for Computing Machinery},
 title = {Big Data Analytics and Internet of Things Combined with Artificial Intelligence Techniques for Effective Emergency Management: A Comprehensive Survey},
 url = {https://doi.org/10.1145/3806828},
 volume = {58},
 year = {2026}
}
