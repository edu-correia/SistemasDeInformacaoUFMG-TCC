@article{Rajak2026,
 abstract = {Counterfeit drugs and supply chain inefficiencies pose significant risks to patient safety and public health, undermining healthcare systems globally. This paper proposes a scalable blockchain-based solution to enhance drug traceability and security in pharmaceutical supply chains. Leveraging the Polygon blockchain platform and InterPlanetary File System (IPFS), we develop a decentralized application (DApp) that tracks drug batches from manufacturing to consumption, ensuring transparency and immutability of records. Smart contracts automate key processes, including stakeholder registration, product authentication, and batch tracking, reducing human error and tampering risks. Our solution utilizes Polygon's high throughput and low transaction costs, making it suitable for large-scale implementation. The IPFS provides decentralized and efficient data storage, enhancing the system's resilience. Experimental results demonstrate the feasibility and efficiency of our approach, highlighting its potential to combat counterfeit drugs and improve overall supply chain management. The proposed system not only enhances patient safety but also offers substantial benefits to pharmaceutical companies, distributors, and regulators by providing real-time visibility into drug movement, facilitating rapid recall procedures, and ensuring regulatory compliance. This innovative approach represents a significant step forward in securing pharmaceutical supply chains and protecting public health in an increasingly complex global market. © 2025 Elsevier Ltd},
 author = {Rajak, Dhireen Kumar and Khanal, Bipal and Ansari, Md. Sarfaraj Alam},
 doi = {10.1016/j.cie.2025.111655},
 journal = {Computers and Industrial Engineering},
 note = {Cited by: 3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Scalable blockchain-based solution for drug tracking in pharmaceutical supply chain},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105020830355?origin=resultslist},
 volume = {211},
 year = {2026}
}
