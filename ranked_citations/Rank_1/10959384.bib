@inproceedings{10959384,
 abstract = {Image dehazing aims to restore image clarity and visual quality by reducing atmospheric scattering and absorption effects. While deep learning has made significant strides in this area, more and more methods are constrained by network depth. Consequently, lots of approaches have adopted parallel branching strategies. however, they often prioritize aspects such as resolution, receptive field, or frequency domain segmentation without dynamically partitioning branches based on the distribution of input features. Inspired by dynamic filtering, we propose using cascaded dynamic filters to create a multi-branch network by dynamically generating filter kernels based on feature map distribution. To better handle branch features, we propose a residual multiscale block (RMB), combining different receptive fields. Furthermore, we also introduce a fusion method based attention mechanism to merge features from adjacent branches. Experiments on RESIDE, Haze4K, and O-Haze datasets validate our method's effectiveness, with our model achieving a PSNR of 43.21dB on the RESIDE-Indoor dataset. The code is available at https://github.com/dauing/CasDyF-Net.},
 author = {Wang, Yinglong and He, Bin},
 booktitle = {2024 IEEE 8th International Conference on Vision, Image and Signal Processing (ICVISP)},
 doi = {10.1109/ICVISP64524.2024.10959384},
 issn = {},
 keyword = {Visualization;Filters;Attention mechanisms;Image resolution;Computational modeling;Frequency-domain analysis;Scattering;Frequency diversity;Image restoration;Kernel;image dehazing;dynamic filtering;attention mechanism},
 month = {Dec},
 number = {},
 pages = {1-8},
 title = {CasDyF-Net: Image Dehazing via Cascaded Dynamic Filters},
 volume = {},
 year = {2024}
}
