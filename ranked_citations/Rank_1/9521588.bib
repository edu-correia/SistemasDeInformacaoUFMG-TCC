@article{9521588,
 abstract = {Network-on-chips (NoCs) with traditional regular topologies generally have an average-hop-count increased, polynomially, with the network size. This brief proposes to generate brain-network-inspired (BNI) topologies on monolithic 3D (M3D) ICs, where the average hop count scales up logarithmically, for large-scale systems with tens of thousands of cores. We propose a routability-driven method to generate BNI topologies on M3D ICs with scale-free and small-world properties. Moreover, we present an iterative method to reduce the network diameter using as few tier-crossing routers as possible. The resulting BNI topologies not only have over 50% lower average hop count and lower diameter than traditional regular topologies, but also have shorter total link length than other irregular topologies. The performance is further validated by the cycle-accurate simulation.},
 author = {Ge, Mengke and Ni, Xiaobing and Chen, Song and Kang, Yi},
 doi = {10.1109/TCSII.2021.3107340},
 issn = {1558-3791},
 journal = {IEEE Transactions on Circuits and Systems II: Express Briefs},
 keyword = {Topology;Three-dimensional displays;Network topology;Routing;Integrated circuits;Circuits and systems;Merging;Network-on-chip;monolithic 3D integration;topology generation;brain network},
 month = {March},
 number = {3},
 pages = {1552-1556},
 title = {Generating Brain-Network-Inspired Topologies for Large-Scale NoCs on Monolithic 3D ICs},
 volume = {69},
 year = {2022}
}
