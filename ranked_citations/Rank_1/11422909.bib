@article{11422909,
 abstract = {The fusion of convolutional neural networks (CNNs) and vision transformers (ViTs) is a powerful strategy for remote sensing scene classification, leveraging their complementary strengths in local texture and global context modeling. To fully exploit these complementary strengths for addressing the interclass similarity and high intraclass variability caused by the complex spatial arrangements of RS scenes, this work introduces the hierarchically aligned bidirectional CNN-Transformer network (HAB-Net), which fosters deeper, two-way integration through two novel components. First, hierarchical attention gating (HAG) distills multilevel attention from the ViT into spatial gates, compelling the CNN to focus on semantically critical regions. In turn, CNN-driven feedback attention (CFA) completes the loop by feeding these enhanced, detail-rich CNN features back into the ViT, refining its tokens via cross-attention. Ultimately, a dual-stream head merges these mutually reinforced features for scene classification. Extensive experiments on the UCM, AID, and NWPU-RESISC45 benchmarks demonstrate that HAB-Net achieves state-of-the-art performance. Ablation studies confirm the indispensable contributions of both HAG and CFA, validating the effectiveness of the proposed deep bidirectional integration strategy.},
 author = {Gong, Xi and Xie, Xuejing and Xu, Yongyang and Xie, Zhong},
 doi = {10.1109/JSTARS.2026.3670965},
 issn = {2151-1535},
 journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
 keyword = {Feature extraction;Semantics;Transformers;Remote sensing;Scene classification;Convolutional neural networks;Attention mechanisms;Convolutional codes;Computer vision;Computational modeling;Bidirectional fusion;convolutional neural network (CNN);remote sensing scene classification (RSSC);vision transformer (ViT)},
 month = {},
 number = {},
 pages = {9934-9952},
 title = {HAB-Net: Bidirectional CNN-Transformer With Hierarchical Alignment for Remote Sensing Scene Classification},
 volume = {19},
 year = {2026}
}
