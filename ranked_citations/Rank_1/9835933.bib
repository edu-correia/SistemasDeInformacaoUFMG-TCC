@inproceedings{9835933,
 abstract = {Sentiment Analysis makes use of several natural language processing methods in order to understand subjective knowledge from a given statement. This is an important issue that is presently being explored because of the multiple applications that may be derived from comments on social media platforms, answers from surveys, product assessments, or making data driven choices. Our work suggests an unique evolutionary game theoretic method to sentiment analysis. Each word in our method is represented as a node on a graph, and each sentiment-sense as a class. The algorithm distributes sentiment-sense to consistent classes depending on how similar each word is to the others, so that identical words are confined to comparable classes. The system’s dynamics are modeled as a non-cooperative multiplayer game in which players are data points who pick their class affiliations and equilibria correlate to accurate data labeling. By merging many modern game theory methods, we hope to find the best feasible solution using game theory to optimize the accuracy of the specified NLP task, namely Sentiment Analysis.},
 author = {Jain, Minni and Gayathri, Banavath and Ranjan, Ritwik and Rohit},
 booktitle = {2022 7th International Conference on Communication and Electronics Systems (ICCES)},
 doi = {10.1109/ICCES54183.2022.9835933},
 issn = {},
 keyword = {Sentiment analysis;Social networking (online);Heuristic algorithms;Merging;Games;Data models;Labeling;Sentiment Analysis;GloVe Word Embedding;Natural Language Processing;Sentiwordnet;Game Theory},
 month = {June},
 number = {},
 pages = {963-968},
 title = {SentiGames- A Game Theoretic Approach To Sentiment Analysis},
 volume = {},
 year = {2022}
}
