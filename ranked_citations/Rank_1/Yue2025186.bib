@conference{Yue2025186,
 abstract = {A new roof detection framework is proposed in this article for detecting roofs from raw point cloud obtained from ALS (Airborne Laser Scanner). There are two main problems solved by the framework, the first problem is that the traditional supervoxel-based algorithm cannot provide accurate feature extraction regions, leading to degradation of classification performance. The second problem is that traditional individual roof segmentation algorithms suffer from the difficulty of ensuring a balance between efficiency and accuracy. To address the first problem, a SLSC (Supervoxel-based Linear Spectral Clustering Segmentation) algorithm is proposed for the feature extraction, which takes into account the correlation of local neighbor changes in terms of supervoxels and provides suitable neighbors for feature computation. Experiments are conducted on two ALS point cloud datasets to evaluate the performance of the algorithms in this article. This algorithm achieved advanced results on two datasets, with overall accuracies of 73.29% and 81.21%, respectively.  © 2025 IEEE.},
 author = {Yue, Lili and Yun, Mengqing and Han, Di},
 doi = {10.1109/ICPECA63937.2025.10928935},
 journal = {2025 IEEE 5th International Conference on Power, Electronics and Computer Applications, ICPECA 2025},
 note = {Cited by: 1},
 pages = {186 - 190},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Novel Roof Detection Algorithm Based SLSC Supervoxel for Airborne LiDAR Point Cloud Data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105002587151?origin=resultslist},
 year = {2025}
}
