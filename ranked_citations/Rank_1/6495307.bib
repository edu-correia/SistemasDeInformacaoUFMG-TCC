@inproceedings{6495307,
 abstract = {In this paper, the semantic image segmentation framework based on spatial context relations is proposed. First, the knowledge representation scheme of an image is introduced, which include fuzzy ontology structure and spatial context relations. For the purpose of the initial labeling of segmented regions, the multiclass fuzzy Support Vector Machine (multi-FSVM) is employed. A new image segmentation algorithm with high-level semantics is proposed, which is based on spatial context relations. At last, the experimental results are illustrated, and the advantage of the proposed image segmentation method is discussed.},
 author = {Ri, Chang-Yong and Yao, Min},
 booktitle = {2012 Fourth International Symposium on Information Science and Engineering},
 doi = {10.1109/ISISE.2012.31},
 issn = {2160-1291},
 keyword = {Image segmentation;Semantics;Ontologies;Feature extraction;Vectors;Visualization;Labeling;Training;Merging;Testing;semantic image segmentation;fuzzy ontology;spatial context relations;multi-FSVM},
 month = {Dec},
 number = {},
 pages = {104-108},
 title = {Semantic Image Segmentation Based on Spatial Context Relations},
 volume = {},
 year = {2012}
}
