@article{LI2025117528,
 abstract = {We propose a relatively simple and mesh-independent approach to model crack branching and merging using the Shifted Fracture Method (SFM), within the class of Shifted Boundary Methods. The proposed method achieves mesh independency by accurately accounting for the area of the fracture surface, in contrast to traditional element-deletion/node-release techniques. In the SFM, the true fracture is embedded into the computational grid, but the fracture interface conditions are modified (shifted) by means of Taylor expansions to the surrogate fracture composed of full edges/faces in two/three dimensions. This avoids numerical integration on cut elements, so that the data structures and geometrical treatment of cut elements are simple, while mesh-independent results and accurate fracture approximations are still maintained. We demonstrate the capabilities of the proposed approach in a number of prototypical numerical experiments.},
 author = {Kangan Li and Antonio Rodríguez-Ferran and Guglielmo Scovazzi},
 doi = {https://doi.org/10.1016/j.cma.2024.117528},
 issn = {0045-7825},
 journal = {Computer Methods in Applied Mechanics and Engineering},
 keyword = {Crack branching, Crack merging, Shifted boundary method, Shifted fracture method, Fracture mechanics},
 pages = {117528},
 title = {Crack branching and merging simulations with the shifted fracture method},
 url = {https://www.sciencedirect.com/science/article/pii/S0045782524007825},
 volume = {433},
 year = {2025}
}
