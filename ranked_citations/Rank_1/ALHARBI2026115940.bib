@article{ALHARBI2026115940,
 abstract = {Sb2O3, Bi2O3, and GO nanocomposite (NC) were combined via ultrasonication to investigate their photocatalytic behavior as binary and ternary NCs. Several characterization techniques were employed to characterize the NCs. XRD analysis reveals that the ternary NCs contain all expected phases with notable crystallite size reduction upon incorporation of GO. Pure Bi2O3 exhibits a monoclinic phase with sizes in the range from 86.6 nm to 307.2 nm, while Sb2O3 demonstrates a cubic structure with crystallite sizes from 93.8 nm to 362.2 nm. The ternary composite shows further size reduction, with crystallite sizes between 11.5 nm and 225.2 nm. TEM micrograph exhibits Sb2O3 and Bi2O3 particle size reduction upon merging them with GO in the ternary composite. Pure Bi2O3 is shown with an average particle size of 27–50 nm. Also, ternary NC showed increasing in recombination inhibition efficiency reaching 40 %. Moreover, the degradation effectiveness of MB dye reached 70.37, and 90.74 % for Bi2O3, and Bi2O3/GO, respectively. Therefore, the ternary Sb₂O₃/Bi₂O₃/GO NC demonstrates enhanced photocatalytic efficiency due to improved crystallite size reduction, charge separation, and light absorption, which indicate its status as a promising candidate for water treatment applications.},
 author = {Walaa Alharbi},
 doi = {https://doi.org/10.1016/j.inoche.2025.115940},
 issn = {1387-7003},
 journal = {Inorganic Chemistry Communications},
 keyword = {SbO, BiO, And graphene oxide, Photocatalytic, Wastewater treatment},
 pages = {115940},
 title = {Physicochemical investigation and development of photocatalytic composite containing antimony oxide, bismuth oxide, and graphene oxide for methylene blue degradation},
 url = {https://www.sciencedirect.com/science/article/pii/S1387700325020581},
 volume = {184},
 year = {2026}
}
