@inproceedings{10544805,
 abstract = {The study presents a novel approach to modeling accuracy in autonomous driving vision systems using neural networks. By merging various vision technologies and advanced neural network architectures, the proposed methodology aims to improve perception accuracy and safety in autonomous driving scenarios. The introduction describes the central role of automobiles in today's society and the burgeoning development of autonomous driving technologies in the automotive industry. The background section reviews recent advances in self-driving technology, emphasizing the integration of computational perception and multiple sensor inputs as foundational elements. The methodology section discusses the intricacies of vision modeling for autonomous driving, including object detection, instance segmentation, lane line detection, and 3D reconstruction models. The discussion extends to the challenges of accurate perception in autonomous vehicles, highlighting the importance of deep learning techniques and convolutional neural networks (CNNs). The simulation and testing section explains the experimental setup, leveraging high-performance computing resources and curated datasets for comprehensive evaluations. Evaluation metrics such as Intersection over Union (IoU) and Million Multiply-Accumulate Operations (MACs) are used to assess model performance and computational complexity. The results highlight the effectiveness of the proposed methodology in improving model accuracy and computational efficiency for various autonomous driving tasks. Ultimately, the study underscores the importance of accurate vision modeling in advancing the safety and reliability of autonomous driving technologies, and provides a foundational framework for future research and development efforts in this area.},
 author = {Zhou, Jiyan and Liu, Jinfeng},
 booktitle = {2024 International Conference on Inventive Computation Technologies (ICICT)},
