@conference{Sajeev201174,
 abstract = {Fast retrieval of relevant information from the databases has always been a significant issue. Different techniques have been developed for this purpose; one of them is Data mining. Clustering analysis is a key and easy tool in data mining and pattern recognition. In this paper K-Mean clustering is used for evaluating the performance of socially and economically backward group of people, self help groups (SHG's) in Kerala state, and suggestions are made to improve socioeconomic status. The necessary information about the members of SHG has been collected from 9 districts in Kerala through structured questionnaire. The Parameters considered for the study are financial status, types of loan availed, improvement in assets before and after joining the group, effect of joining in more than one group and district wise analysis. © 2011 IEEE.},
 author = {Sajeev, B.U. and Thangavel, K.},
 doi = {10.1109/ICoAC.2011.6165152},
 journal = {3rd International Conference on Advanced Computing, ICoAC 2011},
 note = {Cited by: 1},
 pages = {74 - 81},
 publication_stage = {Final},
 source = {Scopus},
 title = {Evolving effective strategies for enhancing SHG's using K-mean clustering},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84880857141?origin=resultslist},
 year = {2011}
}
