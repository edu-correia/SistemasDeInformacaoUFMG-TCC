@article{CAO2026127850,
 abstract = {Accurate and efficient estimation of large-scale crop yield is crucial for agricultural management and policy formulation. Existing crop models often suffer from poor large-scale performance, strong sample dependence, and limited extrapolation ability. To address these limitations, we proposed an innovative physics-guided deep learning model based on remote sensing for crop yield estimation. It structurally integrates the physical model and deep learning model in an end-to-end architecture by embedding physical processes as the neural network layers, introducing physical constraints into loss functions, and incorporating prior knowledge into neural networks. The intrinsically hybrid design merges the interpretability of physical models with the powerful data-fitting capabilities of deep learning, leveraging the strengths of both methodologies. We comprehensively evaluated model performances in the major wheat planting regions of China. Across all tests, our model demonstrates robust performance with maximum NRMSE values below 25 %. Compared with conventional models, our model generally has smaller errors and higher accuracy. The performance improvements are especially evident in the leave-one-out experiments, with the average RMSE reduction of up to 15 %, and with reductions observed in most of the left-out provinces and years. The results highlight stronger universality and spatiotemporal extrapolation capacity of our model. Current model performance is constrained by some omitted variables, incomplete crop growth physics, and network architecture selection, and thus, future studies can incorporate better variable data, additional physical theories, and more advanced network designs. Our study provides an effective intrinsically hybrid crop modeling framework, contributes to overcoming limitations of existing models, and improves the large-scale crop yield estimation.},
 author = {Bowen Cao and Le Yu and Liheng Zhong and Shengchao Qiao and Shen Tan and Xiaomeng Huang and Han Wang},
 doi = {https://doi.org/10.1016/j.eja.2025.127850},
 issn = {1161-0301},
 journal = {European Journal of Agronomy},
 keyword = {Crop yield, Physics-guided deep learning, Hybrid model, Remote sensing},
 pages = {127850},
 title = {Physics-guided deep learning for crop yield estimation},
 url = {https://www.sciencedirect.com/science/article/pii/S1161030125003466},
 volume = {172},
 year = {2026}
}
