@inbook{11285994,
 abstract = {<p>This chapter explores the evolution of information transfer technology, from telegraph communication's inception to the contemporary challenges of millimeter&#x2010;scale data transfer within high&#x2010;performance VLSI chip packaging. Guided by Shannon's theory of information and driven by a vision to transcend its boundaries, we emphasize the rising demand for innovation in this field, underscored by substantial investments from leading semiconductor companies. In this context, spoof plasmonic interconnect technology is introduced as a promising solution for high performance packaging and millimeter&#x2010;scale data transfer. Merging optical and electrical advantages, this technology offers an energy&#x2010;efficient approach to bridging the &#x201c;last centimeter&#x201d; gap between chips. The analyses are shown for optimization of bandwidth density and signal propagation length, yielding high data transfer speeds and signal integrity. The method of calculation and analysis of signal integrity and bandwidth for spoof plasmonic interconnect would help the engineering practitioners for assimilating spoof plasmonics in the chip design and assessing the performance improvement.</p>},
 author = {Joy, Soumitra R. and Mazumder, Pinaki},
 booktitle = {Artificial Plasmonics for VLSI Interconnects: Bridging the Gap between Electronics and Optics},
 doi = {10.1002/9781394290000.ch04},
 isbn = {9781394289981},
 issn = {},
 keyword = {Noise;Transistors;Plasmons;Data transfer;Underwater cables;Redundancy;Noise measurement;Information processing;Very large scale integration;Technological innovation},
 number = {},
