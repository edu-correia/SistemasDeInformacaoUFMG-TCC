@article{10.1145/3185596,
 abstract = {Analytics in professional sports has experienced a dramatic growth in the last decade due to the wide deployment of player and ball tracking systems in team sports, such as basketball and soccer. With the massive amount of fine-grained data being generated, new data-points are being generated, which can shed light on player and team performance. However, due to the complexity of plays in continuous sports, these data-points often lack the specificity and context to enable meaningful retrieval and analytics. In this article, we present an intelligent human--computer interface that utilizes trajectories instead of words, which enables specific play retrieval in sports. Various techniques of alignment, templating, and hashing were utilized by our system and they are tailored to multi-agent scenario so that interactive speeds can be achieved. We conduct a user study to compare our method to the conventional keywords-based system and the results show that our method significantly improves the retrieval quality. We also show how our interface can be utilized for broadcast purposes, where a user can draw and interact with trajectories on a broadcast view using computer vision techniques. Additionally, we show that our method can also be used for interactive analytics of player performance, which enables the users to move players around and see how performance changes as a function of position and proximity to other players.},
 address = {New York, NY, USA},
 articleno = {13},
 author = {Sha, Long and Lucey, Patrick and Yue, Yisong and Wei, Xinyu and Hobbs, Jennifer and Rohlf, Charlie and Sridharan, Sridha},
 doi = {10.1145/3185596},
 issn = {1073-0516},
 issue_date = {April 2018},
 journal = {ACM Trans. Comput.-Hum. Interact.},
 keyword = {sports analytics, interactive analytics, fine-grain retrieval, camera calibration, alignment, Multiagent trajectories},
 month = {April},
 number = {2},
 numpages = {32},
 publisher = {Association for Computing Machinery},
 title = {Interactive Sports Analytics: An Intelligent Interface for Utilizing Trajectories for Interactive Sports Play Retrieval and Analytics},
 url = {https://doi.org/10.1145/3185596},
 volume = {25},
 year = {2018}
}
