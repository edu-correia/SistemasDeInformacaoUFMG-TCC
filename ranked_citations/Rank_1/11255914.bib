@inproceedings{11255914,
 abstract = {Vacuum circuit breakers (VCBs) have gained a dominant position in medium-voltage applications due to their environmentally benign nature and excellent interruption performance. With ongoing technological advancements, their application is gradually expanding into higher voltage levels. A precise understanding of the initiation and evolution of vacuum arcs is essential for improving the operational performance and design of VCBs. The interelectrode plasma in a vacuum arc is generated by multiple cathode spots distributed over the cathode surface. Each cathode spot emits a plasma jet, which merges with adjacent jets at a certain distance from the cathode to form a continuous arc column. Therefore, investigating the interaction and mixing behavior of multiple plasma jets under high-current conditions is vital for deepening the understanding of vacuum arc dynamics. This paper develops a three-dimensional magnetohydrodynamic (MHD) model based on a practical vacuum interrupter design featuring a six-slot axial magnetic field contact structure. The model is used to simulate the mixing process of plasma jets from multiple cathode spots under highcurrent conditions. Key plasma parameters-including ion pressure, ion temperature, axial velocity, and axial current density—are computed and analyzed. Moreover, the influence of a uniform axial magnetic field on the mixing characteristics of the cathodic plasma jets is systematically investigated. The results provide theoretical support for further studies on vacuum arc behavior and offer technical insights for enhancing the interruption capability of vacuum switching devices. This work also contributes to the future optimization and development of vacuum circuit breaker technologies},
 author = {Song, Jiayi and Huang, Xiaolong and Zhong, Xuewen and Le, Xiaoxi and Zhao, Lihua and Jia, Shenli},
 booktitle = {2025 31st International Symposium on Discharges and Electrical Insulation in Vacuum (ISDEIV)},
 doi = {10.1109/ISDEIV60861.2025.11255914},
 issn = {2471-786X},
 keyword = {Plasma jets;Magnetohydrodynamics;Interrupters;Vacuum technology;Ions;Plasmas;Magnetic fields;Plasma temperature;Vacuum arcs;Cathodes;Cathode spots;Vacuum arc;Simulation},
 month = {Sep.},
 number = {},
 pages = {1-4},
 title = {Modeling and Simulation of Cathode Spot Jet Mixing Process Based on Realistic Contact Geometry},
 volume = {},
