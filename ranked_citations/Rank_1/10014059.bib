@inproceedings{10014059,
 abstract = {Currently, one of the main problems in sensor data delivery is handling data loss. And retransmission is a basic solution for data recovery. However, existing recovery schemes do not consider retransmission reduction based on data similarity. Hence, in this paper, we propose a similarity-based sensor data recovery method. Through simulation, our results show that the proposed method achieves retransmission reduction in terms of bandwidth consumption and network load.},
 author = {Win, Ei Khaing and Yoshihisa, Tomoki},
 booktitle = {2022 IEEE 11th Global Conference on Consumer Electronics (GCCE)},
 doi = {10.1109/GCCE56475.2022.10014059},
 issn = {2378-8143},
 keyword = {Bandwidth;Consumer electronics;Load modeling;stream data;sensor data delivery;IoT;retransmission;stream merge},
 month = {Oct},
 number = {},
 pages = {830-831},
 title = {A Similarity-Based Sensor Data Recovery Scheme},
 volume = {},
 year = {2022}
}
