@conference{Guo2023146,
 abstract = {Industrial IoT systems combined with edge computing play a growing role in the digital transformation of manufacturing companies. In actual implementations, the heart of the system is a time-series database located at the edge. To this end, we have designed and implemented RibesDB, which can be deployed at the edge to provide a real-Time data source for field management, while incorporating AI models that can analyse field data in real-Time to detect and predict equipment malfunctions in the field. © 2023 IEEE.},
 author = {Guo, Dashuai and Wang, Joseph. K.H.},
