@inproceedings{11377113,
 abstract = {Modern schooling has changed as a result of the quick development by using digital technology and artificial intelligence platform. However, existing systems frequently fall short, either missing academic structure or concentrating on administrative course management with little engagement. Learn-hub is a cutting-edge digital learning platform that aims to close this gap by fusing intelligent, interactive engagement technologies with structured academic content. Real-time tutoring, intelligent Q&A, content summarization, and context-aware feedback are all made possible by LearnHub's fusion of Natural Language Processing (NLP) and Chatting-powered conversational AI. Through dynamic, human-like interactions, these technologies promote self-assessment, personalize learning experiences, and promote deeper knowledge. A secure, scalable, and role-based infrastructure underpins the additional features, which include faculty-curated resource libraries, moderated discussion forums, and AI-driven content suggestions. Improved student involvement is demonstrated by early adoption. So this work based on building the learning platform on real-time collaboration features, block chain-based certification, multilingual and offline accessibility, and customized corporate training modules. Here, By merging NLP and conversational AI with pedagogical rigor, Learn-hub aims to redefine digital education and become a global leader in lifelong learning and academic collaboration.},
 author = {Lawand, Sourabh and Sarwar, Shubham and Nimbhore, Padma and Basatwar, Harsh and Gandewar, Arya and Nimkar, Madhavi},
 booktitle = {2025 IEEE International Conference on Blockchain and Distributed Systems Security (ICBDS)},
 doi = {10.1109/ICBDS67396.2025.11377113},
 issn = {},
 keyword = {Human computer interaction;Discussion forums;Conversational artificial intelligence;Merging;Libraries;Real-time systems;Question answering (information retrieval);Multilingual;Security;Standards;Discussion forum;mentor-ship program;AI powered engagement;Assessment;resource library},
 month = {Oct},
 number = {},
 pages = {1-5},
 title = {Community-Oriented Digital Learning via Adaptive Mentor-Ship and AI-Driven Personalization},
