@article{Zheng2026,
 abstract = {Facial expression recognition (FER) remains a challenging task due to the intrinsic variability of facial expressions and the demand for robust emotion classification across diverse conditions. Conventional FER approaches primarily rely on visual features, which often lack the generalizability required to handle subtle and complex emotional variations. To address the limitations of unimodal approaches, we propose a unified vision-language framework, termed vision-language feature enhancement with cross-attention learning (VLCA), which facilitates semantic enrichment and discriminative feature learning through cross-modal interaction. The proposed method integrates a learnable visual encoder and a frozen pretrained CLIP visual encoder to capture both adaptive and generalizable visual representations, while a frozen pretrained CLIP textual encoder generates emotion-aware textual embeddings from class-level prompts. These multimodal representations are aligned and refined through a transformer-guided cross-feature encoder, enabling hierarchical feature enhancement across modalities. Furthermore, a multi-branch classification mechanism combines cross-modal alignment, individual visual semantics, and their fusion to enhance robustness. Comprehensive experiments conducted on three benchmark FER datasets demonstrate the superiority of the proposed approach, with VLCA achieving an accuracy of 92.12 % on RAF-DB, and 65.84 % and 61.96 % on AffectNet-7 and AffectNet-8, respectively. Extensive ablation studies and visualizations validate the module synergy and demonstrate the model’s focus on emotionally salient facial regions, enhancing both performance and interpretability. © 2025 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
 author = {Zheng, Zijun and Wu, Heng and Wang, Jiabao and Lv, Laishui and Bardou, Dalal and Yu, Gaohang},
 doi = {10.1016/j.eswa.2025.130292},
 journal = {Expert Systems with Applications},
 note = {Cited by: 4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {VLCA: Vision-language feature enhancement with cross-Attention learning for facial expression recognition},
 type = {Article},
