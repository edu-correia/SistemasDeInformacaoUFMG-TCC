@article{10.1145/3785362,
 abstract = {The increasing complexity of digital circuits and the limitations of heuristic methods have led to growing interest in applying Machine Learning (ML) to Logic Synthesis (LS). ML provides a promising paradigm shift by implementing automated, scalable, and data-driven optimization strategies. This survey provides a comprehensive overview of the latest studies on ML approaches in LS, offering a deep understanding of the fundamental ML methods, and analyzing their strengths and limitations through systematic comparisons. We categorize existing works into two main types: ML-Assistance methods aiming at predicting performance metrics and reducing the cost of traditional simulations, and ML-Agent methods directly replacing heuristic processes in the LS flow. We further analyze ML methods and applications in different LS stages, including Boolean circuit generation, Boolean circuit analysis, logic optimization, and technology mapping, showing great achievements and improvement in exploring non-linear design spaces and discovering new optimization strategies. Finally, we discuss the challenges and limitations in the current situation and further provide a vision of future directions in LS.},
 address = {New York, NY, USA},
 articleno = {38},
 author = {Liu, Miao and Ni, Liwei and Liu, Junfeng and Meng, Xingyu and Wang, Rui and Lin, Xiaoze and Lai, Xinhua and Li, Xingquan and Xu, Jungang},
 doi = {10.1145/3785362},
 issn = {1084-4309},
 issue_date = {March 2026},
 journal = {ACM Trans. Des. Autom. Electron. Syst.},
 keyword = {Machine learning, logic synthesis, electronic design automation, logic optimization},
 month = {January},
 number = {2},
 numpages = {43},
 publisher = {Association for Computing Machinery},
 title = {A Survey of Machine Learning Approaches in Logic Synthesis},
 url = {https://doi.org/10.1145/3785362},
 volume = {31},
 year = {2026}
}
