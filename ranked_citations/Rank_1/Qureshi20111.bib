@article{Qureshi20111,
 abstract = {As conventional memory technologies such as DRAM and Flash run into scaling challenges, architects and system designers are forced to look at alternative technologies for building future computer systems. This synthesis lecture begins by listing the requirements for a next generation memory technology and briefly surveying the landscape of novel non-volatile memories. Among these, Phase Change Memory (PCM) is emerging as a leading contender, and the authors discuss the material, device, and circuit advances underlying this exciting technology. The lecture then describes architectural solutions to enable PCM for main memories. Finally, the authors explore the impact of such byte-addressable non-volatile memories on future storage and system designs. Copyright © 2011 by Morgan & Claypool.},
 author = {Qureshi, Moinuddin K. and Gurumurthi, Sudhanva and Rajendran, Bipin},
 doi = {10.2200/S00381ED1V01Y201109CAC018},
 journal = {Synthesis Lectures on Computer Architecture},
 note = {Cited by: 84},
 pages = {1 - 134},
 publication_stage = {Final},
 source = {Scopus},
 title = {Phase change memory: From devices to systems},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/83455203773?origin=resultslist},
 volume = {18},
 year = {2011}
}
