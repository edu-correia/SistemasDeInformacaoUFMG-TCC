@article{Ordonez201646,
 abstract = {What is the story of an image? What is the relationship between pictures, language, and information we can extract using state of the art computational recognition systems? In an attempt to address both of these questions, we explore methods for retrieving and generating natural language descriptions for images. Ideally, we would like our generated textual descriptions (captions) to both sound like a person wrote them, and also remain true to the image content. To do this we develop data-driven approaches for image description generation, using retrieval-based techniques to gather either: (a) whole captions associated with a visually similar image, or (b) relevant bits of text (phrases) from a large collection of image + description pairs. In the case of (b), we develop optimization algorithms to merge the retrieved phrases into valid natural language sentences. The end result is two simple, but effective, methods for harnessing the power of big data to produce image captions that are altogether more general, relevant, and human-like than previous attempts. © 2015, Springer Science+Business Media New York.},
 author = {Ordonez, Vicente and Han, Xufeng and Kuznetsova, Polina and Kulkarni, Girish and Mitchell, Margaret and Yamaguchi, Kota and Stratos, Karl and Goyal, Amit and Dodge, Jesse and Mensch, Alyssa and Daumé, Hal and Berg, Alexander C. and Choi, Yejin and Berg, Tamara L.},
 doi = {10.1007/s11263-015-0840-y},
 journal = {International Journal of Computer Vision},
 note = {Cited by: 64},
 number = {1},
 pages = {46 - 59},
 publication_stage = {Final},
 source = {Scopus},
 title = {Large Scale Retrieval and Generation of Image Descriptions},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84936796885?origin=resultslist},
 volume = {119},
 year = {2016}
}
