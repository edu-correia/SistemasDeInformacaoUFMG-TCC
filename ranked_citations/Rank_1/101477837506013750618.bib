@article{10.14778/3750601.3750618,
 abstract = {Couchbase Capella is a scalable document-oriented database service in the cloud. Its existing Capella Operational service is based on a shared-nothing architecture and supports high volumes of low-latency queries and updates for JSON documents. Its new Capella Columnar cloud service complements the Operational service. The Capella Columnar service supports complex analytical queries (e.g., ad hoc joins and aggregations) over large collections of JSON documents that can originate from a variety of Couchbase and non-Couchbase data sources and formats and can either be stored and managed by the Capella Columnar service or externally stored and accessed on demand at query time. This paper describes the new Capella Columnar service, looking both over and under the hood.},
 author = {Hubail, Murtadha Al and Alsuliman, Ali and Alkowaileet, Wail and Blow, Michael and Carey, Michael and Enukonda, Savyasach and Gupta, Peeyush and Hegde, Santosh and Jagtiani, Kamini and Jindal, Abhishek and Khan, Mohammad Nawazish and Mahin, Mehnaz and Maxon, Ian and Muralikrishna, M. and Murthy, Keshav and Nagy, Daniel and Poluparthi, Preetham and Prabhu, Ankit and Raj, Ritik and Sarathy, Vijay and Shirazi, Shahrzad and Singh, Utsav and Towaileb, Hussain and Tripathi, Ayush and Tripurwar, Janhavi and Wang, Bo-Chun and Westmann, Till},
 doi = {10.14778/3750601.3750618},
 issn = {2150-8097},
 issue_date = {August 2025},
 journal = {Proc. VLDB Endow.},
 month = {August},
 number = {12},
 numpages = {13},
 pages = {4938–4950},
 publisher = {VLDB Endowment},
 title = {Cloudy with a Chance of JSON},
 url = {https://doi.org/10.14778/3750601.3750618},
 volume = {18},
