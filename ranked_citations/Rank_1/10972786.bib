@inproceedings{10972786,
 abstract = {This paper investigates the use of mixed reality technology to support mathematics instruction at the elementary level. An MR-based educational game focused on the four basic operations was developed and tested with a group of elementary school teachers, who provided feedback on its usability and potential for classroom integration. The results suggest that MR-based learning not only supports a deeper conceptual understanding of mathematics but also addresses a variety of learning preferences, creating a more inclusive and engaging educational environment. The study highlights the necessity for ongoing teacher training and resource development to fully harness the potential of MR in elementary school mathematics education.},
 author = {Dos Santos, Wallesa D. M. Q. and Peretti, Adriano and Teixeira, João Marcelo X. N. and Peres, Fabiana F. F. and Mauricio, Claudio R. M. and Da Silva, Manoela M. O.},
 booktitle = {2025 IEEE Conference on Virtual Reality and 3D User Interfaces Abstracts and Workshops (VRW)},
 doi = {10.1109/VRW66409.2025.00055},
 issn = {},
 keyword = {Training;Headphones;Visualization;Three-dimensional displays;Merging;Mixed reality;Games;User interfaces;Mathematics;Usability;Augmented Reality;quiz;game;headset},
 month = {March},
 number = {},
 pages = {224-227},
 title = {Mixed Reality as a Tool to Enhance Mathematics Education in Elementary School},
 volume = {},
