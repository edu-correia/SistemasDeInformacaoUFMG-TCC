@inproceedings{9750708,
 abstract = {At present, it is straightforward for the subway platform door and train door to clamp foreign objects, or the foreign objects fall in the gap between the two doors that cause major traffic accidents. To improve the accuracy of foreign object detection and area perception, this paper proposes a real-time and accurate multi-task model that can simultaneously complete foreign object detection, area segmentation and area line detection. It has a shared encoder to extract deep features between related tasks and three encoders for the specific tasks. The Cross Stage Partial module is applied in the encoder to enhance the learning ability of CNN. Then, use the Spatial Pyramid Pooling and Feature Pyramid Network to merge features further. Besides, Lightweight models are used in these decoders to improve the inference speed of the model. The accuracy of the model almost exceeds the existing state-of-the-art methods while the inference speed of the model meets the real-time requirements.},
 author = {Liu, Weiming and Huang, Dedong},
 booktitle = {2022 3rd International Conference on Electronic Communication and Artificial Intelligence (IWECAI)},
 doi = {10.1109/IWECAI55315.2022.00077},
 issn = {},
 keyword = {Object detection;Multitasking;Feature extraction;Real-time systems;Decoding;Clamps;Task analysis;Subway;Multi-task model;Deep learning;Object detection;Semantic segmentation},
 month = {Jan},
 number = {},
 pages = {362-366},
 title = {Object Detection and Area Perception in Subway Operation Space Based on the Multi-task Model},
 volume = {},
 year = {2022}
}
