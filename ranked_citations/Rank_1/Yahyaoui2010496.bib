@conference{Yahyaoui2010496,
 abstract = {The adoption of WSPL as a language for expressing Web service policies has shown its adequacy. The expressivity and simplicity of that language were the key factors behind this success. A desired feature in specifying Web services policies is the introduction of the context concept. In fact, very often Web service designers look for expressing rules that depend on the context in which a Web service is operational. We propose in this paper a specification and an implementation of context-based Web services policies using the WSPL language. We show the expressivity of the proposed context specification and discuss its applicability. We also provide a prototype that illustrates the specification and implementation of context-based Web services policies. ©2010 IEEE.},
 author = {Yahyaoui, Hamdi and Almulla, Mohammed},
 doi = {10.1109/ICDIM.2010.5664644},
 journal = {2010 5th International Conference on Digital Information Management, ICDIM 2010},
 note = {Cited by: 3},
 pages = {496 - 501},
 publication_stage = {Final},
 source = {Scopus},
 title = {Context-based specification of web service policies using WSPL},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78650946826?origin=resultslist},
 year = {2010}
}
