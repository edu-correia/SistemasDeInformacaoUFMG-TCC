@article{SUN2025144427,
 abstract = {Recent years have witnessed significant scientific advancements and applications in the fields of Environmentally Extended Input-Output (EEIO) models and complex network analysis, often merging innovatively. Despite this progress, comprehensive studies on the research patterns, trends, and under-explored topics in each field individually, and at their intersection, remain sparse. Using the Word2vec model, this study addresses these gaps to analyze 172,509 papers published from 2000 to 2023. Our results show that the EEIO domain focuses primarily on life cycle assessment (LCA), carbon footprints, environmental impacts, sustainability, and greenhouse gas emissions. In contrast, complex network analysis is predominantly applied in biology, bioinformatics, medicine, and computer science. We identified 230 emerging and rising keywords in these fields, outnumbering the 103 keywords in decline, with 429 keywords remaining stable. Cross-integrated studies highlight the importance of LCA in the EEIO field and social network analysis in the complex network field. To enhance the cross-pollination of these disciplines, we recommend increasing the focus on water footprint analysis, renewable energy studies, and community detection techniques alongside other dynamic topics. This study aims to stimulate future research and innovation at the convergence of EEIO models and complex network analysis.},
 author = {Wenju Sun and Fengmei Ma and Asaf Tzachor and Yao Wang and Yongyue Gong and Chao Wang and Xiaoqian Hu and Heming Wang},
 doi = {https://doi.org/10.1016/j.jclepro.2024.144427},
 issn = {0959-6526},
 journal = {Journal of Cleaner Production},
 keyword = {Natural language processing, Word2vec, Environmentally extended input-output, Complex network, Word embedding},
 pages = {144427},
 title = {Bridging environmentally extended input-output models and complex network analysis: A bibliometric analysis of trends and opportunities},
 url = {https://www.sciencedirect.com/science/article/pii/S0959652624038769},
 volume = {486},
 year = {2025}
}
