@inproceedings{11496520,
 abstract = {To enable the design of a parts-moving robotic system for engineers are designing electromagnetic components to produce sufficient amounts of magnetic force to handle items in a robot while minimizing energy consumption and mechanical constraints. A new model has been developed, referred to as an Electromagnetically Secured Nonlinear Robot with Triple Mode Signal Jamming (ESNRTS). This new model offers a more advanced methodology for safely and securely performing robotic manipulation without having to worry about interference caused by the presence of non-linear fields. One of the key features of this system is that it presents an optimized design of an electromagnetic actuator which ensures stable operation over different weights and distances by using Bulk Robotic Manipulation Robot (BRMR) to make discrete representations of non-linear hydraulic models, thus enabling a control system of higher performance through greater fidelity. The control fidelity of the ESNRTS was enhanced by the integration of two extra layers into a hybrid control architecture that merges a Nonlinear Model Predictive Controller with an Artificial Neural Network (ANN).},
 author = {Saravanan, G. and Siva Magesh, G and Kavin Kumar, T and Arun Kumar, P and Vasathakumar, K},
 booktitle = {2026 International Conference on Electronic Systems and Intelligent Computing (ICESIC)},
 doi = {10.1109/ICESIC67389.2026.11496520},
 issn = {},
 keyword = {Jamming;Electronic warfare;Payloads;Filtering;Location awareness;Wireless Access in Vehicular Environments;Protocols;Mobile communication;HTTP;Data communication;Nonlinear Model Predictive Controller (NMPC);Artificial Neural Network (ANN);Multi-Modal Approaches and Nonlinear Robots;Bulk Robotic Manipulation Robot (BRMR)},
 month = {March},
 number = {},
 pages = {746-750},
 title = {Electromagnetic Design for Secured Nonlinear Robot with Triple Mode and Signal Jamming Using Neural Networks and Multimodal Locomotion},
