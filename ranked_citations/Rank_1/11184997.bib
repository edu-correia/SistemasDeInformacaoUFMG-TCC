@inproceedings{11184997,
 abstract = {The Zoom Analog-to-Digital Converter (Zoom ADC) generally combines the Successive Approximation Register (SAR) ADC and Delta-Sigma ADC, and is characterized by high resolution and high energy efficiency, thus attracting attention. Traditionally, the switching timing of the SAR ADC in the Zoom ADC consumes a large amount of power. In this paper, an improved merge-split switching strategy is proposed. By using the merge-split switching algorithm, the operation of charging and discharging only the capacitor of the current weight bit is realized, which significantly reduces the power consumption of the switching timing. At the same time, for the operational amplifier with a relatively large power consumption, a fully differential current-starved transconductance structure based on an inverter is adopted, which further reduces the power consumption. Based on the $0.18 \mu \mathrm{~m}$ Complementary Metal Oxide Semiconductor (CMOS) process, the designed Zoom ADC, under a power supply voltage of 1.8 V, a sampling frequency of 1.024 MHz, and an oversampling rate of 256 times, has a signal-to-noise and distortion ratio of 110.2 dB, a dynamic range of 112.4 dB, a power consumption of $457.1 \mu \mathrm{~W}$, and an energy efficiency figure of merit of 177.8. Compared with other Zoom ADCs, the designed ADC achieves higher accuracy while consuming lower power.},
 author = {Ding, Yue and Huang, Dong and Zhang, Jinyu and Feng, Zhenfu},
 booktitle = {2025 4th International Symposium on Semiconductor and Electronic Technology (ISSET)},
 doi = {10.1109/ISSET66828.2025.11184997},
 issn = {},
 keyword = {Operational amplifiers;Power demand;Capacitors;Switches;Voltage;CMOS process;Energy efficiency;Timing;Analog-digital conversion;Transconductance;analog-to-digital converter;dynamic zoom;lowpower consumption;inverting amplifier;capacitor array},
 month = {July},
 number = {},
 pages = {310-315},
 title = {A 457 μW Dynamic Zoom ADC With 112 dB DR and 110 dB SNDR in 2 kHz BW},
 volume = {},
 year = {2025}
}
