@inproceedings{5497713,
 abstract = {Two new chaotic attractors in a uniformly-coefficient jerk model are proposed with new coefficients and new nonlinearity. The latter is based on either arctangent or hyperbolic tangent nonlinearity. In particular, compound structures of both attractors are demonstrated through a half-image isolation using a control parameter C. The positive value of an appropriate C isolates the right half-image attractors whilst the negative value of an appropriate C isolates the left half-image attractor. Both images can then be merged together as a compound structure.},
 author = {Srisuchinwong, Banlue and Wangkuntod, Anawat and Tippinit, Janvit},
 booktitle = {2010 2nd International Conference on Future Computer and Communication},
 doi = {10.1109/ICFCC.2010.5497713},
 issn = {},
 keyword = {Chaos;Chaotic communication;Oscillators;Communications technology;Electronic mail;Differential equations;Mechanical systems;Acceleration;Control systems;Chaos;Uniformly-Coefficient Jerk Model;arctangent;hyperbolic tangent nonlinearity},
 month = {May},
 number = {},
 pages = {V1-622-V1-624},
 title = {Compound structures of two new chaotic attractors in a uniformly-coefficient jerk model with arctangent or hyperbolic tangent nonlinearity},
 volume = {1},
 year = {2010}
}
