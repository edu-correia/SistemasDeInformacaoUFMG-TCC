@article{10.14778/2536258.2536273,
 abstract = {The ability of efficiently detecting changes in XML documents is crucial in many application contexts. If such changes are represented as XQuery Update Pending Update Lists (PULs), they can then be applied on documents using XQuery Update engines, and document management can take advantage of existing composition, inversion, reconciliation approaches developed in the update processing context. The paper presents an XML edit-script generator with the unique characteristic of using PULs as edit-script language and improving the state of the art from both the performance and the generated edit-script quality perspectives.},
 author = {Cavalieri, Federico and Solimando, Alessandro and Guerrini, Giovanna},
 doi = {10.14778/2536258.2536273},
 issn = {2150-8097},
 issue_date = {August 2013},
 journal = {Proc. VLDB Endow.},
 month = {August},
 number = {13},
 numpages = {12},
 pages = {1630–1641},
 publisher = {VLDB Endowment},
 title = {Synthetising changes in XML documents as PULs},
 url = {https://doi.org/10.14778/2536258.2536273},
 volume = {6},
 year = {2013}
}
