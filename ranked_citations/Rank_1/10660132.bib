@inproceedings{10660132,
 abstract = {Applying for patents stands as a cornerstone strategy in safeguarding intellectual property and preserving innovative accomplishments. To address the constraints and inefficiencies inherent in conventional patent examination methodologies, particularly concerning plagiarism detection, this paper exemplifies the realm of telecommunication technology patents (H04) and introduces an innovative approach grounded in natural language processing and deep learning. By merging the Sentence-BERT (SBERT) pre-trained model with a multiplex of text similarity techniques, we devise a novel framework entitled Multi-Sim SBERT (MS-SBERT). This model serves to quantify the degree of resemblance between patents undergoing examination and a repository of reference patents, thereby fostering a thorough and meticulous appraisal process. Empirical validations attest to the efficacy of our model, achieving an impressive plagiarism detection accuracy rate of 98.15%. This surpasses the precision of the original Sentence BERT, empowering precise identification of comparable patents and furnishing refined discernment of plagiarism instances within patents under scrutiny. Consequently, the implementation of our model markedly bolsters the caliber and efficiency of patent examination procedures.},
 author = {Lin, Zexi and Shen, Yongluo},
 booktitle = {2024 2nd International Conference on Mechatronics, IoT and Industrial Informatics (ICMIII)},
 doi = {10.1109/ICMIII62623.2024.00038},
 issn = {},
 keyword = {Multiplexing;Patents;Accuracy;Plagiarism;Semantics;Merging;Intellectual property;patent plagiarism detection;Multi-Sim SBERT;natural language processing (NLP);patent examination},
 month = {June},
 number = {},
 pages = {163-166},
 title = {Patent Plagiarism Identification Model Based on Multi-Dimensional Similarity Fusion Using Multi-Sim SBERT},
 volume = {},
 year = {2024}
}
