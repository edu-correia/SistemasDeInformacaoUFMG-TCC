@conference{Youvalari2025,
 abstract = {This paper introduces a novel intra prediction method aimed at improving the coding efficiency of the Enhanced Compression Model (ECM). The proposed Occurrence-based Intra Coding (OBIC) method determines the optimal intra modes for block coding by analyzing the sample-wise occurrences of intra modes in the neighboring blocks. These occurrences are aggregated into a histogram of occurrences (HoC), from which the most frequent intra modes in the causal neighborhood are identified. The five most frequently-occurring modes' predictions are then blended with planar prediction to predict the block. The OBIC method was introduced at the 33<sup>rd</sup> JVET meeting and adopted into the ECM software at the 34<sup>th</sup> meeting. The proposed method achieves average BD-Rate savings of 0.10% for the All-Intra (AI) configuration and 0.05% for the Random Access (RA) configuration compared to version 12.0 of the ECM software. © 2025 IEEE.},
 author = {Youvalari, Ramin G. and Abdoli, Mohsen and Tissier, Alexandre and Plowman, Frank and Gao, Shuo},
 doi = {10.1109/PCS65673.2025.11417512},
 journal = {2025 Picture Coding Symposium, PCS 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Occurrence-based Intra Coding (OBIC) in Enhanced Compression Model (ECM)},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105035838590?origin=resultslist},
 year = {2025}
}
