@inproceedings{10677178,
 abstract = {Conventional navigation techniques for mobile robots typically leverage geometric attributes of the environment, such as landmarks or maps, to determine their position and plan trajectories. However, these methods encounter challenges when faced with abrupt lighting changes or the emergence of dynamic obstacles. In Contemporary advancements, Visual Inertial SLAM synergistically merges IMU data with data from RGB-D sensors to accurately localize a Differential Drive robot. The integration of semantic scene comprehension and neural network-driven path planning significantly enhances Camera Pose estimation and trajectory planning for mobile robots. The paper extensively describes utilization of 2D LiDAR and Monocular Camera based Differential Drive Robot for autonomous navigation in a simulated environment. Additionally, the paper introduces an innovative navigation stack based on Scene Understanding to navigate around newly encountered obstacles in the simulation environment. The navigation algorithm is further evaluated over benchmark metrics such as mIOU, FLOPS, mAP, spatial complexity and RMSE values.},
 author = {Rao, Prateeth and Ramachandran, Rikin},
 booktitle = {2024 IEEE International Conference on Electronics, Computing and Communication Technologies (CONECCT)},
 doi = {10.1109/CONECCT62155.2024.10677178},
 issn = {2766-2101},
 keyword = {Measurement;Visualization;Laser radar;Navigation;Trajectory planning;Robot vision systems;Cameras;Scene understanding;Differential Drive Robots;semantic segmentation;keypoint detection;ROS Noetic;Gazebo},
 month = {July},
 number = {},
 pages = {1-6},
 title = {Intelligent Navigation Tactics for Differential Drive Robots: Expanding Boundaries},
 volume = {},
 year = {2024}
}
