@inproceedings{11479243,
 abstract = {Smoking stays as the dominant evitable reasons of worldwide disorders such as cardiovascular, pulmonary, and oncology. Initial detection of smoking habits from systematic medical limits is significant for protective involvement; Despite that, such detection works are complicated by the imbalance of class, non-linear feature contact and restricted interpretability of conventional systems of deep learning. This study put forward a two-stage deep ensemble framework improved with a unique Depiction-Level Attention Fusion Network for exact and interpretable smoking status detection. First of all, a Probabilistic Blending Model is executed with the help of the Echo State Network and a 1D GoogleNet framework as base learners, succeeded by an AlexNet-based stacking meta-learner. Robust scaling, Random Forest feature selection, and Borderline-SMOTE balancing are utilized to enhance selective knowledge. Although the PBM attains a strong detective performance (ROC-AUC $=0.855277$), its decision-making is restricted to probability-level fusion.To tackle this constraint, an attention-based representation fusion mechanism is introduced that merges intermediate embeddings extracted from ESN and GoogleNet before final categorization. The attention layer strongly weighs latent depictions, allowing adaptive feature emphasis and improvised nonlinear modeling. The proposed attention fusion model reaches exceptional performance which is proved by experimental valuation with ROC-AUC of 0.862935, PR-AUC of 0.839491, Accuracy of 0.784633, and the lowest Brier score of 0.146613, outperforming individual base models and the PBM. In addition, a lightweight NLP integration layer allowss risk alerts, hidden smoker identification, and conversational medical interpretation. The proposed framework connects deep learning, ensemble optimization, and clinical explainability, supplying an expandable and illustratable decision-support tool for quick smoking risk detection in systems of healthcare.},
 author = {S S, Ramya and A, Prathiba and B, Krishnakumar and K, Venu},
 booktitle = {2026 Twelfth International Conference on Bio Signals, Images, and Instrumentation (ICBSII)},
