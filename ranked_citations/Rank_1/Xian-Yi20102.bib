@article{Xian-Yi20102,
 abstract = {So far, most Chinese natural language processing neglects the punctuations or oversimplifies their functi- ons. To improve the efficiency of Chinese similarity computing, this paper gives a Chinese similarity computing system model in accordance with the prob- lems of Chinese sentence similarity computation aspect. This model is a combination of punctuations and traditional similarity computing. Comparing with Cosine-based Similarity calculation, the sentence similarity calculation based on word shape and word order, and Sentence similarity calculation based on semantic, this model makes up their insufficiency to a certain extent. The experiment shows that this model has a higher rate of accuracy in Chinese similarity computing.},
 author = {Xian-Yi, Cheng and Ping, Sun and Qian, Zhu and Yue-Hong, Cai},
 doi = {10.4156/jcit.vol5.issue7.2},
 journal = {Journal of Convergence Information Technology},
 note = {Cited by: 10},
 number = {7},
 pages = {2},
 publication_stage = {Final},
 source = {Scopus},
 title = {The research of Chinese semantic similarity calculation introduced punctuations},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/78651553106?origin=resultslist},
 volume = {5},
 year = {2010}
}
