@article{YU2026111497,
 abstract = {Intention recognition for space non-cooperative targets strongly impacts the safety and reliability of spacecraft’s decision-making. To address this issue, this paper presents an intention recognition method for space non-cooperative targets based on the Kolmogorov-Arnold Transformer (KAT) model. Specifically, a formal description of the intention recognition problem for space non-cooperative targets and its corresponding mathematical model are first introduced. By incorporating relative motion configurations, relative attitude, and lighting conditions, we define a comprehensive intention space set of non-cooperative targets. Subsequently, we propose an intention recognition model based on KAT which integrates Kolmogorov-Arnold Networks (KANs) into Transformer to enhance the expressiveness and feature extraction capability of the intention recognition model. Numerical simulations are conducted and the results show that the proposed model has an accuracy of up to 99.15% for intention recognition at optimal parameters. Moreover, comparative simulations with other intention recognition models are conducted to validate the effectiveness, accuracy, and noise resistance of the proposed method.},
 author = {Yongbin Yu and Yanning Guo and Pengyu Wang and Haibo Zhang},
 doi = {https://doi.org/10.1016/j.ast.2025.111497},
 issn = {1270-9638},
 journal = {Aerospace Science and Technology},
 keyword = {Space non-cooperative targets, Intention recognition, Kolmogorov-Arnold networks, Transformer},
 pages = {111497},
 title = {Intention recognition for space non-cooperative targets using Kolmogorov-Arnold transformer},
 url = {https://www.sciencedirect.com/science/article/pii/S1270963825015615},
 volume = {170},
 year = {2026}
}
