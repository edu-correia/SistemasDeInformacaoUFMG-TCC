@inproceedings{11076864,
 abstract = {In this manuscript, a novel graphene-based frequency reconfigurable antenna for terahertz applications is proposed. The antenna covers the frequency band from 2 THz to 4 THz with an overall size of $200 \mu \mathrm{~m} \times 350 \mu \mathrm{~m}$. The designed antenna has a compact structure and low profile. The shape of the radiator is modified from a merged elliptical structure, and the feed line is tailored using hexagonal slots. A Split Ring Resonator (SRR) is incorporated to achieve dual-band operation and enhance near-field confinement. The impedance bandwidth achieved is 4 THz, and the antenna gain is above 3 dBi. The radiation characteristics are directional within the desired operating bands.},
 author = {Subbaraj, Sangeetha and Thomas, Shweta B. and Singh, Aniket Kumar and Philip, Robin and Mishra, Tanmay},
 booktitle = {2025 International Conference on Microwave, Optical, and Communication Engineering (ICMOCE)},
 doi = {10.1109/ICMOCE64100.2025.11076864},
 issn = {},
 keyword = {Microwave antennas;Wireless communication;Wireless sensor networks;Graphene;Resonant frequency;Terahertz radiation;Bandwidth;Voltage;Antennas;Terahertz communications;Reconfigurable Antenna;Tera hertz Antenna;Graphene-based Antenna},
 month = {May},
 number = {},
 pages = {1-4},
 title = {Graphene-Inspired THz Frequency-Reconfigurable Antennas for Biomedical Applications},
 volume = {},
 year = {2025}
}
