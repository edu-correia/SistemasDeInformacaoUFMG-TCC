@article{RILEY2025111058,
 abstract = {Objectives
We aimed to examine structural racism as a determinant of abortion timing and delays to care, and how this might be changing after Dobbs v Jackson Women’s Health Organization.
Methods
Data included all abortions performed at a high-volume reproductive healthcare clinic network in Washington state from January 1, 2017, to July 31, 2023 (n=18,331). We used the American Community Survey to calculate the index of concentration at the extremes (ICE), a proxy measure of structural racism that captures racialized economic spatial polarization. ICE scores, ranging from - 1 to 1, were categorized into quintiles (quintile 1: most marginalized to quintile 5: most privileged), and then merged into the clinical data by patient zip code. Generalized linear models estimated the association between structural racism and gestational duration (days) and time from calling the clinic to abortion appointment (days).
Results
A higher proportion of individuals in the most privileged ICE quintile had private insurance, received a medication abortion, and had a fetal indication (eg, genetic abnormalities) compared to those in the most marginalized ICE quintile. Individuals in the most privileged ICE quintile received their abortion, on average, 10 days (95% CI, -13, -7) earlier in gestation and had a shorter time to appointment (-1.7 days, 95% CI: -2.2, -1.1) than those in the most marginalized ICE quintile. This relationship stayed consistent across pre-and-post Dobbs time periods.
Conclusions
Racially and economically segregated communities experience greater delays to abortion care both before and after the Dobbs decision.},
 author = {T Riley and A Hassan and A Khattar and L Benson},
 doi = {https://doi.org/10.1016/j.contraception.2025.111058},
 issn = {0010-7824},
 journal = {Contraception},
 pages = {111058},
 title = {O05 - EXAMINING STRUCTURAL RACISM AS A DRIVER OF TIMING OF ABORTION CARE IN WASHINGTON},
 url = {https://www.sciencedirect.com/science/article/pii/S0010782425002495},
 volume = {151},
 year = {2025}
}
