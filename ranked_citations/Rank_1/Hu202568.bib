@conference{Hu202568,
 abstract = {To tackle the challenges of insufficient feature extraction, unclear segmentation of straight contours, and low segmentation accuracy in semantic segmentation of remote sensing buildings using deep learning models, this paper proposes improvements to the Segformer model and designs an algorithm specifically for extracting building information from remote sensing images, named PD-SegFormer. In this approach, the mit_b1 is employed as the encoder, and two Pag feature fusion modules are utilized at the decoder to merge features of different scales extracted by the encoder, selectively learning the most important features from different scales. Then, the DEC module is introduced to enhance the model's learning ability on building boundaries and strengthen its feature extraction capability. Experimental results show that the improved PD-SegFormer achieves Intersection over Union (IoU) and F1 scores of 78.47% and 87.94%, respectively, representing an improvement of 1.38% and 0.87% over the original model. The comprehensive performance of the improved model surpasses that of the original model and outperforms most segmentation algorithms. © 2024 Copyright held by the owner/author(s). Publication rights licensed to ACM.},
 author = {Hu, Lei and Wu, Yuntao and Zhang, Bin and Zhou, Manyue},
 doi = {10.1145/3696474.3696490},
 journal = {Proceedings of the 2024 4th International Joint Conference on Robotics and Artificial Intelligence, JCRAI  2024},
 note = {Cited by: 0},
 pages = {68 - 71},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improved Segformer-based Extraction of Building Information from Remote Sensing Images},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/86000267683?origin=resultslist},
 year = {2025}
}
