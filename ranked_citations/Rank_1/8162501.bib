@article{8162501,
 abstract = {We present a statistical analysis of halo emission for a sample of 1047 edge-on disc galaxies imaged in five bands by the Sloan Digital Sky Survey (SDSS). Stacking the homogeneously rescaled images of the galaxies, we can measure surface brightnesses as deep as μr∼ 31 mag arcsec−2. The results strongly support the almost ubiquitous presence of stellar haloes around disc galaxies, whose spatial distribution is well described by a power law ρ∝r−3, in a moderately flattened spheroid (c/a∼ 0.6). The colour estimates in g–r and r–i, although uncertain, give a clear indication for extremely red stellar populations, hinting at old ages and/or non-negligible metal enrichment. These results support the idea of haloes being assembled via early merging of satellite galaxies.},
 author = {Zibetti, Stefano and White, Simon D. M. and Brinkmann, Jon},
 doi = {10.1111/j.1365-2966.2004.07235.x},
 issn = {1365-2966},
 journal = {Monthly Notices of the Royal Astronomical Society},
 keyword = {galaxies: haloes;galaxies: photometry;galaxies: spiral;galaxies: structure},
 month = {Jan},
 number = {2},
 pages = {556-568},
 title = {Haloes around edge-on disc galaxies in the Sloan Digital Sky Survey},
 volume = {347},
 year = {2004}
}
