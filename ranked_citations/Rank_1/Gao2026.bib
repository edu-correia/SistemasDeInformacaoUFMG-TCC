@article{Gao2026,
 abstract = {Lane-switching sections, commonly formed during freeway reconstruction, are recognized bottlenecks that reduce traffic efficiency and safety. Accurate capacity estimation of these sections is critical for traffic management and infrastructure design. However, existing methods often rely on linear assumptions and fail to capture the nonlinear and interactive effects of roadway geometry and heterogeneous traffic composition. This study develops a data-driven framework that integrates enhanced microsimulation with interpretable machine learning to address these challenges. Unmanned aerial vehicle (UAV) trajectory data are used to embed a geometry–speed coupling mechanism into simulation calibration, improving behavioral realism and reducing delay errors. On this basis, a stacked ensemble model is trained to provide rapid and robust capacity estimation across diverse conditions. Complementing the estimation model, SHAP and GAM analyses uncover critical nonlinear thresholds and interaction effects. The framework demonstrates how simulation enhancement and interpretable machine learning can be fused into a transferable methodology for formalizing geometry, behavior, and capacity relationships in infrastructure systems. © 2026 Elsevier Ltd.},
 author = {Gao, Yacong and Wu, Peijia and Zhou, Chenjing and Rong, Haojiang and Wang, Yi},
 doi = {10.1016/j.aei.2026.104768},
 journal = {Advanced Engineering Informatics},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Interpretable machine learning and enhanced microsimulation for formalizing geometry–behavior interactions in lane-switching capacity},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105038026704?origin=resultslist},
 volume = {74},
 year = {2026}
}
