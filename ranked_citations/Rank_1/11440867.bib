@inproceedings{11440867,
 abstract = {In convolutional neural network design, efficiently utilizing limited parameters through kernel size, depth, and branch configuration remains crucial. While structural reparameterization offers effective model compression, existing methods suffer from fixed branches and static receptive fields. This paper introduces an adaptive training strategy that dynamically adjusts branch structures via improved reparameterization, enabling flexible task-specific adaptation. Experiments on multiple benchmarks demonstrate superior performance over conventional and reparameterized methods under varied industrial constraints, offering a new direction for structural optimization with theoretical and practical value.},
 author = {Li, Wenyue and Lu, Huimin},
 booktitle = {2025 5th International Symposium on Artificial Intelligence and Big Data (AIBDF)},
 doi = {10.1109/AIBDF67964.2025.11440867},
 issn = {},
 keyword = {Training;Deep learning;Convolution;Merging;Stability analysis;Data models;Convolutional neural networks;Kernel;Model compression;Optimization;convolution;structural reparameterization;deep learning;dynamic receptive field},
 month = {Dec},
 number = {},
 pages = {318-321},
 title = {A Structural Reparameterization Training Method for Lagged Activation Parameters},
 volume = {},
 year = {2025}
}
