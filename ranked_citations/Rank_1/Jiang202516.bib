@conference{Jiang202516,
 abstract = {Humans are considered the main reason for the viral spread of misinformation. However, the research on the influencing factors of humans' misinformation sharing behavior is incomplete and inconsistent. Therefore, this paper considers utilizing meta-analysis and analyzing the antecedents of misinformation sharing from the perspectives of human behavior motivation, opportunities in the environment, and personal abilities. Guided by MOA (Motivation-Opportunity-Ability) theory, this meta-analysis synthesizes 43 empirical studies with a total sample of 39,013 participants to quantify the effect size of 13 antecedents (i.e., altruism, entertainment, information overload) on misinformation sharing behaviors. Based on 107 effect size, except for information seeking within motivation factors, all other 12 antecedents have a significant impact on misinformation sharing. Further moderator analysis results confirm that factors identified as moderators (i.e., gender composition, misinformation type) significantly moderate the strength of the relationship between misinformation sharing and antecedents. This paper is the first of its kind for comprehensively considering all the antecedents influencing misinformation sharing in existing literature, then organize and merge them within the framework of MOA theory. © 2024 Copyright held by the owner/author(s). Publication rights licensed to ACM.},
 author = {Jiang, Yuxiao and Li, Zongmin},
 doi = {10.1145/3711954.3711959},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 0},
 pages = {16 - 22},
 publication_stage = {Final},
 source = {Scopus},
 title = {A synthesis of misinformation sharing antecedents on social media},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105013836377?origin=resultslist},
 year = {2025}
