@article{Vandoni2019,
 abstract = {The main objective of this work is to study the applicability of ensemble methods in the context of deep learning with limited amounts of labeled data. We exploit an ensemble of neural networks derived using Monte Carlo dropout, along with an ensemble of SVM classifiers which owes its effectiveness to the hand-crafted features used as inputs and to an active learning procedure. In order to leverage each classifier’s respective strengths, we combine them in an evidential framework, which models specifically their imprecision and uncertainty. The application we consider in order to illustrate the interest of our Multiple Classifier System is pedestrian detection in high-density crowds, which is ideally suited for its difficulty, cost of labeling and intrinsic imprecision of annotation data. We show that the fusion resulting from the effective modeling of uncertainty allows for performance improvement, and at the same time, for a deeper interpretation of the result in terms of commitment of the decision. © 2019 by the authors. Licensee MDPI, Basel, Switzerland.},
 author = {Vandoni, Jennifer and Le Hégarat-Mascle, Sylvie and Aldea, Emanuel},
 doi = {10.3390/s19214664},
 journal = {Sensors (Switzerland)},
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 number = {21},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Augmenting deep learning performance in an evidential multiple classifier system},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85074354465?origin=resultslist},
 volume = {19},
 year = {2019}
}
