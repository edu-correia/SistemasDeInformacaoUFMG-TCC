@article{Al-Qayyam2026,
 abstract = {The emergence of Non-Volatile Memory (NVM) technology has opened new research areas, particularly in enhancing the reliability and efficiency of memory management systems by allowing systems to have a Non-Volatile Main Memory (NVMM). In this work, we address the challenge of ensuring crash consistency in NVMM-based systems by implementing crash-safe sorting algorithms to allow correct recovery after a crash. Two crash-consistent mechanisms, checkpointing and logging, were evaluated to guarantee data consistency and recovery. While checkpointing effectively ensures crash safety, it causes significant overhead and high write amplification. To overcome these limitations, we implemented the merge sort algorithm with a logging-based approach, which achieves crash consistency with significantly lower overhead compared to checkpointing. The logging mechanism (with a logging period of 64 steps) achieves crash safety with a slight execution time overhead of only 1 % compared to the No-Crash Consistency (base) version with no crash safety guarantees, and incurs only 1–16 % write amplification to the NVMM. This work highlights the effectiveness of the logging mechanism in reducing the overhead and write amplification (compared to checkpointing) while ensuring crash consistency in NVMM-based systems. By addressing the challenges of crash safety in memory systems, the proposed logging-based approach offers a practical solution for implementing a reliable and efficient sorting algorithm. © 2025 Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
 author = {Al-Qayyam, Batool and Alshboul, Mohammad and Abdalfattah, Nada and Jararweh, Yaser},
 doi = {10.1016/j.future.2025.108229},
 journal = {Future Generation Computer Systems},
