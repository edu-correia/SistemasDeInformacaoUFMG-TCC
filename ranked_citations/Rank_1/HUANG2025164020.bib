@article{HUANG2025164020,
 abstract = {We unveil the depth-dependent thermodynamic stability and electronic structure of Mg-doped GaN nanowires via first-principles calculations, integrating advanced AIMD simulations and migration barrier analysis. Formation energy calculations reveal that Surface-MgI dominates under Ga-rich conditions due to surface polarization-stabilized −1 charge states, while Sub-Surface-MgN achieves stability via tetrahedral bond relaxation. Strikingly, Core-MgI exhibits an anomalously low formation energy (0.5 eV migration barrier) attributed to lattice compression-enhanced electrostatic interactions (−0.25 eV), validated by AIMD simulations showing minimal thermal energy fluctuations (−285.0 eV at 300 K). Density of states (DOS) analysis confirms that MgN substitution narrows the band-gap to 2.4 eV via mid-gap defect states, whereas interstitial doping preserves a near-intrinsic band-gap (3.0–3.5 eV). Bader charge analysis quantifies site-dependent charge transfer (e.g., +1.78 e for Surface-MgN), linking oxidation states to defect stability. These findings establish a comprehensive framework for doping engineering in III-nitride nanostructures, merging thermodynamic, kinetic, and electronic structure insights.},
 author = {Boyang Huang and Hui Liao and Weihua Chen and Chunyan Song and Ningxuan Yang and Rui Wang and Zihan Huang},
 doi = {https://doi.org/10.1016/j.apsusc.2025.164020},
 issn = {0169-4332},
 journal = {Applied Surface Science},
 keyword = {First principles, GaN Nanowires, Mg-doping, Formation energy, Electronic structure, Charge density},
 pages = {164020},
 title = {Exploration of optoelectronic properties of Mg defects on GaN nanowires based on first principles},
 url = {https://www.sciencedirect.com/science/article/pii/S0169433225017350},
 volume = {711},
 year = {2025}
}
