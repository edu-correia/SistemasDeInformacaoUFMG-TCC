@conference{Xu2022196,
 abstract = {Traditional Chinese Medicine (TCM) knowledge graph is very important for the inheritance and development of TCM. Most TCM knowledge graphs are based on existing data and cannot be improved over time to meet users' needs for continuous updating. In this paper, we propose a dynamically growing knowledge graph construction method. First, we collect data based on user input keywords, and then, in order to obtain structured data, we use BERT-CRF method for named entity recognition and Bootstrapping method for relation extraction. Finally, we merge the structured data into the existing knowledge graph to achieve dynamic construction. The experimental results show that, our method can make TCM knowledge graph grow dynamically with the user's input, which can provide a comprehensive user-friendly searching experience. © 2022 ACM.},
 author = {Xu, Tongyao and Guo, Chen and Du, Lixin and Xu, Jiangying and Zhang, Peng and Feng, Xin and Li, Mingyue},
 doi = {10.1145/3565291.3565323},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 6},
 pages = {196 - 202},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Method for Traditional Chinese Medicine Knowledge Graph Dynamic Construction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85145879942?origin=resultslist},
 year = {2022}
}
