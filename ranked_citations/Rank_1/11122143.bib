@inproceedings{11122143,
 abstract = {The paper is devoted to the representation of a state of the distributed electrical grid systems (SDEGS) based on conflict-free replicated data types (CRDT) for active synchronization of the states of the distributed electrical grid to maintain its structural and functional consistency. The general structure of the SDEGS based on CRDT is overviewed and explained. The actual scheme for the SDEGS based on CRDT is reviewed. Underling process of CRDT message distribution between electrical grid nodes is shown. A special set of experiments to investigate message distribution flow based on electrical grid states, distributed system behaviour and conditional properties of CRDT were developed. Characteristics of the system such as latency and message distribution density are illustrated. A separate framework for the modelling of distributed networks like electrical grids was developed and used in the scope of this work to conduct experiments.},
 author = {Prymushko, Arsentii and Yaroshynskyi, Mykola and Puchko, Ivan},
 booktitle = {2024 14th International Conference on Dependable Systems, Services and Technologies (DESSERT)},
 doi = {10.1109/DESSERT65323.2024.11122143},
 issn = {},
 keyword = {Distributed databases;Synchronization;conflict free replicated data type;state;distributed electrical grid system;consensus},
 month = {Oct},
 number = {},
 pages = {1-5},
 title = {Representation and synchronization of states of distributed electrical grid systems based on conflict free replicated data types},
 volume = {},
 year = {2024}
}
