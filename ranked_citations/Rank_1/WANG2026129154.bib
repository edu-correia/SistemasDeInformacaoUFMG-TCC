@article{WANG2026129154,
 abstract = {Extensive research has been conducted on enhancing boiling heat transfer through surface technology of porous coatings or thermal property improvement of nanofluids. This paper selects movable free particles with appropriate size to enhance heat transfer from the heating surface and fluid space simultaneously. The particles are stationary on the heating surface to form a porous particle layer, which is conducive to nucleate boiling. And the particles can move on the heating surface, further promoting the merging and detachment of bubbles. In addition, overheated particles entering the fluid also enhance convective heat transfer. The VOF-DEM coupling method is used to study the boiling heat transfer characteristics with movable free particles, and the influence of free particles on boiling heat transfer performance by setting three parameters including particle size, particle volume fraction, and heating surface size. There are two ways to supply free particles to the heating surface, including those falling from the fluid and those rolling from the bottom surface on both sides. The thickness of the particle accumulation layer and the number of particles entering the fluid are the main factors affecting boiling heat transfer. Particles of 30 μm enhances convective heat transfer. The single-pile particle aggregates are easily formed in particles of 70 μm and 90 μm, which can cause wall overheating. Due to formed multi-pile structure of particle aggregates and easily carried into the fluid, particles of 50 μm exhibit the highest heat transfer coefficient (HTC) under different heat fluxes and volume fractions, and a maximum increase of HTC is 15.02 % compared to the polished surface. The potential application is to combine with other surface enhancing techniques to automatically regulate the pore size of porous structure.},
 author = {Dongdong Wang and Ling Chen and Xiaoya Zhu and Shilei Ding and Qi Lin and Huaqiang Chu},
 doi = {https://doi.org/10.1016/j.applthermaleng.2025.129154},
 issn = {1359-4311},
 journal = {Applied Thermal Engineering},
 keyword = {Free particles, Boiling heat transfer, Particle aggregates, Multi-pile structure},
 pages = {129154},
 title = {Numerical simulation study on the influence parameters of movable free particles on boiling heat transfer},
 url = {https://www.sciencedirect.com/science/article/pii/S1359431125037469},
 volume = {284},
 year = {2026}
}
