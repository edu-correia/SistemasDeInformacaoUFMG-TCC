 issn = {},
 keyword = {Spread spectrum communication;Frequency modulation;Frequency control;Frequency estimation;Algorithm design and analysis;Demodulation;Testing;differential frequency hopping;G function;inverse G function;Read-solomon code},
 month = {Nov},
 number = {},
 pages = {205-208},
 title = {Research on Four Bit G Function Algorithm Base on DFH System},
 volume = {},
 year = {2010}
