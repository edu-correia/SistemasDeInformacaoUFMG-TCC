@inproceedings{5693715,
 abstract = {Differential Frequency Hopping(DFH) is a new frequency-hopping spread spectrum system, DFH is the core technology of CHESS radio, now mainly used in short-wave communications, which mainly come down to a G function algorithm, this set of G functions merge information modulation and Frequency hopping patterns together. Based on the traditional of G function, this article Proposed an improved method of 4 bit G Functions, the introduction of a strong error correction capability RS code control a subset of frequency hopping, and its been tested. The results show that the algorithm generated frequency hopping patterns with good randomness and uniformity.},
 author = {Tao, Sui and Wei, Zhu},
 booktitle = {2010 Third International Conference on Intelligent Networks and Intelligent Systems},
