@article{SHIRVANI2024113736,
 abstract = {High-conductivity metal selenides could be potential choices as supercapacitor electrode materials. In this research, we present the NiSe/CoFe-LDH rose-like arrays, crafted using straightforward hydrothermal and electrodeposition techniques. To create these arrays, two-dimensional CoFe-LDH nanosheets are layered on top of NiSe structures that resemble roses. Coupling the CoFe-LDH with the NiSe results in heterostructures that significantly increase supercapacitive behavior. In addition, the external CoFe-LDH nanosheets effectively prevent the degradation of the NiSe rose-like structure during extended cyclability investigations. Initially, we applied a hydrothermal process to create rose-like NiSe arrays on nickel foam. This process was followed by the electrodeposited CoFe-LDH on the rose-like NiSe arrays, which yields the NiSe/CoFe-LDH@NiF nanostructures. The fabricated nanostructures offer effective electron-ion transport pathways and retain structural integrity during periods of charge-discharge cycling, which led to excellent super capacitive properties with a specific capacity of 292.03 mAh/g at 1 A/g and outstanding cyclability (90.14 % after 10,000 cycles). Additionally, we constructed a hybrid supercapacitor device (NiSe/CoFe-LDH@NiF//AC@NiF) that uses NiSe/CoFe-LDH@NiF as the positive electrode and NiF covered with active carbon (AC) as the negative electrode. The energy density of the NiSe/CoFe-LDH@NiF//AC@NiF device exhibited an efficient energy density of 60.63 Wh/kg and a durability of 82.76 % after 10,000 cycles. This research offers a new approach to developing nanostructure electrode material for use in hybrid supercapacitors.},
 author = {Majid Shirvani and Saied Saeed Hosseiny Davarani},
 doi = {https://doi.org/10.1016/j.est.2024.113736},
 issn = {2352-152X},
 journal = {Journal of Energy Storage},
 keyword = {NiSe/CoFe-LDH nanosheets, Positive electrode material, Hybrid supercapacitors, Energy storage},
 pages = {113736},
 title = {Designing a heterojunction merging of CoFe-layered double hydroxide on NiSe rose-like structures: A promising pathway toward better energy storage},
 url = {https://www.sciencedirect.com/science/article/pii/S2352152X2403322X},
 volume = {101},
 year = {2024}
}
