@article{10.1145/1344418.1344431,
 abstract = {We propose a new algebraic four-level expression called k-EXOR-projected sum of products (kEP-SOP). The optimization of a kEP-SOP is NPNP-hard, but can be approximated within a fixed performance guarantee in polynomial time. Moreover, fully testable circuits under the stuck-at-fault model can be derived from kEP-SOPs by adding at most a constant number of multiplexer gates. The experiments show that the computational time is very short and the results are most of the time optimal with respect to the number of products involved. kEP-SOPs also prove experimentally a good starting point for general multilevel logic synthesis.},
 address = {New York, NY, USA},
 articleno = {35},
 author = {Bernasconi, Anna and Ciriani, Valentina and Cordone, Roberto},
 doi = {10.1145/1344418.1344431},
 issn = {1084-4309},
 issue_date = {April 2008},
 journal = {ACM Trans. Des. Autom. Electron. Syst.},
 keyword = {Automatic synthesis, approximation algorithm, multilevel logic synthesis, optimization, testing},
 month = {April},
 number = {2},
 numpages = {31},
 publisher = {Association for Computing Machinery},
 title = {The optimization of kEP-SOPs: Computational complexity, approximability and experiments},
 url = {https://doi.org/10.1145/1344418.1344431},
 volume = {13},
 year = {2008}
}
