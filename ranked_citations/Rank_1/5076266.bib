@inproceedings{5076266,
 abstract = {Firewalls are one of the most widely used mechanisms against security threats in distributed andnetwork systems.However, principled methodologies for firewall extraction policies have been scarcely investigated so far.We introduce a new model for translating low level firewall rules into higher abstraction level rules which allow for the inference of firewall policies. In order to do so, we introduced a new methodology based on rules' decorrelation algorithms that compute hierarchical firewall policies from lower level firewall rules. Further, we define a new effective model for the explicit extraction of blacklisted and whitelisted hosts and networks.},
 author = {Horowitz, Eduardo and Lamb, Luis C.},
 booktitle = {2009 International Conference on Advanced Information Networking and Applications},
 doi = {10.1109/AINA.2009.116},
 issn = {2332-5658},
 keyword = {Decorrelation;Informatics;Data mining;Inference algorithms;Access control;Operating systems;Erbium;Wool;Frequency;Security;Firewalls;Firewall Extraction Policies;Foundations of Computer Security},
 month = {May},
 number = {},
 pages = {691-698},
 title = {A Hierarchical Model for Firewall Policy Extraction},
 volume = {},
 year = {2009}
}
