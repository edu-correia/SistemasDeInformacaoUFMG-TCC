@conference{Dang2022403,
 abstract = {Solid-state drives (SSDs) are gaining popularity. Meanwhile, key-value stores built on log-structured merge-tree (LSM-tree) are widely deployed for data management. LSM-tree frequently calls syncs to persist newly-generated files for crash consistency. The blocking syncs are costly for performance. We revisit the necessity of syncs for LSM-tree. We find that Ext4 journaling embraces asynchronous commits to implicitly persist files. Hence, we design NobLSM that makes LSM-tree and Ext4 cooperate to substitute most syncs with non-blocking asynchronous commits, without losing consistency. Experiments show that NobLSM significantly outperforms state-of-the-art LSM-trees with higher throughput on an ordinary SSD. © 2022 Owner/Author.},
 author = {Dang, Haoran and Ye, Chongnan and Hu, Yanpeng and Wang, Chundong},
 doi = {10.1145/3489517.3530470},
 journal = {Proceedings - Design Automation Conference},
 note = {Cited by: 4; All Open Access; Hybrid Gold Open Access},
 pages = {403 - 408},
 publication_stage = {Final},
 source = {Scopus},
 title = {NobLSM: An LSM-tree with Non-blocking Writes for SSDs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85137461211?origin=resultslist},
 year = {2022}
}
