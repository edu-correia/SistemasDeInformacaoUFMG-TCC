@conference{Zhang2025386,
 abstract = {This paper presents a technically integrated framework for cooperative lane-switching control of connected autonomous vehicles (CAVs) in mixed traffic environments. This study aims at the urgent need for safe and efficient coordination between CAVs and human-driven vehicles, especially during lanechanging maneuvers in heterogeneous traffic. By enhancing multi-agent learning and real-time vehicle-to-everything (V2X) communication, the method enables each CAV to perceive its surrounding environment, predict the intentions of neighboring vehicles, and collaboratively discuss safe lane-changing operations. The distributed optimization algorithm translates the complex team decision into accurate longitudinal and lateral control commands, while considering real-time traffic conditions and dynamic constraints. The effectiveness of the framework is evaluated thru comprehensive simulations on an urban expressway model with various traffic flows and different CAV penetration rates. The results show that the proposed method can improve traffic throughput by 18%, reduce lane-changing conflict rate by more than 50%, and reduce overall fleet energy consumption by 20% compared with the baseline strategy. In addition, the framework has excellent traffic flow stability and anti-interference ability. These findings lay a solid foundation for the application of intelligent cooperative control strategies in mixed traffic scenarios. These strategies will greatly improve traffic safety, efficiency and energy sustainability. © 2025 IEEE.},
 author = {Zhang, Huisheng and Hu, Chenqi},
 doi = {10.1109/CCNIS69465.2025.00074},
 journal = {Proceedings - 2nd International Conference on Computer Communication, Networks and Information Science, CCNIS 2025},
 note = {Cited by: 0},
 pages = {386 - 390},
