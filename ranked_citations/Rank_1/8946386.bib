@inproceedings{8946386,
 abstract = {In this paper, we introduce a novel approach of forming interlingual relations between multilingual wordnets. We have mapped Turkish senses in KeNet with their corresponding senses in Princeton WordNet by drawing one-to-many correspondences. As a result of language-specific properties, one synset in one language is matched with multiple synsets in the other language in some cases. Our method of integrating KeNet into a multilingual network also included mapping the most frequent 5000 senses in English with their equivalent senses in Turkish. What we demonstrate is that one-to-many interlingual correspondances are necessary to include in mappings both from Turkish-to-English and English-to-Turkish. Furthermore, one-to- many mappings give us insights into the semantic relations to be constructed in Turkish, such as hypernymy.},
 author = {Bakay, Özge and Ergelen, Özlem and Yıldız, Olcay Taner},
 booktitle = {2019 Innovations in Intelligent Systems and Applications Conference (ASYU)},
 doi = {10.1109/ASYU48272.2019.8946386},
 issn = {},
 keyword = {Semantics;Merging;Dictionaries;Organizations;Natural language processing;Liquids;Syntactics;Wordnet;KeNet;Interlingual relations},
 month = {Oct},
 number = {},
 pages = {1-5},
 title = {Integrating Turkish Wordnet KeNet to Princeton WordNet: The Case of One-to-Many Correspondences},
 volume = {},
 year = {2019}
}
