@inbook{9865062,
 abstract = {This chapter exploits the unique structure of the optimal load control (OLC) problem considering the frequency dynamics of power systems, revealing the intrinsic connection behind the optimization algorithm to solve the dual problem of OLC and the closed&#x2010;loop frequency control system with branch power flows. This finding leads to a systematic methodology to design ubiquitous continuous fast&#x2010;acting distributed load control for primary frequency regulation in power networks by formulating the OLC problem to minimize the aggregate control cost subject to power balance across the network. It proves that swing dynamics and the branch power flows, coupled with frequency&#x2010;based load control, serve as a distributed primal&#x2013;dual algorithm to solve the OLC problem, bridging these two branches considered separately in tradition. This methodology, involving both &#x201c;forward engineering&#x201d; and &#x201c;reverse engineering&#x201d; perspectives, virtually enables a framework for the design and convergence analysis of distributed optimal control in power systems.},
 author = {Wang, Zhaojian and Zhao, Changhong and Liu, Feng and Yang, Peng},
 booktitle = {Merging Optimization and Control in Power Systems: Physical and Cyber Restrictions in Distributed Frequency Control and Beyond},
 doi = {10.1002/9781119827962.ch3},
 isbn = {9781119827931},
 issn = {},
 keyword = {Frequency control;Generators;Load modeling;Frequency measurement;Load flow control;IEEE Sections;Heuristic algorithms},
