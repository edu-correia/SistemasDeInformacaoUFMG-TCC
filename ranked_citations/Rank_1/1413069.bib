@inproceedings{1413069,
 abstract = {We proposed triple-mode MAP/VA timing charts that can run two different algorithms at the same time by complementing each other. Then, we address the implementation of a reconfigurable architecture for unified convolutional/turbo decoder design. According to the triple-mode MAP/VA timing chart and by merging some similar modules in both the Viterbi decoder and the log-MAP turbo code decoder, we build one unified component decoder with both of these two functions. Besides, in order to conform to the advance communication standard, our decoder can also perform as a reconfigurable trellis decoder. That is, our design meets the requirement of the multi generator polynomial in the convolutional code specification.},
 author = {Fan-Min Li and Pei-Ling Shen and An-Yeu Wu},
 booktitle = {The 2004 IEEE Asia-Pacific Conference on Circuits and Systems, 2004. Proceedings.},
 doi = {10.1109/APCCAS.2004.1413069},
 issn = {},
 keyword = {Kernel;Maximum likelihood decoding;Convolutional codes;Turbo codes;Timing;Viterbi algorithm;Iterative decoding;Convolution;Communication standards;Forward error correction},
 month = {Dec},
 number = {},
 pages = {1073-1076 vol.2},
 title = {Unified convolutional/turbo decoder architecture design based on triple-mode MAP/VA kernel},
 volume = {2},
 year = {2004}
}
