@inproceedings{7800271,
 abstract = {The development of Internet makes plagiarism problem more and more serious. Plagiarism can be in different types, ranging from copying texts to adopting ideas, without giving credit to the original author. Most research in plagiarism checking concentrate on string matching. This method cannot deal with intelligent plagiarism in which the same content can be expressed by different ways. To deal with this problem, this paper proposes an approach to semantic text alignment based on sentence-level topic modeling. Experiments with PAN corpora gave us much higher recalls and approximate plagdets compared to the winning system in PAN2014. It shows that topic modeling is a potential solution for detecting intelligent plagiarism.},
 author = {Le, Huong T. and Pham, Lam N. and Nguyen, Duy D. and Nguyen, Son V. and Nguyen, An N.},
 booktitle = {2016 IEEE RIVF International Conference on Computing & Communication Technologies, Research, Innovation, and Vision for the Future (RIVF)},
 doi = {10.1109/RIVF.2016.7800271},
 issn = {},
 keyword = {Itemsets;Plagiarism;Clustering algorithms;Indexes;Semantics;Merging;Computational modeling;text alignment;topic modeling;Latent-Dirichlet Allocation;Apriori},
 month = {Nov},
 number = {},
 pages = {67-72},
 title = {Semantic text alignment based on topic modeling},
 volume = {},
 year = {2016}
}
