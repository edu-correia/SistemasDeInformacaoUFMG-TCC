@article{10.1145/3748820,
 abstract = {Digital twin (DT) technology accepts real-time data integration to build dynamic digital clones that support analysis alongside simulation and data-driven decision-making. The current bibliometric study investigates DT research development because of its escalating societal applications and its value for sustainable urban development. It centers on four essential elements: Architecture, Application, Middleware, and Tools. The analysis includes 2,260 papers retrieved from the Scopus database within the period 2015 to 2025 according to strict selection standards and performs visualizations with both VOSviewer and CiteSpace software. The research examines the development of DT through keyword co-occurrence network (KCN), country contributions, document co-citation network (DCN), and burst reference analysis. The research demonstrates significant research fields and shows different DT applications in multiple sectors while illustrating how DT affects sustainable cities. The current study establishes foundations for upcoming smart and resilient urban system advancement through intellectual mapping of DT and research gap identification.},
 address = {New York, NY, USA},
 articleno = {32},
 author = {Bhatia, Munish and Kumar, Vijay},
 doi = {10.1145/3748820},
 issue_date = {December 2025},
 journal = {ACM J. Comput. Sustain. Soc.},
 keyword = {Internet of things, digital twin, scientometrics, citespace, vosviewer},
 month = {November},
 number = {4},
 numpages = {33},
 publisher = {Association for Computing Machinery},
 title = {Bibliometric Study of Digital Twin for Sustainable Cities and Society},
 url = {https://doi.org/10.1145/3748820},
 volume = {3},
 year = {2025}
}
