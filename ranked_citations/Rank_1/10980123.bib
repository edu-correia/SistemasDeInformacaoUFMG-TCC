@article{10980123,
 abstract = {Polarization singularities have garnered significant attention due to their special properties and can be modulated by reducing the symmetry of the structure. At present, the regulation of polarization singularity is usually passive, and the polarization characteristics fixed once the device is fabricated. Herein, we investigate the active regulation of polarization singularity based on phase change material (PCM) Sb2Se3 tetramer nanodisk metasurface supported by bound states in the continuum (BICs). When the crystallinity of partial Sb2Se3 nanodisks is changed, the BIC transitions into a quasi-BIC (QBIC), corresponding to the splitting of the integer topological charge into two half-topological charges, which produces a pair of C points that can be mapped onto the Poincaré sphere. It is observed that the C point can be dynamically manipulated to transition from the diagonal to y-axis, then back to the diagonal, and finally merged into linearly polarized vortex with a topological charge of +1, maintaining charge conservation throughout the process. Furthermore, when one or two crystalline nanodisks are transitioned to an amorphous state, C point can be regulated on the diagonal and axis. Our finding proposes a novel approach for the dynamic generation and manipulation of various polarization singularities in momentum space, offering a promising strategy for engineering optical singularities.},
 author = {He, Haoxuan and Wang, Lulu and Duan, Hong and Yan, Xia and Zhang, Ying and Luo, Shengyun and Yi, Yingfei and Zhou, Chaobiao},
 doi = {10.1109/LPT.2025.3565577},
 issn = {1941-0174},
 journal = {IEEE Photonics Technology Letters},
 keyword = {Polarization;Metasurfaces;Crystallization;Optical vortices;Refractive index;Q-factor;Phase change materials;Optical device fabrication;Nonlinear optics;Polarization singular;phase change material;metasurfaces;bound states in the continuum},
 month = {July},
 number = {14},
 pages = {805-808},
 title = {Topological Polarization Singularity Modulation in the Phase Change Material Metasurfaces},
 volume = {37},
 year = {2025}
}
