@article{He2026,
 abstract = {Tuberculosis (TB) remains a significant global health challenge, with conventional diagnostic methods often limited by low sensitivity and high costs. To address this, we propose ResViTM-Net, a novel hybrid deep learning model for TB detection. The model architecture uniquely integrates three components for multi-level feature fusion: a Res module for robust local feature extraction, a ViT module for global contextual understanding, and a Meta module for leveraging clinical priors (patient age and gender). Experiments conducted on a composite dataset of 4199 chest X-ray (CXR) images from three public sources demonstrate that ResViTM-Net achieves an overall accuracy of 96.19% and an exceptionally high specificity of 98.12%. Ablation studies confirm the synergistic design, with the removal of the Res module causing the most significant performance drop of 5.24 percentage points. Furthermore, t-SNE visualization reveals a feature space with high class separability, demonstrating that the integration of clinical priors facilitates the formation of a more cohesive and continuous manifold compared to unimodal variants. This suggests that our multi-modal approach enables the model to learn a more nuanced and clinically relevant decision space. The code is available at https://github.com/Vanilla-Yukirin/ResViTM-Net. © 2026 Elsevier Ltd},
 author = {He, Shaohong and Liao, Siqi and Wu, Yuyan and Wu, Heng and Zheng, Zijun and Wang, Jiabao and Wang, Wangsong and Gao, Mengqi},
 doi = {10.1016/j.bspc.2026.110217},
 journal = {Biomedical Signal Processing and Control},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {ResViTM-Net: Where local features meet global context, guided by patient priors for medical vision},
 type = {Article},
