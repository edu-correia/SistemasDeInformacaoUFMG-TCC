@article{Chidananda2025,
 abstract = {Detecting the behavior of the crowd that is regarded as anomalous is the need for surveillance.Hence, several machine learning (ML) systems were built for the automatic detection of an anomaly in the crowd video. Still, certain limitations like neglecting the different features of several classes of anomalies and elevating training time for predicting the anomalies are present in such systems. Hence, for solving these issues, this paper proposes Parametric Rectified linear Unit- Deep Predictive Coding Network (PRU-DPCN)-centric Anomaly Detection (AD) in crowded scenes. At first, the input video is converted to frames, and next, preprocessed with Homomorphic Filter (HF) and Gaussian Binomial coefficient-centric Region Split and Merge (GB-RSM) algorithm. Subsequently, for the detection of motion betwixt frames, the video is magnified with the Ordinary Least Square Regression centric Eulerian Video Magnification (OLSR-EVM) approach, and with the motion-estimated frames, the anomalous and non-anomalous frames are clustered with Similarity Score based K-Means (SS-Kmeans) algorithm. Next, for the detection of types of an anomaly in the surveillance, the anomalous frame, object detected frame, and extracted features are fed to PRU-DPCN. Subsequently, for proving the performance, the proposed system is examined with baseline and existing techniques in which superior outcomes on accuracy, time, recall, and F-measure (FM) were attained by the proposed system. © The Author(s), under exclusive licence to Springer Nature Singapore Pte Ltd. 2024.},
 author = {Chidananda, K. and Kumar, A. P. Siva},
 doi = {10.1007/s42979-024-03443-7},
 journal = {SN Computer Science},
 note = {Cited by: 4},
 number = {1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Efficient Real Time Anomaly Detection in Surveillance Videos Using PRU-DPCN Classifier},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85212921977?origin=resultslist},
 volume = {6},
 year = {2025}
}
