@inproceedings{11484677,
 abstract = {Medical image analysis is one of the many computer vision applications where segmentation is a crucial task. Medical image segmentation techniques based on advanced Convolutional Neural Network (CNN) architectures has become more complex over the last few years. Following this advancement, performance on well-known benchmark datasets has gradually improved. Nevertheless, the majority of current methods are computationally intensive, which restricts their application. It is challenging for the current deep learning techniques to extract the discriminatory features of the lesion patches due to their irregular sizes and shapes. Furthermore, redundant information and semantic gaps arise from the ineffective merging of spatial and semantic information during decoding. The class imbalance problem is successfully addressed in this research by developing a sophisticated deep learning model for medical image segmentation. Initially, the needed images are collected from the public online databases, and it is subjected to the Generative Adversarial Network (GAN) model for synthetically generating the medical images, which tackles the challenge of class imbalance during segmentation. The augmented images are applied to the fine segmentation mechanism, which is performed with the support of the developed Trans-variational-Unet++ model. The proposed model is highly effective in segmenting small lesion regions with higher accuracy. The effectiveness of the suggested segmentation mechanism is verified with diverse imaging modalities to ensure its performance.},
 author = {Muddamsetti, Sateesh and Arulselvam, A.},
 booktitle = {2025 IEEE International Conference on Communication Networks and Computing (CNC)},
 doi = {10.1109/CNC68716.2025.11484677},
 issn = {},
 keyword = {MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits;LoRa;Communication networks;Protocols;Communication systems;HTTP;Data communication;Radio communication;Medical Image Segmentation;Generative Adversarial Network;Synthetic Data Generation;Trans-variational Unet++ model},
 month = {Dec},
 number = {},
 pages = {1370-1379},
 title = {Synthetic Data Generation-based Efficient Medical Image Segmentation Framework using Trans-variational-Unet++ for Handling Class Imbalance Issues},
 volume = {},
