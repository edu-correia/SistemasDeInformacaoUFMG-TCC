@incollection{HUSON2024,
 abstract = {The study of canine genetics has progressed from estimates of heritability to the use of modern genomic tools to explore theories of domestication and adaptation and characterize genome structure and regulation. With improved sequencing and assembly of ancient DNA, new insights are correlating dog domestication with human migration. Similarly, there is a better understanding of population structure and gene regulation as whole-genome sequence data is examined routinely and multiple high-resolution canine genome assemblies are available for comparison. This is bringing to light the role of less studied genetic variants such as microRNAs and retroviruses in both evolutionary selection and trait regulation. Research continues to expand our knowledge of the genetic regulation of traits, more commonly tackling complex traits including those influencing canine disease and behavior as a means to improve canine and human health. In all, technological advances in genomics are outpacing our computational abilities and the merging of high-throughput genotyping and phenotyping with improved computational tools is an integral part of genomic research moving into the future.},
 author = {Heather Jay Huson and Joseph Agmund Thorsrud},
 booktitle = {Reference Module in Life Sciences},
 doi = {https://doi.org/10.1016/B978-0-12-822563-9.00191-8},
 isbn = {978-0-12-809633-8},
 keyword = {Domestication, Breed, Genetic selection, Genetic health},
 publisher = {Elsevier},
 title = {Canine Genomics and Genetics},
 url = {https://www.sciencedirect.com/science/article/pii/B9780128225639001918},
 year = {2024}
}
