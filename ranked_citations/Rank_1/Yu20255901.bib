@article{Yu20255901,
 abstract = {The Cauchy-Schwarz (CS) divergence was developed by Príncipe et al. in 2000. In this paper, we extend the classic CS divergence to quantify the closeness between two conditional distributions and show that the developed conditional CS divergence can be elegantly estimated by a kernel density estimator from given samples. We illustrate the advantages (e.g., rigorous faithfulness guarantee, lower computational complexity, higher statistical power, and much more flexibility in a wide range of applications) of our conditional CS divergence over previous proposals, such as the conditional Kullback-Leibler divergence and the conditional maximum mean discrepancy. We also demonstrate the compelling performance of conditional CS divergence in two machine learning tasks related to time series data and sequential inference, namely time series clustering and uncertainty-guided exploration for sequential decision making. © 1979-2012 IEEE.},
 author = {Yu, Shujian and Li, Hongming and Lokse, Sigurd and Jenssen, Robert and Principe, Jose C.},
 doi = {10.1109/TPAMI.2025.3552434},
 journal = {IEEE Transactions on Pattern Analysis and Machine Intelligence},
 note = {Cited by: 5; All Open Access; Green Open Access},
 number = {7},
 pages = {5901 - 5917},
 publication_stage = {Final},
 source = {Scopus},
 title = {The Conditional Cauchy-Schwarz Divergence With Applications to Time-Series Data and Sequential Decision Making},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105000795314?origin=resultslist},
 volume = {47},
 year = {2025}
}
