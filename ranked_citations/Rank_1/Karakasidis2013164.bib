@article{Karakasidis2013164,
 abstract = {Nowadays, there is an abundance of data produced by human activities. Integrating these data for processing, raises privacy issues. Privacy Preserving Record Linkage is an area of research, developed in the last few years, aiming at integrating personal data without compromising the privacy of the people these data refer to. To solve this problem, many methods have been recently developed. To be able to assess the performance and the overall behaviour of these methods, we have built a Privacy Preserving Record Linkage Simulator which we present in this paper. © Springer-Verlag Berlin Heidelberg 2013.},
 author = {Karakasidis, Alexandros and Verykios, Vassilios S.},
 doi = {10.1007/978-3-642-41016-1_18},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 1},
 pages = {164 - 173},
 publication_stage = {Final},
 source = {Scopus},
 title = {A simulator for privacy preserving record linkage},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84885152474?origin=resultslist},
 volume = {384},
 year = {2013}
}
