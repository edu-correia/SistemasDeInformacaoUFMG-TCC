@conference{Chifu2016,
 abstract = {With the advances in multimedia broadcasting through a rich variety of channels and with the vulgarization of video production, it becomes essential to be able to provide reliable means of retrieving information within videos, not only the videos themselves. Research in this area has been widely focused on the context of TV news broadcasts, for which the structure itself provides clues for story segmentation. The systematic employment of these clues would lead to thematically driven systems that would not be easily adaptable in the case of videos of other types. The systems are therefore dependent on the type of videos for which they have been designed. In this paper we aim at introducing SegChain, a generic unsupervised framework for story segmentation, based on lexical chains from transcriptions. SegChain takes into account the topic changes by perceiving the uctuations of the most frequent terms throughout the video. © 2016 held by the owner/author(s).},
 author = {Chifu, Adrian-Gabriel and Fournier, Sébastien},
 doi = {10.1145/2912845.2912872},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {SegChain: Towards a generic automatic video segmentation framework, based on lexical chains of audio transcriptions},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84978525338?origin=resultslist},
 volume = {13-15-June-2016},
 year = {2016}
}
