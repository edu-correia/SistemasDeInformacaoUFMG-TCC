@article{LI202646,
 abstract = {This study introduces an eco-friendly combined pretreatment approach that merges photocatalysis and Fenton reactions to convert walnut shells into high-performance biochar. Unlike traditional chemical activation methods that rely on harsh reagents, this technique uses mild oxidative conditions to effectively break down the lignocellulosic structure. Subsequent pyrolysis in a strictly inert atmosphere converted the treated biomass into biochar. The resulting biochar (PFWSB) showed significantly enhanced porosity, with a specific surface area of 712.35 m²/g and a total pore volume of 0.31 cm³ /g, representing 11.7-fold and 10.3-fold increases over untreated biochar, respectively. Characterization analyses confirmed the formation of a hierarchical pore network and a substantial enrichment of oxygen-containing functional groups. These superior properties led to an excellent methylene blue adsorption capacity of 85.20 mg/g, and the experimental data were well described by the Langmuir isotherm and pseudo-second-order kinetic models. This work underscores the significant potential of a sustainable pretreatment approach for converting agricultural waste into effective adsorbents, achieving a balance between high performance and environmental friendliness.},
 author = {Lin Li and Zhuwei Liu and Danni Zuo and Tingsan Song and Xianglei Song and Xiang Zhong and Qing Dong},
 doi = {https://doi.org/10.1016/j.cherd.2026.02.054},
 issn = {0263-8762},
 journal = {Chemical Engineering Research and Design},
 keyword = {Synergistic pretreatment, Photocatalysis-Fenton, Biochar, Methylene blue adsorption},
 pages = {46-56},
 title = {Synergistic photocatalysis-Fenton pretreatment enhances porosity and surface functionality of biochar from walnut shells for efficient methylene blue adsorption},
 url = {https://www.sciencedirect.com/science/article/pii/S0263876226001322},
 volume = {228},
 year = {2026}
}
