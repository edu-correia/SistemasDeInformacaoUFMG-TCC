@article{HOLAGH2026123229,
 abstract = {We present an integrated experimental and semi-empirical analytical investigation into the spatial evolution of gravity-driven developing slug flows and the attendant mass transfer dynamics within a vertical gas-lift riser with an internal diameter of 25.4 mm. An integrated framework, merging high-speed flow visualization, time-resolved void fraction measurements at multiple axial stations along with advanced signal processing techniques, is developed to systematically characterize the complex interplay between spatial flow development and interfacial mass transfer. The experimental campaign employed air–CO2 mixtures across a broad range of inlet superficial gas velocities, with deionized water as the liquid phase, maintained under a controlled hydrostatic pressure. Flow visualization revealed a progressive transformation from semi-annular or churn-like structures at the riser entrance to unstable slug flow downstream, resulting in a near-stable slug regime at lower superficial gas velocities. These observations were quantitatively validated and demonstrated through void fraction signal analysis. A semi-empirical analytical model was developed to predict the spatial distribution of void fraction, superficial liquid velocity, pressure drop, and volumetric mass transfer coefficient (MTC), featuring a novel space-variant void fraction correlation explicitly accounting for axial gas expansion. The model showed high predictive accuracy, achieving root-mean-square (RMS) errors below ± 4 % for void fraction and superficial liquid velocity, and under ± 10 % for pressure drop and volumetric MTC. Moreover, it successfully captured the characteristic exponential decay of MTC toward fully developed flow conditions.},
 author = {Shahriyar G. Holagh and Wael H. Ahmed},
 doi = {https://doi.org/10.1016/j.ces.2025.123229},
 issn = {0009-2509},
 journal = {Chemical Engineering Science},
 keyword = {Developing slug flow, Spatiotemporal-spectral analysis, Mass transfer coefficient, Semi-empirical analytical modeling},
 pages = {123229},
 title = {Hydrodynamics and mass transfer in developing gravity-driven slug flows: experimental characterization and semi-empirical analytical modeling},
 url = {https://www.sciencedirect.com/science/article/pii/S0009250925020500},
 volume = {323},
 year = {2026}
}
