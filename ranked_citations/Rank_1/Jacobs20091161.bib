@conference{Jacobs20091161,
 abstract = {We consider the special case of tracking objects in highly structured scenes. In the context of vehicle tracking in urban environments, we offer a fully automatic, end-to-end system that discovers and parametrizes the lanes along which vehicles drive, then uses just these pixels to simultaneously track dozens of objects. This system includes a novel active contour energy function used to parametrize the lanes of travel based only on the accumulation of spatio-temporal image derivatives, and a tracking algorithm that exploits longer temporal constraints made possible by our compact data representation; we believe both of these may be of independent interest. We offer quantitative results comparing tracking results to ground-truthed data, including thousands of vehicles from the NGSIM Peachtree data set. ©2009 IEEE.},
 author = {Jacobs, Nathan and Dixon, Michael and Satkin, Scott and Pless, Robert},
 doi = {10.1109/ICCVW.2009.5457477},
 journal = {2009 IEEE 12th International Conference on Computer Vision Workshops, ICCV Workshops 2009},
 note = {Cited by: 5; All Open Access; Green Open Access},
 pages = {1161 - 1168},
 publication_stage = {Final},
 source = {Scopus},
 title = {Efficient tracking of many objects in structured environments},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77953176601?origin=resultslist},
 year = {2009}
}
