@article{Caron2017,
 abstract = {This article introduces a class of first-order stationary time-varying Pitman-Yor processes. Subsuming our construction of time-varying Dirichlet processes presented in (Caron et al., 2007), these models can be used for time-dynamic density estimation and clustering. Our intuitive and simple construction relies on a generalized Polya urn scheme. Significantly, this construction yields marginal distributions at each time point that can be explicitly characterized and easily controlled. Inference is performed using Markov chain Monte Carlo and sequential Monte Carlo methods. We demonstrate our models and algorithms on epidemiological and video tracking data. © 2017 François Caron, Willie Neiswanger, Frank Wood, Arnaud Doucet and Manuel Davy.},
 author = {Caron, François and Neiswanger, Willie and Wood, Frank and Do, Arnaud Doucet and Davy, Manuel},
 journal = {Journal of Machine Learning Research},
 note = {Cited by: 21},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Generalized pólya urn for time-varying pitman-yor processes},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85020858046?origin=resultslist},
 volume = {18},
 year = {2017}
}
