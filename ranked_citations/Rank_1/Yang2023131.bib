@conference{Yang2023131,
 abstract = {This paper analyzes the inadequacy of the reverse interpretation of semantics from the language text in previous studies, and then puts forward a new analytical formula of logical meaning, and obtains the simplified formula of the output language of logical meaning and memory items through the simplest combination from the structural level. Then, from the point of view of biological system, a model involving semantic interpretation and application, that is, semantic circulatory system model, is proposed. It is considered that language output is not only related to sensorimotor system, conceptual-intentional system and computational system, but also to memory system involving the extraction of lexical array and the memory of recalculated word items. The internal and external cycle relationship between the four systems is verified by the Chinese natural language conversation.  © 2023 IEEE.},
 author = {Yang, Shiwen},
 doi = {10.1109/IALP61005.2023.10337323},
 journal = {Proceedings of 2023 International Conference on Asian Language Processing, IALP 2023},
