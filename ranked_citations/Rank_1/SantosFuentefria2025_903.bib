@article{SantosFuentefria2025_903,
 abstract = {ABSTRACT The integration of remote labs in renewable energy education is not yet common in Cuba due to material and knowledge limitations. The Erasmus+ project "EUBBC-Digital" has enabled their introduction in CUJAE’s Electrical Engineering program. This work addresses the generalities of the proposal and the objectives pursued by the presence of an installation of this type within the curriculum of the degree. The CUJAE Renewables energy source remote laboratory should be up and running in September this year. Having a remote laboratory will allow students to reach a new stage in their training, offering them the possibility of applying information and communication technologies to solve real problems and improve collaboration with other institutions. The paper identifies the intentions, goals and expectations of the remote lab and offers the opportunity for teachers and students from other countries to collaborate.},
 author = {Santos Fuentefria, Ariel and Castro Fernandez, Miguel and Fransson, Torsten},
 pages = {31--37},
 title = {Renewables energy source remote laboratory at CUJAE. Development and Perspectives},
 volume = {46},
 year = {2025}
}
