@inproceedings{10619784,
 abstract = {This study addresses the challenge of mapping IQRF wireless mesh networks, particularly focusing on the limitations associated with merged data collection techniques. We introduce an innovative data aggregation method aimed at simplifying the network mapping process by reducing the necessity for response messages from each node. Shifting from a traditional bit field to a node-sum approach allows for the aggregation of row sums from the adjacency matrix, facilitating a structural overview of the network. However, our findings indicate that while this method sheds light on the network's structure, achieving a detailed topological understanding may still require unique node identifiers. Additionally, this research explores the application of network mapping in developing a stability metric for IQRF networks, proposing new strategies to enhance network resilience.},
 author = {Sebestyén, Gergely and Kopják, József},
 booktitle = {2024 IEEE 18th International Symposium on Applied Computational Intelligence and Informatics (SACI)},
 doi = {10.1109/SACI60582.2024.10619784},
 issn = {2765-818X},
 keyword = {Accuracy;Wireless networks;Wireless mesh networks;Focusing;Stars;Complex networks;Routing;network mapping;network stability;merged data collecting;MDC;IQRF;FRC;TDMA;flooding routing},
 month = {May},
 number = {},
 pages = {000587-000592},
 title = {Mapping IQRF Wireless Networks Using Relative Addressing Technique},
 volume = {},
 year = {2024}
}
