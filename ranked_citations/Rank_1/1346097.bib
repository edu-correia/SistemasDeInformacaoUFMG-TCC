@inproceedings{1346097,
 abstract = {A novel OFDM-CDMA system, which merges the advantages of OFDMA and CDMA to minimize multiple access interference and is less vulnerable to asynchronism among users, becomes more suitable for uplink transmission. The paper presents a simple time and frequency synchronization method for uplink OFDM-CDMA. Symbol timing is achieved by making use of the good correlation property of training sequences that are distinguished, not only in the frequency domain, but also in the code domain. Frequency offsets are estimated using the maximum likelihood (ML) principle. Simulation results illustrate the high accuracy and efficiency of the proposed estimation algorithms.},
 author = {Kan Zheng and Lin Huang and Maomao Chen and Wenbo Wang},
 booktitle = {2004 International Conference on Communications, Circuits and Systems (IEEE Cat. No.04EX914)},
 doi = {10.1109/ICCCAS.2004.1346097},
 issn = {},
 keyword = {Frequency synchronization;Frequency estimation;Timing;Multicarrier code division multiple access;Fading;Multiaccess communication;Interference;Downlink;Gold;OFDM},
 month = {June},
 number = {},
 pages = {349-353 Vol.1},
 title = {Time and frequency synchronization for uplink OFDM-CDMA},
 volume = {1},
 year = {2004}
}
