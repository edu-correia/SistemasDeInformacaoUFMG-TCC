@inproceedings{11470787,
 abstract = {The rapid evolution of digital finance has heightened the demand for intelligent systems capable of adapting to dynamic market behaviors and complex regulatory environments. Financial institutions such as banks, fintech firms, and credit agencies increasingly rely on advanced decision models for credit risk assessment, fraud detection, and portfolio optimization. Traditional models including Rule-Based Systems, Bayesian Networks, Decision Trees, and Markov Decision Processes remain constrained by limited adaptability, lack of transparency, and poor integration of heterogeneous data. To address these issues, this study proposes an AIenhanced Case-Based Reasoning (AICBR) framework that merges symbolic reasoning with adaptive machine intelligence. The framework comprises five stages: case acquisition from structured and unstructured financial sources, machinelearning-based case indexing using feature embeddings and clustering, neural similarity retrieval via cosine and probabilistic metrics, reinforcement-learningdriven solution adaptation, and feedback-based continual learning for realtime improvement. Evaluation across five benchmark datasets Adult, Bank Marketing, Car Evaluation, Student Performance, and Online Retail demonstrates an average accuracy of 91.6% and latency under 3.5 seconds per transaction, surpassing traditional models that average below 78 %. The results validate AI-CBR's superiority in adaptability, transparency, and computational efficiency, establishing it as a robust and explainable framework for intelligent, data-driven, and regulatory-compliant financial decision-making.},
 author = {Song, MingYang and Lawanna, Thacha},
 booktitle = {2025 International Conference on Artificial Intelligence, Blockchain, Cloud Computing, and Data Analytics (ICoABCD)},
 doi = {10.1109/ICoABCD67551.2025.11470787},
 issn = {},
 keyword = {Feedback;Circuits;Cloud computing;Protocols;Feedback loop;Internet;HTTP;Feedback communications;Artificial intelligence;Cognitive systems;case-based reasoning;financial engineering;enforcement learning;explainable ai;predictive modeling;digital innovation},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {Transforming Financial Engineering through AI-Enhanced Case-Based Reasoning for Digital Innovation},
