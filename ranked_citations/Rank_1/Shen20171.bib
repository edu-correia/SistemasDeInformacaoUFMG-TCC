@conference{Shen20171,
 abstract = {Visual features of images and video frames have become pervasive and maturely developed in extensive research fields such as computer vision and visual search. In more and more cases, the visual feature becomes necessary information which needs to be transmitted and stored at server side in cloud. Among visual features, the local feature descriptors extracted by SIFT can represent both translational and non-translational motion, such as orientation and zooming. On the other hand, only translational motion can be represented by the Motion Vector (MV) in current MV based block video coding standard. Inspired by these properties, a method that utilizes the available feature to optimize inter prediction video coding is proposed in this paper. In this method, the localization, orientation and scale parameters of matching features extracted by SIFT are delivered to inter prediction to provide non-translational motion estimation (ME) and optimized merge mode. Experimental results have shown that the proposed method can efficiently improve the coding performance according to the accurate feature-matching. © 2017 IEEE.},
 author = {Shen, Xuelin and Wang, Jun and Yang, Qing and Chen, Peilin and Liang, Fan},
 doi = {10.1109/VCIP.2017.8305066},
 journal = {2017 IEEE Visual Communications and Image Processing, VCIP 2017},
 note = {Cited by: 1},
 pages = {1 - 4},
 publication_stage = {Final},
 source = {Scopus},
 title = {Feature based inter prediction optimization for non-translational video coding in cloud},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85050679161?origin=resultslist},
 volume = {2018-January},
 year = {2017}
}
