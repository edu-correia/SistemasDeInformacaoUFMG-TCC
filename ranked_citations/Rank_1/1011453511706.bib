@article{10.1145/3511706,
 abstract = {This article points out an important threat that application-level Garbage Collection (GC) creates to the use of non-volatile memory&nbsp;(NVM). Data movements incurred by GC may invalidate the pointers to objects on NVM and, hence, harm the reusability of persistent data across executions. The article proposes the concept of movement-oblivious addressing (MOA), and develops and compares three novel solutions to materialize the concept for solving the addressability problem. It evaluates the designs on five benchmarks and a real-world application. The results demonstrate the promise of the proposed solutions, especially hardware-supported Multi-Level GPointer, in addressing the problem in a space- and time-efficient manner.},
 address = {New York, NY, USA},
 articleno = {28},
 author = {Ye, Chencheng and Xu, Yuanchao and Shen, Xipeng and Jin, Hai and Liao, Xiaofei and Solihin, Yan},
 doi = {10.1145/3511706},
 issn = {1544-3566},
 issue_date = {June 2022},
 journal = {ACM Trans. Archit. Code Optim.},
 keyword = {Persistent memory, garbage collector, memory management},
 month = {March},
 number = {2},
 numpages = {26},
 publisher = {Association for Computing Machinery},
 title = {Preserving Addressability Upon GC-Triggered Data Movements on Non-Volatile Memory},
 url = {https://doi.org/10.1145/3511706},
 volume = {19},
 year = {2022}
}
