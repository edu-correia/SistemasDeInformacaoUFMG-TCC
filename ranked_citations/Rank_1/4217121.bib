 author = {Calderero, Felipe and Marques, Ferran and Ortega, Antonio},
 booktitle = {2007 IEEE International Conference on Acoustics, Speech and Signal Processing - ICASSP '07},
 doi = {10.1109/ICASSP.2007.366721},
 issn = {2379-190X},
 keyword = {Lagrangian functions;Image segmentation;Constraint optimization;Layout;Merging;Rate-distortion;Costs;Spatial coherence;Optimization methods;Motion estimation;Multiple view;region matching;Lagrangian optimization;image segmentation},
 month = {April},
