@conference{Tsesko2016,
 abstract = {YoctoDB is a small embedded engine for extremely fast partitioned immutable-after-construction databases. Sev- eral high load services at Yandex.Classifieds implement pipelined partitioned data reindexing. The result of the reindexing process is an immutable index delivered to many search machines, reopened as a part of the composite index and queried when serving user requests. Read performance, mem- ory consumption, fast reopening and reproducible latencies are paramount for the database engine. YoctoDB has suc- cessfully provided a solution for all of these services. We describe the role of YoctoDB in the architecture of indexing and search components, it's simple data model, client API, design, implementation and use cases. We conclude the pa- per with limitations of the approach and directions of future development. © 2016 ACM.},
 author = {Tsesko, Vadim and Demidov, Svyatoslav},
 doi = {10.1145/3022211.3022214},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {YoctoDB: A partitioned immutable embedded database},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85014870969?origin=resultslist},
 year = {2016}
}
