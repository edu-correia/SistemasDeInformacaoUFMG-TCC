@article{Luo20122947,
 abstract = {As a new branch for information fusion, image fusion has been an important and useful technique for image analysis and computer vision by extracting multiple properties of source images to form a composite image or data, which is used for other tasks of image processing and analysis. The purpose of image fusion is to generate a single image which contains a more accurate description of the scene than any of the individual source images. This paper first introduces the characteristics and research background of image fusion and then presents a survey of image fusion algorithms. According to different properties of fusion approaches, we roughly group them into four categories: transform based, region based, soft computing based and statistics based methods. The transform based fusion methods mainly introduce ordinary transform and multi-scale transform. The region based fusion methods describe the merit of region and region segmentation methods. The soft computing methods used in image fusion include artificial neural networks, fuzzy logic and evolutionary computation etc. The statistical methods of image fusion mainly include Bayesian estimation etc. After surveying and comparing these algorithms in each category, we conclude this paper with a discussion of future trends of image fusion. © 2012 Praise Worthy Prize S.r.l. - All rights reserved.},
 author = {Luo, Xiaoqing and Wu, Xiaojun},
 journal = {International Review on Computers and Software},
