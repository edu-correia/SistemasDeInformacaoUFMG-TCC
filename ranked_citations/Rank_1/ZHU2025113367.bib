@article{ZHU2025113367,
 abstract = {This study systematically investigate the Dynamic Recrystallization (DRX) behavior of 20MnSi steel during hot deformation by integrating experimental characterization with finite element simulation. The results indicate that high temperatures (1000–1100°C) facilitate DRX and enhance stress uniformity. Conversely, high strain rates (1–5 s⁻¹) inhibit DRX, while medium strain rates (0.1 s⁻¹) promote DRX to a certain degree when compared to low strain rates (0.01 s⁻¹). Microstructure analysis reveals the competing mechanisms of Discontinuous Dynamic Recrystallization (DDRX) and Continuous Dynamic Recrystallization (CDRX): DDRX prevails under low-temperature and low-strain-rate conditions, characterized by grain boundary bowing, while CDRX dominates at elevated temperatures through subcrystalline merging. The thermal processing map delineates the safe processing window (900–1100°C, 0.01–5 s⁻¹) and identifies the destabilization zone that should be avoided. The machine learning-modified Deform-3D model and the results from the Cellular Automata (CA) align well with the experimental data, thereby confirming the reliability of the multiscale method and offering a novel approach for designing the hot working process of high-performance 20MnSi steel.},
 author = {Jie Zhu and Xiaodong Wu},
 doi = {https://doi.org/10.1016/j.mtcomm.2025.113367},
 issn = {2352-4928},
 journal = {Materials Today Communications},
 keyword = {20MnSi steel, Hot deformation, Dynamic recrystallization, Machine learning, Process optimization},
 pages = {113367},
 title = {Experimental study and numerical simulation of dynamic recrystallization behavior of 20MnSi steel},
 url = {https://www.sciencedirect.com/science/article/pii/S2352492825018793},
 volume = {48},
 year = {2025}
}
