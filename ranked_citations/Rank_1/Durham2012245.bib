 number = {4},
 pages = {245 - 259},
 publication_stage = {Final},
 source = {Scopus},
 title = {Quantifying the correctness, computational complexity, and security of privacy-preserving string comparators for record linkage},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84861588233?origin=resultslist},
 volume = {13},
 year = {2012}
}
