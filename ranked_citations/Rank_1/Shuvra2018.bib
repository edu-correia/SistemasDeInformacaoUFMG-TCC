@conference{Shuvra2018,
 abstract = {Functional near-infrared (fNIR) is a noninvasive technique that can measure neuronal activity indirectly through hemodynamic response. fNIR spectroscopic neuroimaging technique is preferred for their availability, reliability, minimum noise, and portability as well as comparative low cost. NIRS measure different brain activity where includes different kind of perceptions. The diversity among same types of perception in different individual can be detected using fNIR imaging by integration with that MRI image. The aim of this study is to distinguish the diversity of human perception by analyzing brain signal via fNIR and merge it with anatomical brain image, establish the relationship between human brain and pain perception as well as find the dominant channel from tentative area. NIRS-SPM statistical parametric software is utilized here. The experimental results demonstrate the diversity of output for same input protocol. Alongside, the graphical estimation cerebral blood flow (CBF) and cerebral metabolic rate of oxygen (CMRO2) prove this paradigm. © 2018 IEEE.},
 author = {Shuvra, Lubna Tabassum and Islam, Sheikh Md. Rabiul and Zaman, Nowrin and Hasan, Md. Asif},
 doi = {10.1109/CIET.2018.8660933},
 journal = {2018 International Conference on Innovation in Engineering and Technology, ICIET 2018},
 note = {Cited by: 4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Analysis of Hemodynamic Response Function using fNIRS},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85063577436?origin=resultslist},
 year = {2018}
}
