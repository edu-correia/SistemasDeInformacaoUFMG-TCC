@conference{Kovvuru2026675,
 abstract = {It is challenging to segment psoriasis lesions accurately due to their irregular boundaries, heterogeneous textures, and variable shapes across different patients. The goal of this study is to create better tools for illness evaluation and determination by focusing on segmentation of psoriasis lesions, which assist in assessing the size and severity of lesions of the illness. Most typical U-Net models that are used for segmentation base their approaches on local intensity and texture features, so they are unable to capture the structural consistency of lesion shapes. To address this, we propose an advanced version of U-Net that includes a Shape Prior Module (SPM) at the bottleneck layer. By utilizing learned tokens which capture the global shape of lesions, the SPM facilitates the segmentation process. Through self-attention, these tokens are refined and used to create spatial prior maps, which assist the decoder in accurately reconstructing lesion boundaries. The model is able to merge the global shape of lesions with local features of the image, which creates a better alignment of structural and contextual features, resulting in enhanced segmentation that is resistant to noise. Experimental results show that the suggested SPM U-Net performs better than the plain U-Net, offering more accurate, consistent, and structurepreserving psoriasis lesion segmentation, with an accuracy of 0.9936 and a Dice Index (DI) of 0.9889. © 2026 IEEE.},
 author = {Kovvuru, Aruna Kumari and Londhe, Narendra D. and Sonawane, Rajendra S.},
 doi = {10.1109/IC3ECSBHI67834.2026.11469026},
 journal = {2026 2nd International Conference on Cognitive Computing in Engineering, Communications, Sciences and Biomedical Health Informatics, IC3ECSBHI 2026},
 note = {Cited by: 0},
 pages = {675 - 680},
 publication_stage = {Final},
 source = {Scopus},
 title = {Shape Prior U-Net: Integrating Global Shape Knowledge for Accurate Psoriasis Lesion Segmentation},
 type = {Conference paper},
