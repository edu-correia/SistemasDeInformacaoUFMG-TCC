@article{ZHANG2025119034,
 abstract = {High-power lithium-ion batteries face critical thermal safety challenges under high discharge, as conventional air/liquid-cooled BTMS suffer from inadequate heat dissipation, poor uniformity, and complex structures. Few studies have explored synergistic integration of heat pipes, bio-inspired cold plates, and hybrid fins, or fully intelligent multi-objective optimization. This study proposes an advanced BTMS featuring heat pipes, a bionic topological cold plate (BTCP), and hybrid fins. Compared with conventional serpentine-channel and mesh-channel liquid cooling systems, the proposed BTMS achieves up to a 5 % reduction in maximum temperature (Tmax) at identical mass flow rates under 3C high-discharge conditions. A numerical framework incorporating Latin Hypercube Sampling (LHS), Backpropagation Neural Network (BPNN), and Multi-Objective Particle Swarm Optimization (MOPSO) was developed to optimize design parameters. After optimization, Case 2 reduces the Tmax from 44.03 °C (initial parameters: fin length of 10 mm, fin thickness of 2 mm, mass flow rate of 0.15 kg/s, and heat pipe thermal conductivity of 5000 W/(m·K)) to 42.60 °C (a decrease of 3.3 %). Meanwhile, the temperature difference (ΔT) slightly increases from 1.21 °C to 1.25 °C (an increase of 3.2 %). Although the optimized device only changes the Tmax and ΔT by approximately 3 % compared with the unoptimized BTCP, these changes are equivalent to an absolute temperature reduction of 1.3–1.5 °C. The balance between the improvement in thermal performance and the enhancement of energy efficiency is the key reason for recommending the use of the optimized configuration. In addition, the optimized BTCP reduces the pressure drop (ΔP) to 1.25 × 104 Pa, which is 27 % lower than that of conventional serpentine channels and 18 % lower than that of mesh channels, thus outperforming traditional cooling systems in hydraulic performance. This work demonstrates the efficacy of merging multi-physics simulations with machine learning-driven optimization high-performance BTMS, novel insights for co-optimization structural and thermal parameters in advanced battery thermal management.},
 author = {Danyang Zhang and Yingjun Yu and Weiwei Yang and Xueqian Zhang and Chaojie Yu and Qingfeng Zhang},
 doi = {https://doi.org/10.1016/j.est.2025.119034},
 issn = {2352-152X},
 journal = {Journal of Energy Storage},
 keyword = {Battery thermal management systems, Bionic topological cold plate, Backpropagation neural network, Latin hypercube sampling, Multi-objective particle swarm optimization},
 pages = {119034},
 title = {Research on the performance of battery thermal management system based on bionic coupling structure and multi-objective optimization},
 url = {https://www.sciencedirect.com/science/article/pii/S2352152X25037478},
 year = {2025}
}
