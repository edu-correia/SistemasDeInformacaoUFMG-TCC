@conference{Bomanson20192694,
 abstract = {Answer-Set Programming (ASP) is an expressive rule-based knowledge-representation formalism. Lazy grounding is a solving technique that avoids the well-known grounding bottleneck of traditional ASP evaluation but is restricted to normal rules, severely limiting its expressive power. In this work, we introduce a framework to handle aggregates by normalizing them on demand during lazy grounding, hence relieving the restrictions of lazy grounding significantly. We term our approach as lazy normalization and demonstrate its feasibility for different types of aggregates. Asymptotic behavior is analyzed and correctness of the presented lazy normalizations is shown. Benchmark results indicate that lazy normalization can bring up-to exponential gains in space and time as well as enable ASP to be used in new application areas. © 2019, Association for the Advancement of Artificial Intelligence (www.aaai.org).},
 author = {Bomanson, Jori and Janhunen, Tomi and Weinzierl, Antonius},
 doi = {10.1609/aaai.v33i01.33012694},
 journal = {33rd AAAI Conference on Artificial Intelligence, AAAI 2019, 31st Innovative Applications of Artificial Intelligence Conference, IAAI 2019 and the 9th AAAI Symposium on Educational Advances in Artificial Intelligence, EAAI 2019},
 note = {Cited by: 19; All Open Access; Gold Open Access},
 pages = {2694 - 2702},
 publication_stage = {Final},
 source = {Scopus},
 title = {Enhancing lazy grounding with lazy normalization in answer-set programming},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85090800221?origin=resultslist},
 year = {2019}
}
