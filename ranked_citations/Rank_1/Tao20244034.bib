@conference{Tao20244034,
 abstract = {Large language models (LLMs) have demonstrated remarkable progress in leveraging diverse knowledge sources. This study investigates how nine widely used LLMs allocate knowledge between local context and global parameters when answering open-ended questions in knowledge-consistent scenarios. We introduce a novel dataset, WikiAtomic, and systematically vary context sizes to analyze how LLMs prioritize and utilize the provided information and their parametric knowledge in knowledge-consistent scenarios. Additionally, we also study their tendency to hallucinate under varying context sizes. Our findings reveal consistent patterns across models, including a consistent reliance on both contextual (around 70%) and parametric (around 30%) knowledge, and a decrease in hallucinations with increasing context. These insights highlight the importance of more effective context organization and developing models that use input more deterministically for robust performance. © 2024 Association for Computational Linguistics.},
 author = {Tao, Yufei and Hiatt, Adam and Haake, Erik and Jetter, Antonie J. and Agrawal, Ameeta},
 doi = {10.18653/v1/2024.emnlp-main.234},
 journal = {EMNLP 2024 - 2024 Conference on Empirical Methods in Natural Language Processing, Proceedings of the Conference},
 note = {Cited by: 2; All Open Access; Gold Open Access},
 pages = {4034 - 4058},
 publication_stage = {Final},
 source = {Scopus},
 title = {When Context Leads but Parametric Memory Follows in Large Language Models},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85217827357?origin=resultslist},
 year = {2024}
}
