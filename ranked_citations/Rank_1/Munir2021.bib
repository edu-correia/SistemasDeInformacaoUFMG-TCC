@article{Munir2021,
 abstract = {The task of semantic role labeling (SRL) is dedicated to finding the predicate-Argument structure. Previous works on SRL are mostly supervised and do not consider the difficulty in labeling each example which can be very expensive and time-consuming. In this article, we present the first neural unsupervised model for SRL. To decompose the task as two argument related subtasks, identification and clustering, we propose a pipeline that correspondingly consists of two neural modules. First, we train a neural model on two syntax-Aware statistically developed rules. The neural model gets the relevance signal for each token in a sentence, to feed into a BiLSTM, and then an adversarial layer for noise-Adding and classifying simultaneously, thus enabling the model to learn the semantic structure of a sentence. Then we propose another neural model for argument role clustering, which is done through clustering the learned argument embeddings biased toward their dependency relations. Experiments on the CoNLL-2009 English dataset demonstrate that our model outperforms the previous state-of-The-Art baseline in terms of non-neural models for argument identification and classification.  © 2021 Association for Computing Machinery.},
 author = {Munir, Kashif and Zhao, Hai and Li, Zuchao},
 doi = {10.1145/3461613},
 journal = {ACM Transactions on Asian and Low-Resource Language Information Processing},
 note = {Cited by: 5},
 number = {6},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Neural Unsupervised Semantic Role Labeling},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85135098215?origin=resultslist},
 volume = {20},
 year = {2021}
}
