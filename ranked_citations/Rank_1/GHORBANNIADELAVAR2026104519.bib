@article{GHORBANNIADELAVAR2026104519,
 abstract = {Redundancy and duplicated data have been one of the critical issues in synchronizing the objective function within hybrid meta-heuristic routing based on re-clustering and data transmission. The IFSDR method, which is based on the integration of the Ant Colony Optimization algorithm and the Genetic Algorithm, has been utilized to search for duplicated data. This nature-inspired hybrid approach is designed to decrease redundancy and duplicated data while optimizing the classification of complex problems. Since dynamic and heterogeneous environments face challenges such as energy consumption constraints, low bandwidth, high node mobility, and difficulty in accurately localizing sensors, the adoption of efficient and less complex routing paths has been employed. In this approach, load distribution is precisely performed both horizontally and vertically, which has led to a decrease in errors across multi-objective routing paths through encoding and error detection mechanisms. Moreover, an Intelligent Threshold Detector (ITD) and automated maintenance mechanisms have been employed to prevent redundant transmissions and data loss. The mobility of sensors in heterogeneous networks, along with the optimized synchronization of key parameters and the balancing of their sleep–wake cycles, leads to a decrease in the input values of the objective function under conditions where immediate data collection is not required. In the IFSDR method, the index parameter and the proper selection of the initial population are classified based on random paths. By incorporating the Lagrangian function and the ITD, several performance metrics including delay, energy consumption, repetition count, time complexity, routing overhead, packets received by re-clustered cluster heads, and dynamically received packets at nodes are optimized. This contributes to the transformation of irregular routing paths into more stable ones, achieved through the application of the GA. The objective function mechanism has demonstrated improved efficiency and effectiveness compared to the case studies. In the proposed method, a hybrid meta-heuristic algorithm has been utilized to escape local optima and reach the global optimum through proper selection, enabling the identification of optimal paths in terms of energy, delay, and actual execution time. Then, by generating a randomized initial population, a structured framework is developed using the proposed algorithm. Finally, the implementation of this method demonstrates that the proposed algorithm has successfully reduced energy consumption compared to the studied algorithms, and decreased end-to-end latency and real execution time, and improved the average objective value by %12.07 compared to Case Study.},
 author = {Arash GhorbanniaDelavar and Zahra Jormand and Fatemeh Zahra Gharib},
 doi = {https://doi.org/10.1016/j.aei.2026.104519},
 issn = {1474-0346},
 journal = {Advanced Engineering Informatics},
 keyword = {Ant Colony Optimization (ACO), Genetic Algorithm (GA), Optimal routing, Lagrangian function, Hybrid meta-heuristic algorithm, Re-clustering, Intelligent Threshold Detector (ITD)},
 pages = {104519},
 title = {IFSDR: Re-clustering routing of data transmission using objective function synchronization based on intelligent threshold detector},
 url = {https://www.sciencedirect.com/science/article/pii/S1474034626002119},
 volume = {74},
 year = {2026}
}
