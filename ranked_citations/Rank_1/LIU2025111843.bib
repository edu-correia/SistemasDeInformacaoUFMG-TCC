@article{LIU2025111843,
 abstract = {Infrared and visible image fusion (IVIF) seeks to enhance detection and inspection capability by merging complementary information from different wavelength bands, thereby offering more informative visual representations. However, current fusion models, particularly those based on convolutional neural networks, face challenges such as constrained global information extraction, vulnerability to high-frequency information loss, and reliance on empirically derived or manually tuned loss function parameters. To address the above issues, a novel Convolution and Multilayer Perceptron (MLP)-integrated Multiscale Coordinate Network (CM-MCNet) is proposed for IVIF. Within the encoder of CM-MCNet, we devise a convolutional weighted permute MLP (CWPMLP) to enhance the spatial dimension representation through permutation operations, while a re-weighting block is integrated to dynamically modulate feature combinations, thus facilitating seamless integration of global contextual information. Furthermore, we introduce a multiscale coordinate convolution (MsCConv), which leverages central differential convolution to preserve high-frequency details and employs multiscale parallel subnetworks to maintain rich multi-level features. The incorporation of the coordinate attention mechanism further optimizes the selection of pivotal regions in the feature map, retaining complementary information while eliminating redundancy. To further elevate the IVIF performance, we introduce a data-driven adaptive weighting strategy that automatically balances multiple loss terms, reducing the need for manual tuning and enhancing adaptability to varying image characteristics. Extensive experiments on three benchmark datasets illustrate that the CM-MCNet outperforms state-of-the-art methods in both visual quality and quantitative assessments. Ablation studies demonstrate the effectiveness of the network architecture and loss design. Moreover, CM-MCNet also yields performance gains in downstream tasks such as infrared-visible semantic segmentation and object detection within a unified benchmark framework.},
 author = {Jinping Liu and Shiyi Liu and Lijuan Huang and Lihui Cen},
 doi = {https://doi.org/10.1016/j.patcog.2025.111843},
 issn = {0031-3203},
 journal = {Pattern Recognition},
 keyword = {Infrared and visible image fusion, Convolutional weighted permute multilayer perceptron, Multiscale coordinate convolution, Coordinate attention, Data-driven adaptive weighting},
 pages = {111843},
 title = {CM-MCNet: Convolution and multilayer perceptron-integrated multiscale coordinate network for infrared and visible image fusion},
 url = {https://www.sciencedirect.com/science/article/pii/S0031320325005035},
 volume = {168},
 year = {2025}
}
