@incollection{SOLTANIFAR2025193,
 abstract = {Data envelopement analysis (DEA) evaluates the efficiency of a decision-making unit (DMU) by analyzing its input and output levels. On the other hand, the inverse DEA method concentrates on figuring out the necessary input levels for a DMU to maintain its efficiency score while producing a given output. One notable application of inverse DEA is in the merger analysis of multiple production units. In an input-oriented framework, the inverse DEA approach is employed to determine the new input levels required for merging units to produce an aggregated output while achieving the desired efficiency level. As an alternative, the merger model employing the inverse DEA structure under an output-oriented framework seeks to determine the highest output that the combined input levels may provide while preserving the required efficiency. This chapter explores merger models based on the inverse DEA framework. It introduces fundamental inverse DEA merger models and explains them through numerical examples. Additionally, advanced merger models, including cost efficiency and revenue efficiency inverse DEA models, are presented. The chapter concludes with a real-world empirical study illustrating the practical application of these models.},
 author = {Mehdi Soltanifar and Mojtaba Ghiyasi and Farhad Hosseinzadeh Lotfi and Mohammadreza Shahriari},
 booktitle = {Advanced Topics in Inverse Data Envelopment Analysis},
 doi = {https://doi.org/10.1016/B978-0-443-36488-4.00004-5},
 editor = {Mehdi Soltanifar and Mojtaba Ghiyasi and Farhad Hosseinzadeh Lotfi and Mohammadreza Shahriari},
 isbn = {978-0-443-36488-4},
 keyword = {Input and output estimation, inverse data envelopment analysis},
 pages = {193-213},
 publisher = {Academic Press},
 series = {Uncertainty, Computational Techniques, and Decision Intelligence},
 title = {Chapter seven - Inverse ratio-based data envelopment analysis models for input and output estimation},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443364884000045},
 year = {2025}
}
