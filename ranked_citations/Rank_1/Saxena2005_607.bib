@article{Saxena2005_607,
 abstract = {This paper deals with the derivation of the Kober fractional q-integral operator of the basic analogue of the H-function defined by Saxena, Modi and Kalla [Rev. Téc. Ing., Univ. Zulia. 6(1983), 139-143]. Several interesting results involving Gq(.);Eq(.); the basic elementary functions and the basic Bessel functions such as Jv(x; q); Yv(x; q); Kv(x; q); Hv(x; q), are deduced as the special cases of the main results.},
 author = {Saxena, R.K and Yadav, R.K and Purohit, S.D and Kalla, S.L},
 number = {2},
 pages = {154--158},
 title = {Kober fractional q-integral operator of the basic analogue of the H-function},
 volume = {28},
 year = {2005}
}
