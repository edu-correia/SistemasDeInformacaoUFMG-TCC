@incollection{2026223,
 abstract = {This chapter addresses the urgent need for innovative energy solutions in the face of global warming and climate change, particularly focusing on the integration of photovoltaic (PV) systems and thermoelectric generators (TEGs) as hybrid devices. It begins with an overview of the detrimental effects of fossil fuels on the environment and highlights solar power as a vital renewable energy alternative. The introduction discusses how the performance of PV systems is significantly impacted by temperature fluctuations, mentioning that a rise in temperature results in decreased electrical efficiency. Consequently, effective thermal regulation strategies, including advanced cooling solutions, are crucial for enhancing PV performance and sustainability. Subsequent sections of the chapter delve into the structure and optimization of PV-TEG hybrid devices, covering various configurations such as concentrators and heat-pipe-based systems. Key techniques for maximizing power output, and the integration of phase change materials are also explored. The chapter examines different electrical connection configurations—parallel, series, and isolated connections—discussing their respective advantages. Through comprehensive analysis and recent research findings, this chapter provides valuable insights and practical guidance for optimizing the productivity of hybrid PV-TE systems, ultimately contributing to more efficient and sustainable energy harvesting solutions.},
 booktitle = {Innovations in Solar Thermal Energy},
 doi = {https://doi.org/10.1016/B978-0-443-33698-0.00002-9},
 editor = {Mohsen Sheikholeslami},
 isbn = {978-0-443-33698-0},
 keyword = {Photovoltaic (PV) systems, maximum power point tracking (MPPT), thermoelectric generator (TEG), phase change material (PCM)},
 pages = {223-251},
 publisher = {Elsevier},
 title = {9 - Merging photovoltaic modules with thermoelectric technology},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443336980000029},
 year = {2026}
}
