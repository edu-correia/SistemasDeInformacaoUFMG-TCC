@conference{Song2011745,
 abstract = {For elaborately understanding what product features the reviews focuses on, we propose an approach based on patterns to extraction features (titles). Trough setting length, upper and lower limit probability and frequency thresholds, we extract patterns of POS tags and features from the training corpus. To enhance adaptability of the pattern set, we merge some fundamental patterns into a new fuzzy pattern. Then a pattern matching algorithm is applied to extract the titles and opinion words from the reviews. We conducted a platform to extract features from product reviews automatically, the result of our experiments shows that our approach is effective. © 2011 AICIT.},
 author = {Song, Hui and Fan, Yingxiang and Liu, Xiaoqiang and Tao, Dao},
 journal = {Proceedings - 6th International Conference on Computer Sciences and Convergence Information Technology, ICCIT 2011},
 note = {Cited by: 13},
 pages = {745 - 750},
 publication_stage = {Final},
 source = {Scopus},
 title = {Extracting product features from online reviews for sentimental analysis},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84869391233?origin=resultslist},
 year = {2011}
}
