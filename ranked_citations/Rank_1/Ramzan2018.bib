 publication_stage = {Final},
 source = {Scopus},
 title = {An intelligent approach for handling complexity by migrating from conventional databases to big data},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85059013569?origin=resultslist},
 volume = {10},
 year = {2018}
}
