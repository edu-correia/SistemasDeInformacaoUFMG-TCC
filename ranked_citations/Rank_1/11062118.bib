@article{11062118,
 abstract = {The small-object detection is a challenging but vital task for applications, such as search and rescue (SAR), surveillance, and remote sensing, where the goal is to detect small targets, such as people, vehicles, or boats in complex environments. The minimal pixel representation of such targets, combined with cluttered backgrounds and environmental variations like lighting changes, makes accurate detection particularly difficult. To address these challenges, we propose Focal Spotter, a novel Transformer-based detector that incorporates two key modules: the energy-based focal module (EFM) and the focalized interscale feature complementary module (FICM). The EFM leverages an energy-based model (EBM) to achieve inner scale feature focalization. The EBM dynamically allocates weights through an energy function, focusing on low-energy target signals (such as small-object features), significantly enhancing the model’s sensitivity to sparse or weak signals. This capability allows EFM to outperform conventional attention methods in both robustness and precision. The FICM facilitates interscale feature focalization by aligning and integrating high-level semantic and low-level detailed features spatially and channelwise. By preemptively extracting and merging compensatory information across scales, it boosts feature fusion efficiency, minimizes redundancy, ensures semantic consistency, and achieves precise spatial localization, significantly enhancing small-object detection in complex scenes. Extensive experiments on multiple benchmark datasets, including SeaDronesSee and VisDrone, demonstrate that Focal Spotter outperforms state-of-the-art (SOTA) methods in small-object detection. Ablation studies highlight the critical contributions of EFM and FICM, with EFM showing the superior performance over other attention mechanisms in capturing sparse small targets. The results underscore the robustness and effectiveness of our approach across diverse and challenging scenarios, from maritime-to-urban environments.},
 author = {Duan, Ruxiang and Du, Qiliang and Tian, Lianfang and Liu, Hailin and Huo, Shuwei},
 doi = {10.1109/TGRS.2025.3584812},
 issn = {1558-0644},
 journal = {IEEE Transactions on Geoscience and Remote Sensing},
 keyword = {Feature extraction;Object detection;Accuracy;Detectors;Semantics;Data mining;Transformers;Real-time systems;Focusing;Attention mechanisms;Energy-based model (EBM);feature focalization;maritime imagery;semantic consistency;small-object detection;Transformer-based detector},
 month = {},
 number = {},
 pages = {1-15},
 title = {Focal Spotter: Small-Object Detection via Inner Scale and Interscale Feature Focalization},
 volume = {63},
 year = {2025}
}
