@article{KU2025675,
 abstract = {The urgent need to develop efficient, durable, and cost-effective oxygen evolution reaction (OER) catalysts for energy conversion and storage has prompted extensive research. Currently available commercial noble metal-based OER catalysts are expensive and exhibit limited long-term stability. In this study, boron-doped diamond composites (BDDCs) consisting of CoFe and CoFe2C nanoparticles supported by boron-doped diamond (BDD) particles have been prepared. The BDDC catalyst, prepared through a straightforward annealing process, exhibits exceptional durability (up to 72 h at 10 mA cm−2), a low overpotential (306 mV at 10 mA cm−2), and modest Tafel slope (58 mV dec-1). The coherent interfaces between CoFe/CoFe2C nanoparticles and the BDD substrate are essential for enhancing the OER performance. The fabrication method and composite structures presented in this study may facilitate the design and production of promising catalysts.},
 author = {Yalun Ku and Kuikui Zhang and Ying Guo and Shulong Chang and Yu Yan and Guangsong Zheng and Han Gao and Dongsheng Song and Xun Yang and Shaobo Cheng and Lin Dong and Chongxin Shan},
 doi = {https://doi.org/10.1016/j.jcis.2024.08.106},
 issn = {0021-9797},
 journal = {Journal of Colloid and Interface Science},
 keyword = {Electrocatalysis, Boron-doped diamond, Non-noble-metal-based catalysts, Coherent interfaces, Oxygen evolution reaction},
 pages = {675-682},
 title = {Boron-doped diamond composites for durable oxygen evolution},
 url = {https://www.sciencedirect.com/science/article/pii/S0021979724018885},
 volume = {677},
 year = {2025}
}
