@inproceedings{10142768,
 abstract = {The study of dynamic overlapping semantic communities is an important research content for people to analyze the development pattern of events, monitor the trend of public opinion and commercial personalized recommendation. However, existing dynamic community detection algorithms ignore the influence of attributes on community structure, which not only affects the accuracy of community structure but also fragments the relationship between community and topic, and the similarity of topics within the community is not high. Therefore, this paper proposes a dynamic community detection algorithm based on topic division (DOCTS), which uses node attribute features to make topics, combines the network structures of adjacent moments to get weighted subnetworks, then uses Louvain algorithm to detect weighted subnetworks to get topic sub-communities, and finally, merges and optimizes the communities that will have high similarity to get overlapping topic communities. It is verified in real dataset Facebook that the algorithm can effectively detect communities in dynamic networks and also analyze the community structure based on topic evolution.},
 author = {Jia, Junjie and Li, LiFang},
 booktitle = {2023 5th International Conference on Communications, Information System and Computer Engineering (CISCE)},
 doi = {10.1109/CISCE58541.2023.10142768},
 issn = {2833-2423},
 keyword = {Social networking (online);Heuristic algorithms;Semantics;Clustering algorithms;Feature extraction;Market research;Reflection;social networks;semantic community;evolutionary clustering;Louvain},
 month = {April},
 number = {},
 pages = {481-485},
 title = {Dynamic overlapping community detection algorithm based on topic segmentation},
 volume = {},
 year = {2023}
}
