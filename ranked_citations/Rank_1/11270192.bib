@inproceedings{11270192,
 abstract = {Artificial Intelligence based cardiac image segmentation requires consistent labels, harmonized volumes, and computationally efficient dataset. The present study proposes a reproducible pipeline that (i) merges segmented cardiac structures into a single multi-label mask (0: background, 1: aorta, 2: chambers, 3: pulmonary structures), (ii) resamples masks to perfectly match scan dimensions using 3D Slicer’s "Resample Image (BRAINS)" module (nearest-neighbor interpolation), and (iii) performs automatic region-of-interest (ROI) cropping by adding 10-pixel margin around mask-derived bounds. On our internal dataset, the workflow standardizes inputs, reduces data volume substantially, and preserves full cardiac anatomy. The resulting data enabled stable multi-class and task-specific training and contribution to a better Dice score in downstream models. The ROI script operate on a simple folder structure and can be executed batch-wise, supporting anonymity, interoperability, and rapid experimentation.},
 author = {Sahin, Omer Faruk and Alzaeim, Mohamad Humam and Yazici, Beyza Nur and Onder, Sakip and Gunveren, Doruk and Piskin, Senol and Gungoren, Fatma Zeynep and Mirza, Ruqaiyah and Yilmaz, Irem and Faress, Ibrahim and Kose, Kevser Banu and Josephin, J S Femilda and Umair, Musab Ahmed Khan and Aydogdi, Fatmanur},
 booktitle = {2025 Medical Technologies Congress (TIPTEKNO)},
 doi = {10.1109/TIPTEKNO68206.2025.11270192},
 issn = {2687-7783},
 keyword = {Training;Image segmentation;Solid modeling;Three-dimensional displays;Pipelines;Data models;Artificial intelligence;Standards;Biomedical imaging;Periodic structures;multi-label segmentation;deep learning;convolutional neural networks (CNNs);image resampling;ROI cropping;data preprocessing;medical image segmentation;pediatric cardiac image;segmentation AI},
 month = {Oct},
 number = {},
 pages = {1-4},
 title = {A Unified Pipeline for Consistent Multi-Label Mask Generation in Pediatric Cardiac Segmentation},
 volume = {},
 year = {2025}
}
