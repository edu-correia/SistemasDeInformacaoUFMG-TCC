@conference{Chang20171687,
 abstract = {To realize the medical video applications, this paper proposes several lossless compression methods over high efficiency video coding (HEVC). A generalized intra block copy (GIBC) is first proposed to predict the coding unit by a reference block, whose samples could be fully or partially reconstructed. A cyclic block padding technique is also proposed to predict the unreconstructed samples in the reference block by geometrically co-located blocks. Based on the feature distribution analyses for palette coding, we further propose an HEVC-based medical video coder (HMC), which combines the GIBC, line-coded palette coding and intra palette predictor without mutual conflicts. Experimental results show that, compared to the lossless HEVC, the proposed GIBC and HMC respectively save up to 13.9% and 22.3% bits over medical videos. © 2017 IEEE.},
 author = {Chang, Yao-Jen and Tsai, Pei-Hsuan and Lin, Chun-Lung},
 doi = {10.1109/ICASSP.2017.7952444},
 journal = {ICASSP, IEEE International Conference on Acoustics, Speech and Signal Processing - Proceedings},
 note = {Cited by: 2},
 pages = {1687 - 1691},
 publication_stage = {Final},
 source = {Scopus},
 title = {Novel medical video compression methods over lossless HEVC coder},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85023774462?origin=resultslist},
 year = {2017}
}
