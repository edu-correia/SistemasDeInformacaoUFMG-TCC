@inproceedings{11504010,
 abstract = {Unmanned Aerial Vehicle (UAV) embedded systems have stringent constraints in terms of computational resources, power consumption, and real-time performance, making it challenging to efficiently deploy state-of-the-art models like YOLOv11 for target detection. To address this issue, we propose a lightweight optimization method for YOLOv11, utilizing channel pruning and structural reparameterization. First, a channel importance evaluation mechanism based on attention fusion is introduced to effectively identify and eliminate redundant channels in the backbone and neck of YOLOv11, achieving model compression with minimal precision loss. Next, we propose a structural reparameterization strategy tailored to YOLOv11's multi-branch architecture. This approach merges the multi-branch structure during training into a single branch during inference, significantly reducing computational complexity and improving inference speed while retaining the model’s feature extraction capabilities. Extensive experiments on both the UAV target detection dataset (UAVDT) and the public COCO dataset demonstrate that the optimized model reduces the number of parameters by 68.3% and the computational complexity (GFLOPs) by 71.5%. Moreover, the inference speed on the UAV embedded platform (NVIDIA Jetson Nano) is increased by 2.3 times, with only a 1.2% drop in mean Average Precision (mAP@0.5). The proposed method effectively balances model performance with deployment constraints, offering a practical solution for real-time target detection on UAV embedded systems.},
 author = {Song, Zhanwei and Zhao, Jin and Zhang, Huan and Wang, Sinan and Hou, Jing},
 booktitle = {2026 9th International Conference on Advanced Electronic Technology, Computers and Software Engineering (AETCSE)},
 doi = {10.1109/AETCSE69203.2026.11504010},
 issn = {},
 keyword = {Modeling;Autonomous aerial vehicles;Embedded systems;Timing;Object detection;Convolution;Printing;Equations;Modules (abstract algebra);Aluminum;YOLOv11;UAV embedded system;Channel pruning;Structural reparameterization;Lightweight target detection},
 month = {March},
 number = {},
 pages = {829-832},
 title = {Channel Pruning and Structural Reparameterization of YOLOv11 for UAV Embedded Systems},
