@article{Aubrey-Jones2016552,
 abstract = {Distributed memory architectures such as Linux clusters have become increasingly common but remain difficult to program. We target this problem and present a novel technique to automatically generate data distribution plans, and subsequently MPI implementations in C++, from programs written in a functional core language. The main novelty of our approach is that we support distributed arrays, maps, and lists in the same framework, rather than just arrays. We formalize distributed data layouts as types, which are then used both to search (via type inference) for optimal data distribution plans and to generate the MPI implementations. We introduce the core language and explain our formalization of distributed data layouts. We describe how we search for data distribution plans using an adaptation of the Damas–Milner type inference algorithm, and how we generate MPI implementations in C++ from such plans. © 2015, Springer Science+Business Media New York.},
 author = {Aubrey-Jones, Tristan and Fischer, Bernd},
 doi = {10.1007/s10766-015-0359-4},
 journal = {International Journal of Parallel Programming},
 note = {Cited by: 3},
 number = {3},
 pages = {552 - 573},
 publication_stage = {Final},
 source = {Scopus},
 title = {Synthesizing MPI Implementations from Functional Data-Parallel Programs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84926034585?origin=resultslist},
 volume = {44},
 year = {2016}
}
