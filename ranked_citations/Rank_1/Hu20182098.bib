@conference{Hu20182098,
 abstract = {Although natural language question answering over knowledge graphs have been studied in the literature, existing methods have some limitations in answering complex questions. To address that, in this paper, we propose a State Transition-based approach to translate a complex natural language question N to a semantic query graph (SQG) Q<sup>S</sup>, which is used to match the underlying knowledge graph to find the answers to question N. In order to generate Q<sup>S</sup>, we propose four primitive operations (expand, fold, connect and merge) and a learning-based state transition approach. Extensive experiments on several benchmarks (such as QALD, WebQuestions and ComplexQuestions) with two knowledge bases (DBpedia and Freebase) confirm the superiority of our approach compared with state-of-the-arts. © 2018 Association for Computational Linguistics},
 author = {Hu, Sen and Zou, Lei and Zhang, Xinbo},
 journal = {Proceedings of the 2018 Conference on Empirical Methods in Natural Language Processing, EMNLP 2018},
 note = {Cited by: 97},
 pages = {2098 - 2108},
 publication_stage = {Final},
 source = {Scopus},
 title = {A state-transition framework to answer complex questions over knowledge base},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85066476875?origin=resultslist},
 year = {2018}
}
