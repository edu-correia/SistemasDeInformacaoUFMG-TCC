@inproceedings{11428036,
 abstract = {Recent advancements in Deep Learning (DL) have underscored the critical need for explainability in model predictions. The ability to understand and interpret the decisions made by DL models is essential for ensuring their trustworthiness and widespread adoption, especially in high-stakes domains such as healthcare and finance. Traditional DL models often operate as “black boxes,” making it challenging for users to comprehend how inputs are transformed into outputs. In response to this challenge, there has been a recent rise in techniques such as Association Rule Mining (ARM) for explainability. ARM provides transparent and intuitive explanations that users can easily grasp. ARM can uncover insights into the decision-making process of these models by analyzing patterns and associations in data. In this paper, RuleNet, a novel architecture for enhancing explainability in DL models through the integration of ARM is proposed. RuleNet employs the Apriori algorithm for generating class-specific rules from encoded training data, then trains a Deep Neural Network (DNN) to predict test instances. An Agreement component then aligns these predictions with corresponding ARM-derived rules, identifying the most relevant explanations based on the highest confidence levels, to explain the decisionmaking process of the DNN model. The results indicate that merging these methodologies significantly enhances the ability to uncover the patterns recognized by the model and evaluate its performance across various scenarios via error analysis. This approach is proposed to increase the transparency and interpretability of black-box models, thereby augmenting their dependability for practical applications.},
 author = {Eljack, Aseel and Matraf, Ahmed Ba and Aghbari, Zaher Al},
 booktitle = {2025 Advances in Science and Engineering Technology International Conferences (ASET)},
 doi = {10.1109/ASET66891.2025.11428036},
 issn = {2831-6878},
 keyword = {Deep learning;Computational modeling;Decision making;Closed box;Finance;Artificial neural networks;Medical services;Predictive models;Data models;Association rule learning;Deep Learning;Association Rule Mining;Explainable AI;Neural Networks;Apriori Algorithm;Model Interpretability;Rule-based Explanations;Black-box Models},
 month = {Sep.},
