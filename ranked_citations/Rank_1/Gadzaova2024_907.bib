@article{Gadzaova2024_907,
 abstract = {ABSTRACT This paper reviews various approaches to organizing the educational process and evaluates them in the context of improving the higher education system and the quality of teaching at the university. Various sources, such as research papers and official documents, were examined to explore the methodology of the educational process. The analysis of current methodologies revealed their effectiveness and competitiveness, as well as a high pace of development and the generation of new techniques that apply new technologies and scientific research. Results indicate a positive impact of these methodologies on the teaching quality and university environment, promoting a collaborative culture and the integration of digital technologies. The conclusion underscores the increasing significance of continuous faculty development and the alignment of educational standards with societal values, emphasizing a practical, competency-based approach to university teaching.},
 author = {Gadzaova, Ludmila and Mintsaev, Magomed and Gairabekov, Ibrahim and Alisultanova, Esmira and Maltsev, Tom},
 number = {100},
 pages = {28--32},
 title = {Professional competence of university teachers: experience and argumentation},
 volume = {20},
 year = {2024}
}
