@conference{Wu20184495,
 abstract = {The detection of built-up areas is essential for highresolution Synthetic Aperture Rader (SAR) applications, such as urban planning and environmental monitoring. In this paper, we proposed an attention based convolutional neural network for the detection of built-up areas in SAR images. Our network composes of two parts. First part contains two branches, one is designed to obtain high detection rate and the other one is designed to obtain low false alarm rate. Second part aims to merge the advantages of the two detection results of first part by using attention mechanism. Experiments on TerraSAR-X high resolution SAR images over Beijing demonstrate the effectiveness of proposed method. © 2018 IEEE.},
 author = {Wu, Yunfei and Zhang, Rong and Zhan, Yibing},
 doi = {10.1109/IGARSS.2018.8518463},
 journal = {International Geoscience and Remote Sensing Symposium (IGARSS)},
 note = {Cited by: 6},
 pages = {4495 - 4498},
 publication_stage = {Final},
 source = {Scopus},
 title = {Attention-based convolutional neural network for the detection of built-up areas in high-resolution SAR images},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85063129697?origin=resultslist},
 volume = {2018-July},
 year = {2018}
}
