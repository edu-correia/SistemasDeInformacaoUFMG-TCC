@inproceedings{5743156,
 abstract = {This paper presents a unicast and multicast solution to delivery digital television (DTV) services over Ethernet. In our solution, a new protocol stack is proposed to help implementation of DTV services over Ethernet link. We merged several key protocols: NHRP, RSVP, SBM and GMRP to realize unicast and multicast in our protocol operation. A simple quality of service (Qos) structure is provided in traffic control of nodes to achieve Qos requirements of DTV delivery. Finally, we give a short evaluation to Qos provisions and achieve good results.},
 author = {Jian-cun, Zuo and Qiu-dong, Sun and Xiao-dong, Huang},
 booktitle = {2010 International Conference on Intelligent System Design and Engineering Application},
 doi = {10.1109/ISDEA.2010.93},
 issn = {},
 keyword = {Digital TV;Ethernet networks;Transform coding;Delay;IP networks;Protocols;Quality of service;Unicast;Multicast;Digital television (DTV);Ethernet;quality of service (Qos)},
 month = {Oct},
 number = {},
 pages = {179-183},
 title = {A Unicast and Multicast Solution to Delivery DTV Services over Ethernet},
 volume = {1},
 year = {2010}
}
