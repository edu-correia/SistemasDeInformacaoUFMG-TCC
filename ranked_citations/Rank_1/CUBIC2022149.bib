 abstract = {The mind and the body are not separate, and fragmentation within health does not create ideal outcomes. Therefore, in the last decade the number of health care professionals advocating for integrated primary care (IPC), which merges medical services with behavioral seervices, has exploded. IPC emerged because primary care has been the de facto mental health system (Regier et al., 1993) for over three decades and continues to be so today, as most patients receive treatment for mental health and substance abuse services in the primary care setting. This trend to integrate behavioral health and primary care has increasingly been embraced in health care systems across the world (McDaniel and deGruy, 2014; SAMHSA-HRSA Center for Integrated Health Solutions, 2020; WHO, 2008).},
 address = {Oxford},
 author = {Barbara Cubic and Emma Katz},
 booktitle = {Comprehensive Clinical Psychology (Second Edition)},
 doi = {https://doi.org/10.1016/B978-0-12-818697-8.00055-8},
 edition = {Second Edition},
 editor = {Gordon J.G. Asmundson},
 isbn = {978-0-12-822232-4},
 keyword = {Integrated primary care, Primary care psychologist, Interdisciplinary teams, Interdisciplinary education},
 pages = {149-157},
 publisher = {Elsevier},
 title = {8.08 - Health Psychology in Primary Care},
 url = {https://www.sciencedirect.com/science/article/pii/B9780128186978000558},
 year = {2022}
}
