@article{Yang202329,
 abstract = {Images captured in low-light environments suffer from serious degradation due to insufficient light, leading to the performance decline of industrial and civilian devices. To address the problems of noise, chromatic aberration, and detail distortion for enhancing low-light images using existing enhancement methods, this paper proposes an integrated learning approach (LightingNet) for low-light image enhancement. The LightingNet consists of two core components: 1) the complementary learning sub-network and 2) the vision transformer (VIT) low-light enhancement sub-network. VIT low-light enhancement sub-network is designed to learn and fit the current data to provide local high-level features through a full-scale architecture, and the complementary learning sub-network is utilized to provide global fine-tuned features through learning transfer. Extensive experiments confirm the effectiveness of the proposed LightingNet. © 2015 IEEE.},
 author = {Yang, Shaoliang and Zhou, Dongming and Cao, Jinde and Guo, Yanbu},
 doi = {10.1109/TCI.2023.3240087},
 journal = {IEEE Transactions on Computational Imaging},
 note = {Cited by: 156},
 pages = {29 - 42},
 publication_stage = {Final},
 source = {Scopus},
 title = {LightingNet: An Integrated Learning Method for Low-Light Image Enhancement},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85148440191?origin=resultslist},
 volume = {9},
 year = {2023}
}
