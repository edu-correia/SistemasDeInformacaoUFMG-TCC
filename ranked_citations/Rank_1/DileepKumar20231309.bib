@article{DileepKumar20231309,
 abstract = {One of the main complications with Team Foundation Server (TFS) is that it was developed even before user experience was made a top priority. The interrelationship between the errors and failed tests even further complicates this process. We focus on improving the overall performance by minimizing the computational complexity in terms of runtime, error detection, and risk coverage. The main aim of this work is to balance the diversity of test cases and identify the error-prone test cases in the initial stage. Often the software delivery quality is compromised when we fully focus on-time efficiency. To overcome this problem, we are using an Ebola optimization search (EOS) algorithm to merge the risk-based and fault-based test case selection and a prioritization scheme. The EOS optimization technique is primarily used to identify test cases with the lowest execution time, the largest related risks, and the highest consecutive failure rate. The main novelty of this paper lies in the use of the EOS algorithm in automating continuous integration testing and offering support to the developers by predicting faulty test cases. In this way, the long cycle times are reduced, and the time can be efficiently balanced for continuous integration testing. We want to address this difficulty by investigating the previous runtime, the prior error detection mechanism for each test, and the role of the test case in lowering project risk. The efficiency of the proposed model is validated using a state-of-the-art comparative analysis. © 2023, The Author(s), under exclusive licence to Bharati Vidyapeeth's Institute of Computer Applications and Management.},
 author = {DileepKumar, S.R. and Mathew, Juby},
 doi = {10.1007/s41870-023-01217-7},
 journal = {International Journal of Information Technology (Singapore)},
 note = {Cited by: 14},
 number = {3},
 pages = {1309 - 1317},
 publication_stage = {Final},
 source = {Scopus},
 title = {Ebola optimization search algorithm for the enhancement of devops and cycle time reduction},
 type = {Article},
