@article{Wu20266655,
 abstract = {Game design for older adults (GDOA) is a multidisciplinary research area gaining attention in human-computer interaction (HCI), yet a comprehensive understanding of its current state and future directions remains limited. Through the visualized results by bibliometric methods, this study analyses the current state of GDOA research and identifies key research hotspots and emerging trends. Based on the Scopus and Web of Science (WoS) databases, Citespace and VOSviewer were employed to generate visual knowledge maps of publication volume, disciplinary distribution, high-impact countries, institutions, authors, frequent keywords, and highly cited references in the GDOA research field. The current research themes in GDOA focus on four main areas: Game and Experience Design for Older Adults, Exergames for Active Ageing in Older Adults, Serious Games for Cognitive and Mental Health, and Gamification Elements and Motivational Interventions. Finally, this study discusses the findings and suggests potential future research directions. © 2025 Taylor & Francis Group, LLC.},
 author = {Wu, Xingting and Chen, Yongkang and Guo, Mengyao},
 doi = {10.1080/10447318.2025.2506508},
 journal = {International Journal of Human-Computer Interaction},
 note = {Cited by: 2},
 number = {9},
 pages = {6655 - 6687},
 publication_stage = {Final},
 source = {Scopus},
 title = {Game Design for Older Adults: A Bibliometric Review of Trends and Future Directions},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105007437034?origin=resultslist},
 volume = {42},
 year = {2026}
}
