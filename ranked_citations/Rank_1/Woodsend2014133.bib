@article{Woodsend2014133,
 abstract = {Large-scale annotated corpora are a prerequisite to developing high-performance NLP systems. Such corpora are expensive to produce, limited in size, often demanding linguistic expertise. In this paper we use text rewriting as a means of increasing the amount of labeled data available for model training. Our method uses automatically extracted rewrite rules from comparable corpora and bitexts to generate multiple versions of sentences annotated with gold standard labels. We apply this idea to semantic role labeling and show that a model trained on rewritten data outperforms the state of the art on the CoNLL-2009 benchmark dataset. ©2014 AI Access Foundation. All rights reserved.},
 author = {Woodsend, Kristian and Lapata, Mirella},
 doi = {10.1613/jair.4431},
 journal = {Journal of Artificial Intelligence Research},
 note = {Cited by: 14; All Open Access; Gold Open Access},
 pages = {133 - 164},
 publication_stage = {Final},
 source = {Scopus},
 title = {Text rewriting improves semantic role labeling},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84907525338?origin=resultslist},
 volume = {51},
 year = {2014}
}
