@article{Giannakeas20121,
 abstract = {In this work, an efficient method for spot addressing in images, which are generated by the scanning of hexagonal structured microarrays, is proposed. Initially, the blocks of the image are separated using the projections of the image. Next, all the blocks of the image are processed separately for the detection of each spot. The spot addressing procedure begins with the detection of the high intensity objects, which are probably the spots of the image. Next, the Growing Concentric Hexagon algorithm, which uses the properties of the hexagonal grid, is introduced for the detection of the non-hybridized spots. Finally, the Voronoi diagram is applied to the centers of the detected spots for the gridding of the image. The method is evaluated using spots generated from the scanning of the Beadchip of Illumina, which is used for the detection of Single Nucleotide Polymorphisms in the human genome, and uses hexagonal structure for the location of the spots. For the evaluation, the detected centers for each of the spot in the image are compared to the centers of the annotation, obtaining up to 98% accuracy for the spot addressing procedure. © 2011 Elsevier Ireland Ltd.},
 author = {Giannakeas, Nikolaos and Kalatzis, Fanis and Tsipouras, Markos G. and Fotiadis, Dimitrios I.},
 doi = {10.1016/j.cmpb.2011.08.001},
 journal = {Computer Methods and Programs in Biomedicine},
 note = {Cited by: 15},
 number = {1},
 pages = {1 - 13},
 publication_stage = {Final},
 source = {Scopus},
 title = {Spot addressing for microarray images structured in hexagonal grids},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84857446051?origin=resultslist},
 volume = {106},
 year = {2012}
}
