@conference{Zhang20211,
 abstract = {Under the background of 'Internet Plus Education', this study designed a new chemistry classroom instructional model based on several theories. Then, an one-semester experiment was carried out on the 'Internet plus' typical school to prove the practical effect of the model, including experimental class (N=48) and control class (N=48). Results showed that, the new model significantly increased the students' problem-solving ability, while there was no significant difference between two classes' academic performances. To this end, we made a summary and recommendations about the model. © 2021 IEEE.},
 author = {Zhang, Yuanyuan and Yu, Liang and Shen, Chao and Wang, Jing},
 doi = {10.1109/EITT53287.2021.00010},
 journal = {Proceedings - 2021 10th International Conference of Educational Innovation through Technology, EITT 2021},
 note = {Cited by: 0},
 pages = {1 - 6},
 publication_stage = {Final},
 source = {Scopus},
 title = {The Design and Implementation of New Chemistry Classroom Instructional Model under the Condition of 'Internet Plus'},
 type = {Conference paper},
