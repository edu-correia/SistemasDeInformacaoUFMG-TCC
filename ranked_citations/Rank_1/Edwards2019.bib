@article{Edwards2019,
 abstract = {We present a technique for implementing dataflow networks as compositional hardware circuits. We first define an abstract dataflow model with unbounded buffers that supports data-dependent blocks (mux, demux, and nondeterministicmerge);we then showhowto faithfully implement such networkswith bounded buffers and handshaking. Handshaking admits compositionality: Our circuits can be connected with or without buffers, and combinational cycles arise only from a completely unbuffered cycle. While bounding buffer sizes can cause the system to deadlock prematurely, the system is guaranteed to produce the same, correct, data before then. Thus, unless the system deadlocks, inserting or removing buffers only affects its performance. We demonstrate how this enables design space to be explored. © 2019 Copyright held by the owner/author(s).},
 author = {Edwards, Stephen A. and Townsend, Richard and Barker, Martha and Kim, Martha A.},
 doi = {10.1145/3274280},
 journal = {ACM Transactions on Embedded Computing Systems},
 note = {Cited by: 14},
 number = {1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Compositional dataflow circuits},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85061216607?origin=resultslist},
 volume = {18},
 year = {2019}
}
