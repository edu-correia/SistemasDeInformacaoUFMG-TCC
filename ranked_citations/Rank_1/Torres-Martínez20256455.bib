 number = {8},
 pages = {6455 - 6476},
 publication_stage = {Final},
 source = {Scopus},
 title = {Bridging embodied cognition and AI: Agentive Cognitive Construction Grammar as a backing theory for neuro-symbolic AI},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105009332832?origin=resultslist},
