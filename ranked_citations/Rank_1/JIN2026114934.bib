@article{JIN2026114934,
 abstract = {Aspect-based sentiment analysis aims to identify the sentiment polarity of specific aspects within a sentence. Recent studies have demonstrated the advantages of integrating syntactic dependency structures with graph convolutional networks (GCN). However, existing approaches often overlook the deep interplay between semantic and syntactic information, leading to insufficient capture of sentiment expressions. To address this, we proposed a method for aspect-based sentiment analysis based on dual-channel interactive network with progressive fusion (DCIN), designed to thoroughly explore the dependencies between semantic and syntactic features. The proposed model achieves deep interaction of structural information from heterogeneous graphs by introducing a cooperative learning mechanism between the semantic and syntactic channels. To enable cross-channel interaction, we design a cross-attention-guided feature interaction module (CAFI) to dynamically capture explicit dependencies between semantic and syntactic representations, thereby enhancing cross-channel information flow. In parallel, to effectively integrate multi-layer representations within the graph convolutional network, we proposed a learning-driven fusion module (LFM), which gradually merges lower-level features with higher-level ones through interaction-aware optimization, ultimately generating a comprehensive representation tailored for sentiment polarity classification. Experimental results demonstrate that DCIN achieves state-of-the-art performance on six benchmark datasets, verifying its effectiveness in aspect-based sentiment analysis tasks.},
 author = {Song Jin and Nisuo Du and Qing He and Xiyin Wu and Wenjing Lei},
 doi = {https://doi.org/10.1016/j.asoc.2026.114934},
 issn = {1568-4946},
 journal = {Applied Soft Computing},
 keyword = {Aspect-based sentiment analysis, Natural language processing, Graph neural networks, Feature interaction, Feature fusion},
 pages = {114934},
 title = {DCIN: A dual-channel interactive network with progressive fusion for aspect-based sentiment analysis},
 url = {https://www.sciencedirect.com/science/article/pii/S1568494626003820},
 volume = {194},
 year = {2026}
}
