@article{JOSHI2026120515,
 abstract = {This paper presents PACE-Net (Progressive Attention and Convolutional Embedding Network), a novel deep learning architecture designed for fine-grained classification of wall surface defects. Accurately identifying subtle wall surface defects is critical for structural maintenance, especially across varied materials, aging conditions, and environments; limited computational resources further complicate this task. This work proposes an efficient deep learning architecture that balances precision and computational cost for real-world applications. PACE-Net combines progressive attention, shifted depth-wise convolutions, and dynamic patch merging to capture both global context and fine detail for accurate defect recognition. A multi-stream fusion framework dynamically integrates complementary features from attention, convolutional, and residual streams. This adaptive fusion boosts the robustness of the model in distinguishing six defect categories as well as normal surfaces under varying conditions. The model achieves 98.04% accuracy on a diverse surface defect dataset, with only 161 k parameters and 16.07  ms inference latency. Grad-CAM visualizations support interpretable defect localization for deployment in real-world inspections across diverse materials, structural ages, and lighting conditions. Grad-CAM-based localization achieved a mean IoU of 0.8210, while Monte Carlo dropout-based uncertainty analysis confirmed high prediction reliability under variable lighting and viewpoint conditions. The combination of progressive attention, shifted convolutions, dynamic patch merging, and adaptive multi-stream fusion establishes PACE-Net22Source Code and Model are publicly available at https://github.com/rakeshchandrajoshi/PACE-Net as an efficient and powerful solution for real-time infrastructure inspection, enabling high-precision defect classification across common construction materials and surface types.},
 author = {Rakesh Chandra Joshi and Abhishek Kaushal and Manob Jyoti Saikia and Radim Burget and Malay Kishore Dutta},
 doi = {https://doi.org/10.1016/j.measurement.2026.120515},
 issn = {0263-2241},
 journal = {Measurement},
 keyword = {Dynamic patch merging, Fine-grained classification, Grad-CAM visualization, Progressive attention, Resource efficient neural networks, Surface defect classification},
 pages = {120515},
 title = {PACE-Net: progressive attention and convolutional embedding network with dynamic patch merging for real-time fine-grained infrastructure surface defect detection},
 url = {https://www.sciencedirect.com/science/article/pii/S0263224126002241},
 volume = {266},
 year = {2026}
}
