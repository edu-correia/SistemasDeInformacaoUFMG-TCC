@article{BOZORGI2025105897,
 abstract = {Changes in seismic velocity within carbonate rocks are influenced by various parameters, among which the pore aspect ratio holds particular significance. The actual pore aspect ratio varies with depth, while it may not be possible to have thin sections for the entire depth interval. Therefore, a constant aspect ratio is often considered in rock physics modeling. Since carbonate formations are geologically complex and highly heterogeneous due to diagenetic and facies-related variations, fixed aspect ratio models often fail to reflect the actual pore structure, leading to inaccuracies in velocity modeling. This study addresses this challenge by introducing a new method based on tortuosity analysis for estimating depth-variable pore aspect ratio. We applied the most used rock physics model for the carbonate reservoirs and improved the estimation of shear and compressional velocities by utilizing the log of pore aspect ratio. Initially, a supervised decision tree method was used to estimate the tortuosity log from conventional well logs. Then, using the concept of permeability, we related the tortuosity log to the pore aspect ratio, obtaining a depth-variable aspect ratio. Subsequently, the calculated pore aspect ratio log was added to the rock physics model for velocity prediction. Our results demonstrate that incorporating a variable aspect ratio significantly improves the prediction of both compressional and shear wave velocities compared to the Gassmann model and the traditional Xu-White model, which assumes a constant aspect ratio. The proposed method yielded lower RRMSE values: 10.62 % for compressional and 12.56 % for shear velocities, indicating its effectiveness and reliability for rock physics modeling in carbonate environments.},
 author = {Fatemeh Bozorgi and Reza Falahat and Majid Nabi Bidhendi and Morteza Azadpour},
 doi = {https://doi.org/10.1016/j.jappgeo.2025.105897},
 issn = {0926-9851},
 journal = {Journal of Applied Geophysics},
 keyword = {Rock physics modeling, Aspect ratio, Tortuosity factor, Pore type, Velocity estimation},
 pages = {105897},
 title = {Introducing the resistivity-based algorithm to estimate pore aspect ratio in carbonate rock physics modeling},
 url = {https://www.sciencedirect.com/science/article/pii/S0926985125002782},
 volume = {242},
 year = {2025}
}
