@inproceedings{1015082,
 abstract = {A ferroelectric-based functional pass-gate is proposed for low-power logic-in-memory VLSI which makes communication bottlenecks free. Since non-destructive storage and switching functions are merged into a ferroelectric capacitor, active-device counts become small, which reduces the dynamic power dissipation. The use of ferroelectric-based non-volatile storage makes leakage currents cut off. Applying the ferroelectric-based circuitry to binary CAM implementation results in about half dynamic power reduction and 1/22000 static power reduction, compared to a. CMOS implementation under 0.6 /spl mu/m ferroelectric/CMOS.},
 author = {Kimura, H. and Hanyu, T. and Kameyama, M. and Fujimori, Y. and Nakamura, T. and Takasu, H.},
 booktitle = {2002 Symposium on VLSI Circuits. Digest of Technical Papers (Cat. No.02CH37302)},
 doi = {10.1109/VLSIC.2002.1015082},
 issn = {},
 keyword = {Very large scale integration;Ferroelectric materials;Capacitors;Power dissipation;Leakage current;CMOS memory circuits;Logic arrays;Logic circuits;Computer aided manufacturing;CADCAM},
 month = {June},
 number = {},
 pages = {196-199},
 title = {Ferroelectric-based functional pass-gate for low-power VLSI},
 volume = {},
 year = {2002}
}
