@article{10.1145/3546749,
 abstract = {In this paper, we present EatingTrak, an AI-powered sensing system using a wrist-mounted inertial measurement unit (IMU) to recognize eating moments in a near-free-living semi-wild setup. It significantly improves the SOTA in time resolution using similar hardware on identifying eating moments, from over five minutes to three seconds. Different from prior work which directly learns from raw IMU data, it proposes intelligent algorithms which can estimate the arm posture in 3D in the wild and then learns the detailed eating moments from the series of estimated arm postures. To evaluate the system, we collected eating activity data from 9 participants in semi-wild scenarios for over 113 hours. Results showed that it was able to recognize eating moments at three time-resolutions: 3 seconds and 15 minutes with F-1 scores of 73.7% and 83.8%, respectively. EatingTrak would introduce new opportunities in sensing detailed eating behavior information requiring high time resolution, such as eating frequency, snack-taking, on-site behavior intervention. We also discuss the opportunities and challenges in deploying EatingTrak on commodity devices at scale.},
 address = {New York, NY, USA},
 articleno = {214},
 author = {Zhang, Ruidong and Zhang, Jihai and Gade, Nitish and Cao, Peng and Kim, Seyun and Yan, Junchi and Zhang, Cheng},
 doi = {10.1145/3546749},
 issue_date = {September 2022},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {wrist-mounted imu, neural networks, eating detection, arm posture estimation},
 month = {September},
 number = {MHCI},
 numpages = {22},
 publisher = {Association for Computing Machinery},
 title = {EatingTrak: Detecting Fine-grained Eating Moments in the Wild Using a Wrist-mounted IMU},
 url = {https://doi.org/10.1145/3546749},
 volume = {6},
