@article{Zhu2007375,
 abstract = {With the merge of digital television (DTV) and the exponential growth of broadcasting network, an overwhelmingly amount of information has been made available to a consumer's home. Therefore, how to provide consumers with the right amount of information becomes a challenging problem. In this paper, we propose an electronic programming guide (EPG) recommender based on natural language processing techniques, more specifically, text classification. This recommender has been implemented as a service on a home network that facilitates the personalized browsing and recommendation of TV programs on a portable remote device. Evaluations of our Maximum Entropy text classifier were performed on multiple categories of TV programs, and a near 80% retrieval rate is achieved using a small set of training data. © World Scientific Publishing Company.},
 author = {Zhu, Jingbo and Ma, Matthew Y. and Guo, Jinhong K. and Wang, Zhenxing},
 doi = {10.1142/S0218001407005399},
 journal = {International Journal of Pattern Recognition and Artificial Intelligence},
 note = {Cited by: 6},
 number = {2},
 pages = {375 - 395},
 publication_stage = {Final},
 source = {Scopus},
 title = {Content classification and recommendation techniques for viewing electronic programming guide on a portable device},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/34147152286?origin=resultslist},
 volume = {21},
 year = {2007}
}
