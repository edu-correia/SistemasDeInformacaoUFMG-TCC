@inproceedings{4806566,
 abstract = {3D models of large-scale scenes available on the Internet today are largely manually created. Thus it takes a long time to create them for cities and update them as those cities that are already modeled continue to change. Multiple parallel-perspective mosaics can be generated from video automatically and more efficiently and can be used to reconstruct 3D scenes faster. A lot of video currently exists on the Internet, many of which are of aerial scenes that are currently not being utilized to their full potential. Reconstructing scenes from video provides the benefit of containing dynamic activity and texture information of the scenes in addition to the 3D structure data.},
 author = {Molina, Edgardo and Tang, Hao and Zhu, Zhigang and Mendoza, Olga},
 booktitle = {2008 IEEE National Aerospace and Electronics Conference},
 doi = {10.1109/NAECON.2008.4806566},
 issn = {2379-2027},
 keyword = {Large-scale systems;Layout;Internet;Image fusion;Mutual information;Positron emission tomography;Image analysis;Entropy;Measurement;Image registration},
 month = {July},
 number = {},
 pages = {322-329},
 title = {Mosaic-based Modeling and Rendering of Large-Scale Dynamic Scenes for Internet Applications},
 volume = {},
 year = {2008}
}
