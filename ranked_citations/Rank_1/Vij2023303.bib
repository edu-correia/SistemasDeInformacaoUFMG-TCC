@article{Vij2023303,
 abstract = {Natural Language Processing (NLP) and its related applications have come a long way since its initiation. A number of NLP-based applications can be spotted in our day-to-day lives. NLP has been widely discussed in the literature for various Indian languages as well. Hindi language-based NLP has gained popularity in recent years. This paper tries to focus on having a retrospective inspection of the trends of NLP research in Hindi using fuzzy logic, in terms of the paper publication. An in-depth study has been done of the concerned research papers in this field. The publication pattern is also identified along with the key terms. © 2023, The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd.},
 author = {Vij, Sonakshi and Virmani, Deepali and Jain, Amita},
 doi = {10.1007/978-981-19-5331-6_32},
 journal = {Lecture Notes in Networks and Systems},
 note = {Cited by: 2},
 pages = {303 - 309},
 publication_stage = {Final},
 source = {Scopus},
 title = {Retrospective Inspection for Research in Natural Language Processing of Hindi Language Using Fuzzy Logic},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85142744752?origin=resultslist},
 volume = {520},
 year = {2023}
}
