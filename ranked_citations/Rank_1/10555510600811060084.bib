@article{10.5555/1060081.1060084,
 abstract = {This panel is concerned with the diminished representation of digital logic in the undergraduate Computer Science curriculum. The number of core hours allocated to digital logic and digital systems topics has been significantly decreased, and shifted to assembly level architecture topics, and assembly language. Given this situation, it is reasonable to ask: How important is digital logic to future Computer Scientists? The panel begins by taking up this question. For those who maintain, that digital logic is critical, the panel considers how to provide more coverage, the value of digital logic labs, and a balance with assembly language programming.},
 address = {Evansville, IN, USA},
 author = {Connelly, Richard and Gousie, Michael B. and Hadimioglu, Haldun and Ivanov, Lubomir and Hoffman, Mark},
 issn = {1937-4771},
 issue_date = {May 2004},
 journal = {J. Comput. Sci. Coll.},
 month = {May},
 number = {5},
 numpages = {4},
 pages = {5–8},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {The role of digital logic in the computer science curriculum},
 volume = {19},
 year = {2004}
}
