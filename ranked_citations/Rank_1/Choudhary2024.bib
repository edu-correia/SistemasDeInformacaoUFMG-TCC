@article{Choudhary2024,
 abstract = {Security of biometric attributes, being permanent and non-renewable, is a priority in designing multimodal authentication systems. This research aims to achieve balanced authentication performance in terms of accuracy, template security, and time complexity using multiple biometric data. In this article, a two-layer hybrid template security scheme is proposed with implementation on the combination of face and finger vein modalities. Template security involves transformation of fused features using randomly generated Gaussian projection matrices and index-of-max–min hashing. A second layer of binary key-based merge hashing enhances template robustness. This method improves pre-image attack resilience without increasing template formation complexity. By employing simple, texture-based, highly discriminant, and dimensionally reduced features, we reduce authentication time complexity with quick integer-based collision matching. The outperformance of the proposed method is shown over previous similar methods for authentication with stagewise time cost requirement. Significant authentication performance with real time operation is observed. The proposed scheme generates cancelable, unlinkable, and highly non-invertible templates, protected from pre-image attacks, and applicable to any real-valued feature set. The multimodal system, using a contactless biometric combination, is particularly suitable for contagious environments. Performance evaluation on the SDUMLA-HMT real multimodal database and a chimeric dataset (LFW + UTFVP) demonstrates significant authentication effectiveness and template security, with comparative analysis against similar works. This research highlights a practical, robust solution for secure and efficient biometric authentication. © The Author(s), under exclusive licence to Springer Nature Singapore Pte Ltd. 2024.},
 author = {Choudhary, Swati K. and Naik, Ameya K.},
 doi = {10.1007/s42979-024-03148-x},
