@inproceedings{7867013,
 abstract = {In this paper, we propose a bottom-up point cloud segmentation method, which utilizes a hierarchical clustering structure combined with the perceptual grouping laws. Our method allows a learning-free and completely automatic but parametric process for segmenting point clouds of 3D outdoor scenes. The experiments using terrestrial laser scanning dataset have demonstrated that our proposed method can achieve good results, especially for complex scenes and nonplanar surfaces of objects. The quantitative comparison between our method and the region growing based method also confirms the effectiveness and efficiency of our method.},
 author = {Xu, Yusheng and Tuttas, Sebastian and Stilla, Uwe},
 booktitle = {2016 9th IAPR Workshop on Pattern Recogniton in Remote Sensing (PRRS)},
 doi = {10.1109/PRRS.2016.7867013},
 issn = {},
 keyword = {Three-dimensional displays;Solid modeling;Mathematical model;Clustering algorithms;Image reconstruction;Computational efficiency;Surface reconstruction;point cloud; outdoor scene segmentation; hierarchical clustering; perceptual grouping laws},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {Segmentation of 3D outdoor scenes using hierarchical clustering structure and perceptual grouping laws},
 volume = {},
 year = {2016}
}
