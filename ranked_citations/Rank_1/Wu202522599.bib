@article{Wu202522599,
 abstract = {Recent advancements in wireless communications have revolutionized healthcare delivery through Internet of Everything (IoE) connectivity, yet achieving precise medical device positioning and reliable patient monitoring remains a fundamental challenge. As communication frequencies increase and reconfigurable intelligent surface (RIS) apertures expand in healthcare settings, the operating conditions gradually transition from traditional far-field (FF) radiation patterns to near-field (NF) scenarios. This article proposes a healthcare channel hybrid model (HCHM) framework that seamlessly integrates NF and FF characteristics. The weighting factor adapts dynamically according to the ratio of near-field to FF route gains, facilitating appropriate tradeoffs between positioning precision and monitoring coverage. We present a complete channel model tailored for healthcare IoE applications by incorporating an adaptive weighting factor that accounts for the proximity and placement needs of medical devices. Based on 10 000 Monte Carlo simulations in a typical hospital environment (30×30 RIS array, 100-MHz bandwidth, 2–200 m monitoring range), with 95% confidence intervals, HCHM achieves positioning accuracies of 0.3 ± 0.02 mm in critical care scenarios maintaining reliable patient monitoring across extended distances. Simulation results demonstrate that HCHM achieves significant improvements in system performance and model robustness, with positioning accuracy enhanced by 45% and monitoring reliability improved by 42% compared to conventional approaches, making it particularly suitable for next-generation healthcare IoE applications. © 2014 IEEE.},
 author = {Wu, Yue and Chu, Haitao and Zhou, Hongxu and Ma, Xiaodi},
 doi = {10.1109/JIOT.2025.3548840},
 journal = {IEEE Internet of Things Journal},
 note = {Cited by: 3},
 number = {13},
 pages = {22599 - 22609},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Hybrid Near-Far Field Channel Model for RIS-Assisted Healthcare Monitoring and Precision Positioning in Internet of Everything},
 type = {Article},
