@conference{Mohamed2019,
 abstract = {Image segmentation is a crucial step in any image analysis process. It consists in preparing the image to make it more usable by an automatic process, such interpreting and understanding its content. In this paper, we introduce a novel method for range image segmentation. The proposed method proceeds by adapting the principle of the Canny filter, commonly utilized for greyscale and colour images, to be applied for range images, where depths in these images should be differently handled. Instead of using raw image data, a new image of angles between normal vectors according some given directions is computed and then used to compute a new gradient image. Canny steps are then applied on the latter image, producing precise and well located edges. Experimentation on real images from the ABW database shows that edges in range images are correctly detected. © 2019 IEEE.},
 author = {Mohamed, Cheribet and Smaine, Mazouzi},
 doi = {10.1109/ICTAACS48474.2019.8988126},
 journal = {2019 International Conference on Theoretical and Applicative Aspects of Computer Science, ICTAACS 2019},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Edge Detection in Range Images Using a Modified Canny Filter},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85080930826?origin=resultslist},
 year = {2019}
}
