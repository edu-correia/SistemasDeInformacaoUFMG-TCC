@article{ZHANG2025137963,
 abstract = {The electrochemical and battery characteristics of aqueous zinc ion batteries (ZIBs) are significantly influenced by their cathode material. Herein, a sodium vanadate/Mxene (NVO/MX) nanocomposite was successfully synthesized through the combination and cooperation of two-dimensional (2D) MX nanosheets and one-dimensional (1D) NVO nanowires. To highlight its performance, NVO/MX, when serving as the cathode material in ZIBs, exhibits outstanding rate capability and an impressive reversible capacity of 138.3 mAh/g after 2000 cycles at 0.1 A/g, retaining 94.5 % of its initial discharge capacity. This work indicates that NVO/MX is a promising candidate for use as a cathode material in ZIBs.},
 author = {Jingjing Zhang and Shuo Li and Libing Hu and Hailong Ma and Mengling Luo and Fan Zhang and Jikui Zhu},
 doi = {https://doi.org/10.1016/j.matlet.2024.137963},
 issn = {0167-577X},
 journal = {Materials Letters},
 keyword = {Zn-ion battery, Cathode material, Sodium vanadate, MXene},
 pages = {137963},
 title = {Sodium vanadate/Mxene nanocomposite cathode for aqueous zinc ion batteries},
 url = {https://www.sciencedirect.com/science/article/pii/S0167577X24021037},
 volume = {382},
 year = {2025}
}
