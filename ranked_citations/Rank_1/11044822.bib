@inproceedings{11044822,
 abstract = {Sparse matrix-vector multiplication (SpMV) is a fundamental operation with a wide range of applications in scientific computing and artificial intelligence. However, the large scale and sparsity of sparse matrix often make it a performance bottleneck. In this paper, we highlight the effectiveness of hash-based techniques in optimizing sparse matrix reordering, introducing the Hash-based Partition (HBP) format, a lightweight SpMV approach. HBP retains the performance benefits of the 2Dpartitioning method while leveraging the hash transformation's ability to group similar elements, thereby accelerating the preprocessing phase of sparse matrix reordering. Additionally, we achieve parallel load balancing across matrix blocks through a competitive method. Our experiments, conducted on both Nvidia Jetson AGX Orin and Nvidia RTX 4090, show that in the preprocessing step, our method offers an average speedup of 3.53 times compared to the sorting approach and 3.67 times compared to the dynamic programming method employed in Regu2D. Furthermore, in SpMV, our method achieves a maximum speedup of 3.32 times on Orin and 3.01 times on RTX4090 against the CSR format in sparse matrices from the University of Florida Sparse Matrix Collection.},
 author = {Yan, Chen and Diao, Boyu and Liu, Hangda and An, Zhulin and Xu, Yongjun},
 booktitle = {2025 IEEE 25th International Symposium on Cluster, Cloud and Internet Computing (CCGrid)},
 doi = {10.1109/CCGRID64434.2025.00053},
 issn = {2993-2114},
 keyword = {Cloud computing;Scientific computing;Optimization methods;Load management;Dynamic programming;Sparse matrices;Artificial intelligence;Sorting;SpMV;Hash;2D-partitioning;Competitive Method},
 month = {May},
 number = {},
 pages = {1-10},
 title = {A Nonlinear Hash-Based Optimization Method for SpMV on GPUs},
 volume = {},
 year = {2025}
}
