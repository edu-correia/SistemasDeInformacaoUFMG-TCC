@conference{Shen2024713,
 abstract = {Deep learning-based methods provide a non-invasive, efficient, and convenient approach for diagnosing Alzheimer's disease (AD). However, most deep learning approaches concentrate on single-modal data, leading to instability in capturing disease traits and neglecting the multimodal aspects essential for accurate medical diagnosis in Alzheimer's disease. Secondly, current multimodal methods exhibit relatively independent feature extraction processes for each modality and lack low-level feature interactions, thus limiting the expressive power of the features, thereby affecting the model's performance. Furthermore, contemporary research on multimodality often employs a single scale to model brain features, hindering the adequate perception of local disease information within the brain. To overcome these challenges, we introduce a Multimodal Fusion Model with Attention (MFMA) for diagnosing Alzheimer's disease. This framework utilizes a self-attention mechanism to merge the global features of both imaging modalities within their respective feature extraction pathways. By doing so, it facilitates a thorough multiscale integration of features from both imaging modalities, while also incorporating clinical indicator data from the patient to arrive at a final diagnosis. Experiments on the ADNI dataset demonstrate that the proposed method is highly competitive compared to current approaches.  © 2024 IEEE.},
 author = {Shen, Maoxin and Li, Weimin and Wang, Jingchao},
 doi = {10.1109/SWC62898.2024.00126},
 journal = {Proceedings - 2024 IEEE Smart World Congress, SWC 2024 - 2024 IEEE Ubiquitous Intelligence and Computing, Autonomous and Trusted Computing, Digital Twin, Metaverse, Privacy Computing and Data Security, Scalable Computing and Communications},
 note = {Cited by: 0},
 pages = {713 - 720},
 publication_stage = {Final},
 source = {Scopus},
 title = {AMMFNet: An Attention-Based Multimodal Multiscale Fusion Framework for Alzheimer's Disease Diagnosis},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105002219538?origin=resultslist},
 year = {2024}
}
