@inproceedings{11362371,
 abstract = {The frequent and excessive usage of electronic gadgets among Indian students has become a growing concern, often leading to issues like poor performance in academics, reduced social interaction, and mental stress. This study focuses on building a machine learning-based system that can identify students who may be at risk of developing gadget addiction. Using responses from over $\mathbf{3, 4 5 0}$ students collected via a structured Google Form questionnaire, the system analyzes behavioral and psychological patterns related to gadget usage. The RF algorithm was used to train the model, which achieved over 91.40 % accuracy, 90.50 % precision, 91.55 % recall, and 91.22 % F1-score are the attributes that were chosen for the model from among those that were available in classifying students into low, moderate, or highrisk levels. The system was integrated into a web application that allows students to take a short quiz and instantly receive their predicted addiction risk, along with useful tips for improvement. By offering early warning signs and personalized suggestions, this model can help students, parents, and educators better understand digital habits and take steps to improve digital well-being.},
 author = {Chouhan, Arun Singh and Priyanka, R M},
 booktitle = {2025 IEEE 4th International Conference for Advancement in Technology (ICONAT)},
 doi = {10.1109/ICONAT66879.2025.11362371},
 issn = {},
 keyword = {Accuracy;Machine learning algorithms;Addiction;Merging;Psychology;Machine learning;Predictive models;Predictive analytics;Classification tree analysis;Videos;Gadget addiction;Machine learning;Student behavior;RF;Behavioral prediction;Web-based assessment;Digital well-being;Risk classification},
 month = {Sep.},
 number = {},
 pages = {1-7},
 title = {Predictive Analytics for Digital Well-Being: Machine Learning Model for Indian Student Gadget Addiction},
 volume = {},
 year = {2025}
