@inproceedings{10115149,
 abstract = {In this paper, the open instruction set architecture for the symmetric overloaded minimal instruction set computer architecture (SOMA) is presented. There are only two instruction classes for the architecture. MISC architectures date back to 1949 with the Manchester Mark 1 developed by The Victoria University of Manchester.Linux operating system began the trend towards open architectures in 1991. Open instruction set architectures and open hardware started with the open and extendable RISC-V instruction set in 2012. With the development of the RISC-V instruction set architecture, there has been renewed interest in researching microprocessor architecture fundamentals.Unlike high level languages, there is no standard format for assembly languages. The various architectures, x86, MIPS, ARM, RISC-V, et al., each have their own dialects. Multiple addressing modes add to the difficulty. An assembly language format simplifying instruction classes and using simple statements would significantly improve understanding.For the SOMA architecture, register-to-register and integer classes are merged into a single class: register-integer (RI). RI follows a simple format: R1 = R2 + R3 and R1 = R2 + constant. The branch instruction class is a C-like ${\text{if}}\{ \} $ statement. A branch always instruction replaces the traditional jump instruction class. This paper presents an overview of the SOMA Architecture.},
 author = {Jungwirth, Patrick and Scott, Andrew and Xiao, Zhigang},
 booktitle = {SoutheastCon 2023},
 doi = {10.1109/SoutheastCon51012.2023.10115149},
 issn = {1558-058X},
 keyword = {Codes;Reduced instruction set computing;Instruction sets;Microprocessors;Operating systems;Computer architecture;Market research;Minimal instruction set computer (MISC);symmetric overloaded MISC architecture;SOMA;RISC.},
 month = {April},
 number = {},
 pages = {53-59},
 title = {Alabama A&M Symmetric Overloaded Minimal Instruction Set Architecture (SOMA)},
