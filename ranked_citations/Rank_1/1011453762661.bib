@article{10.1145/3762661,
 abstract = {Heterogeneous platforms combining CPUs and DSPs offer the potential for energy-efficient computing but are difficult to program. OpenCL enables code portability across processors but does not guarantee performance portability on DSPs due to the unique challenges in barrier synchronization and local memory management. This article introduces OctoCL, a compiler-based framework that addresses these challenges through two key optimizations: (1) a recomputation-based variable expansion technique to reduce barrier synchronization overhead, and (2) automatic merging of memory access patterns into DSP-DMA operations for efficient data transfers. We evaluate OctoCL using 18 OpenCL benchmarks from the Parboil and Rodinia suites. Experimental results show that OctoCL achieves an average speedup of 1.46\texttimes{} (up to 3.36\texttimes{}) over the baseline OpenCL compiler on the FT-M7032 CPU-DSP platform. These optimizations enhance performance portability while preserving backward compatibility, requiring no manual code modifications.},
 address = {New York, NY, USA},
 articleno = {120},
 author = {Gao, Wanrong and Fang, Jianbin and Zhang, Peng and Huang, Chun and Wang, Ting and Ren, Jie},
 doi = {10.1145/3762661},
 issn = {1544-3566},
 issue_date = {December 2025},
 journal = {ACM Trans. Archit. Code Optim.},
 keyword = {OpenCL compiler, performance portability, multi-core DSP},
 month = {December},
 number = {4},
 numpages = {26},
 publisher = {Association for Computing Machinery},
 title = {Optimizing OpenCL Barrier Synchronization and Memory Efficiency on Multi-Core DSPs},
 url = {https://doi.org/10.1145/3762661},
 volume = {22},
 year = {2025}
}
