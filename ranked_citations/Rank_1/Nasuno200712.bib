@article{Nasuno200712,
 abstract = {Recently, the use of VoIP, which is a voice communication service based on an IP network, has been spreading rapidly. However, the quality of service of VoIP has not currently reached the quality of service of a conventional circuit-switched network due to the technical features of an IP network. For IP networks to replace conventional circuit-switched networks in the future, various types of present-day problems must be resolved. Therefore, the authors propose a method of performing admission control for VoIP call setup requests to assure voice quality according to management of the number of VoIP sessions based on the assumption that the quality of a fixed capacity is assured according to VoIP priority control in addition to the packet-level quality provisions of ITU-T Recommendation Y. 1541. They also show experimental results concerning the VoIP quality of service measurement indices required by this proposal, the effectiveness of admission control, and the monitor for the number of VoIP sessions and discuss contributions to standardization for promoting more wide-spread use of the VoIP quality assurance method. © 2006 Wiley Periodicals, Inc.},
 author = {Nasuno, Yutaka and Konno, Susumu and Iwaya, Yukio and Kinoshita, Tetsuo and Arai, Ken Ichi},
 doi = {10.1002/ecja.20331},
 journal = {Electronics and Communications in Japan, Part I: Communications (English translation of Denshi Tsushin Gakkai Ronbunshi)},
 note = {Cited by: 2; All Open Access; Bronze Open Access},
 number = {2},
 pages = {12 - 22},
 publication_stage = {Final},
 source = {Scopus},
 title = {A proposal of VoIP quality assurance method by admission control},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33751189359?origin=resultslist},
 volume = {90},
 year = {2007}
}
