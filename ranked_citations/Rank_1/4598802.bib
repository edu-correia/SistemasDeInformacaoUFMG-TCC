@inproceedings{4598802,
 abstract = {In this paper, we propose an extension of two dimensions (2D) code cardinality. The code, developed for optical code division multiple access (OCDMA) system is generated by: merged M-sequences for the frequency hopping (in this work we consider the optical fast frequency hopping technique: OFFH) and the hyperbolic code for the time spreading. For familiespsila codes, minimum cross-correlation constraint (lambdac= 1) is applied to decrease the multiple access interference (MAI). Compared with the 2D code employing prime code for the time spreading, the extension will increase the cardinality to P(P - 1)2 users (proposed code) instead of P2 users.},
 author = {Ferchichi, Moez and Najjar, Monia and Rezig, Houriya},
 booktitle = {2008 10th Anniversary International Conference on Transparent Optical Networks},
 doi = {10.1109/ICTON.2008.4598802},
 issn = {2162-7339},
 keyword = {Time frequency analysis;Fiber optics;Optical fibers;Integrated optics;Bit error rate;Fiber gratings;Decoding;Optical Fast Frequency hopping (OFFH);optical code division multiple access (OCDMA);Multiple Access Interference (MAI);Fiber-Bragg gratings (FBG)},
 month = {June},
 number = {},
 pages = {324-327},
 title = {OFFH-CDMA code for WDM network developed with Merged M-sequence/hyperbolic code},
 volume = {4},
 year = {2008}
}
