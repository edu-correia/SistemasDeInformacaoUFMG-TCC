@article{MANJENGWA2026101736,
 abstract = {Significant threats tied to prevalent narratives comprising Environmental, Social and Governance (ESG) pressures, and risk tied to the orebody, impact the viability and legitimacy of the mining industry. Further, inadequately addressed loopholes across the mining value chain amplify the impact of the risks companies are exposed to. To address the existential threats confronting mining companies, geometallurgy allows practitioners to enhance exploitation of an ore body through improved knowledge sharing, enhanced predictability of process performance and mine waste management. In this regard the authors present a review that examines how the incorporation of Environmental, Social and Governance (ESG) metrics within geometallurgical approaches can reinforce mining company legitimacy. Through an assessment of the relationship between company performance, reputation and risk management, the authors demonstrate that incorporating ESG metrics into geometallurgical programs holds immense potential for enhancing sustainability performance and driving responsible mining practices. The review reveals that scope exists to incorporate these metrics within geometallurgical approaches, however the challenges associated with technical complexity, data quality, organizational silos, and resource constraints require careful consideration and strategic management. By emphasising the need for a holistic approach to ESG integration, technical, organizational, and operational challenges will be resolved through investments in data infrastructure, manpower upskilling, and stakeholder engagement initiatives. The discourse is aimed at contributing towards an accelerated adoption of geometallurgical principles across the industry, to maximise value accretion for all stakeholders concerned and long-term positive performance impacts, against a backdrop of pressures located in the business environment.},
 author = {Evelyn Ruvimbo Manjengwa and Bjorn P von der Heyden and Margreth Tadie},
 doi = {https://doi.org/10.1016/j.sftr.2026.101736},
 issn = {2666-1888},
 journal = {Sustainable Futures},
 keyword = {Economic, Environmental Social & Governance (ESG), Globalisation, Geometallurgy, Ore variability, Risk},
 pages = {101736},
 title = {The marriage of ESG & Geometallurgy: Reinforcing mining company legitimacy in a sustainability driven dispensation – A review},
 url = {https://www.sciencedirect.com/science/article/pii/S2666188826000948},
 volume = {11},
 year = {2026}
}
