@conference{Liu20123004,
 abstract = {In this paper we present a polynomial process algebra (PPA) like basic process algebra which can be used to model both polynomial behavior of parallel systems. It provides a nature framework for the concurrent composition systems, and can deal with the nondeterministic behavior. This process algebra is obtained by the polynomial transition systems which we defined. In this paper we concentrate on giving the syntax and semantic, and meanwhile defining the bisimulation equivalence. In the last we give an example to illustrate it. © 2012 IEEE.},
 author = {Liu, Bai and Wu, Jinzhao},
 doi = {10.1109/WCICA.2012.6358386},
 journal = {Proceedings of the World Congress on Intelligent Control and Automation (WCICA)},
 note = {Cited by: 0},
