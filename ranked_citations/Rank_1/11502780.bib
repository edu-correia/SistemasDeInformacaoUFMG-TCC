@inproceedings{11502780,
 abstract = {This paper is aimed at demonstrating a useful hybrid model, which can be employed to enhance the accuracy and generalizability of sentiment classification across text domains. Conventional methods of sentiment analysis do not effectively classify text because of language differences across domains and other nuances in domain-specific data sets; therefore, such models are not consistently good at classifying such data sets. To address this weakness, A special classification pipeline has been designed, merge the current embedding methods that are transformer-based with the classic boosting method called the gradient boosting to give a better and simpler method of classification. To develop a specialized method of categorization, Applied two steps; (i) applying the DeBERTa-v3 architecture to extract in-depth contextual embeddings to different types of texts, which is useful in seizing delicate semantic associations, and (ii) establishing improved decision limits in the application of LightGBM (Light Gradient Boosted Machine). Tested hybrid framework on two real-world data sets, that is, IMDb and Yelp reviews dataset which proved that hybrid model achieved overall accuracy of 90.90 which showed significant improvements over the existing traditional models (TF-IDF, linear classifiers). The findings indicate that the effectiveness of sentiment analysis through the combination of deep-transformer embedding and effective boosting algorithms is an efficient; hence, no large-scale computational abilities of fine-tuning a complete model are required.},
 author = {Dhiman, Diksha and Asha, V. and Vasumathi, M T and H, Vinay B and Kumar, Vinay and Patgar, Vinayak V},
 booktitle = {2026 9th International Conference on Intelligent Computing and Control Systems (ICICCS)},
 doi = {10.1109/ICICCS67901.2026.11502780},
 issn = {},
 keyword = {Feeds;Motion pictures;Broadcasting;Filtering;Feedback;Filters;Circuits;Circuits and systems;Protocols;HTTP;Sentiment Analysis (SA);Natural Language Processing (NLP);DeBERTa-v3;Light Gradient Boosting Machine (LightGBM);Transformer-Based Embeddings;Gradient Boosted Decision Trees (GBDT);Multi-Domain Text Classification;Contextual Language Models (CLM)},
