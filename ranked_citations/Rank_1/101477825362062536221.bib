@article{10.14778/2536206.2536221,
 abstract = {Trajectories of moving objects are collected in many applications. Raw trajectory data is typically very large, and has to be simplified before use. In this paper, we introduce the notion of direction-preserving trajectory simplification, and show both analytically and empirically that it can support a broader range of applications than traditional position-preserving trajectory simplification. We present a polynomial-time algorithm for optimal direction-preserving simplification, and another approximate algorithm with a quality guarantee. Extensive experimental evaluation with real trajectory data shows the benefit of the new techniques.},
 author = {Long, Cheng and Wong, Raymond Chi-Wing and Jagadish, H. V.},
 doi = {10.14778/2536206.2536221},
 issn = {2150-8097},
 issue_date = {August 2013},
 journal = {Proc. VLDB Endow.},
 month = {August},
 number = {10},
 numpages = {12},
 pages = {949–960},
 publisher = {VLDB Endowment},
 title = {Direction-preserving trajectory simplification},
 url = {https://doi.org/10.14778/2536206.2536221},
 volume = {6},
 year = {2013}
}
