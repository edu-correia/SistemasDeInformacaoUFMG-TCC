 publication_stage = {Final},
 source = {Scopus},
 title = {XStore: Fast RDMA-Based Ordered Key-Value Store Using Remote Learned Cache},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85122591282?origin=resultslist},
 volume = {17},
