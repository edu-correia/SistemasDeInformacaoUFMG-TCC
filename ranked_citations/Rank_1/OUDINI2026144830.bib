@article{OUDINI2026144830,
 abstract = {Thiazoles and rhodanines present interesting biological and photophysical properties, and merging both structures could give rise to antioxidant-luminescent dyads. Here, a practical synthesis of thiazolylidenthiazolidinones via one-pot reaction is reported, giving access to a large family in good yields (78–93 %) after simple purification. The compounds were fully characterized by NMR, FT-IR, HRMS, and their photophysical properties were studied. One of them was characterized by single-crystal X-ray diffraction, crystallizing in the monoclinic space group P21 with a = 8.1772(14) A°, b = 22.564(4) A°, c = 12.939(2) A°, α= 90°, β= 95.154° (5) and γ= 90°. It was used as a model for computational studies, which served to rationalize the properties of the compounds. The DFT computations, performed using the DFT/ B3LYP/6–311G+ (d,p) level basis set, showed a good agreement with the experimental data (XRD, 1H and 13C NMR, FTIR, absorption and emission spectra). In addition, these compounds were tested for their antioxidant activity, studying their DPPH radical scavenging capacity. Interestingly, the compounds showed an antioxidant activity ranging from low (IC50 = 763.61 μM) to good(IC50 = 11.96 μM), the later being comparable to the capacity of ascorbic acid. (IC50=13.71 μM). All compounds emit faintly in solution (quantum yield < 1 %), with an absorption maximum around 430 nm and an emission around 480 nm, these results being rationalized through td-DFT calculations. The luminescence combined with the antioxidant activity of these compounds makes them a promising scaffold to develop biologically relevant molecules.},
 author = {Boutheyna Oudini and Meriem-Karima Boukanoun and Joana R.M. Ferreira and Soufiane Benreka and Fatiha Madi and Gilbert Kirsch and Artur M.S. Silva and Samuel Guieu and Souad Kasmi-Mir},
 doi = {https://doi.org/10.1016/j.molstruc.2025.144830},
 issn = {0022-2860},
 journal = {Journal of Molecular Structure},
 keyword = {Rhodanine, Thiazole, Luminescence, Antioxidant activity, Single crystal-xrd, Dft calculations},
 pages = {144830},
 title = {Synthesis, characterization and antioxidant activity of luminescent thiazolylidenthiazolidinones},
 url = {https://www.sciencedirect.com/science/article/pii/S0022286025034702},
 volume = {1354},
 year = {2026}
}
