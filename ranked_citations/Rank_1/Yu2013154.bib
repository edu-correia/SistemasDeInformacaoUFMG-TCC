@article{Yu2013154,
 abstract = {A tactical Mobile Ad Hoc Network (MANET) demands a robust, diverse and resilient communication and computing infrastructure which enables network-centric operation with minimal downtime. Nevertheless, tactical MANET poses great security risks because mobile nodes are deployed in open hostile environments and wireless communication makes the information accessible to an adversary attacking the tactical MANET. Cyber attack monitoring and detection in the tactical MANET is challenging because of limited resources and its infrastructure-less network environment. To address these issues, we first introduce the hostbased detection architecture to monitor and detect cyber attacks against the tactical MANET. We then develop two sampling techniques and discuss other techniques to balance trade-offs between detection accuracy and consumption of network resources. We also analyse the impact of detection accuracy versus sampling techniques and associated parameters. We conduct extensive real-world experiments and simulation studies. Our data validates our theoretical findings well. Copyright © 2013 Inderscience Enterprises Ltd.},
 author = {Yu, Wei and Ge, Linqiang and Zhang, Difan and Hardy, Rommie L. and Reschly, Robert J.},
 doi = {10.1504/IJSN.2013.057688},
 journal = {International Journal of Security and Networks},
 note = {Cited by: 2},
 number = {3},
 pages = {154 - 168},
 publication_stage = {Final},
 source = {Scopus},
 title = {On effective sampling techniques in host-based intrusion detection in tactical MANET},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84888857083?origin=resultslist},
 volume = {8},
 year = {2013}
}
