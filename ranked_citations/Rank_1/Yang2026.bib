@article{Yang2026,
 abstract = {Searchable Symmetric Encryption (SSE) has emerged as a practical technology to address the low-cost data outsourcing solution accompanying the growing data privacy concerns. In the pursuit of real-world deployment, researchers have emphasized the importance of supporting Boolean queries in SSE schemes. However, existing schemes struggle to handle large-scale data due to high storage overhead and poor locality in I/O. In response to this challenge, we design a two-level block index construction for locality optimization and propose an efficient Dynamic SSE scheme with trusted hardware support, satisfying locality-based backward security that are first introduced in this paper. We evaluate its performance on datasets up to billion-scale. Our encrypted index occupies only 16.1% of the size of plaintext dataset, which is 27.0×, 21.9×, and 11.4× smaller than conventional OXT and SGX-based BISEN, POSUP schemes, respectively, while index generation is 1612.7×, 22.5×, and 7.3× faster. Most queries achieve subsecond latency, incurring no more than 25% additional overhead compared to the full-text search engine ElasticSearch. To our best knowledge, it is the first practical SSE scheme which has achieved sub-second response time on disk-based index with minimal storage overhead.  © 2026 IEEE.},
 author = {Yang, Yang and Hou, Tianming and Fan, Haihui and Li, Bo and Gu, Xiaoyan and Zhang, Jinchao and Ma, Hui and Wang, Weiping},
 doi = {10.1109/TC.2026.3689816},
 journal = {IEEE Transactions on Computers},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Article in press},
 source = {Scopus},
 title = {A Practical Dynamic Searchable Symmetric Encryption Scheme with Trusted Hardware-Assisted},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105037791471?origin=resultslist},
 year = {2026}
