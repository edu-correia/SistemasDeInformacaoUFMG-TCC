@article{HUANG2025132198,
 abstract = {High-quality (Q) resonances play a vital role in applications including fluorescence enhancement, biosensing, and nonlinear optics. However, conventional high Q-factor designs relying on symmetry-protected bound states in the continuum (SP–BICs) are highly susceptible to structural perturbations, which restricts their practical applicability. We propose a cascaded semi-embedded high-contrast grating (CSE-HCG) structure utilizing merging bound states in the continuum (merging-BIC), enabling high Q-factor and multi-mode resonant refractive index sensing. We conduct rigorous theoretical analysis using both rigorous coupled-wave analysis (RCWA) and the finite element method (FEM). By preserving in-plane symmetry and tuning geometric parameters, we achieve merging-BIC in momentum space by combining accidental BICs and SP-BIC. The merging-BIC maintain high Q-factor resonances over a broad wavevector range. The structure supports multi-band sensing, with three modes corresponding to the merging-BIC, SP-BIC, and guided-mode resonance (GMR), respectively. Among them, the merging-BIC exhibits the highest Q-factor and the slowest Q-factor decay rate, with a sensitivity of 515.25 nm/RIU and a Q-factor of 72906.71. The proposed cascaded sensor exhibits significant application potential in the field of high-performance optical sensing.},
 author = {Zijin Huang and Xiuhong Liu and Zhi Zhao and Haiyan Han and Sixing Xi},
 doi = {https://doi.org/10.1016/j.optcom.2025.132198},
 issn = {0030-4018},
 journal = {Optics Communications},
 keyword = {Merging bound states in the continuum, Refractive index sensor, Multiple resonance, High factor resonances},
 pages = {132198},
 title = {High-robustness and multi-band optical sensing enabled by merging bound states in the continuum},
 url = {https://www.sciencedirect.com/science/article/pii/S0030401825007266},
 volume = {591},
 year = {2025}
}
