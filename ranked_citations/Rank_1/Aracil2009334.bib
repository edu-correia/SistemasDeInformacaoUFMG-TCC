@conference{Aracil2009334,
 abstract = {A simple and innovative single-use valve based on PCB-MEMS is presented. The power of this valve lies on its activation process and the combination of different technologies to achieve low cost. The activation is a merge of thermal and mechanical phenomena. Other important innovation is the deposition of SU8 over an orifice. This single-use valve has a chamber to include biochemical substances in case the application is of biomedical nature. The integration with other microfluidic and electronic devices has been considered in the design. © 2009 IEEE.},
 author = {Aracil, Carmen and Moreno, J. Miguel and Quero, José M.},
 doi = {10.1109/SCED.2009.4800500},
 journal = {Proceedings of the 2009 Spanish Conference on Electron Devices, CDE'09},
 note = {Cited by: 1},
 pages = {334 - 337},
 publication_stage = {Final},
 source = {Scopus},
 title = {Single-use microvalve fabricated using Printed Circuit Board and SU8 technologies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/64949167374?origin=resultslist},
 year = {2009}
}
