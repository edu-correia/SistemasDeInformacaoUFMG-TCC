@article{Zhang2026,
 abstract = {Time-series similarity search is a core task in time-series data mining, essential to a wide range of downstream applications. The effectiveness of time-series similarity search depends on the choice of distance measure. Among various alternatives, the Time Warping Edit (TWE) distance has recently gained significant attention for its strong performance across diverse tasks. However, its high computational cost and the lack of specialized acceleration techniques hinder its scalability. To address this, we propose FastTWE, an efficient method for accelerating TWE-based similarity search. FastTWE adopts an Approximate-then-Exact framework: in the approximate phase, time-series are transformed into low-dimensional vectors via random convolutional kernels and PCA, enabling efficient candidate filtering; in the exact phase, TWE distances are computed only for the candidate set. A TWE-specific lower bound is further employed to reduce redundant distance computations. We compare the performance of FastTWE with relevant competitors across 58 datasets, evaluating various aspects including preprocessing time, retrieval accuracy, and online search time. The experimental results demonstrate both the effectiveness and superiority of FastTWE. Code is available on GitHub: https://github.com/pcjdhhhh/FastTWE. © 2025 Elsevier B.V.},
 author = {Zhang, Haowen and He, Xiaoyu and Li, Jing and Li, Juan and Yao, Qing},
 doi = {10.1016/j.asoc.2025.114256},
 journal = {Applied Soft Computing},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {FastTWE: Making TWE-based time-series similarity search faster via random convolutional kernels},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105021480289?origin=resultslist},
 volume = {186},
 year = {2026}
}
