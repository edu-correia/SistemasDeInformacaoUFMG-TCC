@inproceedings{8985010,
 abstract = {A wide area protection scheme can integrate adaptive protections through Ethernet communication links within power systems infrastructure. This integration permits the implementation of a decentralized control where each IED has the ability to change its own protections parameters when it detects a change in the electric grid topology. This topology change is provoked by fault occurrences that imply the operation outage of some line of the power system. In this work, the behavior of a SEL 421 protection device subscribed to GOOSE messages published by other IED in the network is exhibit. Those GOOSE messages indicate the relay operation and the opening of the line breaker, and then immediately change its protection parameters to others more adequate programmed in the relay configuration groups. Each configuration group has defined parameters for some power system topologies of the implemented electric grid. This process is accomplished through the emulation of a power system with an OP4510 real time simulation platform and a communications network that integrates IEDs operating under the standard IEC 61850. In this way, a contribution about the incorporation of these technologies with the mentioned standard is performed by virtue to increase the experiences concerning to the implementation and automation of digital substations in Colombia.},
 author = {Montoya-Arias, José Andrés and Tobar-Rosero, Oscar Andrés and Zapata-Madrigal, Germán D.},
 booktitle = {2019 FISE-IEEE/CIGRE Conference - Living the energy Transition (FISE/CIGRE)},
 doi = {10.1109/FISECIGRE48012.2019.8985010},
 issn = {},
 keyword = {Power systems;IEC Standards;Software packages;Network topology;Topology;Monitoring;Merging;Power systems;Hardware in the loop;Electric protections;Adaptive protections;Real-time simulation;Wide area protections},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {Automatic Configuration of Distance Relays with Process Bus under a Hardware in the Loop Scheme},
 volume = {},
