@article{SLAMAA2026100920,
 abstract = {Despite the rapid growth of AI-powered text, Arabic's content remains semantically underrepresented and don’t have enough interpretation for machines. Limited synthesizing of how semantic resources relate to AI-driven retrieval or generative systems. Limited review studies introduced Arabic semantic web since the last decade, without projection of evolution. Besides, the lack of practical implications and synthesis for future research directions in AI environments makes a gap for who cares about Arabic semantic information retrieval in artificial intelligence environment. Thereby, the study demonstrates the contributions, challenges, and milestones in structuring Arabic semantic information retrieval (ASIR), and explores how these advancements have influenced the development of Arabic language models and AI contributions like LLMs and Chatbots over the past two decades. Integrating Systematical Literature Review, PRISMA, Design Science Research and AMSTAR-2 provide answers to multiple research questions tracking advancements from 2000 to 2025. As a result, ASIR has developed from rule-based to neural and LLM-driven systems, attaining over a 35 % rise in accuracy and ten dialects merged. Key progresses incorporate Arabic DBpedia integration, ontology frameworks, and models like AraBERT for enhanced contextual information retrieval. Additionally, dialectal NLP has been developed for applications such as Chatbots and LLMs. Although challenges in standardized benchmarks, dataset diversity, ASIR's assistance in intelligent Chatbots, adaptive e-learning, etc., this study serves as a valuable resource for researchers, developers, and policymakers aiming to advance linguistically inclusive and semantically rich AI solutions for Arabic-speaking communities. This study is regarded as a roadmap, diagnostic tool, and strategic guide for enhancing Arabic AI systems with semantic depth, linguistic inclusivity, and real-world impact.},
 author = {Amany A. Slamaa},
 doi = {https://doi.org/10.1016/j.cosrev.2026.100920},
 issn = {1574-0137},
 journal = {Computer Science Review},
 keyword = {Arabic DBpedia, Semantic web, Information retrieval, Arabic NLP, Question answering, Arabic language model, Arabic Chatbot, Large language model, Systematic literature review},
 pages = {100920},
 title = {AI-driven semantic information retrieval for Arabic language- systematic literature review},
 url = {https://www.sciencedirect.com/science/article/pii/S1574013726000298},
 volume = {60},
 year = {2026}
}
