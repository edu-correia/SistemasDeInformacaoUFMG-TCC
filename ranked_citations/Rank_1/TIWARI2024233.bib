@incollection{TIWARI2024233,
 abstract = {The need for innovative technologies that enable efficient and available health monitoring has increased in recent years. Traditional healthcare systems frequently rely on time consuming and costly laboratory-based testing, restricting the accessibility and frequency of health checks. However, advances in microfabrication and microfluidics have resulted in the introduction of lab-on-chip (LOC) devices, which provide a viable alternative for portable and individualized health monitoring. The field of LOC devices has rapidly grown, with the goal of integrating numerous laboratory operations onto a single chip, enabling downsizing, mobility, and high-throughput analysis. These gadgets have the potential to change healthcare by delivering real-time and noninvasive monitoring, improving illness diagnosis, therapy evaluation, and overall health management. One of the primary advantages of LOC devices is their ability to incorporate microfluidic channels. One of the primary advantages of LOC devices is their ability to merge microfluidic channels, sample preparation procedures, and detecting modules onto a single chip. This integration enables accurate fluid flow control, quick sample processing, and very sensitive detection of target analytes. Furthermore, the downsizing of these technologies enables point-of-care diagnostics, remote patient monitoring, and tailored treatment, allowing individuals to actively participate in their own health management. This chapter will discuss the design and fabrication of LOC, material requirements, and integration of bioreactors on LOC devices. This chapter aims to provide a comprehensive overview of the advancements, challenges, and prospects of LOC devices for health monitoring. By leveraging the capabilities of microfabrication, microfluidics, and biomarker analysis, these devices hold tremendous potential in transforming healthcare by enabling personalized, accessible, and proactive monitoring of an individual's health status.},
 author = {Swapnil Tiwari and Diana Bueno Hernandez and Rupesh Kumar Mishra and Atul Sharma},
 booktitle = {Biosensors in Precision Medicine},
 doi = {https://doi.org/10.1016/B978-0-443-15380-8.00009-6},
 editor = {Lais C. Brazaca and Juliane R. Sempionatto},
 isbn = {978-0-443-15380-8},
 keyword = {Biomarker identification, LOC technology, microfluidics, parallelization, point-of-care diagnostics, remote patient monitoring},
 pages = {233-266},
 publisher = {Elsevier},
 title = {Chapter 8 - Lab-on-a-chip devices},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443153808000096},
 year = {2024}
}
