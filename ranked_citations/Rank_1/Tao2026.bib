@article{Tao2026,
 abstract = {Deep unfolding-based pansharpening methods have recently attracted considerable attention, as they combine the interpretability of model-driven optimization with the flexibility of deep learning. However, most existing deep unfolding frameworks still lack explicit mechanisms to capture and integrate the complementary information between shallow and deep features of low-resolution multispectral (LRMS) and panchromatic (PAN) images. To address this limitation, we propose a Multi-stage Interactive Guidance Deep Unfolding Network (MIGDUN), which effectively promotes information interaction between PAN and LRMS images. The framework integrates a Learnable Iterative Shrinkage-Thresholding Algorithm (LISTA) with Learnable Convolutional Sparse Coding (LCSC) to jointly model PAN and LRMS features, thereby fully exploiting both shallow and deep information. We further design an Interactive Filtering Fusion Module (IFFM) to enhance spatial–spectral interactions, combined with a multi-stage integration strategy (MSIS) to progressively refine hierarchical representations. In addition, an Indirect Guidance Fusion Module (IGFM) is introduced to further facilitate cross-level feature integration. Both reduced- and full-resolution experimental results demonstrate that the proposed method achieves superior performance compared to existing pansharpening approaches. © 2025},
 author = {Tao, Hailin and Yuan, Genji and Li, Huiyu and Li, Jinjiang},
 doi = {10.1016/j.neucom.2025.132527},
 journal = {Neurocomputing},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {MIGDUN: Multi-stage interactive guidance deep unfolding network for pansharpening remote sensing images},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105027054495?origin=resultslist},
 volume = {670},
 year = {2026}
}
