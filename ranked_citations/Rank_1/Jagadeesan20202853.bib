@conference{Jagadeesan20202853,
 abstract = {Selecting the optimal storage engine and tuning for an application requires comparing the latency of diverse workloads executed on different data structures. In this work, we start to develop an average-case analysis of the performance of storage engines that can achieve significantly more accurate predictions than existing worst-case models. We propose a distribution-aware framework to predict the latency of diverse workloads executed on a vast number of data structures. As a case study, we use our framework to produce cost models for a diverse family of key-value storage engine tunings, and verify our models on RocksDB and WiredTiger. © 2020 Association for Computing Machinery.},
 author = {Jagadeesan, Meena and Tanzer, Garrett},
 doi = {10.1145/3318464.3384408},
 journal = {Proceedings of the ACM SIGMOD International Conference on Management of Data},
 note = {Cited by: 0},
 pages = {2853 - 2855},
 publication_stage = {Final},
 source = {Scopus},
 title = {From Worst-Case to Average-Case Analysis: Accurate Latency Predictions for Key-Value Storage Engines},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85086229570?origin=resultslist},
 year = {2020}
}
