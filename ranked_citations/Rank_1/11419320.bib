@inproceedings{11419320,
 abstract = {This work presents a Parallel-Plate Coplanar EWOD (PPC EWOD) system that combines bottom-only electrode actuation with SLIPS-functionalized SU-8 micropillar structures. The SU-8 fabrication process produced uniform micropillar and spacer structures, enabling stable device assembly. Integrating SLIPS on both plates formed a liquid-liquid interface that reduced contact-line pinning, improved electrowetting reversibility, and significantly enhanced antifouling performance. Compared with CYTOP and conventional hydrophobic coatings, SLIPS exhibited minimal protein residue and lower hysteresis. The PPC EWOD platform further demonstrated reliable droplet splitting, transportation, and merging under standard actuation conditions. These results establish a simplified yet robust EWOD architecture suitable for future digital microfluidics and biomedical applications.},
 author = {Ciou, Yi-Teng and Lu, Wei-Teng and Lin, Yu-Hsin and Chen, Che-Chin and Lee, Meng-Shiue},
 booktitle = {2026 IEEE 39th International Conference on Micro Electro Mechanical Systems (MEMS)},
 doi = {10.1109/MEMS64181.2026.11419320},
 issn = {2160-1968},
 keyword = {Fabrication;Electrodes;Proteins;Sensitivity;Merging;Transportation;Voltage;Reliability;Microfluidics;Standards;Lab-on-a-Chip;Microfluidics;Coplanar EWOD Platform;Biomimetic Surface},
 month = {Jan},
 number = {},
 pages = {1476-1479},
 title = {An Antibiofouling Parallel-Plate Coplanar EWOD System Enabled by Slips Integration},
 volume = {},
 year = {2026}
}
