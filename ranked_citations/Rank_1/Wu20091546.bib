@conference{Wu20091546,
 abstract = {We propose a multi-object multi-camera framework for tracking large numbers of tightly-spaced objects that rapidly move in three dimensions. We formulate the problem of finding correspondences across multiple views as a multidimensional assignment problem and use a greedy randomized adaptive search procedure to solve this NP-hard problem efficiently. To account for occlusions, we relax the one-to-one constraint that one measurement corresponds to one object and iteratively solve the relaxed assignment problem. After correspondences are established, object trajectories are estimated by stereoscopic reconstruction using an epipolar-neighborhood search. We embedded our method into a tracker-to-tracker multi-view fusion system that not only obtains the three-dimensional trajectories of closely-moving objects but also accurately settles track uncertainties that could not be resolved from single views due to occlusion. We conducted experiments to validate our greedy assignment procedure and our technique to recover from occlusions. We successfully track hundreds of flying bats and provide an analysis of their group behavior based on 150 reconstructed 3D trajectories. © 2009 IEEE},
 author = {Wu, Zheng and Hristov, Nickolay I. and Hedrick, Tyson L. and Kunz, Thomas H. and Betke, Margrit},
 doi = {10.1109/ICCV.2009.5459274},
 journal = {Proceedings of the IEEE International Conference on Computer Vision},
 note = {Cited by: 81},
 pages = {1546 - 1553},
 publication_stage = {Final},
 source = {Scopus},
 title = {Tracking a Large Number of Objects from Multiple Views},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84887380984?origin=resultslist},
 year = {2009}
}
