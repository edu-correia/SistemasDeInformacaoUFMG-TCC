 publication_stage = {Final},
 source = {Scopus},
 title = {Artificial Intelligence Techniques and Its impact on Human Consciousness and Healthcare},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85211931771?origin=resultslist},
