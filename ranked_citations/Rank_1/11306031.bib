@inproceedings{11306031,
 abstract = {Data-driven deep learning techniques have achieved remarkable progress in electromagnetic modeling and topological optimization. However, the data can be insufficient in problems of topological structure in electromagnetics, leading to overfitting and unsatisfactory accuracy of data-driven methods. To tackle the overfitting issue arising from limited data, we attempt to use physical equations, i.e., Maxwell's equations, to achieve the data augmentation for topological optimization. Here, the Maxwell's equations serve as the physical constraint to assess the accuracy of the predicted electric fields. During the backpropagation for extrapolation tasks, the physical loss is merged with the data loss. To demonstrate its benefits, the proposed approach is applied to electromagnetic modeling of one category of topological structure. The results demonstrate that the proposed method can achieve better performance regarding both accuracy and time burden.},
 author = {Zheng, Xuan and Zhang, Yan and Su, Jian Lin and Zhang, Jianan and You, Jian Wei and Cui, Tie Jun},
 booktitle = {2025 International Conference on Electromagnetics in Advanced Applications (ICEAA)},
 doi = {10.1109/ICEAA65662.2025.11306031},
 issn = {2766-2284},
 keyword = {Measurement;Extrapolation;Accuracy;Electromagnetic modeling;Electromagnetics;Maxwell equations;Electric fields;Optimization;Physics;Overfitting;Artificially intelligence;topological structure;electromagnetic optimization;physics-informed neural network;data scarcity},
 month = {Sep.},
 number = {},
 pages = {0277-0279},
 title = {Topological Optimization of Electromagnetic Structures Based on Physics-Informed Neural Networks},
 volume = {},
 year = {2025}
}
