@conference{Al-Mamun2025174,
 abstract = {Machine Learning (ML) techniques have been successfully applied to design various learned database index structures for both the one- and multi-dimensional spaces. Particularly, a class of traditional multi-dimensional indexes has been augmented with ML models to design ML-enhanced variants of their traditional counterparts. This paper focuses on the R-tree multi-dimensional index structure as it is widely used for indexing multi-dimensional (e.g., spatial) data. The R-tree has been augmented with machine learning models to enhance the R-tree performance. The AI+R-tree is an ML-enhanced R-tree index structure that augments a traditional disk-based R-tree with ML models to enhance the R-tree’s query processing performance, mainly, to avoid navigating the overlapping branches of the R-tree that do not yield query results, e.g., in the presence of high-overlap among the rectangles of the R-tree nodes. In this paper, we investigate the empirical tradeoffs in processing dynamic query workloads over the AI+R-tree. Particularly, we investigate the impact of the choice of ML models over the AI+R-tree query processing performance. Moreover, we present a case study of designing a custom loss function for a neural network model tailored to the query processing requirements of the AI+R-tree. Experiments on real datasets demonstrate that the AI+R-tree can enhance the query processing performance of a traditional R-tree for high-overlap range queries by up to 5.4X while achieving up to 99% query recall. © 2025 Copyright held by the owner/author(s)},
 author = {Al-Mamun, Abdullah and Haider, Ch.Md. Rakin and Aref, Walid G.},
 doi = {10.1145/3764912.3770834},
 journal = {GeoAI 2025 - Proceedings of the 8th ACM SIGSPATIAL International Workshop on AI for Geographic Knowledge Discovery},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {174 - 184},
 publication_stage = {Final},
 source = {Scopus},
 title = {Query Processing Tradeoffs over an ML-Enhanced R-tree},
 type = {Conference paper},
