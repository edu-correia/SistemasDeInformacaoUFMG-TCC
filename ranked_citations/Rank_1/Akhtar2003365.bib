@article{Akhtar2003365,
 abstract = {Polysilicon piezoresistors configured in a Wheatstone bridge, have been fabricated over a silicon diaphragm of 25 to 100 microns thickness for pressure sensing in a range of mbar to tens of bar. A suitable integration of the microelectronics steps with the MEMS technology, has been developed for the fabrication of chips in batches. The developed fabrication process is competent to provide nearly 80 chips of 4 × 4 mm<sup>2</sup> size on a two inch diameter silicon (100) wafer with polished surfaces. © 2003 Taylor & Francis Group, LLC.},
 author = {Akhtar, J. and Dixit, B.B. and Pant, B.D. and Deshwal, V.P.},
 doi = {10.1080/03772063.2003.11416360},
 journal = {IETE Journal of Research},
 note = {Cited by: 22},
 number = {6},
 pages = {365 - 377},
 publication_stage = {Final},
 source = {Scopus},
 title = {Polysilicon piezoresistive pressure sensors based on mems technology},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/1242307436?origin=resultslist},
 volume = {49},
 year = {2003}
}
