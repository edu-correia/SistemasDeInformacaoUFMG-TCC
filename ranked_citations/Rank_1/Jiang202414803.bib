@article{Jiang202414803,
 abstract = {We introduce a novel data analytics framework, using a multiplex recurrence network (MRN) to analyze flight tracking flow fluctuations in multi-airport terminal areas, with a case study on Shanghai's Pudong (PVG) and Hongqiao (SHA) airports. It fills the gap in existing research by focusing on daily traffic flow fluctuations and exploring the operational dynamics within multi-airport systems. The MRN method effectively captures the synchronicity and similarity of traffic flows, offering novel insights into the management of airport terminal areas. Empirical analysis based on actual flight operation data validates the MRN's efficacy, revealing distinct patterns of traffic flow synchronicity across four different scenarios - All Arrivals of PVG and SHA (AllArr), All Departures of PVG and SHA (AllDep), All Arrivals and Departures of PVG (AllPVG), and All Arrivals and Departures of SHA (AllSHA). These findings highlight the potential for enhancing operational efficiency by improving the synchronicity of traffic flows, especially during peak periods. This novel framework for understanding and optimizing air traffic flows in terminal areas offers both academic insights and practical implications for air traffic management, and provides a foundation for targeted interventions to improve the efficiency of airport operations in multi-airport systems.  © 2000-2011 IEEE.},
 author = {Jiang, Furong and Zhang, Zhaoning},
 doi = {10.1109/TITS.2024.3396627},
 journal = {IEEE Transactions on Intelligent Transportation Systems},
 note = {Cited by: 6},
 number = {10},
 pages = {14803 - 14815},
 publication_stage = {Final},
 source = {Scopus},
 title = {Characteristics of Air Traffic Flow in Terminal Airspace: A Multiplex Recurrence Network Analysis},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85193291389?origin=resultslist},
