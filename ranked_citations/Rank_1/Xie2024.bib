@article{Xie2024,
 abstract = {Text-based person search aims to retrieve relevant person images from a large database given textual queries. However, single-view limitation of surveillance cameras and cross-modal heterogeneity still remain challenging open issues. To address these, we propose a Full-view Salient Feature Mining Network (FLAN) to improve text-image matching in this task. Our FLAN introduces two key innovations. First, the Diffusion-based Full-view Image Augmentation generates informative full-view data from a single image to simulate human visual observation and learn view-invariant features. Second, the Dual-max Text Attention module optimizes spatial and channel-wise text attentions to extract the most discriminative words characterizing the person. Together, these innovations handle insufficient, imbalanced, and heterogeneous data for more accurate matching. Extensive experiments on three text-based person search datasets, CUHK-PEDES, ICFG-PEDES and RSTPReid, demonstrate superior performance of our FLAN with improved robustness and generalization. © 2024 Elsevier Ltd},
 author = {Xie, Sheng and Zhang, Canlong and Ning, Enhao and Li, Zhixin and Wang, Zhiwen and Wei, Chunrong},
 doi = {10.1016/j.eswa.2024.124071},
 journal = {Expert Systems with Applications},
 note = {Cited by: 29},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Full-view salient feature mining and alignment for text-based person search},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85191346136?origin=resultslist},
 volume = {251},
 year = {2024}
}
