@article{YAO2025107507,
 abstract = {Responding to traditional surveying and mapping issues, such as their low accuracy and damage to the contact when protecting ancient buildings, this study uses Shaoxing Lvfu, a nationally recognized key cultural relic site, as the research object and creates a three-dimensional digital model based on ground-air collaborative surveying and mapping of 3D laser scanning and unmanned aerial vehicle oblique photography. The FARO Focus Premium 3D laser scanner (ranging error ±1 mm, sampling rate 2 million points/second) is used to complete the high-density point cloud acquisition of the internal and external structures of the building, and combined with the DJI Mavic 3E UAV tilt camera system (vertical overlap rate of 90 %, multi-view image coverage), the multi-dimensional acquisition of the building façade and the roof is realized. Through the FARO Scene point cloud alignment, the error of the 3D laser point cloud model is controlled within 3 mm, and the overlap rate reaches 58 %. The 2D orthographic projection map (scale accuracy of 1:100) exported through the Revit model provides a quantifiable engineering basis for cultural heritage restoration. The verticality inspection for the vertical structure of Lvfu shows that its overall verticality deviation is significant, and there is an urgent need to implement long-term structural health monitoring. The technical chain of “data acquisition-integration processing-application transformation” established in this study provides an innovative paradigm of both efficiency and precision for the digital protection of cultural heritage, and its applicability to engineering has been verified by the actual case of Lvfu.},
 author = {Jiaqi Yao and Lijia Wang and Hongxin Liu and Qidong Wang and Junan Hao},
 doi = {https://doi.org/10.1016/j.rineng.2025.107507},
 issn = {2590-1230},
 journal = {Results in Engineering},
 keyword = {3D laser scanning technology, UAV tilt photography, Verticality inspection, BIM technology, Ancient building conservation},
 pages = {107507},
 title = {Research on the use of UAV-inclined photography and 3D laser scanning in the digital conservation of historic structures: A case study of Shaoxing Lvfu},
 url = {https://www.sciencedirect.com/science/article/pii/S2590123025035625},
 volume = {28},
 year = {2025}
}
