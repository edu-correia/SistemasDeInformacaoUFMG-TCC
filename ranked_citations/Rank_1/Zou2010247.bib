@article{Zou2010247,
 abstract = {Massive scale distributed database like Google's BigTable and Yahoo!'s PNUTS can be modeled as Distributed Ordered Table, or DOT, which partitions data regions and supports range queries on key. Multi-dimensional range queries on DOTs are fundamental requirements; however, none of existing schemes work well while considering three critical issues: high performance, low space overhead, and high reliability. This paper introduces CCIndex scheme, short for Complemental Clustering Index, to solve all three issues. CCIndex creates several Complemental Clustering Index Tables for performance, leverages region-to-server information to estimate result size, and supports incremental data recovery. This paper builds a prototype on Apache HBase. Theoretical analysis and micro-benchmarks show that CCIndex consumes 5.3% ∼ 29.3% more space, has the same reliability, and gains 11.4 times range queries throughput of secondary index scheme. Synthetic application benchmark shows that CCIndex query throughput is 1.9 ∼ 2.1 times of MySQL Cluster. © 2010 Springer-Verlag.},
 author = {Zou, Yongqiang and Liu, Jia and Wang, Shicai and Zha, Li and Xu, Zhiwei},
 doi = {10.1007/978-3-642-15672-4_22},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 36; All Open Access; Bronze Open Access; Green Open Access},
 pages = {247 - 261},
 publication_stage = {Final},
 source = {Scopus},
 title = {CCIndex: A complemental clustering index on distributed ordered tables for multi-dimensional range queries},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78149245479?origin=resultslist},
 volume = {6289 LNCS},
 year = {2010}
}
