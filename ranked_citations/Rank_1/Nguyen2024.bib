@conference{Nguyen2024,
 abstract = {This study presents a comprehensive workflow for cell segmentation using the Monuseg dataset. Our method integrates several advanced techniques to enhance the performance of segmentation models. We apply Principal Component Analysis (PCA) and Gaussian Mixture Model - Expectation Maximization (GMM-EM) clustering for data pre-processing. The training and evaluation significantly improved the mean IoU metric, demonstrating the enhanced performance of Language meets Vision Transformer (LViT) compared to other deep-learning networks. This constructed workflow shows substantial potential in improving the accuracy of cell segmentation tasks, which is crucial and beneficial for various biomedical applications. © 2024 IEEE.},
 author = {Nguyen, Van-De and Dang, Minh-Huong Hoang and Nguyen, Quang-Huy and Dinh, Manh-Cuong and Do, Thanh-Ha},
 doi = {10.1109/APSIPAASC63619.2025.10848765},
 journal = {APSIPA ASC 2024 - Asia Pacific Signal and Information Processing Association Annual Summit and Conference 2024},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Enhancing Cell Segmentation using Deep Learning Models by Custom Processing Techniques},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85218210571?origin=resultslist},
 year = {2024}
