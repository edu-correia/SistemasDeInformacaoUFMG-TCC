@incollection{WANG2025227,
 abstract = {Bubbles always accumulate with clusters and their structures are diverse, the most typical being the acoustic Lichtenberg figure structure, which has a branching feature. As a result of the translational movement of the bubbles toward the center of the bubble accumulation zone, many small spherical bubble clusters are continuously generated and subsequently detach from this site. In the liquid domain, there are many isolated floating spherical bubble clusters that are driven up by ultrasound or other fluid forces. Bubbles are always translating and oscillating radially in the liquid, and the coupling interactions between bubbles affect their behavior, such as coalescence, merging, and bouncing and fission. In the literature, many theoretical models are developed to analyze the cluster dynamics. In this chapter, we present models for coupled bubble pairs, bubble chains, spherical clusters, and cylindrical clusters, which help to predict the evolution of these structures and the collapse effects in multibubble systems. Some representative simulation methods are also presented here, where the “shield effect” and “wall effect” can be visualized by a spherical or square cluster. It is of great importance to research the evolution mechanism of bubbles in clusters, which is beneficial to the application of cavitation technology.},
 author = {Chenghui Wang},
 booktitle = {Modeling and Simulation of Sono-Processes},
 doi = {https://doi.org/10.1016/B978-0-443-23651-8.00015-2},
 editor = {Kaouther Kerboua},
 isbn = {978-0-443-23651-8},
 keyword = {Bubble cluster, translational motion, collapse, coalescence, coupling interaction of bubbles},
 pages = {227-244},
 publisher = {Elsevier},
 title = {Chapter 15 - Acoustic bubble cluster: modeling and simulation of dynamics, interaction, and coalescence},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443236518000152},
 year = {2025}
}
