@article{SCHADE202011801,
 abstract = {Pharmacological inhibition of cathepsin S (CatS) allows for a specific modulation of the adaptive immune system and many major diseases. Here, we used NMR fragment screening and crystal structure-aided merging to synthesize novel, highly selective CatS inhibitors with picomolar enzymatic Ki values and nanomolar functional activity in human Raji cells. Noncovalent fragment hits revealed binding hotspots, while the covalent inhibitor structure–activity relationship enabled efficient potency optimization.},
 author = {Markus Schade and Beatrix Merla and Bernhard Lesch and Markus Wagener and Simone Timmermanns and Katrien Pletinckx and Torsten Hertrampf},
 doi = {https://doi.org/10.1021/acs.jmedchem.0c00949},
 issn = {1520-4804},
 journal = {Journal of Medicinal Chemistry},
 number = {20},
 pages = {11801-11808},
 title = {Highly Selective Sub-Nanomolar Cathepsin S Inhibitors by Merging Fragment Binders with Nitrile Inhibitors},
 url = {https://www.sciencedirect.com/science/article/pii/S1520480420006274},
 volume = {63},
 year = {2020}
}
