@conference{Mathpati2026864,
 abstract = {The recommendation systems play an important role in delivering customized content to users on all platforms, though there are challenges such as data sparseness, cold-start challenges, and insufficient knowledge of multimodal user preferences. Older systems based on single-mode data cannot convey the whole range of user preferences, and hence, they become less precise in real life. The present paper, to resolve these problems, introduces a multimodal recommendation system that merges text and pictures as data sources. One of the methods applied here is the ROBERTa transformer, which captures the underlying meaning of the user reviews, while the other is VGG-16, which models the product images. A co-attention technique is utilized to align and merge the two kinds of inputs into one user-item representation, which is further processed by a multi-layer perceptron to predict preferences. Several metrics are employed in the evaluation of the system, yielding the following results: MRR of 0.6867 and MAP 10 of 0.5645. This signifies that the system excels at relevant item ranking, achieving top-10 performance. The model has also marked a high intra-list diversity (ILD =0.90) and coverage (0.88). © 2026 IEEE.},
 author = {Mathpati, Shilpa and Menon, Sindhu P},
 doi = {10.1109/IDCIoT67589.2026.11455881},
 journal = {Proceedings of the 4th International Conference on Intelligent Data Communication Technologies and Internet of Things, IDCioT 2026},
 note = {Cited by: 0},
 pages = {864 - 869},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multimodal Recommendation System for Accurate Predictions Using RoBERT and VGG-16 with Co-Attention Mechanism},
 type = {Conference paper},
