@article{LI2025170733,
 abstract = {Antimicrobial peptides (AMPs) exist extensively in all living organisms and play key roles in innate defense responses infection. AMPs have attracted much attention for years owing to their richer sources and unique merits compared to traditional antibiotics, as possible alternatives to antibiotics (ATAs) to buffer their overloading or abused. Recombinant microbial expression of exogenous proteins is a mature technology, but there are still limitations, such as low yield, high cost, toxicity, and loss of bioactivity, especially for AMPs. Digesting and integrating the merits of the four typical microbial recombination systems of AMPs would help to unblock the bottleneck of suicide expression, subdivide pathways and protocols in details, validate technical scaffolds of recombination procedures, patch up the short-slab of post-transformational modification and weak-stabilization, merge the gap of the various AMP R&D pipeline-networks, and finally lay a foundation for the druggability basis as a package solution and tool box focusing on digging and developing new types of AMP candidate. Finally, a constructive expert opinion about the future R&D direction and roadmap of AMP as a new drugs is presented for the purpose of unchoking R&D pipeline of AMP with high yield and low cost via heterologous expression.},
 author = {Xuan Li and Ya Hao and Da Teng and Ruoyu Mao and Na Yang and Jianhua Wang},
 doi = {https://doi.org/10.1016/j.cej.2025.170733},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Antimicrobial peptides, Microbial hetero-expression systems, R&D pipeline and scaffold, High yield and low cost, Expert opinion},
 pages = {170733},
 title = {Review on microbial recombination expression of antimicrobial peptides},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894725115787},
 volume = {525},
 year = {2025}
}
