@inproceedings{1181009,
 abstract = {Proposed a new primitive-structure-based approach for extracting rectangular building from aerial urban images. We obtained all kinds of primitive-structure that compose a rectangle by analysing geometrical primitive structure from the straight-line-graph that has been produced by edge-detection and contour-tracking and straight-line-splitting, then merge these primitive structures to rectangles through the merging arithmetic. The experimental results show that the approach is many times computationally faster than previous methods. The results of performance assessment also support the robustness and precision of the approach developed.},
 author = {Wen-bing Tao and Jin-wen Tian and Jian Liu},
 booktitle = {6th International Conference on Signal Processing, 2002.},
 doi = {10.1109/ICOSP.2002.1181009},
 issn = {},
 keyword = {Image edge detection;Arithmetic;Shape;Object detection;Artificial intelligence;Intelligent structures;Merging;Urban areas;Automotive materials;Laboratories},
 month = {Aug},
 number = {},
 pages = {143-146 vol.1},
 title = {A new approach to extract rectangular building from aerial urban images},
 volume = {1},
 year = {2002}
}
