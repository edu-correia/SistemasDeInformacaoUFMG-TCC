@inproceedings{1527813,
 abstract = {A 3D surface reconstruction method of medical images based on modularization is proposed in this paper. First, an appropriate segmentation method is applied to its slices using features of the original medical image, and the segmentation result is used as the input of "marching cubes" to generate accurate isosurfaces. Then, a voxel-tracing algorithm is developed based on the relativity of triangles of the isosurfaces. Finally, the vertexes are merged according to some constraints. Experimental results demonstrate that the method was efficient and effective.},
 author = {Bin Lee and Lian-Fang Tian and Chen Ping and Hong-Qiang Mo and Zong-Yuan Mao},
 booktitle = {2005 International Conference on Machine Learning and Cybernetics},
 doi = {10.1109/ICMLC.2005.1527813},
 issn = {2160-1348},
 keyword = {Surface reconstruction;Reconstruction algorithms;Biomedical imaging;Image segmentation;Image reconstruction;Medical diagnostic imaging;Isosurfaces;Surface morphology;Rendering (computer graphics);Educational institutions;Marching Cubes;segmentation;3D reconstruction;voxel tracing;vertex merging},
 month = {Aug},
 number = {},
 pages = {4942-4945 Vol. 8},
 title = {A fast accurate 3D surface reconstruction method of medical image based on modularization},
 volume = {8},
 year = {2005}
}
