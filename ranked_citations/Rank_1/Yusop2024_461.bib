@article{Yusop2024_461,
 abstract = {Abstract: This research aims to enhance our understanding of wave climate in ocean wave studies by creating a buoy-based system equipped with gyroscopes and accelerometers. This system allows for accurate measurement and analysis of ocean wave profiles, with primary objectives including the conversion of wave heave motion into electricity and forecasting wave strength for coastal erosion evaluations. The study's main goals encompass the development and integration of gyroscopes and accelerometers into the buoy system, the deployment of the device to collect wave profile data, and the analysis of this data using specialized software. The research culminated in the successful creation of a buoy capable of accurately measuring wave acceleration, velocity, and displacement with an approximate accuracy of 90%. This significant accomplishment advances ocean wave research and offers vital insights for sustainable coastal management, bolstering our grasp of wave climate and promoting informed decision-making and effective strategies to counter coastal erosion.},
 author = {Yusop, Z. M. and Khan, M. F. I. Y. and Jusoh, M. A. and Albani, A. and Ibrahim, M. Z. and Yahya, M. S. and Salleh, M. H. M.},
 doi = {10.22201/icat.24486736e.2024.22.2.2339},
 number = {2},
 pages = {243--250},
 title = {A non-intrusive wave measurement device for accurate analysis and real-time data},
 volume = {22},
 year = {2024}
}
