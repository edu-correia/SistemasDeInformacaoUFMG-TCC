@inproceedings{5045990,
 abstract = {We introduced discrete wavelet transform (DWT) to vector quantization (VQ) for image compression. DWT is multi-resolution analysis, and a signal energy concentrates to specific DWT coefficients. This characteristics is useful for image compression. DWT coefficients are compressed using VQ with variable block size. To perform effective compression, blocks are merged by the algorithm proposed in this paper. Results of computational experiments show that our algorithm is effective compared with the performance of the previous proposed algorithm.},
 author = {Yamanaka, Osamu and Yamaguchi, Tsuyoshi and Maeda, Junji and Suzuki, Yukinori},
 booktitle = {2008 IEEE Conference on Soft Computing in Industrial Applications},
 doi = {10.1109/SMCIA.2008.5045990},
 issn = {},
 keyword = {Image coding;Wavelet transforms;Vector quantization;Discrete wavelet transforms;Space technology;Computer science;Systems engineering and theory;Communication channels;Transform coding;Bandwidth},
 month = {June},
 number = {},
 pages = {359-364},
 title = {Image compression using wavelet transform and vector quantization with variable block size},
 volume = {},
 year = {2008}
}
