@article{Dey2015_342,
 abstract = {This paper presents low velocity impact response of functionally graded pretwisted conical shells. The modiﬁed Hertzian contact law which accounts for permanent indentation is utilized to compute the contact force and other impact parameter. The time dependent equations are solved by Newmark's time integration scheme. An eight noded isoparametric quadratic element is employed in the present ﬁnite element formulation. A parametric study is carried out to investigate the effects of triggering parameters like initial velocity of impactor, twist angle, oblique impact angle, location of impact for Stainless Steel-Nickel functionally graded conical shell subjected to low velocity impact.},
 author = {Dey, Sudip and Adhikari, Sondipon and Karmakar, Amit},
 doi = {10.1590/1679-78251382},
 number = {1},
 pages = {133--152},
 title = {Impact response of functionally graded conical shells},
 volume = {12},
 year = {2015}
}
