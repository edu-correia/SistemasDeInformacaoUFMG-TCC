@conference{Ehlers2007,
 abstract = {The very high resolution sensors offer great potential for advanced environmental mapping and monitoring. What are also required, however, are new data integration and fusion techniques that can combine multispectral remote sensing images of lower resolution with panchromatic images of higher spatial resolution and/or with GIS information. A disadvantage of most pansharpening techniques is that they change the original spectral characteristics which makes further automatic analysis (e.g. classification) error prone. A new fusion technique that is based on IHS and Fourier transforms creates fused datasets of enhanced spatial appearance while preserving the original spectral characteristics. For visual analysis, feature based image enhancement techniques are presented which make use of existing GIS information.},
 author = {Ehlers, M.},
 journal = {Proceedings, 32nd International Symposium on Remote Sensing of Environment: Sustainable Development Through Global Earth Observations},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Remote sensing and GIS fusion techniques for environmental mapping and monitoring},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84880008839?origin=resultslist},
 year = {2007}
}
