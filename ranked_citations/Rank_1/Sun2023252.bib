@article{Sun2023252,
 abstract = {Referring expression comprehension aims to locate a target object in an image described by a referring expression, where extracting semantic and discriminative visual information plays an important role. Most existing methods either ignore attribute information or context information in the model learning procedure, thus resulting in less effective visual features. In this paper, we propose a Multi-level Attention Network (MANet) to extract the target attribute information and the surrounding context information simultaneously for the target object, where the Attribute Attention Module is designed to extract the fine-grained visual information related to the referring expression and the Context Attention Module is designed to merge the context information of surroundings to learn more discriminative visual features. Experiments on various common benchmark datasets show the effectiveness of our approach. © 2023 Elsevier B.V.},
 author = {Sun, Yanfeng and Zhang, Yunru and Jiang, Huajie and Hu, Yongli and Yin, Baocai},
 doi = {10.1016/j.patrec.2023.07.005},
 journal = {Pattern Recognition Letters},
 note = {Cited by: 3},
 pages = {252 - 258},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi-level attention for referring expression comprehension},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85164658418?origin=resultslist},
 volume = {172},
 year = {2023}
}
