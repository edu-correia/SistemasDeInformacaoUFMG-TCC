@article{YANG2023108028,
 abstract = {Efficient road freespace (RFS) extraction is an important element in autonomous driving. In this article, a method based on line segments is proposed for the extraction RFS of low curvature (maximum curvature of the boundary of 27). The process is made up of three parts. First, the multisource data were fused to correct the distorted point cloud. Second, we extracted the road surface point cloud within the region of interest (ROI) and generated road boundary lines. Third, the obstacles on the road were segmented in accordance with the spatial association features of the line segments, followed by the elimination of pseudo obstacles. Finally, the road boundary, the road surface point cloud, the pseudo obstacles point cloud, and the obstruct obstacles point cloud were merged to obtain and visualize the RFS. The experimental results showed that the TPR, FPR and accuracy of the proposed method with Velodyne VLP-16 LiDAR point cloud data were 98.54%, 9.27% and 97.57% for semistructured roads and 97.78%, 4.57% and 97.55% for unstructured roads, respectively. The mean processing speeds for a single frame were 57 ms/frame for semistructured roads and 61 ms/frame for unstructured roads. The RFS acquired in this article can provide the fundamental outcomes of perception for dynamic planning and decision-making of agricultural machinery autonomous driving.},
 author = {Lili Yang and Yuanyuan Xu and Yuanbo Li and Mengshuai Chang and Zhibo Chen and Yubin Lan and Caicong Wu},
 doi = {https://doi.org/10.1016/j.compag.2023.108028},
 issn = {0168-1699},
 journal = {Computers and Electronics in Agriculture},
 keyword = {Field road, Freespace, Distortion, Pseudo obstacle, LiDAR},
 pages = {108028},
 title = {Real-Time field road freespace extraction for agricultural machinery autonomous driving based on LiDAR},
 url = {https://www.sciencedirect.com/science/article/pii/S0168169923004167},
 volume = {211},
 year = {2023}
}
