@conference{Lee20181043,
 abstract = {The Internet of Things (IoT) is a new technology that makes our world smarter and smart home is a representative example of IoT. In a smart home environment, smart door locks, lights, security cameras, and home appliances are connected to the Internet, so through this technology user could monitor and control everything in anytime and anywhere. In addition, with the rapid development of connected car technology, converged use cases of smart home and connected vehicles are supposed to be more and more important in the market. In this paper, we introduce bridging system to integrate smart home devices with connected vehicles based on the promising de-facto standards. In addition, as a proof of concept we implement a reference implementation to verify the feasibility. Finally we summarize the issues to be solved in the future. © 2018 IEEE.},
 author = {Lee, Wonsuk and Lee, Seungyun},
 doi = {10.1109/ICTC.2018.8539351},
 journal = {9th International Conference on Information and Communication Technology Convergence: ICT Convergence Powered by Smart Intelligence, ICTC 2018},
 note = {Cited by: 0},
 pages = {1043 - 1048},
 publication_stage = {Final},
 source = {Scopus},
 title = {Design and Implementation of Bridging System for Integrating Smart Home with Connected Vehicles},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85059448715?origin=resultslist},
 year = {2018}
}
