@article{Kjolstad2017,
 abstract = {Tensor algebra is a powerful tool with applications in machine learning, data analytics, engineering and the physical sciences. Tensors are often sparse and compound operations must frequently be computed in a single kernel for performance and to save memory. Programmers are left to write kernels for every operation of interest, with different mixes of dense and sparse tensors in different formats. The combinations are infinite, which makes it impossible to manually implement and optimize them all. This paper introduces the first compiler technique to automatically generate kernels for any compound tensor algebra operation on dense and sparse tensors. The technique is implemented in a C++ library called taco. Its performance is competitive with best-in-class hand-optimized kernels in popular libraries, while supporting far more tensor operations. © 2017 Copyright held by the owner/author(s).},
 author = {Kjolstad, Fredrik and Kamil, Shoaib and Chou, Stephen and Lugato, David and Amarasinghe, Saman},
 doi = {10.1145/3133901},
 journal = {Proceedings of the ACM on Programming Languages},
 note = {Cited by: 296; All Open Access; Hybrid Gold Open Access},
 number = {OOPSLA},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {The tensor algebra compiler},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85120107865?origin=resultslist},
 volume = {1},
 year = {2017}
}
