@article{DONG2025112270,
 abstract = {ABSTRACT
Graphdiyne (GDY), a two-dimensional carbon allotrope that merges sp²-hybridized benzene rings with sp-hybridized diacetylenic bonds (–CC–CC–), has attracted explosive academic–industrial interests since Li et al. reported its scalable synthesis in 2010. Its oxidized derivative, graphdiyne oxide (GDYO), is obtained by controlled oxidative protocols that preserve the intrinsic alkyne–benzene framework and tunable pore channels while grafting high densities of –OH, –COOH, and –O– moieties. These oxygen functionalities simultaneously boost hydrophilicity, defect density, and surface reactivity, endowing GDYO with performance metrics unattainable in pristine GDY. Consequently, GDYO is rapidly becoming a cross-disciplinary platform for photochemistry, electrocatalysis, energy storage/conversion, nanoelectronics, biomedicine, and environmental remediation. Although GDY has been extensively reviewed, a dedicated, critical survey of GDYO is still lacking. The present article fills this gap by (1) dissecting the molecular-level structure–oxidation relationship, (2) benchmarking state-of-the-art synthetic and processing strategies, and (3) evaluating GDYO-based nanomaterials in catalysis, energy devices, biology and environmental safety, thereby providing a roadmap for future research and commercialization.},
 author = {Yue-Ru Dong and Wen-Long Yang},
 doi = {https://doi.org/10.1016/j.cclet.2025.112270},
 issn = {1001-8417},
 journal = {Chinese Chemical Letters},
 keyword = {Graphdiyne oxide, Preparation, Catalysis, Energy storage and conversion, Biological application, Environmental safety},
 pages = {112270},
 title = {Synthesis and applications of graphdiyne oxide},
 url = {https://www.sciencedirect.com/science/article/pii/S1001841725014470},
 year = {2025}
}
