@conference{Hu201453,
 abstract = {Semantic feature extraction technique for human bodies is essential for some application, such as reverse engineering, mannequin dimensions extraction and parametric design of mannequins. This paper present a method on 2D orthographic projection to extract the semantic feature of 3D human model. Firstly, we get the human models orthographic projection and use a new intelligent contour tracking algorithm to get the ordered silhouettes. Secondly, semantic features of the human body model are extracted from the silhouettes which is ordered by CCW counter clockwise before in orthographic projection. Compared with earlier approach, our method pointedly has avoided the complex extracted for 3D mesh surface, and both the robustness and the efficiency of the algorithm are improved. © 2014 IEEE.},
 author = {Hu, Yuhui and Wang, Jianping and Jiang, Tao and Lin, Shujin},
 doi = {10.1109/ICDH.2014.18},
 journal = {Proceedings - 2014 International Conference on Digital Home, ICDH 2014},
 note = {Cited by: 3},
 pages = {53 - 57},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic feature extraction of 3D human model from 2D orthographic projection},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84925444724?origin=resultslist},
 year = {2014}
}
