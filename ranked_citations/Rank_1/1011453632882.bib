@article{10.1145/3632882,
 abstract = {We present a type system that combines, in a controlled way, first-order polymorphism with intersection types, union types, and subtyping, and prove its safety. We then define a type reconstruction algorithm that is sound and terminating. This yields a system in which unannotated functions are given polymorphic types (thanks to Hindley-Milner) that can express the overloaded behavior of the functions they type (thanks to the intersection introduction rule) and that are deduced by applying advanced techniques of type narrowing (thanks to the union elimination rule). This makes the system a prime candidate to type dynamic languages.},
 address = {New York, NY, USA},
 articleno = {40},
 author = {Castagna, Giuseppe and Laurent, Micka\"{e}l and Nguy\~{\^e}n, Kim},
 doi = {10.1145/3632882},
 issue_date = {January 2024},
 journal = {Proc. ACM Program. Lang.},
 keyword = {polymorphism, union types, intersection types, type reconstruction.},
 month = {January},
 number = {POPL},
 numpages = {32},
 publisher = {Association for Computing Machinery},
 title = {Polymorphic Type Inference for Dynamic Languages},
 url = {https://doi.org/10.1145/3632882},
 volume = {8},
 year = {2024}
}
