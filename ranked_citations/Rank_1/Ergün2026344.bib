@article{Ergün2026344,
 abstract = {Traffic congestion remains a major social issue, necessitating the development of advanced traffic signal control systems. Achieving precise and real-time adaptive control often requires the installation of sensors at a vast number of intersections, but this is cost-prohibitive. To overcome this challenge, a pheromone-based traffic information interpolation system is proposed, providing real-time traffic data for intersections without sensors. This innovative approach leverages principles inspired by pheromone trails in nature to interpolate traffic information, offering a cost-effective and efficient alternative. The methodology exhibits exceptional interpolation performance, particularly under conditions of heavy traffic flow, surpassing the capabilities of traditional statistical and machine learning-based methods. It is also adept at responding to sudden changes in traffic flow, ensuring reliable and continuous traffic management. Despite these advantages, the system’s accuracy diminishes at intersections where traffic flows merge, posing a significant challenge. To address this issue, an enhanced pheromone-based interpolation method tailored for intersections with merging traffic flows is introduced. This refined approach maintains high interpolation accuracy even in complex traffic scenarios, ensuring comprehensive and adaptive traffic data coverage. Extensive simulations and real-world testing demonstrate the robustness and reliability of the proposed system, highlighting its potential to revolutionize traffic management and alleviate congestion in urban areas. By reducing the need for extensive sensor installations, the pheromone-based system offers a scalable and economically viable solution for modern traffic control challenges. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
 author = {Ergün, Serap},
 doi = {10.1007/978-3-032-01948-6_22},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 0},
 pages = {344 - 360},
 publication_stage = {Final},
 source = {Scopus},
 title = {Innovative Traffic Information Interpolation Using Pheromone-Based Model},
 type = {Conference paper},
