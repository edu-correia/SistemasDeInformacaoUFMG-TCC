@article{MOLAAKBARI2026107747,
 abstract = {Glioblastoma (GBM) is one of the most aggressive forms of brain cancer, known for its rapid tumor growth and a high propensity for invasiveness. The treatment of GBM is particularly challenging due to the presence of the blood-brain barrier (BBB), which severely limits the effectiveness of many therapeutic agents. This research addresses these challenges by developing a novel drug delivery system based on a hydroxychloroquine/CdS/MIL-125(Ti) nanocomposite (NHC) designed for targeted therapy against U87MG GBM cells, while also evaluating its effects on 3T3 fibroblast cells to assess the specificity and systemic safety of the treatment. The NHC was synthesized by integrating CdS quantum dots with a MIL-125(Ti) metal-organic framework that effectively encapsulates hydroxychloroquine, a well-studied drug recognized for its anticancer properties. This innovative nanocomposite not only serves as a drug delivery platform but also incorporates photodynamic therapy (PDT). By merging the therapeutic effects of hydroxychloroquine with the localized action of PDT, this approach aims to enhance the overall treatment efficacy while reducing systemic toxicity. Comprehensive characterization techniques, including Fourier-transform infrared spectroscopy (FTIR), scanning electron microscopy (SEM), energy-dispersive X-ray spectroscopy (EDX), and Brunauer-Emmett-Teller (BET) analysis, confirmed the successful synthesis and functional effectiveness of the NHC. These analyses demonstrated optimal particle size distribution, high drug entrapment efficiency, and remarkable stability under physiological conditions—critical factors that enhance drug availability at the tumor site. In silico studies indicated strong binding interactions between the NHC components and key pro-apoptotic proteins, Bax and Bcl-2, suggesting an enhanced apoptotic effect in GBM cells upon treatment. These molecular interactions were further validated by in vitro assays, which exhibited significant cytotoxic effects of the NHC against U87MG GBM cells, while demonstrating much lower toxicity towards 3T3 fibroblast cells. This selectivity signifies the potential of the NHC to differentiate between cancerous and normal cells, leading to more effective and safer treatment options. Moreover, in vivo evaluations using the chick embryo yolk sac membrane (YSM) assay illustrated the NHC's remarkable ability to inhibit angiogenesis, a crucial mechanism for tumor growth and metastasis. The significant disruption of the tumor's blood supply underscores the NHC's dual capability to target tumor cells directly and to interfere with the tumor's environment, further amplifying its therapeutic potential. In conclusion, this study highlights the promise of NHC nanocomposites as a groundbreaking platform for drug delivery in the treatment of GBM. By integrating advanced nanomaterials with photodynamic therapy, this innovative approach not only targets tumors effectively but also reduces the risk of systemic side effects. These findings pave the way for further clinical applications and development strategies in the fight against one of the most formidable challenges in oncology.},
 author = {Elaheh Molaakbari and Iraj Sharifi and Ahmad Khosravi and Ehsan Salarkia and Mohammad Reza Aallaei and Alireza Keyhani and Maryam {Hakimi Parizi} and Mehdi Bamorovat},
 doi = {https://doi.org/10.1016/j.jddst.2025.107747},
 issn = {1773-2247},
 journal = {Journal of Drug Delivery Science and Technology},
 keyword = {Glioblastoma, Drug delivery system, Hydroxychloroquine, CdS/MIL-125(Ti) nanocomposite, Photodynamic therapy, Metal-organic frameworks},
 pages = {107747},
 title = {Synergistic effects of Hydroxychloroquine/CdS nanocomposites and photodynamic therapy in glioblastoma treatment},
 url = {https://www.sciencedirect.com/science/article/pii/S1773224725011505},
 volume = {115},
 year = {2026}
}
