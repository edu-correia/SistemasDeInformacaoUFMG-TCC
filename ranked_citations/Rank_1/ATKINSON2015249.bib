@incollection{ATKINSON2015249,
 abstract = {Three assessment approaches, each with different conceptualizations of intelligence and why it should be measured, are reviewed. The defining feature of psychometric assessment is its empiricism. The approach rests on strong method but its theoretical origins are slim. Exploiting both these factors, psychometricians bootstrapped a structure of intelligence model, reduced (sub)cultural bias, and increased remedial utility in these tests. The tests are still criticized, however, for their limited sampling of the intelligence domain. Psychometric tests are good classifiers and predictors in academic and work contexts. Focusing not on what an examinee knows but how he/she reasons, neuropsychological approaches rest on theories of brain function to assess the process of cognition. Empirical considerations remain important but are subsumed by theory. Although on introduction these tests had severe limitations, second-generation neuropsychologically based intelligence tests work with improved psychometrics and a better match of subtests to theory. Psychometric and neuropsychologically based approaches are showing a trend toward integration, both in terms of utilizing converging theoretical models and as practitioners increasingly rely on cross-battery assessment. This merged approach appears the way of the future; psychometric and neuropsychologically based frameworks have both demonstrated that they can generate novel findings and seamlessly incorporate new cognitive advances. The third approach, dynamic assessment of intellectual functioning, incorporates varied interactive evaluation procedures to assess and modify learning potential. The strength of dynamic assessment lies in its individualized, remediation-based reconceptualization of intellect and its attention to bias. While ambitious and still widely used, research in the approach is subsiding, as is practice. The dynamic approach will likely fade from mainstream assessment, although its emphases on reducing test bias and targeting remediation will remain a legacy.},
 address = {Oxford},
 author = {Leslie Atkinson},
 booktitle = {International Encyclopedia of the Social & Behavioral Sciences (Second Edition)},
 doi = {https://doi.org/10.1016/B978-0-08-097086-8.21036-2},
 edition = {Second Edition},
 editor = {James D. Wright},
 isbn = {978-0-08-097087-5},
 keyword = {Assessment, Binet, Cognition, Dynamic assessment, Intelligence, Measurement, Neuropsychological assessment, Norm referencing, Psychometric assessment, Vygotsky},
 pages = {249-254},
 publisher = {Elsevier},
 title = {Intellectual Functioning, Assessment of},
 url = {https://www.sciencedirect.com/science/article/pii/B9780080970868210362},
 year = {2015}
}
