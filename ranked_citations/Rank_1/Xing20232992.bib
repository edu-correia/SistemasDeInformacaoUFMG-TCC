@conference{Xing20232992,
 abstract = {Table structure recognition (TSR) aims at extracting tables in images into machine-understandable formats. Recent methods solve this problem by predicting the adjacency relations of detected cell boxes, or learning to generate the corresponding markup sequences from the table images. However, they either count on additional heuristic rules to recover the table structures, or require a huge amount of training data and time-consuming sequential decoders. In this paper, we propose an alternative paradigm. We model TSR as a logical location regression problem and propose a new TSR framework called LORE, standing for LOgical location REgression network, which for the first time combines logical location regression together with spatial location regression of table cells. Our proposed LORE is conceptually simpler, easier to train and more accurate than previous TSR models of other paradigms. Experiments on standard benchmarks demonstrate that LORE consistently outperforms prior arts. Code is available at https://github.com/AlibabaResearch/AdvancedLiterateMachinery/tree/main/DocumentUnderstanding/LORE-TSR.  Copyright © 2023, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
 author = {Xing, Hangdi and Gao, Feiyu and Long, Rujiao and Bu, Jiajun and Zheng, Qi and Li, Liangcheng and Yao, Cong and Yu, Zhi},
 doi = {10.1609/aaai.v37i3.25402},
 journal = {Proceedings of the 37th AAAI Conference on Artificial Intelligence, AAAI 2023},
 note = {Cited by: 36; All Open Access; Gold Open Access},
 pages = {2992 - 3000},
 publication_stage = {Final},
 source = {Scopus},
 title = {LORE: Logical Location Regression Network for Table Structure Recognition},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85167986061?origin=resultslist},
 volume = {37},
 year = {2023}
}
