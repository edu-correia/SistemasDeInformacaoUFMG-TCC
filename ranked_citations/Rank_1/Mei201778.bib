@conference{Mei201778,
 abstract = {Effective and efficient automatic container code recognition (ACCR) is an important part of Intelligent port management. Due to the severity of nonuniform illumination and invalidation of color information, higher sensitivity and intelligence are required in ACCR. To address this issue, a novel Framework for container code-character recognition based on deep learning and template matching (TM) in visual images is proposed in this paper. In this framework, convolutional neural network (CNN) algorithm and TM algorithm are applied to recognize the container code-character, respectively. Then, the container code is obtained by combining all characters recognized according to the credibility of each character and the verification rule of container code. The experimental results demonstrate the effectiveness of the proposed method, which can successfully recognize the container code in complicated situations. © 2016 IEEE.},
 author = {Mei, Langqi and Guo, Jianming and Liu, Qing and Lu, Pingping},
 doi = {10.1109/ICIICII.2016.0030},
 journal = {Proceedings - 2016 International Conference on Industrial Informatics - Computing Technology, Intelligent Technology, Industrial Information Integration, ICIICII 2016},
 note = {Cited by: 22},
 pages = {78 - 82},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Novel Framework for Container Code-Character Recognition Based on Deep Learning and Template Matching},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85015163677?origin=resultslist},
 year = {2017}
}
