@article{Rocha202186,
 abstract = {This paper contains a proposal to assign points to clusters, represented by their centers, based on weighted expected distances in a cluster analysis context. The proposed clustering algorithm has mechanisms to create new clusters, to merge two nearby clusters and remove very small clusters, and to identify points ‘noise’ when they are beyond a reasonable neighborhood of a center or belong to a cluster with very few points. The presented clustering algorithm is evaluated using four randomly generated and two well-known data sets. The obtained clustering is compared to other clustering algorithms through the visualization of the clustering, the value of the DB validity measure and the value of the sum of within-cluster distances. The preliminary comparison of results shows that the proposed clustering algorithm is very efficient and effective. © 2021, Springer Nature Switzerland AG.},
 author = {Rocha, Ana Maria A. C. and Costa, M. Fernanda P. and Fernandes, Edite M. G. P.},
 doi = {10.1007/978-3-030-91885-9_7},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {86 - 101},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Simple Clustering Algorithm Based on Weighted Expected Distances},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85121786418?origin=resultslist},
 volume = {1488 CCIS},
