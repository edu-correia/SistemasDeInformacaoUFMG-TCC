@article{MENG2025102492,
 abstract = {Flexible polymer dielectrics merging high dielectric constant (ε) and breakdown strength (Eb) but low dielectric loss (tanδ) have attracted widespread attention in advanced electronic devices. To concurrently elevate the ε and Eb and restrain the tanδ in barium titanate (BT)/poly (vinylidene fluoride, PVDF) nanocomposites, a variety of core@shell structured BT@Al2O3 (aluminum oxide) nanofillers with diverse thicknesses were fabricated and incorporated into PVDF. The results uncover that the Al2O3 interlayer not only synergistically regulates both intra-particle and inter-particle polarizations leading to evidently improved ε, but also confines the free carriers’ long-range migration resulting in suppressed leakage conductivity and loss. Furthermore, the interlayer efficiently mitigates the intense dielectric mismatch between BT nanoparticles and PVDF, inhibiting local electric field distortion, and induces traps to capture moving carriers and lifts the energy barrier height for de-trapping thus leading to evidently enhanced Eb. Theoretical fitting of experimental findings via the Havriliak-Negami equation reveals the underlying multiple polarization mechanisms and the Al2O3 shell impact on the charge carrier migration within the nanocomposites. The prepared BT@Al2O3/PVDF nanocomposites with simultaneously high ε and Eb but low tanδ present prospective applications in advanced electronic devices and power equipment.},
 author = {Xingxing Meng and Wenying Zhou and Xiaolong Chen and Fanrong Kong and Jiahuan Zhao and Weiwei Li and Yanqing Zhang and Fang Wang and Mengxue Yuan},
 doi = {https://doi.org/10.1016/j.mtchem.2024.102492},
 issn = {2468-5194},
 journal = {Materials Today Chemistry},
 keyword = {Polymer nanocomposites, Interface, Dielectric properties, Polarization},
 pages = {102492},
 title = {Synergistic regulation of intra-particle and inter-particle polarizations in BaTiO3@Al2O3/PVDF nanocomposites towards boosted overall dielectric properties},
 url = {https://www.sciencedirect.com/science/article/pii/S2468519424005986},
 volume = {43},
 year = {2025}
}
