@inproceedings{6316593,
 abstract = {Network coding brings a new solution for IP congestion control, since more than one buffered packets can be encoded together and removed as a coded packet. This may significantly decrease the packet loss during the congestion, but at the cost of building redundant paths. However, how to minimize the overhead of redundant paths turns out to be a NP-hard problem. In this paper, we propose a novel approximation algorithm called FlowGrouping, which transforms the redundant paths building problem into a limited clique partition problem by increasing edge weights, and can find a good approximate solution within O(n3) computation time.},
 author = {Yuan, Yuan and Liu, Shengyun and Peng, Yuxing},
 booktitle = {2011 6th International Conference on Computer Sciences and Convergence Information Technology (ICCIT)},
 doi = {},
 issn = {},
 keyword = {Encoding;Partitioning algorithms;Buildings;Merging;Approximation methods;Network coding;IP networks;network coding;redundant path;IP congestion control},
 month = {Nov},
 number = {},
 pages = {144-149},
 title = {Minimizing redundant paths for coding-based IP congestion control},
 volume = {},
 year = {2011}
}
