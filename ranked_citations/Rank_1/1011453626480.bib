@article{10.1145/3626480,
 abstract = {Human activities can introduce variations in various environmental cues, such as light and sound, which can serve as inputs for interfaces. However, one often overlooked aspect is the airflow variation caused by these activities, which presents challenges in detection and utilization due to its intangible nature. In this paper, we have unveiled an approach using mist to capture invisible airflow variations, rendering them detectable by Time-of-Flight (ToF) sensors. We investigate the capability of this sensing technique under different types of mist or smoke, as well as the impact of airflow speed. To illustrate the feasibility of this concept, we created a prototype using a humidifier and demonstrated its capability to recognize motions. On this basis, we introduce potential applications, discuss inherent limitations, and provide design lessons grounded in mist-based airflow sensing.},
 address = {New York, NY, USA},
 articleno = {444},
 author = {Min, Tian and Xia, Chengshuo and Yamamoto, Takumi and Sugiura, Yuta},
 doi = {10.1145/3626480},
 issue_date = {December 2023},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {motion recognition, mist, interaction},
 month = {November},
 number = {ISS},
 numpages = {22},
 publisher = {Association for Computing Machinery},
 title = {Seeing the Wind: An Interactive Mist Interface for Airflow Input},
 url = {https://doi.org/10.1145/3626480},
 volume = {7},
 year = {2023}
}
