@conference{Fürstenau2012180,
 abstract = {We present a method for learning syntaxsemantics mappings for verbs from unannotated corpora. We learn linkings, i.e., mappings from the syntactic arguments and adjuncts of a verb to its semantic roles. By learning such linkings, we do not need to model individual semantic roles independently of one another, and we can exploit the relation between different mappings for the same verb, or between mappings for different verbs. We present an evaluation on a standard test set for semantic role labeling. © 2012 Association for Computational Linguistics.},
 author = {Fürstenau, Hagen and Rambow, Owen},
 journal = {*SEM 2012 - 1st Joint Conference on Lexical and Computational Semantics},
 note = {Cited by: 6},
 pages = {180 - 188},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unsupervised induction of a syntax-semantics lexicon using iterative refinement},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84876810809?origin=resultslist},
 volume = {1},
 year = {2012}
}
