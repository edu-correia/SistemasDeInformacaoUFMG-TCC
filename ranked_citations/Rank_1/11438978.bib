@inproceedings{11438978,
 abstract = {The Geo-Spatial Accident Risk Prediction System is an AI-driven analytical system meant to assess and predict accident severity by merging geolocation data with environmental, temporal, vehicular, and road infrastructure parameters. Utilizing machine learning models, the system evaluates user inputs through structured encoding, scaling, and feature selection to create accurate and trustworthy risk estimates. Users may more clearly comprehend spatial accident patterns and contributing variables thanks to its interactive Stream Light interface, which combines geospatial mapping, probability representations, and automated risk-factor analysis. By identifying high-risk scenarios and delivering actionable safety suggestions, the system aids urban planners, traffic authorities, and legislators in implementing proactive, data-driven safety initiatives. This geo-intelligent prediction model boosts situational awareness, strengthens preventive methods, and creates safer transportation ecosystems.},
 author = {C, Nandhakumar and D, Barani and R, Himasree and S, Malavikaa},
 booktitle = {2026 6th International Conference on Image Processing and Capsule Networks (ICIPCN)},
 doi = {10.1109/ICIPCN67432.2026.11438978},
 issn = {},
 keyword = {Image coding;Biological system modeling;Roads;Merging;Transportation;Machine learning;Predictive models;Safety;Risk management;Accidents;Geo-Spatial Analysis;Accident Severity Prediction;Machine Learning;Risk Assessment},
 month = {Jan},
