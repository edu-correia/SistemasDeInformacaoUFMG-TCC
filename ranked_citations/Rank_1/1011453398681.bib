 keyword = {Sparse suffix sorting, alphabet reduction, deterministic algorithms, edit-sensitive parsing, online algorithms},
 month = {July},
 number = {4},
 numpages = {53},
 publisher = {Association for Computing Machinery},
 title = {Deterministic Sparse Suffix Sorting in the Restore Model},
 url = {https://doi.org/10.1145/3398681},
