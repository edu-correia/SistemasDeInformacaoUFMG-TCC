@inproceedings{4341898,
 abstract = {Inconsistency and its handling are very important in the real world and in the fields of computer science and artificial intelligence. When dealing with inconsistency in a knowledge base (KB), there is a whole host of deeper issues we need to contend with in order to develop rational and robust intelligent systems. In this paper, we focus our attention on one of the issues in handling KB inconsistency: how to measure the information content and the significance of inconsistency in a KB. Our approach is based on a fixpoint semantics for KB. The approach reflects each inconsistent set of rules in the least fixpoint of a KB and then measures the inconsistency in the context of the least fixpoint for the KB. Compared with the existing results, our approach has some unique benefits.},
 author = {Zhang, Du},
 booktitle = {6th IEEE International Conference on Cognitive Informatics},
 doi = {10.1109/COGINF.2007.4341898},
 issn = {},
 keyword = {Artificial intelligence;Intelligent systems;Ontologies;Computer science;Robustness;Merging;Knowledge based systems;Lakes;Labeling;Animals;inconsistency;fixpoint semantics;KB coherence;significance of inconsistency},
 month = {Aug},
 number = {},
 pages = {255-262},
 title = {Quantifying Knowledge Base Inconsistency via Fixpoint Semantics},
 volume = {},
 year = {2007}
}
