@conference{Badhel2026,
 abstract = {A smart solution for home automation and power preservation is presented in this article. All new technologies which merge image control, IoT, and AI were utilized as critical points of research within these papers. This also aims to optimize energy utilization mainly in household and public occupation through activating soul and motion dependent controls of electrical gadgets. Various approaches and technologies, mainly targeting image processing algorithms and motion detection, were used by these new systems in controlling energy appliances. Additionally, human-presence-detection accuracy is being maintained through integration of action recognition and object detection means, as those appliances result in changes in room occupancy and human actions (sitting, standing, or lying). Processes are more efficient with the advent of image processing and make the operations much smoother by detecting any event whatsoever. These technologies are particularly beneficial in settings like classrooms, auditoriums, offices, and homes, where human intervention is minimized, and energy consumption is optimized. By combining various smart automation approaches, the proposed systems offer a cost-effective and scalable solution for modern home automation and power management.  © 2026 IEEE.},
 author = {Badhel, Indrajeet and Ingle, Harshal and Ingle, Sanvi and Ingle, Tushar and Ingole, Kalyani and Gupta, Ishan and Desai, Sharada},
