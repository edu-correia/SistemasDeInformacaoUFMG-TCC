@incollection{RAJ2026437,
 abstract = {Polyketide synthases (PKSs) are intricate enzymes that produce a wide range of valuable natural compounds with significant medicinal properties. These compounds encompass antibiotics, antifungals, antivirals, immunosuppressive agents, and other bioactive substances that have played a pivotal role in modern medicine. PKSs are responsible for crafting complex polyketide molecules by imitating the process of fatty acid production. This involves merging basic building blocks like acetyl and malonyl groups to form a polyketide chain. Various enzymatic components within PKSs, such as ketosynthase, acyltransferase, and dehydratase, modify the chain to introduce structural diversity. These modifications include reduction, oxidation, cyclization, and methylation, resulting in unique and intricate structures. Polyketide products interact with specific biological targets, leading to therapeutic effects. Polyketides are a vital group of biologically active compounds with diverse structures that are naturally occurring. They are produced from acyl-coenzyme A substrates by polyketide synthases (PKSs), which are categorized into three types: I, II, and III. PKSs play a crucial role in the natural production of structurally complex molecules such as erythromycin, tetracycline, and rifamycin—compounds that have been foundational in clinical and veterinary medicine. As antimicrobial resistance (AMR) continues to threaten global health, understanding and leveraging PKS-mediated pathways is critical for the discovery and engineering of next-generation antibiotics.},
 author = {Rohit Raj and Abhay Chand and Sahil Mehta and Pooja Kumari},
 booktitle = {Antimicrobial Resistance in Humans, Animals, and the Environment},
 doi = {https://doi.org/10.1016/B978-0-443-33702-4.00016-5},
 editor = {Kunal Ranjan and Marcio José Poças-Fonseca and Rajani Sharma and Kunal Kumar},
 isbn = {978-0-443-33702-4},
 keyword = {Antibiotics, Antiviral property, Enzymes, Linkers, Natural product Chemistry, PKSs, Polyketide, Type I II III},
 pages = {437-452},
 publisher = {Academic Press},
 series = {Developments in Microbiology},
 title = {Chapter 17 - Role of polyketide synthase in the formation of natural products for antimicrobial use},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443337024000165},
 year = {2026}
