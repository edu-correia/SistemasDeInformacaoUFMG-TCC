 abstract = {Abstract–
Telesurgery, a frontier in telemedicine, marries surgical expertise with the forefront of technology, allowing surgeons to conduct procedures on distant patients via robotic mechanisms. The transition to Healthcare 5.0, marked by its extensive connectivity, tailored healthcare offerings, and the fusion of sophisticated technologies such as artificial intelligence, the Internet of Things, and big data analytics, has broadened the scope for telesurgery through the incorporation of metaverse concepts. The metaverse, an integrated virtual space generated through the merging of digitally enhanced physical reality, augmented reality, and the internet, introduces an innovative aspect to telesurgery, facilitating immersive, live remote medical operations. This paper investigates the prospective frameworks of telesurgery within the ambit of Healthcare 5.0, utilizing the capacities of the metaverse. It examines how these frameworks can surpass existing barriers in telesurgery by offering superior visual aids, enhancing interactions between surgeons and patients, and providing a cooperative platform for healthcare professionals, irrespective of their geographical locations. The adoption of metaverse frameworks in telesurgery could lead to more engaging training environments for surgeons, immediate collaboration among worldwide experts during intricate surgeries, and the broadening of access to premier surgical care for remote and underrepresented communities. Additionally, this study highlights the hurdles and key factors to consider when integrating metaverse frameworks into telesurgery, including cybersecurity concerns, data privacy, the necessity for stable and rapid internet connections, and the creation of uniform protocols for conducting remote surgeries. It also contemplates the impact of such technologies on surgical education, patient results, and the wider healthcare system. Utilizing the metaverse’s dynamic and interactive features within Healthcare 5.0, telesurgery frameworks have the potential to revolutionize surgical procedures. These frameworks present valuable opportunities for improving surgical accuracy, patient care, and collaboration in the medical field, ultimately aiming to fulfill the comprehensive goal of making healthcare accessible and personalized. The successful merger of telesurgery with the metaverse relies on cross-disciplinary cooperation, technological progress, and the formation of ethical and regulatory standards to manage the complexities of virtual and augmented realities in healthcare practices.},
 author = {R. Roopa and Lavanya Vudayagiri and B. {Rupa Devi} and Prakash K. LNC and Pamarthi Sunitha and Rajesh Kumar Korupalli},
 booktitle = {Metaverse in the Healthcare Industry},
 doi = {https://doi.org/10.1016/B978-0-443-30182-7.00007-5},
 editor = {Hemachandran Kannan and Shahid Mohammad Ganie and Raul Villamarin Rodriguez and Manjeet Rege and Suresh Babu Munuswamy},
 isbn = {978-0-443-30182-7},
 keyword = {Medical informatics, neurosurgery, human–computer interaction, health care, computer in society},
 pages = {199-211},
 publisher = {Elsevier},
 title = {Chapter 10 - Metaverse-assisted telesurgery in Healthcare 5.0.},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443301827000075},
 year = {2026}
