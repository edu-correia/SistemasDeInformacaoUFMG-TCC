@conference{Audebert20165091,
 abstract = {In this paper, we investigate the impact of segmentation algorithms as a preprocessing step for classification of remote sensing images in a deep learning framework. Especially, we address the issue of segmenting the image into regions to be classified using pre-trained deep neural networks as feature extractors for an SVM-based classifier. An efficient segmentation as a preprocessing step helps learning by adding a spatially-coherent structure to the data. Therefore, we compare algorithms producing superpixels with more traditional remote sensing segmentation algorithms and measure the variation in terms of classification accuracy. We establish that superpixel algorithms allow for a better classification accuracy as a homogenous and compact segmentation favors better generalization of the training samples. © 2016 IEEE.},
 author = {Audebert, Nicolas and Le Saux, Bertrand and Lefèvre, Sébastien},
 doi = {10.1109/IGARSS.2016.7730327},
 journal = {International Geoscience and Remote Sensing Symposium (IGARSS)},
 note = {Cited by: 35; All Open Access; Green Open Access},
 pages = {5091 - 5094},
 publication_stage = {Final},
 source = {Scopus},
 title = {How useful is region-based classification of remote sensing images in a deep learning framework?},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85007500060?origin=resultslist},
 volume = {2016-November},
 year = {2016}
}
