@article{Seufitelli202318,
 abstract = {We present a systematic literature review and propose a taxonomy for research at the intersection of Digital Forensics and Databases. The merge between these two areas has become more prolific due to the growing volume of data and mobile apps on the Web, and the consequent rise in cyber attacks. Our review has identified 91 relevant papers. The taxonomy categorizes such papers into: Cyber-Attacks (subclasses SQLi, Attack Detection, Data Recovery) and Criminal Intelligence (subclasses Forensic Investigation, Research Products, Crime Resolution). Overall, we contribute to better understanding the intersection between digital forensics and databases, and open opportunities for future research and development with potential for significant social, economic, and technical-scientific contributions.  © 2023 is held by the owner/author(s).},
 author = {Seufitelli, Danilo B. and Brandão, Michele A. and Fernandes, Ayane C. A. and Siqueira, Kayque M. and Moro, Mirella M.},
 doi = {10.1145/3631504.3631508},
 journal = {SIGMOD Record},
 note = {Cited by: 0},
 number = {3},
 pages = {18 - 29},
 publication_stage = {Final},
 source = {Scopus},
 title = {Where do Databases and Digital Forensics meet? A Comprehensive Survey and Taxonomy},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85176792319?origin=resultslist},
 volume = {52},
 year = {2023}
}
