@article{JIANG2026122882,
 abstract = {Infrared and visible image fusion combines key information from both modalities into a single image, enabling accurate hotspot detection and detailed texture representation. However, most existing methods lack real-image supervision, which limits their ability to effectively capture complementary features across modalities. As a result, the fused images often fail to represent targets clearly and miss important semantic details. To overcome these challenges, we propose a dependency separation guided multi-frequency wavelet semantic enhancement fusion model (DSWFusion), which achieves infrared and visible image fusion. The framework begins with a dual-branch network to process each modality and a Wavelet-Transformer Fusion Module (WTFM) that extracts time–space frequency features. A Contour-and-Texture Feature Integration Module (CTFIM) then merges initial features, while a dedicated extractor separately processes contours and fine details. This design strengthens cross-modal complementarity through attention mechanisms that connect local and global features. A Semantic Feature Enhancement Module (SFEM) further refines contour and texture representations using multi-scale convolutions. Finally, a separation-guided refinement stage boosts semantic content in the fused images. This stage reconstructs modality-specific outputs, guiding the model to focus on key semantic regions and enrich the fusion results. Experimental results show that DSWFusion achieves state-of-the-art performance in infrared and visible image fusion. The fused images contain rich semantic content, making them well-suited for downstream high-level vision tasks. Our code is available at https://github.com/XAUTjl/DSWFusion.},
 author = {Jinlin Jiang and Gang Hu and Guanglei Sheng and Guo Wei},
 doi = {https://doi.org/10.1016/j.ins.2025.122882},
 issn = {0020-0255},
 journal = {Information Sciences},
 keyword = {Image fusion, Separation guidance, Infrared and visible images multi-frequency semantic perception, Multi-scale enhancement},
 pages = {122882},
 title = {DSWFusion: Separation-guided multi-frequency semantic enhancement model for infrared and visible image fusion},
 url = {https://www.sciencedirect.com/science/article/pii/S0020025525010187},
 volume = {730},
 year = {2026}
}
