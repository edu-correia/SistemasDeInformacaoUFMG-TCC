@inproceedings{9265770,
 abstract = {The realization of fully-integrated power management remains limited by the integration of passive components, particularly inductors. In this paper we describe a silicon-integrated merged-LC resonant structure that overcomes limitations of air-core spirals through the benefits of embedded capacitance and loss reduction techniques. Fundamental structure and design optimizations are discussed and experimental performance is verified in a resonant switched-capacitor (ReSC) converter achieving 85.5% peak efficiency in a 0.18 µ m bulk CMOS process.},
 author = {McLaughlin, Prescott H. and Wu, Yue and Sullivan, Charles R. and Stauth, Jason T.},
 booktitle = {2020 IEEE 21st Workshop on Control and Modeling for Power Electronics (COMPEL)},
 doi = {10.1109/COMPEL49091.2020.9265770},
 issn = {1093-5142},
 keyword = {Windings;Spirals;Capacitance;Resonators;Conductors;Metals;Current density;resonant converters;electromagnetic resonators;spiral inductors},
 month = {Nov},
 number = {},
 pages = {1-8},
 title = {Modeling and Design of Planar-Spiral Merged-LC Resonators in a Standard CMOS Process},
 volume = {},
 year = {2020}
}
