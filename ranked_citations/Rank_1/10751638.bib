@inproceedings{10751638,
 abstract = {The e-grocery sector has experienced substantial growth due to recent advancements in technology and the internet. Nevertheless, current e-grocery enterprises require assistance in addressing individuals' challenges pertaining to recipe expertise, menu selection, and ingredient preparation in cooking. Thus, the e-grocery startup Healthin presents itself as a remedy to this issue by offering ingredient kits and using a hybrid sales strategy that combines online channels and physical storefronts. This study intends to analyse the interior design and deployment of 360° virtual tour technology in startup retail establishments in order to merge online and offline shopping experiences. In order to do this, the author utilised Sketchup software to construct an interior design for a retail store, along with a mood board as a design reference. Subsequently, the WeboBook platform was employed to develop a prototype of a 360° virtual tour. Subsequently, the author proceeded to employ the questionnaire method to gather feedback from the intended users regarding the integration of 360° virtual tours in startup retail stores. Studies indicate that the utilisation of 360° virtual tour technology enhances the consumer experience by offering a comprehensive view of products and store layout. The survey results indicated a favourable response from participants regarding the implementation of 360° virtual tour technology in startup retail outlets. However, some participants offered suggestions for future enhancement. The outcome of this study is a high-fidelity prototype of a 360° virtual tour for a startup retail company designed to enhance the digital shopping experience by providing a more immersive and visually captivating environment.},
 author = {Ambarura, Chiu Citra Anugrata and Pramono, Andi and Azzahri, Ellina Fahra and Halim, Trixie Ordelia and Prabowo, Riefky and Azis, Baskoro},
 booktitle = {2024 International Conference on ICT for Smart Society (ICISS)},
 doi = {10.1109/ICISS62896.2024.10751638},
 issn = {},
 keyword = {Surveys;Mood;Layout;Prototypes;Color;User experience;Software;Electronic commerce;Floors;Creativity;E-Grocery;Interior Design;Prototype;Retail Store;360 degree Virtual Tour},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Implementing a 360 Degree Virtual Tour in the Interior of an E-Grocery Start-Up to Increase Consumer Buying Impulse},
 volume = {},
 year = {2024}
}
