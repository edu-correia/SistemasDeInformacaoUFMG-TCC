@conference{Rezig20161378,
 abstract = {With the exponential growth of data on the Web comes the opportunity to integrate multiple sources to give more accurate answers to user queries. Upon retrieving records from multiple Web databases, a key task is to merge records that refer to the same real-world entity. We demonstrate ORLF (Online Record Linkage and Fusion), a flexible query-time record linkage and fusion framework. ORLF deduplicates newly arriving query results jointly with previously processed query results. We use an iterative caching solution that leverages query locality to effectively deduplicate newly incoming records with cached records. ORLF aims to deliver timely query answers that are duplicate-free and reflect knowledge collected from previous queries. © 2016 IEEE.},
 author = {Rezig, El Kindi and Dragut, Eduard C. and Ouzzani, Mourad and Elmagarmid, Ahmed K. and Aref, Walid G.},
 doi = {10.1109/ICDE.2016.7498349},
 journal = {2016 IEEE 32nd International Conference on Data Engineering, ICDE 2016},
 note = {Cited by: 7},
 pages = {1378 - 1381},
 publication_stage = {Final},
 source = {Scopus},
 title = {ORLF: A flexible framework for online record linkage and fusion},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84980320238?origin=resultslist},
 year = {2016}
}
