@article{9624135,
 abstract = {We present the results of a multiwavelength study of the nearby dwarf galaxy DDO 53 – a relatively isolated member of the M 81 group. We analyse the atomic and ionized gas kinematics (based on the observations with Fabry–Perot interferometer in H α line and archival data in H i 21 cm line), distribution, excitation, and oxygen abundance of the ionized gas (based on the long-slit and integral-field spectroscopy and on imaging with narrow-band filters), and their relation with the young massive stars (based on archival HST data). We detect a faint 2-kpc sized supershell of ionized gas surrounding the galaxy. Most probably, this structure represents a large-scale gas outflow, however, it could be also created by the ionizing quanta leaking from star-forming regions to the marginally detected atomic hydrogen surrounding the galactic disc. We analyse the properties of the anomalous H i in the north part of the galaxy and find that its peculiar kinematics is also traced by ionized gas. We argue that this H i feature is related to the accreting gas cloud captured from the intergalactic medium or remaining after the merger event occurred >1 Gyr ago. The infalling gas produces shocks in the interstellar medium and could support the star formation activity in the brightest region in DDO 53.},
 author = {Egorov, Oleg V and Lozinskaya, Tatiana A and Vasiliev, Konstantin I and Yarovova, Anastasiya D and Gerasimov, Ivan S and Kreckel, Kathryn and Moiseev, Alexei V},
 doi = {10.1093/mnras/stab2710},
 issn = {1365-2966},
 journal = {Monthly Notices of the Royal Astronomical Society},
 keyword = {ISM: bubbles;ISM: kinematics and dynamics;galaxies: individual: DDO 53;galaxies: irregular;galaxies: star formation},
 month = {Sep.},
 number = {2},
 pages = {2650-2667},
 title = {Star formation in the nearby dwarf galaxy DDO 53: interplay between gas accretion and stellar feedback},
 volume = {508},
 year = {2021}
}
