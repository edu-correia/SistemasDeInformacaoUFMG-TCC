@article{LU2026100204,
 abstract = {This study evaluates the low-carbon impact of a novel “permanent-temporary integration” prefabricated metro station construction method through a case study of Jinan Metro Line 8’s Youth Political Academy Station. Combining structural system innovation with prefabrication technology, the approach integrates temporary supports (e.g., retaining piles, steel bracings) into permanent structures, eliminating single-use carbon costs and reducing material waste. A comparative life cycle assessment (LCA) following ISO 14040/14044 standards revealed that the integrated system reduced total carbon emissions by 25.2 % (6374.91 t CO₂e) compared to traditional cast-in-situ methods. Key reductions stemmed from repurposing temporary supports (75.9 % of total savings) and optimizing prefabricated components in the main structure (23.2 %). The method also enhanced construction efficiency by minimizing on-site wet work and leveraging modular assembly. This research demonstrates the systemic decarbonization potential of merging permanent-temporary integration with prefabrication in urban rail transit, offering a replicable model for sustainable underground engineering under carbon neutrality goals.},
 author = {Linhai Lu and Zhenghao Liu and Chaojun Wu and Xianfeng Ma and Jiecheng Sun and Qianwei Xu},
 doi = {https://doi.org/10.1016/j.pes.2025.100204},
 issn = {2950-4252},
 journal = {Progress in Engineering Science},
 keyword = {Prefabricated metro station, Permanent-temporary integration, Life cycle assessment, Carbon emission reduction, Sustainable construction},
 number = {1},
 pages = {100204},
 title = {Low-carbon impact of new prefabricated assembly metro stations under permanent-temporary integration mode: A case study of Jinan},
 url = {https://www.sciencedirect.com/science/article/pii/S2950425225001562},
 volume = {3},
 year = {2026}
}
