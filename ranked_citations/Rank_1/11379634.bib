@inproceedings{11379634,
 abstract = {Understanding character behavior in children's literature and media is vital for both psychological analysis and educational design. In this project, the researcher suggests a smart system that aligns both Bandura Social Cognitive Theory (SCT) and hybrid Artificial Intelligence (AI) at the analysis of the character behavior in multimodal stories. It annotated and curated a wide corpus of 200 books of children and 50 animated films. The Natural Language Processing (NLP), Computer Vision (CV) and audio-based emotion recognition were used to extract behavioral cues. These characteristics were in line with the SCT constructs of observational learning, self-efficacy, and moral disengagement. The hybrid structure suggested merges the symbolic SCT rule-based reasoning and BERT-GRU neural model to predict the behavior. Scalable behavior tracking is further provided by dynamic behavioral graphs and semi-supervised label propagation. Fourteen-fold evaluation on 10 behavior categories demonstrated that the hybrid model had a maximum classification accuracy of 94.6, surpassing the standalone BERT (91.2) and SCTonly standalone models (85.3). F1-scores were above 91 (mean), and explainability scores conformed to SCT constructs were 92.3. There is cross-media consistency tests, which showed bit more than 87 % consistency in character behavior in books and in films. This framework was also strong when used in low-supervision environments, where the data only needed to be labeled 15 % to achieve an over 90 % annotation accuracy through graph-based label propagation. The study offers a pedagogically-based, explainable and scalable character behavior analysis tool. It has a lot of implications on educational content assessment, study of moral development, and critical literature written with the help of AI. The cross-media nature of the system opens the way to the cohesion of behavioral analysis in books, movies, and the interactive storytelling platforms.},
 author = {P, Vijayalakshmi and R, Rajakumari},
 booktitle = {2025 2nd International Conference on Artificial Intelligence and Knowledge Discovery in Concurrent Engineering (ICECONF)},
 doi = {10.1109/ICECONF65644.2025.11379634},
 issn = {},
