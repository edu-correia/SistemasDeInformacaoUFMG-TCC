@article{Kim20181089,
 abstract = {In this paper, we focus on the detection of the semantic and structural modifications in documents. We define the following six inter-document relations that we use to represent document modification: Eliminate, Extend, Merge, Split, Rewrite, and Reorder. We also develop a detection model based on a deep neural network to identify the relations between two given documents. We assumed that several modifications can be applied to a document; in this situation, the modifications can overlap each other, so it can be very difficult to detect the applied modifications. We represent a document pair by using a sentence-based similarity matrix, and the inter-document relations are then detected by applying the deep neural network to the similarity matrix. The experiments show that our model performed impressively in the detection of document modifications. © 2017, Springer-Verlag GmbH Germany.},
 author = {Kim, Noo-ri and Choi, YunSeok and Lee, HyunSoo and Choi, Jae-Young and Kim, Suntae and Kim, Jeong-Ah and Cho, Youngwha and Lee, Jee-Hyong},
 doi = {10.1007/s12652-017-0617-y},
 journal = {Journal of Ambient Intelligence and Humanized Computing},
 note = {Cited by: 5},
 number = {4},
 pages = {1089 - 1096},
 publication_stage = {Final},
 source = {Scopus},
 title = {Detection of document modification based on deep neural networks},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85049604413?origin=resultslist},
 volume = {9},
 year = {2018}
}
