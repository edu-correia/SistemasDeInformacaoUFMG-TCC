@article{1638015,
 abstract = {The Mars exploration rover mission has conducted continuous Mars surface operations for over 24 months to date. The operations processes and tools put in place before landing have continued to develop throughout the surface mission, evolving from a capability intended to operate for less than four months to one capable of continuing indefinitely. The MER operations design has been accepted as baseline for the Mars Science Laboratory mission, scheduled for launch in 2009. Our experiences during MER's exciting and unexpectedly extensive surface exploration phase may provide useful insights for other future long duration surface missions},
 author = {Mishkin, A.H. and Limonadi, D. and Laubach, S.L. and Bass, D.S.},
 doi = {10.1109/MRA.2006.1638015},
 issn = {1558-223X},
 journal = {IEEE Robotics & Automation Magazine},
 keyword = {Mars;Orbital robotics;Robotics and automation;Delay effects;Space vehicles;Propulsion;Soil;Merging;Telemetry;Process planning},
 month = {June},
 number = {2},
 pages = {46-53},
 title = {Working the Martian night shift - the MER surface operations process},
 volume = {13},
 year = {2006}
}
