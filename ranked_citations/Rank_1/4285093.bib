@inproceedings{4285093,
 abstract = {This paper proposes a multiple transform coding structure which processes all transforms in H.264/AVC including integer transform, 4times4 and 2times2 Hadamard transforms, and corresponding inverse transforms. In this paper, we propose a fast algorithm in which all transforms are described in identical equations. Additionally, we merges the architecture processing individual transforms into a multiple transform coding architecture according to the proposed fast algorithm and use an interlaced timing schedule to arrange the coding order of each transform. This structure is reconfigurable so as to achieve different data processing rates and therefore, it can be used in H.264/AVC coding systems of various data processing rates. The synthesis result shows that this design can achieve the requirement of real-time processing HD 1080i video at a low operating frequency of 50 MHz.},
 author = {Shi, Bing and Zheng, Wei and Li, Dongxiao and Zhang, Ming},
 booktitle = {2007 IEEE International Conference on Multimedia and Expo},
 doi = {10.1109/ICME.2007.4285093},
 issn = {1945-788X},
 keyword = {Algorithm design and analysis;Automatic voltage control;Transform coding;Data processing;Error correction;Error correction codes;Equations;Scheduling algorithm;Timing;High definition video},
 month = {July},
 number = {},
 pages = {2086-2089},
 title = {Fast Algorithm and Architecture Design for H.264/AVC Multiple Transforms},
 volume = {},
 year = {2007}
}
