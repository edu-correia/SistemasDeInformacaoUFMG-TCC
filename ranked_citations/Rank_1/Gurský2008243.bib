@article{Gurský2008243,
 abstract = {Methods of top-k search with no random access can be used to find k best objects using sorted access to the sources of attribute values. In this paper we present new heuristics over the NRA algorithm that can be used for fast search of top-k objects using wide range of user preferences. NRA algorithm usually needs a periodical scan of a large number of candidates during the computation. In this paper we propose methods of no random access top-k search that optimize the candidate list maintenance during the computation to speed up the search. The proposed methods are compared to a table scan method typically used in databases. We present results of experiments showing speed improvement depending on number of object attributes expressed in a user preferences or selectivity of user preferences. © 2008 Springer-Verlag.},
 author = {Gurský, Peter and Vojtáš, Peter},
 doi = {10.1007/978-3-540-87993-0_20},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 7},
 pages = {243 - 255},
 publication_stage = {Final},
 source = {Scopus},
 title = {Speeding up the NRA algorithm},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77049094244?origin=resultslist},
 volume = {5291 LNAI},
 year = {2008}
}
