@inproceedings{6836275,
 abstract = {This paper explores a novel stochastic optimal control method to determine conflict-free 4D (3D space and time) trajectories by considering uncertainties during flight. 4D trajectory management is a necessary concept to meet future growth in air traffic. However, aircraft may deviate from its planned 4D trajectory due to uncertainties during flight, and a conflict between aircraft can occur and lead to severe consequences. First, a probabilistic conflict detection algorithm by using the computationally efficient generalized polynomial chaos method is proposed. Conflict probability between aircraft is estimated by applying the conflict detection algorithm. In addition, a numerical algorithm incorporating the generalized polynomial chaos into the pseudospectral method is proposed to solve stochastic optimal control problems. The proposed stochastic trajectory optimization method combining the conflict detection algorithm is applied to the conflict resolution problem and generate optimal conflict-free trajectories. Through the numerical simulations for the three-dimensional conflict resolution problem between multiple heterogeneous aircraft, the performance and effectiveness of the proposed algorithm are evaluated and verified.},
 author = {Matsuno, Yoshinori and Tsuchiya, Takeshi},
 booktitle = {2014 IEEE Aerospace Conference},
 doi = {10.1109/AERO.2014.6836275},
 issn = {1095-323X},
 keyword = {Aircraft;Stochastic processes;Monte Carlo methods;Polynomials;Random variables;Trajectory;Probabilistic logic},
 month = {March},
 number = {},
 pages = {1-10},
 title = {Stochastic 4D trajectory optimization for aircraft conflict resolution},
 volume = {},
 year = {2014}
}
