 author = {Shaaban Ibrahim ali, Omar and Fournis d'Albiat, Juliette and Piedrahita, Isabel and Beltran, Vicen\c{c} and Martorell, Xavier and Carpenter, Paul and Ayguad\'{e}, Eduard and Labarta, Jesus},
 doi = {10.1145/3743134},
 issn = {1544-3566},
 issue_date = {September 2025},
 journal = {ACM Trans. Archit. Code Optim.},
 keyword = {OpenMP, OmpSs-2@Cluster, MPI, distributed computing, runtime systems, task-based programming models, iterative methods},
