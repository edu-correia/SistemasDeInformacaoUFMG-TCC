@article{10.1109/TCBB.2016.2609923,
 abstract = {This article presents two new deterministic algorithms for constructing consensus trees. Given an input of $k$&nbsp;phylogenetic trees with identical leaf label sets and $n$&nbsp;leaves each, the first algorithm constructs the majority rule&nbsp;+ consensus tree in $Ok n$ time, which is optimal since the input size is $Omega k n$, and the second one constructs the frequency difference consensus tree in $min lbrace Ok n^{2}, Ok n k + log ^{2}nrbrace$ time.},
 address = {Washington, DC, USA},
 author = {Jansson, Jesper and Rajaby, Ramesh and Shen, Chuanqi and Sung, Wing-Kin},
 doi = {10.1109/tcbb.2016.2609923},
 issn = {1545-5963},
 issue_date = {January 2018},
 journal = {IEEE/ACM Trans. Comput. Biol. Bioinformatics},
 month = {January},
 number = {1},
 numpages = {12},
 pages = {15–26},
 publisher = {IEEE Computer Society Press},
 title = {Algorithms for the Majority Rule + Consensus Tree and the Frequency Difference Consensus Tree},
 url = {https://doi.org/10.1109/TCBB.2016.2609923},
 volume = {15},
 year = {2018}
}
