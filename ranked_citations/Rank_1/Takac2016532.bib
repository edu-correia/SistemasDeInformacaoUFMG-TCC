@conference{Takac2016532,
 abstract = {We present a neural network model of how events are stored in and retrieved from episodic long-term memory (LTM). The model is novel in giving an explicit account of the working memory (WM) medium mediating access to episodic memory: it makes a specific proposal about how representations of events and situations in WM interface with representations of events and situations in episodic memory. It also provides the framework for an account of how operations accessing temporally remote situations are reported in language. © 2016 Proceedings of the 38th Annual Meeting of the Cognitive Science Society, CogSci 2016. All rights reserved.},
 author = {Takac, Martin and Knott, Alistair},
 journal = {Proceedings of the 38th Annual Meeting of the Cognitive Science Society, CogSci 2016},
 note = {Cited by: 5},
 pages = {532 - 537},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mechanisms for storing and accessing event representations in episodic memory, and their expression in language: a neural network model},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85077062972?origin=resultslist},
 year = {2016}
}
