@conference{Sagar20212650,
 abstract = {In this paper, we present a novel neural network using multi scale feature fusion at various scales for accurate and efficient semantic image segmentation. We used ResNet based feature extractor, dilated convolutional layers in down-sampling part, atrous convolutional layers in the upsampling part and used concat operation to merge them. A new attention module is proposed to encode more contextual information and enhance the receptive field of the network. We present an in depth theoretical analysis of our network with training and optimization details. Our network was trained and tested on the Camvid dataset and Cityscapes dataset using mean accuracy per class and Intersection Over Union (IOU) as the evaluation metrics. Our model outperforms previous state of the art methods on semantic segmentation achieving mean IOU value of 74.12 while running at >100 FPS.  © 2021 IEEE.},
 author = {Sagar, Abhinav and Soundrapandiyan, Rajkumar},
 doi = {10.1109/ICCVW54120.2021.00299},
 journal = {Proceedings of the IEEE International Conference on Computer Vision},
 note = {Cited by: 25; All Open Access; Green Open Access},
 pages = {2650 - 2656},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic Segmentation with Multi Scale Spatial Attention for Self Driving Cars},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85123053260?origin=resultslist},
 volume = {2021-October},
 year = {2021}
}
