@article{SI2026130411,
 abstract = {Large Language Models (LLMs) have demonstrated remarkable abilities to generalize across a wide array of tasks, showcasing impressive performance. Zero-shot relational triplet extraction (ZeroRTE) task serves as a litmus test for model generalizability, but it has not been well examined with LLMs. In this paper, rather than solely fine-tuning on ZeroRTE instructions, other potential data types are integrated into the training process to examine their impact on the model’s generalization to the ZeroRTE task. This data, which contains generation task data (e.g., Text Summarization) or understanding task data (e.g., Topic Classification), is merged in an information fusion manner into the ZeroRTE training process, demonstrating a substantial advantage. Furthermore, we explore two pivotal factors influencing LLMs’ generalization during instruction tuning: the data mixture ratio and the overall cross-entropy of training data. Our findings indicate that optimizing the ratio of replaced data is crucial for peak performance, and strategically incorporating examples with lower cross-entropy significantly enhances performance. Our work provides insights into improving the generalization ability of the LLMs on specific tasks by integrating additional data from various tasks beyond ZeroRTE, employing precise quantification ratios and leveraging the principle of lower entropy. This approach sheds light on bolstering the overall generalization capacity of LLMs.},
 author = {Xingpeng Si and Yuhao Ye and Yu-Ming Shang and Mengyuan Cao and Yu Bai and Jiawei Li and Yang Gao},
 doi = {https://doi.org/10.1016/j.eswa.2025.130411},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Large language models, Information fusion, Zero-shot relational triplet extraction},
 pages = {130411},
 title = {Fusing generation task data to enhance generalization of LLMs in zero-shot relational triplet extraction},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417425040266},
 volume = {300},
 year = {2026}
}
