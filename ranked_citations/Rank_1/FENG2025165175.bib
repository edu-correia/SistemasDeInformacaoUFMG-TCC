@article{FENG2025165175,
 abstract = {Youth athletic development confronts three major challenges of infrastructure deficits, educational marginalization, and health disparities in resource-limited zones. These zones face inadequate sports infrastructure, inadequate funding for sports programs, a shortage of qualified teachers, and widespread malnutrition and health problems, all of which severely hamper the sporting potential of adolescents. To address these issues, skipping rope is highly suitable for promotion due to its low cost, easy accessibility, and multiple benefits. In this work, natural biomaterials (silk fibroin and sodium alginate) were combined with conductive sponge to develop a non-toxic, flexible, and recyclable self-powered triboelectric nanogenerator (SMP-TENG). The SMP-TENG exhibits stable electrical output (∼23–100 V) and converts low-frequency touch (∼6 Hz) to power commercial LEDs and hygrometers. The SMP-TENG system comprises SMP-TENG, TENG energy pack, wireless Bluetooth module, and upper computer system, monitoring adolescents' movement status during skipping rope in real-time. By analyzing data with support vector machine learning technology, the system achieves 95% accuracy in motion recognition. Integrating triboelectric nanogenerator technology with skipping rope addresses both energy supply and posture monitoring, improving adolescents' physical and mental health and promoting educational development in impoverished zones.},
 author = {Qingyang Feng and Zihang Cheng and Hengzhi Guo and Yunlu Wang and Shuzheng Zou and Dongsheng Liu and Leo N.Y. Cao and Yupeng Mao and Chongle Zhao},
 doi = {https://doi.org/10.1016/j.cej.2025.165175},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Triboelectric nanogenerator, Fully self-powered, Silk fibroin, Sodium alginate, Coupled energy harvesting},
 pages = {165175},
 title = {Fully self-powered flexible sensing system via coupled energy harvesting for adolescent skipping rope health monitoring},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894725060115},
 volume = {519},
 year = {2025}
}
