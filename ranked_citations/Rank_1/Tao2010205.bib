@conference{Tao2010205,
 abstract = {Differential Frequency Hopping(DFH) is a new frequency-hopping spread spectrum system, DFH is the core technology of CHESS radio, now mainly used in short-wave communications, which mainly come down to a G function algorithm, this set of G functions merge information modulation and Frequency hopping patterns together. Based on the traditional of G function, this article Proposed an improved method of 4 bit G Functions, the introduction of a strong error correction capability RS code control a subset of frequency hopping, and its been tested. The results show that the algorithm generated frequency hopping patterns with good randomness and uniformity. © 2010 IEEE.},
 author = {Tao, Sui and Wei, Zhu},
 doi = {10.1109/ICINIS.2010.75},
 journal = {Proceedings - 3rd International Conference on Intelligent Networks and Intelligent Systems, ICINIS 2010},
 note = {Cited by: 1},
 pages = {205 - 208},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on four bit G function algorithm base on DFH system},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/79951765333?origin=resultslist},
 year = {2010}
}
