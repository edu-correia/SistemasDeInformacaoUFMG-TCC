@article{Wu2018191,
 abstract = {We address the fine-grained image recognition problem using user click data, wherein each image is represented as a semantical query-click feature vector. Usually, the query set obtained from search engines is large-scale and redundant. We propose a novel query modeling approach to merge semantically similar queries and construct a compact click feature. We represent each query as a click feature, and design a graph based propagation approach to predict the zero-clicks, ensuring similar images have similar clicks. Afterwards, using this feature, we formulate the problem as a sparse coding based recognition task, wherein the dictionary is discriminatively trained. We evaluate our method for fine-grained image recognition on the public Clickture-Dog dataset. It is shown that, the propagated click feature performs much better than the original one. Also, sparse coding performs better than K-means in query merging. © Springer Nature Singapore Pte Ltd. 2018.},
 author = {Wu, Weichen and Tan, Min and Zheng, Guangjian and Yu, Jun},
 doi = {10.1007/978-981-10-8530-7_19},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 1},
 pages = {191 - 199},
 publication_stage = {Final},
 source = {Scopus},
 title = {Query modeling for click data based image recognition using graph based propagation and sparse coding},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85043361009?origin=resultslist},
 volume = {819},
 year = {2018}
}
