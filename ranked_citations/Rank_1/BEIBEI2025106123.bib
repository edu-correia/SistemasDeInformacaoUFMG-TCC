@article{BEIBEI2025106123,
 abstract = {DC (Direct Current) charging pile adopts parallel connection structure of multiple charging modules to realize flexible capacity expansion and system redundancy. The interleaved parallel connection based on carrier wave phase shifting can further enhance the overall power density of the charging pile, reduce the charging current ripple, and combine with the magnetic coupling method can further improve the integration degree of the filter, and improve the steady state equalization performance. This paper summarizes the relationship between the charging current ripple and the key parameters of filters, and the main circuit based on the phase-shifted charging module with magnetic coupling structure is also considered to reveals the influence of the filter parameters on the dynamic performance of charging converter during a sudden change in input DC voltage, Finally, the correctness of the analysis in this paper is proved by simulation and experimental results.},
 author = {Qi BeiBei and Lyu Shukang and Yuan Xiaodong and Zeng Fei and Zhu Changyu and Chen Yihan},
 doi = {https://doi.org/10.1016/j.rineng.2025.106123},
 issn = {2590-1230},
 journal = {Results in Engineering},
 keyword = {Interleaving paralleled, Magnetic coupling, Charging pile, Phase shift full bridge, Constant current control},
 pages = {106123},
 title = {Characterization of parallel ripple and dynamic control performance of phase-shifted charging module based on magnetic coupling structure},
 url = {https://www.sciencedirect.com/science/article/pii/S2590123025021954},
 volume = {27},
 year = {2025}
}
