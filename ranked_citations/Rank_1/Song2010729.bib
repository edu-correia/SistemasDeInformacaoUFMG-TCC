@article{Song2010729,
 abstract = {The duplicate detection is one of technical difficulties in data cleaning area. At present, the data volume of scientific database is increasing rapidly, bringing new challenges to the duplicate detection. In the scientific database, the duplicate detection model should be suitable for massive and numerical data, should independent from the domains, should well consider the relationships among tables, and should focus on common grounds of the scientific database. In the paper, a multilevel duplicate detection model for scientific database is proposed, which consider numerical data and general usage well. Firstly, the challenges are propose by analyzing duplicate-related characteristics of scientific data; Secondly, similarity measure of the proposed model are defined; Then the details of multilevel detecting algorithms are introduced; At last, some experiments and applications show that the proposed model is more domain-independent and effective, suitable for duplicate detection in scientific database. © 2010 Springer-Verlag.},
 author = {Song, Jie and Bao, Yubin and Yu, Ge},
 doi = {10.1007/978-3-642-14246-8_69},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3},
 pages = {729 - 741},
 publication_stage = {Final},
 source = {Scopus},
 title = {A multilevel and domain-independent duplicate detection model for scientific database},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77955017710?origin=resultslist},
 volume = {6184 LNCS},
 year = {2010}
}
