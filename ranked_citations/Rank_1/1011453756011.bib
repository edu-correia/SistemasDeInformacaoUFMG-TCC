 journal = {ACM Trans. Asian Low-Resour. Lang. Inf. Process.},
 keyword = {Malayalam handwritten character recognition (MHCR), depthwise separable convolution(DSC), bidirectional long short-term memory (Bi-LSTM), convolutional neural network (CNN)},
 month = {September},
