@conference{Tiwari2016518,
 abstract = {Shadow Detection and Removal is the process to enhance the performance, reliability and accuracy of the computer vision applications including image segmentation and object recognition, object tracking ,surveillance etc. Detection and Removal of shadow from the images and videos can reduce the undesirable outcomes in the computer vision applications and algorithms. The prime objective of this survey paper is to analyze the performance of various currently used shadow detection techniques. In this paper we have discussed the techniques for detecting and removing shadow from the still images and video sequences. The scope of discussed shadow detection and removal techniques is limited to different scenarios: (i) Shadow detection for Indoor and Outdoor scenes, (ii) Shadow detection using fixed or moving camera, (iii) Shadow detection of umbra and penumbra shadows etc. © 2016 IEEE.},
 author = {Tiwari, Arti and Singh, Pradeep Kumar and Amin, Sobia},
 doi = {10.1109/CONFLUENCE.2016.7508175},
 journal = {Proceedings of the 2016 6th International Conference - Cloud System and Big Data Engineering, Confluence 2016},
 note = {Cited by: 20},
 pages = {518 - 523},
 publication_stage = {Final},
 source = {Scopus},
 title = {A survey on Shadow Detection and Removal in images and video sequences},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85017307485?origin=resultslist},
 year = {2016}
}
