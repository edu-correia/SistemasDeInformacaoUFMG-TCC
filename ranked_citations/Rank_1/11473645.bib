@inproceedings{11473645,
 abstract = {This article examines the impact of event marketing on the development of a smart tourism value chain in Morocco. It shade the light at how events serve as strategic tools to mobilize the stakeholders, speed up digital transformation, produce data, and strengthen destination branding under the umbrella of smart tourism. The research is of a conceptual and exploratory nature. It merges the systematic review of the literature in the areas of smart tourism, tourism value chains, event marketing, and territorial marketing with the descriptive and analytical study of the Moroccan tourism context. Moreover, the paper makes use of secondary data extracted from institutional documents, strategic plans, and the events cases in Moroccan destinations to substantiate the argumentation. The findings reveal that event marketing through the smart tourism value chain in Morocco is accomplished by four interconnected mechanisms, i.e., the generation and exploitation of data and intelligence, the acceleration of digitalization and service innovation, the coordination and governance of diverse stakeholders, and the strengthening of destination branding and experiential value. Events become the medium that links tourists, local businesses, public authorities, technology providers, and residents, And thus helps in consolidating a more integrated, data-driven, and experience-oriented tourism ecosystem in Morocco. This article puts forth an integrative conceptual framework that connects event marketing with the organization of a smart tourism value chain in an emerging destination context. It moves the literature forward by combining the smart tourism, event marketing, and territorial development viewpoints and by recognizing the events' strategic role far beyond their immediate economic and image effects. The framework represents the ground for empirical research and offers a Tour of guidance for the policymakers, destination management organizations, and event organizers in Morocco & other similar places.},
 author = {Benlemlih, Aya and Benjellou, Ahmed},
