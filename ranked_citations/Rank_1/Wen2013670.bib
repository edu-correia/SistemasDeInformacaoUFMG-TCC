@conference{Wen2013670,
 abstract = {The quantitative analysis on the mobility behaviors of subcellular structures is essential for understanding eukaryotic cells establishment and maintenance. Tagged by the fluorescent marker proteins, the subcellular structures are visualized under the modern microscope. In this paper, we propose a graph model to formulate the tracking problem on fluorescent marker protein. By minimizing the energy of the proposed graph model, we present an algorithm for multiple objects tracking to classify the mobility behavior of the fluorescent marker protein. We have carried out extensive experiments on the tracking of fluorescent marker protein and the proposed method achieves satisfactory tracking accuracy. © 2013 IEEE.},
 author = {Wen, Quan and Chen, Juan and Liu, Wenhao},
 doi = {10.1109/CISP.2013.6745250},
 journal = {Proceedings of the 2013 6th International Congress on Image and Signal Processing, CISP 2013},
 note = {Cited by: 0},
 pages = {670 - 674},
 publication_stage = {Final},
 source = {Scopus},
 title = {Quantitative analysis on mobility behaviors of fluorescent marker proteins using the graph model},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84897751438?origin=resultslist},
 volume = {2},
 year = {2013}
}
