@article{Ravikumar2021,
 abstract = {Nowadays, an autonomous car driver scheme (ACDS) plays a significant role in accessing vehicles. Due to its high rate of complexity, the performance based on risk evaluation requires additional software functions along with the electronic controlling unit. Consequently, these operations are more complex for identification and classification regarding the safety facility. So to overcome such shortcomings, an IoT based ACDS system is employed in controlling the precise and secure operation of the cars. The proposed IoT-ACDS approach employs in demonstrating the risk evaluation under three different phases namely hazard identification, hazard classification, and determination of ASIL. The hazard classification utilizes the integration of ANFIS-BWO along with the IoT-ACDS device thereby providing a systematic and autonomous process for accessing complex operations. In addition to this, two different types of operational testing protocols namely EuroNCAP testing protocols and NHTSA testing protocol and their performances are discussed by employing three different constraints such as severity (S<sub>V</sub>) , exposure (E<sub>X</sub>) as well as controllability (C<sub>R</sub>). Then the graph is plotted for various approaches namely the proposed ANFIS-BWO approach with several other Metaheuristic algorithms such as BWO, PSO and GA. Finally, the experimental analysis reveals that the proposed ANFIS-BWO provides better performances when compared with all other approaches. © 2021, Springer-Verlag GmbH Germany, part of Springer Nature.},
 author = {Ravikumar, S. and Kavitha, D.},
 doi = {10.1007/s12652-020-02725-1},
 journal = {Journal of Ambient Intelligence and Humanized Computing},
 note = {Cited by: 34},
 pages = {},
 publication_stage = {Article in press},
 source = {Scopus},
 title = {IOT based autonomous car driver scheme based on ANFIS and black widow optimization},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85098788333?origin=resultslist},
 year = {2021}
}
