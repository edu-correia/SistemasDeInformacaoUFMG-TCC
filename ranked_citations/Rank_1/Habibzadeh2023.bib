@conference{Habibzadeh2023,
 abstract = {Electric load forecasting (LF) for optimal usage of renewable energy sources and battery energy storage systems (BESS) plays a crucial role in Energy Management Systems (EMS). In this investigation, wind speed and generated power of wind turbines (PWT) historical data is used to predict the future amounts of PWT. It should be noted that the use of conventional methods which only use wind speed prediction to calculate the generated power, due to the presence of actuator faults, sudden changes in weather conditions, various disturbances, and other factors may lead to errors in the predictions. So, in this paper, the time-series method is used to merge the history of PWT with weather factors, instead of just wind speed data, to achieve precise estimations. Simulation results show the proposed method's efficiency and accuracy by applying it to a real dataset. © 2023 IEEE.},
 author = {Habibzadeh, Hamed and Javidi, Behnaz Malekzadeh and Motarabbesoun, Sara and Dinparast, Mahdi and Kharrati, Hamed},
 doi = {10.1109/ICTEM56862.2023.10084233},
 journal = {2023 8th International Conference on Technology and Energy Management, ICTEM 2023},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Short-Term Forecasting of Wind Turbine-Generated Power in the Presence of Actuator Fault},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85153094350?origin=resultslist},
 year = {2023}
}
