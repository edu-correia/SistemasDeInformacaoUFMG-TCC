@article{ITOUCHENE20254324,
 abstract = {This paper proposes a Novel Prescribed Sliding Mode Control (NP-SMC) scheme for grid-connected Doubly-Fed Induction Generator (DFIG)-based wind energy systems. The primary novelty lies in a unique control structure that merges higher-order auxiliary dynamics with an adaptive gain tuning law. This approach fundamentally distinguishes NP-SMC from recent advanced SMC variants—such as Super-Twisting, Adaptive, and Nonsingular Terminal SMC—by eliminating the discontinuous switching term inherent in those methods. Instead, it achieves finite-time convergence through a smooth, polynomial-based law, which inherently generates continuous control signals and suppresses chattering. The controller's robust stability is rigorously proven via a Lyapunov-based analysis, specifically guaranteeing boundedness of all closed-loop signals and finite-time convergence of the sliding dynamics under the tested disturbances, namely random wind speed variations and ±20 % machine parameter uncertainties. The Grey Wolf Optimization is employed for optimal gain tuning. While implemented on the standard back-to-back converter topology, the proposed NP-SMC demonstrates superior performance in the decoupled regulation of active and reactive power. Extensive validation via MATLAB/Simulink simulations and dSPACE 1104 Hardware-in-the-Loop (HIL) experiments confirms its effectiveness. Under stochastic wind profiles, the NP-SMC achieves a reduction of active power tracking error by more than 65 % compared to conventional SMC, decreases settling time by nearly 40 %, and maintains steady-state power regulation errors below 1.5 %. Furthermore, it ensures high power quality by restricting the stator current Total Harmonic Distortion (THD) to under 3 %, thereby complying with the IEEE 519 standard. These results collectively establish NP-SMC as a highly robust and real-time feasible control strategy for DFIG-based wind energy conversion systems.},
 author = {Hichem Itouchene and Fayssal Amrane and Oussama Gherouat and Zoubir Boudries and Saad Mekhilef and Phatiphat Thonthong and Nicu Bizon},
 doi = {https://doi.org/10.1016/j.egyr.2025.11.040},
 issn = {2352-4847},
 journal = {Energy Reports},
 keyword = {DFIG, Wind Energy System, Chattering Mitigation, Hardware-in-the-loop, Robust Prescribed Control, Grey Wolf Optimization, Back-to-Back Converter, Lyapunov Stability},
 pages = {4324-4352},
 title = {Design and implementation of a grey wolf optimization–Based higher-order sliding mode controller for a DFIG-based wind turbine using dSPACE 1104},
 url = {https://www.sciencedirect.com/science/article/pii/S2352484725006560},
 volume = {14},
 year = {2025}
}
