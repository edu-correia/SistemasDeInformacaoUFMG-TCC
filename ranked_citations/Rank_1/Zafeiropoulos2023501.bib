@article{Zafeiropoulos2023501,
 abstract = {In this work we handle deforestation as a semantic segmentation problem using convolution-free methods, specifically tensor-based neural networks. The methodology follows a two-step process: first, we enhance the identification of deforestation areas through the application of low-level filters. Second, we merge the filter outcomes with the original image to create an object-level tensor representation. We introduce a tensor-based model that effectively identifies and analyzes complex patterns even with limited data availability. To evaluate our model, its outcomes are compared with established state-of-the-art models. The experimental results demonstrate the effectiveness and efficiency of the proposed approach in accurately mapping land cover patterns, particularly in deforestation detection and analysis. Based on the results, SqueezedNet perform better when more data are available, while Tensor neural network model (TNN) outperformed when limited data are available. © 2023, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Zafeiropoulos, Charalampos and Tzortzis, Ioannis N. and Protopapadakis, Eftychios and Kaselimi, Maria and Doulamis, Anastasios and Doulamis, Nikolaos},
 doi = {10.1007/978-3-031-47969-4_39},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {501 - 512},
 publication_stage = {Final},
 source = {Scopus},
 title = {Investigating the Impact of a Low-Rank Tensor-Based Approach on Deforestation Imagery},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85180622107?origin=resultslist},
 volume = {14361},
 year = {2023}
}
