@article{10.1145/2897824.2925942,
 abstract = {Skies are common backgrounds in photos but are often less interesting due to the time of photographing. Professional photographers correct this by using sophisticated tools with painstaking efforts that are beyond the command of ordinary users. In this work, we propose an automatic background replacement algorithm that can generate realistic, artifact-free images with a diverse styles of skies. The key idea of our algorithm is to utilize visual semantics to guide the entire process including sky segmentation, search and replacement. First we train a deep convolutional neural network for semantic scene parsing, which is used as visual prior to segment sky regions in a coarse-to-fine manner. Second, in order to find proper skies for replacement, we propose a data-driven sky search scheme based on semantic layout of the input image. Finally, to re-compose the stylized sky with the original foreground naturally, an appearance transfer method is developed to match statistics locally and semantically. We show that the proposed algorithm can automatically generate a set of visually pleasing results. In addition, we demonstrate the effectiveness of the proposed algorithm with extensive user studies.},
 address = {New York, NY, USA},
 articleno = {149},
 author = {Tsai, Yi-Hsuan and Shen, Xiaohui and Lin, Zhe and Sunkavalli, Kalyan and Yang, Ming-Hsuan},
 doi = {10.1145/2897824.2925942},
 issn = {0730-0301},
 issue_date = {July 2016},
 journal = {ACM Trans. Graph.},
 keyword = {appearance transfer, compositing, semantic search, sky replacement, sky segmentation},
 month = {July},
 number = {4},
 numpages = {11},
 publisher = {Association for Computing Machinery},
 title = {Sky is not the limit: semantic-aware sky replacement},
 url = {https://doi.org/10.1145/2897824.2925942},
 volume = {35},
 year = {2016}
}
