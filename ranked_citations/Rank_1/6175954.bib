@article{6175954,
 abstract = {We present a discrete unsupervised multiregion-competition algorithm for image segmentation over different energy functionals. The number of regions present in an image does not need to be known a priori, nor their photometric properties. The algorithm jointly estimates the number of regions, their photometries, and their contours. The required regularization is provided by defining a region as a connected set of pixels. The evolving contours in the image are represented by computational particles that move as driven by an energy-minimization algorithm. We present an efficient discrete algorithm that allows minimizing a range of well-known energy functionals under the topological constraint of regions being connected components. The presented framework and algorithms are implemented in the open-source Insight Toolkit image-processing library.},
 author = {Cardinale, Janick and Paul, Grégory and Sbalzarini, Ivo F.},
 doi = {10.1109/TIP.2012.2192129},
 issn = {1941-0042},
 journal = {IEEE Transactions on Image Processing},
 keyword = {Image segmentation;Topology;Three dimensional displays;Minimization;Optimization;Level set;Data structures;Connected component;deconvolution;digital topology;discrete level set;energy-based segmentation;multiregion segmentation;region competition;topological constraint},
 month = {Aug},
 number = {8},
 pages = {3531-3545},
 title = {Discrete Region Competition for Unknown Numbers of Connected Regions},
 volume = {21},
 year = {2012}
}
