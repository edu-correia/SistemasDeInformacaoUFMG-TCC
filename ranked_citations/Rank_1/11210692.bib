@inproceedings{11210692,
 abstract = {The application of GCNs for graph-structured data learning has achieved success yet remains limited in its ability to capture important higher-order relationships within multi-relational datasets. Based on these limitations, this study presents a novel Hypergraph Convolutional Network (HGCN) to tackle them. By employing the structural benefits of hypergraphs, which naturally represent complex multi-node relationships, and the HGCN framework exploits a hypergraph Laplacian based convolution strategy, it merges both node and hyperedge information for effective multi-dimensional learning. The experimental results show that this approach is particularly useful for real world tasks, given that it achieves better precision and accuracy than the preexisting GCN models as well as a number of other baseline models in tasks like developer classification and the problem of link prediction. Moreover, for relational data, the proposed framework is able to detect intricate community formations and three-dimensional relationships in the relational data that were not expressible in the typical graph structures. This architecture provides significant advancement on cost and scalability for hypergraph-based learning models, and its application spans in many fields like social networks, bioinformatics and recommender systems. The framework is concluded as a promising one for future research, and is outlined to increase scalability, and to develop dynamic hypergraph frameworks for real time systems.},
 author = {Palaniappan, Karthikeyan and Sneha, M. and Hussein, Omar Mohsen and Ali, Abdalsalam Taha Hussain and Muhammad, Ahmad Hussein Hassan and Kavitha, V.},
 booktitle = {2025 International Conference on Information, Implementation, and Innovation in Technology (I2ITCON)},
 doi = {10.1109/I2ITCON65200.2025.11210692},
 issn = {},
 keyword = {Technological innovation;Laplace equations;Costs;Social networking (online);Scalability;Predictive models;Real-time systems;Data models;Convolutional neural networks;Recommender systems;HGCN;GCN;Relational Pattern Discovery;Node Classification;Link Prediction},
 month = {July},
 number = {},
 pages = {1-5},
 title = {Hypergraph Convolutional Networks Transforming Relational Data Learning with Multi Dimensional Interaction Modeling},
 volume = {},
 year = {2025}
}
