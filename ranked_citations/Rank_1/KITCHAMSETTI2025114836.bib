@article{KITCHAMSETTI2025114836,
 abstract = {Metal ion hybrid capacitors (MIHCs) integrate both capacitive and battery-type electrodes, thereby merging the benefits of metal ion batteries (MIBs) and supercapacitors (SCs). Despite these advantages, the current performance of MIHCs is limited by the disparity in specific capacity and rate capability between the cathode and anode materials. This underscores the importance of electrode materials, which portray a critical function in the overall performance of MIHCs. To overcome these challenges, it is crucial to focus on the electrochemical properties of these materials and investigate approaches to improve their performance. This article begins by outlining the types, composition, and energy storage processes of MIHCs. It then reviews the electrode materials employed in LIHCs, SIHCs, PIHCs, and ZIHCs, highlighting their properties and their impact on electrochemical performance. Furthermore, the review delves into efficient approaches for improving the energy storage performance of these materials, supported by numerous experimental findings. Lastly, the article offers insights into the progress and large-scale fabrication of MIHC electrodes for Li+, Na+, K+, and Zn2+, focusing existing challenges and suggesting future research targets.},
 author = {Narasimharao Kitchamsetti and Charan Kumar Mannem and Chidurala Shilpa Chakra and Ana L.F. {de Barros}},
 doi = {https://doi.org/10.1016/j.est.2024.114836},
 issn = {2352-152X},
 journal = {Journal of Energy Storage},
 keyword = {Metal ion hybrid capacitors, Battery type, Capacitive type, Electrolytes, Research progress},
 pages = {114836},
 title = {A review of the exploration of nanostructured electrode materials, electrolytes, and performance in metal-ion (Li, Na, K, and Zn) hybrid capacitors},
 url = {https://www.sciencedirect.com/science/article/pii/S2352152X24044220},
 volume = {106},
 year = {2025}
}
