@article{Xiang20251238,
 abstract = {To address the lack of semantic descriptions for transmission line icing images, this paper proposes a SwinMix-xLSTM-based image semantic generation model for intelligent characterization of icing conditions. In the visual feature extraction stage, the model incorporates a Hybrid Local-Global Attention Mixing (HLGAM) module and a Multi-Head Global Convolutional Context Modeling (MGCCM) module to enhance local texture capture and global semantic modeling. In the semantic generation stage, an Adaptive Semantic Fusion (ASF) module combined with an xLSTM network is employed to generate natural language descriptions of icing type, thickness, and potential risk. Experimental results on a self-collected transmission line icing image - text dataset demonstrate that the proposed model outperforms mainstream Transformer and CNNLSTM methods across multiple metrics, producing descriptions with superior detail completeness and semantic consistency. This study provides an efficient and reliable technical solution for intelligent monitoring and safety assessment of transmission line icing. © 2025 IEEE.},
 author = {Xiang, Wang and Yajie, Wei and Shuxian, Fan and Zhaokun, Zhang},
 doi = {10.1109/ICCC68654.2025.11437783},
 journal = {Proceedings of the IEEE International Conference on Computer and Communications, ICCC},
 note = {Cited by: 0},
 pages = {1238 - 1243},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantically Enhanced Image Captioning for Transmission Line Ice},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105035787848?origin=resultslist},
 year = {2025}
}
