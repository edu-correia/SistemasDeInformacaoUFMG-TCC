@conference{Zhong2017182,
 abstract = {Saliency detection is a hot topic in the community of computer image and vision. In this paper, we present a new saliency detection method. Given an input image, our method first uses Harris corner detection technique to approximately locate the salient region, and then assign the saliency scores to each pixel, getting the center-prior based map. In addition, we employ Bayesian formula to further optimize it, obtaining the center-Bayesian map. On the other hand, we use the image boundary to generate boundary-based map. Finally, we merge them into a saliency map as our final saliency map. A large number of experimental results demonstrate that the proposed algorithm is superior to most existing algorithms. © 2017 IEEE.},
 author = {Zhong, Hui and Lin, Xiao and Jiang, Linhua},
 doi = {10.1109/ICSAI.2017.8248286},
 journal = {2017 4th International Conference on Systems and Informatics, ICSAI 2017},
 note = {Cited by: 0},
 pages = {182 - 186},
 publication_stage = {Final},
 source = {Scopus},
 title = {Finding saliency object via an integration approach},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85046629938?origin=resultslist},
 volume = {2018-January},
 year = {2017}
}
