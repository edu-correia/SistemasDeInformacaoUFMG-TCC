@article{Fang2013670,
 abstract = {Current window fusion of the sliding window based human detection is rather slow. This paper proposes a fast fuzzy equivalence relation based method (FER). It merges candidate windows based on the fuzzy equivalence relation structured from the normal fuzzy similarity relation. Experimental results demonstrate that the method can merge candidate windows faster than the popular non-maximum suppression based method (NMS) and the bounding region method (BR), while maintaining the detection quality. © 2013 Elsevier B.V. All rights reserved.},
 author = {Fang, Xianyong and Zhang, Hu and Zhou, Jian},
 doi = {10.1016/j.patrec.2013.01.014},
 journal = {Pattern Recognition Letters},
 note = {Cited by: 1},
 number = {6},
 pages = {670 - 677},
 publication_stage = {Final},
 source = {Scopus},
 title = {Fast window fusion using fuzzy equivalence relation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84874685106?origin=resultslist},
 volume = {34},
 year = {2013}
}
