@inproceedings{10617075,
 abstract = {In the current educational landscape, the integration of Artificial Intelligence is transforming the way students learn and teachers instruct. The “Personalized Adaptive Learning Platform Empowered by Artificial Intelligence” is an innovative project aimed at revolutionizing the educational landscape by leveraging artificial intelligence (AI) to provide a personalized and interactive learning experience. In this paper we present an educational technology platform which harnesses the capabilities of artificial intelligence (AI) to emulate the role of a human teacher in delivering lectures, offering personalized explanations through visual animations, and closely monitoring student engagement via webcam-based interactions. The purpose of this endeavor is multifaceted. Firstly, it aims to narrow the divide between conventional teaching methods and the changing requirements of modern learners by introducing an AI-driven, personalized approach. Secondly, the integration of webcam monitoring ensures active student participation and attentiveness during lectures.},
 author = {Pradeep, K.R and Manish, A S and Adithiyaa, A S and Sahana, N and Abhishek, S T},
 booktitle = {2024 International Conference on Knowledge Engineering and Communication Systems (ICKECS)},
 doi = {10.1109/ICKECS61492.2024.10617075},
 issn = {},
 keyword = {Knowledge engineering;Adaptive learning;Visualization;Webcams;Communication systems;Merging;Learning (artificial intelligence);Artificial Intelligence;Educational landscape;OpenCV;Contemporary learning},
 month = {April},
 number = {},
 pages = {1-8},
 title = {Personalized Adaptive Learning Platform Empowered by Artificial Intelligence},
 volume = {1},
 year = {2024}
}
