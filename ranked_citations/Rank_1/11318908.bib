@inproceedings{11318908,
 abstract = {Cross-site scripting (XSS) is a prevalent vulnerability found in web applications, allowing attackers to compromise user sessions, manipulate, read, and delete business data within web applications, insert malicious code, and manipulate victims into launching attacks on other specified servers. While existing solutions typically rely on machine learning techniques to identify both evident and sophisticated attacks, many of these approaches neglect the detection performance. This paper presents an innovative approach to identify XSS attacks in web applications. It merges rule-based defenses employing regular expressions to filter out prevalent attack patterns with a Transformer-based anomaly detection model, leveraging CodeBERT as the pretrained language model to detect diverse malicious XSS codes. The detected and recognized attack patterns are adaptively stored in the rule-based system to support fast detection. The segmentation of web access inputs using regular expressions significantly aids in training the Transformer engine model. The model is additionally capable of learning and retaining the attack patterns, utilizing them as signatures for prompt detection in subsequent instances. Experiments show that our proposed approach can both efficiently speed up the detection of the attack and significantly enhance the accuracy of the detection of XSS attacks compared to related techniques.},
 author = {Wattanasuwan, Kittipat and Mangkala, Atikan and Kitchon, Panat and Fugkeaw, Somchart},
 booktitle = {2025 Thirteenth International Symposium on Computing and Networking Workshops (CANDARW)},
 doi = {10.1109/CANDARW68385.2025.00044},
 issn = {2832-1324},
 keyword = {Training;Adaptation models;Cross-site scripting;Computational modeling;Machine learning;Transformers;Information filters;Malware;Pattern recognition;Servers;Cross-site Scripting;XSS Attack;Transformer;CodeBERT;Machine Learning Model;Rule-based},
 month = {Nov},
 number = {},
 pages = {210-216},
 title = {A Dynamic XSS Attack Detection System with Realtime and Fast Response based on Transformer Learning Model and Adaptive Rule-based System},
 volume = {},
 year = {2025}
}
