@article{Yuan2012281,
 abstract = {This paper introduced an unsupervised method of semantic role labeling based on the dependency parse. This method divide the arguments into different clusters according to their dependency syntactic features, each cluster is one specific semantic role. It needs no human annotated data for training and achieves similar effect to the supervised labeling. Evaluating on the CoNLL2008 dataset and CoNLL2009 Chinese benchmark dataset, the F-value can reach 82.69% and 88.86%.},
 author = {Yuan, Dong and Xu, Jianliang and Liu, Shuyuan and Liu, Feng},
 doi = {10.4156/ijact.vol4.issue19.34},
 journal = {International Journal of Advancements in Computing Technology},
 note = {Cited by: 1},
 number = {19},
 pages = {281 - 290},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unsupervised semantic role labeling based on dependency parse},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84868576800?origin=resultslist},
 volume = {4},
 year = {2012}
}
