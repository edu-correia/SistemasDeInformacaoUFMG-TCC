@article{10.1145/3677063,
 abstract = {Augmented Reality (AR) has been largely deployed on smartphones in recent years. AR gaming, featured with geo-reference, is anchored to our real-world environments. Nevertheless, designing such AR user interaction in-the-wild is under-explored. Therefore, we examined 242 YouTube videos regarding AR gameplay, primarily Pok\'{e}mon GO, (1) to reveal personal and social threats during gameplay, and (2) to identify how such threats connect to the user and spatial contexts. Our video analysis generalises the threats, including but not limited to hitting bystanders, falling off a cliff, car crashes, crowds and blockages, and stampedes. Through video analysis, we connect the threats with the user and spatial contexts. Subsequently, we propose several design tactics to deliver safe and nuisance-free AR usages in physical environments. Finally, we suggest strategies to consider large-scale deployment of AR at the levels of individuals and local communities, such as an auditable and accountable framework for user safety and social acceptability.},
 address = {New York, NY, USA},
 articleno = {298},
 author = {Lee, Lik-Hang and Lin, Zijun},
 doi = {10.1145/3677063},
 issue_date = {October 2024},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {AR nuisance and threats, AR safety, Pokemon Go, geolocation game, mobile augmented reality (AR)},
 month = {October},
 number = {CHI PLAY},
 numpages = {33},
 publisher = {Association for Computing Machinery},
 title = {Danger, Nuisance, Disregard: Analyzing User-Generated Videos for Augmented Reality Gameplay on Hand-held Devices},
 url = {https://doi.org/10.1145/3677063},
 volume = {8},
 year = {2024}
}
