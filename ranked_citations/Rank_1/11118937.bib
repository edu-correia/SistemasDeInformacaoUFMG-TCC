@inproceedings{11118937,
 abstract = {Given the resource-intensive nature of continuous face recognition, a critical question arises: Is it feasible to implement this system without causing overheating issues and excessive strain on device batteries? This research seeks to provide insights into the practicality of deploying such a security mechanism while maintaining an optimal balance between security and resource efficiency.This research introduces an innovative security paradigm, merging continuous face recognition and QR code authentication for enhanced access control in screen-based systems. The system continuously monitors the user’s face, leveraging advanced face recognition algorithms alongside dynamic QR code authentication for dual-layer verification. The system records facial features persistently and initiates automatic logout upon user disengagement, ensuring heightened security. The study focuses on optimizing the integration of face recognition and QR code methods, evaluating user experience, security robustness, and system efficiency. This addresses concerns regarding overheating and battery consumption, aiming to strike a balance between security enhancements and minimizing the impact on device resources, presenting a promising solution for secure access in various applications.},
 author = {Shah, Devarsh and Brahmbhatt, Vedant and Pandey, Shilpa},
 booktitle = {2025 IEEE International Conference on Emerging Technologies and Applications (MPSec ICETA)},
 doi = {10.1109/MPSecICETA64837.2025.11118937},
 issn = {},
 keyword = {Access control;Performance evaluation;Face recognition;Memory management;Neural networks;QR codes;Real-time systems;Batteries;Security;Monitoring},
 month = {Feb},
 number = {},
 pages = {1-6},
 title = {System Access Security Protocols on Screen-Based Devices},
 volume = {},
 year = {2025}
}
