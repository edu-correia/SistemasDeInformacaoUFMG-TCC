@inproceedings{5581081,
 abstract = {The physical feature preserving will be ignored and difficult for parallel implementing when topological simplification of planar flow field by merging the grid. It could not satisfy the real-time requirement for remote visualization. This paper will introduce a topological simplification of planar flow field based on physical feature completely. By creating the physical feature filter of planar flow field, it gains the physical feature parameter image and attains topological simplification by extracting feature regions with image segmentation. The method is easy for parallel implement. The results show that it can get the entire topological structure quickly and accurately from the view of physical feature. It may be a new method for dealing with large-scale planar flow field.},
 author = {Qin, Bo and Pei, Bao-Mei and Li, Bing and Wu, Zhan-Bin},
 booktitle = {2010 International Conference on Machine Learning and Cybernetics},
 doi = {10.1109/ICMLC.2010.5581081},
 issn = {2160-1348},
 keyword = {Feature extraction;Streaming media;Topology;Vectors;Machine learning;Cybernetics;Clocks;Topological simplification;parallel implement;physical feature;planar flow field},
 month = {July},
 number = {},
 pages = {128-133},
 title = {Topological simplification of planar flow field based on physical feature},
 volume = {1},
 year = {2010}
}
