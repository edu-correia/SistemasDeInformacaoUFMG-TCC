@inproceedings{11210646,
 abstract = {A compact dual-polarized phased array antenna based on metal-dielectric co-printing technology is proposed in this paper. Each antenna element comprises a conventional dielectric-substrate feeding layer topped by a pyramid-shaped metal-dielectric co-printed radiation layer. The radiation part consists of four obliquely elliptically-shaped patches, coupled by two L-shaped probes. Compared with the traditional PCB processes with horizontal patches, this design shrinks the element volume and delivers a significantly larger scan angle. With a $0.42 \lambda_{0}$ element spacing, the 1D phased array achieves a wide $\pm 60^{\circ}$ scanning angle with only 3 dB scan loss. Its exceptional scan performance and compact structure make it a promising candidate for millimeter-wave (mm-wave) communication and sensing applications.},
 author = {Sun, Zhichao and Lv, Xiaojing and Yang, Yang},
 booktitle = {2025 IEEE 13th Asia-Pacific Conference on Antennas and Propagation (APCAP)},
 doi = {10.1109/APCAP65837.2025.11210646},
 issn = {},
 keyword = {Phased arrays;Millimeter wave technology;Merging;Layout;Antenna feeds;Sensors;Millimeter wave communication;Probes;Next generation networking},
 month = {Aug},
 number = {},
 pages = {30-31},
 title = {Compact Metal-Dielectric Co-Printed Millimeter-Wave Dual-Polarized Phased Array Antenna},
 volume = {},
 year = {2025}
}
