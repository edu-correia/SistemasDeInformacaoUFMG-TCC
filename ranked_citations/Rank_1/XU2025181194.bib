@article{XU2025181194,
 abstract = {With the advancement of aviation technology, thin-walled structures in superalloys are increasingly adopted in turbine blades for modern aeroengines. However, the mechanical reliability of ultra-thin sections remains a critical challenge. In this study, the high-temperature tensile behavior of thin-walled specimens of a third-generation nickel-based single-crystal superalloy was systematically investigated at 1100 °C. By integrating thin-wall design and in-situ micro-computed tomography imaging, real-time 3D visualization of dendritic structures and micropore evolution during tensile deformation was achieved. The results reveal that micropores progressively aggregate and expand throughout the initial, elastic, plastic and fracture stages. A 13.7 % reduction in tensile strength was observed as the wall thickness decreases from 1.2 mm to 0.3 mm. These findings provide critical insights for optimizing the design and performance of thin-walled turbine blades in advanced aero-engines operating under extreme service conditions.},
 author = {Hanyuan Xu and Taiwen Huang and Pengfei Qu and Chao Zhang and Cheng Ai and Jun Zhang and Lin Liu and Hengzhi Fu},
 doi = {https://doi.org/10.1016/j.jallcom.2025.181194},
 issn = {0925-8388},
 journal = {Journal of Alloys and Compounds},
 keyword = { μCT, Thin-wall structure, Nickel-based single crystal superalloy, Elemental segregation, Tensile property, Micropore evolution},
 pages = {181194},
 title = {In-situ μCT 3D visualization on micropores of thin-walled casting using a novel 3rd-generation nickel-based single crystal superalloy under 1100 °C tensile loading},
 url = {https://www.sciencedirect.com/science/article/pii/S0925838825027550},
 volume = {1032},
 year = {2025}
}
