@incollection{BAKRI20251,
 abstract = {The presence of perilous heavy metals (HMs) in aquatic environments poses substantial risks to both human well-being and ecological systems. Scientists around have been actively researching various ways to tackle the problem of hazardous materials (HMs). Out of these technologies, the utilization of nanomaterial-based adsorption has demonstrated significant promise. Nanomaterials, including carbon nanotubes, graphene oxide, zeolites, and metal oxide nanoparticles, have garnered significant attention due to their exceptional ability to adsorb molecules. Their capacity to resist heat and chemicals, possess a vast surface area, and contain functional groups is the reason behind this capability. Nevertheless, the application of these nanoparticles in practical situations encounters challenges such as the recovery of adsorbents and the tendency of nanomaterials to aggregate, leading to the formation of larger particles. Recently, there has been notable advancement in the development of polymeric nanocomposite membranes for effectively removing hazardous materials. By integrating nanoparticles into the polymer matrix, these membranes efficiently merge filtration and adsorption processes, yielding a notable efficacy in eliminating harmful pollutants. This chapter offers a comprehensive examination of the latest advancements in thoroughly researched polymeric nanocomposite membranes. The research primarily focuses on the analysis of nanocomposite membranes composed of carbon, clay, zeolite, and metal/metal oxide components. The investigation examines the rates at which HM (high-mobility) materials are rejected and how these rates fluctuate, providing useful insights into manufacturing procedures. Furthermore, this study examines the current challenges and proposes potential future opportunities for nanocomposite membranes. The objective is to offer a thorough synopsis of the most recent progress in utilizing polymeric nanocomposite membranes for the filtration of hazardous substances from water. This chapter offers a thorough overview of ongoing research endeavors, encountered difficulties, and potential avenues for future exploration. This resource serves as an excellent point of reference for scholars and professionals in the academic and industry sectors of this particular topic. This study not only offers an understanding of the effectiveness of these membranes but also lays the groundwork for future advancements in tackling the pressing issue of water contamination caused by toxic metals.},
 author = {Muhammad Khusairy Bin Bakri and Md. Rezaur Rahman and Norazzlina bt M. Sa'don},
 booktitle = {Polymer Nanocomposite Membranes in Water Treatment and Desalination},
 doi = {https://doi.org/10.1016/B978-0-443-23879-6.00001-4},
 editor = {Md. Rezaur Rahman and Muhammad Khusairy {Bin Bakri}},
 isbn = {978-0-443-23879-6},
 keyword = {Membrane system, nanocomposites, separation, heavy metals, materials synthesis, materials application, water technology, environmental nanotechnology, porous material, materials structure.},
 pages = {1-27},
 publisher = {Woodhead Publishing},
 series = {Woodhead Publishing in Materials},
 title = {1 - Introduction to recent developments and future opportunities for polymer nanocomposite membranes},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443238796000014},
 year = {2025}
}
