@inproceedings{11199219,
 abstract = {This research describes an AI-driven predictive diagnosis chatbot for healthcare that uses artificial intelligence to help users identify medical conditions based on their information. The solution attempts to overcome the challenges posed by large language models (LLMs) using a RAG framework. The system architecture consists of three layers: a retrieval layer with a vector database that contains indexes of external sources, an augmentation layer that adds supplementary context to the retrieved content, and a generation layer that combines the knowledge from the LLM and the augmented inputs and crafts responses utilizing the retrieved information. To achieve accurate information retrieval, the implementation applies semantic chunking, hybrid search techniques, and metadata-aware merging. Moreover, precise performance and scalability are supported using lightweight models such as Mistral 7B through Ollama. In addition, the design allows for mobile and telemedicine system integration, enabling multi-platform deployment, which increases its utility at the intersection of healthcare and enterprise systems. This RAG system achieved accuracy improvements of ~16–28 pp over a base LLM.},
 author = {Jadhav, Ashvini and Kumar, Tanay and Nandimath, Jyoti and Tiwari, Ayushi and Bhul, Sonam and Dhotre, Prashant},
 booktitle = {2025 World Skills Conference on Universal Data Analytics and Sciences (WorldSUAS)},
 doi = {10.1109/WorldSUAS66815.2025.11199219},
 issn = {},
 keyword = {Accuracy;Large language models;Telemedicine;Scalability;Retrieval augmented generation;Semantics;Systems architecture;System integration;Chatbots;Vectors;Large Language Model (LLM);Retrieval-Augmented Generation (RAG);Ollama;Mistral 7b},
 month = {Aug},
 number = {},
 pages = {1-7},
 title = {AI-Driven Diagnosis Predictive Chatbot for Healthcare},
