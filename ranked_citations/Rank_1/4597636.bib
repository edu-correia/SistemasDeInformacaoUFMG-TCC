@inproceedings{4597636,
 abstract = {An intelligent computational algorithm is proposed for structure topology optimization in this paper. It integrates the merits of Evolutionary Structure Optimization (ESO) and Level Set Method (LSM), and overcome some drawbacks in traditional LSM algorithm. The established algorithm allows new holes to be automatically inserted in regions with low deformation energy during optimization and thus the final optimal topology configuration is independent of initial structural topology. Compared with Evolutionary Structure Optimization for structure optimization, the final topology possesses smooth boundary. The new algorithm is efficient for structures that have complex boundaries. The validity and robustness are supported by some benchmark problems in topology optimization.},
 author = {Jiang Chundong and Jia Haipeng and Du Taihang and Zhang Ping and Zheng Yi and Jiang Chunbo},
 booktitle = {2008 Chinese Control and Decision Conference},
 doi = {10.1109/CCDC.2008.4597636},
 issn = {1948-9447},
 keyword = {Evolutionary computation;Artificial neural networks;Computational intelligence;Neural networks;Computers;Computers and information processing;Merging;Data handling;Performance analysis;Image processing;Intelligent Computation;Evolutionary Structure Optimization;Topology Optimization;Level Set Method},
 month = {July},
 number = {},
 pages = {1814-1817},
 title = {Intelligent computation algorithm in structural design optimization},
 volume = {},
 year = {2008}
}
