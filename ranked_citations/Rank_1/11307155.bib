@inproceedings{11307155,
 abstract = {A considerable amount of research has been devoted to the development of realistic lighting in computer graphics, aiming to render a scene that closely resembles realworld lighting. Global illumination techniques aim to solve the rendering equation to simulate realistic lighting by taking into account direct and indirect lighting. Even though indirect illumination is required for realism in computer graphics, its accurate calculation can be very computationally expensive. The aim of this study is to build a real-time 2D Global Illumination engine with accurate lighting and soft shadows which supports a completely dynamic scene encompassing a multitude of lights and occluders efficiently. The implementation uses ray-marching to compute radiance by sampling the scene's signed distance field and lightmap and also uses “Radiance Cascades”, a data structure that extends light probe methods into multiple layers of probes which allows reuse of directional radiance data. A $4 \times$ angular resolution branching factor and screen-resolution textures for cascade layers is used, allowing $\mathbf{O}(\mathbf{n})$ memory scaling and a GPU-accelerated implementation. The final illumination is obtained by merging cascade levels via bilinear interpolation leveraging hardware support. To demonstrate the viability of this technique, a simple cave scene was implemented containing multiple emissive and occlusive objects. The cave scene runs in real-time, even when lighting is fully recomputed every frame.},
 author = {Kelkar, Nikhil and Bhutkar, Ganesh and Nagarkar, Shriya and Naik, Nandini},
 booktitle = {2025 IEEE International Conference for Women in Innovation, Technology & Entrepreneurship (ICWITE)},
 doi = {10.1109/ICWITE64848.2025.11307155},
 issn = {},
 keyword = {Interpolation;Accuracy;Merging;Lighting;Graphics processing units;Rendering (computer graphics);Real-time systems;Mathematical models;Hardware;Probes;Global Illumination;GPU Computing;Radiance Cascades;RealTime Rendering;2D Graphics},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Radiance Cascades for Real-Time 2D Global Illumination},
 volume = {},
