@article{Su2026,
 abstract = {The integration of Time-Sensitive Networking (TSN) with fifth-generation (5G) provides a promising communication paradigm for Industry 4.0, enabling high precision, low latency, and scalable connectivity. However, most existing integration approaches treat 5G as a logical bridge within the TSN framework, failing to exploit its native capabilities for dynamic flow management and resource scheduling, thereby limiting scalability under high traffic loads. To overcome this issue, this paper proposes a hierarchical 5G-TSN integrated architecture that enables coordinated cross-domain scheduling between wired and wireless domains. In the wired domain, a Cyclic Queuing and Forwarding (CQF)-based transmission model is established to guarantee deterministic latency. Building on this model, we design LoadISP, a load-balanced injection-slot planning algorithm that improves queue utilization and end-to-end scheduling efficiency. In addition, a hybrid network flow-splitting model is introduced to distribute traffic between wired and wireless paths. To further improve resource utilization, we propose Bandwidth Allocation based on fast Non-dominated Sorting (NSBA), a multi-objective wireless resource allocation algorithm that dynamically assigns bandwidth according to flow demands and system constraints. Simulation results demonstrate that the proposed framework improves flow scheduling success rate by up to 50% compared with conventional non-splitting methods under large-scale traffic conditions. © 2026 Published by Elsevier Ltd.},
 author = {Su, Hui and Jia, Jie and Xue, Yi and Chen, Jian and Wang, Xingwei},
 doi = {10.1016/j.jnca.2026.104488},
 journal = {Journal of Network and Computer Applications},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A hierarchical 5G-TSN integrated architecture with load-balancing oriented resource allocation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105036229405?origin=resultslist},
