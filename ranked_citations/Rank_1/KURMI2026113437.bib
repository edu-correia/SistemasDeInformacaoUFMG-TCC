@article{KURMI2026113437,
 abstract = {In this work, a ternary nanocomposite, CaFe2O4/ZIF-67@ZIF-8, was fabricated employing a hydrothermal method followed by MOF growth steps, aimed at improving the photocatalytic degradation of organic pollutants, using Congo Red as a model contaminant. The idea behind combining CaFe2O4 with ZIF-67 and ZIF-8 was to merge the visible-light activity of CaFe2O4 with a large surface area and the porous structure of the MOFs, creating a synergistic system capable of efficient dye removal under natural sunlight. Comprehensive material characterization was performed using PXRD, FT-IR, FE-SEM, HR-TEM, XPS, PL, and UV-DRS techniques, confirming the successful integration of all three components. Based on Scherrer and Williamson-Hall methods, the average crystallite size of the nano-composite samples was 26.16 nm. The photocatalytic performance was evaluated under natural sunlight, where the composite achieved a 96.5 % degradation of 10 ppm Congo Red dye within 35 min with a catalyst loading of 100 mg/L and at a neutral pH. The reaction obeyed pseudo-first-order kinetics with a rate constant value of 0.093 min−1. The radical scavenger experiment revealed that holes and superoxide (O2−•) radicals play a dominant role in the degradation of dye. The high efficiency is attributed to synergistic interactions between the components, which facilitated efficient charge transport and active radical generation. These findings highlight the potential of this ternary system as an effective, solar driven photocatalyst for environmental remediation applications.},
 author = {Prakash Kurmi and Sakshi Malik and Siddhartha Sankar Dhar},
 doi = {https://doi.org/10.1016/j.jpcs.2025.113437},
 issn = {0022-3697},
 journal = {Journal of Physics and Chemistry of Solids},
 keyword = {CaFeO, Congo Red, MOF-mixture, Photodegradation, Super-oxide radicals, ZIF-67@ZIF-8},
 pages = {113437},
 title = {Efficient photocatalytic degradation of Congo Red dye under solar irradiation using a novel ternary nanocomposite CaFe2O4/ZIF-67@ZIF-8},
 url = {https://www.sciencedirect.com/science/article/pii/S002236972500890X},
 volume = {211},
 year = {2026}
}
