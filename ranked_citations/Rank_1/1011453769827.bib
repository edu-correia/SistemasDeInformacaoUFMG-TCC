@article{10.1145/3769827,
 abstract = {Space-efficient streaming estimation of quantiles in massive datasets is a fundamental problem with numerous applications in data monitoring and analysis. While theoretical research led to optimal algorithms, such as the Greenwald-Khanna algorithm or the KLL sketch, practitioners often use other sketches that perform significantly better in practice but lack theoretical guarantees. Most notably, the widely used t-digest has unbounded worst-case error. In this paper, we seek to get the best of both worlds. We present a new quantile summary, SplineSketch, for numeric data, offering near-optimal theoretical guarantees, namely uniformly bounded rank error, and outperforming t-digest by a factor of 2-20 on a range of synthetic and real-world datasets. To achieve such performance, we develop a novel approach that maintains a dynamic subdivision of the input range into buckets while fitting the input distribution using monotone cubic spline interpolation.},
 address = {New York, NY, USA},
 articleno = {362},
 author = {\L{}ukasiewicz, Aleksander and T\v{e}tek, Jakub and Vesel\'{y}, Pavel},
 doi = {10.1145/3769827},
 issue_date = {December 2025},
 journal = {Proc. ACM Manag. Data},
 keyword = {cubic spline interpolation, data sketches, mergeable summaries, quantile estimation, streaming algorithms},
 month = {December},
 number = {6},
 numpages = {26},
 publisher = {Association for Computing Machinery},
 title = {SplineSketch: Even More Accurate Quantiles with Error Guarantees},
 url = {https://doi.org/10.1145/3769827},
 volume = {3},
 year = {2025}
}
