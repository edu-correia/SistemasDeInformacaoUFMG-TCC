@conference{Tomita2016219,
 abstract = {In this paper, I will focus on the event quanification and free variable problems in seantics for Minimalist Grammar formalism, with which both Montagovian compositional semantics and neo-Davidsonian event semanics are compatible. In the lit ENGLerature, two opertions of the formalism, MERGE and MOVE, are considered to correspond to semantic oprations. MERGE corresponds to functional application or predicate conjunction, whereas MOVE determines a quantifier scope. In these semantic frameworks for Minimalist Gramar, however, the event quantification and free variable problems remain unsolved. Here I first propose a compositional event semantics for a subset of the formalism without MOVE and show that compositional event semantics is a key to solving the event quantification problem. Then, I extend the result to the foralism enriched with MOVE, and show that it is unnecessary to add any free variables or assignment functions.},
 author = {Tomita, Yu},
 journal = {Proceedings of the 30th Pacific Asia Conference on Language, Information and Computation, PACLIC 2016},
 note = {Cited by: 2},
 pages = {219 - 227},
 publication_stage = {Final},
 source = {Scopus},
 title = {Solving event quantification & free variable problems in semantics for minimalist grammars},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85015827107?origin=resultslist},
 year = {2016}
}
