@conference{Jacob2022,
 abstract = {Challenges in the data classification domain of the Internet of Things (IoT) are increasing day by day because of the large volume and diversity of sensor data. Understanding the variety and veracity of the data to predict their classes accurately with minimum time requirements is inevitable in most IoT applications. This paper proposes a novel sorting method that reduces the execution time of k Nearest Neighbor (kNN) classifier. Experiments prove that the increase in the size of the dataset does not affect the execution time and performance of the proposed method, and it is 8X faster than the traditional kNN. © 2022 IEEE.},
 author = {Jacob, Sneha and Mhamed, Anuj},
 doi = {10.1109/IC3SIS54991.2022.9885354},
 journal = {Proceedings of International Conference on Computing, Communication, Security and Intelligent Systems, IC3SIS 2022},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Expeditious kNN Algorithm for Massive IoT Data Classification},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85139164996?origin=resultslist},
 year = {2022}
}
