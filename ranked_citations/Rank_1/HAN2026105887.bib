@article{HAN2026105887,
 abstract = {Camouflaged Object Detection (COD) aims to accurately identify objects visually embedded in their surroundings, which is considerably more challenging than conventional object detection due to low contrast, complex backgrounds, and varying object scales. Although recent deep learning approaches have shown promising results, they often suffer from incomplete or inaccurate detections, primarily due to the inadequate exploitation of multi-scale contextual features and cross-level information. To address these limitations, we propose a novel architecture, termed Attention and Mask-guided Context Fusion Network (AMCFNet). The framework comprises two core modules: Attentional Multi-scale Context Aggregation (AMCA) and Mask-guided Cross-level Fusion (MCF). The AMCA module improves the semantic representation of features at different levels by merging both global and local context information through a bidirectional attention mechanism, which includes wavelet-based modulation of channel and spatial data. The MCF module leverages high-level mask priors to guide the fusion of semantic and spatial features, applying an attention-weighted mechanism to highlight object-related regions while minimizing background interference. Comprehensive tests on four well-known COD benchmark datasets show that AMCFNet outperforms existing methods, providing more accurate camouflaged object detection under various challenging conditions.},
 author = {Qiuying Han and Shaohui Zhang and Peng Wang},
 doi = {https://doi.org/10.1016/j.imavis.2025.105887},
 issn = {0262-8856},
 journal = {Image and Vision Computing},
 keyword = {Camouflaged object detection, Attention and mask-guided context fusion network, Attentional multi-scale context aggregation, Mask-guided cross-level fusion},
 pages = {105887},
 title = {Attention and mask-guided context fusion network for camouflaged object detection},
 url = {https://www.sciencedirect.com/science/article/pii/S0262885625004755},
 volume = {166},
 year = {2026}
}
