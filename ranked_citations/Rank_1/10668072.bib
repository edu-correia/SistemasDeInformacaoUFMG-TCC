@inproceedings{10668072,
 abstract = {In this paper, we aim to enhance Convolutional Neural Networks (CNNs) by merging features from different pretrained models to improve information representation. Amidst advancements in network depth and architectures, we highlight feature fusion as a method for boosting CNN performance. Despite challenges in managing large feature sets and potential information loss during fusion, our paper introduces the Separation Index (SI) for feature selection. Unlike passive fusion, where all feature maps are simply concatenated, we employ the SI metric for active fusion. This method selects informative and discriminative features for the classification task, reducing computational complexity and model sizes. We evaluate our approach using medical and public datasets, specifically Skin Cancer data and CIFAR-10. The results demonstrate significant improvements in classification performance, confirming the effectiveness of our method. Notably, achieving a 95.63% classification accuracy on the CIFAR-10 dataset showcases the superiority of our approach over baselines and other competing methods.},
 author = {Jamshidi, Movahed and Kalhor, Ahmad and Vahabie, Abdol-Hossein},
 booktitle = {2024 32nd International Conference on Electrical Engineering (ICEE)},
 doi = {10.1109/ICEE63041.2024.10668072},
 issn = {2642-9527},
 keyword = {Measurement;Adaptation models;Accuracy;Computational modeling;Semantic segmentation;Feature extraction;Indexes;feature fusion;Separation Index (SI);feature selection;deep neural networks},
 month = {May},
 number = {},
 pages = {1-7},
 title = {Active Data Fusion in Deep Neural Networks via Separation Index},
 volume = {},
 year = {2024}
}
