@incollection{SQUITIERI2026871,
 abstract = {Synopsis
This article discusses derechos, which are widespread, severe windstorms that originate from cold-pool-driven, bow-echo-structured mesoscale convective systems (MCSs). Derechos are well known for causing significant harm to life and property on large spatial scales. The most intense gusts occur with smaller scale downbursts embedded within broader swaths of damaging winds. Derechos form when clusters of thunderstorms merge, resulting in the buildup of cold stable air, which supports the augmentation of the surface wind field and subsequent occurrence of widespread wind damage. Given how complex the thunderstorm upscale-growth process is to intense MCS formation, and given how weak forcing can be in weather patterns that support bow-echo development, derechos remain difficult to forecast. While advances in numerical weather modeling have taken the science a step forward in improving derecho forecasts, much work remains to be done before derechos can be predicted well in advance with any consistency.},
 address = {Oxford},
 author = {Brian Joseph Squitieri},
 booktitle = {Encyclopedia of Atmospheric Sciences (Third Edition)},
 doi = {https://doi.org/10.1016/B978-0-323-96026-7.00132-6},
 edition = {Third Edition},
 editor = {Walter A. Robinson},
 isbn = {978-0-323-95821-9},
 keyword = {Derecho, Mesoscale convective system (MCS), Severe, Downburst, Thunderstorm, Cold pool, Buoyancy, Outbreak, Rear inflow jet, Mesovortex, Numerical weather prediction, Forecasting},
 pages = {871-880},
 publisher = {Academic Press},
 title = {Derechos},
 url = {https://www.sciencedirect.com/science/article/pii/B9780323960267001326},
 year = {2026}
}
