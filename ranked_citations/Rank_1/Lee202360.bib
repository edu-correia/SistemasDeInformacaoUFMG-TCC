@conference{Lee202360,
 abstract = {Key-Value SSD (KVSSD) has shown great potential for several important classes of emerging data stores due to its high throughput and low latency. When designing a key-value store with range queries, an LSM-tree is considered a better choice than a hash table due to its key ordering. However, the design space for range queries in LSM-tree-based KVSSDs has yet to be explored, despite range queries being one of the most demanding features. In this paper, we investigate the design constraints in LSM-tree-based KVSSDs from the perspective of range queries and propose three design principles. Based on these principles, we present IterKVSSD, an Iterator interface extended LSM-tree-based KVSSD for range queries. We implement IterKVSSD on OpenSSD Cosmos+, and our evaluation shows that it increases range query throughput by up to 4.13× and 7.22× for random and sequential key distributions, respectively, compared to existing KVSSDs. © 2023 ACM.},
 author = {Lee, Seungjin and Lee, Chang-Gyu and Min, Donghyun and Park, Inhyuk and Chung, Woosuk and Sivasubramaniam, Anand and Kim, Youngjae},
 doi = {10.1145/3579370.3594775},
 journal = {Proceedings of the 16th ACM International Conference on Systems and Storage, SYSTOR 2023},
 note = {Cited by: 6},
 pages = {60 - 70},
 publication_stage = {Final},
 source = {Scopus},
 title = {Iterator Interface Extended LSM-tree-based KVSSD for Range Queries},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85166004664?origin=resultslist},
 year = {2023}
}
