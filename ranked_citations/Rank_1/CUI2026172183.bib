@article{CUI2026172183,
 abstract = {Immune checkpoint blockade (ICB) efficacy remains limited by poor immunogenicity, inadequate T cells infiltration, and a highly immunosuppressive tumor microenvironment. To address these challenges, we engineered OXPA, a multifunctional Pt(IV) prodrug designed to orchestrate a coordinated “inside-out” attack by integrating oxaliplatin (OXA)-induced immunogenic cell death (ICD) with lysyl oxidase-like 2 (LOXL2) inhibitor-remodeled extracellular matrix (ECM). Mechanistically, OXPA induces p53-mediated apoptosis, with LOXL2 inhibition further augmenting this effect by suppressing the pro-survival FAK/PI3K/mTOR axis. Strikingly, OXPA reprograms immunosuppressive microenvironments by: i) triggering robust ICD to amplify the cytotoxic T-cell responses; ii) repolarizing the pro-tumoral M2 to anti-tumoral M1 macrophages; and iii) softening the pathological ECM and normalizing the pathological collagen III/I ratio to enhance immune infiltration. Atomic force microscopy (AFM) quantitatively verified ECM softening, which correlated directly with a marked increase in intra-tumoral CD8+ T cells. By simultaneously targeting the fibrotic barrier and immunosuppressive mechanisms, this dual approach successfully turned immunologically “cold” tumors “hot”; ultimately, the combination of OXPA and αPD-L1 achieved profound tumor regression without observable toxicity in colorectal cancer models. This work establishes a novel strategy for Pt(IV)-mediated chemo-immunotherapy by integrating intrinsic ECM targeting, representing a promising paradigm for cancer.},
 author = {Siqian Cui and Xi Chen and Chengyuan Qian and Chunrong Wu and Jian Wang and Yiguo Zhang and Debing Xiang},
 doi = {https://doi.org/10.1016/j.cej.2025.172183},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Colorectal cancer, Chemoimmunotherapy, Extracellular matrix, LOXL2 inhibitor, Macrophage polarization, Platinum conjugate},
 pages = {172183},
 title = {An engineered Pt(IV) conjugate for synergizing extracellular matrix remodeling with chemoimmunotherapy to reverse anti-PD-L1 resistance},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894725130325},
 volume = {528},
 year = {2026}
}
