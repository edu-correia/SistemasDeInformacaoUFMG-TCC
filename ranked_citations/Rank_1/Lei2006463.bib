@conference{Lei2006463,
 abstract = {The vision of pervasive computing is based on the idea that future computers will merge with their environment. Radio Frequency Identification (RFID) and Wireless Sensor Network (WSN) are two important components of pervasive computing, since both technologies can be used for coupling the physical and the virtual world. However, RFID and WSN almost are under development in parallel method, few integration schemes and related opportunities are investigated in detail. Through deep analysis of RFID and WSN, three forms of new system architecture that combines the two technologies are proposed and its feasibility, technical challenges are discussed thoroughly. © 2006 IEEE.},
 author = {Lei, Zhang and Zhi, Wang},
 doi = {10.1109/GCCW.2006.58},
 journal = {Proceedings - Fifth International Conference on Grid and Cooperative Computing, GCC 2006 - Workshops},
 note = {Cited by: 130},
 pages = {463 - 469},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integration of RFID into wireless sensor networks: Architectures, opportunities and challenging problems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/38649088890?origin=resultslist},
 year = {2006}
}
