@inproceedings{11418952,
 abstract = {This work presents a novel microwave linear displacement sensor that integrates a notched lowpass filtering response within a single structure. The design first employs a spoof surface plasmon polariton (SSPP) structure along a 50-ohm microstrip line to achieve a lowpass filtering passband. A square ring resonator (SRR) is then coupled underneath to introduce a sharp notch within this passband. The key innovation lies in utilizing the SRR as a movable sensing element. As the SRR translates along the transmission line, its distance to the input port changes, resulting in a highly linear and sensitive shift in the input reflection phase (∠S11). The proposed sensor demonstrates a high sensitivity of 13.4°/mm over a substantial displacement range of 80 mm. This work successfully merges filtering functionality with high-precision displacement sensing, offering a compact and promising solution for integrated RF sensing systems.},
 author = {Zhou, Xin and Jiang, Chaoyu and Su, Zichen and Tam, Kam-Weng and Zhang, Wenhai and Teng, Cheng and Zhang, Gang},
 booktitle = {2026 IEEE International Microwave Filter Workshop (IMFW)},
 doi = {10.1109/IMFW64610.2026.11418952},
 issn = {},
 keyword = {Radio frequency;Microstrip filters;Surface plasmon polaritons;Sensitivity;Power transmission lines;Filtering;Reflection;Sensors;Passband;Microwave filters;Displacement;notched lowpass filtering;phase;sensor;spoof surface plasmon polariton (SSPP)},
 month = {Feb},
 number = {},
 pages = {1-3},
 title = {Microwave Linear Displacement Sensor With Notched Lowpass Filtering Response},
 volume = {},
 year = {2026}
}
