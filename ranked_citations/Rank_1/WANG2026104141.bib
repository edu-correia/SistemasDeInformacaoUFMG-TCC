@article{WANG2026104141,
 abstract = {A multi-functional lattice structure, inspired by multi-scale microstructural strengthening features, is proposed to enhance the mechanical performance of lattice structures while enabling customizable properties for aerospace. By merging the characteristics of tensile-dominated and bending-dominated lattices, this innovative structure achieves enhanced mechanical properties. Customizable performance is achieved through rod design and adjustment of compression orientation. All specimens were fabricated via 3D printing, and their compression and bending properties were investigated through experiments and simulations. Results indicate that the Hybrid lattice exhibits synergistic deformation. Compared to conventional BCCZ lattices, it shows 6 times higher energy absorption and 2.9 times higher specific energy absorption. Type I and Type II lattices can effectively customize initial peak intensity, Young’s modulus, and stress distributions. A regularity governing the influence of structural parameters on mechanical response is derived. The strengthening and failure mechanisms of the Hybrid lattice are revealed, and the foundation for customized mechanical responses is established. This structural regulation and design approach significantly expands the application prospects of lattice structures in aerospace.},
 author = {Yihao WANG and Hongyong JIANG and Yiru REN},
 doi = {https://doi.org/10.1016/j.cja.2026.104141},
 issn = {1000-9361},
 journal = {Chinese Journal of Aeronautics},
 keyword = {Lattice structure, Customized, Energy absorption, Failure mechanisms, Aerospace applications},
 pages = {104141},
 title = {A lattice structure inspired by multi-scale microstructure with customizable mechanical properties for aerospace},
 url = {https://www.sciencedirect.com/science/article/pii/S1000936126000786},
 year = {2026}
}
