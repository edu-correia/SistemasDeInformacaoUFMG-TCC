@inproceedings{11501843,
 abstract = {In this paper, a wideband low-sidelobe dualcircularly polarized (CP) transmitarray (TA) is proposed based on a spin-decoupled metasurface with amplitude modulation. The metasurface merges propagation phase and PancharatnamBerry (PB) phase to independently control the cross-polarized transmission phases for left-handed CP (LCP) and right-handed CP (RCP) incident waves. In addition, interior rotation is performed within the multilayer meta-atom to induce chirality in the structure, thus introducing tailorable amplitude in the two CP channels. As a proof of concept, a dual-CP TA operated in the 5G millimeter-wave band is designed, fabricated, and experimentally verified, showcasing a suppressed sidelobe level (SLL) of −27.5 and −25.3 dB, an aperture efficiency of 31.3% and 28.6%, as well as a 3-dB gain bandwidth of 22.3% and 23.2%, for the radiated LCP and RCP beams, respectively.},
 author = {Yang, Weixu and Yang, Wanchen and Chen, Dongxu and Chen, Ke and Wang, Xiangchuan and Pan, Shilong and Che, Wenquan and Feng, Yijun},
 booktitle = {2026 IEEE International Workshop on Antenna Technology (iWAT)},
 doi = {10.1109/iWAT66946.2026.11501843},
 issn = {2770-4254},
 keyword = {Antennas;Feeds;Antenna feeds;Apertures;Antenna radiation patterns;Antennas and propagation;Microstrip antennas;Motion pictures;Anisotropic;Filters;spin-decoupled metasurface;low sidelobe;dualcircularly polarization;amplitude modulation;wideband},
 month = {March},
 number = {},
 pages = {1-4},
 title = {A Wideband Low-Sidelobe Dual-Circularly Polarized Transmitarray Based on Spin-Decoupled Metasurface with Amplitude Modulation},
 volume = {},
 year = {2026}
}
