@conference{He2015643,
 abstract = {This paper introduces the task of questionanswer driven semantic role labeling (QA-SRL), where question-answer pairs are used to represent predicate-argument structure. For example, the verb "introduce" in the previous sentence would be labeled with the questions "What is introduced?", and "What introduces something?", each paired with the phrase from the sentence that gives the correct answer. Posing the problem this way allows the questions themselves to define the set of possible roles, without the need for predefined frame or thematic role ontologies. It also allows for scalable data collection by annotators with very little training and no linguistic expertise. We gather data in two domains, newswire text and Wikipedia articles, and introduce simple classifierbased models for predicting which questions to ask and what their answers should be. Our results show that non-expert annotators can produce high quality QA-SRL data, and also establish baseline performance levels for future work on this task. © 2015 Association for Computational Linguistics.},
 author = {He, Luheng and Lewis, Mike and Zettlemoyer, Luke},
 doi = {10.18653/v1/d15-1076},
 journal = {Conference Proceedings - EMNLP 2015: Conference on Empirical Methods in Natural Language Processing},
 note = {Cited by: 180; All Open Access; Gold Open Access},
 pages = {643 - 653},
 publication_stage = {Final},
 source = {Scopus},
 title = {Question-answer driven semantic role labeling: Using natural language to annotate natural language},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84959891222?origin=resultslist},
 year = {2015}
}
