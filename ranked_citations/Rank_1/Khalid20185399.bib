 pages = {5399 - 5431},
 publication_stage = {Final},
 source = {Scopus},
 title = {E-OSched: a load balancing scheduler for heterogeneous multicores},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85047250080?origin=resultslist},
 volume = {74},
 year = {2018}
}
