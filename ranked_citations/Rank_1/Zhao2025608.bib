@conference{Zhao2025608,
 abstract = {The core contradiction of large-scale network probing lies in the gap between the massive target space and limited resources. Existing methods (such as AddrMiner and 6Tree) have made significant progress in macro-level strategies, but their micro-level scheduling mechanisms (frequently selecting the optimal target from the candidate set) are often simplified as FIFO or random selection, becoming performance bottlenecks. This paper finds that this 'select-the-maximum and update' loop is highly similar to multi-way merge sorting, and therefore innovatively proposes an adaptive priority scheduling framework based on a loser tree. This framework has three main advantages: (1) stable efficiency, with an operational complexity maintained at O log k, being cache-friendly and outperforming traditional heap structures; (2) a tightly coupled feedback loop that dynamically balances exploration and exploitation through an adaptive scoring function; and (3) excellent compatibility, allowing seamless integration as a high-performance plugin into existing frameworks. Real IPv6 experiments show that this method significantly outperforms the baselines in both discovery efficiency and system throughput. In the case study, we successfully constructed a high-quality IPv6 active address list, demonstrating its practical deployment value.  © 2025 IEEE.},
 author = {Zhao, An and Wang, Zhike and Bai, Jialing},
 doi = {10.1109/SPCNC68200.2025.11406286},
 journal = {2025 International Conference on Signal Processing, Computer Networks and Communications, SPCNC 2025},
 note = {Cited by: 0},
 pages = {608 - 612},
 publication_stage = {Final},
 source = {Scopus},
 title = {Dynamic IPv6 Probing System with a Loser Tree-Based Adaptive Priority Scheduler},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105035827255?origin=resultslist},
 year = {2025}
}
