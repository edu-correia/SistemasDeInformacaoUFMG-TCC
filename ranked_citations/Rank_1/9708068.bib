@inproceedings{9708068,
 abstract = {This paper presents a Wide Band Antenna Array with a DGS structure for mm-wave 5G communications. 1×4 antenna array has been designed by using RT / Duroid 5880 substrate with the size of 11.34×21.85×0.5mm3. The antenna array with the defected ground structure resonating at the frequency of 28GHz and 38GHz and the wide bandwidth achieved at these two frequencies are 4.17GHz and 6.24GHz with the sufficient gain value of 2.21dBi and 5.21dBi. By implementing DGS on the 1×4 array is providing large bandwidth with good performance characteristics. HFSS software is used to design the antenna and the proposed structure is useful for mm-wave 5G applications.},
 author = {Khan, Aafreen and Ahmad, Anwar},
 booktitle = {2021 IEEE 2nd International Conference on Applied Electromagnetics, Signal Processing, & Communication (AESPC)},
 doi = {10.1109/AESPC52704.2021.9708068},
 issn = {},
 keyword = {5G mobile communication;Merging;Resonant frequency;Dual band;Software;Broadband antennas;Wideband;mm-wave;5G;wide-band;dual-band;defected ground structure(DGS);array},
 month = {Nov},
 number = {},
 pages = {1-4},
 title = {Wide Band Antenna Array with DGS structure for mm-Wave 5G Communications},
 volume = {},
 year = {2021}
