@article{REZAEE2022115026,
 abstract = {Metal-organic framework (MOF) materials provide unprecedented opportunities for evaluating valuable compounds for various medical applications. MOFs merged with biomolecules, used as novel biomaterials, have become particularly useful in biological environments. Bio-MOFs can be promising materials in the global to avoid utilization above toxicological substances. Bio-MOFs with crystallin and porosity nature offer flexible structure via bio-linker and metal node variation, which improves their wide applicability in medical science.},
 author = {Tooba Rezaee and Reihaneh Fazel-Zarandi and Afsaneh Karimi and Ali A. Ensafi},
 doi = {https://doi.org/10.1016/j.jpba.2022.115026},
 issn = {0731-7085},
 journal = {Journal of Pharmaceutical and Biomedical Analysis},
 keyword = {Bio-MOFs, Biological environment, Bio-linker, Surface modification, Biosensor, Point-of-the-care},
 pages = {115026},
 title = {Metal-organic frameworks for pharmaceutical and biomedical applications},
 url = {https://www.sciencedirect.com/science/article/pii/S0731708522004472},
 volume = {221},
 year = {2022}
}
