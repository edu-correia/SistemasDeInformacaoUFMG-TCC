@conference{Krishna2025,
 abstract = {Sorting is a fundamental operation in numerous applications, including those executed on GPUs and CPUs within data centers, often requiring multiple cycles for completion. Enhancing the efficiency of sorting can be achieved through hardware acceleration, particularly by leveraging FPGA or ASIC implementations. A key objective in research is to optimize performance while minimizing power consumption. Conventional sorting algorithms typically involve a significant number of element comparisons, which contributes to increased computational complexity. The comparison sorter presented in this study is specifically optimized for low-power operation. The method used to achieve power reduction is clock gating, which effectively minimizes power consumption. We present the comparison-free sorting engine and its low-power version with comparative results. The saed 90 nm standard cell library was used for implementation and analysis. The experimental results demonstrate a maximum of 35.5% reduction in total power and 62.14% reduction in switching power consumption compared to conventional hardware sorting.  © 2025 IEEE.},
 author = {Krishna, Abhay G and Talakal, Mahanta and Kumar, Sudeendra K.},
 doi = {10.1109/INDISCON66021.2025.11254591},
 journal = {INDISCON 2025 - IEEE 6th India Council International Subsections Conference, Proceedings},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Low Power Comparison free Hardware Sorting Engine using Clock Gating},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105030143687?origin=resultslist},
 year = {2025}
}
