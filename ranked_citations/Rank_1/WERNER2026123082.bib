@article{WERNER2026123082,
 abstract = {Positron Emission Particle Tracking (PEPT) is used in this study to follow particle motion close to a multi-orifice gas distributor in a 9.4cm diameter bed of 300μm sand particles, with particular emphasis on the structure of the multiple jets. Using PEPT, a clustering algorithm has been used to follow the evolution of each of the 12 jets and to show how they deviate from the vertical and eventually merge. Jet dimensions have been determined for each individual jet. Unlike isolated single jets, the multiple jets in this study maintain an almost constant diameter up to the point at which they merge. Particle entry points into the jets were identified, showing that particles are entrained into the jets from all directions but predominantly from the direction of the wall. The time-averaged particle velocity within the jets was measured, with velocities peaking at approximately 1 cm from the origin of each jet.},
 author = {D. Werner and J.P.K. Seville and Tz. Kokalova and C.R.K. Windows-Yule},
 doi = {https://doi.org/10.1016/j.ces.2025.123082},
 issn = {0009-2509},
 journal = {Chemical Engineering Science},
 keyword = {Fluidisation, Jet, Distributor, Plastic recycling, Responsible consumption and production, Climate action},
 pages = {123082},
 title = {Mapping jet coalescence in fluidized beds using positron emission particle tracking},
 url = {https://www.sciencedirect.com/science/article/pii/S0009250925019037},
 volume = {324},
 year = {2026}
}
