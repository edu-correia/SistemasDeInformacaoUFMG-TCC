@article{Arias-Castro2025,
 abstract = {In this paper, we take an axiomatic approach to defining a population hierarchical clustering for piecewise constant densities, and in a similar manner to Lebesgue integration, extend this definition to more general densities. When the density satisfies some mild conditions, e.g., when it has connected support, is continuous, and vanishes only at infinity, or when the connected components of the density satisfy these conditions, our axiomatic definition results in Hartigan’s definition of cluster tree. ©2025 Ery Arias-Castro and Elizabeth Coda.},
 author = {Arias-Castro, Ery and Coda, Elizabeth},
 journal = {Journal of Machine Learning Research},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Axiomatic Definition of Hierarchical Clustering},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85218348081?origin=resultslist},
 volume = {26},
 year = {2025}
}
