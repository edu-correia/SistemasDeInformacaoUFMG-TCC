@article{9999169,
 abstract = {Radar signal deinterleaving is an important part of electronic reconnaissance. This study proposes a new radar signal deinterleaving method based on semantic segmentation, which we call “semantic segmentation deinterleaving” (SSD). We select representative sequence modeling neural network (NN) architectures and input the difference of time of arrival of the pulse stream into them. According to semantics contained in different radar signal types, each pulse in the pulse stream is marked according to the category of semantics contained, and radar signals are deinterleaved. Compared to the traditional deinterleaving method, the SSD method can adapt to complex pulse repetition interval (PRI) modulation environments without searching for the PRI or PRI period. Multiple rounds of search and merging operations are not required for radar signals with multiple pulses in a period. Compared to other deinterleaving methods based on NNs, the SSD method does not need to digitize the data and train a network for each target type. The SSD method also does not need to iterate input and output data. The proposed method has high robustness to pulse loss and noise pulses. This research also shows that recurrent NNs still have more advantages than convolutional NNs in this sequence modeling task.},
 author = {Chao, Wang and Liting, Sun and Zhangmeng, Liu and Zhitao, Huang},
 doi = {10.1109/TSP.2022.3229630},
 issn = {1941-0476},
 journal = {IEEE Transactions on Signal Processing},
 keyword = {Radio frequency;Convolution;Semantic segmentation;Semantics;Merging;Modulation;Radar;Bidirectional gated recurrent unit (BGRU);Bidirectional long short-term memory (BLSTM);Difference of time of arrival (DTOA);Dilated convolutional network (DCN);Radar signal deinterleaving;Semantic segmentation},
 month = {},
 number = {},
 pages = {5806-5821},
 title = {A Radar Signal Deinterleaving Method Based on Semantic Segmentation with Neural Network},
 volume = {70},
 year = {2022}
}
