@inproceedings{5347772,
 abstract = {An common difficulty in structured P2P networks is caused by the dynamic membership of nodes (churn). This results in constant reorganization of overlay topology. The objective of this paper is to handle churn in P2P networks by a flexible cluster-based protocol. In our protocol, a cluster of nodes work together to achieve efficient greedy routing and the size of each cluster varies between an upper bound and a lower bound. We show our protocol achieves a desirable level of stability to absorb the impact of membership change, and improves the rate at which nodes join and leave the overlay network.},
 author = {Xiang, Xu},
 booktitle = {2009 2nd IEEE International Conference on Broadband Network & Multimedia Technology},
 doi = {10.1109/ICBNMT.2009.5347772},
 issn = {},
 keyword = {Peer to peer computing;Fingers;Intrusion detection;Stability;Network topology;Routing protocols;Upper bound;Clustering algorithms;Clocks;Peer-to-Peer;Churn;Stability},
 month = {Oct},
 number = {},
 pages = {669-674},
 title = {Handling churn in structured peer-to-peer networks},
 volume = {},
 year = {2009}
}
