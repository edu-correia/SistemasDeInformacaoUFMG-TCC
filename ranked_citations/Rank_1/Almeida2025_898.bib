@article{Almeida2025_898,
 abstract = {ABSTRACT Urban rivers are increasingly impacted by domestic pollution, mainly due to insufficient sewage treatment. In Brazil, this issue is addressed through Water Body Classification (WBC), a planning instrument that sets water quality goals and actions to achieve them. However, quantifying the pollutant load to be removed remains a challenge, often treated with limited socio-economic integration. This study proposes the use of Load Duration Curves (LDCs) to support more robust and flexible planning. By comparing LDCs with traditional approaches, we highlight their advantages in visualizing uncertainties, integrating population data, and facilitating communication with stakeholders. The results suggest that LDCs can strengthen WBC strategies by improving goal setting, monitoring progress, and supporting re-planning processes under a socio-hydrological approach.},
 author = {Almeida, Camila de Carvalho and Kissula, Juliana Cristina Jansson and Carvalho, João Marcos and Ferreira, Danieli Mara and Coelho, Marcelo and Detzel, Daniel Henrique Marco and Fernandes, Cristovão Vicente Scapulatempo},
 doi = {10.1590/2318-0331.302520250091},
 pages = {e49--e49},
 title = {A socio-hydrology approach to domestic organic pollutant load removal: duration curve analysis for enhancing water quality management},
 volume = {30},
 year = {2025}
}
