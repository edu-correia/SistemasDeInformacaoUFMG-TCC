@article{Gomes2021,
 abstract = {In a demanding and globalized market, production management plays a fundamental role in the company’s reference. Proper management of the production area allows companies to obtain productivity gains, reducing operational costs and make contributions to face the competitiveness of their competitors. When defining its strategic objectives in a productive system, it is necessary to formulate plans to manage human resources and strategies based on requirements. In this context, planning, production, and control (PPC) is an excellent ally of the organizations. The adequate development of the activities of the PPC allows companies to minimize production orders not attended, minimize stocks of raw materials, and finished products, minimize idleness of human resources by efficient allocation of work and minimize production processing times. The present work proposes a study to organize and develop a model that guides the prediction of the setup gain in the fabric dyeing process, structured by the traveling salesman problem. © 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
 author = {Gomes, Uiraquitan Tadeu and Pinheiro, Plácido Rogério and Saraiva, Rommel Dias},
 doi = {10.3390/app11146467},
 journal = {Applied Sciences (Switzerland)},
 note = {Cited by: 11; All Open Access; Gold Open Access; Green Open Access},
 number = {14},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Dye schedule optimization: A case study in a textile industry},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85111089017?origin=resultslist},
 volume = {11},
 year = {2021}
}
