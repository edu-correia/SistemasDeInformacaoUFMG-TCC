@conference{Yuan2024125,
 abstract = {This article delves into the key technologies for time-series data storage in embedded environments. Time-series data, arranged in chronological order, is crucial for various applications such as IoT, finance, and industrial monitoring. Time Series Databases (TSDBs) excel in managing large-scale, high-frequency time-series data, leveraging column-store storage and partitioning techniques for efficient data compression and accelerated query speeds. However, deploying TSDBs in embedded systems poses challenges due to resource constraints, real-time requirements, and low power consumption needs. The article analyzes existing TSDB data models and data structures, focusing on cost-effective historical data storage and handling out-of-order data to reduce storage space and conserve computational resources. It highlights the challenges for adapting TSDBs to embedded environments. © 2024 IEEE.},
 author = {Yuan, Zelan and Ren, Dewang and Zhao, Yao and Wang, Yuyan},
 doi = {10.1109/ICBASE63199.2024.10762008},
 journal = {2024 5th International Conference on Big Data and Artificial Intelligence and Software Engineering, ICBASE 2024},
 note = {Cited by: 0},
 pages = {125 - 128},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Review of Key Technologies for Time-Series Data Storage in Embedded Environments},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85213818460?origin=resultslist},
 year = {2024}
}
