@inproceedings{11465670,
 abstract = {Traditional challenges in CBIR systems, such as descriptor separability, retrieval recall completeness, and computational and memory efficiency, remain unresolved, especially with multi-class image databases. We introduce a new visual search system designed for flexibility and scalability, aiming to maximize retrieval quality while minimizing the descriptor space required for experiments. The proposed method combines hand-crafted features, CNN-based descriptors, and evolutionary optimization to improve retrieval results. In this paper, we present a hybrid approach that merges MPEG-CDVS (Compact Descriptors for Visual Search) and LDVS (Learnable Descriptors for Visual Search). Additionally, we incorporate a Genetic Algorithm for feature selection and apply PCA (preserving the number of principal components) for compression. Experiments on an eightcategory image dataset use metrics such as Precision @K, mAP, ROC, CMC, patch classification error, inlier matching, and run length distributions. Our results demonstrate that LDVS outperforms CDVS, achieving an accuracy of 0.89 at $\mathrm{K}=1$ and an AUC of 0.796. Furthermore, the genetic algorithmbased optimization achieved a precision of 0.95 at a recall of 0.25 when reducing from 4096-D to 256-D with minimal loss of accuracy.},
 author = {Patil, Vikas D. and Kokare, Manesh B.},
 booktitle = {2026 IEEE International Conference on Interdisciplinary Approaches in Technology and Management for Social Innovation (IATMSI)},
 doi = {10.1109/IATMSI68868.2026.11465670},
 issn = {},
 keyword = {Circuits and systems;Contacts;Network-on-chip;Register transfer level;Internet of Things;Communication systems;Videos;Telecommunications;Internet;Protocols;Content-Based Image Retrieval (CBIR);MPEGCDVS;LDVS;Genetic Algorithm (GA);Feature Optimization;Visual Search},
 month = {March},
 number = {},
 pages = {1-7},
 title = {Intelligent Binary Descriptor Generation through GA Based Dimension Selection in MPEG CDVS and LDVS for Visual Search},
 volume = {4th},
