 pages = {101 - 127},
 publication_stage = {Final},
 source = {Scopus},
 title = {Data pattern aware FTL for SLC+MLC hybrid SSD},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84939414718?origin=resultslist},
