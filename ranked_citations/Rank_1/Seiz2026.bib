@article{Seiz2026,
 abstract = {Phase-field simulations are a practical but also expensive tool to calculate microstructural evolution. This work aims to compare explicit time integrators for a broad class of phase-field models involving coupling between the phase-field and concentration. Particular integrators are adapted to constraints on the phase-field as well as storage scheme implications. Reproducible benchmarks are defined with a focus on having exact sharp interface solutions, allowing for identification of dominant error terms. Speedups of 4 to 114 over the classic forward Euler integrator are achievable while still using a fully explicit scheme without appreciable accuracy loss. Application examples include final stage sintering with pores slowing down grain growth as they move and merge over time. © 2026 The Authors.},
 author = {Seiz, Marco and Takaki, Tomohiro},
 doi = {10.1016/j.commatsci.2026.114599},
 journal = {Computational Materials Science},
 note = {Cited by: 0; All Open Access; Green Open Access; Hybrid Gold Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Numerical efficiency of explicit time integrators for phase-field models},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105030556781?origin=resultslist},
 volume = {267},
 year = {2026}
}
