@article{10198318,
 abstract = {Virtual reality (VR), augmented reality (AR), mixed reality (MR), digital twin, Metaverse, and other related digital technologies have attracted much attention in recent years. These new emerging technologies are changing the world significantly. This research introduces a new fusion model, i.e., Fusion Universe (FU), where the virtual, physical, and cognitive worlds are merged together. Therefore, it is crucial to establish a set of principles for the fusion model to ensure it is compatible with our physical universe laws and principles. This article investigates several aspects that could affect immersive and interactive experience; and proposes the fundamental principles for FU that can integrate physical, virtual, and cognitive worlds seamlessly.},
 author = {Zhang, Hao Lan and Xue, Yun and Lu, Yifan and Lee, Sanghyuk},
 doi = {10.1109/MCE.2023.3300488},
 issn = {2162-2256},
 journal = {IEEE Consumer Electronics Magazine},
 keyword = {Metaverse;Consumer electronics;X reality;Synchronization;Mathematical models;Lightning;Space exploration;Solid modeling;Mixed reality;Digital twins;Augmented reality;Mixed reality;Immersive experience;Data integration},
 month = {May},
 number = {3},
 pages = {107-114},
 title = {A Fusion Model: Toward a Virtual, Physical, and Cognitive Integration and Its Principles},
 volume = {13},
 year = {2024}
}
