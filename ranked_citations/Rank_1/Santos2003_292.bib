@article{Santos2003_292,
 abstract = {The present work discusses some principles of materials selection and examines a few selection criteria and contexts in which this technical activity takes place. Emphasis is given to the concept of Merit Indices, and to the methodology employed for its deduction. The Materials Properties Charts and their integration with the Merit Indices are introduced and illustrated by the former of the two case studies here presented whilst the second associates the methodology of materials selection to process selection.},
 author = {Santos, Sydney Ferreira and Ferrante, Maurizio},
 number = {4},
 pages = {487--492},
 title = {Selection methodologies of materials and manufacturing processes},
 volume = {6},
 year = {2003}
}
