@article{TANG2025116843,
 abstract = {Droplet manipulation technologies play a vital role in microfluidics and biological analysis, with applications spanning sample separation, extraction, drug delivery, and high-throughput screening. This study explores a droplet splitting and merging method driven by corona discharge. By depositing charges on the droplet surface and leveraging electric field forces, this approach enables precise control over droplet polarization, stretching, and splitting without the need for complex electrode arrays or mechanical structures. The experimental setup employs a high-voltage corona discharge system to manipulate droplets on a polyethylene terephthalate (PET) film, allowing for efficient splitting and coalescence under controlled conditions. Results demonstrate that voltage and needle-droplet distance are critical factors influencing droplet behavior, with higher voltages and optimized distances achieving precise control over droplet volume and splitting ratios. Additionally, this method facilitates sequential and simultaneous droplet reactions, enabling complex chemical processes at the microscale. This research establishes a flexible, efficient, and non-contact droplet manipulation platform, offering significant potential for advancing microfluidic applications in areas such as sample preparation, chemical synthesis, and bioassays.},
 author = {Qiang Tang and Yiqing Liu and Xinyi Qiu and Manfei Liu and Xiaxia Cui and Chengjun Wang and Changguo Xue},
 doi = {https://doi.org/10.1016/j.sna.2025.116843},
 issn = {0924-4247},
 journal = {Sensors and Actuators A: Physical},
 keyword = {Corona discharge, Droplet splitting, Droplet coalescence, Microreactor},
 pages = {116843},
 title = {On-demand electrostatic droplet splitting and coalescence by corona discharge},
 url = {https://www.sciencedirect.com/science/article/pii/S0924424725006491},
 volume = {393},
 year = {2025}
}
