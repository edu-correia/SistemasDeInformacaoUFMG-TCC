@article{WANG2026122854,
 abstract = {In this study, we introduce a dynamical polynomial-based self-organizing neural network (DPSON) constructed with autoencoder and adaptive generation of fuzzy polynomial neurons/polynomial neurons to mitigate overfitting and numerical instability problems in conventional polynomial-based self-organizing networks (PSONs). In existing PSONs, the complexity of the polynomial neurons increases exponentially in a function-like manner, leading to an increased rate of rapid convergence of the training process. The fundamental components of the proposed model are constructed as a series of hybrid regulated layers (HRLs), each combining an autoencoder fusion layer (AFL) and an adaptive neuron pruning layer (ANPL). AFL provides reliable input space partitioning with original essential features, a procedure that enhances the generalization ability of the proposed DPSON, which can capture essential information without being affected by distortions caused by higher-order polynomial transformations. In addition, ANPL dynamically adjusts the neuron partitioning of the network by the performance representation of the validation set, thus strengthening the network structure and improving the expressiveness of the self-organizing network layers. The dual neuron forms of the proposed DPSON, which are anchored by fuzzy polynomial neurons (FPNs) and polynomial neurons (PNs), demonstrate adeptness in merging complicated data complexities and comprehensive performance improvement. From the perspective of the weights learning method, the robustness of the proposed DPSON can be further enhanced by using ℓ2-norm regularization least squares estimation (ℓ2-LSE). Experimental results and analysis on 26 datasets, including 24 available public and 2 industrial applications, demonstrate that DPSON outperforms both classical and state-of-the-art machine learning models in terms of modeling accuracy. And the synergy of the proposed methods effectively captures complex nonlinear relationships in the data while preventing potential overfitting to enhance robustness.},
 author = {Zhen Wang and Sung-Kwun Oh and Zunwei Fu and Seok-Beom Roh and Eun-Hu Kim and Jin-Yul Kim},
 doi = {https://doi.org/10.1016/j.ins.2025.122854},
 issn = {0020-0255},
 journal = {Information Sciences},
 keyword = {Self-organizing neural networks, Adaptive neuron pruning, Autoencoder, Hybrid regulated layer, ℓ2-norm least squares estimation},
 pages = {122854},
 title = {Dynamical polynomial-based self-organizing neural networks designed through autoencoder-driven feature selection and adaptive neuron pruning},
 url = {https://www.sciencedirect.com/science/article/pii/S0020025525009909},
 volume = {729},
 year = {2026}
}
