@conference{Zhang2025633,
 abstract = {Multi-control image synthesis, which simultaneously incorporates diverse conditions, is essential for precise and flexible image generation. However, existing methods often suffer from challenges such as condition suppression or conflict. Condition suppression occurs when one condition's influence diminishes or overrides another. Condition conflict happens when conditions entangle with each other. The main reason of these challenges is that traditional methods combine the features of all condition images by adding them together. This approach merge all conditions into a single representation space, leading to excessive coupling between conditions. In this paper, we propose AttnControl, a novel attention-guided concatenation-based fusion strategy designed to address these limitations. Our approach combines condition features, image features, and text features via attention mechanism to handle each condition separately, retaining its independent representation. This decoupling mechanism significantly mitigates condition suppression and conflict, allowing the model to process complex multi-condition inputs effectively. Extensive experiments demonstrate that AttnControl achieves superior performance across a wide range of multi-condition scenarios. © 2025 IEEE.},
 author = {Zhang, Yiming and Wang, He and Dai, Longquan},
 doi = {10.1109/ICICML67980.2025.11333702},
 journal = {2025 4th International Conference on Image Processing, Computer Vision and Machine Learning, ICICML 2025},
 note = {Cited by: 0},
 pages = {633 - 639},
 publication_stage = {Final},
 source = {Scopus},
 title = {AttnControl: Attention-Guided Control for Diffusion Model with Multi-Condition},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105037387497?origin=resultslist},
 year = {2025}
}
