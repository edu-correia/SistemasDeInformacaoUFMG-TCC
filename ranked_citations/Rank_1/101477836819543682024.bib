@article{10.14778/3681954.3682024,
 abstract = {Checking query equivalence is of great significance in database systems. Prior work in automated query equivalence checking sets the first steps in formally modeling and reasoning about query optimization rules, but only supports a limited number of query features. In this paper, we present Qed, a new framework for query equivalence checking based on bag semantics. Qed uses a new formalism called Q-expressions that models queries using different normal forms for efficient equivalence checking, and models features such as integrity constraints and NULLs in a principled way unlike prior work. Our formalism also allows us to define a new query fragment that encompasses many real-world queries with a complete equivalence checking algorithm, assuming a complete first-order theory solver. Empirically, Qed can verify 299 out of 444 query pairs extracted from the Calcite framework and 979 out of 1287 query pairs extracted from CockroachDB, which is more than 2\texttimes{} the number of cases proven by prior state-of-the-art solver.},
 author = {Wang, Shuxian and Pan, Sicheng and Cheung, Alvin},
 doi = {10.14778/3681954.3682024},
 issn = {2150-8097},
 issue_date = {July 2024},
 journal = {Proc. VLDB Endow.},
 month = {July},
 number = {11},
 numpages = {13},
 pages = {3602–3614},
 publisher = {VLDB Endowment},
 title = {QED: A Powerful Query Equivalence Decider for SQL},
 url = {https://doi.org/10.14778/3681954.3682024},
 volume = {17},
 year = {2024}
}
