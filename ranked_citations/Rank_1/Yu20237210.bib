@conference{Yu20237210,
 abstract = {In this paper, we present a centralized framework for multi-session LiDAR mapping in urban environments, by utilizing lightweight line and plane map representations instead of widely used point clouds. The proposed framework achieves consistent mapping in a coarse-to-fine manner. Global place recognition is achieved by associating lines and planes on the Grassmannian manifold, followed by an outlier rejection-aided pose graph optimization for map merging. Then a novel bundle adjustment is also designed to improve the local consistency of lines and planes. In the experimental section, both public and self-collected datasets are used to demonstrate efficiency and effectiveness. Extensive results validate that our LiDAR mapping framework could merge multi-session maps globally, optimize maps incrementally, and is applicable for lightweight robot localization. © 2023 IEEE.},
 author = {Yu, Zehuan and Qiao, Zhijian and Qiu, Liuyang and Yin, Huan and Shen, Shaojie},
 doi = {10.1109/IROS55552.2023.10341462},
 journal = {IEEE International Conference on Intelligent Robots and Systems},
 note = {Cited by: 12},
 pages = {7210 - 7217},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi-Session, Localization-Oriented and Lightweight LiDAR Mapping Using Semantic Lines and Planes},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85182523461?origin=resultslist},
 year = {2023}
}
