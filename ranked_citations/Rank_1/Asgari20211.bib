@conference{Asgari20211,
 abstract = {Sparse matrices are the key ingredients of several application domains, from scientific computing to machine learning. The primary challenge with sparse matrices has been efficiently storing and transferring data, for which many sparse formats have been proposed to significantly eliminate zero entries. Such formats, essentially designed to optimize memory footprint, may not be as successful in performing faster processing. In other words, although they allow faster data transfer and improve memory bandwidth utilization - the classic challenge of sparse problems - their decompression mechanism can potentially create a computation bottleneck. Not only is this challenge not resolved, but also it becomes more serious with the advent of domain-specific architectures (DSAs), as they intend to more aggressively improve performance. The performance implications of using various formats along with DSAs, however, has not been extensively studied by prior work. To fill this gap of knowledge, we characterize the impact of using seven frequently used compression formats on performance, based on a DSA for sparse matrix-vector multiplication (SpMV), implemented on an FPGA using high-level synthesis (HLS) tools, a growing and popular method for developing DSAs. Seeking a fair comparison, we tailor and well-optimize the HLS implementation of decompression for each format. We explore metrics, including decompression overhead, latency, balance ratio, throughput, memory bandwidth utilization, resource utilization, and power consumption, on a variety of real-world and synthetic sparse workloads.  © 2021 IEEE.},
 author = {Asgari, Bahar and Hadidi, Ramyad and Dierberger, Joshua and Steinichen, Charlotte and Marfatia, Amaan and Kim, Hyesoon},
 doi = {10.1109/IISWC53511.2021.00012},
 journal = {Proceedings - 2021 IEEE International Symposium on Workload Characterization, IISWC 2021},
 note = {Cited by: 13; All Open Access; Green Open Access},
 pages = {1 - 12},
 publication_stage = {Final},
 source = {Scopus},
 title = {Copernicus: Characterizing the Performance Implications of Compression Formats Used in Sparse Workloads},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85123975109?origin=resultslist},
 year = {2021}
}
