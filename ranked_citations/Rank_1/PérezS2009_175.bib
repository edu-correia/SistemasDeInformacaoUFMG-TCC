@article{PérezS2009_175,
 abstract = {In this work, we present a fuzzy electronic neuron that has a Dubois fuzzy integration method, an activation function with a fuzzy threshold, and a fuzzy response. We generated a fuzzy sum of the input signals and a shooting threshold value defined by means of a triangular or sinusoidal membership function. We present the electronic circuits, the oscilograms of the neuron responses, the value of the fuzzy integral, and we compare their behavior with those of a conventional leaky integrator neuron.},
 author = {Pérez S., J. L. and Garcés M., A. and Cabiedes C., F. and Miranda V., A.},
 number = {1},
 pages = {73--82},
 title = {Electronic model of a dubois fuzzy integration neuron},
 volume = {7},
 year = {2009}
}
