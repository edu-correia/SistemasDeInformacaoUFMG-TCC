@incollection{JIA2025218,
 abstract = {Over the past two decades, photoredox catalysis has become an indispensable tool in synthetic chemistry under mild green conditions. In this context, the use of photo-oxidation strategies to achieve oxidative cross-coupling and oxygenation reactions using oxygen as the terminal oxidant has attracted widespread attention from synthetic chemists. Recently, the merging of photo-oxidation strategies with asymmetric organometallic catalysis or organocatalysis has resulted in remarkable achievements. This section provides an overview of the strategies and catalytic modes of asymmetric oxidation reactions involving light.},
 address = {Oxford},
 author = {Yue Jia and Xiang-Kui He and Liang-Qiu Lu and Wen-Jing Xiao},
 booktitle = {Comprehensive Organic Synthesis (Third Edition)},
 doi = {https://doi.org/10.1016/B978-0-323-96025-0.00113-7},
 edition = {Third Edition},
 editor = {Gary Molander and Paul Knochel},
 isbn = {978-0-323-96024-3},
 keyword = {Asymmetric catalysis, Cross coupling, Oxidation, Photocatalysis, Visiblelight},
 pages = {218-231},
 publisher = {Elsevier},
 title = {8.36 - Asymmetric Oxidation Using Photocatalysis},
 url = {https://www.sciencedirect.com/science/article/pii/B9780323960250001137},
 year = {2025}
}
