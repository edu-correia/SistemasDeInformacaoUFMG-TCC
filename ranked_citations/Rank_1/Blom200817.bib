@article{Blom200817,
 abstract = {We study distributed state space generation on a cluster of workstations. It is explained why state space partitioning by a global hash function is problematic when states contain variables from unbounded domains, such as lists or other recursive datatypes. Our solution is to introduce a database which maintains a global numbering of state values. We also describe tree-compression, a technique of recursive state folding, and show that it is superior to manipulating plain state vectors. This solution is implemented and linked to the μCRL toolset, where state values are implemented as maximally shared terms (ATerms). However, it is applicable to other models as well, e.g., PROMELA models via the NIPS virtual machine. Our experiments show the trade-offs between keeping the database global, replicated, or local, depending on the available network bandwidth and latency. © 2008 Elsevier B.V. All rights reserved.},
 author = {Blom, Stefan and Lisser, Bert and van de Pol, Jaco and Weber, Michael},
 doi = {10.1016/j.entcs.2007.10.018},
 journal = {Electronic Notes in Theoretical Computer Science},
 note = {Cited by: 13; All Open Access; Gold Open Access; Green Open Access},
 number = {1},
 pages = {17 - 32},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Database Approach to Distributed State Space Generation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/44349140005?origin=resultslist},
 volume = {198},
 year = {2008}
}
