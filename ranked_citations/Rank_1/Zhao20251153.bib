@conference{Zhao20251153,
 abstract = {With the widespread application of large-scale distributed systems, real-time monitoring and performance optimization have become crucial. Traditional monitoring methods often face issues of high latency and performance degradation, especially in data collection, transmission, storage, and scheduling. This paper proposes a real-time monitoring and performance optimization framework that integrates eBPF technology, QUIC protocol, deep reinforcement learning, and advanced storage optimization methods. The framework achieves non-intrusive data collection in kernel space through eBPF, effectively reducing system overhead and improving real-time performance; QUIC protocol provides low-latency data transmission, and deep reinforcement learning optimizes load scheduling; LSM-Tree combined with approximate query techniques enhances storage efficiency. Experimental results show that the proposed method outperforms traditional techniques in task completion time, resource utilization, and fault prediction, significantly improving the overall performance and stability of large-scale distributed systems.  © 2025 IEEE.},
 author = {Zhao, Chuangye and Li, Bo and Wang, Huipeng and Lei, Zhiqi and Dong, Caihong},
 doi = {10.1109/CISCE65916.2025.11065315},
 journal = {2025 IEEE 7th International Conference on Communications, Information System and Computer Engineering, CISCE 2025},
 note = {Cited by: 0},
 pages = {1153 - 1158},
 publication_stage = {Final},
 source = {Scopus},
 title = {Real-time Monitoring and Performance Optimization Strategy for Large-Scale Distributed Systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105011987095?origin=resultslist},
 year = {2025}
}
