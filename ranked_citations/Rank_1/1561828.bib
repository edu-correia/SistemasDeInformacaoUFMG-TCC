@article{1561828,
 abstract = {This paper presents a low-cost, user-friendly, and real-time operating 3D camera design. Unlike most of the previous researches, this paper proposes techniques for integrating mass-produced consumer electronic devices and merging two taken 3D models. In the design, an off-the-shelf consumer video projector is used to reduce the cost, a dual-camera framework is adopted to improve the feasibility and practicability of the 3D camera, and a dual-port video graphics card with the extended display mode is used to construct a user-friendly viewfinder for real-time operating. Experimental results show that the proposed 3D camera achieves a good performance.},
 author = {Cheng Wen and Kuang-Chiung Chang and Ming-Feng Yeh},
 doi = {10.1109/TCE.2005.1561828},
 issn = {1558-4127},
 journal = {IEEE Transactions on Consumer Electronics},
 keyword = {Cameras;Surface emitting lasers;Optical devices;Stimulated emission;Optical sensors;Merging;Costs;Reverse engineering;Prototypes;Optical distortion},
 month = {Nov},
 number = {4},
 pages = {1085-1091},
 title = {A low-cost, user-friendly, and real-time operating 3D camera},
 volume = {51},
 year = {2005}
}
