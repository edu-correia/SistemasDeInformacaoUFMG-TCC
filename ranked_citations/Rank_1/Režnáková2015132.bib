@article{Režnáková2015132,
 abstract = {Abstract In this paper we introduce a novel online self-organized clustering method based on the ART-2A network for Takagi-Sugeno fuzzy models. To accomplish the self-organization, we introduce an automatic decision algorithm along with solutions for merging and splitting of rules as well as the parameters they operate with, such as our novel incremental distance measurement and competitive recursive least squares. We emphasize the learning algorithm's having an impact for initial as well as long-term learning capabilities. We also emphasize the challenge for online learning, where examples are incoming in real-time and thus are unknown before they can be learned. Therefore, we solve parameter fixing by introducing a parameter free method. We show the performance of our method on various machine learning benchmarks as a highly accurate and low time-consuming method capable of adapting to different databases without the need for fixing any of its parameters according to the database. © 2015 Elsevier B.V. All rights reserved.},
 author = {Režnáková, Marta and Tencer, Lukas and Cheriet, Mohamed},
 doi = {10.1016/j.asoc.2015.02.022},
 journal = {Applied Soft Computing Journal},
 note = {Cited by: 2},
 pages = {132 - 152},
 publication_stage = {Final},
 source = {Scopus},
 title = {SO-ARTIST: Self-organized ART-2A inspired clustering for online Takagi-Sugeno fuzzy models},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84925622256?origin=resultslist},
 volume = {31},
 year = {2015}
}
