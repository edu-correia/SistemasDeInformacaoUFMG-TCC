@conference{Yiu2021319,
 abstract = {Aircrafts are separated by a specified distance via the instructions of the air traffic control officers, so the trailing aircraft would not suffer from the wake vortex effect nor actual conflicts. However, with the surging air transport volume in the past decades, the current model of terminal manoeuvring area could not satisfy the growing demand. Safety might be compromised by the high workload of the air traffic control officers as they might not be aware of the potential violations. Hence, a novel approach transforming communication-based train control using flight speed is proposed to enhance the efficiency and the safety of air traffic management. This study develops mathematical models and an algorithmic framework for supporting the terminal traffic flow decision with real-time surveillance-broadcast data. The decision quality and situational awareness in air traffic control can be enhanced to facilitate the estimation of incoming traffic in the area control jurisdiction. © 2021 IEEE.},
 author = {Yiu, Cho Yin and Tam, Tsz Kin and Ng, Kam K. H.},
 doi = {10.1109/IEEM50564.2021.9672861},
 journal = {2021 IEEE International Conference on Industrial Engineering and Engineering Management, IEEM 2021},
 note = {Cited by: 2; All Open Access; Green Open Access},
 pages = {319 - 323},
 publication_stage = {Final},
 source = {Scopus},
 title = {An ADS-B Aided Dynamic Traffic Alert for Robust Safety Assessment in Controlled Airspace},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85125391770?origin=resultslist},
 year = {2021}
}
