@inproceedings{11446052,
 abstract = {Recently, Multi-modal Large Language Models (MLLMs) have shown remarkable effectiveness for multi-modal tasks due to their ability of cross-modal understanding. However, processing long sequences of visual tokens extracted from visual backbones poses challenges for deployment in real-time applications. To address this issue, we introduce FOLDER, a simple yet effective plug-and-play module designed to reduce the length of the visual token sequence, mitigating computational and memory demands during both training and inference. Through a comprehensive analysis of the token reduction process in the vision encoder, we analyze the information loss introduced by different reduction strategies and develop FOLDER to preserve key information while removing visual redundancy. We show the effectiveness of FOLDER by integrating it into the visual backbone of various MLLMs, significantly accelerating the inference phase. Furthermore, we evaluate its utility as a training accelerator or even performance booster for MLLMs. FOLDER achieves comparable or even better performance than the original models, while dramatically reducing complexity by removing up to 70 % of visual tokens. Our code is available at FOLDER Repository.},
 author = {Wang, Haicheng and Yu, Zhemeng and Spadaro, Gabriele and Ju, Chen and Quétu, Victor and Xiao, Shuai and Tartaglione, Enzo},
 booktitle = {2025 IEEE/CVF International Conference on Computer Vision (ICCV)},
 doi = {10.1109/ICCV51701.2025.02192},
 issn = {2380-7504},
 keyword = {Videos;Pixel;Video equipment;Protocols;HTTP;Communication systems;High frequency;Instant messaging;Local area networks;Optical projectors},
 month = {Oct},
 number = {},
 pages = {23614-23625},
 title = {FOLDER: Accelerating Multi-Modal Large Language Models with Enhanced Performance},
 volume = {},
 year = {2025}
}
