@inproceedings{1175385,
 abstract = {We describe the design and implementation of a system for content-based image retrieval (CBIR). The system uses structural description by labelled graphs. When a graph representation is used, the comparison task is performed by a graph matching technique. Like all CBIR systems, the one proposed here has two components: a segmentation component which uses an efficient fuzzy clustering algorithm and a matching component which employs a new Inexact graph matching algorithm.},
 author = {Hlaoui, A. and Hao-Jun Sun and Sheng-Rui Wang},
 booktitle = {Proceedings. International Conference on Machine Learning and Cybernetics},
 doi = {10.1109/ICMLC.2002.1175385},
 issn = {},
 keyword = {Image retrieval;Image segmentation;Clustering algorithms;Image databases;Merging;Fuzzy systems;Content based retrieval;Computer vision;Machine learning algorithms;Sun},
 month = {Nov},
