@inproceedings{10673520,
 abstract = {This research introduces a comprehensive approach for enzyme classification, merging Exploratory Data Analysis (EDA) with a Neural Network (NN) model. Leveraging a dataset of 858,777 labeled amino acid sequences, originating from ten organisms, the model predicts enzyme classes in a test set of 253,146 samples while excluding sequences above a set length. Preprocessing involves omitting rare amino acids (X, U, B, Z) and accounting for amino acids (B, Z) exclusive to the training set. The Neural Network architecture, comprising an embedding layer, bidirectional LSTM layers, and a dense output layer, yields promising results with 79% accuracy on the test set after 20 epochs. A detailed classification report and confusion matrix showcase the model's efficacy across 20 enzyme classes. This study advances enzyme classification methodologies, demonstrating the significance of EDA and NN integration in bioinformatics and molecular biology. Future directions involve exploring additional features and optimization strategies for continued model enhancement.},
 author = {Agarwal, Muskan and Singh Gill, Kanwarpartap and Aggarwal, Priyanshi and Singh Rawat, Ramesh and Sunil, G},
 booktitle = {2024 Asia Pacific Conference on Innovation in Technology (APCIT)},
 doi = {10.1109/APCIT62007.2024.10673520},
 issn = {},
 keyword = {Enzymes;Analytical models;Data analysis;Accuracy;Biological system modeling;Artificial neural networks;Predictive models;Enzyme Classification;Amino Acid Sequences;Exploratory Data Analysis;Neural Networks;Bioinformatics},
 month = {July},
 number = {},
 pages = {1-5},
 title = {Enzyme Classification through Exploratory Data Analysis and Sequential Neural Network Modeling},
 volume = {},
 year = {2024}
}
