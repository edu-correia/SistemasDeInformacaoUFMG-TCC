@conference{Byeon2023109,
 abstract = {While the state-of-the-art runtime zone-reset algorithm of the ZenFS in RocksDB is optimized for the performance of Zone Namespace (ZNS) SSDs, it does not take into account the lifetime constraint of ZNS SSDs. To address this issue, we present FAR, a Free-space Adaptive Runtime Zone-Reset algorithm for ZenFS, which dynamically adjusts the frequency of runtime zone-reset calls based on the available free-space in the ZNS SSD. We developed FAR with the ZenFS of RocksDB using a ZNS SSD prototype based on the Cosmos+ OpenSSD platform and compared it with the state-of-the-art runtime zone-reset algorithm used in ZenFS. Our extensive evaluations demonstrate that FAR improves the lifetime of ZNS SSD by 2x without compromising performance. © 2023 ACM.},
 author = {Byeon, Sungjin and Ro, Joseph and Jamil, Safdar and Kang, Jeong-Uk and Kim, Youngjae},
 doi = {10.1145/3599691.3603410},
 journal = {HotStorage 2023 - Proceedings of the 2023 15th ACM Workshop on Hot Topics in Storage and File Systems},
 note = {Cited by: 13},
 pages = {109 - 115},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Free-Space Adaptive Runtime Zone-Reset Algorithm for Enhanced ZNS Efficiency},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85168385991?origin=resultslist},
 year = {2023}
}
