@article{11296755,
 abstract = {To solve limitations of existing social recommendation models—including poor multi-source representation fusion, low semantic closeness of fused features, and inability to use social information in lightweight graph convolutional networks—this study proposes the Attention Representation Fusion based Light Graph Convolutional Network model. It extends LightGCN to social recommendation scenarios, achieving better recommendation performance with low computational costs. An attention-based representation fusion module merges user representations from user-item bipartite graphs and social network graphs into a unified embedding. This module learns importance weights of different data modalities and uses normalization to avoid embedding dimensionality expansion with more network layers, ensuring stable parameter learning. An asymmetric binary GCN structure is also adopted, with two GCNs of different layer counts, K layers for user-item bipartite graphs and K/2 layers for social network graphs. By fusing their layer-wise outputs at intervals, the model improves semantic similarity between user interest representations and social influence representations. Experiments on three real-world datasets show ARF-LGN outperforms six state-of-the-art models. On Last.FM, it improves Recall@20 and NDCG@20 by 2.53% and 3.55% vs. LightGCN, on Ciao, 2.48% and 2.70% vs. DiffNet++, on Epinions, 4.42% and 3.93% vs. DiffNet++. Complexity analysis confirms ARF-LGN has moderate space complexity, and time complexity, making it suitable for practical social recommendation deployment.},
 author = {Min, Jun and Wei, Wenjin and Sheng, Yizhuang and Wei, Zhen and Zuo, Jianhang and Zhai, Wenchao},
 doi = {10.1109/ACCESS.2025.3642800},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {Graph convolutional networks;Bipartite graph;Social networking (online);Collaborative filtering;Vectors;Semantics;Recommender systems;Deep learning;Computational modeling;Attention mechanisms;ARF-LGN;LightGCN;attention mechanism;social recommendation},
 month = {},
 number = {},
 pages = {214627-214638},
 title = {Social Recommendation System Based on Attention Mechanism Representation Fusion Lightweight Graph Convolutional Network},
 volume = {13},
 year = {2025}
}
