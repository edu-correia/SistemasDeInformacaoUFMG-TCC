@conference{Vasiliauskas2025,
 abstract = {This study examines the perspectives of pilots at the Air Base of the Lithuanian Armed Forces regarding flying military air systems, focusing on the importance and prioritization of key characteristics. Utilizing the improved Fuzzy DEMATEL method, the research identifies causal relationships among 14 critical criteria relevant to Lithuania's acquisition of aerial combat systems. The proposed methodology offers a structured decision-making framework, enabling defence policymakers to develop well-informed strategies for selecting the most suitable aerial combat systems. By analyzing interdependencies and ranking criteria based on their influence, the study ensures a comprehensive evaluation approach. The integration of a fuzzy linguistic scale effectively manages uncertainties in expert assessments, enhancing the robustness of the analysis. Findings suggest prioritizing causal criteria such as avionics, reliability, strategic cooperation, operational costs, service ceiling, climbing rate, maneuverability, and combat range. The study highlights NATO's strategic role in shaping air defense priorities and recommends further research on alliance-driven system selection. Future studies may expand the framework to incorporate diverse evaluator perspectives, ensuring adaptability to evolving security challenges.  © 2025 IEEE.},
 author = {Vasiliauskas, Aidas Vasilis and Bekesiene, Svajone and Navickiene, Olga},
 doi = {10.1109/ICMT65201.2025.11061319},
 journal = {2025 10th International Conference on Military Technologies, ICMT 2025 - Proceedings},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Importance of Modern Aerial Combat Systems in National Defence: Key Factors in Acquiring Aerial Combat Systems for Lithuania's Needs},
 type = {Conference paper},
