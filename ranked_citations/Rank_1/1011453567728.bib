@article{10.1145/3567728,
 abstract = {We present VideoPoseVR, a video-based animation authoring workflow using online videos to author character animations in VR. It leverages the state-of-the-art deep learning approach to reconstruct 3D motions from online videos, caption the motions, and store them in a motion dataset. Creators can import the videos, search in the dataset, modify the motion timeline, and combine multiple motions from videos to author character animations in VR. We implemented a proof-of-concept prototype and conducted a user study to evaluate the feasibility of the video-based authoring approach as well as gather initial feedback of the prototype. The study results suggest that VideoPoseVR was easy to learn for novice users to author animations and enable rapid exploration of prototyping for applications such as entertainment, skills training, and crowd simulations.},
 address = {New York, NY, USA},
 articleno = {575},
 author = {Wang, Cheng Yao and Zhou, Qian and Fitzmaurice, George and Anderson, Fraser},
 doi = {10.1145/3567728},
 issue_date = {December 2022},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {virtual reality, content creation, computer animation, 3D motion},
 month = {November},
 number = {ISS},
 numpages = {20},
 publisher = {Association for Computing Machinery},
 title = {VideoPoseVR: Authoring Virtual Reality Character Animations with Online Videos},
 url = {https://doi.org/10.1145/3567728},
 volume = {6},
 year = {2022}
}
