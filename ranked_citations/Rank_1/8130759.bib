@article{8130759,
 abstract = {The Java virtual machine embodies a verifier that performs a set of checks on Java bytecode programs before their execution. The verifier carries out an efficient data-flow analysis applied to a type-level abstract interpretation of the code. The implementations of the bytecode verifier presented a significant problem with programs compiled with the Sun Java compiler (until version 1.4.1): there were legal Java programs which were correctly compiled into a bytecode that was rejected by the verifier. The problem was fixed by removing, in version 1.4.2 and following, some interesting features in the compilation of the try-finally Java construct. Because removing such features has a cost in terms of memory space, in this paper we propose to enhance the bytecode verifier to accept such programs, maintaining the space efficiency of the previous versions of the compiler. We define an abstract interpretation framework in which we model the enhanced version of the verifier. The defined abstract interpretation framework can be considered a good basis for other static analyses of bytecode programs.},
 author = {Barbuti, Roberto and De Francesco, Nicoletta and Tesei, Luca},
 doi = {10.1093/comjnl/bxp031},
 issn = {1460-2067},
 journal = {The Computer Journal},
 keyword = {Java bytecode;abstract interpretation;bytecode verifier},
 month = {July},
 number = {6},
 pages = {679-700},
 title = {An Abstract Interpretation Approach for Enhancing the Java Bytecode Verifier},
 volume = {53},
 year = {2010}
}
