@conference{Mongrédien2008,
 abstract = {To respond to the increasing demand for higher performance position and location services, the legacy GPS system is being modernized with the inclusion of two new civil signals at L2 and L5 frequencies. The implementation of the GPS L5 signal, intended to support safety of life applications, will start in 2008, with the launch of a modified GPS II-RM satellite (that includes an L5 demonstration payload). This signal will be transmitted at 1176.45 MHz with a minimum specified received power of -154.9 dBW. Its structure will notably differ from that of GPS C/A. The most significant innovations include the use of: 1) a QPSK modulation to broadcast a data and a pilot channels for each satellite, 2) NH-modulated PRN spreading sequences and 3) a convolutionally encoded navigation message. These characteristics were selected to provide superior cross-correlation properties, improved phase tracking accuracy and robustness, enhanced inherent multipath and narrow band interference mitigation capacities, and more reliable data demodulation. The improvements in signal design foster the need for innovative acquisition, tracking and data demodulation algorithms development. To this end, a full GPS L5 software receiver (excluding the RF front-end) has been developed at the University of Calgary. The major objective of this paper is to assess the performance of two different L5 tracking implementations and to evaluate their impact on positioning accuracy using the above software. In terms of tracking, the two following algorithms are implemented: 1) the Constant Bandwidth (CB) approach, derived from analog signal control theory; and 2) the Kalman Filter (KF) approach, derived from estimation theory. To overcome the C/A signal limitations in terms of tracking sensitivity and accuracy, recent investigations have demonstrated the significant improvements brought either by superior signal design in the forthcoming GNSS generation or by innovative tracking implementations (such as the KF approach). Attempts to merge these two approaches, however, have been limited so far. In light of the above, the performance of the CB and KF tracking implementations are compared for L5 signals in presence of thermal noise, oscillator phase noise, dynamics and multipath. Furthermore, their impact on Single Point Positioning (SPP) is evaluated in terms of position and velocity accuracy using both Least-Squares (LS) and KF algorithms. In addition, the benefits of carrier phase smoothing of the pseudoranges and C/N<sub>0</sub>-based weighting of the observations are evaluated for both tracking implementations and positioning algorithms. Since the L5 pilot channel was introduced to improve phase tracking accuracy, sensitivity and robustness, it is expected that the KF algorithm and carrier phase smoothing algorithms will benefit from superior phase tracking performance and, therefore, help improve overall position accuracy. Similarly, since the C/N<sub>0</sub> is a direct measure of how well individual channels are tracking, it is anticipated that giving more weight to observations with higher C/N<sub>0</sub> will provide higher positioning accuracy. To provide relevant insight into the L5 performance, testing and validation of the aforementioned tracking and positioning algorithms are performed using real IF samples collected with a hardware simulator using an RF front-end.},
 author = {Mongrédien, C. and Lachapelle, G. and Cannon, M.E.},
