 publication_stage = {Final},
 source = {Scopus},
 title = {Target-Oriented Autonomous Fuzzy Model Adaptation in Multimodal Transfer},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105029039805?origin=resultslist},
 volume = {34},
