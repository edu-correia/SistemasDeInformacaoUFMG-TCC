@article{1224537,
 abstract = {We establish the network capacity (measured in terms of number of users) of a wireless system merging multicarrier code-division multiple-access (MC-CDMA) and smart antennas with oscillating-beam patterns. The MC-CDMA component supports high performance (in a probability-of-error sense) via frequency diversity and high network capacity via code division. The smart antenna with oscillating-beam pattern further enhances performance via transmit diversity (in the form of an induced time diversity) and further enhances network capacity via spatial division. The proposed merger has been shown to achieve a very high performance by exploiting a two-dimensional time-frequency diversity. We demonstrate the impressive network capacity gains achieved by this merger.},
 author = {Zekavat, S.A. and Nassar, C.R.},
 doi = {10.1109/TVT.2003.814226},
 issn = {1939-9359},
 journal = {IEEE Transactions on Vehicular Technology},
 keyword = {Merging;Multiaccess communication;Antenna arrays;Wireless sensor networks;Multicarrier code division multiple access;Corporate acquisitions;Antenna measurements;Frequency diversity;Capacity planning;Transmitting antennas},
 month = {July},
 number = {4},
 pages = {772-778},
 title = {Achieving high-capacity wireless by merging multicarrier CDMA systems and oscillating-beam smart antenna arrays},
 volume = {52},
 year = {2003}
}
