@article{9096586,
 abstract = {An edge termination structure with enhanced field-limiting rings (enhanced FLRs) is proposed to stabilize the breakdown voltage against the surface charge. The pitches of the enhanced rings are designed to mitigate the electric field and expand the depletion layer, which leads to an improvement of the breakdown voltage. In addition, the enhanced FLR is insensitive to surface charge because the field plates completely cover the n- layer. Simulation results indicated that the enhanced FLR did not have any fluctuation of breakdown voltage against surface charge density from 0 to 1×1013 cm-2, whereas conventional structures did have fluctuation. To examine the validity of the concept, we fabricated a silicon carbide (SiC) merged p-i-n Schottky diode with the proposed structure. DC bias stress tests at 150 °C over 1000 h demonstrated the breakdown voltage stability of the enhanced FLR.},
 author = {Hirao, Takashi and Onose, Hidekatsu and Yasui, Kan and Mori, Mutsuhiro},
 doi = {10.1109/TED.2020.2992577},
 issn = {1557-9646},
 journal = {IEEE Transactions on Electron Devices},
 keyword = {Silicon carbide;Electric breakdown;Surface treatment;Structural rings;Silicon;Breakdown voltage;Stress;4H-silicon carbide (SiC);edge termination;field-limiting ring (FLR);high-temperature reverse bias (HTRB);merged p-i-n Schottky (MPS) diode},
 month = {July},
 number = {7},
 pages = {2850-2853},
 title = {Edge Termination With Enhanced Field-Limiting Rings Insensitive to Surface Charge for High-Voltage SiC Power Devices},
 volume = {67},
 year = {2020}
}
