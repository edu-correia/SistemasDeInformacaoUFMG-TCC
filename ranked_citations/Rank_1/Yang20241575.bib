@article{Yang20241575,
 abstract = {In the field of low-light image enhancement, existing deep learning methods face three significant challenges: inaccurate reflection component estimation, poor image enhancement capabilities, and high computational costs. This study introduces a novel, efficient solution to these problems in the form of an Ultra-Lightweight Enhancement Network (ULENet). Our primary contributions are twofold. First, we propose the combination of channel-wise context mining and spatial-wise reinforcement for improved low-light image enhancement. Second, we introduce a novel lightweight neural architecture, ULENet, designed specifically for this purpose. ULENet features two innovative subnetworks: the channel-wise context mining subnetwork for extracting rich context from low-light images, and the spatial-wise reinforcement subnetwork for extensive spatial feature extraction and detail reconstruction. We use the deep-learning framework PyTorch for training and evaluating our model. Extensive experiments demonstrate that ULENet significantly outperforms nine state-of-the-art low-light enhancement methods in terms of speed, accuracy, and adaptability in complex low-light scenarios. These results validate our initial hypothesis and underscore the effectiveness of the proposed approach. © The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature 2023.},
 author = {Yang, Shaoliang and Zhou, Dongming},
 doi = {10.1007/s13042-023-01983-7},
 journal = {International Journal of Machine Learning and Cybernetics},
 note = {Cited by: 6},
 number = {4},
 pages = {1575 - 1589},
 publication_stage = {Final},
 source = {Scopus},
 title = {Efficient low-light image enhancement with model parameters scaled down to 0.02M},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85178191399?origin=resultslist},
 volume = {15},
