 abstract = {To address the performance bottleneck of I/O scheduling in disaster-tolerant storage systems, this paper proposes a specialized I/O scheduling method tailored to the disaster-tolerant scenario. The method establishes two First-In-First-Out (FIFO) queues: a high-priority queue for write requests and a low-priority queue for read requests, ensuring the prioritization of backup data writing. A hybrid scheduling strategy integrating NOOP elevator scheduling and anticipatory I/O scheduling is adopted to merge and sort all read/write requests. Specifically, NOOP elevator scheduling optimizes request ordering to reduce disk seek overhead, while anticipatory I/O scheduling mitigates read/write starvation by leveraging the locality of I/O access and user request patterns. Experimental results show that the proposed method significantly improves I/O throughput compared with traditional scheduling algorithms. Particularly in random data storage scenarios (data continuity rate ≤ 60%), it reduces disk seek overhead by 38.7% on average through optimized request merging and ordering; when the data continuity rate is 70%, it achieves a 25% improvement in storage efficiency compared with the 95% continuity scenario. This method effectively enhances the I/O performance of disaster-tolerant storage systems and provides reliable support for data security and business continuity.  © 2025 Copyright held by the owner/author(s).},
 author = {He, Qian and Wang, Zhichen and Chen, Longliang},
 doi = {10.1145/3788731.3788762},
 journal = {Proceedings of 2025 International Conference on Embodied Intelligence and Large Models, EILM 2025},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {199 - 204},
