@article{IFA2026128853,
 abstract = {Modern microprocessors produce thermal heat fluxes and local hot spots, making thermal management issues more coplicated as the technology advances rapidly. The conventional ways of cooling are getting less effective, which is why the triply periodic minimal surface (TPMS) heat sink is being spotlighted. In this study, gyroid TPMS and diamond TPMS heat sinks are evaluated in a comparative manner using a combination of CFD simulations under a uniform heat flux boundary condition of 120 W/m2. Numerical analysis is used to quantify the performance of thermal and flow properties, such as velocity, pressure, temperature, density, and streamline distributions, for each of the TPMS structures. The results affirm that the temperature performance of gyroid TPMS is generally superior to that of diamond TPMS in terms of thermal performance, pressure drop, and flow characteristics. The gyroid achieved the maximum base temperature drop of 33.15 K (8.3 %), thermal resistance drops of 0.123 K/W (8.21 %) and 7.41 %. Further, less power of pumping (2.44 %) and temperature drop (3 °C) occurred at similar operational conditions. The findings show that TPMS-based cooling architectures offer better performance for next-generation microprocessors. These improvements contribute to improving the overall cooling efficiency of the microprocessor.},
 author = {Dejene Alemayehu Ifa and Dame Alemayehu Efa},
 doi = {https://doi.org/10.1016/j.applthermaleng.2025.128853},
 issn = {1359-4311},
 journal = {Applied Thermal Engineering},
 keyword = {Microprocessor cooling, Diamond heat sink, Gyroid TPMS, Thermal management, High-performance computing, CFD analysis},
 pages = {128853},
 title = {Diamond and gyroid triply periodic minimal surface heat sinks for advanced microprocessor cooling},
 url = {https://www.sciencedirect.com/science/article/pii/S1359431125034453},
 volume = {282},
 year = {2026}
}
