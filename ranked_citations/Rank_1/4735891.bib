@inproceedings{4735891,
 abstract = {In this paper a region based segmentation and image analysis with application to medical images have been done. Image segmentation which is one of the most important steps includes clustering, object detection and boundary detections. For a variety of image analysis and visualization tasks both inside and outside the medical image domain, segmentation of pertinent structures is to utmost importance. Images segmented by region growing methods often contain either too many regions or too few regions as a result of non-optimal parameter setting. To improve the segmentation results, a combination of different approaches is introduced.},
 author = {Ansari, M.A. and Anand, R.S.},
 booktitle = {2007 IET-UK International Conference on Information and Communication Technology in Electrical Sciences (ICTES 2007)},
 doi = {},
 issn = {0537-9989},
 keyword = {Segmentation;Clustering;Region growing;Region based;Image Analysis},
 month = {Dec},
 number = {},
 pages = {724-729},
 title = {Region based segmentation and image analysis with application to medical imaging},
 volume = {},
 year = {2007}
}
