@inproceedings{4608520,
 abstract = {This paper describes the use of timed hierarchical colored Petri nets (timed CPN) in the development, simulation and analysis of flexible manufacturing systems models. The major aim is to propose a systematized hybrid methodology, using refinement and compositions to construct models that represent a real system and conserve some properties of interest. The highest abstraction level of the model is gotten from the layout of real system. Implementation details can be obtained adding predefined subnets into the hierarchical substitution transition. The transformation of a normal Petri Net into a timed CPN uses a combination of folding based in marks, parallel mutual exclusion (PME), sequential mutual exclusion (SME) theories and also a textual structured programming language. The validity of the connection among subnets to obtain the complete model is supported by the Petri net valid extension theory. A systematic exploration of state space simulation is performed to confirm the maintenance of the wished properties such as liveness, boundness, and reversibility. Finally, a performance analysis simulation to obtain the better productivity setup on the system is executed.},
 author = {Aguiar, Marcelo and Barreto, Raimundo and Caldas, Ruiter and Edgar, Joao and Filho, Chaves},
 booktitle = {2008 IEEE International Conference on Industrial Technology},
 doi = {10.1109/ICIT.2008.4608520},
 issn = {},
 keyword = {Analytical models;Adaptation model;Robots;Merging;Maintenance engineering;Color;Complexity theory;Flexible Manufacture System;Colored Petri Net;Hierarchic Petri Net;Methods of composition},
 month = {April},
 number = {},
 pages = {1-6},
 title = {Modeling and analysis of Flexible Manufacture Systems through hierarchical and Colored Petri Nets},
 volume = {},
 year = {2008}
}
