@inproceedings{4443229,
 abstract = {In this paper, we propose and develop a differential equation motivated regression model, abbreviated as DEMR model, which has a random fuzzy error structure for the facilitation of the modeling challenges facing small sample uncertainty, model translation caused misspecification uncertainty, and random sampling uncertainty. Different from common regression models as well as the one-variable first order grey differential equation model, abbreviated as GM(1,1) proposed by Deng (1983), DEMR is established on a rigorous mathematical foundation founded by Liu [4] and expecting to receive a full acceptance in research community.},
 author = {Guo, R. and Guo, D.},
 booktitle = {2007 IEEE International Conference on Grey Systems and Intelligent Services},
 doi = {10.1109/GSIS.2007.4443229},
 issn = {2166-9449},
 keyword = {Uncertainty;Differential equations;Mathematical model;Solid modeling;Intelligent systems;Sampling methods;Merging;History;Statistics;Bayesian methods},
 month = {Nov},
 number = {},
 pages = {13-18},
 title = {Univariate DEMR model — The formation and foundation},
 volume = {},
 year = {2007}
}
