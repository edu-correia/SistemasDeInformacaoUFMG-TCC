@inproceedings{11058519,
 abstract = {In the digital era, safeguarding data during internet-based transmissions is crucial due to rising cyber threats. While cryptography encrypts data, its detectability poses a limitation. Steganography offers an alternative by concealing data within a carrier medium but often struggles with balancing security and image quality. This study proposes an enhanced image steganographic algorithm combining RSA encryption, a 1-bit Least Significant Bit (LSB)-based XOR operation, the YCbCr color space, and Canny edge detection. RSA encrypts the secret data, which is then embedded into optimal image regions identified via Canny edge detection in the YCbCr color space for imperceptibility. The XOR operation enhances security against attacks. Experimental results demonstrate improved image quality with lower Mean Squared Error (MSE) and higher Peak Signal to Noise Ratio (PSNR) compared to existing methods, ensuring robust, secure, and imperceptible data concealment.},
 author = {Alam, Sheikh Thanbir and Hassan, Md Maruf and Bhuiyan, Touhid},
 booktitle = {2025 8th International Conference on Information and Computer Technologies (ICICT)},
 doi = {10.1109/ICICT64582.2025.00079},
 issn = {2769-4542},
 keyword = {Image quality;Steganography;PSNR;Image color analysis;Image edge detection;Heuristic algorithms;Merging;Real-time systems;Encryption;Colored noise;YCbCr;RSA;Image Steganography;SHA3-512;Pixel selection technique;LSB},
 month = {March},
 number = {},
 pages = {467-472},
 title = {An Enhanced Image Steganographic Algorithm Integrating 1-Bit LSB Based XOR Operations in the YCbCr Color Model with Canny Edge Detection},
 volume = {},
 year = {2025}
}
