@article{Hamdi2021271,
 abstract = {Unifying access to data using structured knowledge is the main problem studied in ontology-based data access (OBDA). Data are often provided by several information sources, and this has led to a number of methods that merge them in order to get a unified point of view. Existing merging approaches assume that the content of datasets is known and available. However, in several applications, it might be impossible to know the full content of datasets beforehand. This paper investigates several query answering strategies from multiple datasets without knowing their content in advance. We study those strategies from different points of view: productivity, logical properties and computational complexity. © 2020, Springer Nature Switzerland AG.},
 author = {Hamdi, Ghassen and Omri, Mohamed Nazih and Benferhat, Salem and Bouraoui, Zied and Papini, Odile},
 doi = {10.1007/s10472-020-09714-2},
 journal = {Annals of Mathematics and Artificial Intelligence},
 note = {Cited by: 8},
 number = {3-4},
 pages = {271 - 299},
 publication_stage = {Final},
 source = {Scopus},
 title = {Query answering DL-lite knowledge bases from hidden datasets},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85095426498?origin=resultslist},
 volume = {89},
 year = {2021}
}
