@inproceedings{11389970,
 abstract = {Accurate meteorological forecasting can mitigate the impact of disasters and associated losses, and is of paramount importance for government decisionmaking and public safety. However, conventional methods struggle in regions with high climate variability. To address this issue, this study proposes a hybrid deep learning framework named TTAMLP-Meta(TCNTransformer-STGCN+AttentionMLP+Meta). This method integrates multiple forecasting methodologies to enhance predictive performance. It significantly improves spatio-temporal feature extraction within meteorological environments. By merging spatial feature extraction with long-term temporal modeling capabilities, the framework effectively captures dynamic correlations across multidimensional climate data. The attention mechanism enables the model to concentrate on critical meteorological patterns. Furthermore, a multi-model prediction fusion strategy leverages complementary information among different forecast outputs. This integration significantly enhances prediction accuracy and operational reliability. By combining these approaches, the framework improves both interpretability and performance in complex forecasting tasks. The model was subsequently validated using climate data from Gansu Province, China, a region known for its significant climatic diversity. The results clearly show that the method not only boosts predictive precision in areas with high climate variability but also significantly strengthens the ability to model complex spatio-temporal relationships.},
 author = {Yuan, Xue and Wang, Shu and Han, Lina},
 booktitle = {2025 8th International Conference on Data Science and Information Technology (DSIT)},
 doi = {10.1109/DSIT67006.2025.11389970},
 issn = {},
 keyword = {Deep learning;Accuracy;Climate variability;Weather forecasting;Predictive models;Feature extraction;Data models;Graph neural networks;Reliability;Forecasting;Deep learning;Graph Neural Network;MetaModel;Meteorological prediction},
 month = {Nov},
