@conference{Gai2024130,
 abstract = {This paper reviews the application of deep learning in cell classification detection, highlights the importance of convolutional neural networks in image analysis, and discusses the application of image preprocessing, feature extraction and deep learning models. Despite the progress made by deep learning techniques in improving cell classification accuracy, challenges such as data quality, model generalization and interpretability remain. This article suggests future research directions, including combining medical knowledge with deep learning and developing multimodal learning to improve the accuracy and efficiency of cell detection. Meanwhile, this article also explores the potential of label-free cell classification methods combining optically induced optically-induced dielectrophoresis (ODEP) techniques with deep learning to achieve cell classification without labeling, providing a new perspective on cell analysis. optically induced. © 2024 IEEE.},
 author = {Gai, Dongze and Zhang, Chuang and Zhang, Yiwei and Guo, Jiaduo and Zhang, Qi and Qin, Hengshen and Dang, Dan},
 doi = {10.1109/CYBER63482.2024.10749410},
 journal = {14th IEEE International Conference on Cyber Technology in Automation, Control, and Intelligent Systems, CYBER 2024},
