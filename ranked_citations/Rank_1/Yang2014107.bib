@article{Yang2014107,
 abstract = {The physical-virtual immersion and real-time interaction play an essential role in cultural and language learning. Augmented reality (AR) technology can be used to seamlessly merge virtual objects with real-world images to realize immersions. Additionally, computer vision (CV) technology can recognize free-hand gestures from live images to enable intuitive interactions. Therefore, we incorporate the latest AR and CV algorithms into a Virtual English Classroom, called VECAR, to promote immersive and interactive language learning. By wearing a pair of mobile computing glasses, users can interact with virtual contents in a three-dimensional space by using intuitive free-hand gestures. We design three cultural learning activities that introduce students to authentic cultural products and new cultural practices, and allow them to examine various cultural perspectives. The objectives of the VECAR are to make cultural and language learning appealing, improve cultural learning effectiveness, and enhance interpersonal communication between teachers and students. © 2008-2011 IEEE.},
 author = {Yang, Mau-Tsuen and Liao, Wan-Che},
 doi = {10.1109/TLT.2014.2307297},
 journal = {IEEE Transactions on Learning Technologies},
 note = {Cited by: 81; All Open Access; Bronze Open Access},
 number = {2},
 pages = {107 - 117},
 publication_stage = {Final},
 source = {Scopus},
 title = {Computer-assisted culture learning in an online augmented reality environment based on free-hand gesture interaction},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84901403463?origin=resultslist},
 volume = {7},
 year = {2014}
}
