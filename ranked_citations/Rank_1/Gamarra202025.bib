@article{Gamarra202025,
 abstract = {The advancement in biological and medical image acquisitions has allowed the development of numerous investigations in different fields supported by image analysis, from cell to physiological level. The complexity in the treatment of data, generated by image analysis, requires a structured methodology for software development. In this paper we proposed a framework to develop a software solution with a Service-Oriented Architecture (SOA) applied to the analysis of biological images. The framework is completed with a novel image analysis methodology that would help researchers to achieve better results in their image analysis projects. We evaluate our proposal in a scientific project related to cell image analysis. © 2020, Springer Nature Switzerland AG.},
 author = {Gamarra, Margarita and Zurek, Eduardo and Nieto, Wilson and Jimeno, Miguel and Sierra, Deibys},
 doi = {10.1007/978-3-030-47679-3_3},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {25 - 38},
 publication_stage = {Final},
 source = {Scopus},
 title = {Spiral-Based Model for Software Architecture in Bio-image Analysis: A Case Study in RSV Cell Infection},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85086142377?origin=resultslist},
 volume = {12133 LNCS},
 year = {2020}
}
