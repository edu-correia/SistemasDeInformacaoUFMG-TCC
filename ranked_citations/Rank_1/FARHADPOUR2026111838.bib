@article{FARHADPOUR2026111838,
 abstract = {Developing well-balanced anion exchange membranes (AEMs) is a key direction for advancing AEM fuel cells (AEMFCs). Despite the significant progress in recent years, achieving a balance among the desired AEM properties remains challenging. To address this challenge, this study introduces a novel blending strategy using two ether-free polyarylene-based polymer phases with identical backbones but different ion exchange capacities (IECs) to exploit the double percolation effect. This approach produces AEMs with a highly microphase-separated morphology, achieving an exceptional hydroxide conductivity of 262.9 mS cm⁻¹ at 80 °C (IEC = 2.43 mmol g⁻¹), setting a new benchmark. The optimized blend AEMs exhibit a superior balance of properties compared to their single-phase counterparts, including a tensile strength of 54.2 MPa, a water uptake of 72.2%, and a swelling ratio of 20.7%. Furthermore, blend AEM demonstrates exceptional alkaline and oxidative stability, retaining 90.4–99.6% of its initial hydroxide conductivity and IEC after 1500 h immersion in 1 M and 3 M NaOH at 80 °C. The AEMFC achieves a peak power density of 1.36 W cm⁻² and maintains stable operation at 0.5 A cm⁻² for 150 h, with a voltage decay rate of only 0.26 mV h⁻¹ . This performance surpassed that of the leading commercial PiperION™ AEM under identical testing conditions. This study highlights the significant potential of the blending strategy for developing next-generation high performance AEMs for AEMFCs and other electrochemical applications via the double percolation effect.},
 author = {Mohammad Farhadpour and Zongpei Wu and Qinglan Zhao and Yan Sun and Fei Xiao and Gongjin Chen and Xiaoyi Qiu and Yingdan Cui and Gholamreza Pircheraghi and Reza Bagheri and Shensheng Chen and Minhua Shao},
 doi = {https://doi.org/10.1016/j.nanoen.2026.111838},
 issn = {2211-2855},
 journal = {Nano Energy},
 keyword = {Anion exchange membrane fuel cell, Anion exchange membrane water electrolyzer, Blend membranes, Microphase separated structure, Hydroxide conductivity, Double percolation effect},
 pages = {111838},
 title = {Design of highly microphase separated blend polyarylene-based membranes for anion exchange membrane fuel cells via the double percolation effect},
 url = {https://www.sciencedirect.com/science/article/pii/S2211285526001424},
 volume = {151},
 year = {2026}
}
