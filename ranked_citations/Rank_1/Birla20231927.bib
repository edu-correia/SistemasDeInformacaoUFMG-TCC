@article{Birla20231927,
 abstract = {In the current digital world, face analytic systems become an integral part of daily life. However, today's cutting-edge technology and readily available social media information make these systems vulnerable through face spoofing attacks. These attacks can be mitigated using remote Photoplethysmography (rPPG), which remotely detects cardiovascular signals. Unfortunately, the illumination variation and face deformations can easily corrupt the pulse signals and thereby degrade the performance of rPPG-based anti-spoofing methods, even when longer-duration face videos are employed. This paper proposes a face anti-spoofing method SUNRISE-SUNRISE, that is, Short videos UsiNg pRe-emptIve Split and mErge. It is an rPPG-based face anti-spoofing for short duration videos wherein facial deformations are removed by introducing the split and merge mechanism. It splits the video into several clips, provides low importance to the clips containing facial deformations, and eventually merges the results using quality-based fusion. The efficacy of existing rPPG-based methods is limited because they employed high dimensional features for training using the limited training data. We mitigate this limitation by utilizing the statistical features of clips. The experimental results on publicly available datasets reveal that the proposed method exhibits significantly better performance than the well-known existing methods for a short time duration. © 2004-2012 IEEE.},
 author = {Birla, Lokendra and Gupta, Puneet and Kumar, Shravan},
 doi = {10.1109/TDSC.2022.3168345},
 journal = {IEEE Transactions on Dependable and Secure Computing},
 note = {Cited by: 20},
 number = {3},
 pages = {1927 - 1940},
 publication_stage = {Final},
 source = {Scopus},
 title = {SUNRISE: Improving 3D Mask Face Anti-Spoofing for Short Videos Using Pre-Emptive Split and Merge},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85128617595?origin=resultslist},
 volume = {20},
 year = {2023}
}
