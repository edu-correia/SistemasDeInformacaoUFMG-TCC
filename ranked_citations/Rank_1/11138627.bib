@inproceedings{11138627,
 abstract = {Electrocardiography (ECG) plays a crucial role in assessing heart health and detecting cardiac abnormalities. The development of wearable single-lead ECG devices has transformed long-term remote monitoring, offering unparalleled convenience. However, capturing the dynamic nature of ECG signals, along with local nuances and effective discriminative features, remains a challenge in automatic ECG classification. To address this, we propose MST-BiLSTM, a deep learning model that integrates multi-scale Spatio-Temporal feature fusion with Bi-LSTM. By employing a multi-scale structure and attention mechanism, the model effectively extracts and merges spatiotemporal features from single-lead ECG signals, emphasizing critical distinctions for arrhythmia classification. The model is validated on five heartbeat types using the MIT-BIH Arrhythmia Database, achieving impressive results with an average accuracy of 99.68 %, precision of 99.69 %, sensitivity of 99.67 %, and specificity of 99.68 %. These results highlight MST-BiLSTM's superior capability in capturing local ECG features and generating more discriminative feature representations than traditional methods. The proposed approach offers a robust solution for ECG classification, particularly in conditions of limited data, contributing to improved cardiac health monitoring and management.},
 author = {Ma, Minghao and Wang, Lingling and Zhao, Yanqi and Wang, Lili},
 booktitle = {2025 4th Conference on Fully Actuated System Theory and Applications (FASTA)},
 doi = {10.1109/FASTA65681.2025.11138627},
 issn = {},
 keyword = {Adaptation models;Attention mechanisms;Sensitivity;Heart beat;Arrhythmia;Electrocardiography;Feature extraction;Spatiotemporal phenomena;Remote monitoring;Periodic structures;Arrhythmia Detection;Multi-Scale Feature Extraction;Attention Mechanism;Spatiotemporal Information Fusion},
 month = {July},
 number = {},
 pages = {1398-1403},
 title = {MST-BiLSTM: An Improved Bi-LSTM Method Based on Multi-Scale Spatio-Temporal Feature Fusion and Attention Mechanism for ECG Recognition},
 volume = {},
 year = {2025}
}
