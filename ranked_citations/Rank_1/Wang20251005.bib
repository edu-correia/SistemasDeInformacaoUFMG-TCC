@conference{Wang20251005,
 abstract = {To address the rapid error accumulation of Inertial Navigation Systems (INS) during Global Navigation Satellite System (GNSS) signal outages, this paper proposes an error compensation method of GNSS/INS integrated navigation based on neuron merging mechanism for the dynamic fuzzy neural network (NMM-DFNN). A dynamic feature mapping model is constructed with the INS attitude, velocity, position, and sensor biases as inputs, and the compensation for velocity and position as outputs. During the rule generation phase, new neurons are introduced based on network output errors and the completeness of fuzzy rules. In the rule merging phase, a dual-dimensional similarity evaluation criterion, encompassing both geometric and functional aspects, is used to merge redundant neurons, thereby optimizing the network complexity. Simulation experiments show that in the scenario of short term GNSS signal interruption, this method effectively improves the positioning accuracy compared with pure inertial navigation and traditional dynamic fuzzy neural networks. Moreover, the number of fuzzy rules is effectively controlled, reducing the network complexity. © 2025 IEEE.},
 author = {Wang, Junwei and Liu, Zhilin and Huang, Haoqian and Wang, Di and Liu, Fengyu and Deng, Jiuqiang},
 doi = {10.1109/ICUS66297.2025.11295344},
 journal = {Proceedings of 2025 IEEE International Conference on Unmanned Systems, ICUS 2025},
 note = {Cited by: 0},
 pages = {1005 - 1010},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Error Compensation Method Based on Neuron Merging Mechanism for Dynamic Fuzzy Neural Network in GNSS/INS Integrated Navigation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105031890009?origin=resultslist},
 year = {2025}
}
