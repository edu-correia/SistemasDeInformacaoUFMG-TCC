@article{LIN20244502,
 abstract = {Achieving high shock tolerance in structural materials is a complex topic. It requires a balance between dynamic strength and toughness, but these properties are challenging to attain simultaneously. We have examined dynamic responses of typical composite structures by merging MD and DFT simulations. The composite structure featuring SiC nanowires bridging multiple grains exhibits exceptional shock tolerance, when compared to both the matrix material (polycrystalline Al) and other composite structures with isolated intergranular or intragranular SiC nanoparticles. Our research has revealed that the structural configuration is responsible for the exceptional shock tolerance through facilitating amorphization and the significant suppression of void dynamics evolution. Nanocomposite materials, characterized by bridged and specific orientation interfaces, offer a solution to this inherent trade-off. The approach demonstrated promising generalization ability and holds enormous potential for extension to alloys field.},
 author = {Kuixin Lin and Hongmei Chen and Yulu Zhou and Xiaoma Tao and Yifang Ouyang and Yong Du},
 doi = {https://doi.org/10.1016/j.ceramint.2023.11.184},
 issn = {0272-8842},
 journal = {Ceramics International},
 keyword = {Nanocomposites, Shock tolerance, Interfacial modulation, Plastic deformation, Void dynamics},
 number = {3, Part A},
 pages = {4502-4512},
 title = {Design strategies towards the optimal shock-tolerance of nanocrystalline Al matrix composite},
 url = {https://www.sciencedirect.com/science/article/pii/S0272884223036428},
 volume = {50},
 year = {2024}
}
