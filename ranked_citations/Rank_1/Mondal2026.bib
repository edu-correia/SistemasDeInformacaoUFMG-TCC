@article{Mondal2026,
 abstract = {Traditional denoising autoencoders (DAEs) are less optimal for learning discriminative features because class label information is not involved with training, affecting generalization in classification. This study proposes regularizing DAEs to improve discrimination capability by minimizing intra-class and/or maximizing inter-class differences. Thus, we proposed three DAEs: (i) DAE on minimization of distribution differences between the estimated input of the DAE and its class mean, (ii) DAE on maximization of distribution differences between the estimated input of DAE and class means of different classes, and (iii) DAE on both minimization and maximization of the differences as mentioned in the above DAEs. To measure these differences we used Kullback-Leibler Divergence (KLD). However, KLD between two probability distribution functions, P<sub>1</sub> and P<sub>2</sub> is asymmetric, i.e., KLD(P<sub>1</sub>||P<sub>2</sub>)≠KLD(P<sub>2</sub>||P<sub>1</sub>). KLD between P<sub>1</sub> and P<sub>2</sub> will incorporate the influence of either KLD(P<sub>1</sub>||P<sub>2</sub>) or KLD(P<sub>2</sub>||P<sub>1</sub>). To learn comprehensive class information, we used symmetric KLD (SKLD) as a regularizer to the proposed DAEs, where KLD(P<sub>1</sub>||P<sub>2</sub>)=KLD(P<sub>2</sub>||P<sub>1</sub>). Experimental results support effectiveness of the proposed DAEs. Practically, proposed DAEs have significant impact to improving generalization in various applications where data sets contain complex overlapping regions of multiple classes. © 2026 Elsevier Inc.},
 author = {Mondal, Rahul and Dey, Prasenjit and Pal, Tandra},
 doi = {10.1016/j.ins.2026.123321},
 journal = {Information Sciences},
