@conference{Xu2013685,
 abstract = {Constructing large-scale ontology in clinic domain needs collaboration of multidisciplinary experts. Problems of lacking coherence among experts hinder the wide use of ontology in sharing the electronic medical records generated by different hospital information systems. In this paper, an ontology construction method is proposed from the viewpoints of both top-down and bottom-up. Ontology segments are firstly extracted bottom-up from the database schema of operational clinical information systems. Then, experts from different disciplines work together to merge the ontology segments top-down, and to build a global ontology system. Finally, this approach is demonstrated in a clinic data analysis project. The result shows that the method is efficient in ontology engineering. © 2013 IEEE.},
 author = {Xu, Boyi and Cai, Hongming and Jiang, Lihong},
 doi = {10.1109/FSKD.2013.6816283},
 journal = {Proceedings - 2013 10th International Conference on Fuzzy Systems and Knowledge Discovery, FSKD 2013},
 note = {Cited by: 3},
 pages = {685 - 689},
 publication_stage = {Final},
 source = {Scopus},
 title = {A clinic ontology construction method in distributed hospital information systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84901935687?origin=resultslist},
 year = {2013}
}
