@article{Zhang2020999,
 abstract = {With the rapid development of the Internet of Things technology, the application area of the Internet of Things has become more and more broad, including in the fields of intelligent transportation, logistics, industry, finance, medicine and so on. The Internet of Things has the characteristics of rich connotation and various information channels. In this regard, the construction and development of the Internet of Things will lead to a new integration of logistics industry informatization. Cycle, the current logistics industry informatization is entering the information and resources integration period, after a period of basic research and construction will enter a new stage of logistics industry integration based on the Internet of Things as the goal. At this stage, the application of the Internet of Things will merge into a system with the logistics industry in order to pursue the overall effect and improve the efficiency of resource utilization. In this paper, the application of computer Internet of Things technology in logistics field is briefly explored and analyzed. In view of the current situation and existing problems of the application of computer Internet of Things technology in logistics field, some corresponding measures and suggestions are put forward to make the logistics work more comprehensive and efficient. © 2020, Springer Nature Singapore Pte Ltd.},
 author = {Zhang, Guibin and Feng, Lifan and Zhang, Hongzhen and Cai, Xiaohua},
