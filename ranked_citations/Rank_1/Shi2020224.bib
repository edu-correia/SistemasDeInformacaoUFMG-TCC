@conference{Shi2020224,
 abstract = {This paper describes are system submitted to HASOC2020: Hate speech and offensive content recognition. The purpose of the task is to discrimination offensive language in social media. We participated in a subtask A and B of English and German. The subtasks A are to identify hate speech, The subtasks B are to identify hate speech,offensive speech and profane speech, offensive blasphemy from a fine-grained perspective. To accomplish these subtasks, we proposed a system based on Multi-Topk Self-Attention and K-Max pooling model and used k-fold method for training fitting. We get the macro F1-score of our model is 0.5042 of subtask A in English, 0.2396 of subtask B in English.0.5121 of subtask A in German,0.2736 of subtask B in German. © 2020 Copyright for this paper by its authors.},
 author = {Shi, Huiping and Zhou, Xiaobing},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 1},
 pages = {224 - 231},
 publication_stage = {Final},
 source = {Scopus},
 title = {Huiping Shi@HASOC 2020: Multi-topk self-attention with K-Max pooling for discrimination between hate, profane and offensive posts},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85102929881?origin=resultslist},
 volume = {2826},
 year = {2020}
}
