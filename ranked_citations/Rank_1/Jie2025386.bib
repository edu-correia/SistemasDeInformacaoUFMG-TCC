@conference{Jie2025386,
 abstract = {As smart grids undergo profound evolution towards digitalisation and intelligentisation, the real-time and accurate monitoring and assessment of operational status at smart substations - the core hubs of the grid - become pivotal to ensuring grid security and stability. Traditional monitoring methods suffer from data silos, disconnect between physical and virtual domains, and delayed evaluation, rendering them inadequate for complex operational scenarios. This paper proposes a digital twin-based monitoring and evaluation scheme for smart substation operational status. Firstly, a four-layer architecture system is established, encompassing the physical entity layer, data interaction layer, virtual twin layer, and service application layer, achieving precise mapping across multiple physical domains and dimensions within the substation. Secondly, a multi-source data fusion monitoring mechanism is designed, leveraging edge computing and cloud-based collaborative processing of heterogeneous data - including electrical, mechanical, and environmental - to enhance monitoring timeliness. Finally, a three-tier assessment model - comprising an indicator system, weight allocation, and comprehensive evaluation - is established. Integrating the Analytic Hierarchy Process (AHP) with fuzzy comprehensive evaluation enables quantitative grading of substation operational status. Using a 220kV smart substation as the experimental subject, a digital twin simulation platform was constructed. Through normal operating condition and fault simulation experiments, the system demonstrated: 98.7% accuracy in monitoring data, 96.3% consistency between state assessments and actual operating conditions. This effectively enhances substation operation and maintenance efficiency alongside fault early warning capabilities, providing technical support for the full lifecycle management of smart substations. © 2025 IEEE.},
 author = {Jie, Dong and Yaoting, Xu and Xiaoxiao, Zhu and Chenxin, Zhu},
 doi = {10.1109/AUTEEE67053.2025.11321936},
 journal = {2025 IEEE 8th International Conference on Automation, Electronics and Electrical Engineering, AUTEEE 2025},
