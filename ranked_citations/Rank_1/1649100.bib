@inproceedings{1649100,
 abstract = {For some applications in communications, it is desirable to provide unequal error protection for different types of information data. In image coding, e.g., types of bits exist which have to be protected with different protection levels when transmitting these data over noisy channels. In this paper, we concentrate on turbo codes C. Berrou et al., 1993) with unequal error protection capabilities which are achieved by modifying the code rate R = k/n. After pointing out that puncturing and path pruning are modifications of the rate in the denominator and numerator, respectively, the latter is studied in more detail. Design rules are given and EXIT charts for performance analysis of turbo codes with path-pruned convolutional component codes are presented},
 author = {Henkel, W. and von Deetzen, N.},
 booktitle = {2006 International Zurich Seminar on Communications},
 doi = {10.1109/IZS.2006.1649100},
 issn = {},
 keyword = {Error correction codes;Turbo codes;Convolutional codes;Polynomials;Protection;Modulation coding;Image coding;Noise level;Performance analysis;Merging},
 month = {Feb},
 number = {},
 pages = {142-145},
 title = {Path Pruning for Unequal Error Protection Turbo Codes},
 volume = {},
 year = {2006}
}
