@article{ZALEWSKI2025S75,
 abstract = {Our project aims to significantly enhance the registration of chemical safety data (a critical requirement at several of Bayer's divisions) by merging the immense capabilities of Large Language Models with tools and standards provided by regulatory agencies. We aim to enable automated data extraction from complex internal toxicology report documents followed by formatting these into the IUCLID standard required by the European Chemicals Agency (ECHA). The resulting solution will reduce the workload required from our expert toxicologists (by hours or days for each registration) and provide further benefits: • Rapid and harmonized processing of heterogenous, unstructured toxicological data • Increased accuracy and minimized human error during data integration • Streamlined compliance with stringent ECHA guidelines • Shared, maintainable solution for two business divisions As we progress, we tackle some remaining challenges: 1) ensuring that AI-generated entries meet rigorous regulatory standards, 2) effective handling of varied data sources from each division (including complex endpoints and simple toxicity tests alike), and 3) providing an easy-touse interactive workflow for our regulatory submission experts.},
 author = {A. Zalewski},
 doi = {https://doi.org/10.1016/j.toxlet.2025.07.206},
 issn = {0378-4274},
 journal = {Toxicology Letters},
 note = {Abstracts of the 59th Congress of the European Societies of Toxicology (EUROTOX 2025) TOXICOLOGY ADDRESSES SOCIETY'S REAL LIFE RISKS FOR SUSTAINABLE HEALTH AND WELL BEING},
 pages = {S75},
 title = {P03-11 Enhancing and streamlining IUCLID submission through large language model-based assistants},
 url = {https://www.sciencedirect.com/science/article/pii/S0378427425017898},
 volume = {411},
 year = {2025}
}
