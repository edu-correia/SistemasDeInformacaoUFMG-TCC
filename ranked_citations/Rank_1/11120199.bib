@inproceedings{11120199,
 abstract = {This study investigates the enhancement of stock market prediction accuracy by integrating market news sentiment with historical stock price data using advanced machine learning models. Traditional prediction methods primarily rely on historical price data, often neglecting the influence of real-time news events on market behavior. By using the benefits of both Long Short-Term Memory (LSTM) networks and Bidirectional Encoder Representations from Transformers (BERT), hybrid model aims to close this gap. The LSTM component finds temporal connections in stock price data, whereas BERT measures the impact of news item sentiment analysis on stock prices. A dataset of stock prices and related news stories is utilized to test the model, and performance measurements including Mean Absolute Error (MAE) and R-squared (R2) are employed. Results demonstrate that the integrated model significantly outperforms traditional methods, particularly in scenarios where market volatility is driven by news events. This study demonstrates the potential for enhancing the precision of stock market forecasts by merging various data sources, particularly historical price data and real-time news sentiment. The insights this provides can be of great use to automated trading systems, advisors, and investors.},
 author = {Sharma, Amit and Kumar, Sunil and Shyamsunder, Chitta and Devender, B. and Nishok, V.S. and Sidhu, Kawerinder Singh},
 booktitle = {2024 IEEE 9th International Conference on Engineering Technologies and Applied Sciences (ICETAS)},
 doi = {10.1109/ICETAS62372.2024.11120199},
 issn = {2769-4518},
 keyword = {Sentiment analysis;Analytical models;Machine learning;Bidirectional control;Predictive models;Real-time systems;Data models;Encoding;Stock markets;Long short term memory;Stock Market Prediction;Machine Learning Models;Sentiment Analysis;Financial Data Integration;Market News Analysis;Time-Series Forecasting},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Optimizing Stock Market Prediction Through Integration of Market News and Stock Prices with Machine Learning Models},
