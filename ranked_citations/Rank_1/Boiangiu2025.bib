@article{Boiangiu2025,
 abstract = {This paper introduces a new memory-efficient algorithm for connected-components labeling in binary images, which is based on run-length encoding. Unlike conventional pixel-based methods that scan and label individual pixels using global buffers or disjoint-set structures, our approach encodes rows as linked segments and merges them using a union-by-size strategy. We accelerate run detection by using a precomputed 16-bit cache of binary patterns, allowing for fast decoding without relying on bitwise CPU instructions. When compared against other run-length encoded algorithms, such as the Scan-Based Labeling Algorithm or Run-Based Two-Scan, our method achieves up to 35% faster on most real-world datasets. While other binary-optimized algorithms, such as Bit-Run Two-Scan and Bit-Merge Run Scan, are up to 45% faster than our algorithm, they require much higher memory usage. Compared to them, our method tends to reduce memory consumption on some large document datasets by up to 80%. © 2025 by the authors.},
 author = {Boiangiu, Costin-Anton and Vlăsceanu, Giorgiana-Violeta and Stăniloiu, Constantin-Eduard and Tarbă, Nicolae and Voncilă, Mihai-Lucian},
 doi = {10.3390/a18060344},
 journal = {Algorithms},
 note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access},
 number = {6},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Novel Connected-Components Algorithm for 2D Binarized Images},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105009093970?origin=resultslist},
