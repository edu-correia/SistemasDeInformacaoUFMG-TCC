@inproceedings{10388691,
 abstract = {A dual-stage ECG classifier is proposed for wearable healthcare systems based on a deep convolutional neural network. The dual-stage structure efficiently allocates resources by activating the entire structure only when abnormal beats are detected. Power consumption is reduced by converting multiplication operations into additions using binary weights and coefficient merging techniques. Experimental results on the MITBIH database demonstrate an overall accuracy of 97.94%. FPGA implementation achieves a dynamic power consumption of 41.05μW at 500kHz frequency. This approach advances wearable healthcare systems, enabling real-time arrhythmia detection and monitoring on edge devices, improving patient care.},
 author = {Makhlooghpour, Aliasghar and Ahmadi, Arash},
 booktitle = {2023 IEEE Biomedical Circuits and Systems Conference (BioCAS)},
 doi = {10.1109/BioCAS58349.2023.10388691},
 issn = {2766-4465},
 keyword = {Power demand;Arrhythmia;Biological system modeling;Wearable computers;Merging;Medical services;Electrocardiography;ECG Classification;IOT;Hardware Implementation;Deep Learning;Heart Arrhythmia},
 month = {Oct},
 number = {},
 pages = {1-5},
 title = {A Dual Stage Resource Efficient ECG Classifier},
 volume = {},
 year = {2023}
}
