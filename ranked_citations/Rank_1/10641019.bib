@inproceedings{10641019,
 abstract = {This paper presents the preliminary results of the study of unstable slopes along the reservoir rim of Koldam in Himachal Pradesh using UAV survey. The research aims to evaluate the effectiveness of a UAV equipped with RGB sensor in mapping and monitoring landslides along reservoir rims. Survey was carried out using micro category grade Rhyno UAV at upstream and downstream locations of Koldam to understand the possibility of UAV technology to map and assess the volume change and surface modifications. Aerial photos were merged and processed using Structure-from-Motion software. The obtained data enabled precise reconstruction and mapping of the identified landslides. Then analyzing the generated different temporal DEMs can be used for determining the change in volume of mass involved.},
 author = {K, Balasankar and Kundal, Sahil and Bhardwaj, Alok},
 booktitle = {IGARSS 2024 - 2024 IEEE International Geoscience and Remote Sensing Symposium},
 doi = {10.1109/IGARSS53475.2024.10641019},
 issn = {2153-7003},
 keyword = {Surveys;Landslides;Surface reconstruction;Geoscience and remote sensing;Autonomous aerial vehicles;Reservoirs;Terrain factors;Landslide;digital elevation model (DEM);photogrammetry;UAV},
 month = {July},
 number = {},
 pages = {3036-3039},
 title = {Monitoring the Unstable Slopes along the Reservoir Rim of Koldam in Himachal Pradesh Using UAV Survey},
 volume = {},
 year = {2024}
}
