@inproceedings{4145705,
 abstract = {A new VLC-based algorithm for video decoding system is introduced. This self-grouping algorithm is developed to reduce bit streams needed to decode symbol data. In addition the proposal can be merged with all Huffman table-based VLC systems, such as MPEG-2, H.264, for multi-mode video decoding applications. Simulation results show about 73% in Huffman-based table size can be reduced compared to the state-of-the-art design (Shieh et al., 2001)},
 author = {Sun, Shao-Ming and Liu, Tsu-Ming and Lee, Chen-Yi},
 booktitle = {APCCAS 2006 - 2006 IEEE Asia Pacific Conference on Circuits and Systems},
 doi = {10.1109/APCCAS.2006.342543},
 issn = {},
 keyword = {Decoding;Clustering algorithms;Transform coding;Encoding;Code standards;Streaming media;Proposals;Sun;Video coding;Image coding;VLC;Huffman tree;H.264;MPEG-2},
 month = {Dec},
 number = {},
 pages = {1567-1570},
 title = {A Self-Grouping and Table-Merging Algorithm for VLC-Based Video Decoding System},
 volume = {},
 year = {2006}
}
