@conference{Mubeena2024,
 abstract = {In recent years, blockchain networks have expanded their relevance beyond cryptocurrency applications. The integration of blockchain and the Internet of Things (IoT) has gained considerable attention. This merge leverages blockchain's features, such as decentralization, immutability, and traceability to bolster IoT system security, introducing the concept of 'BIo'T.' This paper offers an updated review of blockchain technology's recent advancements and its wide-ranging applications. It starts with a primer on blockchain and IoT, highlighting their real-world implementations. The paper also explores ongoing work within data security, with a focus on healthcare systems where blockchain plays a vital role. The critical assessment of the current state of blockchain technology is made by emphasizing its computational speed, which is particularly pertinent in healthcare applications, where efficiency is crucial. In conclusion, the paper not only summarizes the current landscape but also identifies research challenges and future directions to encourage further exploration in this promising field.  © 2024 IEEE.},
 author = {Mubeena, S. and Jawahar, P.K.},
 doi = {10.1109/ic-ETITE58242.2024.10493232},
 journal = {2nd International Conference on Emerging Trends in Information Technology and Engineering, ic-ETITE 2024},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Analyzing Computational Performance of Blockchain and Internet of Things in Healthcare},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85192565483?origin=resultslist},
 year = {2024}
