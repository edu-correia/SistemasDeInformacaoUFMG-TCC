@article{Zhang20251411,
 abstract = {Vehicle re-identification aims to search for target vehicles from a large-scale vehicle gallery accurately, which tend to exhibit more remarkable visual similarity and more minor discrepancies. To address the challenges of vehicle re-identification, we propose a multi-stage feature complementation and dual-branch differential attention-based method. Firstly, we propose a differential attention module to suppress the interference caused by the surrounding environment, which consists of differential spatial attention (DSA) and differential channel attention (DCA). Then, we obtain two outputs through a dual-branch network structure, where the difference between them is used as a noise suppression factor. Finally, we merge different network stage features to complement the final embedded features and use graph convolutional networks to embed heterogeneous features into a uniform high-dimensional space. The experimental evaluations exhibit that the proposed model outper-forms state-of-the-art methods on the VeRi-776 and VehicleID datasets. © 2025, Institute of Information Science. All rights reserved.},
 author = {Zhang, Xu and Zhang, Chenchen and Yan, Liang},
 doi = {10.6688/JISE.202511_41(6).0003},
 journal = {Journal of Information Science and Engineering},
 note = {Cited by: 0},
 number = {6},
 pages = {1411 - 1422},
 publication_stage = {Final},
 source = {Scopus},
 title = {Dual-Branch Differential Attention with Multi-Stage Feature Complementarity for Vehicle Re-Identification},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105024219674?origin=resultslist},
 volume = {41},
 year = {2025}
}
