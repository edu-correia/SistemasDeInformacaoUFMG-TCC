@conference{McNaughton20114889,
 abstract = {We present a motion planner for autonomous highway driving that adapts the state lattice framework pioneered for planetary rover navigation to the structured environment of public roadways. The main contribution of this paper is a search space representation that allows the search algorithm to systematically and efficiently explore both spatial and temporal dimensions in real time. This allows the low-level trajectory planner to assume greater responsibility in planning to follow a leading vehicle, perform lane changes, and merge between other vehicles. We show that our algorithm can readily be accelerated on a GPU, and demonstrate it on an autonomous passenger vehicle. © 2011 IEEE.},
 author = {McNaughton, Matthew and Urmson, Chris and Dolan, John M. and Lee, Jin-Woo},
 doi = {10.1109/ICRA.2011.5980223},
 journal = {Proceedings - IEEE International Conference on Robotics and Automation},
 note = {Cited by: 371},
 pages = {4889 - 4895},
 publication_stage = {Final},
 source = {Scopus},
 title = {Motion planning for autonomous driving with a conformal spatiotemporal lattice},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84864458598?origin=resultslist},
 year = {2011}
}
