@article{WANG2026121435,
 abstract = {The treatment of food waste wastewater (FWW), characterized by high salinity and lipid content, poses a significant challenge for conventional biological processes. This study presents a novel, circular solution by upcycling FWW into a high-value liquid organic fertilizer via a customized lactic acid bacteria (LAB) consortium. Through a semi-continuous fermentation process employing energy-saving pasteurization and a 1/2 replacement ratio, we achieved efficient wastewater stabilization and resource recovery. The optimized process attained rapid acidification (pH 3.8 within 72 h), a 46.9 % reduction in total solids, and a high concentration of total organic acids (25.2 g/L, of which 16.9 g/L was lactic acid). Scale-up operations maintained excellent stability over 22 days, with consistent pH (3.8–3.9), high viable cell counts (∼1010 CFU/mL), and stable metabolic activity. Crucially, the 200-fold diluted broth eliminated phytotoxicity and acted as an effective biostimulant, significantly enhancing pak choi germination (142.1 % Germination Index) and shoot biomass (64.2 % increase). Rhizosphere microbiome analysis revealed distinct shifts in community structure, suggesting that the observed growth promotion may involve a synergistic "Nutrient-Microbe" interaction that merges direct nutrition with beneficial microbial reshaping. Our work provides a practical, low-carbon, and circular technological pathway for food waste management, effectively bridging the gap between waste treatment and sustainable agriculture.},
 author = {Weiwei Wang and Yuehua Kang and Jingxuan Jia and Jing Yan and Yuchen Yan and Huiban He and Haoxing He and Peng Zhang and Hongliang Wang and Boting Wen and Zongjun Cui and Xufeng Yuan},
 doi = {https://doi.org/10.1016/j.jece.2026.121435},
 issn = {2213-3437},
 journal = {Journal of Environmental Chemical Engineering},
 keyword = {Food waste wastewater, Lactic acid bacteria, Semi-continuous fermentation, Liquid organic fertilizer, Plant growth promotion},
 number = {2},
 pages = {121435},
 title = {Semi-continuous fermentation of food waste wastewater into liquid organic fertilizer using an adapted lactic acid bacteria consortium under pasteurization},
 url = {https://www.sciencedirect.com/science/article/pii/S2213343726004094},
 volume = {14},
 year = {2026}
}
