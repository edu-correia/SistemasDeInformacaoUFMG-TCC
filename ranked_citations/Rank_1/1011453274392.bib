@article{10.1145/3274392,
 abstract = {Offshore oil exploration is concerned with subsea geological reservoirs that are numerous kilometers below the seabed. These reservoirs are knowable only through a knowledge infrastructure of interconnected technologies that are applied to diverse instrument-generated data. Noise, holes, and inaccuracies are inherent in the data, which depend on the technology producing it. We conducted an interpretative case study of data handling work in the exploration unit of a European oil company. Our findings show how data handling involves the skills needed for managing data identities and ownership, a variety of technologies, and contingent negotiations of data needs. We use the notion of repair to analyze this data handling work and discuss how the concept of repair in data handling involves keeping the knowledge infrastructure navigable and attending to countless details. Our research contributes to the literature on repairing infrastructures by considering how repair relates to data work.},
 address = {New York, NY, USA},
 articleno = {123},
 author = {Mikalsen, Marius and Monteiro, Eric},
 doi = {10.1145/3274392},
 issue_date = {November 2018},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {data handling, empirical case study, knowledge infrastructure, repair},
 month = {November},
 number = {CSCW},
 numpages = {16},
 publisher = {Association for Computing Machinery},
 title = {Data Handling in Knowledge Infrastructures: A Case Study from Oil Exploration},
 url = {https://doi.org/10.1145/3274392},
 volume = {2},
 year = {2018}
}
