@article{Zheng2025,
 abstract = {Pneumonia recognition from chest X-ray (CXR) images is a crucial yet challenging task in medical imaging, requiring models that are both accurate and interpretable to support clinical decision-making. Conventional approaches predominantly rely on visual feature extraction, which often struggles to generalize effectively across diverse cases due to limited contextual information and inherent modality-specific biases. To address this challenge, we propose a straightforward yet effective framework, called multimodal-enhanced representation and guided ensemble (MERGE), which enhances recognition performance by seamlessly integrating visual and textual modalities. MERGE employs a multimodal feature encoding strategy where textual prompts complement visual features, enabling the model to bridge the semantic gap between modalities and capture richer contextual semantics. The guided ensemble mechanism combines the strengths of both modalities, leveraging their complementary nature to enhance robustness and interpretability. This design ensures the framework can effectively capture subtle pathological patterns while refining predictions through auxiliary information. Extensive experiments conducted on benchmark CXR datasets demonstrate that our approach significantly outperforms existing methods, achieving superior classification accuracy and robust generalization across diverse cases. The proposed MERGE framework represents a significant advancement in improving both the accuracy and interpretability of pneumonia diagnosis in medical imaging, achieving an accuracy of 94.23% for binary classification and 96.20% for three-class classification. Our code is publicly available at: https://github.com/zjzheng/MERGE. © The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2025.},
 author = {Zheng, Zijun and Wu, Heng and Lv, Laishui and Bardou, Dalal and Niu, Shanzhou and Yu, Gaohang},
 doi = {10.1007/s11227-025-07409-1},
 journal = {Journal of Supercomputing},
 note = {Cited by: 7},
 number = {8},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {MERGE: multimodal-enhanced representation and guided ensemble for pneumonia recognition in chest X-ray images},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105006762400?origin=resultslist},
 volume = {81},
