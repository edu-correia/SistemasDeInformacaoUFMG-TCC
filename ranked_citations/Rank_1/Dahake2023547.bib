@conference{Dahake2023547,
 abstract = {Business leaders, marketers use business news to inform their day-to-day decision-making processes. This includes creating a business strategy, determining advertising tactics, planning operations, and investing in workforce development. Business news provides a global perspective on current business trends and developments, including tracking mergers and acquisitions and keeping a stakeholders informed. Keeping up with commercial ventures is crucial in today's fast-paced business world. However, with the abundance of news websites available, it can be a daunting task to sort through the substantial volume of information. This research aims to find new ways to gather relevant news articles by embedding them into vectors through the use of in-depth research methods. The study employs unsupervised learning techniques to form clusters of these embedded vectors, with the goal of developing innovative methods for aggregating relevant news pieces. In the study, related news stories are grouped using clustering algorithms including K-means and agglomerative algorithms, as well as a variety of embedding techniques like Bag-Of-Words, TFIDF, Word2vec, and BERT. © 2023 IEEE.},
 author = {Dahake, Gaurav V. and Ali, Mir Sadiq.},
 doi = {10.1109/ICAST59062.2023.10454905},
 journal = {2023 6th IEEE International Conference on Advances in Science and Technology, ICAST 2023},
 note = {Cited by: 0},
 pages = {547 - 551},
 publication_stage = {Final},
 source = {Scopus},
 title = {Developing Unsupervised Learning Techniques for Business News Articles},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85187802598?origin=resultslist},
 year = {2023}
}
