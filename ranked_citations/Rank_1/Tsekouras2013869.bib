@article{Tsekouras2013869,
 abstract = {This article presents a novel crawling and clustering method for extracting and processing cultural data from the web in a fully automated fashion. Our architecture relies upon a focused web crawler to download web documents relevant to culture. The focused crawler is a web crawler that searches and processes only those web pages that are relevant to a particular topic. After downloading the pages, we extract from each document a number of words for each thematic cultural area, ltering the documents with non-cultural content; we then create multidimensional document vectors comprising the most frequent cultural term occurrences. We calculate the dissimilarity between the cultural-related document vectors and for each cultural theme, we use cluster analysis to partition the documents into a number of clusters. Our approach is validated via a proof-of-concept application which analyzes hundreds of web pages spanning diffierent cultural thematic areas. © World Scientific Publishing Company.},
 author = {Tsekouras, George E and Gavalas, Damianos},
 doi = {10.1142/S021819401350023X},
 journal = {International Journal of Software Engineering and Knowledge Engineering},
 note = {Cited by: 5},
 number = {6},
 pages = {869 - 886},
 publication_stage = {Final},
 source = {Scopus},
 title = {An effective fuzzy clustering algorithm for web document classification: A case study in cultural content mining},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84887105436?origin=resultslist},
 volume = {23},
 year = {2013}
}
