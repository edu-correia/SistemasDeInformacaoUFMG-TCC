@article{10.1145/3774425,
 abstract = {Photo-realistic rendering in XR applications using algorithms such as 3D Gaussian Splatting has been a bottleneck for real-time performance. GPUs do not provide efficient rendering, and most dedicated accelerators focus on single-object rendering, while nearly all XR scenarios involve multiple objects.We introduce ScaleGS, an algorithm-architecture co-design system designed to close the gap between real-time 3D Gaussian Splatting to real-time XR rendering. Specifically, we focus on multi-object rendering, structuring the XR rendering pipeline from an object-centric perspective and distinguishing static objects from moving ones to reduce unnecessary computations. Importantly, we identify multiple levels of parallelism across different objects and stages within the rendering pipeline, as well as high data reuse between objects within the render stage. Leveraging these insights, our acceleration framework comprises a runtime system, a micro-instruction scheduler, and a hardware accelerator. Extensive evaluations demonstrate that ScaleGS achieves comparable rendering quality to state-of-the-art dedicated 3D Gaussian Splatting accelerators, while improving throughput by 1.35\texttimes{} -2.14\texttimes{} compared with state-of-the-art rendering accelerators.1},
 address = {New York, NY, USA},
 articleno = {150},
 author = {Chang, Kaiyan and Gan, Yiming and Zhu, Wenlong and Wang, Kun and Chen, Zhirong and Cheng, Yuan and Han, Yinhe and Li, Huawei and Wang, Ying},
 doi = {10.1145/3774425},
 issn = {1544-3566},
 issue_date = {December 2025},
 journal = {ACM Trans. Archit. Code Optim.},
 keyword = {VR/AR, accelerator, hardware},
 month = {December},
 number = {4},
 numpages = {26},
 publisher = {Association for Computing Machinery},
 title = {ScaleGS: Closing the Gap between Real-time 3D Gaussian Splatting and Real-time XR Rendering},
