@conference{Verma2024,
 abstract = {In recent years, there has been a practical improvement in Computer vision technology because of its strength in the application in the agriculture industry. The computer vision techniques are used in agricultural processes to make agriculture more efficient with the perspective to its applications in real-time for many agricultural tasks. In order to study the research and innovation in the field of automation techniques to enhance agricultural practices worldwide, this research aims to provide the Scientometric analysis in terms of both numerically and qualitatively using research publication and citations ranging from 1991 to 2023 from SCOPUS database. The rate of publications and citations, the publication efficiency index, the distribution of publications and citations by domain, the specialization index, the distribution of high frequency keywords, and the identification of highly cited publications and journals are some of the criteria that have been looked at.  © 2024 IEEE.},
 author = {Verma, Amit and Kakkar, Preetish},
 doi = {10.1109/DELCON64804.2024.10866621},
 journal = {Proceedings of the 2024 3rd Edition of IEEE Delhi Section Flagship Conference, DELCON 2024},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Emerging Global Trends in Crop Management using Computer Vision Techniques Research: A Scientometric Analysis of SCOPUS Journals},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85219296729?origin=resultslist},
 year = {2024}
}
