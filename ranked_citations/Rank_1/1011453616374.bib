@article{10.1145/3616374,
 abstract = {In Mobile Edge Computing, edge servers have limited storage and computing resources that can only support a small number of functions. Meanwhile, mobile applications are becoming more complex, consisting of multiple dependent tasks, modeled as a Directed Acyclic Graph (DAG). When a request arrives, typically in an online manner with a deadline specified, we need to configure the servers and assign the dependent tasks for efficient processing. This work jointly considers the problem of dependent task placement and scheduling with on-demand function configuration on edge servers, aiming to meet as many deadlines as possible. For a single request, when the configuration on each edge server is fixed, we derive FixDoc to find the optimal task placement and scheduling. When the on-demand function configuration is allowed, we propose GenDoc, a novel approximation algorithm, and analyze its additive error from the optimal theoretically. For multiple requests, we derive OnDoc, an online algorithm easy to deploy in practice. Our extensive experiments show that GenDoc &nbsp;outperforms state-of-the-art baselines in processing 86.14% of these unique applications, and reduces their average completion time by at least 24%. The number of deadlines that OnDoc can satisfy is at least 1.9\texttimes{} that of the baselines.},
 address = {New York, NY, USA},
 articleno = {12},
 author = {Li, Guopeng and Tan, Haisheng and Liu, Liuyan and Zhou, Hao and Jiang, Shaofeng H.-C. and Han, Zhenhua and Li, Xiang-Yang and Chen, Guoliang},
 doi = {10.1145/3616374},
 issn = {1550-4859},
 issue_date = {January 2024},
 journal = {ACM Trans. Sen. Netw.},
 keyword = {DAG scheduling, function configuration, edge computing, online algorithm},
 month = {October},
 number = {1},
 numpages = {25},
 publisher = {Association for Computing Machinery},
 title = {DAG Scheduling in Mobile Edge Computing},
 url = {https://doi.org/10.1145/3616374},
 volume = {20},
 year = {2023}
}
