@conference{Liu2022101,
 abstract = {Information extraction is an important semantic processing task to construct network security knowledge graph. Extracting entities and relationships in vulnerability description from public data sets will inevitably lead to waste of manpower and difficulty in accurate positioning. Another challenge is that there are multiple relationships among vulnerable descriptors. This paper proposes a framework for the common vulnerabilities and exposures (CVE) analysis, which consists of entity annotation algorithm and relational classification model. In particular, we apply the model to CVE dataset to solve the problem of information extraction and relationship classification in the CVE vulnerability analysis. Moreover, the predicted relationship is used to construct vulnerability security knowledge graph. The experimental results show that the framework can deal with the CVE vulnerability description effectively, and has good relationship classification performance.  © 2022 IEEE.},
 author = {Liu, Zhen and Di, XiaoQiang and Song, Wei and Ren, WeiWu},
 doi = {10.1109/CBD54617.2021.00026},
 journal = {Proceedings - 2021 9th International Conference on Advanced Cloud and Big Data, CBD 2021},
 note = {Cited by: 2},
 pages = {101 - 106},
 publication_stage = {Final},
 source = {Scopus},
 title = {Vulnerability knowledge extraction method based on joint extraction model},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85135156881?origin=resultslist},
 year = {2022}
}
