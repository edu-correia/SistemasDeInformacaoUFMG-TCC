@article{11373670,
 abstract = {To improve the accuracy of coastline extraction for polarimetric synthetic aperture radar (PolSAR) images, an adaptive superpixel segmentation-based method is proposed. First, multiple polarimetric and texture features are extracted to characterize the complexity for PolSAR image. Then, the image complexity and dimension are used to determine the optimal number of superpixels, followed by segmenting superpixels through the integration of the simple linear iterative clustering (SLIC) algorithm. The segmented superpixels are merged to extract the coastlines using the superpixel similarity-based fractal network evolution algorithm (FNEA). Ultimately, the proposed method is validated using PolSAR images with varying complexity levels. Experimental results demonstrate its effectiveness, achieving an average undersegmentation error of 0.1269 for adaptive superpixel segmentation and a high average Kappa coefficient of 0.9889 for coastline extraction. Furthermore, the method exhibits strong adaptability in superpixel segmentation while maintaining high precision in coastline extraction.},
 author = {Wang, Yu and Ma, Zhanying and Li, Mengmeng and Li, Yu and Shi, Xue and Zhao, Xuemei},
 doi = {10.1109/JSTARS.2026.3662412},
 issn = {2151-1535},
 journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
 keyword = {Coastlines;Sea measurements;Pixel;Land surface;Geologic measurements;Image segmentation;Complexity theory;Accuracy;Scattering;Feature extraction;Adaptive superpixel segmentation;coastline extraction;polarimetric synthetic aperture radar (PolSAR) Image;superpixel similarity},
 month = {},
 number = {},
 pages = {7251-7263},
 title = {Adaptive Superpixel Segmentation-Based Coastline Extraction Method for PolSAR Images},
 volume = {19},
 year = {2026}
}
