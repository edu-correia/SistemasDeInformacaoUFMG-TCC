@article{LISBOA2025100780,
 abstract = {Probiotic ice cream merges indulgence with functional nutrition, offering an appealing medium for delivering beneficial microorganisms. This review explores recent advancements in probiotic ice cream formulations, highlighting critical factors such as strain selection, matrix composition (dairy and plant-based), and innovations like microencapsulation, prebiotic integration, and advanced freezing techniques to maximize microbial viability. Stability challenges related to freezing kinetics, ice crystallization, and long-term storage are systematically analyzed, alongside protective strategies employing cryoprotectants and encapsulation technologies. Furthermore, the review summarizes clinical evidence supporting health benefits ranging from oral health improvements to gut microbiota modulation and systemic effects. Market dynamics, including regulatory environments and consumer perceptions across North America, Europe, and Latin America, are discussed to underline the commercial viability and consumer acceptance of probiotic ice cream. Finally, future perspectives emphasize emerging trends such as next-generation probiotics, personalized nutrition, sustainability practices informed by life cycle assessment, and digital traceability. Overall, probiotic ice cream presents a promising intersection of sensory appeal and health benefits, positioning it as a versatile and scientifically validated option within the functional food market.},
 author = {Hugo M. Lisboa and Ana Maria Sarinho and Maria Eduarda Costa and Ana Beatriz Medeiros and Shenia Santos Monteiro and Matheus Augusto Bittencourt Pasquali},
 doi = {https://doi.org/10.1016/j.foohum.2025.100780},
 issn = {2949-8244},
 journal = {Food and Humanity},
 keyword = {Probiotic Ice Cream, Functional Foods, Microbial Viability, Cryoprotection, Encapsulation, Freezing Kinetics, Gut Microbiota, Health Benefits, Regulatory Framework, Consumer Acceptance, Sustainability},
 pages = {100780},
 title = {Probiotic ice cream: Formulation innovations, stability challenges, and future perspectives},
 url = {https://www.sciencedirect.com/science/article/pii/S2949824425002848},
 volume = {5},
 year = {2025}
}
