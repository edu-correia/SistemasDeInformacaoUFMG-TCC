 publication_stage = {Final},
 source = {Scopus},
 title = {Fast-Yolo-Rec: Incorporating Yolo-Base Detection and Recurrent-Base Prediction Networks for Fast Vehicle Detection in Consecutive Images},
 type = {Article},
