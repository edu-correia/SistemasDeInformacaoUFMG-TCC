@article{Lai202072,
 abstract = {Sorting is pivotal data analytics and becomes challenging with intensive computation on drastically growing data volume. Sorting on FPGA has shown superior throughput, but the limited in-system memory causes vast data transferring to/from external storage when handling a large dataset. We propose a two-directional sorting (2DSort) architecture which sorts data sequences on both horizontal and vertical directions. 2DSort significantly reduces the costly data transmission by tracking the data on FPGA and writes back the data to external storage when the final sorting position is determined. 2DSort shows average 38.5 percent runtime enhancement in comparison to state-of-the-art bigdata sorting engine on FPGA.  © 2002-2011 IEEE.},
 author = {Lai, Bo-Cheng and Chen, Chun-Yen and Hsin, Yi-Da and Lin, Bo-Yen},
 doi = {10.1109/LCA.2020.2993040},
 journal = {IEEE Computer Architecture Letters},
 note = {Cited by: 7},
 number = {1},
 pages = {72 - 75},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Two-Directional BigData Sorting Architecture on FPGAs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85084754493?origin=resultslist},
 volume = {19},
 year = {2020}
}
