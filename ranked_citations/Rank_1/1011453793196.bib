@article{10.1145/3793196,
 abstract = {In recent years, the talking head generation has become a focal point for researchers. Considerable effort is being made to refine lip-sync motion, capture expressive facial expressions, generate natural head poses, and achieve high-quality video. However, no single model has yet achieved equivalence across all quantitative and qualitative metrics. We introduce JambaTalk, a hybrid Transformer-Mamba model, to animate a 3D face. Mamba, a pioneering Structured State Space Model (SSM) architecture, was developed to overcome the limitations of conventional Transformer architectures, particularly in handling long sequences. This challenge has constrained traditional models. Jamba combines the advantages of both the Transformer and Mamba approaches, offering a comprehensive solution. Based on the foundational Jamba block, we present JambaTalk to enhance motion variety and lip sync through multimodal integration. Extensive experiments reveal that our method achieves performance comparable or superior to state-of-the-art models. Supplementary video and code are available at: .},
 address = {New York, NY, USA},
 author = {Jafari, Farzaneh and Berretti, Stefano and Basu, Anup},
 doi = {10.1145/3793196},
 issn = {1551-6857},
 journal = {ACM Trans. Multimedia Comput. Commun. Appl.},
 keyword = {Facial Animation Synthesis, Virtual Humans, 3D Mesh Animation, Blendshape Animation, Selective State Space Models (S6), Mixture of Experts, Transformers, Mamba, and Low-Rank Learned Rotary Positional Embedding},
 month = {January},
 note = {Just Accepted},
 publisher = {Association for Computing Machinery},
 title = {JambaTalk: Speech-driven 3D Talking Head Generation based on a Hybrid Transformer-Mamba Model},
 url = {https://doi.org/10.1145/3793196},
 year = {2026}
}
