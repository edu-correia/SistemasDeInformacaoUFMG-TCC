 issn = {2212-4438},
 journal = {Journal of the World Federation of Orthodontists},
 number = {6},
 pages = {549},
 title = {461 - Esthetic Palatal Crib: an alternative for treating anterior open bite},
 url = {https://www.sciencedirect.com/science/article/pii/S221244382500520X},
