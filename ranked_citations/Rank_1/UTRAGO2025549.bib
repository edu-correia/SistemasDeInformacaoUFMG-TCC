 abstract = {Background
Anterior open bite is a common malocclusion in children. Among early treatment options, the fixed palatal crib is the gold standard, providing effective, efficient, and reliable results. Considering the strong trend towards esthetics and more discreet orthodontic appliances, the Esthetic Palatal Crib was developed, integrating metallic and transparent components into a single device.
Discussion
Similar to the conventional palatal crib, this fixed orthodontic appliance features a metal palatal structure soldered to orthodontic bands placed in the maxillary molars, while, in the anterior region, the traditional metallic rods are replaced by a transparent injection-molded polymer. The development of the device and its patent application started in 2021 at the University of São Paulo, and the appliance prototype was developed in collaboration with the Brazilian company Orthometric. The first children treated with the Esthetic Palatal Crib demonstrated positive patient perception of the new device, with anterior open bite correction achieved within six to ten months.
Conclusions
The Esthetic Palatal Crib was designed as an alternative for anterior open bite correction, enhancing esthetic comfort and patient cooperation while maintaining the effectiveness of the traditional palatal crib. This innovation merges established orthodontic principles with contemporary expectations, aiming to benefit both patients and clinicians.},
 author = {Gabriela Utrago and Garcia Lourival and Fabio Beggiora and Roque {J Merida Delgado} and Camila Massaro and Daniela Garib},
