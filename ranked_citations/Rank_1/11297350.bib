@inproceedings{11297350,
 abstract = {Floods represent significant natural hazards with severe socio-economic impacts expected to worsen due to climate change and urban growth. Effective flood monitoring and rapid response are critical for mitigating these impacts. This paper presents a conceptual framework for onboard flood monitoring using deep learning integrated with Synthetic Radar Aperture (SAR) imagery. The proposed methodology includes predictive flood hazard assessment utilizing meteorological and topographic data, real-time semantic segmentation of SAR imagery for flood mapping, and pixel-level water depth estimation by merging flood masks with Digital Elevation Models (DEM). Further-more, a novel method for estimating floodwater velocity using multi-temporal SAR data combined with DEM-derived terrain features is introduced. This framework emphasizes modularity, computational efficiency, and adaptability to onboard processing constraints, providing foundational insights for developing autonomous flood response systems in satellite platforms.},
 author = {Ramesh, Rohin Andy and Gonzalez, Marcos Quintana and Martinez, Maria Jose and Kerdegari, Hamideh and Foroozan, Firoozeh and Ahmed, Rohaan},
 booktitle = {2025 IEEE International Conference on Next-Gen Technologies of Artificial Intelligence and Geoscience Remote Sensing (EarthSense)},
 doi = {10.1109/EarthSense66084.2025.11297350},
 issn = {},
 keyword = {Deep learning;Satellites;Spaceborne radar;Soft sensors;Semantic segmentation;Soil;Radar polarimetry;Floods;Socioeconomics;Monitoring;SAR;Vitis AI;flood;monitoring;deeplearning;water-depth;water velocity flow;xilinx fpga},
 month = {Sep.},
 number = {},
 pages = {1-5},
 title = {Deep Learning Based Flood Water Dynamics Estimation on-Board using SAR},
 volume = {},
 year = {2025}
}
