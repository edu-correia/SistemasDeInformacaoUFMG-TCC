@conference{Li2010,
 abstract = {Shadow exists obviously in high resolution remote sensing images. Automatic extracting shadow is quite important for removing shadow as noise or for mining shadow information. A new method of IKONOS shadow extraction in urban region was presented in this paper based on the principal component (PC) fusion information distort. First, the NIR (near infrared) band with more shadow information was selected for shadow extraction, and the information distort of PC fusion was assessed; it was found that shadow was sensitive to difference index. Second, a relative difference index was structured to enhance shadow information, as a result the values of relative difference index in shadow region were higher and the ones in non-shadow region were lower. Third, possible shadow was distinguished from non-shadow by threshold. Finally standard deviation was used to differentiate shadow from water for possible shadow, and the shadow was extracted. The results show that this shadow extraction method was simple with high accuracy, not only the shadow of high building but also that of low trees were all detected. © 2010 Copyright SPIE - The International Society for Optical Engineering.},
 author = {Li, Cunjun and Wang, Jihua and Wang, Qian and Huang, Wenjiang and Xu, Xingang},
 doi = {10.1117/12.865156},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on IKONOS shadow extraction in urban region based on the principal component fusion information distort},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78649745770?origin=resultslist},
 volume = {7824},
 year = {2010}
}
