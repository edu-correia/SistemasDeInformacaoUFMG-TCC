@article{Arif2026,
 abstract = {We delve into the verification and enforcement problem of K-step mutual opacity of discrete-event systems, which is a crucial aspect of information flow privacy. Specifically, K-step mutual opacity describes a scenario in which the secret states cannot be mutually revealed within K steps of observations by two or more adversaries. For the sake of simplicity, suppose that two agents engage in strategic competition in a system where each aims to reveal the other's secrets while concealing its own. These agents partially observe system evolution and influence the behavior of the system by enabling or disabling events from their controllable event sets. A separation principle is used to construct state estimates, precisely for a two-way observer, that merge both the past and future information flow into one structure. Furthermore, the two-way observer supports a more efficient verification algorithm for K-step mutual opacity. For the enforcement of K-step mutual opacity, the analyses unfold in distinct scenarios. Primarily, agents are passive, in which the system is connected with a global controller capable of ensuring mutual opacity between the agents within K observations. This controller prevents the leakage of secret information from one adversary to the other. Moreover, we explore the feasibility of synthesizing separate controllers for the agents. The objective is to devise a winning state-dependent control strategy that ensures an agent consistently uncovers the secret of the other while securing its own. This research illuminates the intricate dynamics of information flow privacy in a competitive environment, providing insights that facilitate the development of effective privacy-preserving mechanisms in complex networked systems. © 2026 Elsevier Inc.},
 author = {Arif, Robia and Liu, Gaiyun and Al-Ahmari, Abdulrahman and Li, Zhiwu},
 doi = {10.1016/j.ins.2026.123497},
