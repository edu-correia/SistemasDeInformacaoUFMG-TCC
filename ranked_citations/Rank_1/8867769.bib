@inproceedings{8867769,
 abstract = {The report discusses the creation of software for pre-processing of images and audio signals based on a concrete model for clustering of signal elements. A uniform signal representation by means of a linearly ordered multiset of samples, e.g. image pixels or samples of audio signal, is proposed. The general scheme of calculations is given. The basic requirements for the data organization are specified. The implementation of the general scheme and data organization in terms of dynamic algebraic network is treated. The features of a tree-structured data organization supporting hierarchical sample clustering are explained. The basic algorithms are described. The research results are compared with known approaches.},
 author = {Kharinov, Mikhail V. and Bykov, Aleksandr N.},
 booktitle = {2019 International Russian Automation Conference (RusAutoCon)},
 doi = {10.1109/RUSAUTOCON.2019.8867769},
 issn = {},
 keyword = {Merging;Approximation error;Arrays;Metadata;Automation;Biological system modeling;image pixels;signal samples;network structure;hierarchical ordering;compression and data transfer;acceleration of calculations},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Data Structure for Multimodal Signal Processing},
 volume = {},
 year = {2019}
}
