@conference{Masum2025,
 abstract = {Accurate fish disease detection is essential for sustainable aquaculture, but existing machine learning models often require too much computational power for practical use. This study evaluates lightweight ResNeXt models (ResNeXt50 and ResNeXt101) for efficient fish disease classification using a comprehensive freshwater fish disease dataset. ResNeXt's residual connections enable stable training and fast convergence, while its split-transform-merge design effectively learns diverse lesion patterns. ResNeXt50 achieved 95% accuracy, outperforming established models with significantly lower computational requirements. The results show that ResNeXt50 provides an effective solution for real-time fish disease detection, balancing efficiency and accuracy.  © 2025 IEEE.},
 author = {Masum, Abdul Kadar Muhammad and Khan, Md Fokrul Islam and Mahmud, Farhad Uddin and Hassan, Md. Maruf and Khaliluzzaman, Md.},
 doi = {10.1109/AIBThings66987.2025.11296219},
 journal = {2025 3rd International Conference on Artificial Intelligence, Blockchain, and Internet of Things, AIBThings 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improving Aquaculture Disease Diagnosis with Lightweight ResNeXt Architectures},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105031679480?origin=resultslist},
 year = {2025}
}
