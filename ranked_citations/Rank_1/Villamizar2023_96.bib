@article{Villamizar2023_96,
 abstract = {This study delves into moment of inertia in rigid body mechanics, a crucial concept in physics. While it’s traditionally taught through integration, we propose an alternative method using discrete mass segments. This approach simplifies calculations, particularly for symmetric bodies, without complex integration procedures. Our goal is to enhance students’ understanding of fundamental physics principles, making the subject more accessible. We also provide visual aids and online animations to aid comprehension.},
 author = {Villamizar, David Velasco},
 doi = {10.1590/1806-9126-rbef-2023-0277},
 pages = {e20230277--e20230277},
 title = {Moments of inertia by summation},
 volume = {45},
 year = {2023}
}
