@article{XU2025120914,
 abstract = {This paper introduces an innovative modular rapid prototyping design method specifically tailored for the adaptable design of container ships. This approach emphasizes the use of computer-aided design-based modularization and intelligent templates to significantly enhance the efficiency and flexibility of the ship design process. A key innovation is its multi-level skeleton structure, which integrates knowledge engineering for intelligent template creation, enabling efficient functional layout integration that can accommodate frequent design adjustments. The control of model granularity is a critical contribution of this method, as it allows for an appropriate level of detail in modeling, affecting both the organization of information and the complexity of model control. This method is demonstrated through a case study of a container ship, highlighting its effectiveness in managing complex configurations. This approach not only improves early-stage design precision but also supports scalable applications across various vessel types, addressing the unique challenges of the engineer-to-order nature of the shipbuilding industry. This paper's contribution lies in the proposed technique's ability to reduce lead time and rework, support set-based design, and enable cross-project reusability, offering a transformative approach to ship design adaptability and modularity.},
 author = {Sihao Xu and Yuchen Dai and Tong Zhou and Deyu Wang},
 doi = {https://doi.org/10.1016/j.oceaneng.2025.120914},
 issn = {0029-8018},
 journal = {Ocean Engineering},
 keyword = {Modular design, Rapid prototyping, Ship design adaptability, Design reusability},
 pages = {120914},
 title = {Modular rapid prototyping design method for container ships},
 url = {https://www.sciencedirect.com/science/article/pii/S0029801825006274},
 volume = {326},
 year = {2025}
}
