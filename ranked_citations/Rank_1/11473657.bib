@inproceedings{11473657,
 abstract = {The current industrial world scenario filled with fast technological innovations and a network of relationships calls for the integration of environmental, social, and governance (ESG) in supply chains' core. This work determines how much Supply Chain 5.0 is helpful in raising ESG ratings, captivation factor for socially responsible investors. Mixed-methods analysis, solely dependent on secondary data, was performed on 30 Moroccan companies traded on the Casablanca Stock Exchange. The paper explores the link between supply-chain maturity, ESG scores, and investor attractiveness. Findings reveal a substantial positive correlation between supply-chain maturity and ESG scores. Firms at the "Human & Sustainable" (Supply Chain 5.0) stage have the highest ESG scores, especially for the environmental and social pillars, thus confirming that this development leads to the overall sustainability and worker well-being optimization. Supply Chain 5.0, whose core is human-centric, sustainable, and resilient, is therefore, directly linked to the ESG pillars, and thus, it fosters transparency and risk management. There is also a moderate positive correlation between supply-chain maturity and perceived investor attractiveness and between overall ESG scores and this attractiveness, with the social pillar being the strongest determinant. Although there seems to be a disengagement between perceived attractiveness and actual investments, which are usually influenced by extra-ESG factors, the positive trend is still there, thus, emphasizing the role of ESG performance in market perception. Sectoral analysis exposes heterogeneous dynamics, thus, confirming that the impact of ESG is influenced by the factors of the industry. Being a paper with an excellent methodological rigor, it, thus, experimentally corroborates the successful merging of the Supply Chain 5.0 tenets as a trigger of ESG performance. It helps with insightful strategies for firms willing to improve their ESG credentials and attract ethical investors, and at the same time, giving hints for complex theoretical models and advanced regulatory frameworks, thus, bearing witness to the relevance and robustness of our findings.},
 author = {Ayyoub, Tagui and Fatiha, Regragui},
 booktitle = {2025 IEEE International Conference on Advanced Technologies in Supply Chain Management (ATSCM)},
 doi = {10.1109/ATSCM67505.2025.11473657},
 issn = {},
