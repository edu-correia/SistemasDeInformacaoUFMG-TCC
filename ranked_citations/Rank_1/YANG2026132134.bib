@article{YANG2026132134,
 abstract = {Freeway on-ramp merging remains one of the most challenging processes in traffic operations due to its complex vehicle interactions and the resulting disturbances to traffic flow. With the development of Connected and Automated Vehicle (CAV) technology, intelligent cooperative control strategies have attracted increasing attention. This study proposes a Cooperative Platoon and Lane-change based Trajectory Planning (CPLT) framework, formulated as a Mixed-Integer Linear Programming (MILP) problem and implemented as a transparent optimization-based decision support controller that integrates merging-sequence decisions and trajectory planning into a unified rolling-horizon framework. The model simultaneously optimizes lane-changing, platoon formation, merging sequence, and vehicle trajectories through a Mixed-Integer Linear Programming formulation. To enable real-time operability in the tested setting, we incorporate domain-specific heuristic simplification rules that reduce computational complexity while preserving solution quality, and embed the model within a Rolling Horizon Control framework for dynamic traffic environments. Comprehensive simulation experiments under varying traffic demand scenarios demonstrate that the CPLT model significantly outperforms platoon-only and lane-changing-only baseline strategies. The proposed system achieves substantial reductions in average travel time under high demand, with ramp vehicles benefiting disproportionately while maintaining fairness and stability across vehicle classes. Sensitivity analysis further reveals that small-to-moderate platoon sizes and adaptive ramp prioritization weights are most effective for balancing efficiency and equity. The findings underscore the value of an integrated intelligent control approach and demonstrate the closed-loop operability of combining optimization techniques with heuristic knowledge for complex real-time traffic management problems.},
 author = {Hao Yang and Chuyao Zhang and Lei Sa and Jiangfeng Wang},
 doi = {https://doi.org/10.1016/j.eswa.2026.132134},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Connected and Automated Vehicles, Cooperative ramp merging, Joint optimization, Platooning and lane-changing, Rolling horizon control},
 pages = {132134},
 title = {An intelligent decision support system for CAV ramp Merging: Joint optimization of Platooning, Lane-Changing and trajectory planning},
 url = {https://www.sciencedirect.com/science/article/pii/S095741742601047X},
 volume = {319},
 year = {2026}
}
