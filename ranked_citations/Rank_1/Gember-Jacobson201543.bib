@conference{Gember-Jacobson201543,
 abstract = {Several frameworks have been proposed to orchestrate the transfer of internal state between network function (NF) instances. Unfortunately, these frameworks suffer from safety, efficiency, and scalability problems due to their excessive use of packet buffering. We propose two novel enhancements, packet reprocessing and peer-to-peer transfers, to address these issues. We show these enhancements reduce the average per-packet latency overhead by up to 92% and state transfer times by up to 70%. © 2015 ACM.},
 author = {Gember-Jacobson, Aaron and Akella, Aditya},
 doi = {10.1145/2785989.2785997},
 journal = {HotMiddlebox 2015 - Proceedings of the 2015 ACM SIGCOMM Workshop on Hot Topics in Middleboxes and Network Function Virtualization, Part of SIGCOMM 2015},
 note = {Cited by: 48},
 pages = {43 - 48},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improving the safety, scalability, and efficiency of network function state transfers},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84959277166?origin=resultslist},
 year = {2015}
}
