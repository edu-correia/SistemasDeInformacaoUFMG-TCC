 publication_stage = {Final},
 source = {Scopus},
 title = {Accelerating Machine Learning Queries with Linear Algebra Query Processing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85173549029?origin=resultslist},
 year = {2023}
