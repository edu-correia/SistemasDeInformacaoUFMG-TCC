@article{Ciszak2009797,
 abstract = {The data quality assessment process consists of several phases; the first phase is the data profiling step. The result of this step is the set of the most current metadata describing the examined data set. We present here a method for automatic discovery of reference data for textual attributes. Our method combines the textual similarity approach with the characteristics of attribute value distribution. The method can discover the correct reference data values also in situations where there is a large number of data impurities. The results of the experiments performed on real address data prove that the method can effectively discover the current reference data. © 2009 Springer Berlin Heidelberg.},
 author = {Ciszak, Lukasz},
 doi = {10.1007/978-3-642-02568-6_81},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {797 - 805},
 publication_stage = {Final},
 source = {Scopus},
 title = {A method for automatic discovery of reference data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70350641235?origin=resultslist},
 volume = {5579 LNAI},
 year = {2009}
}
