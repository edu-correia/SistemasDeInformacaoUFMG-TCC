@article{LIN2025109915,
 abstract = {This paper studies the behavior monitoring of pigs using active electronic ear tags embedded with triaxial acceleration sensors. Ear-flapping can cause high variability and noise into the accelerometer data. To address this issue, a three-layer classification model is proposed. Each layer utilizes different window sizes, overlap rates, features, and machine learning models to effectively classify behaviors ranging from low to high locomotor activity. Model parameters for each layer calculate probabilities for different behaviors, and a probabilistic strategy merges consecutive time slices of the same behavior, similar to dynamic window effects. The experiment collected triaxial acceleration data from 16 sows over 274 days. Video data from surveillance cameras were used to annotate pigs’ behaviors such as eating and walking. Data analysis shows that the first layer, using a logistic regression model with a 135.2-second window size, achieves a 0.95 recognition rate for low locomotor activity. The second layer, employing a logistic regression model with a 25.92-second window size, achieves a recognition rate of 0.76 for eating behavior. The third layer, using a support vector machine model with a 10.56-second window size, attains recognition rates of 0.88, 0.75, and 0.76 for sitting, walking, and high locomotor activity, respectively. The random forest based probabilistic strategy integrates the results of the three-layer classification model to classify behaviors throughout the day, achieving an average accuracy of 0.92. This three-layer classification model with a probabilistic strategy effectively classifies 24-hour behaviors and detects abnormalities such as lameness and vomiting in the experimental pigs.},
 author = {Junyong Lin and Runkang Wu and Ling Yin and Xueyin Wang and Hongyu Chen and Gengyuan Cai and Zhenfang Wu and Ming Yang and Jie Yang and Sumin Zhang},
 doi = {https://doi.org/10.1016/j.compag.2025.109915},
 issn = {0168-1699},
 journal = {Computers and Electronics in Agriculture},
 keyword = {Dynamic window, Active electronic ear tag, Behavior classification, Machine learning, Triaxial acceleration},
 pages = {109915},
 title = {Hierarchical model with integrated probabilistic strategy for classifying pig behaviors using active electronic ear tags},
 url = {https://www.sciencedirect.com/science/article/pii/S0168169925000213},
 volume = {230},
 year = {2025}
}
