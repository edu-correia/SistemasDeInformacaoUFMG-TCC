@article{Kurt20242973,
 abstract = {Planned maintenance is required by licensed maintenance organizations to detect and prevent performance degradation in aircraft engines. In the literature, engine performance is evaluated with parameters that show engine performance. Fuel flow parameter is one of the important parameters that shows engine performance. In the models developed earlier, no engine performance evaluation was made with the fuel flow parameter at all stages from the take-off to the landing of the aircraft. In this study, fuel flow parameter is estimated with over 99.9% accuracy by using artificial neural network in MATLAB<sup>®</sup> software. In order to detect the engine performance deterioration of the aircraft, the fuel flow values obtained from the artificial neural network and confidence intervals with 99% confidence level were established. Each value taken from the fuel flow sensor is evaluated by the model in all flight phases. In the model, engine performance is considered normal if the fuel flow value is within the confidence interval, and abnormal (anomaly) if it is outside the confidence interval. An accuracy of over 99.9% was achieved and results of this study showed that fuel flow rate of the engine of interest was within the confidence interval (no performance deterioration). © 2023, The Author(s), under exclusive licence to Springer-Verlag London Ltd., part of Springer Nature.},
 author = {Kurt, Bulent},
 doi = {10.1007/s00521-023-09174-9},
 journal = {Neural Computing and Applications},
 note = {Cited by: 1},
 number = {6},
 pages = {2973 - 2982},
 publication_stage = {Final},
 source = {Scopus},
 title = {Prediction of performance degradation in aircraft engines with fuel flow parameter},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85178109731?origin=resultslist},
 volume = {36},
 year = {2024}
}
