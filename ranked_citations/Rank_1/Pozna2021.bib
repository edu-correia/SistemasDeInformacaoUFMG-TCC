@conference{Pozna2021,
 abstract = {In this paper, a case study is presented on the tactical level of autonomous vehicle control. Inspired by the human driver behavior, vehicle control is structured in a hierarchy on three levels: the strategic, the tactical, and the operational level. These are connected by specific links, and based on prior information and models, are transforming the input data from the environment into actuator commands on the various degree of freedom of the vehicle. The case study is presenting a simulation of a scenario, detailing the vehicle models with sensors, the collection of behavior, and the behavior selector. © 2021 IEEE.},
 author = {Pozna, Claudiu Radu and Antonya, Csaba and Horvath, Erno},
 doi = {10.1109/ICECCME52200.2021.9590868},
 journal = {International Conference on Electrical, Computer, Communications and Mechatronics Engineering, ICECCME 2021},
 note = {Cited by: 3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Case study on the tactical level of an autonomous vehicle control},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85119427214?origin=resultslist},
 year = {2021}
