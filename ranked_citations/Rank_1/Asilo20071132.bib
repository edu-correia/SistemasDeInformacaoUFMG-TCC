@conference{Asilo20071132,
 abstract = {Rice is a staple food in the Philippines and sufficiency in rice is the government's utmost priority. With the continuously growing population in our country, it is essential for planners and policy makers to know how much rice is growing where and whether or not the supply will meet the demand. The use of remote sensing has been proven to be an effective tool for rice area mapping and monitoring. Moreover, fusion of images has proven its potential in bringing out maximum information about most of the land cover features. This study aims to utilize and determine the most accurate image fusion technique for rice area mapping in selected areas of Pangasinan and Nueva ecija using three-date RADARSAT-1 (1-July, 18-August and 5-October 2005) and ASTER VNIR image. Color Composite, HSV, PCA, Band Ratio and Band Subtraction combined with Band Average are the techniques used in this study. Visual examination of the preliminary results indicated clear discrimination of the rice areas. Results showed that band subtraction combined with band average is the most accurate technique for rice area estimation with a classification accuracy of 85.14% and rice location accuracy 84.62%.},
 author = {Asilo, Sonia L. and Paringit, Enrico C. and Casiwan, Cheryll B. and Collado, Wilfredo B. and Mehdiyev, Magsud and Hazarica, Manzul Kumar and Samarakkon, Lal and Kamthonkiat, Daroonwan},
 journal = {28th Asian Conference on Remote Sensing 2007, ACRS 2007},
 note = {Cited by: 0},
 pages = {1132 - 1137},
 publication_stage = {Final},
 source = {Scopus},
 title = {Fusion techniques for rice area maping using multitemporal Radarsat-1 images in Pangasinan and Nueva ECJA},
 type = {Conference paper},
