@inproceedings{5727710,
 abstract = {Mobile grid computing is a new computing paradigm which joins classic grid computing and mobile computing paradigm to provide dependable, seamless, pervasive access to mobile resources and services. It can use the underlying connectivity and routing protocols defined by MANET in order to perform resource discovery and access. This paper proposes a mobility-aware zoned routing protocol for MANET-MAFZP, which create zones in terms of the distance between each node to the Minimum ID node. Resort to the information provided by neighborhood nodes, our proposed protocol's request delay and control overhead is descend to O(2R). In addition, this protocol classifies the mobility pattern with neighbor node and reduces routing control overhead. Simulation results show that the protocol greatly decreased routing time and control overhead.},
 author = {Rui Li, Rui Li and Renfa Li, Renfa Li and Fei Yu, Fei Yu and Jigang Wen, Jigang Wen},
 booktitle = {2006 Semantics, Knowledge and Grid, Second International Conference on},
 doi = {10.1109/SKG.2006.9},
 issn = {},
 keyword = {Routing;Routing protocols;Grid computing;Delays;Mobile computing;Mobile ad hoc networks;Zirconium;Semantics;Magnetic heads;Data structures},
 month = {Nov},
 number = {},
 pages = {73-73},
 title = {A Mobility-Aware Zone-Based Routing Protocol for Mobile Grid Computing},
 volume = {},
 year = {2006}
}
