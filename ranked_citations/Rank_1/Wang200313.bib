@article{Wang200313,
 abstract = {In this study of mining stock price data, we attempt to predict the stronger rules of stock prices. To address this problem, we proposed an effective method, a fuzzy rough set system to predict a stock price at any given time. Our system has two agents: one is a visual display agent that helps stock dealers monitor the current price of a stock and the other is a mining agent that helps stock dealers make decisions about when to buy or sell stocks. To demonstrate that our system is effective, we used it to predict the stronger rules of stock price and achieved at least 93% accuracy after 180 trials. © 2002 Elsevier Science Ltd. All rights reserved.},
 author = {Wang, Yi-Fan},
 doi = {10.1016/S0957-4174(02)00079-9},
 journal = {Expert Systems with Applications},
 note = {Cited by: 163},
 number = {1},
 pages = {13 - 23},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mining stock price using fuzzy rough set system},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/0037213698?origin=resultslist},
 volume = {24},
 year = {2003}
}
