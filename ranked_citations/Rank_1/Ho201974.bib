@conference{Ho201974,
 abstract = {Finding the boundary of the object from the image is an important step in image processing. Splitting and region merging is one of the typical approaches for image segmentation. This paper proposes a slipping-and-region-merging method. The image is segmented by the quadtree to establish a relationship list between the blocks. The block is treated as a seed and merged for similar hue angles between adjacent regions. Our system adopts Lab2000HL color space, which is closer to human vision of color perception. The experimental results prove that our method can more accurately find the actual boundary of the object and effectively reduce unnecessary blocks. © 2019 IEEE.},
 author = {Ho, Ken-Chung and Tsai, Chi-Shiang},
 doi = {10.1109/ECICE47484.2019.8942787},
 journal = {2019 IEEE Eurasia Conference on IOT, Communication and Engineering, ECICE 2019},
 note = {Cited by: 1},
 pages = {74 - 76},
 publication_stage = {Final},
 source = {Scopus},
 title = {Image segmentation using a hue-guided quadtree},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85078577283?origin=resultslist},
 year = {2019}
}
