@article{Schaeffer200727,
 abstract = {In this survey we overview the definitions and methods for graph clustering, that is, finding sets of "related" vertices in graphs. We review the many definitions for what is a cluster in a graph and measures of cluster quality. Then we present global algorithms for producing a clustering for the entire vertex set of an input graph, after which we discuss the task of identifying a cluster for a specific seed vertex by local computation. Some ideas on the application areas of graph clustering algorithms are given. We also address the problematics of evaluating clusterings and benchmarking cluster algorithms. © 2007 Elsevier Ltd. All rights reserved.},
 author = {Schaeffer, Satu Elisa},
 doi = {10.1016/j.cosrev.2007.05.001},
 journal = {Computer Science Review},
 note = {Cited by: 1686},
 number = {1},
 pages = {27 - 64},
 publication_stage = {Final},
 source = {Scopus},
 title = {Graph clustering},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/35248893285?origin=resultslist},
 volume = {1},
 year = {2007}
}
