 keyword = {Binary tree dispatch, C#, C++, Eiffel, Java, PRM, Theta, casting, coloring, downcast, dynamic loading, genericity, late binding, linking, message sending, method dispatch, multiple inheritance, pointer adjustment, separate compilation, single inheritance, static typing, type analysis, virtual function tables},
 month = {April},
