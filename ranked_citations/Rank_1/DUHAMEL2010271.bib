@incollection{DUHAMEL2010271,
 abstract = {Publisher Summary
This chapter provides an introduction to the classical way of performing joint source-channel coding (JSCC), in which the entropy coding is usually removed (because the impact of transmission errors is difficult to model) and replaced by index assignment (IA). Following this, it provides an outline of the work in this area. The strategy in this context is to deliberately introduce redundancy in the encoder, with a clear structure, so that its efficiency can be monitored. Within this framework, two main tools are described—error-correcting entropy codes (as a possible replacement for VLCs or ACs) and redundant descriptions, as possible replacements for the transformation/quantization building blocks. It should be noted that the improvements brought by entropy coders are so large that a complete elimination of this step does not seem to be competitive in the framework. Depending on the assumptions on which the JSCC methods rely, some blocks are merged and have to perform a more complex task which is then to be optimized for minimum distortion under noisy channel conditions. Other methods concentrate on one of these building blocks and propose possible replacements, able to deal with the possible transmission errors. In accordance with the traditional JSCC setting, the network layers are not taken into account in this section. They are assumed to be fully transparent, unless otherwise stated.},
 address = {Oxford},
 author = {Pierre Duhamel and Michel Kieffer},
 booktitle = {Joint Source-Channel Decoding},
 doi = {https://doi.org/10.1016/B978-0-12-374449-4.00005-2},
 editor = {Pierre Duhamel and Michel Kieffer},
 isbn = {978-0-12-374449-4},
 pages = {271-295},
 publisher = {Academic Press},
 title = {Chapter 10 - Introduction to Joint Source-Channel Coding},
 url = {https://www.sciencedirect.com/science/article/pii/B9780123744494000052},
 year = {2010}
}
