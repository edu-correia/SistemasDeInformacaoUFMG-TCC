@conference{Dunik2017,
 abstract = {The paper deals with the state estimation of nonlinear stochastic dynamic systems. The stress is laid on the assessment of the estimate error, which is caused by the violation of the estimator design assumptions. The assessment is based on measures comparing estimators actual working conditions and the assumptions under which the estimators have been proposed. In particular, the measures of nonlinearity and non-Gaussianity are discussed. The measures are briefly introduced and selected typical representatives are detailed with respect to their implementation. Performance of the measures is evaluated in the framework of the Gaussian filters in a numerical study. © 2017 International Society of Information Fusion (ISIF).},
 author = {Dunik, J. and Straka, O. and Garcia-Fernandez, A.F.},
 doi = {10.23919/ICIF.2017.8009699},
 journal = {20th International Conference on Information Fusion, Fusion 2017 - Proceedings},
 note = {Cited by: 14},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Performance evaluation of nonlinearity and non-Gaussianity measures in state estimation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85029404906?origin=resultslist},
 year = {2017}
}
