@conference{Jiang2014,
 abstract = {3D(Three-dimensional) measurement has found its applications in the fields of automation process, Reverse engineering(RE), machine vision, as well as medical diagnostic. There are some disadvantages in the present 3D measurement methods. In this paper, a 2D laser displacement sensor-based and fast-dimensional surface measurement method for small size objects was proposed after analyzing the existing three-dimensional measurement methods. This method uses the information collected by 2D laser displacement sensor and encoder in pan-tilt to three-dimensional reconstruct 3D model. And then discuss the restrictive relation between angular velocity of pan-tilt and parameters (measurement range, signal sample rate, precision, etc.) of 2D laser displacement sensor. The sources of error and methods of improving precision were analyzed. Theoretical analyses and experiments have proved the feasibility, high-precision and practical of this method. © 2014 SPIE.},
 author = {Jiang, Sulun and Fu, Yuegang and Zhu, Wangbin and Zhang, Yingwei and Wang, Weichen},
 doi = {10.1117/12.2072998},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A three-dimensional measuring system based on 2D laser displacement sensor},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84923108590?origin=resultslist},
 volume = {9297},
 year = {2014}
}
