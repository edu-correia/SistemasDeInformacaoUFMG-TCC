@article{10.1145/2422094.2422095,
 abstract = {DNA microarrays are used extensively for biochemical analysis that includes genomics and drug discovery. This increased usage demands large microarrays, thus complicating their computer aided design (CAD) and manufacturing methodologies. One such time-consuming design problem is to minimize the border length of masks used during the manufacture of microarrays. From the manufacturing point of view the border length of masks is one of the crucial parameters determining the reliability of the microarray. This article presents a novel algorithm for synthesis (placement and embedding) of microarrays, which consumes significantly less time than the best algorithm reported in the literature, while maintaining the quality (border length of masks) of the result. The proposed technique uses only a part of each probe to decide on the placement and the remaining parts for deciding on the embedding sequence. This is in contrast to the earlier methods that considered the entire probe for both placement and embedding. The second novelty of the proposed technique is the preclassification (prior to placement and embedding) of probes based on their prefixes. This decreases the complexity of the problem of deciding the next probe to be placed from that involving computation of Hamming distance between all probes (as used in earlier approaches) to the one involving searching of nonempty cells on a constant size grid array. The proposed algorithm is 43\texttimes{} faster than the best reported in the literature for the case of synthesizing a microarray with 250,000 probes and further exhibits linear behavior in terms of computation time for larger microarrays.},
 address = {New York, NY, USA},
 articleno = {1},
 author = {Srinivasan, S. and Kamakoti, V. and Bhattacharya, A.},
 doi = {10.1145/2422094.2422095},
 issn = {1550-4832},
 issue_date = {February 2013},
 journal = {J. Emerg. Technol. Comput. Syst.},
 keyword = {DNA, embedding of microarrays, microarrays, placement of microarrays, synthesis of microarrays},
 month = {February},
 number = {1},
 numpages = {17},
 publisher = {Association for Computing Machinery},
 title = {A Novel Algorithm for Fast Synthesis of DNA Probes on Microarrays},
 url = {https://doi.org/10.1145/2422094.2422095},
 volume = {9},
 year = {2013}
}
