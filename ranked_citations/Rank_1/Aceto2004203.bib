@article{Aceto2004203,
 abstract = {This paper studies nested simulation and nested trace semantics over the language BCCSP, a basic formalism to express finite process behaviour. It is shown that none of these semantics affords finite (in)equational axiomatizations over BCCSP. In particular, for each of the nested semantics studied in this paper, the collection of sound, closed (in)equations over a singleton action set is not finitely based. © 2004 Elsevier Inc. All rights reserved.},
 author = {Aceto, Luca and Fokkink, Wan and Van Glabbeek, Rob and Ingólfsdóttir, Anna},
 doi = {10.1016/j.ic.2004.02.001},
 journal = {Information and Computation},
 note = {Cited by: 25; All Open Access; Green Open Access},
 number = {2},
 pages = {203 - 232},
 publication_stage = {Final},
 source = {Scopus},
 title = {Nested semantics over finite trees are equationally hard},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/2942625706?origin=resultslist},
 volume = {191},
 year = {2004}
}
