@article{Pronichkin2026323,
 abstract = {The article provides a comparative analysis of the strategies for assimilation and optimization of scientific and technological knowledge in the context of heterogeneous industry paradigms: creative accumulation and creative destruction. The results of an interdisciplinary target program in the chemical engineering sphere were selected as a case study. The methodological basis of the work is the synthesis of theories of organizational learning and network analysis for the construction and verification of patent citation networks. Formalized multi-criteria models have been developed that describe the relationship between the processes of reinvestment, formation of added value and the dynamics of intangible assets of participants in interdisciplinary scientific and technical programs. The results of the study demonstrate the need for a differentiated approach to knowledge and investment management depending on the dominant industry model of technological development. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
 author = {Pronichkin, S.V. and Vazirov, Z.K. and Solodov, S.V.},
 doi = {10.1007/978-3-032-22236-7_24},
 journal = {Lecture Notes in Networks and Systems},
 note = {Cited by: 0},
 pages = {323 - 332},
 publication_stage = {Final},
 source = {Scopus},
 title = {Evaluation of Knowledge Optimization Strategies to Absorb Unique Solutions and Various Disciplines},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105040251519?origin=resultslist},
 volume = {1901 LNNS},
