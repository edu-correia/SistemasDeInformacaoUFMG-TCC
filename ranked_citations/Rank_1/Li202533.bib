@conference{Li202533,
 abstract = {Aiming at the problems of difficult to extract key semantic information and insufficient adaptability of multimodal data in complex traffic scenes, this paper proposes an adaptive semantic extraction algorithm based on Conditional Variational Auto-Encoder (CVAE) and Bayesian optimization. The method realizes the automatic perception of the complexity of the traffic scene and the dynamic adjustment of the semantic extraction granularity by introducing the dynamic adjustment network (DAN) and graph attention mechanism. The algorithm adopts Bayesian optimization for efficient joint search of network structure and hyperparameters, which effectively improves the extraction accuracy and robustness of the model in different traffic environments. In the experimental part, two latest semantic extraction related methods, ISSAFE and M-VAE, are selected as the comparison baseline, and their performance is evaluated in a variety of typical traffic scenarios and different input resolutions. The results show that this paper's method significantly outperforms the comparison algorithms in terms of core metrics, such as semantic extraction accuracy and average intersection-merge ratio, and has stronger capability and adaptability in recognizing key features. © 2025 IEEE.},
 author = {Li, Zhuoyin and Liu, Shaojiang and Wan, Zhiping},
 doi = {10.1109/BDAMEA68159.2025.11406450},
 journal = {2025 International Conference on Big Data Applications, Mechatronics Engineering and Automation, BDAMEA 2025},
 note = {Cited by: 0},
 pages = {33 - 38},
 publication_stage = {Final},
 source = {Scopus},
 title = {Adaptive Semantic Extraction Algorithm Based on Conditional Variational Autoencoder and Bayesian Optimization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105036743280?origin=resultslist},
