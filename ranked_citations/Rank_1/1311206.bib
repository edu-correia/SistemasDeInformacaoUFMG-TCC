@inproceedings{1311206,
 abstract = {R-trees, since their introduction in 1984, have been proven to be one of the most well-behaved practical data structures for accommodating dynamic massive sets of geometric objects and conducting a diverse set of queries on such data-sets in real-world applications. In this paper we introduce a new technique for merging two R-trees into a new one of very good quality. Our method avoids both the employment of bulk insertions and the solution of bulk-loading, from scratch, the new tree using the data of the original trees. Additionally, unlike previous approaches, it does not make any assumptions about data-set distributions. Experimental results provide evidence on the runtime efficiency of our method and illustrate the good query performance of the produced indices.},
 author = {Vasaitis, V. and Nanopoulos, A. and Bozanis, P.},
 booktitle = {Proceedings. 16th International Conference on Scientific and Statistical Database Management, 2004.},
 doi = {10.1109/SSDM.2004.1311206},
 issn = {1099-3371},
 keyword = {Merging;Data structures;Informatics;Employment;Runtime;Information systems;Design automation;Very large scale integration;Object detection;Spatial databases},
 month = {June},
 number = {},
 pages = {141-150},
 title = {Merging R-trees},
 volume = {},
 year = {2004}
}
