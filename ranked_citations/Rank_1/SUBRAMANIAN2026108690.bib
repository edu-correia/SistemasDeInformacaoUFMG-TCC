@article{SUBRAMANIAN2026108690,
 abstract = {To mitigate the detrimental effects of heavy metal ions, lead (Pb²⁺) was chosen as the target analyte for sensitive and precise electrochemical detection. This study utilized the synergistic interaction between binary transition-metal oxides and β-cyclodextrin (β-CD) to develop an effective Pb²⁺ sensor. Zinc–manganese oxide (ZnMnO) nanomaterials were synthesized through a hydrothermal method employing different capping and reducing agents as polyvinylpyrrolidone (PVP), sodium hydroxide (NaOH), potassium hydroxide (KOH), and ammonium hydroxide (NH₄OH), under uniform synthesis and calcination conditions to investigate the impact of synthesis chemistry on their structural and morphological development. Among the prepared samples, ZnMnO–PVP demonstrated higher electrochemical performance due to its homogeneous nanosheet shape and improved electron transport properties. As a result, ZnMnO–PVP was combined with β-cyclodextrin to create ZnMnO–PVP/β-CD composite, attributing a synergistic mechanism, by merging the host–guest interaction properties of β-CD, enabling selective preconcentration of Pb2+ at the electrode surface, with ZnMnO-PVP providing a conductive, high-surface-area matrix that promotes rapid electron transfer. A thorough physicochemical analysis verified the effective synthesis and phase purity of the composite, while field-emission scanning electron microscopy (FESEM) demonstrated its distinct sheet-like structure. The ZnMnO–PVP/β-CD composite, used to modify a glassy carbon electrode (GCE), exhibited exceptional analytical performance for Pb²⁺ detection, characterized by superior charge-transfer efficiency, extensive electroactive surface area, and robust electroreduction response. Under optimum experimental circumstances, the ZnMnO–PVP/β-CD/GCE sensor attained an exceptionally low detection limit of 6.8 nM (0.0068 µM) and exhibited a broad linear response range from 0.0149 µM to 599.8 µM. Moreover, its practical applicability was confirmed through successful recovery investigations in tap, pond, and drinking water samples with RSD (3.8%), highlighting its potential for dependable environmental monitoring of lead pollution.},
 author = {Monica Subramanian and Nandini Nataraj and I.-Hsuan Tung and Yu-Chien Lin and Cihun-Siyong Gong and Hsu-Wei Fang and Ren-Jei Chung},
 doi = {https://doi.org/10.1016/j.psep.2026.108690},
 issn = {0957-5820},
 journal = {Process Safety and Environmental Protection},
 keyword = {Binary Metal Oxide, Synthesis Modifiers, Heavy Metals, Lead Detection},
 pages = {108690},
 title = {Reductant-driven structural evolution of zinc manganese oxide integrated beta-cyclodextrin for high-performance heavy metal detection},
 url = {https://www.sciencedirect.com/science/article/pii/S0957582026003071},
 volume = {210},
 year = {2026}
}
