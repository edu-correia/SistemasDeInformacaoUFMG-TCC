 publication_stage = {Final},
 source = {Scopus},
 title = {A Novel Hybrid XGB-RF BlendStack Model for Traffic Flow Prediction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105034070190?origin=resultslist},
 year = {2025}
