@article{5342380,
 abstract = {EasyToy is an industrial plush toy design system for novices. Editable sketching curves combine the advantages of free-form strokes and the controllability of B-spline curves. Users can continuously edit each curve to refine designs. EasyToy provides a small set of simple tools with which users can easily construct sophisticated toy models comparable to those that professional systems produce.},
 author = {Liu, Yong-Jin and Ma, Cui-Xia and Zhang, Dong-Liang},
 doi = {10.1109/MCG.2009.147},
 issn = {1558-1756},
 journal = {IEEE Computer Graphics and Applications},
 keyword = {Toy manufacturing industry;Controllability;Process design;Application software;Personal communication networks;Intelligent structures;Content addressable storage;plush toy design;sketching;computer graphics;graphics and multimedia},
 month = {March},
 number = {2},
 pages = {49-57},
 title = {EasyToy: Plush Toy Design Using Editable Sketching Curves},
 volume = {31},
 year = {2011}
}
