@inproceedings{9951904,
 abstract = {Automated detection represents one of the most important criteria for assessing the condition of the roadway, and it represents a challenging problem for the creation of advanced practices and methods. A large data set that includes complicated surface conditions is necessary for autonomous damage identification utilizing deep convolutional neural network. This study offers a thermal-RGB fusion picture-based sidewalk defect identification method, in which the merged RGB-thermal image is created by different sensor data to accomplish quick and precise defect identification considering complicated pavement circumstances. The suggested technique achieves high sidewalk damage recognition accuracy by using EfficientNet as the foundation structure and creating an argument database. The efficiency of various input information (RGB, thermal, MSX, and fused picture) is tested individually in this article to examine the effects of input information and system on the identification outcomes. The findings demonstrated that the merged image’s degradation detection performance could reach 98.33 percent, and by applying the information after supplementation, the classification method is deemed to be significantly stable to attain 98.33 percent.},
 author = {Vanitha, L. and Kavitha, R. and Panneerselvam, M. and Prathima, Ch and Valantina, G.Mary},
 booktitle = {2022 3rd International Conference on Smart Electronics and Communication (ICOSEC)},
 doi = {10.1109/ICOSEC54921.2022.9951904},
 issn = {},
 keyword = {Degradation;Deep learning;Databases;Thermal sensors;Convolutional neural networks;multi-channel picture fusion;computer vision;differential thermal;and identification of pavement defects},
 month = {Oct},
 number = {},
 pages = {1401-1408},
 title = {A Novel Deep Learning Method for the Identification and Categorization of Footpath Defects based on Thermography},
 volume = {},
 year = {2022}
}
