@article{Wen202034531,
 abstract = {Acquiring all-in-focus images is significant in the multi-media era. Limited by the depth-of-field of the optical lens, it is hard to acquire an image with all targets are clear. One possible solution is to merge the information of a few complementary images in the same scene. In this article, we employ a two-channel convolutional network to derive the clarity map of source images. Then, the clarity map is smoothed by using morphological filtering. Finally, the fusion image is constructed via merging the clear parts of source images. Experimental results prove that our approach has a better performance on both visual quality and quantitative evaluations than many previous fusion approaches. © 2020, Springer Science+Business Media, LLC, part of Springer Nature.},
 author = {Wen, Yu and Yang, Xiaomin and Celik, Turgay and Sushkova, Olga and Albertini, Marcelo Keese},
 doi = {10.1007/s11042-020-08945-z},
 journal = {Multimedia Tools and Applications},
 note = {Cited by: 16},
 number = {45-46},
 pages = {34531 - 34543},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multifocus image fusion using convolutional neural network},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85085114927?origin=resultslist},
 volume = {79},
 year = {2020}
}
