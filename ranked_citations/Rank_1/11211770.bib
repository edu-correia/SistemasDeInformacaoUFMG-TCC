@inproceedings{11211770,
 abstract = {JPEG image compression techniques create blocking artifacts which affects image visual quality negatively. The approach described in this paper implements an efficient deblocking method that relies on YCbCr color space with feed-forward deep convolutional neural network (FFDCNN) to restore compressed images. The proposed computational method processes Y channel data exclusively and preserving Cb and Cr components to achieve the preferred accuracy. The process begins by converting RGB into YCbCr then JPEG compression operates at diverse quality settings before FFDCNN extracts artifacts from the luminance segment. The final step merges refined $\mathbf{Y}$ with unmodified $\mathbf{C b}$ & $\mathbf{C r}$ channels and retransforms to RGB space. Following the luminance channel refinement the method merges it with original chrominance channels before performing RGB color space conversion. The proposed approach demonstrates its capability to eliminate blocking artifacts effectively while maintaining original image appearance which makes it a best solution for practical image processing needs.},
 author = {Balakrishnan, Balamuralitharan and Joseph, L.M.I. Leo and P, Ganesan and Sheeba, Merlin and Aranganathan, A. and Gopukumar, S.T. and Sajiv, G. and Elamaran, V.},
 booktitle = {2025 International Conference on Engineering Innovations and Technologies (ICoEIT)},
 doi = {10.1109/ICoEIT63558.2025.11211770},
 issn = {},
 keyword = {Image quality;Visualization;Technological innovation;Image segmentation;Image coding;Accuracy;Image color analysis;Transform coding;Convolutional neural networks;Image reconstruction;Image Compression;Deblocking;deep convolutional neural network;YCbCr Color Space;Image Quality Metrics},
 month = {July},
 number = {},
 pages = {637-643},
 title = {Efficient YCbCr-Based Deblocking for Compressed Images Using a Feed-Forward Deep Convolutional Neural Network},
 volume = {},
 year = {2025}
}
