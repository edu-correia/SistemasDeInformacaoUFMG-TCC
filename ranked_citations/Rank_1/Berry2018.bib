@article{Berry2018,
 abstract = {Modeling low energy eigenstates of fermionic systems can provide insight into chemical reactions and material properties and is one of the most anticipated applications of quantum computing. We present three techniques for reducing the cost of preparing fermionic Hamiltonian eigenstates using phase estimation. First, we report a polylogarithmic-depth quantum algorithm for antisymmetrizing the initial states required for simulation of fermions in first quantization. This is an exponential improvement over the previous state-of-the-art. Next, we show how to reduce the overhead due to repeated state preparation in phase estimation when the goal is to prepare the ground state to high precision and one has knowledge of an upper bound on the ground state energy that is less than the excited state energy (often the case in quantum chemistry). Finally, we explain how one can perform the time evolution necessary for the phase estimation based preparation of Hamiltonian eigenstates with exactly zero error by using the recently introduced qubitization procedure. © 2018, The Author(s).},
 author = {Berry, Dominic W. and Kieferová, Mária and Scherer, Artur and Sanders, Yuval R. and Low, Guang Hao and Wiebe, Nathan and Gidney, Craig and Babbush, Ryan},
 doi = {10.1038/s41534-018-0071-5},
 journal = {npj Quantum Information},
 note = {Cited by: 117; All Open Access; Gold Open Access; Green Open Access},
 number = {1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improved techniques for preparing eigenstates of fermionic Hamiltonians},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85048031430?origin=resultslist},
 volume = {4},
 year = {2018}
}
