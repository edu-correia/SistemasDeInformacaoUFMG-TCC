@inproceedings{10912601,
 abstract = {In this study, we explore a new strategy aimed at enhancing emergency response operations by integrating various data sources, such as IoT devices, drones, crowdsourced information, and real-time weather data. The uniqueness of our approach lies in its utilization of big data and deep learning technologies to address the challenges that current systems face, particularly in processing and analyzing diverse data in real time. Our proposed platform, collects, analyzes, and merges large data sets efficiently, providing responders with actionable insights when they are needed most. Deep learning models, trained on this data, can predict patterns and suggest optimal response strategies, whether it involves managing resources or determining evacuation routes. Initial findings indicate that this integrated system has the potential to significantly improve the speed and accuracy of emergency responses, ultimately contributing to more effective disaster management and urban resilience.},
 author = {Gacha, Yassine and Abdellatif, Takoua},
 booktitle = {2024 IEEE/ACS 21st International Conference on Computer Systems and Applications (AICCSA)},
 doi = {10.1109/AICCSA63423.2024.10912601},
 issn = {2161-5330},
 keyword = {Deep learning;Soft sensors;Data integration;Big Data;Predictive models;Emergency services;Real-time systems;Internet of Things;Resilience;Meteorology;Emergency response;Intervention;Big Data;Deep learning;Multiple data sources;Data fusion},
 month = {Oct},
 number = {},
 pages = {1-2},
 title = {Real-Time Data Fusion for Optimized Emergency Response},
 volume = {},
 year = {2024}
}
