@article{HAOYING2025111273,
 abstract = {Earthquakes are frequent global natural disasters causing significant losses to urban economies and societies. To accurately evaluate their economic impacts, this paper establishes a comprehensive assessment model encompassing direct and indirect economic losses. The analysis is empirically grounded in historical data from 50 earthquakes over the past 15 years. Drawing from both natural and social sciences, the study develops an indicator system for assessing earthquake economic losses. This system considers factors such as seismic characteristics, regional economy, and building structures. Methodologically, this paper innovatively applies a genetic algorithm to optimize the Backpropagation (BP) neural network for assessing direct economic losses. This approach significantly enhances prediction accuracy and addresses the traditional BP neural network’s tendencies towards local optima and instability. Additionally, an improved input–output model is introduced. By merging traditional sectors, this model quantifies the economic impact of damage to the construction industry on related industries, both on the supply and demand sides. This method offers advantages in data availability, dynamic impact analysis, and industry-level loss decomposition. Results indicate that the proposed assessment model outperforms traditional methods in prediction accuracy and scientific rigor. It provides new tools and methodological support for multidimensional economic loss assessments in earthquake disasters. Furthermore, it holds important reference value for government policies on disaster prevention and mitigation.},
 author = {Zhang Haoying and Pei Jingjing and Qiao Han and Luo Yun},
 doi = {https://doi.org/10.1016/j.cie.2025.111273},
 issn = {0360-8352},
 journal = {Computers & Industrial Engineering},
 keyword = {Seismic disaster, Economic loss, Neural network, Input-output},
 pages = {111273},
 title = {A methodological framework for assessing economic loss in urban seismic disaster},
 url = {https://www.sciencedirect.com/science/article/pii/S036083522500419X},
 volume = {207},
 year = {2025}
}
