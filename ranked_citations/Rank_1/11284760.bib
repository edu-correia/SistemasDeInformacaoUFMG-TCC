@article{11284760,
 abstract = {This article investigates a new substrate-integrated (SI) filtering dielectric resonator antenna (DRA) using a multilayer microwave substrate, avoiding the need for a dielectric block. It deploys dielectric vias, air vias, and metallic vias, along with a square multimode SI waveguide (SIW) cavity to obtain a filtering response. By strategically designing the coupling slots and grounded metallic posts, two cavity TE ${}_{\mathbf {120}}$  and TE ${}_{\mathbf {210}}$  modes are merged with the dielectric resonator (DR) TE ${}^{y}_{1 \delta 1}$  mode to obtain a wide bandwidth. Measured results show that the single-band design has a 10-dB impedance bandwidth of 9.1%, a peak total antenna efficiency of 75%, and a peak realized gain of 5.7 dBi. Its out-of-band suppression level is greater than 18 dB. As compared with existing SIDRAs, our design has the highest stopband suppression level. This article also investigates the first-ever dual-band filtering SIDRA. Its lower band is formed by the cavity TE ${}_{\mathbf {110}}$  mode, DR TE ${}^{y}_{1 \delta 1}$  mode, and a mode associated with a U-slot, while the upper band is created using two DRA-loaded cavity modes. A pair of shorted stubs is also introduced to enhance the roll-off in the lowest stopband. The dual-band design obtains measured impedance bandwidths of 11.3% and 6.1% for the lower and upper bands, respectively. They are suitable for wireless communication systems requiring a planar structure.},
 author = {Zhang, Shi-Xuan and Leung, Kwok Wa and Ingolf Kremer, Hauke},
 doi = {10.1109/TAP.2025.3639505},
 issn = {1558-2221},
 journal = {IEEE Transactions on Antennas and Propagation},
 keyword = {Filtering;Dielectrics;Substrates;Dual band;Dielectric resonator antennas;Microwave filters;Dielectric constant;Microstrip filters;Microwave circuits;Wireless communication;Dielectric resonator antenna (DRA);dielectric vias;dual-band DRA;filtering antenna;substrate-integrated (SI) DRA (SIDRA)},
 month = {Feb},
 number = {2},
 pages = {1414-1426},
 title = {Single-/Dual-Band Filtering Substrate-Integrated Dielectric Resonator Antennas},
 volume = {74},
 year = {2026}
}
