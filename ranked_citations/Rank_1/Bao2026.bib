@article{Bao2026,
 abstract = {Pneumonia recognition is a key task in medical imaging, aiming to accurately detect pneumonia from chest X-rays. However, deep learning approaches face significant challenges in limited generalisation capabilities and excessive computational costs. Specifically within medical imaging, data heterogeneity and models consuming substantial computational power directly threaten the universal reliability and clinical usability of diagnostics. To alleviate the problem, this paper proposes a Transformer-based Efficient Network (TEN) built upon the self-attention mechanism of the Swin Transformer for pneumonia detection. Specifically, a data augmentation strategy is initially employed to enrich the diversity of the dataset and improve the generalization of the model. Based on the expanded data, the Message (MSG) token and the hard distillation network with teacher-student guidance are then introduced to reduce the complexity of the Swin Transformer and ensure its performance. The MSG token facilitates effective information transfer between local windows, thereby avoiding the computational cost associated with traditional SW-MSA. In addition, by training with the hard labels of the teacher’s model and again combining label smoothing and the cross-entropy loss function, the student model not only learns stronger feature extraction ability from the teacher’s model, but also is able to avoid the overfitting phenomenon due to insufficient data volume. Extensive experiments demonstrate that the TEN model achieves 92.39% accuracy on the three-class classification task and 94.94% on the binary classification task in the Chest X-Ray dataset, outperforming multiple state-of-the-art models. Ablation studies further validate the effectiveness of each component, highlighting the model’s superiority. Our code is publicly available at: https://github.com/Noel-X/TEN-.git. © The Author(s), under exclusive licence to Springer-Verlag London Ltd., part of Springer Nature 2026.},
 author = {Bao, Yunxue and Wang, Wenjun and Zhao, Lu and Wu, Heng and Zheng, Zijun and Lv, Laishui and Bardou, Dalal},
 doi = {10.1007/s10044-026-01637-8},
