@inproceedings{7387430,
 abstract = {Having 10X higher data rate than 4G mobile which is already in a few hundred Mbps, 5G mobile, which is said to be commercialized in 2020, presents a sounding challenge to implementation of ICs used in 5G mobile devices. 5G mobile is expected to embrace some new technologies. Developing millimeter wave RF IC with cost and power consumption that could meet requirement of a mobile device is something that has not been done well so far. New link schemes like full duplex present implementation issues given high transmitting power in cellular system. Integration of distributed radio and merging of different cellular and non-cellular standards add more to complexity of design. In the presentation proposed 5G requirement is presented and some key IC implementation challenges for 5G mobile devices are described.},
 author = {Li, Leo},
 booktitle = {2015 IEEE Asian Solid-State Circuits Conference (A-SSCC)},
 doi = {10.1109/ASSCC.2015.7387430},
 issn = {},
 keyword = {5G mobile communication;OFDM;Bandwidth;Millimeter wave technology;Wireless communication;Broadband communication;5G;RAT;multimode;millimeter wave;energy efficiency;process technology;Moore's law},
 month = {Nov},
 number = {},
 pages = {1-4},
 title = {IC challenges in 5G},
 volume = {},
 year = {2015}
}
