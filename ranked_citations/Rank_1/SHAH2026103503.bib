@article{SHAH2026103503,
 abstract = {Electronic medical records (EMRs) play a critical role in modern healthcare systems, with accurate medical transcription driving effective decision-making and patient care. However, predicting medical specialties based on imbalanced medical transcript data remains a significant challenge, impeding timely and precise healthcare delivery. This work presents a data fusion framework that enhances medical specialty classification in EMRs, focusing on addressing class imbalance and leveraging advanced machine learning techniques. To address class imbalance, this study proposes a novel grouping approach that merges 40 medical specialties into 18 semantically coherent categories using shared domain-specific keywords. The method maintains clinical relevance while enhancing classification robustness. The framework integrates feature engineering to optimize data insights and feature relevance. The classification process incorporates advanced bidirectional encoder representations from transformers (BERT) models, demonstrating superior performance in natural language processing (NLP) tasks. Experimental analysis reveals that BioBERT achieves better accuracy in specialty classification, outperforming other BERT variants. The framework also explores fastai library using ULMFiT, demonstrating stronger classification potential with minimal tuning, suitable for real-world medical applications. The study also demonstrates the effectiveness of SMOTE and edited nearest neighbour (SMOTEENN), a combined oversampling and undersampling technique, in mitigating class imbalance. By integrating multi-sensor data fusion techniques and leveraging cutting-edge models, this work provides a robust framework for improving medical specialty classification, enabling smarter healthcare applications. The findings offer valuable insights into early diagnosis, personalized care, and improved patient outcomes, making significant strides in advancing healthcare through data-driven technologies.},
 author = {Khadija Akbar Shah and Zahid Halim and Sajid Anwar and Chung-Chian Hsu and Imad Rida},
 doi = {https://doi.org/10.1016/j.inffus.2025.103503},
 issn = {1566-2535},
 journal = {Information Fusion},
 keyword = {Electronic medical records, Medical specialty classification, Class imbalance mitigation, Multi-sensor data fusion, Natural language processing},
 pages = {103503},
 title = {Multi-sensor data fusion for smart healthcare: optimizing specialty-based classification of imbalanced EMRs},
 url = {https://www.sciencedirect.com/science/article/pii/S1566253525005755},
 volume = {125},
 year = {2026}
}
