@article{SRIPRATEEP2026111583,
 abstract = {Semiconductor manufacturing networks face escalating complexity driven by volatile demand cycles, stringent carbon regulations, and pervasive supply uncertainty. Conventional planning approaches struggle to address the interplay between sustainability mandates and operational resilience in these globally dispersed, high-stakes supply chains. This study presents an AI-driven hybrid optimisation framework for Sustainable and Resilient Semiconductor Manufacturing Supply Chains, integrating Deep Reinforcement Learning and Generative Adversarial Learning within a Fuzzy Multi-Objective Programming paradigm. We formulate a Fuzzy Resilient Carbon-Constrained Supply Chain Optimisation (F-RCC-SSCO) model that minimises total life-cycle cost, delivery makespan, and CO2 emissions, while satisfying circular-economy requirements for e-waste recycling and strict carbon caps. Epistemic uncertainty is systematically embedded using triangular fuzzy numbers. To efficiently explore and refine this high-dimensional solution space, we propose DRL-GRNet, a hybrid AI framework that couples a multi-head actor–critic agent for scalable solution generation with a fuzzy-aware Wasserstein GAN with gradient penalty and structured noise (WGAN-GP+) for diversity-driven refinement. Computational experiments on a Southeast Asian semiconductor manufacturing network with over 380,000 decision variables demonstrate that DRL-GRNet outperforms NSGA-II, MOEA/D-DE, and DRL-IMVO, achieving hypervolume gains up to +29.8 %, Pareto-generation efficiency improvements of +44.6 %, and a 47.6 % reduction in distribution-stability index across α-cuts. Scenario-based disruption analysis confirms ≥95 % feasibility under adverse conditions, and stakeholder-guided TOPSIS ranking highlights the framework’s adaptability to dynamic cost, time, and sustainability priorities. The results position DRL-GRNet as a scalable, resilient, and transferable AI optimisation strategy for decarbonising semiconductor manufacturing supply chains operating under deep uncertainty and global competition.},
 author = {Keartisak Sriprateep and Rapeepan Pitakaso and Surajet Khonjun and Prem Enkvetchakul and Ganokgarn Jirasirilerd and Sarayut Gonwirat},
 doi = {https://doi.org/10.1016/j.cie.2025.111583},
 issn = {0360-8352},
 journal = {Computers & Industrial Engineering},
 keyword = {Semiconductor manufacturing, Fuzzy multi-objective optimisation, Deep reinforcement learning, AI-driven supply chain optimisation, Sustainable and resilient operations},
 pages = {111583},
 title = {Sustainable and resilient semiconductor supply chain optimization via hybrid deep reinforcement and generative learning},
 url = {https://www.sciencedirect.com/science/article/pii/S0360835225007296},
 volume = {211},
 year = {2026}
}
