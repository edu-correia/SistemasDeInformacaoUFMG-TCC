@article{10.1016/j.csda.2015.02.009,
 abstract = {Acyclic probabilistic finite automata (APFA) constitute a rich family of models for discrete longitudinal data. An APFA may be represented as a directed multigraph, and embodies a set of context-specific conditional independence relations that may be read off the graph. A model selection algorithm to minimize a penalized likelihood criterion such as AIC or BIC is described. This algorithm is compared to one implemented in Beagle, a widely used program for processing genomic data, both in terms of rate of convergence to the true model as the sample size increases, and a goodness-of-fit measure assessed using cross-validation. The comparisons are based on three data sets, two from molecular genetics and one from social science. The proposed algorithm performs at least as well as the algorithm in Beagle in both respects. We introduce APFA as graphical models for discrete longitudinal data.We propose a novel model selection algorithm based on penalized likelihood.We compare its rate of convergence and goodness-of-fit to Beagle.We use data from molecular genetics and social science in the comparisons.Our algorithm performs as least as well or better than the algorithm in Beagle.},
 address = {NLD},
 author = {Ankinakatte, Smitha and Edwards, David},
 doi = {10.1016/j.csda.2015.02.009},
 issn = {0167-9473},
 issue_date = {August 2015},
 journal = {Comput. Stat. Data Anal.},
 keyword = {Acyclic probabilistic finite automata, Context-specific graphical model, Discrete longitudinal data, State merging},
 month = {August},
 number = {C},
 numpages = {13},
 pages = {40–52},
 publisher = {Elsevier Science Publishers B. V.},
 title = {Modelling discrete longitudinal data using acyclic probabilistic finite automata},
 url = {https://doi.org/10.1016/j.csda.2015.02.009},
 volume = {88},
 year = {2015}
}
