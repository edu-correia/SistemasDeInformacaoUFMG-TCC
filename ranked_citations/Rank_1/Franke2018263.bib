@article{Franke2018263,
 abstract = {Privacy-preserving record linkage (PPRL) supports the integration of person-related data from different sources while protecting the privacy of individuals by encoding sensitive information needed for linkage. The use of encoded data makes it challenging to achieve high linkage quality in particular for dirty data containing errors or inconsistencies. Moreover, person-related data is often dense, e.g., due to frequent names or addresses, leading to high similarities for non-matches. Both effects are hard to deal with in common PPRL approaches that rely on a simple threshold-based classification to decide whether a record pair is considered to match. In particular, dirty or dense data likely lead to many multi-links where persons are wrongly linked to more than one other person. Therefore, we propose the use of post-processing methods for resolving multi-links and outline three possible approaches. In our evaluation using large synthetic and real datasets we compare these approaches with each other and show that applying post-processing is highly beneficial and can significantly increase linkage quality in terms of both precision and F-measure. © Springer Nature Switzerland AG 2018.},
 author = {Franke, Martin and Sehili, Ziad and Gladbach, Marcel and Rahm, Erhard},
 doi = {10.1007/978-3-030-00305-0_19},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 12},
 pages = {263 - 278},
 publication_stage = {Final},
 source = {Scopus},
 title = {Post-processing Methods for High Quality Privacy-Preserving Record Linkage},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85062844958?origin=resultslist},
 volume = {11025 LNCS},
 year = {2018}
}
