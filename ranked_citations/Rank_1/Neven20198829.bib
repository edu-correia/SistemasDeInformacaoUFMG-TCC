@conference{Neven20198829,
 abstract = {Current state-of-the-art instance segmentation methods are not suited for real-time applications like autonomous driving, which require fast execution times at high accuracy. Although the currently dominant proposal-based methods have high accuracy, they are slow and generate masks at a fixed and low resolution. Proposal-free methods, by contrast, can generate masks at high resolution and are often faster, but fail to reach the same accuracy as the proposal-based methods. In this work we propose a new clustering loss function for proposal-free instance segmentation. The loss function pulls the spatial embeddings of pixels belonging to the same instance together and jointly learns an instance-specific clustering bandwidth, maximizing the intersection-over-union of the resulting instance mask. When combined with a fast architecture, the network can perform instance segmentation in real-time while maintaining a high accuracy. We evaluate our method on the challenging Cityscapes benchmark and achieve top results (5% improvement over Mask R-CNN) at more than 10 fps on 2MP images. © 2019 IEEE.},
 author = {Neven, Davy and Brabandere, Bert De and Proesmans, Marc and Van Gool, Luc},
 doi = {10.1109/CVPR.2019.00904},
 journal = {Proceedings of the IEEE Computer Society Conference on Computer Vision and Pattern Recognition},
 note = {Cited by: 230; All Open Access; Green Open Access},
 pages = {8829 - 8837},
 publication_stage = {Final},
 source = {Scopus},
 title = {Instance segmentation by jointly optimizing spatial embeddings and clustering bandwidth},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85078723759?origin=resultslist},
 volume = {2019-June},
 year = {2019}
}
