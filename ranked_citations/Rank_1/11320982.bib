@article{11320982,
 abstract = {This article presents a compact variable-gain phase shifter (VGPS) that incorporates both a merged phase-shifted attenuator (ATT) and a merged attenuated phase shifter (PS) unit. The merged phase-shifted ATT achieves an additional phase-shifting capability using a modified switched  $\pi $ -type ATT structure, while the merged attenuated PS provides an additional attenuation function based on revised high-pass/low-pass or high-pass/direct-pass PS topologies. The proposed VGPS achieves a bidirectional 20.5-dB gain control range and a 360° phase control range with a 0.5-dB gain step and 5.625° phase step in standard 65 nm CMOS technology. Measurement results demonstrate a maximum root mean squares (rms) phase error of 3.3° and a maximum rms amplitude error of 0.37 dB across the 33–37 GHz. The fully passive circuit exhibits high linearity, featuring a minimum input 1-dB compression point (IP1dB) of 11.1 dBm. The core size is 0.27 mm2 excluding pads.},
 author = {Wu, Shiwei and Pan, Dongfang and Zhao, Hongliang and Cheng, Lin},
 doi = {10.1109/LMWT.2025.3648319},
 issn = {2771-9588},
 journal = {IEEE Microwave and Wireless Technology Letters},
 keyword = {Gain;Attenuation;Phase shifters;Immune system;Transistors;Switching circuits;Phased arrays;Linearity;Wireless communication;Resistors;Attenuator (ATT);CMOS;Ka-band;phase shifter (PS);variable amplitude},
 month = {April},
 number = {4},
 pages = {613-616},
 title = {A Ka-Band Variable-Gain Phase Shifter Using a Merged Phase-Shifted and Attenuated Unit},
 volume = {36},
 year = {2026}
}
