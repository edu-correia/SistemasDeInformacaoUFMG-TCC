@article{Xiang2023118,
 abstract = {In this paper, we want to strengthen an autonomous vehicle’s lane-change ability with limited lane changes performed by the autonomous system. In other words, our task is bootstrapping the predictability of lane-change feasibility for the autonomous vehicle. Unfortunately, autonomous lane changes happen much less frequently in autonomous runs than in manual-driving runs. Augmented runs serve well in terms of data augmentation: the number of samples generated from augmented runs in a single one is comparable with that of samples retrieved from real runs in a month. In this paper, we formulate the Lane-Change Feasibility Prediction problem and also propose a data-driven learning approach to solve it. Experimental results are also presented to show the effectiveness of learned lane-change patterns for the decision making. © 2023, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Xiang, Xiang},
 doi = {10.1007/978-3-031-25069-9_9},
 journal = {Lecture Notes in Computer Science},
 note = {Cited by: 0},
 pages = {118 - 130},
 publication_stage = {Final},
 source = {Scopus},
 title = {Bootstrapping Autonomous Lane Changes with Self-supervised Augmented Runs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85151055206?origin=resultslist},
 volume = {13804 LNCS},
 year = {2023}
}
