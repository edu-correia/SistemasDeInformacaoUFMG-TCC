@article{Hui2025,
 abstract = {In recent years, Graph Neural Networks (GNNs) have gained significant attention as an effective approach in the field of document key information extraction. However, existing research introduces a significant amount of negative edges in their graph construction strategies, leading to a severe class-imbalance problem in relation extraction tasks. Additionally, popular GNNs usually regard all neighbor nodes as having the same weight during message passing, potentially resulting in the loss of critical information. To address these issues, we propose SEG-Doc: a simple yet efficient graph neural networks framework for document key information extraction. Firstly, the Text Histogram-based Graph Construction module (THGC) utilizes text histogram feature to determine the edge set during graph construction. Our strategy not only balances the positive and negative edge samples but also captures key–value relationships more effectively. Secondly, we propose the Layout Attention Mechanism (LAM), which computes layout attention between nodes and their neighbors to assign different weights during message passing. This mechanism assists GNNs in learning richer node representations and mitigating the impact of noise on network updates. We evaluated the effectiveness of SEG-Doc on three benchmark datasets: FUNSD, SROIE and RVL-CDIP. Comprehensive experiments demonstrate that the proposed SEG-Doc achieves state-of-the-art performance than competitive baselines on several public downstream benchmarks. © 2025 Elsevier B.V.},
 author = {Hui, Yangyang and Liu, Jiahao and Zhang, Qi and Zhou, Tianyi and Song, Yonghong},
 doi = {10.1016/j.neucom.2025.130493},
 journal = {Neurocomputing},
