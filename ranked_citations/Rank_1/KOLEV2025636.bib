@incollection{KOLEV2025636,
 abstract = {Forensic medicine in Bulgaria is a well-developed and recognized medical specialty with a history dating back to the 19th century, evolving concurrently with European forensic medicine. The country has a robust network of forensic units, conducting forensic pathology, clinical forensic medicine, and specialized laboratory analyses, including DNA and toxicological examinations. Forensic medicine, taught to medical and dental students, is also available for law and police students. Embedded in Bulgarian legislation, it upholds human rights. Currently, about 65 forensic doctors are practicing, with some nearing retirement age, highlighting the need for better funding, motivation, and continued specialization in this essential field.},
 address = {Oxford},
 author = {Yanko Georgiev Kolev},
 booktitle = {Encyclopedia of Forensic and Legal Medicine (Third Edition)},
 doi = {https://doi.org/10.1016/B978-0-443-21441-7.00233-8},
 edition = {Third Edition},
 editor = {Jason Payne-James and Roger W. Byard},
 isbn = {978-0-443-21442-4},
 keyword = {Bulgaria, Forensic medicine, History, Legal medicine, Medico-legal examination, Organization, Regulations, Roles, Specialty recognition, Statutes},
 pages = {636-641},
 publisher = {Elsevier},
 title = {Forensic & Legal Medicine in Bulgaria},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443214417002338},
 year = {2025}
}
