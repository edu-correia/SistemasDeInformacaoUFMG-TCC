@conference{Farooqui201672,
 abstract = {Over a distinguished career, Regents Professor Karsten Schwan has made significant contributions across a diverse array of topics in computer systems, including operating systems for multi-core platforms, virtualization technologies, enterprise middleware, and high-performance computing. In this paper, we summarize his legacy of key research contributions in general-purpose GPU computing. His vision encompassed the conceptualization, implementation, and demonstration of systems abstractions and runtime methods to elevate GPUs into first-class citizens in today's and future heterogeneous computing environments. To this end, his contributions include novel scheduling and resource management abstractions, runtime specialization, and novel data management techniques to support scalable, distributed GPU frameworks. © 2016 ACM.},
 author = {Farooqui, Naila},
 doi = {10.1145/2884045.2884057},
 journal = {9th Workshop on General Purpose Processing using GPUs, GPGPU 2016 - Proceedings},
 note = {Cited by: 1},
 pages = {72 - 81},
 publication_stage = {Final},
 source = {Scopus},
 title = {A systems perspective on GPU computing: A tribute to Karsten Schwan},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84966668596?origin=resultslist},
 year = {2016}
}
