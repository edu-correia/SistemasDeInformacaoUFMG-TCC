@conference{Ren2019101,
 abstract = {Aiming at the problem that the fixed warning threshold of the general time to collision (TTC) algorithm causes premature warning in low speed driving and delayed warning in high speed driving, this paper proposes a vehicle collision avoidance time warning calculation model based on driving speed. The relevant system can obtain the vehicle's motion state information. The method in this paper will continuously obtain the safe collision avoidance time and the actual collision time of the vehicle. In case of danger, the system reminds the driver to take braking measures in time. Finally, the effectiveness of the model is verified by simulation experiments, which improves the safety of vehicles and provides a reference for early warning of vehicles. © 2019 IEEE.},
 author = {Ren, Bin and Ren, Jinlong},
 doi = {10.1109/AUTEEE48671.2019.9033418},
 journal = {Proceedings of 2019 IEEE 2nd International Conference on Automation, Electronics and Electrical Engineering, AUTEEE 2019},
 note = {Cited by: 5},
 pages = {101 - 104},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on calculation model of vehicle collision avoidance based on safe collision time},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85083168958?origin=resultslist},
 year = {2019}
}
