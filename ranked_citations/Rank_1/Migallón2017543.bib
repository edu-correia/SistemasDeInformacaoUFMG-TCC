@article{Migallón2017543,
 abstract = {The new video coding standard HEVC includes two concepts that allow to partition a frame into regions that can be independently encoded and decoded. These two concepts are named “Tiles” and “Slices”. In this paper, we present and analyze optimized parallel versions of the HEVC encoder based on tile and slice partitioning. We have evaluated the benefits and drawbacks of both approaches in terms of computational times and rate distortion performance. The results show that both approaches obtain good speed-ups, being the parallel version based on tiles the one that obtains the best trade-off between speed-up achieved (up to 9.3×) and rate distortion performance loss (1.6% BD rate for AI mode and 2.2% for LB mode on average). © 2016, Springer Science+Business Media New York.},
 author = {Migallón, H. and Piñol, P. and López-Granado, O. and Galiano, V. and Malumbres, M.P.},
 doi = {10.1007/s11227-016-1911-8},
 journal = {Journal of Supercomputing},
 note = {Cited by: 2},
 number = {1},
 pages = {543 - 556},
 publication_stage = {Final},
 source = {Scopus},
 title = {Performance analysis of frame partitioning in parallel HEVC encoders},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84994795062?origin=resultslist},
 volume = {73},
 year = {2017}
}
