@conference{Mirarchi201813,
 abstract = {The research provides a practical case study to demonstrate how clients can derive value from digital information technologies and technics devoted to the management of data and information with reference to Facility Management (FM) and Asset Management (AM) activities. During the study, public assets of around 450 buildings in a municipality were analysed over a two-year time-frame. The public body acts both as client and as asset manager, facilitating the study of interactions between the two phases that is usually hindered due to the fragmentation of the subjects involved. This study demonstrates in the first instance the value of an effective information management process and secondly possible impacts and value areas of KM in building information modelling-based FM and AM. The case study presented can help clients understanding the value of information and knowledge management technologies and techniques in current asset interventions and/or in the development of future projects. © 2018 Taylor & Francis Group, London.},
 author = {Mirarchi, C. and Pinti, L. and Munir, M. and Bonelli, S. and Brizzolari, A. and Kiviniemi, A.},
 doi = {10.1201/9780429506215-2},
 journal = {eWork and eBusiness in Architecture, Engineering and Construction - Proceedings of the 12th European Conference on Product and Process Modelling, ECPPM 2018},
 note = {Cited by: 4; All Open Access; Green Open Access},
 pages = {13 - 20},
 publication_stage = {Final},
 source = {Scopus},
 title = {Understand the value of knowledge management in a virtual asset management environment},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85074050991?origin=resultslist},
 year = {2018}
}
