 publication_stage = {Final},
 source = {Scopus},
 title = {The sound of emotions: an artificial intelligence approach to predicting emotions from musical selections},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105033803777?origin=resultslist},
