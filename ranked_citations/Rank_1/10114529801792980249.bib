@article{10.1145/2980179.2980249,
 abstract = {We analyze the dense matching problem for Internet scene images based on the fact that commonly only part of images can be matched due to the variation of view angle, motion, objects, etc. We thus propose regional foremost matching to reject outlier matching points while still producing dense high-quality correspondence in the remaining foremost regions. Our system initializes sparse correspondence, propagates matching with model fitting and optimization, and detects foremost regions robustly. We apply our method to several applications, including time-lapse sequence generation, Internet photo composition, automatic image morphing, and automatic rephotography.},
 address = {New York, NY, USA},
 articleno = {178},
 author = {Shen, Xiaoyong and Tao, Xin and Zhou, Chao and Gao, Hongyun and Jia, Jiaya},
 doi = {10.1145/2980179.2980249},
 issn = {0730-0301},
 issue_date = {November 2016},
 journal = {ACM Trans. Graph.},
 keyword = {alignment, image matching, internet images, registration, time-lapse images},
 month = {December},
 number = {6},
 numpages = {12},
 publisher = {Association for Computing Machinery},
 title = {Regional foremost matching for internet scene images},
 url = {https://doi.org/10.1145/2980179.2980249},
 volume = {35},
 year = {2016}
}
