@article{Lee20212999,
 abstract = {GPU-accelerated database systems have been studied for more than 10 years, ranging from prototyping development to industry products serving in multiple domains of data applications. Existing GPU database research solutions are often focused on specific aspects in parallel algorithms and system implementations for specific features, while industry product development generally concentrates on delivering a whole system by considering its holistic performance and cost. Aiming to fill this gap between academic research and industry development, we present a comprehensive industry product study on a complete CPU/GPU HTAP system, called RateupDB. We firmly believe “the art of balance" addresses major issues in the development of RateupDB. Specifically, we consider balancing multiple factors in the software development cycle, such as the trade-off between OLAP and OLTP, the trade-off between system performance and development productivity, and balanced choices of algorithms in the product. We also present RateupDB’s complete TPC-H test performance to demonstrate its significant advantages over other existing GPU DBMS products. © The authors.},
 author = {Lee, Rubao and Zhou, Minghong and Li, Chi and Hu, Shenggang and Teng, Jianping and Li, Dongyang and Zhang, Xiaodong},
 doi = {10.14778/3476311.3476378},
 journal = {Proceedings of the VLDB Endowment},
 note = {Cited by: 43},
 number = {12},
 pages = {2999 - 3013},
 publication_stage = {Final},
 source = {Scopus},
 title = {The art of balance: a rateupdbtm experience of building a cpu/gpu hybrid database product},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85119992326?origin=resultslist},
 volume = {14},
 year = {2021}
}
