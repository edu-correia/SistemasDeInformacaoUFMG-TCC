@article{7368946,
 abstract = {A compact waveguide polarization rotator, able to turn the polarization plane by an arbitrary angle, is proposed. Its operational principle is based on a strong electromagnetic coupling between two conjugated quadruple-slot planar-chiral irises in a square waveguide by the below cutoff modes. The physical interpretation for the observed phenomenon is provided based on the analysis of the eigenoscillations of such a D4 symmetrical object considered as an open waveguide resonator. It is demonstrated that there exist two perfect matching points controlled by the iris geometry and width of the narrow gap between two planar chiral components. The reported unit has a bandwidth of several percent with return loss better than 20-30 dB. The conclusions of this work are fully applicable to double-periodical two-layer screens or metasurfaces having such square cells.},
 author = {Kolmakova, Nataliya and Prikolotin, Sergey and Perov, Andrey and Derkach, Vadim and Kirilenko, Anatoliy},
 doi = {10.1109/TMTT.2015.2509966},
 issn = {1557-9670},
 journal = {IEEE Transactions on Microwave Theory and Techniques},
 keyword = {Polarization;Planar waveguides;Waveguide discontinuities;Optical waveguides;Mirrors;Couplings;Below cutoff modes;eigenoscillations;optical activity;polarization rotator;quadruple-slot irises},
 month = {Feb},
 number = {2},
 pages = {429-435},
 title = {Polarization Plane Rotation by Arbitrary Angle Using ${ D}_{4}$ Symmetrical Structures},
 volume = {64},
 year = {2016}
}
