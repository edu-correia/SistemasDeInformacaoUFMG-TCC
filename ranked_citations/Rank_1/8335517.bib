@inproceedings{8335517,
 abstract = {In order to improve the spectral efficiency and reliability of communication systems, both the multiple-input multiple-output (MIMO) technique and non-binary low-density parity-check (NB-LDPC) codes are considered as powerful tools to meet the requirements. In order to further optimize the MIMO NB-LDPC systems and adapt to massive MIMO scenarios, a new joint detection and decoding (JDD) method of massive MIMO with NB-LDPC codes, called layered graph-merged detection and decoding (GMDD), is proposed. In this paper, factor graphs associated to symbol-based belief propagation (BP) MIMO detection and NB-LDPC decoding are merged into a single graph. For massive MIMO condition, a MIMO detection graph is attached to several NB-LDPC decoding graphs, which makes the methods unique to existed ones. Compared with separated detection and decoding (SDD), for BER less than 5 × 10−2 the proposed method can achieve nearly 7 dB gain with same or even fewer iterations. Corresponding hardware architecture and complexity analysis are also given in this paper.},
 author = {Jing, Shusen and Yang, Junmei and Zhou, Huayi and Ueng, Yeong-Luh and You, Xiaohu and Zhang, Chuan},
 booktitle = {2017 51st Asilomar Conference on Signals, Systems, and Computers},
 doi = {10.1109/ACSSC.2017.8335517},
 issn = {2576-2303},
 keyword = {MIMO communication;Iterative decoding;Complexity theory;Decoding;Bit error rate;Detectors;Massive MIMO detection;NB-LDPC codes;belief propagation;joint detection and decoding;factor graph},
 month = {Oct},
 number = {},
 pages = {1084-1088},
 title = {Layered graph-merged detection and decoding of non-binary LDPC coded massive MIMO systems},
 volume = {},
 year = {2017}
}
