@article{11450429,
 abstract = {Magnetoresistive random-access memory (MRAM) based ternary content addressable memory (TCAM) is a promising candidate for applications in the Internet of things (IoTs) and embedded systems. However, it remains vulnerable to emerging security threats such as side-channel attacks and data tampering. This work proposes a dual-mode soft physical unclonable function (PUF) based on a 4T2M TCAM architecture, leveraging the intrinsic resistance mismatch within the TCAM array. The proposed design eliminates the need for traditional data migration by adopting a non-destructive readout scheme. To further improve efficiency, the system incorporates the dual-mode hamming weight clustering (DM-HWC) algorithm with hash indexing for optimized challenge-response address generation. Simulation results in 65 nm CMOS process show that the PUF's quantization circuitry introduces only 203 additional transistors (3.4% area overhead). The PUF achieves 49.9%/50.1% inter-chip hamming Distance, passes NIST SP 800-22 randomness tests, and provides a 6.86× speedup in address clustering (3.23×10-5 s vs 2.21×10-4 s) for 32×32 arrays.},
 author = {Ren, Shimao and Wang, Pengjun and Chen, Bo and Chen, Zhenhong},
 doi = {10.23919/ICS.2026.3676378},
 issn = {2995-1976},
 journal = {Integrated Circuits and Systems},
 keyword = {Computer architecture;Microprocessors;Security;Physical unclonable function;Arrays;Magnetic tunneling;Resistance;Integrated circuits;Internet of Things;Power demand;PUF;hardware security;TCAM;MRAM},
 month = {},
 number = {},
 pages = {1-9},
 title = {Destruction-Free Soft PUF Architecture: Merging Security and Efficiency in 4T2M TCAM Without Data Migration},
 volume = {},
 year = {2026}
}
