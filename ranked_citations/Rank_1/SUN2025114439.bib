@article{SUN2025114439,
 abstract = {Ammonia has low reactivity, making it difficult to induce a detonation wave even after partially cracked. In this work, numerical simulations incorporating detailed chemistry are conducted to study the detonation initiation and propagation features in non-uniformly cracked ammonia and air mixtures, aiming to reduce the critical initiation energy (EC) for the low-cracking-ratio ammonia. First, EC under different ammonia cracking ratios (κ) in uniform mixture is calculated. It shows that EC increases rapidly as κ decreases, and the critical initiation energy is extremely high for low-cracking-ratio ammonia. Then, an indirect detonation initiation method, which utilizes a detonation wave propagating in the transition zone of non-uniformly cracked ammonia, is proposed. The effectiveness of this indirect initiation method is validated by simulations of pulsating/cellular detonation waves, and the influence of transition zone length and ammonia cracking ratio is evaluated. The results indicate that the proposed method can efficiently initiate detonation in the low-cracking-ratio ammonia with smaller initiation energy. As κ decreases, a longer transition zone is required to sustain the detonation propagation without decoupling. Additionally, two typical transition modes are identified, and detailed wave structures are analyzed. Specifically, long transition zones enable smooth detonation transitions, where small detonation cells grow into larger ones via merging and termination of triple-point trajectories. For short transition zones, the detonation wave quenches, followed by the formation of new reaction fronts due to wave interactions, which then reinitiate the detonation. Mixture reactivity across the transition zone determines the detonation transition process. As the transition zone length increases, the reactivity gradient within the zone decreases, allowing the underdriven detonation wave to compress the local mixture for ignition when entering the transition zone, resulting in smooth detonation structure evolution without decoupling.},
 author = {Jie Sun and Yicun Wang and Salim M. Shaik and Huangwei Zhang},
 doi = {https://doi.org/10.1016/j.combustflame.2025.114439},
 issn = {0010-2180},
 journal = {Combustion and Flame},
 keyword = {Ammonia, Detonation, Critical initiation energy, Non-uniform mixture, Ammonia cracking ratio},
 pages = {114439},
 title = {Numerical investigation of detonation initiation and propagation in non-uniformly cracked ammonia and air mixtures},
 url = {https://www.sciencedirect.com/science/article/pii/S0010218025004766},
 volume = {281},
 year = {2025}
}
