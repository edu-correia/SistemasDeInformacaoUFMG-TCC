@inproceedings{11453783,
 abstract = {The research that is being proposed is about a Hybrid Convolutional Neural Network (CNN) model that can provide highly accurate diagnostic results for Retinoblastoma through the use of retinal fundus imaging. The approach merges different pretrained CNN models, namely Res-Net, Dense-net, and Mobile-net, into a single model which boosts the diagnostic accuracy by providing the extraction of complementary spatial and structural features of the retinal images. Moreover, the systematic implementation of transfer learning and sophisticated data augmentation techniques will not only be helpful in dealing with the limited size of medical datasets and the matter of class disparity but also in assuring the model's generalization to various image samples. The facsimile's presentation was determined using stratified data splits for both training and validation, with the help of evaluation metrics such as accuracy, precision, recall, F1-score, and AUC which are very important factors. The use of explicable AI tools like GradCAM and SHAP will greatly assist in demystifying the regions that have an impact on model predictions while at the same time fostering clinical interpretability and trust. The deployment of the system is done via the Stream-lit web framework which offers an interactive and easy-to-use interface where clinicians and researchers can upload retinal scans, see prediction probabilities, and simultaneously access heat-mapped explanations of the results. The combined approach of hybrid deep learning and Stream-lit integration is meant to be a great help to ophthalmologists for early detection of Retinoblastoma, it will save time in the manual screening process and also increase the reliability of automated medical image analysis.},
 author = {P, Usha and M, Sathish Kumar T and S, Suruthi and S, Ranjith Kumar B and T, Pavithra and M, Magudeshwaran},
 booktitle = {2026 8th International Conference on Intelligent Sustainable Systems (ICISS)},
 doi = {10.1109/ICISS67859.2026.11453783},
 issn = {},
 keyword = {Training;Accuracy;Systematics;Error analysis;Transfer learning;Streaming media;Retina;Feature extraction;Convolutional neural networks;Medical diagnostic imaging;Hybrid Convolutional Neural Network (CNN);Retinoblastoma Detection;Explainable Artificial Intelligence (XAI);Retinal Fundus Imaging},
 month = {March},
