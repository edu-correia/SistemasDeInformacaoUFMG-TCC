@article{MielesBravo2025_894,
 abstract = {Abstract Hybrid nodes of concrete beams and secondary steel beams cause disturbance and reductions in the load-bearing capacity of the cross-section, which can be compensated for by using suspension stirrups in the node area. These elements allow cracking to be controlled and redirect loads from the tension area to the compression zone, significantly improving the overall strength of the assembly. The stress-strain study, conducted using Abaqus software, supports experimental observations by providing insight into the stress trajectories. This integration with the cracking study led to the formulation of a structural model based on the strut-and-tie model, which was applied to the design of the structural node. A procedure is also proposed for calculating the structural capacity of reinforced concrete beams with hybrid connections and suspended stirrups, based on the theoretical strength of the reinforced concrete beam’s cross-section.},
 author = {Mieles-Bravo, Yordy and Zambrano-Baque, Gema},
 doi = {10.15446/dyna.v92n239.118639},
 number = {239},
 pages = {139--149},
 title = {Methods for determining the structural strength of reinforced concrete beams with hybrid nodes},
 volume = {92},
 year = {2025}
}
