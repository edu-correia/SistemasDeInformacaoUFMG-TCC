@inproceedings{10796615,
 abstract = {The single image dehazing task has been a popular challenge, and image dehazing methods are mainly categorized into traditional prior-based methods and modern learning-based methods. Learning-based methods provide stronger robustness than traditional priori-based methods. Therefore, we improves the AECR-Net model based on the excellent defogging effect, and the improvement aspects include updating the use of DCN module, optimizing the DFE module to introduce the upstream dynamically extracted feature information to merge with the central feature extraction information on the channel. On the idea of CR comparison regularization of AECR-Net, we further propose to use the pre-trained Vision Transformer model to build the CR regularization module, i.e., ViT-CR. Vision Transformer provides a stronger ability to extract global and local information of the image than VGG model. We found through experiments that the improved AECR-Net model outperforms the original AECR-Net model both quantitatively and qualitatively, and the PSNR and SSIM metrics are significantly improved on the SOTS indoor test dataset.},
 author = {Song, Xiangshuai and Dai, Jinping and Fu, Zhipeng and Tan, Daohong},
 booktitle = {2024 IEEE 6th International Conference on Power, Intelligent Computing and Systems (ICPICS)},
 doi = {10.1109/ICPICS62053.2024.10796615},
 issn = {2834-8567},
 keyword = {Measurement;Learning systems;Computer vision;Semantics;Predictive models;Feature extraction;Transformers;Vectors;Data mining;Spatial resolution;image dehazing;AECR-Net;DCN;optimized DFE;dynamic extraction;ViT-CR;Vision Transformer},
 month = {July},
 number = {},
 pages = {1428-1436},
 title = {Optimization Improvement of AECR-NET Image Dehazing Network},
