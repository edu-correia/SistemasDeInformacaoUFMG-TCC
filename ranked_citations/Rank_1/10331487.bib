@inproceedings{10331487,
 abstract = {Peer-to-peer (P2P) lenders face regulatory, compliance, application, and data security risks. A complete methodology that includes more than statistical and economic methods is needed to conduct credit assessments effectively. This study uses systematic literature network analysis and artificial intelligence to comprehend risk management in P2P lending financial technology. This study suggests that explainable AI (XAI) is better at identifying, analyzing, and evaluating financial industry risks, including financial technology. This is done through human agency, monitoring, transparency, and accountability. The LIME Framework and SHAP Value are widely used machine learning frameworks for data integration to speed up and improve credit score analysis using bank-like criteria. Thus, machine learning is expected to be used to develop a precise and rational individual credit evaluation system in peer-to-peer lending to improve credit risk supervision and forecasting while reducing default risk.},
 author = {Arifah, Ika Diyah Candra and Nihaya, Ina Uswatun},
 booktitle = {2023 6th International Conference of Computer and Informatics Engineering (IC2IE)},
 doi = {10.1109/IC2IE60547.2023.10331487},
 issn = {},
 keyword = {Systematics;Merging;Machine learning;Network analyzers;Peer-to-peer computing;Risk management;Informatics;credit risk;peer-to-peer lending;artificial intelligence},
 month = {Sep.},
 number = {},
 pages = {329-334},
 title = {Artificial Intelligence in Credit Risk Management of Peer-to-Peer Lending Financial Technology: Systematic Literature Review},
 volume = {},
 year = {2023}
}
