@conference{Wang2025923,
 abstract = {This work focuses on the feature learning of time series with dominant cycles. At present, the decomposition structure of mainstream linear models mainly adopts a single scale decomposition model. The most classic DLinear and RLinear models have far less ability to capture strong periodic data sets than other deep learning models. This is because the traditional linear models are too simplified because they use fuzzy and single scales to segment and aggregate time patterns. According to this common defect, we propose the Dominant Period Multi Kernel Decomposition (DPMD) to use the cycle core for timing extraction instead. On the whole, first convert the time-domain sequence to the Fourier domain to obtain the dominant frequency and corresponding dominant period, form a parallel multi-scale multi-channel decomposition path for each dominant period, and merge the parallel results using trainable weights. Based on the above technical ideas, we provide empirical results and comparative evaluation, which show that this method is highly competitive in many time series tasks, and even reaches the most advanced level in some cases. © 2025 IEEE.},
 author = {Wang, Jiaheng and Zhang, Qi and Zhang, Xingrui and Mao, Yujun and Zhu, Ziyang and Gong, Cheng},
 doi = {10.1109/ICAIRC68035.2025.11384889},
 journal = {2025 5th International Conference on Artificial Intelligence, Robotics, and Communication, ICAIRC 2025},
 note = {Cited by: 0},
 pages = {923 - 927},
 publication_stage = {Final},
 source = {Scopus},
 title = {Dominant Period Multi-Kernel Decomposition Linear for Long Sequence Time-Series Forecasting},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105034714313?origin=resultslist},
