@article{10478329,
 abstract = {Code acquisition is the kernel operation for signal synchronization in the spread-spectrum receiver. To reduce the computational complexity and latency of code acquisition, this paper proposes an efficient scheme employing sparse Fourier transform (SFT) and the relevant hardware architecture for field programmable gate array (FPGA) and application-specific integrated circuit (ASIC) implementation. Efforts are made at both the algorithmic level and the implementation level to enable merged searching of code phase and Doppler frequency without incurring massive hardware expenditure. Compared with the existing code acquisition approaches, it is shown from theoretical analysis and experimental results that the proposed design can shorten processing latency and reduce hardware complexity without degrading the acquisition probability.},
 author = {Zhang, Chen and Wang, Jian and Fan, Guangteng and Tian, Shiwei},
 doi = {10.23919/JSEE.2024.000015},
 issn = {1004-4132},
 journal = {Journal of Systems Engineering and Electronics},
 keyword = {Codes;Doppler effect;Hardware;Field programmable gate arrays;Estimation;Systems engineering and theory;Synchronization;code acquisition;hardware structure;sparse Fourier transform (SFT);code phase estimation;Doppler frequency estimation},
 month = {October},
 number = {5},
 pages = {1063-1072},
 title = {Design and Implementation of Code Acquisition Using Sparse Fourier Transform},
 volume = {35},
 year = {2024}
}
