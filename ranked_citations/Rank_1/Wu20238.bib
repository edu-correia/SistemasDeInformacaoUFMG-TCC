@conference{Wu20238,
 abstract = {3D point cloud processing is a crucial component of artificial intelligence for environment perception and analysis. 3D point clouds are generated by LiDAR, they possess the characteristics of large data volumes, disorderliness, and discreteness, which also pose challenges in point cloud processing. This paper presents a new panoptic segmentation solution LASNet, consisting of two modules: semantic segmentation and instance segmentation. The semantic segmentation module employs a lightweight feature extractor and attention pooling. In the instance segmentation module, this paper proposes an SCBGK clustering algorithm that can work better in uneven density outdoor scene point clouds. © 2023 ACM.},
 author = {Wu, Chaoqun and Chen, Min and Song, Wei},
 doi = {10.1145/3617695.3617713},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 0},
 pages = {8 - 14},
 publication_stage = {Final},
 source = {Scopus},
 title = {LASNet Light Feature Encoder and SCBGK algorithm for Panoptic segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85180123369?origin=resultslist},
 year = {2023}
}
