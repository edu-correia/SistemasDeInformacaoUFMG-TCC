@conference{Esa2025,
 abstract = {US centralized digital identification systems, such as those using Social Security Numbers (SSNs), are vulnerable to data breaches and synthetic identity fraud, costing $8.8 billion annually. This study presents an Ethereum-based decentralized identity management platform to address these issues. Ethereum's smart contracts create and manage tamper-proof digital identities, known as Decentralized Identifiers (DIDs) and Verifiable Credentials (VCs), which allow users to securely prove their identity without revealing sensitive information. Zero-knowledge proofs (zk-SNARKs) validate credentials without revealing personal information, ensuring privacy. The framework uses Layer 2 solutions like Optimistic Rollups to batch-process transactions off-chain before finishing them on Ethereum to save transaction costs and enhance scalability. The design allows Ethereum wallet users to adjust data-sharing permissions in accordance with U.S. laws such the California Consumer Privacy Act (CCPA). The technology is tested in a simulated case study targeting synthetic identity fraud in tax filings, a $2.3 billion annual U.S. concern. On Ethereum's Goerli testnet, we assessed 10,000 synthetic identities and achieved 95% fraud detection (a 25% improvement over centralized systems) and 40% transaction cost reduction through Layer 2 optimizations. The system resists Sybil attacks with Proof-of Humanity checks and immutable audit trails for regulatory transparency. Ethereum-based identity management solutions can balance privacy, cost effectiveness, and compliance, offering a scalable alternative to obsolete centralized models. The approach gives consumers data ownership, helps authorities uncover fraud, and gives U.S. officials and industry relevant insights. Future research will examine Ethereum's post-Merge improvements to improve scalability and interoperability. © 2025 IEEE.},
 author = {Esa, Hammed and Dhar, Sweety Rani and Bhuiyan, Md Fakhrul Hasan and Ferdousmou, Jannatul and Imran, Md Ahsan Ullah and Debnath, Anupom and Johora, Fatema Tuz and Hassan, Ali},
 doi = {10.1109/ICECET63943.2025.11472520},
 journal = {International Conference on Electrical, Computer, and Energy Technologies, ICECET 2025},
