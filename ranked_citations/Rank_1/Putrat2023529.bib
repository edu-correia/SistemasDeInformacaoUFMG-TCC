@conference{Putrat2023529,
 abstract = {In recent years, there has been an increasing interest in incorporating blockchain for the Internet of Things (IoT) to address the inherent issues of IoT, such as single point of failure and data silos. However, blockchain alone cannot ascertain the authenticity and veracity of the data coming from IoT devices. The append-only nature of blockchain exacerbates this issue, as it would not be possible to alter the data once recorded on-chain. Trust and Reputation Management (TRM) is an effective approach to overcome the aforementioned trust issues. However, designing TRM frameworks for blockchain-enabled IoT applications is a non-trivial task, as each application has its unique trust challenges with their unique features and requirements. In this paper, we present our experiences in designing TRM framework for various blockchain-enabled IoT applications to provide insights and highlight open research challenges for future opportunities. © 2023 IEEE.},
 author = {Putrat, Guntur Dharma and Malik, Sidra and Dedeoglu, Volkan and Kanhere, Salil S. and Jurdak, Raja},
 doi = {10.1109/COMSNETS56262.2023.10041348},
 journal = {2023 15th International Conference on COMmunication Systems and NETworkS, COMSNETS 2023},
 note = {Cited by: 14},
 pages = {529 - 536},
 publication_stage = {Final},
 source = {Scopus},
 title = {Trust and Reputation Management for Blockchain-enabled IoT},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85149110175?origin=resultslist},
 year = {2023}
}
