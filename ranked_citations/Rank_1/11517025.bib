@inproceedings{11517025,
 abstract = {This paper presents LLG-SPICE, a unified circuit model for simulating planar magnetics with material physics properties. By merging (1) the nonlinear Landau–Lifshitz–Gilbert (LLG) model for magnetic B-H hysteresis with (2) the linear Maxwell equation model for current distribution, a modular and scalable framework was created to describe the mutual correlations between the current distribution among winding stacks and the nonlinear material hysteretic characteristics. The LLG-SPICE model opens the possibility of designing and simulating high-order passive networks with coupled planar magnetic structures. It enables rapid evaluation of complex planar magnetic structures with strongly correlated circuit- and material-level behaviors, and facilitates systematic magnetic-circuit co-design for extreme miniaturization and sophisticated functions in high-performance power electronics systems.},
 author = {Grigoryan, Davit and Cui, Han and Chen, Minjie},
 booktitle = {2026 IEEE Applied Power Electronics Conference and Exposition (APEC)},
 doi = {10.1109/APEC51134.2026.11517025},
 issn = {2470-6647},
 keyword = {Modeling;Joining processes;Windings;SPICE;Printing;Circuits;Wind;Materials;Current distribution;Current;Landau–Lifshitz–Gilbert model;planar magnetics;lumped circuit model;current distribution;hysteresis},
 month = {March},
 number = {},
 pages = {1796-1801},
 title = {LLG-SPICE: A Unified Model for Simulating Planar Magnetics with Material Physics Properties},
 volume = {},
 year = {2026}
}
