@conference{Panasyuk2025,
 abstract = {Automated detection of persuasion techniques is crucial for combating disinformation, but is hindered by the lack of large, high-quality labeled datasets, especially for less common techniques. This paper introduces SynthClassify, a novel framework and several large-scale synthetic datasets for advancing research in this area. SynthClassify uses a cyclic process: a GPT-4 based generator creates text designed to promote or minimize specific institutions using one of 23 persuasion techniques, and an ensemble of GPT-4 classifiers assesses the text's alignment with the intended technique. This iterative process, guided by a confidence threshold, achieves high-quality synthetic data without expensive manual annotation. The resulting dataset contains 634K instances across 19 countries and nearly 10K institutions. The dataset has been translated into six additional languages (Arabic, Chinese, French, Hindi, Russian, and Spanish), enabling cross-lingual research. We benchmark SynthClassify against multiple LLMs, including open-source models. We also explore the impact of prompt engineering, ensemble size, and confidence thresholds on classifier performance. © 2025 SPIE. All rights reserved.},
 author = {Panasyuk, Aleksey},
 doi = {10.1117/12.3052408},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {SynthClassify: An LLM-Driven Framework for Generating and Classifying Persuasive Text},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105007283903?origin=resultslist},
 volume = {13480},
