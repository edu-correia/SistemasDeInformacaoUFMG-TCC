@conference{Pintore20251976,
 abstract = {We introduce a novel deep-learning approach for predicting complex indoor floor plans with ceiling heights from a minimal set of registered 360° images of cluttered rooms. Leveraging the broad contextual information available in a single panoramic image and the availability of annotated training datasets of room layouts, a transformer-based neural network predicts a geometric representation of each room's architectural structure, excluding furniture and objects, and projects it on a horizontal plane (the Nadir plane) to estimate the disoccluded floor area and the ceiling heights. We then merge and process these Nadir representations on the same floor plan, using a deformable attention transformer that exploits mutual information to resolve structural occlusions and complete room reconstruction. This fully datadriven solution achieves state-of-the-art results on synthetic and real-world datasets with a minimal number of input images.  © 2025 IEEE.},
 author = {Pintore, Giovanni and Shah, Uzair and Agus, Marco and Gobbetti, Enrico},
 doi = {10.1109/CVPRW67362.2025.00186},
 journal = {IEEE Computer Society Conference on Computer Vision and Pattern Recognition Workshops},
 note = {Cited by: 3},
 pages = {1976 - 1985},
 publication_stage = {Final},
 source = {Scopus},
 title = {Nadirfloornet: Reconstructing Multi-Room Floorplans from a Small Set of Registered Panoramic Images},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105017843792?origin=resultslist},
 year = {2025}
}
