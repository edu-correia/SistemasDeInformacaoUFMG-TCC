@article{IULA2026128597,
 abstract = {In recent years, emerging contaminants in water, such as pesticides and pharmaceuticals, have gained significant attention, underscoring the need for innovative purification and monitoring solutions. Diclofenac, a widely used nonsteroidal anti-inflammatory drug, has become an important environmental contaminant due to its widespread use and the poor efficiency of conventional wastewater treatment systems. This study focuses on the development of an innovative all-in-one 3D printed device for small-scale monitoring and remediation of emerging contaminants such as diclofenac, with the potential to be adapted to others as well. The main novelty of this work lies in the design of a compact and portable platform that not only enables the detection of diclofenac in real time but also assesses the quality of its remediation. The 3D-printed device integrates a flexible, screen-printed sensor on a polyester substrate for diclofenac detection, along with recycled cellulose acetate particles functionalized with activated carbon (20 % w/w) as the remediation material. Combining electrochemical sensing technologies with a lightweight and cost-effective three-dimensional configuration, the platform offers a highly efficient and easy-to-use solution for monitoring and optimizing remediation processes. The device provides real-time feedback on diclofenac concentrations, evaluating remediation efficiency under practical, real-world conditions. Results showed that the all-in-one platform achieved a detection limit for diclofenac of 0.1 μM and demonstrated a remediation efficiency of about 53 %. This innovative 3D system represents a significant advance in the industry, offering a versatile and scalable solution to improve the management of pharmaceutical contaminants in water resources, with broader applications for various emerging pollutants.},
 author = {Gabriella Iula and Ada Raucci and Lorenzo Antonelli and Panagiota M. Kalligosfyri and Massimo Giuseppe {De Cesaris} and Nina Felli and Concetta Di Natale and Stefano Cinti and Alessandra Gentili},
 doi = {https://doi.org/10.1016/j.talanta.2025.128597},
 issn = {0039-9140},
 journal = {Talanta},
 keyword = {3D-printing, Sensing device, Remediation, Contaminants, Electroanalysis},
 pages = {128597},
 title = {Smart and sustainable 3D-printed electrochemical device for diclofenac remediation and monitoring in water},
 url = {https://www.sciencedirect.com/science/article/pii/S0039914025010872},
 volume = {297},
 year = {2026}
}
