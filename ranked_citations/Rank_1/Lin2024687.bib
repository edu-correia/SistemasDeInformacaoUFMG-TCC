 publication_stage = {Final},
 source = {Scopus},
 title = {MGRF: MULTI-GRAPH RECOMMENDATION FRAMEWORK WITH HETEROGENEOUS AND HOMOGENEOUS GRAPH ITERATIVE FUSION},
