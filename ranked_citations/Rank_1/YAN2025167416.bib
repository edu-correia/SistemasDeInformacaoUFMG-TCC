@article{YAN2025167416,
 abstract = {Perovskite solar cells (PSCs) are advancing as core components for energy-generating windows in building-integrated photovoltaics (BIPV), merging customizable aesthetics with sustainable power production. This review device engineering with optical management strategies of semi-transparent and colorful PSCs for BIPV application that achieve dual functionality through regulating active layer transparency and optical interference between multiple layers to controlled light behavior. Critical strategies center on perovskite bandgap tuning for intrinsic layer color, island microstructures for transmissive hue, and multilayer optical interference for reflective chromatic control. The balance between optically tunable properties and power conversion efficiency in devices was also analyzed. Furthermore, scalability challenges in microstructural fabrication and stabilization of multilayer architectures for practical BIPV integration are discussed. Aesthetically adaptable PSC windows demonstrate transformative potential in transforming buildings into active energy assets without compromising architectural vision.},
 author = {Nan Yan and Fan Yang and Yang Cao and Jiafan Zhang and Meidan Que and Bo Li and Yun Tang and Shengzhong (Frank) Liu and Jiangshan Feng},
 doi = {https://doi.org/10.1016/j.cej.2025.167416},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Building integrated photovoltaics, Semitransparent solar cells, Perovskite solar cells, Optical engineering, Adjustable aesthetics},
 pages = {167416},
 title = {Energy-generating windows integrating aesthetically tunable perovskite solar cells for customizable BIPV applications},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894725082555},
 volume = {522},
 year = {2025}
}
