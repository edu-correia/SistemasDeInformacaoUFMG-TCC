@article{Tsai2020309,
 abstract = {Efficiently processing sparse matrices is a central and performance-critical part of many scientific simulation codes. Recognizing the adoption of manycore accelerators in HPC, we evaluate in this paper the performance of the currently best sparse matrix-vector product (SpMV) implementations on high-end GPUs from AMD and NVIDIA. Specifically, we optimize SpMV kernels for the CSR, COO, ELL, and HYB format taking the hardware characteristics of the latest GPU technologies into account. We compare for 2,800 test matrices the performance of our kernels against AMD’s hipSPARSE library and NVIDIA’s cuSPARSE library, and ultimately assess how the GPU technologies from AMD and NVIDIA compare in terms of SpMV performance. © Springer Nature Switzerland AG 2020.},
 author = {Tsai, Yuhsiang M. and Cojean, Terry and Anzt, Hartwig},
 doi = {10.1007/978-3-030-50743-5_16},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 17; All Open Access; Bronze Open Access; Green Open Access},
 pages = {309 - 327},
 publication_stage = {Final},
 source = {Scopus},
 title = {Sparse linear Algebra on AMD and NVIDIA GPUs – The Race Is On},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85087011739?origin=resultslist},
 volume = {12151 LNCS},
 year = {2020}
}
