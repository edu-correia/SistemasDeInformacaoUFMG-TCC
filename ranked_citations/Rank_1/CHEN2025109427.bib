@article{CHEN2025109427,
 abstract = {To elucidate the coupling relationship between the Marangoni and Rayleigh-Bénard effects, a finite element model was developed to simulate mass transfer between two planar liquid layers, validated through Schlieren and DPIV experiments. A comparative numerical analysis was conducted under three modes: pure Marangoni (PM), pure Rayleigh-Bénard (PRB), and coupled mode (CM). The results indicate that the characteristic convection structures under PM, PRB, and CM are Marangoni convection cells, needle-plumes, and toe-plumes, respectively. In the CM, the Rayleigh-Bénard effect deformed the initial Marangoni convection cells longitudinally, forming toe-plumes. The Marangoni effect predominantly influences the interface, facilitating the merging of RBM convection, while the Rayleigh-Bénard effect impacts bulk, delaying the formation of RBM convection but enhancing its downward motion. The Marangoni effect significantly enhances mass transfer, contributing approximately 102 times more than the Rayleigh-Bénard effect. Initially, the Rayleigh-Bénard effect reduces mass transfer but eventually synergizes with the Marangoni effect to enhance it. Moreover, the influence of the Rayleigh-Bénard effect intensifies with higher initial solute concentrations.},
 author = {Jun Chen and Xiangdong Liu and Yongping Chen and Qiang Chen},
 doi = {https://doi.org/10.1016/j.icheatmasstransfer.2025.109427},
 issn = {0735-1933},
 journal = {International Communications in Heat and Mass Transfer},
 keyword = {Mass transfer, Marangoni effect, Rayleigh-Bénard effect, Coupling relationship},
 pages = {109427},
 title = {Analysis of coupling relationship between Marangoni and Rayleigh-Bénard effects in Rayleigh-Bénard-Marangoni convection during mass transfer between two planar liquid layers},
 url = {https://www.sciencedirect.com/science/article/pii/S073519332500853X},
 volume = {168},
 year = {2025}
}
