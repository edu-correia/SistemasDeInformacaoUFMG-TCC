 abstract = {With the continuous improvement of China's scientific and technological level in recent years, the monitoring technology has achieved significant development, so it has been widely used in many fields, such as large shopping malls, offices, banks and enterprises. Combined with the actual situation, the effect of the traditional safety monitoring system is relatively poor, and the monitoring is mainly carried out in a human way, resulting in the relevant data interaction ability can not meet the actual needs. In this paper, a new secure interactive system of video surveillance data is designed for the secure interaction of video surveillance data. By using boosting algorithm to process dynamic video images, users can obtain more effective video data. The cleaned video data is shared through the blockchain platform. In the blockchain network, the video is encrypted through the encryption algorithm, and the data is decrypted through the decryption algorithm, so that the video data provides a security level in the sharing process. Experiments show that the sharing rate of video data and the degree of confidentiality of data between different regions are relatively high, which realizes the sharing and encryption of data transmission process and greatly improves the security performance of video surveillance data interaction. Therefore, it is necessary to study and design the interactive ability and data sharing ability of the current video surveillance system. © 2023 IEEE.},
 author = {Li, Yongfeng},
 doi = {10.1109/CSNT57126.2023.10134670},
 journal = {Proceedings - 2023 12th IEEE International Conference on Communication Systems and Network Technologies, CSNT 2023},
 note = {Cited by: 0},
 pages = {720 - 727},
