@article{XU2026109412,
 abstract = {The current Mach Zehnder (MZI) fiber strain sensors increase strain sensitivity while also increasing temperature sensitivity, thereby increasing the impact of temperature crosstalk on strain detection. To solve this problem, this article proposes a high-sensitivity and low temperature crosstalk fiber MZI strain sensor. By using a carbon dioxide laser to etch a long groove on the cladding of a single-mode fiber, and then heating the long groove area, a fiber MZI strain sensor with an n-type core structure is fabricated. When the sensor is subjected to axial strain, the offset distance of the fiber core from the axis gradually decreases with the increase of stress, resulting in the positions of the beam splitting and merging points of the transmitted light gradually approaching each other, and the length of the sensing area decreases. By significantly changing the change in the length of the sensing area, high-sensitivity and low-temperature crosstalk fiber MZI strain sensing can be achieved. The experimental results indicate that the strain sensitivity of the sensor is as high as -49.88 pm/με, and the temperature strain cross sensitivity is only 0.676 με/ °C. This article provides a new method for reducing temperature crosstalk by changing the length of the sensing area during the strain process to achieve strain sensitization without increasing temperature sensitivity. It is expected to be applied in fields such as high-speed rail tracks and oil and gas pipelines.},
 author = {Chenyu Xu and Chunlan Liu and Yong Wei and Chao Guo and Zhihai Liu},
 doi = {https://doi.org/10.1016/j.optlaseng.2025.109412},
 issn = {0143-8166},
 journal = {Optics and Lasers in Engineering},
 keyword = {High sensitivity strain sensor grating, Low temperature crosstalk, Length of the sensing area, N-type fiber core structure},
 pages = {109412},
 title = {High sensitivity fiber MZI strain sensor with low temperature crosstalk},
 url = {https://www.sciencedirect.com/science/article/pii/S0143816625005974},
 volume = {196},
 year = {2026}
}
