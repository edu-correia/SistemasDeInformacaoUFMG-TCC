@article{10.1145/3359136,
 abstract = {Information system designers embed values into the systems they design, even if unwittingly. However, the values embedded in many information systems clash with values held by many sustainability communities. This research focuses on two grassroots sustainable agriculture communities, which are seeking to develop a food infrastructure that is under their own control, and thereby more resilient to disruptions across the globe. This paper presents a five-year ethnographic study of these two communities, maps out the values of members of these communities, and explores the implications of their values on the information systems that members use and that could be developed to support them in the future. By doing so, we hope to influence the design of future information systems to align more closely with the values of these stakeholders, and through these stakeholders to move toward a food system that supports food security and global sustainability.},
 address = {New York, NY, USA},
 articleno = {34},
 author = {Norton, Juliet and Penzenstadler, Birgit and Tomlinson, Bill},
 doi = {10.1145/3359136},
 issue_date = {November 2019},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {HCI, agriculture, information systems, limits, permaculture, sustainability, values},
 month = {November},
 number = {CSCW},
 numpages = {22},
 publisher = {Association for Computing Machinery},
 title = {Implications of Grassroots Sustainable Agriculture Community Values on the Design of Information Systems},
 url = {https://doi.org/10.1145/3359136},
 volume = {3},
 year = {2019}
}
