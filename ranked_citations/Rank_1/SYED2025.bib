@incollection{SYED2025,
 abstract = {This article highlights the essential features of Urdu phonology. Urdu and Hindi have different scripts but share many similar characteristics. Urdu uses Arabic diacritics to represent vowel sounds in written form. It is rich in consonant sounds taken from various languages. This article claims that some consonant sounds are merged into one consonant sound in the speech of the young generation of Urdu native speakers. It has 9 basic vowels and 37 consonants. There is the least tendency for diphthongs in Urdu. Nasality has a phonemic role in Urdu. Urdu has a syllabification with light, heavy, and superheavy structures. Sonority sequence generalization is very frequently violated in consonant clusters. The standard dialect of Urdu in Pakistan is spoken in Karachi.},
 author = {Nasir Abbas Syed and Syed Alamdar Nabi},
 booktitle = {Reference Module in Social Sciences},
 doi = {https://doi.org/10.1016/B978-0-323-95504-1.00718-3},
 isbn = {978-0-443-15785-1},
 keyword = {Consonants, Clusters, Dialect, Diphthong, Nasality, Sonority, Stress, Syllable, Orthography, Urdu, Vowels},
 publisher = {Elsevier},
 title = {Urdu Phonology},
 url = {https://www.sciencedirect.com/science/article/pii/B9780323955041007183},
 year = {2025}
}
