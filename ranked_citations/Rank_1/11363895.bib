@inproceedings{11363895,
 abstract = {Integrating accelerators like Coarse-Grained Reconfigurable Arrays (CGRAs) with modern out-of-order (OoO) superscalar CPUs presents a significant challenge. Traditional loose-coupling methods introduce high synchronization overheads that create a serialization point in the pipeline. This fundamentally conflicts with the OoO core's ability to hide latency, neutralizing its performance advantages. To address this integration bottleneck, this paper introduces the In-Pipeline Reconfigurable Processor (IPRP), a novel architecture that deeply embeds a CGRA as a set of first-class functional units within the OoO CPU's execution stage. Our evaluation demonstrates that IPRP achieves a 3.1× speedup over the baseline SonicBOOM CPU on the MachSuite benchmarks. We analyzed workloads with mixed CPU and CGRA computation to isolate the benefit of our integration strategy. IPRP delivers a performance uplift of up to 1.7× over an equivalent loosely-coupled CGRA in these scenarios. This demonstrates that IPRP's primary contribution lies in overcoming the limitations of conventional integration, effectively merging CPU flexibility with accelerator efficiency.},
 author = {Zhang, Zhengyi and Yang, Sijing and Chen, Sichao and Dai, Yuan and Yin, Wenbo and Wang, Lingli},
 booktitle = {2025 International Conference on Field Programmable Technology (ICFPT)},
 doi = {10.1109/ICFPT67023.2025.00034},
 issn = {2837-0449},
 keyword = {Out of order;Pipelines;Merging;Computer architecture;Benchmark testing;Synchronization;Computer crime;CGRA (Coarse-Grained Reconfigurable Array);CPU Architecture;Pipeline;Reconfigurable Computing},
 month = {Dec},
 number = {},
 pages = {207-210},
 title = {Hacking the Pipeline: Enabling Fine-Grain Reconfigurable Acceleration within CPU Cores},
 volume = {},
 year = {2025}
}
