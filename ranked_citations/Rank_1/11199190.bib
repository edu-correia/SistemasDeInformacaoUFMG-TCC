@inproceedings{11199190,
 abstract = {Real-time handwritten digit recognition is vital for applications including automated form processing, postal code interpretation, and banking systems. This paper introduces a deep learning method utilizing a Convolutional Neural Network (CNN) trained on a mix of the MNIST dataset and a real-world handwritten digit dataset featuring over 20,000 samples sourced from Kaggle. The model is created with comprehensive preprocessing and data augmentation strategies such as rotation, zoom, and shifting to improve its robustness and generalization across diverse writing styles. The implementation encompasses real-time image capturing, thorough training, and evaluation employing tools like TensorFlow and Keras. A comparative analysis with traditional models such as SVM and KNN emphasizes CNN’s superior performance concerning accuracy, loss, and training duration. A feedback-driven improvement method further enhances the model by learning from user-reported misclassifications, thus boosting adaptability over time. Through this research, we provide a scalable and intelligent digit recognition system designed for real-time application.},
 author = {M S, Sowmya and Reddy, C. Nitheesh Kumar and Siddhartha, G. and Vardhan, D. Guru Venkata Vishnu and Reddy, E. Snehith Siddharth},
 booktitle = {2025 World Skills Conference on Universal Data Analytics and Sciences (WorldSUAS)},
 doi = {10.1109/WorldSUAS66815.2025.11199190},
 issn = {},
 keyword = {Training;Deep learning;Handwriting recognition;Adaptation models;Image recognition;Writing;Nearest neighbor methods;Real-time systems;Robustness;Convolutional neural networks;Artificial Intelligence;Machine Learning;Handwritten Digit Recognition;Convolutional Neural Networks (CNN);Image Classification;Deep Learning;Real-time Systems},
 month = {Aug},
 number = {},
 pages = {1-9},
 title = {Composite Method for Printed Written Number Identification},
 volume = {},
