@inproceedings{11322475,
 abstract = {This work presents a compact, low-power temperature sensor with a native spiking output, suitable for integration in neuromorphic and event-driven systems. Unlike conventional approaches that rely on analog front ends, comparators, or ADCs to digitize temperature, the proposed circuit merges sensing and encoding by directly proposing tunable proportional-to-absolute-temperature (PTAT) sensing. The tunable PTAT voltage is applied to a single adjustable Schmitt trigger, which generates spikes only when the temperature deviates by a programmable threshold $\Delta T$, enabling event-driven operation with minimal static energy overhead. Implemented in a 45 nm CMOS process with a 1 V supply, the design consumes 650 nW of power. Simulated results demonstrate correct spiking across 0° C to 80° C with $\Delta \mathrm{T}$ steps of a few degrees Celsius, while maintaining robustness under process and mismatch variations. The entire system occupies a small footprint of $\text{1 0 0} \mu \mathrm{m}^{\mathrm{2}}$.},
 author = {Nawito, Moustafa},
 booktitle = {2025 37th International Conference on Microelectronics (ICM)},
 doi = {10.1109/ICM66518.2025.11322475},
 issn = {2159-1679},
 keyword = {Temperature sensors;Neuromorphics;CMOS process;Encoding;Threshold voltage;Robustness;Sensors;Microelectronics;temperature to spike encoding;tunable PTAT sensor;tunable Schmitt trigger;neuromorphic applications;$\Delta T$-Triggered sensor},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {A $\Delta \mathrm{T}$-Triggered Spiking Temperature Sensor for Neuromorphic and Edge Applications},
 volume = {},
 year = {2025}
}
