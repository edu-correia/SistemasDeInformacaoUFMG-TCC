@article{JIANG2026112163,
 abstract = {The over-wing-nacelle (OWN) concept offers a promising solution for integrating ultra-high bypass ratio engines into Hybrid-Wing-Body (HWB) aircraft. However, traditional nacelle integration inevitably results in negative aerodynamic interference, including the formation of local pressure peaks, adverse pressure gradients, and early onset of flow separation, all of which lead to increased drag. To address this issue, this study numerically investigates the interference mechanism and proposes a mitigation strategy for the trailing-edge OWN under cruise conditions for an HWB configuration with four turbofan engines. Staggered and parallel layouts of traditional OWN were constructed to first analyze the integration effects. Subsequently, a Conjoined Nacelle Configuration (CJNC) is proposed to mitigate adverse aerodynamic interference. The results demonstrate that in staggered nacelle layouts, contraction-expansion channels generate intense shock waves. In parallel nacelle layouts, similar flow channels form, accelerating the flow and causing shock wave-boundary layer interactions. The extended fairing of the CJNC effectively eliminates the formation of these flow channels and suppresses flow separation at the trailing edge of the fairing. At the design point, CJNC improves lift-to-drag ratios by 1.9% and 4.9%, and reduces installation drag by 29.7% and 51.9% compared to the staggered and parallel nacelle layouts, respectively. As Mach numbers increase, CJNC delays the shock wave on the inboard wing and suppresses the expansion of supersonic regions over the nacelle surface.},
 author = {Youxu Jiang and Ziyan Wei and Xingyu Chen and Heng Zhang and Zhao Yang and Songxiang Tang and Jie Li},
 doi = {https://doi.org/10.1016/j.ast.2026.112163},
 issn = {1270-9638},
 journal = {Aerospace Science and Technology},
 keyword = {Hybrid-wing-body, Over-wing-nacelle, Conjoined nacelle, Aerodynamic interference, Aerodynamic characteristics},
 pages = {112163},
 title = {Aerodynamic interference and a mitigation strategy for closely coupled over-wing-nacelles on hybrid-wing-body aircraft},
 url = {https://www.sciencedirect.com/science/article/pii/S1270963826005432},
 volume = {176},
 year = {2026}
}
