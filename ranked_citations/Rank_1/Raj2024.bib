@conference{Raj2024,
 abstract = {Cell segmentation is crucial for accurately assessing disease severity. Despite advances in deep learning, there is still a gap in understanding how U-Net variants perform in addressing the issue of limited labeled data in cell segmentation. We compare various U-Net models to see how they fare with live cell images. We also examine how different feature extraction methods affect their performance. Using the Laplacian and Standard Deviation features improves performance by more than 3%, giving Attention U-Net mean Intersection over Union (IoU) scores of 0.7956 and mean Dice scores of 0.8844. In addition, we introduce a semi-supervised Mean Teacher Attention U-Net that leverages the same feature extraction techniques. Remarkably, it achieves an IoU score of 0.7908 and a Dice score of 0.8831, outperforming the existing approaches even with only 60% labeled data and utilizing limited computational resources. ©2024 IEEE.},
 author = {Raj, Ardra S. and Asha, S.B. and Gopakumar, G.},
 doi = {10.1109/ICCCNT61001.2024.10726083},
 journal = {2024 15th International Conference on Computing Communication and Networking Technologies, ICCCNT 2024},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Feature Enhanced Semi-Supervised Attention U-Net for Cell Segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85212867756?origin=resultslist},
 year = {2024}
}
