@article{Penha2019_255,
 abstract = {ABSTRACT The More Doctors Program is a strategic set of actions for the Brazilian National Health System (SUS) aiming at improvements in medical education, professional qualification and retention of doctors in unassisted areas. Among these actions, we highlight the Project More Doctors for Brazil (PMMB), responsible for the emergency supply of doctors. It was conceived as a response to the shortage of professionals in primary care across the country, an extremely important aspect in this set of strategies for SUS. The professional improvement proposed by PMMB has mobilized public higher education institutions to participate as supervisory institutions. They are responsible for supervising the activities developed by doctors and for strengthening the continuing education policy through teaching-service integration actions. This article aims to report on the experience of managing academic supervision in light of the challenge of the implementation of PMMB.},
 author = {Penha, Rodrigo Chavez and Sousa, Rosa Gouvêa de and Oliveira, Sandro Schreiber de and Almeida, Erika Rodrigues de and Firmiano, Jackeline Gomes Alvarenga},
 doi = {10.1590/interface.180061},
 number = {suppl 1},
 pages = {e180061--e180061},
 title = {The management of academic supervision in the More Doctors for Brazil Project by higher education institutions},
 volume = {23},
 year = {2019}
}
