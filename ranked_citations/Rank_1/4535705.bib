@inproceedings{4535705,
 abstract = {In this paper, a new partial area matching method based on support vector machine (SVM) for distinguishing similar on-line handwritten Chinese characters is presented. With this new method, the similar characters are divided into several classes according to the difference among their structure features. After the candidate character set is obtained by the former recognizing steps, the SVM is used to pick up the most accurately matched character from the set. Experiments showed that the similar Chinese characters can be distinguished effectively and the recognition rate for the first rank Chinese characters can be improved with this method.},
 author = {Lu, Xinqiao and Li, Ping and Xiao, Guoqiang and Jin, Renchao and Song, Enming and Liu, Xiaojuan and Luo, Qiaoling},
 booktitle = {2008 2nd International Conference on Bioinformatics and Biomedical Engineering},
 doi = {10.1109/ICBBE.2008.825},
 issn = {2151-7622},
 keyword = {Support vector machines;Character recognition;Dictionaries;Computer science;Merging;Pattern matching;Dynamic programming;Sun;Equations;Testing},
 month = {May},
 number = {},
 pages = {1984-1987},
 title = {A Partial Area Matching Method Based on Support Vector Machine for Distinguishing Similar On-Line Handwritten Chinese Characters},
 volume = {},
 year = {2008}
}
