@inproceedings{4511148,
 abstract = {This paper presents the design of implicit filtering for out-of-channel interferers in continuous-time (CT) quadrature bandpass (QBP) ΔΣ modulator using a differentiated signal-transfer-function (STF). Comparative study between possible ΔΣ modulator loop filter structures is addressed to better cope with the best implementation. The Fifth-order CT QBP ΔΣ modulator planned for the WiFi adjacent channel blockers requirements, illustrates clearly the totally elimination of interferers and the correctly signal process. This led to remove the baseband filter and PGA at the price of a very challenging ADC with merged-in cited functionalities. So, less analog components, low power consumption and high performance for the low-IF receiver.},
 author = {Jouida, Nejmeddine and Rebai, Chiheb and Ghazel, Adel and Dallet, Dominique},
 booktitle = {2007 14th IEEE International Conference on Electronics, Circuits and Systems},
 doi = {10.1109/ICECS.2007.4511148},
 issn = {},
 keyword = {Band pass filters;Filtering;Delta-sigma modulation;Computed tomography;Signal design;Signal processing;Electronics packaging;Energy consumption;Computer architecture;Image converters},
 month = {Dec},
 number = {},
 pages = {947-950},
 title = {Built-in Filtering for Out-of-Channel Interferers in Continuous-Time Quadrature Bandpass Delta Sigma Modulators},
 volume = {},
 year = {2007}
}
