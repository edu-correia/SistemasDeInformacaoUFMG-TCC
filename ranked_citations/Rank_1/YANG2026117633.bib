@article{YANG2026117633,
 abstract = {Efficient sintering mode should be employed to mitigate the thermal decomposition of phosphor in glass (PiG) used for white light-emitting diodes (WLED). Boroaluminosilicate PiGs containing 0, 3, 5, 7 wt% phosphor Y3Al5O12:Ce3+ (YAG:Ce3+) were respectively prepared by facile microwave (MW) sintering under varied energy and conventional sintering. The effects of YAG:Ce3+ content and MW radiation energy on the structure and the photoluminescence, electroluminescence of the PiGs were investigated. YAG:Ce3+ particles are stably embedded in the glass matrix free of impure crystalline phase. In contrast, PiGs prepared by MW sintering manifest densified morphology and superior luminescence performances to those by conventional sintering. Interfacial reaction between the phosphor and glass matrix can be negligible for sintering at moderate MW radiation energy while further elevated MW energy promotes the merge of YAG:Ce3+ particles into the molten glass at the cost of inevitable degeneration of phosphor. The photoluminescence of the PiG intensifies with increasing YAG:Ce3+ content whereas decays with rising MW radiation energy. Electroluminescence of the PiGs coupling with blue light-emitting chips show excellent thermal stability and increasing MW energy helps enhance color conversion of PiGs containing moderate YAG:Ce3+. The mechanism of reciprocal effects of mild thermal destruction of YAG:Ce3+ phosphor versus the fusion of glass with phosphor is proposed to justify the nonlinear variations of luminescence properties. Tunable luminescence performances of PiGs can be achieved by adjusting the MW sintering process fully trading off YAG:Ce3+ content introduced and MW energy applied.},
 author = {Guo Yang and Meng Sun and Xiaomei Li and Mingzhen Tang and Zhenlin Wang},
 doi = {https://doi.org/10.1016/j.optmat.2025.117633},
 issn = {0925-3467},
 journal = {Optical Materials},
 keyword = {Phosphor-in-glass, WLED, YAG:Ce, Microwave sintering, Boroaluminosilicate},
 pages = {117633},
 title = {Facile preparation of Y3Al5O12:Ce3+ in boroaluminosilicate glass for WLEDs with tunable luminescence by microwave sintering},
 url = {https://www.sciencedirect.com/science/article/pii/S0925346725009930},
 volume = {169},
 year = {2026}
}
