@article{ESPIN2024102113,
 abstract = {This research introduces two controllers for non-self-regulating systems with dominant time delays. These controllers are designed using sliding mode control principles with built-in predictive structures. Previous studies have already demonstrated the effectiveness of these controllers in non-self-regulating systems with non-dominant delays. However, in this study, we investigate the extension of these controllers to systems with time-dominated time-delay processes. To thoroughly evaluate the performance of both approaches, we conduct extensive tests involving set-point changes and perturbations. The results indicate that the proposed methods outperform conventional techniques in both scenarios. The evaluation metrics used include integral squared error (ISE), total control variation (TVU), settling time, and maximum overshoot. In general, the new dynamic sliding mode controllers exhibit superior capabilities in handling systems with significant delays compared to standard controllers.},
 author = {Jorge Espin and Christian Camacho and Oscar Camacho},
 doi = {https://doi.org/10.1016/j.rineng.2024.102113},
 issn = {2590-1230},
 journal = {Results in Engineering},
 keyword = {Sliding mode control, Internal model, Non-self-regulating processes},
 pages = {102113},
 title = {Control of non-self-regulating processes with long time delays using hybrid sliding mode control approaches},
 url = {https://www.sciencedirect.com/science/article/pii/S2590123024003670},
 volume = {22},
 year = {2024}
}
