@article{NGUYEN2026100374,
 abstract = {The prediction of drug-microbe interactions faces difficulties because of three main factors, including incomplete networks, missing data and restricted capabilities of single-network models. To solve this problem, in this paper, we proposed a KAMDA framework integrating multi-view graph learning with Kolmogorov-Arnold Networks and pre-trained language models. The KAMDA framework presents three main innovations: a dual-view encoding system that merges biological similarities with Gaussian Interaction Profiles to extract both intrinsic biological patterns and topological patterns; KAGAT layers which use learnable B-spline activation functions to provide better non-linear modeling capabilities than fixed MLPs; a BERT-based imputation system which uses ChemBERTa and DNABERT to fill in missing information. The experiments conducted on aBiofilm showed noticeable results with both the AUC and AUPR scores reached remarkable values of 0.9774 and 0.9719, respectively. It could be noticed to be a potential powerful tool for microbe-drug association prediction. The code and data are available at: https://anonymous.4open.science/r/KAMDA-1F16.},
 author = {Van Tinh Nguyen and Minh Tuan Lau and Thi Kim Anh Nguyen and Quoc Phu Nguyen and Thi Na Nguyen and Thi Tu Khuyen Ngo},
 doi = {https://doi.org/10.1016/j.ibmed.2026.100374},
 issn = {2666-5212},
 journal = {Intelligence-Based Medicine},
 keyword = {BERT embeddings, Drug-microbe interaction, Graph attention networks, Kolmogorov-Arnold networks, Link prediction, Multi-view learning},
 pages = {100374},
 title = {KAMDA: A multi-view Kolmogorov-Arnold Network integrating pre-trained BERT embeddings and similarity-based imputation for microbe-drug association prediction},
 url = {https://www.sciencedirect.com/science/article/pii/S2666521226000323},
 volume = {14},
 year = {2026}
}
