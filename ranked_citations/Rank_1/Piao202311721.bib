@article{Piao202311721,
 abstract = {We tackle the insufficient context pattern limitation of existing Word-Word Attention caused by its spatial-shared property. To this end, we propose the Word-Context Attention method that utilizes item-wise filters to perform both temporal and spatial combinations. Specifically, the proposed method first compresses the global scale left and right context words into fixed-length vectors respectively. Then, a group of specific filters are learned to select features from the word and its context vectors. Last, a non-linear transformation is adopted to merge and activate the selected features. Since each word has its exclusive context filters and non-linear semantic transformations, the proposed method has the property of being spatial-specific, and thus can generate flexible context patterns. Experimental comparisons demonstrate the feasibility of our model and its attractive computational performance. © 2023, The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature.},
 author = {Piao, Chengkai and Wang, Yuchen and Zhu, Yapeng and Wei, Jin-Mao and Liu, Jian},
 doi = {10.1007/s11063-023-11396-w},
 journal = {Neural Processing Letters},
 note = {Cited by: 1},
 number = {8},
 pages = {11721 - 11738},
 publication_stage = {Final},
 source = {Scopus},
 title = {Word-Context Attention for Text Representation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85170027493?origin=resultslist},
 volume = {55},
 year = {2023}
}
