@conference{Kanojia20251231,
 abstract = {The new age of Education 5.0 expresses the current pattern in the arena of academics that can enhance learning by engaging Artificial Intelligence, and teaching mechanisms. The study aims to determine the specifications, and requirements of Education 5.0., and understand the effect of Artificial Intelligence, blockchain, and Virtual Reality (VR) in Education 5.0. Another objective of the paper is to find the relationship between Artificial Intelligence and Education 5.0 variables. The study also revolves around the concept of improved and increased engagement with education. The study was conducted in North West India; the sample size of the study was 270 respondents from the engineering college. SPSS software was used to analyze the data. Descriptive statistics and Correlation Tests are used to analyze the data. It was revealed in the study that all the variables of Artificial Intelligence are correlated with Education 5.0. © 2025 IEEE.},
 author = {Kanojia, Pooja and Sharma, Anju and Tiwari, Ayushi and Agarwal, Shipra and Mukherji, Ranjit},
 doi = {10.1109/InTech64186.2025.11198410},
 journal = {Proceedings of the 2025 International Conference on Technology Enabled Economic Changes, InTech 2025},
 note = {Cited by: 0},
 pages = {1231 - 1235},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integration of Artificial Intelligence with Education 5.0 for Enhancing Personalized Learning in the New Era},
 type = {Conference paper},
