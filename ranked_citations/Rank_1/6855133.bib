@inproceedings{6855133,
 abstract = {Recursive word topology structure is commonly found in natural language sentences, and discovering this structure can help us to not only identify the units that a sentence contains but also how they interact to form a whole. In this paper, we explore a novel recursive neural network (RNN) based word topology model (WordTM) for hierarchical phrase-based (HPB) speech translation, which captures the topological structure of the words on the source side in a syntactically and semantically meaningful order. Experiments show that our WordTM significantly outperforms the state-of-the-art soft syntactic constraints.},
 author = {Lu, Shixiang and Wei, Wei and Fu, Xiaoyin and Xu, Bo},
 booktitle = {2014 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP.2014.6855133},
 issn = {2379-190X},
 keyword = {Syntactics;Topology;Semantics;Merging;Speech;Neural networks;Network topology;recursive neural network;word topology model;hierarchical phrase-based speech translation},
 month = {May},
 number = {},
 pages = {7874-7878},
 title = {Recursive neural network based word topology model for hierarchical phrase-based speech translation},
 volume = {},
 year = {2014}
}
