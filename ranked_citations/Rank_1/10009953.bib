@inproceedings{10009953,
 abstract = {The research work presents the integration of ten chaotic maps into a contemporary approach called Chimp Optimization Algorithm (COA) promoting solution in search space with elevated mobility. The research attempts a dual level strategy to authenticate the versatility of the recommended method first by testing on assorted benchmarked test functions followed by application of the endorsed hybrid algorithm in reactive power dispatch (RPD) problem with inclusion of FACTS devices which is exhibited as a formidable operational issue in power systems. The results obtained candidly establishes that merging of chaotic maps (especially Chaotic 4) enhances the performance of COA, and it generates superior results when contrasted with other established algorithm as presented in literature.},
 author = {Mahapatra, Sheila and Raj, Saurav and Sharma, Renu},
 booktitle = {2022 2nd Odisha International Conference on Electrical Power Engineering, Communication and Computing Technology (ODICON)},
