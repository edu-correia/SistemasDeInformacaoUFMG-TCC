 issn = {},
 keyword = {Performance evaluation;Computers;Reactive power;Power engineering;Chaotic communication;Merging;Benchmark testing;Reactive power dispatch;Chimp Optimization Algorithm;Chaotic Maps;TCSC;SVC},
 month = {Nov},
