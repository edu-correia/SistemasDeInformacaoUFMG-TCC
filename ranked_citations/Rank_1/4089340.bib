@inproceedings{4089340,
 abstract = {The multi-resolution terrain technique is the most efficient tool for real-time rendering of a complex terrain. In this paper a bintree-based optimized algorithm for level of detail (LOD) terrain is applied based on the overall research of former algorithms. At the same time, the node evaluation function is given according to the influence of viewer's orientation and terrain's roughness and deviation, which gives an accurate explanation of the LOD node and increases the executive efficiency. Meanwhile the method of recovering cracks which Duchaineau used in his whitepaper is improved. Next, this paper presents an approach to maintain the frame coherence. Last, we use the improved algorithm to simulate the terrain and get a good effect},
 author = {Wei, Wei and Zhuang, Yu},
 booktitle = {16th International Conference on Artificial Reality and Telexistence--Workshops (ICAT'06)},
 doi = {10.1109/ICAT.2006.48},
 issn = {},
 keyword = {Hardware;Layout;Computer displays;Visualization;Merging;Error correction;Floods},
 month = {Nov},
 number = {},
 pages = {694-698},
 title = {CLOD-Based Efficient Algorithm for Real-Time Terrain Walkthrough},
 volume = {},
 year = {2006}
}
