@conference{Charnsil2022533,
 abstract = {We propose a new toy idea in which players can print out a 3D model from a digital file, acquired randomly from an online "gachapon", and then view its connected story and digital contents using an augmented reality (AR) application. This model acts as a kind of interactive object that can respond to players in an appropriate simulated situation. An advantage of our proposal is that we train the digital contents with the entire 3D model without the need for 2D markers. Thus, a player can scan the 3D object directly after printing without any additional color marks. This presents a potentially new gachapon mechanic in that we can trade digital content with objects in online vending machines. It can also provide new marketing channels to increase product values. This integration of AR, 3D-printing, manga, and gachapon technologies enables players to truly merge the virtual world with reality.  © 2022 IEEE.},
 author = {Charnsil, Kunatip and Choochuen, Kittapat and Taweesuk, Peerasak and Kerdprasert, Nattakorn and Sookhnaphibarn, Kingkarn and Silapasuphakornwong, Piyarat and Uehira, Kazutake},
 doi = {10.1109/LifeTech53646.2022.9754948},
 journal = {LifeTech 2022 - 2022 IEEE 4th Global Conference on Life Sciences and Technologies},
 note = {Cited by: 2},
 pages = {533 - 536},
 publication_stage = {Final},
 source = {Scopus},
 title = {3D-gARt - A New Gachapon 3D-printed Toy Played with Augmented Reality and Story Narration},
 type = {Conference paper},
