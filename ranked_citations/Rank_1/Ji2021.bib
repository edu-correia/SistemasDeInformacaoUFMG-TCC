@conference{Ji2021,
 abstract = {In order to research that continuous interchange is difficult to give full play to the characteristics of efficient traffic and leads to frequent traffic jams and accidents. By analyzing the influencing factors of the weaving area of expressway continuous interchange, a cellular automaton micro-simulation model of traffic flow is constructed by studying the traffic operation characteristics of weaving area, and exploring the relationships between weaving area capacity and volume ratio, weaving ratio, and weaving area length. Based on this, the parameters of the weaving area capacity reduction coefficient model were recalibrated using simulation experimental data, and the calibrated weaving area capacity reduction coefficient model was verified with the measured data. The results show that the model was calculated has certain reliability, the cellular automata model can also better simulate the traffic scene of expressway. © 2021 SPIE},
 author = {Ji, Qingtong and Wang, Yazhai},
 doi = {10.1117/12.2620236},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Study on capacity in weaving area of expressway},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85134249572?origin=resultslist},
 volume = {12058},
 year = {2021}
