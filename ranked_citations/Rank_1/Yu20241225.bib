@conference{Yu20241225,
 abstract = {Amidst the burgeoning expansion of the aviation sector, technologies related to air traffic are undergoing rapid advancement and significant paradigm shifts. Scholarly efforts have resulted in numerous seminal research findings in this domain. As a complex mega-system, given the intricacies and importance of air traffic, it is crucial to elaborate on the global research knowledge structure. This study aims to visually delineate the overarching scientific research trends in global air traffic. We have synthesized the latest developments over the past two decades using a bibliometric approach, drawing data from the Web of Science Core Collection database from January 2000 to May 2024. A total of 4,432 articles were included in this study, revealing a marked increase in global research publications. 14 clusters were formed, highlighting four major research themes: Aircraft Sequencing, Urban Air Mobility, Aircraft Trajectory Prediction, and Air Traffic Control System. These insights offer a comprehensive understanding of research directions and provide invaluable guidance for future air traffic research. © 2024 IEEE.},
 author = {Yu, Shasha and Chen, Yijun and Zhang, Xuejun},
 doi = {10.1109/ICIBA62489.2024.10869283},
 journal = {Proceedings of 2024 IEEE 4th International Conference on Information Technology, Big Data and Artificial Intelligence, ICIBA 2024},
 note = {Cited by: 0},
 pages = {1225 - 1234},
 publication_stage = {Final},
 source = {Scopus},
 title = {Insight into complex mega-system: Examining the Evolution of Air Traffic Research},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85219121912?origin=resultslist},
 year = {2024}
}
