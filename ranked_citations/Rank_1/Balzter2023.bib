@article{Balzter2023,
 abstract = {Loss and damage from climate change have risen to a prominent position on the international agenda. At COP27 in 2022, the Conference of the Parties (COP) to the UN Framework Convention on Climate Change (UNFCCC) ratified a decision to establish a loss and damage fund to compensate low- and middle-income countries that are suffering negative impacts from climate change. The fund is meant to address the Global Adaptation Gap, which describes the rising cost of adaptation needed to cope with climate change impacts due to delayed action to curb greenhouse gas emissions and remove greenhouse gases from the atmosphere. This essay highlights issues around loss and damage from climate change from a variety of natural and social science perspectives. From three months of discussions, an interdisciplinary perspective and research agenda on this topic have crystallised, which is outlined here. Given that the implementation of the loss and damage fund still needs negotiation and commitment from signatories to the UNFCCC, it is timely now to address some important knowledge gaps on how loss and damage can be measured, quantified, valued, understood, communicated, and adapted to. Hence, it is necessary to understand the complex interactions between people, politics, nature, and climate in this interdisciplinary context. © 2023 by the authors.},
 author = {Balzter, Heiko and Macul, Mateus and Delaney, Beth and Tansey, Kevin and Espirito-Santo, Fernando and Ofoegbu, Chidiebere and Petrovskii, Sergei and Forchtner, Bernhard and Nicholes, Nicholes and Payo, Emilio and Heslop-Harrison, Pat and Burns, Moya and Basell, Laura and Egberts, Ella and Stockley, Emma and Desorgher, Molly and Upton, Caroline and Whelan, Mick and Yildiz, Ayse},
 doi = {10.3390/su151511864},
 journal = {Sustainability (Switzerland)},
 note = {Cited by: 15; All Open Access; Gold Open Access; Green Open Access},
