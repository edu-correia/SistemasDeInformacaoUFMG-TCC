@article{TRAN2025191,
 abstract = {Ultra-high-performance concrete (UHPC) has attracted considerable interest within the construction sector owing to its remarkable mechanical characteristics and long-lasting nature. As a result of the costly price and environmental impact of UHPC production, researchers are researching different substances for its composite structure. As a result, scholars have investigated the potential for merging diverse by-products, waste materials, and locally sourced and recycled materials into UHPC mix formulations. Utilizing products, waste, locally sourced, recycled, and destroyed materials in the blending process of UHPC mixes presents considerable prospects for improving sustainability and mitigating the ecological consequences associated with UHPC manufacturing. In addition to enhancing the mechanical properties and longevity of UHPC, these alternative materials also aid in reducing pollution and conserving resources. Nevertheless, meticulous quality control, processing, and selection procedures are required to guarantee the performance and suitability of these components in UHPC mix designs.},
 author = {Trung-Hau Tran and Anh-Thang Le and Duc-Thien Pham},
 doi = {https://doi.org/10.1016/j.trpro.2025.03.151},
 issn = {2352-1465},
 journal = {Transportation Research Procedia},
 keyword = {UHPC, by-products, local materials, recycled materials, sustainable construction},
 note = {TRPRO_SDCAT 2023},
 pages = {191-198},
 title = {Review of UHPC concrete mixture’s ability to use recycled, by-product, waste, or locally sourced materials},
 url = {https://www.sciencedirect.com/science/article/pii/S2352146525002108},
 volume = {85},
 year = {2025}
}
