@inproceedings{10617777,
 abstract = {A method is being developed for computer simulation of traffic at a controlled intersection of urban roads, considered as a random process. The proposed model explicitly takes into account the spatio-temporal structure of traffic flow, systematically considering the interdependencies between vehicle passages through conflict points of crossing and merging as well as on exit roads. The statistical dependencies used in the model for the time interval between successive vehicles on the route and the difference in their speeds are determined. Methods for obtaining such dependencies from monitoring data are considered. The proposed approach can be used to analyze the current passage of flows and to select a method for structural- parametric control of an intersection. The organization of calculations for solving such problems develops what was previously proposed and tested using the example of a T- junction.},
 author = {Valuev, A. M.},
 booktitle = {2024 Systems of Signal Synchronization, Generating and Processing in Telecommunications (SYNCHROINFO)},
 doi = {10.1109/SYNCHROINFO61835.2024.10617777},
 issn = {2832-0514},
 keyword = {Uncertainty;Roads;Merging;Stochastic processes;Process control;Regulation;Random processes;signalized intersection;conflict points;traffic flow;spatio-temporal structure;phase-by-phase passing scheme;probabilistic model;simulation},
 month = {July},
 number = {},
 pages = {1-10},
 title = {Model of Stochastic Traffic Flow through an Intersection with Representation of Cluster Interaction},
 volume = {},
 year = {2024}
}
