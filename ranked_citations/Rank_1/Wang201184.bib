@conference{Wang201184,
 abstract = {Ontology has been one of the best tools to express knowledge, such as classification knowledge of resources on the Web. To facilitate the integration of learning resources categorized under different ontology representations, the techniques of ontology mapping can be applied. Though many algorithms and systems have been proposed for ontology mapping, they do not have an automatic weighting strategy on class features to automate the ontology mapping process and improve the overall mapping effectiveness. A novel method of computing the feature weights is proposed. The results show that it makes the ontology mapping process more automatic while retaining satisfying accuracy. © 2011 AICIT.},
 author = {Wang, Feng-Hsu and Jou, Jia-He},
 journal = {Proceedings - 7th International Conference on Networked Computing and Advanced Information Management, NCM 2011},
 note = {Cited by: 1},
 pages = {84 - 89},
 publication_stage = {Final},
 source = {Scopus},
 title = {A new entity similarity measurement based on automatic featuring for ontology mapping},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/80052112307?origin=resultslist},
 year = {2011}
}
