@conference{Kaswan2025,
 abstract = {Land mines still remain a serious threat around the world, estimated to have millions of active devices in contested regions, historical conflict zones and along borders. Conventional landmine-detection devices are dangerous, timeconsuming and unreliable. To resolve this urgent problem, we propose a novel method to make use of smart robots to detect the hidden landmines safely and efficiently. The paper describes the method, major findings, and implications of our work. Our methodology combines cutting edge technology including robotic using sensors and advanced artificial intelligent (AI) algorithms. These robots traverse the treacherous landscapes, searching for signs of anomalies that may denote a landmine. Robots use ground-penetrating radar, metal detectors and thermal imaging to accurately recognise subsurface mines and mines on the surface. Thanks to extensive testing on the field, and accurate validation, our intelligent robots have shown to present a great precision on the detection of mines. With real-time data processing capabilities, the AI algorithms used resulted in a low rate of false positives and the quick detection of true threats. Deploying smart robots to clear mines overhead reduces human risk and speeds things up. The importance of such research is not only that it could potentially save countless lives, but it could be applied to other dangerous environments as well (ie: disaster sites, areas polluted by industrial facilities, etc). It demonstrates the development of AI-based robotics in applications involving humanitarian (and security) oper ations, emphasizing the necessity of technology to tackle emerging global issues. This research contributes to the international effort to address the global landmine crisis. We merge advanced robotics technology with intelligent machinery, offering a safer, quicker and scalable landmine detecting solution. The implications of the results in this paper will have far reaching impact on humanitarian and security operations, and demonstrate the importance of intelligent robots in dealing with such complex and life threatening tasks.  © 2025 IEEE.},
 author = {Kaswan, Kuldeep Singh and Dhatterwal, Jagjit Singh and Malik, Kiran},
 doi = {10.1109/ACET67282.2025.11430256},
