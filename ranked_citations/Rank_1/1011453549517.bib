@article{10.1145/3549517,
 abstract = {With one-person households being increasingly common and Covid-19 lockdown policies forcing people to stay home, remote dining has become common practice for many, who take it as an opportunity to connect with others in times of loneliness. Sharing meals online, also known as digital commensality, is a rich form of interaction, where people leverage technology to achieve a sense of connectedness and belonging while eating. In this paper, we look at digital commensality and we explore its inherent playful potential with the aim to inspire the design of engaging technologies that can support, enhance and augment this form of interaction. For this, we used a situated play design approach to document and analyze the behavior of 36 people (including pairs of friends and strangers) sharing meals online. Our analysis surfaced a set of play potentials of remote dining -- i.e., playful things people already do and enjoy spontaneously while sharing meals online. We present those play potentials as inspirational material: they can motivate and enrich the design of future digital commensality technologies by responding to people's desire for playful and social interaction with, through, and around food.},
 address = {New York, NY, USA},
 articleno = {254},
 author = {Alhasan, Khawla and Ceccaldi, Eleonora and Covaci, Alexandra and Mancini, Maurizio and Altarriba Bertran, Ferran and Huisman, Gijs and Lemke, Mailin and Ang, Chee Siang},
 doi = {10.1145/3549517},
 issue_date = {October 2022},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {playfulness, interaction design, human food interaction, games/play, empirical study, digital commensality, computer mediated communication, commensality, augmented reality, HFI},
 month = {October},
 number = {CHI PLAY},
 numpages = {24},
 publisher = {Association for Computing Machinery},
 title = {The Playful Potential of Digital Commensality: Learning from Spontaneous Playful Remote Dining Practices},
 url = {https://doi.org/10.1145/3549517},
 volume = {6},
 year = {2022}
}
