@conference{Liang2024400,
 abstract = {Objective: This study aims to explore the extent of progress and trends in the "integration of innovation and professional education" at various higher education institutions, enabling precise utilization of talents across different fields and further solidifying the innovation and entrepreneurship education system. Methods: Utilizing CiteSpace 5.8 software, this research conducts a visual analysis of 2,000 publications from April 2012 to April 2022, focusing on "innovation and entrepreneurship education" and "professional education". Results: Since 2012, experts have increasingly recognized that the integration of innovation and entrepreneurship education into professional education is an inevitable trend. As theories merge and diverse pathways are explored, research related to the "integration of innovation and professional education" has been steadily progressing and deepening in recent years. Conclusion: Departments and institutions should collaborate closely for effective deployment, and higher education institutions should actively organize students to participate in academic competitions and theoretical discussions. Different training programs should be developed according to the various specialties to cultivate integrated talents in China, who are proficient in their specific fields and innovation. © 2024 Copyright held by the owner/author(s).},
 author = {Liang, Zhongyi and Zhang, Xinyue and Fu, Yuxin and Li, Xinrui and Cao, Shikui},
 doi = {10.1145/3691720.3691791},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 0},
 pages = {400 - 406},
 publication_stage = {Final},
 source = {Scopus},
 title = {Frontiers and Trends in Integrating Innovation and Entrepreneurship Education for College Students with Professional Education Based on literature visualization analysis},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85208113313?origin=resultslist},
