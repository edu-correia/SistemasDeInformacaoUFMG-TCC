@inproceedings{10896326,
 abstract = {Ocean engineering demands systemic solutions for mission-critical demands and technological challenges. From an industrial control perspective, development engineers need to factor in both costs and established standards to ensure the efficient implementation of the control system development lifecycle within a reasonable budget. Customization and reusability play key roles in driving down costs, resources, and development time when creating new applications. In the paper, the Unified Architecture Framework (UAF) [5], Model Based Systems Engineering (MBSE), combined with real time Unified Modeling Language/Systems Modeling Language (UML/SysML) are merged and tailored to produce an object-oriented (OO) control model. This model is then extensively applied to develop a controller for Autonomous Underwater Vehicles (AUVs). To reach this objective, the dynamic model of an Autonomous Underwater Vehicle (AUV) are linked with specific specializations of UAF/MBSE. In this setup, the model of analysis is precisely outlined through the detailed description of a use case model, aimed at closely capturing the intricate control demands. The designed model is then specialized by using the real-time UML/SysML to retain key blocks, which are used to describe in detail structures for control and behaviors of AUV. Next, the designed model is transformed into the model of implementation via round-trip engineering, facilitating the quick realization of an AUV controller. Building upon this object-oriented model, a controller for course-tracking applied to a miniature AUV was designed. The results from the simulation demonstrate the good feasibility of the proposed model.},
 author = {Cao, Duc Sang and Ngo, Van Hien and Le, Tran Thang and Ngo, Van He},
 booktitle = {2024 International Conference on Control, Robotics and Informatics (ICCRI)},
 doi = {10.1109/ICCRI64298.2024.00012},
 issn = {},
 keyword = {Autonomous underwater vehicles;Analytical models;Costs;Object oriented modeling;Unified modeling language;Real-time systems;Modeling;Vehicle dynamics;Standards;Robots;Autonomous underwater vehicles (AUV);AUV controller;Object-oriented model;Unified architecture framework (UAF);Model-based systems engineering (MBSE);real-time UML/SysML},
 month = {July},
 number = {},
 pages = {32-36},
 title = {An Object-Oriented Model to Develop Controllers of Autonomous Underwater Vehicles by Specializing the Unified Architecture Framework},
 volume = {},
 year = {2024}
}
