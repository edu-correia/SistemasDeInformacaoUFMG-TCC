@article{LI2026165472,
 abstract = {To combat synergistic high-temperature wear-oxidation failure in critical components (e.g., gas turbines), this study designs laser-clad FeCoCrNi-Nb gradient high-entropy alloy coatings (Nb-GHEA). The monolithic gradient architecture integrating a Laves-phase-dominated surface, nanoscale eutectic transition, and ductile FCC substrate. The coating achieves oxidation resistance at 800 °C (mass gain: 0.056 mg·cm−2), attributed to sluggish diffusion forming an adherent Cr2O3-NbO2 scale and dynamic Nb4+/Nb5+ redox-mediated crack healing. Furthermore, it exhibits an ultra-low wear rate (9.29 × 10−7 mm3·N−1·m−1), friction coefficient (0.2207), and impact toughness (115.8 J) at this temperature. These enhancements primarily originate from multi-layer structure synergy, which transitions the dominant wear mechanism from adhesion to mild abrasion. This work establishes Nb-GHEA as a solution for critical tribological components under extreme conditions.},
 author = {Xinyao Li and Xiufang Cui and Yajie Guan and Di Chen and Guo Jin},
 doi = {https://doi.org/10.1016/j.apsusc.2025.165472},
 issn = {0169-4332},
 journal = {Applied Surface Science},
 keyword = {Laser cladding, Coatings, High entropy alloy, Gradient structure, High temperature performance},
 pages = {165472},
 title = {Gradient design mediated wear mechanism transition in FeCoCrNi-Mo/Nb high-entropy alloy coatings for elevated-temperature tribological applications},
 url = {https://www.sciencedirect.com/science/article/pii/S0169433225031897},
 volume = {721},
 year = {2026}
}
