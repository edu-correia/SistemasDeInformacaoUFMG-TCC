@inproceedings{6007950,
 abstract = {The adjustment of the industrial structure is a key issue to be faced by the industry in China. What kind of the industrial model should be set up is worthy of being studied. So the paper takes Wuhan industry as a case and studies deeply the layout of industrial enterprises in Wuhan. It finds that the big and the medium-small enterprises matches the pattern of the Long Tail Theory in constitution proportion and output ratio. Based on the Long Tail Theory, the paper dissects the features of the industrial enterprises in Wuhan and constructs the endogenous adjustment model of the industrial structure. In the light of the model, the paper proposes that the current industrial structure adjustment must undergo a process from the integrated adjustment to the intensive development and finally it points out the detailed steps to develop the industry intensively.},
 author = {Li, Zhihong},
 booktitle = {2011 IEEE 2nd International Conference on Computing, Control and Industrial Engineering},
 doi = {10.1109/CCIENG.2011.6007950},
 issn = {},
 keyword = {Industries;Marketing and sales;Business;Merging;Technological innovation;Information technology;Economics;endogenous adjustment model;industrial structure;Long Tail Theory},
 month = {Aug},
 number = {},
 pages = {33-36},
 title = {Study on the endogenous adjustment model of the industrial structure based on the Long Tail Theory — Take the industry in Wuhan as a case},
 volume = {1},
 year = {2011}
}
