@article{Yildiz2026,
 abstract = {AbstractThis study experimentally investigates the aerodynamic performance of a National Advisory Committee for Aeronautics (NACA) 63(4)-421 airfoil equipped with a Mid-Chord Slot (MCS) at suction side (SS) to enhance flow attachment, delay stall, and improve aerodynamic efficiency. Force Measurement Experiments (FMEs) and Surface Oil Flow Visualization (SOFV) technique were conducted in a suction-type wind tunnel to analyze the effects of slot geometry on aerodynamic characteristics. The tested MCS configurations were designed by optimizing slot width ratio (Formula presented) slot angle ((Formula presented) ), slot inlet position (%X), and slot radii (r<sub>c</sub>, r<sub>p</sub>, r<sub>t</sub>) to maximize re-energization effects and minimize flow separation. Among the four tested configurations, the M2 model exhibited the highest aerodynamic efficiency, achieving a stall angle of 16° (compared to 14° in B1), an increase in maximum lift coefficient (C<sub>L,max</sub>) to 1.63 (140% improvement over B1), and a 9.5% increase in surface attachment at 14° angle of attack (AoA). At moderate AoAs (6°–14°), the early merging of the slot jet flow and main flow re-energized the boundary layer and improved surface attachment compared to conventional slot-based designs. The low-pressure, high-momentum slot flow merged with the higher-pressure main flow, stabilizing the boundary layer and delaying separation. Additionally, the integration of r<sub>t</sub> and r<sub>c</sub> mitigated the jet effect in the perpendicular direction, particularly at low AoA, leading to a reduction in flow separation intensity. Furthermore, the incorporation of r<sub>p</sub> contributed to reducing drag coefficient (C<sub>D</sub>) values in pre-stall conditions. At post-stall conditions, while the slot flow remained attached to the surface, it did not alter the stall angle but contributed to improved post-stall aerodynamic characteristics. Unlike conventional Trailing Edge Slotted (TES), which merge with the main flow only near stall region, the MCS enabled merging over a wider AoA range. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
 author = {Yildiz, Abdussamed and Tanürün, Himmet Erdi and Seyhan, Mehmet},
 doi = {10.1016/j.flowmeasinst.2026.103342},
