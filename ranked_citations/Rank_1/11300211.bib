@inproceedings{11300211,
 abstract = {As semiconductor technology continues to advance, the rising cost of chip area has made area efficiency increasingly critical. In FinFET technology, circuit symmetry and transistor merging techniques significantly affect layout area. This paper presents a low power with compact area full adder design based on TSMC 16nm FinFET 1P9M technology. The proposed design adopts a symmetric architecture and incorporates parallel devices to simultaneously reduce both layout area and power consumption. Simulation results show that, under different operating voltages, the proposed design reduces layout area by up to 45.35% compared to existing full adders, while achieving up to a 7.2 × improvement in the Power–Performance–Normalized Area (PPA) metric.},
 author = {Yang, Pei-Hsin and Lin, Jin-Fa},
 booktitle = {2025 13th International Conference on Awareness Science and Technology (iCAST)},
 doi = {10.1109/iCAST68191.2025.11300211},
 issn = {2325-5994},
 keyword = {Measurement;Low voltage;Power demand;Simulation;Layout;Merging;FinFETs;Transistors;Low latency communication;Adders;Full Adder;FinFET;Low Power},
 month = {Nov},
 number = {},
 pages = {1-5},
 title = {A Low-Power Full Adder Design with Compact Layout Implemented in 16nm Technology},
 volume = {},
 year = {2025}
}
