@article{Yang20261,
 abstract = {Purpose – The paper aims to provide a better mesh for electromagnetic simulation of 3D planar circuits using method of moments. A whole mesh generation process is proposed, including mesh generation in single layer and how to obtain a conformal mesh between multilayers. Design/methodology/approach – Several mesh techniques (domain decomposition, Delaunay–AFT, mesh imprinting) are used and adapted in the proposed mesh generation process. To reflect the skin effect of conductors, a special discrete method of edges is designed. Findings – The experimental results demonstrate that our algorithm can generate high-quality meshes for electromagnetic simulation using MoM, and the algorithm is robust, automatic and practically simple. Research limitations/implications – Due to the requirement for a conformal mesh between multilayers, poor quality triangle elements may be generated in the intersections. Mesh adaptive techniques may be useful to improve this problem. Practical implications – Our method has been applied in engineering practice. A mesh generator based on the method in the paper is provided to Huawei Hisilicon and used in their on-chip components design. Originality/value – A whole mesh generation process for electromagnetic simulation of 3D planar circuits using MoM is proposed. The proposed algorithms can inspire people who are not satisfied with the mesh generated automatically by commercial software, and has interest for engineering purpose. © 2025 Emerald Publishing Limited},
 author = {Yang, Xin and Shan, Julin and Lo, Sai Huen and Guan, Z.Q.},
 doi = {10.1108/EC-03-2023-0126},
 journal = {Engineering Computations (Swansea, Wales)},
 note = {Cited by: 0},
 pages = {1 - 27},
 publication_stage = {Article in press},
 source = {Scopus},
 title = {An innovative mesh generation algorithm of conformal rectangle geometry for 3D planar circuits},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105028873864?origin=resultslist},
