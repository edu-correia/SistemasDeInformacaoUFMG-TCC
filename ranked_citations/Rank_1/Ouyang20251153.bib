@article{Ouyang20251153,
 abstract = {Accelerated by global decarbonization initiatives, such as China's 'dual carbon' policy, the rapid expansion of wind energy introduces substantial challenges for grid stability due to its inherent variability. This growing integration into day-ahead electricity markets amplifies the need for accurate and reli-able forecasting. However, existing methods suffer from the weak periodicity of wind data, and systematic spatio-temporal errors in numerical weather prediction (NWP). To address these issues, we introduce HFNet, a Hierarchical Fusion Network for robust day-ahead wind power forecasting. HFNet incorporates a novel multi-level dynamic fusion mechanism with three key components: (1) adaptive meteorological feature fusion to capture intra-source complexities; (2) a dynamic spatial feature extraction module to model evolving wind-weather patterns; and (3) a reliability-aware fusion mechanism leveraging discrepancies between NWP sources and their recent performance for mutual error correction. Extensive experiments across diverse wind farms and scenarios demonstrate that our proposed HFNet consistently outperforms state-of-the-art baselines, providing a highly accurate forecasting framework. © 2025 IEEE.},
 author = {Ouyang, Xiaodong and Chen, Cheng and Zhang, Guozhen and Tang, Ke},
 doi = {10.1109/BigData66926.2025.11402399},
 journal = {Proceedings of the IEEE International Conference on Big Data, BigData},
 note = {Cited by: 0},
 number = {2025},
 pages = {1153 - 1161},
 publication_stage = {Final},
 source = {Scopus},
 title = {Hierarchical Fusion Network for Day-Ahead Wind Power Forecasting},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105037823238?origin=resultslist},
 year = {2025}
