@inproceedings{10911664,
 abstract = {This research paper presents a dual-part analysis of a 6 kWp rooftop Photovoltaic (RPV) plant for the medical dispensary building. The study aims to assess RPV plant’s performance in supplying power to dispensary lighting and medical equipment, and evaluate its economic feasibility. The performance analysis scrutinizes operational efficiency under composite environment conditions of Gwalior (India) location, calculating metrics like performance ratio and energy yields. The economic analysis focuses on investment, operational costs, and energy bill savings. The outcomes indicate that the plant achieves a performance ratio of 78% under an annual average ambient temperature of 25°C. The analysis of cash flow demonstrates that the plant attains a simple payback period of 9 years in relation to its 25-year lifespan. By merging performance and economic results, the paper provides a comprehensive understanding of the RPV system’s effectiveness at medical dispensary building. This research informs healthcare facilities about technical performance, energy potential, and financial gains linked with RPV integration. It contributes to promoting sustainable energy adoption in hospitals, fostering cleaner and resilient power solutions. The full system has a 78% performance ratio, with winter efficiency at 82% and summer at 73%. Generates: 8,383 kWh per year returning to Grid: 5,087 kWh per year A 9-year payback time makes it also an attractive financial commitment for sustainability energy in healthcare.},
 author = {Kulshrestha, Deepansh and Mansuri, Mohmmad Suaib and Panse, Gautam and Trivedi, Ikshita and Rajput, Saurabh Kumar and Sagwal, Rahul},
 booktitle = {2024 4th International Conference on Advancement in Electronics & Communication Engineering (AECE)},
