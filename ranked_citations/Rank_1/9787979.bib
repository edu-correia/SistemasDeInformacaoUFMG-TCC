@article{9787979,
 abstract = {The rapid development of high-performance computing systems has led to a rapid increase in the speed of flow field simulation calculations. However, large-scale simulation output data lead to storage bottlenecks and inefficient data analysis. In this work, we used in situ visualization to process the simulation analysis of large-scale flow fields. Combined with narrative visual analysis, we designed a large-scale ocean flow field eddy evolution analysis system based on in situ visualization. Our system can generate high-precision eddy streamline structures in real time and supports eddy statistical analysis and tracking analysis at different ocean regional scales. Through the case data analysis of ocean simulation, we demonstrated the efficiency and effectiveness of the system.},
 author = {Han, Xiaoyang and Yu, Xiaomin and Li, Guan and Liu, Jun and Zhao, Ying and Shan, Guihua},
 doi = {10.1109/MCG.2022.3167044},
 issn = {1558-1756},
 journal = {IEEE Computer Graphics and Applications},
 keyword = {High performance computing;Visualization;Data visualization;Data models;Computational modeling;Analytical models;Real-time systems},
 month = {May},
 number = {3},
 pages = {65-73},
 title = {Narrative In Situ Visual Analysis for Large-Scale Ocean Eddy Evolution},
 volume = {42},
 year = {2022}
}
