@inproceedings{1630111,
 abstract = {Image segmentation has an important role in image processing and the speed of the segmentation algorithm may become a drawback for some applications. This study analyzes the run time performances of some variations of the Recursive Shortest Spanning Tree Algorithm (RSST) and proposes simple but effective modifications on these algorithms to improve their speeds. In addition, the effect of link weight cost function on the run time performance and the segmentation quality is examined. For further improvement in the run time performance of the fastest sequential method, a distributed RSST algorithm is also proposed and evaluated.},
 author = {Bayramoglu, N.Y. and Bazlamacci, C.F.},
 booktitle = {EUROCON 2005 - The International Conference on "Computer as a Tool"},
 doi = {10.1109/EURCON.2005.1630111},
 issn = {},
 keyword = {Image segmentation;Tree graphs;Merging;Partitioning algorithms;Graph theory;Runtime;Performance analysis;Algorithm design and analysis;Cost function;Image edge detection;Recursive shortest spanning tree (RSST);image segmentation;distributed segmentation},
 month = {Nov},
 number = {},
 pages = {979-982},
 title = {Recursive Shortest Spanning Tree Algorithms for Image Segmentation},
 volume = {2},
 year = {2005}
}
