@inproceedings{1227709,
 abstract = {In this paper, we present a compressed pattern matching method for searching user queried words in the CCITT Group 4 compressed document images, without decompressing. The feature pixels composed of black changing elements and white changing elements are extracted directly from the CCITT Group 4 compressed document images. The connected components are labeled based on a line-by-line strategy according to the relative positions between the changing elements of the current coding line and the changing elements of the reference line. Word boxes are bounded by merging the connected components. A two-stage matching strategy is constructed to measure the dissimilarity between the template image of the user's query word and the words extracted from document images. Experimental results confirmed the validity of the proposed approach.},
 author = {Yue Lu and Chew Lim Tan},
 booktitle = {Seventh International Conference on Document Analysis and Recognition, 2003. Proceedings.},
 doi = {10.1109/ICDAR.2003.1227709},
 issn = {},
 keyword = {Image coding;Pattern matching;Software libraries;Internet;Optical character recognition software;Image recognition;Image storage;Computer science;Pixel;Merging},
 month = {Aug},
 number = {},
 pages = {467-471 vol.1},
 title = {Word searching in CCITT group 4 compressed document images},
 volume = {},
 year = {2003}
}
