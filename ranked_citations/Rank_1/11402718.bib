@inproceedings{11402718,
 abstract = {Multi-modal medical image fusion (M3IF) is essential for enhancing clinical diagnosis by combining complementary information from various imaging modalities, including Computed Tomography (CT) and Magnetic Resonance Imaging (MRI). In the given paper, the authors developed a hybrid model (M3IF-GF-TV) that combines Guided Filtering (GF) to separate the base and detail layers and Total Variation (TV) Regularization to enhance the refined image. The M3IF-GF-TV is a systematic scheme that guides input images through filtering to extract base layers (low-frequency structures) and detail layers (high-frequency textures). An adaptive weighted averaging strategy is then used to fuse the extracted base and detail layers, thereby retaining both structural and textual data. To further refine the merged image, TV Regularization is used to reduce noise, preserve critical edges, and enhance image clarity. The experimental findings show that the M3IF-GF-TV exhibits high contrast, better texture preservation, and reduced artifacts, resulting in superior fusion performance compared to conventional fusion techniques.},
 author = {Chaudhary, Dev Kumar and Singh, Prabhishek and Shankar, Achyut},
 booktitle = {2025 5th International Conference on Internet of Things: Smart Innovation and Usages (IoT-SIU)},
 doi = {10.1109/IOT-SIU65919.2025.11402718},
 issn = {},
 keyword = {Technological innovation;TV;Filtering;Magnetic resonance imaging;Image edge detection;Computed tomography;Noise;Total variance;Medical diagnostic imaging;Image fusion;image fusion;multi-modal medical image fusion;guided filtering;total variation regularization;medical images},
 month = {Nov},
 number = {},
 pages = {1-5},
 title = {Multi-Modal Medical Image Fusion Using Guided Filtering and Total Variation Regularization},
 volume = {},
 year = {2025}
