@conference{Ram202419287,
 abstract = {Training with mixed data distributions is a common and important part of creating multi-task and instruction-following models.The diversity of the data distributions and cost of joint training makes the optimization procedure extremely challenging.Data mixing methods partially address this problem, albeit having a suboptimal performance across data sources and require multiple expensive training runs.In this paper, we propose a simple and efficient alternative for better optimization of the data sources by combining models individually trained on each data source with the base model using basic element-wise vector operations.The resulting model, namely Distribution Edited Model (DEM), is 11× cheaper than standard data mixing and outperforms strong baselines on a variety of benchmarks, yielding upto 6.2% improvement on MMLU, 11.5% on BBH, 16.1% on DROP, 6% on MathQA, and 9.3% on HELM with models of size 3B to 13B.Notably, DEM does not require full re-training when modifying a single data-source, thus making it very flexible and scalable for training with diverse data sources. © 2024 Association for Computational Linguistics.},
 author = {Ram, Dhananjay and Rawal, Aditya and Hardalov, Momchil and Pappas, Nikolaos and Zha, Sheng},
 doi = {10.18653/v1/2024.emnlp-main.1074},
 journal = {EMNLP 2024 - 2024 Conference on Empirical Methods in Natural Language Processing, Proceedings of the Conference},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 pages = {19287 - 19301},
 publication_stage = {Final},
 source = {Scopus},
 title = {DEM: Distribution Edited Model for Training with Mixed Data Distributions},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85217752619?origin=resultslist},
