@inproceedings{9952878,
 abstract = {EDQRCI allows automation in order to creates, establish quantum images and it converts color pixel in well-defined ways. Our model is independent of image rectification process and algorithm, although storage and other necessary process. EDQRCI generally make use of the same idea of energy metamorphose, related to 2D mapping in order to encode values of energy to group of quantum data. Suppose, if the data given is electromagnetic, then it will be processed and stored, then the data given can be encrypted to quantum mode in order to represent color data. On the other hand, if the given data is infrared radiation, then the encoding of quantum data into color representation can be done based on the intensity of radiation. Different Quantum Image Description permits the portrayal, development and acquisition of data in individual modes in quantum mechanism for another experimental implementation.},
