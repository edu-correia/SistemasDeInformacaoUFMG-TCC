@article{10.1145/3236795,
 abstract = {Partially-static data structures are a well-known technique for improving binding times. However, they are often defined in an ad-hoc manner, without a unifying framework to ensure full use of the equations associated with each operation.  We present a foundational view of partially-static data structures as free extensions of algebras for suitable equational theories, i.e. the coproduct of an algebra and a free algebra in the category of algebras and their homomorphisms. By precalculating these free extensions, we construct a high-level library of partially-static data representations for common algebraic structures. We demonstrate our library with common use-cases from the literature: string and list manipulation, linear algebra, and numerical simplification.},
 address = {New York, NY, USA},
 articleno = {100},
 author = {Yallop, Jeremy and von Glehn, Tamara and Kammar, Ohad},
 doi = {10.1145/3236795},
 issue_date = {September 2018},
 journal = {Proc. ACM Program. Lang.},
 keyword = {metaprogramming, multi-stage compilation, partial evaluation, partially-static data, universal algebra},
 month = {July},
 number = {ICFP},
 numpages = {30},
 publisher = {Association for Computing Machinery},
 title = {Partially-static data as free extension of algebras},
 url = {https://doi.org/10.1145/3236795},
 volume = {2},
 year = {2018}
}
