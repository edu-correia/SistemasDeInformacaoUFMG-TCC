@article{Lee2012341,
 abstract = {Relational database (RDB) is an adequate tool for rendering concepts, their attributes and relations between them that relate to a target domain. However, RDB has a certain limitation that does not fully allow it to render the semantics or meanings within concepts and their relations even though it has many advantages in representing the relations between concepts. In this paper, we propose a framework which can automatically construct an ontology from an RDB schema. We try to help understand about data structure by clearly identifying the semantic relations between data through the ontology construction. The ontology is constructed on the better understanding about data structure and acts as an assistant tool to efficiently query the data from RDB. © 2012 Springer-Verlag.},
 author = {Lee, Hyun Jung and Sohn, Mye},
 doi = {10.1007/978-3-642-28490-8_36},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 number = {PART 2},
 pages = {341 - 350},
 publication_stage = {Final},
 source = {Scopus},
 title = {DB schema based ontology construction for efficient RDB query},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84863346888?origin=resultslist},
 volume = {7197 LNAI},
 year = {2012}
}
