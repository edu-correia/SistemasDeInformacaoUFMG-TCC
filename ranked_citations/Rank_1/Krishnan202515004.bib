@conference{Krishnan202515004,
 abstract = {Creating realistic images from text descriptions is a complex challenge in computer vision and artificial intelligence. In this project, we explore a novel approach using Conditional Generative Adversarial Networks (cGANs) to tackle this problem. Our method conditions the image generation process on textual input, enabling the model to generate visuals that closely match given descriptions. The CGAN framework consists of two key components: a generator that creates images from random noise combined with textual data, and a discriminator that evaluates whether the images are real or AI-generated. Through an adversarial training process, both networks improve over time—the generator learns to produce more convincing images, while the discriminator gets better at distinguishing real from fake. To enhance the model’s ability to understand and interpret text, we incorporate text embedding and attention mechanisms, allowing it to effectively merge textual and visual information. Our experiments demonstrate that this approach produces high-quality images conditioned on diverse textual descriptions across different datasets. This method has exciting potential applications, including generating images for virtual environments, aiding content creation, and improving accessibility for visually impaired individuals by bringing textual descriptions to life. © Grenze Scientific Society, 2025.},
 author = {Krishnan, Hari K.S. and Senthil, J. and Nisha, Barakkath U.},
 journal = {16th International Conference on Advances in Computing, Control, and Telecommunication Technologies, ACT 2025},
 note = {Cited by: 0},
 pages = {15004 - 15007},
 publication_stage = {Final},
 source = {Scopus},
 title = {Synthetic Image Generation using Generative Adversarial Networks (GANs)},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105034861746?origin=resultslist},
 volume = {2},
