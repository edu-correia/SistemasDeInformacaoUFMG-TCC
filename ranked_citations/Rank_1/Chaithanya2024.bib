@conference{Chaithanya2024,
 abstract = {The Design and analysis of a Programmable Clock Management Unit Using Clock Dividers and Clock Gating employing a Cadence project aimed at adapting clock management by addressing critical problems associated with clock power consumption and energy efficiency within the electronic devices. It involves the generation of adaptable Clock Management Unit (CMU) that efficiently generates and distributes clock signals to various components. This work includes power management, examining and solving the challenges of managing different parts of the clock in System-on-chip (Soc) setups. We aim in designing a CMU capable of dynamically adjusting clock frequencies and implementing effective clock gating techniques. The goal of this work is to efficiently cut down the amount of power used when the system is active. Additionally, this work seeks to improve adaptability by utilizing clock dividers and clock gating through the Cadence tool. This approach allows for a more flexible and efficient control of clock signals modified to the specific needs of different components. Finally, this work is designed in the intension of making electronic circuits use less energy and work better, helping to advance modern technology.  © 2024 IEEE.},
 author = {Chaithanya, D.J. and Suhas and Prathiksha, H.L. and Shreya, R. and Ramya and Jaswanth, V.},
 doi = {10.1109/ICITEICS61368.2024.10624752},
 journal = {2024 IEEE International Conference on Information Technology, Electronics and Intelligent Communication Systems, ICITEICS 2024},
 note = {Cited by: 3},
 pages = {},
 publication_stage = {Final},
