@article{XI2026121051,
 abstract = {Accurate total phosphorus (TP) concentration modeling is crucial for eutrophication mitigation and watershed management. However, data-scarce regions pose challenges: process-based models have parametric uncertainties, while data-driven approaches lack physical interpretability. To leverage their complementary strengths, we developed an innovative coupled framework integrating the Soil and Water Assessment Tool (SWAT) with a Long Short-Term Memory (LSTM) neural network. In the Yihe River Basin (2021–2023), standalone SWAT simulated daily TP concentration poorly (NSE=0.08), highlighting limitations of independent physical modeling. Systematic comparison of SWAT, LSTM, and SWAT-LSTM showed the coupled model achieved satisfactory validation performance: Nash-Sutcliffe Efficiency (NSE)= 0.80, a 0.72 improvement over SWAT and 0.10 over LSTM. It also had superior generalization, evidenced by the lowest Root Mean Square Error (RMSE) and minimal deviation. Data scarcity tests confirmed SWAT-LSTM’s optimal performance and stability across scenarios: even with only 40 % training data retained, its NSE stayed above 0.70, demonstrating strong adaptability to limited observations. SHapley Additive exPlanations (SHAP) analysis identified runoff and precipitation as key drivers of TP concentration variations, which is consistent with the role of hydrological transport in watershed TP migration. Among SWAT-derived hydrological variables, lateral flow (LAT_Q) and soil water content (SW) were critical for boosting the coupled model’s accuracy, underscoring the value of merging physical mechanisms with data-driven modeling. This study advances a TP prediction framework for data-scarce watersheds and offers actionable insights for river water quality management.},
 author = {Xiuzi Xi and Pu Wang and Yongqiang Wang and Wei Zhan and Fang Liu and Chunshuang Liu and Qiyou Liu},
 doi = {https://doi.org/10.1016/j.jece.2026.121051},
 issn = {2213-3437},
 journal = {Journal of Environmental Chemical Engineering},
 keyword = {SWAT-LSTM, Coupled modeling, Phosphorus concentration simulation, Shapely additivity explanation, Yihe River basin},
 number = {1},
 pages = {121051},
 title = {Coupling SWAT and LSTM models for enhanced daily phosphorus concentration forecasting in data-scarce watersheds},
 url = {https://www.sciencedirect.com/science/article/pii/S2213343726000254},
 volume = {14},
 year = {2026}
}
