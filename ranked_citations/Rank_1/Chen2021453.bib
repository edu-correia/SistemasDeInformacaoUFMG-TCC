@conference{Chen2021453,
 abstract = {Persistent key-value storage with high write perform-ance is mainly built on Log-Structured-Merge Tree (LSM-tree), but LSM-tree has inherent high I/O amplification problems. Key-value separation reduces the problem of I/O amplification by storing only the keys in the LSM-tree. However, the current key-value separation design does not fully consider the speed difference between sequential writing and random writing. And because of garbage collection, subsequent write operations will be affected and cause write pauses. The purpose of HSKV is to achieve high update performance in key-value separation under update-intensive workloads. HSKV uses hash-based data grouping to sequentially write key-value pairs into storage, and cache hot data in the memory to speed up reading and writing. We evaluate HSKV with some existing storage systems, and HSKV can increase the update throughput by up to 4.5×. © 2021 IEEE.},
 author = {Chen, Shanshan and Ma, Zhenyu and Gao, Jun and An, Wentao},
 doi = {10.1109/ICFTIC54370.2021.9647368},
 journal = {2021 IEEE 3rd International Conference on Frontiers Technology of Information and Computer, ICFTIC 2021},
 note = {Cited by: 0},
 pages = {453 - 456},
 publication_stage = {Final},
 source = {Scopus},
 title = {HSKV: A Key-Value Storage Scheme Using Hash to Reduce Write Pause},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85124343872?origin=resultslist},
 year = {2021}
