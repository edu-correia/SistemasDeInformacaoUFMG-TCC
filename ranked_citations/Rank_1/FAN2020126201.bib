@article{FAN2020126201,
 abstract = {We have analyzed and discussed a flat-top Brewster filter that works in full conical mounting. Results reveal that flat-top reflection band can be formed by merging double peaks that corresponded to guided modes with different polarization states. Merging is achieved by adjusting the incident angle in the design. When the proposed single-layer waveguide grating structure is irradiated with transverse magnetic (TM) polarized plane wave at the Brewster angle, the filter has a highly efficient flat-top reflection spectral response with central wavelength of 547 nm, bandwidth of 15.5 nm (R > 90%), and sideband reflectance of <2.3%.},
 author = {Lina Fan and Kehui Jia and Jinqiao Sha and Zhaoliang Cao and Junshan Ma},
 doi = {https://doi.org/10.1016/j.optcom.2020.126201},
 issn = {0030-4018},
 journal = {Optics Communications},
 keyword = {Guided mode resonance, Flat-top filter, Brewster angle, Full conical mounting},
 pages = {126201},
 title = {Flat-top Brewster filter based on guided mode resonance effect},
 url = {https://www.sciencedirect.com/science/article/pii/S0030401820306180},
 volume = {475},
 year = {2020}
}
