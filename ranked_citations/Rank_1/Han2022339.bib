@conference{Han2022339,
 abstract = {With the advancement of new engineering, matrix computation is an indispensable mathematical tool in big data processing, which is widely used in the fields of image processing, machine learning, pattern recognition and so on. This paper aims to by means of interaction platform, such as MOOC, QQ Group and Rain Classroom, design the teaching mode of the matrix computation course to help students to learn how to solve the engineering problems. An example is given to show the applications of singular value decomposition in imaging pressing. Through the teaching practice of 2019-2020 academic year, the course of matrix computation integrates the advantages of online and offline teaching, and promote students' research ability and innovative spirit in the experimental process.  © 2022 IEEE.},
 author = {Han, Le},
 doi = {10.1109/ICEKIM55072.2022.00082},
 journal = {Proceedings - 2022 3rd International Conference on Education, Knowledge and Information Management, ICEKIM 2022},
 note = {Cited by: 0},
 pages = {339 - 342},
 publication_stage = {Final},
 source = {Scopus},
 title = {Design and applications of matrix computation based on online and offline integration combined with engineering problems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85147918681?origin=resultslist},
 year = {2022}
}
