@article{HernándezCallejo2020_307,
 abstract = {ABSTRACT Energy efficiency is a key element in the Smart Cities (SC), in which integration of renewable sources is a reality. Small-scale integration is usually implemented with photovoltaic (PV) and solar thermal energy. The shadows on the PV modules are a reality as they are originated by unavoidable buildings and obstacles existing in the cities. These shadows will cause the decrease in PV efficiency. Therefore, the increase in PV efficiency is essential. This increase in efficiency can be achieved by associating the DC-DC converters (DC-DC optimizers) with PV modules. This work presents and compares simulations and real results of the influence of DC-DC optimizers in the efficiency of PV modules. In addition, the work includes an economic study of the installation of DC optimizers considering three different electricity price scenarios.},
 author = {Hernández-Callejo, Luis and Gallardo-Saavedra, Sara and Diez-Cercadillo, Alejandro and Alonso-Gómez, Víctor},
 doi = {10.17533/udea.redin.20190521},
 number = {94},
 pages = {43--55},
 title = {Analysis of the influence of DC optimizers on photovoltaic production},
 year = {2020}
}
