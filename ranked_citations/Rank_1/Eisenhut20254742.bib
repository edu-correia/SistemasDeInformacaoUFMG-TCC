@article{Eisenhut20254742,
 abstract = {Heuristic search is a prominent method for plan generation in classical planning. Here we address its use for a new problem that we baptize action optimality checking (AOC): checking whether a given action a is optimal in a given state s. AOC has various potential uses, e.g. quality assurance for learned action policies through checking example policy decisions. A vanilla algorithm for AOC is to run two A<sup>?</sup> searches, on each of s and the outcome state s′ of applying a. We show that one can do much better than this. We introduce early termination criteria across multiple searches. Beyond this, we introduce AOCA<sup>?</sup>, which performs a single search on s that gives preference to paths going through s′. Our experiments show that AOCA<sup>?</sup> is superior to the vanilla algorithm as well as other multiple-search configurations, consistently across three different state-of-the-art heuristic functions. © 2025 The Authors.},
 author = {Eisenhut, Jan and Fišer, Daniel and Ruml, Wheeler and Hoffmann, Jörg},
 doi = {10.3233/FAIA251381},
 journal = {Frontiers in Artificial Intelligence and Applications},
 note = {Cited by: 0; All Open Access; Green Open Access; Hybrid Gold Open Access},
 pages = {4742 - 4749},
 publication_stage = {Final},
 source = {Scopus},
 title = {Is This a Good Decision? Action Optimality Checking in Classical Planning},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105024448608?origin=resultslist},
 volume = {413},
 year = {2025}
}
