@article{10.1145/3795134,
 abstract = {This article provides a comprehensive systematic review of the literature on entity linking using Wikidata as the grounding knowledge base. Our review extends the scope of previous studies from two to eight dimensions of entity linking, which we classify into the following categories: definitions, tasks, types, domains, approaches, datasets, applications, and challenges. We find that datasets primarily address question-answering and news domains but underutilize Wikidata’s capabilities for hyper-relations, multilingualism, and time dependence. The research gaps we identify include the need for more robust datasets, hybrid methods combining rule-based and learning-based approaches, and improved handling of ambiguity, sparse entity types, data noise, and knowledge graph evolution.},
 address = {New York, NY, USA},
 articleno = {227},
 author = {Scharpf, Philipp and Breitinger, Corinna and Spitz, Andreas and Meuschke, Norman and Greiner-Petter, Andr\'{e} and Schubotz, Moritz and Gipp, Bela},
 doi = {10.1145/3795134},
 issn = {0360-0300},
 issue_date = {July 2026},
 journal = {ACM Comput. Surv.},
 keyword = {Entity linking, named entity recognition, wikidata},
 month = {February},
 number = {9},
 numpages = {50},
 publisher = {Association for Computing Machinery},
 title = {Entity Linking with Wikidata: A Systematic Literature Review},
 url = {https://doi.org/10.1145/3795134},
 volume = {58},
 year = {2026}
}
