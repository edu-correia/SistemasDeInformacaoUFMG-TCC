@inproceedings{9535628,
 abstract = {This paper analyses the deep image compression system that contains an encoder, quantizer, entropy model and decoder optimized by a joint rate-distortion framework. The current model implements a channel-level variable quantization network to dynamically allocate and withdraw the bitrates from significant and negligible channels. Its main specific is the usage of the variable quantization controller that consists of such components: channel importance module that dynamically learns the importance of channels during the training, and splitting-merging module, which allocates different bitrates of the channels. Quantizer implements the Gaussian mixture model manner. The paper is a continuation of several similar research done before that first provided an idea and architecture of the model. The main goals of the proposed work are to do a deeper analysis of the system, verify and improve the model effectiveness. The experiments validate that the hyper-parameter tuning approach proposed here successfully improves the rate-distortion performance of image compression in terms of various quality metrics such as PSNR, MS-SSIM and BPP.},
 author = {Vasylenko, Dmytro and Stirenko, Sergii and Gordienko, Yuri},
 booktitle = {IEEE EUROCON 2021 - 19th International Conference on Smart Technologies},
 doi = {10.1109/EUROCON52738.2021.9535628},
 issn = {},
 keyword = {Training;Measurement;Analytical models;Image coding;Quantization (signal);Bit rate;Neural networks;Convolutional neural networks;Deep learning;Deep Image Compression;Channel-Level Variable Quantization;Deep Neural Networks},
 month = {July},
 number = {},
 pages = {135-139},
 title = {Improvement of Image Compression Performance by Deep Neural Networks},
 volume = {},
 year = {2021}
}
