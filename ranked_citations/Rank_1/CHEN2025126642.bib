@article{CHEN2025126642,
 abstract = {Federated semantic segmentation aims to leverage collaborative learning across multiple clients to construct a global model, ensuring privacy while achieving precise pixel-level classification. In the complex and diverse task of personalized semantic segmentation applications, the global models obtained by existing methods through federated learning still face many challenges. For example, it is difficult to personalize the training of global models in the absence of a vast amount of locally labeled data. In addition, even if the personalized training is completed with a lot of human and material resources, existing methods still face the problem of distribution shifts during test time. To address these challenges, this paper proposes a novel method called EFfective Test-time Personalization for Federated Semantic Segmentation (EFTP). EFTP proposes a personalized visual prompt approach that directly captures inherent knowledge from unlabeled local data, thereby reducing the reliance on large amounts of labeled data for global model personalization. Moreover, EFTP introduces a novel model merging strategy that dynamically combines global knowledge with local personalization to guide the adaptation process. This strategy ensures robust generalization across diverse data distributions while preserving the benefits of personalization, effectively mitigating the degradation caused by distribution shifts between training and test data. Extensive experimentation on three datasets demonstrates the effectiveness and computational efficiency of the EFTP approach on three diverse benchmark datasets.},
 author = {Haotian Chen and Yonghui Xu and Yanyu Xu and Yibowen Zhao and Yixin Zhang and Lizhen Cui},
 doi = {https://doi.org/10.1016/j.eswa.2025.126642},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Test-time adaptation, Personalized federated semantic segmentation, Distribution shift},
 pages = {126642},
 title = {Effective test-time personalization for federated semantic segmentation},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417425002647},
 volume = {272},
 year = {2025}
}
