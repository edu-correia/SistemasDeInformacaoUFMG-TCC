@article{Wellman2022,
 abstract = {In June 2020, millions of Instagram users shared black squares along with hashtags including #BlackOutTuesday and #BlackLivesMatter before pausing their social media content for the day. At first in solidarity with the music industry, the black squares were co-opted by uninformed users hoping to show their support of Black Lives Matter in the wake of the murder of George Floyd while in police custody. Through 20 interviews with social media influencers about the #BlackLivesMatter discourse occurring on Instagram in the summer of 2020, I argue that for many influencers, the posting of black squares was performative allyship utilized strategically to build and maintain credibility with followers. Influencers were unable to genuinely merge their existing brand image with the Black Lives Matter movement long-term, resulting in the memeification of social justice activism and no substantial progress toward diversity, equity, and inclusion within the wellness creator industry on Instagram. © The Author(s) 2022.},
 author = {Wellman, Mariah L.},
 doi = {10.1177/20563051221080473},
 journal = {Social Media and Society},
 note = {Cited by: 113; All Open Access; Gold Open Access; Green Open Access},
 number = {1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Black Squares for Black Lives? Performative Allyship as Credibility Maintenance for Social Media Influencers on Instagram},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85125830817?origin=resultslist},
 volume = {8},
 year = {2022}
}
