@conference{Nagaraju202354,
 abstract = {Land use and Land Cover changes have been subject to study for longer time due to its impact on climate and environment. Identification of Land features helps in keeping track of changes occur over time. Feature extraction or identification of remote sensing images can be done using deep learning techniques such as CNN. Feature extraction on low resolution satellite images is difficult and we propose to use various deep learning techniques to effectively identify land features using CNN. In this Study we experiment with parameterize multi filter CNN which can be used as the training depth. This will help in further research towards remote sensing image analysis on feature identification using novel CNN techniques.  © 2023 IEEE.},
 author = {Nagaraju, Kiran Arakalgudu and Chaurasia, Kuldeep},
 doi = {10.1109/DeSE60595.2023.10469505},
 journal = {Proceedings - International Conference on Developments in eSystems Engineering, DeSE},
 note = {Cited by: 5},
 pages = {54 - 59},
 publication_stage = {Final},
 source = {Scopus},
 title = {Identifying Land features from satellite images using deep learning},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85189342383?origin=resultslist},
 year = {2023}
}
