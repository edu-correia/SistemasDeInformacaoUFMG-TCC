@article{11185303,
 abstract = {An accelerated shooting and bouncing ray (SBR) method for efficient radar cross section (RCS) prediction of moving electrically large target models is proposed. This method employs an adaptive merged-neighbor search (AM-NS) technique combined with a backface culling and equiphase surface blanking algorithm to accelerate the occlusion judgment of facets. To eliminate the need for continuous moving target reconstruction, a quaternion algebra rotation matrix is preintroduced to achieve the transformation among the global coordinate system, the local coordinate system, and the projected coordinate system (PCS). For first-order scattering, the backface culling and equiphase surface blanking algorithm is utilized to reduce the 3-D processing to a 2-D graphic display in the PCS, accelerating shadow elimination. High-order ray tracing is accelerated using the AM-NS technique, which mitigates the efficiency loss caused by traversing empty nodes in conventional octree structures. The accuracy of the proposed method was validated by comparison with results from an accurate full-wave numerical method. A performance comparison with the traditional SBR method reveals a computational efficiency improvement of approximately 4 to 6 times, confirming the enhanced effectiveness of the proposed method in RCS prediction for moving electrically large target.},
 author = {He, Yuanyuan and Gu, Jihong and Cong, Zhou and Ding, Dazhi},
 doi = {10.1109/LAWP.2025.3616328},
 issn = {1548-5757},
 journal = {IEEE Antennas and Wireless Propagation Letters},
 keyword = {Scattering;Ray tracing;Computational modeling;Merging;Octrees;Accuracy;Computational efficiency;Vectors;Prediction algorithms;Faces;Electrically large target;neighbor search techni- que;occlusion judgment;shooting and bouncing ray (SBR) method},
 month = {Jan},
 number = {1},
 pages = {49-53},
 title = {Adaptive Merged-Neighbor Search Enhanced SBR Method for EM Scattering of Moving Target},
 volume = {25},
 year = {2026}
}
