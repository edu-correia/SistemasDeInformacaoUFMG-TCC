@conference{Wei20191526,
 abstract = {Computing the functional dependencies that hold on a given data set is one of the most important problems in data profiling. Utilizing new data structures and original techniques for the dynamic computation of stripped partitions, we devise a new hybridization strategy that outperforms the best algorithms in terms of efficiency, column-, and row-scalability. This is demonstrated on real-world benchmark data. We further propose the number of redundant data values for ranking the output of discovery algorithms. Our ranking assesses the relevance of functional dependencies for the given data set. © 2019 IEEE.},
 author = {Wei, Ziheng and Link, Sebastian},
 doi = {10.1109/ICDE.2019.00137},
 journal = {Proceedings - International Conference on Data Engineering},
 note = {Cited by: 42},
 pages = {1526 - 1537},
 publication_stage = {Final},
 source = {Scopus},
 title = {Discovery and ranking of functional dependencies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85067982773?origin=resultslist},
 volume = {2019-April},
 year = {2019}
}
