 number = {7},
 pages = {2598 - 2609},
 publication_stage = {Final},
 source = {Scopus},
 title = {Word spotting in historical printed documents using shape and sequence comparisons},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84857995767?origin=resultslist},
