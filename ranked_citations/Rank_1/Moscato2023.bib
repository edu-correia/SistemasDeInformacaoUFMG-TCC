@article{Moscato2023,
 abstract = {Recent years have seen an exponential growth (+98% in 2022 w.r.t. the previous year) of the number of research articles in the few-shot learning field, which aims at training machine learning models with extremely limited available data. The research interest toward few-shot learning systems for Named Entity Recognition (NER) is thus at the same time increasing. NER consists in identifying mentions of pre-defined entities from unstructured text, and serves as a fundamental step in many downstream tasks, such as the construction of Knowledge Graphs, or Question Answering. The need for a NER system able to be trained with few-annotated examples comes in all its urgency in domains where the annotation process requires time, knowledge and expertise (e.g., healthcare, finance, legal), and in low-resource languages. In this survey, starting from a clear definition and description of the few-shot NER (FS-NER) problem, we take stock of the current state-of-the-art and propose a taxonomy which divides algorithms in two macro-categories according to the underlying mechanisms: model-centric and data-centric. For each category, we line-up works as a story to show how the field is moving toward new research directions. Eventually, techniques, limitations, and key aspects are deeply analyzed to facilitate future studies. © 2023 Copyright held by the owner/author(s).},
 author = {Moscato, Vincenzo and Postiglione, Marco and Sperlí, Giancarlo},
 doi = {10.1145/3609483},
 journal = {ACM Transactions on Intelligent Systems and Technology},
 note = {Cited by: 25; All Open Access; Hybrid Gold Open Access},
 number = {5},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Few-shot Named Entity Recognition: Definition, Taxonomy and Research Directions},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85174921341?origin=resultslist},
 volume = {14},
 year = {2023}
}
