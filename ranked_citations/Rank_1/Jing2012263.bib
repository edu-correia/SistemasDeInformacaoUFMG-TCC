@conference{Jing2012263,
 abstract = {We design a convenience way in plant research, which can classify the hibernal plants automatically. Different features related to this model will be taken into consideration, and other influenced facts will be included as well. The main points of the classification should be picked out and we will implement the system according to them and on the basis of Bayes. The Bayes Network is in use of coefficient learning so that we can get the advantages of adaptive learning and the best effects of classification through self-learning and adjusting parameters according to actual data. In this way, the problem of classifying hibernal plant automatically is solved and the result of experiment will be showed in the paper. © 2012 IEEE.},
 author = {Jing, Xia},
 doi = {10.1109/ISISE.2012.65},
 journal = {Proceedings of the 2012 4th International Symposium on Information Science and Engineering, ISISE 2012},
 note = {Cited by: 2},
 pages = {263 - 265},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Bayesian network based intelligent plant classification system},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84877655145?origin=resultslist},
 year = {2012}
}
