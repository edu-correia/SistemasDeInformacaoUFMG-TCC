@article{WU2026106233,
 abstract = {Image fusion aims to merge complementary information from several images exhibiting different modalities to generate more informative images and facilitate downstream applications. However, most existing fusion algorithms mainly focus on enhancing the visual appeal of the fused image. This paper proposes a Comprehensive Interactive Feature Mapping for Semantic-Aware Segmentation Fusion (CIFMSegFusion) algorithm that combines image segmentation and fusion. By incorporating a fusion network, a segmentation network, and a Comprehensive Interactive Feature Mapping Module (CIFMM), the proposed approach generates images of high visual quality and rich semantic information. The fusion network uses a hybrid CNN and Transformer encoder structure to acquire both global and fine-grained features. Additionally, the CIFMM leverages the semantic features provided by the segmentation network to accurately map and complementarily enhance the semantic information of the underlying infrared and visible images. The obtained results are qualitatively and quantitatively compared with several traditional fusion algorithms and six end-to-end methods on the MSRS, LLVIP, M3FD, TNO, and RoadScene datasets. The experimental results demonstrate that the proposed method outperforms the other methods in semantic segmentation and texture detail retention.},
 author = {Quan Wu and Zhiwei Chen and Haitao Lin and Qida Yu and Fuju Yan},
 doi = {https://doi.org/10.1016/j.infrared.2025.106233},
 issn = {1350-4495},
 journal = {Infrared Physics & Technology},
 keyword = {Infrared and Visible Image Fusion, Convolutional Neural Network, Transformer},
 pages = {106233},
 title = {Semantic-aware segmentation fusion with comprehensive interactive feature mapping},
 url = {https://www.sciencedirect.com/science/article/pii/S1350449525005262},
 volume = {152},
 year = {2026}
}
