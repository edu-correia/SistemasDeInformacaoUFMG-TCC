@incollection{YORO20263,
 abstract = {Achieving net-zero emissions – tilting the balance on greenhouse gas (GHG) emissions released versus GHGs removed from the atmosphere – is an important step in the global fight against climate change. The development of the necessity for net zero in the past and its significance under the Paris Agreement and Intergovernmental Panel on Climate Change (IPCC), which emphasises reaching global net zero by 2050 to limit temperature rise at 1.5 °C, is explored in this chapter. This study is focused on the following: (1) review of key technological, policy and financial drivers of net zero; (2) sectoral assessesment of GHG emissions contribution and (3) recommendation of holistic mitigation and adaptation pathways. The study applies a multidisciplinary methodology that combines policy analysis, technology readiness assessment and emissions intensity modelling. Major findings from this chapter are that energy contributes up to 82% of GHG emissions, and measures such as integration of renewables, electrification and carbon capture and storage can reduce emissions by over 90% in energy systems. Negative emission technologies such as bioenergy with carbon capture and storage and direct air capture can remove 1,170 GtCO₂ by the year 2100. This chapter directly fulfils three United Nations Sustainable Development Goals: SDG 7 (affordable and clean energy), SDG 13 (climate action) and SDG 9 (industry, innovation and infrastructure). The major contribution to the body of knowledge in this field from this chapter is the merged synthesis of sectoral technical roadmaps, international policy instruments and net-zero-proof solutions. Future applications include installations of smart grids, growth in hydrogen economies, circular economies and ocean-borne carbon capture. This chapter opens the gates for energy, industry and agricultural systems to become a resilient, fair and net-zero global economy.},
 author = {Kelvin O. Yoro and Orevaoghene Eterigho-Ikelegbe and Rasaq O. Medupin},
 booktitle = {Net ZERO},
 doi = {https://doi.org/10.1016/B978-0-443-36426-6.00019-8},
 editor = {Farooq Sher},
 isbn = {978-0-443-36426-6},
 keyword = {Climate change, net zero emissions, energy efficiency, carbon capture and storage, sustainable development, energy policy, emissions, environmental policy, energy resources},
 pages = {3-57},
 publisher = {Elsevier},
 title = {Chapter 1 - Introduction to net-zero emissions},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443364266000198},
 year = {2026}
}
