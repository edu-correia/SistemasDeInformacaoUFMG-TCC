 keyword = {Memristors;Neuromorphics;Computer architecture;Speech recognition;Energy efficiency;Speech;Training;memristors;future computing;bio-inspired pattern processing;memristor logic;neuromorphic memristor crossbar;cellular nanoscale network},
 month = {Oct},
 number = {},
 pages = {456-459},
 title = {Memristor circuits and systems for future computing and bio-inspired information processing},
