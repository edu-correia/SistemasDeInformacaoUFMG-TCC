@conference{Pražák2019967,
 abstract = {We present a live cross-lingual system capable of producing shallow semantic annotations of natural language sentences for 51 languages at this time. The domain of the input sentences is in principle unconstrained. The system uses single training data (in English) for all the languages. The resulting semantic annotations are therefore consistent across different languages. We use CoNLL Semantic Role Labeling training data and Universal dependencies as the basis for the system. The system is publicly available and supports processing data in batches; therefore, it can be easily used by the community for research tasks. © 2019 Association for Computational Linguistics (ACL). All rights reserved.},
 author = {Pražák, Ondřej and Konopík, Miloslav},
 doi = {10.26615/978-954-452-056-4_112},
 journal = {International Conference Recent Advances in Natural Language Processing, RANLP},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 pages = {967 - 972},
 publication_stage = {Final},
 source = {Scopus},
 title = {UlsaNA: Universal language semantic analyzer},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85076495632?origin=resultslist},
 volume = {2019-September},
 year = {2019}
}
