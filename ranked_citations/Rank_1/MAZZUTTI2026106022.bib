@article{MAZZUTTI2026106022,
 abstract = {Seismic reservoir characterization aims to accurately estimate rock and fluid properties, which is essential to optimize production and mitigate risks in hydrocarbon exploration projects. In this context, the Incremental Gaussian Mixture Network (IGMN) emerges as an innovative technique, enabling incremental data updates and probabilistic estimations of elastic and petrophysical properties in dynamic environments. Unlike traditional Gaussian Mixture Models (GMMs), which require a prior definition of the number of components, the IGMN adaptively determines the number of Gaussian distributions as it processes new data. This capability allows the model to better capture the underlying data structure without relying on fixed training datasets or manual model selection criteria. The IGMN approach facilitates the continuous integration of seismic and well data, enhancing prediction accuracy while accommodating complex geological variability and inherent uncertainties. This work explores the application of IGMN in elastic and petrophysical seismic inversion, demonstrating how its use contributes to the development of more adaptive and robust models. The proposed IGMN workflow combines the strengths of Bayesian inference and Gaussian mixture modeling, offering a sequential and computationally efficient approach capable of capturing multimodal patterns, quantifying uncertainty, and adapting to new data without retraining. The results indicate that IGMN enhances the estimation of reservoir properties, offering a practical approach for geophysical interpretation and reservoir management under uncertain conditions.},
 author = {Tiago Mazzutti and Mauro Roisenberg and Bruno B. Rodrigues},
 doi = {https://doi.org/10.1016/j.cageo.2025.106022},
 issn = {0098-3004},
 journal = {Computers & Geosciences},
 keyword = {Reservoir modeling, Incremental Gaussian Mixture Network, Petrophysical inversion, Incremental learning, Uncertainty propagation},
 pages = {106022},
 title = {Incremental Gaussian Mixture Neural model for Geophysical inverse problems},
 url = {https://www.sciencedirect.com/science/article/pii/S0098300425001724},
 volume = {206},
 year = {2026}
}
