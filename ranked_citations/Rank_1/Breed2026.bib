@conference{Breed2026,
 abstract = {Bio-digital systems that merge microbial life with technology promise new modes of computation, combining biological adaptability with digital precision. Yet realizing this potential symbiotically - where biological and digital agents co-adapt and co-process - remains elusive, largely due to the absence of a shared vocabulary bridging biology and computing. Consequently, microbes are often constrained to uni-directional roles, functioning as sensors or actuators rather than as active, computational partners in bio-digital systems. In response, we propose a taxonomy and pathways that articulate and expand the roles of biological and digital entities for synergetic bio-digital computation. Using this taxonomy, we analysed 70 systems across HCI, design, and engineering, identifying how biological mechanisms can be mapped onto computational abstractions. We argue that such mappings enable computationally actionable directions that foster richer and reciprocal relationships in bio-digital systems, supporting regenerative ecologies across time and scale while inspiring new paradigms for computation in HCI. © 2026 Copyright held by the owner/author(s).},
 author = {Breed, Zoë and Karana, Elvin and Bozzon, Alessandro and Song, Katherine W},
 doi = {10.1145/3772318.3790657},
 journal = {Conference on Human Factors in Computing Systems - Proceedings },
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Entangled Life and Code: A Computational Design Taxonomy for Synergistic Bio-Digital Systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105038712573?origin=resultslist},
 year = {2026}
}
