@conference{Amer20065,
 abstract = {The latest video standards such as ITU-T H.264 and MPEG-4 Part 10 introduce important bitrate gains but at the cost of increased complexity, especially at the encoder. One important tool is the variable block sizes motion estimation/compensation, which presents the possibility of using blocks ranging from 16×16 down to 4×4, offering the choice of one macroblock configuration out of 259 modes. This paper suggests a new method to select efficiently one variable block sizes partitioning mode based on a single set of motion estimation results at the smallest granularity (4×4 blocks). The results show the accuracy of the decision method, while requiring a minimal number of searches from the motion estimation algorithm. The technique also maintains an acceptable complexity for a potential real time implementation. © 2006 IEEE.},
 author = {Amer, Ihab and Chirila-Rus, Adrian and Badawy, Wael and Jullien, Graham},
 doi = {10.1109/IWSOC.2006.348254},
 journal = {Proceedings - The 6th IEEE International Workshop on System on Chip for Real Time Applications, IWSOC 2006},
 note = {Cited by: 2},
 pages = {5 - 9},
 publication_stage = {Final},
 source = {Scopus},
 title = {An efficent variable block size selection scheme for the H.264 motion estimation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/46249086422?origin=resultslist},
 year = {2006}
}
