@conference{Fernandez2025,
 abstract = {Classification problems are fundamental in machine learning, with applications in fields such as medical diagnosis, image recognition, and fraud detection. The Learning Algorithm for Multivariate Data Analysis (LAMDA) is a state-of-the-art technique for these tasks. On the other hand, quantum computing has recently emerged as a new approach to enhance computational efficiency. The present work studies the integration of the LAMDA algorithm with quantum computing techniques for classification tasks. For that, this work presents the implementation of a quantum version of LAMDA for binary classification and compares it with a classical LAMDA and several versions of Support vector machine (SVM), including a quantum one, in several datasets. The initial results are very promising, surpassing previous results obtained with LAMDA in all tests performed. ©2025 IEEE.},
 author = {Fernandez, Álvaro and Lillo, Rosa and Aguilar, Jose and Hoyos, William},
 doi = {10.1109/SCCC67219.2025.11420614},
 journal = {Proceedings - International Conference of the Chilean Computer Science Society, SCCC},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Quantum LAMDA in Binary Classification Problems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105037106030?origin=resultslist},
 year = {2025}
}
