@inproceedings{11495663,
 abstract = {Hundreds of millions of people around the world are affected by rare illnesses, but they are hard to predict because of insufficient data. This paper presents a few-shot learning (FSL) system using structured clinical information, designed to be understandable and accessible. It is built by merging Prototypical Networks with episodic training and t-SNE-based visualization of the embedding space to produce interpretable predictions. A controlled synthetic experiment was conducted to simulate the problem of class imbalance between common and rare diseases, and to demonstrate proof of concept. The model achieved an average accuracy of $61.1 \% (\pm 6.7\%)$ and a macro F1-score of $60.5\% (\pm 6.7 \%)$, outperforming a logistic regression baseline $(58.7 \% \pm 6.3 \%$ accuracy). This indicates that metric-based meta-learning can generalize to previously unseen diseases with only a few examples, while providing interpretable explanations for its predictions.},
 author = {Menon, Nandana Rajesh and V, Rohini and Rajoriya, Meenakshi Malviya},
 booktitle = {2026 World Conference on Computational Science and Technology (WcCST)},
 doi = {10.1109/WcCST67302.2026.11495663},
 issn = {},
 keyword = {Central Processing Unit;MIMICs;Electronic circuits;Millimeter wave integrated circuits;Monolithic integrated circuits;Protocols;Radio access networks;Regional area networks;HTTP;Communication systems;few-shot learning;rare disease;meta-learning;healthcare AI;interpretability;Prototypical Networks;Relation Networks},
 month = {March},
 number = {},
 pages = {573-578},
 title = {A Lightweight Few-Shot Framework for Rare Disease Prediction},
 volume = {},
