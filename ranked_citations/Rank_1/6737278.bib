@article{6737278,
 abstract = {An integrated diversity antenna based on dual-feed cavity-backed slot is proposed and studied. The design is based on merging two slots into a diversity Y-shaped slot antenna using an inverted configuration. In order to achieve good isolation between the two slots, a slot stub is added at the merging corner part forming a Y-shaped slot antenna. The effects of different angles of the Y-junction in the diversity antenna on the mutual coupling are analyzed through HFSS simulations. The diversity performance of the proposed antenna is also evaluated by calculating the envelope correlation coefficient and mean effective gain ratio using the measured S-parameter results.},
 author = {Zhang, Qichun and Jiang, Daoan and Wu, Wen},
 doi = {10.1109/LAWP.2014.2305720},
 issn = {1548-5757},
 journal = {IEEE Antennas and Wireless Propagation Letters},
 keyword = {Slot antennas;Antenna measurements;Feeds;Microstrip antennas;Mutual coupling;Cavity-backed slot;diversity antenna;isolation;slot antennas},
 month = {},
 number = {},
 pages = {301-304},
 title = {An Integrated Diversity Antenna Based on Dual-Feed Cavity-Backed Slot},
 volume = {13},
 year = {2014}
}
