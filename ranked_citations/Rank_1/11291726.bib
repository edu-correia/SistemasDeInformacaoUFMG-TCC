@inproceedings{11291726,
 abstract = {Content-based image retrieval (CBIR) systems seek to identify exactly or quite similar images in large databases using just the image content, not the textual metadata. Regarding sophisticated image recognition, conventional CBIR techniques based on handcrafted elements fail. These characteristics cannot express high-level semantic information. This work presents an Enhanced CBIR algorithm that improves retrieval efficiency and accuracy by merging clustering approaches with deep feature extraction via a CNN that has already been trained. Clustering using K-means groups related images and minimizes the search space after deep feature extraction from input images to depict their semantic content. The proposed approach beats more traditional methods, even on benchmark sets, regarding recall and precision. The results unequivocally show that combining deep learning with clustering accelerates retrieval relevance and significantly increases it. The approach is straightforward and easily multiplied for pragmatic applications in many different spheres.},
 author = {MuhssanAlmusawi, Muntadher and Madhavi, Karanam and Panika, Satpal and Jeyanthi, S and Bhanu, D.},
 booktitle = {2025 3rd International Conference on Cyber Resilience (ICCR)},
 doi = {10.1109/ICCR67387.2025.11291726},
 issn = {},
 keyword = {Deep learning;Visualization;Accuracy;System performance;Semantics;Image retrieval;Metadata;Feature extraction;Convolutional neural networks;Resilience;Visual Similarity;Clustering;Image Search;k-means;Deep Feature Extraction;Content-Based Image Retrieval;Convolutional Neural Network},
 month = {July},
 number = {},
 pages = {1-7},
 title = {Deep Feature-Powered Content-Based Image Retrieval with Adaptive Clustering},
 volume = {},
 year = {2025}
}
