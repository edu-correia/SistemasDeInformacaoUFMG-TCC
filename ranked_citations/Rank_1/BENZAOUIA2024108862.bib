@article{BENZAOUIA2024108862,
 abstract = {Lignin, a biomass product extracted from lignocellulose (eg., wood) was emerged much more recently as a versatile building-block in the realm of macromolecular and material science and engineering. Owing to its inherent structure, lignin stands as a promising sustainable filler for improving hydrophobicity and thermal properties of the reinforced composites. Considering the well-established flame-retardant ability of phosphorus derivatives, more improvement could in principle emanate from lignin phosphorylation, but, strikingly, we noticed the scarcity of the literature on related studies. We herein report surface modification of lignin using four phosphorylated precursors, namely phosphoryl chloride, hexachlorocyclotriphosphazene, dichloro-dimethyl-aminophosphine and 4-chlorophenyl-dichlorophosphate. After extensive characterization ascertaining covalent grafting of phosphorus moieties on the lignin framework, we used the as-prepared lignin derivatives as fillers for the preparation of polyvinyl alcohol-based composites. Interestingly, the inherent structure of the starting phosphorus reagent plays a pivotal role, accounting for its intimate interplay with the polyvinyl alcohol backbone. With the entrapment of a tiny amount not exceeding 3 wt%, phosphorylated lignin fillers endow the resulting films with enhanced resistance to thermal degradation. Specifically, outstanding results were obtained using cyclotriphosphazene grafted lignin, with an impressive 60 % reduction in the heat release rate being noticed with respect to pristine polyvinyl alcohol films. Besides, more improved holistic properties could be reached by merging phosphorylated lignin and cellulose nanocrystals for filling PVA-based films, as demonstrated by our preliminary results, opening indeed more possibilities for the rational design of mechanically-robust and thermally-stable micro- and nanocomposites.},
 author = {Mohamed Amine Benzaouia and Othmane Dardari and Ghanem Hamdoun and Nadia Katir and Abdelkrim {El Kadib}},
 doi = {https://doi.org/10.1016/j.porgcoat.2024.108862},
 issn = {0300-9440},
 journal = {Progress in Organic Coatings},
 keyword = {Lignin, Phosphorylation, Polyvinly alcohol, Sustainable filler-based composites},
 pages = {108862},
 title = {Phosphorylated lignin as sustainable fillers for polyvinyl alcohol-based composites},
 url = {https://www.sciencedirect.com/science/article/pii/S0300944024006544},
 volume = {197},
 year = {2024}
}
