@conference{Zhang2018195,
 abstract = {Today's rapidly growing document volumes pose pressing challenges to modern document analytics frameworks, in both space usage and processing time. Recently, a promising method, called text analytics directly on compressed data (TADOC), was proposed for improving both the time and space efficiency of text analytics. The main idea of the technique is to enable direct document analytics on compressed data. This paper focuses on the programming challenges for developing efficient TADOC programs. It presents Zwift, the first programming framework for TADOC, which consists of a Domain Specific Language, a compiler and runtime, and a utility library. Experiments show that Zwift significantly improves programming productivity, while effectively unleashing the power of TADOC, producing code that reduces storage usage by 90.8% and execution time by 41.0% on six text analytics problems. © 2018 Association for Computing Machinery.},
 author = {Zhang, Feng and Zhai, Jidong and Shen, Xipeng and Mutlu, Onur and Chen, Wenguang},
 doi = {10.1145/3205289.3205325},
 journal = {Proceedings of the International Conference on Supercomputing},
 note = {Cited by: 24},
 pages = {195 - 206},
 publication_stage = {Final},
 source = {Scopus},
 title = {Zwift: A programming framework for high performance text analytics on compressed data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85055798394?origin=resultslist},
 year = {2018}
}
