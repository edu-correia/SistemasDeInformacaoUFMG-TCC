@conference{Pozo20258608,
 abstract = {In planning tasks, conditional effects model action outcomes that depend on the current state of the world. Conditional effects are a crucial modeling feature since compiling them away can cause an exponential growth in task size. However, only a few admissible heuristics support them. To add abstraction heuristics to this set, we show how to compute projections, Cartesian abstractions and merge- and-shrink abstractions for tasks with conditional effects. Our experiments show that these heuristics are competitive with-and often surpass-the state-of-the-art for conditional-effect tasks. © 2025 International Joint Conferences on Artificial Intelligence. All rights reserved.},
 author = {Pozo, Martín and Seipp, Jendrik},
 doi = {10.24963/ijcai.2025/957},
 journal = {IJCAI International Joint Conference on Artificial Intelligence},
 note = {Cited by: 1},
 pages = {8608 - 8616},
 publication_stage = {Final},
 source = {Scopus},
 title = {Abstraction Heuristics for Classical Planning Tasks with Conditional Effects},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105021806769?origin=resultslist},
 year = {2025}
}
