@article{AYOUBI20268,
 abstract = {Résumé
La paralysie cérébrale est la pathologie neurologique pédiatrique la plus fréquente, affectant environ 1,77 enfant sur 1000 naissances. Elle entraîne des troubles moteurs qui altèrent les habiletés manuelles et compromettent l’autonomie dans les activités quotidiennes. Le traitement vise à améliorer la mobilité, la posture et la qualité de vie des enfants à travers des principes d’apprentissage moteur intensifs incluant la répétition, la motivation et l’évolution de la difficulté. La Haute Autorité de santé recommande l’intensification de la rééducation pour maximiser les gains fonctionnels. Parmi les techniques éprouvées, deux approches se distinguent : la thérapie par le mouvement induit (CIMT) et la thérapie bimanuelle intensive (BIT). En 2018, le programme Habil’Hand a été conçu pour combiner ces deux stratégies thérapeutiques. Ce stage de rééducation intensive, qui se déroule sur deux semaines en hospitalisation conventionnelle, est le fruit du travail d’une équipe interdisciplinaire. Son objectif est de développer les capacités motrices ciblées par l’enfant et sa famille, d’intégrer le membre supérieur atteint dans les activités quotidiennes et d’améliorer la coordination bimanuelle. Ce programme met fortement l’accent sur l’utilisation des acquis dans le quotidien grâce à l’intégration des objectifs spécifiques des enfants. Habil’Hand représente une avancée dans la rééducation intensive, en combinant techniques éprouvées et approche centrée sur l’enfant.
Cerebral palsy is the most common pediatric neurological condition, affecting approximately 1.77 children per 1000 births. It results in motor impairments that hinder manual skills and compromise independence in daily activities. Treatment aims to enhance mobility, posture, and quality of life through intensive motor learning principles including repetition, motivation, and task-specific practice. The French High Authority of Health advocates for intensified rehabilitation to maximize functional gains. Among proven strategies, two approaches stand out: Constraint-Induced Movement Therapy (CIMT) and Bimanual Intensive Therapy (BIT). In 2018, the Habil’Hand program was developed to combine these two therapeutic strategies. This intensive two-week rehabilitation program, carried out in conventional hospitalization, was designed by an interdisciplinary team. Its goals include developing motor abilities targeted by the child and their family, integrating the affected upper limb into daily activities, and improving bimanual coordination. The program emphasizes applying acquired skills in everyday life while aligning with the specific objectives of each child. Habil’Hand represents progress in intensive rehabilitation by merging proven techniques with a child-centered approach.},
 author = {F. Ayoubi and G. Capolungo and M. Martinet and F. Breton and C. Gauharou and J. Cibois and E. Tijoux and E. Soyer and J. Madelaine and L. Lejeune and I. Martel and S. {Payan Terral} and A.-L. Guinet and R. Spirito and E. Desailly},
 doi = {https://doi.org/10.1016/j.motcer.2025.10.001},
 issn = {0245-5919},
 journal = {Motricité Cérébrale},
 keyword = {Rééducation intensive, Paralysie cérébrale, Thérapie bimanuelle, Neuroplasticité, Engagement fonctionnel, Intensive rehabilitation, Cerebral palsy, Bimanual therapy, Neuroplasticity, Functional engagement},
 number = {1},
 pages = {8-14},
 title = {Habil’Hand, un stage de rééducation intensive du membre supérieur de l’enfant avec paralysie cérébrale},
