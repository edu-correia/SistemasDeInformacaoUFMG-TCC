 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {RQNoC: A resilient quality-of-service network-on-chip with service redirection},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84964758705?origin=resultslist},
 volume = {15},
 year = {2016}
}
