@article{Zhang2021166,
 abstract = {We present the Succinct Range Filter (SuRF), a fast and compact data structure for approximate membership tests. Unlike traditional Bloom filters, SuRF supports both single-key lookups and common range queries, such as range counts. SuRF is based on a new data structure called the Fast Succinct Trie (FST) that matches the performance of state-of-the-art order-preserving indexes, while consuming only 10 bits per trie node - -a space close to the minimum required by information theory. Our experiments show that SuRF speeds up range queries in a widely used database storage engine by up to 5×.  © 2021 ACM.},
 author = {Zhang, Huanchen and Lim, Hyeontaek and Leis, Viktor and Andersen, David G. and Kaminsky, Michael and Keeton, Kimberly and Pavlo, Andrew},
 doi = {10.1145/3450262},
 journal = {Communications of the ACM},
 note = {Cited by: 0; All Open Access; Bronze Open Access},
 number = {4},
 pages = {166 - 173},
 publication_stage = {Final},
 source = {Scopus},
 title = {Succinct range filters},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85103218438?origin=resultslist},
 volume = {64},
