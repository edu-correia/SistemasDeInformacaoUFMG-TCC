@article{Musa2014137,
 abstract = {The emergence of the RFID technology and its application to supply chain processes has in particular led to the creation of such standards as the EPCglobal's model of supply networks as a tool for materializing intra- and inter-enterprise visibility of resources and products, collaboration and integration. Among other critical uses, RFID has been deployed by supply networks to improve asset utilization, effectively combat counterfeiting, and advance targeted product recalls. However, new affordable and deployable technologies and microsensors have recently appeared and keep maturing. This paper discusses the needs and the possibilities that exist for leveraging these technologies and sensors with RFID to guarantee continuous and seamless visibility of all assets (fixed and mobile resources and field personnel) of smart enterprises, thereby expanding and complementing the roles of RFID. It examines the design challenges for the integration of these technologies for advanced logistics operations at the level of product classes or their instances. It then outlines our development of an embedded microsystem that combines RFID, GPRS, GPS and environmental sensors for applications in logistics. The prototyped microsystem demonstrated the feasibility of the multi-sensor integration paradigm that the paper proposes. © 2013 Published by Elsevier Ltd. All rights reserved.},
 author = {Musa, Ahmed and Gunasekaran, Angappa and Yusuf, Yahaya and Abdelazim, Abdelrahman},
 doi = {10.1016/j.eswa.2013.07.017},
 journal = {Expert Systems with Applications},
 note = {Cited by: 28},
 number = {1},
 pages = {137 - 155},
 publication_stage = {Final},
 source = {Scopus},
 title = {Embedded devices for supply chain applications: Towards hardware integration of disparate technologies},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84885175688?origin=resultslist},
 volume = {41},
