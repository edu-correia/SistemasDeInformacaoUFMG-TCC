@article{LIU2024117192,
 abstract = {Micro-expressions (MEs) are unconscious, instant and slight facial movements, revealing people’s true emotions. Locating MEs is a prerequisite of classifying them, while only a few researches focus on this task. Among them, sliding window based methods are the most prevalent. Due to the differences of individual physiological and psychological mechanisms, and some uncontrollable factors, the durations and transition modes of different MEs fluctuate greatly. Limited to fixed window scale and mode, traditional sliding window based ME spotting methods fail to capture the motion changes of all MEs exactly, resulting in performance degradation. In this paper, an ensemble learning based duration & mode-aware (DMA) ME spotting framework is proposed. Specifically, we exploit multiple sliding windows of different scales and modes to generate multiple weak detectors, each of which accommodates to MEs with certain duration and transition mode. Additionally, to get a more comprehensive strong detector, we integrate the analysis results of multiple weak detectors using a voting based aggregation module. Furthermore, a novel interval generation scheme is designed to merge close peaks and their neighbor frames into a complete ME interval. Experimental results on two long video databases show the promising performance of our proposed DMA framework compared with state-of-the-art methods. The codes are available at https://github.com/TJUMMG/DMA-ME-Spotting.},
 author = {Jing Liu and Xin Li and Jiaqi Zhang and Guangtao Zhai and Yuting Su and Yuyi Zhang and Bo Wang},
 doi = {https://doi.org/10.1016/j.image.2024.117192},
 issn = {0923-5965},
 journal = {Signal Processing: Image Communication},
 keyword = {Affective computing, Micro-expression spotting, Sliding window, Ensemble learning},
 pages = {117192},
 title = {Duration-aware and mode-aware micro-expression spotting for long video sequences},
 url = {https://www.sciencedirect.com/science/article/pii/S0923596524000936},
 volume = {129},
 year = {2024}
}
