@inproceedings{11377193,
 abstract = {Breast cancer is such a heterogeneous disease, accurate and reliable profiling techniques are essential to improving diagnosis and treatment plans. It is one of the most common cancers in the world that affects women, yet it may occur in men. When abnormal cells in the breast grow out of control, they can develop into a tumor that can be felt as a lump or seen on imaging tests. The aim of this paper is to merge heterogeneous gene expression and mutation information from the METABRIC (Molecular Taxonomy of Breast Cancer International Consortium) dataset for constructing a multiclass classification model for breast cancer profiling. There was extensive preprocessing involving removal of redundant features, encoding of mutation data, class balancing, and imputation of missing values using median methods. This paper employed the capable gradient boosting algorithms XGBoost, CatBoost, and LightGBM to identify the complex patterns in the data. The models are highly regarded for their resistance to overfitting, high performance, and ability to handle structured data. The objective was to optimize calculated performance through precise feature extraction and hyperparameter modification.The performance of the ensembled model is 92% accuracy. The suitable metrics for the multiclass classification problems were used to quantify the performance of the model. One of the novel approaches for proper classification of breast cancer subtypes is the combination of gene expression and mutation profiles with recent ensemble approaches.},
 author = {Haripriya, Ch. and Kondal, K. and Kumar, S. Ajay and Sucharita, Swati and Jabbar, M. A.},
 booktitle = {2025 5th International Conference on Emerging Research in Electronics, Computer Science and Technology (ICERECT)},
 doi = {10.1109/ICERECT65215.2025.11377193},
 issn = {},
 keyword = {Resistance;Measurement;Accuracy;Taxonomy;Reliability engineering;Breast cancer;Gene expression;Ensemble learning;Tumors;Overfitting;Breast Cancer Profiling;Gene Expression Analysis;Mutation Data Integration;Multiclass Classification;Cancer Subtype Classification;Ensemble Learning},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Ensemble-Based Multiclass Classification of Breast Cancer Subtype based on genomic profiles},
 volume = {},
 year = {2025}
}
