@inproceedings{10629272,
 abstract = {The process of urbanization has significantly contributed to economic growth, improved human capabilities, and enhanced living standards. However, it has also introduced challenges in managing transportation systems, including issues such as traffic congestion, safety concerns, and pollution. To address these challenges, there is a growing adoption of intelligent technologies across various transportation applications, leading to the emergence of innovative transportation methods. This paper aims to provide the following key contributions: i) Overview of the urban transport system: The paper presents a concise explanation of the urban transport system, highlighting its importance and the need for effective management; ii) Introduction of an intelligent total transport managing system: The paper proposes the implementation of an intelligent total transport managing system that utilizes a hierarchical concept to classify different segments of transportation; iii) Integration of sensor technologies: The paper explores the integration of sensor technologies into vehicles and infrastructure to enable durable and intelligent total transport management; iv) Applications in safety, traffic management, and control: The paper discusses the potential applications of numerous sensors deployed within an intelligent transport management system, including areas such as safety, traffic management, and control. By addressing these research aspects, the paper aims to contribute to the understanding of intelligent transport management systems in urban areas. It emphasizes the significance of integrating sensor technologies and highlights their potential applications in enhancing safety, traffic management, and control. Ultimately, the findings of this research can inform the development of smarter and more efficient transportation systems in urban environments.},
 author = {Nguyen, D. Dung and Sergey, Kinzhikeyev},
