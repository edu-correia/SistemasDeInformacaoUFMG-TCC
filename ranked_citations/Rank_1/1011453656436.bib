@article{10.1145/3656436,
 abstract = {We present a compilation scheme for conditional quantumgates. Our scheme compiles amulti-qubit conditional to a linear number of two-qubit conditionals. This can be done straightforwardly with helper qubits, but we show how to do it without using helper qubits and with much fewer gates than in previous work. Specifically, our scheme requires 1/3 as many gates as the previous best scheme without using helper qubits, which is essential for practical use. Our experiments show that several quantum-circuit optimizers have little impact on the compiled code from the previous best scheme, confirming the need for our new scheme. Our experiments with Grover’s algorithm and quantum walk also show that our scheme has a major impact on the reliability of the compiled code.},
 address = {New York, NY, USA},
 articleno = {206},
 author = {Huang, Keli and Palsberg, Jens},
 doi = {10.1145/3656436},
 issue_date = {June 2024},
 journal = {Proc. ACM Program. Lang.},
 keyword = {quantum computing, compilers, code size, reliability},
 month = {June},
 number = {PLDI},
 numpages = {22},
 publisher = {Association for Computing Machinery},
 title = {Compiling Conditional Quantum Gates without Using Helper Qubits},
 url = {https://doi.org/10.1145/3656436},
 volume = {8},
 year = {2024}
}
