@conference{Wang20232835,
 abstract = {The emerging trend of memory disaggregation where CPU and memory are physically separated from each other and are connected via ultra-fast networking, e.g., over RDMA, allows elastic and independent scaling of compute (CPU) and main memory. This paper investigates how indexing can be efficiently designed in the memory disaggregated architecture. Although existing research has optimized the B-tree for this new architecture, its performance is moderate. This paper focuses on LSM-based indexing and proposes dLSM, the first highly optimized LSM-tree for disaggregated memory. dLSM introduces a suite of optimizations including reducing software overhead, leveraging near-data computing, tuning for byte-addressability, and an instantiation over RDMA as a case study with RDMA-specific customizations to improve system performance. Experiments illustrate that dLSM achieves 1.6× to 11.7× higher write throughput than running the optimized B-tree and four adaptations of existing LSM-tree indexes over disaggregated memory. dLSM is written in C++ (with approximately 41,000 LOC), and is open-sourced.  © 2023 IEEE.},
 author = {Wang, Ruihong and Wang, Jianguo and Kadam, Prishita and Tamer Özsu, M. and Aref, Walid G.},
 doi = {10.1109/ICDE55515.2023.00217},
 journal = {Proceedings - International Conference on Data Engineering},
 note = {Cited by: 27},
 pages = {2835 - 2849},
 publication_stage = {Final},
 source = {Scopus},
 title = {dLSM: An LSM-Based Index for Memory Disaggregation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85162854793?origin=resultslist},
