@conference{Ramadhan20251812,
 abstract = {Vocabulary acquisition is one of the most challenging components of foreign language learning. Spaced repetition systems such as SM-2 and FSRS improve long-term retention, but most implementations rely on flashcards and provide limited immersion or contextual use. At the same time, conversational agents powered by large language models are increasingly used in education to support adaptive and personalized learning. However, no systematic review has examined how conversational architectures and spaced repetition techniques have been combined for vocabulary learning. This paper reviews ten studies that describe architectures for conversational learning systems, spaced repetition algorithms, and LLM-based tutoring platforms. The findings show that although prior research has explored scheduling algorithms and conversational tutoring separately, very few systems integrate both in a unified architectural model. The review identifies strengths, limitations, and open challenges, and it establishes a foundation for designing conversational platforms that merge LLM interaction with adaptive spaced repetition. © 2025 IEEE.},
 author = {Ramadhan, Valdano Juliandre and Falih, Noor},
 doi = {10.1109/ICIMCIS68501.2025.11326960},
 journal = {Proceedings - 7th International Conference on Informatics, Multimedia, Cyber and Information System, ICIMCIS 2025},
 note = {Cited by: 0},
 pages = {1812 - 1817},
 publication_stage = {Final},
 source = {Scopus},
 title = {Conversational Learning Architectures for Vocabulary Acquisition: A Systematic Literature Review of LLM and Spaced Repetition Approaches},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105034938370?origin=resultslist},
 year = {2025}
}
