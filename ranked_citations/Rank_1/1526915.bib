@inproceedings{1526915,
 abstract = {This paper presents a storage and retrieval model based on XML for semi-structured information, named DBNS. Taking the underlying tree-like structure of XML document into account, it branches XML document tree into sub-trees and maps the node elements into data blocks on the storage page. With the particular data structure designed in DBNS, the branching method and mapping mechanism can preserve the integrity of the heterogeneous and context-mixed semi-structured XML data, and also support data sharing, multi-index and complex path expression queries with high efficiency.},
 author = {Li Gao and He-Ping Chen and Jin-Guang Gu and Jing-Cun Wang and Hong-Ping Fang and Xiao-Hui Li},
 booktitle = {2005 International Conference on Machine Learning and Cybernetics},
 doi = {10.1109/ICMLC.2005.1526915},
 issn = {2160-1348},
 keyword = {Information retrieval;XML;Tree data structures;Relational databases;Educational institutions;Information science;Electronic mail;Data structures;File systems;Markup languages;Storage and retrieval model;semi-structured;XML;branching;mapping},
 month = {Aug},
 number = {},
 pages = {33-38 Vol. 1},
 title = {A storage and retrieval model based on XML for semi-structured information},
 volume = {1},
 year = {2005}
}
