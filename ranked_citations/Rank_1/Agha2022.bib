@conference{Agha2022,
 abstract = {This paper describes a new architecture for 6G, the Horizontal 6G. The architecture is fully distributed and based on mobile embedded MEC (Multi-access Edge Computing) data centers. Mobile MEC nodes host all necessary processes for the life of the digital infrastructure with proximity services. This architecture is different from traditional vertical solutions by a full mobility of antennas and data centers and the use of 6G-D2D communications between edge nodes.  © 2022 IEEE.},
 author = {Agha, Khaldoun Al and Loygue, Pauline and Pujolle, Guy},
 doi = {10.1109/6GNet54646.2022.9830272},
