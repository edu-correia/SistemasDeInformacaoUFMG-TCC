@inproceedings{4156584,
 abstract = {Image compression and image encryption are pivotal to proper storage and transmission of images. Simultaneous image compression and encryption aims at achieving enhanced bandwidth utilization and security at the same time. The proposed number theory based image compression encryption (NTICE) algorithm employs number theoretic paradigm-Chinese remainder theorem, to solve congruencies and hence realize the twin ideals of compression and encryption simultaneously. The NTICE algorithm has been implemented on color images. The image coding results, calculated from actual image size and encoded image file, are comparable to the results obtained through much more sophisticated and computationally complex methods. In addition, the algorithm has been applied to the scenario of image multiplexing in order to obtain enhanced level of security along with compression},
 author = {Jagannathan, Vikram and Mahadevan, Aparna and Hariharan, R. and Srinivasan, E.},
 booktitle = {2007 International Conference on Signal Processing, Communications and Networking},
 doi = {10.1109/ICSCN.2007.350696},
 issn = {},
 keyword = {Image coding;Cryptography;Image storage;Bandwidth;Color;USA Councils;Data security;Information security;Biomedical computing;Remote sensing},
 month = {Feb},
 number = {},
 pages = {59-64},
 title = {Number Theory Based Image Compression Encryption and Application to Image Multiplexing},
 volume = {},
 year = {2007}
}
