@article{Seiler2011519,
 abstract = {We present an adaptive octree based approach for interactive cutting of deformable objects. Our technique relies on efficient refine- and node split-operations. These are sufficient to robustly represent cuts in the mechanical simulation mesh. A high-resolution surface embedded into the octree is employed to represent a cut visually. Model modification is performed in the rest state of the object, which is accomplished by back-transformation of the blade geometry. This results in an improved robustness of our approach. Further, an efficient update of the correspondences between simulation elements and surface vertices is proposed. The robustness and efficiency of our approach is underlined in test examples as well as by integrating it into a prototype surgical simulator. © 2011 Springer-Verlag.},
 author = {Seiler, Martin and Steinemann, Denis and Spillmann, Jonas and Harders, Matthias},
 doi = {10.1007/s00371-011-0561-3},
 journal = {Visual Computer},
 note = {Cited by: 37; All Open Access; Green Open Access},
 number = {6-8},
 pages = {519 - 529},
 publication_stage = {Final},
 source = {Scopus},
 title = {Robust interactive cutting based on an adaptive octree simulation mesh},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/79959519578?origin=resultslist},
 volume = {27},
 year = {2011}
}
