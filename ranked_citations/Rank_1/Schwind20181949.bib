@conference{Schwind20181949,
 abstract = {We define a consensus postulate in the propositional belief merging setting. In a nutshell, this postulate imposes the merged base to be consistent with the pieces of information provided by each agent involved in the merging process. The interplay of this new postulate with the IC postulates for belief merging is studied, and an incompatibility result is proved. The maximal sets of IC postulates which are consistent with the consensus postulate are exhibited. When satisfying some of the remaining IC postulates, consensus operators are shown to suffer from a weak inferential power. We then introduce two families of consensus operators having a better inferential power by setting aside some of these postulates. Copyright © 2018, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
 author = {Schwind, Nicolas and Marquis, Pierre},
 journal = {32nd AAAI Conference on Artificial Intelligence, AAAI 2018},
 note = {Cited by: 5},
 pages = {1949 - 1956},
 publication_stage = {Final},
 source = {Scopus},
 title = {On consensus in belief merging},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85060450370?origin=resultslist},
 year = {2018}
}
