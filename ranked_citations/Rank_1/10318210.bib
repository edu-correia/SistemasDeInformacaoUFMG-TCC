@article{10318210,
 abstract = {In this brief, we introduce a voltage-mode transmitter (TX) equipped with a 3+1 tap feed-forward equalizer (FFE). The proposed FFE merges a 3-tap coefficient-error robust FFE (B-FFE) (Jeong et al., 2020) with a 1-tap sliding-tap FFE, enabling both variation-tolerant performance for significant taps and flexible configuration for the auxiliary tap. The original current-mode B-FFE structure and its transition filtering scheme are modified to accommodate energy-efficient voltage-mode operation and avoid a reduction in output swing for multi-tap configurations. An auxiliary sliding tap is implemented to remove ISI with versatile coverage. The proposed 3+1 tap FFE TX is designed and fabricated in a 28-nm CMOS process, achieving 18-Gb/s data rate, 6.6-pJ/bit energy efficiency, and 43% lower sensitivity with respect to mismatches in tap coefficients.},
 author = {Shin, Wookjin and Seo, Hyeongmin and Lee, Sangwan and Choi, Dong-Ho and Kwak, Young-Ho and Won, Soon-Jae and Han, Jaeduk},
 doi = {10.1109/TCSII.2023.3332629},
 issn = {1558-3791},
 journal = {IEEE Transactions on Circuits and Systems II: Express Briefs},
 keyword = {Impedance;Transmitters;Voltage;Finite impulse response filters;Clocks;Hardware;Energy efficiency;Coefficient error;variation-tolerant;feed-forward equalizer (FFE);transmitter (TX);sliding tap;voltage-mode driver},
 month = {April},
 number = {4},
 pages = {1819-1823},
 title = {A Variation-Tolerant Voltage-Mode Transmitter With 3+1 Tap FFE in 28-nm CMOS},
 volume = {71},
 year = {2024}
}
