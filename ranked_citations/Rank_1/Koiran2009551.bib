@article{Koiran2009551,
 abstract = {We introduce a new class VPSPACE of families of polynomials. Roughly speaking, a family of polynomials is in VPSPACE if its coefficients can be computed in polynomial space. Our main theorem is that if (uniform, constant-free) VPSPACE families can be evaluated efficiently then the class PAR<sub>ℝ</sub> of decision problems that can be solved in parallel polynomial time over the real numbers collapses to P<sub>ℝ</sub>. As a result, one must first be able to show that there are VPSPACE families which are hard to evaluate in order to separate P<sub>ℝ</sub> from NP<sub>ℝ</sub>, or even from PAR<sub>ℝ</sub>. © Birkḧauser Verlag, Basel 2009.},
 author = {Koiran, Pascal and Perifel, Sylvain},
 doi = {10.1007/s00037-009-0269-1},
 journal = {Computational Complexity},
 note = {Cited by: 11},
 number = {4},
 pages = {551 - 575},
 publication_stage = {Final},
 source = {Scopus},
 title = {VPSPACE and a transfer theorem over the reals},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84904999726?origin=resultslist},
 volume = {18},
 year = {2009}
}
