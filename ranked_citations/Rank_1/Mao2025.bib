@conference{Mao2025,
 abstract = {In order to further improve the upgrade, assembly and maintenance efficiency of six-rotor agricultural UAVs and expand their application scope, a modular design method is proposed. Firstly, the correlation of each UAV part in terms of connection, function and geometric parameters is comprehensively analyzed, and a part relationship diagram is constructed. The parts with strong correlation are clustered into components, and the correlation matrix of the components at each level is calculated. Then, the analytic hierarchy process (AHP) is used to assign different weights to each level, calculate the comprehensive strength correlation matrix between components, and merge components according to the module evaluation principle. Finally, a modular structure is established, the corresponding modules are combined according to the operation requirements, and the static and dynamic characteristics of the key functional modules are analyzed. To enhance design accuracy and structural performance, optical techniques such as optical strain sensors and laser interferometry are introduced to support stress monitoring and manufacturing precision throughout the module design process. The research results show that this method simplifies 30 parts into 6 independent modules; when the UAV is updated, only the corresponding modules need to be redesigned and manufactured; the independence of the modules simplifies the assembly process and reduces the maintenance cost; the 6 modules can be combined into a spraying UAV or a sowing UAV, which expands the application scenarios. Through finite element analysis of the central cabin module, its maximum stress is 32.18686MPa, which is much smaller than the carbon fiber yield strength of 4870MPa. In addition, the use of optical-enhanced composite materials helps further improve strength-to-weight ratio and structural safety. The first six natural frequencies are all greater than the highest frequency of 32.75Hz when the UAV is working. The maximum deformation is 0.24735mm, which meets the deformation requirements under extreme working conditions. These results demonstrate that the integration of optical technologies significantly supports modular UAV design optimization and performance verification.  © 2025 SPIE.},
 author = {Mao, Yan and Zhu, Xiaofeng and Ma, Jianguang and Pu, Chao},
 doi = {10.1117/12.3070268},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
