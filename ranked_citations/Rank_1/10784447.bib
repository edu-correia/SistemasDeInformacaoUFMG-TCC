@inproceedings{10784447,
 abstract = {In this research, screen printed graphene carbon (SPGE) electrochemical sensing was designed and fabricated by screen printing for lab on a chip. Lab on a chip was designed with integrated single plate electrowetting on dielectric and electrochemical sensing on single plate substrate. For the design, lab on a chip consists of H-junction EWOD digital microfluidics microchip for merging buffer reagent and analyzed droplets and an electrochemical sensing at the end of T-junction EWOD. Both parts were fabricated by screen printed technique. Three electrodes of electrochemical sensing consist of a graphene-carbon paste working electrode, a graphene-carbon paste counter electrode, and silver/silver chloride paste reference electrode for high performance analysis. The EWOD microchip consists of silver paste for electrodes layers, PDMS for dielectric, and Teflon®AF hydrophobic layers. In experiment, the electrochemical sensing integrate with EWOD microchip was designed to study possibility of samples (buffer and analyzed droplet) on the microchip. For analysis, the SPGE electrochemical sensing was analyzed for nicotinamide adenine dinucleotide for high performance analysis. The concentration of the reagent was varied with 10, 50, 100, 250, and 500 μM with cyclic voltammograms.},
 author = {Ugsornrat, Kessararat and Saenkhamai, Anan and Chantaraklud, Apichaya and Phurksasukkasem, Triwit and Karuwan, Chanpen and Tuantranont, Adisorn},
 booktitle = {2024 Research, Invention, and Innovation Congress: Innovative Electricals and Electronics (RI2C)},
 doi = {10.1109/RI2C64012.2024.10784447},
 issn = {},
 keyword = {Electrodes;Integrated circuits;Printing;Technological innovation;Graphene;Merging;Sensors;Dielectrics;Performance analysis;Microfluidics;lab on a chip;electrowetting on dielectric (EWOD);electrochemical sensor},
 month = {Aug},
 number = {},
 pages = {132-135},
 title = {Screen Printed Graphene Carbon Paste Electrochemical Sensor for Lab on a Chip by Screen Printing},
