@inproceedings{8492875,
 abstract = {In some high-level secure applications in need of multiple participants input their own secret data to achieve access control, such as, secure cabinet opened by multiple owners together, traditional security technology is not applicable. Although secret sharing may be used in the scenarios, there are some problems when directly applying primary secret sharing methods including visual cryptography (VC) and polynomial-based secret sharing. In this paper, we first describe the application scenario (namely secret data fusion) and its requirements, where secret data fusion is different from secret sharing. Then, we propose a possible method for secret data fusion based on Chinese remainder theorem (CRT). Theoretical analyses and experiments are examined to represent the effectiveness of our method.},
 author = {Lu, Yuliang and Yan, Xuehu and Liu, Lintao and Liu, Jingju and Yang, Guozheng and Li, Qiang},
 booktitle = {2018 IEEE 3rd International Conference on Image, Vision and Computing (ICIVC)},
 doi = {10.1109/ICIVC.2018.8492875},
 issn = {},
 keyword = {Data integration;Cryptography;Cathode ray tubes;Access control;Visualization;Art;data fusion;data merging;secret sharing;Chinese remainder theorem;access control},
 month = {June},
 number = {},
 pages = {884-888},
 title = {Secret Data Fusion Based on Chinese Remainder Theorem},
 volume = {},
 year = {2018}
}
