@article{Koehoorn201515,
 abstract = {We propose a method for digital hair removal from dermoscopic images, based on a threshold-set model. For every threshold, we adapt a recent gap-detection algorithm to find hairs, and merge results in a single mask image. We find hairs in this mask by combining morphological filters and medial descriptors. We derive robust parameter values for our method from over 300 skin images. We detail a GPU implementation of our method and show how it compares favorably with five existing hair removal methods. © Springer International Publishing Switzerland 2015.},
 author = {Koehoorn, Joost and Sobiecki, André C and Boda, Daniel and Diaconeasa, Adriana and Doshi, Susan and Paisey, Stephen and Jalba, Andrei and Telea, Alexandru},
 doi = {10.1007/978-3-319-18720-4_2},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 31},
 pages = {15 - 26},
 publication_stage = {Final},
 source = {Scopus},
 title = {Automated digital hair removal by threshold decomposition and morphological analysis},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84945957694?origin=resultslist},
 volume = {9082},
 year = {2015}
}
