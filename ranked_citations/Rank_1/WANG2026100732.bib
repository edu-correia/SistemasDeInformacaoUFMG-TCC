@article{WANG2026100732,
 abstract = {Traditional network topology discovery methods rely heavily on specific protocols or are limited to single subnets, making them inadequate for large-scale, protocol-heterogeneous, and dynamic data center networks. To address this, we propose a framework that discovers physical device connections without active probing or protocol dependence. Our approach passively analyzes network traffic to form local topology fragments, which are then merged and refined into a complete map through a three-stage process: (1) topology prediction based on flow-data five-tuples, (2) topology optimization using delay covariance matrices to resolve anonymous routers, and (3) topology repair via a Deep Convolutional Generative Adversarial Network to recover missing links. The key innovations include a distributed and scalable discovery procedure and the theoretically-grounded application of image inpainting techniques to network graph completion. In simulations using NS3 and real topology image datasets, our method achieves over 95% accuracy and an F1-score above 0.93 in networks of up to 6000 devices, outperforming SNMP-based discovery in scalability while introducing minimal overhead. This work provides a practical, non-intrusive solution for topology discovery in modern data centers.},
 author = {Jiaxing Wang and Lanlan Rui and Zhipeng Gao and Shaoyong Guo and Xuesong Qiu},
 doi = {https://doi.org/10.1016/j.array.2026.100732},
 issn = {2590-0056},
 journal = {Array},
 keyword = {Data center network, Topology discovery, Data flow information, Delay covariance matrix, Deep Convolutional Generative Adversarial Networks, NS3},
 pages = {100732},
 title = {Technology of discovering physical equipment connection relationship},
 url = {https://www.sciencedirect.com/science/article/pii/S259000562600055X},
 volume = {29},
 year = {2026}
}
