@inproceedings{11027835,
 abstract = {This study explores the development of lightweight interactive structures fabricated using 3D-printed polylactic acid (PLA), which can fold and unfold in response to environmental stimuli such as temperature and humidity. To facilitate user interaction and real-time testing of structural behaviors, an online platform was created. This platform allows users to test Ballistic Seed Pods and experience how different climate conditions affect these structures. Additionally, a parametric design tool was developed to simulate the effects of design variables, providing customization options for applications in adaptive architecture, product design, and robotics.},
 author = {Wen, Wen and Xu, Jiaxuan and Shao, Jianghuai},
 booktitle = {2024 17th International Symposium on Computational Intelligence and Design (ISCID)},
 doi = {10.1109/ISCID63852.2024.00040},
 issn = {2473-3547},
 keyword = {Hands;Refining;Merging;Lightweight structures;Humidity;Three-dimensional printing;Real-time systems;Product design;Robots;Testing;3D printing;interactive structures;polylactic acid (PLA);lightweight structures;environmental stimuli},
 month = {Dec},
 number = {},
 pages = {145-148},
 title = {Adaptive Structures simulation platform: A 3D Printing Approach for Ecological Response},
 volume = {},
 year = {2024}
}
