@article{ZHANG2025184608,
 abstract = {Layered double hydroxides (LDH) are employed in supercapacitors due to the associated layered structure and electrochemical activity. This study proposes a multiphase composite strategy to synthesize NiCo-LDH/rS-MS/MWCNT using a simple hydrothermal procedure. The NiCo-LDH provides redox-active sites, where embedding Se-enriched MoSe2 (rS-MS) serves to increase the NiCo-LDH layer spacing and promote ion diffusion, and the incorporation of multi-walled carbon nanotubes (MWCNT) enhances electron transport. The synergistic effect of these components contributes to a specific capacitance of 1275.9 F g−1 at a scan rate of 2 mV s−1. In addition, an effective interfacial coupling of the three components enhances structural stability and improves cycling performance. The fabricated device has delivered an energy density of 33.78 Wh kg−1 at a power density of 800.05 W kg−1; following 5000 cycles of voltammetry testing, the capacitance retention rate reached 100.006 %. The proposed design integrates a three-dimensional architecture comprising a well-coordinated network of active sites, ion transport pathways, and conductive elements that overcomes the inherent limitations of standard LDH materials. The findings of this study provide a viable means of achieving cost-effective and high-performance energy storage suitable for portable electronic devices and renewable energy systems.},
 author = {Qingming Zhang and Qihang Zhou and Ruijiang Qian and Mingpeng Zhao and Zhiwei Dong and Wen Ge and Shukang Deng and Peizhi Yang},
 doi = {https://doi.org/10.1016/j.jallcom.2025.184608},
 issn = {0925-8388},
 journal = {Journal of Alloys and Compounds},
 keyword = {Layered double hydroxides, Ternary heterostructure, Interfacial synergy, Asymmetric supercapacitor, Cycle stability},
 pages = {184608},
 title = {Interfacial synergistic NiCo-LDH/rS-MS/MWCNT ternary heterostructure for high-performance and cycle-stable supercapacitors},
 url = {https://www.sciencedirect.com/science/article/pii/S0925838825061705},
 volume = {1046},
 year = {2025}
}
