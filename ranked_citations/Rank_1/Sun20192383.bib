@article{Sun20192383,
 abstract = {Timely discovering and acquiring information from incremental data on the Internet is a hot topic in a big data era. This paper presents a distributed incremental information acquisition model for large-scale text data. To obtain a lower false positive rate and higher efficiency of the traditional Bloom filter, a distributed multidimensional Bloom filter is designed and proposed to cope with the deduplication of large-scale Web URL text data. Three methods related to Bloom filter were compared based on the false positive rate and response efficiency. The results show that the distributed incremental information acquisition model for large-scale text data can achieve a high duplicate removal rate with a lower false positive rate. © 2017, Springer Science+Business Media, LLC, part of Springer Nature.},
 author = {Sun, Shengtao and Gong, Jibing and Zomaya, Albert Y. and Wu, Aizhi},
 doi = {10.1007/s10586-017-1498-8},
 journal = {Cluster Computing},
 note = {Cited by: 7},
 pages = {2383 - 2394},
 publication_stage = {Final},
 source = {Scopus},
 title = {A distributed incremental information acquisition model for large-scale text data},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85038611826?origin=resultslist},
 volume = {22},
 year = {2019}
}
