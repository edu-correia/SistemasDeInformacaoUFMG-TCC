@article{FANG2024105338,
 abstract = {This paper introduces a Monte Carlo code IMPC-NP which can realize the simulation of neutron-photon coupling transport. In IMPC-NP, Delta-tracking algorithm and Weight delta-tracking algorithm are used for neutron and photon transport. A new method of fabrication of photon multi-group cross sections named "Scattering merging" is proposed, which is implemented and on IMPC-NP. The results of multiple benchmarks show that the new method can greatly improve the accuracy of neutron and photon calculation in deterministic code.},
 author = {Peng Fang and Xiang Wu and Hanghui Lai and Yongwei Yang and Lei Yang and Yuyao Guo and Feng Zhou and Yanling Zhu},
 doi = {https://doi.org/10.1016/j.pnucene.2024.105338},
 issn = {0149-1970},
 journal = {Progress in Nuclear Energy},
 keyword = {Monte Carlo, Neutron-photon coupling transport, Fabrication of photon multi-group cross sections, Scattering merging},
 pages = {105338},
 title = {Development of neutron-photon coupling transport code IMPC-NP and optimization of method for fabrication of neutron-photon multi-group cross section},
 url = {https://www.sciencedirect.com/science/article/pii/S0149197024002889},
 volume = {175},
 year = {2024}
}
