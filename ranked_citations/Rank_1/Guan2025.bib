@article{Guan2025,
 abstract = {Multi-modal unsupervised learning strategically partitions medical data into distinct subgroups, crucial in tumor research. Despite significant progress, prevalent methods continue to integrate data representations indiscriminately. This broad integration often conflicts with the characteristics of biomedical data, which often include inferior modalities due to technical limitations, and this forced integration typically yields suboptimal performance. Furthermore, current approaches typically focus on either topological or attribute information, thus ignoring the potential synergistic effects between them. To overcome these limitations, we introduce SAN, an effective Structure-Guided Feature Aggregation Network, specifically tailored for multi-modal medical data by preserving only effective modalities to enhance clustering performance. Specifically, we have developed a feature preservation module that computes the confidence level of the quality of modalities, thereby preserving only the effective views. Additionally, the topological information derived from the preserved modalities is subsequently aligned with the learned attribute representation, further enhanced by structure-guided contrastive learning, thus significantly enhancing the quality of the data representations. Extensive experiments conducted on real-world benchmark datasets have demonstrated the effectiveness of the proposed SAN and its superiority to competing algorithms. © 2025 Elsevier Ltd},
 author = {Guan, Renxiang and Quan, Hao and Li, Deliang and Hu, Dayu},
 doi = {10.1016/j.eswa.2025.126835},
 journal = {Expert Systems with Applications},
 note = {Cited by: 6},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An effective global structure-aware feature aggregation network for multi-modal medical clustering},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105000310701?origin=resultslist},
 volume = {277},
 year = {2025}
}
