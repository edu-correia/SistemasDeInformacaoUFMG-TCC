@article{Kang20221032,
 abstract = {In this article, we propose a two-step pipeline to explore task-dependent functional coactivations of brain clusters with constraints from the structural connectivity network. In the first step, the pipeline employs a nonparametric Bayesian clustering method that can estimate the optimal number of clusters, cluster assignments of brain regions of interest (ROIs), and the strength of within-and between-cluster connections without any prior knowledge. In the second step, a factor analysis model is applied to functional data with factors defined as the obtained structural clusters and the factor structure informed by the structural network. The coactivations of ROIs and their clusters can be studied by correlations between factors, which can largely differ by ongoing cognitive task. We provide a simulation study to validate that the pipeline can recover the underlying structural and functional network. We also apply the proposed pipeline to empirical data to explore the structural network of ROIs obtained by the Gordon parcellation and study their functional coactivations across eight cognitive tasks and a resting-state condition. © 2022, MIT Press Journals. All rights reserved.},
 author = {Kang, Inhan and Galdo, Matthew and Turner, Brandon M.},
 doi = {10.1162/netn_a_00242},
 journal = {Network Neuroscience},
 note = {Cited by: 5; All Open Access; Gold Open Access; Green Open Access},
 number = {4},
 pages = {1032 - 1065},
 publication_stage = {Final},
 source = {Scopus},
 title = {Constraining functional coactivation with a cluster-based structural connectivity network},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85140890762?origin=resultslist},
 volume = {6},
 year = {2022}
}
