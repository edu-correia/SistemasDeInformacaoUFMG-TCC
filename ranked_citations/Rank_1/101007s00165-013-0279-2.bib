@article{10.1007/s00165-013-0279-2,
 abstract = {Many tools can check if a test set provides control coverage; they are, however, of little or no help when coverage is not achieved and the test set needs to be completed. In this paper, we describe how a formal characterisation of a coverage criterion can be used to generate test data; we present a procedure based on traditional programming techniques like normalisation, and weakest precondition calculation. It is a basis for automation using an algebraic theorem prover. In the worst situation, if automation fails to produce a specific test, we are left with a specification of the compliant test sets. Many approaches to model-based testing rely on formal models of a system under test. Our work, on the other hand, is not concerned with the use of abstract models for testing, but with coverage based on the text of programs.},
 address = {Berlin, Heidelberg},
 author = {Cavalcanti, Ana and King, Steve and O’Halloran, Colin and Woodcock, Jim},
 doi = {10.1007/s00165-013-0279-2},
 issn = {0934-5043},
 issue_date = {Jul 2014},
 journal = {Form. Asp. Comput.},
 keyword = {Control coverage, Semantics, UTP, Invariants},
 month = {July},
 number = {4},
 numpages = {29},
 pages = {795–823},
 publisher = {Springer-Verlag},
 title = {Test-data generation for control coverage by proof},
 url = {https://doi.org/10.1007/s00165-013-0279-2},
 volume = {26},
 year = {2014}
}
