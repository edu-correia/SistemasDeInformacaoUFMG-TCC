@article{LI2026129160,
 abstract = {The transition toward low-carbon energy development requires the design and adaptation of gas turbine combustors for pure hydrogen fuel utilization. This study numerically investigates hydrogen micro-mixing combustion in a 25 MW industrial gas turbine combustor. A two-stage approach is adopted: first, the influence of nozzle diameter and spacing in sector-arrayed micro-mixing nozzles is analyzed; second, the optimized nozzle configuration is applied for the combustor to evaluate effects of head air allocation ratio. Results show that increasing nozzle diameter from 3 to 6 mm extends jet momentum and flame length, shifting the temperature peak downstream by approximately 40 mm. Reducing spacing ratio with diameter from 2.0 to 1.5 enhances the Coanda effect and flame interference, whereas 2.0 spacing ensures stable, independent flames. In combustor-scale simulations, decreasing air allocation from 80 % to 70 % raises jet velocity by over 40 %, intensifying recirculation, causing flame merging and local blow-off. At 80 % allocation, a uniform flame structure with superior stability is achieved, yielding optimal performance with 3.55 ppm NOx, 4.21 % pressure loss, and 16.34 % OTDF.},
 author = {Yuting Li and Xiao Liu and Jiaqi Liu and Zhiqiang Wang and Wu Gu and Hongtao Zheng},
 doi = {https://doi.org/10.1016/j.applthermaleng.2025.129160},
 issn = {1359-4311},
 journal = {Applied Thermal Engineering},
 keyword = {Hydrogen fuel, Industrial gas turbine, Micro-mixing combustion, Flow field, Flame characteristics, Air allocation ratio},
 pages = {129160},
 title = {Numerical study on optimizing nozzle geometry and air allocation for hydrogen fuel in a micro-mixing industrial gas turbine combustor},
 url = {https://www.sciencedirect.com/science/article/pii/S1359431125037524},
 volume = {284},
 year = {2026}
}
