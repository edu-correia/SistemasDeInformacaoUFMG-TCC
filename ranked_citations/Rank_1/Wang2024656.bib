@conference{Wang2024656,
 abstract = {In recent years, semantic segmentation has been able to achieve great segmentation performance, but it suffers from a large number of parameters and high computational expenses, making the model more complex and unfriendly to edge devices. The current lightweight semantic segmentation methods continue to face challenges with optimizing efficiency and maintaining accuracy. In order to better balance accuracy and performance, this research offers a lightweight bidirectional network for real-time semantic segmentation. First, a new spatial branching module was presented to minimize model parameters and computing costs while still incorporating channel and geographical calibration procedures. Second, there is a simple atrous spatial pyramid pooling module that increases the convolution kernel's sense field while reducing computational cost and resolution. Finally, to enhance the model's performance, a double-branch feature fusion module was created to merge low dimension and high dimension semantic features. Comparing our method against the baseline, we achieve a 1.4% improvement in mIoU and a 2 5 % improvement in FPS on the Cityscapes test set. In the meantime, our method uses 32% fewer FLOPs and 34% fewer parameters.  © 2024 IEEE.},
 author = {Wang, Guang and Zhan, Junchang and Chen, Hong and Huang, Hai and Shi, Yucai and Wang, Qing},
 doi = {10.1109/SWC62898.2024.00119},
 journal = {Proceedings - 2024 IEEE Smart World Congress, SWC 2024 - 2024 IEEE Ubiquitous Intelligence and Computing, Autonomous and Trusted Computing, Digital Twin, Metaverse, Privacy Computing and Data Security, Scalable Computing and Communications},
 note = {Cited by: 0},
 pages = {656 - 663},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Speed-and-Performance Balancing Lightweight Network for Real-time Semantic Segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105002211743?origin=resultslist},
