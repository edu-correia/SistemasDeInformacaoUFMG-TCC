@article{Lemayian2026554,
 abstract = {Ethereum leverages smart contracts (SCs) to power decentralized applications (dApps), with execution handled by the Ethereum virtual machine (EVM) within an Ethereum client. Other blockchain platforms, including Avalanche, Polkadot, Aurora, and Cardano, have also adopted the EVM. However, the performance of the EVM is often constrained by the limitations of general-purpose processors, a challenge that has been explored in the literature. This work aims to further address the limitation by proposing EVMx, a dedicated single-core SC execution engine implemented on a field programmable gate array (FPGA). EVMx follows a processor-like architecture inspired by the RISC philosophy. By exploiting the parallelism and high-speed processing capabilities of FPGA hardware, EVMx achieves a 61% to 99% reduction in execution time for commonly used operation codes compared to traditional central processing unit (CPU)-based environments. Furthermore, EVMx executes entire Ethereum blocks with a percentage reduction in execution time between 6% and 56% against comparable FPGA implementations and 98% to 99% compared to CPU-based EVMs in the literature. These results demonstrate the potential of EVMx to significantly accelerate SC execution and enhance the performance of EVM-compatible blockchains. © 1993-2012 IEEE.},
 author = {Lemayian, Joel Poncha and Gagnon, Ghyslain and Zhang, Kaiwen and Giard, Pascal},
 doi = {10.1109/TVLSI.2025.3628118},
 journal = {IEEE Transactions on Very Large Scale Integration (VLSI) Systems},
 note = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 number = {2},
 pages = {554 - 567},
 publication_stage = {Final},
 source = {Scopus},
 title = {EVMx: An FPGA-Based Accelerator for Smart Contract Processing},
 type = {Article},
