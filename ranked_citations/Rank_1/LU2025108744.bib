@article{LU2025108744,
 abstract = {The rising demand for heat dissipation in engineering has led to more efficient thermal management strategies, with boiling heat transfer emerging as an effective solution by using latent heat to prevent device damage. Hybrid thermal conductivity surfaces without micro/nano structures can control bubble dynamics, improving boiling heat transfer. In this study, a multi-relaxation-time lattice Boltzmann method combined with a double distribution function and pseudopotential model was employed to investigate pool boiling heat transfer on hybrid thermal conductivity surfaces. The study captured the full bubble cycle, including bubble nucleation, growth, coalescence, and departure. The boiling curve including the single-phase heat transfer stage is also obtained in this study. Critical heat flux (CHF) and heat transfer coefficient (HTC) were used to evaluate the effects of the width and spacing of low thermal conductivity regions on heat transfer performance. The results indicated that low thermal conductivity regions exert a “pinning effect” on bubbles, influencing the heat transfer performance by affecting bubble coalescence and departure. Compared to surfaces with uniform thermal conductivity, the optimal hybrid thermal conductivity surface demonstrated a 20.73 % improvement in CHF. Additionally, an analysis of the thermal conductivity of the low-conductivity regions revealed that as the ratio of thermal conductivity between the low- and high-conductivity regions decreased, both CHF and HTC increased, and the superheat at the CHF point was reduced. These findings elucidate the mechanisms by which hybrid thermal conductivity surfaces enhance boiling and provide valuable insights for their practical engineering applications.},
 author = {Jingyi Lu and Haochen Xu and Xianfeng Hu and Yichuan He and Dawei Tang},
 doi = {https://doi.org/10.1016/j.icheatmasstransfer.2025.108744},
 issn = {0735-1933},
 journal = {International Communications in Heat and Mass Transfer},
 keyword = {Boiling, Hybrid thermal conductivity, Heat transfer enhancement, Lattice Boltzmann method},
 pages = {108744},
 title = {Investigation on boiling heat transfer enhancement by hybrid thermal conductivity via lattice Boltzmann method},
 url = {https://www.sciencedirect.com/science/article/pii/S0735193325001691},
 volume = {163},
 year = {2025}
}
