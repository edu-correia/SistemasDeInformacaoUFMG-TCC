@article{Helbert2019,
 abstract = {We propose a novel inpainting process for color images. Our algorithm is based on the graph-based wavelet regularization and the non-local mean approach. At each step damaged structures are estimated by computing a graph of patches and applying a regularization model using a wavelet transform on graphs. Our approach uses color information of the image to reconstruct missing data according to local geometry. We show that the graph can be used to model geometry information in the frame of inpainting and to merge candidate pixels from a graph-based wavelet regularization. We provide details on numerical approaches and the results highlight an improvement of the geometrical information reconstruction of color images. © 2019 Elsevier Inc.},
 author = {Helbert, David and Malek, Mohamed and Bourdon, Pascal and Carré, Philippe},
 doi = {10.1016/j.jvcir.2019.102614},
 journal = {Journal of Visual Communication and Image Representation},
 note = {Cited by: 6; All Open Access; Bronze Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Patch graph-based wavelet inpainting for color images},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85071976808?origin=resultslist},
 volume = {64},
 year = {2019}
}
