@article{Pei202219,
 abstract = {We present OSFormer, the first one-stage transformer framework for camouflaged instance segmentation (CIS). OSFormer is based on two key designs. First, we design a location-sensing transformer (LST) to obtain the location label and instance-aware parameters by introducing the location-guided queries and the blend-convolution feed-forward network. Second, we develop a coarse-to-fine fusion (CFF) to merge diverse context information from the LST encoder and CNN backbone. Coupling these two components enables OSFormer to efficiently blend local features and long-range context dependencies for predicting camouflaged instances. Compared with two-stage frameworks, our OSFormer reaches 41% AP and achieves good convergence efficiency without requiring enormous training data, i.e., only 3,040 samples under 60 epochs. Code link: https://github.com/PJLallen/OSFormer. © 2022, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Pei, Jialun and Cheng, Tianyang and Fan, Deng-Ping and Tang, He and Chen, Chuanbo and Van Gool, Luc},
 doi = {10.1007/978-3-031-19797-0_2},
 journal = {Lecture Notes in Computer Science},
 note = {Cited by: 75},
 pages = {19 - 37},
 publication_stage = {Final},
 source = {Scopus},
 title = {OSFormer: One-Stage Camouflaged Instance Segmentation with Transformers},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85142740207?origin=resultslist},
 volume = {13678 LNCS},
 year = {2022}
}
