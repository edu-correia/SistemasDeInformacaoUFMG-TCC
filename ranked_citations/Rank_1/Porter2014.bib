@conference{Porter2014,
 abstract = {A key step in many image quantification solutions is feature pooling, where subsets of lower-level features are combined so that higher-level, more invariant predictions can be made. The pooling region, which defines the subsets, often has a fixed spatial size and geometry, but data-adaptive pooling regions have also been used. In this paper we investigate pooling strategies for the data-adaptive case and suggest a new framework for pooling that uses multiple sub-regions instead of a single region. We show that this framework can help represent the shape of the pooling region and also produce useful pairwise features for adjacent pooling regions. We demonstrate the utility of the framework in a number of classification tasks relevant to image quantification in digital microscopy.},
 author = {Porter, Reid and Harvey, Neal and Ruggiero, Christy},
 doi = {10.1117/12.2038707},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Investigation of segmentation based pooling for image quantification},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84897432653?origin=resultslist},
 volume = {9024},
 year = {2014}
}
