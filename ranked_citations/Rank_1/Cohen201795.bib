@conference{Cohen201795,
 abstract = {In recent years there has been a growing interest in developing "streaming algorithms" for efficient processing and querying of continuous data streams. These algorithms seek to provide accurate results while minimizing the required storage and the processing time, at the price of a small inaccuracy in their output. A fundamental query of interest is the intersection size of two big data streams. This problem arises in many different application areas, such as network monitoring, database systems, data integration and information retrieval. In this paper we develop a new algorithm for this problem, based on the Maximum Likelihood (ML) method. We show that this algorithm outperforms all known schemes in terms of the estimation's quality (lower variance) and that it asymptotically achieves the optimal variance. © 2017 ACM.},
 author = {Cohen, Reuven and Katzir, Liran and Yehezkel, Aviv},
 doi = {10.1145/3097983.3097999},
 journal = {Proceedings of the ACM SIGKDD International Conference on Knowledge Discovery and Data Mining},
 note = {Cited by: 21},
 pages = {95 - 103},
 publication_stage = {Final},
 source = {Scopus},
 title = {A minimal variance estimator for the cardinality of big data set intersection},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85029104602?origin=resultslist},
 volume = {Part F129685},
 year = {2017}
}
