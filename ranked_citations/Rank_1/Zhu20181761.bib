@conference{Zhu20181761,
 abstract = {Sensing and presenting on-road information of moving vehicles is essential for fully and semi-automated driving. It is challenging to track vehicles from affordable on-board cameras in crowded scenes. The mismatch or missing data are unavoidable and it is ineffective to directly present uncertain cues to support the decision-making. In this paper, we propose a physical model based on incompressible fluid dynamics to represent the vehicle's motion, which provides hints of possible collision as a continuous scalar riskmap. We estimate the position and velocity of other vehicles from a monocular on-board camera located in front of the ego-vehicle. The noisy trajectories are then modeled as the boundary conditions in the simulation of advection and diffusion process. We then interactively display the animating distribution of substances, and show that the continuous scalar riskmap well matches the perception of vehicles even in presence of the tracking failures. We test our method on real-world scenes and discuss about its application for driving assistance and autonomous vehicle in the future. © 2018 IEEE.},
 author = {Zhu, Lifeng and Li, Xuanpeng and Lu, Wenjie and Zhang, Yongjie Jessica},
 doi = {10.1109/IVS.2018.8500491},
 journal = {IEEE Intelligent Vehicles Symposium, Proceedings},
 note = {Cited by: 2},
 pages = {1761 - 1766},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Field-Based Representation of Surrounding Vehicle Motion from a Monocular Camera},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85056762682?origin=resultslist},
 volume = {2018-June},
 year = {2018}
}
