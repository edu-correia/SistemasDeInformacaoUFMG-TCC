@article{Zuriel2019,
 abstract = {Non-volatile memory is expected to co-exist or replace DRAM in upcoming architectures. Durable concurrent data structures for non-volatile memories are essential building blocks for constructing adequate software for use with these architectures. In this paper, we propose a new approach for durable concurrent sets and use this approach to build the most efficient durable hash tables available today. Evaluation shows a performance improvement factor of up to 3.3x over existing technology. © 2019 Association for Computing Machinery. All rights reserved.},
 author = {Zuriel, Yoav and Friedman, Michal and Sheffi, Gali and Cohen, Nachshon and Petrank, Erez},
 doi = {10.1145/3360554},
 journal = {Proceedings of the ACM on Programming Languages},
 note = {Cited by: 55; All Open Access; Gold Open Access; Green Open Access},
 number = {OOPSLA},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Efficient lock-free durable sets},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85120113313?origin=resultslist},
 volume = {3},
 year = {2019}
}
