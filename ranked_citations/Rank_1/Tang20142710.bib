@article{Tang20142710,
 abstract = {In this paper, we are trying to find the developmental tendencies and study hotspots of intelligent transportation systems technologies by theme classification and analysis of core articles from all papers published in IEEE Transactions on Intelligent Transportation Systems during 2010-2013. First, we classify theme categories by co-word analysis with different research domains and obtain 12 themes that include vehicle control technology, modeling and simulation, image processing, etc. Second, we find research focuses and directions of these themes by analyzing the trends of the article numbers published in each year of the TOP 5 themes. Finally, we identify TOP 5 core articles of these 12 themes and obtain their specific study hotspots by sorting the citations without self-citations of the articles in the Web of Science. © 2000-2011 IEEE.},
 author = {Tang, Shaohu and Li, Zhengxi and Chen, Dewang and Chen, Zhaomeng and Liu, Wenli and Liu, Xiaoming and Li, Lingxi and Shi, Xiaobo},
 doi = {10.1109/TITS.2014.2365631},
 journal = {IEEE Transactions on Intelligent Transportation Systems},
 note = {Cited by: 12},
 number = {6},
 pages = {2710 - 2719},
 publication_stage = {Final},
 source = {Scopus},
 title = {Theme classification and analysis of core articles published in IEEE transactions on intelligent transportation systems from 2010 to 2013},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84915813116?origin=resultslist},
 volume = {15},
 year = {2014}
}
