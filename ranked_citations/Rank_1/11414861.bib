@inproceedings{11414861,
 abstract = {In multimodal multi-objective optimization problems (MMOPs), existing evolutionary algorithms often fail to maintain imbalanced or locally distributed Pareto sets (PSs) due to dominance-based selection. To address this, we propose a dynamic adaptive ring-hierarchy topology algorithm that balances convergence and diversity by structuring the population into an evolvable hierarchical network. The framework begins with an initial population and hierarchy, then employs sliding-window kernel density estimation (SW-KDE) to monitor PS distribution in real time. A statistical test detects significant density shifts, triggering topology adaptation. When changes are identified, the topology engine dynamically splits, merges, or adjusts connection weights across layers to redistribute computational resources. Evolutionary operations—selection, crossover, mutation, and environmental selection—are then performed over the updated structure, promoting both local exploitation and global exploration. This closed-loop mechanism enables self-adaptive reconfiguration in response to problem characteristics, maintaining high search efficiency across problems with varying numbers, shapes, or distributions of PSs, including dynamic environments. The algorithm outputs a diverse set of high-quality solutions, enhancing robustness and performance on complex MMOPs. Additionally, it reduces parameter sensitivity and demonstrates strong generalization and application potential.},
 author = {Wang, Huiying and Yang, Jiaxu and Li, Jingjian and Cui, Fengzhe and Wang, Rui and Chen, Wenguo},
 booktitle = {2025 7th International Academic Exchange Conference on Science and Technology Innovation (IAECST)},
 doi = {10.1109/IAECST68792.2025.11414861},
 issn = {},
 keyword = {Technological innovation;Sensitivity;Network topology;Heuristic algorithms;Estimation;Evolutionary computation;Topology;Kernel;Optimization;Convergence;Multimodal Multi-objective Optimization;Ring-Hierarchy Topology;Sliding-Window Kernel Density Estimation;Topology Reconstruction},
 month = {Dec},
 number = {},
 pages = {154-157},
 title = {Dynamic Ring-Hierarchy Evolutionary Algorithm with Adaptive Topology for Multimodal Multi-objective Optimization},
 volume = {},
