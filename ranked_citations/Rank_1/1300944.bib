@inproceedings{1300944,
 abstract = {Strong image segmentation is a very challenging problem in computer vision research. Both data-driven and model-driven approaches have been investigated in the past two decades, and many approaches proposed. Although model-based approaches are more promising in addressing strong image segmentation, data-driven approaches present more general frameworks which could potentially be adopted to segment general scenes without any prior model information. We discuss the problems of strong image segmentation from a data-driven perspective, and present a modeling technique describing an object with both its segments and a hierarchical relationship among the segments. The paper is devoted to the discussion of the feasibility of data-driven approaches for strong image segmentation. Existing approaches are not suitable for strong image segmentation in complex environments, but preliminary experimental results show the feasibility of our proposed model.},
 author = {Qiang Zhou and Limin Ma and Min Zhou and Chelberg, D.},
 booktitle = {6th IEEE Southwest Symposium on Image Analysis and Interpretation, 2004.},
 doi = {10.1109/IAI.2004.1300944},
 issn = {},
 keyword = {Image segmentation;Layout;Image coding;Object detection;Computer science;Computer vision;Application software;MPEG 4 Standard;MPEG 7 Standard;Algorithm design and analysis},
 month = {March},
 number = {},
 pages = {56-60},
 title = {Strong image segmentation from a data-driven perspective: impossible?},
 volume = {},
 year = {2004}
}
