@inproceedings{11390497,
 abstract = {Students in rural India face many problems because facilities are not good enough, infrastructure is poor, and there are gaps in language and curriculum. When the language of instruction does not match the local languages, it makes learning harder, leading to differences in education. This paper details the design and implementation of an interactive LED display system that uses an Arduino microcontroller and an RGB LED matrix to display Kannada letters. The system allows users to interact with it in real time using the serial interface. Users can change the display settings, like colour, brightness, alphabet, and pre-programmed animation patterns on the fly. By mapping Kannada character sets to the LED matrix, the technology makes text displays that are interesting to look at and culturally relevant in rural areas. This helps minimise inequities by offering quality education in the native tongue. The system may work in both static and sequential modes, which makes it more useful for instructional, ornamental, or informational purposes. The project shows how to use addressable LEDs to represent local languages in a way that is both cheap and configurable. It does this by merging embedded systems and creative display technologies.},
 author = {Bhat, Anil Kumar and B, Shubha and Rao, Nishchith Athul and Niranjan and Nishaan and Bhat, Nireeksha},
 booktitle = {2025 International Conference on Intelligent Computing, Information and Control Systems (ICOIICS)},
 doi = {10.1109/ICOIICS67115.2025.11390497},
 issn = {},
 keyword = {Tongue;Embedded systems;Microcontrollers;Education;Merging;Display systems;Light emitting diodes;Control systems;Real-time systems;Faces;Arduino;WS2812 programmable LED Matrix;Kannada Letter display},
 month = {Nov},
 number = {},
 pages = {1495-1502},
 title = {Customized Display for Kannada Letters Using RGB LED Matrix},
