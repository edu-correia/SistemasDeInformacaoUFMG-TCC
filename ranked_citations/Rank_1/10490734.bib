@inproceedings{10490734,
 abstract = {Bolt looseness would lead to hazardous damage to engineering structures. Neural network-based algorithms can effectively monitor health conditions using the impedance signal. On the other hand, the impedance data is difficult to obtain, and the data has an imbalanced distribution. In this research, we propose a data augmentation method based on the Variational Autoencoder (VAE) model with channel attention and spatial attention mechanisms. This model takes advantage of the VAE model to generate additional data to resolve the issue of an imbalanced sample. The new dataset is then fed into the Transformer model for training and fault identification. Experimental results demonstrate that this method performs well in enhancing and classifying imbalanced data, increasing accuracy from 81.82% to 87.01%.},
 author = {You, Zengying and Wang, Xian and Yan, Yunan and Xu, Jiawen},
 booktitle = {2023 International Conference on Sensing, Measurement & Data Analytics in the era of Artificial Intelligence (ICSMD)},
 doi = {10.1109/ICSMD60522.2023.10490734},
 issn = {},
 keyword = {Training;Merging;Training data;Fasteners;Transformers;Data augmentation;Data models;Bolt looseness;Variational autoencoder;Data augmentation;Transformer model},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Transformer-Based Bolt Looseness Detection with Data Augmentation by Variational Autoencoders},
 volume = {},
 year = {2023}
}
