@inproceedings{11257648,
 abstract = {Graph-based Retrieval-Augmented Generation demonstrates significant potential for tackling complex problems. However, its efficacy is often constrained by the quality of the underlying knowledge graph and the accuracy of its subgraph retrieval mechanisms. To overcome these limitations, we introduce EvoRAG, an enhanced framework featuring two key innovations. First, during the graph construction stage, we utilize a weighted semantic embedding strategy to enhance the precision of entity merging. Second, we propose a novel subgraph retrieval algorithm that leverages Beam Search, initiating from seed entities to identify the most relevant subgraphs for a given user query. Our experiments on the UltraDomain agricultural dataset reveal that EvoRAG consistently achieves higher performance than existing baselines, including NaiveRAG and GraphRAG, on end-to-end question-answering benchmarks. The effectiveness of our contributions is further corroborated by comprehensive ablation studies. Ultimately, EvoRAG offers an effective framework for building and leveraging knowledge graphs to address complex inquiries.},
 author = {Ma, Youheng and Ni, Chengxin and Chen, Yongxin and Zhang, Xinyi and Chen, Jingyi and Huang, Ruwei},
 booktitle = {2025 5th International Conference on Advanced Algorithms and Neural Networks (AANN)},
 doi = {10.1109/AANN66429.2025.11257648},
 issn = {},
 keyword = {Technological innovation;Accuracy;Heuristic algorithms;Semantics;Retrieval augmented generation;Merging;Neural networks;Knowledge graphs;Question answering (information retrieval);Structural beams;Retrieval-Augmented Generation;Large Language Models;Knowledge Graphs;Question Answering},
 month = {Aug},
 number = {},
 pages = {467-472},
 title = {Evorag: Enhanced Knowledge Graph Construction and Retrieval for Complex Question Answering},
 volume = {},
 year = {2025}
}
