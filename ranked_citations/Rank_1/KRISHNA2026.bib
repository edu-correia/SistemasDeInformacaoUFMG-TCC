@incollection{KRISHNA2026,
 abstract = {Building-Integrated Photovoltaics (BIPV) offer a compelling pathway to merge renewable energy generation with modern architectural design. This chapter presents a comprehensive exploration of BIPVs, beginning with an overview of its unique approach, historical development, and the current global market landscape. Furthermore, the chapter covers the broad spectrum of BIPV materials and technologies, highlighting key innovations enabling effective solar integration into the built environment. Various BIPV product types such as tiles, foils, modules, and glazing systems are then studied to demonstrate their versatility across different building applications. The chapter also outlines essential system components and balance of system (BOS) elements necessary for effective BIPV deployment. Thoughtful design strategies and adherence to national and international standards are emphasized, reinforcing the importance of regulatory compliance and safety in BIPV implementation. A significant part of this chapter is dedicated to the emerging role of Artificial Intelligence (AI) and Machine Learning (ML) techniques in BIPV systems, which are increasingly used for performance prediction, system optimization, and intelligent fault detection - paving the way for smarter, more resilient energy solutions. In addition, the chapter assesses the environmental impact of BIPVs, underlining its potential to reduce carbon emissions and support green building initiatives. Best practices for implementation are also discussed, encompassing product selection, system integration, and operational safety. Special attention is given to fire hazard prevention, which remains a critical consideration in BIPV system design and maintenance. The chapter further highlights the existing challenges, such as initial costs, technological limitations, and regulatory hurdles, that must be addressed for widespread adoption.},
 author = {Amal Krishna and Emel V. Kurian and Dhanup S. Pillai and Veronica Bermudez Benito and Sertac Bayhan and Brahim Aissa},
 booktitle = {Reference Module in Materials Science and Materials Engineering},
 doi = {https://doi.org/10.1016/B978-0-443-29210-1.00084-4},
 isbn = {978-0-12-803581-8},
 keyword = {Building integrated PV, Solar photovoltaics, Machine learning, Sustainable buildings, Best practices, Net-zero buildings},
 publisher = {Elsevier},
 title = {Building-integrated PV systems: Status and development},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443292101000844},
 year = {2026}
}
