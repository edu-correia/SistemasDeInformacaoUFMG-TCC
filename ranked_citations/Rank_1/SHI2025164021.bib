@article{SHI2025164021,
 abstract = {Transition metal carbides/nitrides (MXene) emerge as promising enhancers for high-capacity metal sulfide anodes, owing to exceptional electrical conductivity, mechanical robustness and adaptable surface chemistry. Here, MXene/SnS2 heterostructures with a honeycomb architecture are fabricated by a mild liquid-phase deposition method. Density functional theory calculations reveal that the negatively charged MXene terminal groups govern the Sn4+ cation adsorption, thereby promoting nucleation. By optimizing component dispersion and interfacial bonding, the composite effectively combines the high capacity of SnS2 with the conductive MXene framework, achieving initial discharge capacities of 1547.0 and 555.3 mAh g−1 at the current densities of 0.1 and 5 A g−1, respectively. After 1000 cycles, it retains a capacity retention of 69.5 % at 5 A g−1. The hierarchically structured interface enhances ion transport and pseudocapacitive effects, enabling fast rate performance. The approach provides an idea for designing fast-charging anodes with high energy density.},
 author = {Zhihao Shi and Bingjue Wang and Ziwei Zhang and Han Chen and Yujie Shi and Yulei Sui and Ling Wu},
 doi = {https://doi.org/10.1016/j.apsusc.2025.164021},
 issn = {0169-4332},
 journal = {Applied Surface Science},
 keyword = {Li-ion batteries, MXene, Honeycomb structure, SnS, Composite materials},
 pages = {164021},
 title = {Hierarchical MXene/SnS2 with honeycomb architecture for high performance anode material of Li-ion batteries},
 url = {https://www.sciencedirect.com/science/article/pii/S0169433225017362},
 volume = {711},
 year = {2025}
}
