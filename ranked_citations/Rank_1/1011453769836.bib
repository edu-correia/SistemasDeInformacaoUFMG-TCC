@article{10.1145/3769836,
 abstract = {Deploying Large Language Models (LLMs) on resource-constrained devices remains challenging due to limited memory, lack of GPUs, and the complexity of existing runtimes. In this paper, we introduce TranSQL+, a template-based code generator that translates LLM computation graphs into pure SQL queries for execution in relational databases. Without relying on external libraries, TranSQL+, leverages mature database features-such as vectorized execution and out-of-core processing-for efficient inference. We further propose a row-to-column (ROW2COL) optimization that improves join efficiency in matrix operations. Evaluated on Llama3-8B and DeepSeekMoE models, TranSQL+ achieves up to 20\texttimes{} lower prefill latency and 4\texttimes{} higher decoding speed compared to DeepSpeed Inference and Llama.cpp in low-memory and CPU-only configurations. Our results highlight relational databases as a practical environment for LLMs on low-resource hardware.},
 address = {New York, NY, USA},
 articleno = {371},
 author = {Sun, Wenbo and Guo, Qiming and Wang, Wenlu and Hai, Rihan},
 doi = {10.1145/3769836},
 issue_date = {December 2025},
 journal = {Proc. ACM Manag. Data},
 keyword = {large language models, query processing, relational database},
 month = {December},
 number = {6},
 numpages = {27},
 publisher = {Association for Computing Machinery},
 title = {TranSQL+: Serving Large Language Models with SQL on Low-Resource Hardware},
 url = {https://doi.org/10.1145/3769836},
 volume = {3},
 year = {2025}
}
