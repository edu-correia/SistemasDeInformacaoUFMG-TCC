@conference{Piasecki2017583,
 abstract = {In this article we present the result of the research on the recognition of genuine Polish suicide notes (SNs). We provide useful method to distinguish between SNs and other types of discourse, including counterfeited SNs. The method uses a wide range of word-based and semantic features and it was evaluated using Polish Corpus of Suicide Notes, which contains 1244 genuine SNs, expanded with a manually prepared set of 334 counterfeited SNs and 2200 letter-like texts from the Internet. We utilised the algorithm to create the class-related sense dictionaries to improve the result of SNs classification. The obtained results show that there are fundamental differences between genuine SNs and counterfeited SNs. The applied method of the sense dictionary construction appeared to be the best way of improving the model. © 2018 Association for Computational Linguistics (ACL). All rights reserved.},
 author = {Piasecki, Maciej and Młynarczyk, Ksenia and Kocoń, Jan},
 doi = {10.26615/978-954-452-049-6_076},
 journal = {International Conference Recent Advances in Natural Language Processing, RANLP},
 note = {Cited by: 6; All Open Access; Gold Open Access},
 pages = {583 - 591},
 publication_stage = {Final},
 source = {Scopus},
 title = {Recognition of Genuine Polish suicide notes},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85045763919?origin=resultslist},
 volume = {2017-September},
 year = {2017}
}
