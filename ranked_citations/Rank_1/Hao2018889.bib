@conference{Hao2018889,
 abstract = {In this study, we present a new framework for the prediction of bracket-based competitions, using the Men's NCAA Division 1 basketball championship tournament as an exemplar. The framework consists of the construction of a new classification model using recurrent neural network and the integration of this model with other machine learning models using combinatorial fusion. We first decide three preprocess steps for feature selection: Transform the dataset, merge highly-correlated features, and select and order relevant features. Then the classification model, RNN*, leverages the differences in these factors between two teams to forecast the winning probabilities of each potential game. We also compare this new model with other four classic models, support vector machine (SVM), logistic regression (LOGIT), k-nearest neighbors (KNN) and random forest (RF), using the same features using the Log Loss function. Our results show that RNN has the best and most stable performance, with log loss score of 0.54 exceeding Seed-based benchmark method (0.59). Furthermore, we integrate these five models using combinatorial fusion which takes cognitive diversity between models into consideration. Results documented that in the 2016 competition, prediction accuracy rate increases from 70% for the best individual model to 75% for combined models. © 2018 IEEE.},
 author = {Hao, Yuhan and Kristal, Bruce and Hsu, D. Frank},
 doi = {10.1109/DASC/PiCom/DataCom/CyberSciTec.2018.00-11},
 journal = {Proceedings - IEEE 16th International Conference on Dependable, Autonomic and Secure Computing, IEEE 16th International Conference on Pervasive Intelligence and Computing, IEEE 4th International Conference on Big Data Intelligence and Computing and IEEE 3rd Cyber Science and Technology Congress, DASC-PICom-DataCom-CyberSciTec 2018},
 note = {Cited by: 5},
