@inproceedings{10888965,
 abstract = {Neural Radiance Fields (NeRF) have shown significant potential in encoding complex 3D geometries and visual properties, making them a promising alternative to traditional dense SLAM systems. We propose Proud-SLAM, a dense SLAM framework that merges a neural point-based hybrid scene representation. Our key innovation is the HPoint method, which integrates color features into the point cloud, preserving real-world fidelity and enhancing scene rendering. Additionally, we design a hashV structure to efficiently manage and expand point clouds incrementally. Experiments on Replica and Scan-Net datasets demonstrate that Proud-SLAM excels in tracking precision, reconstruction accuracy, and scene rendering quality.},
 author = {Guo, Wenzhi and Chen, Lijun},
 booktitle = {ICASSP 2025 - 2025 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP49660.2025.10888965},
 issn = {2379-190X},
 keyword = {Point cloud compression;Technological innovation;Surface reconstruction;Simultaneous localization and mapping;Accuracy;Three-dimensional displays;Rendering (computer graphics);Neural radiance field;Speech processing;Surface treatment;NeRF;SLAM;Neural implicit representation;Tracking;Mapping;Reconstruction},
 month = {April},
 number = {},
 pages = {1-5},
 title = {Proud-SLAM: Neural Point-based Hybrid RGBD Monocular Dense SLAM},
 volume = {},
 year = {2025}
}
