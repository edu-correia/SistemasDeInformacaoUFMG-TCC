@conference{Lestanto2025446,
 abstract = {Finding duplicates in large datasets is a challenge in managing data quality. Traditional methods often require a lot of computing power, making them difficult to use for large datasets. This study aims to create a method to find duplicates that is both fast and accurate. This reduces the computing workload while maintaining good performance. The method uses the Smith-Waterman algorithm to calculate similarity accurately and the Sorted Neighborhood Method (SNM) to select candidates efficiently. It also uses a scoring system that considers different attributes, such as names, addresses, phone numbers, and postal codes. To reduce the search, blocking strategies are used as an extra step. An experiment was conducted using real consumer data from a pharmaceutical company. The dataset contained 23,000 records and was kept private. The results show that the method achieves a 98.32% F1-score and reduces the computing complexity from O(n<sup>2</sup>) to O(n log n). The method was quick, processing the dataset in less than 100 ms. It reduced the pairwise comparisons by 90%. This demonstrates that the proposed method is effective for handling large duplicate detection tasks in the industry, improving both scalability and accuracy of the process.  © 2025 IEEE.},
 author = {Lestanto, Yusuf and Mualifa, Rahma},
 doi = {10.1109/ICoCICs68032.2025.11383927},
 journal = {Proceedings - 2025 IEEE 2nd International Conference on Cryptography, Informatics, and Cybersecurity, ICoCICs 2025},
 note = {Cited by: 0},
 pages = {446 - 451},
 publication_stage = {Final},
 source = {Scopus},
 title = {Optimized Duplicate Detection Using Smith-Waterman Algorithm with Sorted Neighborhood Method},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105035594904?origin=resultslist},
