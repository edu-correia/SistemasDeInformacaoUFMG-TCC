@article{TAO2026106036,
 abstract = {Single image dehazing is a fundamental yet challenging task in the field of low-level vision. Existing supervised methods typically require paired training images, which are often difficult and expensive to collect in real-world scenarios.Therefore, unsupervised approaches based on Cycle Generative Adversarial Network (CycleGAN) have been extensively explored. These methods dehaze real hazy images by training with unpaired real-world data. However, existing CycleGAN-based image dehazing methods fail to utilize haze information from real hazy images, which results in unrealistic hazy image generation and consequently limits the network’s dehazing performance. In addition, these methods often suffer from slow inference speed, which makes them difficult to apply in real-time scenarios. To address these issues, an unsupervised image dehazing network (RID-Net) based on improved CycleGAN is proposed. Specifically, an Improved Res2Net (IR) module based on Partial Convolution (PConv) is designed, which provides powerful multi-scale feature extraction capabilities while maintaining low complexity. Additionally, a Dual-Branch Adaptive Feature Fusion (DBFF) module is proposed to guide Generator F in synthesizing more realistic hazy images under the guidance of low-frequency components. Finally, extensive experiments validate that RID-Net performs excellently in dehazing tasks, especially in real-world hazy scenes.},
 author = {Fazhan Tao and Shiyang Dong and Wei Zhang and Qi Chen and Mengyang Li},
 doi = {https://doi.org/10.1016/j.dsp.2026.106036},
 issn = {1051-2004},
 journal = {Digital Signal Processing},
 keyword = {Image dehazing, CycleGAN, FFT, Feature fusion, Lightweight algorithm},
 pages = {106036},
 title = {RID-Net: Towards Real-World Image Dehazing Network Based on Improved CycleGAN and Low-Frequency Fusion},
 url = {https://www.sciencedirect.com/science/article/pii/S1051200426001557},
 year = {2026}
}
