@article{11494232,
 abstract = {Efficient selection of optimal spatiotemporal coverage from massive remote sensing datasets is a critical bottleneck in operational data centers, limiting real-time applications. Current systems rely on geometric overlay-based methods, which suffer from severe efficiency degradation (minutes to tens of minutes) for datasets exceeding tens of thousands of images and become computationally prohibitive under cloud coverage constraints. To address this, we propose a grid-based parallel scoring algorithm (GBPSA). The algorithm discretizes the spatial coverage of remote sensing images, user query areas, and cloud-covered regions into grids, and employs a combination of “grid code matching and dynamic scoring mechanism” to form a rapid screening method for spatiotemporal coverage, optimizing coverage effectiveness while mitigating cloud interference. Our approach leverages the inherent concurrency of spatial grids and establishes a flexible partitioning and deduplication merging strategy based on space-filling curves for the screening and processing of large-scale remote sensing data, significantly improving efficiency while ensuring the accuracy of the screening. Comprehensive evaluation using the GF-2 archive (over 70 000 images) demonstrates that GBPSA achieves an 89.2% reduction in processing time compared to prior state-of-the-art methods while maintaining equivalent coverage quality, with only a minimal ($< $2%) increase in required image count. This significant performance advancement enables real-time applications including disaster response and precision agriculture, substantially enhancing the operational capabilities of modern remote sensing data centers.},
 author = {Sun, Yuekun and Tong, Xiaochong and Bai, Yunrui and Guo, Hao and Wang, Xiaoliang and Yuan, Chang},
 doi = {10.1109/JSTARS.2026.3686123},
 issn = {2151-1535},
 journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
 keyword = {Earth Observing System;Satellite images;Aerospace control;Landsat;Sentinel-2;Aerospace and electronic systems;Radio broadcasting;Frequency modulation;Filtering;Filters;Cloud occlusion;grid discretization;image selection;optimal coverage;parallel algorithm;remote sensing},
 month = {},
 number = {},
 pages = {15234-15251},
 title = {GBPSA: An Efficient Grid-Based Parallel Scoring Algorithm for Spatiotemporal Coverage Analysis of Large-Scale Remote Sensing Data},
 volume = {19},
 year = {2026}
}
