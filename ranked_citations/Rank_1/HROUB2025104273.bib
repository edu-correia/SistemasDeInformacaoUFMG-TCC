@article{HROUB2025104273,
 abstract = {Accurate modeling of parabolic trough collectors (PTCs) demands capturing combined dynamic environmental effects that steady-state analyses often miss. We introduce a hybrid computational fluid dynamics (CFD) framework in ANSYSFluent that merges steady-state and transient simulations for two systems—a stainless-steel PTC (PTC-SS) and a semi-parabolic linear Fresnel reflector (SPLFR)—each fitted with U-pipe and In/Out pipes receivers. By utilizing customizable algorithms to apply solar radiation variability, incidence-angle effects, shadowing, and heat losses, our model achieves validation errors below 4% in steady state (an average error of 2.6% for In/Out pipes and 3% for U-pipe) and an average of 2.29% in transient mode. Steady-state results identify 0.05 kg s−1 as the optimal mass flow rate, balancing heat transfer and pumping power. Compared to the U-pipe, the In/Out pipes design’s direct fluid-absorber contact not only reduced absorber temperatures by 52% but also improved fluid temperatures by one degree, demonstrating higher heat transfer efficiency. The SPLFR’s more uniform flux distribution further reduces thermal stress. Transient simulations show that optical and convective losses together account for 82.4% of total losses, reducing usable energy by 39.36%. These findings demonstrate that incorporating transient environmental factors is essential for accurate performance prediction, directly improving heat transfer, structural durability, and optimization approaches.},
 author = {Qussay Hroub and Skander Jribi and Youssef Drira and Hatem Bentaher},
 doi = {https://doi.org/10.1016/j.tsep.2025.104273},
 issn = {2451-9049},
 journal = {Thermal Science and Engineering Progress},
 keyword = {In/Out pipes, PTC-SS, Transient simulation, U-pipe, SPLFR},
 pages = {104273},
 title = {A Hybrid CFD Model for PTC Systems: Integrating Transient Analysis},
 url = {https://www.sciencedirect.com/science/article/pii/S2451904925010649},
 volume = {68},
 year = {2025}
}
