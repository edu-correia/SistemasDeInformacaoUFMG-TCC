@article{SRIKOON2026102310,
 abstract = {This study aims to optimize teachers' learning-design capacity by developing a dual curriculum integrating digi modernism and educational neuroscience, using the Educational Design Research (EDR) method. The research was conducted across three iterative phases. Phase 1 involved 600 teachers in the quantitative needs assessment and 31 stakeholders in qualitative exploration. Phase 2 engaged 46 participants—including teachers, administrators, digital-platform developers, and external experts—in co-designing the curriculum prototype. Phase 3 involved 41 participants in the implementation and evaluation of the curriculum. Findings from a quantitative needs analysis and qualitative exploration indicated a strong demand for an integrated curriculum that bridges digital innovation and neurocognitive pedagogies. The resulting dual curriculum comprised six chapters that addressed learning design foundations and key neurocognitive constructs—attention, working memory, executive function, and emotion—through blended learning, PLC collaboration, and mentoring. A repeated-measures analysis across seven assessment points revealed a statistically significant improvement in teachers’ learning-design capacity (η2 = 0.989). Qualitative reflections further demonstrated that teachers applied digi modernism and neuroscience principles to create cognitively aligned and emotionally supportive learning environments. Overall, the dual curriculum represents a context-responsive, theory-informed intervention with strong potential to enhance teacher professional learning in digital and hybrid educational contexts.},
 author = {Sanit Srikoon and Pornsawan Vongtathum and Charuni Samat and Natthiya Pumyoch},
 doi = {https://doi.org/10.1016/j.ssaho.2025.102310},
 issn = {2590-2911},
 journal = {Social Sciences & Humanities Open},
 keyword = {Learning design capacity, Curriculum, Digi modernism, Professional learning community, Educational neuroscience, Educational design research},
 pages = {102310},
 title = {Enhancing teachers’ learning design capacity via a dual curriculum integrating digi modernism and educational neuroscience},
 url = {https://www.sciencedirect.com/science/article/pii/S2590291125010411},
 volume = {13},
 year = {2026}
}
