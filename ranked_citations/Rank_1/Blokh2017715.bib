@conference{Blokh2017715,
 abstract = {This paper's focus is to continue the research on Internet psychological warfare analysis, where the authors faced a necessity to propose an accurate algorithm for news clustering that could be able to group news into semantically close sets. A two stage approach to reach that goal is proposed. First a similarity estimation between news messages is performed using semantic similarity metric based on WordNet. Next, the most suitable for given data structure clustering algorithms is selected in order to obtain thematic news clusters and observe their size distribution over time. Experiments were made on news volumes from several news mass media official pages in Facebook. © 2017 The Authors. Published by Elsevier B.V.},
 author = {Blokh, Ilya and Alexandrov, Vassil},
 doi = {10.1016/j.procs.2017.11.428},
 journal = {Procedia Computer Science},
 note = {Cited by: 10; All Open Access; Gold Open Access},
 pages = {715 - 719},
 publication_stage = {Final},
 source = {Scopus},
 title = {News clustering based on similarity analysis},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85040306968?origin=resultslist},
 volume = {122},
 year = {2017}
}
