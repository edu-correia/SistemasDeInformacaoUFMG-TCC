@article{XU2025139775,
 abstract = {To investigate the influence of pore structure on the early mechanical properties and durability of rapid-hardening (RHFC) and ordinary foamed concrete (OFC), uniaxial compression and freeze-thaw cycle tests were conducted on both types of samples. The variations and differences in their performance were revealed. Using X-CT equipment, the pore structures at different curing ages and freeze-thaw cycles were scanned, achieving the 3D reconstruction of pore network models and the quantitative characterization of parameters. The relationship between parameters and early mechanical and durability performance was explored, clarifying the freeze-thaw degradation mechanisms of both types of foam concrete. The results indicated that: (1) Before and after freeze-thaw cycles, the stress-strain curves of both foamed concretes four stages: initial compaction, elasticity, yielding, and platform. Moreover, the compressive strength of RHFC is consistently higher than that of OFC. (2) With the increase in the number of freeze-thaw cycles, both types of foam concrete show an increase in compressive strength and mass damage rate, with OFC exhibiting a higher damage rate, at 11.97 % and 4.84 %, respectively. At the same time, the surface damage of both types deepens, although the overall structure remains intact. (3) When the age and freeze-thaw cycle numbers change simultaneously, the porosity, fractal dimension, pore size, and number of pores of both foam concretes exhibit opposite trends. In addition, the main pore shape of both types is spherical. (4) In the early stages of freeze-thaw cycles, the damage to both foam concretes primarily originates from the rupture and merging of pores, while in the later stages, the damage is caused by an increase in the number of pores and their gradual interconnection. Furthermore, this study provides key theoretical support for the reliable application of RHFC in cold-region engineering. Research on the pore structure of RHFC under freeze-thaw conditions and its effects on early mechanical properties, durability, and degradation mechanisms can provide essential theoretical support for its reliable application in cold-region engineering.},
 author = {Jiangbo Xu and Danni Zhao and Shaowei Wang and Xinyu Chen and Xiong Wu and Zemin Han and Yifan Liu},
 doi = {https://doi.org/10.1016/j.conbuildmat.2024.139775},
 issn = {0950-0618},
 journal = {Construction and Building Materials},
 keyword = {Rapid-hardening foam concrete, Ordinary foam concrete, Early mechanical properties, Durability, Pore network model, Freeze-thaw deterioration mechanism},
 pages = {139775},
 title = {Quantitative analysis of pore structure's impact on early mechanical properties and durability of foam concrete: Macroscopic and mesoscopic insights},
 url = {https://www.sciencedirect.com/science/article/pii/S0950061824049171},
 volume = {459},
 year = {2025}
}
