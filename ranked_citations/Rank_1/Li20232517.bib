@conference{Li20232517,
 abstract = {Discourse processing suffers from data sparsity, especially for dialogues. As a result, we explore approaches to build discourse structures for dialogues, based on attention matrices from Pre-trained Language Models (PLMs). We investigate multiple tasks for fine-tuning and show that the dialogue-tailored Sentence Ordering task performs best. To locate and exploit discourse information in PLMs, we propose an unsupervised and a semi-supervised method. Our proposals thereby achieve encouraging results on the STAC corpus, with F<sub>1</sub> scores of 57.2 and 59.3 for the unsupervised and semi-supervised methods, respectively. When restricted to projective trees, our scores improved to 63.3 and 68.1. © 2023 Association for Computational Linguistics.},
 author = {Li, Chuyuan and Huber, Patrick and Xiao, Wen and Amblard, Maxime and Braud, Chloé and Carenini, Giuseppe},
 doi = {10.18653/v1/2023.findings-eacl.194},
 journal = {EACL 2023 - 17th Conference of the European Chapter of the Association for Computational Linguistics, Findings of EACL 2023},
 note = {Cited by: 13; All Open Access; Gold Open Access; Green Open Access},
 pages = {2517 - 2534},
 publication_stage = {Final},
 source = {Scopus},
 title = {Discourse Structure Extraction from Pre-Trained and Fine-Tuned Language Models in Dialogues},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85159856819?origin=resultslist},
 year = {2023}
}
