@article{Mubeena2025,
 abstract = {Managing healthcare data on blockchain networks poses unique challenges, particularly related to gas usage and transaction costs, which can significantly affect the scalability, feasibility, and efficiency of these systems. This study introduces a Quantum-Enhanced Hybrid Particle Swarm Optimization-Ant Colony Optimization (PSO-ACO) algorithm designed to enhance gas efficiency within an IoT-blockchain-driven healthcare data management system. The proposed approach leverages real-time gas usage data from Ethereum blockchain transactions by incorporating quantum-inspired improvements into conventional PSO and ACO algorithms. These modifications enhance gas efficiency while preserving key aspects of the system, including data integrity, security, and general system performance. For performance assessment, the Quantum-Enhanced Hybrid PSO-ACO algorithm is comprehensively compared with baseline models, as well as standard PSO, ACO, and traditional hybrid PSO-ACO methods. Results indicate that this quantum-enhanced hybrid approach significantly reduces gas consumption, while also realizing notable improvements in processing speed and latency. These impressive outcomes underscore the potential of the Quantum-Enhanced Hybrid PSO-ACO algorithm in developing scalable and cost-effective approaches for handling healthcare data within blockchain systems. This study advances the integration of IoT and blockchain technologies, providing valuable insights to the domain and paving the way for future research focused on optimizing distributed healthcare systems and addressing the substantial costs associated with blockchain gas fees. © 2025, University of Bahrain. All rights reserved.},
 author = {Mubeena, S. and Jawahar, P.K.},
 doi = {10.12785/ijcds/1571147413},
 journal = {International Journal of Computing and Digital Systems},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 number = {1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Quantum Optimization for Enhanced Gas Consumption in IoT-Integrated-Blockchain-Based Healthcare Model},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105023081768?origin=resultslist},
 volume = {18},
