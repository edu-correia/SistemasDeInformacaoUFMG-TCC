@inproceedings{5164472,
 abstract = {An automated structural optimization system named VCD (Vehicle Concept Design) is shown in the paper. The system is based on CAE technology and also merges some advanced technology such as template method, parametric technology and optimization technology. It can build parametric body geometry model and FEM mesh model rapidly and automatically. The body's stiffness and modal could be solved well and truly by the system to evaluate body's performance for designer. The parametric optimization and shape optimization of section were implemented to improve the performance of vehicle body. In the paper, the contrast of structural analysis between real model and VCD model shows the validity of the system and the paper also give an example of optimization for lightweight of body in conceptual phase.},
 author = {Hongzhe Zhang and Shuren Zhang and Ping Hu and Wenbin Hou},
 booktitle = {2009 IEEE Intelligent Vehicles Symposium},
 doi = {10.1109/IVS.2009.5164472},
 issn = {1931-0587},
 keyword = {Intelligent systems;Design optimization;Vehicle safety;Space vehicles;Automotive engineering;Design engineering;Computer aided engineering;Solid modeling;Shape;Intelligent structures},
 month = {June},
 number = {},
 pages = {1302-1306},
 title = {An intelligent system based on optimization for car body design},
 volume = {},
 year = {2009}
}
