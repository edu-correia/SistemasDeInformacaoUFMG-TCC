@inproceedings{11044139,
 abstract = {To realize an energy-efficient transmitter (TX) for ultra-low-power (ULP) Internet-of-Things (IoT) applications, function-reuse oscillator–power-amplifiers (Osc-PAs) provide high efficiency and tight system integration by merging an oscillator ("Osc", either a digitally controlled, DCO, or voltage-controlled, VCO) with a power amplifier (PA) into a single block. This work presents the latest advancements in Osc-PAs for IoT applications. It covers the architectural evolution, design considerations, and limitations of Osc-PAs. Finally, the prospects of reusing and implementing TX Osc-PA to achieve RX-clock generation by leveraging mode-switching techniques in fully integrated transceivers (TRXs) will be discussed.},
 author = {Chen, Jiawen and Xu, Kai and Staszewski, Robert Bogdan},
 booktitle = {2025 IEEE International Symposium on Circuits and Systems (ISCAS)},
 doi = {10.1109/ISCAS56072.2025.11044139},
 issn = {2158-1525},
 keyword = {Local oscillators;Voltage-controlled oscillators;Radio transmitters;Merging;Power amplifiers;System integration;Transceivers;Topology;Internet of Things;Voltage control;Internet-of-Things (IoT);ultra-low-power (ULP);transmitter (TX);transceiver (TRX);oscillator;power amplifier (PA);DCO-PA;VCO-PA;mode-switching;local oscillator (LO)},
 month = {May},
 number = {},
 pages = {1-5},
 title = {Function-Reused Oscillator-PA for IoT Applications},
 volume = {},
 year = {2025}
}
