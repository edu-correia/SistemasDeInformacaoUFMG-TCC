@conference{Olivo-Marin200929,
 abstract = {It is now a common consensus that in-depth understanding of biological systems requires robust and systematic quantification of their spatiotemporal characteristics. This endeavour has been significantly enlightened over the past decades thanks to the numerous advances in fluorescent probes, labeling techniques and microscopy systems. It is likewise a consensus that more powerful and specific signal/image processing methods are henceforth required to process the large amounts and variety of signals in biology and biomedicine. Here we give a panorama of some state-of-the-art image processing methods and also point at signal processing challenges and outline topics for future research. © 2009 IEEE.},
 author = {Olivo-Marin, Jean-Christophe},
 doi = {10.1109/LISSA.2009.4906701},
 journal = {2009 IEEE/NIH Life Science Systems and Applications Workshop, LiSSA 2009},
 note = {Cited by: 0},
 pages = {29 - 32},
 publication_stage = {Final},
 source = {Scopus},
 title = {Bioimaging: A new frontier area for signal processing research},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/67650664242?origin=resultslist},
 year = {2009}
}
