@inproceedings{8698633,
 abstract = {Barcode detection has been elaborately investigated before. Traditional hand-crafted feature based methods achieve promising performances across some simple and high-quality test databases. However, they usually fall short as a part of barcode decoding pipeline when dealing with challenging scenarios, because of the low robustness and accuracy achieved by low-level features. In this paper, we present a barcode detection network pipeline, designed to generate accurate barcode regions with category labels. We also build a rich barcodes detection dataset-Mixed Barcode Dataset. Experimental results conducted on different barcode databases show the superiority of our method in terms of F-score and decoding accuracy compared to the state of arts.},
 author = {Tian, Yuan and Che, Zhaohui and Zhai, Guangtao and Gao, Zhiyong},
 booktitle = {2018 IEEE Visual Communications and Image Processing (VCIP)},
 doi = {10.1109/VCIP.2018.8698633},
 issn = {1018-8770},
 keyword = {Feature extraction;Proposals;Decoding;Merging;Databases;Convolutional codes;Detectors;Barcode detection;multi-level pooling;region proposal networks;object accurate detection;convolutional neutral networks},
 month = {Dec},
 number = {},
 pages = {1-5},
 title = {BAN, A Barcode Accurate Detection Network},
 volume = {},
 year = {2018}
}
