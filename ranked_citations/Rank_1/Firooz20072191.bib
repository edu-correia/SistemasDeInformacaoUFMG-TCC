@article{Firooz20072191,
 abstract = {Unlike those on Internet, the media providers on P2P networks are ordinary nodes with limited shared resources such as bandwidth. Multi-sender methods are the best existing solutions to video streaming on P2P networks. In this paper, we propose use of a multicast method on the top of an arbitrary multi-sender method so that all requesting peers receive almost the same expected bit-rate. Experimental results, derived from implementation of the proposed algorithm on Pastry P2P network confirm our claim. Another advantage of our method over the existing methods is its scalability with the number of receivers. © 2007 Elsevier B.V. All rights reserved.},
 author = {Firooz, Mohammad Hamed and Ronasi, Keivan and Pakravan, Mohammad Reza and Avanaki, Alireza Nasiri},
 doi = {10.1016/j.comcom.2007.05.008},
 journal = {Computer Communications},
 note = {Cited by: 5},
 number = {10},
 pages = {2191 - 2200},
 publication_stage = {Final},
 source = {Scopus},
 title = {A multi-sender multicast algorithm for media streaming on peer-to-peer networks},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/34447629703?origin=resultslist},
 volume = {30},
 year = {2007}
}
