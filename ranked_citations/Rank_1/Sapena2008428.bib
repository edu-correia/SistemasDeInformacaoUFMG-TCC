@article{Sapena2008428,
 abstract = {This paper presents a method for Entity Disambiguation in Information Extraction from different sources in the web. Once entities and relations between them are extracted, it is needed to determine which ones are referring to the same real-world entity. We model the problem as a graph partitioning problem in order to combine the available information more accurately than a pairwise classifier. Moreover, our method handle uncertain information which turns out to be quite helpful. Two algorithms are trained and compared, one probabilistic and the other deterministic. Both are tuned using genetic algorithms to find the best weights for the set of constraints. Experiments show that graph-based modeling yields better results using uncertain information. © 2008 Springer-Verlag Berlin Heidelberg.},
 author = {Sapena, Emili and Padró, Lluís and Turmo, Jordi},
 doi = {10.1007/978-3-540-85287-2_41},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {428 - 439},
 publication_stage = {Final},
 source = {Scopus},
 title = {A graph partitioning approach to Entity Disambiguation using uncertain information},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/52149113792?origin=resultslist},
 volume = {5221 LNAI},
 year = {2008}
}
