@inproceedings{10867322,
 abstract = {Stroke and related neurological disorders are difficult to classify accurately, hence new computational approaches are needed to enhance diagnosis. In order to transform the categorization of brain strokes, this study presents Neuro-Xception, a novel framework that combines the Xception architecture with Extreme Learning Machines (ELM). The rapid learning speed and enhanced generalisation capability of ELMs are combined with the feature extraction expertise of Xception to create Neuro-Xception. Through training on large neuroimaging datasets, Neuro-Xception learns complex patterns that are essential for differentiating between different types and intensities of stroke. By means of extensive testing on various datasets, Neuro-Xception exhibits notable gains in performance compared to traditional techniques, indicating its potential to revolutionise stroke detection in medical environments. Furthermore, Neuro-Xception's scalability and flexibility are enhanced by the combination of Xception and ELMs, which makes it a viable tool for real-time clinical decision support systems and personalised medicine. This study highlights how merging Xception and ELMs can revolutionise neurological healthcare and this development could lead to more accurate and efficient diagnostic techniques for treating stroke patients. Neuro-Xception offers a potential path for increasing diagnosis accuracy and expediting timely medical intervention. It is a major step forward in the use of artificial intelligence to enhance patient outcomes and advance the profession of stroke care.},
 author = {S, Jagadeesan and Ramalingam, Venkadeshan and P, Abinash and V, Ilayaraja and Masood, Jafar Ali Ibrahim Syed and D, Tamil Priya},
 booktitle = {2024 2nd International Conference on Computing and Data Analytics (ICCDA)},
 doi = {10.1109/ICCDA64887.2024.10867322},
 issn = {},
 keyword = {Training;Neurological diseases;Neuroimaging;Accuracy;Scalability;Transforms;Stroke (medical condition);Real-time systems;Medical diagnostic imaging;Testing;Neuro-Xception;brain strokes;Extreme Learning Machines (ELM);Xception},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Revolutionizing Brain Stroke Classification with Neuro-Xception and ELM Integration in Deep Learning},
 volume = {},
 year = {2024}
