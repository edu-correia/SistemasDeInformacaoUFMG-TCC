@article{CarreroMantilla2019_283,
 abstract = {Abstract There is no standard procedure for calculating the generalized temperature integral, instead myriads of different approximations to it are applied in the processing of thermogravimetric analysis data. This work presents first an integration procedure based on the Simpson rule that generates reference values of the generalized temperature integral. It also reviews the available representations of the temperature integral in power series, and presents the conversion of its generalized form into the form of special functions. From the comparison with the reference values from integration it was concluded that for argument values of practical interest the generalized temperature integral is best computed as the incomplete gamma function.},
 author = {Carrero-Mantilla, J. I. and Rojas-González, A. F.},
 doi = {10.25100/iyc.v21v2i.8047},
 number = {2},
 pages = {8047--8047},
 title = {Calculation of the temperature integrals used in the processing of thermogravimetric analysis data},
 volume = {21},
 year = {2019}
}
