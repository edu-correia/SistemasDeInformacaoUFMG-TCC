@article{10.1145/3802028,
 abstract = {Prefix-sharing among multiple prompts presents opportunities to combine the operations of the shared prefix, while attention computation in the decode stage, which becomes a critical bottleneck with increasing context lengths, is a memory-intensive process requiring heavy memory access on the key-value (KV) cache of the prefixes. Therefore, in this paper, we explore the potential of prefix-sharing in the attention computation of the decode stage. However, the tree structure of the prefix-sharing mechanism presents significant challenges for attention computation in efficiently processing shared KV cache access patterns while managing complex dependencies and balancing irregular workloads. To address the above challenges, we propose a dedicated attention kernel to combine the memory access of shared prefixes in the decoding stage, namely CoDec. CoDec delivers two key innovations: a novel shared-prefix attention kernel that optimizes memory hierarchy and exploits both intra-block and inter-block parallelism, and a comprehensive workload balancing mechanism that efficiently estimates cost, divides tasks, and schedules execution. Experimental results show that CoDec achieves an average 1.9\texttimes{} speedup and 120.9\texttimes{} memory access reduction compared to the state-of-the-art FlashDecoding kernel regarding attention computation in the decode stage and 3.8\texttimes{} end-to-end time per output token compared to vLLM.},
 address = {New York, NY, USA},
 articleno = {151},
 author = {Wang, Zhibin and Ning, Rui and Fang, Chao and Zhang, Zhonghui and Lin, Xi and Ma, Shaobo and Zhou, Mo and Li, Xue and Wang, Zhongfeng and Huan, Chengying and Gu, Rong and Yang, Kun and Chen, Guihai and Zhong, Sheng and Tian, Chen},
 doi = {10.1145/3802028},
 issue_date = {June 2026},
 journal = {Proc. ACM Manag. Data},
 keyword = {gpu kernel, large language models (llms), attention computation, prefix-sharing},
 month = {May},
 number = {3},
 numpages = {27},
 publisher = {Association for Computing Machinery},
 title = {CoDec: Prefix-Shared Decoding Kernel for LLMs},
 url = {https://doi.org/10.1145/3802028},
 volume = {4},
 year = {2026}
}
