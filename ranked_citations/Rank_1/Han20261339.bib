@conference{Han20261339,
 abstract = {This paper proposes a deep learning-based air quality prediction model aimed at accurately forecasting key air quality indicators, PM2.5 and PM10. The study innovatively replaces the multi-head attention mechanism in the encoder of the Transformer model with a Patch-wise Attention mechanism, while also incorporating the SCI-Block module and the FeatureMixingMLP module to construct an efficient and precise prediction model. The encoder extracts time-series features through multiple layers of Patch-wise Attention, and the decoder utilizes the Transformer architecture to make accurate predictions of future air quality. Additionally, the SCI-Block feature mixing module is introduced to effectively merge feature information at different levels, enhancing the model's ability to capture complex air quality fluctuation patterns. Experimental results show that the model performs excellently in predicting PM2.5 and PM10, achieving R<sup>2</sup> values of 0.977 and 0.951, respectively, demonstrating outstanding predictive performance and generalization ability. This research provides a new approach for air quality prediction, and the proposed model is expected to offer strong technical support for environmental monitoring and public health decision-making, aiding in more precise air quality monitoring and early warning. © 2026 IEEE.},
 author = {Han, Shaohu and Jiang, Mianyu and Wang, Hongkai and Chi, Zhanfeng},
 doi = {10.1109/ICPEGE67691.2026.11451657},
 journal = {2026 IEEE International Conference on Power, Electronics and Green Energy, ICPEGE 2026},
