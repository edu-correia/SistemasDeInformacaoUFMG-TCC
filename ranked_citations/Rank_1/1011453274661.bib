@article{10.1145/3274661,
 abstract = {We introduce the Connection Scan Algorithm (CSA) to efficiently answer queries to timetable information systems. The input consists, in the simplest setting, of a source position and a desired target position. The output consists of a sequence of vehicles such as trains or buses that a traveler should take to get from the source to the target. We study several problem variations such as the earliest arrival and profile problems. We present algorithm variants that only optimize the arrival time or additionally optimize the number of transfers in the Pareto sense. An advantage of CSA is that it can easily adjust to changes in the timetable, allowing the easy incorporation of known vehicle delays. We additionally introduce the Minimum Expected Arrival Time (MEAT) problem to handle possible, uncertain, future vehicle delays. We present a solution to the MEAT problem that is based on CSA. Finally, we extend CSA using the multilevel overlay paradigm to answer complex queries on nationwide integrated timetables with trains and buses.},
 address = {New York, NY, USA},
 articleno = {1.7},
 author = {Dibbelt, Julian and Pajor, Thomas and Strasser, Ben and Wagner, Dorothea},
 doi = {10.1145/3274661},
 issn = {1084-6654},
 issue_date = {2018},
 journal = {ACM J. Exp. Algorithmics},
 keyword = {Pareto optimization, Shortest path, preprocessing, routing, stochastic, timetable, train delay},
 month = {October},
 numpages = {56},
 publisher = {Association for Computing Machinery},
 title = {Connection Scan Algorithm},
 url = {https://doi.org/10.1145/3274661},
 volume = {23},
 year = {2018}
}
