@article{Schneider20223,
 abstract = {Online monitors for first-order specifications may need to store many domain values in their state, requiring significant memory. We propose an approach that compresses the monitor’s state using randomized hash functions. Unlike input sampling, our approach does not require the knowledge of distributions over traces to achieve low error probability. We develop algorithms that insert hash functions into temporal–relational algebra specifications and compute upper bounds on the resulting error probability. We employ a special hashing scheme that allows us to merge values across attributes, which further reduces memory usage. We evaluated our implementation and achieved memory reductions up to 33 % when monitoring traces with large domain values, with error probability less than two in a million. © 2022, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Schneider, Joshua},
 doi = {10.1007/978-3-031-17196-3_1},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {3 - 24},
 publication_stage = {Final},
 source = {Scopus},
 title = {Randomized First-Order Monitoring with Hashing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85140454827?origin=resultslist},
 volume = {13498 LNCS},
 year = {2022}
}
