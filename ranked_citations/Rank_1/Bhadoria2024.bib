@conference{Bhadoria2024,
 abstract = {This paper presents system design, integration and end-to-end characterization of 220-230GHz and 330-345GHz heterodyne spectrometer systems for ground based sub-mm wave telescope, proposed to be deployed at Hanle, India. This telescope will generate the first comprehensive survey maps of molecular clouds in the Milky Way and nearby galaxies from the northern hemisphere at these frequencies. This telescope consists of low-noise cryo-cooled sideband separating heterodyne receivers with wideband high speed digital FFT based spectrometer system to observe (J: 2 → 1 and J: 3 → 2) rotational transitions of different isotopes of CO (i.e. 12CO and 13CO) with 54” and 36” angular, and 1.6MHz spectral resolution. Noise Temperatures for 230GHz and 345GHz RF Frontends will be 450K and 525K at cryotemperatures and are at-par with state-of-the-art Schottky-barrier diode (SBD) based receivers. Spectrometer system is a 4-channel instrument providing total 8GHz bandwidth with a spectral resolution of 1.6MHz, which can be further optimized to 400KHz. End-to-end performance of the 230GHz and 345GHz integrated systems with 0.5m reflector in ambient lab environment is demonstrated. Current paper discusses system configuration design and specifications, hardware configuration, integration methodology and end-to-end characterization results of integrated 230GHz and 345GHz heterodyne spectrometer system at ambient temperature. © 2024 IEEE.},
 author = {Bhadoria, Mahendra Pratap Singh and Chakraborty, Prantik and Tolani, Harshita and Bhattacharya, Anamiya and Bhattacharyya, Shrija and Latheef, Shaik A. and Kumar, Vipin and Rao, C.V.N.},
 doi = {10.1109/MAPCON61407.2024.10922931},
 journal = {2024 IEEE Microwaves, Antennas, and Propagation Conference, MAPCON 2024},
 note = {Cited by: 0},
 pages = {},
