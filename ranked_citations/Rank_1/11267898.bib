@inproceedings{11267898,
 abstract = {In this study, a machine learning-based prediction system for forecasting flight arrival delays has been developed. Increasing air traffic, operational complexity, and uncertainties in weather conditions have made predicting flight delays progressively more critical [1]. In this context, our study aims not only to produce short- term forecasts but also to provide meaningful delay predictions to contribute to airline management processes [2]. The prediction system, developed as a web application using the Flask framework, enables users to access model outputs through an internet browser; thus, delay predictions can be presented dynamically in minutes via the trained models.In the study, extensive preprocessing steps including data cleaning, outlier correction (IQR), conversion of categorical variables using one-hot encoding, and basic feature engineering were applied on a large dataset of U.S. flights [3]. The dataset, obtained from the official website of the United States Department of Transportation / Bureau of Transportation Statistics, consists of approximately 454,414 rows and 40 columns [4]. To better analyze the impact of weather conditions on flight delays, weather data was collected using the Meteostat Python package [5]. The acquired data was processed in Python as DataFrames and merged with existing flight data to create a more advanced and comprehensive dataset [6]. Thanks to this integration, the accuracy of the prediction model was significantly improved. During the prediction process, the XGBoost algorithm achieved an R2 score of 91.9%, while the Random Forest algorithm reached 91.7%, representing the best performing models [7], [8]. These two methods were preferred due to their compatibility with large datasets, advantages regarding data structure, and successful application in previous studies [9]. These models stood out in the task of predicting delay durations.Other advanced algorithms such as CatBoost, LightGBM, and LSTM were also tested and included in the model comparisons [10]. However, the performance of these models remained lower compared to XGBoost and Random Forest [11]. All models were evaluated using regression metrics such as R2, MAE, and RMSE, and model-based variable importance analyses identified key factors influencing delays [12].In conclusion, this study demonstrates that data-driven prediction approaches enhance the capability to forecast flight delays in advance, enabling airlines to make more effective and proactive decisions in critical processes such as operational planning, customer notification, and resource allocation [13].},
 author = {Demirkaya, Yağmur and Gencer, Kerem and Meydan, Sude and Guven, Murat Okan and Savran, İsmail},
 booktitle = {2025 9th International Symposium on Multidisciplinary Studies and Innovative Technologies (ISMSIT)},
 doi = {10.1109/ISMSIT67332.2025.11267898},
 issn = {2770-7962},
 keyword = {Atmospheric modeling;Wind speed;Data preprocessing;Predictive models;Prediction algorithms;Data models;Delays;Planning;Random forests;Airline industry;Flight delay prediction;XGBoost;LightGBM;Machine learning;Regression;Data preprocessing;Feature engineering;Model comparison},
 month = {Nov},
