@article{WANG2025117600,
 abstract = {For red–green–blue with depth (RGB-D) rail surface defect detection (RSDD), most models focus on improving accuracy, while ignoring computational costs. To address this gap, we introduce a hierarchical cross-modal multi-anchor distillation network (HCMD) for RSDD. Moreover, we propose an innovative defect detection approach, comprising three key stages: merge, split, recombine. During feature extraction, multi-layer features are divided into high- and low-level guidance features using a cross-modal cross-stage fusion module. Subsequently, the learned semantic feature is used to guide the low-level feature fusion using a multiscale graph convolution. Finally, to reduce the computational effort, hierarchical cross-modal multi-anchor distillation loss is used to transfer the teacher’s knowledge to the student, thus achieving model compression. Extensive experiments using the NEU RSDDS-AUG benchmark RGB-D dataset demonstrate our HCMD’s superiority in terms of reduced computational complexity and high accuracy.},
 author = {Bingying Wang and Fangfang Qiang and Wujie Zhou},
 doi = {https://doi.org/10.1016/j.measurement.2025.117600},
 issn = {0263-2241},
 journal = {Measurement},
 keyword = {Transformer, Graph convolution network, Knowledge distillation, Cross-modal and cross-stage fusion, Rail defect inspection},
 pages = {117600},
 title = {Hierarchical Cross-Modal multianchor distillation for rail surface defect detection},
 url = {https://www.sciencedirect.com/science/article/pii/S0263224125009595},
 volume = {253},
 year = {2025}
}
