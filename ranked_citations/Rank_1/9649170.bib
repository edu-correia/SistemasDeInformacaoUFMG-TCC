@inproceedings{9649170,
 abstract = {Diabetic retinopathy is a common condition that impairs a person's vision. For its treatment, a laser coagulation operation is used. In order to achieve the best efficiency, a coagulation plan must be created. Selection macular edema region is the first step in creating this plan. The use of optical coherence tomography data allows the most accurate determination of the edema zone. In this paper, we propose a technology that makes it possible to assess the accuracy of selection macular edema region in fundus images at various stages of the technology for selecting the area of interest using optical coherence tomography data. This allows the most accurate assessment of the operation of the entire technology and identify problem areas.},
 author = {Demin, Nikita and Ilyasova, Natalya and Gaidel, Andrey},
 booktitle = {2021 International Conference on Information Technology and Nanotechnology (ITNT)},
 doi = {10.1109/ITNT52450.2021.9649170},
 issn = {},
 keyword = {Measurement;Retinopathy;Optical coherence tomography;Estimation;Coagulation;Diabetes;Quality assessment;diabetic retinopathy;accuracy estimation metrics;homography matrix},
 month = {Sep.},
 number = {},
 pages = {1-7},
 title = {Information technology for estimation accuracy of selection macular edema region in fundus images using OCT data},
 volume = {},
 year = {2021}
}
