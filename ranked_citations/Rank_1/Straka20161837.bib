@conference{Straka20161837,
 abstract = {The paper deals with state estimation of nonlinear stochastic dynamic systems in the Bayesian framework. In particular, the stress is laid on an introduction of a performance index, which can inform about working conditions of the filter and about the quality of approximations used by the filter. The performance index is based on the characteristic function and two of its applications are treated: i) its usage as a non-Gaussianity measure to inform a Gaussian filter about the validity of its assumption and ii) its utilization as an optimization criterion providing parameters of a Gaussian mixture used to replace a Gaussian density to improve estimate quality. © 2016 ISIF.},
 author = {Straka, Ondrej and Dunek, Jindrich},
 journal = {FUSION 2016 - 19th International Conference on Information Fusion, Proceedings},
 note = {Cited by: 0},
 pages = {1837 - 1844},
 publication_stage = {Final},
 source = {Scopus},
 title = {Characteristic function based performance index for Bayesian filters},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84992150982?origin=resultslist},
 year = {2016}
}
