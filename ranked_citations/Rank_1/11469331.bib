@inproceedings{11469331,
 abstract = {The global transition to electric vehicles is crucial for decarbonizing transport, but it risks straining power grids and increasing emissions if electricity demand is met conventionally. Hybrid Solar-Powered EV Charging Stations (HSPECS) address this by using solar energy, backed by the grid or storage, for clean mobility. Their efficiency relies on two key power electronic components: Maximum Power Point Tracking (MPPT) controllers to optimize solar energy harvest, and DC-DC converters to condition this power for batteries. This review systematically analyses modern MPPT algorithms-from classic methods to advanced AI-based techniques-and their implementation with various DCDC converters. Through detailed comparisons, it finds that a hybrid MPPT approach, merging conventional robustness with AI-driven precision, implemented via a multi-port isolated DC-DC converter, is the most promising path for developing efficient, reliable, and intelligent HSPECS.},
 author = {S, Manikandan and D, Abinaya and E, Sathesh Abraham Leo and Babu, M. Harish and Ravivarman, G. and Thomas, Aby K},
 booktitle = {2026 Second International Conference on Multi-Agent Systems for Collaborative Intelligence (ICMSCI)},
 doi = {10.1109/ICMSCI67830.2026.11469331},
 issn = {},
 keyword = {Low earth orbit satellites;Artificial satellites;Oscillators;Zero voltage switching;Capacitors;Zero current switching;Voltage multipliers;Switching circuits;Diodes;Filtering;Electric Vehicle (EV);Photovoltaic (PV);Hybrid Charging;Maximum Power Point Tracking (MPPT);DC-DC Converters;Grid Integration;Power Electronics},
 month = {March},
 number = {},
 pages = {1325-1332},
 title = {A Comprehensive Review of Hybrid Solar-Powered EV Charging Stations: Advanced MPPT and Converter Technologies},
 volume = {},
 year = {2026}
}
