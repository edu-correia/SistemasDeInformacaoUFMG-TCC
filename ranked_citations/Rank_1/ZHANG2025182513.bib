@article{ZHANG2025182513,
 abstract = {Ceramic-based metamaterials have attracted the attention of researchers because of their rich resonant properties. Here, ceramic materials and metamaterial structure design strategies were combined to verify an absorber with dual-mode resonance characteristics (the P1 and P2 peaks, operating in the frequency band of 0.8–5.0 THz). Absorption peaks shown the dependence of geometric parameters. When the diameter of the ceramic disk was equal to the lattice constant, two absorption peaks were invalidated and a new absorption band was achieved. The absorption performance of this ceramic-based metamaterial can be actively modulated within the temperature range of 200C to 700C. Two absorption peaks were merged into another absorption band, thereby obtaining the convertibility of the absorption window. More importantly, a new absorption peak P3 with high temperature sensitivity was excited. The temperature sensitivity of three absorption peaks was: SP1= 0.0110 THz/0C， SP2= 0.0135 THz/0C， SP3= 0.0600 THz/0C. Finally, the thermal resonance properties of the ceramic-based metamaterial were revealed, including the thermal response current, thermal resistance and thermal conductivity coefficient. These measurement results verified the reliability of ceramic-based metamaterials and provided a basis for expanding the application scope of functional ceramics.},
 author = {Yi Zhang and Mei Wang and Zetian Dai and Wanying Gong},
 doi = {https://doi.org/10.1016/j.jallcom.2025.182513},
 issn = {0925-8388},
 journal = {Journal of Alloys and Compounds},
 keyword = {Building decorative materials, Ceramics, Metamaterials, Metasurfaces, Green building；Thermal conduction},
 pages = {182513},
 title = {Verification of a terahertz ceramic-based metamaterial with dual-mode resonance and measurement of its absorption performance, temperature sensing performance and thermal conductivity},
 url = {https://www.sciencedirect.com/science/article/pii/S0925838825040745},
 volume = {1037},
 year = {2025}
}
