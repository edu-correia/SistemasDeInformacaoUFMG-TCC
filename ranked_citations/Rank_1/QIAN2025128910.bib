@article{QIAN2025128910,
 abstract = {Evaporative crystallization on water surface (ECWS) provides a unique approach to tuning polymer crystallization pathways. Recent studies have shown that poly(l-lactic acid) (PLLA) forms biphasic one-dimensional (1D) and two-dimensional (2D) crystals upon ECWS. In this work, we report on the ECWS behavior of poly(ethylene oxide)-b-(poly(l-lactic acid) (PEO-b-PLLA). Atomic Force Microscopy (AFM) and Transmission Electron Microscopy (TEM) were used to track the structural and morphological evolution of the block copolymer assembly. 1D filaments were exclusively observed, and the formation process was systematically studied. ECWS conditions, such as polymer concentration, evaporation rate, and temperature, were varied to understand the formation mechanism and tune the structure. Rotational flow was introduced to control the 1D filament packing. Quasi-2D liquid crystalline films were obtained.},
 author = {Qian Qian and Shan Mei and Shichen Yu and Carl T. Furner and Christopher Y. Li},
 doi = {https://doi.org/10.1016/j.polymer.2025.128910},
 issn = {0032-3861},
 journal = {Polymer},
 keyword = {Polymer crystallization, Polymer single crystals, Evaporative crystallization},
 pages = {128910},
 title = {Evaporative crystallization of Poly(ethylene oxide)-b-Poly(L-lactic acid) on water surface},
 url = {https://www.sciencedirect.com/science/article/pii/S0032386125008961},
 volume = {336},
 year = {2025}
}
