 issn = {},
 keyword = {Semiconductor device modeling;Monte Carlo methods;Atomic layer deposition;Prediction algorithms;Epitaxial growth;Semiconductor process modeling;Kinetic theory;Transistors;Optimization;Parameter extraction;Multiscale Simulation;KMC;MD;Epitaxy;DRAM},
