@article{FENG2025127369,
 abstract = {In this work, the delta winglet vortex generators are installed within annular tubes to explore the flow mechanism and energy variation mechanism. Numerical simulation and experimental verification are conducted to study the flow behavior and heat transfer characteristics in annular tubes with various delta winglet structures. The influence of four investigated variables (attack angle (α), blockage ratio (BR), configuration, and flow direction) on heat transfer performance of annular tubes with winglets is explored within the Reynolds number range of 2304–7488. Results indicate that vortices in annular tubes with V-shaped winglet pairs do not merge into a large vortex, primarily because the annular geometry limits the further expansion of vortex pairs, compared to circular tubes. Furthermore, arrangement variables are more effective than structure variables in sustaining stable vortex interactions and flow structures along annular tubes. The disturbance stability induced by increasing α is consistent in both transverse and axial spatial dimensions. The Nusselt number (Nu) and the friction factor (f) increase by 1.27–2.15 and 1.79–2.46 times, respectively, compared to plain annular tubes. The thermal enhancement factor reaches its maximum value of 1.72 under α = 30°, BR = 0.20 with V-shaped upstream configuration. These results offer valuable guidance for efficient applications of winglets in annular tubes.},
 author = {Jia Jie Feng and Khai Ching Ng and Yousif Abdalla Abakr and Andy Chan and Baiman Chen},
 doi = {https://doi.org/10.1016/j.applthermaleng.2025.127369},
 issn = {1359-4311},
 journal = {Applied Thermal Engineering},
 keyword = {Heat transfer, Fluid flow, Delta winglet, Annular tube, Longitudinal vortex flow, Vortex interaction},
 pages = {127369},
 title = {Experimental and numerical investigation on heat transfer and fluid flow in annular tubes with delta winglets},
 url = {https://www.sciencedirect.com/science/article/pii/S1359431125019611},
 volume = {278},
 year = {2025}
}
