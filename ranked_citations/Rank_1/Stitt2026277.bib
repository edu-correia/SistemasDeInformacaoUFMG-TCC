@conference{Stitt2026277,
 abstract = {While high-throughput sorting is an extensively studied problem, low-latency sorting-despite its potential benefits for many streaming applications-remains largely underexplored by comparison. In many streaming use cases, optimizing for low latency is becoming increasingly relevant as the throughput of graphics-processing units (GPUs) and field-programmable gate arrays (FPGAs) far exceeds inherent I/O bandwidth limitations (e.g., 10 Gbps Ethernet), where further throughput improvements yield no additional benefit. In this paper, we introduce EdgeSort, a sorting architecture designed for low-latency, streaming use cases on edge FPGAs (e.g., SmartNICs). We demonstrate that EdgeSort can nearly support 100 Gbps Ethernet while introducing less than 100 ns of latency for sorting 128k-element arrays, with scalability up to one million elements on a mid-sized AMD Versal FPGA. Notably, because EdgeSort’s output rate can exceed input bandwidth, it guarantees stall-free, line-rate execution-making it, to our knowledge, the first low-latency sorter capable of this for arrays larger than several thousand elements. While EdgeSort does not match the peak throughput of existing methods, it reduces latency by two orders of magnitude compared to PCIe accelerators, even assuming infinitely fast PCIe-accelerator computation, while still delivering stall-free sorting within realistic bandwidth constraints. © 2026 Copyright held by the owner/author(s).},
 author = {Stitt, Greg and Piard, Wesley and Crary, Christopher},
 doi = {10.1145/3748173.3779193},
 journal = {Proceedings of the 2026 ACM/SIGDA International Symposium on Field Programmable Gate Arrays, FPGA 2026},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {277 - 287},
 publication_stage = {Final},
 source = {Scopus},
 title = {EdgeSort: A Sub-100 ns, Line-Rate FPGA Streaming Sorter},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105032969102?origin=resultslist},
 year = {2026}
