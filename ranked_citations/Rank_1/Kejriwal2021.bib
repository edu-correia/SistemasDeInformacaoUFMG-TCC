@article{Kejriwal2021,
 abstract = {Entity Resolution (ER) is the problem of identifying co-referent entity pairs across datasets, including knowledge graphs (KGs). ER is an important prerequisite in many applied KG search and analytics pipelines, with a typical workflow comprising two steps. In the first ‘blocking’ step, entities are mapped to blocks. Blocking is necessary for preempting comparing all possible pairs of entities, as (in the second ‘similarity’ step) only entities within blocks are paired and compared, allowing for significant computational savings with a minimal loss of performance. Unfortunately, learning a blocking scheme in an unsupervised fashion is a non-trivial problem, and it has not been properly explored for heterogeneous, semi-structured datasets, such as are prevalent in industrial andWeb applications. This article presents an unsupervised algorithmic pipeline for learning Disjunctive Normal Form (DNF) blocking schemes on KGs, as well as structurally heterogeneous tables that may not share a common schema. We evaluate the approach on six real-world dataset pairs, and show that it is competitive with supervised and semi-supervised baselines. © 2021 by the authors.},
 author = {Kejriwal, Mayank},
 doi = {10.3390/info12030134},
 journal = {Information (Switzerland)},
 note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access},
 number = {3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unsupervised DNF blocking for efficient linking of knowledge graphs and tables},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85103192693?origin=resultslist},
 volume = {12},
 year = {2021}
}
