@conference{Subercaze2016468,
 abstract = {The advent of semantic data on the Web requires effcient reasoning systems to infer RDF and OWL data. The linked nature and the huge volume of data entail effciency and scalability challenges when designing productive inference systems. This paper presents Inferray, an implementation of RDFS, pdf, and RDFS-Plus inference with improved performance over existing solutions. The main features of Inferray are 1) a storage layout based on vertical partitioning that guarantees sequential access and effcient sort-merge join inference; 2) effcient sorting of pairs of 64-bit integers using ad-hoc optimizations on MSD radix and a custom counting sort; 3) a dedicated temporary storage to perform effcient graph closure computation. Our measurements on synthetic and real-world datasets show improvements over competitors on RDFS-Plus, and up to several orders of magnitude for transitivity closure.  © 2016 VLDB Endowment 21508097/16/02.},
 author = {Subercaze, Julien and Gravier, Christophe and Chevalier, Jules and Laforest, Frederique},
 doi = {10.14778/2904121.2904123},
 journal = {Proceedings of the VLDB Endowment},
 note = {Cited by: 31},
 number = {6},
 pages = {468 - 479},
 publication_stage = {Final},
 source = {Scopus},
 title = {Inferray: Fast inmemory RDF inference},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84976536831?origin=resultslist},
 volume = {9},
 year = {2016}
}
