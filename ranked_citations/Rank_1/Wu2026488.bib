@article{Wu2026488,
 abstract = {Deep learning-based methods with hybrid architectures have achieved remarkable progress in remote sensing image super-resolution (SR). However, the absence of HR references makes LR-HR mapping priors ineffective for guiding reconstruction during inference. At the same time, CNNs and Transformers each have inherent limitations with long-range dependencies and local details, bringing difficulty in cross-scene SR adaptation. To address these issues, we propose the Conditional Diffusion-Assisted Enhanced Hybrid Attention Transformer (CDEHAT) for remote sensing images super-resolution, which combines diffusion prior learning and a hybrid attention mechanism. Specifically, CDEHAT adopts a two-branch collaborative architecture CDEHAT-Diff and CDEHAT-SR. CDEHAT-Diff explores the conditional degradation-to-restoration process between LR and HR images, learning latent LR-HR mapping patterns through diffusion modeling, which then guides the subsequent reconstruction stage. The diffusion-derived priors empower CDEHAT-SR to discover intrinsic super-resolution manifolds, facilitating precise recovery of fine-grained structural and textural details from degraded observations. At the same time, two enhanced hybrid attention transformer modules are designed to integrate multi-scale features in the spectral–spatial domain for better high-frequency information reconstruction. Experimental results on both simulated and real datasets show that our method significantly improves the performance of SR tasks, with an average PSNR improvement of 0.20 dB and 0.51 dB, and performs well in reconstructing details and recovering structures. The code and dataset will be available at https://github.com/cerulean136/CDEHAT. © 2026 Published by Elsevier B.V. on behalf of International Society for Photogrammetry and Remote Sensing, Inc. (ISPRS).},
 author = {Wu, Xiande and Liu, Rui and Wu, Wei and Yang, Haiping and Yang, Liao},
 doi = {10.1016/j.isprsjprs.2026.03.002},
 journal = {ISPRS Journal of Photogrammetry and Remote Sensing},
 note = {Cited by: 0},
 pages = {488 - 510},
 publication_stage = {Final},
 source = {Scopus},
 title = {CDEHAT: Conditional Diffusion-Assisted Enhanced Hybrid Attention Transformer for remote sensing imagery super-resolution},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105034613517?origin=resultslist},
 volume = {235},
