@inproceedings{6394919,
 abstract = {Aiming at the problem of failing to support effective structural join on compressed data of existing XML Data compressors, this paper proposes a new Compressor Structural Join Oriented XML Data Compressor which makes structural join possible by giving all elements and attribute names in document a unique region encoding. This paper also provides a definition of the Same Sub Tree(SST) and an algorithm of merging the SSTs. An experimental evaluation on the typical XML datasets shows the efficiency of SJXC.},
 author = {Wei, Dongping and Wei, Xiangli},
 booktitle = {2012 Third World Congress on Software Engineering},
 doi = {10.1109/WCSE.2012.14},
 issn = {},
 keyword = {XML;Encoding;Dictionaries;Containers;Compressors;Data compression;Algorithm design and analysis;XML;compression;structural join;the Same SubTree},
 month = {Nov},
 number = {},
 pages = {29-33},
 title = {Structural Join Oriented XML Data Compression},
 volume = {},
 year = {2012}
}
