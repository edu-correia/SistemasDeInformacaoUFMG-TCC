@conference{Khodabandeh20162392,
 abstract = {We present an algorithm for learning a feature representation for video segmentation. Standard video segmentation algorithms utilize similarity measurements in order to group related pixels. The contribution of our paper is an unsupervised method for learning the feature representation used for this similarity. The feature representation is defined over video supervoxels. An embedding framework learns a feature mapping for supervoxels in an unsupervised fashion such that supervoxels with similar context have similar embeddings. Based on the learned representation, we can merge similar supervoxels into spatio-temporal segments. Experimental results demonstrate the effectiveness of this learned supervoxel embedding on standard benchmark data. © 2016 IEEE.},
 author = {Khodabandeh, Mehran and Muralidharan, Srikanth and Vahdat, Arash and Mehrasa, Nazanin and Pereira, Eduardo M. and Satoh, Shin'Ichi and Mori, Greg},
 doi = {10.1109/ICPR.2016.7899994},
 journal = {Proceedings - International Conference on Pattern Recognition},
 note = {Cited by: 1},
 pages = {2392 - 2397},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unsupervised learning of supervoxel embeddings for video Segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85019066482?origin=resultslist},
 volume = {0},
 year = {2016}
}
