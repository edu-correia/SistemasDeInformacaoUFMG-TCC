@incollection{ANAKJAMES2026101,
 abstract = {The intensifying environmental crises and the depletion of fossil fuel reserves have accelerated the global pursuit of sustainable materials solutions by positioning biocomposites as a promising frontier. However, the pursuit of superior mechanical, thermal, and electrical properties in biocomposites while maintaining sustainability remains a significant challenge. As such, this chapter investigates key functional fillers that redefine biocomposite performance by improving advanced material functionality with environmental sustainability. It underscores the transformative potential of strategically incorporating diverse fillers, such as carbon black (CB), carbon nanotubes (CNTs), graphene, natural fibers, and montmorillonite (MMT) clay. Subsequently, the deliberate integration of CB from recycled sources promotes a circular economy by extending product lifespans while reducing environmental footprints. CNTs, with unparalleled tensile strength and conductivity, could unlock revolutionary applications across aerospace, automotive, and energy storage sectors. Additionally, graphene's exceptional mechanical, thermal, and electrical properties herald a new frontier in biosensors, medical implants, and next generation electronics. Surface modified natural fibers, particularly flax, hemp, and kenaf, also present ecofriendly reinforcement options by coupling superior mechanical robustness with reduced component weight. Moreover, MMT clay, which is renowned for enhancing barrier properties, moisture resistance, and biocompatibility, finds essential roles in sectors demanding peak performance such as food packaging and biomedical devices. Overall, this chapter envisions a future of pioneering innovation and unwavering sustainability merging into a powerful synergy by propelling the development of advanced biocomposites that surpass both industrial and ecological expectations.},
 author = {Anthonette {Anak James} and Md. Rezaur Rahman and Ain Zaienah Sueraya and Muhammad Khusairy {Bin Bakri}},
 booktitle = {Smart Biocomposite Materials},
 doi = {https://doi.org/10.1016/B978-0-443-33643-0.00002-8},
 editor = {Md. Rezaur Rahman and Muhammad Khusairy Bin Bakri},
 isbn = {978-0-443-33643-0},
 keyword = {Biocomposites, functional fillers, environmental sustainability, material innovation, montmorillonite clay, natural fiber, graphene, carbon nanotube, carbon black},
 pages = {101-147},
 publisher = {Woodhead Publishing},
 series = {Woodhead Publishing Series in Composites Science and Engineering},
 title = {5 - Exploration of functional fillers in biocomposites},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443336430000028},
 year = {2026}
}
