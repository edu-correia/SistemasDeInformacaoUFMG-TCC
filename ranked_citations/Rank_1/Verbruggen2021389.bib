@article{Verbruggen2021389,
 abstract = {We present muppets, a framework for partitioning cells in a table in segments that fulfil the same semantic role or belong to the same semantic data type, similar to how image segmentation is used to group pixels that represent the same semantic object in computer vision. Flexible constraints can be imposed on these segmentations for different use cases. muppets uses a hierarchical merge tree algorithm, which allows for efficiently finding segmentations that satisfy given constraints and only requires similarities between neighbouring cells to be computed. Three applications are used to illustrate and evaluate muppets: identifying tables and headers, type detection and discovering semantic errors. © 2021, Springer Nature Switzerland AG.},
 author = {Verbruggen, Gust and Contreras-Ochando, Lidia and Ferri, Cèsar and Hernández-Orallo, José and Raedt, Luc De},
 doi = {10.1007/978-3-030-74251-5_31},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {389 - 401},
 publication_stage = {Final},
 source = {Scopus},
 title = {Muppets: Multipurpose Table Segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85105866829?origin=resultslist},
 volume = {12695 LNCS},
 year = {2021}
}
