@inproceedings{10266100,
 abstract = {This article elaborates on the quadruple-band Toyota logo-shaped wideband antenna with a limited Ground Plane that is suited for a range of wireless applications. The antenna is made of a readily accessible and inexpensive FR4 (Flame Retardant) substrate. The complete dimension of this antenna is 45 × 34 × 1.6 mm3. The antenna patch portion resembles the logo of Toyota. The recommended antenna design has started with two outer circular rings initially. Subsequently, the inner two rings are formed and merged with outer circular rings. Oval-shaped two rings are formed and merged with the outer ring structure. This design aims to provide wide-band operation between 2 GHz and 6.4 GHz. The resonating frequencies are 2.4 GHz, 3.88 GHz, 5.7 GHz, and 9.66 GHz. “Advanced Design Software” (ADS) is used to perform the antenna design and various important parameters like gain, directivity, and return loss are explored.},
 author = {Sumathi, K and Nageswari, D and Santhi, S. and R, Revathi},
 booktitle = {2023 3rd International Conference on Pervasive Computing and Social Networking (ICPCSN)},
 doi = {10.1109/ICPCSN58827.2023.00211},
 issn = {},
 keyword = {Wireless communication;Structural rings;Social networking (online);Resonant frequency;Zigbee;Software;Broadband antennas;Limited Ground Plane;notching;antenna;quadruple band;FR4},
 month = {June},
 number = {},
 pages = {1253-1260},
 title = {Design of Quadruple Band Toyota Logo Shaped Monopole Micro-Strip Antenna},
 volume = {},
 year = {2023}
}
