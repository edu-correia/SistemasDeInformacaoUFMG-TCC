@article{CárdenasAguilera2024_84,
 abstract = {Abstract  Introduction: X-linked hypophosphatemic rickets is a hereditary condition causing disruptions in bone mineral homeostasis. The morbidity associated with this condition has exhibited variability in previous decades, possibly stemming from variations in case definitions and diagnostic confirmation procedures.  Objective: Our aim was to generate evidence-informed recommendations for the diagnosis, treatment, and follow-up of patients with suspected or diagnosed XLH.  Methodology: Integration of a literature review with a modified Delphi method, guided by expert consensus.  Results: Following the screening and selection of 1041 documents, 41 were chosen to address the queries posed by the developer group. Experts, consulted through a modified Delphi consensus, endorsed 97 recommendations on the diagnosis, treatment, and follow-up of patients with suspected or diagnosed XLH. Notably, the quality of the evidence was deemed to be low.  Conclusions: The recommendations proposed here will allow early and timely diagnosis of X-linked hypophosphatemic rickets, while optimizing resources for its treatment and follow-up. In addition, it will help clarify the burden of the disease and improve health outcomes for this population.},
 author = {Cárdenas-Aguilera, Juan Guillermo and Medina-Orjuela, Adriana and Meza-Martínez, Adriana Isabel and Prieto, Juan Carlos and Zarante-Bahamón, Ana María and Cáceres-Mosquera, Jimena Adriana and Mejía-Gaviria, Natalia and Serrano-Gayubo, Ana Katherina and Baquero-Rodríguez, Richard and Chacón-Acevedo, Kelly and Guerrero-Tinoco, Gustavo Adolfo and Uribe-Ríos, Alejandro and García-Rueda, María Fernanda and Abad-Londoño, Verónica and Nossa-Almanza, Sergio Alejandro and Aroca-Martínez, Gustavo and Román-González, Alejandro and Endo-Cáceres, Jorge Alberto and Llano-Linares, Juan Pablo and Florenzano, Pablo and Díaz-Curiel, Manuel and Vaisbich, María Helena and Zanchetta, María Belén and Guerra-Hernández, Norma Elizabeth and Stefano, Eduardo Enrique and Brunetto, Oscar},
 doi = {10.22265/acnef.11.1.754},
 number = {1},
 pages = {e754--e754},
 title = {Expert consensus on evidence-based recommendations for the diagnosis, treatment, and follow-up of X-linked hypophosphatemic rickets (XLH)},
 volume = {11},
 year = {2024}
}
