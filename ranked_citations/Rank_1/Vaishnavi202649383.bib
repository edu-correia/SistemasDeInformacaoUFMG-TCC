@article{Vaishnavi202649383,
 abstract = {Understanding music in many contexts and in addition to genre depends on systems that can adjust to cultural, user-specific, and multi-modal information. Context-Aware Multi-Modal Music Understanding via Adaptive Self-Attention and Cross-Domain Learning aims to improve music tagging and recommendation across many listening environments. Although contemporary music classification systems show good performance on carefully chosen datasets, they often cannot extend to other fields and neglect variations in culture, context, and personal listening behaviour. Here, a framework CD-MMAN (Context-Driven Multi-Modal Attention Network), an adaptable architecture using multi-stream attention techniques to unite audio signals with user context (such as cultural origin, listening history, and optional lyrical content) in response to these inadequacies. Using a Multi-modal Attention Fusion Layer to merge spectral-temporal audio data with contextual embeddings, CD-MMAN enhances genre and tag prediction. It guarantees that semantic alignment stays preserved across domains by use of a consistency-aware loss function with contextual regularization. The proposed approach is applied for real-time music identification and customized recommendation to produce Music Information Retrieval (MIR) systems that are broadly applicable, context-sensitive, and culturally flexible. CD-MMAN significantly beats previous models on recommendation tasks using enhanced datasets that include user and contextual information. This is true in terms of classification accuracy (4.2-7.5%), cross-cultural consistency (a substantial margin), and user satisfaction (a substantial margin). Based on the results, there is a lot of room for improvement in global streaming platforms and cross-cultural music information retrieval systems. © 2013 IEEE.},
 author = {Vaishnavi, J. and Vinila Jinny, S.},
