@inproceedings{11390376,
 abstract = {Emotion-driven speech synthesis and recognition are crucial for natural human-computer interaction. The former ensures not just semantic clarity but also expressive emotion, while the latter extracts emotional cues to identify speaker states. This paper addresses challenges in controllable synthesis and automatic evaluation, exploring how emotion confusion, data imbalance, and semantic consistency affect performance. To improve both generation and recognition, we propose combining high-consistency sample selection with emotion-aware perception. The work provides a theoretical basis for more authentic, expressive emotional speech systems with broad research and application value.},
 author = {Ji, Youming and Zhao, Zeyu and Jin, Huiqin and Wu, Hong},
 booktitle = {2025 9th IEEE International Conference on Network Intelligence and Digital Content (IC-NIDC)},
 doi = {10.1109/IC-NIDC67200.2025.11390376},
 issn = {2575-4955},
 keyword = {Human computer interaction;Emotion recognition;Filtering;Semantics;Merging;Speech recognition;Data models;Speech synthesis;Reliability;Long short term memory;Emotional speech synthesis;Emotional speech recognition;Emotion-Aware Modeling},
 month = {Nov},
 number = {},
 pages = {183-187},
 title = {Emotion-Controllable Neural Speech Synthesis with Quality-Oriented Evaluation},
 volume = {},
 year = {2025}
}
