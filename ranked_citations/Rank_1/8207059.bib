@article{8207059,
 abstract = {We investigate a non-equilibrium ionization state and a two-temperature structure of the intracluster medium in the linked region of Abell 399 and Abell 401, using a series of $N$-body + Smoothed Particle Hydrodynamics (SPH) simulations, and find that there exist significant shock layers at the edge of the linked region and that the ionization state of iron departs from the ionization equilibrium state at the shock layers and around the center of the linked region. As for the two-temperature structure, an obvious difference in temperature between electrons and ions is found in the edge of the linked region. The K$\alpha$ line emissions of Fe XXIV and Fe XXV are not severely affected by the deviation from the ionization equilibrium state around the center of the linked region, suggesting that the detection of relatively high metallicity in this area cannot be ascribed to a non-equilibrium ionization state of the intracluster medium. On the other hand, the K$\alpha$ emissions significantly deviate from the equilibrium values at the shock layers, and the intensity ratio of the K$\alpha$ lines between Fe XXIV–XXV and Fe XXVI is found to be significantly different from that in the ionization equilibrium state.},
 author = {Akahori, Takuya and Yoshikawa, Kohji},
 doi = {10.1093/pasj/60.4.L19},
 issn = {2053-051X},
 journal = {Publications of the Astronomical Society of Japan},
 keyword = {intergalactic medium;X-rays: galaxies;X-rays: galaxies: clusters;X-rays: individual (Abell 399, Abell 401)},
 month = {Aug},
 number = {4},
 pages = {L19-L22},
 title = {Non-Equilibrium Ionization State and Two-Temperature Structure in the Linked Region of Abell 399 and Abell 401},
 volume = {60},
 year = {2008}
}
