@article{Weishaupt20193357,
 abstract = {Medulloblastoma (MB) is a brain cancer predominantly arising in children. Roughly 70% of patients are cured today, but survivors often suffer from severe sequelae. MB has been extensively studied by molecular profiling, but often in small and scattered cohorts. To improve cure rates and reduce treatment side effects, accurate integration of such data to increase analytical power will be important, if not essential. Results: We have integrated 23 transcription datasets, spanning 1350 MB and 291 normal brain samples. To remove batch effects, we combined the Removal of Unwanted Variation (RUV) method with a novel pipeline for determining empirical negative control genes and a panel of metrics to evaluate normalization performance. The documented approach enabled the removal of a majority of batch effects, producing a large-scale, integrative dataset of MB and cerebellar expression data. The proposed strategy will be broadly applicable for accurate integration of data and incorporation of normal reference samples for studies of various diseases. We hope that the integrated dataset will improve current research in the field of MB by allowing more large-scale gene expression analyses. Availability and implementation: The RUV-normalized expression data is available through the Gene Expression Omnibus (GEO; https://www.ncbi.nlm.nih.gov/geo/) and can be accessed via the GSE series number GSE124814. Supplementary information: Supplementary data are available at Bioinformatics online. © 2019 The Author(s) 2019. Published by Oxford University Press.},
 author = {Weishaupt, Holger and Johansson, Patrik and Sundström, Anders and Lubovac-Pilav, Zelmina and Olsson, Björn and Nelander, Sven and Swartling, Fredrik J},
 doi = {10.1093/bioinformatics/btz066},
 journal = {Bioinformatics},
 note = {Cited by: 47; All Open Access; Green Open Access; Hybrid Gold Open Access},
 number = {18},
 pages = {3357 - 3364},
 publication_stage = {Final},
 source = {Scopus},
 title = {Batch-normalization of cerebellar and medulloblastoma gene expression datasets utilizing empirically defined negative control genes},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85072349088?origin=resultslist},
 volume = {35},
 year = {2019}
}
