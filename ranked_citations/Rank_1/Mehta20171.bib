@conference{Mehta20171,
 abstract = {In the recent years multimodal medical image fusion has evolved out as an active area of research, and it is finding a lot of applications in several imaging areas. The main aim is to collect the required relevant information from the source input images into a single output image. Among all the prevailing techniques, guided filter has emerged out as best edge preserving technique. In this paper, a framework using guided filter by modifying saliency and weight maps have been used. The simulated results shows the efficiency of the proposed technique for capturing the details of multimodal images by smoothening the noise and preserving the edges. © 2017 IEEE.},
 author = {Mehta, Nancy and Budhiraja, Sumit and Goel, Shweta},
 doi = {10.1109/TEL-NET.2017.8343519},
 journal = {2nd International Conference on Telecommunication and Networks, TEL-NET 2017},
 note = {Cited by: 3},
 pages = {1 - 6},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multimodal medical image fusion using modified weight maps and guided filter},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85049059343?origin=resultslist},
 volume = {2018-January},
 year = {2017}
}
