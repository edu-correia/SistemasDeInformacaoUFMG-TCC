@article{Im2011808,
 abstract = {With the advent of multicore processors, it has become imperative to write parallel programs if one wishes to exploit the next generation of processors. This paper deals with skyline computation as a case study of parallelizing database operations on multicore architectures. First we parallelize three sequential skyline algorithms, BBS, SFS, and SSkyline, to see if the design principles of sequential skyline computation also extend to parallel skyline computation. Then we develop a new parallel skyline algorithm PSkyline based on the divide-and-conquer strategy. Experimental results show that all the algorithms successfully utilize multiple cores to achieve a reasonable speedup. In particular, PSkyline achieves a speedup approximately proportional to the number of cores when it needs a parallel computation the most. © 2010 Elsevier B.V. All rights reserved.},
 author = {Im, Hyeonseung and Park, Jonghyun and Park, Sungwoo},
 doi = {10.1016/j.is.2010.10.005},
 journal = {Information Systems},
 note = {Cited by: 25},
 number = {4},
 pages = {808 - 823},
 publication_stage = {Final},
 source = {Scopus},
 title = {Parallel skyline computation on multicore architectures},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/79952630286?origin=resultslist},
 volume = {36},
 year = {2011}
}
