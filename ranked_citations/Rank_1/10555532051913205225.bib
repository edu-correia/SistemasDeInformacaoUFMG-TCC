 address = {Evansville, IN, USA},
 author = {Riabov, Vladimir V.},
 issn = {1937-4771},
 issue_date = {June 2018},
 journal = {J. Comput. Sci. Coll.},
 month = {June},
 number = {6},
 numpages = {3},
 pages = {189–191},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Computing applications enriched by scientific phenomena},
 volume = {33},
 year = {2018}
}
