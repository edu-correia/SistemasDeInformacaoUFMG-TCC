@conference{Gauraha2026,
 abstract = {Sentiment analysis is one of the important tasks in natural language processing which finds its applications in business, healthcare and social media system by extracting opinions and feelings from textual data. Although the field of English sentiment analysis has grown, applying these techniques in multilingual settings is a challenging task since little data is available and languages and cultural contexts vary. Motivated by the scarce resources for non-English sentiment analysis, this paper takes translation-based approaches. All systems were evaluated on four benchmark datasets, Arabic (SemEval 2017), Chinese (Amazon Reviews Multi), French (DEFT 2017) and Italian (SENTIPOLC 2016), representing different domains. The combined method uses neural machine translation (Google NMT and LibreTranslate) and an ensemble of RoBERTa, mBERT, and GPT models. The novelty is to merge the translation pipelines with heterogeneous deep models using the ensemble learning, which results in language agnostic robustness. The performance is evaluated by Accuracy, Precision, Recall, F1-score and Specificity. Results show that the ensemble of these neural systems significantly surpasses its individual components, with Google NMT + Ensemble being the best balanced and overall top performing system on all corpus.  © 2026 IEEE.},
 author = {Gauraha, Ritu and Agrawal, Ayush Kumar and Dubey, Parul},
 doi = {10.1109/ICEI65890.2026.11447631},
 journal = {International Conference on Emerging Trends and Innovations in ICT, ICEI 2026},
