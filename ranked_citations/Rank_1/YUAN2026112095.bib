@article{YUAN2026112095,
 abstract = {This study focuses on the internal flow mechanisms and control strategies of a high-speed low-pressure turbine (LPT) in a geared turbofan engine (GTF) under the coupled aerodynamic conditions of high Mach number (Ma) and low Reynolds number (Re). Taking a high-speed low-pressure turbine cascade as the research subject, the influence of different purge flow rate ratios on the evolution of endwall secondary flows and loss characteristics under wake sweeping was systematically investigated through numerical simulations. Based on this, flow control using a profiled endwall was further studied. The results indicate that the interaction between the purge outflow and the mainstream forms a complex vortex system within the disk cavity. As the purge flow rate increases, the interaction between the purge flow and the endwall boundary layer intensifies, leading to an increase in cavity loss. After entering the cascade passage, the purge flow merges with the pressure-side branch of the horseshoe vortex, significantly strengthening the passage vortex and counter vortex structures and aggravating endwall secondary flow losses. The profiled endwall alters the static pressure distribution in the endwall region through geometric reshaping, enhancing the suction-side branch of the horseshoe vortex and suppressing the transverse migration of the pressure-side branch, thereby effectively weakening the strength of the passage vortex and counter vortex. Under the condition without wake and without purge flow, the cascade outlet energy loss was reduced by 5.54%. However, periodic disturbances from upstream wakes suppress the intensity of secondary flows, reducing the benefit of the profiled endwall to 3.72%. Under moderate purge flow rates, the flow control effect of the profiled endwall remains largely effective. At high purge flow rates, intensified endwall flow further diminishes the control effectiveness of the profiled endwall.},
 author = {Hang Yuan and Mai Li and Xiaodan Zhang and Ruoyu Chen and Xingen Lu and Yanfeng Zhang},
 doi = {https://doi.org/10.1016/j.ast.2026.112095},
 issn = {1270-9638},
 journal = {Aerospace Science and Technology},
 keyword = {Low-pressure turbine, Upstream wake, Purge flow, Endwall loss, Profiled endwall},
 pages = {112095},
 title = {Influence mechanism of profiled endwall on a high-speed low-pressure turbine cascade under effect of upstream wake and purge flow},
 url = {https://www.sciencedirect.com/science/article/pii/S127096382600475X},
 volume = {176},
 year = {2026}
}
