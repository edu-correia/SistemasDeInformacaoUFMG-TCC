@inproceedings{5521954,
 abstract = {Distributed coding methods have attracted a lot of interest in video compression community, and several channel coding techniques have been introduced in the distributed video coding (DVC) systems. In this paper, a new splitting and merging based rate-adaptive low-density parity-check (SM_RALDPC) for DVC scenario is proposed, three restrictions for merging check nodes are presented to obtain good performance codes. According to experimental results, the proposed SM_RALDPC for DVC in DCT domain can achieve RD performance gain 0.1~0.4dB, comparing to DVC based on Turbo.},
 author = {Yang, Chun-Ling and Xia, Hong-Tao and Cao, Duan-Wu},
 booktitle = {IET International Communication Conference on Wireless Mobile and Computing (CCWMC 2009)},
 doi = {},
 issn = {},
 keyword = {Distributed Video Coding (DVC);low-density parity-check (LDPC) codes;Progressive Edge-Growth (PEG) algorithm;syndrome},
 month = {Dec},
 number = {},
 pages = {551-554},
 title = {Splitting and merging based rate adaptive LDPC for distributed video coding},
 volume = {},
 year = {2009}
}
