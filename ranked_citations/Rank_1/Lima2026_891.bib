@article{Lima2026_891,
 abstract = {Abstract In the paper [RBEF 42, e20200182 (2020)], I showed that the electric field on the surface of a charged conducting sphere of radius   R in electrostatic equilibrium evaluates to half the field discontinuity across its surface, i.e.     E  surf =    1 2  k  Q /  R 2 =    1 2  σ /  ϵ 0, where   σ is the charge density on the surface. However, this exact result, found by converting an improper integral into a proper one, was criticized by Assad in a recent paper [RBEF 43, e20200467 (2021)], where he argues that this conversion would be invalid because the electric field should be undefined for points at the surface. In this work, I develop a more careful treatment of integrals and limits, which confirms our previous result within the rigour of mathematical analysis, contrarily to Assad’s arguments.},
 author = {Lima, F.M.S.},
 doi = {10.1590/1806-9126-rbef-2025-0490},
 pages = {e20250490--e20250490},
 title = {A rigorous derivation of the electric field on the surface of a conducting sphere},
 volume = {48},
 year = {2026}
}
