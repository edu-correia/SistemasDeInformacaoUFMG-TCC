@conference{Patgiri2020889,
 abstract = {Key-value data structure is well-known data structure which is used, ranging from the small applications to the extremely large systems. A plenty of key-value data structures are available. Moreover, implementation of bidirectional keyvalues are also available. The key-value data structure is easy to implement. These data structures are one-To-one bidirectional mapping key-value data structure. However, key-value data structure requires one-To-one, one-To-many and many-To-one bidirectional mapping. Also, there are many issues associated with the key-value data structure, namely, the synchronization issue, locking problem, privacy, and security. To address these issues, we propose XOR-ed key-value data structure (xKV) in this paper. xKV is a general purpose data structure which provides one-To-one, one-To-many and many-To-one bidirectional mapping. The asymptotic behavior of our proposed system is nearly constant. We also extend xKV, and propose secured and XOR-ed key-value data structure (sxKV) which provides high security and privacy with the same time complexity as the xKV. sxKV uses computationally inexpensive cryptography. We prove that sxKV can defend many attacks. Moreover, sxKV does not have any synchronization issue. It ensures strict privacy of users. © 2020 IEEE.},
 author = {Patgiri, Ripon},
 doi = {10.1109/HPCC-SmartCity-DSS50907.2020.00118},
 journal = {Proceedings - 2020 IEEE 22nd International Conference on High Performance Computing and Communications, IEEE 18th International Conference on Smart City and IEEE 6th International Conference on Data Science and Systems, HPCC-SmartCity-DSS 2020},
 note = {Cited by: 0},
 pages = {889 - 896},
 publication_stage = {Final},
 source = {Scopus},
 title = {SxKV: A Novel Secured and Bidirectional Key-Value Data Structure},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85105350369?origin=resultslist},
 year = {2020}
}
