@article{WANG2026122492,
 abstract = {Schisandra chinensis, a traditional Chinese medicinal crop of significant economic value, presents unique challenges for automated harvesting, such as small, dense clusters, severe leaf occlusion, and limited deployment resources. To address these, this study proposes a specialized detection model, the Multi-Scale Feature Recombination and Local Enhancement Network (MS-FRLE). To mitigate the lack of informative features under occlusion, the Local Enhancement Convolution Block (LECB) integrates lateral dimension-reduction interactions and vertical feature strengthening, enabling the extraction of high-quality local features while minimizing computational demands. For improved detail and texture representation of densely packed small targets, the Multi-Scale Feature Recombination Fusion Module (MS-FRFM) merges high-dimensional and fine-grained features, enhancing both accuracy and robustness. A slim neck structure, combined with Squeeze-and-Excitation (SE) attention, further optimizes the model by reducing both parameters and computation. Experimental results demonstrate a reduction in parameters and FLOPs by 32.69% and 34.25%, respectively. On our S. chinensis dataset, MS-FRLE achieves 90.7% precision, 87.0% mAP, and 85.8% recall, surpassing the baseline by 4.8%, 2.5%, and 4.3%, respectively. On a public dataset, it yields improvements of 5.8%, 4.5%, and 8% (precision/mAP/recall), confirming its strong generalization capability. Deployed on a Jetson Orin NX harvesting platform, the model maintains 30 FPS in field trials. Thus, MS-FRLE enables precise and efficient recognition in resource-constrained environments, making it well-suited for edge-device deployment in complex field settings.},
 author = {Tiejun Wang and Youze Ma and Haitao Liu and Rui Zhou and Hongbo Li and Hongguang Cui},
 doi = {https://doi.org/10.1016/j.indcrop.2025.122492},
 issn = {0926-6690},
 journal = {Industrial Crops and Products},
 keyword = {, Deep learning, Object detection, Edge deployment, Lightweight network},
 pages = {122492},
 title = {MS-FRLE: A lightweight Schisandra chinensis cluster detection model with Multi-scale Feature Recombination Fusion and Local Enhancement, and on-device validation},
 url = {https://www.sciencedirect.com/science/article/pii/S0926669025020394},
 volume = {239},
 year = {2026}
}
