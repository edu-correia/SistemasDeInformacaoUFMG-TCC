@article{Scholta201963,
 abstract = {Business process management often uses reference models to improve processes or as starting point when creating individual process models. The current academic literature offers primarily deductive methods with which to develop these reference models, although some methods develop reference models inductively from a set of individual process models, focusing on deriving and representing common practices. However, there is no inductive method with which to detect best practices and represent them in a reference model. This paper addresses this research gap by proposing a method by which to develop reference process models that represent best practices in public administrations semi-automatically and inductively. The method uses a merged model that retains the structure of the source models while detecting their common parts. It identifies best practices using query constructs and ranking criteria to group the source models’ elements and to evaluate these groups. We provide a conceptualization of the method and demonstrate its functionality using an artificial example. We describe our implementation of the method in a software prototype and report on its evaluation in a workshop with domain and method experts who applied the method to real-world process models. © 2019},
 author = {Scholta, Hendrik and Niemann, Marco and Delfmann, Patrick and Räckers, Michael and Becker, Jörg},
 doi = {10.1016/j.is.2019.03.001},
 journal = {Information Systems},
 note = {Cited by: 17},
 pages = {63 - 87},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semi-automatic inductive construction of reference process models that represent best practices in public administrations: A method},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85065517793?origin=resultslist},
 volume = {84},
 year = {2019}
}
