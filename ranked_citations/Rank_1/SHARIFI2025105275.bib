@article{SHARIFI2025105275,
 abstract = {The two-dimensional deaeration mechanism, quality factors and process are explored using weakly compressible smoothed particle hydrodynamics (WCSPH). The SPHysics2D code, a single-phase code for free surface flows, is modified to handle two-phase flows with surface tension and concentration transport effects. The unsteady two-dimensional flow is simulated by solving the conservation equations for mass, momentum and concentration. The code is validated with different problems. The bubble rise and coalescence physics are shown by the results and it is demonstrated that more bubbles per unit area improve deaeration efficiency. Different bubble formations, such as horizontal and vertical, with or without spacing, are also examined. It is discovered that horizontal bubbles with some spacing increase concentration transfer by up to 15.5%, while vertical bubbles with some spacing speed up short-time deaeration. Furthermore, it is recommended that bubble merging should be prevented to enhance deaeration quality. The results indicate that at the start of the process, horizontal and vertical bubbles with some spacing boost concentration transfer by about 50% compared to one bubble, but at the end of the process, only horizontal bubbles with some spacing achieve about 11% improvement, while vertical bubbles have no notable benefit over one bubble.},
 author = {S. Sharifi and P. Omidvar and A. Tayebi and P. Darvishi},
 doi = {https://doi.org/10.1016/j.ijmultiphaseflow.2025.105275},
 issn = {0301-9322},
 journal = {International Journal of Multiphase Flow},
 keyword = {SPH, Deaeration processes, Two-phase flows, Convection–diffusion, Bubble rising},
 pages = {105275},
 title = {Investigating the deaeration mechanism in 2D using the meshfree SPH method},
 url = {https://www.sciencedirect.com/science/article/pii/S0301932225001533},
 volume = {191},
 year = {2025}
}
