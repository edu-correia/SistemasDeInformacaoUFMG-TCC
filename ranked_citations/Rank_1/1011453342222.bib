@article{10.1145/3342222,
 abstract = {The resampling algorithm of Moser and Tardos is a powerful approach to develop constructive versions of the Lov\'{a}sz Local Lemma. We generalize this to partial resampling: When a bad event holds, we resample an appropriately random subset of the variables that define this event rather than the entire set, as in Moser and Tardos. This is particularly useful when the bad events are determined by sums of random variables. This leads to several improved algorithmic applications in scheduling, graph transversals, packet routing, and so on. For instance, we settle a conjecture of Szab\'{o} and Tardos (2006) on graph transversals asymptotically and obtain improved approximation ratios for a packet routing problem of Leighton, Maggs, and Rao (1994).},
 address = {New York, NY, USA},
 articleno = {36},
 author = {Harris, David G. and Srinivasan, Aravind},
 doi = {10.1145/3342222},
 issn = {0004-5411},
 issue_date = {October 2019},
 journal = {J. ACM},
 keyword = {resampling algorithm, packet routing, independent transversal, discrepancy, Lov\'{a}sz local lemma},
 month = {August},
 number = {5},
 numpages = {45},
 publisher = {Association for Computing Machinery},
 title = {The Moser--Tardos Framework with Partial Resampling},
 url = {https://doi.org/10.1145/3342222},
 volume = {66},
 year = {2019}
}
