@inproceedings{11399007,
 abstract = {This paper introduces a lightweight, fusion-based cryptographic framework tailored for secure communication in Internet of Vehicles (IoV) networks. The proposed design integrates a compact symmetric block cipher with a dynamic, blockchain-based key validation mechanism. The encryption scheme employs a modified Feistel structure combined with Binary Encoded Merge (BEM) and a Substitution-Transformation (ST) function to enhance non-linearity and confusion. Round keys are efficiently generated using a novel bit-mix module, supporting fast and energy-efficient processing on constrained Onboard Units (OBUs). To ensure key authenticity and prevent tampering, a lightweight blockchain layer—accessed via a DLL interface—manages session key validation, access control, and firmware attestation. The hybrid architecture not only supports low-latency vehicle-to-infrastructure (V2I) and vehicle-to-vehicle (V2V) communication but also offers resistance against spoofing, eavesdropping, and firmware-based attacks. The proposed solution is scalable, secure, and well-suited for real-time applications in edge-assisted vehicular ecosystems.},
 author = {V., Neeharikha P. and C, Yogesh and S, Vatchala},
 booktitle = {2025 IEEE 9th International Conference on Information and Communication Technology (CICT)},
 doi = {10.1109/CICT67193.2025.11399007},
 issn = {},
 keyword = {Access control;Ciphers;Vehicular ad hoc networks;Computer architecture;Benchmark testing;Real-time systems;Blockchains;Encryption;Vehicle dynamics;Internet of Vehicles;Lightweight cryptography;Internet of Vehicles (IoV);hybrid cipher;blockchain security;Feistel network;key management;V2V communication;V2I authentication;edge computing;secure communication protocol},
 month = {Dec},
 number = {},
 pages = {1-10},
 title = {Lightweight Blockchain-Enhanced Hybrid Cryptography for Secure IoV Communication},
