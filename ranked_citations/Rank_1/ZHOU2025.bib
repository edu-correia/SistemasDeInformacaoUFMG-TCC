@article{ZHOU2025,
 abstract = {ABSTRACT
The advances in pharmaceutical and material science rely on the development of sustainable techniques for selective C–F bond formation, in which the unique properties of fluorine enhance metabolic stability and enable functional materials. Herein, we report a photocatalytic radical–polar crossover strategy that merges alkene cross-coupling with direct fluorination, enabling the synthesis of sp³-rich fluorinated architectures under mild, energy-efficient conditions. In this method, abundant olefinic feedstocks and a green solvent (acetonitrile) are used to achieve precise regioselectivity while minimizing wastage, without using any harsh reagents. This versatile procedure can be used across diverse functional groups, pharmaceutically relevant heterocycles (e.g., indoles), and bioactive alkenes, delivering fluorinated products in yields of up to 93%. By integrating fluorination with alkene coupling in a single photocatalytic manifold, this work addresses the prevalent challenges in terms of selectivity and scalability, offering a sustainable platform for synthesizing fluorinated scaffolds with a reduced environmental footprint.},
 author = {Qixin Zhou and Tiancen Bian and Guocong Zhang and Liejin Zhou and Zuxiao Zhang},
 doi = {https://doi.org/10.1016/j.greenca.2025.08.002},
 issn = {2950-1555},
 journal = {Green Carbon},
 keyword = {Green chemistry, Sustainable fluorination, Photocatalysis, Alkene cross-coupling, Radical-polar crossover},
 title = {Cross–Coupling of Alkenes with Photocatalytic Fluorination},
 url = {https://www.sciencedirect.com/science/article/pii/S2950155525000631},
 year = {2025}
}
