@inproceedings{5419856,
 abstract = {Instruction scheduling is a crucial issue for cutting edge VLSI processors that exploit parallelism to solve the tradeoff between clock speed and power dissipation. A double scheme for multiple pipelines merges their scalar units into a multifunctional unit (MFU) and makes the MFU wave-pipeline. Parallelizing a resultant pipeline achieves instruction scheduling free due to multifunctionality. Applied such approach to the latest design of a ubiquitous processor, HCgorilla, this is implemented by using 0.18-µm CMOS standard cell chip.},
 author = {Fukase, Masa-aki and Ryosuke Murakami and Sato, Tomoaki},
 booktitle = {2010 15th Asia and South Pacific Design Automation Conference (ASP-DAC)},
 doi = {10.1109/ASPDAC.2010.5419856},
 issn = {2153-697X},
 keyword = {Processor scheduling;Arithmetic;Parallel processing;Very large scale integration;Clocks;Pipelines;Java;CMOS process;Hardware;Delay},
 month = {Jan},
 number = {},
 pages = {375-376},
 title = {Design and chip implementation of an instruction scheduling free ubiquitous processor},
 volume = {},
 year = {2010}
}
