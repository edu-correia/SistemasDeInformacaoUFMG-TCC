@inproceedings{4908394,
 abstract = {Sticker model was a popular computing in the area of DNA computing. The separate operation was one of the important operation in this model. Adleman-Lipton DNA computing model was belong to sticker model, but, it was not convenient to use separate and multi-separate operation in Adleman-Lipton model. In order to solve this problem, extended separate technology and extended multi-separate technology were introduced. A common problem in combinatorics area was solved by DNA computing way; and a DNA algorithm of a kind of circular forbidden permutation problem was proposed based on sticker model, extended technology and extended multi-separate technology. What is more, an instance was solved by this algorithm. The biochemical operation steps were given by simulation experiment. At last, the final DNA strands were obtained which proved the validity of the algorithm.},
 author = {Wang, Lei and Yang, Yu-xing and Wang, Ai-min and Ma, Ji-lan},
 booktitle = {2009 International Conference on Networks Security, Wireless Communications and Trusted Computing},
 doi = {10.1109/NSWCTC.2009.92},
 issn = {},
 keyword = {DNA computing;Computer networks;Combinatorial mathematics;Computational modeling;Computer security;Information security;Wireless communication;Software algorithms;Educational institutions;Biochemistry;DNA computation;sticker model;circular permutation},
 month = {April},
 number = {},
 pages = {13-16},
 title = {A DNA Algorithm of a Kind of Circular Forbidden Permutation Problem},
 volume = {2},
 year = {2009}
}
