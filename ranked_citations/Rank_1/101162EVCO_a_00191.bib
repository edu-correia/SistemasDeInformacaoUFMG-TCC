@article{10.1162/EVCO_a_00191,
 abstract = {Substitution Boxes S-Boxes play an important role in many modern-day cryptographic algorithms, more commonly known as ciphers. Without carefully chosen S-Boxes, such ciphers would be easier to break. Therefore, it is not surprising that the design of suitable S-Boxes attracts a lot of attention in the cryptography community. The evolutionary computation EC community also had several attempts using evolutionary paradigms to evolve S-Boxes with good cryptographic properties. This article focuses on a fitness function one should use when evolving highly nonlinear S-Boxes. After an extensive experimental analysis of the current state-of-the-art fitness functions, we present a new one that offers higher speed and better results when compared with the aforementioned fitness functions.},
 address = {Cambridge, MA, USA},
 author = {Picek, Stjepan and Cupic, Marko and Rotim, Leon},
 doi = {10.1162/evco_a_00191},
 issn = {1063-6560},
 issue_date = {Winter 2016},
 journal = {Evol. Comput.},
 keyword = {solution representation., fitness function, cryptography, S-Boxes, Evolutionary algorithms},
 month = {December},
 number = {4},
 numpages = {24},
 pages = {695–718},
 publisher = {MIT Press},
 title = {A new cost function for evolution of s-boxes},
 url = {https://doi.org/10.1162/EVCO_a_00191},
 volume = {24},
 year = {2016}
}
