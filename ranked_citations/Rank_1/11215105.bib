@inproceedings{11215105,
 abstract = {This paper presents a method of adaptive hysteresis thresholding aimed at shape detection and classification using a neural network micromodel. The research is focused on analyzing the impact of modifying hysteresis thresholds (±10%, ±20%, ±30% relative to reference values) on contour segmentation quality and classification performance. The generated binary images were merged and filtered to obtain averaged edge representations, based on which a dataset of 1245 images depicting basic geometric figures was created. The developed neural network model was trained on data from various binarization variants and evaluated in terms of classification accuracy. The results show that extending the thresholding range to ±30% and using averaged contours improves classification performance while maintaining low computational complexity. The proposed method constitutes an effective integration of classical segmentation techniques with CNN-based approaches, making it suitable for embedded applications.},
 author = {Konopiński, Jakub and Świetlicka, Aleksandra and Góral, Piotr and Pawłowski, Paweł},
 booktitle = {2025 Signal Processing: Algorithms, Architectures, Arrangements, and Applications (SPA)},
 doi = {10.23919/SPA65537.2025.11215105},
 issn = {2326-0319},
 keyword = {Deep learning;Image segmentation;Thresholding (Imaging);Adaptive systems;Shape;Image edge detection;Feature extraction;Stability analysis;Convolutional neural networks;Hysteresis;Adaptive thresholding;Edge detection;Image segmentation;Binary image processing;Contour extraction;Convolutional neural network (CNN);Shape classification;Image preprocessing;Local threshold modification;Overfitting in deep learning;Feature representation;Noise reduction in images;Image gradient maps;Segmentation stability;Deep learning for image analysis},
 month = {Sep.},
 number = {},
 pages = {68-74},
 title = {Adaptive Hysteresis Thresholding & Shape Detection Using Artificial Neural Networks},
