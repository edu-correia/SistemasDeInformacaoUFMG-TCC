@article{LAN2026123724,
 abstract = {Thermal energy storage (TES), benefiting from up to three heat storage modes: sensible, latent, and thermochemical, is essential for thermal management. However, coupling multiple modes challenges the prediction of operating temperatures and energy storage processes, making existing numerical simulation methods increasingly complex in modeling and multi-parameter analysis. Here, we propose a machine learning-enabled nomogram framework that integrates numerical simulation, time characterizing, and artificial neural networks to deliver rapid and accurate thermal condition predictions. Core of this framework is to introduce a transient process factor (TPF), derived through a power-function-based variable merging method, which combines the variables governing the transient rate into a single standardized time scale. This representation acts as a universal progress bar for transient heat transfer, enabling direct comparison across materials and systems. On this basis, neural networks are trained to map the relationships between TPF and key operating parameters, achieving high goodness-of-fit, with R2 reaching 0.999 across all four training processes, and the data-driven nomogram is then constructed. Using sodium acetate trihydrate as demonstration materials, we experimentally validated the nomogram. And with the aid of the error-correction formulas, the temperature prediction errors were reduced to within + 2.5 °C to –1 °C, and the time-prediction errors to within 1.2%. This approach significantly accelerates thermal-condition prediction, enabling rapid estimation of temperature evolution and storage dynamics while greatly enhancing design efficiency.},
 author = {Yuhao Lan and Yue Yu and Xiaoming Fang and Zhengguo Zhang and Ziye Ling},
 doi = {https://doi.org/10.1016/j.ces.2026.123724},
 issn = {0009-2509},
 journal = {Chemical Engineering Science},
 keyword = {Thermal energy storage, Thermal management, Machine learning, Nomogram, Rapid prediction},
 pages = {123724},
 title = {Data-driven nomogram for thermal energy storage based on time characterizing and machine learning},
 url = {https://www.sciencedirect.com/science/article/pii/S0009250926004367},
 volume = {328},
 year = {2026}
}
