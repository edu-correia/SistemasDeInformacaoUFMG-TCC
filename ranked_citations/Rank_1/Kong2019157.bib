@article{Kong2019157,
 abstract = {Entity alignment is the problem of identifying which entities in a data source refer to the same real-world entity in the others. Identifying entities across heterogeneous data sources is paramount to many research fields, such as data cleaning, data integration, information retrieval and machine learning. The aligning process is not only overwhelmingly expensive for large data sources since it involves all tuples from two or more data sources, but also need to handle heterogeneous entity attributes. In this paper, we propose an unsupervised approach, called EnAli, to match entities across two or more heterogeneous data sources. EnAli employs a generative probabilistic model to incorporate the heterogeneous entity attributes via employing exponential family, handle missing values, and also utilize the locality sensitive hashing schema to reduce the candidate tuples and speed up the aligning process. EnAli is highly accurate and efficient even without any ground-truth tuples. We illustrate the performance of EnAli on re-identifying entities from the same data source, as well as aligning entities across three real data sources. Our experimental results manifest that our proposed approach outperforms the comparable baseline. © 2019, Higher Education Press and Springer-Verlag GmbH Germany, part of Springer Nature.},
 author = {Kong, Chao and Gao, Ming and Xu, Chen and Fu, Yunbin and Qian, Weining and Zhou, Aoying},
 doi = {10.1007/s11704-017-6561-3},
 journal = {Frontiers of Computer Science},
 note = {Cited by: 14},
 number = {1},
 pages = {157 - 169},
 publication_stage = {Final},
 source = {Scopus},
 title = {EnAli: entity alignment across multiple heterogeneous data sources},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85048307112?origin=resultslist},
 volume = {13},
 year = {2019}
}
