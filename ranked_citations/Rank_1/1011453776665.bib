@article{10.1145/3776665,
 abstract = {Quotient types increase the power of type systems by allowing types to include equational properties. However, two key practical issues arise: code being duplicated, and valid code being rejected. Specifically, function definitions often need to be repeated for each quotient of a type, and valid functions may be rejected if they include subterms that do not respect the quotient. This article addresses these reusability and expressivity issues by introducing a notion of quotient polymorphism that we call choice polymorphism. We give practical examples of its use, develop the underlying theory, and implement it in Quotient Haskell.},
 address = {New York, NY, USA},
 articleno = {23},
 author = {Hewer, Brandon and Hutton, Graham},
 doi = {10.1145/3776665},
 issue_date = {January 2026},
 journal = {Proc. ACM Program. Lang.},
 keyword = {polymorphism, quotient types, refinement types, static verification},
 month = {January},
 number = {POPL},
 numpages = {29},
 publisher = {Association for Computing Machinery},
 title = {Quotient Polymorphism},
 url = {https://doi.org/10.1145/3776665},
 volume = {10},
 year = {2026}
}
