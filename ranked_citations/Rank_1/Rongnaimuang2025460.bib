@conference{Rongnaimuang2025460,
 abstract = {Data value creation is crucial in a data warehouse environment, where the ETL process is used as a tool to reduce data redundancy. This research presents a model of data value creation through ETL process to merge data from the Knowledge Innovation Management System (KIMs) and the Community Based Tourism Service Innovation Platform (RCBT-SIP) as a data warehouse. The data set in the warehouse consists of community, products, innovation, knowledge, activity, tourism route, and place. These 50 data sets are used as data to present via online channels such as web and mobile applications, which enable users to access interconnected information conveniently via a real-time location-based system. In addition, the payment system connected with that mobile application. As a result, the community can sell their products and services through these online channels more than 300,000 baht. In similar, customers can buy products and services of communities via online channels more than 300,000 baht. This process shows that data value creation presents when community take income and customer receives convenience. Moreover, the ETL process can reduce data redundancy with enhanced data accessibility to facilitate open data access. Finally, the model of data value creation can help to promote the use of data for sustainable community and economic development. © 2025 IEEE.},
 author = {Rongnaimuang, Jirapan and Janruang, Jongkol},
 doi = {10.1109/ICBIR65229.2025.11163077},
 journal = {2025 10th International Conference on Business and Industrial Research: Advanced Technology and Innovation for Sustainable Society, ICBIR 2025 - Proceedings},
 note = {Cited by: 0},
