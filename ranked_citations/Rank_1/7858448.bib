@inproceedings{7858448,
 abstract = {Erasable-itemset mining is to find the itemsets (components) that can be eliminated if the products generated from them gain profit under a given threshold. In this paper, we consider the erasable-itemset integration problem to merge the erasable itemsets from two data sources. We propose an efficient merging algorithm, which can get the merged erasable itemsets directly or by rescanning partial data sources to reduce mining time. Experiments are also made to show that the proposed algorithm executes faster than the re-mining approach for merging erasable itemsets.},
 author = {Hong, Tzung-Pei and Shih, Tsung-Ta and Lin, Chun-Wei and Vo, Bay},
 booktitle = {2016 International Computer Symposium (ICS)},
 doi = {10.1109/ICS.2016.0026},
 issn = {},
 keyword = {Itemsets;Production facilities;Merging;Data mining;Algorithm design and analysis;Computer science;data mining;erasable itemset;two-factory integration;data sources},
 month = {Dec},
 number = {},
 pages = {90-93},
 title = {Merging Two Sets of Erasable Itemsets},
 volume = {},
 year = {2016}
}
