 abstract = {Graph neural networks (GNNs) have shown success in various data mining tasks, including graph classification. Yet, as GNNs progress through deeper layers, they face a significant challenge: the dilution of local information across the graph. This is especially problematic for graph classification tasks, which integrate node features to produce a single graph embedding. In this paper, we introduce a subgraph embedding method for GNNs that aims to balance global and local information, thereby mitigating information dilution. Our method explicitly partitions a graph by removing edges between nodes, selecting subgraphs based on the minimal external degree. This method ensures limited information exchange and maintains local node characteristics, even with additional layers. An algorithm considers subgraph-level characteristics to strike a balance between global and local information. Multiple independent GNNs then process these subgraphs, and their features merge for graph classification. Rigorous testing on 11 benchmark datasets against 14 leading methods reveals that our method excels in 95 out of 154 instances, achieving a peak performance increase of 5.4%p. Notably, with increasing layers, our method consistently outshines traditional techniques, underlining its prowess in countering information dilution in GNNs. © 2023 IEEE.},
 author = {Moon, Hyung-Jun and Cho, Sung-Bae},
 doi = {10.1109/ICDMW60847.2023.00146},
 journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
 note = {Cited by: 1},
 pages = {1113 - 1120},
 publication_stage = {Final},
 source = {Scopus},
 title = {Exploiting Local Information with Subgraph Embedding for Graph Neural Networks},
 type = {Conference paper},
