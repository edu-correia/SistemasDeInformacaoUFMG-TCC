@inproceedings{10843516,
 abstract = {A novel miniaturized magneto-electric dipole (MED) antenna with dimensions of $(0.59 \times 0.46 \times 0.16) \lambda^{3}$ has been developed for X-band applications in this study. By incorporating parasitic elements in the upper part of the electric dipoles, the antenna’s impedance bandwidth has been expanded by 12.9%. The proposed MED antenna comprises five precisely merged FR4 substrates using soldering. Experimental results demonstrate that the proposed MED antenna in this work, covers 72.64% (6.89-14.75 GHz) impedance bandwidth with S11 <-10 dB. The measured peak gain of the antenna at 10.6 GHz is 7.15 dB. This design exhibits a stable radiation pattern, with a difference of over 17 dB between Co- and Cross-pol radiation. The main contribution of this study lies in the miniaturization of the antenna structure and the expansion of its impedance bandwidth.},
 author = {Behboudi, Morteza and Nourinia, Javad and Ghobadi, Changiz},
 booktitle = {2024 11th International Symposium on Telecommunications (IST)},
 doi = {10.1109/IST64061.2024.10843516},
 issn = {},
 keyword = {Antenna measurements;Dipole antennas;Magnetoelectric effects;Bandwidth;Microstrip antennas;Antenna feeds;Aperture antennas;Impedance;Loaded antennas;Testing;MED antenna;printed dipole;parasitic-elements;X-band;miniaturization},
 month = {Oct},
 number = {},
 pages = {561-566},
 title = {Miniaturized Printed X-Band Magneto-Electric Dipole Antenna by Loading Parasitic Elements},
 volume = {},
 year = {2024}
}
