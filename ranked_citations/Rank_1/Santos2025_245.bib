@article{Santos2025_245,
 abstract = {ABSTRACT The aim was to analyze the integration of cyberculture in the training of teachers and professionals in Physical Education courses at Federal Universities in the Northeast Region of Brazil. A qualitative research was conducted through semi-structured interviews with ten questions, applied to nine university professors using Google Meet in 2020. The interview audios were transcribed and analyzed using content analysis methodology, with support from ChatGPT for data segmentation, categorization, and descriptive interpretation. The results indicated a growing incorporation of digital technologies, such as virtual platforms and advanced tools, by university professors. However, significant challenges emerged, such as resistance to adopting new technologies and a lack of adequate continuous training actions for teachers. It was noted that the integration of cyberculture is varied, with some innovative practices observed in individual professor' actions, but with still limited widespread adoption. The study revealed a mixed panorama of cyberculture in professional training in Physical Education, highlighting resistance to technology adoption and the need for continuous training as critical areas. It concludes that collaboration between teachers and students is fundamental, with project-oriented didactic approaches being a promising solution for the identified gap.},
 author = {Santos, Edilson Laurentino dos and de Souza Wanderley Júnior, Rildo and Soares, Antonio Jorge Gonçalves and Santos, Lucas Eduardo Rodrigues dos and Nascimento, José Henrique de Arruda and Damascena, Conceição Rocha and Santos, Tony Meireles and Menezes, Vilde Gomes de},
 doi = {10.4025/jphyseduc.36i1.3607},
 pages = {e3607--e3607},
 title = {INTEGRATION OF CYBERCULTURE IN PHYSICAL EDUCATION COURSES AT FEDERAL UNIVERSITIES IN NORTHEASTERN BRAZIL},
 volume = {36},
 year = {2025}
}
