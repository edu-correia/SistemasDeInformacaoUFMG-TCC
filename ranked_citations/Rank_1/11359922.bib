@inproceedings{11359922,
 abstract = {The transition toward carbon neutrality within railway systems requires solutions that merge low-impact energy sources and storage technologies combined with highperformance power electronic converters. This paper proposes an energy management architecture for integration into the auxiliary power supply line of a train, targeting a reduction in the energy drawn from the electrical grid through the use of advanced Gallium Nitride (GaN)-based power converters. The system comprises a hydrogen fuel cell, a lithium-ion battery, a boost converter interfacing the fuel cell with the low-voltage DC bus, a bidirectional DC/DC converter interfacing the battery, and a $\mathbf{2 L - 5 L}$ Dual Active Bridge (DAB) converter connecting both sources to the 700 V auxiliary DC bus. The feasibility of employing GaN-based high-electron-mobility transistors (HEMTs) in the $\mathbf{2 L - 5 L}$ DAB converter is assessed through electrothermal simulations in PLECS. The findings validate the technical feasibility of the proposed onboard architecture, demonstrating its ability to reduce grid energy consumption, improve efficiency, and enhance onboard energy autonomy.},
 author = {Vicente, José and Rocha, Agostinho and Morais, Vitor},
 booktitle = {2025 IEEE 4th International Conference on Industrial Electronics for Sustainable Energy Systems (IESES)},
 doi = {10.1109/IESES66335.2025.11359922},
 issn = {},
 keyword = {Lithium-ion batteries;Hydrogen;Fuel cells;Computer architecture;HEMTs;Rail transportation;Power electronics;Hybrid power systems;MODFETs;Gallium nitride;Fuel Cell;Multilevel Converter;Power Electronics;Railway Auxiliary Services;Wide Band Gap Semiconductors},
 month = {Sep.},
 number = {},
 pages = {369-374},
 title = {Hybrid Fuel Cell-Battery Architecture for Auxiliary Railway Systems Using GaN-Based Power Converters},
 volume = {},
 year = {2025}
}
