@article{10.5555/3282588.3282616,
 abstract = {This paper presents a heuristic technique to infer field and column structure of fixed-width data sources. The resulting implementation is incorporated into a library that facilitates the use of online data sources by novice programmers in introductory Computer Science courses. The ability to automatically infer the structure of data enables users (e.g. CS1 students) to focus on using data for interesting purposes rather than becoming overwhelmed by having to preprocess, parse, and clean it themselves.},
 address = {Evansville, IN, USA},
 author = {Carter, Steven Andrew and Hamid, Nadeem Abdul},
 issn = {1937-4771},
 issue_date = {December 2018},
 journal = {J. Comput. Sci. Coll.},
 month = {December},
 number = {2},
 numpages = {9},
 pages = {199–207},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Automated inference of fixed-width data formats},
 volume = {34},
 year = {2018}
}
