@inproceedings{11399012,
 abstract = {In infrared imaging, thermal sensors are often corrupted with noise due to bad weather conditions, long distances, etc. This detail enhancement technique aims to recover fine image details while simultaneously minimizing noise and avoiding the introduction of artifacts. This paper presents a novel method for detail enhancement of images that maintains the details of the thermal image to a significant level in the presence of noise. This technique separates an image into its base element and fine details, processes each independently, and then merges them back together. This method utilizes a bilateral filter to generate the base component, with the input image serving as it’s input. Subsequently, a gradient filter is applied to the base component to create the high-frequency details. To retain important features while suppressing noise, a method is introduced for dynamically adjusting weights during processing. Finally, the resulting image is quantized to 8 bits. The proposed method is better than other power-hungry methods and provides better visual quality with much lower computational complexity. Experimental verification and analysis are done with different quality metrics to validate the results. This method involves components that are suitable for hardware implementation, and a very large-scale integration (VLSI) architecture of this method is presented. This VLSI architecture consumes 93 mW of dynamic power at 100 MHz.},
 author = {Iman, Ruhul and Keshav, Neelabh and Bachina, Kishore and Patil, C. R.},
 booktitle = {2025 IEEE 9th International Conference on Information and Communication Technology (CICT)},
 doi = {10.1109/CICT67193.2025.11399012},
 issn = {},
 keyword = {Weather;Noise;Adaptive filters;Computer architecture;Filtering algorithms;Very large scale integration;Thermal sensors;Information filters;Thermal noise;Hardware;Details enhancement;Bilateral filter;Gradient filter;Adaptive weight generation;NETD},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {Real-Time Noise-Efficient Detail Enhancement Technique for Infrared Images},
