@article{LIU2025128437,
 abstract = {For the heat dissipation of multiple heat sources, such as microchips with multiple hotspots, the boiling front propagation leads to the merging and growth of the dry spot area, which may result in microchip failure. In this study, a novel boiling enhancement strategy for microchips with multiple hotspots is developed to restrict the boiling front propagation and enhance pool boiling performance. Pool boiling experiments were conducted on the covered smooth surfaces (CS surfaces), the smooth silicon surfaces (SS surface), and micro-nano composited structured surfaces (MNCS surfaces) in HFE-7100 at different liquid subcoolings. The mechanism of the boiling front propagation restriction and the boiling heat transfer enhancement of the MNCS surfaces were revealed. The results show that the micro-nano composited structures enhance surface wickability and effectively restrict the boiling front propagation along the width direction. Moreover, by decreasing the size of the micro-nano composited region, the MNCS surfaces further restrict the boiling front propagation along the length direction and reduce the resistance of lateral liquid wicking, which broadens the hydrodynamic liquid-chocking limit and promotes the liquid rewetting, thereby further enhancing the pool boiling performance. Specifically, the MNCS surface with heating region sizes of 2 mm × 2 mm exhibits the highest critical heat flux (CHF) of 220.0 W·cm−2 and the highest heat transfer coefficient (HTC) of 11.8 W·cm−2·K−1 among the tested surfaces, which are 11.6 times and 18.1 times higher than those of the SS surface with heating region sizes of 10 mm × 10 mm at a liquid subcooling of 3 K. When the liquid subcooling is 35 K, the CHF and HTC of the MNCS2×2 surface are 280.0 W·cm−2 and 41.5 W·cm−2·K−1, respectively, which are 9.8 times and 71.3 times higher than those of the SS10×10 surface.},
 author = {Bin Liu and Xuanyu Liu and Si’ao Tang and Qing Li and Yonghai Zhang},
 doi = {https://doi.org/10.1016/j.applthermaleng.2025.128437},
 issn = {1359-4311},
 journal = {Applied Thermal Engineering},
 keyword = {Hotspot, Pool boiling, Micro-nano composited structure, Two-phase liquid immersion cooling, Critical heat flux, Wickability},
 pages = {128437},
 title = {Micro-nano composited surfaces for boiling front propagation restriction and pool boiling performance enhancement},
 url = {https://www.sciencedirect.com/science/article/pii/S1359431125030297},
 volume = {280},
 year = {2025}
}
