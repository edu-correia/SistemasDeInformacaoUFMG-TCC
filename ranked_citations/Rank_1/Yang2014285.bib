@article{Yang2014285,
 abstract = {In this article, three general categories for pansharpening are described: the component substitution techniques, the modulation-based techniques and the multiresolution analysis-based techniques. Most of the existing pansharpening algorithms are classified into these three categories. The technical features of each category are analysed. On the basis of this analysis, a generalised model is deduced from some typical algorithms which are selected from each category. This model expresses the relationship between the sharpened higher resolution multispectral image and three components (i.e. the original multispectral image, the spatial details extracted from the higher resolution panchromatic image and the adopted fusion strategies). The generalised model for pansharpening is comprehensive, which describes almost all pansharpening algorithms. Using the generalised model, similarities and differences between these algorithms are analysed, which guide us to design or select a specific technique to achieve a different emphasis. At last, the methodology designing or selecting a pansharpening scheme to address different application requirements is discussed. © 2014, Taylor & Francis.},
 author = {Yang, Jinghui and Zhang, Jixian},
 doi = {10.1080/19479832.2014.936528},
 journal = {International Journal of Image and Data Fusion},
 note = {Cited by: 9},
 number = {4},
 pages = {285 - 299},
 publication_stage = {Final},
 source = {Scopus},
 title = {Pansharpening: from a generalised model perspective},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84914676569?origin=resultslist},
 volume = {5},
 year = {2014}
}
