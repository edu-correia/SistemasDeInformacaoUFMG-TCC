@inproceedings{10176689,
 abstract = {This paper recommends AMSCNet. The network can acquire input poses at the pixel level by importing multi-channel image data. First, the network is a new multiscale rest architecture that can improve the utilization of feature information in each network layer. Second, this study introduces the Atrous Spatial Pyramid Pooling module in the bottleneck layer to extract multiscale information and improve object discrimination by combining channel attention and spatial attention to enhance attention to important areas of the image. Finally, a feature fusion module (FFM) was created to improve the accuracy of information extraction, which combines multi-level information to improve recognition and localization reliability for the object. This new architecture achieves state-of-the-art accuracies of 98.9% for the Cornell dataset and 95.7% for the Jacquard dataset at real-time speeds.},
 author = {Wang, An and Lu, Zongqing and Qin, Siyuan},
 booktitle = {2023 IEEE 3rd International Conference on Electronic Technology, Communication and Information (ICETCI)},
 doi = {10.1109/ICETCI57876.2023.10176689},
 issn = {},
 keyword = {Location awareness;Merging;Feature extraction;Information retrieval;Real-time systems;Convolutional neural networks;Reliability;robotic grasp detection;convolutional network;attention mechanism},
 month = {May},
 number = {},
 pages = {1583-1588},
 title = {A New Attention-Based Multiscale Convolutional Network for Grasp Detection},
 volume = {},
 year = {2023}
}
