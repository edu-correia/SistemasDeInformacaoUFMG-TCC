@conference{Shijie2021789,
 abstract = {Duplicate item detection is the process of identifying multiple representations of the same real entity in a data set. Due to the huge amount of data, and the same real entity may have different representations, this task is very difficult. For this task, in recent years, researchers have proposed the Sorted Neighborhood Method (SNM) and Repeat Counting Strategy (DCS), reduce the number of comparisons of record pairs during duplicate entries while maintaining high matching quality. Inspired by these two algorithms, we propose an improved SNM algorithm. The algorithm uses an objective method to select sort keywords, and optimizes the strategy of duplicate item comparison. At the same time, it uses a variable window method to avoid the problems caused by a fixed window in the detection process.  © 2021 IEEE.},
 author = {Shijie, Zhou and Yuanshen, Lou},
 doi = {10.1109/ISCIPT53667.2021.00165},
 journal = {Proceedings - 2021 6th International Symposium on Computer and Information Processing Technology, ISCIPT 2021},
 note = {Cited by: 0},
 pages = {789 - 792},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Optimal Strategy of Sorting Neighborhood Method},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85124282970?origin=resultslist},
 year = {2021}
}
