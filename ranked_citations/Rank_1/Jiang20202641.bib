@article{Jiang20202641,
 abstract = {In this work, iterative learning model predictive control approaches are presented to resolve the control problem of trajectory based aircraft operation with time-of-arrival constraint. Firstly, we formulated this problem being an output tracking issue with along-track wind disturbance. Next, P-type point-to-point iterative learning control algorithms are designed to overcome the influence of repetitive along-track wind. In addition, a point-topoint iterative learning model predictive control algorithm with variable prediction step is also designed to eliminate the interference of non-repetitive gusts on the air route. Finally, numerical simulations are provided to verify the effectiveness of the proposed method. © 2020, ICROS, KIEE and Springer.},
 author = {Jiang, Gaoyang and Hou, Zhongsheng},
 doi = {10.1007/s12555-019-0590-7},
 journal = {International Journal of Control, Automation and Systems},
 note = {Cited by: 16},
 number = {10},
 pages = {2641 - 2649},
 publication_stage = {Final},
 source = {Scopus},
 title = {Iterative Learning Model Predictive Control Approaches for Trajectory Based Aircraft Operation with Controlled Time of Arrival},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85085571722?origin=resultslist},
 volume = {18},
 year = {2020}
}
