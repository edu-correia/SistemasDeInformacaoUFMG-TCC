@article{YU2025118324,
 abstract = {The tedious manufacturing process of lithium battery (LB) inevitably brings various defects to its surface, and it is a major challenge to accurately identify various defects under complex background. To tackle this issue, a novel model SaE-DCDown-HAFPN Network (SDHNet) is proposed aimed at improving the accuracy of defect identification in LBs. Firstly, we incorporate the Squeeze aggregated Excitation (SaE) attention mechanism into the backbone network to enhance the feature extraction module. This integration allows for more effective capture of critical channel features and bolsters the model’s comprehension of intricate scenes. Secondly, we introduce the dual channel downsampling (DCDown) module by merging average pooling with max pooling strategies while employing a multi-path processing mechanism that captures features across varying scales and types—thereby increasing sensitivity towards morphologically similar defects. Finally, we propose a new neck fusion framework termed Hybrid Auxiliary FPN (HAFPN), which combines the neck and backbone network outputs through the shallow auxiliary fusion (SAF) module and transmits more diverse gradient information to the output layer through the deep auxiliary fusion (DAF) module, thereby endowing the network with enhanced multi-scale processing capabilities. Meanwhile, the parameter reuse and channel retention mechanisms are employed to minimize the structural redundancy of the model to the greatest extent. Extensive experiments conducted on our self-constructed LB defect dataset demonstrate that this model exhibits significant advantages over other advanced models; it achieves mAP of 90.6 %, while maintaining the inference time of 8.7 ms for each image—thus meeting stringent industrial requirements for defect detection.},
 author = {Hanwen Yu and Yiquan Wu},
 doi = {https://doi.org/10.1016/j.measurement.2025.118324},
 issn = {0263-2241},
 journal = {Measurement},
 keyword = {Lithium battery (LB), Defect detection, Attention mechanism, Downsampling, Hybrid Auxiliary FPN (HAFPN)},
 pages = {118324},
 title = {SDHNet: a hybrid auxiliary fusion network for lithium battery surface defect detection},
 url = {https://www.sciencedirect.com/science/article/pii/S0263224125016835},
 volume = {256},
 year = {2025}
}
