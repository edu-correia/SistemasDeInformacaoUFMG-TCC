@article{WANG2025126279,
 abstract = {Through the utilization of meticulously annotated multi-modal datasets, the realm of affective computing has witnessed significant advancements in the domain of multi-modal sentiment analysis. Despite these strides, the integration and interpretation of data from three distinct modalities — text, sound, and vision — pose considerable challenges in terms of effective feature amalgamation and the establishment of a robust feature representation framework. In this paper, we introduce an innovative non-uniform attention module, designated as “NUAM”, which is specifically tailored for the seamless fusion of multi-modal features. Drawing inspiration from empirical phenomena, the proposed attention-based network architecture is crafted with the text modality considered as a stable and determinate form of representation. Simultaneously, the network harnesses the acoustic and visual modalities to distill and condense relevant affective information into a unified, robust structure, termed the tripartite interaction representation. This novel approach ensures that the disparate modalities are not only effectively combined but also contribute to a comprehensive understanding of the underlying sentiment. The attention module is strategically interwoven within the LSTM (Long Shot-Term Memory) architecture, embedding itself into successive time steps and adhering to the recurrent information processing paradigm. The culmination of the LSTM’s final hidden state and the NUAM’s output is merged into a singular vector. This vector then proceeds through a linear embedding layer, which ultimately transmutes it into the sentiment analysis outcome. Moreover, to capture and incorporate latent data structures that may have been overlooked by prior methodologies, an optional reconstruction loss, predicated on cluster centroids, is incorporated. This innovative measure further refines the model’s predictive capabilities and ensures that the analysis is not only effective but also comprehensive. The effectiveness and robustness of the proposed method are demonstrated through experimental analysis on three different datasets.},
 author = {Binqiang Wang and Gang Dong and Yaqian Zhao and Rengang Li and Wenfeng Yin and Lihua Lu},
 doi = {https://doi.org/10.1016/j.eswa.2024.126279},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Sentiment analysis, Attention, LSTM},
 pages = {126279},
 title = {Tripartite interaction representation learning for multi-modal sentiment analysis},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417424031464},
 volume = {268},
 year = {2025}
}
