 number = {8},
 pages = {2476-2508},
 title = {Integration and implementation of LSS 4.0 practices: a perspective from manufacturing and service sectors},
 url = {https://www.sciencedirect.com/science/article/pii/S1754273124000325},
 volume = {37},
