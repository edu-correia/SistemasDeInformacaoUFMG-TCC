@article{LIU2026152875,
 abstract = {This study presents ADPrednet, a novel multimodal deep learning model for predicting methane (CH4) yield in anaerobic digestion (AD). The model integrates image-based color, texture, and intensity features with historical yield data to capture the complex physicochemical dynamics of the AD process. Built upon a Transformer backbone for multi-source feature fusion and a Kolmogorov–Arnold Network (KAN) for nonlinear regression, ADPrednet achieves an R2 of 0.9019, outperforming LSTM, GRU, CNN-LSTM, and Transformer baselines. Correlation analyses using Pearson Correlation Coefficient (PCC) and SHapley Additive exPlanations (SHAP) reveal that features from the lower reactor region contribute most to predictive performance. These findings demonstrate that combining visual information with temporal modeling significantly enhances prediction accuracy and robustness, offering a promising approach for biogas plant automation and the optimization of renewable energy production.},
 author = {Peng Liu and Shengxian Cao},
 doi = {https://doi.org/10.1016/j.ijhydene.2025.152875},
 issn = {0360-3199},
 journal = {International Journal of Hydrogen Energy},
 keyword = {Anaerobic digestion, CH yield prediction, Image feature, Deep learning},
 pages = {152875},
 title = {A method for predicting CH4 yield in the anaerobic digestion process by integrating image features with deep learning},
 url = {https://www.sciencedirect.com/science/article/pii/S0360319925058781},
 volume = {199},
 year = {2026}
}
