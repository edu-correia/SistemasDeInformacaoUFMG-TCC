@article{DONG2025466273,
 abstract = {This study presents a novel microfluidic magnetic solid-phase extraction (MSPE) platform for acetamiprid analysis, integrating dynamically manipulated aptamer-functionalized magnetic (apta-magnetic) sorbents with high-performance liquid chromatography (HPLC). The apta-magnetic sorbents are dynamically manipulated within a serpentine microchannel to induce chaotic advection, enhancing mixing and accelerating target capture. Directional immobilization of aptamers on streptavidin-coated magnetic beads (SAMBs) via Strep-tag II ensures mild elution with D-desthiobiotin, eliminating the need for toxic organic solvents. When coupled with HPLC, the optimized system achieves a linear response to acetamiprid concentrations ranging from 0.1 to 100 μM, with detection limits (LODs) of 0.04-0.05 μM and quantification limits (LOQs) of 0.15-0.17 μM. Critically, acetamiprid levels quantified by this method correlate strongly with those from the standard QuEChERS approach across diverse samples and concentrations. This organic-solvent-free, dynamically controlled platform seamlessly merges sustainable extraction with precise chromatographic analysis, offering a robust solution for food safety monitoring.},
 author = {Xingdong Dong and Qi Lu and Yiping Zhang and Limin Yang},
 doi = {https://doi.org/10.1016/j.chroma.2025.466273},
 issn = {0021-9673},
 journal = {Journal of Chromatography A},
 keyword = {Microfluidic chip, Magnetic solid-phase extraction, Strep-tag II, Apta-magnetic sorbents, HPLC analysis},
 pages = {466273},
 title = {Microfluidic magnetic solid-phase extraction of acetamiprid using dynamically manipulated apta-magnetic sorbents for chromatographic analysis},
 url = {https://www.sciencedirect.com/science/article/pii/S0021967325006181},
 volume = {1760},
 year = {2025}
}
