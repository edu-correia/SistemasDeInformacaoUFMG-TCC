@inproceedings{11065952,
 abstract = {To address the challenges of unscientific data segmentation, poor clustering performance, and limited scalability in parallel execution in density-based clustering methods for largescale datasets, this study presents a parallelized density-based clustering approach integrating Locality-Sensitive Hashing (LSH) and grid density analysis, abbreviated as PLGDC. The PLGDC algorithm is divided into following steps: data partition, localized cluster computing, and comprehensive cluster merging. At the beginning, we design a data division function (DG-LSH) by using multi-resolution locality sensitive hashing (LSH) to partition the data grid automatically. Secondly, we design dynamic grid density normalization formula (DGDF) to compute the density of grid cells. Then, we propose a density-based clustering algorithm (MRLC) to parallel obtain the local clusters. Finally, we propose global cluster mering algorithm based on MapReduce and BFS (GCM-MR) to optimize the parallelized aggregation of clustering results. The Empirical evaluations demonstrate that the PLGDC algorithm achieves superior clustering accuracy and enhanced scalability in distributed environments when handling large-scale datasets.},
 author = {Xu, Kaibin and Zhou, Xinghang and Qiu, Bin},
 booktitle = {2025 5th International Symposium on Computer Technology and Information Science (ISCTIS)},
 doi = {10.1109/ISCTIS65944.2025.11065952},
 issn = {},
 keyword = {Information science;Sensitivity;Heuristic algorithms;Scalability;Clustering methods;Merging;Clustering algorithms;Computer architecture;Partitioning algorithms;Data mining;LSH;Grid density;clustering algorithm;big data},
 month = {May},
 number = {},
 pages = {1189-1193},
 title = {PLGDC: A parallel density clustering algorithm based on LSH and grid density},
 volume = {},
 year = {2025}
}
