@inproceedings{11391010,
 abstract = {We pioneer the application of sentiment analysis as a diagnostic framework for evaluating public perceptions of $\mathbf{5 G}$ wireless networks, identifying critical gaps in performance, accessibility, and trust. By systematically analysing discourse trends-spanning health concerns, infrastructural limitations, and economic barriers-we derive actionable insights for $\mathbf{6 G}$ innovation. A key contribution is the integration of liquid crystalbased reconfigurable systems, which enable adaptive, energyefficient hardware for next-generation networks. Furthermore, we advocate for explainable AI to enhance transparency in network decision-making, ensuring ethical compliance and reducing the prevalence of scope creep. Our findings propose a holistic 6 G development paradigm, merging tunable materials, AI-driven optimization, and responsible governance to foster resilient and socially attuned communication ecosystems.},
 author = {Li, Jinfeng and Ding, Hangliang and Li, Haorong and Xiao, Yunchen},
 booktitle = {2025 12th International Conference on Social Networks Analysis, Management and Security (SNAMS)},
 doi = {10.1109/SNAMS67467.2025.11391010},
 issn = {2831-7343},
 keyword = {6G mobile communication;Sentiment analysis;Ethics;Technological innovation;Explainable AI;Social networking (online);Wireless networks;Reconfigurable intelligent surfaces;Security;Proposals;5G;6G;Ethical AI;Explainable AI;IoT;Liquid Crystal Systems;Public Sentiment;Reconfigurable Intelligent Surfaces;Sentiment Analysis;Wireless Networks},
 month = {Nov},
 number = {},
 pages = {132-137},
 title = {Public Sentiment Analysis Proposal for Beyond-5G Deployment and Reconstructing Confidence in 6G Wireless Systems with Liquid Crystal Reconfigurability and Ethical AI},
 volume = {},
 year = {2025}
}
