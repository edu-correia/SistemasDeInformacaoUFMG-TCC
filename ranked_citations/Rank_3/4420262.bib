@inproceedings{4420262,
 abstract = {As the rapid changes in global economy and the integration of world market, the corporation merger and acquisition will provide a useful solution for the cable television companies in Taiwan to increase their profits, improve asset management efficiency, expand market share, adjust cost structure and acquire the business competitive advantage eventually. The aim of this study is to construct a prototype system to support the decision making of corporation merger for the cable television industry. The system integrates the fuzzy inference, grey incidence analysis and Dempster-Shafer theory of evidence to decide the priority of the selected target companies for merger events. Meanwhile, the grey decision making method is also applied to estimate the merger timing of the target companies. The impact of top managerial resistance against the merger is also examined in this study. Some real cases of corporation merger are collected to evaluate the performance of the prototype system.},
 author = {Chou, Tsung-Nan},
 booktitle = {2007 International Conference on Convergence Information Technology (ICCIT 2007)},
 doi = {10.1109/ICCIT.2007.151},
 issn = {},
 keyword = {Corporate acquisitions;Decision making;Cable TV;Prototypes;Companies;Costs;Decision support systems;Timing;Fuzzy systems;Information technology},
 month = {Nov},
 number = {},
 pages = {212-216},
 title = {A Integrated Corporate Merger Decision-Making System for the Taiwanese Cable Television Industry},
 volume = {},
 year = {2007}
}
