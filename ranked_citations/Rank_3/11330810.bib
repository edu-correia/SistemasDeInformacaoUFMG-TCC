@inproceedings{11330810,
 abstract = {Legacy COBOL programs often exceed the token limits of modern large language models (LLMs), posing challenges for automatic summarization and comprehension. Traditional approaches either summarize code paragraph-wise or split sequentially into blocks, which often neglect semantic relationships among program components. This paper introduces a novel agentic summarization method leveraging paragraphlevel call graphs to create semantically coherent code blocks within LLM token windows. Our method integrates specialized agents for metadata extraction, grouping, explanation, and hierarchical merging, achieving improved ROUGE and BLEU scores and reduced summarization time compared to baselines. We evaluate on the X-COBOL dataset using Meta-Llama-3-8B-Instruct and show significant quality improvements over sequential and paragraph-wise grouping approaches.},
 author = {Bhattacharyya, Sourav and Chatterjee, Vasudev and Alexander, William and Kumar, Ranjan},
 booktitle = {2025 5th International Conference on AI-ML-Systems (AIMLSystems)},
 doi = {10.1109/AIMLSystems67835.2025.11330810},
 issn = {},
 keyword = {Agentic AI;Codes;Large language models;Semantics;Merging;Text summarization;Metadata;Aging;Real-time systems;COBOL;summarization;large language models;call graph;agentic AI;legacy systems},
 month = {Oct},
 number = {},
 pages = {29-31},
 title = {Agentic Summarization of Large Cobol Programs Beyond LLM Context Limits Using Call Graph-Based Grouping},
 volume = {},
 year = {2025}
}
