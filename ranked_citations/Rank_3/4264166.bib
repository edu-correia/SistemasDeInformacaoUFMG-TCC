@inproceedings{4264166,
 abstract = {In this paper, a novel integrated hybrid antenna structure for system-in-package (SiP) application is presented. Part of the chip package is utilized as the hybrid dielectric resonator antenna (DRA). The hybrid DRA comprises a rectangular dielectric resonator (DR) and a conductor-backed coplanar waveguide (CB-CPW) slot. The CB-CPW slot is designed to simultaneously act as an effective radiator and the feeding structure of the DR. Dual resonances of the two radiators are merged to extend the antenna's bandwidth. A prototype antenna for 5 GHz WLAN achieved 20.4% input impedance bandwidth and around 6 dBi gain. The proposed configuration provides a possible solution to the antenna integration for SiP system.},
 author = {Gao, Yuan and Popov, Alexandre P. and Ooi, Ban-Leong and Leong, Mook-Seng},
 booktitle = {2007 IEEE/MTT-S International Microwave Symposium},
 doi = {10.1109/MWSYM.2007.380022},
 issn = {0149-645X},
 keyword = {Dielectric resonator antennas;Bandwidth;Packaging;Coplanar waveguides;Rectangular waveguides;Resonance;Slot antennas;Antenna feeds;Prototypes;Wireless LAN;Dielectric resonator antenna;hybrid antenna;system-in-package;transceiver},
 month = {June},
 number = {},
 pages = {1653-1656},
 title = {Integrated Hybrid Dielectric Resonator Antenna for System-in-Package Application},
 volume = {},
 year = {2007}
}
