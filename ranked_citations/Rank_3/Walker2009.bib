@conference{Walker2009,
 abstract = {In this paper we extend the concept of shell pipes to incorporate forks, joins, cycles, and key-value aggregation. These extensions enable the implementation of a class of data-flow computation with strong deterministic properties, and provide a simple yet powerful coordination layer for leveraging multi-language and legacy components for large-scale parallel computation. Concretely, this paper describes the design and implementation of the language extensions in Bourne Again SHell (BASH), and examines the performance of the system using micro and macro benchmarks. The implemented system is shown to scale to thousands of processors, enabling high throughput performance for millions of processing tasks on large commodity compute clusters. Copyright 2009 ACM.},
 author = {Walker, Edward and Xu, Weijia and Chandar, Vinoth},
 doi = {10.1145/1645164.1645175},
 journal = {Proceedings of the 4th Workshop on Workflows in Support of Large-Scale Science, WORKS '09, in Conjunction with SC 2009},
 note = {Cited by: 11},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Composing and executing parallel data-flow graphs with shell pipes},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/74249107667?origin=resultslist},
 year = {2009}
}
