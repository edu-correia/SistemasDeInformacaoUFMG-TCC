@inproceedings{11009974,
 abstract = {The security development of 5G Network Device-toDevice (D2D) communication remains essential for advancing network operational excellence and user experience quality. The research introduces an extensive security enhancement strategy that integrates the open-source platforms Open5GS, UERANSIM, and Wireshark to implement and test the system. The proposed framework combines robust authentication and key management approaches with secure communication methods while implementing privacy-protecting techniques made specifically for 5 G networks. Data confidentiality and integrity are ensured through a cryptographic methodology that merges AES encryption with Huffman coding approaches. This research demonstrates that unified tools and methods strengthen 5G network D2D communication security by effectively resolving key distribution problems and guaranteeing data authenticity.},
 author = {J, Chaithanya D and V, Jaswanth and Patil, Chandrashekar M and K, Ravikiran H and Prasad, H P Nikitha and Srinivasa, Sanjana},
 booktitle = {2025 3rd International Conference on Smart Systems for applications in Electrical Sciences (ICSSES)},
 doi = {10.1109/ICSSES64899.2025.11009974},
 issn = {},
 keyword = {Lead acid batteries;Data privacy;5G mobile communication;Smart systems;User experience;Encryption;Device-to-device communication;Performance analysis;Huffman coding;Next generation networking;5G;Open5GS;UERANSIM;AES;Huffman coding},
 month = {March},
 number = {},
 pages = {1-6},
 title = {Performance Analysis for Secured Device Communication in Next Generation Networks},
 volume = {},
 year = {2025}
}
