 issn = {},
 keyword = {Ethics;Technological innovation;Navigation;Education;Merging;Mixed reality;Virtual reality;Life sciences;Mirrors;Standards;Mixed Reality (MR);Virtual Dissection;Biology Education;Environmental Sustainability;Interactive Learning;Humane Alternatives},
