@inproceedings{5117810,
 abstract = {A micropolarization array composed of a dual layer nano-wire polarization filters is presented. The nano-wire polarization filters are composed of 80 nm wide aluminum wires with 160 nm wire pitch. Two nano-wire polarization filters are separately patterned and etched with 6 micron square structures. The two layers are offset by 45 degrees and merged together to form the final filter. The extinction ratios of the filter are experimentally measured to be 150 and 1000 in the blue and red spectrum respectively.},
 author = {Gruev, Viktor and Van der Spiegel, Jan and Engheta, Nader},
 booktitle = {2009 IEEE International Symposium on Circuits and Systems},
 doi = {10.1109/ISCAS.2009.5117810},
 issn = {2158-1525},
 keyword = {Filters;Optical polarization;Extinction ratio;Image sensors;Sensor arrays;Pixel;Optical arrays;Data mining;Photodiodes;Degradation},
 month = {May},
 number = {},
 pages = {561-564},
 title = {Nano-wire dual layer polarization filter},
 volume = {},
 year = {2009}
}
