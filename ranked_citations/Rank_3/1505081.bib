@inproceedings{1505081,
 abstract = {This paper presents a road lane detection and interpretation algorithm for driver assistance systems (DAS). The algorithm uses an edge filter to extract lane borders to which a straight lane model is fitted. Next, the lane mark type (continuous, discontinuous or merge) is recognized using a Fourier analysis. The line type is essential for a robust DAS. Nevertheless, it has been seldom considered in previous works. The knowledge of the line types of the road helps to guide the search for other lines, to automatically detect the type of the road (one-way, two way or highway), and to tell the difference between allowed and forbidden maneuvers, such as crossing a continuous line. Furthermore, the system is able to auto calibrate, thus easing the process of installation in commercial vehicles.},
 author = {Collado, J.M. and Hilario, C. and de la Escalera, A. and Armingol, J.M.},
 booktitle = {IEEE Proceedings. Intelligent Vehicles Symposium, 2005.},
 doi = {10.1109/IVS.2005.1505081},
 issn = {1931-0587},
 keyword = {Frequency;Vehicle detection;Road vehicles;Intelligent transportation systems;Cameras;Object detection;Automated highways;Intelligent vehicles;Machine intelligence;Road transportation},
 month = {June},
 number = {},
 pages = {78-83},
 title = {Detection and classification of road lanes with a frequency analysis},
 volume = {},
 year = {2005}
}
