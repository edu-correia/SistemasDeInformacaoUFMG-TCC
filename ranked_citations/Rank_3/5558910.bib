@inproceedings{5558910,
 abstract = {Vertical search engines (VSEs) serves as a good alternative to irrelevant results retrieved by general-purpose search engines. However, a best VSE does not exist for all VSE domains. VSEs can have distributed and disjoint information within a specific domain. We introduce this emerging issue, vertical result merging. We identify issues uniquely related to vertical result merging and present a domain-oriented re-ranking method. We also develop a novel content quality measure to assess the usefulness of our approach as compared to traditional metasearch result merging.},
 author = {Marshall, Brandeis},
 booktitle = {2010 IEEE International Conference on Information Reuse & Integration},
 doi = {10.1109/IRI.2010.5558910},
 issn = {},
 keyword = {Merging;Search engines;Metasearch;Computer science;Portals;Decision support systems;Google;content quality;vertical search engines;rank aggregation methods;experimentation},
 month = {Aug},
 number = {},
 pages = {350-354},
 title = {Determining result quality for vertical result merging},
 volume = {},
 year = {2010}
}
