@inproceedings{11487596,
 abstract = {Community detection is a fundamental task in complex network analysis. Recent studies have highlighted the significance of seed communities and their pivotal role in network structure exploration. However, conventional seed-based community detection methods, such as k-plex and k-clique, often neglect inter-connections among seed communities, treating them as isolated entities. This limitation leads to community over-segmentation, where semantically related communities are fragmented into disjoint subsets. Moreover, these seed-based methods rely exclusively on topological information while constructing seed communities, disregarding node attributes, which often results in seed communities that deviate from the network’s intrinsic structure. To address these issues, we propose CSCGCL, a novel community detection method that integrates connected seed communities with graph contrastive learning to enhance detection accuracy and robustness. Our method first enhances the network by reconstructing edges based on node similarity, ensuring that connectivity reflects both structural and attribute-based relationships. Maximal k-plex structures are then identified as seed communities while preserving their inter-connections. Finally, graph contrastive learning is employed to unify various information from seed communities, enabling effective community merging and expansion. Extensive experiments on real-world datasets validate the superiority of CSCGCL over state-of-the-art approaches.},
 author = {Zhao, Debo and Zhou, Qifeng and Wu, Yangjian},
 booktitle = {2025 China Automation Congress (CAC)},
 doi = {10.1109/CAC67268.2025.11487596},
 issn = {2688-0938},
 keyword = {Recommender systems;Central Processing Unit;Information filtering;Complex networks;Network topology;Protocols;HTTP;Radio access networks;Regional area networks;Communications technology;Community detection;k-plex;Graph contrastive learning},
 month = {Sep.},
 number = {},
 pages = {7531-7536},
 title = {CSCGCL: A New Seed-enhanced Community Detection Approach with Graph Contrastive Learning},
 volume = {},
