@inproceedings{10729445,
 abstract = {The exploration of spatial-temporal graph neural networks has been extensive, yet it remains a challenge due to the intricate variations in spatiotemporal dependencies across skeleton joint flows. In response, we propose a novel guidance mechanism within the latent 3D spatial-temporal space, termed Latent Graph Neural Networks (LGNN). Our approach involves designing a long-term spatio-temporal model with a high k-value to capture action information effectively within the latent spatial-temporal domain, thereby representing the spatiotemporal dynamics of skeleton sequences. To enhance feature information between distant nodes and address redundant information, we introduce a pair distance normalization operation in the latent space. This operation facilitates the formation of LGNN, where two streams of base LGNN seamlessly merge into a single network, enabling end-to-end training. Notably, our method significantly improves performance compared to state-of-the-art approaches and enhances accuracy across three widely used and challenging datasets for action recognition.},
 author = {Wei, Xianlong and Li, Ce and Zhao, Kaipan and Jiang, Zhongbo},
 booktitle = {2024 IEEE 2nd International Conference on Sensors, Electronics and Computer Engineering (ICSECE)},
 doi = {10.1109/ICSECE61636.2024.10729445},
 issn = {},
 keyword = {Training;Computer vision;Three-dimensional displays;Graph neural networks;Spatiotemporal phenomena;Sensors;Human activity recognition;Convolutional neural networks;Joints;Streams;skeleton action recognition;two streams;graph neural networks},
 month = {Aug},
 number = {},
 pages = {371-374},
 title = {Latent Graph Neural Networks for Human Skeleton-based Action Recognition},
 volume = {},
 year = {2024}
}
