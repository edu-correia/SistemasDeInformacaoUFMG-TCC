@article{10.14778/3457390.3457392,
 abstract = {Partitioning is effective in avoiding expensive shuffling operations. However, it remains a significant challenge to automate this process for Big Data analytics workloads that extensively use user defined functions (UDFs), where sub-computations are hard to be reused for partitionings compared to relational applications. In addition, functional dependency that is widely utilized for partitioning selection is often unavailable in the unstructured data that is ubiquitous in UDF-centric analytics. We propose the Lachesis system, which represents UDF-centric workloads as workflows of analyzable and reusable sub-computations. Lachesis further adopts a deep reinforcement learning model to infer which sub-computations should be used to partition the underlying data. This analysis is then applied to automatically optimize the storage of the data across applications to improve the performance and users' productivity.},
 author = {Zou, Jia and Das, Amitabh and Barhate, Pratik and Iyengar, Arun and Yuan, Binhang and Jankov, Dimitrije and Jermaine, Chris},
 doi = {10.14778/3457390.3457392},
 issn = {2150-8097},
 issue_date = {April 2021},
 journal = {Proc. VLDB Endow.},
 month = {April},
 number = {8},
 numpages = {14},
 pages = {1262–1275},
 publisher = {VLDB Endowment},
 title = {Lachesis: automatic partitioning for UDF-centric analytics},
 url = {https://doi.org/10.14778/3457390.3457392},
 volume = {14},
 year = {2021}
}
