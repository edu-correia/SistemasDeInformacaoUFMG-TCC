@conference{Otsubo2025140,
 abstract = {This study focuses on reconstructing game states in American football by generating minimap representations of plays from video footage. Our approach follows a five-step pipeline: detecting and tracking players and referees, identifying players via jersey numbers, transforming camera perspectives, stitching multiview images to create a panoramic image, and generating a minimap. Obtaining accurate player trajectories requires a sideline perspective wide view, providing a comprehensive field overview. Conversely, jersey number recognition demands an end-zone perspective tight view, where players face each other before playing. To integrate these perspectives, we apply image stitching to merge multiple camera views into a seamless scene. Camera transformation techniques ensure accurate spatial alignment across perspectives. Our pipeline achieved 59.9 mean localization error with 45.6% accuracy for team classification for players and referees. This work introduces an efficient pipeline for automated minimap generation, enabling effective game state reconstruction from video footage. © 2025 ACM.},
 author = {Otsubo, Rintaro and Ishii, Kazami and Saito, Hideo},
 doi = {10.1145/3728423.3759397},
 journal = {MMSports 2025 - 8th International ACM Workshop on Multimedia Content Analysis in Sports},
 note = {Cited by: 0},
 pages = {140 - 147},
 publication_stage = {Final},
 source = {Scopus},
 title = {Players Tracking and Identification for Minimap Generation in American Football},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105021403011?origin=resultslist},
 year = {2025}
}
