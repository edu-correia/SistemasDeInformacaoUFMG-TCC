@inproceedings{11477648,
 abstract = {The rapid advancement of computing and network technologies has enabled large-scale data collection and storage, yet the resulting datasets are often inconsistent, duplicated, or unstructured. This paper introduces a semiautomatic framework for harvesting entity attribute sets from heterogeneous web sources and application programming interfaces (APIs) and grouping them into coherent, semantically related, entities. The approach integrates automated data extraction, normalization, and synonym detection to produce consistent and unified data representations. By minimizing manual intervention, the framework reduces human error and subjectivity that often lead to inconsistencies in data preparation processing. Compared to large language models (LLMs), the proposed method offers deterministic and reproducible results while maintaining lower computational costs. The framework provides a practical solution for improving data quality and preparing structured datasets for further analytical or machine learning tasks.},
 author = {Trivundža, Miloš and Đurić, Zoran},
 booktitle = {2026 25th International Symposium INFOTEH-JAHORINA (INFOTEH)},
 doi = {10.1109/INFOTEH68759.2026.11477648},
 issn = {2767-9470},
 keyword = {Contacts;Circuits and systems;Videos;Mobile handsets;Protocols;Communication systems;IP networks;Smart phones;Telecommunications;Video equipment;Data Preparation;Automation;Data Normalization;Deterministic Classification;Synonym Detection;Large Language Models},
 month = {March},
 number = {},
 pages = {1-6},
 title = {Automated Collection, Normalization and Matching of Entity Attributes from Various Web Sources},
 volume = {},
 year = {2026}
}
