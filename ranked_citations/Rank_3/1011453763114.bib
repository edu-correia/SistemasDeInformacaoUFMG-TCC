@article{10.1145/3763114,
 abstract = {Choreographic programming is a promising new paradigm for programming concurrent systems where a developer writes a single centralized program that compiles to individual programs for each node. Existing choreographic languages, however, lack critical features integral to modern systems, like the ability of one node to dynamically compute who should perform a computation and send that decision to others. This work addresses this gap with λQC, the first typed choreographic language with first class process names and polymorphism over both types and (sets of) locations. λQC also improves expressive power over previous work by supporting algebraic and recursive data types as well as multiply-located values. We formalize and mechanically verify our results in Rocq, including the standard choreographic guarantee of deadlock freedom.},
 address = {New York, NY, USA},
 articleno = {336},
 author = {Samuelson, Ashley and Hirsch, Andrew K. and Cecchetti, Ethan},
 doi = {10.1145/3763114},
 issue_date = {October 2025},
 journal = {Proc. ACM Program. Lang.},
 keyword = {Choreographies, Concurrency, Functional programming},
 month = {October},
 number = {OOPSLA2},
 numpages = {26},
 publisher = {Association for Computing Machinery},
 title = {Choreographic Quick Changes: First-Class Location (Set) Polymorphism},
 url = {https://doi.org/10.1145/3763114},
 volume = {9},
 year = {2025}
}
