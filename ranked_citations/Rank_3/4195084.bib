@inproceedings{4195084,
 abstract = {We propose a novel fast sub-pixel search control algorithm for H.264 encoder by using neighbor motion vectors. This fast sub-pixel search control algorithm cuts down the motion estimation time by referring neighbor motion vectors and the current integer motion vector. This algorithm can also improve the performance of the motion estimation time more by merging other fast search algorithms with its independent discrimination.},
 author = {La, Byeongdu and Eom, Minyoung and Choe, Yoonsik},
 booktitle = {The 9th International Conference on Advanced Communication Technology},
 doi = {10.1109/ICACT.2007.358305},
 issn = {1738-9445},
 keyword = {Motion control;Motion estimation;Automatic voltage control;Video sequences;ISO standards;Transform coding;MPEG 4 Standard;Merging;Video coding;Standards development;H.264;Motion Estimation;Sub-pixel search;Motion Vector},
 month = {Feb},
 number = {},
 pages = {62-65},
 title = {Fast Sub-pixel Search Control by using Neighbor Motion Vector in H.264},
 volume = {1},
 year = {2007}
}
