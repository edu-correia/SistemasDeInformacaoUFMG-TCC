@inproceedings{10062875,
 abstract = {The non-maximum suppression (NMS) algorithm, which merges neighboring bounding boxes as the detection result, is widely utilized in object detection methods. However, the traditional NMS algorithm is not suitable for text detection in natural scenes, especially for long texts and dense texts. In this paper, we observe that the coordinates of candidate bounding boxes are presented in skew distribution. On this observation, an improved NMS algorithm called SD-NMS (Skew Distribution NMS) is designed. First, the mode and the median of the coordinate set are counted to filter out the redundant bounding boxes. Then the left bounding boxes are merged for the location of the text regions. The SD-NMS method improves the detection ability of the model without extra model training and can be easily embedded in text detection methods. The experimental results show that our method obtains F-measure more than other NMS methods in public data sets ICDAR2015 and MSRATD500.},
 author = {Zhou, Gang and Yang, Youwei and Mo, Jiaqing and Liu, Qiuling},
 booktitle = {2022 International Conference on Virtual Reality, Human-Computer Interaction and Artificial Intelligence (VRHCIAI)},
 doi = {10.1109/VRHCIAI57205.2022.00043},
 issn = {},
 keyword = {Training;Human computer interaction;Solid modeling;Object detection;Virtual reality;Filtering algorithms;Artificial intelligence;non-maximum suppression algorithm;text detection;skew distribution},
 month = {Oct},
 number = {},
 pages = {212-217},
 title = {Skew Distribution NMS Algorithm for Text Detection in Natural Scenes},
 volume = {},
 year = {2022}
}
