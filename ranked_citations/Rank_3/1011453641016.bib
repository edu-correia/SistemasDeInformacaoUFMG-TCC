@article{10.1145/3641016,
 abstract = {Heritage is a dynamic concept, being constantly redefined by those that value it. Modern approaches to heritage bring focus to participatory processes that put communities at the centre of the heritage discourse. For migrant communities, these participatory processes can show the tension of integration versus identity, as migrants integrating into their host country can maintain, adapt or loose connections to their cultural identity. Digital storytelling platforms can offer space for exposing such tensions. In this paper, storytelling is adopted as a practice to engage three communities of migrants (with different socio-cultural contexts) on their relation to heritage. Through workshops, participants created 78 stories (accessible through a Digital Storytelling platform), which were thematically analysed. Using the concept of boundary objects, we discuss how participant's stories reflect heritage discourse and how they are entangled within the wider social, economic, and environmental context.},
 address = {New York, NY, USA},
 articleno = {177},
 author = {Bala, Paulo and Nisi, Valentina and Nunes, Nuno Jardim},
 doi = {10.1145/3641016},
 issue_date = {April 2024},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {communities, cultural exclusion, cultural heritage, digital storytelling, migrants, social cohesion, social inclusion},
 month = {April},
 number = {CSCW1},
 numpages = {32},
 publisher = {Association for Computing Machinery},
 title = {Stories as Boundary Objects: Digital Storytelling with Migrant Communities for Heritage Discourses},
 url = {https://doi.org/10.1145/3641016},
 volume = {8},
 year = {2024}
}
