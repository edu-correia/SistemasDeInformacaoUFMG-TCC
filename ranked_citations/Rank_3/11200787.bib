@inproceedings{11200787,
 abstract = {In an era of innovative solutions, workplace safety demands immersive technologies like Virtual Reality (VR) to offer unprecedented, revolutionized risk management training. This research investigates the integration of immersive VR training in enhancing risk management practices across three stages. Initially, two focus groups identified the perceived benefits, limitations, and key variables that influence the integration of VR into risk management training, which reflect the identification, assessment, monitoring, reporting, and review of simulation risks in VR. Subsequently, interviews with 10 safety experts evaluated VR’s ability to improve hazard recognition, risk assessment, and safety protocol adherence, highlighting both advantages and implementation challenges. Finally, the Analytic Hierarchy Process (AHP), which was conducted with 10 experts, compared VR training against other modalities, assessing effectiveness in safety and risk management outcomes. The findings reveal that VR has the highest weight $51 \%$ for risk management training and decision making under simulated conditions. Followed by blended training $30 \%$ and AR $19 \%$, based on key criteria: cost-effectiveness, trainee engagement, safety impact, ease of implementation, and accessibility. By merging human cognitive processes with VR-based infocommunications, this study demonstrates how immersive training enhances cognitive capabilities for risk management, aligning with the goals of Cognitive InfoCommunications (CogInfoCom). This study offers actionable insights into leveraging VR to bridge gaps in traditional training, transforming workplace safety and operational efficiency.},
 author = {Alhamad, Abdallah and Gilányi, Attila},
 booktitle = {2025 IEEE 16th International Conference on Cognitive Infocommunications (CogInfoCom)},
 doi = {10.1109/CogInfoCom66819.2025.11200787},
 issn = {2473-5671},
 keyword = {Training;Protocols;Reviews;Employment;Merging;Virtual reality;Analytic hierarchy process;Safety;Risk management;Monitoring;Virtual Reality;Cognitive InfoCommunications;Digital Transformation;Safety Training;Risk Management},
 month = {Sep.},
 number = {},
 pages = {000231-000236},
 title = {The Role of Immersive Virtual Reality Training in Enhancing Risk Management Practices},
 volume = {},
