@article{Zhang20071,
 abstract = {The objective of this article is to recapitulate our experience in aligning large anatomical ontologies (Foundational Model of Anatomy, GALEN, Adult Mouse Anatomical Dictionary and NCI Thesaurus) having different representation formalisms. Our approach to aligning concepts (directly) is automatic, rule-based, and operates at the schema level, generating mostly point-to-point mappings. It uses a combination of lexical, structural and semantic techniques. It also takes advantage of domain-specific knowledge (lexical knowledge from external resources, such as the Unified Medical Language System, as well as knowledge augmentation and inference techniques). In addition to point-topoint mapping of concepts, we present the alignment of relationships and the mapping of concepts group-to-group. We have also successfully tested an indirect alignment through a reference ontology. We present an evaluation of our techniques, both against a gold standard and against a generic schema matching system. The advantages and limitations of our approach are analyzed and discussed throughout the article. Copyright © 2007, IGI Global.},
 author = {Zhang, Songmao and Bodenreider, Olivier},
 doi = {10.4018/jswis.2007040101},
 journal = {International Journal on Semantic Web and Information Systems},
 note = {Cited by: 53; All Open Access; Green Open Access},
 number = {2},
 pages = {1 - 26},
 publication_stage = {Final},
 source = {Scopus},
 title = {Experience in aligning anatomical ontologies},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/41149130605?origin=resultslist},
 volume = {3},
 year = {2007}
}
