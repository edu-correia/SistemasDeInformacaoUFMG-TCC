@article{WAN2019103055,
 abstract = {The integration of spatial information in the hyperspectral image (HSI) classification is demonstrated to be a promising way to improve classification accuracy. In this study, a novel hybrid framework with a three-stage process is proposed to exploit spatial autocorrelation of HSI. First, the multi-scale bi-exponential edge-preserving smoother (BEEPS) is introduced into HSI for the first time. Second, the multiple spectral-spatial features from multi-scale BEEPS are fed separately as input into the deep learning model, to obtain an original classification map by merging results from the classifier ensemble. Third, to fully utilize the spatial context of unlabeled samples, SUSAN detector and regional growth rule are adopted to determine the local region of each pixel. Finally, a major voting mechanism is performed to obtain the final result by integrating the original classification map and the labels of the corresponding neighborhood samples. Experimental results prove that the proposed scheme provides competitive results compared with some traditional methodologies.},
 author = {Xiaoqing Wan and Chunhui Zhao},
 doi = {https://doi.org/10.1016/j.infrared.2019.103055},
 issn = {1350-4495},
 journal = {Infrared Physics & Technology},
 keyword = {Hyperspectral image (HSI), Spectral-spatial classification, Bi-exponential edge-preserving smoother (BEEPS), Stacked sparse autoencoder (SSA), SUSAN detector},
 pages = {103055},
 title = {Spectral-spatial hyperspectral image classification combining multi-scale bi-exponential edge-preserving filtering and SUSAN edge detector},
 url = {https://www.sciencedirect.com/science/article/pii/S1350449519303858},
 volume = {102},
 year = {2019}
}
