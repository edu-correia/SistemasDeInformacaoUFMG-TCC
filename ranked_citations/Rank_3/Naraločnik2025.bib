@article{Naraločnik2025,
 abstract = {This study develops the Information Systems–Organizational Fit Alignment Model (ISOFAM) to evaluate information systems (IS) alignment during the pre-combination phase of mergers and acquisitions (M&A)—a critical yet underexplored stage in integration planning. Through constructivist grounded theory and the reanalysis of qualitative data from two anonymized M&A cases—one domestic (Slovenian) and one cross-border (European)—this study identifies four diagnostic dimensions: Technical Compatibility, Functional Complementarity, Cultural and Governance Fit, and Planning Maturity. ISOFAM is operationalized through visual tools, including the Risk–Opportunity Diagnostic Matrix, IS Misalignment Escalation Flowchart, and Temporal Integration Framework, which facilitate early alignment and strategic foresight. These contributions position IS as a strategic pre-combination priority, enhancing both theoretical and practical outcomes in digital M&A. © 2025 by the authors.},
 author = {Naraločnik, Andrej and Bertoncelj, Andrej and Bertoncel, Tine},
 doi = {10.3390/systems13070565},
 journal = {Systems},
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 number = {7},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Information Systems in Pre-Combination M&A: Developing an ISOFAM},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105011723162?origin=resultslist},
 volume = {13},
