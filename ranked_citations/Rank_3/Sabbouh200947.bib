@conference{Sabbouh200947,
 abstract = {This paper demonstrates the use of mapping relations and context for the purpose of generating the mediation schema from mappings between legacy schemas to ensure the correct exchange of information between legacy systems. In the process, we define the mapping relations as vocabulary for composing XML schemas. Typically, the mapping relations provide the functionality to define type hierarchies, to define elements and attributes, to constrain the value space using enumeration, to expand the value space using union constructs, to merge sub trees of XML schemas, to insert an element into a sequence, and to define default values. To generate the mediation schema, the mediator sets the mediation schema to one of the legacy schemas. Then, the mediator augments the mediation schema derived in the first step with XML Schema definitions by interpreting the mappings between the legacy schemas.},
 author = {Sabbouh, Marwan and Hebert, Daniel J. and Wan, Caleb and Bennett, Scott R. and Potter, Dan},
 journal = {18th International Conference on Software Engineering and Data Engineering 2009, SEDE 2009},
 note = {Cited by: 0},
 pages = {47 - 54},
 publication_stage = {Final},
 source = {Scopus},
 title = {Using mapping relations for XML schema mediation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84883353807?origin=resultslist},
 year = {2009}
}
