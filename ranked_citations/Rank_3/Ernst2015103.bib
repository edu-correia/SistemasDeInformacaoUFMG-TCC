@conference{Ernst2015103,
 abstract = {We present a near-future research agenda for bringing a suite of modern programming-languages verification tools - specifically interactive theorem proving, solver-aided languages, and formally defined domain-specific languages - To the development of a specific safety-critical system, a radiotherapy medical device. We sketch how we believe recent programming-languages research advances can merge with existing best practices for safety-critical systems to increase system assurance and developer productivity. We motivate hypotheses central to our agenda: That we should start with a single specific system and that we need to integrate a variety of complementary verification and synthesis tools into system development.},
 author = {Ernst, Michael D. and Grossman, Dan and Jacky, Jon and Loncaric, Calvin and Pernsteiner, Stuart and Tatlock, Zachary and Torlak, Emina and Wang, Xi},
 doi = {10.4230/LIPIcs.SNAPL.2015.103},
 journal = {Leibniz International Proceedings in Informatics, LIPIcs},
 note = {Cited by: 2},
 pages = {103 - 112},
 publication_stage = {Final},
 source = {Scopus},
 title = {Toward a dependability case language and workflow for a radiation therapy system},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84959053819?origin=resultslist},
 volume = {32},
 year = {2015}
}
