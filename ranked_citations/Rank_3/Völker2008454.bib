 author = {Völker, Johanna and Rudolph, Sebastian},
 doi = {10.1109/WIIAT.2008.36},
 journal = {Proceedings - 2008 IEEE/WIC/ACM International Conference on Web Intelligence, WI 2008},
 note = {Cited by: 26},
