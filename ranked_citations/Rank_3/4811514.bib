@inproceedings{4811514,
 abstract = {The correspondence and branching problem are vexed problems when reconstructing 3-D surfaces from 2-D parallel contours. However, there are different definitions to the branching problem and correspondence problem in previous literatures, and the branching problem and correspondence problem are difficult to distinguish upon them. This puzzles researchers while investigating and explaining. This paper gives a detailed analysis to this puzzle and proposed a new definitions of branching problem and correspondence problem, thus the two problems are determinate and distinguishable. After giving new definitions, the two vexed problems can be researched respectively and combined together to form a final solution by contour grouping method proposed in this paper. The new enunciations also help to perform researching work efficiently and analyze the experiment logically.},
 author = {Jinguo He},
 booktitle = {2008 IEEE International Conference on Systems, Man and Cybernetics},
 doi = {10.1109/ICSMC.2008.4811514},
 issn = {1062-922X},
 keyword = {Surface reconstruction;Joining processes;Helium;Performance analysis;Level set;Reconstruction algorithms;Merging;correspondence and branching problem;contour;surface;reconstructing;slice},
 month = {Oct},
 number = {},
 pages = {1591-1595},
 title = {The correspondence and branching problem in medical contour reconstruction},
 volume = {},
 year = {2008}
}
