@article{LI2026102273,
 abstract = {This article introduces the conceptual orientation of the special issue and proposes a framework for understanding feedback as a dynamic and multi-level process in educational contexts. Rather than presenting new empirical findings, the paper synthesizes insights from educational psychology, neuroscience, and learning analytics to examine how feedback operates across interpersonal, cognitive, and contextual dimensions. Building on these perspectives, the paper introduces the REFLECT framework, which conceptualizes feedback as an adaptive system shaped by learner characteristics, relational dynamics between feedback providers and recipients, and broader instructional environments. The framework highlights how feedback interpretation and effectiveness depend not only on message characteristics but also on learners’ emotional states, motivational factors, and prior experiences. The article also situates the empirical contributions of the special issue within this conceptual perspective, illustrating how recent studies address key questions related to feedback processing, learner engagement, and feedback design in both traditional and technology-enhanced learning environments. By framing feedback as an interactive and evolving process, the REFLECT model provides a theoretical lens for integrating diverse research approaches and guiding future work in feedback research and educational practice.},
 author = {Jingxian Li and Ying Xia and  Buyuhua},
 doi = {https://doi.org/10.1016/j.lmot.2026.102273},
 issn = {0023-9690},
 journal = {Learning and Motivation},
 keyword = {Psychology of education, Participation of learners, Affective and cognitive functions, Education with neural networks},
 pages = {102273},
 title = {The reimagination of feedback in contemporary learning via the merging of neuroscience, educational statistics, and education},
 url = {https://www.sciencedirect.com/science/article/pii/S0023969026000330},
 volume = {94},
 year = {2026}
}
