@inproceedings{11027975,
 abstract = {This paper explores the innovative application of Chinese-culture-based (CCB) design in the development of multiband patch antennas, seamlessly integrating culturally resonant symbols, including traditional motifs and calligraphic elements such as Lishu characters. We trace the evolution of CCB antennas, highlighting advancements from the pioneering WANG-shaped patch antennas to the recent multiband Guo- and Qing-shaped designs. These antennas not only honor China's rich cultural heritage but also enhance performance and aesthetic value in wireless communication. Through methodologies such as Characteristic Mode Theory (CMT), our research illustrates how tradition can harmoniously merge with modern technology. The findings underscore the potential of CCB antennas for applications in smart cities, cultural heritage sites, and sustainable practices, highlighting the convergence of art and technology within the domain of wireless communications.},
 author = {Chung, Kwok L.},
 booktitle = {2025 8th World Conference on Computing and Communication Technologies (WCCCT)},
 doi = {10.1109/WCCCT65447.2025.11027975},
 issn = {},
 keyword = {Wireless communication;Technological innovation;Smart cities;Patch antennas;Symbols;Communications technology;Global communication;Cultural differences;Intelligent sensors;Convergence;Chinese-culture-based (CCB) antennas;CMT;sensors;Guo-shaped patch;DeepSeek},
 month = {April},
 number = {},
 pages = {246-250},
 title = {Harmonizing Tradition and Innovation: Advances in Chinese-Culture-Based Antennas and Sensors},
 volume = {},
 year = {2025}
}
