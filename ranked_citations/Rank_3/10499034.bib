@inproceedings{10499034,
 abstract = {The term “metaverse” is being spoken around often in the IT sector. Investments, startups constructing components, new platform announcements, and major corporations joining this realm of digital interaction are constantly in the news. There is a great deal of momentum towards a nearly natural 3D virtual environment, and the clarion cry may have led to Facebook renaming as Meta, which may be recognized as a watershed point in the development of the Metaverse. One can work, play, and socialize in the Metaverse at any time, from any location, using whatever device you want. Users can engage in real-time interactions by merging physical, augmented, and virtual realities. It is a game-changer in digital connection, with boundless, unrealized potential and enormous commercial prospects. In this chapter, the researchers explore the meaning of the metaverse, its use in different fields, and its advantages. This chapter may assist people and organizations in better preparing themselves for the possibilities and difficulties that today’s state-of-the-art technology brings.},
 author = {Joshi, Rahul and Pandey, Krishna and Kumari, Suman},
 booktitle = {2024 11th International Conference on Computing for Sustainable Global Development (INDIACom)},
 doi = {10.23919/INDIACom61295.2024.10499034},
 issn = {},
