@conference{Zhong2025,
 abstract = {To address the growing demand for advanced video coding, the joint video experts team (JVET) launched the enhanced compression model (ECM) in April 2021 to explore technologies beyond versatile video coding (VVC). Following this trend, the audio and video coding standard (AVS) workgroup began exploring video coding technologies beyond AVS3 in 2023 and released the exploration video model (EVM) as the development platform. In AVS3, the affine model of the current affine merge mode coded block is inherited from previously coded blocks, which may not be optimal for the current block. To improve the accuracy of the affine model for affine merge mode, an affine motion refinement (AMR) method that requires no additional signaling is proposed in this paper. This method refines the affine motion by combining template matching (TM) and bilateral matching (BM), with design enhancements including candidate reordering based on TM cost, optimized search patterns, and adaptive multi-granularity search strides. Experimental results demonstrate that the proposed method {1.02% (Y), 0.71% (U), 0.87% (V)} and {0.42% (Y), 0.34% (U), 0.56% (V)} Bjontegaard Delta rate (BD-rate) reduction under the random access (RA) and low delay with B slices (LDB) configurations, respectively. Due to the excellent performance under acceptable complexity, the proposed method has been adopted to the EVM platform as a potential coding tool for the next generation of AVS standard. © 2025 IEEE.},
 author = {Zhong, Yucheng and Li, Hongbo and Zhu, Jiabao and Lai, Wanglin and Ma, Licong and Chen, Jie and Liao, Ru-Ling and Li, Xinwei and Yu, Li and Ye, Yan},
 doi = {10.1109/PCS65673.2025.11417524},
 journal = {2025 Picture Coding Symposium, PCS 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Affine Motion Refinement for the Next Generation of AVS Standard},
 type = {Conference paper},
