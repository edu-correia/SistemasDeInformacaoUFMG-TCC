@inproceedings{5670472,
 abstract = {Radio frequency identification (RFID) uses wireless local area network technology, which limits its scope of application. And the data security isn't well protected because of the limited hardware resource of cheap electronic tag. In this paper, we realize the combination of TCP/IP and RFID technology by the Ethernet interface of SAMSysMP9320 reader/writer. This is accomplished by assigning IP address and port number to the Ethernet interface of the SAMSysMP9320 reader/writer. Therefore the Internet and LAN -based RFID are merged, and RFID tag without power supply can be read and written from afar by the Internet. This provides a customer-oriented, unified and self-adaptive network service. Meanwhile, Snort intrusion detection system is implemented so that the data security is enhanced in RFID system.},
 author = {Guo, Hao-yan and Guo, Chang-yong and Wang, Fa-qiang},
 booktitle = {2010 2nd International Symposium on Aware Computing},
 doi = {10.1109/ISAC.2010.5670472},
 issn = {},
 keyword = {IP networks;Radio frequency;Radiofrequency identification;Educational institutions;RFID;RFID reader;Internet network;Snort Network Intrusion Detection System},
 month = {Nov},
 number = {},
 pages = {181-184},
 title = {The design and realization of the integration of internet and LAN-based RFID and the intrusion detection system based on Snort in the RFID system with Ethernet interface},
 volume = {},
 year = {2010}
}
