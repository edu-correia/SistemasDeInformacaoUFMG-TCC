@incollection{CANNATARO2022129,
 abstract = {In bioinformatics data integration is the process of merging heterogeneous data produced by multiple laboratories or stored in different databases. More recently, the use of deep learning to mine integrated data (e.g., in an omics field) has gained major attention. We here introduce the main concepts related to data integration, and we present some existing approaches.},
 author = {Mario Cannataro and Pietro Hiram Guzzi and Giuseppe Agapito and Chiara Zucco and Marianna Milano},
 booktitle = {Artificial Intelligence in Bioinformatics},
 doi = {https://doi.org/10.1016/B978-0-12-822952-1.00022-X},
 editor = {Mario Cannataro and Pietro Hiram Guzzi and Giuseppe Agapito and Chiara Zucco and Marianna Milano},
 isbn = {978-0-12-822952-1},
 keyword = {Data integration, Big data, Data modeling, Data mining equations},
 pages = {129-136},
 publisher = {Elsevier},
 title = {Chapter 12 - Integrative bioinformatics},
 url = {https://www.sciencedirect.com/science/article/pii/B978012822952100022X},
 year = {2022}
}
