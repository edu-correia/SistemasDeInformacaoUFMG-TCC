@article{Guo2025447,
 abstract = {With the rapid development of large medical language models, multi-task fusion has become a key research focus. However, ophthalmic consultation and knowledge teaching tasks differ significantly in input structure, language style, and objectives, making direct joint training prone to semantic drift and modeling conflicts. To address this, we propose a multistage strategy combining task-decoupled distillation and branch-merge training to build MedFusion-R1-7B, a lightweight and efficient ophthalmic multi-task language model. We first use the teacher model DeepSeek-R1-Qwen-32B to annotate both tasks and construct a unified dataset, then transfer knowledge to the student model DeepSeek-R1-Qwen-7B via LoRA fine-tuning. Task-specific sub-models are trained through decoupled fine-tuning and used to generate new soft labels, which guide branchmerge re-distillation to achieve unified multi-task representation. We further apply NF4 quantization for efficient inference. Experiments show that MedFusion-R1-7B achieves competitive performance close to the teacher model while significantly reducing memory and latency, offering a practical solution for multi-task deployment in medical NLP. © 2025 IEEE.},
 author = {Guo, Ruifeng and Cheng, Daang and Wang, Hongliang and Xiu, Pengfei and Liu, Xianjie},
 doi = {10.1109/ICCC68654.2025.11437837},
 journal = {Proceedings of the IEEE International Conference on Computer and Communications, ICCC},
 note = {Cited by: 0},
 pages = {447 - 452},
 publication_stage = {Final},
 source = {Scopus},
 title = {MedFusion-R1-7B: Task-Decoupled Distillation Framework for Multi-Task Medical LLMs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105035783732?origin=resultslist},
 year = {2025}
