@article{10752661,
 abstract = {Automatic signal modulation classifiers are important instruments in electronic warfare, cognitive radio, or spectrum management. In this context, a feature-based (FB) automatic modulation classifier (AMC) for pulsed radar signals has been developed based on low-complexity statistical features of the signal and hierarchical decision trees (HDTs). This AMC works on a block-by-block basis. A global classification of the analyzed signal is obtained by merging the information from all the blocks. This real-time classifier runs on a field-programmable gate array (FPGA)-based platform at sampling rates exceeding 1 Gsample/s. To achieve real-time operation (clock frequency  $\approx 150$  MHz and latency  $\lt 3.5~\mu $ s) while minimizing FPGA resources, several architectural techniques, mainly based on pipelining, have been used.},
 author = {López-Asunción, Samuel and González-López, Jorge and García-de-la-Cueva, Carlos and López-Vallejo, Marisa and Grajal, Jesús},
 doi = {10.1109/TIM.2024.3497146},
 issn = {1557-9662},
 journal = {IEEE Transactions on Instrumentation and Measurement},
 keyword = {Time-frequency analysis;Frequency modulation;Sensitivity;Receivers;Real-time systems;Low latency communication;Field programmable gate arrays;Clocks;Signal to noise ratio;Radio spectrum management;Automatic modulation classifier (AMC);deep pipeline;electronic warfare;field-programmable gate array (FPGA);intrapulse modulation;radar},
 month = {},
 number = {},
 pages = {1-12},
 title = {Design and Implementation of a Real-Time Low-Latency Automatic Modulation Classifier},
 volume = {74},
 year = {2025}
}
