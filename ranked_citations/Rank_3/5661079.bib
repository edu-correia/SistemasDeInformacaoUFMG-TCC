@inproceedings{5661079,
 abstract = {In discrete manufacturing companies, the knowledge existing throughout the product lifecycle (PL) should be managed effectively. Much explicit and implicit knowledge is produced in the different stages of product lifecycle or different production departments. In order to make the knowledge shared and reused among the workers of the enterprise, this paper focuses on: introducing the ontology into the knowledge management; proposing the multi-dimensional ontology model oriented PL; presenting the framework for multi-dimensional ontology based on product tree.},
 author = {Li, Li-shuang and Dang, Yan-zhong and Sun, Jing and Ping, Jin-yu},
 booktitle = {2010 International Conference on E-Product E-Service and E-Entertainment},
 doi = {10.1109/ICEEE.2010.5661079},
 issn = {},
 keyword = {Ontologies;Knowledge management;Welding;Merging},
 month = {Nov},
 number = {},
 pages = {1-4},
 title = {A Multi-Dimensional Ontology Model for Product Lifecycle Knowledge Management},
 volume = {},
 year = {2010}
}
