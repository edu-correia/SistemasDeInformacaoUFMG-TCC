@conference{Xu20201188,
 abstract = {Most of the existing Chinese entity relation extraction models have adopted methods which are based on character or word input. However, the word-based input method ignores potential word information in the sentence, and the method based on word input will be affected by the spread of word segmentation errors. In order to solve these problem, we introduce a lattice model that can merge words and characters input and use BiGRU instead of BiLSTM. After comparative experiments, our model achieves better results. © 2020 IEEE.},
 author = {Xu, Can and Yuan, LiPing and Zhong, Yi},
 doi = {10.1109/ITNEC48623.2020.9085019},
 journal = {Proceedings of 2020 IEEE 4th Information Technology, Networking, Electronic and Automation Control Conference, ITNEC 2020},
 note = {Cited by: 5},
 pages = {1188 - 1192},
 publication_stage = {Final},
 source = {Scopus},
 title = {Chinese Relation Extraction Using Lattice GRU},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85086258028?origin=resultslist},
 year = {2020}
}
