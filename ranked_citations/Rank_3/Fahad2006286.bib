@article{Fahad2006286,
 abstract = {The paper presents a modification of a bottom up graph theoretic image segmentation algorithm to improve its performance. This algorithm uses Kruskal's algorithm to build minimum spanning trees for segmentation that reflect global properties of the image: a predicate is defined for measuring the evidence of a boundary between two regions and the algorithm makes greedy decisions to produce the final segmentation. We modify the algorithm by reducing the number of edges required for sorting based on two criteria. We also show that the algorithm produces an over segmented result and suggest a statistical region merge process that will reduce the over segmentation. We have evaluated the algorithm by segmenting various video clips Our experimental results indicate the improved performance and quality of segmentation. © Springer-Verlag Berlin Heidelberg 2006.},
 author = {Fahad, Ahmed and Morris, Tim},
 doi = {10.1007/11919629_30},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 10},
 pages = {286 - 293},
 publication_stage = {Final},
 source = {Scopus},
 title = {A faster graph-based segmentation algorithm with statistical region merge},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33845388568?origin=resultslist},
 volume = {4292 LNCS - II},
 year = {2006}
}
