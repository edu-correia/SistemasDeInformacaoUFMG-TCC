@conference{Dan2024,
 abstract = {ViewOS is a virtual reality (VR) platform designed to merge traditional web browsing with an immersive 3D environment. Developed using Unity, it offers users the ability to switch effortlessly between conventional web interaction and VR navigation using an intuitive interface. By integrating standard web features with spatial exploration, ViewOS overcomes significant challenges faced by existing VR browsers, providing a more engaging and accessible experience. This paper examines the system's architecture, design approach, and implementation, highlighting its potential to redefine how users interact with web content in VR environments. © 2024 IEEE.},
 author = {Dan, Rama Bansidhar and Shruthi, G.R. and Srivastava, Shubhi and Bhat, Ishan S. and Reddy, Vishruth P.S.},
 doi = {10.1109/ICTBIG64922.2024.10910938},
 journal = {2024 IEEE 4th International Conference on ICT in Business Industry and Government, ICTBIG 2024},
 note = {Cited by: 0},
