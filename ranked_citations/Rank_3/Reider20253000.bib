@conference{Reider20253000,
 abstract = {A key reason for the failure of urban infrastructure projects and political measures in the tourism sector is the lack of engagement from stakeholders and decision-makers across various sectors and technical backgrounds. While digital planning applications and participation platforms can support individual aspects of the planning process, they are often restricted to their own domains. To address this challenge, an effective approach is to merge the capabilities of these systems by integrating and exchanging planning results to enhance collaboration. This paper presents the design and implementation of a Geospatial Data Integration Service (GeoDIS) that uses a Service-Oriented Architecture (SOA) with three layers to integrate and exchange data across various distributed applications, including a virtual reality (VR) platform, a spatial decision support system (SDSS), and a logistics simulation model. To meet diverse data requirements, it uses a mediator layer to integrate data from heterogeneous sources and deliver it in the required granularity, spatiality, and format. This interdisciplinary approach demonstrates the potential of advanced data integration services to elevate urban planning and logistics in the tourism sector.  © 2024 The Authors. Published by Elsevier B.V.},
 author = {Reider, Richard and Mukku, Vasu Dev and Müller, Marcel and Reggelin, Tobias and Ernst, Fred Baris and Lang, Sebastian},
 doi = {10.1016/j.procs.2025.02.024},
 journal = {Procedia Computer Science},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {3000 - 3006},
 publication_stage = {Final},
 source = {Scopus},
 title = {Design of a Data Integration and Exchange Service for Touristic City and Logistics Planning in SanlIurfa, Turkey},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105000552441?origin=resultslist},
