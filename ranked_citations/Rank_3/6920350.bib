@inproceedings{6920350,
 abstract = {To meet the requirements for power grid data sharing and model maintenance, this paper proposes a cooperative modeling scheme between transformer substations and the control center. The implementation is based on chartmodel integration in which power grid data and graphics are described interactively. The models cover the standards of the 61850 and 61970. The SCL described substation configurations such as ICD, SCD, SSD and CID files may be derived from the integrated model for intelligent substation assembling. The CIM model and the SVG graphics may be also derived from it. The integrated model is applicable for substation modeling and grid model merging. The scheme facilitates the power grid data sharing and the equipment model maintenance both in the substation and the control center.},
 author = {Jiaan, Zhang and Tao, Xu and Wei, Liang and Sheng, Xu and Lingxu, Guo and Zhigang, Huang and Guangmin, Fan},
 booktitle = {2014 4th IEEE International Conference on Information Science and Technology},
 doi = {10.1109/ICIST.2014.6920350},
 issn = {2164-4357},
 keyword = {Substations;Data models;Standards;Power grids;Graphics;Computer integrated manufacturing;collaborative modeling;chart-model integration;Common Information Model (CIM);IEC61850 model},
 month = {April},
 number = {},
 pages = {140-143},
 title = {A cooperative modeling scheme between power transformer substation and control center},
 volume = {},
 year = {2014}
}
