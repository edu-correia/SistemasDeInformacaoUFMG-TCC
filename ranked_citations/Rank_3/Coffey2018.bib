@article{Coffey2018,
 abstract = {Supervisory Control and Data Acquisition (SCADA) systems and Industrial Control Systems (ICSs) have controlled the regulation and management of Critical National Infrastructure environments for decades. With the demand for remote facilities to be controlled and monitored, industries have continued to adopt Internet technology into their ICS and SCADA systems so that their enterprise can span across international borders in order to meet the demand of modern living. Although this is a necessity, it could prove to be potentially dangerous. The devices that make up ICS and SCADA systems have bespoke purposes and are often inherently vulnerable and difficult to merge with newer technologies. The focus of this article is to explore, test, and critically analyse the use of network scanning tools against bespoke SCADA equipment in order to identify the issues with conducting asset discovery or service detection on SCADA systems with the same tools used on conventional IP networks. The observations and results of the experiments conducted are helpful in evaluating their feasibility and whether they have a negative impact on how they operate. This in turn helps deduce whether network scanners open a new set of vulnerabilities unique to SCADA systems. © 2018 Kyle Coffey et al.},
 author = {Coffey, Kyle and Smith, Richard and Maglaras, Leandros and Janicke, Helge},
 doi = {10.1155/2018/3794603},
 journal = {Security and Communication Networks},
 note = {Cited by: 77; All Open Access; Green Open Access; Hybrid Gold Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Vulnerability Analysis of Network Scanning on SCADA Systems},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85045059631?origin=resultslist},
 volume = {2018},
 year = {2018}
}
