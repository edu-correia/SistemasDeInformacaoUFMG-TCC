@inproceedings{10630490,
 abstract = {This paper introduces a new technique that merges two binary streams into a single stream and demerges them successfully using the LSB bit index. The technique is called Symbol Over Multiplexing using Bit Index Embedding (SOMBIE). The SOMBIE offers a single solution to reduce the consumed power, required bandwidth, computational load, and storage space simultaneously. The merging process allows for halving the data computation load for digital processors and the transmitted power and bandwidth for multicarrier systems. The SOMBIE also allows more symbols to be stored without increasing the storage area. The SOMBIE provides higher data security due to the scrambling nature of its operation. The circuits used to implement the SOMBIE are simple and operate in parallel mode, providing a high processing speed with minimum delay. The circuits are simulated in Simulink to merge two streams, resulting in a storage space reduction of 3.125% with a negligible error root mean squared of about $11\times 10-6$, which can be reduced further. The reduction in processing load, storage space, transmitted power, and bandwidth can be increased using multiple stages or by simple adjustments, giving the SOMBIE high flexibility to satisfy any system's specifications.},
 author = {Jabbar, Ahmed N. and Kadhim, Abdulkareem A. and Al-Muraab, Samir J.},
 booktitle = {2023 International Conference on Engineering Applied and Nano Sciences (ICEANS)},
 doi = {10.1109/ICEANS58413.2023.10630490},
 issn = {},
 keyword = {Multiplexing;Software packages;System performance;Circuits;Symbols;Process control;Bandwidth;Bit index embedding;low power transmission;narrow bandwidth communication;efficient transmission technique;green communication system;data scrambling;data compression;decrementing processing load},
 month = {Oct},
 number = {},
 pages = {107-113},
 title = {Novel Symbol over Multiplexing Technique for Transmitted Power, Bandwidth and Computational Load Reduction},
