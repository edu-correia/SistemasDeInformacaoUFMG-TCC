@inproceedings{10659389,
 abstract = {This article introduces a new search query language aimed at non-technical users that combines the simplicity of natural language queries with the precision of structured database queries. A distinctive feature of the language is the combination of the simplicity of well-known search languages, inherent in Google and Yandex, and advanced search capabilities for traversing knowledge graphs. We further detail the implementation of this language through a combination of two separate database management systems: Open Search for fulltext indexing and PostgreSQL for knowledge graph storage. In addition, we introduce a synchronization mechanism to maintain state consistency across these DBMS backends, ensuring data integrity and increasing the reliability of search results.},
 author = {Maxim, Deryugin and Andrey, Tapekhin and Artyom, Belousov and Denis, Turdakov and Alexey, Fesenko and Maxim, Ryndin},
 booktitle = {2024 Ivannikov Memorial Workshop (IVMEM)},
 doi = {10.1109/IVMEM63006.2024.10659389},
 issn = {2831-5847},
 keyword = {Knowledge based systems;Knowledge graphs;Information retrieval;Natural language processing;Database systems;Internet;Synchronization;information retrieval;query language;full-text search;knowledge base;graph database;natural language processing},
 month = {May},
 number = {},
 pages = {11-21},
 title = {Enhancing User-Centric Information Retrieval: A Unified Dual-DBMS Strategy for Integrating Full-Text and Knowledge Graph Searches},
 volume = {},
 year = {2024}
}
