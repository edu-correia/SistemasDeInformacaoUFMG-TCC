@article{JIN2025121162,
 abstract = {Pixel-level crack segmentation is vital for ensuring the safety and longevity of civil infrastructure, enabling early crack detection and preventing costly structural failures. However, existing deep learning models often struggle with the complexities of real-world crack patterns, particularly due to the wide variability in crack scales, the presence of noisy backgrounds, and limited contextual modeling and feature fusion capabilities. As a result, they frequently fail to capture fine-scale or fragmented cracks under challenging conditions. To address these challenges, we present CMHA-Net, a novel Conditional Modulation and Hierarchical Adaptive Dual-path Segmentation Network designed to improve crack segmentation performance. CMHA-Net effectively combines global context with local feature extraction through three key components. First, the Conditional Modulation Gated Convolution (CMGC) module refines convolutional features by incorporating global conditional variables, which helps balance high-level contextual understanding with fine-grained crack edge delineation. Second, the Hierarchical Adaptive Feature Modulation (HAFM) module adapts to multiple scales by fusing multi-level features and using partitioning, multi-scale processing, and gated attention to capture subtle crack features while suppressing background noise. Lastly, the Dual-Stream Cascade Segmentation Head (DSCS) merges features from both Transformer and CNN branches to preserve both global context and local details, leading to more accurate segmentation. Extensive experiments on four public datasets demonstrate that CMHA-Net achieves state-of-the-art (SOTA) accuracy and robustness across a range of crack scenarios. The model exhibits strong generalization and excels in fine-detail segmentation in critical civil infrastructure applications, all while maintaining the efficiency necessary for real-world deployment in both industrial and embedded environments.},
 author = {Yutao Jin and Hui Liu and Xu Cheng and Chunyu Du},
 doi = {https://doi.org/10.1016/j.engstruct.2025.121162},
 issn = {0141-0296},
 journal = {Engineering Structures},
 keyword = {Crack segmentation, Adaptive segmentation, Civil infrastructure, Transformer-CNN hybrid, Conditional modulation},
 pages = {121162},
 title = {Crack segmentation in civil infrastructure using conditional modulation and hierarchical dual-path networks},
 url = {https://www.sciencedirect.com/science/article/pii/S0141029625015536},
 volume = {343},
 year = {2025}
}
