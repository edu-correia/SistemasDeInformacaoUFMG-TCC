@conference{Chen2024388,
 abstract = {Based on the rapid development of network technology, from the perspective of constructing an OMO (Online-Merge-Offline) learning space and combining virtual and real experimental teaching modes, this paper mainly studies the practical application method of the OMO education model. The integration of various teaching functions in the OMO learning space provides learners with more convenient services and allows teaching staff to implement teaching more efficiently. Relying on the virtual simulation experiment platform combining virtual and real, modern information technology and experimental teaching are deeply integrated, and a specific experimental teaching scheme is given, which better solves the problems of the limitation of the experimental platform, the single experimental teaching mode and the lack of experimental teaching resources. At the same time, the breadth and depth of experimental teaching content are expanded, the time and space of experimental teaching are extended, and the quality and level of experimental teaching are improved.  © 2024 ACM.},
 author = {Chen, Ning and Chen, GuoRong and Zhou, Wei and Yu, AnNing and Zhang, Mi and Yao, Yao and Hu, Yan and Ran, Dan},
 doi = {10.1145/3675812.3675876},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 0},
 pages = {388 - 392},
 publication_stage = {Final},
 source = {Scopus},
 title = {OMO learning space construction and experimental teaching mode design - Take the course "Cloud Network System Integration" as an example},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85202593790?origin=resultslist},
 year = {2024}
}
