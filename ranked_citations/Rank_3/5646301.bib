@inproceedings{5646301,
 abstract = {This paper aim to depict a structure among verbs merge syntagmantic knowledge into its existing paradigmatic knowledge. After analysing 200 sentences from BNC, 4 semantic roles were added to its structure, i.e. Agent, Object, Direction and Experiencer. Valence values of verbs in the structure are described in 3 aspects: the number of arguments they are able to combine with; the semantic roles these arguments plays and semantic restriction on features of these arguments (see table IV). These features can help build syntagmantic relations between verbs and nouns, which can be used in word sense disambiguity and machine translation field.},
 author = {Wen Zhuge and Jingyu Hua},
 booktitle = {2010 Third International Symposium on Knowledge Acquisition and Modeling},
 doi = {10.1109/KAM.2010.5646301},
 issn = {},
 keyword = {Semantics;Pragmatics;WordNet;Valence Theory;Verb structure},
 month = {Oct},
 number = {},
 pages = {128-131},
 title = {The construction of a supplement structure among verbs to WordNet based on valence theory},
 volume = {},
 year = {2010}
}
