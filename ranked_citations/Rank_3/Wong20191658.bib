@article{Wong20191658,
 abstract = {In this paper, a cognitive decision-making architecture for dynamic airspace sectorization (CDAS) to handle increasing traffic flow and provide an efficient decision making process for operations is presented. The main objective of CDAS is to determine optimal 3-D sector shapes such that the conflicting workloads of air traffic controllers are balanced along with marginal changes to sector shapes over a time horizon. CDAS broadly comprises two major components, namely, a cognitive engine and a metacognitive decision maker. The cognitive engine includes an airspace sectorization model and a multi-objective optimization solver. The problem of 3-D dynamic airspace resectorization is cast as a multi-objective optimization problem with safety constraints and is solved using the non-dominated sorting genetic algorithm II. The metacognitive decision maker utilizes the Pareto-optimal solutions obtained from the cognitive engine along with the air traffic control requirements and predicted traffic pattern to identify the best solution that can be implemented along with a rule to decide on when-to-do a resectorization when needed. A detailed performance evaluation of CDAS is presented using the actual flight data over the Singapore flight information region. The results clearly indicate that CDAS provides an efficient dynamic sectorization solution over the existing solution of split-and-merge of a specific sector to handle heavy traffic. © 2000-2011 IEEE.},
 author = {Wong, Cheryl Sze Yin and Sundaram, Suresh and Sundararajan, Narasimhan},
 doi = {10.1109/TITS.2018.2833151},
 journal = {IEEE Transactions on Intelligent Transportation Systems},
 note = {Cited by: 19},
