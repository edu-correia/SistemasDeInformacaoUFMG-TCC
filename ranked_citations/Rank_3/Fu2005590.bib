@conference{Fu2005590,
 abstract = {An efficient method of Chinese handwritten address character string segmentation and recognition is presented First, an address string image is presegmented into several radicals using stroke extraction and stroke mergence. Next, the radical series obtained by pre-segmentation merge into different character image series according to different merging paths. After that, the optimal merging path is selected using recognition and semantic information. The recognition information is given by the character classifier. The semantic information is obtained from address database which contains 180,000 address items. Finally, the optimal recognition results of the character image series which are combined by radical series according to the optimal merging paths are obtained, In experiments on 897 mail images, the proposed method achieves correct rate of 85 percent while the error rate is 15 percent. © 2005 IEEE.},
 author = {Fu, Qiang and Ding, X.Q. and Liu, C.S. and Jiang, Yan},
 doi = {10.1109/ICDAR.2005.15},
 journal = {Proceedings of the International Conference on Document Analysis and Recognition, ICDAR},
 note = {Cited by: 15},
 pages = {590 - 594},
 publication_stage = {Final},
 source = {Scopus},
 title = {A hidden Markov model based segmentation and recognition algorithm for chinese handwritten address character strings},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33750940721?origin=resultslist},
 volume = {2005},
 year = {2005}
}
