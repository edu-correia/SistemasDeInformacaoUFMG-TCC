@article{10.1145/3757654,
 abstract = {Grounded in two years of in-person and virtual participant observation with gig worker activists in Ecuador and the transnational network of activists of which they are part, this paper undertakes an ''ethnography of scale'' to concretely account for how the activists represent and manage a global-scale movement. I highlight three scalar devices observed: the First International Gig Workers' Congress, coordinated protest actions, and a book of gig worker testimonies. I argue that although the activists construct their movement as global, it is not scalable in the sense of being able to uniformly expand without changing the nature of the project. Rather, scale is enacted through mutually transforming engagements. This paper contributes an empirical investigation of transnational gig worker resistance contextualized in the Global South, and a theoretical nuance of critiques of scalability from STS through dialogue with CSCW concepts and empirical observations.},
 address = {New York, NY, USA},
 articleno = {CSCW473},
 author = {Pei, Lucy},
 doi = {10.1145/3757654},
 issue_date = {November 2025},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {keywords{gig economy, labor organizing, nonscalability theory}, platform work, scale and scalability, social movements, transnational activism},
 month = {October},
 number = {7},
 numpages = {22},
 publisher = {Association for Computing Machinery},
 title = {Scalar Devices of a Global Movement of Gig Worker Activists},
 url = {https://doi-org.ez27.periodicos.capes.gov.br/10.1145/3757654},
 volume = {9},
 year = {2025}
}
