@inproceedings{5966826,
 abstract = {A new image fusion algorithm, based on lattice filters and spatial frequency, to merge ERS and multispectral SPOT data is presented. First, ERS and SPOT data are decomposed into their subbands with analysis lattice filter structure. The detail subbands are decomposed into blocks, and these blocks are merged according to a predefined Spatial Frequency based rule. Finally, the fused image is obtained by synthesis lattice filter structure.},
 author = {Kaplan, N. H. and Erer, I.},
 booktitle = {Proceedings of 5th International Conference on Recent Advances in Space Technologies - RAST2011},
 doi = {10.1109/RAST.2011.5966826},
 issn = {},
 keyword = {Lattices;Filter banks;Wavelet transforms;Image fusion;Image reconstruction;Filtering algorithms;image fusion;lattice filters;spatial frequency;multispectral data;SAR data},
 month = {June},
 number = {},
 pages = {213-218},
 title = {A new subband domain method for spatial frequency based image fusion},
 volume = {},
 year = {2011}
}
