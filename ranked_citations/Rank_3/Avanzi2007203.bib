@article{Avanzi2007203,
 abstract = {In this paper we introduce scalar multiplication algorithms for several classes of elliptic and hyperelliptic curves. The methods are variations on Yao's scalar multiplication algorithm where independent group operations are shown in an explicit way. We can thus merge several group operations and reduce the number of field operations by means of Montgomery's trick. The results are that scalar multiplication on elliptic curves in even characteristic based on point halving can be improved by at least 10% and the performance of Koblitz curves by 25% to 32%. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Avanzi, Roberto Maria},
 doi = {10.1007/978-3-540-74462-7_15},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 6; All Open Access; Bronze Open Access},
 pages = {203 - 219},
 publication_stage = {Final},
 source = {Scopus},
 title = {Delaying and merging operations in scalar multiplication: Applications to curve-based cryptosystems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/38149001441?origin=resultslist},
 volume = {4356 LNCS},
 year = {2007}
}
