@conference{Chen2024,
 abstract = {Detecting sea fog through remote sensing imagery is crucial for ensuring maritime safety and efficient navigation. This study introduces an innovative sea fog detection method utilizing a multi-channel fusion Transformer (MF-Trans), applied to water color remote sensing images. Water color remote sensing satellites can provide multiple channel information, making it an ideal platform for ocean and coast observations. The multi-channel data is paramount in understanding complex atmospheric conditions, especially in the context of sea fog detection. Our method employs a multi-modal fusion Transformer, a novel approach in this field. The Transformer architecture, renowned for its capability in handling sequential data, has been adapted here to effectively merge and interpret the diverse spectral data from the Himawari-8 channels. This fusion process is critical in delineating the subtle features of sea fog that might be missed by single-channel analysis. Experiments show promising sea fog detection results with an F1-score of 0.88 and a critical success index of 0.78. The results of this approach have been outstanding, demonstrating significant improvements in detection accuracy and consistency compared to traditional methods. The multi-channel fusion Transformer not only excels in clear-cut cases of sea fog but also shows remarkable proficiency in complex scenarios where sea fog is mixed with other atmospheric conditions.  © 2024 IEEE.},
 author = {Chen, K.R. and Zhou, Y. and Li, X.F.},
 doi = {10.1109/PIERS62282.2024.10618208},
 journal = {2024 Photonics and Electromagnetics Research Symposium, PIERS 2024 - Proceedings},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Coastal Sea Fog Detection Based on Multi-channel Fusion Transformer},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85201981045?origin=resultslist},
 year = {2024}
}
