@article{BOURDIN2005650,
 abstract = {We have built two algorithms especially designed for the mapping of the intra-cluster medium emissivity and temperature, as seen by the XMM-Newton satellite using the European Photon Imaging Camera (EPIC). In both algorithms the searched parameter is firstly estimated within square resolutions elements at different spatial resolutions, then its variations are coded using Haar wavelet coefficients. The de-noised map of the searched parameter is finally obtained from structures selected as significant in the scale-space, while non-significant contributions are lowered using a regularisation process. Gas emissivity and temperature maps obtained using these algorithms have evidenced perturbations, anisotropies, shocked and disturbed regions within the two merging clusters A1750 and A3921, and have confirmed that the different component of each cluster were interacting with each other (see also Belsole, E., J-L. Sauvageot, Pratt G.W., Bourdin, H. Merging clusters of galaxies observed with XMM-Newton. Adv. Space Res., 2005 (this conference) (astro-ph/0501377)).},
 author = {H. Bourdin and A. Bijaoui and J.-L. Sauvageot and E. Belsole and E. Slezak},
 doi = {https://doi.org/10.1016/j.asr.2005.01.104},
 issn = {0273-1177},
 journal = {Advances in Space Research},
 keyword = {Wavelets, Spectral mapping, X-Ray extended sources, Observational cosmology, Clusters of galaxies, Intra-cluster medium},
 note = {Clusters of Galaxies: New Insights from XMM-Newton, Chandra and INTEGRAL},
 number = {4},
 pages = {650-655},
 title = {Wavelet mapping of the intra-cluster medium emissivity and temperature structures within clusters of galaxies observed by XMM-Newton},
 url = {https://www.sciencedirect.com/science/article/pii/S0273117705001602},
 volume = {36},
 year = {2005}
}
