@inproceedings{6975338,
 abstract = {Analysis and planning of Enterprise Architectures (EA) is a complex task for stakeholders. The change of one architecture element has impact on multiple other elements because of manifold relationships and interactions between them. The interactive cockpit approach presented in this paper supports stakeholders planning and analyzing EAs and to tackle the intrinsic complexity. This approach supplies a cockpit with multiple viewpoints to put relevant information side-by-side without losing the context combined with interaction functionality. In this paper, we develop such cockpit starting with relevant use cases, describing a potential design based on well-established foundations in EA modeling, and outline an exemplary usage scenario.},
 author = {Jugel, Dierk and Schweda, Christian M.},
 booktitle = {2014 IEEE 18th International Enterprise Distributed Object Computing Conference Workshops and Demonstrations},
 doi = {10.1109/EDOCW.2014.14},
 issn = {2325-6605},
 keyword = {Object oriented modeling;Computer architecture;Planning;Business;Data visualization;Information systems;Visualization;Enterprise Architecture;Analysis;Planning},
 month = {Sep.},
 number = {},
 pages = {33-40},
 title = {Interactive Functions of a Cockpit for Enterprise Architecture Planning},
 volume = {},
 year = {2014}
}
