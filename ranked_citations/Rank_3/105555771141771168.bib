@article{10.5555/771141.771168,
 abstract = {A traditional classroom introductory programming class has been enhanced into a hybrid class with strong classroom and Internet components. The course no longer has a textbook, but relies on a course management system developed from a MOO as an alternate information source. The MOO provides many of the facilities of a course management system but excels in its ability to be customized in a more fundamental way. This allows it to provide services not usually associated with course management software.There is something of a controversy between the proponents of classroom instruction and online learning. The classroom activities of this course and its online system complement each other with differing strengths and weaknesses. The result is a course that has the best of both worlds.},
 address = {Evansville, IN, USA},
 author = {Hill, Curt},
 issn = {1937-4771},
 issue_date = {October 2002},
 journal = {J. Comput. Sci. Coll.},
 month = {October},
 number = {1},
 numpages = {10},
 pages = {134–143},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {A media enhanced introductory programming class},
 volume = {18},
 year = {2002}
}
