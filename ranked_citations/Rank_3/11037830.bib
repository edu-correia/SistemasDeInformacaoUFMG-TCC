@inproceedings{11037830,
 abstract = {Community detection is a fundamental and important problem in network science, as community structures often reveal both topological and functional relationships between different components of the complex system. However, the existing label propagation-based community detection methods have the shortcomings of unstable partitioning results and strong randomness. To address this issue, we propose an improved label propagation algorithm based on network internal structure (ISLPA). The algorithm initially divides nodes into cluster sets according to their degree and the internal relations of the network, merges some of them based on their similarities and correlations and finally forms community structure. Empirically, we conduct experiments on real networks form various fields. The results show that ISLPA leads to detect the communities effectively and accurately.},
 author = {Chen, Ge and Zhang, Ting},
 booktitle = {2025 6th International Conference on Computer Science, Engineering, and Education (CSEE)},
 doi = {10.1109/CSEE64583.2025.00013},
 issn = {},
 keyword = {Computer science;Correlation;Education;Clustering algorithms;Complex networks;Partitioning algorithms;Complex systems;Sports;Dolphins;community detection;label propagation;complex network},
 month = {Feb},
 number = {},
 pages = {30-34},
 title = {A Label Propagation-Based Community Detection Integrating Similarity and Correlation},
 volume = {},
 year = {2025}
}
