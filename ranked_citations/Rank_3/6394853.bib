@inproceedings{6394853,
 abstract = {In the area of Deep Web data integration, it is a key issue to efficiently and accurately build result output pattern according to uses' query. However, it is the crucial problem to improve efficiency and precision of result output pattern generating that resolving repeat pattern matching and data heterogeneity. This paper proposes the approach of Deep Web data integration oriented result output pattern building. On the basis of the conflicts and conflict resolving rules between any two data sources, the approach gives the rules for conflict integration over multi-sources. According to the result patterns and conflicts between result patterns, this paper gives the mechanism and algorithm of result output pattern building which can effectively resolve the problems of repeat pattern matching and data heterogeneity and lay a good foundation for Deep Web data merging.},
 author = {Anxiang, Ma and Xiaohong, Zhang and Bin, Zhang and Kening, Gao and Daming, Sun},
 booktitle = {2012 International Conference on Computer Science and Service System},
 doi = {10.1109/CSSS.2012.535},
 issn = {},
 keyword = {Buildings;Pattern matching;Particle separators;Merging;Algorithm design and analysis;Semantics;Deep Web data integration;result pattern;result output pattern;conflicts integration},
 month = {Aug},
 number = {},
 pages = {2153-2156},
 title = {Deep Web Data Integration Oriented Result Output Pattern Building Approach},
 volume = {},
 year = {2012}
}
