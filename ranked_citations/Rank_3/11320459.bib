@inproceedings{11320459,
 abstract = {This work proposes a missing ingredient for explaining Transformer neural machine translation predictions. Usually, the Transformer decoder reads the encoder memory in every single time step. This behavior can lead to an incorrect explanation of Transformer-based neural machine translation when interpreting one-to-many word alignment. We assume that the behavior of the decoder is read-then-generate, where the encoder contributes much information in read steps (e.g., the first word of phrases) and contributes less in generation steps (e.g., the next words predicted after a read step). Using the gradient attribution method, we found that the contribution of the decoder self-attention and the decoder cross-attention reveals this behavior. We tested our assumption on our word-to-character dataset and yielded an improvement in terms of word alignment error rate.},
 author = {Porkaew, Peerachet and Supnithi, Thepchai},
 booktitle = {2025 20th International Joint Symposium on Artificial Intelligence and Natural Language Processing (iSAI-NLP)},
 doi = {10.1109/iSAI-NLP66160.2025.11320459},
 issn = {2831-4565},
 keyword = {Translation;Error analysis;Neural machine translation;Transformers;Decoding;Artificial intelligence;natural language processing;automatic translation;word alignment;transformer machine translation},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Understanding Decoder Read-Then-Generate Behavior in Transformer Neural Machine Translation},
 volume = {},
 year = {2025}
}
