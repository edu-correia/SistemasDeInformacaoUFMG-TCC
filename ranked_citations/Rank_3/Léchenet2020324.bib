@article{Léchenet2020324,
 abstract = {Liveness analysis is a standard compiler analysis, enabling several optimizations such as deadcode elimination. The SSA form is a popular compiler intermediate language allowing for simple and fast optimizations. Boissinot et al. [7] designed a fast liveness analysis by combining the specific properties of SSA with graph-theoretic ideas such as depth-first search and dominance. We formalize their approach in the Coq proof assistant, inside the CompCertSSA verified C compiler. We also compare experimentally this approach on CompCert’s benchmarks with respect to the classic data-flow-based liveness analysis, and observe performance gains. © 2020, The Author(s).},
 author = {Léchenet, Jean-Christophe and Blazy, Sandrine and Pichardie, David},
 doi = {10.1007/978-3-030-51054-1_19},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 4; All Open Access; Green Open Access; Hybrid Gold Open Access},
 pages = {324 - 340},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Fast Verified Liveness Analysis in SSA Form},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85088240035?origin=resultslist},
 volume = {12167 LNAI},
 year = {2020}
}
