@inproceedings{5382372,
 abstract = {Deforming bubbles under water are important phenomena that we always encounter in our daily lives. In this paper, we present a real-time bubble simulation framework based on shallow water simulation (SWS), spherical vortex and boundary element method (BEM). We first solve the shallow water equations to simulate the water volume and the free surface. We then adopt the flow field of spherical vortices to affect the bubbles' motion and interaction. BEM is later used to simulate the bubbles' deformation when they rise in water. In addition, we propose a method to simulate the splitting and merging of bubbles, as well as illustrating how to handle deformable objects of different scales in BEM. We finally report extensive results generated on a standard PC to demonstrate the algorithm's realism and performance.},
 author = {Zhanxin Yang and Xubo Yang and Jie Tan},
 booktitle = {2009 IEEE Youth Conference on Information, Computing and Telecommunication},
 doi = {10.1109/YCICT.2009.5382372},
 issn = {},
 keyword = {Deformable models;Computational modeling;Boundary element methods;Navier-Stokes equations;Real time systems;Merging;Computer graphics;Water conservation;Surface waves;Laboratories;Computer Graphics;Real time systems;Bubble Dynamics;Shallow Water Equations;Spherical Vortex;Boundary Element Methods},
 month = {Sep.},
 number = {},
 pages = {263-266},
 title = {Real-time simulation of deformable bubble underwater},
 volume = {},
 year = {2009}
}
