@inproceedings{4541549,
 abstract = {This paper presents a novel high-throughput algorithm for the H.264/AVC transforms. The symmetry property of transforms in H.264/AVC has been utilized. The straight forward method merges the conventional two-stage row-column algorithm into one-stage operation. By analysis and comparison, the proposed algorithm consumes less arithmetic operations (additions and shifts) and has less latency delay. It can complete any type of transforms of H.264/AVC in only one clock cycle. Besides, its regular processing element is reconfigurable. This method is suitable for reconfigurable hardware implementation.},
 author = {Jianjun Li and Ahamdi, M.},
 booktitle = {2008 IEEE International Symposium on Circuits and Systems (ISCAS)},
 doi = {10.1109/ISCAS.2008.4541549},
 issn = {2158-1525},
 keyword = {Throughput;Automatic voltage control;Transform coding;Decoding;Arithmetic;Delay;Discrete cosine transforms;Image coding;Video compression;Algorithm design and analysis},
 month = {May},
 number = {},
 pages = {840-843},
 title = {Realizing high throughput transforms of H.264/AVC},
 volume = {},
 year = {2008}
}
