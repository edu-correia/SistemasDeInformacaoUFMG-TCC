@conference{Mohandespour2015853,
 abstract = {We discuss how the idea of unicast 1+1 protection can be efficiently extended to protect multicast connections in optical backbone networks. Particularly, we show how to achieve instantaneous failure recovery and cost efficiency by allowing intermediate nodes to merge their incoming flows by a simple network code, i.e., logical OR operation. Under simple network coding, the problem of minimum cost multicast 1+1 protection is formulated as a 2-connectivity problem. In order to solve this problem, an optimal ILP and three efficient heuristic algorithms are proposed. Simulation results on real-world networks show that the average cost of our best heuristic algorithm is only 2.6 % higher compared to the optimal ILP solution. © 2015 IEEE.},
 author = {Mohandespour, Mirzad and Kamal, Ahmed E.},
 doi = {10.1109/ICCNC.2015.7069457},
 journal = {2015 International Conference on Computing, Networking and Communications, ICNC 2015},
 note = {Cited by: 1},
 pages = {853 - 857},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multicast 1+1 protection: The case for simple network coding},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84928041865?origin=resultslist},
 year = {2015}
}
