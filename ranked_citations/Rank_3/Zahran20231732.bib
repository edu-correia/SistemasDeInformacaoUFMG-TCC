@conference{Zahran20231732,
 abstract = {Information Technology and Operational Technology convergence refers to the integration and merge of IT and OT systems within an organization. Several protocols are commonly used in IT/OT convergence to facilitate communication and data exchange between IT and OT systems. It is imperative to understand how both systems are linking and exchanging data to be able to examine potential security breaches. In this study, we will discuss some of the common protocols used to achieve this convergence. We will include the known strengths and weaknesses of each. This will be considered an initial foundation to study potential security breaches and countermeasures for IT/OT convergence. © 2023 IEEE.},
 author = {Zahran, Bassam and Abu Zahra, Fuad},
 doi = {10.1109/CSCE60160.2023.00285},
 journal = {Proceedings - 2023 Congress in Computer Science, Computer Engineering, and Applied Computing, CSCE 2023},
 note = {Cited by: 1},
 pages = {1732 - 1737},
 publication_stage = {Final},
 source = {Scopus},
 title = {IT/OT Convergence Protocols: MQTT, OPC, and REST},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85191152801?origin=resultslist},
 year = {2023}
