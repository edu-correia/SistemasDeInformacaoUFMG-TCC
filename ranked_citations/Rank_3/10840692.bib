@inproceedings{10840692,
 abstract = {This paper focuses at the achievement of AI with loT to improve the communication and control of smart devices in different sectors. Therefore, different machine learning models such as DQN, SVM, Random Forest, PCA, CNNs, and LSTM networks are used to enhance the smart home automation, industrial loT, health, and smart city sector to enhance the efficiency, and accuracy rates of the consumers. In smart homes AI models control energy and light based on people's activities in their home, say researchers. In industries, more enhanced version of machine learning enhances predictive maintenance as well the improvement of processes. As for the healthcare industry, it avails itself of AI in the detection of anomalies and in recommending a patient-specific treatment plan. This is a key aspect since in the smart cities AI models perform traffic and waste management, improving their effectiveness and, at the same time, their sustain ability. Therefore, the outcomes provide the evidence of the effectiveness of integrating AI and loT in order to expand the notions of the more effective and responsible systems. Recognizing that there is still work to be done on providing structure for the application these technologies collectively under head Artificial Intelligence as well as loT, at the conclusion of the paper, the author presses for more work that will endeavor to sharpen the described models as well as search for other opportunities that might exist for these technologies.},
 author = {Pareek, Shashank and Almusawi, Muntather and Al-Farouni, Mohammed and Kumar, Raman and Kaur, Kamaljeet and Dasi, Shivakrishna},
