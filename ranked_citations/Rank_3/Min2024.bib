@article{Min2024,
 abstract = {Emerging Zoned Namespace (ZNS) SSDs, providing the coarse-grained zone abstraction, hold the potential to significantly enhance the cost efficiency of future storage infrastructure and mitigate performance unpredictability. However, existing ZNS SSDs have a static zoned interface, making them in-adaptable to workload runtime behavior, unscalable to underlying hardware capabilities, and interfering with co-located zones. Applications either under-provision the zone resources yielding unsatisfied throughput, create over-provisioned zones and incur costs, or experience unexpected I/O latencies.We propose eZNS, an elastic-ZNS interface that exposes an adaptive zone with predictable characteristics. eZNS comprises two major components: a zone arbiter that manages zone allocation and active resources on the control plane, and a hierarchical I/O scheduler with read congestion control and write admission control on the data plane. Together, eZNS enables the transparent use of a ZNS SSD and closes the gap between application requirements and zone interface properties. Our evaluations over RocksDB demonstrate that eZNS outperforms a static zoned interface by 17.7% and 80.3% in throughput and tail latency, respectively, at most.  © 2024 Copyright held by the owner/author(s).},
 author = {Min, Jaehong and Zhao, Chenxingyu and Liu, Ming and Krishnamurthy, Arvind},
 doi = {10.1145/3653716},
 journal = {ACM Transactions on Storage},
 note = {Cited by: 12; All Open Access; Hybrid Gold Open Access},
 number = {3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {eZNS: Elastic Zoned Namespace for Enhanced Performance Isolation and Device Utilization},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85196503303?origin=resultslist},
 volume = {20},
