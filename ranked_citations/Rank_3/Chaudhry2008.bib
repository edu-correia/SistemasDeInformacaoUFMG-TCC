 publication_stage = {Final},
 source = {Scopus},
 title = {Entity lifecycle management for OKKAM},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84885819765?origin=resultslist},
 volume = {422},
 year = {2008}
}
