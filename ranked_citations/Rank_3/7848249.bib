@inproceedings{7848249,
 abstract = {Design of non-uniform modified discrete fourier transform filter bank (MDFT FB), which is obtained from a uniform MDFT FB, is proposed in this work. Here, each non-uniform channel is shaped by merging the nearby channels of the uniform MDFT FB. The proposed design of the non-uniform MDFT FB is checked utilizing the alias cancellation among the channels, distortion and flatness condition of the channels. A condition is derived to find the channels when merged with adjacent channels, will cause aliasing in M channels. In the design and implementation of the proposed non-uniform MDFT FB, the structure of the uniform MDFT filter is preserved and hence all the advantages of MDFT FB over the DFT filter bank, are guaranteed.},
 author = {Sakthivel, V and Elias, Elizabeth},
 booktitle = {2016 IEEE Region 10 Conference (TENCON)},
 doi = {10.1109/TENCON.2016.7848249},
 issn = {2159-3450},
 keyword = {Filter banks;Maximum likelihood detection;Nonlinear filters;Discrete Fourier transforms;Prototypes;Distortion;Finite impulse response filters},
 month = {Nov},
 number = {},
 pages = {1419-1424},
 title = {Design of non-uniform modified DFT filter banks},
 volume = {},
 year = {2016}
}
