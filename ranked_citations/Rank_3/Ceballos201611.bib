@conference{Ceballos201611,
 abstract = {Business Process Diagrams (BPDs) provide a rich graphical expressiveness for modeling not only business processes but also the development of collective human activities. In Multiagent platforms, BPDs has been used for decoupling the modeling of agent behavior from its implementation. Additionally, the annotation of BPD actions and events with conjunctive queries has opened the door for monitoring process development by querying a knowledge base. We study the properties of this annotation scheme for the refinement of activity diagrams through the removal of redundant nodes, the detection of disjoint alternative paths and the merge/split of event nodes. Copyright © 2016 for this paper by its authors.},
 author = {Ceballos, Hector G. and Fernandez, Eduardo and Espinosa, Jorge},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 0},
 pages = {11 - 21},
 publication_stage = {Final},
 source = {Scopus},
 title = {Refining semantically annotated business process diagrams},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85016423935?origin=resultslist},
 volume = {1807},
 year = {2016}
}
