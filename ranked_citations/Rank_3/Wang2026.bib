@conference{Wang2026,
 abstract = {Traditional Direction of Arrival estimation methods degrade markedly under non-ideal conditions. Deep learning offers a robust data-driven alternative; however, the rapidly expanding method landscape calls for a structured overview. To address this need, this review first proposes a systematic classification framework for deep learning-based DOA techniques. It encompasses architectures from foundational CNNs to advanced Transformers, discussing their respective strengths in feature extraction and signal reconstruction. With a particular focus on the emerging paradigm of hybrid model-data fusion, this review analyses how methods like DA-MUSIC and SubspaceNet merge theoretical interpretability with data-driven adaptability to enhance performance. Comparative analyses indicate that these models achieve superior estimation accuracy and resolution probability, particularly at low SNR. Finally, by summarizing critical challenges and outlining future research directions in lightweight design, interpretability, and cross-scenario generalization, this paper provides a comprehensive roadmap. This review aims to guide researchers in developing the next generation of robust, efficient, and intelligent DOA estimation systems. © 2026 SPIE.},
 author = {Wang, Wenjie and Li, Mingyan and Liu, Lei},
 doi = {10.1117/12.3110534},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Deep Learning for Direction of Arrival Estimation: A Review of Hybrid Model-Data Fusion},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105034716592?origin=resultslist},
 volume = {14134},
