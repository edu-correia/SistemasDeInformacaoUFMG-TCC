@conference{Zhou2021119,
 abstract = {Based on the professional content knowledge aggregation service platform built, this paper proposes a new form of learning model combining online and offline, and makes use of the big data analysis of users' learning behavior on the online knowledge service platform to provide personalized learning recommendation, knowledge interpretation, knowledge answering and other knowledge services to offline users. Offline users can realize quick navigation from offline learning to online knowledge service platform through intelligent identification technologies such as panoramic formula identification and retrieval, and enjoy various knowledge and learning services provided online. This paper discusses the evolution of learning models, the construction of new forms of learning models, the comparison between traditional learning models and new forms of learning models, and puts forward three innovative advantages of online and offline learning interaction, so as to promote learners' learning through differential knowledge services.  © 2021 IEEE.},
 author = {Zhou, Lijuan and Liang, Zhongju and Wu, Zhao and Mei, Baorui and Nie, Gaoqing},
 doi = {10.1109/ICCST53801.2021.00035},
 journal = {Proceedings - 2021 International Conference on Culture-Oriented Science and Technology, ICCST 2021},
 note = {Cited by: 0},
 pages = {119 - 123},
