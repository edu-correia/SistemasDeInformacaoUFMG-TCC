@inproceedings{7368760,
 abstract = {The purpose of designing a corporate memory within an industrial-based organization is to facilitate user access to critical knowledge held in this memory. So, the objective of corporate semantic web service architecture that we propose is to include knowledge in domain ontology and to make them easily accessible by users. In our context, knowledge contained in the ontology concerns industrial medical domain. Industrial medicine helps prevent abuses of workers (accidents, illnesses, etc.) both physically and mentally. The paper problematic treats two aspects: the first is how to construct the static component of the corporate memory defined by ontology to satisfy users. The second is how to realize the dynamic component to exploit the corporate memory by a web service. This web service is semantic because it is merged from both: the semantic web and the web service paradigms. In order to check the validity of this architecture, we have implemented a case.},
 author = {Gueraich, Sonia and Bouzobra, Bouchra},
 booktitle = {2015 First International Conference on New Technologies of Information and Communication (NTIC)},
 doi = {10.1109/NTIC.2015.7368760},
 issn = {},
 keyword = {Ontologies;Service-oriented architecture;Computer architecture;Semantic Web;Buildings;Semantics;Corporate memory;semantic web service;domain ontology web service},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Corporate memory managed by semantic web service},
 volume = {},
 year = {2015}
}
