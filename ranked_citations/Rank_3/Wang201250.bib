@article{Wang201250,
 abstract = {The traditional ontology mapping technology has the very good performance when processes between the lightweight ontology, but regarding large-scale ontology with many entities and complex relations, the mapping quality and the mapping efficiency is not very good. This paper proposed a method of alignment candidate reduction based on passing message. The method used passing message cluster' thought to cluster the entities of two ontologies, entities in the same class as the candidate set of mapping. The clustering results can be directly as m: n mapping output between two light-scale ontologies. With the large-scale ontologies produces clustering results can be output as mapping candidate sets, then use the other matching strategies to produce more accurate alignments. Experimental results show that the method by reduction candidate set when dealing with large-scale ontology mapping, the mapping of the recall and precision rate has improved.},
 author = {Wang, Rujuan and Yang, Feng and Lu, Shuai and Lu, Lei},
 doi = {10.4156/jdcta.vol6.issue5.7},
 journal = {International Journal of Digital Content Technology and its Applications},
 note = {Cited by: 0},
 number = {5},
 pages = {50 - 57},
 publication_stage = {Final},
 source = {Scopus},
 title = {Alignment candidate reduction based on passing message of cluster method},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84859336263?origin=resultslist},
 volume = {6},
 year = {2012}
}
