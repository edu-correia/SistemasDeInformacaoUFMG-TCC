@inproceedings{10496931,
 abstract = {Educational collaboration plays a vital role in fostering STEAM innovation talents and is an essential force in promoting regional educational integration. This study constructed a C-STEAM collaborative teaching model for the Guangdong-Hong Kong-Macao Greater Bay Area and verified its effects through cross-regional inter-school collaborative teaching empirical case studies. The results show that C-STEAM education collaboration helps to improve students' attitude, and cultural understanding and heritage literacy, accompanied by a moderate level of cognitive load. Interviews with teachers also confirmed the significant value of this approach for both teacher and student development. Existing challenges and future research directions are also highlighted.},
 author = {Li, Tingting and Zhang, Xiuxiang and Lai, Richard and Zhang, Mingwei and Zhong, Chaocheng and Zhan, Zehui},
 booktitle = {2023 5th International Workshop on Artificial Intelligence and Education (WAIE)},
 doi = {10.1109/WAIE60568.2023.00033},
 issn = {},
 keyword = {Technological innovation;Conferences;Education;Merging;Force;Collaboration;Cultural differences;C-STEAM;collaborative teaching;cultural understanding and heritage literacy;Guangdong-Hong Kong-Macao Greater Bay area},
 month = {Sep.},
 number = {},
 pages = {141-145},
 title = {Internet+ Technology Empowering C-STEAM Educational Collaboration in the Greater Bay Area: a Cross-Regional Project of “Chinese Ancient Hollowed Windows”*},
 volume = {},
 year = {2023}
}
