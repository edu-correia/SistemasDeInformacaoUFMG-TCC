@conference{Weichenhain2019171,
 abstract = {To transform a systematic model of project management (PM) into a powerful discrete event model (DEM), these two concepts must be merged for mapping and simulation. To achieve this the modeling of PM, its complex tasks must be abstracted, and a decomposition of the entire model into subsystems including the interactions and their components has to be carried out. A merge can only take place if a common level of detailing and abstraction can be identified. In a DEM, the complexity is put into the connection of the subsystems. The behavior of the individual subsystems, however, is kept simple [1]. © 2019 IEEE},
 author = {Weichenhain, Maxi and Fengler, Wolfgang and Streitferdt, Detlef},
 doi = {10.1109/COMPSAC.2019.10202},
 journal = {Proceedings - International Computer Software and Applications Conference},
 note = {Cited by: 2},
 pages = {171 - 176},
 publication_stage = {Final},
 source = {Scopus},
 title = {How to bring project management of embedded systems to an appropriate level of abstraction for a discrete event model},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85072673480?origin=resultslist},
 volume = {2},
 year = {2019}
}
