@incollection{KIRWAN2026171,
 abstract = {The practical side of convergence theory appears in how smart cities integrate digital systems, infrastructure, and human activity into adaptive environments that behave like living systems. Through the merging of IoT networks, connected data, and advanced AI, urban systems evolve into dynamic organisms able to manage complexity across macro, meso, and micro scales. This alignment brings together governance, infrastructure, and everyday life into a unified management framework that reduces noise and improves efficiency. Edge computing illustrates this by moving processing closer to the source, cutting latency, energy use, and bandwidth demand. Within this multilayered architecture, AI applications operate across six interdependent functions—governance, mobility, energy, infrastructure, environment, and community. While each can be studied alone, their interconnections reveal the true DNA of the smart city and how data, systems, and intelligence converge to shape its design, operation, and evolution. Key technologies and strategic frameworks enable AI to act across structural, operational, and strategic levels of scale and scope. As cities learn and adapt through data convergence, they move toward self-regulating ecosystems that balance technological efficiency with ethical governance, human well-being, and planetary health. Keywords AI Governance; Applied Convergence; Artificial Intelligence; Big Data; Cloud; Connectivity; Edge Computing; General AI; Machine Learning; Narrow AI; Resilience; Sensors; Singularity; Strong AI; Superintelligence; Systems Integration},
 author = {Christopher Grant Kirwan and Fu Zhiyong},
 booktitle = {Smart Cities and Artificial Intelligence (Second Edition)},
 doi = {https://doi.org/10.1016/B978-0-443-23621-1.00007-2},
 edition = {Second Edition},
 editor = {Christopher Grant Kirwan and Fu Zhiyong},
 isbn = {978-0-443-23621-1},
 pages = {171-199},
 publisher = {Elsevier},
 series = {Smart Cities},
 title = {Chapter 8 - Smart city functions},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443236211000072},
