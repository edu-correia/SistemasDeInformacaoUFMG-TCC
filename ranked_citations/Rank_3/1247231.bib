@inproceedings{1247231,
 abstract = {We consider monitoring the quality of compressed video transmitted over a packet network from the perspective of a network service provider. We estimate the mean-squared error (MSE) caused by packet loss, by examining only the received video bitstream. We merge the best aspects of two of our previously reported methods, with the goal of creating a low-complexity quality monitor that will be able to process many streams simultaneously in the network.},
 author = {Reibman, A.R. and Vaishampayan, V.},
 booktitle = {Proceedings 2003 International Conference on Image Processing (Cat. No.03CH37429)},
 doi = {10.1109/ICIP.2003.1247231},
 issn = {1522-4880},
 keyword = {Monitoring;Intelligent networks;Video compression;Streaming media;Decoding;Loss measurement;Data mining;Transform coding;Telecommunication traffic;Discrete cosine transforms},
 month = {Sep.},
 number = {},
 pages = {III-261},
 title = {Low complexity quality monitoring of MPEG-2 video in a network},
 volume = {3},
 year = {2003}
}
