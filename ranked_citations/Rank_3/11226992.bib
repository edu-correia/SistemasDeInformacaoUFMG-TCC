@article{11226992,
 abstract = {The growing proliferation of the Internet of Things (IoT) with diverse connectivity requirements has gained significant interest in the research field and is witnessing a surge of interest in blending different classes of wireless networks, combining performance-oriented and wide-area connectivity. This integration merges fifth-generation (5G) high-performance capabilities with LoRaWAN’s low-energy and long-range consumption characteristics to address a broader range of IoT applications. Based on recent scientific literature, this study analyzes the novel architectures, implementations, and recent use cases that make up these two technologies. Among the most notable discoveries are novel designs that span from RAN modules interoperating with unified core components to implementations that embed eNodeB services directly within LoRaWAN gateways. By adopting these implementations, it is possible to achieve simpler deployments, lower expenses, and significantly improved network functionalities for numerous IoT use cases. Integrating both technologies provides extended coverage, increased backhaul capacity, and enhanced security, enabling robust end-to-end communication for diverse use cases such as smart cities, industrial IoT, precision agriculture, and healthcare.},
 author = {Delgado Brito, Omar-Darío and Pace, Pasquale and de Rango, Floriano},
 doi = {10.1109/ACCESS.2025.3629386},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {5G mobile communication;LoRaWAN;Internet of Things;Logic gates;Security;Costs;Smart cities;Low-power wide area networks;Servers;Real-time systems;Internet of Things (IoT);5G;long-range wide area network (LoRaWAN);system integration;hybrid architecture;multi-radio access technology (multi-RAT);low power wide area network (LPWAN);massive IoT;gateway architecture;scalability},
 month = {},
 number = {},
 pages = {191144-191163},
 title = {A Review on the Confluence of 5G and LoRaWAN: Architectures, Use Cases, Taxonomies, Open Issues, and Research Avenues},
 volume = {13},
 year = {2025}
}
