@article{10246784,
 abstract = {Webpage analysis is carried out for various purposes such as webpage segmentation. The goal of webpage segmentation is to divide a page into blocks that have similar elements. A fusion approach that combines different analyses is required in order to obtain high segmentation accuracy. In this paper, we propose a new fusion model for webpage segmentation, where we (1) merge webpage content into basic-blocks by simulating human perception; and, (2) identify similar blocks using semantic text similarity and regroup these similar blocks as fusion blocks. This approach is applied to three public datasets and evaluated by comparing with state-of-the-art algorithms. The results characterize that our proposed approach outperforms other existing webpage segmentation methods, in terms of accuracy.},
 author = {Sajjadi Ghaemmaghami, Saeedeh Sadat and Miller, James},
 doi = {10.13052/jwe1540-9589.2042},
 issn = {1544-5976},
 journal = {Journal of Web Engineering},
 keyword = {Semantics;Webpage analysis;webpage segmentation;semantic text similarity;Gestalt Law of grouping},
 month = {June},
 number = {4},
 pages = {963-992},
 title = {A New Semantic Approach to Improve Webpage Segmentation},
 volume = {20},
 year = {2021}
}
