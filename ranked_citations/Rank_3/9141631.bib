@inproceedings{9141631,
 abstract = {The correctness and reliability of data is the most basic element of data storage system. It is primary for data security to ensure the correctness and reliability of data. The dynamic heterogeneous redundancy model has received more and more attention in recent years, and it has a good effect in defending known and unknown vulnerabilities. However, In the process of applying the model to database security, the researchers have found the inconsistent reads and writes of heterogeneous databases resulting in the difficulty of accurate data synchronization. To solve this problem, an improved method of heterogeneous database operation language decision merging is proposed, and the correctness, security and effectiveness of this means is tested. The experimental results show that this method can ensure the security of the system and reduce the false alarm.},
 author = {Tang, Yuan and Zhang, Zheng and Zhao, YuFeng and Liu, ZhenWu},
 booktitle = {2020 IEEE 5th Information Technology and Mechatronics Engineering Conference (ITOEC)},
 doi = {10.1109/ITOEC49072.2020.9141631},
 issn = {},
 keyword = {Databases;Data models;Synchronization;Memory;Web servers;Encryption;dynamic heterogeneous redundancy model;database security protection;decision merging;heterogeneous database synchronization},
 month = {June},
 number = {},
 pages = {1290-1295},
 title = {Improved Method for Dynamic Heterogeneous Redundant Model Database},
 volume = {},
 year = {2020}
}
