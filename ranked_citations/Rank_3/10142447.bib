@inproceedings{10142447,
 abstract = {In recent years, the use of new technologies in the healthcare industry has substantially increased. In particular, this research study explores the potential benefits of virtual reality (VR) and augmented reality (AR). With the use of these technologies, difficult judgments can be made by using the information and specialized expertise. Given that maintaining the health is among the most fundamental human aspirations, the healthcare industry affects every one of us. This paper discusses how advances in artificial intelligence, ARvR and blockchain technology will spur innovation and transform the healthcare sector. This research study witnesses the unparalleled growth in tailored, intelligent healthcare that is accessible everywhere at a reasonable cost when these technologies merge. The fusion of mobile healthcare and support, AR/VR for medical training, and customized pharmaceuticals based on health data from sensors implanted in the human body can give therapies that are specifically tailored to a person’s genetic makeup. The acceptance and integration of VR in the healthcare industry are also discussed in this paper. It examines the development, the benefits, and the drawbacks, and offers viewpoints on the potential expansion and effects of these technologies in the future. The use of AR and VR in healthcare services may lead to problems with huge data availability and trustworthy sharing. Some systems that use software-type algorithms to simulate human cognitive processes in healthcare decision-making handle the privacy of a patient’s data. The dentist and the support staff oversee managing data, which carries a risk of data privacy and security violations. This study examines how the use of VR and AR is allowing decentralized care, personalized treatment, and a new generation of intelligent detection and prevention.},
 author = {Mehta, Kapil and Aayushi and Singh, Chamkaur and Chugh, Himani and Kumar, Manibhushan},
 booktitle = {2023 7th International Conference on Intelligent Computing and Control Systems (ICICCS)},
