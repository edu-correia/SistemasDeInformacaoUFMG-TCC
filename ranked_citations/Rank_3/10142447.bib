 issn = {2768-5330},
 keyword = {Industries;Training;Data privacy;Technological innovation;Medical services;Transforms;Sensor fusion;Virtual Reality;Augmented Reality;Healthcare;Services;Revolution;Medical Training;IoT;Blockchain},
 month = {May},
