@article{RUAN2026112268,
 abstract = {Semidefinite programming (SDP) is widely recognized as one of the most effective methods for deriving the tightest lower bounds for optimal power flow (OPF) problems. In this paper, an enhanced semidefinite relaxation model that integrates tighter λ-based quadratic convex relaxation, valid inequalities, and optimality-based bound tightening algorithm into the SDP framework is presented to further tighten the lower bounds of the feasible region for OPF problems, effectively combining the advantages of these recent advancements. Additionally, using chordal decomposition within the complex matrix formulation of SDP can significantly accelerate the solution time. Notably, for the same SDP problem, different chordal decompositions can result in varying solution time. To address this problem, this paper proposes a clique graph merging strategy within the complex matrix SDP framework, which assesses clique sizes and the computational burden on interior-point solvers, while also reducing the need for hyperparameter tuning and enhancing solution efficiency. Finally, the proposed hybrid relaxation model is evaluated using different test cases, demonstrating its effectiveness in computational performance.},
 author = {Zhaojun Ruan and Libao Shi},
 doi = {https://doi.org/10.1016/j.epsr.2025.112268},
 issn = {0378-7796},
 journal = {Electric Power Systems Research},
 keyword = {Optimal power flow, Semidefinite decomposition, Convex relaxation, Complex matrix},
 pages = {112268},
 title = {An enhanced semidefinite relaxation model combined with clique graph merging strategy for AC optimal power flow problem},
 url = {https://www.sciencedirect.com/science/article/pii/S0378779625008557},
 volume = {251},
 year = {2026}
}
