@conference{Ge2022,
 abstract = {The advent of persistent memory(PM) technologies provides an opportunity for building persistent key-value stores by making the best of its data persistence and access performance close to DRAM. In recent years, researchers have proposed many key-value store designs, and these improvements come from the database and operating system communities. This paper particularly introduces the optimization schemes and improvements of various index structures, such as hash tables, B+ trees and LSM-Trees on PM. It discusses their highlights and trade-offs in write efficiency, data persistence, crash consistency and concurrency control. Finally, this paper provides researchers with optimization directions to cultivate persistent key-value stores deeply.  © 2022 IEEE.},
 author = {Ge, Xuran and Liu, Yang and Wu, Lizhou and Ou, Yang and Chen, Zhiguang and Xiao, Nong},
 doi = {10.1109/DSIT55514.2022.9943868},
 journal = {2022 5th International Conference on Data Science and Information Technology, DSIT 2022 - Proceedings},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {PM-based Persistent Key Value Stores: A Survey},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85143125199?origin=resultslist},
 year = {2022}
}
