@article{PAGE201132,
 abstract = {There is no question in any nursing leader's mind that the healthcare revolution during this first part of the 21st century is characterized by the integration of innovative technology solutions into practice. There are two parallel transformations occurring simultaneously and merging at the core of patient care. The first is the vast changes in the reimbursement models toward value-based purchasing, creating new models of care delivery and a quest for outcomes, that are only scratching the surface today.},
 author = {Cecilia K. Page},
 doi = {https://doi.org/10.1016/j.mnl.2011.07.005},
 issn = {1541-4612},
 journal = {Nurse Leader},
 number = {5},
 pages = {32-34},
 title = {Leveraging Technology for Excellence},
 url = {https://www.sciencedirect.com/science/article/pii/S1541461211001820},
 volume = {9},
 year = {2011}
}
