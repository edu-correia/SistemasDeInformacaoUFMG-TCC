@inproceedings{11450731,
 abstract = {The paradigm of semantic communication offers a promising path to advance video compression beyond the diminishing returns of traditional syntactic standards. This paper proposes a novel hybrid video codec that synergistically integrates deep learning for semantic extraction with a conventional codec for residual refinement. Our framework processes a GOP through an end-to-end learned encoder, combining a CNN-based autoencoder and a transformer to extract a compact, multi-dimensional LSR. This LSR is transmitted and decoded to reconstruct an initial video sequence. To compensate for any lost textual details, the residual between the original and reconstructed GOP is calculated at the encoder and efficiently compressed using a VVC codec. The final high-quality reconstruction is achieved at the decoder by combining the semantic output with the decoded residual. Trained with an MSE loss, the proposed method is evaluated for rate-distortion performance. Results demonstrate that our approach consistently outperforms state-of-the-art VVC and HEVC standard codecs, confirming the efficacy of merging semantic priors with syntactic residual coding for superior compression efficiency.},
 author = {Fernando, Thanuj and Pollwaththage, Nimesh and Samarathunga, Prabhath and Jayasinghe, Udara and El Gemayel, Joseph and Fernando, Anil},
 booktitle = {2025 IEEE 19th International Conference on Industrial and Information Systems (ICIIS)},
 doi = {10.1109/ICIIS69028.2026.11450731},
 issn = {2690-3423},
 keyword = {Video coding;Computational modeling;Autoencoders;Video sequences;Syntactics;Semantic communication;Encoding;Video codecs;Standards;Videos;CNN-Transformer Autoencoder;Hybrid Video Coding;Semantic Communication;Versatile Video Coding},
 month = {Jan},
 number = {},
 pages = {79-84},
 title = {A Hybrid Semantic-Syntactic Video Codec with CNN-Transformer Encoding and VVC Residual Coding},
 volume = {19},
 year = {2026}
}
