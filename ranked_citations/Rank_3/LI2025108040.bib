@article{LI2025108040,
 abstract = {The paper introduces the PolySepAnalyzor system, which integrates advanced imaging techniques with NeuroSymbolic artificial intelligence (AI) reasoning to evaluate separation purity and recovery rates automatically. Combining a custom particle disperser and optimized lighting, the system captures high-resolution images for processing via three modules: image segmentation, NeuroSymbolic AI reasoning and evaluation indicator calculation. This system can address the lack of precision and automation in traditional tribo-electrostatic separation (TES) analysis methods, thereby promoting the recycling of polymers. The NeuroSymbolic AI Reasoning Module, a core innovation, combines attribute recognition with differentiable reasoning, focusing on particle attributes to reduce data dependency and simplify annotation. This approach enables the efficient recognition of new particle types by updating reasoning logic; hence, it is highly suitable for analyzing diverse particle samples in TES. Leveraging its robust reasoning capability, our system demonstrates exceptional performance. For untrained polymer particle recognition, it achieves maximum purity and recovery errors of merely −0.78 % and −4.45 % respectively, significantly outperforming state-of-the-art neural systems like YOLO v8 (−68.11 % and −96.54 %). For trained particle types, recognition accuracy matches conventional algorithms. PolySepAnalyzor presents a novel system that merges hardware innovation with NeuroSymbolic AI reasoning for the analysis of polymer particle recovery.},
 author = {Yikang Li and Zhigang Wang and Ming Chen and Junyuan Cao and Nan Cai and Yanlong Peng and Yisheng Zhang and Hongshen Zhang},
 doi = {https://doi.org/10.1016/j.psep.2025.108040},
 issn = {0957-5820},
 journal = {Process Safety and Environmental Protection},
 keyword = {Waste plastic, NeuroSymbolic AI, Tribo-electrostatic separation, Deep learning},
 pages = {108040},
 title = {Automated TES analysis for polymer recycling via NeuroSymbolic AI},
 url = {https://www.sciencedirect.com/science/article/pii/S0957582025013072},
 volume = {204},
 year = {2025}
}
