@article{Gómez20201229,
 abstract = {Scalability in modeling has many facets, including the ability to build larger models and domain-specific languages (DSLs) efficiently. With the aim of tackling some of the most prominent scalability challenges in model-based engineering (MBE), the MONDO EU project developed the theoretical foundations and open-source implementation of a platform for scalable modeling and model management. The platform includes facilities for building large graphical DSLs, for splitting large models into sets of smaller interrelated fragments, to index large collections of models to speed-up their querying, and to enable the collaborative construction and refinement of complex models, among other features. This paper reports on the tools provided by MONDO that Ikerlan, a medium-sized technology center which in the last decade has embraced the MBE paradigm, adopted in order to improve their processes. This experience produced as a result a set of model editors and related technologies that fostered collaboration and scalability in the development of wind turbine control applications. In order to evaluate the benefits obtained, an on-site evaluation of the tools was performed. This evaluation shows that scalable MBE technologies give new growth opportunities to small- and medium-sized organizations. © 2020, Springer-Verlag GmbH Germany, part of Springer Nature.},
 author = {Gómez, Abel and Mendialdua, Xabier and Barmpis, Konstantinos and Bergmann, Gábor and Cabot, Jordi and de Carlos, Xabier and Debreceni, Csaba and Garmendia, Antonio and Kolovos, Dimitrios S. and de Lara, Juan},
 doi = {10.1007/s10270-020-00776-8},
 journal = {Software and Systems Modeling},
 note = {Cited by: 8},
 number = {5},
 pages = {1229 - 1261},
 publication_stage = {Final},
 source = {Scopus},
 title = {Scalable modeling technologies in the wild: an experience report on wind turbines control applications development},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85078349386?origin=resultslist},
 volume = {19},
 year = {2020}
}
