@inproceedings{1598962,
 abstract = {While unstructured P2P systems have been embraced widely in mobile ad-hoc networks (MANETs), the applicability of structured approaches like distributed hash tables (DHTs) to such settings remains controversial. Existing research delivers promising empirical results addressing the concerns about performance, complexity, and reliability, but does not analyze the principles of combining DHTs and MANETs. This paper identifies and discusses the fundamental implications of non-infrastructural networks for DHTs and analyzes solutions to these challenges},
 author = {Heer, T. and Gotz, S. and Rieche, S. and Wehrle, K.},
 booktitle = {Fourth Annual IEEE International Conference on Pervasive Computing and Communications Workshops (PERCOMW'06)},
 doi = {10.1109/PERCOMW.2006.16},
 issn = {},
 keyword = {Mobile ad hoc networks;Protocols;Peer to peer computing;Routing;Broadcasting;Systems engineering and theory;Computer science;Mobile computing;Ad hoc networks;Computer network reliability},
 month = {March},
 number = {},
 pages = {6 pp.-178},
 title = {Adapting distributed hash tables for mobile ad hoc networks},
 volume = {},
 year = {2006}
}
