@article{CUNNINGHAM2023100597,
 abstract = {Immunological mechanisms, both alone and in combination, are associated with a broad range of psychiatric disorders encompassing autoimmune, autoinflammatory disorders but also genetic, metabolic, or other immunological disorders. Early treatment improves the outcome for autoimmune disorders, but early diagnosis is more difficult when isolated psychiatric symptoms are manifestations of autoimmunity. Treatment of these cases must encompass integrated models of disease, as both systemic autoimmunity and psychological processes influence mental health. Several challenges need to be overcome to efficiently merge psychiatric and somatic disease paradigms and medical care ranging from language and conceptual barriers to organizational barriers. Since 2015, the Immunopsychiatry team at Uppsala University has developed a collaborative multidisciplinary approach to improve and integrate care for patients with moderate to severe psychiatric disorders. Based on this experience, we have outlined the obstacles to be overcome in taking steps forward to achieve the long-term goal of understanding and early detection and identification of treatable immunological conditions within the psychiatric patient population; the described framework of evaluations and work-flow may serve as a model for other centers.},
 author = {Janet L. Cunningham and Gunnel Nordmark and David Fällmar and Simon Cervenka and Maike Gallwitz and Roland Säll and Peter T. Schmidt and Johan Rönnelid and Barbro Persson and Andreas Kindmark and Joachim Burman},
 doi = {https://doi.org/10.1016/j.jadr.2023.100597},
 issn = {2666-9153},
 journal = {Journal of Affective Disorders Reports},
 keyword = {Precision medicine, Psychiatry, Immunopsychiatry, Autoimmunity, Limbic encephalitis, CSF, Integrated care},
 pages = {100597},
 title = {Experiences in implementing immunopsychiatry in real life},
 url = {https://www.sciencedirect.com/science/article/pii/S2666915323001361},
 volume = {13},
 year = {2023}
}
