@article{11262250,
 abstract = {The health condition and remaining useful life (RUL) prediction of lithium-ion batteries are of vital importance to the safety of energy supply systems. Nonetheless, existing methods for health status and RUL prediction fail to effectively reveal the correlation among features during the charging and discharging process. Moreover, they neglect the temporal relationship of the features themselves. Besides, there are obvious limitations in current temporal network methods for predicting the degradation process of different instances, as they are not adequate in capturing long-term dependence relationships. To address these issues, this study introduces a two-stage MINE-graph-Mamba (MGM) method. In the first instance, the mutual information neural estimation (MINE) is employed to extract the correlation among features to serve as edge information of the graph. These relationships are then processed through a graph attention mechanism while merging new correlation information and feeding this combination into the Mamba to extract temporal relations and generate feature representations. The first stage models the multidimensional time-series features of each charge–discharge cycle, producing a unified charge–discharge feature representation. In the second stage, these representations are input into the MGM model to obtain multilevel feature evolution representations that describe the entire degradation process, enabling accurate life prediction. Experimental validation using real battery data demonstrates that the proposed method significantly improves health status and RUL predictions, outperforming existing data-driven approaches.},
 author = {Yu, Bing and Yang, Zhiming and Yu, Yang and Xiang, Gang},
 doi = {10.1109/TIM.2025.3635303},
 issn = {1557-9662},
 journal = {IEEE Transactions on Instrumentation and Measurement},
 keyword = {Batteries;Mutual information;Predictive models;Degradation;Feature extraction;Correlation;Estimation;Data models;Accuracy;Mathematical models;Graph neural network (GNN);Mamba;mutual information neural estimation (MINE);remaining useful life (RUL);state of health (SOH)},
 month = {},
 number = {},
 pages = {1-16},
 title = {Two-Stage Temporal and Correlation Analysis: Enhancing Battery Health and Life Prediction With MINE-Graph-Mamba},
 volume = {74},
 year = {2025}
}
