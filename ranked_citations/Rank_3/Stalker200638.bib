@conference{Stalker200638,
 abstract = {Devolved ontology is an approach to ontology modelling and (co-) evolution which was developed in connection with agile partnerships. Inviting parallels between agile partnerships and the context of the Pragmatic Web suggest that this has potential value in realising the vision of the Pragmatic Web [SMD06]. This is especially clear in their respective uses of ontologies and in particular the demands made of supporting structures. We motivate and introduce the devolved ontology model and show how to use this to promote semantic alignment and thereby support communication. © 2006 Gesellschaft fur Informatik (GI). All rights reserved.},
 author = {Stalker, Iain Duncan and Mehandjiev, Nikolay},
 journal = {Lecture Notes in Informatics (LNI), Proceedings - Series of the Gesellschaft fur Informatik (GI)},
 note = {Cited by: 7},
 pages = {38 - 52},
 publication_stage = {Final},
 source = {Scopus},
 title = {A devolved ontology model for the pragmatic web},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85087952079?origin=resultslist},
 volume = {P-89},
 year = {2006}
}
