@article{10.1145/3749097,
 abstract = {Issues deriving from the opaque behaviour of prediction-effective, yet non-interpretable, machine learning predictors are being studied and analysed since many decades. One of the main research branches consists of adopting anyway the unintelligible models, thanks to their predictive performance, but queueing to the learning workflow a dedicated technique aimed at post-hoc extracting human-interpretable symbolic knowledge. Following this research line, a growing number of very different knowledge-extraction procedures have been designed over the last four decades, making it difficult for end-users and researches to orient themselves towards the selection of the most suitable one. Accordingly, this survey aims at providing a guide to perform an aware selection of the knowledge-extraction techniques that most probably fit a given task.},
 address = {New York, NY, USA},
 articleno = {61},
 author = {Sabbatini, Federico},
 doi = {10.1145/3749097},
 issn = {0360-0300},
 issue_date = {February 2026},
 journal = {ACM Comput. Surv.},
 keyword = {explainable AI, machine learning, symbolic knowledge extraction},
 month = {September},
 number = {3},
 numpages = {36},
 publisher = {Association for Computing Machinery},
 title = {Four Decades of Symbolic Knowledge Extraction from Sub-Symbolic Predictors. A Survey},
 url = {https://doi.org/10.1145/3749097},
 volume = {58},
 year = {2025}
}
