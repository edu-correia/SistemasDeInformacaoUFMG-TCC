@inproceedings{11434051,
 abstract = {Customer segmentation is an important approach in the ever-evolving world of marketing and data-based business operations, allowing organizations to develop a better understanding of distinct customer segments and act on this information. The proposed review elaborates on established approaches to customer segmentation through the integration of Principal Component Analysis (PCA), RFM (Recency, Frequency, Monetary) analysis, and K-Means clustering. PCA reduces data dimensions by removing redundancy, improving clustering efficiency. RFM provides a quantifiable measure of customer value and engagement. K-Means then segments customers based on behavioural patterns. The review outlines the theoretical aspects, their application, challenges, and each techniques relative performance. Lastly, the paper outlines future areas for research and notes the need to implement hybrid models, interfacing with deep learning techniques, as well as addressing inherent limitations such as interpretability and dynamic customer behaviour.},
 author = {Katyal, Prawahan and Singhal, Shefali and Gupta, Chirag and Malik, Aditya and Sharma, Hiten},
 booktitle = {2025 3rd International Conference on Advances in Computation, Communication and Information Technology (ICAICCIT)},
 doi = {10.1109/ICAICCIT68829.2025.11434051},
 issn = {},
 keyword = {Deep learning;Consumer behavior;Profitability;Redundancy;Merging;Organizations;Computational efficiency;Information and communication technology;Principal component analysis;Systematic literature review;Customer Segmentation;K-Means Clustering;RFM Analysis;Machine Learning;Customer Behavior},
 month = {Oct},
 number = {},
 pages = {869-875},
 title = {Customer Segmentation and Clustering Techniques: An Analysis for Product Recommendation},
 volume = {1},
 year = {2025}
}
