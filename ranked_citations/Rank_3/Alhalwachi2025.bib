@conference{Alhalwachi2025,
 abstract = {Food and beverage organizations depend on fast, accurate recruitment operations; however, many HR departments still rely on spreadsheet- and document-driven workflows that are prone to data inconsistency, manual errors, version-control failures, and weak governance. This study, conducted with a regional food-chain organization (JBG), investigates how an AI-enabled automation framework can reduce processing time, improve accuracy, and strengthen compliance across recruitment workflows that previously depended on Microsoft Excel and Word. Using a mixed-method case study approach, the research combines stakeholder interviews, document and data audits, and workflow analysis to identify error drivers and automation opportunities. The implemented solution integrates (i) rule-based automation for data validation and standardized data entry controls, (ii) Robotic Process Automation (RPA) to orchestrate repetitive workflow steps (intake, verification, routing, and status updates), (iii) Natural Language Processing (NLP) for CV parsing and structured candidate profile extraction, (iv) supervised machine learning for candidate classification and screening support, and (v) recommendation-based candidate ranking to prioritize applicants against job requirements. Contract and offer-letter generation is automated through template-driven document rendering with parameterized fields and compliance checks, supported by audit trails and controlled access. Findings indicate measurable improvements in cycle time, reduction in rework caused by manual corrections, and improved consistency of HR records and generated documents. The study contributes an implementation blueprint and replicable AI-enabled HR automation architecture that supports a phased transition from document-centric administration toward governed, analytics-ready recruitment systems. © 2025 IEEE.},
 author = {Alhalwachi, Layla and Ahmed, Roaa Mohamed and Ahmed, Nabeela and Alkhater, Nader and Soni, Anand and Slade, Habel},
 doi = {10.1109/ICCA66035.2025.11430837},
 journal = {International Conference on Computer and Applications, ICCA 2025 - Proceedings},
