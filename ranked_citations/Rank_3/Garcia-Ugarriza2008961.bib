@conference{Garcia-Ugarriza2008961,
 abstract = {Image segmentation is a fundamental task in many computer vision applications. In this paper, we present a novel unsupervised color image segmentation algorithm that utilizes color gradients, dynamic thresholding and texture modeling algorithms in a split and merge framework. To this effect, pixels without edges are clustered and labeled individually to identify the preliminary image content. Pixels that contain higher gradients are further classified by utilizing an iterative dynamic threshold generation technique and an appropriate entropy based texture model. The proposed algorithm was demonstrated successfully on an extensive database of images and benchmarked favorably against prior art. ©2008 IEEE.},
 author = {Garcia-Ugarriza, Luis and Saber, Eli and Amuso, Vincent and Shaw, Mark and Bhaskar, Ranjit},
 doi = {10.1109/ICASSP.2008.4517771},
 journal = {ICASSP, IEEE International Conference on Acoustics, Speech and Signal Processing - Proceedings},
 note = {Cited by: 14},
 pages = {961 - 964},
 publication_stage = {Final},
 source = {Scopus},
 title = {Automatic color image segmentation by dynamic region growth and multimodal merging of color and texture information},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/51449084855?origin=resultslist},
 year = {2008}
}
