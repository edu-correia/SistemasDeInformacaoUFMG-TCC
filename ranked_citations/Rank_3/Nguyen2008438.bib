@conference{Nguyen2008438,
 abstract = {In Information Retrieval (IR) systems, many published researches propose solutions for document indexing to improve performance of query search task. To retrieve data of complex queries relating to semantic information, including semantic attributes to traditional index is necessary and important. This paper introduces a proposal to develop semantic index as well as heuristics of its application such as merging and extracting so that they can support IR to be stronger and more useful. The experimentation with English documents shows that approach with mechanisms is feasible and it can affect IR development in future. © 2008 ACM.},
 author = {Nguyen, Thanh and Phan, Tuoi},
 doi = {10.1145/1497308.1497389},
 journal = {Proceedings of the 10th International Conference on Information Integration and Web-based Applications and Services, iiWAS 2008},
 note = {Cited by: 1},
 pages = {438 - 441},
 publication_stage = {Final},
 source = {Scopus},
 title = {The effect of semantic index in Information Retrieval development},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70349148126?origin=resultslist},
 year = {2008}
}
