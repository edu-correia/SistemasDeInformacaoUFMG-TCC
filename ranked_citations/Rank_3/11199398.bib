@article{11199398,
 abstract = {This article presents a single object tracker that incorporates scene understanding, referred to as SU-STTrack, which explicitly encodes the contextual information by the given or multimodal large language model (MLLM) generated descriptions of the tracking scene. SU-STTrack merges the linguistic contextual prompts encoded using a pretrained large language model (LLM) and visual features using a dual attention mechanism to strengthen tracking robustness and adaptability, where channel attention blocks (CABs) are fixed within a multimodality feature fusion process. The experience replay strategy is further proposed, to maintain long-term tracking performance by periodically refreshing the tracking template with accumulated experiences, preventing the model from catastrophic forgetting. SU-STTrack enables both vision-only and vision-language (VL) tracking tasks to share the same parameters. Through extensive experiments on VL datasets (TNL2K, LaSOT, and LaSOT${}_{\text{ext}}$) and vision-only datasets (UAV123, NfS, and OTB100), our tracker achieves 0.569 on TNL2K, 0.628 on the challenging LaSOT, 0.528 on LaSOT${}_{\text{ext}}$, 0.646 on UAV123, 0.603 on NfS, and 0.718 on OTB100 in terms of the area under the curve (AUC) metric with the inference speed of 36.3 FPS. SU-STTrack normally surpasses state-of-the-art methods and shows superior generalization ability across diverse and challenging tracking scenarios11The code and models are available at https://indtlab.github.io/projects/SU-STTrack..},
 author = {Liu, Xuelin and Zhou, Huiyu and Dong, Junyu and Xiao, Jingjing and Dong, Xinghui},
 doi = {10.1109/TAI.2025.3601075},
 issn = {2691-4581},
 journal = {IEEE Transactions on Artificial Intelligence},
 keyword = {Target tracking;Semantics;Visualization;Accuracy;Transformers;Object tracking;Feature extraction;Robustness;Linguistics;Large language models;Large language models (LLMs);scene understanding;single object tracking (SOT);template update},
 month = {May},
 number = {5},
 pages = {2523-2534},
 title = {Single Target Tracking With Contextual Prompts in Scene Understanding},
 volume = {7},
 year = {2026}
}
