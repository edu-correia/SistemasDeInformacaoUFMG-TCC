@article{10.1145/3803553,
 abstract = {Mixed-precision neural network (MPNN) that utilizes just enough data width for the neural network processing is an effective approach to meet the stringent resources constraints including memory and computing of MCUs. Nevertheless, there is still a lack of sub-byte and mixed-precision SIMD operations in MCU-class ISA and the limited computing capability of MCUs remains underutilized, which further aggravates the computing bound encountered in neural network processing. As a result, the benefits of MPNNs cannot be fully unleashed. In this work, we propose to pack multiple low-bitwidth arithmetic operations within a single instruction multiple data (SIMD) instructions in typical MCUs, and then develop an efficient convolution operator by exploring both the data parallelism and computing parallelism in convolution along with the proposed SIMD packing. Finally, we further leverage Neural Architecture Search (NAS) to build a HW/SW co-designed MPNN design framework, namely MCU-MixQ. This framework can optimize both the MPNN quantization and MPNN implementation efficiency, striking an optimized balance between neural network performance and accuracy. According to our experiment results, MCU-MixQ achieves 2.1\texttimes{} and 1.4\texttimes{} speedup over CMix-NN and MCUNet respectively under the same resource constraints. MCU-MixQ is also open sourced on GitHub.1},
 address = {New York, NY, USA},
 articleno = {41},
 author = {Gong, Junfeng and Cheng, Long and Nian, Jiawei and Liu, Cheng and Li, Huawei},
 doi = {10.1145/3803553},
 issn = {1539-9087},
 issue_date = {May 2026},
 journal = {ACM Trans. Embed. Comput. Syst.},
 keyword = {Low-bitwidth quantization, mixed-precision neural network, HW/SW co-optimization, MCUs},
 month = {May},
 number = {3},
 numpages = {20},
 publisher = {Association for Computing Machinery},
 title = {MCU-MixQ: A HW/SW Co-optimized Mixed-precision Neural Network Design Framework for MCUs},
 url = {https://doi.org/10.1145/3803553},
 volume = {25},
 year = {2026}
}
