@article{Du2026,
 abstract = {Traditional collaborative planning models often overlook the influence of Human-driven Vehicles (HVs) on traffic flow and the compliance of Connected Vehicles (CVs). Consequently, the collaborative planning strategies generated by these models are prone to jump phenomena, lacking stability and failing to effectively guide practical cooperative traffic operations. To address these issues, this study proposes a hierarchical collaborative decision-making framework. The upper-layer model identifies potential interaction objects within a 5-second horizon. By calculating the expected acceleration of CV drivers using a driver behavior intention recognition model, and integrating HV risk and trajectory prediction models, the framework predicts traffic flow states within the cooperative area and determines potential interaction objects. The lower-layer model constructs a collaborative planning strategy based on longitudinal vehicle acceleration. Utilizing the potential interaction objects determined by the upper-layer model, the strategy is formulated by comprehensively considering compliance constraints, spatial constraints, and interaction stability constraints. Simulation results indicate that CV compliance is a critical factor in the utility of collaborative planning strategies; the impact of CV compliance intensifies with increasing penetration rates. At high penetration rates (>80%), ignoring compliance results in traffic efficiency that is even lower than that achieved without any collaborative planning strategy. Furthermore, the selection of interaction objects and the dynamic behavior of HVs significantly influence strategy effectiveness, particularly at low-to-medium penetration rates (<60%), where insufficient CV numbers lead to frequent strategy variations, thereby compromising driving safety, traffic efficiency, and stability. The collaborative planning strategy proposed in this study effectively reduces severe conflicts and significantly enhances traffic capacity at high penetration rates (>60%); however, the utility of the strategy gradually diminishes as road traffic flow increases. © 2026 Elsevier Ltd.},
 author = {Du, Zijun and Lyu, Nengchao and Wen, Jiaqiang and Wang, Yugang},
 doi = {10.1016/j.aei.2026.104632},
 journal = {Advanced Engineering Informatics},
 note = {Cited by: 0},
