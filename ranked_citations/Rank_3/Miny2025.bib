@conference{Miny2025,
 abstract = {This paper presents a novel approach for the semantic comparison of Asset Administration Shells (AAS), i.e., digital twins within the context of Industry 4.0. As digital twins gain importance in optimizing industrial processes, ensuring interoperability and accurate versioning of AAS becomes critical. We propose a method that focuses on object model-level comparisons rather than mere syntactic differences, enabling a more meaningful assessment of semantic equivalence. Our findings highlight the challenges associated with traditional comparison methods and suggest a comprehensive framework for enhancing AAS versioning and integrity verification. © 2025 IEEE.},
 author = {Miny, Torben and Heppner, Sebastian and Garmaev, Igor and Ristin, Marko and Otto, Bjorn and Braunisch, Nico and Kleinert, Tobias and Van De Venn, Hans Wernher and Wollschlaeger, Martin},
 doi = {10.1109/ETFA65518.2025.11205541},
 journal = {IEEE International Conference on Emerging Technologies and Factory Automation, ETFA},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic Comparison of Asset Administration Shells},
 type = {Conference paper},
