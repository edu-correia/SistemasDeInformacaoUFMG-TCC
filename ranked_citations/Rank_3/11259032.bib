@inproceedings{11259032,
 abstract = {This project focuses on improving power efficiency in RISC-V processor-based design through instruction set analysis and design optimization, with a focus on Internet of Things (IoT) applications. The main aim of this work is to reduce power consumption without sacrificing accuracy and processing performance. To provide adaptive algorithms for basic operations, the methodology entails establishing a RISC-V development environment, analyzing the instruction set, and optimizing the processor by merging a RISC-V 32IM processor with a digital mixer. The study revealed that the addition instruction was the most frequently occurring and the respective modules were optimized. With a slight improvement in area utilization, the optimizations led to a decrease in power usage from 9.686W to 6.435W. This study shows that power efficiency can be greatly increased by instruction-level optimizations. This work focuses on optimizing a RISC- V 32IM processor for a digital mixer application, showing how instruction profiling and simple modifications can improve power efficiency.},
 author = {Girish, Greeshma and Ram, D S Harish},
 booktitle = {2025 IEEE International Conference on Distributed Computing, VLSI, Electrical Circuits and Robotics (DISCOVER)},
 doi = {10.1109/DISCOVER66922.2025.11259032},
 issn = {},
 keyword = {Power demand;Reduced instruction set computing;Merging;Random access memory;Very large scale integration;Internet of Things;Logic;Mixers;Optimization;Robots;BRAM Integration;Digital Mixer;Instruction set analysis;Power Optimization;RISC-V 32IM. Introduction},
 month = {Oct},
 number = {},
 pages = {672-678},
 title = {Power-Efficient RISC-V Processor Customization for Digital Mixer Application},
 volume = {},
 year = {2025}
}
