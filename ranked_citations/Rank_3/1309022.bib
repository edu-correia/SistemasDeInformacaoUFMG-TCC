@inproceedings{1309022,
 abstract = {The works presented in this paper deals with the design of a tracking fusion filter for the future multi-carrier G.P.S signal. The estimation of the distance and speed between the satellite and the G.P.S receiver is realised with a Kalman track fusion algorithm. In this system, inspired from the modified track-to-track algorithm, the observations of the same type are merged with a measurement fusion algorithm and the measurements of different types are fused with a state vector fusion Kalman filter. This hybrid model can fuse the measurement obtained from the three frequencies of the future G.P.S. system. It can also fuse the state vectors that describe distances and speed which are supposed to come from different sensors. The simulation result obtained on synthetic data show the feasibility of the method and the contribution of the fusion over the accuracy of the localization.},
 author = {Kacemi, J. and Reboul, S. and Benjelloun, M.},
 booktitle = {PLANS 2004. Position Location and Navigation Symposium (IEEE Cat. No.04CH37556)},
 doi = {10.1109/PLANS.2004.1309022},
 issn = {},
 keyword = {Global Positioning System;Satellite broadcasting;Fuses;Sensor fusion;Satellite navigation systems;Filters;Frequency measurement;Sensor phenomena and characterization;Position measurement;Multiaccess communication},
 month = {April},
 number = {},
 pages = {399-404},
 title = {Information fusion in a multi-frequencies GPS receiver},
 volume = {},
 year = {2004}
}
