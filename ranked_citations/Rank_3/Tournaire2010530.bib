@article{Tournaire2010530,
 abstract = {In this paper, we investigate a principled approach for defining and discovering probabilistic mappings between two taxonomies. First, we compare two ways of modeling probabilistic mappings which are compatible with the logical constraints declared in each taxonomy. Then we describe a generate and test algorithm which minimizes the number of calls to the probability estimator for determining those mappings whose probability exceeds a certain threshold. Finally, we provide an experimental analysis of this approach. © 2010 Springer-Verlag Berlin Heidelberg.},
 author = {Tournaire, Rémi and Petit, Jean-Marc and Rousset, Marie-Christine and Termier, Alexandre},
 doi = {10.1007/978-3-642-15280-1_48},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {530 - 542},
 publication_stage = {Final},
 source = {Scopus},
 title = {Combining logic and probabilities for discovering mappings between taxonomies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78049389946?origin=resultslist},
 volume = {6291 LNAI},
 year = {2010}
}
