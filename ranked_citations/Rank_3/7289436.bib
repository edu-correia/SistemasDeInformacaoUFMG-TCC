@article{7289436,
 abstract = {This paper presents the branching approach, which can improve deterministic implementation methods (such as variational Bayesian inference and expectation propagation method) for Bayesian mixture distributions. This proposed approach utilizes a set of artificial conditions defined by using the latent variables of the mixture distribution. This condition set is updated iteratively by branching based on a condition selected from the previous condition set. The target approximate Bayesian inference is obtained by merging the approximate conditional inferences under each condition in the condition set. The proposed approach is compared with several standard implementation methods by using a numerical example and a real-world example.},
 author = {Nakada, Yohei},
 doi = {10.1109/TNNLS.2015.2477361},
 issn = {2162-2388},
 journal = {IEEE Transactions on Neural Networks and Learning Systems},
 keyword = {Bayes methods;Approximation methods;Gaussian distribution;Standards;Probabilistic logic;Inference algorithms;Probability density function;Bayesian inference;expectation propagation (EP);Gaussian mixtures;marginal likelihood;mixture distributions;mixture models;mixture of normal distributions;predictive distribution;variational Bayesian (VB) inference},
 month = {Nov},
 number = {11},
 pages = {2282-2300},
 title = {Improving on Deterministic Approximate Bayesian Inferences for Mixture Distributions},
 volume = {27},
 year = {2016}
}
