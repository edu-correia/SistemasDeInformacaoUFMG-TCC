@inproceedings{4659608,
 abstract = {Accurate identification of soil resistivity of dynamic grounding system is extremely important to define the operational safety and proper functioning of electric power system. Conventional methods can't achieve good result due to non-linearity of grounding system. To cope with the problem, a novel approach based on fuzzy modeling is proposed. In this approach, T-S fuzzy model is employed to appropriate the non-linear process, fuzzy model is derived from input-output data by means of product-space fuzzy clustering, similarity driven rule base simplification is applied to detect and merges compatible fuzzy sets in the model and real-coded genetic algorithm is adopted to optimize model parameters. All these techniques make the fuzzy model transparent and accurate. Based on this approach, a simulation experiment is made. The result shows the approach yields accurate result with error less than 1.5%, other parameters such as grounding resistance, over voltage can also be identified in the same way.},
 author = {Fan, Shao-sheng and Wang, Bing},
 booktitle = {2008 International Conference on Intelligent Computation Technology and Automation (ICICTA)},
 doi = {10.1109/ICICTA.2008.276},
 issn = {},
 keyword = {Fuzzy systems;Soil;Conductivity;Grounding;Power system modeling;Fuzzy sets;Nonlinear dynamical systems;Power system dynamics;Electrical safety;Genetic algorithms;Soil resistivity;Dynamic grounding system;Lightning;Fuzzy modeling},
 month = {Oct},
 number = {},
 pages = {855-858},
 title = {Application of Fuzzy Modeling to Identify the Soil Resistivity of Dynamic Grounding System},
 volume = {1},
 year = {2008}
}
