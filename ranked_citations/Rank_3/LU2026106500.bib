@article{LU2026106500,
 abstract = {Objective
Amelogenesis imperfecta (AI) presents significant challenges in adolescent patients due to compromised enamel structure, aesthetic concerns, and the need for long-term developmental adaptability. This case report demonstrated a full-digital, minimally invasive approach for an 11-year-old girl with hereditary AI, combining virtual treatment planning, guided tooth preparation, and advanced restorative materials to achieve optimal function and aesthetics while preserving tooth structure.
Methods
Intraoral scans, facial scans, tooth and condylar kinematic data, and cone-beam computed tomography data were merged to create a virtual patient model, enabling the dynamic assessment of occlusal relationships and smile design. Maxillofacial three-dimensional digital smile design (DSD) was performed, considering multiple prosthetic configurations to optimize aesthetics and biomechanics. Occlusal design accounted for future craniofacial development, with developing occlusal plane and curve figures considered to accommodate anticipated alveolar growth. Occlusal reduction guides were designed based on comprehensive craniofacial analysis, predicting future occlusal plane development and curve of Spee progression to precisely anticipate preparation requirements, achieving true minimally invasive occlusal surface reduction. Vertical preparation was digitally guided to maximize tissue preservation while ensuring restoration retention. Polymer-infiltrated ceramic (Ceramage) restorations were selected for their biomimetic properties, balancing strength, wear resistance, and life-like optics.
Results
The digitally planned restorations achieved natural aesthetics, functional occlusion, and phonetic adaptation. One-year follow-up confirmed stable margins, absence of hypersensitivity, and patient-reported satisfaction. Critical tissue preservation permits future revisions as the patient matures.
Conclusions
This case exemplifies how virtual planning and minimal intervention principles can synergize to address AI in adolescents. By leveraging digital diagnostics, guided preparation, and bioactive materials, clinicians can deliver durable, aesthetic, and growth-aware solutions for young patients with hereditary enamel defects.},
 author = {Xing Lu},
 doi = {https://doi.org/10.1016/j.jdent.2026.106500},
 issn = {0300-5712},
 journal = {Journal of Dentistry},
 keyword = {Amelogenesis imperfecta, digital planning, guided tooth preparation},
 pages = {106500},
 title = {Virtual planning, minimal intervention: a full-digital journey restoring smile and function in an adolescent with amelogenesis imperfecta},
 url = {https://www.sciencedirect.com/science/article/pii/S0300571226001739},
 volume = {167},
