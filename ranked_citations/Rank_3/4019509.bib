@inproceedings{4019509,
 abstract = {The UCSC Kestrel parallel processor is part of an evolution from application-specific to specialized to application-unspecific processing. Kestrel combines an ALU, multiplier, and local memory, with systolic shared registers for seamless merging of communication and computation, and an innovative condition stack for rapid conditionals. The result has been a readily programmable and efficient co-processor for many applications. Experience with Kestrel indicates that programmable systolic processing, and its natural combination with the single instruction-multiple data (SIMD) parallel architecture, will be an effective design choice for years to come},
 author = {Hughey, Richard and Di Blas, Andrea},
 booktitle = {IEEE 17th International Conference on Application-specific Systems, Architectures and Processors (ASAP'06)},
 doi = {10.1109/ASAP.2006.66},
 issn = {1063-6862},
 keyword = {Signal processing algorithms;Sequences;Costs;Very large scale integration;Systolic arrays;Registers;Bioinformatics;Biology computing;Algorithm design and analysis;Concurrent computing},
 month = {Sep.},
 number = {},
 pages = {163-168},
 title = {The UCSC Kestrel Application-Unspecific Processor},
 volume = {},
 year = {2006}
}
