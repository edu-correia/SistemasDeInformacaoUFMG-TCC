@inproceedings{10649489,
 abstract = {In electronic gadgets era, multi-digit multiplication has found extensive applications in many fields such as numerical computation, complex arithmetic and primitive testing process. There is a rising demand for systems that offer high performance which requires minimal energy, particularly in domains like image processing and cryptography, where complicated techniques are employed. This paper aims to design and explore the hardware architecture for multi-digit multiplication and evaluates its VLSI implementation, taking into account both cost and performance considerations. The design of modified architecture of Karatsuba multiplier is proposed specifically for low power application. The final vector merging addition is performed using sum based carry calculation to reduce a computation delay. The findings will aid system designers to choose design alternatives, including ASIC implementation, for applications that necessitate multi-digit multiplication.},
 author = {Dhanaselvam, P Suveetha and Karthikeyan, B.},
 booktitle = {2024 International Conference on Smart Systems for Electrical, Electronics, Communication and Computer Engineering (ICSSEECC)},
 doi = {10.1109/ICSSEECC61126.2024.10649489},
 issn = {},
 keyword = {Costs;Shape;Merging;Computer architecture;Very large scale integration;Propulsion;Hardware;Multi-digit multiplication;Configurable Karatsuba multiplier;Low power application;Sum based carry calculation;VLSI realization},
 month = {June},
 number = {},
 pages = {506-510},
 title = {VLSI Implementation of Modified Karatsuba Multiplier for Low Power Applications},
 volume = {},
 year = {2024}
}
