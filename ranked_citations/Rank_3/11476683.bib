@inproceedings{11476683,
 abstract = {Merging Units are essential devices in digital substations, designed to convert analog signals from current transformers (CTs) and voltage transformers (VTs) into digital data transmitted according to the IEC 61850 standard. These units facilitate interoperability and the integration of protection and control devices. This work describes the implementation of this technology at the General Díaz Substation, the first in Paraguay to use Merging Units, representing a step forward in the digitalization of the national power system. This implementation not only sets a technological benchmark within the country, but also opens the path for future deployments of digital substations across the Paraguayan power grid, enhancing reliability, scalability, and smart grid readiness.},
 author = {Rojas, Diego and Salas, Percy and Paiva, Enrique and Adorno, Cesar and Fernández, Ubaldo and Fariña, Rodney},
 booktitle = {2025 IEEE CHILEAN Conference on Electrical, Electronics Engineering, Information and Communication Technologies (CHILECON)},
 doi = {10.1109/CHILECON66915.2025.11476683},
 issn = {2832-1537},
 keyword = {Internet of Things;Communication systems;Internet;Protocols;Computer networks;Software defined networking;Communication networks;Internetworking;Interoperability;Electronic components;Merging Unit;IEC 61850;Sampled Values;Digitalization;Substations;Transformer Protection},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Electrical Substation Digitalization Case Study With Merging Unit in the Paraguayan Power System},
 volume = {},
 year = {2025}
}
