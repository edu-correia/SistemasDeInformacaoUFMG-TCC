@inproceedings{1334103,
 abstract = {K-nearest neighbor graph has been used for reducing the number of distance calculations in PNN-based clustering. The bottleneck of the approach is the creation of the graph. In this paper, we develop a fast divide-and-conquer method for graph creation based on the algorithm previously used in the closest pair problem. The proposed algorithm is then applied to agglomerative clustering, in which it outperforms previous projection-based algorithm for high dimensional spatial data sets.},
 author = {Virmajoki, O. and Franti, P.},
 booktitle = {Proceedings of the 17th International Conference on Pattern Recognition, 2004. ICPR 2004.},
 doi = {10.1109/ICPR.2004.1334103},
 issn = {1051-4651},
 keyword = {Clustering algorithms;Nearest neighbor searches;Vector quantization;Search methods;Computer science;Mean square error methods},
 month = {Aug},
 number = {},
 pages = {264-267 Vol.1},
 title = {Divide-and-conquer algorithm for creating neighborhood graph for clustering},
 volume = {1},
 year = {2004}
}
