@inproceedings{11167361,
 abstract = {Ensuring crop health, optimizing yields, and facilitating sustainable agricultural practices depend on early detection and exact classification of rice diseases, particularly in South and Southeast Asian nations like India and Malaysia where rice is a dietary mainstay and economic backbone. Using a hybrid deep learning framework combining Convolutional Neural Networks (CNNs) with Quantum Neural Networks (QNNs) on AI edge devices, this article presents a unique real-time rice illness diagnosis and field suggestion system. While a parameterized quantum circuit incorporating Hadamard, CNOT, and Ry gates improves feature representation and classification resilience, a transfer learning technique using a pre-trained ResNet152 architecture allows effective feature extraction from rice leaf pictures. Included to reduce decoherence and noise influences are quantum error correcting methods as Shor’s Code and surface code approaches. Ensuring exact illness identification, the trained hybrid model has an F1 score of ${9 6 \%}$ and a total classification accuracy of $96.8 \%$. Integrated recommendation logic links identified illnesses to customized agronomic prescriptions, including field treatments, nutrition management, and focused pesticide use. Deployment on AI edge devices allows completely offline, real-time inference, hence giving farmers instant actionable information in the field. Aiming to provide farmers with smart, scalable, and sustainable disease control tools, this paper underlines the transforming power of merging hybrid quantum-classical learning, transfer learning, and mobile edge artificial intelligence for precision agriculture.},
 author = {Vijayakumar, Senthilkumar and Kane, Shaunak Pai and Vaiappuri, Selvakkumar and Louis, Filious and Prabha, P. Anantha},
 booktitle = {2025 IEEE 7th Symposium on Computers & Informatics (ISCI)},
 doi = {10.1109/ISCI65687.2025.11167361},
 issn = {2996-6752},
 keyword = {Smart agriculture;Precision agriculture;Accuracy;Image edge detection;Transfer learning;Neural networks;Edge AI;Pesticides;Real-time systems;Convolutional neural networks;Rice Disease Classification;Transfer Learning;Quantum Neural Networks (QNN);ResNet152;Real-Time Recommendation;AI Edge Devices;Computer Vision;Smart Agriculture},
 month = {Aug},
 number = {},
 pages = {358-366},
 title = {Quantum-Enhanced Hybrid CNN–QNN Framework for Intelligent Rice Disease Diagnosis and Real-Time Field Recommendations on Edge AI Devices},
 volume = {},
