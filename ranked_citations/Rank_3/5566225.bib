@inproceedings{5566225,
 abstract = {In order to realize informational management of petroleum enterprise and improve the comprehensive competivity, the visual decision support system is given in this paper. Firstly, the background and significance of building the visual decision support system of petroleum enterprise is analysized, and also the merging point of the visual decision support system of petroleum enterprise with GIS、ES、system analysis method and data mining method is discussed, lastly the logical frame and function structure of realizing PEMVDSS is carried. The PEMVDSS can promote the function from aid to intelligent and even to visual according to the above scheme, which can enhance the confidence of manager to choose the decision scheme and the effect of making the decision, And the informational development strategy of management of petroleum enterprise can be realized.},
 author = {Zhang, Wen-yu and Zheng, Nan},
