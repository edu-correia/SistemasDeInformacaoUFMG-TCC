@inproceedings{11371183,
 abstract = {This study examines the impact of emerging technologies, namely, AI, IoT and Blockchain, on promoting sustainable banking practices and encouraging sustainable finance. With environmental concerns rising for financial institutions, this research explores how new technologies can cut down on carbon emissions, improve openness and support better choices in eco-finance. Using a multi-method empirical approach, the study analyzes data from 50 international banks over five years, drawing on ESG performance metrics, technology integration indices, and environmental impact disclosures. Regression analysis and machine learning techniques identify correlations and causations between technology deployment and measurable sustainability outcomes, such as energy savings, paperless transactions, and green lending growth. Findings reveal that AI-driven analytics improve green credit risk assessments, IoT systems optimize resource consumption in physical banking infrastructure, and blockchain enhances traceability in green bond issuance. The merging of these technologies results in an enhancement of ESG scores by $\mathbf{1 5 - 2 5 \%}$ for most of the sample organizations. This paper provides data-supported evidence that supports the use of intelligent technology in making the financial sector more environmentally accountable. The book also gives useful tips for policymakers, fintech innovators and executives working to grow projects in sustainable finance.},
 author = {Rajput, Namita and Kaur, Baljeet},
 booktitle = {2025 2nd International Conference on Integration of Computational Intelligent System (ICICIS)},
 doi = {10.1109/ICICIS65613.2025.11371183},
 issn = {},
 keyword = {Measurement;Technology acceptance model;Fintech;Green products;Finance;Banking;Blockchains;Internet of Things;Risk management;Sustainable development;Green Banking;Artificial Intelligence;Blockchain;Internet of Things;Sustainable Finance;FinTech;Environmental Impac[1]},
 month = {Sep.},
