@conference{Haas2012,
 abstract = {We developed a 0.61'' diagonal OLED microdisplay dedicated to electronic viewfinders for digital vision systems, e.g. for security or other professional applications. The microdisplay has a very high resolution of 5.4 million subpixels and combines excellent image quality with low power consumption and a 10bit per color digital input. Subpixel pitch is 4.7x4.7μm2. Thanks to the versatile architecture of the underlying ASIC circuit, the device can be easily adapted to different applications and image formats: In the standard full color version, the resulting resolution is 1300 by 1044 pixels (SXGA). In a monochrome version, the resolution is 2600 by 2088 independent pixels, enabling e.g. digital night vision at full 2K by 2K resolution. In addition to this, we developed two- and three color versions of the display that allow to merge high resolution monochrome images e.g.in 2K by 2K resolution with lower resolution images e.g., from an infrared sensor for image fusion or for adding colored graphical overlays. © 2012 Copyright Society of Photo-Optical Instrumentation Engineers (SPIE).},
 author = {Haas, Gunther and Espuno, Laurent and Marcellin-Dibon, Eric and Prat, Christophe and Gohri, Vipul},
 doi = {10.1117/12.918998},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A 5.4 MDOT OLED microdisplay for digital night vision and image fusion},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84864350877?origin=resultslist},
 volume = {8383},
 year = {2012}
}
