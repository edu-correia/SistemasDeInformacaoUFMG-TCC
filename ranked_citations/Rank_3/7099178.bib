@inproceedings{7099178,
 abstract = {In this paper, a scheme based on multiview and Distributed Video Coding (DVC) is introduced. More specifically, a new fusion technique between temporal, homography and Disparity Compensation View Prediction (DCVP) side informations is introduced. For this purpose, a binary mask is computed at the encoder based on knowledge of the original video. This mask is compressed and then transmitted to the decoder. The latter merges the different side informations with the help of the reconstructed binary mask. The simulation results show that the fusion improves the rate-distortion performance over monoview DVC by a maximum gap of around 1.0 dB.},
 author = {Ouaret, Mourad and Dufaux, Frederic and Ebrahimi, Touradj},
 booktitle = {2007 15th European Signal Processing Conference},
 doi = {},
 issn = {},
 keyword = {Cameras;Decoding;Video coding;Bit rate;Rate-distortion;Europe;Encoding},
 month = {Sep.},
 number = {},
 pages = {2100-2104},
 title = {Multiview Distributed Video Coding with encoder driven fusion},
 volume = {},
 year = {2007}
}
