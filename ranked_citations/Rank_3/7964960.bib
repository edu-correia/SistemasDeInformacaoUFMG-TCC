@inproceedings{7964960,
 abstract = {This paper presents a novel bit-serial fine-grain pipelined reconfigurable VLSI architecture based on multiplexer logic to achieve high utilization of hardware resources and high throughput. A basic cell is constructed by a logic block composed of a 2-data-input multiplexer and a switch box for data transfer between adjacent logic blocks by 8-near neighborhood mesh network. A multiplexer merged with a latch function is effectively employed for efficient fine-grain pipelined operation. A systematic mapping method for pipelined bit-serial operations is proposed using a data flow graph. As an extension of the reconfigurable VLSI based on the binary multiplexer logic, we introduce linear summation in the data transfer between logic blocks. A 4-valued multiplexer directly controlled by the linear sum can be effectively utilized to reduce complexity of the switch box.},
 author = {Shimabukuro, Katsuhiko and Kameyama, Michitaka},
 booktitle = {2017 IEEE 47th International Symposium on Multiple-Valued Logic (ISMVL)},
 doi = {10.1109/ISMVL.2017.45},
 issn = {2378-2226},
 keyword = {Computer architecture;Microprocessors;Multiplexing;Very large scale integration;Resource management;Adders;Hardware;fine-grain pipelined reconfigurable VLSI;multiplexer logic;8-nearest-neighbor mesh network;X-net;scheduling and allocation in bit-serial operations},
 month = {May},
 number = {},
 pages = {19-24},
 title = {Fine-Grain Pipelined Reconfigurable VLSI Architecture Based on Multiple-Valued Multiplexer Logic},
 volume = {},
 year = {2017}
}
