@article{Izquierdo2014166,
 abstract = {Language ambiguities are a problem in various fields. For example, in Machine Translation the major cause of errors is ambiguity. Moreover, ambiguous words can be confusing for Information Extraction algorithms. Our purpose in this work is to provide a new approach to solve semantic ambiguities by dealing with the problem of the fine granularity of sense inventories. Our goal is to replace word senses with Semantic Classes that share properties, features and meanings. Also another semantic resources, Relevant Domains, is used to extract extract semantic information and enrich the process. The results obtained are evaluated in the Evaluation Exercises for the Semantic Analysis of Text (SensEval) framework. © 2014 Springer International Publishing.},
 author = {Izquierdo, Rubén and Vázquez, Sonia and Montoyo, Andrés},
 doi = {10.1007/978-3-319-10816-2_21},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {166 - 172},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic classes and relevant domains on WSD},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84906987330?origin=resultslist},
 volume = {8655 LNAI},
 year = {2014}
}
