@conference{Weber2003779,
 abstract = {In this paper we describe a new system for navigated viewing of medical image data and different visualization concepts being realized within the system and discuss usefulness of different visualization modes. The system comprises a compact and mobile viewing device that can be tracked by an optical position sensor. It is capable of displaying reasonable parts of a medical image data set (i.e. CT) on its screen in relation to the spatial position regarding a patient. Requirements of simple integration in a clinical environment and various visualization modes, to be applied in maxillofacial surgery are described.},
 author = {Weber, S. and Klein, M. and Hein, A. and Krueger, T. and Lueth, Tim C. and Bier, Juergen},
 journal = {IEEE International Conference on Intelligent Robots and Systems},
 note = {Cited by: 0},
 pages = {779 - 784},
 publication_stage = {Final},
 source = {Scopus},
 title = {Application of different visualization concepts in the navigated image viewer},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/0346779074?origin=resultslist},
 volume = {1},
 year = {2003}
}
