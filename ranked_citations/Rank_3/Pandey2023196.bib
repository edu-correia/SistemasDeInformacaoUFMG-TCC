@conference{Pandey2023196,
 abstract = {The integration of ontology in healthcare system decision-making has profound implications for computer science and artificial intelligence (AI) applications in healthcare. This research explores the potential of ontology-driven solutions to enhance decision-making for healthcare policymakers. We focus on developing an ontology that incorporates key domain concepts such as health environments, diseases, and geographical areas, and their relationships across domains. Our ultimate goal is to create a publicly accessible repository of understanding knowledge with a strong emphasis on health care. In this interdisciplinary conference on computer science, AI, machine learning, data mining, natural language processing (NLP), computer vision, robotics and data mining, this paper presents an approach made the unified conceptual framework presentation. This framework provides a unified level of health literacy by seamlessly integrating ontologies of diseases, geographic regions and organizational contexts Furthermore, we address important aspects of logic integration, including health visualization, usage including the possibilities of app development and connectivity challenges.  © 2023 IEEE.},
 author = {Pandey, Rajendra P. and Mahajan, Prerna},
 doi = {10.1109/ICCSAI59793.2023.10421724},
 journal = {2023 International Conference on Communication, Security and Artificial Intelligence, ICCSAI 2023},
 note = {Cited by: 1},
 pages = {196 - 199},
 publication_stage = {Final},
 source = {Scopus},
 title = {Developing an Optimized Semantic Knowledge Base for Enhanced Public Healthcare Systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85186716516?origin=resultslist},
 year = {2023}
