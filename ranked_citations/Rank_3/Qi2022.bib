@conference{Qi2022,
 abstract = {Expressway plays a significant role in promoting social and economic development, while traffic safety matters are following. In actual expressway scenario, events such as occupying-road constructions and traffic accidents will narrow carriageways and obviously decrease the traffic capacity. Therefore, it is particularly important to improve the effectiveness of security management in bottleneck areas. To describe the driving features in bottleneck areas, this paper proposes a safety evaluation method for expressway bottleneck areas based on the traffic Spatio-temporal proximity index. In the proposed method, the time to collision (TTC) and post encroachment time (PET) indexes are applied to describe the proximity characteristic in both time and space dimensions and then calculate the indicators of the bottleneck area. Then, the fuzzy C-means (FCM) algorithm is used for classifying the risk levels so that the thresholds of TTC and PET can be obtained and the risk factor of bottleneck area is further calculated, due to which the safety level of the expressway bottleneck area is comprehensively evaluated. Finally, the proposed method is simulated and the performance is analyzed using VISSIM. Simulation results show that the safety level is in accordance with its actual area characteristics and the proposed method can surely provide reliable theory support for the expressway traffic safety management. © 2022 SPIE},
 author = {Qi, Xiaoran and Chen, Yongqi},
 doi = {10.1117/12.2645661},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
