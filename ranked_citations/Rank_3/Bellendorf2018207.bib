@article{Bellendorf2018207,
 abstract = {Topology and Orchestration Specification for Cloud Applications (TOSCA) is a standard for specifying the topology of cloud applications, their deployment on cloud resources, and their orchestration. In recent years, the cloud research community has shown increasing interest in TOSCA, leading to an increasing number of publications. These publications address different topics around TOSCA, e.g., devise cloud orchestration methods using TOSCA, extend the language of TOSCA, or present tools for manipulating TOSCA models. To help researchers and practitioners overview this multifaceted area of research, this paper presents the results of a systematic survey of the relevant literature. © IFIP International Federation for Information Processing 2018.},
 author = {Bellendorf, Julian and Mann, Zoltán Ádám},
 doi = {10.1007/978-3-319-99819-0_16},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 23},
 pages = {207 - 215},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cloud topology and orchestration using TOSCA: A systematic literature review},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85053898646?origin=resultslist},
 volume = {11116 LNCS},
 year = {2018}
}
