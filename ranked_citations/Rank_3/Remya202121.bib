@article{Remya202121,
 abstract = {Crowdsourcing is treated as open contest for the crowd of people known as workers. All workers can contribute their suggestions and solutions to the platform. Crowdsourcing can connect a large number of people and they can share their knowledge. The amount of unstructured data is increasing now. This is where crowdsourcing can help bigdata by breaking down the data into mini chunks and have the power of crowd to do the organising task. This helps analytic companies to focus on the core aspect of infrastructure and security. It makes sense of the data and not invests resources in organising the data and this distributed environment can be solved intelligently. Here various crowdsourcing techniques in different aspects related to data pre-processing, performance approaches, security issues and applications are analysed. Out of these approaches the most efficient one in each are characterised. The survey helps to analyse the various issues in crowdsourcing and existing proposed solutions for improving the quality of workers. Copyright © 2021 Inderscience Enterprises Ltd.},
 author = {Remya, S. and Sasikala, R.},
 doi = {10.1504/IJITM.2021.114153},
 journal = {International Journal of Information Technology and Management},
 note = {Cited by: 0},
 number = {1-2},
 pages = {21 - 48},
 publication_stage = {Final},
 source = {Scopus},
 title = {Investigation and analysis on crowdsourcing for improving enterprise QoS},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85104077012?origin=resultslist},
 volume = {20},
 year = {2021}
}
