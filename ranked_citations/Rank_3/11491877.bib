@article{11491877,
 abstract = {6G non-terrestrial networks (NTNs) will strengthen global Earth observation (EO) by linking low Earth orbit (LEO) satellite constellations, high altitude platforms (HAPs), and unmanned aerial vehicles (UAVs). However, long paths, intermittent links, and tight spectrum make traditional bit-centric pipelines brittle and bandwidth-heavy. Traditional semantic communication (SC) approaches also fall short because they rely on a single-source processing and degrade severely under low signal-to-noise ratio (SNR), multi-hop, and noisy orbital conditions. Therefore, we present a unified multi-source SC with an intelligent denoising framework that transmits meaning rather than raw symbols, fuses complementary features from multiple satellites, and restores semantics in the presence of noise. We first discuss the fundamentals of the unified multi-source SC with an intelligent denoising framework. Then, we explain our proposed framework in detail. Our framework couples the multi-hop inter-satellite delivery of compact semantic features with transformer-based denoising to maintain fidelity at low SNR and receiver-side image merging and large language model (LLM)-assisted semantic refinement to assemble overlapping segments into a coherent EO product aligned with a shared knowledge base. As a proof of concept, we present a case study on EO image delivery over LEO satellite, which shows improved robustness and bandwidth efficiency relative to conventional SC without denoising and traditional communications, with higher peak SNR (PSNR) and multi-scale structural similarity index (MS-SSIM), and reduced loss across SNR regimes. Finally, we provide several open challenges and conclude the paper.},
 author = {Hassan, Sheikh Salman and Nguyen, Loc X. and Khan, Latif U. and Guizani, Maher and Han, Zhu and Hong, Choong Seon and Ratnarajah, Tharmalingam},
 doi = {10.1109/MIOT.2026.3673613},
 issn = {2576-3199},
 journal = {IEEE Internet of Things Magazine},
 keyword = {Low earth orbit satellites;Artificial satellites;Telemetry;Aerospace and electronic systems;Feedback;Filtering;Filters;AI accelerators;Circuits;Microprocessor chips;6G;non-terrestrial networks;semantic communication;Earth observation;multi-source data fusion;denoising},
 month = {},
 number = {},
 pages = {1-8},
 title = {Multi-Source Semantic Communication and Denoising for Non-Terrestrial Networks: Fundamentals, Framework, and Challenges},
 volume = {},
 year = {2026}
}
