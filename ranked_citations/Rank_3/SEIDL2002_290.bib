@article{SEIDL2002_290,
 abstract = {The use of products extracted from plants for medicinal purposes can be traced to the beginnings of civilization and up until the end of the nineteenth century natural products were the principal source of medicines. Since then their relative importance has oscillated according to the strategies of large pharmaceutical companies. Now that these strategies are changing, there are new opportunities for countries like Brazil, in which a large proportion of the world's biodiversity is located. There are, however, new circumstances that must be taken into consideration: material must be collected by groups which are formally authorized to do so and under the conditions of the Convention of Biological Diversity, the discovery process is being successively outsourced to smaller specialized firms and there is a growing integration with producers of cosmetics and phytomedicines.},
 author = {SEIDL, PETER R.},
 number = {1},
 pages = {145--150},
 title = {Pharmaceuticals from natural products: current trends},
 volume = {74},
 year = {2002}
}
