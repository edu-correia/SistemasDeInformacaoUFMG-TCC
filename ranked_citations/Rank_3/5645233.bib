@inproceedings{5645233,
 abstract = {This paper proposes an evolutionary approach of Network Information Integration which is based on analyzing interests. Our purpose is to make an effective arrangement for the information gathered from networks and feed back the useful information to the main network. In order to achieve this goal, a method of grasping of information in all networks and a method of holding of personal interests are involved. With the assistance of gathering the interests of users' daily lives and API automatic Login, we are able to solve a variety of information separation problems among web communities, and also realize a humanistic processing for information merging.},
 author = {Su, Fan and Liu, Yang and Zhou, Liyun and Ye, Menglong},
 booktitle = {2010 IEEE Fifth International Conference on Bio-Inspired Computing: Theories and Applications (BIC-TA)},
 doi = {10.1109/BICTA.2010.5645233},
 issn = {},
 keyword = {Hidden Markov models;Analytical models;Argon;Crossing network;Information fusion;Interest analysis;Vague keywords},
