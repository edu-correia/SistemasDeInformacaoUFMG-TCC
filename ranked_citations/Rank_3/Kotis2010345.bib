@conference{Kotis2010345,
 abstract = {Ontology engineering has been fully or partially practiced by knowledge engineers or knowledge workers, towards delivering either fully fledged conceptualizations of domains or providing lightweight ontology versions for less demanding but more frequent knowledge tasks. Domain-specific information can be shaped into ontologies either manually or (semi-)automatically using ontology learning techniques. The aim of the paper is to present a novice ontology learning approach that automatically constructs kick-off and useful ontologies from query logs. We place tasks related to the proposed learning approach in all phases of an ontology engineering life-cycle. By providing knowledge workers a useful kick-off ontology that is automatically built from "their needs (i.e. users' search interests)" in order to address "their needs (i.e. use of the kick-off ontology to query data precisely)", an approach that contributes as an incentive in the semantic content creation bottleneck is introduced. © 2010 IEEE.},
 author = {Kotis, Konstantinos and Papasalouros, Andreas},
 doi = {10.1109/CISIS.2010.50},
 journal = {CISIS 2010 - The 4th International Conference on Complex, Intelligent and Software Intensive Systems},
 note = {Cited by: 11},
 pages = {345 - 351},
 publication_stage = {Final},
 source = {Scopus},
 title = {Learning useful kick-off ontologies from query logs: HCOME revised},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77952766271?origin=resultslist},
 year = {2010}
}
