@inproceedings{9410170,
 abstract = {In order to improve the effect of college archives resource integration, this paper designs a college archives resource integration system based on big data mining. System hardware consists of data storage module, a shared database module, user authentication module, resource integration module and resource retrieval module, on the basis of the hardware design to software development. First of all, the university archives resources big data preprocessing, attribute the training sample set for each attribute of information gain rate, on the basis of this general has the maximum attribute of information gain rate as a decision-making tree root node, and through the class attribute distribution, merging, and reduction operation, realize the university archives resources data mining. The experimental results show that the system has higher recall and precision, and shorter response time.},
 author = {Liu, YaNa},
 booktitle = {2021 13th International Conference on Measuring Technology and Mechatronics Automation (ICMTMA)},
 doi = {10.1109/ICMTMA52658.2021.00157},
 issn = {2157-1481},
 keyword = {Training;Merging;Memory;Big Data;Hardware;Time measurement;Software;Big data mining;University archives;Resource integration;Information gain rate},
 month = {Jan},
 number = {},
 pages = {682-685},
 title = {Design of university archives resource integration system based on big data mining},
 volume = {},
 year = {2021}
}
