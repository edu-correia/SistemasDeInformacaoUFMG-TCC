@inproceedings{5379932,
 abstract = {This paper describes a field demonstration and presents the network performance of an 802.11 ground-UAV network composed of 11 ground stations, a mobile vehicle and two fixed wing UAVs, connected by two routing gateways to a legacy wired network. The network effects demonstrated include mobility, network partitions and merges, and gateway failovers. The paper presents experimental results for recorded data traffic and for the state of the routing protocols, with the mobile nodes participating as sources of data traffic.},
 author = {Danilov, Claudiu and Henderson, Thomas R. and Goff, Thomas and Kim, Jae H. and Macker, Joseph and Weston, Jeff and Neogi, Natasha and Ortiz, Andres and Uhlig, Daniel},
 booktitle = {MILCOM 2009 - 2009 IEEE Military Communications Conference},
 doi = {10.1109/MILCOM.2009.5379932},
 issn = {2155-7586},
 keyword = {Ad hoc networks;Routing;Protocols;Spine;Unicast;Mobile ad hoc networks;Laboratories;Land vehicles;Unmanned aerial vehicles;Telecommunication traffic},
 month = {Oct},
 number = {},
 pages = {1-7},
 title = {Experiment and field demonstration of a 802.11-based ground-UAV mobile ad-hoc network},
 volume = {},
 year = {2009}
}
