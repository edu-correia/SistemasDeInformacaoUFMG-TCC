@inproceedings{4376078,
 abstract = {In this paper a design of a novel 3-D multi-branch monopole antenna for cellular hand-set and portable equipments will be presented. The proposed design is covering most GSM family standards including the UMTS, the global new IMT-2000, and WLAN+ Bluetooth. Using the adopted design, multi-frequency operation including four, five and six operating bands can be achieved. Also, with an optimized design, some bands can be merged to obtain multi-wideband antenna that covering most of cellular standards.},
 author = {Al-Mously, Salah I. and Abousetta, Marai M.},
 booktitle = {2007 8th International Conference on Telecommunications in Modern Satellite, Cable and Broadcasting Services},
 doi = {10.1109/TELSKS.2007.4376078},
 issn = {},
 keyword = {Helical antennas;GSM;3G mobile communication;Distributed control;Personal communication networks;Cellular networks;Frequency;Bluetooth;Telephone sets;Dual band;Monopole antenna;Multi-band antenna;Cellular hand-set antenna},
 month = {Sep.},
 number = {},
 pages = {577-580},
 title = {A Novel Multi-Wideband Antenna Using a 3-D Multi-Branch Monopole Structure for GSM-Family and Other Cellular Applications},
 volume = {},
 year = {2007}
}
