@article{Huang20233,
 abstract = {Online Merge Offline (OMO) learning has become one of the crucial modes within the digital transformation wave to provide students with more flexibile and personalized learning experiences, hence overcoming educational challenges, such as the post-COVID-19 educational crisis. For the successful adoption of OMO learning in educational institutions, teachers must have the necessary competencies to do so, however scant information exist in the literature about the teachers’ readiness to adopt OMO learning. Therefore, this study conducts an empirical investigation to investigate the level of teachers’ readiness to adopt OMO learning. The obtained results revealed that teachers reported a low level of readiness for adopting OMO learning. Particularly, the teachers were more competent in Digital Literacy and Environment management compared to pedagogy, curriculum design, and learning assessment for facilitating OMO learning. Additionally, female teachers were more competent in OMO pedagogy compared to male teachers. This study provides valuable evidence that might be used to develop a flexible, suitable, and helpful teacher’s professional development program (TPD) to prepare teachers for the OMO learning modality in future education. © 2023, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Huang, Ronghuai and Mustafa, Muhammad Yasir and Tlili, Ahmed and Chang, Ting-Wen and Xu, Lin},
 doi = {10.1007/978-3-031-35731-2_1},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3},
 pages = {3 - 13},
 publication_stage = {Final},
 source = {Scopus},
 title = {Ready or Not? Investigating Teachers’ Readiness for Adopting Online Merge Offline (OMO) Learning in Digital Transformation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85171453511?origin=resultslist},
