@inproceedings{11126511,
 abstract = {In this paper, we propose an efficient and secure multiple access system based on the Feistel cipher (FC) in-terleaver, that fulfills the required cryptographic properties. The proposed system merges a novel permutation group incorporated in interleave division multiple access (IDMA) system with T-Transform orthogonal frequency division multiplexing (T-OFDM). The new FC interleaving is designed by adapting the group random permutation (GRP), which controlled by an efficient elliptic curves cryptography (ECC), and involving simple mathematical operations, in which the degree of randomness is improved and implement a lightweight efficient encryption scheme. The obtained results show that FC-based IDMA scheme can improve the BER performance and the statistical tests confirm the security of transmission.},
 author = {Belaoura, Widad and Ghanem, Khalida and Djeddou, Mustapha and Boussakta, Said},
 booktitle = {2025 7th International Conference on Pattern Analysis and Intelligent Systems (PAIS)},
 doi = {10.1109/PAIS66004.2025.11126511},
 issn = {},
 keyword = {Ciphers;Elliptic curves;Simulation;Process control;Peak to average power ratio;Elliptic curve cryptography;Encryption;Data communication;Pattern analysis;Intelligent systems;Elliptic curves cryptography;6G;IDMA;Inter-leaver;Orthogonal Frequency Division Multiplexing (OFDM)},
 month = {April},
 number = {},
 pages = {1-5},
 title = {An Improved IDMA System-Based Feistel Cipher Interleaver},
 volume = {},
 year = {2025}
}
