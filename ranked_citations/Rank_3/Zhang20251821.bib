@conference{Zhang20251821,
 abstract = {Human understanding of text depends on general semantic concepts of words rather than their superficial forms. To what extent does our human intuition transfer to language models? In this work, we study the degree to which current multilingual language models (mLMs) understand based on subword-level semantic concepts. To this end, we form “semantic tokens” by merging the semantically similar subwords and their embeddings, and evaluate the updated mLMs on five heterogeneous multilingual downstream tasks. Results show that the general shared semantics could get the models a long way in making the predictions on mLMs with different tokenizers and model sizes. Inspections of the grouped subwords show that they exhibit a wide range of semantic similarities, including synonyms and translations across many languages and scripts. Lastly, we find that the zero-shot results with semantic tokens are on par with or even better than the original models on certain classification tasks, suggesting that the shared subword-level semantics may serve as the anchors for cross-lingual transfer. ©2025 Association for Computational Linguistics.},
 author = {Zhang, Crystina and Lu, Jing and Tran, Vinh Q. and Schuster, Tal and Metzler, Donald and Lin, Jimmy},
 doi = {10.18653/v1/2025.findings-naacl.98},
 journal = {2025 Annual Conference of the Nations of the Americas Chapter of the Association for Computational Linguistics: Proceedings of the Conference Findings, NAACL 2025},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 pages = {1821 - 1837},
 publication_stage = {Final},
 source = {Scopus},
 title = {Tomato, Tomahto, Tomate: Do Multilingual Language Models Understand Based on Subword-Level Semantic Concepts?},
 type = {Conference paper},
