@article{Zhao2018340,
 abstract = {During asynchronous collaborative analysis, handoff of partial findings is challenging because externalizations produced by analysts may not adequately communicate their investigative process. To address this challenge, we developed techniques to automatically capture and help encode tacit aspects of the investigative process based on an analyst's interactions, and streamline explicit authoring of handoff annotations. We designed our techniques to mediate awareness of analysis coverage, support explicit communication of progress and uncertainty with annotation, and implicit communication through playback of investigation histories. To evaluate our techniques, we developed an interactive visual analysis system, KTGraph, that supports an asynchronous investigative document analysis task. We conducted a two-phase user study to characterize a set of handoff strategies and to compare investigative performance with and without our techniques. The results suggest that our techniques promote the use of more effective handoff strategies, help increase an awareness of prior investigative process and insights, as well as improve final investigative outcomes. © 1995-2012 IEEE.},
 author = {Zhao, Jian and Glueck, Michael and Isenberg, Petra and Chevalier, Fanny and Khan, Azam},
 doi = {10.1109/TVCG.2017.2745279},
 journal = {IEEE Transactions on Visualization and Computer Graphics},
 note = {Cited by: 62; All Open Access; Green Open Access},
 number = {1},
 pages = {340 - 350},
 publication_stage = {Final},
 source = {Scopus},
 title = {Supporting Handoff in Asynchronous Collaborative Sensemaking Using Knowledge-Transfer Graphs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85028699523?origin=resultslist},
 volume = {24},
 year = {2018}
}
