@inproceedings{8858318,
 abstract = {Nowadays, e-commerce has made its official way into the clicks-and-mortar era. The advantage of the clicks-and-mortar strategy is that it enjoys logistics support from the “mortar” counterpart, which complements any operational inadequacy on the side of the virtual website - the “clicks” counterpart. In the future, the clicks-and-mortar model can facilitate the merging of different businesses and strategic partnerships that will diversify sales channels as well as client sources. This study proposes developing an e-commerce clicks-and-mortar application system based on blockchain technology. The research shall focus on the following topics: (1) developing a privacy-ensuring blockchain technology by using the dark web to ensure the blockchain's privacy and safety features; (2) developing smart contracts based on blockchains to speed up transactions and reduce fees of intermediate certificate authorities; (3) creating a physical store recommendation system through deep learning so that e-commerce businesses can apply their desired criteria and search for the optimal location area for their physical store. The first year of the project will be dedicated towards developing a blockchain mechanism, creating smart contracts to expedite and smooth the way for transactions, and eliminating third-party transaction certification fees through blockchain's decentralization attribute; meanwhile, the physical store recommendation system is capable of performing analysis of multi-aspect data, such as client distribution, and select the optimal location for the store so as to provide clients with more physical experiences and services.},
 author = {Wu, Hsin-Te and Lu, Chun-Yi},
 booktitle = {2019 International Conference on Intelligent Computing and its Emerging Applications (ICEA)},
 doi = {10.1109/ICEA.2019.8858318},
 issn = {},
 keyword = {Blockchain;Business;Deep learning;Industries;Big Data;Sociology;Statistics;Smart Contract;E-commerce;clicks-and-mortar},
 month = {Aug},
 number = {},
 pages = {130-133},
 title = {A Deep Learning Application System Based on Blockchain Technology for Clicks-And-Mortar Businesses},
 volume = {},
 year = {2019}
}
