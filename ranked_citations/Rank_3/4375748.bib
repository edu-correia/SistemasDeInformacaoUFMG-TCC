@inproceedings{4375748,
 abstract = {This paper evaluates three classification techniques: Naive Bayesian (NB), multilayer perceptron (MLP) and K-nearest neighbour (KNN) that integrate diverse, large-scale functional data to infer pairwise (PW) and module-based (MB) interaction networks in Saccharomyces cerevisiae. Existing multi-source functional data from S. cerevisiae were merged and transformed to construct MB datasets. The results indicate that selection of a classifier depends upon the specific PPI classification problem. Feature integration and encoding methods proposed significantly impact the predictive performance of the classifiers. Generation of PPI maps for S. cerevisiae and beyond will be improved with new, high-quality, large-scale datasets with increased interactome coverage and the integration of classification methods.},
 author = {Browne, Fiona and Wang, Haiying and Zheng, Huiru and Azuaje, Francisco},
 booktitle = {2007 IEEE 7th International Symposium on BioInformatics and BioEngineering},
 doi = {10.1109/BIBE.2007.4375748},
 issn = {},
 keyword = {Machine learning;Proteins;Genomics;Bioinformatics;Organisms;Computer networks;Bayesian methods;Large scale integration;Encoding;Biology computing;protein-protein interactions;module-based interactions;machine and statistical learning;functional data;feature encoding;dataset integration;computational systems biology},
 month = {Oct},
 number = {},
 pages = {1365-1369},
 title = {Supervised Statistical and Machine Learning Approaches to Inferring Pairwise and Module-Based Protein Interaction Networks},
 volume = {},
 year = {2007}
}
