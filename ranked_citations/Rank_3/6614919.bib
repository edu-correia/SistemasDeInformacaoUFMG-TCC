@inproceedings{6614919,
 abstract = {Celebrities are influential nodes in Social Network Services (SNSs) whose domain classification can assist researchers to better analyze normal users' interests. In this paper, we propose an automatic classification method that extracts the celebrity's name and description as the input and the associated domain can be mapped to a domain ontology by performing Spreading activation on the knowledge base and reasoning on the domain ontology. The knowledge base is merged from YAGO ( Wikipedia and WordNet) and WordNet Domain ontology. We fetch 15,879 celebrity profiles, map them to WordNet Domain ontology, and demonstrate a satisfactory result of the mapping ratio.},
 author = {Dongsheng Wang and Kyunglag Kwon and In-Jeong Chung},
 booktitle = {2013 Fifth International Conference on Ubiquitous and Future Networks (ICUFN)},
 doi = {10.1109/ICUFN.2013.6614919},
 issn = {2165-8536},
 keyword = {Ontologies;Semantics;Cognition;Encyclopedias;Electronic publishing;Internet;SNS celebrity;doman classification and mapping;WordNet;Spreading Activation;Semantic Network},
 month = {July},
 number = {},
 pages = {744-749},
 title = {Domain classification for celebrities using spreading activation and reasoning on semantic network},
 volume = {},
 year = {2013}
}
