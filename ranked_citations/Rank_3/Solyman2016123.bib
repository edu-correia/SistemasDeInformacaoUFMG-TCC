@conference{Solyman2016123,
 abstract = {Software process improvement (SPI) aims to increase the quality of the software products or service. There are many software standers for software process improvement must be implemented during development process to achieve software quality characteristic such as functionality, reliability, efficiency, operability, security and maintainability on the other hand to reduce the development effort. There are many studies conducted to adoption SPI in small and medium enterprises in Sudan and concluded the most national institutions do not follow software process improvement standards and identified the problems faced by these companies during the implementation SPI. The current study developed a simple, efficient and inexpensive method for project management and software quality control in Sudanese SMEs by merge ISO/IEC 25010: 2011 for software quality assessment and improves with activities of the CMMI model Level II project management and other activities related to project management. The proposed method was tested in a real environment to evaluate its ability to help SMEs for increasing their software quality. However, the results demonstrate the applicability of the proposed method as well as prove that its meets the needs of SMEs and satisfy their characteristic's. © 2015 IEEE.},
 author = {Solyman, Aiman M. and Ibrahim, Osama A. and Elhag, Arafat Abdulgader Mohammed},
 doi = {10.1109/ICCNEEE.2015.7381442},
 journal = {Proceedings - 2015 International Conference on Computing, Control, Networking, Electronics and Embedded Systems Engineering, ICCNEEE 2015},
 note = {Cited by: 13},
 pages = {123 - 128},
 publication_stage = {Final},
 source = {Scopus},
 title = {Project management and software quality control method for small and medium enterprise},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84965179372?origin=resultslist},
 year = {2016}
}
