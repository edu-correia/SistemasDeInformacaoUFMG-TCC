@article{ZHOU2022104565,
 abstract = {The fibre distribution inside discontinuous-fibre reinforced polymer matrix composites (DFR PMCs) is usually characterized and analysed separately by different features such as fibre orientations and fibre lengths. There is no established method to characterize fibre packing states within the DFR PMCs, and the links between different fibre distribution features are rarely addressed. In this study, the concept of fibre cell is proposed to provide an alternative to characterize the fibre distribution within DFR PMCs. The concept involves dividing a fibre domain into smaller cells based on the location of each fibre and characterizing the fibre distribution within the fibre domain based on the fibre cell properties. Compared with traditional characterization methods, the proposed method is able to include fibre packing information, and all fibre distribution features can be characterized in a joint manner instead of separately by different fibre distribution features. The proposed method is merged into a machine learning (ML) framework to deduce the feature-property correlation via an artificial neural network. The ML framework is used as a surrogate model for fast homogenized elastic modulus predictions. Moreover, the concept of fibre cell is also very versatile and can be extended to microstructures with different material properties and inclusion shapes.},
 author = {Yuheng Zhou and Pascal Hubert},
 doi = {https://doi.org/10.1016/j.mtcomm.2022.104565},
 issn = {2352-4928},
 journal = {Materials Today Communications},
 keyword = {Discontinuous-fibre reinforced composites, Fibre structure characterization, Feature-property relationships, Machine learning},
 pages = {104565},
 title = {Properties prediction of discontinuous-fibre reinforced thermoplastic composites with fibre-cell-based fibre distribution description},
 url = {https://www.sciencedirect.com/science/article/pii/S2352492822014064},
 volume = {33},
 year = {2022}
}
