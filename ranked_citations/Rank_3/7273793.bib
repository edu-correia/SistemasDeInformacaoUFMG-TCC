@article{7273793,
 abstract = {This paper presents a new code compression method where we merge the Huffman algorithm with the formation of patterns of blocks, which are found into the dictionary. We seek two consecutive blocks in two levels, one of them into compressed code and the other related to uncompressed code. We have used simulation with SimpleScalar and programs from MiBench. Our proposal has achieved a compression rate of 34.5% and 7% improvement in code compression when compared to the Huffman traditional method.},
 author = {Azevedo Dias, Wanderson Roger and Moreno, Edward David},
 doi = {10.1109/TLA.2015.7273793},
 issn = {1548-0992},
 journal = {IEEE Latin America Transactions},
 keyword = {Benchmark testing;Reduced instruction set computing;Hardware;Dictionaries;Computational modeling;Computers;Random access memory;Code Compression;Dictionary-based Pattern Blocks;Embedded Systems;Huffman;MiBench},
 month = {July},
 number = {7},
 pages = {2314-2321},
 title = {Code Compression using Huffman and Dictionary-based Pattern Blocks},
 volume = {13},
 year = {2015}
}
