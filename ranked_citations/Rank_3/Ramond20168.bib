@conference{Ramond20168,
 abstract = {In this paper, we present a real-Time decision support system whose objective is to propose the best order of trains to run at junctions in dense areas, based on passenger punctuality. This question typically arises when two branches of a railway line (say, A and B) coming from different origins in the network merge, and trains coming from these two branches must use the same track after the junction. For each couple of trains on both branches, a choice has to be made on which train should run first after the junction: Train coming from A or from B? This choice can have a significant impact on the operating performance, and, to be efficient in terms of passenger quality of service, should take into account a large amount of information on the position of trains currently running before and after the junction, their service, the number of passengers on each origin-destination pair at a given time.. A first real-world experiment was carried out during fall 2015 at one of the most highly used junctions in the Parisian area. This experiment was performed using a software prototype relying on a dedicated approach combining real-Time data treatment, operations research and simulation algorithms. © 2016 IEEE.},
 author = {Ramond, Francois and Boillot, Adrien and Marcos, Nicolas},
 doi = {10.1109/ICIRT.2016.7588544},
 journal = {2016 IEEE International Conference on Intelligent Rail Transportation, ICIRT 2016},
 note = {Cited by: 2},
 pages = {8 - 12},
 publication_stage = {Final},
 source = {Scopus},
 title = {Real-Time decision-support algorithms to optimize train order at junctions},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84995481280?origin=resultslist},
 year = {2016}
}
