@article{Henriyadi2021267,
 abstract = {Farm Management Information System (FMIS) is an application to help farmers manage their farm. Small Farm Management Information System (sFMIS) is FMIS application targeted at small scale farmers. sFMIS only provide functionality that required by farmers. Besides, sFMIS utilize as much as possible free open data sources to reduce the cost. However, utilization of external data sources to support the sFMIS is not trivial, complicated, and faces many heterogeneity problems. This study proposed a split-match-merge method with a multi-matcher algorithm to handle those problems. Split-match-merge method aimed to make the matching process faster than a conventional method. A multi-matcher algorithm used to improve the quality in matching. The multi-matchers algorithm is a combination of several algorithms in hybrid and composite models. The hybrid model consists of exact-matcher, synonym matcher and composite similarity-matcher. Composite matcher contains Levenshtein, Jaro-Winkler, LCCS, Cosine-similarity, and Sorensen-dice algorithms. This research conducts evaluations by comparing split-match-merge methods with traditional methods and calculating the precision and recall multi-matcher algorithm. There are 282 records extracted from ontoFMIS.rdf and 430 records pulled from the data source database used for evaluation. Split-match-merged reduces the matching process from 74 to four minutes. The split-match-merge also reduce the number of matched tuples from 180 into 123 matched tuples. It means that 57 tuples indicate an orphan-tuple, a tuple that assigns as matched but has a schema heterogeneity problem. Moreover, the precision of the multi-matcher algorithm is 0.946 and recall is 0.88. This score indicated the algorithm promising in handling data interoperability problems. © 2021, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Henriyadi and Esichaikul, Vatcharaporn and Anutariya, Chutiporn},
 doi = {10.1007/978-3-030-79757-7_26},
 journal = {Lecture Notes in Networks and Systems},
 note = {Cited by: 1},
 pages = {267 - 278},
 publication_stage = {Final},
 source = {Scopus},
 title = {Split-Match-Merge Method with Multi-matcher Algorithm to Handle Data Interoperability Problems in Small Farm Management Information System},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85111414601?origin=resultslist},
 volume = {251},
 year = {2021}
}
