@conference{Erdur2012625,
 abstract = {Linked data, which aims to convert the web into a global space consisting of semantically defined and interrelated data, is the current realization of the Semantic Web. The ability to interact with linked data space should be an indispensable characteristic of a semantic web agent. However, with its own standards, technologies, tools, and the large amount of dynamically changing data that it contains, the linked data is a complex space to interact with from the agent developer's perspective. Our approach is to handle this complexity within the environment abstraction used in multi-agent systems. For this purpose, the existing environment abstraction and its related meta-model has been specialized considering the linked data perspective, and based on this specialization an environment infrastructure has been developed for semantic web agents. The developed environment infrastructure enables the integration of linked data space with the agents. © 2012 IEEE.},
 author = {Erdur, Riza Cenk and Dikenelli, Oguz and Alatli, Oylum and Ekinci, Erdem Eser and Akar, Ziya},
 doi = {10.1109/COMPSACW.2012.113},
 journal = {Proceedings - International Computer Software and Applications Conference},
 note = {Cited by: 0},
 pages = {625 - 630},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integrating linked data space with agents using the environment abstraction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84870821736?origin=resultslist},
 year = {2012}
}
