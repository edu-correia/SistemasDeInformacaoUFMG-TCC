@article{Benavent20132009,
 abstract = {Main goal of this work is to show the improvement of using a textual pre-filtering combined with an image re-ranking in a Multimedia Information Retrieval task. The defined three step-based retrieval processes and a well-selected combination of visual and textual techniques help the developed Multimedia Information Retrieval System to overcome the semantic gap in a given query. In the paper, five different late semantic fusion approaches are discussed and experimented in a realistic scenario for multimedia retrieval like the one provided by the publicly available ImageCLEF Wikipedia Collection. © 1999-2013 IEEE.},
 author = {Benavent, Xaro and Garcia-Serrano, Ana and Granados, Ruben and Benavent, Joan and De Ves, Esther},
 doi = {10.1109/TMM.2013.2267726},
 journal = {IEEE Transactions on Multimedia},
 note = {Cited by: 31; All Open Access; Bronze Open Access},
 number = {8},
 pages = {2009 - 2021},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multimedia information retrieval based on late semantic fusion approaches: Experiments on a wikipedia image collection},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84888374132?origin=resultslist},
 volume = {15},
 year = {2013}
}
