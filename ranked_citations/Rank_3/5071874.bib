@inproceedings{5071874,
 abstract = {This paper presents the design and implementation of a novel file I/O solution for Blue Gene systems. We propose a hierarchical I/O cache architecture based on open source software. Our solution is based on an asynchronous data staging strategy, which hides the latency of file system access from compute nodes. The performance results demonstrate the high scalability and significant performance improvements of our architecture over existing solutions.},
 author = {Isaila, Florin and Blas, Javier Garcia and Carretero, Jesus and Latham, Robert and Lang, Samuel and Ross, Robert},
 booktitle = {2009 9th IEEE/ACM International Symposium on Cluster Computing and the Grid},
 doi = {10.1109/CCGRID.2009.49},
 issn = {},
 keyword = {Delay;Computer architecture;File systems;Supercomputers;Scalability;Open source software;High performance computing;Merging;Grid computing;Laboratories;Parallel I/O;Parallel Systems;Distributed File Systems;Parallelism and Concurrency},
 month = {May},
 number = {},
 pages = {212-219},
 title = {Latency Hiding File I/O for Blue Gene Systems},
 volume = {},
 year = {2009}
}
