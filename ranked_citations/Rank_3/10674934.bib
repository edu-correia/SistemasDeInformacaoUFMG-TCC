@inproceedings{10674934,
 abstract = {The study suggests using a mix of renewable energy sources to power an AC-DC microgrid. This method may be used to power appliances that need either alternating current (AC) or direct current (DC). The most practical options are solar photovoltaics and wind power systems due to their minimal maintenance needs and ubiquitous availability. Because solar PV electricity is not able to produce consistent power due to changes in temperature and irradiance, a storage battery system is needed to satisfy power demands and maintain the integrity of hybrid microgridsThis method meets the varied power needs of various appliance types while enabling the effective use of renewable energy sources by merging DC and AC microgrid systems. Demand response and smart grid integration, as well as sophisticated energy management algorithms for real-time optimization, should be recent developments in microgrid power management systems.},
 author = {Chauhan, Shubham Singh and Bharatee, Anindya and Ray, Pravat Kumar},
 booktitle = {2024 IEEE International Conference on Smart Power Control and Renewable Energy (ICSPCRE)},
 doi = {10.1109/ICSPCRE62303.2024.10674934},
 issn = {},
 keyword = {Renewable energy sources;Power system management;Systems operation;Power system dynamics;Microgrids;Wind power generation;Hybrid power systems;Renewable energy sources;distributed generations;battery storage system;energy management},
 month = {July},
