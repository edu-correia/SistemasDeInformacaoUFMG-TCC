@conference{Zheng2023,
 abstract = {In this paper, a novel lossless and near-lossless RAW image compression algorithm based on JPEG-LS is proposed. To achieve high performance and low complexity, the algorithm reduce the context module, merge the run mode with the regular mode and propose an adaptive Golomb-Rice coding technique. The algorithm mainly consists of four parts : pixel structure conversion, pixel prediction, run mode module and adaptive Golomb-Rice coding module. Compared to JPEG-LS, this algorithm achieves comparable performance to JPEG-LS while reducing complexity. Additionally, it allows users to adjust parameters to achieve lossless and near-lossless compression supporting random access and non-random access. © 2023 IEEE.},
 author = {Zheng, Yeping and Li, Tingting and Li, Wei and Lei, Faxing and Liu, Jiarui and Fan, Yibo},
 doi = {10.1109/ASICON58565.2023.10396052},
 journal = {Proceedings of International Conference on ASIC},
 note = {Cited by: 4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Low-Complexity Algorithm for JPEG-LS-Based RAW Domain Compression},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85184563311?origin=resultslist},
 year = {2023}
}
