@conference{Li2024668,
 abstract = {As deep learning develops, the use of object detection to analyze image content has achieved stage-by-stage success. However, due to the problems of spatial occlusion and slow convergence, the accuracy is poor and models are complex. To address the above problems, a new YOLOv8s network structure that improves the accuracy with almost no increase in training overhead is proposed. First, the hierarchical feature extraction is utilized to enhance the positional information of the feature map by adding Coordinate Attention at backbone and neck networks layer-by-layer. Then, GCNet is introduced at the last layer of neck network to model global context and merge hierarchical features. Finally, SIOU Loss is used to accelerate the convergence speed to further improve the accuracy. The experimental results demonstrate that the enhanced model improves mAP by +4.6% over YOLOv8s and accuracy by +2.7% over YOLOv9s. Additionally, it slightly decreases model complexity and training overhead by 0.2 GFLOPs. © 2024 IEEE.},
 author = {Li, Jiafeng},
 doi = {10.1109/CISCE62493.2024.10653313},
 journal = {2024 6th International Conference on Communications, Information System and Computer Engineering, CISCE 2024},
 note = {Cited by: 1},
 pages = {668 - 673},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improving the Application of YOLOv8 in Image Object Detection},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85204738223?origin=resultslist},
 year = {2024}
