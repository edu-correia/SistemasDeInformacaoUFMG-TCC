@inproceedings{4154252,
 abstract = {Wireless integrated microsystems, merging micropower circuits, wireless interfaces, hermetic wafer-level packaging, and MEMS are poised to provide breakthroughs in health care. While cochlear microsystems have restored functional hearing to the deaf and deep brain stimulation is remarkably successful in suppressing Parkinson's tremor, retinal implants for the blind, cortical prostheses for paralysis, and other devices are also emerging, along with systems that could revolutionize our understanding of the brain. The tissue interface, device/circuit challenges, and packaging are examined along with future needs},
 author = {Wise, Kensall D.},
