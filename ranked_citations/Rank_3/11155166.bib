@article{11155166,
 abstract = {Sparse vector transmission (SVT) offers a novel approach to short-packet communications, where developing a compact sparse mapping is crucial for achieving high-reliability and low-latency transmission. This paper proposes a one-hot vector (OHV)-based sparse mapping that converts $N$ index bit streams into $N$ OHVs and then merges them into a single sparse vector. To ensure a short sparse vector constructed, we formulate the index shifting and vector shifting merging rules to resolve positional collisions arising from identical OHVs during merging. The difference between them lies in the fact that index-shifted distinct positions are correlated, whereas vector-shifted distinct positions remain independent after merging. Additionally, since the base conversion inherent in the OHVs provides a unique correspondence between the sparse vector and transmitted bits, the proposed scheme eliminates the index table used in conventional index modulation-based sparse mapping, thereby reducing the time spent on table lookup. Simulation results verify the feasibility of our proposal in the improvement of error and latency performance when a non-orthogonal codebook is given. It also demonstrates that the vector shifting merging method is both simpler and more effective than the other.},
 author = {Zhang, Xuewan and Liu, Pengxue and Xu, Xiumei},
 doi = {10.1109/TVT.2025.3608466},
 issn = {1939-9359},
 journal = {IEEE Transactions on Vehicular Technology},
 keyword = {Vectors;Indexes;Merging;Binary sequences;Static VAr compensators;Modulation;Ultra reliable low latency communication;Encoding;Sorting;Training;Sparse vector transmission;sparse mapping;short packet communications;index modulation},
 month = {March},
 number = {3},
 pages = {5121-5126},
 title = {One-Hot Vector-Based Sparse Vector Transmission for Short Packet URLLC},
 volume = {75},
 year = {2026}
}
