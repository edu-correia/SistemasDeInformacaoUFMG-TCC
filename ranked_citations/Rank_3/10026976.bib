@inproceedings{10026976,
 abstract = {Nowadays in the modern world, speech recognition has gained elevation with development of AI and many intelligent assistants. The ability of a machine or programme to recognize and react to the sounds made by human speech is known as speech recognition. So, this paper focuses on building Speech Command Recognition system of a single language that can identify predetermined keywords by employing a Convolutional Recurrent Neural Network model to reduce computational requirements. This model combines the capacity of RNN to learn the time dependent features of sequential data and the capability of CNN to learn local features. We compare the performance of convolutional neural network, convolutional recurrent neural network and pretrained network to recognize command words using the Speech Commands Dataset provided by Google's TensorFlow and Artificial Intelligence Yourself teams.},
 author = {Rajani, A and Reddy, Kistamgari Nikhitha},
 booktitle = {2022 IEEE International Symposium on Smart Electronic Systems (iSES)},
 doi = {10.1109/iSES54909.2022.00053},
 issn = {},
 keyword = {Recurrent neural networks;Network topology;Computational modeling;Merging;Speech recognition;Internet;Topology;Convolutional Neural Network;Convolutional Recurrent Neural Network;Speech Recognition;Alexnet;MFCC},
 month = {Dec},
 number = {},
 pages = {225-230},
 title = {Isolated Word Recognition based on Convolutional Recurrent Neural Network},
 volume = {},
 year = {2022}
}
