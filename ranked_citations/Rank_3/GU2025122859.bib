@article{GU2025122859,
 abstract = {In electrochemical energy devices for example, rechargeable metal-air batteries, and regenerative fuel cells, oxygen evolution reaction (OER) is one of the most important electrochemical reactions. However, the rising adsorption energy scaling interactions between intermediates due to large innate overpotential of OER and ineffective kinetics catalysts present many challenges. The need to create advanced electrocatalysts that are both highly active and stable, particularly those made of non-noble metals, is one of the issues. This review highlights the potential metal-organic frameworks (MOFs) as catalysts for OER because of their unique properties that enhance the catalyst's stability and activity. The capacity to establish a quantitative structure-activity relationship, which specifies the connection between a catalyst's activity and its structure and electronic properties, is yet another crucial factor in the rational design of effective catalysts. As a result, this paper aims to shed light on the theoretical foundations of electrocatalysis and provide a systematic overview of benchmark descriptors for OER electrolysis. It also looks at recent research that focuses on creating novel paradigms and strategies for dealing with the scaling of OER. In addition, the review discusses key obstacles, opportunities associated with improving OER performance through catalyst synthesis and outlines future trends, particularly in integrating MOFs into scalable applications.},
 author = {Yingying Gu and Chuan Zhang and Minfeng Meng and Xianlong Ge and Shaohua Hu and Yankai Song},
 doi = {https://doi.org/10.1016/j.ica.2025.122859},
 issn = {0020-1693},
 journal = {Inorganica Chimica Acta},
 keyword = {Oxygen evolution, Scaling relationship, Energy conversion and storage, Lattice oxygen oxidation, Catalytic descriptors},
 pages = {122859},
 title = {Recent advances in metal-organic complexes for hydrogen and oxygen evolution reactions: Material design and mechanistic insights},
 url = {https://www.sciencedirect.com/science/article/pii/S0020169325003251},
 volume = {588},
 year = {2025}
}
