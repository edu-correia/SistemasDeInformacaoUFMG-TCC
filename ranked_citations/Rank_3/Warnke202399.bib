@conference{Warnke202399,
 abstract = {In the context of the IoT, energy is a scarce resource. Since the transmission of data is one of the largest energy consumers, the amount of data must be reduced as much as possible. Modern database systems optimize the queries to reduce execution times. Therefore they also consider reducing the network traffic but neglect the network topology. Network topology is critical because it can consume more energy to send a few pieces of data over a long distance than to transmit a large amount of data to a neighboring device. Therefore, we propose new techniques for cooperation between routing and application layers.  © 2023 ACM.},
 author = {Warnke, Benjamin and Fischer, Stefan and Groppe, Sven},
 doi = {10.1145/3589462.3589497},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 3},
 pages = {99 - 106},
 publication_stage = {Final},
 source = {Scopus},
 title = {Distributed SPARQL queries in collaboration with the routing protocol},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85161429385?origin=resultslist},
 year = {2023}
}
