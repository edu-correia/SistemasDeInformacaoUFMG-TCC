@conference{Garcia-Gonzalez20189,
 abstract = {Data interoperability is currently a problem that we are facing more intensely due to the appearance of fields like Big Data or IoT. Many data is persisted in information silos with neither interconnection nor format homogenisation. Our proposal to alleviate this problem is ShExML, a language based on ShEx that can map and merge heterogeneous data formats into a single RDF representation. We advocate the creation of this type of tools that can facilitate the migration of non-semantic data to the Semantic Web. © 2018 CEUR-WS. All rights reserved.},
 author = {Garcia-Gonzalez, Herminio and Fernandez-Alvarez, Daniel and Labra-Gayo, Jose Emilio},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 4},
 pages = {9 - 12},
 publication_stage = {Final},
 source = {Scopus},
 title = {ShExML: An heterogeneous data mapping language based on ShEx},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85058148913?origin=resultslist},
 volume = {2262},
 year = {2018}
}
