@article{Xing2022,
 abstract = {Model-based systems engineering (MBSE) with SysML has become one of the best solutions to the system design of complex systems, which usually requires the collaboration of different disciplines. Web-based collaborative modeling method looks like a prioritized option because of its advantages such as “light” client, convenient maintenance, and high model reliability. In this study, we propose a web-based collaborative SysML modeling method for MBSE. First, the architectures of asynchronous and synchronous collaboration are given. Then, some key technologies for both collaborative modes are discussed. Finally, a case study is given to demonstrate the effectiveness of the proposed method. Copyright © 2022 by ASME.},
 author = {Xing, Tao and Zhou, Chenchu and Shen, Xing and Wu, Dawei and Li, Qian and Liu, Yusheng},
 doi = {10.1115/1.4055240},
 journal = {Journal of Computing and Information Science in Engineering},
 note = {Cited by: 3},
 number = {6},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Web-Based Collaborative Method for SysML Modeling},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85145357234?origin=resultslist},
 volume = {22},
 year = {2022}
}
