@inproceedings{8981411,
 abstract = {This study aims to apply the concept of markerless augmented reality through learning comics to improve students' metacognitive abilities, metacognitive abilities need to be improved because they relate to creativity, creativity and the correlation of other abilities in learning. This study uses the Borg and Gall development method with the aim of developing consistent and disseminated products, the result of this research is the development of Augmented Reality applications with the Markerless AR concept coupled with learning comics that have passed expert validation tests with an average percentage validity of 98.3%, then the material developed in this study also fulfills the learning outcomes with an average percentage of validity from material experts at 97.9%. Besides that, the development of AR Application with the concept of Markless AR has an average value of the percentage of prospective user trials of 98.1%, it is said to be high in the level of usability and level of flexibility of use. with a test value of 0.981. This increase is possible because other factors namely imaginative abilities and integration capabilities also increased due to the use of Markerless AR. It can be concluded that markerless augmented reality research through learning comics can improve students' metacognitive abilities.},
 author = {Nidhom, Ahmad Mursyidun and Smaragdina, Azhar Ahmad and Dyah, K N Gres and Andika, Bagus Nur R P and Setiadi, Cahyono P and Yunos, Jailani Md},
 booktitle = {2019 International Conference on Electrical, Electronics and Information Engineering (ICEEIE)},
 doi = {10.1109/ICEEIE47180.2019.8981411},
 issn = {},
 keyword = {Technological innovation;Merging;Metacognition;Media;Hybrid learning;Usability;Augmented reality;Creativity;Videos;Testing;Learning Comics;Augmented Reality},
 month = {Oct},
 number = {},
 pages = {201-205},
 title = {Markerless Augmented Reality (MAR) through Learning Comics to Improve Student Metacognitive Ability},
 volume = {6},
 year = {2019}
}
