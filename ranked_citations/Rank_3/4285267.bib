@inproceedings{4285267,
 abstract = {One of the challenges in SOA is to identify the services that can be used to build a service process. An SOA infrastructure must provide an efficient and effective way to select compatible web service(s) and compose them into a functional service process that satisfies a user's needs. Moreover, the web services(s) selected may be integrated with structures such as branches and merges to fulfill a task. This paper describes our system architecture and strategies on web services composition based on semantic matching. Our strategies include backward service composition using a breadth-first search tree and heuristic prioritization.},
 author = {Zhang, Yue and Raman, Krishna and Panahi, Mark and Lin, Kwei-Jay},
 booktitle = {The 9th IEEE International Conference on E-Commerce Technology and The 4th IEEE International Conference on Enterprise Computing, E-Commerce and E-Services (CEC-EEE 2007)},
 doi = {10.1109/CEC-EEE.2007.53},
 issn = {2378-1971},
 keyword = {Merging;Web services;Service oriented architecture;Memory management;Delay;Large-scale systems},
 month = {July},
 number = {},
 pages = {525-528},
 title = {Heuristic-based Service Composition for Business Processes with Branching and Merging},
 volume = {},
 year = {2007}
}
