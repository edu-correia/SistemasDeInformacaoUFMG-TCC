@inproceedings{6701586,
 abstract = {Biosimulation researchers use a variety of models, tools and languages for capturing and processing different aspects of biological processes. However, current modeling methods do not capture the underlying semantics of the biosimulation models sufficiently to support building, reusing, composing and merging complex biosimulation models originating from diverse experiments. In this paper, we propose an ontology based and multi-layered biosimulation model to facilitate researchers to share, integrate and collaborate their knowledge bases at Web scale. In particular, we investigate the semantic biosimulation model under the context of the multi-scale finite element (FE) modelling of the inner-ear. The proposed ontology-based biosimulation model will provide a homogenized and standardized access to the shared, semantically integrated and harmonized datasets for clinical data (histological data, micro-CT images of the cochlea, pathological data) and inner ear FE simulation models. The work presented in this paper is analyzed and designed as part of the SIFEM EU project.},
 author = {Freitas, Andre and Jones, Margaret and Asooja, Kartik and Bellos, Christos and Elliott, Steve and Stenfelt, Stefan and Hasapis, Panagiotis and Georgousopoulos, Christos and Marquardt, Torsten and Filipovic, Nenad and Decker, Stefan and Sahay, Ratnesh},
 booktitle = {13th IEEE International Conference on BioInformatics and BioEngineering},
 doi = {10.1109/BIBE.2013.6701586},
 issn = {},
 keyword = {Biological system modeling;Data models;Ontologies;Semantics;Mathematical model;Computational modeling;Analytical models},
 month = {Nov},
 number = {},
 pages = {1-5},
 title = {Towards a semantic representation for multi-scale finite element biosimulation experiments},
 volume = {},
 year = {2013}
}
