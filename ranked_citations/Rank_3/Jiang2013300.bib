@article{Jiang2013300,
 abstract = {In this paper, we study how to better merge a WordNet-like ontology with an online encyclopedia. We first eliminate the noises with some heuristic rules, and then adopt a domain-dependent strategy to trim the encyclopedia structure. Finally, we integrate entities from the trimmed structure into the original ontology, and construct a refinedly-enriched ontology. The experimental results show that this ontology can achieve better performance than the original version as well as a coarsely-enriched version constructed without pruning and trimming. © Springer-Verlag 2013.},
 author = {Jiang, Shan and Nian, Jiazhen and Zhao, Shi and Zhang, Yan},
 doi = {10.1007/978-3-642-53914-5_26},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 number = {PART 1},
 pages = {300 - 312},
 publication_stage = {Final},
 source = {Scopus},
 title = {Small is powerful! Towards a refinedly enriched ontology by careful pruning and trimming},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84893133737?origin=resultslist},
 volume = {8346 LNAI},
 year = {2013}
}
