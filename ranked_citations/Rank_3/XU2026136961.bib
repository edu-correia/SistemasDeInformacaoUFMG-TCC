@article{XU2026136961,
 abstract = {Fuel staging strategy critically influences combustion in staged combustors. This study develops a centrally-staged combustor with a two-stage swirling structure and a three-stage fuel supply. Effects of varying fuel staging patterns and ratios on combustion and emissions under full-load conditions are investigated via experiments and numerical simulations. The main results show that across fuel staging strategies, swirling and cooling air proportions remain approximately 77 % and 23 %, with higher velocities near the outer passages of the first-stage swirler. Fuel distribution exhibits stratification, while a stable V-shaped flame forms via merging. Thermal NOX formation is mainly driven by the primary high-temperature zone exceeding 2100 K. Under the same fuel-staging-ratio, pilot fuel activation increases the separation between the central fuels and the second main fuel, pushing and stretching the flame further downstream, causing the primary high-temperature zone to extend, followed by expansion of the rapid thermal NOX formation region. Under the identical fuel staging pattern, reducing the second main fuel to 80 % narrows its separation from central fuels, increasing their concentration and promoting a compact flame that extends toward the thermal shield, thereby enlarging the rapid thermal NOX formation region due to elevated peak temperature and expansion of the primary high-temperature zone. The fuel staging strategy in a centrally-staged combustor should consider both minimizing spatial separation between staged fuels and maintaining a reasonable fuel-staging-ratio. The minimum NOX emissions of 48.10 ppm is achieved with the pilot fuel inactive and the second main fuel proportion set to 90 %, accompanied by 2.60 ppm CO emissions.},
 author = {Honghao Xu and Liyao Pang and Ningbo Zhao and Hongtao Zheng},
 doi = {https://doi.org/10.1016/j.fuel.2025.136961},
 issn = {0016-2361},
 journal = {Fuel},
 keyword = {Fuel staging, Centrally-staged combustor, Low-emission, Flame structure, Combustion performance},
 pages = {136961},
 title = {Effects of fuel staging strategy on combustion and emissions in a centrally-staged swirling combustor: experimental and numerical investigations},
 url = {https://www.sciencedirect.com/science/article/pii/S0016236125026869},
 volume = {406},
 year = {2026}
}
