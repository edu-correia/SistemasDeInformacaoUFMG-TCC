@article{Jaffri20071125,
 abstract = {The Semantic Web vision involves the production and use of large amounts of RDF data. There have been recent initiatives amongst the Semantic Web community, in particular the Linking Open Data activity and our own ReSIST project, to publish large amounts of RDF that are both interlinked and dereferenceable. The proliferation of such data gives rise to millions of URIs for non-information resources such as people, places and abstract things. Frequently, different data providers will mint different URIs for the same resource, giving rise to the problem of coreference. This paper describes the phenomenon of coreference, where it occurs in other disciplines and how it is relevant to the Semantic Web. We propose a 'Consistent Reference Service' for URI identity management and describe how this is being used in the infrastructure of a scalable Semantic Web system. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Jaffri, Afraz and Glaser, Hugh and Millard, Ian},
 doi = {10.1007/978-3-540-76890-6_40},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 11},
 number = {PART 2},
 pages = {1125 - 1134},
 publication_stage = {Final},
 source = {Scopus},
 title = {URI identity management for Semantic Web data integration and linkage},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/38349105971?origin=resultslist},
 volume = {4806 LNCS},
 year = {2007}
}
