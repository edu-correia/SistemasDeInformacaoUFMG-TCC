@conference{Cross2014,
 abstract = {Ontologies play a central role in the Semantic Web. Much research has focused on extending ontologies and Semantic Web technologies to handle uncertain information. This paper provides a review of recent approaches for extending ontologies to fuzzy ontologies. Some approaches have been developed for application specific purposes, for example for information retrieval and search on the Semantic Web and are not formally relying on current Semantic Web technologies such as standard web ontology languages and tools such as ontology editors or reasoners. Other approaches emphasize developing methods to extend Semantic Web standard technologies with fuzzy logic and fuzzy reasoning. © 2014 IEEE.},
 author = {Cross, V.V.},
 doi = {10.1109/NORBERT.2014.6893867},
 journal = {2014 IEEE Conference on Norbert Wiener in the 21st Century: Driving Technology's Future, 21CW 2014 - Incorporating the Proceedings of the 2014 North American Fuzzy Information Processing Society Conference, NAFIPS 2014, Conference Proceedings},
 note = {Cited by: 12},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Fuzzy ontologies: The state of the art},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84908628044?origin=resultslist},
 year = {2014}
}
