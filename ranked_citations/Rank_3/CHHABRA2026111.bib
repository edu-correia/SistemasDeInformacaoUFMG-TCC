@incollection{CHHABRA2026111,
 abstract = {This case study explores the entrepreneurial journey of Rashi's Elixir, a handcrafted skin and hair care brand that merges traditional Indian remedies with sustainable business practices. Founded by Rashi Goplani, a commerce department head and university faculty member, the brand offers a diverse range of products infused with herbs and oils, promoting natural, therapeutic solutions that are both affordable and environmentally conscious. Rashi's commitment to sustainability is reflected in her cultivation of ingredients in her home and office gardens, ensuring eco-friendly production processes. Despite initial skepticism surrounding the business's potential, Rashi overcame early challenges by establishing strategic partnerships with suppliers and logistics providers. Her decision to develop a comprehensive website enabled the brand's growth beyond social media, expanding from two products to over 50 by 2024. The brand's evolution from a direct-to-consumer model to a national presence through e-commerce and exhibitions highlights the importance of strategic planning, digitalization, and sustainability in modern entrepreneurship. This case offers students an in-depth analysis of the unique challenges and opportunities faced by women-led businesses in a competitive marketplace, emphasizing the significance of sustainable business practices as a driver of both business growth and brand reputation. Students will gain insights into how blending personal passion with professional expertise, alongside innovative use of digital platforms, can foster resilience and long-term success. The case provides valuable lessons on entrepreneurship, sustainability, and brand development, encouraging students to critically assess the interplay between sustainability and business growth in the context of women-led ventures. This case study exemplifies a woman-led entrepreneurial journey that integrates sustainable practices from inception. The focus is on how Rashi balanced financial challenges with a commitment to eco-friendly business models.},
 author = {Meghna Chhabra and Indra Meghrajani},
 booktitle = {Women’s Entrepreneurship and the Sustainable Development Goals},
 doi = {https://doi.org/10.1016/B978-0-443-28802-9.00007-5},
 editor = {Léo-Paul Dana and Meghna Chhabra},
 isbn = {978-0-443-28802-9},
 keyword = {Business growth, Consumer behavior, Digitalization, Entrepreneurship, Innovation, Marketing, Resource efficiency, Social responsibility., Specific industry, Sustainability practices, Sustainable development},
 pages = {111-133},
