@article{JUBAIR2026101300,
 abstract = {Saint Martin’s Island, Bangladesh's southernmost territory in the Bay of Bengal, holds critical geopolitical and economic value. However, its security is increasingly threatened by unresolved territorial disputes with Myanmar, regional power competition, transnational crime, and severe environmental degradation driven by climate change. The recent political transition in the post-Hasina era introduces significant uncertainties, heightening the island's strategic vulnerabilities. This study analyzes the island's strategic vulnerabilities by examining its geopolitical significance and the multifaceted security challenges it faces in a dynamic political landscape. Employing a qualitative case study approach, secondary data analysis was conducted using academic journals, government reports, policy documents, and publications from international organizations and think tanks. The analysis reveals that geopolitical tensions, particularly with Myanmar, have intensified due to its naval modernization and the activities of non-state armed groups. The island faces significant maritime security risks from piracy and transnational crime, compounded by a lack of comprehensive surveillance capabilities. Furthermore, environmental threats, including a projected sea-level rise of up to 1.1 meters by 2100 under high-emissions scenarios and unsustainable tourism, pose an existential risk to the island’s viability. The study proposes a multi-pronged strategy emphasizing modernized maritime surveillance, proactive diplomacy with neighboring states, the integration of climate security into national policy, and the sustainable development of a blue economy. This research provides a timely and integrated analysis of the security challenges facing Saint Martin’s Island, uniquely contextualized within the political shifts of the post-Hasina era, offering a forward-looking policy framework that bridges national security, foreign policy, and environmental sustainability.},
 author = {Hassan Jubair and Mithela Mehenaz},
 doi = {https://doi.org/10.1016/j.nexres.2025.101300},
 issn = {3050-4759},
 journal = {Next Research},
 keyword = {Saint Martin Island, Maritime security, Bangladesh, Bay of Bengal geopolitics, Blue economy governance},
 pages = {101300},
 title = {Securing Saint Martin's Island amid geopolitical shifts and maritime threats in a post-Hasina Bangladesh: A strategic imperative},
 url = {https://www.sciencedirect.com/science/article/pii/S3050475925011650},
 volume = {5},
 year = {2026}
}
