@article{BUGAJ2023119005,
 abstract = {In this paper the elaboration of the first prototype of flexible photovoltaic thermal collector (FPVT) has been presented. The device consisted of cross-connected copper tubes merged with a silicone pipes attached to a semi-flexible silicon PV module. The FPVT was a subject of studies to develop the testing methodology of bendable solar devices. Basing on results, the new indicators to assess their performance under bending conditions were proposed, first of all Bending Angle Modifier (BAM). Furthermore, the testing procedure allowing to evaluate and compare individual solutions concerning the degree and method of their bending were introduced. Tests conducted according to the methodology confirmed that it provides reproducible results and the developed coefficients well reflect the changes in performance of the FPVT depending on deflection. Additionally, they revealed the performance of thermal and electrical part of FPVT is analogous considering their character and values.},
 author = {Marcin A. Bugaj and Krzysztof Mik},
 doi = {https://doi.org/10.1016/j.renene.2023.119005},
 issn = {0960-1481},
 journal = {Renewable Energy},
 keyword = {Flexible photovoltaic thermal collector, Methodology, Bending angle modifier, Solar collector},
 pages = {119005},
 title = {Can PVT bend?: The elaboration of flexible hybrid photovoltaic thermal solar collector structure and testing methodology},
 url = {https://www.sciencedirect.com/science/article/pii/S0960148123009175},
 volume = {215},
 year = {2023}
}
