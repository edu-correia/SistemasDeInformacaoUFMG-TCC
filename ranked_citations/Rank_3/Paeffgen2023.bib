 publication_stage = {Final},
 source = {Scopus},
 title = {Organisational Resilience during COVID-19 Times: A Bibliometric Literature Review},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85146035455?origin=resultslist},
