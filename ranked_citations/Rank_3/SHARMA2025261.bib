@incollection{SHARMA2025261,
 abstract = {The integration of the Internet, virtual reality (VR), augmented reality (AR), and artificial intelligence (AI) has generated the vast virtual ecosystem known as the metaverse, which has the capability to completely change the healthcare sector. The merging of a virtually enhanced physical world along with persistent virtual space gives rise to the metaverse, which is about to transform various sectors, including healthcare. This chapter investigates how the metaverse is changing healthcare, looking at new developments in technology, possible uses, and the revolutionary effects on patient treatment, education in medicine, and studies. This study address the major developments, obstacles, and moral issues influencing the healthcare industry’s use of the metaverse. Medical digital twins are crucial for establishing connections between the physical world and the metaverse because they replicate medical assets. These facilitate the provision of virtual medical services to patients and enable them to fully immerse themselves in external environments. The incorporation of metaverse technology in healthcare presents novel opportunities to revolutionize health support. The metaverse improves patient care, medical education, and health monitoring by incorporating digital health innovations, including wearables, blockchain, AI, and VR. AI and machine learning enable tailored medication and statistical analysis, while VR offers immersive therapeutic experiences and simulated training environments. Blockchain guarantees patient confidentiality and data security. This chapter addresses the necessity for interdisciplinary collaboration, standardization problems, and legal and ethical implications. Case studies underscore the metaverse’s revolutionary potential in healthcare by showcasing successful applications and lessons gained. An inclusive, effective, and creative healthcare ecosystem within the metaverse is envisioned, along with future trends, research needs, and problems.},
 author = {Nikita Sharma and Kriti Sankhla and Hemlata Jain and Ajay Khunteta},
 booktitle = {Healthcare Frontiers in the Metaverse},
 doi = {https://doi.org/10.1016/B978-0-443-32998-2.00008-1},
 editor = {Shalli Rani},
 isbn = {978-0-443-32998-2},
 keyword = {Metaverse, artificial intelligence, healthcare, blockchain, data security},
 pages = {261-291},
 publisher = {Academic Press},
 title = {Chapter 13 - Healthcare frontiers in the metaverse: innovations and impacts},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443329982000081},
 year = {2025}
}
