@inproceedings{10563962,
 abstract = {In the ever-evolving world of the Internet of Things (IoT), sensors play a crucial role as essential parts, linking and merging different elements to create a smart worldwide network. This study examines the crucial function of sensors in the Internet of Things (IoT) ecosystem, where they serve as sensory organs that translate the intricacies of the physical world into a uniform language for networked systems. The main emphasis is on their ability to gather and evaluate factual data from the surroundings, which impacts the performance and effectiveness of IoT applications in many industries. This research explores the uses and relevance of many sensor types, including temperature, humidity, proximity, motion, gas, biometric, vibration, image, infrared (IR), occupancy, water quality, pressure, light, and sound sensors. Although sensors contribute to the improvement of automation, control systems, and predictive analysis, they also give rise to issues in terms of security, interoperability, and power efficiency. The convergence of edge computing, artificial intelligence (AI), quantum sensors, 5G connection, and improved sensor integration has the potential to bring about significant changes in the Internet of Things (IoT) environment. The study provides a thorough survey of sensor applications in several domain including healthcare, agriculture, smart cities, and automotive sectors. Lastly, it examines the difficulties and potential opportunities, highlighting the vital significance of sensors in influencing the future of interconnection and data-driven decision-making.},
 author = {Rajora, Ricky and Rajora, Aarju and Sharma, Bhanu and Aggarwal, Priyanshi and Thapliyal, Siddhant},
 booktitle = {2024 4th International Conference on Innovative Practices in Technology and Management (ICIPTM)},
 doi = {10.1109/ICIPTM59628.2024.10563962},
 issn = {},
 keyword = {Temperature sensors;Decision making;Sensor systems;Sensors;Internet of Things;Biosensors;Security;Sensors Technology;Internet of Things (IoT);Data Monitoring;Artificial Intelligence (AI) Integration},
 month = {Feb},
 number = {},
 pages = {1-5},
 title = {Sensing the Future: Challenges and Trends in IoT Sensor Technology},
 volume = {},
