@inproceedings{8484019,
 abstract = {With the continuous development of modern technology, expressway toll stations take more efficient and innovative way, making the drivers own a better service experience when passing through the toll station. Whether the performance of the toll station is superior depends on whether the construction of the toll plaza is reasonable. The merits and demerits of a toll plaza need to be considered from the aspects of safety, traffic carrying capacity and fee structure. In this passage, we use the hydrodynamic model to replace the discrete and macroscopic vehicle groups with continuous and microscopic water flow. We get the conclusion that the trapezoidal region is most suitable for vehicle merging from the low curvature fusiform orbit. At the same time, we use cellular automaton to simulate the process of vehicle merging, and verify the conclusion that the merge area should be trapezoidal. On this basis, according to the different ways of charging, we propose the construction of irregular multi-level trapezoidal lane area according to different service level. Next, we establish a layer-by-layer progressive analysis model to analyze the relationship between the merge method and security level, road throughput and cost, so we can get the best way to construct the toll plaza under certain expectation and requirement. We have analyzed the construction of the square under the general conditions, and obtained the conclusion that the double side single joint method can meet the requirements of traffic safety and road throughput to the maximum extent. And the size of the toll plaza is proportional to the traffic volume and the speed of the merge.},
 author = {He, Xiongnan and Jiang, Songchen and Zhong, Lingtong and Sun, Qiuye},
 booktitle = {2018 37th Chinese Control Conference (CCC)},
 doi = {10.23919/ChiCC.2018.8484019},
 issn = {1934-1768},
 keyword = {Analytical models;Costs;Roads;Computational modeling;Merging;Throughput;Hydrodynamics;Safety;Security;Vehicles;hydrodynamic model;Toll Plaza;Progressive Analysis},
 month = {July},
 number = {},
 pages = {7961-7968},
 title = {Optimization of Toll Plaza Based on Progressive Analysis},
 volume = {},
 year = {2018}
}
