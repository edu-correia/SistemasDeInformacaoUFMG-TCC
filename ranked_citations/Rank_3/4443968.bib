@inproceedings{4443968,
 abstract = {In this paper we have studied the possibility of increasing mobile communication cell capacity through merging two communication systems in one cell. We suppose that the two systems must have interference immunity from each other, so they can work separately in the same cell and hence the overall cell capacity would be the sum of the two systems' users. The two candidates are: the TDMA system, and the WCDMA system. The two basic baseband systems have been built and simulated using MATLAB. From the simulation results, it is concluded that the two systems can work in one cell to increase cell capacity; but with partially sacrificing in the two systems' BER.},
 author = {Al-Adwany, Maan A. S.},
 booktitle = {2007 IEEE International Workshop on Radio-Frequency Integration Technology},
 doi = {10.1109/RFIT.2007.4443968},
 issn = {},
 keyword = {Multiaccess communication;Time division multiple access;Interference;Narrowband;Mobile communication;Baseband;Spread spectrum communication;Radio frequency;Educational institutions;Merging;WCDMA;TDMA;capacity;simulation},
 month = {Dec},
 number = {},
 pages = {270-273},
 title = {A Study on Cell Capacity in WCDMA & TDMA Systems},
 volume = {},
 year = {2007}
}
