@conference{Hong2008156,
 abstract = {Aiming at the practical questions of airline companies, such as the platform used to analyze the QAR data is not unified, lots of missing values, duplicate records and noise data in decoded QAR data, which seriously affect the efficiency of analysis of the QAR data. Thus, in this paper we present to analyze the data by designing QAR data warehouse, describe how to define the QAR data subjects, put forward a star schema, propose a cleaning framework of data preprocessing based on subjects and introduce the cleaning methods that are appropriate to QAR data and design multi-dimensional model by ETL, implement the farther research on QAR data through analyzing exceed the limits, so this can improve flight character and factor of safety for airline companies. © 2008 IEEE.},
 author = {Hong, Wang and Xiuxia, Huan and Hongwei, Wang and Jiang, Changbing and Peng, Yang},
 doi = {10.1109/IITA.2008.533},
 journal = {Proceedings - 2008 2nd International Symposium on Intelligent Information Technology Application, IITA 2008},
 note = {Cited by: 4},
 pages = {156 - 162},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research and implementation of QAR data warehouse},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/63149098900?origin=resultslist},
 volume = {3},
 year = {2008}
}
