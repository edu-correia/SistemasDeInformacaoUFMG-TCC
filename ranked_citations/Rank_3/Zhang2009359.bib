@article{Zhang2009359,
 abstract = {Cloud computing is a new network computing paradigm of distributed application environment. It utilizes the computing resource and storage resource to dynamically provide on-demand service for users. The distribution and parallel characters of cloud computing can leverage the railway freight system. We implement a cloud computing-based architecture for freight system application, which explores the Tashi and Hadoop for virtual resource management and MapReduce-based search technology. We propose the semantic model and setup configuration parameter by experiment, and develop the prototype system for freight search and tracking. © 2009 Springer-Verlag.},
 author = {Zhang, Baopeng and Zhang, Ning and Li, Honghui and Liu, Feng and Miao, Kai},
 doi = {10.1007/978-3-642-10665-1_33},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 7},
 pages = {359 - 368},
 publication_stage = {Final},
 source = {Scopus},
 title = {An efficient cloud computing-based architecture for freight system application in China railway},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/71749085299?origin=resultslist},
 volume = {5931 LNCS},
 year = {2009}
}
