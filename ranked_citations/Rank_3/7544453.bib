@article{7544453,
 abstract = {Palette mode and intra block copy are two new coding tools that have been adopted in the screen content coding extensions of high efficiency video Ccoding (HEVC SCC). Palette mode can represent color clusters for screen content efficiently. Intra block copy (IBC) facilitates block prediction within the same frame. Both tools have demonstrated promising benefits for screen content coding. In addition to HEVC SCC, this paper introduces five new coding techniques to enhance palette mode or IBC: transition copy, prediction across coding unit boundary, advanced motion vector coding, modified temporal merge candidate derivation, and new default IBC merge candidates. Experimental results show that the proposed techniques can achieve 5.4%, 5.2%, and 4.9% BD-rate savings compared with HEVC SCC for “YUV, text & graphics with motion, 1080p & 720p sequences” under all intra, random access, and low-delay B common test conditions, respectively.},
 author = {Sun, Yu-Chen and Hsiang, Shih-Ta and Kim, Jungsun and Chen, Yi-Wen and Xu, Xiaozhong and Zhu, Weijia and Lei, ShawMin},
 doi = {10.1109/JETCAS.2016.2598193},
 issn = {2156-3365},
 journal = {IEEE Journal on Emerging and Selected Topics in Circuits and Systems},
 keyword = {High efficiency video coding;Color;Image color analysis;Correlation;Syntactics;High efficiency video coding (HEVC);intra block copy;palette mode;screen content coding (SCC)},
 month = {Dec},
 number = {4},
 pages = {433-445},
 title = {Improvements of HEVC SCC Palette Mode and Intra Block Copy},
 volume = {6},
 year = {2016}
}
