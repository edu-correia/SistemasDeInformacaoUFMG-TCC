@inproceedings{7116086,
 abstract = {In this paper, we remodel the rumor propagation process using Petri net and demonstrate the possibility of describing dynamic behaviors of social networks in Petri net. First, we transform popular Susceptible-Infected-Removed epidemic model into Petri net, from which single rumor model is derived. The single rumor model denotes a basic unit of information propagation and can be tuned for other kinds of information like clarification. By merging rumor and clarification units and making them compete on tokens, the model for multiple pieces of information propagating is finally built up. According to rumor spreading data collected from Weibo.com, we primarily tune the parameters of the model. The model output is compared with real world data and explanatory power of the model is achieved.},
 author = {Wang, Zhonglei and Wen, Tianyu and Wu, Weimin},
 booktitle = {2015 IEEE 12th International Conference on Networking, Sensing and Control},
 doi = {10.1109/ICNSC.2015.7116086},
 issn = {},
 keyword = {Petri nets;Mathematical model;Diseases;Social network services;Numerical models;Data models;Discrete-event systems;Petri net;epidemic model;social network;rumor propagation},
 month = {April},
 number = {},
 pages = {492-497},
 title = {Modeling and simulation of rumor propagation in social networks based on Petri net theory},
 volume = {},
 year = {2015}
}
