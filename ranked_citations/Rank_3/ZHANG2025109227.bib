@article{ZHANG2025109227,
 abstract = {With the advancement of terahertz (THz) technology, the demand for functional devices has been continuously growing. Although laser etching technology offers an effective approach for processing THz devices, mode field control devices remain highly scarce. Here, we propose a type of THz corrugated plate waveguides with a microcavity in the middle to achieve distinct mode localization effects. The periodically corrugated walls efficiently attenuate THz radiation propagating through the waveguide in the so-called Bragg bandgaps. Notably, introducing a microcavity into the corrugated waveguide disrupts structure periodicity, giving rise to additional transmission peaks. Unlike the single peak observed in the first Bragg bandgap, the two transmission peaks emerge in the second gap, which can be attributed to the creation of transverse and longitudinal cavity mode localizations. Furthermore, by changing the geometric parameters of the microcavity, the mode transmission peaks gradually move towards each other, merge into a single peak, and then split back into the two peaks. Both transverse and longitudinal mode localizations are red shifts as the cavity size increases, with the transverse mode more sensitive to the changes. The characteristics of the crossed frequency shift behavior are validated in the subsequent experiments through the transmitted THz spectra of the fabricated parallel-plate waveguide structure.},
 author = {Ya-Yun Zhang and Jing Ma and Huan Liu and Ya-Xian Fan and Zhi-Yong Tao},
 doi = {https://doi.org/10.1016/j.optlaseng.2025.109227},
 issn = {0143-8166},
 journal = {Optics and Lasers in Engineering},
 keyword = {Cavity modes, Resonances, Periodic corrugations, Additional transmission},
 pages = {109227},
 title = {Localization of transverse and longitudinal modes in corrugated terahertz waveguides with a microcavity},
 url = {https://www.sciencedirect.com/science/article/pii/S0143816625004129},
 volume = {194},
 year = {2025}
}
