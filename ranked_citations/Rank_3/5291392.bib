@inproceedings{5291392,
 abstract = {Lossy compression has been widely used to reduce the bandwidth for image/video transmission or storage, especially in networks in which high compression ratio is often expected. However, the coded video suffers from different degree of distortions. Post-processing can reduce these distortions and alleviate the conflict between bit rate reduction and quality preservation. In this paper we propose a linear minimum mean square error (LMMSE) based post-processing algorithm in DCT domain to enhance the video quality after compression. We treat the reconstructed DCT coefficients before deblocking and after deblocking as two noisy observations of the DCT coefficients of the original frame, and try to estimate the original ones by merging the two observations optimally. Experimental results demonstrate that our proposed algorithm can efficiently improve the video quality by about 0.5 dB.},
 author = {Yang, Wen and Au, Oscar C. and Zou, Feng and Dai, Jingjing and Pang, Chao and Wen, Xing},
 booktitle = {2009 IEEE Pacific Rim Conference on Communications, Computers and Signal Processing},
 doi = {10.1109/PACRIM.2009.5291392},
 issn = {2154-5952},
 keyword = {Automatic voltage control;Video compression;Discrete cosine transforms;Image coding;Image storage;Propagation losses;Bandwidth;Bit rate;Mean square error methods;Image reconstruction},
 month = {Aug},
 number = {},
 pages = {82-87},
 title = {A novel post-processing method for H.264/AVC video quality enhancement},
 volume = {},
 year = {2009}
}
