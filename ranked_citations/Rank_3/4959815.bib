@inproceedings{4959815,
 abstract = {A top-down image segmentation method is proposed in this paper, utilizing level set image representation and the piecewise-constant Mumford-Shah functional. The method achieves top-down hierarchical segmentation by taking advantage of the tree structure provided by level set image representation. The piecewise-constant Mumford-Shah functional is utilized in the proposed method to determine if each node in the tree segments the image. Experimental results show that this method is able to segment complicated real images.},
 author = {Pan, Yongsheng},
 booktitle = {2009 IEEE International Conference on Acoustics, Speech and Signal Processing},
 doi = {10.1109/ICASSP.2009.4959815},
 issn = {2379-190X},
 keyword = {Image segmentation;Level set;Image representation;Shape;Tree data structures;Merging;Pixel;Image processing;Process design;Minimization methods;Image segmentation;the Mumford-Shah functional;level set image representation;tree of shapes;region merging},
 month = {April},
 number = {},
 pages = {1241-1244},
 title = {Top-down image segmentation using the Mumford-Shah functional and level set image representation},
 volume = {},
 year = {2009}
}
