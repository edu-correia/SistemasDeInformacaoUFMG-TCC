@article{Chen20261126,
 abstract = {Hard shoulder running is a freeway traffic control strategy that temporarily converts shoulders into travel lanes to increase the roadway capacity during peak hours. Such hard shoulder running sections may terminate at deceleration lanes. In cases where the deceleration lane is a single lane, two exiting traffic streams, one from the rightmost general-purpose lane and the other from the shoulder, must merge onto a single lane. If not properly controlled, such merging activities could potentially result in excessive congestion, especially when exiting volumes are high. Hence, this study proposes an Integrated Proactive Hard Shoulder Running control system to mitigate such potential congestion with hard shoulder running, advisory messages for executing lane changes, and ramp controls to meter the upstream entry flows. The merging impacts of exiting flows on the mainline traffic assessed in the proposed system are estimated with a customized macroscopic traffic model to best preserve the benefits of hard shoulder running while addressing the associated negative impacts. The system’s evaluation first starts with using extensive field data on different days from a Taiwan freeway section to confirm the model’s effectiveness with respect to reduction in congestion and emissions, then followed by extensive performance analyses under various driver compliance rates to the posted lane-changing advisory message. Additionally, multiple commonly used surrogate safety measures are employed to evaluate the proposed system. All analysis results demonstrate that the proposed system for hard shoulder running can indeed yield the expected benefits of reducing delays and emissions, while increasing safety and throughput. © 2000-2011 IEEE.},
 author = {Chen, Yen-Yu},
 doi = {10.1109/TITS.2025.3630808},
 journal = {IEEE Transactions on Intelligent Transportation Systems},
 note = {Cited by: 0},
 number = {1},
 pages = {1126 - 1144},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mitigating Bottlenecks Caused by Freeway Exiting Flows’ Merging Maneuvers to Hard Shoulder: An Integrated Proactive Control},
 type = {Article},
