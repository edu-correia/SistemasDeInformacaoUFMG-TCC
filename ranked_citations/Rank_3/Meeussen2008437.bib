@article{Meeussen2008437,
 abstract = {This paper presents the Compliant Task Generator, a new approach for the automatic conversion of a geometrical contact path into a force-based task specification. A contact path planner generates a sequence of six-dimensional poses and corresponding contact formations, while a hybrid robot controller expects a desired wrench, twist and the local wrench and twist subspaces. Our approach automatically converts a geometrical path description into a force based tasks specification for the hybrid controller, based on a user specified input of the magnitudes and the norms of the desired contact force and execution speed. The approach applies to all contact motions between known polyhedral objects, and is verified in real world experiments. © 2007 Elsevier Ltd. All rights reserved.},
 author = {Meeussen, Wim and Staffetti, Ernesto and Bruyninckx, Herman and Xiao, Jing and De Schutter, Joris},
 doi = {10.1016/j.robot.2007.09.009},
 journal = {Robotics and Autonomous Systems},
 note = {Cited by: 20},
 number = {5},
 pages = {437 - 450},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integration of planning and execution in force controlled compliant motion},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/41949138011?origin=resultslist},
 volume = {56},
 year = {2008}
}
