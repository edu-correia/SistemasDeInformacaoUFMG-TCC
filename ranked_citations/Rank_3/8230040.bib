@inproceedings{8230040,
 abstract = {Different structures of organic solar cells having different materials for active layer as well as for electrode (anode) are demonstrated and analyzed in this paper. At first device having blend of poly (3-hexylthiophene) and phenyl-C61-butyric acid methyl ester (P3HT:PCBM) as active layer is compared with single layer organic cell having pentacene as active layer. Secondly, Graphene on PET substrate is being used as anode in the device and compared with performance of conventional device having ITO as anode. An enhancement in performance is achieved by merging Graphene anode in the OPV device having blend P3HT:PCBM as its active layer material. The improvement observed in the final optimized device is more than twice the other devices discussed.},
 author = {Nautiyal, Pranjali and Mittal, Poornima},
 booktitle = {2017 International Conference on Computing, Communication and Automation (ICCCA)},
 doi = {10.1109/CCAA.2017.8230040},
 issn = {},
 keyword = {Photovoltaic cells;Anodes;Indium tin oxide;Graphene;Photovoltaic systems;Performance evaluation;Organic photovoltaic materials;exciton;P3HT;PCBM;graphene},
 month = {May},
 number = {},
 pages = {1507-1511},
 title = {Performance analysis of organic photovoltaics by optimization of active layer and electrode: Materialistic approach},
 volume = {},
 year = {2017}
}
