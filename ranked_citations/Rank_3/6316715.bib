@inproceedings{6316715,
 abstract = {For elaborately understanding what product features the reviews focuses on, we propose an approach based on patterns to extraction features (titles). Trough setting length, upper and lower limit probability and frequency thresholds, we extract patterns of POS tags and features from the training corpus. To enhance adaptability of the pattern set, we merge some fundamental patterns into a new fuzzy pattern. Then a pattern matching algorithm is applied to extract the titles and opinion words from the reviews. We conducted a platform to extract features from product reviews automatically, the result of our experiments shows that our approach is effective.},
 author = {Song, Hui and Fan, Yingxiang and Liu, Xiaoqiang and Tao, Dao},
 booktitle = {2011 6th International Conference on Computer Sciences and Convergence Information Technology (ICCIT)},
 doi = {},
 issn = {},
 keyword = {Feature extraction;Pattern matching;Training;Mobile communication;Data mining;Semantics;Probability},
 month = {Nov},
 number = {},
 pages = {745-750},
 title = {Extracting product features from online reviews for sentimental analysis},
 volume = {},
 year = {2011}
}
