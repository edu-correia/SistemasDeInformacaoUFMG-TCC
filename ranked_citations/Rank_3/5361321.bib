@inproceedings{5361321,
 abstract = {In this paper, we proposed a novel interpolant generation algorithm without constructing the resolution graph of the unsatisfiability proof. Our algorithm generates the interpolant by building sub-interpolants from conflict analyses and then merges them based on the last decision conflict. The experimental results show that our algorithm has the advantages over the prior interpolant generation techniques in both memory usage and interpolation circuit size.},
 author = {Hsu, Chih-Jen and Huang, Shao-Lun and Wu, Chi-An and Huang, Chung-Yang},
 booktitle = {2009 IEEE/ACM International Conference on Computer-Aided Design - Digest of Technical Papers},
 doi = {},
 issn = {1558-2434},
 keyword = {Interpolation;Permission;Buildings;Algorithm design and analysis;Circuits;Application software},
 month = {Nov},
