@conference{Wu2015,
 abstract = {According to traditional methods of image segmentation on sonar image processing with less robustness and the problem of low accuracy, we propose the method of sonar image segmentation based on Tree-Structured Markov Random Field(TS-MRF), the algorithm shows better ability in using spatial information. First, using a tree structure constraint two-valued MRF sequences to model sonar image, through the node to describe local information of image, hierarchy information establish interconnected relationships through nodes, at the same time when we describe the hierarchical structure information of the image, we can preserve an image's local information effectively. Then, we define split gain coefficients to reflect the ratio that marking posterior probability division before and after the splitting on the assumption of the known image viewing features, and viewing gain coefficients of judgment as the basis for determining binary tree of node split to reduce the complexity of solving a posterior probability. Finally, during the process of image segmentation, continuing to split the leaf nodes with the maximum splitting gain, so we can get the splitting results. We add merge during the process of segmentation. Using the methods of region splitting and merging to reduce the error division, so we can obtain the final segmentation results. Experimental results show that this approach has high segmentation accuracy and robustness. © 2015 SPIE.},
 author = {Wu, Tao and Xia, Ping and Liu, Xiaomei and Lei, Bangjun},
 doi = {10.1117/12.2203641},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {TS-MRF sonar image segmentation based on the levels feature information},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84958211796?origin=resultslist},
 volume = {9811},
 year = {2015}
}
