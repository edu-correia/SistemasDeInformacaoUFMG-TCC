@conference{Li2003951,
 abstract = {A new method is developed to merge two spatially registered images with different focus based on multi-resolution wavelet decomposition and evolutionary strategy (ES). At first, the wavelet decomposition without down-sampling is used to perform an adding of wavelet high-frequency components of each image. Then, in terms of differences of area-based energy feature in two original images, ES is adopted to partition the region and perform the fusion. The experimental results show that the proposed method can achieve better fusion performance than wavelet transform (WT) method. © 2003 IEEE.},
 author = {Li, Ming and Wu, Yan and Wu, Shunjun},
 doi = {10.1109/ICNNSP.2003.1280758},
 journal = {Proceedings of 2003 International Conference on Neural Networks and Signal Processing, ICNNSP'03},
 note = {Cited by: 18},
 pages = {951 - 955},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi-focus image fusion based on wavelet decomposition and evolutionary strategy},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33947239452?origin=resultslist},
 volume = {2},
 year = {2003}
}
