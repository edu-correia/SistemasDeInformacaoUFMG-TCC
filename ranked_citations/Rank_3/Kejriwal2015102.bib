@article{Kejriwal2015102,
 abstract = {This article presents an unsupervised system that performs instance matching between entities in schema-free Resource Description Framework (RDF) files. Rather than relying on domain expertise or manually labeled samples, the system automatically generates its own heuristic training set. The training sets are first used by the system to align the properties in the input graphs. The property alignment and training sets are used together to simultaneously learn two functions, one for the blocking step of instance matching and the other for the classification step. Finally, the learned functions are used to perform instance matching. The full system is implemented as a sequence of components that can be iteratively executed to boost performance. Evaluations on a suite of ten test cases show individual components to be competitive with state-of-the-art baselines. The system as a whole is shown to compete effectively with adaptive supervised approaches. © 2015 Elsevier B.V.},
 author = {Kejriwal, Mayank and Miranker, Daniel P.},
 doi = {10.1016/j.websem.2015.07.002},
 journal = {Journal of Web Semantics},
 note = {Cited by: 27},
 pages = {102 - 123},
 publication_stage = {Final},
 source = {Scopus},
 title = {An unsupervised instance matcher for schema-free RDF data},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84948711127?origin=resultslist},
 volume = {35},
 year = {2015}
}
