@inproceedings{4519040,
 abstract = {In recent years, standards have begun to formalize the concepts of systems engineering, capturing the long understood idea that functionality and structure are the key elements of sound practice. This paper introduces a novel and successful technique for doing system design that goes to the "heart of the matter". Functionality is initially derived from system requirements and then structure is determined from the functionality, setting the stage for software and hardware development. The technique is called function mapping.},
 author = {Moolenbeek, John},
 booktitle = {2008 2nd Annual IEEE Systems Conference},
 doi = {10.1109/SYSTEMS.2008.4519040},
 issn = {},
 keyword = {Design engineering;Heart;Systems engineering and theory;Acoustical engineering;Hardware;Concrete;ISO standards;IEC standards;Merging;System Design;Functionality;Structure;Function Maps},
 month = {April},
 number = {},
 pages = {1-5},
 title = {Function Mapping: A Sound Practice for System Design},
 volume = {},
 year = {2008}
}
