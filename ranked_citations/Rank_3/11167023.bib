@inproceedings{11167023,
 abstract = {The “AI-Driven Financial Advisor for Personalized Investment Strategies” is an initiative aimed at revolutionizing financial decision-making process and investment strategies. Advanced Machine learning systems are employed to deliver financial guidance to the person. The system provides financial advices based on user inputs, by leveraging artificial intelligence and machine learning. It takes inputs such as financial goals, time period, risk tolerance and amount needed to invest. The major functionalities include investment recommendation, risk analysis, market news, financial education and chatbot for further assistance and support. This platform features stock visualizer, a news market sentiment analyzer, and a financial planning tool, with personalized tailored requirements this all helps make comprehensive financial decision. The integration of real-time data is accessed from APIs, these are processed using libraries in python such as Pandas and Plotly, which helps in visualizing accurate data insights. The information of user merged with Chatbot, which assists user interaction and provides them recommendations enhancing decision-making. It gathers numerous numbers of investment options, promoting confident and decision making. Project presents financial advisor services by providing financial literacy by giving the options to learn from current scenarios and making decision making simpler. Overall, achieving user’s financial goals and objectives empowering them with market trends and financial literacy.},
 author = {Kharatmol, Keerti and Mhatre, Piyush and Khairnar, Sakshi and Bhosle, Sanjana},
 booktitle = {2025 5th International Conference on Intelligent Technologies (CONIT)},
