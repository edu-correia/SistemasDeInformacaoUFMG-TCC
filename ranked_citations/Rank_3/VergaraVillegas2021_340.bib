@article{VergaraVillegas2021_340,
 abstract = {Abstract: Artificial intelligence applied to industry 4.0 will help the Iberoamerican industries to experiment and adopt a digital transformation. In this paper, we present a literature review of the work conducted by Iberoamerican countries regarding artificial intelligence for Industry 4.0. The works analyzed are aligned with the eight technological pillars that support industry 4.0, including robotics, Internet of things, big data, additive manufacturing and simulation, cloud computing, cybersecurity, virtual and augmented reality, and horizontal and vertical integration. As a result of our perusal, we propose many strategies that Iberoamerican countries could follow to successfully implement artificial intelligence to daily life.},
 author = {Vergara Villegas, Osslan Osiris and Nandayapa, Manuel and Sossa Azuela, Juan Humberto and Cossio Franco, Edgar Gonzalo and Rubin Linares, Gustavo Trinidad},
 doi = {10.13053/cys-25-4-4056},
 number = {4},
 pages = {761--773},
 title = {Artificial Intelligence for Industry 4.0 in Iberoamerica},
 volume = {25},
 year = {2021}
}
