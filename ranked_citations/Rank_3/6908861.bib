@inproceedings{6908861,
 abstract = {In this work, compatible CMOS-MEMS process with surface micromachining is investigated. Surface micromachining method for cantilever fabrication has been merged with conventional CMOS process, and release of MEMS structure is conducted after CMOS process. We designed polysilicon MEMS structures as well as CMOS devices and circuits on a monolithic sensor chip for the investigation of the influence of stress induced by non-adequate post-CMOS annealing. The impact of step coverage and the releasing process on both the MEMS and CMOS components are also discussed.},
 author = {Zhao, Danqi and Huang, Xian and He, Jun and Zhang, Li and Liu, Peng and Yang, Fang and Zhang, Dacheng},
 booktitle = {The 9th IEEE International Conference on Nano/Micro Engineered and Molecular Systems (NEMS)},
 doi = {10.1109/NEMS.2014.6908861},
 issn = {},
 keyword = {Micromechanical devices;CMOS integrated circuits;Surface treatment;Stress;Micromachining;Fabrication;CMOS process;MEMS;post-CMOS;monolithic integration},
 month = {April},
 number = {},
 pages = {513-516},
 title = {Study on compatible CMOS-MEMS process with surface micromachining for the application of monolithic integration},
 volume = {},
 year = {2014}
}
