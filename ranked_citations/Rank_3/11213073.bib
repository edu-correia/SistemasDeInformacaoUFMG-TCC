@inproceedings{11213073,
 abstract = {Manual analysis of multidimensional data outliers in engineering budget estimation texts is time-consuming, labor-intensive, and susceptible to human factors. To address this issue, this paper proposes an automatic detection method for multidimensional data outliers in engineering budget estimation texts based on LSTM and NLP. The method first processes the multidimensional data of engineering budget estimation texts, including merging and extracting text content, word segmentation, removing stop words, calculating word frequency weights and position weights to extract feature word sets, and converting and segmenting texts into structured formats. A multidimensional data outlier detection model is constructed by integrating LSTM and NLP, which processes numerical, text, and time-series data separately and integrates multidimensional features through an attention mechanism. Outliers are identified based on reconstruction errors and feature deviation degrees. Experimental results show that the false alarm rate of this method remains below 3.5%. The indicators of Accuracy, Precision, Recall, and F1-Score reach 92.4, 91.8, 93.1, and 92.4 respectively, with the outlier detection rate for the three data types maintaining above 98%. This verifies the effectiveness of the method in detecting multidimensional data outliers in engineering budget estimation texts, enabling more reliable outlier detection.},
 author = {Qiu, Ling and Shi, Menglan and Yao, Duoduo and Yin, Yongliang},
 booktitle = {2025 7th International Conference on Internet of Things, Automation and Artificial Intelligence (IoTAAI)},
 doi = {10.1109/IoTAAI66837.2025.11213073},
 issn = {},
 keyword = {Accuracy;Merging;Estimation;Manuals;Feature extraction;Reliability engineering;Numerical models;Internet of Things;Anomaly detection;Long short term memory;Engineering budget estimation text;Multidimensional data;Outlier detection;LSTM;NLP},
 month = {Sep.},
 number = {},
 pages = {653-656},
 title = {Automatic Detection of Multidimensional Data Outliers in Engineering Budget Estimation Texts Based on LSTM and NLP},
 volume = {},
