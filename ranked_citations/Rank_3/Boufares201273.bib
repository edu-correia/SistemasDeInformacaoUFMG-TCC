@conference{Boufares201273,
 abstract = {Data deduplication is a very important step in the process of heterogeneous data integration. It ensures a better quality of data results. Thus, the extraction of knowledge from these data is more accurate. We present in this paper, two sequential algorithms, improvements over Swoosh algorithms, to eliminate similar data. These algorithms are based on the Match and Merge functions that we have defined. The Match function is based on calculations of similarity distances depending on the type of data. The Merge function uses logical rules. We experimentally evaluate the algorithms using a random generated data.},
 author = {Boufares, F. and Ben Salem, A. and Correia, S.},
 journal = {Proceedings of the 21st International Conference on Software Engineering and Data Engineering, SEDE 2012},
 note = {Cited by: 0},
 pages = {73 - 78},
 publication_stage = {Final},
 source = {Scopus},
 title = {Deduplication algorithms for databases and data warehouses},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84871945518?origin=resultslist},
 year = {2012}
}
