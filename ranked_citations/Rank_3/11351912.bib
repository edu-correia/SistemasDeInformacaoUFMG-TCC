@inproceedings{11351912,
 abstract = {To overcome the limitations of single-camera object detection in challenging conditions like poor weather or illumination, we introduce CrossFusionNet, a novel framework that fuses visible (RGB) and thermal infrared (TIR) images for robust, all-weather performance.Our model's core is a Dynamic Adaptive Feature Fusion (DAF) module, which intelligently learns how to best combine features from both modalities based on the scene, maximizing their complementary strengths. An Object Feature Enhancement (OFE) module then further refines the results by highlighting targets and suppressing background noise.By effectively merging the detailed texture from RGB images with the salient thermal signatures from TIR, CrossFusionNet achieves state-of-the-art results, including 73.29 % mAP on the KAIST dataset.This model shows significant promise for critical applications in power systems.},
 author = {Zhou, Yuhao and Chen, Yi and Yan, Yunfeng and Gu, Yanghao and Qi, Donglian},
 booktitle = {2025 5th IEEE International Conference on Energy Engineering and Power Systems (EEPS)},
 doi = {10.1109/EEPS68057.2025.11351912},
 issn = {},
 keyword = {Weather;Hands;Substations;Accuracy;Power system dynamics;Lighting;Object detection;Inspection;Feature extraction;Vehicle dynamics;Feature Fusion;Multispectral Object Detection;Two-stream Structure;RGB information;infrared information;Power Systems},
 month = {Oct},
 number = {},
 pages = {764-773},
 title = {Crossfusion: Adaptive Multimodal Fusion Method Based on Different Scenarios in Power Systems},
 volume = {},
 year = {2025}
}
