@inproceedings{11074206,
 abstract = {The combination of AI and smart devices has provided people with techniques for controlling and enhancing the yield of crops. Conventional methods for crop identification are typically resource-intensive, slow, and vulnerable to inaccuracies from manual handling. This study aims to resolve sluggish crop recognition by merging aerial imaging from UAV with data driven machine learning method for automated analysis in agriculture. UAV acquired aerial data with fine spatial detail was using machine learning technique, including CNN, KNN, SVM, and Random Forest classifiers. The empirical analysis confirms that the proposed method strategy significantly elevates classification results, with CNN recording the highest accuracy of 95.7%. This method not only reduces the reliance on manual effort but also provides farmers with practical insights to support informed decision making, thereby optimizing crop yield and field management. The study also highlights technical obstacles like managing extensive datasets, integrating complex systems, and ensuring scalability, while proposing future prospects for real time deployment and IoT integration improve smart farming solutions.},
 author = {Srilatha, A and Praveen, Pappula},
 booktitle = {2025 7th International Conference on Inventive Material Science and Applications (ICIMA)},
 doi = {10.1109/ICIMA64861.2025.11074206},
 issn = {},
 keyword = {Support vector machines;Accuracy;Imaging;Manuals;Streaming media;Soil;Autonomous aerial vehicles;Spatial databases;Spatial resolution;Smart devices;AI;CNN;UAV;Image Processing;ML;IoT},
 month = {May},
 number = {},
 pages = {1005-1010},
 title = {Integration of UAV-based Imaging and Machine Learning for Smart Crop Classification and Agricultural Optimization},
 volume = {},
 year = {2025}
}
