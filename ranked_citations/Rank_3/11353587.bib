@inproceedings{11353587,
 abstract = {Wildlife conservation in Sri Lanka faces significant risks from habitat destruction, poaching, and human–wildlife conflict, but existing platforms such as Spatial Monitoring and Reporting Tool (SMART) and EarthRanger remain limited to professional use with limited public participation. To overcome this gap, our research proposes EnFauna, an AI-powered computer vision platform that integrates awareness, incident reporting, and funding into a unified conservation framework. A mixed-methods approach was adopted, including surveys and expert interviews to evaluate stakeholder demands and technology feasibility. The platform features a PyTorch-based computer vision model trained on Sri Lankan datasets for species identification, supplemented by geotagged reporting and transparent fundraising mechanisms to encourage broad community engagement. Findings reveal substantial public readiness to use mobile-first technologies for reporting unlawful actions, injured animals, and human–wildlife conflict. The Artificial Intelligence (AI) model achieved 99.01% accuracy in species detection, while issues continue under low-light and unclear situations. Analysis indicated important concerns surrounding privacy of geotagged data, transparency in fundraising, and the trustworthiness of AI classifications. These concerns underline the significance of ethical safeguards, trust-building, and constant model modification. The study finds that EnFauna demonstrates how AI, citizen science, and transparent financing can be merged into an inclusive, scalable platform, combining professional monitoring with community-driven conservation in Sri Lanka.},
 author = {G, Abeynayake K and H, Dilpriya T A},
 booktitle = {2025 10th International Conference on Information Technology Research (ICITR)},
 doi = {10.1109/ICITR69413.2025.11353587},
 issn = {2831-3399},
 keyword = {Surveys;Computer vision;Accuracy;Computational modeling;Wildlife;Stakeholders;Biodiversity;Artificial intelligence;Sustainable development;Monitoring;biodiversity;crowdsource fundraising;computer vision;sustainability;governance;citizen science},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {EnFauna: An Integrated AI-Powered Computer Vision Platform for Crowdsourced Species Identification, Awareness, Reporting, and Fundraising in Endangered Wildlife Conservation in Sri Lanka},
 volume = {},
 year = {2025}
}
