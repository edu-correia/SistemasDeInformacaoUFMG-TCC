@inproceedings{7264308,
 abstract = {The Social Internet of Things is a new paradigm that merges the Internet of Things with Social Networks. We propose a paradigm for how to model interactions between devices and humans, and among devices themselves to support sharable value-added applications throughout the device life cycle (e.g., Configuration, operation, preventive diagnosis), as well as to achieve common goals and recommendations. To realize this paradigm we propose a novel architecture and implementation to enable new Internet of Things applications based on emerging types of social relationships. We develop the semantic models for the Social Internet of Things including device types and their capabilities, users and their relationships, and rules leveraging such models. We demonstrate our concept by building a real system called Socialite that integrates various devices from different manufacturers with different functional interfaces and explicitly represents the relationships among active participants (devices as well as users) in our system.},
 author = {Kim, Ji Eun and Maron, Adriano and Mosse, Daniel},
 booktitle = {2015 16th IEEE International Conference on Mobile Data Management},
 doi = {10.1109/MDM.2015.50},
 issn = {2375-0324},
 keyword = {Internet of things;Semantics;Ontologies;Social network services;Thermostats;Heating;Smart phones;Social Internet of Things;Internet of Things;Social Networks;Ontology;Inference Rule;Software framework},
 month = {June},
 number = {},
 pages = {94-103},
 title = {Socialite: A Flexible Framework for Social Internet of Things},
 volume = {1},
 year = {2015}
}
