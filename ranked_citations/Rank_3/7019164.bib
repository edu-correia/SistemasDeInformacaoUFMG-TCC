@inproceedings{7019164,
 abstract = {After evolutions of Semantic web the Ontologies become popularity in the resent years to symbolize knowledge, knowledge distribution, and knowledge management. Ontology represents core knowledge in various enterprises. In computing technology, ontology is a formal depiction of information has a set of notions within an area, and the associations between notions. In our proposed system we use DL ontology for the computational query decidability. In order to ensure this, numerous constraints were enacted. These constraints consent OWL DL to offer competent reasoning support. In our proposed system we develop personalized ontology and ontology log data. The Ontology Log Data are well efficient source of facts, returns the modification takes in the domain. The main impact of our proposed system is able to imply OWL DL ontology and SPARQL query responses user's preferred queries. The personalized ontology and ontology log data are validated in insurance sector concept, where the analyses are modularized particularly with GUI approach deliberately for affluence usage of consumer.},
