@inproceedings{11505194,
 abstract = {Adverse (Drug-Drug Interactions) DDIs are a critical concern for patient safety, and they contribute to a significant proportion of preventable morbidity and hospital admissions. However, the continuing stream of new pharmacotherapies and evolving clinical evidence makes manual monitoring of this ever-expanding body of pharmacological data infeasible. Most prior LLM-based systems attempt to manage conversation, retrieval, and reasoning simultaneously, which often leads to hallucinations, loss of temporal context, and limited interpretability. This paper addresses the limitations mentioned above by introducing an agentic, graph-augmented decision support architecture. It combines Neo4j, a graph database, with a multi-agent reasoning framework based on LangGraph. Drugs and their interactions are modelled as nodes and edges, respectively, with metadata that enables semantically rich and computationally efficient discovery of relationships. Specialised agents for retrieval and response generation are orchestrated through a stateful LangGraph workflow with temporal memory. A validation checkpoint ensures relevance and factual integrity via iterative refinement of retrieved evidence. The proposed hierarchical architecture effectively merges the structured, factually precise nature of graph databases with the adaptive reasoning capabilities of LLMs. This leads to a trustworthy, explainable, and temporally aware clinical decision-support system that enhances reliability in pharmacological analysis and provides a framework for safe, data-driven decision-making in healthcare.},
 author = {Hari Kishan, B and Saadhvi, R and Sakthi Sudarsen, J and Poonkodi, M},
 booktitle = {2026 International Conference on Data Science, Agents and Artificial Intelligence (ICDSAAI)},
 doi = {10.1109/ICDSAAI69492.2026.11505194},
 issn = {},
 keyword = {Drugs;Modeling;Drug interactions;Knowledge graphs;Retrieval augmented generation;Printing;Cognition;Cognitive systems;Architecture;Computer architecture;Drug-drug interactions;dual-agent architecture;clinical decision support system;knowledge graph retrieval},
 month = {March},
 number = {},
 pages = {1-6},
 title = {Hierarchical Agent Architecture for Clinical Decision Support in Drug-Drug Interaction (DDI) Analysis},
 volume = {1},
 year = {2026}
}
