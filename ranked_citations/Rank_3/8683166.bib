@inproceedings{8683166,
 abstract = {Deep convolutional neural networks (CNNs) have recently made a considerable achievement in the single-image super-resolution (SISR) problem. Most CNN architectures for SIS-R incorporate skip connections to integrate features, and treat them equally. However, this neglects the discrimination of features, and consequently, achieving relatively poor performance. To address this problem, we introduce a deep aggregation network that merging extraction and aggregation nodes in a tree structure, which can aggregate features progressively. In particular, we rescale the information in the aggregation node by modelling the interaction between channels, which shares the same insight on the attention mechanism for improving the discriminative ability of network. In the extraction node, we introduce an mlpconv layer into a dense unit that is parallel to the convolutional layer and can improve the nonlinear mapping capability, where the residual learning is utilized to accelerate the training process. Extensive experiments conducted on several publicly available datasets have demonstrated the superiority of our model over state-of-the-art in objective metrics and visual impressions.},
 author = {Wang, Xinya and Ma, Jiayi and Jiang, Junjun},
 booktitle = {ICASSP 2019 - 2019 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP.2019.8683166},
 issn = {2379-190X},
 keyword = {Training;Measurement;Visualization;Attention mechanisms;Convolution;Superresolution;Merging;Feature extraction;Convolutional neural networks;Speech processing;Super-resolution;convolutional neural network;aggregation;mlpconv layer;attention mechanism},
 month = {May},
 number = {},
 pages = {1747-1751},
 title = {Image Super-resolution via Deep Aggregation Network},
 volume = {},
 year = {2019}
}
