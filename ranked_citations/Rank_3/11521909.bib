 abstract = {The scale and heterogeneity of large-scale and heterogeneous IoT spaces reveal severe shortcomings of the traditional security protocols that are based on a static credential system, a centralized key issuer, and the use of handshakes in authentication. In order to solve the problems, this paper suggests a new Model Context-Bound Hardware-Semantic Key Evolution Framework (CHS-KEF), which is a fully distributed model that requires no long-term secret storage, and allows meeting robust authentication and dynamic key management models. The suggested approach obtains cryptographic content by combining intrinsic hardware entropy (gathered by means of physical variations peculiar to the device) and high-level semantics, such as the purpose of use, interaction style, mobility condition, and trust history. This merged state triggers a forward only ratcheted evolution of keys, which means that keys grow progressively through communication epochs, developing an intrinsic resistance against replay, cloning and post compromise attacks. Authentication is done implicitly by consistency of state, as the nodes in an interaction generate ephemeral proof tokens without communication, independently. The verification is only possible when the semantic evolution paths of hardware and semantics are synchronized, as well as it should imply the absence of destroyed or fake devices. To achieve cryptographic soundness, it has a bounded reconciliation mechanism to allow pleasant small state deviation. The framework of proposal does not use any certificates, trusted third-party, or persistent key to ensure a significant reduction in communication overhead and storage needs. Analytical analysis reveals that the approach gives high levels of forward secrecy, scale and flexibility in dynamic network conditions hence is highly applicable in next-generation IoT implementation with mass scale, long device life-estimates and rigid resource demands. The suggested solution attains an overall accuracy of 98.6 percent, indicating dependable authenticating and secure state validation in dynamic IoT environments.},
 author = {Pushkarna, Gaurav and Saxena, Rashi and Malhotra, Anshu and Shruthi, G. and Mannava, Gopi and Bandaru, Sowmini},
 booktitle = {2026 International Conference on Multidisciplinary Innovations For Smart & Sustainable Future (MISSF)},
 doi = {10.1109/MISSF68264.2026.11521909},
 issn = {},
