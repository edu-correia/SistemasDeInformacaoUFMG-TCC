@inproceedings{1461330,
 abstract = {A novel and efficient anisotropic diffusion filters method for texton construction is presented in this paper. Recently, texton based texture analysis has been an intensely researched topic especially using Gabor filters output as features for texton construction. The redundancy of Gabor filters makes texton based methods highly time costing. Considering the time cost reducing problem, anisotropic diffusion (AD) filters are introduced in feature extraction for texton construction. Because anisotropic diffusion makes lots of similar features effectively merge together, this method largely reduces feature vectors and time cost on the basis of reliable texton construction. Because of the nonlinearity of nonlinear diffusion, the widely used histogram comparison technique - Earth move distance (EMD) - is not effective for this framework, an appropriate method is proposed instead. Experiments demonstrate the better quality of our method.},
 author = {Mo Yi and Zhongxuan Liu and Silong Peng},
 booktitle = {Proceedings. 2005 IEEE Networking, Sensing and Control, 2005.},
 doi = {10.1109/ICNSC.2005.1461330},
 issn = {},
 keyword = {Anisotropic magnetoresistance;Gabor filters;Costs;Histograms;Filtering;Information retrieval;Image retrieval;Application specific integrated circuits;Design engineering;Design automation},
 month = {March},
 number = {},
 pages = {988-992},
 title = {Texton construction using anisotropic diffusion filters},
 volume = {},
 year = {2005}
}
