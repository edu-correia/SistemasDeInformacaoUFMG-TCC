@inproceedings{8273030,
 abstract = {Business Process Re-engineering (BPR) is highly required in this changing world, most companies are changing their focus from Product-Oriented where they have focused on the products, to Process-Oriented where the focus on the process that produce the products in a manner to serve their customers with high level of customer service. As a result of high demand on BPR, there are many researches have been conducted in this area. This paper introduces new methodology to create and check the re-engineered process after it was adopted and before implemented in real project. The proposed method in this paper applies Six-Quality characteristics on the redesigned process before merging it to real situation.},
 author = {Qusef, Abdallah and Hamdan, Ahmad and Murad, Sharefa},
 booktitle = {2017 International Conference on Engineering & MIS (ICEMIS)},
 doi = {10.1109/ICEMIS.2017.8273030},
 issn = {2575-1328},
 keyword = {Business process re-engineering;Companies;Information systems;Standards organizations;Best practices;Business Process Reengineering;Six-Quality Characteristics},
 month = {May},
 number = {},
 pages = {1-5},
 title = {Business process integration with quality characteristics: Quality-oriented process},
 volume = {},
 year = {2017}
}
