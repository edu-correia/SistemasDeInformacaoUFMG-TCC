@inproceedings{11022894,
 abstract = {The digitization of the activity at the faculty level is a current one, being a main integration component for the applications developed within this article. The purpose of the article is to present a Web platform that aims to manage the activities of the members of a faculty-level department, internal documents, communication between users with distinct roles, storage, communication, and data validation. The developed application solves the problems of communication, merging, composing, signing, or assuming documents. The Bootstrap framework was selected to develop the interfaces (front-end) of the MAD (Teaching Administrative Module) application. This article will present the particularities of the visualization modules of the MAD application. It can be said that the proposed application must be simple to use and integrate several technologies.},
 author = {Popa, Bogdan and Popescu, Ion-Marian and Constantinescu, Radu Lucian and Albita, Anca and Ureche, Gabriel-Terry},
 booktitle = {2025 26th International Carpathian Control Conference (ICCC)},
 doi = {10.1109/ICCC65605.2025.11022894},
 issn = {},
 keyword = {Codes;Automation;Databases;Merging;Education;Data visualization;Writing;Service-oriented architecture;Certification;Bootstrap;Management;Web applications;Data management},
 month = {May},
 number = {},
 pages = {1-6},
 title = {Proposed Architecture and Visualization Part for a Web Application at the Faculty Level},
 volume = {},
 year = {2025}
