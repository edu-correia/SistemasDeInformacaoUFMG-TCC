@article{Gyrard2013697,
 abstract = {We are surrounding by sensor networks such as healthcare, home or environmental monitoring, weather forecasting, etc. All sensor-based applications proposed are domain-specific. We aim to link these heterogeneous sensor networks to propose promising applications. Existing applications add semantics to the sensor networks, more specifically, to the context, rather than to the sensed data. We propose an architecture to merge heterogeneous sensor networks, convert measurements into semantic data and reason on them. © 2013 Springer-Verlag Berlin Heidelberg.},
 author = {Gyrard, Amelie},
 doi = {10.1007/978-3-642-38288-8_54},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 13},
 pages = {697 - 701},
 publication_stage = {Final},
 source = {Scopus},
 title = {An architecture to aggregate heterogeneous and semantic sensed data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84884995001?origin=resultslist},
 volume = {7882 LNCS},
 year = {2013}
}
