@conference{Qi2006281,
 abstract = {In this paper, we propose a family of operators for merging stratified knowledge bases under integrity constraints. The operators are defined in a model-theoretic way. Our merging operators can be used to merge stratified knowledge bases where no numerical information is available. Furthermore, the original knowledge bases to be merged can be individually inconsistent. Both logical properties and computational complexity issues of the operators are studied. Copyright © 2006, American Association for Artificial Intelligence (www.aaai.org). All rights reserved.},
 author = {Qi, Guilin and Liu, Weiru and Bell, David A.},
 journal = {Proceedings of the National Conference on Artificial Intelligence},
 note = {Cited by: 27},
 pages = {281 - 286},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging stratified knowledge bases under constraints},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33750691666?origin=resultslist},
 volume = {1},
 year = {2006}
}
