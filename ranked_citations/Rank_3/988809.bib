@article{988809,
 abstract = {An InP-based integrated HBT amplifier with PNP active load was demonstrated for the first time using complementary HBT technology (CRBT). Selective molecular beam epitaxy (MBE) regrowth was employed and a merged processing technology was developed for the monolithic integration of InP-based NPN and PNP HBTs on the same chip. The availability of PNP devices allowed design of high gain amplifiers with low power supply voltage. The measured amplifier with PNP HBT active load achieved a voltage gain of 100 with a power supply (V/sub CC/) of 1.5 V. The corresponding voltage swing was 0.9 V to 0.2 V. The amplifier also demonstrated S/sub 21/ of 7.8 dB with an associated S/sub 11/ and S/sub 22/ of -9.5 dB and -8.1 dB, respectively, at 10 GHz.},
 author = {Delong Cui and Pavlidis, D. and Hsu, S.S.H. and Sawdai, D. and Chin, P. and Block, T.},
 doi = {10.1109/55.988809},
 issn = {1558-0563},
 journal = {IEEE Electron Device Letters},
 keyword = {Heterojunction bipolar transistors;Molecular beam epitaxial growth;Power supplies;Power amplifiers;Monolithic integrated circuits;Availability;High power amplifiers;Low voltage;Power measurement;Voltage measurement},
 month = {March},
 number = {3},
 pages = {114-117},
 title = {First demonstration of monolithic InP-based HBT amplifier with PNP active load},
 volume = {23},
 year = {2002}
}
