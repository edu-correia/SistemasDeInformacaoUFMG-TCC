@article{10.1145/3786292,
 abstract = {Traditional network architectures maintain IP and optical layers in separate domains, leading to inefficiencies and rising costs as bandwidth demands surge. Recent developments, e.g., coherent pluggable transceivers (CPT) modules and router?to?router optical architectures, enable convergence of the IP and optical domains. Such innovations promise significant CapEx and OpEx savings, but they break traditional layered network control designs, and new cross-layer planning and management paradigms are required. However, cross-layer optimization, in particular, has proven to be very intensive in terms of computation. To address these challenges, in this paper, we present Telemark, a unified planning and management framework for converged IP-optical networks. Telemark's core contributions are: (1) a joint planning strategy that simultaneously optimizes IP-layer topology and capacity allocation together with optical-layer path selection and wavelength assignment; (2) a cross-layer fast failure restoration mechanism that coordinates backup-path computation in both IP and optical domains with minimal computational overhead. Experimental results highlight that Telemark can enhance network availability, achieve a 2x throughput gain, and provide solutions within sub-seconds.},
 address = {New York, NY, USA},
 articleno = {9},
 author = {Mai, Tianle and Yao, Haipeng and Li, Qun and Cai, Ruze and Jin, Chenlang and Xin, Xiangjun and He, Yuan and Liu, Yunhao},
 doi = {10.1145/3786292},
 issue_date = {March 2026},
 journal = {Proc. ACM Netw.},
 keyword = {ip-optical network, network planning, failure recovery, coherent pluggable transceivers},
 month = {March},
 number = {CoNEXT1},
 numpages = {23},
 publisher = {Association for Computing Machinery},
 title = {Telemark: Hybrid IP-Optical Core Network Planning and Fast Failure Recovery},
 url = {https://doi.org/10.1145/3786292},
 volume = {4},
 year = {2026}
}
