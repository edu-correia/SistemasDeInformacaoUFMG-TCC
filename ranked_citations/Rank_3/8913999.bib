@inproceedings{8913999,
 abstract = {We propose a new method called ”Dark Side Ternary Stars (DSTS)”, which is expected to allow emotional personal agents to interact with users. DSTS focuses on proper nouns to adapt preference to users. In this paper, we report only on ”GAGPL” in the DSTS. GAGPL is a method for calculating positive or negative value per sentence for an individual user. We aim to represent famous Japanese proverb ”The misery of others is as sweet as honey”. Our proposed method consists of Genetic Algorithms (GA) and Genetic Programming Like (GPL) algorithms. GA learns the positive or negative values of general word to individuals. GPL calculates the positive or negative value per sentence. We applied this method to the news article text data in Japanese professional baseball. As the experiment results, it shows that this method is effective.},
 author = {Yoshida, Tomohiro and Ishiwaka, Yuko and Yasui, Gaku},
 booktitle = {2019 IEEE International Conference on Systems, Man and Cybernetics (SMC)},
 doi = {10.1109/SMC.2019.8913999},
 issn = {2577-1655},
 keyword = {Genetic algorithms;Sports;Merging;Semantics;Thesauri;Encyclopedias},
 month = {Oct},
 number = {},
 pages = {3818-3825},
 title = {GAGPL: A Personalized Semantic Orientation Calculator in Dark Side Ternary Stars},
 volume = {},
 year = {2019}
}
