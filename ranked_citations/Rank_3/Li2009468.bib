@conference{Li2009468,
 abstract = {Today, in order to provide high-quality medical service and to minimize the resource cost, many large hospitals have adopted clinical pathway as a structured way to manage treatment activities. However, customization of clinical pathway remains as a major challenge in treating diversified patients. In this paper, we present an approach for dynamically generating customized clinical pathway according to patient's evolving status. We use semiotic methods to represent medical knowledge into affordance and norms which can merge different clinical practice guidelines and pathways to deal with complex and dynamic customization scenarios. Furthermore, the system framework is established for implementing our approach .Our research will give a contribution for personalized and automatic generation of medical processes as the decision support for physicians. © 2009 IEEE.},
 author = {Li, Weizi and Liu, Kecheng and Li, Shuzhang and Yang, Hongqiao},
 doi = {10.1109/IFITA.2009.325},
 journal = {Proceedings - 2009 International Forum on Information Technology and Applications, IFITA 2009},
 note = {Cited by: 10},
 pages = {468 - 472},
 publication_stage = {Final},
 source = {Scopus},
 title = {An agent based approach for customized clinical pathway},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70350523627?origin=resultslist},
 volume = {2},
 year = {2009}
