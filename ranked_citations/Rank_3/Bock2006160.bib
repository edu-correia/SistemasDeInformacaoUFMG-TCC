 publication_stage = {Final},
 source = {Scopus},
 title = {SysML and UML 2 support for activity modeling},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33744486892?origin=resultslist},
 volume = {9},
 year = {2006}
