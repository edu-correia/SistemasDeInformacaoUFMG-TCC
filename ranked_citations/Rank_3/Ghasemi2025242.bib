 publication_stage = {Final},
 source = {Scopus},
 title = {Galloping in Fast-Growth Natural Merge Sorts},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85212037789?origin=resultslist},
 volume = {87},
