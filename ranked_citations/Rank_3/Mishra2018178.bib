@conference{Mishra2018178,
 abstract = {The continuously growing size of the textual content needs a way to be designed to store the information in condensed manner with minimal information loss. Hence, the concept of lossless-summary is introduced which aims to address the problem of dangling anaphoras and incoherency in extractive summaries. A pipeline of operations has been proposed by this work in order to generate lossless-summaries. Co-reference resolution is performed pairwise on the sentences before generating the Abstract Meaning Representation (AMR) of the sentences. An algorithm to merge AMR graphs is developed and finally the text is generated using the merged AMR graphs. CNN/Dailymail dataset of news article is used for evaluations and results obtained shows the potential for lossless-summarization. © 2018 The Authors. Published by Elsevier Ltd.},
 author = {Mishra, Ritwik and Gayen, Tirthankar},
 doi = {10.1016/j.procs.2018.08.164},
 journal = {Procedia Computer Science},
 note = {Cited by: 17; All Open Access; Gold Open Access},
 pages = {178 - 185},
 publication_stage = {Final},
 source = {Scopus},
 title = {Automatic Lossless-Summarization of News Articles with Abstract Meaning Representation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85053145609?origin=resultslist},
 volume = {135},
 year = {2018}
}
