@conference{Qureshi2014,
 abstract = {'Big Data' is data whose scale, distribution, diversity, and/or timeliness require the use of new technical architectures and analytics to enable insights that unlock new sources of business value. It requires new data architectures, analytic sandboxes, new tools, new analytical methods, integrating multiple skills into new role of data scientist. Organizations are deriving business benefit from analyzing ever larger and more complex data sets that increasingly require real-time or near-real time capabilities. Big data can come in multiple forms. Everything from highly structured financial data, to text files, to multi-media files and genetic mappings. The high volume of the data is a consistent characteristic of big data. © 2014 IEEE.},
 author = {Qureshi, Salim Raza and Gupta, Ankur},
 doi = {10.1109/CSIBIG.2014.7056933},
 journal = {Proceedings of the 2014 Conference on IT in Business, Industry and Government: An International Conference by CSI on Big Data, CSIBIG 2014},
 note = {Cited by: 14},
