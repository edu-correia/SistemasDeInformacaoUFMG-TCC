@conference{Omar2008148,
 abstract = {Web 2.0 is expected to be the next technology in the interaction between the enterprise applications and users. Such interaction will be utilized in producing self-governance applications that are able to re-adjacent and re-configure the operation framework based on users' feedback. To achieve this, huge numbers of underneath resources (infrastructures and services) are required. Therefore, this work proposes the merge of Web 2.0 technology and Grid Computing overlay. Such merge between technologies is expected to offer mutual benefits for both communities. Through this work, a model for managing the interaction between the two technologies is developed based on the adapting of SOA model, this model is known as SOAW2G. This model manages the interaction between the users at the top level and resources at the bottom layer. The paper is concluded with the future vision of the new model. © 2008 IEEE.},
 author = {Omar, Wail M. and Abbas, Ali. Dhia K.},
 doi = {10.1109/DEST.2008.4635144},
 journal = {2008 2nd IEEE International Conference on Digital Ecosystems and Technologies, IEEE-DEST 2008},
 note = {Cited by: 1},
 pages = {148 - 154},
 publication_stage = {Final},
 source = {Scopus},
 title = {Managing web 2.0 framework based on grid computing overlay},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/56749090650?origin=resultslist},
 year = {2008}
}
