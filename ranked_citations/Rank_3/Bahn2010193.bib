@article{Bahn2010193,
 abstract = {This paper deals with an application of dynamic games for the design of efficient climate policies involving both adaptation and mitigation elements. More precisely, this paper extends the integrated assessment model Ada-BaHaMa to a game theoretic framework where several world regions define non-cooperatively their energy and climate policies all the while being affected by climate change damages induced by their total greenhouse gas emissions. The paper provides also a numerical illustration for a setting with two players.},
 author = {Bahn, Olivier},
 doi = {10.3138/infor.48.4.193},
 journal = {INFOR},
 note = {Cited by: 3},
 number = {4},
 pages = {193 - 201},
 publication_stage = {Final},
 source = {Scopus},
 title = {Combining adaptation and mitigation: A game theoretic approach},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/79953887313?origin=resultslist},
 volume = {48},
 year = {2010}
}
