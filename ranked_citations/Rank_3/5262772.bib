@inproceedings{5262772,
 abstract = {In order to realize information integration and information sharing of technique preparation process, idea of ontology was applied in technique preparation process. The definition and structure of technique preparation domain ontology were put forward. Moreover, the framework of an intelligent approach for construction technique preparation domain ontology was proposed and similarity computing approach of domain ontology was presented. Furthermore, the similarity relation between concepts was elaborated and domain ontology merging rules were designed to resolve the problem of domain ontology consistency. Finally, an application case was illustrated and the approach was demonstrated efficient.},
 author = {Yaxin, Yan and Zhenhuan, Jiang and Xinhua, Liu and Xutang, Zhang},
 booktitle = {2009 IEEE International Conference on Automation and Logistics},
 doi = {10.1109/ICAL.2009.5262772},
 issn = {2161-816X},
 keyword = {Ontologies;Merging;Application software;Manufacturing;Process planning;Fixtures;Mechanical engineering;Logic;Automation;Logistics;Domain Ontology;similarity computing;merging rules},
 month = {Aug},
 number = {},
 pages = {1283-1288},
 title = {An intelligent approach for construction domain ontology},
 volume = {},
 year = {2009}
}
