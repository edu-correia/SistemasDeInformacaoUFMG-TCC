@inproceedings{1238117,
 abstract = {A new method is presented based on wavelet transform (WT) for the fusion of a high-resolution panchromatic image and a low-resolution multi-spectral image. The high-resolution panchromatic image approximation can be first merged into the multi-spectral image approximation by edge intensity factor, and then the merged image is reconstructed by means of an inverse WT using the fused approximation and the details from the high-resolution panchromatic image. A comparison of the proposed method with old wavelet merging method shows that the proposed method can achieve better performance in combining and preserving spectral-spatial information for the test images.},
 author = {Li Ming and Wu Shunjun},
 booktitle = {Proceedings Fifth International Conference on Computational Intelligence and Multimedia Applications. ICCIMA 2003},
 doi = {10.1109/ICCIMA.2003.1238117},
 issn = {},
 keyword = {Image fusion;Wavelet transforms;Spatial resolution;Frequency;Multispectral imaging;Signal resolution;Energy resolution;Image reconstruction;Merging;Signal processing algorithms},
 month = {Sep.},
 number = {},
 pages = {154-159},
 title = {A new image fusion algorithm based on wavelet transform},
 volume = {},
 year = {2003}
}
