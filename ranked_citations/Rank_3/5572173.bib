@inproceedings{5572173,
 abstract = {This page proposed a new method to synthesize arbitrary length music sequences from a small database of music clips in real-time. The method actually is a patch-base method which is used commonly in texture synthesis of image or motion capture dates. We extracted the music patches automatically from each music clips of the training set. One music patch consisted of three parts: head, body and trail. Both the head part and the trail part were represented by the n-gram pattern feature vectors. To increase the speed of patch matching process, we employed the K-D tree structure to store the feature vectors due to its efficiency and accuracy of multi-dimension searching. Experimental results showed the proposed method is especially useful for interactive and real-time application such as background music generation for games and broadcasting.},
 author = {Zhu, Bin and Wang, Xin},
 booktitle = {Proceedings of the 29th Chinese Control Conference},
 doi = {},
 issn = {2161-2927},
 keyword = {Real time systems;Rhythm;Merging;Feature extraction;Nearest neighbor searches;Databases;Music analysis;Music synthesis;Music segmentation;Music retrieval;Pattern recognition},
 month = {July},
 number = {},
 pages = {5081-5085},
 title = {Real-time music synthesis by patch-based method},
 volume = {},
 year = {2010}
}
