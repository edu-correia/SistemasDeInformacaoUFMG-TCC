@inproceedings{11339550,
 abstract = {This paper proposes an advanced framework that incorporates 5G-enabled quantum computing and intelligent manufacturing systems for optimizing enterprise operation efficiency. Accordingly, the quantum-classical hybrid framework shall be established in this work for merging the supremacy of quantum computation with industrial feasibility. It will have embedded dedicated quantum algorithms for solving selected manufacturing optimization problems such as production scheduling, resource allocation, and quality control. Experimental validation demonstrates excellent performance, with a 250.4% increase in the processing speed-438 jobs per minute, 93.2% optimization accuracy, beating its classical and pure quantum counterpart, reducing energy consumption by 43.5%, and processing cost per unit by 34.4%. This is pursued with 96.8% system reliability and a mean time between failures of greater than 2,850 hours. The successful implementation of the framework and rich performance metrics confirm quantum-enhanced optimization as a viable means to address complex manufacturing issues in Industry 4.0, with practical implications for both scholars and practitioners in the field who are advocates for intelligent manufacturing solutions.},
 author = {Liu, Xinyu},
 booktitle = {2025 IEEE 3rd International Conference on Control, Electronics and Computer Technology (ICCECT)},
 doi = {10.1109/ICCECT64621.2025.11339550},
 issn = {},
 keyword = {Energy consumption;Quantum computing;Accuracy;Costs;System integration;Manufacturing;Resource management;Reliability;Optimization;Smart manufacturing;Quantum Computing;Processing Speed;Optimization Accuracy;Energy Consumption;Per Unit},
 month = {April},
 number = {},
 pages = {1733-1738},
 title = {Enhancing Enterprise Operational Efficiency through 5G-Enabled Quantum Computing-Based Smart Manufacturing Systems},
 volume = {},
