@inproceedings{10617406,
 abstract = {Harmonizing both safety and ease of use in healthcare software is a top priority in current security research. The balance between security and usability is still elusive, despite the constant efforts of developers and security experts. More thorough research into practical approaches to assess and improve the usable security of medical technology is urgently needed. The main goal of this research is to evaluate healthcare software’s usable security and, using empirical analysis as a basis, provide approaches for optimum security that don’t sacrifice usability. Decision-makers in the development of software have a difficulty when it comes to effortlessly integrating exceptionally safe software with optimal usability. In order to evaluate usability and security, this study proposes merging the Analytic Network Process (ANP), Fuzzy Set (FS), and Technique for Priority of Priority by Similarity to the Ideal Response (TOPSIS). This innovative technique promotes the integration of user and safety qualities. The FSAHP-TOPSIS hybrid solution’s effectiveness in assessing usable-security is shown by the study’s application to a hospital management system in Mecca, Saudi Arabia. These results provide insightful advice for security management that doesn’t sacrifice end-user usability.},
 author = {Raman, Ramakrishnan and Pillai, Biju G. and Rastogi, Shailesh and Kumar, Vikram and Verma, Apurv and Meenakshi},
 booktitle = {2024 4th International Conference on Advance Computing and Innovative Technologies in Engineering (ICACITE)},
 doi = {10.1109/ICACITE60783.2024.10617406},
 issn = {},
 keyword = {Fuzzy sets;Hospitals;Security management;Merging;Software;Data systems;Safety;usable-security;healthcare software;security research;empirical analysis;ANP;FS;TOPSIS;data breaches;Fuzzy-ANP-TOPSIS;Triangular Imprecise Number (TFN)},
 month = {May},
 number = {},
 pages = {629-634},
 title = {The Design of Security System in Transmission of Healthcare Cloud Data System to Secure from Attacks},
 volume = {},
