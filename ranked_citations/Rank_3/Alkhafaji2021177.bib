@article{Alkhafaji2021177,
 abstract = {Video tracking is the process of propagating a position of moving object over time by using a camera. The group and extended object tracking become a big problems and challenges in any applications. Groups are structures objects, formations of entities moving in a coordinated fashion, whose number vary in time, it can split, merge, can be near to each other or can spawn new groups. The main purpose of this paper is to present how to identify multiple moving objects in a scene and then apply preprocessing operations to prepare them for tracking. After that we illustrate the ways to find the trajectories of the objects in order to use graph mining algorithms to cluster these trajectories. © 2021},
 author = {Alkhafaji, Mustafa Asaad Hasan and Al-Assadi, Tawfiq A.},
 doi = {10.14704/WEB/V18SI05/WEB18222},
 journal = {Webology},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 number = {Special Issue},
 pages = {177 - 190},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Review of Tracking and Clustering Multiple Objects by Using Graph Mining Algorithms},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85119523880?origin=resultslist},
 volume = {18},
