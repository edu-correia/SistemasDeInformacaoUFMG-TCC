@conference{Khedri2013331,
 abstract = {Managing variability in a software family is crucial to software product line engineering. The existing variability management techniques, however do not particularly address database design in the context of information systems product lines. This paper presents a practical approach to handle variability in database design for families of software. We use the technique of Delta-Oriented Programming when a product is constructed by adding a number of delta modules to a core module incrementally, based on the features selected in the product configuration. We use SQL Data Definition Language to model core and delta modules. We present rules for consistency checking of the delta scripts based on the database consistency constraints to generate a valid consistent database schema for the product. Also we analyze the cases in which a conflict arises based on inconsistencies between delta modules. The fact that DDL is widely known to software developers, along with modularity and scalability of the proposed method makes it suitable to be used in industrial real world applications. © 2013 IEEE.},
 author = {Khedri, Niloofar and Khosravi, Ramtin},
 doi = {10.1109/APSEC.2013.52},
 journal = {Proceedings - Asia-Pacific Software Engineering Conference, APSEC},
 note = {Cited by: 13},
 pages = {331 - 338},
 publication_stage = {Final},
 source = {Scopus},
 title = {Handling database schema variability in software product lines},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84936873611?origin=resultslist},
 volume = {1},
 year = {2013}
}
