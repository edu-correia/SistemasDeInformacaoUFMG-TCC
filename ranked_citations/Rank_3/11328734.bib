 keyword = {Knowledge engineering;Resistance;Technological innovation;Navigation;Collaboration;Complexity theory;Wastewater;Stakeholders;Sustainable development;Resilience;Social Learning;Engineering Education;Critical Thinking;Future Engineer;Qualitative Research;Communication;On-the-Job training},
 month = {Nov},
