@inproceedings{11328734,
 abstract = {This work-in-progress paper explores how engineers were successful and challenged in their water engineering careers. Engineering education, traditionally focused on technical problem-solving, must incorporate collaborative, interdisciplinary approaches that engage engineers, policymakers, and local communities in sustainable solutions. Promoting the resilience of water systems necessitates the application of the social learning processes of adaptive management and stakeholder involvement. By adopting collaboration and experiential learning, future engineers can develop the skills necessary to navigate complex water management systems while addressing societal and environmental needs. Additionally, fostering critical thinking in engineering students is vital for navigating the complexities of water management, enabling them to assess diverse perspectives, innovation, and context-sensitive solutions. Through experiential learning and interdisciplinary collaboration, future engineers can cultivate the analytical skills required to address both technical and societal challenges in water sustainability. Studies have demonstrated that community-based water management and traditional water practices illustrate how incorporating diverse perspectives improves infrastructure design and governance. However, challenges such as knowledge gaps and resistance to change hinder the full integration of social learning in engineering practices. This study emphasizes the necessity for a transformative approach in engineering education that prioritizes interdisciplinary approaches that merge engineering expertise with collective learning to achieve sustainable water management. The objective is to establish a sustainable water management framework that is responsive to both societal and environmental considerations. To achieve this goal, this work uses thematic analysis of semi-structured interviews to explore how engineers are supported and challenged in their roles at a Midwestern municipal water treatment facility.},
 author = {Tarannum, Samia and Blackowski, Sarah},
 booktitle = {2025 IEEE Frontiers in Education Conference (FIE)},
