@inproceedings{6031568,
 abstract = {We investigate techniques for optimizing a multi-core CPU code back ported from a highly optimized GPU kernel. We show that common sub-expression elimination and loop unrolling optimization techniques improve code performance on the GPU, but not on the CPU. On the other hand, register reuse and loop merging are effective on the CPU and in combination they improve performance of the ported code by 16%.},
 author = {Ye, Dong and Titov, Alexey and Kindratenko, Volodymyr and Ufimtsev, Ivan and Martinez, Todd},
 booktitle = {2011 Symposium on Application Accelerators in High-Performance Computing},
 doi = {10.1109/SAAHPC.2011.8},
 issn = {2166-515X},
 keyword = {Graphics processing unit;Kernel;Optimization;Instruction sets;Registers;Central Processing Unit;Chemistry;GPU;common sub-expression elimination;lop unrolling;register reuse;loop merging;OpenMP},
 month = {July},
 number = {},
 pages = {72-75},
 title = {Porting Optimized GPU Kernels to a Multi-core CPU: Computational Quantum Chemistry Application Example},
 volume = {},
 year = {2011}
}
