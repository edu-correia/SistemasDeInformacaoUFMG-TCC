@inproceedings{1592434,
 abstract = {As the study on the semantic Web actively progresses, many domain ontologies are being built. However, most engineers are building the ontologies based on their academic background and research interests. Consequently, ontologies on the same subject are different because the ontology engineers have different view point. Furthermore, there is no standard method for building ontologies, and there are many ontology tools using different ontology languages. Because of these reasons, interoperability between the ontologies is very low. And, current ontology tools mostly concentrate on the functions to create, edit, inference the ontology. Methods for merging heterogeneous domain ontologies are not in most tools. This paper presents a study on a merging method for building a more complete ontology. The method was based on WordNet. The study tried to merge heterogeneous domain ontologies about the same subject throughout specific steps.},
 author = {Hyunjang Kong and Myunggwon Hwang and Pankoo Kim},
 booktitle = {International Conference on Next Generation Web Services Practices (NWeSP'05)},
 doi = {10.1109/NWESP.2005.7},
 issn = {},
 keyword = {Merging;Ontologies;Semantic Web;Computer science;Power engineering and energy;Manuals;Dictionaries;Web services;OWL;Microstrip},
 month = {Aug},
 number = {},
 pages = {6 pp.-},
 title = {A new methodology for merging the heterogeneous domain ontologies based on the WordNet},
 volume = {},
 year = {2005}
}
