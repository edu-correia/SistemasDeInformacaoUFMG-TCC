@conference{Baraglia201054,
 abstract = {Gossip-based Peer-to-Peer protocols proved to be very efficient for supporting dynamic and complex information exchange among distributed peers. They are useful for building and maintaining the net- work topology itself as well as to support a pervasive diffusion of the information injected into the network. In this paper, we propose the general architecture of a system that tries to exploit the collaborative exchange of information between peers in order to build a system able to gather similar users and spread useful suggestions among them.},
 author = {Baraglia, R. and Dazzi, P. and Mordacchini, M. and Perego, R. and Ricci, L.},
 journal = {SEBD 2010 - Proceedings of the 18th Italian Symposium on Advanced Database Systems},
 note = {Cited by: 2},
 pages = {54 - 61},
 publication_stage = {Final},
 source = {Scopus},
 title = {Gossip communities: Collaborative filtering through Peer-to-Peer overlays (extended abstract)},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84886951933?origin=resultslist},
 year = {2010}
}
