@inproceedings{11473933,
 abstract = {The rapid expansion of digital transformation poses important concerns for leadership dealing with resistance to change. While much of the literature has emphasized either the technological or organizational lens of digital transformation, the human side of this process has not received the same level of attention. This paper seeks to contribute by offering a bibliometric review of the literature on leadership, resistance to change, and digital transformation.Through bibliometric analysis and visualization tools (using the Scopus database and VOSviewer software), we undertake to examine the academic output published from January 2000 through February 2025 to uncover thematic clusters, research trends, and influential authors. The analyzed articles reflect three threads of discussion: (1) leadership styles and change, (2) digital adoption vs. resistance organizationally and (3) opposing and reimagined perspectives of digital leadership research. In addition, we highlighted gaps within literature that could be addressed through more empirical works that merge leadership theories and resistance, while also scoping down both perspectives to conceptualize digital change.This review supports the extant thinking by offering a knowledge-base-structured summary and opens new avenues for future empirical work linking the resistance to change and leadership in a digital transition process. More specifically, future works could investigate how specific leadership styles may hinder or support overcoming resistance to digital change.},
 author = {El Agdi, Nouhaila and Jamal, Abdelfattah and Benraïss, Bouchra},
 booktitle = {2025 IEEE International Conference on Advanced Technologies in Supply Chain Management (ATSCM)},
 doi = {10.1109/ATSCM67505.2025.11473933},
 issn = {},
 keyword = {Feedback;Filtering;Circuits;Diodes;Filters;Light emitting diodes;Protocols;Instant messaging;Electronic messaging;Internet;digital transformation;leadership;resistance to change;change management;organizational dynamics},
 month = {Nov},
