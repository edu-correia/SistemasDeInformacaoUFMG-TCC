@conference{Cheng2024662,
 abstract = {Mixed-reality (MR) technologies merge virtual content with users' perceptions of the real-world environment. These technologies revolutionize how humans interact with the surrounding world, and enhance machine understanding of human behavior and physical spaces. Though these technologies bring great potential benefits, they also raise new and serious computer security and privacy risks. For example, risks could arise from privacy-invasive data input (e.g., eye-tracking, hand-tracking, or spatial understanding of the physical world), user interaction with the three-dimensional virtual content, and user perception of the environment that blends real and virtual visual objects. My research aims to identify potential security and privacy risks, evaluate these risks in today's MR systems, and develop mitigation solutions to enhance user safety.  © 2024 IEEE.},
 author = {Cheng, Kaiming},
 doi = {10.1109/ISMAR-Adjunct64951.2024.00200},
 journal = {Proceedings - 2024 IEEE International Symposium on Mixed and Augmented Reality Adjunct, ISMAR-Adjunct 2024},
 note = {Cited by: 3},
 pages = {662 - 663},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards Safer Mixed Reality: Identifying, Evaluating, and Mitigating Security and Privacy Threats},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85214404925?origin=resultslist},
 year = {2024}
}
