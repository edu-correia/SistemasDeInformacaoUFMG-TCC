@inproceedings{6128550,
 abstract = {This paper deals with online scheduling and allocation of real-time hardware tasks onto partially reconfigurable Xilinx FPGAS. We present a novel fault-aware online allocator which ensures the correctness of the computation by circumventing the permanent damage in the chip. The allocator is merged with an EDF-based scheduler to make up a highly-Reliable Reconfigurable Real-Time Operating System (R3TOS). The experiments carried out show that R3TOS misses 10% less deadlines and reduces the scheduling time overhead by over 90% compared with related approaches.},
 author = {Iturbe, Xabier and Benkrid, Khaled and Arslan, Tughrul and Hong, Chuan and Martinez, Imanol},
 booktitle = {2011 International Conference on Reconfigurable Computing and FPGAs},
 doi = {10.1109/ReConFig.2011.34},
 issn = {2325-6532},
 keyword = {Field programmable gate arrays;Resource management;Hardware;Radiation detectors;Real time systems;Processor scheduling;Computational modeling;Fault-Tolerance;Reconfigurable Computing;Real-Time Scheduling;Hardware Virtualization},
 month = {Nov},
 number = {},
 pages = {27-34},
 title = {Empty Resource Compaction Algorithms for Real-Time Hardware Tasks Placement on Partially Reconfigurable FPGAs Subject to Fault Ocurrence},
 volume = {},
 year = {2011}
}
