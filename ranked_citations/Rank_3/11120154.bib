@inproceedings{11120154,
 abstract = {Early detection of lung cancer is paramount for improved patient outcomes and reduced mortality rates. This research presented an innovative methodology combining machine learning with low-dose CT scans for this purpose. The objective was to retain diagnostic accuracy while significantly reducing radiation exposure, merging patient safety with effective disease detection. Our results showed a high true positive rate, reaching up to 98 % at specific thresholds, and a false positive rate that decreased to a mere 4 % in stringent testing conditions. This performance is not only promising but also rivals, and in certain parameters surpasses, traditional high-dose CT scans. A notable aspect of this study was the use of a deep learning-based image reconstruction algorithm, enhancing the clarity of low-radiation scans, ensuring they retain diagnostic reliability. When juxtaposed with the risks associated with high-dose CT scans, the proposed methodology offers a groundbreaking alternative that doesn't compromise on efficacy. While the findings are robust and promising, a broader real-world application and validation are crucial. The integration of machine learning with low-dose CT scans heralds a potential paradigm shift in lung cancer detection, championing a future of enhanced safety and precision in diagnostics.},
 author = {R, Vinston Raja and R, Surendran and Franklin, Ramya G and Balamurugan, K S and Gnanaselvam, R},
 booktitle = {2024 IEEE 9th International Conference on Engineering Technologies and Applied Sciences (ICETAS)},
 doi = {10.1109/ICETAS62372.2024.11120154},
 issn = {2769-4518},
 keyword = {Accuracy;Computed tomography;Lung cancer;Machine learning;Sensitivity and specificity;Safety;Reliability;Image reconstruction;Standards;Testing;Lung cancer detection;Low-dose CT scans;Machine learning;Image reconstruction;Radiation exposure},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Machine Learning Techniques for Accurate Staging of Lung Carcinoma from Low-Radiation CT Scans},
 volume = {},
 year = {2024}
}
