@inproceedings{1684875,
 abstract = {In this paper, we present a new technique to manage the updating and logging of the space-map page when allocating and deallocating pages for B-link-tree structure modification (SM) operations such as page splits or page merges. In this technique, page allocation/deallocation and tree-structure modification operation are executed and logged separately using redo-undo and redo-only log records, respectively, and implemented as a nested-top-action. This technique enhances concurrency, avoids the problem of incorrect information in space-map page, and eliminates the need for a garbage-collection process.},
 author = {Jaluta, I. and Majumda, D.},
 booktitle = {2006 2nd International Conference on Information & Communication Technologies},
 doi = {10.1109/ICTTA.2006.1684875},
 issn = {},
 keyword = {Samarium;Concurrent computing;Space technology;Technology management;Engineering management;Concurrency control;Database systems;Protocols;Tree data structures;Frequency},
 month = {April},
 number = {},
 pages = {2909-2912},
 title = {Efficient Space Management for B-tree Structure-Modification Operations},
 volume = {2},
 year = {2006}
}
