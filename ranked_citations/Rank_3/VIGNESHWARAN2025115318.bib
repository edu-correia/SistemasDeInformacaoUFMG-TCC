@article{VIGNESHWARAN2025115318,
 abstract = {This study presents an eco-friendly synthesis of Triphala-ZnO nanocomposite by integrating the traditional Ayurvedic remedy Triphala with zinc oxide nanoparticles (ZnO). The XRD analysis confirmed the crystalline structure of the composite, with slight peak shifts indicating successful incorporation of Triphala into ZnO. The average crystallite size varies across different peaks, ranging from approximately 26.26 nm to 111.67 nm. FTIR analysis revealed characteristic functional groups such as OH, CO, and ZnO, indicating the presence of organic and inorganic components. Morphological analysis through SEM and TEM demonstrated a well-developed, interconnected nanoparticle network with a d-spacing of 0.28 Å, contributing to enhanced material properties. Electrochemical impedance spectroscopy (EIS) measurements revealed an increase in ionic conductivity, with a maximum value of 1.6 × 10−3 S/cm for the Triphala-ZnO [T-ZnO] composite compared to 3.4 × 10−4 S/cm for pure Triphala [PT]. Conductance spectra analysis showed distinct variations in conductivity behaviour, with the composite exhibiting higher charge transport efficiency. Dielectric studies demonstrated improved dielectric constant and loss, with enhanced polarization effects due to the inclusion of ZnO, suggesting potential applications in energy storage. Antibacterial studies were conducted against various pathogens, including Staphylococcus aureus, Enterococcus faecalis, Escherichia coli, Pseudomonas aeruginosa, and Candida albicans. The Triphala-ZnO nanocomposite exhibited enhanced antibacterial activity, with zone inhibition values of 18 mm, 0 mm, 12.33 mm, 15.67 mm, and 12.33 mm, respectively, compared to pure Triphala. This improved antibacterial performance can be attributed to the generation of reactive oxygen species (ROS) by ZnO, leading to oxidative stress and cell membrane disruption. This research aligns with green chemistry principles and contributes to the growing field of eco-friendly nanocomposites with potential applications in biomedical and electrochemical energy storage.},
 author = {S. Vigneshwaran and R. Aswini and H. Premkumar and C. Naveen and M. Muthuvinayagam and S. Vadivel and P. Rameshkumar and SaravanaVadivu Arunachalam and N. Manivannan and N. Revathi and K. Kalaivani},
 doi = {https://doi.org/10.1016/j.inoche.2025.115318},
 issn = {1387-7003},
 journal = {Inorganic Chemistry Communications},
 keyword = {Green synthesis, Triphala-ZnO nanocomposite, Electrochemical impedance and anti- bacterial activity},
 pages = {115318},
 title = {Green synthesis of Triphala - zinc oxide nanocomposite: electrochemical impedance and anti-microbial activity},
 url = {https://www.sciencedirect.com/science/article/pii/S1387700325014352},
 volume = {181},
 year = {2025}
}
