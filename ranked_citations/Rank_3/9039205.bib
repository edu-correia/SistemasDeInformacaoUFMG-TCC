@inproceedings{9039205,
 abstract = {The axiomatic method of formalizing mass data processing (MDP) is considered in the article. MDP are associated with parallel computing and are most often determined as follows: MDP is a method of parallel processing of large volumes of data by a large number of processors. Currently, MDP is also associated with Big data. Big data is a general term that refers to newly created structured, unstructured and semi-structured data of extremely large and constantly increasing volumes; loading them into a regular (for example, relational) database and subsequent processing require too much resources of computing complexes. Next, we consider the problem of formalizing one of the MDP classes - the processing of structured data. Formalization is carried out on the basis of two traditional mathematical methods: axiomatic and algebraic.},
 author = {Munerman, Victor and Munerman, Daniel},
 booktitle = {2020 IEEE Conference of Russian Young Researchers in Electrical and Electronic Engineering (EIConRus)},
 doi = {10.1109/EIConRus49466.2020.9039205},
 issn = {2376-6565},
 keyword = {Data models;Data aggregation;Merging;Big Data;Compounds;Parallel processing;software-hardware complex;big data;database;grid technology;container technology},
 month = {Jan},
 number = {},
 pages = {1996-2000},
 title = {An Axiomatic Approach to the Data Models Formalization for Mass Data Processing},
 volume = {},
 year = {2020}
}
