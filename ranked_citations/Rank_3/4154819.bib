@article{4154819,
 abstract = {This paper presents a novel approach to high-resolution ultrasonic environment imaging for autonomous mobile systems. It describes the fusion of sensor data from multiple wide-angled ultrasonic transducers with overlapping detection cones for creating local environment models. A fitting technique defined as tangential regression is introduced that considers sensor properties as well as physical reflection properties of ultrasound. This allows a reliable detection and localization of straight-line segments which describe the boundary of geometric objects. Experimental results show that straight-line segments extracted at different robot locations can be aggregated and merged in order to obtain a global environment map},
 author = {Bank, Dirk and Kampke, Thomas},
 doi = {10.1109/TRO.2007.895060},
 issn = {1941-0468},
 journal = {IEEE Transactions on Robotics},
 keyword = {High-resolution imaging;Ultrasonic imaging;Sensor phenomena and characterization;Sensor arrays;Optical imaging;Sensor fusion;Ultrasonic transducers;Optical reflection;Object detection;Data mining;Autonomous mobile systems;high-resolution ultrasonic sensing;map building;sensor data fusion;tangential regression},
 month = {April},
 number = {2},
 pages = {370-381},
 title = {High-Resolution Ultrasonic Environment Imaging},
 volume = {23},
 year = {2007}
}
