@article{FU2026109492,
 abstract = {Cross-modal fusion effectively enhances emotion recognition performance by integrating complementary information from different modalities. Current fusion strategies primarily combine various types of data sources or merge different backbone features through designed neural network modules. However, these methods lack early-stage modal interaction, overlooking the influence of modal differences on cross-modal fusion performance. This paper proposes a bidirectional feature coupling network (BFCNet) for cross-modal emotion recognition, which utilizes the functional connectivity characteristics based on Electroencephalography. BFCNet introduces feature coupling blocks (FCB) at each stage of feature extraction, enabling information interaction between different modalities and thereby better capturing modal differences in cross-modal fusion. FCB incorporates multiple cross-attention mechanisms, dynamically selecting and integrating relevant information between modalities, thereby enhancing the understanding and recognition of emotional change processes. Comprehensive experiments on the SEED and SEED-IV public datasets demonstrate that BFCNet achieves average accuracies of 98.44% and 92.49% on the SEED and SEED-IV datasets, respectively.},
 author = {Baole Fu and Xiangkun Yu and Feng Wu and Yinhua Liu},
 doi = {https://doi.org/10.1016/j.bspc.2026.109492},
 issn = {1746-8094},
 journal = {Biomedical Signal Processing and Control},
 keyword = {Emotion recognition, Functional connectivity, Feature coupling, Cross-modal learning, Cross-attention},
 pages = {109492},
 title = {BFCNet: A bidirectional feature coupling network for cross-modal emotion recognition based on brain functional connectivity},
 url = {https://www.sciencedirect.com/science/article/pii/S1746809426000467},
 volume = {116},
 year = {2026}
}
