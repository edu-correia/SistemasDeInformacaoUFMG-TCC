@article{Liu2015837,
 abstract = {In the future, Machine-to-Machine (M2M) technology will be popularly used to make the world more connected. M2M gateways play an important role in bridging locally networked devices to a wired or wireless connection. In this paper, classifications of M2M gateways are summarized, and the key technology of M2M gateway is mainly discussed such as complex event processing, protocol conversion, identification & addressing and security enhancement. At the same time, the architecture model of M2M gateway is also described in detail. In the end, the trends of M2M gateways are analyzed. © Springer International Publishing Switzerland 2015.},
 author = {Liu, Lianru and Gu, Minxia and Ma, Yan},
 doi = {10.1007/978-3-319-15554-8_76},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {837 - 843},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on the key technology of M2M gateway},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84924422921?origin=resultslist},
 volume = {8944},
 year = {2015}
}
