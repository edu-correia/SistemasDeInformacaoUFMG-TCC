@conference{Wang2008169,
 abstract = {Determining concept similarity in heterogeneous ontologies is a vital problem in the area of the semantic web. Current approaches normally consider single hierarchial concept relations, only, which fail to express rich and implied information. Moreover, concept similarity under multiple relations as required in many application scenarios of semantic web services has not been investigated, yet. Basing on a method to merge heterogenous ontologies into an application ontology, here a representation model for application ontologies is elaborated. It has the form of a semantic net with multiple weighted concept relations, for which a novel algorithm to assess concept similarity is presented.},
 author = {Wang, X. and Zhao, Y. and Halang, W.A.},
 doi = {10.1142/9789812799470_0028},
 journal = {World Scientific Proceedings Series on Computer Engineering and Information Science 1; Computational Intelligence in Decision and Control - Proceedings of the 8th International FLINS Conference},
 note = {Cited by: 0},
 pages = {169 - 174},
 publication_stage = {Final},
 source = {Scopus},
 title = {Concept similarity in multirelational application ontologies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/58049156144?origin=resultslist},
 year = {2008}
}
