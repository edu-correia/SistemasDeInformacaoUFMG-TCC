@inproceedings{9778307,
 abstract = {Social Internet of Things (SIoT) is a new paradigm that combines Internet of Things (IoT) and Social Network. SIoT makes the IoT smarter by analyzing the social relationships among IoT devices. SIoT can contribute the collaboration among devices belonging to a community to process local events without the support of a remote server. Community detection in SIoT requires attention to the multiple social relationships that exist between devices. However, the community structure in each of the multiple relationship layers is not considered in the existing studies. Hence, in this study, a Multilayer Community Detection Algorithm Based on Aggregation was proposed to solve the abovementioned problem. The rationale of the algorithm is to first perform community detection for each layer of the network separately, and then merge or dissolve the overlapping communities based on their overlap rates. For the overlapping communities that are not merged or dissolved, they are partitioned into non-overlapping communities. The algorithm has been performed on real-world data collected from 16216 devices in Santander, Spain. The experimental results show that our algorithm performs better than the existing algorithms and the success rate and success rate per unit time are raised by 2%-5% and up to 15%, respectively.},
 author = {Wang, Pingdong and Victor Chan, Wai Kin},
 booktitle = {2022 7th International Conference on Intelligent Computing and Signal Processing (ICSP)},
 doi = {10.1109/ICSP54964.2022.9778307},
 issn = {},
 keyword = {Performance evaluation;Social networking (online);Heuristic algorithms;Urban areas;Signal processing algorithms;Signal processing;Nonhomogeneous media;Social Internet of Things;Social Network;Community Detection},
 month = {April},
 number = {},
 pages = {610-614},
 title = {A Multilayer Community Detection Algorithm Based on Aggregation in Social Internet of Things},
 volume = {},
 year = {2022}
