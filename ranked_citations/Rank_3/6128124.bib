@inproceedings{6128124,
 abstract = {We propose a novel content-based Publish-Subscribe system over structured P2P networks, namely Marshmallow, to provide efficient, scalable and adaptable event dissemination service. Marshmallow introduces a subscription merging strategy to reduce the subscription cost and frequency of event matching, meanwhile, it smartly exploits the embedded trees of Pastry overlay to deliver event with high event coverage rate, low delivery latency and low bandwidth consumption. The experimental results demonstrate that Marshmallow greatly improves event delivery latency and coverage rate, and reduces the redundant event delivery and dissemination cost significantly.},
 author = {Gao, Sheng and Li, Guohui and Zhao, Pei},
 booktitle = {2011 Seventh International Conference on Computational Intelligence and Security},
 doi = {10.1109/CIS.2011.71},
 issn = {},
 keyword = {Subscriptions;Peer to peer computing;Routing;Bandwidth;Merging;IP networks;Publish-subscribe;Information Dissemination Service;P2P;Publish-Subscribe;Pastry;Subscription Aggregation},
 month = {Dec},
 number = {},
 pages = {290-294},
 title = {Marshmallow: A Content-Based Publish-Subscribe System over Structured P2P Networks},
 volume = {},
 year = {2011}
}
