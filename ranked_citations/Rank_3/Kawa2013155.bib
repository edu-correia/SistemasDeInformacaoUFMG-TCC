@article{Kawa2013155,
 abstract = {At CeON ICM UW we are in possession of a large collection of scholarly documents that we store and process using MapReduce paradigm. One of the main challenges is to design a simple, but effective data model that fits various data access patterns and allows us to perform diverse analysis efficiently. In this paper, we will describe the organization of our data and explain how this data is accessed and processed by open-source tools from Apache Hadoop Ecosystem. © 2013 Springer-Verlag Berlin Heidelberg.},
 author = {Kawa, Adam and Bolikowski, Łukasz and Czeczko, Artur and Dendek, Piotr Jan and Tkaczyk, Dominika},
 doi = {10.1007/978-3-642-35647-6_12},
 journal = {Studies in Computational Intelligence},
 note = {Cited by: 4; All Open Access; Green Open Access},
 pages = {155 - 169},
 publication_stage = {Final},
 source = {Scopus},
 title = {Data model for analysis of scholarly documents in the mapreduce paradigm},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84884712024?origin=resultslist},
 volume = {467},
 year = {2013}
}
