@conference{Wang20103529,
 abstract = {Tracking by association of low frame rate detection responses is not trivial, as motion is less continuous and hence ambiguous. The problem becomes more challenging when occlusion occurs. To solve this problem, we firstly propose a robust data association method that explicitly differentiates ambiguous tracklets that are likely to introduce incorrect linking from other tracklets, and deal with them effectively. Secondly, we solve the long-time occlusion problem by detecting inter-track relationship and performing track split and merge according to appearance similarity and occlusion order. Experiment on a challenging human surveillance dataset shows the effectiveness of the proposed method. © 2010 IEEE.},
 author = {Wang, Lu and Yung, Nelson H. C.},
 doi = {10.1109/ICPR.2010.861},
 journal = {Proceedings - International Conference on Pattern Recognition},
 note = {Cited by: 3},
 pages = {3529 - 3532},
 publication_stage = {Final},
 source = {Scopus},
 title = {Detection based low frame rate human tracking},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78149488624?origin=resultslist},
 year = {2010}
}
