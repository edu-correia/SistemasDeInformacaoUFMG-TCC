 publication_stage = {Final},
 source = {Scopus},
 title = {A ROS2-Based Gateway for Modular Hardware Usage in Heterogeneous Environments},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85206315977?origin=resultslist},
 volume = {24},
 year = {2024}
}
