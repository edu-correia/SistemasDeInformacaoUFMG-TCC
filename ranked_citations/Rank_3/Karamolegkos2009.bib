@conference{Karamolegkos2009,
 abstract = {In this paper we examine the issue of multimedia file exchange within the scope of social networking. We start by providing a quick overview of several important approaches that have contributed to the efficient merge of the two aforementioned concepts. The paper then focuses on dynamic issues that pertain to the functionality of such applications. We propose a relevant dynamic algorithm, whose purpose is to optimize the dynamics of social networking-based multimedia file sharing and streaming systems. The only assumption made for our system, is that there has been an initial decomposition of users into groups of users, based on a description of their interests. We conclude the paper by showcasing the effectiveness of our proposed scheme trough experimental results. ©2009 IEEE.},
 author = {Karamolegkos, Pantelis and Doulamis, Nikolaos},
 doi = {10.1109/ICUMT.2009.5345647},
 journal = {2009 International Conference on Ultra Modern Telecommunications and Workshops},
 note = {Cited by: 1; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multimedia file exchange and P2P social networking: Efficient allocation of users into communities of interest},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/74549141941?origin=resultslist},
 year = {2009}
}
