@inproceedings{4662873,
 abstract = {The conventional model for knowledge organization management is based on resource; index and metadata catalog. It is difficult to express the concept of knowledge resource, the information contained in knowledge elements and the inner relevance of information. In an attempt to solve this problem, a new model for distributed knowledge organization management is proposed based on extended topic maps. The association of subject-knowledge element-occurrence and the relevance between the subjects and between the knowledge elements are established. The expression of multi-level, multi-granularity and inner relevant characteristics of knowledge is improved. The knowledge logic organization framework based on extended topic maps is presented. Additionally, a new similarity measure algorithm based on comprehensive information theory for topic maps is proposed. The methods of topic maps merging and dynamic updating are also introduced.},
 author = {Lu, Huimin and Feng, Boqin and Zhao, Yingliang and Zheng, Qinghua and Liu, Jun},
 booktitle = {2008 Seventh International Conference on Grid and Cooperative Computing},
 doi = {10.1109/GCC.2008.79},
 issn = {2160-4916},
 keyword = {Knowledge management;Resource management;Merging;Conference management;Engineering management;Logic;Information theory;Search engines;Software libraries;Distributed computing;knowledge organization management;topic map;extended topic map},
 month = {Oct},
 number = {},
 pages = {261-265},
 title = {A New Model for Distributed Knowledge Organization Management},
 volume = {},
 year = {2008}
}
