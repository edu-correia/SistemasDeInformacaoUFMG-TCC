@inproceedings{1420249,
 abstract = {In this paper, we discuss the use of adaptive filters for the control of complex autonomous robot systems. A concept is presented to solve the resulting problem complexity by merging rule-based approaches with adaptive control, thus balancing a coarsening of the configuration/decision space by the implicit exploitation of former experience, encoded in a history array. Future work will be focussed on the detail evaluation of the approach and its implementation for a climbing robot application.},
 author = {Grosspietsch, K.-E.},
 booktitle = {19th IEEE International Parallel and Distributed Processing Symposium},
 doi = {10.1109/IPDPS.2005.77},
 issn = {1530-2075},
 keyword = {Adaptive filters;Robot control;Control systems;Embedded system;Physics computing;Artificial neural networks;Intelligent robots;Embedded computing;Mechatronics;Monitoring},
 month = {April},
 number = {},
 pages = {4 pp.-},
 title = {Adaptive filters for the dependable control of autonomous robot systems},
 volume = {},
 year = {2005}
}
