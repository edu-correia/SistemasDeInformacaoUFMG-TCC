@article{Amer-Yahia200571,
 abstract = {The salient aspects of the SIGMOD 2005 panel on 'Databases and Information Retrieval: Rethinking the Great Divide' are discussed. The goal of the panel is to discuss whether one should rethink data management system architectures to truly merge database (DB) and information retrieval (IR) technologies. Recent trends in DB and IR research demonstrate a growing interest in adopting IR techniques in DBs and vice versa. The panel included established DB and IR experts who covered different perspectives of the panel topic.},
 author = {Amer-Yahia, Sihem and Case, Pat and Rölleke, Thomas and Shanmugasundaram, Jayavel and Weikum, Gerhard},
 doi = {10.1145/1107499.1107514},
