@article{Krinidis20091613,
 abstract = {This paper presents a new approach for the segmentation of color textured images, which is based on a novel energy function. The proposed energy function, which expresses the local smoothness of an image area, is derived by exploiting an intermediate step of modal analysis that is utilized in order to describe and analyze the deformations of a 3-D deformable surface model. The external forces that attract the 3-D deformable surface model combine the intensity of the image pixels with the spatial information of local image regions. The proposed image segmentation algorithm has two steps. First, a color quantization scheme, which is based on the node displacements of the deformable surface model, is utilized in order to decrease the number of colors in the image. Then, the proposed energy function is used as a criterion for a region growing algorithm. The final segmentation of the image is derived by a region merge approach. The proposed method was applied to the Berkeley segmentation database. The obtained results show good segmentation robustness, when compared to other state of the art image segmentation algorithms. © 2009 IEEE.},
 author = {Krinidis, Michail and Pitas, Ioannis},
 doi = {10.1109/TIP.2009.2018002},
 journal = {IEEE Transactions on Image Processing},
 note = {Cited by: 63},
 number = {7},
 pages = {1613 - 1622},
 publication_stage = {Final},
 source = {Scopus},
 title = {Color texture segmentation based on the modal energy of deformable surfaces},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/67649867122?origin=resultslist},
 volume = {18},
