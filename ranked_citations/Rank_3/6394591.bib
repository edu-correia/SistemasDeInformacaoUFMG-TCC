@inproceedings{6394591,
 abstract = {The Constant Degree P2P systems are turning into the research hotspot, but all topologically-aware technologies perform poorly when replanted to them. Combining constant degree topologies' property and taking FissionE as an example, we propose a merge technology RBFIM (Relaxed Balance based fast Induced Merge) to optimize the construction of topologically-aware hierarchy constant degree P2P Systems. Experiment results show that RBFIM not only preserves constant degree P2P systems' advantages on logically routing, but also strength the locality of communication and can be integrated with other optimization technologies.},
 author = {Wang, XiaoHai and Dai, XiuLiang and Bei, Li},
 booktitle = {2012 International Conference on Computer Science and Service System},
 doi = {10.1109/CSSS.2012.353},
 issn = {},
 keyword = {Peer to peer computing;Routing;Topology;Merging;Logic gates;Periodic structures;Underwater vehicles;constant degree topology;P2P;topologically aware;merge technology},
 month = {Aug},
 number = {},
 pages = {1401-1404},
 title = {An Efficient Merge Technology for Constant Degree P2P Systems},
 volume = {},
 year = {2012}
}
