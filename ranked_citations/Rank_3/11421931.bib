@article{11421931,
 abstract = {Scanned poster materials frequently exhibit blur degradation arising from scanner hardware constraints, document manipulation movements, and optical apparatus imperfections. This research introduces PDPNet, a parallel dual-path network framework designed for clarity recovery in digitized graphic documents, with particular emphasis on poster and print media scenarios. The architecture operates via two autonomous processing channels: a spatial pathway preserving layout organization and textual content integrity, alongside a frequency pathway recovering fine printing details through wavelet-based decomposition mechanisms. An adaptive integration strategy dynamically merges outputs from both channels according to regional content characteristics. Experimental assessments on poster scanning collections demonstrate that our methodology attains PSNR of 31.82 dB (mean over 3 runs) and SSIM of 0.943, constituting statistically significant improvements (p<0.01) of 0.11 dB and 0.015 respectively compared to state-of-the-art approaches. Critically, document-specific evaluations reveal substantial enhancements in text recognition: Character Error Rate reduced to 4.23% (12.8% relative improvement) and Word Error Rate to 10.12% (10.8% relative improvement), directly validating practical usability for document digitization applications. The framework demonstrates superior performance in maintaining text legibility and graphical sharpness within scanned documents while requiring only 5.2M parameters.},
 author = {Chao, Peng},
 doi = {10.1109/ACCESS.2026.3670769},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {Feature extraction;Frequency-domain analysis;Computer architecture;Deblurring;Wavelet transforms;Layout;Encoding;Digitization;Spatial resolution;Degradation;Scanned document restoration;print clarity enhancement;parallel processing;wavelet decomposition;poster deblurring},
 month = {},
 number = {},
 pages = {36202-36225},
 title = {Parallel Dual-Path Network for Clarity Restoration of Scanned Posters via Frequency Decomposition},
 volume = {14},
 year = {2026}
}
