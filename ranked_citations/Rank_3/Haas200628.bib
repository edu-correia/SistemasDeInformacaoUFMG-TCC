@article{Haas200628,
 abstract = {Information integration is becoming a critical problem for businesses and individuals alike. Data volumes are sky-rocketing, and new sources and types of information are proliferating. This paper briefly reviews some of the key research accomplishments in information integration (theory and systems), then describes the current state-of-the-art in commercial practice, and the challenges (still) faced by CIOs and application developers. One critical challenge is choosing the right combination of tools and technologies to do the integration. Although each has been studied separately, we lack a unified (and certainly, a unifying) understanding of these various approaches to integration. Experience with a variety of integration projects suggests that we need a broader framework, perhaps even a theory, which explicitly takes into account requirements on the result of the integration, and considers the entire end-to-end integration process. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Haas, Laura},
 doi = {10.1007/11965893_3},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 53},
 pages = {28 - 43},
 publication_stage = {Final},
 source = {Scopus},
 title = {Beauty and the beast: The theory and practice of information integration},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84878687539?origin=resultslist},
 volume = {4353 LNCS},
 year = {2006}
}
