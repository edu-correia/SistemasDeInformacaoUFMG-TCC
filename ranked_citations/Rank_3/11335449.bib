@inproceedings{11335449,
 abstract = {Aiming at the problems of traditional 3D ink realtime rendering methods such as poor performance of feature contour, weakening of internal texture features, low accuracy of regional rendering, and high cost and long cycle caused by relying on manual pre drawn texture, a 3D ink real-time rendering method combining contour enhancement and dynamic optimization is proposed. An improved half Lambert illumination model was designed to adapt to the characteristics of ink and wash. Through piecewise nonlinear interpolation function and reverse illumination control, the gray gradient effect of ink and wash was realized to strengthen the ink level; The Gaussian filter dynamic diffusion mechanism based on separation convolution optimization is introduced to simulate the penetration and halo effect of ink on the surface of painting paper; At the same time, the improved multi-channel contour generation algorithm is used to extract and optimize the style; Finally, the final rendering result is obtained by merging the contour rendering results. The experimental results show that this method not only guarantees the real-time rendering performance, but also effectively realizes the digital simulation of the core elements of the freehand brushwork style of traditional Chinese ink painting, significantly reduces the dependence on manual pre drawn texture, and provides a programmed and low-cost solution for the efficient rendering of 3D model.},
 author = {Pu, Xingyu and He, Xiaoxi and Song, Ziwei and Pu, Xingyu and Ren, Bingquan and Peng, Hongyu},
 booktitle = {2025 4th International Conference on Cloud Computing, Big Data Application and Software Engineering (CBASE)},
 doi = {10.1109/CBASE67452.2025.11335449},
 issn = {},
 keyword = {Solid modeling;Adaptation models;Three-dimensional displays;Heuristic algorithms;Ink;Manuals;Rendering (computer graphics);Real-time systems;Optimization;Painting;Real-time ink rendering;NPR;dynamic ink diffusion;Stylized contour renderingIntroduction},
 month = {Oct},
 number = {},
 pages = {845-849},
 title = {Realtime Rendering of 3D Ink Based on Stylized Contour and Ink Diffusion Optimization},
