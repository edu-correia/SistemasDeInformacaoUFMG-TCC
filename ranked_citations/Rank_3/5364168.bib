 doi = {10.1109/ISDA.2009.187},
 issn = {2164-7151},
 keyword = {Ontologies;Merging;Geographic Information Systems;Spatial databases;Data acquisition;Intelligent systems;Deductive databases;Information technology;Costs;Technological innovation;Interoperability;Information Sharing;Ontology;GIS;Semantic;Translator Engine},
 month = {Nov},
 number = {},
 pages = {1179-1183},
 title = {Ontology Merging and Data Schema Integration: An Approach to Identify Semantic Similarity and Resolve Schematic Heterogeneity in Interoperable GIS Application},
