@inproceedings{4722204,
 abstract = {An automatic multi-view point cloud merging algorithm used in structured light measurement system is presented. Firstly, an improved regional marked algorithm combined with Least-Squares algorithm is used to compute the center of the reference points accurately, and the 3D coordinate of the reference points is ascertained according to the theory of machine vision. Then, based on the spatial character invariability, a rapid reference points matching algorithm is proposed to acquire the corresponding relationship between the reference points with different views. Finally, the rotation matrix and translation matrix are computed by quaternion decompose algorithm to carry out the automatic multi-view point cloud merging algorithm. The result of the experiments shows great validity and practicability of the algorithm.},
 author = {Che, Xiangqian and Zhao, Fujun and Ma, JiaJun and Bian, Li},
 booktitle = {2008 International Conference on Computer Science and Software Engineering},
 doi = {10.1109/CSSE.2008.501},
 issn = {},
 keyword = {Merging;Matrix decomposition;Coordinate measuring machines;Three-dimensional displays;Quaternions;Calibration;Software algorithms;Software measurement},
 month = {Dec},
 number = {},
 pages = {939-942},
 title = {An automatic multi-view point cloud merging algorithm used in structured light measurement system},
 volume = {2},
 year = {2008}
}
