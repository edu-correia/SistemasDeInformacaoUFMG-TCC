@inproceedings{9313928,
 abstract = {Systems engineering relies on a diversity of views of the same system representing the involved domains at different abstraction levels. These views need to be and remain consistent throughout the whole engineering process. To this end, a unified and formal framework is needed to model these different views together with their dependencies and relationships. Furthermore, this framework will be used to ensure collaboration between domains and consistency between different models that represent the same mechatronic system. In this paper, we propose that this framework can rely mathematically in a declarative form via category theory (CT). The use of CT therefore will support the collaboration between different models. The main objective of applying category theory in the current research is to model interaction, transformation, synchronization, considering that all this model management scenarios can be seen as category specification applications. Moreover, a model that merge different models according to three points of view (requirement, behavior and structure) within systems engineering is going to be defined. To this end, a Meta-Model is established for the collaboration between systems engineering (SE) and safety assessment (SA). The categorical framework ensures the connection and the consistency between models relevant categories via morphisms and functors. Therefore this proposed categorical framework might be generalized and enhanced to represent any other model involved in systems engineering such as the 3D model category that can be created following a standard norm to integrate emerging flows phenomena.},
 author = {Abdeljabbar, Nourhene and Mhenni, Faïda and Choley, Jean-Yves},
 booktitle = {2020 21st International Conference on Research and Education in Mechatronics (REM)},
 doi = {10.1109/REM49740.2020.9313928},
 issn = {},
 keyword = {Modeling;Unified modeling language;Mathematical model;Safety;Mechatronics;Collaboration;Synchronization;Category Theory;Systems Engineering;MBSE;MBSA;Modeling;Mechatronic Systems},
 month = {Dec},
 number = {},
 pages = {1-5},
 title = {A categorical framework for Safety critical mechatronic systems modeling},
 volume = {},
 year = {2020}
}
