@article{1304566,
 abstract = {From the very beginning, integration of microelectromechanical systems (MEMS) with integrated circuits (ICs) was a major attraction of silicon micromachining technology. Significant progress toward integrating MEMS with ICs technologies has been made over the last four decades. Many products have been introduced and the benefits of such integration have been demonstrated. One of the most attractive developments, during the period of time called the Optical Bubble, was the vertical MEMS-IC integration, pioneered by Transparent Networks. It enabled a short path to merging VLSI electronics with MEMS. This approach can be easily applied to capacitive sensors, such as pressure, acceleration, gyro, and vacuum sensors, as well as to a broad range of other products.},
 author = {Bryzek, J. and Flannery, A. and Skurnik, D.},
 doi = {10.1109/MIM.2004.1304566},
 issn = {1941-0123},
 journal = {IEEE Instrumentation & Measurement Magazine},
 keyword = {Microelectromechanical systems;Micromechanical devices;Integrated circuit technology;Capacitive sensors;Silicon;Micromachining;Integrated optics;Optical fiber networks;Optical sensors;Merging},
 month = {June},
 number = {2},
 pages = {51-59},
 title = {Integrating microelectromechanical systems with integrated circuits},
 volume = {7},
 year = {2004}
}
