@inproceedings{11515794,
 abstract = {Co-occurring Local Binary Patterns (LBPs) capture spatial relationships between adjacent intensity transitions and are effective for texture-based biomedical image analysis. Existing rotation-invariant formulations, such as RIC-LBP, still treat mirror-reflected configurations as distinct, introducing redundant orientation variability. We analyze how the cyclic group $C_{2}$ and dihedral group $D_{2}$ partition the 256 adjacent 4-bit LBP pairs, identifying the cases where reflection merges rotation-generated bins. We propose a compact reflectionand rotation-invariant descriptor (RRIC-LBP) based on $D_{2}$ orbits, reducing the histogram dimensionality from 136 to 88. Evaluations on fluorescence microscopy of mitochondrial networks show statistically equivalent classification performance, demonstrating that the reduced representation maintains discriminative power.},
 author = {Hladůvka, Jiří and Hodorová, Viktória},
 booktitle = {2026 IEEE 23rd International Symposium on Biomedical Imaging (ISBI)},
 doi = {10.1109/ISBI61048.2026.11515794},
 issn = {1945-8452},
 keyword = {Reflection;Orbits;Orbits (stellar);Printing;Histograms;Accuracy;Microscopy;Cells (biology);Merging;Imaging;Texture descriptors;Local Binary Patterns;Dihedral symmetry;Cell microscopy},
 month = {April},
 number = {},
 pages = {1-5},
 title = {Dihedral-Invariant LBP Co-Occurrence for Cellular Texture Analysis},
 volume = {},
 year = {2026}
}
