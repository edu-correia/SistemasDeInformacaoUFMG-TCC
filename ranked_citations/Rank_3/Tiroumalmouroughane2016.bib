@conference{Tiroumalmouroughane2016,
 abstract = {Today's rivalry surroundings push the organization to spread out their attention and collaborate with their professional followers to transport the inevitabilities. Service Integration has turned out to be a serious issue as enterprise discovers a better requisite to regularly interact with their professional followers and share their business logics to convey the necessities. But integrating web service logics diagonally different organization leads to exponential problem which lay down developers to grasp the whole web service and must determine appropriate technique to integrate the web services; to merge them which are difficult and timeconsuming task. So the current attention is to have a automatic system to investigate the Business logics and deliver the suitable style to integrate them. There is no regular archetypal to carry out these concerns and so this paper proposed a framework which inspects the Business logics independently and recommends proper structure to merge them. One of the proposed advanced models is Policy Evaluation System which examines the service logics and discovers the policies while integrating professional policy assessment of the services and which also examines the Policy Detection Point (PDP) and Policy Enforcing Point (PEP) for more specifically deals with the policy. The proposed Integration model also uses ontology for domain specific knowledge regards policy, policy description and policy priority; this model integrates the required web services without break through Service Level Agreement (SLA).},
 author = {Tiroumalmouroughane, S. and Thambidurai, P.},
 doi = {10.1145/2980258.2980414},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 1},
