@inproceedings{11331624,
 abstract = {For natural language processing knowledge graph construction, Chinese dictionary entry-level hierarchical systems' dispersion and low coupling hinder downstream tasks. This paper proposes the TFC-TEGCN algorithm to fuse entry-level systems into a dictionary-level one. It introduces a “Golden Tree”, uses BERT and cosine similarity for textual similarity, multi-layer GCNs for local structure, an improved Transformer for global relations, and a DAG module for acyclic structure. Experiments on self-built and public datasets validate its effectiveness in solving data quality, entity linking, and global modeling issues, laying a foundation for graph fusion and cross-level relation completion.},
 author = {Zhou, Huanlai and Wang, Zihan and Li, Minyi and Jia, Haitao},
 booktitle = {2025 5th International Conference on Electronic Information Engineering and Computer Technology (EIECT)},
 doi = {10.1109/EIECT68017.2025.11331624},
 issn = {},
 keyword = {Knowledge engineering;Vocabulary;Visualization;Dictionaries;Trees (botanical);Merging;Knowledge graphs;Transformers;Natural language processing;Encoding;Transformer;Natural Language Possessing;Knowledge Graph;DAG;GCN},
 month = {Oct},
 number = {},
 pages = {684-688},
 title = {A Transformer-Based Fusion Algorithm for Constructing Conceptual Graphs},
 volume = {},
 year = {2025}
}
