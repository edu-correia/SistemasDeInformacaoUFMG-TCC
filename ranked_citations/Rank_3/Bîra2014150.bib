@article{Bîra2014150,
 abstract = {The MapReduce architecture and the associated programming model defined for the one-chip Connex organization gets an important additional feature: the associated data vectors can be organized as a two-dimension arrays of vertical and horizontal vectors which are managed by the transpose operation in order to maximize the degree of parallel execution. Thus, a one- chip Map-Reduce engine is able to perform easy additional intra vector operations by transforming the horizontal vectors, involved in Map operations, in vertical vectors using the transpose operation. We propose the Transpose- MapReduce high-level architecture supported by a fine grain cellular structure - the Connex system already implemented in silicon. It is structured in three sub- architectures: the data processing, data transfer and inter-cell communication architectures. A simulator written in SCHEME is used to write and evaluate few meaningful algorithms: AES encryption, FFT, Batcher's merge-sort.},
 author = {Bîra, Cəlin and Gug, Liviu and Maliţa, Mihaela and Ştefan, Gheorghe M.},
 journal = {Romanian Journal of Information Science and Technology},
 note = {Cited by: 0},
 number = {2},
 pages = {150 - 176},
 publication_stage = {Final},
 source = {Scopus},
 title = {Transpose-MapReduce applications on Connex architecture},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84923876202?origin=resultslist},
 volume = {17},
 year = {2014}
}
