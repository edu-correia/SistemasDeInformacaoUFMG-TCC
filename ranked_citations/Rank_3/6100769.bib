@inproceedings{6100769,
 abstract = {Current progressive coding methods of 3D model ignore the restoration of the sharp regions of the simplified model, which are very important in some specific areas such as medical stereo image processing, 3D film industry and digital certification. The paper proposes a novel progressive coding algorithm for 3D model. Based on the progressive transformation, the presented algorithm combines mesh segmentation and mesh coding for decoding the sharp regions early. Experimental results show that the proposed algorithm needs only a little simplified information to restore the sharp regions highly.},
 author = {Zhang, Qingchen and Tang, Yan},
 booktitle = {2011 4th International Congress on Image and Signal Processing},
 doi = {10.1109/CISP.2011.6100769},
 issn = {},
 keyword = {Solid modeling;Three dimensional displays;Computational modeling;Image restoration;Image coding;Decoding;Educational institutions;sharp region degree;3D model simplification;3D model coding;progressive transformatino},
 month = {Oct},
 number = {},
 pages = {2776-2778},
 title = {Progressive coding of 3D model based on sharp region degree},
 volume = {5},
 year = {2011}
}
