@article{SUN2024100990,
 abstract = {To achieve a healthcare patient monitoring system, this paper presents a clustering-based hierarchical approach. A group-based controlled structured routing architecture is used in the proposed method to group the various health monitoring sensors. A merged center will select a leader for each cluster and delegate the management responsibilities to that individual. Collecting information, organizing, and communicating with leading platforms are all the responsibilities of the cluster leader. The goal of this rotation is to keep the system under a constant load and to optimize the efficiency of the support equipment. A large number of simulations were used to validate our quantitative approach, and we compared our results with other methods already in use. Our study confirms that our approach not only reduces the energy required to maintain the network in various configurations, but also significantly increases their lifetime. The QoD of our proposed method was 4.9 %, compared with the QoD of 7.45 % and 9.82 % for DEEC and LEACH, respectively. Demonstrated that cluster-based hierarchical roads can enable a healthcare patient monitoring system.},
 author = {Jing Sun and Xitao Sun},
 doi = {https://doi.org/10.1016/j.measen.2023.100990},
 issn = {2665-9174},
 journal = {Measurement: Sensors},
 keyword = {Efficacy, Layered group routing, Clustering head, Green internet of things, And medical surveillance},
 pages = {100990},
 title = {Design a patient monitoring system in health care using cluster-based hierarchical routing for green communication},
 url = {https://www.sciencedirect.com/science/article/pii/S2665917423003264},
 volume = {31},
 year = {2024}
}
