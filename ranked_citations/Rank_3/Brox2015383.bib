@article{Brox2015383,
 abstract = {Interest in video segmentation has grown significantly in recent years, resulting in a large body of works along with advances in both methods and datasets. Progress in video segmentation would enable new approaches to building 3D object models from video, understanding dynamic scenes, robot-object interaction and several other high-level vision tasks. The workshop brought together a broad and representative group of video segmentation researchers working on a wide range of topics. This paper summarizes the panel discussion at the workshop, which focused on three questions: (1) Why does video segmentation currently not meet the performance of image segmentation and what difficulties prevent it from leveraging motion? (2) Is video segmentation a stand-alone problem or should it rather be addressed in combination with recognition and reconstruction? (3) Which are the right video segmentation subtasks the field should focus on, and how can we measure progress? © Springer International Publishing Switzerland 2015.},
 author = {Brox, Thomas and Galasso, Fabio and Li, Fuxin and Rehg, James Matthew and Schiele, Bernt},
 doi = {10.1007/978-3-319-16220-1_27},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {383 - 388},
 publication_stage = {Final},
 source = {Scopus},
 title = {First international workshop on video segmentation - panel discussion},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84925435387?origin=resultslist},
 volume = {8928},
 year = {2015}
}
