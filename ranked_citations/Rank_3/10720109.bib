@article{10720109,
 abstract = {The weaving area of expressways undertakes the task of vehicle diversion and merging, often causing congestion as a bottleneck in traffic. Thanks to the explosive evolution of 6G technology, the data transmission reliability and service quality of Internet of Vehicles (IoV) have been enhanced, making it possible for intelligent transportation systems to become more autonomous, intelligent, and efficient. Intelligent transportation systems are showing promise as a means to improve traffic efficiency and alleviate congestion issues. Due to different strategic purposes, exiting vehicles and merging vehicles weave, interlace, and frequently change lanes in the weaving area. Given this premise, we consider separating the tasks of vehicle diversion and merging in space and propose a distributed dynamic transferable utility game-based lane-changing strategy. We have designed a three-player game framework based on a five-step transferable utility model to assist exiting vehicles in fairly and efficiently completing lane changes in advance to avoid conflicts with merging vehicles in the weaving area. Simulation results indicate that the dynamic transferable utility game-based lane-changing strategy can accommodate higher lane change demands and generally benefit all participating vehicles in most scenarios. Furthermore, in mixed traffic flow scenarios of exiting and merging vehicles, this lane-changing strategy effectively enhances road capacity, reduces vehicle delay time, and improves network operational efficiency.},
 author = {Fu, Tingting and Wu, Xinglong and Hu, Hua},
 doi = {10.1109/JIOT.2024.3481317},
 issn = {2327-4662},
 journal = {IEEE Internet of Things Journal},
 keyword = {Merging;Games;Internet of Things;Weaving;Roads;Dynamic scheduling;Dedicated short range communication;Vehicle dynamics;Switches;Standards;Internet of Vehicles (IoV);lane change;transferable utility game;weaving areas},
 month = {March},
 number = {5},
 pages = {4681-4691},
 title = {Cooperative Control in Expressway Weaving Areas via Internet of Vehicles},
 volume = {12},
 year = {2025}
}
