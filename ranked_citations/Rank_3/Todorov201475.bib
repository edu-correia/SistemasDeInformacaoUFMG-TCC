@article{Todorov201475,
 abstract = {We propose an ontology alignment framework with two core features: the use of background knowledge and the ability to handle vagueness in the matching process and the resulting concept alignments. The procedure is based on the use of a generic reference vocabulary, which is used for fuzzifying the ontologies to be matched. The choice of this vocabulary is problem-dependent in general, although Wikipedia represents a general-purpose source of knowledge that can be used in many cases, and even allows cross language matchings. In the first step of our approach, each domain concept is represented as a fuzzy set of reference concepts. In the next step, the fuzzified domain concepts are matched to one another, resulting in fuzzy descriptions of the matches of the original concepts. Based on these concept matches, we propose an algorithm that produces a merged fuzzy ontology that captures what is common to the source ontologies. The paper describes experiments in the domain of multimedia by using ontologies containing tagged images, as well as an evaluation of the approach in an information retrieval setting. The undertaken fuzzy approach has been compared to a classical crisp alignment by the help of a ground truth that was created based on human judgment. © World Scientific Publishing Company.},
 author = {Todorov, Konstantin and Hudelot, Celine and Popescu, Adrian and Geibel, Peter},
 doi = {10.1142/S0218488514500044},
 journal = {International Journal of Uncertainty, Fuzziness and Knowldege-Based Systems},
 note = {Cited by: 22},
 number = {1},
 pages = {75 - 112},
 publication_stage = {Final},
 source = {Scopus},
 title = {Fuzzy ontology alignment using background knowledge},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84900618295?origin=resultslist},
 volume = {22},
 year = {2014}
}
