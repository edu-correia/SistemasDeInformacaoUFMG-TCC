@conference{Egert2007139,
 abstract = {2D-Nuclear magnetic resonance (NMR) spectroscopy is a powerful analytical method to elucidate the chemical structure of molecules. In contrast to ID-NMR spectra, 2D-NMR spectra correlate the chemical shifts of <sup>1</sup>H and <sup>13</sup>C simultaneously. To curate or merge large spectra libraries a robust (and fast) duplicate detection is needed. We propose a definition of duplicates with the desired robustness properties mandatory for 2D-NMR experiments. A major gain in runtime performance wrt. previously proposed heuristics is achieved by mapping the spectra to simple discrete objects. We propose several appropriate data transformations for this task. In order to compensate for slight variations of the mapped spectra, we use appropriate hashing functions according to the locality sensitive hashing scheme, and identify duplicates by hash-collisions. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Egert, Björn and Neumann, Steffen and Hinneburg, Alexander},
 doi = {10.1007/978-3-540-73255-6_13},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {139 - 155},
 publication_stage = {Final},
 source = {Scopus},
 title = {Fast approximate duplicate detection for 2D-NMR spectra},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/34547401476?origin=resultslist},
 volume = {4544 LNBI},
 year = {2007}
}
