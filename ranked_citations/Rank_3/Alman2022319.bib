@article{Alman2022319,
 abstract = {So far, business process monitoring approaches have mainly focused on monitoring executions with respect to a single process model. This setting aptly captures monolithic scenarios from domains in which all possible behaviors can be folded into a single model. However, this strategy cannot be applied to domains where multiple interacting (procedural) sub-processes work under additional (declarative) constraints. For example, in healthcare, co-morbid patients may be subject to multiple clinical pathways at once, in the presence of additional, general constraints capturing basic medical knowledge. To support monitoring of thus emerging hybrid specifications, we propose a Multi-Model Monitoring Framework. On the one hand, the framework allows for a hybrid representation of a process, using both procedural and declarative models. This admits more flexible process model design as domain experts can focus on specific procedures and domain constraints without needing to merge them into one single specification. On the other hand, the framework includes an automata-based monitoring technique to simultaneously account for multiple models within one execution while resolving conflicts caused by the interplay of such models. We describe the overall framework, report on a prototypical implementation of the monitoring technique, and demonstrate its feasibility with a healthcare scenario. © 2022, Springer Nature Switzerland AG.},
 author = {Alman, Anti and Maggi, Fabrizio Maria and Montali, Marco and Patrizi, Fabio and Rivkin, Andrey},
 doi = {10.1007/978-3-031-07472-1_19},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 7; All Open Access; Green Open Access},
 pages = {319 - 335},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi-model Monitoring Framework for Hybrid Process Specifications},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85132711337?origin=resultslist},
 volume = {13295 LNCS},
 year = {2022}
}
