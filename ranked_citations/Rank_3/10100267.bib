@inproceedings{10100267,
 abstract = {Image Security is playing a significant role in the field of communication system and Internet. Cryptography is initially developed to protect the interaction between two parties known as sender and receiver in the presence of malicious third parties called as attackers by using the process known as encryption. The given algorithm transforms the plain image into cipher image if the same key is used. The encryption is done by using various algorithm, transformation and many more techniques to secure the image. This article presents a novel image encryption technique. This AES algorithm is incredibly reliable and helps to maintain images safe from malicious attack. The sender has an image, and this image is split into several segments. After the encryption and decryption, the receiver merges those images. In the proposed system, keys will generate manually. This research paper presents an effective method for encrypting & decrypting data on the cloud. Through this method, users can store data securely in the cloud without being damaged or corrupted. This system has an idea about authentication. Receivers' digital signature is stored on the cloud to decrypt the image by generating digital signature that match with the stored one. If both signatures match, then it can be user verified and authenticated.},
 author = {Prajanati, Bhaumik and Gutte, Vitthal S. and Kolhe, Kishor},
 booktitle = {2023 International Conference on Innovative Data Communication Technologies and Application (ICIDCA)},
 doi = {10.1109/ICIDCA56705.2023.10100267},
 issn = {},
