@article{KANG2025159463,
 abstract = {Proton conducting solid oxide fuel cells (H+-SOFCs) are promising energy conversion and storage devices with outstanding advantages in converting a variety of clean energy fuels into electricity. The triple-conducting perovskite cathodes are responsible for oxygen reduction reaction (ORR), proton and electron transport in the cell, and thus play a crucial role in the performance of H+-SOFCs. In this study, we constructed the medium-entropy (Pr0.25La0.25Nd0.25Ca0.25)2NiO4+δ (PLNCN) and high-entropy (Pr0.2La0.2Nd0.2Sr0.2Ca0.2)2NiO4+δ (PLNSCN) layered Ruddlesden-Popper perovskite cathodes with a high degree of lattice distortion by merging multiple principal elements into a lattice at the A-site. The regulation of configuration entropy can produce significant local lattice distortion and dislocation. The local lattice distortion effect in high-entropy engineering induces more oxygen vacancies, which promotes the ORR activity, hydration reactivity capacity, and proton migration ability of RP perovskite Pr2NiO4+δ, thereby greatly improving the catalytic activity of the cathode. Meanwhile, we analyzed the formation sites of bulk phase oxygen vacancies in layered RP perovskite as much as possible through theoretical calculations, and anchored the most likely reactive site in the Ni-O-Ni layer in PLNSCN. At 700 °C, the polarization impedance (Rp) of the PLNSCN cathode (0.030 Ω cm2) was significantly lower than that of PNO (0.099 Ω cm2). Meanwhile, the peak power density of the single cell with high-entropy PLNSCN cathode was increased by 1.6 times to 1101.73 mW cm−2. This work provides a deeper comprehension of the composition-structure-performance optimization of high-entropy Ruddlesden-Popper perovskite triple-conducting cathodes.},
 author = {Kai Kang and Yihui Liu and Xu Liu and Chao Wang and Mingrui Wei},
 doi = {https://doi.org/10.1016/j.cej.2025.159463},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Proton conducting solid oxide fuel cells, Triple-conducting cathode, High-entropy, Lattice distortion, Oxygen vacancies, Layered Ruddlesden-Popper perovskite},
 pages = {159463},
 title = {Local lattice distortion regulation in high entropy engineering to enhance the triple conductivity of layered Ruddlesden-Popper perovskite cathode in H+-SOFCs},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894725002621},
 volume = {507},
 year = {2025}
}
