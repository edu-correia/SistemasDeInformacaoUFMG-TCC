@inproceedings{5358807,
 abstract = {Concept lattice is an effective formal tool for data analysis and knowledge extraction. Constrained concept lattice is a new concept lattice structure which uses predicate logic to describe the user's interesting background knowledge and merges the background knowledge into the process of concept lattice construction, so that the time and storage complexity of constructing concept lattice is reduced, and the utility and pertinence are improved for knowledge representation and knowledge extraction of concept lattice. In this paper, an algebra system of constrained concept lattice is constructed and its algebraic properties are presented. The completeness of knowledge representation of constrained concept lattice is proved, and hence the theoretical basis is provided for the application of constrained concept lattice.},
 author = {Jifu, Zhang and Sulan, Zhang and Yiyong, Jiang},
 booktitle = {2009 Sixth International Conference on Fuzzy Systems and Knowledge Discovery},
 doi = {10.1109/FSKD.2009.66},
 issn = {},
 keyword = {Algebra;Lattices;Knowledge representation;Data mining;Logic;Constraint theory;Data analysis;Clustering algorithms;Fuzzy systems;Educational institutions;data mining;background knowledge;constrained concept lattice;algebra system;algebraic properties},
 month = {Aug},
 number = {},
 pages = {168-172},
 title = {Algebra System of Constrained Concept Lattice and its Completeness of Knowledge Representation},
 volume = {2},
 year = {2009}
}
