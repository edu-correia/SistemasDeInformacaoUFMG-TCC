@inproceedings{10795277,
 abstract = {In the field of logistics and transportation, the problem of cargo palletizing is a key link, which directly affects the transportation efficiency and cost. In order to maximize the space utilization rate of palletizing, a hybrid genetic algorithm, which combines heuristic algorithm and GA, is proposed. On the basis of satisfying multiple constraints, the heuristic algorithm improves the space utilization by space segmentation and merging, and obtains the initial loading scheme by combining the complex block generation and other operations. In genetic algorithm, the initial population is generated by block coding. An elite retention strategy is used to introduce biased random keys for cross-operation to enhance the search efficiency of the algorithm. Finally, genetic algorithm combined with heuristic algorithm is used to find the optimal palletizing scheme. Multiple sets of simulation experiments were conducted based on BR classic cases, and the results showed that the hybrid genetic algorithm could improve the space utilization rate of the pallet more efficiently.},
 author = {Li, Xinke and Zhu, Xiaojing and Wang, Yuhuai},
 booktitle = {2024 3rd International Conference on Service Robotics (ICoSR)},
 doi = {10.1109/ICoSR63848.2024.00046},
 issn = {},
 keyword = {Costs;Service robots;Heuristic algorithms;Space debris;Loading;Merging;Transportation;Mathematical models;Pallets;Genetic algorithms;space utilization rate;stacking;heuristic algorithm;genetic algorithm},
 month = {July},
 number = {},
 pages = {183-188},
 title = {Research on Cargo Palletizing Problem Based on Hybrid Genetic Algorithm},
 volume = {},
 year = {2024}
}
