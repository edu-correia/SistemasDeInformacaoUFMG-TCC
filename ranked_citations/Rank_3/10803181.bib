@inproceedings{10803181,
 abstract = {This study discusses the state-of-the-art advancements in approaches and systems of biomedical sensing used to implement distant healthcare monitoring. The performance and accuracy of wearable and implantable sensors as well as their compatibility with mHealth Apps is assessed in the study. The study includes the processing of data collected through wearable devices, implantable sensors, and health applications to evaluate sensor reliability, data aggregation, and system efficiency. As the study has demonstrated, wearable sensors such as heart rate sensors and activity sensors, both have close to perfect accuracy of 95% and, 92% respectively. Other implantable sensors, namely the glucose and pressure sensors, exhibit high accuracy levels of 97% and 96%, respectively, and a minimal latency level. The use of mobile health applications captures the data from the sensors in a very integrated manner with accuracy levels of 92-94%. These interactive conclusions stress the opportunity bestowed by biomedical sensing technologies in advanced chronic disease, eldercare, and other healthcare system arrangements. These and other innovations in the sectors of sensors, data merging, and artificial intelligence will furthermore improve the potential of remote monitoring systems. This paper establishes a foundation for the continuous development of biomedical sensing technologies, as a key constituent of remote health monitoring systems.},
 author = {V, Anusharani and Krishnan, M Mudhu and Muthamizhan, T. and Aijaz, Mohammad and G, Guna.},
