@conference{Adjel2023102,
 abstract = {This article discusses the issues that come with system evolution, specifically the challenges of comprehending and maintaining old code created by unreachable developers. In this instance, we want to highlight the value of using code visualization to get a global perspective of the components and their dependencies, since this can assist in recognizing any possible structural problems. Additionally, visualization can shed light on the code's scalability and performance properties. A well-written program with clear syntax that respects low coupling and separation of concerns makes system maintenance and evolution easier, which saves time and money. Adopting a scalable and flexible language also makes maintenance and development smoother. In this paper, we made a visualization of Mage code in order to evaluate its syntax flexibility and scalability.  © 2023 IEEE.},
 author = {Adjel, Chaima and Atil, Fadila and Meslati, Djamel},
 doi = {10.1109/ICACTE59887.2023.10335229},
 journal = {16th International Conference on Advanced Computer Theory and Engineering, ICACTE 2023},
 note = {Cited by: 0},
 pages = {102 - 106},
 publication_stage = {Final},
 source = {Scopus},
 title = {Visualizing Code Syntax: Empowering Developers with a Global View for Enhanced Code Quality Evaluation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85181765229?origin=resultslist},
 year = {2023}
}
