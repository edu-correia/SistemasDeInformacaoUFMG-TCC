@conference{Varaee200779,
 abstract = {Nowadays, users of information systems require unlimited access to information through different sources without dealing with its many diverse aspects. Considering the fact that the "Data Integration System" is a global requirement, we focus mainly on data integration systems and provide different approaches to the end of solving integration problems as less attention have been paid to the issue of semantic integration. The present article introduces a new approach for ontologies automatic creating, merging and semantic integrations based on ontologies. In addition, syntactical and structural integrations have also been considered in our approach. Our approach also, unlike all traditional approaches, uses conceptual schemas to bring out better ontology's concepts. We utilize the data instances and a knowledge base to create these conceptual schemas. We have developed a software tool to support our theory and carried out subjective comparisons to prove the accuracy and efficiency of new proposed approach. Unlike all approaches and tools, we assume that the user of the system is not an ontology expert and that he wants to merge this ontology with the one developed by another user. The results clearly show further improvements and the accomplishment of the preset goals.},
 author = {Varaee, Touraj and Shenassa, Mohammad Hassan and Rahmani, Amir Masoud},
 journal = {International Conference on Enterprise Information Systems and Web Technologies 2007, EISWT 2007},
 note = {Cited by: 0},
 pages = {79 - 86},
 publication_stage = {Final},
 source = {Scopus},
 title = {A new automated approach for database semantic integration based on virtual view architecture and ontologies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84878155583?origin=resultslist},
 year = {2007}
}
