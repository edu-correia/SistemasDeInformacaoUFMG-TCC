@article{KHOT2026114737,
 abstract = {The merging of immersive technologies with real-time clinical data in healthcare 4.0 has significantly transformed patient monitoring and management in the metaverse. This study systematically reviewed the applications of metaverse technologies in healthcare. This study further advances the examination of the challenges of adopting metaverse-enabled healthcare systems using an Interval-Valued Pythagorean Fuzzy Decision-Making Trial and Evaluation Laboratory (IVPF-DEMATEL) framework. To evaluate the challenges, this study considered inputs based on evidence received from experts at a prominent healthcare institution in Western Maharashtra, India. A systematic literature review identified 12 critical challenges in the technical, regulatory, social, and economic domains. Expert-based IVPF-DEMATEL evaluations revealed that data security and privacy, infrastructure and interoperability, and regulatory compliance are the most prominent causative barriers. User experience, cultural acceptance, and sustainability concerns have emerged as downstream effects. The cause–and–effect analysis highlights the hierarchical structure of these barriers, demonstrating that addressing core technical and regulatory issues will generate positive ripple effects across user-centric and sociocultural dimensions. The findings provide actionable insights for policymakers, healthcare managers, and technology developers, underscoring the need for secure, interoperable, and ethically governed digital ecosystems to realize the metaverse’s transformative potential in healthcare. To enhance methodological robustness, inter-expert consistency analysis and sensitivity analysis using ±10 % variation in fuzzy membership bounds are conducted. The findings demonstrate that both the cause–and–effect classification and prominence rankings remain stable under moderate perturbations, confirming the reliability of the proposed framework. This study contributes to the growing body of Healthcare 4.0 research by offering empirical evidence from the Indian context and proposing strategic directions for the sustainable and equitable adoption of immersive patient care technologies.},
 author = {Sachin B. Khot and Shweta S. Patil and Yu-Chen Hu and Juber M. Mulla},
 doi = {https://doi.org/10.1016/j.asoc.2026.114737},
 issn = {1568-4946},
 journal = {Applied Soft Computing},
 keyword = {Metaverse in Healthcare, Healthcare 4.0, Patient Monitoring, Digital Twins, Immersive Technologies, Barriers to metaverse adoption, IVPF-DEMATEL},
 pages = {114737},
 title = {Exploring barriers to metaverse-enabled healthcare 4.0 patient monitoring using interval-valued pythagorean fuzzy DEMATEL},
 url = {https://www.sciencedirect.com/science/article/pii/S1568494626001857},
 volume = {192},
 year = {2026}
}
