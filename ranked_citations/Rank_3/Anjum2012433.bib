@article{Anjum2012433,
 abstract = {Ontologies are helpful in giving interoperable structures to sources of knowledge and information. This interoperability, however, is greatly hindered by the heterogeneity of independently developed ontologies which in turn increases the requirements for mediation systems to reconcile the differences. A core concepts ontology for a certain domain contained by a foundation ontology can be used to alleviate this problem and to facilitate the reconciliation efforts. Possible differences in the use of concepts from the core concepts to model entities in domain ontologies can be prevented by binding the domain ontology developers to some rules. These rules can be particularly useful for domain ontologies requiring some kind of traceability of their concepts in the foundation ontology. The mediation system can then use this traceability to establish similarities between two ontologies. Software applications, like the one explained in this paper, can then be developed to perform the mediation task automatically and accurately. © 2012 Elsevier B.V. All rights reserved.},
 author = {Anjum, Najam A. and Harding, J.A. and Young, R.I. and Case, K.},
 doi = {10.1016/j.compind.2012.01.009},
 journal = {Computers in Industry},
 note = {Cited by: 6; All Open Access; Green Open Access},
 number = {5},
 pages = {433 - 442},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mediation of foundation ontology based knowledge sources},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84861093522?origin=resultslist},
 volume = {63},
 year = {2012}
}
