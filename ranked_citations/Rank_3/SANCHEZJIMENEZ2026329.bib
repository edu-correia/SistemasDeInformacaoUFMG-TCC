@incollection{SANCHEZJIMENEZ2026329,
 abstract = {The increasing frequency and intensity of wildfires worldwide demand advanced technological solutions for early detection, rapid response, and postfire assessment. This chapter explores the integration of Earth observation satellites and aerial drones to enhance wildfire monitoring and emergency response. Satellite sensors, such as MODIS, VIIRS, and Sentinel-2, provide real-time thermal anomaly detection, enabling early hotspot identification and the assessment of burnt areas. Complementing these capabilities, aerial drones equipped with thermal and multispectral cameras offer high-resolution imagery, allowing for precise assessment of active fire fronts and postburn area mapping. The fusion of both approaches is implemented in the ‘WebGIS Hotspot’ platform, enabling historical and near realtime fire monitoring across Europe. The tool has been tested in various prescribed burns and used to retrospectively analyse the Navalacruz wildfire (Ávila, 2021). In addition, burned area estimates for 15 large wildfires in Spain (2024) were compared against official records to evaluate the platform’s performance. By providing an interactive and data-driven environment, the WebGIS platform enhances the accuracy and reliability of fire monitoring systems, facilitating better decision-making for authorities and researchers working in wildfire management.},
 author = {David Sánchez-Jiménez and Paula Andrés-Anaya and David Cifuentes and Juan Ramon Charco-Toboso and Diego Guerrero-Sevilla and Roy Yali-Samaniego and Susana Laguela and Diego González-Aguilera},
 booktitle = {Satellite Remote Sensing for Forest and Environmental Monitoring},
 doi = {https://doi.org/10.1016/B978-0-443-40296-8.00014-8},
 editor = {Pablo {Rodríguez Gonzálvez} and Juan Guerra-Hernández and Eduardo Manuel {González Ferreiro}},
 isbn = {978-0-443-40296-8},
 keyword = {Software development, Wildfire monitoring, Hotspot detection, Remote sensing, Geospatial analysis, Drones},
 pages = {329-360},
 publisher = {Elsevier},
 series = {Earth Observation},
 title = {Chapter 11 - Leveraging Earth observation satellites for emergency response: Hotspot detection, burned area tracking, and beyond},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443402968000148},
 year = {2026}
}
