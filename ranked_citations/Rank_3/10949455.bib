@inproceedings{10949455,
 abstract = {All smart cities need to integrate renewable energies if they want to grow steadily without any problems in the future. This study looks at the difficulties, plans, and tools that are used when these sources are merged into the smart city system. Through evaluating different research and advances in technology, the article shows us how smart cities could use RE effectively to achieve their sustainability objectives. Greater stress has been laid on smart grid, electricity storage facilities, and sophisticated stuff like IoT, blockchain, or AI for successful renewables connection in terms of efficiency and reliability.},
 author = {Shukla, Supriya H.},
 booktitle = {8th IET Smart Cities Symposium (SCS 2024)},
 doi = {10.1049/icp.2025.0939},
 issn = {},
 keyword = {},
