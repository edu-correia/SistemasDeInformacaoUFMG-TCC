@inproceedings{11156412,
 abstract = {This study examines the merging patterns of three level tones-T1 (44), T3 (55), and T4 (22)-in two Quanzhou Min dialect varieties: Licheng Min (LCM) and Qingyang Min (QYM). The results of production experiments show a faster T1-T 4 merger despite their relatively large acoustic distance. In LCM, tones converge mutually, while in QYM, T4 merges toward T1. Concurrently, T3's pitch height declines faster in LCM, suggesting a potential replacement of T1. Perceptual ability shows individual differences, with some participants displaying perception ambiguity and merger tendencies for certain tone pairs. Social factors like gender also affect perception accuracy. Both groups exhibit an asymmetry of “production merger with residual perception” for T1-T4 and T3-T4, though some show consistency. This coexistence highlights the need for individual-level phonological studies. By integrating internal and external factors, the study sheds light on synchronic tone variation dynamics in Chinese dialects.},
 author = {Wu, Yunfei and Li, Lishan and Xu, Xiaoying},
 booktitle = {2025 International Conference on Asian Language Processing (IALP)},
 doi = {10.1109/IALP68296.2024.11156412},
 issn = {2159-1970},
 keyword = {Accuracy;Corporate acquisitions;System dynamics;Merging;Production;Phonetics;Acoustics;Social factors;Convergence;tone merging;production and perception;Min Dialect;level tone;social-geographic structure},
 month = {Aug},
 number = {},
 pages = {182-187},
 title = {Level-Tone Merger in Production and Perception: Study in Two Chinese Min Dialects},
 volume = {},
