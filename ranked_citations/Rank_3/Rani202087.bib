@article{Rani202087,
 abstract = {The present study shows the scientometric analysis of the publications on the fuzzy logic controller in autonomous mobile robot navigation during the period 2000 to 2018. The data is collected using Web of Science core collection database and analyzed at various levels such as Web of Science categories, publication years, document types, funding agencies, authors, research areas, countries or region, control terms, and organization to evaluate the research patterns. An extensive study is done to find the research trends in this area. © 2020, Industrial Research Institute for Automation and Measurements. All rights reserved.},
 author = {Rani, Somiya and Jain, Amita and Castillo, Oscar},
 doi = {10.14313/JAMRIS/1-2020/11},
 journal = {Journal of Automation, Mobile Robotics and Intelligent Systems},
 note = {Cited by: 3; All Open Access; Gold Open Access},
 number = {1},
 pages = {87 - 108},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research trends on fuzzy logic controller for mobile robot navigation: A scientometric study},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85090742054?origin=resultslist},
 volume = {14},
 year = {2020}
