@inproceedings{4798673,
 abstract = {Relational Database schemas integration is important in various areas such as merging information systems of two or more companies, merging database systems of two or more departments of one company. This paper illustrates a relational database schema integration methods called ‘overlay and redundancy elimination methods’. There are many different methods in overlaying different relational database schemas and there are many different methods in eliminating redundancies in relational database schemas. This paper presents the particular methods on overlaying relational database schemas and eliminating redundancies in relational database schemas. These methods are novel and efficient in relational database schema integrations.},
 author = {Jae Jin Koh},
 booktitle = {2007 International Forum on Strategic Technology},
 doi = {10.1109/IFOST.2007.4798673},
 issn = {},
 keyword = {Relational databases;Merging;Information systems;Database systems;Containers;Data engineering;Information technology;relational database schemas integration;overlay methods;redundancies elimination methods;merging information systems;merging relational database systems},
 month = {Oct},
