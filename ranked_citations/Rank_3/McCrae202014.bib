@conference{McCrae202014,
 abstract = {The Princeton WordNet, while one of the most widely used resources for NLP, has not been updated for a long time, and as such a new project English WordNet has arisen to continue the development of the model under an open-source paradigm. In this paper, we detail the second release of this resource entitled "English WordNet 2020". The work has focused firstly, on the introduction of new synsets and senses and developing guidelines for this and secondly, on the integration of contributions from other projects. We present the changes in this edition, which total over 15,000 changes over the previous release.  © European Language Resources Association (ELRA), licensed under CC-BY-NC.},
 author = {McCrae, John P. and Rademaker, Alexandre and Rudnicka, Ewa and Bond, Francis},
 journal = {LREC 2020 - Workshop Language Resources and Evaluation Conference, Workshop on Multimodal Wordnets, MMWN 2020, Proceedings},
 note = {Cited by: 40},
 pages = {14 - 19},
 publication_stage = {Final},
 source = {Scopus},
 title = {English WordNet 2020: Improving and Extending a WordNet for English using an Open-Source Methodology},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105019304725?origin=resultslist},
 year = {2020}
}
