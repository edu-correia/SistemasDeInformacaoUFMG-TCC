 author = {Shen, Bingqing and Guo, Jingzhi},
 doi = {10.1145/3210438.3210439},
 journal = {Proceedings of the 10th ACM Workshop on Immersive Mixed and Virtual Environment Systems, MMVE 2018},
 note = {Cited by: 1},
 pages = {22 - 27},
