@inproceedings{11512888,
 abstract = {To address the challenges of limited samples and data imbalance in fault diagnosis of quadruped robot joint modules, this paper proposes a two-stage diagnostic framework. In the first stage, a Multi-Metric Quality-Driven Auxiliary Classifier Wasserstein Generative Adversarial Network with Gradient Penalty (MMQD-ACWGAN-GP) is developed to generate label-conditioned one-dimensional vibration signal samples, improving both diversity and training stability. In the second stage, a graph structure is constructed, where signal segments serve as nodes and temporal/similarity relationships as edges. A novel Chebyshev Attention Convolution (ChebyAttentionConv) operator is introduced, which incorporates learnable attention weights into Chebyshev spectral convolution to enable adaptive aggregation of high-order neighbor information. After filtering high-quality samples through multiple evaluation metrics, the generated data is merged with the original dataset and classified using an improved Graph Neural Network (GNN), significantly enhancing the model’s capability to recognize minority fault classes. Experimental results on a self-collected dataset show that the proposed method improves average diagnostic accuracy by 10.3% over traditional methods and standard GNN models, demonstrating its effectiveness for vibration-based small-sample fault diagnosis.},
 author = {Shi, Shenjun and Xiong, Xin and Fan, Beibei},
 booktitle = {2025 4th International Conference on Advanced Sensing, Intelligent Manufacturing (ASIM)},
 doi = {10.1109/ASIM67379.2025.11512888},
 issn = {},
 keyword = {Modeling;Training;Arrays;Labeling;Measurement;Generative adversarial networks;Equations;Limiting;Accuracy;Modules (abstract algebra);Small-sample learning;Vibration signal diagnosis;ACWGAN-GP;ChebyAttentionConv},
 month = {Oct},
 number = {},
 pages = {1-7},
 title = {Quality-Driven ACWGAN-GP for Small-Sample Fault Diagnosis in Quadruped Robot Joint Modules},
