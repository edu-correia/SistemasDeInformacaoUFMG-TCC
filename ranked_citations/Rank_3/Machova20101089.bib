@conference{Machova20101089,
 abstract = {The Elegant Mind research presented in this paper provides an interactive multilingual associative experiment as an attempt to map the Cognitive Semantic Spaces of Essential Self metaphor in Czech, Russian and English. This paper brings conceptually new empirically based scientific approach to a deeper understanding on the human mind cognition. We attempted to merge cognitive metaphor theory with psychoanalysis applying associative experiment methodology on the Essential Self metaphors. The goal of the research is to create an Essential Self multilingual 3D semantic network describing the core of the human nature and to build a multilingual WordNet, which serves as the basic lexical resource for Artificial Intelligence.},
 author = {Machova, Svetlana and Kratochvil, Petr and Kleckova, Jana},
 journal = {Annals of DAAAM and Proceedings of the International DAAAM Symposium},
 note = {Cited by: 6},
 pages = {1089 - 1090},
 publication_stage = {Final},
 source = {Scopus},
 title = {The elegant mind. A new insight to the deep semantic network},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84904430546?origin=resultslist},
 year = {2010}
}
