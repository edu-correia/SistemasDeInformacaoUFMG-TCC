@article{Su2004217,
 abstract = {In this paper, we present a heuristic mapping method and a prototype mapping system that support the process of semi-automatic ontology mapping for the purpose of improving semantic interoperability in heterogeneous systems. The approach is based on the idea of semantic enrichment, i.e. using instance information of the ontology to enrich the original ontology and calculate similarities between concepts in two ontologies. The functional settings for the mapping system are discussed and the evaluation of the prototype implementation of the approach is reported. © Springer-Verlag 2004.},
 author = {Su, Xiaomeng and Gulla, Jon Atle},
 doi = {10.1007/978-3-540-27779-8_19},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 37},
 pages = {217 - 228},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic enrichment for ontology mapping},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33845468124?origin=resultslist},
 volume = {3136},
 year = {2004}
}
