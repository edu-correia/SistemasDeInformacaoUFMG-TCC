@inproceedings{8974923,
 abstract = {For the resonant grounding system, the existing single criterion is less applicable, and the data fusion method based on intelligent algorithm will be restricted by the training sample, therefore, a intelligent fault line selection method based on S transform direction and energy is proposed in this paper. Firstly, with the powerful signal extraction ability of the S transform algorithm, the characteristic band signals are extracted from the zero sequence currents of all lines. Then the phase difference and energy parameters of each line are calculated. Finally, the parameters of the energy parameters are processed with the difference of the angle difference as the weight number, which achieves the purpose of merging two criteria, and enlarges the fault boundary, and the line with the most comprehensive parameters is the fault line. The simulation results show that the method has high margin and wide application scope, and is less affected by fault resistance, fault closing angle and fault location.},
 author = {Lei, HAN and Shi-han, LIU and Hao-Wei, CHEN and Tao, FANG and Qing, SHEN and Bao-peng, ZHU},
 booktitle = {2019 IEEE Sustainable Power and Energy Conference (iSPEC)},
 doi = {10.1109/iSPEC48194.2019.8974923},
 issn = {},
 keyword = {Training;Resistance;Grounding;Simulation;Merging;Data integration;Transforms;Distribution networks;Fault location;fault line selection;S transform;fusion;comprehensive parameters;distribution network},
 month = {Nov},
 number = {},
 pages = {465-468},
 title = {A New Method of Fault Line Selection for Resonant Grounding System Based on Improved S Transform Parameters},
 volume = {},
 year = {2019}
}
