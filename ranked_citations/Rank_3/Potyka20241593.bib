@conference{Potyka20241593,
 abstract = {Large-language models (LLMs) can support a wide range of applications like conversational agents, creative writing or general query answering. However, they are ill-suited for query answering in high-stake domains like medicine because they are typically not robust - even the same query can result in different answers when prompted multiple times. In order to improve the robustness of LLM queries, we propose using ranking queries repeatedly and to aggregate the queries using methods from social choice theory. We study ranking queries in diagnostic settings like medical and fault diagnosis and discuss how the Partial Borda Choice function from the literature can be applied to merge multiple query results. We discuss some additional interesting properties in our setting and evaluate the robustness of our approach empirically. © 2024 International Foundation for Autonomous Agents and Multiagent Systems.},
 author = {Potyka, Nico and Zhu, Yuqicheng and He, Yunjie and Kharlamov, Evgeny and Staab, Steffen},
 journal = {Proceedings of the International Joint Conference on Autonomous Agents and Multiagent Systems, AAMAS},
 note = {Cited by: 6},
 pages = {1593 - 1601},
 publication_stage = {Final},
 source = {Scopus},
 title = {Robust Knowledge Extraction from Large Language Models using Social Choice Theory},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85196357345?origin=resultslist},
 volume = {2024-May},
 year = {2024}
}
