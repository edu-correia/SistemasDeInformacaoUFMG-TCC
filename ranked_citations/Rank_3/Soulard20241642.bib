@conference{Soulard20241642,
 abstract = {Data linking in knowledge graphs is a crucial and long-standing problem; it involves finding identity links between different descriptions that refer to the same real-world entity. Keys, which are subsets of properties that identify each entity, are important elements in finding these identity links. The classical key-based approach of data linking is based on the discovery of a set of keys in each graph, and then apply a merge operation of these keys. But this approach can be very time consuming and can lead to very few keys that are valid in the two graphs. In this work, we study the issue of transferability of keys discovered in one graph to another graph, with the aim of reducing the computational complexity of the data linking task using keys. The experiments that we conducted on well known datasets (e.g., DBpedia, Wikidata and Yago) allowed to demonstrate the substantial reduction of key discovery runtime while preserving the data linking quality. © 2024 Copyright is held by the owner/author(s). Publication rights licensed to ACM.},
 author = {Soulard, Thibaut and Saïs, Fatiha and Raad, Joe and Quercini, Gianluca},
 doi = {10.1145/3605098.3636041},
 journal = {Proceedings of the ACM Symposium on Applied Computing},
 note = {Cited by: 0},
 pages = {1642 - 1649},
 publication_stage = {Final},
 source = {Scopus},
 title = {Efficient Key-based Data Linking Through Key Transfer Between Knowledge Graphs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85197697994?origin=resultslist},
 year = {2024}
}
