 keyword = {Governance, Quality healthcare, Mergers},
 number = {4},
 pages = {489-503},
 title = {Disruptive life event or reflexive instrument? On the regulation of hospital mergers from a quality of care perspective},
 url = {https://www.sciencedirect.com/science/article/pii/S1477726620000673},
 volume = {34},
