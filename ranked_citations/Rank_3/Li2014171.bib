@article{Li2014171,
 abstract = {Comic page segmentation aims to automatically decompose scanned comic images into storyboards (frames), which is the key technique to produce digital comic documents that are suitable for reading on mobile devices. In this paper, we propose a novel method for comic page segmentation by finding the quadrilateral enclosing box of each storyboard. We first acquire the edge image of the input comic image, and then extract line segments with a heuristic line segment detection algorithm. We perform line clustering to further merge the overlapped line segments and remove the redundancy line segments. Finally, we perform another round of line clustering and post-processing to compose the obtained line segments into complete quadrilateral enclosing boxes of the storyboards. The proposed method is tested on 2,237 comic images from 12 different printed comic series, and the experimental results demonstrate that our method is effective for comic image segmentation and outperforms the existing methods. © 2012 Springer Science+Business Media, LLC.},
 author = {Li, Luyuan and Wang, Yongtao and Tang, Zhi and Gao, Liangcai},
 doi = {10.1007/s11042-012-1241-7},
 journal = {Multimedia Tools and Applications},
 note = {Cited by: 26},
 number = {1},
 pages = {171 - 197},
 publication_stage = {Final},
 source = {Scopus},
 title = {Automatic comic page segmentation based on polygon detection},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84894627348?origin=resultslist},
 volume = {69},
 year = {2014}
}
