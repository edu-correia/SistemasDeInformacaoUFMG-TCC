@incollection{LAHKAR2026139,
 abstract = {The integration of machine learning (ML) and artificial intelligence (AI) has revolutionized neuropharmacological research, dramatically accelerating the drug discovery and development process. By leveraging advanced ML and deep learning (DL) techniques, researchers have significantly improved the design of drug delivery systems (DDS), optimized drug candidates, and identified therapeutic targets with greater precision. These technologies have also enabled the accurate prediction of drug efficacy and safety profiles, minimizing reliance on costly and time-consuming clinical trials. This study examines the transformative role of ML and AI in modern pharmacology, with a focus on how these technologies are reshaping traditional drug discovery and development processes. Key applications such as AI-driven virtual screening, chemical synthesis optimization, and biomarker identification are explored here, showcasing their profound impact on the field. However, the integration of these technologies is not without challenges, including issues of model bias, data limitations, and ethical considerations. To address these obstacles, the study proposes strategies aimed at enhancing the scalability, reliability, and robustness of AI-driven systems. By merging experimental validation with predictive computational modeling, this study outlines a comprehensive framework for a more efficient, cost-effective, and innovative paradigm in drug discovery and development.},
 author = {Rahul Lahkar and Amlan Jyoti Kalita and Priyakshi Kalita and Chayanika Devi and Pankaj Kalita},
 booktitle = {Artificial Intelligence in e-Health Framework, Volume 2},
 doi = {https://doi.org/10.1016/B978-0-443-14061-7.00007-5},
 editor = {Sudip Paul and Jasjit S. Suri},
 isbn = {978-0-443-14061-7},
 keyword = {Artificial intelligence, Deep learning, Drug discovery, Machine learning techniques, Neuropharmacology},
 pages = {139-156},
 publisher = {Academic Press},
 title = {Chapter 6 - Convergence of machine learning and artificial intelligence in pharmacological implications},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443140617000075},
 year = {2026}
}
