@inproceedings{4443927,
 abstract = {This paper presents a σ-δ modulation ADC (analog-to-digital converter) and DAC (digital-to-analog converter) for CODEC applications using 0.18 μm CMOS process. In the ADC parts, two σ-δ modulators with 84 dB SNR are designed for the stereo applications, and their outputs are merged at the digital domain before decimation filter. Digital decimation filter is integrated with the analog σ-δ modulators for the full ADC operation. In the DAC parts, the digital data is first processed at the interpolator filters, and modulated by the following σ-δ modulators. To reduce the mismatch effect of the following DAC, the dynamic element matching method is proposed in this paper. It is designed with 0.18 μm CMOS process. The simulated SNR is about 100 dB. and the power consumption is 40 mA.},
 author = {Ko, Dong-Hyun and Jung, Ji-Hoon and Pu, Young-Gun and Nam, Chul and Lee, Kang-Yoon},
 booktitle = {2007 IEEE International Workshop on Radio-Frequency Integration Technology},
 doi = {10.1109/RFIT.2007.4443927},
 issn = {},
 keyword = {Codecs;CMOS process;Delta-sigma modulation;Digital modulation;Digital filters;Noise shaping;Switches;CMOS technology;Circuits;Sampling methods;ADC(Analog-to-Digital Converter);DAC(Digital-to-Analog Converter);Σ-Δ Modulator},
 month = {Dec},
 number = {},
 pages = {86-89},
 title = {A design of 14-bits ΣΔ ADC and DAC for CODEC applications in 0.18 μm CMOS process},
 volume = {},
 year = {2007}
}
