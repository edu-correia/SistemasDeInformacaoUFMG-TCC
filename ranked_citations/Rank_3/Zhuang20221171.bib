@conference{Zhuang20221171,
 abstract = {Community detection is of great significance to complex network. In response to community detection in complex network which has unknown number of communities, this paper proposed a new community detection approach with integration based on Beetle Swarm Optimization (BSO) and been named BSOI (Beetle Swarm Optimization with Integration). In the initialization of community division, community flag adapting node is adopted, which means the community flag of every node is initialized by its neighbor node. BSO is applied to optimize the community division. Then, we merge communities by the maximum module density increment. Experiments show that it can get a stable and effective result of community division quickly on both artificial and real-world social networks.  © 2022 IEEE.},
 author = {Zhuang, Li and Yu, Lin and Zhang, Jie},
 doi = {10.1109/IAEAC54830.2022.9929691},
 journal = {IEEE Advanced Information Technology, Electronic and Automation Control Conference (IAEAC)},
 note = {Cited by: 0},
 pages = {1171 - 1176},
 publication_stage = {Final},
 source = {Scopus},
 title = {Community detection based on Beetle Swarm Optimization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85142275650?origin=resultslist},
 volume = {2022-October},
 year = {2022}
}
