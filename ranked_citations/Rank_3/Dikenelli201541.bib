@article{Dikenelli201541,
 abstract = {Semantic Web Agents have been considered as main type of software to consume the semantic data since the Semantic Web concept was raised first time in the well-known “The Semantic Web” article in 2001. More than a decade passed and there is no collaboration between multi-agent systems and semantic web (or its current realization: linked data web) communities that can be considered important. In this paper, it is argued that initial vision was right and two communities need each other to scale up their current practice. Thus, a conceptual framework is proposed to establish necessary links between agent and linked data web infrastructures. Environment abstraction has a special role in this framework and this role is especially discussed throughout the paper. © Springer International Publishing Switzerland 2015.},
 author = {Dikenelli, Oğuz and Alatlı, Oylum and Erdur, Rıza Cenk},
 doi = {10.1007/978-3-319-23850-0_3},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 4},
 pages = {41 - 51},
 publication_stage = {Final},
 source = {Scopus},
 title = {Where are all the semantic web agents: Establishing links between agent and linked data web through environment abstraction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84952664163?origin=resultslist},
 volume = {9068},
 year = {2015}
}
