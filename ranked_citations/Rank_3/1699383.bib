@inproceedings{1699383,
 abstract = {Although detecting text lines in machine printed documents is typically considered a solved problem, it is still a challenge to segment handwritten text lines in the general sense given no prior knowledge of script. This paper models text line detection as an image segmentation problem by enhancing text line structures using a Gaussian window and adopting the level set method to evolve text line boundaries. Experiments show that the method, which is script independent, achieves high accuracy for detecting text lines in heterogeneous handwritten documents.},
 author = {Yi Li and Yefeng Zheng and Doermann, D.},
 booktitle = {18th International Conference on Pattern Recognition (ICPR'06)},
 doi = {10.1109/ICPR.2006.435},
 issn = {1051-4651},
 keyword = {Image segmentation;Text analysis;Image analysis;Laboratories;Educational institutions;Level set;Character recognition;Contracts;Noise level;Merging},
 month = {Aug},
 number = {},
 pages = {1030-1033},
 title = {Detecting Text Lines in Handwritten Documents},
 volume = {2},
 year = {2006}
}
