@article{AQUINO2024S129,
 abstract = {Purpose
Evidence has shown vaginal brachytherapy (VBT) treatments for gynecologic cancers can adversely impact quality of life (QoL) and psychosocial functioning for survivors, including reports of post-traumatic stress disorder after treatment. Great disparities exist between male and female sexual function assessment in radiation oncology, prompting increased attention to address the impact of VBT on female sexual function.The oncology nurse plays a crucial role in assessing underlying distress/anxiety, psychosocial issues, and sexual function before, during and after the course of radiation therapy.
Materials and Methods
The methods were broken up into different phases of implementation: Phase 1 (2017-2019) A multidisciplinary team was established to customize an assessment tool to screen for “at risk” patients Reviewed literature and selected appropriate questions to assess sexual function relevant to brachytherapy population Included novel screening questions related to past sexual trauma Piloted our questionnaire merging questions taken from 3 validated assessment tools in the clinic setting using printed questionnaires Phase 2 (2019-2020) Created an Epic Flowsheet of the questionnaire Give patients access to the questionnaire on MyChart Phase 3 (2020-2022) Optimized the language to be more inclusive of the LGBTQ community Phase 4 (2022-ongoing) Translated the questionnaire into Spanish, Russian, and Chinese Created a Smart Phrase tool to pull in data from the flowsheet to the provider's notes. Integrating the utilization of the Welcome mobile app on department iPads for those who do not use MyChart or have a smartphone Finalizing implementation in clinic
Results
This is an ongoing department project to evaluate whether early detection and intervention will improve patient's QoL and prevent long term trauma after VBT. Given the diverse patient population we treat, translation of the questionnaire into native languages is still needed in EPIC. This is will standardize the discussion of sexual health and function of patients undergoing all treatments for gynecologic cancers.
Conclusions
The use of a patient reported assessment tool allows patients to answer difficult and sensitive questions, including past sexual activity and history of pain with intercourse, facilitating a discussion with the care team. The inclusion of sexual trauma questions can identify at risk patients and provide the appropriate supportive services and improve treatment compliance.},
 author = {Samantha Aquino and Stella Lymberis and Adelina Cabrera and Mary Grace Corpus and Lynette Romero and Jason Domogauer},
 doi = {https://doi.org/10.1016/j.brachy.2024.08.206},
 issn = {1538-4721},
 journal = {Brachytherapy},
 number = {6, Supplement },
 pages = {S129-S130},
 title = {PO0319: Utilizing a Novel Patient Reported Questionnaire Tablet to Assess Female Sexual Function and Psychological Distress Related to Vaginal Brachytherapy},
 url = {https://www.sciencedirect.com/science/article/pii/S1538472124003428},
 volume = {23},
 year = {2024}
}
