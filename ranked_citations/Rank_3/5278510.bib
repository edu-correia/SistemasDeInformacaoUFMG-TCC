@inproceedings{5278510,
 abstract = {This paper examines the exact solution for combining multiple Gaussian mixture (GM) estimates of a state vector, methods for order-reduction of the resulting GM, estimating the likelihood of each source GM, and for classifying sources as good (in agreement) or bad (biased or false/spoofed). Together, these allow combining estimates from GM sources in a way that guarantees some false-rejection probability of good sources in the merged best-estimate and allows generating a set of ellipsoids to approximate the most-probable volume for displaying the result to a user.},
 author = {Sipos, Brian J.},
 booktitle = {2009 IEEE/SP 15th Workshop on Statistical Signal Processing},
 doi = {10.1109/SSP.2009.5278510},
 issn = {2373-0803},
 keyword = {Gaussian distribution;State estimation;Ellipsoids;State-space methods;Filling;Visualization;Random variables;Kalman filters;Gain measurement;Gaussian approximation;State space;Gaussian mixture;spoofing;water filling;visualization},
 month = {Aug},
 number = {},
 pages = {581-585},
 title = {Combining Gaussian mixture estimates from uncertain sources},
 volume = {},
 year = {2009}
}
