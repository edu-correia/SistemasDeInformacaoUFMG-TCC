@article{10.1145/3282844,
 abstract = {Game-based learning has received significant attention in educational pedagogy as an effective way of increasing student motivation and engagement. The majority of the work in this area has been focused on digital games or games involving technology. We focus on the use of traditional game design in improving student engagement and perception of learning in teaching computer science concepts in higher education. In addition, as part of an interdisciplinary effort, we discuss the interplay between game-based learning in higher education and disciplinary cultures, addressing the lack of empirical evidence on the impact of game design on learning outcomes, engagement, and students’ perception of learning.},
 address = {New York, NY, USA},
 articleno = {22},
 author = {Hosseini, Hadi and Hartt, Maxwell and Mostafapour, Mehrnaz},
 doi = {10.1145/3282844},
 issue_date = {September 2019},
 journal = {ACM Trans. Comput. Educ.},
 keyword = {Game-based learning, computer science, disciplinary culture, higher education, student perception, team work},
 month = {January},
 number = {3},
 numpages = {18},
 publisher = {Association for Computing Machinery},
 title = {Learning IS Child’s Play: Game-Based Learning in Computer Science Education},
 url = {https://doi.org/10.1145/3282844},
 volume = {19},
 year = {2019}
}
