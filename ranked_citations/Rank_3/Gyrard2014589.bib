@conference{Gyrard2014589,
 abstract = {Domain-specific Internet of Things (IoT) applications are becoming more and more popular. Each of these applications uses their own technologies and terms to describe sensors and their measurements. This is a difficult task to help users build generic IoT applications to combine several domains. To explicitly describe sensor measurements in uniform way, we propose to enrich them with semantic web technologies. Domain knowledge is already defined in more than 200 ontology and sensor-based projects that we could reuse to build cross-domain IoT applications. There is a huge gap to reason on sensor measurements without a common nomenclature and best practices to ease the automation of generic IoT applications. We present our Machine-to-Machine Measurement (M3) framework and share lessons learned to improve existing standards such as oneM2M, ETSI M2M, W3C Web of Things and W3C Semantic Sensor Network. © 2014 IEEE.},
 author = {Gyrard, Amelie and Datta, Soumya Kanti and Bonnet, Christian and Boudaoud, Karima},
 doi = {10.1109/GLOCOMW.2014.7063496},
 journal = {2014 IEEE Globecom Workshops, GC Wkshps 2014},
 note = {Cited by: 46},
 pages = {589 - 594},
 publication_stage = {Final},
 source = {Scopus},
 title = {Standardizing generic cross-domain applications in Internet of Things},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84946692534?origin=resultslist},
 year = {2014}
}
