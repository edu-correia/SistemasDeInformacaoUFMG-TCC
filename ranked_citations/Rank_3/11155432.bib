@inproceedings{11155432,
 abstract = {This study explores how ontologies are developed and applied for knowledge representation across diverse domains. It analyses methodologies, tools, and evaluation techniques used in ontology construction, highlighting trends, best practices, and common challenges. Ontologies play a crucial role in enabling the semantic web, which is designed to be understood and interpreted by machines. They offer a structured data modeling framework, organizing and linking concepts through semantic relationships within defined domain boundaries. While various methods exist to support ontology creation, however there is no universally accepted standard for ontology design currently. Thus, this paper aims to survey the state-of-the-art review in exploring ontology development techniques across different domains. This study reviewed recently published articles from popular research search engines. The evaluation examined how different approaches are used for the base creation of ontologies as well as the re-use of existing ones. In addition, this study looked at the use of ontology languages and editors. This study reported that many of the methods present do include what is seen as important elements of ontology and software engineering, but also bring to the fore some of the issues related to the methodology of ontology development, which is put forward for knowledge representation.},
 author = {Bamigboye, Oluwatosin and Padayachee, Indira and Subramaniam, Prabhakar Rontala},
 booktitle = {2025 Conference on Information Communications Technology and Society (ICTAS)},
