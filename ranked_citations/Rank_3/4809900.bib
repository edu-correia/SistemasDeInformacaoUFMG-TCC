 issn = {1738-9445},
 keyword = {Flash memory;Yarn;Mobile computing;Personal communication networks;Parallel processing;System performance;Solid state circuits;Hard disks;Energy consumption;Electric shock;Serial-ATA;SSD;FTL;Multi-Thread},
 month = {Feb},
