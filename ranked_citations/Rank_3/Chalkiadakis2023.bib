@conference{Chalkiadakis2023,
 abstract = {Operational performance is of importance because it allows for quantifying the behavior of transportation networks under disturbances, such as Extreme Weather Events. To enhance the transportation networks efficiency, proper Traffic Management Strategies should be introduced to ensure the smooth operation of the road network. Cooperative Intelligent Transportation Systems (c-ITS) can assist in the effective application of such strategies. In the present research, we study the impact of c-ITS strategies towards mitigating the impacts of Extreme Weather Events in the case of two urban transportation networks. Their performance under the effect of Extreme Weather Events is investigated and Cooperative Awareness Message and In-Vehicle Information c-ITS services are implemented. Findings show that the implementation of c- ITS services coupled with other Traffic Management Strategies leads to a more efficient management of the transportation network by improving its operational performance. © 2023 IEEE.},
 author = {Chalkiadakis, Charis and Kanavou, Maria and Vlahogianni, Eleni},
 doi = {10.1109/MT-ITS56129.2023.10241704},
 journal = {2023 8th International Conference on Models and Technologies for Intelligent Transportation Systems, MT-ITS 2023},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Investigating the Importance of Connected Cooperative and Automated Mobility Towards Mitigating the Impacts of Extreme Weather Events},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85175403977?origin=resultslist},
 year = {2023}
}
