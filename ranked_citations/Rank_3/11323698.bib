@inproceedings{11323698,
 abstract = {Legal awareness in India continues to face significant challenges due to complex legal terminology, limited access, and high consultation costs. To overcome these barriers, this study presents a Digital Legal Assistant-a bilingual (Hindi-English) AI-based chatbot designed to enhance legal literacy and accessibility. The system integrates the Google Gemini API for natural language generation with a structured JSON-based legal knowledge base, ensuring factual accuracy and contextual relevance. Developed using Django, HTML, CSS, and JavaScript, the assistant offers a secure and userfriendly interface supporting both text and voice interaction. It provides accurate and accessible information related to women's rights, child protection, and senior citizen welfare, thereby democratizing legal access across linguistic and social boundaries. Unlike traditional rule-based or purely generative systems, this hybrid model merges verified legal templates with AI-driven conversational reasoning to minimize misinformation. Testing demonstrated high reliability in bilingual query handling, authentication, and response accuracy. Beyond its technical innovation, the system holds strong socio-legal impact by contributing to the Digital India initiative and promoting legal empowerment for citizens with limited legal literacy. This work highlights how combining large language models with structured legal data can create a costeffective, adaptable, and trustworthy framework for public legal education.},
 author = {Mishra, Jahanvi and Singh, Sweta and Daftary, Devshrut and Bhawsar, Lakshya and Khatri, Sushma and Chourasiya, Leeladhar and Sethi, Kamal K and Bhatt, Ritika and Goyal, Ayurvi},
 booktitle = {2025 IEEE 5th International Conference on ICT in Business Industry & Government (ICTBIG)},
 doi = {10.1109/ICTBIG68706.2025.11323698},
 issn = {},
 keyword = {Technological innovation;Sentiment analysis;Accuracy;Law;Databases;Terminology;Education;Multilingual;Protection;Testing},
 month = {Dec},
 number = {},
 pages = {1-7},
 title = {Bridging Legal Gaps with a Bilingual AI Legal Assistant},
 volume = {},
