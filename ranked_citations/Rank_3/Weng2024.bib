@article{Weng2024,
 abstract = {Online and online-merge-offline learning are promoting the sharing of teaching resources and the transformation of teaching and learning methods during the global epidemic. However, uneven learning resources, subject-based classification, and incomplete result-based evaluation always make it hard for students to keep pace with the ideal teaching objectives. Based on the theory of cognitive style and teaching style, the LPSA video classification consisting of linguistic type (L), presentative type (P), scientific type (S), and artistic type (A), is proposed to realize teaching quality evaluation and learning process detection. In addition, eight subdimensions of LPSA and its quantitative methods utilizing multimedia processing and AI algorithm are introduced to realize video classification. By automatically generating the threshold map and developing related real-time video evaluating tools, the technical and applied feasibility of the proposed LPSA is certified, which could also facilitate student's personal learning and accurate teaching evaluation. © 2023 Wiley Periodicals LLC.},
 author = {Weng, Jinta and Hu, Yue and Huang, Heyan},
 doi = {10.1002/cae.22662},
 journal = {Computer Applications in Engineering Education},
 note = {Cited by: 8},
 number = {1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {LPSA: Online educational video evaluation considering cognitive and teaching style},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85165444249?origin=resultslist},
 volume = {32},
 year = {2024}
}
