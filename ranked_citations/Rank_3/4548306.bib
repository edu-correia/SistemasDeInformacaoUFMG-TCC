@inproceedings{4548306,
 abstract = {In order to increase the efficiency of routing and querying, decrease the maintenance cost of structure P2P network, a hierarchical small-world P2P networks (HSN) with low maintenance cost is proposed in this paper, which describe the methods about how to create and maintenance a P2P network. To demonstrate the value of HSN, this paper simulates Chord and HSN with different networks size and system parameters, and the result shows that (1) the route latency of HSN is smaller than O(logN) , where is the number of nodes in the P2P networks, (2) HSN maintenance cost decreased nearly the half of the Chord.},
 author = {Guisheng, Yin and Jie, Shen and Xianghui, Wang},
 booktitle = {2008 International Conference on Internet Computing in Science and Engineering},
 doi = {10.1109/ICICSE.2008.94},
 issn = {2330-9857},
 keyword = {Peer to peer computing;Routing;Costs;Computer science;IP networks;Computer networks;Educational institutions;Delay;Corporate acquisitions;Physics;Small-world;Maintenance cost;P2P;DHT},
 month = {Jan},
 number = {},
 pages = {452-458},
 title = {Hierarchical Small-World P2P Networks},
 volume = {},
 year = {2008}
}
