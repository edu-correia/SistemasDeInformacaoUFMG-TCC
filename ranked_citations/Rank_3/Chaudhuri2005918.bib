@conference{Chaudhuri2005918,
 abstract = {When collecting and combining data from various sources into a data warehouse, ensuring high data quality and consistency becomes a significant, often expensive, challenge. Common data quality problems include inconsistent data conventions amongst sources such as different abbreviations or synonyms; data entry errors such as spelling mistakes; missing, incomplete, outdated or otherwise incorrect attribute values. These data defects generally manifest themselves as foreign-key mismatches and approximately duplicate records, both of which make further data mining and decision support analyses either impossible or suspect. We demonstrate two new data cleansing operators, Fuzzy Lookup and Fuzzy Grouping, which address these problems in a scalable and domain-independent manner. These operators are implemented within Microsoft SQL Server 2005 Integration Services. Our demo will explain their functionality and highlight multiple real-world scenarios in which they can be used to achieve high data quality. Copyright 2005 ACM.},
 author = {Chaudhuri, Surajit and Ganjam, Kris and Ganti, Venky and Kapoor, Rahul and Narasayya, Vivek and Vassilakis, Theo},
 doi = {10.1145/1066157.1066287},
 journal = {Proceedings of the ACM SIGMOD International Conference on Management of Data},
 note = {Cited by: 24},
 pages = {918 - 920},
 publication_stage = {Final},
 source = {Scopus},
 title = {Data cleaning in Microsoft SQL Server 2005},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/29844447256?origin=resultslist},
 year = {2005}
}
