@inproceedings{6682112,
 abstract = {Current developments in wireless sensors, computer network and manufacture information technology have vastly advanced the manufacturing shop's intelligent level. This paper presents a new project that merges Personal Digital Assistant (PDA) into manufacturing shop and proposes Workshop Internet of Things (WIoT) to improve the production information flow capacity. There are several use cases including auto-dispatch and remote terminal synchronization by constructing mobile Enterprise Resource Planning (ERP) system to verify the effect. This system is implemented combined with an aircraft structure part enterprise's Manufacturing Execution System (MES) and received good feedback.},
 author = {Zhiliang, Fang and Xin, Wang and Guangrong, Yan and Tao, Ding},
 booktitle = {2013 IEEE International Conference on Green Computing and Communications and IEEE Internet of Things and IEEE Cyber, Physical and Social Computing},
 doi = {10.1109/GreenCom-iThings-CPSCom.2013.98},
 issn = {},
 keyword = {Manufacturing;Personal digital assistants;Synchronization;Mobile communication;Conferences;Computer numerical control;Sockets;WIoT;PDA;mobile ERP;MES;auto-dispatch;synchronization},
 month = {Aug},
 number = {},
 pages = {489-495},
 title = {PDA-Based Application and Research for Workshop Internet of Things},
 volume = {},
 year = {2013}
}
