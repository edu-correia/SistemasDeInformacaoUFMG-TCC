@conference{Chen20021615,
 abstract = {Traditional remote sensing image fusion is based on spectral space. When adding texture information of a high-resolution image to a low-resolution image, the original spectral information of low-resolution image would be distorted more or less. In this paper, a schema to set up a linear relationship between a low-resolution image and a high-resolution image in a different feature space was explored. And then, a look up table based on that relationship was applied to unmix mixture pixels in the low-resolution image respectively. An example was illustrated of unmixing and fusion of the multispectral reflective bands and panchromatic band of a Landsat ETM+ image in Shunyi district, Beijing and obtained a satisfactory fusion result. © 2002 IEEE.},
 author = {Chen, Xue and Liu, Suhong and Zhu, Qijiang and Li, Xiaowen and Wang, Peijuan and Li, JiangTao},
 doi = {10.1109/ICCCAS.2002.1179086},
 journal = {2002 International Conference on Communications, Circuits and Systems and West Sino Exposition, ICCCAS 2002 - Proceedings},
 note = {Cited by: 0},
 pages = {1615 - 1619},
 publication_stage = {Final},
 source = {Scopus},
 title = {Linear mixture model-based image fusion},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84976260281?origin=resultslist},
 volume = {2},
 year = {2002}
}
