@article{11007583,
 abstract = {Human-Object Interaction (HOI) detection is critical for advancing machine understanding of complex visual environments involving human activities and their interactions with objects. Existing Transformer-based approaches have achieved significant progress but often fall short in fully leveraging prior knowledge and semantic context. To address these challenges, we propose language-aware context learning with multi-cue Transformers (LactFormer), a novel two-stage framework that enhances HOI detection by integrating multi-granularity cues from both visual and linguistic domains. LactFormer comprises three key components: the Language-aware Context Learning Module (LCLM), Vision-based Interactive Query Generation (VIQG), and the Language-aware Interaction Embedding Module (LIEM). The LCLM encodes positional language descriptions and merges them with visual context via a Transformer Encoder, forming a rich, language-aware context. This language-aware context provides a robust foundation for the queries obtained by VIQG, which are then processed by the Transformer Decoder in LIEM to generate effective interaction embeddings for human-object pairs. LactFormer overcomes the limitations of previous Transformer-based models by leveraging a comprehensive understanding of both visual and linguistic information. Extensive experiments demonstrate that LactFormer significantly improves interaction recognition accuracy, achieving state-of-the-art performance.},
 author = {Peng, Weilong and Chen, Qingfeng and Tang, Keke and Yu, Zhaoyang and Wang, Yangtao and Xie, Yanzhao and Fang, Meie},
 doi = {10.1109/TCE.2025.3571778},
 issn = {1558-4127},
 journal = {IEEE Transactions on Consumer Electronics},
 keyword = {Transformers;Feature extraction;Visualization;Decoding;Three-dimensional displays;Semantics;Training;Accuracy;Linguistics;Detectors;Human-object interaction detection;Transformer;multi-granularity clues;language-aware context learning},
 month = {May},
 number = {2},
 pages = {3617-3630},
 title = {LactFormer: Language-Aware Context Learning With Multi-Cue Transformers for HOI Detection},
 volume = {71},
 year = {2025}
}
