@inproceedings{4152853,
 abstract = {Development of modern technology leads today to delegation of intelligence to machines requiring more autonomy for exploiting their full potential. Following the line traced by nature for living creatures, this transfer implies a change from regular trajectory space to task space control in parallel to a reassessment of system into a complex stage imposed by the high level of interactions between large number of system components. Aspects of this situation with coordinated action on both power and information fluxes are handled in a new and explicit control structure},
 author = {Cotsaftis, Michel},
