@conference{Stepien2021146,
 abstract = {In mechanized tunnelling projects, finding a low-risk and cost-effective alignment is an important task. Several alignment variants are usually created and intensively evaluated. Variants often have different advantages and disadvantages and can lead to different constructive designs of the tunnel. To compare variants systematically, ontology databases can be utilized to merge BIM and GIS at data level to create an integrated model of the entire tunnelling project. Relevant information for decision-making can then be inferred. On the one hand, the implementation of queries is a popular and frequently used approach to check for semantic properties. On the other hand, using a query language to derive information from geometric data can be challenging, due to the necessity of processing geometric data prior to and during query execution. For this purpose, information from different sources must be linked and evaluated in a structured way. In particular, spatial relationships are investigated and implemented by adopting GeoSPARQL methods. © 2021 Universitätsverlag der Technischen Universität Berlin. All Rights Reserved.},
 author = {Stepien, Marcel and Vonthron, Andre and König, Markus},
 journal = {EG-ICE 2021 Workshop on Intelligent Computing in Engineering, Proceedings},
 note = {Cited by: 2},
 pages = {146 - 155},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Approach for Cross-Data Querying and Spatial Reasoning of Tunnel Alignments},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85124413288?origin=resultslist},
 year = {2021}
}
