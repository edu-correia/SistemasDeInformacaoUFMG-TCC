@inproceedings{4313296,
 abstract = {Radio spectrum is a scarce resource in wireless communications. This has led to extensive research in radio resource management (RRM) with the objective of improving achievable system capacity and supporting the rapid growth of a wide variety of data services with different quality of service (QoS) requirements. In this paper, we quantify the considerable performance gains obtainable with multi-flow merging (MFM) in scheduling for flow-based wireless networks in terms of user throughput, user latency and user packet drop probability.},
 author = {Huang, Chi En and Leung, Cyril},
 booktitle = {2007 IEEE Pacific Rim Conference on Communications, Computers and Signal Processing},
 doi = {10.1109/PACRIM.2007.4313296},
 issn = {2154-5952},
 keyword = {Merging;Wireless networks;Quality of service;Traffic control;Job shop scheduling;Throughput;Delay;Scheduling algorithm;Magnetic force microscopy;Telecommunication traffic},
 month = {Aug},
 number = {},
 pages = {553-556},
 title = {Multi-Flow Merging Gain in Scheduling for Flow-Based Wireless Networks},
 volume = {},
 year = {2007}
}
