@conference{Nath2013,
 abstract = {In this paper, we present a first general purpose GPU thermal management design that consists of both hardware architecture and OS scheduler changes. Our techniques schedule thread blocks from multiple computational kernels in spatial, temporal, and spatio-temporal ways depending on the thermal state of the system. We can reduce the computation slowdown by 60% on average relative to the state of the art techniques while meeting the thermal constraints. We also extend our work to multi GPGPU cards and show improvements of 44% on average relative to existing technique. Copyright © 2013 ACM.},
 author = {Nath, Rajib and Ayoub, Raid and Rosing, Tajana Simunic},
 doi = {10.1145/2463209.2488952},
 journal = {Proceedings - Design Automation Conference},
 note = {Cited by: 9},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Temperature aware thread block scheduling in GPGPUs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84879874179?origin=resultslist},
 year = {2013}
}
