@inproceedings{11283794,
 abstract = {Precise estimation of photovoltaic (PV) module parameters is essential for detecting early-stage faults in PV installations. Recent studies have introduced a power-generation model grounded in a triple-diode configuration to enhance estimation precision. Nevertheless, parameter identification remains difficult due to the nonlinear and feedback-driven interactions between internal characteristics and output power, alongside long-term operational effects such as aging, drift, and efficiency loss. To overcome these challenges, this work presents an ensemble framework based on deep learning, designed to merge the results from various optimization strategies to achieve more reliable and accurate parameter estimation. The methodology includes three main components. First, a PV output model adopting the triple-diode structure is constructed. Second, a set of optimization techniques-each operating with its own exploration and exploitation strategy-is applied to obtain a broad range of solution candidates. Third, the system trains a composite deeplearning framework that couples convolutional layers with LSTM units, enabling it to learn from these candidate outputs and ultimately generate the final forecast. The proposed system is evaluated on a $733-\mathrm{kW}$ PV installation. Experimental findings reveal that the ensemble approach delivers better accuracy and improved stability compared with standalone optimization algorithms and traditional LSTM-only models.},
 author = {Yang, Sung-Pei and Shih, Fong-Ruei and Huang, Chao-Ming and Chen, Shin-Ju and Chiua, Cheng-Hsuan},
 booktitle = {2025 14th International Conference on Renewable Energy Research and Applications (ICRERA)},
 doi = {10.1109/ICRERA66237.2025.11283794},
 issn = {2572-6013},
 keyword = {Deep learning;Parameter estimation;Accuracy;Computational modeling;Estimation;Predictive models;Prediction algorithms;Stability analysis;Ensemble learning;Long short term memory;Triple-dioder model;PV power estimation;ensemble model;physical model},
 month = {Oct},
 number = {},
 pages = {395-400},
 title = {A Deep Learning-Based Ensemble Method for Parameter Estimation of Photovoltaic Modules Using a Physical Model},
 volume = {},
 year = {2025}
}
