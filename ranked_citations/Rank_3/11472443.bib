@inproceedings{11472443,
 abstract = {As research documents grow denser and more complex, there's a vital need for tools that simplify their examination and analysis for reviewers and readers. This paper introduces a novel web-based document review application designed to enhance the efficiency of processing and annotating research articles. Developed using React for a fluid front-end experience and FastAPI for dependable backend functionality, this tool offers a unique document analysis methodology through dynamic document chunking, sophisticated research paper processing, and accurate table extraction.The application's core innovation lies in its adaptive boundary boxes, which provide users the ability to tailor their document interaction. Whether expanding, minimizing, or customizing chunks, this feature allows for a personalized review process, merging automated operations with user inputs to improve versatility and analysis accuracy significantly.Moreover, the tool's modular structure assures outstanding scalability and robustness, making it a versatile asset for various fields, including scientific research, legal document examination, and academic paper review. The paper discusses the development and implementation of this tool in detail, assessing its user-friendliness and effectiveness in streamlining the review process and enhancing analysis quality for both reviewers and readers.By merging complex document analysis requirements with an intuitive design, this application redefines research document review tools' standards. It envisions a future where navigating the intricacies of research work is drastically easier, ensuring users can achieve their goals with enhanced ease and efficiency. This innovation holds the promise of transforming the review and analysis of research documents, setting a new benchmark in the field.},
 author = {Selvakumar, Prakash and Kumar, Ashish and Chaturvedi, Prashant and Motwani, Mohit and Yadav, Ankit},
 booktitle = {2025 5th International Conference on Electrical, Computer and Energy Technologies (ICECET)},
 doi = {10.1109/ICECET63943.2025.11472443},
 issn = {},
 keyword = {Feedback;System-on-chip;Circuits;Protocols;HTTP;Cloud computing;Internet;Switches;Electronic components;Artificial intelligence;Artificial Intelligence;Computer Vision;Data Science;Machine Learning},
 month = {July},
 number = {},
 pages = {1-6},
 title = {Empowering Researchers with Adaptive Document Chunking and Visual Refinement Tool},
