@inproceedings{5757280,
 abstract = {The GMES (Global Monitoring for Environment and Security) is a European initiative aiming to develop, establish and promote a global framework for remote sensing applications from space. The implementation of this objective requires a convenient integration of space based data and in-situ earth interpretation capacities. Among the three fast-track services identified by GMES, the Marine Core Service has been selected to provide a context enabling a sustainable exploitation of the seas. The priorities have been concretely identified and this paper is mainly concerned by three issues: monitoring of fisheries, monitoring of the coastline and monitoring of the effects of environmental hazards and pollution crisis. Three specific algorithms will be presented. Then it will be shown that they can be efficiently merged together in an operational tool, which provides a reliable interpretation of oceanic SAR images.},
 author = {Tello, Marivi and Lopez-Martinez, Carlos and Mallorqui, Jordi J.},
 booktitle = {7th European Conference on Synthetic Aperture Radar},
 doi = {},
 issn = {},
 keyword = {Monitoring;Algorithm design and analysis;Marine vehicles;Estimation;Filtering algorithms;Sea surface;Wavelet transforms},
 month = {June},
 number = {},
 pages = {1-4},
 title = {Specific Post-processing Algorithms Fused for Ocean Monitoring from SAR Images},
 volume = {},
 year = {2008}
}
