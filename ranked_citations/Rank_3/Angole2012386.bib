@article{Angole2012386,
 abstract = {African traditional medicine as practiced by local herbalist generates a lot of knowledge that is not shared and widely used as effectively as that from conventional western medicine. Knowledge generated from conventional western medicine is structured unlike African traditional medicine whose knowledge is not structured. This paper presents the African Traditional Medicine Ontology (ATMO). ATMO is proposed as a model to create structure for knowledge generated by local herbalists and integrate it into western medicine. It extends an upper level ontology, the Basic formal Ontology. The ontology contains general concepts about traditional medicine knowledge and their use in human treatments. The ATMO aims at structuring the knowledge of African traditional medicine so that it can then be used together or in parallel with conventional western medicine for effective treatment of diseases. © 2012 The authors and IOS Press. All rights reserved.},
 author = {Angole, Richard Okelo and Jehopio, Peter and Maiga, Gilbert and Omoda-Onyait, Godfrey},
 doi = {10.3233/978-1-61499-105-2-386},
 journal = {Frontiers in Artificial Intelligence and Applications},
 note = {Cited by: 1},
 pages = {386 - 395},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards an ontology model for African traditional medicine},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84879100867?origin=resultslist},
 volume = {243},
 year = {2012}
}
