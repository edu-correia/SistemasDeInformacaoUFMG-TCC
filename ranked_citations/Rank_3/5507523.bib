@inproceedings{5507523,
 abstract = {The XML has undoubtedly become a standard for data representation and manipulation. But most of XML documents are still created without the respective description of their structure, i.e. an XML schema. Hence, in this paper we focus on the problem of inference of an XML schema from a given sample set of XML documents. In particular, we focus on often discussed but so far not exploited input - user interaction. It enables to acquire more realistic result, express the semantics of the described data more precisely and exploit new features of XML Schema language that could not be exploited in the existing approaches. Using a set of experiments we illustrate the behavior of the algorithm on both real-world and synthetic XML data.},
 author = {Vyhnanovská, Julie and Mlýnková, Irena},
 booktitle = {2010 Fourth International Conference on Research Challenges in Information Science (RCIS)},
 doi = {10.1109/RCIS.2010.5507523},
 issn = {2151-1357},
 keyword = {XML;Merging;Software engineering;Software standards;Proposals;Inference algorithms;Testing;Gold;Automata;Heuristic algorithms},
 month = {May},
 number = {},
 pages = {191-202},
 title = {Interactive inference of XML schemas},
 volume = {},
 year = {2010}
}
