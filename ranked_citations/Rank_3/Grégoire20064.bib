@article{Grégoire20064,
 abstract = {This survey covers recent contributions from the artificial intelligence research literature about logic-based information fusion. First, the main current approaches dealing with the standard propositional logic formalism are presented and compared. Then, techniques for fusing weighted belief bases are discussed. Finally, relationships between propositional information fusion and related areas such as belief revision and multi-agent negotiation are mentioned. © 2005 Elsevier B.V. All rights reserved.},
 author = {Grégoire, Eric and Konieczny, Sébastien},
 doi = {10.1016/j.inffus.2005.08.001},
 journal = {Information Fusion},
 note = {Cited by: 30},
 number = {1},
 pages = {4 - 18},
 publication_stage = {Final},
 source = {Scopus},
 title = {Logic-based approaches to information fusion},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/31144462529?origin=resultslist},
 volume = {7},
 year = {2006}
}
