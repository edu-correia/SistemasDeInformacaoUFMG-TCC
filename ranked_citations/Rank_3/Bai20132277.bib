@article{Bai20132277,
 abstract = {Search result diversification has recently gained attention as a means to tackle ambiguous queries. Subtopic mining is a basic component of diversified document ranking which will return a selectively ranked list of web pages by given a query. The aim of subtopic mining is to return a ranked list of possible "subtopic strings" that correspond to a query. In this paper, we present an approach for subtopics mining for diversified IR, and to further improve result diversity, we employ a voting method to rank candidate subtopics and a semantic resource HowNet was used to merge those candidate subtopics which may impact diversity. We test those methods by using 200 topics which were released in the subtopic mining subtask at NTCIR-9&10 INTENT tracks. Our results show that this method performs effectively both for queries with multiple interpretations, and for those open to multiple aspects related to a single interpretation. Copyright © 2013 Binary Information Press.},
 author = {Bai, Yu and Zheng, Jianxi and Guo, Cheng and Cai, Dongfeng},
 journal = {Journal of Computational Information Systems},
 note = {Cited by: 1},
 number = {6},
 pages = {2277 - 2284},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on subtopic mining for diversified IR},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84876014021?origin=resultslist},
 volume = {9},
 year = {2013}
}
