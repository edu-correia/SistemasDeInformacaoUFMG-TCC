@inproceedings{11170105,
 abstract = {This paper presented bimodal fusion of singlecell impedance and imaging data using three deep neural networks of data-level direct modeling, feature-level joint fusion and decision-level meta-learning. The merged pictures of single-cell impedance and imaging were directly processed by convolutional neural network as data-level direct modeling. Recurrent and convolutional neural networks were used to extract recessive features from single-cell impedance and imaging data, respectively, which were further processed by feedforward neural network for feature-level joint fusion or translated into prediction results as decision-level metalearning. Classification accuracies of 4-part leukocyte differential were quantified as 98.9% of data-level direct modeling, 99.1% of feature-level joint fusion and 99.5% of decision-level meta-learning, which were significantly higher than 90.4% of recurrent neural network and 90.2% of convolutional neural networks only. These results validated the capabilities of bimodal fusion in improving classification accuracies of single-cell impedance and imaging data.},
 author = {Chen, Songjiang and Chen, Xiao and Huang, Xukun and Fang, Zhen and Wang, Junbo and Huo, Xiaoye and Chen, Xianxiang and Chen, Jian},
 booktitle = {2025 IEEE 20th International Conference on Nano/Micro Engineered and Molecular Systems (NEMS)},
 doi = {10.1109/NEMS67320.2025.11170105},
 issn = {2474-3755},
 keyword = {Metalearning;Accuracy;Recurrent neural networks;Nanoelectromechanical systems;Imaging;Data integration;Feature extraction;Data models;Impedance;Convolutional neural networks},
 month = {May},
 number = {},
 pages = {250-253},
 title = {Bimodal Fusion of Single-Cell Impedance and Imaging Data Using Three Deep Neural Networks of Data-Level Direct Modeling, Feature-Level Joint Fusion and Decision-Level Meta-Learning, a Comparative Study},
