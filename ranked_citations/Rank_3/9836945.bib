@inproceedings{9836945,
 abstract = {Aiming at the problems of metadata server performance bottleneck and low file reading efficiency when the storage system in the cloud environment faces small file storage. Starting from the inherent data association between small files, this paper extracts the association through a lightweight pattern matching algorithm. The small files are merged on the basis of this feature, which improves the rationality of the merged files, and saves the small files in the same merged file into the client cache when the file is read to improve the cache read hit rate. Experiments verify that the scheme in this paper can effectively improve the access efficiency of small files.},
 author = {Dong, Xiaoling and Yin, Xiaoyu and Yu, Dongbo and Zhang, Min},
 booktitle = {2022 IEEE 10th Joint International Information Technology and Artificial Intelligence Conference (ITAIC)},
 doi = {10.1109/ITAIC54216.2022.9836945},
 issn = {2693-2865},
 keyword = {Correlation;Merging;Metadata;Feature extraction;Data mining;Servers;Information technology;distributed storage;small file storage;data associativity;file merging},
 month = {June},
 number = {},
 pages = {1351-1355},
 title = {Small file storage optimization model in cloud environment},
 volume = {10},
 year = {2022}
}
