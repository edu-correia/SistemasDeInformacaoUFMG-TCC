@article{WANG2026114500,
 abstract = {Thermites are widely used in various fields due to its excellent performance, but the balance between its efficient preparation and output performance is still one of the key issues restricting its development. In this paper, Al/CuO@F2175 microsphere composites with different binder contents were efficiently synthesized by solvent restraint method. The microspheres exhibit excellent hydrophobicity, dispersibility, and good particle size uniformity. Through the design of microsphere structure, the merging of solid-solid reaction peaks and liquid-solid reaction peaks is successfully realized, which makes the energy release more concentrated, and its solid-liquid reaction temperature was advanced by 106.8 °C compared with that of the pure Al/CuO system. The DSC results showed that the exothermic amount of Al/CuO@F2175 (873.1 J/g) increased by 173 % compared to Al/CuO (319.4 J/g) prepared by physical mixing method. Ignition tests further confirmed that Al/CuO@F2175 has a shorter burn time and larger flame area. In addition, combustion pressure tests show a significant increase in peak pressure and a ramp-up rate of four times higher for Al/CuO@F2175#2 than for Al/CuO. This study not only solves the contradiction between efficient preparation and high performance, but also provides new ideas for controllable adjustment of thermistor performance according to different application scenarios.},
 author = {Xiwen Wang and Qianwen Jiang and Buhao Zheng and Xuehang Jiao and Hongbiao Huo and Chunpei Yu and Jianyong Xu and Pengfei Cui and Wenchao Zhang},
 doi = {https://doi.org/10.1016/j.combustflame.2025.114500},
 issn = {0010-2180},
 journal = {Combustion and Flame},
 keyword = {Thermites, Combustion, Microsphere, Fluoroelastomer, Solvent restraint method},
 pages = {114500},
 title = {Efficient construction of high-quality encapsulated microspheres Al/CuO@F2175 to enhance the combustion performance of thermites},
 url = {https://www.sciencedirect.com/science/article/pii/S0010218025005371},
 volume = {283},
 year = {2026}
}
