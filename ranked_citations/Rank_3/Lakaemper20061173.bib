@conference{Lakaemper20061173,
 abstract = {The paper deals with fitting of planar patches to 3D laser range data obtained by a mobile robot. The number and the initial position of the patches are unknown, hence their estimation is a challenging problem. It is solved by adding iterated steps of split and merge to a modified Expectation Maximization (EM) algorithm. This allows for precise adjustment of the number of patches, independent from the initial model. The proposed approach overcomes the problem of classical EM, which produces an optimal solution only if the number and position of model components is well estimated. © 2006 IEEE.},
 author = {Lakaemper, Rolf and Latecki, Longin Jan},
 doi = {10.1109/ROBOT.2006.1641868},
 journal = {Proceedings - IEEE International Conference on Robotics and Automation},
 note = {Cited by: 13},
 pages = {1173 - 1179},
 publication_stage = {Final},
 source = {Scopus},
 title = {Extended EM for planar approximation of 3D data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33845677746?origin=resultslist},
 volume = {2006},
 year = {2006}
}
