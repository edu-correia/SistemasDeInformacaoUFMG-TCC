@incollection{KUMAR2025443,
 abstract = {Digital Twins have become a cornerstone of Smart Manufacturing, representing a virtual linkage between the physical and digital realms. These digital replicas of physical assets or processes offer real-time insights, predictive capabilities, and experimentation platforms. In the context of Smart Manufacturing, Digital Twins play a pivotal role by enabling enhanced product development, streamlined production, and proactive maintenance. Manufacturers can simulate various scenarios, optimize processes, and forecast maintenance requirements by creating accurate virtual counterparts of physical assets. This anticipatory approach minimizes operational disruptions, reduces downtime, and boosts overall efficiency. Digital Twins also fosters innovation by providing a sandbox for testing ideas, expediting prototyping, and shortening time-to-market for new products. Digital Twins facilitate collaboration across interdisciplinary teams, bridging the gap between design, engineering, and data science. However, challenges such as data accuracy, privacy, security, and standardization persist. Ensuring reliable data exchange is vital for accurate digital representations, and harmonized practices are necessary for broader industry adoption. This chapter discusses the need for Design Integration in Manufacturing using Digital Twin technology. In conclusion, Digital Twins represents a transformative force within Smart Manufacturing, merging physical and digital aspects to optimize processes, cut costs, and drive innovation. As technology continues to evolve, harnessing the potential of Digital Twins will be instrumental in shaping the future of manufacturing industries.},
 author = {Pulkit Kumar and Harpreet Kaur Channi},
 booktitle = {Digital Twins for Smart Cities and Villages},
 doi = {https://doi.org/10.1016/B978-0-443-28884-5.00019-1},
 editor = {Sailesh Iyer and Anand Nayyar and Anand Paul and Mohd Naved},
 isbn = {978-0-443-28884-5},
 keyword = {Artificial intelligence, Digital twin, Environments, Internet of things, Quantum computing, Smart manufacturing},
 pages = {443-464},
 publisher = {Elsevier},
 title = {Chapter 19 - Design for digital twins in smart manufacturing},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443288845000191},
 year = {2025}
}
