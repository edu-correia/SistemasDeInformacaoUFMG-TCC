@inproceedings{11380028,
 abstract = {The arrival of online learning has stated the need for secure methods to maintain academic integrity in online evaluations. Traditional systems struggle to monitor and prevent cheating accurately, boosting the desire for AI-driven alternatives. This study presents an AI-powered proctoring solution that includes real-time face detection, unauthorized device detection, behavioral analysis, plagiarism detection, and automated evaluation to boost security and fairness in programming exams. The proposed method incorporates real-time face recognition for student identification, paired with object detection techniques to identify prohibited electronics. It employs Generative AI for dynamic question formation based on exam subjects, ensuring varied and intellectually rich exams. Additionally, AI-driven plagiarism detection, keystroke analysis, and behavioral tracking encourage honesty. A multi-language code editor with real-time validation increases fairness by automating conceptual judgments and avoiding manual work. The system's ability to enforce a full-screen exam mode greatly mitigates the likelihood of lying. This technology offers higher security, efficiency, and usefulness than conventional choices. Generative AI-driven question formulation enhances evaluation diversity, while real-time AI monitoring enables accurate cheating detection. Automated evaluation systems reduce administrative workload, allowing a scalable and fair examination system. By merging many AI-powered security layers, this method gives a trustworthy and an entire solution to shielding online assessments.},
 author = {Khairnar, Smita and Patil, Sonali and Kalbhor, Madhura and Solapure, Vandana and Bidwai, Pooja},
 booktitle = {2025 International Conference on Electronics and Computing, Communication Networking Automation Technologies (ICEC2NT)},
 doi = {10.1109/ICEC2NT65402.2025.11380028},
 issn = {},
 keyword = {Accuracy;Codes;Generative AI;Plagiarism;Face recognition;Object detection;Real-time systems;Security;Object recognition;Monitoring;Academic integrity;AI proctoring;automated evaluation;cheating detection;face recognition;generative AI;object detection;online assessments;plagiarism detection;real-time monitoring},
 month = {Sep.},
 number = {},
 pages = {1-7},
 title = {ProctorCode: A Secure Framework for Practical Exams using Generative Evaluation and Smart Monitoring},
 volume = {},
 year = {2025}
