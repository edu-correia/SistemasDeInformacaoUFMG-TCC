@inproceedings{11341992,
 abstract = {In order to develop a new power system dispatch model and method under the dual-carbon background, a multi-energy complementary dispatch model with the integration of cascade hydro-wind-photovoltaic (CHWP) considering stepwise carbon trading is constructed. In order to improve the efficiency and adaptability of such high-dimensional non-convex optimization problems of the CHWP-containing multi-energy complementary scheduling model, this paper proposes a golden jackal optimization algorithm (EGJO) based on Logistic chaotic mapping, quasi-reflective learning strategy, Gaussian stochastic wandering strategy, and optimal individual local search combined with differential variational perturbation strategy. Firstly, the initialized population is generated using Logistic Chaos Mapping, which enhances the spatial diversity of the algorithm; secondly, the quasi-reflective learning strategy and Gaussian random walk strategy are introduced to update the positions of jackal pairs in the search, encircle and attack phases of the golden jackal algorithm respectively, which strengthens the algorithm's global optimization ability as well as its convergence speed; and lastly, optimal individuals are introduced to locally search combined with the differential variance perturbation strategy after the merged updated positions to improve the solution accuracy. strategy to improve the solution accuracy. The case analysis is carried out in the extended IEEE3 machine 9 nodes and a simplified power system in a provincial area. The experimental results fully verify the effectiveness and superiority of the model and method proposed in this paper.},
 author = {Gao, Hua and Zhang, Jianying and Zhang, Xue and Rong, Na and Han, Song and Jiang, Congmei},
 booktitle = {2025 World Symposium on Electrical Systems (WSES)},
 doi = {10.1109/WSES66254.2025.11341992},
 issn = {},
 keyword = {Adaptation models;Chaotic mapping;Costs;Perturbation methods;Stochastic processes;Optimal scheduling;Emissions trading;Scheduling;Power systems;Logistics;CHWP;EGJO;Quasi-Reflective Learning Strategy;Gaussian Random Wandering Strategy},
 month = {June},
 number = {},
 pages = {149-154},
 title = {On Integrated Optimal Scheduling of Cascade Hydro-Wind-Photovoltaic Based on EGJO},
