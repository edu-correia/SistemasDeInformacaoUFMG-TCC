@inproceedings{5563858,
 abstract = {Online interaction was critical in underpinning the learning process in E-learning, and a framework for resource-oriented interactive learning, aiming to promote deep interaction among learners, resources and resource creators was proposed in this paper. Specifically, much research has been done to realize the interaction between learners and resources, recombination of resources and their presentation which were the core ideas of the framework. We discussed the process of learners' interactive learning on resources, probed into the method of merging different ontology graphs basing on their semantic association to recombine resources and developed a visual presentation model for resources basing on learners' interest and preference. Finally, an interactive learning tool basing on this framework was introduced.},
 author = {Sanya Liu and Huifang Zhang and Qi Wu and Lin Liu and Jianwen Sun},
 booktitle = {2010 3rd International Conference on Computer Science and Information Technology},
 doi = {10.1109/ICCSIT.2010.5563858},
 issn = {},
 keyword = {Visualization;interactive learning;annotating;resources' recombination;resources' presentation},
 month = {July},
 number = {},
 pages = {559-563},
 title = {A framework for resource - oriented interactive learning},
 volume = {5},
 year = {2010}
}
