@article{Merzoug2021799,
 abstract = {Web service discovery is one of the most motivating issues of service-oriented computing field. Several approaches have been proposed to tackle this problem. In general, they leverage similarity measures or logic-based reasoning to perform this task, but they still present some limitations in terms of effectiveness. In this paper, we propose a probabilistic-based approach to merge a set of matching algorithms and boost the global performance. The key idea consists of learning a set of relevance probabilities; thereafter, we use them to produce a combined ranking. The conducted experiments on the real world dataset “OWL-S TC 2” demonstrate the effectiveness of our model in terms of mean averaged precision (MAP); more specifically, our solution, termed “probabilistic fusion”, outperforms all the state of the art matchmakers as well as the most prominent similarity measures. © 2021. All Rights Reserved.},
 author = {Merzoug, Mohammed and Etchiali, Abdelhak and Hadjila, Fethallah and Bekkouche, Amina},
 doi = {10.14569/IJACSA.2021.0120989},
 journal = {International Journal of Advanced Computer Science and Applications},
 note = {Cited by: 2; All Open Access; Gold Open Access},
 number = {9},
 pages = {799 - 808},
 publication_stage = {Final},
 source = {Scopus},
 title = {Effective Service Discovery based on Pertinence Probabilities Learning},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85119185003?origin=resultslist},
 volume = {12},
 year = {2021}
}
