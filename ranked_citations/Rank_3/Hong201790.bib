@conference{Hong201790,
 abstract = {Erasable-itemset mining is to find the itemsets (components) that can be eliminated if the products generated from them gain profit under a given threshold. In this paper, we consider the erasable-itemset integration problem to merge the erasable itemsets from two data sources. We propose an efficient merging algorithm, which can get the merged erasable itemsets directly or by rescanning partial data sources to reduce mining time. Experiments are also made to show that the proposed algorithm executes faster than the re-mining approach for merging erasable itemsets. © 2016 IEEE.},
 author = {Hong, Tzung-Pei and Shih, Tsung-Ta and Lin, Chun-Wei and Vo, Bay},
 doi = {10.1109/ICS.2016.0026},
 journal = {Proceedings - 2016 International Computer Symposium, ICS 2016},
 note = {Cited by: 0},
 pages = {90 - 93},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging Two Sets of Erasable Itemsets},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85015264403?origin=resultslist},
 year = {2017}
}
