@conference{Purushothaman2024,
 abstract = {It has become customary that 5G telecommunications systems merge with IoT these days because of their high data rates, minimal delay, and vastly distributed connectivity. The interference and the network renewal issues still last, though. The current application of this 5G in IoT applications and its main obstacles or limitations are discussed as this. The integration of ad-hoc networks in 5G environment is one viable option for future indl strongest data transmission. Various ad hoc networks can give a chance for a local communication channel and continuous capability of self-organising, which can help 5G networks which have a centralized architecture. Furthermore, this symmetric network model can increase coverage, decrease the need for the amount of the transmission power and therefore will help to enrich the communication capabilities of the IoT devices. Among the topics that call for the further research are designing efficient routing protocols, constructing a cybersecurity framework, and establishment a mechanism for interaction between intrewireless networks and 5G data network infrastructure. In general, 5G technology can successfully solve the problem of limited communication over the IoT networks thus, create superior platforms for communication in the future. © 2024 IEEE.},
 author = {Purushothaman, N. and Sivasankar, C. and Subramanian, E.K. and Sarala, V. and Moorthy, A.},
 doi = {10.1109/ICAIT61638.2024.10690332},
 journal = {2nd IEEE International Conference on Advances in Information Technology, ICAIT 2024 - Proceedings},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integrating Ad-Hoc Networks with 5G for Enhanced Communication Capabilities},
 type = {Conference paper},
