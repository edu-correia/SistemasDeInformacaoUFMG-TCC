@inproceedings{11467533,
 abstract = {The metaverse, a burgeoning digital landscape merging virtual and real-world experiences, has captured widespread attention across diverse sectors, including banking. Financial entities and fintech entrepreneurs are actively exploring avenues to embed their offerings within this dynamic domain, leveraging its potential for expansive reach, immersive engagement, and innovative services. However, the path toward integrating the metaverse into banking is fraught with complex and multifaceted barriers. This study employs Interpretive Structural Modeling (ISM) to methodically dissect and classify these barriers, unveiling their hierarchical structure and interconnectedness. Through this analysis, financial institutions can devise targeted strategies to surmount each obstacle effectively. The research outcomes illuminate the intricate nature of impediments to metaverse adoption in banking, furnishing a guide for navigating this novel terrain and unlocking its promised advantages.},
 author = {Jain, Pooja and Gupta, Vivek and Rathore, Kishan Singh and Siddiqui, Zeba and Jain, Rachit},
 booktitle = {2025 IEEE 4th International Conference on Technology, Engineering, Management for Societal impact using Marketing, Entrepreneurship and Talent (TEMSMET)},
 doi = {10.1109/TEMSMET65536.2025.11467533},
 issn = {},
 keyword = {System-on-chip;Internet;Internet of Things;Graphical user interfaces;Communication systems;Avatars;Protocols;Computer networks;HTTP;Internetworking;Metaverse;Barriers;Banking Industry;Adoption;ISM},
 month = {Oct},
 number = {},
 pages = {1-5},
 title = {Unraveling Barriers to Metaverse Integration in Banking through Interpretive Structural Modeling: Leveraging Entrepreneurial Innovation},
 volume = {},
 year = {2025}
}
