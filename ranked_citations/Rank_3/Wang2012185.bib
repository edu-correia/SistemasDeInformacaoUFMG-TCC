@article{Wang2012185,
 abstract = {Many ontologies don't add relevant instances information while constructing, which will affect the performance based on instance mapping strategy directly. This article will put forward mapping method based on extended information using hierarchical text classification to allocate the text in web ontology as background resources to concept and attribute nodes in ontology. These texts as extended instances reconstruct mapping ontology, and also construct concept and attribute nodes classifier of each ontology. Then, instances of ontology can be classified to nodes of another ontology as test set, and proceed cross classification. Finally we can get the alignment set using mapping method based on probability theory. This method can expand instance set, improve performance of mapping strategy based on instances, and the mapping which combines text with the probability theory can not only obtain the equivalence relation mapping, but also achieve the inclusion relation mapping.},
 author = {Wang, Rujuan and Wang, Qiushuang and Lu, Shuai and Liu, Yu and Liu, Lei},
 doi = {10.4156/ijact.vol4.issue10.22},
 journal = {International Journal of Advancements in Computing Technology},
 note = {Cited by: 1},
 number = {10},
 pages = {185 - 194},
 publication_stage = {Final},
 source = {Scopus},
 title = {Ontology mapping method based on extended information},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84862869134?origin=resultslist},
 volume = {4},
 year = {2012}
}
