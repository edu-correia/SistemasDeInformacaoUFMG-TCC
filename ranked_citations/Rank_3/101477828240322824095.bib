@article{10.14778/2824032.2824095,
 abstract = {This demonstration presents HadoopViz; an extensible MapReduce-based system for visualizing Big Spatial Data. HadoopViz has two main unique features that distinguish it from other techniques. (1) It provides an extensible interface that allows users to visualize various types of data by defining five abstract functions, without delving into the details of the MapReduce algorithms. We show how it is used to create four types of visualizations, namely, scatter plot, road network, frequency heat map, and temperature heat map. (2) HadoopViz is capable of generating big images with giga-pixel resolution by employing a three-phase approach of partitioning, rasterize, and merging. HadoopViz generates single and multi-level images, where the latter allows users to zoom in/out to get more/less details. Both types of images are generated with a very high resolution using the extensible and scalable framework of HadoopViz.},
 author = {Eldawy, Ahmed and Mokbel, Mohamed F. and Jonathan, Christopher},
 doi = {10.14778/2824032.2824095},
 issn = {2150-8097},
 issue_date = {August 2015},
 journal = {Proc. VLDB Endow.},
 month = {August},
 number = {12},
 numpages = {4},
 pages = {1896–1899},
 publisher = {VLDB Endowment},
 title = {A demonstration of HadoopViz: an extensible MapReduce system for visualizing big spatial data},
 url = {https://doi.org/10.14778/2824032.2824095},
 volume = {8},
 year = {2015}
}
