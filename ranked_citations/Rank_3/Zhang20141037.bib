@conference{Zhang20141037,
 abstract = {Ontology plays an important role in data integration. A bottleneck of ontology engineering is to build high quality ontologies from some corpuses. Recently, there is an increasing interest in extracting ontologies from relational databases. However, almost all such works focus on mapping a single relational database to an ontology. In this work, we consider a more challenging problem, i.e., building ontologies from multiple heterogeneous databases. Our approach to solving this problem mainly consists of three steps. In the first step, we apply mapping rules to extract ontologies from individual databases. In the second step, we develop an algorithm to establish matching among different ontologies. In the final step, we merge the extracted ontologies. We develop a system to build ontologies from heterogeneous databases. Since the merged ontology is built from databases, we can establish a mapping from the ontology to the databases. Thus, our tool can be used to integrate databases based on the merged ontology. Our system also provides a visualization of the merged ontology and its mapping to the relational databases. © 2014 WIT Press.},
 author = {Zhang, Hui and Diao, Xingchun and Yuan, Zhen and Chun, Jiang and Huang, Yu},
 doi = {10.2495/ISME20131332},
 journal = {WIT Transactions on Information and Communication Technologies},
 note = {Cited by: 1},
 pages = {1037 - 1044},
 publication_stage = {Final},
 source = {Scopus},
 title = {A new approach to building ontologies from heterogeneous databases},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84887858700?origin=resultslist},
 volume = {46 VOLUME 2},
 year = {2014}
}
