@inproceedings{11447104,
 abstract = {In response to the problems of one-sided content summarization, high redundancy, and insufficient semantic correlation of keywords in traditional extraction-based summarization algorithms in news text summarization, this paper proposes an improved weighted algorithm WMMR that integrates Maximal Marginal Relevance algorithm (MMR) and knowledge graph technology. This algorithm constructs a multidimensional feature evaluation system, integrating text similarity, keyword weights, sentence position information, clue word matching score, and title sentence similarity through a dynamic weighting formula to optimize the sentence scoring mechanism of MMR. It also utilizes a knowledge graph to achieve semantic merging of synonymous terms, enhancing the semantic representativeness of keywords. The algorithm process includes data preprocessing, multi-feature fusion modeling (TextRank semantic similarity calculation, BERT-TF-IDF keyword extraction with knowledge graph enhancement, differentiated position weight allocation, and clue word dictionary matching), and finally WMMR sentence sorting to generate top-3 summary sentences.},
 author = {Li, Xingyuan and Guo, Xu},
 booktitle = {2025 2nd International Seminar on Artificial Intelligence, Computer Technology and Control Engineering (ACTCE)},
 doi = {10.1109/ACTCE66599.2025.00084},
 issn = {},
 keyword = {Seminars;Correlation;Heuristic algorithms;Semantics;Redundancy;Merging;Text summarization;Knowledge graphs;Resource management;Sorting;news text summary;Extraction-based algorithm;Maximal boundary correlation algorithm;knowledge graph},
 month = {Sep.},
 number = {},
 pages = {416-419},
 title = {WMMR: An Improved News Text Abstract Generation Algorithm Based on MMR and Knowledge Graph},
 volume = {},
 year = {2025}
}
