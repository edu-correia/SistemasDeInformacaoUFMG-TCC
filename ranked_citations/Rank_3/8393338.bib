@inproceedings{8393338,
 abstract = {Querying multiple deep web source information is an important issue that may be encountered in many applications. Deep Web is really treasury of new and complementary products offered by many service web providers. It contains more than 90% of information hidden behind web forms in remote databases, while only less than 10% of information in web reached by following hyperlinks called web of surface. In this paper, we address the issue of query answering without access to data. We than propose a new approach which guides interpretation of global query with graphical clues inspired from galaxy and cosmic universe. So that navigation around all semantic entities of global query (e.g. field, concept, query) is brings back to cosmic travel of astronaut around particles of cosmic universe (e.g. stars, galaxy, and super-galaxy). We have done virtual integration of deep web services, i.e. we have merged queries of a number of service web providers. The last step is to transform universal query to universal deep web form. The global query is a data structure which touches meaning of deep Web form, while universal web form touches the interpretation of universal query. These indicators guide visual perception of users through all semantic entities of query. So that, a user friendly web form is necessary to reach global query capability without complexity nor ambiguity, as global deep web form is designed for novice users (e.g. children) and all different ages on internet users. We have evaluated performance of our algorithm on two real-world and standard datasets, and have proved good performance.},
 author = {Boughammoura, Radhouane and Omri, Mohamed Nazih},
 booktitle = {2017 13th International Conference on Natural Computation, Fuzzy Systems and Knowledge Discovery (ICNC-FSKD)},
 doi = {10.1109/FSKD.2017.8393338},
 issn = {},
 keyword = {Semantics;Web services;Visualization;Clustering algorithms;Earth;Web pages;Euclidean distance;Information Retrieval;Visual Query Design;Visual Attraction;Celestial Gravity;Semantic Interpretation},
 month = {July},
 number = {},
 pages = {597-603},
 title = {Querying deep web data bases without accessing to data},
 volume = {},
