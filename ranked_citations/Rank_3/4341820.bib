@inproceedings{4341820,
 abstract = {In this paper we propose four transformation rules to estimate the marking of a net, discrete or continuous, satisfying the following assumptions: the set of transitions is partitioned into observable and unobservable transitions; the net structure and the initial marking is known. For each rule we derive a set of linear algebraic constraints that characterize the set of markings of the original net that are consistent with the observed firing sequence.},
 author = {Cabasino, Maria Paola and Giua, Alessandro and Mahulea, Cristian and Recalde, Laura and Seatzu, Carla and Silva, Manuel},
 booktitle = {2007 IEEE International Conference on Automation Science and Engineering},
 doi = {10.1109/COASE.2007.4341820},
 issn = {2161-8089},
 keyword = {State estimation;Petri nets;Observability;Linear systems;State-space methods;Equations;Merging;Automation;Observers},
 month = {Sep.},
 number = {},
 pages = {194-199},
 title = {State Estimation of Petri Nets by Transformation},
 volume = {},
 year = {2007}
}
