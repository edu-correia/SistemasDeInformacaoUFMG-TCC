@conference{Harmon2020276,
 abstract = {This paper introduces a new approach for labeling the semantic purpose of the functions in a parser. An input file with a known syntax tree is passed to a copy of the target parser that has been instrumented for universal taint tracking. A novel algorithm is used to merge that syntax tree ground truth with the observed taint and control-flow information from the parser's execution, producing a mapping from types in the file format to the set of functions most specialized in operating on that type. The resulting mapping has applications in mutational fuzzing, reverse engineering, differential analysis, as well as automated grammar extraction. We demonstrate that even a single execution of an instrumented parser with a single input file can lead to a mapping that a human would identify as intuitively correct. We hope that this approach will lead to both safer subsets of file formats and safer parsers.  © 2020 IEEE.},
 author = {Harmon, Carson and Larsen, Bradford and Sultanik, Evan A.},
 doi = {10.1109/SPW50608.2020.00061},
 journal = {Proceedings - 2020 IEEE Symposium on Security and Privacy Workshops, SPW 2020},
 note = {Cited by: 8; All Open Access; Gold Open Access},
 pages = {276 - 283},
 publication_stage = {Final},
 source = {Scopus},
 title = {Toward automated grammar extraction via semantic labeling of parser implementations},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85099726596?origin=resultslist},
 year = {2020}
}
