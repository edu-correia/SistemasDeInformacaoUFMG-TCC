@article{Aldinucci2013798,
 abstract = {The stochastic modelling of biological systems, coupled with Monte Carlo simulation of models, is an increasingly popular technique in bioinformatics. The simulation-analysis workflow may result computationally expensive reducing the interactivity required in the model tuning. In this work, we advocate the high-level software design as a vehicle for building efficient and portable parallel simulators for the cloud. In particular, the Calculus of Wrapped Components (CWC) simulator for systems biology, which is designed according to the FastFlow pattern-based approach, is presented and discussed. Thanks to the FastFlow framework, the CWC simulator is designed as a high-level workflow that can simulate CWC models, merge simulation results and statistically analyse them in a single parallel workflow in the cloud. To improve interactivity, successive phases are pipelined in such a way that the workflow begins to output a stream of analysis results immediately after simulation is started. Performance and effectiveness of the CWC simulator are validated on the Amazon Elastic Compute Cloud. © The Author 2013.},
 author = {Aldinucci, Marco and Torquati, Massimo and Spampinato, Concetto and Drocco, Maurizio and Misale, Claudia and Calcagno, Cristina and Coppo, Mario},
 doi = {10.1093/bib/bbt040},
 journal = {Briefings in Bioinformatics},
 note = {Cited by: 16; All Open Access; Green Open Access},
 number = {5},
 pages = {798 - 813},
 publication_stage = {Final},
 source = {Scopus},
 title = {Parallel stochastic systems biology in the cloud},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84899449531?origin=resultslist},
 volume = {15},
 year = {2013}
}
