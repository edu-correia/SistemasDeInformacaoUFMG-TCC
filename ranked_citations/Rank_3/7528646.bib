@inproceedings{7528646,
 abstract = {Chemical vapor deposition (CVD) graphene would find great applications in industrial graphene-based electronics recently. Most importantly, the one-dimensional constriction of CVD graphene due to its grain boundaries and merged domains revealing interesting interference effects, like Aharonov-Bohm effect. Such interesting interference transport behavior can be revealed by low-temperature scanning gate microscopy (LT-SGM) and be numerical simulated about the dynamic transport point of view by mean-field Gross-Pitaevskii equation. In order to realize graphene-based quantum transport device, our results suggested that the supplying additional thermal current could flood into the grain boundaries and merged domains in one-dimensional quantum confined CVD graphene so as to suppress the interference effect, a great discovery for graphene-based materials coherent electronic devices.},
 author = {Chuang, Chiashain and Woo, Tak-Pong and Liu, Fan-Hung and Matsunaga, Masahiro and Ochiai, Yuichi and Liang, Chi-Te and Aoki, Nubuyuki},
 booktitle = {2016 Compound Semiconductor Week (CSW) [Includes 28th International Conference on Indium Phosphide & Related Materials (IPRM) & 43rd International Symposium on Compound Semiconductors (ISCS)},
 doi = {10.1109/ICIPRM.2016.7528646},
 issn = {},
 keyword = {Graphene;Interference;Grain boundaries;Logic gates;Scanning electron microscopy;Compounds;chemical vapor deposition graphene;Aharonov-Bohm effect;scanning gate microscopy;Gross-Pitaevskii equation;interference},
 month = {June},
 number = {},
 pages = {1-2},
 title = {Thermal current-induced charge redistribution in wide CVD-grown graphene constriction},
 volume = {},
 year = {2016}
}
