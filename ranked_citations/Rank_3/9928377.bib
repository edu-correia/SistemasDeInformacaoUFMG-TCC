@article{9928377,
 abstract = {This article presents a new design of experiment approach based on an evolving neuro-fuzzy model. The input of the process is proposed by a space-filling method that uses a sequence of step functions to maximize the coverage of the antecedent clusters in the input space of the evolving model, which is called the heuristic step sequence (HSS). When the system reaches a steady state, a new rule is added, existing rules are merged based on the similarity of the consequent transfer functions, and a new optimal excitation is calculated. The output error model structure was chosen because it assumes a noise distribution common to real processes and is suitable for identification, while the step function input signal is one of the most commonly used signals in identification and control. A filtered recursive least squares method is used to identify the consequent parameters of the output error models and the optimization filter is adapted based on the the confidence interval of the local model. Evaluations were performed on a Hammerstein type model comparing the HSS method with a staircase excitation and on a real plate heat-exchanger pilot plant. The experiments show that the proposed HSS method outperforms the staircase excitation and can be used to identify nonlinear dynamical systems of Hammerstein–Wiener type.},
 author = {Ožbot, Miha and Lughofer, Edwin and Škrjanc, Igor},
 doi = {10.1109/TFUZZ.2022.3216992},
 issn = {1941-0034},
 journal = {IEEE Transactions on Fuzzy Systems},
 keyword = {Adaptation models;Data models;Optimization methods;Nonlinear dynamical systems;Filtering algorithms;Covariance matrices;Steady-state;Evolving neuro-fuzzy system;filtered recursive least squares (FRLSs);Hammerstein–Wiener model;plate heat exchanger (PHE)},
 month = {June},
 number = {6},
 pages = {1995-2005},
 title = {Evolving Neuro-Fuzzy Systems-Based Design of Experiments in Process Identification},
 volume = {31},
 year = {2023}
}
