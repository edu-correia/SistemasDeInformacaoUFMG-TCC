@article{5165044,
 abstract = {Averaging is a common way to alleviate errors and random fluctuations in measurements and to smooth out data. Averaging also provides a way to merge structured data in a smooth manner. The present paper describes an algorithm to compute averages on matrix Lie groups. In particular, we discuss the case of averaging over the special orthogonal group of matrices, the unitary group of matrices and the group of symmetric positive-definite matrices.},
 author = {Fiori, Simone and Tanaka, Toshihisa},
 doi = {10.1109/TSP.2009.2027754},
 issn = {1941-0476},
 journal = {IEEE Transactions on Signal Processing},
 keyword = {Symmetric matrices;Signal processing algorithms;Independent component analysis;Adaptive systems;Fluctuations;Biomedical measurements;Quantum computing;Biomedical signal processing;Multidimensional systems;DNA;Averaging on curved spaces;complex-valued independent component analysis;matrix Lie groups;orthogonal group;positive-definite matrices;unitary group},
 month = {Dec},
 number = {12},
 pages = {4734-4743},
 title = {An Algorithm to Compute Averages on Matrix Lie Groups},
 volume = {57},
 year = {2009}
}
