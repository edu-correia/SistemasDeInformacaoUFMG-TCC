@incollection{KERNBACH201964,
 abstract = {Ecological immunology, or ecoimmunology, is the study of the causes and consequences of variation in host defenses, predominantly involving immune systems, but also other physiological and behavioral host processes. Ecoimmunology is thus a very integrative research discipline, focused on manifold within-host mechanisms that mediate how hosts cope with infection. One of the many contributions of ecoimmunology is the insight it offers from focusing on parasites defenses as whole-organism host responses. This perspective has enhanced our understanding of host evolution and ecology and our appreciation of the sophistication and diversity of viable host immune responses. In its early years, the field focused on the costs and consequent trade-offs inherent to immune defenses. In just the last few years, though, it has begun to merge with another nascent, integrative field, disease ecology. This new hybrid research area focuses on the roles and consequences of host and parasite heterogeneity at several levels of biological organization. Our goals in this contribution are to: (i) discuss the origins of ecoimmunology, (ii) highlight some of its most active research areas, and (iii) foreshadow research topics emerging in the area.},
 address = {Oxford},
 author = {Meredith Kernbach and Chloe Ramsay and Jason R. Rohr and Lynn B. Martin},
 booktitle = {Encyclopedia of Ecology (Second Edition)},
 doi = {https://doi.org/10.1016/B978-0-12-409548-9.10890-5},
 edition = {Second Edition},
 editor = {Brian Fath},
 isbn = {978-0-444-64130-4},
 keyword = {Costs, Co-infection, Dilution effect, Ecoimmunology, Heterogeneity, Host defenses, Host competence, Immunocompetence handicap hypothesis, Infectious disease, Life history, Resistance, Superspreader, Susceptibility, Trade-offs, Tolerance},
 pages = {64-71},
 publisher = {Elsevier},
 title = {Eco-Immunology: Past, Present, and Future},
 url = {https://www.sciencedirect.com/science/article/pii/B9780124095489108905},
 year = {2019}
