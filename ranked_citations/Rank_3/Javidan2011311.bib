@article{Javidan2011311,
 abstract = {One of the most important applications in sonar imaging is to classify the types of soils presented in the images. In this paper a new split and merge algorithm based on subsampled contourlet transform and feature smoothing technique is presented for automatic segmentation and classification of the seabed images. Contourlet transform is a new extension of the two- dimensional wavelet transform using multiscale and directional filter banks. The subsampled contourlet transform which is introduced for the first time in this paper is a new version of the contourlet transform that allows analysis of images in square-size coefficients with various resolution levels and directions. It effectively captures smooth contours that are dominant features in seabed images. The proposed method provides a fast algorithm with enough accuracy that can be implemented in a parallel structure for real-time processing. The simulation results are compared with those of the other well-known methods to show the effectiveness of the new proposed algorithm. Especially for different underwater image acquisition conditions such as ship speed, illumination, scale, direction, distance and slope, the proposed method produces better results. The comparisons are performed both visually (by experts) as well as quantitatively using state of art methods. © 2011 Praise Worthy Prize S.r.l. - All rights reserved.},
 author = {Javidan, Reza and Masnadi-Shirazi, M.A. and Azimifar, Zohreh},
 journal = {International Journal on Communications Antenna and Propagation},
 note = {Cited by: 1},
 number = {4},
 pages = {311 - 321},
 publication_stage = {Final},
 source = {Scopus},
 title = {Contourlet-based seabed image texture segmentation and classification},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84906510649?origin=resultslist},
 volume = {1},
 year = {2011}
}
