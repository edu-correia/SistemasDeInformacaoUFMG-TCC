@article{WILMERSDORF2003609,
 abstract = {Decision making in densely populated areas is dependent on local or regional aspects to a very high degree. Therefore it is necessary to merge geo-information fully into the IT-processes of a municipality. So the building-up of a spatial information infrastructure is aimed at a complete integration of geo-data providers and geo-information users in a comprising GI-network. The paper describes the general characteristics of such an infrastructure and how it is established in the on-line services and daily workflows of the City of Vienna.},
 author = {Erich Wilmersdorf},
 doi = {https://doi.org/10.1016/S0198-9715(03)00017-6},
 issn = {0198-9715},
 journal = {Computers, Environment and Urban Systems},
 keyword = {Geo-coded models, Geo-coded object inventory, Digital urban landscape, Geographic knowledge data base, e-GEO-government, Geographic Web-services, Sharing geo-databases, Geographic mailing, Geo-related workflows},
 note = {Part Special Issue: Urban Data Management Society},
 number = {6},
 pages = {609-621},
 title = {Geocoded information incorporated into urban online services—the approach of the City of Vienna},
 url = {https://www.sciencedirect.com/science/article/pii/S0198971503000176},
 volume = {27},
 year = {2003}
}
