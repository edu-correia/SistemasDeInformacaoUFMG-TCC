@inproceedings{5159206,
 abstract = {When small and medium enterprises (SMEs) engage in collaborations, they typically rely on E-mail based communication due to limited access to modern technology. One of the key factors to enhance SME collaboration is enabling semantic interoperability at the level of emails and documents that are exchanged between collaborating enterprises. However, achieving semantic interoperability is not an easy task to accomplish. Automatic interpretation of information relies on pre-defined static ontologies shared by diverse enterprises, which in practice is difficult to establish because of the specialized nature of products and services offered by each enterprise. In this background, this paper presents an agent-based negotiation approach for enabling semantic alignment of concepts, and thus facilitating semantic interoperability between SMEs to enhance collaboration.},
 author = {Wajid, Usman and Marin, Cesar A.},
 booktitle = {2009 18th IEEE International Workshops on Enabling Technologies: Infrastructures for Collaborative Enterprises},
 doi = {10.1109/WETICE.2009.37},
 issn = {1524-4547},
 keyword = {Protocols;Ontologies;Collaborative work;Costs;International collaboration;Electronic mail;Business communication;Standards development;XML;Merging;agent interactions;agents;interaction protocols;semantic alignment;enterprise interoperability},
 month = {June},
 number = {},
 pages = {13-18},
 title = {Enhancing Enterprise Collaboration Using a Protocol for Semantic Alignment},
 volume = {},
 year = {2009}
}
