@conference{Zogla2015445,
 abstract = {There are many reasons to maintain high quality data in databases and other structured data sources. High quality data ensures better discovery, automated data analysis, data mining, migration and re-use. However, due to human errors or faults in data systems themselves data can become corrupted. In this paper existing data quality problem taxonomies for structured textual data and several improvements are analysed. A new classification of data quality problems and a framework for detecting data errors both with and without data operator assistance is proposed. Copyright © 2015 SCITEPRESS - Science and Technology Publications.},
 author = {Zogla, Arturs and Meirane, Inga and Salna, Edgars},
 doi = {10.5220/0005462604450450},
 journal = {ICEIS 2015 - 17th International Conference on Enterprise Information Systems, Proceedings},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 pages = {445 - 450},
 publication_stage = {Final},
 source = {Scopus},
 title = {Analysis of data quality problem taxonomies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84939480685?origin=resultslist},
 volume = {2},
 year = {2015}
}
