@article{Xu20071269,
 abstract = {Ontology is one of the most suitable ways to express the semantics of the data. Developing ontologies from scratch is costly and tedious, extracting semantic information from existing data sources automatically is interesting. A repository of XML documents have existed around the web, thus a system for generating and publishing ontologies dynamically from XML documents is extremely expecting. In this paper, we present a framework, which constructs specialized domain ontologies by organizing and mining a set of semantic-similar XML documents and generate the RDF meta-data description for every XML document. In support of the generated ontology, semantic interoperability can become easily among multiple XML documents. Some experiments demonstrate that this method is useful to reduce human workload in semantic information acquisition.},
 author = {Xu, Jiuyun and Wang, Hongquan and Duan, Youxiang and Shi, Nianyun},
 journal = {Journal of Computational Information Systems},
 note = {Cited by: 0},
 number = {3},
 pages = {1269 - 1276},
 publication_stage = {Final},
 source = {Scopus},
 title = {Automatically bootstrapping OWL ontologies from domain-specific XML documents},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/34250725044?origin=resultslist},
 volume = {3},
 year = {2007}
}
