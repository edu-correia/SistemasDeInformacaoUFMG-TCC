@inproceedings{11318777,
 abstract = {This paper suggests a new multimodal artificial intelligence (AI) framework, which combines colposcopic imaging, genomic biomarkers, and structured clinical parameters, in order to enhance early-stage cervical cancer risk stratification. The model uses a unified deep learning network incorporating cross modal attention to extract and merge discriminative features in a cross modal manner. 5,000 records of three global cohorts were utilized, and generalizability was ensured by displaying rigorous preprocessing and 5-fold cross-validation and external validation. The multimodal solution reached up to AUC 0.96 and was significantly better than unimodal. SHAP and Grad-CAM were also applied to provide interpretability and help clinicians trust them and be transparent. Such results confirm that multimodal AI has translational effects to enhance the accuracy of screening, shorten the time to diagnosis, and scale deployment in locations with and without substantial resources.},
 author = {Rattan, Sonal and Swathi, Chilukamukku and Maram, Balajee and Nayyer, Bhavna and Chandrasekhar, M.V.B. and Gill, Satinderjit Kaur},
 booktitle = {2025 7th International Symposium on Advanced Electrical and Communication Technologies (ISAECT)},
 doi = {10.1109/ISAECT68904.2025.11318777},
 issn = {},
 keyword = {Visualization;Biological system modeling;Genomics;Imaging;Biomarkers;Feature extraction;Robustness;Bioinformatics;Artificial intelligence;Cervical cancer;Cervical Cancer;Multimodal AI;Genomic Biomarkers;Colposcopic Imaging;Risk Stratification},
 month = {Dec},
 number = {},
 pages = {1-5},
 title = {Revolutionizing Cervical Cancer Screening: A Multimodal AI Approach Using Visual, Genomic and Clinical Features},
 volume = {},
 year = {2025}
}
