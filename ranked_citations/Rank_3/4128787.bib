@inproceedings{4128787,
 abstract = {In this paper we propose an algorithm to enhance the four-to-one triangle merging connectivity in irregular meshes using a divide-and-conquer approach. Explicit remeshing by edge-flip operations into eight-triangle patches is used. This leads to an enhancement of the mesh topology which result in a significant reduction of the connectivity coding cost. We prove the effectiveness of this approach both with medical meshes with various geometry and topology and a general mesh},
 author = {Lee, Seung-woo and Prost, Remy},
 booktitle = {2006 8th international Conference on Signal Processing},
 doi = {10.1109/ICOSP.2006.344451},
 issn = {2164-523X},
 keyword = {Costs;Signal processing algorithms;Merging;Biomedical imaging;Geometry;Multiresolution analysis;Topology;Magnetic resonance imaging;Ultrasonic imaging;Data visualization},
 month = {Nov},
 number = {},
 pages = {},
 title = {Enhancement of the connectivity regularity of irregular meshes},
 volume = {1},
 year = {2006}
}
