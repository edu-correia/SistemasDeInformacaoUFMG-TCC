@inproceedings{5478128,
 abstract = {Colour images are widely used in computer applications. Uncompressed digital images require considerable storage capacity and transmission bandwidth. Efficient image compression solutions are becoming more critical with the recent growth of data intensive, multimedia-based web applications. DCT (relative to the DFT) has the advantages of real-valued, better energy compaction (much of the signal energy can be represented by only a few coefficients), experimentally observed to work well and coefficients are nearly uncorrelated. Fractal coding is a kind of VQ coding but Less than stellar compression ratio for 'good' image reconstruction. In this paper we implement colour image compression using Discrete Cosine Transform (DCT), VQ coding and a new proposed method that merges DCT and wavelet transform is implemented. Experiment results showed that the performance of new proposed algorithm is effective and can obtain very high compression ration.},
 author = {Meng, Meng and Zong, Meijuan},
 booktitle = {2010 2nd IEEE International Conference on Information Management and Engineering},
 doi = {10.1109/ICIME.2010.5478128},
 issn = {},
 keyword = {Color;Image coding;Discrete wavelet transforms;Discrete cosine transforms;Image storage;Computer applications;Digital images;Bandwidth;Application software;Compaction;ZeroTree algorithm;Discrete Cosine Transform;Vector Quantization;Image Compression},
 month = {April},
 number = {},
 pages = {339-342},
 title = {A new zerotree structure for color image compression based on DWT and VQ},
 volume = {},
 year = {2010}
}
