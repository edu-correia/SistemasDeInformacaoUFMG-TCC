@inproceedings{10576221,
 abstract = {In this study, the effectiveness of detecting strokes in their early stages is explored, particularly noting the limitations of relying solely on CT scans. By integrating CT and DW-MRI images, a more comprehensive image is generated, offering enhanced details beyond what either technique could provide independently. DW-MRI is especially noted for its superior performance in identifying acute stroke cases in comparison to CT scans. The research utilizes images from both CT and DW-MRI. The proposed algorithm is structured into four distinct phases. The initial phase involves preprocessing of both sets of images. Subsequently, the second phase aims to identify corresponding cross-sectional areas in the pathological MRI, facilitating the merging of images. The third phase is dedicated to the registration and integration of CT and MRI images. In the final, fourth phase, segmentation of the stroke lesion in the combined image is carried out. The effectiveness of this integration is evaluated based on metrics like the peak signal-to-noise ratio (PSNR) and entropy.},
 author = {Abdallatif, Munira H. and Alarbish, Amany K. and Oshah, Abdallah A. and Rgibi, Ahmed Elajeli and Oshah, Amal Apojila},
 booktitle = {2024 2nd International Conference on Electrical Engineering and Automatic Control (ICEEAC)},
 doi = {10.1109/ICEEAC61226.2024.10576221},
 issn = {},
 keyword = {Visualization;PSNR;Computed tomography;Magnetic resonance imaging;Redundancy;Wavelet analysis;Entropy;stroke;Magnetic resonance image;Computed tomography image},
 month = {May},
 number = {},
 pages = {1-6},
 title = {Detection Stroke Using DWT Based Fusion of CT And MRI Images},
 volume = {},
 year = {2024}
}
