@inproceedings{4443395,
 abstract = {From the current theories of Semantic Web and Ontology, this paper aims at exploring one way to construct, merge, map and evolve ontology in aviation product domain. Driven by its application background, the domain ontology is designed and built to support the "Auto-Mining System for Aviation Products". It merged with a Loom-based "military aircraft ontology" from USA via translating the used one from Loom to OWL. Also by referring to NASA Thesaurus, a comprehensive concept hierarchy is mapped into the domain ontology. Based on these, Protege is used to visually implement a prototype for this domain ontology. Finally, evolution is completed by auto-extraction of instances from large amount of documents in this domain.},
 author = {Ma Jing and Song Qingqing and Liu Sifeng},
 booktitle = {2007 IEEE International Conference on Grey Systems and Intelligent Services},
 doi = {10.1109/GSIS.2007.4443395},
 issn = {2166-9449},
 keyword = {Merging;Ontologies;OWL;Intelligent systems;Semantic Web;Prototypes;Logic;XML;Resource description framework;Intelligent networks},
 month = {Nov},
 number = {},
 pages = {855-859},
 title = {Research on OWL-based construction, merging, mapping and evolution of ontology in aviation product domain},
 volume = {},
 year = {2007}
}
