@article{Lu20192103,
 abstract = {As an emerging technology, the Internet of Things (IoT) revolutionized the global network comprising of people, smart devices, intelligent objects, data, and information. The development of IoT is still in its infancy and many related issues need to be solved. IoT is a unified concept of embedding everything. IoT has a great chance to make the world a higher level of accessibility, integrity, availability, scalability, confidentiality, and interoperability. However, how to protect IoT is a challenging task. System security is the foundation for the development of IoT. This article systematically reviews IoT cybersecurity. The key considerations are the protection and integration of heterogeneous smart devices and information communication technologies (ICT). This review provides useful information and insights to researchers and practitioners who are interested in cybersecurity of IoT, including the current research of IoT cybersecurity, IoT cybersecurity architecture and taxonomy, key enabling countermeasures and strategies, major applications in industries, research trends and challenges. © 2014 IEEE.},
 author = {Lu, Yang and Xu, Li Da},
 doi = {10.1109/JIOT.2018.2869847},
 journal = {IEEE Internet of Things Journal},
 note = {Cited by: 516},
 number = {2},
 pages = {2103 - 2115},
 publication_stage = {Final},
 source = {Scopus},
 title = {Internet of things (IoT) cybersecurity research: A review of current research topics},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85053322833?origin=resultslist},
 volume = {6},
 year = {2019}
}
