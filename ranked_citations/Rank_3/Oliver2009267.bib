@conference{Oliver2009267,
 abstract = {Space-based computing environments are based around numerous, discrete sets of information with internal reasoning, interaction and semantics. These spaces of information can be treated as first-class entities and thus have direct interactions between themselves as spaces. We develop and formalise a simple set of base operations between individual spaces that preserves the integrity of the information contained within those spaces through larger grained semantic structures (eg: RDF molecules) and historical information about past interactions. We then show how this forms the basis of extended and possible-world queries and how such features are manifested in common scenarios. © 2009 IEEE.},
 author = {Oliver, Ian and Boldyrev, Sergey},
 doi = {10.1109/ICSC.2009.102},
 journal = {ICSC 2009 - 2009 IEEE International Conference on Semantic Computing},
 note = {Cited by: 11},
 pages = {267 - 274},
 publication_stage = {Final},
 source = {Scopus},
 title = {Operations on spaces of information},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/73449137537?origin=resultslist},
 year = {2009}
}
