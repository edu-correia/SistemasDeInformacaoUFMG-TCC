@conference{Liu2008655,
 abstract = {With loosely coupled Web services, service-oriented applications and processes could be composite and dynamic and change service providers based on the criteria such as price, reliability, security, credit, or the elements' weighted utilities. A precise service search engine is critical for the loosely coupled applications to select emerging Web services regularly, automatically, across the Internet. Based on a developed collaborative platform for service-oriented software engineering, this paper reports an improvement to the platform by adding an ontology-based semantic service search engine, to implement automatic service discovery. The discovery service uses a matrix of description elements for search precision, uses semantic dictionary for intelligence and self-learning, and uses meta-search techniques to improve search scope. The service search engine utilizes search capability of multiple search engines and Web services registration services. © 2008 IEEE.},
 author = {Liu, Gang and Wu, Xiaoyan and Tang, Enmei and Liang, Ianhui and Li, Yinsheng},
 doi = {10.1109/ICEBE.2008.99},
 journal = {IEEE International Conference on e-Business Engineering, ICEBE'08 - Workshops: AiR'08, EM2I'08, SOAIC'08, SOKM'08, BIMA'08, DKEEE'08},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {655 - 659},
 publication_stage = {Final},
 source = {Scopus},
 title = {A service-oriented development platform with precise service discovery},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/58149088110?origin=resultslist},
 year = {2008}
}
