@inproceedings{7401702,
 abstract = {In this paper, new recoding methods for fully pipelined parallel CORDIC (COordinate Rotation DIgital Computer) are proposed. By employing new proposed MAR (Micro-rotation to Angle Recoding), fully pipelined parallel CORDIC rotation schemes can be obtained so that they can reduce the bottleneck of conventional parallel CORDIC rotators which have two separate micro-rotation stages. Although our proposed methods would produce more micro-ration stages compared with previous methods, these stages can be further merged to save area costs and to enhance the overall performance of CORDIC rotations. Our proposed methods can be applied to sine/cosine generators, DDFS (Direct Digital Frequency Synthesizer) and other related applications for fast computations.},
 author = {Juang, Tso-Bing and Chiu, Chin-Chieh},
 booktitle = {2015 International SoC Design Conference (ISOCC)},
 doi = {10.1109/ISOCC.2015.7401702},
 issn = {},
 keyword = {Computers;Circuits and systems;Computer science;Cities and towns;Frequency synthesizers;Approximation error;Generators;CORDIC;computer arithmetic;VLSI;sine/cosine generation},
 month = {Nov},
 number = {},
 pages = {291-292},
 title = {New recoding methods for fully pipelined parallel CORDIC rotations},
 volume = {},
 year = {2015}
}
