@article{Saleemi2013198,
 abstract = {This paper presents a novel framework for tracking thousands of vehicles in high resolution, low frame rate, multiple camera aerial videos. The proposed algorithm avoids the pitfalls of global minimization of data association costs and instead maintains multiple object-centric associations for each track. Representation of object state in terms of many to many data associations per track is proposed and multiple novel constraints are introduced to make the association problem tractable while allowing sharing of detections among tracks. Weighted hypothetical measurements are introduced to better handle occlusions, mis-detections and split or merged detections. A two-frame differencing method is presented which performs simultaneous moving object detection in both. Two novel contextual constraints of vehicle following model, and discouragement of track intersection and merging are also proposed. Extensive experiments on challenging, ground truthed data sets are performed to show the feasibility and superiority of the proposed approach. Results of quantitative comparison with existing approaches are presented, and the efficacy of newly introduced constraints is experimentally established. The proposed algorithm performs better and faster than global, 1-1 data association methods. © 2013 Springer Science+Business Media New York.},
 author = {Saleemi, Imran and Shah, Mubarak},
 doi = {10.1007/s11263-013-0624-1},
 journal = {International Journal of Computer Vision},
 note = {Cited by: 82; All Open Access; Green Open Access},
 number = {2},
 pages = {198 - 219},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multiframe many-many point correspondence for vehicle tracking in high density wide area aerial videos},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84881139950?origin=resultslist},
 volume = {104},
 year = {2013}
}
