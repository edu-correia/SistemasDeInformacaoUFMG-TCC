@conference{Blanas2013,
 abstract = {High-performance analytical data processing systems often run on servers with large amounts of main memory. A common operation in such environments is combining data from two or more sources using some "join" algorithm. The focus of this paper is on studying hash-based and sort-based equi-join algorithms when the data sets being joined fully reside in main memory. We only consider a single node setting, which is an important building block for larger high-performance distributed data processing systems. A critical contribution of this work is in pointing out that in addition to query response time, one must also consider the memory footprint of each join algorithm, as it impacts the number of concurrent queries that can be serviced. Memory footprint becomes an important deployment consideration when running analytical data processing services on hardware that is shared by other concurrent services. We also consider the impact of particular physical properties of the input and the output of each join algorithm. This information is essential for optimizing complex query pipelines with multiple joins. Our key contribution is in characterizing the properties of hash-based and sort-based equi-join algorithms, thereby allowing system im-plementers and query optimizers to make a more informed choice about which join algorithm to use.},
 author = {Blanas, Spyros and Patel, Jignesh M.},
 doi = {10.1145/2523616.2523626},
 journal = {Proceedings of the 4th Annual Symposium on Cloud Computing, SoCC 2013},
 note = {Cited by: 8},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Memory footprint matters: Efficient equi-join algorithms for main memory data processing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84893242761?origin=resultslist},
 year = {2013}
}
