@conference{Bolchini200648,
 abstract = {This paper focuses on information representation and tailoring problems and on the definition of the global architecture of a novel system, named Context-ADDICT. It can deal with data filtering in a context-aware fashion, integration of previously unknown data sources, automatic extraction of their semantics. The system we are designing aims at tailoring the available information to the needs of the current user in the current context, to offer a more manageable amount of information; such information is to be cached on the user's device according to policies defined at design-time, to cope with data source transiency.},
 author = {Bolchini, C. and Curino, C. and Schreiber, F.A. and Tanca, L.},
 journal = {SEBD 2006 - Proceedings of the 14th Italian Symposium on Advanced Databases Systems},
 note = {Cited by: 17},
 pages = {48 - 55},
 publication_stage = {Final},
 source = {Scopus},
 title = {Context integration for mobile data tailoring},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78650726829?origin=resultslist},
 year = {2006}
}
