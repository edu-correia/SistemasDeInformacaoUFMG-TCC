 abstract = {OLED technology has been developed well as its applications extend to innovative lighting solutions. The development of organic compounds has led to OLEDs with incredible durability and energy efficiency, resulting in environmentally friendly lighting solutions. Academic research finds a vital role towards the challenges of OLED technology. The present work consists in studying the performance characteristics of a reference architecture (ITO/NPD/Alq3/Ca) and two modified architectures (ITO/NPD/BCP/Ca and ITO/NPD/Bphen/Ca). Our systematic approach is based on experimental measurements and numerical simulations to study the optoelectronic properties of these devices. The reliability of our model is confirmed by the correlation between simulated and experimental current-voltage (I-V) characteristics. The ITO/NPD/Bphen/Ca structure outperformed the other configurations, achieving maximum luminescence of $1135 \text{Cd} / \mathrm{m}^{2}$, radiance of $8.9 \mathrm{W} /\left(\text{sr}-\mathrm{m}^{2}\right)$, and a recombination rate of $6.3 \times \mathbf{1 0}^{\mathbf{1 8}} / \mathbf{c m}^{\mathbf{3}} \mathbf{s}$. Temperature and organic layer thickness are determinant parameters regarding OLED efficiency, with thicker layers generating higher voltage and lower current. Structural features are crucial for improving device efficiency, and the synergy between simulation and experiment proves to be a didactic methodology to understand OLED operation. This contributes to the progress of advanced lighting and display systems.},
 author = {Jleli, Sourour and Mbarki, Ghada and El Housseiny, Houssein and Oussalah, Slimane and Renaud, Cedric and Buso, David and Khalfaoui, Mohamed},
 booktitle = {2025 IEEE Sustainable Smart Lighting World Conference & Expo (LS25)},
