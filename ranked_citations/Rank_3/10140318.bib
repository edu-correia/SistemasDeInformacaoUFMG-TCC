 doi = {10.1109/ICAAIC56838.2023.10140318},
 issn = {},
 keyword = {Cloud computing;Smart cities;Computer network reliability;Wearable computers;Spread spectrum communication;Trust management;Task analysis;Internet Of Things;Edge Computing;Smart City;Offloading;Multi-Feedback},
 month = {May},
