@conference{Chen202553,
 abstract = {This paper addresses the multi-objective resource optimization problem for hybrid assembly lines. We aim to find an initial resource allocation scheme that balances three objectives: minimizing the total cost and total number of operators, and maximizing the system throughput, while satisfying a set of constraints. To address this issue, we establish a hybrid assembly line model based on Petri nets and propose an improved NSGAII. The improved NSGA-II combined with local enhancement strategy (LES-NSGA-II) is designed to solve the multi-objective problem, aiming to obtain a Pareto front and determining the optimal resource allocation solution. Finally, LES-NSGA-II is validated and compared with classical NSGA-II and SPEA2 through a case study of a real hybrid assembly line. The results indicate that the proposed algorithm effectively fills the sparse regions of the Pareto front, demonstrating advantages in terms of convergence, solution quality, and exploration breadth.  © 2025 IEEE.},
 author = {Chen, Wenjie and He, Zhou},
 doi = {10.1109/MEMAT68155.2025.11434397},
 journal = {2025 International Conference on Mechanical Engineering, Intelligent Manufacturing, and Automation Technology, MEMAT 2025},
 note = {Cited by: 0},
 pages = {53 - 57},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi-Objective Resource Optimization of Hybrid Assembly Line Based on Improved NSGA-II},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105036209343?origin=resultslist},
 year = {2025}
