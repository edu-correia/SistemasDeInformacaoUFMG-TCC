@conference{Gray2005179,
 abstract = {We present a publish/subscribe framework for integrating data streams published by distributed producers. We introduce the idea of republishers which merge a set of data streams, either from producers or other republishers. The resulting hierarchy of producers and republishers can then be used to answer consumer queries over the streams. We discuss how to compute query plans to create such a hierarchy and the maintenance of these plans when the set of streams changes. © Springer-Verlag Berlin Heidelberg 2005.},
 author = {Gray, Alasdair J. G. and Nutt, Werner},
 doi = {10.1007/11511854_17},
 journal = {Lecture Notes in Computer Science},
 note = {Cited by: 1},
 pages = {179 - 184},
 publication_stage = {Final},
 source = {Scopus},
 title = {Republishers in a publish/subscribe architecture for data streams},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/26444528442?origin=resultslist},
 volume = {3567},
 year = {2005}
}
