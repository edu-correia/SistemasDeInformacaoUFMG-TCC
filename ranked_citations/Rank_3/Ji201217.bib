@conference{Ji201217,
 abstract = {With the rapid growth of emerging applications like social network analysis, semantic Web analysis and bioinformatics network analysis, a variety of data to be processed continues to witness a quick increase. Effective management and analysis of large-scale data poses an interesting but critical challenge. Recently, big data has attracted a lot of attention from academia, industry as well as government. This paper introduces several big data processing technics from system and application aspects. First, from the view of cloud data management and big data processing mechanisms, we present the key issues of big data processing, including cloud computing platform, cloud architecture, cloud database and data storage scheme. Following the Map Reduce parallel processing framework, we then introduce Map Reduce optimization strategies and applications reported in the literature. Finally, we discuss the open issues and challenges, and deeply explore the research directions in the future on big data processing in cloud computing environments. © 2012 IEEE.},
 author = {Ji, Changqing and Li, Yu and Qiu, Wenming and Awada, Uchechukwu and Li, Keqiu},
 doi = {10.1109/I-SPAN.2012.9},
 journal = {Proceedings of the 2012 International Symposium on Pervasive Systems, Algorithms, and Networks, I-SPAN 2012},
 note = {Cited by: 276},
 pages = {17 - 23},
 publication_stage = {Final},
 source = {Scopus},
 title = {Big data processing in cloud computing environments},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84874615486?origin=resultslist},
 year = {2012}
}
