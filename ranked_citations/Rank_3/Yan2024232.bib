@article{Yan2024232,
 abstract = {Autonomous following robots hold significant importance across various scenarios, and identifying the target to follow is a focal point of study. Consequently, object detection based on deep learning comes into our view. The basic YOLO model does not specifically address the issues of localization and lightweight architecture. To precisely identify and localize the target for tracking, we design an object detection algorithm named PLOD-YOLO. This method not only decreases the parameter but also boosts the algorithm’s performance. First, to enhance the network’s ability to perceive spatial features, we design a reinforced blanket attention module(RBAM), which can extract multidimensional information from the feature map. Secondly, to reinforce the low-level spatial information and tackle the challenge of variations in target scale, we devise a multi-scale feature fusion method Location Merge BiFPN (LM-BiFPN). Subsequently, to align the classification and localization subtasks and reduce the parameter of the detection head, we design an innovative Dynamic Task-aligned Head (DT-Head). Lastly, to improve the model’s robustness and adapt to various tracking tasks, we integrated the latest two IoU calculation methods to form the inner-shape-IoU. Experiment results indicate that our PLOD-YOLO achieved an AP@.5 of 77.4% on the WiderPerson dataset, which represents a 2.1% improvement over YOLOv8n while reducing the parameter by 12%. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2024.},
 author = {Yan, Zhe and Deng, Wenqing and Hu, Bo and Zhao, Chen and Zhang, WeiJie and Dong, Zhiyan and Zhang, Lihua},
 doi = {10.1007/978-981-97-5591-2_20},
 journal = {Lecture Notes in Computer Science},
 note = {Cited by: 0},
 pages = {232 - 244},
 publication_stage = {Final},
