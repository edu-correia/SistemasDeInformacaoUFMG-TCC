@article{JerezLazcano2025_361,
 abstract = {Abstract: The design phase of high-rise building projects faces significant challenges, such as frequent changes, low productivity, and poor coordination between teams, which negatively impact project performance. This research analyzes how the integration of Lean, Agile, and BIM can address these challenges to improve planning and management during design. The methodology included identifying relevant BIM uses for design phase management, verifying case studies in high-rise construction, comparing Lean and Agile functionalities through key parameters, and evaluating the benefits and barriers to implementation. The results show that BIM provides essential tools for effective management, facilitating coordination and information integration, while Lean and Agile complement this management by improving planning, collaboration, and adaptability. In summary, the combination of these methods offers a robust framework to tackle the challenges of the design phase in high-rise buildings, such as interdisciplinary coordination and resource optimization, enabling more accurate planning, better decision-making, and more efficient execution.},
 author = {Jerez Lazcano, Javiera and Castañeda, Karen and Herrera, Rodrigo F.},
 doi = {10.7764/ric.00165.21},
 number = {especial},
 pages = {0104--0104},
 title = {Lean, Agile, and BIM relationships in the design of high-rise building projects},
 volume = {40},
 year = {2025}
}
