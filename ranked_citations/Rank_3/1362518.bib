@article{1362518,
 abstract = {Since the input format of video sources into a video processor can be quite different, for example, maybe film-mode source or interlaced TV video images, and they should be handled separately. Whereas fields merge (weave) method with correct field sequence is the best de-interlacing algorithm for film-mode source video, the incorporation of spatial, temporal, and low-angle edge detection/interpolation methods should be used for interlaced TV video images in order to obtain the best quality visual images. In this paper, a robust film-mode source detection method with layered structure to improve the correction rate of detection is used to separate the film-mode source from the interlaced TV video images, and abnormal sequence correction method also is proposed to guarantee the correction of weaving sequence. And, from the simulation results, it can be seen that the proposed algorithm can correctly detect the 3:2 pulldown film-mode source images and perform the field merge with correct field sequence.},
 author = {Chao-Chee Ku and Ren-Kuan Liang},
 doi = {10.1109/TCE.2004.1362518},
 issn = {1558-4127},
 journal = {IEEE Transactions on Consumer Electronics},
 keyword = {Robustness;TV;Displays;Chaos;Image edge detection;Interpolation;Weaving;DVD;Graphics;Animation},
 month = {Nov},
 number = {4},
 pages = {1190-1193},
 title = {Robust layered film-mode source 3:2 pulldown detection/correction},
 volume = {50},
 year = {2004}
}
