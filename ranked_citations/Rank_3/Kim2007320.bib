@article{Kim2007320,
 abstract = {This paper focuses on the derivation of the message complexity when two mobile ad hoc network (MANET) groups merge together, where the network groups already have been configured with IP addresses by using address autoconfiguration protocols (AAPs). The message complexity of the MANET group merging case (GMC) in Strong DAD, Weak DAD with proactive routing protocols (WDP), Weak DAD with on-demand routing protocols (WDO), and MANETconf has been derived respectively. In order to verify the derived bounds, analytical simulations that quantify the message complexity of the address autoconfiguration process based on the different conflict probabilities are conducted. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Kim, Sang-Chul},
 doi = {10.1007/978-3-540-72590-9_45},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0; All Open Access; Bronze Open Access},
 number = {PART 4},
 pages = {320 - 327},
 publication_stage = {Final},
 source = {Scopus},
 title = {Message complexity analysis of MANET address autoconfiguration algorithms in group merging case},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/38149135075?origin=resultslist},
 volume = {4490 LNCS},
 year = {2007}
}
