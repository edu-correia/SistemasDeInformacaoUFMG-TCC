@inproceedings{1471624,
 abstract = {This paper proposes a nonlinear oscillator network LSI for image region extraction as a preprocessing of intelligent image recognition. The processing can be achieved by using the nonlinear characteristics of a nonlinear oscillator. The proposed circuit has been designed using a merged/mixed analog-digital CMOS circuit architecture that includes pulse modulation circuits and digital logic and memory circuits. An LSI fabricated using a 0.35 µm CMOS technology demonstrates the basic operation of image region extraction. The processing time will be on the order of sub-milliseconds with a maximum operation frequency.},
 author = {Ando, H. and Morie, T. and Nagata, M. and Iwata, A.},
 booktitle = {Proceedings of the 28th European Solid-State Circuits Conference},
 doi = {},
 issn = {},
 keyword = {Large scale integration;Oscillators;CMOS logic circuits;CMOS technology;Intelligent networks;Image recognition;Analog-digital conversion;CMOS digital integrated circuits;CMOS analog integrated circuits;CMOS memory circuits},
 month = {Sep.},
 number = {},
 pages = {703-706},
 title = {An image region extraction LSI based on a merged/mixed-signal nonlinear oscillator network circuit},
 volume = {},
 year = {2002}
}
