@article{9091911,
 abstract = {Although image denoising as a basic task of image restoration has been widely studied in the past decades, there are not many studies on mixed noise denoising. In this paper, we propose two structured dictionary learning models to recover images corrupted by mixed Gaussian and impulse noise. These two models can be merged as lp-norm fidelity plus lq-norm regularization. The fidelity term is used to fit image patches and the regularization term is employed for sparse coding. Particularly, we utilize proximal (and proximal linearized) alternating minimization methods as the main solvers to deal with these two models. We remove the Gaussian noise under the assumption that the uncorrupted image can be approximated with a linear representation under an appropriate orthogonal basis. We use different ways to remove impulse noise for these two models. The experimental results are reported to compare the existing methods and demonstrate the performance of the proposed denoising model is better than the other existing methods in terms of some quality assessment metrics.},
 author = {Zhu, Hong and Ng, Michael K.},
 doi = {10.1109/TIP.2020.2992895},
 issn = {1941-0042},
 journal = {IEEE Transactions on Image Processing},
 keyword = {Noise reduction;Dictionaries;Machine learning;Gaussian noise;Computational modeling;Image denoising;Image restoration;Image denoising;image enhancement;image restoration;noise;Gaussian noise;impulse noise},
 month = {},
 number = {},
 pages = {6680-6693},
 title = {Structured Dictionary Learning for Image Denoising Under Mixed Gaussian and Impulse Noise},
 volume = {29},
 year = {2020}
}
