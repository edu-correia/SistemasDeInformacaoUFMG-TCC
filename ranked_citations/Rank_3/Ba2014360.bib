@article{Ba2014360,
 abstract = {We study in this vision paper the problem of integrating several web data sources under uncertainty and dependencies. We present a concrete application with web sources about objects in the maritime domain where uncertainties and dependencies are omnipresent. Uncertainties are mainly caused by imprecise information trackers and imperfect human knowledge. Dependencies come from the recurrent copying relationships occurring among the sources. We answer the issue of data integration in such a setting by reformulating it as the merge of several uncertain versions of the same global XML document. As an initial result, we put forward a probabilistic XML data integration model by getting some intuitions from the versioning model with uncertain data we proposed in [5]. We explain how this model can be used for materializing the integration outcome. © 2014 Springer-Verlag Berlin Heidelberg.},
 author = {Ba, M. Lamine and Montenez, Sebastien and Tang, Ruiming and Abdessalem, Talel},
 doi = {10.1007/978-3-662-43984-5_28},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 6},
 pages = {360 - 375},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integration of web sources under uncertainty and dependencies using probabilistic XML},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84958525683?origin=resultslist},
 volume = {8505 LNCS},
 year = {2014}
}
