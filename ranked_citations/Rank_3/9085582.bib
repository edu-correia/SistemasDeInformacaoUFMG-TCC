@inbook{9085582,
 abstract = {In recent years, a noticeable upswing has occurred in linguistic annotation activity, which has expanded to cover a wide variety of linguistic phenomena. At the same time, the number and size of linguistically annotated language resources has increased dramatically, together with a proliferation of annotation tools to support the creation and storage of labeled data, various means for collaborative and distributed annotation efforts, and the introduction of crowdsourcing mechanisms, such as Amazon Mechanical Turk. All of this has created a need to manage and sustain these resources, as well as to find ways to enable them to be repeatedly reused and merged with other resources.},
 author = {Pareja-Lora, Antonio and Blume, María and Lust, Barbara C. and Chiarcos, Christian and Chiarcos, Christian and Pareja-Lora, Antonio and Langendoen, D. Terence and Ide, Nancy and Moran, Steven and Warburton, Kara and Wright, Sue Ellen and Trippel, Thorsten and Zinn, Claus and Simons, Gary and Bird, Steven and Ratner, Nan Bernstein and MacWhinney, Brian and Blume, María and Flynn, Suzanne and Foley, Claire and Caldwell, Ted and Reidy, James and Masci, Jonathan and Lust, Barbara C. and Barrière, Isabelle and Dye, Cristina and Kang, Carissa and Rieger, Oya},
 booktitle = {Development of Linguistic Linked Open Data Resources for Collaborative Data-Intensive Research in the Language Sciences},
