@inproceedings{10838901,
 abstract = {Smart manufacturing refers to manufacturing systems composed of automatic processes interconnected through the internet of things. Likewise, a smart factory is a core concept of smart manufacturing that refers to an automatic production system that is fully connected, where data is collected and analyzed to make informed decisions. Moreover, smart factories are based on the coexistence of a physical and virtual factory. Hence, the development of a cyber-physical production system framework to merge the physical and virtual factory is motivated. This manuscript describes the integration of a supervisory control and data acquisition system with a factory digital twin, which allows production floor remote data gathering, scheduling optimization, and production floor machines remote control. A scenario of a painting shop is presented to illustrate the performance of the cyber-physical production systems framework. The results exemplify the potential benefits to the decision-making process when implementing the proposed framework.},
 author = {Renteria-Marquez, Ivan Arturo and Garcia Marquez Basaldua, Jose Carlos and Aguirre, Oswaldo and Lara-Medrano, Bryan Eduardo and Tseng, Tzu-Liang Bill},
 booktitle = {2024 Winter Simulation Conference (WSC)},
 doi = {10.1109/WSC63780.2024.10838901},
 issn = {1558-4305},
 keyword = {Job shop scheduling;Decision making;SCADA systems;Production;Virtual manufacturing;Floors;Remote control;Optimization;Smart manufacturing;Painting},
 month = {Dec},
 number = {},
 pages = {1740-1748},
 title = {Cyber-Physical Production System Framework for Production Scheduling in Smart Factories},
 volume = {},
 year = {2024}
}
