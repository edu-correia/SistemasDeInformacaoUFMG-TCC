@conference{Henseler2013112,
 abstract = {With the pervasiveness of computers and mobile devices, digital forensics becomes more important in law enforcement. Detectives increasingly depend on the scarce support of digital specialists which impedes efficiency of criminal investigations. This paper proposes and algorithm to extract, merge and rank identities that are encountered in the electronic evidence during processing. Two experiments are described demonstrating that our approach can assist with the identification of frequently occurring identities so that investigators can prioritize the investigation of evidence units accordingly. © 2013 IEEE.},
 author = {Henseler, Hans and Hofste, Jop and Van Keulen, Maurice},
 doi = {10.1109/EISIC.2013.24},
 journal = {Proceedings - 2013 European Intelligence and Security Informatics Conference, EISIC 2013},
 note = {Cited by: 4; All Open Access; Green Open Access},
 pages = {112 - 116},
 publication_stage = {Final},
 source = {Scopus},
 title = {Digital-Forensics based pattern recognition for discovering identities in electronic evidence},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84892154805?origin=resultslist},
 year = {2013}
}
