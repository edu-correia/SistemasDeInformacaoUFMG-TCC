@inproceedings{10185301,
 abstract = {This paper presents a source-driver IC for mobile OLED displays. The proposed 3-stage-cascaded 10-bit DAC fully exploits compactness benefit of multi-step interpolation. The overlap-switch merging (OSM) method allows for a 47% size-reduction in the 2-output R-DAC. The SAR-interpolating SC (SI-SC) DAC with bit-adaptive switch size (BASS) modulation is designed to obtain 2-output without switching errors. The proposed super-OTA buffer not only offers a fast slew-rate, but it also performs accurate 1-bit true-DC interpolation The SD-IC fabricated in 180nm shows the smallest area $(132.4 \times 16.7~\mu \mathrm{m}^{2}/\mathrm{Ch})$ and the best slew-rate FoM (2470.6) reported to date.},
 author = {Shin, Seunghwa and Kang, Gyeong-Gu and Lim, Gyu-Wan and Kim, Hyun-Sik},
 booktitle = {2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)},
 doi = {10.23919/VLSITechnologyandCir57934.2023.10185301},
 issn = {2158-9682},
 keyword = {Interpolation;Merging;Modulation;Switches;Very large scale integration;Organic light emitting diodes},
 month = {June},
 number = {},
 pages = {1-2},
 title = {A Mobile OLED Source-Driver IC featuring Ultra-Compact 3-Stage-Cascaded 10-Bit DAC and 42V/μs-Slew-Rate True-DC-Interpolative Super-OTA Buffer},
 volume = {},
 year = {2023}
}
