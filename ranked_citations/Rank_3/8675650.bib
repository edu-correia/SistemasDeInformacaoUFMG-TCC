@inproceedings{8675650,
 abstract = {This paper discusses an optimized method of terminal nodes integration that belongs to two merged and reorganized companies. The optimization process, prioritized under the process of merging and reorganization, is designed in accordance with the rules of economics and charasteristics of express delivery networks. Subsequently, a mathematical model of optimization of terminal networks integration is formulated and tested. According to our experiment results, the resulting cost can be efficiently obtained by choosing the smallest cost from the process outcome.},
 author = {Wei, Wang and Rahman, Md. Arafatur and Kurniawan, Ibnu Febry and Asyhari, A. Taufiq and Sadat, S M Nazmus and Yao, Liu},
