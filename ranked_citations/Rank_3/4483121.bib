@inproceedings{4483121,
 abstract = {A mobile ad-hoc network (MANET) is a group of mobile hosts communicating with each other via wireless links without infrastructure. Dynamic and distributed network operations are desirable for deploying MANETs due to host mobility. Many schemes have been proposed for address generation and configuration but these are without their problems. In this paper we evaluate the mechanisms of our conflict free address configuration protocol in comparison to other existing MANET auto configuration protocols. Also, we present the main distributed algorithm for new host address configuration and MANETs merging. Finally, we evaluate the protocol to demonstrate the applicability of the approach.},
 author = {Indrasinghe, Sudath and Pereira, Rubem and Haggerty, John},
 booktitle = {22nd International Conference on Advanced Information Networking and Applications - Workshops (aina workshops 2008)},
 doi = {10.1109/WAINA.2008.108},
 issn = {},
 keyword = {Mobile ad hoc networks;Ad hoc networks;Mobile computing;Routing protocols;Wireless application protocol;Computer networks;Distributed algorithms;Merging;Mobile communication;Network servers;Ad-hoc;Address;Protocol Specification},
 month = {March},
 number = {},
 pages = {1434-1439},
 title = {Protocol Specification for Conflict Free MANET Address Allocation Mechanisms},
 volume = {},
 year = {2008}
}
