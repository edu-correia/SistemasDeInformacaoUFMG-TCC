 issn = {2833-2350},
 keyword = {Measurement;Planets;Urban areas;Symbols;Telephone sets;Robustness;Telecommunications;CISK Model;NCCIC - National Cybersecurity and Communications Integration Center;NICC National – Infrastructure Coordinating Center;Risk Management;Verizon Telecom},
