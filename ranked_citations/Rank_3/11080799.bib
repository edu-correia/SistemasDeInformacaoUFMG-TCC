@inproceedings{11080799,
 abstract = {Protecting cultural heritage in museums necessitates the use of advanced fire suppression technologies to shield irreplaceable artifacts from damage caused by fire and traditional extinguishing methods. This paper examines the integration of acoustic fire suppression technology with the Internet of Things (IoT) to safeguard historical items in museums. Acoustic fire extinguishers use low-frequency sound waves (30-60 Hz) to disrupt combustion without requiring water, chemicals, or physical contact, ensuring the safety of fragile objects. The suggested IoT-enabled system improves on existing technologies by including real-time fire detection sensors, thermal imaging, and automated control units. These components provide precise targeting and early intervention, while IoT connectivity enables remote monitoring and alarms, allowing for rapid response during emergencies. The strategy is intended to minimize damage to artifacts by concentrating suppression efforts on damaged places. By merging non-invasive acoustic methodologies with IoT-driven automation, our technology provides a sustainable, efficient, and artifact-safe alternative to traditional fire suppression methods. The study emphasizes the unique system's potential to improve fire safety standards in museum settings, saving precious historical relics from both fire and extinguishing-related damage.},
 author = {Selvaraj, Kailasam and Perumal, M. Kubendra and Akash, C.Renga and Kumar, V. Madhan and Sobika, M. and Suruthi, S.},
 booktitle = {2025 3rd International Conference on Self Sustainable Artificial Intelligence Systems (ICSSAS)},
 doi = {10.1109/ICSSAS66150.2025.11080799},
 issn = {},
 keyword = {Technological innovation;Thermal sensors;Museums;Acoustics;Sensor systems;Real-time systems;Internet of Things;Standards;Remote monitoring;Fire safety;Museum fire safety;acoustic fire suppression;the Internet of Things (IoT);historical item protection;innovation;and case studies},
 month = {June},
 number = {},
 pages = {111-116},
 title = {Safeguarding Heritage: Acoustic Fire Suppression with IoT for Museum Applications},
 volume = {},
