@article{Shih2005877,
 abstract = {In this paper, we present an automatic seeded region growing algorithm for color image segmentation. First, the input RGB color image is transformed into YC<sub>b</sub>C<sub>r</sub> color space. Second, the initial seeds are automatically selected. Third, the color image is segmented into regions where each region corresponds to a seed. Finally, region-merging is used to merge similar or small regions. Experimental results show that our algorithm can produce good results as favorably compared to some existing algorithms. © 2005 Elsevier B.V. All rights reserved.},
 author = {Shih, Frank Y. and Cheng, Shouxian},
 doi = {10.1016/j.imavis.2005.05.015},
 journal = {Image and Vision Computing},
 note = {Cited by: 358},
 number = {10},
 pages = {877 - 886},
 publication_stage = {Final},
 source = {Scopus},
 title = {Automatic seeded region growing for color image segmentation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/23844459230?origin=resultslist},
 volume = {23},
 year = {2005}
}
