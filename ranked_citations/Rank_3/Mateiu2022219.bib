@conference{Mateiu2022219,
 abstract = {We propose an automated method and tool for learning ontologies from data. We rely on Relational Concept Analysis (an extension of Formal Concept Analysis) to learn concepts with their instances, relations between these concepts, and properties of these relations, such as symmetry, transitivity and reflexivity. The learned model is formalised in Description Logics. In addition, since we have access to all learned axioms, the learned model is a white box one.  © 2022 IEEE.},
 author = {Mateiu, Patricia and Groza, Adrian and Nica, Cristina},
 doi = {10.1109/SAMI54271.2022.9780837},
 journal = {SAMI 2022 - IEEE 20th Jubilee World Symposium on Applied Machine Intelligence and Informatics, Proceedings},
 note = {Cited by: 2},
 pages = {219 - 224},
 publication_stage = {Final},
 source = {Scopus},
 title = {Learning Ontologies with Relational Concept Analysis},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85132168412?origin=resultslist},
 year = {2022}
}
