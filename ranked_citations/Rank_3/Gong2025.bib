@article{Gong2025,
 abstract = {Identifying code authors is essential in many research topics, and various approaches have been proposed. Recent studies show that the temporal effect can significantly affect existing approaches: their trained models rapidly become outdated and ineffective due to the evolution of code styles over time. To our knowledge, only a recent approach tries to alleviate the temporal effect. This approach treats the temporal effect problem as a cross-domain problem and uses domain adaptation to reduce the temporal effect. Although this approach achieves promising results on their datasets, the evaluation of this approach shows that the effectiveness of transferred models decreases with the increasing intervals between the source and the target domains. In addition, an author can have much more or fewer files in real development. A recent study shows that the effectiveness of existing approaches is significantly reduced if they are evaluated on imbalanced data. This paper proposes a novel approach to combat the temporal effect. In actual development, source files accumulate over time, and trained models should be continuously updated with continuous data. Based on this insight, we use chunk-based incremental learning. In particular, we treat the accumulated source files as data streams, and each incoming batch of data is treated as a chunk. With this concept, we utilize an ensemble framework to maintain an ensemble of base classifiers that are incrementally trained on incoming chunks of data. We adopt the under bagging method to handle the class imbalance problem. It conducts downsampling to majority classes at each iteration. We evaluate the effectiveness of our approach using two datasets of programs written in C++ and Java. Compared to the previously published domain adaptation-based approach, our approach improves the average accuracy from 0.7343 to 0.9017 on the Java dataset and from 0.8016 to 0.9022 on the C++ dataset. In addition, we compare them on two imbalanced datasets in C++ and Java. The results show that our approach is less affected than the prior approaches. © 2025},
 author = {Gong, Siyi and Zhong, Hao},
 doi = {10.1016/j.jss.2025.112527},
 journal = {Journal of Systems and Software},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Incremental learning of code authors over time},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105008980626?origin=resultslist},
 volume = {230},
 year = {2025}
}
