@inproceedings{9929691,
 abstract = {Community detection is of great significance to complex network. In response to community detection in complex network which has unknown number of communities, this paper proposed a new community detection approach with integration based on Beetle Swarm Optimization (BSO) and been named BSOI (Beetle Swarm Optimization with Integration). In the initialization of community division, community flag adapting node is adopted, which means the community flag of every node is initialized by its neighbor node. BSO is applied to optimize the community division. Then, we merge communities by the maximum module density increment. Experiments show that it can get a stable and effective result of community division quickly on both artificial and real-world social networks.},
 author = {Zhuang, Li and Yu, Lin and Zhang, Jie},
 booktitle = {2022 IEEE 6th Advanced Information Technology, Electronic and Automation Control Conference (IAEAC )},
 doi = {10.1109/IAEAC54830.2022.9929691},
 issn = {2689-6621},
 keyword = {Automation;Social networking (online);Complex networks;Complexity theory;Particle swarm optimization;Information technology;complex network;community detection;Beetle Swarm Optimization;modularity quantity;module density function;community integration},
 month = {Oct},
 number = {},
 pages = {1171-1176},
 title = {Community detection based on Beetle Swarm Optimization},
 volume = {},
 year = {2022}
}
