@conference{Zhang20091102,
 abstract = {Model composition is frequently used during large software development in MDE (Model Driven Engineering). The consistency of the composed model is quite essential to model composition. This paper presents a weaving-based model composition framework (WMCF) and then gives a prototype implementation of the framework using Alloy language. Models are converted into Alloy codes and model composition is verified by the Alloy Analyzer. © 2009 IEEE.},
 author = {Zhang, Defen and Li, Shixian and Liu, Xianming},
 doi = {10.1109/NCM.2009.271},
 journal = {NCM 2009 - 5th International Joint Conference on INC, IMS, and IDC},
 note = {Cited by: 11},
 pages = {1102 - 1107},
 publication_stage = {Final},
 source = {Scopus},
 title = {An approach for model composition and verification},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/73549101292?origin=resultslist},
 year = {2009}
}
