@article{Pan2020384,
 abstract = {Trajectory similarity is one of the most fundamental operations in spatial-temporal data analysis. Although many recent works focus on improving the efficiency on single machine, their solutions are not directly applicable to DSPEs (Distributed Stream Processing Engine) in an online manner. On one hand, the similarity processing on DSPEs is always susceptible to data skew and completeness issue. On the other hand, their methods only support a single trajectory similarity measure which could not serve for adaptive adjustment strategies in different scenario. In this paper, we propose a new general framework for online Trajectory Similarity Processing, named TraSP. Specifically, our proposal includes a matrix-based data dispatcher to provide balance and completeness guarantee for stream join, an atomic table generator to accommodate different similarity criteria and a lightweight filter to shed irrelevant workloads. Empirical studies on real world trajectory data sets validate the usefulness of our proposals and the comparison experiment shows the high performance of our framework. © 2020, Springer Nature Switzerland AG.},
 author = {Pan, Zhicheng and Chao, Pingfu and Fang, Junhua and Chen, Wei and Li, Zhixu and Liu, An},
 doi = {10.1007/978-3-030-62005-9_28},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {384 - 397},
 publication_stage = {Final},
 source = {Scopus},
 title = {TraSP: A General Framework for Online Trajectory Similarity Processing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85096560382?origin=resultslist},
 volume = {12342 LNCS},
 year = {2020}
}
