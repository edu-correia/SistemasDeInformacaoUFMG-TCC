@conference{Maathuis2025,
 abstract = {Since the space domain becomes increasingly important for modern military operations, real-time data and context driven knowledge need to be accounted in their execution. At the same time, equally important is the integration of intelligent, adaptive, and robust methods and models that merge human expertise and the capabilities of the AI systems in order to accomplish shared goals. On this behalf, a computational ontology is introduced in this research for modelling human-AI teaming in military space operations, by providing a framework to represent and reason about individual agents, the team formed by these agents as a collective agent, and account socio-technical aspects such as autonomy, feedback, trust, relationships, and behaviors. To this end, the Design Science Research methodological approach is taken guided by the Knowledge Representation and Reasoning domain principles to build the proposed model as a contribution that supports the ongoing development of responsible and trustworthy AI solutions aimed at effective and ethical decision-making in the military domain. © 2025 IEEE.},
 author = {Maathuis, Clara},
 doi = {10.1109/SPACE65882.2025.11171342},
 journal = {2025 IEEE Space, Aerospace and Defence Conference, SPACE 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Human-AI Teaming in Military Space Operations Model},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105018457907?origin=resultslist},
 year = {2025}
}
