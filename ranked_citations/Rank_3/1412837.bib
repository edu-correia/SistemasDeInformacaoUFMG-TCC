@inproceedings{1412837,
 abstract = {An efficient merge-based algorithm for variable-size block matching ME (motion estimation) to reduce the computation of block-size decision process in H.264 video encoder is proposed. Fixed-size 4 /spl times/ 4 small blocks are used for the integer-pixel accuracy full search ME and several candidate MVs are reserved for each 4 /spl times/ 4 blocks to determined if the neighboring blocks could be merge into other predefined block types or not. Simulation result shows the computational load of our method is significantly reduced than H.264 JM 7.3.},
 author = {Shen-Chuan Tai and Ying-Ru Chen and Sheng-Jia Li},
 booktitle = {The 2004 IEEE Asia-Pacific Conference on Circuits and Systems, 2004. Proceedings.},
 doi = {10.1109/APCCAS.2004.1412837},
 issn = {},
 keyword = {Motion estimation;Motion compensation;Computational modeling;Partitioning algorithms;Video coding;Image sequences;Image coding;Video compression;Apertures},
 month = {Dec},
 number = {},
 pages = {613-616 vol.1},
 title = {Low complexity variable-size block-matching motion estimation for adaptive motion compensation block size in H.264},
 volume = {1},
 year = {2004}
}
