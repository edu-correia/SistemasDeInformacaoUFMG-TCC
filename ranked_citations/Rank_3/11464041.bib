@inproceedings{11464041,
 abstract = {Commonsense Knowledge Graphs (CKGs) often suffer from semantic redundancy and structural incompleteness due to diverse linguistic expressions and the limitations of knowledge extraction. Link prediction addresses this issue by reasoning about missing triples in CKGs. However, many existing methods overlook redundant semantically equivalent entity nodes in triples, as well as the challenges associated with entity representation in incomplete triple structures, which limit reasoning performance. To address these issues, this paper presents a framework based on entity alignment and structural perturbation for link prediction in CKGs. The framework consists of three core components: a semantically equivalent entity alignment method merges consistent nodes to reduce redundancy; a structured perturbation graph aggregation mechanism improves entity distinguishability under incompleteness through perturbation sampling and gated aggregation; as well as a convolutional decoder module captures and optimizes relational patterns in triples. Experimental results show that the framework consistently improves link prediction performance on multiple commonsense knowledge graph benchmarks. The code for this work can be referenced at https://github.com/coderciv/CKGR.git.},
 author = {Chen, Hongzhi and Zhang, Fu and Wang, Xiaoke and Shen, Tong and Chi, Yiwen and Peng, Jiashun and Cheng, Jingwei},
 booktitle = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP55912.2026.11464041},
 issn = {2379-190X},
 keyword = {Brushes;Contacts;Protocols;Semantic Web;HTTP;Event detection;Internet;Wireless sensor networks;Fuses;Artificial intelligence;Commonsense Knowledge Graph;Structural Perturbation;Entity Alignment;Link Prediction},
 month = {May},
 number = {},
 pages = {16752-16756},
 title = {Entity Alignment and Structural Perturbation for Commonsense Knowledge Graph Reasoning},
 volume = {},
