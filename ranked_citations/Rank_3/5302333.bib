@inproceedings{5302333,
 abstract = {Ad hoc networks are self-organizing multi-hop systems consisting wireless nodes which can communicate with each other without pre-existing infrastructure. Clustering has evolved as an important research topic in mobile ad hoc networks(MANETs) as it improves the system performance of MANET, in the presence of both mobility and a large number of mobile terminals. In this paper, we propose a new clustering protocol for MANETs. The proposed protocol yields small number of multi-hop clusters with large size, so as to support large ad hoc networks. The proposed protocol utilizes routing information to adjust the topology of the clusters so as to reduce the overhead of the cluster maintenance and extend the life time of the cluster head. The objective of the clustering strategy is to achieve scalability and efficient routing. The simulation results show that the proposed protocol provides good performance in terms of the number of formed clusters and the percentage of connected nodes.},
 author = {Wang, Chuangang and Yu, Yanping and Xu, Yuanxin and Ma, Minjue and Diao, Shibin},
 booktitle = {2009 5th International Conference on Wireless Communications, Networking and Mobile Computing},
 doi = {10.1109/WICOM.2009.5302333},
 issn = {2161-9654},
 keyword = {Mobile ad hoc networks;Network topology;Spread spectrum communication;Ad hoc networks;Wireless application protocol;Routing protocols;Scalability;Mobile communication;Educational institutions;System performance},
 month = {Sep.},
 number = {},
 pages = {1-4},
 title = {A Multi-Hop Clustering Protocol for MANETs},
 volume = {},
 year = {2009}
}
