@inproceedings{4607431,
 abstract = {In this paper, we propose an optimized video scene segmentation approach with considering both content coherence and temporally contextual dissimilarity. First, a chain structure is constructed by connecting temporally adjacent shots to represent a video. Then the chain is partitioned such that the content within a chain segment is coherent enough and the contextual similarity of temporally adjacent chain segments is small enough. This task is formulated as a ratio function of content coherence and contextual similarity. Finally, we present an effective and efficient hierarchical chain partitioning approach to find the optimal scene segmentation. Experimental results on a set of home videos and feature movies demonstrate the superiority of the proposed approach over several existing key approaches.},
 author = {Jingdong Wang and Xinmei Tian and Linjun Yang and Zheng-Jun Zha and Xian-Sheng Hua},
 booktitle = {2008 IEEE International Conference on Multimedia and Expo},
 doi = {10.1109/ICME.2008.4607431},
 issn = {1945-788X},
 keyword = {Coherence;Merging;Motion pictures;Minimization;Color;Medical services;Feature extraction},
 month = {June},
 number = {},
 pages = {301-304},
 title = {Optimized video scene segmentation},
 volume = {},
 year = {2008}
}
