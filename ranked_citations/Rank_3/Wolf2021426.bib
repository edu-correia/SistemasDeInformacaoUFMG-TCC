@article{Wolf2021426,
 abstract = {Summary: RNA-sequencing (RNA-Seq) is the current method of choice for studying bacterial transcriptomes. To date, many computational pipelines have been developed to predict differentially expressed genes from RNA-Seq data, but no gold-standard has been widely accepted. We present the Snakemake-based tool Smart Consensus Of RNA Expression (SCORE) which uses a consensus approach founded on a selection of well-established tools for differential gene expression analysis. This allows SCORE to increase the overall prediction accuracy and to merge varying results into a single, human-readable output. SCORE performs all steps for the analysis of bacterial RNA-Seq data, from read preprocessing to the overrepresentation analysis of significantly associated ontologies. Development of consensus approaches like SCORE will help to streamline future RNA-Seq workflows and will fundamentally contribute to the creation of new gold-standards for the analysis of these types of data.  © 2020 The Author(s).},
 author = {Wolf, Silver A. and Epping, Lennard and Andreotti, Sandro and Reinert, Knut and Semmler, Torsten},
 doi = {10.1093/bioinformatics/btaa681},
 journal = {Bioinformatics},
 note = {Cited by: 1; All Open Access; Bronze Open Access},
 number = {3},
 pages = {426 - 428},
 publication_stage = {Final},
 source = {Scopus},
 title = {SCORE: Smart Consensus Of RNA Expression - a consensus tool for detecting differentially expressed genes in bacteria},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85105691745?origin=resultslist},
 volume = {37},
 year = {2021}
}
