@article{BERNINGHAUS2003465,
 abstract = {In an experiment, two players bargain with a third party, either separately or collectively after forming a joint venture. Our theoretical benchmark solution predicts decentralized bargaining, as only one of the players has an interest in forming a joint venture. However, we observe a significant share of collective bargaining. When compared with decentralized bargaining, centralization has no significant effect on the payoffs of the merged partners, but reduces the payoff of the third player due to more frequent conflicts caused by higher ambitions of the merged party.},
 author = {Siegfried Berninghaus and Werner Güth and Claudia Keser},
 doi = {https://doi.org/10.1016/S0927-5371(03)00021-6},
 issn = {0927-5371},
 journal = {Labour Economics},
 keyword = {Bargaining, Joint venture, Merger, Experiments, Equilibrium selection},
 note = {Special Issue on Labour Market Experiments},
 number = {4},
 pages = {465-479},
 title = {Unity suggests strength: an experimental study of decentralized and collective bargaining},
 url = {https://www.sciencedirect.com/science/article/pii/S0927537103000216},
 volume = {10},
 year = {2003}
}
