@inproceedings{10040427,
 abstract = {AR is defined by Azuma as “the merging of real and virtual information.” Maker-based AR works by scanning a marker, which prompts the device to display an augmented experience. Customers order more than they need in restaurants, resulting in food waste. A mobile app with marker-based Augmented Reality (AR) for food visualization is our solution to this problem. The idea is to include a QR code that provides a 3D model of the meal so that the user can visualize the quantity, thus improving the user experience.},
 author = {R, Uma and Sirisha, Upparapalli and V, Varshaa},
 booktitle = {2022 1st International Conference on Computational Science and Technology (ICCST)},
 doi = {10.1109/ICCST55948.2022.10040427},
 issn = {},
 keyword = {Food waste;Visualization;Solid modeling;Three-dimensional displays;Scientific computing;Merging;QR codes;Augmented reality;Vuforia;marker detection;visualization;The paper has the following sections;introduction;literature review;proposed solution;result;conclusion and references},
 month = {Nov},
 number = {},
 pages = {967-971},
 title = {Marker Based Augmented Reality Food Menu},
 volume = {},
 year = {2022}
