@article{Jeong2011287,
 abstract = {In this paper, we present a method for instance mapping and URI resolving to merge two heterogeneous resources and construct a new semantic network in a viewpoint of Acronym-Expansion. Acronym-Expansion information extracted from two unstructured large dataset can be remapped by using linkage information between instances and measuring string similarity. All the semantic resources and systems are utilized for constructing infrastructures of KISTI's TOD, a new information analytics project based on semantic technologies. © 2011 Springer-Verlag.},
 author = {Jeong, Do-Heon and Hwang, Myung-Gwon and Sung, Won-Kyung},
 doi = {10.1007/978-3-642-27210-3_38},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 4},
 pages = {287 - 293},
 publication_stage = {Final},
 source = {Scopus},
 title = {Generating knowledge map for acronym-expansion recognition},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/83755173511?origin=resultslist},
 volume = {264 CCIS},
 year = {2011}
}
