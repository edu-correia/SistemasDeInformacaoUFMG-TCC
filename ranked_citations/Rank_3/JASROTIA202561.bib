@incollection{JASROTIA202561,
 abstract = {This chapter addresses the ethical concerns of the fascinating Metaverse and Analytics of Things (AoT) in medical systems. As the barriers between the virtual and real worlds blur, incorporating cutting-edge technologies into healthcare raises novel potential and ethical concerns. The first section of the chapter provides an overview of the Metaverse, a virtual frontier with much potential for medical improvements, and the Internet of Things, a new data-driven way of thinking about healthcare. We can learn more about the ethical foundations of this new terrain by determining how these two worlds interact. This demonstrates the significance of moral responsibility in virtual patient care. Exploring the societal consequences of merging these areas demonstrates how powerful real-time data analysis can be and how critical it is to preserve patient privacy and ensure everyone has equal access to virtual medical services. In the subsequent sections, Metaverse and ethics are discussed in terms of artificial intelligence and machine learning, with a push for tools that help doctors make judgments while maintaining the human touch in virtual healthcare. This demonstrates the need to design virtual healthcare experiences with empathy and inclusion for everybody. The chapter also discusses the function of genuine medical systems in the virtual world and offers solutions for ethically integrating hybrid healthcare services. Finally, this chapter demonstrates the importance of ethical research in determining how the Metaverse, AoT, and medical systems interact. This changing medical environment can fulfill its full potential if patient care, compassion, and social values are maintained. This will pave the way for a future in which innovation and integrity can coexist together.},
 author = {Sahil Singh Jasrotia and Manoj Kumar Kamila and Pooja Singh Kushwaha},
 booktitle = {Leveraging Metaverse and Analytics of Things (AoT) in Medical Systems},
 doi = {https://doi.org/10.1016/B978-0-443-24049-2.00001-7},
 editor = {D. Jude Hemanth and P. Mary Jeyanthi},
 isbn = {978-0-443-24049-2},
 keyword = {Metaverse, Virtual healthcare, Artificial intelligence, Ethics, Social values},
 pages = {61-86},
 publisher = {Academic Press},
 series = {Advances in ubiquitous sensing applications for healthcare},
 title = {Chapter 4 - Navigating ethical horizon: A dive into metaverse and analytics of things in healthcare system},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443240492000017},
 year = {2025}
}
