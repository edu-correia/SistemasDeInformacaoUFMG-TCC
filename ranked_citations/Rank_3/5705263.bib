@inproceedings{5705263,
 abstract = {In this paper, we intended to seek a method to retrieval media files on personal mobile devices efficiently. We aimed at finding media-generated event accurately to provide support for annotation and retrieval of multimedia files. In this paper, the event-cluster positioning is realized by spatio-temporal clustering. Time clustering uses a method that maps the time difference to image, and then finds the corresponding boundary points through image processing. We improved the original time clustering algorithm by considering the semantic of “event”, and amended potential errors in time clustering by the adaptive space clustering algorithm. At last, we proposed a new method to find a more abstract activities topic by merging events of certain conditions according to user's usage habit.},
 author = {Yi Sun and Wendong Wang and Xiangyang Gong and Canfeng and Xiaogang Yang and Jian Ma},
 booktitle = {2010 3rd IEEE International Conference on Broadband Network and Multimedia Technology (IC-BNMT)},
 doi = {10.1109/ICBNMT.2010.5705263},
 issn = {},
 keyword = {Image resolution;multimedia retrieval;event cluster;spatio-temporal clustering;temporal cluster;spatial correction;native and foreign event},
 month = {Oct},
 number = {},
 pages = {1115-1119},
 title = {Event clustering of digital media in personal mobile device based on spatio-temporal clustering},
 volume = {},
 year = {2010}
}
