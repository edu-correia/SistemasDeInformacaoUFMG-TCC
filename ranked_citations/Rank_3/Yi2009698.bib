@conference{Yi2009698,
 abstract = {In this paper, a kind of test cube dividing strategy is investigated on which the optimal LFSR-coding scheme is based. The strategy utilizes the fact that the number of specified bits in different test cubes varies widely and the specified bits in a test cube clusters mostly, in which each of the test cubes with high fill rates is divided into two cubes having lower fill rates, and the guiding rule is that one cube consists of odd bits of the original test cube, whereas the second cube is comprised of even bits of the original pattern. The number of specified bits in a new cube is reduced effectively, which makes degree of LFSR needed for encoding it successfully smaller. A LFSR decoder of low complexity is used to outspread the seeds and merge two successively decoded patterns. The experimental results show that compared to the previous techniques, the proposed scheme can achieve higher test data compression ratio. The seeds for LFSR decoding being of the same length, it is convenient to communicate between ATE and circuit under test. © 2009 IEEE.},
 author = {Yi, Maoxiang and Liang, Huaguo and Zhan, Kaihua and Jiang, Cuiyun},
 doi = {10.1109/CSE.2009.29},
 journal = {Proceedings - 12th IEEE International Conference on Computational Science and Engineering, CSE 2009},
 note = {Cited by: 2; All Open Access; Gold Open Access},
 pages = {698 - 702},
 publication_stage = {Final},
 source = {Scopus},
 title = {Optimal LFSR-coding test data compression based on test cube dividing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70749144834?origin=resultslist},
 volume = {2},
 year = {2009}
}
