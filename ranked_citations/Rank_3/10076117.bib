@inproceedings{10076117,
 abstract = {In the recent past, with the advancement of tech-nologies, many changes have been made in Identity Management Systems across the globe. Identity cards have become an inextri-cable part of our lives. With time, authentication of a person's identity and data breaching has led to privacy concerns. The rapid growth of the population raises the challenge of storing large data securely. A new approach to data encryption and hashing can resolve concerns of privacy, security, data handling, and more. Blockchain Technology and the Internet Of Things will improve the current ecosystem. The devised model will be using the AES algorithm for the encryption of biometrics and demographic data. Additionally, the symmetrically distributed storage system, the InterPlanetary File System(IPFS) will be used and data will be hashed by SHA-256. Furthermore, key pairs will be assigned to IoT devices to store the data on a distributed ledger system. This paper will also introduce the merging of Blockchain and IoT, thus ensuring better security and connectivity in a decentralized manner.},
 author = {Gupta, Shreya and Bairwa, Amit Kumar and Kushwaha, Satpal Singh and Joshi, Sandeep},
 booktitle = {2023 3rd International Conference on Intelligent Communication and Computational Techniques (ICCT)},
 doi = {10.1109/ICCT56969.2023.10076117},
 issn = {},
 keyword = {Data privacy;Sociology;Smart contracts;Public key;Privacy breach;Blockchains;Encryption;Blockchain;IoT;AES;SHA-256;IPFS},
 month = {Jan},
 number = {},
 pages = {1-6},
 title = {Decentralized Identity Management System using the amalgamation of Blockchain Technology},
 volume = {},
 year = {2023}
}
