@inproceedings{9526710,
 abstract = {In order to reasonably evaluate the road traffic conditions of mountain cities, the mountain city road network structure and traffic operation are taken as the research objects, and the intersections, bridges and tunnels are analyzed according to the geographical characteristics of mountain cities. Multi-lane merge and unreasonable road gradation and other mountain city characteristics are classified and analyzed, and then the traffic road network structure and road traffic operation evaluation indicators are proposed. Among them, the discrete coefficient of intersection spacing and road network grading coefficient are used as the traffic road network. Structural evaluation indicators, capacity matching coefficient and flow load rate are road traffic operation evaluation indicators. Through the verification and analysis of examples, the evaluation indicators proposed in this paper can reasonably evaluate the road traffic of mountainous cities.},
 author = {Han, Zhi and Xu, Chongcong},
 booktitle = {2020 13th International Conference on Intelligent Computation Technology and Automation (ICICTA)},
 doi = {10.1109/ICICTA51737.2020.00058},
 issn = {},
 keyword = {Bridges;Landline;Roads;Urban areas;Merging;Planning;Delays;Urban traffic;Road Traffic Evaluation;Road Network Structure Evaluation;Traffic Operation Evaluation;Mountain City},
 month = {Oct},
 number = {},
 pages = {242-248},
 title = {Study on Evaluation Index of Road Traffic in Mountainous City},
 volume = {},
 year = {2020}
}
