@article{An20261836,
 abstract = {Multimodal sentiment analysis, a central field in affective computing, has focused on fundamental feature extraction and fusion across modalities. However, these methods often overlook redundancy and conflicts, limiting performance improvements. To address this, we propose a sentiment analysis framework based on the Super Learning Multimodal Transformer (SLMT), designed to reduce redundancy and resolve fusion conflicts, thereby enhancing accuracy and robustness. Specifically, we introduce the Channel-Spatial Convolution Transformer (CSC Transformer), which combines multi-scale convolution and attention to merge spatial and channel features, effectively reducing redundancy. Moreover, we further use the semantic prior from the linguistic modality as a guiding signal for cross-modal alignment and fusion, driving the visual and audio modalities to perform selective complementary enhancement and inconsistency reduction during their interaction, thereby optimizing the correlation structure among the three modalities and minimizing fusion conflicts to the greatest extent. Extensive experiments show that our method outperforms state-of-the-art approaches, particularly in sentiment classification tasks. Ablation studies further confirm the framework's effectiveness. © 1994-2012 IEEE.},
 author = {An, Dezhi and Wang, Shuowen},
 doi = {10.1109/LSP.2026.3682989},
 journal = {IEEE Signal Processing Letters},
 note = {Cited by: 0},
 pages = {1836 - 1840},
