@inproceedings{1013069,
 abstract = {This paper presents a new control scheme for streaming video. It uses hierarchical adaptive merge & split mesh (HAMSM) processing and hierarchical adaptive control protocol (HACP) for video streaming. The combination of HAMSM and HACP offers reliable, adaptive and minimized video streaming over the network. Furthermore, streaming packet dropout and damage are taken into account in streaming adaptation so that the end-to-end distortion is limited. The proposed system is prototyped and simulated.},
 author = {Linsong Cai and Mao Liu and Wael Badawy},
 booktitle = {IEEE CCECE2002. Canadian Conference on Electrical and Computer Engineering. Conference Proceedings (Cat. No.02CH37373)},
 doi = {10.1109/CCECE.2002.1013069},
 issn = {0840-7789},
 keyword = {Adaptive control;Protocols;Streaming media;Programmable control;Bandwidth;Quality of service;Resilience;Computer errors;Error correction;Motion estimation},
 month = {May},
 number = {},
 pages = {940-944 vol.2},
 title = {Hierarchical adaptive control protocol for video streaming},
 volume = {2},
 year = {2002}
}
