@article{Camargo2019_930,
 abstract = {Abstract This article examines the conceptual links between hospitality, tourism, and leisure, as well as the heuristic advantages of such articulation and implications for studies in these fields, today closely connected yet still distinct. To this end, after establishing the similarities and differences between the concepts, I will try to show how the articulation of these concepts can contribute to the current discussion of overtourism, school, and sex tourism. Finally, it is discussed how the emergence of studies on mobility and the economics of happiness tend to strengthen the integration of these fields.},
 author = {Camargo, Luiz Octávio de Lima},
 doi = {10.7784/rbtur.v13i3.1749},
 number = {3},
 pages = {1--15},
 title = {Hospitality, tourism and leisure},
 volume = {13},
 year = {2019}
}
