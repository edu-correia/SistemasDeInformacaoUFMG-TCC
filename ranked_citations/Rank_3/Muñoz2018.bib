@article{Muñoz2018,
 abstract = {The evolution of the Internet of Things leads to new opportunities for the contemporary notion of smart offices, where employees can benefit from automation to maximize their productivity and performance. However, although extensive research has been dedicated to analyze the impact of workers’ emotions on their job performance, there is still a lack of pervasive environments that take into account emotional behaviour. In addition, integrating new components in smart environments is not straightforward. To face these challenges, this article proposes an architecture for emotion aware automation platforms based on semantic event-driven rules to automate the adaptation of the workplace to the employee’s needs. The main contributions of this paper are: (i) the design of an emotion aware automation platform architecture for smart offices; (ii) the semantic modelling of the system; and (iii) the implementation and evaluation of the proposed architecture in a real scenario. © 2018 by the authors. Licensee MDPI, Basel, Switzerland.},
 author = {Muñoz, Sergio and Araque, Oscar and Fernando Sánchez-Rada, J. and Iglesias, Carlos A.},
 doi = {10.3390/s18051499},
 journal = {Sensors (Switzerland)},
 note = {Cited by: 26; All Open Access; Gold Open Access; Green Open Access},
 number = {5},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An emotion aware task automation architecture based on semantic technologies for smart offices},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85046752132?origin=resultslist},
 volume = {18},
 year = {2018}
}
