@inproceedings{5342917,
 abstract = {To deal with the problem that consistency in semantic representation of exchanged product knowledge in collaborative manufacturing, an ontology-based framework of knowledge integration and sharing was presented, and in the meantime an integration algorithm based on ontology mapping and merging was designed under this framework. First of all, a collaborative operation model for enterprise collaboration was discussed, and then an ontology-based framework of knowledge integration and sharing was established. Under the condition of analyzing the structure of product knowledge ontology, an ontology logic schema of knowledge concept was designed. Aiming at the ontology logic schema, an ontology integration algorithm of product knowledge was also improved. The algorithm is composed of ontology mapping and merging. Finally, the proposed ontology integration algorithm has been verified to be effective through the comparing experiment.},
 author = {Liu, Wenjian and Jiang, Yang and Jin, Tianguo},
 booktitle = {2009 IEEE International Workshop on Intelligent Data Acquisition and Advanced Computing Systems: Technology and Applications},
 doi = {10.1109/IDAACS.2009.5342917},
 issn = {},
 keyword = {Ontologies;Collaboration;Assembly;Computer aided manufacturing;Merging;Knowledge management;Virtual manufacturing;Cutting tools;Conferences;Data acquisition;Collaborative manufacturing;Product knowledge;Ontology;Knowledge integration;Similarity matching},
 month = {Sep.},
 number = {},
 pages = {565-569},
 title = {Research on integration of ontology-based product knowledge: Framework, schema and algorithm},
 volume = {},
 year = {2009}
}
