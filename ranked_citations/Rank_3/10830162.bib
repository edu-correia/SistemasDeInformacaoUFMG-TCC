@inproceedings{10830162,
 abstract = {To enhance the efficiency and safety of intersection vehicle traffic in the new mixed traffic environment, this paper proposes a right-turn conflict dissipation strategy for connected and automated vehicles (CAVs) based on dynamic gap adjustment. In consideration of the partition guidance strategy, we develop a right-turn guidance model for resolving merging conflicts, implementing guidance control decisions for right-turn vehicles in straight-right mixed lanes at intersections. Using SUMO to carry out simulation experiments, the results show that: (1) when the ratio of straight vehicles to right-turning vehicles is 2:3, the road network reaches an inflection point; when the traffic flow is 600 vehicles per hour, the benefits achieved by the right-turn conflict dissipation strategy surpass those under traffic volumes of 200, 400, and 800 vehicles per hour. (2) In the new mixed traffic environment, compared to unguided control results, the proposed conflict dissipation strategy optimizes average vehicle loss time, average waiting time, and average number of stops, effectively improving intersection access efficiency.},
 author = {Kong, Xiaoli and Wang, Cheng and Li, Yao and Ding, Yanchao and Zhang, Hao and Feng, Tianliu and Liu, Yumin and E, Wenjuan},
 booktitle = {2024 8th CAA International Conference on Vehicular Control and Intelligence (CVCI)},
 doi = {10.1109/CVCI63518.2024.10830162},
 issn = {},
 keyword = {Space vehicles;Pedestrians;Intelligent vehicles;Roads;Simulation;Merging;Aerospace electronics;Safety;Resource management;Vehicle dynamics;new hybrid traffic;connected and automated vehicles;signalized intersections;right-turn conflict;gap theory},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Right-Turn Conflict Dissipation Strategy of CAVs at Intersection Based on Dynamic Gap Adjustment},
 volume = {},
