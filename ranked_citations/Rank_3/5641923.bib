@inproceedings{5641923,
 abstract = {This paper presents a novel ontology fusion approach which aims to establish a mutual understanding among HLA (High Level Architecture) -based distributed heterogeneous collaborative product development systems. The approach includes three steps: ontology mapping, ontology alignment and ontology merging. It adopts an axiom-based deduction ontology fusion strategy, and takes heavy weighted ontologies into consideration. It can find all the explicit and derived inter-ontology relations, and furthermore it reaches the active upper bounds of implicit equivalent inter-ontology relations searching. The proposed approach has great potential to improve the efficiency of preparation for HLA-based collaborative product development, reduce the work load for adaptive adjustment of ever-existing platforms, and enhance the applicability and flexibility of collaborative development systems.},
 author = {Hongbo Sun and Wenhui Fan and Weiming Shen and Tianyuan Xiao},
 booktitle = {2010 IEEE International Conference on Systems, Man and Cybernetics},
 doi = {10.1109/ICSMC.2010.5641923},
 issn = {1062-922X},
 keyword = {Integrated circuits;Ontologies;Merging;Bridges;Collaborative product development;HLA - High Level Architecture;ontology fusion},
 month = {Oct},
 number = {},
 pages = {2526-2532},
 title = {Ontology fusion in HLA-based collaborative product development},
 volume = {},
 year = {2010}
}
