@article{5941007,
 abstract = {The authors describe an intense plasma plume from atmospheric-pressure plasma jet array devices. Here, outer plasma plumes, produced by this device, were sucked into the centered plasma plume at the ends of the tubes and merged with the centered plume. The intense plasma jet is possible through jet-to-jet coupling in eight-quartz-tube arrays. To describe this coupling, optical properties of the intense plasma jet are compared with those of a single tubing plasma jet. The optical intensity from the intense plasma jet by jet-to-jet coupling was approximately three times larger than that of a conventional single plasma jet under identical driving and gas conditions.},
 author = {Kim, Jae Young and Kim, Sung-O},
 doi = {10.1109/TPS.2011.2157836},
 issn = {1939-9375},
 journal = {IEEE Transactions on Plasma Science},
 keyword = {Plasmas;Electron tubes;Arrays;Couplings;Electrodes;Discharges;Indium tin oxide;Atmospheric-pressure plasma jet (APPJ);intense plasma jet;jet-to-jet coupling;plasma jet array},
 month = {Nov},
 number = {11},
 pages = {2278-2279},
 title = {Intense Plasma Emission From Atmospheric-Pressure Plasma Jet Array by Jet-to-Jet Coupling},
 volume = {39},
 year = {2011}
}
