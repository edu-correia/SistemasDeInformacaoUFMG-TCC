@conference{Clifton200419,
 abstract = {Integrating data from multiple sources has been a longstanding challenge in the database community. Techniques such as privacy-preserving data mining promises privacy, but assume data has integration has been accomplished. Data integration methods are seriously hampered by inability to share the data to be integrated. This paper lays out a privacy framework for data integration. Challenges for data integration in the context of this framework are discussed, in the context of existing accomplishments in data integration. Many of these challenges are opportunities for the data mining community. Copyright 2004 ACM.},
 author = {Clifton, Chris and Kantarcioǧlu, Murat and Doan, AnHai and Schadow, Gunther and Vaidya, Jaideep and Elmagarmid, Ahmed and Suciu, Dan},
 doi = {10.1145/1008694.1008698},
 journal = {Proceedings of the ACM SIGMOD International Conference on Management of Data},
 note = {Cited by: 161},
 pages = {19 - 26},
 publication_stage = {Final},
 source = {Scopus},
 title = {Privacy-preserving data integration and sharing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/34748816024?origin=resultslist},
 year = {2004}
}
