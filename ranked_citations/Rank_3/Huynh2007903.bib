@article{Huynh2007903,
 abstract = {Potluck is a web user interface (Figure 1) that lets casual users- those without programming skills and data modeling expertise-repurpose heterogeneous Semantic Web data. It lets users merge, navigate, visualize, and clean up data all at the same time, using direct visual manipulation. This iterative process of integrating the data while constructing useful visualizations is desirable when the user is unfamiliar with the data at the beginning -a common case-and wishes to get immediate value out of the data without having to spend the overhead of completely and perfectly integrating the data first. © 2008 Springer-Verlag Berlin Heidelberg.},
 author = {Huynh, David F. and Miller, Robert C. and Karger, David R.},
 doi = {10.1007/978-3-540-76298-0_67},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 12; All Open Access; Bronze Open Access},
 pages = {903 - 910},
 publication_stage = {Final},
 source = {Scopus},
 title = {Potluck: Semi-ontology alignment for casual users},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/49949084045?origin=resultslist},
 volume = {4825 LNCS},
 year = {2007}
}
