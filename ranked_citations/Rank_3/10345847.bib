@inproceedings{10345847,
 abstract = {In recent years, increase in global population has made the need for efficient food production methods evident. Additionally, climate change phenomena and weather extrem-ities, hinder the production process further. On top of that, urbanization has reduced the arable lands, and disassociated the modern human from the environment and the cultivation of crops. This not only lessened the number of participants in the production domain, but also deprived the majority of the population of self sustainability, in the emergency of production shortages. To compensate for these issues, modern agriculture technology is being developed, aiming to provide optimal growth environments and efficient production methodologies. Such a technology is the modern greenhouse, a subject of interest for many researchers, working towards the development of optimal structures, materials and control methodologies. The latest approaches, focus on the automation of the greenhouse, succeeding in creating a self regulating microclimate. Finally, unifying automation techniques with optimal design structures through the technology of Internet Of Things(IOT) seems to be the way of the future. The goal of this paper is to merge an original small greenhouse structure with a control scheme using fuzzy systems. The aimed result is an IOT self-regulating environment suitable for unsupervised plant growth.},
 author = {Tolis, Fotios and Blounas, Taxiarchis-Foivos and Tsipianitis, Dimitrios},
 booktitle = {2023 14th International Conference on Information, Intelligence, Systems & Applications (IISA)},
 doi = {10.1109/IISA59645.2023.10345847},
 issn = {},
 keyword = {Automation;Green products;Fuzzy control;Urban areas;Production;Air pollution;Statistics;Climate change;Internet of Things;Greenhouse effect;IOT;Greenhouse;Fuzzy Control},
 month = {July},
