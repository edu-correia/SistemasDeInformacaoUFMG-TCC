@inproceedings{5380721,
 abstract = {The union operation, one of the spatial analysis operations, plays an important role in the capability of GIS software. At present, many algorithms for this operation have been put forward; however, most of them have limitation on handling general polygons. In this paper, introducing the trapezoidal-mesh data structure and the split-and-merge technique, an efficient union algorithm has been ad-dressed, which is suitable for general polygons. The trapezoidal data structure is simple and the operations based on it are easily to be implemented. Being applied in GIS platform software, this algorithm has been proved of high efficiency and occupying less memory.},
 author = {Cui, Can and Shen, Dingtao and Wu, Wenzhou and Wang, Jiechen},
 booktitle = {2009 Second International Conference on Computer and Electrical Engineering},
 doi = {10.1109/ICCEE.2009.11},
 issn = {},
 keyword = {Geographic Information Systems;Data structures;Software algorithms;Algorithm design and analysis;Information analysis;Information science;Computer graphics;Performance analysis;Software performance;Trapezoidal-mesh;Split-Merge technique;Polygon union operation;Geographic information system},
 month = {Dec},
 number = {},
 pages = {8-11},
 title = {A Novel Algorithm for Union between Complex Polygons},
 volume = {1},
 year = {2009}
}
