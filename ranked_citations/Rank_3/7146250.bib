@inproceedings{7146250,
 abstract = {This paper presents an alternative method to compensate carrier frequency offset (CFO) for frequency-spreading structure of staggered modulated multitone (FS-SMT) system in the uplink of multiple access scenario. The proposed method reduces computational complexity and latency of the receiver without losing the performance. Moreover, a possibility for merging compensation of timing offset (TO) and channel effect with CFO correction is presented. Simulation results show that the proposed method offers a reasonable performance with mentioned improvements.},
 author = {Sabeti, Parna and Saeedi-Sourck, Hamid and Omidi, Mohamad Javad},
 booktitle = {2015 23rd Iranian Conference on Electrical Engineering},
 doi = {10.1109/IranianCEE.2015.7146250},
 issn = {2164-7054},
 keyword = {OFDM;Discrete Fourier transforms;Receivers;Computational complexity;Frequency-domain analysis;Uplink},
 month = {May},
 number = {},
 pages = {410-415},
 title = {Low-complexity CFO correction of frequency-spreading SMT in uplink of multicarrier multiple access networks},
 volume = {},
 year = {2015}
}
