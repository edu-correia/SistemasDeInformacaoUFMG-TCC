@article{SAKTHIVEL2025145836,
 abstract = {The growing reliance on antioxidants such as propyl gallate (PG) for food preservation, while beneficial for extending shelf life, raises important concerns regarding consumer safety and product integrity. To address this issue, we present a high-performance electrochemical sensor based on a MoSe2/g-C3N4 heterostructure for the ultrasensitive detection of PG. The sensor was fabricated by modifying a glassy carbon electrode with hydrothermally synthesized MoSe2 integrated with g-C3N4 nanosheets, exploiting their improved conductivity and catalytic properties due to the composite structure. Comprehensive electrochemical characterization via EIS, CV, and DPV revealed a noticeable enhancement in PG oxidation signals. The sensor accomplish an impressive linear detection range of 0.1–1285 μM, an ultralow detection limit of 0.0735 μM, and a high sensitivity of 57.4 μA μM−1 cm−2. This platform offers a robust, real-time analytical technique for monitoring antioxidant content in food matrices, supporting regulatory enforcement and safeguarding public health through precise, on-site detection, merging innovation in materials science with critical food safety applications.},
 author = {Nirmal Kumar Sakthivel and Rakesh Prasad Veerasamy and Ali Akremi and Thamraa Alshahrani and Mani Govindasamy},
 doi = {https://doi.org/10.1016/j.foodchem.2025.145836},
 issn = {0308-8146},
 journal = {Food Chemistry},
 keyword = {Dichalcogenides, Food safety, Propyl gallate, Good health & well-being, Electrochemical sensors, Graphitic carbon nitride},
 pages = {145836},
 title = {Enhanced electrochemical detection of propyl gallate in foods using molybdenum diselenide decorated on graphitic carbon nitride modified electrode},
 url = {https://www.sciencedirect.com/science/article/pii/S0308814625030870},
 volume = {493},
 year = {2025}
}
