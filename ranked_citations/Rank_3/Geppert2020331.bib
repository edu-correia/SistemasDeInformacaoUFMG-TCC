@article{Geppert2020331,
 abstract = {Merge & Reduce is a general algorithmic scheme in the theory of data structures. Its main purpose is to transform static data structures—that support only queries—into dynamic data structures—that allow insertions of new elements—with as little overhead as possible. This can be used to turn classic offline algorithms for summarizing and analyzing data into streaming algorithms. We transfer these ideas to the setting of statistical data analysis in streaming environments. Our approach is conceptually different from previous settings where Merge & Reduce has been employed. Instead of summarizing the data, we combine the Merge & Reduce framework directly with statistical models. This enables performing computationally demanding data analysis tasks on massive data sets. The computations are divided into small tractable batches whose size is independent of the total number of observations n. The results are combined in a structured way at the cost of a bounded O(log n) factor in their memory requirements. It is only necessary, though nontrivial, to choose an appropriate statistical model and design merge and reduce operations on a casewise basis for the specific type of model. We illustrate our Merge & Reduce schemes on simulated and real-world data employing (Bayesian) linear regression models, Gaussian mixture models and generalized linear models. © 2020, The Author(s).},
 author = {Geppert, Leo N. and Ickstadt, Katja and Munteanu, Alexander and Sohler, Christian},
 doi = {10.1007/s41060-020-00226-0},
 journal = {International Journal of Data Science and Analytics},
 note = {Cited by: 8; All Open Access; Hybrid Gold Open Access},
 number = {4},
 pages = {331 - 347},
 publication_stage = {Final},
 source = {Scopus},
 title = {Streaming statistical models via Merge & Reduce},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85087972800?origin=resultslist},
 volume = {10},
 year = {2020}
}
