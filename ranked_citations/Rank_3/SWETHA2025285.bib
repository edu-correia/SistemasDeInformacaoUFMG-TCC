@incollection{SWETHA2025285,
 abstract = {A new era of innovation in the design and manufacturing of batteries and supercapacitors is being ushered in by the merging of additive manufacturing and smart materials. This chapter explores the transformative impact of additive manufacturing (AM) and smart materials on the design and production of next-generation batteries and supercapacitors. By focusing on key AM techniques such as inkjet printing, stereolithography, and selective laser sintering, we highlight the unprecedented control these technologies offer over the geometry and material composition of energy storage devices. Smart materials including responsive composites, shape-memory alloys, and self-healing polymers further enhance device performance by enabling features like self-diagnosis, self-repair, and real-time monitoring. Unlike prior research, which largely emphasized incremental improvements in energy storage, this work demonstrates how the integration of AM with smart materials can significantly boost device efficiency, portability, and durability. Moreover, the incorporation of artificial intelligence (AI) and machine learning (ML) into the manufacturing process distinguishes this study, offering new pathways to enhance precision and optimize system design. These innovations have the potential to revolutionize the energy storage industry, paving the way for more efficient batteries and supercapacitors with broad applications in consumer electronics and renewable energy systems.},
 author = {M. Swetha and A. Judith Jayarani and S. Ambika and S. Selvakumar and Panagiotis Kyratsis and B. Samba Sivaiah and V. Hariprasath and K.P. Senthilnathan and G. Sahaya Dennish Babu},
 booktitle = {Additively Manufactured Smart Materials and Structures},
 doi = {https://doi.org/10.1016/B978-0-443-16144-5.00002-8},
 editor = {Rajkumar Velu and Kalim Deshmukh and Ituarte {Iñigo Flores} and Anand Kumar Subramaniyan},
 isbn = {978-0-443-16144-5},
 keyword = {Additive manufacturing, smart materials, energy storage devices, batteries, supercapacitors, shape-memory alloys, flexible smart devices},
 pages = {285-314},
 publisher = {Elsevier},
 series = {Additive Manufacturing Materials and Technologies},
 title = {13 - Additively manufactured smart materials and structures for batteries and supercapacitors},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443161445000028},
 year = {2025}
}
