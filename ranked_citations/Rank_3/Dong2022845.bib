@conference{Dong2022845,
 abstract = {Video analytics is a hot issue in the application of deep learning technology nowadays, and the research of in-telligent video analytics framework provides great conven-ience to facilitate users to quickly build deep learning streaming applications. In the fields of intelligent human-computer interaction, robotics, and Internet of Things, tens of thousands of cameras and sensors provide a large amount of video data, and intelligent video analysis frameworks can be used as pow-erful tools for mining video information. In order to solve the problems of poor compatibility, unclear software architecture and difficult code refactoring of the main frameworks in the current market, we design and implement an intelligent video analysis framework with stronger generality and clearer ar-chitecture. The framework consists of four panels: system framework, functional modules, plug-ins and components, and is also configured with various model deployment optimi-zation strategies such as pipeline technology and heterogene-ous programming technology. Moreover, experiments on face expression recognition and eye movement recognition are con-ducted in the framework, and the results show that the application can analyze the expression and eye movement states of people in video streams in real time with good performance, clear data flow and easy code reconfiguration.  © 2022 IEEE.},
 author = {Dong, Lanfang and Chen, Yongsheng and Zhang, Yuhang},
 doi = {10.1109/CYBER55403.2022.9907177},
 journal = {2022 12th International Conference on CYBER Technology in Automation, Control, and Intelligent Systems, CYBER 2022},
 note = {Cited by: 0},
 pages = {845 - 850},
 publication_stage = {Final},
 source = {Scopus},
 title = {Design and Implementation of a Highly Compatible Intelligent Video Analysis Framework},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85141146099?origin=resultslist},
 year = {2022}
}
