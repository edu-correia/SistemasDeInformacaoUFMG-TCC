@article{1519723,
 abstract = {Many power system applications, particularly those related to monitoring,control, and protection, depend on the use of field data recorded by intelligent electronic devices (IEDs) in substations. With the introduction of IEDs in the last 20 years, the amount and type of data collected in substations have dramatically increased. This paper explores the benefits of data integration and information extraction achieved by merging temporal and spatial considerations. In the new approach, time and space issues are treated consistently across all IEDs, and as a result new applications with improved performance characteristics can be defined. As an illustration, two new monitoring functions are discussed in detail: 1) automated fault analysis and 2) hierarchical state and topology estimation. Discussion ends with a description of an implementation framework that will allow development of other functions that will benefit from the merger of time and space considerations.},
 author = {Kezunovic, M. and Abur, A.},
 doi = {10.1109/JPROC.2005.857497},
 issn = {1558-2256},
 journal = {Proceedings of the IEEE},
 keyword = {Merging;Power systems;Monitoring;Power system protection;Power system control;Control systems;SCADA systems;Automatic control;Substations;Data mining;Communication protocols;fault diagnosis;spatial data structures;state estimation;time measurement},
 month = {Nov},
 number = {11},
 pages = {1909-1919},
 title = {Merging the Temporal and Spatial Aspects of Data and Information for Improved Power System Monitoring Applications},
 volume = {93},
 year = {2005}
}
