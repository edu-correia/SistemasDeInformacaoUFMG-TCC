@article{Neuhold20031,
 abstract = {Although digital libraries are tailored to the information needs of a specific community, they are large and broad enough in scope to create individual information overload. Digital library personalization reduces the gap between the content offered by the library and individual information needs. Based on an extended view on personalization in digital libraries, this paper discusses various personalization methods for digital libraries. The advantages and challenges of founding personalization on a better understanding of the library user is illustrated by three advanced personalization approaches: Personal Reference Libraries, Collaborative Content Annotation, and modeling and exploitation of Personal Web Context. Each of these approaches focuses on another individual aspect in the interaction between the library and its user. In addition, we also take a closer look at the limitations and challenges of personalization in digital library. © Springer-Verlag Berlin Heidelberg 2003.},
 author = {Neuhold, Erich and Niederée, Claudia and Stewart, Avaré},
 doi = {10.1007/978-3-540-24594-0_1},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 19},
 pages = {1 - 16},
 publication_stage = {Final},
 source = {Scopus},
 title = {Personalization in digital libraries - An extended view},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/0348216528?origin=resultslist},
 volume = {2911},
 year = {2003}
}
