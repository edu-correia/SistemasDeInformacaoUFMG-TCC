@article{KAEWCHOOTHONG2026129515,
 abstract = {This study numerically examines hybrid microchannels that integrate curved pin-fin arrays with wavy endwalls for turbine trailing-edge cooling. Curved fins generate secondary vortices while wavy contours periodically disturb boundary-layer growth, creating synergistic mixing that enhances heat transfer. Simulations using the realizable k–ε model were performed for Reynolds numbers 5000–14,000 and waviness ratios b/Sx = 0–0.75. The hybrid design increases endwall Nusselt numbers by up to 30% and pin-fin heat transfer by 12%, with friction penalties limited to 7–10%. Compact Nu–f correlations (R2 > 0.98 for Nu; 0.91 for f) provide rapid performance prediction. The results demonstrate that hybrid wavy–curved configurations offer an effective, AM-compatible cooling strategy for next-generation aeroengine components.},
 author = {Natthaporn Kaewchoothong and Sarawut Gonsrang},
 doi = {https://doi.org/10.1016/j.applthermaleng.2025.129515},
 issn = {1359-4311},
 journal = {Applied Thermal Engineering},
 keyword = {Curved pin fins, Wavy walls, Turbine blade cooling, Heat transfer augmentation, Thermal–hydraulic performance, Hybrid microchannel},
 pages = {129515},
 title = {Thermal–fluid optimization in hybrid microchannels: Merging wavy wall patterns with curved pin-fin arrays},
 url = {https://www.sciencedirect.com/science/article/pii/S1359431125041079},
 volume = {288},
 year = {2026}
}
