@article{Dobashi20253808,
 abstract = {Current Data Space initiatives in Europe, Japan, and the Asia-Pacific region have developed heterogeneous architectures shaped by local regulatory requirements and strategic priorities, leading to fragmentation and limited interoperability. To address this challenge, this paper proposes the Data Space High-Level Architecture Model (DS-HLAM), a unifying framework that abstracts diverse architectural approaches while maintaining implementation flexibility. The model introduces five fundamental component sets: Organizations, Data Provision Mechanisms, Data Units, Social Mechanisms, and Rules. It defines mathematically rigorous success conditions through seven fundamental operations, classified into Data Service Methods and Data Governance Methods, and formalized using finite state automata. These operations are represented in a transaction lifecycle automaton, ensuring interoperability, logical consistency, and data sovereignty in cross-ecosystem collaboration. © 2025 IEEE.},
 author = {Dobashi, Masaru and Toshimitsu, Kohei and Seike, Hirotsugu and Kanno, Miki and Horie, Genki and Koshizuka, Noboru},
 doi = {10.1109/BigData66926.2025.11400920},
 journal = {Proceedings of the IEEE International Conference on Big Data, BigData},
 note = {Cited by: 0},
 number = {2025},
 pages = {3808 - 3817},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Proposal for High-Level Architectural Model Capable of Expressing Various Data Collaboration Platform and Data Space Concepts},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105037813355?origin=resultslist},
 year = {2025}
