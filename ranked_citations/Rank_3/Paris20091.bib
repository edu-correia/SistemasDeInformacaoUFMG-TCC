@conference{Paris20091,
 abstract = {Virtual Geographic Environment (VGE) technique derives from Geographic Information Systems (GIS) and Virtual Reality (VR). A VGE represents three dimensional geographic data, to target visualisation as well as simulation applications. It is generally built upon a grid-based representation which raises the well-known problems of localised data accuracy and multiple data merging. In this paper we propose a novel approach of VGE using a topological model. This approach provides an exact representation of GIS data, allowing an accurate geometrical exploitation. Moreover, our model can merge and represent several semantic information, even if spatially overlapping. Finally, we illustrate this model with a VGE application which is able to automatically extract the required data from standard GIS files, and which then allows to navigate and retrieve information from the computed VGE. © 2009 IEEE.},
 author = {Paris, Sébastien and Mekni, Mehdi and Moulin, Bernard},
 doi = {10.1109/GEOWS.2009.10},
 journal = {Proceedings of the International Conference on Advanced Geographic Information Systems and Web Services, GEOWS 2009},
 note = {Cited by: 13},
 pages = {1 - 6},
 publication_stage = {Final},
 source = {Scopus},
 title = {Informed Virtual Geographic Environments: An accurate topological approach},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/63749088649?origin=resultslist},
 year = {2009}
}
