@inproceedings{6412296,
 abstract = {Energy consumption of optical switching nodes of the Internet core networks is becoming a critical issue due to increasing traffic rates and rapid integration of all-IP based 4th generation cellular telephony networks. Recent research efforts show that waveband grouping has potential in alleviating this problem. Success of waveband grouping depends on the selection of appropriate grouping policies. By analysing the available end-to-end and sub-path merging waveband grouping policies, we develop two alternative approaches. Simulations show that these have significant energy saving potential.},
 author = {Dharmaweera, N. and Parthiban, R. and Sekercioglu, Y. Ahmet},
 booktitle = {TENCON 2012 IEEE Region 10 Conference},
 doi = {10.1109/TENCON.2012.6412296},
 issn = {2159-3450},
 keyword = {Ports (Computers);Transponders;Power demand;Optical switches;Energy consumption;Optical fiber networks},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Waveband grouping policies for reducing energy consumption in optical internet backbone networks},
 volume = {},
 year = {2012}
}
