 issn = {0307-4358},
 journal = {Managerial Finance},
 keyword = {Access to credit, Banking, Banking competition, Consumer finance, Financial access, Fintech, Peer-to-peer lending, D14, G10, G21, G23, G51},
 number = {3},
 pages = {413-435},
 title = {Examining the complementary relationship between peer-to-peer lending and traditional banks in the USA},
