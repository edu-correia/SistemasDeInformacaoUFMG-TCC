@inproceedings{10704383,
 abstract = {This paper proposes an ensemble learning prediction model (Voting-Cascading) for metal additive manufacturing lattice structure maximum stress prediction. Multiple estimators are merged for training and prediction, drawing inspiration from ensemble learning, and the cascade concept is employed to learn more about the data. Lastly, a combination of the soft voting approaches yields the final prediction result. According to the experimental findings, the suggested model's root mean square error on the test set is 9.5, which is better than several ensemble learning models.},
 author = {Zhang, Zhiwei and Wang, Bingyang and Zhang, Chao and Wang, Jingzhao and Liu, Xiaotong and Wang, Sijia},
 booktitle = {2024 6th International Conference on Data-driven Optimization of Complex Systems (DOCS)},
 doi = {10.1109/DOCS63458.2024.10704383},
 issn = {},
 keyword = {Training;Lattices;Metals;Predictive models;Three-dimensional printing;Ensemble learning;Root mean square;Complex systems;Stress;Optimization;Additive manufacturing;lattice structure;Inher-ent defects;Maximum stress prediction;Voting-Cascading},
 month = {Aug},
 number = {},
 pages = {470-474},
 title = {A Prediction Model for Maximum Stress of Additive Manufacturing Lattice Structures Based on Voting-Cascading},
 volume = {},
 year = {2024}
}
