@inproceedings{5209253,
 abstract = {This paper presents a novel scheme for news video structure indexing and news story clip retrieving. Instead of using low-level features, the method is built upon the combination of topic content and visual features. First of all, a new method of topic caption text detection is proposed in which the topic caption frame is detected by features extraction from frame differences, the topic caption lasting time and times of caption transition in the same shot, and the dynamic split-merge strategy is used to segment individual character. Afterwards, one news video is segmented into a series of news story clips on the basis of topic caption text and silence clip. Finally, a reasonable model is built to retrieve news story clips by both visual similar degree and topic content relativity between two news clips with strong semantic meaning. The experimental results showed that the proposed method could effectively detect and recognize topic caption text and index news story clips.},
 author = {Yaqin, Zhao and Jiaqiang, Zheng and Hongping, Zhou},
 booktitle = {2009 WRI Global Congress on Intelligent Systems},
 doi = {10.1109/GCIS.2009.362},
 issn = {2155-6091},
 keyword = {Information retrieval;Indexing;Gunshot detection systems;Content based retrieval;Layout;TV;Brightness;Intelligent systems;Intelligent structures;Educational institutions},
 month = {May},
 number = {},
 pages = {477-481},
 title = {News Video Clip Retrieval Based on Topic Caption Text and Audio Information},
 volume = {4},
 year = {2009}
}
