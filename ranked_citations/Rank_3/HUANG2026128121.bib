@article{HUANG2026128121,
 abstract = {This study investigates the three-dimensional (3D) dynamics of a short plane turbulent impinging jet (PTIJ) under lithography-relevant conditions—low impinging ratios (H/b=3∼5, where H is the orifice-to-plate distance and b is the orifice width) and a typical Reynolds number (Reb=1.8×103, based on b) in lithography. Using time-resolved tomographic particle image velocimetry (Tomo-PIV) and time-domain spectral proper orthogonal decomposition (td-SPOD), the spatiotemporal evolution of large-scale coherent structures and their impact on mass transport are analyzed. Results reveal distinct frequency characteristics: for impinging ratios of 3 and 4, leading and trailing vortex pairs exhibit separate frequencies, leading to intermittent merging downstream. In contrast, H/b=5 demonstrates a single dominant frequency similar to free jet shedding. Vortex merging initiates at the same non-dimensional streamwise locations for all impinging ratios, with discontinuous merging observed at lower impinging ratios due to frequency mismatches. Three-dimensional distortions, including wavy deformations and cross ribs spanning the symmetry plane, are prevalent for all cases over extended streamwise lengths. These successive ribs which connect adjacent vortices enhance mass entrainment, particularly at higher impinging ratio. Entrainment analysis highlights a streamwise entrainment-to-detrainment transition, which is caused by the influence of impinging plate for all impinging ratios. For instantaneous velocity fields, entrainment peaks correlate with vortex passage and streamwise ribs between vortex pairs may also contribute, underscoring the intrinsic 3D nature of PTIJ and their impact on entrainment. The observed merging behaviors of vortex pairs, and streamwise and lateral deformations along with their impact on entrainment, suggest the importance of 3D effects in contamination control in lithography.},
 author = {Zijun Huang and Hao Qu and Xin Zeng and Chuangxin He and Yingzheng Liu},
 doi = {https://doi.org/10.1016/j.ijheatmasstransfer.2025.128121},
 issn = {0017-9310},
 journal = {International Journal of Heat and Mass Transfer},
 keyword = {Plane turbulent impinging jet, Coherent structure, Entrainment, Tomo-PIV},
 pages = {128121},
 title = {On three-dimensional behaviours of a short plane purging jet impinging on wafer stage of lithography machine: Time-resolved tomographic particle image velocimetry measurement},
 url = {https://www.sciencedirect.com/science/article/pii/S0017931025014565},
 volume = {256},
 year = {2026}
}
