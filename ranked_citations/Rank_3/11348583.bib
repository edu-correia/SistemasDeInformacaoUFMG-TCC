@inproceedings{11348583,
 abstract = {In this paper, a multi-modal 3D target detection method based on multi-stage merging and fusion is proposed. Taking lidar point cloud and binocular image as input, a hierarchical detection framework of ' coding-alignment-fusiondecision ' is constructed. The LiDAR branch uses PointPillars to achieve efficient BEV coding. The image branch returns the three-dimensional bounding box through YOLO3 D and aligns to the unified coordinate system. The fusion branch introduces TAM and RAM modules in ROI-Attention for geometric alignment and feature complementation. The experiment verifies the advantages of the method in small target, occlusion and distance detection on the KITTI dataset. The 3D detection accuracy is $2.3 \%, 2.9 \%$ and 3.9 % higher than the baseline under each difficulty, and the inference time is 51 ms, taking into account both accuracy and real-time performance. This method provides a new idea for efficient 3D object detection in multi-modal sensing tasks and lays a technical foundation for actual deployment.},
 author = {Zhang, Peng and Yan, Yongjun and Du, Chao and Wang, Yizhou and Wang, Weihua and Pi, Dawei},
 booktitle = {2025 9th CAA International Conference on Vehicular Control and Intelligence (CVCI)},
 doi = {10.1109/CVCI66304.2025.11348583},
 issn = {},
 keyword = {Point cloud compression;Three-dimensional displays;Laser radar;Accuracy;Merging;Random access memory;Object detection;Real-time systems;Encoding;Sensors;Autonomous vehicles;3D target detection;Multi-modal data fusion;deep learningr},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {A Multi-Modal 3D Target Detection Method Based on Multi-Stage Merging and Fusion},
