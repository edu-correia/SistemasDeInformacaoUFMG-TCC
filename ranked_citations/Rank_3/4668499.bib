@article{4668499,
 abstract = {In this paper, a novel and area-efficient variable length decoder (VLD) for MPEG-1/2/4 is presented. Instead of carrying out every variable length coding table with one dedicated lookup table (LUT) directly, we employ an efficient clustering-merging technique to reduce both the size of a single LUT and the total number of LUTs required for MPEG-1/2/4. Synthesis results show that our VLD occupies 10666 gate counts and operates at 125 MHz by using the standard cell from Artisan TSMC's 0.18 mum process. As demonstrated, the proposed design outperforms other VLDs with less hardware cost. It can decode a symbol of different standards in every cycle and support video resolution of HD1080 at 30 frames/s for MPEG-1/2/4 real-time decoding.},
 author = {Chen, Pei-Yin and Lin, Yi-Ming and Cho, Min-Yi},
 doi = {10.1109/TMM.2008.2004909},
 issn = {1941-0077},
 journal = {IEEE Transactions on Multimedia},
 keyword = {Decoding;Table lookup;Transform coding;MPEG 4 Standard;Costs;Throughput;Hardware;Educational institutions;Clocks;Detectors;Area-efficient;MPEG-1/2/4;variable length decoder},
 month = {Nov},
 number = {7},
 pages = {1307-1315},
 title = {An Efficient Design of Variable Length Decoder for MPEG-1/2/4},
 volume = {10},
 year = {2008}
}
