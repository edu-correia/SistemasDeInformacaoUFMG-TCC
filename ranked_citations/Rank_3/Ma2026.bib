@article{Ma2026,
 abstract = {As blockchain ecosystems expand, the storage layer has emerged as one of the primary scalability bottlenecks. The structural mismatch between the Merkle Patricia Trie (MPT) and the underlying Log-Structured Merge Tree (LSM-Tree) databases in account-model blockchains leads to severe read amplification. In this paper, we propose Harvester, a transaction-driven heterogeneous caching mechanism. Unlike traditional unified caches, Harvester implements a decoupled architecture that prioritizes critical state access by autonomously discovering hotspot accounts from historical blockchain execution behaviors. To address the dynamic nature of transaction distributions, we introduce the Tree-structured Parzen Estimator (TPE) to adaptively tune scoring parameters through a closed-loop feedback mechanism. Extensive evaluations using a real-world Ethereum dataset demonstrate that Harvester effectively mitigates database I/O pressure and accelerates block processing throughput compared to the native go-ethereum implementation. By lowering the hardware entry barrier for state management, Harvester provides a scalable and resource-efficient way to enhance the decentralization of the blockchain network. © 2026 Elsevier B.V.},
 author = {Ma, Zhiyu and Li, Xiaofeng and Zhao, He and Yu, Bin and Zhou, Tong and Sheng, Nianzu},
 doi = {10.1016/j.comnet.2026.112089},
 journal = {Computer Networks},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Harvester: A transaction-driven heterogeneous caching mechanism for blockchain},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105030210989?origin=resultslist},
 volume = {278},
 year = {2026}
}
