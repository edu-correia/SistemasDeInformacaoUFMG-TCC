@article{11096000,
 abstract = {This brief presents a calibration-free 12-bit 1.5-GS/s pipelined ADC employing a merged sub-ADC quantization (MSAQ) technique. Building upon the conventional pipelined ADC architecture, the proposed technique can extend the amplification time, thereby relaxing the design of the inner-stage residue amplifier. A prototype ADC implemented in a 28-nm CMOS technology achieves an SFDR of 70.52 dB and an SNDR of 58.03 dB at a Nyquist input, while consuming 18.5 mW from a 1-V supply. It yields Schreier and Walden figure of merits (FoM) of 164.1 dB and 18.9 fJ/conv.-step, respectively.},
 author = {Su, Chun-Tse and Hsu, Chao-Yen and Lee, Tai-Cheng},
 doi = {10.1109/TCSII.2025.3592475},
 issn = {1558-3791},
 journal = {IEEE Transactions on Circuits and Systems II: Express Briefs},
 keyword = {Quantization (signal);Power demand;Prototypes;Calibration;Training;Synchronization;Pipeline processing;Error correction;Data mining;Codes;Pipelined ADC;merged sub-ADC quantization (MSAQ);ring amplifier;calibration-free;single channel},
 month = {Sep.},
 number = {9},
 pages = {1168-1172},
 title = {A Calibration-Free 12-Bit 1.5-GS/s Pipelined ADC With Merged Sub-ADC Quantization Technique},
 volume = {72},
 year = {2025}
}
