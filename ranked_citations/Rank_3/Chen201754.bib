@conference{Chen201754,
 abstract = {This paper proposes a fast coding algorithm based on statistical probability and inter-view correlation to reduce the coding complexity of the texture and depth map for 3D-HEVC. The conditional probabilities of the current coding unit(CU) and its reference CUs are computed to determine the early termination of CUs. The search range is adjusted and the prediction unit(PU) is fast decided by utilizing the interview correlation to accelerate the coding of the dependent view. The experimental results show that the proposed algorithm can provide better rate-distortion performance and larger time-saving than previous work. CSREA Press ©},
 author = {Chen, Yu-Ting and Lin, Jie-Ru and Chen, Mei-Juan and Chen, Jeng-Wei},
 journal = {Proceedings of the 2017 International Conference on Image Processing, Computer Vision, and Pattern Recognition, IPCV 2017},
 note = {Cited by: 0},
 pages = {54 - 57},
 publication_stage = {Final},
 source = {Scopus},
 title = {Probability based fast prediction by using inter-view correlation for 3D video coding},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85072914717?origin=resultslist},
 year = {2017}
}
