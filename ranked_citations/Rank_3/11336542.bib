@inproceedings{11336542,
 abstract = {As part of the research carried on in GeoIQ, which aims to provide information on the population, vegetation, and disaster distribution in the the country of India, Geo-Spatial Data Retrieval has been created to provide an easy to use, sophisticated, and geo-spatial data on population and vegetation index, and the occurrence of disaster. This is made possible through the use of the LLMs and the LangChain based natural language query of the platform, which allows users to ask questions conversationally and does not require technical skills. Integration of different data sets, such as census demographic data, vegetation index data, and disaster data, allows GeoIQ to provide multiple data dimensions to improving the understanding of human population, ecology, and disaster risks, which improves human population. GeoIQ aims to provide intuitive aids, and as such, employs dynamic maps, dynamic representations, and layers and styles which users can control, to improve the ease of understanding and the effectiveness of geo-spatial data. This allows GeoIQ to assist the users in environment resource management, and disaster readiness GeoIQ to assist the user in urban resource management and disaster readiness. GeoIQ is the first to successfully merge AI-led language analysis and geospatial analytics, hence democratizing spatial intelligence.},
 author = {Yadav, Sneha and Joshi, Raunak and Raut, Neha and Gharat, Kshitija},
