 issn = {},
 keyword = {Disasters;Large language models;Urban planning;Vegetation mapping;Data visualization;Natural language processing;Geospatial analysis;Systems support;Resource management;Indexes;Geospatial Data;Geographic Information Systems (GIS);Interactive Mapping;Large Language Models},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Geo-IQ: Prompt Based Natural Language Retrieval for Geo-Spatial Data},
