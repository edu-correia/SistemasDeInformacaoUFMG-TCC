@inproceedings{11229232,
 abstract = {Video Moment Retrieval (MR) and Highlight Detection (HD) have drawn significant attention due to the growing demand for advanced video understanding. Previous approaches predominantly conceptualize MR and HD as unified video-text alignment tasks and employ transformer-based architectures with multimodal interaction modules. However, these methods struggle to capture contextualized semantic associations in long videos and are prone to attention noise, where transformers may disproportionately focus on irrelevant video segments, resulting in suboptimal localization accuracy. To address these issues, we propose Diff-DETR, a novel framework designed to mitigate attention noise and enhance cross-modal feature alignment for precise localization. The core of Diff-DETR is to incorporate a differential attention mechanism into the transformer decoder, suppressing irrelevant signals while emphasizing contextually relevant cues. Furthermore, to enrich the semantic relationships within the multimodal embeddings, we design a multimodal encoder with a large language model (LLM)-based semantic enhancement module, which seamlessly merges visual and textual features to enhance semantic understanding. Extensive experiments on QVHighlights, TACoS, Charades-STA, and TVSum demonstrate Diff-DETR’s efficacy and practicality, achieving state-of-the-art performance in MR and HD tasks.},
 author = {Wang, Peng and Meng, Rui and Qu, Bingqing},
 booktitle = {2025 International Joint Conference on Neural Networks (IJCNN)},
 doi = {10.1109/IJCNN64981.2025.11229232},
 issn = {2161-4407},
 keyword = {Location awareness;Visualization;Attention mechanisms;Large language models;Semantics;Noise;Neural networks;Transformer cores;Transformers;Videos;Video Moment Retrieval;Highlight Detection;Differential Attention Mechanism;LLM},
 month = {June},
 number = {},
 pages = {1-8},
 title = {Diff-DETR: Differential Attention Transformer for Video Moment Retrieval and Highlight Detection},
 volume = {},
 year = {2025}
}
