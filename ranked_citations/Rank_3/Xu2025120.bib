@conference{Xu2025120,
 abstract = {Global communication made by the new technology revolution transformed the interaction of knowledge among disciplines in a new way and thus created two new opportunities and challenges for knowledge computing service systems. Present bottlenecks mainly consist of the following issues: One is massive data increase, which takes advantage of the exponential growth of computing power and reduces the opportunities for scholar to access data and two is lagging or absent standard rules, which hinders scholarly data distribution and circulation between scholars.This study adopts an application-oriented framework consisting of case analysis, validation and solution extraction to address improvement opportunities for computational services of data sharing systems. Fragmented cross-disciplinary data communication standardization, ownership confusion, rigid management mode and lack of a flexible service design are observed to be the major operational obstacles of data sharing systems.The comparison of state-of-art implementation in teaching, learning, science, and technology reveals significant sharing paradigms and opportunities for innovation through discussing platform-based resolution possibilities leading to multidimensional optimization proposals in technical, service and regulation. © 2025 Copyright held by the owner/author(s).},
 author = {Xu, Liming},
 doi = {10.1145/3736426.3736447},
 journal = {Proceedings of 2025 International Conference on Digital Management and Information Technology, DMIT 2025},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {120 - 125},
 publication_stage = {Final},
 source = {Scopus},
 title = {Transformation and Innovation in Computer Science Services Driven by Data Sharing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105012174967?origin=resultslist},
