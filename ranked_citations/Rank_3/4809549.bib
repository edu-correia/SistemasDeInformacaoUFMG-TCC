@inproceedings{4809549,
 abstract = {Interleaved Source Coding (ISC) is one of the error resilient coding methods for predictive video coded frames transmitted over a single erasure channel. ISC has shown to significantly improve the overall quality of predictive coded video stream over a lossy channel. In this paper, ISC is evaluated over memoryless Binary Erasure Channel (ISC-BEC). Simulations have shown the superiority of ISC over memoryless BEC compared to the traditional method.},
 author = {Jin Young Lee and Hayder Radha and Jeong Ju Yoo},
 booktitle = {2009 11th International Conference on Advanced Communication Technology},
 doi = {},
 issn = {1738-9445},
 keyword = {Source coding;Interleaved codes;Decoding;Corporate acquisitions;Streaming media;Video sequences;Video coding;Propagation losses;Delay;Merging;Interleaving;Packet Losses;Binary Erasure Channel;Video Coding},
 month = {Feb},
 number = {},
 pages = {2346-2350},
 title = {Evaluation of Interleaved Source Coding over memoryless Binary Erasure Channel},
 volume = {03},
 year = {2009}
}
