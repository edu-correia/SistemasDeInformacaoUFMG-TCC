@inproceedings{11178985,
 abstract = {Understanding cell-cell communication is crucial for deciphering the complex behaviors of multicellular organisms. However, current biological experiments and computational methods for inferring these interactions face significant limitations, including excessive reliance on ligand-receptor interaction (LRI) libraries, failure to fully capture complex interaction patterns, and inadequate clustering accuracy. To overcome these challenges, we propose a novel method for inferring intercellular communication relationships that operate independently of LRI libraries. Our approach utilizes network structural characteristics and improves clustering accuracy through innovative strategies such as graph wavelet weighting, core attachment-structure analysis, and coupling strength assessment. This method enables the discovery of previously unknown communication relationships, extracts multidimensional information, and addresses the limitations of existing techniques. Ultimately, this study aims to enhance our understanding of cell communication mechanisms and contributes to the investigation of related diseases.},
 author = {Bai, Qianxiang},
 booktitle = {2025 44th Chinese Control Conference (CCC)},
 doi = {10.23919/CCC64809.2025.11178985},
 issn = {1934-1768},
 keyword = {Wavelet transforms;Couplings;Accuracy;Noise;Wavelet analysis;Libraries;Stability analysis;Organisms;Reliability;Diseases;Inference of cell-cell communication;Graph wavelet;LRI libraries},
 month = {July},
 number = {},
 pages = {6939-6944},
 title = {Cell Type Based Cell-Cell Communication Inference via Multi-Scale Network Modeling},
 volume = {},
 year = {2025}
}
