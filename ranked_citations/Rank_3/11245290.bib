@inproceedings{11245290,
 abstract = {Dilated convolution and transposed convolution are widely used in the inference or backpropagation of generative adaptive networks (GANs) and convolutional neural networks (CNNs). They introduce non-contributing zeros in structured sparsity patterns (called regular sparsity in this work) into the kernels or into the feature maps as an inherent pre-processing stage before executing standard convolution operations. Existing accelerator designs typically pre-populate tensors with explicit zero values and then perform sparse computing on the zeropopulated tensors, which incurs high control complexity and hardware overhead. To address this, we propose CRSPU, a systolic array-based accelerator exploiting regular sparsity without modifying its original data flow. We redesign the traditional im2col algorithm with two address-level optimizations—Public Dimension Compression (PDC) and Similar Sparsity Merging (SSM)—to eliminate unnecessary computations induced by non-contributing zeros. We implemented CRSPU in RTL and the experiments show that CRSPU achieves a peak throughput of 7736 GOPS, with area and PE efficiencies of $2046.56 \text{GOPS} / \text{mm}^{2}$ and $30.22 \text{GOPS} / \text{PE}$, respectively. Compared with the state-of-the-art GANPU accelerator, CRSPU improves CycleGAN training speed by $1.36 \times$, achieves $7.09 \times$ higher PE efficiency, and reduces on-chip bandwidth requirements by up to 54.63%. On average, it achieves 93.27% PE utilization across various GAN workloads, demonstrating strong efficiency and scalability.},
 author = {Yang, Jingkui and Yang, Jianchao and Wen, Mei and Shen, Junzhong and Cao, Yasong and Tang, Minjin and Yang, Renyu and Ju, Xin and Chen, Zhaoyun and Shi, Yang and Zhang, Chunyuan},
 booktitle = {2025 IEEE International Symposium on Parallel and Distributed Processing with Applications (ISPA)},
 doi = {10.1109/ISPA67752.2025.00019},
 issn = {2158-9208},
 keyword = {Training;Tensors;Convolution;Scalability;Bandwidth;Throughput;Systolic arrays;Hardware;System-on-chip;Standards;structured sparsity;convolutions;systolic array;accelerator design},
 month = {Oct},
 number = {},
 pages = {70-77},
 title = {CRSPU: Exploit Commonality of Regular Sparsity to Support Various Convolutions on Systolic Arrays},
 volume = {},
 year = {2025}
}
