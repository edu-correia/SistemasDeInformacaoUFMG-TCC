@conference{Sharma20137,
 abstract = {With the advent of Twitter, the follow model has become pervasive across social networks. The follow model enables users to follow other users i.e. subscribe to content created by other users, thereby, establishing the concept of a following feed for a user. At Pinterest, we continually store, update and serve feeds for millions of users and fan out millions of newly created pins/repins to thousands of followers, leading to billions of operations everyday. We describe the current feed storage solution, backed by Apache HBase, at Pinterest. We describe how we handle data management challenges unique to our scale, in the wake of strict performance and availability requirements. We also present a qualitative comparison to our previous "following feed" architecture, backed by Redis. © 2013 IEEE.},
 author = {Sharma, Varun and Carroll, Jeremy and Khune, Abhi},
 doi = {10.1109/SocialCom.2013.7},
 journal = {Proceedings - SocialCom/PASSAT/BigData/EconCom/BioMedCom 2013},
 note = {Cited by: 0},
 pages = {7 - 12},
 publication_stage = {Final},
 source = {Scopus},
 title = {Scaling deep social feeds at Pinterest},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84893609644?origin=resultslist},
 year = {2013}
}
