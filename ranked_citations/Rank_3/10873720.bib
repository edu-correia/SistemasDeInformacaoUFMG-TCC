@inproceedings{10873720,
 abstract = {Face images contain rich and sensitive personal information. Direct release of facial images on the Internet may lead to the disclosure of personal information. In order to protect the privacy information in facial images, this paper proposes a PMP method based on neighboring pixels merging, which meets the requirements of differential privacy. First, the gray scale matrix of the face image is leveled into a one-dimensional data stream and the position index of each pixel is recorded while traverse through the pixels. Given the large number of duplicate pixels in the face image, duplicate pixels as well as neighboring pixels were grouped to reduce the sensitivity of differential privacy, and noise was subsequently added to each group. Eventually, each pixel is replaced to its original position according to the index, and the new one-dimensional data stream is converted back to the original matrix structure. The experiment based on real face image data set used the combination of support vector machine (SVM) and principal component analysis (PCA). The results show that the PMP algorithm is 30.57% higher than the LAP algorithm in terms of the average accuracy of face recognition, and the proposed PMP algorithm has higher usability and robustness.},
 author = {Lang, Ming and Yongli, Wang and Yuanyuan, Huang and Junyu, Chen},
 booktitle = {2024 21st International Computer Conference on Wavelet Active Media Technology and Information Processing (ICCWAMTIP)},
 doi = {10.1109/ICCWAMTIP64812.2024.10873720},
 issn = {2576-8964},
 keyword = {Support vector machines;Differential privacy;Privacy;Sensitivity;Publishing;Face recognition;Noise;Streaming media;Protection;Matrix converters;Face images;Privacy information;Pixels in the face image;Privacy protection mapping},
 month = {Dec},
 number = {},
 pages = {1-4},
 title = {Differential Privacy Face Image Publishing Method Based on Neighboring Pixels Merging},
