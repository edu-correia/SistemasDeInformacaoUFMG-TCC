@article{SklarChik2016_592,
 abstract = {The purpose of this paper is to critically review the 'levelised cost of energy' metric used in electricity project development. This metric is widely used, because it is a simple metric to calculate the cost per unit of electricity for a given technology connected to the electricity network. However, it neglects certain key terms such as inflation, integration costs, and system costs. The implications of incorporating these additional costs would provide a more comprehensive metric for evaluating electricity generation projects, and for the system as a whole. It is therefore recommended to refine the metric for the South African context.},
 author = {Sklar-Chik, M.D. and Brent, A.C. and de Kock, I.H},
 doi = {10.7166/27-4-1496},
 number = {4},
 pages = {124--133},
 title = {Critical review of the levelised cost of energy metric},
 volume = {27},
 year = {2016}
}
