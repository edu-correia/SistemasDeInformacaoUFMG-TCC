@inproceedings{6272705,
 abstract = {According to the feather of digital-physical hybrid Smart substation simulation system, combining the requirement of the IEC61850 to the interface of bay level devices, a connection implementation between the simulated primary system and real secondary devices is put forward. Simulation-used Merging unit and intelligent terminal with fault simulation function is built by using W5100 as core controller in Ethernet module, and EP3C80 as microprocessor. The information model of device is established in the way of nested structure description and concentration data storage. SMV, GOOSE message and virtual terminal rows can be configured dynamically by MMS service. Practice shows that the communication between the Simulation-used process level devices and primary simulation part, secondary devices works well, and the whole substation training and simulation system operates normally.},
 author = {Bing-da, Zhang and Peng, Wu},
 booktitle = {2012 IEEE International Conference on Computer Science and Automation Engineering (CSAE)},
 doi = {10.1109/CSAE.2012.6272705},
 issn = {},
 keyword = {Substations;Switches;Registers;Solid modeling;Training;Artificial intelligence;Merging;Smart Substation;Training and Simulation;Merging Unit;Intelligent Terminal;Information Model},
 month = {May},
 number = {},
 pages = {775-779},
 title = {Research on simulation-used devices of process level},
 volume = {1},
 year = {2012}
}
