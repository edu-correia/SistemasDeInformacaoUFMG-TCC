@inproceedings{5414241,
 abstract = {In this paper, we present motion-refined transcoding of H.264/AVC streams to SVC in the transform domain. By accurately taking into account both rate and distortion in the different layers on the one hand, and the SVC inter-layer motion prediction mechanisms on the other hand, the proposed transcoding architecture is able to improve rate-distortion performance over existing approaches. We propose a multilayer control mechanism that trades off performance between the different layers, resulting in 0.5 dB gains in the output SVC base layer.},
 author = {De Cock, Jan and Notebaert, Stijn and Vermeirsch, Kenneth and Lambert, Peter and Van de Walle, Rik},
 booktitle = {2009 16th IEEE International Conference on Image Processing (ICIP)},
 doi = {10.1109/ICIP.2009.5414241},
 issn = {2381-8549},
 keyword = {Transcoding;Automatic voltage control;Static VAr compensators;Streaming media;Rate-distortion;Decoding;Bit rate;Rate distortion theory;Computer architecture;Information systems;transcoding;rewriting;H.264/AVC;SVC},
 month = {Nov},
 number = {},
 pages = {3673-3676},
 title = {Transcoding of H.264/AVC to SVC with motion data refinement},
 volume = {},
 year = {2009}
}
