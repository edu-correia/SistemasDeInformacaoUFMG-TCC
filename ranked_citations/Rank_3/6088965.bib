@inproceedings{6088965,
 abstract = {A new architecture has been proposed for the symbol deinterleaver used in DVB-T channel decoder. In conventional architecture of the symbol deinterleaver two separate single-port RAMs have been used for buffering odd and even OFDM symbols. In this paper we show that these two RAMs can be merged so that only one single-port RAM for buffering of both odd and even symbols would be used and hence the required memory space will be reduced by half. Also, an architecture for address generator has been designed for generating consecutive valid addresses. Due to the simplicity of the proposed architecture, it can be easily implemented; however, the operation clock-frequency doubled with respect to the conventional two-RAM architecture.},
 author = {Tanhaei, Hamid Reza and Rezaee, Mojtaba},
 booktitle = {2011 IEEE Workshop on Signal Processing Systems (SiPS)},
 doi = {10.1109/SiPS.2011.6088965},
 issn = {2162-3570},
 keyword = {Random access memory;Digital video broadcasting;OFDM;Clocks;Generators;Computer architecture;Hardware;DVB;channel coding;symbol interleaving},
 month = {Oct},
 number = {},
 pages = {146-150},
 title = {An area-efficient symbol deinterleaver architecture for DVB-T},
 volume = {},
 year = {2011}
}
