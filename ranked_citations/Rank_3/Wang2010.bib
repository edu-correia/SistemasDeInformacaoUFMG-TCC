@conference{Wang2010,
 abstract = {Image fusion techniques can integrate the spatial detail of the panchromatic image and the spectral characteristics of the multispectral image. Intensity-hue-saturation (IHS) transform and wavelet transform are widely used in the existed fusion methods. The fused image will appear significant color deviation from the original image when using them separately. In this paper, we propose a new IHS and wavelet transform integrate fusion method based on structural similarity (SSIM). First, the multispectral image is transformed from RGB to IHS color space, then decomposing the panchromatic image and the intensity component into wavelet planes. The approximate component of new intensity component is determined adaptively by the structural similarity (SSIM)between the panchromatic and the intensity component. ©2010 IEEE.},
 author = {Wang, Xiao-Yan},
 doi = {10.1109/ICMULT.2010.5631105},
 journal = {2010 International Conference on Multimedia Technology, ICMT 2010},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An IHS and wavelet integrated fusion method based on structural similarity},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/79952240514?origin=resultslist},
 year = {2010}
}
