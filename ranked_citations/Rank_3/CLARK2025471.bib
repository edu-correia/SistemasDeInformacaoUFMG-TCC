 abstract = {Several areas of biotechnology are advancing more rapidly than others. Perhaps the two most obvious are genome editing technology using CRISPR and emerging novel roles for RNA. This chapter tackles a third area. Unlike the other two, this area lies on the boundary where biotechnology merges with computer science and electronics. The Bionic Man was once science fiction. Today it is emerging as a reality. In addition, artificial intelligence is increasingly being used to solve biological problems that involve vast amounts of data. The biggest success so far has been the solution of the 3D structure of proteins. Obviously, we provide the biological angle on this area of fusion.},
 author = {David P. Clark and Nanette J. Pazdernik and Michelle R. McGehee and Bethany A. Rader},
