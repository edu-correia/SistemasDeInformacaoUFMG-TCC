@inproceedings{11492040,
 abstract = {Tables in business documents power analytics and compliance, yet task-specific datasets are costly to build. Practitioners therefore turn to zero-shot vision–language models (VLMs). We study zero-shot realism for table detection (TD) and table structure recognition (TSR) under a unified protocol on DocILE-QUEST and a private STM154 corpus. We report TD with GIoU, Purity, and Completeness, and TSR with TEDS and TEDS-S, evaluating commercial VLMs (GPT-4o, GPT-5-mini), compact detectors, and supervised YOLO/DETR baselines. Zero-shot VLMs are strong for TSR and competitive for TD, while fine-tuned or from-scratch detectors lead when box quality and robustness to clutter matter. We add an automated error taxonomy that isolates actionable failures (missed, merged/split tables, header–body confusions, cell topology). Finally, we quantify emissions, finding a 104 gap between the lightest and heaviest systems.},
 author = {Thomas, Eliott and Coustaty, Mickael and Joseph, Aurélie and Pham, Tri-Cong and Deloin, Gaspar and Carel, Elodie and D’Andecy, Vincent Poulain and Ogier, Jean-Marc},
 booktitle = {2026 IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)},
 doi = {10.1109/WACV61042.2026.00483},
 issn = {2642-9381},
 keyword = {Radio access networks;Regional area networks;Protocols;Location awareness;Pixel;Communication systems;Mobile communication;HTTP;Telecommunications;Digital images;zero-shot table extraction;table detection;table structure recognition;document ai},
 month = {March},
 number = {},
 pages = {4974-4983},
 title = {Zero-Shot Table Extraction in Business Documents: A Unified Benchmark with Error Taxonomy and Ecological Analysis},
 volume = {},
