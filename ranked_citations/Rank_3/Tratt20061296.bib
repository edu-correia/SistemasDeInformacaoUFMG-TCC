@conference{Tratt20061296,
 abstract = {Model transformations are recognised as a vital part of Model Driven Development, but current approaches are often simplistic, with few distinguishing features, and frequently lack an implementation. The practical difficulties of implementing an approach inhibit experimentation within the paradigm. In this paper, I present the MT model transformation language which was implemented as a low-cost DSL in the Converge programming language. Although MT shares several aspects in common with other model transformation languages, an ability to rapidly experiment with the implementation has led MT to contain a number of new features, insights and differences from other approaches. Copyright 2006 ACM.},
 author = {Tratt, Laurence},
 doi = {10.1145/1141277.1141577},
 journal = {Proceedings of the ACM Symposium on Applied Computing},
 note = {Cited by: 12},
 pages = {1296 - 1303},
 publication_stage = {Final},
 source = {Scopus},
 title = {The MT model transformation language},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33751062386?origin=resultslist},
 volume = {2},
 year = {2006}
}
