@article{Caruccio2014310,
 abstract = {We present a visual language based approach and tool to perform data integration at conceptual level, aiming to reduce the complexity of such task when integrating numerous and complex data sources. The visual language provides iconic operators to manipulate the constructs of conceptual data schemas of database sources, in order to specify how to merge and map them to a reconciled schema. The proposed tool allows not only to generate the relational reconciled schema, but also to automatically generate metadata and inference mechanisms to guarantee the loading and periodical refresh of data from source databases. Finally, we evaluated CoDIL through a usability study. © 2014 Springer International Publishing Switzerland.},
 author = {Caruccio, Loredana and Deufemia, Vincenzo and Moscariello, Mara and Polese, Giuseppe},
 doi = {10.1007/978-3-319-10085-2_28},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 number = {PART 2},
 pages = {310 - 317},
 publication_stage = {Final},
 source = {Scopus},
 title = {Data integration by conceptual diagrams},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84906708167?origin=resultslist},
 volume = {8645 LNCS},
 year = {2014}
}
