@inproceedings{5212658,
 abstract = {In view of unclear structure features and poor system for current fuzziness metric, we proposed a kind of F⊕S fuzziness metric model containing the existing metric methods by combining fuzziness feature function with fuzziness synthesizing operator; we also give the quantitative structural model of fuzziness feature function based on quasi-linear fuzzy function and the synthesizing operator structural model based on measure theory; then we give the application of F⊕S fuzziness metric by combining a comprehensive evaluation problem. All results indicate that F⊕S metric not only possesses better operability, but also can merge decision consciousness effectively into information processing. So it can be widely used in many fields such as complex system optimization and artificial intelligent.},
 author = {Zhi-Chen Tong and Zhi-Jun Wang and Chen-Xia Jin},
 booktitle = {2009 International Conference on Machine Learning and Cybernetics},
 doi = {10.1109/ICMLC.2009.5212658},
 issn = {2160-1348},
 keyword = {Measurement uncertainty;Fuzzy sets;Current measurement;Mathematical model;Machine learning;Cybernetics;Fuzzy set theory;Concrete;Conference management;Technology management;Fuzziness metric;Quasi-linear function;Fuzziness feature function;Fuzziness synthesizing operator;Uncertainty},
 month = {July},
 number = {},
 pages = {2759-2764},
 title = {Uncertain information measure system based on F⊕S fuzziness degree},
 volume = {5},
 year = {2009}
}
