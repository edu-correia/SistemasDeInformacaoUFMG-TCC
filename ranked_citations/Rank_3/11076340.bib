 keyword = {Training;Accuracy;Systematics;Collaborative software;Measurement uncertainty;Knowledge based systems;Ontologies;Prediction algorithms;Natural language processing;Time factors;Accuracy;Agriculture domain;Automatic ontology construction;Incremental Algorithm;Natural Language Processing;Prediction},
 month = {March},
 number = {},
 pages = {1418-1425},
 title = {Application of Natural Language Processing Methods to Automated Ontology Building for Domain-Dependent Information Acquisition},
