@inproceedings{7840352,
 abstract = {Compared with Taiwan's global metropolises, Tainan retains certain history and tradition. Also because of its close proximity to the sea, it offers rich natural resources and landscapes. More importantly, in Tainan one can witness both juxtaposition and integration of past lifestyles & customs and modern popular culture, constituting a unique urban milieu that not only insists on the tradition but also merges with contemporary spirits. Given such historic development and background, Tainan offers up a sizeable accumulation of photography assets, whether it be themes of ecology, art, humanistic documentation, weddings, memorials, families or historic photographs. A photography festival is a sphere where images can be re-presented and traditional culture can receive attention, resonance, allowing creativity infinite possibilities; it is also a great opportunity enabling the general public to re-visit the past while looking forward to the future. This paper will explore the positioning of feasible directions, themes, materials and framework packages if Tainan with unprecedented experience yet armed with favorable conditions is to host such events, as well as with a focus on whether photography festivals can yield cultural and creative benefits for the city to make an international impact, by way of the invisible force of culture.},
 author = {Kuo-Chun, Chiu},
 booktitle = {2016 International Conference on Advanced Materials for Science and Engineering (ICAMSE)},
 doi = {10.1109/ICAMSE.2016.7840352},
 issn = {},
 keyword = {Photography;Cultural differences;Urban areas;Creativity;History;Art;Conferences;cultural tour;Tainan photography festival;creative benefits},
 month = {Nov},
 number = {},
 pages = {388-389},
 title = {A cultural tour and representation of creativity — commentary on the orientation and potential influence of the Tainan photography festival},
 volume = {},
 year = {2016}
}
