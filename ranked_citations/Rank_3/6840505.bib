@inproceedings{6840505,
 abstract = {According to the characteristics of aircraft simulation, we have designed a dynamic terrain rendering algorithm in aircraft simulation based on the ROAM algorithm. The algorithm uses three-level-simplify strategy. First, choose the level of the blocks according to different height between the viewpoint and the terrain blocks. Then tailor the terrain blocks on the level. Finally, perform simplification on the blocks we selected with the traditional ROAM algorithm to build the triangular grid.},
 author = {Feng, Tian and Rixu, Du and Fengqin, Sun and Zhulei, Feng},
 booktitle = {2013 Third International Conference on Instrumentation, Measurement, Computer, Communication and Control},
 doi = {10.1109/IMCCC.2013.115},
 issn = {},
 keyword = {Algorithm design and analysis;Heuristic algorithms;Rendering (computer graphics);Data structures;Mathematical model;Equations;Atmospheric modeling;Dynamic Large Terrain Rendering;ROAM;Aircraft Simulation},
 month = {Sep.},
 number = {},
 pages = {504-509},
 title = {Dynamic Large Terrain Rendering Algorithm in Aircraft Simulation Based on the ROAM Algorithm},
 volume = {},
 year = {2013}
}
