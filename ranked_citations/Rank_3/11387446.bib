@inproceedings{11387446,
 abstract = {Segmenting the retinal blood vessels is necessary for the categorisation of ocular and systemic illnesses including glaucoma and diabetic retinopathy. An image’s vascular structures alongside its noise often leads to inaccuracy in segmentation. This paper seeks to resolve these challenges by proposing a hybrid deep learning model which merges Attention U-Net and Swin Transformer models. The attention mechanism provides the model the ability to emphasize the vessel structures of clinical importance. The model was designed to utilize the DRIVE dataset to achieve a segmentation accuracy of 0.9791, precision of 0.8846, recall of 0.9257, F1-score of 0.9094 and IoU of 0.8509. The hybrid approach was implemented within a Flask framework for a webbased application, enabling real-time vessel segmentation during actual clinical procedures. This work shows the application of sophisticated hybrid deep learning frameworks for improving the precision and automation in the analysis of medical images, in order to streamline the automated detection of retinal diseases.},
 author = {Dhatwalia, Divyansh and Wasson, Vikas and Bathla, Gaurav},
 booktitle = {2025 IEEE 2nd International Conference on Green Industrial Electronics and Sustainable Technologies (GIEST)},
 doi = {10.1109/GIEST66547.2025.11387446},
 issn = {},
 keyword = {Deep learning;Image segmentation;Accuracy;Computational modeling;Noise;Blood vessels;Transformers;Real-time systems;Medical diagnostic imaging;Diseases;Retinal Vessel Segmentation;Real-Time Image Processing;Attention U-Net;Swin Transformer;Medical Image Processing;Fundus Imaging;Vision Transformers},
 month = {Oct},
 number = {},
 pages = {1-8},
 title = {A Hybrid Attention U-Net and Swin Transformer Framework for Retinal Blood Vessel Segmentation},
 volume = {},
 year = {2025}
}
