@conference{Hassan2010406,
 abstract = {Semi-join is the most used technique to optimize the treatment of complex relational queries on distributed architectures. However, the overhead related to semi-join computation can be very high due to data skew and to the high cost of communication in distributed architectures. Internet search engines needs to process vast amounts of raw data every day. Hence, systems that manage such data should assure scalability, reliability and availability issues with reasonable query processing time. Hadoop and Google's File System are examples of such systems. In this paper, we present a new algorithm based on Map-Reduce-Merge model and distributed histograms for processing semi-join operations on such systems. A cost analysis of this algorithm shows that our approach is insensitive to data skew while reducing communication and disk Input/Output costs to a minimum. © 2010 ACM.},
 author = {Hassan, M. Al Hajj and Bamha, M.},
 doi = {10.1145/1774088.1774174},
 journal = {Proceedings of the ACM Symposium on Applied Computing},
 note = {Cited by: 6},
 pages = {406 - 413},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semi-join computation on distributed file systems using map-reduce-merge model},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77954730188?origin=resultslist},
 year = {2010}
}
