@inproceedings{11464490,
 abstract = {Large Language Models (LLMs) are prone to hallucinations due to the probability of their generation process, which means outputs are inconsistent with the fact label. The existing hallucination detection methods usually rely on the final layer representation, identifying hallucination by judging deviations between output and ground truth. These methods have made remarkable progress, but they still have certain limitations: hallucinations often do not occur at the last layer, but are gradually accumulated by semantic mutations in the middle layers and finally reflected in the output layer. If relying solely on the final layer, although inconsistencies at the label level can be detected, it is difficult to capture the formation and propagation of internal biases, thereby limiting the accuracy and robustness of detection. To address this issue, we propose a novel discriminative mechanism, the HallUciNation Tracking network (HUNT). We employ a gating mechanism to monitor multi-layer features, improving reliability. Within the expert network, subspace division enhances attention to critical information and restrains interference. Finally, a multi-layer fusion module integrates input, intermediate, and output layers, guiding attention with intermediate representations to merge semantic information. Experimental results on the True-False dataset show that our HUNT achieves state-of-the-art performance in hallucination detection.},
 author = {Zhang, Xue and Zhang, Shuai and Xiang, Wang and Xie, Heng and Tao, Jianhua and Wen, Zhengqi and Lv, Zhao and Fan, Cunhang},
 booktitle = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP55912.2026.11464490},
 issn = {2379-190X},
 keyword = {Feeds;Protocols;HTTP;Receivers;Fuses;Electronic components;Artificial intelligence;Large language models;Attention mechanisms;Cognitive systems;Large Language Models;hallucination detection;intermediate representations;gating and multi-layer fusion},
 month = {May},
 number = {},
 pages = {18577-18581},
 title = {HUNT: Detecting Hallucinations via Multi-Layer Discriminative Representations in Large Language Models},
 volume = {},
 year = {2026}
}
