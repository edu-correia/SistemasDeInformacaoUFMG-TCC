@conference{He2017163,
 abstract = {In order to improve low efficiency conducted in text classification and measuring similarity using vector space model for representing text. This paper proposed a method for reducing feature items of feature vector based on thesaurus. It used semantic relation of thesaurus such as Y, D, F, S, C symbol to merge and reconstruct the feature items. And then the method was applied to formal concept analysis FCA. The experimental results show that the method has better effective on reducing attributes of formal context, and can improve the time efficiency of construction of concept lattice. © 2015 IEEE.},
 author = {He, Wei and Li, Shuang},
 doi = {10.1109/CSA.2015.32},
 journal = {2015 International Conference on Computer Science and Applications, CSA 2015},
 note = {Cited by: 0},
 pages = {163 - 167},
 publication_stage = {Final},
 source = {Scopus},
 title = {Reduction of feature items based on thesaurus and its application in FCA},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85013821376?origin=resultslist},
 year = {2017}
}
