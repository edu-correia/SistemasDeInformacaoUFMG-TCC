@conference{Razzaq2023,
 abstract = {In this paper, an idea of adaptive dynamic programming-based boost inverter has been presented. Most of inverters present in market are simple square wave inverters based on H-Bridge inverter. These inverters produce lots of harmonics due less efficient control mechanism. Also, major problem in these inverters is shape of waveform. These inverters produce square or triangular waveform which is not best for induction motors. But these inverters especially, triangular wave form produce high value of peak to peak voltage. Some inverters have deployed modified sine wave which is better and efficient than square or triangular wave form but switching harmonics increase in them. Proposed system ADP controller will make sure that no harmonic is present in output voltage. Proposed system will step up input voltage according to the desired value. For this purpose, a novel technique of single-stage boost converter merge with sine inverter having ADP controller has been presented. Main advantage of proposed algorithm has ability to sync with hardware and in this way, it can control switching devices in better way. In conventional modulation techniques, usually switching devices are turned on or off in a complete cycle. This inserts a great electrical stress on switching devices but ADP can achieve same result by activating switching devices in reduced time and thus life of switching devices can be increases and also loss can be minimized. Thus, our proposed topology will achieve higher efficiency with reduced losses, THD and switching stress. Proposed system has been simulated in MATLAB Simulink. © 2023 IEEE.},
 author = {Razzaq, Muhammad Imran and Janjua, Kashif A.},
 doi = {10.1109/ICEST56843.2023.10138828},
 journal = {Proceedings - 2023 IEEE International Conference on Emerging Trends in Engineering, Sciences and Technology, ICES and T 2023},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Harmonic Mitigation in Pure Sine Wave Boost Inverter using Adaptive Dynamic Programming},
 type = {Conference paper},
