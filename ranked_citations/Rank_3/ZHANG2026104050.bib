@article{ZHANG2026104050,
 abstract = {Recent developments in cloud computing have led to an increase in the outsourcing of data to cloud servers, allowing users to benefit from various services. However, practitioners face significant challenges related to outsourced data security, privacy, and usability. One area that has gained importance is the ability to search over encrypted cloud data, mainly through Public-Key Encryption with Keyword Search (PEKS). Despite the advancements in PEKS, existing methods struggle with efficiently retrieving keywords from a large volume of data, especially when managing dynamic keyword updates. In this work, we propose a Lightweight and Fast Dynamic Public-Key Encryption with Keyword Search Scheme for Multi-User Environments, referred to as LFD-PEKS. To address the issues of handling large amounts of input data and enhancing retrieval efficiency, we have developed a novel ciphertext deduplication algorithm and a redundancy-free inverted index structure that accommodates multiple users. Additionally, we present an effective ciphertext update algorithm that facilitates the dynamic management of outsourced ciphertexts, thereby improving the scheme’s scalability and flexibility. Both formal security analysis and empirical evaluations confirm that LFD-PEKS is an efficient and secure PEKS scheme, making a valuable contribution to the existing knowledge on searchable encryption.},
 author = {Shiwen Zhang and Yibin Yang and Wei Liang and Junlong Zhou and Kuanching Li and Ruben González Crespo},
 doi = {https://doi.org/10.1016/j.csi.2025.104050},
 issn = {0920-5489},
 journal = {Computer Standards & Interfaces},
 keyword = {Cloud computing, Keyword search, Ciphertext deduplication, Dynamic update, Fast search},
 pages = {104050},
 title = {LFD-PEKS: A Lightweight and Fast Dynamic Public-key Encryption with Keyword Search Scheme for multi-user environments},
 url = {https://www.sciencedirect.com/science/article/pii/S0920548925000790},
 volume = {95},
 year = {2026}
}
