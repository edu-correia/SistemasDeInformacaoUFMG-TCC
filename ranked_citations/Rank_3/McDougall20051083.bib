@article{McDougall20051083,
 abstract = {This study shows that both icon and function label characteristics combine subtly to affect the way that individuals perceive icons. Icon users unconsciously use the cues available to them: the extent to which these cues are utilised depends on the language background of the user. In order to optimise design we therefore need know more, not only about the effects of function label characteristics, but also about how they merge with icon and user characteristics to affect usability. © IFIP International Federation for Information Processing 2005.},
 author = {McDougall, Siné and Forsythe, Alexandra and Stares, Lucy},
 doi = {10.1007/11555261_110},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 5; All Open Access; Bronze Open Access},
 pages = {1083 - 1086},
 publication_stage = {Final},
 source = {Scopus},
 title = {Icon use by different language groups: Changes in icon perception in accordance with cue utility},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33645974868?origin=resultslist},
 volume = {3585 LNCS},
 year = {2005}
