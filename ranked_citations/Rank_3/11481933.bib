@inproceedings{11481933,
 abstract = {Pharmaceutical industry faces strong challenge of finding the right balance between sustainability, strict laws and regulations, and making good profits at the same time. Present research proposed a systematic approach of four phases for the integration of data analytics and artificial intelligence (AI) with the real-time supply chain management of the pharmaceutical industry that consists of implanting sustainable criteria into the conversion process. Proposed method ensures that the adoption of technology is not only in tune with the preparedness of the organization but also with the environmental and social goals by merging the Technology-Organization-Environment (TOE) framework with the Triple Bottom Line (TBL) model. The success of the framework is claimed through a case study of a worldwide company which reveals enhanced compliance with regulations a 17 % drop in carbon emissions and a 23 % cut in inventory costs. The application comprises machine learning with Natural Language Processing (NLP) for monitoring compliance and Random Forest for optimization of costs being the key technologies. Unlike, traditional digital transformation strategies, this approach is sustainable first from the beginning and provides a replica that can be used by other regulated industries to balance long-term sustainable growth with operational efficiency.},
 author = {K, Manjunath Kamath and R, Yathiraj G and M, Niveditha N and M, Manu Y and B, Bharath and R, Ramesh H},
 booktitle = {2026 2nd International Conference on Computing for Sustainability and Intelligent Future (COMP-SIF)},
 doi = {10.1109/COMP-SIF69752.2026.11481933},
 issn = {},
 keyword = {Integrated circuits;Internet of Things;Communication systems;Routing;Protocols;Digital images;Internet;HTTP;Radio access networks;Regional area networks;Artificial Intelligence;Data Analytics;Digital Transformation;Pharmaceutical Industry;Supply Chains},
 month = {March},
 number = {},
 pages = {1-6},
 title = {An Enhanced Framework for Implementing Data Analytics and AI for Sustainable Business Growth: Pharmaceutical Supply Chain Case Validation},
 volume = {},
 year = {2026}
}
