@article{Nguyen201831,
 abstract = {Knowledge merging is of major concern in developing probabilistic expert systems. Each system provides a consistent probabilistic knowledge while the merged knowledge base is often inconsistent. Because of this reason, a wide range of approaches has been put forward to merge probabilistic knowledge bases. However, the input of the models is the set of possible probabilistic functions representing the original probabilistic knowledge bases. In this paper, we investigate a framework for merging probabilistic knowledge bases represented by the new form. To this aim, a process to merge probabilistic knowledge bases is introduced, several transformation methods for the representation of the original probabilistic knowledge base is presented, a set of merging operators is proposed, and several desirable logical properties are investigated and discussed. © Springer Nature Switzerland AG 2018.},
 author = {Nguyen, Van Tham and Nguyen, Ngoc Thanh and Tran, Trong Hieu},
 doi = {10.1007/978-3-319-98443-8_4},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 4},
 pages = {31 - 42},
 publication_stage = {Final},
 source = {Scopus},
 title = {Framework for merging probabilistic knowledge bases},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85053182713?origin=resultslist},
 volume = {11055 LNAI},
 year = {2018}
}
