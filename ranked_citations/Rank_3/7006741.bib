@article{7006741,
 abstract = {Mainstream traffic flow control (MTFC) with variable speed limits (VSLs) is a freeway traffic control method that aims to maximize throughput by regulating the mainstream flow upstream from a bottleneck. Previous studies in a macroscopic simulator have shown optimal and feedback MTFC potential to improve traffic conditions. In this paper, local feedback MTFC is applied in microscopic simulation for an on-ramp merge bottleneck. Traffic behavior reveals important aspects that had not been previously captured in macroscopic simulation. Mainly, the more realistic VSL application at specific points instead of along an entire freeway section produces a slower traffic response to speed limit changes. In addition, the nonlinear capacity flow/speed limit relation observed in the microscopic model is more pronounced than what was observed at the macroscopic level. After appropriate modifications in the control law, significant improvements in traffic conditions are obtained.},
 author = {Müller, Eduardo Rauh and Carlson, Rodrigo Castelan and Kraus, Werner and Papageorgiou, Markos},
 doi = {10.1109/TITS.2014.2374167},
 issn = {1558-0016},
 journal = {IEEE Transactions on Intelligent Transportation Systems},
 keyword = {Vehicles;Traffic control;Acceleration;Microscopy;Delays;Video recording;Modeling;Freeway traffic control;mainstream traffic flow control (MTFC);microscopic traffic simulation;variable speed limits (VSLs);Freeway traffic control;mainstream traffic flow control (MTFC);microscopic traffic simulation;variable speed limits (VSLs)},
 month = {Feb},
 number = {1},
 pages = {512-523},
 title = {Microsimulation Analysis of Practical Aspects of Traffic Control With Variable Speed Limits},
 volume = {16},
 year = {2015}
}
