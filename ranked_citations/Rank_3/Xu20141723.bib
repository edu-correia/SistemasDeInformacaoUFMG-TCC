@article{Xu20141723,
 abstract = {Current conference models and publishing systems have been heavily criticized in various scientific communities. The "Conference of the Future" Initiative aims to establish a new way to submit, evaluate, revise, publish, comment on and reuse, in future, the contents of the papers published in a conference. Our focus is to merge emerging web technologies, i.e. social network services and the semantic web, into a revised conference model based on existing ones, and finally develop a semantic platform for managing Scientific Knowledge Objects (SKO). © 2014 International Information Institute.},
 author = {Xu, Hao and Giunchiglia, Fausto},
 journal = {Information (Japan)},
 note = {Cited by: 0},
 number = {5},
 pages = {1723 - 1728},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards a semantic infrastructure for the "conference of the future"},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84903946858?origin=resultslist},
 volume = {17},
 year = {2014}
}
