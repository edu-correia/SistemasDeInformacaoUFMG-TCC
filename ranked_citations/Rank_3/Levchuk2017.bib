@conference{Levchuk2017,
 abstract = {Today's battlefields are shifting to "denied areas", where the use of U.S. Military air and ground assets is limited. To succeed, the U.S. intelligence analysts increasingly rely on available open-source intelligence (OSINT) which is fraught with inconsistencies, biased reporting and fake news. Analysts need automated tools for retrieval of information from OSINT sources, and these solutions must identify and resolve conflicting and deceptive information. In this paper, we present a misinformation detection model (MDM) which converts text to attributed knowledge graphs and runs graph-based analytics to identify misinformation. At the core of our solution is identification of knowledge conflicts in the fused multi-source knowledge graph, and semi-supervised learning to compute locally consistent reliability and credibility scores for the documents and sources, respectively. We present validation of proposed method using an open source dataset constructed from the online investigations of MH17 downing in Eastern Ukraine. © 2017 SPIE.},
 author = {Levchuk, Georgiy and Shabarekh, Charlotte},
 doi = {10.1117/12.2263546},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 6},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Using soft-hard fusion for misinformation detection and pattern of life analysis in OSINT},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85025688364?origin=resultslist},
 volume = {10207},
 year = {2017}
}
