@conference{Battré2008324,
 abstract = {DHT based RDF stores have been developed to allow the integration of many RDF data sources while providing scalability to many concurrent queries. These systems rely mostly on static data as frequent updates are expensive because of their distributed nature. This paper presents a strategy where dynamic data remains at the information source instead of being sent to the DHT in order to be queried on demand. This allows us to represent a global view on the merge of many RDF graph while reflecting dynamic changes of values in the individual documents.},
 author = {Battré, Dominic and Heine, Felix and Höing, André and Hovestadt, Matthias and Kao, Odej and Liebetruth, Christoph},
 journal = {Proceedings of the 2008 International Conference on Semantic Web and Web Services, SWWS 2008},
 note = {Cited by: 1},
 pages = {324 - 327},
 publication_stage = {Final},
 source = {Scopus},
 title = {Dynamic knowledge in DHT based RDF stores},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/62749198160?origin=resultslist},
 year = {2008}
}
