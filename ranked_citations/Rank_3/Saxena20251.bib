@conference{Saxena20251,
 abstract = {While machine learning has been adopted across various fields, its ability to outperform traditional heuristics in operating systems is often met with justified skepticism. Concerns about unsafe decisions, opaque debugging processes, and the challenges of integrating ML into the kernel - -given its stringent latency constraints and inherent complexity - - make practitioners understandably cautious. This paper introduces Guardrails for the OS, a framework that allows kernel developers to declaratively specify system-level properties and define corrective actions to address property violations. The framework facilitates the compilation of these guardrails into monitors capable of running within the kernel. In this work, we establish the foundation for Guardrails, detailing its core abstractions, examining the problem space, and exploring potential solutions. © 2025 Copyright held by the owner/author(s).},
 author = {Saxena, Divyanshu and Chen, Jiayi and Yadalam, Sujay and Ro, Yeonju and Dwivedula, Rohit and Campbell, Eric H. and Akella, Aditya and Rossbach, Christopher J. and Swift, Michael},
 doi = {10.1145/3713082.3730384},
 journal = {HOTOS 2025 - Proceedings of the 2025 Workshop in Hot Topics in Operating Systems},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 pages = {1 - 7},
 publication_stage = {Final},
 source = {Scopus},
 title = {How I learned to stop worrying and love learned OS policies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105010244301?origin=resultslist},
 year = {2025}
}
