@inproceedings{6618408,
 abstract = {HEVC (High Efficiency Video Coding) is the next generation video coding standard being developed by JCT-VC (Joint Collaborative Team on Video Coding). The target of HEVC is to get significant improvements in coding efficiency compare to H.264/AVC. HEVC employs a highly flexible quadtree coding block partitioning structure, which includes Coding Unit (CU), Prediction Unit (PU) and Transform Unit (TU). Compare with the previous video coding standards, the quadtree structure impose lots of complexity. In this paper, an fast and efficient coding unit selection algorithm for HEVC is proposed. The proposed algorithm is using a partition mode selection method based on the texture of CU and a CU merging method based on direction gradient. The experimental results show that the average time savings of the proposed algorithm is 53.79% in All Intra Main configuration, 45.64% in Random Access Main configuration and 46.35% in Low Delay B Main configuration.},
 author = {Jiawen Qiu and Fan Liang and Yonglin Luo},
 booktitle = {2013 IEEE International Conference on Multimedia and Expo Workshops (ICMEW)},
 doi = {10.1109/ICMEW.2013.6618408},
 issn = {},
 keyword = {Encoding;Algorithm design and analysis;Video coding;Partitioning algorithms;Merging;Prediction algorithms;ISO standards;HEVC;coding unit;prediction unit;fast selection},
 month = {July},
 number = {},
 pages = {1-5},
 title = {A fast coding unit selection algorithm for HEVC},
 volume = {},
 year = {2013}
}
