@inproceedings{4782574,
 abstract = {View and schema integration are two very complex tasks in which several views and/or schemata are merged into one global conceptual schema. Due to its complexity, computer-based applications and tools that support and automate parts of the schema integration process are needed. In this paper we propose a composite schema-based matching approach in which we make use of not only taxonomies but also ontologies for facilitating the integration process. Our approach will be a first step towards developing a computer-based application for modeling language independent schema integration.},
 author = {Bellström, Peter and Vöhringer, Jürgen},
 booktitle = {2009 International Conference on Information, Process, and Knowledge Management},
 doi = {10.1109/eKNOW.2009.17},
 issn = {},
 keyword = {Automation;Ontologies;Application software;Computer applications;Feedback;Taxonomy;Guidelines;Pattern recognition;Merging;Knowledge management;modeling;integration;automation},
 month = {Feb},
 number = {},
 pages = {110-115},
 title = {Towards the Automation of Modeling Language Independent Schema Integration},
 volume = {},
 year = {2009}
}
