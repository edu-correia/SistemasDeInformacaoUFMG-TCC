@inproceedings{1575740,
 abstract = {In this paper, we propose a new approach of document analysis and recognition (DAR) based on the combination of OCR systems. The proposed approach aims to improve the document recognition by combining the result of several OCR systems according to their performances. We focus our attention, in this paper, on the table combination. We start by presenting the results of the evaluation of OCR system in the table block recognition. Then, we present our table combination method. We are interested in both table structure and table content.},
 author = {Kboubi, F. and Chabi, A.H. and Ahmed, M.B.},
 booktitle = {Eighth International Conference on Document Analysis and Recognition (ICDAR'05)},
 doi = {10.1109/ICDAR.2005.224},
 issn = {2379-2140},
 keyword = {Optical character recognition software;Performance evaluation;Text recognition;Probes;Text analysis;Character recognition;Merging;Error correction;Graphics;Hafnium},
 month = {Aug},
 number = {},
 pages = {1237-1241 Vol. 2},
 title = {Table recognition evaluation and combination methods},
 volume = {},
 year = {2005}
}
