@inproceedings{11028342,
 abstract = {Object detection in large images poses significant challenges, especially when objects vary in size and appear at different scales. This is particularly relevant in remote sensing, defect detection, and map analysis, where high-resolution images contain objects of interest ranging from small, densely packed instances to large, sparse structures. In this work, we explore the design of a simple yet effective tile-based multi-scale object detection pipeline. The proposed approach divides images into smaller tiles for each chosen scale and then aggregate outputs to get the final results. To maintain efficiency, we employ one lightweight detection model and investigate various fusion techniques, including object stitching in overlapping regions, non-maximum suppression (NMS), soft NMS, and score voting. Additionally, we propose hybrid NMS, new aggregation method, that was developed to eliminate the disadvantages of previous methods. Experimental evaluation on DOTAv1 dataset demonstrates that our approach enhances detection accuracy without significantly increasing computational cost. The findings highlight the potential of tile-based multi-scale processing for applications requiring precise and robust object localization in large-scale images. Source code is at https://github.com/SanchoPanso/tbmsd.},
 author = {Chernikov, Alexander and Stepanov, Dmitrii and Bakhshiev, Aleksandr},
 booktitle = {2025 International Conference on Industrial Engineering, Applications and Manufacturing (ICIEAM)},
 doi = {10.1109/ICIEAM65163.2025.11028342},
 issn = {2993-4060},
 keyword = {Training;Accuracy;Source coding;Pipelines;Merging;Memory management;Object detection;Robustness;Tuning;Remote sensing;object detection;tile-based detection;multi-scale processing;DOTA dataset;result aggregation},
 month = {May},
 number = {},
 pages = {731-736},
 title = {Tile-Based Multi-Scale Detection: Designing a Simple and Effective Pipeline},
 volume = {},
 year = {2025}
}
