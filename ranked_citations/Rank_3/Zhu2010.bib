@conference{Zhu2010,
 abstract = {The work presented in this paper is an attempt to bridge two co-existing realties: Semantic information and Multi-Agent Systems, the aim is to provide multi-domain experts or users with uniform semantic interoperability framework in heterogeneous distributed environment. We focus on the domain Ontology's original data source remote sensing imagery, bridging gap of the high-level semantic information to low-level image features in a domain-ontology and combining it with intelligent agent model which is called Ontology Agent. Based on those technology we provide a novel Multi-Agent Semantic Integration Framework (MASIS), the analysis of its application in different domains shows that the use of intelligent Agent for semantic integration in resolving the heterogeneous information integration and ontology maintained has a good result, it is a new and effective ways for semantic integration.},
 author = {Zhu, Xianqiang and Shao, Zhenfeng},
 doi = {10.1109/GEOINFORMATICS.2010.5568054},
 journal = {2010 18th International Conference on Geoinformatics, Geoinformatics 2010},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A study on semantic integration of remote sensing image data based on multi-agent cooperation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77958027526?origin=resultslist},
 year = {2010}
}
