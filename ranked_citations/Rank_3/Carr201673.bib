@conference{Carr201673,
 abstract = {As data sets increase in size beyond the petabyte, it is increasingly important to have automated methods for data analysis and visualisation. While topological analysis tools such as the contour tree and Morse-Smale complex are now well established, there is still a shortage of efficient parallel algorithms for their computation, in particular for massively data-parallel computation on a SIMD model. We report the first data-parallel algorithm for computing the fully augmented contour tree, using a quantised computation model. We then extend this to provide a hybrid data-parallel / distributed algorithm allowing scaling beyond a single GPU or CPU, and provide results for its computation. Our implementation uses the portable data-parallel primitives provided by NVIDIA’s Thrust library, allowing us to compile our same code for both GPUs and multi-core CPUs. © 2016 The Author(s)},
 author = {Carr, H. and Sewell, C. and Lo, L.-T. and Ahrens, J.},
 doi = {10.2312/cgvc.20161299},
 journal = {Computer Graphics and Visual Computing, CGVC 2016 - Eurographics UK Chapter Proceedings},
 note = {Cited by: 5},
 pages = {73 - 80},
 publication_stage = {Final},
 source = {Scopus},
 title = {Hybrid data-parallel contour tree computation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85080473823?origin=resultslist},
 year = {2016}
}
