@article{Lucas2010145,
 abstract = {OTIS (optical transpose interconnection system) is a popular model of optoelectronic parallel computers that has gained enormous attention in the recent years. Several parallel algorithms have been published for many fundamental problems on this architecture. In this paper, first we propose a parallel algorithm for sparse enumeration sort on OTIS-Mesh of Trees (OTIS-MOT). For N (= n<sup>2</sup>) data elements, our sorting algorithm requires 4 log N<sup>$</sup> electronic moves + 3 OTIS moves. We next present a shortest path routing algorithm that runs also in logarithmic time. © 2010 World Scientific Publishing Company.},
 author = {Lucas, Keny T. and Jana, Prasanta K.},
 doi = {10.1142/S0129626410000119},
 journal = {Parallel Processing Letters},
 note = {Cited by: 8},
 number = {2},
 pages = {145 - 154},
 publication_stage = {Final},
 source = {Scopus},
 title = {Sorting and routing on OTIS-Mesh of trees},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/77954840055?origin=resultslist},
 volume = {20},
 year = {2010}
}
