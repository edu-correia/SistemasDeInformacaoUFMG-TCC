@article{Akter201590,
 abstract = {In object recognition accurate segmentation of a particular object of interest (OOI) is critical. The OOI usually consists of a set of homogeneous regions with spatial relations among them. Thus, classspecific knowledge on the visual appearance and spatial arrangement of the regions can be useful in discriminating among objects from different classes. In this paper, we propose the use of the Attributed Relational Graph (ARG)-based formalism as a means of representing both visual and spatial information in a single structure. In the proposed framework, a training set of images, each of which contains an instance of the OOI, is given. Afterwards, each image is over-segmented into a set of visually homogeneous regions and the corresponding ARG is constructed. Given such graph representations, OOI model learning reduces to a subgraph matching problem. © Springer International Publishing Switzerland 2015.},
 author = {Akter, Nasreen and Gondra, Iker},
 doi = {10.1007/978-3-319-20801-5_10},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {90 - 99},
 publication_stage = {Final},
 source = {Scopus},
 title = {Attributed relational graph-based learning of object models for object segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84984597020?origin=resultslist},
 volume = {9164},
 year = {2015}
}
