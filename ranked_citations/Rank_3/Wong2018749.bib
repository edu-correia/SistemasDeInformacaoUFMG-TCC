@conference{Wong2018749,
 abstract = {Generate-and-validate automatic program repair and higher order mutation testing often use search-based techniques to find optimal or good enough solutions in huge search spaces. As search spaces continue to grow, finding solutions that require interactions of multiple changes can become challenging. To tackle the huge search space, we propose to use variational execution. Variational execution has been shown to be effective in exhaustively exploring variations and identifying interactions in a huge but often finite configuration space. The key idea is to encode alternatives in the search space as variations and use variational execution as a blackbox technique to generate useful insights so that existing search heuristics can be informed.We show that this idea is promising and identify criteria for problems in which variational execution is a promising tool, which may be useful to identify further applications. © 2018 Association for Computing Machinery.},
 author = {Wong, Chu-Pan and Meinicke, Jens and Kästner, Christian},
 doi = {10.1145/3236024.3264837},
 journal = {ESEC/FSE 2018 - Proceedings of the 2018 26th ACM Joint Meeting on European Software Engineering Conference and Symposium on the Foundations of Software Engineering},
 note = {Cited by: 11; All Open Access; Gold Open Access},
 pages = {749 - 753},
 publication_stage = {Final},
 source = {Scopus},
 title = {Beyond testing configurable systems: Applying variational execution to automatic program repair and higher order mutation testing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85058286208?origin=resultslist},
 year = {2018}
}
