@conference{Han200653,
 abstract = {Summarization can facilitate users to acquire large amount of information. This paper introduces a Chinese news events summarization system based on a predefined template. The system automatically collects query-related news online, applies Language model to detect event related information, calculates word frequencies based on semantic meaning and uses information fusion techniques to merge the results. After experiments on 50 events, the system can achieve the average of 82.1% precision based on human judgment. © 2006 IEEE.},
 author = {Han, Ying and Li, Fang and Liu, KeBin and Liu, Lei},
 doi = {10.1109/SKG.2006.102},
 journal = {2006 2nd International Conference on Semantics Knowledge and Grid, SKG},
 note = {Cited by: 1},
 pages = {53 - 56},
 publication_stage = {Final},
 source = {Scopus},
 title = {Template based Chinese news event summarization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/44949172836?origin=resultslist},
 year = {2006}
}
