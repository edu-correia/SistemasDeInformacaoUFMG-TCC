@inproceedings{5071473,
 abstract = {With the advent of networks-on-chip (NoCs), the interest for mesochronous synchronizers is again on the rise due to the intricacies of skew-controlled chip-wide clock tree distribution. Recently proposed schemes agree on a source synchronous design style with some form of ping-pong buffering to counter timing and metastability concerns. However, the integration issues of such synchronizers in a NoC setting are still largely uncovered. Most schemes are in fact placed between communicating switches, thus neglecting the abrupt increase of buffering resources needed at switch input stages. This paper goes a step forward and aims at deep integration of the synchronizer in the switch architecture, thus merging key tasks such as synchronization, buffering and flow control into a unique architecture block. This paper compares the integrated and the loosely coupled solutions from a performance and area viewpoint, while devoting special attention to their robustness with respect to physical design parameters.},
 author = {Ludovici, Daniele and Strano, Alessandro and Bertozzi, Davide and Benini, Luca and Gaydadjiev, Georgi N.},
 booktitle = {2009 3rd ACM/IEEE International Symposium on Networks-on-Chip},
 doi = {10.1109/NOCS.2009.5071473},
 issn = {},
 keyword = {Switches;Network-on-a-chip;Frequency synchronization;Clocks;Timing;Delay;Phase detection;Detectors;Counting circuits;Metastasis},
 month = {May},
 number = {},
 pages = {244-249},
 title = {Comparing tightly and loosely coupled mesochronous synchronizers in a NoC switch architecture},
 volume = {},
 year = {2009}
}
