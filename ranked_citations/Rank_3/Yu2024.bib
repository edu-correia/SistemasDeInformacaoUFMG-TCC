@article{Yu2024,
 abstract = {Under the Internet+ information era background, the barriers between traditional and modern education are melting away. This paper takes the OMO teaching mode as the entry point and constructs the design of professional practical training teaching of landscape engineering technology based on virtual simulation technology analysis of the OMO teaching mode. While drawing on the OMO teaching mode, it combines the system posture detection and binocular vision position-solving technology in virtual simulation to build a cyclic development system of OMO mode and professional practical teaching of landscape engineering technology and promote the deep integration of the two. The experimental results show that through 18 weeks of comparison between the OMO teaching mode based on virtual simulation technology and the traditional teaching mode of practical teaching, it is found that the average scores of students are 84.31 and 77.41, respectively, with an effective increase of 10% in performance. Regarding student participation, the OMO teaching mode based on virtual simulation technology mainly focuses on the 68-82 range, effectively stimulating students' enthusiasm. The OMO teaching mode based on virtual simulation technology proposed in this paper can effectively improve the current problems of traditional teachings, such as resources without rules and regulations, poor correlation, and one-sided evaluation methods, to more effectively cultivate students' independent learning ability and improve their vocational skills. © 2023 Min Yu et al., published by Sciendo.},
 author = {Yu, Min and Xia, Wenxin and Zhang, Linlin and Lv, Junnan and Xin, Zhengqi},
 doi = {10.2478/amns.2023.2.00198},
 journal = {Applied Mathematics and Nonlinear Sciences},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 number = {1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on the construction and effect evaluation of OMO mode of professional practical training teaching of landscape engineering technology based on virtual simulation technology},
 type = {Article},
