@article{REGIAMTAMA2025741,
 abstract = {With the integration of thoughtful game design and interactive elements, games can function as a highly effective medium for imparting subject-specific knowledge. Numerous studies have emphasized the potential of games to enhance learners’ academic performance. The utilization of serious games within educational contexts has garnered considerable interest in scholarly research, primarily due to their capacity to offer engaging and immersive learning environments. Unlike conventional instructional methods, serious games merge educational content with interactive gameplay, fostering greater learner motivation, cognitive engagement, and improved retention of information. This study aims to deepen learners’ comprehension of Pancasila—the foundational ideology of Indonesia—through the implementation of enhanced in-game interactions. The central hypothesis posits that a well-constructed serious game, rooted in the principles of Pancasila, will yield more favorable learning outcomes compared to traditional pedagogical approaches. To validate this hypothesis, a serious game within the action- adventure genre was developed for the Android platform, and its effectiveness was subsequently assessed. The findings indicate that the proposed serious game significantly enhanced learners’ overall experience in comparison to conventional teaching methods. This research also aims to support the UN’s SDG goals, in particular SGD-4 (Provide Quality Education).},
 author = {Klaudius Ivan Regiamtama and Yosua Antonio {Raphael Ekowidjaja} and Andry Chowanda},
 doi = {https://doi.org/10.1016/j.procs.2025.09.017},
 issn = {1877-0509},
 journal = {Procedia Computer Science},
 keyword = {Serious Game Design, Human-Computer Interaction, Interaction Design, Ideology Learning, Pancasila, SDG-4: Provide Quality Education},
 note = {The 10th International Conference on Computer Science and Computational Intelligence 2025},
 pages = {741-748},
 title = {Learning Pancasila Through Enhanced Interaction with a Serious Game},
 url = {https://www.sciencedirect.com/science/article/pii/S187705092502678X},
 volume = {269},
 year = {2025}
}
