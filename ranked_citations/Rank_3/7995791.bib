@inproceedings{7995791,
 abstract = {We introduce a novel concept based on maneuver templates, which are formalized collaborative maneuvers, to select cooperative driving strategies. The approach is based on the exclusion principle, where we derive provable conditions to discard unsafe cooperative maneuvers for a given traffic situation. We thereby consider the full action set of all cooperative vehicles and do not discretize the action space. We demonstrate the applicability of our approach with numerical examples.},
 author = {Manzinger, Stefanie and Leibold, Marion and Althoff, Matthias},
 booktitle = {2017 IEEE Intelligent Vehicles Symposium (IV)},
 doi = {10.1109/IVS.2017.7995791},
 issn = {},
 keyword = {Collaboration;Planning;Vehicle dynamics;Roads;Acceleration;Trajectory;Merging},
 month = {June},
 number = {},
 pages = {647-654},
 title = {Driving strategy selection for cooperative vehicles using maneuver templates},
 volume = {},
 year = {2017}
}
