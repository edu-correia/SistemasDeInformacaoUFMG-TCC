@article{Baldoni2009413,
 abstract = {In this work we give a formal background and identify the limits of applicability of local matching criteria (among which the well-known Zaremski and Wings's plugin-match) when they are used to automatically retrieve all the capabilities that are necessary to instantiate a given choreography. In doing this it is necessary to take into account and somehow merge two possibly conflicting perspectives: the local criterion for selecting single capabilities and the overall goal that we mean the composition to pursue. Formally, the problem is interpreted as the study of the preservation of the global properties of a choreography, when its roles are played by specific services. © 2009 Springer Berlin Heidelberg.},
 author = {Baldoni, Matteo and Baroglio, Cristina and Martelli, Alberto and Patti, Viviana and Schifanella, Claudio},
 doi = {10.1007/978-3-540-93851-4_40},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {413 - 426},
 publication_stage = {Final},
 source = {Scopus},
 title = {Goal preservation by choreography-driven matchmaking},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/60349124605?origin=resultslist},
 volume = {4907 LNCS},
 year = {2009}
}
