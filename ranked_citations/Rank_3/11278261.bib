@inproceedings{11278261,
 abstract = {Power networks are crucial for operators to boost productivity and enable greater integration of renewable energy sources (RES). Demand fluctuations and nonlinear constraints increase renewable energy's intermittent and unpredictable character. This study suggests merging wind farms with battery energy storage technology to increase productivity and reduce carbon emissions in traditional power plants. This update accounts for the expense of conventional fossil fuel-dependent units and carbon emissions. The simulation contains five conventional generating sources and government loads. The findings indicate that enhanced issue formulation significantly improves the ability and efficacy of optimizing power plant production schedules.},
 author = {Shafiei, Kasra and Seifi, Ali and Hagh, Mehrdad Tarafdar},
 booktitle = {2025 29th International Electrical Power Distribution Conference (EPDC)},
 doi = {10.1109/EPDC67173.2025.11278261},
 issn = {2833-9053},
 keyword = {Productivity;Wind energy generation;Renewable energy sources;Costs;Wind energy;Carbon dioxide;Wind power generation;Wind farms;Search problems;Batteries;Battery energy storage system;Various generation systems;Renewable energy sources;Demand response program},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Optimal size of a power system using wind and battery energy storage to mitigate generation in a governmental load},
 volume = {},
 year = {2025}
}
