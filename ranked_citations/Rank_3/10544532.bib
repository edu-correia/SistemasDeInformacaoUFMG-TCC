@inproceedings{10544532,
 abstract = {This work presents a novel smart shopping trolley integrating proximity sensors and load cells to address post-COVID-19 public health concerns. By providing real-time social distancing alerts and automatic billing, it enhances efficiency while minimizing contact points. Noteworthy features include scenario-tested distancing alerts and sensitivity to unique situations such as the presence of child in the trolley. This interdisciplinary effort merges insights from epidemiology, technology, and public health, emphasizing the transformative potential of scientific innovation. By fostering safer and more efficient public spaces, this smart trolley demonstrates the critical role of scientific advancements in safeguarding public health.},
 author = {Shukla, Deepika and Shah, Monika},
 booktitle = {2024 International Conference on Inventive Computation Technologies (ICICT)},
 doi = {10.1109/ICICT60155.2024.10544532},
 issn = {2767-7788},
 keyword = {Weight measurement;Technological innovation;Pediatrics;Sensitivity;Human factors;Social factors;Real-time systems;Smart Shopping Trolley;Social Distancing;Automatic Billing System;Anti-Theft Mechanisms;Contactless Shopping},
 month = {April},
 number = {},
 pages = {1775-1782},
 title = {Smart Trolley: A Smart Solution for Theft Prevention and Social Distancing in Shopping},
 volume = {},
 year = {2024}
}
