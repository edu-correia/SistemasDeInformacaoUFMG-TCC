@article{AROUS2025100057,
 abstract = {Abstract:
Predicting banking risks, including liquidity, interest rate, and exchange rate risks, remains a crucial challenge for financial stability. These risks arise from the interplay of various financial and non-financial factors. This paper integrates asset and liability management (ALM) components and corporate social responsibility (CSR) scores into a Bayesian network framework to predict these risks for OECD banks. The results reveal the critical role of ALM components, especially the operational efficiency ratio and capital adequacy ratio, in predicting all three banking risks. Additionally, environmental and governance scores within CSR metrics emerge as significant contributors to financial resilience, while the social score exhibits a more limited impact. Notably, to our knowledge, this is the first research to combine ALM and CSR factors in a Bayesian model for banking risk prediction, addressing a key gap in the literature and promoting financial stability.},
 author = {Islem Arous and Salah Ben Hamad},
 doi = {https://doi.org/10.1016/j.finr.2025.100057},
 issn = {3050-7006},
 journal = {Finance Research Open},
 keyword = {Banking risks, Risk prediction, Asset and liability management, Corporate social responsibility, Bayesian networks},
 number = {4},
 pages = {100057},
 title = {Integrating ALM and CSR in Bayesian networks for banking risk prediction: A study of OECD banks},
 url = {https://www.sciencedirect.com/science/article/pii/S305070062500057X},
 volume = {1},
 year = {2025}
}
