@article{1673455,
 abstract = {We present an unsupervised multiscale color image segmentation algorithm. The basic idea is to apply mean shift clustering to obtain an over-segmentation and then merge regions at multiple scales to minimize the minimum description length criterion. The performance on the Berkeley segmentation benchmark compares favorably with some existing approaches.},
 author = {Qiming Luo and Khoshgoftaar, T.M.},
 doi = {10.1109/TIP.2006.877342},
 issn = {1941-0042},
 journal = {IEEE Transactions on Image Processing},
 keyword = {Image segmentation;Smoothing methods;Clustering algorithms;Merging;Image coding;Filters;Clouds;Boats;Image color analysis;Image texture analysis;Mean shift clustering;minimum description length (MDL);multiscale analysis;region merging;segmentation},
 month = {Sep.},
 number = {9},
 pages = {2755-2761},
 title = {Unsupervised multiscale color image segmentation based on MDL principle},
 volume = {15},
 year = {2006}
}
