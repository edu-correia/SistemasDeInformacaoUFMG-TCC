@article{Elsayed20131,
 abstract = {In this paper, we propose a methodology to enhance the evaluation tools in semantic learning systems. Our proposal’s aim is to evaluate two types of open questions in hybrid exams. The proposed technique in the first type MOQ (Multi Operations Question) uses the matrix concept for fuzzy score. But POQ (Proof Open Question) is more complicated so we use direct connect to learning objects which saved as ontology based. Also take into consideration the dependence among learning objects so we merge the universal ontology with weight matrix. The proposed methodology has been applied to the case study of the mathematical multi operations question and the proof question on a logic course in a hybrid exam. © 2013, Elsayed et al.; licensee Springer.},
 author = {Elsayed, Eman and Eldahshan, Kamal and Tawfeek, Shaimaa},
 doi = {10.1186/2192-1962-3-19},
 journal = {Human-centric Computing and Information Sciences},
 note = {Cited by: 25; All Open Access; Hybrid Gold Open Access},
 number = {1},
 pages = {1 - 15},
 publication_stage = {Final},
 source = {Scopus},
 title = {Automatic evaluation technique for certain types of open questions in semantic learning systems},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84920900217?origin=resultslist},
 volume = {3},
 year = {2013}
}
