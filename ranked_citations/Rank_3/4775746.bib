@inproceedings{4775746,
 abstract = {A micro-mixer for mixing digital droplets fabricated on 128degY cut X LiNbO3 is reported, which is composed of one interdigital transducers and one reflector for generating unidirectional acoustic field. After a RF signal amplified by a power amplifier was added on an interdigital transducer, surface acoustic wave was excided by the interdigital transducer, and was conversed into longitudinal acoustic wave and to drive a digital droplet to merge with the other droplet quickly by their rapid molecular diffusion when the surface acoustic wave passed through the droplets. Mixing experiments of 3ul NaCl solution-2ul red dye solution and 3ul glycerine-2ul red dye solution show that their mixing velocities can improve 35 folds and 50 folds respectively under unidirectional acoustic fields. The research is valuable for its simplicity in process and easy integration into lab-on-a-chip.},
 author = {Fei, Jing-chen and Zhang, An-liang},
 booktitle = {2008 Symposium on Piezoelectricity, Acoustic Waves, and Device Applications},
 doi = {10.1109/SPAWDA.2008.4775746},
 issn = {},
 keyword = {Surface acoustic waves;Acoustic waves;Acoustic transducers;Acoustic devices;Lab-on-a-chip;Acoustic propagation;Surface acoustic wave devices;Equations;Educational institutions;Information science;Surface acoustic wave;digital droplets;interdigital transducer;unidirectional acoustic fields},
 month = {Dec},
 number = {},
 pages = {42-46},
 title = {Fast mixing of digital droplets under uni-direction acoustic field},
 volume = {},
 year = {2008}
}
