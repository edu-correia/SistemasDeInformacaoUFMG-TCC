@inproceedings{5558904,
 abstract = {Faceted Taxonomies are often used for managing complex knowledge within a domain. They can be used as a reference model for bottom-up new information analysis and integration. This paper proposes a domain information model that quantifies the semantics (indexing concepts) of the faceted taxonomy nodes and uses them as indexer for integrating and managing knowledge such as software requirements. Through a working example, this paper shows how the indexing concepts and concepts in knowledge (indexed concepts) are associated via semantic similarity measurement and how the associations are used for managing domain knowledge, such as merging requirements.},
 author = {Chu, Hung-Ju and Chow, Randy Y. C.},
 booktitle = {2010 IEEE International Conference on Information Reuse & Integration},
 doi = {10.1109/IRI.2010.5558904},
 issn = {},
 keyword = {Semantics;Taxonomy;Indexing;Business;Context;Ontologies;Computational modeling;Faceted Taxonomy;Semantic Similarity Measurement;Knowledge Management;Information Retrieval},
 month = {Aug},
 number = {},
 pages = {378-379},
 title = {An information model for managing domain knowledge via Faceted Taxonomies},
 volume = {},
 year = {2010}
}
