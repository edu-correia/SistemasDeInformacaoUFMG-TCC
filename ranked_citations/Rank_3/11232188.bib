@inproceedings{11232188,
 abstract = {Enabled by IEC 61850 and advances in fiber-optic communication, Substation Automation now offers cost-effective and interoperable solutions for modern power systems. This paper presents a case study of the Bekasi Digital Substation (GID Bekasi), the largest in Indonesia with a 27-bay configuration. The project demonstrates the integration of conventional primary equipment with digital technology through Merging Units (MUs). The transition from a conventional to a digital substation has yielded measurable improvements in operational efficiency and maintenance safety. In particular, test preparation time per bay was reduced from approximately 60 minutes to 15 minutes (~75%), while panel counts decreased by more than 50%. Several technical lessons also emerged: the importance of validating digital signals post-migration to prevent misconfigurations, the risks associated with generic logical nodes, and challenges linked to incomplete SCD files. To address these issues, a validation framework aligned with IEC 61850-8-1 is proposed, ensuring consistent testing and configuration practices. Scalability considerations—including VLAN design, network bandwidth, and IED counts—are also outlined to enable replication in future projects.},
 author = {Firdaus, Idam and Nurfaizi, Muhammad Muflih and Perwita, Ade Yoan and Alfisyah, Muhammad Naim and Tobing, Victor Lumban and Muhajir},
 booktitle = {2025 International Conference on Technology and Policy in Energy and Electric Power (ICT-PEP)},
 doi = {10.1109/ICT-PEP67281.2025.11232188},
 issn = {},
 keyword = {Wiring;Substations;Substation automation;Scalability;Reliability engineering;Maintenance;Safety;Planning;IEC Standards;Testing;digital substation;IEC 61850;maintenance},
 month = {Sep.},
 number = {},
 pages = {131-136},
 title = {Bekasi Digital Substation: An Overview of Indonesia’s Largest Digital Substation},
 volume = {},
 year = {2025}
}
