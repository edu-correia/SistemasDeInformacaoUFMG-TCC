@inproceedings{8027972,
 abstract = {A compound control method is proposed in this paper to alleviate the effects of delay and nonlinear in coagulant dosing process of water treatment system and it merges the fuzzy control algorithm with the Cerebellar Model Arithmetic Control (CMAC). It is taken fuzzy CMAC revision control combined with expert control. According to the features of coagulant dosing process, by using the compound controller, an optimum dosing of coagulant is presented. The compound controller uses the turbidity and PH value of raw water as input variables and the proportional coefficient of coagulant as output variable. It is tested with the actual data from water works, and the simulation results show that the approach is efficient and feasible.},
 author = {Su, Xiaoying and Xu, Sihong and Xu, Shaochuan},
 booktitle = {2017 36th Chinese Control Conference (CCC)},
 doi = {10.23919/ChiCC.2017.8027972},
 issn = {1934-1768},
 keyword = {Iron;CMAC;fuzzy control;coagulant dosing;compound control},
 month = {July},
 number = {},
 pages = {3931-3936},
 title = {Compound control system for coagulant dosing process based on a fuzzy cerebellar model articulation controller},
 volume = {},
 year = {2017}
}
