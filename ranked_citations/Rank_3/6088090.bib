@inproceedings{6088090,
 abstract = {Hadoop has shown great power in processing vast data in parallel. Hive, the database on Hadoop, enables more experts to process relational data by providing sql-like interface. However, Hive does not provide an efficient approach for join, a common but expensive operator in relational database. Due to the importance of join, this paper proposes a novel hybrid algorithm, HJA, which can help to automatically choose the relatively better one among several methods, divide and memory copy merge, Partition Join(PJ) and naïve Hive join. Experiments show that HJA can get best performance in most situations.},
 author = {Hu, Weisong and Ma, Lili and Liu, Xiaowei and Qi, Hongwei and Zha, Li and Liao, Huaming and Zhang, Yuezhuo},
 booktitle = {2011 Seventh International Conference on Semantics, Knowledge and Grids},
 doi = {10.1109/SKG.2011.13},
 issn = {},
 keyword = {Semantics;MapReduce;Hadoop;partition join;auto-tuning},
 month = {Oct},
 number = {},
 pages = {44-50},
 title = {A Hybrid Join Algorithm on Top of Map Reduce},
 volume = {},
 year = {2011}
}
