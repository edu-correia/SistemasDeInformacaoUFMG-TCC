@inproceedings{10283238,
 abstract = {Wetlands serve critical functions for protecting ecosystems but are declining globally due to anthropogenic activities and environmental change. There are challenges in delineating wetlands that partially cannot be addressed using the integration of optical and SAR data. NASA’s global ecosystem dynamics investigation (GEDI) data, forest height products can differentiate wetland types with different heights. However, GEDI data is only available for limited footprints. In this study, we used a random forest regression model to create a canopy height model (CHM) by merging discrete GEDI footprints with Sentinel-2 data. We calculated the R-squared and RMSE using test data (0.81 and 3.48 meters, respectively). Such an investigation might provide the basis for better wetland management.},
 author = {Adeli, Sarina and Quackenbush, Lindi J. and Salehi, Bahram and Mahdianpari, Masoud},
 booktitle = {IGARSS 2023 - 2023 IEEE International Geoscience and Remote Sensing Symposium},
 doi = {10.1109/IGARSS52108.2023.10283238},
 issn = {2153-7003},
 keyword = {Meters;Integrated optics;Merging;Geoscience and remote sensing;Forestry;Data models;Optical sensors;GEDI;lidar;machine learning;random forest;sentinel-2},
 month = {July},
 number = {},
 pages = {5635-5637},
 title = {Gedi and Sentinel-2 Integration for Mapping Complex Wetlands},
 volume = {},
 year = {2023}
}
