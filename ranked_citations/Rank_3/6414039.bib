@inproceedings{6414039,
 abstract = {This article introduces how the software for designing transmission line realizes AutoCAD parameterized drawing. This software is developed based on Object ARX, the secondary development tool of AutoCAD, Visual Basic and Visual C++. We focus on the process and technological difficulties of software realization, and present the key codes. The contents of the main part include how to open AutoCAD automatically, and how to execute the mapping instruction upon the opening of AutoCAD, various versions of AutoCAD can be run, Microsoft foundation classes (MFC) can be used to create a user-interactive dialogue box under AutoCAD, the category, proportion, contents and frames of mapping can be customized. The software is capable of batch merging dwg files according as user-defined. For one specific project, selective mapping can be achieved according to the topography, load conditions and tower foundation.},
 author = {Hou, Xiao-yan and Lu, Xian-long},
 booktitle = {2012 International Conference on Control Engineering and Communication Technology},
 doi = {10.1109/ICCECT.2012.181},
 issn = {},
 keyword = {Software;Engineering drawings;Visualization;Merging;Poles and towers;Power transmission lines;Parameterized drawing;ObjectARX technology;Visual C++;MFC},
 month = {Dec},
 number = {},
 pages = {581-585},
 title = {Automatic Design of Transmission Lines Using ObjectARX Technology},
 volume = {},
 year = {2012}
}
