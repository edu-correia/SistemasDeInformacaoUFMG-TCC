@inproceedings{11388675,
 abstract = {This paper presents a practical implementation of a PID-driven flow regulation strategy for an All-Vanadium Redox Flow Battery (VRFB) system that utilizes a hybrid control ap- proach integrating both local and IoT-based operations. The pro- posed system leverages conventional PID algorithms for real-time, on-site control while incorporating IoT connectivity for remote monitoring and adjustment capabilities. The implementation de- tails, system design, and integration challenges are discussed, with a focus on how the dual control modes contribute to operational flexibility and improved process oversight. Experimental results demonstrate that the approach effectively maintains desired flow rates under varying operational conditions, including load disturbances, without compromising system reliability. This work provides a comprehensive evaluation of merging traditional PID control techniques with modern IoT connectivity for improved performance and management of All-Vanadium Redox Flow Battery systems.},
 author = {Saini, Anil Kumar and Madhukar, Gaurav and Sangwan, Dhiraj and Purohit, Gaurav},
 booktitle = {2025 8th International Conference on Emerging Technologies in Computer Engineering: Advances in Computing, Healthcare and Smart Systems (ICETCE)},
 doi = {10.1109/ICETCE66848.2025.11388675},
 issn = {},
 keyword = {PI control;Pumps;Vanadium;Redox;Regulation;Real-time systems;Batteries;PD control;Internet of Things;Remote monitoring;PID Control;Internet of Things (IoT);Vanadium Redox Flow Battery (VRFB);Flow Regulation;Remote Monitoring},
 month = {Nov},
 number = {},
 pages = {116-120},
 title = {PID-Driven Flow Regulation for All-Vanadium Redox Flow Battery System with Hybrid Local and IoT- Control},
 volume = {},
