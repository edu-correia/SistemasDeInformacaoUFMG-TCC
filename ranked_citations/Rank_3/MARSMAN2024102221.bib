@article{MARSMAN2024102221,
 abstract = {The Expressive Therapies Continuum (ETC) is increasingly used in various art therapy practices, including Mentalization-Based Art Therapy. However, there is little empirical evidence about the mechanisms of change and therapeutic factors of the ETC. In this study, ten respondents were interviewed to explore whether patients with a cluster B or C personality disorder consider psychoeducation about the ETC beneficial to their mentalizing capacity. The Grounded Theory Approach was applied to collect and analyse data, main categories were formed from the data and merged into a theory. According to the respondents, knowledge about the structure offered by the ETC contributed to increasing insight, providing alternative options, improving emotion regulation and increasing autonomy. This study is an exploration of the mechanisms of change and therapeutic factors of the ETC used as psychoeducational theoretical framework. Given the size and the evidential value of this study, further research is recommended.},
 author = {Marthe Marsman and Mark {van der Meer} and Annemieke Bakker and Celine Schweizer},
 doi = {https://doi.org/10.1016/j.aip.2024.102221},
 issn = {0197-4556},
 journal = {The Arts in Psychotherapy},
 keyword = {Art Therapy, Expressive Therapies Continuum, Mentalization-Based Art Therapy, Personality disorders, Patient experience},
 pages = {102221},
 title = {The expressive therapies continuum and mentalization-based art therapy for individuals diagnosed with a cluster B/C personality disorder: A successful marriage!},
 url = {https://www.sciencedirect.com/science/article/pii/S0197455624001060},
 volume = {91},
 year = {2024}
}
