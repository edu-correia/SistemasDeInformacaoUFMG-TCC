@inproceedings{8807926,
 abstract = {In this study glassy carbon samples were implanted with 250 keV europium ions to a fluence of 1×1016 ions/cm2 at 100°C. After implantation the samples were isochronally annealed in vacuum from 200°C to 1000°C in steps of 100°C for 1 hour. The diffusion behavior of the implanted ions was investigated with Rutherford backscattering spectrometry (RBS) while Raman spectroscopy was used to study the structural changes in the glassy carbon. SEM images showed the topography development of the surfaces due to ion bombardment and annealing. After annealing at 300°C the Gaussian-shaped profile of the implanted Eu broadened indicating Fickian diffusion. However, by increasing the temperature to 400°C the profile was no longer Gaussian with the europium diffusing toward the surface of substrate. The Raman spectroscopy before and after ion implantation showed the D and G peaks of carbon were merged together after bombardment indicating destruction of the graphitic crystallites in the glassy carbon. Annealing at increasing temperature resulted in increasing (albeit limited) recovery of glassy carbon structure with partial reappearance of the D and G peaks.},
 author = {Kenari, Mahboubeh Fathi and Hlatshwayo, Thulani T and Odutemowo, Opeyemi S and Mohlala, Tshegofatso M and Wendler, Elke and Malherbe, Johan B},
 booktitle = {2018 22nd International Conference on Ion Implantation Technology (IIT)},
 doi = {10.1109/IIT.2018.8807926},
 issn = {},
 keyword = {Carbon;Annealing;Ion implantation;Europium;Surface treatment;Ions;Surface topography;ion implantation;glassy carbon;europium;annealing;RBS;SEM;Raman},
 month = {Sep.},
 number = {},
 pages = {377-380},
 title = {Migration Behavior of 100°C Europium Ion Implantation in Glassy Carbon},
 volume = {},
