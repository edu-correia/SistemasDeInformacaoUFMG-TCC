@conference{Andrade2009980,
 abstract = {We present a contribution to the digital preservation of artworks made by the Wauja and Karaja indians; both communities acknowledged for their expertise in ceramic artworks and the symbolism embedded in their art. Our goal is to enhance the texture color quality of 3D models obtained from color and depth images of a laser scanner. Although laser scanners offer high-performance regarding depth information, the color information is still poor and limits the generation of realistic texture. We propose a method through which we add color information obtained from a high resolution digital camera to solve this limitation. Thus, our approach generates texture maps for 3D models by using color data obtained from triplets of: (1) high resolution photographs captured by a digital camera; and (2) color and (3) range images captured by a laser scanner. For each triplet, we calculate a partial texture map for the 3D model. Then, we merge all partial maps based on weights we have defined to reflect the reliability of each partial texture map pixel. We present several results of preserved artworks with realistic and enhanced quality texture maps. The 3D models can be visualized through a tool we developed to support the virtual exhibition of the artworks. ©2009 IEEE.},
 author = {Andrade, Beatriz T. and Bellon, Olga R. P. and Silva, Luciano and Vrubel, Alexandre},
 doi = {10.1109/ICCVW.2009.5457597},
 journal = {2009 IEEE 12th International Conference on Computer Vision Workshops, ICCV Workshops 2009},
 note = {Cited by: 4},
 pages = {980 - 987},
 publication_stage = {Final},
 source = {Scopus},
 title = {Enhancing color texture quality of 3D models for digital preservation of indigenous ceramic artworks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77953204305?origin=resultslist},
 year = {2009}
}
