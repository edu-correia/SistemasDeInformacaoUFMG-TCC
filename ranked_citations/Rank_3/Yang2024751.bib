@conference{Yang2024751,
 abstract = {Large Language Models (LLMs) have profoundly improved the performance in natural language tasks and recently Chain of Thoughts (CoTs) combining Knowledge Graphs (KGs) has further improved reasoning. However, LLMs lack effective causality identification and weight adjustment mechanisms when dealing with complex problems, limiting the accuracy of multi-hop reasoning. To address the challenge, we propose the Causal Reasoning and Weighting Mechanisms of Thought Reasoning in Large Language Models (CRWMTR), which first brings the Key factor identification into complex multi-hop reasoning. For complex problem solving task, we recursively optimise the inference paths in the KGs by assigning weights W and scores S to the initial and candidate entities to guide the 'merge' and 'delete' operations. We propose a new self-correcting mechanism that can quantify and unify causal factors step by step during multi-hop reasoning, Experiments show CRWMTR outperform the state-of-the-art methods. © 2024 IEEE.},
 author = {Yang, Weiwei and Zeng, Qianru and Lin, Zijing and Zhong, Xiaoting and Luo, Hanfang and Yuan, Junying and Zhang, Shihui and Zhang, Jianxin and Liu, Yizhi},
 doi = {10.1109/ICBAIE63306.2024.11117006},
 journal = {2024 5th International Conference on Big Data, Artificial Intelligence and Internet of Things Engineering, ICBAIE 2024},
 note = {Cited by: 0},
 pages = {751 - 754},
 publication_stage = {Final},
 source = {Scopus},
 title = {CRWMTR: Causal Reasoning and Weighting Mechanisms of Thought Reasoning in Large Language Models},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105015749735?origin=resultslist},
 year = {2024}
}
