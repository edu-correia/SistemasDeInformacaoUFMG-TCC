@article{BELHADEF2011558,
 abstract = {Recently, much research has focused on developing techniques for schema/ontology matching and mapping as it is required in many areas e.g. heterogeneous database integration, merging of ontologies, semantic query processing. In this paper, we present a novel method to detect and repair the list of homologs concepts; this last is based on the bidirectional comparison (Checking) between the two matched ontologies to filter this list of concepts. The used measures are classical just to show the reliability and realisability of our method, but we can generalize it for supporting other advanced measures.},
 author = {Hacene Belhadef},
 doi = {https://doi.org/10.1016/j.proeng.2011.11.2547},
 issn = {1877-7058},
 journal = {Procedia Engineering},
 keyword = {Bidirectional verification, Ontologies, Ontology matching, Similarity measures},
 note = {PEEA 2011},
 pages = {558-564},
 title = {A New Bidirectional Method for Ontologies Matching},
 url = {https://www.sciencedirect.com/science/article/pii/S1877705811053902},
 volume = {23},
 year = {2011}
}
