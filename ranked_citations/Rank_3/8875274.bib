@inproceedings{8875274,
 abstract = {In order to expand the scope of Zhejiang area rainfall observation to the sea area, the Kriging Interpolation method is adopted to combine the Radar Quantitative Precipitation Estimate (QPE) with the Zhejiang Precipitation Analyses, which is based on the ten-minute gauged rainfall from about 2,500 automatic weather stations (AWS), and 10-min hourly precipitation on 0.01×0.01°grid of high-resolution analysis products are generated. QPE is adopted by template matching algorithm to extract the sea radar rainfall lattice data as a discrete point data, and is combined with the Quality control of Zhejiang region rain gauge measurements for generating a new discrete data of hourly precipitation. Then, the Kriging Interpolation method and its mean bias structure are applied to assign weights and spatial interpolation of discrete data. In this paper, the quality of merged precipitation product is assessed from the statistics analysis of a single case analysis, the time scale sample analysis and spatial scale sample analysis, etc. In addition, the experimental results indicate that the discussed method is effective in the combined gauge-radar high-resolution ten-minute precipitation. The merged precipitation production can well capture the gauged rainfall information, and the Radar Quantitative Precipitation Estimate Information is reserved in the sea. The combined gauge-radar high-resolution ten-minute precipitation is produced in Zhejiang region.},
 author = {Yang, Ming and Xu, Xiaolong and Chen, Qing and Liu, Ying and Gao, Zhuyu and Chen, Yufeng and Zeng, You},
 booktitle = {2019 International Conference on Internet of Things (iThings) and IEEE Green Computing and Communications (GreenCom) and IEEE Cyber, Physical and Social Computing (CPSCom) and IEEE Smart Data (SmartData)},
 doi = {10.1109/iThings/GreenCom/CPSCom/SmartData.2019.00102},
 issn = {},
 keyword = {Interpolation;Rain;Meteorological radar;Spaceborne radar;Graphical models;Distribution functions;kriging interpolation, meteorological radar, high-resolution, precipitation},
 month = {July},
 number = {},
 pages = {501-506},
 title = {An Analysis and Assessment of Kriging Interpolation Algorithm for Merging Meteorological High-Resolution Precipitation},
 volume = {},
 year = {2019}
}
