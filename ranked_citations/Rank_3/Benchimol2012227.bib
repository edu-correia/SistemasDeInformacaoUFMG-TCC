@conference{Benchimol2012227,
 abstract = {It has been shown by McEliece and Lin that convolutional codes can be represented by a minimal trellis structure in order to reduce the decoding complexity of the Viterbi algorithm. This trellis module has an irregular structure presenting sections with different number of states. In this paper we present the sectionalization of the minimal trellis module which yields a more compact and regular trellis representation (in terms of maximum number of states and total number of sections) with the same decoding complexity and distance spectrum of the minimal trellis module. The decoding complexity measure is strongly related with energy consumption by the receiver. We investigate the effects of the trellis sectionalization over the trellis complexity measure, defined by McEliece and Lin, and over the merge complexity measure. We show that various trellis topologies proposed in the literature are specific cases of the sectionalized minimal trellis. © 2012 IEEE.},
 author = {Benchimol, Isaac and Pimentel, Cecilio and Demo Souza, Richard},
 doi = {10.1109/TSP.2012.6256287},
 journal = {2012 35th International Conference on Telecommunications and Signal Processing, TSP 2012 - Proceedings},
 note = {Cited by: 3},
 pages = {227 - 232},
 publication_stage = {Final},
 source = {Scopus},
 title = {Sectionalization of the minimal trellis module for convolutional codes},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84866945463?origin=resultslist},
 year = {2012}
}
