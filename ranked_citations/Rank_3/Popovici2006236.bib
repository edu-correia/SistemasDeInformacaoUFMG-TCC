@article{Popovici2006236,
 abstract = {The XML language is a W3C standard sustained by both the industry and the scientific community. Therefore, the available information annotated in XML keeps and will keep increasing in size. Furthermore, not only the volume of the XML information is increasing but also its complexity. The XML documents evolved from plain structured text representations, to documents having complex and heterogeneous structures and contents like sequential or time series data. In this article we introduce a retrieval scheme designed to manage sequential data in an XML context based on two levels of approximation: on the structural localization/organization of the sequential data and on its content. To this end we merge methods developed in two different research areas: XML information retrieval and sequence similarity search. © Springer-Verlag Berlin Heidelberg 2006.},
 author = {Popovici, Eugen and Marteau, Pierre-François and Ménier, Gildas},
 doi = {10.1007/11670834_19},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {236 - 250},
 publication_stage = {Final},
 source = {Scopus},
 title = {Information retrieval of sequential data in heterogeneous XML databases},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33745551856?origin=resultslist},
 volume = {3877 LNCS},
 year = {2006}
}
