@inproceedings{11383728,
 abstract = {This research work combines various machine learning paradigms to enhance automated comprehension of subjective text. It looks at the merging of different prediction models and content generation systems and shows how their joint strengths can produce a better and more robust ability to detect emotional tones from big data written reviews. A major development in computer-based assessment stance extraction from consumer reviews is presented, validated on a well-established media commentary collection. The operational architecture and accompanying computational artifacts can provide a verifiable basis for the automated interpretation of text. This is especially true at times when large language models do not align or become impractical due to computational cost.},
 author = {Kumar, Abhishek},
 booktitle = {2025 Second International Conference on Pioneering Developments in Computer Science & Digital Technologies (IC2SDT)},
 doi = {10.1109/IC2SDT68218.2025.11383728},
 issn = {},
 keyword = {Reviews;Computational modeling;Neural networks;Merging;Computer architecture;Syntactics;Predictive models;Cognition;Real-time systems;Multilingual;Hybrid Opinion Inference;Neuro-Symbolic Learning;Explainable NLP;Knowledge-Enhanced Neural Networks;Multilingual Text Understanding},
 month = {Dec},
 number = {},
 pages = {7-12},
 title = {Hybrid Textual Cognition for Explainable Opinion Inference: Integrating Symbolic Reasoning with Language Models},
