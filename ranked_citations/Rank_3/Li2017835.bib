@conference{Li2017835,
 abstract = {This paper presents a 12-bit asynchronous SAR-incremental sub-range ADC design in 65nm TSMC technology. The combination of power-efficient SAR ADC and low-speed high-accuracy incremental ADC can achieve higher accuracy and relatively high frequency. And the merge of the two architectures can save large amount of area, say, 7/8 the capacitor area of the conventional SAR ADC architecture for the same resolution. At a 1.2-V supply and 62.5MS/s, the simulation results show that the ADC achieves an effective-number-of-bits(ENOB) of 11.6 and consumes 1.6 mW, resulting a figure-of-merit(FOM) of 8.25 fJ/conv-step. © 2017 IEEE.},
 author = {Li, Manxin and Hu, Hang and Dai, Zhiyuan and Ye, Fan and Ren, Junyan},
 doi = {10.1109/ASICON.2017.8252606},
 journal = {Proceedings of International Conference on ASIC},
 note = {Cited by: 0},
 pages = {835 - 838},
 publication_stage = {Final},
 source = {Scopus},
 title = {A 12bit asynchronous SAR-incremental sub-range ADC},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85044757769?origin=resultslist},
 volume = {2017-October},
 year = {2017}
}
