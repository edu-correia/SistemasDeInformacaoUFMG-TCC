@inproceedings{10878526,
 abstract = {With the infeed UHV-DC merges into the power grid, the division of voltage control partitioning is more challenging, which is an important step in the secondary voltage control of power system. In this paper, the infeed UHV-DC node is equivalent to a reactive power supply, the weighted Fast-Newman algorithm is used to merge the reactive power sources through the maximum distance difference degree. The proposed method makes load nodes be divided with voltage reactive sensitivity and the average power factor. Which not only reflects the power grid by the center of hub AC bus control requirements, and also conforms to the principle of power grid control hierarchical control. By using the method the control partition result is more adaptable and the influence of UHV-DC transmission power of the partition is considered as well. The rationality of the proposed method is verified by the simulation results of IEEE39 node system.},
 author = {Chen, Tianhua and Xu, Dawei and Du, Lei and Chen, Jianhua},
 booktitle = {2024 11th International Forum on Electrical Engineering and Automation (IFEEA)},
 doi = {10.1109/IFEEA64237.2024.10878526},
 issn = {},
 keyword = {Reactive power;Reactive power control;Low voltage;Sensitivity;Simulation;High-voltage techniques;Power grids;Partitioning algorithms;Resource management;Voltage control;infeed DC receiving power grid;Control partition;weighted Fast-Newman algorithm;long time reactive power balance},
 month = {Nov},
 number = {},
 pages = {1-5},
 title = {Voltage Control Partitioning Method Based on Weighted Fast-Newman for Ultra High Voltage Direct Current Power Grid},
 volume = {},
 year = {2024}
}
