@conference{Wu20225109,
 abstract = {Despite the revolutionary advances made by Transformer in Neural Machine Translation (NMT), inference efficiency remains an obstacle due to the heavy use of attention operations in auto-regressive decoding. We thereby propose a lightweight attention structure called Attention Refinement Network (ARN) for speeding up Transformer. Specifically, we design a weighted residual network, which reconstructs the attention by reusing the features across layers. To further improve the Transformer efficiency, we merge the self-attention and cross-attention components for parallel computing. Extensive experiments on ten WMT machine translation tasks show that the proposed model yields an average of 1.35× faster (with almost no decrease in BLEU) over the state-of-the-art inference implementation. Results on widely used WMT14 En→De machine translation tasks demonstrate that our model achieves a higher speed-up, giving highly competitive performance compared to AAN and SAN models with fewer parameter numbers © 2022 Proceedings - International Conference on Computational Linguistics, COLING. All rights reserved.},
 author = {Wu, Kaixin and Zhang, Yue and Hu, Bojie and Zhang, Tong},
 journal = {Proceedings - International Conference on Computational Linguistics, COLING},
 note = {Cited by: 3},
 number = {1},
 pages = {5109 - 5118},
 publication_stage = {Final},
 source = {Scopus},
 title = {Speeding Up Transformer Decoding via an Attention Refinement Network},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85165758768?origin=resultslist},
 volume = {29},
