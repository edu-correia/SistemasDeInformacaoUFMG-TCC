@conference{Zhang20256728,
 abstract = {The encoder-decoder framework and attention mechanisms have significantly advanced the performance of remote sensing image captioning (RSIC) models. However, existing attention-based captioning models primarily focus on relationships between local features, failing to effectively integrate global features and highlight salient regions, thus hindering the generation of accurate scene descriptions. To address these challenges, we propose the Detail-Global Saliency-guided Multi-scale Transformer Model (DGSM-TM), which combines a dual-branch encoder with a multi-scale decoder framework. In the encoding stage, saliency maps are generated via a pixel-level saliency assessment task, and a Detail-Global Saliency-guided Fusion Module (DGSFM) is introduced to merge global and detailed features, significantly enhancing the representation of critical regions. In the decoding stage, a Multi-head Dilation Cross-Attention (MDCA) mechanism is employed to effectively capture relationships between local and global features through multi-scale attention, generating more precise descriptive sentences. Experimental results demonstrate that the proposed DGSM-TM model achieves superior performance on the UCM-Captions and RSICD datasets. ©2025 IEEE.},
 author = {Zhang, Boyang and Xu, Wenbo and Li, Yu and Li, Pengke and Jia, Haitao},
 doi = {10.1109/IGARSS55030.2025.11243751},
 journal = {International Geoscience and Remote Sensing Symposium (IGARSS)  },
 note = {Cited by: 2},
 pages = {6728 - 6732},
 publication_stage = {Final},
 source = {Scopus},
 title = {DGSM-TM: A SALIENCY-GUIDED MULTI-SCALE TRANSFORMER FOR REMOTE SENSING IMAGE CAPTIONING},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105034078889?origin=resultslist},
