@inproceedings{5657078,
 abstract = {The Telematics is the integration of telecommunication and informatics, also known as ICT (Information and Communications Technology). The application trend of Telematics is to establish a user friendly vehicle communication environment to merge the information for the traffic safety, road navigation, remote business, A/V entertainment, etc. The key technologies of Telematics are the heterogeneous communication and information fusion. This paper aims to design a portable Telematics system which integrates multimedia infotainment networks (Bluetooth, MOST), short range communications (WLAN, DSRC), long distance communications (GPS, 3.5G, WiMAX) based on Android OS to utilize multiple network resources and Google services. We proposed a heterogeneous network management algorithm which includes roaming and sharing functions. The roaming function provides the multiple network selections and handover process in physical layer and media access control (MAC) layer. The sharing function supports multiple network resource allocation and the handover process in network layer and application layer. Besides, the Android software from kernel to application is implemented with the heterogeneous network functions and Telematics services to enhance seamless communication efficiency and construct a user-friendly defined vehicular environment. Finally, we establish the Android system prototype on different platforms as Car PC and mobile internet device. And the telecommunication sharing and multimedia streaming scenarios integration with MOST network are also completed. The proposed system will apply as Heterogeneous Internet Device (HID) which could be used in home, mobile and vehicular environments to realize ubiquitous social sharing network.},
 author = {Yong-Hua Cheng and Wen-Kuang Kuo and Szu-Lin Su},
 booktitle = {2010 International Conference on Intelligent Computing and Integrated Systems},
 doi = {10.1109/ICISS.2010.5657078},
 issn = {},
 keyword = {Navigation;Browsers;Streaming media;YouTube;Driver circuits;WiMAX;Software;Telematics;Heterogeneous network;Android},
 month = {Oct},
