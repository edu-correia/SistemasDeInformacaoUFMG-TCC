@article{10.14778/1920841.1920910,
 abstract = {The ability to decompose a complex, long-running query into simpler queries that produce the same result is useful for many scenarios, such as admission control, resource management, fault tolerance, and load balancing. In this paper we propose query slicing as a novel mechanism to do such decomposition. We study different ways to extend a traditional query optimizer to enable query slicing and experimentally evaluate the benefits of each approach.},
 author = {Bruno, Nicolas and Narasayya, Vivek and Ramamurthy, Ravi},
 doi = {10.14778/1920841.1920910},
 issn = {2150-8097},
 issue_date = {September 2010},
 journal = {Proc. VLDB Endow.},
 month = {September},
 number = {1–2},
 numpages = {12},
 pages = {530–541},
 publisher = {VLDB Endowment},
 title = {Slicing long-running queries},
 url = {https://doi.org/10.14778/1920841.1920910},
 volume = {3},
 year = {2010}
}
