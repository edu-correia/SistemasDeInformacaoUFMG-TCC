 issn = {},
 keyword = {Wireless communication;Wireless sensor networks;Protocols;Wireless networks;Surveillance;Data aggregation;Throughput;Data Aggregation Protocol;DAPM;Wireless Communication Protocol;Trustworthy Scheme;Wireless Sensor Network;WSN;Security},
