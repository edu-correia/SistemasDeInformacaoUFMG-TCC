@inproceedings{6187810,
 abstract = {Three-network convergence does not merge the telecom network, the Internet and the broadcast network into a physical network, or replacing a network as part of another one. It means integration of information in three nets, namely developing different business of voice, data and video in the same internet at the same time. Core technology of three networks convergence is given, describing internet packets being encapsulated into Ethernet frames through ether card by client computers, and then transmitted to client switches and the bureau switches through fiber optic. The development process of operator's network access methods is introduced. Present situation and development of access control, characteristics and limitations of different access control methods are analyzed. Analysis of access architecture of three networks convergence is given. Consideration of access devices is described. New developments of information technology, information content and information service industry that will be brought by three networks convergence are discussed.},
 author = {Cao, Rui},
 booktitle = {2012 International Conference on Computer Science and Electronics Engineering},
 doi = {10.1109/ICCSEE.2012.71},
 issn = {},
 keyword = {Convergence;Business;IP networks;Access control;Internet;Strontium;IPTV;three networks convergence;access control;access architecture},
 month = {March},
 number = {},
 pages = {229-232},
 title = {Study of Access Control Methods of Three-Network Convergence},
 volume = {1},
 year = {2012}
}
