@incollection{KUMAR2024257,
 abstract = {A thorough understanding of human health and disease necessitates the analysis of molecular challenges and different versions at different levels. It can be done by analyzing the data, which is nowadays more important than anything else. It finds hidden facts from large amounts of data to aid in understanding the biological problem and decision-making with planning. Data science integrates biostatistics, machine learning, artificial intelligence, and advanced computer programming. The data generated at different levels combine cross-omics data from the genome, epigenome, transcriptome, proteome, metabolome, and molecular dynamics simulation trajectory data. The variety and quantity of omics dataset propel biology and biomedical sciences research and implementation into ages of Big Data similar to that which was widely known in humankind a few years back. To analyze a particular behavior of data, the findings start with research articles and the selection of data interpretation tools and techniques. It helps extract helpful information to make a good hypothesis and improve the omics dataset handling issues. A fresh challenge opened from horizontal and vertical data ensemble that requires merging biology and biomedicine. It handles the significant shift from earlier demographically to more recent individual-made research. Data integration is an impactful idea for solving complex problems or comprehending complex systems. We will provide a complete overview of techniques for solving omics set problems, modeling methods, and data analysis tools that have been applied in the past and present to extract valuable information from omics data generated by different omics investigations.},
 author = {Sanjay Kumar and Manish Kumar Gupta},
 booktitle = {Integrative Omics},
 doi = {https://doi.org/10.1016/B978-0-443-16092-9.00016-3},
 editor = {Manish Kumar Gupta and Pramod Katara and Sukanta Mondal and Ram Lakhan Singh},
 isbn = {978-0-443-16092-9},
 keyword = {Batch effect correction, Cross-omics data, Data acquisition, Data integration, Data management and visualization, Data science, Differential gene expression, Genomics and proteomics, Missing value imputation, Omics dataset problem, Systems biology},
 pages = {257-278},
 publisher = {Academic Press},
 title = {Chapter 16 - Data science and analytics, modeling, simulation, and issues of omics dataset},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443160929000163},
 year = {2024}
}
