@conference{Rajan2005856,
 abstract = {Many approaches have been proposed for the problem of mapping categories (classes) from a source taxonomy to classes in a master taxonomy. Most of these techniques, however, ignore the hierarchical structure of the taxonomies. In this paper, we propose a maximum likelihood based framework which exploits the hierarchical structure to obtain a more natural mapping between the source classes and the master taxonomy. Furthermore, unlike previous work, our technique also inserts source classes into appropriate places of the master hierarchy creating new categories if required. We evaluate our approach on text and hyperspectral datasets. Copyright © 2005, American Association for Artificial Intelligence (www.aaai.org). All rights reserved.},
 author = {Rajan, Suju and Punera, Kunal and Ghosh, Joydeep},
 journal = {Proceedings of the National Conference on Artificial Intelligence},
 note = {Cited by: 9},
 pages = {856 - 861},
 publication_stage = {Final},
 source = {Scopus},
 title = {A maximum likelihood framework for integrating taxonomies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/29344448926?origin=resultslist},
 volume = {2},
 year = {2005}
}
