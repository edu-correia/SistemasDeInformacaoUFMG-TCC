@article{Wang2017131,
 abstract = {Large-scale application systems usually consist of various databases for different purposes. However, the increasing use of different databases, especially NoSQL databases, makes it increasingly challenging to use and maintain such systems. In this paper, we demonstrate a framework for designing a foreign data wrapper (FDW) for external data sources. We propose a novel method to access heterogeneous databases, including SQL and NoSQL databases, by using a unified access layer. This method was applied in some real business applications of Alibaba, in which we were able to do various operations on Redis, MongoDB, HBase, and MySQL by using a simple SQL statement. In addition, the information exchange and data migration between these databases can be done by using unified SQL statements. The experiments show that our method can maintain good database performance and provide users with a lot more convenience and efficiency. © IFIP International Federation for Information Processing 2017.},
 author = {Wang, Xuefei and Feng, Ruohang and Dong, Wei and Zhu, Xiaoqian and Wang, Wenke},
 doi = {10.1007/978-3-319-68210-5_14},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3; All Open Access; Green Open Access},
 pages = {131 - 135},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unified access layer with PostgreSQL FDW for heterogeneous databases},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85032865143?origin=resultslist},
 volume = {10578 LNCS},
 year = {2017}
}
