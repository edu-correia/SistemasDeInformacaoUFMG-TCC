@conference{Semar-Bitah2023,
 abstract = {The Northern Sahara uses groundwater as the only source of drinking water, irrigation and industry. To achieve better exploitation, we suggest implementing a Decision Support System (DSS) to sustain the management of water boreholes in the south of Algeria while exposing the key characteristics of these settlements. Data exchanged in our system is critical and must be secured. This paper presents a digital signature system based on the Public Key Infrastructure (PKI) of the different documents exchanged in the DSS. The cryptographic system was developed with JAVA technology based on PKCS standards (Public Key Cryptographic Standards). To have a PKI server, we have configured the Linux server through an open SSL. The PKI is used for creating users' certificates with their private and public keys. © 2023 IEEE.},
 author = {Semar-Bitah, Kahina and Bouderbala, Fatma Zohra and Ghebghoub, Yasmina},
 doi = {10.1109/ICAECCS56710.2023.10105057},
 journal = {2023 International Conference on Advances in Electronics, Control and Communication Systems, ICAECCS 2023},
 note = {Cited by: 3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Digital Signature Based on PKI To Authentication and Secure Exchanging data used in water boreholes intelligent Decision Support System},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85159003038?origin=resultslist},
 year = {2023}
}
