@inproceedings{4721833,
 abstract = {The conventional topic map is extended on the structure of logic organization. The association of topic-knowledge element-occurrence and the relevance between the topics and between the knowledge elements are established. Distributed knowledge management based on extended topic maps is proposed. The semantic organization and joining between the physical resource entities and the abstract concepts are implemented. The knowledge services of multi-level and multi-granularity are offered for user by knowledge maps. The distributed knowledge management framework based on extended topic maps is presented. Additionally, the method of distributed knowledge resources merging based on extended topic maps and dynamic updating are also introduced.},
 author = {Lu, Huimin and Feng, Boqin and Zhao, Yingliang and Zheng, Qinghua and Liu, Jun},
 booktitle = {2008 International Conference on Computer Science and Software Engineering},
 doi = {10.1109/CSSE.2008.909},
 issn = {},
 keyword = {Knowledge management;Merging;Resource management;Logic;Semantic Web;Computer science;Software engineering;Knowledge engineering;Technology management;Statistical analysis;knowledge management;topic map;similarity algorithm;mergence},
 month = {Dec},
 number = {},
 pages = {649-652},
 title = {Distributed Knowledge Management Based on Extended Topic Maps},
 volume = {1},
 year = {2008}
}
