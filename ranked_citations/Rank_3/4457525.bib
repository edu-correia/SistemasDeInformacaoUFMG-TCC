@inproceedings{4457525,
 abstract = {An algorithm for selective extraction of visual saliency objects from color images and videos is presented. Color quantization based on vector quantization (VQ) is firstly performed; And then, quantized image is segmented according to its color and spatial distribution; thirdly, based on visual attention model, focuses of attention (FOAs) of objects are selected; finally, in term of shifts of FOAs and the Gestalt principle, saliency objects are extracted by merging color, texture, boundary and homogeneity features. Experimental results on the Corel image database and the TREC videos demonstrate the effectiveness of the proposed approach after the subjective evaluation.},
 author = {Zhao, Zhi-Cheng and Cai, An-Ni},
 booktitle = {Third International Conference on Intelligent Information Hiding and Multimedia Signal Processing (IIH-MSP 2007)},
 doi = {10.1109/IIH-MSP.2007.278},
 issn = {},
 keyword = {Videos;Samarium;Image segmentation;Merging;Computational modeling;Humans;Layout;Color;Vector quantization;Focusing},
 month = {Nov},
 number = {},
 pages = {198-201},
 title = {Selective Extraction of Visual Saliency Objects in Images and Videos},
 volume = {1},
 year = {2007}
}
