@article{Schmitt20166,
 abstract = {Characterized by a certain focus on the heavily discussed topic of image fusion in its beginnings, sensor data fusion has played a significant role in the remote sensing research community for a long time. With this article, we aim to provide a short overview of established definitions, targeting a generalized understanding of the topic. In addition, a review of the state of the art of remote sensing data fusion research is given. By bringing together the conventional view expressed in the classical data fusion community and a review of current activities in the field of Earth observation, this article provides a holistic view of generic data fusion concepts and their applicability to the remote sensing domain. © 2013 IEEE.},
 author = {Schmitt, Michael and Zhu, Xiao Xiang},
 doi = {10.1109/MGRS.2016.2561021},
 journal = {IEEE Geoscience and Remote Sensing Magazine},
 note = {Cited by: 330},
 number = {4},
 pages = {6 - 23},
 publication_stage = {Final},
 source = {Scopus},
 title = {Data Fusion and Remote Sensing: An ever-growing relationship},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85007413470?origin=resultslist},
 volume = {4},
 year = {2016}
}
