@inproceedings{10369709,
 abstract = {SDN revolutionizes internetwork addressing, aiming to transcend the constraints of conventional configurations, facilitating adaptable network typologies. This trailblazing concept has gained remarkable traction in contemporary digital internetwork design. At its core, SDN merges control and data planes, yielding refined resource administration, elevated security, and comprehensive control. A spectrum of controllers, including floodlight, NOT, RYU, POX, open daylight (ODL), and open network operating systems (ONOS), has been engineered, collectively contributing to the architecture's constituents. This manuscript deeply probes into SDN network scalability, fault tolerance, and interfaces, concurrently conducting an extensive examination of pivotal facets within SDN architecture: API, controller infrastructures, modularity, extensibility, programming language, community scalability, telemetry, resilience, and fault tolerance.},
 author = {J, Elumalai. and Subhashini, R.},
 booktitle = {2023 International Conference on Research Methodologies in Knowledge Management, Artificial Intelligence and Telecommunication Engineering (RMKMATE)},
 doi = {10.1109/RMKMATE59243.2023.10369709},
 issn = {},
 keyword = {Fault tolerance;Scalability;Fault tolerant systems;Complexity theory;Telemetry;Security;Software defined networking;Open Network Operating System (ONOS);Floodlight;RYU;OpenDaylight (ODL);and OK},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Review of the SDN Architecture with Various API Controllers},
 volume = {},
 year = {2023}
}
