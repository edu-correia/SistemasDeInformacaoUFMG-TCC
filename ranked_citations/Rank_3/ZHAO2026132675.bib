@article{ZHAO2026132675,
 abstract = {Bound states in the continuum (BICs) have demonstrated a superior ability to engineer resonances with high quality (Q) factors as they are localized states without losses. In most previous studies, achieving high Q factors in the near-infrared has typically necessitated precise tuning of geometric parameters, often requiring control over structural dimensions at the nanometer scale. Here, we construct merging BICs by leveraging a bilayer permittivity-asymmetric metasurface composed of two layers grating embedded in polydimethylsiloxane (PDMS). By integrating the permittivity-asymmetric BICs and Fabry-Pérot BICs (FP-BICs), the merging BICs not only get rid of the dependency of high Q factors on small geometrical asymmetries but also consistently maintain higher Q factors than isolated BICs, regardless of the introduction of surface roughness or intrinsic losses in the system. Furthermore, by employing a LiNbO3/Si3N4 bilayer permittivity-asymmetric metasurface for temperature sensing in near-infrared, we demonstrate that merging BICs can enhance the figure of merit (FOM) by several orders of magnitude compared to isolated BICs. This work presents a promising strategy for achieving high Q factors resonances applicable to sensing, optical filtering, and electrical switching.},
 author = {Jiabin Zhao and Lixia Li and Feiyou Liu and Yurui Huang and Ning Feng and Yufang Liu},
 doi = {https://doi.org/10.1016/j.optcom.2025.132675},
 issn = {0030-4018},
 journal = {Optics Communications},
 keyword = {Bound states in the continuum, Merging BICs, Permittivity-asymmetric metasurface, High  factors},
 pages = {132675},
 title = {High Q factors resonance in the near-infrared governed by merging BICs in bilayer permittivity-asymmetric metasurface},
 url = {https://www.sciencedirect.com/science/article/pii/S0030401825012039},
 volume = {600},
 year = {2026}
}
