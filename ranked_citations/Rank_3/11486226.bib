@inproceedings{11486226,
 abstract = {Minimizing harm to property, the environment, and human life depends on early, precise fire detection. False alarms and delays abound in conventional fire detection systems depending on manual observation or sensor-based approaches. This paper proposes a deep learning-based convolutional neural network (CNN) based method for binary picture categorization of fire and non-fire scenarios. The 999 images obtained from the Kaggle site, the dataset was split 80 % for training and 20 % for testing. Model architecture included image augmentation, dropout regularization, and transfer learning to reduce overfitting and increase generalization. Experimental results with accuracy of 98 %, precision of 0.98 for fire and 1.00 for non-fire, reveal the remarkable efficiency of the proposed model with recall of 1.00 for fire and 0.96 for non-fire. The confusion matrix supports the durability of the model in precisely differentiating between images of fire and non-fire. The model fit for merging into real-time fire detection systems is based on consistency in classification. Emphasizing the promise of CNNs in intelligent surveillance and disaster response systems, later projects targeted at real-time deployment, video stream processing, and scalability across various environmental conditions highlight.},
 author = {Sharma, Jatin and Lande, Jayapal and Sharma, Neha and Vij, Suhail and Raina, Kartikeya},
 booktitle = {2026 Contemporary Computing Innovations Conference (CCIC)},
 doi = {10.1109/CCIC68129.2026.11486226},
 issn = {},
 keyword = {Satellite images;Earth Observing System;Internet of Things;Videos;Protocols;Communication systems;Streaming media;Internet;Video equipment;HTTP;Artificial Intelligence;Deep Learning;Fire Classification;Model Training;CNN Model},
 month = {Feb},
 number = {},
 pages = {1-5},
 title = {CNN-Powered Fire Detection System: Classifying Fire and Non-Fire Images for Rapid Emergency Response},
 volume = {},
