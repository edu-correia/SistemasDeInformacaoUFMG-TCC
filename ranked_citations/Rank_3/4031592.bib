@inproceedings{4031592,
 abstract = {The vision of pervasive computing is based on the idea that computers merge with their environment. Radio frequency identification (RFID) and wireless sensor network (WSN) are two important components of pervasive computing, since both technologies can be used for coupling the physical and the virtual world. However, RFID and WSN almost are under development in parallel method, few integration schemes and related opportunities are investigated in detail. Through deep analysis of RFID and WSN, three forms of new system architecture that combines the two technologies are proposed and its feasibility, technical challenges are discussed thoroughly},
 author = {Zhang, Lei and Wang, Zhi},
 booktitle = {2006 Fifth International Conference on Grid and Cooperative Computing Workshops},
 doi = {10.1109/GCCW.2006.58},
 issn = {},
 keyword = {Radiofrequency identification;Wireless sensor networks;Pervasive computing;Intelligent sensors;Base stations;Computer architecture;Industrial control;Bridges;Protocols;Batteries},
 month = {Oct},
 number = {},
 pages = {463-469},
 title = {Integration of RFID into Wireless Sensor Networks: Architectures, Opportunities and Challenging Problems},
 volume = {},
 year = {2006}
}
