@conference{Larnaout20132504,
 abstract = {Vehicle geo-localization based on monocular visual Simultaneous Localization And Mapping (SLAM) remains a challenging issue mainly due to the accumulation errors and scale factor drift. To tackle these limitations, a common solution is to introduce geo-referenced information into the visual SLAM algorithm. In this paper, we propose two different bundle adjustment processes that merge both GPS measurements and 'Digital Elevation Model' (DEM) data. Proposed solutions are devoted to ensure an accurate and robust geo-localization in both rural and urban environment. Experiments on synthetic and large scale real sequences show that, in addition to the real-time (i.e. about 30 Hz) performances, we obtain an accurate 6DoF localization. © 2013 IEEE.},
 author = {Larnaout, Dorra and Gay-Bellile, Vincent and Bourgeois, Steve and Dhome, Michel},
 doi = {10.1109/ICIP.2013.6738516},
 journal = {2013 IEEE International Conference on Image Processing, ICIP 2013 - Proceedings},
 note = {Cited by: 17},
 pages = {2504 - 2508},
 publication_stage = {Final},
 source = {Scopus},
 title = {Vehicle 6-DoF localization based on SLAM constrained by GPS and digital elevation model information},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84897747579?origin=resultslist},
 year = {2013}
}
