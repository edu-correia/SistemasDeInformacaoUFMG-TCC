@inproceedings{10980932,
 abstract = {This study introduces ‘dynamic fusion’, a novel framework that bridges structural and functional connectivity in the context of dynamic reconfiguration, to illustrate how brain networks adapt over time. By combining insights from functional MRI data on functional networks with diffusion MRI measurements of anatomical connections, dynamic fusion employs a joint analysis method, ‘joint cmICA’, to analyze their relationship over time. Our approach gauges the interplay between these joint components across various temporal states, aiming to discover both static and transient features of brain connectivity. Applied to empirical MRI data, our approach reveals how intricately structural connectivity patterns adapt to support functional dynamics and demands. Overall, dynamic fusion is an innovative tool for integrating connectivity data, advancing our understanding into fundamental principles of brain organization and operation.},
 author = {Wu, Lei and Duda, Marlena and Iraji, Armin and Calhoun, Vince D.},
 booktitle = {2025 IEEE 22nd International Symposium on Biomedical Imaging (ISBI)},
 doi = {10.1109/ISBI60581.2025.10980932},
 issn = {1945-8452},
 keyword = {Bridges;Magnetic resonance imaging;Merging;Data integration;Organizations;Biomedical measurement;Time measurement;Transient analysis;Biomedical imaging;Data Fusion;Functional Connectivity;Structural Connectivity;Magnetic Resonance Imaging},
 month = {April},
 number = {},
 pages = {1-4},
 title = {Dynamic Fusion: Merging Structural and Functional Connectivity Dynamics Via Joint CMICA},
 volume = {},
 year = {2025}
}
