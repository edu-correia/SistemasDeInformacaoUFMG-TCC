@inproceedings{7603528,
 abstract = {As an important link in learning process, in-game summarizing behavior hasn't attracted enough attention in the research of educational games. In this paper, we analyzed the main difficulties of merging summarizing into educational game by analyzing the natural conflict between traditional game forms and summarizing behavior. Based on which, we proposed a set of game mechanics for skill summarizing in educational games. Learners were enabled to review their previous game process, replay previous game challenges, or record thoughts manually to assist them to summarize possible problems and improvements, while the sense of repetitiveness and interruption brought naturally by summarizing could be significantly reduced by the six tightly integrated summarizing subsystems of the mechanics. Current test of the mechanics within an educational game had preliminarily proved its reasonability and effectiveness.},
 author = {Zhang, Yue},
 booktitle = {2016 12th International Conference on Natural Computation, Fuzzy Systems and Knowledge Discovery (ICNC-FSKD)},
 doi = {10.1109/FSKD.2016.7603528},
 issn = {},
 keyword = {Games;Cameras;Information security;Merging;Personnel;Fuzzy systems;educational game;summarizing;game mechanics},
 month = {Aug},
 number = {},
 pages = {2231-2235},
 title = {The game mechanics for skill summarizing in educational games},
 volume = {},
 year = {2016}
}
