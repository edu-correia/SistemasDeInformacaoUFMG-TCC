@conference{Gebhardt20183049,
 abstract = {We formulate a generalization of Petrov et al. (2006)’s split/merge algorithm for interpreted regular tree grammars (Koller and Kuhlmann, 2011), which capture a large class of grammar formalisms. We evaluate its effectiveness empirically on the task of discontinuous constituent parsing with two mildly context-sensitive grammar formalisms: linear context-free rewriting systems (Vijay-Shanker et al., 1987) as well as hybrid grammars (Nederhof and Vogler, 2014). © 2018 COLING 2018 - 27th International Conference on Computational Linguistics, Proceedings. All rights reserved.},
 author = {Gebhardt, Kilian},
 journal = {COLING 2018 - 27th International Conference on Computational Linguistics, Proceedings},
 note = {Cited by: 8},
 pages = {3049 - 3063},
 publication_stage = {Final},
 source = {Scopus},
 title = {Generic refinement of expressive grammar formalisms with an application to discontinuous constituent parsing},
 type = {Conference paper},
