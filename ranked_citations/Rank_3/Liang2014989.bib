@conference{Liang2014989,
 abstract = {We tackle the problem of searching microblog posts and frame it as a rank aggregation problem where we merge result lists generated by separate rankers so as to produce a final ranking to be returned to the user. We propose a rank aggregation method, TimeRA, that is able to infer the rank scores of documents via latent factor modeling. It is time-aware and rewards posts that are published in or near a burst of posts that are ranked highly in many of the lists being aggregated. Our experimental results show that it significantly outperforms state-of-the-art rank aggregation and time-sensitive micro-blog search algorithms.},
 author = {Liang, Shangsong and Ren, Zhaochun and Weerkamp, Wouter and Meij, Edgar and De Rijke, Maarten},
 doi = {10.1145/2661829.2661905},
 journal = {CIKM 2014 - Proceedings of the 2014 ACM International Conference on Information and Knowledge Management},
 note = {Cited by: 10; All Open Access; Green Open Access},
 pages = {989 - 998},
 publication_stage = {Final},
 source = {Scopus},
 title = {Time-aware rank aggregation for microblog search},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84937546756?origin=resultslist},
 year = {2014}
}
