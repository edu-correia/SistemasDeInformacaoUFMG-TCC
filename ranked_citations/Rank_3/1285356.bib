@inproceedings{1285356,
 abstract = {In the last years a lot of attention was paid to multiple antenna systems with space-time coding (STC) combined with ultra wide band (UWB) transceiver in order to evaluate if these two technologies can be considered adequate candidates for next generation WLANs. Merging ultra wide band signals with multiple antenna schemes allows us to achieve very high bit rate and error probability matched to QoS requested by 4GWLANs at low SNR. This contribution presents a simple way to combine ultra wide band and multiple antenna schemes so to improve performance with respect to the conventional UWB approach in order to promote these approach application scenarios impaired by Rayleigh flat and selective fadings are considered.},
 author = {Biagi, M. and Baccarelli, E.},
 booktitle = {2003 IEEE 58th Vehicular Technology Conference. VTC 2003-Fall (IEEE Cat. No.03CH37484)},
 doi = {10.1109/VETECF.2003.1285356},
 issn = {1090-3038},
 keyword = {Ultra wideband technology;Transceivers;Wireless LAN;Ultra wideband antennas;Rayleigh channels;Transmitting antennas;Space technology;MIMO;Power system reliability;Power system modeling},
 month = {Oct},
 number = {},
 pages = {1903-1907 Vol.3},
 title = {A simple multiple-antenna ultra wide band transceiver scheme for 4th generation WLAN},
 volume = {3},
 year = {2003}
}
