@article{Falt201369,
 abstract = {Since the development of applications for parallel architectures is complicated and error-prone, many frameworks were created to simplify this task. One promising approach which is applicable especially for the development of parallel databases is expressing algorithms as stream programs, i.e. inputs and outputs of procedures are data streams and these procedures are connected so that they form an oriented graph. In this paper, we introduce highly scalable sorting algorithm which is suitable for streaming systems. We achieve this mainly by introducing multiway merge algorithm which is able to merge multiple independent sorted streams in parallel. © 2013 Springer-Verlag.},
 author = {Falt, Zbyněk and Bulánek, Jan and Yaghob, Jakub},
 doi = {10.1007/978-3-642-32741-4_7},
 journal = {Advances in Intelligent Systems and Computing},
 note = {Cited by: 1},
 pages = {69 - 77},
 publication_stage = {Final},
 source = {Scopus},
 title = {On parallel sorting of data streams},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84868218948?origin=resultslist},
 volume = {186 AISC},
 year = {2013}
}
