@inproceedings{8386570,
 abstract = {The product taxonomy can provide knowledge support for many knowledge-based Web services. Merging different taxonomies is an effective way to build a complete product taxonomy. To achieve this goal, a core task is to align the concepts of different taxonomies. The traditional methods of conceptual alignment are insufficient in accuracy and efficiency. In this paper, we propose a new concept alignment by integrating three factors simultaneously: the concept's path semantic, topic similarity and dictionary-based semantic similarity. A series of experiments on real datasets show that the proposed method has a great improvement on the accuracy and efficiency of concept alignment.},
 author = {Jiang, Weimin and Lin, Yumin and Li, You},
 booktitle = {2018 IEEE 3rd International Conference on Cloud Computing and Big Data Analysis (ICCCBDA)},
 doi = {10.1109/ICCCBDA.2018.8386570},
 issn = {},
 keyword = {Taxonomy;Semantics;Dictionaries;Merging;Vocabulary;Data models;Task analysis;product taxonomy;alignment;semantic computing;similarity evaluation},
 month = {April},
 number = {},
 pages = {517-521},
 title = {Concept alignment of product taxonomies based on semantic similarity},
 volume = {},
 year = {2018}
}
