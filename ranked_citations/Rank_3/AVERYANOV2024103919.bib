@article{AVERYANOV2024103919,
 abstract = {Epitaxy plays a crucial role in synthesis of functional heterostructures. The outcome is controlled by a number of parameters; importantly, mutual orientation of the integrated materials determines properties of the heterostructures. In the simple cube-on-cube epitaxy, the typical pattern is rotational invariance – an (hkl) material forms on an (hkl) substrate. Here, a systematic breakdown of this pattern is reported employing for illustration the general problem of merging functional oxides with semiconductor technology platforms. In particular, synthesis of spintronic systems EuO/Si and EuO/Ge reveals that the rotationally invariant epitaxy achieved on the (001) and (111) substrates breaks down as soon as the (110) orientation is utilized. The generality of this behavior for rock-salt oxides on Si and Ge is established by synthesis on pristine and templated surfaces and by epitaxy of another oxide, SrO. The results provide a platform for studies of orientation relationships in epitaxial heterostructures with different types of chemical bonding.},
 author = {Dmitry V. Averyanov and Ivan S. Sokolov and Alexander N. Taldenkov and Oleg A. Kondratev and Sergey N. Yakunin and Oleg E. Parfenov and Andrey M. Tokmachev and Vyacheslav G. Storchak},
 doi = {https://doi.org/10.1016/j.surfin.2024.103919},
 issn = {2468-0230},
 journal = {Surfaces and Interfaces},
 keyword = {Silicon, Germanium, Functional oxides, EuO, Epitaxy},
 pages = {103919},
 title = {Breakdown of rotational invariance in cube-on-cube epitaxy of rock-salt oxides on Si and Ge},
 url = {https://www.sciencedirect.com/science/article/pii/S2468023024000786},
 volume = {45},
 year = {2024}
}
