@inproceedings{11156456,
 abstract = {The integration of Artificial Intelligence (AI), Big Data, and cloud computing has changed digital content delivery, enabling smarter, more efficient, and highly personalized user experiences. This paper explores how these technologies intersect to power modern streaming platforms, with a specific focus on Netflix. AI-driven recommendation systems enhance content discovery, Big Data analytics decide meaningful insights from massive user interactions, and cloud computing assures scalable infrastructure for flawless content delivery. The study emphasizes Netflix as a leading example of AI and Big Data merging in cloud computing, showing how these technologies enhance user engagement, video quality, and content strategy. Moreover, the paper reviews the challenges of algorithmic bias, Data privacy, and the ethical implications of AI-powered personalization. As streaming services continue to develop, the adaptability of AI, Big Data, and cloud computing will remain essential in shaping the future of digital entertainment.},
 author = {Bastavade, Apurva and Bhagwat, Radhika and Battawar, Chetna and Bhatkar, Ruchi and Jadhav, Pranoti},
 booktitle = {2025 12th International Conference on Emerging Trends in Engineering & Technology - Signal and Information Processing (ICETET - SIP)},
 doi = {10.1109/ICETETSIP64213.2025.11156456},
 issn = {2157-0485},
 keyword = {Cloud computing;Ethics;Technological innovation;Reviews;Ecosystems;Merging;Green products;Big Data;Prediction algorithms;Artificial intelligence;Artificial Intelligence (AI);Big Data;Cloud Computing;Streaming Platforms;Personalized Recommendations;Data Analytics},
 month = {Aug},
 number = {},
 pages = {1-6},
 title = {Leveraging AI and Big Data in Cloud Computing: Case Study of Netflix},
 volume = {},
