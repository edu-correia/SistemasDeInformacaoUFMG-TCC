@article{10848292,
 abstract = {Plasma protein binding (PPB) is an important pharmacokinetic parameter. It is important to measure the PPB properties of drug molecules during drug development. However, in vivo or in vitro measurements are time-consuming. Therefore, in silico prediction methods are promising time-saving alternatives. This study presents a new deep learning model called enhancing plasma protein binding prediction (ePPBP) that merges molecular descriptors, molecular fingerprints and graph features for predicting PPB. The ePPBP currently has state-of-the-art (SOTA) performance, with an Rp2 of 0.8663, an R2 of 0.8630, an MAE of 0.0613 and an RMSE of 0.1041 on the test set. In addition, an ablation experiment demonstrated that different molecular representations can improve ePPBP performance. Next, an uncertainty estimation experiment was used to estimate the confidence when ePPBP was used to predict unknown chemicals. The MHFP distance and RDKFP similarity were selected as confidence indicators to determine whether the predictions were credible from ePPBP.},
 author = {Tian, Qifeng and Zhao, Jian and He, Zhe and Meng, Jinhui and Liu, Xiaoyu and Hu, Mengfeng and Liu, Jinhan and Feng, Huawei and Zhang, Li and Liu, Hongsheng},
 doi = {10.1109/TCBBIO.2025.3532332},
 issn = {2998-4165},
 journal = {IEEE Transactions on Computational Biology and Bioinformatics},
 keyword = {Predictive models;Drugs;Fingerprint recognition;Training;Proteins;Computational modeling;Plasmas;Deep learning;Chemicals;Data models;Feature extraction or construction;life and medical sciences;machine learning;modeling and prediction},
 month = {March},
 number = {2},
 pages = {653-660},
 title = {Enhancing Chemical Prediction in Plasma Protein Binding: A Deep Learning Model Combining Molecular Descriptors and Fingerprint Representation With Attention Mechanisms},
 volume = {22},
 year = {2025}
}
