@conference{Edwards2017175,
 abstract = {We present a technique for implementing dataflow networks as compositional hardware circuits. We first define an abstract dataflow model with unbounded buffers that supports data-dependent blocks (mux, demux, and nondeterministic merge); we then show how to faithfully implement such networks with bounded buffers and handshaking. Handshaking admits compositionality: our circuits can be connected with or without buffers and still compute the same function without introducing spurious combinational cycles. As such, inserting or removing buffers affects the performance but not the functionality of our networks, which we demonstrate through experiments that show how design space can be explored. © 2017 Association for Computing Machinery.},
 author = {Edwards, Stephen A. and Townsend, Richard and Kim, Martha A.},
 doi = {10.1145/3127041.3127055},
 journal = {MEMOCODE 2017 - 15th ACM-IEEE International Conference on Formal Methods and Models for System Design},
 note = {Cited by: 24; All Open Access; Green Open Access},
 pages = {175 - 184},
 publication_stage = {Final},
 source = {Scopus},
 title = {Compositional dataflow circuits},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85036459709?origin=resultslist},
 year = {2017}
}
