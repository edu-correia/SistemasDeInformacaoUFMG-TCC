@article{Rouane200751,
 abstract = {Recent advances in data and knowledge engineering have emphasized the need for formal concept analysis (FCA) tools taking into account structured data. There are a few adaptations of the classical FCA methodology for handling contexts holding on complex data formats, e.g. graph-based or relational data. In this paper, relational concept analysis (RCA) is proposed, as an adaptation of FCA for analyzing objects described both by binary and relational attributes. The RCA process takes as input a collection of contexts and of inter-context relations, and yields a set of lattices, one per context, whose concepts are linked by relations. Moreover, a way of representing the concepts and relations extracted with RCA is proposed in the framework of a description logic. The RCA process has been implemented within the GALICIA platform, offering new and efficient tools for knowledge and software engineering. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Rouane, Mohamed Hacene and Huchard, Marianne and Napoli, Amedeo and Valtchev, Petko},
 doi = {10.1007/978-3-540-70901-5_4},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 52; All Open Access; Green Open Access},
 pages = {51 - 65},
 publication_stage = {Final},
 source = {Scopus},
 title = {A proposal for combining formal concept analysis and description logics for mining relational data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/38049021526?origin=resultslist},
 volume = {4390 LNAI},
 year = {2007}
}
