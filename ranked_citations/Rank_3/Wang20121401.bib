@conference{Wang20121401,
 abstract = {The Constant Degree P2P systems are turning into the research hotspot, but all topologically-aware technologies perform poorly when replanted to them.combining constant degree topologies' property and taking FissionE as an example, we propose a merge technology RBFIM (Relaxed Balance based fast Induced Merge) to optimize the construction of topologically-aware hierarchy constant degree P2P Systems. Experiment results show that RBFIM not only preserves constant degree P2P systems' advantages on logically routing, but also strength the locality of communication and can be integrated with other optimization technologies. © 2012 IEEE.},
 author = {Wang, Xiaohai and Dai, Xiuliang and Li, Bei},
 doi = {10.1109/CSSS.2012.353},
 journal = {Proceedings - 2012 International Conference on Computer Science and Service System, CSSS 2012},
 note = {Cited by: 1},
 pages = {1401 - 1404},
 publication_stage = {Final},
 source = {Scopus},
 title = {An efficient merge technology for constant degree P2P systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84873843956?origin=resultslist},
 year = {2012}
}
