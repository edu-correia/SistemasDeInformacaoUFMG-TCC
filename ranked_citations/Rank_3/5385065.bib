@inproceedings{5385065,
 abstract = {ABS and TPMS is a technology measure enhanced automobile active safety performance. Nowadays the ABS system and the TPMS system are mutually independent and ABS system has standard configuration, while TPMS is increasingly increased and rising, so the article proposed a merged thought between the two kind of systems, which is essential to develop automobile electronic control systems integration. Sliding Mode Variable Structure control algorithm used is to realize two kind of functions at the same time, and using SIMULINK tool simulate system feasibly. The simulation results showed that the fusion thought proposed in this article guaranteed to control slipping rate range from 10% to 30% and monitored tire pressure value real-time, which explained system feasibility, and saved cost simultaneously.},
 author = {Jiapeng, Han and Xiaofeng, Tang},
 booktitle = {2009 International Forum on Computer Science-Technology and Applications},
 doi = {10.1109/IFCSTA.2009.89},
 issn = {},
 keyword = {Merging;Sliding mode control;Control systems;Electric variables control;Automobiles;Vehicle safety;Standards development;Pressure control;Monitoring;Tires;ABS;TPMS;SIMULINK;Sliding Mode Variable Structure control algorithm},
 month = {Dec},
 number = {},
 pages = {340-342},
 title = {Research on ABS and TPMS Merging System Based on Sliding Mode Variable Structure Control System},
 volume = {1},
 year = {2009}
}
