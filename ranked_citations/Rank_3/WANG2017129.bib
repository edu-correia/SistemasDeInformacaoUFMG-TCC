@incollection{WANG2017129,
 abstract = {This chapter will offer some food for thought as libraries look to sculpt a new type of partnership between vendors and libraries and a new supply chain that leverages emerging standards, practices, and technologies. The chapter encourages publishers, technology vendors, and libraries to streamline their separate processes so they form the Extended Supply Chain. Some examples in this chapter include incorporation of Search Engine Optimization as a core competency, use of a shared metadata standard among publishers and libraries to eliminate redundant work, and adoption of semantic linking as the default library resource description method. The goal of the chapter is to help libraries integrate with merging standards, practices, and technologies, so they can reach a new and higher level of scalability, visibility, and efficiency from their own networked operations to the Internet-level operations.},
 author = {Zheng (John) Wang},
 booktitle = {Supply Chain Management for Collection Services of Academic Libraries},
 doi = {https://doi.org/10.1016/B978-0-08-102031-9.00014-1},
 editor = {Zheng (John) Wang},
 isbn = {978-0-08-102031-9},
 keyword = {Collaboration, Collection services supply chain, Core competency, Core service, Extended supply chain, Knowledge supply chain, MARC, ONIX, Partnership, Search engine optimization, Semantic linking, Semantic processing},
 pages = {129-139},
 publisher = {Chandos Publishing},
 title = {Chapter 14 - Emerging Standards, Practices, and Technologies},
 url = {https://www.sciencedirect.com/science/article/pii/B9780081020319000141},
 year = {2017}
}
