@incollection{CHOLAMJIAK2025153,
 abstract = {This chapter explores variational inclusion problems, focusing on the role of monotone operators. It begins by discussing the characteristics and impact of a single monotone operator on variational inclusions, then expands to include scenarios with two monotone operators, thus broadening the scope to more complex cases. The forward-backward algorithm is central to solving these problems, and it has been thoroughly examined for its structure and theoretical underpinnings, including a detailed convergence analysis. Practical applications in infinite-dimensional spaces are demonstrated through extensive numerical results, validating the algorithm's effectiveness. This chapter aims to comprehensively understand variational inclusion problems, merging theory with practical application through detailed examples and proven algorithmic strategies.},
 author = {Watcharaporn Cholamjiak},
 booktitle = {Fixed Point Optimization Algorithms and Their Applications},
 doi = {https://doi.org/10.1016/B978-0-44-333586-0.00016-7},
 editor = {Watcharaporn Cholamjiak},
 isbn = {978-0-443-33586-0},
 keyword = {Variational inclusion problems, Resolvent operators, Forward–backward algorithms, Monotone operator, Convergence analysis},
 pages = {153-170},
 publisher = {Morgan Kaufmann},
 series = {Advanced Studies in Complex Systems: Theory and Applications},
 title = {7 - Variational inclusion problems},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443335860000167},
 year = {2025}
}
