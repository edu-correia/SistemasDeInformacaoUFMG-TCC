@article{Song2013141,
 abstract = {Dataspaces are recently proposed to manage heterogeneous data, with features like partially unstructured, high dimension and extremely sparse. The inverted index has been previously extended to retrieve dataspaces. In order to achieve more efficient access to dataspaces, in this paper, we first introduce our survey of data features in the real dataspaces. Based on the features observed in our study, several partitioning based index approaches are proposed to accelerate the query processing in dataspaces. Specifically, the vertical partitioning index utilizes the partitions on tokens to merge and compress data. We can both reduce the number of I/O reads and avoid aggregation of data inside a compressed list. The horizontal partitioning index supports pruning partitions of tuples in the top-k query. Thus, we can reduce the computation overhead of irrelevant candidate tuples to the query. Finally, we also propose a hybrid index with both vertical and horizontal partitioning. The extensive experiment results in real data sets demonstrate that our approaches outperform the previous techniques and scale well with the large data size. © 2012 Springer Science+Business Media, LLC.},
 author = {Song, Shaoxu and Chen, Lei},
 doi = {10.1007/s11280-012-0163-7},
 journal = {World Wide Web},
 note = {Cited by: 8},
 number = {2},
 pages = {141 - 170},
 publication_stage = {Final},
 source = {Scopus},
 title = {Indexing dataspaces with partitions},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84872614972?origin=resultslist},
 volume = {16},
 year = {2013}
}
