@conference{McInnes201733,
 abstract = {We present an accelerated algorithm for hierarchical density based clustering. Our new algorithm improves upon HDBSCAN∗, which itself provided a significant qualitative improvement over the popular DBSCAN algorithm. The accelerated HDBSCAN∗ algorithm provides comparable performance to DBSCAN, while supporting variable density clusters, and eliminating the need for the difficult to tune distance scale parameter epsilon. This makes accelerated HDBSCAN∗ the default choice for density based clustering. © 2017 IEEE.},
 author = {McInnes, Leland and Healy, John},
 doi = {10.1109/ICDMW.2017.12},
 journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
 note = {Cited by: 503; All Open Access; Green Open Access},
 pages = {33 - 42},
