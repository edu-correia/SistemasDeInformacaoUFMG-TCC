@inproceedings{6359368,
 abstract = {Shape recognition is an important problem in many applications. A simple string matching approach for shape recognition is proposed in this paper. The shapes are coded as their dominant points. The compactness of polygons formed by the centroid and three consecutive dominant points is used as the feature for recognition. The experimental results showed that the proposed method has better recognition rates and more consistent performance than that of using the conventional features. Further, the proposed method doesn't need to set parameters, so that it is robust in the shape recognition.},
 author = {Wu, Wen-Yen},
 booktitle = {Proceedings of the 10th World Congress on Intelligent Control and Automation},
 doi = {10.1109/WCICA.2012.6359368},
 issn = {},
 keyword = {Shape;Testing;Pattern recognition;Syntactics;Cost function;Approximation algorithms;Approximation methods;Shape recognition;String matching;Compactness;Dominant point detection;Features},
 month = {July},
 number = {},
 pages = {4696-4700},
 title = {A simple string matching method for shape recognition},
 volume = {},
 year = {2012}
}
