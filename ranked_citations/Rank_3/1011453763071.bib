@article{10.1145/3763071,
 abstract = {The advances in modern storage technologies necessitate the development of new input/output (I/O) APIs to maximize their performance benefits. However, migrating existing software to use different APIs poses significant challenges due to mismatches in computational models and complex code structures surrounding stateful, non-contiguous multi-API call sites. We present Sprout, a new system for automatically migrating programs across I/O APIs that guarantees behavioral equivalence. Sprout uses flow-sensitive pointer analysis to identify semantic variables, which enables the typestate analysis for matching API semantics and the synthesis of migrated programs. Experimental results with real-world C programs highlight the efficiency and effectiveness of our approach. We also show that Sprout can be adapted to other domains, such as databases.},
 address = {New York, NY, USA},
 articleno = {293},
 author = {Li, Shangyu and Zhang, Zhaoyang and Zhong, Sizhe and Zhou, Diyu and Shen, Jiasi},
 doi = {10.1145/3763071},
 issue_date = {October 2025},
 journal = {Proc. ACM Program. Lang.},
 keyword = {Program Migration, Program Synthesis, Static Analysis},
 month = {October},
 number = {OOPSLA2},
 numpages = {31},
 publisher = {Association for Computing Machinery},
 title = {A Sound Static Analysis Approach to I/O API Migration},
 url = {https://doi.org/10.1145/3763071},
 volume = {9},
 year = {2025}
}
