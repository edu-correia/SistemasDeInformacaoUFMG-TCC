@conference{Birov2011136,
 abstract = {In this paper, we describe a strategy for implementing source code analysis, model extraction, edition and analysis and code generation tools that can be applied to a software modernization of existing legacy software intensive system. As well we present an integrated approach focused on model driven architecture for software modernizations. Started with an extraction models from source code and other available software artefacts, transforming these models in order to obtain modern structure of software, and then generate a code from these models. Bussiness modeling tools and models naturally fits in the proposed constuction. A tools implementing domain specific languages are integrated into framework in vertical pipeline toolsuite. Copyright © 2011 SciTePress - Science and Technology Publications.},
 author = {Birov, Dimitar and Todorova, Yanka},
 doi = {10.5220/0004459501360142},
 journal = {BMSD 2011 - Proceedings of the 1st International Symposium on Business Modeling and Software Design},
 note = {Cited by: 0},
 pages = {136 - 142},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards the automatic architecture driven software modernization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84877778601?origin=resultslist},
 year = {2011}
}
