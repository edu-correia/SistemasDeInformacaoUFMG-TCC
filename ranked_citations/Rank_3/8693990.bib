@article{8693990,
 abstract = {Privacy-preserving distributed data fusion is a pretreatment process in data mining involving security models. In this paper, we present a method of implementing multiparty data fusion, wherein redundant attributes of a same set of individuals are stored by multiple parties. In particular, the merged data does not suffer from background attacks or other reasoning attacks, and individual attributes are not leaked. To achieve this, we present three algorithms that satisfy K-anonymous and differential privacy. Experimental results on real datasets suggest that the proposed algorithm can effectively preserve information in data mining tasks.},
 author = {Su, Xin and Fan, Kuan and Shi, Wenbo},
 doi = {10.1109/TII.2019.2912175},
 issn = {1941-0050},
 journal = {IEEE Transactions on Industrial Informatics},
 keyword = {Data integration;Differential privacy;Distributed databases;Privacy;Security;Sensitivity;Data as a server (DaaS);distributed data fusion;differential privacy; $K$ -anonymous;privacy preserving},
 month = {Oct},
 number = {10},
 pages = {5765-5777},
 title = {Privacy-Preserving Distributed Data Fusion Based on Attribute Protection},
 volume = {15},
 year = {2019}
}
