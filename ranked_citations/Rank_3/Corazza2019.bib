@article{Corazza2019,
 abstract = {Walking and transit are the backbone of sustainable mobility. Bus stops not only represent the connection between the two, but are also central in dictating the attractiveness of the latter. Accessibility of bus stops becomes, then, pivotal in increasing both attractiveness and sustainability of public transport. The paper describes a multi-step methodology to evaluate bus stops' accessibility starting from a cluster of seven indicators describing objective and subjective features influencing passengers' choice toward a given bus stop. The indicators are weighed by a questionnaire submitted to experts. Finally, a multicriteria analysis is developed to obtain a final score describing univocally the accessibility of each stop. Outcomes are mapped and a case study in Rome is reported as an example, with 231 bus and tram stops assessed accordingly. Results shows the relevance of the urban network and environment in evaluating the accessibility and in promoting more sustainable mobility patterns. Research innovation relies on the possibility to merge data from different fields into a specific GIS map and easily highlight for each bus stop the relationships between built environment, passengers' comfort, and accessibility, with the concluding goal to provide advanced knowledge for further applications. © 2019 by the authors.},
 author = {Corazza, Maria Vittoria and Favaretto, Nicola},
 doi = {10.3390/su11030803},
 journal = {Sustainability (Switzerland)},
 note = {Cited by: 77; All Open Access; Gold Open Access; Green Open Access},
 number = {3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A methodology to evaluate accessibility to bus stops as a contribution to improve sustainability in urban mobility},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85061075420?origin=resultslist},
 volume = {11},
 year = {2019}
}
