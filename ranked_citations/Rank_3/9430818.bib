@inbook{9430818,
 abstract = {Cloud technologies such as Software as a Service (SaaS) are fundamentally changing the way logistics organizations operate. The SaaS model overcomes many challenges faced by conventional logistics software like Warehouse Management Systems (WMS) and Transportation Management Systems (TMS). By offering improved user experiences, application programmer interfaces (API), and sophisticated analytics capabilities, SaaS products are helping organizations automate operations and optimize supply chains. However, leveraging these cloud tools requires a new type of talent. Modern workers in the supply chain field need logistics domain knowledge, expertise with key SaaS applications, proficiency in data integration, and the analytic skills necessary to leverage data for improved business results. In the cloud&#x2010;powered workplace, business value will be created in new ways by a new class of worker that merges logistics expertise with functions traditionally handled by the IT department.},
 author = {Berry, John},
 booktitle = {The Digital Transformation of Logistics: Demystifying Impacts of the Fourth Industrial Revolution},
 doi = {10.1002/9781119646495.ch9},
 isbn = {9781119646457},
