@article{11352880,
 abstract = {Generating pixel-level annotations for the semantic segmentation of high-resolution remote sensing images is labor-intensive and time-consuming. To address this issue, numerous studies attempt to generate pixel-level annotations through automatic or semi-automatic labeling strategies. However, due to the inherent complexity of remote sensing imagery and the presence of unseen classes, achieving both accurate foreground segmentation and precise class labeling remains highly challenging. In this letter, we propose an unsupervised multimodal guided segmentation (UniMGS) framework that generates pseudo-labels for remote sensing images without requiring any ground-truth annotations or additional prompts. Specifically, we propose a mask purification module (MPM) that refines class-agnostic segmentation masks by applying an area filter and a ring-merging strategy to remove noisy masks and merge oversegmented regions. To assign precise categories to class-agnostic segmentation masks, we propose a text-driven classifier (TDC) module. This module constructs an intraclass maximum spanning tree from a similarity matrix and incorporates cluster size constraints together with a confidence scoring mechanism, ultimately achieving precise class labeling. Experimental results on multiple remote sensing datasets demonstrate that UniMGS outperforms the existing state-of-the-art methods. Our source code is available at https://github.com/nanwang0511/UniMGS},
 author = {Wang, Nan and Bi, Fukun and Zhou, Dehao and Han, Jianhong and Liu, Wenkai},
 doi = {10.1109/LGRS.2026.3654360},
 issn = {1558-0571},
 journal = {IEEE Geoscience and Remote Sensing Letters},
 keyword = {Remote sensing;Semantics;Annotations;Prototypes;Dams;Accuracy;Semantic segmentation;Trees (botanical);Labeling;Buildings;Multimodal fusion;semantic segmentation;unsupervised},
 month = {},
 number = {},
 pages = {1-5},
 title = {UniMGS: Unsupervised Multimodal Guided Segmentation for High-Resolution Remote Sensing Images},
 volume = {23},
 year = {2026}
}
