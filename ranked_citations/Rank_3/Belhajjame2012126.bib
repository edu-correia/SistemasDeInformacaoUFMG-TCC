@article{Belhajjame2012126,
 abstract = {Scientific workflows are often data intensive. The data sets obtained by enacting scientific workflows have several applications, e.g., they can be used to identify data correlations or to understand phenomena, and therefore are worth storing in repositories for future analyzes. Our experience suggests that such datasets often contain duplicate records. Indeed, scientists tend to enact the same workflow multiple times using the same or overlapping datasets, which gives rise to duplicates in workflow results. The presence of duplicates may increase the complexity of workflow results interpretation and analyzes. Moreover, it unnecessarily increases the size of datasets within workflow results repositories. In this paper, we present an approach whereby duplicates detection is guided by workflow provenance trace. The hypothesis that we explore and exploit is that the operations that compose a workflow are likely to produce the same (or overlapping) dataset given the same (or overlapping) dataset. A preliminary analytic and empirical validation shows the effectiveness and applicability of the method proposed. © 2012 Springer-Verlag.},
 author = {Belhajjame, Khalid and Missier, Paolo and Goble, Carole A.},
 doi = {10.1007/978-3-642-34222-6_10},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1; All Open Access; Green Open Access},
 pages = {126 - 138},
 publication_stage = {Final},
 source = {Scopus},
 title = {Detecting duplicate records in scientific workflow results},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84868292523?origin=resultslist},
 volume = {7525 LNCS},
 year = {2012}
}
