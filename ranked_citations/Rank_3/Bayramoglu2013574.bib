@conference{Bayramoglu2013574,
 abstract = {The paper presents a multi-hypothesis filter library featuring a novel method for splitting Gaussians into ones with smaller variances. The library is written in C++ for high performance and the source code is open and free' The multi-hypothesis filters commonly approximate the distribution transformations better, if the covariances of the individual hypotheses are sufficiently small. We propose a look-up table based method to calculate a set of Gaussian hypotheses approximating a wider Gaussian in order to improve the filter approximation. Python bindings for the library are also provided for fast prototyping. © 2013 IEEE.},
 author = {Bayramoglu, Enis and Ravn, Ole and Andersen Electrical, Nils Axel},
 doi = {10.1109/ICCA.2013.6564951},
 journal = {IEEE International Conference on Control and Automation, ICCA},
 note = {Cited by: 8},
 pages = {574 - 579},
 publication_stage = {Final},
 source = {Scopus},
 title = {A novel hypothesis splitting method implementation for multi-hypothesis filters},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84882343192?origin=resultslist},
 year = {2013}
}
