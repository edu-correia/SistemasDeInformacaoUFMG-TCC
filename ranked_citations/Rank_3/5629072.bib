@inproceedings{5629072,
 abstract = {Information Retrieval is a well established interdisciplinary topic in which machine learning, computational linguistic, computer programming and data mining merge together. SLAIR stands for Sea Lab Advanced Information Retrieval and is an efficient software architecture that embeds these issues in a unique framework. SLAIR is expandable both from the data format and algorithm point of view. A pluggable notion of distance between documents drives the subsequent clustering/classification machinery, moreover SLAIR is explicitly designed to manage large scale text mining problems. The demo will be focused on the versatility of the framework, the main goal is to show how the different metrics provided by SLAIR can enhance clustering/classification ability and eventually lead to different views of the underlying textual data.},
 author = {Sangiacomo, Fabio and Leoncini, Alessio and Decherchi, Sergio and Gastaldo, Paolo and Zunino, Rodolfo},
 booktitle = {2010 IEEE Fourth International Conference on Semantic Computing},
 doi = {10.1109/ICSC.2010.48},
 issn = {},
 keyword = {Semantics;Calibration;Clustering algorithms;Kernel;Training;Databases;Text Clustering;Hybrid Metric;Semantic Representation;WordNet;Kernel K-Means;Support Vector Machines},
 month = {Sep.},
 number = {},
 pages = {444-445},
 title = {SeaLab Advanced Information Retrieval},
 volume = {},
 year = {2010}
}
