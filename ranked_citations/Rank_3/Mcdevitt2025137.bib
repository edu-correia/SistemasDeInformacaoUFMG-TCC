@conference{Mcdevitt2025137,
 abstract = {Modern software systems have grown increasingly complex, necessitating the collaborative efforts of diverse teams comprised of multiple developers. The combined efforts and collaboration of distributed teams create underlying networks within which these teams operate. This project presents a Java-based visualization tool that analyzes and depicts collaborative patterns within the Linux kernel development community. We extract contributor information from the Linux kernel repository to construct a network graph where nodes represent individual contributors and edges indicate shared contributions on the same commits. By showing which contributors tend to work together, the tool helps identify likely points of contact for bug triage, code maintenance, and understanding subsystem ownership. It also lays the groundwork for a deeper analysis of team structure and collaboration patterns.  © 2025 IEEE.},
 author = {Mcdevitt, Ella G. and Parra, Esteban},
 doi = {10.1109/VISSOFT67405.2025.00028},
 journal = {Proceedings - 2025 IEEE Working Conference on Software Visualization, VISSOFT 2025},
 note = {Cited by: 0},
 pages = {137 - 140},
 publication_stage = {Final},
 source = {Scopus},
 title = {Visualizing Linux Kernel Contributor Networks in Java},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105018905189?origin=resultslist},
 year = {2025}
}
