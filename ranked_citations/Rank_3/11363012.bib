@article{11363012,
 abstract = {This letter proposes several constellation integration schemes for a simultaneous transmitting and reflecting reconfigurable intelligent surface (STAR-RIS) enabled symbiotic backscatter system to achieve a 360° merging transmission, which include the bistatic scheme, the uniquely factorable constellation pair (UFCP) scheme, and the non-orthogonal multiple access (NOMA)-UFCP scheme. To begin with, we design the detectors of the proposed schemes and derive the closed-form expressions of the symbol error rate (SER) and throughput of the underlying system. Then, an algorithm for solving the optimal reflection and transmission coefficients is subsequently designed to maximize the system achievable performance. Finally, numerical results show that the throughput performance of the proposed Bistatic, UFCP, and NOMA-UFCP schemes outperform the corresponding benchmarks over the entire signal-to-noise ratio region.},
 author = {Wen, Zhen and Ding, Haiyang and Wang, Shilian and Song, Guoxi and Feng, Chenglin and Moualeu, Jules M. and Elkashlan, Maged and Yuen, Chau},
 doi = {10.1109/LWC.2026.3657385},
 issn = {2162-2345},
 journal = {IEEE Wireless Communications Letters},
 keyword = {Backscatter;Throughput;Binary phase shift keying;Signal to noise ratio;Symbiosis;NOMA;Detectors;Reconfigurable intelligent surfaces;Maximum likelihood estimation;Performance analysis;Backscatter communications;constellation integration schemes;reflection and transmission coefficients},
 month = {},
 number = {},
 pages = {1538-1542},
 title = {360° Merging Coverage: A STAR-RIS-Enabled Symbiotic Backscatter System With Constellation Integration Schemes},
 volume = {15},
 year = {2026}
}
