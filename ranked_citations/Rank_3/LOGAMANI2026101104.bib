@article{LOGAMANI2026101104,
 abstract = {Nutrigenomics is a novel, rapidly expanding field that tries to understand the complex connections between diet, genetics and health. They provide an overview of the history of the subject along with the molecular aspects, key nutrients, applications of the science to personalised nutrition and chronic disease development, and others. Just recently, due to the development of genome-based technology, researchers have started to unveil the gene-nutrient interplay and its role in metabolic processes. Folate, B12, polyphenols, Vitamin D and many other nutrients are involved in epigenetics through DNA methylation, histone acetylation, miRNA and transcription factors. This paper reviews to clarify the interactions between dietary nutrients and genetic variations in regulating gene expression via epigenetic mechanisms, including DNA methylation, histone modifications, and non-coding RNAs, while emphasising the influence of food-derived bioactive compounds in nutrigenetics to support personalised nutrition and strategies for disease prevention. Nutrigenomics has the potential to greatly impact the fields of common disease prevention and treatment, such as that of obesity, type 2 diabetes and cardiovascular diseases, integrating the identification of genetic predispositions and their specific diet-based treatments. While the applications of nutrigenomics may also offer some hope for the therapeutic, the reality is that incorporation of nutrigenomic research in the clinical setting poses ethical, privacy and health care culture challenges. In perspective, what research should do is to start singling out good clinical trials, establish ethical standards that need to be in place, and promote safe practices that can ensure equal growth in nutrigenomics for public health as well as personalised nutrition. But it is this merge between nutrition and genomics, or nutrigenomics, under the promise of technology that most greatly will influence healthcare.},
 author = {Santhanam Logamani and Theivasigamani Parthasarathi},
 doi = {https://doi.org/10.1016/j.foohum.2026.101104},
 issn = {2949-8244},
 journal = {Food and Humanity},
 keyword = {Nutrigenomics, Gene expression, Epigenetics, Transcription factor, MicroRNA, Chronic diseases, Personalised nutrition},
 pages = {101104},
 title = {Nutrigenomics and the interface between diet and gene expression},
 url = {https://www.sciencedirect.com/science/article/pii/S2949824426001126},
 volume = {6},
 year = {2026}
}
