@conference{Zhou2025744,
 abstract = {Recommendation systems play a crucial role in personalizing user experiences by utilizing data from both user behavior and content features. However, traditional approaches often struggle to effectively integrate these distinct data sources. In this work, we present a novel framework named RAF, which employs attention mechanisms to adeptly merge user behavior and content data. The framework consists of two pivotal components: the user behavior representation module that leverages attention techniques to weigh historical interactions, and the content feature representation module that focuses on significant attributes of the recommended items. RAF dynamically adjusts the importance of varied data sources, leading to a more nuanced understanding of user preferences. Comprehensive experiments on established datasets show marked advancements in recommendation accuracy and variety, underscoring the potential of our approach in enhancing user engagement with content. Ultimately, this methodology significantly enriches the quality of recommendations provided to users. © 2025 IEEE.},
 author = {Zhou, Hanqin},
 doi = {10.1109/ISCTIS65944.2025.11065083},
 journal = {2025 5th International Symposium on Computer Technology and Information Science, ISCTIS 2025},
 note = {Cited by: 0},
 pages = {744 - 747},
 publication_stage = {Final},
 source = {Scopus},
 title = {Attention Fusion of User Behavior and Content Data in Recommendation Systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105011940515?origin=resultslist},
 year = {2025}
}
