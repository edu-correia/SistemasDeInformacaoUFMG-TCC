@inproceedings{11283507,
 abstract = {Fingerprint identification technology for cybersecurity products enables rapid determination of network asset attributes by extracting unique characteristics of products, and has important applications in network asset inventory, risk localization, intrusion detection and defense, attack traceability and forensics, and product compliance verification. Currently, fingerprint identification techniques for IPSec products mostly rely on data features extracted from interactive traffic. However, since device users can modify configurations, the collected fingerprint features may be altered or forged, thereby affecting the accuracy of identification.This paper proposes a statemachine aggregation-based fingerprint identification technique for IPSec devices, focusing on fingerprint features derived from the underlying code implementation of devices. We employ model learning techniques to generate state machines as fingerprints and introduce a state machine aggregation algorithm to accomplish fingerprint matching. We conducted fingerprint identification experiments on 8 IPSec devices from different manufacturers or models. The results demonstrate that the proposed method achieves a $\mathbf{1 0 0 \%}$ device discrimination rate, outperforming existing identification approaches.},
 author = {Sun, Xiangyu and Zheng, Yonghui and Ju, Mengcheng and Gu, Chunxiang},
 booktitle = {2025 5th International Conference on Electronic Information Engineering and Computer Science (EIECS)},
 doi = {10.1109/EIECS67708.2025.11283507},
 issn = {},
 keyword = {Performance evaluation;Location awareness;Protocols;Trees (botanical);Refining;Fingerprint recognition;Feature extraction;Stability analysis;Object recognition;Testing;-Fingerprint recognition;IPSec protocol;Model learning},
 month = {Sep.},
 number = {},
 pages = {749-753},
 title = {Research on IPSec Device Fingerprinting Technology Based on State Machine Aggregation},
 volume = {},
 year = {2025}
}
