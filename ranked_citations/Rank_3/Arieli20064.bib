@article{Arieli20064,
 abstract = {We introduce a simple and practical method for repairing inconsistent databases. Given a possibly inconsistent database, the idea is to properly represent the underlying problem, i.e., to describe the possible ways of restoring its consistency. We do so by what we call signed formulae, and show how the 'signed theory' that is obtained can be used by a variety of off-the-shelf computational models in order to compute the corresponding solutions, i.e., consistent repairs of the database. © Springer 2006.},
 author = {Arieli, Ofer and Denecker, Marc and Van Nuffelen, Bert and Bruynooghe, Maurice},
 doi = {10.1007/s10472-005-9012-z},
 journal = {Annals of Mathematics and Artificial Intelligence},
 note = {Cited by: 11; All Open Access; Green Open Access},
 number = {1-2},
 pages = {4 - 37},
 publication_stage = {Final},
 source = {Scopus},
 title = {Computational methods for database repair by signed formulae},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33645693541?origin=resultslist},
 volume = {46},
 year = {2006}
}
