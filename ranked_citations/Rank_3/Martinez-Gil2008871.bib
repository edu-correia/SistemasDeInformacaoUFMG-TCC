@conference{Martinez-Gil2008871,
 abstract = {This work is about an experiment in which we have compared the textual rendering of ontologies in order to get more accurate alignments between them. The experiments we have performed consist on three main steps: rendering in a textual way two ontologies, comparing the obtained text with several algorithms for text comparing and, using the obtained result as a factor to improve the alignments between them. As result, we got some evidences that this technique gives us a good measure of the similarity of ontologies and, therefore can allow us to improve the effectiveness of the alignment process. © 2008 IEEE.},
 author = {Martinez-Gil, Jorge and Navas-Delgado, Ismael and Polo-Marquez, Antonio and Aldana-Montes, Jose F.},
 doi = {10.1109/CISIS.2008.71},
 journal = {Proceedings - CISIS 2008: 2nd International Conference on Complex, Intelligent and Software Intensive Systems},
 note = {Cited by: 2},
 pages = {871 - 876},
 publication_stage = {Final},
 source = {Scopus},
 title = {Comparison of textual renderings of ontologies for improving their alignment},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/53149113029?origin=resultslist},
 year = {2008}
}
