@inproceedings{4426259,
 abstract = {Peer-to-peer (P2P) systems, which enable queries over an amount of documents distributed among a dynamic set of peers, have been more and more popular. This paper presents a text sharing and retrieval system which is layered on top of an unstructured P2P overlay network where every autonomous peer has powerful indexing and searching ability. By means of appropriate peer join policy and parameter value setting, our system not only efficiently supports various kinds of queries, such as metadata-based queries, content-based queries and the boolean operations between them, but also has significant scalability. The system also provides friendly GUI for merging and displaying the query results and has already been used by many universities and institutions.},
 author = {Jiang, Qinliang and Guan, Jihong},
 booktitle = {Future Generation Communication and Networking (FGCN 2007)},
 doi = {10.1109/FGCN.2007.29},
 issn = {2153-1463},
 keyword = {Peer to peer computing;Scalability;Costs;Web server;Query processing;Computer science;Robustness;Bandwidth;Web and internet services;Distributed computing},
 month = {Dec},
 number = {},
 pages = {338-343},
 title = {A Peer-to-Peer Based Text Sharing and Retrieval System},
 volume = {2},
 year = {2007}
}
