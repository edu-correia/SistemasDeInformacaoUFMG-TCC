@inproceedings{8472643,
 abstract = {Combination of multi-scale transformations and sparse representation (SR) is one of the most useful techniques for fusion of multi modal images. Discrete Shearlet Transform (DST) is one of the directional transforms that is proper to merge MRI and PET scan images. Here, grey-level hit or miss transform (HMT) and matched filter are used to convert both modalities to image patches and form the dictionary of sparse coding. Finally, PCA is utilized to get more important atoms, because the number of atoms is one of important issues. The fusion rule for high frequency components is averaging and weighted averaging is considered for low frequency components. This fusion rule properly demonstrates fused image and induces to visual enhancement. The proposed dictionary has salient results in terms of: mutual information (MI), visual information fidelity (VIF) and correlation coefficients (SCC and PCC); compared to other dictionary learning strategies which are K-SVD and recursive least square (RLS) methods.},
 author = {Farkhani, Sadaf and Pourghassem, Hossein},
 booktitle = {Electrical Engineering (ICEE), Iranian Conference on},
 doi = {10.1109/ICEE.2018.8472643},
 issn = {},
 keyword = {Dictionaries;Transforms;Magnetic resonance imaging;Matching pursuit algorithms;Matched filters;Feature extraction;sparse representation;image fusion;dictionary learning;discrete shearlet transform;hit or miss transform;matched filter},
 month = {May},
 number = {},
 pages = {1435-1440},
 title = {Sparse-Based Medical Image Fusion Using a Novel Optimal Dictionary Strategy and Shearlet Transform},
 volume = {},
 year = {2018}
}
