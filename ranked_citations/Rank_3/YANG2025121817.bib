@article{YANG2025121817,
 abstract = {The exponential growth in mobile application has greatly enhanced convenience in daily life, yet it has also complicated the process for users to find necessary apps in crowded mobile markets. This study presents an enhanced recommendation system that combines an attention-augmented Long Short-Term Memory (LSTM) architecture with a Bidirectional Recurrent Neural Network (BiRNN) to optimize user preference extraction. The attention mechanism enriches the traditional LSTM framework by prioritizing critical temporal data points, thereby improving both long-term preference processing accuracy and model interpretability. Experiments utilizing a dataset comprising 37,074 users and 52,783 applications demonstrated a 36.6% performance improvement compared to the Sequential Hierarchical Attention Network (SHAN) baseline model.},
 author = {Chen Yang and Jinyuan Fang and Chuang Wang and Zeyi Fan and Eric W.K. See-To and Ben Niu},
 doi = {https://doi.org/10.1016/j.ins.2024.121817},
 issn = {0020-0255},
 journal = {Information Sciences},
 keyword = {Mobile application recommendation, User preferences, Deep learning},
 pages = {121817},
 title = {Enhancing mobile app recommendations through adaptive fusion of long-term stability and short-term interests},
 url = {https://www.sciencedirect.com/science/article/pii/S0020025524017316},
 volume = {699},
 year = {2025}
}
