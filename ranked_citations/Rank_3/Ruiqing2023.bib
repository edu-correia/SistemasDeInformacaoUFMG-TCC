 publication_stage = {Final},
 source = {Scopus},
 title = {DATA GOVERNANCE, INTEROPERABILITY AND STANDARDIZATION: ORGANIZATIONAL ADAPTATION TO PRIVACY REGULATION},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85192865817?origin=resultslist},
