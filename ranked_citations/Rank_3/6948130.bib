@inproceedings{6948130,
 abstract = {As a basic structure of computational geometry, Voronoi Diagram is important to data analysis of GIS. Considering the limitations of traditional vectorial and raster generation algorithm of Voronoi diagram, this paper proposes a spherical Full-Feature Voronoi diagram generation algorithm based on vector data. Through the design of an integrated perspective projection model, data and its connected relationship on the surface of a sphere will be projected to the Euclidean plane. And the discrete feature sets on this Euclidean plane will become point sets for generating sub-Voronoi diagrams. Then these sub-Voronoi diagrams will be merged if they belong to the same feature to accomplish the generation of spherical full-feature Voronoi Diagram. The result of empirical experiment shows that this algorithm is viable, and the accuracy of this algorithm has been discussed at the end of the paper.},
 author = {Zhang, Fengqi and Li, Jiatian and Zhao, Hai and Kang, Shun and Li, Xiaojuan},
 booktitle = {2014 International Conference on Information Science, Electronics and Electrical Engineering},
 doi = {10.1109/InfoSEEE.2014.6948130},
 issn = {},
 keyword = {Algorithm design and analysis;Equations;Mathematical model;Vectors;Time complexity;Heuristic algorithms;Data models;Voronoi Diagram;Full-feature;Perspective projection;Vector method},
 month = {April},
 number = {},
 pages = {351-355},
 title = {The generation algorithm for spherical full-feature Voronoi diagram},
 volume = {1},
 year = {2014}
}
