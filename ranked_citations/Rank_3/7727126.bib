@inproceedings{7727126,
 abstract = {In the distributed environment it is very much necessary to build a system which share secure data among multiple users. Key-escrow problem is the major issue in data sharing between users. In the existing system, the key escrow problem can be solved by escrow free key issuing protocol using two-Party Computation (2PC) between Key Generation Centre and Data Storing centre. Centralized system trust CA (Central Authority) for the key generation, if the CA is intruded by trespasser, then the entire system will get wrapped. It is very much important to have a decentralized system. Hence, we propose a system which improves the security and efficiency in key generation, uses a 3PC where the user key will be generated in application centre too. Here, the data will be stored and retrieved based on the attributes of the user. Ant colony optimization algorithm is used to merge the key generated by 3PC. CP-ABE algorithm and MD5 algorithm are used to encrypt and decrypt the messages in the multi user data sharing environment. The proposed scheme delegates most laborious tasks of membership management and user revocation to the data storing centre while the KGC (Key Generation Center) is responsible for the attribute key management as in the previous CP-ABE schemes without leaking any confidential information to the other parties.},
 author = {SuphaLakshmi, A. and Revathi, M.},
 booktitle = {2016 10th International Conference on Intelligent Systems and Control (ISCO)},
 doi = {10.1109/ISCO.2016.7727126},
 issn = {},
 keyword = {Algorithm design and analysis;Encryption;Distributed databases;Ant colony optimization;Protocols;Key Escrow problem;2PC;3PC;CP-ABE;CA;trespasser and KGC},
 month = {Jan},
 number = {},
 pages = {1-5},
 title = {Secure data sharing using 3-party decentralized communication},
 volume = {},
 year = {2016}
}
