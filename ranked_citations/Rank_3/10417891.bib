@inproceedings{10417891,
 abstract = {This study tackles the complexity of wireless network mapping in TDMA mesh networks. We propose an aggregated data collection method that reduces the number of response messages from each node in the network. Instead of using a bit field, we suggest a sum per node approach. This method results in receiving sums of the rows of the adjacency matrix of the graph representing the network, enabling the reconstruction of the network graph's structure. However, this reconstruction is limited to structural properties, indicating that unique identifiers for the nodes may be necessary for precise topological reconstruction.},
 author = {Sebestyén, Gergely and Kopiák, József},
 booktitle = {2023 IEEE 21st Jubilee International Symposium on Intelligent Systems and Informatics (SISY)},
 doi = {10.1109/SISY60376.2023.10417891},
 issn = {1949-0488},
 keyword = {Time division multiple access;Wireless networks;Data collection;Complexity theory;Topology;Synchronization;Task analysis;wireless network energy consumption;battery lifetime estimation;merged data collecting;MDC;IQRF;FRC;TDMA;flooding routing},
 month = {Sep.},
 number = {},
 pages = {000659-000662},
 title = {Optimization of TDMA Wireless Network Mapping Using Merged Data Collecting},
 volume = {},
 year = {2023}
}
