@inproceedings{10185381,
 abstract = {Augmented and Virtual Reality (AR/VR) are disruptive technologies poised to become the next generation compute platforms. It represents a merging of the physical and the digital domains into a rich, context aware and accessible user interface delivered in real-time through a socially acceptable form factor. Innovations in the key technical areas of Power/Performance, Form Factor, and Thermal are essential to produce all-day wearable AR products. We present a research prototype sensor SoC, optimized for AR/VR and Smartglasses prototypes, aiming at reducing future product size and power. It allows substantial computational capabilities, through specialized accelerators, at very low power levels. It is architected to allow data locality and reuse, as well as power efficient data movement.},
 author = {Kaiser, Karl and Patil, Dinesh and Beigne, Edith},
 booktitle = {2023 IEEE Symposium on VLSI Technology and Circuits (VLSI Technology and Circuits)},
 doi = {10.23919/VLSITechnologyandCir57934.2023.10185381},
 issn = {2158-9682},
 keyword = {Technological innovation;Thermal factors;Prototypes;Virtual reality;Very large scale integration;User interfaces;Real-time systems},
 month = {June},
 number = {},
 pages = {1-2},
 title = {A prototype 5nm custom sensor SoC for Augmented Reality/Virtual Reality targeting Smartglasses with embedded computer vision, audio, security and ML},
 volume = {},
 year = {2023}
}
