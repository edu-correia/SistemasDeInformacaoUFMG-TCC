@conference{Esmet2012,
 abstract = {The TokuFS file system outperforms write-optimized file systems by an order of magnitude on microdata write workloads, and outperforms read-optimized file systems by an order of magnitude on read workloads. Microdata write workloads include creating and destroying many small files, performing small unaligned writes within large files, and updating metadata. TokuFS is implemented using Fractal Tree indexes, which are primarily used in databases. TokuFS employs block-level compression to reduce its disk usage. © 2012 USENIX Association. All rights reserved.},
 author = {Esmet, John and Bender, Michael A. and Farach-Colton, Martin and Kuszmaul, Bradley C.},
 journal = {4th USENIX Workshop on Hot Topics in Storage and File Systems, HotStorage 2012},
 note = {Cited by: 56},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {The tokuFS streaming file system},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85084163422?origin=resultslist},
 year = {2012}
}
