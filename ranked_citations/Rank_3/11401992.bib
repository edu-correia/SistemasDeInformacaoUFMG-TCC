@inproceedings{11401992,
 abstract = {Micro-credit approval is an important part of financial big data applications. Unlike large-scale commercial loans, micro-credit documents combine structured data with lengthy unstructured narratives, while diverse applicant businesses create highly imbalanced topic distributions. Existing methods focus on structured or uniformly distributed data, making them unsuitable for micro-credit scenarios. We propose an Incremental Learning Approach (ILA) integrating topic merging and incremental target training algorithms. The topic merging algorithm employs coreset clustering to extract distribution-aware topic words for organizing text features. The incremental training algorithm enables progressive learning from document approvals according to their difficulty levels, enhancing prediction robustness. Experiments show ILA achieves $\mathbf{9 3. 5 \%}$ accuracy, $\mathbf{2. 3 \%}$ higher than the best model, validating its effectiveness.},
 author = {Hao, Shiyang and Liu, Yi and Yang, Hanyu and Liu, Junjie and Yin, Jianfei},
 booktitle = {2025 IEEE International Conference on Big Data (BigData)},
 doi = {10.1109/BigData66926.2025.11401992},
 issn = {2573-2978},
 keyword = {Training;Incremental learning;Accuracy;Merging;Clustering algorithms;Transformer cores;Prediction algorithms;Feature extraction;Transformers;Robustness;micro-credit approval;large language model;coreset;transformer;incremental learning},
 month = {Dec},
 number = {},
 pages = {2156-2161},
 title = {An Incremental Learning Approach for Micro-Credit Approval},
 volume = {},
 year = {2025}
}
