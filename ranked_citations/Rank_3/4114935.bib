@inproceedings{4114935,
 abstract = {Trajectory methods offer an attractive methodology for automated extraction of macromodels from a set of training simulations. A pervasive concern with models based on regression is the lack of certainty about where they fit correctly. The authors show how the unique structure of a scalable trajectory model allows it to monitor the "fidelity" of the fit automatically, and flag where additional model training is warranted. Experimental results demonstrate this self-monitoring ability in practical circuit examples},
 author = {Tiwary, Saurabh K and Rutenbar, Rob A},
 booktitle = {IEEE Custom Integrated Circuits Conference 2006},
 doi = {10.1109/CICC.2006.320884},
 issn = {2152-3630},
 keyword = {Circuit simulation;State-space methods;Interpolation;Merging;SPICE;USA Councils;Differential equations;Nonlinear equations;Scalability;Analog circuits},
 month = {Sep.},
 number = {},
 pages = {185-188},
 title = {On-the-Fly Fidelity Assessment for Trajectory-Based Circuit Macromodels},
 volume = {},
 year = {2006}
}
