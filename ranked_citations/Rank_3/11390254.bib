 abstract = {An intensified integration of intermittent renewables and time-sensitive loads compels power systems to adopt stochastic stability forecasts that harmonise operational integrity and the economic sustainment of legacy transmission grids. Existing forecasting paradigms, notwithstanding their theoretical soundness, exhibit persistent deficiencies: they frequently mischaracterise abrupt-controlled-device ramps, inadequately condense extraneous feature dimensions, and fail to produce almost real-time analytical guidance as data streams interrogate structural changes. The present contribution articulates a Probabilistic Spiking Neural Network, fine-tuned via the Black-Winged Kite Algorithm (PSNN-BKA), that multiplies forecasting agility whilst tightening uncertainty bandwidth. Standard UCI benchmark datasets are channelled through an ordered preprocessing workflow. Fast Correlation-Based Normalisation Filters (FCNF) prune superfluous dimensions. In tandem, pluralitybalanced bootstrap samplings attenuate the overfitting risk inherently implicatory of these curated subsets. Feature relevance attains additional verification via a Multi-View Fuzzy Clustering linked to an Anchor Graph (MVFCAG), which synthesises multi-feature correlation visualisation while permitting the extraction of hyperevident influential triads. Spiking time encodings, restrained to binary impulses and inter-spike intervals, transport dynamic events through a temporal contour. Parallelly, the Black-Winged Kite Algorithm concentrates stochastic excursions around the palaeocycle incumbents exhibiting the strongest posterior expected gain, thereby accelerating convergence and effecting tighter hyperparameter coatings. When merged with edgecomputing Internet-of-Things sensors, the proposed architecture furnishes continuous, real-time observability, executes autonomous anomaly detection that eliminates the delays of human intervention, and effectively secures traditional SCADA systems against false-data and measurement-inertia threats. Experimental trials, using a large observational dataset, demonstrate that the model outperforms established benchmark systems published in the current literature. Key performance indicators indicate a sustained accuracy that resides well above operationally critical thresholds, precision values are consistently elevated, recall metrics disclose a concordance of 99.85% with externally validated stability regimes, and the derived F1 score is 99.82%. Collectively, these metrics substantiate the architecture's capacity to project the stability of the smart grid in operational time with a marginal false-alarm rate bordering zero and no undetected stability violations.},
 author = {Manchana, RamaKrishna and Swaleh, Mohd Abu and K., Vasumathi A. and Vekariya, Vipul and L, Natrayan and SivaramKrishnan, M.},
