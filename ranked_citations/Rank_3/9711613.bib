@inproceedings{9711613,
 abstract = {Arabic Sign Language (ArSL) is a language of communication between deaf & dumb people in Arab countries. This study focuses on establishing a real-time speech conversion service into ArSL by 3D animation videos, to facilitate the learning process in virtual educational platforms. This study to help the deaf & dumb students in distant learning under the Covid-19 pandemic. This study applied on the TEAMS platform. A database was created containing more than 550 ArSL videos from the Al-tarjuman application and connected it with the TEAMS platform. A Python was used to link the System units. After studying some related works that were concerned with the language of the deaf & dumb, we found that some studies do not support real-time translation, has lack Arabic sign language translation, has limited DB, resulting in a low level of system performance, and use of high-cost devices such as gesture motion sensors “Kinect and Leap Motion”. As future work, we will increase the words in the DB to improve the results. We advise researchers to contribute by working on merging the videos retrieved from the DB to make an integrated serial video. Also, adding a syntactic analysis stage to extract the sentence structure.},
 author = {Alqahtani, Amani and Alfahhad, Amjad and Alotaibi, Nouf and Alqahtani, Bashaier and Alamri, Lama and Aldahasi, Ezaz and Moursy, Hanna},
 booktitle = {2022 2nd International Conference on Computing and Information Technology (ICCIT)},
 doi = {10.1109/ICCIT52419.2022.9711613},
 issn = {},
 keyword = {COVID-19;Three-dimensional displays;Pandemics;System performance;Gesture recognition;Assistive technologies;Syntactics;Dumb & Deaf;Educational platforms;Arabic Sign Language (ArSL);Speech to Sign language;Animation;E-learning;3D-animation;Real-Time;Video;System;Python},
 month = {Jan},
 number = {},
 pages = {191-196},
 title = {Improving the Virtual Educational Platforms for the Deaf and Dumb under the Covid-19 Pandemic Circumstances},
 volume = {},
