@inproceedings{8874819,
 abstract = {This letter presents a wide-tuning-range voltage-controlled oscillator (VCO) implemented by a standard 0.18-μm CMOS process. The negative-resistance part of the VCO consisting of a NMOS and a PMOS transistor forms a current-reuse topology, and the resonator-switching topology is also adopted to achieve wide-tuning range. Operating at 1.2-V supply voltage, the power consumption of the VCO is 3.54 mW. The resulting phase noise in the low-frequency band is -110.9 dBc/Hz at 1-MHz offset from the 4.05-GHz oscillation frequency, and that in the high-frequency band is estimated as -100.4 dBc/Hz at 5.66-GHz. Finally, a 3.3~5.7-GHz VCO can be obtained by merging the dual bands and the figure of merit with tuning rang (FOMT) is - 192.9 dBc/Hz.},
 author = {Huang, Jui-Chi and Hsu, Keng-Chi and Wang, Sen},
 booktitle = {2019 European Microwave Conference in Central Europe (EuMCE)},
 doi = {},
 issn = {},
 keyword = {Voltage-controlled oscillators;Phase noise;Tuning;Frequency measurement;MOSFET;Switching circuits;VCO;CMOS;wide-tuning-range;current-reuse;resonator-switching},
 month = {May},
 number = {},
 pages = {354-357},
 title = {A Wide-Tuning-Range CMOS VCO Using Current-Reuse and Resonator-Switching Techniques},
 volume = {},
 year = {2019}
}
