@article{Deng2015226,
 abstract = {Cloud computing can realize resources unified scheduling, integrate resources and platforms, speed up the development of value-added products and application’s cycle, reduce costs, and improve business agility by using technology of virtualization. Telecom operators need to virtualize their data centers and build cloud infrastructure for better using resources. So they should move data centers from physical machines to virtual machines for implementing the virtualization. But there are some risks such as the loss of computing ability, performance decline and so on. In this paper, we do a series of experiments to test performance of rational databases and Hadoop in physical machines and virtual machines. We also explore the difference between rational databases and Hadoop when we meet different amounts of data sets. Through these experiments, we find that disk I/O performance of rational database and Hadoop deployed in physical machines is better than that in virtual machines. We also find that Hadoop will have a better performance than rational databases when the data size reaches GB level. © Springer International Publishing Switzerland 2015.},
 author = {Deng, Jiangdong and Haihong, E. and Chang, Qian and Shu, Qin and Yang, Jun and Jiang, Haiou},
 doi = {10.1007/978-3-319-15554-8_19},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {226 - 238},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on Performance Comparison of Data Center Between PM and VM},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84924348334?origin=resultslist},
 volume = {8944},
 year = {2015}
}
