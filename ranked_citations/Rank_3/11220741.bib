@inproceedings{11220741,
 abstract = {This paper belongs to the authors’ research cycle in the sphere of process-based management. We investigate how the companies’ process maps change in case of their consolidation. Different types of consolidation are considered in the paper. Each type is analyzed from the standpoint of required transformations that must be applied to the process models at the consolidated companies’ level when their united management system is being organized. The models’ transformations and their following coordination are piloted and tested for an abstract example of an industrial vertically integrated enterprise.},
 author = {Nekrasov, Ivan and Bushina, Kseniya and Krasnikova, Svetlana},
