@inproceedings{5298630,
 abstract = {Space-based computing environments are based around numerous, discrete sets of information with internal reasoning, interaction and semantics. These spaces of information can be treated as first-class entities and thus have direct interactions between themselves as spaces. We develop and formalise a simple set of base operations between individual spaces that preserves the integrity of the information contained within those spaces through larger grained semantic structures (eg: RDF molecules) and historical information about past interactions. We then show how this forms the basis of extended and possible-world queries and how such features are manifested in common scenarios.},
 author = {Oliver, Ian and Boldyrev, Sergey},
 booktitle = {2009 IEEE International Conference on Semantic Computing},
 doi = {10.1109/ICSC.2009.102},
 issn = {},
 keyword = {Resource description framework;Semantic Web;History;Information management;Internet;Application software;Calendars;Social network services;Tree graphs;Privacy;space-based computing;agents;semantic web},
 month = {Sep.},
 number = {},
 pages = {267-274},
 title = {Operations on Spaces of Information},
 volume = {},
 year = {2009}
}
