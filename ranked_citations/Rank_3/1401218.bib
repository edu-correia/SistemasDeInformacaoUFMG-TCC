@inproceedings{1401218,
 abstract = {Product design is characterized as its creativity in the whole process of developing. A robust product scheme should bring all the important competitive advantage including some image aspects such as cooperation culture and other social aspects. Therefore, a synthesis method integrating with visual thinking factors should be introduced to overcome this problem in design for manufacture. In fact, the visual thinking factors can be regarded as the high level representation of expressing the form of artifact, just like we often use metaphor and imagery to describe something. Using the viewpoint of visual thinking within a product development project, some external elements can be added to and merged in a marked constraint for design for manufacture efficiently. By means of this method, This work shows that design for manufacture can achieve its creativity at least in two aspects. The first one is helpful to form morphological character of product in manufacturing and this can emphasize product family and platform. The second one is to introduce social and culture factors so that product is adapt to subdivision market and interesting with its unique style.},
 author = {Wang, Z. and He, W.P. and Zhang, D.H.},
 booktitle = {2004 IEEE International Conference on Systems, Man and Cybernetics (IEEE Cat. No.04CH37583)},
 doi = {10.1109/ICSMC.2004.1401218},
 issn = {1062-922X},
 keyword = {Product design;Manufacturing processes;Design engineering;Design for manufacture;Space exploration;Pulp manufacturing;Humans;Computer aided manufacturing;Consumer electronics;Robustness},
 month = {Oct},
 number = {},
 pages = {4365-4370 vol.5},
 title = {Research and application of visual thinking in design for manufacture},
 volume = {5},
 year = {2004}
}
