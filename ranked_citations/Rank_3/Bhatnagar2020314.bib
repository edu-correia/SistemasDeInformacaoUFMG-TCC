@conference{Bhatnagar2020314,
 abstract = {The paper presents an efficient first in first out (FIFO) buffer for use in network on chip routers for efficient management of data flow. Further we have designed a heterogeneous router using the efficient FIFO buffer, in which each channel can have a different buffer size. Even the FIFO of a particular channel is full it can borrow more buffer length from neighbouring channels. In this new architecture read and write operations are managed by the FIFO and channel itself, thus reducing the circuitry and making it a high speed router. © 2020 IEEE.},
 author = {Bhatnagar, Vipul and Kumar, Saket and Pandey, Manoj Kumar and Pandey, Sujata},
 doi = {10.1109/SMART50582.2020.9337128},
 journal = {Proceedings of the 2020 9th International Conference on System Modeling and Advancement in Research Trends, SMART 2020},
 note = {Cited by: 1},
 pages = {314 - 317},
 publication_stage = {Final},
 source = {Scopus},
 title = {Design and implementation of an efficient buffer management system for network on chip routers},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85101094601?origin=resultslist},
 year = {2020}
}
