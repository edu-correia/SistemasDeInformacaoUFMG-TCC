@article{11184464,
 abstract = {This communication presents an ultrawideband (UWB) metal–dielectric additively manufactured planar Vivaldi-shaped antenna array for millimeter-wave (mm-Wave) applications. Different from conventional endfire Vivaldi antennas, the proposed design leverages a novel metal–dielectric synergistic additive-manufacturing process in which the exponential-tapered radiation part is deposited layer-by-layer with the dielectric. This integration not only planarizes the antenna while delivering low-profile UWB broadside radiation performance but also lends itself to expansion into a high-gain array. Meanwhile, the feeding network is implemented on a separate PCB substrate and integrated with the additively manufactured Vivaldi-shaped radiation part through the coupling slots, ensuring high radiation efficiency. To validate this design, a  $4\times 4$  antenna prototype with only a size of  $2\times 1.72\times 0.11\lambda _{low}^{3}$  was fabricated and measured. The measured results demonstrate a −10-dB impedance bandwidth (IMBW) exceeding 100% (15.5–50 GHz), which spans the entire K and Ka bands and realizes a peak gain of 17 dBi. By merging traditional PCB processes with advanced additive-manufacturing techniques, this design achieves a customized layout and superior performance, which establishes a novel path for next-generation high-performance mm-Wave applications.},
 author = {Sun, Zhichao and Lai, Jiexin and Lv, Xiaojing and Oni, Md. Ashif Islam and Dey, Shuvashis and Yang, Yang},
 doi = {10.1109/TAP.2025.3613533},
 issn = {1558-2221},
 journal = {IEEE Transactions on Antennas and Propagation},
 keyword = {Antenna arrays;Gain;Antennas;Substrates;Ultra wideband antennas;Horn antennas;Couplings;Aperture antennas;Antenna radiation patterns;Antenna measurements;Additive manufacturing;antenna array;low profile;millimeter wave (mm-Wave);ultrawideband (UWB)},
 month = {Jan},
 number = {1},
 pages = {1055-1060},
 title = {Ultrawideband Low-Profile Metal–Dielectric Additively Manufactured Planar Vivaldi-Shaped Antenna Array for Millimeter-Wave Applications},
 volume = {74},
 year = {2026}
}
