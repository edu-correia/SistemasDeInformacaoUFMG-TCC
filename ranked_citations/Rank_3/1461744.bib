@inproceedings{1461744,
 abstract = {This paper proposes extended peer-to-peer (P2P) protocol based on IPv6. There are a lot of works on structured P2P protocols using distributed hash table (DHT). Especially, our P2P algorithm and implementation are focused on the efficiency and the scalability for maintaining the P2P overlay network. To achieve efficient routing, we merge the P2P overlay with the messenger service. With friend nodes as finger, a query can routed through more efficient path on the P2P overlay network. We implemented extended P2P protocol for messenger and multimedia services (MMP2P) on Microsoft Windows environment and evaluated the performance of our proposal},
 author = {Minji Nam and Kunwoo Park and Hosik Cho and Taekyoung Kwon and Yanghee Choi and Taewan You and Seungyun Lee},
 booktitle = {The 7th International Conference on Advanced Communication Technology, 2005, ICACT 2005.},
 doi = {10.1109/ICACT.2005.246016},
 issn = {},
 keyword = {Peer to peer computing;Protocols;Internet;Computer science;Scalability;Routing;Proposals;IP networks;Computer languages;Multimedia systems},
 month = {Feb},
 number = {},
 pages = {96-99},
 title = {Extended peer-to-peer protocol based on IPv6},
 volume = {1},
 year = {2005}
}
