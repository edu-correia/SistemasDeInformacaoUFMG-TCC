@inproceedings{11016597,
 abstract = {Numerous educators have emphasised the wideranging benefits of studio-based learning (SBL) within the context of engineering education, while others have praised the positive aspects of digitally enhanced, flipped learning methodologies. In this research, we investigate an innovative approach to teaching a technical engineering materials course that effectively combines these two pedagogical strategies. By incorporating both a flipped classroom model and a studiobased learning environment, our objective was to cultivate a more engaging, interactive, and effective educational experience for students. To assess the impact and overall effectiveness of this learning format, we meticulously analysed students' survey responses, academic engagement, and their perceptions regarding the newly structured course. Our findings revealed a pronounced preference among students for this new format in comparison to the traditional lecture-based approach. This strong preference was clearly indicated in their survey responses and was also evident in their high levels of engagement. The newly established learning environment fostered a significantly stronger sense of community and collaboration among the students. Participants reported feeling more connected to and supported by their peers, and contributed to creating a more productive, less distracted and more focused atmosphere within the studio. An indication of a significantly enhanced focus, as also seen from the perceptions reported by students, seemed to enable them to engage more deeply with the course material and collaborate effectively on various projects in the studios, thereby reinforcing the advantages inherent in the combined methodologies of SBL and flipped learning. In summary, our study demonstrates that reimagining engineering education through the integration of a combined studio-based learning and flipped classroom techniques can yield significant improvements in student engagement and academic success. By prioritising supportive, collaborative and hands-on learning experiences, educators can better equip students for the multifaceted challenges of the engineering profession, providing them with essential skills and a mindset necessary to thrive in an ever-evolving field. This innovative approach not only meets the diverse needs of today's learners but also provides valuable insights that can inform future developments in engineering education.},
 author = {Kakoun, Nathalie Al and Ali, Fatima El and Harb, Mohammad},
 booktitle = {2025 IEEE Global Engineering Education Conference (EDUCON)},
 doi = {10.1109/EDUCON62633.2025.11016597},
 issn = {2165-9567},
 keyword = {Surveys;Analytical models;Electronic learning;Engineering profession;Merging;Active learning;Collaboration;Atmosphere;Online services;Engineering education;Active Learning;Studio-Based Learning;Flipped Learning;Digitally Enhanced Learning;Engineering Education;Engineering Materials},
 month = {April},
 number = {},
 pages = {1-9},
 title = {Merging Studio-Based Learning With Flipped Classroom Techniques: Ensuring Support and Focus in Engineering Education},
 volume = {},
 year = {2025}
}
