@inproceedings{9575421,
 abstract = {The volume-averaged global plasma model has been widely used to obtain spatially averaged plasma parameters on geometry or process parameters such as applied power, pressure, and gas flow. The characteristics of the plasma are determined by the particle and power balance within the discharge with assuming that all plasma parameters are to be volume averaged. Due to neglected spatial variations, the global model encompasses a large number of reactions in order to model high density plasmas with limited computing power. Therefore, we developed the volume-averaged global plasma simulator (VAGPS) using the free libraries to solve the governing equations and to develop the user interface. Source codes are free to use, copy, modify, merge, publish and distribution except for commercial purposes.},
 author = {Kwon, Deuk-Chul and Park, Jun-Hyung and Song, Mi-Young and Yu, Dong-Hun},
 booktitle = {2018 IEEE International Conference on Plasma Science (ICOPS)},
 doi = {10.1109/ICOPS35962.2018.9575421},
 issn = {2576-7208},
 keyword = {Geometry;Computational modeling;Conferences;Fluid flow;User interfaces;Low-temperature plasmas;Mathematical models},
 month = {June},
 number = {},
 pages = {1-1},
 title = {VAGPS: Volume-Averaged Global Plasma Simulator for Low Temperature Plasma Sources},
 volume = {},
 year = {2018}
}
