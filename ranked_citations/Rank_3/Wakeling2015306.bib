@article{Wakeling2015306,
 abstract = {The evaluation of information access systems is increasingly making use of multiple evaluation methods. While such studies represent forms of mixed-methods research, they are rarely acknowledged as such. This means that researchers are potentially failing to recognise the challenges and opportunities offered by multi-phase research, particularly in terms of data integration. This paper provides a brief case study of how one framework - Bazely & Kemp’s metaphors for integrated analysis - was employed to formalise data integration for a large exploratory evaluation study. © Springer International Publishing Switzerland 2015.},
 author = {Wakeling, Simon and Clough, Paul},
 doi = {10.1007/978-3-319-24027-5_33},
 journal = {Lecture Notes in Computer Science},
 note = {Cited by: 4},
 pages = {306 - 311},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integrating mixed-methods for evaluating information access systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84945916364?origin=resultslist},
 volume = {9283},
 year = {2015}
}
