@conference{Sudrajat2023175,
 abstract = {The decision-making of a dynamic business requires information, and the solution is to build business intelligence. Data integration is an important component of business intelligence. The purpose of this paper is to present a systematic literature review for the expansion of ETL and ELT data integration approach models influenced by the issue of big data characteristics in building business intelligence. To achieve this goal, several questions have been asked including: (i) How many journals discuss Data Integration, both for ETL and ELT approach models? (ii) How many journals discuss the expansion of data integration (iii) What models are extensions of ETL and ELT approach models based on Big Data issues? (iv) What are the challenges in developing data integration? The paper review process is carried out for papers published from 2015 to 2023. The expansion of the data integration approach model needs to be done to overcome the previous problems. Information on the data integration approach model is important for other researchers so that they can make improvements and extensions that are tailored to conditions and needs. This SLR provides an overview for future researchers when expanding the model or using the data integration model. In the next research, researchers will discuss the problems that arise in the data integration process. © 2023 IEEE.},
 author = {Sudrajat, Antonius Wahyu and Ermatita and Samsuryadi},
 doi = {10.1109/EECSI59885.2023.10295685},
 journal = {International Conference on Electrical Engineering, Computer Science and Informatics (EECSI)},
 note = {Cited by: 0},
 pages = {175 - 182},
 publication_stage = {Final},
 source = {Scopus},
 title = {Extending The Data Integration Model As The Foundation Of Business Intelligence: A Systematic Literature Review},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85178058751?origin=resultslist},
 year = {2023}
}
