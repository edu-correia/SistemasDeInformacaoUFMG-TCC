@inproceedings{6138183,
 abstract = {This paper presents the current status and caveat of the Thai FrameNet project. Through four modules, a combination approach: the expand and the merge, is implemented. The alignment of the original FrameNet is made by way of the former whilst the latter manifests the indigenous Thai conceptual scenarios. Currently, 1,339 frames, 22,708 lexical units, and 2,333 annotated sentences are obtained as a result. Frames are organised in the Thai FrameNet database and connected by seven frame-to-frame relations.},
 author = {Leenoi, Dhanon and Jumpathong, Sawittree and Supnithi, Thepchai},
 booktitle = {2011 7th International Conference on Natural Language Processing and Knowledge Engineering},
 doi = {10.1109/NLPKE.2011.6138183},
 issn = {},
 keyword = {Manuals;Manganese;Visualization;Thai FrameNet;Frame Semantics;Combination Approach},
 month = {Nov},
 number = {},
 pages = {146-149},
 title = {Manifesting Thai conceptual scenarios through Thai FrameNet},
 volume = {},
 year = {2011}
}
