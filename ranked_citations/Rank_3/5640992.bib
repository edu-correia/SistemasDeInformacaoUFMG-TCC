@inproceedings{5640992,
 abstract = {This article presents algorithms for the optimization of radio resources and proposes an optimization model that can be implemented in dynamic mobile networks based on RoF. The algorithms are based on linear relaxation technique for integer linear programming (ILP) problems. The formulation models a multi-tier structure of antennas with increasing radius. Considering this antenna structure the optimizer performs dynamic cell merging and cell splitting in the coverage area for saving resources and yet improving network availability. Both the integer and the relaxation formulations showed similar results for all the experiments, but the time of processing required by the relaxation algorithms was much shorter than that required by the integer algorithm for large instances of the problem, which highlights the advantages of relaxation techniques under time constraints.},
 author = {Henrique Gomes, Pedro and da Fonseca, Nelson L. S. and Branquinho, Omar C.},
 booktitle = {2010 IEEE Latin-American Conference on Communications},
 doi = {10.1109/LATINCOM.2010.5640992},
 issn = {2330-989X},
 keyword = {Computer architecture;Microprocessors;Linear programming;Optimization;Resource management;Mobile communication;Approximation algorithms;Radio-over-fiber;Radio Resource Management;Optimization;IP Relaxation Algorithms;Mobile Networks},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Fast algorithms for resource allocation in Radio-over-fiber access networks},
 volume = {},
 year = {2010}
}
