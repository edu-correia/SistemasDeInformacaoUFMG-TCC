@inproceedings{9699986,
 abstract = {When the existing evaluation methods evaluate the presentation effect of immersion drama stage, due to the incomplete data in the evaluation, there is a large error between the effect evaluation and the actual evaluation results. Therefore, an evaluation method of immersive drama stage presentation effect based on data mining is designed. Clean the data with incomplete, inconsistent and noisy presentation effect on the immersive drama stage, and merge the cleaning results into a unified data set. Regression technology is used to fill in the missing data through data conversion, reduction and other methods. The multi-dimensional spatial covariance matrix is used to compress the data to determine the evaluation factor set. When the stage presentation mode is unified with the mining goal, the evaluation factor set needs to be re selected to determine the effect evaluation level. From the practical content of effect evaluation, it can be seen that the error between this method and the actual evaluation is small, and it has accurate evaluation effect.},
 author = {Sun, Zhongxuan},
 booktitle = {2021 IEEE International Conference on Industrial Application of Artificial Intelligence (IAAI)},
 doi = {10.1109/IAAI54625.2021.9699986},
 issn = {},
 keyword = {Data conversion;Conferences;Cleaning;Data mining;Noise measurement;Covariance matrices;Artificial intelligence;Data mining;Immersive;Theatrical stage;Presentation effect;Regression technique},
 month = {Dec},
 number = {},
 pages = {21-26},
 title = {Evaluation Method of Immersive Drama Stage Presentation Effect Based on Data Mining},
 volume = {},
 year = {2021}
}
