@article{Carvalho20101365,
 abstract = {This paper presents an algorithm to segment synthetic aperture radar (SAR) images, corrupted by speckle noise. Most standard segmentation techniques may require speckle filtering previously. Our approach performs radar image segmentation using the original noisy pixels as input data, i.e. without any preprocessing step. The algorithm includes a statistical region growing procedure combined with hierarchical region merging. The region growing step oversegments the input radar image, thus enabling region aggregation by employing a combination of the Kolmogorov-Smirnov (KS) test with a hierarchical stepwise optimization (HSWO) algorithm for performance improvement. We have tested and assessed the proposed technique on artificially speckled image and real SAR data. © 2009 Elsevier Inc. All rights reserved.},
 author = {Carvalho, E.A. and Ushizima, D.M. and Medeiros, F.N.S. and Martins, C.I.O. and Marques, R.C.P. and Oliveira, I.N.S.},
 doi = {10.1016/j.dsp.2009.10.014},
 journal = {Digital Signal Processing: A Review Journal},
 note = {Cited by: 57},
 number = {5},
 pages = {1365 - 1378},
 publication_stage = {Final},
 source = {Scopus},
 title = {SAR imagery segmentation by statistical region growing and hierarchical merging},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/80054946151?origin=resultslist},
 volume = {20},
 year = {2010}
}
