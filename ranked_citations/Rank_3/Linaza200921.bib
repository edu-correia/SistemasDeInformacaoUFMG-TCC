@conference{Linaza200921,
 abstract = {Ontology mapping is required to combine heterogeneous ontologies. Developing such ontology mapping has been a core issue of recent ontology research. This paper presents the mapping of several standard domain ontologies in order to implement the CINeSPACE integrated ontology. Four source ontologies have been selected and the set of overlapping concepts that are similar in meaning has been determined. © 2009 IEEE.},
 author = {Linaza, Maria Teresa and Sarasua, Cristina and Cobos, Yolanda and Bermudez, Jesús and Illarramendi, Arantza},
 doi = {10.1109/SMAP.2009.12},
 journal = {SMAP '09 - 4th International Workshop on Semantic Media Adaptation and Personalization},
 note = {Cited by: 0},
