@inproceedings{11344541,
 abstract = {As a platform for internet users to share information and obtain advice, new media is widely used by various demographics. Various commentaries emerge in the cultural dissemination of new media, originating from different societal facets. Analyzing the wealth of information contained within these texts holds practical significance for information prediction, public opinion monitoring, and user decision-making. This paper employs comment texts from new media cultural dissemination as data support and utilizes deep learning based on textual semantic understanding for sentiment analysis. Addressing the task of sentence-level sentiment analysis, this paper proposes a hybrid neural network sentiment analysis model that integrates character and word features. Chinese language's sequential structure is more complex compared to English, lacking obvious delimiters for word segmentation within sentences. This leads to loose standards in segmentation models, and traditional encoding models based on word division may lose some internal semantic information within words. To address this issue, this paper proposes a method of fusing character-level and wordlevel features for feature extraction. Firstly, sentences are divided into two levels of encoding, utilizing BiGRU structure to extract features containing contextual information from character sequences. Attention mechanism is introduced to focus on important aspects of character sequences, while CNN structure is employed to extract local feature relationships between words, using convolutional kernels of different sizes to obtain local features at varying distances. Finally, the features are merged to obtain global feature information.},
 author = {Lin, Zhenhua},
 booktitle = {2024 6th International Conference on Applied Machine Learning (ICAML)},
 doi = {10.1109/ICAML64299.2024.00029},
 issn = {},
 keyword = {Deep learning;Sentiment analysis;Attention mechanisms;Semantics;Media;Feature extraction;Encoding;Cultural differences;Global communication;Data mining;Semantic Understanding;Deep Learning;Sentiment Analysis;Feature Fusion},
 month = {July},
