@incollection{MANTEL202185,
 abstract = {This chapter presents a structured overview of the relationship between the visual, auditory, touch, taste and smell systems and human emotions. A detailed description of these main sensory systems if first presented, followed by the early development of these relationships between senses and emotions, and the way these sensory channels merged through integrative processes, using bottom-up and top-down strategies. A last section highlights the importance of inter-individual variability in affective responses and their implication for the exploration of the sensory motor aspects of emotion. Altogether, these scientific developments lead us to argue that current research in this area may strongly benefit from accounting for these latter factors of variation, whether they are at the individual or the experimenter level.},
 author = {Marylou Mantel and Catherine Rouby and Arnaud Fournel and Moustafa Bensafi},
 booktitle = {Emotion Measurement (Second Edition)},
 doi = {https://doi.org/10.1016/B978-0-12-821124-3.00003-X},
 edition = {Second Edition},
 editor = {Herbert L. Meiselman},
 isbn = {978-0-12-821125-0},
 keyword = {Human emotions, Senses, Variability, Touch, Vision, Audition, Taste, Smell},
 pages = {85-110},
 publisher = {Woodhead Publishing},
 title = {Chapter 3 - Senses and emotion: a complex relationship},
 url = {https://www.sciencedirect.com/science/article/pii/B978012821124300003X},
 year = {2021}
}
