@article{Mair201597,
 abstract = {This paper examines current trends in commercially available products and research related to telepresence and teleoperation systems. It also compares them with some aspects of speculative fiction directly related to these systems and their human interface. The presentation of the results in the form of a parallel timeline highlights the research gaps that remain to be filled in order to obtain the ideal telepresence system in which the technological mediation becomes as transparent as in fictional representations. © Springer International Publishing Switzerland 2015.},
 author = {Mair, Gordon M.},
 doi = {10.1007/978-3-319-21067-4_12},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {97 - 107},
