@inproceedings{8324960,
 abstract = {A compact microstrip patch with half mode substrate integrated waveguide (HMSIW) hexagonal cavity for WLAN applications has been designed. The offered antenna comprises of a hexagonal resonator cavity based on HMSIW for reducing antenna size to excite a square microstrip patch. An inset microstrip line is used to excite hexagonal cavity which leads to capability of planar circuit integration. By merging two resonant frequencies of hexagonal HMSIW cavity and square patch, a high efficiency is achieved. To enhance antenna performances, especially gain characteristics, a rectangular cube dielectric resonator (DR) have been employed as radiating element.},
 author = {Valizade, A. and Nourinia, J. and Ghobadi, Ch. and Mohammadi, B.},
 booktitle = {2017 IEEE 4th International Conference on Knowledge-Based Engineering and Innovation (KBEI)},
 doi = {10.1109/KBEI.2017.8324960},
 issn = {},
 keyword = {Cavity resonators;Microstrip antennas;Microstrip;Substrates;Resonant frequency;Antenna radiation patterns;Dielectric resonator antenna (DRA);half mode substrate integrated waveguide (HMSIW);hexagonal cavity;microstrip patch antenna;substrate integrated waveguide (SIW)},
 month = {Dec},
 number = {},
 pages = {0139-0142},
 title = {Compact HMSIW hexagonal cavity patch antenna},
 volume = {},
 year = {2017}
}
