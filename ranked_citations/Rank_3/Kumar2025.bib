@conference{Kumar2025,
 abstract = {Most of the global economy consists of small and medium-sized enterprise (SMEs), which are not able to migrate to the cloud due to their lack of concrete cloud-security solutions. This huge disconnection between people and processes is what makes us require a sustainable security framework that will discuss in this review. The current systematic literature review outlines four key themes-Zero Trust Architecture (ZTA), Governance Risk and Compliance (GRC), the merge of artificial intelligence and machine learning (AI/ML), and disaster recovery sustainability. All these identified themes are the foundation of the creation of security frameworks that are flexible to the context of SMEs. The synthesis provided below is based on academic articles and reports that were published between 2023 and 2025, but also includes the background standards, including those issued by NIST and ISO, in order to offer consistent definitions irrespective of the date of publication. By combining these new frameworks, the research sheds some light on the gaps in research that should be filled by other researchers. Finally, the review suggests a research agenda in the future that includes cross-regional comparative studies, integration of qualitative knowledge, and longitudinal studies on the resilience, thus providing organisations with a strategic roadmap to flexible and resilient security architectures. © 2025 IEEE.},
 author = {Kumar, Shivam and Singh, Prabhdeep and Singh, Amardeep},
 doi = {10.1109/ISCS69371.2025.11386151},
 journal = {2nd International Conference on Intelligent Systems for Cybersecurity, ISCS 2025},
 note = {Cited by: 0},
