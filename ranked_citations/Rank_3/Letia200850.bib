@article{Letia200850,
 abstract = {The problem of ontology mapping is tackled in the context of MAS and real life ontologies, context that requires an increased degree of dynamism and the ability to handle high amounts of data. Our solution follows the guidelines of lazy mapping, striving to map only what is necessary and only when it is necessary by using lexical based mapping methods combined with proxy ontologies. However, we are not omitting from this endeavor the accuracy of mapping since our two- layer process has FCA as the second mapping step.},
 author = {Letia, Ioan Alfred and Costin, Mihai},
 doi = {10.4316/aece.2008.01009},
 journal = {Advances in Electrical and Computer Engineering},
 note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access},
 number = {1},
 pages = {50 - 55},
 publication_stage = {Final},
 source = {Scopus},
 title = {Onto-SimFCA: A two-step mapping method for ontologies in MAS},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/77955616627?origin=resultslist},
 volume = {8},
 year = {2008}
}
