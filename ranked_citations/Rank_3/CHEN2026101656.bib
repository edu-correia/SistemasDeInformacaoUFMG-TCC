@article{CHEN2026101656,
 abstract = {As a promising platform for chemical manufacturing, photoelectrocatalytic organic synthesis has recently attracted much attention. Benefitting from the integration of both electricity and light, photoelectrochemical (PEC) cross-coupling can be conducted under mild conditions while retaining excellent efficiency and broad substrate scope. This commentary highlights the recent advancement of PEC organic synthesis into the realm of cross-coupling reactions for constructing challenging C–X and C–C bonds. Strategies for enhancing this platform—including integration with transition-metal catalysis and surface modification of photoelectrodes to improve activity, stability, and reaction specificity—are also explored. Despite promising progress, PEC organic synthesis remains in early development and faces many challenges. Future prospects are outlined with an emphasis on the critical need to develop photoelectrochemical asymmetric synthesis, integrate a broader range of metal catalysts, and design advanced photoelectrode materials to unlock new reactivities and enhance performance.},
 author = {Ya-Jing Chen and Fang Guo and Caoyu Yang and Zhiyong Tang and Jinghao Wang},
 doi = {https://doi.org/10.1016/j.checat.2026.101656},
 issn = {2667-1093},
 journal = {Chem Catalysis},
 number = {3},
 pages = {101656},
 title = {Photoelectrochemical cross-coupling for green organic synthesis},
 url = {https://www.sciencedirect.com/science/article/pii/S2667109326000084},
 volume = {6},
 year = {2026}
}
