@article{Groppe20212695,
 abstract = {Sonifications map data to auditory dimensions and offer a new audible experience to their listeners. We propose a sonification of query processing paired with a corresponding visualization both integrated in a web application. In this demonstration we show that the sonification of different types of relational operators generates different sound patterns, which can be recognized and identified by listeners increasing their understanding of the operators’ functionality and supports easy remembering of requirements like merge joins work on sorted input. Furthermore, new ways of analyzing query processing are possible with the sonification approach. © The authors.},
 author = {Groppe, Sven and Klinckenberg, Rico and Warnke, Benjamin},
 doi = {10.14778/3476311.3476322},
 journal = {Proceedings of the VLDB Endowment},
 note = {Cited by: 5},
 number = {12},
 pages = {2695 - 2698},
 publication_stage = {Final},
 source = {Scopus},
 title = {Sound of databases: Sonification of a semantic web database engine},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85119952568?origin=resultslist},
 volume = {14},
 year = {2021}
}
