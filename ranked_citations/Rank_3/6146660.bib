@inproceedings{6146660,
 abstract = {The work presents how a dual formula generated seed based cryptographic technique (de)ciphers with stochastic initialization of the parameters constituting the seed. In the model formulation of the technique, two distinct formulas are used for creating two arrays of number, followed by XOR and XNOR operations performed on those two arrays in order to produce the crypt arithmetic seed. In the process of generating seeds, certain probability distribution functions are used. The motivation behind this is to establish a deterministic cipher technique independent of initialization of the parameters instrumental in constituting the stochastic seed. After the generation of the key, it is then merged with the encrypted text, which is then divided into blocks of four and checked for prime and non-prime. Based on the blocks being prime or non-prime, the encryption technique continues. During the decryption technique, again the key is generated to match with the cipher text. If the key matches, then the decryption technique continues or else it is discontinued. The proposed methodology can be used in encrypting and decrypting any text, based on ASCII. The proposed technique will be of immense use for encrypting emails, which is of colossal importance in data transfer and network.},
 author = {Chowdhury, Rajdeep and Gupta, Somsubhra and Saha, Arijit},
 booktitle = {2011 International Conference on Communication and Industrial Application},
 doi = {10.1109/ICCIndA.2011.6146660},
 issn = {},
 keyword = {Encryption;Stochastic processes;Probability distribution;Indexes;Conferences;Stochastic Seed;Dual Formula Key [DFK];Key Array;Final Key;Seed Key;Mutation;Encryption;Decryption},
 month = {Dec},
 number = {},
 pages = {1-5},
 title = {Stochastic seed based cryptographic technique [SSCT] using Dual Formula Key [DFK]},
 volume = {},
 year = {2011}
}
