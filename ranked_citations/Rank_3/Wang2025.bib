@conference{Wang2025,
 abstract = {Higher Education needs powerful systems to handle academic, administrative, and performance data. Old systems have poor scalability and no predictive value to facilitate real-time decision-making. In this paper, the design and implementation of a higher education management system based on the SSH (Spring, Struts, Hibernate) framework and a Bidirectional Long Short-Term Memory (BILSTM) model are discussed. The SSH architecture allows for modular and efficient development, data handling, and scalability, and the BILSTM model examines student behaviour and forecasts academic patterns through historical and future sequence learning. The system supports attendance tracking, performance prediction, and course suggestion. The suggested framework was trained by historical academic records and performance metrics such as accuracy, precision, recall, and response time are evaluated. With respect to current systems, this solution enhances predictive accuracy by with the value of 98.6 %. With a combined architecture, the solution offers an intelligent, responsive, and scalable solution for managing higher education. © 2025 IEEE.},
 author = {Wang, Yubo and Wang, Yao and Wang, Xiren},
 doi = {10.1109/ICICKE65317.2025.11136524},
 journal = {2025 International Conference on Intelligent Computing and Knowledge Extraction, ICICKE 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Design and Implementation of a Higher Education Management Information System based on SSH Framework with Bi-Layered Deep Networks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105022263767?origin=resultslist},
 year = {2025}
