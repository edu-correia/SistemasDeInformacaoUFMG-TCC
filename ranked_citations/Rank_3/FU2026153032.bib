@article{FU2026153032,
 abstract = {The transition to hydrogen-based energy systems is critical for decarbonization, yet pure hydrogen combustion faces challenges such as thermoacoustic instabilities. This study investigates the flame dynamics and combustion instabilities in a multi-microtube hydrogen combustor under different air flow rates and equivalence ratios. Experimental analyses, including high-speed OH* chemiluminescence imaging, dynamic pressure measurements, dynamic mode decomposition (DMD), and recurrence plot analysis, were employed to characterize flame structures and instability mechanisms. Results reveal a nonlinear transition in self-excited oscillation modes: dual-frequency oscillations dominated at a low equivalence ratio of (φ = 0.3), while higher-frequency single-mode instability emerged at intermediate ratios (φ = 0.4–0.6), transitioning to stable combustion at φ = 0.7. The accompanying low-frequency oscillation (∼67 Hz) is attributed to periodic global flame weakening and recovery caused by insufficient fuel entrainment. The dominant higher-frequency mode (∼365–491 Hz) arises from sequential formation, merging, and convective dissipation of shear-layer flame streaks. DMD identified coherent structures associated with axial flame modulation and shear-layer streaks, while acoustic modeling confirmed the coupling of Helmholtz and quarter-wave modes with observed instabilities. The study provides the first demonstration of nonlinear critical features in self-excited combustion instabilities within multi-nozzle hydrogen-air flames over a range of equivalence ratios, offering valuable insights for the design of stable and low-emission hydrogen combustion systems in future energy applications.},
 author = {Pengfei Fu and Yourong Fu and Yafen Wang and Lingyun Hou and Liang Xu and Han Wu and Gaofeng Wang},
 doi = {https://doi.org/10.1016/j.ijhydene.2025.153032},
 issn = {0360-3199},
 journal = {International Journal of Hydrogen Energy},
 keyword = {Micromix hydrogen combustion, Flame structure, Thermoacoustic instability, Flame dynamics},
 pages = {153032},
 title = {Flame dynamics and multi-mode instability in hydrogen multitube micromixing combustion},
 url = {https://www.sciencedirect.com/science/article/pii/S0360319925060355},
 volume = {203},
 year = {2026}
}
