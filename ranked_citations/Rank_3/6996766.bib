@inproceedings{6996766,
 abstract = {In order to find solutions for merging heterogeneities among various home networks, we proposed an approach to develop an unified Service-Oriented design pattern to build a network controller and service platform, and implement the home service bus with loosely-coupled systems, to make smart appliances become easier to build upon. We detailed the multilayer architecture of our system and its implementation, which follows the concepts of home service bus. We also presented and discussed several prototypes using the above principles, which connect environmental sensors and actuators with Web Services.},
 author = {Xu, Xiaowei and Tao, Ye and Wang, Xiaodong and Ding, Xiangqian},
 booktitle = {2014 5th International Conference on Digital Home},
 doi = {10.1109/ICDH.2014.51},
 issn = {},
 keyword = {Smart homes;Web services;Intelligent sensors;Home appliances;Computer architecture},
 month = {Nov},
 number = {},
 pages = {232-236},
 title = {Research on Architecture of Smart Home Networks and Service Platform},
 volume = {},
 year = {2014}
}
