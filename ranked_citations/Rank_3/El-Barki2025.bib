@conference{El-Barki2025,
 abstract = {Over the past decade, the convergence of artificial intelligence (AI) and customer experience (CX) has reshaped business strategy, customer engagement, and digital transformation. This study presents a comprehensive bibliometric analysis aimed at mapping the scientific landscape of AI and CX studies published between 2015 and 2025. Using data extracted from the main Web of Science collection and analyzed via VOSviewer and Biblioshiny (R), the study applies performance analysis, co-citation, keyword co-occurrence, and thematic mapping to highlight publication trends, key contributors, influential journals, and emerging research themes. The results show a considerable increase in academic output since 2018, with a compound annual growth rate of 78.62%, driven by growing interest in AI applications in customer-centric strategies. Thematic analyses highlight the relevance of concepts such as personalization, chatbots, and predictive analytics, while revealing conceptual fragmentation and geographical imbalances in research contributions. Furthermore, the study highlights significant gaps in ethics, contextual diversity, and interdisciplinary integration. These insights provide a structured foundation for future research and guide academics, professionals, and policymakers who wish to leverage AI for groundbreaking CX strategies. © 2025 IEEE.},
 author = {El-Barki, Yassir and Oubrich, Mourad and El Ghazi, Hamid and Alzahrani, Saeed},
 doi = {10.1109/ICTMOD66732.2025.11372016},
 journal = {2025 IEEE International Conference on Technology Management, Operations and Decisions, ICTMOD 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Artificial Intelligence and Customer Experience: A Bibliometric Review of Strategic Research Trends (2015-2025)},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105034483485?origin=resultslist},
