@conference{Guo2010177,
 abstract = {This paper focuses on the domain knowledge management of expressway networks in Intelligent Transport Systems and develops ontology for them by reusing SUMO (Suggested Upper Merge Ontology) as the upper ontology. The approached ontology names SENO (SUMO-based Expressway Network Ontology) and consists of two parts, among which SENO Basic is the set of shared concepts and relations, whereas SENO Core divides key concepts and relations into several categories according to the pattern of semantic organization of information in expressway network. As illustrated in a case study, SENO can be instantiated to form a comprehensive semantic view of the domain knowledge to eliminate ambiguities among heterogeneous systems, and to better promote knowledge management and information sharing for expressway network. © 2010 IEEE.},
 author = {Guo, Junjie and Tang, Liantao},
 doi = {10.1109/ICOIP.2010.81},
 journal = {Proceedings - 2010 International Conference on Optoelectronics and Image Processing, ICOIP 2010},
 note = {Cited by: 1},
 pages = {177 - 180},
 publication_stage = {Final},
 source = {Scopus},
 title = {A SUMO-based ontology of expressway network for domain knowledge management},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84880248582?origin=resultslist},
 volume = {1},
 year = {2010}
