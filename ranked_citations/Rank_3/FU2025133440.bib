@article{FU2025133440,
 abstract = {The expansion of the pharmaceutical industry has led to increasingly severe water pollution issues attributable to the misuse of antibiotics, thereby necessitating the development of effective pretreatment and integrated water treatment technologies. Catalytic membranes (CMs) that seamlessly integrate catalytic and separation functions have emerged as promising platforms, enhancing reaction efficiency and selectivity through innovative in-situ separation mechanisms. This review initially analyzes research trends in related fields using bibliometric methods and advanced visualization tools, followed by an in-depth discussion of rational construction strategies and coupled treatment mechanisms of CMs. In addition, regarding four typical CMs (photocatalytic membranes, electrocatalytic membranes, Fenton/Fenton-like catalytic membranes, and biocatalytic membranes), the advantages and challenges in the practical application of antibiotic wastewater treatment are also proposed. This review highlights that future research will focus on achieving breakthroughs in the development of novel catalysts, innovative integration methods for catalysts and membrane materials, reducing the costs associated with catalytic membrane preparation, and leveraging advanced techniques such as artificial intelligence and life cycle assessment.},
 author = {Liyuan Fu and Xi Chen and Yuan Xiang and Guangyong Zeng},
 doi = {https://doi.org/10.1016/j.seppur.2025.133440},
 issn = {1383-5866},
 journal = {Separation and Purification Technology},
 keyword = {Membrane separation technology, Catalytic membrane, Antibiotic wastewater, Degradation and separation, Treatment strategies},
 pages = {133440},
 title = {Integrated catalytic membranes for advanced antibiotic wastewater treatment: Synergistic separation-degradation mechanisms and next-generation design},
 url = {https://www.sciencedirect.com/science/article/pii/S1383586625020374},
 volume = {372},
 year = {2025}
}
