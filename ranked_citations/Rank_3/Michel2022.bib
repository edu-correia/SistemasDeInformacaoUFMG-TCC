@article{Michel2022,
 abstract = {Programmable data plane technologies enable the systematic reconfiguration of the low-level processing steps applied to network packets and are key drivers toward realizing the next generation of network services and applications. This survey presents recent trends and issues in the design and implementation of programmable network devices, focusing on prominent abstractions, architectures, algorithms, and applications proposed, debated, and realized over the past years. We elaborate on the trends that led to the emergence of this technology and highlight the most important pointers from the literature, casting different taxonomies for the field, and identifying avenues for future research.  © 2021 ACM.},
 author = {Michel, Oliver and Bifulco, Roberto and Rétvári, Gábor and Schmid, Stefan},
 doi = {10.1145/3447868},
 journal = {ACM Computing Surveys},
 note = {Cited by: 102; All Open Access; Green Open Access},
 number = {4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {The programmable data plane: Abstractions, architectures, algorithms, and applications},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85108234956?origin=resultslist},
 volume = {54},
 year = {2022}
}
