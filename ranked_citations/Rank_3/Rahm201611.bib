@article{Rahm201611,
 abstract = {Current data integration approaches are mostly limited to few data sources, partly due to the use of binary match approaches between pairs of sources. We thus advocate for the development of more holistic, clustering-based data integration approaches that scale to many data sources. We outline different use cases and provide an overview of initial approaches for holistic schema/ontology integration and entity clustering. The discussion also considers open data repositories and so-called knowledge graphs. © Springer International Publishing Switzerland 2016.},
 author = {Rahm, Erhard},
 doi = {10.1007/978-3-319-44039-2_2},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 47},
 pages = {11 - 27},
 publication_stage = {Final},
 source = {Scopus},
 title = {The case for holistic data integration},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84984904172?origin=resultslist},
 volume = {9809 LNCS},
 year = {2016}
}
