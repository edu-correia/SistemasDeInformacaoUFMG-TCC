@article{Tandon2024472,
 abstract = {Code Smells have been detected, predicted and studied by researchers from several perspectives. This literature review is conducted to understand tools and algorithms used to detect and analyze code smells to summarize research agenda. 114 studies have been selected from 2009 to 2022 to conduct this review. The studies are deeply analyzed under the categorization of machine learning and non-machine learning, which are found to be 25 and 89 respectively. The studies are analyzed to gain insight into algorithms, tools and limitations of the techniques. Long Method, Feature Envy, and Duplicate Code are reported to be the most popular smells. 38% of the studies focused their research on the enhancement of tools and methods. Random Forest and JRip algorithms are found to give the best results under machine learning techniques. We extended the previous studies on code smell detection tools, reporting a total 87 tools during the review. Java is found to be the dominant programming language during the study of smells. © Ram Arti Publishers. Uses under the Creative Commons Attribution 4.0 International (CC BY 4.0) license at https://creativecommons.org/licenses/by/4.0/},
 author = {Tandon, Stuti and Kumar, Vijay and Singh, V.B.},
 doi = {10.33889/IJMEMS.2024.9.3.025},
 journal = {International Journal of Mathematical, Engineering and Management Sciences},
 note = {Cited by: 8; All Open Access; Gold Open Access; Green Open Access},
 number = {3},
 pages = {472 - 498},
 publication_stage = {Final},
 source = {Scopus},
 title = {Study of Code Smells: A Review and Research Agenda},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85192676820?origin=resultslist},
 volume = {9},
 year = {2024}
}
