@article{1196422,
 abstract = {An improved multimedia database system is proposed. It consists of an image server (image servers), a directory server, and user terminals which are connected together through the Japanese gigabit networks (JGN). The image server stores high-definition still images of Japanese Kosode garments. The image directory compares the sketched image entered by the user with the index code of the index image using a new type of search engine so that the image retrieval is carried out using the sketched image. In accordance with the sample image resulting from the image retrieval, the high-definition image appears on the HDTV display corresponding to its obtained address. This accomplishment leads to merging of high-definition still images to the HDTV images on HDTV programs.},
 author = {Xinlei Wang and Suzuki, K. and Ikeda, H. and Suzuki, J.},
 doi = {10.1109/TCE.2003.1196422},
 issn = {1558-4127},
 journal = {IEEE Transactions on Consumer Electronics},
 keyword = {High definition video;Image retrieval;HDTV;Multimedia databases;Network servers;Information retrieval;Art;Flat panel displays;Clothing;Consumer electronics},
 month = {Nov},
 number = {4},
 pages = {925-931},
 title = {HD image retrieval utilizing networked image directory},
 volume = {48},
 year = {2002}
}
