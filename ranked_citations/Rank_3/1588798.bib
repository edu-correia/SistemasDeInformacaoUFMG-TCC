@article{1588798,
 abstract = {The semantic Web aims to represent the contents of Web resources in formalisms that both programs and humans can understand. It relies on rich metadata, called semantic annotations, offering explicit semantic descriptions of Web resources. These annotations are built on ontologies, representing domains through their concepts and the semantic relations between them. Ontologies are the foundations of the semantic Web and the keystone of the Web's automated tasks - searching, merging, sharing, maintaining, customizing, and monitoring.},
 author = {Corby, O. and Dieng-Kuntz, R. and Gandon, F. and Faron-Zucker, C.},
 doi = {10.1109/MIS.2006.16},
 issn = {1941-1294},
 journal = {IEEE Intelligent Systems},
 keyword = {Semantic Web;Query processing;Ontologies;Resource description framework;Web search;Search engines;Character generation;Database languages;OWL;Humans;Semantic Web;Web search;approximate queries;RDF Schema;RDF;conceptual graphs},
 month = {Jan},
 number = {1},
 pages = {20-27},
 title = {Searching the semantic Web: approximate query processing based on ontologies},
 volume = {21},
 year = {2006}
}
