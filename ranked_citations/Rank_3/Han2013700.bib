@article{Han2013700,
 abstract = {Effective manipulation of context is very important in providing the context-aware services. In recent years, a variety of context models have been proposed to properly handle the key aspects of the context, while focusing on scenario-based acquisition, management, and representation of context. However, they are difficult to be employed for the agent-based system requiring distributed reasoning. In this paper we propose a context modeling approach for distributed reasoning and merge operator reflecting the perspective of constituent agents for rational reasoning. In addition, an agent-based context-aware system is developed implementing the proposed scheme. Performance evaluation by computer simulation on a use case of smart classroom shows that the proposed approach enables the agents to rationally reason and thereby provide intelligent context-aware services to the users. © 2013 Copyright the authors.},
 author = {Han, Seungwok and Youn, Hee Yong},
 doi = {10.1080/18756891.2013.802875},
 journal = {International Journal of Computational Intelligence Systems},
 note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access},
 number = {4},
 pages = {700 - 711},
 publication_stage = {Final},
 source = {Scopus},
 title = {REFLECTING THE PERSPECTIVES OF MULTIPLE AGENTS IN DISTRIBUTED REASONING FOR CONTEXT-AWARE SERVICE},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84880927774?origin=resultslist},
 volume = {6},
 year = {2013}
}
