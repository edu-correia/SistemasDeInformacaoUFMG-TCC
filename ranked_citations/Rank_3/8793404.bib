@inproceedings{8793404,
 abstract = {Label propagation is a strategy for optimizing some objects to detect community structure. In this paper, we introduce a new object about triangles to guide the label update. To avoid the trend that merges too many nodes into a large community, we add one constrain on the objective. Through the experiments and comparison, we select the suitable strength for the constraint. Last, we merge the objective and the existing one linearly into a hybrid objective and use the hybrid objective to guide the label update in our proposed label propagation algorithm. We perform amounts of experiments on artificial and real-world networks. Experimental results demonstrate the superiority of our algorithm in both modularity and speed.},
 author = {Luo, Junhai and Yang, Yang and Ye, Lei},
 booktitle = {2019 34th International Technical Conference on Circuits/Systems, Computers and Communications (ITC-CSCC)},
 doi = {10.1109/ITC-CSCC.2019.8793404},
 issn = {},
 keyword = {Computers;Complex networks;Market research;Optimization;community detection;label propagation;optimization;constraint},
 month = {June},
 number = {},
 pages = {1-4},
 title = {Label propagation method based on constraint about triangles for community detection in complex networks},
 volume = {},
 year = {2019}
}
