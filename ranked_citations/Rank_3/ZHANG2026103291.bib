@article{ZHANG2026103291,
 abstract = {Study region
The Ganjiang River Basin, a major humid subtropical tributary of the Yangtze River located in southeastern China.
Study focus
This study develops a lightweight and interpretable precipitation merging framework based on Absolute Distance Inverse Weighting (ADIW) to integrate eight mainstream precipitation datasets (CHIRPS, CMORPH, ERA5, GSMaP, IMERG, PERSIANN, SM2RAIN, TRMM) from 2008 to 2020. The performance of the merged product, corrected with four methods (Linear Regression-LR, Linear Scaling, Quantile Mapping, Quantile–Quantile), was rigorously evaluated through hydrological simulation using the HYPE and VIC models.
New hydrological insights for the region
Results show that: (1) The ADIW merging framework effectively synthesizes multiple datasets, yielding a product with superior correlation and rainfall detection skill compared to any individual input, despite a slight underestimation. (2) While all four bias-correction methods effectively mitigated systematic errors, Linear Regression (LR) proved the most robust and consistent in enhancing both precipitation accuracy and subsequent runoff simulations. (3) Consequently, the combined ADIW+LR approach delivered the optimal hydrological performance, achieving the highest Nash–Sutcliffe and Kling–Gupta efficiency values in both models. (4) Diagnostic analysis identified ERA5 and GSMaP as the most influential datasets contributing to the merged product, and established that relative bias (RB) and mean absolute error (MAE) are the key metrics controlling hydrological reliability.},
 author = {Min Zhang and Yang Cheng and Shaowei Ning and Yuliang Zhou and Chengguo Wu and Yi Cui and Juliang Jin and Bhesh Raj Thapa},
 doi = {https://doi.org/10.1016/j.ejrh.2026.103291},
 issn = {2214-5818},
 journal = {Journal of Hydrology: Regional Studies},
 keyword = {Multi-source precipitation data, ADIW merge, HYPE model, VIC model, Runoff simulation, Importance analysis, China},
 pages = {103291},
 title = {Multi-source precipitation fusion for hydrological models: Correction and metrics importance analysis},
 url = {https://www.sciencedirect.com/science/article/pii/S2214581826001898},
 volume = {64},
 year = {2026}
}
