@inproceedings{6509793,
 abstract = {In this highly competitive free market economy, the test or interest of a certain consumer plays a momentous role for the business organizations to select appropriate products to be advertised to him through the online store or their website. In other words, business organizations need to be proficient in advertising their products to attract the potential consumers. To achieve the goal, organizations have to keep track of the consumers' buying habit to figure out the priority products. Thus the consumers' priority product management is a candidate for high degree of attention. In this paper, we have developed and analyzed the algorithm for consumers' priority product management with minimum time and space complexity. We use the concept of balanced binary search tree in this case to attain efficient time complexity. For reducing space requirement, we have proposed merging algorithm that incorporates with the balanced binary search tree, to achieve the optimal performances. We have simulated for 1 million test cases and our results show that the algorithm achieves a high memory saving index with logarithmic time complexity in each working round.},
 author = {Al-Ameen, Mahdi Nasrullah and Shahriar, Mehrab and Billah, Adip},
 booktitle = {2012 15th International Conference on Computer and Information Technology (ICCIT)},
 doi = {10.1109/ICCITechn.2012.6509793},
 issn = {},
 keyword = {Vegetation;Organizations;Binary search trees;Time complexity;Complexity theory;Indexes;Organizational aspects;Digital storage;Computer science;Vectors;Information Management;Consumers' Priority Product Management;Digital Store;Binary Search Tree;Red Black Tree},
 month = {Dec},
 number = {},
 pages = {4-8},
 title = {Time and space efficient algorithm for consumer's priority product management},
 volume = {},
 year = {2012}
}
