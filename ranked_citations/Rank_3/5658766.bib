@inproceedings{5658766,
 abstract = {The Telematics is the integration of telecommunication and informatics, also known as ICT (Information and Communications Technology). The application trend of Telematics is to establish a user friendly vehicle communication environment to merge the information for the traffic safety, road navigation, remote business, A/V entertainment, etc. The key technologies of Telematics are the heterogeneous communication and information fusion. This paper aims to design a Android-based mobile device platform that integrated with network management functions and MOST (Media Oriented Systems Transport) technologies to utilize multiple network access and Telematics services. The platform composed a heterogeneous network management algorithm which includes roaming and sharing functions to maintain the qualities of services and satisfy different kinds of scenario needs. Besides, we implemented those technologies based on Android software stack with X86 based real targets, such as Car PC or mobile internet device (MID). The heterogeneous network management and Telematics service functions are implemented as the user defined libraries with Android software stack from kernel to application layers to offer better qualities of user services for different kinds of environments. The multimedia streaming and telecommunication sharing scenarios can be also realized by integrating the MOST networks with the Android system to provide more real-time information and entertainment services with quality guarantee. The proposed Android system could be used in home, mobile and vehicular environments to realize ubiquitous social sharing networks and provides the seamless communication efficiency.},
 author = {Yong-Hua Cheng and Wen-Kuang Kuo and Szu-Lin Su},
 booktitle = {2010 IEEE International Conference on Intelligent Computing and Intelligent Systems},
 doi = {10.1109/ICICISYS.2010.5658766},
 issn = {},
 keyword = {WiMAX;Multiaccess communication;Hardware;Spread spectrum communication;Universal Serial Bus;Global Positioning System;Telematics;Heterogeneous network;Android},
 month = {Oct},
 number = {},
 pages = {206-210},
 title = {An Android system design and implementation for Telematics services},
 volume = {2},
 year = {2010}
