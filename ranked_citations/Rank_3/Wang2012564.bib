@article{Wang2012564,
 abstract = {The existing ontology merging methods have the general characteristic of low automation level, and combined results being over affected by human mind. In response to these disadvantages, this paper have designed FCA-ontMerge, a ontology merging framework based on concept lattice, including body pretreatment, format conversion, attribute mapping and concept lattices merging. Firstly, merge the form background, split ontology into concept lattice in proportion, then merge the concept lattice. In this process, we proposed merging rules and algorithm of form background, making the use of concept lattices' perfect mathematical principles and the characteristic of being good at finding hidden concept, which also applied the improved incremental concept lattice generation algorithm. this method enhanced the efficiency and accuracy of ontology merging. To verify the system, this article put existing ontology system, OMS systems and FCA-ontMerge system under the same set of data to compare, the results show FCA-ontMerge system is with better accuracy than the OMS system, and higher automation level than the existing three ontology system. It is also helpful to solve the heterogeneous problem.},
 author = {Wang, Xiening and Li, Guanyu and Liu, Shupeng},
 doi = {10.4156/jdcta.vol6.issue21.65},
 journal = {International Journal of Digital Content Technology and its Applications},
 note = {Cited by: 0},
 number = {21},
 pages = {564 - 570},
 publication_stage = {Final},
 source = {Scopus},
 title = {An ontology merging method based on concept lattice},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84870597642?origin=resultslist},
 volume = {6},
 year = {2012}
}
