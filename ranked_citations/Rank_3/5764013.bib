@inproceedings{5764013,
 abstract = {The resource locating efficiency is the core issue of P2P systems. The unstructured P2P systems adopt the flooding mechanism, which causes huge network burden. The Structured P2P systems, however, employs routing based on DHT, which results in an expensive topology maintenance. This paper will propose a semi-construct P2P model. Based on the research of the small world theory, this model combines the advantages of both unstructured and structured P2P systems. It can effectively improve the resource location efficiency, prevent the waste of network bandwidth by flood inquiry, and cut down the cost of topology maintenance. According to the mathematical model and the experimental results, the method features a searching success rate close to that of Chord with a smaller cost.},
 author = {Yu Wang and Xinli Huang and Qindong Lu},
 booktitle = {2011 3rd International Conference on Computer Research and Development},
 doi = {10.1109/ICCRD.2011.5764013},
 issn = {},
 keyword = {Peer to peer computing;Nominations and elections;Topology;Computer science;Protocols;Network topology;Mathematical model;Peer-to-peer networks;Small World;Resource search;Semi-constructed},
 month = {March},
 number = {},
 pages = {246-251},
 title = {Small-world-like semi-structured P2P network},
 volume = {1},
 year = {2011}
}
