@inproceedings{11469838,
 abstract = {The paper describes BEAST (Behavior-based Extraction and Anomaly Scoring Technique), a multi-layered anomaly detection system which aims at detecting complex and subtle threats in systems by performing the analysis of behavior in a unified manner. The suggested approach collects and merges features in five important areas, processor activity, memory usage, disk I/O, file entropy and network behavior, into structured behavior vector at deterministic time points. The features are standardized and the results are compared with an Isolation Forest model to assign the anomaly scores and identify any anomalous operation with respect to normal working system behaviour. Adaptive learning is also facilitated through feedback-based labeling; returning the modeled response distilled through the input of analysts. As experimentally shown, BEAST is superior or comparable to multiple baseline models in terms of precision and F1-score that empirically eliminates false positives and keeps high sensitivity of detection. The framework has interpretable results and can be deployed in dynamic computing environments in real-time applications.},
 author = {Lakshmi, M. Sri and Reddy, N Sai Simha and Reddy, Gnaneswar and Keshava, K Sri and Maneesh, Ketha},
 booktitle = {2026 International Conference on Visual Analytics and Data Visualization (ICVADV)},
 doi = {10.1109/ICVADV67766.2026.11469838},
 issn = {},
 keyword = {Telemetry;Aerospace and electronic systems;Payloads;Central Processing Unit;Feedback;Circuits;Electronic circuits;Communication systems;Internet of Things;Software defined networking;anomaly detection;behavioral analysis;isolation forest;feature extraction;feedback learning;system monitoring},
 month = {Feb},
 number = {},
 pages = {498-505},
 title = {Adaptive Real-Time Ransomware Detection Using Processor-Disk Behavior Analysis with Intelligent Threat Response Mechanisms},
