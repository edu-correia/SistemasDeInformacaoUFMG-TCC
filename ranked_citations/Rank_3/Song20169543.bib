@conference{Song20169543,
 abstract = {In the present stage of information construction, enterprises have achieved partial information, but there is still overall isolation. In order to grasp the production status of the cement branch factories in real time, optimize the production process and the reasonable allocation of production tasks, objective evaluation of the production efficiency, improve the comprehensive competitiveness of the enterprises in the same industry, we should break the information island problem of each branch. So that the data can be synchronized between the branch and the group in real-time. This paper is based on the SQL Server database and its replication technology. Provide a safe, reliable and low cost solution for data synchronization in the cement industry. © 2016 TCCT.},
