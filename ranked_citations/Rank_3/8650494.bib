@inproceedings{8650494,
 abstract = {Nowadays, most ship surveillance systems utilize phased-array systems. However, majority of employed HFSWRs are of compact type and are mostly used for ocean parameters estimation. This paper covers the development of a ship or vessel detection scheme for compact high frequency surface wave radars configured for remote ocean sensing. The proposed detector exploits the background information generated from a background segmentation process to select which CFAR variant yields optimum performance. A merging algorithm for adjacent detections combined with a local peak detection technique is employed to mitigate the effects of target spreading which is common in radars with long integration time. Preliminary results show that the proposed detector detects possible targets even with severe spreading.},
 author = {Cruz, Febus Reidj G. and Collado, Mark Rommel L. and Penetrante, Francis C. and Baltazar, Jesse Michael E.},
 booktitle = {TENCON 2018 - 2018 IEEE Region 10 Conference},
 doi = {10.1109/TENCON.2018.8650494},
 issn = {2159-3450},
 keyword = {Clutter;Doppler effect;Radar detection;Merging;Doppler radar;Microsoft Windows;HFSWR;CFAR;ship detection;radar signal processing},
 month = {Oct},
 number = {},
 pages = {2528-2533},
 title = {Background-Dependent Adaptive Composite CFAR Detector for Compact High Frequency Surface Wave Radars},
 volume = {},
 year = {2018}
}
