@inproceedings{11182236,
 abstract = {Wearable sensor systems have become important tools for real-time monitoring of movement. They offer great potential in healthcare, rehabilitation, and sports science. This study introduces a smart wearable sensor platform that combines flexible strain sensors, accelerometers, and gyroscopes to gather high-resolution motion data. The system uses an onboard AI-based signal processing algorithm to improve data quality by filtering out noise and spotting unusual movement patterns. Made with sustainable materials and energy-efficient hardware, the device supports environmental responsibility and extends its lifespan. Validation from studies in clinical rehabilitation and athletic performance showed better motion detection accuracy and high user comfort. By merging sensor technologies with smart data analysis, this system provides an effective and scalable solution for healthcare providers and sports professionals looking for reliable, real-time insight into movement.},
 author = {R, Aadhira Suleim A and M, Anlin Sahaya Infant Tinu},
 booktitle = {2025 International Conference on Biomedical Engineering and Sustainable Healthcare (ICBMESH)},
 doi = {10.1109/ICBMESH66209.2025.11182236},
 issn = {},
 keyword = {Biomechanics;Accuracy;Medical services;Real-time systems;Energy efficiency;Electromyography;Reliability;Wearable sensors;Monitoring;Sports;wearable sensors;biomechanical monitoring;AI integration;signal processing;gait analysis;rehabilitation technology;sustainable design;motion tracking;healthcare innovation},
 month = {Aug},
 number = {},
 pages = {1-6},
 title = {Smart Wearable Sensor System for Real-Time Biomechanical Analysis with AI Integration},
 volume = {},
 year = {2025}
}
