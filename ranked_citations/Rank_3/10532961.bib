@inproceedings{10532961,
 abstract = {In the rapidly evolving landscape of cybercrime, ensuring the authenticity and traceability of digital evidence has become paramount. This paper explores the integration of blockchain technology with digital forensics as a novel approach to address these concerns. Blockchain, with its inherent characteristics of immutability and decentralization, can offer significant advancements in ensuring tamper-proof storage and chronological verification of forensic artifacts. By merging these two domains, we introduce a framework that not only bolsters the authenticity of digital evidence but also facilitates a robust traceability mechanism. Through a detailed case study, we demonstrate the practicality and effectiveness of this integrated approach, highlighting its potential to revolutionize current forensic methodologies. However, we also delve into the challenges posed, such as scalability, privacy, and legal implications, and suggest future research avenues. Leveraging blockchain technology in the realm of digital forensics has the potential to redefine evidence integrity and the forensic investigation landscape.},
 author = {Al-E‘mari, Salam and Sanjalawe, Yousef and Makhadmeh, Sharif and Alqudah, Hamzah},
 booktitle = {2024 2nd International Conference on Cyber Resilience (ICCR)},
 doi = {10.1109/ICCR61006.2024.10532961},
 issn = {},
 keyword = {Privacy;Scalability;Digital forensics;Merging;Blockchains;Computer crime;Resilience;Blockchain;cybercrime;digital forensics;forensic investigation;traceability},
 month = {Feb},
 number = {},
 pages = {01-06},
 title = {Digital Forensics Meets Blockchain: Enhancing Evidence Authenticity and Traceability},
 volume = {},
 year = {2024}
}
