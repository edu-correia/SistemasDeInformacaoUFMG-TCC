 issn = {0720-048X},
 journal = {European Journal of Radiology},
 keyword = {Deep learning, Ground-glass nodules, Multiple time-series, Longitudinal, CT},
 pages = {112252},
 title = {Deep learning model using CT images for longitudinal prediction of benign and malignant ground-glass nodules},
