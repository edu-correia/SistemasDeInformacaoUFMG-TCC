 abstract = {Digital recruiting, or e-recruiting, leverages digital technology and online platforms to enable and potentially revolutionize talent acquisition. It encompasses AI-driven automation, social media recruiting, digital corporate identity, video interviews, and mobile strategies which considerably expedite candidate selection. This contrasts with traditional offline methods, and hybrid approaches are becoming more common. Social media integration has the potential to accelerate hiring, enhance speed as well as efficiency, and provide rich candidate profiles. However, digital recruiting presents data privacy and bias challenges, necessitating robust data management and ethical AI practices. Continued AI advancements, combining automation with human interaction are expected in the future. The metaverse, a virtual world merging physical and digital realities, enables the reshaping of digital recruiting by facilitating virtual job fairs or immersive interviews. Companies should adapt to this evolving landscape, in order to keep attracting new employees. In conclusion, digital recruiting defines modern HR recruiting practices in the digital environment as well as an up-to-date digital corporate identity, including the usage of AI and the metaverse.},
 address = {Oxford},
 author = {Melanie Gruel and Henning Tirrel},
 booktitle = {International Encyclopedia of Business Management (First Edition)},
 doi = {https://doi.org/10.1016/B978-0-443-13701-3.00066-9},
 edition = {First Edition},
 editor = {Vanessa Ratten},
 isbn = {978-0-443-13702-0},
 keyword = {Artificial intelligence, Candidate journey, Digital corporate identity, Digital recruiting, Employer branding, Human resource management, Metaverse, Online marketing, Recruitment, Social media, Web 2.0},
 pages = {375-379},
 publisher = {Academic Press},
 title = {Digital Recruiting},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443137013000669},
