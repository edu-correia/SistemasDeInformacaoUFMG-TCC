 abstract = {<p>This chapter explores the operational strategies of machine learning operations (MLOps) within the context of the AWS Certified AI Practitioner exam, focusing on the deployment and inference of foundation models. It examines the end&#x2010;to&#x2010;end lifecycle of machine learning pipelines, from experimentation and repeatable processes to production&#x2010;ready systems and continuous monitoring. The chapter highlights AWS services like Amazon SageMaker, AWS Step Functions, and Apache Airflow, illustrating the transition from proof of concept to real&#x2010;world application. It discusses deployment strategies, automated workflows, and advanced optimization techniques for large language models, merging model development with operational practices to ensure consistent, secure, and cost&#x2010;effective machine learning operations. The chapter also compares MLOps for generative AI and predictive ML workloads, noting differences in finetuning, evaluation metrics, and deployment strategies. MLOps is presented as a holistic framework that streamlines the lifecycle of machine learning models by uniting cross&#x2010;functional teams, establishing standardized workflows, and leveraging automation tools. The phases of MLOps, including experimentation, repeatable processes, and deployment, are detailed, emphasizing the importance of quality gates, CI/CD, and Infrastructure as Code (IaC) for rapid scaling and cost savings.</p>},
 author = {Elango, Vikram and Gangasani, Vivek and Subramanian, Shreyas},
