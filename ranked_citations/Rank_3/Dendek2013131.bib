@article{Dendek2013131,
 abstract = {SYNAT platform powered by the YADDA2 architecture has been extended with the Author Disambiguation Framework and the Query Framework. The former framework clusters occurrences of contributor names into identities of authors, the latter answers queries about authors and documents written by them. This paper presents an outline of the disambiguation algorithms, implementation of the query framework, integration into the platform and performance evaluation of the solution. © 2013 Springer-Verlag Berlin Heidelberg.},
 author = {Dendek, Piotr Jan and Wojewódzki, Mariusz and Bolikowski, Łukasz},
 doi = {10.1007/978-3-642-35647-6_10},
 journal = {Studies in Computational Intelligence},
 note = {Cited by: 2; All Open Access; Green Open Access},
 pages = {131 - 143},
 publication_stage = {Final},
 source = {Scopus},
 title = {Author disambiguation in the YADDA2 software platform},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84886610651?origin=resultslist},
 volume = {467},
 year = {2013}
}
