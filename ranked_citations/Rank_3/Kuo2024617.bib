@conference{Kuo2024617,
 abstract = {Significant power consumption can be incurred during the switching process for the SAR ADC. Hence, a novel approach of a merge-split switching technique is proposed by integrating three reference voltages. This integration yields a significant reduction in capacitance. Furthermore, refinements are introduced to the logic control unit, resulting in a notable reduction in the switching duration. This power consumption during switching further diminishes the capacitance load on the capacitor array. A specialized switch mechanism is augmented by incorporating three distinct reference voltages, thereby diversifying the voltage modalities employed to regulate the temporal aspects of merge-split switching. The simulated DNL is 1.286/-0.746 LSB, and the INL is 1.413/-1.222 LSB. Under the sampling frequency Fs of 4MHz at Fin of 0.496MHz, the simulated dynamic performances of SNDR and SFDR are 54.874dB and 66.04dB, respectively. The ENOB is 8.93 bits, and the FoM is 2.01 (fJ/conv.-step). © 2024 IEEE.},
 author = {Kuo, Ko-Chi and Huang, Sin-Cong and Huang, Chun-Wei},
 doi = {10.1109/ICCE-Taiwan62264.2024.10674466},
 journal = {11th IEEE International Conference on Consumer Electronics - Taiwan, ICCE-Taiwan 2024},
 note = {Cited by: 0},
 pages = {617 - 618},
 publication_stage = {Final},
 source = {Scopus},
 title = {A three reference voltage 0.5V 10-bit SAR-ADC using merge split capacitor switching scheme in 40nm CMOS},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85205772145?origin=resultslist},
 year = {2024}
}
