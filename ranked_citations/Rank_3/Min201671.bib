@conference{Min201671,
 abstract = {We analyze the manycore scalability of five widelydeployed file systems, namely, ext4, XFS, btrfs, F2FS, and tmpfs, by using our open source benchmark suite, FXMARK. FXMARK implements 19 microbenchmarks to stress specific components of each file system and includes three application benchmarks to measure the macroscopic scalability behavior. We observe that file systems are hidden scalability bottlenecks in many I/Ointensive applications even when there is no apparent contention at the application level. We found 25 scalability bottlenecks in file systems, many of which are unexpected or counterintuitive. We draw a set of observations on file system scalability behavior and unveil several core aspects of file system design that systems researchers must address. © 2016 by The USENIX Association. All Rights Reserved.},
 author = {Min, Changwoo and Kashyap, Sanidhya and Maass, Steffen and Kang, Woonhak and Kim, Taesoo},
 journal = {Proceedings of the 2016 USENIX Annual Technical Conference, USENIX ATC 2016},
 note = {Cited by: 113},
 pages = {71 - 85},
 publication_stage = {Final},
 source = {Scopus},
 title = {Understanding manycore scalability of file systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85030559438?origin=resultslist},
 year = {2016}
}
