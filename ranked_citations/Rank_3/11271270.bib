@article{11271270,
 abstract = {The autonomous driving system (ADS) promises improved traffic safety and efficiency, but credible verification remains a prerequisite. Verification conducted solely on public roads is constrained by cost, risk, and limited reproducibility, motivating simulation-based evaluation that enables repeatable and scalable experimentation in diverse situations. However, existing OpenSCENARIO datasets still lack coverage of rare and safety-critical hazards. Bridging this gap typically requires hand-crafted scenario code, which is time consuming and error prone. To address these, we propose a method that translates natural language descriptions of disturbance situations into OpenSCENARIO code using a Large Language Model (LLM) and automatically merges them into a base scenario. The proposed method adopts prompt engineering strategies, including Few-shot (FS), Zero-shot Chain-of-Thought (CoT), Least-to-Most (LtM), and their combinations. Through experiments spanning four levels of disturbance complexity, we observed complementary behaviors between the two models. Gemini 2.5-flash achieved the most balanced performance when using the FS+LtM strategy, while GPT o4-mini attained the highest accuracy with the standalone FS strategy. Qualitative results demonstrated that the generated scenarios preserved intent fidelity, complied with OpenSCENARIO standards, and operated consistently across diverse diverse simulator environments (esmini, CARLA, etc.). In sum, our method lowers the barrier for non-experts to create scenarios, expands scenario datasets by generating diverse cases, and provides a practical foundation to accelerate ADS verification in virtual environments.},
 author = {Kim, Junkwon and Kim, Seunghwan and Jeong, Geonwoo and Lee, Eunbee and Lee, Jinho},
 doi = {10.1109/ACCESS.2025.3638671},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {Codes;Natural languages;Autonomous vehicles;Safety;Scenario generation;Testing;Virtual environments;Roads;XML;Standards;Autonomous driving system (ADS);autonomous vehicle (AV);OpenSCENARIO;scenario generation;large language model (LLM);prompt engineering},
 month = {},
 number = {},
 pages = {207200-207210},
 title = {Rule-Based Translation From Natural Language to OpenSCENARIO by Injecting Various Disturbance for Driving Simulator},
 volume = {13},
 year = {2025}
}
