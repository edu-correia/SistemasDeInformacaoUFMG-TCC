@inproceedings{5652449,
 abstract = {We present an efficient method for accurate automatic registration of two geometrically complex 3D range scans by using 3D lines. We first detect edges from the associated 2D reflectance images and collect 3D edge contours by only taking into account valid foreground points. Then we use an efficient split-and-merge line fitting algorithm to detect 3D lines. We build a fast search codebook to efficiently match the two sets of 3D lines. This is done by computing the orientation angle and distance of pairs of 3D lines in each set, both of which are invariant under rigid transformations. Finally we recover the rigid transformation between two scans using an efficient RANSAC algorithm with robust transformation estimation that exploits two sets of corresponding 3D lines. We conclude presenting experimental results that demonstrate efficiency and accuracy of our proposed method.},
 author = {Yao, Jian and Ruggeri, Mauro R. and Taddei, Pierluigi and Sequeira, Vítor},
 booktitle = {2010 IEEE International Conference on Image Processing},
 doi = {10.1109/ICIP.2010.5652449},
 issn = {2381-8549},
 keyword = {Image edge detection;Three dimensional displays;Feature extraction;Robustness;Accuracy;Estimation;Iterative closest point algorithm;Line matching;range image registration},
 month = {Sep.},
 number = {},
 pages = {4321-4324},
 title = {Robust range image registration using 3D lines},
 volume = {},
 year = {2010}
}
