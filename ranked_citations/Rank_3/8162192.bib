@article{8162192,
 abstract = {Within the context of the standard structure formation scenario, massive present day elliptical galaxies are sometimes thought of as the result of a major merger of spiral systems. Through extensive smooth particle hydrodynamic (SPH) simulations of merging spirals, we have explored these processes with the aim of quantifying their relaxation times. This is important, as it sets a minimum time interval between the onset of a merger and the appearance of an elliptical galaxy. We then compare this constraint with predictions of the hierarchical scenario, computed through Press–Schechter merger trees. We find evidence for elliptical systems that appear not to have been formed by a major merger of spirals.},
 author = {Hernandez, Xavier and Lee, William H.},
 doi = {10.1111/j.1365-2966.2004.07329.x},
 issn = {1365-2966},
 journal = {Monthly Notices of the Royal Astronomical Society},
 keyword = {galaxies: elliptical and lenticular, cD;galaxies: evolution;galaxies: formation;galaxies: interactions;cosmology: theory},
 month = {Feb},
 number = {4},
 pages = {1304-1316},
 title = {Dynamical consequences of CDM merger trees},
 volume = {347},
 year = {2004}
}
