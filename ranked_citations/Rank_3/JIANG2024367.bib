@incollection{JIANG2024367,
 abstract = {In this chapter, we explore cluster analysis, which is essential in medical research for identifying objects or variables’ natural groupings. Its essence is to maximize within-cluster homogeneity and between-cluster heterogeneity depending on the closeness of items (or variables). First we discuss measuring object distances and similarities, and then define cluster properties, setting the stage for various clustering techniques. Hierarchical clustering, which focuses on merging similar categories in each step and varying inter-class distance definitions, is the primary method. Dynamic clustering achieves optimal grouping through iterative processes from initial points. We also review methods for clustering ordered samples. We highlight the issue stemming from the absence of a uniform standard for method comparison, and advocate for integrating domain insights with clustering results to achieve a comprehensive classification evaluation.},
 author = {Jingmei Jiang},
 booktitle = {Applied Multivariate Statistical Analysis in Medicine},
 doi = {https://doi.org/10.1016/B978-0-443-23587-0.00011-1},
 editor = {Jingmei Jiang},
 isbn = {978-0-443-23587-0},
 keyword = {Cluster analysis, Distance, Hierarchical clustering, Dynamic clustering, Ordered object clustering},
 pages = {367-411},
 publisher = {Academic Press},
 title = {Chapter 11 - Cluster analysis},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443235870000111},
 year = {2024}
}
