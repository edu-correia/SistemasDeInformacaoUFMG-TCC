@inproceedings{9905431,
 abstract = {Reasoning in Description Logics (DLs) can detect inconsistencies between trusted knowledge and not trusted sources. The proposed method is exemplified on fake news for Covid19. Machine learning is used to generate DL axioms from positive and negative examples using tools such as DL-Learner. The resulted knowledge graph formalised in DL is merged with the trusted ontologies on Covid-19. Reasoning in DL is then performed with the Racer engine, which is responsible to detect inconsistencies within the ontology. When detecting inconsistencies, a "red flag" is raised to signal possible fake news and the corresponding counterspeech is generated.},
 author = {Groza, Adrian},
 booktitle = {2022 IEEE Workshop on Complexity in Engineering (COMPENG)},
 doi = {10.1109/COMPENG50184.2022.9905431},
 issn = {2688-2582},
 keyword = {Knowledge engineering;COVID-19;Semantic Web;Description logic;Scalability;Natural languages;Machine learning;fake news;ontologies;white box ML},
 month = {July},
 number = {},
 pages = {1-4},
 title = {Detecting fake news using machine learning and reasoning in Description Logics},
 volume = {},
 year = {2022}
}
