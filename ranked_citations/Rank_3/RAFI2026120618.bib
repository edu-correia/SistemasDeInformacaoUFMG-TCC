@article{RAFI2026120618,
 abstract = {Accurate real-time estimation of the state of charge (SOC) and state of health (SOH) is essential for the safety, reliability, and longevity of Li-ion batteries. This study presents a unified deep learning framework for twin-state estimation, emphasizing accuracy, generalization, and physical interpretability across diverse operating conditions. The architecture employs an autocorrelation function (ACF)-augmented adaptive dynamics LSTM (AD-LSTM) with memory-based attention to capture complex temporal dependencies and nonlinearities in battery behavior. Building on this, the historical estimation-aware combined feature network (HEC-Net) integrates past state information to reinforce long-term coherence, enhancing estimation stability and continuity. A major contribution is the quantitative battery representation and integration network (Q-BRAIN), which embeds physics-based knowledge into training to align latent features with physically meaningful representations, while being discarded during inference to preserve evaluation efficiency. A bidirectional cross-modality supervision strategy (LoCS) further aligns SOC and SOH objectives, enabling synergistic representation learning that improves robustness while maintaining independence at inference. The SOH model leverages a dual-branch LSTM architecture (ODS-ABiLSTM and PCS-ABiLSTM). To address the challenge of incomplete or irregular discharge sequences, a Prophet-based data reconstruction mechanism is incorporated, enabling real-time SOH estimation without reliance on complete discharge cycles—a key step toward real-world deployment. Experimental results on multiple heterogeneous datasets demonstrate superior performance over state-of-the-art methods, achieving RMSEs of 1.74–3.67% for SOC and 0.49–6.69% for SOH estimation offering a battery-agnostic, interpretable, and scalable solution for next-generation intelligent battery management systems.},
 author = {Md Shoaib Akhter Rafi and Muhammad Anisuzzaman Talukder and Md. Kamrul Hasan},
 doi = {https://doi.org/10.1016/j.est.2026.120618},
 issn = {2352-152X},
 journal = {Journal of Energy Storage},
 keyword = {Lithium-ion battery, State of charge and health, Deep learning, Quantitative battery representation, Memory-based attention, Real-time data reconstruction},
 pages = {120618},
 title = {Real-time data reconstruction-based joint estimation of state-of-charge and state-of-health of lithium-ion batteries using quantitative feature informed deep learning framework},
 url = {https://www.sciencedirect.com/science/article/pii/S2352152X26002823},
 volume = {152},
 year = {2026}
}
