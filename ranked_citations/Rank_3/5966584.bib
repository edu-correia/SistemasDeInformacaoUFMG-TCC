@inproceedings{5966584,
 abstract = {In order to improve the ability of users to share data within and across organizations, enterprises can move their data from user-managed devices to data centers accessible via cloud computing services. Such a transition in data storage, access, and management raises technical issues that are not addressed by current operating system, tagging, and configuration and control management technologies. In this paper we describe the notion of a cloud control environment in which cloud services automatically enforce multi-schema-based rules on the organization and manipulation of data objects.},
 author = {Drusinsky, Doron and Michael, James Bret and Otani, Thomas W. and Shing, Man-Tak},
 booktitle = {2011 6th International Conference on System of Systems Engineering},
 doi = {10.1109/SYSOSE.2011.5966584},
 issn = {},
 keyword = {Organizations;Unified modeling language;XML;Encapsulation;Engines;Banking;cloud computing;content management;UML;design pattern},
 month = {June},
 number = {},
 pages = {119-124},
 title = {Putting order into the cloud: Object-oriented UML-based enforcement for document and application organization},
 volume = {},
 year = {2011}
}
