@inproceedings{10828092,
 abstract = {With the continuous advancement of digital infrastructure construction in the power data center and the increasing demand for ubiquitous computing, the application requirements for edge data centers are gradually increasing. This article combines the complexity of current edge data center deployment costs and long cycles in response to application scenarios, and proposes a vertically integrated architecture for edge data centers. By designing an integrated and efficient prefabricated data center architecture, the data center infrastructure can be merged and managed with computing, storage, and network equipment in a limited space. This enables organic integration between various resource objects, forming a highly load-capable, powerful, and plug and play integrated and efficient edge data center. Based on the vertically integrated architecture, the computing power density of edge data center equipment can reach 1000 Cores $/ 15 \mathrm{~kW}$.},
 author = {Song, Wen and Gui, Meikun and Chu, Yi and Wu, Yu and Mao, Linhui and Fan, Guangming},
 booktitle = {2024 IEEE 6th International Conference on Civil Aviation Safety and Information Technology (ICCASIT)},
 doi = {10.1109/ICCASIT62299.2024.10828092},
 issn = {},
 keyword = {Data centers;Power system measurements;Density measurement;Power supplies;Computer architecture;Ubiquitous computing;Protection;Information technology;Information exchange;Plugs;Power Data Center;Edge Data Center;Vertical Fusion Architecture;plug and play;Computing Power Density},
 month = {Oct},
 number = {},
 pages = {1250-1254},
 title = {Vertical Fusion Hierarchical Architecture of Edge Data Center},
 volume = {},
 year = {2024}
}
