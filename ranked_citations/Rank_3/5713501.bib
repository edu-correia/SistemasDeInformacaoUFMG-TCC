@inproceedings{5713501,
 abstract = {The paper proposes a new solution to deadlock in implementing synchronizing merges of workflow models. A kind of process algebra CCS is introduced in the paper to describe the definition of workflow models and the runtime information of activity instances in a workflow process model is described with modal and temporal logic. The solution provided in this paper can be applied to acyclic, cyclic and other complex models to resolve the deadlock. Finally, an algorithm is put forward.},
 author = {Chuyi Fan and Min Xu},
