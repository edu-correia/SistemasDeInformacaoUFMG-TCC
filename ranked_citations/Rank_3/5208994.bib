@inproceedings{5208994,
 abstract = {In this paper, a color image segmentation method is proposed based on region growing and ant colony clustering. By using the intensity similarity among pixels in the HSI color space and the edge information, seeds are first automatically selected. Then seeded region begins to grow based on color and spatial information. After that, ant colony clustering method is used to merge different regions of homogeneity. Finally good results of segmentation can be achieved. Experimental results show that this method is an effective method for image segmentation, which eliminates large quantities of cycles and calculations caused by traditional ant colony algorithm.},
 author = {Mao, Xinyan and Sun, Binjie and Zhang, Ying and Hu, Yanxiao},
 booktitle = {2009 WRI Global Congress on Intelligent Systems},
 doi = {10.1109/GCIS.2009.344},
 issn = {2155-6091},
 keyword = {Image segmentation;Clustering algorithms;Space technology;Ant colony optimization;Image color analysis;Image edge detection;Intelligent systems;Sun;Educational institutions;Clustering methods;ant colony clustering;region growing;euclidean distances;color image segmentation},
 month = {May},
 number = {},
 pages = {173-177},
 title = {Color Image Segmentation Method Based on Region Growing and Ant Colony Clustering},
 volume = {1},
 year = {2009}
}
