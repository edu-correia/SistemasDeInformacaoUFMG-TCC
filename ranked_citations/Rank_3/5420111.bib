@inproceedings{5420111,
 abstract = {In recent years, Web services have developed rapidly along with the amazing development of SOA, while many Web services provide the same function. Thus, it has been attracting substantial attention that how to choose Web services to make a service composition in order to satisfy the business needs in SOA. At present, whether the service composition can meet the quality-of-service (QoS) needs of the users or not becomes an important criterion. However, existing research methods overlooked the effect of business process structure on the QoS of service composition. Business process is made by the users according to the business needs and describes the way to call Web services, the structure of which affects the calculation of QoS in service composition. This paper proposes an algorithm of QoS oriented Web service composition and optimization based on the initial business process structure made by the users. The algorithm optimizes the initial service composition plan repeatedly in dependence on the difference of merging methods for each QoS property in different business process structures. The effect of the algorithm to optimize the service composition was given in a series of experiments.},
 author = {Bing Liu and Yuliang Shi and Haiyang Wang},
 booktitle = {2009 Joint Conferences on Pervasive Computing (JCPC)},
 doi = {10.1109/JCPC.2009.5420111},
 issn = {},
 keyword = {Web services;Service oriented architecture;Quality of service;Optimization methods;Merging;Business communication;Computer science;Safety;Algorithm design and analysis;Costs;Service composition;Quality-of-Service;business process;lengthways optimization;breadthways optimization},
 month = {Dec},
 number = {},
 pages = {605-610},
 title = {QoS oriented web service composition and optimization in SOA},
 volume = {},
 year = {2009}
}
