@inproceedings{5871938,
 abstract = {Pulmonary function testing has been used as a primary tool in assessing an efficiency of the lungs operation. Within that test, maximal flow-volume curves provide clinically useful documentation of any flow limitations in a standardized fashion. Independently, acoustic sounds are used to characterize and reflect on qualitative aspects of flow and its disturbances. This project focused on the design and implementation of an automated system which merges the acoustic sound indicators with the flow-volume loops data which provide integrated and easily documented assessment of related lung functions. The graphical user interface eliminates the need for command line interface.},
 author = {Raman, S. and Druzgalski, C.},
 booktitle = {2011 Pan American Health Care Exchanges},
 doi = {10.1109/PAHCE.2011.5871938},
 issn = {2327-817X},
 keyword = {Acoustics;Graphical user interfaces;Lungs;Three dimensional displays;Software;Two dimensional displays;Conferences;acoustic sounds;electret microphone;flow-volume loops;GUI;PFT},
 month = {March},
 number = {},
 pages = {404-404},
 title = {Automated integration of flow-volume loop and acoustic data},
 volume = {},
 year = {2011}
}
