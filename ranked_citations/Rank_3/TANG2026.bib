@article{TANG2026,
 abstract = {Typhoon Chanthu was an intense tropical cyclone during the 2021 western North Pacific typhoon season, undergoing rapid intensification from a tropical storm to a super typhoon withinin 24 hours. After skirting Taiwan and turning northward, a significant track forecast error was observed after Typhoon Chanthu passed near the eastern coast of Taiwan without making landfall and turned northward. Most official forecasts and ensemble members predicted that Chanthu would make landfall in Shanghai. However, the typhoon remained offshore, lingered near Shanghai for several days before recurving northeastward toward Japan. Subsequent analyses reveals that a mid-level Northeast cold vortex merged with a trough near 150°E, which led to the intensification and southward extent of the trough. This synoptic feature remained quasi-stationary for several days, contributing to the forecast inaccuracy. Forecast models that failed to capture this interaction struggled to produce an accurate track forecast. Additionally, the subtropical high (SH) to the south of Chanthu played a critical role in steering its movement. Beyond environmental steering, the initial intensity and structure of the storm within the forecast models also had a significant influence on its subsequent evolution and interaction with surrounding environmental flow.},
 author = {Lichun Tang and Zifeng Yu and Qian Wang and Shangfeng Li},
 doi = {https://doi.org/10.1016/j.tcrr.2026.02.006},
 issn = {2225-6032},
 journal = {Tropical Cyclone Research and Review},
 title = {Track forecast error analysis for landfall of Chanthu under effects of a Northeast cold vortex in 2021},
 url = {https://www.sciencedirect.com/science/article/pii/S2225603226000172},
 year = {2026}
}
