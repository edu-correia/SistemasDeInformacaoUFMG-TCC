@inproceedings{4287523,
 abstract = {The heterogeneity of information raises several challenges for systems to search and retrieve information mutually. In the paper, a hybrid ontology integration framework is proposed. The implementation of the framework in distributed Xu Beihong's Galleries is discussed in detail. The emphasis is the mapping of local database schema and local ontology and the integration of local ontologies and global ontology. The experiments which involve simulated local museums in the lab of the Information Technology Institute of Beijing Union University of China prove the approach is efficient.},
 author = {Liang, Ye and Bao, Hong and Liu, Hongzhe},
 booktitle = {Eighth ACIS International Conference on Software Engineering, Artificial Intelligence, Networking, and Parallel/Distributed Computing (SNPD 2007)},
 doi = {10.1109/SNPD.2007.305},
 issn = {},
 keyword = {Ontologies;Information technology;Databases;Merging;Software engineering;Artificial intelligence;Distributed computing;Information retrieval;Educational institutions;Vocabulary},
 month = {July},
 number = {},
 pages = {309-314},
 title = {Hybrid Ontology Integration for Distributed System},
 volume = {1},
 year = {2007}
}
