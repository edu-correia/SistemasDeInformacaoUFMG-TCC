@article{WANG2026131871,
 abstract = {While expediting the flow of information, online social networks give rise to the risk of “information epidemics.” Current governance schemes hinge heavily on isolation, or truth diffusion to conquer this issue, but confront a dilemma of information competition and resource constraints in rumor dissemination. Constructing the SINIPRPm model, this study categorized users by their influence, and implemented an array of control strategies for different groups. It pioneered the incorporation of the heterogeneity of network structure, synergistic strategies, and cost constraints into one analysis paradigm. Merging intricate network theory and optimal control theory, this work puts forth a collaborative “isolation-refutation” governance method to downplay the role of rumors as much as possible, and dissects the stability conditions of the model’s rumor-free equilibrium. In pursuit of a refined trade-off between rumor suppression and control cost, an optimal synergistic impulse control model was constructed, leveraging Pontryagin’s principle to derive the necessary conditions for system optimality and the optimal control structure. Numerical simulations were undertaken to validate the theoretical results and the effectiveness of the synergistic strategy. The outcomes manifest commendable effectiveness for synergistically implementing isolation and refutation strategies to distinguishable groups of people. Notably, the refutation strategy for high-influence spreaders dramatically curbs rumors, and intensive synergistic control boasts dual benefits in governance effectiveness and cost control. Its core contribution is the “classified control-co-optimization-cost constraint” theoretical model, which reveals differentiated control paths and provides rigorous, feasible decision support for governing digital-era social risks.},
 author = {Chuanbiao Wang and Yang Hu and Mingyu Cui and Wentao Li and Yan Wang},
 doi = {https://doi.org/10.1016/j.eswa.2026.131871},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Rumor propagation, Synergistic impulse control, Differentiated control, Stability analysis, Cost optimization},
 pages = {131871},
 title = {Synergistic impulse control of network rumors and cost optimization based on differentiated user intervention},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417426007840},
 volume = {316},
 year = {2026}
}
