@conference{Che20201075,
 abstract = {In internet age, the interaction among people becomes more and more frequent. Therefore, the trust relationships between people are becoming more and more important. So it has become one of the hot spots in the research of multi-agent systems and trust path search. Trust network is established based on the transitivity of trust, and it is useful to use the network to evaluate the trust between two indirectly connected users on the reliable path. Aggregating trust of all possible trust paths can improve the accuracy of trust inference, so it is necessary to extend the problem of finding a single path to multiple trust paths. This paper mainly summarizes the study of trust path search and comprises four parts: the basic study of trust and trust network; some kinds of heuristic search algorithms including unidirectional and bidirectional searching for the shortest path, single-agent and multi-agent searching for multiple paths; the researches on path search based on trust; and the future directions of trust path search. © 2020 IEEE.},
 author = {Che, Jiaying and Tong, Xiangrong and Kong, Ru},
 doi = {10.1109/CISP-BMEI51763.2020.9263694},
 journal = {Proceedings - 2020 13th International Congress on Image and Signal Processing, BioMedical Engineering and Informatics, CISP-BMEI 2020},
 note = {Cited by: 2},
 pages = {1075 - 1080},
 publication_stage = {Final},
 source = {Scopus},
 title = {Intelligent trust path search},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85099540207?origin=resultslist},
 year = {2020}
}
