@article{López-Rubio20082085,
 abstract = {We present a nonparametric probability density estimation model. The classical Parzen window approach builds a spherical Gaussian density around every input sample. Our method has a first stage where hard neighborhoods are determined for every sample. Then soft clusters are considered to merge the information coming from several hard neighborhoods. Our proposal estimates the local principal directions to yield a specific Gaussian mixture component for each soft cluster. This leads to outperform other proposals where local parameter selection is not allowed and/or there are no smoothing strategies, like the manifold Parzen windows. © 2008 Elsevier B.V. All rights reserved.},
 author = {López-Rubio, Ezequiel and Ortiz-de-Lazcano-Lobato, Juan Miguel},
 doi = {10.1016/j.patrec.2008.07.010},
 journal = {Pattern Recognition Letters},
 note = {Cited by: 16},
 number = {16},
 pages = {2085 - 2091},
 publication_stage = {Final},
 source = {Scopus},
 title = {Soft clustering for nonparametric probability density function estimation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/53949088020?origin=resultslist},
 volume = {29},
 year = {2008}
}
