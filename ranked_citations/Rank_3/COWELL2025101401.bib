@article{COWELL2025101401,
 abstract = {Sequencing data elucidating adaptive immune receptor (AIR) repertoires, genomic loci encoding AIR genes, and AIR antigens are hosted in siloed repositories, limiting integrative analyses. We are in the process of creating the AIR Repertoire Knowledge Commons (AKC) by merging data from community-backed repositories and applying knowledge-generation algorithms to integrate and enrich data and metadata.},
 author = {Lindsay G. Cowell and Scott Christley and Felix Breden and Kevin A. Burns and Brian D. Corrie and William D. Lees and James A. Overton and Bjoern Peters and Eve Richardson and Krishna M. Roskin and Lonneke Scheffer and Randi Vita and Corey T. Watson and Gur Yaari},
 doi = {https://doi.org/10.1016/j.cels.2025.101401},
 issn = {2405-4712},
 journal = {Cell Systems},
 number = {9},
 pages = {101401},
 title = {The Adaptive Immune Receptor Repertoire Knowledge Commons: An invitation to the community},
 url = {https://www.sciencedirect.com/science/article/pii/S2405471225002340},
 volume = {16},
 year = {2025}
}
