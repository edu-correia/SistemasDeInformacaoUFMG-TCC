@inproceedings{6206465,
 abstract = {Different summation acceleration techniques exist that help in solving large scale problems where complex series appear. Most of these acceleration techniques have been implemented in algorithms for planar problems, however it is also possible to implement some of these techniques in the series summations appearing in the analysis of conformal antennas and curved frequency selective surfaces (FSS). This problem is discussed and several different techniques are considered. Finally, it is shown that an accurate and efficient program can be developed based on the merged spectral-domain method and appropriate acceleration method.},
 author = {Sipus, Zvonimir and Bosiljevac, Marko},
 booktitle = {2012 6th European Conference on Antennas and Propagation (EUCAP)},
 doi = {10.1109/EuCAP.2012.6206465},
 issn = {2164-3342},
 keyword = {Acceleration;Frequency selective surfaces;Spectral analysis;Algorithm design and analysis;Accuracy;Convergence;conformal antennas;curved frequency selective surfaces;acceleration methods;spectral-domain analysis},
 month = {March},
 number = {},
 pages = {216-219},
 title = {Acceleration of series summation encountered in the analysis of conformal antennas and periodic structures},
 volume = {},
 year = {2012}
}
