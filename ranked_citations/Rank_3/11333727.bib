@inproceedings{11333727,
 abstract = {An integrated learning-based model was developed for bias correction of geostationary satellite FY-4A Advanced Geostationary Imager infrared channel data. The results show that this bias correction significantly improves the accuracy of identifying top clouds, and especially excels in the ability to identify thin ice clouds in multi-layered clouds. We used the Cloud Profile Radar (CPR) and Orthogonally Polarised Cloud Aerosol Laser (CALIOP) merged cloud products from the first 20 days of September-December 2018 as reference labels and validated the model performance with a 10-day dataset after September-December of the same year. Compared to the FY-4A product, the corrected data improved detection of multilayer clouds by 8% and were more consistent with the CPR/CALIOP data. In addition, the corrected infrared channel data significantly enhanced the detection of optically thin cirrus clouds, which was not available with the original AGRI data.},
 author = {Yang, Chi and Liu, Xiaofang},
 booktitle = {2025 4th International Conference on Image Processing, Computer Vision and Machine Learning (ICICML)},
 doi = {10.1109/ICICML67980.2025.11333727},
 issn = {},
 keyword = {Deep learning;Accuracy;Laser radar;Clouds;Noise;Nonhomogeneous media;Data models;Ensemble learning;Random forests;Overfitting;FY-4A;multilayer cloud detection;data bias revision;integrated learning},
 month = {Nov},
 number = {},
 pages = {1035-1038},
 title = {Research on Multilayer Cloud Detection Method Based on Integrated Learning for Data Bias Revision},
 volume = {},
 year = {2025}
}
