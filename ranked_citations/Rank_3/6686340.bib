@inproceedings{6686340,
 abstract = {The Eventual consistency is a new type of database approach that has emerged in the field of NoSQL, which provides tremendous benefits over the traditional databases as it allows one to scale an application to new levels. The consistency models used by NoSQL database is explained in this paper. It elaborates how the eventually consistent data structure ensures consistency on storage system with multiple independent components which replicate data with loose coordination. The paper also discusses the eventually consistent model that ensures that all updates are applied in a consistent manner to all replicas.},
 author = {Tauro, Clarence and Easo, Aby and Mathew, Samson and N, Gnesan},
 booktitle = {2013 Third International Conference on Advances in Computing and Communications},
 doi = {10.1109/ICACC.2013.109},
 issn = {},
 keyword = {Radiation detectors;Registers;Data structures;Availability;Merging;Distributed databases;NoSQL; Eventual consistency models; Distributed system; Replicated Data Structures; CRDT; LWW Registers; MVR Registers},
 month = {Aug},
 number = {},
 pages = {70-75},
 title = {Convergent Replicated Data Structures that Tolerate Eventual Consistency in NoSQL Databases},
 volume = {},
 year = {2013}
}
