@conference{Özel2014399,
 abstract = {By fusing sensing technology, robotics and coding in unison with architectural form designed to move and reconfigure itself, a new kind of architecture that goes through a formal transformation in interaction with the user can be imagined and devised. Aiming to merge human presence with space through technology, this new architecture defines space as an extension of the human body and consciousness rather than one that regulates and controls it. Similar to terminology in the discipline of Artificial Intelligence, where human consciousness merges with computation, such a condition can be called Architectural Singularity, where architecture becomes the body rather than the host itself. Through historic examples, theoretical vantage points from art, architecture and media theory as well as built design experiments, this paper aims to problematize the conclusive notion of architectural form and agency. The user becomes architecture, code becomes form and robot becomes the user in continuous feedback loops. © 2014 ACADIA. All rights reserved.},
 author = {Özel, Güvenç},
 journal = {ACADIA 2014 - Design Agency: Proceedings of the 34th Annual Conference of the Association for Computer Aided Design in Architecture},
 note = {Cited by: 7},
 pages = {399 - 408},
 publication_stage = {Final},
 source = {Scopus},
 title = {Case for an architectural singularity synchronization of robotically actuated motion, sense-based interaction and computational inference},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85039820572?origin=resultslist},
 volume = {2014-October},
 year = {2014}
}
