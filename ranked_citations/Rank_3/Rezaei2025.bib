@article{Rezaei2025,
 abstract = {Pervasive QoS-aware service composition integrates services across dynamic environments as cloud computing, IoT, and crowdsourcing. As these platforms grow, so does the complexity of user needs, requiring the integration of multiple services to meet demands. This aggregation is essential for developing future ubiquitous applications and a more connected world. However, while services may share functional similarities, they often differ in non-functional attributes, particularly in Quality of Service (QoS), making QoS-aware service composition a significant challenge. Few studies have systematically addressed this issue. To bridge this gap, we conducted a Systematic Literature Review on QoS-enabled service composition in ubiquitous environments. This paper explores nine research questions covering challenges, frameworks, methodologies, applications, QoS parameters, tools, datasets, orientations, and evaluation methods, providing critical insights to support innovative solutions. © The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2025.},
 author = {Rezaei, Sara and Goli-Bidgoli, Salman},
 doi = {10.1007/s10586-025-05394-x},
 journal = {Cluster Computing},
 note = {Cited by: 1},
 number = {14},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Pervasive QoS-aware service composition: a systematic review},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105018459981?origin=resultslist},
 volume = {28},
 year = {2025}
}
