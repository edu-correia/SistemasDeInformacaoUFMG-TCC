@conference{Graffigna20105133,
 abstract = {This paper presents a method to detect 128 EEG electrodes in image study and to merge with the Nuclear Magnetic Resonance volume for better diagnosis. First we propose three hypotheses to define a specific acquisition protocol in order to recognize the electrodes and to avoid distortions in the image. In the second instance we describe a method for segmenting the electrodes. Finally, registration is performed between volume of the electrodes and NMR. © 2010 IEEE.},
 author = {Graffigna, Juan P. and Gómez, M. Eugenia and Bustos, José J.},
 doi = {10.1109/IEMBS.2010.5626176},
 journal = {2010 Annual International Conference of the IEEE Engineering in Medicine and Biology Society, EMBC'10},
 note = {Cited by: 2},
 pages = {5133 - 5136},
 publication_stage = {Final},
 source = {Scopus},
 title = {Detection of EEG electrodes in brain volumes},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78650833239?origin=resultslist},
 year = {2010}
