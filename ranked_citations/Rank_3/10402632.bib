@inproceedings{10402632,
 abstract = {Recent advancements in learning-based image compression methods have shown promising results. The success of these methods heavily relies on the entropy model, which predicts the probability distribution of the quantized latent representation of the image based on available knowledge. However, most existing entropy models follow an estimate-then-merge pipeline, leading to two potential issues: limited flexibility in modeling spatial context and inadequate fusion of different prior sources. In this paper, we propose a novel approach called the MergeThen-Estimate (MTE) entropy model. Our method addresses these issues by first uniformly merging available priors into a ’prior token’ using a Prior Embedding Module for each spatial location in the quantized latent representation. Next, we introduce a Content-aware Context Model to dynamically capture the dependencies of the currently coding representation on its neighboring available priors. Experiments on the Kodak dataset demonstrate the superiority of our proposed MTE entropy model.},
 author = {Shizhan, Liu},
 booktitle = {2023 IEEE International Conference on Visual Communications and Image Processing (VCIP)},
 doi = {10.1109/VCIP59821.2023.10402632},
 issn = {2642-9357},
 keyword = {Analytical models;Image coding;Visual communication;Entropy;Mathematical models;Probability distribution;Context modeling},
 month = {Dec},
 number = {},
 pages = {1-5},
 title = {MTE: Learned Image Compression with a Merge-Then-Estimate Entropy Model},
 volume = {},
 year = {2023}
}
