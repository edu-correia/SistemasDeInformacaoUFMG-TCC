@inproceedings{4553290,
 abstract = {In the spatial context, the research community has not reached yet a widely accepted definition of granularity. There are relatively few papers about "spatial granularities " and many of them give different definitions and often refer to different interpretations of the term "spatial granularity". In this work we propose a formal definition of "spatial granularity" and other related terms involved in the spatial context, as happened for the temporal one. After that, we will merge together our framework for spatial granularity with the usual framework for temporal granularity, giving a definition of spatio-temporal granularity able to manage information about spatial granularities changing over time.},
 author = {Belussi, Alberto and Combi, Carlo and Pozzani, Gabriele},
 booktitle = {2008 15th International Symposium on Temporal Representation and Reasoning},
 doi = {10.1109/TIME.2008.16},
 issn = {2332-6468},
 keyword = {Cities and towns;Computer science;Information management;Lattices;Spatial resolution;Lakes;Urban planning;History;Proposals;spatial granularity;spatio-temporal granularity},
 month = {June},
 number = {},
 pages = {49-53},
 title = {Towards a Formal Framework for Spatio-Temporal Granularities},
 volume = {},
 year = {2008}
}
