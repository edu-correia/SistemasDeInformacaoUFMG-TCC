@inproceedings{8769643,
 abstract = {This paper presents the control techniques used in a high-power-density electrolytic-free offline LED driver that utilizes a merged energy buffer for twice-line-frequency energy buffering. This LED driver comprises two stages: a four-switch buck-boost PFC stage and an LLC resonant dc-dc stage. The proposed control technique for the PFC stage utilizes a novel mode splitter to ensure a smooth buck-to-boost and vice versa mode transition. A feedforward control strategy is proposed for the dc-dc stage, which in conjunction with feedback control, ensures a well-regulated output voltage by mitigating undesirable spikes in it. A 150-W prototype LED driver utilizing a merged energy buffer is tested with the proposed control techniques. This GaN-based prototype achieves a high power density of 50 W/inch3 while replacing electrolytic capacitors with low-energy-density ceramic capacitors.},
 author = {Khatua, Mausamjeet and Pervaiz, Saad and Afridi, Khurram K.},
 booktitle = {2019 20th Workshop on Control and Modeling for Power Electronics (COMPEL)},
 doi = {10.1109/COMPEL.2019.8769643},
 issn = {1093-5142},
 keyword = {Voltage control;Light emitting diodes;Capacitors;Prototypes;Ceramics;Feedback control;Voltage measurement;LED driver;merged energy buffer;power factor correction;four-switch buck-boost;LLC resonant converter;feedback control;feedforward control;mode splitter},
 month = {June},
 number = {},
 pages = {1-6},
 title = {Control of a Merged-Energy-Buffer based Two-Stage Electrolytic-Free Offline LED Driver},
 volume = {},
 year = {2019}
}
