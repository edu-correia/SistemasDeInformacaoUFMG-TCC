@inproceedings{10548671,
 abstract = {In the realm of computational geometry and data management, the efficient maintenance of a dynamic set of disjoint line segments is a critical requirement for various applications, such as the activity selection problem and other scheduling tasks. We introduce two novel methods for online maintenance of disjoint line segments, focusing on the rapid identification and summarization of intersecting segments, as well as the insertion and removal of activities within a set. The methods presented in this paper facilitate the following operations: quickly identifying all intersecting segments and summarizing their attributes (e.g., count, weight), and, if required, removing them to accommodate the insertion of a new segment. Assuming a set size of $n$ and a subset size of $\boldsymbol{w}$ for intersecting line segments. Utilizing standard library data structures like the set from C++ STL, a time complexity of $\boldsymbol{O(wlogn)}$ is achieved for these operations. By implementing a self-balancing binary search tree, such as a treap, the time complexity for these operations is further reduced to $\boldsymbol{O(logn)}$ .},
 author = {Zheng, Yuanxing and Song, Lihua},
 booktitle = {2024 7th International Conference on Advanced Algorithms and Control Engineering (ICAACE)},
 doi = {10.1109/ICAACE61206.2024.10548671},
 issn = {},
 keyword = {Processor scheduling;Binary search trees;Dynamic scheduling;Data structures;Search problems;Libraries;Maintenance;online algorithm;C++;binary search tree;treap;binary relation;strict partial ordering},
 month = {March},
 number = {},
 pages = {493-496},
 title = {Online Maintenance of Disjoint Line Segment Sets Utilizing Treap and Strict partial Ordering Theory},
 volume = {},
 year = {2024}
}
