@conference{Kokol2008267,
 abstract = {Early and accurate diagnosing of various diseases has proved to be of vital importance in many health care processes. In recent years intelligent systems have been often used for decision support and classification in many scientific and engineering disciplines including health care. However, in many cases the proposed treatment, prediction or diagnose can differ from one intelligent system to another, similar to the real world where different medical specialists may have different opinions. Indeed, in real world specialists' opinions complement one another and when integrated they usually form a better solution. Our novel idea presented in this paper is to mimic this real world situation in the manner to merge different opinions generated by different intelligent systems using the self organizing abilities of cellular automata. We empirically show that classification cellular automata combining many various methods for classifier construction eventually outperforms single classifiers and conventional integration methods in terms of accuracy and class accuracy. © 2008 IEEE.},
 author = {Kokol, Peter and Povalej, Petra and Stiglic, Gregor and Dinevski, Dejan},
 doi = {10.1109/iscid.2008.212},
 journal = {Proceedings of the 2008 International Symposium on Computational Intelligence and Design, ISCID 2008},
 note = {Cited by: 1; All Open Access; Green Open Access},
 pages = {267 - 270},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improving medical decision making by self organizing intelligent systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/61349196804?origin=resultslist},
 volume = {2},
 year = {2008}
}
