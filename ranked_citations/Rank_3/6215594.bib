@inproceedings{6215594,
 abstract = {Traditionally, real-time systems managed data in application dependent structures. As real-time systems evolved, applications became more complex and required access to more data which are being provided by data base management systems. Currently, there has been interest in merging database and real-time technology. The resulting integrated system, which provides database related operations with real-time constraints, is generally called a real-time database system. On the other hand, the databases which change over time are known as temporal databases. Incorporating trust in various real-time and temporal database operations form the core of this paper.},
 author = {Saha, Shatabdi and Setua, S.K.},
 booktitle = {IEEE-International Conference On Advances In Engineering, Science And Management (ICAESM -2012)},
 doi = {},
 issn = {},
 keyword = {Databases;Real time systems;Merging;Business;Engines;Computers;Real-time Database System;Temporal Database;Relational Algebra;Temporal Algebra Operators;Trust Algebra Operators},
 month = {March},
 number = {},
 pages = {177-181},
 title = {Extending trust in time dependent database systems},
 volume = {},
 year = {2012}
}
