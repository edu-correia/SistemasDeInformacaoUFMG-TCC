@conference{Chen2012,
 abstract = {This paper reports a novel monolithic lab-on-a-chip (LOC) with an electrochemical system embedded in an electrowetting on dielectric (EWOD) microfluidic device for the first time. The fabrication process is compatible with IC technology. This chip could not only merge and transport droplets successfully, but show good electrochemical responses of glucose and glucose oxidase with the sensitivity of 0.028mA/mM and the statistic adjust R-square of 0.9549. © 2012 IEEE.},
 author = {Chen, Jianfeng and Yu, Yuhua and Yang, Sheng and Fan, Shih-Kang and Zhou, Jia},
 doi = {10.1109/ICSICT.2012.6467957},
 journal = {ICSICT 2012 - 2012 IEEE 11th International Conference on Solid-State and Integrated Circuit Technology, Proceedings},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A monolithic lab-on-a-chip for electrochemical detection},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84874817924?origin=resultslist},
 year = {2012}
