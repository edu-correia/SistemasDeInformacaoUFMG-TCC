@inproceedings{5193979,
 abstract = {Measuring the inconsistency degree of an ontology is an important topic in ontology engineering as it can provide extra information for dealing with inconsistency. In this paper, we propose an approach to measuring inconsistency in a DL-Lite ontology and simply point out the useless of inconsistency degree. We first define three-valued semantics for DL-Lite, then through using three-valued semantics, we get a definition of the inconsistency degree for a DL-Lite ontology. The inconsistency degree about an ontology that we obtain is only one value, which is very suitable for application compared to existing inconsistency degree which is an infinite sequence.},
 author = {Zhou, Liping and Huang, Houkuan and Qu, Youli and Zhao, Xiang},
 booktitle = {2009 International Joint Conference on Computational Sciences and Optimization},
 doi = {10.1109/CSO.2009.39},
 issn = {},
 keyword = {Ontologies;Automatic logic units;Atomic measurements;Artificial intelligence;Merging;Proposals;Semantic Web;Debugging;Information analysis;Current measurement;measuring inconsistency degree;dl-lite;ontologies},
 month = {April},
 number = {},
 pages = {391-395},
 title = {An Approach to Measuring Inconsistency for DL-Lite Ontologies},
 volume = {2},
 year = {2009}
}
