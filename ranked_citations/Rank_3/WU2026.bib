@article{WU2026,
 abstract = {This study developed a personalized task recommendation model for addressing the high specialization and operational complexity of user-uploaded observation tasks in large-scale satellite swarm. This model accurately predicts user requirements and enables one-click uploading of observation tasks, allowing users to effectively participate in satellite swarm task planning. The proposed model determines user requirements and preferences through knowledge profiling and then identifies reasonable Earth observation tasks through task-resource-aware analysis. Massive user-generated Earth observation task databases are analyzed to derive dynamic user preferences. The proposed model considers the operational capacity and current task loads of individual satellites in large scale swarm and uses a knowledge graph to generate application requirements. When generating recommendations, this model accounts for the dynamic temporal and spatial characteristics of satellites as well as the correlation between constraints related to the user demand timing and the satellite swarm task sequence; this thus enables the merging of user requirements and the elimination of conflicts. Consequently, the model can generate optimized task requirements, thereby increasing the precision and efficiency of task planning.},
 author = {Xiande Wu and Ruochu Yang and Dakai Liu and Xinzhu Sun},
 doi = {https://doi.org/10.1016/j.asr.2026.03.001},
 issn = {0273-1177},
 journal = {Advances in Space Research},
 keyword = {Entropy method, Inference of user preferences, Knowledge graph, Satellite swarm, Task recommendation},
 title = {Personalized task recommendation model based on knowledge graph and behavior inference for satellite swarm},
 url = {https://www.sciencedirect.com/science/article/pii/S027311772600311X},
 year = {2026}
}
