 issn = {},
 keyword = {Magnetic resonance imaging;Instruments;Discrete wavelet transforms;Medical diagnosis;Single photon emission computed tomography;Positron emission tomography;Medical diagnostic imaging;Computed Tomography (CT);Magnetic Resonance Imaging(MRI);2-Dimensional DWT;Mutual Information (MI)},
 month = {June},
 number = {},
 pages = {1690-1696},
 title = {MRI and Spect Medical Image Fusion using Wavelet Transform},
