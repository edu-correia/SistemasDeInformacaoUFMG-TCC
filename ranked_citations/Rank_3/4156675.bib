@inproceedings{4156675,
 abstract = {The new video coding standard MPEG-4 is enabling content-based functionalities as well as high coding efficiency considering shape information of moving objects. This paper presents a technique for detecting moving objects in a video. This technique consists of three stages-motion estimation, spatial segmentation and motion based region merging. Experimental results using traffic video sequence is presented to demonstrate the accuracy of our proposed algorithm},
 author = {Chandra, M. Dinesh and Kavitha, G.},
 booktitle = {2007 International Conference on Signal Processing, Communications and Networking},
 doi = {10.1109/ICSCN.2007.350654},
 issn = {},
 keyword = {Object detection;Motion estimation;Image segmentation;Video sequences;PSNR;Merging;Partitioning algorithms;Video coding;MPEG 4 Standard;Shape},
 month = {Feb},
 number = {},
 pages = {518-520},
 title = {A Novel and Fast Algorithm to Detect Moving Objects for Content Based Applications},
 volume = {},
 year = {2007}
}
