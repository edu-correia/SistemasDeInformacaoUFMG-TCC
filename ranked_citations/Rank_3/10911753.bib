@inproceedings{10911753,
 abstract = {As the digital era progresses, innovative paradigms are transforming traditional methods of compensation and collaboration. One such paradigm, "Coding: Where Bug Pays Bill," harnesses blockchain technology to ensure fair and transparent compensation for project contributions. This paper explores the potential of blockchain to revolutionize project compensation systems. Effective compensation management involves developing and implementing strategies that fairly and equitably reward individuals, reflecting their value to the organization. This includes establishing a comprehensive compensation structure that covers pay policies, payroll administration, and a holistic reward system incorporating minimum wage and collective incentives. Similarly, offering monetary rewards to students can significantly enhance their study habits and academic performance. We propose creating a platform where students can improve their skills and study diligently by completing tasks and earning rewards. Our primary aim is to increase students' motivation to learn and boost their productivity through this incentivized approach.},
 author = {Garg, Kanika and Bhushan, Shashi and Sharmila, Dr. and Tyagi, Priyanka and Bansal, Abhinav and Sharma, Vaibhav},
 booktitle = {2024 4th International Conference on Advancement in Electronics & Communication Engineering (AECE)},
 doi = {10.1109/AECE62803.2024.10911753},
