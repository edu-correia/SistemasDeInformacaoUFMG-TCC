@inproceedings{11196298,
 abstract = {Efficient and accurate UAV-LiDAR DBH acquisition in closed-canopy, weak-GPS forests is vital, but traditional paths struggle to balance point cloud quality and efficiency. This study introduces a ROS-based autonomous UAV with a novel waypoint planning method: circular scanning around target trees combined with an adjustable waypoint merging strategy to optimize trunk coverage and flight efficiency. Experiments (1-10m merge thresholds) showed the method achieved high-quality point clouds (min. DBH RMSE 3.24 cm). Optimized merging (e.g., 1-4m) significantly reduced flight time (by up to 70%) while maintaining high accuracy, demonstrating an effective and optimizable trade-off between acquisition efficiency and data quality. The proposed method offers a flexible solution and practical guidelines for achieving a user-defined balance between speed and precision for DBH acquisition in such environments.},
 author = {Xie, Shaoqiang and Li, Mengyao and Chen, Haoxuan and Shen, Suiyuan and Chen, Yu and Li, Jiyu},
 booktitle = {2025 30th International Conference on Automation and Computing (ICAC)},
 doi = {10.1109/ICAC65379.2025.11196298},
 issn = {},
 keyword = {Point cloud compression;Surveys;Forests;Accuracy;Data integrity;Merging;Autonomous aerial vehicles;Robot sensing systems;Path planning;Planning;Unmanned Aerial Vehicle (UAV);LiDAR;Point Cloud Processing;Tree DBH (Diameter at Breast Height);Waypoint Planning},
 month = {Aug},
 number = {},
 pages = {1-6},
 title = {A Rapid UAV-LiDAR Method for DBH Acquisition in Closed-Canopy Forests Based on Optimized Path Planning},
 volume = {},
 year = {2025}
}
