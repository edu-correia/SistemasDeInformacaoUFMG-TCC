@article{Sandhu2025296,
 abstract = {This study introduces a novel method for detecting and visualizing temporal trends in topics, moving beyond traditional stochastic counting to illustrate both the significance and directional movement of topics as defined by subtopics within the corpus. Utilizing k-means clustering and cosine similarity (derived from word embeddings in a vector space), this method maps the convergence or divergence of topic clusters over time. Furthermore, when applied to a diverse corpus that includes media articles from our dataset, our approach uncovers how topics merge or become distinct within a text corpus by analyzing the convergence and divergence of embeddings in a vector space, providing deep insights into public discourse and information flow during major global events. This methodology not only enhances understanding of health-related topics like COVID-19-capturing public sentiment and the dynamics of information dissemination-but also shows promise for broader applications across various general topics, offering a powerful tool for analyzing temporal topic evolution in any given field. © ICST Institute for Computer Sciences, Social Informatics and Telecommunications Engineering 2025.},
 author = {Sandhu, Angad and Narayan, Vishesh and Wajid, Faizan and Agrawala, Ashok},
 doi = {10.1007/978-3-031-85572-6_19},
 journal = {Lecture Notes of the Institute for Computer Sciences, Social-Informatics and Telecommunications Engineering, LNICST},
 note = {Cited by: 0},
 pages = {296 - 307},
 publication_stage = {Final},
 source = {Scopus},
 title = {Temporal Analysis on Topics Using Word2Vec: Insights from Health and Sports News},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105003904143?origin=resultslist},
 volume = {611 LNICST},
 year = {2025}
}
