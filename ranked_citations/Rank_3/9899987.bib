@inproceedings{9899987,
 abstract = {A D-band Substrate Integrated Waveguide (SIW) fed Dielectric Resonator Antenna (DRA) is proposed. The dielectric resonator (DR) is designed to operate in higher order modes. Impedance matching techniques are used to merge these resonance modes to increase the bandwidth of the antenna. Simulation results show that the antenna exhibits a-10 dB impedance bandwidth between 138.27GHz and 150.95GHz, equivalent to 9%. The proposed antenna has a maximum gain of 8.79dBi and a radiation efficiency of 81%.},
 author = {Chemweno, Emmanuel K and Kumar, Pradeep and Afullo, Thomas J. O.},
 booktitle = {2022 International Conference on Electromagnetics in Advanced Applications (ICEAA)},
 doi = {10.1109/ICEAA49419.2022.9899987},
 issn = {},
 keyword = {Structural rings;Simulation;Impedance matching;Resonant frequency;Electromagnetic waveguides;Bandwidth;Dielectric resonator antennas;Dielectric Resonator Antenna (DRA);Substrate Integrated Waveguide (SIW)},
 month = {Sep.},
 number = {},
 pages = {302-305},
 title = {Bandwidth Enhancement of a Substrate Integrated Waveguide Dielectric Resonator Antenna using Metallic Shorting Vias},
 volume = {},
 year = {2022}
}
