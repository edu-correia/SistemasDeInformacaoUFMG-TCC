@article{6327696,
 abstract = {For a test set that consists of test cubes (incompletely specified tests), test compaction can be achieved by merging pairs of compatible tests (tests that do not conflict in any of their specified values). This paper describes a test compaction procedure that enhances the ability of test-merging to reduce the number of tests in an incompletely specified test set that consists of both broadside and skewed-load tests for transition faults. In a basic step, the procedure attempts to remove a test t by combining it with several other tests, even if the tests are not compatible or have different types. This increases the possibility that all the faults detected by t will be detected by other tests, and t will be removed. Simulation results demonstrate reductions in numbers of tests beyond those achieved by test-merging with the same or lower numbers of specified values.},
 author = {Pomeranz, Irith},
 doi = {10.1109/TVLSI.2012.2217360},
 issn = {1557-9999},
 journal = {IEEE Transactions on Very Large Scale Integration (VLSI) Systems},
 keyword = {Compaction;Circuit faults;Merging;Fault detection;Vectors;Test data compression;Runtime;Broadside tests;skewed-load tests;static test compaction;test cubes;transition faults},
 month = {Sep.},
 number = {9},
 pages = {1705-1714},
 title = {On Test Compaction of Broadside and Skewed-Load Test Cubes},
 volume = {21},
 year = {2013}
}
