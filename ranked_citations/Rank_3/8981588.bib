@inproceedings{8981588,
 abstract = {Representing a scanned map of the real environment as a topological structure is an important research topic in robotics. Since topological representations of maps save a huge amount of map storage space and online computing time, they are widely used in fields such as path planning, map matching, and semantic mapping. We use a topological map representation, the Area Graph, in which the vertices represent areas and edges represent passages. The Area Graph is developed from a pruned Voronoi Graph, the Topology Graph. We also employ a simple room detection algorithm to compensate the fact that the Voronoi Graph gets unstable in open areas. We claim that our area segmentation method is superior to state-of-the-art approaches in complex indoor environments and support this claim with a number of experiments.},
 author = {Hou, Jiawei and Yuan, Yijun and Schwertfeger, Sören},
 booktitle = {2019 19th International Conference on Advanced Robotics (ICAR)},
 doi = {10.1109/ICAR46387.2019.8981588},
 issn = {},
 keyword = {Location awareness;Three-dimensional displays;Image edge detection;Semantics;Merging;Path planning;Topology;Indoor environment;Detection algorithms;Robots},
 month = {Dec},
 number = {},
 pages = {509-515},
 title = {Area Graph: Generation of Topological Maps using the Voronoi Diagram},
 volume = {},
 year = {2019}
}
