@inproceedings{10466108,
 abstract = {The increased fatality rates in the past few years have brought pediatric pneumonia to widespread attention. Chest X-rays are a frequently used method for diagnosing paediatric pneumonia since they are non-intrusive and inexpensive. However, efficient identification is difficult because to the minimal radiation exposure required for paediatric assessment. To identify and categories paediatric pneumonia using X-ray pictures, a reliable computer-aided diagnostic model is required in response to this issue. The purpose of this study is to compare the effectiveness of solo and group learning methods for diagnosing pediatric pneumonia. The ensembles employed rely primarily on (InceptionV3, ResNet-50, and VGG16) fine-tuned variations. Authors employed a dataset of 5856 chest X-ray scans, in to conduct extensive research. As a consequence, for the base model, we discovered that ResNet50 has the best accuracy of 82.21% amongst the three base models. Furthermore, the ensemble model outperformed with an accuracy of 84.46%.},
 author = {Arya, Vaishali and Kumar, Tapas},
 booktitle = {2023 International Conference on Advances in Computation, Communication and Information Technology (ICAICCIT)},
 doi = {10.1109/ICAICCIT60255.2023.10466108},
 issn = {},
 keyword = {Training;Pediatrics;Pneumonia;Computational modeling;Merging;Medical services;Reliability;chest X-ray;classification;diagnosis;ensemble classifier;pediatric pneumonia},
 month = {Nov},
 number = {},
 pages = {1340-1345},
 title = {Ensemble Classifier for Pediatric Pneumonia Diagnosis in Chest X-Ray Images},
 volume = {},
 year = {2023}
}
