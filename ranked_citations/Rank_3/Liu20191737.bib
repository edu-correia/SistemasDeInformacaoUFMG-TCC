@article{Liu20191737,
 abstract = {Automatic video summarization, which is a typical cognitive-inspired task and attempts to select a small set of the most representative images or video clips for a specific video sequence, is therefore vital for enabling many tasks. In this work, we develop an interactive Non-negative Matrix Factorization (NMF) method for representative action video discovery. The original video is first evenly segmented into short clips, and the bag-of-words model is used to describe each clip. A temporally consistent NMF model is subsequently used for clustering and action segmentation. Because the clustering and segmentation results may not satisfy user intention, the user-controlled operations MERGE and ADD are developed to permit the user to adjust the results in line with expectations. The newly developed interactive NMF method can therefore generate personalized results.Experimental results on the public Weizman dataset demonstrate that our approach provides satisfactory action discovery and segmentation results. © 2018, Springer Science+Business Media, LLC, part of Springer Nature.},
 author = {Liu, Huaping and Sun, Fuchun and Zhang, Xinyu and Fang, Bin},
 doi = {10.1007/s11042-018-6305-x},
 journal = {Multimedia Tools and Applications},
 note = {Cited by: 3},
 number = {2},
 pages = {1737 - 1755},
 publication_stage = {Final},
 source = {Scopus},
 title = {Interactive video summarization with human intentions},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85049205860?origin=resultslist},
 volume = {78},
 year = {2019}
}
