@inproceedings{10112690,
 abstract = {Recently, digital image processing techniques have been greatly used in medical applications. Using an image fusion technology built on FPGA, this study analyses medical pictures to find distinct aspects and for clinical diagnostics, Computed Tomography (CT) gives the best information on denser tissue with less defacement. With Magnetic Resonance Imaging (MRI), soft tissue details are both more accurate and distorted. In clinical applications, combining images from multiple equipment has become essential. Image fusion with Effective feature modification of the image was achieved by using the maximum selection fusion method with PCA. The research' findings show that the technique is capable of obtaining crisp images by extracting crucial data from combined photos. Images are transformed into pixel-format files and simulation results are observed using MATLAB. The merged images must be viewed with XPS and VB. When compared to DWT, feature extraction in PCA-based image fusion is remarkable. When compared to DWT architecture, which was implemented on the FPGA, the Quality metrics of PCA have increased by up to 11.7%.},
 author = {Vidyadhar, R. Phani and Mahalakshmi, Bellamkonda and Kethan, Goundla Sai and Deepak, Kommana},
 booktitle = {2023 9th International Conference on Advanced Computing and Communication Systems (ICACCS)},
 doi = {10.1109/ICACCS57279.2023.10112690},
 issn = {2575-7288},
 keyword = {Measurement;Magnetic resonance imaging;Computed tomography;Computer architecture;Feature extraction;Discrete wavelet transforms;Image fusion;DWT;PCA;CT;MRI;XPS;and VB},
 month = {March},
 number = {},
 pages = {1083-1087},
 title = {FPGA Implementation of Medical Image Fusion using PCA},
 volume = {1},
 year = {2023}
}
