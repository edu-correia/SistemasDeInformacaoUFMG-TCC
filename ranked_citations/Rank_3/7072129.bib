@inproceedings{7072129,
 abstract = {This paper presents a class of perfect-reconstruction (PR) nonuniform cosine-modulated filter-banks (CMFBs) with dynamic recombination, which based on a two-stage structured nonuniform filter-bank (FB). By dynamically merging consecutive subbands in an original uniform FB with pre-designed transmultiplexers (TMUXs) having different numbers of channels, PR nonuniform FBs with adjustable time-frequency resolution can be obtained. In particular, we emphasize the issue of the PR recombination nonuniform FB when the coprime condition on the numbers of channels in the original FB and the recombination TMUX does not hold. A new optimization criterion is proposed to handle the case. Finally, detailed design procedure and example are shown to illustrate this method.},
 author = {Xie, X. M. and Chan, S. C. and Yuk, T. I.},
 booktitle = {2002 11th European Signal Processing Conference},
 doi = {},
 issn = {2219-5491},
 keyword = {Abstracts;Complexity theory;Matched filters;Optimization},
 month = {Sep.},
 number = {},
 pages = {1-4},
 title = {A class of perfect-reconstruction nonuniform cosinemodulated filter-banks with dynamic recombination},
 volume = {},
 year = {2002}
}
