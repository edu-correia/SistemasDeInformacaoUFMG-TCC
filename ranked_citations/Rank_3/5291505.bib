@inproceedings{5291505,
 abstract = {Piezoelectric materials are widely used for many applications such as sensors, actuators. Today, their integration in microelectronics processes like CMOS requires the development of advanced realistic behavioral models. Until now, these models were limited to only one ceramic's operation mode, i.e., thickness or planar. Moreover, the robustness of piezo-electronic systems cannot be adequately addressed as long as models are not improved in particular by taking into account further real phenomena. This article proposes to merge, in a new KLM model, the two operation modes. It is demonstrated that the behavior of the proposed model is in very good agreement with the real ceramic behavior.},
 author = {Galliere, Jean-Marc and Latorre, Laurent and Papet, Philippe},
 booktitle = {2009 Second International Conference on Advances in Circuits, Electronics and Micro-electronics},
 doi = {10.1109/CENICS.2009.12},
 issn = {},
 keyword = {Piezoelectric transducers;Mathematical model;Ceramics;Semiconductor device modeling;Robustness;Computer languages;Design engineering;Process design;Power system modeling;Equivalent circuits;Piezoelectric Transducers;KLM Model;Thickness and Planar Mode},
 month = {Oct},
 number = {},
 pages = {40-43},
 title = {A 2-D KLM Model for Disk-Shape Piezoelectric Transducers},
 volume = {},
 year = {2009}
}
