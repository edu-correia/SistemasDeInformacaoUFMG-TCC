@conference{Zech2025719,
 abstract = {Simulation models are essential in modern engineering and system design, facilitating comprehensive analysis and forecasting of system behavior across the system life cycle. Nonetheless, the construction, evolution, and management of these models pose issues, particularly regarding the model's engineering along the system's life cycle. This paper presents a theoretical framework for life cycle engineering of simulation models. The suggested framework combines model-driven engineering (MDE) principles with life cycle management, offering a systematic approach to the management, evolution, maintenance, and reuse of simulation models. We examine the theoretical foundations, essential elements, and practical ramifications, aiming to promote a more systematic methodology for the life cycle engineering of simulation models. A practical application to the popular DEVS formalism using DEVSLang demonstrates the framework's feasibility and showcases its efficacy in a real-world context. © 2025 Society for Modeling & Simulation International (SCS)},
 author = {Zech, Philipp and Vangheluwe, Hans and Breu, Ruth},
 journal = {Simulation Series},
 note = {Cited by: 0},
 number = {1},
 pages = {719 - 731},
 publication_stage = {Final},
 source = {Scopus},
 title = {A THEORETICAL FRAMEWORK FOR MODEL-BASED LIFE CYCLE ENGINEERING OF SIMULATION MODELS},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105020862514?origin=resultslist},
 volume = {57},
 year = {2025}
}
