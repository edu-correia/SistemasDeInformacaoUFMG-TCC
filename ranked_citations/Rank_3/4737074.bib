@inproceedings{4737074,
 abstract = {Ontology merging and integration is a collaborative process. We overcome the traditional integration approaches and propose bridge ontology architecture to cope with representational heterogeneity among ontologies for interoperability. It handles all the possible complications of relationships among the ontologies during matching and mapping phases. Proposed architecture accommodates class-based, relation-based, instances-based, and composite-based mapping. We also propose an approach to prioritize the relationships to improve the performance during mapping process. Proposed architecture is a generic solution and can be used to interoperate ontologies as a standard.},
 author = {Safyan, Muhammad and Khan, Sharifullah and Latif, Khalid and Masood, Asad},
 booktitle = {2008 International Conference on Advanced Computer Theory and Engineering},
 doi = {10.1109/ICACTE.2008.212},
 issn = {2154-7505},
 keyword = {Ontologies;Bridges;Computer science;Appropriate technology;Aggregates;Merging;Collaborative work;Robustness;Ontologies;Interoperabiltiy;Query Reformulation},
 month = {Dec},
 number = {},
 pages = {832-836},
 title = {Bridging Hierarchical Ontologies for Interoperability and Query Reformulation},
 volume = {},
 year = {2008}
}
