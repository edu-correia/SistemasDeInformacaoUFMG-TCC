@inproceedings{9860108,
 abstract = {Detecting differences between two business process models is essential for business process improvement. Most existing work on detecting business process differences are limited in the following ways: (1) They focus on the different components while ignoring the common components when comparing two process models, thus can not provide a comprehensive under-standing of two process models. (2) The graph edit distance based differences are difficult for process analysts to interpret and understand. To address these issues, this paper proposes a business process difference detection and interpretation method based on the common key structure. Given two business process models, they are first converted to corresponding task-based process structure trees (TPSTs). Then the P,Q-Grams, a set of excerpts used to summarize a TPST, are respectively extracted from two TPSTs to show the partial structure and behavior of the process models. Next, the mapped P,Q-Grams in two TPSTs are determined and merged to construct the common key structure of the two TPSTs. Finally, the differences are detected by comparing two TPSTs with their common key structure, and a sequence of edit operations with natural language interpretation is used to describe the differences. The experimental evaluation in terms of accuracy and efficiency is conducted, and the results show that the proposed method can achieve higher accuracy than the benchmark method.},
 author = {Wang, Jiaxing and Zhao, Ying and Zhou, Wuyuan and Yang, Xusheng},
 booktitle = {2022 IEEE International Conference on Services Computing (SCC)},
 doi = {10.1109/SCC55611.2022.00037},
 issn = {2474-2473},
 keyword = {Analytical models;Natural languages;Service computing;Benchmark testing;Feature extraction;Behavioral sciences;Task analysis;Business process management;process difference detection;difference translation;common key structure},
 month = {July},
 number = {},
 pages = {185-195},
 title = {PQ-Diff: A Business Process Difference Detection and Interpretation Method based on the Common Key Structure},
 volume = {},
 year = {2022}
}
