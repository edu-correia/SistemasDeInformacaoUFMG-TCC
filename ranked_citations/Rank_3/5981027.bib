@inproceedings{5981027,
 abstract = {This paper presents a regional citrus pest forecasting and decision-making system established on Internet supported by Ontology, Expert System (ES), and Geographic Information Systems (GIS). The system adopted ontology to represent knowledge. The terrain data, weather data and pests damage information were interpreted with and merged into ontology. The expert system made a prediction about pests occurrence in a long-term or short-term period, as same as proposed some reasonable control measures. The visual results as a digital map for users were created and displayed using GIS. Purposes of the establishment of the system were to improve the regional citrus pests management, reduce environmental and economic burden, and enhance the efficiency of pests control.},
 author = {Duan, Rujie and Wang, Shanqin and Zhang, Hongyu and Yang, Zhiqiao},
 booktitle = {2011 19th International Conference on Geoinformatics},
 doi = {10.1109/GeoInformatics.2011.5981027},
 issn = {2161-0258},
 keyword = {Ontologies;Forecasting;Expert systems;Geographic Information Systems;Internet;Meteorology;Semantics;Pest Forecast;Ontology;Geographic Information System (GIS);Expert System (ES);Ontology reasonin},
 month = {June},
 number = {},
 pages = {1-4},
 title = {Citrus pest forecasting and decision-making system base on geo-ontology},
 volume = {},
