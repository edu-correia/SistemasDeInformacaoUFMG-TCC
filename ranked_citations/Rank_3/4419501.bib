@inproceedings{4419501,
 abstract = {System validation allows to check whether the modeled system complies with the customer requirements. For UML modeling, these requirements can be specified as invariants using the object constraint language (OCL). OCL is an extension of the UML notation for the expression of restrictions over the diagrams. To validate OCL invariants, we develop an approach based on Petri nets and temporal logics. This approach allows the non trivial integration of the temporal logic properties translated from the OCL invariants with the Petri nets derived from the UML 2.0 activity partitions. A case study is given throughout the paper to illustrate the approach.},
 author = {Bouabana-Tebibel, T.},
 booktitle = {2007 IEEE International Conference on Industrial Engineering and Engineering Management},
 doi = {10.1109/IEEM.2007.4419501},
 issn = {2157-362X},
 keyword = {Unified modeling language;Petri nets;Computer science;Formal verification;Costs;Automatic logic units;Merging},
 month = {Dec},
 number = {},
 pages = {1792-1796},
 title = {Language integration for model validation},
 volume = {},
 year = {2007}
}
