@inproceedings{11346109,
 abstract = {We present an emotion-aware multimodal medical chatbot that will help provide medical assistance based on symptoms, using contextual memory and natural dialogue. Under the system, users are free to speak using a microphone or simply type in the Streamlit interface. In speech, audio will be captured using the sound device module and chopped into manageable segments and encoded using the Whisper model of OpenAI. BioBERT is applied with Named Entity Recognition (NER) to extract the symptom so that the medical and emotional intent of the user can be detected, and BioBERT GoEmotionsEkman is applied to classify emotional states using the core emotions taxonomy of Ekman. The chatbot is conversational and contextually sound through LangChain Runnable with Message History, and persistent and pseudonymized storage is stored at SQLite. Long and short interaction is scaled on context summarization and dynamic retrieval, and the processes are merged into a structured prompt and inputted to a fine-tuned BART encoder-decoder model. The MedDialogues dataset is first transformed to the medical domain with BART, and then further training on empathy with the EmpatheticDialogues dataset is performed. The model yields answers that are clinically correct, context and context-sensitive answers in a human-like flow of conversation. Any contact, including all the signs and symptoms distinguished, emotions, and responses of any nature, is safely documented to promote enhancement. An integrative model of privacy-aware, caring, and smart communication in the domain of digital healthcare is demonstrated in this architecture.},
 author = {Kavudamalya, R and Nithish Kumar, J and Mathiarasi, B.},
 booktitle = {2025 10th International Conference on Smart Structures and Systems (ICSSS)},
 doi = {10.1109/ICSSS66939.2025.11346109},
 issn = {},
 keyword = {Training;Biological system modeling;Taxonomy;Oral communication;Named entity recognition;Chatbots;Intelligent structures;History;Context modeling;Microphones;BioBERT;BERT GoEmotions;BART;LangChain;Medical Chatbot;Contextual Memory;Multimodal Dialogue;Symptom Detection;Healthcare NLP},
 month = {Dec},
 number = {},
 pages = {1-7},
 title = {Emotion-Aware Multimodal Healthcare Chatbot with Contextual Memory and Symptom-Based Assistance},
 volume = {},
 year = {2025}
}
