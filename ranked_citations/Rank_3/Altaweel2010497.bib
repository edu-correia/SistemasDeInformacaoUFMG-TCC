@article{Altaweel2010497,
 abstract = {As anthropogenic and environmental behaviors rapidly evolve many ecosystems and communities, managers of natural resources, scientists, and other stakeholders increasingly need tools that can rapidly alert them to emerging events that can affect social well-being. Data detailing such behaviors may derive from textual sources with varying content, requiring an approach to merge multiple media sources and create linked relationships between relevant event terms. In addition, applied methods need to provide both quantitative capacity and qualitative functionality, which can rapidly display emerging trends and potentially significant individual events. This article presents an information fusion approach for conducting text searches on web-based sources to provide managers and scientists with rapid search capabilities identifying potentially significant social-ecological events. Along with general analytical utility, a network approach that links associated terms is used to show semantic relationships between social-ecological terms at different timescales. © The Author(s) 2010.},
 author = {Altaweel, Mark R. and Alessa, Lillian N. and Kliskey, Andrew D.},
 doi = {10.1177/0894439309360837},
 journal = {Social Science Computer Review},
 note = {Cited by: 7},
 number = {4},
 pages = {497 - 514},
 publication_stage = {Final},
 source = {Scopus},
 title = {Visualizing Situational Data: Applying Information Fusion for Detecting Social-Ecological Events},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/77957270914?origin=resultslist},
 volume = {28},
 year = {2010}
}
