@article{CHEN2026164726,
 abstract = {The rational design of covalently integrated MOF@COF architectures, merging the high surface area and catalytic diversity of MOF with the superior light-harvesting capabilities of COF, represents a strategic breakthrough in photocatalytic CO2 conversion. Despite electron-donor COF coatings improving photostability and activity, uncontrolled growth often causes detrimental pore obstruction and active site masking. To address the issue, we precisely controlled in situ synthesis of a triphenylamine-based COF (Tpt-2p) on amino-functionalized Cu-MOF via sequential Schiff-base polycondensation, constructing an optimized series of Cu3(NH2BTC)2@Tpt-2p-x heterostructures (x = 3–19 wt%) for selective CO2 reduction to CH4/CO. Systematic characterization reveals that the support-structured Cu3(NH2BTC)2@Tpt-2p-15 % achieves exemplary performance metrics: full-spectrum light utilization (200–789 nm), enhanced charge extraction (1.24 × 10-6 V·s), and preserved CO2 adsorption/activation capacity (120.95 cm3·g−1), culminating in a record electron consumption rate of 2794.2 μmol·g−1·h−1. This optimal performance stems from the dual equilibrium between COF-mediated photoelectron generation via π-conjugated C=N networks and MOF-driven electron utilization through exposed Cu/NH2 catalytic sites retaining 79.90 µmol·g−1 residual amino groups. Whereas excessive COF coating in the core–shell Cu3(NH2BTC)2@Tpt-2p-19 % causes site blocking and charge recombination (Rele = 840 μmol·g−1·h−1), insufficient Tpt-2p loading in Cu3(NH2BTC)2@Tpt-2p-3 % leads to deficient photon utilization (Rele = 641.6 μmol·g−1·h−1). Additionally, systematic mechanistic studies elucidate the NH2-Cu dual-site synergism and balanced electron supply-consumption, offering fundamental guidance for designing heterojunction photocatalysts with precisely engineered structures.},
 author = {Sirong Chen and Ren Ma and Feiyang Yu and Jing Liu and Yifan Zhang and Zhengqiang Xia and Qi Yang and Gang Xie and Sanping Chen},
 doi = {https://doi.org/10.1016/j.apsusc.2025.164726},
 issn = {0169-4332},
 journal = {Applied Surface Science},
 keyword = {Metal-organic frameworks, Covalent organic frameworks, MOF@COF heterojunctions, Photocatalysis, CO reduction},
 pages = {164726},
 title = {Balancing electron supply and consumption in support-structured MOF@COF heterojunctions for enhanced photocatalytic CO2 conversion},
 url = {https://www.sciencedirect.com/science/article/pii/S0169433225024420},
 volume = {716},
 year = {2026}
}
