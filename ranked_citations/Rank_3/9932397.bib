@inbook{9932397,
 abstract = {This chapter focuses on testing and deployment of software developers' application and the systems on which their application depends. Testing means checking that software developers' software does everything that the client asked for and that the project requirement document listed, but also that it only does those things. The definition of deployment mean &#x201c;the actions taken to release software developers' application to production&#x201d;. Code review can happen in many different situations during the coding, testing, or release/maintenance phases of the System Development Life Cycle; it can be performed on each new piece of code before it is merged into the main branch, it can be performed right before software developers' publish version 1.0 of their application, or even after a data breach has occurred during the incident investigation. A Static Application Security Testing tool can analyze the code, binaries, and even byte code for potential security problems.},
 author = {Janca, Tanya},
