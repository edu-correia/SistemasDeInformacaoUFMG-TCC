@conference{Jarifi20061666,
 abstract = {This paper introduces a new approach for the automatic segmentation of corpora dedicated to speech synthesis. The main idea behind this approach is to merge the outputs of three segmentation algorithms. The first one is the standard HMM-based (Hidden Markov Model) approach. The second algorithm uses a phone boundary model, namely a GMM (Gaussian Mixture Model). The third method is based on Brandt's GLR (Generalized Likelihood Ratio) and aims to detect signal discontinuities in the vicinity of the HMM boundaries. Different combination strategies are considered for each phonetic class. The experiments presented in this paper show that the proposed approach yields better accuracy than existing methods.},
 author = {Jarifi, Safaa and Pastor, Dominique and Rosec, Olivier},
 journal = {INTERSPEECH 2006 and 9th International Conference on Spoken Language Processing, INTERSPEECH 2006 - ICSLP},
 note = {Cited by: 3},
 pages = {1666 - 1669},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cooperation between global and local methods for the automatic segmentation of speech synthesis corpora},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/44949094565?origin=resultslist},
 volume = {4},
 year = {2006}
}
