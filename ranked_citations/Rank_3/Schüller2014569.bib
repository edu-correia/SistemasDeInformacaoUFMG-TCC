@conference{Schüller2014569,
 abstract = {The Chemnitz University of Technology and the Fraunhofer Institute for Electronic Nanosystems ENAS are participating in Excellence-Cluster MERGE. In the sphere of the Integrated Research Domain D Micro- and Nanosystem-Integration in composite structures new approaches for microelectronic components in hybrid structures are developed. The objective is to enable the functionalizing by sensors, actuators and electronics and therefore a further improvement of performance and functional density of hybrid components. In this paper a brief overview of the new concepts is presented. © 2014 Smart Systems Integration - 8th International Conference and Exhibition on Integration Issues of Miniaturized Systems - MEMS, NEMS, ICs and Electronic Components, SSI 2014. All rights reserved.},
 author = {Schüller, M. and Walther, M. and Tröltzsch, J. and Otto, T. and Mehner, J. and Geßner, T. and Kroll, L.},
 journal = {Smart Systems Integration - 8th International Conference and Exhibition on Integration Issues of Miniaturized Systems - MEMS, NEMS, ICs and Electronic Components, SSI 2014},
 note = {Cited by: 0},
