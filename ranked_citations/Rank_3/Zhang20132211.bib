@article{Zhang20132211,
 abstract = {The intrinsic geometrical structure of the original data space is usually embedded in the low-dimensional manifold. The extraction of optimized manifold features could improve the performance of clustering. This paper combines kernel method and spectral method to present a kernelized spectral clustering method based on the proposed local affinity preserving indexing (LAPI). In this algorithm, the data are firstly mapped into a kernel feature space, and then projected into a low-dimensional space where the distances between the data points in the same local patches are minimized and the distances from the data points outside these patches are maximized simultaneously. The proposed LAPI method can effectively discover the intrinsic local affinities embedded in kernel highdimensional space. The comparison experiments for document clustering demonstrate its effectiveness. © 2013 ICIC International.},
 author = {Zhang, Junfeng and Yang, Bin},
 journal = {ICIC Express Letters},
 note = {Cited by: 0},
 number = {8},
 pages = {2211 - 2215},
 publication_stage = {Final},
 source = {Scopus},
 title = {A kernelized spectral clustering method based on local affinity preserving indexing for document clustering},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84877756497?origin=resultslist},
 volume = {7},
 year = {2013}
}
