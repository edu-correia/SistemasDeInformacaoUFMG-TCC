@inproceedings{6014635,
 abstract = {The safety of food has become one hot society topic in recent years. It is be imperative to control the quality of food from source now. Considering the existing state of beef farming enterprise in NingXia, also based on the concrete requirement of these enterprises, we design and research the beef farming quality traceability system based the PDA and GSM Modem. The main target of this system is to guarantee the beef quality, improve the farming management process and enhance the benefit of the farming enterprise. The beef farming quality traceability system based on the PDA, which have RFID module, and GSM Modem as the hardware platform, uses the C/S as the system structure, integrates the application of embedded databases and data synchronization technology and uses C# as the program language. The system collects the real-time farming data by PDA, uses the merge and replication technology to come true the synchronization between PDA and the server, and uses the GSM Modem to get and send the short message to tracing the beef quality message. The design and application of the system will sets up the traceable database which includes the beef farming, breeding, migrating, epidemic prevention, treatment information. It's helpful for enterprise, the customer and the government department to trace the beef quality, and is helpful for the enterprise to improve the level of informatization and enhance the quality level of product. It's a practicality system.},
 author = {Bao, Wenxing and Yang, Yongsheng},
 booktitle = {2011 IEEE 3rd International Conference on Communication Software and Networks},
 doi = {10.1109/ICCSN.2011.6014635},
 issn = {},
 keyword = {Modems;GSM;Educational institutions;Personal digital assistants;Europe;PDA;GSM Modem;Traceability Beef Farming},
 month = {May},
 number = {},
 pages = {571-574},
 title = {Beef farming quality traceability system based on PDA and GSM Modem},
 volume = {},
 year = {2011}
}
