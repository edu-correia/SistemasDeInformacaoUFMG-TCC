@article{Šaša201089,
 abstract = {This paper presents an architectural framework for incorporating knowledge management into service-oriented systems. One of the most important characteristics of service-oriented systems is automated orchestration of services into business processes, which we believe can be improved by knowledge management. The approach we discuss is an important step from isolated knowledge management systems to knowledge management integrated into daily work and is based on the observation that business process execution can be seen as an opportunity to capture the knowledge and merge it with the existing knowledge in the organizational memory. The proposed framework not only enables efficient and effective management of knowledge but also enables automation of certain knowledge-based human performed tasks, which is an important achievement in the area of business process management. © 2010 The authors and IOS Press. All rights reserved.},
 author = {Šaša, Ana and Krisper, Marjan},
 doi = {10.3233/978-1-60750-477-1-89},
 journal = {Frontiers in Artificial Intelligence and Applications},
 note = {Cited by: 4},
 pages = {89 - 104},
 publication_stage = {Final},
 source = {Scopus},
 title = {Knowledge management in service-oriented systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77950975851?origin=resultslist},
 volume = {206},
 year = {2010}
}
