@article{Wemlinger2015129,
 abstract = {The problem of activity recognition in smart environments has produced multiple divergent paths of research in an attempt to improve the usability and usefulness of smart environments. In this paper we merge these research paths by defining a method for mapping smart environment sensor activities into an ontologically defined semantic feature space. We show that by using this approach we are able to improve activity recognition by between 5–20%. © Springer International Publishing Switzerland 2015.},
 author = {Wemlinger, Zachary and Holder, Lawrence},
 doi = {10.1007/978-3-319-14424-5_14},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {129 - 137},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improving activity recognition in smart environments with ontological modeling},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84927751059?origin=resultslist},
 volume = {8456},
 year = {2015}
}
