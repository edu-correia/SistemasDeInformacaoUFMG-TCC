@conference{Liang20142561,
 abstract = {Learning hierarchical concepts is a central problem in cognitive science. This paper explores the Nearest-Merge algorithm for creating hierarchical clusters that can handle both feature-based and relational information, building on the SAGE model of analogical generalization. We describe its results on three data sets, showing that it provides reasonable fits with human data and comparable results to Bayesian models. © 2014 Proceedings of the 36th Annual Meeting of the Cognitive Science Society, CogSci 2014. All rights reserved.},
 author = {Liang, Chen and Forbus, Kenneth D.},
 journal = {Proceedings of the 36th Annual Meeting of the Cognitive Science Society, CogSci 2014},
 note = {Cited by: 5},
 pages = {2561 - 2566},
 publication_stage = {Final},
 source = {Scopus},
 title = {Constructing Hierarchical Concepts via Analogical Generalization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85028718463?origin=resultslist},
 year = {2014}
}
