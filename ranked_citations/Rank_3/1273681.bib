@article{1273681,
 abstract = {Frequency-shift keying (FSK) is a popular modulation scheme in power-limited communication links. This paper introduces space-time FSK (ST-FSK), which does not require any channel state information at the transmitter and the receiver, as in conventional noncoherent FSK. ST-FSK can be viewed as a special unitary ST modulation design. However, ST-FSK has a number of advantages over existing unitary ST modulation designs. ST-FSK is easier to design, and enjoys lower decoding complexity. Furthermore, ST-FSK guarantees full diversity. Finally, ST-FSK can be adopted in the digital as well as in the analog domain, and merges very naturally with frequency-hopping multiple access. As expected, all these advantages come at the cost of a decrease in spectral efficiency.},
 author = {Leus, G. and Wanlun Zhao and Giannakis, G.B. and Delic, H.},
 doi = {10.1109/TCOMM.2004.823647},
 issn = {1558-0857},
 journal = {IEEE Transactions on Communications},
 keyword = {Frequency shift keying;Channel state information;Transmitters;Costs;Modulation coding;Detectors;Transmitting antennas;Bandwidth;Decoding;Military communication},
 month = {March},
 number = {3},
 pages = {346-349},
 title = {Space-time frequency-shift keying},
 volume = {52},
 year = {2004}
}
