@article{Williams2008175,
 abstract = {A class of applications exists where the information to be stored is partially structured: that is, it consists partly of some structured data sources each conforming to a schema and partly of information left as free text. While investigating the requirements for querying partially structured data, we have encountered several limitations in the currently available approaches and we describe here three new techniques which combine aspects of Information Extraction with data integration in order to better exploit the data in these applications. © 2008 Springer-Verlag Berlin Heidelberg.},
 author = {Williams, Dean and Poulovassilis, Alexandra},
 doi = {10.1007/978-3-540-69858-6_18},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {175 - 186},
 publication_stage = {Final},
 source = {Scopus},
 title = {Combining data integration and IE techniques to support partially structured data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/47749130868?origin=resultslist},
 volume = {5039 LNCS},
 year = {2008}
}
