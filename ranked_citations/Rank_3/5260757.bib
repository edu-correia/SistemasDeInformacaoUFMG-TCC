@inproceedings{5260757,
 abstract = {Due to having many benefits, P2P is attracting the attentions of industries and academia. Data sharing is one of the fields which P2P has been exploited in. However, data sharing in current P2P Systems is mostly restricted to file-system-like capabilities, and canpsilat directly deal with relational data. Furthermore, under some situations, data integration methods in traditional database field canpsilat carry out. The merge of P2P and database technology provides a new approach to solving the problem. In this paper, firstly we present the backgrounds of the emergence of PDBS (P2P Database System). Secondly, we give an overview of related work. Then we simply review P2P technology form the aspects of character and overlay networkpsilas classification, and analyze the similarities and differences between PDBS and DDBS (Distributed Database System). We also present a PDBS prototype instance: PeerDB.},
 author = {Liu, Dong and Zhao, Yue-long},
 booktitle = {2009 International Conference on New Trends in Information and Service Science},
 doi = {10.1109/NISS.2009.144},
 issn = {},
 keyword = {Database systems;Relational databases;Resource description framework;Computer science;Computer industry;Prototypes;Peer to peer computing;Industrial relations;Design engineering;Computer networks;PDBS;P2P;Data integration},
 month = {June},
 number = {},
 pages = {378-383},
 title = {Distributed Relational Data Sharing Based on P2P},
 volume = {},
 year = {2009}
