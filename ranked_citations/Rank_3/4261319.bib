@inproceedings{4261319,
 abstract = {This paper presents MOJITO, a system which optimizes across thousands of analog circuit topologies simultaneously, and returns a set of sized topologies that collectively provide a performance tradeoff. MOJITO defines a space of possible topologies as a hierarchically organized combination of trusted analog building blocks. To minimize the setup burden: no topology selection rules or abstract behaviors need to be specified, and performance calculations are SPICE-based. The search algorithm is a novel multi-objective evolutionary algorithm that uses an age-layered population structure to balance exploration vs. exploitation. Results are shown for a space having 3528 one- and two-stage operational amplifier topologies.},
 author = {McConaghy, Trent and Palmers, Pieter and Gielen, Georges and Steyaert, Michiel},
 booktitle = {2007 44th ACM/IEEE Design Automation Conference},
 doi = {},
 issn = {0738-100X},
 keyword = {Analog circuits;Circuit topology;Permission;Switches;Evolutionary computation;Operational amplifiers;Merging;System-level design;Algorithm design and analysis;Analog integrated circuits;Algorithms;Design;Analog;mixed-signal;integrated circuits;computer-aided design},
 month = {June},
 number = {},
 pages = {944-947},
 title = {Simultaneous Multi-Topology Multi-Objective Sizing Across Thousands of Analog Circuit Topologies},
 volume = {},
 year = {2007}
}
