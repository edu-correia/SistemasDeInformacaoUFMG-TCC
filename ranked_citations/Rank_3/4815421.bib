@article{4815421,
 abstract = { The extension of the standard grayscale active appearance model (AAM) techniques to color images is investigated. Prior work in this field has mainly focused on RGB color models which did not demonstrate noticeable benefits over grayscale models from the point of view of convergence accuracy. We improve on previous work by normalizing the color texture vector separately for intensity and chromaticity components. Where an appropriate color space is chosen, we demonstrate improvements in convergence accuracy as well as image synthesization quality for AAMs. Optimal results are achieved when a color space in which the image channels are strongly decorrelated is chosen. Our best results are achieved using the I1I2I3 color space, originally proposed by Ohta. },
 author = {Ionita, Mircea C. and Corcoran, Peter and Buzuloiu, Vasile},
 doi = {10.1109/TIP.2009.2017163},
 issn = {1941-0042},
 journal = {IEEE Transactions on Image Processing},
 keyword = {Active appearance model;Gray-scale;Convergence;Decorrelation;Image color analysis;Principal component analysis;Image analysis;Biomedical imaging;Merging;Concatenated codes;Active appearance model (AAM);color spaces;PCA},
 month = {June},
 number = {6},
 pages = {1372-1378},
 title = {On Color Texture Normalization for Active Appearance Models},
 volume = {18},
 year = {2009}
}
