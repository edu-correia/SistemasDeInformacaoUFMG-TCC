@inproceedings{8392585,
 abstract = {In this paper, we propose the integration of local interpolation on compressive sampling (CS) for application on internet traffic reconstruction. CS managed to solve the problem of missing Internet traffic but not in the case of extreme missing like Missing Elements at Random (MER) and Combine Missing Patterns (CMP). To overcome the problem is done by merging between local interpolations with CS. In this study conducted a comparison of local interpolation using correlation method and Euclidean norm and tested the effect of similarity parameters between rows and similarity between columns. The simulation results show that the incorporation of local interpolation can improve accuracy with insignificant time increments, mainly on the addition of Euclidean norm technique.},
 author = {Irawati, Indrarini Dyah and Suksmono, Andriyan Bayu and Edward, Ian Yosef Matheus},
 booktitle = {2017 International Conference on Advanced Computing and Applications (ACOMP)},
 doi = {10.1109/ACOMP.2017.22},
 issn = {},
 keyword = {Correlation;Interpolation;Mathematical model;Reconstruction algorithms;Matching pursuit algorithms;Correlation coefficient;Internet;local interpolation;compressive sampling;internet traffic matrix;correlation;Euclidean norm},
 month = {Nov},
 number = {},
 pages = {93-98},
 title = {Local Interpolated Compressive Sampling for Internet Traffic Reconstruction},
 volume = {},
 year = {2017}
}
