@article{4560136,
 abstract = {This paper presents a novel architecture for integrating digital stabilizer with the camera zooming process. The proposed architecture scheme allows integration for both optical and digital zooming operation scenarios. The stabilizer adjusts its operational parameters from the current optical zooming status for a refined local motion estimation. Subsequently, the global motion compensation vectors, produced by the digital stabilizer, are sent to the digital zooming system, where the image compensation is merged within the interpolation process. Experimental results indicate that the proposed architecture can improve not only the quantitative performance of digital stabilization but also the computational efficiency when zooming is employed.},
 author = {Amanatiadis, Angelos and Andreadis, Ioannis},
 doi = {10.1109/TCE.2008.4560136},
 issn = {1558-4127},
 journal = {IEEE Transactions on Consumer Electronics},
 keyword = {Motion estimation;Optical sensors;Motion compensation;Pattern matching;Digital cameras;Optical imaging;Image sequences;CMOS image sensors;Interpolation;Image sensors},
 month = {May},
 number = {2},
 pages = {600-608},
 title = {An integrated architecture for adaptive image stabilization in zooming operation},
 volume = {54},
 year = {2008}
}
