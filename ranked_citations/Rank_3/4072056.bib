@inproceedings{4072056,
 abstract = {How to mine user-interested path from Web-log is an important and challengeable research topic. On the analysis of the present algorithm's advantages and disadvantages, we propose a new algorithm for discovering such expected Web pages. Through computing the probability of the document which is recommended to the user, we can mine user preferred sub-paths. Accordingly, all the sub-paths are merged, and user preferred paths are formed. Experiments showed that it was more precise than previous algorithm. It's suitable for Web site based application, such as to optimize Web site's topological structure or to design personalized services},
 author = {Hong-fang, Zhou and Bo-qin, Feng and Hui, Yue and Lin-tao, Lv},
 booktitle = {2006 International Conference on Computational Intelligence and Security},
 doi = {10.1109/ICCIAS.2006.294103},
 issn = {},
 keyword = {Knowledge engineering;Probability distribution;Consumer electronics;Computer science;Equations;Algorithm design and analysis;Web pages;Design optimization;Web page design;Internet},
 month = {Nov},
 number = {},
 pages = {121-124},
 title = {Mining User Preferred Knowledge from Web-Log},
 volume = {1},
 year = {2006}
}
