@inproceedings{4739681,
 abstract = {Ontology mapping is the most effective solution to achieve interoperability among heterogeneous ontologies. There already exists many algorithms and tools for creating mapping, but less research focus on the actual usage of the created mappings for a specific task. This paper discusses the application of ontology mapping, and proposes the framework MAIT for automatic instance transformation based on mapping, and presents relative transforming algorithms. This framework can work in any ontology-based environment such as semantic Web, and transform the instance data between source ontology and target ontology automatically. The experimental results reveal that the framework and algorithms are feasible and effective.},
 author = {Li, Guanyu and Li, Lin and Zhang, Jun and Luo, Zhenghai},
 booktitle = {2008 Second International Symposium on Intelligent Information Technology Application},
 doi = {10.1109/IITA.2008.118},
 issn = {},
 keyword = {Ontologies;Semantic Web;Educational institutions;Information technology;Technology management;Information science;Merging;Machine learning;Automation;Airplanes},
 month = {Dec},
 number = {},
 pages = {799-803},
 title = {Mapping Based Automatic Instance Transformation},
 volume = {1},
 year = {2008}
}
