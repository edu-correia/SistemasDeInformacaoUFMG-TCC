@inproceedings{10739640,
 abstract = {A method is being developed for computer modeling of traffic at a controlled intersection of urban roads. The model represents the traffic as a random process and is based on the use of statistical data for headways in clusters of vehicles. The proposed model explicitly considers the spatiotemporal structure of traffic flow, systematically considering the interdependencies between vehicle passages through conflicting intersection and junction points and on exit roads. The proposed approach can be used to analyze the current passage of flows and to select a method for structural-parametric control of an intersection.},
 author = {Valuev, Andrey M.},
 booktitle = {2024 17th International Conference on Management of Large-Scale System Development (MLSD)},
 doi = {10.1109/MLSD61779.2024.10739640},
 issn = {},
 keyword = {Uncertainty;Roads;Computational modeling;Stochastic processes;Data models;Regulation;Random processes;Spatiotemporal phenomena;Vehicle dynamics;Monitoring;controlled intersection;conflict points;traffic safety;phase-by-phase passing scheme;spatio-temporal structure of traffic flow;traffic light regulation;monitoring;computational experiments},
 month = {Sep.},
 number = {},
 pages = {1-5},
 title = {Modeling of Stochastic Traffic Flow Through an Intersection with Cluster Interaction},
 volume = {},
 year = {2024}
}
