@inproceedings{11289919,
 abstract = {Hyperspectral image (HSI) classification has been advanced by convolutional and graph convolutional networks (CNNs and GCNs). While CNNs excel at extracting local features, GCNs capture structured relationships. However, CNNs are limited by fixed-shape kernels in handling irregular structures, and GCNs often lose fine-grained pixel information. To overcome these limitations and integrate the advantages of both approaches, we introduce a novel multi-scale attention architecture by fusing GCN and CNN. The proposed model incorporates a multi-scale convolutional network (MSCN) for capturing pixel-level information across receptive fields, and a multi-hop GCN (MHGCN) to learn superpixel-level features. An attention fusion (AF) adaptively merges features from both network branches, enabling refined multi-level semantic representation. Experimental results show that our model surpasses several approaches.},
 author = {Wang, Xiaopin and Lv, Juncheng},
 booktitle = {2025 5th International Conference on Artificial Intelligence, Automation and High Performance Computing (AIAHPC)},
 doi = {10.1109/AIAHPC66801.2025.11289919},
 issn = {},
 keyword = {Adaptation models;Graph convolutional networks;High performance computing;Semantics;Computer architecture;Spread spectrum communication;Feature extraction;Kernel;Hyperspectral imaging;Image classification;convolutional neural network;graph convolutional network;attention mechanism;hyperspectral image classification},
 month = {Sep.},
 number = {},
 pages = {142-145},
 title = {A Multi-Scale Attention Architecture by Fusing Graph Convolutional Network and CNN for Hyperspectral Image Classification},
 volume = {},
 year = {2025}
}
