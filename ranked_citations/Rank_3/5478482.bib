@inproceedings{5478482,
 abstract = {In this paper, the creation of a Cyber Physical Test Bed (CTB) to support a Virtual Enterprise oriented approach for the assembly of micro devices is discussed. The domain of Micro Assembly provides a natural context to develop products by adopting a VE functioning approach and using semantic technologies. As each VE partner or engineering organization in the domain of micro assembly possesses different micro assembly resources, there is a need to form collaborative partnerships to address specific customer requests related to Micro Assembly. This nature of the domain lends itself as an ideal ground to test the development of a Virtual Enterprise oriented approach using a range of software and other resources.},
 author = {Cecil, J. and Gobinath, N.},
 booktitle = {2010 International Symposium on Collaborative Technologies and Systems},
 doi = {10.1109/CTS.2010.5478482},
 issn = {},
 keyword = {Testing;Collaboration;Assembly;Ontologies;Virtual enterprises;Semantic Web;Software tools;Merging;Supply chains;Protocols;Semantic framework;Ontology;Micro Assembly;Virtual Enterprise;Agents},
 month = {May},
 number = {},
 pages = {430-439},
 title = {A Cyber Physical Test Bed for collaborative Micro Assembly engineering},
 volume = {},
 year = {2010}
}
