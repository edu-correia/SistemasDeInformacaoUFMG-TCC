@inproceedings{10778692,
 abstract = {This research presents an innovative approach to medical imaging by integrating Magnetic Resonance Imaging (MRI) and Computed Tomography (CT) scan data with Augmented Reality (AR) and Virtual Reality (VR) technologies to create immersive, interactive 3D models. This project bridges the gap between theoretical research and practical medical applications by merging cutting-edge tools and software. We outline the core concepts, methodologies, technologies employed, research findings, and validation methods for this transformative visualization approach. The strength of this project lies in its realistic, technology-driven focus, fostering interdisciplinary collaboration and paving the way for significant advancements in healthcare visualization. This work can potentially enhance diagnostics, surgical planning, and medical education while setting the stage for future innovations in patient care.},
 author = {Ziyad, Naeema and Yoosaf, Salih and Prabha, Navaneeth and Nair, Navaneeth V},
 booktitle = {2024 IEEE 12th Region 10 Humanitarian Technology Conference (R10-HTC)},
 doi = {10.1109/R10-HTC59322.2024.10778692},
 issn = {2572-7621},
 keyword = {Solid modeling;Visualization;Accuracy;Three-dimensional displays;Magnetic resonance imaging;Computed tomography;Education;Medical services;User experience;Usability;MRI scan;CT scan;Augmented Reality;Virtual Reality;Medical imaging;3D interactive visualization},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Visualizing MRI & CT Scans Using Mixed Reality},
 volume = {},
 year = {2024}
}
