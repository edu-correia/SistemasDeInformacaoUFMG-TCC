@inproceedings{10645132,
 abstract = {This paper comprehensively perceives the concept of Vehicular-to-Everything (V2X) environment in the context of the digital transformation. Since it targets the intelligent transportation systems, as the basis for the development of the V2E, we have considered the digital transformation integration from the AI-supported V2X concept. We discuss the development of the digital transformation paradigm, starting from the digitization and digitalization, and further explain its commitments when applied in vehicular and automotive system environments. We thoroughly discuss the benefits and concerns of such a solution, finding the vehicular and automotive industry examples that support this technological merging. We have explained the digital transformation in V2E as well as proper standardization issues and tackled the cybersecurity point of view.},
 author = {Timcenko, Valentina V. and Rakas, Slavica Bostjancic},
 booktitle = {2024 11th International Conference on Electrical, Electronic and Computing Engineering (IcETRAN)},
 doi = {10.1109/IcETRAN62308.2024.10645132},
 issn = {},
 keyword = {Industries;Privacy;Digital transformation;Merging;Computational efficiency;Computer security;Standards;Digital Transformation;Vehicular to Everything;Artificial Intelligence},
 month = {June},
 number = {},
 pages = {1-6},
 title = {The Concept of Intelligent Digital Transformation in V2X Environment},
 volume = {},
 year = {2024}
}
