@article{Li201515,
 abstract = {Popular music segmentation plays an important role in popular music content retrieval, melody extraction and semantic understanding etc. Segmentation boundary detection is one of the key technologies in lots of conventional algorithms. In this paper, we propose an automatic segmentation approach that combines SVM classification and audio self-similarity segmentation, which firstly separate the sung clips and accompaniment clips from pop music by using SVM preliminary classification, and then heuristic rules are used to filter and merge the classification result to determine potential segment boundaries further. Finally, self-similarity detecting algorithm is introduced to refine our segmentation results in the vicinity of potential points. Experiment shows that our approach can achieve more sophisticated and accurate results by using the local change context substantially to determine the segmentation boundaries. © Springer International Publishing Switzerland 2015.},
 author = {Li, Feng and You, You and Lu, Yuqin and Pan, Yu Qing},
 doi = {10.1007/978-3-319-15554-8_2},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {15 - 25},
 publication_stage = {Final},
 source = {Scopus},
 title = {An automatic segmentation method of popular music based on SVM and self-similarity},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84924410617?origin=resultslist},
 volume = {8944},
 year = {2015}
}
