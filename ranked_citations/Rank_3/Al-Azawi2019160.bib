@conference{Al-Azawi2019160,
 abstract = {Image segmentation process represents the main stage for most computer vision systems. This paper presents an improved algorithm based on simple linear iterative clustering (SLIC) to reduce the number of used seeds for threshold estimation as well as the entire execution time of image segmentation. These is achieved by using split and merge stages for the location, number of seeds as well as other parameters of the seed points. The obtained results showed the possibility of using various threshold levels instead of a single one which represented a challenge due to the estimation complexity. The independent of the threshold-level estimation can contribute significantly in improving performance of the overall image segmentation process.) © 2019 IEEE.},
 author = {Al-Azawi, Razi J. and Al-Jubouri, Qussay S. and Mohammed, Yousra Abd},
 doi = {10.1109/DeSE.2019.00038},
 journal = {Proceedings - International Conference on Developments in eSystems Engineering, DeSE},
 note = {Cited by: 12},
 pages = {160 - 163},
 publication_stage = {Final},
 source = {Scopus},
 title = {Enhanced algorithm of superpixel segmentation using simple linear iterative clustering},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85084405556?origin=resultslist},
 volume = {October-2019},
 year = {2019}
}
