@inproceedings{9489232,
 abstract = {The fusion of multispectral medical images is required to achieve a better visualization. It is made possible by integrating the information's taken from different medical images. Normally, the images received from different modalities are degraded due to noise interference. It leads to false detection during the diagnosis of diseases. In this paper, a frame work was introduced for PET_MRI-1 and PET_MRI-2 images. Once the Non-sampled Shearlet Transform (NSST) is applied, it is required to decompose it into Low frequency LF and High frequency HF components. After the separation of basic and edge details the convolution structure sparse coding is implemented to fuse the LF component with the support of Alternating Direct Method of Multipliers algorithm. Then the guided filtering-based approach is employed to merge the HF components. Finally, the inverse NSST is implemented ro reconstruct the fused images. Finally, the fused image is filtered using Guided filtering. During evaluation, the PET_MRI-1 and PET_MRI-2 images are used for testing and the output images are obtained. This proposed scheme has a good fused image with better performance metrics.},
 author = {Reddy, S.PradeepKumar and Krishnaiah, R V and Rajasree Rao, Y},
 booktitle = {2021 6th International Conference on Communication and Electronics Systems (ICCES)},
 doi = {10.1109/ICCES51350.2021.9489232},
 issn = {},
 keyword = {Visualization;Image coding;Convolution;Image edge detection;Transforms;Filtering algorithms;Information filters},
 month = {July},
 number = {},
 pages = {1158-1165},
 title = {An Effective Approach in Fusion of Multispectral Medical Images Using Convolution Structure Sparse Coding},
 volume = {},
 year = {2021}
}
