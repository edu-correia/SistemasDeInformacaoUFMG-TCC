@inproceedings{10213020,
 abstract = {In this study, we propose a novel method for real-time segmentation of subway tracks to ensure the safe operation of the subway system. Given the complexity of various scenarios, we make endeavors to achieve higher recognition accuracy and faster inference speed for detecting track areas in the subways. We present an improved bilateral segmentation network (BiSeNet) model that balances segmentation accuracy and speed. Building on the foundation of the classic BiSeNet, we incorporate the shape characteristics of subway tracks into the proposed model. By replacing the standard convolution kernels with deformable convolution kernels, we can extract features of the track areas more effectively. Additionally, we introduce a pyramid pooling module at the end of the spatial path to retain more image feature information, thereby enhancing the recognition efficiency of track details. To account for the diverse track characteristics found in subway systems, we propose a multi-scenario model consisting of four basic modules: straight track section, curved track section, turnout track section, and merged track section. This track multi-scenario model is designed to aid in the detection of various subway tracks. Finally, we validate our algorithm using a dataset sampled in line No.10 subway in Shenzhen City, China. Experimental results demonstrate that the improved algorithm outperforms in both accuracy and speed for track area recognition, the mIoU can reach 79.94%, and the PA can reach 86.25%. It is also tested in real subway operation scenarios and achieves better detection results.},
 author = {Fan, Yuhang and Zhang, Hao and Zhao, Rongyong and Lu, Jianfeng and Wu, Facai and Liu, Yafei},
 booktitle = {2023 3rd International Symposium on Computer Technology and Information Science (ISCTIS)},
 doi = {10.1109/ISCTIS58954.2023.10213020},
 issn = {},
 keyword = {Convolution;Shape;Urban areas;Feature extraction;Real-time systems;Object recognition;Kernel;track area recognition;semantic segmentation;computer vision;multi-scenario},
 month = {July},
 number = {},
 pages = {593-597},
 title = {A Multi-Scenario Model used in Subway Track Recognition Based on an Improved BiSeNet},
 volume = {},
