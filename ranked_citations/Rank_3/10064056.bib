@article{10064056,
 abstract = {We prove that if the probability of the most likely symbol of a memoryless source  $p_{{\text { max}}}$  is greater than  $\frac {5}{8}$ , then the optimal reversible variable length code (RVLC) assigns a single bit to it. Moreover, we prove that if  $p_{{\text { max}}} > \frac {1}{2}$  (respectively,  $p_{{\text { max}}} > \frac {2}{5}$ ), then its codelength in the optimal RVLC can be up to two bits (respectively, three bits).},
 author = {Zahabi, Sayed Jalal and Narimani, Hamed and Khosravifard, Mohammadali},
 doi = {10.1109/TIT.2023.3253843},
 issn = {1557-9654},
 journal = {IEEE Transactions on Information Theory},
 keyword = {Symbols;Codes;Merging;Video compression;Transform coding;Standards;Source coding;RVLC;the most probable symbol;Kraft sum},
 month = {July},
 number = {7},
 pages = {4740-4745},
 title = {On the Shortest Codeword of the Optimal RVLC},
 volume = {69},
 year = {2023}
}
