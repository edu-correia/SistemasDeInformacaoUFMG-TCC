@inproceedings{4493729,
 abstract = {Mobile sensor networks consist of mobile nodes interconnected by multihop path that has no fixed network infrastructure support. Due to limited bandwidth and resource and also the frequent changes in topologies, sensor network should consider these features for the provision of security. This paper proposes and analyzes a scalable and efficient routing protocol by introducing identity based infrastructure for secure group communication in wireless sensor networks. In a group communication, group merge is one of the operations for multiple member changes in a group. The newly merged group needs a secure route to maintain relationship with other groups. To ensure scalability for proposed ID based routing protocol, the system takes signcryption method which combines signature and encryption which provides a significant cost. Through comparison and analysis we have shown that our protocol has high probability to be resilient for secure communication among mobile nodes.},
 author = {Sultana, Nahar and Huh, Eui-Nam},
 booktitle = {2008 10th International Conference on Advanced Communication Technology},
 doi = {10.1109/ICACT.2008.4493729},
 issn = {1738-9445},
 keyword = {Mobile communication;Wireless sensor networks;Routing protocols;Spread spectrum communication;Bandwidth;Network topology;Sensor phenomena and characterization;Scalability;Cryptography;Costs;Routing;Group merge;signature and encryption;ID-based infrastructure},
 month = {Feb},
 number = {},
 pages = {136-141},
 title = {Secure Group Communication in Mobile Wireless Sensor Networks},
 volume = {1},
 year = {2008}
}
