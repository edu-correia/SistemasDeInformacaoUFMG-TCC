@inproceedings{4734190,
 abstract = {In this paper, we propose a new data centric storage using multilevel grid techniques for sensor network. The proposed method solves the hot-spot problems of existing data centric storages. By exploiting multilevel grid techniques, we lower or elevate the grid level of certain area according to the work load of sensor nodes. The level of a hot spot area is lowered so as that more sensor nodes cooperate to process data.},
 author = {Hong, Yul Pyo and Choi, Young-Jae and Kim, Tae Goo and Kwak, Yun Sik and Joe, Ki Hyung and Kang, Hyung Il and Song, Seok Il},
 booktitle = {2008 Second International Conference on Future Generation Communication and Networking},
 doi = {10.1109/FGCN.2008.66},
 issn = {2153-1463},
 keyword = {Energy efficiency;Energy storage;Distributed control;Base stations;Sensor phenomena and characterization;Data engineering;Temperature sensors;Load management;Tree data structures;Gas detectors;Sensor network;data centric storage},
 month = {Dec},
 number = {},
 pages = {133-136},
 title = {Energy Efficient Data Centric Storage for Sensor Networks Employing Multilevel Grid Techniques},
 volume = {2},
 year = {2008}
}
