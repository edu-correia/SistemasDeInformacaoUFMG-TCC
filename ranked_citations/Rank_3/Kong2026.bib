@article{Kong2026,
 abstract = {In complex networks, overlapping community detection is an important area of research. Currently, overlapping community detection algorithms based on label propagation have significant shortcomings. Existing methods rely on a single metric for node importance, making it difficult to accurately identify core nodes. Traditional modularity metric depend on global network information, leading to high computational complexity and low efficiency in the initial construction of community structures. Additionally, some algorithms overlook two key differences when determining the community affiliation of a target node: they fail to account for the differences in importance among the target node’s neighboring nodes and ignore the differences in similarity between the target node and its different neighboring nodes, resulting in inaccurate community partitioning.To address these issues, this paper proposes a three-stage overlapping community detection algorithm based on label propagation. The algorithm first proposes a quality assessment metric that integrates community tightness-sparsity in the community pre-selection stage, forming an initial community structure by optimizing this metric; second, in the community evolution stage, it defines node attractiveness and community attractiveness to decide on node community label updates; finally, during the community label filtering stage, the weighted community affiliation is used to filter candidate labels, resulting in a more accurate overlapping community structure. The proposed algorithm was tested on both synthetic and real networks. The experimental results demonstrate that the proposed algorithm significantly outperforms existing comparison algorithms across multiple evaluation metrics, achieving higher accuracy. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
 author = {Kong, Zhi and Huo, Minglei and Wang, Lifu and Guo, Ge},
 doi = {10.1016/j.eswa.2026.131873},
 journal = {Expert Systems with Applications},
