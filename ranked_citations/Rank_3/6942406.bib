 issn = {},
 keyword = {Corporate acquisitions;Organizations;Data models;Context;Encoding;Merging;Computational modeling;Attribute-free Entities;Data models;Design;Human Factors;Management;Normal forms;Post-merger integration;SECI;Standardization;Theory},
 month = {Sep.},
 number = {},
 pages = {87-92},
 title = {Freeing entities of attributes: Revisiting database normal forms from an organizational knowledge perspective},
 volume = {},
