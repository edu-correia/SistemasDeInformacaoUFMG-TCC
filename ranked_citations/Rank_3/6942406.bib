@inproceedings{6942406,
 abstract = {Leveraging recent work, applying Philosophy of Knowledge, of Language, and of Mind, in the Knowledge Management area of Management research, this paper introduces a conceptual data model schema that extends presently accepted Normal forms practices by explicitly tying all Entity and Relationship Attributes to the heretofore socially implicit Institutions and Conventions Entities that rule the Valuation of said Attributes. The presented process has the potential to enable the lossless and automated integration of heterogeneous Information Systems.},
 author = {Idelson, Marc and Dany, Christophe},
 booktitle = {2014 IEEE International Conference on Management of Innovation and Technology},
