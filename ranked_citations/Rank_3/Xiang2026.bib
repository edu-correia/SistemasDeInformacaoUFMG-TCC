@article{Xiang2026,
 abstract = {Large vision–language models (VLMs) such as CLIP have demonstrated remarkable zero-shot generalization, yet their potential for unsupervised domain adaptation (UDA) remains underexplored. Existing approaches typically enhance transfer by optimizing visual representations via encoder fine-tuning or improving text prompts, but they either overlook fine-tuning of the text encoder or fail to fully exploit multimodal alignment, often suffering from catastrophic forgetting or limited domain generalization.To address these challenges, we propose ImCapDA, a novel caption-driven multimodal domain adaptation framework. ImCapDA leverages VLMs to generate instance-level textual descriptions and integrates three complementary components: (i) image–text contrastive learning for fine-grained, cross-modal feature alignment, (ii) fine-tuning both the visual and text encoder together to capture domain-specific semantics, and (iii) pseudo-label self-training guided by CLIP’s zero-shot predictions. This design simultaneously preserves generalization from large-scale pretraining and enhances domain-specific adaptability.Extensive experiments on standard UDA benchmarks show that ImCapDA consistently outperforms existing methods while offering strong plug-and-play flexibility for integration with frameworks such as MI and CMKD. We further extend ImCapDA to ImCapFusionDA, which explores visual–textual feature fusion strategies and achieves state-of-the-art results. Moreover, ImCapDA generalizes effectively to the source-free UDA setting, confirming its robustness and broad applicability. The code is available on https://github.com/mrmenand/ImCapDA. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
 author = {Xiang, Weiwei and Xiao, Guangyi and Peng, Shun and Chen, Hao and Ding, Liming and Yang, Lei},
 doi = {10.1016/j.eswa.2026.131248},
 journal = {Expert Systems with Applications},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {ImCapDA: Fine-tuning CLIP via image captions for unsupervised domain adaptation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105034465239?origin=resultslist},
 volume = {309},
 year = {2026}
}
