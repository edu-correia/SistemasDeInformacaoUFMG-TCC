@article{Ganzha2016296,
 abstract = {There exists a large body of scientific literature devoted to ontology matching, aligning, mapping translating and merging. With it, comes a long list (90+) of tools that support various aspects of these operations. We have approached such tools from the perspective of the INTER-IoT project, in which one of the goals is to facilitate semantic interoperability of Internet of Things platforms. Thus, we had to answer a question: what is actually available when one needs to align/merge ontologies. Here, we summarize our findings. © Springer International Publishing AG 2016.},
 author = {Ganzha, Maria and Paprzycki, Marcin and Pawłowski, Wiesław and Szmeja, Paweł and Wasielewska, Katarzyna and Fortino, Giancarlo},
 doi = {10.1007/978-3-319-45940-0_27},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 23},
 pages = {296 - 307},
 publication_stage = {Final},
 source = {Scopus},
 title = {Tools for ontology matching—practical considerations from INTER-IoT perspective},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84989285862?origin=resultslist},
 volume = {9864 LNCS},
 year = {2016}
}
