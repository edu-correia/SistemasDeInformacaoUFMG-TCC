@article{SABOUNI20232347,
 abstract = {The paper presents the status quo, barriers, and drivers for multimodal traffic management (MTM) from an economic and legal perspective, performing an in-depth literature review and eleven interviews with practitioners and academic experts. Main outcomes include that big data opens the possibilities for a better implementation of MTM and related business models, but technical equipment and complex processes can be obstacles. Further, the legal framework for MTM remains sparse and data protection requirements (GDPR) can be barriers as well. Especially for access to and merging of (traffic) data, legal provisions will have to be refined since incentives for companies to voluntarily exchange data are lacking. All in all, MTM allows for new business models, and the integration of innovative (upcoming) means of transportation, pushing for a fast transition of the mobility sector.},
 author = {Abdulghani Al Sabouni and Anne Freiberger and Benjamin Grosse and Anna-Katharina Hübers and Sophie Kamenz and Simon Kaser},
 doi = {https://doi.org/10.1016/j.trpro.2023.11.726},
 issn = {2352-1465},
 journal = {Transportation Research Procedia},
 keyword = {Mulitimodality, intelligent transport technologies, data protection, business models, multimodal traffic management},
 note = {TRA Lisbon 2022 Conference Proceedings Transport Research Arena (TRA Lisbon 2022),14th-17th November 2022, Lisboa, Portugal},
 pages = {2347-2354},
 title = {Drivers for multimodal traffic management},
 url = {https://www.sciencedirect.com/science/article/pii/S2352146523010244},
 volume = {72},
 year = {2023}
}
