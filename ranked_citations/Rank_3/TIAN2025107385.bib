@article{TIAN2025107385,
 abstract = {Block identification is a critical step in discrete numerical modeling for rock engineering. Block systems often contain numerous small blocks, whose proper treatment is essential for accurate mechanical analysis, improved computational efficiency, and enhanced simulation robustness. The merging method has proven to be the most effective for handling small blocks in two-dimensional (2D) space, outperforming the deleting and gluing methods. This paper extends the application of the merging method to three-dimensional (3D) space. We propose a novel 3D block identification method that integrates the merging technique, which effectively eliminates short edges and small faces shared between small blocks and their adjacent blocks. Our results demonstrate that the merging method remains highly effective in 3D mechanical analysis. To validate its optimization capabilities, we constructed two fictitious slope models using the 3-Dimensional Distinct Element Code (3DEC). The results indicate that the merging method significantly improves computational efficiency and reduces the block system’s sensitivity to contact stiffness when compared to the deleting and gluing methods. This study lays a solid foundation for advancing the geometric optimization of block systems and bridging geometric and mechanical analyses in rock mechanics.},
 author = {Zheqi Tian and Jun Zheng and Ruichen Zhang and Qing Lü and Shengkui Tan and Junfeng Li},
 doi = {https://doi.org/10.1016/j.compgeo.2025.107385},
 issn = {0266-352X},
 journal = {Computers and Geotechnics},
 keyword = {Block identification, Small block treatment, Rock mass, Rock block system, Mechanical analysis, 3DEC},
 pages = {107385},
 title = {A small block treatment method in three-dimensional block identification for rock block system mechanical analysis},
 url = {https://www.sciencedirect.com/science/article/pii/S0266352X25003349},
 volume = {186},
 year = {2025}
}
