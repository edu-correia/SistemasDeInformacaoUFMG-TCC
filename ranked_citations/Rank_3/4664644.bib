@inproceedings{4664644,
 abstract = {Refinement of Bayesian network structures using new data becomes more and more relevant. Some work has been done there; however, one problem has not been considered yet - what to do when new data has fewer or more attributes than the existing model. In both cases data contains important knowledge and every effort must be made in order to extract it. In this paper, we propose a general merging algorithm to deal with situations when new data has different set of attributes. The merging algorithm updates sufficient statistics when new data is received. It expands the flexibility of Bayesian network structure refinement methods. The new algorithm is evaluated in extensive experiments, and its applications are discussed at length.},
 author = {Yifeng Zeng and Yanping Xiang and Saulius Pacekajus},
 booktitle = {2008 IEEE International Conference on Granular Computing},
 doi = {10.1109/GRC.2008.4664644},
 issn = {},
 keyword = {Merging;Algorithm design and analysis;Bayesian methods;Reactive power;Asia;Computer science;Data models},
 month = {Aug},
 number = {},
 pages = {772-777},
 title = {Refinement of Bayesian network structures upon new data},
 volume = {},
 year = {2008}
}
