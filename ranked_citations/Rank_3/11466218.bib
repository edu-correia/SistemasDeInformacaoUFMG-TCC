@inproceedings{11466218,
 abstract = {To address the critical need for collaborative sensing of multiple factors of the lunar space environment, this paper developed and implemented an autonomous joint intelligent sensing platform for multiple factors of the lunar space environment. The platform adopted an integrated technical architecture that seamlessly combined component sensing, whole-machine collaboration, model-driven analysis, and software integration, deeply merging high-performance sensing payloads such as Laser-induced Breakdown Spectroscopy-Raman Spectroscopy-Infrared (LIBS-RS-IR), Confocal Laser Scanning Microscope (CLSM), Time-of-flight mass spectrometry (TOF), and a Dust Analyzer (DCA). Key technologies such as high-precision spatiotemporal alignment of multi-source heterogeneous data and autonomous intelligent collaborative detection and control were emphasized. By constructing an autonomous decision-making algorithm based on deep reinforcement learning, the platform achieved tightly coupled collaborative detection and intelligent scheduling of multiple environmental factors, including lunar surface material composition and morphology, neutral and charged particles, and charged dust. Combining a volatile matter migration dynamics model with multi-source data fusion and inversion technology, the platform possessed the capability for three-dimensional visualization and dynamic simulation of the spatiotemporal distribution of important lunar surface volatiles (i.e. H2, H2O, He, Ar, K, Na etc.). The platform was helpful for effectively monitoring payload health status, performing intelligent fault diagnosis, data fusion analysis, and scientific visualization, providing advanced intelligent sensing and decision support tools for revealing the lunar surface volatile transport mechanism and supporting subsequent lunar exploration and resource development missions.},
 author = {Wang, Yu-Qing and Ren, Zheng-Yi and Ao, Da-Cheng and Yu, Le-Yuan and Jia, Wen-Jie and Xi, Zhen-Hua and Zhang, Hu-Zhong and Zhang, Jiang},
 booktitle = {2026 6th International Conference on Neural Networks, Information and Communication Engineering (NNICE)},
 doi = {10.1109/NNICE68970.2026.11466218},
 issn = {},
 keyword = {Payloads;Space technology;Military aircraft;Radio broadcasting;Frequency modulation;Field programmable gate arrays;Pixel;Protocols;Communication systems;Modulation;Lunar surface environment;Multi-factor sensing;Autonomous collaboration;Platform design;Data fusion;Volatile matter migration},
 month = {Jan},
 number = {},
 pages = {1358-1364},
 title = {Autonomous joint multi-factor sensing platform design for lunar space environment},
