@article{11398371,
 abstract = {Quantitative analysis of cleavage-stage embryos is a critical step for embryo evaluation in in vitro fertilization (IVF) treatment. Deep learning-based instance segmentation methods have emerged as a promising solution. However, existing methods, typically designed for opaque instances in nature scenes, face challenges when applied to segmenting overlapping cells in cleavage-stage embryos. The semi-transparency of the cells in cleavage-stage embryos leads to vague boundaries and complex overlaps between cells, making it difficult for existing models to segment these cells without merging or missing cells. In this work, we propose a novel instance segmentation network for segmenting overlapping, semi-transparent cleavage-stage embryo cells. Specifically, the network introduces two specialized branches that learn complementary representations: an overlap branch for addressing inter-instance overlaps and a boundary branch for dealing with intra-instance shapes. Then, an attention-based feature fusion module is designed to integrate learned overlap and boundary features to enhance the instance representation for the segmentation branch. Finally, an overlap-aware post-processing module leverages the outputs from the overlap and boundary branches to adaptively adjust suppression thresholds, ensuring the preservation of distinct yet highly overlapping cells. Experiments on two cleavage-stage embryo datasets demonstrate that our method outperformed state-of-the-art methods in both segmentation accuracy and recall, highlighting its potential for quantitative embryo evaluation in clinical IVF. Note to Practitioners—This work aims to automate the subjective and time-consuming process of manual morphology evaluation of cleavage-stage embryos, a critical step for selecting the most viable embryos in in vitro fertilization (IVF) treatment. Existing methods for segmenting embryo cells struggle with the semi-transparent and overlapping nature of embryo cells, leading to merging or missing results. To address these issues, this paper introduces a dual-branch architecture to explicitly model inter-instance overlaps and intra-instance shapes for overlapping cells. An attention-based feature fusion module is designed to integrate learned overlap and boundary features, providing enhanced features for the segmentation branch. An overlap-aware post-processing module is designed to refine predictions by adaptively preserving distinct yet overlapping cells. Experiment results suggest that the proposed method outperformed existing instance segmentation methods, particularly in high-overlap scenarios. The proposed method offers an accessible tool for automated embryo evaluation and has applicability to analyzing other semi-transparent cell types in medical imaging.},
 author = {Sun, Chen and Liu, Hang and Shan, Guanqiao and Hu, An and Song, Haocong and Chen, Wenyuan and Chen, Lei and Wang, Shanshan and Sun, Haixiang and Sun, Yu},
 doi = {10.1109/TASE.2026.3665874},
 issn = {1558-3783},
 journal = {IEEE Transactions on Automation Science and Engineering},
 keyword = {Embryo;Instance segmentation;Shape;Feature extraction;Image edge detection;Automation;Vectors;Microscopy;In vitro fertilization;Computer architecture;Cleavage-stage embryo evaluation;embryo cell segmentation;overlapping instance segmentation},
 month = {},
 number = {},
 pages = {5225-5236},
 title = {Automated Instance Segmentation Network for Overlapping Cells in Cleavage-Stage Embryos},
 volume = {23},
 year = {2026}
}
