@article{FATHIANSABET2025119148,
 abstract = {This study addresses the lack of unified assessments for hydrogen-enabled polygeneration systems that co-evaluate thermodynamics, cost, resource depletion, and life cycle assessment (LCA) with CO₂ capture. An integrated framework combining energy–exergy, exergoeconomic, depletion number (Dp), and LCA is applied to two production chains: NG–H₂ (via gas–steam combined cycle) and WG–H₂ (via phosphoric acid fuel cell (PAFC)), both utilizing Monoethanolamine (MEA) post-combustion capture. The Dp ratio quantifies resource depletion, with lower values indicating reduced pressure on resources. Thermodynamic analysis shows NG–H₂ has lower total exergy destruction (205.8 MW) and product costs (ammonia 0.93 $/kg, methanol 0.83 $/kg) compared to WG–H₂ (484.0 MW, ammonia 1.52 $/kg, methanol 1.24 $/kg). However, resource depletion reverses the ranking once recovery/credits are accounted for: Dp = 3.97 (NG–H₂) vs 1.07 (WG–H₂), reflecting WG–H₂'s markedly lower reliance on non-renewable exergy. LCA likewise favors WG–H₂: CO₂ emissions for H₂ reduce from 9.03 to −0.97 kg CO₂e kg⁻¹ , PAFC power from 0.623 to −0.012 kg CO₂e kWh⁻¹ , and methanol and ammonia to 1.36 and 0.25 kg CO₂e kg⁻¹ . In NG–H₂, CO₂ capture reduces power emissions from 0.64 to 0.35 kg CO₂e kWh⁻¹ and lowers methanol/ammonia emissions to 3.77/3.26 kg CO₂e kg⁻¹ , while H₂ remains at 14.26 kg CO₂e kg⁻¹ . Sensitivity analysis shows that beyond ∼890–920 °C, thermodynamic gains diminish. Halving the heat tariff reduces WG–H₂ H₂ cost by ∼20 % (co-products ∼18–19 %), whereas halving gasifier/PAFC CAPEX yields only 1–3 % savings. This framework provides actionable guidance, helping prioritize low-cost/low-carbon heat recovery and thermal integration for WG–H₂, and capital optimizations for NG–H₂.},
 author = {Arya {Fathian Sabet} and Masoumeh {Bararzadeh Ledari} and Farhad Maleki and Maryam Fani},
 doi = {https://doi.org/10.1016/j.jece.2025.119148},
 issn = {2213-3437},
 journal = {Journal of Environmental Chemical Engineering},
 keyword = {Exergy analysis, thermoeconomics, hydrogen production, waste-to-energy, CO₂ utilization, sustainable fuels},
 number = {5},
 pages = {119148},
 title = {Exergy and thermoeconomic comparison of sustainable methanol and ammonia production from waste and CO₂},
 url = {https://www.sciencedirect.com/science/article/pii/S2213343725038448},
 volume = {13},
 year = {2025}
}
