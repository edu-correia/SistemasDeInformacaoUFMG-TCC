@conference{Barton2016831,
 abstract = {Many clustering evaluation methods are computed as a ratio between two objectives, typically these objectives express the compactness of all clusters while trying to maximize the separation between individual clusters. However, the clustering process itself is typically implemented as a single objective problem: optimizing a linear combination of between-points closeness. We propose MoCham-a hierarchical clustering algorithm that uses a multi-objective optimization for finding the optimal data points to merge. Our results suggest that a careful candidate selection of Pareto dominating pairs leads to more robust clustering results. © 2016 IEEE.},
 author = {Barton, Tomas and Bruna, Tomas and Kordik, Pavel},
 doi = {10.1109/ICDMW.2016.0123},
 journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
 note = {Cited by: 2},
 pages = {831 - 838},
 publication_stage = {Final},
 source = {Scopus},
 title = {MoCham: Robust Hierarchical Clustering Based on Multi-objective Optimization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85015153690?origin=resultslist},
 volume = {0},
 year = {2016}
}
