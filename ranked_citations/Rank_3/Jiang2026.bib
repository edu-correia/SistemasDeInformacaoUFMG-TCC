@article{Jiang2026,
 abstract = {Federated learning (FL) is a distributed machine learning method that allows a single server to collaborate with multiple clients to build machine learning models without sharing datasets. Due to the heterogeneity of data between clients, there are significant differences between the trained local models, especially when specific information layer parameters extracted from the local models interfere with the convergence performance of the global model. To address this issue, we propose Hierarchical Partial Merge Multi-Tailed Federated Learning (HPM-Fed). This algorithm searches for the merging coefficient of each layer by using genetic evolution on the parameters of each layer in the local model; Freeze specific information layers in the local model and do not participate in merging; Merge similar specific information layers in the local model to construct a multi tailed global model. We conducted experimental verification on HPM-Fed in supervised learning, semi-supervised learning, and unsupervised learning scenarios. The experimental results show that HPM-Fed has the advantage of seamless integration with existing algorithms on the mnist, fashion-mnist, svhn, cifar-10, and cifar-100 datasets, and has significant advantages compared to the baseline in the three scenarios. © 2026 Elsevier B.V.},
 author = {Jiang, Zhi and Luo, Chang-Yin and Zhang, Cong-Qiang and Chen, Xue-Bin and Tian, Shuo and Liu, Pu-Yuan},
 doi = {10.1016/j.neucom.2026.133608},
 journal = {Neurocomputing},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {HPM-Fed: Hierarchical partial merge multi-tailed federated learning},
 type = {Article},
