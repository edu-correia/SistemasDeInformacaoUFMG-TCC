@inproceedings{8011886,
 abstract = {This paper presents the research of new airborne ADS-B-based applications on arrival phase. The research includes simulation and analysis of such applications as communication, navigation and surveillance (CNS) functions [1]. The two prototypes of airborne procedures was developed and modified: · Flight-Deck Interval Management (FIM) Merging procedure - airborne procedure which provides longitudinal interval between aircraft at the merge point; · Approach Spacing for Instrument Approaches (ASIA) procedure - airborne procedure which provides longitudinal interval between aircraft on the Standard Terminal Arrival Route (STAR). To assess the influence on aIr traffic characteristics ADS-B-based functions were compared with equal standard A TC interval management functions and standard function of transition to holding zone. Only airborne ADS-B-based applications and standard functions were involved in one from the same two experiments with several repeats. As a result of research the metrics were calculated, compared and analyzed for each series of experiments. These metrics represent changes in performance indicators for airborne and standard procedures. The research of airborne applications was conducted in high density air traffic conditions with the impact of random factors. These conditions are as realistic as possible. The random factor is the time of departure from the airport for each experiment repeat. The research was conducted in automatic mode using fast time simulation. The research stand for hardware-in-the-Ioop simulation of air traffic control system (KIS UVD) [2] is a tool for simulation of ADS-B applications, which includes air traffic model, prototypes of cockpit and A TC controller workstations, CFMU and research manager workstations. This stand allows researching ADS-B applications in fast time mode with CPDLC messages exchange usage. The optimization of aircraft movements control and the decrease of ATC controller workload when some actions are performed onboard are expected as a result of comparison of FIM-ASIA and Standard procedures at the researches.},
 author = {Olesya, Khakhaleva and Kirill, Glagovskii and Daria, Skavinskaya and Vladimir, Kanadin and Alexandra, Ludomir},
 booktitle = {2017 Integrated Communications, Navigation and Surveillance Conference (ICNS)},
 doi = {10.1109/ICNSURV.2017.8011886},
 issn = {},
 keyword = {Lead;Aircraft;Logic gates;Atmospheric modeling;Workstations;Standards;Asia},
 month = {April},
 number = {},
 pages = {1B1-1-1B1-10},
 title = {The research of airborne ADS-B-based procedures of longitudinal separation on arrival phase using fast-time simulation},
 volume = {},
 year = {2017}
}
