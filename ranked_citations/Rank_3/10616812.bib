@inproceedings{10616812,
 abstract = {In the expected age of 2030, the introduction of 6G is set to change communication technologies, enabling the Internet about Everything. While several countries are currently engaged in the advancement of 5G and the start of B5G, certain study groups have already launched on 6G projects. The approaching 6G environment offers improved Quantity of Service (QoS), dedicated to mixed reality and hologram conversation. The merging of different forms of information and communication technology (ICT) such as IoT, artificial intelligence (AI), blockchain, XR, and VR has smoothed the way for 6G’s rise. Emphasizing widespread, virtual, deep, and intelligent connection, 6G is expected to bring radical changes. Despite the technical confidence, researchers must address possible hurdles slowing 6G adoption, exploring alternative methods to meet desired parameters. This review offers insights concerning technological possibilities, obstacles, key areas, alongside issues regarding 6G, giving a breakdown of advances and a framework. The aim is to spur joint efforts and remove technical doubts, encouraging new innovations in 6G.},
 author = {Saxena, Antima and Kumar, R.Vinoth and Al-Farouni, Mohammed and C, Santhosh Kumar. and Karpagam, J. and Kavitha, M.S.},
 booktitle = {2024 4th International Conference on Advance Computing and Innovative Technologies in Engineering (ICACITE)},
 doi = {10.1109/ICACITE60783.2024.10616812},
 issn = {},
 keyword = {6G mobile communication;Technological innovation;5G mobile communication;Shape;Information and communication technology;Blockchains;Security;6G;Quantum Communication;Blockchain Technology;Visible Light Communication (VLC);Terahertz (THz);Artificial Intelligence (AI);Holographic Communication;Multisensory XR;Autonomous Robots;Precision Indoor Alignment},
 month = {May},
 number = {},
 pages = {145-150},
 title = {Navigating of 6G Network into the Latest AI Technology for the Fastest Communication Without Loosing the Data},
