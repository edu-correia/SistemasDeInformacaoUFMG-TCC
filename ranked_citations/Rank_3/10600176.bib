@inproceedings{10600176,
 abstract = {This paper describes a successful application of conventional RF synthesis techniques for the development of a low noise and high stability X-/Ka-band frequency comb generator which historically were forced to use bespoke designs to meet the performance requirements. We implement the multi-octave clustered high frequency comb by merging a low frequency comb generation technology with numerous parallel low-noise frequency synthesizers. The complexity of our system is substantially reduced by shifting to mass-market surface mount components.},
 author = {Toennies, Michael and Wang, Rabi and Diener, William and Matsko, Andrey},
 booktitle = {2024 IEEE/MTT-S International Microwave Symposium - IMS 2024},
 doi = {10.1109/IMS40175.2024.10600176},
 issn = {2576-7216},
 keyword = {Frequency synthesizers;Costs;Radio astronomy;Noise;Surface mount technology;Microwave frequencies;Generators;phase locked loops;microwave circuits;phase noise;pulse generation;frequency conversion},
 month = {June},
 number = {},
 pages = {521-524},
 title = {Microwave Frequency Comb Generator for Radio Astronomy Applications},
 volume = {},
 year = {2024}
}
