@inproceedings{5476199,
 abstract = {Take advantage of pole data to drive efficiency in your daily tasks. Joint use, storm damage and accidents are unpredictable events that affect every pole owner to some degree. While unpredictable, they are an opportunity to acquire data which can impact future operations. As regulatory mandates increase and liability becomes an even greater concern, pole owners are required to complete a more thorough evaluation of each pole in less time. To accomplish this, a 3D model changes from a dream to a necessity. Imagine if you could merge all pole data from previous inspections, audits, attachment applications, GIS/mapping system, and engineering projects and use it to build a model of the pole(s) in question before you even send someone to the field; slashing response time while preserving the integrity of the data. The modeling potential expands as all processes are examined to find additional efficiencies. All the while, the data warehouse continues to grow and converge on real-time accuracy, thus leading to answers for the question, "Where do I spend my infrastructure money?".},
 author = {Tackett, Jeff and Schulze, William and Kenney, Brenda},
 booktitle = {2010 IEEE Rural Electric Power Conference (REPC)},
 doi = {10.1109/REPCON.2010.5476199},
 issn = {2153-3636},
 keyword = {Asset management;Telephone poles;Space technology;Engineering management;Data engineering;Geographic Information Systems;Application software;Conference management;Storms;Accidents;Asset Management;Communication;Data Management;Joint Use;Pole Loading;Software;Structural Engineering;System Modeling;System Planning;Utility Pole},
 month = {May},
 number = {},
 pages = {C4-C4-4},
 title = {Implementation of a structure management system},
 volume = {},
 year = {2010}
}
