@conference{Barlow20163525,
 abstract = {Collaboration or teaming is a powerful strategy in which a group of agents work towards one or more common goals. Teaming imposes a base-load cognitive burden upon a participating agent - to be an effective team member the agent must maintain awareness of fellow team-members and employ that information in its decision-making processes. Via a multi-objective evolutionary approach (NSGA-II) the paper explores the Situational Awareness (SA) and computational processing costs necessary for an agent to participate effectively in a proto-team - a flock. Results show that relatively low levels of the available SA information or computational processing (frequency of application of the rules to determine desired velocity) are sufficient to ensure flocking is achieved and maintained. The proposed methodology is expandable to include human teams, human-machine hybrid teams, and exploration of centralised versus decentralised control. © 2016 IEEE.},
 author = {Barlow, Michael and Lakshika, Erandi},
 doi = {10.1109/CEC.2016.7744236},
 journal = {2016 IEEE Congress on Evolutionary Computation, CEC 2016},
 note = {Cited by: 4},
 pages = {3525 - 3532},
 publication_stage = {Final},
 source = {Scopus},
 title = {What cost teamwork: Quantifying situational awareness and computational requirements in a proto-team via multi-objective evolution},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85008263879?origin=resultslist},
 year = {2016}
}
