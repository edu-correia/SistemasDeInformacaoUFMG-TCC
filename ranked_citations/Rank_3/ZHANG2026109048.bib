@article{ZHANG2026109048,
 abstract = {Accurate automated categorization of brain tumors from MRI scans is crucial for clinical diagnosis but remains challenging due to minor inter-class variations, pronounced heterogeneity, and unbalanced class distributions. The study introduces BoT-YOLOv6, a hybrid model derived from YOLOv6 that integrates Bottleneck Transformer (BoT) units into the backbone, combining localized convolutional feature learning with global context representation based on self-attention. BoT modules are embedded within the final RepBlocks of stages C3, C4, and C5, and the system is trained with a class-weighted Binary Cross-Entropy objective to mitigate the effects of data imbalance. Extensive testing with stratified 5-fold cross-validation on the Kaggle Brain Tumor MRI collection reveals strong outcomes, achieving an average accuracy of 96.37% ± 0.99% and a macro-F1 of 96.21% ± 1.02%, which surpasses modern CNN, Transformer, and hybrid reference models (p<0.05). The framework also transfers effectively, obtaining 94.87% ± 1.29% accuracy and 94.92% ± 1.29% macro-F1 on the external Figshare dataset under a three-class protocol. Moreover, resilience to distributional shifts is verified through evaluation on BraTS 2021 glioma grading, where accuracy reaches 90.25% ± 1.44% and F1-score 90.03% ± 1.49%. With compact computational demands (3.6M parameters, 9.1 GFLOPs, and an inference delay of 7.1 ± 0.4 ms), the design sustains efficiency while providing interpretability via Grad-CAM++ visualizations that highlight alignment of model attention with clinically meaningful tumor regions such as cores and edema boundaries. These findings demonstrate the potential of transformer-enhanced hybrid architectures for accurate and efficient brain tumor recognition.},
 author = {Hongkang Zhang and Shao-Lun Huang and Ercan Engin Kuruoglu},
 doi = {https://doi.org/10.1016/j.bspc.2025.109048},
 issn = {1746-8094},
 journal = {Biomedical Signal Processing and Control},
 keyword = {Brain tumor, MRI, Classification, YOLOv6, Transformer, Self-attention},
 pages = {109048},
 title = {Classification and recognition of brain tumors from MRI images based on improved YOLOv6},
 url = {https://www.sciencedirect.com/science/article/pii/S1746809425015599},
 volume = {113},
 year = {2026}
}
