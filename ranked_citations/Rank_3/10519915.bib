@inbook{10519915,
 abstract = {Summary <p>Photonic&#x2010;electronic integration is highly desirable in modern communication systems where digital signal processing (DSP) is deployed in order to compensate for signal distortions caused by fiber optical transmossion effects. DSP in optical communication systems rests on highly complex application specific integrated circuits (ASICs) that are typically fabricated in advanced complementary metal oxide semoconductor (CMOS) processes. This chapter presents an introduction to the ongoing development of front&#x2010;end of line (FEOL) integrated photonic&#x2010;electronic foundry technologies using IHP's high performance SiGe:C BiCMOS process famoly SG25H, which combines a 0.25 &#x3bc;m CMOS core with different hetero&#x2010;junction bipolar transistor (HBT) modules featuring f<sub>T</sub>/f<sub>max</sub> values up to 200GHz. It also explains photonic modules to the baseline technology without compromosing electronic performance with the approach to merge high&#x2010;performance photonics with BiCMOS technology by using local&#x2010;silicon&#x2010;on&#x2010;insulator (SOI) technology. Finally, the chapter presents some first results of FEOL integrated devices and provides an outlook on the technology.</p>},
 author = {Zimmermann, Lars and Knoll, Dieter and Tillack, Bernd},
 booktitle = {Photonics and Electronics with Germanium},
 doi = {10.1002/9783527650200.ch5},
 isbn = {9783527650231},
 issn = {},
 keyword = {Photonics;Substrates;BiCMOS integrated circuits;Costs;Silicon photonics;Epitaxial growth;Optical transmitters},
 number = {},
 pages = {101-121},
 publisher = {Wiley},
 title = {FEOL Integration of Silicon&#x2010; and Germanium&#x2010;Based Photonics in Bulk&#x2010;Silicon, High&#x2010;Performance SiGe},
 url = {https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10519915},
