@inproceedings{5118378,
 abstract = {A committee of learning machines may be conceived of as a group of adaptive systems that adapt independently of each other and whose goal is to solve a common learning problem. Each machine in a committee computes a set of parameter-patterns belonging to a curved space. A natural question is how to combine the learnt patterns in order to obtain a better solution to the learning problem. In the present paper, we treat the case that the parameter space is the Lie group of unitary matrices. In order to combine the learnt patterns, we discuss a possible merging technique based on the differential geometrical structure of the parameter manifold.},
 author = {Fiori, Simone and Tanaka, Toshihisa},
 booktitle = {2009 IEEE International Symposium on Circuits and Systems},
 doi = {10.1109/ISCAS.2009.5118378},
 issn = {2158-1525},
 keyword = {Machine learning;Agricultural engineering;Biomedical engineering;Adaptive systems;Merging;Manifolds;Telecommunications;Agriculture;Independent component analysis;Instruments},
 month = {May},
 number = {},
 pages = {2777-2781},
 title = {Learning-machines-committee averages over the unitary group of matrices},
 volume = {},
 year = {2009}
}
