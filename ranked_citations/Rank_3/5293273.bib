@inproceedings{5293273,
 abstract = {We present an audio-visual user authentication system which extracts multiple face profiles using a simple user-interface and compresses these face profiles into compact transformed face profile (TFP) feature vectors. The MFCC vectors from the spoken password are combined with the TFP vectors to form a joint AV feature vector processed by a simple nearest neighbour classifier. The speaking-style of the user is also efficiently captured by a compact FGRAM-CFD representation of the entire spoken password and merged with the face information by a post-fusion classification. The resulting person authentication framework delivers high performance and resilience against imposter attacks as demonstrated in extensive simulations conducted on an in-house audio-visual userID database, collected in real-life office environment.},
 author = {Das, Amitava and Bedia, Vaibhav},
 booktitle = {2009 IEEE International Workshop on Multimedia Signal Processing},
 doi = {10.1109/MMSP.2009.5293273},
 issn = {},
 keyword = {Authentication;Speech processing;Image coding;Biometrics;Hidden Markov models;Computational fluid dynamics;Mel frequency cepstral coefficient;Resilience;Audio databases;Portable computers},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Audio-visual person authentication with multiple face-profiles and compressed-feature-dynamics signatures of spoken passwords},
 volume = {},
 year = {2009}
}
