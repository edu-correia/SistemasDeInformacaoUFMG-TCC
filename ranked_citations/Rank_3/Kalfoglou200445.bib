@article{Kalfoglou200445,
 abstract = {We discuss approaches to semantic heterogeneity and propose a formalisation of semantic interoperability based on the Barwise-Seligman theory of information flow. We argue for a theoretical framework that favours the analysis and implementation of semantic interoperability scenarios relative to particular understandings of semantics. We present an example case of such a scenario where our framework has been applied as well as variations of it in the domain of ontology mapping. © Springer-Verlag Berlin Heidelberg 2004.},
 author = {Kalfoglou, Yannis and Schorlemmer, Marco},
 doi = {10.1007/978-3-540-25956-5_4},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 26},
 pages = {45 - 60},
 publication_stage = {Final},
 source = {Scopus},
 title = {Formal support for representing and automating semantic interoperability},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/35048855536?origin=resultslist},
 volume = {3053},
 year = {2004}
}
