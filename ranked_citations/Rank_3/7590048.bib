@article{7590048,
 abstract = {This letter proposes a bottom-up saliency model to predict eye fixation locations. Unlike traditional models that measure saliency by computing local or global distinctness, the proposed model considers saliency as the prediction error, because we believe that image patches or pixels with higher prediction error are more salient than others. The prediction error consists of both mispredicted error and unpredicted error. We propose a new algorithm called sparse residual to compute the mispredicted error. We then adopt outlier detection to compute the unpredicted error. Finally, we obtain the saliency map from merging the two results together via a guided filter. Extensive experiments on three benchmark databases show that our model is superior to 12 state-of-the-art models.},
 author = {Tang, He and Chen, Chuanbo and Pei, Xiaobing},
 doi = {10.1109/LSP.2016.2617340},
 issn = {1558-2361},
 journal = {IEEE Signal Processing Letters},
 keyword = {Visualization;Biological system modeling;Dictionaries;Computational modeling;Predictive models;Feature extraction;Measurement uncertainty;Guided filter;outlier detection;saliency detection;sparse coding},
 month = {Dec},
 number = {12},
 pages = {1736-1740},
 title = {Visual Saliency Detection via Sparse Residual and Outlier Detection},
 volume = {23},
 year = {2016}
}
