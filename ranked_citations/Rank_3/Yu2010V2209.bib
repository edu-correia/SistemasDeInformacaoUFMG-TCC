@conference{Yu2010V2209,
 abstract = {Personalized Web search is an effective means of providing specific results to different users when they submit the same query. How to obtain user's real-time information need is a key issue in personalized search. Existing methods concentrate more on the building user profile based on Web pages/documents which affects the efficiency of search engine. In addition, dynamics of user profile is often ignored. To address this problem, we introduce an approach that captures the user context to accurately provide preferences of users for effective personalized search in this paper. First, short-term query context is generated from Web-snippets to play a role of semantic background of user's search behavior, identifying related concepts of the query. Second, user context snap is built based on query context according to user's interactive search behavior. Finally, evolution of user context is considered by introducing forgetting factor to merge the independent user context snap in a user session. The experimental results fully demonstrate that our approach can successfully build user context according to individual user information need. © 2010 IEEE.},
 author = {Yu, Jie and Liu, Fangfang},
 doi = {10.1109/ICCET.2010.5485223},
 journal = {ICCET 2010 - 2010 International Conference on Computer Engineering and Technology, Proceedings},
 note = {Cited by: 13},
 pages = {V2209 - V2214},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mining user context based on interactive computing for personalized Web search},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77958065482?origin=resultslist},
 volume = {2},
 year = {2010}
}
