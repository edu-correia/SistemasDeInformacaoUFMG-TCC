@inproceedings{5967190,
 abstract = {This paper describes implementation of a software system for analyzing data model correctness. Proposed system is based on integration of an automated reasoning system with CASE tool output in aim to automate the process of data model evaluation. The system is based on transformation of XML form of a conceptual data model to predicate logic form and merging with data model quality rules. Result of this merging is formatted as Prolog clauses that present an input to automated reasoning system. Analysis is performed upon the conceptual model regarding all the rules and gives an answer if the data model is correct generally and analytically from certain aspect.},
 author = {Kazi, Z. and Radulovic, B.},
 booktitle = {2011 Proceedings of the 34th International Convention MIPRO},
 doi = {},
 issn = {},
 keyword = {Data models;Cognition;Object oriented modeling;Software tools;Unified modeling language;Erbium;Finite element methods},
 month = {May},
 number = {},
 pages = {935-940},
 title = {Software tool for automated analysis of conceptual data model},
 volume = {},
 year = {2011}
}
