@conference{Rao2024246,
 abstract = {Introducing a groundbreaking Intrusion Detection System (NLPIDS), we merge natural language processing with ensemble-based machine learning. This innovative system converts natural language HTTP requests into vectors, which are then utilized to train various supervised and ensemble-based machine learning models. These models are subsequently deployed to detect anomalous traffic patterns. Validation of our methodology was conducted using the HTTP DATASET CSIC 2010, showcasing the effectiveness of NLPIDS with exceptional F1-score (0.999) and minimal false alarms (0.007) compared to traditional methods. Significantly, NLPIDS operates independently of specific attack methodologies and feature vectors.  © 2024 IEEE.},
 author = {Rao, Trupthi and Kodipalli, Ashwini and Gargi, N. and Soma, Bhavani},
 doi = {10.1109/CISCSD63381.2024.00062},
 journal = {Proceedings - 2024 International Conference on Computational Intelligence for Security, Communication and Sustainable Development, CISCSD 2024},
 note = {Cited by: 0},
 pages = {246 - 251},
 publication_stage = {Final},
 source = {Scopus},
 title = {Machine Learning and NLP Integration for Robust Network Intrusion Detection},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105000689168?origin=resultslist},
 year = {2024}
}
