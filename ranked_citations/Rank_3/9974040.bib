@inproceedings{9974040,
 abstract = {Railway construction can strengthen the connection between urban agglomerations in the region and promote economies. In this paper, we select the Yangtze River Delta as the empirical object, abstract the railway network in the study period into a directed adjacency matrix according to the social analysis method in the complex network theory, and design the index from the perspective of integration. Then, we use Python and ArcGIS to show the changing trend of railway integration degree in time and space in the Yangtze River Delta from 2008 to 2021 to explore the impact of railway integration on urban integration and try to analyze the reasons behind the changes by the meaning of the designed integration indicators and our previous investigation results. We found that railway integration strengthens the degree of urban integration qualitatively speaking. From 2008 to 2021, the railway density in the Yangtze River Delta increased significantly, the average eccentricity among urban agglomerations decreased, and there was an obvious small-world effect in the Yangtze River Delta. Besides, in space, the number of sub-hot spots of weighted centrality increased significantly in 2021 compared with 2008, and new agglomerated subgroups appeared in 2021, with some cities in Anhui merged into the region.},
 author = {Xie, Yang and Jiang, Yulin and Hu, Zenan},
 booktitle = {2022 International Conference on Data Analytics, Computing and Artificial Intelligence (ICDACAI)},
 doi = {10.1109/ICDACAI57211.2022.00056},
 issn = {},
 keyword = {Data analysis;Urban areas;Complex networks;Network analyzers;Big Data;Market research;Rail transportation;Railway Integration;Complex Network;Social Network Analysis Method;GIS Spatial Analysis Method;Data Mining},
 month = {Aug},
 number = {},
 pages = {241-246},
 title = {Integration of Railway Network in Yangtze River Delta based on Train Big Data and Complex Network Theory: Empirical Evidence from 2008 to 2021},
 volume = {},
 year = {2022}
}
