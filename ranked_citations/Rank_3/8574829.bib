@inproceedings{8574829,
 abstract = {An optical-wireless code-shift-keying (CSK) system utilizing dual modified pseudo orthogonal M-sequence sets (DMPOMs) has been proposed by authors. DMPOM is generated by merging modified pseudo orthogonal M-sequence sets (outer code), bi-orthogonal code and orthogonal M-sequences (inner code). In this paper, bit error rate (BER) of the optical-wireless CSK/asynchronous CDMA is investigated in 2-user communication. Consequently, for the realization of the CSK/CDMA, it is effective to utilize the inner codes generated by different feedback taps.},
 author = {Tokunaga, Takashi and Habuchi, Hiromasa and Kozawa, Yusuke and Sun, Ran},
 booktitle = {2018 IEEE 7th Global Conference on Consumer Electronics (GCCE)},
 doi = {10.1109/GCCE.2018.8574829},
 issn = {2378-8143},
 keyword = {Optical transmitters;Optical receivers;Bit error rate;Optical feedback;Multiaccess communication;Adaptive optics},
 month = {Oct},
 number = {},
 pages = {791-795},
 title = {BER Performance Impaired by Transmission Time Offset between Users in Optical Wireless CSK/ACDMA System Using DMPOMs},
 volume = {},
 year = {2018}
}
