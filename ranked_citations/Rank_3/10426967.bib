@inproceedings{10426967,
 abstract = {In the present day, the business and social landscape is characterized by intricate complexities, intense competition, and constant changes. Consequently, the need for making timely decisions based on dependable, precise, and promising data has become paramount. Fusion cube is a solution for analyzing top-level management needs without the intervention of data analysts and programmers. The current problems in the fusion cube are the small accuracy and not many studies that explain the steps in doing the fusion cube at each stage. In this paper, we will explain how the fusion cube is carried out and how hypernym and hyponym influence the accuracy of the fusion cube. The conformed dimension search approach with hypernyms and hyponyms can improve accuracy in forming a new cube, because the search area in matching semantic similarity is wider in hypernyms and hyponyms. The precision value using synonyms, hypernyms and hyponyms for 15 cubes is 92%.},
 author = {Roshinta, Trisna Ari and Widagdo, Tricya Esterina and Azizah, Fazat Nur},
 booktitle = {2023 8th International Conference on Information Technology and Digital Applications (ICITDA)},
 doi = {10.1109/ICITDA60835.2023.10426967},
 issn = {},
 keyword = {Semantics;Merging;Buildings;Complexity theory;Business intelligence;Information technology;Self-service;fusion cubes;data cube;conformed dimension;semantic similarity},
 month = {Nov},
 number = {},
 pages = {1-8},
 title = {Hypernym and Hyponym Improve the Conformed Dimension Identification of Fusion Cube in Self-Service Business Intelligence},
 volume = {},
 year = {2023}
}
