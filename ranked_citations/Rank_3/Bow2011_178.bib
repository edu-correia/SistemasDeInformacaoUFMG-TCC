@article{Bow2011_178,
 abstract = {Regionalization is a fact in North America, but regionalism has barely gotten off the ground. Several factors have been proposed to explain the underdevelopment of regional institutions in North America: divergent interests and priorities, concerns about sovereignty, nationalism, and, particularly since 9/11, the United States' preoccupation with policing its borders. One other important element has been largely left unexplored in government and academic studies: anti-Americanism. In considering the prospects for deeper North American integration, the persistence and effects of anti-Americanism in Mexico is definitively a factor. It is complex and subtle, with numerous currents spouting from a single wellspring: the U.S. refusal to recognize Mexico as an equal partner. This article takes a historical and contextual approach to tracking its evolution.},
 author = {Bow, Brian and Santa-Cruz, Arturo},
 number = {2},
 pages = {35--66},
 title = {Mexican Anti-Americanism And Regional Integration in North America},
 volume = {6},
 year = {2011}
}
