@inproceedings{9141741,
 abstract = {Nowadays for the devices of intelligent substations, testers only aim at testing single device instead of integrating whole substations. According to the “three-level and two-network” substation structure and based on the standard operation instructions, intelligent substation integrated intelligent test system targets at systematic and complete test and carries out the test work of project quickly and exactly through professional debugging tools supplied by integration system. This system can not only make the test work more perfect and effective, but also reduce the working strength of operators and improve the work efficiency and quality significantly.},
 author = {Xi, Liu and Jituo, Chen and Jianyou, Yang and Yuzhi, Zhou and Bifu, Qian},
