@article{11435382,
 abstract = {Satellite-derived remote sensing has emerged as an indispensable tool for monitoring dynamic shorelines and coastal environments. However, persistent challenges remain with single-satellite adoptions, including limited spatial resolutions, spectral constraints, low revisit cycles, and atmospheric interferences, which hinder their efficacy. This review summarizes recent advancements in multisatellite fusion, which integrates data derived from different available satellites that can be equipped with multispectral or hyperspectral cameras, synthetic aperture radar (SAR), and light detection and ranging (LiDAR), to enhance accuracy and reliability in coastal monitoring. New strategies that synergize pixel-level and feature-level fusion techniques can address critical challenges in coastal remote sensing. Improvements in pixel-level fusion techniques, such as pan-sharpening, can also significantly enhance spatial resolution by merging high-resolution commercial satellites (e.g., WorldView-3, PlanetScope, SPOT) with lower-resolution public satellites (e.g., Sentinel-2, Landsat). Complementary feature-level fusion techniqueshelp to perceive contextual integrity through spectral indices, texture analysis, and machine learning. The synergistic integration of cloud-penetrating SAR (e.g., Sentinel-1) and precise LiDAR (e.g., ICESat-2) with optical data (e.g., Landsat, Sentinel-2) further enables all-weather monitoring capabilities, particularly valuable for tropical coasts with persistent cloud cover. These advancements in multisensor fusion highlight the potential for further precise and scalable satellite-based coastal monitoring, which can aid in climate-resilient solutions for sustainable coastal management.},
 author = {Trinh, Ha Linh and Lim, Jing Xian and Kieu, Hieu Trung and Er, Jenn Wei and Pang, Dawn Sok Cheng and Law, Adrian Wing-Keung},
 doi = {10.1109/JSTARS.2026.3674566},
 issn = {2151-1535},
 journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
 keyword = {Sea measurements;Monitoring;Satellites;Spatial resolution;Optical sensors;Optical imaging;Synthetic aperture radar;Laser radar;Water quality;Landsat;Coastal environments;dynamic shorelines;multisatellite;remote sensing;sensor fusion},
 month = {},
 number = {},
 pages = {10910-10935},
 title = {Multisensor Fusion for Monitoring Shorelines and Coastal Environments: A Review and Perspective With Satellite Imagery},
 volume = {19},
 year = {2026}
}
