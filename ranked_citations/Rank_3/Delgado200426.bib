@article{Delgado200426,
 abstract = {As a result of the use of OLAP technology in new fields of knowledge and the merge of data from different sources, it has become necessary for models to support this technology. In this paper, we propose a new multidimensional model that can manage imprecision both in dimensions and facts. Consequently, the multidimensional structure is able to model data imprecision resulting from the integration of data from different sources or even information from experts, which it does by means of fuzzy logic. © Springer-Verlag Berlin Heidelberg 2004.},
 author = {Delgado, Miguel and Molina, Carlos and Sánchez, Daniel and Ariza, Lázaro Rodriguez and Vila, M. Amparo},
 doi = {10.1007/978-3-540-25945-9_3},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 8; All Open Access; Green Open Access},
 pages = {26 - 36},
 publication_stage = {Final},
 source = {Scopus},
 title = {A flexible approach to the multidimensional model: The fuzzy datacube},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/7444228739?origin=resultslist},
 volume = {3040},
 year = {2004}
}
