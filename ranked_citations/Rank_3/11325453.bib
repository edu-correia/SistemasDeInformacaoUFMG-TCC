@inproceedings{11325453,
 abstract = {Mobile Ad Hoc Networks (MANETs) comprise self-configurable and autonomous mobile nodes that communicate without infrastructural support. Address autoconfiguration protocols in MANETs assign unique IP addresses to the joining nodes automatically. However, the absence of secure authentication allows attackers to spoof IP addresses, hijack traffic, cause packet drops, and disrupt end-to-end data delivery. To address these vulnerabilities, this paper proposes a secure address autoconfiguration protocol for MANETs. The protocol binds IP addresses to public keys, enabling self-authentication for nodes and mitigating attacks such as spoofing, false conflicts, and exhaustion. It employs a modified IPv6 format with partition and cluster identifiers, ensuring scalability, low latency, and reduced overhead during network partitioning and merging. Simulations using NS-2.35 demonstrate that the proposed protocol outperforms existing methods, achieving up to 70% lower communication overhead and 50% reduced latency while maintaining security in dynamic environments. This work provides a practical solution for reliable MANET deployment in military operations and disaster recovery applications.},
 author = {Maurya, Chanchal and Raghav and Chaurasiya, Vijay Kumar},
 booktitle = {2025 IEEE 7th International Conference on Computing, Communication and Automation (ICCCA)},
 doi = {10.1109/ICCCA66364.2025.11325453},
 issn = {},
 keyword = {Protocols;Scalability;Authentication;Public key;Ad hoc networks;Mobile nodes;IP networks;Security;Reliability;Mobile computing;Mobile Ad-hoc Network (MANET);Authentication;Network Simulator (NS);Auto-configuration Protocols;Latency},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Secure Address Auto-configuration Protocol for Mobile Ad-hoc Networks},
 volume = {},
 year = {2025}
}
