@article{KWAN2005134,
 abstract = {The heavy-ion fusion program is conducting several ion source and injector experiments to support ongoing HIF beam transport experiments and to develop new injector concepts for future fusion drivers. In the area of large diameter surface source, we studied the beam optics, experimented with aperturing, and benchmarked the computer simulation code. Steady progress was made in the merging beamlet experiment. The RF plasma source was optimized to produce high current density beamlets. Computer simulation of merging beamlets had produced a design and the hardware is being fabricated. We are examining a new concept based on accel–decel injection to produce super-high line charge density for application in driving targets for high energy density physics studies. Since trapping of secondary electrons in high current positive ion beams is still a concern for HIF, we consider a backup option using negative ion beams.},
 author = {J.W. Kwan and D. Baca and E. Henestroza and J. Kapica and F.M. Bieniosek and W.L. Waldron and J.-L. Vay and S. Yu and G.A. Westenskow and D.P. Grote and E. Halaxa and I. Haber and L. Grisham},
 doi = {https://doi.org/10.1016/j.nima.2005.01.202},
 issn = {0168-9002},
 journal = {Nuclear Instruments and Methods in Physics Research Section A: Accelerators, Spectrometers, Detectors and Associated Equipment},
 keyword = {RF multicusp source, Ion source, Injector, Beam optics, Emittance, Simulation},
 note = {Proceedings of the 15th International Symposium on Heavy Ion Inertial Fusion},
 number = {1},
 pages = {134-141},
 title = {Ion source and injector experiments at the HIF/VNL},
 url = {https://www.sciencedirect.com/science/article/pii/S0168900205003104},
 volume = {544},
 year = {2005}
}
