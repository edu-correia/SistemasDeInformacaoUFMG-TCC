@article{10.1145/3806036,
 abstract = {This study investigates gaze behavior as a potential biomarker for individuals with Social Anxiety Disorder during immersive virtual reality socio-evaluative tasks. Thirty participants diagnosed with SAD and thirty matched healthy controls completed three VR tasks while eye movements were recorded. Gaze features were analyzed using a neural predictive model with PAC-Bayes estimating generalization and uncertainty. The model predicted group membership with accuracies of 87 % and 93 % for performance and social tasks, with certified PAC-Bayes lower bounds accuracy of 78 % and 84 %, respectively. Variations in social demand across tasks were associated with corresponding differences in predictive gaze features. Gender bias was investigated, but was not detected. Model predictions correlated strongly with standardized psychometric measures. These findings indicate that VR-based eye tracking, combined with machine learning models, provides a scalable, explainable, and objective method to assess SAD.},
 address = {New York, NY, USA},
 articleno = {ETRA022},
 author = {Jakobi Wolff Madsen, Ingrid and Zeka, Fatime and Nordentoft, Merete and Dan, Hansen and Birkedal Glenth\o{}j, Louise},
 doi = {10.1145/3806036},
 issue_date = {May 2026},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {Social Anxiety Disorder, Virtual Reality, Eye-tracking, Probability, Classification, Generalization, PAC-Bayes},
 month = {May},
 number = {3},
 numpages = {16},
 publisher = {Association for Computing Machinery},
 title = {Predictive Modeling of Social Anxiety Disorder from Gaze Behavior in Virtual Reality},
 url = {https://doi.org/10.1145/3806036},
 volume = {10},
 year = {2026}
}
