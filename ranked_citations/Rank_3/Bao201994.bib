@conference{Bao201994,
 abstract = {Sina and Tencent microblog social network data (SND) are the basis for the development of top-level applications such as hot topic tracking and key person association analysis. However, the time and space cost of these huge and increasing SND in storage and retrieval brings challenges to traditional databases. The current mainstream approach is to use Hadoop and Hive to provide related services, but it can not be applied in real-time processing scenarios. In this study, we present a query optimization scheme based on non-relational database HBase. Firstly, the table structure is designed according to the characteristics of HBase, such as high efficiency of row keys and column family storage. Secondly, Coprocessor is used to build a secondary index, which transforms some field queries into row key queries of index tables, so that it can support flexible queries of SND with scalability and low latency. The experimental results show that the optimized performance can meet the development needs of the upper business. © 2019 IEEE.},
 author = {Bao, Congkai and Cao, Meiyang},
 doi = {10.1109/ICBDA.2019.8713219},
 journal = {2019 4th IEEE International Conference on Big Data Analytics, ICBDA 2019},
 note = {Cited by: 6},
 pages = {94 - 97},
 publication_stage = {Final},
 source = {Scopus},
 title = {Query Optimization of Massive Social Network Data Based on HBase},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85066613188?origin=resultslist},
 year = {2019}
}
