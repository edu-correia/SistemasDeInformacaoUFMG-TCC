@inproceedings{9971098,
 abstract = {Lexical simplification aims to convert complex words in a sentence into semantic equivalent but simple words. Most existing methods ignore sentence contextual information, which inevitably produces a large number of spurious substitute candidates. To that end, this paper proposes a new context-driven Merge-sort model which leverages contextual information in each step of lexical simplification, and a new merging method to combine ranking results produced by the proposed model. Based on standard datasets, our model outperforms a list of baselines including the state-of-the-art LSBert model, indicating its effectiveness in community-oriented lexical simplification.},
 author = {Li, Rongying and Xie, Wenxiu and Song, Jiayin and Wong, Leung-Pun and Wang, Fu Lee and Hao, Tianyong},
 booktitle = {2022 IEEE International Symposium on Product Compliance Engineering - Asia (ISPCE-ASIA)},
 doi = {10.1109/ISPCE-ASIA57917.2022.9971098},
 issn = {2831-3410},
 keyword = {Semantics;Merging;Asia;Encyclopedias;Coherence;Internet;Online services;Lexical simplification;Merge ranking;Bert;Context2vec},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {A Context-Driven Merge-Sort Model for Community-Oriented Lexical Simplification},
 volume = {},
 year = {2022}
}
