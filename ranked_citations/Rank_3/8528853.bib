@article{8528853,
 abstract = {We aim to study the problem of reconstructing the initial state as well as the sequence of unknown inputs [input and state observability (ISO)] for linear network systems having time-varying topology. Evolution of such systems can be represented by a collection of graphs {gk}. We find conditions under which the system with a pattern of fixed zeros imposed by {gk} is ISO: 1) for almost all choices of edge weights in {gk} (structural ISO) and 2) for all nonzero choices of edge weights in {gk} (strongly structural ISO). We introduce two suitable descriptions of the whole collection of graphs {gk} called the dynamic graph and dynamic bipartite graph. Two equivalent characterizations of structural ISO are then stated in terms of the existence of linking and matching of a suitable size in the dynamic graph and in the dynamic bipartite graph, respectively. For strongly structural ISO, we provide a sufficient condition and a necessary condition, both concerning the existence of a uniquely restricted matching of a suitable size in the dynamic bipartite graph and in a subgraph of it. When there is no direct feedthrough of the input on the measurements, the two conditions can be merged to give rise to a necessary and sufficient condition.},
 author = {Gracy, Sebin and Garin, Federica and Kibangou, Alain Y.},
 doi = {10.1109/TCNS.2018.2880304},
 issn = {2325-5870},
 journal = {IEEE Transactions on Control of Network Systems},
 keyword = {ISO;Topology;Network topology;Observability;Time-varying systems;ISO Standards;Control systems;Cyber-physical security;input and state observability (ISO);linear network systems;strongly structural ISO;structural ISO;time-varying topology},
 month = {June},
 number = {2},
 pages = {897-905},
 title = {Input and State Observability of Network Systems With Time-Varying Topology},
 volume = {6},
 year = {2019}
}
