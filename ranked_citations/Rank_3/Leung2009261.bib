@conference{Leung2009261,
 abstract = {Ontology matching can be defined as the process of discovering similarities between two ontologies and it can be processed exploiting a number of different techniques. To provide a common conceptual basis, researchers have started to develop classifications to distinguish them. The most significant one is the classification proposed by Shvaiko and Euzenat to compare different existing ontology mediation systems as well as to design a new one. As the classification contains some improper identifications and vague categories, we therefore propose a design and input-specific classification framework of ontology matching techniques to address the above problems based on the findings of the literature survey. The framework provides not only a clear guideline on designing new mediation tool but also an effective method to identify the type of the matching technique and its related executive approach simply by comparing input of mediation system with the input layer in the proposed framework. © 2010 ACM.},
 author = {Leung, Nelson K. Y. and Lau, Sim Kim and Fan, Joshua and Kang, Seung Hwan and Tsang, Nicole},
 doi = {10.1145/1806338.1806388},
 journal = {iiWAS2009 - The 11th International Conference on Information Integration and Web-based Applications and Services},
 note = {Cited by: 1},
 pages = {261 - 268},
 publication_stage = {Final},
 source = {Scopus},
 title = {To provide guidelines for designing new mediation tools and identifying matching technique - A classification framework approach},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77954570342?origin=resultslist},
 year = {2009}
}
