@inproceedings{11058840,
 abstract = {Deep Neural Networks (DNNs) has been rapid, yet fully-precision neural network exhibits substantial redundancy during training and inference process. Binary Neural Networks (BNNs) have emerged as an alternative that can greatly conserve computational resources. FPGAs are well-suited as deployment platforms for BNN accelerators for parallel computing capabilities and flexibility. However, most BNN inference accelerators still have room for improvement in terms of tradeoffs between speed, resource usage and accuracy. This paper introduces a light-weight, cost-effective BNN accelerator with low latency. Based on digits dataset from scikit-learn, original network's structure has been optimized by merging function layers and replacing complex Batch Normalization operation by threshold comparing without affecting intermediate results of inference. And the computation parallelism is enhanced by local data reuse and outer product MAC method, which has reduced the inference time by 19.1% compared to pre-optimization stage. At frequency of 100 MHz, the accelerator requires only $11.12 \mu ~\mathrm{s}$ for single-step forward propagation, achieving accuracy of 91% and capable of processing 45.4k images per second. Compared to BNN accelerators with similar accuracy, the computational resources utilized of our design are significantly reduced, indicating greater application potential in resource-constraint artificial devices like edge-AI.},
 author = {Zheng, Yuxin and Hu, Huan and Xu, Yang},
 booktitle = {2024 2nd International Conference on Information Network and Computer Communications (INCC)},
 doi = {10.1109/INCC64392.2024.00018},
 issn = {},
 keyword = {Training;Performance evaluation;Accuracy;Image edge detection;Redundancy;Merging;Parallel processing;Network architecture;Low latency communication;Field programmable gate arrays;Deep Learning;Binarized Neural Network;FPGA accelerator},
 month = {Nov},
 number = {},
 pages = {53-58},
 title = {Design of Cost-Effective Binary Neural Network's Accelerator with Ultra-Low Latency},
 volume = {},
 year = {2024}
}
