@article{Dinh2014768,
 abstract = {Ontology versions are periodically released to ensure their usefulness and reliability over time. This potentially impacts dependent artefacts such as mappings and annotations. Dealing with requires to finely characterize ontology entities' changes between ontology versions. This article proposes to identify change patterns at attribute values when an ontology evolves, to track textual statements describing concepts. We empirically evaluate our approach by using biomedical ontologies, for which new ontology versions are frequently released. Our achieved results suggest the feasibility of the proposed techniques. © 2014 Springer International Publishing.},
 author = {Dinh, Duy and Dos Reis, Julio Cesar and Pruski, Cédric and Da Silveira, Marcos and Reynaud-Delaître, Chantal},
 doi = {10.1007/978-3-319-07443-6_51},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 8},
 pages = {768 - 783},
 publication_stage = {Final},
 source = {Scopus},
 title = {Identifying change patterns of concept attributes in ontology evolution},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84902602809?origin=resultslist},
 volume = {8465 LNCS},
 year = {2014}
}
