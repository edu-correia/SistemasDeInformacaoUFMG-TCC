@conference{Kim20051260,
 abstract = {This research is motivated by the insufficient tools for data sharing and data integration in the relational database model. Data integration requires a union of multiple queries to merge semantically similar data from different sources. The eXtensible Relational Database (XRDB) model [2] is a conceptual solution to this problem and it introduces an extension to SQL, the eXtensible Template Query Language (XTQL), to facilitate and automate data sharing. Copyright 2005 ACM.},
 author = {Kim, Sungryong S.},
 doi = {10.1145/1167350.1167425},
 journal = {Proceedings of the Annual Southeast Conference},
 note = {Cited by: 0},
