@conference{Teng2011306,
 abstract = {Telematics applications are established a vehicle communication environment to merge the information for the traffic safety, road navigation, remote business, A/V entertainment, etc. However, the researches between Google-Android mobile and OBD II/CAN Bus are rarely been discussed in the Android APP. This paper aims to implement an Android-based mobile device platform that successfully program CAN-Bus driver, which could correctly read the data on the ECUs in the vehicle. The results are graphically displayed as a virtual instrument on the mobile panel. © 2011 IEEE.},
 author = {Teng, Heng-Fa and Wang, Meng-Jil and Lin, Cheng-Min},
 doi = {10.1109/IBICA.2011.81},
 journal = {Proceedings - 2011 2nd International Conference on Innovations in Bio-Inspired Computing and Applications, IBICA 2011},
 note = {Cited by: 7},
 pages = {306 - 308},
 publication_stage = {Final},
 source = {Scopus},
 title = {An implementation of Android-based mobile virtual instrument for telematics applications},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84862956165?origin=resultslist},
 year = {2011}
}
