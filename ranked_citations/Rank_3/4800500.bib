@inproceedings{4800500,
 abstract = {A simple and innovative single-use valve based on PCB-MEMS is presented. The power of this valve lies on its activation process and the combination of different technologies to achieve low cost. The activation is a merge of thermal and mechanical phenomena. Other important innovation is the deposition of SU8 over an orifice. This single-use valve has a chamber to include biochemical substances in case the application is of biomedical nature. The integration with other microfluidic and electronic devices has been considered in the design.},
 author = {Aracil, Carmen and Moreno, J. Miguel and Quero, Jose M.},
 booktitle = {2009 Spanish Conference on Electron Devices},
 doi = {10.1109/SCED.2009.4800500},
 issn = {2163-4971},
 keyword = {Microvalves;Printed circuits;Valves;Costs;Microfluidics;Biomembranes;Chemical technology;Resists;Technological innovation;Orifices},
 month = {Feb},
 number = {},
 pages = {334-337},
 title = {Single-use microvalve fabricated using Printed Circuit Board and SU8 technologies},
 volume = {},
 year = {2009}
}
