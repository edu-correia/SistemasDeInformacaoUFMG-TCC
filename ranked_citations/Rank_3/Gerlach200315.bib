@conference{Gerlach200315,
 abstract = {Dynamic Parallel Schedules (DPS) is a high-level framework for developing parallel applications on distributed memory computers (e.g. clusters of PCs). Its model relies on compositional customizable split-compute-merge graphs of operations (directed acyclic flow graphs). The graphs and the mapping of operations to processing nodes are specified dynamically at runtime. DPS applications are pipelined and multithreaded by construction, ensuring a maximal overlap of computations and communications. DPS applications can call parallel services exposed by other DPS applications, enabling the creation of reusable parallel components. The DPS framework relies on a C++ class library. Thanks to its dynamic nature, DPS offers new perspectives for the creation and deployment of parallel applications running on server clusters. © 2003 IEEE.},
 author = {Gerlach, S. and Hersch, R.D.},
 doi = {10.1109/HIPS.2003.1196491},
 journal = {Proceedings of the International Workshop on High-Level Programming Models and Supportive Environments, HIPS},
 note = {Cited by: 2; All Open Access; Green Open Access},
 pages = {15 - 24},
 publication_stage = {Final},
 source = {Scopus},
 title = {DPS - Dynamic parallel schedules},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84941278615?origin=resultslist},
 volume = {2003-January},
 year = {2003}
}
