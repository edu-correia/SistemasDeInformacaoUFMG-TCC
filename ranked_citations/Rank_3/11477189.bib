@inproceedings{11477189,
 abstract = {Classic Label Propagation Algorithms often suffer from high stochasticity and structural fragmentation when applied to large-scale sparse networks. This paper proposes Pre-LPA, a framework that leverages an approximate Edge Betweenness Centrality (EBC) metric to provide deterministic structural guidance and stabilize the propagation process. This paper proposes a Structural Preprocessing LPA Optimization Framework (Pre-LPA) based on Approximate Edge Betweenness Centrality (EBC). Pre-LPA first approximates EBC by efficiently sampling representative nodes. Subsequently, it merges low-EBC edges to form community prototypes and splits high-EBC bridge edges to prevent over-expansion. By leveraging these structurally pre-assigned labels, the framework provides explicit guidance for the propagation process. Compared to the traditional LPA, Pre-LPA significantly enhances both the stability and quality of community detection while maintaining near-linear time complexity, effectively addressing the challenges inherent in large-scale sparse networks.},
 author = {Wu, Yujie},
 booktitle = {2026 5th International Symposium on Computer Applications and Information Technology (ISCAIT)},
 doi = {10.1109/ISCAIT69154.2026.11477189},
 issn = {},
 keyword = {Filtering;Filters;Low-pass filters;Recommender systems;Information filtering;Circuits and systems;Internet of Things;Network topology;Protocols;Internet;Community Detection, Label Propagation Al-gorithm, Structural Preprocessing, Local Centrality, Merging and Splitting, Edge Betweenness Centrality},
 month = {Jan},
 number = {},
 pages = {682-686},
 title = {LPA Optimization Algorithm with Preprocessing Based on Edge Betweenness Approximation},
 volume = {},
 year = {2026}
}
