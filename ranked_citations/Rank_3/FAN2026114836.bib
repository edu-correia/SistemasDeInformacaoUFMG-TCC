@article{FAN2026114836,
 abstract = {Image fusion aims to leverage the complementarity between different source images to synthesize a highly informative image by merging multiple inputs. Existing image fusion methods typically apply a unified feature extraction and fusion process to the entire source image, thereby overlooking the difference of regional features and yielding suboptimal fusion quality. To address this issue, we propose a salient-aware differentiated learning network for infrared and visible image fusion (SDLFusion), which learns inherent differences between salient and background regions via a salient-aware regional fusion strategy and captures complementary features by a differentiated attention mechanism. Firstly, the salient-aware regional fusion strategy is designed to separate the salient region from the background region in source images, which extracts features in a different manner. Subsequently, the differentiated attention mechanism is developed to perform feature interaction in both the salient and background regions, which consists of the frequency integration module, frequency-guided cross Transformer, and spatial interactive attention module. Moreover, we introduce the scene reconstruction path to make the regional features contain abundant information from the source images. Finally, in order to ensure the superior fusion results, the hybrid loss function is employed to enhance the retention of effective information in the fused image. Extensive qualitative and quantitative experiments demonstrate that the proposed SDLFusion outperforms existing image fusion methods on various datasets. Notably, semantic segmentation experiments highlight the potential of our approach for advanced visual tasks.},
 author = {Xiaoting Fan and Xiangyi Zhou and Shuang Liu and Long Sun and Baihua Xiao},
 doi = {https://doi.org/10.1016/j.knosys.2025.114836},
 issn = {0950-7051},
 journal = {Knowledge-Based Systems},
 keyword = {Image fusion, Infrared image, Visible image, Salient-aware, Differentiated attention mechanism},
 pages = {114836},
 title = {SDLFusion: A salient-aware differentiated learning network for infrared and visible image fusion},
 url = {https://www.sciencedirect.com/science/article/pii/S095070512501874X},
 volume = {331},
 year = {2026}
}
