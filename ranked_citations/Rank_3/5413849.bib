@inproceedings{5413849,
 abstract = {To progress the compression performance of standard video coding algorithms, emerging motion compensation techniques will need to be integrated with the current standard techniques such as those used in the H.264. Higher order motion models, geometry-adaptive partitioning and motion-assisted merging are such techniques that can be considered for the next generation of video coders. In this paper, we examine how geometry information can benefit the use of elastic motion models to accomplish better prediction. Relative complexity issues are also discussed which is important in the standardization process. Experimental results suggest that geometry-adaptive block partitioning can add to the performance of elastic motion models to a certain extent, although the increased complexity is of some concern for real-time coding applications.},
 author = {Muhit, Abdullah A. and Pickering, Mark R. and Frater, Michael R.},
 booktitle = {2009 16th IEEE International Conference on Image Processing (ICIP)},
 doi = {10.1109/ICIP.2009.5413849},
 issn = {2381-8549},
 keyword = {Motion compensation;Solid modeling;Merging;Layout;Information geometry;Video coding;Australia;Video sequences;Partitioning algorithms;Video compression;H.264;Elastic motion model;Geometry-adaptive partitioning},
 month = {Nov},
 number = {},
 pages = {621-624},
 title = {Motion compensation using geometry and an elastic motion model},
 volume = {},
 year = {2009}
}
