@article{PANNIER2023117087,
 abstract = {In this work, we compare different methods for the automatic segmentation of microtomographic images at the mesoscopic scale of 3D woven carbon fibre composite materials. We use a dense neural network approach fed with features based on the monogenic signal and features learned by a convolutional neural network. To determine local fibre orientations in the composite, we also propose to use the monogenic signal with a structure tensor approach. The performance of the segmentation methods is compared on a first sample for which a reference solution is given. To demonstrate the global capability of the method, the neural networks are then used to segment a second similar sample, for which there is no reference solution. A transfer learning strategy is proposed to take advantage of the knowledge learned on the first sample and to limit the interaction with the user. This simply consists of re-learning only the decision layers, thus limiting the number of examples required. Finally, the best result is obtained with a combination of the signal-based approach and the learning-based approach by merging the monogenic and convolutional neural network features.},
 author = {Yannick Pannier and Pierre Coupé and Thibault Garrigues and Mikaël Gueguen and Philippe Carré},
 doi = {https://doi.org/10.1016/j.compstruct.2023.117087},
 issn = {0263-8223},
 journal = {Composite Structures},
 keyword = {3D woven composite, Segmentation, X-ray computed tomography, Fibres orientation, Texture analysis, Monogenic transform, Convolutional neural network, Dense neural network},
 pages = {117087},
 title = {Automatic segmentation and fibre orientation estimation from low resolution X-ray computed tomography images of 3D woven composites},
 url = {https://www.sciencedirect.com/science/article/pii/S0263822323004312},
 volume = {318},
 year = {2023}
}
