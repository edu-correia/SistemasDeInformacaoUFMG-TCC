@inproceedings{4463354,
 abstract = {A four levels hierarchy wireless body sensor network (WBSN) is proposed for monitoring healthcare applications. It is separated into communication and control systems. In the communication system, the carrier frequency used in the human body is 402-405 MHz as medical implant communication systems (MICS) band by FCC and the coexistent wireless communication system (2.4 / 60 GHz) was used to transmit the merged biomedical data in the higher levels of the communication system. An adaptive low power and variable resolution control systems are designed into the control system. In order to improve the performance, a communication cycle is created for synchronizing the WBSN system with pipeline control. Each sensor node consists of a micro control unit (MCU), variable sample rate generator, sensor, ADC, data encoder, 402-405 MHz RF transceiver, and antenna. This paper presents a WBSN system, which not only gains the benefits of more flexible, easy development, run-time reconfigurable and variable resolution, but also significantly reduces considerable power consumptions with adaptive low power design.},
 author = {Chen, Shih-Lun and Lee, Ho-Yin and Chen, Chiung-An and Lin, Chin-Chun and Luo, Ching-Hsing},
 booktitle = {2007 IEEE Biomedical Circuits and Systems Conference},
 doi = {10.1109/BIOCAS.2007.4463354},
 issn = {2163-4025},
 keyword = {Wireless sensor networks;Body sensor networks;Medical services;Communication system control;Control systems;Medical control systems;Biomedical monitoring;Frequency;Humans;Implants;Wireless body sensor network;communication cycle;adaptive low power;variable resolution},
 month = {Nov},
 number = {},
 pages = {243-246},
 title = {A Wireless Body Sensor Network System for Healthcare Monitoring Application},
 volume = {},
 year = {2007}
}
