@inproceedings{7378356,
 abstract = {This paper proposes an effective fuzzy obstacle avoidance approach to guide the mobile robot to the target without colliding with obstacles in the environment. First, the control problem and the model of the mobile robot are introduced. Then, the sensor module setting is described for detecting the environmental obstacles. Based on the sensor coordination scheme, the sensing data is merged for simplify the complexity of the controller. Afterward, the obstacle avoidance fuzzy logic controller is presented by involving human's intelligence. Compared with model-based control, the fuzzy logic control has more implement flexibility and high integration with multiple sensors. Finally, simulations are performed to demonstrate the feasibility and effectiveness of the proposed control method.},
 author = {Chiu, Chian-Song and Chiang, Teng-Shung and Ye, Yu-Ting},
 booktitle = {2015 International Automatic Control Conference (CACS)},
 doi = {10.1109/CACS.2015.7378356},
 issn = {},
 keyword = {Yttrium;Fuzzy logic;Robot kinematics;Mobile communication;Mobile robot;Obstacle avoidance;Fuzzy logic control},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Fuzzy obstacle avoidance control of a two-wheeled mobile robot},
 volume = {},
 year = {2015}
}
