@article{10534776,
 abstract = {Single-pixel imaging (SPI) leverages sequential pattern illumination and intensity detection to reconstruct images, facing the challenge of balancing high-resolution output with ultra-low sampling rates for rapid imaging processes. We introduce a network architecture specifically tailored for SPI, which demonstrates improved performance even before integrating with SPI’s physical sampling processes. This integration, particularly focusing on the nuanced effects of sampling rates within the model’s loss function and data preprocessing, enhances image reconstruction quality and adaptability at low sampling rates, down to 1.56%. Our approach achieves a balance between advanced computational methods and the physical principles of SPI, resulting in a peak signal-to-noise ratio of 30.93 dB, a structural similarity index measure of 0.8818, and a perceptual index (PI) of 5.31 at a 6.25% sampling rate, alongside a notable PI of 2.68 at a 1.56% sampling rate in practical tests. By merging sophisticated network design with strategic integration of physical sampling rates, our model provides a refined solution for high-quality, high-resolution SPI at minimal sampling rates, facilitating progress in ultra-fast imaging applications.},
 author = {Liu, Zonghao and Zhang, Huan and Zhou, Mi and Jiao, Shuming and Zhang, Xiao-Ping and Geng, Zihan},
 doi = {10.1109/ACCESS.2024.3402693},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {Image reconstruction;Imaging;Lighting;Superresolution;Training;Generators;Computational modeling;Generative adversarial networks;Ultrafast electronics;Single-pixel imaging;super-resolution;generative adversarial network;computational imaging;perceptual image-error assessment;ultra-low sampling rate;ultrafast imaging},
 month = {},
 number = {},
 pages = {78496-78504},
 title = {Adaptive Super-Resolution Networks for Single-Pixel Imaging at Ultra-Low Sampling Rates},
 volume = {12},
 year = {2024}
}
