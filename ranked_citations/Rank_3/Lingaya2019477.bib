@article{Lingaya2019477,
 abstract = {Graph-theoretic clustering is one method of clustering where dataset is represented with a connected undirected graph having the distance between these points as the weights of the links between them. One approach is the construction of the Minimum Spanning Tree of said graph where the connected subgraphs formed after the removal of an inconsistent edge are the clusters. However, such methods suffer with drawbacks including partitioning without sufficient evidence and robustness to outliers. Hence, this work aims to modify the Prim's MST-based clustering algorithm to produce a spanning tree of the dataset infusing the small-world network thereby invoking its properties (i.e. small mean shortest path length and high clustering coefficient) which manifest inherent or natural clustering characteristics. © 2008-2019. International Journal of Machine Learning and Computing.},
 author = {Lingaya, Sheila R. and Gerardo, Bobby D. and Medina, Ruji P.},
 doi = {10.18178/ijmlc.2019.9.4.829},
 journal = {International Journal of Machine Learning and Computing},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 number = {4},
 pages = {477 - 482},
 publication_stage = {Final},
 source = {Scopus},
 title = {Small-world-like structured MST-based clustering algorithm},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85071326305?origin=resultslist},
 volume = {9},
 year = {2019}
}
