@inproceedings{5540941,
 abstract = {Ontology is an effective means to overcome semantic barrier, Geo-ontology integration between semantic is fundamental that realize the geographic information semantic interoperability, Category theory as a highly abstract mathematical theory, to describe the relationship between objects provides a solid theoretical foundation and analytical tools. According to the definition of category theory, the objects of category represent ontology and morphisms between them describe ontology mapping, pushout describe ontology merging, Designed based on the geographical scope of the theory of ontology merging methods, the methods that merged semantically similar and includes different concepts, and keep the original structure unchanged. As a formal structure of pushout that ensures containment is complete, unique (up to isomorphism) and minimal. With the river ontologies in the hydrology of different calssifcation as an example, the paper finally verifies the method of ontology semantic merging and analyzes the experimental results.},
 author = {Ling Hu and Jianxiong Wang},
 booktitle = {2010 International Conference On Computer Design and Applications},
 doi = {10.1109/ICCDA.2010.5540941},
 issn = {},
 keyword = {Ontologies;Merging;Educational institutions;Rivers;Hydrology;Geographic Information Systems;Computer science;Information analysis;Water resources;Hydroelectric power generation;Geo-ontology;category theory;semantic;pushout;integration},
 month = {June},
 number = {},
 pages = {V1-5-V1-8},
 title = {Geo-ontology integration based on category theory},
 volume = {1},
 year = {2010}
}
