@conference{Ren201599,
 abstract = {The large data for transportation industry demands that the data retrieval system should be extremely efficient, timely and reliable. However, the traditional system is always difficult to achieve it. The data in transportation industry contains the time information which is often used as the main factor when in query and sorting. Based on this characteristic, this paper intends to optimize the search application server mainly from two aspects including index creation and index merge. Experimental results show that with one billion records, the response time in query and sort would cost only 10% to 20% of the original time, which achieves the purpose of rapid response. © 2015 IEEE.},
 author = {Ren, Le-Le and He, Ling-Min},
 doi = {10.1109/ICMLC.2015.7340905},
 journal = {Proceedings - International Conference on Machine Learning and Cybernetics},
 note = {Cited by: 0},
 pages = {99 - 103},
 publication_stage = {Final},
 source = {Scopus},
 title = {Index creation and optimize query performance in the transport sector},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85020696534?origin=resultslist},
 volume = {1},
 year = {2015}
}
