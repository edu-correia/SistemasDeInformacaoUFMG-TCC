@article{10.1145/2407736.2407737,
 abstract = {With the growing interest in statistical parsing, special attention has recently been devoted to the problem of comparing different treebanks to assess which languages or domains are more difficult to parse relative to a given model. A common methodology for comparing parsing difficulty across treebanks is based on the use of the standard labeled precision and recall measures. As an alternative, in this article we propose an information-theoretic measure, called the expected conditional cross-entropy (ECC). One important advantage with respect to standard performance measures is that ECC can be directly expressed as a function of the parameters of the model. We evaluate ECC across several treebanks for English, French, German, and Italian, and show that ECC is an effective measure of parsing difficulty, with an increase in ECC always accompanied by a degradation in parsing accuracy.},
 address = {New York, NY, USA},
 articleno = {7},
 author = {Corazza, Anna and Lavelli, Alberto and Satta, Giorgio},
 doi = {10.1145/2407736.2407737},
 issn = {1550-4875},
 issue_date = {January 2013},
 journal = {ACM Trans. Speech Lang. Process.},
 keyword = {Natural language parsing, probabilistic context-free grammars},
 month = {January},
 number = {4},
 numpages = {31},
 publisher = {Association for Computing Machinery},
 title = {An information-theoretic measure to evaluate parsing difficulty across treebanks},
 url = {https://doi.org/10.1145/2407736.2407737},
 volume = {9},
 year = {2013}
}
