@inproceedings{10922228,
 abstract = {The interconnection of ultra-high voltage (UHV) alternating current (AC) and direct current (DC) systems across the region has resulted in a closer electrical integration within the grid. As a result, the security and stability control system (SSCS) is characterized by an increased number of control objects, an expanded control range, and a strong coupling with the dynamics of the power grid. To address the challenges of limited flexibility in experimental platforms, high computational costs, and significant consumption of experimental resources associated with traditional SSCS simulation, this paper proposes a method for functional module equivalence and strategy device aggregation. This approach simplifies the inputs of fault constraint models and merges the action space, thereby preserving the system's operational characteristics. The architecture of the SSCS post-equivalence and enhancements to keyword matching technology based on a multi-branch tree data structure in the strategy searching technique are described in detail, further demonstrating the effectiveness of the simplified method and improvements in computational efficiency.},
 author = {Liu, Qitao and Li, Manli and Xu, Jianbing and Jian, Fan},
 booktitle = {2024 IEEE PES 16th Asia-Pacific Power and Energy Engineering Conference (APPEEC)},
 doi = {10.1109/APPEEC61255.2024.10922228},
 issn = {},
 keyword = {Tree data structures;Computational modeling;Power system dynamics;Power system stability;Control systems;Stability analysis;Computational efficiency;Security;Time complexity;Thermal stability;security and stability control system;functional module equivalence;strategy table;computational efficiency},
 month = {Oct},
 number = {},
 pages = {1-5},
 title = {Model Simplification and Time Complexity Reducing Method For Security and Stability Control Systems},
 volume = {},
 year = {2024}
}
