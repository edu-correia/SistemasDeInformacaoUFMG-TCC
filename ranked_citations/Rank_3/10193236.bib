@inproceedings{10193236,
 abstract = {The "SMARTGRID" project, funded by the Italian National Institute for Insurance against Accidents at Work, integrates RFID tags and BLE devices to identify obstacles and workers within 10 meters of unmanned tractors, providing alerts and emergency stop procedures through an IoT infrastructure. The follow-up project "SIRTRACK" improves the system by adding UWB localizers, LIDARs, depth cameras, and RTK navigation systems to detect and track obstacles, and merges all information into an alert system for the remote driver. This paper presents the results of the SMARTGRID project and the conceptual idea of the SIRTRACK system.},
 author = {Catarinucci, Luca and Cecchi, Glauco and Chietera, Francesco P. and Cecchini, Massimo and Colella, Riccardo and Gabbrielli, Roberto and Landi, Luca and Marrazzini, Leonardo and Monarca, Danilo and Montanaro, Teodoro and Motroni, Andrea and Nepa, Paolo and Patrono, Luigi and Pirozzi, Marco and Puri, Daniele and Rossi, Pierluigi and Sergi, Ilaria and Tavanti, Emanuele and Vita, Leonardo},
 booktitle = {2023 8th International Conference on Smart and Sustainable Technologies (SpliTech)},
 doi = {10.23919/SpliTech58164.2023.10193236},
 issn = {},
 keyword = {Meters;Laser radar;Navigation;Software architecture;Agricultural machinery;Cameras;Safety;RFID for Safety;RFID Tracking;Agricultural Safety;Worker Safety;Smart Agriculture},
 month = {June},
 number = {},
 pages = {1-6},
 title = {Enhancing Worker Safety in Unmanned Agricultural Environments through the Integration of RFID, RTK, UWB, and LIDAR: Insights from Research Projects},
 volume = {},
 year = {2023}
}
