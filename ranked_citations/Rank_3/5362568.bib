@inproceedings{5362568,
 abstract = {The key issue of edge detection is to filter more noises while obtaining more edge details. This paper proposed a novel edge detection method based on the fusion of wavelet transform and mathematical morphology. Firstly, decompose image into high and low frequency parts via wavelet transform. Secondly, process the high and low frequency parts respectively: apply multi-scale wavelet transform to detect edge in high frequency part; and apply mathematical morphology to detect edge in low frequency part. Finally, merge the edge images using multi-scale edge fusion and extract the edge from merged edge image. Experimental results show that the proposed method has great effects in noise suppression and edge detail preserving compared with that of wavelet transform based or mathematical morphology based edge detection method.},
 author = {Zhang, Wenjuan and Kang, Jiayin},
 booktitle = {2009 International Conference on Information Engineering and Computer Science},
 doi = {10.1109/ICIECS.2009.5362568},
 issn = {2156-7387},
 keyword = {Image edge detection;Wavelet transforms;Morphology;Frequency;Wavelet analysis;Cities and towns;Filters;Low-frequency noise;Image coding;Signal analysis},
 month = {Dec},
 number = {},
 pages = {1-4},
 title = {Edge Detection Based on Fusion of Wavelet Transform and Mathematical Morphology},
 volume = {},
 year = {2009}
}
