@inproceedings{1628434,
 abstract = {The mobile agents technology has been shown efficient to diverse computer networks applications due to its autonomy and capacity of adaptation. However, storage, localization and execution of agents in traditional devices inside the network are appearing problematic, as well as security problems. The P2P technology, with its capacities of localizing and sharing resources, improved with security aspects, provides the required features in order to resolve those raised problems. This paper proposes a modular and flexible Mobile Agents Platform that merges the best aspects from Mobile Agents and P2P networks, as well as a Security Framework onto the Platform, which reduces and prevents some usual threats on such environments.},
 author = {Fernandes, D.L. and Saboia, V.F.S. and De Castro, M.F. and Neuman de Souza, J.},
 booktitle = {International Conference on Networking, International Conference on Systems and International Conference on Mobile Communications and Learning Technologies (ICNICONSMCL'06)},
 doi = {10.1109/ICNICONSMCL.2006.32},
 issn = {},
 keyword = {Mobile agents;Peer to peer computing;Mobile computing;Information security;Mobile communication;Data security;Computer networks;Application software;Secure storage;Internet},
 month = {April},
 number = {},
 pages = {189-189},
 title = {A Secure Mobile Agents Platform Based on a Peer-to-Peer Infrastructure},
 volume = {},
 year = {2006}
}
