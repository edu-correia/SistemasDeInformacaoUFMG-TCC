@conference{Vijayaraj20042558,
 abstract = {Pansharpening techniques increase the spatial resolution of multispectral images and also simultaneously preserve the spectral information in the multispectral data. Pansharpening is also expressed as resolution merge, image integration, and multisensor data fusion. Some of the applications of pansharpening are to improve geometric correction, enhance certain features that are not visible in the data, change detection using temporal data sets, and enhance classification. There is an increasing use of these different pansharpening methods as a preprocessing step for feature enhancement and improved classification accuracy [1]. The quality of the sharpened images is to be evaluated using quantitative metrics. Accordingly, a user-friendly pansharpening and image quality interface (PSIQI) is developed to benchmark the performance of different pansharpening algorithms.},
 author = {Vijayaraj, Veeraraghavan and O'Hara, Charles G. and Younan, Nicolas H.},
 journal = {International Geoscience and Remote Sensing Symposium (IGARSS)},
 note = {Cited by: 2},
 pages = {2558 - 2561},
 publication_stage = {Final},
 source = {Scopus},
 title = {Pansharpening and image quality interface},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/15944424269?origin=resultslist},
 volume = {4},
 year = {2004}
}
