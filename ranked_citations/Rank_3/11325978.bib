@inproceedings{11325978,
 abstract = {In the era of digital transformation, speed in service and accuracy in medical treatment are critical. Meanwhile, the process of determining the ICD-10 code is still performed manually by medical staff based on diagnoses recorded in electronic medical records (EMRs). It causes resulting an increased workload, inefficiency, and time consumption, particularly in outpatient services. This determination process is used to determine medical insurance claims submitted by hospitals to BPJS Health. On the other hand, the volume of clinical data is rapidly increasing across Indonesian healthcare institutions. The clinical data is usually free text and unstructured data, such as SOAP notes and doctor diagnoses. The unstructured nature poses significant challenges for efficient retrieval, analysis This study presents an information retrieval framework for Indonesian medical diagnoses by leveraging transformer-based sentence embedding using BERT and vector similarity search with FAISS and cosine similarity. The system processes clinical narrative inputs derived from SOAP notes and doctor diagnoses, and applies a series of natural language preprocessing techniques, including deduplication, text normalization, and column merging. The objective of this system is to recommend the most relevant ICD-10 codes, along with similarity scores, thereby providing a practical decision-support tool for medical staff. In this research, there are 2 products that become the output for information retrieval. There are the Diagnoses Matching System and the Medical Chatbot Assistant. Evaluation of the system using the Mean Reciprocal Rank (MRR) metric resulted in a score of 0.71, indicating strong performance, where the correct ICD-10 code is retrieved within the top results on average in information retrieval medical diagnoses.},
 author = {Khadija, Mutiara Auliya and Permana Yudha, Ery and Nurharjadmo, Wahyu and Uswatunnisa, Mila Rosyida},
 booktitle = {2025 International Conference on Artificial Intelligence's Future Implementations (ICAIFI)},
 doi = {10.1109/ICAIFI66942.2025.11325978},
 issn = {},
 keyword = {Codes;Semantics;Pipelines;Natural languages;Information retrieval;Transformers;Vectors;Simple object access protocol;Medical diagnostic imaging;Optimization;Information Retrieval;Indonesian Medical Diagnoses;BERT;Similarity Search;Healthcare Informatics},
 month = {Sep.},
 number = {},
 pages = {63-68},
 title = {Enhancing Information Retrieval for Indonesian Medical Diagnoses Using BERT and Similarity Search},
 volume = {},
 year = {2025}
}
