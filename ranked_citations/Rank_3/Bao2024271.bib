@conference{Bao2024271,
 abstract = {To address the limitation of Bi-GRU models in capturing fine-grained semantic information when relying solely on forward and backward text modeling, this paper proposes a three-layer parallel structure to capture semantic information more effectively. Each of the three GRU layers extracts semantic information at different scales, enriching the semantic depth of the generated image captions. Furthermore, to integrate the semantic information captured by the three parallel GRU layers, a coupling mechanism is designed to merge the parallel hidden states, allowing interlayer interactions at each time step to enhance the semantic granularity of the fused image captions. Finally, extensive experiments on public datasets are conducted to verify the model's effectiveness, and the experimental results are analyzed to evaluate the model's feasibility comprehensively. © 2024 IEEE.},
 author = {Bao, Wenjun and Zhao, Jin and Zhang, Huawei},
 doi = {10.1109/ICICML63543.2024.10957937},
 journal = {2024 International Conference on Image Processing, Computer Vision and Machine Learning, ICICML 2024},
 note = {Cited by: 2},
 pages = {271 - 275},
 publication_stage = {Final},
 source = {Scopus},
 title = {Parallel Three-Layer Coupled Bi-GRU Algorithm for Image Caption Generation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105004581440?origin=resultslist},
 year = {2024}
}
