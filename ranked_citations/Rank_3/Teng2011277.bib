@conference{Teng2011277,
 abstract = {As a parallel programming framework, MapReduce has attracted more and more attention from both IT enterprises and research institutes that work for large dataset processing. SimMapReduce, a MapReduce simulator based on GridSim, is introduced to facilitate research on resource management and performance evaluation. With SimMapReduce simulator, researchers are free to implement scheduling algorithms and resource allocation policies by inheriting the provided java classes without concerns of implementation details. A FileManager is integrated to manage files transfers, so that the file transmission time is recorded and taken into account as a part of job completion time. Different simulation scenarios are modeled by predefining parameters in a configuration file. Experiment results illustrate that SimMapReduce can be easily executed in a personal computer and can provide qualitative analysis for MapReduce systems. © 2011 IEEE.},
 author = {Teng, Fei and Yu, Lei and Magoulès, Frédéric},
 doi = {10.1109/MUE.2011.56},
 journal = {Proceedings of the 2011 5th FTRA International Conference on Multimedia and Ubiquitous Engineering, MUE 2011},
 note = {Cited by: 30},
 pages = {277 - 282},
 publication_stage = {Final},
 source = {Scopus},
 title = {SimMapReduce: A simulator for modeling MapReduce framework},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/80052585269?origin=resultslist},
 year = {2011}
}
