@inproceedings{5337252,
 abstract = {In this paper, we present a tool called X2OWL that aims at building an OWL ontology from an XML data source. This method is based on XML schema to automatically generate the ontology structure, as well as, a set of mapping bridges. The presented method also includes a refinement step that allows to clean the mapping bridges and possibly to restructure the generated ontology.},
 author = {Ghawi, Raji and Cullot, Nadine},
 booktitle = {2009 20th International Workshop on Database and Expert Systems Application},
 doi = {10.1109/DEXA.2009.68},
 issn = {2378-3915},
 keyword = {Ontologies;XML;OWL;Bridges;Resource description framework;Databases;Expert systems;Buildings;Mediation;Merging},
 month = {Aug},
 number = {},
 pages = {480-484},
 title = {Building Ontologies from XML Data Sources},
 volume = {},
 year = {2009}
}
