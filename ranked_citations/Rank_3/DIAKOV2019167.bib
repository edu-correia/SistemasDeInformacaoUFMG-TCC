@incollection{DIAKOV2019167,
 abstract = {In March 2001, BHP announced the corporate decision to merge with Billiton to form a new mining house BHP Billiton. This brought new wave of corporate changes and adjustments for the joint company. BHP Discovery team and exploration group of Billiton complimented each other providing a good base for smooth transition and organic integration. The joint discovery team reinvigorated its focus on search of Tier 1 size deposits around the globe and the company thresholds for Tier 1 deposits increased further.},
 author = {Sergei Diakov and Samand Sanjdorj and Galsan Jamsrandorj},
 booktitle = {Discovery of Oyu Tolgoi},
