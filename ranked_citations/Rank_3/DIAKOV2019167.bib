 editor = {Sergei Diakov and Samand Sanjdorj and Galsan Jamsrandorj},
 isbn = {978-0-12-816089-3},
 keyword = {BHP Billiton merger, Brian Gilbertson, Charles Goodyear, Strategic commodities},
 pages = {167-170},
 publisher = {Elsevier},
 title = {Chapter 12 - New Corporate Changes in BHP},
 url = {https://www.sciencedirect.com/science/article/pii/B9780128160893000123},
