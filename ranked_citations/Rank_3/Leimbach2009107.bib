@article{Leimbach2009107,
 abstract = {In this paper we present an algorithm that deals with trade interactions within a multi-region model. In contrast to traditional approaches this algorithm is able to handle spillover externalities. We focus on technological spillovers which are due to capital trade. The algorithm of finding a pareto-optimal solution in an intertemporal framework is embedded in a decomposed optimization process. The paper analyzes convergence and equilibrium properties of this algorithm. In the final part of the paper, we apply the algorithm to investigate possible impacts of technological spillovers. While benefits of technological spillovers are significant for the capital-importing region, benefits for the capital-exporting region depend on the type of regional disparities and the resulting specialization and terms-of-trade effects. © Springer Science+Business Media, LLC. 2008.},
 author = {Leimbach, Marian and Eisenack, Klaus},
 doi = {10.1007/s10614-008-9152-4},
 journal = {Computational Economics},
 note = {Cited by: 8; All Open Access; Green Open Access},
 number = {2},
 pages = {107 - 130},
 publication_stage = {Final},
 source = {Scopus},
 title = {A trade algorithm for multi-region models subject to spillover externalities},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/59449100784?origin=resultslist},
 volume = {33},
 year = {2009}
}
