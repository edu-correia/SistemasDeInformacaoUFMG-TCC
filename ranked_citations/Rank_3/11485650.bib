@inproceedings{11485650,
 abstract = {In this study, we address the dual challenges of missing data and high dimensionality in multi-omics analysis by systematically evaluating and integrating advanced imputation and dimensionality reduction strategies within a unified analytical framework. Two heterogeneous datasets comprising RNA/DNA molecular features and clinical variables were harmonized into a consolidated multi-omics dataset of 309 samples and 831 features. Furthermore, we analyze the effect of PCA variance-retention thresholds on downstream performance, highlighting the trade-off between dimensionality reduction and information preservation in integrated multi-omics settings. The resulting framework offers practical guidance for selecting imputation and dimensionality reduction strategies in high-dimensional, heterogeneous biomedical data, advancing robust and reproducible multi-omics analysis. Unlike prior studies that apply imputation or dimensionality reduction in isolation, we provide a comparative assessment of deep generative (GAN, VAE, Autoencoder) and classical iterative imputation methods under a consistent evaluation protocol, demonstrating substantial performance differences across approaches. Iterative Random Forest imputation achieved the lowest reconstruction error, outperforming deep generative models.},
 author = {AlRifai, Lina and Ali, Mostafa Z. and Al-Haija, Qasem Abu and Ali, Talal Z. and Al-Husein, Belal},
 booktitle = {2026 IEEE Conference on Computer Applications (ICCA)},
 doi = {10.1109/ICCA69280.2026.11485650},
 issn = {},
 keyword = {Circuits;Protocols;HTTP;Communication systems;Dimensionality reduction;Machine learning;Random forests;Deep learning;Learning (artificial intelligence);Autoencoders;Multi-omics data integration;Missing data imputation;PCA;Dimensionality reduction},
 month = {Feb},
 number = {},
 pages = {1-5},
 title = {Enhancing Predictive Modeling of Breast Cancer Drug Response Via Multi-Dataset Fusion and Comparative Imputation Methods},
