@inproceedings{1206078,
 abstract = {In this paper, we propose a fast pipeline VLSI architecture for 1D lifting-based discrete wavelet transform (DWT). This design method merges the filtering steps called the predictor and updater into one single step. Based on this modified algorithm, we explore the data dependency of the input and output signals, and thus make the pipeline design more efficiently for hardware implementation under the same processor elements proposed in previous works. Moreover, the inverse DWT case also adopts the same architecture as the forward DWT. Finally, the area and the working frequency of the proposed architecture in 0.35 /spl mu/m technology are 2.511/spl times/2.510 mm/sup 2/, and 150 MHz, respectively.},
 author = {Bing-Fei Wu and Chung-Fu Lin},
 booktitle = {2003 IEEE International Symposium on Circuits and Systems (ISCAS)},
 doi = {10.1109/ISCAS.2003.1206078},
 issn = {},
 keyword = {Discrete wavelet transforms;Pipelines;Very large scale integration;Design methodology;Filtering;Signal processing;Signal design;Algorithm design and analysis;Hardware;Frequency},
 month = {May},
 number = {},
 pages = {II-II},
 title = {A rescheduling and fast pipeline VLSI architecture for lifting-based discrete wavelet transform},
 volume = {2},
 year = {2003}
}
