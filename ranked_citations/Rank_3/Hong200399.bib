@conference{Hong200399,
 abstract = {Because of the benefits of image fusion, although higher and higher resolution remote sensing data are available now, image fusion is still a popular method for better interpreting image data. Aiming at the limitations of existing fusion methods, this paper proposes a new fusion method which combines the wavelet transform and IHS transform. Some improvements are also made in the wavelet transform and IHS transform. IKONOS and QuickBird data are tested to assess this proposed method. Visual evaluation and quantity analysis are employed to assess the quality of the fused images of different methods. The proposed method demonstrates the best results among other methods being tested in this study. © 2003 IEEE.},
 author = {Hong, Gang and Zhang, Yun},
 doi = {10.1109/DFUA.2003.1219966},
 journal = {2nd GRSS/ISPRS Joint Workshop on Remote Sensing and Data Fusion over Urban Areas, URBAN 2003},
 note = {Cited by: 25},
 pages = {99 - 104},
 publication_stage = {Final},
 source = {Scopus},
 title = {High resolution image fusion based on wavelet and IHS transformations},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84944874225?origin=resultslist},
 year = {2003}
}
