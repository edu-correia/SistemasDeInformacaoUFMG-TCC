@inproceedings{6420608,
 abstract = {This paper aims at merging the best of both the technologies viz. Computer Vision and Embedded Systems by implementing a system which tracks a moving object in a live video stream using a Field Programmable Gate Array (FPGA) rapid prototyping platform. The system tracks an object in a real-time 240×320 USB-Video-Class (UVC) video stream offering portability. The tracking target selection is enabled using a touchscreen interface. The design is implemented on a 32-bit RISC soft-core processor available in FPGA and parts of the system are accelerated in reconfigurable hardware thus leveraging the hardware and soft-processor co-design capabilities offered by the FPGA. The HSV (Hue, Saturation, Value) color model is used to make the algorithm robust to changing lighting scenarios. In addition, the compute-expensive Color-Space transformation module is implemented through the use of pre-initialized look-up tables for accelerated performance. Finally, a simple, but robust algorithm is used to track a moving object using averaging, dynamic thresholding and center-of-mass model for updating the current location of the target object.},
 author = {Rao, V M Sandeep and Natarajan, Aravind and Moorthi, S. and Selvan, M. P.},
 booktitle = {2012 Annual IEEE India Conference (INDICON)},
 doi = {10.1109/INDCON.2012.6420608},
 issn = {2325-9418},
 keyword = {Color;Field programmable gate arrays;Real-time systems;Streaming media;Lighting;Image color analysis;Object tracking;Object Tracking;Color Space Transformation;USB Video Class;Soft-processor;Hardware/Software Co-Design;FPGA},
 month = {Dec},
 number = {},
 pages = {167-170},
 title = {Real-time object tracking in a video stream using Field Programmable Gate Array},
 volume = {},
 year = {2012}
}
