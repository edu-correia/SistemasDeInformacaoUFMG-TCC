@inproceedings{4591692,
 abstract = {The group of experts' discussion is one of the main working schemes in hall for workshop of meta-synthetic engineering (HWME) from qualitative to quantitative. A new opinions expression and induction system to support the group discussion is devised and implemented in this paper, which provides the group with an effective tool of opinions expression and online discussion through computer and network. The speeches of experts are structurized to express the logical relationship and structure of them in the system. The opinions can also be automatically analyzed and gathered by the system, and merged according to the similarity of them. Human intelligence and machine intelligence can be combined to improve the effectiveness and efficiency of group discussion in the system. The system has been applied in a prototype system of HWME developed by the author's group and is proved to be feasible in practice.},
 author = {Chai, Yanyan and Fan, Lei and Li, Yaodong and Zhao, Mingchang},
 booktitle = {2008 32nd Annual IEEE International Computer Software and Applications Conference},
 doi = {10.1109/COMPSAC.2008.14},
 issn = {0730-3157},
 keyword = {Speech;Conferences;Computers;Artificial intelligence;Color;Speech processing;Information technology;Hall for Workshop of Meta-synthetic Engineering (HWME);The opinions expression;The opinions induction},
 month = {July},
 number = {},
 pages = {913-917},
 title = {An Opinions Expression and Induction System of Experts in Hall for Workshop of Meta-synthetic Engineering},
 volume = {},
 year = {2008}
}
