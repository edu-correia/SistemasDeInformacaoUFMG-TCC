@article{Raunich2012124,
 abstract = {Benchmarking approaches for ontology merging is challenging and has received little attention so far. A key problem is that there is in general no single best solution for a merge task and that merging may either be performed symmetrically or asymmetrically. As a first step to evaluate the quality of ontology merging solutions we propose the use of general metrics such as the relative coverage of the input ontologies, the compactness of the merge result as well as the degree of introduced redundancy. We use these metrics to evaluate three merge approaches for different merge scenarios. © 2012 Springer-Verlag.},
 author = {Raunich, Salvatore and Rahm, Erhard},
 doi = {10.1007/978-3-642-33618-8_20},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 35},
 pages = {124 - 133},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards a benchmark for ontology merging},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84873878564?origin=resultslist},
 volume = {7567 LNCS},
 year = {2012}
}
