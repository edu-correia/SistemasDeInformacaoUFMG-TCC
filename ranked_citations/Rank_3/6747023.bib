@inproceedings{6747023,
 abstract = {Association rules which are used to mine resource failure, can reduce the number of wrong alarm resources to be replaced. In this paper, we proposed an efficient algorithm: CSRule, for mining closed strong association rules based on merging strategies. Firstly, it generates all pairs of association rules which only have two resources; secondly, all the closed strong association rules are mind using merging strategies. In order to improve the mining efficiency of the algorithm, CSRule algorithm adopts several pruning strategies to mine closed strong association rules without candidate maintenance. For the escape of low efficiency on secondary mining based on definition, CSRule algorithm can mine closed strong association rules at one time. The experimental results show our algorithm is more efficient than traditional algorithm.},
 author = {Zhang, Lihua and Zhai, Zhengjun and Wang, Miao and Wang, Guoqing},
 booktitle = {2013 6th International Conference on Biomedical Engineering and Informatics},
 doi = {10.1109/BMEI.2013.6747023},
 issn = {1948-2922},
 keyword = {Association rules;Merging;Algorithm design and analysis;Surface acoustic waves;Correlation;Software algorithms;association rule;closed;resource},
 month = {Dec},
 number = {},
 pages = {666-671},
 title = {CSRule: Efficient mining of closed strong association rules in the resource effectiveness matrix},
 volume = {},
 year = {2013}
}
