@conference{Graefe2024246,
 abstract = {Sorting in databases can exploit an existing sort order if it is related to the desired sort order. In some cases, an external merge sort can become multiple internal sorts; in other cases, sorting can become merging, i.e., merge sort without run generation, e.g., without an initial quicksort phase. If the input includes offset-value codes, they readily map to offset-value codes for the output, enabling efficient comparisons in merge steps and in subsequent query operations, e.g., a merge join. There are many cases in which the existing sort order and existing offset-value codes can help creating a desired sort order. While today’s database systems implement only the simplest cases, i.e., changing the sort order from A, B to A or from A to A, B, interesting orderings and offset-value codes permit substantial savings in more complex cases such as changing an existing sort order of A, B, C, D to A, C, B, D. Our research introduces the required techniques and measures achievable savings. © 2025 Copyright held by the owner/author(s).},
 author = {Graefe, Goetz and Kuhrt, Marius and Seeger, Bernhard},
 doi = {10.48786/edbt.2025.20},
 journal = {Advances in Database Technology - EDBT},
 note = {Cited by: 0},
 number = {2},
 pages = {246 - 254},
 publication_stage = {Final},
 source = {Scopus},
 title = {Modifying an existing sort order with offset-value codes},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105007889232?origin=resultslist},
 volume = {28},
