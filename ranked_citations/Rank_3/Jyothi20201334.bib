@article{Jyothi20201334,
 abstract = {In distribution systems with non-conventional energy sources, power electronic converters are being utilized. The enhancement of power quality characteristics for the wind, solar energy systems merge with grid connected system is predominantly concentrated in this paper. The wind, solar energy power plant is designed by using the corresponding equations. The inverter is used to feed the power in to transmission grid and it is used as a power converter based shunt active power filter. Everyfunction may be accomplishing either separately or concurrently. The UPQC is regulated based on the PWM controller and is formulated depending on the conviction of PQ theory. Nevertheless in the existence of non-linear load also balanced load currents are acquired by using this control. This workis done in MATLAB and simulation results are verified. © Institute of Advanced Scientific Research, Inc.. All rights reserved.},
 author = {Jyothi, Boga and Vinnakoti, Sudheer and Varma, Pinni Srinivas and Pushpa Latha, B. Mary},
 doi = {10.5373/JARDCS/V12I2/S20201171},
 journal = {Journal of Advanced Research in Dynamical and Control Systems},
 note = {Cited by: 0},
 number = {2},
 pages = {1334 - 1342},
 publication_stage = {Final},
 source = {Scopus},
 title = {Power quality improvement of wind and solar hybrid energy sources interface to the grid using upqc},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85083288611?origin=resultslist},
 volume = {12},
 year = {2020}
}
