@inproceedings{5587033,
 abstract = {In this paper, we introduce an explorative but adaptive-associative information management system in the presence of a natural conversation. We take advantage of explorative mind-maps, which have been demonstrated in [10] and which are altogether a management framework that emerges automatically from the data input stream it gets. An explorative mind-map is a non-verificative but dynamic system that basis on the natural paradigm: it changes its complexity continuously and fosters symbolic cells according to internal activation states. Generally, the structure mirrors a mental state where the oblivion of associated facts arrive once the stimulation decreases. Considering two mind-maps A1,2 and B1,2 for two conversational partners A and B, the mind-map *1 represents the self-conversation and *2 the conversational stream of the conversational partner. If we merge these mind-maps, we may apply the out-coming results for the computation of trust.},
 author = {Poray, Jayanta and Schommer, Christoph},
 booktitle = {ACS/IEEE International Conference on Computer Systems and Applications - AICCSA 2010},
 doi = {10.1109/AICCSA.2010.5587033},
 issn = {2161-5330},
 keyword = {Skeleton;Presses;Merging;Computer architecture;Cognition;Adaptation model;Conferences;Cognitive Systems;Brain Informatics;Nature-inspired Learning;Adaptive Information Management;Trustworthiness},
 month = {May},
 number = {},
 pages = {1-4},
 title = {Managing conversational streams by explorative mind-maps},
 volume = {},
 year = {2010}
}
