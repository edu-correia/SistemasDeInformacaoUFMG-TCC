@inproceedings{7068006,
 abstract = {This paper presents a compact Multi-Broadband Planar Monopole Antenna that is particularly meaningful to the recent integrated mobile broadband wireless radio access and the cognitive radio applications. The antenna presented is structured by merging an UWB antenna and a parasitic multi-loaded winding line monopole so as to cover the standards of GSM, Wireless LANs, LTE and the UWB as well. The former UWB antenna is configured as an elongated pentagon-shape radiator to produce the ultra broad frequency band, and is also arranged to work as the proximity coupled feeding network of the latter one. The latter parasitic multi-loaded winding line monopole is judiciously tuned for the lower frequency bands of 900MHz, 1.8GHz and 2.2GHz. Several broadband antenna design topologies have been applied making this compact and extremely broad band planar monopole antenna design possible. The measurement results show the success of the proposed approach. The characteristics exhibited in this planar antenna including wide coverage in wireless access standards, compact in size, and single layer fabrication can be especially beneficial in the integration with other radio frequency components in the mobile broadband wireless systems.},
 author = {Chuang, Ching-Song and Ku, Tsi-Tsu and Zeng, Jian-Hong},
 booktitle = {2014 Asia-Pacific Microwave Conference},
 doi = {},
 issn = {2165-4743},
 keyword = {Broadband antennas;Broadband communication;Decision support systems;Bandwidth;Antenna radiation patterns;Topology;Indexes;Broadband Antenna;Monopole Antenna;UWB;GSM;WLAN},
 month = {Nov},
 number = {},
 pages = {315-317},
 title = {A compact multiband planar antenna for integrated mobile wireless radio access applications},
 volume = {},
 year = {2014}
}
