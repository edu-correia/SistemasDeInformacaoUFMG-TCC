@inproceedings{5328115,
 abstract = {In today's highly competitive financial markets, financial innovation and bank's merge and acquisition activities are growing much. How to quickly construct business process upon IT infrastructure becomes the kernel of competition. As one of the classic application of service-oriented architecture, the grid technology can considerably help banks to improve the efficiency of constructing business process. In this paper, a tag-based processing model upon service-oriented grid is proposed. Through the practical scenario, the efficiency and security are demonstrated. Compared with traditional methods, the proposed solution has three advantages: (i) it is general enough to apply to banking applications without modifying upper business logic; (ii) with minor cost on processing normal request, it can provide high security and facility for reconstruction of banking business; (iii) it can help bank construct the new business process in the mean time.},
 author = {Qi, Li and Wu, Song},
 booktitle = {2009 Fourth ChinaGrid Annual Conference},
 doi = {10.1109/ChinaGrid.2009.27},
 issn = {1949-1328},
 keyword = {Banking;Stability;Clustering algorithms;Partitioning algorithms;Optimization methods;Machine intelligence;Simulated annealing;Euclidean distance;Adaptive systems;Intelligent systems},
 month = {Aug},
 number = {},
 pages = {171-176},
 title = {Adaptively Construct Banking Process with Tags Upon Services-Oriented Grid},
 volume = {},
 year = {2009}
}
