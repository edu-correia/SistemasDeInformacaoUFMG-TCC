@article{Zhang2023880,
 abstract = {Focusing on the high-quality development of education, comprehensively implementing the fundamental task of establishing moral education and improving the quality of talent training, the traditional experimental teaching on the goal of talent training has failed to meet the demand for diversified and innovative excellence talents in the new era, and needs to be further reconstructed. Based on the OBE concept, this paper takes the mechanical design and manufacturing and automation majors of Wuhan University of Technology as an example, and constructs an experimental teaching system for mechanical majors, including a target system, a course content system and a quality assurance system, integrates and scientifically configures all elements in the system, realizes systematic links and integration and interaction between elements, and effectively improves the quality of experimental teaching and the cultivation of innovative talents in the university. © 2023, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Zhang, Mengya and Liu, Zhiping and Wang, Mengjian and Chen, Yun},
 doi = {10.1007/978-3-031-24475-9_72},
 journal = {Lecture Notes on Data Engineering and Communications Technologies},
 note = {Cited by: 3},
 pages = {880 - 890},
 publication_stage = {Final},
 source = {Scopus},
 title = {Construction of Experimental Teaching System for Mechanical Majors Under the OBE Concept},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85152232505?origin=resultslist},
 volume = {158},
 year = {2023}
}
