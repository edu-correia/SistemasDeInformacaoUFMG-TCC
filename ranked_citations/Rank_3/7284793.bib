@article{7284793,
 abstract = {The educational side of "Data Fusion" entails training interested young scientists and practitioners. Data Fusion is an intriguing yet tough subject and we do not intend to tackle the problem of teaching it in a very general manner. With this paper we just want to contribute our modest experience on a specific "case study": a yearly Summer School Series on various themes in Data Fusion and remote sensing that has been running for 4 years now. At the time of writing the 2015 edition is planned to merge into the GRSS Summer School linked to IGARSS 2015.},
 author = {Dell'Acqua, Fabio},
 doi = {10.1109/MGRS.2015.2417762},
 issn = {2168-6831},
 journal = {IEEE Geoscience and Remote Sensing Magazine},
 keyword = {Remote sensing;Data integration;Education;Spaceborne radar;Europe},
 month = {Sep.},
 number = {3},
 pages = {130-147},
 title = {An Education Experience in Data Fusion and Remote Sensing: The Pavia International Summer School Series [Education]},
 volume = {3},
 year = {2015}
}
