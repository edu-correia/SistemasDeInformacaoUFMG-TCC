@inproceedings{7368462,
 abstract = {This paper presents a design, implementation and evaluation of a web-based application called MergeXML (MXML). MXML was developed to integrate XML documents that are similar in terms of structure and content to complete information which can be used for information retrieval. XML documents are clustered into subtrees representing as instances using leaf-node parents as clustering points. The system finds subtree keys from unique values at leaf-node levels. Subtree keys play an important role for mapping subtrees between two documents. Matched subtrees are merged to complete the information on the base XML document. The result shows that MXML is able to cluster subtrees as proper instances. It can merge additional (different) information to the base XML document. MXML is recommended to run with not too large size of XML documents due to time-out settings on the web server.},
 author = {Viyanon, Waraporn},
 booktitle = {2015 13th International Conference on ICT and Knowledge Engineering (ICT & Knowledge Engineering 2015)},
 doi = {10.1109/ICTKE.2015.7368462},
 issn = {2157-099X},
 keyword = {XML;Semantics;Information retrieval;Integrated circuits;Lead;Servers;Internet;XML Similarity Detection;Similarity Detection;Clustering;Matching;Keys},
 month = {Nov},
 number = {},
 pages = {5-10},
 title = {MXML: Implementation of a web-based application for merging XML documents using XML-SIM},
 volume = {},
 year = {2015}
}
