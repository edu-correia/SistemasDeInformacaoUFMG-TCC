@conference{Li202586,
 abstract = {Conventional electric power Internet of Things terminal security protection monitoring point deployment a choice of fixed-point protection or regional protection processing, the scope of protection is restricted, resulting in low protection efficiency, so the design and practice of the electric power Internet of Things terminal security protection method based on the cloud-side-end collaboration is proposed. According to the current security protection needs, the combination monitoring method is adopted to break the limitations of traditional security protection processing, deploy the combination of security protection monitoring points, and carry out the pre-processing of real-time data. On this basis, a cloud-side-end cooperative power IoT terminal security protection model is designed, and adaptive enhancement processing is used to realize security protection. The test results show that compared with the traveling wave protection method of phase characteristic high-voltage direct current transmission system and the protection method of ground fault identification and localization of multi-terminal synchronous measurement traction network, the safety protection method of cloud-side-terminal cooperative electric power Internet of things terminal finally achieves a relatively high frequency of protection, which indicates that with the assistance and support of the cloud-side-terminal cooperative technology, the safety protection method of the current design is more targeted, and the coverage of protection is increased, which has the advantage of being more effective and efficient. This indicates that with the assistance and support of cloud-side-end collaboration technology, the designed security protection method is more targeted and the coverage of protection is increased, which has practical application value.  Copyright © 2024 held by the owner/author(s). Publication rights licensed to ACM.},
 author = {Li, Hua and Wu, Zhengrong and Yang, Chen and Yang, Xianzhi and Yang, Yuxuan},
