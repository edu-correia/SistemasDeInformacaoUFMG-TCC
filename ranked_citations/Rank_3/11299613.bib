@inproceedings{11299613,
 abstract = {Non-invasive health monitoring is the most promising breakthroughs with the emergence of sweat analysis as a powerful diagnostic tool. Sweat, a noninvasive and continuously available biofluid, has numerous biomarkers that can indicate a person's health condition, thus providing a one-on-one, real-time, health monitoring platform. Last few years, new advancements in wearable sensor systems have made it possible to continuously and non-invasively measure these biomarkers to offer real-time information on different variables affecting health. Integration of Internet of Things (IoT) infrastructure enables smooth capture, transfer, and storage of data, providing a good framework for data analytics. Moreover, since this dataset is provided with machine learning algorithms, prediction analytics are possible and lead to customized health treatment and early health risk management. This paper reviews the latest advancements in sweat biomarker detection methods, exploring cutting-edge sensor technologies, IoT integration strategies, multiple possible applications of the proposed techniques in clinical practice, and challenges and limitations in wearable sweat sensing. The merging of these technologies allows for the radical enhancement of personalized medicine, with apt diagnosis, better therapeutic outcomes, and individual responsibility for health status.},
 author = {Nagarkoti, Shashi Kala and Yadav, Richa and Bhati, Pooja},
 booktitle = {2025 International Conference on Emerging Trends in Networks and Computer Communications (ETNCC)},
 doi = {10.1109/ETNCC66224.2025.11299613},
 issn = {},
 keyword = {Reviews;Precision medicine;Biomarkers;Real-time systems;Internet of Things;Risk management;Biomedical monitoring;Wearable devices;Monitoring;Wearable sensors;Sweat Biomarkers;IoT integration;Machine learning},
 month = {Aug},
 number = {},
 pages = {898-905},
 title = {Wearable Sweat Sensors for Personalised Healthcare},
 volume = {},
 year = {2025}
}
