@article{ALSAIF2025113420,
 abstract = {The emergence of lightweight self-compacting cementitious materials (LWSCCMs) offers transformative opportunities for sustainable construction by merging reduced weight, exceptional workability, and enhanced mechanical performance. This study pioneers the integration of recycled tire steel fibers (RTF) into LWSCCMs to evaluate their individual and synergistic effects within hybrid fiber systems on the mechanical and durability properties of lightweight fiber-reinforced cementitious materials (LWFRCMs). In this research, an extensive experimental program was carried out that included mix optimization, property evaluation (e.g., slump flow, compressive, flexural, and shear strengths, elastic modulus, crack capacity, and porosity), and advanced analytical modeling. A third-order polynomial model (R2=0.998) accurately captured the compressive strength-reinforcing index relationship. Results highlight the hybrid fiber system containing 0.5 % of recycled tire and industrial steel fibers (SF-RTF-0.5) as the optimal mix that achieved 76.4 MPa compressive strength (+31.7 % relative to the reference mix) and the highest elastic modulus (28.1 GPa, +8.14 %), along with superior crack control (1.42 mm crack width). While 1.0 % RTF significantly improved fracture toughness (+70.3 %) and shear strength (6.81 MPa), it increased porosity (+9.0 %). The hybrid systems exhibited the best flexural performance, with a 74.5 % increase in flexural strength (8.2 MPa) and fracture toughness (34.1 J). Porosity analysis revealed the need for balanced fiber interactions to minimize voids and enhance matrix integrity. This research underscores the potential of hybrid fiber systems to revolutionize the LWFRCM applications by achieving superior mechanical performance while addressing sustainability goals.},
 author = {Abdulaziz Alsaif and Yassir M. Abbas},
 doi = {https://doi.org/10.1016/j.jobe.2025.113420},
 issn = {2352-7102},
 journal = {Journal of Building Engineering},
 keyword = {Hybrid fiber systems, Lightweight fiber-reinforced cementitious materials, Mechanical and durability properties, Recycled tire fibers, Sustainable construction composites},
 pages = {113420},
 title = {Mechanical and durability enhancements of lightweight fiber-reinforced cementitious composites via integration of recycled tire and industrial steel fibers},
 url = {https://www.sciencedirect.com/science/article/pii/S2352710225016572},
 volume = {111},
 year = {2025}
}
