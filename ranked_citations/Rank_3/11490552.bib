 issn = {2474-9656},
 keyword = {Filtering;Filters;Electronic mail;Protocols;Communication systems;Internet;Unsolicited e-mail;HTTP;Computer networks;Radio access networks;Classification;Decision Tree;Naïve Bayesian Classifier;Naïve Bayesian Tree (NBTree)},
 month = {Dec},
