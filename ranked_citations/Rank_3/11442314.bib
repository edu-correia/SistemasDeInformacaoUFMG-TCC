@inproceedings{11442314,
 abstract = {This study explores an innovative educational framework that merges project-based learning (PBL) with gamification and artificial intelligence (AI) to address real-world challenges. In a 10 -week initiative, 30 engineering students at Monterrey Technological University were tasked with developing serious game simulators to improve campus well-being, aligning with Sustainable Development Goal 3. The methodology was grounded in Agile development, structured into four iterative sprints that guided teams from mockup design to fully functional prototypes. Students integrated a diverse technology stack, including Unity3D for game development, relational databases, and the Gemini API for AI-driven features like personalized feedback and interactive chatbots. Despite technical challenges such as $A I$ latency and integration hurdles, the initiative demonstrated high efficacy. Results showed that 70 % of students rated their experience as “Excellent,” and the project yielded six functional prototypes, such as an emergency preparedness trainer and a campus maintenance game, which were recognized at a university technology fair. This work underscores the significant potential of interdisciplinary, gamified PBL to boost student engagement, foster practical software engineering skills, and create tangible social impact, while also highlighting the need for robust foundational support in emerging technologies like AI.},
 author = {Bento, Antonio Carlos},
 booktitle = {2025 2nd International Conference on Artificial Intelligence and Teacher Education (ICAITE)},
 doi = {10.1109/ICAITE68636.2025.11442314},
 issn = {},
 keyword = {Technological innovation;Prototypes;Games;Learning (artificial intelligence);Iterative methods;Artificial intelligence;Sustainable development;Engineering students;Software engineering;Testing;gamification;serious games;engineering education;project-based learning;higher and professional education;innovation in education},
 month = {Dec},
 number = {},
 pages = {207-211},
 title = {Gamifying Campus Life: A Project-Based Learning Initiative for Engineering Students Using AI and Serious Games},
 volume = {},
