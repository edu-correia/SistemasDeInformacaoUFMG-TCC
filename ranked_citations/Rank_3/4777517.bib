@inproceedings{4777517,
 abstract = {New challenges are raised with the large increase in the number of Web accessible data sources such as (a) identification of data sources that are relevant to the user query and (b) fulfilling the requirements of user's queries. Commonly used integration systems are facing problems because (i) sources are semantically heterogeneous and are autonomous; (ii) their schemas and database design are different and (iii) their query languages are also different. In this paper we highlight some issues of semantic-based query rewriting and propose a solution to (a) provide uniform access to all sources and (b) relieve users to understand local schemas.},
 author = {Aslam, Ammara and Khan, Sharifullah and Latif, Khalid},
 booktitle = {2008 4th International Conference on Emerging Technologies},
 doi = {10.1109/ICET.2008.4777517},
 issn = {},
 keyword = {Ontologies;Resource description framework;Database languages;Data mining;Merging;Data analysis;Mediation;XML;Taxonomy;Data Integration;Resource Description Framework;Query Rewritting},
 month = {Oct},
 number = {},
 pages = {292-297},
 title = {Semantic based query rewriting in heterogeneous sources},
 volume = {},
 year = {2008}
}
