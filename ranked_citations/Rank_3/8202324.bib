@article{8202324,
 abstract = {We report on a study of the large-scale temperature structure of the Perseus cluster with Suzaku, using observational data of four pointings of the 30$^{\prime}$ offset regions, together with data from the central region. Thanks to the Hard X-ray Detector (HXD-PIN: 10–60 keV), Suzaku can determine the temperature of hot galaxy clusters. We performed a spectral analysis by considering the temperature structure and the collimator response of the PIN correctly. As a result, we found that the upper limit of the temperature in the outer region is $\sim$14 keV, and an extremely hot gas, which was reported for RX J1347.5-1145 and Abell 3667, was not found in the Perseus cluster. This indicates that the Perseus cluster has not recently experienced a major merger.},
 author = {Nishino, Sho and Fukazawa, Yasushi and Hayashi, Katsuhiro and Nakazawa, Kazuhiro and Tanaka, Takaaki},
 doi = {10.1093/pasj/62.1.9},
 issn = {2053-051X},
 journal = {Publications of the Astronomical Society of Japan},
 keyword = {galaxies: clusters: individual (Perseus cluster);X-rays: galaxies: clusters;X-rays: individual (Perseus cluster);X-rays: spectra},
 month = {Feb},
 number = {1},
 pages = {9-18},
 title = {Study of the Large-Scale Temperature Structure of the Perseus Cluster with Suzaku},
 volume = {62},
 year = {2010}
}
