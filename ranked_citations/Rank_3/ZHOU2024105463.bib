@article{ZHOU2024105463,
 abstract = {Understanding the high-frequency self-excited instabilities characteristics of multi-element pure hydrogen flames is an integral part of the development of hydrogen gas turbines. However, the thermoacoustic instabilities of such flames are still not fully understood, especially the characteristics of oscillation and dynamical behavior for flame elements therein. Dynamic characteristics of high-frequency self-excited multi-element hydrogen flames were investigated using phase-averaged three-dimensional (3D) computed tomography of chemiluminescence (CTC) method, combined with the measurement of global heat release rate (HRR) fluctuation and pressure oscillation. The evolution of the phase-averaged 3D flame structure was reconstructed based on 16 independent views. Flame surface annihilation processes due to front merging and pinch-off of all flame elements were observed, suggesting that high-frequency hydrogen flame dynamics are dominated by lateral motions. The phase misalignment of the flame tail region fluctuations with the global heat release fluctuations is dominated by the lateral motion in the high-frequency flame dynamics. 3D trajectory tracking of the flame center of mass indicates the phase differences in the flame element dynamic characteristics. The HRR fluctuations among individual flame elements also have phase differences. However, the effects of all individual flame elements HRR fluctuations on global heat release response show similar results. This is most likely due to the lack of a large enough phase difference between the flame element HRR fluctuations and the global HRR fluctuations. In addition, the sum of the HRR fluctuations for all flame elements is consistent with the global HRR fluctuations. Thus, the collective fluctuation behavior can be considered as a result of the coupling of the flame element HRR fluctuations. Knowledge of individual flame elements oscillation and collective behavior helps us to modulate individual flame elements to reduce global heat release rate fluctuations.},
 author = {Yi Zhou and Chuanlong Xu and Weijie Liu and Ranran Xue and Wei Zhang and He Su and Liang Zhang},
 doi = {https://doi.org/10.1016/j.proci.2024.105463},
 issn = {1540-7489},
 journal = {Proceedings of the Combustion Institute},
 keyword = {Combustion dynamics, Computed tomography of chemiluminescence, Hydrogen, Multi-element flame, Combustion instabilities},
 number = {1},
 pages = {105463},
 title = {Phase-averaged three-dimensional reconstruction of self-excited multi-element partially premixed hydrogen flames},
 url = {https://www.sciencedirect.com/science/article/pii/S1540748924002712},
 volume = {40},
 year = {2024}
}
