 keyword = {Symbiosis;Sentiment analysis;Ethics;Technological innovation;Logistic regression;Social networking (online);Blogs;Internet of Things (IoT);Artificial Intelligence(AI);Natural Language Processing (NLP);TFIDF Vectorization;Linear Support Vector Classification (LinearSVC)},
 month = {Oct},
