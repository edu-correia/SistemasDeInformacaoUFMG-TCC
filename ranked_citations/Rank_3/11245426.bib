@inproceedings{11245426,
 abstract = {In distributed VLSI systems, clock networks dominate $30 \%-50 \%$ of dynamic power consumption, posing critical challenges for energy-efficient design. This paper proposes an enhanced K-means clustering algorithm to optimize flip-flop merging, significantly reducing clock power through decreased leaf nodes, shortened wirelength, and minimized buffer counts. Our method dynamically determines initial cluster centers via a distance threshold, groups flip-flops using Manhattan-distance-based K-means clustering, and maximizes merging via a greedy strategy. Experimental results demonstrate average reductions of 64.7 % in clock power and $\mathbf{2 1. 3 \%}$ in total power versus conventional non-merge flows, while maintaining stable performance. Against commercial tool-built-in merging, the algorithm achieves 24.3 % shorter clock wirelength, 37.4 % fewer clock buffers, and 31.1 % lower clock power. The approach exhibits high scalability in distributed VLSI environments, efficiently merging flip-flops across large-scale designs.},
 author = {Feng, Chaochao and Xu, Nuo and He, Xiaowei and Liao, Zhuofan},
 booktitle = {2025 IEEE International Symposium on Parallel and Distributed Processing with Applications (ISPA)},
 doi = {10.1109/ISPA67752.2025.00161},
 issn = {2158-9208},
 keyword = {Distributed processing;Power demand;Scalability;Merging;Clustering algorithms;Very large scale integration;Benchmark testing;Energy efficiency;Clocks;Flip-flops;K-means clustering;Flip-flop merging;Low-power VLSI design;Clock power reduction},
 month = {Oct},
 number = {},
 pages = {1175-1181},
 title = {Energy-Efficient Flip-Flop Merging via Enhanced K-Means Clustering in Distributed VLSI Systems},
 volume = {},
 year = {2025}
}
