@article{10.14778/3007263.3007265,
 abstract = {Recently graph has been drawing lots of attention both as a natural data model that captures fine-grained relationships between data entities and as a tool for powerful data analysis that considers such relationships. In this paper, we present a new graph database system that integrates a robust graph storage with an efficient graph analytics engine. Primarily, our system adopts two domain-specific languages (DSLs), one for describing graph analysis algorithms and the other for graph pattern matching queries. Compared to the API-based approaches in conventional graph processing systems, the DSL-based approach provides users with more flexible and intuitive ways of expressing algorithms and queries. Moreover, the DSL-based approach has significant performance benefits as well, (1) by skipping (remote) API invocation overhead and (2) by applying high-level optimization from the compiler.},
 author = {Sevenich, Martin and Hong, Sungpack and van Rest, Oskar and Wu, Zhe and Banerjee, Jayanta and Chafi, Hassan},
 doi = {10.14778/3007263.3007265},
 issn = {2150-8097},
 issue_date = {September 2016},
 journal = {Proc. VLDB Endow.},
 month = {September},
 number = {13},
 numpages = {12},
 pages = {1257–1268},
 publisher = {VLDB Endowment},
 title = {Using domain-specific languages for analytic graph databases},
 url = {https://doi.org/10.14778/3007263.3007265},
 volume = {9},
 year = {2016}
}
