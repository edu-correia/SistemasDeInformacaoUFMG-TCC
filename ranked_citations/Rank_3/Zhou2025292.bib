@conference{Zhou2025292,
 abstract = {The detection of pavement defects is critical for road safety, and deep learning methods offer an intelligent and efficient solution. While high-resolution drones enable wide-area monitoring, defects like cracks often constitute a small fraction of the pixels, posing a significant challenge for feature learning in detection models. To address this, we propose a versatile, drone-based framework for pavement crack detection that utilizes a multi-stage pipeline and a novel bounding box merging strategy. Our modular framework integrates customizable pre- and post-processing around various detection algorithms. Implementing our proposed strategies yielded substantial performance gains, with the AP50 metric improving by 34.6% for Faster R-CNN, 29.3% for YOLOv8X, and 36.9% for YOLOv9e. The proposed framework and its box merge strategy demonstrate significant potential for extension to other challenging small object detection tasks. © 2025 IEEE.},
 author = {Zhou, Renjie and Ren, Weiyu and Ming, Yang and Wang, Meiling},
 doi = {10.1109/ICCVDM66874.2025.11290262},
 journal = {2025 6th International Conference on Computer Vision and Data Mining, ICCVDM 2025},
 note = {Cited by: 0},
 pages = {292 - 299},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improvement of Tiny Crack Detection Accuracy in High Resolution Road Image Captured by Drone},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105031594815?origin=resultslist},
 year = {2025}
}
