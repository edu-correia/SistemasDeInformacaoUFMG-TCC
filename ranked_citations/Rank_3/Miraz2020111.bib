@article{Miraz2020111,
 abstract = {Purpose: The purpose of this study is to analyse the factors that influence blockchain users to utilise blockchain in e-Logistic. Also,this study identifies the relationship between supply chain capabilities, E-traceability and E-paymentintegration with blockchain and cryptocurrency. The conceptual framework of this study developed incorporating trust as an installation for a better understanding of the use of blockchain in Malaysia logistic sector. Theory: The unified theory of acceptance and use of technology (UTAUT2) by adding trust as an independent variable. This study aims to study the relationship between the main determinants of UTAUT2 and the factorsto use of blockchain and e-logistic for enhancement oflogistics industry. The conceptual framework of this study developed to merge trust as a synthesis in UTAUT2 for a better understanding ofe-logistic. Methodology: The cross-sectional approach used in this study. Four hundred seventy-eight self-administered questionnaires distributed through simple random sampling technology aimed at blockchain users in Malaysia from 25 to 44 years. Data analysis performed using PLS. The outcome of this research shows that the relationship between e-logistic, blockchain, cryptocurrency and trust have a positive and significant relationship. Significant: This research will significantly contribute to blockchain businesses and merchants in Malaysia.Also, it provides them with useful information about the interaction between the critical determinants of the supply chain capabilities, blockchainand cryptocurrency implementation in the logistics sector in Malaysia. Originality: This is one of the most recent studies that describe the blockchain and cryptocurrency in Malaysia logistics. © 2020, Institute of Advanced Scientific Research, Inc.. All rights reserved.},
 author = {Miraz, Mahadi Hasan and Mohd Sharif, Kamal Imran and Hassan, Mohamad Ghozali and Hasan, Mohammad Tariq},
 doi = {10.5373/JARDCS/V12SP3/20201244},
 journal = {Journal of Advanced Research in Dynamical and Control Systems},
 note = {Cited by: 8},
 number = {3 Special Issue},
 pages = {111 - 120},
 publication_stage = {Final},
 source = {Scopus},
 title = {Factors affecting e-logistics in Malaysia: The mediating role of trust},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85083527896?origin=resultslist},
 volume = {12},
 year = {2020}
}
