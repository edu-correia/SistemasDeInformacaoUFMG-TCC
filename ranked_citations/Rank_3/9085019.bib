@inproceedings{9085019,
 abstract = {Most of the existing Chinese entity relation extraction models have adopted methods which are based on character or word input. However, the word-based input method ignores potential word information in the sentence, and the method based on word input will be affected by the spread of word segmentation errors. In order to solve these problem, we introduce a lattice model that can merge words and characters input and use BiGRU instead of BiLSTM. After comparative experiments, our model achieves better results.},
 author = {Xu, Can and Yuan, LiPing and Zhong, Yi},
 booktitle = {2020 IEEE 4th Information Technology, Networking, Electronic and Automation Control Conference (ITNEC)},
 doi = {10.1109/ITNEC48623.2020.9085019},
 issn = {},
 keyword = {Automation;Conferences;Lattices;Data mining;Information technology;NRE;BiGRU;Lattic},
 month = {June},
 number = {},
 pages = {1188-1192},
 title = {Chinese Relation Extraction Using Lattice GRU},
 volume = {1},
 year = {2020}
}
