@article{Cholvy2005390,
 abstract = {This paper addresses the problem of merging beliefs provided by several sources which can be contradictory. Among the different methods for managing contradictions, this paper focuses on the one which takes into account the number of sources that support a piece of information and their reliability degrees as well. More precisely, this paper presents a modal logic, extending KD logic, for reasoning with merged beliefs accordingly. It also shows that this logic unifies two different logics that have been defined in the past. © Springer-Verlag Berlin Heidelberg 2005.},
 author = {Cholvy, Laurence},
 doi = {10.1007/11518655_34},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 5},
 pages = {390 - 401},
 publication_stage = {Final},
 source = {Scopus},
 title = {A modal logic for reasoning with contradictory beliefs which takes into account the number and the reliability of the sources},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/26944492172?origin=resultslist},
 volume = {3571 LNAI},
 year = {2005}
}
