@conference{Bayerl20161951,
 abstract = {The RDF Data Cube Vocabulary is the W3C recommendation for publishing multidimensional statistical data in asemantic web format. Alarge and growing number of such data cubes is already available in the linked data cloud, butthe data is distributed and isolated in many remote repositories. Having access to the data, applications can nowbedeveloped to explore and use it. To handle and correlate the distributed cubes, aprocess is necessary to merge them. This research aims at developing ahomogeneous management process for such cubes reaching from creation to visualization. The focus is put on the merging of RDF data cubes. In order to access and integrate the distributed cubes, asuitable ranking and discovery mechanism is needed. Therefore, asimilarity measure for cubes must be developed.},
 author = {Bayerl, Sebastian},
 journal = {Lecture Notes in Informatics (LNI), Proceedings - Series of the Gesellschaft fur Informatik (GI)},
 note = {Cited by: 0},
 pages = {1951 - 1956},
 publication_stage = {Final},
 source = {Scopus},
 title = {Managing distributed statistical data in the semantic web},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85032263219?origin=resultslist},
 volume = {P-259},
 year = {2016}
}
