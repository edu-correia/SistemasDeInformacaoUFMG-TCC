@inproceedings{5980946,
 abstract = {Along with the rapid development of computer technology, the construction of geographic information Digitizing has already entered the superheating stage increasingly. In order to seek the knowledge of geographical environment accurately and profoundly, the idea of conventional geographic information query merges the user service logic of query with code, however, which can hardly separate the service logic from the processing rule. It still need programmer to participate, and cannot realize the user-defined query. For that, this paper discuss the method to introduce the business engine into geographic information system. In order to adapting the structure of geographic data and environment of geographic information system, this paper has expanded functions of Rule Engine and designed a specific interpretation of Rule Base.},
 author = {Liu, Chenfan and Zhang, Hanfei},
 booktitle = {2011 19th International Conference on Geoinformatics},
 doi = {10.1109/GeoInformatics.2011.5980946},
 issn = {2161-0258},
 keyword = {Engines;Business;Production;Pattern matching;Databases;Data mining;Geographic Information Systems;User-defined query;Rule Engine;rule base;Rete},
 month = {June},
 number = {},
 pages = {1-4},
 title = {User-defined query of geographic information based on Rule Engine},
 volume = {},
 year = {2011}
}
