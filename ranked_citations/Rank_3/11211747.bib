@inproceedings{11211747,
 abstract = {Over the past few years, artificial intelligence (AI) and quantum computing have emerged as groundbreaking technologies in the field of drug discovery. Techniques like AI-driven molecular design, quantum-enhanced simulations, and hybrid approaches have made significant strides in tackling the complexity of drug-target interactions. However, current models still face key challenges, such as the limited scalability of quantum systems, the difficulty of generalizing AI models due to insufficient data quality, and the inefficiencies in merging quantum and classical methods. To overcome these obstacles, this paper introduces a new hybrid quantum-AI workflow. By combining the precision of quantum computing for molecular simulations with the predictive power of AI, this approach aims to improve accuracy, scalability, and efficiency in drug discovery, paving the way for future breakthroughs in the field.},
 author = {Sinha, Garima and S, Harshini B and Madhumitha},
 booktitle = {2025 International Conference on Engineering Innovations and Technologies (ICoEIT)},
 doi = {10.1109/ICoEIT63558.2025.11211747},
 issn = {},
 keyword = {Technological innovation;Quantum system;Computational modeling;Scalability;Biological system modeling;Merging;Predictive models;Data models;Drug discovery;Artificial intelligence;Quantum Computing;Artificial Intelligence;Drug Discovery;CADD;Quantum Machine Learning},
 month = {July},
 number = {},
 pages = {1247-1252},
 title = {Quantum AI in Drug Discovery: Bridging Gaps and Future Advancements},
 volume = {},
 year = {2025}
}
