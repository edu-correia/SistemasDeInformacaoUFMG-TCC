@conference{Barbalho2014314,
 abstract = {In this paper we describe a proposal to merge the social games with their properties and dynamic in the context of interactive television and its features and limitations. We have listed the common characteristics of social games and complemented with the aspects of TV to propose a set of requirements that social TV games should implement. After that, we have built a prototype called "Ilha dos Renegados", where we put together a social game and a TV plot. Then, we report on a survey with their players, and their feelings and impressions are analyzed using a qualitative methodology to validate these requirements. Copyright © 2014 IADIS Press All rights reserved.},
 author = {Barbalho, Thalles Robson and Bezerra, Ed Porto},
 journal = {Proceedings of the International Conferences on Interfaces and Human Computer Interaction 2014, Game and Entertainment Technologies 2014 and Computer Graphics, Visualization, Computer Vision and Image Processing 2014 - Part of the Multi Conference on Computer Science and Information Systems, MCCSIS 2014},
 note = {Cited by: 0},
 pages = {314 - 319},
 publication_stage = {Final},
 source = {Scopus},
 title = {A set of requirements to social games used in digital interactive television},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84929439479?origin=resultslist},
 year = {2014}
}
