@conference{Tensmeyer2019114,
 abstract = {Given the large variety and complexity of tables, table structure extraction is a challenging task in automated document analysis systems. We present a pair of novel deep learning models (Split and Merge models) that given an input image, 1) predicts the basic table grid pattern and 2) predicts which grid elements should be merged to recover cells that span multiple rows or columns. We propose projection pooling as a novel component of the Split model and grid pooling as a novel part of the Merge model. While most Fully Convolutional Networks rely on local evidence, these unique pooling regions allow our models to take advantage of the global table structure. We achieve state-of-the-art performance on the public ICDAR 2013 Table Competition dataset of PDF documents. On a much larger private dataset which we used to train the models, we significantly outperform both a state-ofthe-art deep model and a major commercial software system. © 2019 IEEE.},
 author = {Tensmeyer, Chris and Morariu, Vlad I. and Price, Brian and Cohen, Scott and Martinez, Tony},
 doi = {10.1109/ICDAR.2019.00027},
 journal = {Proceedings of the International Conference on Document Analysis and Recognition, ICDAR},
 note = {Cited by: 119},
 pages = {114 - 121},
 publication_stage = {Final},
 source = {Scopus},
 title = {Deep splitting and merging for table structure decomposition},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85079870251?origin=resultslist},
 year = {2019}
}
