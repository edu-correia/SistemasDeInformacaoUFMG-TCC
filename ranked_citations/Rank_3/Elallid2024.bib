 publication_stage = {Final},
 source = {Scopus},
 title = {Enhancing Autonomous Driving Navigation Using Soft Actor-Critic},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85199648556?origin=resultslist},
 volume = {16},
