@conference{Leenoi2011146,
 abstract = {This paper presents the current status and caveat of the Thai FrameNet project. Through four modules, a combination approach: the expand and the merge, is implemented. The alignment of the original FrameNet is made by way of the former whilst the latter manifests the indigenous Thai conceptual scenarios. Currently, 1,339 frames, 22,708 lexical units, and 2,333 annotated sentences are obtained as a result. Frames are organised in the Thai FrameNet database and connected by seven frame-to-frame relations. © 2011 IEEE.},
 author = {Leenoi, Dhanon and Jumpathong, Sawittree and Supnithi, Thepchai},
 doi = {10.1109/NLPKE.2011.6138183},
 journal = {NLP-KE 2011 - Proceedings of the 7th International Conference on Natural Language Processing and Knowledge Engineering},
 note = {Cited by: 1},
 pages = {146 - 149},
 publication_stage = {Final},
 source = {Scopus},
 title = {Manifesting Thai conceptual scenarios through Thai FrameNet},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84857335803?origin=resultslist},
 year = {2011}
}
