@article{Lee2005731,
 abstract = {The key word in the 2nd round of portal competition will be Personalization. This study reviewed recent core research related to Web Personalization and thus showed the ideal next generation model based on recent personalization strategies of major portals. The model is mainly composed of the following: Open Content strategy based on RSS; Personalized Search based on a user's preferences, Desktop Search, My Web storage, etc; Social Network, the concept that a user can share information with others depending on his interests; and Ubiquitous Computing that can merge people, computers and materials with the help of various multimedia technologies. © Springer-Verlag Berlin Heidelberg 2005.},
 author = {Lee, Seiyoung and Yong, Hwan-Seung},
 doi = {10.1007/11581062_80},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3},
 pages = {731 - 739},
 publication_stage = {Final},
 source = {Scopus},
 title = {Web personalization: My own web based on open content platform},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33744793743?origin=resultslist},
 volume = {3806 LNCS},
 year = {2005}
}
