@article{Jimenez-Moreno2016563,
 abstract = {The emerging high-efficiency video coding standard achieves higher coding efficiency than previous standards by virtue of a set of new coding tools such as the quadtree coding structure. In this novel structure, the pixels are organized into coding units (CU), prediction units, and transform units, the sizes of which can be optimized at every level following a tree configuration. These tools allow highly flexible data representation; however, they incur a very high computational complexity. In this paper, we propose an effective complexity control (CC) algorithm based on a hierarchical approach. An early termination condition is defined at every CU size to determine whether subsequent CU sizes should be explored. The actual encoding times are also considered to satisfy the target complexity in real time. Moreover, all parameters of the algorithm are estimated on the fly to adapt its behavior to the video content, the encoding configuration, and the target complexity over time. The experimental results prove that our proposal is able to achieve a target complexity reduction of up to 60% with respect to full exploration, with notable accuracy and limited losses in coding performance. It was compared with a state-of-the-art CC method and shown to achieve a significantly better trade-off between coding complexity and efficiency as well as higher accuracy in reaching the target complexity. Furthermore, a comparison with a state-of-the-art complexity reduction method highlights the advantages of our CC framework. Finally, we show that the proposed method performs well when the target complexity varies over time. © 2016 IEEE.},
 author = {Jimenez-Moreno, Amaya and Martinez-Enriquez, Eduardo and Diaz-De-Maria, Fernando},
 doi = {10.1109/TMM.2016.2524995},
 journal = {IEEE Transactions on Multimedia},
 note = {Cited by: 37; All Open Access; Green Open Access},
 number = {4},
 pages = {563 - 575},
 publication_stage = {Final},
 source = {Scopus},
 title = {Complexity Control Based on a Fast Coding Unit Decision Method in the HEVC Video Coding Standard},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84963813280?origin=resultslist},
 volume = {18},
