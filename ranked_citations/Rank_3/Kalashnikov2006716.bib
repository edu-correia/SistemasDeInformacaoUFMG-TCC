@article{Kalashnikov2006716,
 abstract = {In this article, we address the problem of reference disambiguation. Specifically, we consider a situation where entities in the database are referred to using descriptions (e.g., a set of instantiated attributes). The objective of reference disambiguation is to identify the unique entity to which each description corresponds. The key difference between the approach we propose (called RELDC) and the traditional techniques is that RELDC analyzes not only object features but also inter-object relationships to improve the disambiguation quality. Our extensive experiments over two real data sets and over synthetic datasets show that analysis of relationships significantly improves quality of the result. © 2006 ACM.},
 author = {Kalashnikov, Dmitri V. and Mehrotra, Sharad},
 doi = {10.1145/1138394.1138401},
 journal = {ACM Transactions on Database Systems},
 note = {Cited by: 139},
 number = {2},
 pages = {716 - 767},
 publication_stage = {Final},
 source = {Scopus},
 title = {Domain-independent data cleaning via analysis of entity-relationship graph},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33745266392?origin=resultslist},
 volume = {31},
 year = {2006}
}
