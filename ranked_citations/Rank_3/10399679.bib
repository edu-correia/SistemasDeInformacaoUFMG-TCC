@inproceedings{10399679,
 abstract = {Micro light-emitting diode (LED (LED) is considered as a promising next-generation display technology, owing to its superior performances such as high efficiency and fast response. Although GaN-based Micro-LED is mainly used as a light source, it can be utilized as a photodetector as well due to its crystal structure and material properties. This dual function enables Micro-LED to realize the monolithic integration of light source and photodetector, making it advantageous in visible light communication (VLC) applications. In this paper, a new monolithic integrated device of GaN-based high electron mobility transistor (HEMT) and Micro-LED is proposed by merging the features of HEMT and LED epitaxy without selective epitaxial growth, to integrate driving transistor and Micro- led on the same substrate. In this paper, the integrated HEMT-LED structure was tested as an optical detector under the wavelength of 365nm, 395nm and 425nm and the optical current at different light intensities. The response rate and bright/dark current ratio were derived. At the wavelength of 365 nm, the light intensity reaches its maximum value of 4.06 × 10-4 mW/cm2, and a peak responsivity of 7000 A/W is obtained. This work provides a promising solution for the future exploration of the device structure design of monolithic integration of light source and optical detector in VLC systems.},
 author = {Wang, Haoyu and Gao, Yuan and Li, Yi and Ren, Kailin and Yin, Luqiao and Zhang, Jianhua},
 booktitle = {2023 20th China International Forum on Solid State Lighting & 2023 9th International Forum on Wide Bandgap Semiconductors (SSLCHINA: IFWS)},
 doi = {10.1109/SSLChinaIFWS60785.2023.10399679},
 issn = {},
 keyword = {Monolithic integrated circuits;HEMTs;Optical detectors;Light emitting diodes;Photodetectors;Epitaxial growth;Transistors},
 month = {Nov},
 number = {},
 pages = {463-465},
 title = {A Novel Monolithic Integration Of HEMT And Micro-LED Performing As A Photodetector},
 volume = {},
