@inproceedings{6086209,
 abstract = {ACL is the fundamental essence of interactions between multi-agents, such as cooperation and collaboration. KQML, FIPA_ACL and other agent communication languages laid a foundation for development and application of ACLs. However, they have a number of shortcomings in sociality, commitment expression and dialogue policy. In this paper, for eBusiness and related fields, we propose a binary collaboration-based, ebXML standard-compatible Agent Communication Language (ebACL), and establish a series of ebACL execution primitives to describe the functions. The language framework adopts CPP as content formats of agent negotiation, and CPA as results of negotiation. Furthermore, the framework can be merged with the mainstream of semantic-oriented web services technologies to achieve high scalability. We also verify the feasibility of ebACL through knowledge supply-based expert system, and the result shows that ebACL is effective and practical.},
 author = {Jin, Zhi Yong and Ye, Shi Ping},
 booktitle = {2011 International Conference on Computational and Information Sciences},
 doi = {10.1109/ICCIS.2011.139},
 issn = {},
 keyword = {Collaboration;Contracts;Ontologies;Monitoring;Instant messaging;Standards;Agent;ACL;ebXML;ebACL;CPA},
 month = {Oct},
 number = {},
 pages = {361-365},
 title = {ebXML-compatible Agent Communication Language},
 volume = {},
 year = {2011}
}
