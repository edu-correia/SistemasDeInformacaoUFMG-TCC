@incollection{QUESADAROMAN2026369,
 abstract = {This study presents a comprehensive geomorphological mapping methodology designed for landslide and flood hazard assessment. The method integrates geospatial analysis using available detailed digital elevation models (DEMs). The geomorphological map is developed through premapping, mapping, fieldwork, and postmapping stages. In the premapping stage, topographic and hydrographic features are prepared, and landforms are identified based on shape, texture, and color using GIS software. The mapping process organizes the landscape into geomorphological units, classified according to morphostructural characteristics and active morphodynamic processes. These units are defined by abrupt changes in slope, lithology, and geomorphic activity, ensuring homogeneous representation of terrain dynamics. Field verification validates the mapped landforms and refines the understanding of active processes influencing hazard susceptibility. The postmapping stage involves creating a detailed legend that categorizes landforms. This mapping approach provides a crucial foundation for assessing landslide and flood hazards, utilizing normalized terrain variables like slope, terrain ruggedness, topographic wetness index, and flow accumulation. Additionally, the risk assessment incorporates exposure and vulnerability analysis using data on human development, population density, road networks, and land use. This integration identifies high-risk areas where natural hazards intersect with high levels of human vulnerability. By merging GIS assessment, fieldwork, geomorphology, and socioeconomic analysis, this method gives a robust framework for characterizing hazardous areas, assisting in disaster risk reduction and land-use planning efforts.},
 author = {Adolfo Quesada-Román},
 booktitle = {Quantitative Geomorphology in the Artificial intelligence Era},
 doi = {https://doi.org/10.1016/B978-0-443-30036-3.00002-2},
 editor = {Hamid Reza Pourghasemi and Narges Kariminejad},
 isbn = {978-0-443-30036-3},
 keyword = {Geomorphological mapping, disaster risk reduction, flood risk, landslide risk, natural hazards},
 pages = {369-398},
 publisher = {Elsevier},
 title = {Chapter 18 - Integrated geomorphological method for landslide and flood hazard mapping and risk assessment},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443300363000022},
 year = {2026}
}
