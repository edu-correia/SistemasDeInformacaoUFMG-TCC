@article{XU2026114939,
 abstract = {To address the limitations of traditional single-strategy models in handling hydrological time series prediction, especially in capturing long-range dependencies, local patterns, and dynamic features, this study proposes a novel model for monthly runoff forecasting, TLDA (Temporal Learning and Dynamic Adjustment). TLDA is designed to tackle the stochasticity and nonlinearity of runoff data by integrating several advanced components. These include the TCN-GLU layer with causal dilated convolution for long-term dependencies, the lightweight bidirectional LightLSTM for long-term memory, the DyT layer for dynamic feature modulation, the Hybrid attention mechanism merging local and global attention for multi-scale features, and a feature distillation layer for optimized feature representation. Through these integrated components, TLDA effectively captures both local trends and prolonged runoff information dependencies. Experiments conducted across three hydrometric stations demonstrate that TLDA significantly improves prediction accuracy. Compared to the Transformer, TLDA reduces MAE by 31.2% and RMSE by 35.7% at Fenglehe Station, and achieves an NSE of 0.9498 and a KGE of 0.9516 at Hongshanhe Station, representing improvements of approximately 10.5% in NSE and 12.8% in KGE compared to the standard Transformer model. Furthermore, visualization of learned temporal weights in the DyT layer demonstrates its hydrological interpretability, showing dynamic adaptation to flood peaks and base flows. These results highlight TLDA's superiority as an efficient new approach for monthly runoff prediction, with significant practical and theoretical implications.},
 author = {Dong-mei Xu and Qi-qi Zeng and Wen-chuan Wang and Qiang Ma},
 doi = {https://doi.org/10.1016/j.asoc.2026.114939},
 issn = {1568-4946},
 journal = {Applied Soft Computing},
 keyword = {Runoff prediction, Multi-scale features, Lightweight, Dynamic adaptability, Hybrid attention mechanism},
 pages = {114939},
 title = {TLDA: A lightweight and adaptive deep learning framework for accurate monthly runoff forecasting},
 url = {https://www.sciencedirect.com/science/article/pii/S156849462600387X},
 volume = {194},
 year = {2026}
}
