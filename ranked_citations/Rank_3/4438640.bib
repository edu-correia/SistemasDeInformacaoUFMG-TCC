@inproceedings{4438640,
 abstract = {The technology of grid workflow has attracted growing attention in the recent years. With the desire for knowledge retrieval and reuse, the need of a semantic grid workflow description framework emerged. In this paper, we put forward a new angle of view that use goal ontology derived from request engineering to describe the semantic of grid workflow. An extendable and configurable semantic framework is proposed to describe and query workflow with semantic template based on the goal ontology. A practical case is introduced to validate the feasibility and efficiency of the framework.},
 author = {Wang, Yi and Cao, Jian and Li, Minglu},
 booktitle = {Third International Conference on Semantics, Knowledge and Grid (SKG 2007)},
 doi = {10.1109/SKG.2007.87},
 issn = {},
 keyword = {Ontologies;Image segmentation;Packaging;Computer science;Knowledge engineering;Humans;Energy management;Merging;Kernel;Libraries},
 month = {Oct},
 number = {},
 pages = {598-599},
 title = {Goal-Driven Semantic Description and Query for Grid Workflow},
 volume = {},
 year = {2007}
}
