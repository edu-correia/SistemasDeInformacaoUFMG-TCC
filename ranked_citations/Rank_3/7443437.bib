@inproceedings{7443437,
 abstract = {Worldwide Interoperability for Microwave Access (WiMAX), which based on the IEEE 802.16-2009 standard is a serious competitor of Long Term Evolution (LTE) for cellular networks providing high data rates to mobile users. To support various multimedia applications the Quality of Service (QoS) support is a crucial function. This standard determines the air interface, including the medium access control layer (MAC) and physical layer (PHY), of consolidated fixed and mobile point-tomultipoint broadband wireless access (BWA) frameworks offering numerous services. This standard is a revision of IEEE 802.16-2004 and merges features from IEEE 802.16e-2005, IEEE 802.16-2004/Cor1-2005, IEEE 802.16f-2005, and IEEE 802.16g-2007, alongside extra support things and upgrades to the management data base specifications. This paper addresses an OFDMA downlink partial usage of subchannels (PUSC) physical layer communication from base station (BS) to two mobile stations (MS), as per the IEEE 802.16-2009 standard.},
 author = {Reddy, Bathula Siva Kumar and Lakshmi, B.},
 booktitle = {2015 Annual IEEE India Conference (INDICON)},
 doi = {10.1109/INDICON.2015.7443437},
 issn = {2325-9418},
 keyword = {IEEE 802.16 Standard;AWGN channels;Quality of service;WiMAX;Switches;Encoding;Resource management;BS;MS;OFDMA;PUSC;WiMAX},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {OFDMA downlink physical layer communication for IEEE 802.16-2009 standard},
 volume = {},
 year = {2015}
}
