@inproceedings{10071163,
 abstract = {This paper proposes a TSN-based data distribution service (DDS) implementation method for solving the application flexibility problem of Time Sensitive Network (TSN). First, we propose stream monitoring method for a system-level network controlling; Second, a network management methods is proposed, which adjusts the gate control strategy in accordance with real-time flow; Finally, we have merged TSN driver to DDS for improving the publishing and subscription performance. The experiment results show that the proposed method has established a certainty DDS system with great communication efficient and flexibility.},
 author = {Ren, Jianxin and Zhao, Manfei and Wang, Haofeng and Gao, Tong and Yao, Peng and Shao, Zonglin},
