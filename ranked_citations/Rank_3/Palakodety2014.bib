@conference{Palakodety2014,
 abstract = {This paper describes Carnegie Mellon University’s entry at the TREC 2014 Federated Web Search track (FedWeb14). Federated search pipelines typically have two components: (i) resource-selection, and (ii) result-merging. This work documents experiments to modify queries to merge results in the federated-search pipeline. Approaches from previous attempts at solving this problem involved custom query-document similarity scores or rank-combination methods. In this document, we explore how term-dependence models and query expansion strategies influence result-merging. © 2014 23rd Text REtrieval Conference, TREC 2014 - Proceedings. All rights reserved.},
 author = {Palakodety, Shriphani and Callan, Jamie},
 journal = {23rd Text REtrieval Conference, TREC 2014 - Proceedings},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Query Transformations for Result Merging},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85046984260?origin=resultslist},
 year = {2014}
}
