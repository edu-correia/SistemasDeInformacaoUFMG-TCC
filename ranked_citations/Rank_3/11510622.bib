@inproceedings{11510622,
 abstract = {Traffic congestion and environmental degradation in urban Egypt emphasize the urgent need for innovative and sustainable mobility solutions. Carpooling presents a promising approach, yet its effectiveness depends on intelligent ridematching systems tailored to local commuting patterns. This paper introduces an enhanced Partition Merging Algorithm (PMA) for scheduled ride-sharing. Building on the foundational PMA framework, we integrate key enhancements to support multi-passenger requests, accommodate gender-based ride preferences, enforce conditional walking distances to pickup points, and limit the number of stops per driver. This work includes optimization of some code parts via parallelization. Evaluated on our commuter trips simulated dataset in Alexandria, our algorithm achieves high matching rates-up to 60 % under optimal conditions with low computational overhead.},
 author = {Khaled, Hussein and Mohamed, Hussein and Essam, Marwan and Osama, Mariam and Gerges, Mariam and Abdelrahman, Mohamed},
 booktitle = {2025 26th International Arab Conference on Information Technology (ACIT)},
 doi = {10.1109/ACIT68900.2025.11510622},
 issn = {2831-4948},
 keyword = {Algorithms;Timing;Legged locomotion;Distance measurement;Optimization;Printing;Shared transport;Modeling;Vehicles;Limiting;adaptive Algorithms;System design;optimization;simulation;environmental problem},
 month = {Dec},
 number = {},
 pages = {937-944},
 title = {Ride-Sharing Matching Algorithm Based on Partition Merging},
 volume = {},
 year = {2025}
}
