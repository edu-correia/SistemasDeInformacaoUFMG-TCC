@conference{Sullivan2025,
 abstract = {Amid cozy and casual games are those with mechanics allowing player creativity through design. Although player creativity has been identified as a major motivation for such play, these games are currently under-researched. In this paper, we define this genre as “design-based games” and identify evaluating player designs as a major challenge these games face. We discuss four main evaluation strategies currently used in design-based games, derived from an initial survey of the genre: evaluation through formal design principles, relying on attributes not related to design, using other players to evaluate designs, and removing the design elements from the primary game loop so that evaluation is not necessary. We look at six highly successful design-based games as case studies and discuss the challenges and opportunities of evaluating player creativity, as well as design-based games as a genre. © 2025 Copyright held by the owner/author(s).},
 author = {Sullivan, Anne and Stanfill, Mel and Salter, Anastasia and Wardrip-Fruin, Noah},
 doi = {10.1145/3723498.3723814},
 journal = {Proceedings of the 20th International Conference on the Foundations of Digital Games, FDG 2025},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Form and Function: Toward a Better Understanding of Design-Based Games},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105007411698?origin=resultslist},
 year = {2025}
}
