@inproceedings{7277309,
 abstract = {The widespread of I.T. paved the way to produce software for the Holy Quran studies, to provide quick access, analyze and index information in order to be able to compare information. It also facilitates the exchange of information by copying and sending via Internet. Many companies are competing in this area which led to the increase of development of software related to the Holy Quran studies, however, without verifying the integrity of information which exists in these tools. Thus, this should be done according to a matrix of technical standards agreed upon by technichians, experts and scholars who are experts in the area of quality and standards in order to produce authentic digital Quranic text with high quality and accuracy. This requires the development of a matrix of technical standards to control the quality and a reliable methodology based on Information System to be used for the Holy Quran (Holy Quran Information System). This proposed matrix should depend on high quality standards, international benchmarking and accreditation, as well as it should useKey Performance Indicators ( KPI). which consists of a group of main factors to be one of the regular tools for testing, measurement, assessment and evaluation for all main processes of software including its content and details aiming at Software Process Improvement (SPI) by merging I.T. in the service of the Holy Quran studies. These techniques are incorporated in order to provide accuracy , excellence and efficiency for the input, processing and output of the Holy Quran Information System.Therefore, this prepares products in order to be qualifiedfor receiving the Quality Mark and Accreditation Certification from an accredited institution. It is proposed that this matrix be used as the basis for anyone who wishes to develop any kind of software in the area of the Holy Quran and its Sciences in accordance to scientific and Shari'a law.},
 author = {Elhassan, Mohammed Sulaiman},
 booktitle = {2013 Taibah University International Conference on Advances in Information Technology for the Holy Quran and Its Sciences},
 doi = {10.1109/NOORIC.2013.112},
 issn = {},
 keyword = {Standards;Accreditation;Software;Benchmark testing;Accuracy;Software measurement;Accreditation;International Benchmarking;Quality;Key Performance Indicator(KPI);Software Process Improvement (SPI).},
 month = {Dec},
 number = {},
 pages = {809-846},
 title = {Matrix Quality Standards and Accreditation Methodology for Software Tools Related to Quranic Sciences Studies},
 volume = {},
 year = {2013}
}
