@inproceedings{10867208,
 abstract = {The functionality of a security architecture for advanced Internet of Things (IoT) devices is discussed in this article. Validated key configuration and access control that is based on tokens are absolutely necessary in order to guarantee the safety of this idea. In order to keep up with the rapid proliferation of the IoT ecosystem, it is imperative that the availability, integrity, and security of data be maintained at all times. Token-based access control is an opportunity to provide a workable solution to one of the most common concerns raised about the safety of the internet of things (IoT). This article's objective is to improve the safety of the Internet of Things (IoT) by analyzing the guiding principles, implementation tactics, and benefits offered by a variety of security measures that may be included into complex IoT systems. In this article, we explain how token-based access control and verified key generation may be merged into a single, all-encompassing method to strengthen the safety of platforms used for the internet of things (IoT). Token-based access control provides flexibility and adaptability when it comes to regulating rights in dynamic settings that are linked to the Internet of Things. In order to shield oneself from potential dangers such as man-in-the-middle attacks, one must take the necessary precautions, such as generating authorized keys to keep the privacy of one's communication routes secret. This research uses performance measurements, comparisons of code sizes, and statistical analysis to evaluate and examine the efficacy and efficiency of a variety of different security methods. The findings demonstrate how readily the recommended methodology may be adapted to meet the requirements of a wide variety of Internet of Things (IoT) systems. This paper is a helpful resource for enterprises and developers who work in dynamic situations and are interested in strengthening the security of Internet of Things deployments.},
 author = {William, P. and Kotiyal, Arnav and Al-Jawahry, Hassan M. and Shrivastava, Anurag and Yadav, Kanchan and Aswini, Kilaru},
 booktitle = {2024 1st International Conference on Sustainable Computing and Integrated Communication in Changing Landscape of AI (ICSCAI)},
 doi = {10.1109/ICSCAI61790.2024.10867208},
 issn = {},
 keyword = {Access control;Codes;Statistical analysis;Smart cities;Process control;Safety;Internet of Things;Security;Cryptography;Protection;IoT Security;Token-Based Access Control;Authenticated Key Establishment;Complex IoT Platforms;Security Mechanisms},
 month = {July},
 number = {},
 pages = {1-13},
 title = {Securing Complex IoT Platforms with Token Based Access Control and Authenticated Key Establishment},
 volume = {},
