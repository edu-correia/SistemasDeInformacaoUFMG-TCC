@article{Xue20241582,
 abstract = {Join is an important but data-intensive and compute-intensive operation in database systems. Moreover, there are multiple types of join operations according to different join conditions and data relationships with diverse complexities. Because most existing solutions for accelerating the join operation on field programmable gate arrays (FPGAs) focus only on the easiest join application, this study presents a novel architecture that is suitable for multiple types of join operation. This architecture has a modular design and consists of three components that are executed sequentially and in pipeline. Specifically, the top-K sorter is used instead of the full sorter to reduce resource utilization and advance the merge processing. Further, the architecture is perfectly compatible with both N-to-1 and N-to-M join relationships, and can also adapt well to both equi-join and band-join. Experimental results show that this design, which is implemented on an FPGA, achieved a high join throughput of 242.1 million tuples per second, which is better than other reported FPGA implementations. © 2024 The Institute of Electronics, Information and Communication Engineers.},
 author = {Xue, Meiting and Wu, Wenqi and Luo, Jinfeng and Zhang, Yixuan and Zhao, Bei},
 doi = {10.1587/transfun.2023EAP1135},
 journal = {IEICE Transactions on Fundamentals of Electronics, Communications and Computer Sciences},
 note = {Cited by: 1; All Open Access; Bronze Open Access},
 number = {10},
 pages = {1582 - 1594},
 publication_stage = {Final},
 source = {Scopus},
 title = {High-Parallelism and Pipelined Architecture for Accelerating Sort-Merge Join on FPGA},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85206619737?origin=resultslist},
 volume = {E107.A},
 year = {2024}
}
