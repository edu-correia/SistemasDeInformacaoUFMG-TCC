@article{Zhao201894,
 abstract = {This work presents a systematic exploration on the promise and special challenges of deep learning for sparse matrix format selection - -a problem of determining the best storage format for a matrix to maximize the performance of Sparse Matrix Vector Multiplication (SpMV). It describes how to effectively bridge the gap between deep learning and the special needs of the pillar HPC problem through a set of techniques on matrix representations, deep learning structure, and cross-architecture model migrations. The new solution cuts format selection errors by two thirds, and improves SpMV performance by 1.73X on average over the state of the art. © 2018 ACM.},
 author = {Zhao, Yue and Li, Jiajia and Liao, Chunhua and Shen, Xipeng},
 doi = {10.1145/3178487.3178495},
 journal = {ACM SIGPLAN Notices},
 note = {Cited by: 21},
 number = {1},
 pages = {94 - 108},
 publication_stage = {Final},
 source = {Scopus},
 title = {Bridging the gap between deep learning and sparse matrix format selection},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85084184113?origin=resultslist},
 volume = {53},
 year = {2018}
}
