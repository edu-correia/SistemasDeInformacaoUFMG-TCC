 abstract = {The interaction between media technology and artificial intelligence (AI) has become a significant factor in today's technological environment. This review provides a thorough examination of the complex and mutually beneficial link between these two areas, clarifying important patterns, difficulties, and significant effects. The literature study consolidates current understanding by analysing the convergence of AI algorithms and improvements in media technology, and their impact on the landscape of content generation, distribution, and consumption. The concept of integration plays a vital role, since AI has a significant impact on media technologies and vice versa. We explore particular cases where AI-powered advancements redefine the creation of content, improve user experiences, and transform data-driven decision-making in media companies. The study also examines the significant influence of this symbiotic relationship on the wider media environment, including changes in audience participation, customized content distribution, and the merging of conventional and digital media platforms. Although the potential for transformation is significant, other problems arise, including ethical issues as well as algorithmic biases. The abstract also emphasizes the potential for AI to solve persistent difficulties in media production and consumption, while highlighting chances for innovation. The paper discusses probable future developments, such as the changing role of AI in immersive media experiences and the ethical considerations surrounding AI-generated content. Ultimately, this analysis offers a detailed comprehension of the interdependent connection between media technology and AI, presenting valuable perspectives for scholars, practitioners, and policymakers. As the field of technology advances, this investigation establishes the foundation for predicting and manoeuvring through the complex connections between media technology and artificial intelligence.},
 author = {Ghani, Miharaini Md and Mustafa, Wan Azani and Shakir, Aboothar mahmood and Bakhtiar, Durratul Laquesha Shaiful and Ramadan, Ghazi Mohamad},
