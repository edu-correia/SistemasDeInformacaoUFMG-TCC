@article{SHOJAEE2024109864,
 abstract = {This paper introduces an integrated model that merges three key concepts: quality control through linear profile monitoring using Hotelling's T2 control chart, production cost evaluation, and maintenance policies. The objective function of the integrated model is to minimize total costs. This study is the first to jointly consider production and maintenance costs in the framework of profile monitoring using Hotelling’s T2 control chart for linear profiles without compromising on the versatility of simple linear profiles as a modeling tool, particularly in calibration applications. Appropriate assumptions are made for the proposed integrated model and the particle swarm optimization algorithm is implemented to determine decision variables. To evaluate the effectiveness of the integrated model, a numerical example and a comprehensive comparative analysis are conducted. Moreover, a sensitivity analysis to study the effects of various input parameters on the optimal solutions is performed. The findings suggest that adopting the integrated model with specific decision variables results in lower expected total costs when compared to the joint model and fixed parameter schemes.},
 author = {Mohsen Shojaee and Siamak Noori and Samrad Jafarian-Namin and Arne Johannssen},
 doi = {https://doi.org/10.1016/j.cie.2023.109864},
 issn = {0360-8352},
 journal = {Computers & Industrial Engineering},
 keyword = {Economic production, Maintenance policy, Integrated model, Particle swarm optimization, Profile monitoring},
 pages = {109864},
 title = {Integration of production–maintenance planning and monitoring simple linear profiles via Hotelling's T2 control chart and particle swarm optimization},
 url = {https://www.sciencedirect.com/science/article/pii/S0360835223008884},
 volume = {188},
 year = {2024}
}
