@article{Abidi200981,
 abstract = {Decision support systems based on computerized Clinical Protocols (CP) and Clinical Practice Guidelines (CPG) fall short when dealing with patient co-morbidites, as this demands the concurrent merging of multiple CP/CPG. We present an ontology-based approach for the merging of CPG and CP at two levels-i.e. knowledge modeling level and knowledge execution level. We have developed specialized ontological modeling constructs to facilitate merging of CPG and CP. We demonstrate the merging of multiple location-specific CP and disease-specific CPG. © 2009 Springer Berlin Heidelberg.},
 author = {Abidi, Samina Raza and Abidi, Syed Sibte Raza},
 doi = {10.1007/978-3-642-02976-9_10},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 18},
 pages = {81 - 85},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards the merging of multiple clinical protocols and guidelines via ontology-driven modeling},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70350581105?origin=resultslist},
 volume = {5651 LNAI},
 year = {2009}
}
