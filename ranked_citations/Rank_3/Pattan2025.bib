@conference{Pattan2025,
 abstract = {Sonatype Nexus serves as a powerful repository management solution widely adopted in DevOps pipelines and CI/CD practices. It streamlines the handling, storage, and retrieval of binary components, acting as a central hub for organizing build outputs, dependencies, and container images. By doing so, it strengthens team collaboration and ensures proper governance of the software supply chain. In day-to-day usage, multiple repositories within a Nexus environment accumulate diverse artifacts, often leading to rapid storage consumption. Administrators are tasked with monitoring and clearing space once usage surpasses predefined limits. Neglecting this responsibility may trigger system downtime, directly affecting ongoing business operations. Although Nexus provides built-in automated cleanup tasks, these tools present limitations, particularly when targeting selective artifact removal. This becomes problematic when large but important artifacts dominate storage capacity, reducing free space without a precise forecast of when the server might crash. To overcome this challenge, this study proposes the application of a machine learning technique - specifically, Linear Regression - to examine and predict disk usage trends. The regression model will derive an equation based on existing data, enabling predictions of future space consumption and offering a proactive solution to manage server capacity. © 2025 IEEE.},
 author = {Pattan, Kalesha Khan},
 doi = {10.1109/ICECER65523.2025.11401356},
 journal = {International Conference on Electrical and Computer Engineering Researches, ICECER 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Advanced Statistical Forecasting For Storage Resource Utilization Efficiency},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105035749392?origin=resultslist},
 year = {2025}
