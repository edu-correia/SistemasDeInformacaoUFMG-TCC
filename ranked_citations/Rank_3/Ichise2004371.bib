@article{Ichise2004371,
 abstract = {When we have a large amount of information, we usually use categories with a hierarchy, in which all information is assigned. The Yahoo! Internet directory is one such example. This paper proposes a new method of integrating two catalogs with hierarchical categories. The proposed method uses not only the contents of information but also the structures of both hierarchical categories. In order to evaluate the proposed method, we conducted experiments using two actual Internet directories, Yahoo! and Google. The results show improved performance compared with the previous approaches. © Springer-Verlag 2004.},
 author = {Ichise, Ryutaro and Hamasaki, Masahiro and Takeda, Hideaki},
 doi = {10.1007/978-3-540-30214-8_33},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 11},
 pages = {371 - 379},
 publication_stage = {Final},
 source = {Scopus},
 title = {Discovering Relationships among Catalogs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/35048878313?origin=resultslist},
 volume = {3245},
 year = {2004}
}
