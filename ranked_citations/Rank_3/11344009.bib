@inproceedings{11344009,
 abstract = {Word Sense Disambiguation within NLP is one of the important tasks of assigning the correct meaning of a polysemous word via its context. Accurate WSD is very important for many NLP applications including MT, information retrieval and sentiment analysis just to name few. Yet succeeding in WSD is difficult, since natural English itself presents great word ambiguity, especially where words can have more than one meaning, depending on types of very subtle contextual clues. Usually, traditional supervised methods need a lot of labeled data, which is expensive and laborious to get. For this purpose, we introduce an innovative approach based on the use of the self-supervised Multiview contrastive learning for WSD. This method merges three distinct views of the context of a word, namely semantic, syntactic, and global, and encodes and fuses them into a holistic word representation. It's a framework that leverages the contrastive learning that helps the model learn robust word representations unassisted supervised data. The results of our experiments are consistent with improvements over baseline models in terms of WSD accuracy, suggesting the usefulness of this approach. Second, it allows for an improvement in WSD in resource constrained environments as the dependency on large labeled datasets can be lowered. In addition, the model achieves the self-supervised nature, which enables the model to be applicable in a variety of NLP tasks and is a valuable solution to research and practical purpose of text understanding and machine translation.},
 author = {Venu Gopal Reddy, A. and Wahaj Mohsin, Syed and Jain, Neha and Subhashini, R. and Jyothi Preshiya, D. and Karthik, M.},
 booktitle = {2025 International Conference on Responsible, Generative and Explainable AI (ResGenXAI)},
 doi = {10.1109/ResgenXAI64788.2025.11344009},
 issn = {},
 keyword = {Deep learning;Sentiment analysis;Accuracy;Fuses;Explainable AI;Semantics;Contrastive learning;Syntactics;Information retrieval;Machine translation;Word Sense Disambiguation;Self-Supervised Learning;Multiview Contrastive Learning;NLP;Deep Learning},
 month = {Sep.},
 number = {},
 pages = {1-5},
 title = {Self-Supervised Multiview Contrastive Learning for Enhanced Contextual Word Sense Disambiguation in Natural English Text},
 volume = {},
 year = {2025}
}
