@conference{Barber2017,
 abstract = {The rising popularity of large-scale real-time analytics applications (real-time inventory/pricing, mobile apps that give you suggestions, fraud detection, risk analysis, etc.) emphasize the need for distributed data management systems that can handle fast transactions and analytics concurrently. Efficient processing of transactional and analytical requests, however, require different optimizations and architectural decisions in a system. This paper presents the Wildfire system, which targets Hybrid Transactional and Analytical Processing (HTAP). Wildfire leverages the Spark ecosystem to enable large-scale data processing with different types of complex analytical requests, and columnar data processing to enable fast transactions and analytics concurrently. © 2017 Conference on Innovative Data Systems Research (CIDR). All rights reserved.},
 author = {Barber, Ronald and Garcia-Arellano, Christian and Grosman, Ronen and Mueller, Rene and Raman, Vijayshankar and Sidle, Richard and Spilchen, Matt and Storm, Adam and Tian, Yuanyuan and Tözün, Pınar and Zilio, Daniel and Huras, Matt and Lohman, Guy and Mohan, C. and Özcan, Fatma and Pirahesh, Hamid},
 journal = {CIDR 2017 - 8th Biennial Conference on Innovative Data Systems Research},
 note = {Cited by: 22},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Evolving databases for new-gen big data applications},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85084015101?origin=resultslist},
 year = {2017}
}
