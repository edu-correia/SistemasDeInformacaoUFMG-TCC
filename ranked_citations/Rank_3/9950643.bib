@inproceedings{9950643,
 abstract = {This work investigates a packaging solution for high power density semiconductors (> 200W /cm2), allowing for a dramatic reduction in size and complexity of power electronics modules. The multiple layers in standard packaging structures degrade the cooling efficiency due as they lengthen the path between dies and heatsinks. Here, we reduce the layer count by merging the ceramic substrate and the heat exchanger in a single part. CFD simulations and experimental validation are performed on a single-chip cooling packaging, and demonstrate a 10–20 % reduction in thermal resistance over more traditional cooling solutions.},
 author = {Al-Hinaai, Amin Salim Obaid and Huesgen, Till and Buttay, Cyril and Zeitler, Richard and Meyer, Daniela},
 booktitle = {2022 28th International Workshop on Thermal Investigations of ICs and Systems (THERMINIC)},
 doi = {10.1109/THERMINIC57263.2022.9950643},
 issn = {2474-1523},
 keyword = {Power system measurements;Density measurement;Thermal resistance;Merging;Packaging;Electronic packaging thermal management;Power electronics;Insulation;packaging;computational fluid dynamics (CFD);Cooling;power electronics;high power density},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {A novel integrated cooling packaging for high power density semiconductors},
 volume = {},
 year = {2022}
}
