@inproceedings{6227954,
 abstract = {Assessing risk associated to structured financial products requires processing information about diverse risk factors. Some information comes from the different sources directly in aggregated form, so that it is not possible to estimate the correlation among different risk components. In this paper we argue that Secure Multiparty Computation could be used to merge the information from the different sources so as to compute more accurately the overall risk profile of securitized assets, thanks to the use of reliable information from the individual sources, but without disclosing the information from each source. Our simple model for securitization can solve in many cases information asymmetries between lenders and borrowers.},
 author = {Cimato, Stelvio and Damiani, Ernesto and Gianini, Gabriele},
 booktitle = {2012 6th IEEE International Conference on Digital Ecosystems and Technologies (DEST)},
 doi = {10.1109/DEST.2012.6227954},
 issn = {2150-4946},
 keyword = {Protocols;Correlation;Encryption;Risk management;Computational modeling},
 month = {June},
 number = {},
 pages = {1-5},
 title = {Risk assessment of credit securities: The notion and the issues},
 volume = {},
 year = {2012}
}
