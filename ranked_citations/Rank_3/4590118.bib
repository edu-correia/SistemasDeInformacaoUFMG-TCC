@inproceedings{4590118,
 abstract = {In this paper, we proposed a multi-view video coding scheme based on the panorama. Panorama is a comprehensive image including information of the whole scene. It is synthesized by reserving the common information among different views and also holding the unique of each view. Therefore, it is highly related with the frame of each view. Our coding scheme selects it as the reference frame for the frame of each view at the corresponding moment, and can achieve good compression performance and prompt random access performance. Because the panorama concentrates the most efficient information in a relatively small size, the compression performance of our scheme is much better than that of the group-of-GOP coding scheme. Compared to the simulcast solution, our scheme can achieve flexible free-viewpoint switch function. Experiment results show that our scheme is an excellent tradeoff between the compression performance and the random access performance.},
 author = {Wei Li and Guiguang Ding},
 booktitle = {2008 International Conference on Audio, Language and Image Processing},
 doi = {10.1109/ICALIP.2008.4590118},
 issn = {},
 keyword = {Switches;Video coding;Encoding;Merging;Delay;Redundancy;Decoding},
 month = {July},
 number = {},
 pages = {375-379},
 title = {Panorama-based multi-view video coding},
 volume = {},
 year = {2008}
}
