@inproceedings{4341909,
 abstract = {In this paper the FP6 Future and Emerging Technologies project ACORNS is introduced. This project aims at simulating embodied language learning, inspired by the memory-prediction theory of intelligence. ACORNS intends to build a full computational implementation of sensory information processing. ACORNS considers linguistic units as emergent patterns. Thus, the research will not only address the issues conventionally investigated in statistical pattern recognition, but also the representations that are formed in memory. The paper discusses details of the memory and processing architecture that will be implemented in ACORNS, and explains how this architecture merges the basic concepts of the Memory-Prediction theory with results form previous research in the field of memory.},
 author = {Boves, Lou and ten Bosch, Louis and Moore, Roger},
 booktitle = {6th IEEE International Conference on Cognitive Informatics},
 doi = {10.1109/COGINF.2007.4341909},
 issn = {},
 keyword = {Computational modeling;Automatic speech recognition;Pattern recognition;Speech recognition;Humans;Speech processing;Natural languages;Memory architecture;Machine learning;Training data},
 month = {Aug},
 number = {},
 pages = {349-356},
 title = {ACORNS - towards computational modeling of communication and recognition skills},
 volume = {},
 year = {2007}
}
