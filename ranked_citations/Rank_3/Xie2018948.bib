@conference{Xie2018948,
 abstract = {Kettle is a powerful ETL tool for data integration. We implement kettle in the data integration and sharing of the basic database. The key issues of ETL implementation include multi-data source data consolidation and data incremental update. We put forward the 'merge join' and 'database join' solutions for multi-data source data consolidation and the 'timestamps', 'triggers', 'Database log data' and 'Data comparison' solution for data incremental update issue. © 2018 IEEE.},
 author = {Xie, Suping and Huaichu, Chen and Wuyue, Cai and Zhen, Wang},
 doi = {10.1109/ITME.2018.00211},
 journal = {Proceedings - 9th International Conference on Information Technology in Medicine and Education, ITME 2018},
 note = {Cited by: 5},
