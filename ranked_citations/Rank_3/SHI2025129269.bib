@article{SHI2025129269,
 abstract = {Multimodal machine translation refers to the task of using information from images, videos, etc., to assist in text translation. Numerous studies have demonstrated that incorporating visual representations as additional encoded information can enhance the dependency relations of contextual sequential vectors in autoregressive translation tasks. However, such methods typically only simulate the consistency between visual annotations and the source language, the contextual consistency among the source language, target language and visuals was not given enough attention. To fully utilize the consistent information, this paper introduces a novel multimodal neural machine translation approach. The encoder and decoder are integrated with visual features to ensure visual–textual consistency during the translation process. In the encoder, a cross-modal association mechanism utilizing graph neural networks is designed to effectively adapt textual and visual information. In the decoder, a structured multimodal graph is developed, directly mapping and merging visual and textual information. Experimental results indicate that, compared to the baseline, the method proposed in this paper significantly enhances the translation performance for English-German and English-French language pairs. Moreover, ablation experiments further validate the efficacy of this approach in improving translation quality.},
 author = {Xiayang Shi and Xiaona Yang and Pei Cheng and Yingjie Zhou and Jingjing Liu},
 doi = {https://doi.org/10.1016/j.neucom.2024.129269},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {Multimodal, Consistency, Machine translation},
 pages = {129269},
 title = {Enhancing multimodal translation: Achieving consistency among visual information, source language and target language},
 url = {https://www.sciencedirect.com/science/article/pii/S092523122402040X},
 volume = {620},
 year = {2025}
}
