@article{Han2024176,
 abstract = {In the process of digital transformation of education, blended learning is an important approach to promote the deepening of curriculum and teaching reform in basic education. However, K12 blended learning has developed more slowly than higher education. In the past 10 years, the informatization of education has shifted from “Internet+” to “Education+”. It's necessary to clarify the development pattern of K12 blended learning in this era and build a resilient blended learning ecology. In this study, 362 articles on K12 blended learning (2012–2022) were analyzed on the platform of the China Knowledge Network. Findings show that K12 blended learning went through three periods of development: inception, integration and application, and integration and innovation. The learning goals of blended learning have progressively returned to the essence of teaching, the boundaries between subject areas have been dissolved, the flexibility of the organization of teaching components (e.g., environments, resources, activities) has been enhanced, and the issues of core competencies, assessment of teaching and learning, big data, and artificial intelligence have become increasingly important in the future. In conclusion, this study analyses the ecological development of K12 blended learning from the macro, meso, and micro perspectives. It suggests that emphasis should be placed on optimizing the external environment, deepening synergistic connectivity, and strengthening the vitality of transformation to support the digital transformation of education for high-quality development. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2024.},
 author = {Han, Mengying and Li, Yushun and Hong, Jon-Chao},
 doi = {10.1007/978-981-97-4442-8_13},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {176 - 187},
 publication_stage = {Final},
 source = {Scopus},
 title = {K12 Blended Learning in China of “Education+” Era: From the Perspective of Ecology},
 type = {Conference paper},
