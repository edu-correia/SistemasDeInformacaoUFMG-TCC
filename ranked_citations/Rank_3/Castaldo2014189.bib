@article{Castaldo2014189,
 abstract = {Data coming from cameras deployed along an harbour coastline are fused to extract the state of unknown vessels framed by the sensors. We embed the ship dynamic model into a Factor Graph that through probability propagation provides a very flexible merge of sensory data and inferences. Preliminary results and experiments from videos gathered in the Gulf of Naples are reported with a discussion on future trends. © Springer International Publishing Switzerland 2014.},
 author = {Castaldo, Francesco and Palmieri, Francesco A.N.},
 doi = {10.1007/978-3-319-04129-2_19},
 journal = {Smart Innovation, Systems and Technologies},
 note = {Cited by: 3},
 pages = {189 - 196},
 publication_stage = {Final},
 source = {Scopus},
 title = {Data fusion using a Factor Graph for ship tracking in harbour scenarios},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84897866803?origin=resultslist},
 volume = {26},
 year = {2014}
}
