@article{Pugmire2021157,
 abstract = {One of the primary challenges facing scientists is extracting understanding from the large amounts of data produced by simulations, experiments, and observational facilities. The use of data across the entire lifetime ranging from real-time to post-hoc analysis is complex and varied, typically requiring a collaborative effort across multiple teams of scientists. Over time, three sets of tools have emerged: One set for analysis, another for visualization, and a final set for orchestrating the tasks. This trifurcated tool set often results in the manual assembly of analysis and visualization workflows, which are one-off solutions that are often fragile and difficult to generalize. To address these challenges, we propose a serviced-based paradigm and a set of abstractions to guide its design. These abstractions allow for the creation of services that can access and interpret data, and enable interoperability for intelligent scheduling of workflow systems. This work results from a codesign process over analysis, visualization, and workflow tools to provide the flexibility required for production use. Finally, this paper describes a forward-looking research and development plan that centers on the concept of visualization and analysis technology as reusable services, and also describes several realworld use cases that implement these concepts. © Springer Nature Switzerland AG 2020.},
 author = {Pugmire, David and Kress, James and Chen, Jieyang and Childs, Hank and Choi, Jong and Ganyushin, Dmitry and Geveci, Berk and Kim, Mark and Klasky, Scott and Liang, Xin and Logan, Jeremy and Marsaglia, Nicole and Mehta, Kshitij and Podhorszki, Norbert and Ross, Caitlin and Suchyta, Eric and Thompson, Nick and Walton, Steven and Wan, Lipeng and Wolf, Matthew},
 doi = {10.1007/978-3-030-63393-6_11},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 52; All Open Access; Green Open Access},
 pages = {157 - 174},
 publication_stage = {Final},
 source = {Scopus},
 title = {Visualization as a service for scientific data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85107287979?origin=resultslist},
 volume = {1315 CCIS},
 year = {2021}
}
