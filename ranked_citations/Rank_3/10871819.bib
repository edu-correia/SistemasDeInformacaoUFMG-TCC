@inproceedings{10871819,
 abstract = {Spatial-temporal data fusion technology enhances image quality by merging Spatio-Temporal data of different resolutions. In the radar field,improving distance resolution often comes at the cost of reducing velocity resolution,and vice versa,making it difficult to simultaneously obtain high spatial accuracy and high temporal density data. To address this issue,this paper introduces spatio-temporal fusion technology from the satellite domain for radar data analysis,integrating multiple radar datasets to optimize low-precision data with high-precision data,thereby generating high-quality radar data with high Spatio-Temporal resolution. This method significantly enhances the resolution and application value of radar data in monitoring and analysis.},
 author = {Jun, Hu and Yahui, Hu and Xiao, Tang and Lei, Liu and Yamin, Hu and Shujun, Lv},
 booktitle = {2024 International Conference on Intelligent Computing and Next Generation Networks (ICNGN)},
 doi = {10.1109/ICNGN63705.2024.10871819},
 issn = {},
 keyword = {Image quality;Satellites;Spaceborne radar;Merging;Data integration;Radar;Radar imaging;Spatial resolution;Next generation networking;Monitoring;Spatial-Temporal;radar;data-fusion},
 month = {Nov},
 number = {},
 pages = {1-5},
 title = {Research on Radar Spatial-Temporal Data Fusion},
 volume = {},
 year = {2024}
