@article{ZENG2025170877,
 abstract = {Surface-enhanced Raman scattering (SERS) has long been constrained by the dilemma between sensitivity and reproducibility that stems from weak chemical enhancement and heterogeneous electromagnetic “hot spots”. Here, we engineered a photoinduced charge transfer (PICT) ratiometric SERS platform that synergizes plasmonic amplification with built-in self-calibration. The architecture consists of silver core/Prussian blue shell‑silver satellite nanoparticles (Ag@PB-Ag NPs) in which ultrasmall Ag satellites (∼4 nm) are in-situ etched onto a 5 nm PB shell that uniformly coats a 50 nm Ag core. This tri-component geometry creates both the dense electromagnetic hot zones and a semiconductor-mediated charge transfer highway. Density functional theory (DFT) reveals two favorable cascade pathways: Ag Fermi level (−4.84 eV) → patulin LUMO (−2.46 eV) and Ag Fermi level (−4.84 eV) → PB conduction band (−4.13 eV) → patulin LUMO (−2.46 eV), endowing substrate with an effective PICT enhancement factor of 9.01 × 105. The cyanide stretching band of PB at 2142 cm−1, located in the biological Raman-silent window, acts as an internal standard, suppressing spot-to-spot signal deviation from 16.57 % to 5.76 %. Under optimized conditions, the platform delivers a linear response from 1 nM to 100 μM and a limit of detection (LOD) of 0.64 nM for patulin. Validation in mold-contaminated fruits (Citrus reticulata Blanco, Malus pumila Mill., Carica papaya L.) yielded recoveries of 92.26–113.67 %, showing excellent agreement with HPLC (coincidences 80.21–101.04 %). The strategy proves that rational structure design merge plasmonic, semiconductor chemistry, and chemometrics can achieve nanomolar quantification of biotoxins, providing a blueprint for next-generation SERS sensing of hazards.},
 author = {Wei Zeng and Xuemei Tang and Jiyang Li and Yiping Chen and Long Wu},
 doi = {https://doi.org/10.1016/j.cej.2025.170877},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Surface-enhanced Raman scattering, Ratiometric detection, Food-borne toxins, Noble metal-semiconductor, Photoinduced charge transfer},
 pages = {170877},
 title = {Self-calibrating metal-semiconductor heterostructures with photoinduced charge transfer for robust SERS detection of patulin},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894725117221},
 volume = {526},
 year = {2025}
}
