@inproceedings{8534108,
 abstract = {While conventional graded-pattern metasurfaces are unable to provide real-time control over the wave-front of scattered light, careful selection of a state-of-art tunable component like an electro-optical material (EOM) hybridized with a unique physical paradigm can lead to enhancement of light-matter interaction and dynamical control over beam manipulation. Several advanced tunable designs for one- and two-dimensional beam control are proposed based on gate-tunable biasing and integration of EOMs into plasmonic nanostructures which offer large phase modulation with concurrence of Fabry-Pérot type resonance and zero-crossing of the permittivity of indium tin oxide (ITO) active layer. The low reflection efficiency in plasmonic-based designs is improved by employing the all-dielectric nanostructured metasurfaces and electrically merging the excited electric and magnetic resonances (Mie-type dipolar modes). Finally, adding time modulation to the predesigned optical platforms hold the promise to overcome fundamental limits like narrow bandwidth of operation, lack of full phase pick-up, and fabrication sensitivity.},
 author = {Forouzmand, A. and Salary, M. M. and Mosallaei, H.},
 booktitle = {2018 12th International Congress on Artificial Materials for Novel Wave Phenomena (Metamaterials)},
 doi = {10.1109/MetaMaterials.2018.8534108},
 issn = {},
 keyword = {Indium tin oxide;Plasmons;Frequency modulation;Phase modulation;Reflection;Adaptive optics;Optical device fabrication},
 month = {Aug},
 number = {},
 pages = {134-136},
 title = {Electrically Tunable Metasurfaces},
 volume = {},
 year = {2018}
}
