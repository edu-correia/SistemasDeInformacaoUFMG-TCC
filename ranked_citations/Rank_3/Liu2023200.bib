@conference{Liu2023200,
 abstract = {As China's overall national strength is increasing, the security of bridges is becoming increasingly important. In addition, the dynamic load of the bridge is rising with the increase of vehicle tonnage and traffic flow. Nowadays, the evaluation of bridge dynamics is complex to solve by traditional means, so a bridge detection model of the dynamic load test based on sensor technology is established. The merge search algorithm is used to calculate and analyze. This kind of testing model can meet the requirements of domestic bridge testing. Through the test of a dynamic load test in the bridge detection model, the calculation results are promising.  © 2023 IEEE.},
 author = {Liu, Chen and Zhu, Heya},
 doi = {10.1109/DDP60485.2023.00046},
 journal = {Proceedings - 2023 3rd International Conference on Digital Data Processing, DDP 2023},
 note = {Cited by: 0},
 pages = {200 - 204},
 publication_stage = {Final},
 source = {Scopus},
 title = {Application Research of Dynamic Load Test Based on Sensor Technology in Bridge Detection and Evaluation},
 type = {Conference paper},
