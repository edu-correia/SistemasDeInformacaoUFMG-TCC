@inproceedings{9936479,
 abstract = {Development and information security testing of the hybrid English interactive APP based on mobile Internet communication network is studied in the paper. Multimodal teaching mainly emphasizes various interactions between learners' various senses and the external learning environment, that is, the use of multiple media and teaching methods in teaching to mobilize learners' multiple senses to work together. For achieving this goal, the technology should be integrated. Through the version control, the problem of the code submission and merging of different members is solved, and members are required to pull the latest code from the code base and merge with the local code every day, and then carry out development work. For the further optimization, the designed model is then integrated with the efficient APP structure.},
 author = {Yan, Hong},
 booktitle = {2022 International Conference on Edge Computing and Applications (ICECAA)},
 doi = {10.1109/ICECAA55415.2022.9936479},
 issn = {},
 keyword = {Codes;Education;Merging;Information security;Media;Internet;Communication networks;Internet communication;network system;information security testing;hybrid English system;interactive APP},
 month = {Oct},
