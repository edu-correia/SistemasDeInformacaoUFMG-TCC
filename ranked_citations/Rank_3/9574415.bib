@inproceedings{9574415,
 abstract = {This paper mainly expounds the design method of realizing Rule-based correlation through Rule-based correlation engine in multimedia network. In multimedia network, it is not only necessary to match a series of steps or several key steps of an attack event, but also to combine multiple events of an attack on different hosts. Therefore, the Rule-based correlation engine is required to detect attacks more accurately and reduce false positives. In the Rule-based correlation engine, in order to flexibly describe the requirements of various attack scenarios, a variety of structures can be used to complete the calculation process, including: order, branch, branch selection, merge, loop and composition structure. This paper focuses on the idea and operation process of building composite structure, and introduces the rules and examples of rules in composite structure in detail.},
 author = {Ao, Lei},
 booktitle = {2021 IEEE International Conference on Advances in Electrical Engineering and Computer Applications (AEECA)},
 doi = {10.1109/AEECA52519.2021.9574415},
 issn = {},
 keyword = {Electrical engineering;Correlation;Data acquisition;Merging;Standardization;Multimedia databases;Maintenance engineering;Network operation and maintenance;Rule-based correlation;Vulnerability Correlation Engine;Rule;RuleInstance},
 month = {Aug},
 number = {},
 pages = {944-949},
 title = {Delve Deeper of Rule Based Correlation in Multimedia Network},
 volume = {},
 year = {2021}
}
