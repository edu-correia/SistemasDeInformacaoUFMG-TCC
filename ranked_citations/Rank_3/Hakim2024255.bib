@conference{Hakim2024255,
 abstract = {A new approach and architecture have been presented in this paper to efficiently merge the decimal rounding stage according to the IEEE 754-2008 standard based on the compound adder. This integration serves as a crucial key to improve the computation performance of both decimal floating point multiplication and fused multiply add (FMA) operation. The decimal rounding control unit is based on the IEEE 754-2008 five rounding modes. The decimal combined add/round module has been coded in the VHDL and verified using the Xilinx ISE 13.2. The overall critical path delay is compared with another design based on the BCD adder with the decimal rounding. The results have shown at least 3.4 % improvement in terms of delay reduction. © 2024 IEEE.},
 author = {Hakim, Heba and Jaber, Hanadi A. and Alhakeem, Zaineb M.},
 doi = {10.1109/MCSoC64144.2024.00050},
 journal = {Proceedings - 2024 IEEE 17th International Symposium on Embedded Multicore/Many-core Systems-on-Chip, MCSoC 2024},
 note = {Cited by: 0},
 pages = {255 - 260},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improved Decimal Rounding Module based on Compound Adder},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85217088993?origin=resultslist},
 year = {2024}
}
