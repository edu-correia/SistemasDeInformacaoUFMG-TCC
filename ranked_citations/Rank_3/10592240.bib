@inproceedings{10592240,
 abstract = {At present, the research on Cache SCA (side channel attack) pays more attention to the realization of attacks and the defense field, while the research on Cache SCA detection field has just been paid attention to in recent years, with relatively few research results and imperfect detection scheme. In this paper, a detection method of virtual machine Cache SCA based on MINE algorithm is proposed. Firstly, information is collected, and then the collected files are extracted according to the defined event format, cleaned and standardized, and then structured event metadata is formed, so that the characteristics of these hidden channels can be highlighted for processing. Then merge the events, and merge the events that meet certain conditions into an event stream from a large number of events. The research results show that the method in this paper can clearly distinguish between attack programs and benign programs, and the response time of attack detection methods to different Cache SCA programs is slightly different, and the attack programs can be responded and processed within 1 second at the earliest. Experiments show that the detection method has a high detection rate, and does not occupy too much system resources during operation, and can respond and handle Cache SCA quickly without degrading the performance of the operating system.},
 author = {Shen, Wuqiang and Cui, Lei and Shen, Guiquan and Zhang, Xiaolu},
 booktitle = {2023 International Conference on Telecommunications, Electronics and Informatics (ICTEI)},
 doi = {10.1109/ICTEI60496.2023.00070},
 issn = {},
 keyword = {Operating systems;Linux;Side-channel attacks;Metadata;Virtual machining;Telecommunications;Time factors;MINE;virtual machine;Cache;side channel attack;attack detection},
 month = {Sep.},
 number = {},
 pages = {688-692},
 title = {Design of virtual machine Cache side channel attack detection method based on MINE algorithm},
 volume = {},
 year = {2023}
}
