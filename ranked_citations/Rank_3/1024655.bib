@inproceedings{1024655,
 abstract = {Nowadays it is commonly accepted that the web is structured in a chaotic way. Due to the fact that it grows exponentially, it is a difficult task to efficiently locate specific information. This paper presents a User-defined Meta-Search Engine (UMSE), adaptable to user preferences. UMSE utilises tip to 9 known search engines according to a user-defined ranking, submits its queries in parallel and finally presents the merging results back to the user. The anticipated outcome of using UMSE is that the user gets enhanced amount of information, recording in parallel his search preferences. UMSE also supports history features in order to personalise user queries and facilitate information retrieval.},
 author = {Anagnostopoulos, I. and Psoroulas, I. and Loumos, V. and Kayafas, E.},
 booktitle = {ITI 2002. Proceedings of the 24th International Conference on Information Technology Interfaces (IEEE Cat. No.02EX534)},
 doi = {10.1109/ITI.2002.1024655},
 issn = {1330-1012},
 keyword = {Metasearch;Search engines;Merging;Web pages;Database languages;Computer interfaces;Chaos;History;Information retrieval;Delay},
 month = {June},
 number = {},
 pages = {79-84 vol.1},
 title = {Implementing a customised meta-search interface for user query personalisation},
 volume = {},
 year = {2002}
}
