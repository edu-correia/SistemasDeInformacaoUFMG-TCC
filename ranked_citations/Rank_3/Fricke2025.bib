@conference{Fricke2025,
 abstract = {This paper presents a comprehensive design strategy to unlock the full potential of Point-Merge-Systems (PMS) as aircraft approach sequencing and merging concept. As various existing PMS implementations suffer deficits in either capacity or operational efficiency, we propose a multi-objective optimization model, linked to a Monte-Carlo Agent Based simulation for verification and a noise computation module to include all external effects into the design. We show that the concept delivers promising performance improvements over historic approach procedure designs - covering both PMS and trombone - for a preliminary use case application at Leipzig/Halle Airport (EDDP), Germany. We propose to couple the design concept with a pre-sequencing component focusing on robust continuous descent operations, using optimal control. © 2025 ATM. All Rights Reserved.},
 author = {Fricke, Hartmut and Lindner, Martin and Thiel, Christoph and Vogel, Markus},
 journal = {16th USA-Europe Seminar on Air Traffic Management Research and Development, ATM 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Chances and Pitfalls of the Point Merge Concept – A design Optimization Framework with a Case Study for Leipzig/Halle Airport on Noise, Capacity and Flight Efficiency},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105031886474?origin=resultslist},
 year = {2025}
}
