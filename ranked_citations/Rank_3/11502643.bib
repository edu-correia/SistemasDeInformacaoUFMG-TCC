@inproceedings{11502643,
 abstract = {Traditional algorithmic trading systems relying solely on technical indicators inadequately capture sentimentdriven market forces that significantly influence stock price movements. This research presents a novel hybrid intelligent trading framework merging FinBERT-powered financial sentiment assessment with deep reinforcement learning techniques for autonomous trading execution. The platform processes realtime financial news streams and social media discourse alongside technical market signals to generate optimal trading actions. Principal contributions encompass: (1) Multi-modal data integration combining technical metrics with sentiment analysis for comprehensive market understanding, (2) Adaptive learning through deep reinforcement learning responding to shifting market conditions, (3) Superior risk mitigation featuring reduced drawdowns and enhanced capital preservation, (4) Real-time sentiment processing enabling rapid response to market-moving news, and (5) Rigorous performance verification via extensive backtesting with realistic market data incorporating transaction costs and microstructure considerations.},
 author = {Surya, Yug and K, Suresh and T, Cynthia},
 booktitle = {2026 7th International Conference on Computational Intelligence and Networks (CINE)},
 doi = {10.1109/CINE68769.2026.11502643},
 issn = {},
 keyword = {Filtering;Filters;Feedback;Circuits;Circuits and systems;Protocols;HTTP;Internet;High frequency;Instant messaging;Algorithmic Trading;Financial Sentiment Analysis;Deep Reinforcement Learning;FinBERT;Multi-Modal Learning;Risk Management;Quantitative Finance},
 month = {March},
 number = {},
 pages = {1-6},
 title = {Intelligent Trading Systems: Integrating Finbert Sentiment Analysis with Deep Reinforcement Learning for Enhanced Stock Market Performance},
 volume = {},
 year = {2026}
}
