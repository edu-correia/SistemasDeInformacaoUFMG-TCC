@article{DIMARINO2026106728,
 abstract = {In the context of the circular economy (CE), promoting sharing practices – within the contexts of mobility, spaces and services – is essential for extending resource use and fostering sustainability in urban environments. However, the ability of urban neighborhoods to effectively integrate shared mobility, spaces and services remains largely unexplored. This study introduces the conceptual framework of resharing, which merges these elements into a cohesive urban strategy. In developing a comprehensive framework, this paper explores the benefits of resharing and examines recent shifts in urban neighborhoods, particularly multifunctional ground floors. The study also analyzes the spatial and contextual conditions that enable or constrain resharing practices in neighborhoods and buildings. A mixed methods approach was used in the study, consisting of spatial observations in Løren – a neighborhood in northeastern Oslo (Norway), a review of planning and building regulations, and the development of a dashboard tool that is designed to measure and visualize reshareability in the built environment. By offering practical insights and analytical tools, this research aims to assist urban planners and policymakers in refining neighborhood planning strategies, thereby ultimately promoting more interconnected, livable and sustainable urban communities.},
 author = {Mina {Di Marino} and Tanu Priya Uteng and Seyed Hossein Chavoshi and Anja Standal},
 doi = {https://doi.org/10.1016/j.cities.2025.106728},
 issn = {0264-2751},
 journal = {Cities},
 keyword = {Shared mobility, Shared space, Circularity, Neighborhood, Spatial observations, Dashboard},
 pages = {106728},
 title = {Resharing the city: A framework for circular urban neighborhoods the case of Oslo},
 url = {https://www.sciencedirect.com/science/article/pii/S0264275125010315},
 volume = {171},
 year = {2026}
}
