@inproceedings{5236405,
 abstract = {With the widespread application of digital library, the problems it causes have become more obvious, such as difficulties in locating information, lack of interoperability in heterogeneous system, lack of the operating mechanism and network copyright of massively distributed data. Service-oriented grid architecture can be merged into Dl system to solve these problems. Talking from the whole framework of application system in DL grid, we mainly discuss the composing framework of service management in DL grid and analyze the flow and structure of service management in DL grid's application system and describe the function and the key point in service description, service publication and discovery. In the end, we also analyze the influence of service management brought to users in digital libraries and the change in the process of information management and sharing flow.},
 author = {Ziran, Zhang and Haozhe, Chen and Ying, Jiang},
 booktitle = {2009 IEEE International Symposium on IT in Medicine & Education},
 doi = {10.1109/ITIME.2009.5236405},
 issn = {},
 keyword = {Software libraries;Resource management;Web services;Information management;Intserv networks;Encapsulation;Open systems;Middleware;Environmental management;Information analysis},
 month = {Aug},
 number = {},
 pages = {321-325},
 title = {On the framework of grid service management in digital library},
 volume = {1},
 year = {2009}
}
