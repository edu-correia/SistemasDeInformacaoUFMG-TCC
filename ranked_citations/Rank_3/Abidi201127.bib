@article{Abidi201127,
 abstract = {Handling comorbid diseases in a decision support framework is a challenging problem as it demands the synthesis of clinical procedures for two or more diseases whilst maintaining clinical pragmatics. In this paper we present a knowledge management approach for handling comorbid diseases by the systematic alignment of the Clinical Pathways (CP) of comorbid diseases. Our approach entails: (a) knowledge synthesis to derive disease-specific CP from evidence-bases sources; (b) knowledge modeling to abstract medical and procedural knowledge from the CP; (c) knowledge representation to computerize the CP in terms of a CP ontology; and (d) knowledge alignment by aligning multiple CP to develop a unified CP knowledge model for comorbid diseases. We present the COMET system that provides decision support to handle comorbid cardiac heart failure and atrial fibrillation. © 2011 Springer-Verlag.},
 author = {Abidi, Samina Raza},
 doi = {10.1007/978-3-642-18050-7_3},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 13},
 pages = {27 - 39},
 publication_stage = {Final},
 source = {Scopus},
 title = {Ontology-based knowledge modeling to provide decision support for comorbid diseases},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/79952016090?origin=resultslist},
 volume = {6512 LNAI},
 year = {2011}
}
