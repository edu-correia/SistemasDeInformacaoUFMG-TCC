@article{Norguet2006430,
 abstract = {With the emergence of the World Wide Web, Web sites have become a key communication channel for organizations. In this context, analyzing and improving Web communication is essential to better satisfy the objectives of the target audience. Web communication analysis is traditionnally performed by Web analytics software, which produce long lists of audience metrics. These metrics contain little semantics and are too detailed to be exploited by organization managers and chief editors, who need summarized and conceptual information to take decisions. Our solution to obtain such conceptual metrics is to analyze the content of the Web pages output by the Web server. In this paper, we first present a list of methods that we conceived to mine the output Web pages. Then, we explain how term weights in these pages can be used as audience metrics, and how they can be aggregated using OLAP tools to obtain concept-based metrics. Finally, we present the concept-based metrics that we obtained with our prototype WASA and SQL Server OLAP tools. © Springer-Verlag Berlin Heidelberg 2006.},
 author = {Norguet, Jean-Pierre and Zimányi, Esteban and Steinberger, Ralf},
 doi = {10.1007/11611257_41},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 10},
 pages = {430 - 439},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improving Web sites with Web usage mining, Web content mining, and semantic analysis},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33745642081?origin=resultslist},
 volume = {3831 LNCS},
 year = {2006}
}
