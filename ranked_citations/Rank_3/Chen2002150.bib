@conference{Chen2002150,
 abstract = {In this paper a proposal for the Biology Petri Net Markup Language (BioPNML) is presented. The concepts and terminology of the interchange format as well as its syntax that is based on XML (eXtensible Markup Language) are introduced. BioPNML is designed to provide a starting point for the development of a standard interchange format for Bioinformatics and Petri nets. The language will make it possible to present biology Petri net diagrams between all supported hardware platforms and versions. It is also designed to bridge Petri net models to other known metabolic simulators. © 2002 Gesellschaft fur Informatik (GI). All rights reserved.},
 author = {Chen, Ming and Freier, Andreas and Köhler, Jacob and Rüegg, Alexander},
 journal = {Lecture Notes in Informatics (LNI), Proceedings - Series of the Gesellschaft fur Informatik (GI)},
 note = {Cited by: 9},
 pages = {150 - 161},
 publication_stage = {Final},
 source = {Scopus},
 title = {The Biology Petri Net Markup Language},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85134575760?origin=resultslist},
 volume = {P-21},
 year = {2002}
