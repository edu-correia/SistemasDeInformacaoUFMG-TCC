@inproceedings{4241373,
 abstract = {3D integrate model of roadbed and terrain is used to build railway 3D scene. The 3D roadbed is constructed with a method called transect-based model. This model is based on the roadbed transect which linked the same character points on border upon transects and make the triangle partition to generate roadbed. How to calculate transect character points based on the roadbed center line and DEM is discussed. Terrain model is TIN (triangular irregular network) model. To integrate these two models seamlessly, a method based on CDT( constrained delaunay triangulation) is used. It deletes the points within outline of roadbed from terrain vertex set and triangles affected by roadbed from triangle set firstly. Then it constructed roadbed model using roadbed vertex set. Finally, merges roadbed and terrain model in a whole. A method of building a railway roadbed and terrain integration model has been presented. It can be applied as an assistant tool for engineering design of railway and science research.},
 author = {Shang, Q. and Guo, J. and Xu, J.},
 booktitle = {2006 IEEE International Symposium on Geoscience and Remote Sensing},
 doi = {10.1109/IGARSS.2006.226},
 issn = {2153-7003},
 keyword = {Rail transportation;Railway engineering;Tin;Roads;Layout;Design engineering;Character generation;Buildings;Educational institutions;Design automation},
 month = {July},
 number = {},
 pages = {880-883},
 title = {Study on Constructing Roadbed and Terrain Integration Model},
 volume = {},
 year = {2006}
}
