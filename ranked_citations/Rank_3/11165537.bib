@inproceedings{11165537,
 abstract = {Extended Reality (XR) merges physical and virtual environments to deliver immersive experiences, but olfactory stimulation in multi-sensory integration remains insufficiently explored. We propose a low-latency XR system combining Arduino-based olfactory displays with a VR headset, using YOLOv5 for real-time object-triggered odor feedback. Experiments with 45 participants demonstrate that olfactory stimulation significantly improves Quality of Experience (QoE), with a clear concentration threshold effect: QoE declines when the optimal level is exceeded. This work reveals the mechanism of visuolfactory integration in XR and provides empirical guidelines for future multisensory immersive design.},
 author = {Ding, Dongyang and Li, Guandong and Xie, Yanzhe and Lu, Yuhao and Liu, Zijian and Li, Yingzi and Xue, Longhao and Song, Wenrui and Bi, Ting},
 booktitle = {2025 IEEE International Symposium on Broadband Multimedia Systems and Broadcasting (BMSB)},
 doi = {10.1109/BMSB65076.2025.11165537},
 issn = {2155-5052},
 keyword = {YOLO;Visualization;Sensitivity;Extended reality;Olfactory;Virtual environments;User experience;Quality of experience;Synchronization;Reliability;Extended Reality;Multiple-Sensory Integration;Olfactory Display;Virtual Reality;QoE},
 month = {June},
 number = {},
 pages = {1-6},
 title = {Visual and Olfactory Integration in Multi-sensory Extended Reality},
 volume = {},
 year = {2025}
}
