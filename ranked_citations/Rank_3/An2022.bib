@article{An2022,
 abstract = {Community partition is a significant task in social network analysis. For some interest networks, the interest of nodes may influence the formation of community. Considering the cooperation relation among nodes, we propose a cooperative social network partition approach by using the technique of data envelopment analysis. In this approach, the interest relationship among decision making units (DMUs) is identified by measuring the increased revenue of two cooperative DMUs, and then, a weighted interest network is constructed correspondingly. In this interest network, each node would like to cooperate with others to gain more benefits. Regarding each node as a player, the formation of community can be achieved by a cooperative game. We employ Shapley value mechanism mainly including five algorithms, i.e., maximum Shapley value of each node, expand algorithm, check stability, update, and merge process, to achieve community partition. Finally, the proposed method is applied to mineral resource of 31 provinces in Chinese mainland. © 2022 Elsevier Ltd},
 author = {An, Qingxian and Wang, Ping and Zeng, Yongliang and Dai, Yi},
 doi = {10.1016/j.cie.2022.108658},
 journal = {Computers and Industrial Engineering},
 note = {Cited by: 11},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cooperative social network community partition: A data envelopment analysis approach},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85138138059?origin=resultslist},
 volume = {172},
 year = {2022}
}
