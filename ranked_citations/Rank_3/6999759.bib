@inproceedings{6999759,
 abstract = {In this paper, novel cavity-backed slot antennas based on substrate-integrated waveguide (SIW) for dual frequency and bandwidth enhancement are proposed. Their performance is numerically evaluated by means of the method of finite elements. Using metalized via holes at the middle of a SIW cavity, resonate frequency of TM010 mode is shifted up. With placing a slot at one side of the cavity, electromagnetic fields are radiated thorough the slot at two resonate frequencies of TM010 and TM110 modes. Proposed antenna operate at 9.68 GHz and 10.28 GHz with impedance bandwidths of 60 MHz and 80 MHz for S11<;-10 dB respectively and it provides gain of at least 4.6 dB. Moreover, by merging two modes, bandwidth of the structure would be improved. All antenna structures are made of a single-layer substrate and are fed by a 50 Ω microstrip line. The proposed antennas are compact, low-cost and present high radiation efficiency.},
 author = {Dashti, Hamideh and Neshati, Mohammad H.},
 booktitle = {2014 22nd Iranian Conference on Electrical Engineering (ICEE)},
 doi = {10.1109/IranianCEE.2014.6999759},
 issn = {2164-7054},
 keyword = {Cavity resonators;Slot antennas;Resonant frequency;Microwave antennas;Bandwidth;Microwave filters;Substrates;Slot Antenna;Dual Band Antenna;Circular SIW Cavity},
 month = {May},
 number = {},
 pages = {1438-1441},
 title = {New techniques to improve radiation characteristics of SIW cavity-backed slot antennas},
 volume = {},
 year = {2014}
}
