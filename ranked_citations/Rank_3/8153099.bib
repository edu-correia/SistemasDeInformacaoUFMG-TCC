@article{8153099,
 abstract = {V-ATPases are multisubunit, membrane-bound, energy-converting, cellular machines whose assembly and disassembly is innately connected to their activity in vivo. In vitro V-ATPases show a propensity for disassembly that greatly complicates their functional, and, in particular, structural characterization. Direct structural evidence for early stages of their disassembly has not been reported yet. We analyzed the structure of the V-ATPase from Thermus thermophilus in a single negatively stained two-dimensional (2-D) crystal both by electron tomography and by electron crystallography. Our analysis demonstrated that for 2-D crystals of fragile macromolecular complexes, which are too heterogenous or too few for the merging of image data from many crystals, single-crystal 3-D reconstructions by electron tomography and electron crystallography are expedient tools of analysis. The asymmetric unit in the 2-D crystal lattice contains two different V-ATPase complexes that appear to be in an early stage of disassembly and with either one or both peripheral stalks not being visualized, suggesting the involvement of the peripheral stalks in early stages of disassembly.},
 author = {Tani, Kazutoshi and Arthur, Christopher P. and Tamakoshi, Masatada and Yokoyama, Ken and Mitsuoka, Kaoru and Fujiyoshi, Yoshinori and Gerle, Christoph},
 doi = {10.1093/jmicro/dft020},
 issn = {1477-9986},
 journal = {Microscopy},
 keyword = {rotary ATPase;2D crystal;electron microscopy;tilt-series;labile protein complex;dissociation},
 month = {Aug},
 number = {4},
 pages = {467-474},
 title = {Visualization of two distinct states of disassembly in the bacterial V-ATPase from Thermus thermophilus},
 volume = {62},
 year = {2013}
}
