@inproceedings{8087247,
 abstract = {Laser-induced formation of surface nanostructures is known for a long time. Responsible mechanisms, however, aie not completely understood. Early explanations were based on surface electromagnetic waves [1]. Alternative models were focused on self-organization of non-equilibrium surfaces via nonlinear feedback and material transport [2]. Investigations on volume structures in fused silica and glass [3, 4] revealed a plasmon controlled rearrangement of nanobubbles as an interplay of non-thermal and thermal processes. For metals at high fluence, bubbles merge along temporally elastic stripes of maximum carrier density [5].},
 author = {Wehner, R. and Grunwald, R.},
 booktitle = {2017 Conference on Lasers and Electro-Optics Europe & European Quantum Electronics Conference (CLEO/Europe-EQEC)},
 doi = {10.1109/CLEOE-EQEC.2017.8087247},
 issn = {},
 keyword = {Plasmons;Optical surface waves;Diffraction;Gas lasers;Laser ablation;Surface waves;Surface treatment},
 month = {June},
 number = {},
 pages = {1-1},
 title = {Combined plasmonic and thermal mechanism of laser-induced nanostructure formation in silicon},
 volume = {},
 year = {2017}
}
