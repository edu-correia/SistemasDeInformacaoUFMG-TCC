@inproceedings{11377714,
 abstract = {The proposed research describes a multi-modal type deep learning system that amalgamates genomic based data along with clinical records to prognosticate cancer betterment. The traditional models may employ either genetic information or clinical features, and so, the resultant patient outcomes are often partially concentrated. Unlike this, the proposed system employes use of a hybrid deep type learning architecture that marries convolution neural infrastructure for related feature extraction from high-dimensional genomic data with recurrent and fully inter connected layers that are capable of handling sequential and categorical clinical type inputs. Subsequently, a modality fusion layer is utilized to represent the cross-modal interactions, which provides to confirm that minute genomic differences which are identified in patient history, demographical data-sets and clinical test results. The framework is made not only to improve the accuracy rate of predictions, but also to minimize the false prognostic classifications and to related patterns that single-source models fail to extract. The novelty of this approach is its potential to harness the advantages that genomic and clinical data have in common when supplemented by deep feature integration thus giving personalized prognosis, early health risk stratification and making treatment decisions that are more informed. As a result of the integration of the biological markers with the clinical evidence, the multi-modal deep learning based approach presented here is an excellent model of the foundation for precision oncology and is a step towards a cancer diagnosis system that is data-driven and more holistic.},
 author = {Shah, Dev A. and Shaikh, Ummehani H. and Jha, Shivansh and Panchal, Tirth and Verma, Shanti},
 booktitle = {2025 3rd DMIHER International Conference on Artificial Intelligence in Healthcare, Education and Industry (IDICAIHEI)},
 doi = {10.1109/IDICAIHEI65991.2025.11377714},
 issn = {},
 keyword = {Deep learning;Sensitivity;Accuracy;Genomics;Predictive models;Oncology;Robustness;Bioinformatics;Prognostics and health management;Cancer;multi-modal deep learning;genomic based data;clinical data;cancer type prognosis;feature integration;precision oncology information;health risk stratification;personalized health care;predictive type modeling;data fusion system},
 month = {Nov},
