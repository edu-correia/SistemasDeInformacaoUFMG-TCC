@article{GUL2025101981,
 abstract = {In this manuscript, we formulate charged anisotropic spherical solutions by applying extended gravitational decoupling approach in f(Q,T) theory, where Q defines the non-metricity and T is the trace of energy–momentum tensor. The anisotropy is induced through the addition of a new source coupled to perfect fluid through a decoupling parameter. In this approach, the temporal and radial potentials are transformed, dividing the field equations into two sets. The first set is solved using viable non-singular metric coefficients of Finch-Skea ansatz, while the second set includes unknowns that are determined through specific conditions. Anisotropic results are derived by merging the solutions obtained from both arrays. We investigate the effects of charge on various quantities to evaluate the physical validity of the solutions. Moreover, a comprehensive analysis of the viability and stability of each solution is conducted by sound speed method. It is found that the modified terms and charge indicate feasible as well as stable structures as compared to other gravitational theories like the energy–momentum squared gravity does not provide viable compact structures at the center.},
 author = {M. Zeeshan Gul and Fei Ni and M. Sharif and Sadia Zahid},
 doi = {https://doi.org/10.1016/j.dark.2025.101981},
 issn = {2212-6864},
 journal = {Physics of the Dark Universe},
 keyword = {Non-metric theory, Anisotropic solutions, Decoupling technique},
 pages = {101981},
 title = {Impact of charge on the viability and stability of the decoupled spherical structures in f(Q,T) gravity},
 url = {https://www.sciencedirect.com/science/article/pii/S2212686425001748},
 volume = {49},
 year = {2025}
}
