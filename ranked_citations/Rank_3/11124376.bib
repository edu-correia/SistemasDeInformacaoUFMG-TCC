@inproceedings{11124376,
 abstract = {This paper presents a novel framework for Exploratory Spatial Data Analytics (ESDA) tailored for efficient combined analytics of georeferenced fine-grained air quality and mobility data. The framework encompasses comprehensive stages from data acquisition to machine learning and validation, enabling holistic analysis and actionable insights into urban environmental dynamics. By integrating mobility and air quality datasets, correlations between traffic density, congestion hotspots, and pollutant levels are identified, crucial for urban planning and traffic management strategies. Through data profiling, exploratory analysis, and hypothesis testing, the study uncovers intricate connections between air quality, mobility, and urban dynamics, emphasizing the importance of integrated analytics in sustainable urban development and public health management.},
 author = {Lulu, Israa Ramiz and Alowais, Hind Rahma and Jawarneh, Isam Mashhour Al},
 booktitle = {2025 International Conference on Multimedia Computing, Networking and Applications (MCNA)},
 doi = {10.1109/MCNA65829.2025.11124376},
 issn = {},
 keyword = {Data analysis;Urban planning;Data acquisition;Multimedia computing;Machine learning;Air quality;Spatial databases;Sensors;Public healthcare;Testing;Exploratory Spatial Data Analysis (ESDA);Georeferenced Data;Low-Cost Air Quality Sensors;Mobility Data;Spatial Join;geohash;pm10},
 month = {May},
