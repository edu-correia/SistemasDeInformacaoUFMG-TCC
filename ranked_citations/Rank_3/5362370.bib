@inproceedings{5362370,
 abstract = {Suffix tree clustering is a fast, incremental, linear time clustering algorithm, but there are synonymous and label-contained relations among the result clusters. So just return these results to the users directly, would give them an added burden. In response to this problem, this paper presents a method that merging the semantic duplicate clusters and hierarchicalizing the label-contained clusters. The experimental results show that this method can effectively remove semantic duplication and hierarchicalize label-contained clusters clearly. It improves the organization of clustering results. To the STC search engine, this will provide users with better results and better classification.},
 author = {hu, Guodong and Zuo, Wanli and He, Fengling and Wang, Ying},
 booktitle = {2009 Second International Symposium on Knowledge Acquisition and Modeling},
 doi = {10.1109/KAM.2009.236},
 issn = {},
 keyword = {Clustering algorithms;Search engines;Merging;Java;Knowledge acquisition;Educational institutions;Computer science;Educational technology;Laboratories;Knowledge engineering;Semantic;Hierarchical;Suffix tree clustering},
 month = {Nov},
 number = {},
 pages = {221-224},
 title = {Semantic-Based Hierarchicalize the Result of Suffix Tree Clustering},
 volume = {3},
 year = {2009}
}
