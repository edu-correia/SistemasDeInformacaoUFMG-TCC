@article{AYMERICHFRANCH20181,
 abstract = {Emerging technologies such as virtual reality and robots are evolving to increasingly integrate the user into the interface. During this temporary merge, users experience a digital or a robotic body of an avatar as their own. Embodied cognition sustains that the body and its interactions with the environment play an important role in cognition. I argue that the adoption of mediated embodiment technologies to explore cognitive development might substantially contribute to demonstrating the postulates of embodied cognition.},
 author = {Laura Aymerich-Franch},
 doi = {https://doi.org/10.1016/j.newideapsych.2018.02.003},
 issn = {0732-118X},
 journal = {New Ideas in Psychology},
 keyword = {Mediated embodiment, Embodied cognition, Embodiment, Avatar, Virtual reality, Robots},
 pages = {1-5},
 title = {Is mediated embodiment the response to embodied cognition?},
 url = {https://www.sciencedirect.com/science/article/pii/S0732118X18300205},
 volume = {50},
 year = {2018}
}
