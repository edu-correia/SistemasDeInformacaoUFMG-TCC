@conference{Liu2009,
 abstract = {IP address assignment is an important issue in Mobile Ad Hoc Network (MANET). This paper proposes a Dynamic Address Allocation Protocol that assignment of a unique IP address to each new joining node dynamically using a distributed algorithm based on genetic algorithm (GA). A Mobile Ad Hoc Network consists of a set of identical mobile nodes, they can communicate each other without the help of any fixed infrastructure or centralized administration. We need a protocol to allocate IP addresses, solve conflicts, handle all sorts of mobility scenarios in MANET, and consider the distributed and dynamic nature of the MANET. The Dynamic Address Allocation Protocol that we present is designed to work in MANETs, and allows joining nodes to dynamically obtain addresses, and is designed to manage addresses efficiently. In addition, the new protocol also proposes a mechanism to detect duplicates and manages the operations of the MANET, such as MANETs partition and merge. Through ns2 simulation of this protocol, the efficiency of the protocol can be proved. ©2009 IEEE.},
 author = {Liu, Yong and Zhong, Ping and Li, Jiaxiong},
 doi = {10.1109/WICOM.2009.5301704},
 journal = {Proceedings - 5th International Conference on Wireless Communications, Networking and Mobile Computing, WiCOM 2009},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Dynamic address allocation protocols for mobile ad hoc networks based on genetic algorithm},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/73149087473?origin=resultslist},
 year = {2009}
}
