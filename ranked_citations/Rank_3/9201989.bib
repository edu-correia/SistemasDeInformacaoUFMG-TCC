@inproceedings{9201989,
 abstract = {Analyzing the communication and recognition among nodes is the main magnitudes using to check whether the excellence of service delivered through the wireless sensor system. In which Coverage can be defined as “In what way the objective is observed or monitored by the sensors”. In order to maximize the exposure area and decrease the energy consumption in the wireless sensor network we use the Fruit fly algorithm. A fruit fly algorithm for eliminating the overlapping(redundant) node established on the coverage probability is suggested to maximize the network period for the diverse(heterogeneous) Wireless Sensor Networks. And merging the Fruit Fly Optimization algorithm with an vitality efficient protocol is used to eliminate the redundant nodes (overlapping nodes). Using the random deployment of sensor node with different sensing radius is used in order to increase the sensing coverage quality and reduce the use of sensor nodes.},
 author = {D., Nivetha and R., Rajesh and Ramkumar, M.O.},
 booktitle = {2020 7th International Conference on Smart Structures and Systems (ICSSS)},
 doi = {10.1109/ICSSS49621.2020.9201989},
 issn = {},
 keyword = {Wireless sensor networks;Genetic algorithms;Optimization;Conferences;Intelligent structures;Sensors;Computer science;Energy consumption;Sensor Deployment;Fruit fly Algorithm;Maximum Range Coverage;Connectivity;Wireless Sensor Networks},
 month = {July},
 number = {},
 pages = {1-6},
 title = {Intelligent Fruit Fly Algorithm for Maximization Coverage Problem in Wireless Sensor Network},
 volume = {},
 year = {2020}
}
