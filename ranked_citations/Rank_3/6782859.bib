@inproceedings{6782859,
 abstract = {This paper presents a depth estimation method based on dark channel prior to construct a depth map from a single 2D image of an outdoor scene for 3D display applications. The method computes a depth map using a series of image processing strategies such as dark channel computation, edge detection, the edge-based iterative thresholding technique, the region split-and-merge algorithm, the foreground and background classification, and the depth estimation by integration of dark channel and elevation information. Experimental results and comparisons show that the proposed method provides good depth estimation in boundaries and regions of sky and buildings.},
 author = {Cheng-Hung Chuang and Wei-Chih Shen and Zhen-You Lian and Guo-Shiang Lin},
 booktitle = {2013 9th International Conference on Information, Communications & Signal Processing},
 doi = {10.1109/ICICS.2013.6782859},
 issn = {},
 keyword = {Image edge detection;Image segmentation;Smoothing methods;Tuning;Image resolution;Equations;3D display;2D-to-3D conversion;depth estimation;stereoscopic image;dark channel},
 month = {Dec},
 number = {},
 pages = {1-5},
 title = {Single image depth estimation based on dark channel prior},
 volume = {},
 year = {2013}
}
