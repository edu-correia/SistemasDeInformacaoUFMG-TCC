@inproceedings{8552914,
 abstract = {On-chip linear and nonlinear optical effects have shown tremendous potentials for applications in RF photonic signal processing. Combining their complementary optical properties in the same integrated platform is expected to satisfy the future increasing demands of high-performance integrated microwave photonic systems. However, the integration of linear circuits with high-performance optical nonlinearity elements remains challenging. Here, we report the first proof-of-concept demonstration of a microwave photonic notch filter based on the simultaneous integration of active Brillouin circuits and passive ring resonators on the same photonic chip, merging advanced filtering functionality, optimized performance and compactness.},
 author = {Liu, Yang and Choudhary, Amol and Ren, Guanghui and Vu, Khu and Morrison, Blair and Casas-Bedoya, Alvaro and Nguyen, Thach G. and Choi, Duk-Yong and Mitchell, Arnan and Madden, Stephen J. and Marpaung, David and Eggleton, Benjamin J.},
 booktitle = {2018 International Topical Meeting on Microwave Photonics (MWP)},
 doi = {10.1109/MWP.2018.8552914},
 issn = {},
 keyword = {Scattering;Optical filters;Optical ring resonators;Optical waveguides;Photonics;Optical signal processing;Nonlinear optics;Microwave photonics;photonic integrated circuits;nonlinear optics;stimulated Brillouin scattering. RF filters},
 month = {Oct},
 number = {},
 pages = {1-4},
 title = {Integrating Brillouin processing with functional circuits for enhanced RF photonic processing},
 volume = {},
 year = {2018}
}
