@inproceedings{8471473,
 abstract = {Diffuse emission at radio frequencies from clusters of galaxies merging with each other, is referred to as a Radio Halo (RH) when it emanates from the center of the cluster merger, and a Radio Relic (RR) when it emanates from the peripheral regions of the cluster merger. Radio halos and relics typically have steep spectra, and a high-frequency “cut-off”, which depends on the energetics of the cluster merger. Recently, a few radio halos relics have been detected at high frequencies (Stroe et al. (2015); Malu et al. (2010,2011)).},
 author = {},
 booktitle = {2018 2nd URSI Atlantic Radio Science Meeting (AT-RASC)},
 doi = {10.23919/URSI-AT-RASC.2018.8471473},
 issn = {},
 keyword = {Corporate acquisitions;Imaging;Merging;Cutoff frequency;Feature extraction;Scattering},
 month = {May},
 number = {},
 pages = {1-1},
 title = {CM-Wave Observations of Cluster Mergers: Hints of SZ Effect Structures},
 volume = {},
 year = {2018}
}
