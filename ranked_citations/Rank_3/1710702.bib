@inproceedings{1710702,
 abstract = {In this paper, we introduce the two-segments rectangular dielectric resonator antenna (DRA) in side by side form. This structure is composed of two different rectangular DRA, which is separated by a perfect E plate. The proposed arrangement of segments, offers bandwidth broadening of a DRA. Also, the literature demonstrate that the volume of a conventional dielectric resonator antenna can be reduced by approximately half. As well, more reductions in the volume of the DRA can be obtained by utilizing the sector structure. The technique relies on employing an extra conducting plate in the DRA, which acts as an electric wall. The proposed form of rectangular DRA, fed by microstrip coupling is illustrated in this paper. In the presented structure, two half DRA resonated in two adjacent frequencies. The attentions focus on a type of DRAs that can offer two resonant frequencies and these frequencies can be merged into a broad band, which can be used for WLAN application at 5-6 GHz band. For this purpose, the effects of various combinations of a1 and a2 dimensions on their impedance characteristic and consequently on matched bandwidth are investigated. Then we report the results of our experimental investigations on this structure on a finite ground plane},
 author = {Rezaei, P. and Hakkak, M. and Forooraghi, K.},
 booktitle = {2006 IEEE Antennas and Propagation Society International Symposium},
 doi = {10.1109/APS.2006.1710702},
 issn = {1947-1491},
 keyword = {Dielectric resonator antennas;Wireless LAN;Dielectric materials;Bandwidth;Dielectric constant;Resonant frequency;Permittivity;Microstrip antennas;Transmitting antennas;Wireless communication},
 month = {July},
 number = {},
 pages = {1005-1008},
 title = {Dielectric resonator antenna for wireless LAN applications},
 volume = {},
 year = {2006}
