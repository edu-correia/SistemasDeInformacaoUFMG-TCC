@article{Kamiya201523,
 abstract = {A measure theoretic approach to study the power and the exponential sums for the usual coding system has been developed since the 1990s. In this paper, we first introduce a new coding system, and then give explicit formulas for the power and the exponential sums for the coding system by the measure theoretic approach. An expression for the power sum using the generalized Takagi function will also be given. © 2015 Elsevier B.V.},
 author = {Kamiya, Yuichi and Okada, Tatsuya and Sekiguchi, Takeshi and Shiota, Yasunobu},
 doi = {10.1016/j.tcs.2015.05.010},
 journal = {Theoretical Computer Science},
 note = {Cited by: 2},
 pages = {23 - 38},
 publication_stage = {Final},
 source = {Scopus},
 title = {Power and exponential sums for generalized coding systems by a measure theoretic approach},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84944904748?origin=resultslist},
 volume = {592},
 year = {2015}
}
