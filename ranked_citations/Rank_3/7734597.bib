@inproceedings{7734597,
 abstract = {The optical properties of Si nanocone structures were theoretically studied by simulations. Fig. 1(a) illustrates the configuration of nanocone arrays used in the simulations. The nanocone arrays in our simulations is defined by three parameters: base diameter BD, period P and height H, and the base diameter is always set equal to the period. Simulations were performed to compare the normalized scattering cross section (Qsca) of an isolated nanocone and that of a compact nanocone array. As shown in Fig. 1(b), the compact periodic structure strongly affects the modes of Mie resonance. The resonance modes merge into a broader and much stronger feature at 500 to 1000nm range, which is in agreement with previous works on nanoparticles. In Fig. 1(c), we can see that the reflectance reaches to a minimal value when Qsca is maximal, which clearly shows that Mie resonace modes play an important role in high absorbance of nanocone structure. The electric field distribution in Fig. 1(d) demonstrates how light was coupled into the substrate by Mie resonance modes. The steep descend corresponding to 413nm in Fig. 1(c) is due to Wood-Rayleigh (WR) anomaly effect caused by the period structure [2].},
 author = {Ziyi Wang and Rongjun Zhang and Songyou Wang and Caizhuang Wang and Kai-Ming Ho},
 booktitle = {2016 Progress in Electromagnetic Research Symposium (PIERS)},
 doi = {10.1109/PIERS.2016.7734597},
