@conference{Pomeranz2017314,
 abstract = {Static compaction procedures reduce the number of tests or test cubes in a given test set, thus reducing the test data volume and test application time. In the context of test data compression where on-chip decompression is based on a linear-feedback shift-register (LFSR), this paper describes a static compaction procedure that is applied directly to the LFSR seeds. This procedure provides an option for additional compaction after other compaction procedures have already been applied. In a basic step, the procedure attempts to merge pairs of seeds s-i and s-j into a single seed s-{i,j} that detects all the faults that s-i and s-j detect. When merging is successful, the number of seeds is reduced by one without reducing the fault coverage. Experimental results are presented to demonstrate that the procedure reduces the number of seeds even when the set of seeds is produced by a dynamic compaction procedure and does not contain unnecessary seeds. © 2017 IEEE.},
 author = {Pomeranz, Irith},
 doi = {10.1109/ISVLSI.2017.62},
 journal = {Proceedings of IEEE Computer Society Annual Symposium on VLSI, ISVLSI},
 note = {Cited by: 0},
 pages = {314 - 319},
 publication_stage = {Final},
 source = {Scopus},
 title = {Static Compaction by Merging of Seeds for LFSR-Based Test Generation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85027286737?origin=resultslist},
 volume = {2017-July},
 year = {2017}
}
