@inproceedings{9090449,
 abstract = {Traditional architecture student presentations use physical artifacts such as posters and models. These artifacts are displayed in a pin up space: a space where architects pin posters showcasing their work to walls so that their work can be viewed by others. Mixed reality (MR) is a technology that involves the merging of real and virtual entities to produce hybrid environments where physical and digital objects co-exist and interact in real time. We created an application for a MR pin up space for architectural posters and models in order to explore if and how MR technology improves upon the architectural portfolio presentation experience due to a richer set of interactions. These interactions include audio clips of the designers explaining their design, and an interactive 3D model of the design. We conducted a user study where we asked participants to use our MR application to view and interact with the pin up space, and compared it to a traditional physical pin up space.},
 author = {Chen, Nanxi and Sarkaar, Ajit and Whang, Jooyoung and Wonderly, Jackson and Ye, Jiacheng and Gračanin, Denis},
 booktitle = {2020 IEEE Conference on Virtual Reality and 3D User Interfaces Abstracts and Workshops (VRW)},
 doi = {10.1109/VRW50115.2020.00092},
 issn = {},
 keyword = {Conferences;Virtual reality;Three-dimensional displays;User interfaces;Information Interfaces and Presentation;Multimedia Information Systems;Artificial, augmented, and virtual realities;Information Interfaces and Presentation;User Interfaces;Input devices and strategies},
 month = {March},
 number = {},
 pages = {433-438},
 title = {Design of a Mixed Reality Based System for Multimedia Content Presentation},
 volume = {},
 year = {2020}
}
