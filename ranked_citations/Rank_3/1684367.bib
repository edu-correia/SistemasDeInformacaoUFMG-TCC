@inproceedings{1684367,
 abstract = {In this paper, we present a comparing framework of two proposed approaches for modeling interactive systems using scenarios as defined by the Unified Modeling Language (UML). Scenarios are first transformed into partial specifications and merged to obtain a global specification capturing the behavior of any object of the system or the behavior of the entire system. From the global specification, a user interface (UI) prototype is generated and embedded in a user interface builder environment for further refinement},
 author = {Elkoutbi, M. and Jakimi, A. and Keller, R.K. and Badidi, E.},
 booktitle = {2006 2nd International Conference on Information & Communication Technologies},
 doi = {10.1109/ICTTA.2006.1684367},
 issn = {},
 keyword = {Prototypes;Unified modeling language;User interfaces;Object oriented modeling;Design engineering;Petri nets;Formal specifications;Interactive systems;Concurrent computing;Human computer interaction;Unified Modeling Language;model transformation;scenario specification;formal methods;user interface prototyping techniques},
 month = {April},
 number = {},
 pages = {183-188},
 title = {Scenario Engineering Some Lessons Learned},
 volume = {1},
 year = {2006}
}
