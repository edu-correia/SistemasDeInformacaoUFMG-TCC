@conference{Miao2023477,
 abstract = {Semantic segmentation has important research significance in environment perception in unmanned field. By improving the Enet model, adding spatial branches, turning the original model into a two-branch structure, cropping the original structure as semantic branches, and using the attention mechanism to fuse the spatial and semantic branch feature maps to retain the image spatial information and improve the grid effect. The improved algorithm is tested on dataset Cityscapes and dataset BDD100K, and the average cross-merge ratio is improved by 2.75% and 2.41%, respectively. The implementation of the two-branch Enet network makes it easier to obtain information on the drivable area of the vehicle, obstacles ahead, etc.  © 2023 IEEE.},
 author = {Miao, Siqi and Du, Yu and Lu, Xin and Guan, Huaiguang},
 doi = {10.1109/ICPECA56706.2023.10076001},
 journal = {2023 IEEE 3rd International Conference on Power, Electronics and Computer Applications, ICPECA 2023},
 note = {Cited by: 3},
 pages = {477 - 481},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic segmentation of vehicle vision based on two-branch Enet network},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85152230588?origin=resultslist},
 year = {2023}
}
