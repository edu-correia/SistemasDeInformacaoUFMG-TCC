@article{8669786,
 abstract = {This letter proposes the world’s first deep learning (DL)-assisted video encoder LSI fabricated in a 10-nm process with a core area of 0.76 mm2 to integrate quad-core DL accelerators and  $4\text{K}\times 2\text{K}$  H.264/H.265 video encoders. A visual-contact-field network (VCFNet) DL model is newly designed to predict human focus information with extraordinary reduction of encoding complexity, leading to 82.3% power reduction. Moreover, input channel reduction and layer merging approaches reduce VCFNet complexity by 69%. Operated at 0.9 V and 504 MHz, the proposed DL-assisted 4K video encoder LSI consumes 56.54 mW to achieve 0.22 nJ/pixel of energy efficiency, cutting 0.1-14 nJ/pixel compared to conventional designs.},
 author = {Liu, Tsu-Ming and Tsai, Chang-Hung and Wu, Tung-Hsing and Lin, Jia-Ying and Chen, Li-Heng and Chou, Han-Liang and Chang, Yung-Chang and Ju, Chi-Cheng},
 doi = {10.1109/LSSC.2019.2905958},
 issn = {2573-9603},
 journal = {IEEE Solid-State Circuits Letters},
 keyword = {Streaming media;Visualization;Feature extraction;Engines;Encoding;Deep learning;Tools;4K;deep learning (DL);HEVC;smartphone;video coding},
 month = {Dec},
 number = {12},
 pages = {221-224},
 title = {A 0.76 mm2 0.22 nJ/Pixel DL-Assisted 4K Video Encoder LSI for Quality-of-Experience Over Smartphones},
 volume = {1},
 year = {2018}
}
