@inproceedings{9997033,
 abstract = {The complexity of the integrated emergency-defenses (ED) system process is mainly reflected in the various sizes of the process, the lots of activities, the complex interaction and scheduling relationship. To meet the demand of rapid response on the command process, we propose a heuristic of system process reduction based on critical path merging minimum cycles, which lays a foundation for improving the dynamic response capability of system. The heuristic uses the optimization of reinforcement learning to preserve the critical path in the decision-making process, and merges and reduces the repeated minimum cycles in the critical path, which reduces the delay and uncertainty of information transmission and reduces the complexity of decision implementation effectively. Finally, the experimental results show that the heuristic is effective in process reduction and decision dimension reduction.},
 author = {Shi, Wei and Deng, Shuai},
 booktitle = {2022 International Conference on Electronics and Devices, Computational Science (ICEDCS)},
 doi = {10.1109/ICEDCS57360.2022.00036},
 issn = {},
 keyword = {Performance evaluation;Uncertainty;Scientific computing;Unified modeling language;Decision making;Merging;Reinforcement learning;heuristic;integrated emergency-defense system;process reduction},
 month = {Sep.},
 number = {},
 pages = {129-135},
 title = {Process reduction of integrated emergency-defenses system based on heuristic},
 volume = {},
 year = {2022}
}
