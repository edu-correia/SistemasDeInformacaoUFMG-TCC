@conference{Shibata20252583,
 abstract = {Semantic segmentation of medical and cellular images is an extremely important task in the advancement of medicine and cell biology. In recent years, model merging methods, which have attracted attention in the field of natural language processing and image categorization, are considered to be applicable to semantic segmentation for medical and cellular images as well. In this task, it is important to improve the accuracy for minority classes while maintaining the accuracy for majority classes, and uniform performance across all classes is required. We aim to address this challenge through model merging. However, many existing model merging methods assume the availability of pretrained models, which restricts their applicability to segmentation tasks. In this paper, we propose a novel model merging method called Specialized Model Merge (SMM). SMM does not rely on pretrained models but instead integrates multiple models that have been trained to specialize to each class within the dataset. The models specialized for each class achieve high discriminative performance for their respective classes, and SMM merges their strengths to improve overall segmentation accuracy. Through experiments on medical and cellular images, we confirm the effectiveness of the proposed method compared to existing approaches. This work opens a new avenue for model merging strategies in the field of semantic segmentation. © 2025 IEEE.},
 author = {Shibata, Kazuya and Hotta, Kazuhiro},
 doi = {10.1109/ICCVW69036.2025.00269},
 journal = {Proceedings - 2025 IEEE/CVF International Conference on Computer Vision Workshops, ICCV-W 2025},
 note = {Cited by: 0},
 pages = {2583 - 2591},
 publication_stage = {Final},
 source = {Scopus},
 title = {Segmentation by Merging Models Specialized to Each Class},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105035183070?origin=resultslist},
