@article{DENG2025133643,
 abstract = {Characterized by diverging and merging pathways, meandering-anabranching channels are prevalent in natural rivers. They usually have a significant impact on local bed topography, flow structure and sediment transport, thus influencing river segment stability. Despite their significance, the influence of emergent vegetation on the bed surface texture of these channels has not been adequately investigated. To address this gap, this study conducted a large-scale flume experiment to investigate the effects of emergent vegetation with varying cover densities on the bed surface texture of meandering-anabranching channels. The results indicate that grain size, bed shear stress, and bed topography in various regions respond differently. In the diversion zone of the meandering-anabranching channel, grain size remained the same under different vegetation cover densities and flow conditions, while bed shear stress increased with increasing vegetation density. The morphology variations of cross-section in this zone were less affected by these factors. In the branching reach, grain size was markedly influenced by both the vegetation cover density and the magnitude of flow discharge. Specifically, bed shear stress in the left branch decreased with an increase in vegetation cover density, whereas the right branch has a reverse trend. Bed Morphological changes in the branching reach were most pronounced at the crest and outlet sections, with the left branch exhibiting greater adjustments than the right. In the confluence region, the interaction of two branches led to an increase in the representative grain size of the bed surface and the scale and depth of the scour pits, an effect that intensified with the elevation of vegetation cover density. Furthermore, a specific parameter, measuring the strength of interaction between the left and right branching reaches, was utilized to quantitatively discuss how an increase in flow and vegetation cover density in the branches could enhance the interaction between these channels. A novel method for calculating the scouring depth of the cross-section in the confluence region of meandering-anabranching channels under the influence of branch emergent vegetation was established with high precision. Additionally, the relationships between characteristic grain sizes and statistical parameters of bed topography at different scales showed that the standard deviation, skewness, and kurtosis are all significantly correlated with grain sizes, especially with grain-size scale.},
 author = {Xianghui Deng and Sen Wang and Bin Zhang and Xinqi Hu and Yanxin Wang and Xingnian Liu and Er Huang and Ming Luo},
 doi = {https://doi.org/10.1016/j.jhydrol.2025.133643},
 issn = {0022-1694},
 journal = {Journal of Hydrology},
 keyword = {Meandering-anabranching channel, Bed surface texture, Vegetation impacts, Bedload transport, Bed evolution},
 pages = {133643},
 title = {Effects of emergent vegetation on bed surface texture in a meandering-anabranching channel},
 url = {https://www.sciencedirect.com/science/article/pii/S0022169425009813},
 volume = {661},
 year = {2025}
}
