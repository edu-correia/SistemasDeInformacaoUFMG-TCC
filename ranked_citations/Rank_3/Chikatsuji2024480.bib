@article{Chikatsuji2024480,
 abstract = {A knowledge graph often lacks some existent triples. Knowledge graph completion is a technique for complementing such triples and its performance can be improved by augmenting triples from other external databases. However, entity names often differ between the original knowledge graph and an external database, which reduce the augmentation’s efficiency. In this study, we identify the same entities that have different names (orthographic variants) that come from different sources, merge them into one entity, and augment the knowledge graphs. Our proposed method exploits in the original knowledge graph and the external database the similarity of triples, which were embedded using BERT. Experimental evaluation on our knowledge graph completion performance showed that our proposed method with graph information effectively outperformed two baselines. © 2024, The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd.},
 author = {Chikatsuji, Shuichi and Yamamoto, Kenta and Takeda, Ryu and Komatani, Kazunori},
 doi = {10.1007/978-981-99-7019-3_43},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {480 - 486},
 publication_stage = {Final},
 source = {Scopus},
 title = {Knowledge Graph Augmentation with Entity Identification for Improving Knowledge Graph Completion Performance},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85177185399?origin=resultslist},
 volume = {14325 LNAI},
 year = {2024}
}
