@inproceedings{11037841,
 abstract = {As the concept and practical application of smart cities become more and more popular, the technology becomes more and more advanced, and the complex network structure and the large amount of data lead to some security-related problems. Therefore, this study aims to propose an integrated security framework based on artificial intelligence and distributed systems to address the challenges of smart city security. This research focuses on how is AI combined with the current security framework to improve the security of smart city, especially smart transportation. The framework will merge the analytical capabilities of AI for data encryption and decryption, identity authorization and access control, as well as data masking and desensitization, with the characteristics of distributed systems to protect the security of smart transportation. Through the review of previous journals, it can be concluded that the improved accuracy and efficiency brought by AI and distributed systems, as well as the application of the framework in five aspects of identity, protection, detection, response. and recovery. The innovation and practicality of the framework can promote further development and research in the field of smart transportation in smart city security, and promote the development of smart cities in a safer and smarter direction.},
 author = {Jiang, Yuxi and Kumar, Burra Venkata Durga and Teh, Jia Yew},
 booktitle = {2025 6th International Conference on Computer Science, Engineering, and Education (CSEE)},
 doi = {10.1109/CSEE64583.2025.00033},
 issn = {},
 keyword = {Authorization;Technological innovation;Accuracy;Smart cities;Distributed databases;Smart transportation;Encryption;Security;Artificial intelligence;Sustainable development;Smart City;Smart Transportation;Artificial Intelligence;Security Framework},
 month = {Feb},
 number = {},
 pages = {146-150},
 title = {Application of Distributed Systems and Artificial Intelligence in Addressing Security Challenges in Smart Transportation},
 volume = {},
 year = {2025}
}
