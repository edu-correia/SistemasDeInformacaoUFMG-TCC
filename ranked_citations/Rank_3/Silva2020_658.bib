@article{Silva2020_658,
 abstract = {ABSTRACT The objective of the study was to analyze the significance of alcohol, illicit drugs and corporal practices for users of psychoactive substances who are in the process of rehabilitation at CAPS ad. 76 users who were in rehabilitation at CAPS ad Recife/PE were interviewed. Multiplicity was found in the meaning of alcohol and drugs, with negative factors predominating, even considering that alcohol is initially recognized as an element of social integration. Corporal practices presented positive meanings related mainly to body movement and mind occupation. Translated with www.DeepL.com/Translator (free version)},
 author = {Silva, Priscilla Pinto Costa da and Mendes, Maria Isabel Brandão de Souza and Santos, Patrícia de Jesus Costa dos and Oliveira, Bérgson Nogueira de and Santos, Ana Raquel Mendes os and Freitas, Clara Maria Silvestre Monteiro de},
 doi = {10.4025/jphyseduc.v31i1.3157},
 pages = {e3157--e3157},
 title = {MEANINGS OF ALCOHOL, OTHER DRUGS AND CORPORAL PRACTICES IN DEPENDENTS OF PSYCHOACTIVE SUBSTANCES},
 volume = {31},
 year = {2020}
}
