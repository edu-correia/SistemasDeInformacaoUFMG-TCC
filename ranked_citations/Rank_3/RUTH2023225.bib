@incollection{RUTH2023225,
 abstract = {This chapter offers insights into the potential applications of low-intensity psychological therapies in contexts outside of the IAPT programme in England. Whilst neither of the book authors have experience of working in psychological therapy outside of the United Kingdom, this chapter offers reflections from their experiences that might apply in other settings. Based on their experience, the authors hope to highlight potential gains and pitfalls when implementing IAPT-informed provision of psychological services. This chapter is inspired by a recorded discussion between the authors while posing questions as to how they see the potential applicability of low-intensity interventions, internationally. Excerpts from the transcript are merged within the text to provide the reader with a sense of the live narrative and dialogue, as well as conflicted opinions, and healthy debate.},
 author = {Elizabeth Ruth and James Spiers},
 booktitle = {A Pragmatic Guide to Low Intensity Psychological Therapy},
 doi = {https://doi.org/10.1016/B978-0-323-88492-1.00012-9},
 editor = {Elizabeth Ruth and James Spiers},
 isbn = {978-0-323-88492-1},
 keyword = {Low-intensity interventions, IAPT, International application, Global training, Stepped care, NHS Talking Therapies},
 pages = {225-233},
 publisher = {Academic Press},
 title = {Chapter 12 - Discussing international applications},
 url = {https://www.sciencedirect.com/science/article/pii/B9780323884921000129},
 year = {2023}
}
