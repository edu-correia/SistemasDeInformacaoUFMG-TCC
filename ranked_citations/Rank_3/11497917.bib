@inproceedings{11497917,
 abstract = {Artificial Intelligence (AI) models are being widely adopted in decision-making systems across healthcare, finance, and cybersecurity. However, many high-performing AI models, especially ensemble models such as Random Forest, Gradient Boosting, and XGBoost, are often treated as "black boxes" because their internal decision logic is complex and difficult to interpret. This lack of transparency limits trust and understanding in AI-based decisions. The proposed work introduces a hybrid Explainable AI (XAI) framework that combines SHapley Additive Explanations (SHAP) and Local Interpretable Model-agnostic Explanations (LIME) to bring more clarity and interpretability to ensemble learning models. The hybrid framework merges global feature importance from SHAP with local instance-level explanations from LIME, forming a comprehensive interpretation layer for predictive outcomes. This combination helps in identifying feature influence across the dataset as well as the reasoning behind individual predictions. The framework has been evaluated using standard classification datasets to test its interpretability and accuracy. Metrics such as precision, recall, F1-score, area under the receiver operating characteristic curve (AUC-ROC) and accuracy are used to analyze the model’s predictive performance, while consistency and fidelity scores are used to assess the quality of explanations. The experimental results indicate that the hybrid XAI approach improves transparency without reducing model accuracy, making it suitable for applications that demand both reliability and interpretability. The proposed method presents a step toward building human-understandable and trustworthy AI systems capable of supporting informed and responsible decisions.},
 author = {Yarlagadda, Krishna Chaitanya},
 booktitle = {2026 IEEE International Conference on Emerging Computing and Intelligent Technologies (ICoECIT)},
 doi = {10.1109/ICoECIT68303.2026.11497917},
 issn = {},
 keyword = {Radio frequency;Protocols;HTTP;Receivers;Radio communication;Radio access networks;Regional area networks;Communication systems;Artificial intelligence;Cognitive systems;Explainable AI;SHAP;LIME;Ensemble Models;Interpretability},
 month = {Jan},
 number = {},
 pages = {1-6},
 title = {A Dual-Interpretability AI Approach for High-Stakes Applications Using SHAP and LIME},
 volume = {},
