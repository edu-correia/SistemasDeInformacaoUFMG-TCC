@inproceedings{11338354,
 abstract = {Understanding the global wave and its changing is important for fishery and marine safety. Limited by their cost and offering only in-situ observations, wave buoys can cover only a very limited span of the ocean. Merging multi-altimeter data has shown the ability to improve the accuracy of the sea waves. A variational approach applying successive correction method is introduced to fuse the background wave and multi-altimeter waves. Simulation shows that multi-altimeter observations have positive influence with respect to the background. The nearer from the altimeter observation locations, the better the analytical results are. In the real data, the wave data derived from seven calibrated altimeters is collected as observations, the matching forecast data as background, and the reanalyzed data as true wave for validation. Results show that the background global significant wave height (SWH) error is 57.90 cm. The analytical SWH error reduces to 52.89 cm after applying the variational approach, which shows a new method to improve the accuracy of the background SWHs.},
 author = {Jiang, Zhuhui and Kong, Xiaojuan and Zhai, Yumei and Chen, Jian and Wang, Peixuan and Ouyang, Zhiling},
 booktitle = {2025 8th International Conference on Information Communication and Signal Processing (ICICSP)},
 doi = {10.1109/ICICSP66564.2025.11338354},
 issn = {2770-792X},
 keyword = {Accuracy;Costs;Fuses;Oceans;Merging;Data integration;Signal processing;Numerical simulation;Marine safety;Fisheries;significant wave height;altimeter;fusion},
 month = {Sep.},
 number = {},
 pages = {216-220},
 title = {A Variational Approach to Significant Wave Height Fusion},
 volume = {},
 year = {2025}
}
