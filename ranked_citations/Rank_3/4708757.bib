@inproceedings{4708757,
 abstract = {A 66 fps 38 mW nearest neighbor matching processor for real-time object recognition has been fabricated in 0.13 mum CMOS technology. It consists of RISC processing core, pre-fetch DMA, and two independent sets of logic merged memories. Based on hierarchical vector quantization (H-VQ) algorithm, implemented processor achieves 22.5X cycle time reduction in matching process without any accuracy loss in VQ operation. As a result, 66 fps frame rate is obtained for QVGA (320times240 pixels) video images with 5632-entry database.},
 author = {Kim, Joo-Young and Kim, Kwanho and Lee, Seungjin and Kim, Minsu and Yoo, Hoi-Jun},
 booktitle = {2008 IEEE Asian Solid-State Circuits Conference},
 doi = {10.1109/ASSCC.2008.4708757},
 issn = {},
 keyword = {Nearest neighbor searches;Object recognition;Image databases;Hardware;Acceleration;Vector quantization;Image coding;Solid state circuits;Real time systems;Degradation},
 month = {Nov},
 number = {},
 pages = {177-180},
 title = {A 66fps 3 8mW nearest neighbor matching processor with hierarchical VQ algorithm for real-time object recognition},
 volume = {},
 year = {2008}
}
