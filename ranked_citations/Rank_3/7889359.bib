@inproceedings{7889359,
 abstract = {In this paper, we propose a novel scheme for extracting a JPEG (Joint Picture Experts Group) snap shot image from an HEVC (High Efficiency Video Coding) bitstream. Since both JPEG and HEVC adopt the DCT-based transform coding scheme, we extract the DCT information from the HEVC bitstream and process the data to be suitable for JPEG compression. JPEG uses constant block size DCT whereas HEVC uses variable block sizes DCT. In order to unify the DCT block size, we use the direct splitting and merging in DCT domain. Then, we obtain the coefficients of the prediction frame by performing motion compensation in DCT domain. The coefficients of the current frame are reconstructed by adding the residual coefficients to the prediction coefficients. Then, the reconstructed coefficients are used for JPEG compression. The experimental results show that the proposed method comparatively well maintains the image quality with lower computational complexity.},
 author = {Hyunjae Lee and Jongseok Lee and Dongkyu Lee and Seoung-Jun Oh},
 booktitle = {2017 IEEE International Conference on Consumer Electronics (ICCE)},
 doi = {10.1109/ICCE.2017.7889359},
 issn = {2158-4001},
 keyword = {Discrete cosine transforms;Transform coding;Image coding;Streaming media;Motion compensation;Image reconstruction;Merging},
 month = {Jan},
 number = {},
 pages = {372-373},
 title = {A novel scheme for extracting a JPEG image from an HEVC compressed video},
 volume = {},
 year = {2017}
}
