@article{Wang2011122,
 abstract = {In P2P system, search efficiency and adaptive overhead are two important performances. Both of them should be taken into consideration, in designing a P2P model. In this paper, we have proposed protocols to construct and manage a small world semi-construct network without single point failure and improve the performance of the P2P network effectively. In SWSN, the search mechanism combines techniques of both structured and unstructured search mechanisms. We have also proposed cluster merge mechanism to change the cluster size and number of Inter-link between clusters in order to achieve low average hop distance between nodes and a high clustering coefficient. From the simulation results, we can see that in searching efficiency and maintenance costs, SWSN potentially has advantages of both structured and unstructured P2P networks and achieved a good performance in dynamic environments.},
 author = {Wang, Zhenling},
 doi = {10.4156/ijact.vol3.issue6.15},
 journal = {International Journal of Advancements in Computing Technology},
 note = {Cited by: 1},
 number = {6},
 pages = {122 - 130},
 publication_stage = {Final},
 source = {Scopus},
 title = {The study on semi-structured P2P network based on small world theory},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/79961051153?origin=resultslist},
 volume = {3},
 year = {2011}
}
