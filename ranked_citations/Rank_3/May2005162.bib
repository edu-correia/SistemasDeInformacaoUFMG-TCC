@conference{May2005162,
 abstract = {An increasing number of applications depend on efficient storage and analysis features for XML data. Hence, query optimization and efficient evaluation techniques for the emerging XQuery standard become more and more important. Many XQuery queries require nested expressions. Unnesting them often introduces binary grouping. We introduce several algorithms implementing binary grouping and analyze their time and space complexity. Experiments demonstrate their performance. © Springer-Verlag Berlin Heidelberg 2005.},
 author = {May, Norman and Moerkotte, Guido},
 doi = {10.1007/11547273_12},
 journal = {Lecture Notes in Computer Science},
 note = {Cited by: 7},
 pages = {162 - 176},
 publication_stage = {Final},
 source = {Scopus},
 title = {Main memory implementations for binary grouping},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/27244439551?origin=resultslist},
 volume = {3671},
 year = {2005}
}
