@inproceedings{6180614,
 abstract = {A new type of merging unit is introduced for digital substation in this paper. Based on integration design method at the process level, merging unit and intelligent operating unit are integrated into a new type merging unit. Dual CPU of dsPIC and ARM is applied in plug-in structure. And also some details of designing in hardware and software are introduced in this paper. The device, with good function, high performance in reliability, generality and scalability, can meet the requirements of both digital substation and future smart substation, which has good reference significance and application value.},
 author = {Ma, WenJun and Mu, LongHua and Ao, Pei and ZhanG, Xin},
