@conference{Chen20201008,
 abstract = {Natural language processing (NLP) has been applied to various fields including text classification and sentiment analysis. In the shared task of assessing the funniness of edited news headlines, which is a part of the SemEval 2020 competition, we preprocess datasets by replacing abbreviation, stemming words, then merge three models including Light Gradient Boosting Machine (LightGBM), Long Short-Term Memory (LSTM), and Bidirectional Encoder Representation from Transformer (BERT) by taking the average to perform the best. Our team Ferryman wins the 9th place in Sub-task 1 of Task 7 - Regression. © 2020 14th International Workshops on Semantic Evaluation, SemEval 2020 - co-located 28th International Conference on Computational Linguistics, COLING 2020, Proceedings. All rights reserved.},
 author = {Chen, Weilong and Li, Jipeng and Huang, Chenghao and Bai, Wei and Zhang, Yanru and Wang, Yan},
 doi = {10.18653/v1/2020.semeval-1.131},
 journal = {14th International Workshops on Semantic Evaluation, SemEval 2020 - co-located 28th International Conference on Computational Linguistics, COLING 2020, Proceedings},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 pages = {1008 - 1012},
 publication_stage = {Final},
 source = {Scopus},
 title = {Ferryman at SemEval-2020 Task 7: Ensemble Model for Assessing Humor in Edited News Headlines},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85098833532?origin=resultslist},
 year = {2020}
}
