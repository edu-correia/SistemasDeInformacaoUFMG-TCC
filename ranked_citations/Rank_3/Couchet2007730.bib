@article{Couchet2007730,
 abstract = {This paper<sup>1</sup> introduces a novel architecture to efficiently code in a self-organized manner, data from sequences or a hierarchy of sequences. The main objective of the architecture proposed is to achieve an inductive model of the sequential data through a learning algorithm in a finite vector space with generalization and prediction properties improved by the compression process. The architecture consists of a hierarchy of recurrent self-organized maps with emergence which performs a fractal codification of the sequences. An adaptive outlier detection algorithm is used to automatically extract the emergent properties of the maps. A visualization technique to help the analysis and interpretation of data is also developed. Experiments and results for the architecture are shown for an anomaly intrusion detection problem. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Couchet, Jorge and Ferreira, Enrique and Fonseca, André and Manrique, Daniel},
 doi = {10.1007/978-3-540-71618-1_81},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 number = {PART 1},
 pages = {730 - 738},
 publication_stage = {Final},
 source = {Scopus},
 title = {A novel architecture for the classification and visualization of sequential data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/38049036245?origin=resultslist},
 volume = {4431 LNCS},
 year = {2007}
}
