@inproceedings{8280048,
 abstract = {Development of techniques for digitalisation of buildings has resulted in digital repositories with millions of digitised items. These vast resources response to queries with datasets containing information for completion of user's understanding of building artefacts. Since building models focus on information only, knowledge based approaches can help in adding semantics to information artefacts. In the paper knowledge engineering technologies appropriate for AEC (Architectural, Engineering and Construction) projects are shortly described. New potentials created with the merge of knowledge engineering and BIM (Building Information Modelling) for AEC projects are discussed. An existing knowledge model for construction projects was adapted to a new domain knowledge model for heritage buildings. Result is an OWL (Web Ontology Language) ontology, which was tested in a real use case.},
 author = {Tibaut, Andrej and Perhavec, Daniela Dvornik and Kaucic, Branko},
 booktitle = {2017 International Conference on Engineering, Technology and Innovation (ICE/ITMC)},
 doi = {10.1109/ICE.2017.8280048},
 issn = {},
 keyword = {Buildings;Ontologies;Semantics;Knowledge based systems;Cognition;Vocabulary;knowledge modelling;ontology;semantic web;buildings},
 month = {June},
 number = {},
 pages = {1414-1418},
 title = {Knowledge modelling of buildings: Use case for heritage buildings},
 volume = {},
 year = {2017}
}
