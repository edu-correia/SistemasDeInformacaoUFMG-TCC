@article{Zhou2014471,
 abstract = {Before a patent application is made, it is important to search the appropriate databases for prior-art (i.e., pre-existing patents that may affect the validity of the application). Previous work on prior-art search has concentrated on single query representations of the patent application. In the following paper, we describe an approach which uses multiple query representations. We evaluate our technique using a well-known test collection (CLEF-IP 2011). Our results suggest that multiple query representations significantly outperform single query representations. © 2013, Springer Science+Business Media New York.},
 author = {Zhou, Dong and Truran, Mark and Liu, Jianxun and Zhang, Sanrong},
 doi = {10.1007/s10791-013-9236-1},
 journal = {Information Retrieval},
 note = {Cited by: 3},
 number = {5-6},
 pages = {471 - 491},
 publication_stage = {Final},
 source = {Scopus},
 title = {Using multiple query representations in patent prior-art search},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84943589319?origin=resultslist},
 volume = {17},
 year = {2014}
}
