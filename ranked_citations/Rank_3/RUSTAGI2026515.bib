@incollection{RUSTAGI2026515,
 abstract = {Diabetes is one of the most common chronic metabolic diseases, affecting 422 million people worldwide. While traditional medicine has struggled to treat this complex disease, artificial intelligence (AI) may offer a solution. By rapidly integrating enormous datasets and new information into clinical practices, AI has the potential to revolutionize the treatment of chronic diseases. Health histories are merged with patient lifestyle choices to determine patterns and make increasingly accurate predictions about future health outcomes. Although still in its infancy, AI is already being used to analyze large datasets and electronic health records to uncover new biomarkers that are the basis for creating individualized diabetes risk and treatment plans. It is also behind new devices and smartphone apps that continuously monitor blood glucose and provide instant prescription advice on lifestyle and diet to control blood sugar and reduce insulin resistance. Researchers are also using AI technology to develop tools that help in the early detection of diabetes-related complications like nerve damage and eye problems (more on that in the next chapter). This chapter discusses what the literature has to say about how AI can complement traditional medicine in revolutionizing healthcare. This chapter provides a comparison of literature that demonstrates how AI can complement traditional medicine in healthcare.},
 author = {Sarvesh Rustagi and Vinay Kumar Pandey and Dhyal Singh and Divya Jain and Ayush Madan},
 booktitle = {Plant-Based Drug Discovery},
 doi = {https://doi.org/10.1016/B978-0-443-31698-2.00010-2},
 editor = {Mamta Bisht and Ajay Singh and Akhileshwar Kumar Srivastava},
 isbn = {978-0-443-31698-2},
 keyword = {Artificial intelligence, Diabetes, Healthcare, Traditional Medicine},
 pages = {515-536},
 publisher = {Academic Press},
 title = {Chapter 21 - Integration of artificial intelligence with traditional medicine for treating diabetes},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443316982000102},
 year = {2026}
}
