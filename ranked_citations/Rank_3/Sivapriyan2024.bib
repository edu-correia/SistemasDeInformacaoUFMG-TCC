@conference{Sivapriyan2024,
 abstract = {Augmented Reality (AR) stands at the forefront of technological advancements, reshaping the way we perceive and interact with our environment. This paper delves deeply into the multifaceted applications of AR, emphasizing its transformative impact on the education sector and engineering disciplines. In education, AR transcends traditional learning paradigms, offering immersive experiences that merge digital content with the tangible world. This fusion not only demystifies complex concepts but also fosters heightened student engagement and tailored learning experiences. Shifting the lens to engineering, especially civil engineering, AR emerges as a game-changer. It provides engineers and architects with tools to visualize prospective structures in their actual environments, enhancing design accuracy and stakeholder communication. On construction sites, AR overlays crucial data, from subterranean utilities to geological specifics, ensuring precision and efficiency. Furthermore, AR's integration facilitates real-time monitoring, safety training, and public engagement, streamlining processes and minimizing potential errors. As AR continues to evolve, its potential to revolutionize sectors, from education to civil engineering, becomes increasingly evident. This paper underscores the pivotal role of AR in shaping future innovations, emphasizing its capacity to bridge the digital and physical realms seamlessly. © 2024 IEEE.},
 author = {Sivapriyan, R. and Raj, Lavan and Selvi, Tamil and Raj, Ganesh},
 doi = {10.1109/IITCEE59897.2024.10467346},
 journal = {Proceedings of the 2nd International Conference on Intelligent and Innovative Technologies in Computing, Electrical and Electronics, ICIITCEE 2024},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Review on Augmented Reality in Civil Engineering Education and Application},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85189794470?origin=resultslist},
