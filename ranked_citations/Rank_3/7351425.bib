@inproceedings{7351425,
 abstract = {A novel real-time homogeneous region segmentation method is proposed that decouples appearance and geometric properties of the regional energy model into data-driven external and regularization driven internal energy functions. The initial seed locations are selected using local minimal variance estimated using minimum rectangle converging criteria. Region convergence is obtained through an iterative co-ordinate descent technique. Since this method requires only 14 ms per video frame, it will help compress intelligent transportation system video for transmission over mobile networks for surveillance and cloud-based processing.},
 author = {Mishra, Akshaya and Eichel, Justin A. and Abbott, Tyler},
 booktitle = {2015 IEEE International Conference on Image Processing (ICIP)},
 doi = {10.1109/ICIP.2015.7351425},
 issn = {},
 keyword = {Image segmentation;Real-time systems;Streaming media;Active contours;Image coding;Merging;Deformable models;Segmentation;region growing;deformable model;internal and external energy;local minimal variance;minimum rectangle converging criteria;compression},
 month = {Sep.},
 number = {},
 pages = {3354-3357},
 title = {DREM: Decoupled region energy model for image segmentation},
 volume = {},
 year = {2015}
}
