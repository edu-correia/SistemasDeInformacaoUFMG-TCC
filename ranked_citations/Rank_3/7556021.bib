@inproceedings{7556021,
 abstract = {This paper takes a second look on the Relevance Feedback technique with query reformulation referred to as the Weight Propagation Technique (WP). The method is developed by the authors and uses documents chosen relevant or not relevant to build positive and negative weights in relation to other documents marked as similar according to some criteria. Documents considered in this work are considered independent vectors instead of having them merged into a single vector as is the case with traditional approaches. A new query reformulation method is proposed to use in conjunction with WP. Tests conducted here to illustrate the effectiveness of the WP method of doing RF reveal that performance improves especially when using large test collections.},
 author = {Moughrabi, Issam A. R. and Yamout, Fadi A.},
 booktitle = {2016 SAI Computing Conference (SAI)},
 doi = {10.1109/SAI.2016.7556021},
 issn = {},
 keyword = {Radio frequency;Indexes;Hamming distance;Large scale integration;Standards;Negative feedback;Information Retrieval;Relevance feedback;query reformulation;Big Data},
 month = {July},
 number = {},
 pages = {458-463},
 title = {A weight dissemination look at relevance feedback and query reformulation},
 volume = {},
 year = {2016}
}
