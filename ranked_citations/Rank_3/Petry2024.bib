@conference{Petry2024,
 abstract = {This work investigates semantic and syntactic interoperability capabilities on a Piping and Instrumentation Diagram (P&ID) model of engineering plants. Our analysis extends to a case study involving the Data Exchange in the Process Industry (DEXPI) specification, emphasizing the need for well-founded ontological relationships. By mapping P&ID classes of the DEXPI representation model to the Offshore Petroleum Production Plant Ontology (O3PO), we aim to clarify and regulate the semantics of P&ID entities and structuring relations. While technical interoperability between DEXPI P&IDs and BFO-based domain ontologies is achievable, we identify challenges in semantic interoperability of the standard, including issues related to clarity, conciseness, extensibility, consistency, and essence. These challenges could bottleneck seamless system integration and pose adoption barriers for the DEXPI P&ID specification beyond the information handover use case. © 2024 Copyright for this paper by its authors.},
 author = {Petry, Rafael H. and Santos, Nicolau O. and Rodrigues, Fabrício H. and Silva, Haroldo R.S. and Romeu, Régis K. and Cameron, David and Abel, Mara and Netto, João C.},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Interoperability in petroleum production plants: A case study on the DEXPI P&ID specification},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85214562812?origin=resultslist},
 volume = {3882},
 year = {2024}
}
