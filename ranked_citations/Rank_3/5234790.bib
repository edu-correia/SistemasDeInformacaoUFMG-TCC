@inproceedings{5234790,
 abstract = {Case retrieval is an important part of case-based reasoning system. According to the idea of Ant Colony Algorithm, the paper performs clustering to case base, and on this basis, in accordance with the idea of k-means algorithm, designs a case retrieval algorithm. Then the paper analyzes the organization method based on heterogeneous case, focuses on the clustering algorithm of case and the retrieval algorithm of case. The experimental results show that the method is able to convert the maintenance of case base into the maintenance of sample case, thus effectively improve the efficiency of case retrieval.},
 author = {Shi-xia Ma and Qing-yun Ru and Liu, Dan and Zu-hua Guo},
 booktitle = {2009 2nd IEEE International Conference on Computer Science and Information Technology},
 doi = {10.1109/ICCSIT.2009.5234790},
 issn = {},
 keyword = {Clustering algorithms;Algorithm design and analysis;Humans;Computer science;Educational institutions;Libraries;Artificial intelligence;Internet;Electronic commerce;Semantic Web;Case-based reasoning;feature item's weight;case retrieval log},
 month = {Aug},
