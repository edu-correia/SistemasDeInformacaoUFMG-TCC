@conference{Fan2024,
 abstract = {Radar observations have identified a phenomenon where insects exhibit collective migratory behavior, characterized by uniform flight times, altitudes, and directions. Radar-detected insect swarms display aggregation in both spatial and temporal dimensions, with indistinct boundaries and varied shapes. Different swarms often merge into a single entity, making it challenging to accurately extract individual swarms using simple multi-parameter segmentation methods. To address these issues, this paper proposes an insect swarm segmentation method based on a two-dimensional spatiotemporal aggregation pattern attention mechanism. Building upon the Mask R-CNN architecture, this method leverages spatial attention mechanisms and circular soft nonmaximum suppression algorithms to enhance spatial position sensitivity and reduce occlusion effects between adjacent swarms. This approach transforms the two-dimensional clustering problem into an image instance segmentation problem and demonstrates its effectiveness in the automatic segmentation of insect swarms.  © 2024 IEEE.},
 author = {Fan, Longxiao and Li, Weidong and Zhang, Zhibo and Wang, Rui},
 doi = {10.1109/ICSIDP62679.2024.10868257},
 journal = {IEEE International Conference on Signal, Information and Data Processing, ICSIDP 2024},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Insect Swarm Segmentation Algorithm Based on Two-dimensional Spatiotemporal Aggregation Pattern Attention Mechanism},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/86000023784?origin=resultslist},
 year = {2024}
}
