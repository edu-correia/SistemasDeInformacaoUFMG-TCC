@inproceedings{4564647,
 abstract = {In this paper we propose a new combinational criterion as a mean for comparison between different LDPC codes in terms of complexity and efficiency. The main idea behind the proposed criterion is to merge different aspects of a code to a unique number. We will show that the new criterion, named “Goodness Number” or GN, is applicable, and in some circumstances it is preferred to other criteria such as complexity and error probability criteria and at the same time it maintains computational simplicity.},
 author = {Harati Nejad Torbati, Amir Hosein and Attari, Mahmoud Ahmadian and Moosavinia, Amir},
 booktitle = {2008 Canadian Conference on Electrical and Computer Engineering},
 doi = {10.1109/CCECE.2008.4564647},
 issn = {0840-7789},
 keyword = {Parity check codes;Hardware;Error probability;Equations;Iterative decoding;Turbo codes;Code standards;Standards development;Energy consumption;Delay;LDPC codes;Hardware Implementation;Decoder Complexity;Comparing Different Codes;Efficiency Compression},
 month = {May},
 number = {},
 pages = {000805-000808},
 title = {A new criterion to compare different LDPC codes for hardware implementation},
 volume = {},
 year = {2008}
}
