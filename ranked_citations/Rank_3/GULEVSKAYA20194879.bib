@article{GULEVSKAYA20194879,
 abstract = {Novel azine-helicene hybrids (pyridine-, pyrazine- and quinoxaline-fused along the central ring [5]helicenes) have been prepared in good overall yields through a five-step synthetic sequence. Commercially available 2,3-dihaloazines were used as starting materials. To discern the effect of merging an azine moiety within a helical skeleton, the X-ray structures, UV/Vis absorption spectra, cathodic and anodic electrochemistry of the helicene hybrids were investigated and compared to that of the parent [5]helicene.},
 author = {Anna V. Gulevskaya and Daria I. Tonkoglazova and Andrey S. Guchunov and Alexander D. Misharev},
 doi = {https://doi.org/10.1002/ejoc.201900818},
 issn = {1434-193X},
 journal = {European Journal of Organic Chemistry},
 keyword = {Azine-[5]helicene hybrids, Helical structures, Nitrogen heterocycles, Synthetic methods},
 number = {30},
 pages = {4879-4890},
 title = {Synthesis and Characterization of Azine-[5]Helicene Hybrids},
 url = {https://www.sciencedirect.com/science/article/pii/S1434193X22027116},
 volume = {2019},
 year = {2019}
}
