@article{AGYABENG2025101397,
 abstract = {The concepts of transformational and transactional leadership are widely recognised as guiding compasses for achieving organisational goals. This study advances understanding of the two concepts by proposing "transfor-sactional" leadership, a hybrid model that merges both approaches. Grounded by the field observational data and existing scholarship as products of data sources, the study demonstrates interesting and thought-provoking perspectives. The findings highlight that transfor-sactional leadership fosters sustainable success enabling organisations to navigate change, maintain operational stability, and achieve lasting impact across economic. Transfor-sactional leadership is achieved through adaptation and motivated teams aligned with long-term, measurable goals. The study shows that integrating transformational qualities with transactional discipline enhances organisational effectiveness, resilience, and sustainability. As one of the few studies to conceptualise transfor-sactional leadership, the study contributes both theoretical novelty and practical utility for policymakers, practitioners, and leadership scholars.},
 author = {Anthony Nkrumah Agyabeng},
 doi = {https://doi.org/10.1016/j.sftr.2025.101397},
 issn = {2666-1888},
 journal = {Sustainable Futures},
 keyword = {Transformational leadership, Transactional leadership, Styles of leadership, Transfor-sactional, Ghana},
 pages = {101397},
 title = {The future of leadership: Can “Transfor-sactional” management drive sustainable success?},
 url = {https://www.sciencedirect.com/science/article/pii/S266618882500958X},
 volume = {10},
 year = {2025}
}
