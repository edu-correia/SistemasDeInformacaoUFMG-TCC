@inproceedings{7015125,
 abstract = {Based on one or several views, view synthesis creates other views for the purpose of view prediction (for compression) or view rendering (for multiview-display). Luminance adjustment and hole filling are two key issues in view synthesis. In this paper, two views are used to produce an arbitrary virtual synthesized view. One view is merged into another view using a local luminance adaptive adjustment method, based on local neighborhood region for the calculation of adjustment coefficient. Moreover, a maximum neighborhood spreading strength hole filling method is presented to deal with the micro texture structure when the hole is being filled. Simulation results show that the proposed method can achieve high performance both subjectively and objectively.},
 author = {Fu, Zhizhong and Li, Yuan and Yang, Xiaohui and Xu, Jin and Wang, Xue},
 booktitle = {2014 12th International Conference on Signal Processing (ICSP)},
 doi = {10.1109/ICOSP.2014.7015125},
 issn = {2164-523X},
 keyword = {Filling;Three-dimensional displays;Rendering (computer graphics);Adaptation models;PSNR;Conferences;Simulation;View Synthesis;Multi view;Local Luminance Correction;Hole Filling;Neighborhood spreading strength},
 month = {Oct},
 number = {},
 pages = {857-860},
 title = {A view synthesis method based on local luminance and neighborhood spreading strength information},
 volume = {},
 year = {2014}
}
