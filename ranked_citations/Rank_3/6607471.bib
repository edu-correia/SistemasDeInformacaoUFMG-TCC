@inproceedings{6607471,
 abstract = {This paper proposes a novel content-based image retrieval technique, which integrates block-based visual features and user's query concept-based semantic features. It also facilitates short-term and long-term learning processes by integrating users' historical relevance feedback information. The history is compactly stored in a semantic feature matrix and efficiently represented as semantic features of the images. The short-term relevance feedback technique can benefit from long-term learning. The high-level semantic features are dynamically updated based on users' query concept and therefore represent the image's semantic meaning more accurately. Our extensive experimental results demonstrate that the proposed system outperforms its seven state-of-the-art peer systems in terms of retrieval precision and storage space.},
 author = {Xiao, Zhongmiao and Qi, Xiaojun},
 booktitle = {2013 IEEE International Conference on Multimedia and Expo (ICME)},
 doi = {10.1109/ICME.2013.6607471},
 issn = {1945-788X},
 keyword = {Semantics;Visualization;Feature extraction;Radio frequency;Merging;Image retrieval;Content-based image retrieval;relevance feedback;semantic feature matrix},
 month = {July},
 number = {},
 pages = {1-6},
 title = {Block-based long-term content-based image retrieval using multiple features},
 volume = {},
 year = {2013}
}
