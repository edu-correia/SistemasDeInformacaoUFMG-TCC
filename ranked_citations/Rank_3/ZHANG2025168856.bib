@article{ZHANG2025168856,
 abstract = {Developing compatible high-efficiency electromagnetic interference (EMI) shielding and microwave absorption textiles is urgently demanded to address the growing issue of electromagnetic radiation pollution, particularly secondary radiation, but it is still challenging to integrate these two features onto a single textile. Herein, utilizing the inherently highly porous macrostructure of 3D spacer fabric (SF), a multi-scale asymmetric structural textile was innovatively designed vis a continuous interface assembly process, including MXene coating, localized electroless NiP plating, and hydrothermal growth of nickel cobalt oxide (NiCo2O4). Across the SF thickness direction, the upper NiCo2O4/MXene layer merges favorable impedance matching and dielectric/magnetic synergistic loss features, enabling electromagnetic wave penetration and initial dissipation. While the bottom NiCo2O4/Ni-P/MXene layer leverages the high electrical conductivity of the NiP plating to function as a potent microwave reflection layer. Meanwhile, the microscopic impedance gradient (NiCo2O4/Ni-P/MXene) along the radial direction of individual fibers, combined with the unique needle-like morphology of external NiCo2O4, further enhances the interaction and scattering of electromagnetic waves. Consequently, the resulting textile achieves ultra-high EMI shielding effectiveness of 64.4 dB, extremely low reflectivity of 0.08, and minimum reflection loss of −57.95 dB in the K-band, surpassing the current state of the art. CST simulations confirm a significant reduction in radar scattering cross-section (21.68 dBm2), underscoring its potential for microwave absorption application. This work provides a viable and effective strategy for overcoming the incompatibility between high-efficiency EMI shielding and strong microwave absorption on a single textile substrate.},
 author = {Miao Zhang and Tingting Shang and Yu Wang and Yongming Song},
 doi = {https://doi.org/10.1016/j.cej.2025.168856},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Asymmetric impedance structure, EMI shielding textile, Microwave absorption, TiCT MXene, Nickel cobalt oxide},
 pages = {168856},
 title = {Multi-scale asymmetric structural textile design strategy for overcoming the incompatibility between high-efficiency electromagnetic interference shielding and microwave absorption},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894725096986},
 volume = {523},
 year = {2025}
}
