@article{8154606,
 abstract = {In this paper, we present a synergy of technology and traditional craft made possible with AmbiKraf Byobu. AmbiKraf is a non-emissive, color-changing fabric technology that allows subtle animations on fabrics. Byobu is a traditional Japanese room-divider screen, usually painted by artisans and crafts people. We first discuss the organic qualities of AmbiKraf technology that particularly lend itself to traditional art and craft practice. These qualities include the animation of ambient, non-intrusive and calming motifs using non-emissive display characteristics. We then discuss in detail how AmbiKraf technology is implemented and paired with the art form of Byobu. Interaction with the system is also briefly touched upon, as well as discussion regarding the cultural implications and mutual benefit of combining technology with traditional craft. Through the use of AmbiKraf technology embodied by the Byobu, we hope to provide a convincing example that sensitively combines traditional textile crafts with new technology in order to help redefine the meaning and role of traditional textiles.},
 author = {Peiris, Roshan Lalintha and Kwan Valino Koh, Jeffrey Tzu and Tharakan, Mili John and Fernando, Owen Noel Newton and Cheok, Adrian David},
 doi = {10.1093/iwc/iws013},
 issn = {1873-7951},
 journal = {Interacting with Computers},
 keyword = {textile;fabric;organic;interface;Byobu;interaction;animation;thermochromic;Peltier;non-emissive;display},
 month = {March},
 number = {2},
 pages = {173-182},
 title = {AmbiKraf Byobu: Merging Technology with Traditional Craft},
 volume = {25},
 year = {2013}
}
