@article{Makhortov2020437,
 abstract = {An approach to automatized object-oriented code refactoring is described that applies LP structures theory to type hierarchy transformations, which merge attributes sharing common subclasses. A distinctive feature of these algebraic structures is their ability to model aggregation not as a relation between independent sets of types and attributes, but as a relation between specific types. The property enables a more adequate modeling of type hierarchies. The described approach is dual to the “Pull Up Field” refactoring method that was considered in the previous works related to the applications of LP structures theory. In this paper, LP structures on type lattices are extended to be able to model a wider range of type hierarchies and to accommodate external constraints on the refactoring process. Also, the paper details the process of constructing and applying the model. © Springer Nature Switzerland AG 2020.},
 author = {Makhortov, Sergey and Nogikh, Aleksandr},
 doi = {10.1007/978-3-030-59535-7_32},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {437 - 447},
 publication_stage = {Final},
 source = {Scopus},
 title = {Application of lp structures theory to intelligent attribute merger refactoring},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85092168072?origin=resultslist},
 volume = {12412 LNAI},
 year = {2020}
}
