@inproceedings{10602271,
 abstract = {The abstract outlines a novel system for seizure prediction, featuring the integration of an ASP-DSRN: Accurate seizure prediction using dual self-attention residual networking model for effective seizure prediction. This system utilizes a hybrid approach merging residual network and self-attention mechanisms thus enhancing the precision and efficacy of seizure prediction. Atmost grueling steps in prevailing brain illness involves the prediction of adverse toll in the persisting medical condition, epileptic seizure prediction has attracted expansive attention from numerous experimenters owing to its ability to address this task. Anticipating seizures in epileptic patients holds significant potential to improve patients quality of life across various dimensions, including averting accidents and mitigating the risks associated with epileptic episodes while also helping oneself to be prepared ahead of time. The system illustrates the efficacy of the seizure prediction mechanism and highlights its eventuality as a useful tool in the early prediction of seizures for people with epilepsy by analyzing the EEG (Electroencephalogram) data of the patients. The dual self attention mechanism within RDANet comprises modules that accomplishes the objective of the system. There are two modules involved, a spectrum attention module and a channel attention module. The spectrum attention module competently conflates original and global features, thus comprehending the system’s understanding of the complex frequency patterns present in the EEG signals. Contemporaneously, the other module, channel attention delves into the correlations among various channels in EEG data, whilst the dual self-attention mechanism enhances the model’s ability to discern and cope with intricate patterns. The effective Self attention residual network for seizure prediction system is aimed to achieve a perceptivity of $89.33 \%$, a particularity of $93.02 \%$, an AUC of $91.26 \%$ and a delicacy of $92.07 \%$ on a public CHB-MIT EEG dataset. The efficacy of the system showcased from the performance analysis of CHB-MIT scalp EEG dataset underscores its ability to achieve exceptional sensitivity, specificity, AUC, and precision which are the essential benchmarks for evaluating the reliability of the seizure prediction system. Thus the ASP-DSRN: Accurate seizure prediction using dual self-attention residual networking model for Seizure Prediction system showcases a strong competitive edge and resilient performance, obviating the necessity for specific patient-tailored engineering while maintaining the ethical integrity of system’s performance. The system exhibits great promise in substantially improving the functioning and quality of life for people living with epilepsy whilst playing a pivotal role in pushing forward the boundaries of seizure prediction mechanisms.},
 author = {Sofia, A. Sathya and Kalaiselvi, T and Kavi Priya, R S and Krupashini, S},
 booktitle = {2024 International Conference on Advances in Computing, Communication and Applied Informatics (ACCAI)},
