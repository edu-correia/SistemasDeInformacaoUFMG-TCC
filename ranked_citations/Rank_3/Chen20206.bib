@conference{Chen20206,
 abstract = {Power knowledge graph (PKG) plays an essential role in the electricity power field to integrate multi-source heterogeneous power data in a structural form. Recently, PKG is widely used for management and analysis of electric power big data. However, a single PKG can only provide limited power knowledge, which restricted its functions in downstream applications. In this paper, we merge multiple power knowledge graphs by aligning the entities which belong to different sources or languages respectively. To align entities, a Typed Graph Attention Network method is proposed to learn neighbor-level embedding through the weight of relation types in power knowledge graph. By incorporating structural information and relation type information simultaneously, the proposed method can accurately capture entity features in different Power knowledge graph. © 2020 IEEE.},
 author = {Chen, Yibo and Xiong, Fan and Wu, Feng and Xiang, Xing and Gao, Jun and Gao, Jianliang},
 doi = {10.1109/ICPDS51559.2020.9332479},
 journal = {2020 IEEE 2nd International Conference on Power Data Science, ICPDS 2020},
 note = {Cited by: 3},
 pages = {6 - 9},
 publication_stage = {Final},
 source = {Scopus},
 title = {Entity Alignment across Power Knowledge Graphs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85100888475?origin=resultslist},
 year = {2020}
}
