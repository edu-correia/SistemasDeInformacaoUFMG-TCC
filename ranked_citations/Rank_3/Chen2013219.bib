@conference{Chen2013219,
 abstract = {We introduce Euler/X, a toolkit for logic-based taxonomy integration. Given two taxonomies and a set of alignment constraints between them, Euler/X provides tools for detecting, explaining, and reconciling inconsistencies; finding all possible merges between (consistent) taxonomies; and visualizing merge results. Euler/X employs a number of different underlying reasoning systems, including first-order reasoners (Prover9 and Mace4), answer set programming (DLV and Potassco), and RCC reasoners (PyRCC8). We demonstrate the features of Euler/X and provide experimental results showing its feasibility on various synthetic and real-world examples. © Springer-Verlag Berlin Heidelberg 2011.},
 author = {Chen, Mingmin and Yu, Shizhuo and Franz, Nico and Bowers, Shawn and Ludäscher, Bertram},
 journal = {Technische Berichte des Instituts fur Informatik der Christian-Albrechts-Universitat zu Kiel},
 note = {Cited by: 0},
 number = {1306 REPORT NO.},
 pages = {219 - 224},
 publication_stage = {Final},
 source = {Scopus},
 title = {Euler/X: A toolkit for logic-based taxonomy integration},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84896658298?origin=resultslist},
 year = {2013}
}
