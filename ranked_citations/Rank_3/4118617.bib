@inproceedings{4118617,
 abstract = {Schema mapping is a challenging problem. It has come to the fore in recent years; there are important applications like database schema integration and, more recently, digital library merging of heterogeneous data. Previous studies have approached the schema mapping process either from algorithmic or visualization perspectives, with few integrating both. With Schema Mapper we demonstrate a semi-automatic tool for schema integration that combines a novel visual interface with an algorithm-based recommendation engine. Schemas are visualized as hyperbolic trees (see Fig. 1), thus allowing more schema nodes to be displayed at one time. Matches to selections are recommended to the user, which makes the mapping operation easier and faster.},
 author = {Shen, Rao and Rangarajan, Divya and Vemuri, Naga Srinivas and Fox, Edward A. and Goncalves, Marcos Andre and Fan, Weiguo and Raghavan, Ananth},
 booktitle = {Proceedings of the 5th ACM/IEEE-CS Joint Conference on Digital Libraries (JCDL '05)},
 doi = {10.1145/1065385.1065518},
 issn = {},
 keyword = {Software libraries;Prototypes;Data visualization;Laboratories;Computer science;Application software;Visual databases;Merging;Engines;History;XSLT style sheet;hyperbolic trees;schemas},
 month = {June},
 number = {},
 pages = {414-414},
 title = {Schema mapper: a visualization tool for DL integration},
 volume = {},
 year = {2005}
}
