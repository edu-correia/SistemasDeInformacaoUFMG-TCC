@conference{Brown201189,
 abstract = {Computing systems are becoming increasingly parallel and heterogeneous, and therefore new applications must be capable of exploiting parallelism in order to continue achieving high performance. However, targeting these emerging devices often requires using multiple disparate programming models and making decisions that can limit forward scalability. In previous work we proposed the use of domain-specific languages (DSLs) to provide high-level abstractions that enable transformations to high performance parallel code without degrading programmer productivity. In this paper we present a new end-to-end system for building, compiling, and executing DSL applications on parallel heterogeneous hardware, the Delite Compiler Framework and Runtime. The framework lifts embedded DSL applications to an intermediate representation (IR), performs generic, parallel, and domain-specific optimizations, and generates an execution graph that targets multiple heterogeneous hardware devices. Finally we present results comparing the performance of several machine learning applications written in OptiML, a DSL for machine learning that utilizes Delite, to C++ and MATLAB implementations. We find that the implicitly parallel OptiML applications achieve single-threaded performance comparable to C++ and outperform explicitly parallel MATLAB in nearly all cases. © 2011 IEEE.},
 author = {Brown, Kevin J. and Sujeeth, Arvind K. and Lee, Hyouk Joong and Rompf, Tiark and Chafi, Hassan and Odersky, Martin and Olukotun, Kunle},
 doi = {10.1109/PACT.2011.15},
 journal = {Parallel Architectures and Compilation Techniques - Conference Proceedings, PACT},
 note = {Cited by: 157},
 pages = {89 - 100},
 publication_stage = {Final},
 source = {Scopus},
 title = {A heterogeneous parallel framework for domain-specific languages},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84863015363?origin=resultslist},
 year = {2011}
}
