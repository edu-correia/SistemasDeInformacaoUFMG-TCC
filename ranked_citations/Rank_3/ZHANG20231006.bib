@article{ZHANG20231006,
 abstract = {Despite the rapid development of China's digital economy and many studies involving the development of digital economy, there is no unified standard on the measurement of digital economy, and the existing accounting methods all have certain shortcomings. In view of this, this paper constructs a set of accounting system to measure the scale of digital economy industry, from the perspective of digital industrialization and industrial digitization, based on input-output tables. We separate digital economy from traditional industries by splitting and merging IO tables using data such as the Economic Census Yearbook and SAT to calculate the scale of digital economy industry. In this paper, data from Beijing, Tianjin and Hebei provinces in 2017 were used as an example for the calculation. The accounting results show that there is still a large gap in digital economy industry development between Beijing, Tianjin and Hebei, with the total digital economy industry scale, industry digitization scale, digital industrialization scale and the proportion of digital economy value added to GDP in Beijing being much higher than those in Hebei and Tianjin. In addition, due to the characteristics of the respective industrial structures in Beijing, Tianjin and Hebei, the percentages of the four major categories in digital industrialization also show different performance. The share of digital technology application industry in Beijing is much higher than that in Tianjin and Hebei, while the share of digital product manufacturing in Hebei and Tianjin is high.},
 author = {Tianyu Zhang and Na Li},
 doi = {https://doi.org/10.1016/j.procs.2023.08.081},
 issn = {1877-0509},
 journal = {Procedia Computer Science},
 keyword = {Digital economy, Input-output table, Added value accounting, Digital transformation},
 note = {Tenth International Conference on Information Technology and Quantitative Management (ITQM 2023)},
 pages = {1006-1012},
 title = {Measuring digital economy: From the perspective of digital industrialization and industry digitalization},
 url = {https://www.sciencedirect.com/science/article/pii/S1877050923008396},
 volume = {221},
 year = {2023}
}
