@inproceedings{1412967,
 abstract = {We propose a scalable soft VLC decoder to significantly reduce the complexity. Generally, the soft VLC decoder needs to maintain many states for the correct decoding. Our approach reduces the complexity by reducing the table size. We reduce the table size by merging two symbols with the same prefix into one. Experimental results show that our proposed adaptive scheme can averagely save 15% of memory access compared with the state-of-the-art algorithms. Furthermore, our proposed scalable soft VLC decoder has more than 1 dB PSNR gain as compared with hard decoding.},
 author = {Tsu-Ming Liu and Sheng-Zen Wang and Wen-Hsiao Peng and Chen-Yi Lee},
 booktitle = {The 2004 IEEE Asia-Pacific Conference on Circuits and Systems, 2004. Proceedings.},
 doi = {10.1109/APCCAS.2004.1412967},
 issn = {},
 keyword = {Iterative decoding;Merging;PSNR;Additive white noise;AWGN;Maintenance engineering;Entropy;Video coding;Resilience;Sorting},
 month = {Dec},
 number = {},
 pages = {673-676 vol.2},
 title = {Memory efficient and low complexity scalable soft VLC decoding for the video transmission},
 volume = {2},
 year = {2004}
}
