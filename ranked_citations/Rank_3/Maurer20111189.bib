@conference{Maurer20111189,
 abstract = {Matrices are a popular method for modeling systems in complexity management. They support the accurate structural acquisition of information, andguarantee a machine readable state of data. However, with today's matrix representations, Boolean operators cannot be intuitively depicted without simplifying the system. In this paper, we present a new approach for modeling Boolean operators (AND, OR, XOR) in matrices. Boolean operators induce conditions between more than two nodes. Wherever a determination of a combination of nodes or edges is necessary, we place any of these paths in separate,superimposed matrices. The creation of instances of nodes in these superimposed matrices permits their belonging to different paths. For a better handling, this multidimensional matrix is flattened and the instances of nodes are placed side by side. In addition, we merge operators with their predecessor or successor-node, for a size-reduction and simplification of the matrix.© 2011 by Maik Maurer and Martin Strattner. Published and used by INCOSE with permission.},
 author = {Maurer, Maik and Strattner, Martin},
 journal = {21st Annual International Symposium of the International Council on Systems Engineering, INCOSE 2011},
 note = {Cited by: 3},
 pages = {1189 - 1202},
 publication_stage = {Final},
 source = {Scopus},
 title = {Using boolean operators in multiple-domain matrices},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84877890840?origin=resultslist},
 volume = {2},
 year = {2011}
}
