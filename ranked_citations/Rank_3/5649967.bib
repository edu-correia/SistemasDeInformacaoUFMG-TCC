@inproceedings{5649967,
 abstract = {In this paper we present a general framework for object detection and segmentation. Using a bottom-up unsupervised merging algorithm, a region-based hierarchy that represents the image at different resolution levels is created. Next, top-down, object class knowledge is used to select and combine regions from the hierarchy, in order to define the exact object shape. We illustrate the usefulness of the approach with four different object classes: sky, caption text, traffic signs and faces.},
 author = {Vilaplana, Veronica and Marques, Ferran and Leon, Miriam and Gasull, Antoni},
 booktitle = {2010 IEEE International Conference on Image Processing},
 doi = {10.1109/ICIP.2010.5649967},
 issn = {2381-8549},
 keyword = {Shape;Image color analysis;Image segmentation;Object detection;Merging;Computational modeling;Pixel;Object detection;Image segmentation;Image representations;Image region analysis},
 month = {Sep.},
 number = {},
 pages = {3933-3936},
 title = {Object detection and segmentation on a hierarchical region-based image representation},
 volume = {},
 year = {2010}
}
