@article{11052889,
 abstract = {We present BAG $3{++}$ , an extensible analog/mixed-signal (AMS) design framework for layout-aware design. BAG $3{++}$  realizes a unified design environment that merges schematic, layout, and verification views into a single development interface. We further introduce new automated design features that enable rapid automation and optimization across a range of performance specifications, processes, and applications. We demonstrate the practical use of these features through (a) a bit-reconfigurable successive-approximation-register (SAR) analog-to-digital converter (ADC) implemented in the open-source Skywater 130nm process and (b) an ultra-high speed output driver optimized in two modern processes. BAG $3{++}$  interfaces with both commercial and open-source design frameworks, and the extensibility of BAG $3{++}$  is further illustrated through the integration of an open-source simulator.},
 author = {Guo, Felicia and Zhou, Bob and Biswas, Ayan and Kwon, Paul and Liu, Zhaokai and Ho, Ken and Stojanović, Vladimir and Nikolić, Borivoje},
 doi = {10.1109/OJCAS.2024.3502641},
 issn = {2644-1225},
 journal = {IEEE Open Journal of Circuits and Systems},
 keyword = {Integrated circuit layout;Design automation;Automation;Layout;Circuits;Documentation;Extensibility;Generators;Open source hardware;Optimization;Registers;Analog mixed-signal (AMS) circuits;electronic design automation (EDA);high-speed serial link;integrated circuit layout;open-source hardware;SAR ADC},
 month = {},
 number = {},
 pages = {181-191},
 title = {BAG3++: An Extensible Generator Framework for Automated Layout-Aware AMS Design},
 volume = {6},
 year = {2025}
}
