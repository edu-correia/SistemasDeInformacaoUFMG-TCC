 publication_stage = {Final},
 source = {Scopus},
 title = {Adaptive Update Distribution Estimation under Probability Byzantine Attack},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85206826280?origin=resultslist},
 volume = {81},
 year = {2024}
}
