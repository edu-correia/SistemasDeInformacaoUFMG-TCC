 issn = {0169-2607},
 journal = {Computer Methods and Programs in Biomedicine},
 keyword = {Internet of things, Integrated platform, Smart healthcare, Health service facilitation, Ontological framework},
 pages = {106146},
 title = {Ontology Driven Smart Health Service Integration},
