@conference{Lin2016,
 abstract = {This paper presents a three dimensional (3D) gated clock tree synthesis (CTS) approach, which consists of two steps: 1) abstract tree topology generation; and 2) 3D gated and buffered clock routing. 3D Pair Matching (3D-PM) algorithm is proposed to generate the initial tree topology and then the proposed TSV-minimization algorithm is applied to generate TSV-aware tree topology. Based on TSV-aware tree topology, 3D gated and buffered clock tree routing is done using the proposed 3D Gated and Buffered Deferred-Merge Embedding (3D-GB-DME) algorithm. The slew constraint satisfaction is considered and the clock skew is minimized in our approach. Experimental results show that the proposed method achieves 29.11% power reduction compared with the state-of-the-art 2D work. © 2016 IEEE.},
 author = {Lin, Minghao and Sun, Heming and Kimura, Shinji},
 doi = {10.1109/VLSI-SoC.2016.7753535},
 journal = {2016 IFIP/IEEE International Conference on Very Large Scale Integration, VLSI-SoC 2016},
 note = {Cited by: 13},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Power-efficient and slew-aware three dimensional gated clock tree synthesis},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85006756960?origin=resultslist},
 year = {2016}
}
