@inproceedings{5473964,
 abstract = {In this paper, after introducing various Tracking approaches and techniques, we base our work on the physical tracking group management in Distributed Predictive Tracking (DPT) and geographical or regional one in Collaborative Signal Processing (CSP). Chosen as the best energy efficient tracking schemes, each with its own assumptions, we develop a new distributed hybrid tracking group approach by merging both techniques. Our new method consists of controlling the use of both approaches in different tracking steps, highlighting various and complementary advantages in order to merge them and extract an optimal energy efficient, hardware cost and accuracy. This new distributed approach yields the possibility to resolve either CSP problems, such as distributed leadership cell election in tracking detection step by including clustering structure, collaboration problems and whole cell nodes activation, or DPT problems such as border nodes permanent activation and target loss risks in other tracking steps.},
 author = {Benferhat, Djamel and Myoupo, Jean Frédéric},
 booktitle = {2010 Ninth International Conference on Networks},
 doi = {10.1109/ICN.2010.30},
 issn = {},
 keyword = {Energy efficiency;Target tracking;Wireless sensor networks;Signal processing algorithms;Collaborative work;Merging;Optimal control;Hardware;Cost function;Energy resolution},
 month = {April},
 number = {},
 pages = {127-132},
 title = {A Physical DPT and Regional CSP-Based Hybrid Algorithm for Energy Efficiency in Target Tracking in Wireless Sensor Networks},
 volume = {},
 year = {2010}
}
