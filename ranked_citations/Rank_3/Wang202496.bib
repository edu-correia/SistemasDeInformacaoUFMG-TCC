@conference{Wang202496,
 abstract = {The dimensional approach can represent more fine-grained emotional information than discrete affective states. In this paper, a pre-trained language model (PLM) with a joint learning strategy is proposed for the SIGHAN-2024 shared task on Chinese dimensional aspect-based sentiment analysis (dimABSA), which requires submitted models to provide fine-grained multi-dimensional (Valence and Arousal) intensity predictions for given aspects of a review. The proposed model consists of three parts: an input layer that concatenates both given aspect terms and input sentences; a Chinese PLM encoder that generates aspect-specific review representation; and separate linear predictors that jointly predict Valence and Arousal sentiment intensities. Moreover, we merge simplified and traditional Chinese training data for data augmentation. Our system ranked 2nd place out of 5 participants in subtask 1-intensity prediction. The code is publicly available at https://github.com/WZH5127/ 2024_subtask1_intensity_prediction. © 2024 Association for Computational Linguistics},
 author = {Wang, Zehui and Zhang, You and Wang, Jin and Xu, Dan and Zhang, Xuejie},
 journal = {SIGHAN 2024 - 10th SIGHAN Workshop on Chinese Language Processing, Proceedings of the Workshop},
 note = {Cited by: 4},
 pages = {96 - 101},
 publication_stage = {Final},
 source = {Scopus},
 title = {YNU-HPCC at SIGHAN-2024 dimABSA Task: Using PLMs with a Joint Learning Strategy for Dimensional Intensity Prediction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85204922252?origin=resultslist},
 year = {2024}
}
