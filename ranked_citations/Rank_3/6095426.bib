@inproceedings{6095426,
 abstract = {Each region in West Sumatra have leading commodities to be proud. The many types of commodities makes eminent domain ontology concepts that vary as well. Therefore it can be done to archive the various concepts of integration into ontology corresponding with each other. By using ontology alignment methods for mapping the ontology, can facilitate the organizing potential of leading commodities in West Sumatra. Ontology alignment provide a solution by creating a mapping commodity per region. Alignment is performed on the domain ontology commodity of West Sumatra Province which is the commodity data center by using ontology matching algorithms and the Protege tool. The result is a concept mapping of the potential of leading commodities per region or city in the province of West Sumatra are integrated.},
 author = {Munandar, Devi and Yuwana, Sandra},
 booktitle = {2011 6th International Conference on Telecommunication Systems, Services, and Applications (TSSA)},
 doi = {10.1109/TSSA.2011.6095426},
 issn = {},
 keyword = {Ontologies;Merging;Hafnium;Aquaculture;Cities and towns;Telecommunications;Ontology;mapping;leading commonities;ontology merging and alignment;protègè},
 month = {Oct},
