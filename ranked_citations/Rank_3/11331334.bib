@inproceedings{11331334,
 abstract = {Facial Beauty Prediction (FBP) is a challenging computer vision task due to the subjective and multi-faceted nature of human aesthetics. While deep learning models, particularly Convolutional Neural Networks (CNNs), have achieved significant success by learning from large datasets, they often operate as “black boxes,” treating images as holistic pixel grids and largely ignoring explicit facial geometry. This paper proposes GeoFusion-Net, a novel dual-branch hybrid architecture that explicitly models both visual appearance and geometric structure for more accurate and interpretable FBP. The visual branch, an EfficientNet-B0 backbone, extracts high-level texture and appearance features. The geometric branch, a Graph Attention Network (GAT), operates on a graph constructed from 86 facial landmarks, learning sophisticated relational features like symmetry and proportionality. These complementary feature streams are intelligently merged using an attention-based fusion mechanism that dynamically weighs their importance. We evaluate our model on the SCUT-FBP5500 dataset, demonstrating that GeoFusionNet significantly outperforms a strong CNN baseline across multiple metrics, achieving a Pearson Correlation of 0.9181. Our work highlights the substantial benefit of integrating explicit geometric reasoning into FBP models.},
 author = {Boukhari, Djamel Eddine and Kezai, Mourad},
 booktitle = {2025 International Conference on Intelligent Computer Systems, Data Science and Applications (IC2SDA)},
 doi = {10.1109/IC2SDA68097.2025.11331334},
 issn = {},
 keyword = {Deep learning;Measurement;Geometry;Visualization;Computer vision;Correlation;Computer architecture;Data science;Feature extraction;Convolutional neural networks;Facial beauty prediction;Convolutional Neural Network;Geometric Structure;Graph Attention Network;deep learning},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {GeoFusion-Net: A Hybrid Graph and Convolutional Network for Facial Beauty Prediction},
