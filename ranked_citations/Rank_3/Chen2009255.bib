@conference{Chen2009255,
 abstract = {With the advance of information technology, people could retrieve and manage their information more easily. However, the information users are still confused of information overloading problem. The recommendation system is designed based on personal preferences. It can recommend the fittest information to users, and it would help users to obtain information more conveniently and quickly. In our research, we design a recommendation system based on personal ontology and collaborative filtering technologies. Personal ontology is constructed by Formal Concept Analysis (FCA) algorithm and the collaborative filtering is design based on ontology similarity comparison among users. In order to evaluate the performance of our recommendation system, we have constructed a field experiment to study the users' satisfaction of our experiment system. The results show that, combing collaborative filtering technology with FCA in a recommendation system can get better users' satisfaction.},
 author = {Chen, Deng-Neng and Chiang, Yao-Chun},
 journal = {Information Systems in the Changing Era: Theory and Practice - Proceedings of the 11th International Conference on Informatics and Semiotics in Organisations, ICISO 2009},
 note = {Cited by: 1},
 pages = {255 - 262},
 publication_stage = {Final},
 source = {Scopus},
 title = {A document recommendation system based on collaborative filtering and personal ontology},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84903843891?origin=resultslist},
 year = {2009}
}
