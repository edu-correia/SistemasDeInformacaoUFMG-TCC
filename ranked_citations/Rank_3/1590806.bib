@inproceedings{1590806,
 abstract = {We present initial results for the self-consistent beam-cloud dynamics simulations for a sample LHC beam, using a newly developed set of modeling capability based on a merge [1] of the three-dimensional parallel Particle-In-Cell (PIC) accelerator code WARP [2] and the electron-cloud code POSINST [3]. Although the storage ring model we use as a test bed to contain the beam is much simpler and shorter than the LHC, its lattice elements are realistically modeled, as is the beam and the electron cloud dynamics. The simulated mechanisms for generation and absorption of the electrons at the walls are based on previously validated models available in POSINST [3, 4].},
 author = {Vay, J.-L. and Furman, M.A. and Cohen, R.H. and Friedman, A. and Grote, D.P.},
 booktitle = {Proceedings of the 2005 Particle Accelerator Conference},
 doi = {10.1109/PAC.2005.1590806},
 issn = {2152-9582},
 keyword = {Large Hadron Collider;Electron beams;Particle beams;Particle accelerators;Electron accelerators;Storage rings;Testing;Lattices;Clouds;Absorption},
 month = {May},
 number = {},
 pages = {1479-1481},
 title = {Initial Self-Consistent 3D Electron-Cloud Simulations of the LHC Beam with the Codewarp+Posinst},
 volume = {},
 year = {2005}
}
