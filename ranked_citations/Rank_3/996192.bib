@article{996192,
 abstract = {A far-reaching generalization of the finite-element method (FEM), the method of partition of unity on overlapping patches, is applied, as an illustrative example, to a waveguide problem. No structured FEM-like meshes are required; the patches can have arbitrary shapes, can overlap arbitrarily and each patch may have its own system of approximating functions reflecting the local behavior of the solution.},
 author = {Proekt, L. and Tsukerman, I.},
 doi = {10.1109/20.996192},
 issn = {1941-0069},
 journal = {IEEE Transactions on Magnetics},
 keyword = {Finite element methods;Least squares approximation;Shape;Electromagnetic waveguides;Waveguide components;Numerical models;Merging;Least squares methods;Computational electromagnetics;Approximation methods},
 month = {March},
 number = {2},
 pages = {741-744},
 title = {Method of overlapping patches for electromagnetic computation},
 volume = {38},
 year = {2002}
}
