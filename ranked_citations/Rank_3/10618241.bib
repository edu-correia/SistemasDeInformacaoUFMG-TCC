@inproceedings{10618241,
 abstract = {Land surface temperature (LST) has been playing a vital role in meteorology studies. The integration of satellite thermal infrared (TIR) and passive microwave (PMW) remote sensing observations provides a possibility to obtain moderate/high-resolution (e.g., 1 km)all-sky LST which has been an urgent necessity. However, due to difficulties in the integration, i.e., the PMW-TIR LST discrepancies in spatial scales and PMW data gap from the polar-orbited satellite, there is no official TIR-PMW integrated all-sky LST products at moderate/high spatial resolutions for merging Chinese satellite sensor observations. Under this context, with the help of machine-learning model, this study improves a former-developed physical method for merging the PMW-TIR observations and applies it to the Chinese FY-3C Microwave radiation imager (MWRI) data (10 km) and Visible and InfraRed Radiometer (VIRR) data (1 km) remote sensing data to generate 1-km all-sky gap-free LST over the Tibetan Plateau through a random forest model. Results show that the merged all-sky LST has a standard deviation of 1.12 K (0.86 K) at daytime (nighttime) when compared to the original VIRR LST and the two LST have high spatial consistency. Besides, the all-sky LST images have no block effect at the edge of the original low-resolution PMW pixels, demonstrating the good performance of the method estimating LST with a higher spatial resolution from lower-resolution PMW data. When validated against in-situ LSTs from ground stations with different land covers, the all-sky LST shows a root mean square error of 1.32 K–3.25 K. At the same time, there are barely different between the validation results under clear sky and cloudy sky conditions, thus indicating the good generalization ability of the method. This study would benefit the integration of satellite PMW-TIR remote sensing data and associated meteorological research and applications requiring all-sky LST at high spatial resolution on large scales.},
 author = {Zhang, Xiaodong and Zhang, Ruanyu and Wang, Pingkai and Dong, Kesong and Qu, Lingge and Jiang, Lifei},
 booktitle = {2024 Photonics & Electromagnetics Research Symposium (PIERS)},
 doi = {10.1109/PIERS62282.2024.10618241},
 issn = {2831-5804},
 keyword = {Temperature sensors;Satellite broadcasting;Land surface;Microwave theory and techniques;Land surface temperature;Microwave radiometry;Spatial resolution;Remote sensing;Microwave imaging;Meteorology},
 month = {April},
 number = {},
 pages = {1-7},
 title = {Estimation of 1-km All-sky Land Surface Temperature by Integration of Passive Microwave and Thermal Infrared Remote Sensing Data through Random Forest},
 volume = {},
 year = {2024}
}
