@article{YI2025100717,
 abstract = {Summary
Sensing and actuating play crucial roles in many applications that necessitate physical interactions with the environment. The comprehension and methodologies for integrating sensors and actuators continue to be focal points of active research. This review delves into the most recent advancements in the fundamental understanding and development of sensor-actuator integration, which encompasses a variety of strategies and mechanisms. Subsequently, parallel approaches are employed to discuss the physical mechanisms underlying the sensor-actuator integration alongside development strategies aimed at achieving high-precision sensor-actuator integration. Finally, the challenges associated with the achievement of sensor-actuator integration are addressed in requirements for high precision, rapid response, and high-degree integration.},
 author = {Zhiran Yi and Shoulu Gong and Fuyi Fang and Xiuxuan Li and Junfeng Zhou and Xingyu Wei and Xiaoyong Fang and Lei Shao and Wenming Zhang},
 doi = {https://doi.org/10.1016/j.device.2025.100717},
 issn = {2666-9986},
 journal = {Device},
 keyword = {sensor-actuator integration, natural intelligence, artificial intelligence, self-sensing, self-actuating},
 number = {4},
 pages = {100717},
 title = {Sensor-actuator integration for intelligent devices},
 url = {https://www.sciencedirect.com/science/article/pii/S2666998625000304},
 volume = {3},
 year = {2025}
}
