@article{Hung2006916,
 abstract = {Mining association rules between sets of items in a large database has been widely investigated. In this paper we propose a different approach with three data preprocess methods to group transactions in a database and devise an efficient algorithm to mine association rules from the merged transactions with better performance. The first data preprocess method sorts transactions to classify the groups. The other two approaches use a simplified dynamic programming algorithm to merge transactions. Compared with other algorithms our mining method performs much better with less I/O overhead. The results of our experiment show that it only requires one scan of the database after preprocess to generate association rules. In addition, our method is especially suitable for very large databases.},
 author = {Hung, Ming-Chuan and Weng, Shi-Qin and Wu, Jungpin and Yang, Don-Lin},
 journal = {WSEAS Transactions on Computers},
 note = {Cited by: 9},
 number = {5},
 pages = {916 - 923},
 publication_stage = {Final},
 source = {Scopus},
 title = {Efficient mining of association rules using merged transactions approach},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33744544406?origin=resultslist},
 volume = {5},
 year = {2006}
}
