@conference{Leclercq20141129,
 abstract = {This paper focuses on the derivation of analytical formulae to estimate the effective capacity at freeway merges. It extends previous works by proposing a generic framework able to account for a refined description of the physical interactions between upstream waves and downstream voids created by inserting vehicles within the merge area. The provided analytical formulae permits to directly and accurately compute the capacity values when the merge is self-active, i.e. when both upstream roads are congested while downstream traffic conditions are free-flow. © 2014 IEEE.},
 author = {Leclercq, Ludovic and Knoop, Victor L. and Marczak, Florian and Hoogendoorn, Serge P.},
 doi = {10.1109/ITSC.2014.6957839},
 journal = {2014 17th IEEE International Conference on Intelligent Transportation Systems, ITSC 2014},
 note = {Cited by: 3},
 pages = {1129 - 1134},
 publication_stage = {Final},
 source = {Scopus},
 title = {Capacity drops at merges: New analytical investigations},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84926439477?origin=resultslist},
 year = {2014}
}
