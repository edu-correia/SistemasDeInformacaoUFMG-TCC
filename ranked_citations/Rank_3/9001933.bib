@inproceedings{9001933,
 abstract = {This paper presents a novel rhombus-shaped patch antenna with right angled isosceles triangle fractal. This antenna resembles a diamond shape by etching and merging with the square slot, apart from being fed by a coplanar waveguide structure. This antenna has a compact size, measuring 40mm x 65mm x 1.6mm. The final prototype antenna resonates at 4.66GHz, 6.12GHz, 8GHz and 8.88GHz with 150MHz, 360MHz, 300MHz and 220MHz bandwidths, respectively. The antenna has stable omni-directional E-plane radiation patterns at their operating bands. The proposed antenna is suitable in cases, where in C-band and X-bands are applied. The experimental result shows that the proposed antenna exhibits a good impedance matching. The final Asymmetrical coplanar strip (ACS) feed design provides an impedance bandwidth of 1.47-1.61GHz, 6.14-6.38GHz,7.37-8.12GHz, 8.59-9.01GHz and 9.38-9.59GHz for L-,C- & X-bands, respectively, thereby maintaining stable gain characteristics at frequency bands.},
 author = {CHINTAPANTI, MURALI KRISHNA and KANTH VARMA PENMATSA, KRISHNA},
 booktitle = {2018 4th International Conference on Applied and Theoretical Computing and Communication Technology (iCATccT)},
 doi = {10.1109/iCATccT44854.2018.9001933},
 issn = {},
 keyword = {Slot antennas;Broadband antennas;Microwave antennas;Coplanar waveguides;Antenna measurements;Microstrip antennas;Rhombus shape patch;Right angled isosceles triangle;Line feed;CPW-feed;ACS- feed;Multiband.},
 month = {Sep.},
 number = {},
 pages = {213-217},
 title = {A 50Ω CPW-FED Rhombus Shaped Patch Antenna Using Rightangled Isosceles Triangle Fractal},
 volume = {},
 year = {2018}
}
