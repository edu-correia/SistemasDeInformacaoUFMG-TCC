@article{Jayavel2012602,
 abstract = {Voice mail service has been around since a lot of time, but it hasn't been universally implemented and with the Internet and Mobile Computing as the new platforms everywhere, we decided to merge this service with and come up with a platform independent, globally accessible voice mail platform. The end result was a voice mail service, which is cross platform, with centralized code, secure and which can be deployed to multiple platforms rapidly. The service can be developed into a proper market ready product, supporting voice data transfer between all major smartphone platforms and also made available on the web by deployed it on any popular cloud service like the Windows Azure or Amazon EC2 Cloud Services. © EuroJournals Publishing, Inc. 2012.},
 author = {Jayavel, Senthil and Merchant, Shoaib and Maniyar, Akshay},
 journal = {European Journal of Scientific Research},
 note = {Cited by: 0},
