@inproceedings{1517185,
 abstract = {In this paper, a new design of dual-band filter realized by distribution circuits is presented. Open stubs in parallel are used as the resonators to fulfil the dual-band characteristics. A structure of dual-band inverters is also proposed, which can be easily merged with adjacent resonators. The design procedures are discussed in detail and verified by experiment results.},
 author = {Hong-Ming Lee and Chih-Ming Tsai and Chin-Chuan Tsai},
