@conference{Shankaranarayanan2008,
 abstract = {Though cognizant of the negative impact of poor quality data on the decision process, organizations are still producing, processing, and storing large volumes of imperfect data every day. One effective way of addressing the data quality (DQ) issue is to inform decision makers of the quality of the data they are using. However, providing metadata on data quality, DQ metadata, can additionally burden the processing capacity of decision makers and may negatively affect the decision performance. This study investigates how the extra work load introduced by incorporating DQ metadata affects decision performance in structured decision tasks. The empirical study illustrates that there is a significant interaction between variations in task complexity and decision-making experience. The results suggest that such interactions have important implications for decision performance when DQ metadata is provided for decision support.},
 author = {Shankaranarayanan, G. and Zhu, Bin and Cai, Yu},
 journal = {Proceedings of the 2008 International Conference on Information Quality, ICIQ 2008},
 note = {Cited by: 4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Decision support with data quality metadata},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84871602631?origin=resultslist},
 year = {2008}
}
