@article{Wang2007964,
 abstract = {A novel method is proposed for automatic region-of-interest (ROI) extraction in JPEG2000 coding by using morphology segmentation and analyzing the content of LL<sub>n</sub> subband image. During the JPEG2000 encoding procedure, morphologic filter group is implemented on the wavelet LL<sub>n</sub> subband image and the watershed algorithm is applied to divide it into many closed regions rapidly following the discrete wavelet transform. Afterward, certain local texture features of regions are extracted to merge the little regions and then the regions location features are employed to determine the ROI of the LL<sub>n</sub> image and figure out the LL<sub>n</sub> ROI template. Finally the entire ROI template of wavelet image is formed by the LL<sub>n</sub> ROI template according to the discrete wavelet transform (DWT) structure and the coordinate mapping principle. This method realizes the automatic JPEG2000 ROI coding based on the content of image. The experiment results have proven its feasibility and validity. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Wang, Fei and Zheng, Nanning and Liu, Yuehu},
 doi = {10.1007/978-3-540-74282-1_108},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 0},
 pages = {964 - 972},
 publication_stage = {Final},
 source = {Scopus},
 title = {Automatic region-of-interest coding in JPEG2000 based on morphology segmentation and LLn subband analysis},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84985023392?origin=resultslist},
 volume = {2},
 year = {2007}
}
