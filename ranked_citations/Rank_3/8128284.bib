@inproceedings{8128284,
 abstract = {The Advanced Microwave Scanning Radiometer 2 (AMSR2) is part of the Global Change Observation Mission-Water (GCOM-W) mission. AMSR2 fills the void left by the loss of the Advanced Microwave Scanning Radiometer-Earth Observing System (AMSR-E) after almost 10 years. Both missions provide brightness temperature observations that are used to retrieve soil moisture. Merging AMSR-E and AMSR2 will help build a consistent long-term dataset. Before tackling the integration of AMSR-E and AMSR2 it is necessary to conduct a thorough validation and assessment of the AMSR2 soil moisture products. This study focuses on validation of the AMSR2 soil moisture products by comparison with in situ reference data from a set of core validation sites. Three products that rely on different algorithms were evaluated; the JAXA Soil Moisture Algorithm (JAXA), the Land Parameter Retrieval Model (LPRM), and the Single Channel Algorithm (SCA). Results indicate that overall the SCA has the best performance based upon the metrics considered.},
 author = {Bindlish, R. and Jackson, T. and Cosh, M. and Koike, T. and Fuiji, X. and de Jeu, R. and Chan, S. and Asanuma, J. and Berg, A. and Bosch, D. and Caldwell, T. and Collins, C. Holyfield and McNairn, H. and Martínez-Fernández, J. and Prueger, J. and Seyfried, M. and Starks, P. and Su, Z. and Thibeault, M. and Walker, J.},
 booktitle = {2017 IEEE International Geoscience and Remote Sensing Symposium (IGARSS)},
 doi = {10.1109/IGARSS.2017.8128284},
 issn = {2153-7003},
 keyword = {Meteorology;Soil moisture;AMSR2;validation},
 month = {July},
 number = {},
 pages = {5637-5640},
 title = {AMSR2 soil moisture product validation},
