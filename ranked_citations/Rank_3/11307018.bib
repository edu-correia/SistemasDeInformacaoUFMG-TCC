@inproceedings{11307018,
 abstract = {To explore the quantitative relationship between formative and summative assessment, this study constructed a regression model with interaction terms using assessment data from 131 students in the Data Mining course. In this model, Assignment, Check-in, and Bonus Points were treated as numerical variables, while Quiz and Discussion/Group Task (merged into a dummy variable $D / G$) were set as dummy variables. We then implemented stepwise regression analysis using the $\text{lm}()$ and step() functions in $\mathbf{R}$ (version 4.4.2) for model optimization. The results showed that Assignment and Check-in were significantly positively correlated with Summative Assessment. After introducing dummy variables and interaction terms, the explanatory power of the model significantly improved ($\boldsymbol{R}^{\mathbf{2}}$ increased from 0.1408 to 0.4798). The dummy variable Quiz was significantly negatively correlated with Summative Assessment (Coefficient $=-48.4187, t=-4.0202, p <0.01$), but its interaction effect with Bonus Points was significantly positive (Coefficient $=0.3256, t=2.1210, p<0.05$), indicating a high dependency between Quiz and students' classroom participation. Although the main effect of $D / G$ was not significant, its interaction effect with Bonus Points was significantly positive (Coefficient $=0.6099, t=3.6993, p<0.01$), and its interaction effect with Assignment was significantly negative (Coefficient $=-0.2961, t=-2.0534, p<0.05$), revealing complex interdependencies and substitution relationships among different formative assessment items. The findings of this study indicate that it is insufficient to evaluate the effectiveness of a single assessment method in isolation, and assessment design must be optimized from a perspective of systematic integration. This study provides empirical evidence for optimizing curriculum evaluation systems using data-driven methods. (Abstract)},
 author = {Luo, Xiaoqing},
 booktitle = {2025 6th International Conference on Modern Education and Information Management (ICMEIM)},
 doi = {10.1109/ICMEIM66684.2025.11307018},
 issn = {},
 keyword = {Analytical models;Systematics;Education;Data models;Numerical models;Regression analysis;Information management;Data mining;Optimization;formative assessment;summative assessment;data mining;regression analysis;dummy variable (key words)},
