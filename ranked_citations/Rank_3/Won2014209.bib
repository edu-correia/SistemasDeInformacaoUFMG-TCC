@article{Won2014209,
 abstract = {Ontology mediation enables the interoperability of heterogeneous semantic data sources. Ontology mediation includes operations such as, mapping, alignment, matching, merging and integration. Formal Concept Analysis (FCA) is a machine learning technique which represents some association between the merged concepts. This paper proposes ontology mediation approach using FCA techniques. FCA has the capability of deriving a concept hierarchy or formal ontology from a collection of objects and properties. Thus, FCA can discover and position new concepts in the merged ontology. Ontology mediation includes ontology mapping, ontology alignment and ontology merging. The proposed model is implemented using an example ontology case. © 2014 ICIC International.},
 author = {Won, Seok Yeon and Lee, Haekyung and Kim, Taioun},
 journal = {ICIC Express Letters, Part B: Applications},
 note = {Cited by: 0},
 number = {1},
 pages = {209 - 214},
 publication_stage = {Final},
 source = {Scopus},
 title = {Ontology mediation approach using formal concept analysis},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84893194882?origin=resultslist},
 volume = {5},
 year = {2014}
}
