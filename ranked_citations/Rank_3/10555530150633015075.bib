@article{10.5555/3015063.3015075,
 abstract = {Southern Utah University is currently trying something new with their General Education (GE) curriculum. They are integrating all GE courses together into what they call JumpStart. JumpStart sections teach students GE curriculum by integrating course content under broad topics of interest. This paper describes this new approach to GE and how computer application curriculum can be integrated into the broad topics selected for the JumpStart sections during fall 2016.},
 address = {Evansville, IN, USA},
 author = {Barker, Nathan and Harris, Laurie},
 issn = {1937-4771},
 issue_date = {December 2016},
 journal = {J. Comput. Sci. Coll.},
 month = {December},
 number = {2},
 numpages = {6},
 pages = {77–82},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Adding computer application curriculum into a fully integrated general education experience},
 volume = {32},
 year = {2016}
}
