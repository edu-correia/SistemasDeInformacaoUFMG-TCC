@inproceedings{7986815,
 abstract = {This paper proposes a simple automatic 3D ear reconstruction method using a video selfie while having no knowledge about the scene. First we use the EXIF data stored within the images to estimate the intrinsic matrix. Then, standard structure from motion techniques are applied to obtain a reconstruction for every couple of images which will be merged into one reconstruction that represents the whole scene using an original procedure. Finally, the quasi-dense model is obtained by using the ASIFT and ZNCC descriptors. Our approach is simple to implement and only requires the use of a smart-phone camera. Also, the experimental results showed that this approach is very promising compared to the other methods used to solve this problem.},
 author = {Kabbour, Salah Eddine and Richard, Pierre-Yves},
 booktitle = {2017 Fifteenth IAPR International Conference on Machine Vision Applications (MVA)},
 doi = {10.23919/MVA.2017.7986815},
 issn = {},
 keyword = {Three-dimensional displays;Cameras;Ear;Solid modeling;Image reconstruction;Merging;Feature extraction},
 month = {May},
 number = {},
 pages = {117-120},
 title = {Human ear structure from motion},
 volume = {},
 year = {2017}
}
