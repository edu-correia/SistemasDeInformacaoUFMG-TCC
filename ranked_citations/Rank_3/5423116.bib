@inproceedings{5423116,
 abstract = {In this paper, we present a methodology for merging geographic ontologies. The entry point of the proposed methodology is two geographical ontologies, it consists of three phases. The first phase is to establish a process of matching candidate ontologies. The outcome of this phase is a list of matching functions. The second phase is to find correspondences between concepts of candidate ontologies. The outcome of this phase is two lists: a list of matches and a list of unrelated concepts. The third phase is merging. The merging process is based on rules and produces as result a global ontology spatially and semantically richer.},
 author = {Châabane, Sana and Jaziri, Wassim and Gargouri, Faïez},
 booktitle = {2009 International Conference on the Current Trends in Information Technology (CTIT)},
 doi = {10.1109/CTIT.2009.5423116},
 issn = {2377-5335},
 keyword = {Proposals;Ontologies;Merging;Laboratories;Assembly;Spatial databases;Knowledge based systems;geographic ontology;merging;matching;mapping;identity relationship;enrichment relationship},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {A proposal for a geographic ontology merging methodology},
 volume = {},
 year = {2009}
}
