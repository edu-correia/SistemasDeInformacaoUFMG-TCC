@article{10356842,
 abstract = {K-Means algorithm is a popular clustering method. However, it has two limitations: 1) it gets stuck easily in spurious local minima, and 2) the number of clusters $k$k has to be given a priori. To solve these two issues, a multi-prototypes convex merging based K-Means clustering algorithm (MCKM) is presented. First, based on the structure of the spurious local minima of the K-Means problem, a multi-prototypes sampling (MPS) is designed to select the appropriate number of multi-prototypes for data with arbitrary shapes. Then, a merging technique, called convex merging (CM), merges the multi-prototypes to get a better local minima without $k$k being given a priori. Specifically, CM can obtain the optimal merging and estimate the correct $k$k. By integrating these two techniques with K-Means algorithm, the proposed MCKM is an efficient and explainable clustering algorithm for escaping the undesirable local minima of K-Means problem without given $k$k first. Two theoretical proofs are given to guarantee that the cost of MCKM (MPS+CM) can achieve a constant factor approximation to the optimal cost of the K-Means problem. Experimental results performed on synthetic and real-world data sets have verified the effectiveness of the proposed algorithm.},
 author = {Li, Dong and Zhou, Shuisheng and Zeng, Tieyong and Chan, Raymond H.},
 doi = {10.1109/TKDE.2023.3342209},
 issn = {1558-2191},
 journal = {IEEE Transactions on Knowledge and Data Engineering},
 keyword = {Clustering algorithms;Prototypes;Merging;Partitioning algorithms;Approximation algorithms;Costs;Shape;Convex merging;K-means;multi-prototypes;multi-prototypes sampling},
 month = {Nov},
 number = {11},
 pages = {6653-6666},
 title = {Multi-Prototypes Convex Merging Based K-Means Clustering Algorithm},
 volume = {36},
 year = {2024}
}
