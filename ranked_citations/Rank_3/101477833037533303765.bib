@article{10.14778/3303753.3303765,
 abstract = {Data storage in the Cloud needs to be scalable and fault-tolerant. Atomic commitment protocols such as Two Phase Commit (2PC) provide ACID guarantees for transactional access to sharded data and help in achieving scalability. Whereas consensus protocols such as Paxos consistently replicate data across different servers and provide fault tolerance. Cloud based datacenters today typically treat the problems of scalability and fault-tolerance disjointedly. In this work, we propose a unification of these two different paradigms into one framework called Consensus and Commitment (C&amp;C) framework. The C&amp;C framework can model existing and well known data management protocols as well as propose new ones. We demonstrate the advantages of the C&amp;C framework by developing a new atomic commitment protocol, Paxos Atomic Commit (PAC), which integrates commitment with recovery in a Paxos-like manner. We also instantiate commit protocols from the C&amp;C framework catered to different Cloud data management techniques. In particular, we propose a novel protocol, Generalized PAC (G-PAC) that integrates atomic commitment and fault tolerance in a cloud paradigm involving both sharding and replication of data. We compare the performance of G-PAC with a Spanner-like protocol, where 2PC is used at the logical data level and Paxos is used for consistent replication of logical data. The experimental results highlight the benefits of combining consensus along with commitment into a single integrated protocol.},
 author = {Maiyya, Sujaya and Nawab, Faisal and Agrawal, Divyakant and Abbadi, Amr El},
 doi = {10.14778/3303753.3303765},
 issn = {2150-8097},
 issue_date = {January 2019},
 journal = {Proc. VLDB Endow.},
 month = {January},
 number = {5},
 numpages = {13},
 pages = {611–623},
 publisher = {VLDB Endowment},
 title = {Unifying consensus and atomic commitment for effective cloud data management},
 url = {https://doi.org/10.14778/3303753.3303765},
 volume = {12},
 year = {2019}
}
