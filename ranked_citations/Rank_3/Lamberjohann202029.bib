@conference{Lamberjohann202029,
 abstract = {The term ecosystem experiences a peak in academic attention, however, its usage varies as well as its application in certain industries. In the world of logistics, the usage of the term ecosystem is not common within academia. Hence, a systematic literature review has been performed by scanning 146 studies out of an original dataset of 2264 results. This systematic literature review has got the goal to create a methodological overview of the term ecosystem, create types of ecosystems, and merge them with similar studies out of the supply chain management research area. Finally, this paper identifies a commonality that justifies a merge of supply chain management collaboration approaches and the general research of ecosystems and sets a foundation for future research. © Interconnected Supply Chains in an Era of Innovation - Proceedings of the 8th International Conference on Information Systems, Logistics and Supply Chain, ILS 2020. All rights reserved.},
 author = {Lamberjohann, Marvin and Otto, Boris},
 journal = {Interconnected Supply Chains in an Era of Innovation - Proceedings of the 8th International Conference on Information Systems, Logistics and Supply Chain, ILS 2020},
 note = {Cited by: 2},
 pages = {29 - 36},
 publication_stage = {Final},
 source = {Scopus},
 title = {A systematic literature review of ecosystems: An approach to introduce logistics ecosystems into academia},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85085925776?origin=resultslist},
 year = {2020}
}
