@inproceedings{11369584,
 abstract = {Changes in modular structure between software versions can be an early indicator of architectural erosion that affects system maintainability and evolution. This study analyzes JEdit and Dom4J across versions using Attention-Driven Graph Clustering Network (AGCN) with a pre-trained autoencoder to generate informative latent class representations. Baseline clusters were obtained through K-means on autoencoder representations, then AGCN was used to detect modular drift in the form of class movement, merging, or separation between versions. Evaluation was performed relative to the baseline to assess clustering consistency between versions. The results showed that the majority of classes retained their original clusters, with only a small portion of classes experiencing drift, and autoencoder pre-training was proven to improve clustering consistency. This approach contributes to the understanding of modular evolution, supporting refactoring, documentation, and the identification of potential architecture degradation.},
 author = {Puspita, Delastrada Dian and Tendean, Sandi},
 booktitle = {2025 15th International Conference on Information & Communication Technology and System (ICTS)},
 doi = {10.1109/ICTS67612.2025.11369584},
 issn = {2996-1378},
 keyword = {Software architecture;Autoencoders;Merging;Documentation;Software;Stability analysis;Software reliability;Maintenance;Information and communication technology;Erosion;modular drift detection;Attention-Driven Graph Clustering Network;autoencoder;architecture evolution;object-oriented software},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Modular Drift Analysis in Object-Oriented Software: A Graph-based Clustering Approach},
 volume = {},
 year = {2025}
}
