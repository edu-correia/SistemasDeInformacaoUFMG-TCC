@inproceedings{11346215,
 abstract = {For ecological research, conservation, and biodiversity monitoring, accurate bird species identification is essential. However, when species exhibit similar visual characteristics or overlapping sound patterns, manual identification is slow, dependent on knowledge, and frequently wrong. In order to overcome these constraints, this research presents an improved Automated Bird Species Recognition Framework that uses Transformer-based encoders to combine aural and visual data. While an Audio Spectrogram Transformer (AST) analyzes the temporal-spectral aspects of bird sounds, a Vision Transformer (ViT) extracts fine-grained visual data.The suggested approach uses a Cross-Attention Multi-Modal Fusion Transformer (CAMFT), which allows bidirectional interaction between visual and audio embeddings, to enhance traditional multimodal fusion. By aligning complementary cues across modalities, this crossattention mechanism creates a more reliable and discriminative classification representation. CAMFT provides a scalable, interpretable, and high-accuracy solution for automated bird species detection in real-world ecological situations. Experimental results on benchmark datasets demonstrate that CAMFT greatly outperforms singlemodality baselines and basic fusion techniques.},
 author = {Sarumathi, S. and Gokila, R and Maghaaswanth, M S},
 booktitle = {2025 10th International Conference on Smart Structures and Systems (ICSSS)},
 doi = {10.1109/ICSSS66939.2025.11346215},
 issn = {},
 keyword = {Visualization;Computer vision;Merging;Transformers;Birds;Robustness;Biodiversity;Usability;Monitoring;Spectrogram;Bird Species Recognition;Vision Transformer (ViT);Audio Spectrogram Transformer (AST);Cross-Attention Fusion;Multi-Modal Learning;Transformer Architectures;Biodiversity Monitoring},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {Automated Bird Species Recognition with Transformer Architectures},
