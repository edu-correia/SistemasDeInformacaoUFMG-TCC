@article{7977915,
 abstract = {A vehicular ad hoc network (VANET) is a special network for vehicle-to-vehicle communication. The proper medium access control (MAC) protocol based on time division multiple access (TDMA) is the key to realizing efficient vehicle-to-vehicle communication. In a VANET, when two or more nodes occupy the same time slot and drive into each other's communication ranges, a reservation collision occurs, and all of the colliding nodes release their slots. This paper presents a game-based TDMA MAC protocol (GAH-MAC) to solve this problem. In this protocol, when a reservation collision occurs, the colliding nodes will play games with each other to decide whether to reserve the original slot or a new one. In this way, the time slots can be fully used, and the reservation speeds can be increased without being controlled by the base stations. The simulation results show that the performance of GAH-MAC is superior in high-density networks, raising the success rate of reservations and increasing network throughput.},
 author = {Tianjiao, Zhang and Qi, Zhu},
 doi = {10.1109/JCN.2017.000038},
 issn = {1976-5541},
 journal = {Journal of Communications and Networks},
 keyword = {Media Access Protocol;Vehicular ad hoc networks;Time division multiple access;Throughput;Game theory;Merging;Game theory;medium access control (MAC) protocol;time division multiple access (TDMA);time slot allocation;vehicular ad hoc network (VANET)},
 month = {},
 number = {3},
 pages = {209-217},
 title = {Game-based TDMA MAC protocol for vehicular network},
 volume = {19},
 year = {2017}
}
