@conference{Torbati2008805,
 abstract = {In this paper we propose a new combinational criterion as a mean for comparison between different LDPC codes in terms of complexity and efficiency. The main idea behind the proposed criterion is to merge different aspects of a code to a unique number. We will show that the new criterion, named "Goodness Number" or GN, is applicable, and in some circumstances it is preferred to other criteria such as complexity and error probability criteria and at the same time it maintains computational simplicity. © 2008 IEEE.},
 author = {Torbati, Amir Hosein Harati Nejad and Attari, Mahmoud Ahmadian and Moosavinia, Amir},
 doi = {10.1109/CCECE.2008.4564647},
 journal = {Canadian Conference on Electrical and Computer Engineering},
 note = {Cited by: 0},
 pages = {805 - 808},
 publication_stage = {Final},
 source = {Scopus},
 title = {A new criterion to compare different LDPC codes for hardware implementation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/51849103446?origin=resultslist},
 year = {2008}
}
