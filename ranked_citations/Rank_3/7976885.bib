@inproceedings{7976885,
 abstract = {Fourier transformation infrared spectroscopy has been used widely for understanding the structure and organization of membranes. The data obtained from FTIR spectroscopy will be huge and preprocessing of the data is an essential step. For accomplishing this task, we need to depend on various software which are not open source. Also the data processing will be time consuming and rigorous. This paper discusses a novel approach for analysis of multiple FTIR spectra. This paper discusses our tool developed Using MATLAB Image processing tool box functions for analyzing the multiple FTIR spectroscopy's.},
 author = {Kancharla, Ravichand and Karpurapu, Shanthi and Kumar, Vadeghar Ramesh and Reddy, Ginuga Prabhaker},
 booktitle = {2017 IEEE 7th International Advance Computing Conference (IACC)},
 doi = {10.1109/IACC.2017.0151},
 issn = {2473-3571},
 keyword = {Spectroscopy;Arrays;MATLAB;Biomembranes;Tools;Merging;FTIR;Membrane structure;Image Processing tool},
 month = {Jan},
 number = {},
 pages = {728-731},
 title = {A Novel Approach for Analysis of FTIR Membrane Spectroscopy},
 volume = {},
 year = {2017}
}
