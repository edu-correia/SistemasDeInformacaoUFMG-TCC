@conference{Zhou20242540,
 abstract = {We propose an approach to fuse multiresolution seismic tomography models with physics-informed probability graphical models (PIPGMs), which consider the physical information (ray-path density). To evaluate the efficacy of the PIPGM fusion method, we use both synthetic checkerboard models and real fault zone structures imaged from 2019 Ridgecrest, CA, earthquake sequence. The proposed method improves the combined models in terms of travel time residual, image quality, and peak signal-to-noise ratio, compared to those obtained by multiple conventional methods. The proposed fusion method can merge any type of gridded multi-resolution velocity model, a valuable tool for computational imaging. © 2024 IEEE.},
 author = {Zhou, Zheng and Gerstoft, Peter and Olsen, Kim},
 doi = {10.1109/ICASSP48485.2024.10446172},
 journal = {ICASSP, IEEE International Conference on Acoustics, Speech and Signal Processing - Proceedings},
 note = {Cited by: 1},
 pages = {2540 - 2544},
 publication_stage = {Final},
 source = {Scopus},
 title = {FUSION OF MULTI-RESOLUTION SEISMIC TOMOGRAPHY MAPS WITH PHYSICS-INFORMED PROBABILITY GRAPHICAL MODELS},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85195428914?origin=resultslist},
 year = {2024}
}
