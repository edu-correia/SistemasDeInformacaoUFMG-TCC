@inproceedings{8126429,
 abstract = {In this paper, a low-cost accelerator for the ηT pairing in characteristic three over the super-singular elliptic curves is designed. As the critical operations of ηT pairing, the cubing and sparse multiplications over GF(36m) in the Miller's algorithm are merged and their arithmetic are modified and scheduled to reduce the intermediate data related overhead. With these optimizations, the Miller's loop is implemented by a structure that has simpler arithmetic units, less registers compared with the conventional designs. The area-time products of our design are decreased by 57.6% and 53% compared with the state-of-the-art FPGA and ASIC accelerators respectively.},
 author = {Wang, Xusheng and Li, Xiangyu},
 booktitle = {2017 International Conference on Electron Devices and Solid-State Circuits (EDSSC)},
 doi = {10.1109/EDSSC.2017.8126429},
 issn = {},
 keyword = {Field programmable gate arrays;Hardware;Registers;Clocks;Galois fields;Algorithm design and analysis;Optimization;Bilinear Pairing;GF(3m);IBE;Low cost},
 month = {Oct},
 number = {},
 pages = {1-2},
 title = {A 0.3mm2 280MHz GF(3m) ηT pairing accelerator for lightweight system},
 volume = {},
 year = {2017}
}
