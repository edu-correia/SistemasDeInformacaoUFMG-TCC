@article{ADDAY2025107713,
 abstract = {Organic pollutants-contained wastewater represents a concerning array of poisonous chemicals that presuppose suitable treatment and elimination to safeguard human health and the environment. Neoteric self-cleaning polyvinylidene fluoride (18 wt% PVDF) ultrafiltration membranes were successfully developed by the Ag2O@CRA heterojunctions photocatalyst responsive to visible light irradiation. The PVDF/Ag2O@CRA photocatalytic membranes were made with 0.1–0.5 wt% of the Ag2O@CRA photocatalyst. The performance of the PVDF/Ag2O@CRA photocatalytic membranes was examined in the removal of methylene blue dye. The superior compatibility of the Ag2O@CRA photocatalyst with PVDF in the casting solution resulted in upgrading the antifouling properties, morphology, structure, porosity, pure water flux, and separation performance of the embedded membranes. The synergistic effect of molecular separation and photodegradation for the PVDF membrane containing 0.3 wt% Ag2O@CRA photocatalyst produced a relatively high pure water flux of 109.05 L/m2.h and removed 99.05 % of methylene blue dye and 99 % of chemical oxygen demand at an initial dye concentration of 10 mg/L, a treated solution volume of 1000 mL, feed flowrate of 1 L/min, an initial pH of 10, transmembrane pressure of 1 bar during 90 min. The scavenger investigation revealed that •OH radical was the dominant species responsible for methylene blue photodegradation. Therefore, shifting interest towards merging the photocatalysis process with membrane technology is a prospective approach towards the complete elimination of harmful organics, minimizing the consequences of membrane fouling, prolonging membrane lifespan, and maintaining high standards of water quality.},
 author = {Abdelmoneim S. Adday and Sama M. Al-Jubouri},
 doi = {https://doi.org/10.1016/j.jwpe.2025.107713},
 issn = {2214-7144},
 journal = {Journal of Water Process Engineering},
 keyword = {Polyvinylidene fluoride, Photocatalytic membranes, Heterojunctions photocatalyst, Photocatalytic degradation, Methylene blue, Organic pollutants},
 pages = {107713},
 title = {Developing a versatile visible-light-driven polyvinylidene fluoride/Ag2O@CRA photocatalytic membrane for efficient treatment of organic pollutants-contained wastewater},
 url = {https://www.sciencedirect.com/science/article/pii/S2214714425007858},
 volume = {73},
 year = {2025}
}
