@conference{Sangiacomo2010444,
 abstract = {Information Retrieval is a well established interdisciplinary topic in which machine learning, computational linguistic, computer programming and data mining merge together. SLAIR stands for SeaLab Advanced Information Retrieval and is an efficient software architecture that embeds these issues in a unique framework. SLAIR is expandable both from the data format and algorithm point of view. A pluggable notion of distance between documents drives the subsequent clustering/classification machinery; moreover SLAIR is explicitly designed to manage large scale text mining problems. The demo will be focused on the versatility of the framework; the main goal is to show how the different metrics provided by SLAIR can enhance clustering/classification ability and eventually lead to different views of the underlying textual data. © 2010 IEEE.},
 author = {Sangiacomo, Fabio and Leoncini, Alessio and Decherchi, Sergio and Gastaldo, Paolo and Zunino, Rodolfo},
 doi = {10.1109/ICSC.2010.48},
 journal = {Proceedings - 2010 IEEE 4th International Conference on Semantic Computing, ICSC 2010},
 note = {Cited by: 6},
 pages = {444 - 445},
 publication_stage = {Final},
 source = {Scopus},
 title = {SeaLab advanced information retrieval},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/79952045913?origin=resultslist},
 year = {2010}
}
