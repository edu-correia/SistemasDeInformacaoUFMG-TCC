@inproceedings{4339065,
 abstract = {An automatic extraction method of container identity codes based on mathematical morphology operation, region analysis and projection transformation is proposed. With different kinds of noises on the image, the container code can hardly be extracted precisely. To decrease the influence the noise and detect the code coarsely the image is filtered by mathematical morphological operators. Then, closed regions are found to filter the isolated strokes. Regions splitting and merging are used to obtain the candidate rectangles. Combination test based on the relationship of the rectangles is used to identify the 6-cases code arrangement rectangles. At last, the change frequency of the gray value of the image is used to identify the last code areas. Experimental results show that the method we proposed can segment the container ID codes with high performance.},
 author = {Yin, Jianqin and Cao, Aizeng and Li, Jinping},
 booktitle = {2007 IEEE International Conference on Automation and Logistics},
 doi = {10.1109/ICAL.2007.4339065},
 issn = {2161-816X},
 keyword = {Containers;Morphology;Licenses;Logistics;Filters;Data mining;Intelligent transportation systems;Automation;Information science;Information analysis;mathematical morphology;projection transform;container number location},
 month = {Aug},
 number = {},
 pages = {2842-2845},
 title = {A New Method for Container Code Location},
 volume = {},
 year = {2007}
}
