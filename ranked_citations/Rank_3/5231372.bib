@inproceedings{5231372,
 abstract = {Today, in order to provide high-quality medical service and to minimize the resource cost, many large hospitals have adopted clinical pathway as a structured way to manage treatment activities. However, customization of clinical pathway remains as a major challenge in treating diversified patients. In this paper, we present an approach for dynamically generating customized clinical pathway according to patient's evolving status. We use semiotic methods to represent medical knowledge into affordance and norms which can merge different clinical practice guidelines and pathways to deal with complex and dynamic customization scenarios. Furthermore, the system framework is established for implementing our approach. Our research will give a contribution for personalized and automatic generation of medical processes as the decision support for physicians.},
 author = {Weizi, Li and Kecheng, Liu and Shuzhang, Li and Hongqiao, Yang},
 booktitle = {2009 International Forum on Information Technology and Applications},
 doi = {10.1109/IFITA.2009.325},
 issn = {},
 keyword = {Medical diagnostic imaging;Hospitals;Medical services;Information technology;Medical treatment;Technology management;Intelligent agent;Surgery;Costs;Biomedical informatics;clinical pathway;customized;agent;norm;semiotics},
 month = {May},
 number = {},
 pages = {468-472},
 title = {An Agent Based Approach for Customized Clinical Pathway},
 volume = {2},
 year = {2009}
}
