@article{Ganesan2017,
 abstract = {We analyze how modern distributed storage systems behave in the presence of file-system faults such as data corruption and read and write errors. We characterize eight popular distributed storage systems and uncover numerous problems related to file-system fault tolerance.We find that modern distributed systems donot consistently use redundancy to recover from file-system faults: a single file-system fault can cause catastrophic outcomes such as data loss, corruption, and unavailability. We also find that the above outcomes arise due to fundamental problems in file-system fault handling that are common across many systems. Our results have implications for the design of next-generation fault-tolerant distributed and cloud storage systems. © 2017 ACM.},
 author = {Ganesan, Aishwarya and Alagappan, Ramnatthan and Arpaci-Dusseau, Andrea C. and Arpaci-Dusseau, Remzi H.},
 doi = {10.1145/3125497},
 journal = {ACM Transactions on Storage},
 note = {Cited by: 19; All Open Access; Bronze Open Access; Green Open Access},
 number = {3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Redundancy does not imply fault tolerance: Analysis of distributed storage reactions to file-system faults},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85033234478?origin=resultslist},
 volume = {13},
 year = {2017}
}
