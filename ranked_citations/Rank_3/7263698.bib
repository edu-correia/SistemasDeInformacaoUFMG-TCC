@inproceedings{7263698,
 abstract = {This paper describes the detailed solutions of ontology merging based on semantic similarity between concepts, and provides a new idea of ontology merging for traditional manual method. Firstly, the formal context converted with the source ontology is analyzed. Then, according to the graph structure of each concept in Word Net, the implicit semantic similarity between concepts is computed. Finally, the target merging ontology is generated.},
