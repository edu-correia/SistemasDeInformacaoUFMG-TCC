@inproceedings{7475015,
 abstract = {This paper considers a multiple 3D object. In this paper, each 3D object in a multiple 3D object is dealt as a single rectangular solid dissection (a 3D world), and a multiple 3D object are dealt as a multiple rectangular solid dissection. This paper introduces a 40 degree grid graph called "a 5 times octgrid" for a model of a multiple 3D object dealt as a multiple rectangular solid dissection. This paper also provides projection, translation and rotation algorithms of specified 3D objects in multiple 3D object systems with a 40 degree grid graph model.},
 author = {Yaku, Takeo and Anzai, Koushi and Miyadera, Youzou and Anada, Koichi and Goto, Takaaki and Yokota, Ken},
 booktitle = {2016 IEEE International Conference on Industrial Technology (ICIT)},
 doi = {10.1109/ICIT.2016.7475015},
 issn = {},
 keyword = {Three-dimensional displays;Solid modeling;Data structures;Electronic mail;Solids;Algorithm design and analysis;Computational modeling;Data structures;3D CG;grid graphs},
 month = {March},
 number = {},
 pages = {1678-1683},
 title = {A 40 degree grid model for multiple 3D objects},
 volume = {},
 year = {2016}
}
