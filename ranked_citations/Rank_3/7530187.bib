@inproceedings{7530187,
 abstract = {Neurodegenerative disease detection has always been a challenging area for Medical Science because of the high intricacy in the brain structure which varies with age and pathological history. Moreover, commonly used imaging techniques suffer visual evaluations, manual reorientations and other time consuming limitations with reduced resolution and poor signal to noise ratio. Therefore, there is a necessitate to develop efficient technique capable of identifying biomarkers which exemplify neurodegenerative disease with quantitative information of significance for the clinicians. The proposed analysis provides better detection and evaluation technique yielding promising results for the brain images using MATLAB. This paper presents analysis of different segmentation approaches for image analysis method that reveals discriminative brain patterns associated to the Alzheimer Disease. This is accomplished by different algorithm and software approach.},
 author = {Suwalka, Isha and Agrawal, Navneet},
 booktitle = {2016 International Conference on Circuit, Power and Computing Technologies (ICCPCT)},
 doi = {10.1109/ICCPCT.2016.7530187},
 issn = {},
 keyword = {Image segmentation;Image edge detection;Brain;Diseases;Biomedical imaging;Merging;Magnetic resonance imaging;Segmentation;Alzheimer Disease;Thresholding;Grey Scale based;Edge based;Canny;Sobel;Prewitt Region based;Region merging;Evaluation based},
 month = {March},
 number = {},
 pages = {1-5},
 title = {Assessment of segmentation techniques for neurodegenerative disease detection},
 volume = {},
 year = {2016}
}
