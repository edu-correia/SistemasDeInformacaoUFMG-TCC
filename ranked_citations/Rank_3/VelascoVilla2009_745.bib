@article{VelascoVilla2009_745,
 abstract = {The exact discrete-time model of a two wheel differentially driven mobile robot is obtained by direct integration of its continuous-time kinematic model. The discrete-time model obtained is used to design two discrete-time linearizing control laws with different singular manifolds. These control laws are used to propose a commutation control scheme that solves the path-tracking problem and guarantees internal stability of the closed loop system. The performance of the control scheme is evaluated by the real time implementation of the proposed control strategy over a laboratory prototype.},
 author = {Velasco Villa, Martin and Aranda Bricaire, Eduardo and Orosco Guerrero, Rodolfo},
 number = {2},
 pages = {142--160},
 title = {Discrete-Time Modeling and Path-Tracking for a Wheeled Mobile Robot},
 volume = {13},
 year = {2009}
}
