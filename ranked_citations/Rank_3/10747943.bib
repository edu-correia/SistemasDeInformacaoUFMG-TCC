@inproceedings{10747943,
 abstract = {Peer assessment is inherently a social activity, yet it is often an isolating practice in online courses. On the other hand, peer discussion is full of social learning opportunities for learners in massive open online courses (MOOCs), but is often difficult to assess in practice. This study expands on efforts to integrate social processes into peer assessment. Specifically, we explore the connections between peer assessment and peer discussion by investigating a novel environment that merges the two. This environment engages learners through the multiple stages of assignment submission, peer review, open discussion, reflection, and an optional stage of peer citation. Our study examines reflections from learners who participated in this environment hosted by five MOOCs, ranging from material science to technology policy. We applied iterative coding to 250 learner reflections to identify how peer assessment and peer discussion can impact learning. Our analysis suggests that the environment supports learning by providing learners the opportunities to give and receive feedback, see one another’s work, and apply their learnings. Learners benefit from this environment by developing communication skills, broadening their perspectives, and learning how to learn. Finally, we discuss how these learner benefits fit within a framework of 21st century key competencies developed by the Organization for Economic Cooperation and Development (OECD).},
 author = {Perdue, Meghan and Sandland, Jessica and Joshi, Aditi and Liu, John},
 booktitle = {2024 IEEE Digital Education and MOOCS Conference (DEMOcon)},
 doi = {10.1109/DEMOcon63027.2024.10747943},
 issn = {},
 keyword = {Economics;Computer aided instruction;Materials science and technology;Electronic learning;Reviews;Organizations;Reflection;Encoding;Iterative methods;Lenses;peer assessment;peer discussion;social practice;21st century skills;learning environment;open-ended assessment},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Exploring the Integration of Social Practice into MOOC Peer Assessment},
