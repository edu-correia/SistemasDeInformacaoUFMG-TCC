@inproceedings{11394532,
 abstract = {The GIST-3DR project seeks to transform dental implant surgery by merging state-of-the-art tools like 3D Augmented Reality (AR) and intelligent segmentation techniques. Its main goal is to create personalized and automated implant designs while solving issues such as inaccurate sizing, nerve canal injuries, and limited spatial visibility. Using CT scan data, the system builds high-resolution 3D models of oral structures, helping dental professionals visualize, plan, and perform implants with exceptional precision. The approach consists of three key stages: the Vision Stage, where DICOM images are analyzed using deep learning algorithms such as Mask R-CNN and YOLOv8; the API Stage, which handles output management and system communication; and the User Interaction Stage, providing AR-based visualization for interactive assessment. The model delivers excellent results, achieving mAP-50 scores above 0.96, proving its reliability. Findings show major gains in implant accuracy and reduced manual intervention. Its applications span improved surgical planning, remote AR-assisted collaboration, and integration with CAM tools for efficient production. Future enhancements will focus on real-time testing, full process automation, and secure integration of patient data, broadening its potential across dental and healthcare domains.},
 author = {M, Shwetha and K.C, Shilpa and G, Pavithra and Ninawe, Swapnil S.},
 booktitle = {2026 International Conference on Intelligent and Innovative Technologies in Computing, Electrical and Electronics (IITCEE)},
 doi = {10.1109/IITCEE67948.2026.11394532},
 issn = {},
 keyword = {Deep learning;Three-dimensional displays;Accuracy;Surgery;Data visualization;Implants;Transforms;Dentistry;Augmented reality;Testing;GIST-3DR System;Deep Learning;Augmented Reality;Precision;Visualization;Personalized Dental Implantology},
 month = {Jan},
 number = {},
 pages = {1-6},
 title = {Combining Augmented Reality and Deep Learning in Custom Dental Implantology: Design and Implementation of the GIST-3DR Framework to Improve Accuracy and Visualization in Implant Treatments},
 volume = {},
