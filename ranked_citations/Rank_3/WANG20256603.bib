@article{WANG20256603,
 abstract = {Smartphones widely utilize GNSS navigation and positioning capabilities in daily life, but the increasing number of GNSS satellites has significantly boosted the computational load on these devices. Selecting a subset of high-quality satellites is essential for enhancing positioning accuracy and minimizing the computational load. This paper proposes a satellite selection strategy for smartphone GNSS pseudorange differential positioning based on integrated metrics, addressing the limitations of existing satellite selection algorithms. The strategy involves categorizing satellites into persistent and non-persistent groups within a predefined time window. Persistent satellites are evaluated using corrected code-minus-carrier (CMC) values, while non-persistent satellites are assessed using an EA-SNR fusion metric combining satellite elevation and signal-to-noise ratio (SNR). These subsets are merged to form the optimal satellite combination for pseudorange differential positioning. The study reveals that the satellite selection method modestly surpasses full constellation positioning in open areas, with a pronounced advantage in occluded environment. The proposed method achieves positioning accuracy improvements ranging from 32.11 % to 64.17 % across the four smartphone models (Huawei P40, Huawei Mate40, Vivo IQOO Z1, and Xiaomi 8), with the integrated metrics consistently outperforming the full constellation. When compared to other multi-criteria selection strategies, this integrated metric approach reduces horizontal positioning errors by 1–3 m, while achieving greater gains in vertical accuracy. In dynamic environment, horizontal positioning error was reduced by tens of meters, maintaining high stability. The proposed satellite selection strategy effectively screens satellites to construct a high-quality subset, improving positioning accuracy and reducing computational requirements. The method is straightforward to implement and is well-suited for smartphone GNSS positioning in complex urban environment.},
 author = {Huayin Wang and Jian Deng and Shuen Wei and Ze Li and Zhutao Liu},
 doi = {https://doi.org/10.1016/j.asr.2025.09.016},
 issn = {0273-1177},
 journal = {Advances in Space Research},
 keyword = {Satellite selection, Smartphone, Relative positioning, Code-minus-carrier},
 number = {11},
 pages = {6603-6622},
 title = {A satellite selection strategy based on integrated quality metrics for smartphone GNSS pseudorange differential positioning},
 url = {https://www.sciencedirect.com/science/article/pii/S0273117725010099},
 volume = {76},
 year = {2025}
}
