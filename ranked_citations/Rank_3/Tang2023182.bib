@conference{Tang2023182,
 abstract = {With the rapid development of the Internet of Things, satellite communications, unmanned aerial vehicles, and other technologies, the application of data processing technology in the field of emergency rescue has attracted great attention. In this paper, a cleaning algorithm for Space-Air-Ground integrated rescue data is proposed, which can be used to solve the problems caused by dirty data, such as the long data processing time and poor rescue efficiency. Based on the traditional sorted neighborhood method (SNM), a jump-sliding window strategy is added to the proposed cleaning algorithm. By reducing the data comparisons, the proposed cleaning algorithm has greatly shortened the cleaning time of duplicate approximate records in the rescue data sets, while satisfying the data quality. The rescue data with different scales are used to test the two algorithms, and the simulation results show that the processing time of the proposed algorithm is far less than that of the traditional SNM algorithm. For example, when the data scale is 1.827 million and the window size is 50, the processing time of the proposed algorithm is 27s, which is 10 times shorter than that of the traditional SNM algorithm. When the window size changes to 500, the processing time of the proposed algorithm is 44s, which is 28.7 times shorter than that of the traditional SNM algorithm. So the proposed algorithm is more suitable for cleaning duplicate approximate rescue data, due to its urgent time requirement for rescue events. © 2023 Copyright held by the owner/author(s). Publication rights licensed to ACM.},
 author = {Tang, Min and Cao, Lu and Zhang, Fei and Qin, Jiangyi and Zhou, Yu and Zhang, Yun},
