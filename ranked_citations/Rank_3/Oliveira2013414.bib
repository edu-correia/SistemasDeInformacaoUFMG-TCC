@conference{Oliveira2013414,
 abstract = {The evolution of computer networks presents new mechanisms that increase the flexibility and intelligence of network devices. The consequence is an increased automation of activities required to manage and delay human interventions. In this article, we present mechanisms relating to policies, programmable networks and semantics as well as integrate them collaboratively into a single framework, we call ProNet. Furthermore, the benefits will be demonstrated and its limitations will be quantitatively described. © 2013 IEEE.},
 author = {Oliveira, Luciana Pereira and Sadok, Djamel F. Hadj},
 doi = {10.1109/INCoS.2013.78},
 journal = {Proceedings - 5th International Conference on Intelligent Networking and Collaborative Systems, INCoS 2013},
 note = {Cited by: 2},
 pages = {414 - 421},
 publication_stage = {Final},
 source = {Scopus},
 title = {ProNet framework: Network management using semantics and collaboration},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84890056224?origin=resultslist},
 year = {2013}
}
