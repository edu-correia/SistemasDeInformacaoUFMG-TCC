@article{BROY2026103450,
 abstract = {In concurrency, the mutual communication between concurrent interactive distributed systems is realized by feedback loops semantically captured by recursively defined communication streams. Such recursive definitions correspond to fixpoint equations for the involved streams. For deterministic systems modelled by prefix-monotonic and continuous functions on streams, the semantics of feedback loops is well-defined by streams which are least fixpoints as shown by Kahn. They match the operational semantics. However, for nondeterministic stream processing systems and their specifications two basic problems have to be solved. For treating recursion in the context of underspecification and nondeterminism, power domains have been proposed including partial orderings to define monotonicity. In the set of solutions for the fixpoint equations associated with feedback loops, those fixpoints have to be identified which match the operational semantics, called computationally feasible, such as least fixpoints are in the deterministic case. However, in the nondeterministic case, it is not obvious how to identify in the set of fixpoints those that are computationally feasible, since least fixpoint characterizations don't work. Moreover, there exist systems of practical relevance, such as fair merge, with behaviors that are not monotonic in any of the partial orderings used in power domains. Thus, nondeterministic systems as well as their specifications need more sophisticated concepts than straightforward monotonicity to deal with concurrent composition and feedback loops. In the following, a detailed formalism is presented for the specification of the behavior of nondeterministic system and their concurrent composition with communication by feedback loops. It is shown, how timed streams help as an auxiliary construct to define concurrent composition with feedback for time-free nonmonotonic system interface behaviors.},
 author = {Manfred Broy},
 doi = {https://doi.org/10.1016/j.scico.2026.103450},
 issn = {0167-6423},
 journal = {Science of Computer Programming},
 keyword = {Concurrency, Interface, Specification, Assertion, Verification, Feedback, Fixpoint, Composition, Causality, Realizability},
 pages = {103450},
 title = {Concurrent Distributed Systems Beyond Monotonicity},
 url = {https://www.sciencedirect.com/science/article/pii/S0167642326000158},
 year = {2026}
}
