@article{10915705,
 abstract = {Collaborative perception is an emerging research focus in autonomous driving. Despite progress, challenges remain due to complex collaboration processes and vulnerable communication environments. In light of this, this article introduces a novel multitask cooperative perception framework, impaired communication aware vehicle-to-everything collaborative perception framework (ICA-V2X), comprising two core modules. First, we construct a feature fusion module, the vehicle-to-everything (V2X) global confidence-based fusion (V2X-GCF) module, which utilizes graph neural networks (GNNs) highly adapted to the V2X structure to generate a global confidence map (GCM). This GCM provides comprehensive guidance for collaborator selection and interaction content, surpasses the limitations of fixed-threshold methods and single-view biases that fail to accurately assess each agent’s contribution to the overall V2X scene perception capability. Furthermore, V2X-GCF incorporates an ego-centric attention fusion (EAF) mechanism to adaptively merge complementary features that are highly relevant to the ego agent from collaborative agents, maximizing the effectiveness of the aggregated information. Second, to ensure that our method can work in vulnerable communications, we propose a novel communication trust probability model to simulate scenarios of impaired communications and develop the two-stage impaired communication recovery (ICR) module. By predicting the variance of impaired parts, ICR provides refined guidance for the restoration of impaired information, enhancing the robustness of the collaborative perception system in V2X impaired communication scenarios. Additionally, by leveraging the complementarity between tasks, V2X-GCF generates a global drivable area map closely related to map segmentation, significantly reducing conflicts and redundancies in the fusion of multiagent environmental features and eliminating interference from nondrivable areas. Our validation on the OPV2V and V2XSet datasets covers both ideal and impaired communication, including tasks such as 3-D object detection and bird’s eye view (BEV) map segmentation. The experimental results demonstrate that ICA-V2X achieves the state-of-the-art (SOTA) performance, showcasing its strong model generalization capability.},
 author = {Yan, Fuwu and Tao, Bo and Zheng, Ningyu and Nie, Linzhen and Li, Qian and Yin, Zhishuai},
 doi = {10.1109/TIM.2025.3548801},
 issn = {1557-9662},
 journal = {IEEE Transactions on Instrumentation and Measurement},
 keyword = {Collaboration;Vehicle-to-everything;Object detection;Autonomous vehicles;Adaptation models;Three-dimensional displays;Sensors;Maintenance engineering;Interference;Redundancy;3-D object detection;bird’s eye view (BEV) map segmentation;collaborative perception;impaired communication;vehicle-to-everything (V2X)},
 month = {},
 number = {},
 pages = {1-13},
 title = {Multitask Collaborative Perception for Vehicle-to-Everything Considering Impaired Communication},
 volume = {74},
 year = {2025}
}
