@inproceedings{6117153,
 abstract = {We report a brand new technique which is merged thin film fabrication process and packaging technology together to form the shortest thermal dissipation path of LED structure. The effective thermal resistance of the proposed LED was 3.54K/W, which is much better than that of the conventional one 10.8K/W and the operating current can be driven from original 230mA up to 800mA. These results indicate that the LED structure based on our work is useful in improving the performance by enabling great heat dissipation and have higher application potential than conventional one.},
 author = {Tsai, Y. J. and Hsu, C. P. and Lin, K. F. and Chang, Y. H. and Hu, H. L. and Chen, T. T. and Chu, C. W. and Chu, M. T.},
 booktitle = {2011 6th International Microsystems, Packaging, Assembly and Circuits Technology Conference (IMPACT)},
 doi = {10.1109/IMPACT.2011.6117153},
 issn = {2150-5942},
 keyword = {Light emitting diodes;Thermal resistance;Epitaxial growth;Silicon;Fabrication},
 month = {Oct},
 number = {},
 pages = {492-494},
 title = {High thermal dissipation of light emitting diodes by integrating thin film process and packaging technology},
 volume = {},
 year = {2011}
}
