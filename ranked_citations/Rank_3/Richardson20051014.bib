@conference{Richardson20051014,
 abstract = {The Semantic Web is the next step in the Internet's evolution. The existing Web contains a considerable amount of data; most is weakly structured. Broadly accessing the data is difficult Previously unseen data cannot be easily autonomously understood with out a consistent semantic framework. Viewing and organizing data using shared ontologies is essential for both sharing data and for web site interoperability. Full autonomous or semi-autonomous discovery and development of ontologies is the only feasible way to transition the existing Web to the Semantic Web. One strategy is to merge existing, vetted ontologies. The pre-merger ontologies would likely be similar in some respects and different in others. When comparing ontologies, a necessarily imprecise, approximate similarity metric will be necessary. Possibly, soft computing will provide useful tools. © 2005 IEEE.},
 author = {Richardson, Bartley and Mazlack, Lawrence J.},
 doi = {10.1109/FUZZY.2005.1452533},
 journal = {IEEE International Conference on Fuzzy Systems},
 note = {Cited by: 5},
 pages = {1014 - 1019},
 publication_stage = {Final},
 source = {Scopus},
 title = {Approximate metrics for autonomous semantic web ontology merging},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/23944517063?origin=resultslist},
 year = {2005}
}
