@conference{Liu2024479,
 abstract = {Persistent key-value store based on LSM-trees represents one of the most advanced designs. Recent research shows that key-value separation has become a popular optimization method for LSM-tree. However, this storage architecture still incurs significant overhead when dealing with some query- and update-intensive workloads. In this paper, we propose LCKV, a key-value separated LSM-tree storage system built using the Learner-Cleaner optimization to increase throughput. Learner represents the construction of learned indexes to increase query throughput, responsible for building models for the hot-readcold-written keys stored in the LSM-tree and values stored in the cold-written value logs (vLogs). Cleaner represents the garbage collector (GC) aimedat increasing update throughput, responsible not only for garbage collection but also for maintaining the sorting of the cold-written vLog. Evaluations show that LCKV outperforms other state-of-the-art solutions. © 2024 IEEE.},
 author = {Liu, Mingxuan and Gu, Jianhua and Zhao, Tianhai},
 doi = {10.1109/ICCD63220.2024.00079},
 journal = {Proceedings - IEEE International Conference on Computer Design: VLSI in Computers and Processors},
 note = {Cited by: 2},
 pages = {479 - 482},
 publication_stage = {Final},
 source = {Scopus},
 title = {LCKV: Learner-Cleaner Optimized Adaptive Key-Value Separated LSM-Tree Store},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85217031506?origin=resultslist},
 year = {2024}
}
