@conference{Ding2013716,
 abstract = {As traditional network measurement systems store data in relational databases, the storage capacity and computing resource are limited, besides, the extendibility and elasticity are low. The centralized storage scheme will not meet the needs of big data analysis as the data is growing rapidly and continuously. In this paper, we adopt Hadoop and HBase-open source Cloud Computing Frameworks to store network measurement data of non-realtime and realtime applications. The distributed storage scheme is designed to meet the performance demands of storage capacity and computing resource for the mass data. © 2012 IEEE.},
 author = {Ding, Haijie and Jin, Yuehui and Cui, Yidong and Yang, Tan},
 doi = {10.1109/CCIS.2012.6664268},
 journal = {Proceedings - 2012 IEEE 2nd International Conference on Cloud Computing and Intelligence Systems, IEEE CCIS 2012},
 note = {Cited by: 12},
 pages = {716 - 720},
 publication_stage = {Final},
 source = {Scopus},
 title = {Distributed storage of network measurement data on HBase},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84890379452?origin=resultslist},
 volume = {2},
 year = {2013}
}
