@inproceedings{6469990,
 abstract = {A new pan-sharpening model is presented for merging the panchromatic (PAN) and the multi-spectral (MS) image by combining IHS and variational method. IHS model can sharpen the MS band quickly; however, the color distortion occurs in the fusion results. To deal with this problem, the substitute image of IHS model is obtained by injecting it with the geometry structure of the PAN band while preserving its spectral signature in the variational framework. In comparison with the models including extended fast IHS (eFIHS), stationary wavelet transform (SWT) and nonsubsampled contourlet transform (NSCT), it is shown that our model can achieve a good trade-off between the spatial and spectral fusion quality by adjusting the weighted parameters.},
 author = {Zhou, Ze-ming and Wu, Zhi-jian and Wang, Jin and Yang, Ping-lv and Jiang, Lin},
 booktitle = {2012 5th International Congress on Image and Signal Processing},
 doi = {10.1109/CISP.2012.6469990},
 issn = {},
 keyword = {Image color analysis;Image fusion;Transforms;Geometry;Remote sensing;Numerical models;Spatial resolution;panchromatic image;multispectral image;pansharpening;IHS fusion;variational fusion},
 month = {Oct},
 number = {},
 pages = {1077-1080},
 title = {Panchromatic and multi-spectral image fusion using IHS and variational models},
 volume = {},
 year = {2012}
}
