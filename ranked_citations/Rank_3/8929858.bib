@inproceedings{8929858,
 abstract = {The algorithm for dividing the initial set of group expert assessments into subgroups containing homogeneous, consistent estimates has been propose in this paper. The proposed approach allows to distinguish groups of experts, with a “close” opinion, to analyze them in order to develop a final (group) assessment that takes into account the opinions (arguments) of each expert. Metrics of evidence theory characterizing the degree of proximity of expert assessments are taken as a measure of consistency.},
 author = {Kovalenko, Igor and Davydenko, Yevhen and Shved, Alyona},
 booktitle = {2019 IEEE 14th International Conference on Computer Sciences and Information Technologies (CSIT)},
 doi = {10.1109/STC-CSIT.2019.8929858},
 issn = {},
 keyword = {Finite element analysis;Uncertainty;Merging;Sea measurements;Euclidean distance;Software measurement;theory of evidence;measures of dissimilarity;expert evidences;uncertainty},
 month = {Sep.},
 number = {},
 pages = {113-116},
 title = {Formation of Consistent Groups of Expert Evidences Based on Dissimilarity Measures in Evidence Theory},
 volume = {1},
 year = {2019}
}
