@inproceedings{7294169,
 abstract = {In acute care, providers need to response quickly to patients deterioration. However, a physician's availability can be limited if multiple patients are declining simultaneously. To study the multi-patient rapid response process, a complex network model with split, merge and parallel structures is introduced, and iteration procedures are presented to evaluate system performance. It is shown that such procedures are convergent and lead to accurate performance evaluation.},
 author = {Xie, Xiaolei and Zeng, Zexian and Li, Jingshan and Swartz, Colleen H. and DePriest, Paul},
 booktitle = {2015 IEEE International Conference on Automation Science and Engineering (CASE)},
 doi = {10.1109/CoASE.2015.7294169},
 issn = {2161-8089},
 keyword = {Medical services;Convergence;Fellows;Tin;Time factors;Iterative methods;Accuracy;Rapid response;decision time;iterations;patient deterioration;provider availability},
 month = {Aug},
 number = {},
 pages = {740-745},
 title = {Analysis of multi-patient rapid response processes: An iterative approach},
 volume = {},
 year = {2015}
}
