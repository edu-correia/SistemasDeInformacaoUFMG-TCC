@inproceedings{1349244,
 abstract = {This work presents a knowledge-based approach to assembly sequence planning problem. This research shows that the typical or standard CSBAT (connection semantics based assembly tree) can be applied to a given assembly problem. The structure of the KBASP (knowledge-based assembly sequence planning system) is proposed, there are three ways to construct plans for a CSBAT: (1) by retrieving the typical base; (2) by retrieving standard base; and (3) by geometry reasoning. Compared with other system based on the reuse philosophy the approach can generate assembly sequences for each CSBAT directly without the problem of merging plans for different child CSBATs. By integrating geometry-based reasoning with knowledge-based reasoning, the computation complexity is reduced drastically and the assembly sequences obtained are more feasible and practical.},
 author = {Tianyang Dong and Ruofeng Tong and Jinxiang Dong and Ling Zhang},
 booktitle = {8th International Conference on Computer Supported Cooperative Work in Design},
 doi = {10.1109/CACWD.2004.1349244},
 issn = {},
 keyword = {Assembly systems;Connectors;Manufacturing industries;Laboratories;Character generation;Geometry;Merging;Manufacturing automation;Project management;Technology management},
 month = {May},
 number = {},
 pages = {516-521 Vol.2},
 title = {Knowledge-based assembly sequence planning system},
 volume = {2},
 year = {2004}
}
