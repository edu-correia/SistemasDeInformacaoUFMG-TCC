@inproceedings{10386975,
 abstract = {Multi-label text classification (MLTC) is an important task in the field of natural language processing (NLP). Suffering from limited input length, most existing models learn text representation and label representation separately, leading to the overlook of correlations between texts and labels. To this end, we introduce a comprehensive model for the MLTC task. Under the same representation space, our model, which is equipped with Graph Convolutional Network (GCN) layer, attention mechanism, and contrastive learning objective, learns representations of texts and labels jointly. To tackle the issue caused by the input length limitation, we develop a two-stage label reduction method via the application of label merging and association. Our method’s effectiveness is validated through extensive experiments on various MLTC datasets, unraveling the intricate correlations between texts and labels.},
 author = {Zhang, Wang and Wang, Xin and Wu, Yuhong and Zhang, Xingpeng and Zhan, Huayi},
 booktitle = {2023 IEEE International Conference on Big Data (BigData)},
 doi = {10.1109/BigData59044.2023.10386975},
 issn = {},
 keyword = {Representation learning;Adaptation models;Correlation;Text categorization;Merging;Self-supervised learning;Big Data;Multi-label text classification;Graph Convolutional Network;Contrastive Learning;Label Association},
 month = {Dec},
 number = {},
 pages = {1012-1021},
 title = {Enhancing Representation Learning with Label Association for Multi-Label Text Classification},
 volume = {},
 year = {2023}
}
