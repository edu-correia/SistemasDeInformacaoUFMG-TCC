@conference{Chernavskaya2018134,
 abstract = {The concept of scientific paradox and the possibility to reveal and resolve the paradox by means of artificial intelligence are discussed. The scientific paradox represents the contradictory description of the same reality within different scientific disciplines. Under the original Natural-Constructive Cognitive Architecture this paradox can be reproduced as impossibility to merge different representations of the same object. It is shown that this architecture involves, in particular, the high-level symbolic information that could be associated with concept of "scientific discipline". The scientific paradox is treated as impossibility to integrate (merge) the symbols referring to different scientific disciplines. It is shown that the paradox could be resolved within the proposed architecture by decomposition of the high-level symbols down to low-level of corresponding raw mages, with subsequent revision of the object's memorization procedure. One of the main distinctive features of the proposed architecture is the raw-image processor responsible for recording all the information on the presented object including even rare, seemingly inessential one, which correspond to rather weak connections between involved (halo) neurons. This processor could be associated with human sub-consciousness. The role of weak connections in resolution of paradox and scientific discovery (chef-d'oeuvre) is discussed. © 2018 The Authors. Published by Elsevier B.V.},
 author = {Chernavskaya, Olga and Rozhylo, Yaroslav},
 doi = {10.1016/j.procs.2018.11.021},
 journal = {Procedia Computer Science},
 note = {Cited by: 2; All Open Access; Gold Open Access},
 pages = {134 - 142},
 publication_stage = {Final},
 source = {Scopus},
 title = {On Revealing and Resolving the Scientific Paradoxes within the Artificial Cognitive System},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85059454365?origin=resultslist},
 volume = {145},
 year = {2018}
}
