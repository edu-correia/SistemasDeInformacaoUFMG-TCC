@conference{Wang2020713,
 abstract = {Modern storage systems leverage flash caching to boost I/O performance, and enhancing the space efficiency and endurance of flash caching remains a critical yet challenging issue in the face of ever-growing data-intensive workloads. Deduplication and compression are promising data reduction techniques for storage and I/O savings via the removal of duplicate content, yet they also incur substantial memory overhead for index management. We propose AustereCache, a new flash caching design that aims for memory-efficient indexing, while preserving the data reduction benefits of deduplication and compression. AustereCache emphasizes austere cache management and proposes different core techniques for efficient data organization and cache replacement, so as to eliminate as much indexing metadata as possible and make lightweight in-memory index structures viable. Trace-driven experiments show that our AustereCache prototype saves 69.9-97.0% of memory usage compared to the state-of-the-art flash caching design that supports deduplication and compression, while maintaining comparable read hit ratios and write reduction ratios and achieving high I/O throughput. Copyright © Proc. of the 2020 USENIX Annual Technical Conference, ATC 2020. All rights reserved.},
 author = {Wang, Qiuping and Li, Jinhong and Xia, Wen and Kruus, Erik and Debnath, Biplob and Lee, Patrick P.C.},
 journal = {Proceedings of the 2020 USENIX Annual Technical Conference, ATC 2020},
 note = {Cited by: 27},
 pages = {713 - 726},
 publication_stage = {Final},
 source = {Scopus},
 title = {Austere flash caching with deduplication and compression},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85090434446?origin=resultslist},
 year = {2020}
}
