@inproceedings{4751257,
 abstract = {Piezoelectric materials are widely used for many applications such as sensors, actuators. Today, their integration in microelectronics processes like CMOS requires the development of advanced realistic behavioral models. Until now, these models were limited to only one ceramic's operation mode, i.e., thickness or planar. Moreover, the robustness of piezo-electronic system cannot be adequately addressed as long as models are not improved, in particular by taking into account further real phenomena. This article proposes to merge, in a new behavioral model, the two operation modes. It is demonstrated that the electrical behavior of the proposed model is in very good agreement with the real ceramic behavior.},
 author = {Galliere, Jean-Marc and Papet, Philippe and Latorre, Laurent},
 booktitle = {2008 IEEE International Behavioral Modeling and Simulation Workshop},
 doi = {10.1109/BMAS.2008.4751257},
 issn = {2160-3812},
 keyword = {Piezoelectric transducers;Ceramics;Vibrations;Semiconductor device modeling;Power system modeling;Robustness;Design engineering;Process design;Piezoelectric materials;Piezoelectric actuators},
 month = {Sep.},
 number = {},
 pages = {148-152},
 title = {A 2-D VHDL-AMS Model for Disk-Shape Piezoelectric Transducers},
 volume = {},
 year = {2008}
}
