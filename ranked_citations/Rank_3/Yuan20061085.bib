@article{Yuan20061085,
 abstract = {Ontology alignment deals with the semantic interoperation in Semantic Web. An inference rules-guided ontology alignment approach is proposed in this paper. The semantic relationship between entities of ontology can be acquired through the inference rules. According to the semantic relationship, entity pairs (e, e') on which the reasonable relationship may be established are selected, then the similarity measure Sim(e, e') is computed. Only on entities pair with acceptable similarity measure, can the relationship be established. Guided by the inference rules, much meaningless similarity computations between entities can be avoided and the precision of alignment is improved.},
 author = {Yuan, Liu and Li, Zhanhuai and Chen, Shiliang},
 journal = {Journal of Computational Information Systems},
 note = {Cited by: 2},
 number = {3},
 pages = {1085 - 1090},
 publication_stage = {Final},
 source = {Scopus},
 title = {Inference rules-guided ontology alignment to semantic web},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33845801666?origin=resultslist},
 volume = {2},
 year = {2006}
}
