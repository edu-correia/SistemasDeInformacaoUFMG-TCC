@article{DENKENA2015105,
 abstract = {The development and effective implementation of a production strategy requires an interdisciplinary planning of products, manufacturing technologies and factory concepts. The integrative roadmapping allows the merging of these planning areas and takes into account the occurring interactions. This article shows the concept and software implementation of the integrative roadmapping for a systematic creation of roadmaps using the example of rotor blade production in the wind turbine industry. To reduce planning time and cost the workflow in the rotor blade production has been transferred to a material flow simulation to estimate the mutual impact on the production capacity by product, technology and factory within the planning phase.},
 author = {B. Denkena and F. Winter},
 doi = {https://doi.org/10.1016/j.procir.2015.06.020},
 issn = {2212-8271},
 journal = {Procedia CIRP},
 keyword = {planning, simulation, decision making},
 note = {9th CIRP Conference on Intelligent Computation in Manufacturing Engineering - CIRP ICME '14},
 pages = {105-110},
 title = {Simulation-based Planning of Production Capacity through Integrative Roadmapping in the Wind Turbine Industry},
 url = {https://www.sciencedirect.com/science/article/pii/S2212827115006630},
 volume = {33},
 year = {2015}
}
