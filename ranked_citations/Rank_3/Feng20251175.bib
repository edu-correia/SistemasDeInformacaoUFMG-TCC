@conference{Feng20251175,
 abstract = {In distributed VLSI systems, clock networks dominate 30 \%-50 \% of dynamic power consumption, posing critical challenges for energy-efficient design. This paper proposes an enhanced K-means clustering algorithm to optimize flip-flop merging, significantly reducing clock power through decreased leaf nodes, shortened wirelength, and minimized buffer counts. Our method dynamically determines initial cluster centers via a distance threshold, groups flip-flops using Manhattan-distance-based K-means clustering, and maximizes merging via a greedy strategy. Experimental results demonstrate average reductions of 64.7 % in clock power and 2 1. 3 \% in total power versus conventional non-merge flows, while maintaining stable performance. Against commercial tool-built-in merging, the algorithm achieves 24.3 % shorter clock wirelength, 37.4 % fewer clock buffers, and 31.1 % lower clock power. The approach exhibits high scalability in distributed VLSI environments, efficiently merging flip-flops across large-scale designs.  © 2025 IEEE.},
 author = {Feng, Chaochao and Xu, Nuo and He, Xiaowei and Liao, Zhuofan},
 doi = {10.1109/ISPA67752.2025.00161},
 journal = {Proceedings - 2025 IEEE International Symposium on Parallel and Distributed Processing with Applications, ISPA 2025},
 note = {Cited by: 0},
 pages = {1175 - 1181},
 publication_stage = {Final},
 source = {Scopus},
 title = {Energy-Efficient Flip-Flop Merging via Enhanced K-Means Clustering in Distributed VLSI Systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105030189733?origin=resultslist},
 year = {2025}
}
