@inproceedings{5656833,
 abstract = {The Telematics is the integration of telecommunication and informatics. It is also known as ICT (Information and Communications Technology). The application trends of Telematics is to establish a user friendly vehicle communication environment to merge the information for the traffic safety, road navigation, remote business, and A/V entertainment, etc. In the future, a portable Telematics system which integrates multimedia infotainment networks (Bluetooth, MOST), short range communications (WLAN, DSRC), long distance communications (GPS, DAB, 3.5G, Wi-MAX), and cooperates with service provider will be mainstream of the market to save cost and enhance seamless communication efficiency. The key technologies of Telematics are the heterogeneous communication and information fusion. In this thesis, we proposed the network management algorithm to monitor and predict the channel variations and power attenuation in physical layer. The proposed method could be implemented in Heterogeneous Internet Device (HID) which could manage multiple communications including wireless devices (3.5G, Wi-Fi, DSRC) and wired interface (Ethernet) based on Android OS. We establish the HID system prototype on different platforms as portable devices, on board unit (OBU), and home/public gateway to realize ubiquitous seamless services.},
 author = {Cheng, Yong-Hua and Kuo, Wen-Kuang and Su, Szu-Lin},
 booktitle = {IEEE 10th INTERNATIONAL CONFERENCE ON SIGNAL PROCESSING PROCEEDINGS},
 doi = {10.1109/ICOSP.2010.5656833},
 issn = {2164-523X},
 keyword = {Algorithm design and analysis;Channel estimation;Roaming;Prediction algorithms;Mathematical model;Telematics;Heterogeneous network;Android},
 month = {Oct},
 number = {},
 pages = {2464-2467},
 title = {Design and implementation of heterogeneous network management algorithm},
 volume = {},
 year = {2010}
}
