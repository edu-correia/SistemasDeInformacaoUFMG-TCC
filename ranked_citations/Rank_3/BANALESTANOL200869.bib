@article{BANALESTANOL200869,
 abstract = {We analyse the effects of investment decisions and firms' internal organisation on the efficiency and stability of horizontal mergers. In our framework efficiency gains are endogenous and there might be internal conflict within merged firms. We show that, both with and without conflict, stable mergers often do not generate efficiency gains. In the case of internal conflict, mergers may even lead to efficiency losses. Our welfare results suggest that antitrust authorities may approve welfare-reducing mergers (type II error) and block welfare-enhancing mergers (type I error) if they assume that potential efficiency gains will always be realised. In addition, the paper offers a possible explanation for merger failures.},
 author = {Albert Banal-Estañol and Inés Macho-Stadler and Jo Seldeslachts},
 doi = {https://doi.org/10.1016/j.ijindorg.2006.10.007},
 issn = {0167-7187},
 journal = {International Journal of Industrial Organization},
 keyword = {Endogenous merger formation, Endogenous efficiency gains, Internal conflict},
 number = {1},
 pages = {69-91},
 title = {Endogenous mergers and endogenous efficiency gains: The efficiency defence revisited},
 url = {https://www.sciencedirect.com/science/article/pii/S0167718706001378},
 volume = {26},
 year = {2008}
}
