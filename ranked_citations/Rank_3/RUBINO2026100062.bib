 abstract = {Objective
Bone reduction is a critical step in complete arch implant rehabilitation, ensuring adequate restorative space and prosthetically guided implant positioning. This paper presents a complete digital workflow for guided bone reduction using stackable surgical guides, designed to integrate the prosthetic plan with surgical execution.
Methods
A prosthetically driven approach was implemented by merging CBCT data, intraoral scans, and virtual wax-ups within CAD planning software. A multi-layer stackable guide system was digitally designed and 3D printed to sequentially guide bone reduction, implant placement, and immediate loading. The workflow is illustrated through one representative clinical case involving mandibular terminal dentition and maxillary complete edentulism.
Results
The digital workflow enabled accurate and reproducible transfer of the virtual plan to the clinical field, optimizing the vertical restorative dimension and alignment of implants within the prosthetic envelope. The stackable guide system ensured stable positioning, reduced variability during the surgical procedure, and enhanced coordination between clinician and technician.
Conclusions
The stackable surgical guide workflow allows for reliable, safe, and reproducible bone reduction procedures, aligning every surgical phase with the final prosthetic design. This approach minimizes complications and improves predictability in complete arch implant rehabilitations.},
 author = {Luigi Rubino and Francesco Grande and Santo Catapano and Scott Ganz and Eitan Mijiritsky},
 doi = {https://doi.org/10.1016/j.ddj.2025.100062},
 issn = {2950-6433},
 journal = {Digital Dentistry Journal},
 keyword = {Bone reduction, Guided surgery, Stackable guide, Digital workflow, Implant rehabilitation, Prosthetically driven planning},
 number = {1},
 pages = {100062},
 title = {Bone reduction with stackable surgical guides: an evolving digital workflow},
