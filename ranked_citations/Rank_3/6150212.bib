@inproceedings{6150212,
 abstract = {Based on extension theory, this paper established a matter-element model describing the process of logistics resource infrastructure as extension conversion, which transformed some under-efficient resource into efficient ones in resource universe. There are five basis extension conversions in the model, including replacement, increase or decrease, enlargement or reductioned, decomposition decomposed and copy. By conversing the element in resource universe, relation maxim and universe quantitatively, the countermeasure of logistics infrastructure resources integration was put forward, such as function orientation, rectification, merge, cooperation and so on. Finally, the result of integration was evaluated by the correlation function. It proved that the matter-element model could provide decision basis quantitatively for logistics infrastructure resources integration.},
 author = {Jianguo, Gong and Xiucheng, Guo and Lichao, Guo and Jie, Yang},
 booktitle = {2012 Fifth International Conference on Intelligent Computation Technology and Automation},
 doi = {10.1109/ICICTA.2012.93},
 issn = {},
 keyword = {Correlation;Supply chains;Transportation;Cities and towns;Resource management;Logistics Infrastructure;Resources Integration;Matter-element Model;Extension Conversion;Correlation Function;Priority-degree evaluation},
 month = {Jan},
 number = {},
 pages = {348-351},
 title = {The Method of Regional Logistics Infrastructure Resources Integration Based on Extension Theory},
 volume = {},
 year = {2012}
}
