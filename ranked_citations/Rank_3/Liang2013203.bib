@conference{Liang2013203,
 abstract = {In order to build a practical semantic dictionary which will play an important role in the field of Chinese information processing, a Chinese semantic dictionary with a simple structure TH-CSD has been built in this paper. First, the architecture of the TH-CSD converted from TongYiCi Cilin extended version is introduced. Then the algorithm of integrating the data of HowNet based on synonyms or similar words into TH-CSD is proposed, and the automatic results produced by the proposed algorithms are manually corrected. Lastly, for better understanding of the data in the TH-CSD, an online system for the TH-CSD is introduced. © 2013 IEEE.},
 author = {Liang, Chunxia and Shao, Yanqiu and Zhao, Jing},
 doi = {10.1109/WI-IAT.2013.184},
 journal = {Proceedings - 2013 IEEE/WIC/ACM International Joint Conference on Web Intelligence and Intelligent Agent Technology - Workshops, WI-IATW 2013},
 note = {Cited by: 5},
 pages = {203 - 207},
 publication_stage = {Final},
 source = {Scopus},
 title = {Construction of a Chinese semantic dictionary by integrating two heterogeneous dictionaries: TongYiCi Cilin and HowNet},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84893228640?origin=resultslist},
 volume = {3},
 year = {2013}
}
