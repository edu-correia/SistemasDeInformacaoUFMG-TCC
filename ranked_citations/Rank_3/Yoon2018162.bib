@conference{Yoon2018162,
 abstract = {Today’s cloud database systems are not designed for seamless cost-performance trade-offs for changing SLOs. Database engineers have a limited number of trade-offs due to the limited storage types offered by cloud vendors, and switching to a different storage type requires a time-consuming data migration to a new database. We propose Mutant, a new storage layer for log-structured merge tree (LSM-tree) data stores that dynamically balances database cost and performance by organizing SSTables (files that store a subset of records) into different storage types based on SSTable access frequencies. We implemented Mutant by extending RocksDB and found in our evaluation that Mutant delivers seamless cost-performance trade-offs with the YCSB workload and a real-world workload trace. Moreover, through additional optimizations, Mutant lowers the user-perceived latency significantly compared with the unmodified database. © 2018 Association for Computing Machinery.},
 author = {Yoon, Hobin and Sigurdarson, Steinn E. and Yang, Juncheng and Vigfusson, Ymir and Kristjansson, Sveinn Fannar and Gavrilovska, Ada},
 doi = {10.1145/3267809.3267846},
 journal = {SoCC 2018 - Proceedings of the 2018 ACM Symposium on Cloud Computing},
 note = {Cited by: 24},
 pages = {162 - 173},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mutant: Balancing storage cost and latency in LSM-tree data stores},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85059018851?origin=resultslist},
 year = {2018}
}
