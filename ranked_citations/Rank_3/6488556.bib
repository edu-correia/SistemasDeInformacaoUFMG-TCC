@inproceedings{6488556,
 abstract = {The depth information in multiview 3D video sequences are mainly utilized to synthesize new video sequences at virtual view points. Decoded depth maps, however, have typical coding artifacts such as blocking noise according to the compression ratio. Furthermore, depth maps are even resized to reduce the size of compressed bitstreams. Defects in depth maps degrade the quality of synthesized view. This paper proposes a depth resampling method as post processing for encoding/decoding of mixed resolution multiview 3D videos. Different filtering approaches are applied according to the type of depth map. Gray scale dilation filter is applied to graphics depth data to directly remove artifact in synthesized view, and segmentation based filter is applied to estimated or measured depth data to enhance edge and to reduce the compression noise. Experimental result using MPEG reference software shows that the BD bitrate gain in terms of synthesized PSNR is -5.69% for 7 test sequences.},
 author = {Seok Lee and Seungsin Lee and Hochen Wey and Jaejoon Lee and Dusik Park},
 booktitle = {2013 IEEE 10th Consumer Communications and Networking Conference (CCNC)},
 doi = {10.1109/CCNC.2013.6488556},
 issn = {2331-9860},
 keyword = {Graphics;Filtering algorithms;Filtering;Image edge detection;Clustering algorithms;Three-dimensional displays;Encoding;view synthesis;depth filtering;free viewpoint video},
 month = {Jan},
 number = {},
 pages = {827-832},
 title = {Depth resampling for mixed resolution multiview 3D videos},
 volume = {},
 year = {2013}
}
