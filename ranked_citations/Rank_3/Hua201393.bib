 abstract = {A search task represents an atomic information need of a user in web search. Tasks consist of queries and their reformulations, and identifying tasks is important for search engines since they provide valuable information for determining user satisfaction with search results, predicting user search intent, and suggesting queries to the user. Traditional approaches to identifying tasks exploit either temporal or lexical features of queries. However, many query refinements are topical, which means that a query and its refinements may not be similar on the lexical level. Furthermore, multiple tasks in the same search session may interleave, which means we cannot simply order the searches by their timestamps and divide the session into multiple tasks. Thus, in order to identify tasks correctly, we need to be able to compare two queries at the semantic level. In this paper, we use a knowledgebase known as Probase to infer the conceptual meanings of queries, and automatically identify the topical query refinements in the tasks. Experimental results on real search log data demonstrate that Probase can indeed help estimate the topical affinity between queries, and thus enable us to merge queries that are topically related but dissimilar at the lexical level. © 2013 ACM.},
 author = {Hua, Wen and Song, Yangqiu and Wang, Haixun and Zhou, Xiaofang},
 doi = {10.1145/2433396.2433410},
 journal = {WSDM 2013 - Proceedings of the 6th ACM International Conference on Web Search and Data Mining},
 note = {Cited by: 33},
 pages = {93 - 102},
 publication_stage = {Final},
 source = {Scopus},
 title = {Identifying users' topical tasks in web search},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84874231980?origin=resultslist},
 year = {2013}
}
