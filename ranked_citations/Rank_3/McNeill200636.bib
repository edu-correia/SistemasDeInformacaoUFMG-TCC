 author = {McNeill, Fiona and Halpin, Harry and Klein, Ewan and Bundy, Alan},
 journal = {EACL 2006 - 11th Conference of the European Chapter of the Association for Computational Linguistics, Proceedings of the Workshop on KRAQ 2006: Knowledge and Reasoning for Language Processing},
 note = {Cited by: 5},
