 issn = {0198-8859},
 journal = {Human Immunology},
 keyword = {HLA donor specific antibodies, HLA-DSA, HLA antibodies, HLA-Ab, Allograft rejection, Blood transfusion, Kidney transplant recipients},
 number = {7},
