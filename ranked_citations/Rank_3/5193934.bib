@inproceedings{5193934,
 abstract = {The ontology has an important role in the sharing and interoperability of geographic information and services. At present, the ontology merging usually needs people to participate in. To avoid this insufficient, this paper studies the model of ontology merging at first, and then gives an approach to merge ontology automatically. The core idea of the approach is, firstly, use the ontology similarity algorithm to determine the relationship between the local ontology, and then take the advantage of concept lattice to describe the logical relationship of local ontology, eventually build a global ontology and give the relationships between the global ontology and local ontology for ontology automatic merging. The approach is analyzed in the last of the paper.},
 author = {Li, Shixiang and Fan, Hong and Wang, Yuli and Hong, Liang},
 booktitle = {2009 International Joint Conference on Computational Sciences and Optimization},
 doi = {10.1109/CSO.2009.365},
 issn = {},
 keyword = {Ontologies;Merging;Lattices;Formal specifications;Geoscience and remote sensing;Geology;Remote sensing;Face recognition;Earth;Costs},
 month = {April},
 number = {},
 pages = {214-217},
 title = {A Model and Approach for Heterogeneous Ontology Automatic Merging},
 volume = {2},
 year = {2009}
}
