@conference{Patil201230,
 abstract = {Modern cluster file systems provide highly scalable I/O bandwidth along the data path by enabling highly parallel access to file data. Unfortunately metadata scaling is lagging far behind data scaling. We propose a filesystem design that inherits the scalable data bandwidth of existing cluster file systems and adds support for distributed and high-performance metadata operations. Our idea is to integrate a distributed indexing mechanism with general-purpose optimized on-disk metadata store. To demonstrate the feasibility of our approach, we implemented prototype middleware using the FUSE file system and evaluated it on 64-node cluster. Preliminary results show promising scalability and performance: the single-node metadata store was 10X faster than modern local file systems and the distributed middleware prototype scales to a peak performance of 190,000 file creates per second on a 64-server configuration. © 2012 IEEE.},
 author = {Patil, Swapnil and Ren, Kai and Gibson, Garth},
 doi = {10.1109/SC.Companion.2012.372},
 journal = {Proceedings - 2012 SC Companion: High Performance Computing, Networking Storage and Analysis, SCC 2012},
 note = {Cited by: 9},
 pages = {30 - 35},
 publication_stage = {Final},
 source = {Scopus},
 title = {A case for scaling HPC metadata performance through de-specialization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84876584176?origin=resultslist},
 year = {2012}
}
