@inproceedings{11309639,
 abstract = {This paper presents the UIT legalGrep Team's solution for the 5th Automated Legal Question Answering Competition (ALQAC 2025), which focuses on two main tasks: Legal Document Retrieval and Legal Question Answering. For the Legal Document Retrieval task, we proposed a framework that combines a Local Retrieval Module and a Global Retrieval Module. The Local Retrieval Module leverages a category classifier to select relevant legal domains, followed by specialized retrieval within each selected category. In parallel, the Global Retrieval Module integrates both lexical retrieval and semantic retrieval methods to capture relevant documents from the entire collection. The outputs from both modules are merged via a rank fusion strategy and subsequently reranked to produce the final set of relevant legal documents. For the Legal Question Answering task, large language models (LLMs) are employed to generate precise answers based on the relevant legal context. Our approach achieved 2nd place in the Legal Document Retrieval task (F2-score: 89.70 %) and 12th place in the Legal Question Answering task (accuracy: $\mathbf{7 5. 6 1 \%}$), demonstrating the effectiveness of our modular retrieval strategy.},
 author = {Huynh, Hieu M. and Nguyen, Lam M. H. and Pham, Thang Q. and Mai, Khang Huy and Van Nguyen, Kiet},
 booktitle = {2025 17th International Conference on Knowledge and System Engineering (KSE)},
 doi = {10.1109/KSE68178.2025.11309639},
 issn = {2694-4804},
 keyword = {Knowledge engineering;Accuracy;Law;Semantic search;Large language models;Pipelines;Knowledge graphs;Systems engineering and theory;Question answering (information retrieval);Cognition;ALQAC2025;Legal Document Retrieval;Legal Question Answering;Large Language Model},
 month = {Nov},
