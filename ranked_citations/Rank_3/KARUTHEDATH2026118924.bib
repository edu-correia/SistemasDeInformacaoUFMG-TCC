@article{KARUTHEDATH2026118924,
 abstract = {We present an adaptive isogeometric framework for reaction-diffusion (RD) driven topology optimization (TO) that combines CAD-exact geometry representation, multi-patch isogeometric analysis (IGA) and local, hierarchical h-refinement. Geometry is retained in the native NURBS description while the analysis field is discretised with Polynomial Splines over Hierarchical T-meshes (PHT-splines) via the GIFT mapping, permitting adaptive mesh refinement (AMR) without altering the design geometry. The RD-TO framework uses a coupled reaction and diffusion terms to evolve a smooth material field, producing well-defined material-void boundaries and allowing features to appear, merge or vanish naturally without ad-hoc filtering or explicit topology operations. Design variables are defined at control points and mapped to quadrature points to interpolate stiffness and form sensitivities, giving a smooth, continuous material distribution profile. For the AMR, a density-gradient based marking strategy, coupled with patch-conforming and data projection operation, sharpens the material-void transitions and reduces intermediate gray regions. The implementation supports general multi-patch spline geometries and is demonstrated on a suite of two- and three-dimensional benchmarks. Results demonstrate robust hole-nucleation behaviour, improved sensitivity fidelity provided by spline bases, and substantial reductions in global parameters and computational work compared with uniform refinement. Across the range of problems considered, our method reduced the active degrees of freedom by over 90 % compared to uniform refinement. This also resulted in significant per-iteration speedups of over 500 ×  in 2D and 22 ×  in 3D. These computational savings are achieved without compromising design quality, producing smooth, well-defined topologies that match established solutions. The results show that RD-based topology evolution and CAD-exact IGA can be combined with hierarchical adaptivity to produce manufacturable designs at significantly reduced computational cost.},
 author = {Philip Luke Karuthedath and Abhinav Gupta and Rajib Chowdhury},
 doi = {https://doi.org/10.1016/j.cma.2026.118924},
 issn = {0045-7825},
 journal = {Computer Methods in Applied Mechanics and Engineering},
 keyword = {Topology optimization, Isogeometric analysis, Reaction-diffusion equation, Adaptive mesh refinement, Multi-patch, PHT-splines},
 pages = {118924},
 title = {An adaptive isogeometric framework for topology optimization based on a reaction-diffusion equation},
 url = {https://www.sciencedirect.com/science/article/pii/S0045782526001970},
 volume = {456},
 year = {2026}
}
