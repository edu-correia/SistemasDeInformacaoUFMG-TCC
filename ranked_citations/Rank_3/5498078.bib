@inproceedings{5498078,
 abstract = {Six new chaotic attractors in a solely-single-coefficient jerk model are presented with new coefficients and new arctangent nonlinearity. In addition, compound structures of such new attractors are demonstrated through the use of a half-image operation using a control parameter h. The positively appropriate value of h isolates the right half-image attractors whilst the negatively appropriate value of h isolates the left half-image attractor. Both images can then be merged together as a compound structure. Examples of bifurcation diagrams, Poincarè maps and maximum Lyapunov exponent have also been demonstrated.},
 author = {Siriburanon, Teerachot and Srisuchinwong, Banlue and Nontapradit, Teera},
 booktitle = {2010 Chinese Control and Decision Conference},
 doi = {10.1109/CCDC.2010.5498078},
 issn = {1948-9447},
 keyword = {Chaos;Hysteresis;Frequency;Nonlinear dynamical systems;Linear systems;Technological innovation;Perturbation methods;Chaos;Jerk Model;Compound Structures;Arctangent Nonlinearity;Maximum Lyapunov Exponent},
 month = {May},
 number = {},
 pages = {985-990},
 title = {Compound structures of six new chaotic attractors in a solely-single-coefficient jerk model with arctangent nonlinearity},
 volume = {},
 year = {2010}
}
