@article{DEHLI2025103251,
 abstract = {In vivo bioprinting strategies aim at facilitating immediate integration of engineered tissues with the host’s biological system. As integral parts of current bioprinting technologies, bioinks and robotics should be holistically considered for new biomedical applications. This implies that chosen bioinks should exhibit rheological properties that are compatible with the fabrication method and vice versa, bioprinting tools might need to be redesigned and reconstructed to fit the characteristics of the needed bioinks that after solidification act as supporting matrices for living cells. In this piece, we identify current challenges in merging the best of these two principles, we highlight relevant studies that have addressed this need, and we propose ideas how to approach this challenge in the next years.},
 author = {Friederike Dehli and Oscar {O'Dwyer Lancaster-Jones} and Daniela {Duarte Campos}},
 doi = {https://doi.org/10.1016/j.copbio.2024.103251},
 issn = {0958-1669},
 journal = {Current Opinion in Biotechnology},
 pages = {103251},
 title = {Optimizing the value of bioinks and robotics to advance in vivo bioprinting},
 url = {https://www.sciencedirect.com/science/article/pii/S0958166924001873},
 volume = {91},
 year = {2025}
}
