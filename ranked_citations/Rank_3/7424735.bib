@inproceedings{7424735,
 abstract = {Thread parallelism of sorting algorithms is studied. The OpenMP directives are implemented into three opensource sorting algorithms, i.e., merge sort, quick sort, and counting sort. The merge sort and the quick sort adopt a recursive algorithm and are thread-parallelized with the "OMP TASK" directive which is supported over OpenMP 3.0. It is found that the switching to O(n2) sorting algorithms effectively accelerate the recursive sorting algorithms parallelized with the "OMP TASK" directive. The counting sort parallelized with the "OMP DO" directive give both faster computational speed and higher scalability than the two recursive sorting algorithms. However, the parallel counting sort requires additional memory spaces that increase in proportion to the number of threads.},
 author = {Umeda, Takayuki and Oya, Shuhei},
 booktitle = {2015 Third International Symposium on Computing and Networking (CANDAR)},
 doi = {10.1109/CANDAR.2015.25},
 issn = {2379-1896},
 keyword = {Sorting;Algorithms;Instruction sets;Message systems;Scalability;Histograms;Merging;sorting;OpenMP;performance measurement},
 month = {Dec},
 number = {},
 pages = {334-340},
 title = {Performance Comparison of Open-Source Parallel Sorting with OpenMP},
 volume = {},
 year = {2015}
}
