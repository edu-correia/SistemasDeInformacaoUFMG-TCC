@inproceedings{10923464,
 abstract = {Due to its particular difficulties, multimorbidity—the living together of multiple chronic ailments in one person—requires expert care. Because they based themselves on single-disease models, present-day medical systems are frequently finding it difficult to meet the complicated needs of multimorbid patients. A basic amendment to how medical study and treatment are handled is important in order to enhanced how people make choices and care for people in this situation. An innovative method that deviates coming from conventional simplified techniques mixes intelligent machines (AI) with advanced big data metrics via live research. This approach uses widely gathered personal medical information to provide a full platform for study activities involving multimorbidity, including labeling, association, and predicting based on a number of interaction factors. The effective operation, standards, and particularly, for the merging of digital medical records into the same national while worldwide study infrastructure are necessary conditions for this evolution in method to occur. Above all else, it's critical that successful AI techniques—in specifically, deep learning—be effortlessly merged into medical their processes. This new method has the ability to totally change the topic of multimorbidity study, opening up the door to improve interactions between patients and better healthcare service.},
 author = {Raja, M. A. and Kumhar, Bhupchand and Femilin Jana, D Little and Al-Farouni, Mohammed and Kuppuraj, T. and Jaiganesh, S.},
 booktitle = {2024 International Conference on IoT, Communication and Automation Technology (ICICAT)},
 doi = {10.1109/ICICAT62666.2024.10923464},
 issn = {},
 keyword = {Merging;Medical services;Machine learning;Big Data;Teamwork;Risk management;Reliability;Standards;Monitoring;Diseases;Multimorbidity;Healthcare;Machine Learning;Big Data;Chronic Diseases;Medical Research;Complex Systems;Data Analytics;Artificial Intelligence;Patient Outcomes},
 month = {Nov},
 number = {},
 pages = {736-741},
 title = {An Integration of Machine Learning and Big Data In for The Purpose of Healthcare and Its Impact},
