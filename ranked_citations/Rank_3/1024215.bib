@inproceedings{1024215,
 abstract = {We consider off-line versions of path provisioning and path protection problems for general circuit switched networks. Both problems deal with a given network topology and a list of integral demand flows. The objective is to route the flows and to allocate the bandwidth in a way that minimizes the total amount of bandwidth used for working and protection paths. We consider path-based protection where, in the case of a single link failure, all the flows utilizing the failed link can be rerouted to a precomputed set of paths. We demonstrate that flow splitting can bring significant advantages for both provisioning and protection problems. Since the problem is NP-complete, we propose and analyze two simple heuristics. We show that one of these heuristics performs almost as well as the optimal solution.},
 author = {Izmailov, R. and Niculescu, D.},
 booktitle = {Workshop on High Performance Switching and Routing, Merging Optical and IP Technologie},
 doi = {10.1109/HPSR.2002.1024215},
 issn = {},
 keyword = {Protection;Bandwidth;Switching circuits;Image motion analysis;Routing;Network topology;Wavelength division multiplexing;Switches;National electric code;Laboratories},
 month = {May},
 number = {},
 pages = {93-98},
 title = {Flow splitting approach for path provisioning and path protection problems},
 volume = {},
 year = {2002}
}
