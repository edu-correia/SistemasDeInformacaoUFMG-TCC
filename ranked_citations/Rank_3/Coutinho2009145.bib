@article{Coutinho2009145,
 abstract = {Currently, the design and running of a Multi-Agent System (MAS) mobilize several models. Besides agents' architectures, high level agent communication languages and domain ontologies, explicit organization specifications (written in some organizational model) are more and more used to structure and constrain the behavior of MASs. In the case of open MASs, one important requirement is interoperability w.r.t. these models. Focusing organizational model interoperability, in this paper, we propose an integration process for organizational models based on concepts (models, mappings, transformations, etc.) and techniques (Match, Merge, TransfGen, Compose, etc.) from Model-Driven Engineering (MDE). The process is concretely used to integrate five organizational models: AGR,MOISE+, TEMS, ISLANDER and OperA.},
 author = {Coutinho, Luciano R. and Brandão, Anarosa A.F. and Sichman, Jaime S. and Boissier, Olivier},
 doi = {10.1007/978-3-642-01338-6_11},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3},
 pages = {145 - 158},
 publication_stage = {Final},
 source = {Scopus},
 title = {Model-driven integration of organizational models},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/67649982537?origin=resultslist},
 volume = {5386},
 year = {2009}
}
