@article{11320269,
 abstract = {The growing demand for flawless printed circuit boards (PCBs) necessitates highly precise and reliable defect detection technologies. However, the tiny size of defects, complex textures, and irregular geometries present major challenges to existing vision-based approaches. To overcome these limitations, this study introduces MSMD-YOLO, an enhanced detection framework developed as a next-generation extension of YOLOv11 for PCB inspection. The proposed Multi-Scale Feature Merging (MSFM) module enables comprehensive fusion of structural information across multiple scales, enriching fine-grained feature representation and detail extraction. In parallel, MDA-Attention enhances channel-wise and spatial attention mechanisms with dilated convolutions, leading to dramatic improvements in semantic discriminatability and spatial awareness, with minimal computational overhead. Moreover, Weighted  $IoU$ ( $WIoU$ ) loss incorporates adaptive attention to give preference to anchors with medium quality and small/low-quality defects for enhanced localization. Performance comparison with YOLOv11 indicates that MSMD-YOLO has a clear-cut edge, with improvements in mean average precision ( $mAP$ ) by 5.0% and 3.2% on Peking University and DeepPCB datasets, respectively. The final  $mAP$  values achieved were 92.9% and 98.4%, respectively. The proposed model significantly reduces both false positives and missed defects, making it robust and trustworthy for accurate inspection and quality control in a modern PCB manufacturing system.},
 author = {Deng, Chan and Rahman, Ribhan Zafira Abdul and Ishak, Asnor Juraiza and Ahmad, Raja Mohd Kamil Raja},
 doi = {10.1109/ACCESS.2025.3649799},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {Feature extraction;Printed circuits;Accuracy;Defect detection;Optimization;Location awareness;Inspection;Robustness;Neck;Computer architecture;Small target detection;multi-scale features;attention mechanism;loss function optimization},
 month = {},
 number = {},
 pages = {32970-32982},
 title = {MSMD-YOLO: Enhanced Printed Circuit Board Defect Detection With a Multi-Scale Merging and Attention Network},
 volume = {14},
 year = {2026}
}
