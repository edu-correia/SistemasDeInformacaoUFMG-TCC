@inproceedings{5662268,
 abstract = {The report form is the enterprise application system's important component, the outstanding report form may carry on the filtration, the merge, the statistics, the analysis to the essential data, providing an intuitive form of expression and provides the good basis for the decision-making. At present the Major industry relative is not mature based on the B/S report form system development pattern, the development personnel are mostly write the code according to the physical demand to realize the data analysis, processing, the development function directly, such will realize the way to do the repetition work, for instance in many projects will need through the report data and the graph unfolds the service tendency, as for the development time granularity, the region granularity, the data latitude and the target will be actually various, the result will be different. In the project the similar functional need repeatedly develops, summarizes is the reusability low, the extendibility difference, the maintainability is bad, the development cost is high. In order to solve the above problem, this article proposed that carries on the top level to the current service demand the abstract, realizes one to be able to unify the analytical data, the processing data, the development information report form engine, this report form engine concentrates service logic realization, with the concrete service separation, can help the development personnel to construct the report form application system stably fast. Has applied based on this report form engine development's report form system in some provincial level telecommunication operator, looked from a period of time's operational aspect, the systems operation is stable, the extendibility is good, in the multi-user concurrent inquiry, in the great data quantity inquiry's situation, the system performance satisfies the user's needs, obtained user's approval and the high praise. Because introduces this report form engine, the report form system's development cycle reduces largely, the development and the maintenance cost reduced largely, have achieved system's development goal.},
 author = {He, Yongjun and Gong, Fagen},
 booktitle = {2010 International Conference on Web Information Systems and Mining},
 doi = {10.1109/WISM.2010.96},
 issn = {},
 keyword = {Engines;XML;Databases;Data models;Business;Data processing;Computers;Statements;engines;large-scale enterprises},
 month = {Oct},
 number = {},
 pages = {235-238},
 title = {Design and Implementation of the Large Enterprise Reporting Engine},
 volume = {2},
 year = {2010}
}
