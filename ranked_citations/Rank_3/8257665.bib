@inproceedings{8257665,
 abstract = {Data on the web are dependent on human control and still in a human-readable format only. Web data should be in a machine-readable format so that the semantic web agent can understand the data. Large amounts of data on the web are stored in relational databases (RDBs) and should be represented in Resource Description Framework (RDF) format so that they can be understood by the agent. This paper proposes an approach to map multiple RDBs to RDF and is accompanied by additional rules to make relationships between data and tables explicit. The proposed system integrates databases so that the data can be accessed simultaneously using a single query. The results show that the proposed system is able to give the conclusions that were not defined before without changing the DB schemas. The application of additional rules helps search engines to answer more queries. In the scenario, the additional rule can draw a conclusion about interest relation between student and grade data. The experiment also shows that merging two databases can process integrated information using a single SELECT query.},
 author = {Julianita, Atleiya and Nugroho, Saptadi and Yohanes, Banu Wirawan},
 booktitle = {2017 4th International Conference on Information Technology, Computer, and Electrical Engineering (ICITACEE)},
 doi = {10.1109/ICITACEE.2017.8257665},
 issn = {},
 keyword = {Resource description framework;Tools;Ontologies;Databases;Search engines;Merging;semantic;RDF;RDB;SPARQL;D2RQ},
 month = {Oct},
 number = {},
 pages = {5-8},
 title = {Mapping multiple databases to resource description framework with additional rules as conclusions drawer},
 volume = {},
 year = {2017}
}
