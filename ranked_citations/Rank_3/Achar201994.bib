@conference{Achar201994,
 abstract = {Debugging distributed systems is hard. Most of the techniques that have been developed for debugging such systems use either extensive model checking, or postmortem analysis of logs and traces. Interactive debugging is typically a tool that is only effective in single threaded and single process applications, and is rarely applied to distributed systems. While the live observation of state changes using interactive debuggers is effective, it comes with a host of problems in distributed scenarios. In this paper, we discuss the requirements an interactive debugger for distributed systems should meet, the role the underlying distributed model plays in facilitating the debugger, and the implementation of our interactive debugger: GoTcha. GoTcha is a browser based interactive debugger for distributed systems built on the Global Object Tracker (GoT) programming model. We show how the GoT model facilitates the debugger, and the features that the debugger can offer. We also demonstrate a typical debugging workflow. © 2019 Copyright held by the owner/author(s). Publication rights licensed to ACM.},
 author = {Achar, Rohan and Dawn, Pritha and Lopes, Cristina V.},
 doi = {10.1145/3359591.3359733},
 journal = {Onward! 2019 - Proceedings of the 2019 ACM SIGPLAN International Symposium on New Ideas, New Paradigms, and Reflections on Programming and Software, co-located with SPLASH 2019},
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 pages = {94 - 110},
 publication_stage = {Final},
 source = {Scopus},
 title = {Gotcha: An interactive debugger for got-based distributed systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85076750728?origin=resultslist},
 year = {2019}
}
