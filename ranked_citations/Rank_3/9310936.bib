@inproceedings{9310936,
 abstract = {This paper describes a semi-automatic, translation-based, expansion approach for Khmer WordNet construction. Our approach considers and expands the Princeton English WordNet's synsets and takes into account the existing cross-language machine-readable dictionaries in which the translations between Khmer and English words are provided. The approach automatically developed and deployed a model, which is verified by a small number of experts. As a result, our Khmer WordNet has been constructed with promising coverage and accuracy.},
 author = {Phon, Udorm and Pluempitiwiriyawej, Charnyote},
 booktitle = {2020 - 5th International Conference on Information Technology (InCIT)},
