@inproceedings{6026678,
 abstract = {In this paper, a general architecture for analog implementation of LTA/WTA and other rank-order circuits is presented. This architecture composed of a differential amplifier with merged n-inputs and a MCSAL circuit to choose the desired input. The advantages of the proposed structure are simplicity, high operating frequency, very high resolution, very low supply voltage requirements, very low output resistance, low power dissipation, low active area and simple expansion for multiple inputs by adding only three transistors for each extra input. Post-layout simulation results of proposed circuits are presented by HSPICE software in 0.35μm CMOS process technology. The total power dissipation of proposed circuits is about 110μW. Also, the total active area is about 550μm2 for five-input proposed circuits, and would be negligibly increased for each extra input.},
 author = {Soleimani, Mohammad and Nazaraliloo, Mohammad},
 booktitle = {2011 IEEE 54th International Midwest Symposium on Circuits and Systems (MWSCAS)},
 doi = {10.1109/MWSCAS.2011.6026678},
 issn = {1558-3899},
 keyword = {GSM;Resistors;Dynamic range;Frequency modulation},
 month = {Aug},
 number = {},
 pages = {1-4},
 title = {Voltage-mode loser/winner-take-all circuits},
 volume = {},
 year = {2011}
}
