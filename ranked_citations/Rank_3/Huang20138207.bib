@article{Huang20138207,
 abstract = {In order to meet the individualization needs, software manufacturing companies have developed a number of individualized services. However, it leads to a lot of redundant software products and low production efficiency. In addition, it cannot quickly and efficiently respond to changes in demand. In order to solve above problems, the concept of configurable process model was proposed. Given a configurable process model, analysts are able to define a configuration of this model by assigning values to its variation points based on a set of requirements. Once a configuration is defined, the model can be individualized. Because OWL-S is a language on the semantic Web which can describe the service process, it's selected as the carrier of the business processes of this article. In this paper, we propose the feature structure tree of the OWL-S process which extracts the process features in OWL-S. Meanwhile, based on the superimposition method, the consolidation method of process feature structure tree is proposed which can realize the consolidation of processes. © 2013 Binary Information Press.},
 author = {Huang, Ying and Li, Wei},
 doi = {10.12733/jcis7035},
 journal = {Journal of Computational Information Systems},
 note = {Cited by: 0},
 number = {20},
 pages = {8207 - 8215},
 publication_stage = {Final},
 source = {Scopus},
 title = {Service-based business process merge using process feature structure tree},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84887364509?origin=resultslist},
 volume = {9},
 year = {2013}
}
