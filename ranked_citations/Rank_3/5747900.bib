@inproceedings{5747900,
 abstract = {The study on the agriculture model component information resources sharing mode is the basis for the retrieval and management of the agriculture model components in the distributed environment. This study proposed a new approach to use topic map matching and merging to generate the global model documents. First of all, it unified described the attributes, associations and file descriptive information of the agriculture model components, formed the model meta-topic map (MMTM)documents by using the XTM notation, built the local atomic topic map (LATM) documents for the specific model components by using the instance method. Lastly, by using the character matching and merging method of topic information, the different LATMs of the same type models are combined to the sharing global atomic topic map (GATM) documents. The study presented the detail application case, which is about the information merging and XTM document generation on the wheat development model components. The study provided a reference solution about the global information sharing mode research of the agriculture model components in the distributed environment.},
 author = {Jiang, Haiyan and Zhang, Mei and Fu, Bing and Zhu, Yan and Cao, Weixin},
 booktitle = {2011 International Conference on Computer Distributed Control and Intelligent Environmental Monitoring},
 doi = {10.1109/CDCIEM.2011.382},
 issn = {},
 keyword = {Biological system modeling;Agriculture;Data models;Merging;Ontologies;Semantics;Computational modeling;agriculture model;model;XTM;topic map merging},
 month = {Feb},
 number = {},
 pages = {650-654},
 title = {The Realization of Agriculture Model Component Sharing through Topic Map Merging},
 volume = {},
 year = {2011}
}
