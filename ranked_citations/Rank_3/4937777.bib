@inproceedings{4937777,
 abstract = {Wireless networks based on the WiMedia specifications provide a good way to build low cost and robust networks with considerably high data rates. This work investigates the limits of these networks, especially in terms of scalability and time behavior. With a WiMedia MAC (media access control) protocol simulator we analyzed scenarios with up to 80 simultaneous nodes per channel and identify situations where the efficiency of the protocol degrades. The simulations are followed by an investigation of the situations and we present ideas to modify the protocol to increase the performance in environments with dense nodes deployment.},
 author = {Leipold, Frank and Bovelli, Sergio and Brandner, Simon and Muller-Rathgeber, Bernd},
 booktitle = {2008 2nd International Symposium on Advanced Networks and Telecommunication Systems},
 doi = {10.1109/ANTS.2008.4937777},
 issn = {2153-1684},
 keyword = {Media Access Protocol;Wireless application protocol;Aircraft;Access protocols;Vehicles;Wireless sensor networks;Robustness;Wireless communication;Aerospace electronics;Energy states},
 month = {Dec},
 number = {},
 pages = {1-3},
 title = {Performance evaluation of the WiMedia MAC protocol in high density wireless environments},
 volume = {},
 year = {2008}
}
