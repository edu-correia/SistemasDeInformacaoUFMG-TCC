@inproceedings{7033849,
 abstract = {Mobile wireless networks increase in popularity and pervasiveness, we are faced with the problem of merging a diverse number of wireless networks. The wireless communications of fourth generation is expected to combine a potentially large number of heterogeneous wireless technologies in what could be considered a vast step forward toward universal seamless access. One of the main problems for seamless mobility is the availability of reliable horizontal (intrasystem) and vertical (intersystem) handover strategy. Next generation heterogeneous wireless networks present the end users with guarantee of QoS inside each access network as well as during vertical handover between them. For assurance QoS, the vertical handover algorithm must be QoS aware, which cannot be reach with the utilized of traditional RSS as the vertical handoff criteria. Systematic handoff schemes enhance quality of service and provide flawless mobility. Discusses handoff related topic of fourth generation systems. Desirable handover features are presented.},
 author = {Tinkhede, Pooja and Ingole, Piyush},
 booktitle = {International Conference on Information Communication and Embedded Systems (ICICES2014)},
 doi = {10.1109/ICICES.2014.7033849},
 issn = {},
 keyword = {Handover;Base stations;Mobile communication;Wireless networks;Mobile computing;heterogeneous wireless networks;horizontal handover;vertical handover},
 month = {Feb},
 number = {},
 pages = {1-5},
 title = {Survey of handover decision for next generation},
 volume = {},
 year = {2014}
}
