@inproceedings{6319552,
 abstract = {Meta-search engines are put forward to solve the problem that independent search engines have far too low Internet information coverage rate. Although there are many research literatures about meta-search engines, never a comprehensive analysis research literature about the current situation and market situation of meta-search engines is given. This paper tries to analyze meta-search engines from two aspects: the academic research aspect and the market aspect. In the academic research aspect, the paper mainly focuses on the basic structure and advantages of meta-search engines, as well as researches at home and abroad on the architecture, personality processing mechanism, scheduling mechanism, and merging mechanism of search results of meta-search engines. In the market aspect, the present market situations at home and abroad of meta-search engines are introduced. The ones which have higher market shares are also presented. Finally, problems and solutions of meta-search engines are given from different angles and the development prospects of meta-search engines are also analyzed.},
 author = {Sun, Ying-cheng and Li, Qing-shan},
 booktitle = {2012 2nd International Conference on Uncertainty Reasoning and Knowledge Engineering},
 doi = {10.1109/URKE.2012.6319552},
 issn = {},
 keyword = {Engines;Metasearch;Search engines;Internet;Web pages;Indexes;Meta-Search Engines;Research Situation Analysis;Market Prospect Analysis},
 month = {Aug},
 number = {},
 pages = {224-229},
 title = {The research situation and prospect analysis of meta-search engines},
 volume = {},
 year = {2012}
}
