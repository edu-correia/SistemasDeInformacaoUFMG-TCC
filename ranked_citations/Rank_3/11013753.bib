@inproceedings{11013753,
 abstract = {The integration of Low Power Instrument Transformers (LPITs) into medium and high-voltage switchgear marks a significant advancement in relay protection systems. Offering notable advantages over conventional instrument transformers, such as reduced size, absence of saturation, and enhanced safety, LPITs are becoming increasingly prevalent. This paper explores the challenges and innovations in field-testing protection systems equipped with LPITs. Unlike traditional systems, LPITs do not utilize standard 1A/5A and 100V/110V outputs, necessitating the development of specialized test kits that accommodate LPIT-specific analog outputs. We detail the creation and application of a new secondary injection test kit designed to support LPITs effectively. Additionally, the paper discusses various testing methodologies that have been adapted to validate the functionality and accuracy of LPITs within operational settings. Our findings highlight the critical role of precise testing equipment and methodologies in ensuring the reliability and effectiveness of modern protection systems enhanced by LPIT technology.},
 author = {Mani, Dhanabal and Thota, Sai Chandra Reddy and Gonzalez, Abel},
 booktitle = {2025 78th Annual Conference for Protective Relay Engineers (CFPR)},
 doi = {10.1109/CFPR67343.2025.11013753},
 issn = {2474-9745},
 keyword = {Technological innovation;Accuracy;Voltage transformers;Protective relaying;High-voltage techniques;Reliability;Protection;IEC Standards;Standards;Testing;Low Power Instrument Transformer (LPIT);secondary injection test kit;Low Power Relay Test set;LPRT;Low Power Voltage Transformer;LPVT;MU;Merging Units;IED;Intelligent Electronic Device;Fault Recorder;IEC 61850-9-2;IEC 61869-10;IEC 61869-11},
 month = {March},
 number = {},
 pages = {1-10},
 title = {Field Testing Challenges and Innovations for LPITs in Relay Protection Systems},
 volume = {},
