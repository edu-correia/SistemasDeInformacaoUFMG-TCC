 issn = {},
 keyword = {Wireless communication;Wireless sensor networks;Quality control;Fourth Industrial Revolution;Sensors;Internet of Things;Servers;Artificial Intelligence;Cloud Computing;Internet of Things;Industry 4.0;Artificial Intelligence of Things},
 month = {Oct},
