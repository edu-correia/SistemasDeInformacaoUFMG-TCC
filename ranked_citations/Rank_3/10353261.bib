@inproceedings{10353261,
 abstract = {Computers have entered thousands of households as a result of the ongoing development of high technology and the progressive rise in people’s living standards. As a result, computers have become an essential component of people’s lives and a must for students. The education sector has once again started off a wave of teaching reform, supporting the flipped classroom teaching style and the merging of online and offline teaching in response to the rapid expansion of the information age and the full support of computers. Many different teaching platforms have grown in response to the requirements of the times and have developed into the fundamental tools for education and instruction in higher education institutions such as colleges and universities. The current way of instruction has experienced a radical transformation in comparison to the more conventional approaches of education. English instruction in higher vocational schools is not, of course, an exception. Teaching English with the assistance of computers in higher vocational colleges has the potential to both boost students’ interest in learning and the effectiveness of English instruction in higher vocational institutions. Teaching English with the assistance of computers has emerged as the dominant methodology in the expansion of higher-level vocational English education. However, despite the fact that computers make studying more convenient, they also provide a number of temptations and difficulties. In this paper, BP neural network method is proposed, after an in-depth analysis has been conducted on the basis of computer-aided technology in higher vocational English education. The goals of this initiative are to advance the logical application of computers in higher vocational English instruction.},
 author = {Zhang, Xiushan},
 booktitle = {2023 4th IEEE Global Conference for Advancement in Technology (GCAT)},
 doi = {10.1109/GCAT59970.2023.10353261},
 issn = {},
 keyword = {Computers;Computational modeling;Education;Neural networks;Merging;Information age;Planning;classroom teaching;vocational English;computer-aided technology;BP neural network algorithm},
 month = {Oct},
