@inproceedings{9884410,
 abstract = {A bridge detection method in polarimetric synthetic aperture radar (SAR) image based on water network construction using the graph model of Markov tree is proposed in this paper. First, branches of the water network are extracted by segmenting the sea and land using region-based level set segmentation method. All water branches are then connected by establishing the probabilistic graph model of Markov tree. Finally, the bridge bodies are recognized by merging the two contours of the adjacent branch pairs, which are represented by the edge of the Markov tree. Polarimetric SAR data acquired by RADARSAT-2 covered in Singapore is used for testing. Experimental results show that the method improves detection rate and false alarm compared to a traditional method.},
 author = {Liu, Chun and Wang, Yanting and Guo, Jia},
 booktitle = {IGARSS 2022 - 2022 IEEE International Geoscience and Remote Sensing Symposium},
 doi = {10.1109/IGARSS46834.2022.9884410},
 issn = {2153-7003},
 keyword = {Bridges;Image segmentation;Radar remote sensing;Image edge detection;Radar detection;Simulated annealing;Markov processes;Bridge detection;Water network construction;Markov tree;Synthetic aperture radar (SAR)},
 month = {July},
 number = {},
 pages = {7879-7882},
 title = {Bridge Detection in Polarimetric SAR Images Based on Water Network Construction},
 volume = {},
 year = {2022}
}
