@article{ALBA2022108475,
 abstract = {OPAL-FEL is a recently developed tool for the modeling of particle accelerators containing wigglers or undulators. It extends the well established 3D electrostatic particle-tracking code OPAL, by merging it with the finite-difference time-domain electromagnetic solver MITHRA. We present results of two benchmark cases where OPAL-FEL simulations are compared to experimental results. Both experiments concern electron beamlines where the longitudinal phase space is modulated with a short magnetic wiggler. Good agreement was found in both the space charge and radiation dominated regimes.},
 author = {Arnau Albà and Jimin Seok and Andreas Adelmann and Scott Doran and Gwanghui Ha and Soonhong Lee and Yinghu Piao and John Power and Maofei Qian and Eric Wisniewski and Joseph Xu and Alexander Zholents},
 doi = {https://doi.org/10.1016/j.cpc.2022.108475},
 issn = {0010-4655},
 journal = {Computer Physics Communications},
 keyword = {Accelerator physics, Wiggler, Radiation, Computational electromagnetics, Microbunching, Electron cooling},
 pages = {108475},
 title = {Benchmarking collective effects of electron interactions in a wiggler with OPAL-FEL},
 url = {https://www.sciencedirect.com/science/article/pii/S0010465522001941},
 volume = {280},
 year = {2022}
}
