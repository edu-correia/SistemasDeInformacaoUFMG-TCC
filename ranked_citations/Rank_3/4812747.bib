@inproceedings{4812747,
 abstract = {Business processes are often implemented by means of software systems which expose them to the user as an externally accessible Web application. This paper describes a technique for recovering business processes by dynamic analysis of the Web applications which ex-pose them. This approach does not require full access to internal software artifacts, such as source code or documentation. The business process is instead inferred through analysis of the GUI-forms exercised by the user during the navigation in the Web application which ex-poses the process. The recovered process is then abstracted by clustering its business tasks according to structural or logical criteria.A preliminary experiment has been conducted with the aim of evaluating understandability and readability of the reverse engineered business processes.},
 author = {Di Francescomarino, Chiara and Marchetto, Alessandro and Tonella, Paolo},
 booktitle = {2009 13th European Conference on Software Maintenance and Reengineering},
 doi = {10.1109/CSMR.2009.26},
 issn = {1534-5351},
 keyword = {Reverse engineering;Application software;Documentation;Data mining;Companies;Software maintenance;Business process re-engineering;Software systems;Data analysis;Navigation;Reverse Engineering;Web Applications;Business Process;Business Process Modeling Notation},
 month = {March},
 number = {},
 pages = {139-148},
 title = {Reverse Engineering of Business Processes exposed as Web Applications},
 volume = {},
 year = {2009}
}
