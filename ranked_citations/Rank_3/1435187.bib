@inproceedings{1435187,
 abstract = {This paper presents a fully CMOS technology integrated capacitive absolute pressure sensor with on-chip switched capacitor integration circuitry for barometric applications. The overall sensor system process merges CMOS IC technology and a bulk micromachining process utilized after the pre-CMOS process, thus it does not change the IC technology sequence. The sensor consists of a switched capacitor interface readout circuit, a sandwich-structured capacitive transducer with a composite-membrane and a reference capacitor, all integrated on the same chip by a standard CMOS process.},
 author = {Min-Xin Zhou and Qing-An Huang and Ming Qin},
 booktitle = {Proceedings. 7th International Conference on Solid-State and Integrated Circuits Technology, 2004.},
 doi = {10.1109/ICSICT.2004.1435187},
 issn = {},
 keyword = {CMOS technology;Integrated circuit technology;Switched capacitor circuits;Capacitive sensors;Switching circuits;CMOS process;CMOS integrated circuits;Sensor systems;Micromachining;Transducers},
 month = {Oct},
 number = {},
 pages = {1816-1819 vol.3},
 title = {A fully CMOS compatible integrated absolute pressure sensor},
 volume = {3},
 year = {2004}
}
