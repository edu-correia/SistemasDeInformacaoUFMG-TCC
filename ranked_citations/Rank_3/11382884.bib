@inproceedings{11382884,
 abstract = {Phishing, which impersonates legitimate sites with fake URLs, is a major cybergang trafficking vector. Phishing URLs can be constructively detected using X-URLIntelNet, a lightweight cyber threat intelligence (CTI)-based explainable ensemble learning system. In two simultaneous channels, a CNN-based encoder finds local patterns of raw URLs and an attention-based multilayer perceptron captures CTI information including robots.txt structure, domain age and usage, and HTTPS. A cross-attention layer merges these branches, and a weighted combination of LightGBM, Explainable Boosting Machine (EBM), and Logistic Rule Regression separates the joint feature representation. To increase transparency, the framework uses SHAP, LIME, and IGAM modules to interpret models globally and per-instance. Experimental validation with Mendeley Phishing Dataset shows that X-URLIntelNet outperforms mainstream machine learning and deep learning. Accuracy, precision, recall, and AUC-ROC are 97.2, 96.7, 96.2, and 0.982. For real-time detection systems, the framework maintains 1.3 ms per sample inference time. Its 0.93 explainability score verifies its transparent threat intelligence. These findings show that X-URLIntelNet provides uncommon performance and interpretability, which is needed to ensure trustworthy AI in phishing threat mitigation.},
 author = {Palavali, Damodhara Reddy and Pothireddy, Suneetha},
 booktitle = {2025 9th International Conference on Electronics, Communication and Aerospace Technology (ICECA)},
 doi = {10.1109/ICECA66444.2025.11382884},
 issn = {},
 keyword = {Deep learning;Uniform resource locators;Phishing;Prevention and mitigation;Vectors;Real-time systems;Cyber threat intelligence;Ensemble learning;Security;Robots;Phishing URL Detection;Explainable AI;Cyber Threat Intelligence;Ensemble Learning;Deep Learning;SHAP;IGAM;Lightweight Security},
 month = {Nov},
 number = {},
 pages = {207-214},
 title = {Explainable Ensemble Learning for Detecting Phishing URLs using Lightweight Cyber Threat Intelligence},
 volume = {},
 year = {2025}
}
