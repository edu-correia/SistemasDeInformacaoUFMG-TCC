@article{10121508,
 abstract = {In the practical application of high-frequency surface wave radar (HFSWR), ionospheric clutter has become the principal obstacle to target detection. Since ionospheric clutter has nonlinear and time-varying characteristics, the current suppression methods still require improvement. In this letter, we proposed a method merging the deep neural networks (DNNs) and linear Koopman operator from the dynamic perspective, combining the powerful learning capacity of neural networks and the interpretability of Koopman theory, and applied linear Koopman mode to represent nonlinear ionospheric clutter in the state space based on time-delayed coordinates to achieve the finite-dimensional linear approximate reconstruction of ionospheric clutter. The validation results of the measured data reveal that the method has satisfactory modeling accuracy, which proves the effectiveness of the approach and lays the foundations for the subsequent breakthrough in new methods for ionospheric clutter suppression.},
 author = {Lyu, Zhe and Yu, Changjun and Wang, Rong and Liu, Aijun},
 doi = {10.1109/LGRS.2023.3274203},
 issn = {1558-0571},
 journal = {IEEE Geoscience and Remote Sensing Letters},
 keyword = {Clutter;Deep learning;Neural networks;Decoding;Space vehicles;Nonlinear dynamical systems;Electromagnetic scattering;Deep learning;dynamic mode decomposition (DMD);high-frequency surface wave radar (HFSWR);ionospheric clutter;Koopman operator},
 month = {},
 number = {},
 pages = {1-5},
 title = {A Data-Driven Deep Neural Network for Modeling of Ionospheric Clutter in HFSWR},
 volume = {20},
 year = {2023}
}
