@inproceedings{10924333,
 abstract = {The integration of Distributed Generation (DG) into electrical networks offers a valuable approach to improving power system performance. This paper introduces a hybrid algorithm that merges the strengths of Binary Particle Swarm Optimization (BPSO) and the Cuckoo Search Algorithm (CSA) to optimize the placement of DGs in power networks. The key objectives are to minimize power losses and enhance voltage profiles, both of which are essential for maintaining a reliable and efficient power system. The proposed methodology employs a multi-objective optimization framework to address these goals concurrently, leading to improved system reliability and economic benefits. The hybrid algorithm's effectiveness is demonstrated through case studies on the IEEE 33-bus test system, showing superior performance compared to conventional methods. Results reveal considerable reductions in power losses and notable improvements in voltage profiles, highlighting the advantages of optimal DG placement. Additionally, the study underscores the cost savings from reduced energy losses, translating into long-term economic benefits for both utility operators and consumers. The findings emphasize the role of advanced optimization techniques in modernizing power distribution systems and supporting sustainable energy solutions.},
 author = {Somashekar, D P and A V, Sunil Kumar and Karthik, Markala and N, Mohan},
 booktitle = {2024 International Conference on Sustainable Power & Energy (ICSPE)},
 doi = {10.1109/ICSPE62629.2024.10924333},
 issn = {},
 keyword = {Renewable energy sources;Refining;Power distribution;Voltage;Hybrid power systems;Distributed power generation;Power system reliability;Reliability;Particle swarm optimization;Optimization;distributed generation;network reconfiguration;optimization technique;power loss minimization;voltage profile},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {A Novel Hybrid Optimization Technique for Network Reconfiguration with Dispersed Generators Placement in Distribution System},
 volume = {},
 year = {2024}
