@article{Hertling20221,
 abstract = {Large knowledge graphs like DBpedia and YAGO are always based on the same source, i.e., Wikipedia. But there are more wikis that contain information about long-tail entities such as wiki hosting platforms like Fandom. In this paper, we present the approach and analysis of DBkWik++, a fused Knowledge Graph from thousands of wikis. A modified version of the DBpedia framework is applied to each wiki which results in many isolated Knowledge Graphs. With an incremental merge based approach, we reuse one-to-one matching systems to solve the multi source KG matching task. Based on this alignment we create a consolidated knowledge graph with more than 15 million instances. © 2022, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Hertling, Sven and Paulheim, Heiko},
 doi = {10.1007/978-3-031-21422-6_1},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 2},
 pages = {1 - 15},
 publication_stage = {Final},
 source = {Scopus},
 title = {DBkWik++- Multi Source Matching of Knowledge Graphs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85142725464?origin=resultslist},
 volume = {1686 CCIS},
 year = {2022}
}
