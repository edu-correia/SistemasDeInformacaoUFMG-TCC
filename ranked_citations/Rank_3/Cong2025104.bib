@article{Cong2025104,
 abstract = {With the information technology into all aspects of social life, the cyberspace and the traditional physical space exert profound influences on each other and merge at a deep level. Currently, the cyberspace mapping tends to view the two as parallel to each other. It requires a multilevel, multidimensional model for the cyberspace expression. This paper analyzes the research progress in cross-domain visualization of cyberspace information in recent years, introduces ontology modeling techniques to describe objects in the ubiquitous network space, and comprehensively considers the geographical space, social space, and information space affected by the cyberspace. It also introduces relevant data sources for the visualization of ubiquitous network spaces, discusses the process of variable granularity description of ubiquitous cyberspace ontologies by knowledge graph techniques. Finally, this paper reflects on cross-domain slicing representations for requirements customization, and explores future directions in cyber attack and defense confrontation. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2025.},
 author = {Cong, Yang and Wang, Qiang and He, Xiaochuan},
 doi = {10.1007/978-981-96-4503-9_8},
 journal = {Communications in Computer and Information Science},
 note = {Cited by: 0},
 pages = {104 - 119},
 publication_stage = {Final},
 source = {Scopus},
 title = {Survey of Ubiquitous Cyberspace Visualization Based on Ontology Engineering},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105005393409?origin=resultslist},
 volume = {2420 CCIS},
 year = {2025}
}
