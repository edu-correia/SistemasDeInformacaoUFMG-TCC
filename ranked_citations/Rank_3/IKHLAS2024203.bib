@incollection{IKHLAS2024203,
 abstract = {This chapter offers a thorough overview of research on CO2 capture technologies using systematic literature network analysis (SLNA). SLNA merges bibliometric analysis with narrative-qualitative analysis, making it a potent tool for understanding the latest advancements in a research topic and pinpointing gaps in the existing body of knowledge. This chapter also highlights the most prolific researchers and leading countries, shedding light on the current research priorities in the field. The findings strongly emphasize the economic considerations of implementing carbon capture and storage (CCS) technologies. There is also a growing research trend toward integrating bioenergy with CCS technologies. The network analysis further identifies a shift in research trends from merely capturing carbon to its utilization. Capturing CO2 in the conventional energy sector is vital for reducing carbon emissions and mitigating global warming.},
 author = {Nurani Ikhlas and I.D.A.A. Warmadewanthi and Nur Novilina Arifianingsih and Iva Yenis Septiariva and Marita Wulandari},
 booktitle = {Decarbonization Strategies and Drivers to Achieve Carbon Neutrality for Sustainability},
 doi = {https://doi.org/10.1016/B978-0-443-13607-8.00032-8},
 editor = {Majeti Narasimha {Vara Prasad} and Larry E. Erickson and Fabio Carvalho Nunes and Bimastyaji Surya Ramadan},
 isbn = {978-0-443-13607-8},
 keyword = {Bibliometric analysis, Carbon capture and storage, Carbon dioxide, Narrative-qualitative analysis, Systematic literature network analysis},
 pages = {203-222},
 publisher = {Elsevier},
 title = {Chapter Eleven - Carbon dioxide capture technologies for the conventional energy sector},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443136078000328},
 year = {2024}
}
