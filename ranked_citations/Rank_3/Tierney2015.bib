@conference{Tierney2015,
 abstract = {A novel framework for enhancing the resolution of a low-resolution multispectral or hyperspectral image using a high resolution panchromatic image or multispectral image is proposed in this paper. This framework can be further used to perform more general types of image fusion. To create the enhanced image, a convex objective function is minimised, which preserves both the pixel affinity learnt from the high resolution image and spectral information from the low resolution image. A fast approximation method is discussed. Quantitive and qualitative analysis against existing methods shows that our method is comparable to state of the art with faster running time and greater flexibility. MATLAB code for our proposed method and the compared methods are freely available in the FuseBox package. © 2014 IEEE.},
 author = {Tierney, Stephen and Gao, Junbin and Guo, Yi},
 doi = {10.1109/DICTA.2014.7008094},
 journal = {2014 International Conference on Digital Image Computing: Techniques and Applications, DICTA 2014},
 note = {Cited by: 17},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Affinity pansharpening and image fusion},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84922567783?origin=resultslist},
 year = {2015}
}
