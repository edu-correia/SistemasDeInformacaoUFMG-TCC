@inproceedings{8923874,
 abstract = {Statistical features are commonly used to detect hot events in social media. However, these features cannot represent the semantic similarity of synonym expression. Aiming at this problem, a semantic keyword-based hot event detection method for social media is proposed in this paper, which includes a semantic keywords model to distinguish real-world events from hot topics. The clusters are found using Affinity Propagation with statistic features. Also, related discussions from different perspectives of the event are merged using word embedding. After that, news titles and posts of hot topics are employed to train the semantic keywords model. This model is used to distinguish real-world events from clusters. Experiments show the proposed method can find hot events from social media data and related posts for further research.},
 author = {Yu, Zexuan and Wu, Xu and Xie, Xiaqing and Xu, Jin},
 booktitle = {2019 IEEE Fourth International Conference on Data Science in Cyberspace (DSC)},
 doi = {10.1109/DSC.2019.00068},
 issn = {},
 keyword = {Event detection;Semantics;Social network services;Feature extraction;Clustering algorithms;Damping;Training;Event-Detection;Social-media;Semantic-model;Clustering},
 month = {June},
 number = {},
 pages = {410-415},
 title = {Hot Event Detection for Social Media Based on Keyword Semantic Information},
 volume = {},
 year = {2019}
}
