@article{CHEN2025111339,
 abstract = {Under the general trend of global energy transformation, modern power systems are increasingly integrating more and more voltage source converters (VSCs) based on the grid-following (GFL) control. How to analyze the effect of GFL on the transient synchronous stability and how to improve the control strategy of GFL to enhance the transient synchronous stability are critical challenges. Addressing these challenges, this paper proposes a novel three-stage analytical framework. This framework skillfully merges the power injection model of GFL with the fault-on active power balance characteristics to establish an explicit fault-on power angle equation that considers the GFL penetration rate. Utilizing this framework, the influence mechanism of GFL integration on the transient synchronous stability under two types of GFL locations (the power sending area and the power receiving area) is analyzed. Research indicates that when GFL is located in the power sending area, transient synchronous stability deteriorates as the GFL penetration rate increases. When GFL is located in the power receiving area, the impact of GFL on the transient synchronous stability can be assessed based on the zero point of the fault-on swing equation. Inspired by the above insights, an improved GFL control strategy is proposed to enhance the transient synchronous stability. Finally, the correctness of the mechanism analysis and the effectiveness of the proposed control strategy are validated on the simplified system of an actual large-scale power grid using the PSCAD platform.},
 author = {Zhiying Chen and Lin Guan},
 doi = {https://doi.org/10.1016/j.ijepes.2025.111339},
 issn = {0142-0615},
 journal = {International Journal of Electrical Power & Energy Systems},
 keyword = {Grid-following (GFL), Transient synchronous stability, Three-stage analytical framework, Fault-on power angle equation, Improved control strategy},
 pages = {111339},
 title = {Effects of high penetration grid-following converter-based sources on power system transient synchronous stability: Analysis and enhanced control},
 url = {https://www.sciencedirect.com/science/article/pii/S0142061525008877},
 volume = {172},
 year = {2025}
}
