@conference{Bobillo2017,
 abstract = {Many real-world applications require ontology alignment to integrate semantic information from different sources. However, most of the work in the field is restricted to finding synonymy relationships, and hyponymy relationships have not received similar attention. In this paper, we discuss some extensions of our previous work in the discovery of subsumption relationships with fuzzy clustering, aggregation operators, Formal Concept Analysis, and synonymy relationships. © 2017 IEEE.},
 author = {Bobillo, Fernando and Bobed, Carlos and Mena, Eduardo},
 doi = {10.1109/FUZZ-IEEE.2017.8015663},
 journal = {IEEE International Conference on Fuzzy Systems},
