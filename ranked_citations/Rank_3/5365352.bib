@inproceedings{5365352,
 abstract = {Chord is a typical model of structured P2P network. However, there are some problems for the mechanism of searching resources in Chord, such as too much redundant information in the routing tables of nodes, the deviation of needed times of forwarding lookup messages among searching resources whose key values are located in different areas of identifier space, some available routing information being not used and the difficulty for supporting complex lookup, e.t. This paper proposes a scheme to add routing information to the routing tables. Meanwhile, it holds down the scale of routing tables by merging the items that have redundant information. In most cases, it makes the nodes actually have even less items in the routing tables than they used to. It also has the advantage that the deviation of time of routing a lookup message becomes smaller. Thus, it makes the performance of resource search more stable, the average hops of routing a lookup message diminished, the memory needed by the routing tables much less and the time of the transact shorter.},
 author = {Wang, Zhigang and Zhao, Yuelong and Wang, Zhigang},
 booktitle = {2009 International Conference on Computational Intelligence and Software Engineering},
 doi = {10.1109/CISE.2009.5365352},
 issn = {},
 keyword = {Fingers;Educational institutions;Redundancy;Clocks;Computer networks;Steady-state;Intelligent networks;Merging;Routing protocols;Heuristic algorithms},
 month = {Dec},
 number = {},
 pages = {1-4},
 title = {Research and Improvement of Mechanism of Searching Resource in Chord Network},
 volume = {},
 year = {2009}
}
