@inproceedings{10512804,
 abstract = {This paper explores the transformative impact of merging diverse operational domains within UAVs and UGVs, focusing on coverage control strategies. Through rigorous simulations and analysis, the study reveals the advantages of this integrated approach, which effectively consolidates coverage contributions from each operational domain into a cohesive whole, overcoming conventional partitioning limitations. This strategy also advances sensory distribution estimations, enhancing accuracy and our understanding of complex regions. Primarily, this work offers cross-domain collaboration, unlocking the potential of diverse dynamics. Based on the simulation result, the proposed approach gives better robots distribution over the region of interest on each domain implying estimation of density dispersion posterior variance decrease overtime.},
 author = {Jati, Agung Nugroho and Trilaksono, Bambang Riyanto and Idris Hidayat, Egi Muhammad and Adiprawita, Widyawardana},
 booktitle = {2024 IEEE International Conference on Artificial Intelligence and Mechatronics Systems (AIMS)},
 doi = {10.1109/AIMS61812.2024.10512804},
 issn = {},
 keyword = {Hazardous materials;Estimation error;Mechatronics;Simulation;Merging;Collaboration;Focusing;coverage control;heterogeneous multi-robot;sensory distribution estimation},
 month = {Feb},
 number = {},
 pages = {1-6},
 title = {Coverage Integration of UAVs and UGVs for Sensory Distribution Mapping},
 volume = {},
 year = {2024}
}
