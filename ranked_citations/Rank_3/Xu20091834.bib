@conference{Xu20091834,
 abstract = {Semantic and syntactic analyses for English sentences with structure of parasitic gap have not been seen, in order to solve this problem, the work of this paper is: 1. Syntactic analyses: introducing functional node based on the syntax-semantics interface; based on the operations of selection, merge, and move in the Minimalist Program, establishing the syntactic parse tree with p-signature. 2. Semantic analyses: for the phonologically null traces in the sentence, extracting the λ-expressions, introducing the semantic augmentation template, obtaining the normal form of λ-expression through λ.-calculus. 3. Establishing semantics-syntax interface for sentences. The interface indicates the correspondence between the results of semantic and syntactic analyses. © 2009 IEEE.},
 author = {Xu, Er-Qing},
 doi = {10.1109/ICMLC.2009.5212294},
 journal = {Proceedings of the 2009 International Conference on Machine Learning and Cybernetics},
 note = {Cited by: 0},
 pages = {1834 - 1839},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic and syntactic analyses for english sentences with structure of parasitic gap},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70350738747?origin=resultslist},
