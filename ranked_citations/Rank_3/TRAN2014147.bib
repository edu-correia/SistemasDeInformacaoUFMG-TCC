@article{TRAN2014147,
 abstract = {Belief merging is an active research field with many important applications. Most existing work addresses the belief merging issue using a centralised approach. In this paper, we investigate a distributed approach to the problem of belief merging. The contribution of this paper is two-fold: (i) we develop a negotiation-based model for belief merging, and (ii) we investigate the computational complexity of the belief merging problem within the proposed framework. Through the proposed model of negotiation-based belief merging, we will present and discuss several significant logical properties and computational complexity results.},
 author = {Trong Hieu Tran and Quoc Bao Vo and Thi Hong Khanh Nguyen},
 doi = {https://doi.org/10.1016/j.procs.2014.08.094},
 issn = {1877-0509},
 journal = {Procedia Computer Science},
 keyword = {Computational complexity, Belief merging, Knowledge integration, Negotiation},
 note = {Knowledge-Based and Intelligent Information & Engineering Systems 18th Annual Conference, KES-2014 Gdynia, Poland, September 2014 Proceedings},
 pages = {147-155},
 title = {On the Belief Merging by Negotiation},
 url = {https://www.sciencedirect.com/science/article/pii/S187705091401059X},
 volume = {35},
 year = {2014}
}
