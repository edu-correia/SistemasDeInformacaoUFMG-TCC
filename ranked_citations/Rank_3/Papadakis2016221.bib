@conference{Papadakis2016221,
 abstract = {Entity Resolution constitutes a quadratic task that typically scales to large entity collections through blocking. The resulting blocks can be restructured by Meta-blocking in order to significantly increase precision at a limited cost in recall. Yet, its processing can be time-consuming, while its precision remains poor for configurations with high recall. In this work, we propose new meta-blocking methods that improve precision by up to an order of magnitude at a negligible cost to recall. We also introduce two efficiency techniques that, when combined, reduce the overhead time of Metablocking by more than an order of magnitude. We evaluate our approaches through an extensive experimental study over 6 realworld, heterogeneous datasets. The outcomes indicate that our new algorithms outperform all meta-blocking techniques as well as the state-of-the-art methods for block processing in all respects. © 2016, Copyright is with the authors.},
 author = {Papadakis, George and Papastefanatos, George and Palpanas, Themis and Koubarakis, Manolis},
 doi = {10.5441/002/edbt.2016.22},
 journal = {Advances in Database Technology - EDBT},
 note = {Cited by: 49},
 pages = {221 - 232},
 publication_stage = {Final},
 source = {Scopus},
 title = {Scaling entity resolution to large, heterogeneous data with enhanced meta-blocking},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85042903743?origin=resultslist},
 volume = {2016-March},
 year = {2016}
}
