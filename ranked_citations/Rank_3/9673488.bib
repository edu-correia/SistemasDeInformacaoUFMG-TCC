@inproceedings{9673488,
 abstract = {Technology facilitated integration and unification across the value chain has become the determining factor for business firms to survive. Logistics, as one of the crucial success determinants has been redefined by e-Commerce firms while physical mode of business was left to struggle and strategize. To step up infusion of technology ‘Hyperlocal’ is the stratagem facilitated by unification of 5G internet capabilities and a gamut of other technologies such as geolocation and machine learning to find effective solutions to reach customers. Hyperlocal is an outcome of merging of online and offline platforms which is expected to bring huge demand while delivering prompt services conveniently. Offering services in a very specific proximity near a customer current location is the main aim of adopting hyperlocal strategy. Further, with the adoption of “near me” customers are willing to embrace the ‘perfect blend of online comfort and physical re-assurance’ i.e. the phygital business model. The study suggests that in this digital era of technological evolution and unparalleled disruption; business models need to be redefined. Thus if, functional domains expect to accrue any competitive advantage from unification of various technologies, they would essentially need to adapt and avail benefits of a Hyperlocal and hybrid business strategy.},
 author = {Maurya, Mohit and Dixit, Sweta and Zaidi, Neha and Maurya, Alka},
