@conference{Jin200942,
 abstract = {Due to homonyms, abbreviations, etc., name ambiguity is widely available in web and e-document. For example, when integrating heterogeneous literature databases, because there are different name specifications, different authors may be thought of as the same author, and vice versa. Therefore, name ambiguity makes data robust even dirty and lowers the precision of information retrieval. In this paper, we present an approach, named as Semantic Association based Name Disambiguation method (SAND), to solve person name ambiguity. The basic idea of SAND is to explore the semantic association of name entities and cluster name entities according to their associations. Finally, the name entities in the same group are considered as the same entities. We test SAND using data from CitesSeer, DBLP and Libra. The test results show that SAND is an effective approach to solve the problem of name ambiguity. © 2009 IEEE.},
 author = {Jin, Hai and Huang, Li and Yuan, Pingpeng},
 doi = {10.1109/ICEBE.2009.16},
 journal = {Proceedings - IEEE International Conference on e-Business Engineering, ICEBE 2009; IEEE Int. Workshops - AiR 2009; SOAIC 2009; SOKMBI 2009; ASOC 2009},
 note = {Cited by: 10},
 pages = {42 - 48},
 publication_stage = {Final},
 source = {Scopus},
 title = {Name disambiguation using semantic association clustering},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77950970206?origin=resultslist},
 year = {2009}
}
