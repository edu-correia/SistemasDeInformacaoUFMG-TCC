@article{10.5555/1127351.1127375,
 abstract = {Data warehousing and data mining are technologies that deliver critical and optimally useful information to facilitate performance analysis of business organizations. These technologies are not only an emerging trend in information technology but also a booming market in a range of industries. In light of this continuously growing demand, schools are accelerating to prepare students with these technologies. This paper describes the key components that comprise a course which would introduce both data warehousing and data mining technologies to a graduate program of information technology.},
 address = {Evansville, IN, USA},
 author = {Fang, Roger and Tuladhar, Sama},
 issn = {1937-4771},
 issue_date = {May 2006},
 journal = {J. Comput. Sci. Coll.},
 month = {May},
 number = {5},
 numpages = {8},
 pages = {137–144},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Teaching data warehousing and data mining in a graduate program of information technology},
 volume = {21},
 year = {2006}
}
