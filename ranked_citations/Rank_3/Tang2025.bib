@conference{Tang2025,
 abstract = {The continuous technological advancements in modern SoC design have introduced significant power challenges, with over 30% of power consumption attributed to the clock network. The application of MBFFs can effectively reduce clock network power consumption. However, the non-uniform capacitance distribution after MBFF merging poses challenges for clock network synthesis. In this paper, we propose a novel MBFF merging flow, which performs clock-aware register position migration and integrates a nearest-neighbor merging enumeration strategy. This approach aims to flexibly merge MBFFs for power reduction while maintaining good clock performance. Compared to existing works, our work has been validated on seven open-source benchmark circuits, delivers simultaneous gains of 5% in power consumption, 26% in clock latency, and 10 × faster operation, without compromising timing robustness.  © 2025 IEEE.},
 author = {Tang, Hao and Zhang, Guangbing and Li, Xinmiao and Zhao, Zhengjie and Duan, Yuhan},
 doi = {10.1109/CISP-BMEI68103.2025.11259130},
 journal = {Proceedings - 2025 18th International Congress on Image and Signal Processing, BioMedical Engineering and Informatics, CISP-BMEI 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Clock-Aware Register Migration for Multi-Bit Flip-Flop Generation in Low-Power Design},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105025402015?origin=resultslist},
 year = {2025}
}
