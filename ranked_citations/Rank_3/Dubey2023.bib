@conference{Dubey2023,
 abstract = {Effective visuals are essential for solving computational issues and comprehending complicated algorithms. Through the use of a web-based Sorting Algorithm Visualizer and associated components, this study presents a fresh approach to algorithm visualization. We look at different approaches to sorting, approaches to solving problems, and computing difficulties. With the help of a visual depiction, users may better understand the inner workings of sorting algorithms like bubble sort, selection sort, insertion sort, merge sort, fast sort, etc. by using the Sorting Algorithm Visualizer. Positive user feedback exhibiting better algorithmic comprehension is shown in the research, which highlights the Sorting Algorithm Visualizer's efficacy in offering an interactive and complete platform for viewing and learning sorting algorithms. The project's accomplishments and room for expansion demonstrate how crucial visualization is to understanding algorithms and addressing computational problems.  © 2023 IEEE.},
 author = {Dubey, Subham and Gupta, Shivansh and Kumar, Aditya and Kaur, Gurmeet},
 doi = {10.1109/ICIICS59993.2023.10421015},
 journal = {International Conference on Integrated Intelligence and Communication Systems, ICIICS 2023},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Visualizing Algorithms: A Comprehensive Exploration of Sorting and Computational Problem-Solving},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85186071178?origin=resultslist},
 year = {2023}
}
