@inproceedings{6221688,
 abstract = {This paper presents a camera network to acquire the voxel data of the Three-Dimensional (3D) Swept Volume Display that can render 3D images for viewers from different views simultaneously without the aid of special headgear or glasses. In this paper, we first design the structure of the network according to parameters of the camera. Then, its corresponding effective area is calculated. Finally, a virtual camera model is proposed according to the radius of the effective area to improve the view utilization of each camera. Results show that we can get a dense 3D model after disparity calculating and merging using multi-view stereo technology of the image captured under our network and it is capable of being displayed in the 3D Swept Volume Display with full 360 degree view angles, also the view of each camera is utilized maximally.},
 author = {Xu, Wei and Liu, Jingao and Cai, Mingming and Wang, Minxia},
 booktitle = {2012 IEEE International Conference on Information Science and Technology},
 doi = {10.1109/ICIST.2012.6221688},
 issn = {2164-4357},
 keyword = {Cameras;Three dimensional displays;Solid modeling;Conferences;Glass;Mathematical model;Computer vision},
 month = {March},
 number = {},
 pages = {451-455},
 title = {A camera network for the voxel data acquiring of the Three-Dimensional Swept Volume Display},
 volume = {},
 year = {2012}
}
