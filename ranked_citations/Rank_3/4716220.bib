@inproceedings{4716220,
 abstract = {Texts provide highly condensed information about the contents of images or video sequences. It proposes a text localization method using discrete wavelet transform and neural network. Because of the property of Harr wavelet transform, the proposed approach can localize large font size text by merging 4 small block wavelet coefficients into large one. Then the morphological dilation operation and the neural network are employed to raise the recall rate and precision rate. Experimental results show that the proposed method can successfully locate text region from complex images. Its precision rate is better than that of other methods.},
 author = {Tianding Chen},
 booktitle = {2008 11th IEEE International Conference on Communication Technology},
 doi = {10.1109/ICCT.2008.4716220},
 issn = {},
 keyword = {Discrete wavelet transforms;Image edge detection;Image coding;Neural networks;Filters;Data mining;Video sequences;Discrete cosine transforms;Transform coding;Information retrieval;Discrete wavelet transform(DWT);Text localization;Neural network},
 month = {Nov},
 number = {},
 pages = {722-725},
 title = {Text localization using DWT fusion algorithm},
 volume = {},
 year = {2008}
}
