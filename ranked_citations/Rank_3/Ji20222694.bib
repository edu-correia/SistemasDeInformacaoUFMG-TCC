 publication_stage = {Final},
 source = {Scopus},
 title = {NestedGNN: Detecting Malicious Network Activity with Nested Graph Neural Networks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85137266420?origin=resultslist},
