@inproceedings{1337627,
 abstract = {We present an efficient method to budget on-chip decoupling capacitors (decaps) to optimize power delivery networks in an area efficient way. Our algorithm is based on an efficient gradient-based nonlinear programming method for searching the solution. Our contributions are an efficient gradient computation method (time-domain merged adjoint network) and a novel equivalent circuit modelling technique to speed up the optimization process. Experimental results demonstrate that the algorithm is capable of efficiently optimizing very large scale P/G networks.},
 author = {Jingjing Fu and Zuying Luo and Xianlong Hong and Yici Cai and Tan, S.X.-D. and Pan, Z.},
 booktitle = {ASP-DAC 2004: Asia and South Pacific Design Automation Conference 2004 (IEEE Cat. No.04EX753)},
 doi = {10.1109/ASPDAC.2004.1337627},
 issn = {},
 keyword = {Capacitors;Robustness;Noise reduction;Optimization methods;Very large scale integration;Dynamic voltage scaling;Voltage fluctuations;Equivalent circuits;Circuit noise;Wire},
 month = {Jan},
 number = {},
 pages = {505-510},
 title = {A fast decoupling capacitor budgeting algorithm for robust on-chip power delivery},
 volume = {},
 year = {2004}
}
