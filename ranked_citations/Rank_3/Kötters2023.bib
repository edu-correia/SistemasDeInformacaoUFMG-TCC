@conference{Kötters2023,
 abstract = {Conceptual scaling is a method, developed in the framework of Formal Concept Analysis (FCA), that transforms a many-valued context (a collection of objects, described by attributes with values, such as name, size or color) into a formal context (a binary schema from which formal concepts are derived). Relational scaling extends conceptual scaling, by taking relations between objects into account. Previous work applies relational scaling to a relational database, transforming the relational database into a relational structure. Relational structures play the role of formal contexts in a relational variant of FCA. In this paper, we present a similar approach, which applies relational scaling to RDFS ontologies. © 2023 Copyright for this paper by its authors.},
 author = {Kötters, Jens and Eklund, Peter W. and Schmidt, Stefan E.},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Conceptual Scaling of RDFS Ontologies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85185197559?origin=resultslist},
 volume = {3637},
 year = {2023}
}
