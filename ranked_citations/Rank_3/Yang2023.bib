 publication_stage = {Final},
 source = {Scopus},
 title = {Community Evolution Analysis Driven by Tag Events: The Special Perspective of New Tags},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85151394095?origin=resultslist},
