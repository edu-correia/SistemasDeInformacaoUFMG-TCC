@inproceedings{6618400,
 abstract = {In this paper, we propose a vision based campus guide system to provide visitors guide information on the campus. Images of buildings are firstly represented by visual words. Then, to further reduce the recognition time, visual words of the same building are merged to a distinct codebook. During visiting, visitors capture images of an interested building by their mobile phones for recognition. After recognizing the building, tour guide information will be sent to the visitors via internet. Experimental results show that our method can efficiently recognize the target buildings under various viewpoints.},
 author = {Di-Kai Yang and Yu-Wen Lin and Yi-I Chiu and Pau-Choo Chung and Chun-Rong Huang},
 booktitle = {2013 IEEE International Conference on Multimedia and Expo Workshops (ICMEW)},
 doi = {10.1109/ICMEW.2013.6618400},
 issn = {},
 keyword = {Buildings;Visualization;Image recognition;Mobile handsets;Feature extraction;Image resolution;Databases;Building recognition;Descriptor;Image matching},
 month = {July},
 number = {},
 pages = {1-6},
 title = {Vision based campus guide system on intelligent mobile phone},
 volume = {},
 year = {2013}
}
