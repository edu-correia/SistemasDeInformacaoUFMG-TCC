@inproceedings{1559817,
 abstract = {In this paper, we present a general method for proving robust delay testability of multi-output threshold circuit. We prove that robust delay testability of some class of multi-output threshold circuits depends only on the set of well-defined properties of the merging circuits. We also prove the robust delay testability properties of two existing design methods of multi-output threshold circuits: one presented by Reddy and the improved one by Rahaman et al., (2003).},
 author = {Patronik, P.},
 booktitle = {8th Euromicro Conference on Digital System Design (DSD'05)},
 doi = {10.1109/DSD.2005.31},
 issn = {},
 keyword = {Circuit testing;Delay;Design methodology;Circuit faults;Robustness;Merging;Cybernetics;Very large scale integration;Clocks;Frequency},
 month = {Aug},
 number = {},
 pages = {289-296},
 title = {Delay testability properties of circuits implementing threshold and symmetric functions},
 volume = {},
 year = {2005}
}
