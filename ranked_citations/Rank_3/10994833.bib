@article{10994833,
 abstract = {Deep learning techniques have recently achieved significant success in semantic segmentation for Earth observation tasks using single-modality data in a specific region. However, such optimal conditions are seldom found in real-world applications, leading to subpar performance and limited generalization of existing models when faced with multimodal cross-domain scenarios. To tackle this issue, we introduce a novel segmentation network for remote sensing imagery (RSI) called MC-Seg, which incorporates multilevel deep cross-fusion and adversarial domain adaptation (DA). The MC-Seg framework begins by performing multilevel deep cross-fusion of multimodal data through a complete feature extraction (CFE) module and three fusion levels: feature, modal, and layer. This approach ensures the thorough utilization of features from various modalities. Following this, the framework integrates a local-global adversarial DA (LGADA) module to minimize the domain gap, effectively aligning the source and target domains despite the differences in RSI data representations. Experimental validation on the C2Seg dataset shows that our proposed method outperforms existing state-of-the-art techniques.},
 author = {Li, Guocheng and Xi, Bobo and He, Yufei and Zheng, Tie and Li, Yunsong and Xue, Changbin},
 doi = {10.1109/TGRS.2025.3568632},
 issn = {1558-0644},
 journal = {IEEE Transactions on Geoscience and Remote Sensing},
 keyword = {Feature extraction;Semantic segmentation;Aerospace electronics;Remote sensing;Accuracy;Training;Semantics;Data mining;Optical sensors;Merging;Cross-domain segmentation;deep cross-fusion;domain adaptation (DA);multimodal},
 month = {},
 number = {},
 pages = {1-16},
 title = {A Multimodal Cross-Domain Segmentation Network of Remote Sensing Imagery With Multilevel Deep Cross-Fusion and Adversarial Domain Adaptation},
 volume = {63},
 year = {2025}
}
