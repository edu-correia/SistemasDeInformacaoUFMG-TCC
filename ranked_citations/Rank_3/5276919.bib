@inproceedings{5276919,
 abstract = {This paper proposes a new transformation system for data integration which is based on semantic schema mapping, which is RDF-based. An alternative approach for data integration is also proposed. It provides an efficient way to keep legacy systems running and provides an integrated view to users during enterprise mergers and acquisitions. Existing data integration solutions require huge resources, especially in the initial stages. The preparation for data integration is a time consuming and complex process. The proposed system is suitable for data integration in a lean economic environment such as the current depression.},
 author = {Cheong, Chi Po and Chatwin, Chris and Young, Rupert},
 booktitle = {2009 3rd International Conference on Anti-counterfeiting, Security, and Identification in Communication},
 doi = {10.1109/ICASID.2009.5276919},
 issn = {2163-5056},
 keyword = {Ontologies;Relational databases;Corporate acquisitions;Environmental economics;OWL;Paper technology;Resource description framework;Merging;Internet;Medical services;component;Data Integration;Semantic;RDF},
 month = {Aug},
 number = {},
 pages = {144-147},
 title = {A RDF-based semantic schema mapping transformation system for localized data integration},
 volume = {},
 year = {2009}
}
