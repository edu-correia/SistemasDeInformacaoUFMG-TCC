@inproceedings{6550573,
 abstract = {The merging of Semantic Web technologies and the Internet of Things is originating the so-called Semantic Web of Things (SWoT), which promises to seamlessly integrate the real and digital worlds, to further enhance the available services in smart spaces and to increase the number of communicating users and objects. This paper presents a semantic content-centric framework enabling cooperative environments where resources can be discovered, queried and inventoried by autonomous objects in a peer-to-peer, collaborative way, without requiring a central control and coordination. Logic-based standard and non-standard inference services can be exploited in matchmaking and negotiation for service/resource discovery and on-the-fly reasoning, as well as for large-scale analyses. Features of the proposed approach are detailed and discussed w.r.t. the key requirements and research challenges of next-generation smart cities and factory automation.},
 author = {Ruta, Michele and Scioscia, Floriano and Di Sciascio, Eugenio and Rotondi, Domenico and Piccione, Salvatore},
 booktitle = {2013 27th International Conference on Advanced Information Networking and Applications Workshops},
 doi = {10.1109/WAINA.2013.249},
 issn = {},
 keyword = {Semantics;Cognition;Protocols;Mobile communication;Resource description framework;Pervasive computing;Semantic Web of Things;Pervasive Computing;Smart Environments;Resource Discovery;Stream Reasoning},
 month = {March},
 number = {},
 pages = {1289-1294},
 title = {Semantic-Based Knowledge Dissemination and Extraction in Smart Environments},
 volume = {},
 year = {2013}
}
