@inproceedings{4178254,
 abstract = {In this paper, we propose a control architecture and development environment based on Petri nets (PN) and the Java programming language. The architecture covers the coordination and local control layers of flexible manufacturing systems and is composed of several threads that interact through monitors. The proposed structure can be analyzed to guarantee control deadlines in the system. To support the real time and concurrent characteristics, we used the Java real-time specification. In addition, we propose the specification of control using PN that allow automatic code generation, which we present as a new PN technique called concurrent coordinators where classical centralized and decentralized concepts are merged. To demonstrate the practical utility of technique, we have applied it to the control of a flexible manufacturing cell.},
 author = {Moreno, Ramon Piedrafita and Salcedo, Jose Luis Villarroel},
 booktitle = {2006 IEEE Conference on Emerging Technologies and Factory Automation},
 doi = {10.1109/ETFA.2006.355421},
 issn = {1946-0759},
 keyword = {Petri nets;Java;Flexible manufacturing systems;Control systems;Automatic control;Computer languages;Yarn;Control system analysis;Centralized control;Automatic generation control},
 month = {Sep.},
 number = {},
 pages = {1246-1253},
 title = {Petri Nets and Java. Real-Time Control of a flexible manufacturing cell},
 volume = {},
 year = {2006}
}
