@inproceedings{10917864,
 abstract = {This paper presents the development of a MEMS-based reflection-type vapor cell combined with metasurfaces, which function as essential optical components for a microfabricated atomic clock. The metasurface achieves a relative diffraction efficiency of 82.3% and converts linear to circular polarization with a degree of circular polarization (DoCP) of -0.957. Following the successful bonding of the metasurfaces to the anisotropically etched silicon substrate, the demonstration of light reflection through the cavity was conclusively achieved. Furthermore, the vapor cell achieved an overall thickness of 1.055 mm, making it highly suitable for integration into mobile devices and opening avenues for diverse applications in the field of miniaturized atomic clocks and quantum sensors.},
 author = {Prutphongs, Ponrapee and Kataoka, Yuto and Hara, Motoaki and Iwami, Kentaro},
 booktitle = {2025 IEEE 38th International Conference on Micro Electro Mechanical Systems (MEMS)},
 doi = {10.1109/MEMS61431.2025.10917864},
 issn = {2160-1968},
 keyword = {Polarization;Optical metamaterials;Metasurfaces;Silicon;Reflection;Mobile handsets;Substrates;Quantum sensing;Optical devices;Atomic clocks;MEMS-based reflection-type vapor cell;Anisotopic etching;Multifunctional optical metasurfaces;Chip-scale atomic clock;EB lithography},
 month = {Jan},
 number = {},
 pages = {1071-1074},
 title = {Merging Mems Vapor Cells with Metasurfaces for Next-Gen Chip-Scale Atomic Clocks},
 volume = {},
 year = {2025}
}
