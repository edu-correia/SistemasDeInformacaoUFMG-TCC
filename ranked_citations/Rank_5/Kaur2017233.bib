@conference{Kaur2017233,
 abstract = {Distributed software teams face challenge in coordination while doing collaborative software development. Another related issue which developers come across is merge conflicts. Merge conflicts detected at later stage are costly to resolve and negatively affect productivity. Workspace awareness tools have come into play to facilitate the situation by giving awareness of developer's activities to other developers in the team. Goal of this paper is to investigate these tools and to find gaps in them. Also the analysis led to draw new set of requirements removing those drawbacks. © 2017 IEEE.},
 author = {Kaur, Inderdeep and Kaur, Parminder and Singh, Hardeep},
 doi = {10.1109/INTELCCT.2017.8324051},
 journal = {ICCT 2017 - International Conference on Intelligent Communication and Computational Techniques},
 note = {Cited by: 2},
 pages = {233 - 238},
 publication_stage = {Final},
 source = {Scopus},
 title = {Analysis of workspace awareness tools in distributed software development},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85048101448?origin=resultslist},
 volume = {2018-January},
 year = {2017}
}
