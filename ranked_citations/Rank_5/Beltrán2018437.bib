@conference{Beltrán2018437,
 abstract = {Current practices in software development are anchored in the use of version control systems to manage the development progress of software projects. Additionally, version control systems can be used to drive the release process of software products, by managing dierent variants of the main product in a repository. Despite the benefits of versioning systems, using such systems requires developers to interrupt their development work in order to interact with them, aecting their productivity. This paper presents CollabIDE, a collaborative environment for distributed development designed for automated versioning and product variant generation. The goal of CollabIDE is to increase developers’ productivity, therefore, we conducted a small empirical study with users working in distributed teams, measuring the time to complete dierent tasks using versioning, and the ease to release dierent products’ functionality based on recorded versions. © 2018 Conferencia Iberoamericana de Software Engineering - CIbSE. All Rights Reserved.},
 author = {Beltrán, Santiago and Cardozo, Nicolás},
 journal = {Avances en Ingenieria de Software a Nivel Iberoamericano, CIbSE 2018},
 note = {Cited by: 1},
 pages = {437 - 450},
 publication_stage = {Final},
 source = {Scopus},
 title = {A collaborative IDE for dynamic multi-versioning and variant management},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85054085780?origin=resultslist},
 year = {2018}
}
