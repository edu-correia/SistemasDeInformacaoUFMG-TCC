@article{Tran2011200,
 abstract = {Belief merging has been an active research field with many important applications. Many approaches for belief merging have been proposed, but these approaches only take the belief bases as inputs without the adequate attention to the role of agents, who provide the belief bases, thus the results achieved are merely ideal and difficult to apply in the multi-agent systems. In this paper, we present a merging approach based on the negotiation techniques. A new model is proposed in which agents gradually build their common belief base from the beliefs that they provide in each round of negotiation. A set of postulates is also introduced to characterize the logical properties of the merging results. © 2011 Springer-Verlag.},
 author = {Tran, Trong Hieu and Vo, Quoc Bao and Kowalczyk, Ryszard},
 doi = {10.1007/978-3-642-23851-2_21},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 8},
 number = {PART 1},
 pages = {200 - 209},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging belief bases by negotiation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/80053156209?origin=resultslist},
 volume = {6881 LNAI},
 year = {2011}
}
