@conference{Ajila2011487,
 abstract = {This paper presents the synchronization and conflict resolution for Transport Canada's RSIG (Rail Safety Integrated Gateway) system. In this work, we have designed and developed a comprehensive solution to address the challenges of a Disconnected Mode problem in the RSIG system. The proposed solution is based on Microsoft SQL Server database technology. SQL Server database provides three types of replications-transactional, merge, and snapshot. Our solution is based on merge replication. Merge replication is used for mobile application or distributed server applications with possible data conflicts. This solution could further be applied to the disconnected mode based architecture used by retail wholesalers. © 2011 IEEE.},
 author = {Ajila, Samuel A. and Al-Asaad, Ahmed},
 doi = {10.1109/IRI.2011.6009598},
 journal = {Proceedings of the 2011 IEEE International Conference on Information Reuse and Integration, IRI 2011},
 note = {Cited by: 9},
 pages = {487 - 489},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mobile databases-Synchronization & conflict resolution strategies using SQL server},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/80053155084?origin=resultslist},
 year = {2011}
}
