@inproceedings{4537082,
 abstract = {From CSCW view, the name issues in replicated collaborative solid modeling involve several fundamental challenges, such as consistency maintenance, multi-user interaction and undo/redo mechanism. Therefore, a consistency and awareness naming approach will contribute to all of above three challenges, either directly or potentially. The paper begins with the multi-user interaction framework in replicated collaborative solid modeling. And then a collaborative name structure is constructed to consistently name merged faces. Finally an awareness method is presented to distinguish which type of operation to create the merged faces. The proposed methods are illustrated with case studies in replicated collaborative solid modeling.},
 author = {Xiantao Cai and Fazhi He and Shuxu Jing and Huajun Liu},
 booktitle = {2008 12th International Conference on Computer Supported Cooperative Work in Design},
 doi = {10.1109/CSCWD.2008.4537082},
 issn = {},
 keyword = {Solid modeling;Collaborative work;Human computer interaction;Online Communities/Technical Collaboration;Helium;Computer science;Kernel;Usability;Interactive systems;Real time systems;Persistent Name Mechanisms;CSCW;Collaborative Solid Modeling;Replicated},
 month = {April},
 number = {},
 pages = {803-807},
 title = {A consistency and awareness approach to naming merged faces in collaborative solid modeling},
 volume = {},
 year = {2008}
}
