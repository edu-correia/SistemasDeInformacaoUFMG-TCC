@article{Pottinger2009254,
 abstract = {A model is a formal description of a complex application artifact, such as a database schema, an application interface, a UML model, an ontology, or a message format. The problem of merging such models lies at the core of many meta data applications, such as view integration, mediated schema creation for data integration, and ontology merging. This paper examines the problem of merging two models given correspondences between them. In particular it concentrates on the associativity and commutativity of Merge, which are crucial properties if Merge is to be composed with other operators. © 2009 Springer Berlin Heidelberg.},
 author = {Pottinger, Rachel and Bernstein, Philip A.},
 doi = {10.1007/978-3-642-02463-4_14},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 5},
 pages = {254 - 272},
 publication_stage = {Final},
 source = {Scopus},
 title = {Associativity and commutativity in generic merge},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/69049088941?origin=resultslist},
 volume = {5600 LNCS},
 year = {2009}
}
