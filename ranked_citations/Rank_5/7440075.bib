@inproceedings{7440075,
 abstract = {We propose a novel device (GDNMOS: Gated Diode merged NMOS) fabricated with 28nm UTBB FD-SOI high-k metal gate technology. Variable electrostatic doping (gate-induced) in diode and transistor body enables reconfigurable operation, in particular in thyristor mode. This innovative architecture demonstrates excellent capability for high-voltage protection while maintaining a latch-up free behavior.},
 author = {Athanasiou, S. and Legrand, Charles-Alexandre and Cristoloveanu, S. and Galy, Ph.},
 booktitle = {2016 Joint International EUROSOI Workshop and International Conference on Ultimate Integration on Silicon (EUROSOI-ULIS)},
 doi = {10.1109/ULIS.2016.7440075},
 issn = {},
 keyword = {Logic gates;Electrostatic discharges;Stress;Doping;P-i-n diodes;Transistors;Thyristors;ESD;FD-SOI;Gated Diode;MOSFET;Thyristor;SOI;CMOS},
 month = {Jan},
 number = {},
 pages = {151-154},
 title = {GDNMOS: A new high voltage device for ESD protection in 28nm UTBB FD-SOI technology},
 volume = {},
