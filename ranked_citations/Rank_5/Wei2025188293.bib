@article{Wei2025188293,
 abstract = {Merging at expressway on-ramp sections is a typical mandatory lane-changing maneuver that often causes traffic conflicts and bottlenecks. Although game-theoretic models have been widely applied to describe merging interactions, many existing studies pay little attention to the car-following behavior of the lag vehicle, particularly at taper-type merging sections where drivers have limited space and time to react. This study develops a game-theory-based merging model that explicitly incorporates car-following dynamics into drivers’ decision making. The merging process is formulated as a non-zerosum, non-cooperative game between the merging vehicle and the lag vehicle, whose strategies are defined as merge/wait and yield/keep-following/block, respectively. A rule-based identification method was proposed to extract observed vehicle actions from trajectory data, and the model was calibrated and validated using field observations from Hanshin Expressway. The results demonstrate that the proposed model achieved a 5.2% improvement in overall prediction accuracy compared with representative game-theoretic models, and it also provided consistent trajectory prediction through the integrated car-following formulation. The main contribution of this study is: i) it extends game-theoretic merging models by considering LV’s continuous car-following behavior, thereby capturing more realistic human driving decisions; and (ii) it offers a validated modeling framework applicable to taper-type merging sections, providing a foundation for microscopic traffic simulation and automated vehicle control strategies © 2013 IEEE.},
 author = {Wei, Chunyi and Yamamoto, Toshiyuki},
 doi = {10.1109/ACCESS.2025.3624766},
 journal = {IEEE Access},
 note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access},
 pages = {188293 - 188305},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Game Theory-Based Approach Considering Car-Following Behavior for Modeling Merging Behavior at Expressway On-Ramp Sections},
 type = {Article},
