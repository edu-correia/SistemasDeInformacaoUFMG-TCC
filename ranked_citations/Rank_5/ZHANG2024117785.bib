@article{ZHANG2024117785,
 abstract = {Analyzing the deformation and damage processes of high particle volume fraction composites (HPVFCs) based on the meso-structure modeling plays an important role in their service lifetime and functional reliability. The reported mesoscopic structural models are usually ideal models without initial damage and apply to composites with the volume fraction of particles less than 80%. This work provides a new mesoscopic structure model called aggregate settlement-merging model to successfully simulate the mechanical behavior and damage mechanism of the polymer-bonded explosive (PBX) under quasi-static loads, and the macroscopic response is accurately predicted by the cohesive finite element method. This simulation commendably predicts the failure modes including interface debonding, binder filaments, and grain failure, which is consistent with the observation in micromechanical experiments. The multi-scale relationship between macroscopic mechanical properties and microscopic initial interface damage is quantitatively established in a form of an exponential function. This study shows a relationship between meso-structures and performance and provides strategy for designing next generation high-performance HPVFCs.},
 author = {Xiaoshan Zhang and Guoqiang Luo and Haohan Zhou and Qinqin Wei and Xiaoyu Yang and Yuxuan Zhu and Peng Cao and Qiang Shen},
 doi = {https://doi.org/10.1016/j.compstruct.2023.117785},
 issn = {0263-8223},
 journal = {Composite Structures},
 keyword = {High particle volume fraction composites (HPVFCs), Meso-modeling, Damage evolution, Mechanical response, Tensile strength},
 pages = {117785},
 title = {Damage behavior of high particle volume fraction composites with initial damage by finite element meso-modeling},
 url = {https://www.sciencedirect.com/science/article/pii/S0263822323011315},
 volume = {329},
 year = {2024}
}
