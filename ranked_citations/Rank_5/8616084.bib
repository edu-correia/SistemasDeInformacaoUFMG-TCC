@inproceedings{8616084,
 abstract = {The main conflicts between the project management and the strategic management often lead to the disconnection between the strategy and the project in Project-based Enterprise. In order to manage the conflict effectively, this paper combed the related research systematically, identified some management processes or mechanisms that could influence the interaction between project management and the strategic management, and constructed a hypothetical model of Strategy-project System. Then the case study of three Chinese Project-based Enterprise was developed to verify the effectiveness of those specific management processes or mechanisms, given by document researches, in the conflict management. The results show that project selection, project support and management, capability management and other activities play important roles in managing conflicts between strategy management and project management. Therefore, four management mechanisms were put forward to solve the conflicts.},
 author = {Guo, Peng and Zhang, Dingning and Zhao, Jing and Hu, Junfei},
 booktitle = {2018 IEEE International Conference on Systems, Man, and Cybernetics (SMC)},
 doi = {10.1109/SMC.2018.00089},
 issn = {2577-1655},
 keyword = {Project management;Portfolios;Merging;Production;Organizations;Random access memory;Strategy project System;Project-based Enterprise;Conflict Management;Case Study},
 month = {Oct},
 number = {},
 pages = {468-473},
 title = {A Systematic Solution for Conflict Between Strategic and Projects in Project-Base Enterprise},
 volume = {},
 year = {2018}
}
