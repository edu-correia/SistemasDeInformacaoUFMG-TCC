@inproceedings{10331515,
 abstract = {With the proposal of the carbon peaking and carbon neutrality, high proportion of new energy sources and power electronic devices are more and more integrated into power systems. In this situation, a series of oscillation problems have been triggered. Eigenvalue analysis is one of effective methods for studying oscillations in power systems. However, for eigenvalue analysis based on continuous state space, the modeling may become complex when topology changes. In this paper, two discrete state space forms are built for typical RLC electric circuits. One is modeled by separate RLC element, and the other is implemented by merged RL and RC models. Subsequently, four typical circuits are selected to verify the consistency, by comparing actual eigenvalues derived from two discrete forms.},
 author = {Yin, Yiqun and Mou, Qianying},
 booktitle = {2023 International Conference on Power System Technology (PowerCon)},
 doi = {10.1109/PowerCon58120.2023.10331515},
 issn = {},
 keyword = {Computational modeling;RLC circuits;Power system stability;Systems modeling;Eigenvalues and eigenfunctions;Stability analysis;Topology;discrete state space;historical current term;RC;RL;RLC;trapezoidal integration method},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Eigen-Analysis Consistency of Two Discrete State Space Forms for Typical RLC Electric Circuits},
 volume = {},
 year = {2023}
}
