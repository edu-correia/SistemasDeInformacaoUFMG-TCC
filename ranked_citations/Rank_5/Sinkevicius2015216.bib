@conference{Sinkevicius2015216,
 abstract = {The goal of the paper is to propose the solution for merging SBVR business vocabularies and rules. Related work analysis has shown that this problem yet is not solved nor in the scientific literature nor in practical applications. We have identified five types of conflicts; one of them, the inconsistency conflict type, is proposed in this research. Merging operation is implemented in the Web prototype for maintaining business vocabularies and rules.},
 author = {Sinkevicius, Edvinas and Nemuraite, Lina and Butleris, Rimantas},
