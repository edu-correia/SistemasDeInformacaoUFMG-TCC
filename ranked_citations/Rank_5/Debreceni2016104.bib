@article{Debreceni2016104,
 abstract = {Industrial applications of model-driven engineering to develop large and complex systems resulted in an increasing demand for collaboration features. However, use cases such as model differencing and merging have turned out to be a difficult challenge, due to (i) the graph-like nature of models, and (ii) the complexity of certain operations (e.g. hierarchy refactoring) that are common today. In the paper, we present a novel search-based automated model merge approach where rule-based design space exploration is used to search the space of solution candidates that represent conflict-free merged models. Our method also allows engineers to easily incorporate domain-specific knowledge into the merge process to provide better solutions. The merge process automatically calculates multiple merge candidates to be presented to domain experts for final selection. Furthermore, we propose to adopt a generic synthetic benchmark to carry out an initial scalability assessment for model merge with large models and large change sets. © Springer-Verlag Berlin Heidelberg 2016.},
 author = {Debreceni, Csaba and Ráth, István and Varró, Dániel and De Carlos, Xabier and Mendialdua, Xabier and Trujillo, Salvador},
 doi = {10.1007/978-3-662-49665-7_7},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 29},
 pages = {104 - 121},
 publication_stage = {Final},
 source = {Scopus},
 title = {Automated model merge by design space exploration},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84961692435?origin=resultslist},
 volume = {9633},
 year = {2016}
}
