@article{Aceto20072,
 abstract = {This paper surveys some classic and recent results on the finite axiomatizability of bisimilarity over CCS-like languages. It focuses, in particular, on non-finite axiomatizability results stemming from the semantic interplay between parallel composition and nondeterministic choice. The paper also highlights the role that auxiliary operators, such as Bergstra and Klop's left and communication merge and Hennessy's merge operator, play in the search for a finite, equational axiomatization of parallel composition both for classic process algebras and for their real-time extensions. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Aceto, Luea and Ingolfsdottir, Anna},
 doi = {10.1007/978-3-540-74407-8_2},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 5},
 pages = {2 - 16},
 publication_stage = {Final},
 source = {Scopus},
 title = {The saga of the axiomatization of parallel composition},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/38149079734?origin=resultslist},
 volume = {4703 LNCS},
 year = {2007}
}
