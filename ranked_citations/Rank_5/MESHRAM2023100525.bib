@article{MESHRAM2023100525,
 abstract = {The purpose of this research is to propose a novel framework called “MNet: Merged Net” for fast and accurate fruit classification, which addresses the misclassification problem overlooked by many researchers. To achieve this, a dataset consisting of 12,000 color images of top fruits in India with “Good” and “Bad” quality labels was created and published. The dataset consists of a total of 12 classes, and two models are created based on the popular pretrained model InceptionV3. The principal results of the study show that the proposed framework achieved 99.92% accuracy and moderated the image misclassification problem. In addition, the experimental results demonstrate that the MFC_InceptionV3 model outperforms the InceptionV3 and FC_InceptionV3 models in terms of accuracy and misclassification problem. The major conclusion of this study is that the proposed framework, MNet, is a promising approach for fast and accurate fruit classification, which improves the accuracy and addresses the misclassification problem. The proposed dataset and framework can be used as a benchmark for future research in this field and can contribute to the farming business by providing a reliable and efficient technique for fruit classification.},
 author = {Vishal Meshram and Yogesh Suryawanshi and Vidula Meshram and Kailas Patil},
 doi = {https://doi.org/10.1016/j.simpa.2023.100525},
 issn = {2665-9638},
 journal = {Software Impacts},
 keyword = {Agriculture research, Deep learning, Fruit classification, Machine learning, Misclassification problem},
 pages = {100525},
 title = {Addressing misclassification in deep learning: A Merged Net approach},
 url = {https://www.sciencedirect.com/science/article/pii/S2665963823000623},
 volume = {17},
 year = {2023}
}
