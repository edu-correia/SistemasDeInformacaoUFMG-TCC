@conference{Muylaert2017503,
 abstract = {Integrating code from different sources can be an error-prone and effort-intensive process. While an integration may appear statically sound, unexpected errors may still surface at run time. The industry practice of continuous integration aims to detect these and other run-Time errors through an extensive pipeline of successive tests. Using data from a continuous integration service, Travis CI, we look into the prevalence of integration errors. We find code integration causes failure less often than regular commits. Repairing is usually done the same day and takes less than ten lines of code, largely in the source code. These results indicate that applying proper practices mitigates many issues associated with code integration. © 2017 IEEE.},
 author = {Muylaert, Ward and De Roover, Coen},
 doi = {10.1109/MSR.2017.40},
 journal = {IEEE International Working Conference on Mining Software Repositories},
 note = {Cited by: 7},
 pages = {503 - 506},
 publication_stage = {Final},
 source = {Scopus},
 title = {Prevalence of botched code integrations},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85026515853?origin=resultslist},
 volume = {0},
 year = {2017}
}
