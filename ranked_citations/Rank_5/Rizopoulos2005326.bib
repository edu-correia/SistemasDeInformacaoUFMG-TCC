@conference{Rizopoulos2005326,
 abstract = {In data integration, a Merge operator takes as input a pair of schemas in some conceptual modelling language, together with a set of correspondences between their constructs, and produces as an output a single integrated schema. In this paper we present a new approach to implementing the Merge operator that improves upon previous work by considering a wider range of correspondences between schema constructs and defining a generic and formal framework for the generation of schema transformations. This is used as a basis for deriving transformations over high level models. The approach is demonstrated in this paper to generate transformations for ER and relational models. © Springer-Verlag Berlin Heidelberg 2005.},
 author = {Rizopoulos, Nikolaos and McBrien, Peter},
 doi = {10.1007/11431855_23},
 journal = {Lecture Notes in Computer Science},
 note = {Cited by: 13},
 pages = {326 - 341},
 publication_stage = {Final},
 source = {Scopus},
 title = {A general approach to the generation of conceptual model transformations},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/25144498380?origin=resultslist},
 volume = {3520},
 year = {2005}
}
