@inproceedings{11237347,
 abstract = {On devices with limited memory and processing power (e.g., embedded systems, IoT devices), code size is crucial, which not only concerns the execution efficiency of the program but also directly affects the system's resource consumption. In current mainstream compilers, the commonly used code size optimization is mainly achieved by reducing redundant code, failing to fully use the optimization opportunities of similar code in conditional branches. To address this problem, this paper proposes a region-level similar code merging method, which is implemented in the form of Pass in LLVM compiler. It can identify and merge similar code regions in conditional branches to further reduce the code size. The method in this paper is experimented on MiBench and SPEC CPU 2006 test sets, and achieves an average of 543 bytes and a maximum of 2464 bytes code size reduction. The experimental results show that the method in this paper can effectively merge similar code and further reduce the code size.},
 author = {Xie, Tiangui and Han, Lin and Nie, Kai and Wu, Ziquan and Zhao, Chenbo},
 booktitle = {9th International Conference on Electronic Information Technology and Computer Engineering (EITCE 2025)},
 doi = {10.1049/icp.2025.2876},
 issn = {},
 keyword = {},
 month = {June},
 number = {},
 pages = {210-214},
 title = {Research on an optimization method for region-level similar code merging},
 volume = {2025},
 year = {2025}
}
