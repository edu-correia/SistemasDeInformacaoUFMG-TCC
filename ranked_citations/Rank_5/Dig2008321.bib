@article{Dig2008321,
 abstract = {Current text based Software Configuration Management (SCM) systems have trouble with refactorings. Refactorings result in global changes which lead to merge conflicts. A refactoring-aware SCM system reduces merge conflicts. This paper describes MolhadoRef, a refactoring-aware SCM system and the merge algorithm at its core. MolhadoRef records change operations (refactorings and edits) used to produce one version, and replays them when merging versions. Since refactorings are change operations with well defined semantics, MolhadoRef treats them intelligently. A case study and a controlled experiment show that MolhadoRef automatically solves more merge conflicts than CVS while resulting in fewer merge errors. © 2008 IEEE.},
 author = {Dig, Danny and Manzoor, Kashif and Johnson, Ralph E. and Nguyen, Tien N.},
 doi = {10.1109/TSE.2008.29},
 journal = {IEEE Transactions on Software Engineering},
 note = {Cited by: 60},
 number = {3},
 pages = {321 - 335},
 publication_stage = {Final},
 source = {Scopus},
 title = {Effective software merging in the presence of object-oriented refactorings},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/45449119162?origin=resultslist},
 volume = {34},
 year = {2008}
}
