@conference{Hunt2002511,
 abstract = {Parallel development has become standard practice in software development and maintenance. Though most every revision control and configuration management system provides some form of merging for combining changes made in parallel, these mechanisms often yield unsatisfactory results. The authors present a new merging algorithm, that uses a fast differencing algorithm and renaming analysis to provide better merge results. The system is language aware, but not language dependent and does not require a special editor, so it can be easily integrated in current development environments.},
 author = {Hunt, James J. and Tichy, Walter F.},
 journal = {Conference on Software Maintenance},
 note = {Cited by: 34},
 pages = {511 - 520},
 publication_stage = {Final},
 source = {Scopus},
 title = {Extensible language-aware merging},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/0036438209?origin=resultslist},
 year = {2002}
}
