@article{Gorogiannis2008132,
 abstract = {The area of knowledge merging is concerned with merging conflicting information while preserving as much as possible. Most proposals in the literature work with knowledge bases expressed in propositional logic. We propose a new framework for merging knowledge bases expressed in (subsets of) first-order logic. Dilation operators (a concept originally introduced by Bloch and Lang) are employed and developed, and by combining them with the concept of comparison orderings we obtain a framework that is driven by model-based intuitions but that can be implemented in a syntax-based manner. We demonstrate specific dilation operators and comparison orderings for use in applications. We also show how postulates from the literature on knowledge merging translate into our framework and provide the conditions that dilation operators and comparison orderings must satisfy in order for the respective merging operators to satisfy the new postulates. © 2008 Springer-Verlag Berlin Heidelberg.},
 author = {Gorogiannis, Nikos and Hunter, Anthony},
 doi = {10.1007/978-3-540-77684-0_11},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 17},
 pages = {132 - 150},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging first-order knowledge using dilation operators},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/49949113783?origin=resultslist},
 volume = {4932 LNCS},
 year = {2008}
}
