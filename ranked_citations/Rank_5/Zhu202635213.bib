@conference{Zhu202635213,
 abstract = {Large Reasoning Language Models (LRMs) have recently shown remarkable performance in complex reasoning tasks, but their extensive reasoning chains incur substantial computational overhead. To address this challenge, we propose Outlier-aware Reasoning Conciseness Adaptive Merge (ORCA), a novel plug-and-play model merging framework that leverages outlier activation patterns to fuse base models with reasoning models. Our ORCA introduces three key innovations: (1) adaptive alignment that reduces conflicts between disparate activation patterns during merging, (2) outlier-guided allocation that assigns merging coefficients proportional to each layer’s reasoning importance as indicated by outlier concentrations, and (3) dynamic probe-based adjustment that adapts merging coefficients during inference based on input-specific activation characteristics. These strategies allow seamless integration into existing merging pipelines while creating unified models that maintain reasoning accuracy with significantly reduced response verbosity. Comprehensive evaluation across six benchmarks using Qwen and LLaMA models shows ORCA reduces average response length by 55% while improving accuracy by 2.4∼5.7% over existing methods. © 2026, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
 author = {Zhu, Qiyuan and Li, Dezhi and Li, Lujun and Qin, Xiaoyu and Li, Wei and Gu, Hao and Xu, Hua and Han, Sirui and Guo, Yike},
 doi = {10.1609/aaai.v40i41.40828},
 journal = {Proceedings of the AAAI Conference on Artificial Intelligence},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 number = {41},
 pages = {35213 - 35221},
 publication_stage = {Final},
 source = {Scopus},
 title = {Outlier Matters: Efficient Long-to-Short Reasoning via Outlier-Guided ModeMerging},
 type = {Conference paper},
