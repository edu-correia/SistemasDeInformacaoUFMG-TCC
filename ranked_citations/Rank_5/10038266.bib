@inproceedings{10038266,
 abstract = {we improve the quality of ontology alignments by detecting and repairing conservativity violations that arise from interactions of ontologies through alignments. An alignment of ontologies which only states equivalent relations between entities of ontologies is an ontological signature isomorphism if and only if it preserves the logical closures of ontologies. Otherwise, it violates the isomorphism constraint. In this paper, we show that isomorphism violations constitute the premises of violations. Hence, conservativity violations repair can be reduced to repairing isomorphism violations. Isomorphism violations have the advantage of being detectable by local reasoning over each ontology, which is particularly relevant since most approaches require reasoning over the merge of both ontologies, an operation with high computational cost. We compare the result of our approach and the result of the approaches applied on the reference alignments used in the conference organization track provided by the Ontology Alignment Evaluation Initiative (OAEI). The experimental results show that the number of violations detected by our method is strongly reduced which might heavily change the results of this track.},
 author = {Zahaf, Ahmed and Fellah, Aissa and Malki, Mimoun},
 booktitle = {2022 First International Conference on Big Data, IoT, Web Intelligence and Applications (BIWA)},
 doi = {10.1109/BIWA57631.2022.10038266},
 issn = {},
 keyword = {Organizations;Ontologies;Maintenance engineering;Big Data;Cognition;Computational efficiency;Ontology Alignment;Conservativity violations;Isomorphism violations;Alignment repair},
