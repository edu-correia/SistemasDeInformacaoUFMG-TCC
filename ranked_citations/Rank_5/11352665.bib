@inproceedings{11352665,
 abstract = {Large Language Models in medical applications often exhibit “technical rationality”, excelling in expert knowledge but lacking affective competence., while conventional multi-task fine-tuning can lead to skill interference. To address this., this paper proposes a Component-Decoupled Orthogonal LoRA approach., grounded in the hypothesis of functional specialization where Feed-Forward Networks store factual knowledge and Multi-Head Attention (MHA) captures stylistic patterns. This method applies two distinct LoRA modules: a medical adapter targeting only FFNs for expertise., and a psychological adapter targeting only MHAs for empathy. These adapters are trained concurrently with an orthogonal update rule., where gradients are selectively applied based on the data source of each batch to prevent interference. Experiments on the Qwen3-1.7B model demonstrate that this method outperforms the base model and standard naive merging., and successfully achieves a balanced performance that approaches the efficacy of models fine-tuned exclusively on either single domain., effectively integrating medical expertise with affective competence.},
 author = {Chen, Li},
 booktitle = {2025 22nd International Computer Conference on Wavelet Active Media Technology and Information Processing (ICCWAMTIP)},
 doi = {10.1109/ICCWAMTIP68645.2025.11352665},
 issn = {2576-8964},
 keyword = {Adaptation models;Wavelet domain;Navigation;Large language models;Soft sensors;Psychology;Interference;Multitasking;Transformers;Standards;Large language models;Low-Rank adaptation;Parameter-Efficient Fine-Tuning},
 month = {Dec},
 number = {},
 pages = {1-5},
 title = {A Decoupled Fine-Tuning Approach for Integrating Medical Expertise and Affective Competence in Large Language Models},
 volume = {},
 year = {2025}
}
