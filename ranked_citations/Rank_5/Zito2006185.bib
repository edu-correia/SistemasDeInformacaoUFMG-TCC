@article{Zito2006185,
 abstract = {The notion of compliance is meant to facilitate tool interoperability. UML 2 offers 4 compliance levels. Level L<sub>i+1</sub> is obtained from Level L<sub>i</sub> through an operation called package, merge. Package merge is intended to allow modeling concepts defined at one level to be extended with new features. To ensure interoperability, package merge has to ensure compatibility, the XMI representation of the result of the merge has to be compatible with that of the original package. UML 2 lacks a precise and comprehensive definition of package merge. This paper reports on our work to understand and formalize package merge. Its main result is that package merge as defined in UML 2.1 does not ensure compatibility. To expose the problem and possible remedies more clearly, we present this result in terms of a very general classification of model extension mechanisms. © Springer-Verlag Berlin Heidelberg 2006.},
 author = {Zito, Alanna and Diskin, Zinovy and Dingel, Juergen},
 doi = {10.1007/11880240_14},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 23},
 pages = {185 - 199},
 publication_stage = {Final},
 source = {Scopus},
 title = {Package merge in UML 2: Practice vs. theory?},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33750294828?origin=resultslist},
 volume = {4199 LNCS},
 year = {2006}
}
