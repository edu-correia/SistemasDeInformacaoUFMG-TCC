@conference{Zhou2010265,
 abstract = {The development and evolution of vocabulary is a very complex and dynamic process. The development of Chinese vocabulary is mainly that the monosyllabic words in ancient Chinese gradually evolved into disyllabic and polysyllabic words in modern Chinese. This paper attempts to analyze the evolving mechanism of computational verbs in Chinese, including merge of verbs, split of verbs. Furthermore, computational verb theory was used to build the mathematic models of new Chinese verbs. The experiments were constructed to help analyze the changes in semantic meaning when Chinese verbs merge or split. Based on these experiments, the interactions among Chinese verbs and their consequences were studied mathematically. © 2010 IEEE.},
 author = {Zhou, Xi-Chang and Yang, Tao},
 doi = {10.1109/ICASID.2010.5551332},
 journal = {Proceedings - 2010 International Conference on Anti-Counterfeiting, Security and Identification, 2010 ASID},
 note = {Cited by: 0},
 pages = {265 - 268},
 publication_stage = {Final},
 source = {Scopus},
 title = {The evolution of computational verbs in Chinese},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77957603480?origin=resultslist},
 year = {2010}
}
