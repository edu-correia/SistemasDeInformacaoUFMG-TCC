@article{Fareh2013205,
 abstract = {In this paper we present a new mapping system for merging OWL ontologies. This work is situated in the general context of stored information heterogeneity in a decisional system such as data, metadata and knowledge, for cohabitation and reconciliation of these information by mediation. Our Mapping approach focuses on computing semantic similarity between concepts of ontologies to merge, it is based on a weighted combination of computing similarity methods, we use syntactic, lexical, structural, and semantic technics. The proposed mapping process makes use of several types of information in a manner that increases the mapping accuracy. © Springer International Publishing Switzerland 2013.},
 author = {Fareh, Messaouda and Boussaid, Omar and Chalal, Rachid},
 doi = {10.1007/978-3-319-00560-7_25},
 journal = {Studies in Computational Intelligence},
 note = {Cited by: 4},
 pages = {205 - 216},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mapping system for merging ontologies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84893077125?origin=resultslist},
 volume = {488},
 year = {2013}
}
