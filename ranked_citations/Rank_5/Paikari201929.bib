@conference{Paikari201929,
 abstract = {We present Sayme, a chatbot that we are developing to address the detection and resolution of potential code conflicts that may arise in parallel software development. Sayme is designed to operate both proactively, informing developers when they engage in activities that create conflicting changes, and reactively, responding to user inquiries regarding the state of different developers' work and how it may overlap. We introduce our motivation for developing Sayme, present its design and features, and offer an outlook at our future work. © 2019 IEEE.},
 author = {Paikari, Elahe and Choi, Jaeeun and Kim, Seonkyu and Baek, Sooyoung and Kim, Myeongsoo and Lee, Seungeon and Han, Chaeyeon and Kim, Youngjae and Ahn, Kahye and Cheong, Chan and Van Der Hoek, Andre},
 doi = {10.1109/BotSE.2019.00016},
 journal = {Proceedings - 2019 IEEE/ACM 1st International Workshop on Bots in Software Engineering, BotSE 2019},
 note = {Cited by: 19},
 pages = {29 - 33},
 publication_stage = {Final},
 source = {Scopus},
 title = {A chatbot for conflict detection and resolution},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85072941929?origin=resultslist},
 year = {2019}
}
