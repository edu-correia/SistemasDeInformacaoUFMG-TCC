@inproceedings{10420582,
 abstract = {Given the substantial integration of renewable energy into the grid, as well as its significant share, the coupling between grid planning and scheduling models has been significantly enhanced, and if a single time scale configuration is still used, it is very easy to cause conflicts between different modules, and the improper connection between planning and scheduling leads to high economic losses. Therefore, this paper synthesizes the capacity margin indicators of various aspects of source-load-storage, and proposes a multi-timescale network side equipment capacity margin allocation method of “integrated planning and operation”. Merging the interactive nature of source-load-storage with the outcomes of multi-timescale capacity margin allocation, we form an integrated planning and operation grid capacity margin allocation method based on the interaction of source-load-storage. Finally, a case study based on operational data from an IEEE standardized system is conducted to verify the effectiveness and advancement of the proposed method.},
 author = {Liu, Xiao and Wang, Hao and Zhao, Pu and Chen, Nan and Sun, Yi and Guan, Xiyang},
 booktitle = {2023 5th International Conference on Electrical Engineering and Control Technologies (CEECT)},
 doi = {10.1109/CEECT59667.2023.10420582},
 issn = {},
 keyword = {Renewable energy sources;Costs;Power system dynamics;Dynamic scheduling;Planning;Resource management;Capacity planning;source-load-storage interaction;planning and operation integration;grid-side;marginal configuration},
 month = {Dec},
 number = {},
 pages = {268-273},
 title = {Dynamic Allocation Method of Network-side Capacity Margin Based on Source-Load-Storage Interaction},
 volume = {},
 year = {2023}
}
