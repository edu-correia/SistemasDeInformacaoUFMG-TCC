@conference{Shkolnikov201835,
 abstract = {This paper presents an approach to merge tourists' routes. Within the context of construction travel-centric systems aimed at improving user collaboration practices, we examine the problem of journey planning with a particular focus on fitting the contrasting requirements of tourist group members, where each might have own interests and preferences. We introduce strict mathematical definition of tourist route then we introduce definition of the merged route as tourist route which includes places form original routes. The mathematical definition heavily uses distance function. Two merging algorithms are implemented to demonstrate how this function can be used and adjusted in order to obtain the particular instantiation of the merging algorithm for generate completely different routes. © 2018 Association for Computing Machinery.},
 author = {Shkolnikov, Fedor and Kuznetsov, Andrei and Pyshkin, Evgeny},
 doi = {10.1145/3274856.3274864},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 1},
 pages = {35 - 40},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging tourist routes for collaborative trip planning},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85058629748?origin=resultslist},
 year = {2018}
}
