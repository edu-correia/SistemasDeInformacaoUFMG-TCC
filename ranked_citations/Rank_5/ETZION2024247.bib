@incollection{ETZION2024247,
 abstract = {In this chapter, we will consider applications of sequences and the de Bruijn graph for concepts associated with DNA. The human genome project was a project that was considered starting in the 1980s. A large number of subsequences from a genome sequence have to be merged into the original genome. One of the most successful methods for this purpose is based on paths and cycles in the de Bruijn graph. A somewhat dual problem is to reconstruct a sequence, from a known codebook, given a subset of its subsequences. Such a problem has an important application in a new storage media, namely DNA storage. Three combinatorial concepts associated with DNA will be also discussed: constant-weight de Bruijn sequences, reconstruction of a sequence from its subsequences, and non-overlapping codes.},
 author = {Tuvi Etzion},
 booktitle = {Sequences and the de Bruijn Graph},
 doi = {https://doi.org/10.1016/B978-0-44-313517-0.00014-7},
 editor = {Tuvi Etzion},
 isbn = {978-0-443-13517-0},
 keyword = {comma-free codes, constant-weight de Bruijn sequences, DNA sequencing, DNA storage, genome assembly, -deck, non-overlapping codes},
 pages = {247-278},
 publisher = {Academic Press},
 title = {Chapter 8 - DNA sequences and DNA codes: The genome assembly and DNA storage},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443135170000147},
 year = {2024}
}
