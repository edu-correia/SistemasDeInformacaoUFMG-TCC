@conference{Berney2025158,
 abstract = {Graphics Processing Units (GPUs) have emerged as popular architectures for high-performance computing due to their parallelism and low latency context switching capabilities. However, optimizing GPU implementations can be challenging due to the complexity of the architecture, such as the diverse characteristics of memory units. While most optimization efforts focus on parallelism and global memory access, for some algorithms memory conflicts in shared memory, known as bank conflicts, can significantly impact performance. This affects the accuracy of theoretical runtime analysis of GPU algorithms. In this paper, we present a number-theoretic solution for eliminating all bank conflicts for Thrust library's mergesort implementation - the fastest comparison-based sorting implementation on GPUs. Our experiments demonstrate that the modified mergesort takes virtually the same time to run on the worst-case inputs as it does on random inputs (the worst-case inputs have been shown in the past to cause up to 50% slowdown).  © 2025 ACM.},
 author = {Berney, Kyle and Sitchinava, Nodari},
 doi = {10.1145/3694906.3743337},
 journal = {Annual ACM Symposium on Parallelism in Algorithms and Architectures},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 pages = {158 - 170},
 publication_stage = {Final},
 source = {Scopus},
 title = {Eliminating Bank Conflicts in GPU Mergesort},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105012714039?origin=resultslist},
 year = {2025}
}
