@conference{Baltes20181,
 abstract = {A core goal of Continuous Integration (CI) is to make small incremental changes to software projects, which are integrated frequently into a mainline repository or branch. This paper presents an empirical study that investigates if developers adjust their commit activity towards the above-mentioned goal after projects start using CI. We analyzed the commit and merge activity in 93 GitHub projects that introduced the hosted CI system Travis CI, but have previously been developed for at least one year before introducing CI. In our analysis, we only found one non-negligible effect, an increased merge ratio, meaning that there were more merging commits in relation to all commits after the projects started using Travis CI. This effect has also been reported in related work. However, we observed the same effect in a random sample of 60 GitHub projects not using CI. Thus, it is unlikely that the effect is caused by the introduction of CI alone.We conclude that: (1) in our sample of projects, the introduction of CI did not lead to major changes in developers' commit activity, and (2) it is important to compare the commit activity to a baseline before attributing an effect to a treatment that may not be the cause for the observed effect. © SWAN 2018 - Proceedings of the 4th ACM SIGSOFT International Workshop on Soft ware Analytics, co-located with FSE 2018.},
 author = {Baltes, Sebastian and Knack, Jascha and Anastasiou, Daniel and Tymann, Ralf and Diehl, Stephan},
 doi = {10.1145/3278142.327814},
 journal = {SWAN 2018 - Proceedings of the 4th ACM SIGSOFT International Workshop on Software Analytics, co-located with FSE 2018},
 note = {Cited by: 7},
 pages = {1 - 7},
 publication_stage = {Final},
 source = {Scopus},
 title = {(No) influence of continuous integration on the commit activity in GitHub projects},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85058377612?origin=resultslist},
 year = {2018}
}
