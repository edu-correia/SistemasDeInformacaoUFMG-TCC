@article{CHUA2003671,
 abstract = {Project schedules developed by various project players often reveal conflicts when they are merged together. The main challenge of communication among the constructors lies in the implicit interfacial dependencies between the project activities. The Component State Model (CSM) integrates the building product, construction process and constructability criteria. An activity cannot start until it fulfils the triggering criteria. These criteria present the preconditions explicitly to facilitate the communication. The inference engine can perform a schedule simulation to determine the potential constructability conflicts using the constructability knowledge represented as component type and activity type. The application of CSM is illustrated using an example to show the interaction of the pipe installation and wall plastering activities.},
 author = {David K.H Chua and Yuanbin Song},
 doi = {https://doi.org/10.1016/S0965-9978(03)00105-4},
 issn = {0965-9978},
 journal = {Advances in Engineering Software},
 keyword = {Schedule, Constructability analysis, Conflict identification, Product model, Process model, Activity criteria},
 number = {11},
 pages = {671-681},
 title = {Application of component state model for identifying constructability conflicts in a merged construction schedule},
 url = {https://www.sciencedirect.com/science/article/pii/S0965997803001054},
 volume = {34},
 year = {2003}
}
