@article{Bernaschina2019,
 abstract = {Model Driven Development (MDD) requires proper tools to derive the implementation code from the application models. However, the integration of handwritten and generated code is a long-standing issue that affects the adoption of MDD in the industry. This article presents a model and code co-evolution approach that addresses such a problem a posteriori, using the standard collision detection capabilities of Version Control Systems to support the semi-automatic merge of the two types of code. We assess the proposed approach by contrasting it with the more traditional template-based, forward-engineering process, adopted by most MDD tools. © 2019 Association for Computing Machinery.},
 author = {Bernaschina, Carlo and Falzone, Emanuele and Fraternali, Piero and Gonzalez, Sergio Luis Herrera},
 doi = {10.1145/3340545},
 journal = {ACM Transactions on Software Engineering and Methodology},
 note = {Cited by: 9; All Open Access; Green Open Access},
 number = {4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {The virtual developer: Integrating code generation and manual development with conflict resolution},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85071944902?origin=resultslist},
 volume = {28},
 year = {2019}
}
