@inproceedings{4439189,
 abstract = {Merging and integrating different conceptual models which have been developed by domain experts and analysts with dissimilar perspectives on the same issue has been the subject of tremendous amount of research. In this paper, we focus on the fact that human analysts' opinions possess a degree of uncertainty which can be exploited while integrating such information. We propose an underlying modeling construct which is the basis for transforming conceptual models into a manipulatable format. Based on this construct, methods for negotiating over and merging of conceptual models are proposed. The approach presented in this paper focuses on the formalization of uncertainty and expert reliability through the employment of belief theory.},
 author = {Bagheri, Ebrahim and Ghorbani, Ali A.},
 booktitle = {Proceedings of the 41st Annual Hawaii International Conference on System Sciences (HICSS 2008)},
 doi = {10.1109/HICSS.2008.458},
 issn = {1530-1605},
 keyword = {Uncertainty;Merging;Information analysis;Employment;International collaboration;Computer science;Niobium;Humans;Reliability theory;Reliability engineering},
 month = {Jan},
 number = {},
 pages = {489-489},
 title = {Towards a Belief-Theoretic Model for Collaborative Conceptual Model Development},
 volume = {},
 year = {2008}
}
