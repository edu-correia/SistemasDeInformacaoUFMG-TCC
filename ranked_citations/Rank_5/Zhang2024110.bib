@conference{Zhang2024110,
 abstract = {The analysis and understanding of source code changes play a crucial role in software maintenance, especially in tasks such as code review, software merging, and regression testing. Traditional text-based code difference extraction methods, such as git diff, typically only recognize insertions and deletions, neglecting the syntactic structure, which makes it difficult to effectively identify updates or movements. To address this issue, tree-based methods leverage the abstract syntax tree (AST) of the source code to generate fine-grained code differences, allowing for more accurate capture of structural changes in the code. However, existing difference extraction methods often overlook the semantic features of nodes, making it difficult to precisely identify node movements and updates. This paper proposes a code difference extraction method based on node feature enhancement, which introduces a node feature enhancement module and uses a neural network-based graph matching algorithm for node mapping. Experimental results show that the proposed method significantly improves both the accuracy and efficiency of code difference extraction. © 2024 IEEE.},
 author = {Zhang, Ren and Wang, Ke and Duan, Rongcheng and Li, Lu},
 doi = {10.1109/AUTEEE62881.2024.10869796},
 journal = {2024 IEEE 7th International Conference on Automation, Electronics and Electrical Engineering, AUTEEE 2024},
 note = {Cited by: 0},
 pages = {110 - 115},
 publication_stage = {Final},
 source = {Scopus},
 title = {A code difference extraction method based on node feature enhancement},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/86000024846?origin=resultslist},
 year = {2024}
}
