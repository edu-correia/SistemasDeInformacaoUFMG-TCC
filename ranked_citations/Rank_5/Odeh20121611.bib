@conference{Odeh20121611,
 abstract = {Merging two sorted arrays is a prominent building block for sorting and other functions. Its efficient parallelization requires balancing the load among compute cores, minimizing the extra work brought about by parallelization, and minimizing inter-thread synchronization requirements. Efficient use of memory is also important. We present a novel approach to partitioning the two sorted arrays into pairs of contiguous sequences of elements, one from each array, such that 1) each pair comprises any desired total number of elements, and 2) the elements of each pair form a contiguous sequence in the final merged sorted array. While the resulting partition and the computational complexity are similar to those of certain previous algorithms, our approach is different, extremely intuitive, and offers interesting insights. Based on this, we present a synchronization-free, cache-efficient merging (and sorting) algorithm. While we use CREW PRAM as the basis, our algorithm is easily adaptable to additional architectures. In fact, our approach is even relevant to sequential cache-efficient sorting. The algorithms and performance results are presented, along with important cache-related insights. © 2012 IEEE.},
 author = {Odeh, Saher and Green, Oded and Mwassi, Zahi and Shmueli, Oz and Birk, Yitzhak},
 doi = {10.1109/IPDPSW.2012.202},
 journal = {Proceedings of the 2012 IEEE 26th International Parallel and Distributed Processing Symposium Workshops, IPDPSW 2012},
 note = {Cited by: 48},
 pages = {1611 - 1618},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merge path - Parallel merging made simple},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84867407220?origin=resultslist},
 year = {2012}
}
