@conference{Ding2012573,
 abstract = {According to the China's aviation fuel market, the article constructs a supply chain model including three upstream firms and three downstream firms to solve China's aviation fuel security. Then, we analyze the merger game among the upstream and downstream manufacturers in the condition of scarce supply. Results show that the vertical relation of aviation fuel supply chain will be adjusted and the airlines will merge with the manufacturers to guarantee its supply. However, the strength of policy barriers decides the degree of integration. The degree of integration will be lower when the policy barriers getting stronger. © 2012 IEEE.},
 author = {Ding, Yong and Wang, Guankai and Li, Lei},
 doi = {10.1109/ICSESS.2012.6269532},
 journal = {ICSESS 2012 - Proceedings of 2012 IEEE 3rd International Conference on Software Engineering and Service Science},
 note = {Cited by: 0},
 pages = {573 - 578},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on vertical relation arrangement of aviation fuel supply chain},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84866487965?origin=resultslist},
 year = {2012}
