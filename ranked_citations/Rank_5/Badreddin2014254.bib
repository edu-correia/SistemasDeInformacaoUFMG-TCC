@conference{Badreddin2014254,
 abstract = {Model Driven Architecture (MDA) advocates the use of models, rather than code, as the main development artifact. Yet model versioning and merging tools still lag in capabilities, ease of use and adoption relative to source code versioning and merging tools. This forces many teams to avoid model-based collaboration and concurrent model modifications. In this paper, we highlight the main challenges behind the relatively small adoption of model merging approaches. We present a novel model-based programming technology that addresses many of those challenges. The approach treats code and models uniformly, effectively enabling modelers to version and merge models using existing text-based technologies. Copyright © 2014 SCITEPRESS - Science and Technology Publications. All rights reserved.},
 author = {Badreddin, Omar and Lethbridge, Timothy C. and Forward, Andrew},
 doi = {10.5220/0004699802540263},
 journal = {MODELSWARD 2014 - Proceedings of the 2nd International Conference on Model-Driven Engineering and Software Development},
 note = {Cited by: 12; All Open Access; Gold Open Access},
 pages = {254 - 263},
 publication_stage = {Final},
 source = {Scopus},
 title = {A novel approach to versioning and merging model and code uniformly},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84906902078?origin=resultslist},
 year = {2014}
}
