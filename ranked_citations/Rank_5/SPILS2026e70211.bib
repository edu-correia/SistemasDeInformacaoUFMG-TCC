@article{SPILS2026e70211,
 abstract = {The integration of asymmetric catalysis, crucial for the synthesis of structurally complex and enantioenriched target molecules, with photocatalysis, renowned for its atom economy and operational simplicity, offers a synergistic platform with considerable potential. Incorporating this dual strategy into flow systems further enhances the overall efficiency, enabling improved reaction control, scalability, and sustainability. This review provides an overview of recent advancements and discoveries that demonstrate the advantages of this merger, despite its relatively unexplored nature. The advancement of these processes together may uncover new possibilities in catalytic processes.},
 author = {Julian Spils and François‐Xavier Felpin},
 doi = {https://doi.org/10.1002/adsc.70211},
 issn = {1615-4150},
 journal = {Advanced Synthesis and Catalysis},
 keyword = {enantioselective catalysis, flow chemistry, organocatalysis, photocatalysis},
 number = {3},
 pages = {e70211},
 title = {Recent Developments in Merging Photochemistry and Enantioselective Catalysis in Flow},
 url = {https://www.sciencedirect.com/science/article/pii/S1615415025004923},
 volume = {368},
 year = {2026}
}
