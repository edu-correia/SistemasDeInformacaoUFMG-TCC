@article{Wienberg2003134,
 abstract = {Motivated by our work on object-oriented Content Management, this paper proposes an extensible formal framework for delta and merging strategies, each applicable to a specific type of content under specific constraints. By exploiting type-specific constraints, adequate deltas can be computed even without detailed operation logs. The framework thereby allows the use of unmodified third-party editing applications. We present initial experience with conflict detection and content merging algorithms for a number of link collection types, namely sets, lists, maps, and maps without duplicates. © Springer-Verlag Berlin Heidelberg 2003.},
 author = {Wienberg, Axel},
 doi = {10.1007/3-540-39195-9_10},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {134 - 147},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging collection data structures in a content management system},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/35248853800?origin=resultslist},
 volume = {2649},
 year = {2003}
}
