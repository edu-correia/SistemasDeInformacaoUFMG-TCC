@inproceedings{5357682,
 abstract = {Developing low-dimensional semantics-sensitive features is crucial for content-based image retrieval (CBIR). In this paper, we present a method called M2CLDA (merging 2-class linear discriminant analysis) to capture low-dimensional optimal discriminative features in the projection space. M2CLDA calculates discriminant vectors with respect to each class in the one-vs-all classification scenario and then merges all the discriminant vectors to form a projection matrix. The dimensionality of the M2CLDA space fits in with the number of classes involved. Moreover, when a new class is added, the new M2CLDA space can be approximated by only calculating a new discriminant vector for the new class. The features in the M2CLDA space have better semantic discrimination than those in traditional LDA space. Our experiments show that the proposed approach improves the performance of image retrieval and image classification dramatically.},
 author = {Zhiping Shi and Xi Liu and Qing He and Zhongzhi Shi},
 booktitle = {2009 IEEE International Conference on Intelligent Computing and Intelligent Systems},
 doi = {10.1109/ICICISYS.2009.5357682},
 issn = {},
 keyword = {Image retrieval;Content based retrieval;Linear discriminant analysis;Information retrieval;Scattering;Vectors;Image classification;Data mining;Principal component analysis;Helium;2-class LDA;image retrieval;image semantics;discriminative features},
 month = {Nov},
 number = {},
 pages = {260-264},
 title = {Image features optimizing for content-based image retrieval},
 volume = {4},
 year = {2009}
}
