@article{DONG20246474,
 abstract = {We report a step-economic strategy for the direct synthesis of spiro polycyclic N-heterocycles and indolecarbazole-fused naphthoquinones by merging oxidative coupling and cascade palladium-catalyzed intramolecular oxidative cyclization. In the protocol, bi-indolylnaphthoquinones were first synthesized by oxidative coupling of indoles and naphthoquinones. Subsequent cascade palladium-catalyzed intramolecular oxidative cyclization of bi-indolylnaphthoquinones gave spiro polycyclic N-heterocycles and indolecarbazoles. The intramolecular oxidative cyclization approach could also be realized by the presence or absence of iron catalysts under standard conditions. This protocol is featured with moderate to excellent yields, a wide substrate scope, and divergent structures of products.},
 author = {Yu Dong and Mei-Feng Lan and Yue-Qin Lin and Lin Chen and Chun-Mei Wu and Zhi-Fan Wang and Zhi-Chuan Shi and Guo-wei Deng and Bing He},
 doi = {https://doi.org/10.1021/acs.joc.4c00545},
 issn = {0022-3263},
 journal = {The Journal of Organic Chemistry},
 number = {9},
 pages = {6474-6488},
 title = {Synthesis of Spiro Polycyclic N‑Heterocycles and Indolecarbazoles via Merging Oxidative Coupling and Cascade Palladium-Catalyzed Intramolecular Oxidative Cyclization},
 url = {https://www.sciencedirect.com/science/article/pii/S0022326324005231},
 volume = {89},
 year = {2024}
}
