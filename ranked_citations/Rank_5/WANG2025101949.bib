@article{WANG2025101949,
 abstract = {Designing multicomponent reticular structures has been limited by the availability of suitable structural blueprints. Recently, a groundbreaking work reported by Eddaoudi and co-workers in Science has introduced a merged-net approach that expands the design space of reticular chemistry by combining edge-transitive nets, accelerating the discovery of intricate reticular materials.},
 author = {Dongmei Wang and Le Shi and Jiantang Li},
 doi = {https://doi.org/10.1016/j.matt.2024.101949},
 issn = {2590-2385},
 journal = {Matter},
 number = {2},
 pages = {101949},
 title = {Revealing the iceberg beneath: A merge-net approach for designing multicomponent reticular solids},
 url = {https://www.sciencedirect.com/science/article/pii/S2590238524006428},
 volume = {8},
 year = {2025}
}
