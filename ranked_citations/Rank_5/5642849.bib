@inproceedings{5642849,
 abstract = {The growing use of lead-free soldering, ultra-fine pitch and area-array devices in electronics manufacturing create new type of defects, such as “head-on-pillow” (HoP). The head-on-pillow soldering defect occurs as a result of the incomplete merging of the BGA/CSP component sphere and the molten solder paste during reflow. This defect was observed during realization of our research, mainly in solder joints of BGA676 components. To prevent and reduce the head-on-pillow defects as well as understand and address this issue a series of experiments were done.},
 author = {Arazna, Aneta and Koziol, Grazyna and Steplewski, Wojciech and Lipiec, Krzysztof},
 booktitle = {3rd Electronics System Integration Technology Conference ESTC},
 doi = {10.1109/ESTC.2010.5642849},
 issn = {},
 keyword = {Copper;Indium},
 month = {Sep.},
 number = {},
 pages = {1-4},
 title = {Head on pillow defects in BGAs solder joints},
 volume = {},
 year = {2010}
}
