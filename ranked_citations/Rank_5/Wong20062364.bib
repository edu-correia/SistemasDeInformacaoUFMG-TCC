@article{Wong20062364,
 abstract = {Developing software concurrently has become a common practice in organizations because of improvements in scalability and maintainability. There are a large variety of file types that are used in web applications especially images. Unfortunately, images cannot be developed concurrently like source code because their files are binary and cannot be merged. In addition, it is impossible to perform conflict resolution on binary text because developers do not know which portions of the images have conflict. This research investigates into using XML fles to represent images and testing them with existing merge techniques. A tool was developed to support concurrent image development thus proving that images can be developed under a software change environment.},
 author = {Wong, Justin and Capretz, Miriam A.M.},
 journal = {WSEAS Transactions on Computers},
 note = {Cited by: 0},
 number = {10},
 pages = {2364 - 2371},
 publication_stage = {Final},
 source = {Scopus},
 title = {A tool for concurrent image development},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33746965501?origin=resultslist},
 volume = {5},
 year = {2006}
}
