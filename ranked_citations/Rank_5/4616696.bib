@inproceedings{4616696,
 abstract = {The paper introduces general information about the ontology merging. An ontology provides a vocabulary describing particular domain along with the meaning of the used terms. The precision of the ontology specification is usually various for different cases and depends on a practical application. A semantic and structural heterogenity of domain models causes problems with ontologies management. The first part of the paper shortly describes the origin of an idea of web ontologies. The second part provides the methods of merging and aligning OWL-coded ontologies.},
