@inproceedings{5450489,
 abstract = {In this paper, we propose a clock routing algorithm for structured ASICs using predefined yet via-configurable metal wires. Our algorithm has many distinct features implemented to address the specific problems encountered by the tasks of creating tapping points and performing wire snaking. We also present an approach to merging two subtrees without exacerbating the skew of a merged tree. Experimental data show that a delay-balanced clock tree can be constructed using via-configurable routing fabric, with an average skew of 8.1% of clock latency for some benchmark circuits. Such a result is comparable to what can be achieved by a commercial clock tree synthesizer.},
 author = {Rung-Bin Lin and I-Wei Lee and Wen-Hao Chen},
 booktitle = {2010 11th International Symposium on Quality Electronic Design (ISQED)},
 doi = {10.1109/ISQED.2010.5450489},
 issn = {1948-3295},
 keyword = {Clocks;Routing;Fabrics;Application specific integrated circuits;Wire;Added delay;Field programmable gate arrays;Logic design;Algorithm design and analysis;Synthesizers;Structured ASIC;clock routing;clock skew;regular fabric;via configurable},
 month = {March},
 number = {},
 pages = {777-784},
 title = {Clock routing for structured ASICs with via-configurable fabrics},
 volume = {},
 year = {2010}
}
