@conference{Baqasah2014430,
 abstract = {XML Schema standards often undergo several revisions to fit application requirements and business demands. In order to be successful, the development process of such standards must be collaborative allowing multiple users to work on the same schema. In this editing environment, the ability to merge branched versions of the schema is significant in certain situations. Using conventional three-way XML merging tools is not suitable for the purpose of merging XML Schema because the tree model of XML Schema is different from that of XML document. This paper deals with an essential activity enabling automatic XML Schema merging and conflict resolution based on the model of XML Schemas. We present rules for XSD merging and conflict handling, and describe how this can be achieved by combining three-way and operational-transformation approaches. Developing a prototype of our approach, we test it against a set of XSDs. Experimental results (compared to other three-way merge tools, including, 3DM and DeltaXML) show that our approach produces merged versions of high quality and reports more meaningful conflicts with respect to schema changes. Copyright 2014 ACM.},
 author = {Baqasah, Abdullah and Pardede, Eric and Rahayu, Wenny},
 doi = {10.1145/2684200.2684302},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 5},
 pages = {430 - 439},
 publication_stage = {Final},
 source = {Scopus},
 title = {A new approach for meaningful XML schema merging},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84985990081?origin=resultslist},
 volume = {04-06-December-2014},
 year = {2014}
}
