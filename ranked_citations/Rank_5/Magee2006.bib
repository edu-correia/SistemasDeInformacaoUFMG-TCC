@conference{Magee2006,
 abstract = {In this paper we present a tool, SOMET, for collaborative developing, matching and merging ontologies. The tool's design is based on a Wiki model, allowing for multiple authors to contribute to an ontology. It also provides a number of meta-ontology features, including the ability to compare, match and merge. The tool makes use of one algorithmic approach to element-level mapping, demonstrating the use of both automated and manual matching.},
 author = {Magee, Liam},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {SOMET: Shared ontology matching environment},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84868350354?origin=resultslist},
 volume = {225},
 year = {2006}
}
