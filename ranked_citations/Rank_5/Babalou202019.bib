@article{Babalou202019,
 abstract = {Merging ontologies enables the reusability and interoperability of existing knowledge. With growing numbers of relevant ontologies in any given domain, there is a strong need for an automatic, scalable multi-ontology merging tool. We introduce erger, which covers four key aspects of the ontology merging field: compatibility checking of the user-selected Generic Merge Requirements (GMR)s, merging multiple ontologies with adjustable GMRs, quality assessment of the merged ontology, and inconsistency handling of the result.erger is freely accessible through a live portal and the source code is publicly distributed. © 2020, Springer Nature Switzerland AG.},
 author = {Babalou, Samira and Grygorova, Elena and König-Ries, Birgitta},
 doi = {10.1007/978-3-030-62327-2_4},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {19 - 24},
 publication_stage = {Final},
 source = {Scopus},
 title = { $$\mathcal {C}$$ o$$\mathcal {M}$$ erger: A Customizable Online Tool for Building a Consistent Quality-Assured Merged Ontology},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85097301538?origin=resultslist},
 volume = {12124 LNCS},
 year = {2020}
}
