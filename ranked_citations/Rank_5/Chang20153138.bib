@conference{Chang20153138,
 abstract = {In this paper we present a novel framework for unsupervised kinematic structure learning of complex articulated objects from a single-view image sequence. In contrast to prior motion information based methods, which estimate relatively simple articulations, our method can generate arbitrarily complex kinematic structures with skeletal topology by a successive iterative merge process. The iterative merge process is guided by a skeleton distance function which is generated from a novel object boundary generation method from sparse points. Our main contributions can be summarised as follows: (i) Unsupervised complex articulated kinematic structure learning by combining motion and skeleton information. (ii) Iterative fine-to-coarse merging strategy for adaptive motion segmentation and structure smoothing. (iii) Skeleton estimation from sparse feature points. (iv) A new highly articulated object dataset containing multi-stage complexity with ground truth. Our experiments show that the proposed method out-performs state-of-the-art methods both quantitatively and qualitatively. © 2015 IEEE.},
 author = {Chang, Hyung Jin and Demiris, Yiannis},
 doi = {10.1109/CVPR.2015.7298933},
 journal = {Proceedings of the IEEE Computer Society Conference on Computer Vision and Pattern Recognition},
 note = {Cited by: 12; All Open Access; Green Open Access},
 pages = {3138 - 3146},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unsupervised learning of complex articulated kinematic structures combining motion and skeleton information},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84959227283?origin=resultslist},
 volume = {07-12-June-2015},
