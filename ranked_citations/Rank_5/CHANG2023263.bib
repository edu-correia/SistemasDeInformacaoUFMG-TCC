@incollection{CHANG2023263,
 abstract = {This chapter introduces the ordered merge pattern whose parallelization requires each thread to dynamically identify its input position ranges. Because the input ranges are data dependent, we resort to a fast search implementation of the co-rank function to identify the input range for each thread. The fact that the input ranges are data dependent also creates extra challenges when we use tiling technique to conserve memory bandwidth and enable memory coalescing. As a result, we introduce the use of circular buffers to allow us to make full use of the data loaded from global memory. We have shown that introducing a more complex data structure such as a circular buffer can significantly increase the complexity of the code that uses the data structure. Thus we introduce a simplified buffer access model for the code that manipulates and uses the indices to remain largely unchanged. The actual circular nature of the buffers is exposed only when these indices are used to access the elements in the buffer.},
 author = {Li-Wen Chang and Jie Lv},
 booktitle = {Programming Massively Parallel Processors (Fourth Edition)},
 doi = {https://doi.org/10.1016/B978-0-323-91231-0.00025-2},
 edition = {Fourth Edition},
 editor = {Wen-mei W. Hwu and David B. Kirk and Izzat {El Hajj}},
 isbn = {978-0-323-91231-0},
 keyword = {Ordered list, map-reduce, merge, dynamic input data identification, rank, co-rank, tiling, buffering, coalescing, circular buffer, binary search},
 pages = {263-289},
 publisher = {Morgan Kaufmann},
 title = {Chapter 12 - Merge: An introduction to dynamic input data identification},
 url = {https://www.sciencedirect.com/science/article/pii/B9780323912310000252},
 year = {2023}
}
