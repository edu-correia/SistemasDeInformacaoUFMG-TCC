@article{Farshbaf200559,
 abstract = {There is a novel coevolutionary genetic algorithm approach for linear gate assignment problem (LGAP) presented. LGAP is encountered in Gate-matrix layouts which are made of vertical polysilicon and horizontal metal lines. Order of signal assignments to vertical polysilicons affects length of horizontal metal lines and layout characteristics because this can help several non-overlapping metal lines be combined as a single track. Therefore; a complete solution which is aimed to satisfy an objective function, is composed of two related answers: first; order of signal assignments to polysilicons and second; a strategy to merge nodes of circuit in optimal number of tracks. Since LGAP is known to be an NP-hard problem, evolutionary optimization methods are appropriate tools to solve it. On the other hand; solutions for LGAP should suggest a set of gate assignments and node merging strategy which brings coevolutionary idea to work simultaneously. In this paper, the adaptation of coevolutionary approach for LGAP is performed and MATLAB codes are developed for simulation. Comparison is made between plain Genetic Algorithms (GA) and coevolutionary GA through simulations and superior results of coevolutionary approach are shown.},
 author = {Farshbaf, Hamed and Hooshmand, Arash and Lucas, Caro},
 journal = {WSEAS Transactions on Information Science and Applications},
 note = {Cited by: 0},
 number = {1},
 pages = {59 - 64},
 publication_stage = {Final},
 source = {Scopus},
 title = {CoEvolutionary genetic algorithm approach to linear gate assignment problem},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/18844418958?origin=resultslist},
 volume = {2},
 year = {2005}
}
