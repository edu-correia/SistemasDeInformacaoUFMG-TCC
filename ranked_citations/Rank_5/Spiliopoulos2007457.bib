@conference{Spiliopoulos2007457,
 abstract = {This paper proposes a method for the mapping of ontologies that, in a greater extent than other approaches, discovers and exploits sets of latent features for approximating the intended meaning of ontology elements. This is done by applying the reverse generative process of the Latent Dirichlet Allocation model. Similarity between element pairs is computed by means of the Kullback-Leibler divergence measure. Experimental results show the potential of the method. © 2007 IEEE.},
 author = {Spiliopoulos, Vassilis and Vouros, George A. and Karkaletsis, Vangelis},
 doi = {10.1109/WI.2007.74},
 journal = {Proceedings of the IEEE/WIC/ACM International Conference on Web Intelligence, WI 2007},
 note = {Cited by: 7},
 pages = {457 - 460},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mapping ontologies elements using features in a latent space},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/48349094200?origin=resultslist},
 year = {2007}
}
