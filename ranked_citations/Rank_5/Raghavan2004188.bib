@conference{Raghavan2004188,
 abstract = {This paper describes an automated tool called Dex (Difference extractor) for analyzing syntactic and semantic changes in large C-language code bases. It is applied to patches obtained from a source code repository, each of which comprises the code changes made to accomplish a particular task. Dex produces summary statistics characterizing these changes for all of the patches that are analyzed. Dex applies a graph differencing algorithm to abstract semantic graphs (ASGs) representing each version. The differences are then analyzed to identify higher-level program changes. We describe the design of Dex, its potential applications, and the results of applying it to analyze bug fixes from the Apache and GCC projects. The results include detailed information about the nature and frequency of missing condition defects in these projects. © 2004 IEEE.},
 author = {Raghavan, Shruti and Rohana, Rosanne and Leon, David and Podgurski, Andy and Augustine, Vinay},
 doi = {10.1109/ICSM.2004.1357803},
 journal = {IEEE International Conference on Software Maintenance, ICSM},
 note = {Cited by: 91},
 pages = {188 - 197},
 publication_stage = {Final},
 source = {Scopus},
 title = {Dex: A semantic-graph differencing tool for studying changes in large code bases},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/18044373219?origin=resultslist},
 year = {2004}
}
