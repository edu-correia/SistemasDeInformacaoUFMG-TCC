@conference{Chou20181767,
 abstract = {In this paper, a novel method to merge convolutional neural networks for the inference stage is introduced. When two feed-forward networks already trained for handling different tasks are given, our method can align the layers of these networks and merge them into a unified model by sharing the representative weights. The performance of the merged model can be restored or improved via re-training. Without needing high-performance hardware, the proposed method effectively produces a compact model to run the original tasks simultaneously on resource-limited devices. The system development time, as well as training overhead, is substantially reduced because our method leverages the co-used weights and preserves the general architectures of the well-trained networks. The merged model is jointly compressed and can be implemented faster than the original models with a comparable accuracy. When combining VGG-Avg and ZF-Net models, our approach can achieve higher than 12 and 2.5 times of compression and speedup ratios compared to the original whole models, respectively, while the accuracy remains approximately the same. © 2018 IEEE.},
 author = {Chou, Yi-Min and Chan, Yi-Ming and Lee, Jia-Hong and Chiu, Chih-Yi and Chen, Chu-Song},
 doi = {10.1109/CVPRW.2018.00220},
 journal = {IEEE Computer Society Conference on Computer Vision and Pattern Recognition Workshops},
 note = {Cited by: 6},
 pages = {1767 - 1775},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging deep neural networks for mobile devices},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85060861655?origin=resultslist},
 volume = {2018-June},
 year = {2018}
}
