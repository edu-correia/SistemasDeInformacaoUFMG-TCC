@conference{Suga2015467,
 abstract = {Partial models are small models produced by splitting a large full model into meaningful conceivable-sized fragments with each separate diagram. They are commonly used when the full model is too large and shared by several people who have their own scope of interest. Those partial models are subject to being manipulated-merged for instance. This context calls for discussion in Enterprise Ontology (EO) about the capability of business process modeling languages in handling partial models and manipulations on them. There, indeed, exists a lack of researches in the methodology of EO, namely Design & Engineering Methodology for Organizations (DEMO) for formal studies on its consistency in producing partial models and merging them. It stems from a deficiency of formal semantics in the specification of the notation. By formalizing the DEMO Construction Model (CM) with a concept of well-formed models and the merge operation from a set-theoretic approach, this paper clarifies that the closedness, commutativity, and associativity are guaranteed in merging partial models of DEMO CM. An example of EU-Rent accompanies the formalizations for validation and demonstration. Copyright © 2015 by SCITEPRESS - Science and Technology Publications, Lda. All rights reserved.},
 author = {Suga, Tetsuya and Iijima, Junichi},
 doi = {10.5220/0005584004670478},
 journal = {IC3K 2015 - Proceedings of the 7th International Joint Conference on Knowledge Discovery, Knowledge Engineering and Knowledge Management},
 note = {Cited by: 3; All Open Access; Gold Open Access},
 pages = {467 - 478},
 publication_stage = {Final},
 source = {Scopus},
 title = {Does 'merging DEMO models' satisfy the associative law? Validation of partial models and merge operation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84961156280?origin=resultslist},
 volume = {2},
 year = {2015}
}
