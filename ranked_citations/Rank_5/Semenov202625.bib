@conference{Semenov202625,
 abstract = {Digital collaboration systems support asynchronous work over replicated data, where conflicts arise when concurrent operations cannot be unambiguously integrated into a shared history. While Conflict-Free Replicated Data Types (CRDTs) ensure convergence through built-in conflict resolution, this resolution is typically implicit and opaque to users, whereas existing reconciliation techniques often rely on centralized coordination. This paper introduces a conflict model for collaborative data structures that enables explicit, local-first conflict resolution without central coordination. The model identifies conflicts using semantic dependencies between operations and resolves them by rebasing conflicting operations onto a reconciling operation via a three-way merge over a replicated journal. We demonstrate our approach on collaborative registers, including an explicit formulation of the Last-Writer-Wins Register and a multi-register entity supporting semi-Automatic reconciliation.  © 2026 Copyright held by the owner/author(s).},
 author = {Semenov, Georgii and Aksenov, Vitaly},
 doi = {10.1145/3806077.3806700},
 journal = {PaPoC 2026 - Proceedings of the 13th Workshop on Principles and Practice of Consistency for Distributed Data},
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 pages = {25 - 31},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic Conflict Model for Collaborative Data Structures},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105038334988?origin=resultslist},
 year = {2026}
}
