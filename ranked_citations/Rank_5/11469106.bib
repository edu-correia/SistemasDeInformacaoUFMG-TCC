@inproceedings{11469106,
 abstract = {IT organization, nowadays, are following manual process for doing code review process, Developers submits the pull request or merge request in tool. After that reviewer has to do the whole process manually and put comment on pull request manually. Further the PR gets assign back to the developer. This whole process is very time consuming. Devops talks about automation to the extent it is possible and so does DevSecOps. We proposed a machine learning model to automate the code review process using a pull request in Azure devops. The author(s) has proposed an optimized process ensures the conducting the review of code and automatically and add comment on each pull request in azure devops. The optimized LLM model uses large historical dataset to find the appropriate comment from the dataset. This will help organization to implement better process and reduce bug which might be possible in doing manual review. As a result, we observed the new optimized process is quite helpful to reduce the review effort and further reducing the overall budget for the final software product.},
 author = {Saurabh, Shobhit Kumar and Kumar, Deepak and Bali, Vikram},
 booktitle = {2026 2nd International Conference on Cognitive Computing in Engineering, Communications, Sciences and Biomedical Health Informatics (IC3ECSBHI)},
 doi = {10.1109/IC3ECSBHI67834.2026.11469106},
 issn = {},
 keyword = {Finite impulse response filters;Digital filters;Internet of Things;Communication systems;Internet;Radio access networks;Regional area networks;Product development;Protocols;Computer networks;DevSecOps;DevOps;Machine Learning;Software Quality;Python;pull request;Collab. LLM},
 month = {Feb},
 number = {},
 pages = {1530-1534},
 title = {Optimization of Code Review Process Using Devsecops},
 volume = {},
 year = {2026}
}
