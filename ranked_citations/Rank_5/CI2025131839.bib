@article{CI2025131839,
 abstract = {Addressing the substantial threat posed by Cr(VI) pollution to both ecological systems and public health, this study explored the utilization of MIL-101(Cr)’s prominent microporous characteristics for aniline adsorption, subsequently undergoing oxidative polymerization within the pores and on the surface to form polyaniline@MOF composites (M@PANI-X). Structural analysis elucidated a core–shell structure with adjustable shell thickness, enhancing Cr(VI) adsorption kinetics and capacity. Notably, M@PANI-3 demonstrated superior performance at a pH of 2 and an adsorbent dosage of 0.5 g·L-1, outperforming both MIL-101(Cr) and PANI adsorbents individually. It achieved a maximum adsorption capacity of 369.5 mg·g−1 within 10 min, as determined by the Sips model. This elevated adsorption capacity is attributed to the synergistic interplay between PANI and MIL-101(Cr), mitigating slow adsorption rate of PANI and low adsorption capacity of MIL-101(Cr). Mechanistic studies revealed that the removal of Cr(VI) involved a combination of electrostatic adsorption and reduction. Additionally, the study revealed that the adsorbent is capable of being reused multiple times. The desorbed Cr(VI) could furthermore be converted to the less toxic Cr(III) by employing sodium metabisulfite (Na2S2O5), which can be reused in the synthesis of MIL-101(Cr). By merging the advantages of MOFs and polymers, this strategy presents a promising avenue for developing advanced adsorbent materials targeting anionic pollutants.},
 author = {Erlamu Ci and Fangfang Zhao and Tong Liu and Chunliang Yang and Fei Liu and Tianxiang Zhao},
 doi = {https://doi.org/10.1016/j.seppur.2025.131839},
 issn = {1383-5866},
 journal = {Separation and Purification Technology},
 keyword = {Cr(VI) adsorption, Polyaniline, Metal–organic frameworks, Hybrid materials},
 pages = {131839},
 title = {Enhancing adsorption of Cr(VI) from aqueous solutions: Core-Shell engineered Polyaniline@MOF composites overcome Thermodynamic-Kinetic Trade-Off effect},
 url = {https://www.sciencedirect.com/science/article/pii/S1383586625004368},
 volume = {362},
 year = {2025}
}
