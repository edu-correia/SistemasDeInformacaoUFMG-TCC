@article{Kim20258263,
 abstract = {Cross-border data spaces require mechanisms for exchanging RDF catalog updates across independent authorities under heterogeneous governance frameworks. Existing approaches exhibit limitations in simultaneously achieving offlinetolerant replication, verifiable lineage, and governance-aligned sharing. This paper presents ASPEN, an authority-based synchronization architecture that enables organizations to replicate RDF catalog updates without merge conflicts or centralized intermediaries. The design combines cryptographic provenance with sovereign authority scopes to ensure monotonic history, tamper-evident provenance, and non-repudiation while maintaining independent yet interoperable sovereignty. © 2025 IEEE.},
 author = {Kim, Seong-Hwan and Son, Siwoon and Won, Heesun},
 doi = {10.1109/BigData66926.2025.11401715},
 journal = {Proceedings of the IEEE International Conference on Big Data, BigData},
 note = {Cited by: 0},
 number = {2025},
 pages = {8263 - 8265},
 publication_stage = {Final},
 source = {Scopus},
 title = {ASPEN: Authority-Based Sovereign Provenance-Enforced Network for RDF Catalog Federation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105037841403?origin=resultslist},
 year = {2025}
}
