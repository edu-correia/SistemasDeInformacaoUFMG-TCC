@conference{Costa2013656,
 abstract = {An important challenge of Model Driven Version Control System (VCS) is to use conflict detection methods that are appropriate for models. Methods that analyze only the syntax of models can detect conflicts that do not exist in reality (false positives) and can fail to detect conflicts that do exist (false negatives). This paper presents a method to reduce the occurrence of both false positive and false negative conflicts. For this, the presented method provides an analyzer of the semantic equivalence between models. Our method verifies if the model versions are semantically equivalent, if one version semantically contains the other version, and if there are conflicts between versions. Copyright © 2013 by Knowledge Systems Institute Graduate School.},
 author = {Costa, Valéria Oliveira and Oliveira, João M. B. and Murta, Leonardo Gresta Paulino},
 journal = {Proceedings of the International Conference on Software Engineering and Knowledge Engineering, SEKE},
 note = {Cited by: 2},
 number = {January},
 pages = {656 - 661},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic conflicts detection in model-driven engineering},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84937702978?origin=resultslist},
 volume = {2013-January},
 year = {2013}
}
