@conference{Schwägerl201441,
 abstract = {Version control for models is not yet supported in an adequate way. In this paper, we address three-way merging of model versions. Based on a common base version b, two alternative versions a<sub>1</sub> and a<sub>2</sub> were developed by copying and modifying the base version. To reconcile these changes, a merged version m is to be created as a common successor of a<sub>1</sub> and a<sub>2</sub>. We present a graph algorithm to solve an important subproblem which occurs in three-way model merging: merging of (linearly) ordered collections. To create the merged version, a generalized topological sort is performed. Conflicts occur if the order of elements cannot be deduced automatically; these conflicts are resolved either interactively or by default rules. We have implemented the merge algorithm in our tool BTMerge, which performs a consistency-preserving merge of versions of EMF models being instances of arbitrary Ecore models. By taking arbitrary move operations into account, the algorithm considerably goes beyond the functionality of contemporary merge tools which are based on common subsequences and thus cannot adequately handle move operations. Copyright © 2014 SCITEPRESS - Science and Technology Publications. All rights reserved.},
 author = {Schwägerl, Felix and Uhrig, Sabrina and Westfechtel, Bernhard},
 doi = {10.5220/0004702100410054},
 journal = {MODELSWARD 2014 - Proceedings of the 2nd International Conference on Model-Driven Engineering and Software Development},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 pages = {41 - 54},
 publication_stage = {Final},
 source = {Scopus},
 title = {A graph-based algorithm for three-way merging of ordered collections in EMF models},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84906910346?origin=resultslist},
 year = {2014}
}
