@article{Alanen20032,
 abstract = {This paper discusses the difference and union of models in the context of a version control system. We show three metamodel-independent algorithms that calculate the difference between two models, merge a model with the difference of two models and calculate the union of two models. We show how to detect union conflicts and how they can be resolved either automatically or manually. We present an application of these algorithms in a version control system for MOF-based models. © Springer-Verlag Berlin Heidelberg 2003.},
 author = {Alanen, Marcus and Porres, Ivan},
 doi = {10.1007/978-3-540-45221-8_2},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 190},
 pages = {2 - 17},
 publication_stage = {Final},
 source = {Scopus},
 title = {Difference and union of models},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/0242370962?origin=resultslist},
 volume = {2863},
 year = {2003}
}
