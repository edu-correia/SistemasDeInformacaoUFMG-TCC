@conference{Jin2015343,
 abstract = {We present a system that interprets the notated rhythm obtained from optical music recognition (OMR). Our approach represents the notes and rests in a system measure as the vertices of a graph. We connect the graph by adding voice edges and coincidence edges between pairs of vertices, while the rhythmic interpretation follows simply from the connected graph. The graph identification problem is cast as an optimization where each potential edge is scored according to its plausibility. We seek the optimally scoring graph where the score is represented as a sum of edge scores. Experiments were performed on about 60 score pages showing that our system can handle difficult rhythmic situations including multiple voices, voices that merge and split, voices spanning two staves, and missing tuplets. © Rong Jin, Christopher Raphael.},
 author = {Jin, Rong and Raphael, Christopher},
 journal = {Proceedings of the 16th International Society for Music Information Retrieval Conference, ISMIR 2015},
 note = {Cited by: 2},
 pages = {343 - 349},
 publication_stage = {Final},
 source = {Scopus},
 title = {Graph-based rhythm interpretation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85069995407?origin=resultslist},
 year = {2015}
}
