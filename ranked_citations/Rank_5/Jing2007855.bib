@conference{Jing2007855,
 abstract = {From the current theories of Semantic Web and Ontology, this paper aims at exploring one way to construct, merge, map and evolve ontology in aviation product domain. Driven by its application background, the domain ontology is designed and built to support the "Auto-Mining System for Aviation Products". It merged with a Loom-based "military aircraft ontology" from USA via translating the used one from Loom to OWL. Also by referring to NASA Thesaurus, a comprehensive concept hierarchy is mapped into the domain ontology. Based on these, Protégé is used to visually implement a prototype for this domain ontology. Finally, evolution is completed by auto-extraction of instances from large amount of documents in this domain. ©2007 IEEE.},
 author = {Jing, Ma and Qingqing, Song and Sifeng, Liu},
 doi = {10.1109/GSIS.2007.4443395},
 journal = {Proceedings of 2007 IEEE International Conference on Grey Systems and Intelligent Services, GSIS 2007},
 note = {Cited by: 3},
 pages = {855 - 859},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on OWL-based construction, merging, mapping and evolution of ontology in aviation product domain},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/50249101175?origin=resultslist},
 year = {2007}
}
