@conference{Bernstein20071439,
 abstract = {We present an overview of a tutorial on model management - an approach to solving data integration problems, such as data warehousing, e-commerce, object-to-relational mapping, schema evolution and enterprise information integration. Model management defines a small set of operations for manipulating schemas and mappings, such as Match, Compose, Inverse, and Merge. The long-term goal is to build generic implementations of the operations that can be applied to a wide variety of data integration problems. Copyright 2007 VLDB Endowment, ACM.},
 author = {Bernstein, Philip A. and Ho, Howard},
 journal = {33rd International Conference on Very Large Data Bases, VLDB 2007 - Conference Proceedings},
 note = {Cited by: 17},
 pages = {1439 - 1440},
 publication_stage = {Final},
 source = {Scopus},
 title = {Model management and schema mappings: Theory and practice},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85011085758?origin=resultslist},
 year = {2007}
}
