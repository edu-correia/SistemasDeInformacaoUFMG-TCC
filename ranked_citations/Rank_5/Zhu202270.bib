@article{Zhu202270,
 abstract = {Three-way merging is an essential infrastructure in version control systems. While the traditional line-based textual methods are efficient, syntax-based structured approaches have shown advantages in enhancing merge accuracy. Prior structured merging approaches visit abstract syntax trees in a top-down manner, which is hard to detect and merge shifted code in the general sense. This paper presents a novel methodology combining a top-down and a bottom-up visit of abstract syntax trees, which manipulates shifted code effectively and elegantly. This merge algorithm is order-preserving and linear-time. Compared with four representative merge tools in 40,533 real-world merge scenarios, our approach achieves the highest merge accuracy and 2.4 × as fast as a state-of-the-art structured merge tool. © 2022, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Zhu, Fengmin and Xie, Xingyu and Feng, Dongyu and Meng, Na and He, Fei},
 doi = {10.1007/978-3-031-21213-0_5},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 4},
 pages = {70 - 87},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mastery: Shifted-Code-Aware Structured Merging},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85145175952?origin=resultslist},
 volume = {13649 LNCS},
 year = {2022}
}
