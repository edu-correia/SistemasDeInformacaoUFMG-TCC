@conference{Chuang2013,
 abstract = {This paper presents a depth estimation method based on dark channel prior to construct a depth map from a single 2D image of an outdoor scene for 3D display applications. The method computes a depth map using a series of image processing strategies such as dark channel computation, edge detection, the edge-based iterative thresholding technique, the region split-and-merge algorithm, the foreground and background classification, and the depth estimation by integration of dark channel and elevation information. Experimental results and comparisons show that the proposed method provides good depth estimation in boundaries and regions of sky and buildings. © 2013 IEEE.},
 author = {Chuang, Cheng-Hung and Shen, Wei-Chih and Lian, Zhen-You and Lin, Guo-Shiang},
 doi = {10.1109/ICICS.2013.6782859},
 journal = {ICICS 2013 - Conference Guide of the 9th International Conference on Information, Communications and Signal Processing},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Single image depth estimation based on dark channel prior},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84899075934?origin=resultslist},
 year = {2013}
}
