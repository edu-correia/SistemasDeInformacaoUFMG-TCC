@conference{Bhagwani201311,
 abstract = {WordNet, a widely used sense inventory for Word Sense Disambiguation(WSD), is often too fine-grained for many Natural Language applications because of its narrow sense distinctions. We present a semi-supervised approach to learn similarity between WordNet synsets using a graph based recursive similarity definition. We seed our framework with sense similarities of all the word-sense pairs, learnt using supervision on human-labelled sense clusterings. Finally we discuss our method to derive coarse sense inventories at arbitrary granularities and show that the coarse-grained sense inventory obtained significantly boosts the disambiguation of nouns on standard test sets. © 2013 Association for Computational Linguistics},
 author = {Bhagwani, Sumit and Satapathy, Shrutiranjan and Karnick, Harish},
 journal = {Proceedings of TextGraphs@EMNLP 2013: The 8th Workshop on Graph-Based Methods for Natural Language Processing},
 note = {Cited by: 4},
 pages = {11 - 19},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging word senses},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84942413487?origin=resultslist},
 year = {2013}
}
