@article{Foster2007669,
 abstract = {Increased reliance on optimistic data replication has led to burgeoning interest in tools and frameworks for synchronizing disconnected updates to replicated data. But good data synchronizers are challenging both to specify and to build. We have implemented a generic synchronization framework, called Harmony, that can be used to build state-based synchronizers for a wide variety of tree-structured data formats. A novel feature of this framework is that the synchronization process-in particular, the recognition of conflicts-is driven by the schema of the structures being synchronized. We formalize Harmony's synchronization algorithm, prove that it obeys a simple and intuitive specification, and illustrate, using simple address books as a case study, how it can be used to synchronize trees representing a variety of specific forms of application data, including sets, records, tuples, and relations. © 2006 Elsevier Inc. All rights reserved.},
 author = {Foster, J. Nathan and Greenwald, Michael B. and Kirkegaard, Christian and Pierce, Benjamin C. and Schmitt, Alan},
 doi = {10.1016/j.jcss.2006.10.024},
 journal = {Journal of Computer and System Sciences},
 note = {Cited by: 32; All Open Access; Green Open Access},
 number = {4},
 pages = {669 - 689},
 publication_stage = {Final},
 source = {Scopus},
 title = {Exploiting schemas in data synchronization},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33947312153?origin=resultslist},
 volume = {73},
 year = {2007}
}
