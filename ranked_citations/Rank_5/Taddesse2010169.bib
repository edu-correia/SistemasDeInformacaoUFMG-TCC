@article{Taddesse2010169,
 abstract = {Merging XML documents can be of key importance in several applications. For instance, merging the RSS news from same or different sources and providers can be beneficial for end-users in various scenarios. In this paper, we address this issue and explore the relatedness measure between RSS elements. We show here how to define and compute exclusive relations between any two elements and provide several predefined merging operators that can be extended and adapted to human needs. We also provide a set of experiments conducted to validate our approach. © Springer Science+Business Media, LLC 2009.},
 author = {Taddesse, Fekade Getahun and Tekli, Joe and Chbeir, Richard and Viviani, Marco and Yetongnon, Kokou},
 doi = {10.1007/s11280-009-0074-4},
 journal = {World Wide Web},
 note = {Cited by: 30},
 number = {1-2},
 pages = {169 - 207},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic-based merging of RSS items},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/78650984483?origin=resultslist},
 volume = {13},
 year = {2010}
}
