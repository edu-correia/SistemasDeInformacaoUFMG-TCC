@conference{Pan202447,
 abstract = {Aiming at the operation and maintenance pressure caused by frequent alarms for multiple servers and the problem of delayed or even missed core alarms, this paper proposes a merging and compression method of alarm information based on the improved Apriori algorithm. The method completes the merging and compression of alarm information through three steps of historical alarm information capture, model training and data validation test, optimizes the confidence calculation of traditional Apriori algorithm, and solves the distortion problem of confidence calculation caused by frequent alarm items. Experiments show that this method effectively merges and compresses alarm information, reduces the pressure of operation and maintenance, improves the emergency operation and maintenance capability, shortens the service recovery time, and achieves significant results in alarm compression and root cause analysis processing. This study provides technical support for the root cause localization of massive alarm information faults, and is of guiding significance for the prediction and merging display of the number of alarms in the future.  © 2024 IEEE.},
 author = {Pan, Lijun and Long, Yujiang and Wang, Ce and Tang, Jie and He, Xi and Lin, Zhenjie},
 doi = {10.1109/ICMLCA63499.2024.10753962},
 journal = {2024 5th International Conference on Machine Learning and Computer Application, ICMLCA 2024},
 note = {Cited by: 2},
 pages = {47 - 52},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on the Method of Combining and Compressing Alarm Messages in Multiple Microserver Applications},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85212681900?origin=resultslist},
 year = {2024}
