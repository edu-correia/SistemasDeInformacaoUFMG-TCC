@inproceedings{8098759,
 abstract = {Model matching is a fundamental operation for various model management aspects such as model retrieval, evolution, and merging. An accurate matching between the elements of the matched models results in a better model management. This paper presents a Hybridized Greedy-Genetic algorithm for matching UML class diagrams, considering their lexical, internal, and structural similarity. Additionally, using a case study of five class diagrams, the performance of the Hybridized algorithm is empirically compared against the traditional Genetic algorithm in terms of both matching accuracy and convergence time.},
 author = {Al-Khiaty, Mojeeb Al-Rhman and Ahmed, Moataz},
 booktitle = {2017 12th International Scientific and Technical Conference on Computer Sciences and Information Technologies (CSIT)},
 doi = {10.1109/STC-CSIT.2017.8098759},
 issn = {},
 keyword = {Unified modeling language;Genetic algorithms;Sociology;Statistics;Biological cells;Computational modeling;Clustering algorithms;similarity metrics;model matching;Hybridized-Greedy-Genetic},
 month = {Sep.},
 number = {},
 pages = {161-166},
 title = {Matching UML class diagrams using a Hybridized Greedy-Genetic algorithm},
 volume = {1},
 year = {2017}
}
