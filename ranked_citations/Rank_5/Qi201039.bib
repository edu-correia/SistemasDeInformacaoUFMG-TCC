@article{Qi201039,
 abstract = {In this paper, we compare some important merging operators in possibilistic logic. We first introduce semantic merging operators and adaptive merging operators in possibilistic logic. We then propose an approach to evaluating the discriminating power of these merging operators. After that, we analyze the computational complexity of these possibilistic merging operators. Finally, we consider the compatibility of possibilistic merging operators with propositional merging operators. © 2010 Springer-Verlag Berlin Heidelberg.},
 author = {Qi, Guilin and Liu, Weiru and Bell, David},
 doi = {10.1007/978-3-642-15280-1_7},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 7},
 pages = {39 - 50},
 publication_stage = {Final},
 source = {Scopus},
 title = {A comparison of merging operators in possibilistic logic},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78049400981?origin=resultslist},
 volume = {6291 LNAI},
 year = {2010}
}
