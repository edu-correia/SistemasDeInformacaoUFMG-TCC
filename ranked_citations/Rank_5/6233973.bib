@inproceedings{6233973,
 abstract = {In recent years, many domain ontologies have been developed and many of these ontologies contain overlapping or incompatible information. As systems that rely on domain ontologies expand, they often need to merge domain ontologies into a more general ontology. However, introducing ontology merging may cause redundancies and inconsistencies, which will break the soundness and balance of the original ontologies. In this paper we present an approach to refine the merged ontology. First the related process of ontologies merging is presented. Then, the refinement approach to the merged ontology is proposed including ontology pruning and ontology consistency checking. Further, the proposed approach is exemplified combing two example ontologies.},
 author = {Zhang, Jingyi and Lv, Yanhui},
 booktitle = {2012 9th International Conference on Fuzzy Systems and Knowledge Discovery},
 doi = {10.1109/FSKD.2012.6233973},
 issn = {},
 keyword = {Ontologies;Merging;Redundancy;Semantics;Inference algorithms;Modeling;Refining;Semantic web;Domain ontology;Ontology alignment;Ontology merging;Ontology refinement},
 month = {May},
 number = {},
 pages = {802-806},
 title = {An approach of refining the merged ontology},
 volume = {},
 year = {2012}
}
