@conference{Sriplakich2008674,
 abstract = {This work presents an approach for realizing Model-Driven software engineering in the distributed and multi-developers context. It particularly focuses on the scalability problems in a complex software project involving a large set of inter-connected models: (1) how to manipulate large data volume with limited computing resources, and (2) how to maintain consistency of inter-model links in a large model set, facing to concurrent model updates. As a solution, we propose the scalable copy-modify-merge mechanism, which allows each developer to copy only a model subset from the entire model set, to manipulate this subset locally, and to merge it back to the repository. This mechanism ensures the global consistency of the model set, particularly against dangling links. Our approach is generic: it is applicable to all model types (UML and Domain-Specific Models). Also, it offers interoperability with existing, heterogeneous CASE tools. Its prototype implementation in the ModelBus environment is now available on the Eclipse project "MDDi". Copyright 2008 ACM.},
 author = {Sriplakich, Prawee and Blanc, Xavier and Gervais, Marie-Pierre},
 doi = {10.1145/1363686.1363849},
 journal = {Proceedings of the ACM Symposium on Applied Computing},
 note = {Cited by: 19},
 pages = {674 - 681},
 publication_stage = {Final},
 source = {Scopus},
 title = {Collaborative software engineering on large-scale models: Requirements and experience in model bus},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/56749158693?origin=resultslist},
 year = {2008}
}
