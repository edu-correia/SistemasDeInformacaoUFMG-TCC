@conference{Costa2014318,
 abstract = {When developing a system in Model-driven Engineering (MDE), developers change the same diagram in parallel. These changes generate different versions that may conflict. Conflicts can be syntactic, related to the structure of the diagram, or semantic, related to the meaning of the diagram. The detection of semantic conflicts in diagrams should take into consideration both the syntax and semantics. This is necessary because languages like UML provide different representations that produce the same meaning. Therefore, syntactically different diagrams may be semantically equivalent. Thus, conflict detection methods must understand the semantics of diagrams to reduce the occurrence of false positive and false negative conflicts. This paper presents a semantic conflict detection method for UML class diagrams. It verifies if two versions of a class diagram are semantically equivalent, if one version semantically contains the other, or if they are semantically conflicting. Copyright © 2014 by Knowledge Systems Institute Graduate School.},
 author = {Costa, Valéria Oliveira and Monteiro, Rodrigo S. and Murta, Leonardo G. P.},
 journal = {Proceedings of the International Conference on Software Engineering and Knowledge Engineering, SEKE},
 note = {Cited by: 5},
 number = {January},
 pages = {318 - 323},
 publication_stage = {Final},
 source = {Scopus},
 title = {Detecting semantic equivalence in UML class diagrams},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84938353483?origin=resultslist},
 volume = {2014-January},
 year = {2014}
}
