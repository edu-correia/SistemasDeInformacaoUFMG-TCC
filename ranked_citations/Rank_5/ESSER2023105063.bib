@article{ESSER2023105063,
 abstract = {The design process in construction projects is iterative and multi-disciplinary in nature. In today’s industry practice, several discipline experts concurrently author multiple versions and design variants of BIM models and share them at frequent intervals. Applying a sound version control methodology can significantly enhance automation, enabling the coordination and combination of these model versions into consistent overall models with less extensive manual effort. This paper introduces a diff-and-patch mechanism for transferring changes between model versions, facilitating object-level change tracking using graph representations of BIM model data, and specifically focuses on merging diverging versions through the application of graph transformations. The mechanisms for executing branching and merging of model versions are thoroughly explained and showcased through various illustrative scenarios. The presented method adheres to the established principles of federated BIM collaboration but equips the participating parties with additional means to automate the combination of various model versions, allowing them to focus on the relevant conflicts. The proposed methodology of graph-based version control unlocks the potential of analyzing interdisciplinary dependencies across partial models and enables the more efficient resolution of conflicting model versions.},
 author = {Sebastian Esser and Simon Vilgertshofer and André Borrmann},
 doi = {https://doi.org/10.1016/j.autcon.2023.105063},
 issn = {0926-5805},
 journal = {Automation in Construction},
 keyword = {Model synthesis, BIM Level 3, Graph transformation, Patching, Merging, Time-evolving BIM models, Common Data Environment, Model Coordination},
 pages = {105063},
 title = {Version control for asynchronous BIM collaboration: Model merging through graph analysis and transformation},
 url = {https://www.sciencedirect.com/science/article/pii/S0926580523003230},
 volume = {155},
 year = {2023}
}
