@conference{Heinricher2016264,
 abstract = {An important problem in malware forensics is generating a partial ordering of a collection of variants of a malware program, reflecting a history of the malware's evolution as it is adapted by the original or new authors. We present new work extending our results on the malware lineage problem originally presented at FLAIRS 2013. We provide a new algorithm for reconstructing malware lineages with and without branch and merge events. This algorithm incorporates two innovations - the evaluation of candidate evolutionary traces based on candidate sets of feature accretion events and a machine-learning inspired approach to reducing overexplanation in the final lineage. The evolutionary trace algorithm is evaluated on several small families of malware whose ground truth lineage is known. © 2016, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
 author = {Heinricher, Alex and Jilcott, Steven},
 journal = {Proceedings of the 29th International Florida Artificial Intelligence Research Society Conference, FLAIRS 2016},
 note = {Cited by: 1},
 pages = {264 - 269},
 publication_stage = {Final},
 source = {Scopus},
 title = {An evolutionary trace algorithm for constructing malware lineages},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85003864917?origin=resultslist},
 year = {2016}
}
