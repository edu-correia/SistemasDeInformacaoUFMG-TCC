@article{Zhang2006739,
 abstract = {We consider how to forget a set of atoms in a logic program. Intuitively, when a set of atoms is forgotten from a logic program, all atoms in the set should be eliminated from this program in some way, and other atoms related to them in the program might also be affected. We define notions of strong and weak forgettings in logic programs to capture such intuition, reveal their close connections to the notion of forgetting in classical propositional theories, and provide a precise semantic characterization for them. Based on these notions, we then develop a general framework for conflict solving in logic programs. We investigate various semantic properties and features in relation to strong and weak forgettings and conflict solving in the proposed framework. We argue that many important conflict solving problems can be represented within this framework. In particular, we show that all major logic program update approaches can be transformed into our framework, under which each approach becomes a specific conflict solving case with certain constraints. We also study essential computational properties of strong and weak forgettings and conflict solving in the framework. © 2006 Elsevier B.V. All rights reserved.},
 author = {Zhang, Yan and Foo, Norman Y.},
 doi = {10.1016/j.artint.2006.02.002},
 journal = {Artificial Intelligence},
 note = {Cited by: 58},
 number = {8-9},
 pages = {739 - 778},
 publication_stage = {Final},
 source = {Scopus},
 title = {Solving logic program conflict through strong and weak forgettings},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33646108847?origin=resultslist},
 volume = {170},
 year = {2006}
}
