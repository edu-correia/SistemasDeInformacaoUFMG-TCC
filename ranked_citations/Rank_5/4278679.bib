@inproceedings{4278679,
 abstract = {Merging orchestrations is a crucial issue in the development process of service-based applications. However, merging orchestrations with overlaps is a manual and tedious process today. In this paper, we present a case-study on the Bronze-Standard, a medical imaging application built from Web-Service based orchestrations. We introduce the OMSM, an orchestration model supporting merging, that we designed to assist this process. Through a detailed analysis of the use-case, we show how our model helps the developer to obtain a proper composition of the application. There is still room for generalizing the approach to a broader set of orchestrations as discussed.},
 author = {Nemo-Cailliau, Clementine and Glatard, Tristan and Blay-Fornarino, Mireille and Montagnat, Johan},
 booktitle = {IEEE International Conference on Services Computing (SCC 2007)},
 doi = {10.1109/SCC.2007.79},
 issn = {},
 keyword = {Merging;Medical services;Biomedical equipment;Biomedical imaging;Image registration;Standards development;Laboratories;Engines;Service oriented architecture;Image analysis},
 month = {July},
 number = {},
 pages = {364-371},
 title = {Merging overlapping orchestrations: an application to the Bronze Standard medical application},
 volume = {},
 year = {2007}
}
