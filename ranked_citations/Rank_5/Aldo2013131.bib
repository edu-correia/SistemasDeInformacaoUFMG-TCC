@conference{Aldo2013131,
 abstract = {Retrieving Learning Objects (LO) that fulfills user's requirements, is still an issue. For instance, a user interested in linear regression topics (theoretical background) and examples (problems solved using a spreadsheet), might find two different resources covering these topics. Merging the two LOs as one would be a more appropriate solution rather than browsing them separately. This paper presents a novel approach for automatic selection of source LOs in order to construct a more appropriate one based on the users query. The combination of two or more LOs gathers not only knowledge but also tends to rank the new LO in a higher position than the source ones. This is accomplished by driving the merging process using the query. Our algorithm avoids including similar items in the new LO. © 2013 by Knowledge Systems Institute Graduate School.},
 author = {Aldo, Ramirez-Arellano and Elizabeth, Acosta-Gonzaga},
 journal = {Proceedings:  DMS 2013 - 19th International Conference on Distributed Multimedia Systems},
 note = {Cited by: 0},
 pages = {131 - 136},
 publication_stage = {Final},
 source = {Scopus},
 title = {MsMLO:A novel approach for selecting and fusing learning objects},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84923857078?origin=resultslist},
 year = {2013}
}
