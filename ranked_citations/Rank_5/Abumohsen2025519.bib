@conference{Abumohsen2025519,
 abstract = {Lung cancer (LC) remains one of the leading causes of cancer deaths worldwide, and this supports the urgency of achieving precise and timely diagnosis. In this paper, a multi-phase automated LC classification system is proposed based on a hybrid approach integrating classical machine learning (ML), deep feature extraction, and feature selection techniques. A proper dataset, Merge_CT, was obtained by combining two public CT (computed tomography) scan datasets and reclassified into three clinically relevant classes, i.e., benign, malignant, and normal. The pipeline was evaluated at three phases: 1) raw image-based ML, 2) deep feature extraction by using pre-trained CNNs (VGG16, DenseNet121, MobileNetV3), and 3) feature selection using RFE, ANOVA, MI, and GA. MobileNetV3-SVM achieved the best accuracy (99.80%), and feature selection increased efficiency, highlighting its strong discriminative ability for LC classification. The result presents evidence for an interpretable, scalable approach to assisting LC diagnosis in the clinical environment. © 2025 IEEE.},
 author = {Abumohsen, Mobarak and Costa-Montenegro, Enrique and Garcia-Mendez, Silvia and Owda, Amani Yousef and Owda, Majdi},
 doi = {10.1109/BTS-I2C67944.2025.11399396},
 journal = {Beyond Technology Summit on Informatics International Conference, BTS-I2C 2025},
 note = {Cited by: 0},
 pages = {519 - 524},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Hybrid Deep Feature and Machine Learning Approach for Multi-Class Lung Cancer Classification from CT},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105035993854?origin=resultslist},
 year = {2025}
}
