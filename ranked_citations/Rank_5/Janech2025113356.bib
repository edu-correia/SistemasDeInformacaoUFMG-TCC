 pages = {113356 - 113367},
 publication_stage = {Final},
 source = {Scopus},
 title = {Three-Way Merging Algorithm for Structured Data},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105008827707?origin=resultslist},
