@conference{Xiang2008501,
 abstract = {Peer-to-Peer(P2P) systems can be classified into two categories: unstructured and structured. A crucial requirement for practical structured P2P systems is that they should be able to cope with system splitting and merging. To address this issue, we first present a randomized and fault-tolerance broadcast algorithm called RBA. With RBA, we can inform all nodes in P2P system of splitting or merging. We provide its upper bound and show that it can be easily implemented on Chord without extra cost. Then we present our distributed splitting and merging protocols for structured P2P systems. It searches correct fingers rather than simply reconstructing fingers as previous protocols do. Compared with previous protocols, our protocols perform faster and reduce the cost of splitting and merging P2P systems dramatically. The performances of our algorithms have been evaluated using both theoretical analysis and simulation. © 2008 IEEE.},
 author = {Xiang, Xu},
 doi = {10.1109/ISISE.2008.136},
 journal = {2008 International Symposium on Information Science and Engineering, ISISE 2008},
 note = {Cited by: 0},
 pages = {501 - 505},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging and splitting structured Peer-to-Peer systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/62449336491?origin=resultslist},
 volume = {1},
 year = {2008}
}
