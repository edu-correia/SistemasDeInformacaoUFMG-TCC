@article{Sarvghad2019800,
 abstract = {Data grouping is among the most frequently used operations in data visualization. It is the process through which relevant information is gathered, simplified, and expressed in summary form. Many popular visualization tools support automatic grouping of data (e.g., dividing up a numerical variable into bins). Although grouping plays a pivotal role in supporting data exploration, further adjustment and customization of auto-generated grouping criteria is non-trivial. Such adjustments are currently performed either programmatically or through menus and dialogues which require specific parameter adjustments over several steps. In response, we introduce Embedded Merge Split (EMS), a new interaction technique for direct adjustment of data grouping criteria. We demonstrate how the EMS technique can be designed to directly manipulate width and position in bar charts and histograms, as a means for adjustment of data grouping criteria. We also offer a set of design guidelines for supporting EMS. Finally, we present the results of two user studies, providing initial evidence that EMS can significantly reduce interaction time compared to WIMP-based technique and was subjectively preferred by participants. © 1995-2012 IEEE.},
 author = {Sarvghad, Ali and Saket, Bahador and Endert, Alex and Weibel, Nadir},
 doi = {10.1109/TVCG.2018.2865075},
 journal = {IEEE Transactions on Visualization and Computer Graphics},
 note = {Cited by: 7},
 number = {1},
 pages = {800 - 809},
 publication_stage = {Final},
 source = {Scopus},
 title = {Embedded Merge Split: Visual adjustment of data grouping},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85052662234?origin=resultslist},
 volume = {25},
 year = {2019}
}
