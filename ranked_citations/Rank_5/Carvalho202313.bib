@conference{Carvalho202313,
 abstract = {We propose a language-based approach to software versioning. Unlike the traditional approach of mainstream version control systems, where each evolution step is represented by a textual diff, we treat versions as programming elements. Each evolution step, merge operation, and version relationship, is represented explicitly in the program. This provides compile time guarantees for safety code reuse from previous versions, as well as forward and backwards compatibility between versions, allowing clients to use newly introduced code without needing to refactor their program. By lifting the versioning to the language level, we pave the way for tools that interact with software repositories to have more insight regarding the evolution of the software semantics.  © 2023 Owner/Author.},
 author = {Carvalho, Luís},
 doi = {10.1145/3618305.3623589},
 journal = {SPLASH Companion 2023 - Companion Proceedings of the 2023 ACM SIGPLAN International Conference on Systems, Programming, Languages, and Applications: Software for Humanity},
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 pages = {13 - 15},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic Versioning for Python Programs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85178380886?origin=resultslist},
 year = {2023}
}
