@conference{Eunjung2005649,
 abstract = {In this research, we focused on an efficient reconciliation method for mobile environments, using edit scripts of XML data sent from each device. To get a simple model for mobile devices, we use the XML list data sharing model, which allows inserting/deleting subtrees only for the repetitive parts of the tree, based on the document type. Also, we use keys for repetitive part subtrees; keys are unique between nodes with a same parent. This model not only guarantees that the edit action always results a valid tree but also allows a linear time reconciliation algorithm due to key based list reconciliation. If we can assume that there is no insertion key conflicts, then the algorithm proposed in this paper takes O(m) time where m is the size of the edit script.},
 author = {Eunjung, Lee},
 journal = {Proceedings of the 2005 International Conference on Parallel and Distributed Processing Techniques and Applications, PDPTA'05},
 note = {Cited by: 0},
 pages = {649 - 655},
 publication_stage = {Final},
 source = {Scopus},
 title = {Reconciliation of changes on XML list},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/60849088275?origin=resultslist},
 volume = {2},
 year = {2005}
}
