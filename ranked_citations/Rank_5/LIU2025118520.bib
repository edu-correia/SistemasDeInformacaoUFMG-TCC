@article{LIU2025118520,
 abstract = {With the development of smart drilling devices, while drilling parameters are continuously recorded, enabling the identification of geological fractures based on these parameters. Identifying fractures in while drilling parameters has emerged as a potentially efficient and cost-effective method for evaluating rock mass conditions in rock engineering. However, during the drilling process, it is often necessary to adjust rig setting parameters to ensure the proper rig operation in changing formations. There is an issue that adjusting rig setting parameters during the drilling process will lead to changes in while drilling parameters, thereby affecting the accuracy of geological structures measurement based on while drilling parameters. Inspired by the concept of image-based semantic segmentation, this study proposes TSD UNet++, a semantic segmentation network specialized for time-series data to address this issue. Firstly, A dataset is established by merging experimental and virtual data. Then, TSD UNet++ network is trained to segment the while drilling parameters corresponding to the changing rig setting parameters and different geological discontinuities. Finally, the results of TSD UNet++ are validated by test dataset and compared with two traditional methods: thrust and DI threshold. Compared with thrust threshold, TSD UNet++ greatly improves precision on identifying bedding plane by 0.95 and reduce errors caused by adjusting rig setting parameters by 44.7 %. Compared with the DI threshold method, TSD UNet++ improves precision by 0.39 and reduces errors caused by adjusting rig setting parameters by 6.4 %. The proposed deep learning network can identify discontinuities under changing drilling conditions. It offers a more reliable way for geological investigation in rock engineering.},
 author = {Yangxiao Liu and Wancheng Zhu and Hui Li and Xige Liu},
 doi = {https://doi.org/10.1016/j.measurement.2025.118520},
 issn = {0263-2241},
 journal = {Measurement},
 keyword = {While drilling parameters, Geological discontinuities identification, Semantic segmentation network, Changing drilling condition},
 pages = {118520},
 title = {Identification of geological discontinuities via novel TSD UNet++ network under changing drilling conditions},
 url = {https://www.sciencedirect.com/science/article/pii/S0263224125018792},
 volume = {256},
 year = {2025}
}
