@conference{Panwar2025316,
 abstract = {Real-time collaboration features are vital in modern software, allowing multiple users to edit documents simultaneously while maintaining data integrity across devices. Traditional approaches like Operational Transformation (OT) and Conflict-free Replicated Data Types (CRDTs) each have limitations in handling large-scale concurrent editing and ensuring memory efficiency. In this paper, we introduce Eg-walker, a hybrid CRDT/OT algorithm that merges concurrent edits with optimal efficiency and reduced memory usage. Our evaluations show that Eg-walker can merge documents in milliseconds, requires significantly less memory than standard CRDTs, and operates effectively in peer-to-peer environments. This makes Eg-walker an efficient solution for distributed collaboration without reliance on a central server. © 2025 IEEE.},
 author = {Panwar, Praval},
 doi = {10.1109/ICCECT64621.2025.11339768},
 journal = {2025 IEEE 3rd International Conference on Control, Electronics and Computer Technology, ICCECT 2025},
 note = {Cited by: 0},
 pages = {316 - 324},
 publication_stage = {Final},
 source = {Scopus},
 title = {Eg-walker: A Fast, Memory-Efficient Collaborative Editing Algorithm for Distributed Systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105033341840?origin=resultslist},
 year = {2025}
}
