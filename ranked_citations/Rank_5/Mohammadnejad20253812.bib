@conference{Mohammadnejad20253812,
 abstract = {Merging onto a highway is a complex driving task that requires identifying a safe gap, adjusting speed, often interactions to create a merging gap, and completing the merge maneuver within a limited time window while maintaining safety and driving comfort. In this paper, we introduce a Safe Merging and Real-Time Merge (SMART-Merge) planner, a lattice-based motion planner designed to facilitate safe and comfortable forced merging. By deliberately adapting cost terms to the unique challenges of forced merging and introducing a desired speed heuristic, SMART-Merge planner enables the ego vehicle to merge successfully while minimizing the merge time. We verify the efficiency and effectiveness of the proposed merge planner through high-fidelity CarMaker simulations on hundreds of highway merge scenarios. Our proposed planner achieves the success rate of 100 % as well as completes the merge maneuver in the shortest amount of time compared with the baselines, demonstrating our planner's capability to handle complex forced merge tasks and provide a reliable and robust solution for autonomous highway merge. The simulation result videos are available at https://sites.google.com/view/smart-merge-planner/home. © 2025 IEEE.},
 author = {Mohammadnejad, Toktam and D'Sa, Jovin and Chalaki, Behdad and Mahjoub, Hossein Nourkhiz and Moradi-Pari, Ehsan},
 doi = {10.1109/ITSC60802.2025.11423102},
 journal = {IEEE Conference on Intelligent Transportation Systems, Proceedings, ITSC},
 note = {Cited by: 0},
 pages = {3812 - 3819},
 publication_stage = {Final},
 source = {Scopus},
 title = {SMART-Merge Planner: A Safe Merging and Real-Time Motion Planner for Autonomous Highway on-Ramp Merging},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105036975000?origin=resultslist},
 year = {2025}
