@conference{Tan2010438,
 abstract = {This paper presents a lossless method (named Tele-DTM, means Tele-Decomposition-Transmission-Merge) to transmit tele-medical image distributed using p2p principle. In this solution, by decomposing the medical image into n subimages (n equals to the amount of expert nodes); the patient node transmits these n sub-images to the corresponding expert nodes separately. When received the first sub-images, the expert node forwards a sub-image copy to the other n-1 expert nodes. At last, the expert node merges all of the sub-images into one whole image. This Tele-DTM releases the patient node CPU and also save delay time. Some algorithms of Tele-DTM are presented in this solution. © 2010 IEEE.},
 author = {Tan, Zhenhua and Wang, Xueyi and Ma, Yi and Wang, Xingwei},
 doi = {10.1109/ICGEC.2010.115},
 journal = {Proceedings - 4th International Conference on Genetic and Evolutionary Computing, ICGEC 2010},
 note = {Cited by: 1},
 pages = {438 - 441},
 publication_stage = {Final},
 source = {Scopus},
 title = {A distributed lossless transmission method for tele-medical image},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/79952553456?origin=resultslist},
 year = {2010}
}
