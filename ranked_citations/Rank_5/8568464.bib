@inproceedings{8568464,
 abstract = {This paper reviews the historical dielectric studies together with more recent publications to establish the current knowledge of the dielectric properties of breast tissue with specific focus on the dielectric contrast between normal and diseased tissue. A comparison between historic and more recent publications, shows that conflicting ideas exist as to whether a significant difference between normal and diseased breast tissue exists. The large variability in the reported dielectric properties contributes significantly to these conflicting results. Also, most of the reported studies lack the reporting of accurate meta-data of the experimental setup and thus it is very difficult to merge and compare different datasets.},
 author = {Farrugia, Lourdes and Bonello, Julian and Sammut, Charles V},
 booktitle = {12th European Conference on Antennas and Propagation (EuCAP 2018)},
 doi = {10.1049/cp.2018.0786},
 issn = {},
 keyword = {dielectric properties;breast;microwave imaging},
 month = {April},
 number = {},
 pages = {1-3},
 title = {Dielectric properties of breast: A review},
 volume = {},
 year = {2018}
}
