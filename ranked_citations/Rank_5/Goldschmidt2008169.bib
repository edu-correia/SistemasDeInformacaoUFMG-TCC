@article{Goldschmidt2008169,
 abstract = {Textual concrete syntaxes for models are beneficial for many reasons. They foster usability and productivity because of their fast editing style, their usage of error markers, autocompletion and quick fixes. Furthermore, they can easily be integrated into existing tools such as diff/merge or information interchange through e-mail, wikis or blogs. Several frameworks and tools from different communities for creating concrete textual syntaxes for models emerged during recent years. However, these approaches failed to provide a solution in general. Open issues are incremental parsing and model updating as well as partial and federated views. To determine the capabilities of existing approaches, we provide a classification schema, apply it to these approaches, and identify their deficiencies. © 2008 Springer-Verlag Berlin Heidelberg.},
 author = {Goldschmidt, Thomas and Becker, Steffen and Uhl, Axel},
 doi = {10.1007/978-3-540-69100-6_12},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 36},
 pages = {169 - 184},
 publication_stage = {Final},
 source = {Scopus},
 title = {Classification of concrete textual syntax mapping approaches},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70349852882?origin=resultslist},
 volume = {5095 LNCS},
 year = {2008}
}
