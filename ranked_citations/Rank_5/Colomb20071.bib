@article{Colomb20071,
 abstract = {Merging of ontologies is a frequently addressed problem in the ontology literature. This paper argues that in general two even very similar ontologies cannot be merged. Further, where two ontologies can be merged their conceptualizations are special. They are systems of institutional facts which are interlocking. The argument is based on the literature of the federated database problem and on the concepts of speech act and institutional fact. © 2007 - IOS Press and the authors. All rights reserved.},
 author = {Colomb, Robert M. and Ahmad, Mohammad Nazir},
 journal = {Applied Ontology},
 note = {Cited by: 22},
 pages = {1 - 12},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging ontologies requires interlocking institutional worlds},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85013573831?origin=resultslist},
 volume = {1},
 year = {2007}
}
