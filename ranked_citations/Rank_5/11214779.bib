@inproceedings{11214779,
 abstract = {In Traffic Separation Scheme waters, when vessels merge into the main channel, it is prone to traffic conflicts and efficiency bottlenecks. Traditional decision-making methods based on collision avoidance rules struggle to balance multi-ship cooperation and global optimality. To address this, this paper proposes a cooperative decision-making model for vessel merging based on cooperative game theory, aiming to improve navigational safety and traffic efficiency through multi-agent interest balancing and cooperation negotiation. Firstly, by combining TSS navigation rules and vessel encounter scenarios, a cooperative game framework is constructed with merging vessels and main channel vessels as participants, quantifying game elements such as cooperative benefits, safety benefits, and efficiency benefits. Secondly, a benefit distribution strategy is designed, introducing vessel maneuvering constraints, safety distance, and speed adjustment thresholds as boundary conditions for the game to ensure the physical feasibility and regulatory compliance of the decision-making scheme. Furthermore, a layered optimization algorithm is proposed to achieve multi-objective Pareto optimal solution search through conflict resolution and cooperative speed planning. Simulation results indicate that the proposed model effectively reduces passage delays and lowers conflict risks in vessel merging scenarios. The research findings can provide theoretical support for multi-ship cooperative decision-making and traffic flow optimization in intelligent shipping, contributing to the intelligent upgrade of traffic management in complex waters.},
 author = {Zhang, Lin and Yip, Tsz Leung and Li, Zhuoyi and Chen, Deshan},
 booktitle = {2025 8th International Conference on Transportation Information and Safety (ICTIS)},
 doi = {10.1109/ICTIS68762.2025.11214779},
 issn = {2832-899X},
 keyword = {Climate change;Adaptation models;Navigation;Merging;Games;Safety;Delays;Game theory;Marine vehicles;Optimization;Cooperative game theory;Action decision-making;Traffic Separation Scheme;Safe navigation},
 month = {July},
 number = {},
 pages = {1700-1707},
 title = {Cooperative Game Approach to Vessel Merging Decisions in Traffic Separation Scheme Waters},
