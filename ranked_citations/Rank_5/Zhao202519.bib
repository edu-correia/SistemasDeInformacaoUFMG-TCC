@conference{Zhao202519,
 abstract = {This study presents the Asynchronous Concurrent Control (ACC) system, a lightweight middleware for cloudassisted database synchronization to ensure eventual consistency across geo-distributed mobile devices. ACC offloads conflict resolution to the cloud and uses a branch-and-merge approach to track and merge client states in the cloud, propagating differential updates through anti-entropy packets. This reduces cloud-client interactions, and minimizes computational burdens on mobile devices. Experimental results show that ACC achieves low synchronization latency with minimal impact on write performance and improves efficiency during offline reconnection.  © 2025 IEEE.},
 author = {Zhao, Wenbo and Li, Longhai and Li, Hui and Chen, Mingtao and Xie, Mingsong and Chang, Yuheng and Cui, Jiangtao},
 doi = {10.1109/ICDCSW63273.2025.00010},
 journal = {Proceedings - 2025 IEEE 45th International Conference on Distributed Computing Systems Workshops, ICDCSW 2025},
 note = {Cited by: 0},
 pages = {19 - 24},
 publication_stage = {Final},
 source = {Scopus},
 title = {ACC: Ensuring Eventual Consistency across Diverse Data Stores in End-Cloud Collaboration},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105030502049?origin=resultslist},
 year = {2025}
}
