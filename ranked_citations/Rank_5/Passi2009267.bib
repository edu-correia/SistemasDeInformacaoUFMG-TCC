@conference{Passi2009267,
 abstract = {When e-commerce companies merge there is a need to integrate their local schema into a uniform global source that is easily generated and maintained. In this paper we explore the incremental maintenance of global XML schema against updates to local schemas with the use of three simple operations, Add, Remove, and Change. These operations are designed to work as an extension to the AXIS model [12], which currently does not have a way to maintain the global schema once an underlying source schema is updated. Copyright ©2009 ACM.},
 author = {Passi, Kalpdrum and Morgan, Don and Madria, Sanjay},
 doi = {10.1145/1620432.1620461},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 7},
 pages = {267 - 274},
 publication_stage = {Final},
 source = {Scopus},
 title = {Maintaining integrated XML schema},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70350639232?origin=resultslist},
 year = {2009}
}
