@conference{Mercado20181828,
 abstract = {Multilayer graphs encode different kind of interactions between the same set of entities. When one wants to cluster such a multilayer graph, the natural question arises how one should merge the information from different layers. We introduce in this paper a one-parameter family of matrix power means for merging the Laplacians from different layers and analyze it in expectation in the stochastic block model. We show that this family allows to recover ground truth clusters under different settings and verify this in real world data. While computing the matrix power mean can be very expensive for large graphs, we introduce a numerical scheme to efficiently compute its eigenvectors for the case of large sparse graphs. Copyright 2018 by the author(s).},
 author = {Mercado, Pedro and Gautier, Antoine and Tudisco, Francesco and Hein, Matthias},
 journal = {International Conference on Artificial Intelligence and Statistics, AISTATS 2018},
 note = {Cited by: 21},
 pages = {1828 - 1838},
 publication_stage = {Final},
 source = {Scopus},
 title = {The power mean laplacian for multilayer graph clustering},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85067792083?origin=resultslist},
 volume = {84},
 year = {2018}
}
