@inproceedings{5232162,
 abstract = {Continuous contour lines rise prominent function in drawing DEM and querying between graphics and attribute. When they are divided into a lot of parts and drawn in the map with fixed size, the merged problem of the contour lines which are described in different maps has been a tough problem during the handling process of foundation data. This paper puts forward the problems when joining the intersected contour lines firstly, and then give five constraints about merging contour lines. Trough coordinate system conversion and template matrix calculating, we find the identical points of two corresponding regular grid DEMs. Finally, we get the results of joining the intersected contour lines intelligently.},
 author = {Yan, Sun and Cheng, Wang and Fei, Xie},
 booktitle = {2009 International Forum on Information Technology and Applications},
 doi = {10.1109/IFITA.2009.349},
 issn = {},
 keyword = {Information technology;Sun;Graphics;Merging;Geographic Information Systems;Workstations;intersected contour lines;intelligentization;regular grid DEM;identical points},
 month = {May},
 number = {},
 pages = {469-471},
 title = {Method for Joining Intersected Contour Lines Intelligently},
 volume = {3},
 year = {2009}
}
