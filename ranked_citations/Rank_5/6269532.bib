@inproceedings{6269532,
 abstract = {According to the China's aviation fuel market, the article constructs a supply chain model including three upstream firms and three downstream firms to solve China's aviation fuel security. Then, we analyze the merger game among the upstream and downstream manufacturers in the condition of scarce supply. Results show that the vertical relation of aviation fuel supply chain will be adjusted and the airlines will merge with the manufacturers to guarantee its supply. However, the strength of policy barriers decides the degree of integration. The degree of integration will be lower when the policy barriers getting stronger.},
 author = {Yong Ding and Guankai Wang and Lei li},
 booktitle = {2012 IEEE International Conference on Computer Science and Automation Engineering},
 doi = {10.1109/ICSESS.2012.6269532},
 issn = {2327-0594},
 keyword = {Educational institutions;Fuels;Games;aviation fuel;supply chain;vertical relation arrangement},
 month = {June},
 number = {},
 pages = {573-578},
 title = {Research on Vertical Relation Arrangement of aviation fuel supply chain},
 volume = {},
 year = {2012}
}
