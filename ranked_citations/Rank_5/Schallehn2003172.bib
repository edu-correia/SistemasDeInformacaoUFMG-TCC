@article{Schallehn2003172,
 abstract = {Dealing with discrepancies in data is still a big challenge in data integration systems. The problem occurs both during eliminating duplicates from semantic overlapping sources as well as during combining complementary data from different sources. Though using SQL operations like grouping and join seems to be a viable way, they fail if the attribute values of the potential duplicates or related tuples are not equal but only similar by certain criteria. As a solution to this problem, we present in this paper similarity-based variants of grouping and join operators. The extended grouping operator produces groups of similar tuples, the extended join combines tuples satisfying a given similarity condition. We describe the semantics of these operators, discuss efficient implementations for the edit distance similarity and present evaluation results. Finally, we give examples how the operators can be used in given application scenarios. © Springer-Verlag Berlin Heidelberg 2003.},
 author = {Schallehn, Eike and Sattler, Kai-Uwe},
 doi = {10.1007/3-540-45073-4_14},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 11},
 pages = {172 - 189},
 publication_stage = {Final},
 source = {Scopus},
 title = {Using similarity-based operations for resolving data-level conflicts},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/25144440735?origin=resultslist},
 volume = {2712},
 year = {2003}
}
