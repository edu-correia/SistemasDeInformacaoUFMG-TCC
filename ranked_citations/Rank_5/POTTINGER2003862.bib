@incollection{POTTINGER2003862,
 abstract = {Publisher Summary
This chapter defines the Merge operator for model merging, both generically and for a specific meta-meta-model, Vanilla. It defines and classifies the conflicts that arise in combining two models and describes when conflicts from different classes must be resolved. Resolution strategies for conflicts that must be resolved in Merge, both for Vanilla and in general are presented. The chapter evaluates Merge by showing how Merge in Vanilla can be used to subsume some previous merging algorithms and by testing Merge on two large real-world ontologies. The chapter envisions several future directions. The first involves showing that the Merge result, when applied to models and mappings that are templates for instances, has an appropriate interpretation on instances. This will demonstrate the usefulness of Merge in specific applications such as data integration and view integration.},
 address = {San Francisco},
 author = {Rachel A. Pottinger and Philip A. Bernstein},
 booktitle = {Proceedings 2003 VLDB Conference},
 doi = {https://doi.org/10.1016/B978-012722442-8/50081-1},
 editor = {Johann-Christoph Freytag and Peter Lockemann and Serge Abiteboul and Michael Carey and Patricia Selinger and Andreas Heuer},
 isbn = {978-0-12-722442-8},
 pages = {862-873},
 publisher = {Morgan Kaufmann},
 title = { - Merging Models Based on Given Correspondences},
 url = {https://www.sciencedirect.com/science/article/pii/B9780127224428500811},
 year = {2003}
}
