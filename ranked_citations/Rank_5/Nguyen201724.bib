@article{Nguyen201724,
 abstract = {Belief merging is one of active research fields with a large range of applications in Artificial Intelligence. Most of the work in this research field is in the centralized approach, however, it is difficult to apply to interactive systems such as multi-agent systems. In this paper, we introduce a new argumentation framework for belief merging. To this end, a constructive model to merge possiblistic belief bases built based on the famous general argumentation framework is proposed. An axiomatic model, including a set of rational and intuitive postulates to characterize the merging result is introduced and several logical properties are mentioned and discussed. © Springer International Publishing AG 2017.},
 author = {Nguyen, Thi Hong Khanh and Tran, Trong Hieu and Van Nguyen, Tran and Le, Thi Thanh Luu},
 doi = {10.1007/978-3-319-54472-4_3},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3},
 pages = {24 - 34},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merging possibilistic belief bases by argumentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85018607152?origin=resultslist},
 volume = {10191 LNAI},
 year = {2017}
}
