@inproceedings{4908469,
 abstract = {This paper proposes an efficient architecture to produce a hierarchical access control scheme for the multicast application environment. The architecture divides the group members into several subgroups with different access rights. In order to enhance the efficiency, the theory of Weil pairing is introduced to present a three party key agreement protocol. The advantages of this scheme are : (1) easy implementation, (2) support high dynamics group controls, including join, leave, merge and partition. Meanwhile, the communication and broadcasting between group members is merely constant rounds. Furthermore, this scheme is well-suited for high-delay wide area network.},
 author = {Xia, Jingbo and Rongwei, Yu and Ai, Xiaochuan},
 booktitle = {2009 International Conference on Networks Security, Wireless Communications and Trusted Computing},
 doi = {10.1109/NSWCTC.2009.80},
 issn = {},
 keyword = {Educational institutions;Electronic mail;Access control;Tree data structures;Elliptic curve cryptography;Computer architecture;Communication system control;TV broadcasting;Computational efficiency;Protocols;access control;weil pairing;ternary tree;key agreement},
 month = {April},
 number = {},
 pages = {319-322},
 title = {A New Efficient Hierarchical Key Agreement Scheme},
 volume = {2},
 year = {2009}
