@conference{Bernstein2003,
 abstract = {Model management is a new approach to meta data management that offers a higher level programming interface than current techniques. The main abstractions are models (e.g., schemas, interface definitions) and mappings between models. It treats these abstractions as bulk objects and offers such operators as Match, Merge, Diff, Compose, Apply, and ModelGen. This paper extends earlier treatments of these operators and applies them to three classical meta data management problems: schema integration, schema evolution, and round-trip engineering. © CIDR 2003.All rights reserved.},
 author = {Bernstein, Philip A.},
 journal = {1st Biennial Conference on Innovative Data Systems Research, CIDR 2003},
 note = {Cited by: 381},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Applying Model Management to Classical Meta Data Problems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105029791488?origin=resultslist},
 year = {2003}
}
