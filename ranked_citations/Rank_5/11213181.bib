@inproceedings{11213181,
 abstract = {Material handling in industrial environments is a critical yet challenging task where automation, particularly with Automated Guided Vehicles (AGVs), can significantly improve efficiency. This paper addresses the complex problem of path planning for multiple AGVs operating concurrently and asynchronously in a dynamic industrial setting. A path planning approach is proposed, leveraging advanced algorithms and real-time data to optimize AGV movement. The enhanced algorithm, Granular Conflict-Based Search (CBS), accounts for varying agent sizes, ensuring smaller agents do not have to merge or take sub-optimal paths, thereby reducing complications from sudden path changes. This paper compares the performance of conventional CBS with the Granular CBS algorithm. In terms of computation time, the Granular CBS was able to determine the shortest path in less than half of the time taken by CBS algorithm. The algorithm was deployed in a real-world experiment using a Django-based web server. The findings demonstrate the potential of the Granular CBS algorithm to advance intelligent material handling systems, contributing to smart manufacturing and Industry 4.0 initiatives.},
 author = {A, Balaharshitha and V, Surya and T, Aadhersh and S, Kabilan R and R, Ranjith},
 booktitle = {2025 11th International Conference on Electrical Energy Systems (ICEES)},
 doi = {10.1109/ICEES67011.2025.11213181},
 issn = {2693-3934},
 keyword = {Remotely guided vehicles;Heuristic algorithms;Materials handling;Transportation;Search problems;Path planning;Real-time systems;Web servers;Vehicle dynamics;Smart manufacturing;AGV;Path Planning;Multi-Agent Path finding (MAPF);Granular Conflict-Based Search algorithm;Industrial Automation and Material Handling},
 month = {Aug},
 number = {},
 pages = {408-413},
 title = {Using "Granular Conflict Based Search" to solve Multi Agent Path Finding Problems for Collaborative Automated Guided Vehicles in Industrial Environments},
 volume = {},
 year = {2025}
}
