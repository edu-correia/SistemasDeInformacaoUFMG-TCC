@article{PASHAPOUR2026136511,
 abstract = {The development of sustainable energy systems is critical to addressing global challenges, and this study presents a novel hybrid power generation system that integrates an inverted gas turbine with a solid oxide fuel cell (SOFC) operating on ammonia. In this research, simulation techniques are employed to conduct an in-depth analysis of system behavior, enabling a comprehensive evaluation of performance, efficiency, and operational stability. Simultaneously, a rigorous selection process for off-the-shelf components is implemented, with a particular focus on utilizing turbochargers repurposed as gas turbines and incorporating dual parallel turbines to enhance control flexibility and responsiveness. This inspiring approach represents one of the first investigations into hybrid configurations that are specifically optimized for ammonia fuel applications, offering a compelling alternative to traditional reliance on hydrogen or biofuels. The study further challenges conventional design practices by critically reassessing the placement of heat exchangers and by proposing evidence-based alternatives that maximize thermal efficiency. Additionally, an innovative air bypass strategy around the SOFC is introduced to address off-design issues under varying load conditions. The integration of these novel strategies results in a system efficiency of 68.45 %, markedly improved from the standalone SOFC operation—typically achieving efficiencies of around 49 % with hydrogen and 58 % with ammonia. By merging detailed simulation modeling with practical, off-the-shelf component selection, this work not only advances the technical limits of ammonia-fueled hybrid systems but also opens a pathway toward the commercialization of cost-effective, decentralized power generation for remote and off-grid applications. These advancements contribute significantly to the evolution of sustainable and environmentally friendly energy solutions, setting a new standard in hybrid power system design. This work represents a paradigm shift.},
 author = {Jafar Pashapour and Majid Amidpour and Farschad Torabi},
 doi = {https://doi.org/10.1016/j.fuel.2025.136511},
 issn = {0016-2361},
 journal = {Fuel},
 keyword = {Inverted gas turbine, SOFC, Ammonia, Off-the-shelf component, Turbocharger, Hybrid},
 pages = {136511},
 title = {Simulation and off-the-shelf integration in an ammonia-fueled hybrid energy system: Merging parallel inverted gas turbines and SOFCs for decentralized power generation},
 url = {https://www.sciencedirect.com/science/article/pii/S0016236125022367},
 volume = {405},
 year = {2026}
}
