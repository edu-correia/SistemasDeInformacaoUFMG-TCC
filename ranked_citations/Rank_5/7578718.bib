@inproceedings{7578718,
 abstract = {Because of the diversity of the fault diagnosis (FD) methods and the limit when they are applied to the on-board FD unit and the ground FD unit of spacecraft, conflict and divergence may exist in fault diagnosis results obtained by different methods. In order to realize the uniformity of the results, a space-earth fault diagnosis result merging algorithm based on weighted evidence theory (WET) is proposed. The elementary connotation and the composition law of the WET are given, and then the space-earth fault diagnosis result merging frame of spacecraft is supplied. The weight determination influencing factors of the fault diagnosis methods, the on-board FD unit and the ground FD unit, are comprehensive analyzed, and then the quantitative weight determination method based on the analytic hierarchy process (AHP) is proposed, which can be used to solve the weight determination problem in the space-earth fault diagnosis result merging process. Finally, by considering three fault modes, and using the fault diagnosis results obtained by four methods, the efficiency of the proposed method is illustrated.},
 author = {Liu, Wenjing and Teng, Baoyi},
 booktitle = {2016 12th World Congress on Intelligent Control and Automation (WCICA)},
 doi = {10.1109/WCICA.2016.7578718},
 issn = {},
 keyword = {Fault diagnosis;Space vehicles;Merging;Indexes;Intelligent control;Analytic hierarchy process;Telemetry},
 month = {June},
 number = {},
 pages = {1742-1748},
 title = {Application of weighted evidence theory in the space-earth fault diagnosis result fusion of spacecraft},
 volume = {},
 year = {2016}
}
