@conference{Tokunaga2011,
 abstract = {Code clone is a code fragment that has identical or similar fragments to it in the source code. Fowler and Kereivsky wrote several techniques to remove code clones in refactoring patterns that they documented. Those refactoring patterns include characteristics of code clone and corresponding steps to merge code clones. However, according to our experience in code clone research field, a lot of different types exist between code clones similar to each others, and most of those difference types are not mentioned in previous refactoring pattern. It is useful to develop a collection of patterns for clone refactoring based on precise code clone categorization. In this paper, we describe an approach to developing our intended collection of refactoring patterns and then propose an example of refactoring pattern that we have developed. Copyright 2011 ACM.},
 author = {Tokunaga, Masayuki and Yoshida, Norihiro and Yoshioka, Kazuki and Matsushita, Makoto and Inoue, Katsuro},
 doi = {10.1145/2524629.2524637},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards a collection of refactoring patterns based on code clone categorization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84940645362?origin=resultslist},
 volume = {2011-October},
 year = {2011}
}
