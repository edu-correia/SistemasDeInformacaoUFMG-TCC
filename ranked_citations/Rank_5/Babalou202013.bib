@article{Babalou202013,
 abstract = {With the growing popularity of semantics-aware integration solutions, various ontology merging approaches have been proposed. Determining the success of these developments heavily depends on suitable evaluation criteria. However, no comprehensive set of evaluation criteria on the merged ontology exists so far. We develop criteria to evaluate the merged ontology. These criteria cover structure, function and usability of the merged ontology by evaluating General Merge Requirements (GMR)s, analyzing the intended use and semantics, and considering the ontology and entity annotation, respectively. We demonstrate the applicability of our criteria by providing empirical tests. © 2020, Springer Nature Switzerland AG.},
 author = {Babalou, Samira and Grygorova, Elena and König-Ries, Birgitta},
 doi = {10.1007/978-3-030-62327-2_3},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3},
 pages = {13 - 18},
 publication_stage = {Final},
 source = {Scopus},
 title = {How Good Is This Merged Ontology?},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85097276851?origin=resultslist},
 volume = {12124 LNCS},
 year = {2020}
}
