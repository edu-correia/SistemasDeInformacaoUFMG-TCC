@conference{Ren2018179,
 abstract = {Fork-based development allows developers to start development from existing software repository by copying the code files. However, when the number of forks grows, contributions are not always visible to others, unless an explicit merge-back attempt is made. To solve this problem, we implemented Forks Insight (www.forks-insight.com) to help developers get an overview of forks on GitHub. The current release version focuses on simple analytics for the high level overview which is lightweight, scalable and practical. It has a user-friendly interactive web interface with features like searching and tagging. © 2018 Authors.},
 author = {Ren, Luyao and Zhou, Shurui and Kästner, Christian},
 doi = {10.1145/3183440.3195085},
 journal = {Proceedings - International Conference on Software Engineering},
 note = {Cited by: 9},
 pages = {179 - 180},
 publication_stage = {Final},
 source = {Scopus},
 title = {Poster: Forks insight: Providing an overview of GitHub forks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85049673946?origin=resultslist},
 year = {2018}
}
