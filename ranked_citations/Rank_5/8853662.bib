@inproceedings{8853662,
 abstract = {Nowadays, a wide market of server computer segments, have open doors for more competitive products. Such competitive environment is requiring of challenging computer server designs, as occurs in cloud computing and data-telecommunication services. Either by selecting a high end performance computing segment with high power consumption, or choosing an entry computing server, there are enough arguments to look into lowering power consumption. Hence, in this paper, we describe an optimized performance solution, based on platform's cost reduction perspective. The optimization is achieved by merging two similar power domains, aided by the implementation of a constrained optimization algorithm, taking as reference the development of a specific surrogate based power delivery model achieving desired power and voltage performance outputs.},
 author = {Gonzalez-Soto, Diana P. and Leal-Romo, Felipe de J. and Sánchez-Ortiz, Carlos R.},
 booktitle = {2019 IEEE MTT-S International Conference on Numerical Electromagnetic and Multiphysics Modeling and Optimization (NEMO)},
 doi = {10.1109/NEMO.2019.8853662},
 issn = {},
 keyword = {Optimization;Resistors;Sensors;Load modeling;Conferences;Computational modeling;Numerical models;direct constrained optimization;dual sense resistor;multichip package;power distribution network;voltage regulator;surrogate model},
 month = {May},
 number = {},
 pages = {1-4},
 title = {MCP Optimization Solutions Based on Dual Sensing Voltage Regulator Implementation},
 volume = {},
 year = {2019}
}
