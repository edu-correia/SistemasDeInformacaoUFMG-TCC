@article{RYBAKIN202614,
 abstract = {There are processes in our Galaxy that release a very large amount of energy. This energy is greater in many orders than the energy released by the Sun. These processes generate and release enormous amounts of energy in the form of cosmic radiation. These energy flows originate in quasars, black holes, protostars, and supernova explosions. A significant amount of energy is released during gamma-ray bursts, which occur during the merge of neutron stars and the collapse of supernovae. Supernova explosions release vast amounts of energy in the form of high-energy particles. These processes can have a significant impact on the safety of space travel. The resulting ionizing radiation has a significantly greater effect on tissues than X-rays and gamma radiation. This is expressed in a significantly stronger destruction of the DNA structure in cells as a result of direct destruction of cells under the influence of ionization. The article describes the research of the process of super-dense clumps formation considering the stratified background formed as a result of molecular clouds (MCs) collisions with each other, when a shock wave falls on a MC, and other dynamic effects in the interstellar medium. Recent observations show that intense collisions of molecular clouds can trigger the formation of massive stars/clusters. One of the most important physical processes during collision is shock compression. This paper explores the formation of a dense, lens-like structure into which the MC substance flows. It was found that the shock compression of turbulent, heterogeneous molecular clouds creates massive filamentary structures. The aim of the paper is to research the initial stages of protostellar clumps formation, which are formed by such a shock compression. Therefore, the definition of physical criteria of instability and the analysis of critical properties of the clumps are fundamentally important for the theory of star formation. In this paper, we study the processes of formation of superdense clumps, their mutual collisions, which lead either to an increase in the density of nuclei or to their destruction. It is shown that during the formation of such clumps in the case of a supersonic shock wave falling on the system of their two molecular clouds, the destruction of nuclei does not occur. This is most likely due to the fact that the shock wave flowing around the clouds prevents their collisions. In the case of a collision of two MOs, starting from the moment of 1 million years, the processes of collision of nuclei with each other and their destruction or merging begin. This process reaches maximum values when the nuclei reach maximum density. This paper presents an analysis of the processes of collision, growth and/or decay of clumps for sixteen of the densest nuclei. In addition, calculations were carried out on new AMD Ryzen 9 7950X3D processors with a significantly increased L3 cache. To take advantage of the increased L3 cache, the working program was modernized.},
 author = {Boris Rybakin},
 doi = {https://doi.org/10.1016/j.actaastro.2025.10.038},
 issn = {0094-5765},
 journal = {Acta Astronautica},
 keyword = {Molecular cloud-cloud collision, Supersonic turbulence, Superdense clumps, Kelvin–Helmholtz instability, Parallel computing},
 pages = {14-20},
 title = {Formation of dense protostellar cores in molecular clouds, their growth, collisions, fragmentation, and destruction in a turbulent environment},
 url = {https://www.sciencedirect.com/science/article/pii/S0094576525007192},
 volume = {239},
 year = {2026}
}
