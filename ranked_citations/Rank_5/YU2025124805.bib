@article{YU2025124805,
 abstract = {Oxide-derived copper (OD-Cu) exhibits remarkable efficiency toward selective electrochemical reduction of CO2 to high-energy-density multicarbon (C2+) products. The big challenge, however, lies in accurately discerning the actual chemical state of copper in OD-Cu that enhances C2+ selectivity, which are largely dictated by the intricating dynamic structural evolution of copper under operating conditions. Herein, we report the construction of a core-shell structured Cu wire model catalyst with a pristine metallic Cu core and an OD-Cu shell using a flame-quenching approach. The cross-section of this model catalyst, merging the surfaces of both pristine Cu and OD-Cu, serves as an ideal platform for probing the structural evolution and discerning the distinct roles of metallic and oxidative Cu in CO2 electroreduction. Through a combination of in situ and ex situ techniques, we unambiguously identify the presence of Cu+ and Cu0 within OD-Cu under electrochemical operating conditions. Furthermore, the cross-examination of theoretical and experimental infrared spectroscopic data unravels that the enhanced C2+ selectivity over the OD-Cu shell primarily stemmed from the tandem coupling of Cu0 with Cu+, which improves the kinetics of C-C coupling. These findings not only offer refreshing perspective on the chemical state of OD-Cu but also provide new guidelines for designing and constructing new high-performance electrocatalysts for CO2 reduction.},
 author = {Hui Yu and Wenru Zhao and Xiangzun Dong and Jiansong Wang and Wei Wang and Liu-Liu Shen and Gui-Rong Zhang and Donghai Mei},
 doi = {https://doi.org/10.1016/j.apcatb.2024.124805},
 issn = {0926-3373},
 journal = {Applied Catalysis B: Environment and Energy},
 keyword = {Electrocatalysis, CO electroreduction, Oxide-derived copper, Operando spectroscopies, DFT calculations},
 pages = {124805},
 title = {Revisiting the origin of enhanced C2+ selectivity on oxide-derived copper toward CO2 electroreduction},
 url = {https://www.sciencedirect.com/science/article/pii/S0926337324011196},
 volume = {363},
 year = {2025}
}
