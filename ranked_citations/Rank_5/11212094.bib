@inproceedings{11212094,
 abstract = {Book-length summarization, especially with Large Language Models (LLMs) is a sore task owing to their context windows and the difficulty of ensuring coherence over long narratives. In this paper, we introduce Overlapping Pairwise Summarization (OPS), a more efficient merging technique that solves these challenges through the usage of overlapping chunk pairs, which helps in achieving better continuity of context. In OPS, the recursive pairwise summarization reduces the errors of coherence and redundancy, capturing summary-level features of the target text that are not possible in the hierarchical and incremental methods. Evaluation with the use of the BooookScore metric indicates that with OPS, more coherent and accurate summaries of books are consistent with the structures established by the author. This confirms that OPS is not only easier in the production of summaries of long-length works but also solves the scalability issue. The code of OPS is publicly available at https://github.com/mastersubhajit/OPS.},
 author = {Bhattacharyya, Sourav and Ghosh, Subhajit and Das, Samrat and Mahanty, Riya and Das, Avik Kumar and Sarkar, Ardhendu},
 booktitle = {2025 IEEE 4th World Conference on Applied Intelligence and Computing (AIC)},
 doi = {10.1109/AIC66080.2025.11212094},
 issn = {},
 keyword = {Measurement;Accuracy;Reviews;Scalability;Merging;Redundancy;Text summarization;Coherence;Production;Natural language processing;document summarization;chunking and merging techniques;token limitation in LLMs;text summarization challenges},
 month = {July},
 number = {},
 pages = {822-828},
 title = {Overlapping Pairwise Chunking and Merging for Long Context Summarization in LLMs},
 volume = {},
 year = {2025}
}
