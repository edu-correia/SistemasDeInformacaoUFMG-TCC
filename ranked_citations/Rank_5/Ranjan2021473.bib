@conference{Ranjan2021473,
 abstract = {We propose MindPalace, a prototype of a versioned database for efficient collaborative data management. MindPalace supports offline collaboration, where users work independently without real-time correspondence. The core of MindPalace is a critical step of offline collaboration: reconciling divergent branches made by simultaneous data manipulation. We formalize the concept of auto-mergeability, a condition under which branches may be reconciled without human intervention, and propose an efficient framework for determining whether two branches are auto-mergeable and identifying particular records for manual reconciliation.  © 2021 Association for Computing Machinery.},
 author = {Ranjan, Nalin and Shang, Zechao and Krishnan, Sanjay and Elmore, Aaron J.},
 doi = {10.1145/3472883.3486980},
 journal = {SoCC 2021 - Proceedings of the 2021 ACM Symposium on Cloud Computing},
 note = {Cited by: 3; All Open Access; Green Open Access},
 pages = {473 - 488},
 publication_stage = {Final},
 source = {Scopus},
 title = {Version reconciliation for collaborative databases},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85119292301?origin=resultslist},
 year = {2021}
}
