@article{Nafar202474,
 abstract = {In this paper, we propose a new approach for the top-down compilation of relaxed Binary Decision Diagrams (BDDs) for Discrete Optimization: Lookahead, Merge and Reduce. The approach is inspired by the bottom-up algorithm for reducing exact BDDs in which equivalent nodes, that is, nodes with the same partial completions, are merged. In our top-down compilation approach, we apply this reduction algorithm for determining which states to be merged by constructing a lookahead layer, merging the lookahead layer nodes according to some heuristic and then deeming nodes having the same feasible completions in the lookahead BDD as approximately equivalent. Moreover, under certain structural properties we prove an upper limit on the size of the reduced layers given the size of the merged lookahead layer. In a set of preliminary computational experiments, we evaluate our approach for the 0/1 Knapsack problem, showing that the approach often achieves much stronger bounds than the traditional top-down compilation scheme. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2024.},
 author = {Nafar, Mohsen and Römer, Michael},
 doi = {10.1007/978-3-031-60599-4_5},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {74 - 82},
 publication_stage = {Final},
 source = {Scopus},
 title = {Lookahead, Merge and Reduce for Compiling Relaxed Decision Diagrams for Optimization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85195853714?origin=resultslist},
 volume = {14743 LNCS},
 year = {2024}
}
