 publication_stage = {Final},
 source = {Scopus},
 title = {Predicting merge conflicts considering social and technical assets},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85179743299?origin=resultslist},
 volume = {29},
 year = {2024}
}
