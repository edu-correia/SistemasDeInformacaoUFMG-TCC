@article{ABUZLF2025111664,
 abstract = {This paper introduces a hybrid adjoint-guided genetic algorithm for nuclear reactor loading pattern optimization, wherein a deterministic mutation based on the adjoint neutron flux is embedded into an otherwise stochastic evolutionary process. In each generation, a fraction of mutation events systematically reorders fuel assemblies according to their adjoint-based importance, thereby driving the search toward physically promising configurations. Benchmarks against standard random mutation demonstrate significantly faster convergence and, in most cases, improved solutions in objectives such as maximizing the effective multiplication factor or minimizing power peaking. However, in scenarios where the globally optimal configuration is characterized by a highly structured (“checkerboard-like”) pattern, the hybrid approach exhibits limited performance gains over purely random mutation, likely due to the strong ordering constraint of the optimal solution. This deterministic-stochastic fusion demonstrates how physical heuristics enhance evolutionary algorithms’ exploration and exploitation phases, offering a powerful and efficient method for in-core fuel management.},
 author = {Hadi Abuzlf and Erez Gilad},
 doi = {https://doi.org/10.1016/j.anucene.2025.111664},
 issn = {0306-4549},
 journal = {Annals of Nuclear Energy},
 keyword = {Adjoint flux, Neutron importance, Loading pattern, Genetic algorithms, Optimization, NuScale SMR},
 pages = {111664},
 title = {Merging adjoint-based determinism with genetic algorithms: A hybrid approach to reactor core loading pattern optimization},
 url = {https://www.sciencedirect.com/science/article/pii/S0306454925004815},
 volume = {224},
 year = {2025}
}
