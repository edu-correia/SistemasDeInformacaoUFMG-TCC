@inproceedings{8702355,
 abstract = {VLSI design teams have vast amounts of legacy RTL code that has been manually optimized to execute a particular task within a given performance, area, and power budget. The main problem is that these fixed architectures cannot be easily re-used in future projects which require different performance, area and power constraints mixes. Thus, in this work we introduce a method to abstract RTL descriptions into synthesizable behavioral descriptions which in turn allow the generation of a new micro-architecture with the newly desired characteristics. In particular, this work, presents a set of optimizations that allow to generate a larger number of micro-architectures compared to the state-of-the-art RTL to C compilers based on two main optimizations: Array merging and loop fusing. Experimental results show that our optimization method is efficient in extending the variety of micro-architectures found and hence increasing the re-usability of these designs.},
 author = {Mahapatra, Anushree and Schafer, Benjamin Carrion},
 booktitle = {2019 IEEE International Symposium on Circuits and Systems (ISCAS)},
 doi = {10.1109/ISCAS.2019.8702355},
 issn = {2158-1525},
 keyword = {Optimization;Merging;Space exploration;Phased arrays;Hardware design languages;IP networks;Tools;RTL to C;High-level synthesis;design space exploration;optimizations},
 month = {May},
 number = {},
 pages = {1-5},
 title = {Optimizing RTL to C Abstraction Methodologies to Improve HLS Design Space Exploration},
 volume = {},
 year = {2019}
}
