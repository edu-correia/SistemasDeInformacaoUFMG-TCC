@conference{Olmedo2024,
 abstract = {In collaborative software development, pull requests are widely used to integrate changes into the latest version of the software. In previous work, we proposed and validated a methodology to optimize the pull request integration process regarding merge conflicts resolution. In this work, we present the design and initial implementation of a prototype pull request integration process optimization tool called IPOptimizer. IPOptimizer takes as input the opened pull requests targeted to a specific branch and returns a sequence of pull requests groups that optimizes the integration process. Preliminary studies have shown that IPOptimizer is capable of optimizing the pull requests integration process considering the integration processes that were carried out in the history of the project. © 2024 IEEE.},
 author = {Olmedo, Agustin and Barbeito, Lucas},
 doi = {10.1109/CLEI64178.2024.10700277},
 journal = {Proceedings - 2024 50th Latin American Computing Conference, CLEI 2024},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {IPOptimizer: A Tool to Optimize the Pull Request Integration Process},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85207823568?origin=resultslist},
 year = {2024}
}
