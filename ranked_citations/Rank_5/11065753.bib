@inproceedings{11065753,
 abstract = {As the demand for parallel computing continues to grow, SIMT (Single Instruction Multiple Thread) architecture has become the mainstream architecture for high-performance graphics processors (GPUs) due to its excellent thread scheduling mechanism and throughput capability. In this paper, we design and implement a shareable multi-channel Cache architecture based on the independently designed SIMT stream multiprocessor to cope with the access conflicts and performance bottlenecks faced by the traditional single-channel Cache in multi-core parallel computing. Supporting four-channel parallel access, the L1 Cache introduces a split-bank structure and a cross-switch network, combined with a configurable replacement algorithm and a dynamic request splitting and merging mechanism, which significantly improves the Cache hit rate and data transfer efficiency. Through functional simulation verification and targeted hit rate test, the results show that the architecture can correctly handle multiple access types under complex mixed requests with a hit rate of 94.83%, which verifies the effectiveness and scalability of its design.},
 author = {Chen, Yulu and Xing, Lidong and Liu, Guanjie and Lin, Wenhao},
 booktitle = {2025 IEEE 7th International Conference on Communications, Information System and Computer Engineering (CISCE)},
 doi = {10.1109/CISCE65916.2025.11065753},
 issn = {2833-2423},
 keyword = {Processor scheduling;Instruction sets;Heuristic algorithms;Scalability;Merging;Graphics processing units;Computer architecture;Parallel processing;Throughput;Information systems;SIMT architecture;GPU;shareable multi-channel Cache},
 month = {May},
 number = {},
 pages = {978-981},
 title = {Design and implementation of SMCC based on SIMT processor},
 volume = {},
 year = {2025}
}
