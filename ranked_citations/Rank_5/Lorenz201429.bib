@conference{Lorenz201429,
 abstract = {NoSQL databases are rapidly becoming the storage of choice for large-scale Web applications. However, for the sake of scalability these applications trade consistency for availability. In this paper, we regain control over this tradeoff by adapting an existing approach, version control (VC), to application state. By using VC, the data model is defined by the application and not by the database. The consistency model is determined at runtime by deciding when to merge and with whom. We describe the design of a VC system named VERCAST that provides fine-grained control over the consistency model used in maintaining application state. Copyright © 2014 ACM.},
 author = {Lorenz, David H. and Rosenan, Boaz},
 doi = {10.1145/2661136.2661151},
 journal = {Onward! 2014 - Proceedings of the 2014 ACM International Symposium on New Ideas, New Paradigms, and Reflections on Programming and Software, Part of SPLASH 2014},
 note = {Cited by: 3},
 pages = {29 - 42},
 publication_stage = {Final},
 source = {Scopus},
 title = {Versionable, branchable, and mergeable application state},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84910665272?origin=resultslist},
 year = {2014}
}
