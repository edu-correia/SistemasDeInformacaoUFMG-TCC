@inproceedings{9364454,
 abstract = {The paper discusses various approaches to merge PMU measurements with RTU measurements for process of state estimation. Due to higher installation and communication cost few PMUs are available in power system grid. It creates need to merge RTU and PMU measurements for the process of state estimation which form Hybrid State Estiamtion. In this paper, process of hybrid state estimation in two stages has been implemented using various approaches. Mathematical formulation of hybrid state estimation for each approach has been presented. Merging of polar and rectangular coordinates of PMU measurements in the process of state estimation has been discussed. The performance of state estimators with all presented approaches has been compared in view of mean square error of voltage magnitude and phase angle. Effectiveness of all the presented approaches has been demonstrated on IEEE 14 and IEEE 118 bus network.},
 author = {Rathod, Nirali and Patel, Hiren and Joshi, Sanjay},
 booktitle = {2020 International Conference on Smart Grids and Energy Systems (SGES)},
 doi = {10.1109/SGES51519.2020.00117},
 issn = {},
 keyword = {Coordinate measuring machines;Merging;Measurement uncertainty;Mean square error methods;Transmission line measurements;Phasor measurement units;State estimation;Weighted Least Square;Hybrid State Estimation;Phasor Measurement Unit},
 month = {Nov},
 number = {},
 pages = {627-632},
 title = {Implementing Two Stage Hybrid State Estimation with Various Approaches},
 volume = {},
 year = {2020}
}
