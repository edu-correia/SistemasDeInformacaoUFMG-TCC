@inproceedings{10334213,
 abstract = {Technology made the world smaller and easier. This is due to revolutionary changes made by research in automation. Automation makes the job run by itself and expects least human interference, which in-turn reduces manual errors. One such tool which has helped in automating processes is Jenkins, mainly used for Continuous Integration and Continuous Deployment. The advantage of Jenkins tool is that it can execute shell script inside it making linux platform suitable for execution. The Jenkins job can fix issues by identifying them like softlink fixing, server montitoring and alerting, also alert every change made to git repository. Additionally, it can trigger a job for every change pushed is merged. Yocto Project is a open embedded environment where, it aids in creating custom Linux based systems regardless of the hardware use.},
 author = {Rakshitha, A. H. and Jayanthi, P N and Manyam, Sushma},
 booktitle = {2023 7th International Conference on Computation System and Information Technology for Sustainable Solutions (CSITSS)},
