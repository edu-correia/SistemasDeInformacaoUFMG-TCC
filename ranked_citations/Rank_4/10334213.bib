 issn = {},
 keyword = {Automation;Linux;Buildings;Interference;Manuals;Packaging;Software;Jenkins;Git and gerrit;linux;shell script;yocto project;bitbake recipe},
 month = {Nov},
 number = {},
 pages = {1-4},
 title = {Software Configuration Using Jenkins and Yocto Project},
 volume = {},
 year = {2023}
