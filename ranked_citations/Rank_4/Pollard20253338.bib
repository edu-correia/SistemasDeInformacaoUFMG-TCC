@conference{Pollard20253338,
 abstract = {Video transformer models require huge amounts of compute resources due to the spatio-temporal scaling of the input. Tackling this, recent methods have proposed to drop or merge tokens for image models, whether randomly or via learned methods. Merging tokens has many benefits: it can be plugged into any vision transformer, does not require model re-training, and it propagates information that would otherwise be dropped through the model. Before now, video token merging has not been evaluated on temporally complex datasets for video understanding. In this work, we explore training-free token merging for video to provide comprehensive experiments and find best practices across four video transformers on three datasets that exhibit coarse and fine-grained action recognition. Our results showcase the benefits of video token merging with a speedup of around 2.5 X while maintaining accuracy (avg. -0.55% for ViViT). Code available at https://github.com/sjpollard/video-how-do-your-tokens-merge.  © 2025 IEEE.},
 author = {Pollard, Sam and Wray, Michael},
 doi = {10.1109/CVPRW67362.2025.00317},
 journal = {IEEE Computer Society Conference on Computer Vision and Pattern Recognition Workshops},
 note = {Cited by: 0; All Open Access; Green Open Access},
 pages = {3338 - 3347},
 publication_stage = {Final},
 source = {Scopus},
 title = {Video, How do Your Tokens Merge?},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105017848536?origin=resultslist},
 year = {2025}
}
