@inproceedings{5277064,
 abstract = {Split and Merge (SM) algorithm is a well recognized algorithm for segmenting homogeneous regions in an image. Though SM algorithm is simple and easy, this algorithm is unable to segment all type objects in an image successfully due to huge variations among the objects in size, shape, color and intensity. Moreover, the SM algorithm is also highly dependent on threshold values used for split and merge stages. Addressing these issues, a new algorithm namely pattern based object segmentation using split and merge (PSM) considering the basic SM algorithm, the region stability, and the patterns for object extraction. The experimental results prove the superior segmentation performance of the PSM algorithm in comparison with the basic SM algorithm, suppressed fuzzy c-means (SFCM), and object based image segmentation using fuzzy clustering (FISG).},
 author = {Karim, Ziaul and Paiker, Nafize Rabbani and Ali, M. Ameer and Sorwar, Golam and Islam, M. M.},
 booktitle = {2009 IEEE International Conference on Fuzzy Systems},
 doi = {10.1109/FUZZY.2009.5277064},
 issn = {1098-7584},
 keyword = {Object segmentation;Image segmentation;Samarium;Clustering algorithms;Video coding;Stability;Pattern matching;Computer science;Pixel;Shape;Image segmentation;split-and-merge;region stability;pattern matching;micro-blocks;video coding},
 month = {Aug},
 number = {},
 pages = {2166-2169},
 title = {Pattern based object segmentation using split and merge},
 volume = {},
 year = {2009}
}
