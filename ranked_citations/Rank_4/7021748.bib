@inproceedings{7021748,
 abstract = {Wireless USB (WUSB) is the USB (Universal Serial Bus) technology merged with WiMedia PHY/MAC. WUSB can be applied to WPAN (Wireless Personal Area Network) applications as well as PAN applications like wired USB. However the current WUSB protocol can't provide seamless multimedia streaming service to moving WUSB devices in home network environment. This problem causes the critical problems in QoS (Quality of Service) provisioning to multimedia streams, since multimedia application is required by mobile devices. Therefore, this paper proposes resource allocation scheme and channel management scheme to avoid the conflict and to support the seamless mobility between adjacent WUSB networks for wireless IPTV (Internet Protocol Television) service.},
 author = {Lee, Seong Ro and Kim, Beom-mu and Jeong, Min A and Kim, Jin-Woo},
 booktitle = {2014 International Conference on IT Convergence and Security (ICITCS)},
 doi = {10.1109/ICITCS.2014.7021748},
 issn = {},
 keyword = {Wireless communication;Bridges;IPTV;Universal Serial Bus;Streaming media;Availability;Multimedia communication},
 month = {Oct},
 number = {},
 pages = {1-4},
 title = {Building UWB Based Smart Home Network for Wireless IPTV},
 volume = {},
 year = {2014}
}
