 keyword = {Large language models;Taxonomy;Supply chains;Pipelines;Failure analysis;Manuals;Software;Regulation;Standards;Software engineering;Software Failure Analysis;News Analysis;Large Language Models;Empirical Software Engineering},
 month = {Oct},
