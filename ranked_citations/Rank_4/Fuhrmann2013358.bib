@conference{Fuhrmann2013358,
 abstract = {This paper demonstrates how to use multiple Kinect<sup>TM</sup> sensors to map a performer’s motion to music. Skeleton data streams from multiple sensors are merged in order to compensate for occlusions of the performer. The skeleton joint positions drive the performance via open sound control data. We discuss how to register the different sensors to each other and how to smoothly merge the resulting data streams and how to map position data in a general framework to the live electronics applied to a chamber music ensemble. © 2013, Steering Committee of the International Conference on New Interfaces for Musical Expression. All rights reserved.},
 author = {Fuhrmann, Anton L. and Kretz, Johannes and Burwik, Peter},
 journal = {Proceedings of the International Conference on New Interfaces for Musical Expression},
 note = {Cited by: 5},
 pages = {358 - 362},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi sensor tracking for live sound transformation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85074594044?origin=resultslist},
 year = {2013}
}
