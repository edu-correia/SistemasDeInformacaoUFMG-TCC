@conference{Aschenbrenner2009745,
 abstract = {The last few years have seen a massive push towards collaborative working methods in the humanities. Many large and small eHumanities Digital Ecosystems (DEs) have sprung into existence. The big challenge ahead is now to see how these subsystems can begin to merge into one larger eHumanities DE while still maintaining their individual characters and strengths. Starting out from a presentation of TextGrid as an exemplary DE in the eHumanities, the article studies two prerequisites for successful interoperability between DEs in the field, namely loosely-coupled services and the visibility of resources. The authors then propose a reference ontology for eHumanities resources, both services and documents alike. ©2009 IEEE.},
 author = {Aschenbrenner, Andreas and Küster, Marc Wilhelm and Ludwig, Christoph and Vitt, Thorsten},
 doi = {10.1109/DEST.2009.5276672},
 journal = {2009 3rd IEEE International Conference on Digital Ecosystems and Technologies, DEST '09},
 note = {Cited by: 2},
 pages = {745 - 750},
 publication_stage = {Final},
 source = {Scopus},
 title = {Open ehumanities digital ecosystems and the role of resource registries},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/71649085759?origin=resultslist},
 year = {2009}
}
