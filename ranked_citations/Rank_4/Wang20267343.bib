@article{Wang20267343,
 abstract = {Merging in dense traffic presents a significant challenge for autonomous vehicles, as the intentions of others are opaque and the passage space is typically limited for maneuvering. Existing methods often fail to compute effective trajectories. This inadequacy is due to the lack of precise consideration of the movements of other vehicles and the overreliance on conservative constraint strategies. To navigate in dense merging scenarios, autonomous vehicles must learn to infer implicit driving behaviors, engage in appropriate interactions with other vehicles, and create merging spaces. This paper focuses on the microscopic process of merging behaviors and proposes an interactive planning framework based on deep reinforcement learning, by incentivizing exploratory behavior within the constraints of vehicle dynamics, our approach effectively utilizes the yielding behavior of surrounding drivers, closely mirroring human driving practices, and a novel safety protector was augmented to ensure the safe execution of actions in autonomous vehicles. Additionally, we present a data-driven environment with randomized vehicles. Comparisons with established strategies demonstrate that our method successfully avoids collisions, improves comfort, and has 11% advantage in merging efficiency.  © 1967-2012 IEEE.},
 author = {Wang, Zhengming and Chen, Nuo and Chen, Yunbu and Huang, Rui and Yu, Xiaoli and Hu, Jia},
 doi = {10.1109/TVT.2025.3629623},
 journal = {IEEE Transactions on Vehicular Technology},
 note = {Cited by: 0},
 number = {5},
 pages = {7343 - 7355},
 publication_stage = {Final},
 source = {Scopus},
 title = {Make Sufficient Probing: A Reinforcement Learning-Based Motion Planning Method for Dense Merging Scenarios},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105021094736?origin=resultslist},
