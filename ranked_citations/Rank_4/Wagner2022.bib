@conference{Wagner2022,
 abstract = {In the development of complex systems, modelbased systems engineering based on SysML enables the fast generation of development artifacts on an abstract level and allows to start an early validation process. However, SysML artifacts often lack depth of detail. Hence, to validate the system architecture, the SysML specification model is mostly supplemented by more concrete interdisciplinary or domain specific simulation models created with other modeling languages and in separate tools. This publication proposes and analyzes systematically workflows for the collaboration between a system architect and a simulation expert based on different development scenarios in an industrial context. These collaboration workflows define process steps and information flows for continuous and complete validation processes. Furthermore, this work presents how these collaboration workflows can be implemented in an industrial context under the use of standards like the SysML Extension for Physical Interaction and Signal Flow Simulation (SysPhS) and the Open Services for Lifecycle Collaboration (OSLC).  © 2022 IEEE.},
 author = {Wagner, Heinrich and Zuccaro, Claudio},
 doi = {10.1109/ISSE54508.2022.10005417},
 journal = {ISSE 2022 - 2022 8th IEEE International Symposium on Systems Engineering, Conference Proceedings},
 note = {Cited by: 7},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Collaboration between System Architect and Simulation Expert},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85146936269?origin=resultslist},
 year = {2022}
}
