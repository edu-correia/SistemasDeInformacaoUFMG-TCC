@article{Spiliopoulos201069,
 abstract = {For the effective alignment of ontologies, the subsumption mappings between the elements of the source and target ontologies play a crucial role, as much as equivalence mappings do. This paper presents the "Classification-Based Learning of Subsumption Relations" (CSR) method for the alignment of ontologies. Given a pair of two ontologies, the objective of CSR is to learn patterns of features that provide evidence for the subsumption relation among concepts, and thus, decide whether a pair of concepts from these ontologies is related via a subsumption relation. This is achieved by means of a classification task, using state of the art supervised machine learning methods. The paper describes thoroughly the method, provides experimental results over an extended version of benchmarking series of both artificially created and real world cases, and discusses the potential of the method. © 2010 Elsevier B.V. All rights reserved.},
 author = {Spiliopoulos, Vassilis and Vouros, George A. and Karkaletsis, Vangelis},
 doi = {10.1016/j.websem.2010.01.001},
 journal = {Journal of Web Semantics},
 note = {Cited by: 44},
 number = {1},
 pages = {69 - 88},
 publication_stage = {Final},
 source = {Scopus},
 title = {On the discovery of subsumption relations for the alignment of ontologies},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/76649088954?origin=resultslist},
 volume = {8},
 year = {2010}
}
