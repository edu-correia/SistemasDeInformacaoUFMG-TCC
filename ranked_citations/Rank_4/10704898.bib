@inproceedings{10704898,
 abstract = {In the realm of small and medium-sized enterprises (SMEs), collaborative application integration is a complex and growing challenge. This challenge is primarily due to the scarcity of highly specialized staff capable of assimilating advanced technologies. Absence of innovation within their production processes, SMEs are at a considerable risk of falling behind in an ever-evolving market landscape, characterized by rapidly shifting consumer demands at a pace previously unseen. The efficacy of collaborative applications lies in their capacity to merge human adaptability with the precision afforded by robotic technology, thereby enhancing workplace safety and securing optimal operational efficiency. Such advancements not only enhance the productivity of production lines beyond traditional manual or static approaches but also catalyze novel avenues for product design, manufacturing, and customization. These developments are pivotal in elevating the global competitive edge of businesses. Our research highlights the substantial benefits, both in terms of improved performance and economic gain, that can be achieved through the examination of a case study as a starting point, optimized through collaborative mobile robotics and simulation software.},
 author = {Polonara, Mirco and Carbonari, Luca and Romagnoli, Alessandra and Biancini, Gianfranco},
 booktitle = {2024 20th IEEE/ASME International Conference on Mechatronic and Embedded Systems and Applications (MESA)},
 doi = {10.1109/MESA61532.2024.10704898},
 issn = {2835-902X},
 keyword = {Productivity;Technological innovation;Service robots;Employment;Collaboration;Watersheds;Transforms;Software;Safety;Vehicle dynamics;collaborative robotics;mobile collaborative robotics;human-centered robotics;computer vision},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Collaborative Mobile Robotics for SMEs: A Case Study},
 volume = {},
 year = {2024}
