@article{10021670,
 abstract = {Game-theoretic motion planners are a potent solution for controlling systems of multiple highly interactive robots. Most existing game-theoretic planners unrealistically assume a priori objective function knowledge is available to all agents. To address this, we propose a fault-tolerant receding horizon game-theoretic motion planner that leverages inter-agent communication with intention hypothesis likelihood. Specifically, robots communicate their objective function which incorporates their intentions. A discrete Bayesian filter is designed to infer the objectives in real-time based on the discrepancy between observed trajectories and predicted solutions to non-cooperative games under available hypotheses. In simulation, we consider three safety-critical autonomous driving scenarios of overtaking, lane-merging and intersection crossing, to demonstrate our planner's ability to capitalize on alternative intention hypotheses to generate safe trajectories in the presence of faulty transmissions in the communication network.},
 author = {Chahine, Makram and Firoozi, Roya and Xiao, Wei and Schwager, Mac and Rus, Daniela},
 doi = {10.1109/LRA.2023.3238131},
 issn = {2377-3766},
 journal = {IEEE Robotics and Automation Letters},
 keyword = {Games;Trajectory;Planning;Costs;Cost function;Communication networks;Vehicle dynamics;Path planning for multiple mobile robots or agents;planning under uncertainty;collision avoidance},
 month = {March},
 number = {3},
 pages = {1223-1230},
 title = {Intention Communication and Hypothesis Likelihood in Game-Theoretic Motion Planning},
 volume = {8},
 year = {2023}
}
