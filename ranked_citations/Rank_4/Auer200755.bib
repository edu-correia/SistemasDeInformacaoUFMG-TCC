@article{Auer200755,
 abstract = {We present an approach to support the evolution of online, distributed, reusable, and extendable ontologies based on the RDF data model. The approach works on the basis of atomic changes, basically additions or deletions of statements to or from an RDF graph. Such atomic changes are aggregated to compound changes, resulting in a hierarchy of changes, thus facilitating the human reviewing process on various levels of detail. These derived compound changes may be annotated with meta-information and classified as ontology evolution patterns. The introduced ontology evolution patterns in conjunction with appropriate data migration algorithms enable the automatic migration of instance data in distributed environments. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Auer, Sören and Herre, Heinrich},
 doi = {10.1007/978-3-540-70881-0_8},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 41},
 pages = {55 - 69},
 publication_stage = {Final},
 source = {Scopus},
 title = {A versioning and evolution framework for RDF knowledge bases},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/38049107894?origin=resultslist},
 volume = {4378 LNCS},
 year = {2007}
}
