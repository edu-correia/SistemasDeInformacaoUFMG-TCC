@article{Wang200945,
 abstract = {A genetic algorithm for solving min - ε polygonal approximation and min - # polygonal approximation is proposed in this paper. It combines traditional split-and-merge techniques with a novel chromosome-repairing scheme to cope with constraints. Due to this combination of techniques we call our new method SMCR. In this new scheme an infeasible solution cannot only be easily transformed into a feasible one, but also be optimized. The experimental results show that the proposed SMCR has higher performance than the other GA-based methods and some non-GA-based methods. © 2008 Elsevier Inc. All rights reserved.},
 author = {Wang, Bin and Shu, Huazhong and Luo, Limin},
 doi = {10.1016/j.jvcir.2008.10.001},
 journal = {Journal of Visual Communication and Image Representation},
 note = {Cited by: 16},
 number = {1},
 pages = {45 - 56},
 publication_stage = {Final},
 source = {Scopus},
 title = {A genetic algorithm with chromosome-repairing for min - # and min - ε polygonal approximation of digital curves},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/57749096868?origin=resultslist},
 volume = {20},
 year = {2009}
}
