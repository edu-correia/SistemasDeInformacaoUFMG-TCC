@inproceedings{10796156,
 abstract = {The purpose of this project is to merge the two worlds of fashion and technology to propel the industry of fashion-forward as a futuristic entity. CycberShell aims to seamlessly integrate aesthetic appeal with technical innovation, enhancing the quality of life for users. With the current existence of wearables, it is not strange that the technical school of thought would head towards this line of wearable applications. Wearing a piece of the future along with sustainability in mind will lead to a new era of self-expression and modern wear. The presented product offers a range of customization options and integrated technology, blending application-based experiences with embedded hardware to provide real-time feedback and adjustments. An application-based interface that utilizes code and mini-computing translates the implemented customization options into tangible changes, ensuring a seamless user experience. After all, investing in a single piece of customizable clothing can significantly reduce textile waste.},
 author = {Al Qallaf, Sayed Abdullah and Eldine, Rola Nour and Meer, Jasim Al and Tayyar, Bader Al and Esmaeili, Seyed and Alateyah, Amal},
 booktitle = {2024 4th International Conference on Electrical, Computer, Communications and Mechatronics Engineering (ICECCME)},
 doi = {10.1109/ICECCME62383.2024.10796156},
 issn = {},
 keyword = {Industries;Technological innovation;Mechatronics;Propulsion;User experience;Real-time systems;Hardware;Wearable devices;Sustainable development;Textiles;wearable technology;smart clothing;futuristic fashion},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {CyberShell: Meeting the Need for Both Fashion and Smart Functionality Using Electronic Wearables},
 volume = {},
 year = {2024}
}
