@inproceedings{11284258,
 abstract = {Modern schema-and-data-tracking development environments call for enhanced support by DBVCS due to high collaboration requirements. Traditional approaches involve incremental manual schema updates, migration script creation, and use of some simple versioning tool, made difficult by problems like schema drift, data inconsistency, and poor change tracking. Errors, scalability problems, and lack of coherency with application logic and database structures hamper these approaches. Henceforth, the study called for enhanced support from DBVCS, aimed at merging support with historical tracking in the management of and promotion for database consistency. DBVCS systems, meanwhile, have developed a new set of environments filling the gap between traditional toolkits, declarative configurations, topological sorting, and graph dependency resolution. A case example shows that, as the systems flow from development through testing to production, they do not fall out of sync. This allows continuity in integration and deployment pipelines. The extensible methodology therefore goes a long way in sealing deals for the transition from poor manual management practices prone to errors to scaled automated methods placing emphasis on collaboration and minimizing deployment risks so as to lay the ground for database-centric projects. Insights on scaling, efficiency, and database governance show the clearest reasons DBVCS should be intertwined with modern software development methods to meet the telltale complexities modern ecosystems provide.},
 author = {Sankhe, Monali and Mangla, Monika and Shah, Preksha and Doshi, Prince and Shah, Jeniel and Vyas, Deep},
 booktitle = {2025 9th International Conference on Computing, Communication, Control and Automation (ICCCBEA)},
 doi = {10.1109/ICCUBEA65967.2025.11284258},
 issn = {2771-1358},
 keyword = {Target tracking;Databases;Merging;Manuals;Control systems;Teamwork;Synchronization;Testing;Sorting;Software development management;Database Version Control System (DBVCS);Database schema changes;Branching and merging},
 month = {Aug},
 number = {},
 pages = {1-7},
 title = {A Unified Distributed Version Control System for SQL and Graph Databases},
 volume = {},
 year = {2025}
}
