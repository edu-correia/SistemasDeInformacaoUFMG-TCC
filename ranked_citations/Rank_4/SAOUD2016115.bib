@article{SAOUD2016115,
 abstract = {In this paper we present a new personalized approach, which integrates a social profile into a distributed search system. Most previous studies on distributed information retrieval are based on textual information, and rarely consider any social information. Based on this observation, we propose an approach which exploits the social profile and the different relations between social entities. We believe that this method can: (i) enhance a query expansion, (ii) personalize and improve both the source selection and the result merging process in distributed information retrieval systems.},
 author = {Zakaria Saoud and Samir Kechid},
 doi = {https://doi.org/10.1016/j.ins.2015.12.012},
 issn = {0020-0255},
 journal = {Information Sciences},
 keyword = {Information retrieval, Social profile, Folksonomy, Source selection process, Merging process},
 pages = {115-128},
 title = {Integrating social profile to improve the source selection and the result merging process in distributed information retrieval},
 url = {https://www.sciencedirect.com/science/article/pii/S0020025515009019},
 volume = {336},
 year = {2016}
}
