@article{Tegeler20213,
 abstract = {We present an introduction to the usage of Rig, our Cinco product for the graphical modeling of CI/CD workflows. While CI/CD has become a de facto standard in modern software engineering (e.g. DevOps) and the benefits of its practice are without a doubt, developers are still facing inconvenient solutions. We will briefly outline the basic concept of CI/CD and discuss the challenges involved in maintaining such workflows with current implementations before we explain and illustrate the advantages of our model-driven approach step by step along on the treatment of a typical web application. © 2021, Springer Nature Switzerland AG.},
 author = {Tegeler, Tim and Teumert, Sebastian and Schürmann, Jonas and Bainczyk, Alexander and Busch, Daniel and Steffen, Bernhard},
 doi = {10.1007/978-3-030-89159-6_1},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 12},
 pages = {3 - 17},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Introduction to Graphical Modeling of CI/CD Workflows with Rig},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85118135758?origin=resultslist},
 volume = {13036 LNCS},
 year = {2021}
}
