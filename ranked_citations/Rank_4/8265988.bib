 issn = {},
 keyword = {Substations;Current transformers;Power transformer insulation;Meters;Circuit faults;Merging;Oil insulation;Digital electrical energy metering;Electronic transformer;Merging unit;Digital watt-hour meter;IEC 61850},
 month = {Oct},
