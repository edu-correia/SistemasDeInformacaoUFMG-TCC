@conference{Väananen-Vainio-Mattila20111327,
 abstract = {The Web contains a vast amount of services supporting users in various facets of life. In mashup or composite Web services, elements from various services are combined to create a service which suits users' needs. Our goal was to explore what kind of composite services users would need. We conducted semi-structured interviews with nine Web service users to investigate their experiences of service composition and expectations to future services. We also asked the participants to sketch their ideal composite service UI for both PC and mobile device. Our results indicate that service users do not yet have much experience of mashups but there is a need to merge functionality and data from different services to achieve the customized, integrated Web service. This work contributes to the development of future Web services and mashup tools.},
 author = {Väananen-Vainio-Mattila, Kaisa and Wäljas, Minna},
 doi = {10.1145/1979742.1979769},
 journal = {Conference on Human Factors in Computing Systems - Proceedings},
 note = {Cited by: 9},
 pages = {1327 - 1332},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards user-centered mashups: Exploring user needs for composite web services},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/79957952969?origin=resultslist},
 year = {2011}
}
