@conference{Chen202296,
 abstract = {In the earthquake precursor network observation system based on user-defined operation log for database synchronization, there were multiple preprocessed and re-collection of data in the station and regional center database, and there were multiple update and deletion records of the same preprocessing data and collected data in the operation log table. The logging of multiple operations for the same data will affect the efficiency of precursor data exchange. Aiming at this problem, we in the latest earthquake precursory network data exchange scheme, proposed an optimization algorithm of a custom action log, merge the custom operation log, by calculation in the operating log table, only keep the data synchronization needs the data of the last operation records, thus greatly reduce the network data flow, improve the efficiency of database synchronization. © 2022 WCSE. All Rights Reserved.},
 author = {Chen, Wang and Yuntian, Teng and Qingjie, Liu},
 doi = {10.18178/wcse.2022.06.015},
 journal = {2022 12th International Workshop on Computer Science and Engineering, WCSE 2022},
 note = {Cited by: 0},
 pages = {96 - 102},
 publication_stage = {Final},
 source = {Scopus},
 title = {Application of a Log Optimization Algorithm in the Earthquake Precursor System Data Synchronization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85136796172?origin=resultslist},
 year = {2022}
}
