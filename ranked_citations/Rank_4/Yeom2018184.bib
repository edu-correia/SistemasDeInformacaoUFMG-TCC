@article{Yeom2018184,
 abstract = {The paper provides methodologies for microscopic simulation modelling of freeway work zones with lane closures in the proximity of interchanges. In addition, the research presents simulation results using calibrated modelling parameters to determine the capacity available for mainline flow under various operating conditions. The results will help researchers or practitioners with designing and studying freeway work zone sites under various lane configurations using better estimates of delays and queue sizes in the proximity of interchanges. Additionally, a 2 to 1 on-ramp merge condition was explored to predict the merge ratios under both demand and service flow conditions. The paper illustrates how ramp demand affects the share of segment capacity available to mainline traffic to reveal strategies for controlling this demand (via ramp metering for example) in order to maintain a prescribed freeway capacity through the work zone. The overall study result indicates the degree to which the presence of a work zone with lane closures decreases the proportion of mainline flow and shows the degree to which differences in work zone lane configurations affect merge and weave scenarios. © 2009-2012 IEEE.},
 author = {Yeom, Chunho and Rasdorf, William and Rouphail, Nagui and Schroeder, Bastian},
 doi = {10.1109/MITS.2018.2842027},
 journal = {IEEE Intelligent Transportation Systems Magazine},
 note = {Cited by: 8},
 number = {3},
 pages = {184 - 195},
 publication_stage = {Final},
 source = {Scopus},
 title = {Simulation of Work Zones with Lane Closures in Proximity of Freeway Interchanges},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85048458236?origin=resultslist},
 volume = {10},
 year = {2018}
}
