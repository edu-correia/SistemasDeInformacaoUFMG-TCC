@conference{Tolvanen2025698,
 abstract = {MetaEdit+ is a mature language workbench that supports merge-free collaborative modeling with user-defined domain-specific modeling languages. We describe how MetaEdit+ supports the Model Management Challenge 2025 (https://doi.org/10.5281/zenodo.15285132). The modeling solution presented enables collaborative simultaneous work directly in high-level models, minimizes the effort of modeling and integration, provides fast feedback on changes, keeps artefacts consistent, traceable and up-to-date, and provides hassle-free versioning. © 2025 IEEE.},
 author = {Tolvanen, Juha-Pekka and Kelly, Steven},
 doi = {10.1109/MODELS-C68889.2025.00114},
 journal = {Proceedings - 2025 ACM/IEEE 28th International Conference on Model Driven Engineering Languages and Systems Companion, MODELS-C 2025},
 note = {Cited by: 0},
 pages = {698 - 706},
 publication_stage = {Final},
 source = {Scopus},
 title = {Domain-Specific Modeling Solution in MetaEdit+ for the Model Management Challenge},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105030481462?origin=resultslist},
 year = {2025}
