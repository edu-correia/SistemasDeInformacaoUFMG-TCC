@inproceedings{6917379,
 abstract = {This paper introduces various aspects of the Chinese Intelligent Chat Robot Xiao Hui-hui in detail: the internal structure, the existing foundation, the final effect, and the problems encountered in the construction process and their solution. In the field of the Chinese Intelligent Chat Robot, the lack of a perfect corpus and Chinese segmentation system are the most difficult problems. As a result, we discussed and proposed solutions of the problems regarding one answer to many questions and merged similar questions in this paper to address the lack of corpus and to provide a means of handling synonymous sentences.},
