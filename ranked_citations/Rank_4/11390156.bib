@inproceedings{11390156,
 abstract = {Traditional reactive strategies to application security are becoming less sufficient as organisations speed up software delivery using Agile and DevOps practices. The paper offers a comparative analysis of proactive and reactive security approaches in DevSecOps pipelines and focuses on the advantages of the so-called shift-left integration. By employing the real-world tools, including Veracode, Checkmarx, SonarLint, and GitGuardian, we developed two parallel CI/CD environments to compare the rate of vulnerability detection, Mean Time to Remediation (MTTR), developer productivity, and the impact in terms of how much money it would cost. The proactive team, assisted by IDE-integrated static analysis, software composition analysis (SCA), and secret detection, was always better than the reactive team, which worked with post-build scans and dynamic testing. It was found that proactive security took the total MTTR down by more than 60%, prevented more than 70% of vulnerabilities before the merge, and saved on remediation costs. The present study offers a blueprint of security integration throughout the different phases of SDLC and an easy-to-follow guideline on tool adoption and cultural change. Our observations show that proactive security is possible and vital to secure and scalable software delivery in the contemporary DevSecOps world.},
 author = {Bhardwaj, Avdhesh Kumar and Anugula, Praveen and Ranjan, Piyush},
 booktitle = {2025 1st IEEE Uttar Pradesh Section Women in Engineering International Conference on Electrical Electronics and Computer Engineering (UPWIECON)},
 doi = {10.1109/UPWIECON67212.2025.11390156},
 issn = {},
 keyword = {Productivity;Costs;Pipelines;Static analysis;Predictive models;Software;Application security;Security;Anomaly detection;Testing;DevSecOps;Proactive Security;Static Application Security Testing (SAST);Software Composition Analysis (SCA);Shift-Left Security;CIICD;IDE-based Analysis;MTTR;Secure Software Development;Application Vulnerability Management},
 month = {Oct},
 number = {},
 pages = {224-228},
 title = {Proactive vs Reactive Application Security in DevSecOps: A Comparative Evaluation of Shift-Left Security Tools and Strategies},
 volume = {},
