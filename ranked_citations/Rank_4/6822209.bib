@inproceedings{6822209,
 abstract = {In oil and gas exploration, geologists will need to visualize targeted areas at a large scale to understand the possibilities of a particular seabed area containing hydrocarbon reservoir. Currently, seismic surveys are done to know such possibilities. There are various techniques that has been used to accurately map seabed condition. Using a non-costly method for geologist to generate 3D visualization of targeted area, one has to know a few methods using various softwares. Oil and gas companies have software either built in-house or off-the-shelf products. Such softwares are costly. The purpose of this paper is to explain RockTitan, an open source software, which we merged by using other open-source softwares. This will enable geologist to easily produce 3D visualization of seabed. By being able to visualize how the seabed in an area looks like, they may be able to make more informed decisions, whether to conduct an elaborate activity such as a seismic survey. A sample case scenario was done to show how this software works. Preliminary testing was done with users and it was mentioned that this software is user friendly and they are able to obtain the desired output easily.},
 author = {Goh, Kim Nee and Chung, Wei Kiat},
 booktitle = {2014 11th International Conference on Information Technology: New Generations},
 doi = {10.1109/ITNG.2014.122},
 issn = {},
 keyword = {Three-dimensional displays;Geology;Data visualization;Visualization;Solid modeling;Open source software;3D modelling; 3d visualization; oil and gas; seismic survey; hydrocarbon reservoir},
 month = {April},
 number = {},
 pages = {266-270},
 title = {RockTitan: A 3D Modelling Geological Software},
 volume = {},
 year = {2014}
}
