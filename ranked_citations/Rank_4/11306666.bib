@inproceedings{11306666,
 abstract = {The specialization of Large Language Models (LLMs) for complex domains like structured data understanding is often confined to high-resource languages, creating a significant barrier to their global adoption. Conventional cross-lingual transfer methods, such as full-scale or even light fine-tuning, are costly, data-intensive, and can disrupt a model’s existing expertise. This paper challenges this paradigm by proposing a novel framework built on the decoupling of task ability and language proficiency. We introduce a training-free approach for cross-lingual adaptation based on modular composition, which directly merges the weights of a specialized task-expert model, TableLlama, with a pre-trained, general-purpose low-rank adaptation (LoRA) adapter for a target language. We evaluate eight table-understanding tasks on datasets translated into Chinese, Japanese, and French. The experiments result in two key findings. For typologically distant languages like Chinese and Japanese, the compositional method consistently achieves performance comparable or superior to a strong baseline fine-tuned on 100 labeled examples, whereas this unadapted model’s performance degrades severely. In addition, the results reveal that the efficacy of the approach correlates with the linguistic distance between languages. The method without any training or using target-language data demonstrates that modular LoRA composition is a robust and efficient paradigm for specialized AI models to bridge linguistic barriers.},
 author = {Rao, Ziqian and Wang, Jun},
 booktitle = {2025 15th International Conference on Information Science and Technology (ICIST)},
 doi = {10.1109/ICIST66592.2025.11306666},
 issn = {2573-3311},
 keyword = {Training;Adaptation models;Information science;Translation;Costs;Large language models;Merging;Collaboration;Data models;Multilingual;LoRA;model merging;cross-lingual transfer;table understanding},
 month = {Dec},
 number = {},
 pages = {202-209},
 title = {Decoupling Tasking and Language: Modular Low-Rank Adaptation for Effective and Efficient Cross-Lingual Table Understanding},
 volume = {},
 year = {2025}
}
