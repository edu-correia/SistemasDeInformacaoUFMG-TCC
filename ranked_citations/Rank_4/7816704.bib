@inproceedings{7816704,
 abstract = {This paper analyzed the shortcomings that existed in the Memcached Caching Strategy. An improved scheme DCSAE (Data Cached Strategy on Asynchronously Updating for Eventual Consistency) which used asynchronous update based on the eventual consistency theory was proposed. DCSAE generated virtual nodes and assigned them to real nodes according to the weight of each node. The weight was calculated in accordance with the hardware performance of each node. DCSAE adopted the Cache Partitioning, Replication and Multi-Version Strategy. The multi-version data was updated asynchronously by Vector Clock Mechanism, and finally merged by the read access. Furthermore, to improved the dynamic scalability and cache utilization in Memcached[1], DCSAE achieved node dynamic joining and leaving. The experimental part of this paper used the test data set in Memcached Java Client whalin_2.5.0_bin[2], and set up a Memcached cluster as the experimental environment. The contrast experiments were built to compare DCSAE with the old Memcached caching strategy on performances.},
 author = {Cai, Ting-Ting and Qin, Xin and Li, Zhi-Huai},
 booktitle = {2016 International Conference on Information System and Artificial Intelligence (ISAI)},
 doi = {10.1109/ISAI.2016.0051},
 issn = {},
 keyword = {Servers;Clocks;Distributed databases;Topology;Writing;Hardware;Delay effects;eventual consistency;cache strategy;Partitioning;Multi-version;Memcached},
 month = {June},
 number = {},
 pages = {203-207},
 title = {The Improvement of a Data Cached Strategy Based on Eventual Consistency Theory},
 volume = {},
 year = {2016}
}
