@article{Liberatore2015,
 abstract = {A common assumption in belief revision is that the reliability of the information sources is either given, derived from temporal information, or the same for all. This article does not describe a new semantics for integration but studies the problem of obtaining the reliability of the sources given the result of a previous merging. As an example, corrections performed manually on the result of merging some databases may indicate that the relative reliability of their sources is different from what was previously assumed, helping subsequent data mergings. Copyright © 2015 ACM.},
 author = {Liberatore, Paolo},
 doi = {10.1145/2818645},
 journal = {ACM Transactions on Computational Logic},
 note = {Cited by: 3; All Open Access; Green Open Access},
 number = {2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Belief merging by examples},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84954310978?origin=resultslist},
 volume = {17},
 year = {2015}
}
