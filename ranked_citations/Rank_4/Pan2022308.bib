@conference{Pan2022308,
 abstract = {An information-rich digital model for pipe systems is valuable for facility management and maintenance. Pipe systems in existing facilities can be captured for example using laser scanning equipment or cameras, providing point clouds or images. While these two data sources can provide diverse information, it is not straightforward to register one with the other. In this paper, we propose a novel approach to automatically create and enrich geometric models for pipe systems by co-registering laser-scanned point clouds and photos. Data from two separate sources are collected to test our method. Subsequently, a photogrammetric point cloud is reconstructed to establish a mapping between all 2D images and the laser-scanned 3D point cloud. State-of-the-art computer vision methods are applied to enrich the raw 2D and 3D datasets. Finally, we use the mapping to merge the processed datasets into one combined, information-rich model. © European Council on Computing in Construction (EC3).},
 author = {Pan, Yuandong and Noichl, Florian and Braun, Alexander and Borrmann, André and Brilakis, Ioannis},
 doi = {10.35490/EC3.2022.181},
 journal = {Proceedings of the European Conference on Computing in Construction},
 note = {Cited by: 4; All Open Access; Bronze Open Access; Green Open Access},
 pages = {308 - 315},
 publication_stage = {Final},
 source = {Scopus},
 title = {AUTOMATIC CREATION AND ENRICHMENT OF 3D MODELS FOR PIPE SYSTEMS BY CO-REGISTRATION OF LASER-SCANNED POINT CLOUDS AND PHOTOS},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85177202154?origin=resultslist},
 year = {2022}
}
