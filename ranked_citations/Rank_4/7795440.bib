@inproceedings{7795440,
 abstract = {Hybrid communication systems exploit channel diversity to improve network performance. One such example is hybrid Free Space Optical (FSO)/Radio Frequency (RF) systems. These networks aim to merge the high capacity of FSO links with the high availability of RF links to form resilient high-bandwidth communications. When used for wireless communications, the main challenge is the dynamic response to variations in the atmospheric channel in adverse weather conditions. In this paper we simulate adaptive hard-switched transmission algorithms on a practical prototype hybrid system. FSO channel scenarios are formed based on climate data, and are emulated on the prototype system to compare the performance of the hybrid system to each solo carrier respectively.},
 author = {Nock, Kristen and Font, Carlos and Rupar, Michael},
 booktitle = {MILCOM 2016 - 2016 IEEE Military Communications Conference},
 doi = {10.1109/MILCOM.2016.7795440},
 issn = {2155-7586},
 keyword = {Radio frequency;Optical attenuators;Optical switches;Optical fiber communication;Monitoring;Attenuation;Communication systems;communication system control;hard-switching;hybrid FSO/RF channels;transmission algorithms},
 month = {Nov},
 number = {},
 pages = {877-881},
 title = {Adaptive transmission algorithms for a hard-switched FSO/RF link},
 volume = {},
 year = {2016}
}
