@inproceedings{6890540,
 abstract = {Mixed resolution framework has been applied in stereoscopic video coding system to reduce data-size and bit rate. Recently, Super Resolution (SR) problem in mixed resolution format has drawn a lot of attention in order to provide the users with high quality 3D visual experience. In this paper we present a novel SR scheme, which not only borrows the high frequency content from neighboring full resolution frame, but also makes use of all high resolution (HR) warped images to enhance low resolution (LR) view image. The correlation between the target LR view and auxiliary HR views determines the weight of these high frequency components, which will be merged into LR frame to construct the output HR image. The DCT is used for frequency decomposition and frequency integration. Experimental results show that the proposed method achieves higher performance in both subjective and objective evaluations.},
 author = {Yuan Li and Zhizhong Fu and Xuguang Zhao and Xiaofeng Li and Pengfei Liu},
 booktitle = {2014 IEEE International Conference on Multimedia and Expo Workshops (ICMEW)},
 doi = {10.1109/ICMEW.2014.6890540},
 issn = {1945-7871},
 keyword = {Correlation;PSNR;Three-dimensional displays;Discrete cosine transforms;Spatial resolution;Cameras;Mixed resolution;super resolution;3DTV;correlation;DCT},
 month = {July},
 number = {},
 pages = {1-6},
 title = {Super resolution for multiview mixed resolution images in transform-domain},
 volume = {},
 year = {2014}
}
