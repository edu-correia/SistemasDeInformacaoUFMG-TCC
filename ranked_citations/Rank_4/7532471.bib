@inproceedings{7532471,
 abstract = {Complex software appliances can be deployed on hardware with limited available computational resources. This computational boundary puts an additional constraint on software applications. This can be an issue for real-time applications with a fixed time constraint such as low delay video encoding. In the context of High Efficiency Video Coding (HEVC), a limited number of publications have focused on controlling the complexity of an HEVC video encoder. In this paper, a technique is proposed to control complexity by deciding between 2N×2N merge mode and full encoding, at different Coding Unit (CU) depths. The technique is demonstrated in two encoders. The results demonstrate fast convergence to a given complexity threshold, and a limited loss in rate-distortion performance (on average 2.84% Bjontegaard delta rate for 40% complexity reduction).},
 author = {Vermeir, Thijs and Slowack, Jürgen and Van Wallendael, Glenn and Lambert, Peter and Van de Walle, Rik},
 booktitle = {2016 IEEE International Conference on Image Processing (ICIP)},
 doi = {10.1109/ICIP.2016.7532471},
 issn = {2381-8549},
 keyword = {Complexity theory;Encoding;Copper;Streaming media;Real-time systems;Software;Indexes;Complexity Constrained;Real-time encoding;HEVC},
 month = {Sep.},
 number = {},
 pages = {819-823},
 title = {Real-time complexity constrained encoding},
 volume = {},
 year = {2016}
}
