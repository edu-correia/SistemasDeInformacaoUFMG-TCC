@inproceedings{11504032,
 abstract = {Automated skin disease diagnosis faces significant challenges due to limited datasets and insufficient model comparisons across diverse dermatological conditions. We address these limitations by creating a comprehensive dataset of 78,000 images spanning 54 skin disease classes through merging eight existing datasets. Our systematic evaluation compares the performance of seven CNN architectures (InceptionV3, DenseNet, VGG16, Xception, AlexNet, ResNet50, EfficientNetB0) against three transformer models (ViT, DeiT, Swin Transformer) for multi-class skin disease classification. Experimental results demonstrate that transformer-based models significantly outperform traditional CNNs, with DeiT achieving the highest test accuracy of 77.19%, compared to InceptionV3’s best CNN performance of 71.88%. The superior performance of transformers can be attributed to their ability to capture global spatial relationships and long-range dependencies critical for distinguishing visually similar skin conditions. However, our analysis of data resampling techniques reveals substantial overfitting issues when applying synthetic augmentation methods.},
 author = {Shanto, Rejaul Islam and Hasan, Masum and Saad, Tahmid Karim and Shahriar Hussain, Md.},
 booktitle = {2025 IEEE International Conference on Biomedical Engineering, Computer and Information Technology for Health (BECITHCON)},
 doi = {10.1109/BECITHCON69222.2025.11504032},
 issn = {},
 keyword = {Modeling;Diseases;Skin;Convolutional neural networks;Transformers;Printing;Accuracy;Training;Computers;Computer architecture;Skin disease classification;Medical image analysis;DeiT;Multi-dataset integration},
 month = {Nov},
 number = {},
 pages = {383-387},
 title = {Large-Scale Skin Disease Classification Using Merged Datasets: Performance Analysis of CNN and Transformer-Based Deep Learning Models},
