@inproceedings{11393170,
 abstract = {Within the framework of worldwide sustainable energy transformation, this research develops an integrated prediction architecture that merges Swin Transformer components with advanced neural learning techniques to resolve inadequate spatial-temporal feature integration in conventional wind energy forecasting approaches within challenging oceanic settings. A Swin-CNN-LSTM computational framework is established to systematically tackle these obstacles: Initially, one-dimensional convolutional networks extract regional spatial patterns from heterogeneous data sources (including wind velocity and oceanic thermal measurements). Following this, Swin Transformer modules incorporating partitioned multi-head attention mechanisms are deployed to strengthen multi-resolution spatial relationship modeling, whereas recurrent memory networks capture sequential patterns in energy output data. This innovative architecture uniquely integrates state-of-the-art attention-based processing with diverse neural architectures for marine wind energy prediction, delivering substantial enhancements in cross-scale feature integration and adaptive parameter weighting to better represent meteorological-environmental interactions in complex maritime conditions. Validation outcomes confirm this methodology surpasses established techniques through marked reduction of cumulative prediction errors across 72-hour forecasting intervals, establishing an innovative technical framework for energy prediction and management decisions in offshore wind installations.},
 author = {Yue, Wenchao and Yu, Shouquan and Gan, Weizhu and Wu, Xing},
 booktitle = {2025 7th International Conference on Electrical Engineering and Control Technologies (CEECT)},
 doi = {10.1109/CEECT67814.2025.11393170},
 issn = {},
 keyword = {Adaptation models;Computational modeling;Wind speed;Computer architecture;Wind power generation;Transformers;Convolutional neural networks;Forecasting;Wind forecasting;Long short term memory;Offshore Wind Power;LSTM;CNN;Self-Attention Mechanism},
 month = {Dec},
 number = {},
 pages = {66-70},
 title = {A Short-Term Power Output Prediction Method for Offshore Wind Power Based on Swin-CNN-LSTM},
 volume = {},
 year = {2025}
}
