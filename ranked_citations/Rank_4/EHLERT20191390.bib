 author = {Brenda Ehlert and Anthony Zeimet},
 doi = {https://doi.org/10.1016/j.ajic.2019.04.002},
 issn = {0196-6553},
 journal = {American Journal of Infection Control},
 keyword = {Team, Merge, Standard, Formation, Policy},
 number = {11},
 pages = {1390-1392},
 title = {Merging health care systems: An example of utilizing quality principles in infection prevention standardization},
 url = {https://www.sciencedirect.com/science/article/pii/S0196655319302305},
 volume = {47},
 year = {2019}
}
