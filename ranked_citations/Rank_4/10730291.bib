@inproceedings{10730291,
 abstract = {The escalating prevalence of attacks on Internet of Things (IoT) devices poses a substantial challenge to ensuring the security of interconnected systems. Combining dataset from multi-datasets that can significantly enhance the performance of a machine learning model for threat detection, especially when one dataset has limited samples. Normalized and aligned features to ensure compatibility and coherence. Cleansed the merged dataset to eliminate redundancies, inconsistencies, and noise, ensuring the integrity and reliability of the analysis. We present a Python-based data combination method that involves dimensionality reduction before merging datasets, especially advantageous for datasets with numerous unique features. Furthermore, our framework serves as a data preprocessing tool by filling in missing entries during dataset integration.},
 author = {Chai, Guo Qiang and Aun, Yichiet and Png, Wen Hao and Goh, Hock Guan},
 booktitle = {2024 5th International Conference on Artificial Intelligence and Data Sciences (AiDAS)},
 doi = {10.1109/AiDAS63860.2024.10730291},
 issn = {},
 keyword = {Performance evaluation;Redundancy;Noise;Merging;Interconnected systems;Network security;Threat assessment;Filling;Internet of Things;Reliability;Cyber security;Threat detection;Transformer;datasets combination;feature training;performance},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Enhancing Threat Detection in Network Security Based on Augmented Feature},
 volume = {},
 year = {2024}
}
