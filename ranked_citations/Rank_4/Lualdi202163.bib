@conference{Lualdi202163,
 abstract = {We report on the development of ASLNet, a wordnet for American Sign Language (ASL). ASLNet V1.0 is currently under construction by mapping easy-to-translate ASL lexical nouns to Princeton WordNet synsets. We describe our data model and mapping approach, which can be extended to any sign language. Analysis of the 390 synsets processed to date indicates the success of our procedure yet also highlights the need to supplement our mapping with the “merge” method. We outline our plans for upcoming work to remedy this, which include use of ASL free-association data. © GWC 2021. All rights reserved.},
 author = {Lualdi, Colin P. and Wright, Elaine and Hudson, Jack and Caselli, Naomi K. and Fellbaum, Christiane},
 journal = {GWC 2021 - Proceedings of the 11th Global Wordnet Conference},
 note = {Cited by: 6},
 pages = {63 - 72},
 publication_stage = {Final},
 source = {Scopus},
 title = {Implementing ASLNet V1.0: Progress and plans},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85119983593?origin=resultslist},
 year = {2021}
}
