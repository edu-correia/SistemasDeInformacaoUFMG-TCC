@article{11515120,
 abstract = {In complex highway on-ramp scenarios, the intense interaction between platoons makes it difficult for traditional decoupled decision-making and planning logic to resolve conflicts within mixed platoons. This paper proposes a Bi-level Coordinated Control Framework that achieves a deep coupling of macro-level game-theoretic decisions and micro-level trajectory planning. The upper layer employs a greedy multi-round Stackelberg game to determine the optimal merging sequence by balancing vehicle costs and benefits. The lower layer utilizes a game-guided Multi-Agent Proximal Policy Optimization algorithm to generate smooth trajectories. Simulation results demonstrate that the proposed framework outperforms existing baseline methods in terms of reward convergence, zero-collision safety, and system stability.},
 author = {Liu, Ben and Li, Hanyu and Shi, Junling},
 doi = {10.1109/LNET.2026.3692211},
 issn = {2576-3156},
 journal = {IEEE Networking Letters},
 keyword = {Merging;Vehicles;Games;Modeling;Timing;Safety;Optimization;Algorithms;Sequences;Sequential analysis;Ramp merging;game theory;MAPPO;platoon merging Control},
 month = {},
 number = {},
 pages = {1-1},
 title = {A Game-Theoretic and Multi-Agent Reinforcement Learning Framework for Cooperative Merging of Platoons in Multi-Lane On-Ramp},
 volume = {},
 year = {2026}
}
