@article{WU2025127167,
 abstract = {Due to the wide range of driving behaviors and varying traffic conditions between mainline and on-ramp traffic, freeway on-ramp areas become complex, high-risk zones for traffic conflicts. Emerging Connected and Automated Vehicles (CAVs) technology is anticipated to significantly improve ramp merging processes, potentially reducing traffic conflicts and crashes through advanced path planning and control. This research introduces a path planning approach based on the Driving Risk Surrogate (DRS) model to manage vehicle risk for heterogeneous vehicle types during operation, aiming to minimize collision risk. In the proposed method, a two-layer model is constructed, with the first layer utilizing deep reinforcement learning for preliminary trajectory planning every second, followed by the second layer that refines the vehicular trajectory via a Model Predictive Control (MPC) method. To tackle the convergence challenges during training, expert data is integrated into the model and developed to proportional decay expert experience replay strategy which also reduces fuel consumption by 11.82%. The proposed control framework is compared against benchmarks, and simulation experiments results that the model achieves more stable safety, and maintains higher operational velocities while minimizing acceleration fluctuations. Moreover, simulations on different vehicle types demonstrate the proposed framework’s capability to tailor merging strategies to heterogeneous traffic flows, effectively addressing the limitations of traditional models.},
 author = {Renfei Wu and Junfeng Jiang and Wenqi Lu and Yikang Rui and Dong Ngoduy and Bin Ran},
 doi = {https://doi.org/10.1016/j.eswa.2025.127167},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Connected and automated driving, Path planning, Trajectory control, Risk management, On-ramp merging},
 pages = {127167},
 title = {A dual-layer path planning approach for ramp merging with integrated risk management},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417425007894},
 volume = {276},
 year = {2025}
}
