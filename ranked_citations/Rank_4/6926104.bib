@inproceedings{6926104,
 abstract = {This paper presents a methodology to automatically generate SystemC protocol implementation, starting from its specification given through UML sequence diagrams. The methodology merges such diagrams into a single one, which is then used to generate the SystemC code. Two algorithms are proposed for the merging and refinement step, respectively. SCNSL network simulator is exploited to simulate the generated code in a complete network scenario. As case study, the methodology is applied to sequence diagrams contained into IEEE 802.15.4 protocol standard specification.},
 author = {Ebeid, E. and Fummi, F. and Quaglia, D. and Stefanni, F.},
 booktitle = {2013 14th International Workshop on Microprocessor Test and Verification},
 doi = {10.1109/MTV.2013.21},
 issn = {2332-5674},
 keyword = {Unified modeling language;Protocols;Merging;Libraries;Computational modeling;IEEE 802.15 Standards;Protocol synthesis;Unified Modeling Language (UML);SystemC;Networked Embedded Systems;Network Simulators},
 month = {Dec},
 number = {},
 pages = {68-73},
 title = {Automatic Network Protocol Synthesis from UML Sequence Diagrams},
 volume = {},
 year = {2013}
}
