@inproceedings{1020893,
 abstract = {In this paper, a multi-mode image tracking system was designed, which uses the distributed structure to fuse the tracking results of these modes. Because of noise in the image, the presence of occlusion, and deformation of the tracked target, some tracking algorithms may fail. The aim of the paper is to merge the advantages of all tracking algorithms to obtain robust behaviour. There are three tracking models applied in this system, based on region, B-snake, and distinguished points. Each of these three modes contributes to the fusion center, and communicates with other models. Results show that this system could overcome common problems in tracking.},
 author = {Lin zheng and Chongzhao Han and Dongguang Zuo and Hongsen Yan},
 booktitle = {Proceedings of the Fifth International Conference on Information Fusion. FUSION 2002. (IEEE Cat.No.02EX5997)},
 doi = {10.1109/ICIF.2002.1020893},
 issn = {},
 keyword = {Target tracking;Active contours;Fuses;Computer crime;Sensor systems;Covariance matrix;Design engineering;Noise robustness;Image processing;Computer vision},
 month = {July},
 number = {},
 pages = {832-837 vol.2},
 title = {A multi-mode image tracking system based on distributed fusion},
 volume = {2},
 year = {2002}
}
