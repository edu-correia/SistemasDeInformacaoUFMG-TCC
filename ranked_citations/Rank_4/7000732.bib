@inproceedings{7000732,
 abstract = {Blind channel estimation for dereverberation is noticed in most applications such as, blind source separation, communication and etc. The important challenge in this application is convolutive mixtures in a reverberant acoustic environment. In this paper, a MIMO system that has 2 input signals will be converted into 2 SIMO systems and their spatial interference will be separated. A tree structure is chosen from fully connected network and one virtual node is added to this network at signal source 1. The equations of 2 SIMO systems are merged and a linear equation is obtained from them. This equation is solved by TLS estimation and channel coefficients are obtained iteratively. We have provided MC simulation that demonstrates the effectiveness of the algorithm.},
 author = {Foroushi, Zohre and TabatabaVakili, Vahid},
 booktitle = {7'th International Symposium on Telecommunications (IST'2014)},
 doi = {10.1109/ISTEL.2014.7000732},
 issn = {},
 keyword = {Mathematical model;Equations;Signal processing algorithms;Estimation;Vectors;MIMO;Channel estimation;blind channel estimation;TLS;sensor network},
 month = {Sep.},
 number = {},
 pages = {375-378},
 title = {Blind channel estimation based TLS algorithm in fully connected network with two signal sources},
 volume = {},
 year = {2014}
}
