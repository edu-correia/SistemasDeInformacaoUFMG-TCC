@inproceedings{10898857,
 abstract = {Introducing a groundbreaking Intrusion Detection System (NLPIDS), we merge natural language processing with ensemble-based machine learning. This innovative system converts natural language HTTP requests into vectors, which are then utilized to train various supervised and ensemble-based machine learning models. These models are subsequently deployed to detect anomalous traffic patterns. Validation of our methodology was conducted using the HTTP DATASET CSIC 2010, showcasing the effectiveness of NLPIDS with exceptional F1-score (0.999) and minimal false alarms (0.007) compared to traditional methods. Significantly, NLPIDS operates independently of specific attack methodologies and feature vectors.},
 author = {Rao, Trupthi and Kodipalli, Ashwini and N, Gargi and Soma, Bhavani},
 booktitle = {2024 International Conference on Computational Intelligence for Security, Communication and Sustainable Development (CISCSD)},
 doi = {10.1109/CISCSD63381.2024.00062},
 issn = {},
 keyword = {Sentiment analysis;Translation;Network intrusion detection;Machine learning;Speech recognition;Traffic control;HTTP;Vectors;Security;Sustainable development;Intrusion Detection;Sentence segmentation;Tokenization;NLPIDS;Detection of Anomaly;Word2Vec;Doc2Vec},
 month = {April},
 number = {},
 pages = {246-251},
 title = {Machine Learning and NLP Integration for Robust Network Intrusion Detection},
 volume = {},
 year = {2024}
}
