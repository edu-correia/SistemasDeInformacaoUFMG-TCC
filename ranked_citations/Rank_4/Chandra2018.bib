 publication_stage = {Final},
 source = {Scopus},
 title = {Bonsai: Synthesis-based reasoning for type systems},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85079094249?origin=resultslist},
 volume = {2},
 year = {2018}
}
