@conference{Du2025,
 abstract = {Open-domain Question Answering (QA) has garnered substantial interest by combining the advantages of faithfully retrieved passages and relevant passages generated through Large Language Models (LLMs). However, there is a lack of definitive labels available to pair these sources of knowledge. In order to address this issue, we propose an unsupervised and simple framework called Bi-Reranking for Merging Generated and Retrieved Knowledge (BRMGR), which utilizes re-ranking methods for both retrieved passages and LLM-generated passages. We pair the two types of passages using two separate reranking methods and then combine them through greedy matching. We demonstrate that BRMGR is equivalent to employing a bipartite matching loss when assigning each retrieved passage with a corresponding LLM-generated passage. The application of our model yielded experimental results from three datasets, improving their performance by +1.7 and +1.6 on NQ and WebQ datasets, respectively, and obtaining comparable result on TriviaQA dataset when compared to competitive baselines. © 2025 IEEE.},
 author = {Du, Xinkai and Han, Quanjie and Lv, Chao and Liu, Yan and Sun, Yalin and Shu, Hao and Shan, Hongbo and Sun, Maosong},
 doi = {10.1109/ICASSP49660.2025.10889018},
 journal = {ICASSP, IEEE International Conference on Acoustics, Speech and Signal Processing - Proceedings},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improving Generated and Retrieved Knowledge Combination Through Zero-shot Generation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105003877744?origin=resultslist},
 year = {2025}
