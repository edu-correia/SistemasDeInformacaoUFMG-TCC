@article{Lin2009774,
 abstract = {This study proposes a visualized cognitive knowledge map integration system, called VisCog, to facilitate knowledge management on P2P networks. By using the SOM (self-organized map)-like model, Egocentric SOM (ESOM), VisCog can merge the other peers' knowledge artifacts (e.g., documents) under a focal peer's knowledge structure and visually present the cognitive knowledge map of the P2P network. The experimental results from evaluating VisCog performance show that VisCog can retain an individual peer's knowledge structure while articulating with those of other peers to build its cognitive knowledge map. © 2008 Elsevier B.V. All rights reserved.},
 author = {Lin, Fu-ren and Yu, Jen-Hung},
 doi = {10.1016/j.dss.2008.11.020},
 journal = {Decision Support Systems},
 note = {Cited by: 13},
 number = {4},
 pages = {774 - 785},
 publication_stage = {Final},
 source = {Scopus},
 title = {Visualized cognitive knowledge map integration for P2P networks},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/61349116731?origin=resultslist},
 volume = {46},
 year = {2009}
}
