@conference{Liu20102360,
 abstract = {In reverse engineering, in order to get integrity of the detected objects surface data, it is often necessary to locate and merge the different-view- measured cloud data in a global coordinate system. Based on the Interactive Closest Point (ICP) Algorithm, a method is presented to find the two closest points and a nominal correspondence is created between the controlled point sets selected from the different positions in the overlapped view area. Experimental results show that this approach is effective. ©2010 IEEE.},
 author = {Liu, Jiang and Gong, Xiao-Qing},
 doi = {10.1109/CISP.2010.5648243},
 journal = {Proceedings - 2010 3rd International Congress on Image and Signal Processing, CISP 2010},
 note = {Cited by: 1},
 pages = {2360 - 2362},
 publication_stage = {Final},
 source = {Scopus},
 title = {Study on the alignment method of multi-view point-clouds in reverse engineering},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78650543495?origin=resultslist},
 volume = {5},
