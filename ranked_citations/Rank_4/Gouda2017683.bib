@article{Gouda2017683,
 abstract = {String similarity join is a basic and essential operation in many applications. In this paper, we investigate the problem of string similarity join with edit distance constraints. A trie-based edit similarity join framework has been proposed recently. The main advantage of existing trie-based algorithms is support for siilarity join 011 short strings. The main problem is when joining long and distant strings. These methods generate and maintain lots of similar prefixes called active nodes which need to be further removed in a subsequent pruning phase. With large edit distance, the number of active nodes becomes quite large. In this paper, we propose a new trie-based join algorithm called Pre Join, which improves upon current trie-based join methods. It efficiently finds all similar string pairs using a novel active-node generation method, which minimizes the number of generated active nodes by applying the pruning heuristics early in the generation process. The performance of PreJoin is scaled in two different ways: First, a dynamic reordering of the trie index is used to accelerate the search for similar string pairs. Second, a partitioning method of string space is used to improve performance on large edit distance thresholds. Experiments show that our approach is highly efficient for processing short as well as long strings, and outperforms the state-of-the-art trie-based join approaches by a factor five.},
 author = {Gouda, Karam and Rashad, Metwally},
 doi = {10.4149/cai_2017_3_683},
 journal = {Computing and Informatics},
 note = {Cited by: 1; All Open Access; Gold Open Access},
 number = {3},
 pages = {683 - 704},
 publication_stage = {Final},
 source = {Scopus},
 title = {Efficient string edit similarity join algorithm},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85029375647?origin=resultslist},
