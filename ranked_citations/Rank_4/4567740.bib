@inproceedings{4567740,
 abstract = {This paper proposes a technique for group object motion estimation based on evolving graph networks. The main novelty over alternative group tracking techniques stems from learning the network structure for the group. An algorithm is proposed for automatic graph structure initialisation, incorporation of new nodes and unexisting nodes removal in parallel with the edge update. This evolving graph model is combined with the sequential Monte Carlo framework and its effectiveness is illustrated over a complex scenario for group motion estimation in urban enviroment. Results with merging, splitting and crossing of the groups are presented with high estimation accuracy.},
 author = {Gning, Amadou and Mihaylova, Lyudmila and Maskell, Simon and Pang, Sze Kim and Godsill, Simon},
 booktitle = {2008 IET Seminar on Target Tracking and Data Fusion: Algorithms and Applications},
 doi = {},
 issn = {0537-9989},
 keyword = {evolving graph;random graphs;group target tracking;Monte Carlo methods;nonlinear estimation},
 month = {April},
 number = {},
 pages = {99-106},
 title = {Evolving networks for group object motion estimation},
 volume = {},
 year = {2008}
}
