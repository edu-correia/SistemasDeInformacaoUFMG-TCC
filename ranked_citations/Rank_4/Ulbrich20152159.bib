 abstract = {Cooperative behavior planning for automated vehicles is getting more and more attention in the research community. This paper introduces two dimensions to structure cooperative driving tasks. The authors suggest to distinguish driving tasks by the used communication channels and by the hierarchical level of cooperative skills and abilities. In this manner, this paper presents the cooperative behavior skills of 'Jack', our automated vehicle driving from Stanford to Las Vegas in January 2015. © 2015 IEEE.},
 author = {Ulbrich, Simon and Grossjohann, Simon and Appelt, Christian and Homeier, Kai and Rieken, Jens and Maurer, Markus},
 doi = {10.1109/ITSC.2015.349},
 journal = {IEEE Conference on Intelligent Transportation Systems, Proceedings, ITSC},
