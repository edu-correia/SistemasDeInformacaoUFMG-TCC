@incollection{ZHANG2021285,
 abstract = {This chapter integrates the feature-driven optimization method with additive manufacturing. Two major concerns related to additive manufacturing are considered, that is, designs of self-supporting structures and enclosed void-free structures. For the self-supporting structure design, polygon-featured holes are introduced as design primitives and ratio design variables are formulated to constrain the overhang angles. Unprintable V-shaped areas are checked automatically in the optimized result for the presence. Intersecting polygons are correspondingly modified, replaced with new merging polygons, and further optimized until all V-shaped areas are eliminated. For the enclosed void-free structure design, a side constraint scheme is presented. To ensure structural connectivity, the design variables related to the centers of all void features are bounded outside the design domain by means of side constraints without introducing additional nonlinear constraints.},
 author = {Weihong Zhang and Ying Zhou},
 booktitle = {The Feature-Driven Method for Structural Optimization},
 doi = {https://doi.org/10.1016/B978-0-12-821330-8.00008-0},
 editor = {Weihong Zhang and Ying Zhou},
 isbn = {978-0-12-821330-8},
 keyword = {Additive manufacturing, Critical overhang angle, Self-supporting structure, Polygon feature, Structure connectivity, Enclosed voids, Side constraint},
 pages = {285-333},
 publisher = {Elsevier},
 title = {Chapter 8 - Integration of feature-driven optimization with additive manufacturing},
 url = {https://www.sciencedirect.com/science/article/pii/B9780128213308000080},
 year = {2021}
}
