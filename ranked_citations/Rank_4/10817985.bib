@inproceedings{10817985,
 abstract = {Sketch algorithms are crucial for data stream analysis, offering one-pass processing, sub-linear storage, and accuracy-performance balance. FPGA-based sketch accelerator helps sketch algorithms keep up with modern network inter-connections' speed. However, deploying and optimizing multiple sketches simultaneously is not widely considered, leaving a vast optimization space untouched. This paper introduces MuSA, a multi-sketch FPGA accelerator that exploits hybrid parallelism during sketch maintenance and coalesced memory organization for merging different sketch states. MuSA supports FIFO merging and architecture-specific parameter selection for hybrid parallelism, reducing memory consumption and enabling more considerable parallelism. Evaluation results validate MuSA's effectiveness, with a 15.2 x kernel performance enhancement compared to the state-of-the-art method, enabling on-the-fly high-speed network measurement and high-velocity database analysis.},
 author = {Zou, Sunan and Shi, Bizhao and Zhang, Ziyun and Luo, Guojie},
 booktitle = {2024 IEEE 42nd International Conference on Computer Design (ICCD)},
 doi = {10.1109/ICCD63220.2024.00017},
 issn = {2576-6996},
 keyword = {High-speed networks;Databases;Merging;Memory management;Organizations;Parallel processing;Maintenance;Kernel;Optimization;Field programmable gate arrays;Sketch;FPGA;Parallel Computing;HLS},
 month = {Nov},
 number = {},
 pages = {36-43},
 title = {MuSA: Multi-Sketch Accelerator with Hybrid Parallelism and Coalesced Memory Organization},
 volume = {},
 year = {2024}
}
