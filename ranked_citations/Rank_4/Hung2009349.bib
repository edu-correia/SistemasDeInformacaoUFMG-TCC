@conference{Hung2009349,
 abstract = {In this paper, we propose an unsupervised method of playfield segmentation for various sport videos. The method first applies local maximum clustering to gather feature samples into several clusters in the Cb-Cr plane. Next, a novel idea is developed to merge clusters into four color classes - Red, Green, Blue and Grey. Finally, a simple scheme of region fusion eliminates small and unimportant areas. The experimental results indicate that the method effectively segments the playfield regions in various scenes of different sport videos. © 2009 IEEE.},
 author = {Hung, Mao-Hsiung and Hsieh, Chaur-Heh and Kuo, Chung-Ming},
 doi = {10.1109/ICICIC.2009.99},
 journal = {2009 4th International Conference on Innovative Computing, Information and Control, ICICIC 2009},
 note = {Cited by: 2},
 pages = {349 - 352},
 publication_stage = {Final},
 source = {Scopus},
 title = {An unsupervised playfield segmentation for various sport videos},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77951451683?origin=resultslist},
 year = {2009}
}
