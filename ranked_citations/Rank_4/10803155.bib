@inproceedings{10803155,
 abstract = {Rapid progress in autonomous and electric vehicles (EVs) demands strict measures to ensure functional safety and cybersecurity. This review paper thoroughly analyzes the key standards that govern these critical areas, particularly ISO 26262 for functional safety and ISO/SAE 21434 for cybersecurity. It delves into practical implementations, highlights the challenges faced, and examines the best practices for merging these stan¬dards into a unified framework that addresses the interconnected safety and security aspects. Additionally, the paper discusses emerging trends, such as advancements in artificial intelligence (AI), machine learning (ML), blockchain technology, and human-machine interface design, and their potential to substantially improve vehicle safety and security. Collaboration within the automotive industry is also emphasized, particularly in devel¬oping unified standards and overcoming integration challenges. This comprehensive review offers valuable insights into future developments and regulatory changes expected to influence the industry, providing essential perspectives for researchers, prac¬titioners, and policymakers involved in the evolving domain of autonomous and electric vehicle technology.},
 author = {Khokha, Simran},
 booktitle = {2024 International Conference on Cybernation and Computation (CYBERCOM)},
 doi = {10.1109/CYBERCOM63683.2024.10803155},
 issn = {},
 keyword = {Industries;Reviews;Collaboration;Electric vehicles;Market research;Safety;Blockchains;Risk management;Computer security;Standards;Autonomous Vehicles;Electric Vehicles;Functional Safety;Cybersecurity;ISO 26262;ISO/SAE 21434;Standards Integration},
 month = {Nov},
 number = {},
 pages = {52-56},
 title = {From Standards to Implementation: Functional Safety and Cybersecurity in Modern Autonomous and Electric Vehicles},
 volume = {},
 year = {2024}
}
