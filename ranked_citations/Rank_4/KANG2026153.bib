@article{KANG2026153,
 abstract = {Background
Coronary artery bypass graft (CABG) is a common procedure that can result in surgical complications.
Methods
Cross-sectional study of 757 acute care hospitals performing CABG surgery. Data on 24,066 Medicare beneficiaries were merged with data from the American Hospital Association Annual Survey and ZIP code-based community characteristics from the Social Vulnerability Index (SVI). Multivariate logistic regression models were fit to estimate the association between social vulnerability and CABG surgical site infection (SSI).
Results
Minority Status and Language were associated with an increase in the likelihood of CABG SSI. In a fully adjusted model, patients from the highest Minority Status and Language SVI quartile had a 60% increase in the likelihood of CABG SSI compared to the lowest SVI quartile.
Discussion
These findings suggest that racial and language differences that exist within communities’ impact Medicare beneficiaries who undergo CABG surgery. These differences result in a higher risk for SSI.
Conclusions
It is imperative that health care organizations and clinicians recognize that community factors can place surgical patients at increased risk for infection and may require community-based interventions.},
 author = {Yu Jin Kang and Janet P. Haas and Patti E. Landerfelt and Omid R. Razmpour and Edmund R. Becker and Peter Joski and Jeannie P. Cimiotti},
 doi = {https://doi.org/10.1016/j.ajic.2025.10.029},
 issn = {0196-6553},
 journal = {American Journal of Infection Control},
 keyword = {Coronary artery bypass graft, Surgical site infection},
 number = {2},
 pages = {153-157},
 title = {Disparities in surgical site infections: The role of social vulnerability among medicare beneficiaries},
 url = {https://www.sciencedirect.com/science/article/pii/S0196655325006984},
 volume = {54},
 year = {2026}
}
