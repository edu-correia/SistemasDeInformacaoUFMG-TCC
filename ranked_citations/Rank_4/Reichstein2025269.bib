@article{Reichstein2025269,
 abstract = {Future-relevant research areas such as agility or the role of information technology in the disruptive world are gaining more and more range and presence. Whether it is the transformation to an agile IT or the evolution of the IT department to a strategic role, companies are under growing pressure to adapt to the challenges of digitization. To merge individual elements together to form a holistic picture, the following two questions are addressed in this paper: To what extend does an IT department contribute to the entire company, by being agile and influencing other departments? Is the opportunity for influence mainly dependent on the appreciation of the IT department by these departments? Starting with a structured literature analysis (SLA) followed by a structural equation model based on valuable data from a quantitative study by Reichstein (2019), the results are as follows: The IT departments ability to influence has a significant impact on its level of agility. When IT is receiving increasing appreciation, it tends to have a higher ability to influence. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
 author = {Reichstein, Christopher and Härting, Ralf-Christian and Phan, Han and Luk, Nicole},
 doi = {10.1007/978-3-031-94193-1_20},
 journal = {Lecture Notes in Business Information Processing},
 note = {Cited by: 0},
 pages = {269 - 280},
 publication_stage = {Final},
 source = {Scopus},
 title = {The Influence of Agile IT Departments: Appreciation as a Catalyst for Organizational Transformation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105009405934?origin=resultslist},
 volume = {554 LNBIP},
 year = {2025}
}
