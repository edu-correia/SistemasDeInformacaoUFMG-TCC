@conference{Long2010907,
 abstract = {Traditionally, one web application uses the dedicated hardware platform, which provides resource only for the certain application. While web applications on the cloud platform have to share the resource of the same platform. Therefore when traditional web applications are migrated to the cloud platform, a set of challenges merge, mainly traffic control and load balance. Distributed Front-end Routing System (DFRS) is proposed in this paper and DFRS is designed to control traffic and to balance load in cloud-based web application platform, on which a lot of web applications run simultaneously. The experiment demonstrates DFRS can effectively dispatch requests from applications to the light-weight back-end server with low latency, and DFRS is proved to be stable and of high performance. © 2010 IEEE.},
 author = {Long, Xiangming and Song, Huanhuan and Shuang, Kai},
 doi = {10.1109/ICBNMT.2010.5705222},
 journal = {Proceedings - 2010 3rd IEEE International Conference on Broadband Network and Multimedia Technology, IC-BNMT2010},
 note = {Cited by: 0},
 pages = {907 - 911},
 publication_stage = {Final},
 source = {Scopus},
 title = {DFRS: A Distributed Front-end Routing Sytstem in cloud environment},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/79951767067?origin=resultslist},
 year = {2010}
}
