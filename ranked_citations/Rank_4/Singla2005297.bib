@article{Singla2005297,
 abstract = {Object identification is the problem of determining whether different observations correspond to the same object. It occurs in a wide variety of fields, including vision, natural language, citation matching, and information integration. Traditionally, the problem is solved separately for each pair of observations, followed by transitive closure. We propose solving it collectively, performing simultaneous inference for all candidate match pairs, and allowing information to propagate from one candidate match to another via the attributes they have in common. Our formulation is based on conditional random fields, and allows an optimal solution to be found in polynomial time using a graph cut algorithm. Parameters are learned using a voted perceptron algorithm. Experiments on real and synthetic datasets show that this approach outperforms the standard one. © Springer-Verlag Berlin Heidelberg 2005.},
 author = {Singla, Parag and Domingos, Pedro},
 doi = {10.1007/11564126_31},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 38},
 pages = {297 - 308},
 publication_stage = {Final},
 source = {Scopus},
 title = {Object identification with attribute-mediated dependences},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33646416742?origin=resultslist},
 volume = {3721 LNAI},
 year = {2005}
}
