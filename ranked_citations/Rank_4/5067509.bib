@inproceedings{5067509,
 abstract = {In this paper, we propose an approach for belief merging in collaborative conceptual modeling which is inevitably tarnished by uncertainty of multi-source information. This approach is a kind of iterative, mutual evaluating and role-based belief revision process. Based on concepts from belief theory, we conceive that the reliability belief participants assume to each other will affect their choice between opinions. The role people acting will also influence the belief merging process. This approach is not only a vivid simulation to the real world, but also helpful to decision-pruning and speed up convergence.},
 author = {Jia, Lili and Zhou, Huiping and Zhou, Haifang and Sun, Chengzheng and Wang, Zhiying},
 booktitle = {2009 International Symposium on Collaborative Technologies and Systems},
 doi = {10.1109/CTS.2009.5067509},
 issn = {},
 keyword = {Collaboration;Merging;Decision making;Collaborative software;Humans;Computer science;Convergence;Collaborative work;Sun;Uncertainty;role;role-based interacted revision belief;collaborative conceptual modeling;belief theory;consensus;merging and integrating model},
 month = {May},
 number = {},
 pages = {417-422},
 title = {Integration of the dynamic, mutual evaluating and role-based iterated revision belief into collaborative conceptual modeling},
 volume = {},
 year = {2009}
}
