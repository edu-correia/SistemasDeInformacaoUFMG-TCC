@conference{Papadopoulou2007117,
 abstract = {Although awareness is important in collaboration, user studies have shown that many groupware tools fail to meet user requirements or expectations in this respect. We show how richer documents models can lead to richer forms of awareness and present a general awareness framework based on a metamodel for structured documents and associated metrics. We describe how the framework was used to extend a collaborative authoring system to provide awareness information at variable levels of granularity according to user requirements. We also discuss how the framework could be used with other forms of collaborative tools.},
 author = {Papadopoulou, Stavroula and Norrie, Moira C.},
 doi = {10.1109/COLCOM.2007.4553820},
 journal = {Proceedings of the 3rd International Conference on Collaborative Computing: Networking, Applications and Worksharing, CollaborateCom 2007},
 note = {Cited by: 5},
 pages = {117 - 126},
 publication_stage = {Final},
 source = {Scopus},
 title = {How a structured document model can support awareness in collaborative authoring},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/51349131835?origin=resultslist},
 year = {2007}
}
