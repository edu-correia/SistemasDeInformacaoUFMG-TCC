@conference{Wang20081947,
 abstract = {In this paper, we have proposed a bandwidth efficient turbo trellis-coded modulation scheme for the non-coherent multiple-antenna Rayleigh fading channel, where the channel state information is not necessary both at the transmitter and the receiver. In this scheme, we merge the unitary space-time modulation as constellations with the turbo trelliscoded modulation, resulting in the turbo trellis-coded USTM, with the trellis-coded USTM encoder as the component encoders. We have also derived the iterative maximum a posteriori algorithm. Through computer simulations, we demonstrated that without bandwidth expansion, turbo trellis-coded USTM produces significant coding gains over its uncoded counterparts. © 2008 IEEE.},
 author = {Wang, Jin},
 doi = {10.1109/ICOSP.2008.4697524},
 journal = {International Conference on Signal Processing Proceedings, ICSP},
 note = {Cited by: 0},
 pages = {1947 - 1950},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improved unitary space-time modulation for multiple-antenna Rayleigh fading channel},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/67249131550?origin=resultslist},
 year = {2008}
}
