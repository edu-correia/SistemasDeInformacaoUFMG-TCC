@article{WU2026105650,
 abstract = {The task of polarization-direction of arrival (DOA) estimation presents significant computational and model complexity challenges, particularly in multi-dimensional angle estimation under adverse signal conditions such as low signal-to-noise ratios (SNR) and coherent signals. Conventional model-driven methods tend to perform poorly in these scenarios. We propose a cascaded model that integrates a multi-parallel dilated neighborhood attention transformer with patch merge (MDTP) and an natural language processing (IRTCN). Drawing inspiration from the transformer architecture’s multi-head self-attention mechanism, the MDTP efficiently extracts spatial-polarization features using a reduced parameter set. The IRTCN, influenced by advancements in natural language processing (NLP), enhances the interaction and dependency capture across different subspaces. This model achieves high-precision estimation through regression networks and angle pairing. Simulation results indicate that our proposed method significantly outperforms both model-driven and data-driven methods in scenarios characterized by low SNR and coherent signals, achieving a markedly lower root mean square error (RMSE). The integration of MDTP and IRTCN not only reduces the parameter count but also accelerates computation, thereby demonstrating the method’s efficiency and superiority without compromising precision.},
 author = {Zihan Wu and Jun Wang and Zhiquan Zhou},
 doi = {https://doi.org/10.1016/j.dsp.2025.105650},
 issn = {1051-2004},
 journal = {Digital Signal Processing},
 keyword = {Gridless coherent polarization-DOA estimation, Dilated neighborhood attention transformer, Computational and model complexity, Temporal convolutional network (TCN), Multi-dimensional features},
 pages = {105650},
 title = {Gridless coherent polarization-DOA estimation with dilated neighborhood attention and temporal convolutional network},
 url = {https://www.sciencedirect.com/science/article/pii/S1051200425006724},
 volume = {168},
 year = {2026}
}
