@inproceedings{9038046,
 abstract = {This plenary speech will address the significant challenges that the electric grid and the automotive industry are facing today within the context of the EU Energy Vision 2050's ‘energy trilemma’, and highlight some compelling evidence that these two historically independent sectors have now reached the right time and conditions for the convergence into a new energy ecosystem. Using results from both established and on-going research projects, it will discuss how enabling technologies, such as information technology and cloud computing, and disruptive applications, such as mobility as a service (MaaS), have turned some of these challenges into opportunities, as the two systems continue to merge and evolve. Then, it will introduce Cranfield University's new Green Grid-Vehicle Ecosystem initiative that projects the vision of a de-carbonized electric grid supporting the entire transportation network and other mobility services. It finishes with a glimpse of a futuristic electric propulsion based on superconducting machines for full electric aircraft beyond 2050.},
 author = {Luk, P. C. K.},
 booktitle = {The 11th IET International Conference on Advances in Power System Control, Operation and Management (APSCOM 2018)},
 doi = {10.1049/cp.2018.1740},
 issn = {},
 keyword = {Electric grid;grid integration;vehicle to grid;EV ecosystem;MaaS},
 month = {Nov},
 number = {},
 pages = {1-5},
 title = {Towards a new energy eco-system: The convergence of the electric grid and the electric vehicle},
 volume = {},
 year = {2018}
}
