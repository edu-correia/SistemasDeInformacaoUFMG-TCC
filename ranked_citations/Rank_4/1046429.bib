@inproceedings{1046429,
 abstract = {A new network architecture based on the merge between broadcast and telecom technologies is proposed to build an integrated interactive multimedia network with asymmetric nature to different categories of users. Information is carried by digital video broadcasting-transport stream (DVB-TS) as defined by the DVB standard. The downstream information is distributed by the broadcasting network, while the upstream information is carried in the telecom environment. The novel architecture is composed of three-transmission layers solution. The downstream network layers are formed by merging microwave video distribution system (MVDS) and satellite master antenna television (SMATV) distribution systems, while the upstream network structure is composed of a combination between SMATV, local multipoint distribution system (LMDS) and MVDS distribution networks. The LMDS and SMATV networks are adapted to provide access technology for the last mile solution where MVDS system forms the backbone structure of the network. In this paper, a mathematical model for an optimized frequency plan based on the usage of cross-polarization and frequency reuse concepts is deduced.},
 author = {Ayoub, M.M. and Rizk, M.R.M.},
 booktitle = {9th International Conference on Electronics, Circuits and Systems},
 doi = {10.1109/ICECS.2002.1046429},
 issn = {},
 keyword = {Bidirectional control;Frequency;Digital video broadcasting;Multimedia communication;Telecommunications;Streaming media;Satellite broadcasting;Broadcast technology;Digital multimedia broadcasting;TV broadcasting},
 month = {Sep.},
 number = {},
 pages = {1043-1046 vol.3},
 title = {Optimized bi-directional frequency plan for microwave video and data distribution system "MVDDS"},
 volume = {3},
 year = {2002}
}
