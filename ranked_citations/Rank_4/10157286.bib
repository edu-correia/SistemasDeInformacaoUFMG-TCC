@inproceedings{10157286,
 abstract = {The DevOps approach is a software development methodology that emphasizes collaboration, communication, and automation between development and operations teams. Continuous Integration (CI) is a core DevOps practice that involves merging code changes frequently and ensuring that the resulting codebase is functional and stable. In this paper, a comprehensive approach to enhancing DevOps and Continuous Integration in software engineering is presented. The approach incorporates various techniques and tools to streamline the software development process, increase team productivity, and improve software quality. Case studies of successful implementations of the approach in various organizations, such as e-commerce and software companies, are presented. It has been identified that a new dimension of technical and cultural aspects adopted by various organizations has led to a significant increase in the frequency of code releases to production environments.},
 author = {Dileepkumar, S R and Mathew, Juby},
 booktitle = {2023 Second International Conference on Electrical, Electronics, Information and Communication Technologies (ICEEICT)},
 doi = {10.1109/ICEEICT56924.2023.10157286},
 issn = {},
 keyword = {Productivity;Technological innovation;Codes;Collaboration;Software quality;Companies;Software systems;DevOps;Continuous Integration;software engineering;Netflix;Amazon;IBM;Microsoft},
 month = {April},
 number = {},
 pages = {01-05},
 title = {Enhancing DevOps and Continuous Integration in Software Engineering: A Comprehensive Approach},
 volume = {},
 year = {2023}
}
