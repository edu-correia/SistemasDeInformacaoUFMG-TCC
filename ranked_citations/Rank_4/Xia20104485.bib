@article{Xia20104485,
 abstract = {This paper concerns property-preserving transformation for verifying some basic properties of Petri nets. In the literature a majority of transformations are for a few classes of nets to merge a set of places or transitions. This paper investigates the transformation of merging a set of subnets of Petri nets beyond asymmetric choice nets and proposes the conditions for it to preserve structural liveness. The results are then applied to the verification of subsystem-sharing systems. Our approach extends the scopes of underlying nets to ordinary Petri nets and verification technique. © 2010 Binary Information Press.},
 author = {Xia, Chuanliang},
 journal = {Journal of Computational Information Systems},
 note = {Cited by: 5},
 number = {13},
 pages = {4485 - 4492},
 publication_stage = {Final},
 source = {Scopus},
 title = {Structural liveness preservation of Petri synthesis net},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/78651465632?origin=resultslist},
 volume = {6},
 year = {2010}
}
