@article{Getahun200953,
 abstract = {Merging information can be of key importance in several XML-based applications. For instance, merging the RSS news from different sources and providers can be beneficial for end-users (journalists, economists, etc.) in various scenarios. In this work, we address this issue and mainly explore the relatedness relationships between RSS entities/ elements. To validate our approach, we also provide a set of experimental tests showing satisfactory results. © 2009 Springer-Verlag Berlin Heidelberg.},
 author = {Getahun, Fekade and Tekli, Joe and Viviani, Marco and Chbeir, R. and Yetongnon, Kokou},
 doi = {10.1007/978-3-642-02937-0_6},
 journal = {Studies in Computational Intelligence},
 note = {Cited by: 1},
 pages = {53 - 64},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards semantic-based RSS merging},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/67650647186?origin=resultslist},
 volume = {226},
 year = {2009}
}
