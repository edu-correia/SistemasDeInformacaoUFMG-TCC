@inproceedings{10638895,
 abstract = {This study investigates Component-Driven Development (CDD) and its impact on frontend web development, particularly focusing on the reusability and testability of UI components. We conducted a thorough investigation utilizing a combination of quantitative measurements and qualitative insights by merging Stencil.js and Storybook.js to comprehend the practical implications and difficulties of CDD. The study shows significant advances in frontend development both in efficiency and quality, particularly in terms of making UI components more reusable and testable. It also provides a list of recommended practices and implementation-related challenges. The study also explores how CDD facilitates a more structured and systematic approach to building robust and dynamic web applications, emphasizing the importance of adopting component-driven strategies to meet the increasing complexity and demands of modern web development projects.},
 author = {Abdulhakeem, Alaa and Saeed, Sabri and Mustafa, Nada and Ibrahim, Mohammed A.M. and Al-Tayar, Basheer},
 booktitle = {2024 4th International Conference on Emerging Smart Technologies and Applications (eSmarTA)},
 doi = {10.1109/eSmarTA62850.2024.10638895},
 issn = {},
 keyword = {Measurement;Automation;Systematics;Merging;Focusing;Documentation;Robustness;Component-Driven Development;Frontend Development;Reusability;Testability;Web Components;Component Library;Design System;Stencil.js;Storybook.js},
 month = {Aug},
 number = {},
 pages = {1-8},
 title = {Enhancing Frontend Efficiency: Reusability and Testability in Component-Driven Development},
 volume = {},
 year = {2024}
}
