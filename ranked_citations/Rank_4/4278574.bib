@inproceedings{4278574,
 abstract = {In this paper we study mobile home automation, a field that emerges from an integration of mobile application platforms and home automation technologies. In a conceptual introduction we first illustrate the need for such applications by introducing a two-dimensional conceptual model of mobility. Subsequently we suggest an architecture and discuss different options of how a user might access a mobile home automation service and the controlled devices. As another contribution we implemented a mobile home automation service, which we named REMOTILE. This prototype helps us to discuss typical components, such as modules that integrate various home automation devices.},
 author = {Rosendahl, Andreas and Hampe, J. Felix and Botterweck, Goetz},
 booktitle = {International Conference on the Management of Mobile Business (ICMB 2007)},
 doi = {10.1109/ICMB.2007.47},
 issn = {},
 keyword = {Home automation;Merging;Control systems;Automatic control;Home appliances;Telephony;Application software;Prototypes;Switches;Software engineering},
 month = {July},
 number = {},
 pages = {31-31},
 title = {Mobile Home Automation - Merging Mobile Value Added Services and Home Automation Technologies},
 volume = {},
 year = {2007}
