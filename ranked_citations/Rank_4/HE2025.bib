@article{HE2025,
 abstract = {Human drivers often reveal a high level of behavioural heterogeneity during microscopic traffic interactions, while limited research explores its impact on traffic safety and sustainability. This study proposes a framework that integrates conflict-based measures and vehicle emission models to evaluate interaction performance. By combining the dynamics analysis of the interaction pairs (i.e. leader-follower) with different interactive strategies and scenarios, this work advances the understanding of how heterogeneous driving behaviours differentially impact safety and emissions. First, by extracting interaction information from trajectory data collected from the intersection Drone (inD) and roundabouts Drone (rounD) datasets, semi-supervised learning is employed to analyze driving heterogeneity in interaction scenarios. The S3VM-based classifier addresses the limitations of traditional classifiers by constructing a mixture of labelled data and unlabelled data, where class labels from the training set are assigned to the working set to construct the ‘best’ SVM. The impact of this heterogeneity on traffic safety and sustainability is subsequently investigated. The findings suggest that crossing interactions at intersections are more complex than merging interactions. Additionally, the driving style of the following vehicle imposes significant impacts on safety. Conversely, the leading vehicle's driving style substantially influences the sustainability of interactions, with aggressive leaders potentially increasing emissions during interactions. Furthermore, roundabouts curb extreme driving behaviours among drivers, reducing overall emissions. In terms of interaction performance, while merging interactions in roundabouts exhibit superior safety and efficiency, they also generate high emissions. The results are expected to provide valuable insights for safe and eco-driving strategies and intersection planning.},
 author = {Xiangyu He and Yu Zhao and Ang Ji},
 doi = {https://doi.org/10.1080/23249935.2025.2561899},
 issn = {2324-9935},
 journal = {Transportmetrica A Transport Science},
 keyword = {Driving style heterogeneity, interactive scenarios, clustering analysis, safety and sustainability evaluation},
 title = {Exploring the impacts of driving styles on safety and sustainability in interactive scenarios},
 url = {https://www.sciencedirect.com/science/article/pii/S2324993525001186},
 year = {2025}
}
