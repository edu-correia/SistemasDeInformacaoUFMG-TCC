@inproceedings{6601970,
 abstract = {Nowadays the importance of accessibility in eLearning is well recognized. Numerous systems with this consideration have taken this path attempting to realize the merge between eLearning and accessibility. These attempts did not achieve significant exploits presenting several drawbacks preventing an environment successfully overlapping accessibility and eLearning. This paper presents our vision in designing an environment supporting eLearning accessibility. In order to ensure offering content in formats tailored to individual users based on their personal preferences [12], which guarantees an eLearning environment fully supporting the accessible learning content exploitation.},
 author = {Brahim, Hejer Ben and Jemaa, Amal Ben and Jemni, Mohamed and Laabidi, Mohsen},
