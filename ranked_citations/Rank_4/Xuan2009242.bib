@conference{Xuan2009242,
 abstract = {Once Web Service is deployed, other Web Services can discover and invoke the deployed one. When two services merge, it seems that the combination of their features occurs in actual in the user's view. As the number and scale of this feature are greater and more complex, undesirable interactions will expose, similar to the domain of telecommunication. The paper proposes a formal method of detecting feature interactions in Web Services before deployed. The manipulation of the graphical representation of Web Service feature as graph patterns of explicit semantic business process model is supported with a graph grammar-enabled editor AGO. We represent each feature as an operation flow which is formalized as a set of Graph Transformation based rules in AGG. Feature interactions are detected probably including the reason of conflict by the exact conflict reasoning between rules. As a visual approach using graph transformations, the result in this paper is static detection of Web Service feature interactions in planning phase. © 2009 The authors and IOS Press. All rights reserved.},
 author = {Xuan, Huili and Xu, Jiuyun},
 doi = {10.3233/978-1-60750-014-8-242},
 journal = {Feature Interactions in Software and Communication Systems X},
 note = {Cited by: 1},
 pages = {242 - 249},
 publication_stage = {Final},
 source = {Scopus},
 title = {Web services feature interaction detection based on graph transformation: A new interaction detection method},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70350644997?origin=resultslist},
 year = {2009}
}
