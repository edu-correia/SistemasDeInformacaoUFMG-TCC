@inproceedings{5952536,
 abstract = {With the development of Computer Supported Cooperative Work (CSCW), groupware systems that support collaborative editing have been developing rapidly. Real-time collaborative editing system is groupware systems that allow groups of users from different sites to view and edit the same documents at the same time. Consistency maintenance is one of the most important challenges in the design of these systems. Many algorithms for consistency maintenance which have good performance with Client/Server mode can't work in Peer-to-Peer (P2P) environments. In this paper, we propose an operational transformation algorithm with conflict detection and awareness methods for real-time collaborative editing in P2P environments, where conflict awareness is a reasonable way to help users to solve conflict problems. We designed and implemented a real-time collaborative editor using our algorithm. The experiment results showed that our algorithm is viable and feasible.},
 author = {Hongzhi Song and Zhaoming Ou and Yi Fu and Xiangxin Lin and Lei Yang},
 booktitle = {2011 IEEE International Conference on Computer Science and Automation Engineering},
 doi = {10.1109/CSAE.2011.5952536},
 issn = {},
 keyword = {Collaboration;Transforms;Image color analysis;Real time systems;Algorithm design and analysis;Synchronization;Clocks;CSCW;real-time collaborative editing;operational transformation;conflict detection;conflict awareness;P2P},
 month = {June},
 number = {},
 pages = {571-576},
 title = {Operational transformation algorithm with conflict detection and awareness methods for real-time collaborative editing in P2P environments},
 volume = {2},
 year = {2011}
}
