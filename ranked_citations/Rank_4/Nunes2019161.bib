@article{Nunes2019161,
 abstract = {Automated Static Analysis Tool (ASATs) are one of the best ways to search for vulnerabilities in applications, so they are a resource widely used by developers to improve their applications. However, it is well-known that the performance of such tools is limited, and their detection capabilities may not meet the requirements of the project regarding the criticality of the application. Diversity is an obvious direction to take to improve the true positives, as different tools usually report distinct vulnerabilities, however with the cost of also increasing the false positives, which may be unacceptable in some scenarios. In this paper, we study the problem of combining diverse ASATs to improve the overall detection of vulnerabilities in web applications, considering four development scenarios with different criticality goals and constraints. These scenarios range from low budget to high-end (e.g., business critical) web applications. We tested with five ASATs under two datasets, one with real WordPress plugins and another with synthetic test cases. Our findings revealed that combining the outputs of several ASATs does not always improve the vulnerability detection performance over a single ASAT. By using our procedure a developer is able to choose which is the best combination of ASATs that fits better in the project requirements. © 2018, Springer-Verlag GmbH Austria, part of Springer Nature.},
 author = {Nunes, Paulo and Medeiros, Ibéria and Fonseca, José and Neves, Nuno and Correia, Miguel and Vieira, Marco},
 doi = {10.1007/s00607-018-0664-z},
 journal = {Computing},
 note = {Cited by: 30},
 number = {2},
 pages = {161 - 185},
 publication_stage = {Final},
 source = {Scopus},
 title = {An empirical study on combining diverse static analysis tools for web security vulnerabilities based on development scenarios},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85053903271?origin=resultslist},
 volume = {101},
 year = {2019}
}
