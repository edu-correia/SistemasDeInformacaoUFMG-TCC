@conference{Fan2025,
 abstract = {Intelligent driving has emerged as a critical enabler of future advancements in mobility, underscoring its transformative significance. This paper investigates an automatic merging control strategy within the reinforcement learning framework, addressing key challenges such as low merging efficiency and traffic congestion in current intelligent transportation systems that integrate Connected Automated Vehicles (CAVs) and Human-Driven Vehicles (HVs). The proposed control strategy is validated through simulation experiments. We model the merging problem as a Markov Decision Process (MDP) and design a reward function that effectively balances vehicle safety and efficiency. Building on this foundation, we introduce an enhanced algorithm that extends the Deep Q-Network (DQN) framework by incorporating an Attention mechanism. This integration strengthens the model's ability to capture relationships within input sequences, thereby improving the performance and generalization capabilities of reinforcement learning models. Simulation results demonstrate that the proposed algorithm outperforms the baseline DQN approach, delivering superior overall performance. It not only ensures vehicle safety in merging scenarios but also significantly enhances traffic efficiency. © 2025 SPIE.},
 author = {Fan, Xuan and Shi, Qing and Huang, Yafei and Tian, Hao},
 doi = {10.1117/12.3074708},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on Automatic Confluence Control Strategy under Reinforcement Learning Framework},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105014240014?origin=resultslist},
 volume = {13681},
