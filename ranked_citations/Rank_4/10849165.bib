@inproceedings{10849165,
 abstract = {As the automobile industry continues to increase the number of electric vehicles (EVs), the demand to develop a smart, sophisticated, and maintainable charging infrastructure will also be imperative. As of today, one important challenge that continues to present itself regarding EVs merging successfully in the transportation sector is adding renewable energy sources while simultaneously being cost-effective and having a strong cybersecurity presence. This research study intends to develop an optimized framework for EV charging networks that not only expands the utilization of renewable energy sources, but reduces both operational and user costs, and increases resistance against cyberattacks. With a new improved framework being proposed, the Bald Eagle Search Algorithm (BESA) is exploited to address the multi-objective optimization problem. The framework itself uses advanced anomaly detection mechanisms, such as machine learning-based methods, to carefully detect and alleviate the damage of some cyber threats, including data manipulation and denial-of-service (DoS) attacks. Simulation-based testing was performed under several situations to analyze the performance and strength of the proposed framework. The testing results demonstrate how efficient the proposed framework can be. Under ideal conditions, the framework was able to attain up to 85% renewable energy utilization while maintaining a utilization rate of $\mathbf{6 0\%}$ during times when the availability of renewable energy sources was low, drastically minimizing grid power dependency. Furthermore, the framework revealed a major decline in operational costs by $\mathbf{2 0\%}$ while user charging expenses dropped by 15%. As it pertains to cybersecurity, the framework demonstrated a 95% success rate in detecting data manipulation attacks and achieved a rapid recovery time of 30 seconds for DoS incidents. By introducing an inclusive framework that combines viable energy, economic efficiency, and a resilient cybersecurity presence, this study is able to contribute to the enhancement of EV charging infrastructure. The findings provide valuable insights into the design and performance of future-proof and durable EV charging networks, by assisting in the transition towards a more sustainable and efficient transportation environment.},
 author = {Anderson, Bryan and Hossain, Gahangir},
 booktitle = {2025 IEEE 4th International Conference on AI in Cybersecurity (ICAIC)},
 doi = {10.1109/ICAIC63015.2025.10849165},
 issn = {},
 keyword = {Resistance;Measurement;Renewable energy sources;Costs;Transportation;Electric vehicle charging;Computer security;Optimization;Testing;Genetic algorithms;Electric Vehicle Charging Networks;Renewable Energy Integration;Bald Eagle Search Algorithm (BESA);Cybersecurity Resilience;Critical Cyberinfrastructure;Optimization Framework;Anomaly Detection;Energy Utilization Metrics},
 month = {Feb},
 number = {},
 pages = {1-6},
 title = {Electronic Vehicle Charging and the Security Challenges of Renewable Energy Integration: An Optimization Framework},
 volume = {},
