@inproceedings{5495012,
 abstract = {In this paper we investigate random forest based language model adaptation. Large amounts of out-of-domain data are used to grow the decision trees while very small amounts of in-domain data are used to prune them back, so that the structure of the trees are suitable for the desired domain while the probabilities in the tree nodes are reliably estimated. Extensive experiments are carried out and results are reported on a particular task of adapting Broadcast News language model to the MIT computer science lecture domain. We show 0.80% and 0.60% absolute WER improvement over language model interpolation and count merging techniques, respectively.},
 author = {Deoras, Anoop and Jelinek, Frederick and Su, Yi},
 booktitle = {2010 IEEE International Conference on Acoustics, Speech and Signal Processing},
 doi = {10.1109/ICASSP.2010.5495012},
 issn = {2379-190X},
 keyword = {Adaptation model;Natural languages;Decision trees;Merging;History;Interpolation;Broadcasting;Computer science;Training data;Speech processing;Random Forests;Language Modeling;Adaptation},
 month = {March},
 number = {},
 pages = {5198-5201},
 title = {Language model adaptation using Random Forests},
 volume = {},
 year = {2010}
}
