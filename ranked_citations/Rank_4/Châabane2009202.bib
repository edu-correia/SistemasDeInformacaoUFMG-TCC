@conference{Châabane2009202,
 abstract = {In this paper, we present a methodology for merging geographic ontologies. The entry point of the proposed methodology is two geographical ontologies, it consists of three phases. The first phase is to establish a process of matching candidate ontologies. The outcome of this phase is a list of matching functions. The second phase is to find correspondences between concepts of candidate ontologies. The outcome of this phase is two lists: a list of matches and a list of unrelated concepts. The third phase is merging. The merging process is based on rules and produces as result a global ontology spatially and semantically richer. ©2009 IEEE.},
 author = {Châabane, Sana and Jaziri, Wassim and Gargouri, Faïez},
 doi = {10.1109/CTIT.2009.5423116},
 journal = {Proceedings of the 2009 International Conference on the Current Trends in Information Technology, CTIT 2009},
 note = {Cited by: 3},
 pages = {202 - 207},
 publication_stage = {Final},
 source = {Scopus},
 title = {A proposal for a geographic ontology merging methodology},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77951123303?origin=resultslist},
 year = {2009}
}
