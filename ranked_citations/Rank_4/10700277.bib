@inproceedings{10700277,
 abstract = {In collaborative software development, pull requests are widely used to integrate changes into the latest version of the software. In previous work, we proposed and validated a methodology to optimize the pull request integration process regarding merge conflicts resolution. In this work, we present the design and initial implementation of a prototype pull request integration process optimization tool called IPOptimizer. IPOptimizer takes as input the opened pull requests targeted to a specific branch and returns a sequence of pull requests groups that optimizes the integration process. Preliminary studies have shown that IPOptimizer is capable of optimizing the pull requests integration process considering the integration processes that were carried out in the history of the project.},
 author = {Olmedo, Agustín and Barbeito, Lucas},
 booktitle = {2024 L Latin American Computer Conference (CLEI)},
 doi = {10.1109/CLEI64178.2024.10700277},
 issn = {2771-5752},
 keyword = {Collaborative software;Prototypes;Software;History;Optimization;Collaborative Software Development;Pull-based Development;Pull Request;Software Merging;Merge Conflicts},
 month = {Aug},
 number = {},
 pages = {1-4},
 title = {IPOptimizer: A Tool to Optimize the Pull Request Integration Process},
 volume = {},
 year = {2024}
}
