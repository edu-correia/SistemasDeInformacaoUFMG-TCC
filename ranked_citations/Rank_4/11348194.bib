@inproceedings{11348194,
 abstract = {This paper presents a novel end-to-end decision-making framework for autonomous vehicle on-ramp merging that fuses multi-modal sensor data in a single neural network. An expert agent guides data collection in the CARLA simulator to build a synchronized dataset of RGB camera, dynamic vision sensor (DVS), and semantic-segmentation images paired with ground-truth control commands. A convolutional block attention (CBA) module applies channel and spatial attention to each sensor stream, producing refined feature maps that are concatenated and reduced via multi-branch fusion and dimensionalityreduction layers. The fused representation is decoded into continuous steering and acceleration commands and trained by minimizing a mean squared error loss. Evaluation on single merging scenario demonstrates that the proposed end-to-end (E2E) model improved safety, efficiency and comfort performance, and superior overall driving scores and driving penalty factors compared to hierarchical and hybrid baselines.},
 author = {Ma, Ning and Chen, Yu and Zhang, Ying and Song, Shuo and Yuan, Wencheng and Wen, Yuntao},
 booktitle = {2025 9th CAA International Conference on Vehicular Control and Intelligence (CVCI)},
 doi = {10.1109/CVCI66304.2025.11348194},
 issn = {},
 keyword = {Merging;Decision making;Neural networks;Vision sensors;Streaming media;Safety;Synchronization;Voltage control;Vehicle dynamics;Autonomous vehicles;End-to-end model;on-ramp merging;multi-sensor fusion;convolutional block attention;decision making},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {End-to-End On-Ramp Merging Decision-Making for Autonomous Driving},
 volume = {},
 year = {2025}
}
