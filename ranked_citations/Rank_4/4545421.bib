@inproceedings{4545421,
 abstract = {Tri-gate MuGFET (Multi-Gate FET) offers advantages compared to bulk silicon, with respect to circuit design, but also has some potential drawbacks in thermal effects and width quantization. An advantage of MuGFET is that with the same processing it is possible to make planar SOI structures, which, depending upon the active silicon thickness, may be fully or partially depleted. This work investigates circuit operation on a merged MuGFET and planar SOI process.},
 author = {Marshall, Andrew and Cleavelin, C. Rinn and Weize Xiong and Pacha, Christian and Knoblinger, Gerhard and Von Armin, Klaus and Schulz, Thomas and Schruefer, Klaus and Matthews, Ken and Molzer, Wolfgang and Patruno, Paul and Russ, Christian},
 booktitle = {2007 IEEE International SOC Conference},
 doi = {10.1109/SOCC.2007.4545421},
 issn = {2164-1706},
 keyword = {Silicon;MOS devices;FETs;Circuit synthesis;Hydrogen;Annealing;History;Doping;Instruments;Quantization},
 month = {Sep.},
 number = {},
 pages = {39-42},
 title = {A merged MuGFET and planar SOI process},
 volume = {},
 year = {2007}
}
