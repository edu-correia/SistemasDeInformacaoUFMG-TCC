@inproceedings{11448607,
 abstract = {The financial services sector finds itself at a crucial juncture where rapid digital transformation has drastically altered both operational processes and security vulnerabilities. The merging of conventional banking infrastructure with cloud-based fintech solutions, algorithmic trading platforms, and interconnected cyber-physical systems has resulted in exceptional efficiency gains, while simultaneously expanding the threat landscape in ways that typical security protocols struggle to address. This research gap has inspired the development of AIM-XDR, an advanced neuro-symbolic Extended Detection and Response (XDR) framework tailored specifically for the integrated financial-cyber landscape. This strategy satisfies the essential need for a thorough, adaptable, and transparent defense mechanism against hybrid threats through the integration of advanced multi-agent AI techniques, strong explainability frameworks, comprehensive data governance, ongoing feedback loops, and sophisticated threat modeling capabilities. The aim of this framework is to bridge the significant gaps in the cybersecurity strategies of financial institutions, targeting the disconnect between academic progress and real-world application. This paper outlines a case study of a banking organization with a vast customer network and high transaction activity that encounters various cyber threats, such as AI-driven fraud, lateral movement, polymorphic malware, and synthetic identity fraud. The findings reveal considerable, conceptually comparative, and evaluative benchmarking improvements regarding detection precision, resilience, and adherence to regulations within this framework, thereby establishing a solid foundation for the security of financial ecosystems in the future.},
 author = {Singh, Sneh and Joshi, Preksha and Shah, Ramya},
 booktitle = {2025 2nd International Conference on Recent Trends in Electrical, Electronics and Computing Technologies (ICRTEECT)},
 doi = {10.1109/ICRTEECT67512.2025.11448607},
 issn = {},
 keyword = {Ecosystems;Organizations;Computer architecture;Cyber-physical systems;Benchmark testing;Real-time systems;Malware;Fraud;Engines;Resilience;Artificial Intelligence;Cyber Defense;Financial Organizations;Machine learning},
 month = {Oct},
 number = {},
 pages = {1-7},
 title = {A Neuro-Symbolic Multi-Agent Framework for Adaptive Threat Detection in Financial Cyber-Physical Systems},
 volume = {},
