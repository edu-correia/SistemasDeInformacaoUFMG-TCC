@inproceedings{11103015,
 abstract = {Helmet object detection is an important task for safety. Existing methods all aim to design a new network to extract better visual features. However, because of the high similarity between helmets and heads, only visual features are not enough. In this paper, we present a novel method, which merges language's semantic information for better performance. Specifically, we first use CLIP to extract the feature vectors of objects. Then, feature vectors are calculated the attention with feature maps from detection models such as YOLOv5 for feature enhancement. Experiments show that our method can get better performance on the SHED and SHDD datasets. Our method improves +1.6% and 2.3% mAP on SHED and SHDD datasets, respectively.},
 author = {Ji, Wenguang},
 booktitle = {2025 6th International Conference on Computer Engineering and Application (ICCEA)},
 doi = {10.1109/ICCEA65460.2025.11103015},
 issn = {2159-1288},
 keyword = {YOLO;Deep learning;Visualization;Computer vision;Head;Computational modeling;Semantics;Feature extraction;Vectors;Safety;deep learning;computer vision;object detection;attention;language model},
 month = {April},
 number = {},
 pages = {1527-1530},
 title = {Language Guided Helmet Object Detection},
 volume = {},
 year = {2025}
}
