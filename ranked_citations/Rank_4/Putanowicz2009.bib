@article{Putanowicz2009,
 abstract = {This paper discusses some technical aspects of building software tools for manipulating geometries and meshes. An approach based on the use of Python scripting language is advocated by showing how it can be used to merge openNURBS geometric library, Geompack++ mesh generator and a simple pre- and post-processing tool based on xfig program. Efficient creation of interfaces is achieved by using SWIG interface generator. The paper shows the details of using SWIG to provide "pythonic" interface to openNURBS library. Other non-trivial issue shown in this paper is embedding the Python interpreter in the xfig program. © Civil-Comp Press, 2009.},
 author = {Putanowicz, R.},
 journal = {Civil-Comp Proceedings},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integration of OpenNURBS, MOAB and geompack++ with a python interpreter},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84894141441?origin=resultslist},
 volume = {90},
 year = {2009}
}
