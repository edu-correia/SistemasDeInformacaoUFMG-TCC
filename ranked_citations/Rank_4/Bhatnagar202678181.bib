@article{Bhatnagar202678181,
 abstract = {As enterprise software systems transition toward rapid delivery cycles, traditional branching models often introduce significant merge choreography and environment-specific bottlenecks that hinder developer velocity. This paper presents a novel, single-Main streamlined branching strategy designed for high-compliance enterprise payment portals. Implemented within an AdonisJS and Google Cloud Platform (GCP) ecosystem, the proposed methodology moves beyond legacy environment-based models by leveraging a single long-lived branch synchronized with automated GitLab CI/CD pattern matching. This approach effectively decouples development testing from release stabilization by using temporary release branches, enabling parallel User Acceptance Testing (UAT) without interrupting the primary delivery pipeline. The framework is operationalized through a GitLab CI/CD pipeline featuring manual authorization gates, ensuring rigorous auditability for production releases. Empirical data gathered over a 12-month production evaluation involving a team of 5-8 developers reveal significant performance gains, including a 71.7% reduction in the incidence of merge conflicts and a 70.8% improvement in the autonomy of deployment. Furthermore, the strategy enabled a 181.0% increase in deployment frequency, moving from a legacy baseline of 6.3 to 17.7 deployments per month. By formalizing the orchestration between branch patterns and cloud-native infrastructure within a regulated case context, this empirical study provides actionable insights for maintaining high-frequency delivery in high-compliance ecosystems. These localized findings validate the practical utility of pragmatic DevOps theories and offer a contextualized blueprint for streamlined application delivery in regulated environments.  © 2013 IEEE.},
 author = {Bhatnagar, Gaurav},
 doi = {10.1109/ACCESS.2026.3694956},
 journal = {IEEE Access},
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 pages = {78181 - 78190},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Policy-Driven Branching and Environment Isolation Strategy for Enterprise DevSecOps: An Empirical Industrial Case Study},
