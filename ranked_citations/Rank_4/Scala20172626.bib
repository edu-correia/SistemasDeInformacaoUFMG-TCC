@conference{Scala20172626,
 abstract = {This paper deals with the improvement of the robustness of heuristic solutions for aviation systems affected by uncertainty when the resolution of conflicts is implemented. A framework that includes the use of optimization and simulation is described which in turn generates pseudo-optimal schedules. The initial solution is progressively improved by iteratively evaluating the uncertainty in the generated solutions and calibrating in accordance with the objective function. Simulation is used for testing the feasibility of a solution generated by an optimization algorithm in an environment characterized by uncertainty. The results show that the methodology is able to improve solutions for the scenarios with uncertainty, thus making them excellent candidates for being implemented in real environments. © 2017 IEEE.},
 author = {Scala, Paolo and Mujica, Miguel and Delahaye, Daniel},
 doi = {10.1109/WSC.2017.8247989},
 journal = {Proceedings - Winter Simulation Conference},
 note = {Cited by: 4; All Open Access; Green Open Access},
 pages = {2626 - 2637},
 publication_stage = {Final},
 source = {Scopus},
 title = {A down to earth solution: Applying a robust simulation-optimization approach to resolve aviation problems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85044538195?origin=resultslist},
 year = {2017}
}
