@article{Strickert200539,
 abstract = {The recent merging self-organizing map (MSOM) for unsupervised sequence processing constitutes a fast, intuitive, and powerful unsupervised learning model. In this paper, we investigate its theoretical and practical properties. Particular focus is put on the context established by the self-organizing MSOM, and theoretic results on the representation capabilities and the MSOM training dynamic are presented. For practical studies, the context model is combined with the neural gas vector quantizer to obtain merging neural gas (MNG) for temporal data. The suitability of MNG is demonstrated by experiments with artificial and real-world sequences with one- and multi-dimensional inputs from discrete and continuous domains. © 2004 Elsevier B.V. All rights reserved.},
 author = {Strickert, Marc and Hammer, Barbara},
 doi = {10.1016/j.neucom.2004.11.014},
 journal = {Neurocomputing},
 note = {Cited by: 105},
 number = {1-4 SPEC. ISS.},
 pages = {39 - 71},
 publication_stage = {Final},
 source = {Scopus},
 title = {Merge SOM for temporal data},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/15844418774?origin=resultslist},
 volume = {64},
 year = {2005}
}
