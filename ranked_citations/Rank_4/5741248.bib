@inproceedings{5741248,
 abstract = {PDG-based code clone detection is suitable for detecting on-contiguous code clones while other detection techniques, line-, token-, or AST-based techniques are not. However, PDG-based detection has lower performance for detecting contiguous code clones than the other techniques. Moreover, PDG-based detection is time consuming, so that application to actual software systems is not feasible. The present paper proposes PDG specializations and detection heuristics for enhancing PDG-based code clone detection. The experiment in this paper shows that the proposed methods are effective for PDG-based code clone detection by applying them to 4 open source systems.},
 author = {Higo, Yoshiki and Kusumoto, Shinji},
 booktitle = {2011 15th European Conference on Software Maintenance and Reengineering},
 doi = {10.1109/CSMR.2011.12},
 issn = {1534-5351},
 keyword = {Cloning;Merging;Computational efficiency;Software systems;Image edge detection;Information science;Computational complexity;code clone;program dependency graph},
 month = {March},
 number = {},
 pages = {75-84},
 title = {Code Clone Detection on Specialized PDGs with Heuristics},
 volume = {},
 year = {2011}
}
