@inproceedings{11229640,
 abstract = {Multiplayer Online Battle Arena (MOBA) games, such as Mobile Legend, are competitive games with defined rules, immersive environments, and complex skills played in teams. The intense games caught the interest of advertisers, professional gaming leagues, and media outlets, developing a multimillion-dollar industry. In this competitive landscape, selecting the right hero plays a crucial role in achieving victory. This study aims to support the decision-making process by generating hero recommendations to counter the enemy team by enhancing a Large Language Model (LLM) using Retrieval-Augmented Generation (RAG). RAG-based retrieval techniques, such as Window Sliding and Auto-merging, were implemented to mitigate hallucinations and out-of-context responses by analyzing match history, hero attributes, and game strategies. The proposed approach used the GPT-4.0 mini transformer model with various parameter configurations. The performance and consistency of the recommendations were evaluated using the Jaccard Similarity and Standard Deviation metrics. The result indicates that the best performance of the retrieval-based method outperforms the baseline model without RAG by 10.45 times for Auto-merging and 8.82 times for Window Sliding approach. These findings highlight the effectiveness of structured retrieval in enhancing recommendation efficiency and provides insights for LLM-based recommendation systems, especially in MOBA games.},
 author = {Aswie, Annastasia and Christina and Putri, Diva Amanda and Hidayaturrahman},
 booktitle = {2025 IEEE International Conference on Artificial Intelligence and Mechatronics Systems (AIMS)},
 doi = {10.1109/AIMS66189.2025.11229640},
 issn = {},
 keyword = {Adaptation models;Large language models;Retrieval augmented generation;Decision making;Games;Metadata;Transformers;Real-time systems;Recommender systems;Standards;large language model;retrieval-augmented generation;window sliding;auto-merging;artificial intelligence},
 month = {May},
 number = {},
 pages = {1-6},
 title = {From Despair to Victory: Optimizing Drafting with LLM-RAG Recommendations in MOBA Games},
 volume = {},
 year = {2025}
}
