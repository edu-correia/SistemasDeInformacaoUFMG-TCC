@article{BAKIR20181009,
 abstract = {In this paper an industrial project insight of the ongoing research and implementation activities of a German co-founded and cross-sectoral applied research project, called “Industry_Integrator”, will be delivered. This project merges the disciplines mechanical engineering, modern IT, tool manufacturing, polymer processing, food technology as well as academia and fosters Industry 4.0 solutions for SME. The conceptual design of the industry integration device itself serves as a quite handy and easy to use enabler for smart production, even in existing and outdated production systems or in rough environments. No integration towards DIN rail or even wiring is necessary, as essential data aggregation and evaluation is done decentralized at the spot of data origin. The Integrators themselves are connected via a unique communication protocol and are performing in a dynamic meshed network.},
 author = {Dennis Bakir and Robin Bakir and Florian Engels},
 doi = {https://doi.org/10.1016/j.promfg.2018.10.086},
 issn = {2351-9789},
 journal = {Procedia Manufacturing},
 keyword = {Retrofit, Digital Manufacturing, Industry 4.0, Smart Data, complexity management},
 note = {28th International Conference on Flexible Automation and Intelligent Manufacturing (FAIM2018), June 11-14, 2018, Columbus, OH, USAGlobal Integration of Intelligent Manufacturing and Smart Industry for Good of Humanity},
 pages = {1009-1014},
 title = {Industry_Integrator as retrofit solution for digital manufacturing methods in existing industrial plants},
 url = {https://www.sciencedirect.com/science/article/pii/S2351978918312034},
 volume = {17},
 year = {2018}
}
