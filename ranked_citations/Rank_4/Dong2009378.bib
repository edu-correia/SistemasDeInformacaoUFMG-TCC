@conference{Dong2009378,
 abstract = {Due to having many benefits, P2P is attracting the attentions of industries and academia. Data sharing is one of the fields which P2P has been exploited in. However, data sharing in current P2P Systems is mostly restricted to file-system-like capabilities, and can't directly deal with relational data. Furthermore, under some situations, data integration methods in traditional database field can't carry out. The merge of P2P and database technology provides a new approach to solving the problem. In this paper, firstly we present the backgrounds of the emergence of PDBS (P2P Database System). Secondly, we give an overview of related work. Then we simply review P2P technology form the aspects of character and overlay network's classification, and analyze the similarities and differences between PDBS and DDBS (Distributed Database System). We also present a PDBSprototype instance: PeerDB. © 2009 IEEE.},
 author = {Dong, Liu and Yue-long, Zhao},
 doi = {10.1109/NISS.2009.144},
 journal = {Proceedings - 2009 International Conference on New Trends in Information and Service Science, NISS 2009},
 note = {Cited by: 5},
 pages = {378 - 383},
 publication_stage = {Final},
 source = {Scopus},
 title = {Distributed Relational Data Sharing Based on P2P},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70449565182?origin=resultslist},
 year = {2009}
}
