@conference{Hester2006,
 abstract = {In this work we survey distributed systems that can provide group communications, including both existing commercial systems and proposed research systems. Distributed systems are compared across multiple architectural characteristics such as fault-tolerance, scalability, security, delivery guarantees, and management as well as contrasted against systems utilizing peer-to-peer systems, application-level multicast, and IP layer multicast. Comparing distributed systems which provide group communications is a step toward developing systems appropriate for military network-centric group communications where more research is needed. A secondary result is an attempt to merge group communications terminology between distributed systems, peer-to-peer, application-layer multicast and IP layer multicast.},
 author = {Hester, Jason and Yurcik, William and Campbell, Roy H.},
 doi = {10.1117/12.649007},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A survey and comparison of distributed systems for group communications suitable for network-centric warfare},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33747331653?origin=resultslist},
 volume = {6249},
 year = {2006}
}
