@conference{Al-Kamha200496,
 abstract = {We present a technique to group search-engine returned citations for person-name queries, such that the search-engine returned citations in each group belong to the same person. To group the returned citations, we use a multi-faceted approach that considers evidence from three facets: (1) attributes, (2) links, and (3) page similarity. Based on the three facets, we construct a relatedness confidence matrix for pairs of citations. We then merge pairs whose matching confidence value is above an empirically determined threshold. Experimental results from the implementation of our multi-faceted approach are promising. Copyright 2004 ACM.},
 author = {Al-Kamha, Reema and Embley, David W.},
 doi = {10.1145/1031453.1031472},
 journal = {Proceedings of the Interntational Workshop on Web Information and Data Management},
 note = {Cited by: 26},
 pages = {96 - 103},
 publication_stage = {Final},
 source = {Scopus},
 title = {Grouping search-engine returned citations for person-name queries},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/18744416559?origin=resultslist},
 year = {2004}
}
