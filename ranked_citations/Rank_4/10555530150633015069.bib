@article{10.5555/3015063.3015069,
 abstract = {Currently about 60% to 65% of servers on the internet run a version of Linux or Unix. Android, the world's most popular mobile operating system, is a Linux-based system; many devices run on the Linux kernel, and Linux skills are in demand in both industry and research. By allowing Computer Science students to graduate without exposure to this important platform, we are doing them a major disservice. This is not intentional - often small departments have to choose where to direct their limited resources, and procuring and setting up an infrastructure for a foundational Linux course may present a challenge. In this paper we describe our experience in offering such a course in our otherwise solidly Windows-based department. Our flexible course design offers students Linux experience from both the user and administrative sides. We also introduce version control using Git along with GitHub, another in-demand skill. Students also have the opportunity to learn how to work as a team on a challenging semester-long project using these tools. Our approach can be tailored to an institution's existing curricular goals, and without undue burden on the local IT infrastructure. The setup is very flexible and can be adopted as part of a separate module in a pre-existing class, e.g., in operating systems. We report on the results of our approach, what we learned, and what future changes we will make.},
 address = {Evansville, IN, USA},
 author = {Bonakdarian, Esmail},
 issn = {1937-4771},
 issue_date = {December 2016},
 journal = {J. Comput. Sci. Coll.},
 month = {December},
 number = {2},
 numpages = {8},
 pages = {34–41},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {A cost-effective multi-track introduction to Linux, Git and GitHub},
 volume = {32},
 year = {2016}
}
