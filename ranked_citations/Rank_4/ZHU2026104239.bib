@article{ZHU2026104239,
 abstract = {Collaborative decision-making (DM) between automated vehicles (AVs) in on-ramp merging scenarios and multiple vehicles on the main road is a highly challenging engineering task, which increases the dynamics, sustainability, and interactivity of the DM process significantly. Certainly, there are specific technical challenges in such highly dynamic and intensely interactive DM scenarios. These challenges involve enabling AVs to perform safe and reasonable driving behaviors similar to skilled human drivers, as well as to merge into the main road accurately and smoothly. Such capabilities also need extensive knowledge support. To further address these challenges, a distributed interactive DM method is proposed in this paper, which is based on rolling hierarchical games and belief estimation, and novel parallel virtual and real game dual systems are designed. The established game DM model is embedded with individualized and human-like driving characteristics, which can match different types of driver and passenger groups, and includes diverse driving requirements, specifically multiple safety, comfort, and timeliness. Meanwhile, the Perfect Bayesian Nash Equilibrium (PBNE) of each stage game in time-sequential rolling DM is solved, and the Pareto frontier for multi-objective DM is analyzed. The effectiveness of the proposed method in resolving potential conflicts between multiple vehicles and dealing with the safety DM problems in a continuous interactive manner is verified by experiments. The results indicate that AVs can successfully merge into the main road in complex scenarios. The proposed method improves the human-like consistency of intelligent DM and endows DM with individualized advantages. These advances provide support for the engineering application of advanced automated driving related technologies.},
 author = {Bing Zhu and Shizheng Jia and Jian Zhao and Jiayi Han and Dongjian Song and Zhicheng Chen and Peixing Zhang and Jinpeng Du},
 doi = {https://doi.org/10.1016/j.aei.2025.104239},
 issn = {1474-0346},
 journal = {Advanced Engineering Informatics},
 keyword = {Vehicle engineering, Automated vehicle, Interactive decision-making, Hierarchical game, Belief estimation, On-ramp merging},
 pages = {104239},
 title = {Distributed interactive decision-making based on hierarchical games with belief estimation for automated vehicles in on-ramp merging},
 url = {https://www.sciencedirect.com/science/article/pii/S1474034625011322},
 volume = {71},
 year = {2026}
}
