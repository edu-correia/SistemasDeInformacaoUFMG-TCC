@article{Williem2018928,
 abstract = {This paper presents a practical framework for occlusion-aware augmented reality application using visual-inertial RGB-D SLAM. First, an efficient visual SLAM framework with map merging based relocalization is introduced. When the pose estimation fails, a new environment map is generated. Then, a map merging is performed to merge the current and previous environment maps if a loop closure is detected. The framework is then integrated with the inertial information to solve the missing environment map problem. Camera pose is approximated using the angular velocity and translational acceleration value when the pose estimation fails. Experimental results show that the proposed method can perform well in the presence of missing pose. Finally, an occlusion-aware augmented reality application is built over the SLAM framework. © Springer International Publishing AG, part of Springer Nature 2018.},
 author = {Williem and Ivan, Andre and Seok, Hochang and Lim, Jongwoo and Yoon, Kuk-Jin and Cho, Ikhwan and Park, In Kyu},
 doi = {10.1007/978-3-319-77383-4_91},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {928 - 938},
 publication_stage = {Final},
 source = {Scopus},
 title = {Visual-inertial RGB-D SLAM for mobile augmented reality},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85047444903?origin=resultslist},
 volume = {10736 LNCS},
 year = {2018}
}
