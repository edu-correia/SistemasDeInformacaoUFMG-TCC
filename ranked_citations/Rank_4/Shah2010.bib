@conference{Shah2010,
 abstract = {Peer-to-peer (P2P) network is a robust and distributed architecture of sharing resources. Recently, several approaches have been proposed for P2P network over MANET. The existing approaches for unstructured P2P network (Gnutella) over MANET do not consider the merging of P2P networks which occurs due to nodes' limited radio range and their mobility. This paper designs three approaches to handle the merging of P2P networks for unstructured P2P network over mobile ad hoc network (MANET). These approaches are implicit application-layer (IAL), explicit application-layer (EAL) and explicit cross-layer (EXL) approaches. In IAL approach, the following property of Gnutella is used to merge P2P networks. In Gnutella, when the number of neighbor peers of a peer P drops lower than the lower bound value, the peer P starts to connect with other new neighbor peers. So during this phase in Gnutella over MANET, a peer may connect with neighbor peers of another P2P network partition. In EAL approach, one peer is used as a root-peer which identifies the P2P network. So when a peer detects more than one root-peer in the network, the peer invokes merging operation. In EXL approach, an address auto-configuration protocol is extended to merge the unstructured P2P networks over MANET. By simulation, we show that overall EXL approach outperforms other two approaches in term of routing overhead and false-negative ratio. ©2010 IEEE.},
 author = {Shah, Nadir and Qian, Depei},
 doi = {10.1109/ICUT.2010.5677833},
 journal = {2010 Proceedings of the 5th International Conference on Ubiquitous Information Technologies and Applications, CUTE 2010},
 note = {Cited by: 7},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cross-layer design for merging of unstructured P2Pp networks over MANET},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78751688736?origin=resultslist},
 year = {2010}
