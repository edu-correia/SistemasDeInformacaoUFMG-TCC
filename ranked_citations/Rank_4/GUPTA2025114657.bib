@article{GUPTA2025114657,
 abstract = {Corticobasal Degeneration (CBD) is a progressive atypical parkinsonian disorder that shares several clinical and pathological characteristics with Parkinson’s Disease (PD), the most common form of typical parkinsonism, often leading to misdiagnosis. Early and accurate differential diagnosis of CBD versus PD is essential for personalized treatment and improved patient outcomes. This study introduces DeepCBD, a deep learning framework that uses structural MRI to enable probabilistic classification of CBD in patients with parkinsonism. DeepCBD comprises two fusion-based transfer learning models: Merged ResNet and Vision Transformer (MResViT), which combines ResNet-50 and Vision Transformer features via simple concatenation, and Attentive Merged ResNet and Vision Transformer (MARViT), which uses attention mechanisms to better integrate local and global features. Both models were trained on data from two major neuroimaging cohorts—the Parkinson’s Progression Markers Initiative (PPMI) and the 4 Repeat Tauopathy Neuroimaging Initiative (4RTNI)—and validated on an independent external dataset from a government healthcare facility. To support clinical insights, the proposed models utilize Gradient-weighted Class Activation Mapping (Grad-CAM) and SHapley Additive exPlanations (SHAP) to visualize the brain regions and features influencing their predictions. These interpretability analyses highlight biologically plausible regions implicated in CBD pathology, thereby enhancing clinical confidence in the model outputs. Experimental results indicate that, due to its attention-based fusion mechanism, MARViT consistently outperforms the baseline MResViT model in terms of both accuracy and interpretability. The study presents a generalizable and interpretable tool for computer-aided differential diagnosis of CBD in parkinsonian disorders.},
 author = {Arshia Gupta and Deepti Malhotra},
 doi = {https://doi.org/10.1016/j.knosys.2025.114657},
 issn = {0950-7051},
 journal = {Knowledge-Based Systems},
 keyword = {Corticobasal degeneration, Parkinson’s disease, Attention mechanism, Vision transformer, Transfer learning},
 pages = {114657},
 title = {DeepCBD: Hybrid deep learning fusion models for differential diagnosis of corticobasal degeneration in atypical versus typical parkinsonism},
 url = {https://www.sciencedirect.com/science/article/pii/S095070512501696X},
 volume = {330},
 year = {2025}
}
