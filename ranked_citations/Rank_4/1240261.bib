@inproceedings{1240261,
 abstract = {An important goal of automated modeling is to provide computer graphics applications with high quality models of complex real-world scenes. Prior systems have one or more of the following disadvantages: slow modeling pipeline, applicability restricted to small scenes, no direct color acquisition, and high cost. We describe a hand-held scene modeling device that operates at five frames per second and that costs $2,000. The device consists of a digital video camera with 16 laser pointers attached to it. As the operator scans the scene, the pointers cast blobs that are detected and triangulated to provide sparse, evenly spaced depth samples. The frames are registered and merged into an evolving model, which is rendered continually to provide immediate operator feedback.},
 author = {Popescu, V. and Sacks, E. and Bahmutov, G.},
 booktitle = {Fourth International Conference on 3-D Digital Imaging and Modeling, 2003. 3DIM 2003. Proceedings.},
 doi = {10.1109/IM.2003.1240261},
 issn = {},
 keyword = {Layout;Laser modes;Computer graphics;Costs;Laser feedback;Application software;Digital cameras;Rendering (computer graphics);Computer science;Pipelines},
 month = {Oct},
 number = {},
 pages = {285-292},
 title = {The ModelCamera: a hand-held device for interactive modeling},
 volume = {},
 year = {2003}
}
