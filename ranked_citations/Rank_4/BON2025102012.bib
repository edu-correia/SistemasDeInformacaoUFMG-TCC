@article{BON2025102012,
 abstract = {Studying changes in land use land cover (LULC) and associated landscape structure is important for understanding the intricate interrelations between people and their environment. This is vital for sustainable landscape management policies and can help to mitigate current environmental challenges. This article attends to the complex human-environment interplay that has led to reconfiguration or transformation of the rural landscape in the Vjosa River Valley in Albania. A wealth of scholarly studies emphasises the need for a holistic understanding of these changes, although many of them are still trying to overcome the challenging gap between different knowledge systems and databases. Given these limitations, this article develops an intersectional methodology that merges quantitative big data from remote sensing (RS) with qualitative thick data from anthropological research. It highlights the complex interrelations between natural, historical, social, cultural, political and economic realms that lead to reconfigurations or transformations of landscape structure and the importance of analysing these entangled processes. The article establishes a knowledge base for monitoring, analyzing and interpreting LULC changes and makes a threefold contribution. It (a) describes the key entanglements that have reshaped rural landscape in the Vjosa Valley for almost 40 years; (b) develops the intersectional methodology of big and thick data; and (c) contributes to a comprehensive understanding of the realms that shape rural landscapes, emphasising the importance of considering the different knowledge systems needed to plan an integrated environmental governance.},
 author = {Nataša Gregorič Bon and Urša Kanjir and Liza Stančič},
 doi = {https://doi.org/10.1016/j.ssaho.2025.102012},
 issn = {2590-2911},
 journal = {Social Sciences & Humanities Open},
 keyword = {Land use land cover, Environmental changes, Landscape structure, Intersectional methodology, Anthropology, Remote sensing},
 pages = {102012},
 title = {Intersecting big and thick data: Approaching landscape changes in rural Vjosa River Valley, Albania},
 url = {https://www.sciencedirect.com/science/article/pii/S2590291125007405},
 volume = {12},
 year = {2025}
}
