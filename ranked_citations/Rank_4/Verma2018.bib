@conference{Verma2018,
 abstract = {In this paper, we discuss the problem of distributed learning for coalition operations. We consider a scenario where different coalition forces are running learning systems independently but want to merge the insights obtained from all the learning systems to share knowledge and use a single model combining all of their individual models. We consider the challenges involved in such fusion of models, and propose an algorithm that can find the right fused model in an efficient manner. © 2018 SPIE.},
 author = {Verma, Dinesh and Chakraborty, Supriyo and Calo, Seraphin and Julier, Simon and Pasteris, Stephen},
 doi = {10.1117/12.2304542},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 7; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An algorithm for model fusion for distributed learning},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85050215593?origin=resultslist},
 volume = {10635},
 year = {2018}
}
