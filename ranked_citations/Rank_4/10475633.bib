@inproceedings{10475633,
 abstract = {The development of an ontology to model a complex system involves the capture of information related to multiple perspectives of that system, such as its architecture, requirements, and development processes. Each of these perspectives is defined by its own structure of concepts and relationships. Because these structures may differ dramatically from and may be developed independently of each other, the system ontology must be modular. A further complication for complex system ontologies is they must allow for the representation of subsystems developed by multiple suppliers, in which each supplier delivers one or more components of the overall system. In this paper, we address these needs with a hierarchical ontology that has a common “core” but allows for extending that core with “overlay models” personalized to distinct objectives, design terminologies, and perspectives. While hierarchical ontologies are not new, and rely on other well-known concepts such as views over relational data, our work is unique in that it is the first to incorporate automated, comprehensive verification that ensures that development by diverse teams can proceed in parallel so that they will be semantically consistent with each other when merged.},
 author = {Moitra, Abha and Siu, Kit and Cuddihy, Paul and Russell, Daniel and Mertens, Eric and Archer, David and Quick, Kevin},
 booktitle = {2024 IEEE 18th International Conference on Semantic Computing (ICSC)},
 doi = {10.1109/ICSC59802.2024.00018},
 issn = {2472-9671},
 keyword = {Production systems;Terminology;Atmospheric modeling;Computational modeling;Semantics;Organizations;Ontologies;hierarchical ontology;semantic check;visualization},
 month = {Feb},
 number = {},
 pages = {77-80},
 title = {Enabling Development of an Extensible, Multi-Perspective Ontology},
 volume = {},
 year = {2024}
}
