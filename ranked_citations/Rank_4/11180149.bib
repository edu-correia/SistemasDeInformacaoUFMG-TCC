@article{11180149,
 abstract = {This paper presents a novel distributed vehicle platooning control and coordination strategy. We propose a distributed predecessor-follower CACC scheme that allows to choose an arbitrarily small inter-vehicle distance while guaranteeing no rear-end collisions occur, even in the presence of undetected cyber-attacks on the communication channels such as false data injection. The safety guarantees of the CACC policy are derived by combining a sensor-based ACC policy that explicitly accounts for actuator saturation, and a communication-based predictive term that has state-dependent limits on its control authority, thus containing the effects of an unreliable communication channel. An undetected attack may still however be able to degrade platooning performance. To mitigate it, we propose a tailored Kalman observer-based attack detection algorithm that initially triggers a switch from the CACC policy to the ACC policy. Subsequently, by relying on a high-level coordinator, our strategy allows to isolate a compromised vehicle from the platoon formation by reconfiguring the platoon topology itself. The coordinator can also handle merging and splitting requests. We compare our algorithm in an extensive simulation study against a state of the art distributed MPC scheme and a robust control scheme. We additionally extensively test our full method in practice on a real system, a team of scaled-down car-like robots. Furthermore, we share the code to run both the simulations and robotic experiments.},
 author = {Lyons, Lorenzo and Boldrer, Manuel and Ferranti, Laura},
 doi = {10.1109/TVT.2025.3614452},
 issn = {1939-9359},
 journal = {IEEE Transactions on Vehicular Technology},
 keyword = {Safety;Communication channels;Switches;Stability criteria;Sensors;Actuators;Topology;Robot kinematics;Merging;Collision avoidance;Platooning;distributed control;multi-robot systems;cyber-physical attack detection},
 month = {March},
 number = {3},
 pages = {3888-3903},
 title = {Distributed Attack-Resilient Platooning Against False Data Injection},
 volume = {75},
 year = {2026}
}
