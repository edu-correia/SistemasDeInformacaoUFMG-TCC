@article{7430102,
 abstract = {Multiobjective optimisation design procedures have shown to be a valuable tool for controller tuning applications, where it is difficult to find a desirable tradeoff between conflicting objectives. When considering a process that could be defined as a mechatronic device, performance of the control loop could be further improved by using a multidisciplinary optimisation approach. That is, an all in one optimisation, where control parameters as well as design parameters of the process are considered in the same optimisation problem. In this paper, we show an application of such approach merging multidisciplinary and multiobjective optimisation.},
 author = {Reynoso Meza, Gilberto and Sanchez, Helem Sabina and dos Santos Coelho, Leandro and Zanetti, Roberto},
 doi = {10.1109/TLA.2016.7430102},
 issn = {1548-0992},
 journal = {IEEE Latin America Transactions},
 keyword = {Optimization;Visualization;Mood;Mechatronics;Tuning;Process control;Silicon compounds;controller tuning;multicriteria decision making;Multidisciplinary optimisation;Multiobjective optimisation design},
 month = {Jan},
 number = {1},
 pages = {364-370},
 title = {Multidisciplinary optimisation in mechatronic systems: a comparative analysis with multiobjective techniques},
 volume = {14},
 year = {2016}
}
