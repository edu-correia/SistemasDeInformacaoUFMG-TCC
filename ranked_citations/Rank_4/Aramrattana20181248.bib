@article{Aramrattana20181248,
 abstract = {This paper is an experience report of team Halmstad from the participation in a competition organised by the i-GAME project, the Grand Cooperative Driving Challenge 2016. The competition was held in Helmond, The Netherlands, during the last weekend of May 2016. We give an overview of our car's control and communication system that was developed for the competition following the requirements and specifications of the i-GAME project. In particular, we describe our implementation of cooperative adaptive cruise control, our solution to the communication and logging requirements, as well as the high level decision making support. For the actual competition we did not manage to completely reach all of the goals set out by the organizers as well as ourselves. However, this did not prevent us from outperforming the competition. Moreover, the competition allowed us to collect data for further evaluation of our solutions to cooperative driving. Thus, we discuss what we believe were the strong points of our system, and discuss post-competition evaluation of the developments that were not fully integrated into our system during competition time. © 2000-2011 IEEE.},
 author = {Aramrattana, Maytheewat and Detournay, Jerome and Englund, Cristofer and Frimodig, Viktor and Jansson, Oscar Uddman and Larsson, Tony and Mostowski, Wojciech and Rodriguez, Victor Diez and Rosenstatter, Thomas and Shahanoor, Golam},
 doi = {10.1109/TITS.2017.2752359},
 journal = {IEEE Transactions on Intelligent Transportation Systems},
 note = {Cited by: 10},
 number = {4},
 pages = {1248 - 1261},
 publication_stage = {Final},
 source = {Scopus},
 title = {Team Halmstad Approach to Cooperative Driving in the Grand Cooperative Driving Challenge 2016},
 type = {Article},
