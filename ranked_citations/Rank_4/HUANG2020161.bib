@article{HUANG2020161,
 abstract = {The integration of biocatalysis with chemocatalysis combines the excellent selectivity of the former with the robust reactivity of the latter and offers many advantages, such as lower cost, higher yield, enhanced selectivity, as well as less waste generation. In spite of the challenge of incompatibilities between different classes of catalysts, recent advances in synthetic chemistry and biology provide ample opportunities for multistep cascade transformations that combine biocatalysis and chemocatalysis. Herein, we review recent progress in merging biocatalysis with chemocatalysis, highlighting selected examples of photo-/electricity-driven biotransformations and recently developed strategies for addressing the catalyst incompatibility issue.},
 author = {Xiaoqiang Huang and Mingfeng Cao and Huimin Zhao},
 doi = {https://doi.org/10.1016/j.cbpa.2020.02.004},
 issn = {1367-5931},
 journal = {Current Opinion in Chemical Biology},
 keyword = {Biocatalysis, Chemocatalysis, Cascade reactions, Synergistic effect},
 note = {Biocatalysis and Biotransformation ● Bioinorganic Chemistry},
 pages = {161-170},
 title = {Integrating biocatalysis with chemocatalysis for selective transformations},
 url = {https://www.sciencedirect.com/science/article/pii/S136759312030020X},
 volume = {55},
 year = {2020}
}
