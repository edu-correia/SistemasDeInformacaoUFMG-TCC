@inproceedings{4419749,
 abstract = {Tactical communications represent a critical skill set to military training at the individual service level and to the joint military community. As the complexity of the operational environment increases, the methods and devices employed to address tactical communications training follow suit. One mitigation approach incorporates simulation tools by merging live training elements with virtual, or simulated, training devices. Thus, integrating live and virtual components is particularly important to the tactical communications training domain. A logical step in the advancement of live-to-virtual (LV) communications is the development of a device capable of merging, managing, and allocating multiple requests for live radio resources in a dynamic live, virtual, constructive (LVC) configuration. This paper details the application of systems engineering principles and simulation-based design to the development of a prototype Integrated Live-to-Virtual Communications Server (ILVCS). A detailed discussion of the developmental approach and its impact upon cost, schedule, and technical risks is provided.},
 author = {Lackey, Stephanie J. and Harris, Jonathan T. and Malone, Linda C. and Nicholson, Denise M.},
 booktitle = {2007 Winter Simulation Conference},
 doi = {10.1109/WSC.2007.4419749},
 issn = {1558-4305},
 keyword = {Design engineering;Systems engineering and theory;Modeling;Virtual prototyping;Management training;Military communication;Merging;Resource management;Radio spectrum management;Costs},
 month = {Dec},
 number = {},
 pages = {1403-1409},
 title = {Blending systems engineering principles and simulation-based design techniques to facilitate military prototype development},
 volume = {},
 year = {2007}
}
