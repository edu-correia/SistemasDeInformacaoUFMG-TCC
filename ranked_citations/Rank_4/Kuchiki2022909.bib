@conference{Kuchiki2022909,
 abstract = {In this research, we deal with the coordination problem of Connected and Automated Vehicles (CAVs) at signal-free intersections. First, the problem is formulated to find the appropriate merge time for each CAV. Next, an optimal motion planning problem is formulated to find the control input (jerk) necessary to accurately achieve the given optimal merging time while minimizing the jerk and acceleration. We also present an analytical solution for this motion planning problem with inequality constraints on jerk and acceleration, which achieves both passenger comfort and reduced fuel consumption. Finally, the simulation results show the effectiveness of the proposed method.  © 2022 The Society of Instrument and Control Engineers - SICE.},
 author = {Kuchiki, Akira and Namerikawa, Toru},
 doi = {10.23919/SICE56594.2022.9905760},
 journal = {2022 61st Annual Conference of the Society of Instrument and Control Engineers of Japan, SICE 2022},
 note = {Cited by: 6},
 pages = {909 - 914},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cooperative Control of Connected and Automated Vehicles at Signal-free Intersections Considering Passenger Comfort},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85141193430?origin=resultslist},
 year = {2022}
}
