@inproceedings{8501475,
 abstract = {The paper describes the problem of collecting, merging, and sharing information from workshops and conference notes in order to achieve better cooperation between stakeholders, thus improving collaboration during product development. We provide an overview of apps for Android and iOS devices that can facilitate this problem. We tested these apps on their recognition of handwritten and printed text and their integration into existing services, but none of them met all desired requirements. We propose an approach that includes a self-adaptive part to improve handwritten text recognition as well as a context-sensitive part to facilitate the integration into existing systems in the context of the Smart RE framework.},
 author = {Mannov, Natalia and Lüders, Clara Marie and Kaznin, Alexey},
 booktitle = {2018 4th International Workshop on Requirements Engineering for Self-Adaptive, Collaborative, and Cyber Physical Systems (RESACS)},
 doi = {10.1109/RESACS.2018.00009},
 issn = {},
 keyword = {Conferences;Text recognition;Optical character recognition software;Smart phones;Google;Lenses;Handwriting recognition;text recognition, handwritten recognition, requirements engineering, self adaptive, context sensitive, collaborative, smart RE, smart devices, smartphone app, OCR},
 month = {Aug},
 number = {},
 pages = {20-23},
 title = {ReqVision: Digitising Your Analog Notes into Readable and Editable Data},
 volume = {},
 year = {2018}
}
