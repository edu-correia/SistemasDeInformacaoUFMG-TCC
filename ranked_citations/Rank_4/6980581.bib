 issn = {},
 keyword = {Robot sensing systems;Protocols;Computer architecture;Robot kinematics;Peer-to-peer computing;Software agents;surveillance;sensors;measurement and observation;distributed systems;geographic position;architecture;protocol;collective behaviour;Autonomous robot},
 month = {Sep.},
