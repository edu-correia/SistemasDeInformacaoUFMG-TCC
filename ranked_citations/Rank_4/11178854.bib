@inproceedings{11178854,
 abstract = {Intelligent and precise traffic safety evaluations are essential for developing next-generation smart traffic management systems. While accident-based methods suffer from the rare and random nature of traffic accidents, traffic conflict techniques provide a more effective alternative for evaluating traffic safety, as traffic conflicts occur more frequently and positively correlate with accident rates. However, traditional traffic conflict assessment methods fail in complex multi-lane interaction scenarios-such as cut-ins, merges, and overtakes-due to oversimplified vehicle models and the neglect of motion uncertainties. To address this gap, we propose a novel method for traffic conflict identification and severity assessment based on multi-vehicle trajectory predictions. This method utilizes a Graph Neural Network (GNN)-based intention-aware trajectory prediction model that accounts for lane change intention, the influence from neighbor vehicles, and the uncertainty in future vehicle motions to forecast the trajectories of vehicles. Using predicted information, we calculate the collision probabilities and assess potential risks among nearby vehicles to identify the traffic conflict. The efficacy of our proposed method is demonstrated through a series of cut-in interaction simulations using the CARLA simulator. The trajectory prediction error is within 0.2m. Compared to other algorithms, our method significantly improves conflict identification accuracy and computational efficiency.},
 author = {Guo, Zixuan and Wang, Ruoyu and Han, Bingxin and Ding, Wendi and Zhao, Zuoquan and Chen, Xi and Chen, Ben M.},
 booktitle = {2025 44th Chinese Control Conference (CCC)},
 doi = {10.23919/CCC64809.2025.11178854},
 issn = {1934-1768},
 keyword = {Uncertainty;Computational modeling;Predictive models;Prediction algorithms;Graph neural networks;Trajectory;Safety;Computational efficiency;Next generation networking;Accidents;Smart traffic;traffic safety evaluation;traffic conflict;vehicle trajectory prediction},
 month = {July},
 number = {},
 pages = {6603-6608},
 title = {A Traffic Conflict Identification and Severity Assessment Method Based on Multi-Vehicle Trajectory Prediction},
