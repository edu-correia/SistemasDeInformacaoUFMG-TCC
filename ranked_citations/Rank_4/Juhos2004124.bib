@article{Juhos2004124,
 abstract = {This paper describes a novel representation and ordering model that, aided by an evolutionary algorithm, is used in solving the graph fc-colouring problem. Its strength lies in reducing the number of neighbors that need to be checked for validity. An empirical comparison is made with two other algorithms on a popular selection of problem instances and on a suite of instances in the phase transition. The new representation in combination with a heuristic mutation operator shows promising results. © Springer-Verlag 2004.},
 author = {Juhos, István and Tóth, Attila and Van Hemert, Jano I.},
 doi = {10.1007/978-3-540-24652-7_13},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 5},
 pages = {124 - 134},
 publication_stage = {Final},
 source = {Scopus},
 title = {Binary Merge Model Representation of the Graph Colouring Problem},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/35048904147?origin=resultslist},
 volume = {3004},
 year = {2004}
}
