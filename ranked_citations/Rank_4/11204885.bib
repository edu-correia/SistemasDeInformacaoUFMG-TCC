@inproceedings{11204885,
 abstract = {Accurate antenna array calibration is essential for radar systems, as precise gain and phase compensation are key to effective target detection and tracking. Traditional calibration techniques encounter challenges due to component aging, environmental influences, and operational wear, creating a need for auto-calibration methods that allow recalibration throughout the array's lifespan. This paper introduces a novel auto-calibration approach utilizing a Kalman filter to merge complex gain estimates from multiple calibration cycles. This method minimizes reliance on costly hardware while ensuring sustained performance. Simulation results highlight its effectiveness in improving calibration accuracy, a crucial factor for contemporary radar systems.},
 author = {Sansot, Grégoire and Négrier, Romain and Labarthe, Christophe and Menudier, Cyrille},
 booktitle = {2025 IEEE Radar Conference (RadarConf25)},
 doi = {10.1109/RadarConf2559087.2025.11204885},
 issn = {2375-5318},
 keyword = {Antenna measurements;Accuracy;Data integration;Radar;Radar antennas;Radar tracking;Calibration;Kalman filters;Arrays;Antenna arrays;antenna array;auto-calibration;data fusion;Kalman filter},
 month = {Oct},
 number = {},
 pages = {467-471},
 title = {Radar Auto-Calibration Using Kalman Filter Data-Fusion},
 volume = {},
 year = {2025}
}
