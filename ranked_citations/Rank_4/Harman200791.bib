@conference{Harman200791,
 abstract = {The public safety software industry is extremely fragmented; there are several hundred different dispatch systems alone in use in the United States today. All of these systems perform nearly identical functions from a user's perspective, but they all implement these functions and store the resulting data in their own fashion. This paper will examine a technique for sharing data between such systems for coordinated response to an emergency scenario or everyday events. Normalizing these data structures and functions into a common ontological dictionary and coordinating the mapping processes between the end systems and the dictionary ties these systems together. Once the mappings are established, care must be taken to resolve conflicts and merge items from different sources -Ontology Objects - that may in fact represent the same conceptual object (i.e. the same person) with an extreme minimum of false positives. These Ontology Objects must implement granular security, auditing, and redaction in order to reflect the sensitive nature of public safety data, and the potentially large number of constituencies owning different data sources. Finally, these items must be carefully synchronized as different users and processes manipulate them, and as these manipulations are persisted. © 2007 IEEE.},
 author = {Harman, Gregory},
 doi = {10.1109/THS.2007.370026},
 journal = {2007 IEEE Conference on Technologies for Homeland Security: Enhancing Critical Infrastructure Dependability},
 note = {Cited by: 0},
 pages = {91 - 94},
 publication_stage = {Final},
 source = {Scopus},
 title = {Data interoperability strategies for conceptually-similar disparate systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/34548805578?origin=resultslist},
 year = {2007}
}
