@inproceedings{5588762,
 abstract = {The fourth generation mobile network opens a challenge on existing charging and billing system. The main reason of that is using heterogeneous network. The present charging and billing system only supports interoperability of service providers of same country. In 4G Network, users will use various services, offered by service providers from different countries. So, it is necessary to design such a billing system that will allow integration of different services providers from different countries. In this paper a billing architecture, supporting multi service provider merging is proposed by means of intelligent network concepts.},
 author = {Rezbaul Islam, A.B.M. and Tae-Sun Chung},
 booktitle = {2010 Second International Conference on Communication Systems, Networks and Applications},
 doi = {10.1109/ICCSNA.2010.5588762},
 issn = {},
 keyword = {Radio access networks;Computational modeling;Computers;Wireless networks;Fourth Generation Mobile network;Intelligent Network;SIB;Billing and Charging},
 month = {June},
 number = {},
 pages = {105-108},
 title = {An efficient charging and billing architecture for 4G mobile network: Through intelligent network concepts},
 volume = {1},
 year = {2010}
}
