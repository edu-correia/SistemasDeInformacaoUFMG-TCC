@conference{Pathak2024,
 abstract = {In the dynamic world of software development, the need for efficient collaboration tools has never been more crucial. Imagine two developers, separated by distance but united by a coding challenge. Traditional remote collaboration methods often fall short of fostering real-time synergy for pair programming. This research introduces a solution, a real-time collaborative code editor utilizing Reactjs, material-ui, redux-toolkit, Nodejs, Docker, and Socket.IO. Beyond shared coding, The system integrates a live chat feature, creating an immersive workspace where developers can code and communicate simultaneously. The goal of this research is to break down barriers, enabling a seamless collaborative coding experience irrespective of physical distances.  © 2024 IEEE.},
 author = {Pathak, Hritik and Ritik, Harijan and Pawar, Rameshwar and Pingle, Yogesh},
 doi = {10.1109/ICKECS61492.2024.10617308},
 journal = {2024 International Conference on Knowledge Engineering and Communication Systems, ICKECS 2024},
 note = {Cited by: 3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {CodeFlow: Real-Time Collaborative Code Editor},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85201305118?origin=resultslist},
 year = {2024}
}
