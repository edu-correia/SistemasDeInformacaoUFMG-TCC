@conference{Navalho2015,
 abstract = {A CRDT is a data type specially designed to allow multiple instances to be replicated and modified without coordination, while providing an automatic mechanism to merge concurrent updates that guarantee eventual consistency. In this paper we present a brief study of computational CRDTs, a class of CRDTs whose state is the result of a computation over the executed updates. We propose three generic designs that reduce the amount of information that each replica maintains and propagates for synchronizations. For each of the designs, we discuss the properties that the function being computed needs to satisfy. © is held by the owner/author(s).},
 author = {Navalho, David and Duarte, Sérgio and Preguiça, Nuno},
 doi = {10.1145/2745947.2745948},
 journal = {Proceedings of the 1st Workshop on the Principles and Practice of Consistency for Distributed Data, PaPoC 2015},
 note = {Cited by: 3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A study of CRDTs that do computations},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84929379172?origin=resultslist},
 year = {2015}
}
