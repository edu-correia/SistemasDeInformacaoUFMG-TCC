@article{Ottoni2006864,
 abstract = {The generation of efficient addressing code is a central problem in compiling for processors with restricted addressing modes, like digital signal processors (DSPs). Offset assignment (OA) is the problem of allocating scalar variables to memory, so as to minimize the need of addressing instructions. This problem is called simple offset assignment (SOA) when a single address register is available, and general offset assignment (GOA) when more address registers are used. This paper shows how variables' liveness information can be used to dramatically reduce the addressing instructions required to access local variables on the program stack. Two techniques that make effective use of variable coalescing to solve SOA and GOA are described, namely coalescing SOA (CSOA) and coalescing GOA (CGOA). In addition, a thorough comparison between these algorithms and others described in the literature is presented. The experimental results, when compiling MediaBench benchmark programs with the LANCE compiler, reveal a very significant improvement of the proposed techniques over the other available solutions to the problem. © 2006, ACM. All rights reserved.},
 author = {Ottoni, Desiree and Ottoni, Guilherme and Araujo, Guido and Leupers, Rainer},
 doi = {10.1145/1196636.1196641},
 journal = {ACM Transactions on Embedded Computing Systems},
 note = {Cited by: 14},
 number = {4},
 pages = {864 - 883},
 publication_stage = {Final},
 source = {Scopus},
 title = {Offset Assignment Using Simultaneous Variable Coalescing},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/67249112878?origin=resultslist},
 volume = {5},
 year = {2006}
}
