@inproceedings{10742746,
 abstract = {In this paper, we discussed the project on credit card default prediction that uses MLOps principles to streamline the whole machine learning lifecycle, from the data preprocessing step and model training to the deployment of the pipeline and maintaining the pipeline. The major goal is to make an efficient and scalable pipeline that properly forecasts credit card defaulters, helping financial institutions with risk and decision-making processes. Our approach starts with developing a strong data preprocessing pipeline that handles various tasks like data cleaning, transformation, normalization, and dealing with imbalanced datasets using techniques like SMOTE (Synthetic Minority Over-sampling Technique). Multiple machine learning models, like Logistic Regression, Decision Trees, Random Forest, Gradient Boosting Machines, and Support Vector Machines (SVM), were trained and tested to search for the best-performing model. Hyperparameter adjustment and cross-validation improved the models performance, and SVM came as the best model. To achieve this we merged and deployed, the entire process in automated with Amazon Web Services (AWS). This included developing, implementing, and maintaining the pipeline on AWS infrastructure, using AWS SageMaker for model training and deployment, AWS Lambda for serverless computations, and AWS API Gateway to provide a single endpoint. The final system ensures real-time predictions by just entering user data in the web interface. The streamlined procedure allows users to predict the possibilities of credit card defaults with a single click, considerably increasing the operation's efficiency. This study highlights the effectiveness of MLOps methods in machine learning, guaranteeing that the delivered models are scalable, reliable, and maintainable. The successful working of this system shows its potential as a good and beneficial tool for financial organizations looking to reduce the risks connected with credit card default.},
 author = {Kumar, Abhishek and Tripathi, Rajnee},
 booktitle = {2024 First International Conference on Technological Innovations and Advance Computing (TIACOMP)},
 doi = {10.1109/TIACOMP64125.2024.00050},
 issn = {},
 keyword = {Support vector machines;Training;Technological innovation;Web services;Computational modeling;Pipelines;Data preprocessing;Credit cards;Real-time systems;Reliability;Credit Card Default Prediction;MLOps;AWS;Machine Learning Pipeline;Model Deployment;Data Preprocessing;Imbalanced Data Handling;SVM;and Real-Time Predictions},
 month = {June},
 number = {},
 pages = {250-255},
 title = {Automated Credit Card Default Prediction Using MLOps on AWS: From Pipeline Development to Real-Time Deployment},
 volume = {},
 year = {2024}
}
