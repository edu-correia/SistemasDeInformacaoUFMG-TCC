@article{Hannebauer2016322,
 abstract = {Newcomers are faced with contribution barriers when they want to join a Free/Libre and Open Source Software (FLOSS) project. Using wiki principles in software development has been proposed as one approach to lower contribution barriers. This approach requires a Wiki Development Environment (WikiDE), which is both a wiki and an Integrated Development Environment (IDE). This paper presents a Proof of Concept (PoC) realization of a WikiDE comprising three main components: a software forge, a Continuous Integration (CI) system, and a reviewer recommendation system. © 2016 The authors and IOS Press. All rights reserved.},
 author = {Hannebauer, Christoph and Gruhn, Volker},
 doi = {10.3233/978-1-61499-674-3-322},
 journal = {Frontiers in Artificial Intelligence and Applications},
 note = {Cited by: 1},
 pages = {322 - 332},
 publication_stage = {Final},
 source = {Scopus},
 title = {Implementation of a Wiki Development Environment},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84989199425?origin=resultslist},
 volume = {286},
 year = {2016}
}
