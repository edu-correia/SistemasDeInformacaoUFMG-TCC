@article{8418865,
 abstract = {To take full advantage of the considerably high reporting rate of phasor measurement units (PMU) data, this paper develops a novel PMU-based event detection methodology. Considering the huge amount of streaming PMU data, a data compression algorithm, swinging door trending (SDT), is first used to compress the PMU data and generate multiple compression intervals. Then, dynamic programming is utilized to solve the optimization problem, which is recursively constituted by a score function. Based on predefined PMU event rules, dynamic programming merges adjacent compression intervals with the same slope direction. Finally, all the PMU event features are characterized. A conventional wavelet-based event detection method is compared with the developed dynamic programming based SDT (DPSDT) method. Numerical simulations on the real-time and synthetic PMU data show that the DPSDT method can accurately detect the start-time of an event and the event placement with relatively high precision. Also, the PMU event features, including the magnitude and duration of strokes, are characterized.},
 author = {Cui, Mingjian and Wang, Jianhui and Tan, Jin and Florita, Anthony R. and Zhang, Yingchen},
 doi = {10.1109/TPWRS.2018.2859323},
 issn = {1558-0679},
 journal = {IEEE Transactions on Power Systems},
 keyword = {Phasor measurement units;Dynamic programming;Event detection;Voltage measurement;Frequency measurement;Power systems;Principal component analysis;Dynamic programming;phasor measurement unit (PMU);swinging door trending;wavelet},
 month = {Jan},
 number = {1},
 pages = {454-466},
 title = {A Novel Event Detection Method Using PMU Data With High Precision},
 volume = {34},
 year = {2019}
}
