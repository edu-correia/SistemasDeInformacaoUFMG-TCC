@conference{Nunes2017121,
 abstract = {Developers frequently rely on free static analysis tools to automatically detect vulnerabilities in the source code of their applications, but it is well-known that the performance of such tools is limited and varies from one software development scenario to another, both in terms of coverage and false positives. Diversity is an obvi-ous direction to take to improve coverage, as different tools usual-ly report distinct vulnerabilities, but this may come with an in-crease in the number of false alarms. In this paper, we study the problem of combining diverse static analysis tools to detect web vulnerabilities, considering four software development scenarios with different goals and constraints, ranging from low budget to high-end (e.g., business critical) applications. We conducted an experimental campaign with five free static analysis tools to detect vulnerabilities in a workload composed by 134 WordPress plugins. Results clearly show that the best solution depends on the development scenario. Furthermore, in some cases, a single tool performs better than the best combination of tools. © 2017 IEEE.},
 author = {Nunes, Paulo and Medeiros, Ibéria and Fonseca, José and Neves, Nuno and Correia, Miguel and Vieira, Marco},
 doi = {10.1109/EDCC.2017.16},
 journal = {Proceedings - 2017 13th European Dependable Computing Conference, EDCC 2017},
 note = {Cited by: 21; All Open Access; Green Open Access},
 pages = {121 - 128},
 publication_stage = {Final},
 source = {Scopus},
 title = {On Combining Diverse Static Analysis Tools for Web Security: An Empirical Study},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85041227205?origin=resultslist},
 year = {2017}
}
