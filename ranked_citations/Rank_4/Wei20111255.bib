@conference{Wei20111255,
 abstract = {Question and answer pairs in Community Question Answering (CQA) services are organized into hierarchical structures or taxonomies to facilitate users to find the answers for their questions conveniently. We observe that different CQA services have their own knowledge focus and used different taxonomies to organize their question and answer pairs in their archives. As there are no simple semantic mappings between the taxonomies of the CQA services, the integration of CQA services is a challenging task. The existing approaches on integrating taxonomies ignore the hierarchical structures of the source taxonomy. In this paper, we propose a novel approach that is capable of incorporating the parent-child and sibling information in the hierarchical structures of the source taxonomy for accurate taxonomy integration. Our experimental results with real world CQA data demonstrate that the proposed method significantly outperforms state-of-the-art methods. Copyright © 2011, Association for the Advancement of Artificial Intelligence. All rights reserved.},
 author = {Wei, Wei and Cong, Gao and Li, Xiaoli and Ng, See-Kiong and Li, Guohui},
 journal = {Proceedings of the National Conference on Artificial Intelligence},
 note = {Cited by: 6},
 pages = {1255 - 1260},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integrating community question and answer archives},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/80055053892?origin=resultslist},
 volume = {2},
 year = {2011}
}
