@article{Al_airaji2021138,
 abstract = {This paper presents a methodology for enhancement of panorama images environment by calculating high dynamic range. Panorama is constructing by merge of several photographs that are capturing by traditional cameras at different exposure times. Traditional cameras usually have much lower dynamic range compared to the high dynamic range in the real panorama environment, where the images are captured with traditional cameras will have regions that are too bright or too dark. A more details will be visible in bright regions with a lower exposure time and more details will be visible in dark regions with a higher exposure time. Since the details in both bright and dark regions cannot preserve in the images that are creating using traditional cameras, the proposed system have to calculate one using the images that traditional camera can actually produce. The proposed systems start by get LDR panorama image from multiple LDR images using SIFT features technology and then convert this LDR panorama image to the HDR panorama image using inverted local patterns. The results in this paper explained that the HDR panorama images that resulting from the proposed method is more realistic image and appears as it is a real panorama environment. © 2021, Institute of Advanced Engineering and Science. All rights reserved.},
 author = {Al_airaji, Roa'a M. and Aljazaery, Ibtisam A. and Al_dulaimi, Suha Kamal and Alrikabi, Haider Th. Salim},
 doi = {10.11591/eei.v10i1.2362},
 journal = {Bulletin of Electrical Engineering and Informatics},
 note = {Cited by: 64; All Open Access; Gold Open Access},
 number = {1},
 pages = {138 - 147},
 publication_stage = {Final},
 source = {Scopus},
 title = {Generation of high dynamic range for enhancing the panorama environment},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85090906426?origin=resultslist},
 volume = {10},
