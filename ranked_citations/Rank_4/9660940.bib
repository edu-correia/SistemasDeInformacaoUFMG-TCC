 keyword = {Boolean functions;Software libraries;Conferences;Merging;Data acquisition;Programmable logic arrays;Binary decision diagrams;binary decision diagram;Boolean function;left fold;linear fold;PLA benchmark;random linear fold;right fold;tree fold},
 month = {Sep.},
