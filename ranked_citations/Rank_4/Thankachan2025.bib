@conference{Thankachan2025,
 abstract = {The growing diversity of small and large language models (SLMs and LLMs) has led to the emergence of heterogeneous serving ecosystems, where optimal performance requires dynamic fusion, routing, and orchestration across multiple models. Existing approaches - such as model soups [1], mixture-of-experts architectures [2], and adaptive routing frameworks [3], [4] - address these challenges in isolation but lack a unified system that integrates parameter-space merging, decision-space routing, and cost-aware inference within a single composable architecture. We introduce slm-fusion, an open-source library that unifies model merging, routing, and serving under a modular, telemetry-driven framework. The system supports parameter-space fusion (ModelSoup, TIES-lite, LoRA merge), quantization-aware integration for int8/int4 models, and multi-level routing - including rule-based, learned, domain-specific, and cost-aware mechanisms. A FastAPI-based Fusion Gateway orchestrates speculative decoding, ensemble reranking, and mixture-of-agents flows, while telemetry and offline learning loops enable continual router optimization. The framework thus provides a comprehensive, practical path toward unified and transparent multi-model orchestration for language model inference. © 2025 IEEE.},
 author = {Thankachan, Karun},
 doi = {10.1109/ACOIT66109.2025.11436985},
 journal = {2nd Asian Conference on Intelligent Technologies, ACOIT 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {SLM-Fusion: A Unified Framework for Model Merging, Routing, and Multi-Model Orchestration},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105036126980?origin=resultslist},
 year = {2025}
}
