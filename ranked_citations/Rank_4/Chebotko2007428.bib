@article{Chebotko2007428,
 abstract = {Increasing amount of RDF data on the Web drives the need for its efficient and effective management. In this light, numerous researchers have proposed to use RDBMSs to store and query RDF annotations using the SQL and SPARQL query languages. The first few attempts at SPARQL-to-SQL translation revealed non-trivial challenges related to correctness and efficiency of such translation in the presence of nested optional graph patterns. In this paper, we propose to extend relational databases with a novel relational operator, nested optional join (NOJ), that is more efficient than left outer join in processing nested optional graph patterns. We design three efficient algorithms to implement the new operator in relational databases: (1) nested-loops NOJ algorithm, NL-NOJ, (2) sort-merge NOJ algorithm, SM-NOJ, and (3) simple hash NOJ algorithm, SH-NOJ. Based on a real life RDF dataset, we demonstrate the efficiency of our algorithms by comparing them with the corresponding left outer join implementations. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Chebotko, Artem and Atay, Mustafa and Lu, Shiyong and Fotouhi, Farshad},
 doi = {10.1007/978-3-540-72524-4_45},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 8},
 pages = {428 - 439},
 publication_stage = {Final},
 source = {Scopus},
 title = {Relational nested optional join for efficient semantic web query processing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/38049078778?origin=resultslist},
 volume = {4505 LNCS},
 year = {2007}
}
