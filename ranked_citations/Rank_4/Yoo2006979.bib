@article{Yoo2006979,
 abstract = {For having various applications, XML is widely used in various fields. But, there has not been a system to integrate and manage XML and its applications together. In this paper, we propose methods to integrate web-based XML applications(SMIL, RDF, WIDL) and for object-oriented modeling of each DTD and document instance. We propose a system to merge object modeling of XML applications. With the proposed integrating algorithm, we can not only easily analysis various web-based XML applications which are represented by complex tags, but also generate object-oriented schema for each document and store it to OODBMS. © Springer-Verlag Berlin Heidelberg 2006.},
 author = {Yoo, Chun-Sik and Kim, Jin-Sung and Kim, Yong-Sung and Shim, Jang-Sup},
 doi = {10.1007/11751649_107},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {979 - 989},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integrated object modeling for web-based XML application documents},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33745935659?origin=resultslist},
 volume = {3984 LNCS},
 year = {2006}
}
