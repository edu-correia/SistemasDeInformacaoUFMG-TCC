@conference{Bhardwaj2025224,
 abstract = {Traditional reactive strategies to application security are becoming less sufficient as organisations speed up software delivery using Agile and DevOps practices. The paper offers a comparative analysis of proactive and reactive security approaches in DevSecOps pipelines and focuses on the advantages of the so-called shift-left integration. By employing the real-world tools, including Veracode, Checkmarx, SonarLint, and GitGuardian, we developed two parallel CI/CD environments to compare the rate of vulnerability detection, Mean Time to Remediation (MTTR), developer productivity, and the impact in terms of how much money it would cost. The proactive team, assisted by IDE-integrated static analysis, software composition analysis (SCA), and secret detection, was always better than the reactive team, which worked with post-build scans and dynamic testing. It was found that proactive security took the total MTTR down by more than 60%, prevented more than 70% of vulnerabilities before the merge, and saved on remediation costs. The present study offers a blueprint of security integration throughout the different phases of SDLC and an easy-to-follow guideline on tool adoption and cultural change. Our observations show that proactive security is possible and vital to secure and scalable software delivery in the contemporary DevSecOps world.  © 2025 IEEE.},
 author = {Bhardwaj, Avdhesh Kumar and Anugula, Praveen and Ranjan, Piyush},
 doi = {10.1109/UPWIECON67212.2025.11390156},
 journal = {Proceedings of 1st IEEE Uttar Pradesh Section Women in Engineering International Conference on Electrical, Electronics and Computer Engineering, UPWIECON 2025},
 note = {Cited by: 0},
 pages = {224 - 228},
 publication_stage = {Final},
 source = {Scopus},
 title = {Proactive vs Reactive Application Security in DevSecOps: A Comparative Evaluation of Shift-Left Security Tools and Strategies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105036570358?origin=resultslist},
 year = {2025}
}
