@inproceedings{8606687,
 abstract = {In order to solve the multiple waypoints path planning problem in smart home environment, we adapt the optimal sampling-based algorithm (RRT*) [1] to deal with multiple waypoints navigation, namely Multi-RRT*. Our method constructs multiple trees from multiple waypoints, and these trees use simple extension and connection strategy. When all trees are merged to a single tree, an traversal path will be found. Along this path, mobile robot can visit all the waypoints one by one. We evaluate this method on a designed path planning benchmark scenario and compare with the basic and bias RRT*. Finally, we apply the proposed algorithm on Turtlebot2 with Robot Operate System (ROS) in smart home experimental environment. Simulation and experimental results demonstrate that our algorithm can converge quickly and has good performance in dealing with multiple waypoints path planning problem.},
 author = {Bai, Tian and Fan, Zhen and Liu, Meiqin and Zhang, Senlin and Zheng, Ronghao},
 booktitle = {2018 Ninth International Conference on Intelligent Control and Information Processing (ICICIP)},
 doi = {10.1109/ICICIP.2018.8606687},
 issn = {},
 keyword = {Vegetation;Path planning;Mobile robots;Planning;Runtime;Smart homes;Benchmark testing;Indoor mobile robot;multiple waypoints;path planning;RRT*},
 month = {Nov},
 number = {},
 pages = {53-58},
 title = {Multiple Waypoints Path Planning for a Home Mobile Robot},
 volume = {},
 year = {2018}
}
