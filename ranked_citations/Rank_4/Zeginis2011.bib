@article{Zeginis2011,
 abstract = {The ability to compute the differences that exist between two RDF/S Knowledge Bases (KB) is an important step to cope with the evolving nature of the SemanticWeb (SW). In particular, RDF/S deltas can be employed to reduce the amount of data that need to be exchanged and managed over the network in order to build SW synchronization and versioning services. By considering deltas as sets of change operations, in this article we introduce various RDF/S differential functions which take into account inferred knowledge from an RDF/S knowledge base. We first study their correctness in transforming a source to a target RDF/S knowledge base in conjunction with the semantics of the employed change operations (i.e., with or without side-effects on inferred knowledge). Then we formally analyze desired properties of RDF/S deltas such as size minimality, semantic identity, redundancy elimination, reversibility, and composability, as well as identify those RDF/S differential functions that satisfy them. Subsequently, we experimentally evaluate the computing time and size of the produced deltas over real and synthetic RDF/S knowledge bases. © 2011 ACM.},
 author = {Zeginis, Dimitris and Tzitzikas, Yannis and Christophides, Vassilis},
 doi = {10.1145/1993053.1993056},
 journal = {ACM Transactions on the Web},
 note = {Cited by: 35},
 number = {3},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {On computing deltas of RDF/S knowledge bases},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/80051932644?origin=resultslist},
 volume = {5},
 year = {2011}
}
