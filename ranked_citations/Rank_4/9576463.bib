@inproceedings{9576463,
 abstract = {The paper presents a concept of universal motion controller. The controller merges both position and force control into a single control structure. Therefore, it gives a possibility to use the same control algorithm, both for position tracking tasks as well as for the interaction force control. The universal motion controller can be used not only to make the interaction force track its reference, but also for the limiting of the interaction force, so that safety is ensured. This makes it very useful for human-robot interaction applications.},
 author = {Uzunovic, Tarik and Sabanovic, Asif},
 booktitle = {2021 IEEE 30th International Symposium on Industrial Electronics (ISIE)},
 doi = {10.1109/ISIE45552.2021.9576463},
 issn = {2163-5145},
 keyword = {Industrial electronics;Limiting;Tracking;Force;Position control;Switches;Safety;position/force control;motion control;universal motion controller},
 month = {June},
 number = {},
 pages = {1-6},
 title = {Universal Motion Controller},
 volume = {},
 year = {2021}
}
