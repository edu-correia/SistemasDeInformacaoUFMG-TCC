@conference{Raunich20111276,
 abstract = {The proliferation of ontologies and taxonomies in many domains increasingly demands the integration of multiple such ontologies to provide a unified view on them. We demonstrate a new automatic approach to merge large taxonomies such as product catalogs or web directories. Our approach is based on an equivalence matching between a source and target taxonomy to merge them. It is target-driven, i.e. it preserves the structure of the target taxonomy as much as possible. Further, we show how the approach can utilize additional relationships between source and target concepts to semantically improve the merge result. © 2011 IEEE.},
 author = {Raunich, Salvatore and Rahm, Erhard},
 doi = {10.1109/ICDE.2011.5767871},
 journal = {Proceedings - International Conference on Data Engineering},
 note = {Cited by: 56},
 pages = {1276 - 1279},
 publication_stage = {Final},
 source = {Scopus},
 title = {ATOM: Automatic target-driven ontology merging},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/79957864061?origin=resultslist},
 year = {2011}
}
