@inproceedings{8650455,
 abstract = {Recently, Joint Video Experts Team (JVET) has started the standardization of a new video coding named as Versatile Video Coding (VVC) with the aim of completing by 2020. In HEVC and VVC, each candidate list of Merge/AMVP (Advanced Motion Vector Prediction) is constructed from the motion information of spatial/temporal neighboring blocks to enhance the performance of inter predictive coding by utilizing available motion information. In this paper, we propose a method to derive candidate lists of Merge/AMVP with more reliable motion information having high correlation by considering the block shape of the current Coding Unit (CU). Experiment results show the performance of the proposed method in the reference SW codec of VVC named as VVC Test Model (VTM).},
 author = {Do, JiHoon and Park, Dohyeon and Kim, Jae-Gon and Jeong, Dae-Gwon},
 booktitle = {TENCON 2018 - 2018 IEEE Region 10 Conference},
 doi = {10.1109/TENCON.2018.8650455},
 issn = {2159-3450},
 keyword = {Video coding;Correlation;Codecs;Shape;Standardization;Predictive coding;Encoding;Vectors;Reliability;Videos;Versatile Video Coding (VVC);JVET;Merge;AMVP;VTM;JEM},
 month = {Oct},
 number = {},
 pages = {0215-0218},
 title = {Block-shape adaptive inter prediction candidate list in Versatile Video Coding},
 volume = {},
 year = {2018}
}
