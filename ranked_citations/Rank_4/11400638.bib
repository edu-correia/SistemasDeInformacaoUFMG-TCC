@article{11400638,
 abstract = {Collaborative mapping is crucial for cooperative autonomous mobile robots (AMRs) to build a shared understanding of their surrounding environments and enhance the efficiency of task execution. However, current collaborative mapping solutions suffer from the perceptual aliasing and data-association ambiguities in Global Navigation Satellite System (GNSS)-challenged degraded environments (i.e., repetitive or symmetric structures, such as office/hotel/hospital long corridors, industrial facilities, indoor warehouses, and long tunnels). The ambient magnetic field (MF) has exhibited ubiquity and high distinctiveness at different location regardless of the geometric features, which makes it suitable for positioning and detecting overlapping regions among the areas covered by multiple AMRs. This article bridges the gap between the ambient MF information that is yet to be utilized in AMRs’ collaborative tasks and the advancements of collaborative geometric mapping that solely depends on the fusion of geometry information. In this article, a novel Magnetic-aware Collaborative Mapping framework, namely MC-Mapping, is proposed to build consistent global maps in perceptually degraded environments. The key novelties of this work are the self-designed robot-oriented magnetic sensor suite for efficient magnetic sensing, adaptive magnetic sequence matching-based strategy for effective overlapping regions delimitation, and the systematic modeling of magnetic-aware collaborative mapping. At single AMR exploring phase, the local magnetic map and point cloud map are generated by fusing information from heterogeneous sensors. At collaborative AMRs rendezvous-triggered phase, local magnetic sequences are shared and matched to detect overlapping regions, then the transformation matrix is estimated and refined. Eventually, all local maps are shared for global map-merging. Evaluations on both high-fidelity simulations and real world experiments show the high quality of obtained global magnetic map and point cloud map, demonstrating the improved consistency and accuracy of collaborative mapping in challenging perceptually degraded environments.},
 author = {Wu, Zhenyu and Wang, Wei and Shen, Hongming and Lyu, Qiyang and Deng, Tianchen and Peng, Guohao and Zhou, Huiqin and Wang, Danwei},
 doi = {10.1109/TIE.2026.3658725},
 issn = {1557-9948},
 journal = {IEEE Transactions on Industrial Electronics},
 keyword = {Collaboration;Accuracy;Simultaneous localization and mapping;Point cloud compression;Magnetometers;Robots;Three-dimensional displays;Magnetosphere;Magnetic tunneling;Multi-robot systems;Autonomous robots;collaborative mapping;map merging;magnetic field (MF);multisensor fusion;repetitive features},
 month = {},
 number = {},
 pages = {1-13},
 title = {MC-Mapping: Magnetic-Aware Collaborative Mapping in Perceptually Degraded Environments},
 volume = {},
 year = {2026}
}
