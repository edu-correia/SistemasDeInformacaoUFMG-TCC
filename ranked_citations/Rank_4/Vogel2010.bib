@conference{Vogel2010,
 abstract = {Data Quality Web Services are services that enhance the quality of data in the sense of making it fit for use. This paper concentrates on duplicate detection, which identifies multiple representations of real-world objects within large datasets where these representations are similar to a certain degree. Measures to estimate this similarity are one of the major research efforts in the community since many years. However forWeb Services, these heuristics differ in the amount of underlaying meta information, which is usually much poorer. The type of missing meta data is analyzed and classified in this paper. It also examines on different ways of making the duplicate-containing data available to the Data Quality Web Service.},
 author = {Vogel, Tobias},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Self-adaptive data quality web services},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84870387285?origin=resultslist},
 volume = {581},
 year = {2010}
}
