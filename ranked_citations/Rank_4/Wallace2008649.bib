@conference{Wallace2008649,
 abstract = {In this paper, we describe an approach to automating payload configuration for USAF Cybercraft which leverages the Web Ontology Language (OWL), the SPARQL query language, and Extensible Stylesheet Language Transformations (XSLT). A general model of cybercraft (non-implementation specific) is defined in the OWL-DL sublanguage which describes Cybercraft payloads along with default configurations for those payloads. We leverage this general model to automatically generate payload configurations for a specific Cybercraft implementation, our Java Cybercraft Agent Framework (JCAF), by defining a small "utility ontology" that maps general model's property names to specific JCAF implementation property names. We then merge the two ontologies, and use SPARQL to query the combined ontology to retrieve a particular payload's property values along with the Java implementation's property names. We get the query result as XML, and post-process it using XSLT, which transforms it into the Java-style property format needed to configure the payload for the JCAF.},
 author = {Wallace, M. and Wheeler, A. and Winburn, M. and Dike, J. and Maxey, W.},
 journal = {Proceedings of the 2008 International Conference on Artificial Intelligence, ICAI 2008 and Proceedings of the 2008 International Conference on Machine Learning; Models, Technologies and Applications},
 note = {Cited by: 1},
 pages = {649 - 653},
 publication_stage = {Final},
 source = {Scopus},
 title = {Leveraging OWL-DL, SPARQL, and XSLT to automate USAF cybercraft configuration},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/62749159044?origin=resultslist},
 year = {2008}
}
