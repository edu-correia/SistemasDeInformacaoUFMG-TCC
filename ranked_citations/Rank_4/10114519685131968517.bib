@article{10.1145/1968513.1968517,
 abstract = {To support and engineer the spatial coordination of distributed pervasive services, we propose a chemical-inspired model, which extends tuple spaces with the ability of evolving tuples mimicking chemical systems, that is, in terms of reaction and diffusion rules that apply to tuples modulo semantic match. The suitability of this model is studied by considering a self-adaptive display infrastructure providing people nearby with several visualization services (advertisements, news, personal and social content). The key result of this article is that general-purpose chemical reactions inspired by population dynamics can be used in pervasive applications to enact spatial computing patterns of competition and gradient-based interaction.},
 address = {New York, NY, USA},
 articleno = {14},
 author = {Viroli, Mirko and Casadei, Matteo and Montagna, Sara and Zambonelli, Franco},
 doi = {10.1145/1968513.1968517},
 issn = {1556-4665},
 issue_date = {June 2011},
 journal = {ACM Trans. Auton. Adapt. Syst.},
 keyword = {Chemical-inspired computation, tuple spaces},
 month = {June},
 number = {2},
 numpages = {24},
 publisher = {Association for Computing Machinery},
 title = {Spatial Coordination of Pervasive Services through Chemical-Inspired Tuple Spaces},
 url = {https://doi.org/10.1145/1968513.1968517},
 volume = {6},
 year = {2011}
}
