@article{WANG2025167677,
 abstract = {Soft grippers struggle to mimic human sensory integration, where touch and vision synergize dynamically, a capability epitomized by the rubber-hand illusion. To replicate this bioinspired fusion, we present a neuromorphic framework combining a self-powered piezoionic hydrogel sensor with event-driven vision processing. The PVA/PEDOT:PSS/graphene hydrogel's hybrid ionic-electronic conduction resolves the static/dynamic sensing trade-off through three synergistic mechanisms: (1) PEDOT's ionic channels and graphene's electronic network enable rapid charge transport. (2) H+/SO₃− migration sustains static signals via charge delocalization. (3) Interfacial electric double-layer effects amplify outputs. This dual-timescale sensitivity is essential for cross-modal prediction, providing temporally diverse tactile inputs aligned with visual dynamics. Crucially, our system emulates the rubber-hand illusion's neural principles: event-based spike encoding of vision reduces tactile prediction errors by 87 %. The resulting visuo-tactile inference enables robots to “feel” touch from sight, a milestone in neuromorphic perception. By unifying material innovation with brain-like computation, this work pioneers embodied sensory fusion for adaptive robotics.},
 author = {Shuyu Wang and Haiqian Zhen and Hongsheng Zhao and Dingli Zhang and Hongxing Yue},
 doi = {https://doi.org/10.1016/j.cej.2025.167677},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {Piezoionic effect, Tactile sensors, Cross-modal prediction, Visual-tactile inference, Neuromorphic computing},
 pages = {167677},
 title = {Visual-tactile inference in soft grippers leveraging piezoionic hydrogels and neuromorphic computing},
 url = {https://www.sciencedirect.com/science/article/pii/S138589472508516X},
 volume = {522},
 year = {2025}
}
