@article{FRONCZEK2023375,
 abstract = {UCLA Health developed a system-wide in-house float team to meet organizational demands and strategic expansion, merging all facility float teams to create the nursing system float team (NSFT). The NSFT is designed as a centralized functional organizational structure that allows for systematic processes. In addition, the structure is designed to enable expansion into other areas with appropriate managerial oversight. As a result, contract labor dependence decreased by 45%, and self-reliance increased by 41%, providing a favorable operating margin. This article serves as a guide for external organizations to collaborate in developing a systematic approach for redeveloping staffing models.},
 author = {Adam Fronczek and Sharon Doggett and Gilbert Barco},
 doi = {https://doi.org/10.1016/j.mnl.2023.01.010},
 issn = {1541-4612},
 journal = {Nurse Leader},
 note = {June 2023},
 number = {3},
 pages = {375-379},
 title = {Strategies to Ensure Adequate Staffing and Self-Reliance in Times of Uncertainty},
 url = {https://www.sciencedirect.com/science/article/pii/S1541461223000393},
 volume = {21},
 year = {2023}
}
