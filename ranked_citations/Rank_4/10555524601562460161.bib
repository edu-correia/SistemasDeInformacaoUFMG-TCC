@article{10.5555/2460156.2460161,
 abstract = {Faculty, industry, and even students recognize that version control is essential for tracking and coordinating changes among contributors to a project. Indeed, many employers view job candidates with version control experience as more qualified. Despite its importance, faculty may avoid version control in the classroom for lack of time or experience, to the detriment of their students. This workshop gives participants experience in using version control with cloud project hosting services, but assumes no prior experience. We believe that workshop participants will gain enough skill to adopt version control on project hosting services for their courses.},
 address = {Evansville, IN, USA},
 author = {Lawrance, Joseph and Jung, Seikyung},
 issn = {1937-4771},
 issue_date = {June 2013},
 journal = {J. Comput. Sci. Coll.},
 month = {June},
 number = {6},
 numpages = {2},
 pages = {14–15},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Git on the cloud},
 volume = {28},
 year = {2013}
}
