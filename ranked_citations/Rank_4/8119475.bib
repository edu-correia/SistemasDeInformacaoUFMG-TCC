@inproceedings{8119475,
 abstract = {A constrained k nearest neighbors (k-NN) query retrieves a set of k nearest objects within a predefined region. Although there are many proposed methods dedicated for continuously monitoring k-NN queries, most of them concerning traditional k-NN queries, only some methods focus on constrained k-NN queries. In this paper, the authors propose MergedGrid, an algorithm to further enhance the performance of GridTree, a novel method for continuously monitoring constrained k-NN queries. Without the need of prior knowledge about the number of objects in the dataset, our algorithm significantly reduces computation time in comparison with the previous algorithm.},
 author = {Le Nguyen, Bao and Nguyen, Tri Quang-Minh and Dinh, Tien Ba},
 booktitle = {2017 9th International Conference on Knowledge and Systems Engineering (KSE)},
 doi = {10.1109/KSE.2017.8119475},
 issn = {},
 keyword = {Monitoring;Data structures;Urban areas;Merging;Computer science;Search problems;Spatial databases;Constrained kNN query;Continuous monitoring;Moving objects;Moving queries;Query processing},
 month = {Oct},
 number = {},
 pages = {298-303},
 title = {MergedGrid — An algorithm for continuous constrained k nearest neighbor monitoring},
 volume = {},
 year = {2017}
}
