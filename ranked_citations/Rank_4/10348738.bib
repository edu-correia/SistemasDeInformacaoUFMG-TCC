@inproceedings{10348738,
 abstract = {In this paper, we introduce a scalable, AI-driven chatbot designed for real-time diagnostics in Industry 4.0 manufacturing plants. By incorporating Google Dialogflow and a plant-specific knowledge graph, the chatbot enables seamless interaction with users while requiring minimal reconfiguration when adapting to new environments. The integration of BERT in the back-end empowers the chatbot to efficiently identify errors. Furthermore, a self-learning module continuously scans the manufacturing execution system (MES) database for new errors, generating learning data for the automatic re-training of the BERT-based neural network. Although there are opportunities for refinement, the chatbot exhibits significant potential as a scalable, supplementary first-line support system in the manufacturing sector.},
 author = {Ahaneku, Oguike and Siegl, Maximilian and Stromberger, Sarah and Vidrascu, Radu},
 booktitle = {2023 IEEE 12th International Conference on Intelligent Data Acquisition and Advanced Computing Systems: Technology and Applications (IDAACS)},
 doi = {10.1109/IDAACS58523.2023.10348738},
 issn = {2770-4254},
 keyword = {Training;Impedance matching;Neural networks;Merging;Knowledge based systems;Machine learning;Knowledge graphs;chatbot;manufacturing;self-learning;diagnostics},
 month = {Sep.},
 number = {},
 pages = {853-858},
 title = {A Scalable AI-Driven Chatbot for Real-Time Diagnostics in Manufacturing Plants: Merging Google Dialogflow, BERT, and a Self-Learning Module},
 volume = {1},
 year = {2023}
}
