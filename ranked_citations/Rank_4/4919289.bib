@inproceedings{4919289,
 abstract = {Due to the dasiayear 2007 problempsila (2007 is the beginning year when the baby-boomers reach the age of retirement), the need to plan for skill succession is now widely recognized in Japan. In addition, merge and acquisition (M&A) and overseas manufacturing are accelerating a necessity of enterprise knowledge management with ldquocommon languagerdquo. We are studying an intelligent information platform in the realm of production, named ldquoSKIPrdquo (self knowledge & information expansion). This paper shows overview of the ldquoSKIPrdquo and represents its semantic model-based repository as a fundamental part of production knowledge share. The issue on the enterprise information management for knowledge sharing can't be effectively addressed by single solution acting alone, but by combination of the possible technology and methodology. Consequently, SKIP is also our experimental station for intelligent manufacturing. Case study is on the implementation of SKIP and analysis of production reports in a metal press factory.},
 author = {Fujiwara, Reiko and Yokota, Nobuyuki and Shimano, Takafumi and Kushida, Daisuke and Kitamura, Akira},
 booktitle = {2009 International Conference on Networking, Sensing and Control},
 doi = {10.1109/ICNSC.2009.4919289},
 issn = {},
 keyword = {Production facilities;Information analysis;Continuous improvement;Navigation;Retirement;Virtual manufacturing;Accelerated aging;Knowledge management;Information management;Knowledge acquisition},
 month = {March},
 number = {},
 pages = {292-297},
 title = {Semantic model-based repository of production knowledge},
 volume = {},
 year = {2009}
}
