@article{SHEN2025112698,
 abstract = {Freeway merging areas are characterized by complex interactions between vehicles, requiring precise coordination to ensure smooth traffic flow. In mixed traffic environments, trajectory prediction for manual-driven vehicles (MVs) in merging areas plays a pivotal role in the decision-making and motion planning of autonomous vehicles (AVs), providing a reliable safeguard against merging conflicts. However, existing methods often overlook the non-Euclidean nature of vehicle interactions and lack adaptive attention to temporal dependencies, limiting long-term prediction accuracy. This study proposes a Spatial-Temporal Attention-based Interaction-aware (STAI) trajectory prediction model, which leverages historical trajectories to forecast MV motion. STAI integrates a Graph Attention Network (GAT) for dynamic spatial interactions and a Long Short-Term Memory network (LSTM) with Temporal Attention (TA-LSTM) for capturing time-varying features, enabling extraction of critical spatiotemporal cues. Two contextual features—lane label and lane change force—are introduced to encode lane structure and quantify mandatory merging urgency. Experiments on the Next Generation Simulation (NGSIM) Interstate 80 dataset show that STAI achieves a Root Mean Square Error (RMSE) of 3.75 m for 5-s predictions, representing a 15.15 % improvement over the baseline (Convolutional Social Long Short-Term Memory). It also maintains efficient inference with 0.055 s per sample. Error analyses in different traffic density scenarios, as well as experiments on other public datasets (NGSIM United States Route 101, Highway Drone) and local dataset, Suzhou Bay Bridge dataset, demonstrate the model generalization capability. By effectively modeling spatiotemporal interactions, the proposed method enhances trajectory prediction accuracy, contributing to safer autonomous driving in complex merging scenarios.},
 author = {Jiayan Shen and Xiang Wang and Wenjuan E. and Yong Luo and Yanyun Tao and Fangyu Feng},
 doi = {https://doi.org/10.1016/j.engappai.2025.112698},
 issn = {0952-1976},
 journal = {Engineering Applications of Artificial Intelligence},
 keyword = {Autonomous driving, Vehicle trajectory prediction, Freeway merging areas, Graph attention network, Spatiotemporal attention mechanism},
 pages = {112698},
 title = {Spatial-Temporal Attention-based Interaction-aware trajectory prediction for human-driven vehicles at freeway merging areas},
 url = {https://www.sciencedirect.com/science/article/pii/S0952197625027290},
 volume = {162},
 year = {2025}
}
