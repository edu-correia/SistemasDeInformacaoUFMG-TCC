@inbook{9866597,
 abstract = {The user mobility has been supported since the early generations of mobile cellular networks. Other types of mobile ad&#x2010;hoc networks (MANETs) evolved independently as the special purpose communication networks. The recent 5G revolution aims to merge all communication networks into one ubiquitous global network with a seamless integration of communication services that are transparent to the mobile end users and devices. This chapter reviews main principles of mobile networks, and the strategies and challenges in designing mobile networks with 5G support. In particular, the concepts, design challenges, and key developments in vehicle ad&#x2010;hoc networks (VANETs) including connected cars, unmanned aerial vehicles (UAVs), and low&#x2010;Earth orbit (LEO) satellites are outlined. Tactical networks encompassing different types of mobile networks are also considered.},
 author = {Loskot, Pavel},
 booktitle = {Emerging Computing Paradigms: Principles, Advances and Applications},
