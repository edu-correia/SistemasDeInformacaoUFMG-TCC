@article{Guo2025,
 abstract = {Unsupervised visible-infrared person re-identification (UVI-ReID) aims to match images of the same individual across visible and infrared modalities without requiring manually annotated labels. To obtain reliable supervisory signals, existing UVI-ReID methods typically perform intra-modality clustering and inter-modality cluster matching. However, these methods may neglect the reliability of inter-modality cluster matching and fail to capture intra-modality diversity. To address these issues, we propose a merge-split collaborative learning (MSCL) framework. Specifically, we develop a cluster merge matching (CMM) module in MSCL, which first performs a bottom-up hierarchical clustering procedure on the modality with more clusters. Subsequently, it conducts cluster matching with an equal number of clusters between the two modalities, resulting in fairer and more reliable matching. In addition, we design a cluster split learning (CSL) module, which introduces a stricter clustering criterion to divide an original cluster into multiple sub-clusters. CSL then employs the centroids of the sub-clusters as supervisory signals during both homogeneous and heterogeneous learning processes. This incorporates intra-modality and inter-modality diversity mining losses, guiding the encoder to capture more diverse information. Extensive experiments on two visible-infrared datasets demonstrate the effectiveness of the proposed modules. MSCL not only outperforms existing UVI-ReID methods but also achieves competitive performance relative to certain supervised methods. © 2025 Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
 author = {Guo, Jifeng and Liu, Yutong and Pang, Zhiqi and Liu, Jing and Chen, Yan},
 doi = {10.1016/j.imavis.2025.105783},
 journal = {Image and Vision Computing},
