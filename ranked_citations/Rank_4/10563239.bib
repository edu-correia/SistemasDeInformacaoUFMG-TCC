@inproceedings{10563239,
 abstract = {Data integrity and authentication significantly influence a communication system's dependability and security. The vulnerability of these systems to unauthorized breaches in digital substations has substantially increased due to the convergence of computers, communication technologies, and power systems as well as the widespread adoption of ICT systems. As a result, cybersecurity has become one of the biggest problems in the field of electro-grid network. This research paper explores numerous security issues with Sampled Value (SV) messages and suggests robust algorithms to address them. To improve security within a Substation's process bus network Automation System (SAS) working within a power grid, it specifically calls for the integration of Message Authentication Code (MAC) technology into SV communications. The research also includes a well-organized examination of the effectiveness of SV data transmission between Merging Units (MU) and Intelligent Electronic Devices (IEDs) in charge of protection and control (P&C) within a digital substation. This analysis focuses on evaluating the general viability of the proposed SV stream transmission technology as well as meeting strict time requirements.},
 author = {Maurya, Arun Kumar},
 booktitle = {2024 4th International Conference on Innovative Practices in Technology and Management (ICIPTM)},
 doi = {10.1109/ICIPTM59628.2024.10563239},
 issn = {},
 keyword = {Substations;Codes;Merging;Power grids;Information and communication technology;Computer crime;Synthetic aperture sonar;Cyber-Testbed;security patch;IDE;IEC 61850;IEC 62351},
 month = {Feb},
 number = {},
 pages = {1-5},
 title = {Cyber-Physical Testbed Frameworks for Digital Infrastructure},
