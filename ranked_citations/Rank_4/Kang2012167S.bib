@article{Kang2012167S,
 abstract = {The control of dense crowd is a time-consuming and challenging task. There are always conflicts between detailed movements and the control of large-scale crowd. To solve this problem, we suggest the smoothed particle hydrodynamics (SPH) technique to express continuous flow with two authorable interfaces. To reflect the connectivity that occurs in a crowd, we use an authorable sociogram model. And we present a new type of shape map to produce various shapes of crowd in real time under interactive control. © 2012 NSP Natural Sciences Publishing Cor.},
 author = {Kang, Shin Jin and Kim, SooKyun},
 journal = {Applied Mathematics and Information Sciences},
 note = {Cited by: 1},
 number = {1 SUPPL.},
 pages = {167S - 175S},
 publication_stage = {Final},
 source = {Scopus},
 title = {Authorable dense crowd simulation based on smoothed particle hydrodynamics},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84896852350?origin=resultslist},
 volume = {6},
 year = {2012}
}
