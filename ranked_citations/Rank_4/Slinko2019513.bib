@article{Slinko2019513,
 abstract = {A secret sharing scheme implemented in an organisation is designed to reflect the power structure in that organisation. When two organisations merge, this usually requires a number of substantial changes and, in particular, changes to their secret sharing schemes which have to be merged in the way which reflects a new role of each of the organisations. This paper looks at the ways secret sharing scheme can be modified when organisational changes occur. We restrict ourselves with the class of ideal linear secret sharing schemes and describe how matrices of these linear schemes have to be modified when we take the sum, the product or the composition of two linear access structures. © 2019, Springer Nature Switzerland AG.},
 author = {Slinko, Arkadii},
 doi = {10.1007/978-3-030-32430-8_30},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0; All Open Access; Bronze Open Access},
 pages = {513 - 524},
 publication_stage = {Final},
 source = {Scopus},
 title = {Operations over Linear Secret Sharing Schemes},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85076424406?origin=resultslist},
 volume = {11836 LNCS},
 year = {2019}
}
