@inproceedings{10021710,
 abstract = {This paper discusses the assessment of installing shunt reactor in the new 400 kV North-South Interconnector Phase I which will connect the Main Interconnected System (MIS) to the Duqm area and PDO network in the Sultanate of Oman. The project is still under construction and expected to be completed by June 2023. Several study scenarios have been evaluated to clarify the necessity of introducing the high voltage shunt reactors at selected locations. The objective is to determine the best sizes and locations of the required shunt reactor to mitigate overvoltage issues. Steady-state simulation studies are performed using the professional DIgSILENT software. Frequency-dependent distributed parameters models are used to simulate overhead lines. Different operating scenarios and contingencies are considered, and the so-called “Compare and Merge Tool” is used in DIgSILENT to establish which of the cases lead to the best reactive power compensation arrangement. Resonance analysis between the shunt line reactor and line capacitance is performed to to avoid adverse effects of possible high secondary arc current and recovery voltage.},
 author = {Al Zadjali, Hilal and Al Riyami, Hisham and van Dyk, Chris and Boshoff, Sep and Al Siyabi, Musabah and Al Hasni, Mohammed},
 booktitle = {2022 23rd International Middle East Power Systems Conference (MEPCON)},
 doi = {10.1109/MEPCON55441.2022.10021710},
 issn = {},
 keyword = {Shunts (electrical);Reactive power;Contingency management;Voltage;Software;Power grids;Steady-state;Interconnector;Shunt Reactor;Renewable;Spinning Reserve;NPV},
 month = {Dec},
 number = {},
 pages = {1-8},
 title = {Optimization Assessment for 400 kV Shunt Reactors Sizing and Locations in Oman Power Grid},
 volume = {},
 year = {2022}
}
