@inproceedings{6169334,
 abstract = {This paper discusses the merging potential of reconfigurable and deployable antennas for more efficient holistic designs suited for space applications. In this paper we review physically reconfigurable and deployable antennas and present a new concept for a physically reconfigurable deployable log-periodic structure. This antenna is designed to cover UHF frequencies for space communications. The control of such antennas using software is also discussed and presented as part of complete software controlled radio system.},
 author = {Costantine, J. and Tawk, Y. and Christodoulou, C. G. and Barbin, S. E. and Banik, J. and Lane, S.},
 booktitle = {2011 SBMO/IEEE MTT-S International Microwave and Optoelectronics Conference (IMOC 2011)},
 doi = {10.1109/IMOC.2011.6169334},
 issn = {},
 keyword = {Reflector antennas;Space vehicles;Antenna radiation patterns;Springs;Software;reconfigurable antennas;deployable antennas;space communications;log-periodic antenna},
 month = {Oct},
