@inproceedings{4116093,
 abstract = {The optical current transducer is gaining interest because of its obvious advantages over conventional current transducers such as immunity to electromagnetic interference, high dynamic range and ease of integration into future digital control and protection systems. As the digital substation has been the tendency of power system, the study of the interface between electronic transducer and the protective device has become a hot topic. This paper has executed the merging unit, which can collect the digital signal from the adaptive optical current transducer and has realized how to transmit the digital signal to the protective device following IEC61850 through Ethernet. The circuit board based on MSP430 and CS8900A has better integrated level and operates stably. This paper also designed the scheme to realize optical fiber line differential protection based on AOCT following industrial computer and Lab VIEW real-time system.},
 author = {Zhang, Jian and Yuan, Zhenhai and Li, Yansong and Guo, Zhizhong},
 booktitle = {2006 International Conference on Power System Technology},
 doi = {10.1109/ICPST.2006.321467},
 issn = {},
 keyword = {Protective relaying;Transducers;Power system protection;Substation protection;Integrated optics;Electromagnetic interference;Dynamic range;Digital control;Power system dynamics;Merging;IEC61850;Merging Unit (MU);Adaptive Optical Current Transducer (AOCT);LabVIEW;Real-Time System (RT);Relay Protection;Data Communication},
 month = {Oct},
 number = {},
 pages = {1-5},
 title = {A new method to realize the relay protection of AOCT following IEC61850},
 volume = {},
 year = {2006}
}
