@inproceedings{11415983,
 abstract = {We investigate gender bias in the form of differences in information content in some of the popular LLMs and contribute a new benchmark dataset (released on HuggingFace) developed from real-world questions across four key domains in business and health contexts: education, jobs, personal financial management, and general health. Specifically, we introduce entropy bias, which we define as a discrepancy in the amount of information generated by an LLM in response to real questions users have asked. Grounded in authentic user questions and guided by quantitative metrics, our benchmark enables systematic and reproducible analysis of gender entropy biases in language model outputs, which we test using multiple LLMs. Our analyses (metric-based comparisons and “LLM-as-judge” evaluation) suggest that there is no significant bias in LLM responses for men and women at a category level. However, at a finer granularity (the individual question level) there are substantial differences in LLM responses for men and women in the majority of cases, which “cancel” each other out often due to some responses being better for males and vice versa. To address this, we suggest a simple debiasing approach that iteratively merges the responses for the two genders to produce a final result. Our approach demonstrates that a simple, prompt-based debiasing strategy can effectively debias LLM outputs, thus producing responses with higher information content than both gendered variants more than 77% of the cases, and consistently achieving a balanced integration in the remaining cases.},
 author = {Prabhune, Sonal and Padmanabhan, Balaji and Dutta, Kaushik},
 booktitle = {2025 IEEE International Conference on Data Mining Workshops (ICDMW)},
 doi = {10.1109/ICDMW69685.2025.00272},
 issn = {2375-9259},
 keyword = {Measurement;Systematics;Generative AI;Large language models;Conferences;Education;Benchmark testing;Financial management;Entropy;Data mining;Fairness;Bias;Generative AI;GenAI;Entropy Bias;Large Language Models;LLMs;LLM Bias;Gender Bias},
 month = {Nov},
 number = {},
 pages = {2237-2246},
 title = {Measuring and Mitigating Gender Entropy Bias in Large Language Models},
 volume = {},
