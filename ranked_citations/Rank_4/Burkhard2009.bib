@conference{Burkhard2009,
 abstract = {The Michigan Department of Transportation (MDOT) and the Road Commission for Oakland County (RCOC) sought the help of HNTB and its partners to implement an IntelliDrive model deployment using proven technologies to support various commercial traveler information needs, transportation mobility and safety applications. HNTB developed and deployed nine IntelliDrive applications: signal pre-emption, traffic signal countdown, incident beacon, milage-based user fee, congestion pricing, bridge height warning, merge warning, parking availability information/E-payment, and emergency vehicle warning. Demonstration vehicles were equipped with laptops, GPS, and mobile radio equipment. The laptop comupters ran scripts and used a web browser as the driver interface.},
 author = {Burkhard, Brian},
 journal = {16th ITS World Congress},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Intellidrive testbed in Michigan},
 type = {Conference paper},
