@inproceedings{5362586,
 abstract = {This paper analyzes the necessity of enterprise application integration (EAI) and the deficiency of traditional EAI solution. It probes into the basic component models of a service oriented architecture (SOA) and integrated thought and puts forward the solution of realizing EAI on the basis of SOA. We provide a developing instance which integrates certain information system. It has fully proved and realized the feasibility and superiority developed in system integration on the basis of SOA: only uses the system to regard as a group of service function sets, will grade merging in serving, can be good to reusing, sharing, and can distribute to deployment. The solution of integration of application based on SOA is justly the first choose to develop the good responsive and adaptable new type application.},
 author = {Zhang, Yi and Zhou, Jiliu},
 booktitle = {2009 International Conference on Computational Intelligence and Software Engineering},
 doi = {10.1109/CISE.2009.5362586},
 issn = {},
 keyword = {Semiconductor optical amplifiers;Service oriented architecture;Application software;Web services;Educational institutions;Simple object access protocol;Probes;Forward contracts;Information systems;Merging},
 month = {Dec},
