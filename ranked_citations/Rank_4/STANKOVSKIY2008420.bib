@article{STANKOVSKIY2008420,
 abstract = {The code CASCADEX representing the merging of intranuclear cascade and evaporation/fission models is discussed. The intranuclear cascade part is extracted from the CASCADE/INPE code. The equilibrium stage of nuclear reactions is described using the Hauser–Feshbach statistical model implemented in the TALYS code. The CASCADEX code has been validated on experimental yields of radionuclides in nuclear reactions induced by protons of energies from 0.8 to 1.2GeV. The cross-section yields calculated for selected reactions are in a better agreement with experimental data than the results of calculation by INCL4 intranuclear cascade and ABLA evaporation/fission models.},
 author = {A.Yu. Stankovskiy and A.Yu. Konobeyev},
 doi = {https://doi.org/10.1016/j.nima.2008.07.025},
 issn = {0168-9002},
 journal = {Nuclear Instruments and Methods in Physics Research Section A: Accelerators, Spectrometers, Detectors and Associated Equipment},
 keyword = {Nuclear reactions, Intranuclear cascade model, Intermediate and high energies},
 number = {3},
 pages = {420-424},
 title = {CASCADEX—A combination of intranuclear cascade model from CASCADE/INPE with the Hauser–Feshbach evaporation/fission calculations from TALYS},
 url = {https://www.sciencedirect.com/science/article/pii/S0168900208009996},
 volume = {594},
 year = {2008}
}
