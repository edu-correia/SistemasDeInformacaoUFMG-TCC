@article{Berger2003466,
 abstract = {This paper examines the potential efficiency effects of a single market for financial services in Europe. The topics covered include universal banking, the merger and acquisition process itself, cross-border ownership and management of financial institutions, and the effects of consolidation of financial institutions on the supply of relationship lending services to informationally opaque small businesses. The research reviewed here suggests that the creation of a single market for the European financial services industry is not likely to bring about strong efficiency gains and that cross-border efficiency barriers may prevent the single market from becoming a reality. © 2002 Elsevier B.V. All rights reserved.},
 author = {Berger, Allen N.},
 doi = {10.1016/S0377-2217(02)00772-5},
 journal = {European Journal of Operational Research},
 note = {Cited by: 38},
 number = {3},
 pages = {466 - 481},
 publication_stage = {Final},
 source = {Scopus},
 title = {The efficiency effects of a single market for financial services in Europe},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/1642368103?origin=resultslist},
 volume = {150},
 year = {2003}
}
