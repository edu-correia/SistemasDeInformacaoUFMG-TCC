@inproceedings{5331768,
 abstract = {Model composition is frequently used during large software development in MDE (Model Driven Engineering). The consistency of the composed model is quite essential to model composition. This paper presents a weaving-based model composition framework (WMCF) and then gives a prototype implementation of the framework using Alloy language. Models are converted into Alloy codes and model composition is verified by the Alloy Analyzer.},
 author = {Zhang, Defen and Li, Shixian and Liu, Xianming},
 booktitle = {2009 Fifth International Joint Conference on INC, IMS and IDC},
 doi = {10.1109/NCM.2009.271},
 issn = {},
 keyword = {Weaving;Model driven engineering;Unified modeling language;Prototypes;Merging;Programming;Packaging;Analytical models;Computer science;Sun;model composition;verification;Alloy;model weaving},
 month = {Aug},
