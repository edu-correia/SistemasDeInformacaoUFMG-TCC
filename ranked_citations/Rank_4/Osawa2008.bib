@conference{Osawa2008,
 abstract = {In this paper, we present a new approach based on Markov Chain Monte Carlo(MCMC) for the stable monocular tracking of variable interacting targets in 3D space. The crucial problem with monocular tracking multiple targets is that mutual occlusions on the 2D image cause target conflict(change ID, merge targets...). We focus on the fact that multiple targets cannot occupy the same position in 3D space and propose to track multiple interacting targets using relative position of targets in 3D space. Experiments show that our system can stably track multiple humans that are interacting with each other. © 2008 IEEE.},
 author = {Osawa, Tatsuya and Sudo, Kyoko and Arai, Hiroyuki and Koike, Hideki},
 doi = {10.1109/icpr.2008.4761322},
 journal = {Proceedings - International Conference on Pattern Recognition},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Monocular 3D tracking of multiple interacting targets},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77957969459?origin=resultslist},
 year = {2008}
}
