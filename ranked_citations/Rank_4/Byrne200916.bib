@article{Byrne200916,
 abstract = {Tony Byrne shared his views on some of the significant issues associated with the approach of digital companies to acquire and merge with other companies or vendors. Adode Systems, Inc., acquired web analytics vendor, Omniture in September, 2009. The acquisition of the vendor had a significant impact on the market and its customers who faced significant challenges. Tony Byrne informed that such integration had significant adverse impact on the market and customers had to suffer. It was better to adopt such an integration approach when two companies had similar marketing strategies and customer base. He suggested that the acquisition of a SaaS vendor by a traditional software company was a better approach towards integration, as it had better impact on the market and customers.},
 author = {Byrne, Tony},
