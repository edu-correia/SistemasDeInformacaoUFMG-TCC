@article{Lisena2019454,
 abstract = {In a document-based world as the one of Web APIs, the triple-based output of SPARQL endpoints can be a barrier for developers who want to integrate Linked Data in their applications. A different JSON output can be obtained with SPARQL Transformer, which relies on a single JSON object for defining which data should be extracted from the endpoint and which shape should they assume. We propose a new approach that amounts to merge SPARQL bindings on the base of identifiers and the integration in the grlc API framework to create new bridges between the Web of Data and the Web of applications. © 2019, Springer Nature Switzerland AG.},
 author = {Lisena, Pasquale and Meroño-Peñuela, Albert and Kuhn, Tobias and Troncy, Raphaël},
 doi = {10.1007/978-3-030-30796-7_28},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 23; All Open Access; Green Open Access},
 pages = {454 - 470},
 publication_stage = {Final},
 source = {Scopus},
 title = {Easy Web API Development with SPARQL Transformer},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85081089679?origin=resultslist},
 volume = {11779 LNCS},
 year = {2019}
}
