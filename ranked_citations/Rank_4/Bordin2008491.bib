@conference{Bordin2008491,
 abstract = {Model-driven technologies offer a most attractive framework for rapid, iterative software development cycles by facilitating a productive merge of high-level modeling with automated model transformation and verification. In the high-integrity application domain it is of paramount importance to assure semantics preservation across each view of the system produced as part of the development process, most notably the design model, the analysis model, the executable. In this short paper we present a toolset that assures the preservation of properties of interest across all stages of an MDE-geared development. © 2008 IEEE.},
 author = {Bordin, Matteo and Panunzio, Marco and Puri, Stefano},
 doi = {10.1109/ASE.2008.86},
 journal = {ASE 2008 - 23rd IEEE/ACM International Conference on Automated Software Engineering, Proceedings},
 note = {Cited by: 0},
 pages = {491 - 492},
 publication_stage = {Final},
 source = {Scopus},
 title = {Rapid model-driven prototyping and verification of high-integrity real-time systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/56249099738?origin=resultslist},
 year = {2008}
}
