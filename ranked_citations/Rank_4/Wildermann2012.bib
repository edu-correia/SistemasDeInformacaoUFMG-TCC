@article{Wildermann2012,
 abstract = {By means of partial reconfiguration, parts of the hardware can be dynamically exchanged at runtime. This allows that streaming application running in different modes of the systems can share resources. In this paper, we discuss the architectural issues to design such reconfigurable systems. For being able to reduce reconfiguration time, this paper furthermore proposes a novel algorithm to aggregate several streaming applications into a single representation, called merge graph. The paper also proposes an algorithm to place streaming application at runtime which not only considers the placement and communication constraints, but also allows to place merge tasks. In a case study, we implement the proposed algorithm as runtime support on an FPGA-based system on chip. Furthermore, experiments show that reconfiguration time can be considerably reduced by applying our approach. Copyright © 2012 S. Wildermann et al.},
 author = {Wildermann, S. and Angermeier, J. and Sibirko, E. and Teich, J.},
 doi = {10.1155/2012/608312},
 journal = {International Journal of Reconfigurable Computing},
 note = {Cited by: 7; All Open Access; Gold Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Placing multimode streaming applications on dynamically partially reconfigurable architectures},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84858269531?origin=resultslist},
 volume = {2012},
 year = {2012}
}
