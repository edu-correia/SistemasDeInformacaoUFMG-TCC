@conference{Fontana200933,
 abstract = {Our assumption here is that the relationships between networks of concepts (ontologies) and people networks (web communities) is reciprocal and dynamic. ontologies identify communities and communities through practice define ontologies. Ontologies describe complex domains and therefore are difficult to create manually. Our investigation aims at building tools and methodologies to drive the process of ontology building. In particular we define a model by which ontologies evolve through Web community extraction. In this paper, we observe that tags in Web 2.0 are mathematical objects called clouds and studied in [11]. And we introduce Net Merge, an algorithm for transforming an ontology into a complex network.},
 author = {Fontana, Francesca Arcelli and Formata, Ferrante Raffaele and Pareschi, Remo},
 journal = {Ontology for e-Technologies - Proceedings of the 1st International Workshop on Ontology for e-Technologies - OET 2009 In Conjunction with ICEIS 2009},
 note = {Cited by: 3},
 pages = {33 - 40},
 publication_stage = {Final},
 source = {Scopus},
 title = {Ontology engineering: Co-evolution of complex networks with ontologies},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/74549130639?origin=resultslist},
 year = {2009}
}
