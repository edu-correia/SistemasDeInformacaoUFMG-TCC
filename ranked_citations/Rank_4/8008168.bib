@inproceedings{8008168,
 abstract = {Among different radar design concepts, the “One radar - one equation” approach focused on the philosophy of the radar design to optimize information extraction and maximize the degree of measurement freedom for radar detection, tracking and recognition of the flying small size objects. Application of this concept wishes to exploit capabilities of the radars are collocated or located in Gaussian monostatic, which are close to each other in distance formation. This article draws the reader's attention to the approach based on the Gaussian monostatic radar concept coherent signal fusion augmented by non-coherent signal processing, which increases performance of the current radars built by traditional system concepts. The power and application challenges will be demonstrated on the collocated ATC SSR/PSR radar requirement and performance change. This concept merges the Secondary and Primary radar Antenna-Aperture product and transmit power based on modern coherent signal processing and growing MIMO resource results, while it exploits signal polarization peculiarities, radial speed, Doppler & Micro-Doppler and the environment. Operational drawbacks of the traditional radar structures are reducing a certain extend as well.},
 author = {Balajti, István},
 booktitle = {2017 18th International Radar Symposium (IRS)},
 doi = {10.23919/IRS.2017.8008168},
 issn = {2155-5753},
 keyword = {Radar;Radar cross-sections;Radar antennas;Radar tracking;Radar detection;Target tracking;Receiving antennas;Doppler radar;Clutter;Drones},
 month = {June},
 number = {},
 pages = {1-13},
 title = {“One radar-one equation” concept for radars of ATC},
 volume = {},
 year = {2017}
}
