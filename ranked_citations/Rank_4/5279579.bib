@inproceedings{5279579,
 abstract = {With MapReducepsilas restricted structure, multi-datasets merging problem, commonly in many data mining applications, cannot be efficiently resolved with MapReduce. This paper proposes a novel hybrid datasets merging algorithm on top of Map Reduce, HDMA. HDMA can help to automatically determine the relatively better one between two methods, DMCM and DPM, which have different effective fields. HDMA retains the advantages of both methods, and it can make good use of the memory of data nodes. Experiments show that HDMA can get best performance in most situations.},
 author = {Ma, Lili and Liao, Huaming and He, Yongqiang and Li, Feng and Gao, Qiang},
 booktitle = {2009 Eighth International Conference on Grid and Cooperative Computing},
 doi = {10.1109/GCC.2009.28},
 issn = {2160-4916},
 keyword = {Switches;Merging;Partitioning algorithms;Data mining;Uniform resource locators;Grid computing;Laboratories;Computers;Application software;Costs;MapReduce;Hash table;memory;DMCM;DPM;auto-tuning},
 month = {Aug},
 number = {},
 pages = {293-298},
 title = {A Switch Criterion for Hybrid Datasets Merging on Top of Map Reduce},
 volume = {},
 year = {2009}
}
