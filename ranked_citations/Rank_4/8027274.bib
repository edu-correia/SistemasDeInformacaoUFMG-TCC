@inproceedings{8027274,
 abstract = {In the era of the Internet of Things (IoT), data from sensors can give insightful enterprise information through analytics. As a result, several enterprises are adopting sensors and other wireless technologies for their needs. However, some challenges exist within the IoT space. Most of the devices in use have varied device semantics and protocol variations which can limit interoperability. As a result, data and process integration can be hindered. In this work, we propose a middleware with both machine-to-infrastructure (M2I) and machine-to-machine (M2M) capabilities which addresses these problems based on mapping techniques between the heterogeneous device semantics and providing a common interface for merging protocol variations. When a device is discoverable, our middleware uses an enhanced environment-context features to match the appropriate communication protocol. This aids in the pushing of data from within-range sensors to a cloud-hosted infrastructure.},
 author = {Lomotey, Richard K. and Pry, Joseph and Sriramoju, Sumanth and Kaku, Emmanuel and Deters, Ralph},
 booktitle = {2017 IEEE International Conference on AI & Mobile Services (AIMS)},
 doi = {10.1109/AIMS.2017.20},
 issn = {},
 keyword = {Middleware;Protocols;Bluetooth;Radiofrequency identification;Semantics;Machine-to-machine communications;IoT;Middleware;Services;Machine-to-Machine (M2M);and Machine-to-Infrastructure (M2I)},
 month = {June},
 number = {},
 pages = {89-92},
 title = {Middleware Framework for IoT Services Integration},
 volume = {},
 year = {2017}
}
