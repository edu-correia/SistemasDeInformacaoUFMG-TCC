@article{Gousios2014885,
 abstract = {Quantitative empirical software engineering research benefits mightily from processing large open source software repository data sets. The diversity of repository management tools and the long history of some projects, renders the task of working with those datasets a tedious and error-prone exercise. The Alitheia Core analysis platform preprocesses repository data into an intermediate format that allows researchers to provide custom analysis tools. Alitheia Core automatically distributes the processing load on multiple processors while enabling programmatic access to the raw data, the metadata, and the analysis results. The tool has been successfully applied on hundreds of medium to large-sized open-source projects, enabling large-scale empirical studies. © 2013 Springer Science+Business Media New York.},
 author = {Gousios, Georgios and Spinellis, Diomidis},
 doi = {10.1007/s10664-013-9242-3},
 journal = {Empirical Software Engineering},
 note = {Cited by: 15},
 number = {4},
 pages = {885 - 925},
 publication_stage = {Final},
 source = {Scopus},
 title = {Conducting quantitative software engineering studies with Alitheia Core},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84901842459?origin=resultslist},
 volume = {19},
 year = {2014}
}
