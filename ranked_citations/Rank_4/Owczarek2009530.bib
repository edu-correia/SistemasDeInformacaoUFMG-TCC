@conference{Owczarek2009530,
 abstract = {The article presents an example of an extension of Multi-agent influence diagram (MAID) proposed by Koller and Milch with some concepts derived from Sequential influence diagram (SID) described by Jensen, Nielsen and Shenoy. Its main aim is to test if these two graphical languages can be merge in order to deal with an asymmetric multi-agent scenario. An example of such a scenario is given and it is modeled and solved using techniques derived from these two languages. The obtained solution is verified using traditional game-theoretic method. ©2009 IEEE.},
 author = {Owczarek, Tomasz},
 doi = {10.1109/IDAACS.2009.5342922},
 journal = {Proceedings of the 5th IEEE International Workshop on Intelligent Data Acquisition and Advanced Computing Systems: Technology and Applications, IDAACS'2009},
 note = {Cited by: 1},
 pages = {530 - 534},
 publication_stage = {Final},
 source = {Scopus},
 title = {On modeling asymmetric multi-agent scenarios},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/74549191453?origin=resultslist},
 year = {2009}
}
