@article{Goczyła2009492,
 abstract = {In the environment of Semantic Web the problem of precise manipulation of units of knowledge gains importance. In this paper we discuss a possibility of adoption for this purpose the flexible and powerful apparatus of relational algebra. We discuss similarities and differences between knowledge and data bases and their underlying information-processing models. On the basis of the discussion we draw and investigate a special analogy between these two important methods. We use this analogy to introduce the special algebra of ontological modules which may be used to exchange, align and merge the knowledge among agents. © 2009 Springer Berlin Heidelberg.},
 author = {Goczyła, Krzysztof and Waloszek, Aleksander and Waloszek, Wojciech},
 doi = {10.1007/978-3-642-04441-0_43},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 6},
 pages = {492 - 503},
 publication_stage = {Final},
 source = {Scopus},
 title = {Algebra of ontology modules for semantic agents},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70450158401?origin=resultslist},
 volume = {5796 LNAI},
 year = {2009}
}
