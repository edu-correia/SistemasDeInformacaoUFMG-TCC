@conference{Moraux2022153,
 abstract = {For the purpose of improving precipitation estimation, we have developed a deep learning method for merging different modalities of measurements. In a previous paper, we proposed a method that can merge rain gauge measurements with ground-based radar composite and thermal infrared satellite imagery. In this paper, we study the benefits of also using other satellite channels that are not infrared. Because non-infrared channels are not visible during the night, we also study the difference in performance during the day and the night.  © 2022 IEEE.},
 author = {Moraux, Arthur and Dewitte, Steven and Munteanu, Adrian},
 doi = {10.1109/M2GARSS52314.2022.9840231},
 journal = {2022 IEEE Mediterranean and Middle-East Geoscience and Remote Sensing Symposium, M2GARSS 2022 - Proceedings},
 note = {Cited by: 1},
 pages = {153 - 156},
 publication_stage = {Final},
 source = {Scopus},
 title = {The Benefits of Additional Satellite Channels for a Multimodal Deep Learning Method for Precipitation Estimation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85136432574?origin=resultslist},
 year = {2022}
}
