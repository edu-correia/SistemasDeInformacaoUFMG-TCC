@inproceedings{4430185,
 abstract = {Enterprise-scale search engines are generally designed for linear text. Linear text is suboptimal for audio search, where accuracy can be significantly improved if the search includes alternate recognition candidates, commonly represented as word lattices. We propose two methods to enable text indexers to approximately index lattices with little or no code change: “TMI” (Time-based Merging for Indexing) aims at lattice-index size reduction, and the “sausage”-like “TALE” (Time-Anchored Lattice Expansion) approximation requires no indexer-code or data-format changes at all. On four enterprise-type data sets (meetings, phone calls, lectures, and voicemail), TMI and TALE improve accuracy by 30–60% for multi-word phrase searches and by 130% for two-term AND queries, compared to indexing linear text.},
 author = {Frank Seide and Peng Yu and Yu Shi},
 booktitle = {2007 IEEE Workshop on Automatic Speech Recognition & Understanding (ASRU)},
 doi = {10.1109/ASRU.2007.4430185},
 issn = {},
 keyword = {Indexing;Lattices;Search engines;Videos;Information retrieval;Merging;Voice mail;Internet;Speech recognition;Broadcasting;Audio indexing;lattice;posterior;keyword spotting},
 month = {Dec},
 number = {},
 pages = {629-634},
 title = {Towards spoken-document retrieval for the enterprise: Approximate word-lattice indexing with text indexers},
 volume = {},
 year = {2007}
}
