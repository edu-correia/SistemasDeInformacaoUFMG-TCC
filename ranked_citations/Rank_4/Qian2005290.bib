@article{Qian2005290,
 abstract = {In this work we investigate a symbolic heuristic search algorithm in a model checker. The symbolic search algorithm is built on a system that manipulates binary decision diagrams (BDDs). We study the performance of the search algorithm in terms of the number of BDD operations, size of the BDDs, number of nodes they contain and runtime. We study the heuristic distribution of the state space, we measure effort by computing the mean heuristic value, and we compare single and multiple heuristics. In the case of multiple heuristics, we consider admissible and non-admissible merge strategies. We experiment on problems from a variety of domains. We find that multiple heuristics can perform significantly worse than single heuristics in symbolic search in at least one domain. In general, the effect of the heuristics on the symbolic search in the different domains varies markedly, and we conjecture that the different behaviour is caused by intrinsic differences in the characteristics of the state space. © Springer-Verlag Berlin Heidelberg 2005.},
 author = {Qian, Kairong and Nymeyer, Albert and Susanto, Steven},
 doi = {10.1007/11527862_22},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3},
 pages = {290 - 304},
 publication_stage = {Final},
 source = {Scopus},
 title = {Experiments with multiple abstraction heuristics in symbolic verification},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/26944431538?origin=resultslist},
 volume = {3607 LNAI},
 year = {2005}
}
