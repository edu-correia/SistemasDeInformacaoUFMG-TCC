@article{LEI2026105459,
 abstract = {Vehicle-to-everything (V2X) technology can enable cooperative multivehicle control at traffic bottlenecks, such as ramp merging areas, to achieve increased safety and efficiency. However, the existing methods still face limitations in terms of optimizing efficiency, reducing complexity, and enhancing scalability in multilane scenarios. A discretized spatial feature modeling method for on-ramp merging areas is proposed in this study. By constructing occupancy flow features, uneven traffic features, and ramp flow radiation features, valuable information in space can be quantified. This information is then stored in discretized, equally sized rectangular segments and concatenated into a fixed-dimensional feature matrix. A multivehicle cooperative control method is developed on the basis of this model, incorporating a rolling optimization strategy with priority sequencing to evaluate and select the optimal actions for each vehicle. The control algorithm was comprehensively evaluated in mixed-traffic scenarios and demonstrated effectiveness. Compared with the benchmark algorithms, it achieved optimal and stable traffic efficiency, reducing the total completion time by at least 7.60 % while ensuring safe vehicle spacing. Field tests further confirmed its feasibility. The related test videos and code can be obtained from https://github.com/Lei-CF/MergeControl.},
 author = {Chaofan Lei and Xiaojun Tan and Jie Zhang and Nanwei Xiao and Kunxiang Deng and Jun Li},
 doi = {https://doi.org/10.1016/j.trc.2025.105459},
 issn = {0968-090X},
 journal = {Transportation Research Part C: Emerging Technologies},
 keyword = {On-Ramp merging, Discrete information, Expert system, Optimal control, Occupancy flow},
 pages = {105459},
 title = {Optimized control method for cooperative on-ramp merging of connected vehicles based on discretized spatial feature modeling},
 url = {https://www.sciencedirect.com/science/article/pii/S0968090X25004632},
 volume = {183},
 year = {2026}
}
