@inproceedings{11468559,
 abstract = {The Rapidly-exploring Random Tree (RRT) algorithm exhibits limited path information reuse and suboptimal search efficiency in multi-target continuous motion planning for high-dimensional 6-DOF robotic manipulators. To overcome these critical challenges, this paper proposes a novel Multi-Source RRT (MS-RRT) path planning algorithm. This method relies on spatial sampling and efficient graph structure management using the Union-Find Set data structure. The MS-RRT algorithm introduces an innovative mechanism where multiple source points collaboratively grow RRT trees within a shared configuration space. The core technological contribution lies in leveraging the Union-Find Set to facilitate efficient querying and dynamic merging of node connectivity. This approach enables graph structure reuse within the RRT framework, facilitating the simultaneous solution of multiple start-to-goal path queries. Consequently, the shared exploration records within the unified space significantly enhance the algorithm's search efficiency and robustness. This results in superior performance in complex robotic multi-target path planning problems.},
 author = {Wu, Yujie},
 booktitle = {2025 International Conference on Mechatronics, Automation and Intelligent Control (MAIC)},
 doi = {10.1109/MAIC67965.2025.11468559},
 issn = {},
 keyword = {Space exploration;Filtering;Filters;Protocols;Radio access networks;Regional area networks;HTTP;High frequency;Communication systems;Telecommunications;Rapidly-exploring Random Tree (RRT);Robotic Arm;Path Planning;Obstacle Avoidance;Multi-source Search},
 month = {Dec},
 number = {},
 pages = {415-418},
 title = {Multi-Source RRT Algorithm for Robotic ARM Path Planning},
 volume = {},
 year = {2025}
}
