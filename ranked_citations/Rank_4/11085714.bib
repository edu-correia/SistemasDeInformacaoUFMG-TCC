@inproceedings{11085714,
 abstract = {DevOps is a set of practices that requires to build the application and identify the bugs in early stage by collaboration with software development, testing and software operations teams together. DevOps entails to shorten the systems development life cycle and focus on Continuous-Integration and Continuous-Delivery (CI/CD) with high quality automation in place. In this work a capability matrix is developed for DevOps and results show that DevOps is solving current industry problems by implementing CI/CD pipelines. It has been experimentally proved that microservices are faster to deploy and ready for time-to-market, whereas monolith systems are complex, inflexible, and require a whole system update, making them difficult to build and deploy. It was shown that the latency increased dramatically in the monolith system for 500 to 2500 HTTP calls per second, which is extremely little and insufficient in today’s corporate sector, where an average of trillion transactions are serviced each day.},
 author = {Singh, Vinay and Aggarwal, Alok and Aggarwal, Shalini and Mittal, Ronit},
 booktitle = {2025 6th International Conference on Intelligent Communication Technologies and Virtual Mobile Networks (ICICV)},
 doi = {10.1109/ICICV64824.2025.11085714},
 issn = {},
 keyword = {Cloud computing;DevOps;Microservice architectures;Collaboration;Process control;Aerospace electronics;Software;Standards;Testing;Pragmatics;Version Control System;DevOps;Git;Subversion (SVN);Auto resilient;Jenkins;CI/CD;Microservices},
 month = {June},
 number = {},
 pages = {974-978},
 title = {A Pragmatic DevOps Approach for Reducing the Time-to-Market for business using Git and DevOps},
 volume = {},
 year = {2025}
}
