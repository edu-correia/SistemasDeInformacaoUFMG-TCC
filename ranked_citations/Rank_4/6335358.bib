@inproceedings{6335358,
 abstract = {The fast emerging technology of femtocells, through the utilization of existing IP infrastructures, promises to improve critical performance indicators in cellular networks, such as coverage and capacity, with minimum cost. However, the random placement of femtocells contrary to the structured deployment of the current cellular network raises challenges for interference management. In this context, we propose a Cooperation Framework for LTE Femtocells' Efficient Integration (COF-FEI) in cellular infrastructures in order to: 1) reduce interference in the forward link of femtocells caused by the macrocell Base Station (BS) and, 2) improve the Signal-to-Interference plus Noise ratio (SINR) of macrocell users located in the vicinity of femtocells. COF-FEI introduces a novel merging of relaying and femtocells (i.e. femto-relays) and sets the base for an efficient cooperation between macro BS and femtocells through wireless links. As confirmed through simulations results, COF-FEI is able to improve the overall Quality of Service provided to the macro and femto end users.},
 author = {Nomikos, Nikolaos and Makris, Prodromos and Skoutas, Dimitrios N. and Vouyioukas, Demosthenes and Skianis, Charalabos},
 booktitle = {2012 IEEE 17th International Workshop on Computer Aided Modeling and Design of Communication Links and Networks (CAMAD)},
 doi = {10.1109/CAMAD.2012.6335358},
 issn = {2378-4873},
 keyword = {Femtocells;Interference;Relays;Signal to noise ratio;Wireless communication;Macrocell networks;Antennas;HetNet;Femtocell;Relaying;Inter-Cell Interference;QoS},
 month = {Sep.},
 number = {},
 pages = {318-322},
 title = {A cooperation framework for LTE femtocells' efficient integration in cellular infrastructures based on femto relay concept},
 volume = {},
 year = {2012}
}
