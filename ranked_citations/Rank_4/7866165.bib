@inproceedings{7866165,
 abstract = {With tremendous growth in Online Social Networks(OSNs), users are used to sharing their photos about daily life in OSNs, that makes social sharing much convenient. Unfortunately, users enjoy these benefit at the cost of confronting privacy issues. A shared photo should be controlled by all users in it to avoid unauthorized access. In this paper, we propose a fine-grained multiparty access control model, which aims to change the granularity of access control from photo level to face level. Our model evaluate each user's policy who are recognized in given photo, based on relationship type intimacy, photo context about spatial-temporal information and co-occurrence users, and merge the individual decision after our proposing policy conflicting resolving approach. To demonstrate the utility of our model, we finally give a case study.},
 author = {Lee, Chao and Wang, Wei and Guo, Yunchuan},
 booktitle = {2016 IEEE First International Conference on Data Science in Cyberspace (DSC)},
 doi = {10.1109/DSC.2016.113},
 issn = {},
 keyword = {Access control;Face;Privacy;Context;Face recognition;Social network services;Aerospace electronics;Access control;Online Social Networks;Photo Sharing;Privacy Preserving},
 month = {June},
 number = {},
 pages = {440-445},
 title = {A Fine-Grained Multiparty Access Control Model for Photo Sharing in OSNs},
 volume = {},
 year = {2016}
}
