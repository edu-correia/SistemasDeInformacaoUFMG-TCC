@article{LLOYD20141223,
 abstract = {By merging recent experimental and computational methodology advances, resolution-adapted structural recombination Rosetta has emerged as a powerful strategy for solving the structure of traditionally challenging targets. In this issue of Structure, Sgourakis and colleagues solve the structure of one such target, the immunoevasin protein m04, using this approach.},
 author = {Neil R. Lloyd and Deborah S. Wuttke},
 doi = {https://doi.org/10.1016/j.str.2014.08.004},
 issn = {0969-2126},
 journal = {Structure},
 number = {9},
 pages = {1223-1224},
 title = {Less Is More: Structures of Difficult Targets with Minimal Constraints},
 url = {https://www.sciencedirect.com/science/article/pii/S0969212614002482},
 volume = {22},
 year = {2014}
}
