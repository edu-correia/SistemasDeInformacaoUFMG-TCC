@inproceedings{11294234,
 abstract = {As the need for rapid and efficient software development increases, developers often encounter difficulties in creating code that is both accurate and suited to its context. Conventional code generation tools tend to fall short in integrating specialized expertise from specific fields or in handling intricate programming requirements. To address this issue, we introduce a cutting-edge code generation system that employs Retrieval-Augmented Generation (RAG). This method effectively connects natural language inputs to high-quality code outputs by merging the capabilities of large language models with a document retrieval framework based on vectors. Prior to code generation, the system collects relevant documents, templates, or code samples, ensuring that the output is technically sound and contextually fitting. The architecture of the system is modular, incorporating components for data ingestion, embedding, retrieval, and code generation. This allows for versatility across various programming languages and applications. This intelligent assistant significantly cuts down development time, enhances code quality, and easily adapts to meet developers' needs. Planned future improvements will include features such as interactive debugging, advanced code completion, and integration with popular Integrated Development Environments (IDEs) to further streamline and enhance the development workflow.},
 author = {Vethika, V and Jenifer and Rohitha, R and Revathi, M.},
 booktitle = {2025 9th International Conference on Computational System and Information Technology for Sustainable Solutions (CSITSS)},
 doi = {10.1109/CSITSS67709.2025.11294234},
 issn = {2767-1097},
 keyword = {Codes;Accuracy;Large language models;Retrieval augmented generation;Static analysis;Vectors;Real-time systems;Usability;Programming profession;Software development management;Retrieval-Augmented Generation;Code Generation;AI for Developers;Language Models;Vector Databases;Developer Tools;NLP;Smart Coding Assistant},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {LLM-Powered Code Generation Using RAG Framework with LLaMA 3},
 volume = {},
 year = {2025}
}
