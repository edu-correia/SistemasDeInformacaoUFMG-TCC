@conference{Petrova-Antonova2009II.121,
 abstract = {Fast growing markets and development of new technologies require companies to use network of geographically dispersed offices located in different cities and countries. So, the question is: How remote offices could work effectively with shared database. A smart solution is using of reliable and efficient replication method. The goal of this paper is design and implementation of an approach, which provides replication and synchronization of several distributed copies of a particular database. The proposed approach could be used as alternative replication method within Microsoft SQL Server 2000. Its appliance includes: construction of local copies of particular database, which can be synchronized with the global one; support of synchronized local copies at a given time; possibilities for work without connection with global database copy; update from local to global database copy and vice versa; conflict detection and resolution during replication; logging of synchronizations that are done. © 2009 ACM.},
 author = {Petrova-Antonova, Dessislava and Vacheva, Ivelina},
 doi = {10.1145/1731740.1731768},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 0},
 pages = {II.121 - II.128},
 publication_stage = {Final},
 source = {Scopus},
 title = {Approach for data replication on MS SQL server},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77951497015?origin=resultslist},
 volume = {433},
 year = {2009}
}
