@article{11008735,
 abstract = {Cooperative on-ramp merging presents significant challenges for connected and automated vehicles (CAVs). However, the uncertain and coupled characteristics of longitudinal and lateral motions, along with the spatial constraints in a limited structured space, have not been adequately addressed by current control methods. In this paper, a spatial-enhanced adaptive robust control strategy is proposed for CAVs to achieve integrated longitudinal and lateral merging operations. First, a spatial-dependent cooperative merging framework based on uncertain vehicle coupling dynamics is developed. The spatial dependence refers to a longitudinal and lateral safety corridor bonded to spatial locations, ensuring collision avoidance in the most critical merging conflict zone. Second, an adaptive robust control scheme for the underactuated system is designed using the Lyapunov min-max approach. Both uniform boundedness and uniform ultimate boundedness performance of the tracking errors are guaranteed, effectively attenuating the negative effects of time-varying uncertainties and collision avoidance. Finally, extensive validations are conducted to validate the effectiveness and superiority of the proposed control strategy compared to baseline methods.},
 author = {Pan, Xiangcheng and Yuan, Xiaofang and Ling, Zhigang and Li, Zhe and Liu, Kexin and Wang, Yaonan},
 doi = {10.1109/TVT.2025.3568520},
 issn = {1939-9359},
 journal = {IEEE Transactions on Vehicular Technology},
 keyword = {Merging;Vehicle dynamics;Trajectory;Couplings;Safety;Robust control;Collision avoidance;Aerodynamics;Decentralized control;Training;Connected and automated vehicles (CAVs);cooperative on-ramp merging;uncertain vehicle coupling dynamics;spatial-dependent safety corridor},
 month = {Oct},
 number = {10},
 pages = {15080-15094},
 title = {Spatial-Enhanced Adaptive Robust Control for Longitudinal and Lateral Cooperative On-Ramp Merging of CAVs},
 volume = {74},
 year = {2025}
}
