@article{Civitarese2021433,
 abstract = {One of the major challenges in Human Activity Recognition (HAR) based on machine learning is the scarcity of labeled data. Indeed, collecting a sufficient amount of training data to build a reliable recognition problem is often prohibitive. Among the many solutions in the literature to mitigate this issue, collaborative learning is emerging as a promising direction to distribute the annotation burden over multiple users that cooperate to build a shared recognition model. One of the major issues of existing methods is that they assume a static activity model with a fixed set of target activities. In this paper, we propose a novel approach that is based on Growing When Required (GWR) neural networks. A GWR network continuously adapts itself according to the input training data, and hence it is particularly suited when the users share heterogeneous sets of activities. Like in federated learning, for the sake of privacy preservation, each user contributes to the global activity classifier by sharing personal model parameters, and not by directly sharing data. In order to further mitigate privacy threats, we implement a strategy to avoid releasing model parameters that may indirectly reveal information about activities that the user specifically marked as private. Our results on two well-known publicly available datasets show the effectiveness and the flexibility of our approach.  © 2021 - IOS Press. All rights reserved.},
 author = {Civitarese, Gabriele and Ye, Juan and Zampatti, Matteo and Bettini, Claudio},
 doi = {10.3233/AIS-210018},
 journal = {Journal of Ambient Intelligence and Smart Environments},
 note = {Cited by: 1},
 number = {6},
 pages = {433 - 452},
 publication_stage = {Final},
 source = {Scopus},
 title = {Collaborative activity recognition with heterogeneous activity sets and privacy preferences},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85120531110?origin=resultslist},
