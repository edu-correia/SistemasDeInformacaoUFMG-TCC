@inproceedings{8719469,
 abstract = {Due to the distributed nature of Modern Code Review (MCR) tools, developers risk submitting similar patches (i.e., patches that attempt to achieve similar objectives), which potentially causes extra efforts both for the contributors and reviewers. Although researches on other duplicate software artifact exist, there is no prior work that explores the impact of such similar patches in MCR. In this paper, we conduct an empirical study to understand the impact of similar patches on reviewing efforts in MCR. We extracted over 3,400 similar patches from the OpenStack project. Results of the exploratory study confirm that similar patches take just as much time and patch revisions as merged patches.},
 author = {Wang, Dong and Kula, Raula Gaikovina and Matsumoto, Kenichi},
 booktitle = {2018 25th Asia-Pacific Software Engineering Conference (APSEC)},
 doi = {10.1109/APSEC.2018.00107},
 issn = {2640-0715},
 keyword = {Software;Computer bugs;Tools;Measurement;Organizations;Data collection;Software engineering;code review;software inspection;mining software repository},
 month = {Dec},
 number = {},
 pages = {723-724},
 title = {An Exploratory Study to Identify Similar Patches: A Case Study in Modern Code Review},
 volume = {},
 year = {2018}
}
