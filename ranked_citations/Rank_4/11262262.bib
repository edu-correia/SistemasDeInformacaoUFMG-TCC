@inproceedings{11262262,
 abstract = {This paper presents a coverage control strategy for UAV formations based on swarm splitting and merging to explore a non-convex-shaped environment. The leader-follower model is combined with formation control to split the robot swarm into subgroups during the exploration process. Once the subgroups of robots complete their assigned tasks, they will merge back together to move towards a common goal. In such scenarios, path planning must also be adapted to the shape of the environment. To demonstrate the effectiveness of the proposed technique, simulation results are provided in the paper.},
 author = {Quang, Hung Pham and Duy, Hung Pham},
 booktitle = {2025 8th International Conference on Control, Robotics and Informatics (ICCRI)},
 doi = {10.1109/ICCRI67201.2025.11262262},
 issn = {},
 keyword = {Shape;Simulation;Surveillance;Merging;Process control;Autonomous aerial vehicles;Path planning;Formation control;Stability analysis;Robots;Patrol and Surveillance;Sweep Coverage;Splitting and Merging;Formation},
 month = {Aug},
 number = {},
 pages = {112-117},
 title = {Splitting and Merging UAV Formation for Coverage Path Planning},
 volume = {},
 year = {2025}
}
