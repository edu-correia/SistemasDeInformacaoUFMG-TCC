@inproceedings{4424199,
 abstract = {At present, Provincial Electricity Authority (PEA) has two SQL database systems for power quality (PQ) monitoring system. They are ION7650 of Power Measurement and U902 of Unipower. The complexity to analysis PQ data comes from the different format of those two types of database system and therefore, PEA has to analyze PQ data from ION7650 and 1902 separately. In the future, the PEA may have many types of database systems, and that would cause more complexity to analyze the PQ data. To analyze several types of database system, any database system should be set identically as minimum requirement for PQ monitoring system comply with EN50160 standard. This paper presents tools namely PEA ASSESSMENT, to organize and merge two different types of database system from the PQ data result for future of the PEA PQ Data Centre.},
 author = {Waraphok, Phongphat and Saengsuwan, Trin},
 booktitle = {2007 9th International Conference on Electrical Power Quality and Utilisation},
 doi = {10.1109/EPQU.2007.4424199},
 issn = {2150-6655},
 keyword = {Power quality;Monitoring;Database systems;Data analysis;Instruments;Voltage;Power system harmonics;Power measurement;Power system transients;Spatial databases;database system;power quality;merge;software tool},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Database development for power quality in PEA’s distribution system},
 volume = {},
 year = {2007}
}
