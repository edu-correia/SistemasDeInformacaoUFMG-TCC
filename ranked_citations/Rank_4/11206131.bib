@article{11206131,
 abstract = {This study explores how agentic language models (Llama-3.2-3B, Gemma-2-9B, DeepSeek-R1-14B, and Phi-4-14B) detect and refactor test smells. Multiagent workflows outperformed single-agent setups in 3 of 5 cases, with Phi-4-14B achieving the best accuracy and merged open source contributions.},
 author = {Melo, Rian and Simões, Pedro and Gheyi, Rohit and d’Amorim, Marcelo and Ribeiro, Márcio and Soares, Gustavo and Almeida, Eduardo and Soares, Elvys},
 doi = {10.1109/MS.2025.3621356},
 issn = {1937-4194},
 journal = {IEEE Software},
 keyword = {Codes;Logic;Accuracy;Encoding;Testing;Static analysis;Python;Natural language processing;Machine learning;Java;Large language models},
 month = {Jan},
 number = {1},
 pages = {32-40},
 title = {Agentic LMs: Hunting Down Test Smells},
 volume = {43},
 year = {2026}
}
