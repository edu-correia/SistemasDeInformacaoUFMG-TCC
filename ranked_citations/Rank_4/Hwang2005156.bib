@conference{Hwang2005156,
 abstract = {When two competitive companies within the same business sector merge into one bigger company, reusing existing human and technical resources in each company becomes a top priority systems integration task. One of the biggest problems occurring during integration is that the integrated scopes are emergent, and the resulting system's quality factors are not known until the integrated requirements of information software systems are eventually agreed upon and defined through evolution years later after the integration starts. The scopes refer to the domains of business policies, information software systems, business processes, business rules, interface functions, and data that are going to be integrated. To define the right scopes for integration, an iterative and incremental evolutionary top-down framework is used to capture all the requirements at six different scope levels needed to integrate information software systems before any coding is done. Using Transition-Directed Graph (TDG) representation, all identified requirements captured in the six levels of the framework will eventually be represented in a TDG. Five algorithms are developed to identify instances of six categories of requirement faults - Inconsistency, Contradiction, Circularity, Redundancy, Subsumption, and Incompleteness. These five algorithms identifying requirement faults at both local and global detecting levels are efficient. Four correction algorithms are researched and developed to correct five categories of detected faults.},
 author = {Hwang, Yih-Feng and Rine, David C.},
 journal = {WMSCI 2005 - The 9th World Multi-Conference on Systemics, Cybernetics and Informatics, Proceedings},
 note = {Cited by: 0},
 pages = {156 - 161},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integrating information distribution systems: Verification and correction algorithms},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84867388628?origin=resultslist},
 volume = {7},
 year = {2005}
}
