@inproceedings{11140825,
 abstract = {Diabetic retinopathy (DR) is a leading cause of vision loss worldwide, underscoring the critical need for effective DR screening and intervention. Screening via direct ophthalmoscopy is notoriously known for being extremely cumbersome and subjective. This has led to the design of automated systems aimed at fundus image analysis and interpretation. In this work, we propose a novel approach for hierarchical feature fusion, which merges multi-level outputs from ResNet50 and GoogLeNet employing a gated classifier. Intricate lesion details as well as broader retinal features are aimed to be captured by this dual-stream architecture, and the shortcomings of single-model approaches are overcome. Extensive experiments on benchmark DR datasets have validated the method’s effectiveness, with state-of-the-art accuracies of 86.1% on APTOS2019, 88.0% on EyePACS, 84.2% on DDR, 79% on IDRiD, and 81% on Messidor. The strength and improved generalization of the proposed method are thereby confirmed, and its capability to enhance automated DR screening and support clinical decision-making is demonstrated.},
 author = {Basit, Abdul and Gupta, Amriti and Malhotra, Ruchika},
 booktitle = {2025 6th International Conference for Emerging Technology (INCET)},
 doi = {10.1109/INCET64471.2025.11140825},
 issn = {2996-4490},
 keyword = {Diabetic retinopathy;Accuracy;Decision making;Logic gates;Benchmark testing;Feature extraction;Transformers;Retina;Standards;Residual neural networks;Diabetic Retinopathy;Fundus Images;Feature Fusion;GoogleNet;ResNet;Deep Learning},
 month = {May},
 number = {},
 pages = {1-8},
 title = {Gated Feature Fusion Networks for Diabetic Retinopathy Grading},
 volume = {},
 year = {2025}
}
