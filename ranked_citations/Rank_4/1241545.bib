@inproceedings{1241545,
 abstract = {A prototype design of a dual-mode convolutional/turbo code decoder for 3/sup rd/ generation wireless communication systems is proposed. By merging some similar modules exist in the convolutional code and turbo code decoder, we build one dual-mode decoder with these two functions. Besides, in order to conform to the CDMA2000 standard, the architecture can also perform as a reconfigurable Viterbi decoder. It means that our decoder meets the multi code rate and multi generator polynomial convolutional code specification. The final prototyping chip is presented with Avant! 0.35 /spl mu/m standard cell library.},
 author = {Pen-Hsin Chen and Kai-Huang and Nai-Hsuan Hsueh and An-Yeu Wu},
 booktitle = {IEEE International [Systems-on-Chip] SOC Conference, 2003. Proceedings.},
 doi = {10.1109/SOC.2003.1241545},
 issn = {},
 keyword = {Convolutional codes;Turbo codes;Decoding;Very large scale integration;Wireless communication;Convolution;Prototypes;Communication standards;Hardware;Control systems},
 month = {Sep.},
 number = {},
 pages = {369-372},
 title = {Dual-mode convolutional/SOVA based turbo code decoder VLSI design for wireless communication systems},
 volume = {},
 year = {2003}
}
