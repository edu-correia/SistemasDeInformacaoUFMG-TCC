@article{Li201261,
 abstract = {Future applications for embedded systems demand chip with high performances such as computing, throughput and power consumption. Multiprocessor System-on-Chip (MPSoC) is a promising solution to meet the requirements. And embedded devices are designed to support more modern applications, but cost lower in design and products. The key design challenges are designing systems for multiple use-cases and fast exploration of software and hardware implements automatically. In this paper we present an automatical design and synthesis methodology to generate multiprocessor systems in a systemic way for multiple applications. And to support multiple use-cases, Techniques are presented to merge these use-cases onto a hardware architecture. And a desired multiprocessor design is generated with minimal resources cost and short design time, making it suited for fast design exploration in MPSoC systems. The proposed design flow is implemented into a tool DSMAMPS for Xilinx FPGAs. As a case study, the tool is used to carry out design exploration of some typical applications. The experiments results illuminate that our design methodology is a convenient approach to generate the MPSoC design for multiple use-cases.},
 author = {Li, Da and Hou, Yibin and Huang, Zhangqin and Xiao, Chunhua},
 doi = {10.4156/AISS.vol4.issue5.8},
 journal = {Advances in Information Sciences and Service Sciences},
 note = {Cited by: 3},
 number = {5},
 pages = {61 - 69},
 publication_stage = {Final},
 source = {Scopus},
 title = {Auto design and synthesis flow of MPSoC systems for multiple use- cases of applications on FPGA device},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84859322587?origin=resultslist},
 volume = {4},
 year = {2012}
}
