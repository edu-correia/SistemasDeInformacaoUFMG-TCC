@article{SHAKARAMI202211229,
 abstract = {This paper deals with the design of a model-based rapid fault detection and isolation strategy using sliding mode observers. To address this problem, a new scheme is proposed by adaptively combining the information provided by a bank of observers. In this regard, a new structure for sliding mode observers is considered. Then, the well-known recursive least square algorithm is utilized to merge individual state estimations suitably such that the system fault is detected faster. The required condition for enhancing perfect state estimation is derived, and the stability of the overall system is proven via Lyapunov’s direct method. The supremacy of proposed scheme is fully discussed through mathematical analyses as well as simulations.},
 author = {Mehran Shakarami and Kasra Esfandiari},
 doi = {https://doi.org/10.1016/j.jfranklin.2022.09.012},
 issn = {0016-0032},
 journal = {Journal of the Franklin Institute},
 keyword = {Fault reconstruction, Sliding mode observers, Multiple models, Adaptive systems, Stability analysis},
 number = {18},
 pages = {11229-11255},
 title = {Rapid fault reconstruction using a bank of sliding mode observers},
 url = {https://www.sciencedirect.com/science/article/pii/S0016003222006536},
 volume = {359},
 year = {2022}
}
