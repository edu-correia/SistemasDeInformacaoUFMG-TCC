@conference{Kim200811,
 abstract = {MapReduce is Google's programming model for easy development of scalable parallel applications which process huge quantity of data on many clusters. Due to its conveniency and efficiency, MapReduce is used in various applications (e.g., web search services and online analytical processing.) However, there are only few good benchmarks to evaluate MapReduce implementations by realistic testsets. In this paper, we present MRBench that is a benchmark for evaluating MapReduce systems. MRBench focuses on processing business oriented queries and concurrent data modifications. To this end, we build MRBench to deal with large volumes of relational data and execute highly complex queries. By MRBench, users can evaluate the performance of MapReduce systems while varying environmental parameters such as data size and the number of (Map/Reduce) tasks. Our extensive experimental results show that MRBench is a useful tool to benchmark the capability of answering critical business questions. © 2008 IEEE.},
 author = {Kim, Kiyoung and Jeon, Kyungho and Han, Hyuck and Kim, Shin-Gyu and Jung, Hyungsoo and Yeom, Heon Y.},
 doi = {10.1109/ICPADS.2008.70},
 journal = {Proceedings of the International Conference on Parallel and Distributed Systems - ICPADS},
 note = {Cited by: 58},
 pages = {11 - 18},
 publication_stage = {Final},
 source = {Scopus},
 title = {MRBench: A benchmark for Map-Reduce framework},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/60649100037?origin=resultslist},
 year = {2008}
}
