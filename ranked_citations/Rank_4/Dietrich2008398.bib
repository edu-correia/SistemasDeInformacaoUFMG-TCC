@article{Dietrich2008398,
 abstract = {Aiming at a document-centric approach to formalizing and verifying mathematics and software we integrated the proof assistance system ΩMEGA with the standard scientific text-editor <sub>MACS</sub>. The author writes her mathematical document entirely inside the text-editor in a controlled language with formulas in style. The notation specified in such a document is used for both parsing and rendering formulas in the document. To make this approach effectively usable as a real-time application we present an efficient hybrid parsing technique that is able to deal with the scalability problem resulting from modifying or extending notation dynamically. Furthermore, we present incremental methods to quickly verify constructed or modified proof steps by ΩMEGA. If the system detects incomplete or underspecified proof steps, it tries to automatically repair them. For collaborative authoring we propose to manage partially or fully verified documents together with its justifications and notational information centrally in a mathematics repository using an extension of OMDoc. © 2008 Springer-Verlag Berlin Heidelberg.},
 author = {Dietrich, Dominik and Schulz, Ewaryst and Wagner, Marc},
 doi = {10.1007/978-3-540-85110-3_34},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 8},
 pages = {398 - 414},
 publication_stage = {Final},
 source = {Scopus},
 title = {Authoring verified documents by interactive proof construction and verification in text-editors},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/51049112071?origin=resultslist},
 volume = {5144 LNAI},
 year = {2008}
}
