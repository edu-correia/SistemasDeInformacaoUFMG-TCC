@inproceedings{4429168,
 abstract = {This paper proposes a hybrid intermode decision algorithm for H.264 video coding in which the sum of the absolute difference statistics between macroblocks is employed to describe the stationary characteristics of video objects. Two adequate algorithms, namely the zero-block detection algorithm and the bottom-up merging algorithm, are applied to the stationary and non-stationary regions of the video sequences respectively, to reduce the computation. The simulation results reveal that the proposed algorithm can significantly reduce the computation while maintaining high coding efficiency, and greatly outperforms other investigated algorithms in computation for any bit-rate coding.},
 author = {Lee, Y.M. and Lin, Y.},
 booktitle = {TENCON 2007 - 2007 IEEE Region 10 Conference},
 doi = {10.1109/TENCON.2007.4429168},
 issn = {2159-3450},
 keyword = {Video coding;Merging;Video sequences;Detection algorithms;Automatic voltage control;Motion estimation;Rate-distortion;Costs;Discrete cosine transforms;Statistics},
 month = {Oct},
 number = {},
 pages = {1-4},
 title = {Hybrid intermode decision for H.264 video coding},
 volume = {},
 year = {2007}
}
