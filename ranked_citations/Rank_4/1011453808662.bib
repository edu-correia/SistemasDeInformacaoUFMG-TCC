@article{10.1145/3808662,
 abstract = {Distributed tracing is essential for monitoring and debugging services deployed on top of microservice architectures. However, existing solutions face a fundamental trade-off between non-intrusiveness, language/protocol independence, overhead, and accuracy. We present ChainScope, a distributed tracing system that leverages eBPF to establish a universal tracing framework within the kernel. By implementing kernel-level context propagation, ChainScope enables trace-level sampling in a non-intrusive manner, effectively controlling overhead while maintaining high accuracy across diverse service processing models. Evaluation results show that ChainScope achieves better accuracy-overhead trade-offs than existing non-intrusive tracing approaches with up to 2.2\texttimes{} better accuracy, and 1.6\texttimes{} higher end-to-end service throughput in complex scenarios such as asynchronous processing and RPC (Remote Procedure Call) protocols. Furthermore, we demonstrate that ChainScope accurately identifies the root cause of long-tail latency in a realistic use case.},
 address = {New York, NY, USA},
 articleno = {14},
 author = {Hong, Ruipeng and Castellano, Gabriele and Zhang, Jingrun and Sun, Chen and Chen, Pengfei and Gallo, Massimo},
 doi = {10.1145/3808662},
 issue_date = {June 2026},
 journal = {Proc. ACM Netw.},
 keyword = {microservice, distributed tracing, ebpf},
 month = {June},
 number = {CoNEXT2},
 numpages = {21},
 publisher = {Association for Computing Machinery},
 title = {ChainScope: Balancing Accuracy and Overhead in Non-intrusive Distributed Tracing of Microservices},
 url = {https://doi.org/10.1145/3808662},
 volume = {4},
 year = {2026}
}
