@article{Liu20124743,
 abstract = {An improved multi-scale and hierarchical algorithm for vehicle image segmentation is presented, which is to get a minimum similarity across border of sub-segments and a maximum similarity within a segment. This algorithm turns the traditional image segmentation problem into an optimum graph cut question in graph theory. By analyzing features of the neighborhood of pixels during image coarsening process, the algorithm can merge sub-segments according to their inherent similarity to extract vehicle objects from the image. The studied algorithm can make a good performance even under the condition of the poor contrast between the vehicles and the roads or the strong impact of the vehicle light at night. © 2012 International Information Institute.},
 author = {Liu, Zhanwen and Lin, Shan and Dong, Anguo and Qiang, Kenan},
 journal = {Information},
