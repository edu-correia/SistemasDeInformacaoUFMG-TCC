 issn = {2046-6099},
 journal = {Smart and Sustainable Built Environment},
 keyword = {Building information modeling (BIM), Risk identification, Database, Dynamic, Project risk, WBS},
 number = {4},
 pages = {375-393},
 title = {A framework to dynamic identification of project risks},
