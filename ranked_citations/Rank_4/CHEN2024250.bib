@article{CHEN2024250,
 abstract = {With the expanding application of Simultaneous Localization and Mapping (SLAM) in real-world scenarios, collaborative SLAM is increasingly valued for its efficiency over traditional single-agent SLAM. However, the current collaborative SLAM, largely feature-based, has limitations like sparse map construction and poor performance in texture-scarce environments. This paper introduces a novel monocular centralized edge-cloud collaborative SLAM system that integrates the strengths of direct and feature-based SLAM methodologies. The system architecture includes a module for real-time tracking using direct method and another module for feature matching and map construction using feature method. The cloud server plays a pivotal role in maintaining a global map and merging overlapping areas when multiple robots operate in the same environment. Experiments conducted on the EuRoc and TUM datasets demonstrate the system's high tracking rate and superior Absolute Pose Error (APE) performance, showcasing its robustness and reliability across various scenarios.},
 author = {Hongjia Chen and Shilang Chen and Xiangyu Wen and Mingjun Li and Junjun Wu and Yisheng Guan and Weinan Chen},
 doi = {https://doi.org/10.1016/j.procs.2024.11.033},
 issn = {1877-0509},
 journal = {Procedia Computer Science},
 keyword = {SLAM, Direct Method, Feature Method, Edge-Cloud Collaboration, Map Merging},
 note = {Proceedings of the 2024 International Conference on Biomimetic Intelligence and Robotics},
 pages = {250-256},
 title = {Monocular Centralized Edge-Cloud Collaborative SLAM Combining Direct and Feature Methods},
 url = {https://www.sciencedirect.com/science/article/pii/S1877050924032435},
 volume = {250},
 year = {2024}
}
