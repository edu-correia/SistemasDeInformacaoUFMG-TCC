@conference{Sarschar202694,
 abstract = {While previous research has demonstrated the ability of Large Language Models (LLM) to generate code, the achieved tasks so far were rather limited: LLM were used, detached from the overall software development process, to solve (rather simple) problems, which are not necessarily realistic, and generate standalone code snippets, which still need to be integrated into the code base. Other steps of modern, agile software development, in particular continuous integration / continuous delivery (CI/CD), are not yet supported sufficiently. In this paper, we present Pipeline for Automated Code Generation from Backlog Items (PACGBI), an LLM-assisted pipeline for the GitLab CI/CD. It can read a web front end related backlog item in the code repository, automatically generate React code to implement the item, and create a merge request for the generated changes. Based on a case study including both automatic and manual assessment of the generated code, we discuss the potentials and limitations of leveraging the power of LLMs to automate front end development and achieve a more efficient CI/CD. © 2025 Copyright held by the owner/author(s).},
 author = {Sarschar, Mahja and Zhang, Gefei and Nowak, Annika},
 doi = {10.1145/3779657.3779672},
 journal = {WSSE 2025 - 2025 The 7th World Symposium on Software Engineering},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {94 - 103},
 publication_stage = {Final},
 source = {Scopus},
 title = {PACGBI: A CI/CD Pipeline for LLM-assisted Code Generation of Web Front End},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105037758093?origin=resultslist},
 year = {2026}
}
