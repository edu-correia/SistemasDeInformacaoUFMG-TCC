@article{Batsuuri2007365,
 abstract = {This paper presents a new co-simulation framework supporting system level power estimation. The goal of this work is to support precise power estimation in the early design stage. The proposed cosimulation provides a guideline to reduce the power dissipation for a SoC design. This approach resulted in energy saving of 61% for redesigned medium access control processors while code size increased by 14%. The accuracy of the power estimation obtained from the proposed framework was around 94.9%. The contribution of the proposed framework was a straightforward method to merge system level power estimation techniques into the system level design environment. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Batsuuri, Tseesuren and Lee, Je-Hoon and Cho, Kyoung-Rok},
 doi = {10.1007/978-3-540-73625-7_38},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {365 - 374},
 publication_stage = {Final},
 source = {Scopus},
 title = {Power efficient co-simulation framework for a wireless application using platform based SoC},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/38149133041?origin=resultslist},
 volume = {4599 LNCS},
 year = {2007}
}
