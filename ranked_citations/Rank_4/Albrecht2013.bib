@conference{Albrecht2013,
 abstract = {Large organizations load much of their data into data warehouses for subsequent querying, analysis, and data mining. Extract-Transform-Load (ETL) workflows populate those data warehouses with data from various data sources by specifying and executing a set of transformations forming a directed acyclic transformation graph (DAG). Over time, hundreds of individual ETL workflows evolve as new sources and new requirements are integrated continuously into the system. Managing these, often complex, ETL workflows is a daunting task. We built an ETL management framework to improve this difficult task by providing high-level operations, such as searching, matching, or merging ETL workflows. In this paper, we present our lessons learned throughout the implementation of a prototypical ETL management framework. We discuss our observations and experiences and highlight selected suggestions and algorithms, which we propose to be suitable for building useful ETL management operators. © 2013 MIT Information Quality Program. All rights reserved.},
 author = {Albrecht, Alexander and Naumann, Felix},
 journal = {Proceedings of the 18th International Conference on Information Quality, ICIQ 2013},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Systematic ETL management – Experiences with high-level operators},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85084159999?origin=resultslist},
 year = {2013}
}
