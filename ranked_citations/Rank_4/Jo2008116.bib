@conference{Jo2008116,
 abstract = {In this paper, we present a new cooperative localization technique based on CP (Constraint Propagation) technique for multiple mobile robots sharing position information of each robot. In case of conventional methods such as EKF, it is impossible to guarantee that their estimation matches true value. Here, we propose a method to merge the data of redundant sensors based on constraint propagation techniques that guarantees to include true value in contracted set. Note that CP does not depend on probabilistic decision making process such as EKF. Especially, we apply the constraint propagation technique to localizing mobile robot equipped with wheel encoder, gyro meter, and GPS receiver. In addition, we utilize the correlation between GPS data in common workspace to improve localization performance for multiple robots. Simulation results show that proposed method improve localization performance of multiple robots considerably.},
 author = {Jo, Kyoung-Hwan and Lee, Jihong and Kim, Jiyong},
 journal = {International Conference on Automation, Robotics and Control Systems 2008, ARCS 2008},
 note = {Cited by: 0},
 pages = {116 - 122},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cooperative localization for multiple robots based on constraint propagation technique},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84878141616?origin=resultslist},
 year = {2008}
}
