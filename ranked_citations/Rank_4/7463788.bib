@inproceedings{7463788,
 abstract = {Flash memory is widely adopted in various devices, but several intrinsic characteristics have strong impact on its performance and lifespan. In this paper, we analyze and compare in detail the existing algorithms for the three key components in the Flash Translation Layer, namely address translator, garbage collector, and wear leveler. Currently a major challenge is that existing solutions use different data structures for the three components respectively. In this paper, we motivate our design of a random walk controller, interacting with the three components, which will enable a more efficient mechanism for block management and wear leveling.},
 author = {Lan, Jiani and Wang, Hao and Lou, Xinyuan},
 booktitle = {2015 IEEE International Conference on Smart City/SocialCom/SustainCom (SmartCity)},
 doi = {10.1109/SmartCity.2015.134},
 issn = {},
 keyword = {Flash memories;Microprocessors;Random access memory;Data structures;Reliability;Three-dimensional displays;flash memory;block arrangement;wear leveling},
 month = {Dec},
 number = {},
 pages = {590-597},
 title = {Towards a Random Walk Controller for Block Management and Wear Leveling in Flash Memory},
 volume = {},
 year = {2015}
}
