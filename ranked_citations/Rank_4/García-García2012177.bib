@conference{García-García2012177,
 abstract = {Requirements conciliation can result one of the most expensive and critical tasks in Web development. It particularly depends on analysts' experiences since very frequently they have to use manual solution to cope with requirements conciliation. After some previous work presenting an approach oriented towards Web requirements conciliation, this paper proposes a tool for executing this task. It is based on the Model-driven paradigm and it is included in the context of NDT (Navigational Development Techniques) methodology. © 2012 ACM.},
 author = {García-García, J.A. and Escalona, M.J. and Ravel, E. and Rossi, G. and Urbieta, M.},
 doi = {10.1145/2428736.2428765},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 11},
 pages = {177 - 186},
 publication_stage = {Final},
 source = {Scopus},
 title = {NDT-merge: A future tool for conciliating software requirements in MDE environments},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84873328688?origin=resultslist},
 year = {2012}
}
