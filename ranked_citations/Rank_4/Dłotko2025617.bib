 pages = {617 - 670},
 publication_stage = {Final},
 source = {Scopus},
 title = {COMBINATORIAL TOPOLOGICAL MODELS FOR PHYLOGENETIC NETWORKS AND THE MERGEGRAM INVARIANT},
 type = {Article},
