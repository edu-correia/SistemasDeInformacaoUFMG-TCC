@conference{Nabec2016,
 abstract = {To reduce the gap between high-level functional descriptions and real-time multitasking implementation, this paper proposes a set of modeling and code generation principles. Modeling principles are based on integration of a specific BIP concurrent component. This component follows a specific behavioral pattern based on periodic activation of data consumption, data processing and data production. It acts as a periodic task at execution stage. The pattern proposes two variants for eventtriggered and time-triggered platforms. The approach has been tested on three case studies, showing the interest of formalization for behavioral verification. The proposed pattern allows real-time validation and offers classical advantages of high-level modeling. © 2016 ECSI.},
 author = {Nabec, Briag Le and Hedia, Belgacem Ben and Babau, Jean-Philippe and Jan, Mathieu and Guesmi, Hela},
 doi = {10.1109/FDL.2016.7880385},
 journal = {Forum on Specification and Design Languages},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Modeling legacy code with BIP: How to reduce the gap between formal description and real-time implementation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85017102595?origin=resultslist},
 volume = {0},
 year = {2016}
