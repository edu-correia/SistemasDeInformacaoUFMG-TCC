@conference{Park2015111,
 abstract = {This paper presents a multi-strategy and multi-source question answering (QA) system that can use multiple strategies to both answer natural language (NL) questions and respond to keywords. We use multiple information sources including curated knowledge base, raw text, auto-generated triples, and NL processing results. We develop open semantic answer type detector for answer merging and improve previous developed single QA modules such as knowledge base based QA, information retrieval based QA. © 2015 NAACL-HLT 2015 - 2015 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies - Demonstrations,  Proceedings. All Rights Reserved.},
 author = {Park, Seonyeong and Kwon, Soonchoul and Kim, Byungsoo and Han, Sangdo and Shim, Hyosup and Lee, Gary Geunbae},
 journal = {NAACL-HLT 2015 - 2015 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies - Demonstrations,  Proceedings},
 note = {Cited by: 10},
 pages = {111 - 115},
 publication_stage = {Final},
 source = {Scopus},
 title = {Question answering system using multiple information source and open type answer merge},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85027417441?origin=resultslist},
 year = {2015}
}
