@article{10.5555/2835476.2835477,
 abstract = {As development cycles shrink, and communication with users gets easier, our products will be increasingly the result of collaboration between designers and users. Already we are seeing this practice in open source software, wikis, blogs, and social media. As product development changes, the role of the designer must change too. In addition to their current responsibilities, designers will join users in supporting and curating changes, and most importantly, will provide the structures for users collectively to achieve adequate convergence in the face of disparate yet interacting needs.},
 address = {Bloomingdale, IL},
 author = {Henderson, Austin and Harris, Jed},
 issue_date = {February 2012},
 journal = {J. Usability Studies},
 month = {February},
 number = {2},
 numpages = {5},
 pages = {51–55},
 publisher = {Usability Professionals' Association},
 title = {Curating evolution},
 volume = {7},
 year = {2012}
}
