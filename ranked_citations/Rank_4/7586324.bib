@inproceedings{7586324,
 abstract = {Ontology plays a vital role in teaching and learning. In the last decade most of the learning sites were trying to adopt semantic web techniques to develop the learning materials. It is easy to visualize the concepts that are developed in ontology in an effective manner. In this article a multilingual ontology is developed to teach Tamil literary, Thirukkural by espousing the features of ontology. It is one of the famous Tamil literary in the world and has been translated into more than 80 languages. Three ontologies are developed for Thirukkural in Tamil, English and Hindi languages and they are merged into a single ontology. The relationships between the classes are established by mapping the ontologies.},
 author = {Lourdusamy, Ravi and Joseph, Merlin Florrence},
 booktitle = {2016 3rd International Conference on Advanced Computing and Communication Systems (ICACCS)},
 doi = {10.1109/ICACCS.2016.7586324},
 issn = {},
 keyword = {Ontologies;Adaptation models;Maintenance engineering;Buildings;Sections;Government;Multilingual ontology;Ontology merging;Ontology mapping},
 month = {Jan},
 number = {},
 pages = {1-4},
 title = {A multilingual ontology for Tamil Literary works},
 volume = {01},
 year = {2016}
}
