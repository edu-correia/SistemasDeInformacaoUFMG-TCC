@inproceedings{11101189,
 abstract = {Fine-tuning of Large Language Models (LLMs) for downstream tasks, performed on domain-specific data has shown significant promise. However, commercial use of such LLMs is limited by the high computational cost required for their deployment at scale. On the other hand, small Language Models (LMs) are much more cost effective but have subpar performance in a similar setup. This paper presents our approach to fine-tuning a small LM, that reaches high accuracy in multiple-choice question answering task. We achieve this by improving data quality at each stage of the LM training pipeline. In particular, we start with data structuring resulting in extraction of compact, semantically meaningful text chunks used by a retriever. This allows more efficient knowledge digestion by the LM. Further, we improve the retrieved context by training a lightweight Chunk Re-Ranker (CRR) that generates more accurate relative relevance chunk scores. Finally, we improve the model generalization ability by merging the models fine-tuned with different parameters on different data subsets. We present detailed procedure descriptions, and corresponding experimental findings that show the improvements of each one of the proposed techniques.},
 author = {Nazarov, Boris and Frolova, Darya and Lubarsky, Yackov and Gaissinski, Alexei and Kisilev, Pavel},
 booktitle = {2024 IEEE Globecom Workshops (GC Wkshps)},
 doi = {10.1109/GCWkshp64532.2024.11101189},
 issn = {2166-0077},
 keyword = {Training;Hands;Accuracy;Data integrity;Large language models;Merging;Pipelines;Data models;Question answering (information retrieval);Data mining;LLM;Telecommunication;model merging;re-ranking;RAG},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {Rethinking Data: Towards Better Performing Domain-Specific Small Language Models},
 volume = {},
 year = {2024}
}
