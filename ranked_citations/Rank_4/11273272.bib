@inproceedings{11273272,
 abstract = {MetaEdit+ is a mature language workbench that supports merge-free collaborative modeling with user-defined domain-specific modeling languages. We describe how MetaEdit+ supports the Model Management Challenge 2025 (https://doi-org.ez27.periodicos.capes.gov.br/10.5281/zenodo.15285132). The modeling solution presented enables collaborative simultaneous work directly in high-level models, minimizes the effort of modeling and integration, provides fast feedback on changes, keeps artefacts consistent, traceable and up-to-date, and provides hassle-free versioning.},
 author = {Tolvanen, Juha-Pekka and Kelly, Steven},
 booktitle = {2025 ACM/IEEE 28th International Conference on Model Driven Engineering Languages and Systems Companion (MODELS-C)},
 doi = {10.1109/MODELS-C68889.2025.00114},
 issn = {},
 keyword = {Collaboration;Systems modeling;Model driven engineering;Model management;system modeling;MetaEdit+;metamodel;language engineering},
 month = {Oct},
 number = {},
 pages = {698-706},
 title = {Domain-Specific Modeling Solution in MetaEdit+ for the Model Management Challenge},
 volume = {},
 year = {2025}
}
