@inproceedings{1428510,
 abstract = {In this paper, the authors presented another yet approach to a content-delivery mechanism for designing and teaching programming courses. The approach is based on utilizing the electronic adaptive book that delivers just-in-time interactive learning modules to individual students and thus results in a more efficient teaching process. Initially motivated by merging the process of teaching and learning into one integrated environment, the model presented provides customization (instructor's view) and personalization (student's view) of content. This knowledge-transfer environment is assembled using a repository of learning objects. The adaptive book technology allows utilization of any repository of IMS/SCORM compatible content.},
 author = {Adamchik, V. and Gunawardena, A.},
 booktitle = {International Conference on Information Technology: Coding and Computing (ITCC'05) - Volume II},
 doi = {10.1109/ITCC.2005.59},
 issn = {},
 keyword = {Books;Programming profession;Educational programs;Computer aided instruction;Computer science education;Visualization;Merging;Assembly;Collaborative work;Electronic publishing},
 month = {April},
 number = {},
 pages = {488-492 Vol. 1},
 title = {Adaptive book: teaching and learning environment for programming education},
 volume = {1},
 year = {2005}
}
