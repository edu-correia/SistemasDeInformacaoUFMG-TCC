@conference{Lettori2020655,
 abstract = {Additive Manufacturing (AM) technologies have greatly extended design possibilities and freedom. However, in the designer everyday work, the decision regarding the adoption of AM for some components is not straightforward. There is a need to evaluate the properties of the available materials, their compatibility with the specific application, redesign shapes accordingly to additive rather than subtractive or deforming processes, conceive merging components in unique complex multifunctional parts. Indeed, economic, procurement and logistics evaluations, possibly extended to the entire life cycle, are necessary to come to a decision for a new and radical solution. In this context, the paper investigates the complex set of information involved in the process to guide a designer in a structured assessment and evaluation of opportunities for the adoption of AM. The approach includes the analysis of the design requirements to evaluate the applicability of additive technologies. Selected design questions are presented as attention points to help designers in the decision-making process along with a metric to merge the answers in an overall compliance index. Finally, some test cases from the literature and industry are reported to validate the proposed decision process. © 2020 The Authors. Published by Elsevier Ltd. This is an open access article under the CC BY-NC-ND license (https://creativecommons.org/licenses/by-nc-nd/4.0/) Peer-review under responsibility of the scientific committee of the FAIM 2021.},
 author = {Lettori, Jacopo and Raffaeli, Roberto and Peruzzini, Margherita and Schmidt, Juliana and Pellicciari, Marcello},
 doi = {10.1016/j.promfg.2020.10.092},
 journal = {Procedia Manufacturing},
 note = {Cited by: 25; All Open Access; Gold Open Access; Green Open Access},
 pages = {655 - 662},
 publication_stage = {Final},
 source = {Scopus},
 title = {Additive manufacturing adoption in product design: An overview from literature and industry},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85099822657?origin=resultslist},
 volume = {51},
