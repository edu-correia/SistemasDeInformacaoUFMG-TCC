@inproceedings{11368094,
 abstract = {Secure communication for vulnerable groups faces the dual challenge of protecting message content and providing plausible deniability when faced with coercion. Existing encryption methods fail to address scenarios where an adversary can compel key disclosure. Anamorphic techniques which work in those situations have thus far been limited to one-to-one or broadcast settings. This paper proposes a cryptographic system that uniquely merges anamorphic encryption with threshold cryptography to solve this problem in a group context. This work presents a novel protocol that exploits the randomness-recovery property of the RSA-OAEP padding scheme to covertly embed a threshold ElGamal ciphertext within a stream of innocuous primary messages. The proposed protocol ensures that the existence of a secondary, covert message is computationally indistinguishable from standard traffic to any adversary controlling fewer than a predefined threshold of participants. Furthermore, the covert message can only be decrypted when a quorum of $\mathrm{k}$ out of $\mathrm{n}$ group members cooperate, distributing risk and preventing unilateral coercion. This work presents a practical method for achieving deniable, censorship-resistant communication within modern group messaging networks.},
 author = {George, T L and Pathari, Vinod},
 booktitle = {2025 IEEE 17th International Conference on Computational Intelligence and Communication Networks (CICN)},
 doi = {10.1109/CICN67655.2025.11368094},
 issn = {2472-7555},
 keyword = {Privacy;Protocols;Bandwidth;Elliptic curve cryptography;Encryption;Communication networks;Standards;Faces;Computational intelligence;Anamorphic Encryption;Secure Group Communication;Threshold Cryptography;RSA-OAEP;Distributed Key Generation},
 month = {Dec},
