@inproceedings{7129594,
 abstract = {The properties of rateless codes make it very suitable for all types of broadcast systems. In this paper, the rateless codes are adopted in the Next Generation Broadcast Network Wireless (NGB-W) system and two cooperative rateless codes are proposed for two different scenarios in NGB-W system. In the first scenario, different degree distribution functions are adopted for rateless codes encoding in the broadcast tower and base station respectively. The User Terminals (UTs) receive both encoded symbols and merge them for decoding simultaneously. In the second scenario, there is no direct link between the UTs and the broadcast tower. However UTs can receive the symbols from the other nearby UTs. The simulation results show that the cooperation mode can provide lower overhead with good BER performance simultaneously.},
 author = {Hong Tang and Jianing Zhao and Yujiao He and Lijuan Tao},
 booktitle = {10th International Conference on Wireless Communications, Networking and Mobile Computing (WiCOM 2014)},
 doi = {10.1049/ic.2014.0066},
 issn = {},
 keyword = {Cooperative Rateless Codes;LT Codes;NGB-W},
 month = {Sep.},
 number = {},
 pages = {25-30},
 title = {Cooperative rateless codes for NGB-W},
 volume = {},
 year = {2014}
}
