@article{ZHONG2025,
 abstract = {ABSTRACT
The key to managing data as a production factor and allocating it through markets is to synthesize diverse sources into portable, auditable, and priceable data assets. This paper addresses the structural inconsistencies in heterogeneous data integration and formalizes a governance-aware integration pipeline design under the release-centric view. We introduce a six-stage pipeline that emits machine-readable assurance artifacts at each step including versioned schemas, lineage, quality scorecards, and graded-authorization and purpose logs, so that each dataset release carries portable evidence for pricing and liability. Using library logs, open government data, and scholarly metadata, we benchmark against an open rule-based extract-transform-load (ETL) baseline under identical hardware and data. Results show consistent gains along three metric families: quality and effectiveness, with higher matching performance and duplicate detection; structural consistency, via release-level checks that combine schema conformance, functional dependencies, and timestamp constraints with low cross-release drift; cost and efficiency, with reduced latency and compute footprints and an explicit loss budget (retention, policy-screening loss, algorithmic-merge loss) reported per release. Ablation and robustness analyses indicate that dimension reduction and feature sparsification contribute additively and that performance remains stable under noise and time-forward validation. By embedding governance logic into integration mechanics, our proposed method makes an important step towards contractible data assets that can be priced, licensed, and circulated by embedding governance logic into the mechanics of data integration to enable a practical interface to market-based allocation.},
 author = {Weiguo Zhong and Junzhe Wang and Yiqiang Yang},
 doi = {https://doi.org/10.1016/j.jdec.2025.11.002},
 issn = {2773-0670},
 journal = {Journal of Digital Economy},
 keyword = {data as a production factor, data market, heterogeneous multi-source data, governance-aware integration},
 title = {HETEROGENEOUS MULTI-SOURCE DATA INTEGRATION BASED ON THE MECHANISMS OF DATA FACTORIZATION AND MARKETIZATION},
 url = {https://www.sciencedirect.com/science/article/pii/S2773067025000445},
 year = {2025}
}
