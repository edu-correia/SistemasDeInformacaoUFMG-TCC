@conference{Thompson2003F2B1,
 abstract = {This paper discusses a capstone senior design project involving development of a data acquisition system for use in an undergraduate digital signal processing (DSP) course. The project allows undergraduate senior engineering students to merge knowledge of hardware architecture with concepts of Nyquist sampling theorem to explore the relationship between analog and digital signals and develop invaluable insight into the hardware aspects of DSP. The Pentium II PC-based design involves a complete data acquisition system, including a microphone with corresponding conditioning circuitry, an analog-to-digital converter, an 8255 peripheral interface adapter, a user-friendly math intensive software interface, a digital-to-analog converter, and speakers. © 2003 IEEE.},
 author = {Thompson, Elizabeth A. and Acierto, Jonathon and Chavis, Adrian},
 doi = {10.1109/FIE.2003.1264693},
 journal = {Proceedings - Frontiers in Education Conference, FIE},
 note = {Cited by: 0},
 pages = {F2B1 - F2B2},
 publication_stage = {Final},
 source = {Scopus},
 title = {Integration of data acquisition hardware into an undergraduate digital signal processing course via the capstone senior design project},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84946036990?origin=resultslist},
 volume = {2},
 year = {2003}
