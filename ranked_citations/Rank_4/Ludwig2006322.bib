@article{Ludwig2006322,
 abstract = {With parallel file I/O we are faced with the situation that we do not have appropriate tools to get an insight into the I/O server behavior depending on the I/O calls in the corresponding parallel MPI program. We present an approach that allows us to also get event traces from the I/O server environment and to merge them with the client trace. Corresponding events will be matched and visualized. We integrate this functionality into the parallel file system PVFS2 and the MPICH2 tool Jumpshot. © Springer-Verlag Berlin Heidelberg 2006.},
 author = {Ludwig, Thomas and Krempel, Stephan and Kunkel, Julian and Panse, Frank and Withanage, Dulip},
 doi = {10.1007/11846802_45},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 5},
 pages = {322 - 330},
 publication_stage = {Final},
 source = {Scopus},
 title = {Tracing the MPI-IO calls' disk accesses},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33750225089?origin=resultslist},
 volume = {4192 LNCS},
 year = {2006}
}
