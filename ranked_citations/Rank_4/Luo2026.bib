 publication_stage = {Final},
 source = {Scopus},
 title = {Unveiling Risk Reconfiguration in Freeway Merging Areas: A Spatiotemporal Framework for Conflict Prediction and Hotspot Migration in CAV Mixed Traffic},
 type = {Article},
