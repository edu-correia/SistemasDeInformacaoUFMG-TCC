@article{Liu2012243,
 abstract = {As ontology is subjective and varies in different domains, the amount of ontologies turns out to be huge but with poor compatibility. Mainstream method for ontology integration is mostly achieved by establishing mappings between ontologies. In this essay, the author put forward another way of ontology merging. After statistic machine learning on concept relations, the frequency of different ontologies appeared in concept relations reveals certainty factor and help to build a large-scale concept relations network including the statistic information and domain categories, so that the conceptions conveyed by different ontologies can be fused together and the merging concept space turns to be relatively objective. And the experiments results also help to demonstrate the feasibility of the ontology merging. © 2012 ACADEMY PUBLISHER.},
 author = {Liu, Peng and Xu, Chuang and Wang, Xiaoxuan and Wang, Xiaoying and Xu, Gonghua},
 doi = {10.4304/jnw.7.2.243-248},
 journal = {Journal of Networks},
 note = {Cited by: 1},
 number = {2},
 pages = {243 - 248},
 publication_stage = {Final},
 source = {Scopus},
 title = {A statistical amalgamation approach for ontologies},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84863266592?origin=resultslist},
 volume = {7},
 year = {2012}
}
