@conference{Zhu202547004,
 abstract = {Model merging has emerged as a powerful technique for combining task-specific vision models into a unified and multi-functional model. Previous methods represented by task arithmetic, have demonstrated effectiveness and scalability in this domain. When large vision-language models (LVLMs) arise with model size scaling up, this design becomes challenging to fuse different instruction-tuned LVLMs for generalization enhancement. The large scale and multi-modal nature of LVLMs present unique obstacles, including constructing reusable and modular components to accommodate the multi-component architecture of LVLMs and the requirement for dynamic fusion based on multi-modal input tokens. To address these challenges, we propose the REcipe MErging DYnamics (REMEDY) method, a scalable and flexible paradigm for model merging in LVLMs. We first define reusable modules termed recipes including the projector and shallow LLM layers, enhancing visual-language understanding. Then, we introduce a modality-aware allocator dynamically generates weights in a one-shot manner based on input relevance to existing recipes, enabling efficient cross-modal knowledge integration. REMEDY thus offers an adaptive solution for LVLMs to tackle both seen (i.e., multi-task learning) and unseen (i.e., zero-shot generalization) tasks. Experimental results demonstrate that our method consistently improves performance on both seen and unseen tasks, underscoring the effectiveness of REMEDY in diverse multi-modal scenarios. © 2025 13th International Conference on Learning Representations, ICLR 2025. All rights reserved.},
 author = {Zhu, Didi and Song, Yibing and Shen, Tao and Zhao, Ziyu and Yang, Jinluan and Zhang, Min and Wu, Chao},
 journal = {13th International Conference on Learning Representations, ICLR 2025},
 note = {Cited by: 4},
 pages = {47004 - 47022},
 publication_stage = {Final},
 source = {Scopus},
 title = {REMEDY: RECIPE MERGING DYNAMICS IN LARGE VISION-LANGUAGE MODELS},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105010239070?origin=resultslist},
