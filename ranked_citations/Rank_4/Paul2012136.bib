@conference{Paul2012136,
 abstract = {Data Cleaning is a very important part of the data warehouse management process. It is not a very easy process as many different types of unclean data (bad data, incomplete data, typos, etc) can be present. Also, whether a data is clean or dirty is highly dependent on the nature and source of the raw data. Many attempts have been made to clean the data using blocking algorithms, phonetic algorithms, etc. In this paper an attempt has been made to provide a hybrid approach HADCLEAN for cleaning data which combines modified versions of PNRS and Transitive closure algorithms. © 2012 IEEE.},
 author = {Paul, Arindam and Ganesan, Varuni and Challa, Jagat Sesh and Sharma, Yashvardhan},
 doi = {10.1109/InfRKM.2012.6205022},
 journal = {Proceedings - 2012 International Conference on Information Retrieval and Knowledge Management, CAMP'12},
 note = {Cited by: 4},
 pages = {136 - 142},
 publication_stage = {Final},
 source = {Scopus},
 title = {HADCLEAN: A hybrid approach to data cleaning in data warehouses},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84863095974?origin=resultslist},
 year = {2012}
}
