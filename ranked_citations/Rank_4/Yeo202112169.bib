@conference{Yeo202112169,
 abstract = {We present a method for making neural network predictions robust to shifts from the training data distribution. The proposed method is based on making predictions via a diverse set of cues (called 'middle domains') and ensembling them into one strong prediction. The premise of the idea is that predictions made via different cues respond differently to a distribution shift, hence one should be able to merge them into one robust final prediction. We perform the merging in a straightforward but principled manner based on the uncertainty associated with each prediction. The evaluations are performed using multiple tasks and datasets (Taskonomy, Replica, ImageNet, CIFAR) under a wide range of adversarial and non-adversarial distribution shifts which demonstrate the proposed method is considerably more robust than its standard learning counterpart, conventional deep ensembles, and several other baselines. © 2021 IEEE},
 author = {Yeo, Teresa and Kar, Oğuzhan Fatih and Zamir, Amir},
 doi = {10.1109/ICCV48922.2021.01197},
 journal = {Proceedings of the IEEE International Conference on Computer Vision},
 note = {Cited by: 24; All Open Access; Green Open Access},
 pages = {12169 - 12179},
 publication_stage = {Final},
 source = {Scopus},
 title = {Robustness via Cross-Domain Ensembles},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85124642301?origin=resultslist},
 year = {2021}
}
