@inproceedings{5478063,
 abstract = {A mobile device in a MANET must be allocated a free address before it may participate in unicast communication. Current solutions have different drawbacks. This paper proposes a novel address auto-configuration that works with global connected MANET. The proposed scheme may be applied to large scale MANETs with low complexity and low communication overhead. It supports frequent network partitioning and merging, and can efficiently resolve address conflicts in a timely manner whenever they occur. More over, this algorithm can easy to apply to any existing routing protocols with little amendment.},
 author = {Qing, Li},
 booktitle = {2010 2nd IEEE International Conference on Information Management and Engineering},
 doi = {10.1109/ICIME.2010.5478063},
 issn = {},
 keyword = {Mobile ad hoc networks;Internet;IP networks;Partitioning algorithms;Routing protocols;Corporate acquisitions;Ad hoc networks;Large-scale systems;Merging;Wireless communication;Auto-configuration;address allocation;MANET;global connectivity},
 month = {April},
 number = {},
 pages = {244-247},
 title = {An IP address auto-configuration scheme for MANET with global connectivity},
 volume = {},
 year = {2010}
}
