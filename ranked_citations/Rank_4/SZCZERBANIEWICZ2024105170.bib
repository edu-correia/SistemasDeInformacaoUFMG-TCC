@article{SZCZERBANIEWICZ2024105170,
 abstract = {Objectives
Four-dimensional virtual patient is a simulation model integrating multiple static and dynamic data. The most common method is to gather the data on the position and orientation of the patient face or teeth and merge them with dynamic data gathered from the 3D macro-movement of the mandible (MM). Unfortunately, little is known about the method and analysis of 3D micromovements of teeth (µM) especially during loading. However, there is lack of validation of the accuracy in the field of 4D virtual patients.
Methods
To overcome these limitations, the novel extraoral scanner called UP-DFA was used with the help of DIC method used in Zeiss suite software. UP-DFA consists of 4 cameras (2 black/white and 2 colour) with integrated lights. The cameras are organised in two 3D sensors one over another.
Results
The upper 3D sensor can record the whole face of the patient with the 25 FPS and the lower 3D sensor can record the fiducial markers placed on every single tooth with 1000 FPS. The acquisition data were sent to Zeiss suite software for further analysis. The system is calibrated and synchronised between cameras and the lights essential for proper recognizing and recording the fiducial markers in the measurable volume.
Conclusion
For the first time in digital dentistry, it is possible to record the 3D µM of every single tooth with 6 DOF with an accuracy of 10 µm with simultaneous 3D MM based on colour video recording of the face or teeth in one common coordinate system.},
 author = {Blazej Szczerbaniewicz and Marcin Kneć and Jan Szczerbaniewicz},
 doi = {https://doi.org/10.1016/j.jdent.2024.105170},
 issn = {0300-5712},
 journal = {Journal of Dentistry},
 keyword = {3D macromovements of the mandible, 3D teeth micromovements, 4D Virtual Patient/Digital Twin, Digital Image Correlation technique, UP-DFA, Zeiss Suite},
 pages = {105170},
 title = {3D teeth micromovements with DIC technique and novel extraoral scanner},
