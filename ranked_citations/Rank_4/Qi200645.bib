@article{Qi200645,
 abstract = {We propose an adaptive approach to merging possibilistic knowledge bases that deploys multiple operators instead of a single operator in the merging process. The merging approach consists of two steps: the splitting step and the combination step. The splitting step splits each knowledge base into two subbases and then in the second step, different classes of subbases are combined using different operators. Our merging approach is applied to knowledge bases which are self-consistent and results in a knowledge base which is also consistent. Two operators are proposed based on two different splitting methods. Both operators result in a possibilistic knowledge base which contains more information than that obtained by the t-conorm (such as the maximum) based merging methods. In the flat case, one of the operators provides a good alternative to syntax-based merging operators in classical logic. © Springer Science+Business Media B.V. 2007.},
 author = {Qi, Guilin and Liu, Weiru and Glass, David H. and Bell, David A.},
 doi = {10.1007/s10472-006-9043-0},
 journal = {Annals of Mathematics and Artificial Intelligence},
 note = {Cited by: 7},
 number = {1-2},
 pages = {45 - 84},
 publication_stage = {Final},
 source = {Scopus},
 title = {A split-combination approach to merging knowledge bases in possibilistic logic},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/34249867142?origin=resultslist},
 volume = {48},
 year = {2006}
}
