@inproceedings{11310938,
 abstract = {Spiking Neural Networks (SNNs) emulate the sparse and event-driven nature of biological neurons, offering significant potential for low-energy and efficient computation. However, the irregular and high-frequency spike activity in deep SNNs can introduce substantial communication and memory overhead. In this work, we present a spike compression method called Frequent Spike Pattern Compression (FSPC) that applies: (1) correlated AER (Address Event Representation) merging to reduce the bitwidth and (2) approximate technique using pattern mining algorithms to perform a lossy compression. Experimental results on benchmark SNN models and datasets demonstrate that our approach achieves up to 31.50 % reduction in spike data size and less than 1.16 % drop in task accuracy when applied between the network's hidden layers.},
 author = {Ganesh, Satvik and Yuga, Hanyu and Wang, Zhishang and Dang, Khanh N.},
 booktitle = {2025 IEEE 18th International Symposium on Embedded Multicore/Many-core Systems-on-Chip (MCSoC)},
 doi = {10.1109/MCSoC67473.2025.00068},
 issn = {2771-3075},
 keyword = {Training;Accuracy;Runtime;Neuromorphics;Multicore processing;Neurons;Merging;Spiking neural networks;Data models;Data mining;spiking neural network;neuromorphic;address event representation;spike;compression},
 month = {Dec},
 number = {},
 pages = {386-393},
 title = {FSPC: A Lossy Spike Compression Through Correlated-AER Merging in Spiking Neural Networks},
 volume = {},
 year = {2025}
}
