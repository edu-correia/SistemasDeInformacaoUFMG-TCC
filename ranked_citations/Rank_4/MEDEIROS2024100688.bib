@article{MEDEIROS2024100688,
 abstract = {Software Product Line Engineering (SPLE) involves developing multiple software variants with shared features, aiming for reuse. This reuse should not be limited to functional features but should also encompass managerial concerns. Among these concerns, implicit feedback is the process of collecting data on how and when software products are used to identify bugs, usability issues, and inform requirement prioritization. This paper introduces FEACKER, an extension to pure::variants, a variant management tool. FEACKER aims to shift feedback practices from individual products to the platform level, aligning with SPLE’s emphasis on systematic reuse.},
 author = {Raul Medeiros and Oscar Díaz and Xabier Garmendia},
 doi = {https://doi.org/10.1016/j.simpa.2024.100688},
 issn = {2665-9638},
 journal = {Software Impacts},
 keyword = {Software product lines, Implicit feedback, Pure::variants, Feature models},
 pages = {100688},
 title = {FEACKER: Platform-based implicit feedback in annotation-based variant management tools},
 url = {https://www.sciencedirect.com/science/article/pii/S2665963824000769},
 volume = {21},
 year = {2024}
}
