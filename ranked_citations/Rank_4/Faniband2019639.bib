@article{Faniband2019639,
 abstract = {Mobile enterprise applications are primarily developed for existing backend enterprise systems and some usage scenarios require storing of large files on the mobile devices.These files range from large PDFs to media files in various formats (MPEG videos).These files needs to be used offline, sometimes updated and shared among users. Present work studied different Mobile Backend as a service (M)BaaS platforms to understand techniques use to handle large file and found that many are either missing the feature or does not handle performance issues for large files. In this paper, we are proposing, NetMob, a mobile synchronization platform that allows resource-limited mobile devices to access large objects from the cloud. This framework is mainly focused on large file handling and has support for both table and objects data models that can be tuned for three consistency semantics, resembling strong, causal and eventual consistency. Experimental results conducted using representative workloads showed that NetMob can handle large files access with the size ranging from 100MB upto 1GB and is able to reduce sync time with object chunking in our experiment settings. © 2018 The Science and Information (SAI) Organization Limited.},
 author = {Faniband, Yunus Parvej and Ishak, Iskandar and Sidi, Fatimah and Jabar, Marzanah A.},
 doi = {10.14569/ijacsa.2019.0100784},
 journal = {International Journal of Advanced Computer Science and Applications},
 note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access},
 number = {7},
 pages = {639 - 650},
 publication_stage = {Final},
 source = {Scopus},
 title = {NetMob: A mobile application development framework with enhanced large objects access for mobile cloud storage service},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85070095544?origin=resultslist},
