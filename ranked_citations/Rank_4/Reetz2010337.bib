@conference{Reetz2010337,
 abstract = {The integration of Wireless Sensor Networks at a global scale is a crucial step on the road to a tighter coupling between the virtual and real world. In a context-aware system with thousands or even millions of data items describing the current situation, it is obvious that this data needs to be filtered and aggregated in order to distribute the detection and processing efficiently. The need to aggregate data exists also from the perspective of the Wireless Sensor Network since energy is limited and there is a strong requirement to reduce communication traffic. Therefore, this paper illustrates the general concept of a context-aware system and explains in detail how to integrate Wireless Sensor Networks in such a system for global usage of information detected by numerous nodes. The concept is proven by implementation, measurements, and a theory of operation. © 2010 IEEE.},
 author = {Reetz, Eike S. and Tönjes, Ralf and Baker, Nigel},
 doi = {10.1109/ISWPC.2010.5483728},
 journal = {ISWPC 2010 - IEEE 5th International Symposium on Wireless Pervasive Computing 2010},
 note = {Cited by: 7},
 pages = {337 - 342},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards global smart spaces: Merge wireless sensor networks into context-aware systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77954770633?origin=resultslist},
 year = {2010}
}
