@inproceedings{7871018,
 abstract = {Intrusion Detection Systems (IDS) are security tools that generate alerts when detecting a malicious activity. The main drawback of IDS is the high number of generated alerts. We propose an approach that integrates the knowledge of several security experts to improve IDS results and reduce the alerts number. The experts' knowledge are expressed in IFO (Instantiated First Order) logic. A new logical knowledge merging algorithm is given. This algorithm takes as input the different experts' knowledge bases and produce a unique knowledge base. The resulted knowledge base is used to filter the IDS alerts. We achieve tests on real IDS alerts.},
 author = {Bouzar-Benlabiod, Lydia and Meziani, Lila and Chebieb, Abdelkrim and Rim, Nacer-Eddine and Mellal, Zakaria},
 booktitle = {2016 International Conference on Collaboration Technologies and Systems (CTS)},
 doi = {10.1109/CTS.2016.0080},
 issn = {},
 keyword = {Merging;Knowledge based systems;Syntactics;Semantics;Correlation;Intrusion detection;Knowledge logical merging;logical representation;Instantiated First Order logic (IFO);alerts correlation;IDS},
 month = {Oct},
 number = {},
 pages = {418-423},
 title = {Experts' Knowledge Merging to Reduce IDS Alerts Number},
 volume = {},
 year = {2016}
}
