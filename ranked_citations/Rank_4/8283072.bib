@inproceedings{8283072,
 abstract = {In the securities industry, there will be risks whether in artificial or procedural transactions, thus risk control is an important task. This system is designed for FTD protocol, shielding the compatibility of different transaction terminals. This research design and realizes the risk control net gap system based on FTD protocol, with the technology of Netfilter and SOCKS5, and Merge RFC classification technology. It establishes the mechanism of ”real-time reporting, real-time monitoring, real-time fusing”, and won't change the original network and software structures. After testing, this system achieves the purpose of risk control without affecting the normal transaction.},
 author = {Guangzhong, Liao and Suo, Wang},
 booktitle = {2017 12th IEEE Conference on Industrial Electronics and Applications (ICIEA)},
 doi = {10.1109/ICIEA.2017.8283072},
 issn = {2158-2297},
 keyword = {Protocols;Filtering;Control systems;Security;Servers;Data models;Contracts;FTD;netfilter;SOCKS5;RFC;risk control},
 month = {June},
 number = {},
 pages = {1477-1481},
 title = {Design and implementation of the risk control net gap system based on FTD protocol},
 volume = {},
 year = {2017}
}
