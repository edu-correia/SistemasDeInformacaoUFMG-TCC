@conference{Pan20058,
 abstract = {In this paper, we describe an approach that automatically computes function change information between consecutive revisions along the revision history of C language projects. Function changes are computed at two abstract levels. First, we compute the textual changes between two function revisions. Computed results include function additions and deletions, and the quantity and the ratio of textual change in changed functions across two revisions. Second, we compute the behavioral changes of functions using program slicing techniques. We use an XML-formatted document to represent computed function change information. The function change information, together with the SCM change log, helps maintainers understand code changes between two revisions. The structured format of the function change information also helps create traceability links between the changes and other artifacts. We describe our prototype implementation for computing function changes, and we evaluate our approach through a case study on the Sed project. Copyright 2005 ACM.},
 author = {Pan, Kai and Whitehead Jr., E. James and Ge, Guozheng},
 doi = {10.1145/1107656.1107659},
 journal = {Proceedings - The 3rd ACM Int. Workshop on Traceability in Emerging Forms of Software Engineering, TEFSE 2005, Held with the 20th IEEE/ACM Int. Conf. Automated Software Engineering, ASE2005},
 note = {Cited by: 1},
 pages = {8 - 13},
 publication_stage = {Final},
 source = {Scopus},
 title = {Textual and behavioral views of function changes},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77954022934?origin=resultslist},
 year = {2005}
}
