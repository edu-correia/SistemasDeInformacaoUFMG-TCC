@inproceedings{7777802,
 abstract = {The IP Multimedia Subsystem (IMS) is a standard network technology merging voice, data, and multimedia services. IMS is well integrated with existing voice and data in wire and wireless networks. To ease the integration with the Telecom and Internet networks, IMS use SIP (Session Initiation Protocol). The main components of IMS are CSCF's and HSS servers. They are responsible of processing and routing messages. Network planning is generally based on loss, average delay and rate calculations. In other side jitter is more difficult to evaluate, but is important to manage for QoS of real-time and interactive services. In this paper we give an analytical model of jitter in IMS network. The results given by the model can be used for determining various parameters in dimensioning traffic.},
 author = {Alassane, B A and Karim, Konate},
 booktitle = {2016 IEEE 7th Annual Ubiquitous Computing, Electronics & Mobile Communication Conference (UEMCON)},
 doi = {10.1109/UEMCON.2016.7777802},
 issn = {},
 keyword = {Jitter;Delays;Analytical models;Quality of service;IP networks;Computers;Multimedia communication;IMS;SIP;CSCF;QoS;JITTER},
 month = {Oct},
 number = {},
 pages = {1-4},
 title = {An analytical jitter model in IMS network},
 volume = {},
 year = {2016}
}
