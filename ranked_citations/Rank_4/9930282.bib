@inproceedings{9930282,
 abstract = {Software developers advance the project process by contributing and discussing on the code platform. Software bot acts as an assistant to help developers deal with repetitive tasks. In this paper, we explore whether the adoption of bots has an impact on developer sentiment and projects progress. We collected issues, pull requests and comments from GitHub popular projects. And we found that human users had significantly reduced positive sentiment in bot-created issues and PRs. The average merging time of the bot-created PRs is significantly shorter than human-created ones. The average solving time of bot-commented issues is significantly longer than human-created ones.},
 author = {Gao, Anze and Chen, Sihao and Wang, Tao and Deng, Jinsheng},
 booktitle = {2022 IEEE 13th International Conference on Software Engineering and Service Science (ICSESS)},
 doi = {10.1109/ICSESS54813.2022.9930282},
 issn = {2327-0594},
 keyword = {Sentiment analysis;Codes;Merging;Chatbots;Software;Behavioral sciences;Task analysis;Software Engineering;Software Bots;Sentiment Analysis},
 month = {Oct},
 number = {},
 pages = {93-96},
 title = {Understanding the Impact of Bots on Developers Sentiment and Project Progress},
 volume = {},
 year = {2022}
}
