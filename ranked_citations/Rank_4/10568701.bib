@inproceedings{10568701,
 abstract = {Fingerprint is a unique pattern developed inside of the hand. It helps to identify a person and secure a lock for personal devices or data. This impression was processed in ways such as verification and identification. Verification is used to verify the two or more fingerprints and identification is used to identify the right human. Cryptography is another data security by using characters, numbers, symbols, etc.In this paper, we merge the cryptography, fingerprint, Delaunay triangulation and Vigenere cipher by using Heptagonal Fuzzy Numbers (HFN).},
 author = {Kavitha, S. and Selvakumari, K.},
