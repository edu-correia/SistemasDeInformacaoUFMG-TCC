 issn = {},
 keyword = {Ciphers;Image matching;Symbols;Fingerprint recognition;Mathematics;Object recognition;STEM;Fingerprint;Cryptography;Delaunay triangulation;HFN},
 month = {April},
 number = {},
 pages = {1-9},
 title = {On Solving Fingerprint Cryptography Using Heptagonal Fuzzy Numbers and Cipher},
 volume = {},
 year = {2024}
