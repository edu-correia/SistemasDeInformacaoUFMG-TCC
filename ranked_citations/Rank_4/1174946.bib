@inproceedings{1174946,
 abstract = {We compare three different approaches to combine heterojunction bipolar transistors (HBTs) and electroabsorption waveguide modulators (EAMs) for building monolithically integrated opto-electronic circuits: A single stage HBT-driver is applied to an EAM load where the HBT layer stack is grown onto the EAM-layer structure. This is compared to a merged integration of HBTs and EAMs with the waveguide inside the transistor layers with separate devices, and a merged device called HBT-EAM. The compact layer structure and processing supports the concept of this merged device.},
 author = {Reimann, T. and Schneider, M. and Neumann, S. and Jager, D. and Tegude, F.-J.},
 booktitle = {The 10th IEEE International Symposium on Electron Devices for Microwave and Optoelectronic Applications},
 doi = {10.1109/EDMO.2002.1174946},
 issn = {},
 keyword = {Heterojunction bipolar transistors;Optical waveguides;Circuits;Voltage;Optical modulation;Optical refraction;Optical variables control;Stimulated emission;Resistors;Waveguide junctions},
 month = {Nov},
 number = {},
 pages = {149-154},
 title = {Different approaches for integrating HBTs and EAMs},
 volume = {},
 year = {2002}
}
