@conference{Fall20211247,
 abstract = {Like any software, domain-specific languages (DSLs) are subject to regularly evolve. One reason to evolve a DSL is when the external libraries it (or its code generator) depends on evolve as well. In current practice, every time a change or addition occurs in the external library, the language engineer has to manually adapt and rebuild the DSL accordingly. In this paper, we propose an approach to evolve DSLs automatically when changes occur in the external libraries they depend on. This provides a seamless evolution to the domain user by reducing the inconsistencies that may arise between the metamodel of the DSL and the generated artifacts. We evaluate the feasibility of our approach on a case study of generating modeling editors where the input/output interactions with the editor are performed through Arduino devices. We show how the DSL can evolve automatically when new Arduino devices and their APIs are available. © 2021 ACM.},
 author = {Fall, Khady and Syriani, Eugene},
 doi = {10.1145/3412841.3441999},
 journal = {Proceedings of the ACM Symposium on Applied Computing},
 note = {Cited by: 1},
 pages = {1247 - 1255},
 publication_stage = {Final},
 source = {Scopus},
 title = {Evolving domain-specific languages depending on external libraries},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85105003529?origin=resultslist},
 year = {2021}
}
