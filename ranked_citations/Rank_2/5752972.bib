@inproceedings{5752972,
 abstract = {This paper proposed a high performance video coding system in redundant wavelet domain. The redundant wavelet transform (RDWT) provides an overcomplete set of coefficients to overcome the conventional wavelet transform shift invariant problem. The RDWT retains all the phase information of wavelet transform and provides multiple prediction possibilities in motion estimation and motion compensation (ME/MC) in wavelet domain. The paper presents a new adaptive partitioning scheme and decision criteria that utilizes more effectively the motion content of a frame in terms of the various block sizes.},
 author = {Suliman, Ahmed and Li, Robert},
 booktitle = {2011 Proceedings of IEEE Southeastcon},
 doi = {10.1109/SECON.2011.5752972},
 issn = {1558-058X},
 keyword = {Discrete wavelet transforms;Correlation;Wavelet domain;Motion compensation;Merging},
 month = {March},
 number = {},
 pages = {390-394},
 title = {Motion compensation in redundant wavelet domain},
 volume = {},
 year = {2011}
}
