@inproceedings{11426123,
 abstract = {Breast cancer diagnosis using histological images is vital in medical imaging. This research evaluates three deep learning approaches-early fusion, late fusion, and transformer-based models for classifying histopathological images using the BACH dataset. Features were extracted using VGG16, InceptionResNetV2, and DenseNet. Individually, VGG16 and InceptionResNetV2 achieved 79% accuracy, while DenseNet reached 72%. The early fusion method, which combines feature maps before classification, slightly improved performance to 80-81%. In contrast, late fusion, which merges predictions from separately trained models through weighted voting, significantly boosted accuracy to 90%. The Swin Transformer, a hierarchical vision transformer, achieved the highest accuracy of 92% by effectively capturing both local and global features in the images. These results demonstrate that fusion strategies improve performance compared to standalone CNN models. Also, the Swin Transformer delivers even higher accuracy and reliability by effectively leveraging both local and global features. The study supports the integration of advanced AI models into diagnostic workflows to enhance breast cancer detection and assist pathologists in clinical decision-making.},
 author = {Athilakshmi, R. and Maragatham, G. and Tamilselvan, M. and Madhan, S. and Karthikeyan, V.Arun and Ravi, HanishKaa},
 booktitle = {2026 Sixth International Conference on Advances in Electrical, Computing, Communications and Sustainable Technologies (ICAECT)},
 doi = {10.1109/ICAECT68478.2026.11426123},
 issn = {},
 keyword = {Deep learning;Accuracy;Pipelines;Merging;Predictive models;Transformers;Feature extraction;Breast cancer;Robustness;Image classification;BACH data;Early fusion;Late fusion;Swin Transformer},
 month = {Jan},
 number = {},
 pages = {1-7},
 title = {Multi-Framework Evaluation for Breast Cancer Classification: From CNNs to Swin Transformer},
