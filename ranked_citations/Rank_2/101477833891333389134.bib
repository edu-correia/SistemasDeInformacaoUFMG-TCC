@article{10.14778/3389133.3389134,
 abstract = {Byte-addressable persistent memory (PM) brings hash tables the potential of low latency, cheap persistence and instant recovery. The recent advent of Intel Optane DC Persistent Memory Modules (DCPMM) further accelerates this trend. Many new hash table designs have been proposed, but most of them were based on emulation and perform sub-optimally on real PM. They were also piece-wise and partial solutions that side-step many important properties, in particular good scalability, high load factor and instant recovery.We present Dash, a holistic approach to building dynamic and scalable hash tables on real PM hardware with all the aforementioned properties. Based on Dash, we adapted two popular dynamic hashing schemes (extendible hashing and linear hashing). On a 24-core machine with Intel Optane DCPMM, we show that compared to state-of-the-art, Dash-enabled hash tables can achieve up to ∼3.9\texttimes{} higher performance with up to over 90% load factor and an instant recovery time of 57ms regardless of data size.},
 author = {Lu, Baotong and Hao, Xiangpeng and Wang, Tianzheng and Lo, Eric},
 doi = {10.14778/3389133.3389134},
 issn = {2150-8097},
 issue_date = {April 2020},
 journal = {Proc. VLDB Endow.},
 month = {April},
 number = {8},
 numpages = {15},
 pages = {1147–1161},
 publisher = {VLDB Endowment},
 title = {Dash: scalable hashing on persistent memory},
 url = {https://doi.org/10.14778/3389133.3389134},
 volume = {13},
 year = {2020}
}
