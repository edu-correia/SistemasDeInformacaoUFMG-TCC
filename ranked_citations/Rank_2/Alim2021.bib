 publication_stage = {Final},
 source = {Scopus},
 title = {CSL+: Scalable Collective Subjective Logic under Multidimensional Uncertainty},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85172896824?origin=resultslist},
 volume = {12},
 year = {2021}
}
