@article{Stewart2011421,
 abstract = {A BSP superstep is a distributed computation comprising a number of simultaneously executing processes which may generate asynchronous messages. A superstep terminates with a barrier which enforces a global synchronisation and delivers all ongoing communications. Multilevel supersteps can utilise barriers in which subsets of processes, interacting through shared memories, are locally synchronised (partitioned synchronisation). In this paper a state-based semantics, closely related to the classical sequential programming model, is derived for distributed BSP with partitioned synchronisation. © 2010 BCS.},
 author = {Stewart, Alan},
 doi = {10.1007/s00165-010-0163-2},
 journal = {Formal Aspects of Computing},
 note = {Cited by: 5; All Open Access; Bronze Open Access; Green Open Access},
 number = {4},
 pages = {421 - 432},
 publication_stage = {Final},
 source = {Scopus},
 title = {A programming model for BSP with partitioned synchronisation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/80054867992?origin=resultslist},
 volume = {23},
 year = {2011}
}
