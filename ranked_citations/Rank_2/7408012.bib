@inproceedings{7408012,
 abstract = {It is a challenging task in the field of computer vision to obtain the hierarchical segmentation for a color image. This paper focuses on the problem of efficiently performing hierarchical segmentation and improving the segmentation precision. We first apply multiscale normalized cut to image pre-segmentation step to replace Voronoi algorithm or watershed transformation. In addition, an improved ultrametric measure method is introduced and employed to merger regions. Finally, the hierarchical segmentation results are obtained and one can get the best segmentation result by using threshold. Experimental results show that the proposed method is able to provide accurate segmentation result with high computational efficiency.},
 author = {Chen, Qiang},
 booktitle = {2015 8th International Congress on Image and Signal Processing (CISP)},
 doi = {10.1109/CISP.2015.7408012},
 issn = {},
 keyword = {Image segmentation;Object segmentation;Algorithm design and analysis;Image edge detection;Merging;Image color analysis;Indexes;image segmentation;hierarchical segmentation;watershed transformation;region merging},
 month = {Oct},
 number = {},
 pages = {934-938},
 title = {Hierarchical segmentation for color images},
 volume = {},
 year = {2015}
}
