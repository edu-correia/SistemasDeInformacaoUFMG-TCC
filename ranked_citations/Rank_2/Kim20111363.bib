@article{Kim20111363,
 abstract = {MRWorkflow is a workflow system for managing and executing large-scale MapReduce applications. MapReduce is a Google's programming model for easy development of scalable parallel applications which process huge quantity of data on many clusters. MapReduce is used in various applications because of its convenience and scalability. Indexing for web search service and online analytical processing are well-known examples of MapReduce. However, there are only a few good workflow systems to execute MapReduce applications automatically. MRWorkflow focuses on not only business applications but also scientific applications which process huge results of scientific applications. To this end, MRWorkflow is designed to store MapReduce objects on a stable repository, retrieve necessary MapReduce objects from the repository, and execute retrieved MapReduce objects automatically. Our experimental results show that MRWorkflow is a very useful workflow system to answer critical business queries. © 2011 International Information Institute.},
 author = {Kim, Shin-Gyu and Han, Hyuck and Yeom, Heon Y.},
 journal = {Information},
 note = {Cited by: 1},
 number = {4},
 pages = {1363 - 1371},
 publication_stage = {Final},
 source = {Scopus},
 title = {MRWorkflow: Design and implementation of a workflow system for MapReduce applications},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84860134221?origin=resultslist},
 volume = {14},
 year = {2011}
}
