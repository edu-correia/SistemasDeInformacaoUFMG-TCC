@article{10.1145/3716501,
 abstract = {To achieve outstanding aspect-level sentiment analysis (ASC), it is crucial to reduce the distance between aspect terms and opinion words. Recently, advanced methods in ASC used graph neural network (GNN)-based methods to leverage the syntactic dependency within the sentence, which can shorten the distance through syntactical dependencies. However, existing approaches that utilize GNNs have difficulty extracting long-distance relations in the dependency tree due to the over-smoothing problem resulting from stacking GNN layers, which limits their ability to detect remote relations. To solve this issue, we propose a Bidirectional Directed Acyclic Graph (BDAG) to reconstruct syntactic dependencies and a Bidirectional Directed Acyclic Graph Neural Network (BDAGNN) to efficiently propagate multi-hop sentiment information. We also enhance the BDAG with affective commonsense knowledge from SenticNet for comprehensive sentiment classification. The BDAGNN we proposed obtains partial state-of-the-art performance on four benchmark datasets, indicating the feasibility of encoding syntactic structures with BDAG.},
 address = {New York, NY, USA},
 articleno = {33},
 author = {Xu, Junjie and Xiao, Luwei and Wu, Anran and Ma, Tianlong and Dong, Daoguo and He, Liang},
 doi = {10.1145/3716501},
 issn = {2375-4699},
 issue_date = {April 2025},
 journal = {ACM Trans. Asian Low-Resour. Lang. Inf. Process.},
 keyword = {Aspect-specific sentiment analysis, affective knowledge, directed acyclic graph},
 month = {March},
 number = {4},
 numpages = {14},
 publisher = {Association for Computing Machinery},
 title = {Bidirectional Directed Acyclic Graph Neural Network for Aspect-level Sentiment Classification},
 url = {https://doi.org/10.1145/3716501},
 volume = {24},
 year = {2025}
}
