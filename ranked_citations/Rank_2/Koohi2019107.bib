@conference{Koohi2019107,
 abstract = {In this paper, the swarm control of a quadrotor swarm comprised of three flight teams' with15 quadrotors was evaluated. This model of control can be performed either by the flight controller software or by the pilot. For this purpose, a prioritization and leader determination system has been employed for each flight group. The positions of flight groups can be changed with respect to each other, and by eliminating the quadrotors it is possible to change the form of flight and merge the flight groups together. The results of different types of maneuvering are provided in the simulations for a separate group as well as the whole swarm. For a better understanding of the flight trajectories and performing Three-Dimensional maneuvers, simulation videos are provided for each section, separately. © 2019 IEEE.},
 author = {Koohi, Mohammad Ranjbari and Modarresi Asem, Morteza},
 doi = {10.1109/CCWC.2019.8666590},
 journal = {2019 IEEE 9th Annual Computing and Communication Workshop and Conference, CCWC 2019},
 note = {Cited by: 0},
 pages = {107 - 113},
 publication_stage = {Final},
 source = {Scopus},
 title = {An impressive method for performing fixed and variable flight maneuvers by a pilot on a swarm comprised of several groups of quadrotors},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85063869264?origin=resultslist},
 year = {2019}
