@conference{Todorov2009177,
 abstract = {Instance-based ontologymapping comprises a collection of theoretical approaches and applications for identifying the implicit semantic similarities between two ontologies on the basis of the instances that populate their concepts. The current paper situates this general problem in the realm of finding mappings between the nodes of two different webdirectories populated with text documents (the web pages that they intend to organize). We propose a novel approach to detect potential concept mappings based on Principle Component Analysis and Discriminant Analysis and introduce a resulting concept similarity measure. The procedure can be used as an independent concept mapping technique, or as a support to a concept similarity measure of other nature. © 2009 IEEE.},
 author = {Todorov, Konstantin},
 doi = {10.1109/ICIW.2009.33},
 journal = {Proceedings of the 2009 4th International Conference on Internet and Web Applications and Services, ICIW 2009},
 note = {Cited by: 3},
 pages = {177 - 182},
 publication_stage = {Final},
 source = {Scopus},
 title = {Detecting ontology mappings via descriptive statistical methods},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70349977004?origin=resultslist},
 year = {2009}
}
