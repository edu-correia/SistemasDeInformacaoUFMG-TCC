@article{Zhou2013215,
 abstract = {We present a novel particle-based method for stable simulation of elasto-plastic materials. The main contribution of our method is an implicit numerical integrator, using a physically-based model, for computing particles that undergo both elastic and plastic deformations. The main advantage of our implicit integrator is that it allows the use of large time steps while still preserving stable and physically plausible simulation results. As a key component of our algorithm, at each time step we compute the particle positions and velocities based on a sparse linear system, which we solve efficiently on the graphics hardware. Compared to existing techniques, our method allows for a much wider range of stiffness and plasticity settings. In addition, our method can significantly reduce the computation cost for certain range of material types. We demonstrate fast and stable simulations for a variety of elasto-plastic materials, ranging from highly stiffelastic materials to highly plastic ones. © 2013 The Eurographics Association and John Wiley & Sons Ltd.},
 author = {Zhou, Yahan and Lun, Zhaoliang and Kalogerakis, Evangelos and Wang, Rui},
 doi = {10.1111/cgf.12229},
 journal = {Computer Graphics Forum},
 note = {Cited by: 12},
 number = {7},
 pages = {215 - 223},
 publication_stage = {Final},
 source = {Scopus},
 title = {Implicit integration for particle-based simulation of elasto-plastic solids},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84888602250?origin=resultslist},
 volume = {32},
 year = {2013}
}
