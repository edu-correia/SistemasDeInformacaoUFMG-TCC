@article{Zuwala2006518,
 abstract = {In this paper we propose a new approach to find symbols in graphical documents. The method is based on a representation of the document in chain points extracted from the skeleton. We merge successively these chain points into a dendrogram framework and according to a measure of density. From the dendrogram, we extract potential symbols which can be recognized after. © Springer-Verlag Berlin Heidelberg 2006.},
 author = {Zuwala, Daniel and Tabbone, Salvatore},
 doi = {10.1007/11669487_46},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 19; All Open Access; Bronze Open Access},
 pages = {518 - 528},
 publication_stage = {Final},
 source = {Scopus},
 title = {A method for symbol spotting in graphical documents},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33745565468?origin=resultslist},
 volume = {3872 LNCS},
 year = {2006}
}
