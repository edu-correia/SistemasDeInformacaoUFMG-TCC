@conference{Meena2009473,
 abstract = {We present the design principles of Rank Based Merge Sorting Network (RBMSN) architectures for the realization of 2D median and morphological filters used in image preprocessing. The proposed architectures focus on optimization strategies for sorting in terms of the number of comparators and throughput. The minimization in the computational cost is achieved by rank range based merging, column sorting and storing the sorted elements of the overlapping columns of the consecutive windows at each intermediate stage of the sorting network. The proposed architecture uses the concepts of pipelining and grain level parallelism to accomplish the task of processing one pixel per clock cycle. The architectures for median erosion and dilation filters are synthesized for 3x3 and 5x5 window sizes. The proposed RBMSN Median filter architectures for N-√N×√N window size require N/2(Log <sub>2</sub> N) comparators and √N(√N-1),memory registers. The proposed design and implementations are compared with a few of the reported architectures. © 2009 IEEE.},
 author = {Meena, S.M. and Linganagouda, K.},
 doi = {10.1109/IADCC.2009.4809057},
 journal = {2009 IEEE International Advance Computing Conference, IACC 2009},
 note = {Cited by: 3},
 pages = {473 - 479},
 publication_stage = {Final},
 source = {Scopus},
 title = {Rank based merge sorting network architecture for 2d median and morphological filters},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/66249135319?origin=resultslist},
 year = {2009}
}
