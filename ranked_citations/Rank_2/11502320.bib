@inproceedings{11502320,
 abstract = {Conventional iterative topology optimization algorithms have demonstrated a progressive lack of computation efficiency, shape sensitivity, and flexibility to a variety of constraints, thus being hard to satisfy the demands of high-speed design and engineering. In this regard, this paper suggests a topology optimization algorithm that is lightweight and intelligent to solve the issue of expensive span structures by merging topology optimization and deep learning. The approach is a combination of topology prediction using data and physical constraint optimization in order to obtain efficient search and optimization of structural morphology. A multi-objective topology optimization model based on a lightweight is built and a deep learning model is presented to predict the original form of the topology of the structure. The deep learning results are incorporated into the process of topology optimization iteration through a loss-guided update strategy to expedite the convergence of the topology optimization and enhance optimization stability. In case of complex constraints like multiple loads, multiple operating conditions, nonlinearities in the material and geometry, and manufacturability, a collaborative intelligent topology optimization framework is developed. As indicated by experimental findings, the proposed technique performs better than conventional topology optimization techniques in efficiency and structural lightweighting as well as manufacturability. The method proposed (Method C), the one that combines both prediction and guided updates, only takes 61 iterations and has the total computation time of 178.1 s, which is about 57.0 % and 56.0 % less than the original approaches. Method C decreased the weight to 1103 kg with a volume fraction of 0.36, and these are about 11.6 and 14.3 percent, respectively. These findings confirm the validity and engineering implementation opportunity of the suggested approach in intelligent form-finding in lightweight, large-span buildings.},
 author = {Li, Hongchao and Yang, Mengmeng},
 booktitle = {2026 IEEE 15th International Conference on Communication Systems and Network Technologies (CSNT)},
 doi = {10.1109/CSNT69054.2026.11502320},
 issn = {2473-5655},
 keyword = {Antennas and propagation;Antennas;Communication systems;Protocols;HTTP;Communications technology;Deep learning;Machine learning;Artificial intelligence;Learning (artificial intelligence);Lightweight Large-span Structures;Intelligent Shape Finding;Topology Optimization;Deep Learning;Multi-constraint Optimization},
 month = {April},
 number = {},
 pages = {370-377},
 title = {Intelligent Form Finding for Lightweight Large-Span Structures Based on Topology Optimization and Deep Learning},
