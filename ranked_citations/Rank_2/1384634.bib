@inproceedings{1384634,
 abstract = {This paper focuses on developing techniques and strategies for the analysis and design of sensor and network topologies required to achieve rigid formations of mobile autonomous agents for cooperative tasks. These strategies ensure minimum number of changes in the set of sensing and communication links between agents during splitting and merging operations. That is, in splitting, all the links between agents in the same post-split sub-formation are preserved and a minimum number of links are inserted into each post-split sub-formation to regain minimal rigidity. In merging, all the links in each pre-merged rigid sub-formation are preserved and a minimum number of links are inserted between sub-formations to create one single post-merged minimally rigid formation.},
 author = {Eren, T. and Anderson, B.D.O. and Morse, A.S. and Whiteley, W. and Belhumeur, P.N.},
 booktitle = {Proceedings of the 2004 American Control Conference},
 doi = {10.23919/ACC.2004.1384634},
 issn = {0743-1619},
 keyword = {Merging;Network topology;Underwater vehicles;Mobile robots;Autonomous agents;Mobile communication;Land vehicles;Remotely operated vehicles;Unmanned aerial vehicles;Communication networks},
 month = {June},
 number = {},
 pages = {4951-4956 vol.6},
 title = {Information structures to control formation splitting and merging},
 volume = {6},
 year = {2004}
}
