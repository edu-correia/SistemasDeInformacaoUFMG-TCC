@inproceedings{11155722,
 abstract = {Frequent and large-scale adjustments to protection settings pose new demands for rapid and accurate verification of operational settings. This paper proposes a blockchain data structure-based rapid verification method to achieve precise and swift comparison between benchmark settings on the blockchain and operational settings. First, rapid consistency verification is performed by computing and comparing hash values of operational setting files and on-chain setting files. When inconsistencies occur, the setting file content undergoes structural mapping and vector encoding to generate a Hash Table; a global Merkle tree is constructed via recursive merging algorithms, comparing locally computed tree roots with blockchain-stored roots. Employing a layered hash comparison strategy integrated with XML(eXtensible Markup Language) node topology, the method hierarchically traces discrepancy sources to precisely locate specific setting items and their paths. Tests confirm an average verification time of 42.67 ms per setting file, significantly enhancing the efficiency of protection setting verification and management.},
 author = {Zhang, Yongjie and Shuai, Zhexuan and Li, Tianshu and Li, Congcong and Tang, Yi and Li, Yudun},
 booktitle = {2025 7th International Conference on Energy Systems and Electrical Power (ICESEP)},
 doi = {10.1109/ICESEP66633.2025.11155722},
 issn = {},
 keyword = {Renewable energy sources;Merging;Protective relaying;XML;Manuals;Vectors;Power grids;Blockchains;Topology;Protection;Protection Setting File Management;Protection Setting Verification;Blockchain;Merkle Tree;Hash Algorithm},
 month = {June},
 number = {},
 pages = {1346-1350},
 title = {Blockchain Data Structure-Based Verification Method for Relay Protection Setting File},
 volume = {},
 year = {2025}
}
