@inproceedings{4712063,
 abstract = {A key challenge in tracking moving objects is the correspondence problem, that is, the correct propagation of object labels from one time step to another. This is especially true when the objects are non-rigid structures, changing shape, and merging and splitting over time. In this work, we describe a general approach to tracking thousands of non-rigid structures in an image sequence. We show how we can minimize memory requirements and generate accurate results while working with only two frames of the sequence at a time. We demonstrate our results using data from computer simulations of a fluid-mix problem.},
 author = {Gezahegne, Abel and Kamath, Chandrika},
 booktitle = {2008 15th IEEE International Conference on Image Processing},
 doi = {10.1109/ICIP.2008.4712063},
 issn = {2381-8549},
 keyword = {Computer simulation;Shape;Laboratories;Merging;Image sequences;Surveillance;Computer vision;Meteorology;Combustion;Computational fluid dynamics;tracking;non-rigid structures;correspondence problem},
 month = {Oct},
 number = {},
 pages = {1548-1551},
 title = {Tracking non-rigid structures in computer simulations},
 volume = {},
 year = {2008}
}
