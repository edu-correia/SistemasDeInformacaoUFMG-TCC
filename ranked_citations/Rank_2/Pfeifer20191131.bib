@conference{Pfeifer20191131,
 abstract = {GNSS localization is an important part of today's autonomous systems, although it suffers from non-Gaussian errors caused by non-line-of-sight effects. Recent methods are able to mitigate these effects by including the corresponding distributions in the sensor fusion algorithm. However, these approaches require prior knowledge about the sensor's distribution, which is often not available. We introduce a novel sensor fusion algorithm based on variational Bayesian inference, that is able to approximate the true distribution with a Gaussian mixture model and to learn its parametrization online. The proposed Incremental Variational Mixture algorithm automatically adapts the number of mixture components to the complexity of the measurement's error distribution. We compare the proposed algorithm against current state-of-the-art approaches using a collection of open access real world datasets and demonstrate its superior localization accuracy. © 2019 IEEE.},
 author = {Pfeifer, Tim and Protzel, Peter},
 doi = {10.1109/IVS.2019.8813847},
 journal = {IEEE Intelligent Vehicles Symposium, Proceedings},
 note = {Cited by: 8; All Open Access; Green Open Access},
 pages = {1131 - 1138},
 publication_stage = {Final},
 source = {Scopus},
 title = {Incrementally learned Mixture Models for GNSS Localization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85072271455?origin=resultslist},
 volume = {2019-June},
 year = {2019}
}
