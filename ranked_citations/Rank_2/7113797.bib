@article{7113797,
 abstract = {To operate the network efficiently and reduce operational expenditures, self-organization becomes a key feature especially for dense-deployed small cell networks. This letter proposes a coalition game based resource allocation algorithm (CG-CRA) to enable self-healing and compensate abrupt cell outage in small cell networks. In the proposed algorithm, small cells play coalition games to form a set of coalitions which determines the allocation of subchannels, and each coalition of small cells serves a user cooperatively with optimized power allocation. Simulation results show that, the proposed algorithm can effectively solve network failure problem. In addition, all users are served fairly and network resources are efficiently utilized at the same time.},
 author = {Fan, Shaoshuai and Tian, Hui},
 doi = {10.1109/LCOMM.2015.2433268},
 issn = {1558-2558},
 journal = {IEEE Communications Letters},
 keyword = {Resource management;Games;Optimization;Computer architecture;Interference;Microprocessors;Signal to noise ratio;Self-organizing network;self-healing;cooperative resource allocation;coalition game;Self-organizing network;self-healing;cooperative resource allocation;coalition game},
 month = {July},
 number = {7},
 pages = {1221-1224},
 title = {Cooperative Resource Allocation for Self-Healing in Small Cell Networks},
 volume = {19},
 year = {2015}
}
