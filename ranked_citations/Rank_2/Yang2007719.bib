@conference{Yang2007719,
 abstract = {Image fusion provides the means to integrate multiple images into a composite image which is more suitable for the purpose of human and machine perception or further image-processing tasks. This paper presents the use of nonsubsampled contourlet transform (NSCT) for image fusion. All the input images are decomposed firstly. Then the decomposition coefficients on the different scale are combined using different rule, and the fusion image is obtained by taking the corresponding inverse nonsubsampled contourlet transform of the fused coefficients. Some performance measures are used to evaluate the results. Extensive experimental results show that the proposed scheme performs better than the method based on the stationary wavelet transform (SWT). © 2007 IEEE.},
 author = {Yang, Bin and Li, Shutao and Sun, Fengmei},
 doi = {10.1109/ICIG.2007.124},
 journal = {Proceedings of the 4th International Conference on Image and Graphics, ICIG 2007},
 note = {Cited by: 107},
 pages = {719 - 724},
 publication_stage = {Final},
 source = {Scopus},
 title = {Image fusion using nonsubsampled contourlet transform},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/47349092080?origin=resultslist},
 year = {2007}
}
