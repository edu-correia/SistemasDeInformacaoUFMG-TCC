@article{LIN2025127560,
 abstract = {Nonnegative matrix factorization (NMF) as a powerful representation learning technique has been extensively applied in clustering tasks across diverse domains, leading to the proliferation of various NMF-based clustering methods. However, most of these methods suffer from the suboptimal performance arising from the disjointed process of representation learning and clustering, and the necessity to manually predetermine the optimal number of clusters which is a critical factor affecting the quality of clustering results. To fill this gap and inspired by convex clustering, we propose a simple yet effective NMF-based clustering method named Representation Auto-fused NMF based Hierarchical Clustering (RAFNMF-HC) by incorporating the l2 norm penalty on the differences between pairs of representations into the NMF framework to foster the automatic fusion of representations during representation learning. As the fusion continuously proceeds, similar representations gradually coalesce into small clusters, which subsequently merge into larger ones until a largest cluster encompassing all representations is formed, enabling a joint representation learning and clustering paradigm. Moreover, a cluster hierarchy as a byproduct adaptively emerges without requiring a predefined number of clusters, thus providing us with interpretability of cluster structure of data to some degree. Additionally, RAFNMF-HC only incorporates a single hyperparameter, significantly simplifying the adjustment process and boosting its practical efficiency. Our proposed RAFNMF-HC method also boasts straightforward scalability to diverse NMF variants, enhancing its versatility. Extensive experiments on various real-world datasets demonstrate the superiority of RAFNMF-HC.},
 author = {Yunxia Lin and Haoyu Hu and Bentian Li and Shuchang Zhao and Hengchang Jing},
 doi = {https://doi.org/10.1016/j.eswa.2025.127560},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Nonnegative matrix factorization (NMF), Clustering, Disjoint representation learning and clustering, Convex clustering, Automatic fusion of representations},
 pages = {127560},
 title = {Representation Auto-fused NMF based Hierarchical Clustering},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417425011820},
 volume = {283},
 year = {2025}
}
