@inproceedings{6424754,
 abstract = {In this study, we will parallelize the D&C algorithm with CUDA. In stead of recursive programming in D&C, the recursive stack is implemented on the host side (CPU) and the merge operation is executes on GPU in parallel. Since the recursive stack is a fully binary tree in this algorithm, the merge operations on the nodes in each layer of the binary tree can be performed synchronously. In this data-parallel computation, with the careful management of data structure, the data of each node can be arranged in the same block and no need to share data between threads, so the parallelism is not broken.},
 author = {Chen, Min-Bin},
 booktitle = {2012 Fifth International Symposium on Parallel Architectures, Algorithms and Programming},
 doi = {10.1109/PAAP.2012.50},
 issn = {2168-3042},
 keyword = {Algorithm design and analysis;Graphics processing units;Computers;Merging;Programming;Binary trees},
 month = {Dec},
 number = {},
 pages = {175-177},
 title = {A Divide-and-Conquer Algorithm of Delaunay Triangulation with GPGPU},
 volume = {},
 year = {2012}
}
