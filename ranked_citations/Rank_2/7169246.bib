@inproceedings{7169246,
 abstract = {On-chip AER serialization is a required step for the successful integration of event-driven neuromorphic devices on complex robotic platforms. We propose an architecture and its implementation on AMS 180nm technology, synthesised with the Quasi-Delay Insensitive design principles and with minimum timing assumptions. The serialization of 19 bits completes in 70ns with an average power consumption of 2.34mW.},
 author = {Rovere, Giovanni and Bartolozzi, Chiara and Imam, Nabil and Manohar, Rajit},
 booktitle = {2015 IEEE International Symposium on Circuits and Systems (ISCAS)},
 doi = {10.1109/ISCAS.2015.7169246},
