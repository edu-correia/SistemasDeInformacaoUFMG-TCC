@inproceedings{10913464,
 abstract = {This study introduces a cost-effective integrated system that significantly enhances the safety and security of autonomous vehicles by merging obstacle avoidance and intru-sion detection functionalities through Internet of Things (loT) technologies. The system employs ultrasonic sensors for accurate obstacle detection, with an Arduino Uno and Raspberry Pi 3 handling data processing and control tasks. Facial recognition technology is incorporated to monitor and identify unauthorized individuals in real time. This integration allows the vehicle to autonomously navigate while also securing itself against potential intruders, all achieved with readily available and affordable components. The system demonstrates strong performance in detecting and avoiding obstacles in straightforward scenarios, although accuracy may diminish in more complex environments. The facial recognition component achieves consistent and re-liable results under controlled conditions. By combining these technologies in a budget-friendly solution, this research offers practical advancements in intelligent and secure autonomous vehicle systems, suitable for applications in various domains including robotics and smart vehicle technology.},
 author = {Talukdar, Md. Shadman Sakib and Rahman Takbir, Mahiyan and Tajnoor Hossain Amrit, Imam and Rahman, Md Mahin and Noor Nabi, Mohammad},
 booktitle = {2024 International Conference on Intelligent Cybernetics Technology & Applications (ICICyTA)},
 doi = {10.1109/ICICYTA64807.2024.10913464},
 issn = {},
 keyword = {Accuracy;Navigation;Face recognition;Intrusion detection;Sensor systems;Real-time systems;Security;Collision avoidance;Autonomous vehicles;Testing;IoT;facial recognition;autonomous;intrusion detection;obstacle avoidance},
 month = {Dec},
 number = {},
 pages = {567-572},
 title = {Cost Effective loT-Based Smart System for Avoidance of Obstacle and Intruder Detection},
 volume = {},
 year = {2024}
}
