@conference{Vidyarthi2014957,
 abstract = {Semantic web represents a technique for getting semantic information from the particular domain ontology. It involves retrieving of the data semantically through domain ontology's based on user queries. Still the merging of two or more domain specific ontology's is a tedious task. In past, various ontology merging algorithms had been anticipated based on the concept of removing overlaps. In this paper a new approach of ontology merging is proposed based on the semantic analysis that deals with same domain specific ontology's. Proposed algorithm is fully automated ontology merging algorithm which uses the class semantics and Property semantics by using Wordnet. © 2014 IEEE.},
 author = {Vidyarthi, Ankit and Sharma, Ankita and Sharma, Hemant and Soni, Archana},
 doi = {10.1109/CONFLUENCE.2014.6949313},
 journal = {Proceedings of the 5th International Conference on Confluence 2014: The Next Generation Information Technology Summit},
 note = {Cited by: 1},
 pages = {957 - 961},
 publication_stage = {Final},
 source = {Scopus},
 title = {Domain specific ontology merging using semantics},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84914141613?origin=resultslist},
 year = {2014}
}
