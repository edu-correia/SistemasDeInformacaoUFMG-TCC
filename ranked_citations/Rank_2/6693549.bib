@inproceedings{6693549,
 abstract = {The Semantic Web, supported by Ontology, is considered as an important evolution to deal with the semantic heterogeneity of the Internet. As different communities build ontologies, it is imperative that methods for mapping and merging of ontologies are developed. This is for achieving the semantic interoperability and assuring relevance in information retrieval. A weighted evaluation approach for ontology integration is considered in this research paper. This work focuses on the semantic layer of ontology mapping. The authors also outline some requirements for a methodology in building ontology in a specific domain, apart from integration.},
 author = {Rajeswari, V. and Selvan, Aravind and Varughese, Dr. Dharmishtan K.},
 booktitle = {2013 IEEE Seventh International Conference on Semantic Computing},
 doi = {10.1109/ICSC.2013.74},
 issn = {},
 keyword = {Ontologies;Semantics;Buildings;Educational institutions;Semantic Web;Conferences;Merging;Heterogeneous Data;Semantic Web;Weighted Evaluation;Ontology Mapping;Heterogeneous Data Integration;Semantic Equivalence;Ontology Integration},
 month = {Sep.},
 number = {},
 pages = {391-392},
 title = {A Novel Method for Ontology Integration by Evaluating Member Equivalence},
 volume = {},
 year = {2013}
}
