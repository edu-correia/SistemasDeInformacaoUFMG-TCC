@conference{Thakur2025935,
 abstract = {Over recent years, the world has been increasingly fundus of renewable energy avenues to respond to the global thirst for electricity. Among these sources, solar photovoltaic (PV) systems have become popular due to their cost and ease of integration. Nevertheless, the irregular nature of PV systems makes it very difficult to merge them with grid-connected systems. In this study, through research, we work towards achieving the dream of utilizing the highest possible renewable energy in a Hybrid grid-connected PV -Biomass System. It can integrate intermittent PV power well with controllable and dispatch able biomass power and has solved many problems for stable and reliable energy supply (grid side). Demand response programs will be used to improve overall system efficiency, allowing consumers to adapt their electricity consumption to the availability of renewable energy. The performance of the proposed system will be benchmarked using simulations for different PV and biomass generation capacities, battery storage, and demand response scenarios. The outcomes will show what the system can achieve regarding increased fossil-free energy use and lower dependence on conventional, fossil-fuel-based energy providers. This study will help create new avenues for sustainable energy and encourage using renewable resources in the electricity grid. © 2025 IEEE.},
 author = {Thakur, Ankita and Abidi, Shabeeh Asghar and Kataria, Ansh and Panda, Monalisa and Jain, Romil and Mithun Kumar, S.},
 doi = {10.1109/AUTOCOM64127.2025.10957088},
 journal = {2025 International Conference on Automation and Computation, AUTOCOM 2025},
 note = {Cited by: 2},
 pages = {935 - 940},
 publication_stage = {Final},
 source = {Scopus},
 title = {Maximizing Renewable Energy Utilization in a Hybrid Grid-Connected PV-Biomass System with Demand Response Strategies},
 type = {Conference paper},
