@inproceedings{10618214,
 abstract = {Depending on conventional finite-difference time-domain (FDTD) method, we develop a scale-compressed technique to implement the rapid calculation for capturing the reflection coefficients and transmission coefficients through multilayered structure under the plane wave. Based on the Maxwell’s curl equations and the corresponding constitutive relationship between the field flux (D, B) and field intensity (E, H), curl operator can be assembled as a transition matrix for different modes when using the transverse wave vectors. After the preliminary analysis, we incorporate and merge the incident field into the curl matrix to derive electric field and magnetic field updating equations with only one upward space variable through grid matching. The required field quantities for updating electromagnetic fields through multilayered media can be clearly demonstrated by combining those fields’ components in these algorithmic equations using matrix representation. Our proposed algorithm achieves one-dimensional (1-D) compression to solve higher-dimensional problems while determining reflection and transmission coefficients under the various transverse wave vectors. With comparison from commercial software COMSOL, we can validate its accuracy and feasibility. As a results, for the complex cases, the proposed algorithm holds more potential applications in exploring multi-layered models under the condition of preset conditions.},
 author = {Kang, Yilin and Feng, Naixing and Zhang, Yuxian and Feng, Xiaoli and Wang, Huan and Fan, Jiuyang and Yang, Lixia and Huang, Zhixiang},
 booktitle = {2024 Photonics & Electromagnetics Research Symposium (PIERS)},
 doi = {10.1109/PIERS62282.2024.10618214},
 issn = {2831-5804},
 keyword = {Accuracy;Software algorithms;Mathematical models;Vectors;Software;Reflection;Reflection coefficient},
 month = {April},
 number = {},
 pages = {1-4},
 title = {Analysis of Transmission Coefficients in Multilayer Media Structures Using Scale Compressed Finite-Difference Time-Domain Method},
 volume = {},
 year = {2024}
}
