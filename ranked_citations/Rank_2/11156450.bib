@inproceedings{11156450,
 abstract = {Humor plays an essential role in human communication, impacting emotions, social interaction, and cultural articulation. In the digital age, memes have arisen as a prevailing form of humorous expression by imaginatively combining text and images. Nevertheless, understanding humor in memes is difficult owing to their inherently multimodal structure and the frequent use of sarcasm, irony, and cultural context. Standard sentiment analysis methods often rely on single-modal inputs and find it difficult to capture this complexity. To tackle these limitations, we suggest the humor-specific multimodal transformer (HSMT) a deep learning architecture that merges visual and textual features using an attention-based fusion mechanism. The model incorporates a bidirectional encoder representation from transformers (BERT)-based text encoder and a ResNet-Based image encoder to capture subtle linguistic and visual hints. Furthermore, we incorporate a dedicated sarcasm detection module to boost interpretation of sentiment conveyed in reverse or ironic ways. Evaluated on the Memotion dataset, HSMT shows significant enhancements in classifying humor-related sentiment compared to baseline models. The model demonstrates practical applicability in areas such as social media monitoring, content moderation, brand analysis, and intelligent conversational systems. Future directions involve multilingual humor detection, real-time meme analysis, and adaptive learning strategies to deal with the changing nature of humor.},
 author = {Saw, Indradev and Sahoo, Soumya and Priyanka, Prachi and Jha, Shashwati and Anand, Arpit},
 booktitle = {2025 International Conference on Innovations in Intelligent Systems: Advancements in Computing, Communication, and Cybersecurity (ISAC3)},
 doi = {10.1109/ISAC364032.2025.11156450},
 issn = {},
 keyword = {Visualization;Sentiment analysis;Adaptation models;Technological innovation;Social networking (online);Transformers;Real-time systems;Global communication;Cultural differences;Standards;Humor Detection;Memes;Multimodal Sentiment Analysis;Transformer;Sarcasm Detection;Deep Learning;Memotion Dataset},
 month = {July},
 number = {},
 pages = {1-6},
 title = {HSTM: Decoding Humor in Memes Through Multimodal Intelligence},
 volume = {},
