@conference{Deng2025,
 abstract = {Current Transformer-based methods typically unwisely represent the entire image at a single granularity. A high-resolution representation of the regions of interest can significantly improve the accuracy of human pose estimation while causing unnecessary computational costs for other regions. To overcome this limitation, we propose an efficient two-stage framework using adaptive Multi-Granularity representation for different important image regions for Human pose estimation (EMGPose). In the first stage, the image is split into coarse-grained patches for simple inference. If without sufficient accuracy, important patches will be resplit into multiple finer-grained patches for the second stage of inference. Furthermore, we propose a new token-merge strategy based on token importance and similarity in Transformer, effectively reducing the computational load from low-information background patches. Extensive experiments demonstrate the excellent performance of the proposed method. Specifically, our model EMGPose-Base achieves 76.3 AP (+0.5 AP) and 62.2 AP (+2.6 AP) and higher efficiency than baseline ViTPose-Base on the COCO validation set and OCHuman test set, respectively. © 2025 IEEE.},
 author = {Deng, Guonan and Lan, Shiyong and Wang, Wenwu and Qiao, Yixin and Li, Yao and Chen, Haohan and Yang, Hongyu},
 doi = {10.1109/ICME59968.2025.11209868},
 journal = {Proceedings - IEEE International Conference on Multimedia and Expo},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {EMGPose: An Efficient Multi-Granularity Representation for Human Pose Estimation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105022648590?origin=resultslist},
 year = {2025}
}
