@inproceedings{11189393,
 abstract = {To ensure the confidentiality and integrity of image data, image encryption is obligatory in modern digital world. In this paper, we have proposed a novel image encryption algorithm using 3-D Logistic chaotic maps, Hash function and LFSR for generation of secret key sequences. Here the original image of size 128*128 is partitioned into four equal parts of size 64*64 each and then repeatedly partitioning each part until we got 2*2. Keys are used on each 2*2 matrix and then merge all 2*2 matrices to form the 128*128 cipher image. Experimental results showed that the proposed encryption scheme reaches optimum parameter values and it is highly sensitive to minor differences in both secret key and plain image. The effectiveness and performance of this proposed method has been evaluated using several assessments, in which the outcomes confirm that the suggested algorithm shows excellent results in Correlation Coefficient analysis, Histogram analysis, NPCR, UACI, Key sensitivity analysis, PSNR and MSE analysis. This indicates that the proposed scheme not only exhibits excellent encryption but also resists various typical attacks.},
 author = {Ghosh, Soubhik and Paul, Atanu Kumar},
 booktitle = {2025 International Conference on Computing, Intelligence, and Application (CIACON)},
 doi = {10.1109/CIACON65473.2025.11189393},
 issn = {},
 keyword = {Hash functions;Correlation coefficient;Histograms;Ciphers;Three-dimensional displays;PSNR;Sensitivity analysis;Encryption;Partitioning algorithms;Logistics;Linear-Feedback Shift Register;Number of Pixel Change Rate;Unified Average Changing Intensity;Peak Signal-To-Noise Ratio;Mean-Square Error},
 month = {July},
 number = {},
 pages = {1-6},
 title = {A Secure Image Encryption Algorithm Based on 3D Logistic Map Hash Function and LFSR},
 volume = {},
 year = {2025}
}
