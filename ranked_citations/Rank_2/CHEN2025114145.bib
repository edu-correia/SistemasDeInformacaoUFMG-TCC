@article{CHEN2025114145,
 abstract = {Developing multifunctional biobased polyurethane adhesives can not only reduce dependence on fossil fuels but also promote the development of the circular economy. Nevertheless, the weak strength, poor toughness, and potential fire hazard severely bottleneck its scale-up application. Drawing inspiration from the structure of pangolin scales, we have developed a sustainable approach for fabricating high-performance flame-retardant biobased polyurethane adhesives with over 70 % biomass content. This was achieved by completely substituting petroleum-based polyols with castor oil and epoxidized lignin. The castor oil-based polyurethane prepolymer as soft flesh dissipates the strain energy through hydrogen and carbamate bonds, while the highly reactive lignin acts as the rigid scales to consolidate the polymer network and reinforce the adhesion. By merging tough cohesion and strong adhesion, the dry shear strength and debonding work of the obtained adhesive are 7.15 MPa and 1.975J, respectively. The aromatic structure rich in lignin confers excellent flame-retardant properties upon the adhesive, resulting in a significant decrease in the heat release rate and total heat release rate of the adhesive by 48 % and 22.5 %, respectively. This innovative approach of high-performance polyurethane adhesives containing high biomass feedstock paves the way for advancing the production and application of biobased polyurethane adhesives.},
 author = {Hongyu Chen and Shicun Jin and Rui Sun and Kuang Li and Licheng Li and Zhaochuan Yu and Zixi Yu and Huining Xiao},
 doi = {https://doi.org/10.1016/j.eurpolymj.2025.114145},
 issn = {0014-3057},
 journal = {European Polymer Journal},
 keyword = {Biobased adhesive, Lignin, Couple hardness with softness},
 pages = {114145},
 title = {Nature-mimetic engineering of sustainable polyurethane adhesives with high bonding strength and flame retardancy},
 url = {https://www.sciencedirect.com/science/article/pii/S0014305725004331},
 volume = {236},
 year = {2025}
}
