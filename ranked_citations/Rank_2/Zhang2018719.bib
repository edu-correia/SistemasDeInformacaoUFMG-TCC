@conference{Zhang2018719,
 abstract = {Key-value store is a type of NoSQL database providing much higher read and write throughput than traditional SQL databases. LSM-tree is a widely used data structure to improve the performance of small write in KV Stores. But its compaction induce to large write amplification. So tiered LSM-tree, which divides each level in LSM-tree implementation into multiple sub-levels to reduce the write amplification. Nowadays, the KV items are frequently updated in many applications, which induces too many stale copies of the same KV items in KV stores, i.e., space amplification. To achieve both low write amplification and low space amplification at the same time, we propose a novel compaction algorithm for tiered LSM-tree and we implemented it on FlameDB, a key-value store. Our experiments show that FlameDB achieves almost the same low space amplification with LevelDB and the comparably low write amplification with LSM-trie. © 2018 IEEE.},
 author = {Zhang, Weitao and Xu, Yinlong},
 doi = {10.1109/ICSESS.2018.8663897},
 journal = {Proceedings of the IEEE International Conference on Software Engineering and Service Sciences, ICSESS},
 note = {Cited by: 1},
 pages = {719 - 722},
 publication_stage = {Final},
 source = {Scopus},
 title = {Deduplication Triggered Compaction for LSM-Tree Based Key-Value Store},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85063645613?origin=resultslist},
 volume = {2018-November},
 year = {2018}
}
