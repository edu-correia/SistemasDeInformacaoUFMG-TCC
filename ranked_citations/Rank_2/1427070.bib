@inproceedings{1427070,
 abstract = {In this paper, we propose a multi-agents system for image understanding. The goal of this system is to be able to localize and recognize some particular objects in a given image. Agents developed are image processing-based and are capable of detecting pre-specified shapes. A detected shape is first described by some invariant features. Theses parameters are then compared with those in the learning database using a supervised classification method. The system is distributed and implemented on a cluster computer with the MPICH2 library. Experimental results of object recognition in images are summarized and analyzed. Relevant observations and conclusions are made along with some possible future works.},
 author = {Choksuriwong, A. and Rosenberger, C. and Smari, W.W.},
 booktitle = {International Conference on Integration of Knowledge Intensive Multi-Agent Systems, 2005.},
 doi = {10.1109/KIMAS.2005.1427070},
 issn = {},
 keyword = {Multiagent systems;Image recognition;Layout;Object detection;Object recognition;Application software;Shape;Image analysis;Pattern recognition;Image processing},
 month = {April},
 number = {},
 pages = {149-154},
 title = {Multi-agents system for image understanding},
 volume = {},
 year = {2005}
}
