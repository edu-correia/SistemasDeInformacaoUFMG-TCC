@inproceedings{9067915,
 abstract = {A new hybrid shape fitting algorithm is presented which fits a selected template shape into a noisy point cloud. The method uses prior knowledge of the object shape, which is given by a Statistical Shape Model (SSM). The method estimates a smooth surface with high accuracy, even if the given point cloud is noisy. Results are compared with other surface reconstruction methods. We also analyze how information from measured point cloud and prior knowledge of the object shape are merged, depending on the amount of noise in the input point cloud. The method is tested on synthetic and real data. For test objects we used simple synthetic objects.},
 author = {Jens, Krenzin and Olaf, Hellwich},
 booktitle = {2019 15th International Conference on Signal-Image Technology & Internet-Based Systems (SITIS)},
 doi = {10.1109/SITIS.2019.00039},
 issn = {},
 keyword = {Shape;Three-dimensional displays;Training;Noise measurement;Surface reconstruction;Shape measurement;Image reconstruction;Surface estimation, 3D reconstruction, Shape estimation, Statistical Shape Model, SSM},
 month = {Nov},
 number = {},
 pages = {179-186},
 title = {Template-Based Surface Estimation Using Statistical Shape Model},
 volume = {},
 year = {2019}
}
