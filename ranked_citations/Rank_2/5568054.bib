@inproceedings{5568054,
 abstract = {The work presented in this paper is an attempt to bridge two co-existing realties: Semantic information and MultiAgent Systems, the aim is to provide multi-domain experts or users with uniform semantic interoperability framework in heterogeneous distributed environment. We focus on the domain Ontology's original data source remote sensing imagery, bridging gap of the high-level semantic information to low-level image features in a domain-ontology and combining it with intelligent agent model which is called Ontology Agent. Based on those technology we provide a novel Multi-Agent Semantic Integration Framework (MASIS), the analysis of its application in different domains shows that the use of intelligent Agent for semantic integration in resolving the heterogeneous information integration and ontology maintained has a good result, it is a new and effective ways for semantic integration.},
 author = {Zhu, Xianqiang and Shao, Zhenfeng},
 booktitle = {2010 18th International Conference on Geoinformatics},
 doi = {10.1109/GEOINFORMATICS.2010.5568054},
 issn = {2161-0258},
 keyword = {Ontologies;Semantics;Remote sensing;Databases;Merging;Classification algorithms;semantic integration;multi-agent cooperation;Ontology Agent;remote sensing imagery},
 month = {June},
 number = {},
 pages = {1-5},
 title = {A study on semantic integration of remote sensing image data based on multi-agent cooperation},
 volume = {},
 year = {2010}
}
