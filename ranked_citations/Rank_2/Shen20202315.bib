@article{Shen20202315,
 abstract = {The update performance in erasure-coded data centers is often bottlenecked by the constrained cross-rack bandwidth. We propose CAU-CAU, a cross-rack-aware update mechanism that aims to mitigate the cross-rack update traffic in erasure-coded data centers. CAU-CAU builds on three design elements: (i) selective parity updates, which select the appropriate parity update approach based on the update pattern and the data layout to reduce the cross-rack update traffic; (ii) data grouping, which relocates and groups updated data chunks in the same rack to further reduce the cross-rack update traffic; and (iii) interim replication, which stores a specified number of temporary replicas for each newly updated data chunk. We evaluate CAU-CAU via trace-driven analysis, local cluster experiments, and Amazon EC2 experiments. We show that CAU-CAU enhances state-of-the-arts by mitigating the cross-rack update traffic as well as maintaining high update performance in both local cluster and geo-distributed environments.  © 1990-2012 IEEE.},
 author = {Shen, Zhirong and Lee, Patrick P. C.},
 doi = {10.1109/TPDS.2020.2991021},
 journal = {IEEE Transactions on Parallel and Distributed Systems},
 note = {Cited by: 23},
 number = {10},
 pages = {2315 - 2328},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cross-Rack-Aware Updates in Erasure-Coded Data Centers: Design and Evaluation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85087423685?origin=resultslist},
 volume = {31},
 year = {2020}
}
