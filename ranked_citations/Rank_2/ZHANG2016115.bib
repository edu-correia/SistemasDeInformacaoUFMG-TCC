@article{ZHANG2016115,
 abstract = {This paper examines right-turning merging areas at junctions. The utilisation rate and headway distribution of the outside lane are set up at the exit of the intersection and used to study the conflict between the main traffic stream and the right-turning traffic. On the basis of the theory of gap acceptance and probability, under the condition that the flow rate of the right-turning vehicles do not reach a maximum capacity and that the right-turning vehicles arrive randomly, the availability of the acceptable gap is analysed and traffic efficiency of the right-turning merging area is examined. The traffic efficiency outcome can be used for the evaluation of the running status of the right-turning vehicles. The traffic efficiency of the right-turning traffic is calculated with different right-turning flow rates. It is concluded that the length and configuration of the acceleration lane for the merging area is a key factor for improving operational efficiency of this type of junction.},
 author = {Hu Zhang and Yongheng Chen and Shuzhi Zhao and Huasheng Liu and Shidong Liang},
 doi = {https://doi.org/10.1680/jmuen.17.00009},
 issn = {1751-7699},
 journal = {Proceedings of the Institution of Civil Engineers - Municipal Engineer},
 keyword = {mathematical modelling, statistical analysis, traffic engineering},
 number = {2},
 pages = {115-125},
 title = {Operational efficiency of the right-turning merging area at an intersection},
 url = {https://www.sciencedirect.com/science/article/pii/S1751769916000085},
 volume = {171},
 year = {2016}
}
