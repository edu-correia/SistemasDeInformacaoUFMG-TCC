@inproceedings{11452847,
 abstract = {Data validation in clinical trials remains a key bottleneck in pharmaceutical development: 23.7% of the critical fields suffer from data integrity issues, and the manual approach requires 375 person-hours per 1,000 subjects. Herein, this paper presents TrialTransparency.AI, a hybrid approach that merges deterministic, rules-based validation with large language model capabilities. The framework consists of a Python-based preprocessing pipeline using xml.etree. ElementTree to parse XMLs and PostgreSQL for data storage; a hierarchical validation engine implementing 389 rules across five categories; explainability, powered by Mixtral-8x7B-Instruct-v0.1, to provide natural language explanations on a per-role basis; and several optimization strategies involving chunked processing and parallel execution. Testing on 87,432 records from 14 Phase II and Phase III trials showed 94.7% overall error detection accuracy, good performance in logical contradiction detection (92.8% sensitivity), and cross-record inconsistency detection (89.4% sensitivity). The system achieved a 78.3% reduction in error resolution time and reduced the average processing from 33.7 to 6.33 minutes per error, translating to a saving of 11,280 person-hours in a typical 500-patient Phase III trial.},
 author = {Doshi, Arya and Inamdar, Chinmay and Gote, Tanmay and Shilaskar, Swati},
 booktitle = {2025 1st International Conference on Advancement in Futuristic Technologies (ICAFT)},
 doi = {10.1109/ICAFT66710.2025.11452847},
 issn = {},
 keyword = {Sensitivity;Translation;Large language models;Pipelines;XML;Memory;Clinical trials;Optimization;Testing;Pharmaceuticals;clinical trials;data validation;large language models;regulatory compliance;explainable AI;healthcare informatics},
 month = {Dec},
 number = {},
 pages = {1-7},
 title = {TrialTransparency.AI: A Hybrid Rules-Based and LLM-Enhanced Framework for Clinical Trial Data Validation},
 volume = {},
