@article{Li201949392,
 abstract = {Deep convolutional neural networks have made significant progress in image denoising. However, in most cases, denoising methods using a single-stream structure with a single kernel size do not perform so well in integrating complementary contextual information; owing to the lack of this type of information, they may fail to reconstruct fine textures and patterns. To address this problem, we propose a multi-scale gated fusion network (MGFN) for image denoising, which learns direct end-to-end mappings from corrupted images to clean images. Our proposed network consists of several multi-scale mutually-gated (MM) blocks. In each MM block, we incorporate dilated convolution into a merge-and-run (MR) module to exploit multi-scale features in an effective way and further recognize useful features by filtration via a gating mechanism. Moreover, we propose a simple but effective loss function named dropout-loss to train the network. The extensive experiments on benchmark datasets show that our proposed method can well recover textures, yielding favorable performance against other state-of-the-art methods. © 2013 IEEE.},
 author = {Li, Shengyu and Chen, Yaowu and Jiang, Rongxin and Tian, Xiang},
 doi = {10.1109/ACCESS.2019.2910879},
 journal = {IEEE Access},
 note = {Cited by: 9; All Open Access; Gold Open Access},
 pages = {49392 - 49402},
 publication_stage = {Final},
 source = {Scopus},
 title = {Image Denoising via Multi-Scale Gated Fusion Network},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85065214224?origin=resultslist},
 volume = {7},
 year = {2019}
}
