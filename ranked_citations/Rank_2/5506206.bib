@inproceedings{5506206,
 abstract = {A rapid radiometric enhancement framework to improve the quality of the point clouds obtained by 3D scanning devices is explained. Given a collection of colored point clouds of the same static scene, for each point cloud a linear transformation function is computed using the variances and the means of the overlapping parts, such that having applied these linear transformation functions the point clouds become radiometrically similar with the neighboring point clouds. Proposed methods are applicable to structured as well as unstructured point clouds.},
 author = {Yilmaz, Ulas and Hellwich, Olaf},
 booktitle = {2010 3DTV-Conference: The True Vision - Capture, Transmission and Display of 3D Video},
 doi = {10.1109/3DTV.2010.5506206},
 issn = {2161-203X},
 keyword = {Radiometry;Layout;Surface reconstruction;Geometry;Cameras;Three-dimensional displays;Surface fitting;Image reconstruction;Reflectivity;Image enhancement;image registration;data acquisition;visualization;stereo vision;curve fitting},
 month = {June},
 number = {},
 pages = {1-4},
 title = {Rapid radiometric enhancement of colored 3D point clouds using color balacing},
 volume = {},
 year = {2010}
}
