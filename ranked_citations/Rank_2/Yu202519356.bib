@conference{Yu202519356,
 abstract = {Interactive segmentation is to segment the mask of the target object according to the user's interactive prompts. There are two mainstream strategies: early fusion and late fusion. Current specialist models utilize the early fusion strategy that encodes the combination of images and prompts to target the prompted objects, yet repetitive complex computations on the images result in high latency. Late fusion models extract image embeddings once and merge them with the prompts in later interactions. This strategy avoids redundant image feature extraction and improves efficiency significantly. A recent milestone is the Segment Anything Model (SAM). However, this strategy limits the models' ability to extract detailed information from the prompted target zone. To address this issue, we propose SAM-REF, a two-stage refinement framework that fully integrates images and prompts by using a lightweight refiner into the interaction of late fusion, which combines the accuracy of early fusion and maintains the efficiency of late fusion. Through extensive experiments, we show that our SAM-REF model outperforms the current state-of-the-art method in most metrics on segmentation quality without compromising efficiency.  © 2025 IEEE.},
 author = {Yu, Chongkai and Liu, Ting and Li, Anqi and Qu, Xiaochao and Wu, Chengjing and Liu, Luoqi and Hu, Xiaolin},
 doi = {10.1109/CVPR52734.2025.01803},
 journal = {Proceedings of the IEEE Computer Society Conference on Computer Vision and Pattern Recognition},
 note = {Cited by: 6},
 pages = {19356 - 19365},
 publication_stage = {Final},
 source = {Scopus},
 title = {SAM-REF: Introducing Image-Prompt Synergy during Interaction for Detail Enhancement in the Segment Anything Model},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105017065427?origin=resultslist},
 year = {2025}
}
