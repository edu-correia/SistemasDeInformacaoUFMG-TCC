@article{11150547,
 abstract = {The magnetic design of a dc transformer (DCX) plays a critical role in achieving high efficiency and power density in data center applications requiring high-voltage conversion ratios and high output currents. Hybrid switched-capacitor and transformer-based topologies are particularly suitable for such applications, owing to simplified transformer design with reduced turns ratio. This manuscript proposes a novel hybrid DCX topology that merges the resonant tanks of the switched-capacitor cell and the transformer-based cell by current-loop coupling. In addition, a dual leakage-inductance transformer model is developed to facilitate the heterogeneous magnetic integration. A matrix transformer with integrated synchronous rectifiers and output capacitors is designed to support high-load currents and enhance power density. A 1 MHz, 48 V–1 V/150 A prototype is constructed based on the proposed DCX topology and a 12:1 dual leakage-inductance transformer. Experimental results well validate the concept, demonstrating a peak efficiency of 93.8% .},
 author = {Liang, Jiawei and Wang, Liang and Li, Chenxi and Liang, Junrui and Fu, Minfan and Wang, Haoyu},
 doi = {10.1109/TPEL.2025.3605138},
 issn = {1941-0107},
 journal = {IEEE Transactions on Power Electronics},
 keyword = {Transformers;Magnetics;Topology;Couplings;Switches;Inductance;Windings;Voltage control;Power system measurements;Inductors;DC transformer (DCX);dual leakage inductance model;magnetic integration;matrix transformer;shared resonant tank},
 month = {Jan},
 number = {1},
 pages = {781-790},
 title = {Topology and Magnetics Integrated Design for Switched-Capacitor $LLC$Hybrid 48 V–1 V DCX in Data Center Applications},
 volume = {41},
 year = {2026}
}
