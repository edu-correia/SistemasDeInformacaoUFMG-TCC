@article{10.1145/3005344,
 abstract = {Polynomials over finite fields play a central role in algorithms for cryptography, error correcting codes, and computer algebra. The complexity of multiplying such polynomials is still a major open problem. Let p be a prime, and let Mp(n) denote the bit complexity of multiplying two polynomials in Fp[X] of degree less than n. For n large compared to p, we establish the bound Mp(n) = O(n log n 8log* n log p), where log* n = min{k ϵ N: log …k\texttimes{}… log n ≤ 1} stands for the iterated logarithm. This improves on the previously best known bound Mp(n) = O(n log n log log n log p), which essentially goes back to the 1970s.},
 address = {New York, NY, USA},
 articleno = {52},
 author = {Harvey, David and Hoeven, Joris Van Der and Lecerf, Gr\'{e}goire},
 doi = {10.1145/3005344},
 issn = {0004-5411},
 issue_date = {February 2017},
 journal = {J. ACM},
 keyword = {finite field, complexity bound, algorithm, Polynomial multiplication, FFT},
 month = {January},
 number = {6},
 numpages = {23},
 publisher = {Association for Computing Machinery},
 title = {Faster Polynomial Multiplication over Finite Fields},
 url = {https://doi.org/10.1145/3005344},
 volume = {63},
 year = {2017}
}
