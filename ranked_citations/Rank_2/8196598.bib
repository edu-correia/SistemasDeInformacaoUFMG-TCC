@article{8196598,
 abstract = {In order to examine the numerical instability in 1D non-local turbulent theory, an attempt was made to solve a simplified version of Xiong's non-local turbulent model taking into account the equation of conservation of energy. Using a finite-difference method and staggered grid, the structures of three main configurations of stellar convective zones were calculated. The numerical results show that the convective flux becomes negative and the radiative flux exhibits bumps across the boundaries of the convectively unstable zone. The turbulent velocity decreases rapidly in the upward direction when the pressure decreases to a certain level. In A–F type stars, the convective zones are separated when the temperature gradient is taken as a proxy, but merge when the turbulent velocity is taken as a proxy. The anisotropic treatment of turbulent convection facilitates the non-local effect at the upper boundary of the convection zone.},
 author = {Cai, Tao},
 doi = {10.1093/mnras/stu1357},
 issn = {1365-2966},
 journal = {Monthly Notices of the Royal Astronomical Society},
 keyword = {convection;methods: numerical;stars: interiors},
 month = {Aug},
 number = {4},
 pages = {3703-3711},
 title = {Numerical analysis of non-local convection},
 volume = {443},
 year = {2014}
}
