@conference{Muennighoff202597116,
 abstract = {We introduce OLMOE, a fully open, state-of-the-art language model leveraging sparse Mixture-of-Experts (MoE). OLMOE-1B-7B has 7 billion (B) parameters but uses only 1B per input token. We pretrain it on 5 trillion tokens and further adapt it to create OLMOE-1B-7B-INSTRUCT. Our models outperform all available models with similar active parameters, even surpassing larger ones like Llama2-13B-Chat and DeepSeekMoE-16B. We present novel findings on MoE training, define and analyze new routing properties showing high specialization in our model, and open-source all our work: model weights, training data, code, and logs. © 2025 13th International Conference on Learning Representations, ICLR 2025. All rights reserved.},
 author = {Muennighoff, Niklas and Soldaini, Luca and Groeneveld, Dirk and Lo, Kyle and Morrison, Jacob and Min, Sewon and Shi, Weijia and Walsh, Pete and Tafjord, Oyvind and Lambert, Nathan and Gu, Yuling and Arora, Shane and Bhagia, Akshita and Schwenk, Dustin and Wadden, David and Wettig, Alexander and Hui, Binyuan and Dettmers, Tim and Kiela, Douwe and Farhadi, Ali and Smith, Noah A. and Koh, Pang Wei and Singh, Amanpreet and Hajishirzi, Hannaneh},
 journal = {13th International Conference on Learning Representations, ICLR 2025},
 note = {Cited by: 7},
 pages = {97116 - 97176},
 publication_stage = {Final},
 source = {Scopus},
 title = {OLMOE: OPEN MIXTURE-OF-EXPERTS LANGUAGE MODELS},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105010246123?origin=resultslist},
