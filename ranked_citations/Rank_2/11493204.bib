@inproceedings{11493204,
 abstract = {The fast development of cyber attacks has made the conventional rule-based intrusion detection systems even less efficient due to the emergence of various challenges being posed by the modern threats like the zero-day exploits, the ransomware, and the advanced persistent threats. Although Artificial Intelligence (AI) has proven to be of high potential in cybersecurity, single-paradigm AI models are usually characterized by low false-positives, scaling, and low operational constraints. The current paper suggests a hybrid AI-based system of real-time cyber attack detection and prevention that will combine signature-based detection, classical machine learning, deep learning, and anomaly detection by means of unified and risk-conscious architecture. The proposed structure incorporates parallel detection engines, the results of which are merged with the assistance of a contextual-based risk-scoring system to reduce cases of false alarms and support automated or analyst-assisted response actions. The CICIDS2017 data set is used to test the framework, and its performance is measured based on detection accuracy, false-positive rate, latency, and statistical significance. The experimental data demonstrate that the offered method will yield 99.08% detection rates, decrease the number of false positives by a significant margin, and preserve the low-latency cost, which can be used in practice. The statistical analysis proves that the improvements observed are significant.},
 author = {Sharma, Anubhav and Kapil, Manoj and Garg, Sharvan Kumar},
 booktitle = {2026 International Conference on Emerging Smart Computing and Informatics (ESCI)},
 doi = {10.1109/ESCI68015.2026.11493204},
 issn = {2996-1815},
 keyword = {Telemetry;Payloads;Aerospace and electronic systems;Feedback;System-on-chip;Circuits;Application specific integrated circuits;Internet of Things;Internet;Telecommunication traffic;Cybersecurity;Intrusion Detection System;Artificial Intelligence;Machine Learning;Deep Learning},
 month = {March},
 number = {},
 pages = {1-5},
 title = {An Intelligent Artificial Intelligence Framework to Detect and Mitigate Cyber Attacks in the Contemporary Networks},
 volume = {},
 year = {2026}
}
