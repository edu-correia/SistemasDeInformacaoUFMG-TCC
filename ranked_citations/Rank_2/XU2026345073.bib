 keyword = {Electrochemiluminescence, Trimethylamine N-Oxide, Poly(5-aminoindole), Conductive MOFs, Ru@Zn-HHTP},
 pages = {345073},
 title = {Exogenous coreactant-free integrated ECL biosensor based on P5AIn/Fe(II)-MOF for sensitive trimethylamine N-oxide detection},
