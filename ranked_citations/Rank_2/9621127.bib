 doi = {10.1109/ICTC52510.2021.9621127},
 issn = {2162-1233},
 keyword = {Codes;Simulation;Merging;Clustering algorithms;Modulation;Channel estimation;Information and communication technology;Polar codes;bit error rates;coded modulations;successive cancellation decoding;density evolution},
 month = {Oct},
