@article{LI2025107971,
 abstract = {Segmentation of nodules in thyroid ultrasound imaging plays a crucial role in the detection and treatment of thyroid cancer. However, owing to the diversity of scanner vendors and imaging protocols in different hospitals, the automatic segmentation model, which has already demonstrated expert-level accuracy in the field of ultrasound imaging segmentation, finds its accuracy reduced as the result of its weak generalization performance when being applied in clinically realistic environments. To address this issue, the present paper proposes an Atlas-based Spatial Transformer Network (ASTN), a novel framework for accurate and generalizable segmentation of thyroid nodules. The ASTN framework extracts the potential semantic features of the nodule region in ultrasound images, and realizes the co-registration and segmentation based on the topological structure, effectively improving the generalization ability and accuracy of the model. In particular, an encoder extracts and merges lesion features from the target and atlas (a template set composed of multiple real anatomical structures) for co-registration, then adaptively weights the fused labels based on stage-wise similarity to enhance model robustness and accuracy across data domains. Additionally, this paper also provides an atlas selection algorithm to retain more priori information and alleviate the challenges associated with co-registration. Thanks to the method we proposed, as shown by the evaluation results collected from the datasets of different devices, the model generalization has been greatly improved while maintaining a high level of segmentation accuracy.},
 author = {Xuewei Li and Yaqiao Zhu and Yilong Fan and Xi Wei and Ruixuan Zhang and Yuan Tian and Zhiqiang Liu},
 doi = {https://doi.org/10.1016/j.bspc.2025.107971},
 issn = {1746-8094},
 journal = {Biomedical Signal Processing and Control},
 keyword = {Ultrasound image segmentation, Thyroid nodules registration, Deep learning, Spatial Transformer Network},
 pages = {107971},
 title = {Ultrasound image segmentation of thyroid nodule via latent semantic feature co-registration},
 url = {https://www.sciencedirect.com/science/article/pii/S1746809425004823},
 volume = {108},
 year = {2025}
}
