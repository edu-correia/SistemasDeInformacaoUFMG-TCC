@incollection{MAXWELL2026293,
 abstract = {Convolutional neural network-based methods are explored for pixel-level classification, or semantic segmentation, tasks. Key architectural components are described including convolutional layers, activation functions, batch normalization, upsampling, transpose convolution, and classification heads along with their associated settings and configurations. We describe several commonly used architectures, including fully convolutional networks, UNet, UNet++, UNet3+ and DeepLabv3+, and how the scene classification architectures discussed in the prior chapter can be used as the encoder component of semantic segmentation architectures. Input data requirements for both predictor variables and associated pixel-level labels, or masks, are described along with methods and workflows for training models and evaluating results. Developing training, validation, and test image chips and associated masks are described along with means to merge chip-by-chip predictions into a single raster grid covering the spatial extent of interest.},
 author = {Aaron E. Maxwell and Christopher A. Ramezan and Yaqian He},
 booktitle = {Supervised Learning in Remote Sensing and Geospatial Science},
 doi = {https://doi.org/10.1016/B978-0-443-29306-1.00011-9},
 editor = {Aaron E. Maxwell and Christopher A. Ramezan and Yaqian He},
 isbn = {978-0-443-29306-1},
 keyword = {Deep learning, convolutional neural network, image classification, semantic segmentation, fully convolutional neural network, UNet, UNet++, UNet3+, DeepLabv3+},
 pages = {293-315},
 publisher = {Elsevier},
 title = {Chapter 12 - Deep learning for pixel-level predictions},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443293061000119},
 year = {2026}
}
