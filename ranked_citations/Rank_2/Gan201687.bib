@conference{Gan201687,
 abstract = {Attributes possess appealing properties and benefit many computer vision problems, such as object recognition, learning with humans in the loop, and image retrieval. Whereas the existing work mainly pursues utilizing attributes for various computer vision problems, we contend that the most basic problem - how to accurately and robustly detect attributes from images - has been left under explored. Especially, the existing work rarely explicitly tackles the need that attribute detectors should generalize well across different categories, including those previously unseen. Noting that this is analogous to the objective of multi-source domain generalization, if we treat each category as a domain, we provide a novel perspective to attribute detection and propose to gear the techniques in multi-source domain generalization for the purpose of learning cross-category generalizable attribute detectors. We validate our understanding and approach with extensive experiments on four challenging datasets and three different problems. © 2016 IEEE.},
 author = {Gan, Chuang and Yang, Tianbao and Gong, Boqing},
 doi = {10.1109/CVPR.2016.17},
 journal = {Proceedings of the IEEE Computer Society Conference on Computer Vision and Pattern Recognition},
 note = {Cited by: 177; All Open Access; Green Open Access},
 pages = {87 - 97},
 publication_stage = {Final},
 source = {Scopus},
 title = {Learning attributes equals multi-source domain generalization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84986281512?origin=resultslist},
 volume = {2016-December},
 year = {2016}
}
