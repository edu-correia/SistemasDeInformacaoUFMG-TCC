@inproceedings{11519242,
 abstract = {Arabic Document Understanding has its own challenges, mainly due to Right-to-Left (RTL) Text Rendering Complexity, Diverse Layouts, and Merging Multi-modal Content into One Single Document. In this paper we propose a new framework for Enhanced Arabic Document Understanding based on the Qwen2-VL-2B-Instruct Vision-Language Model, which addresses the most important challenges that are related to Repetition of Text and Optimization of RTL Display. We evaluate our method on the KITAB-Bench dataset, which is a large-scale benchmark for Arabic document analysis containing optical character recognition (OCR), table extraction, and chart interpretation tasks. Our methodology consists of two main components: the adaptive repetition penalty mechanism and the specialized RTL pipeline for processing Arabic text. Our experimental results show that our framework has significantly improved the quality of the output and reduced redundancy by 67%. While Maintaining Semantic Coherence. Therefore, our proposed framework achieved competitive performance across multiple document understanding tasks, especially in the case of mixed Arabic and English content and complex tabular structures. Our contributions are as follows: (1) New Strategy to Reduce Repetition of Arabic-Generated Text, (2) Optimized RTL Rendering Pipeline to Represent Visual Representation Accurately and (3) Comprehensive Evaluation Protocols for Arabic Multi-task Document Understanding.},
 author = {Hamad, Khaled and Harahsheh, Bashar A. Al and Abuowaida, Suhaila and Malkawi, Mo’men and Alshdaifat, Nawaf and Alzboon, Mowafaq Salem and Al-Harahsheh, Amer},
 booktitle = {2026 International Conference on Smart Multidomain Integrated Learning Environments (ICSMILE)},
 doi = {10.1109/ICSMILE69273.2026.11519242},
 issn = {},
 keyword = {Modeling;Printing;Aluminum;Register transfer level;Optical character recognition;Equations;Visualization;Computers;Displays;Pipelines;Arabic NLP;Vision-Language Models;OCR;Table Extraction;Text Processing},
 month = {March},
 number = {},
