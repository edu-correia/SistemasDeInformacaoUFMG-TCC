@inproceedings{6741264,
 abstract = {A chirp subbottom profiler was integrated into the NIUST AUV Eagle Ray to expand its mapping capabilities. Previously this vehicle has been used primarily for seafloor mapping using a multibeam sonar. The subbottom profiler provides an additional dimension of data, which allows one to visualize up to 60 meters below the seafloor and correlate surface expressions with subbottom structure. The profiler system was integrated into the vehicle's structure, control software, and operations protocol. The resulting profiler files are merged with the vehicle's logs and processed to infer physical properties of the seafloor and create pseudo 3D volumes.},
 author = {Woolsey, M. and Jarnagin, R. and Sleeper, K. and Macelloni, L. and D'Emidio, M. and Diercks, A.-R. and Asper, V. L.},
 booktitle = {2013 OCEANS - San Diego},
 doi = {10.23919/OCEANS.2013.6741264},
 issn = {0197-7385},
 keyword = {Vehicles;Acoustics;Computers;Software;Protocols;Sediments;Chirp;subbottom profiler;seafloor survey},
 month = {Sep.},
 number = {},
 pages = {1-4},
 title = {Integration of a polarity-preserving chirp subbottom profiler into the NIUST AUV Eagle Ray},
 volume = {},
 year = {2013}
}
