@article{Velyamov20241160,
 abstract = {This article examines the Dantzig-Wolfe decomposition method for solving large-scale optimization problems. The standard simplex algorithm solves these problems, making the Dantzig-Wolfe method a valuable tool. The article describes in detail a new modification of the Dantzig-Wolfe decomposition method. This modification aims to improve the efficiency of the coordination task, a key component that defines subtasks. By significantly reducing the number of rows in the coordination problem, the proposed method achieves faster computation and reduced memory requirements compared to the original approach. Although the Dantzig-Wolfe method has encountered problems due to the complexity of implementing algorithms for hierarchical systems, this modification opens up new potential. © (2024), (Science and Information Organization). All Rights Reserved.},
 author = {Velyamov, Turganzhan and Kim, Alexandr and Manankova, Olga},
 doi = {10.14569/IJACSA.2024.01507113},
 journal = {International Journal of Advanced Computer Science and Applications},
 note = {Cited by: 3; All Open Access; Gold Open Access},
 number = {7},
 pages = {1160 - 1167},
 publication_stage = {Final},
 source = {Scopus},
 title = {Modification of the Danzig-Wolf Decomposition Method for Building Hierarchical Intelligent Systems},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85201917075?origin=resultslist},
 volume = {15},
 year = {2024}
}
