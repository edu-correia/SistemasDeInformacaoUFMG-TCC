@inproceedings{11069603,
 abstract = {In response to the lack of real road network support in the self-developed micro traffic simulation engine, research was conducted on the differences between simulated road networks and OSM (OpenStreetMap) road network data. We create a road network data relationship model and propose a road network construction method based on the road network data relationship model; And we propose a single intersection and its associated sections as the basic units for road network construction, and include the method of constructing unit road intersections and merging roads in the road network construction method. The feasibility of OSM road network in micro traffic simulation was verified through simulation experiments using a micro traffic simulation engine, which improved the authenticity of micro traffic simulation; Comparing the OSM road network with the simulated road network, the advantages of the real road network in describing the geometric state and topological structure of the road network are obtained.},
 author = {Liao, Yu and Li, Sinan and Zhu, Xuyang and Tan, Hao and Wu, Chunjiang},
 booktitle = {2025 10th International Conference on Computer and Communication System (ICCCS)},
 doi = {10.1109/ICCCS65393.2025.11069603},
 issn = {2995-3251},
 keyword = {Communication systems;Roads;Computational modeling;Merging;Telecommunication traffic;Traffic control;Data models;Engines;data relational model;road network construction;simulation engine;simulated road network;traffic simulation},
 month = {April},
 number = {},
 pages = {1301-1308},
 title = {Research and Application on Real Road Network Construction of Micro Traffic Simulation Engine},
 volume = {},
 year = {2025}
}
