@conference{Zhou2020,
 abstract = {Aircraft is a kind of valuable military equipment and transportation, so using target detection technology to detect ground aircraft in the optical remote sensing image has important research and application value. Although some achievements have been made in the relevant research, how to realize fast and effective ground aircraft target detection is still a challenging task because of the complex background of remote sensing image, large scale change and small imaging size, etc. Aiming at the application scenarios of multi-frame imaging, such as embedded detection and tracking system, this thesis proposes an aircraft target detection scheme based on hierarchical screening, which can improve the detection speed and reduce false alarm. Firstly, by analyzing the background characteristics, a target candidate region extraction method based on gray variance is adopted, and the acceleration is realized by integrating graph and shared computation. Then, the haar-like features are extracted in the candidate regions, which are then classified by the cascade AdaBoost classifier. Afterwards, a union-find-sets algorithm is used to merge the redundancy detection results and evaluate the confidence. Finally, the inter-frame correlation information is used to remove the false alarm. And we carried out experimental verification and proved the effectiveness of the algorithm. © SPIE. Downloading of the abstract is permitted for personal use only.},
 author = {Zhou, Bin and Jin, Songzhi and Liu, Yanxin and Hao, Mengxi and Zhang, Hui},
 doi = {10.1117/12.2541930},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A new ground plane detection method based on continuous multi-frame images and hierarchical screening},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85081125462?origin=resultslist},
