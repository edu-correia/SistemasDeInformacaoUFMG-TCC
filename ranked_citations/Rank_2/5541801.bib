@inproceedings{5541801,
 abstract = {This paper presents a fast information reproduction method for the HTTP protocol in public wireless local area network (WLAN). Through the collection and analysis of the HTTP packets in WLAN, this method reclassifies and organizes the multiple conversations by means of the conversation reunion algorithm, and proposes a way which is a single conversation corresponding to multiple connections. After merging the HTTP information of the different connections in each conversation, this method uses the multi-threaded parallel processing technology to replay and reproduce the HTTP information fast. In conclusion, this paper gives the analysis of the implementation efficiency and the successful percentage of the HTTP information reproduction about the method.},
 author = {Ming Wan and Nan Yao and Ying Liu and Hongke Zhang},
 booktitle = {2010 IEEE International Conference on Wireless Communications, Networking and Information Security},
 doi = {10.1109/WCINS.2010.5541801},
 issn = {},
 keyword = {Wireless LAN;Information analysis;Protocols;Computerized monitoring;Forensics;Authentication;Parallel processing;Information security;Protection;Laboratories;WLAN security;HTTP;conversation reunion;multi-thread parallel;information replay and reproduction},
 month = {June},
 number = {},
 pages = {365-369},
 title = {A fast information reproduction method for HTTP in WLAN},
 volume = {},
 year = {2010}
}
