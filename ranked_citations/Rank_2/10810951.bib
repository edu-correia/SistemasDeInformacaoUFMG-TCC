@inproceedings{10810951,
 abstract = {Climate change still implies risks for economic security, such as for agriculture and its productivity and, therefore, national economic potential. Although similar approaches have been used in publications concerning individual crops or soil types, the application of climatology parameters in agriculture and it limited indices have not been optimal. Owing to the recognized limitations of traditional linear productivity models, this thesis subjects’ agricultural productivity to a Cobb-Douglas multi-factorial modeling approach through intensive levels of data decomposition. The proposed approach enabled the researchers to adjust the impact of climate parameters during students’ evaluations in the secondary education curricula. Additionally, frameworks which relate temperature variations and crop growth do exist, and therefore the temperature and agriculture performance model effects determinants were determined using complex analysis of temperature relations and crop outputs. This highlights the various factors affecting production, its structure, and the relative importance of some conditions in agriculture and explains their dynamics depending on the changes in growth factors. Hence, a set of factors employed in the modeling resulted mainly from economic conditions, production system structures and advanced agricultural technology applications in the economy as prediction},
 author = {Rathi, Snehal and Wamanacharya, Shubham and Shah, Samkit and Khedkar, Vijayshri},
 booktitle = {2024 5th International Conference on Data Intelligence and Cognitive Informatics (ICDICI)},
 doi = {10.1109/ICDICI62993.2024.10810951},
 issn = {},
 keyword = {Productivity;Economics;Support vector machines;Temperature;Biological system modeling;Soil;Predictive models;Data models;Long short term memory;Meteorology;Crop Growth Days;Agricultural Data Analysis;R Programming;Climate Impact on Agriculture;Growth Degree Days (GDD)},
 month = {Nov},
