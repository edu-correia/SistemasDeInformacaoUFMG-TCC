@inproceedings{11076443,
 abstract = {Digital technologies have merged with fashion retail to provide innovative online shopping solutions. These virtual solutions have several studies showing AR-based visualization and size recommendations as the main focus. But existing solutions are often said to lack adequate personalization, real-time adjustments in fit, and seamless integration of ML models within AR-enabled shopping experiences. This paper reviews the Virtual Fit Trial Application, the outcome of previous research integrating some of the CV technologies with an AR use case and ML size prediction models. This system has an intuitive web interface that allows the users to select apparel, get detailed suggestions on size, and inspect garments virtually in AR and 3D, this overcomes the disadvantages of previous studies and improves customer satisfaction, thereby keeping lower return-to-stock rates, and mixing the physical shopping experience and the digital one. This work explains how the development of augmented reality-supports virtual fitting rooms, along with ML size recommendations, will reshape the world of e-commerce, providing a trustworthy and engaging shopping experience.},
 author = {R, Sricharan. and Shafana, N. Jeenath and Shyam Sundar, K and Amshavalli, R.S. and Rajalakshmi, R.},
 booktitle = {2025 7th International Conference on Intelligent Sustainable Systems (ICISS)},
 doi = {10.1109/ICISS63372.2025.11076443},
 issn = {},
 keyword = {Visualization;Technological innovation;Three-dimensional displays;Fitting;Clothing;Reinforcement learning;Turning;Real-time systems;Electronic commerce;Time factors;Augmented Reality;Virtual Try-On;Machine Learning;Size Prediction;Computer Vision;3D Modeling;Personalized Shopping;E-Commerce;Fashion Technology;Virtual Fitting Room;Online Retail Innovation},
 month = {March},
