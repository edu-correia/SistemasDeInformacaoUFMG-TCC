@inproceedings{9937279,
 abstract = {Merge with motion vector difference (MMVD) is a simple yet efficient coding tool adopted in VVC. However, the efficiency of MMVD drops a lot in the reference software beyond VVC, known as ECM, this paper proposes a template matching (TM) based extension for MMVD (TME-MMVD) for inter prediction. Firstly, extra refinement positions are introduced along diagonal angles. Secondly, based on a template matching cost calculated as a distortion between samples of a template and their reference samples, the refinement positions are reordered. Finally, the preferable ones with the lowest costs are selected as available positions and consequently for index coding. This method is also extended to the affine MMVD mode. The proposed method is implemented on top of the ECM2. Experimental results show that the proposed method provides 0.69% and 0.64% bitrate saving compared to latest VVC SW and 0.24% and 0.31% bitrate saving compared to ECM2 under the JVET common test conditions for random access and low delay configurations, respectively. This tool is adopted into the current ECM SW.},
 author = {Salehifar, Mehdi and He, Yuwen and Zhang, Kai and Zhang, Na and Zhang, Li},
 booktitle = {2022 IEEE International Symposium on Circuits and Systems (ISCAS)},
 doi = {10.1109/ISCAS48785.2022.9937279},
 issn = {2158-1525},
 keyword = {Costs;Circuits and systems;Bit rate;Distortion;Encoding;Software;Delays;Video Coding;Inter Prediction;Merge with MVD;Template Matching;beyond VVC},
 month = {May},
 number = {},
 pages = {521-525},
 title = {A Template Matching based Extension for Merge with Motion Vector Difference},
 volume = {},
 year = {2022}
}
