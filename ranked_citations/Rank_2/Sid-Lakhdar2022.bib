@conference{Sid-Lakhdar2022,
 abstract = {We combine Deep Gaussian Processes with multitask and transfer learning for the performance modeling and optimization of HPC applications. Deep Gaussian processes merge the uncertainty quantification advantage of Gaussian Processes with the predictive power of deep learning. Multitask and transfer learning allow for improved learning efficiency when several similar tasks are to be learned simultaneously and when previous learned models are sought to help in the learning of new tasks, respectively. A comparison with state-of-the-art autotuners shows the advantage of our approach on two application problems.  © 2022 IEEE.},
 author = {Sid-Lakhdar, Wissam M. and Aznaveh, Mohsen and Luszczek, Piotr and Dongarra, Jack},
 doi = {10.1109/HPEC55821.2022.9926396},
 journal = {2022 IEEE High Performance Extreme Computing Conference, HPEC 2022},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Deep Gaussian process with multitask and transfer learning for performance optimization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85142272791?origin=resultslist},
 year = {2022}
}
