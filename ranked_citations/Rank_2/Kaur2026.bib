@conference{Kaur2026,
 abstract = {Alzheimer's Disease (AD) is a progressive neurode-generative disorder marked by cognitive and functional decline, posing significant global health challenges. Early diagnosis is critical to enabling effective intervention and disease management. This study proposes a robust deep learning framework utilizing structural MRI scans for the multi-stage classification of Alzheimer's Disease, including Non-Demented, Very Mild Demented, Mild Demented, and Moderate Demented. The proposed model incorporates advanced convolutional architectures to extract discriminative features from high-resolution brain images, ensuring accurate stage-wise detection. Performance evaluation on a large dataset demonstrates high classification accuracy, with superior sensitivity and specificity across stages. Comparative analysis with recent cutting-edge models underscores the effectiveness of the proposed framework in handling class imbalance and enhancing diagnostic precision. The study further includes visual interpretation through confusion matrices and brain scan predictions, reinforcing the model's clinical applicability. The integration of imaging biomarkers and deep learning offers a promising direction for early and automated diagnosis. © 2026 IEEE.},
 author = {Kaur, Arshpreet and Singh, Chiranjeev and Pratham and Kahlon, Josh},
 doi = {10.1109/ICASST68917.2026.11484441},
 journal = {Conference Proceedings - 1st International Conference on Advancing Sustainable Solutions through Technologies, ICASST 2026},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Deep Learning for Alzheimer's Disease Monitoring: Classifying Active vs. Passive Stages with MRI},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105038446384?origin=resultslist},
 year = {2026}
