 issn = {},
 keyword = {GSM;Cloud computing;Automation;Face recognition;Manuals;Dynamic scheduling;Real-time systems;Servomotors;Monitoring;Radiofrequency identification;Automated Fare Collection;RFID;Passenger Flow Management;Cloud Integration;Dynamic Scheduling;Metro Systems},
 month = {March},
 number = {},
 pages = {1-8},
 title = {Automated Metro Fare Collection and Dynamic Passenger Management System},
