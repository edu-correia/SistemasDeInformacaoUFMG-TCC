@inproceedings{11031634,
 abstract = {This document describes the transformation of Automated Metro Fare Collection and Dynamic Passenger Management System that is targeted towards improving metro systems globally. The project implements fare collection and passenger management automation with RFID technology, servo motors, GSM modules, and cloud integration via ESP8266. Our system, in contrast to earlier works including Crowd Bus Sensing (CBS), merges fare automation with dynamic passenger information collection to enhance the information and decision- making process. It is demonstrated in the experiments that the fare calculation accuracy has improved and the level of congestion has decreased at entry points. This work presents a more adaptable and effective solution for intelligent transportation systems.},
 author = {M, Nisha. and J, Kavin. J. and A, Anist.},
