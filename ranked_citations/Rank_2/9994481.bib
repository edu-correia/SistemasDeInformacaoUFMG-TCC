@inproceedings{9994481,
 abstract = {In the classic ip-iq harmonic current detection algorithm, Phase Locked Loop (PLL) and Low Pass Filter (LPF) affect detection accuracy and response speed. First, the sources of detection inaccuracy were investigated by merging the classic ip-iq harmonic detection algorithm. Second, to avoid the effect of three-phase grid voltage on the phase locked ability of PLL, a method of merging Adaptive Notch Filter (ANF) with PLL is provided. To address the conflict between low pass filter accuracy and response speed, a method of employing Moving Average Filter (MAF) instead of low pass filter is proposed. Finally, The simulation models are built according to the improved algorithm and our method can achieve state-of-the-art detection accuracy and response speed by verifying on Matlab/Simulink.},
 author = {Feng, Yifei and Chen, Zhongxiao and Lu, Fengyu and Zhuo, Ma},
 booktitle = {2022 IEEE 5th International Conference on Automation, Electronics and Electrical Engineering (AUTEEE)},
 doi = {10.1109/AUTEEE56487.2022.9994481},
 issn = {2831-4549},
 keyword = {Adaptation models;Software packages;Simulation;Merging;Low-pass filters;Harmonic analysis;Phase locked loops;harmonic measurement;instantaneous reactive power theory;adaptive notch filter;moving average filter},
 month = {Nov},
 number = {},
 pages = {603-607},
 title = {Improvement of phase locked loop and low pass filter in ip-iq method},
 volume = {},
 year = {2022}
}
