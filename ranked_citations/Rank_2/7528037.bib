@inproceedings{7528037,
 abstract = {Several rules have been emerged in order to overcome the abnormal behavior of Dempster's combination rule with counter-intuitive results. Existing rules to evidence combination modeling differ in the expressive power of the conflict management models. This motivates us to develop an alternative combination rule called Total Conflicting mass Redistribution (TCR). This redistribution is founded on weighting factors computed from the masses assigned to each set by the sources of information and those obtained by the conjunctive rule. Our TCR rule is evaluated and compared with some numerical examples reported in the literature. As a result, this rule gives intuitive interpretation for combining multiple-source information and provides reasonable results.},
 author = {Sebbak, Faouzi and Benhammadi, Farid},
 booktitle = {2016 19th International Conference on Information Fusion (FUSION)},
 doi = {},
 issn = {},
 keyword = {Merging;Reliability;Computational modeling;Complexity theory;Biological system modeling;Electric breakdown;Convergence;Information fusion;Evidence Theory;Combination rule;Conflict redistribution},
 month = {July},
 number = {},
 pages = {1324-1331},
 title = {Total conflict redistribution rule for evidential fusion},
 volume = {},
 year = {2016}
}
