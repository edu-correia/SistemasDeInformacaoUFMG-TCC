@conference{Bálint2024,
 abstract = {Effective university education cannot be implemented without modern teaching methods. Educational institutions usually upload electronic course materials to the cloud, from which students can easily download them. Through the use of smart devices, teaching materials are thus easily accessible from almost anywhere. Unfortunately, however, cloud-based storage does not provide sufficient protection, as sensitive data has been compromised in many cases in the past. As a result, the goal of the research is to create a solution suitable for data storage that provides a solution instead of cloud-based data storage, which sometimes has a low level of security. Through the application of decentralized blockchain technology, a university blockchain with private access will be created as a practical part of the research, where the secure storage of university data can be implemented, even in the long term. It is not the goal of any university to have sensitive student data fall into the possession of unauthorized persons, as this may damage the reputation of the educational institution. Before creating the university blockchain, it will also be examined which blockchain technology provides the greatest database security for universities, after which the optimal blockchain technology will be selected. The final step is the creation of the private university blockchain called PEUB (Private Ethereum University Blockchain).  © 2024 University of Split, FESB.},
 author = {Bálint, Krisztián},
 doi = {10.23919/SpliTech61897.2024.10612401},
 journal = {2024 9th International Conference on Smart and Sustainable Technologies, SpliTech 2024},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Blockchain Technology Supported Education},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85202431226?origin=resultslist},
 year = {2024}
}
