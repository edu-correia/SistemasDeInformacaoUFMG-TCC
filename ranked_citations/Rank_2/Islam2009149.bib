 publication_stage = {Final},
 source = {Scopus},
 title = {IT in special libraries in Bangladesh: A case study},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/67651174692?origin=resultslist},
 volume = {27},
 year = {2009}
