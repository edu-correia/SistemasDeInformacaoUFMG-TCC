@conference{Chen201932,
 abstract = {In modern society, traffic modeling method and simulation mode are of great importance for intelligent transportation. Therefore, in this paper, we aim to effective model and analyze the road network based on VISSIM. Particularly, VISSIM is used to describe the operation of urban transportation, traffic flow characteristics and driver behaviors respectively. VISSIM can not only simulate individual traffic, but also simulate open and rail traffic. However, the quality of VISSIM parameters greatly influences system performance. Therefore, we proposed a novel VISSIM parameters correction method based on the genetic algorithm. Finally, experimental results show the effectiveness of the proposed algorithm. © 2019 IEEE.},
 author = {Chen, Meiyan},
 doi = {10.1109/ICITBS.2019.00017},
 journal = {Proceedings - 2019 International Conference on Intelligent Transportation, Big Data and Smart City, ICITBS 2019},
 note = {Cited by: 11},
 pages = {32 - 35},
 publication_stage = {Final},
 source = {Scopus},
 title = {Modeling and Simulation Analysis of Road Network Based on VISSIM},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85063868716?origin=resultslist},
 year = {2019}
}
