@article{PARISI202416932,
 abstract = {The multifaceted role nitric oxide (NO) plays in human physiology and pathophysiology has opened new scenarios in biomedicine by exploiting this free radical as an unconventional therapeutic against important diseases. The difficulties in handling gaseous NO and the strict dependence of the biological effects on its doses and location have made the light-activated NO precursors, namely NO photodonors (NOPDs), very appealing by virtue of their precise spatiotemporal control of NO delivery. The covalent integration of NOPDs and additional functional components within the same molecular skeleton through suitable linkers can lead to an intriguing class of multifunctional photoactivatable molecular hybrids. In this Perspective, we provide an overview of the recent advances in these molecular constructs, emphasizing those merging NO photorelease with targeting, fluorescent reporting, and phototherapeutic functionalities. We will highlight the rational design behind synthesizing these molecular hybrids and critically describe the advantages, drawbacks, and opportunities they offer in biomedical research.},
 author = {Cristina Parisi and Francesca Laneri and Aurore Fraix and Salvatore Sortino},
 doi = {https://doi.org/10.1021/acs.jmedchem.4c01038},
 issn = {1520-4804},
 journal = {Journal of Medicinal Chemistry},
 number = {19},
 pages = {16932-16950},
 title = {Multifunctional Molecular Hybrids Photoreleasing Nitric Oxide: Advantages, Pitfalls, and Opportunities},
 url = {https://www.sciencedirect.com/science/article/pii/S152048042400214X},
 volume = {67},
 year = {2024}
}
