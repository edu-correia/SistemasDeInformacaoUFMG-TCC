@inproceedings{7836650,
 abstract = {This paper focuses on the identification of overlapping communities, allowing nodes to simultaneously belong to several communities, in a decentralised way. To that aim it proposes LOCNeSs, an algorithm specially designed to run in a decentralised environment and to limit propagation, two essential characteristics to be applied in mobile networks. It is based on the exploitation of the preferential attachment mechanism in networks. Experimental results show that LOCNeSs is stable and achieves good overlapping vertex identification.},
 author = {Canu, Maël and Lesot, Marie-Jeanne and D’Allonnes, Adrien Revault},
 booktitle = {2016 IEEE 16th International Conference on Data Mining Workshops (ICDMW)},
 doi = {10.1109/ICDMW.2016.0019},
 issn = {2375-9259},
 keyword = {Peer-to-peer computing;Merging;Context;Algorithm design and analysis;Conferences;Electronic mail;Social network services;graph mining;complex networks;community detection;decentralised algorithms},
 month = {Dec},
 number = {},
 pages = {77-84},
 title = {Overlapping Community Detection by Local Decentralised Vertex-Centred Process},
 volume = {},
 year = {2016}
}
