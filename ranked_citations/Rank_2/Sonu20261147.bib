@conference{Sonu20261147,
 abstract = {Social media platforms have become valuable sources for studying mental health and understanding emotional patterns in online communities. This study examines four years of Reddit posts (2019-2022) across five mental health categories: anxiety, depression, loneliness, general mental health and suicidal watch. Using PySpark large-scale pre-processing was performed to merge, clean and balance millions of posts and then label encoding, tokenization and splitting data into training, testing and validation sets. Exploratory Data Analysis (EDA) with Python and Power BI identified posting trends by year, month, subreddit engagement and category patterns. Traditional ML models such as Logistic Regression, SVM, Random Forest and XGBoost using TF-IDF gave baseline results while transformer models DistilBERT and RoBERTa understood deeper contextual meanings. The RoBERTa model achieved 68% accuracy performing better than traditional models. Despite challenges like uneven data, long text truncation and high computation, the results show that using big data tools with modern NLP helps find useful insights for early mental health support, spreading awareness and supporting at risk users online. © 2026 IEEE.},
 author = {Sonu, Akula and Nikhilesh, Kaki and Dwivedi, Aviral and Preethiya, T. and Gouthaman, P.},
 doi = {10.1109/ICVADV67766.2026.11470353},
 journal = {Proceedings of 2nd International Conference on Visual Analytics and Data Visualization, ICVADV 2026},
 note = {Cited by: 0},
 pages = {1147 - 1152},
 publication_stage = {Final},
 source = {Scopus},
 title = {Classification of Mental Health Trends Using Social Media},
 type = {Conference paper},
