@inproceedings{10885121,
 abstract = {With the rapid development of blockchain technology, smart contracts have been widely used in various decentralized applications. However, the security issues of smart contracts, especially cross-contract vulnerabilities, have become important risks affecting the security of the blockchain ecosystem and are challenging to detect. To address this challenge, we propose FFGDetector, an innovative cross-contract vulnerability detection tool for smart contract based on improved GCN (Graph Convolutional Neural Network), which can automatically analyze the call relationship and data flow between smart contracts, generate and merge contract feature flow graphs. We have validated the effectiveness and accuracy of FFGDetector through extensive experiments on reentrancy, timestamp dependency, txorigin and delegatecall vulnerabilities and the results indicate that our method is more effective.},
 author = {Liu, Zhifei and Jiao, Jian},
 booktitle = {2024 IEEE International Symposium on Parallel and Distributed Processing with Applications (ISPA)},
 doi = {10.1109/ISPA63168.2024.00101},
 issn = {2158-9208},
 keyword = {Distributed processing;Smart contracts;Ecosystems;Feature extraction;Decentralized applications;Graph neural networks;Blockchains;Security;Flow graphs;Convolutional neural networks;blockchain;smart contract;cross-contract vulnerability;graph neural networks},
 month = {Oct},
 number = {},
 pages = {751-757},
 title = {FFGDetector: Vulnerability Detection in Cross-Contract Feature Flow Graph Using GCN},
 volume = {},
 year = {2024}
}
