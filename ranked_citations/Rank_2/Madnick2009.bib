@article{Madnick2009,
 abstract = {Awareness of data and information quality issues has grown rapidly in light of the critical role played by the quality of information in our data-intensive, knowledge-based economy. Research in the past two decades has produced a large body of data quality knowledge and has expanded our ability to solve many data and information quality problems. In this article, we present an overview of the evolution and current landscape of data and information quality research. We introduce a framework to characterize the research along two dimensions: topics and methods. Representative papers are cited for purposes of illustrating the issues addressed and the methods used. We also identify and discuss challenges to be addressed in future research. © 2009 ACM.},
 author = {Madnick, Stuart E. and Wang, Richard Y. and Lee, Yang W. and Zhu, Hongwei},
 doi = {10.1145/1515693.1516680},
 journal = {Journal of Data and Information Quality},
 note = {Cited by: 333},
 number = {1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Overview and framework for Data and information quality research},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/78049459123?origin=resultslist},
 volume = {1},
 year = {2009}
}
