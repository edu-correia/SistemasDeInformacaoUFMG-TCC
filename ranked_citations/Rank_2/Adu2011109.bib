@article{Adu2011109,
 abstract = {In this paper, a multi-focus image fusion method based on the weighted non-negative matrix factorization and focal point analysis is presented to improve image fusion method based on non-negative matrix factorization. The relationship among the point spread function, the optical system and imaging processing is analyzed in the method, then a weighted matrix U is built by calculating the difference between the original image and the image processed by a Gaussian function. Finally, the weighted non-negative matrix algorithm which is applied to image fusion will make all parts of a new image clear. Experimental results show that this image fusion method obtains better effect than NMF method, LP method and DWT method.},
 author = {Adu, Jian Hua and Wang, Minghui},
 doi = {10.4156/jcit.vol6.issue7.14},
 journal = {Journal of Convergence Information Technology},
 note = {Cited by: 6},
 number = {7},
 pages = {109 - 117},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi-focus image fusion based on WNMF and focal point analysis},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/79961074420?origin=resultslist},
 volume = {6},
 year = {2011}
}
