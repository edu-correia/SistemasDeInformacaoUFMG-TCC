@article{10.1145/2287718.2287726,
 abstract = {We show that strict deterministic propositional dynamic logic with intersection is highly undecidable, solving a problem in the Stanford Encyclopedia of Philosophy. In fact we show something quite a bit stronger. We introduce the construction of program equivalence, which returns the value ⊤ precisely when two given programs are equivalent on halting computations. We show that virtually any variant of propositional dynamic logic has a Π11-hard validity problem if it can express even just the equivalence of well-structured programs with the empty program skip. We also show, in these cases, that the set of propositional statements valid over finite models is not recursively enumerable, so there is not even an axiomatization for finitely valid propositions.},
 address = {New York, NY, USA},
 articleno = {26},
 author = {Goldblatt, Robert and Jackson, Marcel},
 doi = {10.1145/2287718.2287726},
 issn = {1529-3785},
 issue_date = {August 2012},
 journal = {ACM Trans. Comput. Logic},
 keyword = {PDL, deterministic propositional dynamic logic, fixset, intersection, program equivalence, undecidability},
 month = {August},
 number = {3},
 numpages = {8},
 publisher = {Association for Computing Machinery},
 title = {Well-structured program equivalence is highly undecidable},
 url = {https://doi.org/10.1145/2287718.2287726},
 volume = {13},
 year = {2012}
}
