@inproceedings{10235190,
 abstract = {Crossbreed suppressed hole data fusion in cloud based big data servers is a process of merging data from multiple sources into a common view. This data fusion process combines information from different sources, such as databases, cloud services, sensors, and IoT devices, to provide more insights into customer preferences and trends. The use of big data servers provides the ability to access large amounts of data from a variety of sources simultaneously, and store them in such a way that it can be manipulated and analyzed into a single, unified format. Crossbreed suppressed hole data fusion in cloud-based big data servers can enable organizations to discover precise customer preferences by correlating data from multiple sources. Moreover, this approach can help businesses to better understand customer behaviors and preferences, and uncover valuable insights that can be used to improve customer service, marketing campaigns and product offerings.},
 author = {Kapoor, Prakriti},
