 doi = {10.1109/WCONF58270.2023.10235190},
 issn = {},
 keyword = {Image sensors;Cloud computing;Soft sensors;Decision making;Data integration;Organizations;Big Data;crossbreed;data fusion;cloud;data server;database},
 month = {July},
 number = {},
 pages = {1-7},
 title = {An Elegant Emotion Identification Model for Crossbreed Suppressed Hole Data Fusion in Cloud Based Big Data Servers},
 volume = {},
 year = {2023}
