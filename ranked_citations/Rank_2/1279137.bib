@inproceedings{1279137,
 abstract = {We present a novel differential synchronous demodulator intended for signal conditioning in a network of conductivity sensors for water quality monitoring. The proposed circuit merges the demodulating and low-pass filtering stages in a single integrator stage and yields the quality performance inherent to coherent demodulation with the added advantages of compactness and low-cost. In the range from 1 kHz to 10 kHz, the common mode rejection ratio is better than 70 dB and the signal-to-noise ratio exceeds 70 dB.},
 author = {Casanella, R. and Casas, O. and Pallas-Areny, R.},
 booktitle = {SENSORS, 2003 IEEE},
 doi = {10.1109/ICSENS.2003.1279137},
 issn = {},
 keyword = {Demodulation;Conductivity measurement;Switches;Integrated circuit measurements;Frequency;Low pass filters;Digital signal processing;Sea measurements;Costs;Dynamic range},
 month = {Oct},
 number = {},
 pages = {1209-1213 Vol.2},
 title = {Differential synchronous demodulator for conductivity sensors},
 volume = {2},
 year = {2003}
}
