@article{Khoulqi202328,
 abstract = {Mammography is a prominent and important imaging technique that is recognized as the industry benchmark for detecting breast cancer at an early stage. Computer-aided diagnosis systems (CAD) have made it possible to perform diagnostic procedures more quickly and efficiently; otherwise, if only radiologists were involved and engaged in the process, that may take weeks. These CAD systems, owing to their intensities being close to those of abnormal intensity tissue, pectoral muscles (PM), which are positioned in the upper corner of the mammography in the Medio-Lateral-Oblique view (MLO), must be separated from breast tissue. In order to accomplish our goal, we must first start the preprocessing phase to remove artifacts, labels and digitized lines and to enhance the quality of boundaries and structures. This paper suggests and evaluates a method for removing PM from MLO mammograms. This approach is based on semantic segmentation using DeeplabV3Plus. The suggested methodology has been tested on digital mammography from the MIAS database for implementation, experimentation, and verification. © 2023, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Khoulqi, Ichrak and Idrissi, Najlae},
 doi = {10.1007/978-3-031-46584-0_3},
 journal = {Lecture Notes in Networks and Systems},
 note = {Cited by: 0},
 pages = {28 - 36},
 publication_stage = {Final},
 source = {Scopus},
 title = {Pectoral Muscle Segmentation Using Mammogram Images in Medio Lateral Oblique View},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85177193579?origin=resultslist},
 volume = {806 LNNS},
 year = {2023}
}
