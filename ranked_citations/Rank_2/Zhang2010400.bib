@article{Zhang2010400,
 abstract = {With the increasing popularity of cloud computing, Hadoop has become a widely used open source cloud computing framework for large scale data processing. However, few efforts have been made to demonstrate the applicability of Hadoop to various real-world application scenarios in fields other than server side computations such as web indexing, etc. In this paper, we use the Hadoop cloud computing framework to develop a user application that allows processing of scientific data on clouds. A simple extension to Hadoop's MapReduce is described which allows it to handle scientific data processing problems with arbitrary input formats and explicit control over how the input is split. This approach is used to develop a Hadoop-based cloud computing application that processes sequences of microscope images of live cells, and we test its performance. It is discussed how the approach can be generalized to more complicated scientific data processing problems. © 2010 Springer-Verlag.},
 author = {Zhang, Chen and De Sterck, Hans and Aboulnaga, Ashraf and Djambazian, Haig and Sladek, Rob},
 doi = {10.1007/978-3-642-12659-8_29},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 40},
 pages = {400 - 415},
 publication_stage = {Final},
 source = {Scopus},
 title = {Case study of scientific data processing on a cloud using Hadoop},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77952400308?origin=resultslist},
 volume = {5976 LNCS},
 year = {2010}
}
