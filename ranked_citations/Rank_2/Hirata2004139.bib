@article{Hirata2004139,
 abstract = {Mitsubishi Kasei and Mitsubishi Petrochemical merged to become Mitsubishi Chemical in 1994 making it the largest chemical company in Japan. This allows two original companies' production sites, especially for those are physically built next to each other, to improve themselves by multi-site integration. Mitsubishi Yokkaichi production plant site is one of the typical examples, which consists of three individual plant sites in the old company structure. Each plant site contains a utility plant to generate steam and electricity for chemical production. After the company merge, connecting steam and electricity among plant sites have been carried out for better flexibility, efficiency as well as capability of the utility systems. Besides these, there are still many other improvement alternatives. A site-model, which includes all three utility plants and production units, was then developed to explore further opportunities. In this paper, applications at Mitsubishi Yokkaichi production site are presented to illustrate the features of the site-model. © 2003 Elsevier Ltd. All rights reserved.},
 author = {Hirata, Kentaro and Sakamoto, Haruo and O'Young, Lionel and Cheung, Kwok-Yuen and Hui, Chi-Wai},
 doi = {10.1016/S0098-1354(03)00176-5},
 journal = {Computers and Chemical Engineering},
 note = {Cited by: 16},
 number = {1-2},
 pages = {139 - 148},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multi-site utility integration - An industrial case study},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/0346099406?origin=resultslist},
 volume = {28},
 year = {2004}
}
