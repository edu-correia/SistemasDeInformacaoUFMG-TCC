@inproceedings{7734227,
 abstract = {Fisheye lens and Luneburg lens are lenses with different refractive index distributions. Combination of two of them in an acoustic wave will pave way for special features in acoustic wave and simplify methods of focusing or defocusing acoustic energy. Here, we designed anisotropic acoustic metamaterials in sub wavelength unit cells and shaped their effective parameters to control acoustic wavefront and produce distinct refractive index distribution at each coordinate directions. The simulation results show the effectiveness of the proposed structure in controlling acoustic waves and merging two different lenses to work in single device. Also proposed, is an acoustic bifunctional square lens with different focus points at each coordinate directions using the same method. This procedure opens up an avenue in acoustic wave to combine other lenses in single device and control acoustic propagation.},
 author = {Yahya, Muhyiddeen and Bin Zheng and Rongrong Zhu and Hongsheng Chen},
 booktitle = {2016 Progress in Electromagnetic Research Symposium (PIERS)},
 doi = {10.1109/PIERS.2016.7734227},
 issn = {},
 keyword = {Lenses;Acoustic waves;Electromagnetics;Refractive index;Information science;Optical refraction},
 month = {Aug},
 number = {},
 pages = {45-45},
 title = {Bifunctional acoustic lens},
 volume = {},
 year = {2016}
}
