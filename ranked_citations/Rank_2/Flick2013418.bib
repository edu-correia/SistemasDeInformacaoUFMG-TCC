@conference{Flick2013418,
 abstract = {Malleable jobs can adapt to varying degrees of available parallelism. This is an interesting approach to more flexible usage of parallel resources. For example, malleable jobs can be scheduled optimally and efficiently where more restricted forms of parallel jobs are NP-hard to handle. However, little work has been done on how to make fundamental computations malleable. We study how this can be done for sorting. Our algorithm is an adaptive version of Multiway Merge Sort and outperforms a state-of-the art implementation in the multi core STL when the number of available cores fluctuates. © 2013 IEEE.},
 author = {Flick, Patrick and Sanders, Peter and Speck, Jochen},
 doi = {10.1109/IPDPS.2013.90},
 journal = {Proceedings - IEEE 27th International Parallel and Distributed Processing Symposium, IPDPS 2013},
 note = {Cited by: 5},
 pages = {418 - 426},
 publication_stage = {Final},
 source = {Scopus},
 title = {Malleable sorting},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84884875508?origin=resultslist},
 year = {2013}
}
