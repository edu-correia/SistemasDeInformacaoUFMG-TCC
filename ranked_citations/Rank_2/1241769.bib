@inproceedings{1241769,
 abstract = {This paper develops methodologies and technologies for ultrasonic self-localization of an autonomous mobile robot (AMR) using a fuzzy adaptive extended information filtering scheme. A novel ultrasonic localization system consisting of two ultrasonic transmitters and three receivers, is presented to estimate both the static and dynamic position and orientation of the AMR. A fuzzy adaptive extended information filter (FAEIF) is presented to improve estimation accuracy and robustness for the proposed localization system, while the system lacks of sufficient information of complete models of the process and measurement noise varies with time. A static pose estimation utilizing the averaging approach is investigated as well. Six time-of-flight ultrasonic measurements together with the vehicle's dead-reckoned location information are merged to update the vehicle's dead-reckoned location information are merged to update the vehicle's pose by utilizing FAEIF sensor fusion algorithm. The proposed algorithm were implemented using an industrial personal computer with a computation speed of 800 MHz, and standard C++ programming techniques. The system prototype together with computer simulations and experimental results has been used to confirm that the system not only provides precise estimation of both the static and dynamic pose of the AMR, but also provides a simpler and more economical structure for navigation use and installation/calibration.},
 author = {Hung-Hsing Lin and Ching-Chih Tsai and Jui-Cheng Hsu and Chih-Fu Chang},
 booktitle = {2003 IEEE International Conference on Robotics and Automation (Cat. No.03CH37422)},
 doi = {10.1109/ROBOT.2003.1241769},
 issn = {1050-4729},
 keyword = {Mobile robots;Information filtering;Vehicle dynamics;Ultrasonic variables measurement;Transmitters;Fuzzy systems;Information filters;Noise robustness;Noise measurement;Time measurement},
 month = {Sep.},
 number = {},
 pages = {1283-1290 vol.1},
 title = {Ultrasonic self-localization and pose tracking of an autonomous mobile robot via fuzzy adaptive extended information filtering},
 volume = {1},
 year = {2003}
}
