@inproceedings{4667946,
 abstract = {Sensory and multi-sensory analysis has become a powerful tool for helping industrial companies in product design, quality inspection and marketing exploitation. This approach permits to formalize and characterize some complex concepts such as comfort, well-being and sustainable development. However, developing a suitable sense measuring device, an efficient working procedure and a powerful computing method for modeling human perception and merging five human senses is quite difficult because there exists too much uncertainty and imprecision in human sensory and multi-sensory evaluation procedures and related results (semantic ambiguity, non normalized data, data reliability, ldrldrldr). Intelligent techniques can be used together with the classical computational tools in a complementary way for extracting relevant information from human senses. This paper outlines the general background of sensory and multi-sensory analysis and the corresponding industrial interests and explicitly indicates some orientations for further development by IT researchers.},
 author = {Zeng, Xianyi and Koehl, Ludovic},
 booktitle = {2008 Fourth International Conference on Natural Computation},
 doi = {10.1109/ICNC.2008.898},
 issn = {2157-9563},
 keyword = {Humans;Textile industry;Computer industry;Product design;Sustainable development;Intelligent sensors;Data mining;Knowledge management;Auditory system;Chemical industry;sensory analysis;design;marketing;intelligent techniques},
 month = {Oct},
 number = {},
 pages = {65-69},
 title = {An Overview on Sensory and Multi-Sensory Analysis and Related Industrial Applications},
 volume = {7},
 year = {2008}
}
