@article{10.1145/3746286,
 abstract = {This article presents a novel scenario-based testing framework for the evaluation of black-box autonomous vehicles (AVs) in diverse traffic scenarios. The framework aims to bridge the gap between formal scenario description, simulation integration in the realm of safety validation, and modular explainability techniques. The proposed framework consists of a formal means of scenario specification and a testing template that exploits scenario description at the functional and concrete abstraction layers. The testing template is modularized using the terminology of these AV scenario description strategies; then, bottlenecks in the testing process are identified, and solutions are suggested, which we validate using experiments. To optimize the utilization of the generated scenario data, we also present an innovative data model and an Explainable Artificial Intelligence (XAI) component, demonstrating their practicality through a detailed AV case study. This comprehensive approach promises significant advances in the evaluation and understanding of complex system behavior, thereby paving the way for safer and more reliable AVs and various other applications. Furthermore, insights derived from the scenario interpretation component can be harnessed to refine the precision of the scenario selection process, potentially enhancing both performance and efficiency.},
 address = {New York, NY, USA},
 articleno = {16},
 author = {Goss, Quentin and Pate, Williams Clay and undefinedlhan Akba\c{s}, Mustafa},
 doi = {10.1145/3746286},
 issue_date = {September 2026},
 journal = {ACM J. Auton. Transport. Syst.},
 keyword = {Autonomous vehicles, validation, explainable artificial intelligence, scenario-based testing},
 month = {March},
 number = {3},
 numpages = {44},
 publisher = {Association for Computing Machinery},
 title = {An Integrated Framework for Scenario-Based Safety Validation and Explainability of Autonomous Vehicles},
 url = {https://doi.org/10.1145/3746286},
 volume = {3},
 year = {2026}
}
