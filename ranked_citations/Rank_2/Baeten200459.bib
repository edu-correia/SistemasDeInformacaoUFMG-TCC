@article{Baeten200459,
 abstract = {We treat theory and application of timed process algebra. We focus on a variant that uses explicit termination and action prefixing. This variant has some advantages over other variants. We concentrate on relative timing, but the treatment of absolute timing is similar. We treat both discrete and dense timing. We build up the theory incrementally. The different algebras are interrelated by embeddings and conservative extensions. As an example, we consider the PAR communication protocol. © Springer-Verlag 2004.},
 author = {Baeten, J.C.M. and Reniers, M.A.},
 doi = {10.1007/978-3-540-30080-9_3},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 7},
 pages = {59 - 97},
 publication_stage = {Final},
 source = {Scopus},
 title = {Timed Process Algebra (With a Focus on Explicit Termination and Relative-Timing)},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33746354864?origin=resultslist},
 volume = {3185},
 year = {2004}
}
