@article{XIE2026113021,
 abstract = {Clustering by Fast Search and Find of Density Peaks (DPC), assumes that cluster centers have high local density and are far from other centers. DPC identifies cluster centers using a decision graph, leveraging the relationship between density and distance. However, DPC has several drawbacks: it ignores variations in point density, leading to inaccurate cluster center identification and the domino effect. Additionally, its reliance on Euclidean distance distorts the global structure, affecting center selection in the decision graph. Although variations of DPC attempt to address these issues, they often increase algorithmic complexity without fully resolving them. This paper proposes a Robust Density Clustering based on Density Peak Regions and K-Nearest Neighbors (DPRC-KNN), which offers a relatively simple yet effective approach. DPRC-KNN divides the clustering process into two key strategies: extracting DPR and performing nearest-neighbor assignment. DPR introduces a novel assumption based on DPC and defines a new dissimilarity measure. The second strategy assigns the remaining points by merging them with clusters. The algorithm is evaluated on synthetic and UCI datasets, standard benchmarks for clustering performance. Experimental results demonstrate that the proposed algorithm outperforms three classical clustering algorithms and five extended variations of DPC, including the original DPC method.},
 author = {Jingyu Xie and Caiming Zhong and Yu Tian and Lianyu Hu and Tiejun Pan},
 doi = {https://doi.org/10.1016/j.patcog.2025.113021},
 issn = {0031-3203},
 journal = {Pattern Recognition},
 keyword = {Clustering, Density-based clustering, Density peaks, -nearest neighbors, Density peak regions},
 pages = {113021},
 title = {Robust density clustering based on density peak regions and K-nearest neighbors},
 url = {https://www.sciencedirect.com/science/article/pii/S003132032501684X},
 volume = {174},
 year = {2026}
}
