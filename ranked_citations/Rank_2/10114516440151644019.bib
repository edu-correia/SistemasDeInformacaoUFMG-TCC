@article{10.1145/1644015.1644019,
 abstract = {In this work we present an in-depth study of randomized relaxed K-d trees. It covers two fundamental aspects: the randomized algorithms that allow to preserve the random properties of relaxed K-d trees and the mathematical analysis of the expected performance of these algorithms.In particular, we describe randomized update algorithms for K-d trees based on the split and join algorithms of Duch et al. [1998]. We carry out an analysis of the expected cost of all these algorithms, using analytic combinatorics techniques. We show that the average cost of split and join is of the form ζ(K) ⋅ nϕ(K) + o(nϕ(K)), with 1 ≤ ϕ(K) &lt; 1.561552813, and we give explicit formul\ae{} for both ζ(K) and ϕ(K). These results on the average performance of split and join imply that the expected cost of an insertion or a deletion is Θ(nϕ(K)−1) when K &gt; 2 and Θ(log n) for K = 2.},
 address = {New York, NY, USA},
 articleno = {4},
 author = {Duch, Amalia and Mart\'{\i}nez, Conrado},
 doi = {10.1145/1644015.1644019},
 issn = {1549-6325},
 issue_date = {December 2009},
 journal = {ACM Trans. Algorithms},
 keyword = {K-dimensional trees, Analytic combinatorics, Continuous Master Theorem, multidimensional data structures, randomized algorithms, relaxed K-d trees},
 month = {December},
 number = {1},
 numpages = {24},
 publisher = {Association for Computing Machinery},
 title = {Updating relaxed K-d trees},
 url = {https://doi.org/10.1145/1644015.1644019},
 volume = {6},
 year = {2010}
}
