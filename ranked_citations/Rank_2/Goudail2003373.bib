@article{Goudail2003373,
 abstract = {We address the problem of the characterization of segmentation performance of Minimum Description Length snake techniques in function of the noise which affects the image. It is shown that a parameter quantifying the contrast between the object of interest and the background can be defined from the Bhattacharyya distance. This contrast parameter is very general since it applies to several different noise statistics which belong to the exponential family. We illustrate its relevancy with a segmentation application using a polygonal snake descriptor. © Springer-Verlag Berlin Heidelberg 2003.},
 author = {Goudail, François and Réfrégier, Philippe and Ruch, Olivier},
 doi = {10.1007/978-3-540-45063-4_24},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 10},
 pages = {373 - 388},
 publication_stage = {Final},
 source = {Scopus},
 title = {Definition of a signal-to-noise ratio for object segmentation using polygonal MDL-based statistical snakes},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/35248895250?origin=resultslist},
 volume = {2683},
 year = {2003}
}
