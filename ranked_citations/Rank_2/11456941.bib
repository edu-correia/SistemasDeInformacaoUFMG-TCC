@article{11456941,
 abstract = {Commercial silicon carbide (SiC) Schottky diodes are predominantly realized in junction barrier Schottky (JBS) and merged p-type–intrinsic–n-type (PiN) Schottky (MPS) configurations, while homogeneous Schottky-barrier diodes (SBDs) with metal–semiconductor contacts have recently emerged for high-voltage applications. This paper presents a comprehensive review of the structural evolution, operating principles, and performance trade-offs of these architectures. Particular emphasis is placed on (1) fundamental current-transport mechanisms in homogeneous Schottky diodes, (2) reverse-bias electric-field modulation in JBS structures, and (3) surge-current enhancement and bipolar conduction effects in MPS devices. By synthesizing device-physics principles with structural design considerations, this review provides a consolidated framework to guide future optimization and next-generation SiC Schottky rectifiers for advanced power-conversion systems.},
 author = {Damcevska, Jenny and Dimitrijev, Sima and Haasmann, Daniel and Tanner, Philip},
 doi = {10.1109/EDR.2026.3678514},
 issn = {2995-424X},
 journal = {IEEE Electron Devices Reviews},
 keyword = {Schottky diodes;Metals;Silicon carbide;Electrons;Electron traps;Reviews;Silicon;Schottky barriers;Energy barrier;Electric fields;Schottky barrier diode;junction barrier Schottky diode;merged PiN Schottky diode;silicon carbide;surge current;blocking voltage;thermionic emission;tunneling},
 month = {},
 number = {},
 pages = {102-124},
 title = {Fundamentals of Silicon Carbide Schottky Diodes: A Review},
 volume = {3},
 year = {2026}
}
