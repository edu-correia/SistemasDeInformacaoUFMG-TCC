@inproceedings{7804676,
 abstract = {This research work focuses to design Hybrid OCDMA over WDM system with advance modulation techniques DPSK which will improve the performance for long distance fiber length. Hybrid system merges with different types of techniques like OCDMA and WDM. Modified double weight (MDW) code is proposed as the signature address code. Multiuser interference and increase the bit-error-rate might be condense satisfactory by this Hybrid System. OptiSystem 12.0 simulation software to be employs for comparing two different Bit Rate 622 Mb/s and 1 Gb/s. In this paper, spectral direct detection technique has been used. Simulation results illustrate that hybrid-DPSK system yield better performance and enhance the network competence.},
 author = {Islam, Monirul and Ahmed, Nasim and Ali, Sharafat and Aljunid, Syed Alwee and Ahmed, Badlishah Bin and Sayeed, Shohel},
 booktitle = {2016 3rd International Conference on Electronic Design (ICED)},
 doi = {10.1109/ICED.2016.7804676},
 issn = {},
 keyword = {Optical fibers;Bit error rate;Integrated optics;Adaptive optics;Differential phase shift keying;Optical fiber networks;Optical Code Division Multiple Access;Wavelength Division Multiplexing;Bit Error Rate;On-Off Keying;Signal to Noise Ratio},
 month = {Aug},
 number = {},
 pages = {395-399},
 title = {Design new hybrid system using differential phase shift keying (DPSK) modulation technique for optical access network},
