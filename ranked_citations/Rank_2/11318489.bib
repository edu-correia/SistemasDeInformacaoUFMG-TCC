@inproceedings{11318489,
 abstract = {Alzheimer’s disease is an advancing neurodegenerative disorder with cognitive impairment. Early and accurate diagnosis supports therapeutic intervention and patient management. In this work, we present a deep learning model that will integrate structural Magnetic Resonance Imaging and functional Positron Emission Tomography information for automated Alzheimer’s disease classification. The architecture exploits two sub-models of convolutional neural network to learn complementary features in MRI and PET, that are combined at feature level for multiclass recognition of cognitive status, and cognitively normal. We evaluated the model on the Alzheimer’s Disease Neuroimaging Initiative dataset with high accuracy in Alzheimer’s disease and Mild Cognitive Impairment discrimination from cognitively normal subjects. Notably, the multimodal fusion model was more accurate than single modality models, confirming that merging MRI and PET provides improved diagnostic performance. Moreover, flexible inference is enabled by the architecture so that effective Alzheimer’s disease classification can be achieved even when the MRI or PET images alone are utilized at test time. We summarize the new model structure, training habit, and test results. Our findings demonstrate the effectiveness of MRI and PET deep learning fusion in improving Alzheimer’s disease classification accuracy, yielding a promising diagnostic tool in clinical applications.},
 author = {Jayman, Z. S. and Lakmal, H. K. I. S.},
 booktitle = {2025 9th SLAAI International Conference on Artificial Intelligence (SLAAI-ICAI)},
 doi = {10.1109/SLAAI-ICAI68534.2025.11318489},
 issn = {},
 keyword = {Deep learning;Neuroimaging;Adaptation models;Accuracy;Magnetic resonance imaging;Brain modeling;Convolutional neural networks;Alzheimer's disease;Positron emission tomography;Artificial intelligence;Alzheimer’s Disease (AD);Convolutional Neural Network (CNN);Deep Learning;Flexible Inference;Magnetic Resonance Imaging (MRI);Multimodal Fusion;Neuroimaging;Positron Emission Tomography (PET)},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Multimodal Deep Learning for Alzheimer’s Diagnosis Using PET and MRI},
