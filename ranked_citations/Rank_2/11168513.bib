@inproceedings{11168513,
 abstract = {Virtual machine (VM) auto-scaling helps manage cloud resources while ensuring performance and cost efficiency. The rule-based and heuristic approaches fail to adapt quickly to workload changes which leads to suboptimal resource management. This research proposes an auto-scaling framework merging CNN-LSTM forecasting with Kalman filter real-time adjustment capabilities. The framework uses core workload indicators to forecast future VM requirements from analyzing memory utilization, CPU usage, traffic, disk I/O and the request rate. The Kalman filter enhances prediction accuracy by continuously adapting to sudden changes in demand levels. The framework is validated using CloudSim Plus-6 to evaluate its performance against BiLSTM, TCN, N-BEATS-GRU and Transformer models using a synthetic dataset which was created through CloudSim Plus 6. The CNN-LSTM model achieved the highest accuracy (96.66 %) with the lowest inference latency. The proposed framework integrates forecasting and correction steps into a single real-time VM scaling process which differs from current methods that handle these steps independently. This integration results in superior resource utilization, better workload response capabilities and reduced costs offering a robust auto-scaling solution for modern cloud systems.},
 author = {Ram, Chandan B. and Sumathi, R.},
 booktitle = {2025 3rd International Conference on Data Science and Network Security (ICDSNS)},
 doi = {10.1109/ICDSNS65743.2025.11168513},
 issn = {},
 keyword = {Cloud computing;Adaptation models;Accuracy;Computational modeling;Predictive models;Virtual machines;Real-time systems;Kalman filters;Resource management;Forecasting;cloud computing;auto-scaling;CNN-LSTM;kalman filter;cloudsim plus;time-series forecasting;virtual machines},
 month = {July},
 number = {},
 pages = {1-7},
 title = {AI Powered Hybrid Framework for Efficient VM Auto-Scaling in Cloud Computing},
 volume = {},
 year = {2025}
