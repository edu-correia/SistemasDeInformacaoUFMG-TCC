@article{FICSOR2025102315,
 abstract = {Hypergraphs provide a robust framework for modeling complex, multi-actor interactions that traditional graphs struggle to represent. In many real-world applications, interactions involve more than just pairs of entities, which makes hypergraphs an essential tool for capturing these multidimensional relationships. Although there are various visualization tools, they often face challenges when handling large- or dense-scale hypergraphs, where overlapping vertices and edges impede clarity and interpretation. The proposed visualization tool addresses these challenges by providing an interactive and feature-rich environment to explore hypergraphs. The tool has been built using the Godot Engine, exploiting the potential its efficient rendering, real-time interactivity, and adaptable scripting to facilitate smooth and intuitive hypergraph visualization. Users can import or manually create hypergraphs, choose from multiple layouts (force-directed, circular, grid), and customize hyperedge widths and vertex sizes for clearer insights. Edge colors are adjustable for enhanced distinction. Hyperedges are rendered using Andrew’s monotone chain algorithm to avoid overlap even in large-scale hypergraphs. In addition to these features, users can define multiple groups within the hypergraph, where each group has a distinct visual style, allowing for direct comparison of two or more hypergraphs by merging them into one unified view. This facilitates comparative analysis and makes it easier to observe differences and similarities between various hypergraph structures. Moreover, users can interactively explore the visualization by selecting vertices to isolate edges and using a smooth camera system for zooming and navigation, enabling both macro- and micro-level analysis. We believe that this niche interactive hypergraph visualization tool can enhance research activities and facilitate deeper analytical insights.},
 author = {Attila Ficsor and Timea Czvetko and Viktor Sebestyen and Janos Abonyi},
 doi = {https://doi.org/10.1016/j.softx.2025.102315},
 issn = {2352-7110},
 journal = {SoftwareX},
 keyword = {Hypergraphs, Visualization, Godot engine},
 pages = {102315},
 title = {HyperGodot: Interactive hypergraph visualization tool},
 url = {https://www.sciencedirect.com/science/article/pii/S235271102500281X},
 volume = {31},
 year = {2025}
}
