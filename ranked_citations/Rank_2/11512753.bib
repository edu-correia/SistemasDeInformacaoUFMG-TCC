@inproceedings{11512753,
 abstract = {Under the paradigm of mass customization, the personalized and dynamic nature of user requirements introduces significant challenges to the dynamic reconfiguration of product-service system configurations. Traditional optimization-based configurations focus on defining configuration problems and constructing optimization models, yet neglect the analysis of interrelationships among configuration elements and their standardized expression. Conversely, knowledge-based product-service systems emphasize knowledge representation and management, while overlooking the extension of optimization methodologies. Therefore, this paper proposes a knowledge graph-based approach for generating and optimizing personalized product-service system configuration schemes, designing an integrated model framework that combines both aspects. This method merges ontology-based knowledge representation models with feature-matching multi-objective optimization algorithms. First, a systematic configuration framework is established. Second, a knowledge graph is constructed that integrates user requirements and their conflicts, alongside the product-service system and its internal conflicts. To achieve configuration optimization, a personalized demand-driven reasoning and instance matching logic is designed, constructing a multi-objective optimization model that bridges the knowledge graph with subsequent optimization processes. Finally, case studies validate the feasibility of this approach, demonstrating its potential as a theoretical and practical foundation for innovative and resilient product-service system configuration.},
 author = {Yuan, Shaolin and Li, Hailong and Cao, Yaoyu and Gong, Shihan and He, Lina},
 booktitle = {2025 4th International Conference on Advanced Sensing, Intelligent Manufacturing (ASIM)},
 doi = {10.1109/ASIM67379.2025.11512753},
 issn = {},
 keyword = {Modeling;Ontologies;Modules (abstract algebra);Optimization;Knowledge graphs;Optimization models;Distance measurement;Printing;Indexes;Indexing;knowledge graph;personalized requirement;intelligent product system configuration;optimization model;resilience},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Research on Knowledge Graph-Based Intelligent Product System Configuration Scheme Generation and Optimization Methods},
