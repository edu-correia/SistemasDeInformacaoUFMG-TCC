@article{10168796,
 abstract = {Rapid long Pseudo-noise (PN) code acquisition is challenging in Direct sequence spectrum system (DSSS) and Global navigation satellite system (GNSS). The difficulty is how to quickly detect numerous code phases and lots of frequency cells. In the study, a three-stage acquisition method is proposed. In search stage one, a few code phases and several frequency cells are merged into a single cell, to directly reduce the cardinality of search space. The reduction is favorable to accelerate search process. Then, in search stage two and search stage three, fine acquisitions for frequency cells and code phases are performed, respectively. Compared with the Extended replica folding acquisition search technique (XFAST), the proposed method tests more code phases and frequency cells simultaneously and consequently reduces mean acquisition time at the expense of degrading detection performance. Numerical results demonstrate the analysis.},
 author = {Li, Hong and Lu, Mingquan and Feng, Zhenming},
 doi = {10.23919/CJE.2010.10168796},
 issn = {2075-5597},
 journal = {Chinese Journal of Electronics},
 keyword = {Time-frequency analysis;Global navigation satellite system;Codes;Correlation;Phase frequency detectors;Spread spectrum communication;Testing;Rapid acquisition;Time-frequency folding technique (TFFT);Long PN-code;Detection performance;Mean acquisition time},
 month = {October},
 number = {4},
 pages = {727-732},
 title = {Three-Stage Based Rapid Long PN-code Acquisition Method by Employing Time-Frequency Folding Technique},
 volume = {19},
 year = {2010}
}
