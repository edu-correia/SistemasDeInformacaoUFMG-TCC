@article{XIA2025111131,
 abstract = {Surface defect detection is critical in chip manufacturing and plays a key role in product quality control. However, due to the complexity of surface defects, existing segmentation methods still face challenges in robustness and noise resistance, and the encoding of features does not balance local detail information and global dependency well, leading to lower accuracy. Recently, diffusion models have gained traction in various vision tasks for their strong generative and noise-resistant capabilities. To address these challenges, this study introduces an innovative end-to-end defect segmentation method based on a diffusion model and attention mechanism (DASeg-Net). First, the High-frequency and Low-frequency attention mechanism (HiLo) is introduced into the feature encoder, which employs a dual branch to enhance both the global dependency and local detail information of the defect features, thereby achieving balanced encoding. Second, an enhanced feature fusion module, Spatial Attention Fusion Module (SAFM), is designed to strengthen the integration of features across different levels from a spatial perspective, facilitating the effective merging of deep semantic features with shallow ones. Third, an auxiliary edge branch is introduced to bolster the focus on the subtle features of defective edges. Fourth, a transformer-based denoising decoder is employed to combine the encoded features with noise masks, progressively denoising to generate high-quality segmentation masks. Finally, extensive comparative experiments were conducted on our chip defect segmentation and other surface defect segmentation datasets. Specifically, the proposed method achieved mean Intersection over Union (mIoU) of 82.06 %, 86.04 %, 76.22 %, and 83.39 % on the four datasets. The results demonstrate that the proposed method exhibits superior robustness and achieves state-of-the-art performance.},
 author = {Zilin Xia and Yufan Zhao and Jinan Gu and Wenbo Wang and Zedong Huang and Yan Gao and Peiyue Sun},
 doi = {https://doi.org/10.1016/j.engappai.2025.111131},
 issn = {0952-1976},
 journal = {Engineering Applications of Artificial Intelligence},
 keyword = {Chip surface defect detection, Diffusion model, Attention mechanism, Semantic segmentation, Auxiliary edge branch},
 pages = {111131},
 title = {The end-to-end chip surface defect segmentation method based on the diffusion model and attention mechanism},
 url = {https://www.sciencedirect.com/science/article/pii/S0952197625011327},
 volume = {155},
 year = {2025}
}
