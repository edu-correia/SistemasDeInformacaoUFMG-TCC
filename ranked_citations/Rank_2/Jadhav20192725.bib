@article{Jadhav20192725,
 abstract = {We present a volume exploration framework, FeatureLego, that uses a novel voxel clustering approach for efficient selection of semantic features. We partition the input volume into a set of compact super-voxels that represent the finest selection granularity. We then perform an exhaustive clustering of these super-voxels using a graph-based clustering method. Unlike the prevalent brute-force parameter sampling approaches, we propose an efficient algorithm to perform this exhaustive clustering. By computing an exhaustive set of clusters, we aim to capture as many boundaries as possible and ensure that the user has sufficient options for efficiently selecting semantically relevant features. Furthermore, we merge all the computed clusters into a single tree of meta-clusters that can be used for hierarchical exploration. We implement an intuitive user-interface to interactively explore volumes using our clustering approach. Finally, we show the effectiveness of our framework on multiple real-world datasets of different modalities. © 2018 IEEE.},
 author = {Jadhav, Shreeraj and Nadeem, Saad and Kaufman, Arie},
 doi = {10.1109/TVCG.2018.2856744},
 journal = {IEEE Transactions on Visualization and Computer Graphics},
 note = {Cited by: 11; All Open Access; Green Open Access},
 number = {9},
 pages = {2725 - 2737},
 publication_stage = {Final},
 source = {Scopus},
 title = {FeatureLego: Volume exploration using exhaustive clustering of super-voxels},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85050202969?origin=resultslist},
 volume = {25},
 year = {2019}
}
