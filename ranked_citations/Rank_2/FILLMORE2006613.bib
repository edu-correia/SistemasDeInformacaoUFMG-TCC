@incollection{FILLMORE2006613,
 abstract = {This paper locates the linguistic-semantic use of frames within a merging of the traditions of using the word ‘frames’ in general cognitive science, where its connection to language is missing or incidental, and in linguistics and artificial intelligence where it was explicitly used for identifying the combinatory possibilities of lexical units, both syntactically (as, e.g., subcategorization frames) or semantically (as case frames). Examples are offered of the possible kinds of empirical and cognitive studies of English words and texts, and a sketch is provided of a large research effort devoted to the creation of a corpus-supported frame-based lexicon of English.},
 address = {Oxford},
 author = {C.J. Fillmore},
 booktitle = {Encyclopedia of Language & Linguistics (Second Edition)},
 doi = {https://doi.org/10.1016/B0-08-044854-2/00424-7},
 edition = {Second Edition},
 editor = {Keith Brown},
 isbn = {978-0-08-044854-1},
 keyword = {computational linguistics, corpus annotation, corpus-driven lexicography, corpus Linguistics, frames, language understanding, lexical semantics, lexicon building, polysemy, thematic structure},
 pages = {613-620},
 publisher = {Elsevier},
 title = {Frame Semantics},
 url = {https://www.sciencedirect.com/science/article/pii/B0080448542004247},
 year = {2006}
}
