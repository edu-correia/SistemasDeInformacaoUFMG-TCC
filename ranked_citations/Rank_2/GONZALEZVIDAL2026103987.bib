@article{GONZALEZVIDAL2026103987,
 abstract = {This qualitative, multiple-case study explores the integration of linguaculture (LC) —the meaning side of language—and fanfiction writing tasks supported by platforms like Fanfiction.Net in English as a Foreign Language (EFL) education within Chilean school contexts. Grounded on Risager's critical linguaculture pedagogy, the study adopts a transformative lens to examine how fanfiction can be used to interrogate cultural representations, stereotypes, and power relations in language learning through creativity and imagination. The Chilean EFL context was chosen due to insufficient curriculum guidance and professional development in integrating Computer-assisted Language Learning (CALL) and culture teaching methodologies. In response, the study examines fanfiction as a vehicle that merges language, culture, and technology education in EFL classrooms. Participants included three case study teachers who engaged in a reflective workshop to enhance their pedagogical practices through fanfiction task design. Data sources comprise teachers' project plans, reflective journal entries, post-workshop surveys, email interviews, and pre-workshop questionnaires, coded using NVivo 12 software and analysed thematically. Findings revealed that the workshop facilitated shifts in teachers' perceptions and practices, enabling them to meaningfully integrate local geography, historical events, and cultural perspectives into fanfiction-based tasks. The study suggests that strategic use of technology in LC-based fanfiction projects fosters deeper cultural understanding and student engagement beyond traditional classroom boundaries. Theoretical implications highlight the role of critical reflection and transformative pedagogy in enhancing educational practices, while practical implications emphasise the need for teacher training programs to incorporate reflective practices and technology skills. These findings contribute to the broader field of language education by advocating for innovative pedagogical approaches aligned with global educational agendas. Such approaches equip students for global citizenship and for navigating complex communication challenges in multilingual, transnational contexts.},
 author = {Tiare Gonzalez-Vidal},
 doi = {https://doi.org/10.1016/j.system.2026.103987},
 issn = {0346-251X},
 journal = {System},
 keyword = {EFL education, Fanfiction, Linguaculture, Reflective practice, Technology-enhanced learning},
 pages = {103987},
 title = {Transformative Pedagogy: Integrating linguaculture and technology-enhanced Fanfiction in Chilean EFL classrooms},
 url = {https://www.sciencedirect.com/science/article/pii/S0346251X26000187},
 volume = {138},
 year = {2026}
}
