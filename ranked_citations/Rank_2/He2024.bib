@conference{He2024,
 abstract = {In the upcoming 6G communications, radar sensing will merge with communication to support diverse application scenarios. However, within complex Integrated Sensing and Communication (ISAC) channels, radar targets and communication scatterers may overlap. Sensing and communication channels can exhibit similar sparse distributions in both the angle and delay domains. The increasing adoption of channel sparsity in communication parameter estimation has led to the development of numerous Compressed Sensing (CS) algorithms, many of which are based on the Expectation Maximization (EM) method. However, most EM-based algorithms depend on specific scenarios for designing channel sparse structures. Therefore, there is a pressing need to develop suitable channel sparse structures and tailor CS algorithms specifically for ISAC scenarios. This paper addresses the multiple-input multiple-output ISAC channel estimation issue using a bi-static model. We propose a Joint Angle-Delay Sparse Structure (JADSS) to capture the sparse characteristics of ISAC channels in both angle and delay domains. Additionally, we devise a message passing estimator to estimate the ISAC channel. Simulation demonstrate that the proposed CS algorithm achieves competitive error performance.  © 2024 IEEE.},
 author = {He, Zeqian and He, Ruisi and Ai, Bo and Zhang, Haoxiang and Yuan, Yuan and Zhong, Zhangdui},
 doi = {10.1109/ISAPE62431.2024.10841308},
 journal = {ISAPE 2024 - 14th International Symposium on Antennas, Propagation and EM Theory},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Channel Estimation via Joint Angle-Delay Sparse Structure in ISAC Scenarios},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85218356759?origin=resultslist},
 year = {2024}
}
