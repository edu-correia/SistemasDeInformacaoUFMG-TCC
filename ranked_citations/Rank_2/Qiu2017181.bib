@article{Qiu2017181,
 abstract = {In this paper, we have proposed a method of VRIS representation base-XGML. We have designed an imitation XGML model based on SVG and XML to assisting our VRIS representation. In the processing of our method, convert image features into a meta-data descriptor and using a split-and-merge algorithm transform image into element descriptors by utilizing XGML model. The model was applied to an experimental data set which included various vector images. Experiment results shows that our VRIS representation method can efficiently represent raster images which originally were vector image to a semi-structured XGML document, and it succefully reduced storage capacity of image and increases the speed of image retrieval. © 2017, Computer Society of the Republic of China. All rights reserved.},
 author = {Qiu, Jing and Yuan, Jia-Zheng and Liu, Hong-Zhe and Zhou, Cheng},
 doi = {10.3966/199115592017022801014},
 journal = {Journal of Computers (Taiwan)},
 note = {Cited by: 0},
 number = {1},
 pages = {181 - 192},
 publication_stage = {Final},
 source = {Scopus},
 title = {An VRIS representation method based on XGML},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85015337612?origin=resultslist},
 volume = {28},
 year = {2017}
}
