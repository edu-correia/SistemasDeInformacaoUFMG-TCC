@article{ZHU2026132819,
 abstract = {Dual-directional shearography overcomes the single sensitivity issue of conventional shearography by providing the displacement gradient in its complete set. We report a new designing routine of shearography by considering shearography operation as the phase transform of the incoming object wave. The framework of phase manipulating Fresnel lenses is proposed to establish simultaneous dual-directional shearography with common-path configuration by single wavelength, linear polarization, and single camera. By merging three laterally displaced Fresnel lenses, a new beam splitting mechanism is established for shearing interferometers, which naturally has the potential of introducing the phase shift for each interfering wavefront. The framework of phase manipulating Fresnel lenses enables the complete function of quantitative dual-directional shearography by integrating testing surface imaging, dual-directional shearing, and temporal phase shifting into a single phase manipulating mask. Rather than allocating the multi-directional phase information in different channels by wavelengths or polarizations, we develop a 9-step phase retrieval algorithm to disentangle and quantify the multi-directional phase information from the merged shearogram. Preliminary experiments are carried out with standard/defect targets for the proof of concept.},
 author = {Zirui Zhu and Qing Chang and Siyuan Qi and Shuai Gao and Weimin Sun and Félix Salazar-Bloise and Shengjia Wang},
 doi = {https://doi.org/10.1016/j.optcom.2025.132819},
 issn = {0030-4018},
 journal = {Optics Communications},
 keyword = {Shearing interferometry, Shearography, Phase manipulation, Dual directions, Phase shift},
 pages = {132819},
 title = {Simultaneous dual-directional shearography enabled by phase manipulating Fresnel lenses},
 url = {https://www.sciencedirect.com/science/article/pii/S0030401825013471},
 volume = {603},
 year = {2026}
}
