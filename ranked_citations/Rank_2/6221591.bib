@inproceedings{6221591,
 abstract = {Layering partition of power network is often used in the realms such as condition assessment, stability control and voltage control. In this paper, the voltage/reactive power optimization after hierarchical and distributed electric power system is based on the principle of hierarchical partition balance of reactive power balance . Firstly, Analysis is made on the topology structure of power network with partition made to choose the same layer District. Secondly, a new method of partition based on fuzzy clustering is proposed, which aim at the PQ nodes as the object to be classified with using the control action of each reactive power source as a characteristic index of the object, to divide PQ nodes into certain partitions and to merge PV node. Thirdly, a comprehensive sensitivity is put forward to solve the problem of how to determine the location of reactive power compensation devices and according to location to select the reactive power compensation capacity. Using Matlab platform to emulate this new algorithm, results demonstrate rationality and effectiveness of this new algorithm.},
 author = {Xu, Gang and Feng, Yingchun and Zhou, Qi},
 booktitle = {2012 11th International Conference on Environment and Electrical Engineering},
 doi = {10.1109/EEEIC.2012.6221591},
 issn = {},
 keyword = {Reactive power;Sensitivity;Optimization;Power system stability;Voltage control;Generators;reactive power optimization;layering partition;fuzzy clustering;comprehensive sensitivity},
 month = {May},
 number = {},
 pages = {292-297},
 title = {Comprehensive sensitivity-based reactive power optimization under the hierarchical and regional in transmission network},
 volume = {},
 year = {2012}
}
