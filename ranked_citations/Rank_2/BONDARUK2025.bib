@incollection{BONDARUK2025,
 abstract = {The aim of this article is to examine the Minimalist Program, the most recent embodiment of Generative Grammar. The focus is on the main tenets of the Program and its core elements, including the Strong Minimalist Thesis, Merge and the interfaces. The Minimalist Program adopts a parsimonious approach to language in which there is just one simple structure-building operation—Merge—which interacts with general laws of nature. Merge generates syntactic objects, which are accessed by the interfaces for interpretation and externalization.},
 author = {Anna Bondaruk},
 booktitle = {Reference Module in Social Sciences},
 doi = {https://doi.org/10.1016/B978-0-323-95504-1.01064-4},
 isbn = {978-0-443-15785-1},
 keyword = {Computational efficiency, Evolvability, I-language, Interfaces, Language-specific conditions, Merge, Strong minimalist thesis, Universal grammar},
 publisher = {Elsevier},
 title = {Minimalist Program},
 url = {https://www.sciencedirect.com/science/article/pii/B9780323955041010644},
 year = {2025}
}
