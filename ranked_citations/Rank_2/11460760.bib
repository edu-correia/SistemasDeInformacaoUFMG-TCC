@inproceedings{11460760,
 abstract = {CNN-based face verification techniques are quite mature, but the "black box" nature of neural networks often lacks interpretability, which is particularly concerning for high-security environments. Most existing interpretability methods provide pixel-wise explanations, but the lack of higher semantic level interpretability results in poor comprehensibility in face verification tasks. Intrinsic facial features, such as the eyes, mouth, and eyebrows, are more intuitive for humans, indicating that explanations focusing on these facial features may align better with human perception. Inspired by this, we propose the FS-PFFE interpretability framework for face verification, providing pairwise facial feature explanations with improved comprehensibility over pixel-wise methods. Additionally, we introduce the ME algorithm to offer high-fidelity and low-cost pairwise feature explanations. Experiments on the VoxCeleb1 dataset demonstrate that our proposed algorithm offers higher fidelity and lower computational cost with superior comprehensibility compared to baseline methods.},
 author = {Li, Sheng and Du, Qingfeng and Zhang, Jixian and Lv, Jiaqi},
 booktitle = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP55912.2026.11460760},
 issn = {2379-190X},
 keyword = {System-on-chip;Pixel;Location awareness;Protocols;Mobile communication;HTTP;Amplitude shift keying;Digital images;Amplitude modulation;Machine learning;neural network;face verification;interpretability;facial feature},
 month = {May},
 number = {},
 pages = {4936-4940},
 title = {Explaining Face Verification Decisions with Pairwise Facial Feature Explanation},
 volume = {},
 year = {2026}
}
