@article{ZHAO201437,
 abstract = {As a typical bottleneck connecting freeway and common road, ramp is an important traffic congestion area. Various traffic phenomena near ramps can be described by the Cell Transmission Model (CTM). However, real traffic data shows that traffic flow characteristics are far different for the ramp system with different ramp distances. We analyze traffic characteristics of ramp system with both an on-ramp and an off-ramp in Beijing 3rd ring road firstly. Then, it is found that ramp distance between the on- ramp and the off-ramp has a great impact on the capacity, due to the conflict of traffic flow between on-ramp and off-ramp. Finally the traffic conflict is considered in the merge cell and Capacity Drop CTM (CD-CTM) is proposed to embody the conflict. The simulation results suggest that CD-CTM fits the empirical data from Beijing 3rd ring road.},
 author = {Xiao-mei Zhao and Dong-fan Xie and Wei-wei Wang and Nan Geng},
 doi = {https://doi.org/10.1016/j.sbspro.2014.07.179},
 issn = {1877-0428},
 journal = {Procedia - Social and Behavioral Sciences},
 keyword = {urban traffic flow, cell transmission model, ramp system, urban expressway},
 note = {The 9th International Conference on Traffic and Transportation Studies (ICTTS 2014)},
 pages = {37-44},
 title = {Calibrating and Modeling Expressway with Different Ramp Distances on Beijing 3rd Ring Road},
 url = {https://www.sciencedirect.com/science/article/pii/S1877042814040981},
 volume = {138},
 year = {2014}
}
