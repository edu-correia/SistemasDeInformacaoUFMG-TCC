@article{LI2025125934,
 abstract = {As a density-based clustering algorithm, density peaks clustering(DPC) has significant superiority in finding density peaks, and its straightforward and efficient clustering process has also enabled it to be applied in several fields. However, uneven density and simple one-step allocation strategy tend to affect the accuracy of density peak selection and assignment of remaining points. In order to address the above limitations as well as enhance the application domain and accuracy of the DPC, we propose a density clustering algorithm based on Fermat neighbor points and partition allocation strategy(DCFP). DCFP divides the data into different parts based on the new density metric and the definition of Fermat nearest point to better identify the structure of clusters with different density. A partition allocation strategy is also developed so that points of different density are not incorrectly merged and the domino effect is reduced. Theoretical analysis and experimental data show that DCFP, compared with 7 state-of-the-art algorithms, is more feasible and efficient on 8 synthetic and 9 real datasets.},
 author = {Xiangli Li and Quan Zhuang},
 doi = {https://doi.org/10.1016/j.eswa.2024.125934},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Density peaks, Allocation strategy, Nearest neighbor, Clustering},
 pages = {125934},
 title = {A density clustering algorithm based on Fermat neighbor points and partition allocation strategy},
 url = {https://www.sciencedirect.com/science/article/pii/S095741742402801X},
 volume = {265},
 year = {2025}
}
