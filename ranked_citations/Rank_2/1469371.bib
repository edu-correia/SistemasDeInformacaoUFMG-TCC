@inproceedings{1469371,
 abstract = {This paper proposes an image-filtering processor LSI based on a hybrid approach using pulse-width modulation (PWM) and digital circuits. The LSI has been designed for implementing convolutional neural networks with a very large convolution-kernel size. The LSI designed using a 0.35 /spl mu/m CMOS performs 6-bit precision convolutions for an image of 80/spl times/80 pixels with a kernel size of up to 51/spl times/51 pixels within 8.2 ms. All operations for the fabricated LSI have been successfully verified. The power consumption estimated from SPICE simulation is 280 mW.},
 author = {Korekado, K. and Morie, T. and Nomura, O. and Nakano, T. and Matsugu, M. and Iwata, A.},
 booktitle = {Digest of Technical Papers. 2005 Symposium on VLSI Circuits, 2005.},
 doi = {10.1109/VLSIC.2005.1469371},
 issn = {2158-5636},
 keyword = {Filtering;Object recognition;Analog-digital conversion;Large scale integration;Pulse width modulation;Pixel;Pulse circuits;Space vector pulse width modulation;Digital modulation;Digital circuits},
 month = {June},
 number = {},
 pages = {220-223},
 title = {An image filtering processor for face/object recognition using merged/mixed analog-digital architecture},
 volume = {},
 year = {2005}
}
