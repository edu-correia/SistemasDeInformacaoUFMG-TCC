@inproceedings{1391454,
 abstract = {DVB-S2 is a specification for next-generation digital broadband satellite systems emerging from technical ad-hoc DVB working groups. In particular, this paper focuses on the interactive scenario (for which adaptive coding and modulation is normative) aiming at analyzing the DVB-S2 encapsulation and framing process and computing its efficiency. After describing the adaptive coding and modulation (ACM) subsystem of the DVB-S2, a layered model is presented as well as its mapping to a layered encapsulation model. The numerical results show that for the system to be efficient, the encapsulation process must multiplex users requiring the same physical layer. Moreover, the impact of additional MPEG/MPE encapsulation on the overall efficiency is analyzed.},
 author = {Castro, M.A.V. and Cardoso, A. and Rinaldo, R.},
 booktitle = {2004 IEEE 59th Vehicular Technology Conference. VTC 2004-Spring (IEEE Cat. No.04CH37514)},
 doi = {10.1109/VETECS.2004.1391454},
 issn = {1550-2252},
 keyword = {Encapsulation;Digital video broadcasting;Satellites;Physical layer;Adaptive coding;Modulation coding;Unicast;Transport protocols;Merging;Wireless communication},
 month = {May},
 number = {},
 pages = {2896-2900 Vol.5},
 title = {Encapsulation and framing efficiency of DVB-S2 satellite systems},
 volume = {5},
 year = {2004}
}
