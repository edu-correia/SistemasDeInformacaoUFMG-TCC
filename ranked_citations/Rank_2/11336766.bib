@inproceedings{11336766,
 abstract = {Transparent Object Detection (TOD) is a challenging area in computer vision. Problems arise from re- fraction, reflection, and a lack of clear textures. This work presents a hybrid PyramidalNet and Swin Transformer architecture aimed at improving segmentation accuracy for transparent objects in various lighting conditions. The model merges the hierarchical feature extraction capabilities of PyramidalNet with the global contextual understanding of Swin Transformers. The network was trained on the Trans10K dataset for 50 epochs, using a hybrid loss function that combines Dice and Cross-Entropy losses. Experimental results show significant improvements in key metrics. The model achieved an IoU of 0.207, an F1-score of 0.254, Precision of 0.257, Recall of 0.286, and Accuracy of 0.818. These results confirm that the proposed hybrid architecture provides a more reliable and understandable method for transparent object segmentation. It has potential applications in robotics, AR/VR, and autonomous systems.},
 author = {Bhure, Kalpana and Thakare, Nita},
 booktitle = {2025 International Conference on Future Technologies (ICFT)},
 doi = {10.1109/ICFT66708.2025.11336766},
 issn = {},
 keyword = {Computer vision;Accuracy;Semantic segmentation;Object detection;Computer architecture;Object segmentation;Transformers;Robustness;Real-time systems;Reflection;Transparent Object Detection (TOD);Pyramidal Network;Swin Transformer;SqueezNet;Fire attention;Split attention;Depth Estimation;Computer Vision;Semantic Segmentation;Image Processing},
 month = {Nov},
 number = {},
 pages = {1-8},
 title = {A Hybrid PyramidalNet-Swin Transformer Architecture for Transparent Object Detection},
 volume = {},
 year = {2025}
}
