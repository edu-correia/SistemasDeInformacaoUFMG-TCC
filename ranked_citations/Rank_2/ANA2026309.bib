@incollection{ANA2026309,
 abstract = {Three-dimensional (3D) printing technology has brought significant advancements to biomedical science by allowing the production of delicate, patient-centered medical devices and structures. Building on additive manufacturing principles, 3D printing enables high-precision fabrication of customized biomedical scaffolds, drug delivery vehicles, implants, prosthetics, and anatomical models, directly benefiting patient care. Its scope has expanded with 3D bioprinting, which employs bioinks to create scaffolds that biomimetically imitate tissue structures, holding promise for organ regeneration and drug testing innovations. This chapter outlines the historical development, materials, design, and methods of 3D printing, highlighting its transformative impact on personalized medicine. Moreover, artificial intelligence (AI) is driving enhanced design and individualized optimization, while challenges such as biosafety and mechanobiology emphasize the importance of appropriate material choices and regulatory standards. By merging with nanotechnology and smart materials, 3D printing is ushering in a new era of a 4D printing technology with more adaptable, biocompatible medical solutions, poised to address diverse clinical needs and advance modern healthcare.},
 author = {Ika Dewi Ana},
 booktitle = {Medical Devices in Modern Healthcare},
 doi = {https://doi.org/10.1016/B978-0-443-32828-2.00002-8},
 editor = {Sougata Jana and Sreejan Manna},
 isbn = {978-0-443-32828-2},
 keyword = {Tissue engineering, drug delivery system, bioprinting, medical devices, biomedical engineering},
 pages = {309-338},
 publisher = {Academic Press},
 title = {Chapter 8 - 3D-printed medical devices},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443328282000028},
 year = {2026}
}
