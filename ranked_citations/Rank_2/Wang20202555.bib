@conference{Wang20202555,
 abstract = {The DBSCAN method for spatial clustering has received significant attention due to its applicability in a variety of data analysis tasks. There are fast sequential algorithms for DBSCAN in Euclidean space that take O(nłog n) work for two dimensions, sub-quadratic work for three or more dimensions, and can be computed approximately in linear work for any constant number of dimensions. However, existing parallel DBSCAN algorithms require quadratic work in the worst case. This paper bridges the gap between theory and practice of parallel DBSCAN by presenting new parallel algorithms for Euclidean exact DBSCAN and approximate DBSCAN that match the work bounds of their sequential counterparts, and are highly parallel (polylogarithmic depth). We present implementations of our algorithms along with optimizations that improve their practical performance. We perform a comprehensive experimental evaluation of our algorithms on a variety of datasets and parameter settings. Our experiments on a 36-core machine with two-way hyper-threading show that our implementations outperform existing parallel implementations by up to several orders of magnitude, and achieve speedups of up to 33x over the best sequential algorithms. © 2020 Association for Computing Machinery.},
 author = {Wang, Yiqiu and Gu, Yan and Shun, Julian},
 doi = {10.1145/3318464.3380582},
 journal = {Proceedings of the ACM SIGMOD International Conference on Management of Data},
 note = {Cited by: 61; All Open Access; Gold Open Access},
 pages = {2555 - 2571},
 publication_stage = {Final},
 source = {Scopus},
 title = {Theoretically-Efficient and Practical Parallel DBSCAN},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85086260527?origin=resultslist},
 year = {2020}
}
