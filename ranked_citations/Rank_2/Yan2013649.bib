@conference{Yan2013649,
 abstract = {Traffic patterns, varying from applications, have great influence on the performance of on-chip network. We observed there exists some balanced traffic, almost distributing traffic load evenly around the whole network. Such traffic pattern makes optimization highly intractable. General optimization method, including modifying the structure of routers and topology, disappointedly, can't give satisfactory results. Moreover, other alternative methods bring good gains, but expose extraordinary high cost. To address this problem, we propose an agent-based traffic merging mechanism in this paper, which reduces the traffic pattern distinctions between applications by creating artificial hotspots at agents and setting express channels between them. With this scheme, part of the communication is shifted to express channels and accelerated to the destination. On the other hand, the pressure of basic network is alleviated to achieve low congestion rate. Furthermore, this mechanism takes fairly low cost of resources and power. Experiments are taken on real applications and a cycle accurate NoC simulator. The results show that when using 8 agents, our method can reduce 23.5% of the latency compared to original 88 mesh NoC with nearly no chip area overhead, or reduce 14.1% of the chip area and at the same time reduce 7.9% of the network latency. © 2013 IEEE.},
 author = {Yan, Mengjia and Fu, Weiwei and Wang, Chao and Chen, Tianzhou and Liu, Li},
 doi = {10.1109/IPDPSW.2013.39},
 journal = {Proceedings - IEEE 27th International Parallel and Distributed Processing Symposium Workshops and PhD Forum, IPDPSW 2013},
 note = {Cited by: 1},
 pages = {649 - 658},
 publication_stage = {Final},
 source = {Scopus},
 title = {Agent-based traffic merging in network-on-chip},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84899714008?origin=resultslist},
 year = {2013}
}
