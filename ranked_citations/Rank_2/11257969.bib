@inproceedings{11257969,
 abstract = {Complex networks consisting of communications, transportation and power grids have components that operate at different performance levels rather than being either on or off. This study uses multi-state components to achieve maximum performance while optimizing network dependability and quality of service (QoS). The main contribution is an integrated and practical structure that merges UI/CUI guided rules, with validation for optimal component allocation, in multi-state network systems. It also incorporates analysis and a replicable MATLAB execution to facilitate adoption, by practitioners. We introduce two utility metrics which assess individual component effects and their combined effects under different load or failure conditions through Utility Importance (UI) and Conditional Utility Importance (CUI). The heuristic uses UI/CUI-based criteria to perform an initial ranking of components before a comprehensive search begins. The verification of our methodology occurs through examination of a five-component “bridge” network which contains three states per element (0= failed, 0.5= degraded, and 1= functioning). A MATLAB script performs the following steps: 1) it counts all $5!=120$ component-to-label permutations; 2) it calculates joint state probabilities for all $3^{\wedge} 5$ combinations; 3) it assesses system performance using maximum flow across four parallel paths; and 4) it determines the best / worst assignments and an expected performance metric. The exhaustive search produces 0.78855 which represents a 7.7% improvement over random selection and a 3.8% increase above the UI/CUI heuristic while the UI/CUI heuristic results in a 3.7% improvement from 0.73220 (random baseline) to 0.75950. The article also discusses scalability to larger networks using symmetrical exploitation and importance-based pruning to control combinatorial expansion and provides visual analytics tools for evaluating assignments. We end with recommendations for integrating multi-state component allocation into reliabilitycentered maintenance, cost-benefit analysis, and future research on dynamic reconfiguration under time-varying loads.},
 author = {Mangara, Bernard Tonderayi},
 booktitle = {2025 International Conference on Electrical, Communication and Computer Engineering (ICECCE)},
 doi = {10.1109/ICECCE67514.2025.11257969},
 issn = {},
 keyword = {Bridges;Computer network reliability;Visual analytics;Scalability;Metaheuristics;Quality of service;Reliability engineering;Resource management;MATLAB;Network systems;multi-state systems;Component utility importance (UI);Conditional utility importance (CUI);Heuristic swapping algorithm;Exhaustive enumeration;Bridge network topology;Reliability optimization;Visual analytics},
 month = {Aug},
 number = {},
 pages = {1-5},
 title = {Optimal Assignment of Interchangeable Components in Multi-State Network Systems for Enhanced Reliability and QoS},
