@article{Che20249547,
 abstract = {In this paper, we present the design and implementation of ZBTree, a hotness-aware B+<sup>+</sup>-Tree for persistent memory (PMem). ZBTree leverages the PMem+DRAM architecture, which is featured with a volatile operation layer to accelerate data access and an order-preserving persistent layer to achieve fast recovery and low-overhead consistency and persistence guarantees. The operation layer contains inner nodes for indexing and compacted leaf nodes (DLeaves) that hold metadata. Based on leaf node compaction, we present a data lodging method, which supports to load hot data into fast DRAM dynamically, avoiding PMem accesses for subsequent reads of hot data and achieving improved read performance without incurring extra DRAM usage. In addition, we present a lightweight node splitting mechanism with constant persistence overhead that does not vary with node size. Our extensive evaluations show that ZBTree achieves higher throughput by a factor of 1.4x-6.3x compared to state-of-the-art tree indexes under a wide range of workloads. Meanwhile, ZBTree achieves comparable or faster recovery speed compared to existing designs. © 1989-2012 IEEE.},
 author = {Che, Wenkui and Chen, Zhiwen and Hu, Daokun and Sun, Jianhua and Chen, Hao},
 doi = {10.1109/TKDE.2024.3421232},
 journal = {IEEE Transactions on Knowledge and Data Engineering},
 note = {Cited by: 3},
 number = {12},
 pages = {9547 - 9563},
 publication_stage = {Final},
 source = {Scopus},
 title = {ZBTree: A Fast and Scalable B+-Tree for Persistent Memory},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85201448936?origin=resultslist},
 volume = {36},
 year = {2024}
}
