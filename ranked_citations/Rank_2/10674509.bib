@inproceedings{10674509,
 abstract = {Aquarium keeping has evolved significantly with the integration of technology and our enduring fascination for aquatic life. This study explores the development, features, and applications of Smart Aquatics, a smart aquarium system designed specifically for Discus enthusiasts. Tailored to meet the specific needs of Discus Fish, the system incorporates $\mathbf{IoT}$ technology, providing aquarists with unprecedented control over key parameters, real-time monitoring, and anomaly detection using machine learning algorithms like the Isolation Forest. A thorough user evaluation using the PSSUQ confirms the high acceptability, usability, and positive user experience of Smart Aquatics. These findings highlight the system's effectiveness in meeting aquarists' needs and advancing intelligent aquarium management. Smart Aquatics represents a shift in how technology and aquatic care intersect, enriching ornamental fishkeeping and paving the way for innovation in understanding and caring for diverse aquatic ecosystems.},
 author = {Rey, William P. and Rey, Kieth Wilhelm Jan D. and Labayan, Althea Jodie B.},
 booktitle = {2024 6th International Conference on Computer Communication and the Internet (ICCCI)},
 doi = {10.1109/ICCCI62159.2024.10674509},
 issn = {2833-2350},
 keyword = {Technological innovation;Machine learning algorithms;Navigation;Merging;Fish;User experience;Real-time systems;Smart Aquatics;Discus;IOT;sensors;mobile app},
 month = {June},
 number = {},
 pages = {30-36},
 title = {Smart Aquatics: Navigating Discus Fish Keeping with Mobile App and Automation},
 volume = {},
 year = {2024}
}
