@article{LIU2026118984,
 abstract = {Printed fabric defect detection faces significant challenges due to defects being obscured by complex patterns and colors, exhibiting extremely low contrast with backgrounds. Subtle defects within intricate designs often evade detection, as most existing methods struggle to deliver reliable results under these conditions. In this paper, we propose a powerful DT-UNet for printed fabric defect segmentation. A D-Bottleneck module was designed that effectively merges the Dynamic Snake Convolution (DSConv) operator with ResNet-50′s bottleneck for encoding feature representations. Transformer layers are introduced to overcome the locality of convolutions while limiting their number to preserve spatial details and reduce the model's computational and parametric complexity. Experimental results demonstrate that the method proposed in this paper is significantly outperforms the baseline model TransUNet, achieving improvements of 47.35 % in mean pixel accuracy (mPA) and 41.73 % in mean intersection-over-union (mIoU) on the Printed Fabric Defects Dataset (PFDD). Furthermore, on the Tile Surface Defect Dataset (TSDD), the DT-UNet model proposed in this paper shows superior performance compared to other semantic segmentation methods, reaching state-of-the-art scores of 99.45 % in pixel accuracy (PA), 95.41 % in mPA, and 88.77 % in mIoU. Additionally, DT-UNet has demonstrated outstanding segmentation performance on various representative industrial defect datasets compared with other advanced segmentation models.},
 author = {Mingyang Liu and Huanhuan Zhang and Junfeng Jing and Hongwei Zhang and Xuejuan Kang},
 doi = {https://doi.org/10.1016/j.measurement.2025.118984},
 issn = {0263-2241},
 journal = {Measurement},
 keyword = {Fabric printing defect segmentation, Dynamic snake convolution, Transformer, D-Bottleneck},
 pages = {118984},
 title = {DT-UNet:UNet empowered by dynamic snake convolution and transformer for printed fabrics defect segmentation},
 url = {https://www.sciencedirect.com/science/article/pii/S0263224125023437},
 volume = {257},
 year = {2026}
}
