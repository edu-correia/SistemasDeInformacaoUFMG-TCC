@inproceedings{11463126,
 abstract = {Individuals with hearing impairments face significant communication barriers when exposed to code-mixed Indian-English speech (e.g., Hinglish), a common yet underexplored challenge in multilingual societies. Existing speech-to-sign systems often assume monolingual input and rely on stitched multi-signer videos, resulting in identity switches and temporal discontinuities. Unlike prior methods that require full motion sequences or multiple video samples of the target signer, we introduce EOSIGN 1, a one-shot Indian Sign Language (ISL) synthesis framework that generates photorealistic signing videos of unseen signers from only a single reference image and code-mixed speech. The approach combines three key innovations: (i) confidence-aware speech transcription and grammar transformation for ISL compatibility, (ii) training-free 3D proportional motion retargeting with tempo-preserving stabilization to smoothly merge heterogeneous motion segments and (iii) lightweight FiLM-based identity modulation, combined with knowledge distillation and INT8 quantization for real-time edge deployment. Our method achieves state-of-the-art results on PHOENIX14T (SSIM 0.91, FID 10.3, Face-Cos 0.85) and supports 30 FPS signer-consistent generation on mobile devices across PHOENIX14T and a newly curated 10K Code-Mixed ISL dataset. These results demonstrate EOSIGN as a practical and scalable step towards edge-ready sign language translation in multilingual environments.},
 author = {Saini, Neelam},
 booktitle = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP55912.2026.11463126},
 issn = {2379-190X},
 keyword = {Motion pictures;Broadcasting;Filtering;Filters;Videos;Modulation;Graphical user interfaces;Protocols;Video equipment;Communications technology;Code-mixed speech processing;sign language production;speech-to-sign translation;edge deployment},
 month = {May},
 number = {},
 pages = {19917-19921},
 title = {Eosign: Edge-Efficient One-Shot ISL Video Synthesis from Code-Mixed Speech with Signer Consistency and Temporal Stability},
 volume = {},
 year = {2026}
}
