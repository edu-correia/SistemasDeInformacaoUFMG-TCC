@conference{Chaudhuri20065,
 abstract = {Data cleaning based on similarities involves identification of "close" tuples, where closeness is evaluated using a variety of similarity functions chosen to suit the domain and application. Current approaches for efficiently implementing such similarity joins are tightly tied to the chosen similarity function. In this paper, we propose a new primitive operator which can be used as a foundation to implement similarity joins according to a variety of popular string similarity functions, and notions of similarity which go beyond textual similarity. We then propose efficient implementations for this operator. In an experimental evaluation using real datasets, we show that the implementation of similarity joins using our operator is comparable to, and often substantially better than, previous customized implementations for particular similarity functions. © 2006 IEEE.},
 author = {Chaudhuri, Surajit and Ganti, Venkatesh and Kaushik, Raghav},
 doi = {10.1109/ICDE.2006.9},
 journal = {Proceedings - International Conference on Data Engineering},
 note = {Cited by: 506},
 pages = {5},
 publication_stage = {Final},
 source = {Scopus},
 title = {A primitive operator for similarity joins in data cleaning},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33749597967?origin=resultslist},
 volume = {2006},
 year = {2006}
}
