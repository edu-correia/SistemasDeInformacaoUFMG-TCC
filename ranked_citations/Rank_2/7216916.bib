@inproceedings{7216916,
 abstract = {The latest high efficiency video coding (HEVC) has increasing requirement to be implemented in a heterogeneous platforms or a GPU accelerators. However, due to the data dependency between neighboring blocks merge candidate lists of neighboring blocks cannot be generated in parallel and induce a bottleneck for parallel encoder designs. In this paper, a parallel merge mode prediction algorithm is presented, which removes the dependency of PUs within the merge estimation region and make the PU possible to do merge estimation in parallel. The obtained experimental results demonstrated that this implementation is with only 0.10% BD-rate loss, compared with the original reference software HM12.0.},
 author = {Jiang, Xiantao and Song, Tian and Shi, Wen and Wang, Lisheng and Shimamoto, Takashi},
 booktitle = {2015 IEEE International Conference on Consumer Electronics - Taiwan},
 doi = {10.1109/ICCE-TW.2015.7216916},
 issn = {},
 keyword = {Estimation;Encoding;Merging;Prediction algorithms;Video coding;Software;Software algorithms},
 month = {June},
 number = {},
 pages = {310-311},
 title = {Merge prediction algorithm for adaptive parallel improvement of high efficiency video coding},
 volume = {},
 year = {2015}
}
