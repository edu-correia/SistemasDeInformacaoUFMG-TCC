@article{WANG2026104011,
 abstract = {Surface defect detection (SDD) is a pivotal component of quality control in manufacturing processes. Despite the widespread adoption of deep learning, intelligent quality detection models face significant challenges in practical industrial scenarios. This challenge is particularly acute in multi-variety, small-batch production environments, where the high cost and long cycle times associated with acquiring high-quality labeled data severely limit model training and performance. To address this issue, this paper proposes an uncertainty-guided dual-stage conditional diffusion model (UGDS-CDM) integrated with a vision mamba Kolmogorov-Arnold Networks (VM-KAN) detection model that incorporates expert knowledge for surface defect detection under small sample conditions. Firstly, this study introduces a novel method that leverages a pre-trained U-Net classifier to provide guidance and uncertainty estimation during the diffusion process. By leveraging expert knowledge, a conditional diffusion model with a dual-stage “generation-interference” mechanism is constructed. This architecture is specifically designed to generate industrial images that exhibit both high fidelity and significant diversity. Secondly, to enhance robustness against the dynamic and noisy conditions of the manufacturing environment, we developed the VM-KAN model. This model is constructed from four key components: a patch embedding layer to tokenize the input image, a series of stacked selective scanning convolution state space model modules for hierarchical feature extraction, patch merging layers for progressive downsampling, and a KAN-based classification head. To enhance the model’s interpretability and aid the decision-making of quality engineers, an interpretability analysis module is developed. This module integrates Grad-CAM for visual localization of salient features with Shapley additive explanations for a quantitative analysis of feature contributions. Additionally, a surface defect detection system is developed based on the Streamlit framework. Extensive experiments on the automotive paint defect dataset demonstrate the robust performance of our proposed method. Even under data-scarce conditions, the system achieves a remarkable 96.95% F1 score, validating its practical applicability and effectiveness. Furthermore, the exceptional generalization capability of our method was validated on a range of challenging benchmarks. These include the Northeastern University (NEU) surface defect database, which tests performance under limited defect diversity, and the Magnetic Tile Defect (MTD) dataset, which is known for its significant visual complexity and noise. This study offers an effective solution for industrial intelligent detection, particularly in environments constrained by small samples and dynamic interference. The results underscore the method’s substantial potential for real-world engineering applications and its capacity to enhance manufacturing quality control. All data and code are available at https://github.com/xluckywang/UGDS-CDM.},
 author = {Xiaoqiao Wang and Kui Luo and Mingzhou Liu and Rui Zheng and Yan Li},
 doi = {https://doi.org/10.1016/j.aei.2025.104011},
 issn = {1474-0346},
 journal = {Advanced Engineering Informatics},
 keyword = {Surface defect detection, Conditional diffusion model, Uncertainty guidance, Vision mamba-KAN},
 pages = {104011},
 title = {UGDS-CDM: A novel uncertainty-guided dual-stage conditional diffusion model and vision mamba-KAN integrating expert knowledge for surface defect detection under small samples},
 url = {https://www.sciencedirect.com/science/article/pii/S1474034625009048},
 volume = {69},
 year = {2026}
}
