 publication_stage = {Final},
 source = {Scopus},
 title = {YOLOv8-CGRNet: A Lightweight Object Detection Network Leveraging Context Guidance and Deep Residual Learning},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85181890397?origin=resultslist},
