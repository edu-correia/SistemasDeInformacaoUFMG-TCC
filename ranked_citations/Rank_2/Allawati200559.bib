@conference{Allawati200559,
 abstract = {In this paper, the problem of quickly matching records (i.e., record linkage problem) from two autonomous sources without revealing privacy to the other parties is considered. In particular, our focus is to devise secure blocking scheme to improve the performance of record linkage significantly while being secure. Although there have been works on private record linkage, none has considered adopting the blocking framework. Therefore, our proposed blocking-Aware private record linkage can perform large-scale record linkage without revealing privacy. Preliminary experimental results showing the potential of the proposal are reported. © 2005 ACM.},
 author = {Allawati, Ali and Lee, Dongwon and McDaniel, Patrick},
 doi = {10.1145/1077501.1077513},
 journal = {Proceedings of the 2nd International Workshop on Information Quality in Information Systems, IQIS 2005},
 note = {Cited by: 70},
 pages = {59 - 68},
 publication_stage = {Final},
 source = {Scopus},
 title = {Blocking-Aware private record linkage},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77952259855?origin=resultslist},
 year = {2005}
}
