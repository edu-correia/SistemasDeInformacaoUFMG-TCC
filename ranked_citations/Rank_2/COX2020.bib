 issn = {2291-9694},
 journal = {JMIR Medical Informatics},
 keyword = {knowledge graphs, clinical data, biomedical data, federation, ontologies, semantic harmonization, visualization, application programming interface, translational science, clinical practice},
 number = {11},
 title = {Visualization Environment for Federated Knowledge Graphs: Development of an Interactive Biomedical Query Language and Web Application Interface},
 url = {https://www.sciencedirect.com/science/article/pii/S2291969420000800},
 volume = {8},
