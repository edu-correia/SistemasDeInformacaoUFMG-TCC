@inproceedings{8682701,
 abstract = {Color and depth information provided simultaneously in RGB-D images can be used to segment scenes into disjoint regions. In this paper, a graph-based segmentation method for RGB-D image is proposed, in which an adaptive data-driven combination of color- and normal-variation is presented to construct dissimilarity between two adjacent pixels and a novel region merging threshold exploiting normal information in adjacent regions is proposed to control the proceeding of the region merging. We evaluate our method on the NYU-v2 depth database and compare it with several published RGB-D partition methods. The experimental results show that our method is comparable with the state-of-the-art methods and provides more details of structures in the scene.},
 author = {Pan, Xiong and Zhang, Zejun and Liu, Yizhang and Yang, Changcai and Chen, Qiufeng and Cheng, Li and Lin, Jiaxiang and Chen, Riqing},
 booktitle = {ICASSP 2019 - 2019 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP.2019.8682701},
 issn = {2379-190X},
 keyword = {Merging;Image segmentation;Image color analysis;Forestry;Agriculture;Three-dimensional displays;Big Data;RGB-D image segmentation;graph-based segmentation;data-driven weight;color-normal-region merging},
 month = {May},
 number = {},
 pages = {2417-2421},
 title = {Graph-based RGB-D Image Segmentation Using Color-directional-region Merging},
 volume = {},
 year = {2019}
}
