@inproceedings{10353258,
 abstract = {As mobile devices become more prevalent, there’s a rising demand for consistent and eco-friendly ways to charge them. Traditional plug-in methods don’t always cut it, especially in areas without easy access to power. This study introduces an innovative charging method that taps into the energy from human movements. By merging AI with kinetic energy, we’ve used both piezoelectric and electromagnetic tools fitted in wearables to transform body movements into electric power. This energy is stored in a battery for later use in charging devices. We built and tested a prototype to assess its efficiency. Our findings revealed that the system could charge with about 95.57% precision, and there’s a strong link (r=0.92) between the energy produced and the extent of body movement.},
 author = {Mohamed, Nachaat and Oubelaid, Adel and Bajaj, Mohit and Kandpal, Meenakshi and Mahmoud, Mohamed Metwally},
 booktitle = {2023 4th IEEE Global Conference for Advancement in Technology (GCAT)},
 doi = {10.1109/GCAT59970.2023.10353258},
 issn = {},
 keyword = {Wearable computers;Merging;Prototypes;Transforms;Mobile handsets;Power systems;Kinetic energy;Cybersecurity. energy;Kinetic energy Harvesting Method},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Using AI and Kinetic Energy to Charge Mobile Devices with Human Movement},
 volume = {},
 year = {2023}
}
