@conference{Yuan2015825,
 abstract = {A text clustering algorithm is proposed to overcome the drawback of division based clustering method on sensitivity of estimated class number. Complex features including synonym and co-occurring words are extracted to make a feature space containing more semantic information. Then the divide and merge strategy helps the iteration converge to a reasonable cluster number. Experimental results showed that the dynamically updated center number prevent the deterioration of clustering result when k deviates from the real class numbers. When k is too small or large, the difference of clustering results between FC-DM and k-means is more obvious and FC-DM also outperformed other benchmark algorithms. ©2015 Published by Elsevier B.V.},
 author = {Yuan, Man and Shi, Yong},
 doi = {10.1016/j.procs.2015.07.153},
 journal = {Procedia Computer Science},
 note = {Cited by: 6; All Open Access; Gold Open Access},
 pages = {825 - 832},
 publication_stage = {Final},
 source = {Scopus},
 title = {Text clustering based on a divide and merge strategy},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84960873328?origin=resultslist},
 volume = {55},
 year = {2015}
}
