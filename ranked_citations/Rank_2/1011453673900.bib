@article{10.1145/3673900,
 abstract = {In the balanced allocations framework, there are  (m)  jobs (balls) to be allocated to  (n)  servers (bins). The goal is to minimize the gap, the difference between the maximum and the average load.In 2015, Peres, Talwar and Wieder used the hyperbolic cosine potential function to analyze the challenging case where  (mgg n) , for a large family of processes, including the  ((1+beta)) -process and graphical balanced allocations. The key ingredient was to prove that the potential drops in every step, i.e., a drift inequality.In this work, we improve the drift inequality so that (i) it is asymptotically tight (leading to tighter gap bounds), (ii) it assumes weaker preconditions (thereby resolving an open problem regarding weighted graphical allocations), (iii) it applies not only to processes allocating to more than one bin in a single step but also (iv) to processes allocating a varying number of balls depending on the sampled bin. Our applications include the aforementioned large family of processes, and also several new processes and settings, including outdated information and memory. We hope that our techniques can be used to analyze further interesting settings and processes.},
 address = {New York, NY, USA},
 articleno = {35},
 author = {Los, Dimitrios and Sauerwald, Thomas},
 doi = {10.1145/3673900},
 issn = {1549-6325},
 issue_date = {October 2024},
 journal = {ACM Trans. Algorithms},
 keyword = {Balls-into-bins, balanced allocations, potential functions, drift theorem, heavily loaded, gap bounds, maximum load, memory, two-choices, weighted balls},
 month = {October},
 number = {4},
 numpages = {39},
 publisher = {Association for Computing Machinery},
 title = {An Improved Drift Theorem for Balanced Allocations},
 url = {https://doi.org/10.1145/3673900},
 volume = {20},
