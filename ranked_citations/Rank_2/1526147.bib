@inproceedings{1526147,
 abstract = {We propose an approach to use aerial images to localize the global positions of laser scans. We first segment laser scans to remove invalid data such as cars, three, foot passengers and so on and keep the main structure data. And then we give an algorithm for creating an edge map from laser scans instead of the ordinary edge detectors. Last, we register the edge map with aerial images using ICP algorithm from coarse to fine. We perform our method in practice that takes advantage of GPS sensor in urban environment.},
 author = {Aiwu Zhang and Shaoxing Hu and Xin Jin and Weidong Sun},
 booktitle = {Proceedings. 2005 IEEE International Geoscience and Remote Sensing Symposium, 2005. IGARSS '05.},
 doi = {10.1109/IGARSS.2005.1526147},
 issn = {2153-7003},
 keyword = {Merging;Image edge detection;Laser modes;Image segmentation;Satellites;Foot;Layout;Feature extraction;Data mining;Frequency},
 month = {July},
 number = {},
 pages = {4 pp.-},
 title = {A method of merging aerial images and ground laser scans},
 volume = {1},
 year = {2005}
}
