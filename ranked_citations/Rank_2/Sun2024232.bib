@conference{Sun2024232,
 abstract = {ZNS SSD (Zoned Namespace SSD) is a new SSD storage device that was proposed recently and has attracted extensive attention from academia and industry. ZNS SSDs divide the internal storage space into many zones. Each zone can be read randomly but can only be written sequentially. In addition, the host needs to control some ZNS SSD operations, such as garbage collection. However, what is the performance of ZNS SSD on real database systems? This question remains unanswered. To answer this question, this paper chooses the popular key-value store, RocksDB, as the targeted system and tests the performance of ZNS SSD on RocksDB experimentally to provide a reference for the rational use of ZNS SSD in database systems in the future. A comprehensive evaluation shows that ZNS SSDs perform better when many compaction operations are involved. Moreover, ZNS SSDs do not show the same performance degradation as traditional SSDs under high workloads. Therefore, ZNS SSDs are more suitable for application scenarios that involve frequent data updates. © 2024 Knowledge Systems Institute Graduate School. All rights reserved.},
 author = {Sun, Yuanlin and Jin, Peiquan},
 doi = {10.18293/SEKE2024-106},
 journal = {Proceedings of the International Conference on Software Engineering and Knowledge Engineering, SEKE},
 note = {Cited by: 0; All Open Access; Bronze Open Access},
 pages = {232 - 237},
 publication_stage = {Final},
 source = {Scopus},
 title = {How Will ZNS SSDs Perform on Real Key-Value Stores? An Experimental Test of RocksDB},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85218626300?origin=resultslist},
 year = {2024}
