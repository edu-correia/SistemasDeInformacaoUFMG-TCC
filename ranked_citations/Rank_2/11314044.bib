@inproceedings{11314044,
 abstract = {The proliferation of wide bandwidth Synthetic Aperture Radar (SAR) satellites, particularly from commercial small-satellite operators, has made Very High-Resolution (VHR) SAR data (sub-meter resolution) increasingly accessible. This surge in data availability has unlocked new opportunities in Earth observation, including precision agriculture applications like automated field boundary detection. Accurate delineation of agricultural field boundaries is critical for field management, crop monitoring, and the operation of autonomous farm machinery. Simultaneously, advancements in semantic segmentation techniques, driven by deep learning and large-scale annotated datasets, have revolutionized image analysis across domains. This study leverages cutting-edge semantic segmentation models to achieve automated and reliable field boundary detection using VHR X-band SAR data acquired in Spotlight mode by the Capella sensor. The proposed approach integrates modern deep learning frameworks with classical iterative region merging techniques to enhance segmentation robustness and precision.},
 author = {De, Shaunak and Cazcarra-Bes, Victor and Goncharenko, Yuriy and McDaniel, Jay and Stringham, Craig},
 booktitle = {IGARSS 2025 - 2025 IEEE International Geoscience and Remote Sensing Symposium},
 doi = {10.1109/IGARSS55030.2025.11314044},
 issn = {2153-7003},
 keyword = {Deep learning;Satellites;Shape;Semantic segmentation;Scalability;Robustness;Data models;Surges;Synthetic aperture radar;Testing;Deep Learning;Segmentation;Synthetic Aperture Radar},
 month = {Aug},
 number = {},
 pages = {8037-8041},
 title = {A Deep Learning Approach to Field Boundary Segmentation Using Very High-Resolution X-Band SAR Data},
 volume = {},
 year = {2025}
}
