@inproceedings{7178111,
 abstract = {This paper presents a novel image classification method based on integration of EEG and visual features. In the proposed method, we obtain classification results by separately using EEG and visual features. Furthermore, we merge the above classification results based on a kernelized version of Supervised learning from multiple experts and obtain the final classification result. In order to generate feature vectors used for the final image classification, we apply Multiset supervised locality preserving canonical correlation analysis (MSLPCCA), which is newly derived in the proposed method, to EEG and visual features. Our method realizes successful multimodal classification of images by the object categories that they contain based on MSLPCCA-based feature integration.},
 author = {Kawakami, Takuya and Ogawa, Takahiro and Haseyama, Miki},
 booktitle = {2015 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP.2015.7178111},
 issn = {2379-190X},
 keyword = {Electroencephalography;Visualization;Feature extraction;Accuracy;Training data;Image segmentation;Support vector machines;electroencephalogram (EEG);image classification;multimodal scheme;decision-level fusion;canonical correlation analysis},
 month = {April},
 number = {},
 pages = {957-961},
 title = {Novel image classification based on integration of EEG and visual features via MSLPCCA},
 volume = {},
 year = {2015}
}
