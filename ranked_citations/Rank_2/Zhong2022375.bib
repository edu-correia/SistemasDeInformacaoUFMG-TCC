@conference{Zhong2022375,
 abstract = {With the emergence of microsecond-scale NVMe storage devices, the Linux kernel storage stack overhead has become significant, almost doubling access times. We present XRP, a framework that allows applications to execute user-defined storage functions, such as index lookups or aggregations, from an eBPF hook in the NVMe driver, safely bypassing most of the kernel's storage stack. To preserve file system semantics, XRP propagates a small amount of kernel state to its NVMe driver hook where the user-registered eBPF functions are called. We show how two key-value stores, BPF-KV, a simple B<sup>+</sup>-tree key-value store, and WiredTiger, a popular log-structured merge tree storage engine, can leverage XRP to significantly improve throughput and latency. © 2022 by The USENIX Association. All rights reserved.},
 author = {Zhong, Yuhong and Li, Haoyu and Wu, Yu Jian and Zarkadas, Ioannis and Tao, Jeffrey and Mesterhazy, Evan and Makris, Michael and Yang, Junfeng and Tai, Amy and Stutsman, Ryan and Cidon, Asaf},
 journal = {Proceedings of the 16th USENIX Symposium on Operating Systems Design and Implementation, OSDI 2022},
 note = {Cited by: 108},
 pages = {375 - 393},
 publication_stage = {Final},
 source = {Scopus},
 title = {XRP: In-Kernel Storage Functions with eBPF},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85141039795?origin=resultslist},
 year = {2022}
}
