@inproceedings{11365366,
 abstract = {Wearable medical sensors with integrated alarm functions are crucial for real-time health monitoring, yet most existing devices require external components for alerting, increasing system complexity, and limiting flexibility. In this study, we develop a laser-induced graphene (LIG) structure that merges high-sensitivity strain sensing and Joule heating-based warning into a single platform. The patterned LIG medical sensor exhibits a gauge factor as high as 101, significantly outperforming its non-patterned counterpart, showing superior heating efficiency. We achieve simultaneous physiological signal detection and thermal alarm activation without external components. The sensors provide a promising solution for wearable health monitoring that offers both sensing and intuitive feedback, indicating broad potential in personal healthcare applications.},
 author = {Ji, Yaqiang and Yu, Shen and Liang, Ruiji and Long, Jianyu and Li, Chuan},
 booktitle = {2025 International Conference on Sensing, Measurement & Data Analytics in the era of Artificial Intelligence (ICSMD)},
 doi = {10.1109/ICSMD67131.2025.11365366},
 issn = {},
 keyword = {Heating systems;Graphene;Medical services;Thermal sensors;Real-time systems;Biomedical monitoring;Wearable devices;Wearable sensors;Monitoring;Strain;Laser-induced graphene;Wearable sensors;Health monitoring;Integrated systems},
 month = {Nov},
 number = {},
 pages = {1-4},
 title = {Laser-Induced Graphene-Driven Wearable Medical Sensors for Human Health Monitoring},
 volume = {},
 year = {2025}
}
