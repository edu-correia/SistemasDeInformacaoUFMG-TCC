@article{LEI2025131733,
 abstract = {Multimodal sentiment analysis is a challenging task that aims to analyze the sentiment information of speaker performance from multimodal data such as language, vision, and acoustics. To achieve this task, some existing methods aggregate and fuse sentiment information from multimodal features based on attention mechanisms. However, the heterogeneity of multimodal data leads to modal differences and different distributions, which affect the ability of the model to integrate the consistency and heterogeneity between modalities effectively. Furthermore, existing methods typically merge multimodal representations for sentiment analysis directly after feature extraction, neglecting the comprehensive learning of features and the interaction between modalities. To this end, this paper proposes a new multimodal sentiment analysis method based on modal collaboration and disentangled representation, named a hybrid fusion network leveraging disentangled representation learning and cross-modal collaborative interaction (DRLCCI). Firstly, we propose the novel collaborative-feature guided multimodal fusion (CGMF) module based on the attention mechanism to promote collaboration and explore interactive relationships. Acoustic-visual information is used to guide verbal language in learning emotional context and exploring the collaborative relationship between nonverbal modalities and verbal modality in context. Secondly, the collaborative generation features guide the bidirectional interaction of the three modalities to mine the potential sentiment correlation feature. At the same time, we also use spatial representation disentangling and similarity constraints to preserve modal specificity and sentiment consistency to realize comprehensive learning of effective sentiment information aggregation and improve the effect of multimodal sentiment analysis. Experimental results on CMU-MOSI and CMU-MOSEI datasets show the effectiveness of DRLCCI.},
 author = {Xue Lei and Miao Ma and Yutong Li},
 doi = {https://doi.org/10.1016/j.neucom.2025.131733},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {Multimodal sentiment analysis, Multimodal fusion, Collaborative interaction, Representation learning},
 pages = {131733},
 title = {DRLCCI: A hybrid fusion network leveraging disentangled representation learning and cross-modal collaborative interaction for multi-modal sentiment analysis},
 url = {https://www.sciencedirect.com/science/article/pii/S0925231225024051},
 volume = {658},
 year = {2025}
}
