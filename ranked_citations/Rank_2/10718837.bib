@inproceedings{10718837,
 abstract = {This paper presents an effective online process fault diagnosis method by integrating recurrence plots (RP) with convolutional neural networks (CNN). To cope with the high dimension of process data, principal component analysis (PCA) is applied to the original process data. RPs are then produced using the major principal components (PCs). As RPs are symmetric, this paper proposes to merge the two RPs for the first and second PCs into one to represent more information. The merged RPs serve as the inputs to a CNN, which is trained for fault diagnosis. The proposed fault diagnosis method is demonstrated on a simulated continuous stirred tank reactor (CSTR) system. It is shown that the proposed fault diagnosis system gives enhanced diagnosis performance.},
 author = {Dong, Yiran and Zhang, Jie and O’Malley, Chris},
 booktitle = {2024 29th International Conference on Automation and Computing (ICAC)},
 doi = {10.1109/ICAC61394.2024.10718837},
 issn = {},
 keyword = {Fault diagnosis;Automation;Accuracy;Computational modeling;Neural networks;Benchmark testing;Convolutional neural networks;Continuous-stirred tank reactor;Monitoring;Principal component analysis;process monitoring;fault diagnosis;principal component analysis;recurrence plot;convolutional neural network},
 month = {Aug},
 number = {},
 pages = {1-6},
 title = {Online Process Fault Diagnosis through Integration of Principal Component Analysis, Modified Recurrence Plot, and Convolutional Neural Networks},
 volume = {},
 year = {2024}
}
