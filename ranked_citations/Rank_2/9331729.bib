@inproceedings{9331729,
 abstract = {Antenna arrays based on aperiodic tilings have been shown to exhibit low side lobe levels and modest bandwidths over which grating lobes are suppressed. In order to achieve a broadband low side lobe aperiodic array with minimum spacing constraints, this paper proposes a perturbation technique based on Schlottmann tilings, which combines global optimization algorithms such as PSO, GA, and the method of merging elements to control the minimum element spacing to achieve a realizable design. A example will be presented for an aperiodic array design of Schlottmann tilings that can generate arrays that possess no grating lobes and low side lobe levels over wide bandwidths.},
 author = {Jian, Lirong and Yang, Peng},
 booktitle = {2020 IEEE Asia-Pacific Microwave Conference (APMC)},
 doi = {10.1109/APMC47863.2020.9331729},
 issn = {},
 keyword = {Layout;Process control;Bandwidth;Broadband communication;Gratings;Broadband antennas;Antenna arrays;Aperiodic arrays;Schlottmann tilings;Genetic Algorithms (GA);Particle Swarm optimization(PSO);element merging;wideband arrays},
 month = {Dec},
 number = {},
 pages = {339-341},
 title = {Antenna optimized array based on Schlottmann aperiodic tiling},
 volume = {},
 year = {2020}
}
