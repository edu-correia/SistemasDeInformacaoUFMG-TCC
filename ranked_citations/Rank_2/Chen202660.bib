@article{Chen202660,
 abstract = {The Internet of Things (IoT) is revolutionizing industries by generating an unprecedented volume of time series data, making robust and high-performance time series databases crucial for effective data management and analysis. Time series data is pivotal in sectors such as energy, finance, and manufacturing, each with unique challenges and requirements, which complicates the use of a universal benchmark for evaluating databases in different domain applications. This paper discusses benchmarking methodologies in evaluating time series databases, with a focus on IoT environments. Key characteristics like high cardinality for handling IoT data are highlighted, along with the integration of Artificial Intelligence (AI) technologies for analytics and the applicability of the TPCx-IoT benchmark. Future improvements to benchmarks are also considered to address the evolving demands of IoT applications. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
 author = {Chen, Lei and Li, Qiang and Long, Mingsheng and Nambiar, Raghu and Wang, Hongzhi and Wang, Jianmin and Zheng, Pengcheng},
 doi = {10.1007/978-3-031-93858-0_4},
 journal = {Lecture Notes in Computer Science},
 note = {Cited by: 0},
 pages = {60 - 72},
 publication_stage = {Final},
 source = {Scopus},
 title = {Benchmarking Time Series Databases: Current State and Future Perspectives (Panel)},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105012922993?origin=resultslist},
 volume = {15337 LNCS},
