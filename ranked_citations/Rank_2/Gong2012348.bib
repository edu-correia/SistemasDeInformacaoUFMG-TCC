@conference{Gong2012348,
 abstract = {Based on extension theory, this paper established a matter-element model describing the process of logistics resource infrastructure as extension conversion, which transformed some under-efficient resource into efficient ones in resource universe. There are five basis extension conversions in the model, including replacement, increase or decrease, enlargement or reductioned, decomposition decomposed and copy. By conversing the element in resource universe, relation maxim and universe quantitatively, the countermeasure of logistics infrastructure resources integration was put forward, such as function orientation, rectification, merge, cooperation and so on. Finally, the result of integration was evaluated by the correlation function. It proved that the matter-element model could provide decision basis quantitatively for logistics infrastructure resources integration. © 2012 IEEE.},
 author = {Gong, Jianguo and Guo, Xiucheng and Guo, Lichao and Yang, Jie},
 doi = {10.1109/ICICTA.2012.93},
 journal = {Proceedings - 2012 5th International Conference on Intelligent Computation Technology and Automation, ICICTA 2012},
 note = {Cited by: 0},
 pages = {348 - 351},
 publication_stage = {Final},
 source = {Scopus},
 title = {The method of regional logistics infrastructure resources integration based on extension theory},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84863262137?origin=resultslist},
 year = {2012}
}
