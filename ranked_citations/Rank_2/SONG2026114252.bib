@article{SONG2026114252,
 abstract = {Multimodal three-dimensional object detection plays a crucial role in autonomous driving by integrating data from multiple sensors to improve detection accuracy. However, when fusing data from different sources, challenges such as image noise and information loss often arise, leading to an inability to fully exploit the correlation between multimodal data, thereby affecting the optimization of detection performance. To address such issues, this paper proposes a multimodal three-dimensional object detection method based on dual-branch strong feature representation and noise-resistant sparse convolution. This method constructs a dual-branch backbone network for collaborative processing of multimodal data. The 3D sparse convolution backbone with strong feature representation and noise-resistant sparse convolution based on scene importance prediction are employed to respectively learn the feature representation of point cloud and pseudo-point cloud data. Additionally, a spatial channel dual-unit cross-fusion module is designed to extract low-level spatial features and high-level abstract semantic features separately through dual channels, avoiding spatial information loss while obtaining more advanced abstract semantic information. Furthermore, this paper designs dynamic self-attention fusion feature refinement blocks to refine features multiple times and merge refined RoI results from different refinement stages, thereby improving detection accuracy. The effectiveness of the proposed components is validated through quantitative evaluation, ablation experiments, and qualitative comparisons on the popular KITTI dataset.},
 author = {Xiaogang Song and Yifan Yang and Zhenhua Zhou and Jichen Chen and Qin Zhao and Xinhong Hei},
 doi = {https://doi.org/10.1016/j.asoc.2025.114252},
 issn = {1568-4946},
 journal = {Applied Soft Computing},
 keyword = {3D object detection, Deep learning, Sparse convolution, Multimodal, Attention mechanism},
 pages = {114252},
 title = {A dual-branch noise-resistant sparse convolution method for multi-modal 3D object detection in autonomous driving},
 url = {https://www.sciencedirect.com/science/article/pii/S1568494625015650},
 volume = {186},
 year = {2026}
}
