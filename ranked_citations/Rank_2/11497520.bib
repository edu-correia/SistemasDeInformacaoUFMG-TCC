@inproceedings{11497520,
 abstract = {Major Depressive Disorder (MDD) is currently global health problem, still the diagnosis of depression heavily relies on subjective basis. This paper introduces framework Deep Maxout Network with the Exponential African Vulture Optimization Algorithm for objective depression detection. This algorithm merged searching mechanism of African Vultures with exponentially weighted moving average to avoid slump in local optima. The aim is to determine depression using measurable biomarkers like acoustic speech and neuroanatomical for structural Magnetic Resonance Imaging (sMRI) rather than existing subjective methods like BDI, HRSD (Hamilton rating scale for depression). The specific features are extracted using LDTP, HOG for sMRI and MKMFCC for speech on worldwide accepted MPI-Leipzig Mind-Brain-Body Provided dataset. The ExpAVOA_DMN clocked 95.9% accuracy, 94.2% sensitivity and 96.8% specificity, outpacing baselines and standard CNN models. We also used detailed User Interface (UI) with dashboard, data ingestion model and result interface to support clinical application. These results suggest that combining advanced deep learning with multimodal biomarkers offers quantitative resolution to the "biomarker bottleneck" in computational psychiatry.},
 author = {Magar, Harshada and Chavhan, Yash and Patil, Niranjana and Patil, Tejas},
 booktitle = {2026 IEEE International Conference on AI Engineering and Innovations (AIEI)},
 doi = {10.1109/AIEI69164.2026.11497520},
 issn = {},
 keyword = {Filtering;Filters;Circuits and systems;Gabor filters;Thermal noise;Protocols;Event detection;Wireless sensor networks;HTTP;Modulation;Exponential African Vulture Optimization Algorithm (ExpAVOA);Deep Maxout Network (DMN);Depression Detection;structural MRI (sMRI);Acoustic Biomarkers},
 month = {March},
 number = {},
 pages = {1-6},
 title = {ExpAVOA-DMN for Depression Detection: Multimodal Deep Learning framework using Acoustic and sMRI Biomarkers},
 volume = {},
