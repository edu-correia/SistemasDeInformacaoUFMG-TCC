@article{Shahri200663,
 abstract = {Removal of fuzzy duplicate records is one of the most challenging phase of data cleaning while integrating data from distributed operational databases. A new duplicate-elimination framework that exploits fuzzy inference and includes unique machine learning capabilities to let users clean their data flexibility and effortlessly without requiring any coding. Four types of data problems usually cause differences between tuples, which are incomplete data, incorrect data, incomprehensible data, or inconsistent data. The duplicate elimination process includes a clustering algorithm, attributes for comparing a pair tuples, corresponding similarity functions for measuring attribute similarity, fuzzy rules used in the fuzzy inference engine, membership functions, and merging strategy. The framework shows potential for developing an application-oriented commercial tool for duplicate elimination.},
 author = {Shahri, Hamid Haidarian and Shahri, Saied Haidarian},
 doi = {10.1109/MIS.2006.90},
 journal = {IEEE Intelligent Systems},
 note = {Cited by: 14},
 number = {5},
 pages = {63 - 71},
 publication_stage = {Final},
 source = {Scopus},
 title = {Eliminating duplicates in information integration: An adaptive, extensible framework},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33749665274?origin=resultslist},
 volume = {21},
 year = {2006}
}
