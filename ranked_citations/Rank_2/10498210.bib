@inproceedings{10498210,
 abstract = {CopConnect, a pioneering project addressing the limitations of conventional law enforcement by leveraging advanced AI technologies such as TensorFlow, Keras, and OpenCV. Serving as an innovative solution, CopConnect revolutionizes crime prevention and suspect identification through streamlined online FIR reporting, improved sketch generation, and AI-driven surveillance. The system’s core technologies include TensorFlow, Keras, OpenCV, and scikit-learn, implemented on a robust Java foundation with an efficient SQLite database. CopConnect utilizes sophisticated algorithms for facial recognition, sketch enhancement, and AI-driven surveillance, ensuring enhanced precision in identifying individuals in images and videos. Accuracy is evaluated through parameters like facial recognition precision and sketch generation accuracy, highlighting the system’s reliability. In summary, CopConnect emerges as a transformative tool, seamlessly integrating cutting-edge technologies to redefine law enforcement, promising a safer and more secure society through advanced precision, efficiency, and public safety measures.},
 author = {Vartak, Krunali and Gujral, Sahil and Patil, Jidnyasa and Patil, Niyati},
 booktitle = {2024 11th International Conference on Computing for Sustainable Global Development (INDIACom)},
 doi = {10.23919/INDIACom61295.2024.10498210},
 issn = {},
 keyword = {Law enforcement;Finite impulse response filters;Surveillance;Face recognition;Refining;Merging;Streaming media;OpenCV;Tensorflow},
 month = {Feb},
 number = {},
 pages = {325-331},
 title = {CopConnect - AI-driven Surveillance and Sketch Generation for Crime},
 volume = {},
 year = {2024}
}
