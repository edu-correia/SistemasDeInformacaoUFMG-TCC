@article{11108715,
 abstract = {This study focuses on irregular intersections and proposes a novel non-stop traffic control approach that integrates precise trajectory modeling with optimization-based control. Firstly, a trajectory model composed of straight lines and circular curves is developed to accurately describe vehicle movement paths within irregular intersections. Then, for the three typical conflict scenarios of diverging, crossing and merging, the conflict zone action distance calculation models are established, and the corresponding conflict resolution strategies are designed to ensure safe vehicle interactions. In terms of optimization and control, a joint optimization model of vehicle path planning and speed control (PPSC) is constructed with the objective of minimizing the total vehicle delay, and a rolling horizon control scheme is employed to efficiently solve the model. Finally, numerical experiments are conducted to validate the effectiveness and advancement of the proposed method. The simulation results indicate that the PPSC method achieves significant improvements in reducing average vehicle delay, enhancing intersection throughput, and lowering fuel consumption. Moreover, the effects of different safe interval times, adjustment section lengths, and planning time horizons on the performance of the PPSC method are further investigated through sensitivity analysis.},
 author = {Zhang, You and Liu, Yugang and Ren, Shengli and Liu, Lining and Zheng, Shuai},
 doi = {10.1109/TVT.2025.3595392},
 issn = {1939-9359},
 journal = {IEEE Transactions on Vehicular Technology},
 keyword = {Trajectory;Roads;Merging;Analytical models;Velocity control;Traffic control;Safety;Training;Real-time systems;Organizations;Connected and automated vehicle;irregular intersections;unsignalized control;conflict resolution strategy},
 month = {Jan},
 number = {1},
 pages = {290-304},
 title = {Conflict Resolution Strategies for Connected and Autonomous Vehicles at Unsignalized Irregular Intersections: Path Planning and Speed Control},
 volume = {75},
 year = {2026}
}
