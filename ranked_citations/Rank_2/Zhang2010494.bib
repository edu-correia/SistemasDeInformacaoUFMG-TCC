@conference{Zhang2010494,
 abstract = {In this paper, we developed a robust data cleaning technique, called PC-Filter+ (PC stands for partition comparison) based on its predecessor, for effective and efficient duplicate record detection in large databases. PC-Filter+ provides more flexible algorithmic options for constructing the Partition Comparison Graph (PCG). In addition, PC-Filter+ is able to deal with duplicate detection under different memory constraints. © 2010 IEEE.},
 author = {Zhang, Ji},
 doi = {10.1109/NSS.2010.78},
 journal = {Proceedings - 2010 4th International Conference on Network and System Security, NSS 2010},
 note = {Cited by: 2},
 pages = {494 - 501},
 publication_stage = {Final},
 source = {Scopus},
 title = {An efficient and effective duplication detection method in large database applications},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78650387828?origin=resultslist},
 year = {2010}
}
