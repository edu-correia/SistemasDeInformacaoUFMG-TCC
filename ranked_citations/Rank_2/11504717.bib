@inproceedings{11504717,
 abstract = {Erasure coding reduces storage overhead but incurs repair costs, which worsen in wide-stripe settings with frequent multi-block failures. Existing Repair pipelining(RP) schemes suffer severely from bandwidth heterogeneity, as low-bandwidth links become bottlenecks when repeatedly used for multiple failed blocks. We propose Collecting Parallel Multi-block Repair (CPMR). CPMR uses high-bandwidth nodes as collecting nodes to receive raw data from low-bandwidth nodes and then perform computational forwarding, while other bandwidth-sufficient nodes transmit in parallel pipelining, ultimately completing merged repairs at the target recovery nodes. This significantly reduces the number of times low-bandwidth links are used in the multi-block repair process, thereby enhancing the overall repair efficiency of the system. We deployed an experimental cluster on the Amazon EC2 cloud platform and conducted system tests on CPMR in a real bandwidth-heterogeneous environment. Experimental results demonstrate that CPMR achieves an average repair time reduction of up to 67.3% compared to existing repair schemes.},
 author = {Jin, Yizhang and Hai, Qinda and Peng, Siyuan and Han, Guojun},
 booktitle = {2026 IEEE 8th International Conference on Communications, Information System and Computer Engineering (CISCE)},
 doi = {10.1109/CISCE69494.2026.11504717},
 issn = {2833-2423},
 keyword = {Data communication;Downlink;Heterogeneous networks;Uplink;Cloud computing;Computer networks;Protocols;Multiplexing;Satellite communications;HTTP;Distributed storage;Erasure code;Nodes repair;Heterogeneous network;Network transfer},
 month = {March},
 number = {},
 pages = {1-6},
 title = {Collecting Parallel Multi-Block Repair: A Repair Method for Optimizing Repair in Heterogeneous Network},
 volume = {},
 year = {2026}
}
