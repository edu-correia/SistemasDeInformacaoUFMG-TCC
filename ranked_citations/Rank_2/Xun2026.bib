@article{Xun2026,
 abstract = {For task offloading in Unmanned Aerial Vehicle (UAV) edge computing scenarios, existing studies have extensively investigated UAV mobility and dynamic task offloading strategies. However, effectively coordinating UAV trajectory planning and task offloading decisions under highly dynamic network conditions and uncertainty remains a challenge. To address the insufficient consideration of UAV position dynamics and network environment changes in traditional offloading strategies, this study proposes an optimized UAV task offloading method that integrates Digital Twin (DT) technology, Deep Reinforcement Learning (DRL), and Two-Stage Stochastic Optimization (TSO). First, DT technology is employed to provide fine-grained task and device descriptions and to support flexible task classification based on task characteristics and system requirements, categorizing tasks into computation-intensive and latency-sensitive types, thereby providing a refined basis for offloading decisions. Subsequently, the trajectory optimization of UAVs and task offloading decisions are decoupled. UAVs path planning is handled by a DRL algorithm, while offloading strategies are generated using a two-stage stochastic programming model. This hierarchical design enables a balance between long-term system performance and real-time decision robustness in uncertain environments. Furthermore, the Conditional Value at Risk (CVaR) criterion is introduced to model potential transmission delay risks during the offloading process, enhancing the system’s robustness and stability under extreme network conditions. Experimental results demonstrate that the proposed method outperforms existing conventional algorithms in key metrics such as energy-delay trade-off and task completion rate and exhibits strong adaptability in complex dynamic scenarios, showing promising practical potential. © 2026 Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
 author = {Xun, Yaling and Fan, Jinlong and Zhang, Jifu and Yang, Haifeng and Cai, Jianghui and Wang, Xing},
 doi = {10.1016/j.future.2026.108455},
 journal = {Future Generation Computer Systems},
