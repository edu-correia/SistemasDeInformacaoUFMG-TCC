@article{He20061465,
 abstract = {A new image fusion algorithm using GRA (grey relational analysis) is presented based on IHS transform for the fusion of the TM low-resolution, multi-spectral image and high-resolution SAR image. First, we use GRA to classify pixels in the SAR image into non-edge pixels and edge pixels. Second, by means of IHS transform we fuse I component and SAR image with different weighting strategies, in which weight for edge pixels is higher than that for non-edge pixels. The compare and contrast data show that the proposed method is compact and able to resist noises better, and it enhances spatial detail information of the fusion image efficiently and preserves spectral information of the original TM image much better.},
 author = {He, Guiqing and Hao, Chongyang and Xie, Hongmei and Tian, Yun and Lai, Changcai},
 journal = {Journal of Computational Information Systems},
 note = {Cited by: 0},
 number = {4},
 pages = {1465 - 1472},
 publication_stage = {Final},
 source = {Scopus},
 title = {New image fusion algorithm using GRA based on IHS transform},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33845803232?origin=resultslist},
 volume = {2},
 year = {2006}
}
