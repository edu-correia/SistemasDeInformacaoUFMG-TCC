@inproceedings{11291737,
 abstract = {The integration of Artificial Intelligence (AI) into modern society challenges the foundational principles of criminal liability, particularly in legal systems like Bahrain, which rely on traditional doctrines. As AI becomes increasingly autonomous, determining legal responsibility for AI-driven acts becomes legally and ethically complex. Current criminal laws in Bahrain and similar jurisdictions often fail to address situations where AI systems act independently or unpredictably, leading to legal ambiguity in assigning mens rea and actus reus. To address these limitations, this adopts the Technology-Assisted Doctrinal Legal Analysis (TADLA) framework, which merges classical legal interpretation with AI-powered analytics tools to examine statutory gaps and simulate AI-related legal scenarios. The proposed method enables structured analysis of liability in cases such as autonomous vehicle collisions or AI-generated fraud by mapping legal doctrines against AI autonomy levels. It enhances predictive legal reasoning and comparative analysis with laws from the EU, USA, and UAE. Findings reveal that Bahraini law lacks explicit provisions for AI-induced criminal acts, and the TADLA framework helps identify legislative blind spots, suggesting targeted reforms to ensure legal clarity, accountability, and future.},
 author = {Issa, Husein Bani and Alnagrash, Amjad Ali Mohammad and Masadeh, Ali Mahmoud},
 booktitle = {2025 3rd International Conference on Cyber Resilience (ICCR)},
 doi = {10.1109/ICCR67387.2025.11291737},
 issn = {},
 keyword = {Ethics;Law;Cognition;Fraud;Criminal law;Artificial intelligence;Autonomous vehicles;Resilience;Artificial Intelligence;Criminal Liability;Bahraini Law;Legal Reform;AI and Law},
 month = {July},
 number = {},
 pages = {1-8},
 title = {The Impact of Artificial Intelligence on Criminal Liability in Bahraini and Comparative Law},
 volume = {},
