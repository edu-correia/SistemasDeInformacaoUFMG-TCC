@article{Khan2010,
 abstract = {We formulate the problem of distributed throughput-efficient sensing in cognitive radio (CR) networks as a dynamic coalition formation game based on a Markovian model. The proposed coalition formation enables the CRs to increase their achievable throughput, under the detection probability constraint, while also taking into account the overhead in sensing reports combining. The dynamic model of coalition formation is used to express and model the behavior of the coalition forming CRs over time. In the proposed game, CRs form coalitions either to increase their individual gains (selfish coalition formation) or to maximize the overall gains of the group (altruistic coalition formation). We show that the proposed coalition formation solutions yield significant gains in terms of reduced average false alarm probability and increased average throughput per CR as compared to the non-cooperative solutions. Given a target detection probability for a coalition, we adopt a weighted target detection probability for individual CRs in a coalition. We find that the weighted target detection probability for individual CRs results in increased average throughput per CR as compared to when each CR is assigned the same target detection probability in a coalition. © 2010 Zaheer Khan et al.},
 author = {Khan, Zaheer and Lehtomki, Janne and Codreanu, Marian and Latva-Aho, Matti and Dasilva, Luiz A.},
 doi = {10.1155/2010/653913},
 journal = {Eurasip Journal on Wireless Communications and Networking},
 note = {Cited by: 18; All Open Access; Gold Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Throughput-efficient dynamic coalition formation in distributed cognitive radio networks},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/79251578332?origin=resultslist},
 volume = {2010},
 year = {2010}
}
