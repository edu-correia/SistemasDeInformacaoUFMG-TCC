@conference{Zhang202365,
 abstract = {Modern SSDs achieve high throughput by utilizing multiple independent channels and chips in parallel. However, we find that excessive parallelism inadvertently amplifies the garbage collection (GC) overhead due to the larger unit of space reclamation. Based on this observation, we design PLAN, a novel SSD parallelism management and data placement scheme that allocates different levels of parallelism to different workloads with different needs to minimize the GC overhead. We demonstrate the effectiveness of PLAN by evaluating it against other state-of-the-art designs across various real-world workloads. PLAN reduces write amplification with comparable or better performance to the other designs that are always at full parallelism. © 2023 ACM.},
 author = {Zhang, Xiangqun and Pei, Shuyi and Choi, Jongmoo and Kim, Bryan S.},
 doi = {10.1145/3599691.3603412},
 journal = {HotStorage 2023 - Proceedings of the 2023 15th ACM Workshop on Hot Topics in Storage and File Systems},
 note = {Cited by: 14; All Open Access; Gold Open Access},
 pages = {65 - 72},
 publication_stage = {Final},
 source = {Scopus},
 title = {Excessive SSD-Internal Parallelism Considered Harmful},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85168339103?origin=resultslist},
 year = {2023}
}
