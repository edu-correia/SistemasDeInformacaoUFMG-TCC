@article{10.1145/3655627,
 abstract = {The development of FPGA-based applications using HLS is fraught with performance pitfalls and large design space exploration times. These issues are exacerbated when the application is complicated and its performance is dependent on the input dataset, as is often the case with graph neural network approaches to machine learning. Here, we introduce HLPerf, an open-source, simulation-based performance evaluation framework for dataflow architectures that both supports early exploration of the design space and shortens the performance evaluation cycle. We apply the methodology to GNNHLS, an HLS-based graph neural network benchmark containing six commonly used graph neural network models and four datasets with distinct topologies and scales. The results show that HLPerf achieves over 10, 000\texttimes{} average simulation acceleration relative to RTL simulation and over 400\texttimes{} acceleration relative to state-of-the-art cycle-accurate tools at the cost of 7% mean error rate relative to actual FPGA implementation performance. This acceleration positions HLPerf as a viable component in the design cycle.},
 address = {New York, NY, USA},
 articleno = {2},
 author = {Zhao, Chenfeng and Faber, Clayton and Chamberlain, Roger and Zhang, Xuan},
 doi = {10.1145/3655627},
 issn = {1936-7406},
 issue_date = {March 2025},
 journal = {ACM Trans. Reconfigurable Technol. Syst.},
 keyword = {Performance evaluation, discrete-event simulation, graph neural networks},
 month = {December},
 number = {1},
 numpages = {26},
 publisher = {Association for Computing Machinery},
 title = {HLPerf: Demystifying the Performance of HLS-based Graph Neural Networks with Dataflow Architectures},
 url = {https://doi.org/10.1145/3655627},
 volume = {18},
 year = {2024}
}
