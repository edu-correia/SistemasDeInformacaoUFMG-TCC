@article{KHAN2026131238,
 abstract = {Federated learning (FL) enables collaborative model training across decentralized clients without sharing raw data. In practice, however, non-i.i.d. data, heterogeneous operating conditions, and temporal changes in client behavior can jointly undermine robustness and fairness. This paper introduces Fairness-Aware Branching Federated Learning under Events and Concept Drift (FABLE), an adaptive framework that dynamically branches a global model into a small set of specialized sub-models and assigns each client to the branch that best matches its current data. FABLE integrates fairness-aware branching triggers, periodic client reassignment with a hysteresis rule to prevent oscillatory membership, and event- and drift-aware mechanisms to handle abrupt events and gradual concept drift. The branching structure is learned online from empirical loss signals; branches can be created, merged, or retired without prior knowledge of the underlying client clusters, improving personalization while protecting worst-case client performance. Experiments on standard FL benchmarks (FEMNIST, CIFAR-100, and Shakespeare) and a real-world environmental monitoring network show that FABLE consistently achieves a better accuracy–fairness trade-off and more stable client-to-model assignments than strong baselines, including FedAvg and representative clustered and personalized FL methods. We further provide a theoretical analysis under the Polyak–Łojasiewicz condition, establishing convergence guarantees and conditions for correct cluster recovery under a mild client-separation assumption.},
 author = {Koffka Khan and Winston Elibox and Treina Dinoo Ramlochan and Wayne Rajkumar and Shanta Ramnath},
 doi = {https://doi.org/10.1016/j.eswa.2026.131238},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Federated learning, Model heterogeneity, Personalization, Fairness, Robustness, Environmental monitoring},
 pages = {131238},
 title = {FABLE: Fairness-aware branching federated learning under events and concept drift},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417426001521},
 volume = {309},
 year = {2026}
}
