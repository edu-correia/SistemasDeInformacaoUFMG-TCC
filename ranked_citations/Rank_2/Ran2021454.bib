@conference{Ran2021454,
 abstract = {Recently, the Lattice structure has been proved to be effective for Chinese entity relation extraction by incorporating the word information. However, this method cannot utilize phrases that contain sentence structure information. In order to solve the problem, we introduced a Lattice model with phrase component representation, which can merge word, phrase and character input. We also apply the multi-head self-attention mechanism in the classification layer to effectively learn the dependencies between distant words. After comparative experiments, our model achieves better results. © 2021 IEEE.},
 author = {Ran, Xingxing and Yang, Fuping},
 doi = {10.1109/ITNEC52019.2021.9587231},
 journal = {IEEE Information Technology, Networking, Electronic and Automation Control Conference, ITNEC 2021},
 note = {Cited by: 1},
 pages = {454 - 458},
 publication_stage = {Final},
 source = {Scopus},
 title = {Chinese Relation Extraction with Phrase Component Representations},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85119252064?origin=resultslist},
 year = {2021}
}
