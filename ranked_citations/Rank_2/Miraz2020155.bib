@article{Miraz2020155,
 abstract = {Purpose: The purpose of this study is toanalyses the factors that influence blockchain & bitcoin for peer money transfer. Also, this study identifies the concept of blockchain and cryptocurrency. Furthermore, the conceptual framework of this study developed incorporating trust on software as a mediator for a better understanding of the use of blockchain in a peermoney transaction. Theory: The unified theory of acceptance and use of technology (UTAUT2) by adding trustin software as an independent variable. This research also demonstrates the relationship between the blockchain and bitcoininpeer transaction. The theoretical framework of this study developed to merge trust on software as a synthesis in UTAUT2 for a better understanding of the use of blockchain for peer transaction in Malaysia. Methodology: 142 self-administered questionnaires distributed through simple random sampling technology aimed at blockchain users in Malaysia from 20 to 30 years. Data analysis performed using PLS. This studyalso demonstrate the relationship of peer transaction and trustin software have a positive and significant relationship with using blockchain& bitcoin. Significant: This research will significantly contribute to blockchain diversityin Malaysia. It is also providing them with useful information about the interaction between the critical determinants of the trust and intention of blockchain behaviourin Malaysia. Originality: This is one of the most recent studies that describe the blockchain& bitcoin fundaments and transaction policy in Malaysia. © 2019 ETA-Florence Renewable Energies.},
 author = {Miraz, Mahadi Hasan and Sharif, Kamal Imran Mohd and Hassan, Mohamad Ghozali},
 doi = {10.5373/JARDCS/V12SP3/20201249},
 journal = {Journal of Advanced Research in Dynamical and Control Systems},
 note = {Cited by: 5},
 number = {3 Special Issue},
