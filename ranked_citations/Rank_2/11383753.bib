@inproceedings{11383753,
 abstract = {Those with hearing or speech impairments have a hard time communicating in their learning, professional,and social environments because of the lack of public awareness of Indian Sign Language (ISL). Presently sign language interpretation technologies have limitations due to their inaccuracies and small datasets making them less viable. We have created an elaborate gesture recognition system of the ISL that is a two way converter of gestures to text, emotionally identifying the input for the context. Our method involves a tailor made dataset of 2000 images merged with the Sign Language MNIST dataset from Kaggle (34,627 images) and ISL CSLTR dataset (video frames) to increase the model's stability. By employing YOLOv5 and YOLOv8 structures with transfer learning,we have raised the accuracy to 92%,precision to 95% and recall to 97% on the extended dataset,which is a considerable enhancement of the performance of the baseline models trained only on the custom data.},
 author = {Shivanshu and Rai, Saatvik and Kumar, Utkarsh and Raman, Pratyush and Mittal, Mandeep},
 booktitle = {2025 Second International Conference on Pioneering Developments in Computer Science & Digital Technologies (IC2SDT)},
 doi = {10.1109/IC2SDT68218.2025.11383753},
 issn = {},
 keyword = {YOLO;Sign language;Computer vision;Accuracy;Computational modeling;Merging;Data models;Stability analysis;Videos;Testing;Sign Language Recognition (SLR);ISL;YOLO Algorithm;Computer Vision;Machine Learning},
 month = {Dec},
 number = {},
 pages = {154-159},
 title = {Bridging Silent Worlds: Advanced Computer Vision Approaches to Indian Sign Language Recognition},
 volume = {},
 year = {2025}
}
