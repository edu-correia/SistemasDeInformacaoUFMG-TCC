@inproceedings{8242379,
 abstract = {Adaptive detection problem of range-spread targets is investigated in generalized Pareto sea clutter. Texture component of non-Gaussian sea clutter is considered to follow inverse gamma distribution in order to match the non-Gaussian characteristic of clutter. In response to the heavy detection performance loss of adaptive detectors when the secondary data are limited, the persymmetric structure of the covariance matrix is merged into the proposed detector. The proposed adaptive detector can perform better in heavy spiky clutter. Meanwhile, experiments via exploiting simulated data and measured sea clutter data indicate that the proposed detector has superior detection performance, especially for limited secondary data.},
 author = {Xue, Jian and Xu, ShuWen and Shui, Penglang},
 booktitle = {2017 IEEE International Conference on Signal Processing, Communications and Computing (ICSPCC)},
 doi = {10.1109/ICSPCC.2017.8242379},
 issn = {},
 keyword = {Clutter;Covariance matrices;Detectors;Radar clutter;Radar detection;Maximum likelihood estimation;Adaptive detection;Range-spread targets;Generalized Pareto clutter;Persymmetric structure},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Persymmetric adaptive detection for range-spread targets in generalized Pareto sea clutter},
 volume = {},
 year = {2017}
}
