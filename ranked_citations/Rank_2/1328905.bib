@inproceedings{1328905,
 abstract = {An algorithm that reduces the computational complexity of discrete cosine transform (DCT) based multimedia coder is proposed. The proposed coder merges the DCT and quantization process into a single procedure known as NQDCT, such that the resulting algorithm has the same complexity as that of the DCT algorithm. Furthermore, appropriate scaling is applied that allows integer arithmetic to be used to compute NQDCT. We also discussed the implementation of NQDCT on multimedia processor. In particular, we demonstrated the implementation of NQDCT on Intel IV processor using SSE multimedia instruction set. MPEG-4 video coding simulation results have shown that a large reduction in computation complexity is achieved by the proposed algorithm, while the encoded video achieves very little degradation which cannot be detected by human observers.},
 author = {Ming-Yan Chan and Chi-Wah Kok},
 booktitle = {2004 IEEE International Symposium on Circuits and Systems (ISCAS)},
 doi = {10.1109/ISCAS.2004.1328905},
 issn = {},
 keyword = {Discrete cosine transforms;Quantization;Computational complexity;MPEG 4 Standard;Video coding;Multimedia systems;Video compression;Transform coding;Motion compensation;Hardware},
 month = {May},
 number = {},
 pages = {III-949},
 title = {A new quantized DCT and its implementation on multimedia processor},
 volume = {3},
 year = {2004}
}
