@article{10.1109/TCBB.2015.2403320,
 abstract = {In gene expression data analysis, clustering is a fruitful exploratory technique to reveal the underlying molecular mechanism by identifying groups of co-expressed genes. To reduce the noise, usually multiple experimental replicates are performed. An integrative analysis of the full replicate data, instead of reducing the data to the mean profile, carries the promise of yielding more precise and robust clusters. In this paper, we propose a novel resampling based clustering algorithm for genes with replicated expression measurements. Assuming those replicates are exchangeable, we formulate the problem in the bootstrap framework, and aim to infer the consensus clustering based on the bootstrap samples of replicates. In our approach, we adopt the mixed effect model to accommodate the heterogeneous variances and implement a quasi-MCMC algorithm to conduct statistical inference. Experiments demonstrate that by taking advantage of the full replicate data, our algorithm produces more reliable clusters and has robust performance in diverse scenarios, especially when the data is subject to multiple sources of variance.},
 address = {Washington, DC, USA},
 author = {Li, Han and Li, Chun and Hu, Jie and Fan, Xiaodan},
 doi = {10.1109/tcbb.2015.2403320},
 issn = {1545-5963},
 issue_date = {November 2015},
 journal = {IEEE/ACM Trans. Comput. Biol. Bioinformatics},
 month = {November},
 number = {6},
 numpages = {9},
 pages = {1295–1303},
 publisher = {IEEE Computer Society Press},
 title = {A Resampling Based Clustering Algorithm for Replicated Gene Expression Data},
 url = {https://doi.org/10.1109/TCBB.2015.2403320},
 volume = {12},
 year = {2015}
}
