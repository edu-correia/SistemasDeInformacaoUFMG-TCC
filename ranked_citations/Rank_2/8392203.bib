@inproceedings{8392203,
 abstract = {Digital color image is a grid of picture elements where each color is an ordered triplet consisting of at least three color components generally red, green and blue. In general each pixel occupies at least eight bits, a digital image consist of millions of picture elements lead to high storage space and high bandwidth required during the transmission in computer networks. The solution is to reduce the image file size that can be achieved through image compression. The image compression possible only when there exists and identified redundancy in digital images. The proposed method try to find and remove redundancy within pixel element based on inter element redundancy by dividing image element into individual digits. The repeated individual digits of image elements are folded into triplet and merged. Finally, high compression rates achieved through entropy coding.},
 author = {Reddy, B Lakshmmi Narayana and Peruru, Praneel Kumar and Kumar, D Maruthi},
 booktitle = {2017 IEEE International Conference on Power, Control, Signals and Instrumentation Engineering (ICPCSI)},
 doi = {10.1109/ICPCSI.2017.8392203},
 issn = {},
 keyword = {Image coding;Image color analysis;Redundancy;Color;Digital images;Merging;Conferences;Entropy;Folding;Redundancy;Intrapixel;Triplet;Delimiter;Merge},
 month = {Sep.},
 number = {},
 pages = {2672-2676},
 title = {Inter image element loss less image compression with delimiter and folding},
 volume = {},
 year = {2017}
}
