@article{CUI2025112340,
 abstract = {ABSTRACT
Triphenylamine (TPA)-based fluorescent probes offer strong aggregation-induced emission (AIE) and versatile donor–acceptor (D–A) motifs, yet their practical applicability is limited by poor selectivity and background emission from non-specific acceptor reactions. Herein, we present TPA-PROXYL, a photoinduced electron transfer (PET)–mediated “OFF–ON” probe that merges AIE-active TPA scaffold with a stable 2,2,5,5-tetramethyl-3-pyrrolin-1-oxyl (PROXYL) radical for highly specific benzoyl peroxide (BPO) detection. Upon selective oxidation of the PROXYL moiety by BPO in DMF at 100°C for 1 h, PET is suppressed, and yielding a strong fluorescence turn-on at 465 nm (λₑₓ = 365 nm). Notably, the probe is activated at 0.5 mmol/L BPO and achieves a low detection limit of 211 nmol/L with good linearity, while maintaining high selectivity against redox interferents such as glutathione (GSH), ascorbic acid (VC), and cysteine (CYS). Furthermore, the recovery rate exceeding 84% in real sample applications demonstrates the robustness and practicality of TPA-PROXYL. By integrating the PET modulation with AIE activity, this strategy establishes a high-fidelity sensing platform with exceptional specificity and sensitivity, offering strong potential for on-site BPO surveillance and broader small-molecule detection in complex matrices.},
 author = {Xinfang Cui and Zehong Wang and Yingjiang Li and Yufeng Xiong and Tong Zhou and Xiangdong Peng and Guanghui Zhao and Lijie Dong},
 doi = {https://doi.org/10.1016/j.cclet.2025.112340},
 issn = {1001-8417},
 journal = {Chinese Chemical Letters},
 keyword = {Triphenylamine, Stable PROXYL radical, Photoinduced electron transfer, OFF–ON probe, BPO detection},
 pages = {112340},
 title = {Rapid OFF–ON photoinduced electron transfer probe based on triphenylamine and PROXYL radical specifically activated by benzoyl peroxide},
 url = {https://www.sciencedirect.com/science/article/pii/S1001841725015177},
 year = {2025}
}
