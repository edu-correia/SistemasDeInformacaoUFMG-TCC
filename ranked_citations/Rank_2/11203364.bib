@inproceedings{11203364,
 abstract = {Customer reviews are an important factor in determining service quality, particularly in customer-oriented platforms such as Uber where customer experience determines business success. This research investigates multimodal sentiment analysis by combining text-based reviews and emoji-based feedback using machine learning and deep learning models to enhance sentiment classification accuracy. We use Word2Vec and BERT for text embedding, encoding contextual and semantic information, and emoji usage is examined as an auxiliary modality. For improving predictive accuracy, we experimented with Early Fusion, Late Fusion, and Hybrid Fusion methods, integrating textual and emoji features at various levels of the learning process. According to our findings, Early Fusion is the most successful strategy as it obtains the best accuracy (82.58%) and weighted F1-score (0.80). While Late Fusion performs poorly (63.17% accuracy), Hybrid Fusion likewise does well (80.58% accuracy). These results demonstrate the advantages of early multimodal feature integration for better sentiment analysis and offer insightful information for improving ride-sharing services’ assessment of user comments.},
 author = {Jatkar, Tanvi and Raikwar, Anvesha and Kumar, Abhinav and Nayyer, Aadarsh and Mishra, Nivedita and Joshi, Gargi},
 booktitle = {2025 International Conference on Artificial Intelligence and Machine Vision (AIMV)},
 doi = {10.1109/AIMV66517.2025.11203364},
 issn = {},
 keyword = {Deep learning;Sentiment analysis;Analytical models;Accuracy;Reviews;Semantics;Bidirectional control;Encoding;Timing;Emojis;Multimodal AI;Data Fusion;Sentiment Analysis;Emoji Feedback;Machine Learning;Deep Learning;Uber Reviews},
 month = {Aug},
 number = {},
 pages = {1-6},
 title = {Multimodal Sentiment Analysis using Multitasking},
