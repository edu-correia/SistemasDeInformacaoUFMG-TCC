@inproceedings{11280380,
 abstract = {Traditional exam invigilation methods often suffer from issues like impersonation, inconsistencies, and unnoticed cheating activities. This work introduces an intelligent exam hall surveillance system that merges biometric verification with AI-driven visual monitoring to provide secure and automated supervision. A fingerprint sensor connected to an ESP32-WROOM microcontroller is used to authenticate students before entry, with their identity data safely stored on a cloud/server. Throughout the exam, ESP32-CAM devices capture student images and transmit them via HTTP to the cloud. These images are processed using a YOLOv8 (You Only Look Once version 8) deep learning model capable of detecting behavioral patterns such as head turning, hand movement, and other actions that may indicate cheating. If irregular behavior is identified, alerts are generated, and event logs are recorded for later analysis. This work showcases how the integration of IoT and AI technologies can build a reliable, scalable, and tamper-resistant invigilation system, improving the overall integrity and security of academic assessments.},
 author = {Evangeline, Suganthi and N, Sri Sudhi and Akshhayaa M P, Sai and T, Ruthresh and M, Sri Krishna},
 booktitle = {2025 7th International Conference on Innovative Data Communication Technologies and Application (ICIDCA)},
 doi = {10.1109/ICIDCA66325.2025.11280380},
 issn = {},
 keyword = {YOLO;Visualization;Cloud computing;Surveillance;Fingerprint recognition;Biometric authentication;Turning;Sensors;Security;Usability;Automated exam monitoring;AI-based surveillance;Smart invigilation;biometric authentication;ESP32-CAM;YOLOv8;AI surveillance;automated exam monitoring;cloud computing;object detection;machine learning;intelligent invigilation;IoT in education},
 month = {Oct},
 number = {},
 pages = {348-353},
 title = {Smart Exam Hall Invigilation with Biometric Authentication and AI-based Malpractice Detection},
 volume = {},
