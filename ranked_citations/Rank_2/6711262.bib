@inproceedings{6711262,
 abstract = {A dual bow-tie-like monopole antenna with enhanced isolation is proposed. A suspended metal strip merging the two bow-tie-like monopole antennas together is used for effective reduction of the mutual coupling. The antenna structure is very simple and suitable for multiple-input-multiple-output (MIMO) systems. Good impedance matching and high isolation are obtained in the frequency band of 1.83-2.34 GHz for long term evolution (LTE) and universal traffic management systems (UTMS). Details of the design and measurement results are presented and discussed.},
 author = {Tseng, Hsien Kang and Hsu, Powen},
 booktitle = {2013 IEEE Antennas and Propagation Society International Symposium (APSURSI)},
 doi = {10.1109/APS.2013.6711262},
 issn = {1947-1491},
 keyword = {Antenna measurements;Microstrip antennas;Mutual coupling;MIMO;Microstrip;Metals},
 month = {July},
 number = {},
 pages = {1204-1205},
 title = {Dual bow-tie-like monopole antenna with enhanced isolation},
 volume = {},
 year = {2013}
}
