@inproceedings{6342368,
 abstract = {In this paper, a new topology for single phase power factor correction (PFC) rectifier is proposed with the intent to reduce the common mode current. The proposed PFC rectifier merges the boost and buck-boost converter by sharing an inductor and removes all the bridge diodes to simplify the circuit structure. It features the solid connection between input and output voltage ground terminals, which reduces common mode current. The principle of operation and control algorithm of the proposed rectifier are presented. Experimental results verify that the proposed rectifier shows lower common- mode noise than its conventional counterpart with comparable efficiency.},
 author = {Shin, Jong-Won and Seo, Gab-Su and Ha, Jung-Ik and Cho, Bo-Hyung},
 booktitle = {2012 IEEE Energy Conversion Congress and Exposition (ECCE)},
 doi = {10.1109/ECCE.2012.6342368},
 issn = {2329-3748},
 keyword = {Rectifiers;Inductors;Switches;Semiconductor diodes;Noise;Bridge circuits;Electromagnetic interference},
 month = {Sep.},
 number = {},
 pages = {2901-2907},
 title = {A low common mode noise bridgeless boost-buck-boost power factor correction rectifier},
 volume = {},
 year = {2012}
}
