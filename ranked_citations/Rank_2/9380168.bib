@article{9380168,
 abstract = {When a sensor can resolve the members in a cluster, it is difficult to accurately track each target due to cooperative interaction among the targets. In this paper, we research the tracking problem of resolvable cluster targets with cooperative interaction. Firstly, we use the stochastic differential equation to model the cluster coordination rules, and the state equation of the single target in the cluster is derived. On this basis, a Bayes recursive filter tracking method based on the combination of the DBSCAN clustering algorithm and the  $\delta $ -GLMB filter is proposed. In the  $\delta $ -GLMB filter prediction stage, the DBSCAN algorithm is used to determine the cluster where the target is located in real time. Then, the collaborative noise of the target is estimated, which will be used as the input to correct the prediction state of the target. The simulation and experiment results demonstrate the effectiveness of the proposed algorithm when the cluster is splitting, merging, and in reorganization.},
 author = {Xue, Xirui and Huang, Shucai and Xie, Jiahao and Ma, Jiashun and Li, Ning},
 doi = {10.1109/ACCESS.2021.3066629},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {Force;Target tracking;Mathematical model;Clustering algorithms;Filtering algorithms;Filtering theory;Prediction algorithms;Resolvable cluster target tracking;cooperative interaction modeling;stochastic differential equation;DBSCAN clustering algorithm;δ-GLMB filter},
 month = {},
 number = {},
 pages = {43364-43377},
 title = {Resolvable Cluster Target Tracking Based on the DBSCAN Clustering Algorithm and Labeled RFS},
 volume = {9},
 year = {2021}
}
