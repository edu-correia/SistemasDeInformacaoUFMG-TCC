@conference{Šumák20111,
 abstract = {In the era of huge datasets, the top-κ search becomes an effective way to decrease the search time of top-κ objects. The original top-κ search requires a monotone combination function and lists of objects ordered by attribute values. Our approach of the top-κ search is motivated by complex user preferences over product catalogues. Such user preferences are composed of the local user preferences of the attributes' values (user defined arbitrary fuzzy functions, one for each attribute) and a user defined monotone combination function. This paper compares two different approaches of the top-κ search for this type of nonmonotone query. The first approach uses several B+trees, one for each attribute, and it is based on ordered lists. The second approach is new for this type of query and requires an R-tree index.},
 author = {Šumák, Martin and Gurský, Peter},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 2},
 pages = {1 - 12},
 publication_stage = {Final},
 source = {Scopus},
 title = {Top-κ search in product catalogues},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84868681895?origin=resultslist},
 volume = {706},
 year = {2011}
}
