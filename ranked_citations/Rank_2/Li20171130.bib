@article{Li20171130,
 abstract = {Non-volatile memories suffer from two challenges due to their physical and system-level constraints. One challenge is limited memory lifetime, also called the endurance problem. The other is the difficulty in deleting data securely, called the insecure deletion problem. This paper proposes a coding scheme that addresses both challenges jointly. It studies the secure write-efficient memory (WEM) by analyzing its rewriting-rate equivocation region and secrecy rewriting capacity. It also presents an optimal code construction for a large family of secure WEM channels. © 2016 IEEE.},
 author = {Li, Qing and Jiang, Anxiao},
 doi = {10.1109/TIT.2016.2634553},
 journal = {IEEE Transactions on Information Theory},
 note = {Cited by: 2},
 number = {2},
 pages = {1130 - 1145},
 publication_stage = {Final},
 source = {Scopus},
 title = {Coding for Secure Write-Efficient Memories},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85010441773?origin=resultslist},
 volume = {63},
 year = {2017}
}
