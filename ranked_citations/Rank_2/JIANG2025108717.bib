@article{JIANG2025108717,
 abstract = {In the high-altitude mountainous environment of the Tibetan Plateau, braided rivers over gentle and steep slopes thrive, such as the former in the Source Region of the Yangtze River (SRYR) and the latter in the southern foothills of the Himalayas. Nonetheless, morphological characteristics and formation conditions of these two distinct braided river systems remain unclear. This study integrates remote sensing imagery (Sentinel-2) with field observations to extract and calculate morphological parameters of the braided reaches. By comparing and analyzing their morphological similarities and differences, we aim to clarify the formation conditions. (i) In the SRYR, the braiding intensity of rivers over gentle slopes initially increases, then decreases with increasing water area, exhibiting a parabolic trend. A key distinction between braided rivers over steep and gentle slopes is that the former shows less reduction in braiding intensity due to branch merging. (ii) The braided rivers over steep slopes in the southern foothills of the Himalayas exhibit two distinct braided characteristics: one shows monotonous increase in braiding intensity with increasing water area, while the other displays partial parabolic trend. (iii) Bar cutting patterns differ between braided rivers over gentle and steep slopes: rivers over gentle slopes exhibit more diagonal and lateral cutting and tend to have greater sinuosity. (iv) The morphological characteristics are strongly linked to their formation conditions, with sediment action being the dominant factor. Braided rivers over gentle slopes form when sediment transport capacity is lower than the sediment load. For braided rivers over steep slopes, the formation is driven by a high incoming sediment load and high-energy flows. This study offers a comparative analysis to highlight the similarities and differences in the morphology and formation conditions of braided rivers over gentle and steep slopes, providing scientific evidence for the diversity and universality of braided river dynamics.},
 author = {Baoxin Jiang and Yucong He and Weiqi Ouyang and Zhiwei Li and Zhixian Cao},
 doi = {https://doi.org/10.1016/j.catena.2025.108717},
 issn = {0341-8162},
 journal = {CATENA},
 keyword = {Braided river, Braiding intensity, Morphological characteristics, Formation conditions, High Mountain Asia},
 pages = {108717},
 title = {Morphological characteristics and formation conditions of braided rivers over gentle and steep slopes in the Tibetan Plateau},
 url = {https://www.sciencedirect.com/science/article/pii/S0341816225000190},
 volume = {250},
 year = {2025}
}
