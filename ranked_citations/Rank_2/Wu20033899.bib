@conference{Wu20033899,
 abstract = {Not like optical image, the microwave radiometer image contains information of ground brightness temperature. To integrate some features of microwave radiometer image and optical image, some transform schemes, such as intensity-hue-saturation (IHS), principal component analysis (PCA) and wavelet transform (WT), were applied to merge the airborne synthetic aperture radiometer image and Landsat ETM+ image. The experiments show that the wavelet based transform method show the best potential among those three methods.},
 author = {Wu, Fan and Wang, Chao and Zhang, Weiguo and Zhang, Hong and Wu, Ji and Liu, Hao},
 journal = {International Geoscience and Remote Sensing Symposium (IGARSS)},
 note = {Cited by: 2},
