@article{Lin20268658,
 abstract = {Several methods have been proposed to identify hacker groups targeting industrial control systems (ICS); however, real-time identification of complex hacker groups with new data distributions, different attack patterns (APs), and Internet protocol (IP) prefixes remains to be accomplished. This article utilizes the honeynet data to propose a hacker group identification method, Hacker-Identifier, which focuses on identifying hacker groups targeting ICS. To effectively distinguish APs with different temporal features, we present a novel AP temporal feature modeling method, which combines temporal feature extraction and learning. On this basis, we propose an improved genetic algorithm-based feature selection method to further improve the accuracy of AP classification. To accurately identify APs and hacker groups with new data distributions in real time, we propose a Gaussian self-organizing incremental neural network (GSOINN), which can not only effectively distinguish highly overlapping classes but also prevent excessive segmentation of homogeneous classes. To accurately identify hacker groups with different APs and IP prefixes, we propose an improved hacker group identification method that effectively fuses the attribute and structural features of hackers through heterogeneous graph node embedding. Take the Modbus protocol as an example, we implement a prototype of a Hacker-Identifier, and use 2.5 years of real-world honeynet dataset to evaluate its performance. The experimental results demonstrate its effectiveness and superiority compared with existing state-of-the-art hacker group identification methods. It achieves a weighted F1-score of 98.86% and accuracy of 99.12%, outperforming the state-of-the-art work by 8.12% and 6.86%, respectively, while reducing the total error rate (TER) by 17.11%. © 2014 IEEE.},
 author = {Lin, Xaioli and Yao, Yu and Fang, Yushan and Song, Boxue and Yang, Wei},
 doi = {10.1109/JIOT.2025.3644497},
 journal = {IEEE Internet of Things Journal},
