@article{TANG2026128083,
 abstract = {The deep learning has emerged as a powerful tool for rapid and accurate permeability prediction in porous media. This study proposes a novel hybrid deep learning model that combines vision transformers with soft convolutional inductive biases (ConViT) and transfer learning to achieve end-to-end permeability prediction. The model synergizes the local feature extraction capability of convolutional neural networks with the global contextual modeling strength of transformers, where soft inductive biases are introduced to flexibly integrate convolutional operations. To generate training data, an improved four-parameter stochastic growth method was employed to synthesize porous media structures, and their permeability was computed using the lattice Boltzmann method (LBM). The model’s interpretability was enhanced by using Grad-CAM to visualize critical regions influencing permeability predictions. The results show that the training data by LBM and predicted data by the proposed hybrid model follow same power permeability-porosity correlation. The proposed model achieves outstanding performance, with a correlation coefficient of 0.985 on a synthetic test dataset, which represents a 3.5% improvement compared with relevant baseline models. Furthermore, it demonstrates strong generalization, maintaining a correlation coefficient of 0.890 on a dataset consisting of 200 natural rock samples. This work provides a theoretically grounded and computationally efficient framework for permeability prediction, with broad implications for hydrocarbon recovery, carbon capture and storage, latent heat energy storage, textile engineering, and flexible electronics. The model’s interpretability also aids in understanding fluid flow mechanisms in porous media, offering insights for subsurface resource management.},
 author = {Zhenyu Tang and Shuxia Qiu and Jinqing Wang and Mingxiu Zhan and Peng Xu},
 doi = {https://doi.org/10.1016/j.ijheatmasstransfer.2025.128083},
 issn = {0017-9310},
 journal = {International Journal of Heat and Mass Transfer},
 keyword = {ConViT, Transfer learning, CNN, Porous media, Permeability prediction},
 pages = {128083},
 title = {A hybrid model for permeability prediction of porous media based on ConViT and transfer learning},
 url = {https://www.sciencedirect.com/science/article/pii/S0017931025014188},
 volume = {256},
 year = {2026}
}
