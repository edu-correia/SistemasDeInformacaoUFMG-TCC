@inproceedings{8463393,
 abstract = {Light field acquisition devices can capture static and dynamic information of the light field in space that is processed using computational imaging techniques for creating visual representation of the captured scene. The main applications are the creation of visual effects such as perspective change, refocusing, recoloring. Advances in light field technologies will provide the devices and tools needed for the development of new services in the virtual/augmented/merged reality domains. This paper presents an analysis of the effects of light field subsampling on the quality of experience in refocusing applications.},
 author = {Perra, Cristian and Song, Wei and Liotta, Antonio},
 booktitle = {2018 Tenth International Conference on Quality of Multimedia Experience (QoMEX)},
 doi = {10.1109/QoMEX.2018.8463393},
 issn = {2472-7814},
 keyword = {Image coding;Animation;Quality of experience;Conferences;Bit rate;Imaging;Tools;quality of experience;light field;refocusing applications;subsampling},
 month = {May},
 number = {},
 pages = {1-3},
 title = {Effects of light field subsampling on the quality of experience in refocusing applications},
 volume = {},
 year = {2018}
}
