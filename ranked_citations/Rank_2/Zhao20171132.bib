@conference{Zhao20171132,
 abstract = {Deriving all minimal hitting-sets (MHSes), as candidate diagnoses, is an active topic in model-based diagnosis. Based on the "Divide and Conquer" principle, an algorithm for computing all MHSes by recursive merging is proposed. First, each given (large) family of conflict sets is divided into two smaller sub-families, every one of which is used for computing its own MHSes, respectively. Then, the cross-product of the two corresponding sub-families of MHSes is generated. Finally, the family of MHSes for the whole conflict sets is obtained, only with the additional final step: minimizing the product. Detailed theoretical analysis of time complexity is given in different cases. Experimental results show that our approach has better efficiency than other approaches in many cases. © 2016 IEEE.},
 author = {Zhao, Xiangfu and Ouyang, Dantong},
 doi = {10.1109/ICInfA.2016.7831989},
 journal = {2016 IEEE International Conference on Information and Automation, IEEE ICIA 2016},
 note = {Cited by: 6},
 pages = {1132 - 1137},
 publication_stage = {Final},
 source = {Scopus},
 title = {Deriving all minimal hitting-sets by merging},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85015792125?origin=resultslist},
 year = {2017}
}
