@inproceedings{10107040,
 abstract = {The electromagnetically manipulated dual-band metasurface based on the loaded multimode resonant structure is proposed in this paper. Through stub- and slot-loading techniques, patch resonator can obtain additional resonant modes for multimode characteristics, which are suitable for the construction of dual-band metasurface. A variety of multimode metasurfaces based on cross-stub-loaded-patch resonator and cross-slot-loaded-patch resonator are simulated and analyzed. Combined with the surface current distributions at the resonant frequency, the generation principle of the multi-mode characteristic is revealed. The independent resonant modes can be merged to form dual-wideband with proper tuning of the resonator parameters. Finally, the method has been well validated by two sets of experimental results.},
 author = {Wu, Yueyang and Liu, Long and Deng, Lianwen and Qiu, Lei-Lei},
 booktitle = {2022 IEEE MTT-S International Microwave Workshop Series on Advanced Materials and Processes for RF and THz Applications (IMWS-AMP)},
 doi = {10.1109/IMWS-AMP54652.2022.10107040},
 issn = {2694-2992},
 keyword = {Radio frequency;Design methodology;Conferences;Dual band;Resonant frequency;Metasurfaces;Microwave theory and techniques;Dual-band;metasurface;multimode;slot-loaded;stub-loaded},
 month = {Nov},
 number = {},
 pages = {1-3},
 title = {Electromagnetically Manipulated Dual-band Metasurface Based on Loaded Multimode Resonant Structure},
 volume = {},
 year = {2022}
}
