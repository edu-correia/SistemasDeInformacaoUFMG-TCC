@inproceedings{9272054,
 abstract = {Internet of Things (IoT) and Cloud Computing are two innovative technologies that merged to exploit their benefits. The integration of IoT and Cloud Computing is known as the CloudIoT paradigm. However, there are issues related to its application (e.g., security, privacy, legal and social aspects, heterogeneity, performance, reliability), which require tools that could assist in improving those non-functional characteristics when functioning. Also, it is necessary to consider security features when combining IoT and Cloud Computing; because there are no known methods to evaluate quality in CloudIoT applications related to security. Therefore, this paper presents a quality model and a method to evaluate the security in Cloud IoT applications aligned to ISO 25040, called CloudIoTSecurity, which is a support to assess the security step by step towards the identification of security problems and therefore the improvement of these applications. Also, an example that uses this proposal is presented to demonstrate its feasibility.},
 author = {Cedillo, Priscila and Bermeo, Alexandra and Piedra-García, David and Tenezaca-Sari, Pedro},
 booktitle = {2020 IEEE ANDESCON},
 doi = {10.1109/ANDESCON50619.2020.9272054},
 issn = {},
 keyword = {Cloud computing;Security;Computational modeling;Internet of Things;ISO Standards;Privacy;Measurement;Internet of Things;Cloud Computing;Quality Model;ISO 25010;security;privacy},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {CloudIoTSecurity: Evaluating the Security in Cloud IoT Applications},
 volume = {},
 year = {2020}
}
