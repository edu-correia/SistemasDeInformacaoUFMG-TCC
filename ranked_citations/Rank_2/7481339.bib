@inproceedings{7481339,
 abstract = {In this paper, a circularly polarized (CP) antenna with a broad axial ratio (AR) bandwidth for 60 GHz communication. The vertically polarized wave and the horizontally polarized wave are radiated by using a folded ground structure and a parasitic branch, respectively. The CP wave is completed by merging two orthogonally polarized waves. Conventional printed circuit board lamination is used to create the antenna element topology consisting of a folded ground structure and parasitic branch and then 4 × 1 array is fabricated and measured. In measured results, it is confirmed that the antenna has the AR bandwidth of 8 GHz and the peak gain of 9.5 dBic. Finally, the measured results show the good agreements with the simulated ones.},
 author = {Seungtae Ko and Kwanghyun Baek and Yoongeon Kim and Youngju Lee and Wonbin Hong},
 booktitle = {2016 10th European Conference on Antennas and Propagation (EuCAP)},
 doi = {10.1109/EuCAP.2016.7481339},
 issn = {},
 keyword = {Antenna measurements;Antenna arrays;Bandwidth;Antenna radiation patterns;Broadband antennas;Resonant frequency;circular polarization;broad AR bandwidth;folded ground;parasitic branch;60GHz communication},
 month = {April},
 number = {},
 pages = {1-3},
 title = {Circularly polarized antenna with folded ground and parasitic branch for 60GHz WLAN},
 volume = {},
 year = {2016}
}
