@conference{Stella202275,
 abstract = {In this paper, we consider applications that read sequential data from n input files and write the result into m output files, which encompasses many types of external-memory sorting, database join/group queries, and MapReduce computation. We call this I/O model bowtie streaming and develop novel algorithms for modeling its throughput, maximizing sequential run lengths, and obtaining optimal multi-pass split/merge factors under non-trivial stream-switching (i.e., seek) delay. Based on these developments, we build a platform called Tuxedo for general bowtie computation and show that it is able to perform external-memory sorting with a million times fewer attempted seeks than Hadoop and two orders of magnitude fewer than highly optimized external-memory frameworks STXXL and nsort. © 2022 IEEE.},
 author = {Stella, Gabriel and Loguinov, Dmitri},
 doi = {10.1109/BigData55660.2022.10020231},
 journal = {Proceedings - 2022 IEEE International Conference on Big Data, Big Data 2022},
 note = {Cited by: 1},
 pages = {75 - 84},
 publication_stage = {Final},
 source = {Scopus},
 title = {On High-Latency Bowtie Data Streaming},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85147899557?origin=resultslist},
 year = {2022}
}
