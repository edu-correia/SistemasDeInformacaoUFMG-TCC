@article{Shi2006272,
 abstract = {This paper discusses the semantics of human motion image from the construction of feature models. The feature models were applied in recognition and tracking by the semantics. In order to get the semantic description, how to construct the model has been discussed in this paper. Feature models were built from the labeled eigen-points of body and detecting the projection of points. A motion can be described with a definite semantic which was detected by the translocation of projections. From the translocation, the semantics was gotten from database by indexing the eigenvalue. From the basic motion semantics experiment, the result shows the course is priority to that of using image's attributes. This method also offers an idea to the complex semantics description of human motion.},
 author = {Shi, Yuexiang and Cai, Zixing and Zhu, Donghui},
 journal = {WSEAS Transactions on Computers},
 note = {Cited by: 0},
 number = {2},
 pages = {272 - 277},
 publication_stage = {Final},
 source = {Scopus},
 title = {Using feature models to present the semantic of human motion image},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33645134133?origin=resultslist},
 volume = {5},
 year = {2006}
}
