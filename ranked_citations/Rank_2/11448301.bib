@inproceedings{11448301,
 abstract = {The processing of insurance claims encounters difficulties in managing complex exceptions and fraudulent activities, frequently demanding manual investigation, which is labour-intensive and susceptible to errors. Current AI methodologies primarily concentrate on tabular data or text analysis, resulting in the absence of semantic context and interpretability. This study presents a hybrid system combining knowledge graphs and deep learning, which merges structured tabular data, textual adjuster notes, and knowledge graph embeddings to autonomously discover, classify, and analyse exception claims. The system develops a domain-specific knowledge graph, extracts multi-modal characteristics, and utilises transformer-based text encoders and graph neural networks to forecast exception types, risk severity, and root causes. A module for explainable reasoning produces actionable investigation reports based on subgraphs. Experimental evaluation on synthetic and real-world Kaggle datasets reveals exceptional performance: accuracy 0.94, recall 0.92, F1-score 0.93, ROC-AUC 0.96, RMSE 0.08, R2 0.91, and explanation fidelity 0.92. Comparisons with baseline models, such as XGBoost, BERT+MLP, and GraphSAGE, demonstrate substantial enhancements across all measures. The hybrid approach delivers superior accuracy, interpretability, and efficiency, surpassing current methodologies by combining multi-modal inputs with semantic reasoning for automated exception management in insurance workflows.},
 author = {Sudha Rani, P.R. and Amistapuram, Keerthi and Pamisetty, Vamsee and Singireddy, Sneha and Kummari, Dwaraka Nath and Sheelam, Goutham Kumar},
 booktitle = {2025 IEEE 3rd Global Conference on Wireless Computing and Networking (GCWCN)},
 doi = {10.1109/GCWCN66157.2025.11448301},
 issn = {},
 keyword = {Deep learning;Wireless communication;Accuracy;Semantics;Insurance;Knowledge graphs;Transformers;Feature extraction;Cognition;Graph neural networks;Knowledge Graph;Deep Learning;Graph Neural Networks;Transformer;Exception Detection;Insurance Claims;Multi-modal Feature Fusion;Explainable AI;Anomaly Detection;Risk Assessment;Root-Cause Analysis;Subgraph Extraction;Predictive Analytics;Investigative Reporting;Hybrid AI Framework;Semantic Reasoning;Attention Mechanism},
 month = {Nov},
