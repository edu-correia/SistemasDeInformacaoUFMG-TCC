@incollection{SUJOOD2025,
 abstract = {Technology is the driving force of modern innovation and incorporates the application of scientific knowledge for practical usage specifically in industry and day-to-day life. Wearable technology, encompassing smartwatches, health trackers, etc. is redesigning marketing by enabling data-driven, personalized customer experiences. These wearable technologies are smart electronic devices that collect, analyse, and transmit real-time data and merge convenience with connectivity. Wearable technology has now become increasingly used in customer usage to promote and strengthen marketing activities. These technologies offer an exemplary advantage to marketers in assessing human behavior, tracking daily patterns, and analysing preferences and buying choices. Sensors induced in wearable technologies give an advantage to personalized marketing, perceived relevance, and social influence of consumers towards wearables. The smooth synergy among wearables and marketing strategies allows marketers to offer immersive brand experiences, customer-companies interaction and customized content delivery. This chapter offers a comprehensive overview of how wearable technology assists as a transformative tool for marketers seeking to enhance customer engagement and brand interactions. It explores the integration of wearables into marketing, drawing on theoretical frameworks, industry examples and emerging trends.},
 author = { Sujood and Pooja Singh},
 booktitle = {Reference Module in Social Sciences},
 doi = {https://doi.org/10.1016/B978-0-443-29863-9.00009-X},
 isbn = {978-0-443-15785-1},
 keyword = {Customer engagement, Smart watches, Wearable technology, Wearable technology marketing},
 publisher = {Elsevier},
 title = {Wearable technology marketing},
 url = {https://www.sciencedirect.com/science/article/pii/B978044329863900009X},
 year = {2025}
}
