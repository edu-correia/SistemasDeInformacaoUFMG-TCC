@article{DOROSHENKO2026115795,
 abstract = {The convergence of two-dimensional (2D) inorganic nanomaterials—particularly MXenes and graphene—has opened new horizons in analytical chemistry and biomedical engineering. This review highlights the structural chemistry, synthesis strategies, and sensing mechanisms of MXene–graphene hybrids, emphasizing their inorganic foundations and medical applications. MXenes, transition metal carbides and nitrides with surface-terminated functionalities (O, –OH, F), exhibit exceptional electrical conductivity, hydrophilicity, and redox activity. When coupled with graphene's high electron mobility and mechanical strength, these hybrids form stable heterostructures with enhanced charge transport and analyte binding capabilities. Such inorganic synergy underpins their superior performance in electrochemical, chemiresistive, and optical sensors designed for detecting gases, heavy metals, biomarkers, and pathogens. In medical contexts, MXene–graphene nanocomposites have demonstrated promise in non-invasive biosensing, real-time monitoring of glucose and hormones, and early diagnosis of infectious diseases and cancers. Their tunable surface chemistry allows selective biomolecular interactions, while biocompatibility and flexibility enable integration into wearable and implantable diagnostic devices. By bridging inorganic material science with biomedical sensing, MXene–graphene systems represent a transformative class of multifunctional platforms for next-generation healthcare and environmental monitoring, offering pathways toward intelligent, miniaturized, and AI-integrated sensor technologies.},
 author = {Kateryna Mykhailivna Doroshenko and Oleksander Ivanovich Shefchenko},
 doi = {https://doi.org/10.1016/j.inoche.2025.115795},
 issn = {1387-7003},
 journal = {Inorganic Chemistry Communications},
 keyword = {MXene–graphene hybrids, Inorganic nanomaterials, Biosensing and diagnostics, Electrochemical sensors},
 pages = {115795},
 title = {From hydrothermal assembly to AI-enabled sensing: A comprehensive review of MXene merged graphene nanoplatforms for real-time detection of gases, biomarkers, and multi-analyte systems},
 url = {https://www.sciencedirect.com/science/article/pii/S1387700325019136},
 volume = {183},
 year = {2026}
}
