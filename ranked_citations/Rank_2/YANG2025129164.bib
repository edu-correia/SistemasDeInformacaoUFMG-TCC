@article{YANG2025129164,
 abstract = {Aspect sentiment triplet extraction (ASTE) is a crucial subtask of aspect-based sentiment analysis (ABSA). Each triplet consists of an aspect term, an opinion term, and the sentiment polarity of the associated aspect term. Existing approaches typically address ASTE tasks end-to-end through table-filling methods. However, these methods often fail to capture the interactions between words in the sentence and the extraction of implicit words. To overcome this limitation, we propose a multi-channel GCN network based on position-aware gating fusion (MPGF-GCN) to extract aspect sentiment triplets. We design a multi-channel GCN module integrated with aspect term extraction (ATE) and opinion term extraction (OTE) tasks. Each extraction module consists of two GCN components: a feature graph convolutional network (FGCN) and an original graph convolutional network (OGCN). The FGCN structures, combined with the refining strategy, merge adjacent nodes within each extraction module and facilitate information exchange between nodes. In addition, the model effectively integrates the aspect term and opinion term information captured by ATE and OTE through the position-aware gating fusion module (PagFM). We conducted extensive experiments on the benchmark dataset and the results demonstrate that our proposed method performed well.},
 author = {Kun Yang and Xiao Wang and Bin Gao and Linlin Li and Shutian Liu and Zhengjun Liu},
 doi = {https://doi.org/10.1016/j.neucom.2024.129164},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {Aspect sentiment triplet extraction, Multi-channel GCN network, Position-aware gating fusion, Refining strategy, Positional multi-head attention},
 pages = {129164},
 title = {Multi-channel GCN network based on position-aware gating fusion for aspect sentiment triplet extraction},
 url = {https://www.sciencedirect.com/science/article/pii/S0925231224019350},
 volume = {619},
 year = {2025}
}
