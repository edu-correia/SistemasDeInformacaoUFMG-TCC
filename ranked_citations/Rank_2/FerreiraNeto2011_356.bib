@article{FerreiraNeto2011_356,
 abstract = {This article deals with the generation and application of ontological metamodels of frameworks of best practices in IT. The ontological metamodels represent the logical structures and fundamental semantics of framework models and constitute adequate tools for the analysis, adaptation, comparison and integration of the frameworks of best practices in IT. The MetaFrame methodology for the construction of the metamodels, founded on the discipline of the conceptual metamodelling and on the extended Entity/Relationship methodology is described herein, as well as the metamodels of the best practices for the outsourcing of IT, the eSCM-SP v2.01 (eSourcing Capability Model for Service Providers) and the eSCM-CL v1.1 (eSourcing Capability Model for Client Organizations), constructed according to the MetaFrame methodology.},
 author = {Ferreira Neto, Arthur Nunes and Souza Neto, João},
 number = {3},
 pages = {619--640},
 title = {Metamodels of information technology best practices frameworks},
 volume = {8},
 year = {2011}
}
