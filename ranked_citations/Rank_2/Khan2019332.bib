@article{Khan2019332,
 abstract = {Increasing proliferation of IoT has led to an evolution of various devices for realising the smart features of ubiquitous applications. However, the inclusion of such a massive pool of devices with different computational capabilities, network protocols, hardware configurations, etc. also causes a higher number of security threats. Security professionals, organisations, and researchers are consistently investigating the security problems associated with IoT ecosystem and are coming up with different forms of solution sets. This paper presents a snapshot of the existing research work being carried out towards the security of IoT and assesses their strengths and weaknesses. The paper also explores the current research trend and presents the latest security methods being implemented and outlines the open research issues associated with it. The paper contributes to offering an accurate picture of the effectiveness of the existing security system in IoT. © 2019 Inderscience Enterprises Ltd.},
 author = {Khan, Burhan Ul Islam and Olanrewaju, Rashidah Funke and Anwar, Farhat and Mir, Roohie Naaz and Najeeb, Athaur Rahman},
 doi = {10.1504/IJICS.2019.101908},
 journal = {International Journal of Information and Computer Security},
 note = {Cited by: 11},
 number = {4-5},
 pages = {332 - 354},
 publication_stage = {Final},
 source = {Scopus},
 title = {A critical insight into the effectiveness of research methods evolved to secure IoT ecosystem},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85072247709?origin=resultslist},
 volume = {11},
 year = {2019}
}
