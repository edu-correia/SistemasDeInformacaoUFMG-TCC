@article{CANH2025281,
 abstract = {This study presents the application of the BIM&GIS integration model on Web platform for asset management. From the literature review, three main types of BIM&GIS integration models are pointed out: BIM lead - GIS support, GIS lead - BIM support, and BIM and GIS equally role and are merged by a third platform. Thereby, the characteristics and features of each type are evaluated. Then, the BIM&GIS integration model is conducted under the third type for the case study of Tan Cang station, on Metro Line 1: Ben Thanh - Suoi Tien. The observations show the BIM&GIS integration model is a useful tool in which helping project stakeholders deliver optimized decisions for management, exploitation, operation, and maintenance of the project and gradually implementing sustainable development for a smart city.},
 author = {Le Minh Canh and Vu Viet Hung and Ngo Chau Phuong},
 doi = {https://doi.org/10.1016/j.trpro.2025.03.163},
 issn = {2352-1465},
 journal = {Transportation Research Procedia},
 keyword = {BIM, GIS, integration, Smart city, Metro Line 1, Tan Cang station},
 note = {TRPRO_SDCAT 2023},
 pages = {281-288},
 title = {Integration of BIM and GIS on web viewer environment for Tan Cang station asset management},
 url = {https://www.sciencedirect.com/science/article/pii/S2352146525002224},
 volume = {85},
 year = {2025}
}
