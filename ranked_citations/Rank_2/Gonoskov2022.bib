@article{Gonoskov2022,
 abstract = {In particle-in-cell simulations and some other statistical computations, the representation of modelled distributions with tracked macro-particles can become locally excessive. Merging or resampling dense clusters or highly-populated phase space volumes may, however, remove or affect small-scale peculiarities in the modelled distribution or cause local changes of conserved quantities, such as energy and momenta. This may lead to additional noise, reduced accuracy or even unphysical effects. Here we describe a probabilistic algorithm for reducing the number of macro-particles in such clusters or volumes so that all the distribution functions are not affected on average and an arbitrary number of conservation laws, distribution central moments and contributions to the grid quantities (such as charge and current density) are preserved. © 2021 The Author},
 author = {Gonoskov, A.},
 doi = {10.1016/j.cpc.2021.108200},
 journal = {Computer Physics Communications},
 note = {Cited by: 14; All Open Access; Green Open Access; Hybrid Gold Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Agnostic conservative down-sampling for optimizing statistical representations and PIC simulations},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85127069122?origin=resultslist},
 volume = {271},
 year = {2022}
}
