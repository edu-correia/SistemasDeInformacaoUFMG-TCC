@inproceedings{4811273,
 abstract = {Previously, authors proposed a method for taking the appropriate images of written area on the blackboard. In the method, the blackboard is segmentalized into several areas and template matching method is used to acquire the high-resolution images of the written area. It is however, difficult to acquire appropriate rules or search areas for template matching method. This makes decision of template size and matching areas more difficult with high accuracy. This paper proposes a new method to merge the blackboard sub image automatically by using Evolutionary Computation.},
 author = {Naganawa, Yuki and Kawanaka, Hiroharu and Tsuruoka, Shinji},
 booktitle = {2008 IEEE International Conference on Systems, Man and Cybernetics},
 doi = {10.1109/ICSMC.2008.4811273},
 issn = {1062-922X},
 keyword = {Genetic algorithms;Electronic learning;Cameras;Character recognition;Image resolution;Genetic engineering;Computer networks;Videos;Multimedia databases;Image segmentation;Genetic Algorithm;Template Matching;Image Based e-Learning System},
 month = {Oct},
 number = {},
 pages = {191-196},
 title = {A study on image merge method using genetic algorithm for image based e-learning system},
 volume = {},
 year = {2008}
}
