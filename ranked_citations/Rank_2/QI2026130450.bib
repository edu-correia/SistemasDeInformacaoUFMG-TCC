@article{QI2026130450,
 abstract = {The advent of depth cameras has significantly advanced various computer vision tasks, with plane detection being a fundamental application. Plane structures are ubiquitous in everyday environments, and their accurate detection is crucial for vision-based tasks such as robotic navigation. The DPD algorithm, proposed by Jin, Tillo, Zou, and Li (2019), has demonstrated outstanding performance in planar detection tasks that rely exclusively on depth maps as input. DPD initializes the detection process with a sufficient number of small seed patches, which subsequently expand to form the final plane detection results. Although this growth-based approach achieves high accuracy, it incurs substantial computational costs. In this paper, we have addressed and overcome a number of significant challenges of parallelizing the growth process in DPD and propose a novel method, Parallel DPD (PDPD), which enables all seed patches to expand concurrently. The proposed approach reduces the computational time for plane detection by up to two orders of magnitude while preserving the superior detection performance of DPD. The code is available at https://github.com/qcy1024/PDPD.},
 author = {Chenyu Qi and Wanli He and Shu Chen},
 doi = {https://doi.org/10.1016/j.eswa.2025.130450},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Plane detection, Region growing, Taichi},
 pages = {130450},
 title = {Parallel growth-based plane detection using depth information},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417425040655},
 volume = {301},
 year = {2026}
}
