@inproceedings{9649357,
 abstract = {The paper considers cardiac arrhythmias analysis methods starting with electrocardiogram (ECG) signal splitting into cycles, and finishing with the formation of the arrhythmias types sequence. The input data for the analysis are the results of splitting the ECG-signal into cycles. It is suggested to use a modification of Cobweb method for clustering of QRS-complexes of ECG-signals. Formation of arrhythmias dictionary based on sequential analysis (n-gram method) of ECG rhythm in the text form is described. Linguistic analysis for arrhythmia type classification is proposed. The examples of analysis of the ECG-signal record from MIT-BIH arrhythmia database are given. The proposed methods were tested in an integration mode with Holter system.},
 author = {Menlitdinov, Alexey and Korobeynikov, Alexander and Stepanov, Vladimir and Kuzelin, Yuri},
 booktitle = {2021 International Conference on Information Technology and Nanotechnology (ITNT)},
 doi = {10.1109/ITNT52450.2021.9649357},
 issn = {},
 keyword = {Training;Sequential analysis;Dictionaries;Databases;Text recognition;Electrocardiography;Linguistics;Cardiac arrhythmias;linguistic analysis;sequential analysis;n-gram method;Cobweb clustering},
 month = {Sep.},
 number = {},
 pages = {1-5},
 title = {Cardiac Arrhythmias Detection Based on Sequential and Linguistic Analysis},
 volume = {},
 year = {2021}
}
