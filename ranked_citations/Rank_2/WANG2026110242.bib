@article{WANG2026110242,
 abstract = {Aiming at the problem of plastic-toughness deterioration caused by softening of heat-affected zone (HAZ) during laser repair of ultra-high-strength steel parts, this study systematically explored the microstructure evolution law and mechanical property response mechanism of hot roll bending parts during laser cladding by combining laser cladding repair experiment with tempering heat simulation experiment. The strength of the repaired joint is only 50.3 % of that of the substrate, the highest strength is 975 MPa, and the elongation is reduced to 1.9–4.2 %. The fracture occurs at the junction of incompletely quenched zone and tempered zone of the HAZ. The tempering softening process sequentially undergoes carbide precipitation, lath merging and cementite coarsening, and ferrite recrystallization. 450–550 ℃ is the softening sensitive range, which is attributed to the decrease in dislocation density, the increase in the proportion of high-angle grain boundaries, and the decrease in variant density. As the tempering temperature increases, the fracture behavior changes, and the impact energy increases due to the enhanced plastic deformation capacity and the extension of the crack propagation path. An innovative non-isothermal tempering softening kinetic model based on the JMAK equation is proposed, which quantitatively reveals the exponential influence of peak temperature and heat input on the softening rate. This study provides a theoretical basis for the optimization of process parameters and performance regulation of laser repair of high-strength steel parts.},
 author = {Shuwen Wang and Shujun Chen and He Shan and Pengjing Zhao and Zhongmin Xiao and Tao Yuan},
 doi = {https://doi.org/10.1016/j.engfailanal.2025.110242},
 issn = {1350-6307},
 journal = {Engineering Failure Analysis},
 keyword = {Ultra-high strength steel, Laser cladding repair, Microstructural evolution, Mechanical properties, Tempering softening},
 pages = {110242},
 title = {Analysis of plastic-toughness changes of high-strength steel parts repaired by laser cladding via tempering heat simulation},
 url = {https://www.sciencedirect.com/science/article/pii/S1350630725009835},
 volume = {183},
 year = {2026}
}
