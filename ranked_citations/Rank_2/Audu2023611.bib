@article{Audu2023611,
 abstract = {Feature extraction is an essential aspect of data analysis of EEG signals for identifying patterns of seizure onset. The amount, nature and type of information contain in a selected feature is a central problem in developing machine learning-based algorithms for predicting the onset of seizures. In this paper, we develop a numerical approach based on Newton-Gregory interpolation and Simpson's integral approximation methods to compute the energy density of each of the frequency bands of interest. Five (5) level Debauches (discrete) wavelet (db4) is employed to decompose (filter) 256 Hz EEG signals into Delta (0–4 Hz), Theta (4–8 Hz), Alpha (8–13 Hz) and Beta (13–40 Hz) frequency bands. An EEG epoch is processed into a set of maxima points. The algorithm computes the energy density by considering the area under the curve formed by the selected maxima points. The results show a correlation between energy density and the number of maxima points in an EEG Epoch (data sample). The result agrees with the Parseval method of computing the energy of a signal. © 2023, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
 author = {Audu, Eliazar Elisha and Garg, Lalit},
 doi = {10.1007/978-3-031-31153-6_49},
 journal = {Lecture Notes in Networks and Systems},
 note = {Cited by: 0},
 pages = {611 - 625},
 publication_stage = {Final},
 source = {Scopus},
 title = {The Numerical Estimation of Spectral Energy Density in Electroencephalogram (EEG)},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85161140623?origin=resultslist},
 volume = {671 LNNS},
 year = {2023}
}
