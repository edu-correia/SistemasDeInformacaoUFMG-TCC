@inproceedings{10276846,
 abstract = {The digital filter bank's configurability makes it perfect for signal reconstruction in hearing aids, but the non-ideal characteristics often make the reconstruction effect unsatisfactory. In this paper, we propose a novel fast filter bank (FFB)-based signal reconstruction structure. Using synthesis fast filter bank (SFFB) in hearing aids audio systems, this structure can achieve the unification of both low complexity and good frequency response characteristics. The proposed low complexity FFB-based signal reconstruction structure has the merging ability of adjacent sub-channels that the polyphase filter bank structure is missing. The simulation results show that the proposed FFB-based signal reconstruction structure has a low structural complexity, a small reconstruction error, good reconstruction performance, and is suitable for hearing aids.},
 author = {Zhao, Xiao-Qi and Zhang, Wen-Xu},
 booktitle = {2023 International Conference on Microwave and Millimeter Wave Technology (ICMMT)},
 doi = {10.1109/ICMMT58241.2023.10276846},
 issn = {},
 keyword = {Microwave technology;Simulation;Millimeter wave technology;Filter banks;Prototypes;Hearing aids;Signal reconstruction},
 month = {May},
 number = {},
 pages = {1-3},
 title = {The Design of Low Complexity Filter Bank based on FFB for Hearing Aids},
 volume = {},
 year = {2023}
}
