@inproceedings{1000838,
 abstract = {Summary form only given. The shared pole in a merged recording head design serves as the reader shield and a part of the writer circuit. A good shared pole design should provide permeable path to the write flux, efficiently shield the reader from adjacent recorded transitions and prevent magnetic coupling between the reader and writer. This paper reports the feasibility of using Al/sub 2/O/sub 3/ as the nonmagnetic and non-conducting spacer in a trilayer shared pole structure of type - NiFe/Al/sub 2/O/sub 3/ (x)/NiFe, with x = 0.1-1.0 /spl mu/m. The shared pole structure was integrated into head design and its effect on head stability and performance was studied.},
 author = {Sharma, N. and Johnston, A. and O'Kane, C. and Macken, D.},
 booktitle = {2002 IEEE International Magnetics Conference (INTERMAG)},
 doi = {10.1109/INTMAG.2002.1000838},
 issn = {},
 keyword = {Magnetic heads;Magnetic flux;Magnetic shielding;Probes;Magnetic domains;Disk recording;Space technology;Stability;Magnetic domain walls;Drives},
 month = {April},
 number = {},
 pages = {BP5-},
 title = {Effect of alumina spacer in trilayer shared pole structures in GMR recording heads},
 volume = {},
 year = {2002}
}
