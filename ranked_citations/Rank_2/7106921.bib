@inproceedings{7106921,
 abstract = {The increasing amount of ubiquitous devices and the ongoing convergence of Internet of Things related application domains, like Smart Homes or Ambient Assisted Living, make it difficult for device integration solutions to cover a comprehensive set of devices while paying respect to resource constraints. Moreover, device integration has to be merged with device abstraction mechanisms, in order to hide the complexity of the physical device layer from the application layer and reduce the effort required to develop useful applications. The OSGi based device integration middleware we will present, combines a modular integration approach, that allows to load and deploy required integration knowledge from Cloud repositories on demand, with a category based abstraction mechanism that simplifies application development by hiding device control logic.},
 author = {Kliem, Andreas and Köner, Marc and Weißenborn, Sören and Byfield, Marvin},
 booktitle = {2015 IEEE Tenth International Conference on Intelligent Sensors, Sensor Networks and Information Processing (ISSNIP)},
 doi = {10.1109/ISSNIP.2015.7106921},
 issn = {},
 keyword = {Protocols;Switches;Bluetooth;Middleware;Logic gates;Servers;Runtime;Device integration;device management;device abstraction;interoperability;plug-and-play;OSGi;smart home;online reconfiguration;protocol agnostic},
 month = {April},
 number = {},
 pages = {1-7},
 title = {The Device Driver Engine - Cloud enabled ubiquitous device integration},
 volume = {},
 year = {2015}
}
