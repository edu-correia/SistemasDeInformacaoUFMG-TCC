@inproceedings{10723884,
 abstract = {The content of this paper describes a novel CNN-Transformer hybrid model that detects, classifies, and differentiates focal liver lesions into various categories using contrast-enhanced ultrasound (CEUS). A model, a harmonious convolutional neural network (CNN) integration and a decoder enable us to achieve a tremendous diagnostic performance (AUC of 0.8237 and an accuracy of 0.78). It outperforms the conventional baseline models. Merging local and global patio-temporal data aids the model designed for FLL categorizing. It allows the model to detect early at diagnosis and improves diagnostic confidence. The proposed methodology may do away with the previous health care practices that were heavy and complicated yet bring back the desired patient outcomes. Future studies should be oriented towards understanding the technology better, specifically its usability, and conducting clinical validation trials. Another element should be studied to determine its suitability for different medical imaging techniques. Efficient CNN-Transformer architecture is a significant milestone in developing an efficient liver cancer detection method that might become a robust clinical practice tool allowing emerging precision medicine.},
 author = {Vats, Satvik and Singh, Choudhary Ravi and Mehta, Shiva},
 booktitle = {2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)},
 doi = {10.1109/ICCCNT61001.2024.10723884},
 issn = {2473-7674},
 keyword = {Frequency locked loops;Liver cancer;Ultrasonic imaging;Accuracy;Computational modeling;Liver;Lesions;Convolutional neural networks;Usability;Biomedical imaging;Liver cancer diagnosis;Focal liver lesions;Contrast-enhanced ultrasound (CEUS);Convolutional Neural Networks (CNNs);Transformers;Hybrid models},
 month = {June},
 number = {},
 pages = {1-5},
 title = {Next-Generation Diagnostic Tools: The Role of Hybrid CNN-Transformer Models in Liver Cancer Detection},
 volume = {},
 year = {2024}
}
