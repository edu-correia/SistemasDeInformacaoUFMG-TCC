@inproceedings{9039897,
 abstract = {Internet of Things (IoT) has become a very popular concept in the last decade, which deals with strongly distributed devices, whose merge brought their potential up to a new level. The concept of the Intelligent Space (IS) represents another means for processing distributed networks of devices, whose importance has grown together with the rise of ubiquitous robotics. Although these two concepts are similar but not equivalent. To better understand their properties we performed their comparison and proposed a way of their merge by extending IS with the so-called IoT tools. Such a combined system enables to interconnect indoor and outdoor applications. As these concepts fulfil the definition of complex systems they require also their advanced management. In our paper, we used the so-called Fuzzy Cognitive map (FCM) because of its user-friendly knowledge representation and possibility to capture all relevant relations for controlling these systems. Besides, a special library written in Python with various functionalities is presented here. Obtained experience with FCMs shown on a navigation example confirms their potential and therefore, new research directions are outlined.},
 author = {Vaščák, Ján and Papcun, Peter and Zolotová, Iveta and Puheim, Michal},
 booktitle = {2020 Cybernetics & Informatics (K&I)},
 doi = {10.1109/KI48306.2020.9039897},
 issn = {},
 keyword = {Navigation;Predictive models;User interfaces;Programming;Libraries;Internet of Things;Complex systems;fuzzy cognitive map;intelligent space;internet of things;python programming library},
 month = {Jan},
 number = {},
 pages = {1-6},
 title = {Intelligent Space Design for Robotic and IoT Applications},
 volume = {},
 year = {2020}
}
