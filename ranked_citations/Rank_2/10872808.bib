@article{10872808,
 abstract = {Phosphor-coated white LEDs have become the predominant lighting technology thanks to their energy efficiency. In recent years, interest in visible light communications (VLC) technology has grown to take advantage of the massive deployment of these lighting LEDs for data transmission. In this context, these LEDs have two major limitations: limited modulation bandwidth and nonlinear behavior. Extending signal modulation beyond these limitations is crucial for achieving the transmission rates necessary to make this technology competitive. To support the further development of these systems, this paper introduces an integrated model that merges dynamic nonlinear and linear system approaches to simulate accurately data transmission with LEDs. It combines a dynamic nonlinear model, which captures complex behaviors under high-speed modulation, with a linear model for high luminous flux LEDs. Experimental validation confirms the precision of the model, with less than 5% error in predicting power spectrum and throughput using OFDM signaling, highlighting its utility for designing VLC systems that utilize LEDs for both illumination and data transmission.},
 author = {Salvador, Pau and Corral, Juan Luis and Valls, Javier and Almenar, Vicenç and Canet, Maria Jose and Linnartz, Jean-Paul},
 doi = {10.1109/JLT.2025.3538750},
 issn = {1558-2213},
 journal = {Journal of Lightwave Technology},
 keyword = {Light emitting diodes;Data models;OFDM;Bandwidth;Lighting;Mathematical models;Phosphors;Nonlinear distortion;Voltage measurement;Throughput;Nonlinear model;VLC;white LEDs},
 month = {May},
 number = {9},
 pages = {4098-4105},
 title = {Dynamic Nonlinear Model of High Luminous Flux Phosphor-Coated White LEDs for VLC},
 volume = {43},
 year = {2025}
}
