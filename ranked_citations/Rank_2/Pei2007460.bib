@article{Pei2007460,
 abstract = {Generating concept lattice is investigated for long years. Whether formal concepts and concept lattice can be generated in topological space for objects set G or attributes set M of a formal context F = (G, M, I) is an interesting problem. In this paper, our discussions are concentrated on constructing a topology for M of F, the topology is generated by an approximation space on M. Then there exists one-toone mapping between the approximation space on M and the topology for M, and it is obtained that attributes of each formal concept is open set in the topological space. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Pei, Zheng and Qin, Keyun},
 doi = {10.1007/978-3-540-72458-2_57},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 5},
 pages = {460 - 467},
 publication_stage = {Final},
 source = {Scopus},
 title = {Topological space for attributes set of a formal context},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/37249002338?origin=resultslist},
 volume = {4481 LNAI},
 year = {2007}
}
