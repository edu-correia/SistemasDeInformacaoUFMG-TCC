@inproceedings{9613197,
 abstract = {Coronary angiography is the gold standard for diagnosing coronary artery disease. Accurately detecting vessels and classifying vascular stenosis through coronary angiography can increase the accuracy of doctors diagnosis. This article reviews the recent development in this field, introduces the coronary angiography datasets, summarizes the evaluation metrics and outlines non-deep learning methods and deep learning methods of vessel segmentation and stenosis classification. Non-deep learning methods include thresholding methods, region growing and region merging methods, deformation model methods, tracking methods and graph-based methods. Deep learning methods include supervised deep learning methods, weakly supervised deep learning methods. Vessel segmentation methods and stenosis classification methods based on the semi-supervised learning and the few-shot learning will become research hotspots.},
 author = {Zhou, Ying and Guo, Haopan and Song, Jiarui and Chen, Yan and Wang, Jinjia},
 booktitle = {2021 13th International Conference on Wireless Communications and Signal Processing (WCSP)},
 doi = {10.1109/WCSP52459.2021.9613197},
 issn = {2472-7628},
 keyword = {Deep learning;Measurement;Wireless communication;Angiography;Supervised learning;Semisupervised learning;Signal processing;coronary angiography;vessel segmentation;stenosis classification;deep learning;supervised learning;weakly supervised learning},
 month = {Oct},
 number = {},
 pages = {1-5},
 title = {Review of Vessel Segmentation and Stenosis classification in X-ray Coronary Angiography},
 volume = {},
 year = {2021}
}
