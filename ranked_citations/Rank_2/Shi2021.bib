@article{Shi2021,
 abstract = {Connected and automated vehicles (CAVs) are a very promising alternative for reducing fuel consumption and improving traffic efficiency when vehicles merge at on-ramps. In this study, we propose a graph-based method to coordinate CAVs to merge at the highway ramp. First, the optimized vehicles were divided into groups to pass the merging point. Then we built a directed graph model for each group of vehicles, where each path of the graph corresponds to one of all possible merging sequences. The improved shortest path algorithm is proposed to find the optimal merging sequence for minimizing total fuel consumption. The results of the simulation showed that the proposed graph-based method reduced fuel consumption and ensured high traffic efficiency; moreover, the vehicles can form a platoon after passing the merge point. © 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
 author = {Shi, Yanjun and Yuan, Zhiheng and Yu, Hao and Guo, Yijia and Qi, Yuhan},
 doi = {10.3390/machines9110290},
 journal = {Machines},
 note = {Cited by: 7; All Open Access; Gold Open Access; Green Open Access},
 number = {11},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A graph-based optimal on-ramp merging of connected vehicles on the highway},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85119891371?origin=resultslist},
 volume = {9},
 year = {2021}
}
