@conference{Siddharth20251268,
 abstract = {Product catalog organization has grown to be a significant difficulty due to the quick expansion of online marketplaces. In addition to providing accurate search results, trustworthy categorization is also necessary to support recommendation engines and enhance the general purchasing experience. We present a multimodal deep learning approach, in this study that uses a fusion-based model to merge structured attribute information with product images. To handle noisy and incomplete metadata, we apply preprocessing steps such as one-hot encoding and class balancing, while convolutional neural networks (CNNs) are used to extract rich visual features. Our experiments show that the fusion model consistently outperforms image-only and attribute-only baselines, reaching 84.2% ± 2.1 test accuracy and a macro F1-score of 0.87 across five folds. Techniques like dropout, batch normalization, and data augmentation helped the model generalize better and avoid overfitting. Overall, the results demonstrate that combining multiple modalities improves both accuracy and fairness across imbalanced categories, making the method well suited for large-scale e-commerce catalog management.  © 2025 IEEE.},
 author = {Siddharth, Dangeti and Sariki, Tulasi Prasad},
 doi = {10.1109/ICSCN67106.2025.11308524},
 journal = {Proceedings of International Conference on Sustainable Communication Networks and Application, ICSCN 2025},
 note = {Cited by: 0},
 pages = {1268 - 1273},
 publication_stage = {Final},
 source = {Scopus},
 title = {Fusion-based Multimodal Deep Learning for E-commerce Product Attribute Classification},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105032744843?origin=resultslist},
 year = {2025}
