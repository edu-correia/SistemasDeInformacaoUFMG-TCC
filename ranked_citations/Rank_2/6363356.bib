@inproceedings{6363356,
 abstract = {In this project, the main focus is to apply image processing techniques in computer vision to agricultural mobile robots (AMR) used for trajectory navigation problems, as well as localization matters. To carry through this task, computational methods based on the JSEG algorithm were used to provide the classification and the characterization of such problems, together with Artificial Neural Networks (ANN) for pattern recognition. Therefore, it was possible to run simulations and carry out analyses of the performance of JSEG image segmentation technique through Matlab/Octave platforms, along with the application of customized Back-propagation algorithm and statistical methods as structured heuristics methods in a Simulink environment. Having the aforementioned procedures been done, it was practicable to classify and also characterize the HSV space color segments, not to mention allow the recognition of patterns in which reasonably accurate results were obtained.},
 author = {Lulio, Luciano C. and Tronco, Mario L. and Porto, Arthur J. V.},
 booktitle = {2012 Brazilian Robotics Symposium and Latin American Robotics Symposium},
 doi = {10.1109/SBR-LARS.2012.52},
 issn = {},
 keyword = {Image segmentation;Image color analysis;Classification algorithms;Artificial neural networks;Navigation;Educational institutions;Pattern recognition;pattern recognition;image segmentation;mobile robots;computer vision},
 month = {Oct},
 number = {},
 pages = {279-283},
 title = {Cognitive-Merged Statistical Pattern Recognition Method for Image Processing in Mobile Robot Navigation},
 volume = {},
 year = {2012}
}
