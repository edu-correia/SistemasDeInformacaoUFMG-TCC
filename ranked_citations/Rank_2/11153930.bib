@article{11153930,
 abstract = {A single-fed dual-band antenna with orthogonal circular polarizations (CPs) and filtering responses in it is two bands is proposed for Internet of Vehicles (IoV) communications. To suppress unwanted out-of-band signals, a folded stepped-impedance aperture is integrated to achieve dual-band filtering response, while maintaining a simple structure without adding filtering circuits. In addition, a dual-branch feedline is adopted to improve impedance matching and filtering response of the antenna efficiently. Moreover, a merged structure technique of modified dielectric resonator (DR) and slot aperture is employed to overcome the challenge of single-fed orthogonal CP waves in the two bands, enabling low-interchannel crosstalk for compact vehicular wireless systems. A phase control method is studied for independent control of orthogonal CPs in the two bands. Subsequently, the CP performance and radiation gain are further improved by the modified DR for robust links. For demonstration, an antenna prototype is designed and fabricated, operating in the bands of 1.75 and 2.6 GHz with left-handed CP (LHCP) and right-handed CP (RHCP), respectively. The measured results show reasonable agreement with the simulated ones. With the merits of high-integration, multifunction, simple structure, and compact size, the proposed antenna can be an attractive candidate for IoV communication systems.},
 author = {Xu, Hao and Xu, Kai-Da},
 doi = {10.1109/JIOT.2025.3608034},
 issn = {2327-4662},
 journal = {IEEE Internet of Things Journal},
 keyword = {Filtering;Antennas;Dual band;Apertures;Wireless communication;Substrates;Impedance;Antenna feeds;Resonance;Geometry;dielectric resonator (DR) antenna;dual-band;filtering antenna;Internet of Vehicles (IoV);orthogonal circular polarizations (CPs)},
 month = {Nov},
 number = {22},
 pages = {48441-48450},
 title = {A Single-Fed Dual-Band Orthogonal Circularly Polarized Filtering Antenna for 5G-Enabled IoV Applications},
 volume = {12},
 year = {2025}
}
