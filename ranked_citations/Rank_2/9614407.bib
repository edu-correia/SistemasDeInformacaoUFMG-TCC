@inproceedings{9614407,
 abstract = {A low profile dielectric resonator antenna (DRA) with wide impedance bandwidth is proposed by introducing the air regions. This proposed DRA is fed by two symmetrical slots. The DRA modes can be excited and merged to broaden the impedance bandwidth by inserting air regions insider the DRA. This DRA can achieve impedance bandwidth of 45.8% covering the frequency band of 3.2-5.1GHz. At the same time, it has very low profile of about 0.07λ0. A relatively stable gain is obtained around 6.25 dBi.},
 author = {Liu, Ying and Li, Xu Wang and Zhou, Changfei and Li, Hui and Guo, Lei},
 booktitle = {2021 International Symposium on Antennas and Propagation (ISAP)},
 doi = {10.23919/ISAP47258.2021.9614407},
 issn = {},
 keyword = {Resonant frequency;Bandwidth;Dielectric resonator antennas;Dielectrics;Broadband communication;Impedance;Broadband antennas;dielectric resonator antenna;multiple-layer structure;multiple modes;wide bandwidth;low profile},
 month = {Oct},
 number = {},
 pages = {1-2},
 title = {Low-Profile and Broadband Dielectric Resonator Antenna By Using Air Regions},
 volume = {},
 year = {2021}
}
