@article{LI2025107340,
 abstract = {The technique of thyroid nodule segmentation plays a significant role in diagnosing thyroid disorders. However, accurate segmentation of thyroid nodules is an extremely challenging task for two major reasons: (1) the diversity in size, shape and texture of the nodules, and (2) the ambiguous edges of the nodules. To address these issues, we propose a Global Structure Enhancement decoder and further combine different encoders to construct a set of segmentation networks named GSE-Nets. Specifically, we first design a Structure Cross-Attention (SCA) module that compensates for the lack of high-level semantic features in terms of low-level structural information such as edges and textures by modulating the Transformer’s self-attention mechanism. The SCA module accomplishes this by assigning the last three high-level features of the encoder as queries and the lowest-level feature as key and value. We also propose a lightweight graph convolution block to globally interact information on the enhanced features to improve amorphous thyroid nodule features. We further introduce a feature refinement attention module to filter task-irrelevant feature information for reducing subsequent decoding interference. Finally, a feature merging module is designed for iteratively generating high-resolution semantic maps. To demonstrate the effectiveness of our proposed method, extensive comparative experiments with various models are evaluated on three thyroid nodule ultrasound image datasets. Our GSE-Nets achieve the best Dice coefficients (by 89.85%, 83.52%, and 81.97%) and IoU scores (by 81.60%, 71.71%, and 72.24%) on the TUD, DDTI, and TN3K datasets, respectively, which can improve the localization of thyroid nodules with different shapes.},
 author = {Xiang Li and Chong Fu and Qun Wang and Wenchao Zhang and Chen Ye and Tao Ma},
 doi = {https://doi.org/10.1016/j.bspc.2024.107340},
 issn = {1746-8094},
 journal = {Biomedical Signal Processing and Control},
 keyword = {Thyroid nodule segmentation, Global Structure Enhancement, Structure Cross-Attention},
 pages = {107340},
 title = {GSE-Nets: Global Structure Enhancement decoder for thyroid nodule segmentation},
 url = {https://www.sciencedirect.com/science/article/pii/S1746809424013983},
 volume = {102},
 year = {2025}
}
