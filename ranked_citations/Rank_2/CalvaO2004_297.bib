@article{CalvaO2004_297,
 abstract = {This work is the result of a group effort that follows the idea that we can build some of the laboratory equipment that is commonly found in our country labs. Here we mention the need of integration of many workgroups from many areas of expertise. This is a special work because here we are presenting some of the steps needed to build a laboratory electronic equipment from the product engineering perspective, the problems that we have found and how we dealt with them.},
 author = {Calva O., G. and Pérez S., J.L. and Juárez A., J.L. and Pérez L., S.},
 number = {3},
 pages = {236--248},
 title = {Product engineering of a laboratory electronic equipment},
 volume = {2},
 year = {2004}
}
