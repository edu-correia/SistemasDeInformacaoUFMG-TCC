@inproceedings{11387836,
 abstract = {While modern medicine has progressed through rigorous experimentation and technological advancement, traditional healing systems like Ayurveda—particularly Marma therapy—remain underexplored in terms of empirical validation and intelligent system design. Marma therapy, based on the stimulation of vital energy points, offers significant potential for non-invasive wellness solutions but lacks standardized, technology-assisted implementations. This paper presents the conceptual development of a personalized therapeutic system that integrates artificial intelligence, computer vision, and embedded control with the principles of Marma therapy. The system begins by collecting user inputs or inferred symptom data, followed by AI-driven mapping of relevant Marma points and identification of the corresponding body region. A vision-based scanning module localizes precise Marma point locations tailored to individual anatomy. Based on the therapeutic goal, the system recommends suitable stimulation methods—including vibration, press-release, kneading motions, thermal applications (hot/cold), and low-intensity electrical pulses. After user confirmation, adaptive stimulation is applied in a controlled and gradually intensifying manner, with real-time feedback and safety controls. The visual interface assists the user throughout the session and concludes with a report that includes stimulation summary and personalized dosage recommendations. This work demonstrates the potential of merging ancient therapeutic wisdom with modern intelligent technologies to create accessible, safe, and user-centric wellness systems. The system's design and early simulations indicate its feasibility for applications in chronic pain management, stress relief, and personalized home-based care.},
 author = {Hariani, Ritesh and Shingare, Pratibha and Bartakke, Prashant and Kolhare, Neelima and Kapse, Yogita},
 booktitle = {2025 IEEE 3rd International Symposium on Sustainable Energy, Signal Processing and Cybersecurity},
 doi = {10.1109/iSSSC66652.2025.11387836},
 issn = {},
 keyword = {Location awareness;Vibrations;Computer vision;Visualization;Medical treatment;Signal processing;Real-time systems;Safety;System analysis and design;Stress;Marma Therapy;Energy Point Localization;Computer Vision in Healthcare;AI-Assisted Therapeutic Systems;Embedded Health Technology},
 month = {Nov},
