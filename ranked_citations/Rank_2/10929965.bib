@inproceedings{10929965,
 abstract = {In this paper, a lightweight multi-path ViT network is proposed. To reduce computational complexity and model size, the cross-block (C-B) and cross-stage (C-S) structures are developed according to the split-and-merge strategy. In addition, Cross-shape Windows Self-Attention (CSW-SA) is also used in the first stage to decrease computational complexity. To evaluate the performance of the proposed ViT network, two image datasets, Bird-325 [1] and Brain Tumor MRI [2], were chosen for testing. As for computational complexity, FLOPs of iFormer-S and the proposed encoder are 5.9G and 1.67G, respectively. For model size, the parameters of iFormer and the proposed encoder have 18.97M and 5.22M, respectively. For image classification tasks, the accuracy, precision, recall of the proposed ViT network are at least more than 97.5% on the two datasets. The experimental results show that the proposed ViT method can not only perform good feature extraction but also outperform the existing methods in terms of accuracy, precision, recall, FLOPs, and model size.},
 author = {Chou, Wen-Ling and Lin, Hsiu-Ming and Lin, Guo-Shiang and Hung, Nguyen Phi},
 booktitle = {2025 IEEE International Conference on Consumer Electronics (ICCE)},
 doi = {10.1109/ICCE63647.2025.10929965},
 issn = {2158-4001},
 keyword = {Computer vision;Accuracy;Computational modeling;Magnetic resonance imaging;Brain modeling;Transformers;Feature extraction;Computational complexity;Image classification;Testing;Vision transformer;Split-and-merge strategy;Self-attention mechanism},
 month = {Jan},
