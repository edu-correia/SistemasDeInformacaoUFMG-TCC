 issn = {},
 keyword = {Solid modeling;Three-dimensional displays;Metaverse;Smart cities;Urban planning;Ecosystems;Data models;Digital twins;Stakeholders;Artificial intelligence;metaverse;digital twin cities;meta-city;prototype platform;application scenes;AI},
 month = {Dec},
