@conference{Freund2012,
 abstract = {The paper presents an agent-based scheduling and energy management system for a smart distribution feeder which is installed on a test site and includes an electric car sharing fleet. Distributed Energy storage systems provide flexibility in the operation of the test site, where the integration of multiple power sources including Renewable Energy Sources and Distributed Generators is implemented. A software agent control architecture is introduced, which is divided into distinct subsystems in order to consider market roles of the Micro Smart Grid Operator, Car Sharing Operator and Distribution System Operator. Within this architecture, an optimization mechanism with the objective to maximize the utilization of Renewable Energy Sources for charging the electric vehicles is implemented and the functionality of the agent-based system is tested in response to a basic electric vehicle booking and charging scenario. © 2012 IEEE.},
 author = {Freund, Daniel and Raab, Andreas F. and Kuster, Tobias and Albayrak, Sahin and Strunz, Kai},
 doi = {10.1109/ISGTEurope.2012.6465889},
 journal = {IEEE PES Innovative Smart Grid Technologies Conference Europe},
 note = {Cited by: 16},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Agent-based integration of an electric car sharing fleet into a smart distribution feeder},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84874706350?origin=resultslist},
 year = {2012}
}
