@article{Palmieri20134360,
 abstract = {We show how to use a discrete-variable factor graph for learning non-linear continuous functions from examples. The paper proposes a scheme for embedding soft quantization in a probabilistic Bayesian graph. The quantized input variables are grouped into a compound variable that is mapped through a stochastic matrix into the discrete output distribution. Specific output values are then obtained through a process of de-quantization. The information flow carried by message propagation is bi-directional and an algorithm for learning the factor graph parameters is explicitly derived. The model, that can easily merge discrete and continuous variables, is demonstrated with examples and simulations. © 2013 IEEE.},
 author = {Palmieri, Francesco A. N.},
 doi = {10.1109/TSP.2013.2270463},
 journal = {IEEE Transactions on Signal Processing},
 note = {Cited by: 10},
 number = {17},
 pages = {4360 - 4371},
 publication_stage = {Final},
 source = {Scopus},
 title = {Learning non-linear functions with factor graphs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84896745642?origin=resultslist},
 volume = {61},
 year = {2013}
}
