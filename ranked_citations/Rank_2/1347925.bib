@inproceedings{1347925,
 abstract = {With continuous down-scaling of minimum feature sizes and increasing of chip areas, buffering has become a necessary technique to control the interconnect delays in VLSI chips. Recently, Shi and Li proposed an efficient O(n log n) time algorithm to speed up buffering. Based on balanced binary search trees, their algorithm showed superb performance with the most unbalanced sizes of merging solution lists. We propose in this paper a more flexible data structure for the same buffering operations. With parameters to adjust, our algorithm works better than Shi and Li under all cases: unbalanced, balanced, and mix sizes. Our data structure is also simpler than theirs.},
 author = {Ruiming Chen and Hai Zhou},
 booktitle = {IEEE International Conference on Computer Design: VLSI in Computers and Processors, 2004. ICCD 2004. Proceedings.},
 doi = {10.1109/ICCD.2004.1347925},
 issn = {1063-6404},
 keyword = {Data structures;Merging;Binary search trees;Binary trees;Delay;Tree data structures;Very large scale integration;Dynamic programming;Size control;Fabrication},
 month = {Oct},
 number = {},
 pages = {216-221},
 title = {A flexible data structure for efficient buffer insertion},
 volume = {},
 year = {2004}
}
