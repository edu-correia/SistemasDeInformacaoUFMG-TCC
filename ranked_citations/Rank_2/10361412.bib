@inproceedings{10361412,
 abstract = {There are various data security risks in power grid systems, and recommendation systems are a good solution to the selection of security strategies. Federated learning is a machine learning framework that can protect the data privacy of each participant and can effectively solve the data security external collaborative training modeling challenges. This paper proposed a flexible implantable recommendation algorithm based on knowledge graph and multi-channel composite to enhance federated learning on demand. The algorithm designs three different feature extraction modules to learn to construct multi-dimensional features on multi-attribute collaborative knowledge graphs. Among them, the distance translation module utilizes the Trans R recommendation algorithm to learn the internal semantic structure information in knowledge graph triples and terminal-security policy selection history; the random walk module uses the Node2Vec algorithm to learn the homogeneous and Structured information in the multi-attribute collaborative knowledge graph; the graph convolutional network module learns the high-order neighborhood multi-attribute collaborative information of terminal/security policy nodes through multi-layer feature propagation and aggregation. The composite network module adopts a convolutional neural network-like operation to first locally optimize the three modules, and then extracts the highly informative elements to obtain the final feature representation of the terminal/security policy. Finally, the algorithm merges the vectors of terminal-security policy pairs into the multi-layer perceptron to learn and calculate the prediction score for recommendation.},
 author = {Chen, Shi and Li, Qianmu and Wang, Qi and Zhao, Xinjian and Ge, Hao and Li, Nianzhe},
 booktitle = {2023 IEEE Intl Conf on Dependable, Autonomic and Secure Computing, Intl Conf on Pervasive Intelligence and Computing, Intl Conf on Cloud and Big Data Computing, Intl Conf on Cyber Science and Technology Congress (DASC/PiCom/CBDCom/CyberSciTech)},
 doi = {10.1109/DASC/PiCom/CBDCom/Cy59711.2023.10361412},
 issn = {2837-0740},
 keyword = {Training;Machine learning algorithms;Federated learning;Data security;Semantics;Collaboration;Knowledge graphs;Recommender System;Compound Channel;Distance Translatio;Graph Random Walk;Graph Convolutional Network},
 month = {Nov},
 number = {},
 pages = {0698-0705},
 title = {A Multi-Channel Composite Recommendation Method in Federated Learning},
 volume = {},
 year = {2023}
