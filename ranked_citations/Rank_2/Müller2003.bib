@conference{Müller2003,
 abstract = {The abundance of errors in genome databases is a well-known fact. Major problems are errors in genome annotation. Performing biological experiments to eliminate them is time consuming and expensive. As a viable alternative, we introduce novel data cleansing methods for (semi-) automatic detection and correction of erroneous entries. Using a simple example we show the applicability of this cleansing approach. Our approach forms a sound basis for the solution of many open questions such as the efficient identification of erroneous entries, the specification of the cleansing process, management of alternative solutions until the correct one is identified, and efficient management of dependencies to react on changes to base data and avoid outdated data. © VLDB 2003.All rights reserved.},
 author = {Müller, Heiko},
 journal = {VLDB PhD Workshop 2003 - Proceedings of the VLDB 2003 PhD Workshop, Co-located with the 29th International Conference on Very Large Data Bases, VLDB 2003},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic Data Cleansing in Genome Databases},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105033477373?origin=resultslist},
 year = {2003}
}
