@inproceedings{5663718,
 abstract = {In order to solve the problem of data integration and interoperation of heterogeneous XML sources, an ontology-based framework has been created at a semantic level in this paper. Because ontologies carries explicit semantics, In our approach, the global ontology is expressed in RDF Schema and constructed using the global-as-view approach by merging individual local ontologies, which represent XML source schemas. We provide a formal model for the mappings between XML schemas and local RDFS ontologies and those between local ontologies and the global RDFS ontology. Empirical results show that the query processing for data integration and interoperation is effective and speedy using this method . So the integration and interoperation of XML data is solved.},
 author = {Hua, Ze and Ban, JianMin},
 booktitle = {2010 Sixth International Conference on Semantics, Knowledge and Grids},
 doi = {10.1109/SKG.2010.77},
 issn = {},
 keyword = {XML;Ontologies;Resource description framework;Semantics;Query processing;Merging;Distributed databases;Semantic;Data Integration and Interoperation;Ontology;RDFS;Query processing},
 month = {Nov},
 number = {},
 pages = {422-423},
 title = {Ontology-based Integration and Interoperation of XML Data},
 volume = {},
 year = {2010}
}
