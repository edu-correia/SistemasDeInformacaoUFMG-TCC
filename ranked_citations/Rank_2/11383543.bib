@inproceedings{11383543,
 abstract = {To work around this limitation, the new architecture merges retrieval steps and projection of graph neural hence enabling it leverage external medical resources that while the clinical units coexist are being consumed. The fusion ensure that the system will yield context relevance and additionally richness in knowledge for the users’ medical questions. One of the major strengths of this method is that it is merging information retrieval with graph-based reasoning thus greatly enhances the comprehension. In addition, the proposed model opens the door for dynamic reasoning by representing medical knowledge in the form of graphs that can be updated and changed when new queries arise. By fusing retrieval augmentation with graph neural networks, this approach effectively moves medical question answering systems to better interpretability, consistency, and practical application in healthcare decision support.},
 author = {R, Ramachandiran and Mishra, Monalisa and G, Santhosh Kumar and B, Suchithra and P, Lalithamani and N V, Keerthana},
