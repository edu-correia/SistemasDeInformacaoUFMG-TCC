@article{10.5555/1352383.1352423,
 abstract = {The authors have been teaching a very successful university computer literacy course since 1984. A computer literacy course should teach students to be passionate about and efficient with computers, and it should engender students with an appreciation of the power computing and networking tools provide today. In the authors' courses, students learn useful skills, but that is a secondary goal. The authors use the World Wide Web as a vehicle for proactive learning and publishing; and they encourage collaboration using web and programming applications tools to enable true literacy. This paper will review those aspects of the instructors' methodology that contribute to the success of the course.},
 address = {Evansville, IN, USA},
 author = {Liao, Luby and Pope, Jack W.},
 issn = {1937-4771},
 issue_date = {June 2008},
 journal = {J. Comput. Sci. Coll.},
 month = {June},
 number = {6},
 numpages = {8},
 pages = {231–238},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Computer literacy for everyone},
 volume = {23},
 year = {2008}
}
