@conference{Lange20202773,
 abstract = {In big data environments, measuring performance interference while sharing resources is complex and not well covered by current benchmarks and tools. Different applications can compete for the same resources (e.g., persistent storage) until they become overloaded without notice either by the benchmark or the big data system. We unveil the case when RocksDB (a big data management system) shares disk flashes among multiple tenants and how YCSB and db_bench (two state-of-the-art big data benchmarks) fail to catch performance interference. In this paper, we define a methodology to measure the problem of performance interference over time and show how RocksDB quickly degrades throughput until it turns almost inoperative while sharing the persistent storage with other tenants. © 2020 IEEE.},
 author = {Lange, Adriano and Kepe, Tiago Rodrigo and Cunha De Almeida, Eduardo and Sunye, Marcos Sfair},
 doi = {10.1109/BigData50022.2020.9378158},
 journal = {Proceedings - 2020 IEEE International Conference on Big Data, Big Data 2020},
 note = {Cited by: 0},
 pages = {2773 - 2778},
 publication_stage = {Final},
 source = {Scopus},
 title = {Uncovering Performance Interference of Multi-Tenants in Big Data Environments},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85103857966?origin=resultslist},
 year = {2020}
}
