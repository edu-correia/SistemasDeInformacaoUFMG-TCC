@inproceedings{4439950,
 abstract = {Recently we accomplish the matrix formulation for the canonical perturbation theory of the linear betatron coupling resonance in circular accelerators. By merging the perturbation theory with the matrix formalism, we manifest the symplectic structure of the former theory, and conversely derive the analytical representation for the latter. The formulation for the coupled betatron motion explicitly implies that the linear coupling causes the excitation of skew resonances through nonlinear fields with mid-plane symmetry. The third order skew coupling resonance is observed in the SPring-8 storage ring, for example, as the blow-up of the vertical beam size. For the purpose of studying the impact of the linear coupling on the skew nonlinear resonance, we investigate the characteristic behavior of the nonlinear resonance deduced from the matrix formulation of the perturbation theory.},
 author = {Takao, M. and Masaki, M. and Schimizu, J. and Soutome, K. and Takano, S.},
 booktitle = {2007 IEEE Particle Accelerator Conference (PAC)},
 doi = {10.1109/PAC.2007.4439950},
 issn = {2152-9582},
 keyword = {Resonance;Storage rings;Matrix converters;Linear accelerators;Motion analysis;Equations;Merging;Optical coupling;Nonlinear dynamical systems;Nonlinear distortion},
 month = {June},
 number = {},
 pages = {4003-4005},
 title = {On skew nonlinear resonance in the SPring-8 storage ring},
 volume = {},
 year = {2007}
}
