@inproceedings{10846056,
 abstract = {In today’s era of technology, the unmeasurable data is being exchanged over the internet per second. So, for data transmission or data communication the cloud storage platforms were introduced for robust communication. But on cloud there is always a risk of data breaches due to cyber-attacks. To ensure our data confidentiality and integrity, many technologies have been evolved in past such as cryptography, steganography, digital signature, trademarking, copyright or watermarking etc. But still cloud data is not considered as to be totally secured as attackers are easily cracking the simple cryptography algorithm to fetch our information. For secured data communications researchers introduced multilayered cryptography techniques which consists of hybrid approach for data encryption or decryption. These hybrid data encryption techniques are more secure than traditional cryptography techniques. In this review article, a detailed comparison of different data encryption or decryption techniques has been done to find out the new possible methodologies for secure data communication over cloud. This review article combines both cryptography and steganography for providing security to our data. The study is done to compare all the cryptographic techniques such as RSA, DES, AES and ECC etc., then suggesting some new hybrid methodology merging it with image steganography. Finally, the complete flow of new hybrid methodology of cryptography is mentioned in this article for better efficiency and security.},
 author = {Badhan, Akash and Malhi, Simarjit Singh},
 booktitle = {2024 12th International Conference on Internet of Everything, Microwave, Embedded, Communication and Networks (IEMECON)},
 doi = {10.1109/IEMECON62401.2024.10846056},
 issn = {},
 keyword = {Steganography;Cloud computing;Reviews;Public key;Watermarking;Encryption;Cryptography;Security;Data communication;Cyberattack;Cryptography;Steganography;Data Compression;AES;ECC;RSA;DES;LSB;Cloud;Data Security etc},
 month = {Oct},
 number = {},
 pages = {1-7},
 title = {A Review on Hybrid Cryptography approach with Steganography},
 volume = {},
 year = {2024}
}
