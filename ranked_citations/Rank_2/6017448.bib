@inproceedings{6017448,
 abstract = {This paper introduces an integration process capable of merging an electrochemical CMOS chip with a microfluidic structure to bring the performance benefits of on-CMOS sensors to lab-on-chip platforms. This new approach embeds a CMOS die into a carrier chip and provides a planar surface that supports complex microfluidic channels beyond the dimensions of a tiny CMOS die. The process provides a smooth surface suitable for patterning interconnects to reliably route chip pads to the edge of the carrier and for forming microfluidic mixers with detection channels that cross over the CMOS chip. This lab-on-CMOS process achieves high packing density and is suitable for batch production, opening new opportunities for next generation lab-on-chip devices.},
 author = {Huang, Yue and Mason, Andrew J.},
 booktitle = {2011 6th IEEE International Conference on Nano/Micro Engineered and Molecular Systems},
 doi = {10.1109/NEMS.2011.6017448},
 issn = {},
 keyword = {CMOS integrated circuits;Microfluidics;Surface treatment;Polyimides;Silicon;Gold;Cavity resonators},
 month = {Feb},
 number = {},
 pages = {690-693},
 title = {Lab-on-CMOS: Integrating microfluidics and electrochemical sensor on CMOS},
 volume = {},
 year = {2011}
}
