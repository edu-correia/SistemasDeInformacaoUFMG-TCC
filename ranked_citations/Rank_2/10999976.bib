@inproceedings{10999976,
 abstract = {This paper presents a wideband dielectric resonator antenna (DRA) with three excited modes: the fundamental TEll1 mode and the higher-order TEll3 and $\text{TE}_{212}$ modes, which are merged to achieve a wide impedance bandwidth. To demonstrate the design, an antenna prototype was developed, fabricated, and measured, showing reasonable agreement between the measured and simulated results. The prototype achieved a wide measured 10-dB impedance bandwidth of 64.6% (5.85-11.48 GHz) with stable broadside radiation patterns throughout the band.},
 author = {Chen, Zhe and Sun, Yu-Xiang and Wu, Wenhui and Ren, Xue and Yuan, Tao},
 booktitle = {2025 19th European Conference on Antennas and Propagation (EuCAP)},
 doi = {10.23919/EuCAP63536.2025.10999976},
 issn = {},
 keyword = {Antenna measurements;Impedance measurement;Prototypes;Dielectric resonator antennas;Dielectric measurement;Dielectrics;Broadband antennas;Impedance;Wideband;Antenna radiation patterns;Dielectric resonator antenna (DRA);wideband antenna;higher-order modes},
 month = {March},
 number = {},
 pages = {1-3},
 title = {A Wideband Dielectric Resonator Antenna},
 volume = {},
