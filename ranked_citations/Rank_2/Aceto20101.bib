@conference{Aceto20101,
 abstract = {This paper presents a bisimulation-based method for establishing the soundness of equations between terms constructed using operations whose semantics is specified by rules in the GSOS format of Bloom, Istrail and Meyer. The method is inspired by de Simone's FH-bisimilarity and uses transition rules as schematic transitions in a bisimulation-like relation between open terms. The soundness of the method is proven and examples showing its applicability are provided. The proposed bisimulation-based proof method is incomplete, but the article offers some completeness results for restricted classes of GSOS specifications. © Aceto, Cimini and Ingolfsdottir.},
 author = {Aceto, Luca and Cimini, Matteo and Ingolfsdottir, Anna},
 doi = {10.4204/EPTCS.18.1},
 journal = {Electronic Proceedings in Theoretical Computer Science, EPTCS},
 note = {Cited by: 4; All Open Access; Gold Open Access; Green Open Access},
 pages = {1 - 16},
 publication_stage = {Final},
 source = {Scopus},
 title = {A bisimulation-based method for proving the validity of equations in GSOS languages},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77956385084?origin=resultslist},
 volume = {18},
 year = {2010}
}
