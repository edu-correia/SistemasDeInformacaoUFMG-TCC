@inproceedings{7583048,
 abstract = {This paper presents an image segmentation method based on modified Quadtree sobel operator which was applied to enhance the precision of defining the real edges of the digital images. After removes noise of the images via modified median filtering, and pre-segments the images according to their characteristics, quadtree operator merges different zones without noise by multiple-zone target segmentation algorithm. The segmented images has clear structure and reserves their characteristic information. Results show that the method can removes noise effectively and solves out the problem of inaccurate segmentation due to regional image overlapping.},
 author = {He Weigang and Zhang Fan and Li Zhenglin and Li Shuyuan},
 booktitle = {2016 World Automation Congress (WAC)},
 doi = {10.1109/WAC.2016.7583048},
 issn = {},
 keyword = {Image segmentation;Image edge detection;Merging;Filtering;Digital images;Brightness;edge detection;segmentation;quadtree sobel operator;digital images},
 month = {July},
 number = {},
 pages = {1-3},
 title = {Enhancement of image edge definition by modified Quadtree sobel operator},
 volume = {},
 year = {2016}
}
