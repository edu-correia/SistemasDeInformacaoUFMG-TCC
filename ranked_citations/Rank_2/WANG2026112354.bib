@article{WANG2026112354,
 abstract = {Accurate and efficient detection of substation defects is crucial to the safety and stability of the power grid. However, conventional methods often suffer from limited accuracy in classifying various defects and detecting small targets under complex environmental conditions. To overcome these shortcomings, a novel substation defect detection model based on You Only Look Once (YOLO) v10-N is proposed to exploit enhanced feature extraction and fusion strategies. More specifically, to enhance feature extraction from diverse defect categories, a novel feature extraction module is introduced by integrating a proposed dilated-wise re-parameterized residual bottleneck into the cross-stage partial network. Furthermore, a self-adaptive focusing and diffusing feature pyramid network is developed by adopting a dimension-aware selective integration block to establish a multi-scale feature-focusing and -diffusing mechanism, which enables effective merging of the high-dimensional semantic features and the low-dimensional spatial features, especially for small-target detection. Finally, a diverse branch detection head is designed to leverage multiple parallel convolutional branches to enrich feature representations across multiple scales. The synergy of components enhances both feature representation and multi-scale robustness of the proposed model.},
 author = {Cheng Wang and Zhilong Liu and Junnan Du and Wen Yang and Tianyi Wang},
 doi = {https://doi.org/10.1016/j.epsr.2025.112354},
 issn = {0378-7796},
 journal = {Electric Power Systems Research},
 keyword = {Substation defect detection, YOLO, Diverse defect categories, Small-target detection, Multiple scales},
 pages = {112354},
 title = {A YOLO-based substation defect detection model with enhanced feature extraction and fusion},
 url = {https://www.sciencedirect.com/science/article/pii/S0378779625009411},
 volume = {252},
 year = {2026}
}
