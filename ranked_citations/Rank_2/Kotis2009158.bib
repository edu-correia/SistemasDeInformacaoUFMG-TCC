@conference{Kotis2009158,
 abstract = {The aim of the paper is to present an ontology learning approach that automatically constructs useful ontologies from query logs. By providing users with a useful ontology that is automatically built from "their needs" i.e. users' search interests, in order to address "their needs" i.e. use of the learned ontology to query information precisely, a new approach that can be considered an incentive in the semantic content creation bottleneck is introduced. The approach can be applied in any set of queries (query logs) given that the queries are classified in specific domains. © 2009 IADIS.},
 author = {Kotis, Konstantinos and Papasalouros, Andreas and Maragkoudakis, Manolis},
 journal = {Proceedings of the IADIS International Conference WWW/Internet 2009, ICWI 2009},
 note = {Cited by: 1},
 pages = {158 - 162},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mining web queries to boost semantic content creation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84946012922?origin=resultslist},
 volume = {2},
 year = {2009}
}
