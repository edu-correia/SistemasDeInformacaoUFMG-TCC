@article{Ayache2007494,
 abstract = {Concept indexing in multimedia libraries is very useful for users searching and browsing but it is a very challenging research problem as well. Combining several modalities, features or concepts is one of the key issues for bridging the gap between signal and semantics. In this paper, we present three fusion schemes inspired from the classical early and late fusion schemes. First, we present a kernel-based fusion scheme which takes advantage of the kernel basis of classifiers such as SVMs. Second, we integrate a new normalization process into the early fusion scheme. Third, we present a contextual late fusion scheme to merge classification scores of several concepts. We conducted experiments in the framework of the official TRECVID'06 evaluation campaign and we obtained significant improvements with the proposed fusion schemes relatively to usual fusion schemes. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Ayache, Stéphane and Quénot, Georges and Gensel, Jérôme},
 doi = {10.1007/978-3-540-71496-5_44},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 43; All Open Access; Green Open Access},
 pages = {494 - 504},
 publication_stage = {Final},
 source = {Scopus},
 title = {Classifier fusion for SVM-based multimedia semantic indexing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/37149009641?origin=resultslist},
 volume = {4425 LNCS},
 year = {2007}
}
