@article{QIAN2025106707,
 abstract = {To provide spatial visualization of tower inclination, this study proposes a PSO-GRNN-based monitoring method for isolated transmission lines. A 3D laser scanner acquires point cloud data of the towers to reconstruct a 3D model. Tower segments are extracted using detection algorithms, and the central axis is determined by merging collinear segments and computing the primary contour. The axis data is then used as the network input. The GRNN network estimates the inclination, while the PSO algorithm optimizes the smoothing factor to improve prediction accuracy and generalization capability. Experimental results demonstrate that the PSO-GRNN model's generalization curve exhibits negligible fluctuations and converges after 9 iterations (fitness = 0.001). For the 14 test samples, the detected tilt angles align with the actual values, achieving 94-98% accuracy (detection time < 4 s), outperforming Reference [9] (81-89%) and [10] (75-80%). The proposed method exhibits high stability and measurement precision.},
 author = {Kun Qian and Jian Wang},
 doi = {https://doi.org/10.1016/j.rineng.2025.106707},
 issn = {2590-1230},
 journal = {Results in Engineering},
 keyword = {PSO-GRNN, Isolated transmission lines, Tower tilt monitoring, Spatial visualization, Axis extraction},
 pages = {106707},
 title = {Spatial Visualization Monitoring Method of Tower Tilt of Isolated Transmission Lines Based on PSO-GRNN},
 url = {https://www.sciencedirect.com/science/article/pii/S2590123025027744},
 year = {2025}
}
