@article{Lee2015478,
 abstract = {If a dataset has multiple classes and thousands of features like microarray data, the classification accuracy may be low due to complexity and noise in the dataset, even though feature selection is applied to reduce the dimensions of the dataset. In our previous work, the “Divide-and-Merge” approach was proposed for high dimensional datasets. In this paper, we analyze the effect of the Divide-and-Merge approach and propose an implementation of the method for high dimensional multi-class datasets. Most experiment results showed that the proposed method efficiently improves the classification accuracy for high dimensional multi-class datasets. © 2015, American Scientific Publishers. All rights reserved.},
 author = {Lee, S. and Oh, S.},
 doi = {10.1166/asl.2015.5774},
 journal = {Advanced Science Letters},
 note = {Cited by: 0},
 number = {3},
 pages = {478 - 482},
 publication_stage = {Final},
 source = {Scopus},
 title = {Analysis and implementation of divide and merge classification for high dimensional multi-class datasets},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84941059727?origin=resultslist},
 volume = {21},
 year = {2015}
}
