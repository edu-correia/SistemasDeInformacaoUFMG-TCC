@inproceedings{5728471,
 abstract = {In this paper, a compact second harmonic-suppressed bandpass filter is developed using π-equivalent transmission lines. A conventional quarter-wavelength microstrip can be equivalent to a π-equivalent transmission line realized by a high-impedance line with bilateral shunt low-impedance stubs. The circuit configuration of the π-equivalent transmission line is beneficial to miniaturize the circuit size by merging open stubs into a single stub, and provide a good harmonic suppression. A compact bandpass filter can be implemented with a 45.3% circuit size of the conventional one with a 30 dB spurious suppression up to 3.4 f0. The measured results of the developed bandpass filter are in a good agreement with the simulated results by the full-wave electromagnetic simulator.},
 author = {Chang, Chih-Lin and Tseng, Chao-Hsiung},
 booktitle = {2010 Asia-Pacific Microwave Conference},
 doi = {},
 issn = {2165-4743},
 keyword = {Band pass filters;Resonator filters;Microwave filters;Transmission line measurements;Passband;Microstrip filters;Power transmission lines;bandpass filter;π-equivalent transmission line;harmonic-suppression},
 month = {Dec},
 number = {},
 pages = {837-840},
 title = {A compact second harmonic-suppressed bandpass filter using π-equivalent transmission lines},
 volume = {},
 year = {2010}
}
