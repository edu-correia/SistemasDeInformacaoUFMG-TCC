@conference{Zhuge2010128,
 abstract = {This paper aims to depict a structure among verbs based on valence theory as a supplement to WordNet in order to merge syntagmantic knowledge into its existing paradigmatic knowledge. After analysing 200 sentences from BNC, 4 semantic roles were added to its structure, i.e. Agent, Object, Direction and Experiencer. Valence values of verbs in the structure are described in 3 aspects: the number of arguments they are able to combine with; the semantic roles these arguments plays and semantic restriction on features of these arguments (see table IV). These features can help build syntagmantic relations between verbs and nouns, which can be used in word sense disambiguity and machine translation field. © 2010 IEEE.},
 author = {Zhuge, Wen and Hua, Jingyu},
 doi = {10.1109/KAM.2010.5646301},
 journal = {2010 3rd International Symposium on Knowledge Acquisition and Modeling, KAM 2010},
 note = {Cited by: 0},
 pages = {128 - 131},
 publication_stage = {Final},
 source = {Scopus},
 title = {The construction of a supplement structure among verbs to WordNet based on valence theory},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78650660708?origin=resultslist},
 year = {2010}
}
