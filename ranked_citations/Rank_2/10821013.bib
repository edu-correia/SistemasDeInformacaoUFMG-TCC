@article{10821013,
 abstract = {The Source Code Control System (SCCS) was first introduced in 1975 (Rochkind, 1975). It controlled computer program source code by tracking versions and recording who made changes, when, and why. The present retrospective paper assesses the strengths and weaknesses of SCCS and traces its influence on software engineering over the past fifty years.},
 author = {Rochkind, Marc J.},
 doi = {10.1109/TSE.2024.3524947},
 issn = {1939-3520},
 journal = {IEEE Transactions on Software Engineering},
 keyword = {Software;Software engineering;Merging;Control systems;Programming;Source coding;Mainframes;Codes;Software reliability;Software development management;Software development management;software engineering;software reliability;software tools;version control systems;software configuration management;source control management},
 month = {March},
 number = {3},
 pages = {695-699},
 title = {A Retrospective on the Source Code Control System},
 volume = {51},
 year = {2025}
}
