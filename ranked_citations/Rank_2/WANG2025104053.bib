@article{WANG2025104053,
 abstract = {Network community mining is crucial for understanding network structures. Recently, local community mining has been favored for its computational efficiency and interpretability over global methods. We introduce HTCM, a heat-transfer-based method for local community modeling and mining, which effectively identifies cores and recovers real communities. Communities are modeled as core-periphery structures with a hierarchical authority distribution, peaking at cores and decreasing towards the periphery. This allows community recognition through influence spread from the cores, akin to heat transfer. Authoritative nodes are selected and merged into cores, ensuring uniform distribution and high robustness. Node membership is assigned using a discrete-time dynamical system, with influence spreading from cores along decreasing authority paths, forming radiating community structures. HTCM's effectiveness is verified on artificial and real-world networks, ranking within the top 2 across 8 of the 10 real-world datasets in NMI or ARI in community recovery, outperforming 6 other competing benchmarks, and exhibits near-linear time complexity.},
 author = {Zining Wang and Qingtao Pan and Haosen Wang and Zhaolin Lv and Xian Wu and Yirun Ruan and Jun Tang},
 doi = {https://doi.org/10.1016/j.ipm.2024.104053},
 issn = {0306-4573},
 journal = {Information Processing & Management},
 keyword = {Local community detection, Heat transfer, Cores establishment, Influence propagation},
 number = {3},
 pages = {104053},
 title = {HTCM: A heat-transfer-based method for community modeling and mining},
 url = {https://www.sciencedirect.com/science/article/pii/S0306457324004126},
 volume = {62},
 year = {2025}
}
