@inproceedings{5090353,
 abstract = {Test structures have been designed to detect the impact of field enhancement on low-k dielectric breakdown at the tips of combs in comb structures. An analysis methodology has been proposed to separate the impact of area and field enhancement. Modeling utilizes characteristic lifetimes at various area ratios. The proposed model, when compared with direct fitting of the Weibull distribution, improves lifetime estimates by 2.5 orders of magnitude at 0.01% and reduces variance of the confidence bound by 73%.},
 author = {Bashir, Muhammad and Milor, Linda},
 booktitle = {2009 IEEE International Interconnect Technology Conference},
 doi = {10.1109/IITC.2009.5090353},
 issn = {2380-6338},
 keyword = {Dielectric breakdown;Testing;Geometry;Copper;Integrated circuit interconnections;Electric breakdown;Life estimation;Lifetime estimation;Voltage;Dielectric measurements},
 month = {June},
 number = {},
 pages = {104-106},
 title = {Determination of the impact of field enhancement in low-k dielectric breakdown},
 volume = {},
 year = {2009}
}
