@inproceedings{10904986,
 abstract = {This paper introduces the first merged supercavity excitation mechanism using a substrate integrated waveguide (SIW) pumping source, enhancing Q-factor and stability. Combining SIWs with high-index resonators (HIR), we achieve three times higher $\mathbf{Q}$-factor and up to six times size reduction compared to other works. For a proof-of-concept, a SIW-HIR filter is designed at X-band with a Q-factor of more than 300 and compact volume of $0.55 \% \lambda^{3}$, where $\lambda$ is the wavelength at working frequency.},
 author = {Manzoor, Zahra and Peroulis, Dimitrios},
 booktitle = {2025 IEEE Radio and Wireless Symposium (RWS)},
 doi = {10.1109/RWS62086.2025.10904986},
 issn = {2164-2974},
 keyword = {Q-factor;Wireless communication;Couplings;Resonator filters;Resonant frequency;Bandwidth;Stability analysis;Scattering parameters;Resonators;Substrates;supercavity modes;SIW filter;miniaturization},
 month = {Jan},
 number = {},
 pages = {71-73},
 title = {Super-miniaturized Merged-Supercavity Mode System Excited by Cross Coupling SIW Resonators},
 volume = {},
 year = {2025}
}
