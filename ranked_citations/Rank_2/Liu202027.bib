@conference{Liu202027,
 abstract = {Developers increasingly rely on external tools and services which causes development information to be scattered across different information silos. To access this information, developers need to access different applications, presentation files, and web services. This paper investigates mechanisms for incorporating external information sources into Integrated Development Environments using visual mechanisms to support common software development activities. Through a developer survey and a small experiment we find that developers prefer minimal representations for incorporating external information sources into their source code editors, and that they are able to use this information when performing their development tasks.  © 2020 IEEE.},
 author = {Liu, Xinhong and Holmes, Reid},
 doi = {10.1109/VISSOFT51673.2020.00008},
 journal = {Proceedings - 8th IEEE Working Conference on Software Visualization, VISSOFT 2020},
 note = {Cited by: 3},
 pages = {27 - 37},
 publication_stage = {Final},
 source = {Scopus},
 title = {Exploring Developer Preferences for Visualizing External Information within Source Code Editors},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85099440194?origin=resultslist},
 year = {2020}
}
