@conference{Pitchumani2015,
 abstract = {Shingled Magnetic Recording (SMR) disks employ a shingled write process that overlaps the data tracks on the disk surface like the shingles on a roof, thereby increasing disk areal density with minimal manufacturing changes. While these disks have the same read behavior as current disks, random writes and in-place data updates are no longer possible, since a write to a track must overwrite and destroy data on all tracks that it overlaps. Given this change in write behavior, we argue that the best way to utilize these disks is not by masquerading them as traditional disks, but by using approaches that leverage their proclivity for sequential writes. To address this need, we developed SMRDB, a key-value data store for SMR disks, demonstrating that SMR disks can be effectively used to replace conventional disks for many applications. We evaluate SMRDB against a state-of-the-art LSM-tree based key-value database engine, LevelDB, on conventional disks. Our Yahoo! Cloud Serving Benchmark results show that, despite being restricted to sequential writes, SMRDB outperforms LevelDB by 8.8-123.6%. © Copyright 2015 by the Association for Computing Machinery, Inc.},
 author = {Pitchumani, Rekha and Hughes, James and Miller, Ethan L.},
 doi = {10.1145/2757667.2757680},
 journal = {SYSTOR 2015 - Proceedings of the 8th ACM International Systems and Storage Conference},
 note = {Cited by: 40},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {SMRDB: Key-value data store for shingled magnetic recording disks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84960860382?origin=resultslist},
 year = {2015}
}
