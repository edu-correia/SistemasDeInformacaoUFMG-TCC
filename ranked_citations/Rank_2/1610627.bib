@article{1610627,
 abstract = {A 1.5-V 512-Mb DDR3 synchronous DRAM prototype was designed and fabricated in 80-nm technology. Critical to the signal integrity in DDR3 point-to-2points (P22P) interfacing is an efficient calibration scheme and C/sub IO/ minimization, which were achieved by on-die-termination (ODT)-merged output drivers, SCR type ESD protection, and self-calibration scheme. The hybrid latency control scheme can turn the DLL off in standby mode, reducing power consumption. User-friendly functions such as temperature read-out from on-chip sensor and per-bank-refresh were also implemented.},
 author = {Churoo Park and HoeJu Chung and Yun-Sang Lee and Jaekwan Kim and JaeJun Lee and Moo-Sung Chae and Dae-Hee Jung and Sung-Ho Choi and Seung-young Seo and Taek-Seon Park and Jun-Ho Shin and Jin-Hyung Cho and Seunghoon Lee and Ki-Whan Song and Kyu-Hyoun Kim and Jung-Bae Lee and Changhyun Kim and Soo-In Cho},
 doi = {10.1109/JSSC.2006.870808},
 issn = {1558-173X},
 journal = {IEEE Journal of Solid-State Circuits},
 keyword = {SDRAM;Prototypes;Calibration;Temperature sensors;Bandwidth;Pipeline processing;Random access memory;Consumer electronics;Prefetching;Thyristors;Calibration;DDR3 SDRAM;input capacitance;per-bank refresh;SCR type ESD;signal integrity;temperature sensor},
 month = {April},
 number = {4},
 pages = {831-838},
 title = {A 512-mb DDR3 SDRAM prototype with C/sub IO/ minimization and self-calibration techniques},
 volume = {41},
 year = {2006}
}
