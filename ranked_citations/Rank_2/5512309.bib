@inproceedings{5512309,
 abstract = {Multibeam echo-sounder sonars are indispensably important instruments on seabed mapping and three-dimensional visualization of seafloor can be obtained from multibeam sonar bathymetry via Digital Terrain Modeling. In this paper, we study the algorithms of Delaunay triangulation construction to obtain a seafloor Digital Terrain Model and focus on the problem of the intersection of newly formed triangle and the original triangles during the merging process of two subtriangulations. We present an improved merging method called “bidirectional sew” to obtain a triangle with good-shape once it is formed, and then execute Local Optimization Procedure (LOP) in the seam to finally get the whole Delaunay triangulation. The improved algorithm can effectively reduce the complicacy of the subsequent Local Optimization Procedure (LOP) and enhance the robustness and efficiency of the procedure. After seafloor DTM modeling, by properly setting of color and light, we finally obtain the 3D visualization of seafloor.},
 author = {Lu, Dan and Li, Haisen and Wei, Yukuo and Shen, Tongxi},
 booktitle = {The 2010 IEEE International Conference on Information and Automation},
 doi = {10.1109/ICINFA.2010.5512309},
 issn = {},
 keyword = {Merging;Data visualization;Sea floor;Oceanographic techniques;Tin;Sonar;Terrain mapping;Educational technology;Data structures;Laboratories;multibeam bathymetry;seafloor mapping;Dlelaunay trianglation;DTM},
 month = {June},
 number = {},
 pages = {1171-1176},
 title = {An improved merging algorithm for delaunay meshing on 3D visualization multibeam bathymetric data},
 volume = {},
 year = {2010}
}
