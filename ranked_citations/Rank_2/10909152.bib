@article{10909152,
 abstract = {To achieve the optimal uncertain multitarget decentralized tracking fusion, a federated density fusion algorithm of Gaussian mixture-probability hypothesis density (GM-PHD) filters is proposed. Our fusion algorithm requires a hierarchical structure. Each sensor node runs a local GM-PHD filter to extract multitarget state estimates from sensor measurements. Besides running a global filter that only predicts the fusion result of the previous moment, the fusion node also collects, associates, and merges the GM-PHDs of the global and local filters after eliminating the correlations among all filters. The association results can be judged as survival target detection, missed detection, target new birth, or target vanishing. Each association situation employs a different optimal merging method. To eliminate correlations resulting from feedback and common process noise, the covariance upper bounding technique is introduced. This technique returns the cross-covariances among all filters to zeros by increasing their auto-covariances and the process noise covariance. It is proven that using the global filter, feedback, and covariance upper bounding technique, the fusion node can obtain the same optimal accuracy as the centralized fusion. Simulations demonstrate that our algorithm, with appropriate parameters, can obtain the optimal tracking accuracy and outperforms the existing arithmetic average (AA) fusion algorithm.},
 author = {Yu, Xue and Xi-An, Feng},
 doi = {10.1109/JSEN.2025.3544835},
 issn = {1558-1748},
 journal = {IEEE Sensors Journal},
 keyword = {Filtering algorithms;Merging;Target tracking;Sensor fusion;Information filters;Data mining;Training;Intelligent sensors;Correlation;Artificial intelligence;Covariance upper bounding technique;decentralized fusion;Gaussian mixture-probability hypothesis density (GM-PHD) filter;uncertain multitarget},
 month = {April},
 number = {8},
 pages = {13420-13432},
 title = {Optimal Decentralized Federated Density Fusion of GM-PHD Filters},
 volume = {25},
 year = {2025}
}
