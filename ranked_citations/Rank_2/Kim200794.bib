@article{Kim200794,
 abstract = {The branch misprediction penalty is a major performance limiter and a major cause of wasted energy in high-performance processors. The diverge-merge processor reduces this penalty by dynamically predicating a wide range of hard-to-predict branches at runtime in an energy-efficient way that doesn't significantly increase hardware complexity or require major ISA changes. © 2007 IEEE.},
 author = {Kim, Hyesoon and Joao, Jose A. and Mutlu, Onur and Patt, Yale N.},
 doi = {10.1109/MM.2007.9},
