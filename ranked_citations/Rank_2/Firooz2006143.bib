@conference{Firooz2006143,
 abstract = {Unlike those on Internet, the media providers on P2P networks are ordinary nodes whose contribution bandwidth is limited. Multi-sender methods are the best solutions known to video streaming on P2P networks. In this paper, we propose use of a multi-cast method on the top of an arbitrary multi-sender method so that all requesting peers receive almost the same expected bit-rate. That is while the existing multi-sender methods maximize the bit-rate delivered to the first receiver and cannot provide acceptable bit-rates to the next requesting nodes. © 2006 IEEE.},
 author = {Firooz, M.H. and Ronasi, K. and Pakravan, M.R. and Avanaki, A.N.},
 doi = {10.1109/ISCIT.2006.339904},
 journal = {2006 International Symposium on Communications and Information Technologies, ISCIT},
 note = {Cited by: 0},
 pages = {143 - 147},
 publication_stage = {Final},
 source = {Scopus},
 title = {A novel multi-sender algorithm based on multi-cast concept for P2P networks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/50949100628?origin=resultslist},
 year = {2006}
}
