@inproceedings{4031165,
 abstract = {The Business Process Execution Language for Web services (BPEL4WS) offers a formal specification for integrating loose-coupled Web services and building flexible business processes. However, due to the increasing number of the available services, it is becoming a new challenge to dynamically select and integrate the appropriate partner services for Internet-scale business processes. In this paper, we provide a comprehensive framework to implement such dynamic selections and integrations. In this framework, the abstract process template (APT) is utilized as the starting point for the dynamic integrations; the domain services and partner requirements are semantically described with SSD and PPC models, respectively. In this way, the qualified services can be selected through the matchmaking between SSD and PPC instances, and the technical information of the selected operations can be merged into APT through APT binding. To this end, the selected partner services can dynamically be integrated},
 author = {Zou, Zhile and Duan, Zhenhua and Wang, Jianli},
 booktitle = {2006 European Conference on Web Services (ECOWS'06)},
 doi = {10.1109/ECOWS.2006.1},
 issn = {},
 keyword = {Web services;Resource description framework;Ontologies;Runtime;Protocols;Laboratories;OWL;Formal specifications;Web and internet services;Web sites},
 month = {Dec},
 number = {},
 pages = {211-222},
 title = {A Comprehensive Framework for Dynamic Web Services Integration},
 volume = {},
 year = {2006}
}
