@inproceedings{8865492,
 abstract = {With the continuous development of digitalization, the automated processing and analysis of paintings is becoming increasingly important. The automatic author recognition of Fine-Art paintings will play an important role in the further development of the painting digitization. This paper proposes a densely connected convolutional network structure with multi-layer feature fusion to automatically identify the author of the painting. Unlike traditional CNN, Multi-layer Feature Fusion DenseNet (MFDN) combines shallow features with deep features to make final decisions, making recognition results more accurate. The article proves through experiments that our models is better than the existing state-of-the-art models in this field.},
 author = {Bai, Rui and Ling, Huang and Kai, Zhao and Qi, Donglian and Wang, Qiao},
 booktitle = {2019 Chinese Control Conference (CCC)},
 doi = {10.23919/ChiCC.2019.8865492},
 issn = {1934-1768},
 keyword = {Painting;Feature extraction;Task analysis;Merging;Deep learning;Image recognition;Convolutional neural networks;Fine-art painting;author recognition;densely connected convolutional network;feature fusion},
 month = {July},
 number = {},
 pages = {8513-8518},
 title = {Author recognition of Fine-Art paintings},
 volume = {},
 year = {2019}
}
