@inproceedings{11148478,
 abstract = {The position-velocity-current triple loop structure is a classic servo control structure. Nevertheless, the inner loop controller in the multi loop cascade structure limits the response speed of the outer loop. Therefore, a finite-time high-order position velocity single-loop control strategy considering the position velocity loop merging structure of the reference signal is proposed to enhance the control response of the position servo system. The proposed control scheme takes into account the changes in the given signal and supplements them into the controller in the estimated state. In addition, compared to traditional finite-time state observers, high-order finite-time state observers have better estimation performance for disturbances and expand the estimation range of disturbances. Finally, the experimental results demonstrate the efficacy of the proposed methodology.},
 author = {Gao, Yixuan and Yin, Zhonggang and Zhang, Yanping and Yuan, Dongsheng},
 booktitle = {2025 IEEE 20th Conference on Industrial Electronics and Applications (ICIEA)},
 doi = {10.1109/ICIEA65512.2025.11148478},
 issn = {2158-2297},
 keyword = {Industrial electronics;Motor drives;Merging;Permanent magnet motors;Control systems;State estimation;Servomotors;Periodic structures;permanent magnet synchronous motor;finite-time control;finite-time state observer considering reference signal;servo system},
 month = {Aug},
 number = {},
 pages = {1-6},
 title = {Finite-Time Position-Velocity Control for Permanent Magnet Synchronous Motor Servo System Considering Reference Signal Variation},
 volume = {},
 year = {2025}
}
