@inproceedings{4629830,
 abstract = {As the computer disappears in the environments surrounding our activities, the objects therein become augmented with sensors, actuators, processors, memories, wireless communication modules and they can receive, store, process and transmit information. In addition to objects, spaces also undergo a change towards becoming smart and eventually Ambient Intelligence (AmI) spaces. In order to model the way everyday activities are carried out within an Ami environment, we introduce the notion of "activity sphere". In this paper, we are interested in the ontology-based representation of activity spheres.},
 author = {Seremeti, L. and Kameas, A.},
 booktitle = {2008 IET 4th International Conference on Intelligent Environments},
 doi = {10.1049/cp:20081142},
 issn = {0537-9989},
 keyword = {Activity spheres;ontologies;ontology alignment},
 month = {July},
 number = {},
 pages = {1-5},
 title = {Ontology-based high level task composition in ubiquitous computing applications},
 volume = {},
 year = {2008}
}
