@article{HASAN2025159,
 abstract = {Incorporating polymers significantly diminishes the necessary dosage, enhances the bioavailability of pharmaceutical agents, and amplifies the effectiveness of antiviral therapeutics. Polymers function as distinctive nanomaterials that can assist in mitigating viral infections through many mechanisms. Multifunctional polymers can engage directly with the proteins on the viral surface, obstructing their entry into host cells and subsequent infection. Furthermore, polymers may augment the immune response by stimulating particular immune cells, including macrophages and natural killer cells, to target and eliminate the virus effectively. Antiviral mechanisms are not universally established, leading to an insufficient understanding of prevalent antiviral drug mechanisms. Researchers incorporate polymers infused with ions and/or metallic particles and specific antiviral agents, thereby positioning polymers at the forefront of antiviral strategies. From this vantage point, our inquiry emphasizes the antiviral capabilities of polymers. During the literature review, we scrutinized the molecules, chemical groups, or components exhibiting antiviral properties. This review elaborates on naturally occurring compounds like carrageenan, chitosan, fucoidan, and phosphorothioate oligonucleotides alongside synthetic entities like dendrimers and sialylated polymers. It delineates the sequence of events involved in a virus attaching to a cellular structure, merging with it, undergoing replication, assembling progeny virions, and ultimately exiting the host cell.},
 author = {Imran Hasan and Fahad A. Alharthi and Ashok Kumar Bishoyi and Soumya V. Menon and Rishabh Thakur and S. Supriya and Subhashree Ray and Kamal Kant Joshi},
 doi = {https://doi.org/10.1016/j.jiec.2025.03.017},
 issn = {1226-086X},
 journal = {Journal of Industrial and Engineering Chemistry},
 keyword = {Antiviral activity, Polymers, Natural and synthetic polymers, Biopolymers},
 pages = {159-176},
 title = {Antiviral polymers: Broad spectrum antiviral activity, antiviral mechanisms, and optimization for the treatment of various infections},
 url = {https://www.sciencedirect.com/science/article/pii/S1226086X25001777},
 volume = {150},
 year = {2025}
}
