@article{Carvalho20244241,
 abstract = {The popularity of heterogeneous CPU-GPU processing has increased considerably in recent years. To efficiently utilize heterogeneous resources, data processing systems depend on an appropriate workload placement strategy to assign the right amount of compute to the right processor. However, finding an optimal placement strategy is not trivial due to various complex and conflicting tradeoffs related to the characteristics of processors, the nature of the workload, and data locality. In addition, placement decisions impact workload runtime and performance cost, and also depend on the availability of potentially different implementations for CPUs and GPUs, which adds extra complexity in such heterogeneous environments. In this tutorial, we review and compare state-of-the-art strategies for workload placement on heterogeneous CPU-GPU architectures, along with runtime prediction techniques and methods to support multi-device code. We also discuss open issues and identify potentially promising future research directions. © 2024, VLDB Endowment. All rights reserved.},
 author = {Carvalho, Marcos N. L. and Simitsis, Alkis and Queralt, Anna and Romero, Oscar},
 doi = {10.14778/3685800.3685845},
 journal = {Proceedings of the VLDB Endowment},
 note = {Cited by: 6; All Open Access; Green Open Access},
 number = {12},
 pages = {4241 - 4244},
 publication_stage = {Final},
 source = {Scopus},
 title = {Workload Placement on Heterogeneous CPU-GPU Systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85205311012?origin=resultslist},
 volume = {17},
 year = {2024}
}
