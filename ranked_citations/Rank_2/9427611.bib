@inproceedings{9427611,
 abstract = {Virtual reality (VR) with 8K 360-degree videos provides users immersive viewing experiences. Although Versatile Video Coding (VVC) achieves superior coding gain, speedup of VVC based interframe coding of 8K data that has huge amount of data is desired while few related schemes exist. Thus this paper proposes early Skip mode decision for inter prediction of VVC on 8K 360-degree videos using hybrid equiangular cubemap (HEC) format, captured by static cameras. Based on coding statistics of 360-degree videos using HEC format, early Skip mode decision is made by referring to the sum of absolute transform distortion (SATD) cost of Affine mode and Merge mode. Compared with the VVC test model VTM 7.0, the proposed scheme achieves time saving up to 26.7% with BD-rate 0.34% on 8K 360-degree videos using HEC format.},
 author = {Lee, Ying and Tang, Chih-Wei},
 booktitle = {2021 IEEE International Conference on Consumer Electronics (ICCE)},
 doi = {10.1109/ICCE50685.2021.9427611},
 issn = {2158-4001},
 keyword = {Video coding;Solid modeling;Conferences;Virtual reality;Transforms;Distortion;Cameras;Versatile Video Coding (VVC);virtual reality (VR);inter prediction;early skip mode decision;8K video;360-degree videos;HEC},
 month = {Jan},
 number = {},
 pages = {1-3},
 title = {Early Skip Mode Decision of Versatile Video Coding on 8K 360-degree Videos},
 volume = {},
 year = {2021}
}
