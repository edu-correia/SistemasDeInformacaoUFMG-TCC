@inproceedings{11231821,
 abstract = {As Generative AI models become increasingly adept at producing human-like text, AI content detectors struggle to distinguish machine-generated text from human writing. This paper explores an innovative approach to evade these detection systems by fusing text generated from multiple large language models (LLMs) at the token level. By strategically merging the outputs of different models, the generated text incorporates a diverse range of linguistic styles, syntactic structures, and semantic patterns, effectively circumventing the detection signals typically used by content classifiers. The evaluation demonstrates that this multi-model fusion technique significantly reduces the accuracy of existing AI detection systems, highlighting vulnerabilities in their current architecture. In response, we introduce an enhanced detection framework that integrates advanced natural language processing (NLP) techniques to improve model robustness against sophisticated AI text manipulations. The results underscore the evolving cat-and-mouse game between AI-generated text and detection models, offering new insights into improving both generative AI and detection capabilities.},
 author = {Khan, Afsar and Rajagopalan, Sailesh},
 booktitle = {2025 2nd International Generative AI and Computational Language Modelling Conference (GACLM)},
 doi = {10.1109/GACLM67198.2025.11231821},
 issn = {},
 keyword = {Accuracy;Generative AI;Large language models;Predictive models;Linguistics;Writing;Syntactics;Natural language processing;Robustness;Ensemble learning;Generative AI;Adversarial Text Generation;Multi-Model Linguistic Fusion;Text Generation Evasion;Ensemble Learning;Natural Language Processing},
 month = {Aug},
 number = {},
 pages = {272-278},
 title = {Leveraging Multi-Model Linguistic Fusion for Enhanced AI Text Generation Evasion},
 volume = {},
 year = {2025}
}
