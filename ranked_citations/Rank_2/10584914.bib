@inproceedings{10584914,
 abstract = {This paper clarifies applications of humanoid robots in AI-lab auxiliary environments. Some are available on Pepper which is used most. Pepper robot is mainly used as the digital consultant in Labs. There are different functionalities that differs having been a caretaker for certain visitors to serving as an AI instructor and provides answers to queries in numerous project-specific domains. The integrated speech and image recognition systems use our in-house AI technologies. In the context of enhanced face recognition, this abstract investigates the synergy of artificial intelligence (AI), convolution neural networks (CNN), neural networks (NN), and the humanoid robot Pepper. The creation of complex facial recognition systems has been accelerated by the integration of AI techniques, especially CNN and NN architectures. This research explores the real-world applications and interactions made possible by the merging of cutting-edge robotics and AI, making use of Pepper's humanoid capabilities. The paper explores the technical elements of using CNN and NN for reliable face recognition, highlighting Pepper's function as a platform for putting these algorithms to use and improving them in real-world settings. Applications include scenarios including human-robot contact, security, and personalized help.},
 author = {B, Vamsi and B, Karthik H and Navi, Mahantesh and G, Bhanuteja and N, Vidyasagar K},
