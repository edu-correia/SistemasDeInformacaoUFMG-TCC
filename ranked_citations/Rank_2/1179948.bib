@inproceedings{1179948,
 abstract = {Because the conventional overlapped block motion compensation algorithm is relatively slower than the common coding mode, firstly, we put forward an adaptive algorithm taking advantage of the correlation between the neighboring blocks, secondly, we synchronize the partial distortion search algorithm (PDS) and adaptive initial point tracking algorithm into a new algorithm. Finally, we merge the two algorithms into one. It has been proved by simulation on the H.263+ platform that the algorithm put forward in the paper is faster than the conventional overlapped block motion compensation and that its PSNR and compression rate is similar to the conventional OBMC.},
 author = {Shumin Zhou and Qiuqi Ruan},
 booktitle = {6th International Conference on Signal Processing, 2002.},
 doi = {10.1109/ICOSP.2002.1179948},
 issn = {},
 keyword = {Motion compensation;Motion estimation;Layout;Adaptive algorithm;PSNR;Acceleration;Computational modeling;Information science;Tracking;Multimedia communication},
 month = {Aug},
 number = {},
 pages = {965-968 vol.2},
 title = {A fast overlapped block motion compensation algorithm},
 volume = {2},
 year = {2002}
}
