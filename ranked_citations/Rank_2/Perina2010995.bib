@conference{Perina2010995,
 abstract = {Following the trend of "segmentation for recognition", we present 2LDA, a novel generative model to automatically segment an image in 2 segments, background and foreground, while inferring a latent Dirichlet allocation (LDA) topic distribution on both segments. The idea is to merge two separate modules, LDA and the segmentation module, explicitly considering (and exchanging) the uncertainty between them. The resulting model adds spatial relationships to LDA, which in turn helps in using the topics to segment an image. The experimental results show that, unlike LDA, our model can be used to recognize objects, and also outperforms the state-of-the-art algorithms. © 2010 IEEE.},
 author = {Perina, Alessandro and Cristani, Marco and Murino, Vittorio},
 doi = {10.1109/ICPR.2010.249},
 journal = {Proceedings - International Conference on Pattern Recognition},
 note = {Cited by: 3},
 pages = {995 - 998},
 publication_stage = {Final},
 source = {Scopus},
 title = {2LDA: Segmentation for recognition},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/78149488545?origin=resultslist},
 year = {2010}
}
