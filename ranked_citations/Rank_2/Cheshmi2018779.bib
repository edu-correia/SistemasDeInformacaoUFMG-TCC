@conference{Cheshmi2018779,
 abstract = {In this work, we describe ParSy, a framework that uses a novel inspection strategy along with a simple code transformation to optimize parallel sparse algorithms for shared memory processors. Unlike existing approaches that can suffer from load imbalance and excessive synchronization, ParSy uses a novel task coarsening strategy to create well-balanced tasks that can execute in parallel, while maintaining locality of memory accesses. Code using the ParSy inspector and transformation outperforms existing highly-optimized sparse matrix algorithms such as Cholesky factorization on multi-core processors with speedups of 2.8× and 3.1× over the MKL Pardiso and PaStiX libraries respectively. © 2018 IEEE.},
 author = {Cheshmi, Kazem and Kamil, Shoaib and Strout, Michelle Mills and Dehnavi, Maryam Mehri},
 doi = {10.1109/SC.2018.00065},
 journal = {Proceedings - International Conference for High Performance Computing, Networking, Storage, and Analysis, SC 2018},
 note = {Cited by: 27},
 pages = {779 - 793},
 publication_stage = {Final},
 source = {Scopus},
 title = {ParSy: Inspection and transformation of sparse matrix computations for parallelism},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85062795995?origin=resultslist},
 year = {2018}
}
