@inproceedings{5709051,
 abstract = {Traditional watershed segmentation is sensitive to noise and can leads to serious over-segmentation. In order to overcome the shortcomings of traditional watershed segmentation, this paper presented an improved watershed image segmentation method. Firstly, the morphological opening/closing reconstruction filter is applied to remove the image noise. Secondly, multi-scale structure elements are used to calculate morphological gradient. Furthermore, the morphological gradient is modified by viscous morphological operators which can remove the most irregular local minimums. After the standard watershed transform, the region merging method based on neighbor regions edge value is employed to improve the segmentation result. Experiments show that this method can not only effectively avoid the over-segmentation of watershed, but also preserve the positions of regional contours.},
 author = {Zhang, Xiaoyan and Shan, Yong and Wei, Wei and Zhu, Zijian},
 booktitle = {2010 International Conference on Computational and Information Sciences},
 doi = {10.1109/ICCIS.2010.69},
 issn = {},
 keyword = {Image reconstruction;Image segmentation;Merging;Image edge detection;Noise;Algorithm design and analysis;Pixel;opening/closing reconstruction filter;gradient modification;viscous morphological operator},
 month = {Dec},
 number = {},
 pages = {258-261},
 title = {An Image Segmentation Method Based on Improved Watershed Algorithm},
 volume = {},
 year = {2010}
}
