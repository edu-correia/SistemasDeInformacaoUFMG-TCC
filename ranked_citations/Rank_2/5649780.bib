@inproceedings{5649780,
 abstract = {The optimal exploitation of the information provided by hyperspectral images requires the development of advanced image processing tools. This paper introduces a new hierarchical structure representation for such images using binary partition trees (BPT). Based on region merging techniques using statistical measures, this region-based representation reduces the number of elementary primitives and allows a more robust filtering, segmentation, classification or information retrieval. To demonstrate BPT capabilities, we first discuss the construction of BPT in the specific framework of hyperspectral data. We then propose a pruning strategy in order to perform a classification. Labelling each BPT node with SVM classifiers outputs, a pruning decision based on an impurity measure is addressed. Experimental results on two different hyperspectral data sets have demonstrated the good performances of a BPT-based representation.},
 author = {Valero, Silvia and Salembier, Philippe and Chanussot, Jocelyn},
 booktitle = {2010 IEEE International Geoscience and Remote Sensing Symposium},
 doi = {10.1109/IGARSS.2010.5649780},
 issn = {2153-7003},
 keyword = {Hyperspectral imaging;Merging;Pixel;Image segmentation;Support vector machines;Accuracy;Hyperspectral imaging;Binary Partition Tree;segmentation;classification},
 month = {July},
 number = {},
 pages = {80-83},
 title = {New hyperspectral data representation using binary partition tree},
 volume = {},
 year = {2010}
}
