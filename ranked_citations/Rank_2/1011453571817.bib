@article{10.1145/3571817,
 abstract = {We deployed a feedback visualization tool to learn how students used the tool for interpreting feedback from peers and teaching assistants. The tool visualizes the topic and opinion structure in a collection of feedback and provides interaction for reviewing providers’ backgrounds. A total of 18 teams engaged with the tool to interpret feedback for course projects. We surveyed students (N = 69) to learn about their sensemaking goals, use of the tool to accomplish those goals, and perceptions of specific features. We interviewed students (N = 12) and TAs (N = 2) to assess the tool’s impact on students’ review processes and course instruction. Students discovered valuable feedback, assessed project quality, and justified design decisions to teammates by exploring specific icon patterns in the visualization. The interviews revealed that students mimicked strategies implemented in the tool when reviewing new feedback without the tool. Students found the benefits of the visualization outweighed the cost of labeling feedback.},
 address = {New York, NY, USA},
 articleno = {49},
 author = {Crain, Patrick and Lee, Jaewook and Yen, Yu-Chun and Kim, Joy and Aiello, Alyssa and Bailey, Brian},
 doi = {10.1145/3571817},
 issn = {1073-0516},
 issue_date = {June 2023},
 journal = {ACM Trans. Comput.-Hum. Interact.},
 keyword = {Feedback sensemaking, feedback support, formative feedback, visualization design, learning},
 month = {June},
 number = {3},
 numpages = {30},
 publisher = {Association for Computing Machinery},
 title = {Visualizing Topics and Opinions Helps Students Interpret Large Collections of Peer Feedback for Creative Projects},
 url = {https://doi.org/10.1145/3571817},
 volume = {30},
 year = {2023}
}
