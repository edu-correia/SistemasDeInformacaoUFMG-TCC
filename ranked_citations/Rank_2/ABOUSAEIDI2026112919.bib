@article{ABOUSAEIDI2026112919,
 abstract = {Multi-view unsupervised learning approaches are among the most applicable subjects of recent years. There have been proposed a lot of algorithms in this area based on different methodologies and spectral clustering is one of the most popular methods. The goal of these algorithms is often obtaining a common representation based on similarity matrices of different views. However, concomitantly and jointly merging global topologies and higher-order relations of points in different views has been neglected and this independently learning of similarity matrices may not be optimal for the data clustering. In this article, we present a novel type of multi-view spectral clustering to address this issue. First, we generalize the concept of high-order proximity for multi-view data by considering paths in different views, simultaneously. Considering this tool, similarity matrices are reconstructed based on higher-order relations of all views and then the method obtains a consensus similarity matrix which regards the combination manifold structures of all views. Our method effectively exploits the complementary and interdependent information of various views and improves the clustering accuracy. We employed comprehensive experiments on some famous benchmarks. Comparing the results with some recent existing baseline methods via evaluating metrics, the efficiency of the new model is proved.},
 author = {Melika Abousaeidi and Mina Jamshidi and Ali Armandnejad},
 doi = {https://doi.org/10.1016/j.patcog.2025.112919},
 issn = {0031-3203},
 journal = {Pattern Recognition},
 keyword = {Multi-view data, Spectral clustering, Co-proximity},
 pages = {112919},
 title = {Multi-view spectral clustering based on considering co-proximity of views},
 url = {https://www.sciencedirect.com/science/article/pii/S0031320325015821},
 volume = {174},
 year = {2026}
}
