@conference{Lang20111320,
 abstract = {In this paper we present a method for unsupervised semantic role induction which we formalize as a graph partitioning problem. Argument instances of a verb are represented as vertices in a graph whose edge weights quantify their role-semantic similarity. Graph partitioning is realized with an algorithm that it-eratively assigns vertices to clusters based on the cluster assignments of neighboring vertices. Our method is algorithmically and conceptually simple, especially with respect to how problem-specific knowledge is incorporated into the model. Experimental results on the CoNLL 2008 benchmark dataset demonstrate that our model is competitive with other unsupervised approaches in terms of Fl whilst attaining significantly higher cluster purity. © 2011 Association for Computational Linguistics.},
 author = {Lang, Joel and Lapata, Mirella},
 journal = {EMNLP 2011 - Conference on Empirical Methods in Natural Language Processing, Proceedings of the Conference},
 note = {Cited by: 36},
 pages = {1320 - 1331},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unsupervised semantic role induction with graph partitioning},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/80053274076?origin=resultslist},
 year = {2011}
}
