 keyword = {3D MRI with CT-Like bone contrast, A novel evaluation method, Magnetic resonance angiography, Vertebral artery course},
 pages = {e166-e173},
 title = {A Novel Evaluation for Vertebral Artery Course Using 3D Magnetic Resonance Imaging with Computed Tomography -like Bone Contrast and Magnetic Resonance Angiography: A Proof of Concept Study},
