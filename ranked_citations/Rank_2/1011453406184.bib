@article{10.1145/3406184,
 abstract = {Adaptive shading is an effective mechanism for reducing the number of shaded pixels to a subset of the image resolution with minimal impact on final rendering quality. We present a new scheduling method based on on-chip tiles that, along with relatively minor modifications to the GPU architecture, provides efficient hardware support. As compared to software implementations on current hardware using compute shaders, our approach dramatically reduces memory bandwidth requirements, thereby significantly improving performance and energy use. We also introduce the concept of a fragment pre-shader for programmatically controlling when a fragment shader is invoked, and describe advanced techniques for utilizing our approach to further reduce the number of shaded pixels via temporal filtering, or to adjust rendering quality to maintain stable framerates.},
 address = {New York, NY, USA},
 articleno = {11},
 author = {Mallett, Ian and Yuksel, Cem and Seiler, Larry},
 doi = {10.1145/3406184},
 issue_date = {August 2020},
 journal = {Proc. ACM Comput. Graph. Interact. Tech.},
 keyword = {adaptive shading, deferred shading, graphics hardware},
 month = {August},
 number = {2},
 numpages = {17},
 publisher = {Association for Computing Machinery},
 title = {Efficient Adaptive Deferred Shading with Hardware Scatter Tiles},
 url = {https://doi.org/10.1145/3406184},
 volume = {3},
 year = {2020}
}
