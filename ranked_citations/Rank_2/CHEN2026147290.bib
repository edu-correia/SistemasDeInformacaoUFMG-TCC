@article{CHEN2026147290,
 abstract = {Purpose
Understanding why Chinese farmers decide to adopt—or not adopt—low-carbon practices is crucial for steering the country's agricultural greening. This paper builds an integrated framework that brings together psychological motives, livelihood assets, and institutional settings to explain farmers' decision-making as a whole.
Methodology
We combine the Sustainable Livelihood Approach (SLA) with the Theory of Planned Behavior (TPB) to form a comprehensive model. Data were collected from 742 rice growers in four provinces in China, and the model was tested with Partial Least Squares Structural Equation Modeling (PLS-SEM).
Findings
Three main patterns emerge: Firstly, Livelihood capital, farmers’ perception of the environment, and policy support all relate positively to both the intention to practice low-carbon agriculture and the actual behavior. Secondly, A clear “intention-behavior gap” appears, driven largely by cooperatives: while cooperative membership strongly boosts intention (β = 0.502, p < 0.001), it simultaneously suppresses real-world action (β = −0.127, p < 0.001). Thirdly, Integration into supply chains has the strongest direct impact on behavior (β = 0.581, p < 0.001), effectively narrowing the gap. Moreover, policy support not only raises livelihood capital (β = 0.444, p < 0.001) but also directly encourages implementation (β = 0.185, p < 0.001).
Originality & value
By merging SLA and TPB, the study uncovers distinct pathways that shape intention versus actual practice, highlighting the paradoxical role of organizational contexts. The results suggest a shift in policy focus: leverage supply-chain incentives to drive concrete actions, and redesign cooperatives to move beyond fostering intention toward providing the technical and financial support needed for on-the-ground implementation.},
 author = {Deliang Chen and Wenhua Chen and Jun Qiao Shen and Wei Fang},
 doi = {https://doi.org/10.1016/j.jclepro.2025.147290},
 issn = {0959-6526},
 journal = {Journal of Cleaner Production},
 keyword = {Low-carbon agriculture, Farmers, Implementation intention, Implementation, Behavior, Influencing factors, PLS-SEM},
 pages = {147290},
 title = {What factors influence farmers’ intention and behavior in implementing low-carbon agriculture: An empirical analysis within a comprehensive framework},
 url = {https://www.sciencedirect.com/science/article/pii/S0959652625026472},
 volume = {538},
