@conference{McNeill201941,
 abstract = {One of the most difficult aspects of developing matching systems – whether for matching ontologies or for other types of mismatched data – is evaluation. The accuracy of matchers are usually evaluated by measuring the results produced by the systems against reference sets, but gold-standard reference sets are expensive and difficult to create. In this paper we introduce crptr, which generates multiple variations of different sorts of dataset, where the degree of variation is controlled, in order that they can be used to evaluate matchers in different context. Copyright 2019 for this paper by its authors.},
 author = {McNeill, Fiona and Bental, Diana and Gray, Alasdair J.G. and Jedrzejczyk, Sabina and Alsadeeqi, Ahmad},
 journal = {CEUR Workshop Proceedings},
 note = {Cited by: 1},
 pages = {41 - 45},
 publication_stage = {Final},
 source = {Scopus},
 title = {Generating corrupted data sources for the evaluation of matching systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85077984036?origin=resultslist},
 volume = {2536},
 year = {2019}
}
