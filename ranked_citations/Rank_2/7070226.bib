@inproceedings{7070226,
 abstract = {The overwhelming flood of data from sensors attached to the Internet of Things "IoT" will undoubtedly create a high demand for energy efficient dynamic green information systems. To support this demand, we introduce C-SenZ-IS, a technical and ecological business model for a customized environmental reporting service [1]. At the heart of this system is a prevailing wireless sensor network "WSN" and supporting cloud middleware that together collects data feeds, processes data, and distributes data streams. These streams are assembled from data analytics algorithms that merge customer requests with "best match" sensor feed (s). Our model ensures that such a system will perform to its highest technical, ecological, and social potential.},
 author = {Lawson, Victor J. and Watson, Richard T. and Ramaswamy, Laksmish},
 booktitle = {2015 48th Hawaii International Conference on System Sciences},
 doi = {10.1109/HICSS.2015.411},
 issn = {1530-1605},
 keyword = {Feeds;Business;Green products;Biological system modeling;Wireless sensor networks;Clouds;Energy efficiency;WSN;sensor;internet of things;green information systems},
 month = {Jan},
 number = {},
 pages = {3414-3423},
 title = {C-SenZ-IS: A Customizable Sensor IS Model for Energy Efficient SaaS},
 volume = {},
 year = {2015}
}
