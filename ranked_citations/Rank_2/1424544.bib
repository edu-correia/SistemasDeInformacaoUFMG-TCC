@inproceedings{1424544,
 abstract = {We develop algorithms to efficiently build trellises for various full-rate MIMO codes. By full-rate, we refer to codes for multiple antenna systems whose rate scales with the minimum of the number of transmit and receive antennas, e.g., BLAST and the linear dispersion codes of Hassibi and Hochwald. This is in part inspired by the so-called super-orthogonal codes, which build efficient trellises on orthogonal block space-time codes (e.g. the Alamouti code). Unfortunately that approach cannot be directly transferred to a code with insufficient structure, because set partitioning over an irregular set, such as the one represented by an arbitrary space-time code, is not straightforward. The central contribution of this paper is an efficient set partitioning algorithm for an arbitrary set. We then built trellises for the resulting set partitions and demonstrate via simulations the gains obtained by such trellis codes.},
 author = {Janani, M. and Nosratinia, A.},
 booktitle = {IEEE Wireless Communications and Networking Conference, 2005},
 doi = {10.1109/WCNC.2005.1424544},
 issn = {1558-2612},
 keyword = {Convolutional codes;Space time codes;MIMO;Partitioning algorithms;Receiving antennas;Multimedia communication;Laboratories;Electronic mail;Channel coding;Wireless communication},
 month = {March},
 number = {},
 pages = {461-465 Vol. 1},
 title = {Generalized block space-time trellis codes: set-partitioning and code design},
 volume = {1},
 year = {2005}
}
