@inproceedings{4387532,
 abstract = {This paper presents a new low-power memory-efficient trace-back (TB) scheme for high constraint length Viterbi decoder (VD). With the trace-back modifications and path merging techniques, up to 50% memory read operations in the survivor memory unit (SMU) can be reduced. The memory size of SMU can be reduced by 33% and the decoding latency can be reduced by 14%. The simulation results show that compared to the conventional TB scheme, the performance loss of this scheme is negligible.},
 author = {Chen, Lupin and He, Jinjin and Wang, Zhongfeng},
 booktitle = {2007 IEEE Workshop on Signal Processing Systems},
 doi = {10.1109/SIPS.2007.4387532},
 issn = {2162-3570},
 keyword = {Viterbi algorithm;Maximum likelihood decoding;Delay;Merging;Digital communication;Helium;Computer science;USA Councils;Performance loss;Convolutional codes},
 month = {Oct},
 number = {},
 pages = {132-135},
 title = {Design of Low-Power Memory-Efficient Viterbi Decoder},
 volume = {},
 year = {2007}
}
