@article{Parag2019354,
 abstract = {Synaptic connectivity detection is a critical task for neural reconstruction from Electron Microscopy (EM) data. Most of the existing algorithms for synapse detection do not identify the cleft location and direction of connectivity simultaneously. The few methods that computes direction along with contact location have only been demonstrated to work on either dyadic (most common in vertebrate brain) or polyadic (found in fruit fly brain) synapses, but not on both types. In this paper, we present an algorithm to automatically predict the location as well as the direction of both dyadic and polyadic synapses. The proposed algorithm first generates candidate synaptic connections from voxelwise predictions of signed proximity generated by a 3D U-net. A second 3D CNN then prunes the set of candidates to produce the final detection of cleft and connectivity orientation. Experimental results demonstrate that the proposed method outperforms the existing methods for determining synapses in both rodent and fruit fly brain. (Code at: https://github.com/paragt/EMSynConn ). © Springer Nature Switzerland AG 2019.},
 author = {Parag, Toufiq and Berger, Daniel and Kamentsky, Lee and Staffler, Benedikt and Wei, Donglai and Helmstaedter, Moritz and Lichtman, Jeff W. and Pfister, Hanspeter},
 doi = {10.1007/978-3-030-11024-6_25},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {354 - 364},
 publication_stage = {Final},
 source = {Scopus},
 title = {Detecting synapse location and connectivity by signed proximity estimation and pruning with deep nets},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85061692910?origin=resultslist},
 volume = {11134 LNCS},
 year = {2019}
}
