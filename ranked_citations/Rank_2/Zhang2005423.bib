@conference{Zhang2005423,
 abstract = {Image fusion is an important tool in remote sensing. To date, most research activities have been focusing on the fusion of optical high-resolution panchromatic with low-resolution multispectral images. Since many high-resolution radar amplitude images are also available for daily operations, the need for the fusion of high-resolution radar images with low-resolution multispectral images is increasing. This paper presents a new wavelet approach for the fusion of radar amplitude images and optical multispectral images. A wavelet transform is utilized to extract spatial detail from the radar amplitude images, and then inject the detail into the multispectral images. An intensity-hue-saturation (IHS) technique is utilized to ensure a smooth integration between spatial feature and spectral information from different data sources. The proposed approach is tested with Star 3 airborne SAR amplitude images and Landsat TM, ASTER and SPOT multispectral images, provided by Intermap Technologies Ltd. Satisfactory results are achieved for the fusion of all the SAR amplitude images and TM, ASTER and SPOT multispectral images available to this research.},
 author = {Zhang, Yun and Hong, Gang and Mercer, J. Bryan and Edwards, Dan and Maduck, Joel},
 journal = {WMSCI 2005 - The 9th World Multi-Conference on Systemics, Cybernetics and Informatics, Proceedings},
 note = {Cited by: 1},
 pages = {423 - 428},
 publication_stage = {Final},
 source = {Scopus},
 title = {A wavelet approach for the fusion of radar amplitude and optical multispectral images},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84867377362?origin=resultslist},
 volume = {8},
 year = {2005}
}
