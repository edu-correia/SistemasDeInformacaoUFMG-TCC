@inproceedings{9390046,
 abstract = {The accuracy and stability of laser fringe center extraction are very important for surface measurement in 3D measurement based on linear structured light. At present, most algorithms of fringe center extraction are easy to have the problem of line breaking and are sensitive to strong light; The complex high-order free-form surface is taken as the experimental object in this paper. On the one hand, due to its high-order derivability at any point on the surface, the light scattering problem is serious and this leads to the line breaks at the slope surface. On the other hand, in order to realize complete measurement of free-form surface, strong illumination condition is needed but most fringe center extraction algorithms are sensitive to strong light. To solve the above problems, this paper proposes a gray gravity center method merging R channel. The algorithm firstly carries out median filtering operation on the fringe image, then extracts the R channel and obtains the binary image by using the fixed threshold segmentation technique. In order to improve the accuracy of extraction, morphological operation is carried out for the binary image to remove the interference area. In order to further improve the real-time performance of processing, contour processing is used to find the target stripe area and gray gravity center method is carried out in the area. Experimental results show that the proposed method has good real-time performance and resistance to line breaks and strong light.},
 author = {Hongsheng, Shi and Zhenwei, Wang and Hong, Chen},
 booktitle = {2021 IEEE 2nd International Conference on Big Data, Artificial Intelligence and Internet of Things Engineering (ICBAIE)},
 doi = {10.1109/ICBAIE52039.2021.9390046},
 issn = {},
 keyword = {Three-dimensional displays;Surface resistance;Surface morphology;Laser stability;Real-time systems;Data mining;Gravity;component;merge R channel;free-form surface;gray gravity center method;fringe center extraction},
 month = {March},
 number = {},
 pages = {88-92},
 title = {Fringe Center Extraction for Free Surface Measurement Based on R Channel},
