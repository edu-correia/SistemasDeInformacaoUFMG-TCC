@conference{Piasecki2018,
 abstract = {The paper presents construction of large scale test datasets for word embeddings on the basis of a very large wordnet. They were next applied for evaluation of word embedding models and used to assess and compare the usefulness of different word embeddings extracted from a very large corpus of Polish. We analysed also and compared several publicly available models described in literature. In addition, several large word embeddings models built on the basis of a very large Polish corpus are presented. © 2018 Global WordNet Association. All rights reserved.},
 author = {Piasecki, Maciej and Czachor, Gabriela and Janz, Arkadiusz and Kaszewski, Dominik and Kȩdzia, Paweł},
 journal = {GWC 2018 - 9th Global WordNet Conference},
