@article{Alvarez2025,
 abstract = {In this work, we introduce a framework to combine arbitrary image segmentation algorithms from different agents under data privacy constraints to produce an aggregated prediction set satisfying finite-sample risk control guarantees. We leverage distribution-free uncertainty quantification techniques in order to aggregate deep neural networks for image segmentation tasks. Our method can be applied in settings to merge the predictions of multiple agents with arbitrarily dependent prediction sets. Moreover, we perform experiments in medical imaging tasks to illustrate our proposed framework. Our results show that the framework reduced the empirical false positive rate by 50% without compromising the false negative rate, with respect to the false positive rate of any of the constituent models in the aggregated prediction algorithm. © 2025 by the authors.},
 author = {Alvarez, Joaquin and Roman-Rangel, Edgar},
 doi = {10.3390/math13111711},
 journal = {Mathematics},
 note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
 number = {11},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Aggregating Image Segmentation Predictions with Probabilistic Risk Control Guarantees},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105007773456?origin=resultslist},
 volume = {13},
 year = {2025}
}
