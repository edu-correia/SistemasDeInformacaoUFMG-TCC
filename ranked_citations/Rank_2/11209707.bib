@inproceedings{11209707,
 abstract = {The fast growth of false news across digital channels is a serious challenge to public confidence and societal stability. This research offers an implementation-based study that compares the performance of several classification techniques, such as machine learning and deep learning models, for detecting false news. We study the impact of merging numerous data types (e.g., text, photos, and user information) using multimodal techniques and various fusion strategies. Analyses on various and efficient datasets reveal that both classifier selection and multimodal integration are critical to boosting detection accuracy. These results illustrate the benefits of combining optimized multimodal systems with robust classification algorithms to improve false news detection.},
 author = {Yadav, Vaishnavi and Kamble, Shreya and Panmand, Prajyot and Patil, Paras and Patil, Uma},
 booktitle = {2025 2nd International Conference on Computing and Data Science (ICCDS)},
 doi = {10.1109/ICCDS64403.2025.11209707},
 issn = {},
 keyword = {Deep learning;Accuracy;Merging;Data science;Boosting;Stability analysis;Multisensory integration;Classification algorithms;Fake news;fake news detection;multimodal learning;classification algorithms;machine learning;deep learning},
 month = {July},
 number = {},
 pages = {1-5},
 title = {Fake News Detection: A Multi-Model Approach Using Hybrid Machine Learning Techniques},
 volume = {},
 year = {2025}
}
