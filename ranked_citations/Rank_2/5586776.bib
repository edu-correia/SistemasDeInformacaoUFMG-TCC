@inproceedings{5586776,
 abstract = {As fMRI data is high dimensional, applications like connectivity studies, normalization or multivariate analyses, need to reduce data dimension while minimizing the loss of functional information. In our study we use connectivity profiles as a new functional feature to aggregate voxels into clusters. This offers two major advantages in comparison with the current clustering methods. It allows the analyst to deal with the spatial correlation of noise problem, that can lead to bad mergings in the functional domain, and it is based on the whole data independently of a priori information like the General Linear Model (GLM) regressors. We validated that the resulting clusters form a partition of the data in homogeneous regions according to both spatial and functional criteria.},
 author = {Emeriau, S. and Blanchard, F. and Poline, JB. and Pierot, L. and Bittar, E.},
 booktitle = {2010 2nd International Conference on Image Processing Theory, Tools and Applications},
 doi = {10.1109/IPTA.2010.5586776},
 issn = {2154-512X},
 keyword = {Correlation;Noise;Clustering methods;Measurement;Equations;Merging;Clustering algorithms;fMRI;unsupervised clustering;feature extraction;connectivity profile;noise},
 month = {July},
 number = {},
 pages = {38-43},
 title = {Connectivity feature extraction for spatio-functional clustering of fMRI data},
 volume = {},
 year = {2010}
}
