@article{EFA2025100449,
 abstract = {In critical applications, lightweight design methods such as topology optimization (TO), lattice structures (LS) and lattice-infilled topology optimization (LTO) are key to enhancing stiffness and reducing mass. However, applying load-adaptive lattice infill in complex geometries remains challenging. This study evaluates TO, LS, and LTO techniques for Ti-6Al-4 V, focusing on safety margins, compressive strength, and stiffness using a novel hybrid metamaterial unit cell (FBCore), which merges Face Cantered Cubic (FCC) and Body Centered Cubic (BCC) unit cells via a core-centric design. FBCore outperformed BCC, FCC, and their combination, proving its effectiveness in complex geometries. TO reduced mass and volume by 61.1 %, ideal for weight-sensitive uses, while LS achieved the highest reduction (78.1 %), suited for ultra-lightweight needs. LTO offered a balanced 67.8 % reduction, maintaining structural integrity. TO improved stiffness-to-weight ratio; LS enhanced strength-to-weight with reduced stiffness. LTO combined these benefits for optimal performance and material efficiency. Validation showed the method's accuracy, with an average error of just 3.5 %, confirming its suitability for optimizing complex designs.},
 author = {Dame Alemayehu Efa and Dejene Alemayehu Ifa and Naol Dessalegn Dejene},
 doi = {https://doi.org/10.1016/j.nexres.2025.100449},
 issn = {3050-4759},
 journal = {Next Research},
 keyword = {Hybrid metamaterials, Additive manufacturing, Topology optimization, Lattice structures},
 number = {3},
 pages = {100449},
 title = {Computational design of hybrid metamaterials: Optimized topology and lattice infill for complex multi-geometric structures},
 url = {https://www.sciencedirect.com/science/article/pii/S3050475925003197},
 volume = {2},
 year = {2025}
}
