@inproceedings{8472409,
 abstract = {This paper presents a new Analog fuzzifier structure as the first block in a fuzzy system. This system is going to be used in parallel with a digital processor to handle some of its mathematical operations, so the input must be a digital signal. The proposed structure not only converts the crisp input to a fuzzy value as a fuzzifier, but also plays the role of digital to Analog convertor (DAC) in the main fuzzy system. In fact, the fuzzifier and the DAC blocks are merged to eliminate concerns about area and power consumption, which are critical parameters in signal and image processing systems. To do this cascode current sources with binary increasing in gate size are utilized to generate rising and falling analog signals, which form a single membership function (MF). The fuzzifier input is an 8-bit digital signal and the output is an analog current with five (MF)s having S, Z and triangular shapes. The circuit is simulated in If-spice, at 0.18 micron technology. The resultant power consumption, chip size and computation speed are $\pmb{116}\ \boldsymbol{\mu} \mathbf{w},\ \pmb{340}\boldsymbol{\mu}\ \mathbf{m}^{2}$ and 100MFILIPS as well.},
 author = {Moradkhani, Baran and Rezaeii, Ali Baradaran and Dilmaghani, Mehdi Sefidgar},
 booktitle = {Electrical Engineering (ICEE), Iranian Conference on},
 doi = {10.1109/ICEE.2018.8472409},
 issn = {},
 keyword = {Fuzzy systems;Conferences;Power demand;Electrical engineering;Switches;Integrated circuits;Shape;Fuzzy system;fuzzifier;DAC;current mirror},
 month = {May},
 number = {},
 pages = {269-272},
 title = {Merging DAC and Fuzzifier Structures As a New Approach in Membership Function Generation},
 volume = {},
