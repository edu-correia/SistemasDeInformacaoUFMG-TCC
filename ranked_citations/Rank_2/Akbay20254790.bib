 pages = {4790 - 4797},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Hybrid CMSA-Column Generation Approach to Variable-Sized Bin Packing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105024448877?origin=resultslist},
