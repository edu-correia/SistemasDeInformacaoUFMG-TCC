@inproceedings{5533326,
 abstract = {In this paper we will present the notation for modeling business processes called Business Process Modeling Notation (BPMN). Differences between all versions of BPMN (BPMN 1.0, BPMN 1.1, BPMN 1.2, and BPMN 2.0) are described. After that description, a presentation of workflow patterns will follow. Our research includes 43 types of control-flow patterns. Research was also based on the comparative analysis of supporting BPMN 2.0 elements with control-flow patterns performance support.},
 author = {Kous, Katja},
 booktitle = {The 33rd International Convention MIPRO},
 doi = {},
 issn = {},
 keyword = {Pattern analysis;Unified modeling language;Performance analysis;Informatics;Computer science;Programming;Petri nets;Routing;Merging;Bridges},
 month = {May},
 number = {},
 pages = {315-319},
 title = {Comparative analysis versions of BPMN and its support with Control-flow patterns},
 volume = {},
 year = {2010}
}
