@inproceedings{11365255,
 abstract = {Transformer-based models have recently shown great potential in 3D medical image segmentation. However, their deployment remains limited by high computational costs, especially when applied to volumetric brain magnetic resonance imaging (MRI) data. In this study, we propose two models: SegFormer3D with the Efficient Paired Attention mechanism(SegFormer3DEPA), which designed to enhance spatial and channel feature learning, and SegFormer3D with BiMatch Attention mechanism(SegFormer3D-BMA), which utilizes the to reduce computational complexity through intelligent token merging, serve as replacements for the original Efficient Self-Attention mechanism in SegFormer3D. Extensive experiments on the BraTS 2021 dataset show that SegFormer3D-EPA improvement of 3.6 %. Remarkably, the SegFormer3D-BMA variant, with only $\mathbf{4. 5 M}$ parameters, achieve 4.3 % improvement gain over the original SegFormer3D - while being 6.89x faster in inference. On the ACDC dataset, SegFormer3D-EPA reach a Dice score of 91.29 %, outperforming SegFormer3D (90.96 %). SegFormer3D-BMA further pushes the performance to $\mathbf{9 2. 2 3 \%}$ Dice with just $\mathbf{4. 4 M}$ parameters, marking a 1.27 % improvement over SegFormer3D. These results demonstrate that SegFormer3DEPA and SegFormer3D-BMA not only achieves state-of-the-art segmentation performance but also maintains a lightweight and computationally efficient design, making it highly suitable for real-time clinical applications in resource-constrained environments. Code: https://github.com/NhatNam0608/Segformer3DPlusPlus},
 author = {Nam-Huynh, Nhat and Binh-Tran, Trong},
 booktitle = {2025 RIVF International Conference on Computing and Communication Technologies (RIVF)},
 doi = {10.1109/RIVF68649.2025.11365255},
 issn = {2473-0130},
 keyword = {Representation learning;Image segmentation;Solid modeling;Three-dimensional displays;Magnetic resonance imaging;Computational modeling;Brain modeling;Transformers;Computational efficiency;Biomedical imaging;3D medical image segmentation;SegFormer3D-EPA;SegFormer3D-BMA;efficient paired attention;BiMatch attention},
 month = {Dec},
 number = {},
 pages = {848-853},
 title = {SegFormer3D-BMA: Enhancing 3D Medical Image Segmentation with BiMatch Attention Mechanisms},
 volume = {},
 year = {2025}
}
