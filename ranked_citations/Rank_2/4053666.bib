@inproceedings{4053666,
 abstract = {In this paper, a new radius based clustering algorithm is proposed. Its main objective is to map the distributions of the data by utilising the premise that clusters are determined by a distance parameter, without any specification of the number of clusters. The proposed clustering algorithm is enhanced by a reliable validity index to choose the best clustering result for the given input parameter. Additionally, the proposed clustering algorithm is enhanced with a partial supervision strategy to act as a classifier.},
 author = {Salem, Sameh A. and Nandi, Asoke K.},
 booktitle = {2006 16th IEEE Signal Processing Society Workshop on Machine Learning for Signal Processing},
 doi = {10.1109/MLSP.2006.275567},
 issn = {2378-928X},
 keyword = {Clustering algorithms;Signal processing algorithms;Partitioning algorithms;Iterative algorithms;Electronic mail;Tree data structures;Merging;Vector quantization;Prototypes;Size control},
 month = {Sep.},
 number = {},
 pages = {313-318},
 title = {Novel Clustering Algorithm (RACAL) and a Partial Supervision Strategy for Classification},
 volume = {},
 year = {2006}
}
