@conference{Liu202011572,
 abstract = {Recently, vision-and-language grounding problems, e.g., image captioning and visual question answering (VQA), has attracted extensive interests from both academic and industrial worlds. However, given the similarity of these tasks, the efforts to obtain better results by combining the merits of their algorithms are not well studied. Inspired by the recent success of federated learning, we propose a federated learning framework to obtain various types of image representations from different tasks, which are then fused together to form finegrained image representations. The representations merge useful features from different vision-and-language grounding problems, and are thus much more powerful than the original representations alone in individual tasks. To learn such image representations, we propose the Aligning, Integrating and Mapping Network (aimNet). The aimNet is validated on three federated learning settings, which include horizontal federated learning, vertical federated learning, and federated transfer learning. Experiments of aimNet-based federated learning framework on two representative tasks, i.e., image captioning and VQA, demonstrate the effective and universal improvements of all metrics over the baselines. In image captioning, we are able to get 14% and 13% relative gain on the taskspecific metrics CIDEr and SPICE, respectively. In VQA, we could also boost the performance of strong baselines by up to 3%. Copyright © 2020, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
 author = {Liu, Fenglin and Wu, Xian and Ge, Shen and Fan, Wei and Zou, Yuexian},
 journal = {AAAI 2020 - 34th AAAI Conference on Artificial Intelligence},
 note = {Cited by: 112},
 pages = {11572 - 11579},
 publication_stage = {Final},
 source = {Scopus},
 title = {Federated learning for vision-and-language grounding problems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85102072345?origin=resultslist},
 year = {2020}
}
