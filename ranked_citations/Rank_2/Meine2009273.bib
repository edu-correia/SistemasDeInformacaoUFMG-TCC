@article{Meine2009273,
 abstract = {This article shows how the interactive segmentation tool termed "Active Paintbrush" and a fully automatic region merging can both be based on the theoretical framework of contraction kernels within irregular pyramids instead of their own, specialized data structures. We introduce "continous pyramids" in which we purposely drop the common requirement of a fixed reduction factor between successive levels, and we show how contraction kernels can be annotated for a fast navigation of such pyramids. Finally, we use these concepts for improving the integration of the automatic region merging and the interactive tool. © 2009 Springer Berlin Heidelberg.},
 author = {Meine, Hans},
 doi = {10.1007/978-3-642-02124-4_28},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {273 - 282},
 publication_stage = {Final},
 source = {Scopus},
 title = {Annotated contraction kernels for interactive image segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70349828922?origin=resultslist},
 volume = {5534 LNCS},
 year = {2009}
}
