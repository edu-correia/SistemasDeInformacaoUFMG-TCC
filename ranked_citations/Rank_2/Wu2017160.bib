@conference{Wu2017160,
 abstract = {This paper present an improved Manifold ranking based saliency detection method. Our method constructs a similarity matrix to represent the connection between each superpixel of image. To achieve the optimization, we select some foreground regions as the foreground labels, by using the objective likelihood map technique, and a part of boundary regions as background labels, by using color distinction measure. Based on these prior information, we generate the rough results by manifold ranking algorithm, and merge the results, obtaining our final saliency map. To verify the robustness of our proposed algorithm, we conduct extensive experiments. © 2017 IEEE.},
 author = {Wu, Xiabao and Lin, Xiao and Jiang, Linhua and Zhao, Dongfang},
 doi = {10.1109/ICSAI.2017.8248282},
 journal = {2017 4th International Conference on Systems and Informatics, ICSAI 2017},
 note = {Cited by: 1},
 pages = {160 - 164},
 publication_stage = {Final},
 source = {Scopus},
 title = {An improved manifold ranking based method for saliency detection},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85046621955?origin=resultslist},
 volume = {2018-January},
 year = {2017}
}
