@conference{Zhao2026378,
 abstract = {The escalating scale and sophistication of contemporary computing systems have rendered efficient and precise log parsing indispensable for reliable system monitoring and root-cause analysis. Existing log parsing approaches often suffer from limited semantic understanding, poor generalization, and inefficiency in handling large-scale log data. This paper proposes a scalable log parsing method called ParSimMerge, based on parallelized similarity-based merge optimization. By integrating regular expression preprocessing for variable parameter extraction, a multi-layer partitioning strategy based on log length and mapping relationships, and an optimized event template merging mechanism leveraging cosine similarity and Longest Common Subsequence (LCS) metrics, ParSimMerge combines the POP parallel strategy, IPLoM hierarchical clustering, and SLCT heuristic rules to achieve a better balance between semantic comprehension and parsing efficiency. Experimental evaluations on diverse log datasets show that when the cosine similarity threshold is set to above 0.8 and the LCS ratio exceeds 0.8, ParSimMerge achieves a parsing accuracy of 0.93284, representing a 5.5% improvement over state-of-the-art methods, while maintaining high scalability for large-scale system logs. © 2026 Copyright held by the owner/author(s).},
 author = {Zhao, Yichu},
 doi = {10.1145/3801228.3801287},
 journal = {Proceedings of 2026 5th International Conference on Big Data, Information and Computer Network, BDICN 2026},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {378 - 384},
 publication_stage = {Final},
 source = {Scopus},
 title = {ParSimMerge: A Scalable Log Parser based on Parallelized Similarity-based Merge Optimization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105038005167?origin=resultslist},
