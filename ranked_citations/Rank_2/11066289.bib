@inproceedings{11066289,
 abstract = {Mixed Reality (MR) technologies are becoming increasingly prevalent across various domains, including medical education, the automotive industry, and aerospace engineering. These systems allow for the integration of virtual objects into real- world scenarios, creating immersive and interactive environments. However, despite their widespread adoption, relatively little is known about how humans perceive subtle variations in the size of virtual objects when merged with real-world contexts, particularly in comparison to real physical objects. Understanding these perceptual differences is essential for identifying potential limitations of MR systems and optimizing their effectiveness in precision-critical applications. This study aimed to investigate human size perception within an MR environment using the HoloLens 2 headset, specifically assessing how accurately individuals can discriminate object size at different distances. To achieve this, a psychophysical experiment was conducted employing a two-alternative forced- choice (2AFC) paradigm to measure size discrimination thresholds. Participants were asked to compare real and virtual spheres presented at two different distances, allowing researchers to determine whether MR technology alters size perception relative to real-world conditions. The findings revealed that size discrimination accuracy for virtual objects in MR was highly comparable to that of real objects. This suggests that the HoloLens 2 effectively preserves size-related perceptual cues, ensuring reliable spatial judgments. These results validate the use of MR for applications requiring precise size perception, reinforcing its potential for medical simulations, industrial training, and psychophysical research. The study highlights the robustness of MR in maintaining perceptual fidelity, confirming its viability as a tool for experimental and professional applications where accurate object perception is essential.},
 author = {Bertolasi, Jessica and Garcia Hernandez, Nadia Vanessa and Gori, Monica},
 booktitle = {2025 IEEE Medical Measurements & Applications (MeMeA)},
 doi = {10.1109/MeMeA65319.2025.11066289},
 issn = {2837-5882},
 keyword = {Visualization;Accuracy;Surgery;Mixed reality;Virtual reality;Size measurement;Software;Robustness;Psychophysics;Visual perception;human perception;mixed reality environment;visual size perception;HoloLens2;perceptual equivalence},
 month = {May},
 number = {},
 pages = {1-5},
 title = {Assessing Human Size Perception in Real and Mixed-Reality Environments},
 volume = {},
 year = {2025}
}
