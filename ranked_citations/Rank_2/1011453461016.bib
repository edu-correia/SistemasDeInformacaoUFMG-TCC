 issue_date = {June 2021},
 journal = {ACM Trans. Evol. Learn. Optim.},
 keyword = {Evolutionary computing, software engineering, search based software engineering, SBSE, software maintenance of empirical constants, data transplantation, glibc, vector normalisation, Newton’s method},
 month = {July},
 number = {2},
 numpages = {30},
 publisher = {Association for Computing Machinery},
 title = {Genetic Improvement of Data for Maths Functions},
