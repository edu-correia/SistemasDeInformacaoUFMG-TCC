@article{Gonçalves201299,
 abstract = {Detecting, much less understanding, the difference between two description logic based ontologies is challenging for ontology engineers due, in part, to the possibility of complex, non-local logic effects of axiom changes. First, it is often quite difficult to even determine which concepts have had their meaning altered by a change. Second, once a concept change is pinpointed, the problem of distinguishing whether the concept is directly or indirectly affected by a change has yet to be tackled. To address the first issue, various principled notions of semantic diff (based on deductive inseparability) have been proposed in the literature and shown to be computationally practical for the expressively restricted case of -terminologies. However, problems arise even for such limited logics as: First, computation gets more difficult, becoming undecidable for logics such as which underly the Web Ontology Language (OWL). Second, the presence of negation and disjunction make the standard semantic difference too sensitive to change: essentially, any logically effectual change always affects all terms in the ontology. In order to tackle these issues, we formulate the central notion of finding the minimal change set based on model inseparability, and present a method to differentiate changes which are specific to (thus directly affect) particular concept names. Subsequently we devise a series of computable approximations, and compare the variously approximated change sets over a series of versions of the NCI Thesaurus (NCIt). © 2012 Springer-Verlag Berlin Heidelberg.},
 author = {Gonçalves, Rafael S. and Parsia, Bijan and Sattler, Ulrike},
 doi = {10.1007/978-3-642-35176-1_7},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 4; All Open Access; Bronze Open Access},
 number = {PART 1},
 pages = {99 - 115},
 publication_stage = {Final},
 source = {Scopus},
 title = {Concept-based semantic difference in expressive description logics},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84868581775?origin=resultslist},
 volume = {7649 LNCS},
 year = {2012}
}
