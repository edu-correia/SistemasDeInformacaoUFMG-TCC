@inproceedings{11368025,
 abstract = {Generating image captions is a very important task in the field of AI. The rise of deep learning methods has driven the development of advanced models that merge image feature extraction with natural language processing, enabling systems to generate captions that are both coherent and meaningful. Image captioning requires identifying key objects, understanding their relationships, and creating a description that flows naturally, with proper grammar. Our approach uses a convolutional neural network (CNN) for extracting visual features and a long short-term memory (LSTM) network for generating natural language captions. The model is trained and evaluated on the Flickr8k dataset. Additionally, beam search and T5 refinement have been included to enhance fluency and coherence.},
 author = {B, Dharun Pranaav K and Sosale, Eshaan and D’costa, Jaikumar Emannuel and Ugarakhod, Rashmi},
 booktitle = {2025 IEEE 17th International Conference on Computational Intelligence and Communication Networks (CICN)},
 doi = {10.1109/CICN67655.2025.11368025},
 issn = {2472-7555},
 keyword = {Training;Visualization;Adaptation models;Accuracy;Computational modeling;Feature extraction;Convolutional neural networks;Long short term memory;Context modeling;Videos;Image Captioning;CNN;Xception;LSTM;Beam search},
 month = {Dec},
 number = {},
 pages = {1444-1448},
 title = {Image Captioning Using Xception and LSTM with Refinement and Beam Search for Accuracy Improvement},
 volume = {},
 year = {2025}
}
