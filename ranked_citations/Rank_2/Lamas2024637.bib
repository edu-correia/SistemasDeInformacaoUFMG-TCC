@conference{Lamas2024637,
 abstract = {3D point cloud data is a commonly used data form. Numerous works have been conducted on semantic and instance segmentation of this data format. However, preparing a point cloud to meet the requirements of a segmentation model can be complicated. A typical requirement is to specify the maximum size or a fix number of points. Here, we introduce a methodology for cropping point clouds and merging them after the segmentation process. The method aims to maximise the points that are repeated between crops to use their labels to merge the instances and compute the average semantic probabilities. © 2024 Proceedings of the 31st International Workshop on Intelligent Computing in Engineering, EG-ICE 2024. All rights reserved.},
 author = {Lamas, Daniel and Soilán, Mario and Riveiro, Belén},
 journal = {Proceedings of the 31st International Workshop on Intelligent Computing in Engineering, EG-ICE 2024},
 note = {Cited by: 0},
 pages = {637 - 646},
 publication_stage = {Final},
 source = {Scopus},
 title = {CROPMERGE: a method for cropping and merging point clouds to facilitate semantic and instance segmentation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85207215086?origin=resultslist},
 year = {2024}
}
