@inproceedings{10860072,
 abstract = {As the digital world continues to grow, the need for robust and secure authentication systems to protect sensitive information has never been more important. This paper introduces a developing approach to login security by combining QR Code technology with the highly regarded RSA Signature Scheme (Rivest-Shamir-Adleman) and Advanced Encryption Standard (AES). This combination aims to significantly improve login security. Traditional username-password based authentication is vulnerable to phishing attacks, password compromise, cyber exploits, intellectual property theft, brute force attacks. On the other hand, RSA has built a strong reputation, mainly because it uses a strong encryption scheme that makes it extremely difficult for the agent to get access to sensitive data. This two-factor authentication system provides security, while ensuring user convenience by merging the RSA and AES algorithms with QR codes. This paper aims to combine QR code-based login consistently with existing digital platforms, using the strengths of both RSA and AES encryption. This dual-layered security approach was created to attain significant advancements in protecting information on an international scale while ensuring ease of use for the end-user. In addition, the paper will address possible challenges such as key management and the development of effective authentication and access control mechanisms, making sure a complete and secure authentication solution. Also, 4 different combinations of algorithms are compared, out of which RSA and AES are the best combinations ever.},
 author = {Lahari, Busam Venkata and Dhathri, Busireddy and Nithin, G and C.R., Kavitha},
 booktitle = {2024 9th International Conference on Communication and Electronics Systems (ICCES)},
