@inproceedings{11117094,
 abstract = {Graph Neural Networks (GNNs) are commonly applied in graph anomaly detection. Despite their success in mining structured data, traditional GNNs often encounter issues like over-smoothing and information loss. when dealing with sparse and heterogeneous neighborhoods, limiting their effectiveness in anomaly detection. To tackle these challenges, we introduce a new framework, GraphGLA which improves node representation by enhancing homogeneous neighbor features. Specifically, we design a node discriminator to classify neighbors as homogeneous or heterogeneous, and then leverage a Conditional Variational Autoencoder (CVAE)[1] to generate additional homogeneous neighbor features. The generated features are subsequently merged with the original feature set and used for anomaly detection via a Graph Attention Network (GAT). Experiments on three public anomaly detection datasets show that GraphGLA greatly outperforms existing methods. This approach effectively mitigates the impact of sparse and heterogeneous neighborhoods on anomaly detection, providing robust and accurate detection capabilities.},
 author = {Yang, Shuaitao and Fu, Wenwen},
 booktitle = {2025 8th International Symposium on Big Data and Applied Statistics (ISBDAS)},
 doi = {10.1109/ISBDAS64762.2025.11117094},
 issn = {},
 keyword = {Limiting;Accuracy;Autoencoders;Big Data;Feature extraction;Graph neural networks;Sparse matrices;Anomaly detection;Gaph Neural Networks;Anomaly Detection;Conditional Variational Autoencoder},
 month = {Feb},
 number = {},
 pages = {140-143},
 title = {GraphGLA: Enhancing Graph Neural Networks with Generative Local Feature Augmentation for Anomaly Detection},
 volume = {},
 year = {2025}
}
