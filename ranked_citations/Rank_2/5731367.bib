@inproceedings{5731367,
 abstract = {This paper introduces a construction technique for a new runlength limited modulation 2/4,(1,2,4,4) code intended for binary asymmetrical constraints according to C. Menyennett and H.C. Ferreira (1995). The code design is made accordingly to the runlength limited principles according to K.A. Schouhamer Immink (1991). The state merging algorithms were used to deduce the final coding graph. The codec structure and the power spectrum of binary maxentropic asymmetrical code are presented.},
 author = {Diaconu, F.},
 booktitle = {Signals, Circuits and Systems, 2003. SCS 2003. International Symposium on},
 doi = {10.1109/SCS.2003.1227134},
 issn = {},
 keyword = {Codes;Encoding;Vectors;Decoding;Optical signal processing;Eigenvalues and eigenfunctions;Codecs;Channel capacity;Optical recording;Merging},
 month = {July},
 number = {},
 pages = {641-644 vol.2},
 title = {An investigation of the runlength limited 2/4,(1,2,4,4) code for binary asymmetric channels [runlength read runlength]},
 volume = {2},
 year = {2003}
}
