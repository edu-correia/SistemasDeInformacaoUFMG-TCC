@article{WANG2023443,
 abstract = {Existing models for classifying pest images require a wide range of labeled training images, which is typically labour-intensive to obtain in real applications. To overcome this limitation, many existing studies rely on unsupervised deep metric learning (UDML) to make full use of the similarity of unlabeled pest images. However, they still have two limitations: (i) the clustering using only image modalities has performance bottlenecks and there is no semantic similarity in learned metric space; (ii) the taxonomic structure of pests has not been fully explored. To address these issues, we propose a novel UDML-based pest image classification method called Multi-modal Pseudo-Information guided unsupervised deep metric learning (MmPI) for agricultural pest images, where reliable and effective pseudo-labels are extracted from unlabeled multi-modal agricultural data. Specifically, we use the joint features of ground-truth images and pseudo-captions for clustering to generate highly reliable pseudo-labels. Moreover, to generate pseudo-labels with different levels of granularities, we propose an improved Hierarchical Pseudo-Label Generation Algorithm (HPLGA) in which split intervals of different granularities are obtained by re-clustering the merging distances generated in the process of hierarchical clustering. We compare MmPI with ten state-of-the-art (SOTA) UDML-based methods on the multimodal pest dataset APTV-99. The results show that compared with the that ten methods, our proposed method improves by 4.88%, 4.24% and 10.26% in terms of NMI, Recall@1 and F1, respectively.},
 author = {Shansong Wang and Qingtian Zeng and Xue Zhang and Weijian Ni and Cheng Cheng},
 doi = {https://doi.org/10.1016/j.ins.2023.02.030},
 issn = {0020-0255},
 journal = {Information Sciences},
 keyword = {Unsupervised learning, Deep metric learning, Multi-modal similarity learning, Hierarchical clustering, Agricultural pest image},
 pages = {443-462},
 title = {Multi-modal pseudo-information guided unsupervised deep metric learning for agricultural pest images},
 url = {https://www.sciencedirect.com/science/article/pii/S0020025523002190},
 volume = {630},
 year = {2023}
}
