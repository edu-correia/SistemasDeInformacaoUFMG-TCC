@inproceedings{11228984,
 abstract = {Due to the excellent ability of the eventic graph in event relationship modeling, it has achieved significant success in the field of event analysis. However, existing domain-specific eventic graph construction methods require the integration of substantial amounts of domain prior knowledge, which renders them inadequate for use in other domains. In addition, general eventic graph construction methods are not optimized for different domains, but adopting a single framework for various domains is ill-suited. To address these problems, we propose a domain adaptive framework for constructing eventic graphs, which comprises three modules: the relationship event pair extraction module, the domain event generalization module, and the graph completion module. First, we extracted multi relational event pairs accurately on a large scale. Next, we adaptively mine high-frequency domain event triggers and generalize events by clustering those triggers, effectively addressing the challenge of transferring the eventic graph construction algorithm to other domains. Finally, the graph completion module mines a large number of potential event relationships based on event representation. Besides, we propose an evaluation metric for event generalization methods, which is capable of measuring their superiority effectively. We showcase the feasibility of our method in a case study using diplomacy news, and extensive experiments confirm its superior performance.},
 author = {Liu, Haibo and Wang, Shengze and Shen, Jing},
 booktitle = {2025 International Joint Conference on Neural Networks (IJCNN)},
 doi = {10.1109/IJCNN64981.2025.11228984},
 issn = {2161-4407},
 keyword = {Measurement;Visualization;Analytical models;Adaptation models;Pipelines;Neural networks;Clustering algorithms;Robustness;eventic grpah construct;event generalization;domain-adaptive},
 month = {June},
 number = {},
 pages = {1-8},
 title = {A Domain-Adaptive Framework for Constructing Eventic Graphs},
 volume = {},
 year = {2025}
}
