@article{Slinko2020146,
 abstract = {A secret sharing scheme implemented in an organisation is designed to reflect the power structure in that organisation. When two organisations merge, this usually requires a number of substantial changes and, in particular, changes to their secret sharing schemes which have to be merged in the way which reflects a new role of each of the organisations. This study looks at the ways secret sharing scheme can be modified when organisational changes occur. The authors restrict themselves with the class of ideal linear secret sharing schemes and describe how matrices of these linear schemes have to be modified when they take the sum, the product or the composition of two linear access structures. © The Institution of Engineering and Technology 2019},
 author = {Slinko, Arkadii},
 doi = {10.1049/iet-ifs.2019.0210},
 journal = {IET Information Security},
 note = {Cited by: 2; All Open Access; Bronze Open Access; Green Open Access},
 number = {1},
 pages = {146 - 150},
 publication_stage = {Final},
 source = {Scopus},
 title = {Ways to merge two secret sharing schemes},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85077209719?origin=resultslist},
 volume = {14},
 year = {2020}
}
