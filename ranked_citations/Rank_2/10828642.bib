 doi = {10.1109/IC3I61595.2024.10828642},
 issn = {},
 keyword = {Sharding;Fault tolerance;Automation;Scalability;Smart contracts;Fault tolerant systems;Big Data;Proof of Work;Blockchains;Encryption;Decentralized storage;Cryptographic hashing;Proof-of-Work;Blockchain integrity;Sharding mechanism;Fault tolerance;Compliance automation;Smart contract execution;Privacy-preserving encryption},
 month = {Sep.},
