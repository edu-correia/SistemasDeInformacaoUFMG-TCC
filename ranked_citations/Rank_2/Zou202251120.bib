@article{Zou202251120,
 abstract = {The depth map compression of 3D High-Efficiency Video Coding (3D-HEVC) inherits prediction structure adopted by HEVC and develops supplementary coding modes to better express depth image. These new coding modes combine with existing technology implement high coding efficiency, but lead to an extremely huge increase in coding time. This article proposes a rapid coding method for depth map in 3D-HEVC. The proposed scheme utilizes the Bayesian decision rule and the correlations between corresponding texture video and spatially adjacent treeblocks to analyze the treeblock features of depth map. According to the analysis, we propose two approaches, including early SKIP/Merge mode selection, and adaptive CU pruning termination. Simulation consequences illustrate that this paper can save 51.2% complexity while maintaining the rate distortion (RD) performance.  © 2013 IEEE.},
 author = {Zou, Dongyao and Dai, Pu and Zhang, Qiuwen},
 doi = {10.1109/ACCESS.2022.3174119},
 journal = {IEEE Access},
 note = {Cited by: 8; All Open Access; Gold Open Access},
 pages = {51120 - 51127},
 publication_stage = {Final},
 source = {Scopus},
 title = {Fast Depth Map Coding Based on Bayesian Decision Theorem for 3D-HEVC},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85130842740?origin=resultslist},
 volume = {10},
 year = {2022}
}
