@article{10.1145/3733610,
 abstract = {Constructing k-nearest neighbor (kNN) graphs is a fundamental component in many machine learning and scientific computing applications. Despite its prevalence, efficiently building all-nearest-neighbor graphs at scale on distributed heterogeneous HPC systems remains challenging, especially for large sparse non-integer datasets. We introduce optimizations for algorithms based on forests of random projection trees. Our novel GPU kernels for batched, within leaf, exact searches achieve 1.18\texttimes{} speedup over sparse reference kernels with less peak memory, and up to 19\texttimes{} speedup over CPU for memory-intensive problems. Our library, PyRKNN, implements distributed randomized projection forests for approximate kNN search. Optimizations to reduce and hide communication overhead allow us to achieve 5\texttimes{} speedup, in per iteration performance, relative to GOFMM (another projection tree, MPI-based kNN library), for a 64M 128d dataset on 1,024 processes. On a single-node we achieve speedup over FAISS-GPU for dense datasets and up to 10\texttimes{} speedup over CPU-only libraries. PyRKNN uniquely supports distributed memory kNN graph construction for both dense and sparse coordinates on CPU and GPU accelerators.},
 address = {New York, NY, USA},
 articleno = {8},
 author = {Ruys, William and Ghafouri, Ali and Chen, Chao and Biros, George},
 doi = {10.1145/3733610},
 issn = {2329-4949},
 issue_date = {September 2025},
 journal = {ACM Trans. Parallel Comput.},
 keyword = {Randomized projection trees, sparse datasets, distributed parallel computing},
 month = {June},
 number = {3},
 numpages = {35},
 publisher = {Association for Computing Machinery},
 title = {Scalable KNN Graph Construction for Heterogeneous Architectures},
 url = {https://doi.org/10.1145/3733610},
 volume = {12},
 year = {2025}
}
