@conference{Nankabirwa2025576,
 abstract = {This landscape study aims to provide an understanding of Large Language Models (LLMs), especially with a view point of supporting scientific and community queries for climate resilience and preparedness. Typically, for queries related to climate resilience and preparedness, the data span multiple heterogeneous sources and are complex by nature. Scientists as well as communities seek answers to real-world questions from LLMs, yet the accuracy of the feedback is not always guaranteed to be consistent and free of hallucinations. Given the complex landscape and the number of LLM models available, the choice of a model becomes complex too. In addition, LLM ensemble models are also taking on an important role where high level of trustworthiness and accuracy is needed. To address this gap, we performed a review of the LLM research landscape, identifying common themes. This was followed by a deep dive into ensemble models. We evaluate the ensembles as well as a popular single LLM model (that is, ChatGPT) with two sample queries: (i) 'Are there any linkages between sea ice retreat and ice shelf melt in the Antarctic?', (ii) 'What is the best crop for sandy soils?'. The responses were assessed for robustness and accuracy by the domain expert. Through our analysis we concluded that a single LLM provides a parameter free setup whereas the ensemble models needed fine tuning to arrive to robust outcomes. However, the paper does not address ensemble performance issues and neither does it diminish their importance. Instead, this indicates that a lot more research is needed to get ensembles to a more user-friendly and approachable state of use unlike single LLMs. We also outline criteria that an ensemble model selection will need to consider such as initial model selection, retraining, ensemble optimization, energy utilization. © 2025 IEEE.},
 author = {Nankabirwa, Rhoda and Janeja, Vandana},
 doi = {10.1109/ICDMW69685.2025.00071},
 journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
