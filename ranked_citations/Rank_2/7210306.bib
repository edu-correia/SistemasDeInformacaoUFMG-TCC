@inproceedings{7210306,
 abstract = {Nowadays cloud computing is widely used to provide different kinds of services such as, maintaining data and applications, scalable processing, storing data, access management, employing virtualization and other internet applications to its user. As there are benefits of the cloud services, on the other hand there are risks as well that might face the cloud providers, companies or individuals when using cloud computing services. One of the major risks is securing and providing privacy of data in cloud computing infrastructure. In this paper a novel method has been proposed for securing and providing privacy of data in cloud computing infrastructure. The data has been divided into parts and encryption has been performed on the data through a control access on the data. Experiments have been performed for splitting data and encrypting the data based on the proposed method. The result shows the proposed method is an efficient method which can be used as an academic tool for demonstrating cloud computing applications providing privacy and security of the cloud data.},
 author = {Aldakheel, Maram Abdullatif and Rahman, Sk Md Mizanur and Al-Zahrani, Rasheed and El-Qawasmeh, Eyas},
 booktitle = {2015 2nd World Symposium on Web Applications and Networking (WSWAN)},
 doi = {10.1109/WSWAN.2015.7210306},
 issn = {},
 keyword = {Cloud computing;Servers;Encryption;Receivers;Organizations;cloud computing;security;cloud-provider;split and merge},
 month = {March},
 number = {},
 pages = {1-6},
 title = {Investigation of security challenges and a novel security mechanism for cloud computing environment},
 volume = {},
 year = {2015}
}
