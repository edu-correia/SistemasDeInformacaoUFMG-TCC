@inproceedings{11467731,
 abstract = {Neuro-symbolic AI system are increasingly developed and deployed in various societal domains and applications. However, considerations and efforts dedicated to tackling their exposure to various security threats remain behind this technological advancement. To address this gap, this research proposes a novel computational model for security assessment of neurosymbolic AI models by merging insights from Knowledge Representation and Reasoning (KRR) and complexity theory perspectives in order to capture threats, attack vectors, vulnerabilities, and multi-dimensional impacts spanning neural, symbolic, and integration surfaces that neuro-symbolic AI systems have. The model encodes the causal representation and value-conditioned rules while accounting for both architectural elements of the models as well as various potential attack vectors that would be able to exploit and engage them. This is done following a Design Science Research methodological approach where the evaluation is conducted for demonstration purposes through a simulation use case in which an adaptive adversary exploits neural privacy weaknesses and interface-level reasoning faults. The results show that the model yields consistent and explainable assessments of security risks that such models have and provides actionable awareness of prioritizing relevant security controls across coupled neural and symbolic components of these systems.},
 author = {Maathuis, Clara},
 booktitle = {2026 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)},
 doi = {10.1109/ACDSA67686.2026.11467731},
 issn = {},
 keyword = {Telemetry;Payloads;Weapons;Aerospace and electronic systems;Feedback;Circuits;Communication systems;Internet;Protocols;Radio access networks;Neuro-Symbolic AI;Neuro-Symbolic;AI security;security assessment},
 month = {Feb},
 number = {},
 pages = {1-6},
 title = {Neuro-Symbolic AI Security Attack Assessment Computational Model},
 volume = {},
 year = {2026}
}
