@inproceedings{10547964,
 abstract = {Our research merges electrical engineering with ophthalmology, creating a semantic segmentation model for retinal fluid analysis, optimized for edge devices. Enhancing CFPNet with lightweight structures and attention mechanisms, the model is efficient and accurate, trained on annotated retinal Optical Coherence Tomography (OCT) Images. With less than a million parameters, it achieves high Dice coefficients in lesion segmentation, improving medical imaging portability and utility, especially in remote areas, and offering potential advances in clinical image processing and engineering fields.},
 author = {Lin, Chih-Wei and Lu, Cheng-Kai and Tang, Tong Boon},
 booktitle = {2024 10th International Conference on Applied System Innovation (ICASI)},
 doi = {10.1109/ICASI60819.2024.10547964},
 issn = {2768-4156},
 keyword = {Analytical models;Technological innovation;Fluids;Image edge detection;Semantic segmentation;Optical coherence tomography;Lightweight structures;Retinal Fluid;edge device;lightweight;medical imaging technology;Optical Coherence Tomography (OCT)},
 month = {April},
 number = {},
 pages = {202-204},
 title = {Efficient Integration of Lightweight Semantic Segmentation for Retinal Fluid Analysis on Edge Devices},
 volume = {},
 year = {2024}
}
