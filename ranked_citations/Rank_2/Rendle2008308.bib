@article{Rendle2008308,
 abstract = {Record linkage is a central task when information from different sources is integrated. Record linkage models use so-called blockers for reducing the search space by discarding obviously different record pairs. In practice, important problems have Zipf distributed class sizes with some large classes where blocking is not applicable any more. Therefore we propose two novel meta algorithms for scaling arbitrary record linkage models to such data sets. The first one parallelizes problems by creating overlapping subproblems and the second one reduces the search space for large classes effectively. Our evaluation shows that both scaling techniques are effective and are able to scale state-of-the-art models to challenging datasets. © 2008 Springer-Verlag Berlin Heidelberg.},
 author = {Rendle, Steffen and Schmidt-Thieme, Lars},
 doi = {10.1007/978-3-540-68125-0_28},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 8},
 pages = {308 - 319},
 publication_stage = {Final},
 source = {Scopus},
 title = {Scaling record linkage to non-uniform distributed class sizes},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/44649119286?origin=resultslist},
 volume = {5012 LNAI},
 year = {2008}
}
