@inproceedings{9148567,
 abstract = {Aiming at the problems of small size, diversified scale and high detection difficulty of the target image to be detected, this paper proposes a target image detection method based on East optimization algorithm. By changing the connection mode of single neural network, the oblique rectangular box prediction is realized, and the multi-scale feature fusion method is introduced to optimize the EAST algorithm. The experimental results show that the method proposed in this paper has better prediction speed and accuracy, and the detection performance of small target image is good, which can achieve stable target image detection.},
 author = {Huang, Hanwen and Yu, Yang and Lin, Yuluo and Zhang, Yan and Cai, Yijia and Li, Jinze and Deng, Dingsheng},
 booktitle = {2020 International Conference on Computer Information and Big Data Applications (CIBDA)},
 doi = {10.1109/CIBDA50819.2020.00116},
 issn = {},
 keyword = {Feature extraction;Prediction algorithms;Object detection;Training;Semantics;Convolution;Merging;detection;East;multi-scale;fusion},
