@inproceedings{1693248,
 abstract = {Quadrature SigmaDelta ADCs require a feedback path for both the I and the Q part of the complex feedback signal. If two separated multibit feedback DACs are used, mismatch among the unit DAC elements leads to additional mismatch noise in the output spectrum as well as an unbalance between the I and Q DAC. This paper proposes a new quadrature bandpass mismatch shaping technique. In our approach the I and Q DACs are merged into one complex DAC, which leads to near-perfect I/Q balance. To select the unit DAC elements of the complex, multibit DAC, the well-known tree structured element selection logic is generalized toward a complex structure and necessary conditions for its correct operation are derived. Finally, a very efficient first-order quadrature shaper implementation is proposed and simulations show the effectiveness of the quadrature bandpass mismatch shaping technique},
 author = {Reekmans, S. and De Maeyer, J. and Rombouts, P. and Weyten, L.},
 booktitle = {2006 IEEE International Symposium on Circuits and Systems},
 doi = {10.1109/ISCAS.2006.1693248},
 issn = {2158-1525},
 keyword = {Feedback;Digital signal processing;Radio frequency;Analog-digital conversion;Filters;Mixers;RF signals;Circuit noise;Signal processing;Information systems},
 month = {May},
 number = {},
 pages = {4 pp.-},
 title = {Quadrature mismatch shaping with a complex, tree structured DAC},
 volume = {},
 year = {2006}
}
