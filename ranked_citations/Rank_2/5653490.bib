@inproceedings{5653490,
 abstract = {Extended macroblock size (EMS) improves the highest possible coding efficiency for the current video coding standards, but a large number of additional candidate coding modes results in high computational expense. In this paper, the correlation among different modes is exploited to drastically reduce the number of candidate modes in EMS. And a fast inter-mode decision algorithm for EMS is proposed based on above facts. Furthermore, a split and merge technology is used to find the optimal partitioning with computational efficiency. Experimental results show that the proposed fast inter-mode decision algorithm reduces the computational complexity significantly with negligible coding lost.},
 author = {Lu, Jiyuan and Zhang, Peizhao and Chao, Hongyang},
 booktitle = {2010 IEEE International Conference on Image Processing},
 doi = {10.1109/ICIP.2010.5653490},
 issn = {2381-8549},
 keyword = {Software algorithms;Partitioning algorithms;Software;Video coding;Algorithm design and analysis;Automatic voltage control;Medical services;Video coding;extended macroblock size;inter-mode decision;split;merge},
 month = {Sep.},
 number = {},
 pages = {2081-2084},
 title = {A split and merge algorithm for inter-mode decision in extended macroblocks},
 volume = {},
 year = {2010}
}
