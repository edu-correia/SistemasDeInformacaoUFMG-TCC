@conference{Shen2018,
 abstract = {The update performance in erasure-coded data centers is often bot-tlenecked by the constrained cross-rack bandwidth. We propose CAU, a cross-rack-aware update mechanism that aims to mitigate the cross-rack update traffic in erasure-coded data centers. CAU builds on three design elements: (i) selective parity updates, which select the appropriate parity update approach based on the update pattern and the data layout to reduce the cross-rack update traffic; (ii) data grouping, which relocates and groups updated data chunks in the same rack to further reduce the cross-rack update traffic; and (iii) interim replication, which stores a temporary replica for each newly updated data chunk. We evaluate CAU via trace-driven analysis, local cluster experiments, and Amazon EC2 experiments. We show that CAU enhances state-of-the-arts by mitigating the cross-rack update traffic as well as maintaining high update performance in both local cluster and geo-distributed environments. © 2018 Association for Computing Machinery.},
 author = {Shen, Zhirong and Lee, Patrick P. C.},
 doi = {10.1145/3225058.3225065},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 26},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cross-rack-aware updates in erasure-coded data centers},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85054841034?origin=resultslist},
 year = {2018}
}
