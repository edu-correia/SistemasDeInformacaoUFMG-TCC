@conference{Ala'anzy2025,
 abstract = {Traditional merge sort algorithms exhibit performance limitations on contemporary hardware architectures due to significant memory overhead and suboptimal use of parallel computing capabilities. This study addresses these challenges by conducting a systematic review and comparative analysis of hybrid merge sort variants, specifically focusing on adaptive algorithms (such as timsort, peeksort, and powersort), parallel implementations, and memory-optimized approaches (lazy merge sort, in-place recursive merge sort). Through detailed theoretical evaluations and extensive empirical benchmarking across diverse datasets (sorted and unsorted), clear context-dependent performance patterns emerged. Timsort consistently demonstrated superior efficiency with partially ordered data, while parallel merge sort significantly improved runtime performance for large-scale data processing tasks on multicore systems. In contrast, In-place variants substantially reduced memory usage but at the expense of higher runtime overhead, especially notable with larger datasets. The novelty and originality of this paper lie in its unique comprehensive analysis of hybrid merge sort algorithms from both theoretical and practical perspectives, offering concrete insights and a robust decision-making framework tailored to modern computational environments. © 2025 IEEE.},
 author = {Ala'anzy, Mohammed Alaa and Kakimgali, Samrat and Yeskermes, Bakdaulet and Yessenova, Perizat and Abilbek, Zhangyl and Shoganova, Inkar},
 doi = {10.1109/ICECET63943.2025.11472533},
 journal = {International Conference on Electrical, Computer, and Energy Technologies, ICECET 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Hybrid Merge Sort Algorithms: A Review},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105037148113?origin=resultslist},
 year = {2025}
}
