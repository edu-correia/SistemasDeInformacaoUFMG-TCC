@article{10.1109/TNET.2018.2830414,
 abstract = {To achieve low TCP flow completion time FCT in data center networks DCNs, it is critical and challenging to rapidly recover loss without adding extra congestion. Therefore, in this paper, we propose a novel loss recovery approach fast multi-path loss recovery FUSO that exploits multi-path diversity in DCN for transport loss recovery. In FUSO, when a multi-path transport sender suspects loss on one sub-flow, recovery packets are immediately sent over another sub-flow that is not or less lossy and has spare congestion window slots. FUSO is fast in that it does not need to wait for timeout on the lossy sub-flow, and it is cautious in that it does not violate the congestion control algorithm. Testbed experiments and simulations show that FUSO decreases the latency-sensitive flows’ $99^{th}$ percentile FCT by up to ~82.3% in a 1-Gb/s testbed, and up to ~87.9% in a 10 Gb/s large-scale simulated network.},
 author = {Chen, Guo and Lu, Yuanwei and Meng, Yuan and Li, Bojie and Tan, Kun and Pei, Dan and Cheng, Peng and Luo, Layong and Xiong, Yongqiang and Wang, Xiaoliang and Zhao, Youjian},
 doi = {10.1109/TNET.2018.2830414},
 issn = {1063-6692},
 issue_date = {June 2018},
 journal = {IEEE/ACM Trans. Netw.},
 month = {June},
 number = {3},
 numpages = {14},
 pages = {1376–1389},
 publisher = {IEEE Press},
 title = {FUSO: Fast Multi-Path Loss Recovery for Data Center Networks},
 url = {https://doi.org/10.1109/TNET.2018.2830414},
 volume = {26},
 year = {2018}
}
