@inproceedings{6510209,
 abstract = {In this paper, we propose a VLSI implementation scheme for region split and merge image segmentation. Region splitting is done using a parallel pixel network. We propose a modified merging criterion to reduce the execution time and corresponding hardware implementation is also proposed. We have shown the modified merge criterion will reduce the number of merging iteration steps. Implementation results are encouraging as the processing time in hardware with a 100MHz clock in XILINX VIRTEX IV FPGA is achieved a few order lower than the software implementation.},
 author = {Roy, Pradipta and Das, Dipak and Biswas, P K},
 booktitle = {2012 IEEE International Conference on Computational Intelligence and Computing Research},
 doi = {10.1109/ICCIC.2012.6510209},
 issn = {},
 keyword = {Merging;Image segmentation;Hardware;Bars;Software algorithms;Timing;Software;Image edge detection;Connectors;Very large scale integration;Image Segmentation;FPGA;Split and Merge},
 month = {Dec},
 number = {},
 pages = {1-8},
 title = {Real time VLSI implementation of a fast split and merge segmentation algorithm},
 volume = {},
 year = {2012}
}
