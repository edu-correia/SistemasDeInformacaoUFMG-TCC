@inproceedings{5702125,
 abstract = {We consider the generalized minimum vertex-biconnected network problem (GMVBCNP). Given a graph where nodes are partitioned into clusters, the goal is to find a minimal cost sub graph containing exactly one node from each cluster and satisfying the vertex-biconnectivity constraint. The problem is NP-hard. The GMVBCNP has applications in the design of survivable backbone networks when single component outages are considered. We propose a Memetic Algorithm with two crossover operators, three mutation operators, and a local search component based on two neighborhood structures. Furthermore, two different population management approaches are investigated. Experimental results document the efficiency of the new approach. In particular, the local search component and the population management strategies have a substantial impact on solution quality as well as running time.},
 author = {Pagacz, Anna and Hu, Bin and Raidl, Gunther R.},
 booktitle = {2010 International Conference on Intelligent Networking and Collaborative Systems},
 doi = {10.1109/INCOS.2010.22},
 issn = {},
 keyword = {Memetics;Clustering algorithms;Joining processes;Merging;Image edge detection;Algorithm design and analysis;Optimization;network design;biconnectivity;memetic algorithm;local search;population management},
 month = {Nov},
 number = {},
 pages = {356-361},
 title = {A Memetic Algorithm with Population Management for the Generalized Minimum Vertex-Biconnected Network Problem},
 volume = {},
 year = {2010}
}
