@article{Li20161291,
 abstract = {Structural health monitoring (SHM) uses building vibration responses from online sensors to diagnose and evaluate possible structural damages. This is a data classification process. Normal data mining methods, such as data clustering and support vector machine (SVM), cannot classify these online data streams directly. In this paper, the convex-concave hull and SVM are modified into online versions, such that the novel data classifiers for the SHM can be trained online. We design a laboratory-scale prototype for the experiment evaluation. The experiment results show that the proposed SHM algorithms can be trained online and detect the damage successfully. © 2007-2012 IEEE.},
 author = {Li, Xiaoou and Yu, Wen and Villegas, Salvador},
 doi = {10.1109/JSYST.2015.2481380},
 journal = {IEEE Systems Journal},
 note = {Cited by: 29},
 number = {3},
 pages = {1291 - 1300},
 publication_stage = {Final},
 source = {Scopus},
 title = {Structural Health Monitoring of Building Structures with Online Data Mining Methods},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84944088663?origin=resultslist},
 volume = {10},
 year = {2016}
}
