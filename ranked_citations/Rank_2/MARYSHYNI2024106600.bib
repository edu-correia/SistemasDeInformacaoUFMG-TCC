@article{MARYSHYNI2024106600,
 abstract = {Respiratory ailments are conditions that hinder the efficient functioning of the respiratory system and are a prominent cause of mortality globally with potential triggers including smoking, hereditary factors or pathogens. Chronic unattended lung diseases can result in lung carcinoma or even respiratory collapse. Prompt screening for respiratory ailments is thus crucial as it allows for therapeutic approaches to limit the contamination of the infection, potentially reducing the mortality rate. X-ray imaging, the primary imaging procedure for lung abnormality detection may not reveal delicate information in certain conditions. This research introduces a novel deep learning model called PulmonNet V1 that produces promising outcomes by learning more intricate features from the X-ray images. PulmonNet V1 aims to enhance the performance of pulmonary abnormality detection by leveraging the benefits of Leaky ReLU activation, merging local and global features, and network widening. The proposed model outperforms the existing pre-trained models with an impressive accuracy rate of 97.14%. The robustness of the model is assessed through the utilization of real-time data samples, resulting in an accuracy rate of 97.62%.},
 author = {H. {Mary Shyni} and E. Chitra},
 doi = {https://doi.org/10.1016/j.bspc.2024.106600},
 issn = {1746-8094},
 journal = {Biomedical Signal Processing and Control},
 keyword = {Deep Learning, Lung Diseases, Feature Concatenation, Leaky ReLU Activation, Chest X-rays},
 pages = {106600},
 title = {PulmonNet V1: Leveraging the benefit of Leaky ReLU activation for the local and multi-scale global feature integration of chest radiographs to classify pulmonary diseases},
 url = {https://www.sciencedirect.com/science/article/pii/S174680942400658X},
 volume = {96},
 year = {2024}
}
