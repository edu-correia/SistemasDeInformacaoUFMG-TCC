@incollection{DASHAN2024341,
 abstract = {As the newest member of the 2D particle family, MXene (MaX) has been the subject of many studies. One of the most essential properties of MaX is its electrical conductivity, which makes these particles an ideal option for electromagnetic interference shielding applications. Also, MaX has excellent mechanical properties, such as resistance to wear, stretching, and bending; MaX’s thermal performance, such as thermal stability and thermal conductivity, and its adaptability make it an excellent option for use in various applications. Merging MaX with the polymer can significantly increase its applications and correct the inherent defects of polymers. In addition, integrating MaX nanohybrids with polymers can create a synergistic effect, which, as a result, increases the system’s efficiency in various applications.},
 author = {Ali Dashan and Kaveh Sharifi and Bahram Ramezanzadeh},
 booktitle = {MXenes as Surface-Active Advanced Materials},
 doi = {https://doi.org/10.1016/B978-0-443-13589-7.00001-8},
 editor = {Mumtaz A. Quraishi and Chandrabhan Verma and Elyor Berdimurodov},
 isbn = {978-0-443-13589-7},
 keyword = {MXene, EMI shielding, thermomechanical, 2D materials},
 pages = {341-377},
 publisher = {Elsevier},
 series = {Micro and Nano Technologies},
 title = {14 - 2D-MXenes nanosheets/polymer composites’ electromagnetic shields, mechanical and thermal properties},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443135897000018},
 year = {2024}
}
