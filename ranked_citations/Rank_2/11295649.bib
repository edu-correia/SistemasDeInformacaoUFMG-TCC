@inproceedings{11295649,
 abstract = {In this study, an energy-time optimal path planning and control for space dual-arm robot is proposed for a large space structure on-orbit assembly. First, based on the geometric structure, the kinematic relations of the end-effectors between base and the dual-arm robot are obtained while the base states and the dual-arm joints are merged into a generalized state, which is then coupled with the space module, and the coupled differential kinematic relations between the space module and the generalized state are established by the Jacobian matrix under non-conserved momenta circumstance. Next, based on the Lagrange equation, the coupled dynamic equation of the space module and generalized state is established. By introducing the path coordinates and considering the torque, velocity and acceleration constraints, the problem is reformulated into a convex second-order cone program (SOCP) problem, which ensures the global optimality of the required path. Finally, the effectiveness of the proposed method is verified by numerical simulations.},
 author = {Li, Chenhong and Chen, Da and Xu, Shidong},
 booktitle = {2025 IEEE International Conference on Unmanned Systems (ICUS)},
 doi = {10.1109/ICUS66297.2025.11295649},
 issn = {2771-7372},
 keyword = {Space vehicles;Torque;Robot kinematics;Simulation;Kinematics;Aerospace electronics;Numerical simulation;Mathematical models;Convex functions;Assembly;on-orbit assembly;space dual-arm robot;energy-time optimal;convex optimization},
 month = {Sep.},
 number = {},
 pages = {1347-1352},
 title = {Optimization-Based Planning and Control of a Dual-Arm Space Robot for On-Orbit Assembly},
 volume = {},
 year = {2025}
}
