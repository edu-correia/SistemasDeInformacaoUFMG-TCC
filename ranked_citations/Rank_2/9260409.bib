@inproceedings{9260409,
 abstract = {The traditional educational reform resource merging method directly mines relevant resources based on keywords and then further processes the resources, resulting in excessively high repetition rate and incomplete rate of merging resources. Aiming at the above problems, the method of combining educational reform resources under the background of Internet+ is proposed. Use web crawlers to collect educational reform resources in the Internet, and transfer the crawled resource metadata to the server under the SOAP transmission mechanism. Use the hash function to delete the duplicate resource metadata and establish the objective function of education reform resource allocation. Solve the objective function, get the optimal resource allocation plan, and complete the research on the method of resource reform in education reform. The experimental results show that, compared with the traditional resource structuring method, after applying the proposed education reform resource structuring method to process resources, there are no incomplete resources and the proportion of duplicate resources is at most 3.7%, which can effectively improve the effect of education reform and is feasible.},
 author = {Zhao, Shuqiao and Zhang, Kezhu},
 booktitle = {2020 5th International Conference on Smart Grid and Electrical Automation (ICSGEA)},
 doi = {10.1109/ICSGEA51094.2020.00074},
 issn = {},
 keyword = {Smart grids;Conferences;Automation;Internet+;Resources for educational reform;Resource mix;Hash algorithm},
 month = {June},
 number = {},
 pages = {318-322},
 title = {Research On The Method Of Combining Educational Resources Under The Background Of Internet+},
 volume = {},
 year = {2020}
}
