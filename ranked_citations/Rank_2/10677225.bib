@inproceedings{10677225,
 abstract = {Blockchain technology's transformation of digital transactions and payments is achieved through the introduction of a decentralised ledger system. The integration of Merkle Trees within blockchain systems is explored in this study, with an investigation into how this integration impacts efficiency and security. It is found that Merkle Trees bolster data integrity, streamline transactions, and enhance the overall robustness of the blockchain architecture. The concept of Differential Merkle Trees is also introduced, a novel approach that maintains a separate, smaller Merkle Tree for recent transactions. When a new transaction is added, it is incorporated into this 'differential' tree. Periodically, the differential tree is merged back into the main tree, thereby improving performance for workloads where new transactions are frequently added and queried. The aim of this research is to provide insights into optimising Merkle Tree implementations for transactions in a blockchain, contributing to the evolution of blockchain technology.},
 author = {S, Kanthimathi and Verghese, Mahika Annie and Pamidimokkala, Sireesha},
 booktitle = {2024 IEEE International Conference on Electronics, Computing and Communication Technologies (CONECCT)},
 doi = {10.1109/CONECCT62155.2024.10677225},
 issn = {2766-2101},
 keyword = {Computer hacking;Data integrity;Merging;Computer architecture;Robustness;Blockchains;Safety;Blockchain;Merkle Tree;Differential;Security;Transaction},
 month = {July},
 number = {},
 pages = {1-5},
 title = {Periodic Integration: A Differential Approach to Merkle Tree Configuration},
 volume = {},
 year = {2024}
}
