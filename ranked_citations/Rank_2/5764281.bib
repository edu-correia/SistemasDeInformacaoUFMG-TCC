@inproceedings{5764281,
 abstract = {Moving object index method is the key technology for moving object data base, the performance of which determines the efficiency of the whole data base system. Upon the request for temporal query, this article focuses on moving object index for full temporal query, proposes a moving object index structure FT tree for temporal query, invites theories of various versions into TPR tree, improves the TPR tree that supports future query, and keeps various versions of TPR tree effectively to realize past, present and future temporal query.},
