@conference{Luo20202817,
 abstract = {The log-structured merge-tree (LSM-tree) [16, 18] is widely used in modern NoSQL systems. Different from traditional update-in-place structures, an LSM-tree first buffers all writes in memory, which are subsequently flushed to disk when memory is full. The on-disk components are usually organized into levels of exponentially increasing sizes, where a smaller level is merged into the adjacent larger level when it fills up. To bound the temporary disk space occupied by merges, modern LSM-tree implementations often range partition a disk component into many fixed-size SSTables. © 2020 Association for Computing Machinery.},
 author = {Luo, Chen},
 doi = {10.1145/3318464.3384399},
 journal = {Proceedings of the ACM SIGMOD International Conference on Management of Data},
 note = {Cited by: 14; All Open Access; Gold Open Access},
 pages = {2817 - 2819},
 publication_stage = {Final},
 source = {Scopus},
 title = {Breaking Down Memory Walls in LSM-based Storage Systems},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85086243609?origin=resultslist},
 year = {2020}
}
