@inproceedings{10075301,
 abstract = {SLAM means that the subject uses the onboard sensor to obtain the external environment information, estimate its location in the environment and build the environment map. Most of the existing SLAM algorithms are designed based on the assumption of static environment, which is still challenging in dynamic environment. To lessen the impact of dynamic objects on accuracy, a dynamic object removal approach based on deep learning and multi-view geometry was presented. To increase the system's resilience, the semantic segmentation network is utilized to recognize and eliminate previous dynamic items in the environment, and the multi-view geometry is merged to further filter the real dynamic objects in the scene. Based on the ORB-SLAM2 feature matching method, the system introduces a local map to screen more representative feature points. For the unmatched feature points, the state information of the unmatched feature points is obtained by using the high confidence point weighting operation within the extended range through the feature point extension.},
 author = {Liu, Kunshan and Zhang, Heng and Liu, Yanli and Wang, Yingzhou},
 booktitle = {2022 4th International Conference on Frontiers Technology of Information and Computer (ICFTIC)},
 doi = {10.1109/ICFTIC57696.2022.10075301},
 issn = {},
 keyword = {Geometry;Deep learning;Matched filters;Fault tolerance;Simultaneous localization and mapping;Heuristic algorithms;Semantic segmentation;component;Multiple view geometry;Dynamic object removal;Feature matching;Semantic segmentation},
 month = {Dec},
 number = {},
 pages = {863-868},
 title = {Dynamic Object Removal based on Deep Learning and Multi-view Geometry},
 volume = {},
 year = {2022}
}
