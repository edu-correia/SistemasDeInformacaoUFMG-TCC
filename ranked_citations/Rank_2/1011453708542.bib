@article{10.1145/3708542,
 abstract = {With the sheer volume of data in today’s world, archive storage systems play a significant role in persisting the cold data. Due to stringent cost concerns, one popular design is to organize disks into groups and periodically switch them to be powered on for serving user requests. Scheduling thus becomes critical for both CapEx and performance. Unfortunately, field results indicate that existing schedulers can be often suboptimal. Our further analysis suggests that the main reason is the mismatch between the ever-changing workloads and the fixed set of coarsely-configured parameters in current heuristic-based schedulers.In this article, we propose MasterPlan, a reinforcement learning (RL) based scheduler for archive storage systems. By identifying the unique characteristics of archive storage service, we design a state space and reward function for the RL agent. MasterPlan includes a continuous action encoding approach to guarantee efficient exploration, and a meta adaptation module to extract features of workload series. Experiments show that MasterPlan can achieve 1.25\texttimes{} throughput, 2.16\texttimes{} 99th latency and 1.47\texttimes{} power draw improvement compared to existing solutions.},
 address = {New York, NY, USA},
 articleno = {27},
 author = {Chen, Xinqi and Xu, Erci and Mo, Dengyao and Lu, Ruiming and Wu, Haonan and Ding, Dian and Xue, Guangtao},
 doi = {10.1145/3708542},
 issn = {1544-3566},
 issue_date = {March 2025},
 journal = {ACM Trans. Archit. Code Optim.},
 keyword = {Archive storage system, reinforcement learning},
 month = {March},
 number = {1},
 numpages = {25},
 publisher = {Association for Computing Machinery},
 title = {MasterPlan: A Reinforcement Learning Based Scheduler for Archive Storage},
 url = {https://doi.org/10.1145/3708542},
 volume = {22},
 year = {2025}
}
