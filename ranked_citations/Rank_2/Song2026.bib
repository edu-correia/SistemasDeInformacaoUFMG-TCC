@article{Song2026,
 abstract = {Multimodal three-dimensional object detection plays a crucial role in autonomous driving by integrating data from multiple sensors to improve detection accuracy. However, when fusing data from different sources, challenges such as image noise and information loss often arise, leading to an inability to fully exploit the correlation between multimodal data, thereby affecting the optimization of detection performance. To address such issues, this paper proposes a multimodal three-dimensional object detection method based on dual-branch strong feature representation and noise-resistant sparse convolution. This method constructs a dual-branch backbone network for collaborative processing of multimodal data. The 3D sparse convolution backbone with strong feature representation and noise-resistant sparse convolution based on scene importance prediction are employed to respectively learn the feature representation of point cloud and pseudo-point cloud data. Additionally, a spatial channel dual-unit cross-fusion module is designed to extract low-level spatial features and high-level abstract semantic features separately through dual channels, avoiding spatial information loss while obtaining more advanced abstract semantic information. Furthermore, this paper designs dynamic self-attention fusion feature refinement blocks to refine features multiple times and merge refined RoI results from different refinement stages, thereby improving detection accuracy. The effectiveness of the proposed components is validated through quantitative evaluation, ablation experiments, and qualitative comparisons on the popular KITTI dataset. © 2025 Elsevier B.V.},
 author = {Song, Xiaogang and Yang, Yifan and Zhou, Zhenhua and Chen, Jichen and Zhao, Qin and Hei, Xinhong},
 doi = {10.1016/j.asoc.2025.114252},
 journal = {Applied Soft Computing},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A dual-branch noise-resistant sparse convolution method for multi-modal 3D object detection in autonomous driving},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105022103041?origin=resultslist},
