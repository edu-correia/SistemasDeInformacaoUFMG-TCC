@inproceedings{8899795,
 abstract = {This paper describes the winning contribution to the 2019 IEEE GRSS Data Fusion Contest Multi-view Semantic Stereo Challenge. In this challenge, a digital surface model (DSM) and a semantic segmentation should be derived from a large number of multi-spectral WorldView-3 images. Results from 50 stereo pairs matched using Semi-Global Matching (SGM) are fused into a DSM. Semantic segmentation is performed with an ensemble of FCN networks taking as input RGB, multi-spectral and height data. Their results are then merged with pixel-wise detectors for the classes water and high vegetation. Compared to the second and third placed teams (mIOU-3 scores of 0.73 and 0.7295), our contribution reached a significantly higher score of 0.745.},
 author = {d’Angelo, Pablo and Cerra, Daniele and Azimi, Seyed Majid and Merkle, Nina and Tian, Jiaojiao and Auer, Stefan and Pato, Miguel and de los Reyes, Raquel and Zhuo, Xiangyu and Bittner, Ksenia and Krauss, Thomas and Reinartz, Peter},
 booktitle = {IGARSS 2019 - 2019 IEEE International Geoscience and Remote Sensing Symposium},
 doi = {10.1109/IGARSS.2019.8899795},
 issn = {2153-7003},
 keyword = {Semantics;Vegetation mapping;Feature extraction;Buildings;Image segmentation;Three-dimensional displays;Satellites},
 month = {July},
 number = {},
 pages = {5053-5056},
 title = {3D Semantic Segmentation from Multi-View Optical Satellite Images},
 volume = {},
 year = {2019}
}
