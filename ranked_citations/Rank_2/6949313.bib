@inproceedings{6949313,
 abstract = {Semantic web represents a technique for getting semantic information from the particular domain ontology. It involves retrieving of the data semantically through domain ontology's based on user queries. Still the merging of two or more domain specific ontology's is a tedious task. In past, various ontology merging algorithms had been anticipated based on the concept of removing overlaps. In this paper a new approach of ontology merging is proposed based on the semantic analysis that deals with same domain specific ontology's. Proposed algorithm is fully automated ontology merging algorithm which uses the class semantics and Property semantics by using Wordnet.},
 author = {Vidyarthi, Ankit and Sharma, Ankita and Sharma, Hemant and Soni, Archana},
 booktitle = {2014 5th International Conference - Confluence The Next Generation Information Technology Summit (Confluence)},
 doi = {10.1109/CONFLUENCE.2014.6949313},
 issn = {},
 keyword = {Ontologies;Merging;Semantics;Algorithm design and analysis;Educational institutions;Semantic Web;Semantic Web;Ontology merging Algorithm;Semantic based Algorithm;Ontology},
 month = {Sep.},
 number = {},
 pages = {957-961},
 title = {Domain specific ontology merging using semantics},
 volume = {},
 year = {2014}
}
