@article{Hong20261442,
 abstract = {k-means clustering is a fundamental problem in many scientific and engineering domains. The optimization problem associated with k-means clustering is nonconvex, for which standard algorithms are only guaranteed to find a local optimum. Leveraging the hidden structure of local solutions, we propose a general algorithmic framework for escaping undesirable local solutions and recovering the global solution or the ground truth clustering. This framework consists of iteratively alternating between two steps: (i) detect mis-specified clusters in a local solution, and (ii) improve the local solution by non-local operations. We discuss specific implementation of these steps, and elucidate how the proposed framework unifies many existing variants of k-means algorithms through a geometric perspective. We also present two natural variants of the proposed framework, where the initial number of clusters may be over- or under-specified. We provide theoretical justifications and extensive experiments to demonstrate the efficacy of the proposed approach. © 1989-2012 IEEE.},
 author = {Hong, Jiazhen and Qian, Wei and Chen, Yudong and Zhang, Yuqian},
 doi = {10.1109/TKDE.2025.3616858},
 journal = {IEEE Transactions on Knowledge and Data Engineering},
 note = {Cited by: 0; All Open Access; Green Open Access},
 number = {3},
 pages = {1442 - 1453},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Geometric Approach to k-Means Clustering},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105018352186?origin=resultslist},
 volume = {38},
