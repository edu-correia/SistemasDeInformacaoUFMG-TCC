@conference{Qiao202269,
 abstract = {This paper studies how B<sup>+</sup> -tree could take full advantage of modern storage hardware with built-in transparent compression. Recent years witnessed significant interest in applying log-structured merge tree (LSM-tree) as an alternative to B<sup>+</sup> - tree, driven by the widely accepted belief that LSM-tree has distinct advantages in terms of storage cost and write amplification. This paper aims to revisit this belief upon the arrival of storage hardware with built-in transparent compression. Advanced storage appliances and emerging computational storage drives perform hardware-based lossless data compression, transparent to OS and user applications. Beyond straightforwardly reducing the storage cost gap between B<sup>+</sup> -tree and LSM-tree, such storage hardware creates new opportunities to re-think the implementation of B<sup>+</sup> -tree. This paper presents three simple design techniques that can leverage such modern storage hardware to significantly reduce the B<sup>+</sup> -tree write amplification. Experiments on a commercial storage drive with built-in transparent compression show that the proposed design techniques can reduce the B<sup>+</sup> -tree write amplification by over 10× . Compared with RocksDB (a key-value store built upon LSM-tree), the enhanced B<sup>+</sup> -tree implementation can achieve similar or even smaller write amplification. © AST 2022.All rights reserved.},
 author = {Qiao, Yifan and Chen, Xubin and Zheng, Ning and Li, Jiangpeng and Liu, Yang and Zhang, Tong},
 journal = {Proceedings of the 20th USENIX Conference on File and Storage Technologies, FAST 2022},
 note = {Cited by: 30},
 pages = {69 - 82},
 publication_stage = {Final},
 source = {Scopus},
 title = {Closing the B+ -tree vs. LSM-tree Write Amplification Gap on Modern Storage Hardware with Built-in Transparent Compression},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85138606360?origin=resultslist},
 year = {2022}
}
