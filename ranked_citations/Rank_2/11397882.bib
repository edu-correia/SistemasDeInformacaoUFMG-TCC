@inproceedings{11397882,
 abstract = {This paper presents a novel symmetric bit stacking method for the design of faster and more power-efficient binary counters. Traditional counter architectures introduce significant latency and power overhead in high-speed digital circuits, particularly in multipliers, due to the presence of XOR gates and multiplexers along the critical path. The proposed approach eliminates these delay-inducing components by employing a foundational 3-bit stacking circuit, which is subsequently extended to larger counters through a systematic merging of smaller stacks. Experimental analysis demonstrates that the proposed $6: 3$ counter achieves a 0.4 % improvement in overall performance compared to conventional designs. These results validate the effectiveness of symmetric bit stacking in reducing latency, lowering power consumption, and enhancing the efficiency of large-scale multipliers, thereby addressing a critical bottleneck in modern high-performance computing systems.},
 author = {Punith, T. and Yasovardhan, A. and Victor, K. and Vallathan, G. and Harikumar, B. and Rama Chandram, V.V.S.V.S.},
 booktitle = {2025 Fourth International Conference on Smart Technologies and Systems for Next Generation Computing (ICSTSN)},
 doi = {10.1109/ICSTSN67075.2025.11397882},
 issn = {},
 keyword = {Multiplexing;Power demand;Systematics;Stacking;Computer architecture;Digital signal processing;Very large scale integration;Transistors;Next generation networking;Arithmetic;Binary Counters;Symmetric Bit Stacking;Low-Power Design;High-Speed Multipliers},
 month = {Nov},
 number = {},
 pages = {1-5},
 title = {Symmetric Bit Stacking: A High-Speed, Low-Power Design Paradigm for Binary Counters},
 volume = {},
 year = {2025}
}
