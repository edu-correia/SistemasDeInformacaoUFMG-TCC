@inproceedings{5167423,
 abstract = {This paper introduces an efficient method to compute the wavelet transform for huge 3D volume data like seismic data or 3D medical images with minimum resources. This method consists in a local data processing while reducing considerably the memory requirements. The resulting wavelet transform is identical to the one obtained if the whole 3D object was stored in memory. Experimental results show that the proposed method permits to reduce the memory requirements to the minimum with a low computation time due to the low complexity algorithm.},
 author = {Meftah, Anis and Antonini, Marc},
 booktitle = {2009 Picture Coding Symposium},
 doi = {10.1109/PCS.2009.5167423},
 issn = {},
 keyword = {Wavelet transforms;Filter bank;Low pass filters;Multiresolution analysis;Frequency;Biomedical imaging;Data visualization;Filtering;Laboratories;Data processing;Scan-based wavelet transform;lifting scheme;multiresolution analysis;filter banks},
 month = {May},
 number = {},
 pages = {1-4},
 title = {Scan-based wavelet transform for huge 3D volume data},
 volume = {},
 year = {2009}
}
