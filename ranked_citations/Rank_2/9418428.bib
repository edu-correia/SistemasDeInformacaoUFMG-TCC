@inproceedings{9418428,
 abstract = {Security has become the main issue in the current data transmission, whereas it is considered as a significant goal for vendors and providers of cloud services. Hyper elliptic curve cryptography (HECC) technique is the best cryptography approach, whereas digital signature algorithm (DSA) is also an advanced DSA However, an advanced protocol is assigned with authentication of the key agreement by the Parallel Pollard rho (PPρ) algorithm to enhance the security of the cloud environment. Hence, this paper focuses on Hyper HECC along with the technique of DSA signature that has designed together for encryption analysis. HECC technique gets transplanted into the DSA algorithm, which works on the principle of signature-based Hyper Elliptic Curve Digital Signature Algorithm (HECDSA). In order to improve the security level with less consumption of time, Inter bit exchange and merge (IBEM) pattern is considered for data as permutation and feed using substitution as S-Boxes. This proposed hybrid mechanism of enhanced encryption security scheme as HECDSA with PPp algorithm and key exchange using IBEM pattern by blowfish technique. The cryptographic performance of the data may not allow the intruders as quickly as possible to find the key mechanism that has been sending from the user. Thus, the resultant is provided with both Cloud Service Provider (CSP) and owner of the data gain enhanced security. Moreover, the proposed hybrid HECDSA-IBEM is compared with the existing encryption technique for evaluating the performance metrics based on scalability and security.},
 author = {Susilabai, S. Sweetlin and Mahendran, D. S. and John Peter, S.},
 booktitle = {2021 5th International Conference on Computing Methodologies and Communication (ICCMC)},
 doi = {10.1109/ICCMC51019.2021.9418428},
 issn = {},
 keyword = {Measurement;Cloud computing;Protocols;Heuristic algorithms;Scalability;Memory management;Throughput;Cloud Computing (CC);HECDSA;IBEM;data security;PPρ algorithm;S-Boxes},
 month = {April},
 number = {},
 pages = {10-16},
 title = {Multi-tier security for cloud environment by HECDSA with IBEM},
