@conference{Ivanova2025,
 abstract = {Rapid introduction of multiple artificial intelligence (AI) instruments in all spheres of life has been observed during the last few years. Technological development widens human possibilities and humanity has the opportunity before to support changes in natural processes, to make unprecedented progress in medical sciences, and to foresee a real connection between human mind and technology. AI tools change how information is gathered, processed, and distributed. Historically library infrastructures have proven their crucial role in the management of knowledge. It is inevitable that today's libraries, and especially research and academic libraries, face changes in their technological equipment, expertize organization, and services. A structured and well-planned engineering framework for the introduction of AI in academic and research library infrastructures leads to automation of everyday tasks, precise data analysis and better accessibility and visibility. © 2025 IEEE.},
 author = {Ivanova, Viktoriya},
 doi = {10.1109/CIEES66347.2025.11300093},
 journal = {2025 6th International Conference on Communications, Information, Electronic and Energy Systems, CIEES 2025 - Conference Proceedings},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Engineering Framework for Integration of AI Technologies in Research and Academic Library Infrastructures},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105032367351?origin=resultslist},
 year = {2025}
