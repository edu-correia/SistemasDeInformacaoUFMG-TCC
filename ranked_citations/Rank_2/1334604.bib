@inproceedings{1334604,
 abstract = {In this paper, we present a split-merge clustering segmentation algorithm based on Gaussian mixture models, which resolves the models by expectation-maximization (EM) algorithm and seeks model via Bayesian information criterion (BIC). It starts iteratively splitting from a single Gaussian model, then iteratively merging clusters. After convergence of the last stage, the clustering model is selected via a modified BIC and used to gain an initial segmentation, followed by a region merge step to achieve final segmentation. New algorithm was applied to 60 range images acquired by two kinds of range cameras, and got approving results with acceptable computation time.},
 author = {Rihua Xiang and Runsheng Wang},
 booktitle = {Proceedings of the 17th International Conference on Pattern Recognition, 2004. ICPR 2004.},
 doi = {10.1109/ICPR.2004.1334604},
 issn = {1051-4651},
 keyword = {Image segmentation;Clustering algorithms;Iterative algorithms;Tree data structures;Merging;Electronic mail;Convergence;Cameras;Design engineering;Algorithm design and analysis},
 month = {Aug},
 number = {},
 pages = {614-617 Vol.3},
 title = {Range image segmentation based on split-merge clustering},
 volume = {3},
 year = {2004}
}
