@conference{Zhang20241746,
 abstract = {Multivariate time series classification (MTSC) is crucial for various real-world applications, necessitating accurate and robust models to capture complex dependencies within the data. Transformer-based models for MTSC have recently achieved state-of-the-art performance by effectively modeling long-range dependencies and interactions. However, existing models typically capture temporal and spatial dependencies separately or merge their outputs at the final stage, which fails to fully exploit the spatial-temporal correlations. In this paper, we propose a novel Transformer-based model (STIFormer), which incorporates spatial information at multiple stages through its Spatial-Temporal Interaction Embedding (STIE) and Spatial-Temporal Interaction Attention (STIA) modules, facilitating both local and global spatial-temporal interactions to enhance MTSC. We redesign the temporal embedding module, renamed as STIE, to unveil a new method for embedding temporal tokens by utilizing cross-channel patching, spatial-temporal convolutions, and improved position encoding. Additionally, in spatial embedding module, we employ convolution to perceive positional information and use channel-wise attention to better capture spatial dependencies among variables. To achieve global spatial-temporal interactions, we introduce the STIA module, which combines temporal and spatial representations through a novel cross-attention mechanism. Experiments on 30 UEA MTSC datasets demonstrate that STIFormer has achieved the superior accuracy compared to state-of-the-art methods.  © 2024 IEEE.},
 author = {Zhang, Zhiyuan and Li, Yuankun},
 doi = {10.1109/ISPA63168.2024.00238},
 journal = {Proceedings - 2024 IEEE International Symposium on Parallel and Distributed Processing with Applications, ISPA 2024},
 note = {Cited by: 1},
 pages = {1746 - 1753},
 publication_stage = {Final},
 source = {Scopus},
 title = {STIFormer: Enhancing Multivariate Time Series Classification Through Multi-Process Spatial-Temporal Interaction},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105000122650?origin=resultslist},
 year = {2024}
}
