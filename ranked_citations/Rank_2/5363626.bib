@inproceedings{5363626,
 abstract = {This paper investigates the generic solution for remote adaptive streaming and rendering of planetary terrain. In this solution, loading and rendering speeds do not depend on the size of the database. In particular this solution avoids loading irrelevant or redundant data and requests the most important data first, and avoids costly data structure operations as much as possible, in favor of "in-place" data updates and selection using sample masks.},
 author = {Cao, Xuefeng and Wan, Gang},
 booktitle = {2009 International Conference on Information Engineering and Computer Science},
 doi = {10.1109/ICIECS.2009.5363626},
 issn = {2156-7387},
 keyword = {Data structures;Databases;Terrain mapping;Network servers;Extraterrestrial measurements;Velocity measurement;Data visualization;Earth;Internet;Web server},
 month = {Dec},
