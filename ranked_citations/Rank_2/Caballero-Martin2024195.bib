@article{Caballero-Martin2024195,
 abstract = {The significant improvement of drones has supported research in advanced technologies, highlighting the integration of Artificial Intelligence (AI). This study examines the impact of AI on drones, addressing several areas from automation to complex real time decision making. In fields unrelated to logistics and cargo transportation, the synergy between drones and AI has led to notable progress in areas such as agriculture, construction, security and exploration. This combination the generation of new applications, although on the other hand, it poses ethical and regulatory challenges. In summary, AI not only transforms logistics but also drives innovation in several industries, offering a safer and more efficient future.  © The Author(s), under exclusive license to Springer Nature Switzerland AG 2024.},
 author = {Caballero-Martin, Daniel and Lopez-Guede, Jose Manuel and Estevez, Julian and Graña, Manuel},
 doi = {10.1007/978-3-031-61137-7_19},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
