@article{NIU2026121004,
 abstract = {Industrial–urban symbiosis that reuses low-temperature industrial waste heat in district heating networks is a promising pathway to decarbonize space heating in cold regions. Yet existing planning tools often use fixed heat pump efficiencies or merge design and operation into a single optimization, so they cannot quantify how much decarbonization is lost when systems designed for climate targets are later operated to minimize costs. This study tests the hypothesis that a multi-scale, two-stage framework that explicitly separates environmentally driven capacity planning from economically driven operational dispatch, while preserving physics-based heat pump behavior, can reveal and quantify these hidden trade-offs. The framework couples a high-fidelity vapor-compression cycle model, reduced to a polynomial surrogate and linearized for mixed-integer programming, with capacity planning and an annual model predictive dispatch simulation for a coal-based district heating network in Qingdao, China, including scenarios with on-site wind and solar generation. Compared with the existing coal-fired combined heat and power supply, industrial waste heat recovery with a high-temperature heat pump reduces annual carbon dioxide emissions by up to 62.8 percent, while an economic dispatch strategy cuts annual operating costs by 11.9–27.7 percent at the expense of 33.6–61.0 percent higher emissions than an environmentally driven rule-based strategy, implying a marginal operational cost of 130–154 Chinese yuan for each additional ton of carbon dioxide. These results demonstrate that explicitly decoupling design and operation exposes the decarbonization gap created by market-driven dispatch, provides quantitative benchmarks for carbon pricing and green financing, and offers a transferable, physically grounded tool for planning industrial waste heat integration in district heating systems.},
 author = {Zihao Niu and Yanxue Li and Xiaoyi Zhang},
 doi = {https://doi.org/10.1016/j.enconman.2025.121004},
 issn = {0196-8904},
 journal = {Energy Conversion and Management},
 keyword = {Industrial-urban symbiosis, District heating, Decarbonization, High-temperature heat pump, Multi-objective optimization, Model predictive control},
 pages = {121004},
 title = {Decarbonizing district heating via industrial-urban symbiosis: a two-stage optimization and assessment framework},
 url = {https://www.sciencedirect.com/science/article/pii/S0196890425015286},
 volume = {350},
 year = {2026}
}
