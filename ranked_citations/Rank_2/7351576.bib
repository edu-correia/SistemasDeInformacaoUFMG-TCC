@inproceedings{7351576,
 abstract = {In this paper we present a novel segmentation technique and adapt it for enhanced background recovery in crowded urban scenes. Building on an initial superpixels representation, smaller regions are merged depending on their perceived similarity to develop larger regions. Based on the observation that human activity tends to be quite structured, during this process we exploit emerging foreground context (tracks of people) to influence the segmentation process via Bayesian priors. These priors incorporate both temporal and spatial smoothing. We validate the approach on benchmarked urban datasets and show that our method improves on established image segmentation methods.},
 author = {Rodger, Iain and Connor, Barry and Robertson, Neil M.},
 booktitle = {2015 IEEE International Conference on Image Processing (ICIP)},
 doi = {10.1109/ICIP.2015.7351576},
 issn = {},
 keyword = {Image segmentation;Merging;Context;Videos;Smoothing methods;Kernel;Image color analysis;Image Segmentation;Superpixels;Pattern Recognition;Foreground Context},
 month = {Sep.},
 number = {},
 pages = {4097-4101},
 title = {Recovering background regions in videos of cluttered urban scenes},
 volume = {},
 year = {2015}
}
