 issn = {},
 keyword = {Electrostatic discharge;Thyristors;Logic gates;Clamps;Voltage measurement;Layout;CMOS process;Electrostatic discharge(ESD);Silicon-controlled rectifier(SCR);Transmission line pulse(TLP)},
 month = {March},
 number = {},
 pages = {331-335},
 title = {Comparison of different MOS-triggered SCR structures for on-chip ESD protection},
 volume = {3},
 year = {2011}
}
