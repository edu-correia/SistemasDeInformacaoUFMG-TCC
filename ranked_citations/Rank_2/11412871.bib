@inproceedings{11412871,
 abstract = {The huge quantity of data stored in PDF files has made it essential to have smart systems that would help in the first place with automatic information retrieval and comprehension. Searching manually is a laborious process and thus inefficient, and on top of that, it often doesn't even manage to get the semantic context. This paper is about a web-based PDF Question-Answering system called AI-powered Answering with Retrieval, Vectorization, and Interactive Knowledgebase (AARVIK) that was made to fight against this problem. AARVIK utilizes a modern technological stack by merging a Fast API backend and a Stream lit front end. The RAG (Retrieval-Augmented Generation) pipeline is the heart of the system, using Hugging Face's all-MiniLM-L6-v2 Model to create embeddings, FAISS for fast vector indexing, and Google's Gemini 1.5 Flash model for accurate and context-aware answer generation. It has been shown that AARVIK is capable of producing high-accuracy, lowlatency responses, thus significantly outperforming traditional keyword search methods.},
 author = {Shiralaskar, Hrishikesh and Puri, Chetan and Dhande, Siddhi and Wanjari, Ketan and Gawande, Tejas and Chamatkar, Himanshu},
 booktitle = {2026 7th International Conference on Mobile Computing and Sustainable Informatics (ICMCSI)},
 doi = {10.1109/ICMCSI67283.2026.11412871},
 issn = {},
 keyword = {Accuracy;Semantics;Pipelines;Optical character recognition;Portable document format;Vectors;Question answering (information retrieval);User experience;Internet;Context modeling;Question Answering;Natural Language Processing (NLP);FAISS;Gemini;LangChain;PDF Processing;HuggingFace;RetrievalAugmented Generation (RAG)},
 month = {Jan},
 number = {},
 pages = {1828-1835},
 title = {AARVIK: A Web-Based PDF Question Answering System Using Vector Embeddings and Large Language Models},
 volume = {},
 year = {2026}
}
