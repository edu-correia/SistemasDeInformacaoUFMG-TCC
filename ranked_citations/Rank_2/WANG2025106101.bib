 journal = {Brain, Behavior, and Immunity},
 keyword = {Anti-N-methyl-D-aspartate receptor encephalitis, Protein, Proteome-wide Mendelian randomization, Biomarker, Drug target, Single-cell transcriptome},
 pages = {106101},
 title = {Decoding NMDAR encephalitis: proteomic markers and computational identification of potential therapeutic pathways},
