@inproceedings{9302191,
 abstract = {In this study, 4 depth cameras (Kinect v1) were placed around the object in order to obtain the 3-dimensional structure of an object. Computer bandwidth and interference problems encountered during the operation of multiple Kinects were solved with additional USB 2.0 controllers and electronic shutters. Calibration was performed on infrared images to merge the acquired images. Alignment problems were solved by the Iterative Closest Point method and an alignment with 3.41% error rate was obtained. Poisson Surface Reconstruction was implemented in Meshlab software for 3D modeling objects with different geometrical characteristics.},
 author = {Tunçer, Esra and Gümüştekin, Şevket},
 booktitle = {2020 28th Signal Processing and Communications Applications Conference (SIU)},
 doi = {10.1109/SIU49456.2020.9302191},
 issn = {2165-0608},
 keyword = {Universal Serial Bus;Cameras;Three-dimensional displays;Calibration;Surface reconstruction;Interference;Image reconstruction;multiple Kinect;3D reconstruction;depth camera calibration},
 month = {Oct},
 number = {},
 pages = {1-4},
 title = {3D Object Reconstruction Using Sequentially Activated Multiple Depth Cameras},
 volume = {},
 year = {2020}
}
