@conference{Lim2024,
 abstract = {The Log-Structured Merge Tree (LSM Tree) is widely employed in key-value stores, ensuring efficient database read performance at the expense of increased write stall. While this stall enhances read performance, it notably degrades write efficiency. This paper examines the write stall phenomenon in LSM Tree-based key-value stores and proposes a solution: Key Space Partitioned RocksDB. This architecture comprises a MemTable backed by Storage DRAM, the Key Space Partitioned MemTable, and the Key Space Partitioned LSM Tree. Key Space Partitioned RocksDB demonstrates a 1.7× enhancement in YCSB-A throughput compared to conventional RocksDB, a 3.5× reduction in average GET(key) latency, and a 1.2 × decrease in average PUT (key, value) latency. © 2024 IEEE.},
 author = {Lim, Seungho and Yoo, Seung Won and Oh, Joontaek and Jeong, Wonseb and Song, Hyunsub and Song, Hyeonho and Lee, Donghun and Won, Youjip},
 doi = {10.1109/NVMSA63038.2024.10693654},
 journal = {Proceedings - 2024 13th IEEE Non-Volatile Memory Systems and Applications Symposium, NVMSA 2024},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Key-Space Partitioned LSM Tree for CMM-H},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85207064239?origin=resultslist},
 year = {2024}
}
