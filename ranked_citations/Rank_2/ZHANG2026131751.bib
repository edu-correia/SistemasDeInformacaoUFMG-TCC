@article{ZHANG2026131751,
 abstract = {Although CNN-Transformer hybrid models show promise in combining local and global features for visual tasks, their design still depends heavily on expert knowledge and manual tuning. Existing neural architecture search methods have achieved good results in searching within a single model type. However, they do not work well when combining different kinds of modules. The lack of a unified search framework makes achieving global optimization in large-scale hybrid architecture search difficult. To tackle this problem, our study introduces EHNAS, a framework that uses dynamic space shrinking and layered optimization to make hybrid architecture search faster and more efficient. Large language models are employed as architectural experts, which can reduce the initial search space by applying prior knowledge about the task and verifying the search space with specific metrics. Further, a hierarchical optimization process is used: it first chooses the overall backbone structure, then refines the detailed connections through intermediate hyperparameters. Evaluation acceleration is achieved through a training-free proxy and an evolutionary algorithm. A bridging layer named SF²M is also designed to enable smooth feature alignment and merging between different types of modules. Experiments on CIFAR-10, ImageNet-1K, and PASCAL-VOC2012 show that EHNAS achieves 97.4% and 81.9% Top-1 accuracy on image classification tasks, and 80.33% mIoU on semantic segmentation, with the lowest search cost being only 0.018 GPU-days. The proposed EHNAS framework has a relatively high computational efficiency.},
 author = {Yichen Zhang and Ziyu Hu},
 doi = {https://doi.org/10.1016/j.eswa.2026.131751},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Neural architecture search, Hybrid architecture, Dynamic space contraction, Large language model},
 pages = {131751},
 title = {EHNAS: Efficient hybrid architecture search via LLM-based space pruning and training-free evaluation},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417426006640},
 volume = {317},
 year = {2026}
}
