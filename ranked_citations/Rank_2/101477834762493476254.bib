@article{10.14778/3476249.3476254,
 abstract = {Cardinality estimation is a fundamental and critical problem in databases. Recently, many estimators based on deep learning have been proposed to solve this problem and they have achieved promising results. However, these estimators struggle to provide accurate results for complex queries, due to not capturing real inter-column and inter-table correlations. Furthermore, none of these estimators contain the uncertainty information about their estimations. In this paper, we present a join cardinality estimator called Fauce. Fauce learns the correlations across all columns and all tables in the database. It also contains the uncertainty information of each estimation. Among all studied learned estimators, our results are promising: (1) Fauce is a light-weight estimator, it has 10\texttimes{} faster inference speed than the state of the art estimator; (2) Fauce is robust to the complex queries, it provides 1.3\texttimes{}--6.7\texttimes{} smaller estimation errors for complex queries compared with the state of the art estimator; (3) To the best of our knowledge, Fauce is the first estimator that incorporates uncertainty information for cardinality estimation into a deep learning model.},
 author = {Liu, Jie and Dong, Wenqian and Zhou, Qingqing and Li, Dong},
 doi = {10.14778/3476249.3476254},
 issn = {2150-8097},
 issue_date = {July 2021},
 journal = {Proc. VLDB Endow.},
 month = {July},
 number = {11},
 numpages = {14},
 pages = {1950–1963},
 publisher = {VLDB Endowment},
 title = {Fauce: fast and accurate deep ensembles with uncertainty for cardinality estimation},
 url = {https://doi.org/10.14778/3476249.3476254},
 volume = {14},
 year = {2021}
}
