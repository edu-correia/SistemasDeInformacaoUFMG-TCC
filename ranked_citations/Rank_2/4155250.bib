@inproceedings{4155250,
 abstract = {The latest video standards such as ITU-T H.264 and MPEG-4 Part 10 introduce important bitrate gains but at the cost or increased complexity, especially at the encoder. One important tool is the variable block sizes motion estimation/compensation, which presents the possibility of using blocks ranging from 16times16 down to 4times4, offering the choice of one macroblock configuration out of 259 modes. This paper suggests a new method to select efficiently one variable block sizes partitioning mode based on a single set of motion estimation results at the smallest granularity (4times4 blocks). The results show the accuracy of the decision method, while requiring a minimal number of searches from the motion estimation algorithm. The technique also maintains an acceptable complexity for a potential real time implementation},
 author = {Amer, Ihab and Chirila-Rus, Adrian and Badawy, Wael and Jullien, Graham},
 booktitle = {2006 6th International Workshop on System on Chip for Real Time Applications},
 doi = {10.1109/IWSOC.2006.348254},
 issn = {},
 keyword = {Motion estimation;MPEG 4 Standard;High definition video;Bit rate;Partitioning algorithms;IEC standards;ISO standards;Video compression;Amplitude estimation;System-on-a-chip},
 month = {Dec},
 number = {},
 pages = {5-9},
 title = {An Efficent Variable Block Size Selection Scheme for the H.264 Motion Estimation},
 volume = {},
 year = {2006}
}
