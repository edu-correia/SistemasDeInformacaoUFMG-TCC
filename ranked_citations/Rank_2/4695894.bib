@inproceedings{4695894,
 abstract = {Due to the growing complexity of modern digital systems, functional verification is still an important challenge. Current verification practice in industry and in academia includes simulation and formal techniques. While formal tools can handle small to medium size designs, only simulation-based tools can validate digital systems of almost infinite complexity. One of the main disadvantages of simulation is that only one set of behaviors is explored. In order to improve simulation, several coverage metrics have been proposed. These metrics (such as line, path or conditional coverage) provide information about the variety of behavior that a particular test-bench explores. With modern digital systems, it is difficult to obtain high coverage, thus a key challenge, according to the latest report of the ITRS, is to create new solutions that can provide high coverage at all hierarchical levels of a design. Verification plans commonly use random test bench generation. However, this technique normally provides a low coverage that is not improved by increasing the number of test-benches. The main contribution of this paper is the development of a behavioral verification technique that enables the improvement of the coverage of random test-benches. The algorithm takes advantage of the structure of the behavioral system description and the information that the simulation produces.},
 author = {Ugarte, I. and Sanchez, P.},
 booktitle = {2008 IEEE International High Level Design Validation and Test Workshop},
 doi = {10.1109/HLDVT.2008.4695894},
 issn = {1552-6674},
 keyword = {Testing;Digital systems;Induction generators;Formal verification;Algorithm design and analysis;Genetic algorithms;Microelectronics;Merging;State-space methods;Protocols;Semi-formal technique;functional coverage;random-based simulation;solver},
 month = {Nov},
 number = {},
 pages = {145-152},
 title = {Optimized coverage-directed random simulation},
 volume = {},
 year = {2008}
}
