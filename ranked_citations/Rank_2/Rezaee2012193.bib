@article{Rezaee2012193,
 abstract = {In fuzzy models, redundancy may be present in the form of similar fuzzy sets, especially in the construction of a fuzzy system from a set of given training examples. In this paper, a simple formula for calculating the degree of similarity of Trapezoidal membership functions is derived in order to merge similar membership functions and hence to obtain a more transparent rule-base with a minimum number of membership functions. A simplification algorithm by using the proposed similarity measure has been applied to fuzzy models of nonlinear functions approximation. © 2012-IOS Press and the authors. All rights reserved.},
 author = {Rezaee, Babak},
 doi = {10.3233/IFS-2012-0509},
 journal = {Journal of Intelligent and Fuzzy Systems},
 note = {Cited by: 26},
 number = {5},
 pages = {193 - 201},
 publication_stage = {Final},
 source = {Scopus},
 title = {Rule base simplification by using a similarity measure of fuzzy sets},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84865586833?origin=resultslist},
 volume = {23},
 year = {2012}
}
