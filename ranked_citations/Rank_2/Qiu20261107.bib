 abstract = {Key-value stores have become pivotal in the management of data for modern large-scale data centers. Unlike the log-structured merge (LSM) tree, the B_ tree enhances read performance by mitigating read amplification and by leveraging the temporal locality of keys in the buffer area of its internal nodes. However, its inability to fully harness the high parallelism of solidstate drives (SSDs) limits its effectiveness. This limitation stems from traditional SSDs concealing their parallelism from the host system. The advent of open-channel SSDs (OCSSDs), which expose the physical data storage layout to the host system, provides a unique opportunity to leverage SSDs' inherent high parallelism in read/write operations. This article introduces a novel highparallelismB ϵ (HP-Bϵ) indexing scheme designed forOCSSDs. The scheme specifically addresses conflicts between parallel units (PUs) during read operations, substantially improving read performance of theBϵ indexing approach.To our knowledge, this is the first study to adapt the Bϵ indexing scheme for the OCSSD architecture, and our experimental results are promising.  © 2026 IEEE.},
 author = {Qiu, Chi-Liang and Liao, Yao-Yu and Chen, Tseng-Yi and Chang, Yuan-Hao},
 doi = {10.1109/TPDS.2026.3672185},
 journal = {IEEE Transactions on Parallel and Distributed Systems},
 note = {Cited by: 0},
 number = {5},
 pages = {1107 - 1120},
 publication_stage = {Final},
 source = {Scopus},
 title = {Unlocking SSD Parallelism: A High-Performance Bϵ-Tree Framework for OCSSDs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105032757730?origin=resultslist},
