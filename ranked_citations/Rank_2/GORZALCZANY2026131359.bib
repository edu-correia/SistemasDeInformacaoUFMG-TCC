@article{GORZALCZANY2026131359,
 abstract = {Molecular diagnostic procedures for tumors – employing microarray technologies – become effective tools for performing precise and early diagnosis of tumors. However, informative genes, i.e., the disease relevant genes constitute only a small fraction of the overall number of the available genes. Therefore, the selection of minimal subsets of highly informative genes is essential in designing accurate tumor classification/prediction systems. This paper aims at designing a two-stage procedure for effective uncovering of collections of such genes. In the first stage of our approach, we apply our tool, i.e., generalized self-organizing neural networks (SONNs) with evolving, splitting-merging structures to the gene data clustering to detect big, dominating clusters of non-informative/noisy genes to be removed from the original data. Drastically reduced – in the first stage – gene expression data set creates an excellent point of departure for effective uncovering – in the second stage and using conventional tools (e.g., decision trees) – of different minimal subsets of highly informative genes. Our approach is able to select – out of original 2308 SRBCT genes – several 4-gene and one 3-gene subsets containing genes characterized by the highest level of informativeness that result in 100%-accuracies of categorizing particular types of tumors. A broad comparative analysis of our approach and 22 available alternative methods (providing 26 different solutions) demonstrates that our approach definitely outperforms all alternative methods in terms of uncovering gene subsets containing minimal numbers of genes characterized by the earlier-mentioned highest level of informativeness.},
 author = {Marian B. Gorzałczany and Filip Rudziński},
 doi = {https://doi.org/10.1016/j.eswa.2026.131359},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {SRBC tumors, Gene expression data, Minimal sets of informative genes, Self-organizing neural networks with evolving structures},
 pages = {131359},
 title = {Discovering minimal sets of informative genes via multi-step clustering of SRBC-tumor gene expression data using generalized self-organizing neural networks},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417426002721},
 volume = {311},
 year = {2026}
}
