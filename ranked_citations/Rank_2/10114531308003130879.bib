@article{10.1145/3130800.3130879,
 abstract = {We present an adaptive Generalized Interpolation Material Point (GIMP) method for simulating elastoplastic materials. Our approach allows adaptive refining and coarsening of different regions of the material, leading to an efficient MPM solver that concentrates most of the computation resources in specific regions of interest. We propose a C1 continuous adaptive basis function that satisfies the partition of unity property and remains non-negative throughout the computational domain. We develop a practical strategy for particle-grid transfers that leverages the recently introduced SPGrid data structure for storing sparse multi-layered grids. We demonstrate the robustness and efficiency of our method on the simulation of various elastic and plastic materials. We also compare key kernel components to uniform grid MPM solvers to highlight performance benefits of our method.},
 address = {New York, NY, USA},
 articleno = {223},
 author = {Gao, Ming and Tampubolon, Andre Pradhana and Jiang, Chenfanfu and Sifakis, Eftychios},
 doi = {10.1145/3130800.3130879},
 issn = {0730-0301},
 issue_date = {December 2017},
 journal = {ACM Trans. Graph.},
 keyword = {adaptive grids, elastoplasticity, generalized interpolation material point (GIMP), material point method (MPM)},
 month = {November},
 number = {6},
 numpages = {12},
 publisher = {Association for Computing Machinery},
 title = {An adaptive generalized interpolation material point method for simulating elastoplastic materials},
 url = {https://doi.org/10.1145/3130800.3130879},
 volume = {36},
 year = {2017}
}
