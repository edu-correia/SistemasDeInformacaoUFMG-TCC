@conference{Jerfel2019,
 abstract = {Learning-to-learn or meta-learning leverages data-driven inductive bias to increase the efficiency of learning on a novel task. This approach encounters difficulty when transfer is not advantageous, for instance, when tasks are considerably dissimilar or change over time. We use the connection between gradient-based meta-learning and hierarchical Bayes to propose a Dirichlet process mixture of hierarchical Bayesian models over the parameters of an arbitrary parametric model such as a neural network. In contrast to consolidating inductive biases into a single set of hyperparameters, our approach of task-dependent hyperparameter selection better handles latent distribution shift, as demonstrated on a set of evolving, image-based, few-shot learning benchmarks. © 2019 Neural information processing systems foundation. All rights reserved.},
 author = {Jerfel, Ghassen and Grant, Erin and Griffiths, Thomas L. and Heller, Katherine},
 journal = {Advances in Neural Information Processing Systems},
 note = {Cited by: 84},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Reconciling meta-learning and continual learning with online mixtures of tasks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85090177106?origin=resultslist},
 volume = {32},
 year = {2019}
}
