@conference{Zhao20183170,
 abstract = {A deep residual network, built by stacking a sequence of residual blocks, is easy to train, because identity mappings skip residual branches and thus improve information flow. To further reduce the training difficulty, we present a simple network architecture, deep merge-and-run neural networks. The novelty lies in a modularized building block, merge-and-run block, which assembles residual branches in parallel through a merge-and-run mapping: average the inputs of these residual branches (Merge), and add the average to the output of each residual branch as the input of the subsequent residual branch (Run), respectively. We show that the merge-and-run mapping is a linear idempotent function in which the transformation matrix is idempotent, and thus improves information flow, making training easy. In comparison with residual networks, our networks enjoy compelling advantages: they contain much shorter paths and the width, i.e., the number of channels, is increased, and the time complexity remains unchanged. We evaluate the performance on the standard recognition tasks. Our approach demonstrates consistent improvements over ResNets with the comparable setup, and achieves competitive results (e.g., 3.06% testing error on CIFAR-10, 17.55% on CIFAR-100, 1.51% on SVHN). © 2018 International Joint Conferences on Artificial Intelligence. All right reserved.},
 author = {Zhao, Liming and Li, Mingjie and Meng, Depu and Li, Xi and Zhang, Zhaoxiang and Zhuang, Yueting and Tu, Zhuowen and Wang, Jingdong},
 doi = {10.24963/ijcai.2018/440},
 journal = {IJCAI International Joint Conference on Artificial Intelligence},
 note = {Cited by: 24; All Open Access; Gold Open Access},
 pages = {3170 - 3176},
 publication_stage = {Final},
 source = {Scopus},
 title = {Deep convolutional neural networks with merge-and-run mappings},
 type = {Conference paper},
