@article{Mao2014235,
 abstract = {Currently, the most network traffic identification technologies focus on the applications of traffic, while ignoring the attributes of network terminal nodes which generate traffic. In this paper, we present a novel approach to identify the social attributes of network terminal nodes and design Netflow based network Nodes' Social attributes Discovery System(NNSDS).Firstly, we store the Netflow records using two hash tables to obtain the snapshots of the activity of the network. Then we discover the attributes of network nodes by the following elements: (1) social topology statistics, (2) social activity and (3) social roles of network nodes. We test our system on an IP backbone network. The experimental results show that our system can correctly identify various types of network nodes and the identification accuracy achieves 95%. © Springer International Publishing Switzerland 2014.},
 author = {Mao, Shuo and Wu, Zhigang and Sun, Bo and Cao, Shoufeng and Du, Xiongjie and Wang, Kaifeng},
 doi = {10.1007/978-3-319-11119-3_22},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {235 - 245},
 publication_stage = {Final},
 source = {Scopus},
 title = {NNSDS: Network nodes' social attributes discovery system based on netflow},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84906336071?origin=resultslist},
 volume = {8710 LNCS},
 year = {2014}
}
