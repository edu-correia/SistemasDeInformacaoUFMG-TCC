@inproceedings{11337150,
 abstract = {The Bayesian network, a significant graph model merging probability statistics and graph theory, plays a pivotal role in representing and reasoning with uncertain knowledge. The analytical efficacy of a network largely depends on the accurate construction of its structure. This study proposes a novel method for Bayesian network structure learning using a binary African vulture optimization algorithm, named BN-BAVOA. In BN-BAVOA, individual network structures evolve through crossover and mutation operators, complemented by Lévy flight strategies. An adaptive parameter control mechanism based on oscillatory models is adopted to balance exploration and exploitation. Furthermore, an elite learning strategy is designed, allowing elite individuals' structural information to be learned more effectively and accelerating convergence while preserving accuracy. The experimental results demonstrate that the proposed algorithm outperforms the Binary Particle Swarm Optimization Algorithm and the Binary Grey Wolf Optimization Algorithm. Specifically, it achieves a significant reduction in structural errors, as measured by the Structural Hamming Distance, by up to 49.6%, and delivers Bayesian Information Criterion scores that are up to 21.2% closer to the ground truth, indicating superior model fit.},
 author = {Yu, Jiannan and Liang, Shaohui},
 booktitle = {2025 International Conference on Algorithms, Data Mining, and Information Technology (ADMIT)},
 doi = {10.1109/ADMIT67050.2025.11337150},
 issn = {},
 keyword = {Accuracy;Social networking (online);Heuristic algorithms;Scalability;Semantics;Bayes methods;Particle swarm optimization;Optimization;Tuning;Convergence;Bayesian networks;Structural learning;African vulture algorithm;Genetic algorithm;Elite learning strategy},
 month = {Oct},
 number = {},
 pages = {1-7},
 title = {A Novel Bayesian Network Structure Learning Method Using the Binary African Vulture Optimization Algorithm},
 volume = {},
 year = {2025}
