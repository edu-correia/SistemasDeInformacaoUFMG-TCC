@inproceedings{11150129,
 abstract = {In the tobacco manufacturing industry, tobacco impurity detection. However, the complicated background settings and the morphological diversity of impurities during production can compromise the detection accuracy of tobacco robots, thereby affecting product quality. To address these challenges, we present a novel online detection method for tobacco impurities designed for tobacco inspection robots. We introduce the DAC-Former attention mechanism module, which effectively minimizes the impact of extraneous image information. Furthermore, we propose the Double Feature Fusion Network to boost detection accuracy by merging deep semantic and surface location data from feature maps. A dedicated dataset for tobacco impurity detection has been created to validate our approach. Experimental results indicate that our algorithm enhances the mAP value by approximately 8.71% and efficiently tackles tobacco impurity detection by enabling real-time model processing at a higher frame rate compared to the conventional YOLOX method.},
 author = {Zhang, Jie and Wang, Xiabing and Li, Dailin and Chen, Chen and Zheng, Weiwei and Lu, Miaoxin},
 booktitle = {2025 40th Youth Academic Annual Conference of Chinese Association of Automation (YAC)},
 doi = {10.1109/YAC66630.2025.11150129},
 issn = {2837-8601},
 keyword = {Accuracy;Service robots;Impurities;Semantics;Surface morphology;Production;Feature extraction;Real-time systems;Quality assessment;Surface treatment;Tobacco impurity detection;tobacco manufacturing domain;machine vision;detection robot},
 month = {May},
 number = {},
 pages = {269-272},
 title = {An Adaptive FD-Former Network For Tobacco Impurity Detection},
 volume = {},
 year = {2025}
}
