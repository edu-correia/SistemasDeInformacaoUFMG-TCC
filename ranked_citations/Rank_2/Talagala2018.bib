@conference{Talagala2018,
 abstract = {Edge Computing and Machine Learning are complementary advances: edge devices drive volumes of rich data that benefit ML, and ML drives insights that can justify edge investments and create killer applications such as AR/VR. We describe the challenges of ML/DL on the edge and describe guidelines for addressing them. We present Edge Cloud Orchestrator (ECO), an architecture for enabling realistic ML deployments that leverage both edge and cloud by providing an abstraction to orchestrate, manage, and automate ML pipelines. By separating the control path from the data path, ECO handles scale, heterogeneity, and advanced ML patterns. © 2018 USENIX Association. All rights reserved.},
 author = {Talagala, Nisha and Sundararaman, Swaminathan and Sridhar, Vinay and Arteaga, Dulcardo and Luo, Qianmei and Subramanian, Sriram and Ghanta, Sindhu and Khermosh, Lior and Roselli, Drew},
 journal = {USENIX Workshop on Hot Topics in Edge Computing, HotEdge 2018, co-located with USENIX ATC 2018},
 note = {Cited by: 25},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {ECO: Harmonizing edge and cloud with ML/DL orchestration},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85084160117?origin=resultslist},
 year = {2018}
}
