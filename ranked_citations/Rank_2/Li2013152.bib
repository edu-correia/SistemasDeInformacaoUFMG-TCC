@conference{Li2013152,
 abstract = {Accurate bus trajectory data is the basis of many public transportation applications. However, trajectory data sampled by GPS devices contains notable direction errors. We cannot determine the travelling direction of the bus through trajectory data. To address this problem, we utilize k-nearest neighbor algorithm (K-NN) to determine the direction of the bus trajectory. Meanwhile, the voluminous bus trajectory data accumulated daily need to be process efficiently for further data mining. To meet the scalability and performance requirements, in this paper, we use Map-Reduce programming model for trajectory data direction correcting and projecting the bus GPS point to the road link. Particularly, we compare execution time through setting different amount of reduce to express the extent of running time can be affect. Experimental results indicate that the K-NN algorithm improve the accuracy of the direction field in raw bus trajectory significantly, and parallel processing framework improves the computational efficiency by a factor of 2 at least, which obtained by comparing between reduce quantities. © 2013 IEEE.},
 author = {Li, Dapeng and Zhou, Xiaohua and Wang, Qi and Gao, Mengdan},
 doi = {10.1109/CloudCom.2013.27},
 journal = {Proceedings of the  International Conference on Cloud Computing Technology and Science, CloudCom},
 note = {Cited by: 0},
 pages = {152 - 157},
 publication_stage = {Final},
 source = {Scopus},
 title = {Map-reduce for calibrating massive bus trajectory data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84899739216?origin=resultslist},
 volume = {1},
 year = {2013}
}
