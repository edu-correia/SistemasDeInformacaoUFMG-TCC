@inproceedings{8088745,
 abstract = {Smart grid distribution network consist of power supply cables and two-way communication between the customer and grid which is carried out by Optical Fiber Composite Low-Voltage Cable (OPLC). The concept of OPLC is to merge the power distribution and communication access network together so that one cable can connect the customers to the smart grid through a smart meter, to create an interactive environment with a smart grid for better implementation of demand side management, the internet and scheduling the load in peak hours. The Optical Fiber Composite Low-Voltage Cable (OPLC) is modeled in COMSOL Multiphysics simulation software. A 3-dimensional model is designed for four core and three core cable. The operational current analysis of OPLC is performed in this paper as well as the increased temperature test is carried out in different cases. The geometrical structure of the OPLC contains the external reference diameter of the conductor is 8.0 mm while the thickness of the conductor insulation and cable insulation is 1.1 mm and 2.5mm respectively. A distribution system of OPLC cable is modeled in which the temperature is analyzed for different conditions in the normal situation. The current flow from the conductor will cause the temperature rise in the conductor due to resistive losses and the generated heat will be transferred to the other insulating material used in the cable. The simulation was performed for a long time of 20 hours and analyzed the maximum temperature gain by the conductors. In conclusion, the results obtained by the four core and three core OPLC cable are compared and suggested the performance based good cable.},
 author = {Shah, Muhammad Aqib and Chen, Yu and Ashfaq, Ahsan and Sun, Guanshu and Kai, Yao and Fu, Lina and Yu, Jing},
 booktitle = {2017 International Symposium on Electrical Insulating Materials (ISEIM)},
 doi = {10.23919/ISEIM.2017.8088745},
 issn = {},
 keyword = {Conductors;Power cables;Optical fiber cables;Power cable insulation;Resistance;Communication cables;OPLC;temperature rise;COMSOL Multiphysics;physical simulation;thermal field distribution},
 month = {Sep.},
 number = {},
 pages = {295-298},
 title = {Temperature field distribution of optical fiber composite low-voltage cable},
 volume = {1},
 year = {2017}
}
