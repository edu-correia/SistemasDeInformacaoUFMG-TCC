@conference{Yu20081057,
 abstract = {Annotated corpora are only useful if their annotations are consistent. Most large-scale annotation efforts take special measures to reconcile inter-annotator disagreement. To date, however, no-one has investigated how to automatically determine exemplars in which the annotators agree but are wrong. In this paper, we use OntoNotes, a large-scale corpus of semantic annotations, including word senses, predicate-argument structure, ontology linking, and coreference. To determine the mistaken agreements in word sense annotation, we employ word sense disambiguation (WSD) to select a set of suspicious candidates for human evaluation. Experiments are conducted from three aspects (precision, cost-effectiveness ratio, and entropy) to examine the performance of WSD. The experimental results show that WSD is most effective on identifying erroneous annotations for highly-ambiguous words, while a baseline is better for other cases. The two methods can be combined to improve the cleanup process. This procedure allows us to find approximately 2% remaining erroneous agreements in the OntoNotes corpus. A similar procedure can be easily defined to check other annotated corpora. © 2008. Licensed under the Creative Commons.},
 author = {Yu, Liang-Chih and Wu, Chung-Hsien and Hovy, Eduard},
 journal = {Coling 2008 - 22nd International Conference on Computational Linguistics, Proceedings of the Conference},
 note = {Cited by: 6},
 pages = {1057 - 1064},
 publication_stage = {Final},
 source = {Scopus},
 title = {OntoNotes: Corpus cleanup of mistaken agreement using word sense disambiguation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77955231415?origin=resultslist},
 volume = {1},
 year = {2008}
}
