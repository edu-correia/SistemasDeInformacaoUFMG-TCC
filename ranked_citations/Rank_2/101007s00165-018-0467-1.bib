@article{10.1007/s00165-018-0467-1,
 abstract = {rTiMo is a real-time version of&nbsp; TiMo (Timed Mobility), which is a process algebra for mobile distributed systems. In this paper, we investigate the denotational semantics for rTiMo. A trace variable tr is introduced to record the communications among processes as well as the location where the communication action takes place. Based on the formalized model, we study a set of algebraic laws, especially the laws about the migration and communication with real-time constraints. In order to facilitate the algebraic reasoning about the parallel expansion laws, we enrich rTiMo with a form of guardedchoice. This can enable us to convert every parallel program to the guarded choice form. Moreover, we also provide a set of proof rules, which can be used to verify the correctness and real-time properties of programs.},
 address = {Berlin, Heidelberg},
 author = {Xie, Wanling and Xiang, Shuangqing and Zhu, Huibiao},
 doi = {10.1007/s00165-018-0467-1},
 issn = {0934-5043},
 issue_date = {Nov 2018},
 journal = {Form. Asp. Comput.},
 keyword = {rTiMo, Mobile systems, UTP semantics, Hoare logic},
 month = {November},
 number = {6},
 numpages = {26},
 pages = {713–738},
 publisher = {Springer-Verlag},
 title = {A UTP approach for rTiMo},
 url = {https://doi.org/10.1007/s00165-018-0467-1},
 volume = {30},
 year = {2018}
}
