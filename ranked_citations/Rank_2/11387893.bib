@inproceedings{11387893,
 abstract = {Social media platforms have emerged as crucial spaces for self-expression, particularly in linguistically diverse regions such as India. A major challenge in sentiment analysis arises from the widespread use of Hinglish, a code-mixed blend of Hindi and English, which introduces vocabulary ambiguity, non-standard grammar, and transliteration inconsistencies. These characteristics often impair the performance of traditional sentiment analysis models designed for monolingual text. A lightweight and efficient variant of multilingual BERT, termed Hindi English-mBERT (HiEn-mBERT+), has been developed to address this and fine-tuned specifically for code-mixed sentiment analysis. The model incorporates a novel preprocessing pipeline comprising custom transliteration, language tagging, and subword merging, enabling better handling of linguistic irregularities in Hinglish text. The importance of tailoring language models to code-mixed, low-resource environments is underscored, particularly for enhancing sentiment analysis in multilingual social media contexts. HiEn-mBERT+ has been evaluated on standard Hindi-English sentiment datasets and has shown superior performance over classical machine learning models, deep learning approaches, and standard transformer baselines, thereby demonstrating its robustness and effectiveness in real-world code-mixed scenarios.},
 author = {Rai, Simran and Kumari, Anisha and Behera, Ranjan Kumar},
 booktitle = {2025 IEEE 3rd International Symposium on Sustainable Energy, Signal Processing and Cybersecurity},
 doi = {10.1109/iSSSC66652.2025.11387893},
 issn = {},
 keyword = {Sentiment analysis;Analytical models;Accuracy;Social networking (online);Transformers;Encoding;Multilingual;Grammar;Standards;Context modeling;Sentiment Analysis;Low Resource Language;BERT models;Social Media;Embedding Encoding},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {HiEn-mBERT+: A Lightweight Fine-Tuned Transformer for Hindi-English Code-Mixed Sentiment Analysis},
