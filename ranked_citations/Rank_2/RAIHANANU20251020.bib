 journal = {Multidiscipline Modeling in Materials and Structures},
 keyword = {Structural health monitoring (SHM), 3D truss structure, Finite element model (FEM), Frequency domain decomposition (FDD), Modal analysis and updating, Case study},
 number = {5},
 pages = {1020-1043},
 title = {Merging and rescaling sensor data for accurate structural health assessment of 3D truss structures using structural software},
