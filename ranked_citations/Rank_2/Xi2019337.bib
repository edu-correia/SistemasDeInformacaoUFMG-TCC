@article{Xi2019337,
 abstract = {Reconstruction of man-made scenes from multi-view images is an important problem in computer vision and computer graphics. Observing that man-made scenes are usually composed of planar surfaces, we encode plane shape prior in reconstructing man-made scenes. Recent approaches for single-view reconstruction employ multi-branch neural networks to simultaneously segment planes and recover 3D plane parameters. However, the scale of available annotated data heavily limits the generalizability and accuracy of these supervised methods. In this paper, we propose multi-view regularization to enhance the capability of piecewise planar reconstruction during the training phase, without demanding extra annotated data. Our multi-view regularization enables the consistency among multiple views by making the feature embedding more robust against view change and lighting variations. Thus, the neural network trained by multi-view regularization performs better on a wide range of views and lightings in the test phase. Based on more consistent prediction results, we merge the recovered models from multiple views to reconstruct scenes. Our approach achieves state-of-the-art reconstruction performance compared to previous approaches on the public ScanNet dataset. © 2019, The Author(s).},
 author = {Xi, Weijie and Chen, Xuejin},
 doi = {10.1007/s41095-019-0159-7},
 journal = {Computational Visual Media},
 note = {Cited by: 10; All Open Access; Gold Open Access; Green Open Access},
 number = {4},
 pages = {337 - 345},
 publication_stage = {Final},
 source = {Scopus},
 title = {Reconstructing piecewise planar scenes with multi-view regularization},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85077855027?origin=resultslist},
 volume = {5},
 year = {2019}
}
