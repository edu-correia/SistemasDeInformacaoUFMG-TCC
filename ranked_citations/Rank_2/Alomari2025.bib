@conference{Alomari2025,
 abstract = {Metaverse is a combination of virtual reality and digital spaces that has great potential in higher education. The purpose of this study is to apply Rogers' Diffusion of Innovations (DOI) framework to evaluate metaverse adoption, focusing on key attributes such as relative advantage, complexity, testability, and observability, and their impact on student attitudes and intentions opposite the behavior. According to an analysis of data from 232 UAE higher education students, relative advantage, compatibility, testability, and observability lead to positive attitudes, whereas complexity acts as a barrier. Attitude was also found to act as a mediator between DOI attributes and behavioral intentions, making it clear that the most influential factor among them is relative advantage. Based on the practical implications, this means that more training should be provided and that the designs should be easy to understand for the intuition. Otherwise, even if they are valuable or well designed, they will not accept them. Addressing the complexity and highlighting its benefits can achieve wider adoption. The results illustrate how engagement, experiential learning, and digital skills can drive transformation through metaverses in education, preparing learners for an era in which virtual reality is expected to merge with the real world.  © 2025 IEEE.},
 author = {Alomari, Khaled Mohammad and Maghaydah, Safwan and Mahde, Ahmed and Mohammed, Ayman Abdalla and Korany, Hossam and Abunawas, Mousa Khalil},
 doi = {10.1109/IC_ASET65966.2025.11232258},
 journal = {Proceedings - International Conference on Advanced Systems and Emergent Technologies, IC_ASET 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Examining Metaverse Adoption Impacts Higher Education Students Through the Diffusion of Innovation Framework},
 type = {Conference paper},
