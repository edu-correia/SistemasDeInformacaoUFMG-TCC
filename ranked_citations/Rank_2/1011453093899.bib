@article{10.1145/3093899,
 abstract = {Web browsing is always a key requirement of Internet users. Current mobile Web apps can contain computation-intensive JavaScript logics and thus affect browsing performance. Learning from our over-decade research and development experiences of the Internetware paradigm, we present the novel and generic i-Jacob approach to improving the performance of mobile Web browsing with effective JavaScript-code offloading. Our approach proposes a programming abstraction to make mobile Web situational and adaptive to contexts, by specifying the computation-intensive and “ offloadable ” code, and develops a platform-independent lightweight runtime spanning the mobile devices and the cloud. We demonstrate the efficiency of i-Jacob with some typical computation-intensive tasks over various combinations of hardware, operating systems, browsers, and network connections. The improvements can reach up to 49\texttimes{} speed-up in response time and 90% saving in energy.},
 address = {New York, NY, USA},
 articleno = {14},
 author = {Liu, Xuanzhe and Yu, Meihua and Ma, Yun and Huang, Gang and Mei, Hong and Liu, Yunxin},
 doi = {10.1145/3093899},
 issn = {1533-5399},
 issue_date = {May 2018},
 journal = {ACM Trans. Internet Technol.},
 keyword = {JavaScript offloading, Mobile Web, energy, performance},
 month = {March},
 number = {2},
 numpages = {23},
 publisher = {Association for Computing Machinery},
 title = {i-Jacob: An Internetware-Oriented Approach to Optimizing Computation-Intensive Mobile Web Browsing},
 url = {https://doi.org/10.1145/3093899},
 volume = {18},
 year = {2018}
}
