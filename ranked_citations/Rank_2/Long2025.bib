@article{Long2025,
 abstract = {Automatic and accurate segmentation of individual teeth from cone beam computed tomography (CBCT) images is crucial for advanced stomatological treatments such as 3D-guided implant surgery and orthodontic planning. However, segmenting teeth from CBCT data poses significant challenges due to their proximity, poorly contrasted borders, and the presence of metal artifacts from prior treatments. Existing methods often suffer from overdependence on the initial detection step and difficulties in segmenting boundary and artifact regions. To address these issues, we propose MMJTIS-Net, a multi-model joint instance segmentation network that comprises a tooth instance detection component and a self-refined semantic segmentation component. The detection component incorporates an instance reference segmentation network to mitigate missed detections. The segmentation component employs a coarse-to-fine self-refined network that enhances boundary perception and addresses nonboundary difficult regions using a transformer-based self-attention mechanism. Results demonstrate that our approach achieves state-of-the-art performance, with a Dice similarity coefficient of 98.18% and a Jaccard index of 96.44%. In conclusion, our method not only enhances segmentation accuracy but also facilitates diverse clinical applications by delivering comprehensive 3D tooth information. © 2025 SPIE and IS&T.},
 author = {Long, Minquan and Li, Tingcheng and Tang, Peng and Lyu, Zhengyang and Wang, Zhongsheng and Liu, Jiaji and Luo, Xiaonan and Yuan, Tianran},
 doi = {10.1117/1.JEI.34.5.053038},
 journal = {Journal of Electronic Imaging},
 note = {Cited by: 0},
 number = {5},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {MMJTIS-Net: Multi-model joint tooth instance segmentation network for advanced stomatological treatment},
 type = {Article},
