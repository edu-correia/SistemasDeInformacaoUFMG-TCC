@inproceedings{9182596,
 abstract = {As one of the most important characteristics of complex networks, communities can reveal the structure and functional attributes of the network. For dealing with the problems of most algorithms in which the community division is complicated and the accuracy of the result is low, a community division algorithm based on node density and node similarity is proposed. First, The algorithm redefines the similarity measure by using the common neighbors and shortest paths between the nodes. The new similarity measure has higher accuracy than the common one. The algorithm also defines the node density, which can objectively reflect the importance of nodes in the network. Secondly, based on node similarity and node density, select nodes with high node density and small similarity as the initial clustering points, use the maximum similarity as the principle for the preliminary community division. Finally, merge the initial communities with the goal of maximizing optimization modularity, the community division algorithm gets the final division result. In this paper, experiments were performed on the real network and the artificial network. Compared with other algorithms, the algorithm is simpler, can effectively detect the community structure with higher accuracy.},
 author = {Fu, Lidong and Li, Fan and Li, Dan},
 booktitle = {2020 IEEE International Conference on Artificial Intelligence and Computer Applications (ICAICA)},
 doi = {10.1109/ICAICA50127.2020.9182596},
 issn = {},
 keyword = {Clustering algorithms;Partitioning algorithms;Complex networks;Heuristic algorithms;Time complexity;Computer science;Classification algorithms;complex network;node density;node similarity;modularity;community division},
 month = {June},
 number = {},
 pages = {739-743},
 title = {Community division algorithm based on node density and similarity},
 volume = {},
 year = {2020}
}
