@conference{Kemp2006381,
 abstract = {Relationships between concepts account for a large proportion of semantic knowledge. We present a nonparametric Bayesian model that discovers systems of related concepts. Given data involving several sets of entities, our model discovers the kinds of entities in each set and the relations between kinds that are possible or likely. We apply our approach to four problems: clustering objects and features, learning ontologies, discovering kinship systems, and discovering structure in political data. Copyright © 2006, American Association for Artificial Intelligence (www.aaai.org). All rights reserved.},
 author = {Kemp, Charles and Tenenbaum, Joshua B. and Griffiths, Thomas L. and Yamada, Takeshi and Ueda, Naonori},
 journal = {Proceedings of the National Conference on Artificial Intelligence},
 note = {Cited by: 394},
 pages = {381 - 388},
 publication_stage = {Final},
 source = {Scopus},
 title = {Learning systems of concepts with an infinite relational model},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33750696648?origin=resultslist},
 volume = {1},
 year = {2006}
}
