@article{10.1007/s00165-016-0395-x,
 abstract = {In the correct-by-construction programming methodology, programs are incrementally derived from their formal specifications, by repeatedly applying transformations to partially derived programs. At an intermediate stage in a derivation, users may have to make certain assumptions to proceed further. To ensure that the assumptions hold true at that point in the program, certain other assumptions may need to be introduced upstream as loop invariants or preconditions. Typically these other assumptions are made in an ad hoc fashion and may result in unnecessary rework, or worse, complete exclusion of some of the alternative solutions. In this work, we present rules for propagating assumptions through annotated programs. We show how these rules can be integrated in a top-down derivation methodology to provide a systematic approach for propagating the assumptions, materializing them with executable statements at a place different from the place of introduction, and strengthening of loop invariants with minimal additional proof efforts.},
 address = {Berlin, Heidelberg},
 author = {Chaudhari, Dipak L. and Damani, Om},
 doi = {10.1007/s00165-016-0395-x},
 issn = {0934-5043},
 issue_date = {May 2017},
 journal = {Form. Asp. Comput.},
 keyword = {Correct-by-construction, Program derivation, Annotated programs, Assumption propagation},
 month = {May},
 number = {3},
 numpages = {36},
 pages = {495–530},
 publisher = {Springer-Verlag},
 title = {Assumption propagation through annotated programs},
 url = {https://doi.org/10.1007/s00165-016-0395-x},
 volume = {29},
 year = {2017}
}
