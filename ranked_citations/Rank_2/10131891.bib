@inproceedings{10131891,
 abstract = {This work introduces an innovative method for image steganography that merges cryptographic and steganographic techniques to meet the increasing demand for the secure sharing of sensitive data. The suggested approach utilizes a combination of Hybrid Beaufort Vigenere (HBV) Cipher and padded RSA algorithm for encryption, and an improved LSB steganography method to render the embedded data invisible to potential attackers. To further enhance key sensitivity, a key derivation function is integrated.The effectiveness of the algorithm is evaluated through multiple metrics, including peak signal-to-noise ratio (PSNR), structural similarity index measure (SSIM), mean squared error (MSE), correlation coefficient (CC) score, histogram analysis, processing time and key sensitivity. The findings indicate that the suggested method outperforms existing techniques in all examined parameters. However, it should be noted that although the research focuses on image steganography security using the proposed method, it may not be directly applicable to other steganographic techniques or media. Implementing the proposed method in secure communication systems that require sharing sensitive data can effectively ensure the confidentiality and integrity of transmitted information. The novelty of this paper stems from the integration of cryptographic and steganographic methods, providing enhanced security and resistance to various types of attacks through the combination of HBV, padded RSA, and an improved LSB steganography method. Additionally, the integration of a key derivation function further strengthens the technique’s key sensitivity.},
 author = {R, Aswathy Krishna and Subramanian, Narayanan and Jain, Kurunandan},
 booktitle = {2023 11th International Symposium on Digital Forensics and Security (ISDFS)},
 doi = {10.1109/ISDFS58141.2023.10131891},
 issn = {},
 keyword = {Resistance;Steganography;Histograms;Sensitivity;PSNR;Measurement uncertainty;Media;Image steganography;HBV;RSA;SSIM;PSNR;MSE;CC;Histogram;Key sensitivity},
 month = {May},
 number = {},
 pages = {1-6},
 title = {Image Steganography Using HBV And Padded RSA},
