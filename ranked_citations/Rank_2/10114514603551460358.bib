@article{10.1145/1460355.1460358,
 abstract = {This is an analysis and exploration of a basic aesthetic issue in interaction design: how an ambition to design strong and persistent relations between appearance and functionality, evident in approaches such as tangible user interfaces, in crucial ways in which conflicts with the ways miniaturization of technology have changed the relation between the object's surface and its internal complexity. To further investigate this issue, four conceptual design experiments are presented exploring the expressiveness and aesthetic potential of overloading the object's surface by adding several layers of interaction, thus creating a kind of tangled interaction.},
 address = {New York, NY, USA},
 articleno = {16},
 author = {Redstr\"{o}m, Johan},
 doi = {10.1145/1460355.1460358},
 issn = {1073-0516},
 issue_date = {November 2008},
 journal = {ACM Trans. Comput.-Hum. Interact.},
 keyword = {tangible user interfaces, interaction design, design theory, Aesthetics},
 month = {December},
 number = {4},
 numpages = {17},
 publisher = {Association for Computing Machinery},
 title = {Tangled interaction: On the expressiveness of tangible user interfaces},
 url = {https://doi.org/10.1145/1460355.1460358},
 volume = {15},
 year = {2008}
}
