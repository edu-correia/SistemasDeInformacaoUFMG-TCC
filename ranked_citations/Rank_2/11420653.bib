@inproceedings{11420653,
 abstract = {The amount of data is constantly growing. Not only does the amount itself changes, but also the structure, relationships and correlations. It is also necessary to monitor changes over time. This requires sophisticated solutions for accessing data with emphasis on scalability. The primary access method to data is naturally an index, but a suitable index is not always available, and the system must resort to sequential scanning of individual blocks. The aim of this paper is to optimize the sequential processing of data blocks to obtain the necessary data more efficiently and faster. It uses sophisticated methods using merging and indexing. Thanks to that, processing cost demands can be lowered to 15%, compared to sequential data block scanning necessity.},
 author = {Kvet, Michal},
 booktitle = {2026 IEEE 24th World Symposium on Applied Machine Intelligence and Informatics (SAMI)},
 doi = {10.1109/SAMI68106.2026.11420653},
 issn = {2767-9438},
 keyword = {Data analysis;Databases;Scalability;Merging;Data retrieval;Informatics;Optimization;Monitoring;Machine intelligence;Indexing;temporal databases;sequential data scanning;data block;segment;extent;database optimization},
 month = {Jan},
 number = {},
 pages = {000621-000626},
 title = {Optimizing data access using enhanced Table Access Full method},
 volume = {},
 year = {2026}
}
