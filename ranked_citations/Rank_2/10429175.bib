@inproceedings{10429175,
 abstract = {There has always been an urgent demand for GIS graphic aesthetics technology among Smart Grid planner. This article proposes a distribution network GIS graphic beautification algorithm based on Tyson polygons. Firstly, several feeders with similar distances are merged into a single feeder group through buffering processing to obtain an envelope buffer zone; Then use the Tyson polygon to obtain the centerline of the buffer zone and the specific feeder segments contained in each "corridor", and arrange all feeder segments within this corridor at equal intervals; Then, the "forward and backward" method is used to obtain the connection relationship between the upper and lower segments of the entire feeder line. Finally, the relevant distribution equipment and switchgear are connected to their respective feeder segments, completing the beautification of the entire feeder line. This algorithm solves the technical difficulty of beautifying single line diagrams in distribution network GIS, enabling it to be directly used in the planning and compilation of geographical wiring diagrams in distribution networks.},
 author = {He, Qibo and Zheng, Ling and Tang, Zheng and Yang, Kun and Jiang, Nian and Wu, Qian},
 booktitle = {2023 3rd International Conference on New Energy and Power Engineering (ICNEPE)},
 doi = {10.1109/ICNEPE60694.2023.10429175},
 issn = {},
 keyword = {Wiring;Substations;Switchgear;Layout;Distribution networks;Smart grids;Geographic information systems;Tyson polygon;Skeleton line;GIS geographic wiring diagram;Envelope line;Buffer},
 month = {Nov},
 number = {},
 pages = {1211-1216},
 title = {Layout and Wiring Algorithm for Distribution Grid Geographic Wiring Diagram Based on GIS},
 volume = {},
 year = {2023}
}
