@conference{Pérez200867,
 abstract = {This paper presents FuMaS (Fuzzy Matching System), a system capable of an efficient retrieval of postal addresses from noisy queries. The fuzzy postal addresses retrieval has many possible applications, ranging from datawarehouse de-dumping, to the correction of input forms, or the integration within online street directories, etc. This paper presents the system architecture along with a series of experiments performed using FuMaS. The experimental results show that FuMaS is a very useful system when retrieving noisy postal addresses, being able to retrieve almost 85% of the total ones. This represents an improvement of the 15% when comparing with other systems tested in this set of experiments. © 2008 IADIS.},
 author = {Pérez, José Carlos Cortizo and Hidalgo, José María Gómez and Temprado, Yaiza and Martín, Diego and Rodríguez, Federico},
 journal = {MCCSIS'08 - IADIS Multi Conference on Computer Science and Information Systems; Proceedings of Informatics 2008 and Data Mining 2008},
 note = {Cited by: 0},
 pages = {67 - 72},
 publication_stage = {Final},
 source = {Scopus},
 title = {Mining postal addresses},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/58449122555?origin=resultslist},
 year = {2008}
}
