@inproceedings{10296712,
 abstract = {End-to-end imitation learning has gained renewed interest as a promising approach for developing autonomous vehicles. The term "end-to-end" signifies the utilization of a trained deep neural network that emulates the driving behavior of an expert operator, encompassing complex tasks such as road following and obstacle avoidance. Typically, this approach entails equipping the vehicle with a vision sensor that captures the driver’s visual input during operation, followed by training the deep neural network using a collection of demonstration data. Several architectural designs have been proposed to enable the agent to attain expert-level driving proficiency. In this paper, we introduce TimeFusionNet: A cutting-edge architecture for implementing Time-Dependent deep neural network with Sensor-Fusion, which effectively captures temporal dependencies across successive frames during driving, combined with a LIDAR point cloud. The integration of such methodologies into a deep-learning agent significantly enhances its ability to mimic real-life driving policies. The proposed end-to-end approach yields a remarkable improvement of 12% to 40% improvement on average in the agent’s decision-making capabilities in test case scenarios (CORL17 Benchmarks). The model is to operate in real-time on ∼10 FPS on an RTX3060Ti GPU.},
 author = {Matloob, Youssef and WallyAllah, Abdallah and Abdel-Halim, M. and Sabry, M. and El-Tantawy, Samah and Mostafa, Hassan},
 booktitle = {2023 5th Novel Intelligent and Leading Emerging Sciences Conference (NILES)},
 doi = {10.1109/NILES59815.2023.10296712},
 issn = {},
 keyword = {Training;Visualization;Laser radar;Roads;Decision making;Artificial neural networks;Vision sensors;Imitation learning;End-to-End Imitation Learning;Autonomous Driving;Carla Simulator;Sensor Fusion;LIDAR Sensor},
 month = {Oct},
 number = {},
 pages = {42-47},
 title = {TimeFusionNet for End-to-End Self-Driving Cars},
 volume = {},
