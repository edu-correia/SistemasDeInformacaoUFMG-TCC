@conference{Zhang2008185,
 abstract = {This chapter provides a review of recent research publications on the incorporation of pan-sharpening techniques for improved information extraction published since 2004. A brief overview is also given on the development process of pan-sharpening techniques and early applications of pan-sharpening for improved information extraction to provide some context information. Research publications since 2004 indicated that the research focus has shifted from traditional fusion of SPOT Pan and Landsat TM or SPOT XS to the fusion of Ikonos, QuickBird and Landsat ETM+ Pan and MS images for improved information extraction. The studies demonstrated that a well pan-sharpened MS image could provide more information for improved information extraction, at lease for improved visual interpretation. From the evaluation results of individual pan-sharpening techniques, however, divided comments could be seen for the majority of fusion techniques depending on the data sets used and the applications involved, except for the PCI Pansharp fusion technique which received overall favourable observations in different studies. In terms of classification methods used, object-oriented classification was most frequently investigated and achieved more accurate classification results than Maximum Likelihood classification in majority of the studies. However, it was also observed that the current object-oriented classification is still not capable of effectively utilizing the information existing in high resolution MS or pan-sharpened MS images. It is found that much more room still exists for the improvement of information extraction techniques rather than the image fusion techniques. For the improvement of information extraction techniques, object-oriented approaches exhibit significantly more development potential than pixel-based approaches. © 2008 Taylor & Francis Group.},
 author = {Zhang, Yun},
 doi = {10.1201/9780203888445.ch14},
