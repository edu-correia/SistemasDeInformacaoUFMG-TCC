@inproceedings{11281716,
 abstract = {Heterogeneous integration combines BGA, flip chip, and micro bump interconnects, the interconnect risk assessment is a challenge. Full-fidelity finite element analysis is often impractical. This study proposes an equivalent-beam representation at the unit-cell scale and a global-local workflow. Three unit-cell variants are evaluated; the merged-beam best reproduces shear and axial responses, while the star-type MPC is overly stiff in bending. The global model replaces all joints with beams; local solid models are driven by nodal displacements sampled on planes remote from the joint in accordance with Saint Venant’s principle. Under a temperature ramp, the global and solid models agree at the target node with a 0.783 percent RMS relative difference. Local models driven by global displacements shows a reproducible plastic strain-energy pattern. The method enables efficient HI reliability assessment and will be validated on a realistic BGA assembly.},
 author = {Yuan, Cadmus and Lin, Si-Han},
 booktitle = {2025 20th International Microsystems, Packaging, Assembly and Circuits Technology Conference (IMPACT)},
 doi = {10.1109/IMPACT67645.2025.11281716},
 issn = {2150-5942},
 keyword = {Solid modeling;Multichip modules;Bending;Solids;Finite element analysis;Reliability;Plastics;Flip-chip devices;Integrated circuit modeling;Load modeling},
 month = {Oct},
 number = {},
 pages = {363-367},
 title = {Studying of the Equivalent Beam Structure for the Interconnect Reliability Prediction of the Heterogeneous Integration Module},
 volume = {},
 year = {2025}
}
