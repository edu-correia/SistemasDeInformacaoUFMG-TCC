@inproceedings{7346300,
 abstract = {New wideband quadrature rectangular dielectric resonator antenna is designed and proposed. The square shaped slots are drilled to obtain wide impedance bandwidth by reduction of effective dielectric constant. Metallization is incorporated along the edges to make the structure compact by removal of dielectric in the direction of symmetry plane of electric field. It results in volume reduction from 3.1 × 3.1 × 1.55 cm3 to 1.55 × 1.55 × 1.55 cm3. It is further observed that feeding probe acts as monopole and improves impedance bandwidth up to 61.5% for S11 ≤ -10 dB in the range of 3.6 to 6 GHz by merging various modes. The proposed structure offers gain of more than 6 dBi and radiation efficiency of more than 75% in the complete frequency range of operation.},
 author = {Patel, Pragati and Reddy, G Shrikanth and Mukherjee, Jayanta and Mukherjee, Biswajeet},
 booktitle = {2015 European Radar Conference (EuRAD)},
 doi = {10.1109/EuRAD.2015.7346300},
 issn = {},
 keyword = {Dielectric resonator antennas;Dielectrics;Resonant frequency;Broadband antennas;Bandwidth;Antenna measurements;Probes;compact;metal;rectangular dielctric resonator antenna;slots;wideband},
 month = {Sep.},
 number = {},
 pages = {313-316},
 title = {New wideband quadrature rectangular dielectric resonator antenna},
 volume = {},
 year = {2015}
}
