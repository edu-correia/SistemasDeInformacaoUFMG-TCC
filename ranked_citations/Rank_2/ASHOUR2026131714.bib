@article{ASHOUR2026131714,
 abstract = {An economical and eco-friendly polymeric azetidinium salt [1,1-(ethylenediimino)bis(3-chloro-2-propanol)] is examined as an anticorrosion agent for carbon steel (C-steel) substrate in 1.0 M hydrochloric acid solution. This study was conducted using electrochemical techniques as well as gravimetric analysis at different temperatures and for various immersion times. The structure and morphology of the substrate are explored with scanning electron microscopy (SEM) and visual examination. The adsorption isotherm of the studied polymer was taken into account. Besides, the polymeric corrosion inhibition performance was optimized with response surface modeling (RSM). The cationic polymer reactivity was studied using quantum chemical calculations and molecular dynamics simulations to establish a connection between experimental findings and theoretical aspects. The practical data attributed the polymeric inhibitory performance to its adsorption onto the metallic substrate. As a consequence, a conservative barrier is created, mitigating the corrosion process. The results identify a mixed-type polymeric inhibitor that operates through an electron transfer mechanism. A spontaneous adsorption behavior of the polymeric inhibitor was suggested. This adsorption was found to be aligned with the Langmuir isotherm model. Regarding quantum chemistry, depending on the protonation in the acidic medium of the cationic polymer, the density functional theory (DFT) revealed a significant reduction in the energy gap to 6.4749 eV and an increase in the dipole moment to 53.3613 D, resulting in enhanced electron transfer and adsorption capabilities. Molecular dynamics (MD) simulations revealed that the protonated polymer adopts a parallel orientation when adsorbed onto the Fe (100) surface. These computational studies clarify the polymeric effectiveness as an anticorrosive compound and provide mechanistic insights into its inhibitory action. Overall, this study contributes to comprehending the potential of cationic polymer as a C-steel corrosion inhibitor with efficiency exceeding 97 % by merging experimental observations with theoretical insights.},
 author = {Mohammed Ashour and Safaa M. Ali and Hazem F. Khalil and Mostafa F. Bakr and Ahmed A. Elhenawy and Mohamed A. Abu-Saied and Nazly Hassan},
 doi = {https://doi.org/10.1016/j.matchemphys.2025.131714},
 issn = {0254-0584},
 journal = {Materials Chemistry and Physics},
 keyword = {Carbon steel, Corrosion inhibition, Cationic polymer/azetidinium salt, gravimetric/ electrochemical approaches, SEM, Langmuir isotherm, RSM, DFT/MD},
 pages = {131714},
 title = {Influence of a polymeric azetidinium salt cationic polymer as an anticorrosion agent in an acidic medium for carbon steel alloy: Practical and theoretical aspects},
 url = {https://www.sciencedirect.com/science/article/pii/S0254058425013604},
 volume = {348},
 year = {2026}
}
