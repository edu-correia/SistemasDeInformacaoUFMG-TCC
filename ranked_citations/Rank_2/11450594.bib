@inproceedings{11450594,
 abstract = {A hybrid framework based on deep learning is introduced here for plant leaf health status identification, using the benefits of pre-trained convolutional neural networks (CNNs). The method begins by taking a dataset of plant leaf images that are then resized, freed of noise and segmented using an automated process. They improve the image and remove unwanted areas which allows more precise feature retrieval. The processed images are sent into two CNN models: ResNet-101 and VGG19 which are both pre-trained. The complex network architecture and residual learning ability of ResNet-101, along with the simple and well-performing hierarchical feature extraction of VGG19, are combined to pull out many rich and diverse features from the images. All of the model outputs are combined to receive both sets of useful feature information at once. By combining these two models, the approach uses the detailed semantic properties of ResNet-101 as well as the fine spatial features from VGG19. Once the features are merged, they are processed by a detection layer that groups leave into two categories depending on their health. By using an ensemble, models demonstrate better ability to learn and apply their lessons. Results from testing the proposed method on a well-known plant leaf dataset prove how effective it is. The hybrid structure showed better performance than XGBoost, KNN, Random Forest and SVM when it achieved 90.7%. All three precision, recall and F1-score metrics indicated that the hybrid model outperformed others by delivering more than 89% success consistently. The findings prove that using information from several models together improves disease recognition in agriculture, providing a dependable and practical option to find and monitor diseases early.},
 author = {C, Bala Subramanian and S, Senthil Pandi and M V, Ezhil Dyana and T C, Manjunath},
 booktitle = {2025 International Conference on Emerging Technologies and Innovation for Sustainability (EmergIN)},
 doi = {10.1109/EmergIN67762.2025.11450594},
 issn = {},
 keyword = {Technological innovation;Transfer learning;Water quality;Feature extraction;Agriculture;Data models;Convolutional neural networks;Sustainable development;Diseases;Testing;AgriNet;ResNet;VGGNet;Plant Leaf;Diseases Detection},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {AgriNet: Early-Stage Diseases Detection in Agriculture Field by Combining Pretrained Models ResNet and VGGNet},
 volume = {},
