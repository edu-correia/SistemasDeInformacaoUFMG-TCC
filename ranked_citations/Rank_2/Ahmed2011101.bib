@article{Ahmed2011101,
 abstract = {We present the time-dependent topic-cluster model, a hierarchical approach for combining Latent Dirichlet Allocation and clustering via the Recurrent Chinese Restaurant Process. It inherits the advantages of both of its constituents, namely interpretability and concise representation. We show how it can be applied to streaming collections of objects such as real world feeds in a news portal. We provide details of a parallel Sequential Monte Carlo algorithm to perform inference in the resulting graphical model which scales to hundred of thousands of documents. Copyright 2011 by the authors.},
 author = {Ahmed, Amr and Ho, Qirong and Teo, Choon Hui and Eisenstein, Jacob and Smola, Alex J. and Xing, Eric P.},
 journal = {Journal of Machine Learning Research},
 note = {Cited by: 38},
 pages = {101 - 109},
 publication_stage = {Final},
 source = {Scopus},
 title = {Online inference for the infinite topic-cluster model: Storylines from streaming text},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84862299455?origin=resultslist},
 volume = {15},
 year = {2011}
}
