@article{10.1109/TNET.2008.2010594,
 abstract = {We develop algorithms for the compact representation of the 1- and 2-dimensional tries that are used for Internet packet classification. Our compact representations are experimentally compared with competing compact representations for 1- and multi-dimensional packet classifiers and found to simultaneously reduce the number of memory accesses required for a lookup as well as the memory required to store the classifier.},
 author = {Lu, Wencheng and Sahni, Sartaj},
 doi = {10.1109/tnet.2008.2010594},
 issn = {1063-6692},
 issue_date = {June 2009},
 journal = {IEEE/ACM Trans. Netw.},
 keyword = {succinct representation, packet classification, one- and two-dimensional tries, dynamic programming},
 month = {June},
 number = {3},
 numpages = {14},
 pages = {803–816},
 publisher = {IEEE Press},
 title = {Succinct representation of static packet classifiers},
 url = {https://doi.org/10.1109/TNET.2008.2010594},
 volume = {17},
 year = {2009}
}
