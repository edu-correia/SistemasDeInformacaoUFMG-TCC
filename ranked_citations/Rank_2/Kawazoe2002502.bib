@article{Kawazoe2002502,
 abstract = {In this paper, we propose a novel method on tracking unit pixel width line segments for function approximation-based image coding. This method is applied prior to function approximation of line segments in image coding. Compared to conventional methods, our method overcomes the problems introduced by inaccurately tracking unit pixel width contours that appear normally in images of fine details such as maps and circuit diagrams. These problems include the inability to reproduce thin segments of uniform width and the separation of segments at visually unnatural places due to image enlargement. As an illustration of its effectiveness, we apply our method on a blank map image followed by image coding via function approximation. © Springer-Verlag Berlin Heidelberg 2002.},
 author = {Kawazoe, Fumio and Toraichi, Kazuo and Kwan, Paul W. H. and Wada, Koichi},
 doi = {10.1007/3-540-36228-2_62},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 2},
 pages = {502 - 509},
 publication_stage = {Final},
 source = {Scopus},
 title = {A method on tracking unit pixel width line segments for function approximation-based image coding},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84949966322?origin=resultslist},
 volume = {2532},
 year = {2002}
}
