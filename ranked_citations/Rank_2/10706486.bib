@inproceedings{10706486,
 abstract = {Detecting fake news has received a lot of attention. Many previous methods concatenate independently encoded unimodal data, ignoring the benefits of integrated multimodal information. Also, the absence of specialized feature extraction for text and images further limits these methods. This paper introduces an end-to-end model called TT-BLIP that applies the bootstrapping language-image pretraining for unified visionlanguage understanding and generation (BLIP) for three types for images, and bidirectional BLIP encoders for multimodal information. The Multimodal Tri-Transformer fuses tri-modal features using three types of multi-head attention mechanisms, ensuring integrated modalities for enhanced representations and improved multimodal data analysis. The experiments are performed using two fake news datasets, Weibo and Gossipcop. The results indicate TT-BLIP outperforms the state-of-the-art models.},
 author = {Choi, Eunjee and Kim, Jong-Kook},
 booktitle = {2024 27th International Conference on Information Fusion (FUSION)},
 doi = {10.23919/FUSION59988.2024.10706486},
 issn = {},
 keyword = {Data analysis;Correlation;Attention mechanisms;Accuracy;Fuses;Blogs;Bidirectional control;Feature extraction;Encoding;Fake news;multimodal fusion;vision-language pretraining;fake news detection},
 month = {July},
 number = {},
 pages = {1-8},
 title = {TT-BLIP: Enhancing Fake News Detection Using BLIP and Tri-Transformer},
 volume = {},
 year = {2024}
}
