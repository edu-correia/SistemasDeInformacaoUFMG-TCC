@article{He2014,
 abstract = {Compared with either block or page-mapping Flash Translation Layer (FTL), hybrid-mapping FTL for flash Solid State Disks (SSDs), such as Fully Associative Section Translation (FAST), has relatively high space efficiency because of its smaller mapping table than the latter and higher flexibility than the former. As a result, hybrid-mapping FTL has become the most commonly used scheme in SSDs. But the hybrid-mapping FTL incurs a large number of costly full-merge operations. Thus, a critical challenge to hybrid-mapping FTL is how to reduce the cost of full-merge operations and improve partial merge operations and switch operations. In this article, we propose a novel FTL scheme, called Virtual Block-based Parallel FAST (VBPFAST), that divides flash area into Virtual Blocks (VBlocks) and Physical Blocks (PBlocks) where VBlocks are used to fully exploit channel-level, die-level, and plane-level parallelism of flash. Leveraging these three levels of parallelism, the cost of full merge in VBP-FAST is significantly reduced from that of FAST. In the meantime, VBP-FAST uses PBlocks to retain the advantages of partial merge and switch operations. Our extensive trace-driven simulation results show that VBP-FAST speeds up FAST by a factor of 5.3-8.4 for random workloads and of 1.7 for sequential workloads with channel-level, die-level, and plane-level parallelism of 8, 2, and 2 (i.e., eight channels, two dies, and two planes).},
 author = {He, Dan and Wang, Fang and Jiang, Hong and Feng, Dan and Liu, Jing Ning and Tong, Wei and Zhang, Zheng},
 doi = {10.1145/2677160},
 journal = {ACM Transactions on Architecture and Code Optimization},
 note = {Cited by: 13; All Open Access; Bronze Open Access},
 number = {4},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improving hybrid FTL by fully exploiting internal SSD parallelism with virtual blocks},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84917686856?origin=resultslist},
 volume = {11},
 year = {2014}
}
