@article{Zhao2005119,
 abstract = {Entity identification, i.e., detecting semantically corresponding records from heterogeneous data sources, is a critical step in integrating the data sources. The objective of this research is to develop and evaluate a novel multiple classifier system approach that improves entity identification accuracy. We apply various classification techniques drawn from statistical pattern recognition, machine learning, and artificial neural networks to determine whether two records from different data sources represent the same real-world entity. We further employ a variety of ways to combine multiple classifiers for improved classification accuracy. In this paper, we report on some promising empirical results that demonstrate performance improvement by combining multiple classifiers. © 2003 Elsevier Ltd. All rights reserved.},
 author = {Zhao, Huimin and Ram, Sudha},
 doi = {10.1016/j.is.2003.11.001},
 journal = {Information Systems},
 note = {Cited by: 40},
 number = {2},
 pages = {119 - 132},
 publication_stage = {Final},
 source = {Scopus},
 title = {Entity identification for heterogeneous database integration - A multiple classifier system approach and empirical evaluation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/5644287747?origin=resultslist},
 volume = {30},
 year = {2005}
}
