@inproceedings{8862193,
 abstract = {Vehicle tracking today is getting tougher with the passage of time, and it is getting difficult to keep track of these vehicles for security and safety purposes. People are today more concerned to keep them safe using the latest technology. The objective of this research is to provide, and RFID based solution for vehicle tracking to limit vehicle theft and enhance the safety of the passengers. Physical architecture modification and algorithm redesigning is done in order to eliminate the drawbacks of the existing solutions. The approach used for vehicle tracking is to calculate vehicle speed and then estimating the location of the vehicle. Positioning algorithm and Kinematic Integration algorithm are merged to create a hybrid solution which will be used to track the vehicles. As a result of this research work, the vehicle owners would be capable of know the exact location of the vehicle regardless of the network connectivity. This would ensure that the passengers in the vehicle are safe, and the vehicle is recovered in occurrence of a theft. For existing solutions, the outcome was not as accurate as our proposed solution. Furthermore, the processing time taken in proposed solution is less than the processing time taken for existing solutions.},
 author = {Salim, Mudassir and Alsadoon, Abeer and Prasad, P. W. C. and Elchouemi, Amr and Singh, Ashutosh Kumar},
 booktitle = {2019 International Conference on Machine Learning, Big Data, Cloud and Parallel Computing (COMITCon)},
 doi = {10.1109/COMITCon.2019.8862193},
 issn = {},
 keyword = {Roads;Radar tracking;RFID tags;Kinematics;Global Positioning System;Safety;Vehicle Tracking;Tracking algorithms;Positioning algorithm},
 month = {Feb},
 number = {},
 pages = {360-365},
 title = {RFID Technology for Vehicle Tracking Using Hybrid Kinematic Integration and Positioning Algorithm},
 volume = {},
 year = {2019}
}
