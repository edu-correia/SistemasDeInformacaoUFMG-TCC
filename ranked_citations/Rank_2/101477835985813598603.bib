@article{10.14778/3598581.3598603,
 abstract = {The capabilities of quantum computers, such as the number of supported qubits and maximum circuit depth, have grown exponentially in recent years. Commercially relevant applications that take advantage of quantum computing are expected to be available soon. In this paper, we shed light on the possibilities of accelerating database tasks using quantum computing with examples of optimizing queries and transaction schedules and present some open challenges for future studies in the field.},
 author = {\c{C}alikyilmaz, Umut and Groppe, Sven and Groppe, Jinghua and Winker, Tobias and Prestel, Stefan and Shagieva, Farida and Arya, Daanish and Preis, Florian and Gruenwald, Le},
 doi = {10.14778/3598581.3598603},
 issn = {2150-8097},
 issue_date = {May 2023},
 journal = {Proc. VLDB Endow.},
 month = {May},
 number = {9},
 numpages = {10},
 pages = {2344–2353},
 publisher = {VLDB Endowment},
 title = {Opportunities for Quantum Acceleration of Databases: Optimization of Queries and Transaction Schedules},
 url = {https://doi.org/10.14778/3598581.3598603},
 volume = {16},
 year = {2023}
}
