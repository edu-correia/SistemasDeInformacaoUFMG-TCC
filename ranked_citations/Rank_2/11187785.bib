@inproceedings{11187785,
 abstract = {Accurate machine translation is crucial for successful cross-linguistic communication, especially between morphologically complex languages like Korean and English. This paper describes the implementation of a Korean Translation Error Correction System based on a hybrid deep learning model that combines statistical and neural networkbased approaches. The system is able to automatically identify and correct grammatical, lexical, and contextual mistakes in Korean sentences produced by machine translation systems. The suggested architecture merges the power of Sequence-to-Sequence (Seq2Seq) models with attention, Bidirectional LSTM networks, and Transformer-based models, along with rulebased post-processing to handle difficult syntactic and semantic problems. A large parallel corpus of Korean-English translations, both correct and erroneous, was employed to train and fine-tune the system. Experimental tests show dramatic improvements in BLEU (reaching 38%) and GLEU (reaching 36%) scores compared to current baseline correction systems. In addition, the hybrid system has robust generalization ability across diverse domains such as news, technical texts, and conversational text. This research provides a high-quality and scalable solution for improving the quality of Korean translations and can be applied in real-time machine translation workflows or as a post-editing tool for human translators.},
 author = {Rong, Rong and Liu, Xiaojian},
 booktitle = {2025 Third International Conference on Networks, Multimedia and Information Technology (NMITCON)},
 doi = {10.1109/NMITCON65824.2025.11187785},
 issn = {},
 keyword = {Deep learning;Adaptation models;Translation;Semantics;Bidirectional long short term memory;Syntactics;Writing;Transformers;Error correction;Machine translation;korean translation;attention;bi-directional LSTM;transformer based architecture},
 month = {Aug},
 number = {},
 pages = {1-7},
 title = {Development of Korean Translation Error Correction System Based on Hybrid Deep Learning Algorithm},
