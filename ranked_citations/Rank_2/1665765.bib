@inproceedings{1665765,
 abstract = {A multi-machine multi-converter system formalism has been proposed in order to describe systems composed of several electrical machines and converters. The keys of such systems are coupling devices, which have to distribute energy. Control structures have also been suggested according to an inversion principle. The inversions of coupling devices have been made using repartition and weighting criteria. In this paper, systems with several coupling are studied. Several control structures can be found. One of them leads to shift some control blocks and to merge the repartition and weighting blocks. A railway traction system is given as example},
 author = {Bouscayrol, A. and Delarue, P. and de Fornel, B. and Hautier, J.P. and Meibody-Tabar, F. and Monmasson, E. and Peitrzak-David, M. and Razik, H. and Semail, E. and Benkhoris, M.F.},
 booktitle = {2005 European Conference on Power Electronics and Applications},
 doi = {10.1109/EPE.2005.219575},
 issn = {},
 keyword = {Control systems;Merging;Magnetic analysis;Couplings;Uniform resource locators;Rail transportation;Safety;Manufacturing;Energy exchange;Costs;Modelling;Control methods for electrical systems;Multi-machine system;traction application;vraible speed drive},
 month = {Sep.},
 number = {},
 pages = {9 pp.-P.9},
 title = {Control structures for multi-machine multi-converter systems with several couplings by criteria merging},
 volume = {},
 year = {2005}
}
