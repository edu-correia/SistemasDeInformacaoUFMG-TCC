@conference{Gao2025115,
 abstract = {Existing backdoor attack methods face challenges in stealth, robustness, and cross-modal coordination. Most rely on fixed triggers, making them easily detectable and less effective under data transformations or task migration. To address these limitations, we propose a more covert and adaptable backdoor attack strategy for multimodal systems. Our approach introduces bidirectional backdoor attacks, where a trigger is embedded in one modality while the attack is executed in another. We further enhance stealthiness and cross-modal consistency by incorporating coverless steganography, semantic-preserving loss, and language modeling loss. Experimental results demonstrate the effectiveness of our method, revealing critical vulnerabilities in multimodal systems. This research not only bridges existing gaps in multimodal backdoor attacks but also provides innovative strategies for compromising such systems.  © 2025 IEEE.},
 author = {Gao, Du and Dong, RuiJing},
 doi = {10.1109/MICCIS66057.2025.00025},
 journal = {Proceedings - 2025 3rd International Conference on Mobile Internet, Cloud Computing and Information Security, MICCIS 2025},
 note = {Cited by: 0},
 pages = {115 - 119},
 publication_stage = {Final},
 source = {Scopus},
 title = {Stealthier Backdoor Attacks for Multimodal Models: Bidirectional Triggers via Coverless Steganography and Semantic Preservation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105022455155?origin=resultslist},
 year = {2025}
}
