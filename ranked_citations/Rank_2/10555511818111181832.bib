@article{10.5555/1181811.1181832,
 abstract = {Laboratory assignments whether performed in a separate lab section or during the lecture part of a class can help students improve their coding and understand more theoretical concepts in a practical way. Two new items have been used by the author to enhance these lab assignments. One was the use of a wiki that allowed students to post comments, solutions, and questions. The other was to give a group assignment to the class where each student worked on a different algorithm and then reported the results to the class.},
 address = {Evansville, IN, USA},
 author = {Scott, Terry A.},
 issn = {1937-4771},
 issue_date = {October 2006},
 journal = {J. Comput. Sci. Coll.},
 month = {October},
 number = {1},
 numpages = {7},
 pages = {144–150},
 publisher = {Consortium for Computing Sciences in Colleges},
 title = {Computer science laboratory improvements},
 volume = {22},
 year = {2006}
}
