@inproceedings{7443244,
 abstract = {LiDAR (Light Detection And Sensing) data is a huge 3-dimensional data which is difficult to explore information from the data. It is necessary to segment this LiDAR data. In this paper, segmentation is done using quad-tree structure. In each segment, a point cloud is obtained. Subsequently we create a Triangulated Irregular Network (TIN) for each point cloud. Later TIN is merged to obtain structural lines for a given LiDAR data. The initial result helps us understand and reveal relevant information about the objects/shapes from the raw benchmark LiDAR dataset, i.e., ALS data of Toronto.},
 author = {Kutty, Saja Abdul Rahman and Ayyappan, Sonal},
 booktitle = {2015 Annual IEEE India Conference (INDICON)},
 doi = {10.1109/INDICON.2015.7443244},
 issn = {2325-9418},
 keyword = {Sensors;Three-dimensional displays;Laser radar;Tin;Atmospheric modeling;LiDAR;Triangulated Irregular Network(TIN);Airborne Laser Scanner(ALS)},
 month = {Dec},
 number = {},
 pages = {1-5},
 title = {A novel technique for LiDAR data segmentation and three-dimensional space projection},
 volume = {},
 year = {2015}
}
