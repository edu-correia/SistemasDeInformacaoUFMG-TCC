@inproceedings{4063778,
 abstract = {Structured P2P network is popular nowadays. However, the network needs reorganized when the peers are joining or leaving. To reduce the performance degradation caused by the reorganizations, we proposed a two-layer hybrid P2P network (HP2P). The upper layer is chord network and the lower layer is cluster in HP2P. In this paper, the cluster is described in detail. Peers are organized into clusters, and the network reorganizations are restricted within the clusters where a peer can join or leave. Besides, each cluster is also enhanced through some specific mechanisms such as Supernode, metadata redundancy and gossip flooding. Consequently, the two layers P2P become more robust. Further, the high efficiency of distributed hash tables(DHTs) can be retained, and the churn caused by excessive node joining and leaving can be reduced.},
 author = {Lv, Ertao and Duan, Zhenhua and Qi, Jian-jun and Cao, Yang and Peng, Zhuo},
 booktitle = {First International Conference on the Digital Society (ICDS'07)},
 doi = {10.1109/ICDS.2007.25},
 issn = {},
 keyword = {Peer to peer computing;Floods;Robustness;Internet;Computer networks;Degradation;Network topology;Keyword search;Humans;Geography},
 month = {Jan},
 number = {},
 pages = {17-17},
 title = {Incorporating Clusters into Hybrid P2P Network},
 volume = {},
 year = {2007}
}
