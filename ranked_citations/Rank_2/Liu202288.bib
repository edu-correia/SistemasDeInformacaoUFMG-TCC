@conference{Liu202288,
 abstract = {With the rapid development of information technology and the increasing demand for educational information application, the concept of "Internet plus higher education"has promoted the integration of information technology and education. It has become an important topic in the new era to enhance the quality of higher education through information technology. The online merge offline teaching model fits well with the teaching concept of the new era and is the mainstream direction of teaching reform. The smart classroom plays a significant role in promoting OMO teaching reform, improving students' autonomous learning ability and improving learning quality. Based on the goal of helping OMO teaching reform and starting from the functional demands of smart classroom construction, this paper puts forward the system architecture and technical framework of smart classroom, carries out the construction practice of smart classroom, and gives full play to the role of smart classroom in promoting OMO teaching reform.  © 2022 IEEE.},
 author = {Liu, Zhidong},
 doi = {10.1109/ICEKIM55072.2022.00027},
 journal = {Proceedings - 2022 3rd International Conference on Education, Knowledge and Information Management, ICEKIM 2022},
