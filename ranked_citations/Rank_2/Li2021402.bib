@conference{Li2021402,
 abstract = {Convolutional neural networks (CNN) are more and more used in image recognition. Recent studies have shown that complex-valued neural networks have richer representational capability than real-valued neural networks. However, the existing complex-valued CNN still has the following problems: (1) Most of the existing models are two-branch structures; (2) The model does not consider the importance of each complex feature map. In this paper, split-transform-merge and feature recalibration scheme in complex field are proposed, and applied to complex-valued neural networks to form Complex-valued Channel-weighted Aggregated Residual Networks (cSE-ResNeXt). This paper performs the experiments on CIFAR-10 and CIFAR-100 datasets. The experimental results show that the proposed algorithm is superior to both two complex-valued nextworks (ResNeXt and ResNet) and three real-valued nextworks (SE-ResNeXt, ResNeXt and ResNet). © 2021 ACM.},
 author = {Li, Wenhan and Xie, Wenqing and Wang, Zhifang and Han, Qi},
 doi = {10.1145/3501409.3501483},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 2},
 pages = {402 - 407},
 publication_stage = {Final},
 source = {Scopus},
 title = {Complex-valued Channel-weighted Aggregated Residual Networks for Image Recognition},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85122663247?origin=resultslist},
 year = {2021}
}
