@article{SABER2026115534,
 abstract = {Wide-span buildings supported by a single central core present unique challenges in achieving structural efficiency and controlling deflection. This study investigates biologically inspired structural strategies using bionic engineering principles. Natural load-bearing systems were analyzed and abstracted into a custom parametric design algorithm developed via graphical programming. Resulting digital models-each embodying a distinct structural strategy-were evaluated through finite element simulation. A multi-objective evolutionary optimization (NSGA-II) was subsequently employed to resolve the trade-offs between deflection and material efficiency and thereafter benchmarked against conventional control groups. Top bionic models achieved average deflection reductions of 46.7% and 59.8% relative to traditional baselines. A subsequent hybrid configuration, combining the most effective strategies, further cut deflection by 7.9%, yielding an overall improvement of nearly 70%. These findings highlight the potential of biologically inspired design for long-span structures and advocate a scalable, computation-driven approach to structural optimization rooted in natural logic.},
 author = {Mohammadjavad Saber and Parsa Keshvari and Zahra Sadat Zomorodian},
 doi = {https://doi.org/10.1016/j.jobe.2026.115534},
 issn = {2352-7102},
 journal = {Journal of Building Engineering},
 keyword = {Algorithmic design, Biomimicry, Computational design, Optimization, Structural engineering},
 pages = {115534},
 title = {A bio-inspired algorithmic approach for form generation, structural analysis, and optimization of large span cantilevered roofs},
 url = {https://www.sciencedirect.com/science/article/pii/S2352710226003554},
 volume = {120},
 year = {2026}
}
