@article{LI2026105991,
 abstract = {Infrared and visible image fusion integrates complementary information from infrared and visible images to improve visual quality. Recent methods incorporate wavelet decomposition to enhance feature extraction, but often ignore the correlation between high- and low-frequency components, leading to suboptimal feature utilization and noise amplification. To address these limitations, this paper proposes a novel feature enhancement framework for infrared and visible image fusion based on multi-scale wavelet decomposition. By integrating wavelet decomposition as a prior knowledge within a multi-scale architecture, the proposed method enhances the extraction and analysis of spatial and frequency-domain features. Notably, given that wavelet decomposition processes tend to amplify high-frequency noise, we design a Wavelet-Based Enhancement (WBE) module to simultaneously suppress noise and strengthen the saliency of low-frequency features. The refined low-frequency components subsequently serve as spatial guidance for denoising high-frequency details. In light of the distinct characteristics exhibited by different frequency bands, different fusion strategies are developed to adaptively merge low- and high-frequency features within their respective feature spaces. Finally, the fused low-frequency representations are recursively combined with high-frequency components through inverse wavelet transformation to reconstruct the final output, thereby maximizing information utilization and improving model robustness. Experimental results on three benchmark datasets (FLIR, LLVIP, and TNO) demonstrate that the proposed method outperforms existing approaches in both visual quality and quantitative metrics.},
 author = {Yulong Li and Zheng Guan and Xue Wang and Hao Dai},
 doi = {https://doi.org/10.1016/j.dsp.2026.105991},
 issn = {1051-2004},
 journal = {Digital Signal Processing},
 keyword = {Wavelet decomposition, Denoise, Infrared and visible image fusion},
 pages = {105991},
 title = {MWEFusion: Multi-scale wavelet-based feature enhancement network for infrared and visible image fusion},
 url = {https://www.sciencedirect.com/science/article/pii/S1051200426001107},
 volume = {176},
 year = {2026}
}
