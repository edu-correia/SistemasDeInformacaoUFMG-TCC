@article{11434925,
 abstract = {The visual–inertial odometry (VIO) system, integrating a camera and an inertial measurement unit, is a fundamental technology for autonomous localization in mobile devices. However, conventional VIO algorithms that rely solely on point feature extraction suffer from poor robustness in weak-textured environments. To address this limitation, this article proposes an enhanced VIO algorithm that fuses point-line features. First, line features are introduced, and the edge drawing lines segment detection algorithm is improved through a hierarchical multiscale collaborative detection mechanism and a cross-scale geometric consistency fusion strategy. These enhancements effectively mitigate feature fragmentation caused by noise and broken line segments. Second, an adaptive weighting approach is used to adjust the influence of point-line features in real time during the optimization process, ensuring effective and reliable feature utilization. In addition, a keyframe-based sliding-window optimization framework is implemented to balance computational efficiency while enhancing pose estimation accuracy. Experimental evaluations on the EuRoC and KITTI dataset demonstrate that the proposed algorithm significantly improves localization performance in weak-textured scenarios, this results in improved robustness and accuracy for the VIO system as a whole.},
 author = {Sun, Jin and Zhu, Xinwen and Zhao, Haitao},
 doi = {10.1109/JSTARS.2026.3673231},
 issn = {2151-1535},
 journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
 keyword = {Feature extraction;Optimization;Image segmentation;Accuracy;Merging;Real-time systems;Pose estimation;Visualization;Computational efficiency;Cameras;Line feature extraction;point-line features fusion;sliding-window backend optimization;visual–inertial odometry (VIO)},
 month = {},
 number = {},
 pages = {9895-9904},
 title = {Robust Visual–Inertial Odometry With Point-Line Feature Fusion for Enhanced Localization in Weak-Textured Environments},
 volume = {19},
 year = {2026}
}
