@article{PAN2025125789,
 abstract = {The depletion of fossil fuels and their environmental consequences underscore the urgent need for sustainable energy solutions. This study investigates a novel low-carbon multigeneration system that integrates renewable energy and waste management technologies to address challenges of low energy conversion efficiencies, environmental pollution, and resource scarcity. The proposed system combines a parabolic trough solar collector, an anaerobic digestion-gasification process for municipal sewage sludge, a supercritical carbon dioxide power unit, gas turbines, an ejector refrigeration unit, and a humidifier-dehumidifier desalination section. Thermodynamic and economic analyses, coupled with multi-objective particle swarm optimization, were employed to evaluate and enhance system performance. A unique feature of this work is the integration of municipal sewage sludge as a renewable energy source, effectively merging energy production with waste mitigation. Key results include the production of 7724.18 kW of net power, 582.4 kW of cooling, 976.41 kW of heating, and 0.97 kg/s of freshwater, achieving an exergetic efficiency of 21.64 %. Economic analysis yielded a product cost of 31.21 $/GJ and a payback period of 4.44 years. Optimization further enhanced the system, achieving an exergetic efficiency of 23.81 % and reducing product costs to 28.36 $/GJ. These findings demonstrate the system’s potential to contribute to global efforts in addressing energy, water, and waste management challenges, paving the way for a low-carbon, sustainable future.},
 author = {Fenghong Pan and Jianjun Lan},
 doi = {https://doi.org/10.1016/j.applthermaleng.2025.125789},
 issn = {1359-4311},
 journal = {Applied Thermal Engineering},
 keyword = {Low-carbon multigeneration, Anaerobic digestion, Solar collectors, Water harvesting, Thermoeconomic analysis, Optimization process},
 pages = {125789},
 title = {Low-carbon multigeneration system integrating solar collectors, biowaste gasification, and water harvesting: Thermodynamic and economic optimization},
 url = {https://www.sciencedirect.com/science/article/pii/S1359431125003801},
 volume = {267},
 year = {2025}
}
