@inproceedings{10122055,
 abstract = {Ahstract- A new underwater thrust device is proposed in this work that makes use of a soft outer structure in combination with a parallel linkage and driven by a classical actuator. By merging soft and rigid parts, we hope to increase the performance of pulsed jet propulsion that plays a crucial role in attitude control for AUVs. But also simpler models for design and control can be applied by this approach. A specific linkage design for actuation, along with two different soft structures (mantles) are introduced and evaluated in experiments which indicate efficient thrust creation. Particle Image Velocimetry (PIV) experiments show the formation of vortex rings that suggest efficient propulsion, whereby the wider and more flexible mantel is characterized by higher momentum and thrust.},
 author = {Stoeffler, Christoph and Del Río, Adriano and Sonntag, René and Hoffmann, Florian and Kumar, Shivesh and Kirchner, Frank},
 booktitle = {2023 IEEE International Conference on Soft Robotics (RoboSoft)},
 doi = {10.1109/RoboSoft55895.2023.10122055},
 issn = {2769-4534},
 keyword = {Couplings;Performance evaluation;Actuators;Attitude control;Merging;Propulsion;Soft robotics},
 month = {April},
 number = {},
 pages = {1-6},
 title = {A Combined Rigid-Soft Thruster Based on Jetting Propulsion},
 volume = {},
 year = {2023}
}
