@inproceedings{8471990,
 abstract = {The vision of Industry 4.0 follows a human centred approach in cyber-physical production systems. For this vision, human machine interfaces are required. A promising concept is the implementation of natural user interfaces. Especially the merging of real and virtual worlds, often referred to as mixed reality, is anticipated to be a future game changer. Yet manufacturing companies, especially small and medium sized companies, are facing the challenge to embrace the potential of these technologies early on and turn them into productive applications. To address this challenge, this paper proposes a training concept, putting the reality-virtuality continuum in focus. The modular, holistic training concept is presented based on mixed reality and technology adoption strategies. Finally, an evaluation of the first trainings is presented.},
 author = {Büth, Lennart and Juraschek, Max and Posselt, Gerrit and Herrmann, Christoph},
 booktitle = {2018 IEEE 16th International Conference on Industrial Informatics (INDIN)},
 doi = {10.1109/INDIN.2018.8471990},
 issn = {2378-363X},
 keyword = {Virtual reality;Training;Companies;Production facilities;Industries;Software;Hardware;mixed reality;training;Industry 4.0;learning factory},
 month = {July},
 number = {},
 pages = {544-549},
 title = {Supporting SMEs towards adopting mixed reality : A training concept to bring the reality-virtuality continuum into application},
 volume = {},
 year = {2018}
}
