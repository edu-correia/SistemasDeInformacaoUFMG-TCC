@inproceedings{11385863,
 abstract = {Accurate and efficient real-time monitoring of combustion temperature fields in coal-fired boilers is hampered by challenges of low spatial resolution and insufficient computational efficiency. To overcome these hurdles, this study presents a framework that combines physics-informed hierarchical hybrid sampling with a dynamically weighted loss function. This framework is developed through the thorough integration of multi-operational computational fluid dynamics (CFD) simulation data and operational parameters from the distributed control system (DCS) of a 350 MW supercritical once-through boiler. Initially, the flame core is pinpointed by computing the absolute temperature gradient at each grid point within the simulation data. Following this, a global coarse sampling approach is adopted to capture the boiler’s geometric structure and overall temperature distribution characteristics. This is further refined by local sampling in regions exhibiting the top 10% temperature gradients, effectively optimizing the total data points to 420,000. Ultimately, a deep neural network-based model is established for predicting the 3D temperature distribution within the boiler. This model incorporates error weights for high-gradient regions through the application of a dynamically weighted loss function. Experimental results validate the efficacy of this collaborative modeling approach, which merges physics-based constraints with data-driven techniques, offering a high-precision and streamlined solution for real-time combustion field optimization and safety regulation in coal-fired power units.},
 author = {Yu, Banglong and Tang, Zhenhao and Pang, Bo and Shen, Tao},
 booktitle = {2025 3rd International Conference on Intelligent Control and Computing (IC&C)},
 doi = {10.1109/IC-C68228.2025.00039},
 issn = {},
 keyword = {Temperature distribution;Solid modeling;Three-dimensional displays;Computational fluid dynamics;Boilers;Real-time systems;Combustion;Regulation;Safety;Spatial resolution;hierarchical hybrid sampling;dynamically weighted loss function;temperature gradient-driven;temperature field prediction},
 month = {April},
 number = {},
 pages = {165-170},
 title = {Temperature Gradient-Driven Adaptive Sampling for Efficient Prediction of Boiler Temperature*},
 volume = {},
 year = {2025}
}
