@article{Gao2018,
 abstract = {This article presents a novel line segment extraction algorithm using two-dimensional (2D) laser data, which is composed of four main procedures: seed-segment detection, region growing, overlap region processing, and endpoint generation. Different from existing approaches, the proposed algorithm borrows the idea of seeded region growing in the field of image processing, which is more efficient with more precise endpoints of the extracted line segments. Comparative experimental results with respect to the well-known Split-and-Merge algorithm are presented to show superior performance of the proposed approach in terms of efficiency, correctness, and precision, using real 2D data taken from our hallway and laboratory. © 2018, © The Author(s) 2018.},
 author = {Gao, Haiming and Zhang, Xuebo and Fang, Yongchun and Yuan, Jing},
 doi = {10.1177/1729881418755245},
 journal = {International Journal of Advanced Robotic Systems},
 note = {Cited by: 40; All Open Access; Gold Open Access; Green Open Access},
 number = {1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A line segment extraction algorithm using laser data based on seeded region growing},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85042763647?origin=resultslist},
 volume = {15},
 year = {2018}
}
