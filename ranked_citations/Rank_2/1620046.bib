@inproceedings{1620046,
 abstract = {This paper gives an introduction into the field of automating product classification and re-classification processes. It therefore starts with an introduction of electronic product catalogs used in e-Business domains and classification systems embedded in those catalogs. Afterwards this paper takes a closer look to the potential of an automated classification of product data and it discusses the importance of reusing existing information when re-classifying catalog data. Moreover, this paper introduces possible technologies and approaches that could be adapted to this e-Business domain to perform an automation and to improve existing software solutions.},
 author = {Abels, S. and Hahn, A.},
