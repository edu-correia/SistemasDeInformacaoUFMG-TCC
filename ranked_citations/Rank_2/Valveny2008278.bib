@article{Valveny2008278,
 abstract = {In this paper we propose a general framework for the characterization of shape descriptors and show its application to graphic symbols. The framework is based on the combination of several performance measures independent of the application. We have applied this framework using a standard set of descriptors and databases. We show how it can be used to characterize the properties of each descriptor for a given database. © 2008 Springer-Verlag Berlin Heidelberg.},
 author = {Valveny, Ernest and Tabbone, Salvatore and Ramos, Oriol and Philippot, Emilie},
 doi = {10.1007/978-3-540-88188-9_26},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 8},
 pages = {278 - 287},
 publication_stage = {Final},
 source = {Scopus},
 title = {Performance characterization of shape descriptors for symbol representation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/55249100777?origin=resultslist},
 volume = {5046 LNCS},
 year = {2008}
}
