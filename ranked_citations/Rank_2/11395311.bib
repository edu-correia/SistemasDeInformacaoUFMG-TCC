@article{11395311,
 abstract = {Today, secure collaborative analytics has been a basic functionality of private and distributed database services. Efficiently handling multi-table SQL queries, whose underlying pivotal operators are join and group-by-aggregation, creates particular challenges for building a large-scale service in a practical way. However, previous works fail to implement operators with low communications, as they rely on costly oblivious operators such as sorting and merging. In this work, we propose SecureCA, a series of communication-efficient protocols for unique-key join and group-by-aggregation. Our protocols support semi-honest three-party join queries, as well as common aggregation methods such as Sum, Avg, and Max/Min. In these protocols, we make a trade-off between efficiency and security and design a novel server-aided architecture that breaks the symmetric structure among computation nodes, transforming high-cost multi-party oblivious operators and correlated randomness generation into local computations while also eliminating redundant sorting for join and group-by operations. Compared to state-of-the-art works, when scaled to millions of records, our protocols perform closed-source work, $\text{AHK}^{+}$AHK+, by $3 \sim 16 \times$3∼16× under a wide-area network, and existing open-source work, Secrecy, by $9 \sim 364 \times$9∼364×.},
 author = {Chen, Pinzhi and Li, Xinyu and Zhou, Peizhao and Han, Ye and Guo, Xiaojie and Li, Tong and Liu, Xiaotao and Liu, Zheli},
 doi = {10.1109/TDSC.2026.3655006},
 issn = {1941-0018},
 journal = {IEEE Transactions on Dependable and Secure Computing},
 keyword = {Protocols;Sorting;Complexity theory;Cryptography;Vectors;Servers;Collaboration;Payloads;Outsourcing;Merging;Secure collaborative analytics;join;group-by-aggregation;secret sharing},
 month = {May},
 number = {3},
 pages = {6378-6395},
 title = {SecureCA: Communication- and Round-Efficient Join and Group-By-Aggregation in Secure Database Services},
 volume = {23},
 year = {2026}
}
