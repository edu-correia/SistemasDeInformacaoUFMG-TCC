@inbook{10348102,
 abstract = {Recently, the autoencoder (AE) has been widely used in channel state information (CSI) feedback to improve feedback performance. In practical systems, the user equipment (UE) may stay in a stable area for a long time, and the propagation environment around the UE remains stable. Based on this, a user&#x2010;centric online training strategy, in which the UE can collect CSI samples in the stable area and adjust the pre&#x2010;trained encoder online, is proposed to further improve CSI reconstruction accuracy. Moreover, the proposed online training framework is extended to the multi&#x2010;user scenario to improve performance sequentially. The key idea is to adopt decentralized federated learning without base station participation to combine the sharing channel knowledge among UEs which is called crowd intelligence. Simulation results show that the decentralized federated learning&#x2010;aided framework has higher feedback accuracy than the AE without online training.},
 author = {Jin, Shi and Guo, Jiajia and Lv, Yan and Cui, Yiming},
 booktitle = {Federated Learning for Future Intelligent Wireless Networks},
 doi = {10.1002/9781119913924.ch12},
 isbn = {9781119913900},
 issn = {},
 keyword = {Image coding;Decoding;Downlink;Artificial neural networks;Training;Image reconstruction;OFDM},
 number = {},
 pages = {273-289},
 publisher = {IEEE},
 title = {User&#x2010;Centric Decentralized Federated Learning for Autoencoder&#x2010;Based CSI Feedback},
 url = {https://ieeexplore-ieee-org.ez27.periodicos.capes.gov.br/document/10348102},
 volume = {},
 year = {2024}
}
