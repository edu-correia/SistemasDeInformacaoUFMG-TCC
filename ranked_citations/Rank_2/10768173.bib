@inproceedings{10768173,
 abstract = {An automated, vision-guided assembly method is proposed for reconstructing LEGO arrangements using a 3 DOF Delta Parallel Robot with a two-finger gripper. Assembly sequence planning, an NP-complete problem, focuses on determining the optimal sequence of bricks for constructing a target structure. The complexity increases when robotic con-straints-such as avoiding collisions between the gripper and the partially constructed structure-are integrated into the planning. To address this, the Arrangement Planning Process is introduced, combining target arrangement identification with collision-aware sequence planning. This process includes precise detection techniques that merge instance segmentation with stud detection. Notable innovations include an assembly-by-disassembly algorithm for efficient planning and experimental techniques such as the Safe Approach and the Wiggling Technique for accurate brick placement. By implementing a homing method, positioning accuracy improved approximately twofold compared to previous work. The results demonstrate the feasibility and precision of the proposed method in automated LEGO reconstruction.},
 author = {Barghi, Arman and Pasiar, Navid and Masouleh, Mehdi Tale and Kalhor, Ahmad},
 booktitle = {2024 10th International Conference on Control, Instrumentation and Automation (ICCIA)},
 doi = {10.1109/ICCIA65044.2024.10768173},
 issn = {2688-0229},
 keyword = {Instance segmentation;Parallel robots;Technological innovation;Accuracy;Three-dimensional displays;Service robots;Robustness;Planning;Grippers;Assembly;Automated reconstruction;Collision-aware;Robot grasping;Sequence planning;Vision-guided assembly},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {From Bricks to Bots: Automated Collision-Aware Sequence Planning for LEGO Reconstruction with a Two-Finger Gripper},
 volume = {},
 year = {2024}
}
