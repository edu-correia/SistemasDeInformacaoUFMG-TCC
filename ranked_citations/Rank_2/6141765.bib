@inproceedings{6141765,
 abstract = {This paper presents a 0.18 μm mixer merged with LNA exploiting noise cancellation technique. It operates between 100MHz and 1GHz. The Gilbert mixer is known for its perfect port isolation and bad noise performance. The transconductor stage of the mixer can be implemented by an LNA exploiting noise cancellation to have a better NF. The chip is implemented in SMIC 0.18μm CMOS technology. Measurement shows that the proposed mixer merged with LNA has a 13.7∼19.5dB voltage gain from 100MHz to 1GHz, noise figure has an average of 5dB and has a minimum value of 3.8dB. The core area is 0.6×0.45mm2.},
 author = {Sun, Jingye and Huang, Lu and Liu, Honghong and Chen, Da-Peng and Lin, Fujiang},
 booktitle = {2011 IEEE International Symposium on Radio-Frequency Integration Technology},
 doi = {10.1109/RFIT.2011.6141765},
 issn = {},
 keyword = {Mixers;Noise cancellation;Noise figure;Switches;Impedance matching;noise cancellation;mixer;LNA;merge;low noise figure},
 month = {Nov},
 number = {},
 pages = {25-28},
 title = {A 0.18 μm mixer merged with LNA exploiting noise cancellation},
 volume = {},
 year = {2011}
}
