@inproceedings{11245452,
 abstract = {Radio Frequency Identification (RFID) is critical for applications like freshness preservation in warehouses, where monitoring environmental data is essential. Existing protocols are inefficient for such requirements, and manual protocol design is resource-intensive. To address this, we propose an automated approach for composing and optimizing RFID protocols. We first introduce a generic RFID requirement description language (GRDL) to formally specify complex requirements and integrate the most similar existing protocols. Then, we introduce an automated performance optimization method for the composed protocols using communication merging, parameter tuning, intermediate parameter reuse and context-aware method adjustments. This method is generic and broadly applicable. For freshness preservation, our protocol outperforms the state-of-the-art protocol SEM by over $\mathbf{8 1. 3 1 \%}$, and the further optimized version reduces the execution time by 58.56 % to 63.46 %.},
 author = {Huang, Changyu and Zhu, Weiping and Ma, Chao and Wu, Runze and Fan, Changjie and Lin, Minmin},
 booktitle = {2025 IEEE International Symposium on Parallel and Distributed Processing with Applications (ISPA)},
 doi = {10.1109/ISPA67752.2025.00175},
 issn = {2158-9208},
 keyword = {Distributed processing;Protocols;Large language models;Merging;Formal languages;Manuals;Tuning;Optimization;Monitoring;Radiofrequency identification;RFID;freshness preservation;generic requirement description language;automatic optimization},
 month = {Oct},
 number = {},
 pages = {1268-1275},
 title = {An Automatically Optimized RFID Protocol for Freshness Preservation},
 volume = {},
 year = {2025}
}
