@article{Groppe20201800,
 abstract = {Today’s state-of-the-art Big data analytics engines handle masses of data, but will reach to their limits, as the future Big data flood is predicted to still grow with an increasing speed. Hence we need to think about the next development phase and future features of Big data analytics engines. In this paper, we discuss possible future enhancements in the area of Big data analytics with focus on emergent models, frameworks, and hardware technologies. We point out a selection of new challenges and open research questions. © 2018, Springer Science+Business Media, LLC, part of Springer Nature.},
 author = {Groppe, Sven},
 doi = {10.1007/s11227-018-2277-x},
 journal = {Journal of Supercomputing},
 note = {Cited by: 11},
 number = {3},
 pages = {1800 - 1827},
 publication_stage = {Final},
 source = {Scopus},
 title = {Emergent models, frameworks, and hardware technologies for Big data analytics},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85042220338?origin=resultslist},
 volume = {76},
 year = {2020}
}
