@conference{Yamada201029,
 abstract = {Inverted index is a core element of current text retrieval systems. They can be dynamically constructed using online indexing approaches in the environment which even a small delay in timeliness cannot be tolerated, and the index must always be queryable and up to date. Recently, efficient online index construction schemes have been proposed, however, previous works have not focused on scalability with the modern commodity hardware resources such as multi-core CPUs. In this paper, we propose a scalable online index construction method that better utilizes multicore CPUs. Using experiments on 30 GB of web data, we demonstrate the efficiency of our method in practice, showing that it dramatically reduces online index construction time without sacrificing query performance. © 2010, Australian Computer Society, Inc.},
 author = {Yamada, Hiroyuki and Toyama, Motomichi},
 journal = {Conferences in Research and Practice in Information Technology Series},
 note = {Cited by: 2},
 pages = {29 - 36},
 publication_stage = {Final},
 source = {Scopus},
 title = {Scalable Online Index Construction with Multi-core cpus},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84873416739?origin=resultslist},
 volume = {104},
 year = {2010}
}
