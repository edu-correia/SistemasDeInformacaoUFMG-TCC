@article{10.14778/3231751.3231765,
 abstract = {Stream-processing workloads and modern shared cluster environments exhibit high variability and unpredictability. Combined with the large parameter space and the diverse set of user SLOs, this makes modern streaming systems very challenging to statically configure and tune. To address these issues, in this paper we investigate a novel control-plane design, Chi, which supports continuous monitoring and feedback, and enables dynamic re-configuration. Chi leverages the key insight of embedding control-plane messages in the data-plane channels to achieve a low-latency and flexible control plane for stream-processing systems.Chi introduces a new reactive programming model and design mechanisms to asynchronously execute control policies, thus avoiding global synchronization. We show how this allows us to easily implement a wide spectrum of control policies targeting different use cases observed in production. Large-scale experiments using production workloads from a popular cloud provider demonstrate the flexibility and efficiency of our approach.},
 author = {Mai, Luo and Zeng, Kai and Potharaju, Rahul and Xu, Le and Suh, Steve and Venkataraman, Shivaram and Costa, Paolo and Kim, Terry and Muthukrishnan, Saravanan and Kuppa, Vamsi and Dhulipalla, Sudheer and Rao, Sriram},
 doi = {10.14778/3231751.3231765},
 issn = {2150-8097},
 issue_date = {June 2018},
 journal = {Proc. VLDB Endow.},
 month = {June},
 number = {10},
 numpages = {14},
 pages = {1303–1316},
 publisher = {VLDB Endowment},
 title = {Chi: a scalable and programmable control plane for distributed stream processing systems},
 url = {https://doi.org/10.14778/3231751.3231765},
 volume = {11},
 year = {2018}
}
