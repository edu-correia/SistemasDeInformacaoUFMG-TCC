@article{Park2022,
 abstract = {Virtual coupling, which refers to the operation of railway vehicles that enables the merge and separation of vehicles on the move by controlling the gap between the vehicles without any mechanical coupling, is one of the technologies for increasing the transport capacity and enhancing operational efficiency. This paper proposes a robust gap controller based on sliding mode control with a nonlinear train model with uncertainties. Additionally, a gap reference generation scheme is developed that ensures that the merge and separation of two trains is completed before a given location and respects constraints on acceleration and jerk. The position and velocity measurement errors arising from imperfect knowledge of wheel diameters are also considered, and a new error correction scheme is proposed to reduce the perturbation in the gap control performance. The proposed schemes are validated through simulations.  © 2000-2011 IEEE.},
 author = {Park, Jaegeun and Lee, Byung-Hun and Eun, Yongsoon},
 doi = {10.1109/TITS.2020.3019979},
 journal = {IEEE Transactions on Intelligent Transportation Systems},
 note = {Cited by: 104},
 number = {2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Virtual Coupling of Railway Vehicles: Gap Reference for Merge and Separation, Robust Control, and Position Measurement},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85124645110?origin=resultslist},
 volume = {23},
 year = {2022}
}
