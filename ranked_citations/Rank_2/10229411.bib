@inproceedings{10229411,
 abstract = {Cluster analysis is an important task in data analysis and machine learning. Traditional clustering methods, such as partitioning and density-based approaches, have limitations in identifying natural clusters in datasets with elliptical and chained shapes. In this paper, we propose a novel hierarchical clustering algorithm for color image segmentation that addresses these limitations by quantifying the degree of overlap between clusters as a similarity measure for the merging process.},
 author = {Gherbaoui, Radhwane and Benamrane, Nacéra and Ouali, Mohammed},
 booktitle = {2023 IEEE 24th International Conference on Information Reuse and Integration for Data Science (IRI)},
 doi = {10.1109/IRI58017.2023.00014},
 issn = {2835-5776},
 keyword = {Image segmentation;Machine learning algorithms;Shape;Merging;Color;Machine learning;Data science;merging approach;color image segmentation;hierarchic method;k-means},
 month = {Aug},
 number = {},
 pages = {34-39},
 title = {A New Similarity Measure and Hierarchical Clustering Approach to Color Image Segmentation},
 volume = {},
 year = {2023}
}
