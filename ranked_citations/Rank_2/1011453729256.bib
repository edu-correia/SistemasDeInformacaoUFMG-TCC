@article{10.1145/3729256,
 abstract = {Spatial dataflow architectures (SDAs) are a promising and versatile accelerator platform. They are software-programmable and achieve near-ASIC performance and energy efficiency, beating CPUs by orders of magnitude. Unfortunately, many SDAs struggle to efficiently implement irregular computations because they suffer from an abstraction inversion: they fail to capture coarse-grain dataflow semantics in the application — namely asynchronous communication, pipelining, and queueing — that are naturally supported by the dataflow execution model and existing SDA hardware. Ripple is a language and architecture that corrects the abstraction inversion by preserving dataflow semantics down the stack. Ripple provides asynchronous iterators, shared-memory atomics, and a familiar task-parallel interface to concisely express the asynchronous pipeline parallelism enabled by an SDA. Ripple efficiently implements deadlock-free, asynchronous task communication by exposing hardware token queues in its ISA. Across nine important workloads, compared to a recent ordered-dataflow SDA, Ripple shrinks programs by 1.9\texttimes{}, improves performance by 3\texttimes{}, increases IPC by 58%, and reduces dynamic instructions by 44%.},
 address = {New York, NY, USA},
 articleno = {157},
 author = {Ghosh, Souradip and Shi, Yufei and Lucia, Brandon and Beckmann, Nathan},
 doi = {10.1145/3729256},
 issue_date = {June 2025},
 journal = {Proc. ACM Program. Lang.},
 keyword = {asynchronous programming, spatial dataflow architectures},
 month = {June},
 number = {PLDI},
 numpages = {28},
 publisher = {Association for Computing Machinery},
 title = {Ripple: Asynchronous Programming for Spatial Dataflow Architectures},
 url = {https://doi.org/10.1145/3729256},
 volume = {9},
 year = {2025}
}
