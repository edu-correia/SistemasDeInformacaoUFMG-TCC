@article{Pozos-Parra201140,
 abstract = {Belief merging aims to conciliate multiple possibly inconsistent belief bases into a consistent common belief base. To handle inconsistency some operators have been proposed. Most of them do not consider inconsistent bases. PS-Merge is an alternative method of merging that uses the notion of Partial Satisfiability and allows us to take into account inconsistent bases. PS-Merge needs the bases represented as DNF formulas, nevertheless, many practical problems are easily represented in its CNF. The aim of this paper is to extend the notion of Partial Satisfiability in order to consider bases represented as CNF formulas. Moreover, we consider Prime Normal forms in order to define a method that allows us to implement PS-Merge for difficult theories. We also show that once the belief bases are represented as sets of normal forms, PS-Merge is polynomial. © 2011 Springer-Verlag.},
 author = {Pozos-Parra, Pilar and Perrussel, Laurent and Thevenin, Jean Marc},
 doi = {10.1007/978-3-642-25324-9_4},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 4},
 number = {PART 1},
 pages = {40 - 51},
 publication_stage = {Final},
 source = {Scopus},
 title = {Belief merging using normal forms},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/82555180534?origin=resultslist},
 volume = {7094 LNAI},
 year = {2011}
}
