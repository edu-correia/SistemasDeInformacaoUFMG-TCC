@article{Bellini2012200,
 abstract = {In this paper we tackle the problem of outlier detection in data envelopment analysis (DEA). We propose a procedure where we merge the super-efficiency DEA and the forward search. Since DEA provides efficiency scores which are not parameters to fit the model to the data, we introduce a distance, to be monitored along the search. This distance is obtained through the integration of a regression model and the super-efficiency DEA. We simulate a Cobb-Douglas production function and we compare the super-efficiency DEA and the forward search analysis in both uncontaminated and contaminated settings. For inference about outliers, we exploit envelopes obtained through Monte Carlo simulations. © 2011 Elsevier B.V. All rights reserved.},
 author = {Bellini, Tiziano},
 doi = {10.1016/j.ejor.2011.07.023},
 journal = {European Journal of Operational Research},
 note = {Cited by: 22},
 number = {1},
 pages = {200 - 207},
 publication_stage = {Final},
 source = {Scopus},
 title = {Forward search outlier detection in data envelopment analysis},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/80052751487?origin=resultslist},
 volume = {216},
 year = {2012}
}
