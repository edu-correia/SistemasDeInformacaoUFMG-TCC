@inproceedings{11356104,
 abstract = {Intelligent diagnostic systems require continual learning (CL) to learn to diagnose new diseases. However, the systems suffer from catastrophic forgetting of old knowledge when learning knowledge of new diseases. Existing CL methods that leverage pre-trained language models (PLMs) to guide visual encoders are ineffective in the medical domain due to PLMs' limited medical knowledge. Here, we propose Textual Prototype-Guided Continual Learning (TPGCL) for effective CL. TPGCL utilizes an image captioning model to generate semantically rich disease descriptions, which are then encoded into text embeddings via a text encoder to obtain the textual prototype for each class. These prototypes guide the visual encoder during CL. In addition, a gradient-weighting mechanism merges visual adapters learned from all CL stages to preserve old knowledge and prevent model growth and adapter selection issue. Extensive experiments on three medical image datasets demonstrate TPGCL's superiority in continually learning new diseases. The source code is available at https://github.com/z1968357787/TPGCL},
 author = {Zhou, Zhiping and Yu, Tong and Zhang, Yizhe and Zheng, Wei-Shi and Wang, Ruixuan},
 booktitle = {2025 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)},
 doi = {10.1109/BIBM66473.2025.11356104},
 issn = {2156-1133},
 keyword = {Continuing education;Visualization;Adaptation models;Source coding;Prototypes;Medical diagnosis;Bioinformatics;Medical diagnostic imaging;Diseases;Image classification;Continual learning;Catastrophic forgetting;Textual prototype;Disease diagnosis},
 month = {Dec},
 number = {},
 pages = {1978-1983},
 title = {Textual Prototype-Guided Continual Learning for Medical Image Classification},
 volume = {},
 year = {2025}
}
