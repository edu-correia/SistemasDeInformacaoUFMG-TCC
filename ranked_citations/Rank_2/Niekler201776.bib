@article{Niekler201776,
 abstract = {In this paper a natural language processing workflow to extract sequential activities from large collections of medical text documents is developed. A graph-based data structure is introduced to merge extracted sequences which contain similar activities in order to build a global graph on procedures which are described in documents on similar topics or tasks. The method describes an information extraction process which will, in the future, enrich or create knowledge bases for process models or activity sequences for the medical domain. © Springer International Publishing AG 2017.},
 author = {Niekler, Andreas and Kahmann, Christian},
 doi = {10.1007/978-3-319-68723-0_7},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 0},
 pages = {76 - 88},
 publication_stage = {Final},
 source = {Scopus},
 title = {Extracting process graphs from medical text data: An approach towards a systematic framework to extract and mine medical sequential processes descriptions from large text sources},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85033480188?origin=resultslist},
 volume = {10579 LNCS},
 year = {2017}
}
