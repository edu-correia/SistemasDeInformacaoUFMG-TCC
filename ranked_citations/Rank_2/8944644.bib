@inproceedings{8944644,
 abstract = {This paper is devoted to present various compact and novel multi-port planar merged ultra-wide band and narrow band antenna systems for cognitive radio process in the ultra-wide band 3.1-10.6 GHz. In these systems, each system consists of one ultra-wide band antenna for frequency holes monitoring and many narrow band antennas for signal transmission and reception. These antennas are merged on the top portion of a single FR-4 substrate and accessed at multiple ports. The ultra-wide band antennas function in the total band of 3.1-10.6 GHz and the narrow band antennas accomplish either mono or double bands. The proposed multi-port merged antenna systems include one three port, one five port and one four port merged ultra-wide band and narrow band antenna systems. The three port ultra-wide band and narrow band antenna system consists one ultra-wide band antenna and two narrow band antennas. These two narrow band antennas are intended to achieve four bands in the ultra-wide band spectrum. The five port antenna system comprises of one ultra-wide band antenna and four narrow band antennas. The four port antenna system consists of one ultra-wide band antenna and three narrow band antennas. These narrow band antennas are incorporated to function in all the channels of ultra-wide band spectrum. Experimental results show good agreements with the simulated performance.},
 author = {Anveshkumar, N. and Gandhi, Abhay S.},
 booktitle = {2019 10th International Conference on Computing, Communication and Networking Technologies (ICCCNT)},
 doi = {10.1109/ICCCNT45670.2019.8944644},
 issn = {},
