@inproceedings{5409715,
 abstract = {The watershed transform is a very powerful segmentation tool which guarantees closed contours. In this paper the watershed transform is used for the segmentation of a very simple image consisting of a circle, a rectangle and a background region. The ability of different merge criteria to find these major structures based on the highly over-segmented watershed transform for different signal to noise ratios (SNR) is analyzed. Special focus is given to the compensation of prior merge probabilities induced by the topology of the over-segmented watershed images. Herby a relative performance increase of 5.1% to 23.5% is achieved for the different merge criteria.},
 author = {Grosser, Tobias and Hellwich, Olaf and Wendemuth, Andreas},
 booktitle = {2009 2nd International Conference on Adaptive Science & Technology (ICAST)},
 doi = {10.1109/ICASTECH.2009.5409715},
 issn = {2326-9448},
 keyword = {Algorithm design and analysis;Image segmentation;Image edge detection;Signal processing algorithms;Floods;Signal analysis;Computer vision;Signal to noise ratio;Merging;Water resources;watershed transform;segmentation;region merging},
 month = {Jan},
 number = {},
 pages = {250-256},
 title = {Analysis of merge criteria within a watershed based segmentation algorithm},
 volume = {},
 year = {2009}
}
