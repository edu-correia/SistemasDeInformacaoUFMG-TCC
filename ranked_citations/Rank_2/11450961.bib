@inproceedings{11450961,
 abstract = {Under the background of national strategies for new power system construction and energy structure transformation, the installed capacity of new energy has grown exponentially, leading to an urgent demand for intelligent upgrading of power protection and control equipment. Traditional operation and maintenance (Operation and Maintenance) modes for relay protection and control devices face bottlenecks such as low efficiency of serial upgrading, lack of differentiated backup systems, single intelligent self-inspection methods, and weak human-machine collaboration. To address these issues, Nanjing Guodian Nanzi Automation Co., Ltd. has developed an intelligent Operation and Maintenance system for relay protection and control devices suitable for multi-scenario and full voltage levels. The system integrates four key technologies: batch whole-machine upgrading based on full-link intelligent scheduling, multi-scenario and multi-mode differentiated backup, intelligent automatic merging of multisource program packages, and one-click automatic device initialization and detection synchronization. Practical verification shows that the system reduces the number of upgrade operations by 86%, shortens the backup time per device from 300 seconds to 20 seconds (15-fold efficiency improvement), and achieves an annual cost reduction and efficiency increase of approximately 5.5 million RMB. By 2024, it has supported over 21,000 high-voltage devices and $\mathbf{6 2, 0 0 0}$ low-voltage devices, with a cumulative economic benefit of 11 million RMB. This system provides a replicable intelligent solution for the power equipment Operation and Maintenance field and promotes the digital transformation of the power automation industry.},
 author = {Xue, Zhong and Zhang, Yao and Yue, Feng and Dong, Bei},
 booktitle = {2025 4th Asian Conference on Frontiers of Power and Energy (ACFPE)},
 doi = {10.1109/ACFPE67232.2025.11450961},
 issn = {},
 keyword = {Automation;Digital transformation;Merging;Protective relaying;Wind farms;Maintenance;Power systems;Synchronization;Voltage control;Protection;Relay protection and control device;intelligent operation and maintenance system;batch upgrading;differentiated backup},
 month = {Oct},
 number = {},
 pages = {354-358},
 title = {Research of Operation and Maintenance System for Relay Protection Devices with Full Voltage Level},
 volume = {},
 year = {2025}
