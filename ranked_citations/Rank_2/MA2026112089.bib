@article{MA2026112089,
 abstract = {As blockchain ecosystems expand, the storage layer has emerged as one of the primary scalability bottlenecks. The structural mismatch between the Merkle Patricia Trie (MPT) and the underlying Log-Structured Merge Tree (LSM-Tree) databases in account-model blockchains leads to severe read amplification. In this paper, we propose Harvester, a transaction-driven heterogeneous caching mechanism. Unlike traditional unified caches, Harvester implements a decoupled architecture that prioritizes critical state access by autonomously discovering hotspot accounts from historical blockchain execution behaviors. To address the dynamic nature of transaction distributions, we introduce the Tree-structured Parzen Estimator (TPE) to adaptively tune scoring parameters through a closed-loop feedback mechanism. Extensive evaluations using a real-world Ethereum dataset demonstrate that Harvester effectively mitigates database I/O pressure and accelerates block processing throughput compared to the native go-ethereum implementation. By lowering the hardware entry barrier for state management, Harvester provides a scalable and resource-efficient way to enhance the decentralization of the blockchain network.},
 author = {Zhiyu Ma and Xiaofeng Li and He Zhao and Bin Yu and Tong Zhou and Nianzu Sheng},
 doi = {https://doi.org/10.1016/j.comnet.2026.112089},
 issn = {1389-1286},
 journal = {Computer Networks},
 keyword = {Blockchain, Storage optimization, Cache mechanism},
 pages = {112089},
 title = {Harvester: A transaction-driven heterogeneous caching mechanism for blockchain},
 url = {https://www.sciencedirect.com/science/article/pii/S1389128626001015},
 volume = {278},
 year = {2026}
}
