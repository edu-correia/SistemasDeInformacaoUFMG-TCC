 publication_stage = {Final},
 source = {Scopus},
 title = {Möbius Strip Model for Augmenting Organizational Knowledge Creation Dynamics by Integrating Human and Artificial Knowledge: A New Driving Force for Business Sustainability},
 type = {Article},
