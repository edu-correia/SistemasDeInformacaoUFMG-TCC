@inproceedings{11341457,
 abstract = {In this era, cultural heritage artifacts are prone to surface damage such as abrasions, corrosion, and decay, making digital restoration a viable approach for preservation. In this paper, a hybrid deep learning framework name called AttnDiffRestorer is proposed that combines attention-driven feature modeling, diffusion-based inpainting, and adversarial refinement to achieve high-fidelity image-to-image translation in cultural heritage restoration. The hybrid encoder incorporates Depthwise Convolution (DWConv) for encoding local texture, as well as Dual-Pruned Self-Attention (DPSA) to provide long-range structural awareness in the model, thereby permitting the capture of both microstructural and geometric details. The extracted features from the encoder are provided to the Stable Diffusion U-Net decoder, which reconstructs degraded areas in a hierarchical manner utilizing noise-aware denoising and contextual inpainting across several diffusion steps. The realistic perceptual quality of the syntheses is evaluated by an attention-based PatchGAN discriminator, and a composite multi-objective loss operates in concert to balance the adversarial, perceptual, structural, and diffusion consistency objectives in the translation outputs.},
 author = {Venuthurumilli, Pradeep and G, Kruthika. C and L, Hemalatha. K and Chintalapati, S. Sowjanya and P, Venkateshwaran.},
 booktitle = {2025 International Conference on Communication, Computer, and Information Technology (IC3IT)},
 doi = {10.1109/IC3IT66137.2025.11341457},
 issn = {},
 keyword = {Translation;Noise reduction;Merging;Stochastic processes;Inspection;Feature extraction;Multitasking;Image restoration;Cultural differences;Standards;adversarial learning;attention mechanism;cultural heritage restoration;diffusion models;image-to-image translation},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {AttnDiff-Restorer: A Hybrid Attention-Diffusion Framework for High-Fidelity Image-to-Image Translation in Cultural Heritage Restoration},
 volume = {},
 year = {2025}
}
