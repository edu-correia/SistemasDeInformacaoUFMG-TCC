@inproceedings{11378153,
 abstract = {Millions of people suffer from Carpal Tunnel Syndrome (CTS), a common ailment that impairs hand function and creates pain. This research introduces a novel smart glove that combines cloud computing and deep neural networks (DNN) to detect CTS. The glove's sensors capture real-time data on wrist position, force effort, and muscle activity, which track hand motions and physiological signals. Advanced DNN algorithms that have been trained to recognize patterns suggestive of CTS are used to analyze the gathered data. The system uses cloud integration to provide ongoing monitoring and analysis, which permits prompt identification and action. Users may access their health information and get feedback through a specialized smartphone application, encouraging proactive condition treatment. This method gives patients useful information about their health to improve the precision of CTS diagnosis. The smart glove is an important development in wearable technology for medical purposes, which shows how merging cloud computing and deep learning may lead to better healthcare results.},
 author = {Parvathi, B. and Vizhi, R. Malar and Meenakshi, R. and Sivakumar, V G and Ganesh, N. and V E, Sathishkumar},
 booktitle = {2025 International Conference on Computing and Communications (COMPUTINGCON)},
 doi = {10.1109/COMPUTINGCON64838.2025.11378153},
 issn = {},
 keyword = {Hands;Cloud computing;Carpal tunnel syndrome;Artificial neural networks;Medical services;Real-time systems;Pattern recognition;Biomedical monitoring;Wearable devices;Intelligent sensors;Carpal Tunnel Syndrome;Health Monitoring;Physiological Signals;Real-Time Data;Pattern Recognition;User Feedback},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Smart Glove for Carpal Tunnel Syndrome Detection using Deep Neural Networks and Cloud Integration},
 volume = {},
 year = {2025}
}
