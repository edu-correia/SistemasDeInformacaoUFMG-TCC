@inproceedings{11291510,
 abstract = {Logic-in-memory (LIM) computing, which merges logic and memory operations within a single framework, presents a transformative approach to mitigating the memory bottleneck. Ferroelectric Field-Effect Transistors (FeFETs), particularly those based on hafnium-zirconium oxide (HZO), offer promising prospects for LIM architectures due to their non-volatility, CMOS compatibility, and scalability. This research develops a multi-scale simulation and modeling framework from material to circuit level to explore and optimize FeFET behavior for next-generation logic-in-memory systems. Utilizing density functional theory, phase-field modeling, and TCAD simulations augmented by Landau-Khalatnikov theory, the study captures ferroelectric switching dynamics and retention behavior. Compact Verilog-A models are proposed for circuit-level simulations. The integration strategy emphasizes the atomic layer deposition of HZO, rapid thermal annealing for stabilizing the orthorhombic phase, and gate stack optimization. Experimental benchmarking validates simulation outcomes and demonstrates the feasibility of FeFET-based LIM blocks, highlighting their superior energy-delay performance compared to conventional memory solutions. The findings offer essential insights into the co-design of materials, devices, and processes for future in-memory computing platforms.},
 author = {A, Harsha Ragini. and G, Ramana Murthy.},
 booktitle = {2025 Third International Conference on Cyber Physical Systems, Power Electronics and Electric Vehicles (ICPEEV)},
 doi = {10.1109/ICPEEV67897.2025.11291510},
 issn = {},
 keyword = {Semiconductor device modeling;Scalability;Computer architecture;Switches;Logic gates;Transistors;Integrated circuit modeling;Vehicle dynamics;FeFETs;Standards;Ferroelectric Field-Effect Transistors (FeFETs);Logic-in-Memory (LIM);Hafnium-Zirconium Oxide (HZO);Retention and Endurance},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Innovative Device Modeling of Ferroelectric FETs for Intelligent Memory-Logic Integration},
 volume = {},
 year = {2025}
}
