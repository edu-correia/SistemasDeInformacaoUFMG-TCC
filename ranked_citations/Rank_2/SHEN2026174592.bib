@article{SHEN2026174592,
 abstract = {The pervasive contamination of agricultural products by Aflatoxin B1 (AFB1) represents a critical global health challenge, demanding advanced sensing technologies capable of rapid, on-site detection. Here, we report an innovative smartphone-integrated microfluidic photoelectrochemical (PEC) biosensing platform that seamlessly merges nanomaterial engineering, molecular recognition, and wireless connectivity for field-deployable AFB1 monitoring. Central to this system is a rationally designed three-dimensional WO₃ nanoplate/ZnO nanosheet heterostructure photoanode (3D WO₃/ZnO heterostructure arrays), where interfacial bandgap engineering significantly promotes charge separation efficiency. By integrating aptamer-functionalized magnetic separation with serpentine microfluidic mixing channels, we achieve remarkable interference rejection while [Ru(bpy)₂dppz]2+-intercalated dsDNA serves as a dual-function amplifier-target-induced DNA unwinding triggers controlled electron donor release, generating quantifiable photocurrent attenuation directly proportional to AFB1 concentrations across a broad range (10−3–102 ng/mL). Furthermore, our custom-developed embedded electronics enable real-time PEC signal acquisition through a smartphone interface via Bluetooth, supported by a miniaturized potentiostat that matches benchtop performance. The platform achieves an exceptional detection limit of 0.123 pg/mL and demonstrates excellent accuracy in practical maize samples (RSD = 2.83–3.33%). This work establishes a new paradigm for decentralized biosensing by unifying nanoscale charge transfer optimization, microfluidic automation, and smartphone-enabled diagnostics, paving the way for transformative solutions in food safety monitoring and point-of-care testing in resource-limited settings.},
 author = {Yuchen Shen and Gaofeng Cao and Junhui Wang and Juan Wang},
 doi = {https://doi.org/10.1016/j.cej.2026.174592},
 issn = {1385-8947},
 journal = {Chemical Engineering Journal},
 keyword = {3D heterostructure, Hole-trapping, Photocurrent, Aptamer recognition, Interfacial charge transfer},
 pages = {174592},
 title = {Microfluidic photoelectrochemical aptasensing platform with DNA-intercalated signal amplification for ultrasensitive aflatoxin B1 detection},
 url = {https://www.sciencedirect.com/science/article/pii/S1385894726020516},
 volume = {533},
 year = {2026}
}
