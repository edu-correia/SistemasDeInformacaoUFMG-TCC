@article{10.1145/1380564.1380569,
 abstract = {A policy describes the conditions under which an action is permitted or forbidden. We show that a fragment of (multi-sorted) first-order logic can be used to represent and reason about policies. Because we use first-order logic, policies have a clear syntax and semantics. We show that further restricting the fragment results in a language that is still quite expressive yet is also tractable. More precisely, questions about entailment, such as “May Alice access the file?”, can be answered in time that is a low-order polynomial (indeed, almost linear in some cases), as can questions about the consistency of policy sets.},
 address = {New York, NY, USA},
 articleno = {21},
 author = {Halpern, Joseph Y. and Weissman, Vicky},
 doi = {10.1145/1380564.1380569},
 issn = {1094-9224},
 issue_date = {July 2008},
 journal = {ACM Trans. Inf. Syst. Secur.},
 keyword = {Digital rights management},
 month = {July},
 number = {4},
 numpages = {41},
 publisher = {Association for Computing Machinery},
 title = {Using First-Order Logic to Reason about Policies},
 url = {https://doi.org/10.1145/1380564.1380569},
 volume = {11},
 year = {2008}
}
