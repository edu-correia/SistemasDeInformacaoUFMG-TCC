@inproceedings{1035547,
 abstract = {Content based retrieval from distributed libraries raises new and challenging issues with respect to retrieval from a single repository. In particular, an effective management of distributed libraries develops upon three main processes: resource description (extraction of descriptors that qualify the content of a given archive), resource selection (given a user query, analyze resource descriptions and select the resources that contain relevant documents) and results merging (organize and present items returned by individual libraries). So far, these issues have been mainly addressed for text archives. We present a solution to resource descriptors extraction, developing on the use of techniques for multidimensional data indexing. In particular, we implement and compare the extraction of resource descriptors computed through two different indexing approaches; namely m-tree indexing and fuzzy clustering. Comparative results are presented for a test database of about 1000 images.},
 author = {Berretti, S. and Del Bimbo, A. and Pala, R.},
 booktitle = {Proceedings. IEEE International Conference on Multimedia and Expo},
 doi = {10.1109/ICME.2002.1035547},
 issn = {},
 keyword = {Indexing;Libraries;Content based retrieval;Data mining;Content management;Resource management;Merging;Multidimensional systems;Testing;Image databases},
 month = {Aug},
 number = {},
 pages = {197-200 vol.2},
 title = {Using indexing structures for resource descriptors extraction from distributed image repositories},
 volume = {2},
 year = {2002}
}
