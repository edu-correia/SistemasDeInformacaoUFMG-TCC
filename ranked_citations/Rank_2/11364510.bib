@inproceedings{11364510,
 abstract = {Human trafficking remains a significant global challenge, with online sex advertisements serving as a key channel for traffickers. Our research applies advanced machine learning techniques to automate detection of traffickingrelated content, effectively identifying indicators of trafficking by recognizing complex data patterns and detecting anomalies within large datasets. The study further proposes a real-time, automated platform that integrates web crawling, intelligent filtering, and dynamic record merging to support law enforcement agencies. This platform could provide actionable insights through predictive analytics and automated alerts, significantly enhancing the efficiency of trafficking detection while offering a scalable, data-driven approach for combating this form of “modern-day slavery”.},
 author = {Pannu, Mandeep and Frank, Richard and Cartwright, Barry and Padda, Karmvir K. and Strange, Sarah-May and Warkentin, Noelle and Zhang, Cicilia},
 booktitle = {2025 IEEE Canadian Conference on Electrical and Computer Engineering (CCECE)},
 doi = {10.1109/CCECE64018.2025.11364510},
 issn = {2576-7046},
 keyword = {Machine learning algorithms;Law enforcement;Filtering;Social networking (online);Merging;Urban areas;Machine learning;Real-time systems;Pattern recognition;Predictive analytics;Human Trafficking Detection;Machine Learning;Web Scraping;Law Enforcement},
 month = {May},
 number = {},
 pages = {666-672},
 title = {Using Web-Crawling Technology and Machine-Learning to Automate Identification of Sex Trafficking Content in Online Escort Advertisements},
 volume = {},
 year = {2025}
}
