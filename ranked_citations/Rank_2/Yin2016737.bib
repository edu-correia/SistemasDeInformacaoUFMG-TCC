@article{Yin2016737,
 abstract = {This paper researches the uncertain portfolio selection problem when security returns are hard to be well reflected by previous data. We take security returns as uncertain variables. Firstly, three new portfolio selection models are presented based on the cross-entropy of uncertain variables. Secondly, the crisp form of the new model is also provided when security returns are linear uncertain variables. In addition, the gravitation search algorithm and numerical integration are introduced to solve the proposed models. Finally, several numerical examples are presented to illustrate the effectiveness of the algorithm and the application of the mathematical models. © 2016 - IOS Press and the authors. All rights reserved.},
 author = {Yin, Mingqiang and Qian, Weiyi and Li, Wei},
 doi = {10.3233/JIFS-169006},
 journal = {Journal of Intelligent and Fuzzy Systems},
 note = {Cited by: 7},
 number = {2},
 pages = {737 - 747},
 publication_stage = {Final},
 source = {Scopus},
 title = {Portfolio selection models based on Cross-entropy of uncertain variables},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84988353061?origin=resultslist},
 volume = {31},
 year = {2016}
}
