@article{PARK2025236718,
 abstract = {Sodium-ion layered transition metal oxides (LTMOs) are promising cathode materials but suffer from phase transitions during cycling. Compared to monophasic LTMOs, P2/O3-type LTMOs mitigate these transitions while benefiting from the synergistic interaction of two monophasic structures. However, the lack of precise atomic configurations for P2/O3 LTMOs limits their detailed analysis. To address this, density functional theory (DFT) calculations are performed to investigate how dopants inhibit phase transitions in biphasic LTMOs. P2/O3-type Na0.85Fe0.5Mn0.5O2 (NFMO) is constructed by merging two monophasic structures. Doping strategies generated three variants (Na0.85Fe0.4Mn0.4D0.2O2, D = dopants), which are analyzed using DFT to assess the effects of doping. Among the three dopants considered, only Ti-doped NFMO maintained its P2/O3 phase even with 88 % desodiation, showing enhanced structural stability with a 4.0 % reduced volume variation compared to undoped NFMO. To uncover the origin of phase transitions in biphasic LTMOs, factors such as interlayer thickness, atomic charge, and bond length are analyzed. Sodium layer spacing emerges as the critical factor. This study provides valuable structural insights into biphasic LTMOs and highlights strategies for designing materials with suppressed phase transitions, offering a pathway to advancing sodium-ion battery performance.},
 author = {Taehyun Park and Jinyoung Jeong and Seungpyo Kang and Jonghyuk Kim and Kyoungmin Min},
 doi = {https://doi.org/10.1016/j.jpowsour.2025.236718},
 issn = {0378-7753},
 journal = {Journal of Power Sources},
 keyword = {Layered transition metal oxide, Biphasic cathode, Phase transition, Density functional theory calculations, Sodium-ion batteries},
 pages = {236718},
 title = {Revealing the role of dopants to suppress phase transition in biphasic layered transition metal oxide cathodes for sodium-ion batteries},
 url = {https://www.sciencedirect.com/science/article/pii/S0378775325005543},
 volume = {640},
 year = {2025}
}
