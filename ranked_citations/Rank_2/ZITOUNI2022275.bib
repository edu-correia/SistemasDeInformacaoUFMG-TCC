@incollection{ZITOUNI2022275,
 abstract = {Using endoscopy method is very efficient in medical domains due to its aptitude to examine the digestive disease precisely. Nevertheless, it is difficult to be used in old wire-based technique since it causes huge discomfort to patients. For this reason, a wireless endoscopic capsule has been presented in the past few years. Several performances criteria need to be optimized for this kind of capsules such as power consumption, area, speed, and quality of the received images. In this chapter, we focus on the minimization of the cited criteria. The presented approach aims to explore the advantages of the discrete cosine transform (DCT) and discrete wavelet transform (DWT) coding methods by merging them into a unique design. The modified look-ahead carry (MCLA) approach is used for arithmetic computations. A context adaptive binary arithmetic coding (CABAC) entropy coder that allows all possible binarization patterns is used with this architecture. The communication inside the capsule architecture is based on the adaptation of the parallel/serial AMBA/I2C busses while ensuring an efficient data transferring. The proposed design is compared with a set of well-known approaches. Experimental results prove that this design is high-performance-oriented in terms of power consumption, area, speed, and images quality.},
 author = {Abdelkrim Zitouni and Nedra Jarray and Majdi Elhajji},
 booktitle = {Endorobotics},
 doi = {https://doi.org/10.1016/B978-0-12-821750-4.00012-8},
 editor = {Luigi Manfredi},
 isbn = {978-0-12-821750-4},
 keyword = {Wireless endoscopy capsule, DCT transform, DWT transform, CABAC entropy coder, AMBA bus, I2C bus},
 pages = {275-293},
 publisher = {Academic Press},
 title = {Chapter 12 - Case study of vision systems: Optimized compression architecture for wireless endorobots},
 url = {https://www.sciencedirect.com/science/article/pii/B9780128217504000128},
 year = {2022}
}
