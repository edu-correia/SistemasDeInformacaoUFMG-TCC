@article{AcevedoUrquiaga2020_922,
 abstract = {Abstract The objective of this research is to analyze the supply chain of the health sector in the territory of the province of Matanzas. A hospital was used as the basis for the study in order to identify the operation of the chain through the development of logistics activities. This to determine if there is a relationship between the different elements that compose it. The tools were used: checklist, flow chart and performance of teamwork techniques. In addition to conducting individual interviews and reviewing the literature. A methodology that characterizes the chain and its actors is applied, together with its diagnosis and proposing measures for its improvement. This allowed determining that the main problem refers to the lack of integration between the different elements of the chain, which negatively affects the development of activities aimed at satisfying the customer at the lowest possible cost.},
 author = {Acevedo-Urquiaga, Ana Julia and Sablón-Cossío, Neyfe and Acevedo-Suárez, José Antonio and González-Rodríguez, Yanara and Martín-Marrero, Anamaris},
 doi = {10.15446/dyna.v87n215.86337},
 number = {215},
 pages = {9--17},
 title = {Analysis of the hospital supply chain in a Cuban territory},
 volume = {87},
 year = {2020}
}
