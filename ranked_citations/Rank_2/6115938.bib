@inproceedings{6115938,
 abstract = {The 3D technology has been one of the fastest growing technologies in the recent years. This paper proposed a high performance 3D stereoscopic video coding system in redundant wavelet domain utilizing a multiband variable size block motion compensation technique. Our approach is based on structure from motion techniques and uses Depth-based rendering to reconstruct the desired stereo views for each video frame. The depth image has a low energy and does not have sharp boundaries; therefore, it is not an easy task to obtain an accurate motion vector. Fortunately, the redundant wavelet domain provides a good solution by retaining all the phase information and provides a multiple prediction possibilities for motion techniques.},
 author = {Suliman, Ahmed and Li, Robert},
 booktitle = {2011 Visual Communications and Image Processing (VCIP)},
 doi = {10.1109/VCIP.2011.6115938},
 issn = {},
 keyword = {Three dimensional displays;Correlation;Discrete wavelet transforms;Cameras;Wavelet domain;Vectors;Equations},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {New stereo video coding in redundant wavelet domain},
 volume = {},
 year = {2011}
}
