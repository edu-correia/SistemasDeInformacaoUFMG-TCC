 issn = {},
 keyword = {Biometrics;Accuracy;Sensitivity;Biological system modeling;Computational modeling;Hidden Markov models;Data integration;Biometric authentication;Data models;Security;Multimodal biometric;biometric traits;spoofing;environmental factors;financial services},
