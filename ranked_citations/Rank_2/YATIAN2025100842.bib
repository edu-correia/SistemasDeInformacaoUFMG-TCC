@article{YATIAN2025100842,
 abstract = {Dialogue relation extraction aims to identify semantic relations between entity pairs from dialogue text. Multi-party dialogues present unique challenges due to dynamic speaker interactions and cross-turn dependencies, which existing methods fail to adequately model. We propose the Multi-Perspective Contextual Interaction Attention Network (MPCIA-Net) to address these limitations through two key components: (1) The Dual-stream Context Disentanglement Module (DCDM), which decouples context representations from the base encoder through parallel feature streams and integrates fine-grained contextual features; (2) The Dual-Attention Fusion Module (DAF), which processes features from dual perspectives—speaker perception for pronoun resolution through dialogue participant identity modelling, and utterance perception for capturing long-range cross-turn dependencies. The representations from both channels are merged through an adaptive attention mechanism for final relation prediction. Experimental results demonstrate that MPCIA-Net achieves an F1 score of 68.70% on the DialogRE dataset, surpassing current state-of-the-art methods.},
 author = {Shen Yatian and Deng Guosong and Qi Chaohao and Wang Songyang and Yanli Xu and Han Daojun and Lu Chengeng},
 doi = {https://doi.org/10.1016/j.eij.2025.100842},
 issn = {1110-8665},
 journal = {Egyptian Informatics Journal},
 keyword = {Dialogue relation extraction, Multi-party dialogues, Dual-stream context disentanglement module, Dual-attention fusion module},
 pages = {100842},
 title = {Dialogue relation extraction based on Multi-Perspective Contextual Interaction Attention Network},
 url = {https://www.sciencedirect.com/science/article/pii/S111086652500235X},
 volume = {32},
 year = {2025}
}
