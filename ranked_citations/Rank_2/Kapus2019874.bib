@conference{Kapus2019874,
 abstract = {Analysing and comprehending C programs that use strings is hard: using standard library functions for manipulating strings is not enforced and programs often use complex loops for the same purpose. We introduce the notion of memoryless loops that capture some of these string loops and present a counterexample-guided synthesis approach to summarise memoryless loops using C standard library functions, which has applications to testing, optimisation and refactoring. We prove our summarisation is correct for arbitrary input strings and evaluate it on a database of loops we gathered from thirteen open-source programs. Our approach can summarise over two thirds of memoryless loops in less than five minutes of computation time per loop. We then show that these summaries can be used to (1) improve symbolic execution (2) optimise native code, and (3) refactor code. © 2019 Copyright held by the owner/author(s). Publication rights licensed to ACM.},
 author = {Kapus, Timotej and Ish-Shalom, Oren and Itzhaky, Shachar and Rinetzky, Noam and Cadar, Cristian},
 doi = {10.1145/3314221.3314610},
 journal = {Proceedings of the ACM SIGPLAN Conference on Programming Language Design and Implementation (PLDI)},
 note = {Cited by: 12},
 pages = {874 - 888},
 publication_stage = {Final},
 source = {Scopus},
 title = {Computing summaries of string loops in C for better testing and refactoring},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85067697097?origin=resultslist},
 year = {2019}
}
