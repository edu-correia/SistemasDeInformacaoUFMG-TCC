@inproceedings{7161528,
 abstract = {k Nearest Neighbours (k-NN) search is a fundamental problem in many computer vision and machine learning tasks. These tasks frequently involve a large number of high-dimensional vectors, which require intensive computations. Recent research work has shown that the Graphics Processing Unit (GPU) is a promising platform for solving k-NN search. However, these search algorithms often meet a serious bottleneck on GPUs due to a selection procedure, called k-selection, which is the final stage of k-NN and significantly affects the overall performance. In this paper, we propose new data structures and optimization techniques to accelerate k-selection on GPUs. Three key techniques are proposed: Merge Queue, Buffered Search and Hierarchical Partition. Compared with previous works, the proposed techniques can significantly improve the computing efficiency of k-selection on GPUs. Experimental results show that our techniques can achieve an up to 4:2× performance improvement over the state-of-the-art methods.},
 author = {Tang, Xiaoxin and Huang, Zhiyi and Eyers, David and Mills, Steven and Guo, Minyi},
 booktitle = {2015 IEEE International Parallel and Distributed Processing Symposium},
 doi = {10.1109/IPDPS.2015.115},
 issn = {1530-2075},
 keyword = {Graphics processing units;Instruction sets;Sorting;Time complexity;Search problems;Buffer storage;Data structures;k-NN;k-selection;GPUs;Merge Queue;Buffered Search;Hierarchical Partition},
 month = {May},
 number = {},
 pages = {397-406},
 title = {Efficient Selection Algorithm for Fast k-NN Search on GPUs},
 volume = {},
 year = {2015}
}
