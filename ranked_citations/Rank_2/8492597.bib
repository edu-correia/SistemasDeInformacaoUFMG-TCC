@inproceedings{8492597,
 abstract = {Based on the traffic conflict technique, this paper analyzes the aerial photography video of the highway interchanges, obtains the survey data, and calibrates the parameters of VISSIM and SSAM. Traffic conflict prediction models for single lane ramp and two-lane ramp are established. The negative binomial distribution model is selected as the single-lane ramp collision prediction model, and the Poisson distribution model is selected for the two-lane ramp collision prediction model. The test results show that the model has high accuracy, and MAPE is 8.41 % and 12.0% respectively. The results show the models can provide a basis for the safety assessment of highway merging area and the decrease of traffic accidents.},
 author = {Cai, Yun Wen and Xiang, Qiao Jun and Li, Yan and Ming, Xiao Song},
 booktitle = {2018 3rd IEEE International Conference on Intelligent Transportation Engineering (ICITE)},
 doi = {10.1109/ICITE.2018.8492597},
 issn = {},
 keyword = {Merging;Safety;Predictive models;Computer crashes;Accidents;Data models;Road transportation;traffic conflict;traffic simulation;collision prediction model;traffic safety},
 month = {Sep.},
 number = {},
 pages = {324-329},
 title = {Collision Prediction Model for Interchange Mergring Area Based on Traffic Conflict Technique},
 volume = {},
 year = {2018}
}
