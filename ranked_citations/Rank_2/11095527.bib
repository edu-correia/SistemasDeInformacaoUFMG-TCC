@inproceedings{11095527,
 abstract = {This paper presents the integration of SystemC with Spice, aiming the mix-signal simulation of both digital and analog behaviors in electronic systems to provide a comprehensive and accurate performance analysis. The importance of co-simulation for managing complex systems is highlighted, combining analog and digital models to offer a robust solution for accurate system modeling. The paper details the development of an analog behavior model for Infineon's Automotive Smart Power Switch using Spice and SystemC, emphasizing the switches' protection functions and advanced diagnostic capabilities. By employing SystemC modules, the model overcomes convergence issues and enhances simulation efficiency, illustrating the benefits of merging different modeling techniques.},
 author = {Dragomir, Ionuţ Alexandru and Gogu, Laurentiu-Costin and Shikhar, Dwivedi and Gheorghe, Laura-Alexandra},
 booktitle = {2025 17th International Conference on Electronics, Computers and Artificial Intelligence (ECAI)},
 doi = {10.1109/ECAI65401.2025.11095527},
 issn = {2688-0253},
 keyword = {Analytical models;Technological innovation;Accuracy;Computational modeling;Switches;Systems modeling;Syntactics;SPICE;Reliability engineering;Protection;SystemC;Spice;Co-simulation;Modeling},
 month = {June},
 number = {},
 pages = {1-4},
 title = {Integration of SystemC with PSpice Simulations Models},
 volume = {},
 year = {2025}
