@inproceedings{6692153,
 abstract = {In this paper, we study the multi-pair two-way relay (TWR) system, in which not all users utilize the identical modulation scheme. Signal space alignment for network coding(SSA-NC) is used to realize efficient communication among multiuser(MU). The paired signals are aligned and decoded-and-forwarded(DF) at the relay. Considering different modulation schemes utilized, we propose a novel DF strategy design and decoding rules. Monte Carlo simulation results demonstrate the advantage of the proposed approach.},
 author = {Huang, Qing and Wang, Yingmin},
 booktitle = {2013 IEEE 78th Vehicular Technology Conference (VTC Fall)},
 doi = {10.1109/VTCFall.2013.6692153},
 issn = {1090-3038},
 keyword = {Relays;Bit error rate;MIMO;Decoding;Vectors;Phase shift keying},
 month = {Sep.},
 number = {},
 pages = {1-5},
 title = {Decode-and-Forward Design of Signal Space Alignment for Network Coding on Asymmetric MIMO Y Channels},
 volume = {},
 year = {2013}
}
