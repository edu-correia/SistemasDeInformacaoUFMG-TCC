@article{KARKALI2024203973,
 abstract = {The establishment of communication circuits requires bringing sources and targets into contact, either directly or indirectly. The Central Nervous System (CNS)'s ability to interpret the environment and generate precise responses depends on the functional efficiency of its neural network, which in turn relies on the 3D spatial organization of its constituents, mainly neurons and glia. Throughout evolution, sensory integration and motor response coordination became linked with the merging of the brain and nerve cord (NC) in the urbilaterian CNS. In most arthropods, the NC follows a specific topological plan and consists of a fixed number of neuromeres (thoracic and abdominal ganglia with commissural interconnections and a single terminal ganglion). The number, spacing, and fusion of neuromeres are species-specific and can change during embryogenesis or post-embryonic life. During Drosophila embryogenesis, the NC condenses along the Anterior-Posterior (AP) axis in a stereotypical manner, bringing neuromeres closer together. This process has revealed several key parameters, including its morphogenetic mechanics, the roles of various cellular, molecular, and structural components, and the functional purpose of its balanced design. The embryonic NC serves as a valuable model for investigating the ancient mechanisms underlying the structural organization, sensory integration, and motor coordination of the CNS. While many aspects of ganglionic fusion remain unknown, ongoing research promises to provide a more comprehensive understanding of the mechanical and evolutionary principles that govern it.},
 author = {Katerina Karkali and Enrique Martín-Blanco},
 doi = {https://doi.org/10.1016/j.cdev.2024.203973},
 issn = {2667-2901},
 journal = {Cells & Development},
 keyword = {Drosophila, Evolution, Mechanics, Morphogenesis, Nervous system},
 pages = {203973},
 title = {The evolutionary and mechanical principles shaping the Drosophila embryonic ventral nerve cord},
 url = {https://www.sciencedirect.com/science/article/pii/S2667290124000834},
 volume = {180},
 year = {2024}
}
