@conference{Zuo2023336,
 abstract = {Based on the current development trend of China's civil aviation industry, the rapid growth of flight volume causes excessive pollutant emissions. Aiming at decreasing the carbon emissions of aircraft operation, in this paper, a flight procedure namely point merge procedure is firstly introduced. Meanwhile, we improves the carbon emission calculation model under the point merge procedure. Finally, a case study of Shanghai Pudong Airport shows that the operational capacity has increased 5% in peak-hour under point merge procedure, while the total carbon emissions has reduced 309.3064g. © WCSE 2023.All rights reserved.},
 author = {Zuo, Chenyuan and Li, Xueyan and Zhao, Qinshuai and Shen, Zhiyuan},
 doi = {10.18178/wcse.2023.06.050},
 journal = {13th International Workshop on Computer Science and Engineering, WCSE 2023},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {336 - 342},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Aircraft Carbon Emission Calculation Model Using Point Merge Procedure},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85176415244?origin=resultslist},
 year = {2023}
