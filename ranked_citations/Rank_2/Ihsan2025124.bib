@conference{Ihsan2025124,
 abstract = {Automating rural basemap production remains challenging due to heterogeneous settlement forms and fragmented agricultural parcels. This study evaluates the zero-shot performance of the High-Quality Segment Anything Model (HQ-SAM) for segmenting residential buildings and paddy fields from 10 cm orthophotos across 11 rural sites in Indonesia. We compare automated outputs (with light post-processing merging) against expert manual digitization using class-specific Intersection over Union (IoU) and end-to-end time efficiency. HQ-SAM attains mean IoU of 0.886 for buildings and 0.758 for paddy fields, with coverage averaging 90.0% and 75.2%, respectively. The workflow reduces annotation time by ≈80% for buildings and ≈77% for paddy fields relative to manual digitization, demonstrating practical viability for large-area mapping. Performance varies with landscape complexity: regular roof geometries and large, well-bounded fields yield higher accuracy, whereas smallholder mosaics and complex topography reduce boundary fidelity. A lightweight merge step improves agreement by 5–9% without fine-tuning or prompting. Results suggest a hybrid operational paradigm in which HQ-SAM provides fast pre-annotation for routine updates and rapid assessments, while complex zones receive targeted quality control. © 2025 IEEE.},
 author = {Ihsan, Muhammad and Ramadhani, Anisa Nabila Rizki and Amelia, Nabila Sabrina and Rohimat, Angghi and Sugito, Nanin Trianawati},
 doi = {10.1109/ICDSG67714.2025.11381380},
 journal = {2025 1st International Conference on Data Science and Geoinformatics, ICDSG 2025},
 note = {Cited by: 0},
 pages = {124 - 128},
 publication_stage = {Final},
 source = {Scopus},
 title = {Evaluating HQ-SAM for Rural Building and Paddy Field Segmentation in Indonesia},
 type = {Conference paper},
