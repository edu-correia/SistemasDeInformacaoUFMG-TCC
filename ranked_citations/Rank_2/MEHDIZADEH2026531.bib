@incollection{MEHDIZADEH2026531,
 abstract = {Herbal medicine, despite its therapeutic promise, is hindered by phytochemical instability, poor solubility, and nonspecific biodistribution. Polymeric nanocarriers merge natural (chitosan, alginate) and synthetic (poly(lactic-co-glycolic acid (PLGA), poly[ethylene glycol]) polymers to create advanced delivery systems, overcoming these limitations. These nanostructures encapsulate fragile herbal compounds, enhance stability, and enable controlled release via stimuli-responsive or ligand-functionalized designs. Innovations like pH-sensitive carriers and receptor-targeted nanoparticles address biological barriers, improving delivery to tumors (via the enhanced permeability and retention effect for curcumin/piperine) or the brain (RVG29-conjugated quercetin for amyloid-beta plaques). However, challenges persist in scalability, natural polymer batch variability, and regulatory approval. Future progress relies on sustainable materials (e.g., lignin-based systems) and AI-optimized polymer–drug interactions. By integrating herbal wisdom with nanotechnology, these carriers transform phytochemicals into precision therapeutics with validated pharmacokinetics, elevating herbal medicine to evidence-based practice. This synergy bridges tradition and innovation, democratizing safe, effective treatments globally and reshaping healthcare through validated, targeted therapies.},
 author = {Mohammad Mehdizadeh and Anahita Omidi and Ali Mehdizadeh and Paniz Omidi and Ehsan Yarali and Sajjad Tavan},
 booktitle = {Polymer-Based Nanostructured Barrier Materials},
 doi = {https://doi.org/10.1016/B978-0-323-99531-3.00015-0},
 editor = {V. Prajitha and Sabu Thomas and Keloth Paduvilan Jibin},
 isbn = {978-0-323-99531-3},
 keyword = {Drug delivery system, pharmacological parameter, materials in biotechnology, pharmaceutical science, pharmaceutical therapy, materials chemistry, drug development, chemical compound, materials class},
 pages = {531-557},
 publisher = {Elsevier},
 series = {Micro and Nano Technologies},
 title = {Chapter 19 - Polymeric nanocarriers for herbal medicine delivery and therapeutic applications},
 url = {https://www.sciencedirect.com/science/article/pii/B9780323995313000150},
 year = {2026}
}
