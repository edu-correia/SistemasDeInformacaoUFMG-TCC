@article{WEI2026111380,
 abstract = {With the comprehensive advancement of science, technology, and productivity, structural optimization design has been widely applied in various engineering fields. Among them, topology optimization, with its efficient and innovative structural design capabilities, has been particularly extensively adopted in the fields of aerospace, civil engineering, mechanical engineering, and biomedicine. Although existing topology optimization methods have achieved notable achievements, most studies are still confined to the assumption of linear elastic small deformation and homogenized continuous structures that adopt classical constitutive models. However, practical engineering applications often involve material nonlinearity and heterogeneous multi-scale material structures, for which the constitutive models have not yet been established. Therefore, developing multiscale topology optimization schemes for nonlinear materials faces significant challenges between computational efficiency and accuracy. This study proposes a machine learning-based multiscale topology optimization computational framework, aiming to obtain interpretable constitutive model expressions for composite materials through machine learning training, and to conduct nonlinear topology optimization on this basis, thereby achieving an effective transition between materials and structures. The research framework ensures the accuracy of physical information by integrating the ICNNs and symbolic regression methods, and incorporates neural network structures with physical constraints. Experimental results demonstrate that the proposed method can effectively optimize structures with nonlinear behaviors and exhibits significant advantages compared with the traditional homogenization-based topology optimization method.},
 author = {Dahai Wei and Fanlin Zeng and Jianzheng Cui and Youshan Wang},
 doi = {https://doi.org/10.1016/j.ijmecsci.2026.111380},
 issn = {0020-7403},
 journal = {International Journal of Mechanical Sciences},
 keyword = {Machine learning, Topology optimization, Hyperelastic constitutive models, Multiscale SIMP optimization, Multiscale Topology Optimization Framework, Physics-informed machine learning methods},
 pages = {111380},
 title = {Machine learning-based multiscale topology optimization framework for nonlinear materials},
 url = {https://www.sciencedirect.com/science/article/pii/S0020740326002365},
 volume = {314},
 year = {2026}
}
