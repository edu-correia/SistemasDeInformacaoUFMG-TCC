@article{Lai2018735,
 abstract = {Texture exemplar has been widely used in example-based texture synthesis and feature analysis. Unfortunately, manually cropping texture exemplars is a burdensome and boring task. Conventional method over emphasizes the synthesis algorithm analysis and requires frequent user interactions. In this paper, we employ K-means clustering to generate patch distribution maps and calculate K-center similarity as our measurement on patch merge. Patch merging is the key to reduce over-segmentation. Even defective texture exemplars could show high global homogeneity. We detect this kind of exemplars by partitioning patch maps into non-overlapping subblocks. Comparing visual similarity between each block and the global patch map could detect the heterogeneous areas. We also introduce the Poisson disk sampling for achieving uniform exemplar cropping. Visual results show that our approach could accurately extract texture exemplars from arbitrary source images. © Springer International Publishing AG, part of Springer Nature 2018.},
 author = {Lai, Hui and Yin, Lulu and Wu, Huisi and Wen, Zhenkun},
 doi = {10.1007/978-3-319-77383-4_72},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {735 - 744},
 publication_stage = {Final},
 source = {Scopus},
 title = {A novel texture exemplars extraction approach based on patches homogeneity and defect detection},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85047445810?origin=resultslist},
 volume = {10736 LNCS},
 year = {2018}
}
