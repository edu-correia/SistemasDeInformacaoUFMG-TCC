@conference{Xiaopeng2008677,
 abstract = {Using remote sensing, virtual reality, three-dimensional GIS, database and other key technologies to merge 3D digital elevation model, satellite orthographic image and 3D stereo model of urban street, building and urban facilities. We reproduce urban architectures and block landscapes to enable user to see idyllic landscape of urban streets very intuitively on display screen. It can perform a series of operation such as roam, measure, query, aero-browse and so on, can meet a visualization demand for digital city technology to develop from two dimensional GIS to three-dimensional virtual reality and can furnish information service of three-dimensional visualization space geography for city construction planning, community service, property management, fire control safety, tour traffic and so on.},
