@inproceedings{10409605,
 abstract = {The use of machine learning technology for processing and analyzing MR brain images is of great significance in clinical brain disease diagnosis. Brain image classification based on brain atlas is a research hotspot in the field of brain image analysis. Before analyzing and processing brain MR images, using brain atlas templates to preprocess the images can effectively improve the accuracy of classification. However, most of the existing brain image analysis techniques using machine learning methods are based on single atlas information, which cannot fully extract the useful information in the image and effectively explain the potential differences between different types of images. In order to fully leverage the complementary information among multiple brain atlases, this paper introduces a multi-view data fusion approach based on multi-kernel learning. Specifically, we perform segmentation on MR images using three distinct brain atlases (AAL, AAL3, BN_Atlas). Additionally, we apply different kernel functions to process the segmented data from each atlas separately. Ultimately, we compute a combined kernel matrix to merge diverse feature spaces for learning and classification. Through comparative experiments on ADNI datasets, it was demonstrated that the method based on multi-kernel learning is more suitable for data fusion than the method based on CCA/MPCA/MLP, and that the method based on multi-atlas has better classification performance than the method based on single atlas.},
 author = {Yao, Yuang and Li, Chaojun},
 booktitle = {2023 7th International Symposium on Computer Science and Intelligent Control (ISCSIC)},
 doi = {10.1109/ISCSIC60498.2023.00045},
 issn = {},
 keyword = {Neuroimaging;Learning systems;Brain;Magnetic resonance imaging;Data integration;Medical diagnosis;Kernel;MR brain image analysis;multi-atlas;brain disease diagnosis;multi-kernel learning;data fusion},
 month = {Oct},
 number = {},
 pages = {176-182},
 title = {Multi-Kernel Learning based Disease Diagnosis with Multi-Atlas},
 volume = {},
 year = {2023}
}
