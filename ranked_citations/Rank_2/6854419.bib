@inproceedings{6854419,
 abstract = {In this work, we propose a novel framework for automatic finger detection and hand posture recognition, based mainly on depth information. Our method locates apex-shaped structures in a hand contour and deals efficiently with the challenging problem of partially merged fingers. Hand posture recognition is achieved using Fourier Descriptors of the contour, while global information about the fingers helps reducing the size of the search space. Our experiments on a dataset obtained from a Kinect device confirm the high recognition accuracy of our approach.},
 author = {Poularakis, Stergios and Katsavounidis, Ioannis},
 booktitle = {2014 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP.2014.6854419},
 issn = {2379-190X},
 keyword = {Shape;Thumb;Accuracy;Three-dimensional displays;Computer vision;Conferences;hand detection;finger detection;depth camera},
 month = {May},
 number = {},
 pages = {4329-4333},
 title = {Finger detection and hand posture recognition based on depth information},
 volume = {},
 year = {2014}
}
