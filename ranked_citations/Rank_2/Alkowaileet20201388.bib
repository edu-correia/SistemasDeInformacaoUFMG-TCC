@article{Alkowaileet20201388,
 abstract = {Document database systems store self-describing semistructured records, such as JSON, "as-is" without requiring the users to pre-define a schema. This provides users with the flexibility to change the structure of incoming records without worrying about taking the system offline or hindering the performance of currently running queries. However, the flexibility of such systems does not free. The large amount of redundancy in the records can introduce an unnecessary storage overhead and impact query performance. Our focus in this paper is to address the storage overhead issue by introducing a tuple compactor framework that infers and extracts the schema from self-describing semistructured records during the data ingestion. As many prominent document stores, such as MongoDB and Couchbase, adopt Log Structured Merge (LSM) trees in their storage engines, our framework exploits LSM lifecycle events to piggyback the schema inference and extraction operations. We have implemented and empirically evaluated our approach to measure its impact on storage, data ingestion, and query performance in the context of Apache AsterixDB. © 2020, VLDB Endowment.},
 author = {Alkowaileet, Wail Y. and Alsubaiee, Sattam and Carey, Michael J.},
 doi = {10.14778/3397230.3397236},
 journal = {Proceedings of the VLDB Endowment},
 note = {Cited by: 14},
 number = {9},
 pages = {1388 - 1400},
 publication_stage = {Final},
 source = {Scopus},
 title = {An LSM-based tuple compaction framework for apache AsterixDB},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85091025188?origin=resultslist},
 volume = {13},
 year = {2020}
}
