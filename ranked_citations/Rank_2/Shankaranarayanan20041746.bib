@conference{Shankaranarayanan20041746,
 abstract = {The concept of pervasive computing has become a reality. Sensors and sensory networks are becoming a vital part of organizational infrastructures as they allow integration of real-time data. The sensors have the potential to provide vastly distributed real-time data. But they also have certain limiting characteristics that can impact the quality of data collected over a sensory network. The first objective of this paper is to identify the implications for data quality of sensors and sensory networks. The second objective of this paper is to describe a method for managing data quality in sensory networks using the information product approach. Finally, to help organizations effectively deploy sensory networks, we present a conceptual framework to better understand the advantages and drawbacks of sensory networks. © 2004, Association for Information Systems. All rights reserved.},
 author = {Shankaranarayanan, G. and Gaynor, Mark},
 journal = {10th Americas Conference on Information Systems, AMCIS 2004},
 note = {Cited by: 0},
 pages = {1746 - 1754},
 publication_stage = {Final},
 source = {Scopus},
 title = {Sensor Data and Managing Data Quality in Sensory Network Applications},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85139021969?origin=resultslist},
 year = {2004}
}
