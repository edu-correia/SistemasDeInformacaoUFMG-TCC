@conference{Polat2025,
 abstract = {Synthetic scene simulation plays a critical role in the design and testing processes of Electro-Optical (EO) systems by significantly reducing the need for extensive field trials. These simulations enable the controlled variation of scene components, including background, atmosphere, objects, and system-level elements of the imaging chain. Various methodologies exist in the literature for simulating radiometric scenes, each incorporating different aspects of the EO image formation process. One prominent approach involves physically-based or radiometric scene generation, which models the entire imaging chain from object space to detector output. Alternatively, when real data is available, hybrid approaches—such as composite scene generation—can be employed to merge synthetic and real elements effectively. This paper provides a general discussion of these synthetic scene generation techniques and illustrates their application in an AI-based object detection framework. © 2025 SPIE. All rights reserved.},
 author = {Polat, Özgür Murat and Yamanlar, Berk Cem and Türkmen, Mehmet Can},
 doi = {10.1117/12.3076657},
 journal = {Proceedings of SPIE - The International Society for Optical Engineering},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {A general discussion on synthetic scene generation methodologies for EO simulation from an AI perspective},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105023104958?origin=resultslist},
 volume = {13594},
 year = {2025}
}
