@inproceedings{11388782,
 abstract = {Motivated by the thrust need and significance of Fault tolerant, redundant, modular, compact and efficient topologies of multilevel inverter (MLI), this paper introduces synthesis of a novel stacked HSC-L configuration to enhance the performance of Reduced Switch Count Multilevel Inverters (RSC-MLI). The proposed topology merges the concept Hexagonal Switched Cell (HSC) and Level Doubling Network (LDN), to achieve elevated voltage levels using fewer switches, while improving harmonic performance and fault tolerance. Utilizing the redundancies of the HSC and, level-doubling features of LDN, the developed HSC-L performs efficiently under both symmetrical and asymmetrical DC voltage conditions, for both healthy and open circuit (OC) switch fault conditions. A Hybrid Pulse Width Modulation (PWM) technique, combining simplified reduced carrier-based and switching function PWM, is developed to optimize switching logic to support fault tolerant operation. Simulation of the output voltage and current affirm the superiority of the HSC-LDN synthesis over traditional MLI and RSC-MLI configurations. Furthermore, the compact, modular design and its ability to double voltage levels without increasing device stress highlight its potential for applications in photovoltaic systems and electric vehicle charging.},
 author = {Kumar, K. Sheshu and Prasad, N. Bhanu and Vemuganti, Hari Priya},
 booktitle = {2025 IEEE 3rd International Symposium on Sustainable Energy, Signal Processing and Cybersecurity},
 doi = {10.1109/iSSSC66652.2025.11388782},
 issn = {},
 keyword = {Photovoltaic systems;Performance evaluation;Network topology;Fault tolerant systems;Switches;Voltage;Computer architecture;Pulse width modulation;Multilevel inverters;Topology;Hexagonal switched Cell (HSC);LDN (Level Doubling Network);Reduced Carrier (RC);Total Harmonic Distortion (THD);Reduced switch count (RSC);Switch function PWM;Multilevel Inverters (MLI)},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Synthesis of Stacked HSC-L RSC Topology for Enhanced Multilevel Inverter Performance},
