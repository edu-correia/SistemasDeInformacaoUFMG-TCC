@inproceedings{10873761,
 abstract = {Graph Neural Networks (GNNs) have emerged as powerful tools across diverse applications, including social networks, bioinformatics, and recommendation systems. However, their susceptibility to adversarial attacks, particularly targeted attacks, poses a significant challenge. Targeted attacks exploit the message-passing mechanism of GNNs to induce severe performance degradation, even with minimal perturbations. Inspired by the self-repair and adaptive behaviors of spider webs, this paper introduces SpiderWeb Protector, a biomimetic defense strategy designed to enhance GNN robustness. The proposed method integrates three core components: Community-Centric Graph Update, which selectively reinforces key graph structures; Topology Feature Merging, which improves feature representation by incorporating structural insights; and Edge Pruning, which dynamically removes adversarial connections. Comprehensive experiments on three datasets (Cora, Citeseer and Cora_ml) and two GNN models (GCN and GIN) demonstrate the superior performance of SpiderWeb Protector against both direct and influence-targeted attacks, achieving state-of-the-art results.},
 author = {Zhou, Zeyu and Huang, Yuanyuan and Wang, Yongli and Li, Siyu and Lu, Jiazhong and He, Peilin},
 booktitle = {2024 21st International Computer Conference on Wavelet Active Media Technology and Information Processing (ICCWAMTIP)},
 doi = {10.1109/ICCWAMTIP64812.2024.10873761},
 issn = {2576-8964},
 keyword = {Technological innovation;Social networking (online);Biomimetics;Merging;Refining;Graph neural networks;Robustness;Topology;Recommender systems;Resilience;Graph neural networks;Targeted Attack;Defense strategies},
 month = {Dec},
 number = {},
 pages = {1-4},
 title = {Spiderweb Protector: Biomimetic Defense Against Targeted Attacks on Graph Neural Networks},
 volume = {},
 year = {2024}
