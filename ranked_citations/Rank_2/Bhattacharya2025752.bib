 abstract = {Blockchain is a shared, immutable distributed ledger technology that enabled peer to peer transactions without any intermediary such as banks, through cryptography. It is a disruptive technology that has led to the concept of decentralized applications. Since its inception, there has emerged a plethora of diverse blockchains and decentralized applications, some of which are interoperable, some are not. However, many a times, we need to merge the jobs of two different blockchains for complex decentralized systems; this we accomplish through various means such as sidechains or interoperable blockchains. That entails asset or coin transfer between multiple blockchains following certain rules as fixed by the developers/designers. However, when we consider a set of homogeneous consortium blockchains each serving a different use case for a composite and complex decentralized system, we ascertain that there is a simpler alternative - ColouredChain which we propose in this paper. The ColouredChain is a single blockchain that is built upon the notion of nested chains; each nested chain is of a different color and corresponds to a different use case pertaining to a different consortium blockchain. In this paper, we delineate the design and architecture of the ColouredChain and explore its possible use cases. © 2025 IEEE.},
 author = {Bhattacharya, Rituparna and Pal, Prashnatita and Aman, Md. Abdul Aziz Al and Bhadra, Sompurna},
 doi = {10.1109/BCCA66705.2025.11229752},
 journal = {2025 7th International Conference on Blockchain Computing and Applications, BCCA 2025},
 note = {Cited by: 0},
 pages = {752 - 764},
 publication_stage = {Final},
 source = {Scopus},
 title = {ColouredChain - Exploring Alternatives to a Network of Homogeneous Consortium Blockchains for Complex and Composite Decentralized Systems},
 type = {Conference paper},
