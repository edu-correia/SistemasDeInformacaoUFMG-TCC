@incollection{ZHENG202439,
 abstract = {According to Marr, from the perspective of information processing system, the research of visual computing should be divided into three levels, the level of computational theory, the level of representation and algorithm, and the level of hardware implementation. With the gradual integration of software and hardware, the latter two have gradually merged into one. For example, when researchers adopt the current mainstream PyTorch or TensorFlow framework, then they often do not need to consider the hardware implementation of the graphics processing unit (GPU) and other computing devices and only need to focus on the hardware implementation of GPUs or other devices and on the specific algorithms and representations under a specific vision task. According to the theory of computational vision, Marr believes that the research on the theory of visual computing should answer three questions: (1) What is the goal of the computation? (2) Why is it appropriate? (3) What is the logic of the strategy by which it can be carried out? This chapter follows the three questions addressed by Marr and answers them in turn for the novel framework of Computational Knowledge Vision.},
 author = {Wenbo Zheng and Fei-Yue Wang},
 booktitle = {Computational Knowledge Vision},
 doi = {https://doi.org/10.1016/B978-0-44-321619-0.00009-1},
 editor = {Wenbo Zheng and Fei-Yue Wang},
 isbn = {978-0-443-21619-0},
 keyword = {Computational Knowledge Vision, Visual computing, Goal, Appropriateness, Logic},
 pages = {39-56},
 publisher = {Academic Press},
 title = {Chapter Three - Computational Knowledge Vision},
 url = {https://www.sciencedirect.com/science/article/pii/B9780443216190000091},
 year = {2024}
}
