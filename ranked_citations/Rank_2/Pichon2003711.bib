@conference{Pichon2003711,
 abstract = {In this paper we present a new algorithm for 3D medical image segmentation. The algorithm is fast, relatively simple to implement, and semi-automatic. It is based on minimizing a global energy defined from a learned non-parametric estimation of the statistics of the region to be segmented. Implementation details are discussed and source code is freely available as part of the 3D Slicer project. In addition, a new unified set of validation metrics is proposed. Results on artificial and real MRI images show that the algorithm performs well on large brain structures both in terms of accuracy and robustness to noise.},
 author = {Pichon, Eric and Tannenbaum, Allen and Kikinis, Ron},
 doi = {10.1007/978-3-540-39903-2_87},
 journal = {Lecture Notes in Computer Science},
 note = {Cited by: 5},
 number = {PART 2},
 pages = {711 - 720},
 publication_stage = {Final},
 source = {Scopus},
 title = {A statistically based surface evolution method for medical image segmentation: Presentation and validation},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/0344823916?origin=resultslist},
 volume = {2879},
 year = {2003}
}
