@article{Berman2002845,
 abstract = {In this paper we present new results on the approximate parallel construction of Huffman codes. Our algorithm achieves linear work and logarithmic time, provided that the initial set of elements is sorted. This is the first parallel algorithm for that problem with the optimal time and work. Combining our approach with the best known parallel sorting algorithms we can construct an almost optimal Huffman tree with optimal time and work. This also leads to the first parallel algorithm that constructs exact Huffman codes with maximum codeword length H in time O(H) and with n processors. This represents a useful improvement since most practical situations satisfy H = O(log n). © 2002 Springer-Verlag Berlin Heidelberg.},
 author = {Berman, Piotr and Karpinski, Marek and Nekrich, Yakov},
 doi = {10.1007/3-540-45465-9_72},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3},
 pages = {845 - 855},
 publication_stage = {Final},
 source = {Scopus},
 title = {Approximating Huffman codes in parallel},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84869177304?origin=resultslist},
 volume = {2380 LNCS},
 year = {2002}
}
