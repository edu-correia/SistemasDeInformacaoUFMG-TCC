@article{10.1145/3394977,
 abstract = {Memory analysis tools are essential for finding and fixing anomalies in the memory usage of software systems (e.g., memory leaks). Although numerous tools are available, hardly any empirical studies exist on their usefulness for developers in typical usage scenarios. Instead, most evaluations are limited to reporting performance metrics. We thus conducted a study to empirically assess the usefulness of the interactive memory analysis tool AntTracks Analyzer. Specifically, we first report findings from assessing the tool using a cognitive walkthrough, guided by the Cognitive Dimensions of Notations Framework. We then present the results of a qualitative user study involving 14 subjects who used AntTracks to detect and resolve memory anomalies. We report lessons learned from the study and implications for developers of interactive memory analysis tools. We hope that our results will help researchers and developers of memory analysis tools in defining, selecting, and improving tool capabilities.},
 address = {New York, NY, USA},
 articleno = {75},
 author = {Weninger, Markus and Gr\"{u}nbacher, Paul and Gander, Elias and Sch\"{o}rgenhumer, Andreas},
 doi = {10.1145/3394977},
 issue_date = {June 2020},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keyword = {assessment, cognitive dimensions, cognitive walkthrough, interactive memory analysis tools, usability, usefulness, user study, utility},
 month = {June},
 number = {EICS},
 numpages = {37},
 publisher = {Association for Computing Machinery},
 title = {Evaluating an Interactive Memory Analysis Tool: Findings from a Cognitive Walkthrough and a User Study},
 url = {https://doi.org/10.1145/3394977},
 volume = {4},
 year = {2020}
}
