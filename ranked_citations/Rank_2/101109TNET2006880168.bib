@article{10.1109/TNET.2006.880168,
 abstract = {Internet quality of service (QoS) is still a highly debated topic for more than fifteen years. Even with the large variety of QoS proposals and the impressive research advances, there is little deployment yet of network layer QoS technology. One specific problem domain is QoS signalling, which has recently attracted increasing attention to bring forward new standardization approaches. In this paper, an extensive study of RSVP is presented, covering protocol design, software design, and performance aspects of the basic version of RSVP and of certain standardized and experimental extensions. This work is based on and presents the experience from implementing RSVP for UNIX systems and the ns-2 simulation environment. The implementation includes a variety of protocol extensions and incorporates several internal improvements. It has been subject to extensive functional and performance evaluations, the results of which are reported here.},
 author = {Karsten, Martin},
 doi = {10.1109/tnet.2006.880168},
 issn = {1063-6692},
 issue_date = {August 2006},
 journal = {IEEE/ACM Trans. Netw.},
 keyword = {signalling, quality of service, protocol implementation},
 month = {August},
 number = {4},
 numpages = {12},
 pages = {767–778},
 publisher = {IEEE Press},
 title = {Collected experience from implementing RSVP},
 url = {https://doi.org/10.1109/TNET.2006.880168},
 volume = {14},
 year = {2006}
}
