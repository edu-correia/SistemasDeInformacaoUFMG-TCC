@inproceedings{6865054,
 abstract = {This paper presents a novel inter-view motion prediction technique used in 3D-HEVC which provides efficient compression for motion vectors. The 3D extension of HEVC (High Efficiency Video Coding) namely 3D-HEVC is under development in JCT-3V for coding multi-view video and depth data. Inter-view motion prediction takes benefit of the inter-view correlation between views by inferring the motion information of a view from the already coded motion information in another view as well as the local disparity between two views. Experimental results show that inter-view motion prediction in 3D-HEVC provides an average bit-rate savings of 15% for the dependent views.},
 author = {Zhang, Li and Chen, Ying and Thirumalai, Vijayaraghavan and Lin, Jian-Liang and Chen, Yi-Wen and An, Jicheng and Lei, Shawmin and Guillo, Laurent and Guionnet, Thomas and Guillemot, Christine},
 booktitle = {2014 IEEE International Symposium on Circuits and Systems (ISCAS)},
 doi = {10.1109/ISCAS.2014.6865054},
 issn = {2158-1525},
 keyword = {Vectors;Three-dimensional displays;Encoding;Video coding;Joints;Collaboration;Bit rate;HEVC;3D-HEVC;inter-view motion prediction;merge candidate;disparity vector},
 month = {June},
 number = {},
 pages = {17-20},
 title = {Inter-view motion prediction in 3D-HEVC},
 volume = {},
 year = {2014}
}
