@article{WANG2025104342,
 abstract = {Visual place recognition (VPR) aims to identify the location of a query image by matching its global representation against those of geo-tagged images from a database. Existing VPR methods relying on pooling-based aggregation employ fixed pooling grids to aggregate local features into global representations, usually leading to the inappropriate combination of irrelevant features due to complex object geometries and scene structures. In this paper, we propose a novel method, termed Adaptive Deformable Token Aggregation for Visual Place Recognition (ADTA-VPR), to adaptively capture critical object information across varying shapes and scales, yielding discriminative image representations. To this end, a Deformable Token Merging (DTM) technique is first designed to merge semantic-relevant tokens within the same object region. Specifically, DTM learns merging offsets informed by both global scene context and local object details to adjust merging grids. This mechanism allows the merging regions to flexibly adapt to object shapes during feature abstraction. Based on the adaptively merged features, we further introduce a Prototype-guided Token Aggregation (PTA) module, which filters out repetitive elements and enhances distinctive spatial cues. Consequently, the adaptive design of ADTA-VPR ensures producing compact and discriminative image representations. Moreover, we introduce a new benchmark, the Foshan City Building Recognition (FCBR) dataset, which is the first to specifically focus on challenging real-world photographic conditions, i.e., camera shake, overexposure, and underexposure. FCBR dataset provides a rigorous evaluation of VPR models under practical deployment scenarios. Extensive experiments conducted on several challenging public benchmarks and the proposed FCBR dataset prove that ADTA-VPR effectively achieves robust and precise place recognition.},
 author = {Chaoqun Wang and Yun Li and Shaobo Min and Xuejin Chen},
 doi = {https://doi.org/10.1016/j.cag.2025.104342},
 issn = {0097-8493},
 journal = {Computers & Graphics},
 keyword = {Visual place recognition, Feature aggregation, Token merging},
 pages = {104342},
 title = {Robust visual place recognition with adaptive deformable token aggregation},
 url = {https://www.sciencedirect.com/science/article/pii/S0097849325001839},
 volume = {131},
 year = {2025}
}
