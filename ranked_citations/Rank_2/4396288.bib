@inproceedings{4396288,
 abstract = {In this paper, CRLH TL based antennas and microstrip patches concepts are merged to design multi-frequency antennas. The proposed antenna works at four different frequencies with non-whole ratio between them. This is possible by using CRLH and RH TLs in the same structure. Furthermore, the gain is higher than 5.7 dB and the radiation pattern is similar to the fundamental one of a conventional patch antenna at the four working frequencies.},
 author = {Herraiz-Martinez, Francisco Javier and Gonzalez-Posadas, Vicente and Segovia-Vargas, Daniel},
 booktitle = {2007 IEEE Antennas and Propagation Society International Symposium},
 doi = {10.1109/APS.2007.4396288},
 issn = {1947-1491},
 keyword = {Microstrip antennas;Patch antennas;Metamaterials;Equivalent circuits;Capacitors;Resonant frequency;Antenna radiation patterns;Inductors;Shunt (electrical);Transmission line theory},
 month = {June},
 number = {},
 pages = {3484-3487},
 title = {Multi-frequency microstrip patch antennas based on metamaterial structures},
 volume = {},
 year = {2007}
}
