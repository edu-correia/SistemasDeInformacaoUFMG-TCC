 abstract = {The explosive growth of artificial intelligence (AI) has impacted the newsrooms arena via rendering it attainable to crank out contents on a broad spectrum that occasionally exceeds remarks composed manually on the basis of cohesiveness and elegance. No matter their prospects for attainment and convenience, these breakthroughs spell major issues regarding the audience’s solidity, decency, and devotion. The research presented here separates nuances of synthetically intelligent and human-composed content, illustrating how detection mechanisms—both analytical and subjective prejudicial influence—consumers’ attitudes toward legitimacy. By tracking spectator impressions, topical features, and assessment robustness, the empirical investigation demonstrates that however AI systems might deliver remarkably exact outcomes, patrons are prone to embrace human-generated narrative due to its implied realness and deep heritage. The exploration additionally points to the demand for multifaceted detection mechanisms that merge human assessments with Artificial Intelligence-based strategies for classification in an endeavor to hedge against erroneous assertions and boost civility. The primary objective of this research is to utilize Natural Language Processing (NLP) and Machine Learning (ML) techniques to experimentally differentiate among news articles created by AI versus those generated by humans. Additionally, it examines the relationship among audience perceptions of news authenticity and language usage and visual aspects found by algorithmic detection. This study extends our knowledge of how AI-mediated news influences the legitimacy of information by combining detection performance with intellectual aspects related to trust.},
 author = {Panda, Sneha and Panwar, Ruby},
