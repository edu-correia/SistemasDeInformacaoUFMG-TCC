@article{ZHOU2025113804,
 abstract = {There are two primary methods for generating neutron-photon multi-group cross-section libraries: the deterministic method and the Monte Carlo method. However, the nuclear data processing code NJOY has certain limitations in handling photon cross-sections. First, it does not account for electron transport as the Monte Carlo code does. Second, the secondary photon production process is not considered. In the Monte Carlo code IMPC-NP, the method for generating neutron-photon multi-group cross-section libraries is improved. The code includes the photon production cross-sections resulting from neutron reactions and considers photon sources generated by atomic relaxation, bremsstrahlung, and positron–electron annihilation. This paper includes two primary studies. The first study involves generating neutron-photon multi-group cross-section libraries for two fast reactor using the Monte Carlo code IMPC-NP and the nuclear data processing code NJOY, respectively. These cross-section libraries are then provided to deterministic code DORT, and a comparative accuracy analysis of the libraries is performed. The second study uses IMPC-NP to generate a general-purpose cross-section library suitable for the OECD/NEA fast reactor benchmark. Sensitivity analyses of core physics parameters are conducted by varying control rod insertion depth, material density, and core geometry. The results show that the neutron-photon cross-section library generated by the improved IMPC-NP code achieves higher accuracy compared to NJOY, yielding more precise neutron and photon flux distributions. This makes it highly suitable for reactor shielding design. Additionally, the sensitivity analysis indicates that for the OECD/NEA fast reactor, only one neutron-photon cross-section library generated by IMPC-NP is needed to obtain highly accurate core physics parameter results, even when varying the control rod insertion depth, material density, and core geometry. This greatly facilitates reactor physics design.},
 author = {Feng Zhou and Teng Zhang and Peng Fang and Yongwei Yang and Xiang Wu and Yanling Zhu and Qiuying Liang and Shijie Du and Xubo Ma and Lei Yang},
 doi = {https://doi.org/10.1016/j.nucengdes.2024.113804},
 issn = {0029-5493},
 journal = {Nuclear Engineering and Design},
 keyword = {IMPC-NP, Neutron-photon multi-group cross section, Scattering merging, NJOY, DORT, ZPR-6/7 benchmark problem, OECD/NEA benchmark problem},
 pages = {113804},
 title = {Verification of the Neutron-Photon multi-group Cross-Section library generated by Monte Carlo method code IMPC-NP},
 url = {https://www.sciencedirect.com/science/article/pii/S002954932400904X},
 volume = {432},
 year = {2025}
}
