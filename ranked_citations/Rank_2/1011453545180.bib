@article{10.1145/3545180,
 abstract = {Bigraphs are a universal computational modelling formalism for the spatial and temporal evolution of a system in which entities can be added and removed. We extend bigraphs to probabilistic bigraphs, and then again to action bigraphs, which include non-determinism and rewards. The extensions are implemented in the BigraphER toolkit and illustrated through examples of virus spread in computer networks and data harvesting in wireless sensor systems. BigraphER also supports the existing stochastic bigraphs extension of Krivine et&nbsp;al. and using BigraphER we give, for the first time, a direct implementation of the membrane budding model used to motivate stochastic bigraphs.},
 address = {New York, NY, USA},
 articleno = {10},
 author = {Archibald, Blair and Calder, Muffy and Sevegnani, Michele},
 doi = {10.1145/3545180},
 issn = {0934-5043},
 issue_date = {June 2022},
 journal = {Form. Asp. Comput.},
 keyword = {Bigraphs, systems modelling, probabilistic modelling, graph rewriting},
 month = {September},
 number = {2},
 numpages = {27},
 publisher = {Association for Computing Machinery},
 title = {Probabilistic Bigraphs},
 url = {https://doi.org/10.1145/3545180},
 volume = {34},
 year = {2022}
}
