@conference{Crimp2017,
 abstract = {Query expansion is used to overcome the vocabulary mismatch between the documents and queries, but it can lead to query drift. We propose an automatic term reweighting strategy for BM25 ranking functions. Using expansion terms obtained from general purpose thesauri, we found that reweighting through term frequency merging is more effective than standard query expansion. Instead of appending the new terms directly to the original query, we merge the term frequencies with the original query term. ?is reduces the impact of spurious expansion terms being over represented in the modified query. © 2017 ACM.},
 author = {Crimp, Reuben and Trotman, Andrew},
 doi = {10.1145/3166072.3166074},
 journal = {ACM International Conference Proceeding Series},
 note = {Cited by: 2},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Automatic term reweighting for query expansion},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85044360715?origin=resultslist},
 volume = {2017-December},
 year = {2017}
}
