@inproceedings{11341580,
 abstract = {Sentiment Analysis (SA) is a main sub field of Natural Language Processing (NLP). In which, the text can be classified as positive, Negative or neutral. The digital message can be in any form, that can be identified by human, but here the critical task is the machine, that should understand in a way like human. In this article, mainly focus the Negation finding in the sentence and also Negation plays a vital role in the SA. Negation can change the meaning of the sentence like positive as negative and negative as positive, in such a case it will affect the entire domain. Here, finds the Negation in a review given by patient, identify the sentiment then assigns the polarity to the sentence. There are number of existing negation handling techniques are discussed for various kinds of reviews using ML techniques and proven SVM is the better choice for SA, those are general purpose. But here, unlike general approach focusing Negation detection in the healthcare field of Doctor Reviews Dataset. The main goal is improving the reliability in the sensitive field. In this paper, the proposed techniques are SVM (Support Vector Machine) which is a machine Learning Technique, train the model to learn negation, that is compare with the RNN (Recurrent Neural Network) Which is Deep Learning Technique, automatically learn the feature of negation from trained input. These two algorithms merged with Rule-Base method “VADER” for finding the sentiment label in the context and assign the polarity. The dataset is doctor's review given by the public. The Dataset having one review column of 997 entries. The Dataset is devised for training and testing working models for finding negation and Producing Accuracy in the prediction. In the existing SVM alone and some Machine Learning technique's given less accuracy compare to SVM+VADER., for this VADER combined with TFIDF Vectorization technique. Herein VADER with SVM gives the good result of 95% accuracy compare to the RNN, which gives 78%.},
 author = {U, Sarala Devi and M, Sivasakthi},
 booktitle = {2025 International Conference on Communication, Computer, and Information Technology (IC3IT)},
 doi = {10.1109/IC3IT66137.2025.11341580},
 issn = {},
 keyword = {Support vector machines;Deep learning;Sentiment analysis;Recurrent neural networks;Accuracy;Reviews;Medical services;Space vector modulation;Emojis;Testing;Sentiment Analysis (SA);Natural Language Processing (NLP);VADER (Valence Aware Dictionary for Sentiment Reasoning);Machine Learning (ML);Deep Learning (DL);Support Vector Machine (SVM);Recurrent Neural Network (RNN)},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Evaluating Negation Detection in Sentiment Analysis of Doctor Reviews Using NLP},
 volume = {},
