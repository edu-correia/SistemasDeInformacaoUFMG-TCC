@conference{Battista2016542,
 abstract = {Android malware is increasing more and more in complexity. Current signature based antimalware mechanisms are not able to detect zero-day attacks, also trivial code transformations may evade detection. Malware writers usually add functionality to existing malware or merge different pieces of malware code: this is the reason why Android malware is grouped into families, i.e., every family has in common the malicious behavior. In this paper we present a model checking based approach in detecting Android malware families by means of analysing and verifying the Java Bytecode that is produced when the source code is compiled. A preliminary investigation has been also conducted to assess the validity of the proposed approach. Copyright © 2016 by SCITEPRESS - Science and Technology Publications, Lda. All rights reserved.},
 author = {Battista, Pasquale and Mercaldo, Francesco and Nardone, Vittoria and Santone, Antonella and Visaggio, Corrado Aaron},
 doi = {10.5220/0005809205420547},
 journal = {ICISSP 2016 - Proceedings of the 2nd International Conference on Information Systems Security and Privacy},
 note = {Cited by: 50; All Open Access; Gold Open Access},
 pages = {542 - 547},
 publication_stage = {Final},
 source = {Scopus},
 title = {Identification of android malware families with model checking},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84968813476?origin=resultslist},
 year = {2016}
}
