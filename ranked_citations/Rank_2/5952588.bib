@inproceedings{5952588,
 abstract = {In this paper, we present swarm based Resource Minimization Scheme (RMS) for Network-Coding-based Multicast System (NCMS). The main objective of the RMS is to reduce network coding links while maintaining the desired rate of a multicast system. The resource minimization problem in NCMS is NP-Hard. In this paper, we apply the Binary Particle Swarm Optimization (BPSO) algorithm to the resource minimization problem in NCMS. The numerical results show the effectiveness of the proposed BPSO based RMS in comparison to the previously proposed algorithms.},
 author = {Hejazi, Seyed Amin and Naeem, M. and Lee, D. C.},
 booktitle = {2011 IEEE Symposium on Swarm Intelligence},
 doi = {10.1109/SIS.2011.5952588},
 issn = {},
 keyword = {Encoding;Network coding;Optimization;Throughput;Minimization;Merging;Particle swarm optimization;Binary Particle Swarm Optimization (BPSO);Network Coding;Max-Flow},
 month = {April},
 number = {},
 pages = {1-8},
 title = {Swarm based resource minimization in network coded system?},
 volume = {},
 year = {2011}
}
