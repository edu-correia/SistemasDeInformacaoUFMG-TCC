@inproceedings{6177098,
 abstract = {High-speed and low-power routers form the basic building blocks of on-die interconnect fabrics that are critical to overall throughput and energy efficiency of high performance systems. Conventional routers use distinct logic blocks for routing data and handling arbitration. At higher radices, connections between these blocks become a bottleneck, limiting router scalability and degrading performance. Recently, two switch topologies merged the data routing fabric with arbitration control, avoiding this bottleneck. However, relies on centralized control for channel allocation, limiting performance, while restricted to a small set of fixed priorities, rendering input ports prone to starvation. In addition, ever larger CMPs will require continued increases in bandwidth over previous designs. To address these issues, we present a 64x64 single-stage swizzle-switch network (SSN) with 128b data buses (8192 total input/output wires). The SSN can connect any input to any output, including multicast. It has a peak measured throughput of 4.5Tb/s at 1.1V in 45nm SOI CMOS at 25°C. The SSN's key features are: 1) a single-cycle least-recently granted (LRG) priority arbitration technique that reuses the already present input and output data buses and their drivers and sense amps; 2) an additional 4-level message-based priority arbitration for quality of service (QoS) with 2% logic and 3% wiring overhead; 3) a bidirectional bitline repeater that allows the router to scale to >;8000 wires. These features result in a compact fabric (4.06mm2) with throughput gain of 2.1 x over at 3.4Tb/s/W efficiency, which improves to 7.4Tb/s/W at 600mV.},
 author = {Satpathy, Sudhir and Sewell, Korey and Manville, Thomas and Chen, Yen-Po and Dreslinski, Ronald and Sylvester, Dennis and Mudge, Trevor and Blaauw, David},
 booktitle = {2012 IEEE International Solid-State Circuits Conference},
 doi = {10.1109/ISSCC.2012.6177098},
 issn = {2376-8606},
 keyword = {Fabrics;Quality of service;Routing;Switches;Repeaters;Delay;Very large scale integration},
 month = {Feb},
 number = {},
 pages = {478-480},
 title = {A 4.5Tb/s 3.4Tb/s/W 64×64 switch fabric with self-updating least-recently-granted priority and quality-of-service arbitration in 45nm CMOS},
 volume = {},
 year = {2012}
}
