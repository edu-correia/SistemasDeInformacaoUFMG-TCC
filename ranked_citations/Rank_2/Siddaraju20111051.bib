@conference{Siddaraju20111051,
 abstract = {Television broadcasting applications such as ATSC-M/H, DVB [4] require that the encoded audio and video streams to be transmitted across a network in a single transport stream containing fixed sized data packets that can be easily recognized and decoded at the receiver. MPEG2 part1 specifies two layers of packetization to achieve a transport stream suitable for digital transmission. This paper presents a scheme to multiplex the elementary streams of H.264 video and HE AAC v2 audio using the MPEG2 systems specifications [2], then de-multiplex the transport stream and playback the decoded elementary streams with lip synchronization or audio-video synchronization. © 2011 IEEE.},
 author = {Siddaraju, Naveen and Rao, K.R.},
 doi = {10.1109/ECTICON.2011.5948024},
 journal = {ECTI-CON 2011 - 8th Electrical Engineering/ Electronics, Computer, Telecommunications and Information Technology (ECTI) Association of Thailand - Conference 2011},
 note = {Cited by: 2},
 pages = {1051 - 1054},
 publication_stage = {Final},
 source = {Scopus},
 title = {Multiplexing the elementary streams of H.264 video and MPEG4 HE AAC v2 audio, de-multiplexing and achieving lip synchronization},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/79961236472?origin=resultslist},
 year = {2011}
}
