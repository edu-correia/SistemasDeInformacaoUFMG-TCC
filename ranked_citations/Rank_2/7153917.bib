@inproceedings{7153917,
 abstract = {In this paper, we propose a new approach which utilizes coherent motion regions to extract and visualize recurrent motion flows in crowded scene surveillance videos. The proposed approach first extract coherent motion regions from a crowded scene video. Then a frame-level clustering process is proposed to cluster frames into different recurrent-motion-pattern (RMP) groups according to the coherent-region similarity between frames. By merging similar coherent regions from the same RMP group, we can achieve motion flow regions representing the major motion flows in each recurrent motion pattern. Finally, a flow curve extraction process is also proposed which extracts flow curves from motion flow regions to provide a proper visualization of the recurrent motion patterns. Experimental results demonstrate that our approach can precisely achieve recurrent motion flows for various crowded scene videos.},
 author = {Mi, Yang and Liu, Lihang and Lin, Weiyao and Wang, Weiyue},
 booktitle = {2015 IEEE International Conference on Multimedia Big Data},
 doi = {10.1109/BigMM.2015.20},
 issn = {},
 keyword = {Semantics;Videos;Merging;Trajectory;Motion segmentation;High definition video;Feature extraction;Coherent motion;Traffic flow extraction;Crowded scene},
 month = {April},
 number = {},
 pages = {371-376},
 title = {Extracting Recurrent Motion Flows from Crowded Scene Videos: A Coherent Motion-Based Approach},
 volume = {},
 year = {2015}
}
