@inproceedings{10334738,
 abstract = {This paper introduces a novel compact linearly polarized (LP) wideband hybrid resonator antenna (HRA) using substrate integrated waveguide (SIW) technique based on a semi-elliptical resonator and patch radiator. The cavity is tuned at its fundamental resonant frequency, which excites the patch radiator, so the resonant frequencies of the two resonators are merged to support broadband operation. The proposed HRA is numerically investigated by HFSS software, and the simulated outcomes, including $S$11, impedance bandwidth, co-, and cross-polarized patterns, Half Power Beamwidth (HPBW), and variation of gain versus frequency, are reported. The simulated results show that the proposed hybrid resonator antenna offers a fractional impedance bandwidth (FBW) of 10.9% with a minimum gain of 6.55 dB.},
 author = {Hosseinitalab, B. and Neshati, Mohammad H.},
 booktitle = {2023 31st International Conference on Electrical Engineering (ICEE)},
 doi = {10.1109/ICEE59167.2023.10334738},
 issn = {2642-9527},
 keyword = {Merging;Resonant frequency;Electromagnetic waveguides;Aperture antennas;Software;Broadband antennas;Impedance;Substrate Integrated Waveguide (SIW);Elliptical Cavity;Hybrid Resonator Antenna},
 month = {May},
 number = {},
 pages = {190-194},
 title = {Development of a Compact Linearly Polarized Wideband Hybrid Antenna Using Semi-Elliptical SIW Resonator and Patch Radiator},
 volume = {},
 year = {2023}
}
