@article{4407669,
 abstract = {This paper explores an activity-sensitive clock gating technique for low-power design of VLSI clock networks. The concept of logic distance based on module activity information is introduced, and its relationship with the power consumption of the clock network is presented. A binary clock tree is built based on the logic distance between different modules to optimize the power consumption due to the interconnections (i.e., clock gating signals and clock edges). Also, a method for determining the gating signals with the fewest transitions is developed. After the clock tree is constructed, an additional optimization is performed on the gating signals to further reduce the power consumption.},
 author = {Kang, Changjun and Chen, Chunhong},
 doi = {10.1109/CJECE.2007.4407669},
 issn = {0840-8688},
 journal = {Canadian Journal of Electrical and Computer Engineering},
 keyword = {Clocks;Energy consumption;Logic;Capacitance;Delay estimation;Very large scale integration;Distributed power generation;Signal generators;Synchronous generators;Power dissipation},
 month = {Fall},
 number = {4},
 pages = {221-226},
 title = {Activity-sensitive clock design for low power consumption},
 volume = {32},
 year = {2007}
}
