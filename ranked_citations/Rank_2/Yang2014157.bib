@conference{Yang2014157,
 abstract = {Druid is an open source<sup>1</sup> data store designed for real-time exploratory analytics on large data sets. The system combines a column-oriented storage layout, a distributed, shared-nothing architecture, and an advanced indexing structure to allow for the arbitrary exploration of billion-row tables with sub-second latencies. In this paper, we describe Druid's architecture, and detail how it supports fast aggregations, flexible filters, and low latency data ingestion.},
 author = {Yang, Fangjin and Tschetter, Eric and Léauté, Xavier and Ray, Nelson and Merlino, Gian and Ganguli, Deep},
 doi = {10.1145/2588555.2595631},
 journal = {Proceedings of the ACM SIGMOD International Conference on Management of Data},
 note = {Cited by: 162},
 pages = {157 - 168},
 publication_stage = {Final},
 source = {Scopus},
 title = {Druid: A real-time analytical data store},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84904308506?origin=resultslist},
 year = {2014}
}
