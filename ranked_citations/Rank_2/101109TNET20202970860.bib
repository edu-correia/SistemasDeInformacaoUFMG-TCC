@article{10.1109/TNET.2020.2970860,
 abstract = {Cardinality estimation is the task of determining the number of distinct elements (or the cardinality) in a data stream, under a stringent constraint that the input data stream can be scanned by just one single pass. This is a fundamental problem with many practical applications, such as traffic monitoring of high-speed networks and query optimization of Internet-scale database. To solve the problem, we propose an algorithm named HLL-TailCut, which implements the estimation standard error &lt;inline-formula&gt; &lt;tex-math notation="LaTeX"&gt;$1.0 / sqrt {m}$ &lt;/tex-math&gt;&lt;/inline-formula&gt; using the memory units of four or three bits each, whose cost is much smaller than the five-bit memory units used by HyperLogLog, the best previously known cardinality estimator. This makes it possible to reduce the memory cost of HyperLogLog by 20%~45%. For example, when the target estimation error is 1.1%, state-of-the-art HyperLogLog needs 5.6 kilobytes memory. By contrast, our new algorithm only needs 3 kilobytes memory consumption for attaining the same accuracy. Additionally, our algorithm is able to support the estimation of very large stream cardinalities, even on the Tera and Peta scale.},
 author = {Xiao, Qingjun and Chen, Shigang and Zhou, You and Luo, Junzhou},
 doi = {10.1109/TNET.2020.2970860},
 issn = {1063-6692},
 issue_date = {April 2020},
 journal = {IEEE/ACM Trans. Netw.},
 month = {April},
 number = {2},
 numpages = {14},
 pages = {433–446},
 publisher = {IEEE Press},
 title = {Estimating Cardinality for Arbitrarily Large Data Stream With Improved Memory Efficiency},
 url = {https://doi.org/10.1109/TNET.2020.2970860},
 volume = {28},
 year = {2020}
}
