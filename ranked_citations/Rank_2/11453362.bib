@inproceedings{11453362,
 abstract = {The fast rate of social media adoption by university students has raised concern over its possible effects on the performance of learning. This is a research that explores the correlation between the time spent on social media, efficiency in learning, and the quality of sleep in a quantitative, data-based study. An online questionnaire in a structured form was issued to 35 students, and 34 valid answers were obtained representing different academic fields. Python-based data processing and Pearson correlation analysis gave the results which indicated three significant patterns: (1) the time of using social media was significantly and negatively related to the learning efficiency (r = −0.72, p¡ 0.01); (2) the more the exposure to social media on a daily basis, the lower was the productivity of the study (r = −0.68, p¡ 0.01); and (3) the higher the quality of sleep, the higher was the learning efficiency ($\mathrm{r}=+0.74$, p¡ 0.0 These results affirm the hypothesis that the long-term use of social media enhances cognitive load and attention discontinuity, and poor sleep quality lowers academic concentration and memory. The research study empirically supports the Cognitive Load Theory and states that sleep quality is a mediating factor between digital behavior and learning outcomes. Some of the recommendations comprise of not spending more than four hours a day on social media and not using a device within a year before sleep. The findings can add to the digital learning literature by merging behavioral, psychological, and physiological aspects of digital learning into a data science plan.},
 author = {Mirza, Qurat ul Ain Zam Zam and Kanwal, Rimsha and Ashraf, Humaira and Jhanjhi, NZ. and Saepudin, Sudin},
 booktitle = {2025 15th International Conference on Mathematics, Actuarial Science, Computer Science and Statistics (MACS)},
 doi = {10.1109/MACS68476.2025.11453362},
 issn = {},
 keyword = {Productivity;Performance evaluation;Correlation;Social networking (online);Statistical analysis;Merging;Psychology;Predictive models;Cognitive load;Physiology;Social media;learning efficiency;cognitive load;sleep quality;Pearson correlation;digital distraction;academic performance},
