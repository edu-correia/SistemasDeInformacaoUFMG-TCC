@article{10.14778/3231751.3231754,
 abstract = {An array DBMS streamlines large N-d array management. A large portion of such arrays originates from the geospatial domain. The arrays often natively come as raster files while standalone command line tools are one of the most popular ways for processing these files. Decades of development and feedback resulted in numerous feature-rich, elaborate, free and quality-assured tools optimized mostly for a single machine. ChronosDB partially delegates in situ data processing to such tools and offers a formal N-d array data model to abstract from the files and the tools. ChronosDB readily provides a rich collection of array operations at scale and outperforms SciDB by up to 75\texttimes{} on average.},
 author = {Zalipynis, Ramon Antonio Rodriges},
 doi = {10.14778/3231751.3231754},
 issn = {2150-8097},
 issue_date = {June 2018},
 journal = {Proc. VLDB Endow.},
 month = {June},
 number = {10},
 numpages = {15},
 pages = {1247–1261},
 publisher = {VLDB Endowment},
 title = {ChronosDB: distributed, file based, geospatial array DBMS},
 url = {https://doi.org/10.14778/3231751.3231754},
 volume = {11},
 year = {2018}
}
