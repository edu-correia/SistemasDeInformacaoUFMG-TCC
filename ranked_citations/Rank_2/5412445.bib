@inproceedings{5412445,
 abstract = {In current H.264/AVC encoder, the optimal coding mode of given macroblock (MB) is obtained by searching all possible modes and compared with the rate distortion (R-D) cost, called R-D optimization (RDO). The RDO operation requires the huge computational power. For fast RDO, we proposed two methods: adaptive intra-mode selection and early SKIP prediction. Experimental results show that these two methods can significantly reduce encoding time by about 23.5% and 14.5%, separately, and 31.8% by merging two methods with only negligible coding performance degradation.},
 author = {Wu, Shih-Ren and Wang, Szu-Hong and Hsia, Shih-Chang},
 booktitle = {2009 Fourth International Conference on Innovative Computing, Information and Control (ICICIC)},
 doi = {10.1109/ICICIC.2009.200},
 issn = {},
 keyword = {Rate-distortion;Automatic voltage control;Lagrangian functions;Costs;Video compression;IEC standards;ISO standards;Quantization;Optimal control;Communication system control},
 month = {Dec},
 number = {},
 pages = {1435-1438},
 title = {Fast Coding Mode Selection for Rate-Distortion Optimization in H.264/AVC},
 volume = {},
 year = {2009}
}
