@article{DONG2025129393,
 abstract = {Unsupervised domain adaptation (UDA) approaches have shown promise in improving the generalization ability of segmentation models by adapting from a source domain to a target domain using various adaptation strategies. However, most existing UDA approaches primarily focus on adapting from normal-to-normal conditions, while the adaptation from normal-to-adverse conditions is often overlooked. Compared with the former, the latter faces two critical obstacles, 1) The domain gap becomes more pronounced in the input space; 2) The issues of category imbalance and category merging are further exacerbated. In this study, we specifically address the UDA from normal conditions to multiple adverse conditions. We propose a UDA segmentation algorithm with cross-domain data augmentation and category contrast, named UDAcacc. Our data augmentation strategy involves cross-domain fused style transfer and cross-domain incremental image mixing, which aim to mitigate the larger domain gap in the input space. Additionally, our cross-domain category contrast strategy aims to alleviate the challenges of category imbalance and category merging by encouraging the model to learn domain-invariant yet category-discriminative information in both the feature and output spaces. Experimental results on the Cityscapes→ACDC benchmarks demonstrate the superiority of our proposed method over previous state-of-the-art methods.},
 author = {Wenyong Dong and Zhixue Liang and Liping Wang and Gang Tian and Qianhui Long},
 doi = {https://doi.org/10.1016/j.neucom.2025.129393},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {Unsupervised domain adaptation, Semantic segmentation, Fused style transfer, Incremental image mixing, Cross-domain category contrast},
 pages = {129393},
 title = {Unsupervised domain adaptation segmentation algorithm with cross-domain data augmentation and category contrast},
 url = {https://www.sciencedirect.com/science/article/pii/S0925231225000657},
 volume = {623},
 year = {2025}
}
