@article{10.1007/s00165-020-00520-5,
 abstract = {Camera pose estimation  is key to the proper functioning of robotic systems, supporting critical tasks such as robot navigation, target tracking, camera calibration, etc.Whilemultiple algorithms solving this problem     have been proposed, their correctness has rarely been validated using formal techniques. This is true despite the fact that the adoption of formal verification is essential for the reliability of safety-critical systems, and for their certification to high assurance levels. In this article, we present an effort in formally verifying an algorithm for camera pose estimation in an interactive theorem prover. The algorithm leverages the power of Rodrigues formula to solve the pose estimation problem under conditions for which existing solutions cannot be applied. The technical ingredients include (but are not limited to) mechanized proofs of the Rodrigues formula (along with its Cayley decomposition form) and the least squares method for fitting data. Based on the formalization of the algorithm, we formally derive and verify its general solution and unique solution.},
 address = {Berlin, Heidelberg},
 author = {Chen, Shanyan and Wang, Guohui and Li, Ximeng and Zhang, Qianying and Shi, Zhiping and Guan, Yong},
 doi = {10.1007/s00165-020-00520-5},
 issn = {0934-5043},
 issue_date = {Nov 2020},
 journal = {Form. Asp. Comput.},
 keyword = {HOL Light, Formalization, Least squares method, Rodrigues formula, Camera pose estimation},
 month = {November},
 number = {4–6},
 numpages = {21},
 pages = {417–437},
 publisher = {Springer-Verlag},
 title = {Formalization of Camera Pose Estimation Algorithm based on Rodrigues Formula},
 url = {https://doi.org/10.1007/s00165-020-00520-5},
 volume = {32},
 year = {2020}
}
