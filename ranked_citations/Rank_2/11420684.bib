@inproceedings{11420684,
 abstract = {In the era of smart robotics and automated frameworks, object recognition plays an essential role in enabling machines to make robust decisions. This project presents a robust and efficient method for object classification using image and video data. The methodology combines basic preprocessing method to improve identification accuracy in complex environments. Conventional deep learning approaches require high computational resources; meanwhile, the proposed system is lightweight and appropriate for utilization on edge devices and limited computational power. Current research, including innovative object detection systems and hybrid feature patterns, has inspired our design via highlighting the value of merging motion signals with contextual data. Through a systematic multi-stage framework, our model effectively recognizes vehicles and non-vehicle objects. The findings demonstrate promising accuracy over two state-of-the-art datasets, highlighting the model’s capability for use in surveillance, smart transport, and robotic applications. This research extends intelligent visual approaches and provides a robust solution and a meaningful contribution.},
 author = {Akhter, Israr and Dekan, Martin and Duchon, Frantisek},
 booktitle = {2026 IEEE 24th World Symposium on Applied Machine Intelligence and Informatics (SAMI)},
 doi = {10.1109/SAMI68106.2026.11420684},
 issn = {2767-9438},
 keyword = {Visualization;Accuracy;Systematics;Surveillance;Object detection;Robot sensing systems;Feature extraction;Sensors;Object recognition;Videos;Computer Vision;Contextual features;Deep Belief Network;Machine Learning Object detection;object segmentation;Object tracking;principal component analysis;Robotic era;Robotic Vision},
 month = {Jan},
 number = {},
 pages = {000125-000130},
 title = {Integrated Machine Learning and Data Optimization for Sensing Roadway Motion Objects},
 volume = {},
 year = {2026}
}
