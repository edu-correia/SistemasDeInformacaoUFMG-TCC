@article{ZHANG2025119800,
 abstract = {Reliable dynamic deformation observation is significant to structural safety evaluation. Traditional deformation monitoring sensors typically rely on a reference point and can only measure a single point at a time. Image based observation methods are still difficult to deal with high-speed dynamic movement of the structure for the target catching and feature extract. A precise and convenient method for tracking the structural dynamic deformation process is proposed in this research without references. The proposed method combines two types of features: Hierarchical Convolutional Features (HCF) for capturing abstract representation and Felzenszwalb’s Histogram of Oriented Gradients (FHOG) for detailed spatial information. This combination forms the HCF and FHOG Fusion-based Kernelized Correlation Filter (HFF-KCF), where a KCF is applied to effectively merge these features. Experiments were conducted on a scaled reinforced concrete self-centering frame structure using high-speed cameras during shaking table tests. Story displacements and joint rotations, achieving over 90 % of measurements with an error of zero pixels across all images in seismic cases. This innovative approach offers a reliable, high-quality solution for monitoring deformations in civil engineering, enhancing precision and reliability in structural assessments.},
 author = {Hongmei Zhang and Fan Hu and Yuanfeng Duan and Yi Fang and J.J. Roger Cheng and Lening Cao},
 doi = {https://doi.org/10.1016/j.engstruct.2025.119800},
 issn = {0141-0296},
 journal = {Engineering Structures},
 keyword = {Computer vision, Kernelized correlation filter, Deformation, Deep learning, Self-centering frame, Shaking table test},
 pages = {119800},
 title = {A vision-based deformation tracking for self-centering structures during shaking table tests},
 url = {https://www.sciencedirect.com/science/article/pii/S0141029625001907},
 volume = {330},
 year = {2025}
}
