@article{10.1007/s00778-016-0436-3,
 abstract = {Maintaining and querying hierarchical data in a relational database system is an important task in many business applications. This task is especially challenging when considering dynamic use cases with a high rate of complex, possibly skewed structural updates. Labeling schemes are widely considered the indexing technique of choice for hierarchical data, and many different schemes have been proposed. However, they cannot handle dynamic use cases well due to various problems, which we investigate in this paper. We therefore propose Order Indexes--a dynamic representation of the nested intervals encoding--which offer competitive query performance, unprecedented update efficiency, and robustness for highly dynamic workloads.},
 address = {Berlin, Heidelberg},
 author = {Finis, Jan and Brunel, Robert and Kemper, Alfons and Neumann, Thomas and May, Norman and Faerber, Franz},
 doi = {10.1007/s00778-016-0436-3},
 issn = {1066-8888},
 issue_date = {February  2017},
 journal = {The VLDB Journal},
 keyword = {Tree indexing, Tree data, Nested intervals, Indexing, Hierarchical data},
 month = {February},
 number = {1},
 numpages = {26},
 pages = {55–80},
 publisher = {Springer-Verlag},
 title = {Order Indexes: supporting highly dynamic hierarchical data in relational main-memory database systems},
 url = {https://doi.org/10.1007/s00778-016-0436-3},
 volume = {26},
 year = {2017}
}
