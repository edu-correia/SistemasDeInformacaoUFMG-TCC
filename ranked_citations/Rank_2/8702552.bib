@inproceedings{8702552,
 abstract = {In video coding, slice-level and block-level weighted bi-prediction are used for scenes with temporal brightness variation. However, there are still structured residuals when applying weighted bi-prediction in slice and block level. Recently, CNN-based bi-prediction has achieved remarkable success on reducing significant structured residuals, in which bi-predictor is generated by CNN model using two reference blocks as inputs. Inspired by high spatial correlation of pixels, this paper uses spatial neighboring pixels of both current block and two reference blocks as the additional information of the proposed CNN model to further reduce residual and generate a more accurate bi-predictor. Moreover, by comparing AMVP and merge/skip mode, this paper illustrates that CNN-based bi-prediction is more efficient for merge/skip mode than for AMVP mode. Experimental results show that proposed method reaches 3.46% BD-rate saving for random access configuration on average compared to HM 16.15.},
 author = {Mao, Jue and Yu, Hualong and Gao, Xiaoding and Yu, Lu},
 booktitle = {2019 IEEE International Symposium on Circuits and Systems (ISCAS)},
 doi = {10.1109/ISCAS.2019.8702552},
 issn = {2158-1525},
 keyword = {Adaptation models;Predictive models;Training;Decoding;Video coding;Encoding;Brightness;bi-prediction;CNN;pixel-wise combination;spatial neighboring pixels},
 month = {May},
 number = {},
 pages = {1-5},
 title = {CNN-Based Bi-Prediction Utilizing Spatial Information for Video Coding},
 volume = {},
 year = {2019}
}
