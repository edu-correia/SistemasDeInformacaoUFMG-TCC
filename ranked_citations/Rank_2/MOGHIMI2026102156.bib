@article{MOGHIMI2026102156,
 abstract = {Building sector emissions account for approximately one-third of global greenhouse gas emissions and 36% of final energy consumption worldwide, making the transition to net zero energy-carbon buildings crucial for addressing climate change. While technological solutions exist, their effective implementation requires comprehensive understanding of available innovations and emerging trends. This paper uses VOSviewer software to analyze and synthesize technological approaches for achieving net zero energy-carbon buildings through a systematic bibliometric analysis of research published between 2000 and 2024. To achieve this, 4000 articles for each keyword, combining the 2000 most cited and 2000 most recent papers from the Scopus database are examined. Temporal analysis demonstrated a significant shift in research focus from zero-energy to zero-carbon buildings post-2019, coinciding with stricter emission regulations. Research trends evolved from basic technologies like electrochromic windows to sophisticated solutions including artificial intelligence and digital twins. The findings identified critical research gaps in different fields like “smart power grids” and utilizing “blockchain” for reducing carbon emissions. Results also showed that patents submitted for novel technologies related to “zero energy-carbon building” had a sharp increase from 2016 because of Paris agreement. This review provides valuable guidance for researchers and policymakers by mapping the technological landscape and identifying forgotten directions for future innovation in achieving zero energy-carbon buildings. The results of this study indicate that there are significant research gaps concerning the integration of digital twins and carbon capture within zero energy-carbon buildings.},
 author = {Mohsen Moghimi and Fatemeh Abdoli and Mojtaba Mahmoodian and Rahim Zahedi},
 doi = {https://doi.org/10.1016/j.esr.2026.102156},
 issn = {2211-467X},
 journal = {Energy Strategy Reviews},
 keyword = {Zero-energy-carbon building, Bibliometrics analysis, Innovative technology, Building energy efficiency, VOSviewer},
 pages = {102156},
 title = {Approaches to achieving net zero energy-carbon buildings through innovative technologies: A bibliographic perspective},
 url = {https://www.sciencedirect.com/science/article/pii/S2211467X26001227},
 volume = {64},
 year = {2026}
}
