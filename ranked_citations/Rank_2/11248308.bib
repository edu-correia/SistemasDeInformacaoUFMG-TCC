@inproceedings{11248308,
 abstract = {In order to achieve CO2 emission-free production of base chemicals, a renewed interest exists in near-atmospheric pressure plasma technologies for synthesis of $\text{HNO}_{3}$ (via $\text{NO}_{\mathrm{x}}$), $\text{NH}_{3}, \mathrm{C}_{2} \mathrm{H}_{2}, \mathrm{C}_{2} \mathrm{H}_{4}$, and $\mathrm{H}_{2}$. DC arc reactors can be operated at high thermal efficiency, however, improvements with respect to product selectivity and energy-cost are desired. Multi-arc DC and line-frequency AC discharge reactors are available for achieving higher plasma-enthalpies than feasible with single column arcs. However, improving the temperature and flow uniformity within such reactors has received comparatively little attention. Discharge structures are often chaotic, and at short distance from the electrodes arcs merge together in a single high current column according Steenbeck's minimum power principle.},
 author = {Creyghton, Y. and Mirpour, S.},
 booktitle = {2025 IEEE Pulsed Power & Plasma Science (PPPS)},
 doi = {10.1109/PPPS56198.2025.11248308},
 issn = {2158-4923},
 keyword = {Electrodes;Production;Discharges (electric);Plasmas;Inductors;Plasma temperature;Chemicals;Periodic structures},
 month = {June},
 number = {},
 pages = {1-1},
 title = {High-Frequency Multi-Spark Reactor for Gas Processing},
 volume = {},
 year = {2025}
}
