@inproceedings{4239412,
 abstract = {The ACS computation and the survivor memory are most power critical, consuming about 90% power in the Viterbi decoder. Based on the low power mechanisms, the scarce state transition (SST) technique and the variable truncation length, we present a Viterbi decoder for the MB-OFDM UWB applications. The SST scheme lowers state transition as well as signal switches in the ACS units. Moreover, the decoding with variable truncation length leads to the access reduction in the survivor memory. The experimental results show more than 30% power reduction under high SNRs as compared to those without SST and variable truncation length.},
 author = {Lin, Dah-Jia and Lin, Chien-Ching and Chen, Chih-Lung and Chang, Hsie-Chia and Lee, Chen-Yi},
 booktitle = {2007 International Symposium on VLSI Design, Automation and Test (VLSI-DAT)},
 doi = {10.1109/VDAT.2007.373220},
 issn = {},
 keyword = {Viterbi algorithm;Decoding;Energy consumption;Registers;Merging;Power engineering and energy;Power engineering computing;Switches;Convolutional codes;Information retrieval},
 month = {April},
 number = {},
 pages = {1-4},
 title = {A Low-Power Viterbi Decoder Based on Scarce State Transition and Variable Truncation Length},
 volume = {},
 year = {2007}
}
