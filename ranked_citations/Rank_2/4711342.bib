@article{4711342,
 abstract = {A new algorithm for the modulated complex lapped transform (MCLT) with a sine windowing function is presented. It is shown that by merging the windowing operation with the main computation, both the real and the imaginary parts of the MCLT with 2N inputs can be obtained from two N-point discrete cosine transforms of type II (DCTs-II) of appropriate inputs. The resulting algorithm is computationally very efficient. In general, the value of N is an even number. When N is a power of 2, the proposed algorithm uses only N log N + 2 real multiplications (including the scaling factors in the DCT computation), with none of those being outside the DCT blocks.},
 author = {Dai, Xingdong and Wagh, Meghanad D.},
 doi = {10.1109/LSP.2008.2008434},
 issn = {1558-2361},
 journal = {IEEE Signal Processing Letters},
 keyword = {Discrete transforms;Discrete cosine transforms;Filter bank;Discrete Fourier transforms;Image reconstruction;Modulation coding;Transform coding;Computational efficiency;Merging;Audio coding;fast algorithm;modified discrete cosine transform;modified discrete sine transform;modulated complex lapped transform},
 month = {Jan},
 number = {1},
 pages = {30-33},
 title = {Fast Algorithm for Modulated Complex Lapped Transform},
 volume = {16},
 year = {2009}
}
