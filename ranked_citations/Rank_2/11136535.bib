@inproceedings{11136535,
 abstract = {Chinese painting style identification through neural networks hopes to robotize traditional artwork categorization into various styles like Gongbi (delicate detail) and Xieyi (sketching freedom) and dynasties like Tang, Song, or Ming. The delicate differences in brushstrokes, ink gradations, and balance of elements in composition complicate automated identification, especially with small labelled datasets and style intersectionality. To counter this, a Dual-Stream Hierarchical Attention Network (DS-HAN) is introduced, merging convolutional neural networks (CNNs) for local texture examination and transformers to encode global compositional context. Cross-attention fusion is used by the model to align the brushstroke patterns with dynastic features, while a self-supervised pre-training step minimizes reliance on annotated samples. Testing on a carefully curated test set of 15,000 paintings shows a 96.4% classification accuracy with precision and recall greater than 95.2% and 95.8%, respectively, that is higher than ResNet-50 (91.3%) and ViT-Base (93.7%). Style-specific F1-scores are greater than 95.5% and mean average precision (mAP) for dynastic period prediction is 96.1%. Through near-human accuracy, the method makes scalable digitization of cultural heritage possible, providing resources for museums, educators, and art historians to analyse and maintain traditional Chinese aesthetics effectively.},
 author = {Wang, Yiting},
 booktitle = {2025 International Conference on Intelligent Computing and Knowledge Extraction (ICICKE)},
 doi = {10.1109/ICICKE65317.2025.11136535},
 issn = {},
 keyword = {Accuracy;Neural networks;Self-supervised learning;Seals;Transformers;Museums;Convolutional neural networks;Robots;Painting;Testing;chinese painting categorization;dual-stream attention networks;self-supervised learning;recognition of dynastic style;preservation of art heritage},
 month = {June},
 number = {},
 pages = {1-7},
 title = {Attention-Guided DS-HAN for Fine-Grained Chinese Painting Style Classification},
 volume = {},
 year = {2025}
}
