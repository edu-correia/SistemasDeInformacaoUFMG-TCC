@inproceedings{5277075,
 abstract = {In this paper, a nonlinear parameter fuzzy control scheme is proposed for a class of uncertain systems without all states measurement. In the control scheme, a fuzzy identifier without prior knowledge on membership functions is merged into direct adaptive control by means of a linear state estimator. Since the structure of the fuzzy identifier is nonlinear in the adjusted parameters, the fuzzy identifier uses a mean method to develop adaptive laws. Finally, an example is provided to demonstrate the effectiveness of the proposed control scheme.},
 author = {Chen, Chun-Yao and Hong, Chin-Ming and Leu, Yih-Guang},
 booktitle = {2009 IEEE International Conference on Fuzzy Systems},
 doi = {10.1109/FUZZY.2009.5277075},
 issn = {1098-7584},
 keyword = {Fuzzy control;Fuzzy systems;Adaptive control;Control systems;Nonlinear systems;Automatic control;Uncertain systems;State estimation;Control system synthesis;Parameter estimation;Fuzzy systems;adaptive control;nonlinear systems},
 month = {Aug},
 number = {},
 pages = {1216-1220},
 title = {Nonlinear parameter fuzzy control for uncertain systemswith only system output measurement},
 volume = {},
 year = {2009}
}
