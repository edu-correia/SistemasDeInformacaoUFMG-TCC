@inproceedings{11126346,
 abstract = {One of the predominant causes of program distortion in the real quantum computing system may be attributed to the probability deviation caused by thermal relaxation. We introduce Barber (Balancing reAdout Results using Bit-invErted ciRcuits), a method designed to counteract the asymmetric thermal relaxation deviation and improve the reliability of near-term quantum programs. Barber collaborates with a bit-inverted quantum circuit, where the excited quantum state of qubits is assigned to the $\vert 0\rangle$ and the unexcited state to the $\vert 1\rangle$. In doing so, bit-inverted quantum circuits can experience thermal relaxation in the opposite direction compared to standard quantum circuits. Barber can effectively suppress the thermal relaxation deviation in program's readout results by selectively merging distributions from the standard and bit-inverted circuits.},
 author = {Jang, Enhyeok and Choi, Seungwoo and Kim, Youngmin and Seo, Jeewoo and Ro, Won Woo},
 booktitle = {2024 ACM/IEEE International Conference On Computer Aided Design (ICCAD)},
 doi = {},
 issn = {1558-2434},
 keyword = {Quantum algorithm;Prevention and mitigation;Qubit;Merging;Quantum state;Distortion;Reliability engineering;Probability distribution;Quantum circuit;Standards;Asymmetric Quantum Bit Error Mitigation;Basis-Inverted Program},
 month = {Oct},
 number = {},
 pages = {1-9},
 title = {Barber: Balancing Thermal Relaxation Deviations of NISQ Programs by Exploiting Bit-Inverted Circuits},
 volume = {},
 year = {2024}
}
