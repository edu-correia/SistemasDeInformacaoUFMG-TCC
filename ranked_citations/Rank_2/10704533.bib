@inproceedings{10704533,
 abstract = {In addressing the prediction issue of silicon content in blast furnace hot metal, previous studies often overlooked the analysis of operational mechanisms in the blast furnace. In response, this study integrates mechanistic knowledge to construct a spatial-temporal network structure (K-STN) that reflects the dynamic interactions of various factors during the smelting process. This approach uses a knowledge graph to represent the spatial relationships among variables within the blast furnace, and combines Graph Convolutional Networks (GCN) with self-attention mechanisms to create a spatial-temporal feature extraction module. This method merges mechanistic analysis with data mining, and improves the model's interpretability. Through practical application, this method has demonstrated superior accuracy and stability in predicting the silicon content of hot metal.},
 author = {Jiang, Meng and Deng, Qiyuan and Dong, Zhiming and Wang, Xianpeng},
 booktitle = {2024 6th International Conference on Data-driven Optimization of Complex Systems (DOCS)},
 doi = {10.1109/DOCS63458.2024.10704533},
 issn = {},
 keyword = {Knowledge engineering;Smelting;Metals;Knowledge graphs;Predictive models;Blast furnaces;Silicon;Stability analysis;Spatiotemporal phenomena;Optimization;blast furnace smelting;spatial-temporal network;prediction model;deep learning},
 month = {Aug},
 number = {},
 pages = {767-772},
 title = {Spatiotemporal Network Model for Prediction of Silicon Content in Hot Metal of Blast Furnace},
 volume = {},
 year = {2024}
}
