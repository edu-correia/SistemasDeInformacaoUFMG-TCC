@conference{Wen2011111,
 abstract = {For a real time object tracking system, potential interferences such as ghost, occlusion and distractors have a great influence on the tracking performance. This paper aims to provide a solution to these problems. In order to remove the ghost, we first narrow the interest region of the foreground to the boundary region of the tracked object. Then the new interest region on the incoming image normally contains small amount of contour information if the foreground is a ghost. This can be used for fast ghost removal. As for the occlusion handling, we adopt the merge/split strategy as well as take advantage of the hue histogram in HSV space to distinguish the merged objects. In addition, the main moving direction of the tracked object will be obtained in advance for detecting the distractors case. As long as such case happens, the hue histogram is used to identify whether the tracked object is the original one so as to avoid the distractors problem. We have applied our algorithm to many banking supervision related videos. The experimental results show that the proposed tracking scheme is feasible and competent. © 2011 IEEE.},
 author = {Wen, Jiajun and Xu, Yong and Zhan, Yinwei},
 doi = {10.1109/ICCIS.2011.6070311},
 journal = {Proceedings of the 2011 IEEE 5th International Conference on Cybernetics and Intelligent Systems, CIS 2011},
 note = {Cited by: 0},
 pages = {111 - 116},
 publication_stage = {Final},
 source = {Scopus},
 title = {Ghost, occlusion and distractors handling in object tracking system},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/82855176953?origin=resultslist},
 year = {2011}
}
