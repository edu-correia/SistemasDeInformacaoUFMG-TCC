@article{Gong20253518,
 abstract = {Approximate Nearest Neighbor (ANN) search is a foundational yet computationally demanding query in vector databases, critical for applications such as information retrieval and generative Al inference. Hierarchical graph-based methods have attracted significant attention due to their promising query performances compared to other indexes for ANN search. I Iowcvcr. these methods still face efficiency bottlenecks because the)' rely on exhaustive and level-by-level traversals within hierarchical graphs. This paper introduces SHG. a novel hierarchical graph-based index that enhances search efficiency by bypassing intermediate and redundant levels. Specifically. SHG leverages a hierarchical vector compression method to reduce the time spent on distance computations, and employs a new data structure called shortcuts to determine the number of intermediate levels that can be safely skipped. Extensive experiments demonstrate that our solution achieves 1.5-1.8X speedup compared to state-of-the-art methods. Meanwhile, our method significantly improves the robustness of ANN search, boosting recall by up to 20% for certain queries on benchmark datasets. © 2025, VLDB Endowment. All rights reserved.},
 author = {Gong, Zengyang and Zeng, Yuxiang and Chen, Lei},
 doi = {10.14778/3748191.3748212},
 journal = {Proceedings of the VLDB Endowment},
 note = {Cited by: 1},
 number = {10},
 pages = {3518 - 3530},
 publication_stage = {Final},
 source = {Scopus},
 title = {Accelerating Approximate Nearest Neighbor Search in Hierarchical Graphs: E icient Level Navigation with Shortcuts},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105021397569?origin=resultslist},
 volume = {18},
