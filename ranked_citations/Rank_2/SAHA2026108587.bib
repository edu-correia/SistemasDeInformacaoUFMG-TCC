@article{SAHA2026108587,
 abstract = {This study presents the development and assessment of a real-time rainfall quality control algorithm tailored for the MESO-scale rain gauge NETwork (MESONET) over Mumbai region in India. The initiative addresses the pressing demand for reliable, high-density Automatic Rain Gauge (ARG) data essential for monitoring urban rainfall patterns in extreme weather-prone regions such as Mumbai. The National Centre for Medium-Range Weather Forecasting (NCMRWF) deployed a real-time system to assign quality flags to individual rain gauges, ensuring data accuracy and reliability. An operational demonstration of monsoon rainfall monitoring from 2020 to 2025 demonstrated significant coastal-to-inland variations, underscoring the network's efficacy in detecting extreme rainfall events. The study also integrated GPM-IMERG satellite rainfall observations with quality-controlled MESONET data to produce a high-resolution gridded rainfall dataset. This innovative dataset offers enhanced insights into the spatiotemporal dynamics of rainfall, providing a robust foundation for analysing extreme rainfall events with greater precision. By improving the quality and interpretation of rainfall data, this work contributes to better-informed decision-making processes and supports the formulation of mitigation strategies for urban centers like Mumbai, which are increasingly vulnerable to severe weather events. Overall, the findings emphasize the critical role of accurate and timely rainfall data in addressing urban challenges posed by extreme weather, enhancing resilience, and fostering sustainable urban planning. The methodological framework leverages established approaches but adapts them to the unique operational challenges of Mumbai's high-density urban rain gauge network. The novelty lies in customizing and implementing these methods for near real-time integration across multi-agency datasets, ensuring spatial and temporal coherence in one of the world's most complex urban rainfall environments. This operational adaptation, coupled with rigorous multi-source validation, offers a transferable model for other megacities facing similar hydrometeorological risks.},
 author = {Upal Saha and V.S. Prasad and Ashis K. Mitra and Munmun Das Gupta and S. Indira Rani and John P. George and G. Pandithurai and Rajib Chattopadhyay},
 doi = {https://doi.org/10.1016/j.atmosres.2025.108587},
 issn = {0169-8095},
 journal = {Atmospheric Research},
 keyword = {Automatic rain gauges, Quality control, High-resolution gridded data, Extreme rainfall, Urban-hydro-processes, Hazard monitoring},
 pages = {108587},
 title = {Near real-time quality-control of MESONET rain gauges: Generating high-resolution gridded rainfall by blending with GPM satellite observations},
 url = {https://www.sciencedirect.com/science/article/pii/S0169809525006799},
 volume = {330},
 year = {2026}
}
