@inproceedings{10397463,
 abstract = {Decision making in dense traffic uncertainty scenarios is challenging for autonomous vehicles. Compare with costly manually designed driving policy, deep Reinforcement Learning (DRL) offers considerable potential by automatically learning and improving strategies. However, automated driving systems that only rely on the physical state space can hardly perform well in complex scenarios. In this paper, a framework is present to implement model-free reinforcement learning in complex uncertainty scenarios. Supervised learning is used to infer the latent states of other drivers through subtle cues and combine it with reinforcement learning. The performance of traditional reinforcement learning algorithms is enhanced by considering the surrounding vehicle types as well as the latent states of other drivers. Some challenging tasks are demonstrated, such as merging and overtaking in dense traffic in the Simulation of Urban Mobility (SUMO) simulation platform. The results show that our approach solves the tasks well and significantly better than the baseline.},
 author = {Lu, Songxin and Yang, Bo and Yang, Zhe and Pei, Xiaofei},
 booktitle = {2023 7th CAA International Conference on Vehicular Control and Intelligence (CVCI)},
 doi = {10.1109/CVCI59596.2023.10397463},
 issn = {},
 keyword = {Uncertainty;Merging;Supervised learning;Reinforcement learning;Switches;Task analysis;Vehicles;latent state inference;decision-making;decision switching;autonomous vehicle;vehicle label},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Template Reinforcement Learning for Automated Driving with Scenario Switching Inference Labeling},
 volume = {},
 year = {2023}
}
