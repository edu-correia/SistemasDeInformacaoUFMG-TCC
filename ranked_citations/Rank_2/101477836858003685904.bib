@article{10.14778/3685800.3685904,
 abstract = {Databases employ out-of-line storage and compression strategies to manage extensive text data. However, the growth in both the size of individual data items and overall data volume has significantly increased the burden of decompression, adversely affecting query performance. To address this challenge, we develop HocoPG, an innovative system that incorporates homomorphic compression theory within RDBMS, enabling direct computation on compressed data to enhance query efficiency and system usability. HocoPG performs homomorphic evaluations across a suite of basic text operations, enabling the execution of intricate text queries by combining these operations flexibly. In this demonstration, we showcase the deployment and usage of HocoPG through a database terminal. Additionally, we introduce the HocoPG Admin, a tool that provides insights to DBAs and general users for choosing the optimal compression scheme based on their individual needs.},
 author = {Guan, Jiawei and Zhang, Feng and Tang, Yuxin and Ye, Weitang and Du, Xiaoyong},
 doi = {10.14778/3685800.3685904},
 issn = {2150-8097},
 issue_date = {August 2024},
 journal = {Proc. VLDB Endow.},
 month = {August},
 number = {12},
 numpages = {4},
 pages = {4477–4480},
 publisher = {VLDB Endowment},
 title = {HocoPG: A Database System with Homomorphic Compression for Text Processing},
 url = {https://doi.org/10.14778/3685800.3685904},
 volume = {17},
 year = {2024}
}
