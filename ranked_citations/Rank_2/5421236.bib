@inproceedings{5421236,
 abstract = {A generic solution for remote adaptive streaming and rendering of large terrain is presented in this paper. The aim that loading and rendering speeds do not depend on the size of the database is achieved in this solution. In particular this solution avoids loading irrelevant or redundant data and requests the most important data first, and avoids costly data structure operations as much as possible, in favor of ¿in-place¿ data updates and selection using sample masks.},
 author = {Cao, Xuefeng and Wan, Gang},
 booktitle = {2010 Second International Conference on Computer Modeling and Simulation},
 doi = {10.1109/ICCMS.2010.438},
 issn = {},
 keyword = {Databases;Data structures;Network servers;Terrain mapping;Computational modeling;Computer simulation;Velocity measurement;Data visualization;Earth;Internet;large terrain;real time rendering;adaptive streaming;level of detail},
 month = {Jan},
 number = {},
 pages = {327-330},
 title = {Adaptive Transmitting and Rendering Methods for Large Terrain},
 volume = {3},
 year = {2010}
}
