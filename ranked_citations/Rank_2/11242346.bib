@inproceedings{11242346,
 abstract = {Aerial and terrestrial imagery commonly aids in post-earthquake damage assessment and guiding rescue operations. However, relying on a single platform for assessment has limitations in viewing angles and comprehending intricate structural damage within three-dimensional (3D) building objects. In response, we propose an innovative approach for detecting 3D building damage by integrating aerial and terrestrial data. Our methodology involves data fusion to generate detailed 3D point clouds of buildings. Subsequently, we derive 3D structural damage datasets from these regional 3D point clouds. Leveraging the 3D deep learning framework, PointNet++, we extract high-level 3D semantic features of structural damage. The results showcase our approach's capability to reconstruct precise 3D building point clouds and proficiently identify 3D structural damage within buildings.},
 author = {Liu, Chaoxian and Sui, Haigang and Zhang, ChengYu and Ni, Zixun and Zhou, Ning},
 booktitle = {IGARSS 2025 - 2025 IEEE International Geoscience and Remote Sensing Symposium},
 doi = {10.1109/IGARSS55030.2025.11242346},
 issn = {2153-7003},
 keyword = {Point cloud compression;Deep learning;Solid modeling;Three-dimensional displays;Buildings;Semantics;Geoscience and remote sensing;Data integration;Feature extraction;Image reconstruction;Building damage;Aerial-terrestrial fusion;3D point clouds;Pointnet++},
 month = {Aug},
 number = {},
 pages = {995-998},
 title = {Aerial-Terrestrial Point Cloud Integration for Advanced 3D Building Damage Recognition},
 volume = {},
 year = {2025}
}
