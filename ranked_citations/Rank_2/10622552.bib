@inproceedings{10622552,
 abstract = {With a projected increase in the traffic volume of Unmanned Aircraft Systems (UAS) by 2030, congestion of airspace and communication techniques between multiple UAS are the main challenges. The use of UAS in various applications, such as air taxis, air ambulances, disaster management, etc., requires a dedicated Air Traffic Management (ATM) system to avoid Near Mid-Air Collisions (NMAC). The National Aeronautics and Space Administration's (NASA) Advanced Air Mobility (AAM) campaign will require air corridors stationed in structured airspace to ensure the functionality of a densely packed UAS ecosystem. This paper focuses on using structured airspace to facilitate vehicle pathway transitions between two adjacent air corridors using Vehicle-to-Vehicle (V2V) communications in a special use case scenario known as merging. The paper focuses on the message protocol for merging, which is demonstrated and implemented using AirSim.},
 author = {Dalloul, Batool and Mandapaka, Jaya Sravani and McCorkendale, Logan and Nicoll, Shane and Namuduri, Kamesh},
 booktitle = {ICC 2024 - IEEE International Conference on Communications},
 doi = {10.1109/ICC51166.2024.10622552},
 issn = {1938-1883},
 keyword = {Protocols;Merging;NASA;Ecosystems;Vehicular ad hoc networks;Disaster management;Air traffic control;Air corridors;Unmanned Aircraft Systems;Merging;Collision Avoidance;Vehicle-to-Vehicle communications},
 month = {June},
 number = {},
 pages = {3894-3900},
 title = {Merging in Air Corridors Using Vehicle-to-Vehicle Communications},
 volume = {},
 year = {2024}
}
