@inproceedings{11491730,
 abstract = {Cervical cancer continues to rank among the leading causes of cancer-related deaths among women worldwide, especially in low- and middle-income nations. Traditional screening techniques, such as the Pap smear test and HPV testing, although effective, have limitations in their dependence on human interpretation, the risk of human error, and variability between observers. These limitations mandate the urgency for automated, precise, and scalable diagnostic systems. In this work, we propose a computer-aided diagnostic (CAD) framework using the integration of deep feature fusion mechanism with machine learning algorithms by utilizing the SIPaKMeD benchmark dataset. The architecture combines the discriminative characteristics of four pre-trained, fine-tuned deep learning models- VGG16, VGG19, ResNet50, and XceptionNet-to implement a hybrid deep feature fusion (HDFF) technique. These representations of features are merged and passed through several machine learning classifiers. Support Vector Machine (SVM) achieves the highest among them with an accuracy rate of 96.43%. This work demonstrates that HDFF with strong ML classifiers significantly enhances classification accuracy for multi-class cervical cell classification. With high values of all measures-accuracy, F1-score, Matthews Correlation Coefficient (MCC), and AUC-ROC, the proposed CAD framework provides a smart and stable solution with great potential for clinical use. The implemented codes are publicly available at https://github.com/diponkor-bala/DF2SPred.},
 author = {Bala, Diponkor and Meghla, Margia Akter and Labony, Jannatul Ferdous and Rashid, Anjuman Ara and Karim, S M Rakib Ul and Zhou, Zhaoxian},
 booktitle = {2025 28th International Conference on Computer and Information Technology (ICCIT)},
 doi = {10.1109/ICCIT68739.2025.11491730},
 issn = {2474-9656},
 keyword = {Central Processing Unit;Pixel;Protocols;Radio frequency;HTTP;Radio access networks;Regional area networks;Digital images;Radio communication;Fuses;Cervical Cancer;Deep Learning;Machine Learning;Hybrid Deep Feature Fusion;SIPaKMeD Dataset},
 month = {Dec},
 number = {},
 pages = {251-256},
 title = {DF2SPred: An Efficient Cervical Cancer Prediction Using Hybrid Deep Feature Fusion Mechanism},
 volume = {},
 year = {2025}
}
