@article{KRAUS2023761,
 abstract = {The cell orchestrates the dance of chromosome segregation with remarkable speed and fidelity. The mitotic spindle is built from scratch after interphase through microtubule (MT) nucleation, which is dependent on the γ-tubulin ring complex (γ-TuRC), the universal MT template. Although several MT nucleation pathways build the spindle framework, the question of when and how γ-TuRC is targeted to these nucleation sites in the spindle and subsequently activated remains an active area of investigation. Recent advances facilitated the discovery of new MT nucleation effectors and their mechanisms of action. In this review, we illuminate each spindle assembly pathway and subsequently consider how the pathways are merged to build a spindle.},
 author = {Jodi Kraus and Raymundo Alfaro-Aco and Bernardo Gouveia and Sabine Petry},
 doi = {https://doi.org/10.1016/j.tibs.2023.06.004},
 issn = {0968-0004},
 journal = {Trends in Biochemical Sciences},
 keyword = {branching MT nucleation, γ-tubulin ring complex (γ-TuRC), spindle assembly factors (SAFs), XMAP215, CDK5RAP2, augmin, TPX2},
 number = {9},
 pages = {761-775},
 title = {Microtubule nucleation for spindle assembly: one molecule at a time},
 url = {https://www.sciencedirect.com/science/article/pii/S0968000423001433},
 volume = {48},
 year = {2023}
}
