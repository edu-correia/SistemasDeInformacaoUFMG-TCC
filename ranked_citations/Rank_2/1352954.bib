@inproceedings{1352954,
 abstract = {In this paper we introduce the color-based catchment basin merging algorithm, an area-based segmentation approach that is specifically designed to segment low-altitude aerial images, as a preprocessing step to 3D reconstruction. This approach extends the watershed-based catchment basin merging algorithm, which is purely geometric, by introducing color similarity as an additional criterion to decide on the merging of evolving regions. Experiments performed with real aerial images of varied nature demonstrate that this modification eliminates over-segmentation problems of the existing algorithm, allowing large-scale urban scenes to be segmented in an accurate, reliable and fully automatic way.},
 author = {Huguet, A.B. and de Andrade, M.C. and Carceroni, R.L. and Araujo, A.A.},
 booktitle = {Proceedings. 17th Brazilian Symposium on Computer Graphics and Image Processing},
 doi = {10.1109/SIBGRA.2004.1352954},
 issn = {1530-1834},
 keyword = {Image segmentation;Merging;Shape measurement;Convergence;Image reconstruction;Shape control;Image storage;Topology;Algorithm design and analysis;Large-scale systems},
 month = {Oct},
 number = {},
 pages = {138-145},
 title = {Color-based watershed segmentation of low-altitude aerial images},
 volume = {},
 year = {2004}
}
