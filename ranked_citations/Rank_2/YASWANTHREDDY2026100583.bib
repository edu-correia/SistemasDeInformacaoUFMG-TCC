@article{YASWANTHREDDY2026100583,
 abstract = {ABSTRACT
Smart grids generate enormous quantities of high dimensional, multivariate time-series data in sensor, meter and cyber-physical control devices, and rapid anomaly detection for operational reliability and security. Conventional supervised detection methods are constrained by the labeled are extremely scarce, diverse, and costly to annotate. To address these challenges, this work proposes a self-supervised learning architectural framework that studies the natural temporal behavior of normal grid operation without using annotated instances of faults. The approach combines two mutual complementary pretext tasks for contrastive representation learning and masked temporal reconstruction to both learn local variations and long-range dependencies in variables. A hybrid anomaly scoring approach—merging reconstruction error and latent-space deviation—is used to detect departures from normal behaviour. The structure is tested on benchmark smart-grid and industrial control data, including SMD, SWaT, and WADI, after a standard preprocessing procedure that involves normalization, augmentation, and sliding-window segmented. The experimental results prove that the proposed approach is consistently outperforms state-of-the-art supervised, unsupervised and self-supervised baselines, including Isolation Forest, LSTM Autoencoders, VAEs, TadGAN, and TS2Vec. The model is able to achieve an improvement of 12% in F1-Score and constantly a higher value in the AUC-ROC and AUC-PR. Its visual analysis also confirms that it can identify the small-time drifts, sensor failures, and multi-variables anomalies. The findings highlight self-supervised learning as a label-efficient and scalable solution capable of delivering robust real-time anomaly detection in smart-grid environments.when used to detect real time anomalies in modern smart grid systems.},
 author = {Reddem Yaswanthreddy and R. Nidhya and Penjuri Deekshitha and Faizan Syed and KV Dheeraj Kumar and Lokesh Nakkinti},
 doi = {https://doi.org/10.1016/j.fraope.2026.100583},
 issn = {2773-1863},
 journal = {Franklin Open},
 keyword = {Self-supervised learning, Anomaly detection, Smart grids, Multivariate time series, Contrastive learning},
 pages = {100583},
 title = {Self-Supervised Learning for Anomaly Detection in Multivariate Time Series from Smart Grids},
 url = {https://www.sciencedirect.com/science/article/pii/S277318632600099X},
 year = {2026}
}
