@article{10.1145/3630001,
 abstract = {In this article, we present Kinetic Transport Solver for Radiation Therapy (KiT-RT), an open source C++-based framework for solving kinetic equations in therapy applications available at&nbsp;. This software framework aims to provide a collection of classical deterministic solvers for unstructured meshes that allow for easy extendability. Therefore, KiT-RT is a convenient base to test new numerical methods in various applications and compare them against conventional solvers. The implementation includes spherical harmonics, minimal entropy, neural minimal entropy, and discrete ordinates methods. Solution characteristics and efficiency are presented through several test cases ranging from radiation transport to electron radiation therapy. Due to the variety of included numerical methods and easy extendability, the presented open source code is attractive for both developers, who want a basis to build their numerical solvers, and users or application engineers, who want to gain experimental insights without directly interfering with the codebase.},
 address = {New York, NY, USA},
 articleno = {38},
 author = {Kusch, Jonas and Schotth\"{o}fer, Steffen and Stammer, Pia and Wolters, Jannick and Xiao, Tianbai},
 doi = {10.1145/3630001},
 issn = {0098-3500},
 issue_date = {December 2023},
 journal = {ACM Trans. Math. Softw.},
 keyword = {Kinetic theory, radiation transport, radiation therapy, finite volume methods, machine learning},
 month = {December},
 number = {4},
 numpages = {24},
 publisher = {Association for Computing Machinery},
 title = {KiT-RT: An Extendable Framework for Radiative Transfer and Therapy},
 url = {https://doi.org/10.1145/3630001},
 volume = {49},
 year = {2023}
}
