@article{ZHANG2026119860,
 abstract = {The blast furnace ironmaking process exhibits periodicity, complex dynamics, and strong coupling, making it challenging to accurately model spatiotemporal evolution and identify gas flow states. To address the issues, this paper proposes an unsupervised detection framework that integrates spatiotemporal evolution with multiperiod collaborative analysis. Firstly, since strong variable coupling can degrade detection accuracy, a joint detection method combining enhanced cross-correlation analysis and periodogram estimation is proposed to accurately capture spatiotemporal synchronization. Secondly, to enhance feature robustness and model long-range dependencies, a dual-channel, multi-branch, two-stage pretraining network is designed by combining convolutional neural networks with multi-kernel maximum mean discrepancy. Then, a novel bidirectional cross-attention mechanism is further introduced to deeply fuse heterogeneous time-frequency features. Finally, an enhanced deep embedded clustering model merging spatiotemporal period detection and feature fusion is developed. It utilizes K-means++ initialization and a joint optimization strategy to achieve efficient coordination between feature encoding and cluster updating. Experimental results on real BF industrial data verify the proposed framework’s superior performance in both detection accuracy and application robustness.},
 author = {Yaxian Zhang and Kai Guo and Zejun Yu and Sen Zhang and Yongliang Yang and Wendong Xiao and Zhengguo Li},
 doi = {https://doi.org/10.1016/j.measurement.2025.119860},
 issn = {0263-2241},
 journal = {Measurement},
 keyword = {Blast furnace gas flow, Spatiotemporal analysis, Industrial soft sensor, Periodic detection, Feature fusion, Process monitoring},
 pages = {119860},
 title = {Deep representation and unsupervised classification of blast furnace gas flow states based on spatiotemporal variables and multiperiod synergistic analysis},
 url = {https://www.sciencedirect.com/science/article/pii/S0263224125032191},
 volume = {260},
 year = {2026}
}
