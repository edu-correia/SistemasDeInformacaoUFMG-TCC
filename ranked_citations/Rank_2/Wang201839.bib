@conference{Wang201839,
 abstract = {Network Function Virtualization (NFV) is an emerging technology to implement network functions in software, which reduces equipment costs (CAPEX) and operational cost (OPEX) through decoupling network functions from network dedicated devices and deploying them on high-volume standard servers and running as virtual instances. However, due to running in a shared and open environment and lacking the protection of proprietary hardware, virtual network functions (VNFs) face more security threats than traditional network functions. Hence, it is crucial to build a trusted execution environment to protect VNFs. In this paper, we first analyze the challenges for VNF security protection. We then propose a lightweight and trusted execution environment for securing VNFs based on SGX and Click. To demonstrate the feasibility of our approach, we implement a DDoS defense function on top of our environment and conduct paramilitary evaluations. Our evaluation results show that our system only introduces manageable performance overhead for protecting VNFs. © 2018 Association for Computing Machinery.},
 author = {Wang, Juan and Fan, Chengyang and Hao, Shirong and Wang, Jie and Li, Yi and Han, Lin and Hong, Zhi and Hu, Hongxin},
 doi = {10.1145/3180465.3180476},
 journal = {SDN-NFVSec 2018 - Proceedings of the 2018 ACM International Workshop on Security in Software Defined Networks and Network Function Virtualization, Co-located with CODASPY 2018},
 note = {Cited by: 16},
 pages = {39 - 42},
 publication_stage = {Final},
 source = {Scopus},
 title = {Challenges towards protecting VNF with SGX},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85052025427?origin=resultslist},
 volume = {2018-January},
 year = {2018}
}
