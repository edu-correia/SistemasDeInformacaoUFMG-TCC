@article{JI2026108432,
 abstract = {The accurate automatic segmentation of medical images is of great significance in clinical diagnosis and analysis. Convolutional neural networks (CNNs) excel at capturing local details but tend to overlook global context. In contrast to CNNs, the Vision Transformer has focused on handling global information. Currently, the main challenge in the field of medical image segmentation is how to simultaneously capture local details and model global contextual semantics. Recent works have attempted to extend broader semantic elements based on convolution during the decoder stage, but they struggle to match the Vision Transformer, leading to suboptimal results. In this paper, we propose a new method to address this issue through an innovative decoder that consists of a series of well-designed Channel-Selective Deformable Large Kernel Attention blocks (CSDLKA) for local representation learning and Clustering Attention blocks(CA) for global relation enhancement. Specifically, CSDLKA employs deformable large kernel attention and channel attention, which can adaptively explore relevant spatial and channel information under a broader receptive field to ensure the highlighting of details while minimizing background. Additionally, we use clustering attention with linear complexity to model the most useful long-range dependencies, enhancing large kernel attention for better merging of local and global features without significantly increase in complexity. Our extensive experiments conducted on four widely used datasets demonstrate the superiority of our approach over state-of-the-art methods. Code is available at https://github.com/MinxinNie/LKCA-Net.},
 author = {Zexuan Ji and Minxin Nie},
 doi = {https://doi.org/10.1016/j.bspc.2025.108432},
 issn = {1746-8094},
 journal = {Biomedical Signal Processing and Control},
 keyword = {Large kernel attention, Clustering attention, Medical image segmentation},
 pages = {108432},
 title = {LKCA-Net: Hybrid large kernel and clustering attention network for medical image segmentation},
 url = {https://www.sciencedirect.com/science/article/pii/S1746809425009437},
 volume = {112},
 year = {2026}
}
