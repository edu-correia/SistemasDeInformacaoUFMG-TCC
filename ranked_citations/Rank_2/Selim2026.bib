 publication_stage = {Final},
 source = {Scopus},
 title = {Limiting the Number of Possible CFG Derivative Trees During Grammar Induction with Catalan Numbers},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105031174549?origin=resultslist},
