@article{10.14778/3494124.3494141,
 abstract = {The recently released persistent memory (PM) offers high performance, persistence, and is cheaper than DRAM. This opens up new possibilities for indexes that operate and persist data directly on the memory bus. Recent learned indexes exploit data distribution and have shown great potential for some workloads. However, none support persistence or instant recovery, and existing PM-based indexes typically evolve B+-trees without considering learned indexes.This paper proposes APEX, a new PM-optimized learned index that offers high performance, persistence, concurrency, and instant recovery. APEX is based on ALEX, a state-of-the-art updatable learned index, to combine and adapt the best of past PM optimizations and learned indexes, allowing it to reduce PM accesses while still exploiting machine learning. Our evaluation on Intel DCPMM shows that APEX can perform up to ~15\texttimes{} better than existing PM indexes and can recover from failures in ~42ms.},
 author = {Lu, Baotong and Ding, Jialin and Lo, Eric and Minhas, Umar Farooq and Wang, Tianzheng},
 doi = {10.14778/3494124.3494141},
 issn = {2150-8097},
 issue_date = {November 2021},
 journal = {Proc. VLDB Endow.},
 month = {November},
 number = {3},
 numpages = {14},
 pages = {597–610},
 publisher = {VLDB Endowment},
 title = {APEX: a high-performance learned index on persistent memory},
 url = {https://doi.org/10.14778/3494124.3494141},
 volume = {15},
 year = {2021}
}
