@inproceedings{8275997,
 abstract = {Nowadays where a regularly expanding number of data is made in different structures, stored and transmitted, online security is the most vital factor. Different ways such as Cryptography, Steganography and Digital Watermarking are used to protect the data. The proposed framework gives additional layer of security as Cryptography and Steganography have been joined. Here data gets encrypted using Encryption Algorithm. Then the encrypted data is embedded into a system's Default image using LSB Algorithm. Steganographed Default image is then partitioned into uniform parts and gets merged into reverse sequence using Uniform Split and Merge Technique. Reverse Steganographed Default image is then hidden into another image. The proposed framework has summarized the goal to be security factors.},
 author = {Tambe, Sayli and Naik, Dattaram and Parab, Vaibhav and Doiphode, Siddhesh},
 booktitle = {2017 International Conference on Innovations in Information, Embedded and Communication Systems (ICIIECS)},
 doi = {10.1109/ICIIECS.2017.8275997},
 issn = {},
 keyword = {Image coding;Encryption;Image segmentation;Histograms;Merging;AES;LSB;SHA-256;Uniform Split and Merge Technique;Steganography},
 month = {March},
 number = {},
 pages = {1-6},
 title = {Image steganography using uniform split and merge technique},
 volume = {},
 year = {2017}
}
