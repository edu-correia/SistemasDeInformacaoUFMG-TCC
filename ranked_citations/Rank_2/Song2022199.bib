@article{Song2022199,
 abstract = {The development of social networking services (SNSs) revealed a surge in image sharing. The sharing mode of multi-page photo collage (MPC), which posts several image collages at a time, can often be observed on many social network platforms, which enables uploading images and arrangement in a logical order. This study focuses on the construction of MPC for an image collection and its formulation as an issue of joint optimization, which involves not only the arrangement in a single collage but also the arrangement among different collages. Novel balance-aware measurements, which merge graphic features and psychological achievements, are introduced. Non-dominated sorting genetic algorithm is adopted to optimize the MPC guided by the measurements. Experiments demonstrate that the proposed method can lead to diverse, visually pleasant, and logically clear MPC results, which are comparable to manually designed MPC results. [Figure not available: see fulltext.] © 2021, The Author(s).},
 author = {Song, Yu and Tang, Fan and Dong, Weiming and Xu, Changsheng},
 doi = {10.1007/s41095-021-0221-0},
 journal = {Computational Visual Media},
 note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access},
 number = {2},
 pages = {199 - 212},
 publication_stage = {Final},
 source = {Scopus},
 title = {Non-dominated sorting based multi-page photo collage},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85120727184?origin=resultslist},
 volume = {8},
 year = {2022}
}
