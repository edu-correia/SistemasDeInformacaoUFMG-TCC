@inproceedings{1469407,
 abstract = {A 1.5 V, 512 Mbit DDR3 synchronous DRAM prototype with 1.6 Gbps/pin was designed in 80nm technology. Output drivers are merged with ODT and are armed with SCR type ESD protection, rendering C/sub 10/ minimization for the enhanced signal integrity in point-to-2points interfacing. Hybrid latency control scheme is proposed to achieve higher bandwidth as well as to efficiently turn DLL on and off. Temperature readout and per-bank-refresh is also implemented.},
 author = {Churoo Park and HoeJu Chung and Yun-Sang Lee and Jae-Kwan Kim and Jae-Jun Lee and Moo-Sung Chae and Dae-Hee Jung and Sung-Ho Choi and Seung-young Seo and Taek-Seon Park and Jun-Ho Shin and Jin-Hyung Cho and Seunghoon Lee and Kyu-hyoun Kim and Jung-Bae Lee and Changhyun Kim and Soo-In Cho},
 booktitle = {Digest of Technical Papers. 2005 Symposium on VLSI Circuits, 2005.},
 doi = {10.1109/VLSIC.2005.1469407},
 issn = {2158-5636},
 keyword = {SDRAM;Prototypes;Delay;Bandwidth;Clocks;Temperature control;Voltage control;Calibration;Control systems;Automata},
 month = {June},
 number = {},
 pages = {370-373},
 title = {A 512 Mbit, 1.6 Gbps/pin DDR3 SDRAM prototype with C/sub 10/ minimization and self-calibration techniques},
 volume = {},
 year = {2005}
}
