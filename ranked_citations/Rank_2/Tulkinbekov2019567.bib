@conference{Tulkinbekov2019567,
 abstract = {This paper proposes a coalesced key-value pairs generation technique for CLeveldb. The proposed method employs an additional buffer cache and Upper Meta file which increases write performance of CLeveldb by merging multiple small data into a larger chunk and provides consistency by logging each transaction in Upper Meta file. The preliminary experimental results show that, the proposed method improves the writing performance of small data by 6 times as compared with Leveldb as input key-value item size becomes smaller. © 2019 IEEE.},
 author = {Tulkinbekov, Khikmatullo and Pirahandeh, Mehdi and Kim, Deok-Hwan},
 doi = {10.1109/ICUFN.2019.8806187},
 journal = {International Conference on Ubiquitous and Future Networks, ICUFN},
 note = {Cited by: 11},
 pages = {567 - 569},
 publication_stage = {Final},
 source = {Scopus},
 title = {CLeveldb: Coalesced Leveldb for Small Data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85071855950?origin=resultslist},
 volume = {2019-July},
 year = {2019}
}
