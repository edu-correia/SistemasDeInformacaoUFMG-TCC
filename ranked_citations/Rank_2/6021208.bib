@inproceedings{6021208,
 abstract = {To obtain 3D map including depth information, is one of the key theory and technology in machine vision field. We focused on structured light spatial encoding method, because for 3D information acquisition of the tested object, only one image is needed to be captured by camera by this method, so it has some advantages such as high resolution, easy implementation and fast measurement. A kind of new method of color stripes permutation encoding is adopted to measure the large object surface. The pattern is projected to the tested object by a digital projector. The 3D coordinates of the object can be obtained by decoding and calculating the parameters from the color image captured. In order to measure the whole objects, objects are be measured from different angles or different regions. Two images merge using marked circle technology and the least square principle. The results of experiments show that, the methods of 3D measurement and merge that used in this paper are feasible.},
 author = {Yuan Hui Juan and Liu Chun Qiu and Yu Jia and Yang Ling and Yin Shuang},
 booktitle = {Proceedings of 2011 6th International Forum on Strategic Technology},
 doi = {10.1109/IFOST.2011.6021208},
 issn = {},
 keyword = {Image color analysis;Three dimensional displays;Cameras;Encoding;Magnetic field measurement;Coordinate measuring machines;Periodic structures;3D measurement;3D merge;least square principle;color encoding},
 month = {Aug},
 number = {},
 pages = {1082-1085},
 title = {Study on 3D measurement and merge technology based on color stripes permutation encoding},
 volume = {2},
 year = {2011}
}
