@article{CHINNASAMY2026109711,
 abstract = {Early and accurate detection of brain tumors is vital for effective treatment planning. Due to the shapes, sizes, and locations of tumors, current techniques face certain challenges, such as variability in tumor characteristics, computational inefficiency, and overfitting issues. To improve the detection and classification of brain tumors, the Stacked Snake Cross Transformer-based Capsule AlexNet model is proposed. The method starts with preprocessing steps like contrast enhancement to improve image clarity, min–max normalization for intensity scaling, and homomorphic filtering to correct illumination variations. Rotation, flipping, and zooming are the data augmentation techniques used to decrease overfitting and increase dataset diversity. The integrated Stacked Snake Transformer and Cross Transformer Model is used for accurate tumor segmentation and captures local and global features. It also includes a merge layer that integrates multi-level representations to extract features. The extracted features are processed by a Capsule-based AlexNet, where AlexNet serves as the primary detection module and the capsule network performs multi-class classification. Evaluations on five publicly available Magnetic Resonance Imaging datasets demonstrate that the proposed model attains superior performance, with 98.7% accuracy, 97.5% precision, 97.3% sensitivity, and a Dice coefficient of 0.982, outperforming state-of-the-art methods. The results demonstrate that the proposed model improves diagnostic accuracy while remaining computationally efficient, supporting its potential for clinical use in brain tumor diagnosis.},
 author = {Shanthi Chinnasamy and Ganesan Sudalaimuthu and Perumal Pillai Raman},
 doi = {https://doi.org/10.1016/j.bspc.2026.109711},
 issn = {1746-8094},
 journal = {Biomedical Signal Processing and Control},
 keyword = {Alexnet, Brain tumor, Capsule network, Cross transformer model, Deep learning, Machine learning, Snake deformation model},
 pages = {109711},
 title = {Stacked snake cross transformer-based capsule AlexNet: Transformer-capsule hybrid for accurate brain tumor detection in magnetic resonance imaging},
 url = {https://www.sciencedirect.com/science/article/pii/S174680942600265X},
 volume = {119},
 year = {2026}
}
