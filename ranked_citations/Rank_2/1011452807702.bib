@article{10.1145/2807702,
 abstract = {Although custom (and reconfigurable) computing can provide orders-of-magnitude improvements in energy efficiency and performance for many numeric, data-parallel applications, performance on nonnumeric, sequential code is often worse than conventional superscalar processors. This work attempts to improve sequential performance in custom hardware by (a) switching from a statically scheduled to a dynamically scheduled (dataflow) execution model and (b) developing a new compiler IR for high-level synthesis—the value state flow graph (VSFG)—that enables aggressive exposition of ILP even in the presence of complex control flow. Compared to existing control-data flow graph (CDFG)-based IRs, the VSFG exposes more instruction-level parallelism from control-intensive sequential code by exploiting aggressive speculation, enabling control dependence analysis, as well as execution along multiple flows of control. This new IR is directly implemented as a static-dataflow graph in hardware by our prototype high-level synthesis tool chain and shows an average speedup of 1.13\texttimes{} over equivalent hardware generated using LegUp, an existing CDFG-based HLS tool. Furthermore, the VSFG allows us to further trade area and energy for performance through loop unrolling, increasing the average speedup to 1.55\texttimes{}, with a peak speedup of 4.05\texttimes{}. Our VSFG-based hardware approaches the sequential cycle counts of an Intel Nehalem Core i7 processor while consuming only 0.25\texttimes{} the energy of an in-order Altera Nios IIf processor.},
 address = {New York, NY, USA},
 articleno = {14},
 author = {Zaidi, Ali Mustafa and Greaves, David},
 doi = {10.1145/2807702},
 issn = {1936-7406},
 issue_date = {February 2016},
 journal = {ACM Trans. Reconfigurable Technol. Syst.},
 keyword = {Dark silicon, amdahl’s law, compilers, custom computing, high-level synthesis, instruction level parallelism, reconfigurable computing},
 month = {December},
 number = {2},
 numpages = {22},
 publisher = {Association for Computing Machinery},
 title = {Value State Flow Graph: A Dataflow Compiler IR for Accelerating Control-Intensive Code in Spatial Hardware},
 url = {https://doi.org/10.1145/2807702},
 volume = {9},
 year = {2015}
}
