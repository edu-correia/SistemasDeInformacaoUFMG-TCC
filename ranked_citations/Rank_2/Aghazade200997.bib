@article{Aghazade200997,
 abstract = {Metasearch engines submit the user query to several underlying search engines and then merge their retrieved results to generate a single list that is more effective to the users' information needs. According to the idea behind metasearch engines, it seems that merging the results retrieved from different retrieval models will improve the search coverage and precision. In this study, we have investigated the effect of fusion of different retrieval techniques on the performance of Persian retrieval. We use an extension of Ordered Weighted Average (OWA) operator called IOWA and a weighting schema, NOWA for merging the results. Our experimental results show that merging by OWA operators produces better MAP. © 2009 Springer Berlin Heidelberg.},
 author = {Aghazade, Zahra and Dehghani, Nazanin and Farzinvash, Leili and Rahimi, Razieh and Aleahmad, Abolfazl and Amiri, Hadi and Oroumchian, Farhad},
 doi = {10.1007/978-3-642-04447-2_11},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1; All Open Access; Green Open Access},
 pages = {97 - 104},
 publication_stage = {Final},
 source = {Scopus},
 title = {Fusion of retrieval models at CLEF 2008 Ad hoc persian track},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/70549110206?origin=resultslist},
 volume = {5706 LNCS},
 year = {2009}
}
