@conference{Chernov2019138,
 abstract = {Intelligent decision support tools using distributed dynamic description logic are proposed. Decision-making methods under uncertainty and semistructured input data are considered. Intelligent decision support in complex computing infrastructures is considered. The formats of semistructured data suitable for decision-making are determined. A formal definition of a new type logic called distributed dynamic descriptive logic is given. The architecture and the general scheme of the proposed approach are determined based on the situational knowledge base with merge into distributed situational knowledge base. The decision support system has an inference mechanism and rules of evolution, and by means of the context switching service planning of the query situation makes decisions. Users of the distributed situational knowledge base can fulfill requests about the current situation of their knowledge base. The interval analog of the hierarchy analysis method for direct decision-making is used. © 2019 IEEE.},
 author = {Chernov, A.V. and Butakova, M.A. and Kartashov, O.O. and Alexandrov, A.A.},
 doi = {10.1109/SCM.2019.8903760},
 journal = {Proceedings of 2019 22nd International Conference on Soft Computing and Measurements, SCM 2019},
 note = {Cited by: 5},
 pages = {138 - 141},
 publication_stage = {Final},
 source = {Scopus},
 title = {Intelligent decision support by means of dynamic description logic},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85075930103?origin=resultslist},
 year = {2019}
}
