@inproceedings{7805536,
 abstract = {In this paper, we propose HEVC encoder optimization for HDR video coding based on perceptual block merging. We perform perceptual block merging for HEVC Main 10 Profile-based HDR video coding. First, we generate 10bit luminance adaptation (LA) for quantized HDR videos based on Barten contrast sensitivity function (CSF) model. Then, we obtain a free-energy based just-noticeable-difference (FEJND) map in each frame to represent the disorderly concealment effect. Next, we calculate average FEJND values of each coding unit (CU) and the frame from the FEJND map to get the perceptual Lagrange multiplier for rate-distortion optimization (RDO). Finally, we achieve perceptual block merging by minimizing RD costs based on the perceptual Lagrange multiplier. Experimental results demonstrate that the proposed method produces the block merging results more correlated with human visual perception, while successfully improving the visual quality of the reconstructed HDR videos.},
 author = {Jung, Cheolkon and Lin, Qiaozhou and Yu, Shengtao},
 booktitle = {2016 Visual Communications and Image Processing (VCIP)},
 doi = {10.1109/VCIP.2016.7805536},
 issn = {},
 keyword = {Merging;Distortion;Optimization;Computational modeling;High efficiency video coding;Visualization;HEVC;Barten CSF model;block merging;high dynamic range;just-noticeable-difference;luminance adaptation;rate-distortion optimization},
 month = {Nov},
 number = {},
 pages = {1-4},
 title = {HEVC encoder optimization for HDR video coding based on perceptual block merging},
 volume = {},
 year = {2016}
}
