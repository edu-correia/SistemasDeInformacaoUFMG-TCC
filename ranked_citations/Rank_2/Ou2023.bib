@article{Ou2023,
 abstract = {Extracting circle information from images has always been a basic problem in computer vision. Common circle detection algorithms have some defects, such as poor noise resistance and slow computation speed. In this paper, we propose an anti-noise fast circle detection algorithm. In order to improve the anti-noise of the algorithm, we first perform curve thinning and connection on the image after edge extraction, then suppress noise interference by the irregularity of noise edges and extract circular arcs by directional filtering. In order to reduce the invalid fitting and speed up the running speed, we propose a circle fitting algorithm with five quadrants, and improve the efficiency of the algorithm by the idea of “divide and conquer”. We compare the algorithm with RCD, CACD, WANG and AS on two open datasets. The results show that we have the best performance under noise while keeping the speed of the algorithm. © 2023 by the authors.},
 author = {Ou, Yun and Deng, Honggui and Liu, Yang and Zhang, Zeyu and Lan, Xin},
 doi = {10.3390/s23052732},
 journal = {Sensors},
 note = {Cited by: 6; All Open Access; Gold Open Access; Green Open Access},
 number = {5},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Anti-Noise Fast Circle Detection Method Using Five-Quadrant Segmentation},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85149622145?origin=resultslist},
 volume = {23},
 year = {2023}
}
