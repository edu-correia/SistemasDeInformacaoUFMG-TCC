@conference{Walde2008496,
 abstract = {This paper presents an innovative, complex approach to semantic verb classification that relies on selectional preferences as verb properties. The probabilistic verb class model underlying the semantic classes is trained by a combination of the EM algorithm and the MDL principle, providing soft clusters with two dimensions (verb senses and subcategorisation frames with selectional preferences) as a result. A language-model-based evaluation shows that after 10 training iterations the verb class model results are above the baseline results. © 2008 Association for Computational Linguistics.},
 author = {Walde, Sabine Schulte Im and Hying, Christian and Scheible, Christian and Schmid, Helmut},
 journal = {ACL-08: HLT - 46th Annual Meeting of the Association for Computational Linguistics: Human Language Technologies, Proceedings of the Conference},
 note = {Cited by: 30},
 pages = {496 - 504},
 publication_stage = {Final},
 source = {Scopus},
 title = {Combining EM training and the MDL principle for an automatic verb classification incorporating selectional preferences},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84859909840?origin=resultslist},
 year = {2008}
}
