@inproceedings{5646253,
 abstract = {For the complexity of the algorithm for the merger of the regional boundary. A new algorithm — the Full λ Edge List Segmentation Algorithm(FELSA) is presented. Firstly, A new list — edge list in date structure of segmentation region is introduced to improve the boundaries of multi-partition approach, and the updates value of merger list in FLSA algorithm is re-defined. Thus, segmentation algorithm may select the best boundary for the merger according to the edge list. Furthermore, the adjacent part of the region is defined by edge list, so that a new edge can be retrieved more efficiently. The results show that this improved algorithm become more efficient and effective to the merger of image segmentation.},
 author = {Zhao Shan and Wang Shui},
 booktitle = {2010 Third International Symposium on Knowledge Acquisition and Modeling},
 doi = {10.1109/KAM.2010.5646253},
 issn = {},
 keyword = {Image segmentation;Image edge detection;Segmentation merging;Edge List;FELSA Date Structure},
 month = {Oct},
 number = {},
 pages = {221-224},
 title = {Fast merging algorithm for image segmentation based on date structure},
 volume = {},
 year = {2010}
}
