@conference{Dutta2025,
 abstract = {This article presents a novel, systematic methodology to optimize and accelerate the performance of the nuclear fusion energy application code PARTICLE-3D (P3D) on a high-performance computing (HPC) cluster. Unlike conventional performance optimization approaches, this work integrates a holistic refactorization strategy, leveraging advanced profiling techniques, modern compiler selection and optimizations to enhance code portability, and an embarrassingly parallel computation topology to achieve significant performance gains. The study introduces a structured workflow for identifying computational bottlenecks, demonstrating how strategic code restructuring and granular I/O communication enhancements can dramatically improve execution efficiency. Additionally, this research provides a first-of-its-kind comparative evaluation of legacy and modern compiler performance impacts, revealing that transitioning from Lahey/Fujitsu Fortran 95 2004 compiler to modern Intel IFORT compiler yields unprecedented computational acceleration. This pragmatic, easy-to-implement methodology serves as a blueprint for early-career researchers and HPC code developers, offering a generalizable optimization framework applicable to a wide range of computational science applications characterized by similar algorithmic topologies.  © 2025 Bharati Vidyapeeth, New Delhi.},
 author = {Dutta, Someswar and Aggarwal, Deepak and Raju, Daniel},
 doi = {10.23919/INDIACom66777.2025.11115567},
 journal = {Proceedings of the 2025 12th International Conference on Computing for Sustainable Global Development, INDIACom 2025},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Practical Pedagogical Approach to Optimize a Complex Nuclear Fusion Application Code PARTICLE-3D on HPC},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105016200090?origin=resultslist},
 year = {2025}
