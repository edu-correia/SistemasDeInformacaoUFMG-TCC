@inproceedings{6627825,
 abstract = {In this work Optical Coherence Tomography (OCT) retinal images are automatically processed to detect the presence of cysts. The methodology is composed by three phases: region of interest where cysts will be searched is delimited; a watershed algorithm is applied to find all the possible regions in the image which might conform cystic structures; finally, texture analysis is performed in each region from previous phase to final classification. Results show that accuracy achieved with this method is over 80%.},
 author = {González, A. and Remeseiro, B. and Ortega, M. and Penedo, M. G. and Charlón, P.},
 booktitle = {Proceedings of the 26th IEEE International Symposium on Computer-Based Medical Systems},
 doi = {10.1109/CBMS.2013.6627825},
 issn = {1063-7125},
 keyword = {Retina;Accuracy;Image segmentation;Support vector machines;Optical imaging;Coherence;Tomography},
 month = {June},
 number = {},
 pages = {397-400},
 title = {Automatic cyst detection in OCT retinal images combining region flooding and texture analysis},
 volume = {},
 year = {2013}
}
