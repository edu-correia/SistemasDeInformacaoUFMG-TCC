@conference{Han2020,
 abstract = {Modern advanced storage devices, such as modern NVMe SSD and non-volatile memory based persistent memory (PM), provide different access features when data size varies. Existing key-value stores adopt unified IO path for all key-value items, which cannot fully exploit the advantages of different advanced storage devices. In this paper, we propose to split IO paths for different sized key-value items. We let small key-value items be written directly to PM and then migrated to SSD. Meanwhile, large key-value items are directly written to SSD. We present and discuss design choices towards challenging issues of splitting IO paths. We build SplitKV, a key-value store prototype to show the benefits of splitting IO paths. The preliminary results show SplitKV outperforms RocksDB, KVell, and NoveLSM under small-large KV mixed workloads. © HotStorage 2020 - 12th USENIX Workshop on Hot Topics in Storage and File Systems, co-located with USENIX ATC 2020. All rights reserved.},
 author = {Han, Shukai and Jiang, Dejun and Xiong, Jin},
 journal = {HotStorage 2020 - 12th USENIX Workshop on Hot Topics in Storage and File Systems, co-located with USENIX ATC 2020},
 note = {Cited by: 9},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {SplitKV: Splitting IO paths for different sized key-value items with advanced storage devices},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85091849364?origin=resultslist},
 year = {2020}
}
