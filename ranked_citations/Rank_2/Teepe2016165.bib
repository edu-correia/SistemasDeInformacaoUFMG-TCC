 abstract = {The Internet of Things (IoT) is expected to be the next big application for microelectronics. The first main application, which drove the CMOS semiconductor technology forward, was the computer in the years 1970s and the 1980s. Then the phone and the network technology took over the leadership and driver role. The last two decades have been largely dominated by the mobile Internet. Today, a new driver is emerging and it looks like the next decade will be dominated by the connection of "things". The merge of intelligent industrial control (Industry 4.0), production and home robotics, individual, implantable medical electronics and the Internet connection technology will lead us into a new phase in microelectronics marked by extremely low power and small chip sizes. For this purpose, a new generation of semiconductor technology is required to cope with these requirements. Developed in Europe, the Fully-Depleted SOI technology (FD-SOI) offers new possibilities in IoT-related circuit design including extremely low supply voltages, such as 0.4 volts, and body bias control for even further reductions in power dissipation. GLOBALFOUNDRIES offers FDSOI with its 22FDX 22nmtechnology, which will be manufactured in its plant in Dresden, Germany.},
 author = {Teepe, Gerd},
 journal = {Smart Systems Integration 2016 - International Conference and Exhibition on Integration Issues of Miniaturized Systems, SSI 2016},
 note = {Cited by: 0},
 pages = {165 - 172},
 publication_stage = {Final},
 source = {Scopus},
 title = {New Circuit Technologies for the "Internet of Things" based on FD-SOI},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84976287015?origin=resultslist},
 year = {2016}
