@inproceedings{7877791,
 abstract = {Cardiac tractography consists in generating fiber paths for representing and visualizing cardiac fiber architecture. In this process, a large redundant number of fiber paths are usually generated in order to cover the whole myocardium. However, it is difficult to render and visualize dense fibers, and this poses problems for further qualitative and quantitative analysis of cardiac fiber structure. We propose a sparse cardiac fiber structure representation to highlight the main cardiac architecture and perform effective visualization and quantitative analysis. To this end, a fiber oriented approach, called fiber merging, is developed that allows us to obtain simplified cardiac fiber architecture. Fiber merging is achieved by averaging and connecting fiber segments according to a cell grid. Experiments on real cardiac data show that the produced simplified fiber architecture can highlight the cardiac fiber configuration.},
 author = {Li, Hongying and Robini, Marc and Yang, Feng and Zhu, Yuemin},
 booktitle = {2016 IEEE 13th International Conference on Signal Processing (ICSP)},
 doi = {10.1109/ICSP.2016.7877791},
 issn = {2164-5221},
 keyword = {Computer architecture;Merging;Microprocessors;Diffusion tensor imaging;Statistical analysis;Heart;Data visualization;Magnetic resonance imaging (MRI);diffusion-tensor imaging (DTI);fiber tracking;cardiac fiber architecture},
 month = {Nov},
 number = {},
 pages = {35-38},
 title = {Towards a simplified cardiac fiber architecture — Multiscale fiber merging},
 volume = {},
 year = {2016}
}
