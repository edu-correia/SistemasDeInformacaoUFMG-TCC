@inproceedings{5562132,
 abstract = {In this paper, radiation properties and impedance characteristics of lithographically patterned SU-8 structures are discussed. X-ray lithography fabrication process and excitation method of SU-8 resonator antennas are reviewed. Wide band operation is examined by merging the resonances of the SU-8 resonator antenna and an aperture antenna. Reflection coefficient measurement of fabricated antennas is provided. The effects of SU-8 loss tangent and substrate permittivity on antenna gain and efficiency are addressed.},
 author = {Rashidian, A. and Klymyshyn, D. M. and Aligodarz, M. Tayfeh and Boerner, M. and Mohr, J.},
 booktitle = {2010 IEEE Antennas and Propagation Society International Symposium},
 doi = {10.1109/APS.2010.5562132},
 issn = {1947-1491},
 keyword = {Antenna measurements;Microwave antennas;Apertures;Permittivity;Fabrication;Optical waveguides},
 month = {July},
