@inproceedings{10429552,
 abstract = {Addressing the challenges and substantial maintenance expenses associated with detecting defects in power equipment families during grid operations, this study introduces a novel method for identifying these defects. This method leverages a multidimensional approach to data fusion. Initially, it involves processing various sources of data and constructing a recursive graph based on structured time series data. This step helps in aligning both structured and unstructured data within a uniform descriptive framework. Subsequently, the method involves extracting features from the recursive graph and existing image data by utilizing a convolutional neural network, resulting in distinct feature vectors. These vectors are then intelligently combined and merged using adaptive weighting. This technique focuses on defect detection in power equipment families, enabling enhanced perception of the state of the equipment through the integrated analysis of multi-modal data features.},
 author = {Xu, Huifang and Xu, Jiannan and Liu, Liqing and Ma, Zhenyuan and Yao, Chuang},
 booktitle = {2023 3rd International Conference on New Energy and Power Engineering (ICNEPE)},
 doi = {10.1109/ICNEPE60694.2023.10429552},
 issn = {},
 keyword = {Power engineering;Splicing;Time series analysis;Data integration;Feature extraction;Convolutional neural networks;Data mining;multi-source data;feature level fusion;family defects detection},
 month = {Nov},
 number = {},
 pages = {332-336},
 title = {Family Defects Detection Method of Power Equipment Based on Data Fusion},
 volume = {},
 year = {2023}
}
