@inproceedings{4626841,
 abstract = {Domain analysis involves not only looking at standard requirements documents (e.g., use case specifications) but also at customer information packs, market analyses, etc. Looking across all these documents and deriving, in a practical and scalable way, a feature model that is comprised of coherent abstractions is a fundamental and non-trivial challenge. We conduct an exploratory study to investigate the suitability of Information Retrieval (IR) techniques for scalable identification of commonalities and variabilities in requirement specifications for software product lines. Accordingly, based on observations derived from industrial experience and on state-of-the-art research and practice, we also propose an initial framework, leveraging IR to systematically abstract requirements from existing specifications of a given domain into a feature model. We evaluate this framework, present a roadmap for its further extension, and formulate hypotheses to guide future work in exploring IR techniques for domain analysis.},
 author = {Alves, Vander and Schwanninger, Christa and Barbosa, Luciano and Rashid, Awais and Sawyer, Peter and Rayson, Paul and Pohl, Christoph and Rummler, Andreas},
 booktitle = {2008 12th International Software Product Line Conference},
 doi = {10.1109/SPLC.2008.18},
 issn = {},
 keyword = {Analytical models;Clustering algorithms;Merging;Software;Information retrieval;Portals;Marketing and sales;Domain Analysis;Information Retrieval;Software Product Lines},
 month = {Sep.},
 number = {},
 pages = {67-76},
 title = {An Exploratory Study of Information Retrieval Techniques in Domain Analysis},
 volume = {},
 year = {2008}
}
