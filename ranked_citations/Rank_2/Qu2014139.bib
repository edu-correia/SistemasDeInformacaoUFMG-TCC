@article{Qu2014139,
 abstract = {Migrating large-scale data sets (e.g. social graphs) from cluster to cluster and meanwhile providing high system uptime is a challenge task. It requires fast bulk import speed. We address this problem by introducing our “Demand-driven Bulk Loading” scheme based on the data/query distributions tracked from Facebook’s social graphs. A clientside coordinator and a hybrid store which consists of both MySQL and HBase engines work together to deliver fast availability to small, “hot” data in MySQL and incremental availability to massive, “cold” data in HBase on demand. The experimental results show that our approach enables the fastest system’s starting time while guaranteeing high query throughputs. © Springer International Publishing Switzerland 2014.},
 author = {Qu, Weiping and Dessloch, Stefan},
 doi = {10.1007/978-3-319-10933-6_11},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 1},
 pages = {139 - 152},
 publication_stage = {Final},
 source = {Scopus},
 title = {A demand-driven bulk loading scheme for large-scale social graphs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84921825449?origin=resultslist},
 volume = {8716},
 year = {2014}
}
