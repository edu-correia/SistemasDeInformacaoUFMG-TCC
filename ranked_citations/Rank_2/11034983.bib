@article{11034983,
 abstract = {To facilitate the integration of the NIST-standardized post-quantum cryptographic (PQC) algorithm, Module Lattice-based Key Encapsulation Mechanism (ML-KEM), into quantum-resistant devices and cryptosystems, this study introduces an area-time efficient hardware implementation. We propose several key optimizations: a dedicated SHA3 design merging hashing and sampling to eliminate hash output storage, a high-performance polynomial arithmetic unit with a novel reuse technique that reduces twiddle factor storage by threefold, and a partitioned storage strategy to minimize memory footprint. By tightly coupling pipelining and parallelism, we further enhance execution speed and avoid memory access bottlenecks. Our FPGA-based ML-KEM implementation achieves a superior area-time product (ATP), outperforming state-of-the-art results by up to  $6.7\times $  across NIST security levels 1, 3, and 5. A 180 nm CMOS fabrication of our design yields a die area of 1, $940\times 1.789~\mu $ m2. Measured performance shows the lowest SRAM requirement (7.37 kB) and minimal energy consumption ( $6.4~\mu $ J,  $10.3~\mu $ J, and  $14.4~\mu $ J for security levels 1, 3, and 5), leading to ATP improvements ranging from  $1.5\times $  to  $115.0\times $  compared to existing ASIC solutions.},
 author = {Nguyen, Trong-Hung and Dang, Tuan-Kiet and Dam, Duc-Thuan and Nguyen, Khai-Duy and Duong, Phuc-Phan and Pham, Cong-Kha and Hoang, Trong-Thuc},
 doi = {10.1109/ACCESS.2025.3579379},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {Hardware;Polynomials;Standards;Cryptography;Costs;Computer architecture;Arithmetic;Random access memory;NIST;Field programmable gate arrays;Post-quantum cryptography (PQC);module lattice-based key encapsulation mechanism (ML-KEM);FIPS 203;SHA3;CRYSTALS-Kyber;hardware architecture;FPGA;ASIC},
 month = {},
 number = {},
 pages = {103834-103847},
 title = {An Area-Time Efficient Hardware Architecture for ML-KEM Post-Quantum Cryptography Standard},
 volume = {13},
 year = {2025}
}
