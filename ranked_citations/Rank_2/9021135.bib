@inproceedings{9021135,
 abstract = {In recent years, there often exist multiple priors from experienced experts or historical experiments with the rapid development of system structure in engineering fields. Bayesian Melding Method is commonly used for integrating multiple priors, which is based on the deterministic system structure. However, if the system model cannot be described by an explicit expression, the traditional Bayesian Melding Method is not feasible for system reliability analysis anymore. In order to describe the structure relationship clearly, Bayesian Network is applied in this paper to construct the complex system structure model and the system reliability is calculated by node probability tables rather than explicit expressions. Combining the advantages of the Bayesian Melding Method and Bayesian Network, a multi-prior integration and updating algorithm is developed for the system reliability analysis of complex system structures. Finally, a satellite attitude control system is used to demonstrate the proposed method. The system is established by the Bayesian Network and the comparison between natural prior and updated prior is discussed at length.},
 author = {Xu, Ying-Chun and Yao, Wen and Zheng, Xiao-Hu and Chen, Xiao-Qian},
 booktitle = {2019 International Conference on Quality, Reliability, Risk, Maintenance, and Safety Engineering (QR2MSE)},
 doi = {10.1109/QR2MSE46217.2019.9021135},
 issn = {},
 keyword = {Reliability;Bayes methods;Complex systems;Probability distribution;Analytical models;Merging;Computational modeling;Bayesian Melding Method;Bayesian Network;multiple priors;system reliability},
 month = {Aug},
 number = {},
 pages = {947-953},
 title = {Multi-Prior Integration Method for System Reliability Analysis Based on Bayesian Network and Bayesian Melding Method},
 volume = {},
 year = {2019}
}
