@article{10.1145/3578936,
 abstract = {With the in-depth development of intelligent media technology, online and offline fusion, reality and virtual entanglement, information content generalization, the boundary between positive and negative information is blurred, all kinds of misinformation in the social network fission spread, and cyberspace governance has become a global consensus. In this article, we comprehensively consider the spread of misinformation in location-based interpersonal social network and online social network, and systematically tackle the novel problem of minimizing the influence of misinformation under individual protection strategies. We first analyze the complexity and modularity of the problem. Then, we leverage the Lov\'{a}sz extension to devise a nonsubmodular set function continuity approximate convex relaxation method, and develop an approximate projected subgradient procedure to obtain a solution with a factor approximate guarantee. Finally, experiments on three assembled real-world datasets demonstrate the effectiveness and feasibility of our designed method and developed the algorithm.},
 address = {New York, NY, USA},
 articleno = {87},
 author = {Ni, Peikun and Zhu, Jianming and Wang, Guoqing},
 doi = {10.1145/3578936},
 issn = {1556-4681},
 issue_date = {July 2023},
 journal = {ACM Trans. Knowl. Discov. Data},
 keyword = {Misinformation, location-based social network, Lov\'{a}sz extension, individual protection},
 month = {March},
 number = {6},
 numpages = {25},
 publisher = {Association for Computing Machinery},
 title = {Misinformation Blocking Problem in Virtual and Real Interconversion Social Networks},
 url = {https://doi.org/10.1145/3578936},
 volume = {17},
 year = {2023}
}
