@article{Jeny202317613,
 abstract = {Recently, learned image compression algorithms have shown incredible performance compared to classic hand-crafted image codecs. Despite its considerable achievements, the fundamental disadvantage is not optimized for retaining local redundancies, particularly non-repetitive patterns, which have a detrimental influence on the reconstruction quality. This paper introduces the autoencoder-style network-based efficient image compression method, which contains three novel blocks, i.e., adjacent attention block, Gaussian merge block, and decoded image refinement block, to improve the overall image compression performance. The adjacent attention block allocates the additional bits required to capture spatial correlations (both vertical and horizontal) and effectively remove worthless information. The Gaussian merge block assists the rate-distortion optimization performance, while the decoded image refinement block improves the defects in low-resolution reconstructed images. A comprehensive ablation study analyzes and evaluates the qualitative and quantitative capabilities of the proposed model. Experimental results on two publicly available datasets reveal that our method outperforms the state-of-the-art methods on the KODAK dataset (by around 4dB and 5dB) and CLIC dataset (by about 4dB and 3dB) in terms of PSNR and MS-SSIM.  © 2013 IEEE.},
 author = {Jeny, Afsana Ahsan and Islam, Md Baharul and Junayed, Masum Shah and Das, Debashish},
 doi = {10.1109/ACCESS.2022.3195295},
 journal = {IEEE Access},
 note = {Cited by: 8; All Open Access; Gold Open Access; Green Open Access},
 pages = {17613 - 17625},
 publication_stage = {Final},
 source = {Scopus},
 title = {Improving Image Compression With Adjacent Attention and Refinement Block},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85135740646?origin=resultslist},
