@inproceedings{10578947,
 abstract = {Innovative defensive techniques are needed to address threats caused by Windows malware that are becoming more prevalent. This study presents a novel method for thwarting the complex web of cyberattacks by combining the powers of clustering, Random Forests (RF), and Support Vector Machines (SVM). Our fusion model performs remarkably well in the field of Windows malware security, with an accuracy of 98.67% and similarly F1 score of 98.68%. Our methodology transforms cybersecurity readiness by breaking down the complex patterns seen in malicious code, hence improving detection accuracy. This innovation highlights the possibilities found in the merging multiple analytical methods.},
 author = {Ramezani, Azita},
 booktitle = {2024 IEEE World AI IoT Congress (AIIoT)},
 doi = {10.1109/AIIoT61789.2024.10578947},
 issn = {},
 keyword = {Support vector machines;Radio frequency;Technological innovation;Accuracy;Merging;Transforms;Malware;fusion models;cyber threat defense;windows malware;clustering;random forests;support vector machines (SVM);accuracy;f1-score;cybersecurity;malicious code detection},
 month = {May},
 number = {},
 pages = {465-470},
 title = {Fusion Models for Cyber Threat Defense: Integrating Clustering with Kmeans, Random Forests, and SVM against Windows Malware},
 volume = {},
 year = {2024}
