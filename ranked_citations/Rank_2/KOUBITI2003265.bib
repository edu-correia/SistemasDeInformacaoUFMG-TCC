@article{KOUBITI2003265,
 abstract = {To diagnose recombining plasmas obtained under detachment conditions in axisymmetric divertor regions of tokamaks (fusion devices) like JET, a spectroscopic analysis method has been developed. The method is based on the modeling of entire deuterium emission spectra composed of high-n Balmer lines extending to or beyond the series limit. A numerical code has been constructed by coupling a Stark line shape code to both an analytical approach developed for the smooth merging of lines into the continuum and a collisional-radiative model for the deuterium atomic level populations. The code has been incorporated into a fitting procedure allowing the simultaneous determination of the electron density and temperature of JET detached plasmas from deuterium line and continuum spectra.},
 author = {M. Koubiti and S. Loch and H. Capes and L. Godbert-Mouret and Y. Marandet and A. Meigs and R. Stamm and H. Summers},
 doi = {https://doi.org/10.1016/S0022-4073(03)00079-7},
 issn = {0022-4073},
 journal = {Journal of Quantitative Spectroscopy and Radiative Transfer},
 keyword = {Line merging, Continuum, Stark broadening, Recombining plasmas, Plasma diagnostics, Tokamaks},
 note = {Radiative Properties of Hot Dense Matter},
 number = {1},
 pages = {265-273},
 title = {Smooth line merging into the continuum and Stark broadening of deuterium Balmer lines for plasma diagnostics},
 url = {https://www.sciencedirect.com/science/article/pii/S0022407303000797},
 volume = {81},
 year = {2003}
}
