@article{Liu2026,
 abstract = {This paper is concerned with the safe platooning of multiple connected automated vehicles on curved roads, ad dressing key challenges such as obstacle and collision avoidance, nonholonomic vehicle dynamics, and compensation for unknown time-varying flow fields. To achieve this, a joint path planning and platooning control approach is proposed to ensure smooth collision-free maneuvers along planned paths while adhering to safety constraints and overcoming the aforementioned challenges. First, a novel scaling-based path planning algorithm is introduced, leveraging obstacle information within an instantiated Gaussian model to re-plan safe paths and define robust safe regions, blue with seamless integration into the vehicle control system. Second, an adaptive nominal controller is developed to achieve precise longitudinal and lateral control objectives. Third, a safety-critical controller is formulated by incorporating control barrier functions into a minimally invasive quadratic programming framework. Finally, numerical experiments are conducted to validate the efficacy of the proposed approach. © 2026 IEEE.},
 author = {Liu, Tianrun and Ge, Xiaohua and Chen, Yang-Yang},
 doi = {10.1109/TVT.2026.3665236},
 journal = {IEEE Transactions on Vehicular Technology},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Article in press},
 source = {Scopus},
 title = {Path Planning and Platooning Control of Connected Automated Vehicles on Curved Roads},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105030447846?origin=resultslist},
 year = {2026}
}
