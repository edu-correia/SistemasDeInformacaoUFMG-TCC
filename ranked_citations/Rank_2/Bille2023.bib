@conference{Bille2023,
 abstract = {Given a string S over an alphabet Σ, the string indexing problem is to preprocess S to subsequently support efficient pattern matching queries, that is, given a pattern string P report all the occurrences of P in S. In this paper we study the streaming sliding window string indexing problem. Here the string S arrives as a stream, one character at a time, and the goal is to maintain an index of the last w characters, called the window, for a specified parameter w. At any point in time a pattern matching query for a pattern P may arrive, also streamed one character at a time, and all occurrences of P within the current window must be returned. The streaming sliding window string indexing problem naturally captures scenarios where we want to index the most recent data (i.e. the window) of a stream while supporting efficient pattern matching. © 2023 Schloss Dagstuhl- Leibniz-Zentrum fur Informatik GmbH, Dagstuhl Publishing. All rights reserved.},
 author = {Bille, Philip and Fischer, Johannes and Gørtz, Inge Li and Pedersen, Max Rishøj and Stordalen, Tord Joakim},
 doi = {10.4230/LIPIcs.CPM.2023.4},
 journal = {Leibniz International Proceedings in Informatics, LIPIcs},
 note = {Cited by: 0},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Sliding Window String Indexing in Streams},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85165589429?origin=resultslist},
 volume = {259},
 year = {2023}
}
