@inproceedings{11364682,
 abstract = {Accurate occupancy forecasting in buildings is the main solution for optimizing energy consumption and improving indoor comfort. This paper presents an approach for multi-room occupancy prediction using a Hidden Markov Model (HMM) under emission constraints, designed to capture both discrete spatial transitions between rooms and continuous temporal dynamics through the von Mises distribution. Unlike conventional HMMs, the proposed model enforces structured emission probabilities that remain invariant during training, ensuring interpretability and stability. Furthermore, an adaptive structural optimization algorithm is introduced to automatically determine the optimal number of hidden states, that model a specific observation by iteratively merging states based on temporal similarity and concentration criteria. Tests conducted on two simulated multi-room datasets demonstrate that this adaptive HMM achieves higher accuracy compared to fixed-state configurations.},
 author = {Kabbaj, Omar Abdelaaziz and Péan, Louis-Marie and Masson, Jean-Baptiste and Marhic, Bruno and Delahoche, Laurent},
 booktitle = {2025 IEEE 22nd International Conference on Sciences and Techniques of Automatic Control and Computer Engineering (STA)},
 doi = {10.1109/STA66620.2025.11364682},
 issn = {2573-539X},
 keyword = {Training;Adaptation models;Analytical models;Accuracy;Computational modeling;Merging;Hidden Markov models;Predictive models;Data models;Optimization;Hidden Markov Model (HMM);occupancy prediction;von Mises distribution;circular data;temporal modeling},
 month = {Dec},
 number = {},
 pages = {371-376},
 title = {Adaptive Constrained-Hidden Markov Model (C-HMM) for Multi-Room Occupancy Prediction},
 volume = {},
 year = {2025}
}
