@inproceedings{6112067,
 abstract = {In this paper we investigated how merging of MPEG-7 visual descriptors can improve accuracy of image classification systems. Combination of MPEG-7 Colour Layout Descriptor (CLD) and Edge Histogram Descriptor (EHD) was used to extract features for input into multiclass Support Vector Machine (SVM) classifier. SVM classifier was trained and evaluated on a standard test database of 1000 images classified into 10 categories. Achieved accuracy for merged descriptors has shown significant improvement compared to the results when CLD and EHD descriptors were used independently.},
 author = {Cvetković, Stevica S. and Nikolić, Saša V.},
 booktitle = {2011 10th International Conference on Telecommunication in Modern Satellite Cable and Broadcasting Services (TELSIKS)},
 doi = {10.1109/TELSKS.2011.6112067},
 issn = {},
 keyword = {Image color analysis;Image edge detection;Support vector machines;Transform coding;Feature extraction;Histograms;Image classification;Image classification;MPEG-7;Support Vector Machines (SVM)},
 month = {Oct},
 number = {},
 pages = {345-348},
 title = {Merged MPEG-7 visual descriptors for image classification},
 volume = {1},
 year = {2011}
}
