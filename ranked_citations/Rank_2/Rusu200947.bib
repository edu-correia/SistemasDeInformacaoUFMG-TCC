@article{Rusu200947,
 abstract = {Due to an explosive increase of XML documents, it is imperative to manage XML data in an XML data warehouse. XML warehousing imposes challenges, which are not found in the relational data warehouses. In this paper, we firstly present a framework to build an XML data warehouse schema. For the purpose of scalability due to the increase of data volume, we propose a number of partitioning techniques for multi-version XML data warehouses, including document based partitioning, schema based partitioning, and cascaded (mixed) partitioning model. Finally, we formulate cost models to evaluate various types of queries for an XML data warehouse. © 2009 Springer Science+Business Media, LLC.},
 author = {Rusu, Laura Irina and Rahayu, Wenny and Taniar, David},
 doi = {10.1007/s10619-009-7034-y},
 journal = {Distributed and Parallel Databases},
 note = {Cited by: 13},
 number = {1-2},
 pages = {47 - 69},
 publication_stage = {Final},
 source = {Scopus},
 title = {Partitioning methods for multi-version XML data warehouses},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/62249105152?origin=resultslist},
 volume = {25},
 year = {2009}
}
