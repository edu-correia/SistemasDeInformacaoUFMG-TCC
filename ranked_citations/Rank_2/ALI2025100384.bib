@article{ALI2025100384,
 abstract = {Pipeline leak detection must be both accurate and quick to ensure the operational integrity, safety, and sustainability of fluid transport systems. This work introduces an innovative integrated methodology that merges advanced acoustic signal analysis with geostatistical spatial modeling for efficient leak identification and localization. Under controlled leakage conditions, we collected acoustic emission signals and used the Maximal Overlap Discrete Wavelet Transform (MODWT) to remove noise and make the signals more distinct. The Time of Arrival (TOA) was precisely estimated by the Hilbert envelope of the denoised signals, a critical characteristic associated with leak-induced acoustic propagation. We then used both one-dimensional and two-dimensional (space-time) ordinary kriging to spatially interpolate TOA. Variogram modeling with exponential, spherical, Gaussian, and Matérn models was tested, and the Gaussian and spherical models performed the best in terms of RMSE. The kriging results assessed uncertainty with 95% confidence intervals and produced interpretable spatial maps of the leak's propagation. This hybrid acoustic-geostatistical technique provides a scalable and data-driven leak detection system, marking a significant step forward in the integration of signal processing and spatial modeling for pipeline integrity monitoring.},
 author = {Amjad Ali and Wang Xinhua and Ghulam Rasool and Shabir Ali and Izzat Razzaq},
 doi = {https://doi.org/10.1016/j.jpse.2025.100384},
 issn = {2667-1433},
 journal = {Journal of Pipeline Science and Engineering},
 keyword = {Acoustic Signals, Maximal Overlap Discrete Wavelet Transform (MODWT), Time of Arrival (TOA), Envelope, semi-variograms models, Kriging},
 pages = {100384},
 title = {Data-Driven Leakage Detection in Gas Pipelines through Wavelet Denoising and Variogram-Based Kriging},
 url = {https://www.sciencedirect.com/science/article/pii/S2667143325001313},
 year = {2025}
}
