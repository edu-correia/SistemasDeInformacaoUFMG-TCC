@inproceedings{11469792,
 abstract = {Algeria's strong solar potential makes it wellsuited for PV energy, but output variability from heat, dust, and fluctuating irradiance presents grid management challenges. This study proposes a hybrid forecasting model that merges detailed PV electrical modeling covering parameters like photocurrent $\left(I_{p h}\right)$, saturation current $\left(I_{0}\right)$, voltage, and current with an LSTM neural network. Using real data from a 1 MWp desert-based PV plant, the model incorporates both environmental and electrical factors. A rolling-window crossvalidation strategy ensures reliable evaluation. Results show that including electrical inputs significantly enhances forecasting accuracy compared to models using only environmental data. The hybrid model outperforms persistence and standalone LSTM benchmarks, achieving an RMSE of 0.102 kW, MAE of 0.082 kW, and an $\mathbf{R}^{2}$ of 0.93. With low computational demand, it's suitable for near real-time deployment on modern edge devices. Overall, the integration of physical system knowledge with data-driven learning boosts both accuracy and interpretability, making the approach wellsuited for short-term forecasting in high-irradiance desert environments.},
 author = {Saddaoui, Rafik and Aoughlis, Samir and Oudiai, Karim and Nachef, Mhenna and Hamiche, Hamid and Laghrouche, Mourad},
 booktitle = {2025 International Conference on Artificial Intelligence, Embedded Systems, and Renewable Energy (AIESRE)},
 doi = {10.1109/AIESRE67541.2025.11469792},
 issn = {},
 keyword = {Diodes;Circuits;Equivalent circuits;Voltage multipliers;Circuits and systems;Central Processing Unit;Contacts;Protocols;HTTP;Diodes;Photovoltaic power forecasting;long short-term memory (LSTM);PV electrical modeling;solar irradiance;model;time series prediction;Algerian solar conditions;smart grid integration;recurrent neural networks (RNN);renewable energy management;power system stability},
 month = {Dec},
 number = {},
 pages = {1-7},
 title = {A Hybrid Electrical and Environmental LSTM Approach for Short-Term Solar Power Forecasting in Algeria},
 volume = {},
