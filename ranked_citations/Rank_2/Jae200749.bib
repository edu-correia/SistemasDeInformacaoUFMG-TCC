@conference{Jae200749,
 abstract = {Conventional rigid router-based networks on chip incur certain overheads due to huge occupied logic resources and topology embedding, i.e., the mapping of a logical network topology to a physical one. In this paper, we present an implementation of partially reconfigurable point-to-point (ρ-P2P) interconnects in FPGA to overcome the mentioned overheads. In the presented implementation, arbitrary topologies are realized by changing the ρ-P2P interconnects. In our experiments, we considered parallel merge sort and Cannon's matrix multiplication to generate network traffic to evaluate our implementation. Furthermore, we have implemented a 2D-mesh packet switched network to serve as a reference to compare our results with. Our experiment shows that the utilization of on-demand ρ-P2P interconnects performs 2× better and occupies 70% less area compared to the reference mesh network. Furthermore, the reconfiguration latency is significantly reduced using the Xilinx module-based partial reconfiguration technique. Finally, our experiments suggest that higher performance gains can be achieved as the problem size increases. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Jae, Young Hur and Stephan, Wong and Vassiliadis, Stamatis},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 6},
 pages = {49 - 60},
 publication_stage = {Final},
 source = {Scopus},
 title = {Partially reconfigurable point-to-point interconnects in virtex-II pro FPGAs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/34548092967?origin=resultslist},
 volume = {4419 LNCS},
 year = {2007}
}
