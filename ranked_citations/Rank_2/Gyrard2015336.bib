@conference{Gyrard2015336,
 abstract = {Semantics is becoming a requirement in Internet of Things (IoT). Recent works underline future challenges for IoT: (1) integrate semantic web technologies, (2) provide interoperability, (3) interpret IoT data, (4) ease the development of IoT applications, and (5) fit to the different requirements of people and applications. In this paper, we design a semantic engine to meet these requirements and integrate it in different components available in IoT architectures. To the best of our knowledge, the main novelty of this paper is the semantic engine flexible enough for different IoT architectures where semantics is integrated in: (1) cloud, (2) devices such as smart phones or tablets, and (3) M2M gateways. As proof of concepts, we discuss deployment of the proposed semantic engine at cloud systems and mobile devices. Moreover, we show that such deployments are coherent with ETSI M2M and one M2M standardizations. © 2015 IEEE.},
 author = {Gyrard, Amelie and Datta, Soumya Kanti and Bonnet, Christian and Boudaoud, Karima},
 doi = {10.1109/IMIS.2015.83},
 journal = {Proceedings - 2015 9th International Conference on Innovative Mobile and Internet Services in Ubiquitous Computing, IMIS 2015},
 note = {Cited by: 28},
 pages = {336 - 341},
 publication_stage = {Final},
 source = {Scopus},
 title = {A Semantic Engine for Internet of Things: Cloud, Mobile Devices and Gateways},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84959258434?origin=resultslist},
 year = {2015}
}
