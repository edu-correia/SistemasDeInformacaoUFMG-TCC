@article{Bai2026253,
 abstract = {Large language models are increasingly deployed in multi-agent workflows. We introduce Prompt Choreography, a framework that efficiently executes LLM workflows by maintaining a dynamic, global KV cache. Each LLM call can attend to an arbitrary, reordered subset of previously encoded messages. Parallel calls are supported. Though caching messages’ encodings sometimes gives different results from re-encoding them in a new context, we show in diverse settings that fine-tuning the LLM to work with the cache can help it mimic the original results. Prompt Choreography significantly reduces per-message latency (2.0–6.2× faster time-to-first-token) and achieves substantial end-to-end speedups (>2.2×) in some workflows dominated by redundant computation. © 2026 Association for Computational Linguistics. This is an open-access article distributed under the terms of the https://creativecommons.org/licenses/by/4.0/, which permits unrestricted use, distribution, and reproduction in any medium, provided the original work is properly cited. For a full description of the license, please visit https://creativecommons.org/licenses/by/4.0/legalcode.},
 author = {Bai, TJ and Eisner, Jason},
 doi = {10.1162/TACL.a.643},
 journal = {Transactions of the Association for Computational Linguistics},
 note = {Cited by: 0; All Open Access; Gold Open Access},
 pages = {253 - 270},
 publication_stage = {Final},
 source = {Scopus},
 title = {Accelerating Language Model Workflows withPrompt Choreography},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/105037875119?origin=resultslist},
 volume = {14},
