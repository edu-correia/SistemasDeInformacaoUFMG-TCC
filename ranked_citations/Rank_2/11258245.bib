@inproceedings{11258245,
 abstract = {Knee osteoarthritis (KOA) is a progressive joint disease that significantly impacts quality of life and imposes a substantial healthcare burden. Early detection is crucial to improving clinical outcomes, yet traditional diagnostic methods often fall short in identifying early-stage KOA. This systematic review investigates the integration of artificial intelligence (AI), particularly deep learning and Minkowski-based feature extraction, for early KOA detection. We analyzed fifty peerreviewed studies published between 2021 and 2024, focusing on diagnostic models that leverage radiographic imaging (X-ray and MRI) and machine learning techniques. Convolutional Neural Networks (CNNs) and hybrid models incorporating classical classifiers such as SVM, KNN, and Random Forest emerged as dominant approaches, often demonstrating classification accuracies exceeding 97%. A key finding is the effectiveness of automated region-of-interest (ROI) segmentation techniques and feature engineering strategies using Minkowski metrics, which enhance diagnostic precision and model generalizability. Public datasets like the Osteoarthritis Initiative (OAI) and the Multicenter Osteoarthritis Study (MOST) were used alongside local and augmented datasets to address data imbalance. Despite high model performance, challenges persist in ROI definition, dataset heterogeneity, and limited clinical interpretability. The review also highlights the trend toward merging KL grades 0 and 1 to improve binary classification performance. Ultimately, this study synthesizes recent advancements, identifies limitations, and proposes future research directions for more interpretable, accurate, and clinically relevant AI systems in KOA diagnosis. These insights aim to guide clinicians, researchers, and developers in creating reliable AI-assisted diagnostic tools that align with clinical decision-making processes.},
 author = {Najim, Marwah Fadhil and Alrammahi, Atheer and Mahdi, Ahmed Mohsen},
 booktitle = {2025 3rd International Conference on Business Analytics for Technology and Security (ICBATS)},
 doi = {10.1109/ICBATS66542.2025.11258245},
 issn = {},
 keyword = {Knee Osteoarthritis (KOA);Deep Learning;Machine Learning;styling;Minkowski Metrics},
 month = {May},
