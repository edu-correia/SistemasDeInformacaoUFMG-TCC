@inproceedings{11209146,
 abstract = {Artificial Intelligence (AI) has unlocked doors to revolutionary potential in Human Resource Management (HRM), most importantly in employee performance appraisal and development. This study proposes an AI-driven appraisal and development system with a promise of fairness, transparency, and constructive criticism using the synergy of Machine Learning (ML), Natural Language Processing (NLP), and Explainable AI (XAI). On a larger IBM HR Analytics data set, the system is predicting performance ratings as continuous and as discretized levels (Low, Medium, High). The Gradient Boosting models gave high accuracy (F1-score: 0.86, RMSE: 0.47) and good scores on fair (parity differences ≤ 0.04 between groups). In addition, a transparency-oriented explain ability module and employee-centered training recommendation module were integrated. 120 post-deployment comments by employee recorded high satisfaction (4.3/5), fairness (4.5/5), and clarity of evaluation (4.6/5). The findings attest to the success of the system in building trust, improving decision-making, and facilitating strategic talent management.},
 author = {B, Jeyaprabha and Kayande, Ravindra Asharam and Suresh, P. and Karthick, R. and Kaliappan, S. and Prabakar, D.},
 booktitle = {2025 2nd International Conference on Computing and Data Science (ICCDS)},
 doi = {10.1109/ICCDS64403.2025.11209146},
 issn = {},
 keyword = {Training;Performance evaluation;Explainable AI;Merging;Decision making;Data science;Boosting;Natural language processing;Real-time systems;Appraisal;Human Resource Management;Machine Learning;Natural Language Processing and Gradient Boosting},
 month = {July},
 number = {},
 pages = {1-6},
 title = {AI-Driven Transparent Employee Performance Appraisal and Development Systems},
 volume = {},
