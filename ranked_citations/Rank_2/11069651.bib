@inproceedings{11069651,
 abstract = {Blur in images can occur due to low-quality cameras or as an intentional effect to emphasize movement or important objects. However, most blur classification models simply differentiate between blurred and sharp images, without distinguishing intentional blur from unintentional blur. Some unintentionally blurred images hold significant value and should not be dis- carded outright. This paper introduces a robust classifier that categorizes images into three types: sharp, intentional blur, and unintentional blur. The key idea behind distinguishing between intentional and unintentional blur is analyzing whether the blur affects a salient and semantically meaningful object. To achieve this, the approach integrates blur detection, saliency analysis, and semantic segmentation. The model utilizes spatial pyramid pooling to extract global features, followed by random forest classification. Additionally, Conditional Random Fields (CRF) are employed to identify unintentional blur pixels by incorporating multiple cues. The deblurred unintentional regions can then be merged back into the original image to reconstruct an intentionally blurred version. Experiments conducted on the UBICD dataset demonstrate the effectiveness of the proposed classification method and the potential of unintentional blur removal, achieving promising results.},
 author = {T M, Rajesh and Dhavalagimath, Shankramma S and Hugar, Amrutha and Vodnala, Ananya and Kamat, Divya Pandurang and Iram, Khursheed},
 booktitle = {2025 3rd International Conference on Inventive Computing and Informatics (ICICI)},
 doi = {10.1109/ICICI65870.2025.11069651},
 issn = {},
 keyword = {Deblurring;Accuracy;Surveillance;Semantic segmentation;Computational modeling;Deburring;Feature extraction;Conditional random fields;Security;Autonomous vehicles;Conditional Random Fields;Blur image classi fication;Image deblur;Semantic Segmentation},
 month = {June},
 number = {},
 pages = {275-279},
 title = {A Dual-Stage Framework for Accurate Blur Detection and Image Deblurring},
