@inproceedings{1395656,
 abstract = {A non-canonical circuit-based state set representation is used to perform quantifier elimination efficiently. The novelty of this approach lies in adapting equivalence checking and logic synthesis techniques to the goal of compacting circuit based state set representations resulting from existential quantification. The method can be efficiently combined with other verification approaches such as inductive and SAT-based pre-image verifications.},
 author = {Cabodi, G. and Crivellari, M. and Nocco, S. and Quer, S.},
 booktitle = {Design, Automation and Test in Europe},
 doi = {10.1109/DATE.2005.93},
 issn = {1558-1101},
 keyword = {Circuit synthesis;Binary decision diagrams;Explosions;Logic circuits;Merging;Switches;Databases;Data structures;Boolean functions;Combinational circuits},
 month = {March},
 number = {},
 pages = {688-689 Vol. 2},
 title = {Circuit based quantification: back to state set manipulation within unbounded model checking},
 volume = {},
 year = {2005}
}
