 publication_stage = {Final},
 source = {Scopus},
 title = {Rwin-FPN++: Rwin Transformer with Feature Pyramid Network for Dense Scene Text Spotting},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85137907281?origin=resultslist},
