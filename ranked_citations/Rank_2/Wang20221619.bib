@article{Wang20221619,
 abstract = {In terms of understanding the structure of complex networks or the functional characteristics of complex networks, community discovery is of great significance. This paper uses the attention model to combine the second-order neighbor similarity matrix with the modularity matrix, extracts relatively more comprehensive complex network feature information from multiple angles for network division. Firstly, perform complex network preprocessing, and perform division preprocessing according to the value of the attention similarity matrix. Secondly, complete the merger of the community game according to the connection strength between the two different communities. By comparing with other algorithms on computer-generated networks and real-world networks, it is proved that this algorithm has obtained good results in terms of the number of communities, running time, normalized mutual information and modularity. © 2021, The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature.},
 author = {Wang, Jinghong and Li, Haokang and Liang, Lina and Zhou, Yi},
 doi = {10.1007/s13042-021-01471-w},
 journal = {International Journal of Machine Learning and Cybernetics},
 note = {Cited by: 12},
 number = {6},
 pages = {1619 - 1631},
 publication_stage = {Final},
 source = {Scopus},
 title = {Community discovery algorithm of complex network attention model},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85122684711?origin=resultslist},
 volume = {13},
 year = {2022}
}
