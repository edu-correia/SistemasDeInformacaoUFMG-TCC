@inproceedings{5402998,
 abstract = {Runtime reconfiguration provides an efficient means to reduce the hardware cost, while satisfying the performance, flexibility and power requirements of embedded systems. The growing complexity of the applications necessitates methods that can rapidly identify a suitable set of configurations by splitting the computational structures into temporal partitions in order to evaluate the benefits of runtime reconfiguration early in the design cycle. In this paper, we present a hierarchical loop partitioning strategy that reduces the complexity of the search space for determining the runtime custom instruction configurations for reconfigurable processors. Experimental results show that the proposed partitioning strategy can lead to an average and maximum performance gain of over 14% and 31% respectively when compared to a recently reported technique. In addition, when compared to the existing technique, the proposed partitioning method has significantly lower runtime in many of the cases considered.},
 author = {Lam, Siew-Kei and Deng, Yun and Srikanthan, Thambipillai and Hu, Jian and Zhou, Xilong},
 booktitle = {2009 Fourth International Conference on Embedded and Multimedia Computing},
 doi = {10.1109/EM-COM.2009.5402998},
 issn = {2159-1520},
 keyword = {Runtime;Reconfigurable logic;Costs;Field programmable gate arrays;Embedded system;Hardware;Computer aided instruction;Computer architecture;Personal digital assistants;Partitioning algorithms},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {Hierarchical Loop Partitioning For Rapid Generation of Runtime Configurations},
 volume = {},
 year = {2009}
}
