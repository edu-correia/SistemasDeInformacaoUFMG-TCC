@article{CUI2026123665,
 abstract = {In high-precision underwater acoustic positioning, to address the trade-off between computational efficiency and ranging accuracy, this paper proposes an adaptive Sound Velocity Profile (SVP) stratification algorithm based on multi-objective optimization using the Non-dominated Sorting Genetic Algorithm II (NSGA-II), under the context of acoustic ray-tracing. First, a Fourier function is employed to fit the sound velocity gradient. Then, the K-means algorithm optimized by the Invasive Weed Optimization algorithm (IWO-K-means) is employed to cluster the gradient points, enabling the merging of SVP layers. Subsequently, a coupled parameter space is constructed between the number of Fourier expansion series and the number of clustering categories, employing the NSGA-II algorithm to solve the multi-objective optimization problem of minimizing underwater acoustic ray-tracing ranging error and SVP layering feature rate, thereby generating a Pareto-optimal solution set. A comprehensive evaluation is then conducted by integrating a weighted aggregation approach with the Technique for Order of Preference by Similarity to Ideal Solution (TOPSIS), resulting in the selection of an optimal adaptive SVP stratification scheme. The experiment was validated using measured SVPs from shallow and deep seas, as well as acoustic simulation data. The results show that the simplification rate of shallow-water SVP has been improved to over 95 %, with acoustic ray-tracing ranging errors reduced to below 0.1 m; for deep-water SVP, the simplification rate exceeds 97 %, with acoustic ray-tracing ranging errors below 0.2 m. The proposed algorithm achieves reasonable simplification of SVP while ensuring ranging accuracy.},
 author = {Xuerong Cui and Tongyu Zhou and Juan Li and Meiqi Ji and Lei Li and Bin Jiang and Shibao Li and Jianhang Liu},
 doi = {https://doi.org/10.1016/j.oceaneng.2025.123665},
 issn = {0029-8018},
 journal = {Ocean Engineering},
 keyword = {Sound velocity profile, Acoustic ray-tracing algorithm, Adaptive stratification, Multi-objective optimization},
 pages = {123665},
 title = {An adaptive stratification algorithm for sound velocity profile based on NSGA-II multi-objective optimization},
 url = {https://www.sciencedirect.com/science/article/pii/S0029801825033475},
 volume = {344},
 year = {2026}
}
