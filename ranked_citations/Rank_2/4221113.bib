@inproceedings{4221113,
 abstract = {Personal networks and PN federations are new networking paradigms that merge concepts from ad hoc, P2P and wireless networks, built around user's needs. Even though they are a promise of a practical achievement of ubiquitous computing, managing security associations in these frameworks proves to be a challenge. We present in this paper a security architecture, including a uniform personal namespace using crypto-based identifiers and a key management scheme based on identity-based cryptography. We also provide an evaluation of our scheme, in terms of computation complexity, communication cost and security.},
 author = {Masmoudi, Khaled and Afifi, Hossam},
 booktitle = {21st International Conference on Advanced Information Networking and Applications Workshops (AINAW'07)},
 doi = {10.1109/AINAW.2007.82},
 issn = {},
 keyword = {Identity management systems;Identity-based encryption;Protocols;DH-HEMTs;Personal area networks;Project management;Wireless networks;Ubiquitous computing;National security;Computer architecture},
 month = {May},
 number = {},
 pages = {537-543},
 title = {An Identity-Based Key Management Framework for Personal Networks},
 volume = {1},
 year = {2007}
}
