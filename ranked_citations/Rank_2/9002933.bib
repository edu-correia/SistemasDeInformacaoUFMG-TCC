@inproceedings{9002933,
 abstract = {The objective and contribution of this work is to apply our data clustering method using generalized SOMs (self-organizing maps) with splitting-merging evolving structures to a multi-step clustering of colon cancer gene expression data coming from microarray experiments. Such a clustering aims at uncovering a small set of informative genes (that is, the disease relevant genes) from their overall huge number. Our approach operates in an unsupervised way, that is, (i) it uses unlabelled data and (ii) it does not need the cluster number to be predefined. Such a property is very important in the clustering of genes coming from the microarray data because we do not know in advance the number of gene clusters. In the case of the clustering of samples from the microarray data, our method provides the results which outperform the results presented in the literature. The alternative techniques usually require the number of clusters to be determined in advance. The aforementioned experiments are preceded by an outline of our clustering technique and an illustration of its operation with the use of a benchmark data set.},
 author = {Gorzałczany, Marian B. and Piekoszewski, Jakub and Rudziński, Filip},
 booktitle = {2019 IEEE Symposium Series on Computational Intelligence (SSCI)},
 doi = {10.1109/SSCI44817.2019.9002933},
 issn = {},
 keyword = {Cancer;Gene expression;Neurons;Colon;Self-organizing feature maps;Benchmark testing;Clustering methods;bioinformatics;microarray colon cancer gene data;gene data clustering;informative genes;generalized SOMs with evolving splitting-merging structures;unsupervised learning},
 month = {Dec},
 number = {},
 pages = {534-540},
 title = {Uncovering informative genes from colon cancer gene expression data via multi-step clustering based on generalized SOMs with splitting-merging structures},
 volume = {},
 year = {2019}
}
