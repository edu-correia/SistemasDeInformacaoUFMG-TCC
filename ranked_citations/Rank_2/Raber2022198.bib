@article{Raber2022198,
 abstract = {Research has provided evidence that augmented reality (AR) can be an effective tool to improve teaching and learning across multiple domains. Research is limited, however, in several key areas related to AR. For instance, motivation and situational interest are critical to student learning outcomes. However, little is known about the relationship between the two constructs and AR, particularly for AR that leverages location-based triggers. This study addressed this need by analyzing data from participants who used an application that delivers location-based, instructional AR content about the tragic shootings that occurred on May 4th, 1970, at Kent State University. Data findings showed significant decreases in motivation, but significant growth in situational interest and content knowledge. Implications for development of future location-based AR applications are discussed. © 2022. Interaction Design and Architecture(s). All Rights Reserved.},
 author = {Raber, James and Ferdig, Richard E. and Gandolfi, Enrico and Clements, Robert},
 doi = {10.55612/s-5002-052-011},
 journal = {Interaction Design and Architecture(s)},
 note = {Cited by: 9; All Open Access; Gold Open Access},
 number = {52},
 pages = {198 - 220},
 publication_stage = {Final},
 source = {Scopus},
 title = {An analysis of motivation and situational interest in a location-based augmented reality application},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85132692096?origin=resultslist},
 year = {2022}
}
