@inproceedings{9678674,
 abstract = {Coreference resolution is one of the background tasks in the area of natural language processing. As this task falls into the category of AI-complete problems, different machine learning techniques are used in order to solve it with sufficient accuracy. In this paper, a new complex method of coreferent clusters detection based on a BiLSTM neural network has been suggested. The state-of-the-art methods of coreference resolution have been considered. The impact of the different features of a text on the accuracy of the detection of coreferent pairs has been investigated. It has been shown that the semantic representation of mentions should be considered as the main component during the preparation of input data for a model. The neural network based on a shared BiLSTM layer has been designed and trained using a SEARN-based approach. The set of filtering sieves has been used as an additional instrument for the detection of explicit connections between coreferent objects. The experimental verification of the effectiveness of the suggested method has been performed using corresponding metrics. The results obtained may indicate that the proposed method can be utilized in order to group the coreferent objects into clusters for the different Slavic language corpora.},
 author = {Telenyk, Sergii and Pogorilyy, Sergiy and Kramov, Artem},
 booktitle = {2021 IEEE 3rd International Conference on Advanced Trends in Information Theory (ATIT)},
 doi = {10.1109/ATIT54053.2021.9678674},
 issn = {},
 keyword = {Measurement;Instruments;Neural networks;Semantics;Object detection;Machine learning;Propagation losses;coreferent pairs detection;BiLSTM neural network;natural language processing;Extremely Randomized Trees;deep learning;binary classifier},
 month = {Dec},
 number = {},
 pages = {205-210},
 title = {The Complex Method of Coreferent Pairs Detection in a Ukrainian-language Text Based on a BiLSTM Neural Network},
