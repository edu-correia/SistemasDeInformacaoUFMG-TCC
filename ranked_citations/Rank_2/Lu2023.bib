@conference{Lu2023,
 abstract = {In this paper, we propose a new space-efficient key-value store called ZoneKV for ZNS (Zoned Namespace) SSDs. We observe that existing work on adapting RocksDB to ZNS SSDs will cause fragmentation of zones and severe space amplification. Thus, we propose a lifetime-based zone storage model and a level-specific zone allocation algorithm to store SSTables with a similar lifetime in the same zone. We evaluate ZoneKV on a real ZNS SSD. The results show that ZoneKV can reduce up to 60% space amplification and maintain higher throughputs than two competitors, RocksDB and ZenFS. © 2023 IEEE.},
 author = {Lu, Mingchen and Jin, Peiquan and Wang, Xiaoliang and Luo, Yongping and Guo, Kuankuan},
 doi = {10.1109/DAC56929.2023.10247926},
 journal = {Proceedings - Design Automation Conference},
 note = {Cited by: 16},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {ZoneKV: A Space-Efficient Key-Value Store for ZNS SSDs},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85173091039?origin=resultslist},
 volume = {2023-July},
 year = {2023}
}
