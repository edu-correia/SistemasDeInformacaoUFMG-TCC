@article{NELSON2026109072,
 abstract = {Neonatal sepsis is a life-threatening condition that requires early and reliable detection to reduce mortality and improve clinical outcomes in Neonatal Intensive Care Units (NICUs). Conventional diagnostic approaches based on biomarkers and clinical observations often fail to capture complex temporal and multimodal interactions present in heterogeneous clinical data. This study proposes a Brain-Inspired Graph Neural Network (Bi-GNN) framework that integrates EEG waveform signals and structured electronic clinical records (ECR) derived from the MIMIC-III waveform database for neonatal sepsis prediction. EEG signals are encoded into spike sequences and mapped onto anatomically grounded graph structures, while clinical features are modeled as complementary graph nodes, enabling effective multimodal fusion. A Forward-Forward Graph Convolutional Network with biologically inspired synaptic plasticity is employed to learn temporal and spatial dependencies without backpropagation through time. The proposed framework achieves an accuracy of 94.54%, precision of 94.58%, recall of 93.78%, and an F1-score of 94.00%, demonstrating robust and reliable performance. Comparative evaluation against baseline and state-of-the-art models confirms the effectiveness of the proposed approach. Furthermore, graph-based representations and attention mechanisms enhance interpretability by highlighting clinically relevant neural and physiological patterns, supporting trustworthy and explainable neonatal sepsis assessment in critical care environments.},
 author = {Madhusundar Nelson and Youseef Alotaibi and Surendran Rajendran and Betshrine Rachel Jibinsingh},
 doi = {https://doi.org/10.1016/j.rineng.2026.109072},
 issn = {2590-1230},
 journal = {Results in Engineering},
 keyword = {Neonatal sepsis, Brain-inspired GNN, Multimodal learning, Deep learning, Healthcare, NICU},
 pages = {109072},
 title = {Multimodal learning for neonatal sepsis detection in the NICU using brain-inspired graph neural networks},
 url = {https://www.sciencedirect.com/science/article/pii/S2590123026001155},
 volume = {29},
 year = {2026}
}
