@article{11204700,
 abstract = {This article aims to reduce the current ripple for the three-phase two-level inverter in a wide operation range. Based on the thought of voltage-vector optimal redistribution, a hybrid pulsewidth modulation (PWM) strategy is proposed. Differing from conventional space-vector PWM scheme that the duration of zero-voltage and active-voltage vectors are always equally divided, the proposed hybrid PWM strategy redistributes the dwelling time of zero-voltage vectors and active-voltage vectors according to the minimum current ripple peak value. With the proposed strategy, the optimal PWM switching sequence-I based on zero-voltage vector redistribution is first obtained by establishing and analyzing the mathematical relationship of the current ripple peak value and the redistribution coefficient of the two zero-voltage vectors’ duration. Then, by splitting the dwelling time of maximum active-voltage vector based on the minimum current ripple peak value, meanwhile merging zero-voltage vectors according to the centrosymmetric modulation, the optimal PWM switching sequence-II and sequence-III are generated effectively and conveniently. With the comprehensive integration of three optimal PWM switching sequences, the proposed strategy not only reduces three-phase current ripples cooperatively and effectively, but also does not increase the total switching power loss. Finally, experimental results are provided to validate the effectiveness and feasibility of the proposed hybrid strategy.},
 author = {Tang, Qipeng and Wu, Xiangze and Zhong, Qiming and Luo, Pan and Shen, Yi and Shen, Anwen and Luo, Xin and Xu, Jinbang},
 doi = {10.1109/TPEL.2025.3621689},
 issn = {1941-0107},
 journal = {IEEE Transactions on Power Electronics},
 keyword = {Vectors;Switches;Inverters;Space vector pulse width modulation;Switching loss;Stators;Switching frequency;Inductance;Optimization;Clamps;Current ripple;hybrid pulsewidth modulation (PWM) strategy;three-phase two-level inverter;voltage-vector optimal redistribution},
 month = {April},
 number = {4},
 pages = {4945-4957},
 title = {Voltage-Vector Optimal Redistribution-Based Hybrid PWM Strategy for Current Ripple Reduction in Three-Phase Two-Level Inverter},
 volume = {41},
 year = {2026}
}
