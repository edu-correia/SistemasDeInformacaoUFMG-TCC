@inproceedings{10214743,
 abstract = {In this paper, a method of fusing distance information and camera data is presented, the objective being that of combining LIDAR measurements with the output of a segmentation neural network, applied on the merged image from three frontal cameras, for navigating in an indoor environment. Usually, these types of environments are not structured, being diverse in their composition: for example, some buildings have more glass walls and doors, others might have large corridors and concrete structures. The proposed fusing method is used for reducing the errors generated by both techniques individually, which is then applied to control the trajectory of an electric wheelchair, as well as to gather a dataset of corrected and annotated images for reducing the dependency on the LIDAR data in the future.},
 author = {Baicu, Diana and CrĂCiunescu, Mihai and Duvinage, Thomas and Mocanu, Ştefan},
 booktitle = {2023 24th International Conference on Control Systems and Computer Science (CSCS)},
 doi = {10.1109/CSCS59211.2023.00056},
 issn = {2379-0482},
 keyword = {Image segmentation;Laser radar;Navigation;Wheelchairs;Neural networks;Robot sensing systems;Cameras;Distance sensing;Image segmentation;Sensor fusion;Indoor robotics;Electric wheelchair navigation;Dataset generation},
 month = {May},
 number = {},
 pages = {313-318},
 title = {Enhancing neural network with LIDAR data for navigation},
 volume = {},
 year = {2023}
}
