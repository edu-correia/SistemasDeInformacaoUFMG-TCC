@inproceedings{8488255,
 abstract = {Ultra dense network (UDN) is identified as one key technology for 5G because of frequency reuse. Considering of handover and interference of edge users, we adopt user-centric transmission method. We focuses on the downlink transmission in UDN with multiple users and base station (BS) random distributed in a specific area. Virtual cells (VCs) are merged based on interference strength to form a virtual cell cluster (VCC) in order to suppress and eliminate the interference. We use ZF, improved ZF and ZF-BD and MMSE pre-coding method to eliminate the interference. The simulation results show that VCs merged method based on interference strength can greatly reduce BER with the deployment of the BS. The MMSE pre-coding is better than another schemes.},
 author = {Song, Shuangshuang and Li, Hui and Fan, Yujie and Kong, Weisi and Zhang, Wenjie},
 booktitle = {2018 10th International Conference on Communication Software and Networks (ICCSN)},
 doi = {10.1109/ICCSN.2018.8488255},
 issn = {2472-8489},
 keyword = {Interference;Merging;Signal to noise ratio;Downlink;Antenna arrays;Simulation;ultra-dense network;virtual cell;interference strength;pre-coding transmission},
 month = {July},
 number = {},
 pages = {361-364},
 title = {Downlink Interference Rejection in Ultra Dense Network},
 volume = {},
 year = {2018}
}
