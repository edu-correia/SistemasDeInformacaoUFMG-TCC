@inproceedings{11448456,
 abstract = {Financial institutions are increasingly dealing with difficulties in preserving transaction integrity due to escalating digital fraud and extensive cloud-based operations. Conventional machine learning and rule-based detection systems frequently have latency in replies, restricted adaptability, and an absence of verifiable audit trails. The proposed study presents a Hybrid Multi-Agent Reinforcement Learning (MARL) and Blockchain framework to overcome existing limitations, integrating adaptive multi-agent coordination for real-time fraud detection with a permissioned blockchain ledger to guarantee secure, tamper-proof validation of agent decisions. MARL agents adaptively acquire optimal detection strategies through incentive shaping and inter-agent communication, while blockchain consensus and smart contracts substantiate decision proofs for regulatory adherence. The experimental evaluation of the Kaggle Financial Transactions dataset demonstrates improved accuracy relative to baseline models: Accuracy 0.989, Precision 0.981, Recall 0.987, F1-Score 0.984, AUC-ROC 0.992, with negligible latency (1.8 ms/transaction). The comparative research reveals a persistent superiority over Random Forest, XGBoost, CNN- LSTM, and Transformer-based classifiers, showcasing robustness, scalability, and real-time application. The suggested study enhances the area by merging reinforcement learning adaptability with blockchain security, establishing a realistic, high-throughput, and reliable framework for cloud- based financial systems, while presenting a model for future research in agentic AI-driven fraud prevention.},
 author = {Seenu, Aaluri and Aitha, Avinash Reddy and Gottimukkala, Vijaya Rama Raju and Singireddy, Jeevani and Meda, Raviteja and Garapati, Ravi Shankar},
 booktitle = {2025 IEEE 3rd Global Conference on Wireless Computing and Networking (GCWCN)},
 doi = {10.1109/GCWCN66157.2025.11448456},
 issn = {},
 keyword = {Cloud computing;Accuracy;Scalability;Smart contracts;Reinforcement learning;Real-time systems;Robustness;Blockchains;Fraud;Security;Hybrid Multi-Agent Reinforcement Learning;Blockchain;Financial Transaction Integrity;Cloud Computing;Fraud Detection;Permissioned Ledger;Smart Contracts;Real- Time Monitoring;Scalable AI Systems;Multi-Agent Coordination;Reward Shaping;Consensus Algorithms;Tamper- Proof Validation;Edge-Cloud Architecture;Adversarial Robustness},
 month = {Nov},
 number = {},
 pages = {1-6},
 title = {Hybrid Multi-Agent Reinforcement Learning and Blockchain Framework for Real-Time Transaction Integrity in Cloud-Driven Financial Systems},
 volume = {},
 year = {2025}
}
