@inproceedings{11311258,
 abstract = {This work presents the development of a portable, cost-effective system for dual-axis swallowing accelerometry, designed to support non-invasive dysphagia assessment. The proposed platform is based on the Arduino Nano RP2040 Connect, which integrates the LSM6DSOX inertial sensor for capturing anterior-posterior ($A-P$) and superior-inferior ($S-I$) laryngeal vibrations. Raw accelerometry signals are wirelessly transmitted and processed offline through a digital pipeline incorporating bandpass filtering, spline-based detending, and wavelet-based denoising. Swallowing events are automatically segmented using a percentile-based thresholding method applied to the variance of both axes, combined with envelope-based trimming and post-segmentation merging. Experimental sessions were conducted under structured conditions with dry swallows of varying effort. Statistical features—including amplitude, symmetry, and energy-based descriptors—were extracted from each detected segment and analyzed to evaluate the internal consistency and physiological plausibility of the results. The goal of the system is not real-time classification, but rather the generation of clear, temporally accurate swallowing representations suitable for clinical interpretation by speech-language pathologists. Although clinical validation with gold-standard techniques such as FEES is pending, the presented results demonstrate the feasibility of a fully digital, embedded-friendly solution for swallowing monitoring. The system lays the groundwork for future multimodal extensions incorporating surface electromyography (sEMG) or audio sensing.},
 author = {Galanis, Charalampos and Tsipianitis, Dimitris and Michou, Emilia},
 booktitle = {2025 16th International Conference on Information, Intelligence, Systems & Applications (IISA)},
 doi = {10.1109/IISA66859.2025.11311258},
 issn = {},
 keyword = {Vibrations;Pipelines;Noise reduction;Merging;Signal processing;Feature extraction;Real-time systems;Splines (mathematics);Surface treatment;Monitoring;swallowing accelerometry;dysphagia assessment;signal processing;segmentation},
 month = {July},
 number = {},
 pages = {1-8},
 title = {A Cost-Effective, Portable, and Non-Invasive Dual-Axis Swallowing Accelerometry System for Dysphagia Assessment},
