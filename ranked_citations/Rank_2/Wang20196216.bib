@conference{Wang20196216,
 abstract = {In medical documents, it is possible that an entity of interest not only contains a discontiguous sequence of words but also overlaps with another entity. Entities of such structures are intrinsically hard to recognize due to the large space of possible entity combinations. In this work, we propose a neural two-stage approach to recognizing discontiguous and overlapping entities by decomposing this problem into two subtasks: 1) it first detects all the overlapping spans that either form entities on their own or present as segments of discontiguous entities, based on the representation of segmental hypergraph, 2) next it learns to combine these segments into discontiguous entities with a classifier, which filters out other incorrect combinations of segments. Two neural components are designed for these subtasks respectively and they are learned jointly using a shared encoder for text. Our model achieves the state-of-the-art performance in a standard dataset, even in the absence of external features that previous methods used. © 2019 Association for Computational Linguistics},
 author = {Wang, Bailin and Lu, Wei},
 doi = {10.18653/v1/D19-1644},
 journal = {EMNLP-IJCNLP 2019 - 2019 Conference on Empirical Methods in Natural Language Processing and 9th International Joint Conference on Natural Language Processing, Proceedings of the Conference},
 note = {Cited by: 35; All Open Access; Gold Open Access},
 pages = {6216 - 6224},
 publication_stage = {Final},
 source = {Scopus},
 title = {Combining spans into entities: A neural two-stage approach for recognizing discontiguous entities},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85084296820?origin=resultslist},
 year = {2019}
}
