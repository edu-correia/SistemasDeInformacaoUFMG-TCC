@inproceedings{10434244,
 abstract = {Integrated sensor fusion is a novel method in which data from various sensors is intelligently fused to enable software that enhances the performance of an application or an entire system. This technique uses a network of sensors to overcome individual sensors' limitations to provide accurate position and orientation data. It is possible to quantify the state of an entity as a data or information mixture by characterizing the merging of data. Increased confidence, dependability, and simplicity in assessing company conditions via engineering systems are only some of the benefits of this interdisciplinary area. In this research, the potential aids of data fusion in civil engineering (CE), as well as some of the more recent implementations of fusion in CE. When problems arise in an application, mathematical modeling (MM) reduces them to tractable mathematical formulations that may be used for theoretical and numerical analysis. Building planning issues were addressed using an integer linear programming mathematical model. The advent of pervasive sensor networks and communications systems has enabled MMCE to use this methodology to rapidly and accurately estimate civil systems, including traffic networks, structural systems, and construction projects. The system can quickly arrive at information-based decisions by checking its health. The implications of this are many, and the value is enormous. Information fusion is a crucial part of monitoring system health. Future applications and research requirements are highlighted.},
 author = {Ibrahim, Ameer Kaissar and Fouad, Laith and Ali Hussien, Naseer and Hani Sherif, Noora and Ali, Aqeel},
 booktitle = {2023 International Conference on Emerging Research in Computational Science (ICERCS)},
 doi = {10.1109/ICERCS57948.2023.10434244},
 issn = {},
 keyword = {Buildings;Data integration;Sensor fusion;Integer linear programming;Mathematical models;Planning;Monitoring;Civil engineering;Sensor fusion;mathematical model;structure;data fusion},
 month = {Dec},
 number = {},
 pages = {1-6},
 title = {Civil engineering structure monitoring based on Integrated sensor fusion device with an optimized mathematical model},
