@inproceedings{11257670,
 abstract = {Driven by the continuous development of multimodal large models, the number of visual tokens has rapidly increased, which in turn raises memory consumption and computational burdens, limiting the widespread adoption of these models in resource-constrained environments. Visual token compression plays a significant role in the development and application of efficient vision-language models, particularly in enhancing computational efficiency and reducing inference costs. Existing visual token compression techniques primarily reduce the number of visual tokens through merging, pruning, and hybrid strategies, thereby reducing computational costs while improving efficiency without sacrificing model performance. Despite the many studies proposing different compression methods, a systematic review of these methods is still lacking. To address this gap, this paper provides a comprehensive review of visual token compression techniques for vision-language models, focusing on the analysis of compression strategies, classification of methods, and their applications and effectiveness in multimodal tasks. The paper first introduces the impact of visual tokens on computational costs and outlines the motivations for visual token compression. It then categorizes existing compression methods into three main types: merging strategies, pruning strategies, and hybrid strategies, and provides a detailed summary and comparative analysis of the basic principles, advantages, and limitations of each method. Through experiments on several mainstream multimodal benchmark datasets, the paper demonstrates the balance between compression rate and inference performance achieved by different compression methods and discusses the future development directions and challenges.},
 author = {Cao, Weidong and Feng, Zeqin and Sun, Fangwei and Liu, Danjun and Xie, Yongqiang and Li, Zhongbo},
 booktitle = {2025 5th International Conference on Advanced Algorithms and Neural Networks (AANN)},
 doi = {10.1109/AANN66429.2025.11257670},
 issn = {},
 keyword = {Surveys;Visualization;Computational modeling;Merging;Semantics;Neural networks;Benchmark testing;Computational efficiency;Videos;Systematic literature review;visual token compression;compression strategies;vision-language models},
 month = {Aug},
 number = {},
 pages = {735-741},
 title = {A Survey on Visual Token Compression for Efficient Vision-Language Models},
