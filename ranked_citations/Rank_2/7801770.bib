@inproceedings{7801770,
 abstract = {Many people communicate each other through online community, SNS as Instagram, Facebook, etc. Most of these services annotate on their clips or pictures by using tags, which contain some information and can describe their contents. In this paper, we propose a new recommender system using word embedding with tag information and collective matrix factorization technique. By vectorizing tags that users annotated, we make user-tag matrix by merging tag vectors and factorize it together with user-item matrix. We show that this method effectively works through experiments.},
 author = {Bang, Hanbyul and Lee, Jee-Hyong},
 booktitle = {2016 Joint 8th International Conference on Soft Computing and Intelligent Systems (SCIS) and 17th International Symposium on Advanced Intelligent Systems (ISIS)},
 doi = {10.1109/SCIS-ISIS.2016.0183},
 issn = {},
 keyword = {Recommender systems;Semantics;Matrix converters;Motion pictures;Matrix decomposition;Collaboration;recommender system;collaborative filtering;collective matrix factorization;word embedding;tag},
 month = {Aug},
 number = {},
 pages = {846-850},
 title = {Collective Matrix Factorization Using Tag Embedding for Effective Recommender System},
 volume = {},
 year = {2016}
}
