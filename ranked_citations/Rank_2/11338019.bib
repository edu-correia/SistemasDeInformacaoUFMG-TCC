@inproceedings{11338019,
 abstract = {The progression of genetic disease is complex due to complex of data and irrelevant data in electronic health records (EHRs). To identify the symptoms of a disease is based on patient relationships, genes, and pre-processed data and clinical data. To overcome these issues, we proposed a hybrid approach called TCN-SAGENet, process in two stages, the first stage is Temporal Convolutional Networks (TCNs) and second stage is GraphSAGE; to identify time-bound based data and disease patterns. Convolutional networks handles temporal features and GraphSAGE relates the connections between patients with genetic results or clinical records. A fusion layer aditional supports in both outputs for final analysis. Coputed the test-bed results using tradional datasets like Huntington’s and muscular dystrophy, the proposed model increases the accuracy by 12.6% over state-of-the-methods and recognizes genes patterns and disease symptoms connected to clinical observations.},
 author = {Swain, Manas Kumar and Kumar Kamila, Narendra and Jena, Lambodar and Chithaluru, Premkumar},
 booktitle = {2025 International Conference on Cognitive, Green and Ubiquitous Computing (IC-CGU)},
 doi = {10.1109/IC-CGU67042.2025.11338019},
 issn = {},
 keyword = {Accuracy;Merging;Predictive models;Genetics;Ubiquitous computing;Data models;Pattern recognition;Convolutional neural networks;Muscular dystrophy;Diseases;Genetic disease prediction;TCNs;GraphSAGE;Disease progression modeling;EHR analysis},
 month = {Oct},
 number = {},
 pages = {1-6},
 title = {Predicting Genetic Disease Progression Using a Hybrid Model of Temporal Convolutional Networks and GraphSAGE},
 volume = {},
 year = {2025}
}
