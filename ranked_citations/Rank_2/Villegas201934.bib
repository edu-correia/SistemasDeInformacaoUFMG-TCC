@conference{Villegas201934,
 abstract = {In this article we define the concept of Distributed Reality, a new form of immersive media based on the combination of captured realities (e.g a remote and a local one), hence with a strong focus on video. While Virtual Reality fully substitutes the real surrounding with a simulation and all existing variations of Mixed Reality just provide additional synthetic elements into our visual field, our proposal is to capture and segment different scenes (one of them being the local one) in real time and merge the resulting elements dynamically, to create a completely new reality in front of the user senses. We compare this concept with prior art in the field and describe a taxonomy in which it fits. © 2019 Association for Computing Machinery.},
 author = {Villegas, Alvaro and Pérez, Pablo and González-Sosa, Ester},
 doi = {10.1145/3304113.3326111},
 journal = {Proceedings of the 11th ACM Workshop on Immersive Mixed and Virtual Environment Systems, MMVE 2019},
 note = {Cited by: 10},
 pages = {34 - 36},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards a distributed reality: A multi-video approach to xR},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85069535552?origin=resultslist},
 year = {2019}
}
