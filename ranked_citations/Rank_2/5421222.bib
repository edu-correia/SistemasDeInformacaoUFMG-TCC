@inproceedings{5421222,
 abstract = {A neural network (NN) pruning method optimized with particle swarm optimization (PSO) algorithm is proposed in this paper. Correlation merging algorithm is an important pruning method in NN structure design. Unlike general training method with back-propagation (BP), this paper uses PSO algorithm in the pruning process. The PSO is used to optimize the initial parameters of the NN, including the weights and biases etc. The experiment results show that the method in the paper above conventional one has greater improvement in both accuracy and velocity of convergence for NN.},
 author = {Tu, Juanjuan and Zhan, Yongzhao and Han, Fei},
 booktitle = {2010 Second International Conference on Computer Modeling and Simulation},
 doi = {10.1109/ICCMS.2010.424},
 issn = {},
 keyword = {Neural networks;Optimization methods;Neurons;Particle swarm optimization;Merging;Algorithm design and analysis;Computational modeling;Computer science;Training data;Information processing;neural network;pruning;particle swarm optimization},
 month = {Jan},
 number = {},
 pages = {257-259},
 title = {A Neural Network Pruning Method Optimized with PSO Algorithm},
 volume = {3},
 year = {2010}
}
