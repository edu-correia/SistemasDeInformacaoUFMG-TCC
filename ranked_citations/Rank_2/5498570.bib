@inproceedings{5498570,
 abstract = {Two new chaotic attractors in a commonly-distributed-coefficient jerk model are proposed with new coefficients and new nonlinearity. The latter is based on arcsine and arc-hyperbolic sine nonlinearity. In particular, compound structures of both attractors are demonstrated through a half-image isolation using a control parameter C. The positive value of an appropriate C isolates the right half-image attractors whilst the negative value of an appropriate C isolates the left half-image attractor. Both images can then be merged together as a compound structure. Forming mechanism of compound structures has been concluded. Examples of gradual development of the compound structures have also been demonstrated.},
 author = {Srisuchinwong, Banlue and Wangkuntod, Anawat and Tippinit, Janvit},
 booktitle = {2010 Chinese Control and Decision Conference},
 doi = {10.1109/CCDC.2010.5498570},
 issn = {1948-9447},
 keyword = {Chaos;Chaotic communication;Oscillators;Communications technology;Isolation technology;Electronic mail;Differential equations;Mechanical systems;Acceleration;Control systems;Chaos;Jerk Model;arcsine;arc-hyperbolic sine nonlinearity},
 month = {May},
 number = {},
 pages = {3482-3485},
 title = {Compound structures of new chaotic attractors in a commonly-distributed-coefficient jerk model with arcsine and arc-hyperbolic sine nonlinearity},
 volume = {},
 year = {2010}
}
