@article{Fang2026,
 abstract = {Physical Unclonable Functions (PUFs) exploit nanoscale process variations in integrated circuit manufacturing to establish challenge-response pair (CRP) mappings, providing a secure and reliable hardware fingerprint for Internet of Things (IoT) devices. Existing research on PUFs primarily focuses on either key generation or true random number generation as single functions, with limited research addressing scenarios that require both functionalities. To address this, this paper proposes a hybrid bistable Mix SRAM PUFs (MS PUFs). By leveraging configurable units, MS PUFs enables dynamic switching between stable and unstable states, thereby supporting both key generation and true random number generation, and a SHA-256-inspired algorithm, termed Random 256b algorithm, is proposed to enhance the randomness of the generated random number sequences. Furthermore, efficient CRPs management is critical in IoT scenarios. Traditional Shamir’s secret sharing scheme may suffer from significant time overhead, limiting its practical application. To enhance the efficiency of secret reconstruction, this paper proposes an improved secret sharing scheme based on the Vandermonde matrix, which combines a fast Vandermonde matrix inversion algorithm with dynamic programming to compute symmetric polynomials, effectively reducing time overhead. Experimental results show that the proposed MS PUFs exhibit strong performance in both key generation and true random number generation, and the proposed Random 256b algorithm effectively enhances the randomness of the generated random number sequences. Additionally, the improved secret sharing scheme achieves lower time overhead under varying numbers of CRPs and share configurations. © 2014 IEEE.},
 author = {Fang, Tian and Li, Bing and Ge, Wenjie and Jiang, Yikai and Han, Baofu and Feng, Pan},
 doi = {10.1109/JIOT.2026.3692883},
 journal = {IEEE Internet of Things Journal},
