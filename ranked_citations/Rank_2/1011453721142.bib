@article{10.1145/3721142,
 abstract = {Bigraphs are a versatile modelling formalism that allows easy expression of placement and connectivity relations in a graphical format. System evolution is user defined as a set of rewrite rules. This article presents a practical, yet detailed guide to developing, executing, and reasoning about bigraph models, including recent extensions such as parameterised, instantaneous, prioritised and conditional rules, and probabilistic and stochastic rewriting.},
 address = {New York, NY, USA},
 articleno = {20},
 author = {Archibald, Blair and Calder, Muffy and Sevegnani, Michele},
 doi = {10.1145/3721142},
 issn = {0934-5043},
 issue_date = {September 2025},
 journal = {Form. Asp. Comput.},
 keyword = {Bigraphs, graph rewriting, rewrite systems},
 month = {July},
 number = {3},
 numpages = {36},
 publisher = {Association for Computing Machinery},
 title = {Practical Modelling with Bigraphs},
 url = {https://doi.org/10.1145/3721142},
 volume = {37},
 year = {2025}
}
