@inproceedings{6617547,
 abstract = {In this paper, the applied MIMO based on Hadamard transform in IEEE 802.16 WiMAX system is proposed. After modulation process, the two points of constellation are merged into one new symbol by Hadamard transform. The result of the addition of two constellations is transmitted through first antenna and the result of the reduction of two constellations is transmitted through second antenna. System model for applied MIMO based on Hadamard transform on WiMAX system is also suggested and formulated. Simulation results show that the bit error rate (BER) performance of the proposed idea outperforms the SISO WiMAX system.},
 author = {Siadari, Thomhert Suprapto and Rezha, Fadillah Purnama and Shin, Soo-Young},
 booktitle = {IET International Conference on Information and Communications Technologies (IETICT 2013)},
 doi = {10.1049/cp.2013.0104},
 issn = {},
 keyword = {MIMO;Hadamard Transforn;IEEE 802.16 WiMAX},
 month = {April},
 number = {},
 pages = {582-586},
 title = {Applied MIMO based on Hadamard transform in IEEE 802.16 WiMAX system},
 volume = {},
 year = {2013}
}
