@article{Korat2025388,
 abstract = {In the quickly changing discipline of electronic design automation, optimization of High-Level Synthesis (HLS) processes is a significant problem to attain a high-performance hardware implementation. Designers cannot do meaningful exploration of design space without the costly downstream implementation process based on inaccurate HLS estimates. To solve this problem, a detailed machine learning model is presented in the paper based on the synthetic HLS_Benchmark dataset with various design configurations. It creates and strictly tests three predictive models, Voting Regressor, MLP Regressor and Decision Tree, with their ensemble model, and with a remarkable 97.63% accuracy, it can perform far better than traditional methods, such as SVM (90%), HARP (82.18%), and compareXplore (81.61%). The integration of model interpretation methods is an important development, as it offers engineers practical information about the optimization parameters and their impact on the performance results. This paper creates a novel paradigm to intelligent optimization of HLS, which is effective in bridging the gap between the algorithmic predictions and the real-world hardware design needs. It also provides essential direction for future improvements in machine learning-driven engineering automation. © 2025 IEEE.},
 author = {Korat, Uday and Patel, Mitesh},
 doi = {10.1109/COMNETSAT68601.2025.11325014},
 journal = {IEEE International Conference on Communication, Networks and Satellite, ComNetSat},
 note = {Cited by: 0},
 number = {2025},
 pages = {388 - 394},
 publication_stage = {Final},
 source = {Scopus},
 title = {Machine Learning-Based Optimization Strategies for Efficient High-Level Synthesis (HLS) Driven Hardware Design},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105034204584?origin=resultslist},
 year = {2025}
