@article{Alsarkhi20187,
 abstract = {Deterministic and probabilistic are two approaches to matching commonly used in Entity Resolution (ER) systems. While many users are familiar with writing and using Boolean rules for deterministic matching, fewer are as familiar with the scoring rule configuration used to support probabilistic matching. This paper describes a method using deterministic matching to "bootstrap" probabilistic matching. It also examines the effectiveness three commonly used strategies to mitigate the effect of missing values when using probabilistic matching. The results based on experiment using different sets of synthetically generated data processed using the OYSTER open source entity resolution system. © 2015 The Science and Information (SAI) Organization Limited.},
 author = {Alsarkhi, Awaad and Talburt, John R.},
 doi = {10.14569/IJACSA.2018.091102},
 journal = {International Journal of Advanced Computer Science and Applications},
 note = {Cited by: 6; All Open Access; Gold Open Access; Green Open Access},
 number = {11},
 pages = {7 - 15},
 publication_stage = {Final},
 source = {Scopus},
 title = {A method for implementing probabilistic entity resolution},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85057864618?origin=resultslist},
 volume = {9},
 year = {2018}
}
