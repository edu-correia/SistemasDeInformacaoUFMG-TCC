@article{Shimizu2006113,
 abstract = {Moving object detection with a mobile image sensor is an important task for mobile surveillance systems running in real environments. In this paper, we propose a novel method to effectively solve this problem by using a Stereo Omni-directional System (SOS), which can obtain both color and depth images of the environment in real time with a complete spherical field of view. Taking advantage of the SOS that the frame-out problem never occurs, we develop a method to detect the regions of moving objects stably under arbitrary movement and pose change of the SOS, by using the spherical depth image sequence obtained by the SOS. The method first predicts the depth image for the current time from that obtained at the previous time and the ego-motion of the SOS, and then detects moving objects by comparing the predicted depth image with the actual one obtained at the current time. © Springer-Verlag London Limited 2006.},
 author = {Shimizu, Sanae and Yamamoto, Kazuhiko and Wang, Caihua and Satoh, Yutaka and Tanahashi, Hideki and Niwa, Yoshinori},
 doi = {10.1007/s10044-005-0008-4},
 journal = {Pattern Analysis and Applications},
 note = {Cited by: 6},
 number = {2-3},
 pages = {113 - 126},
 publication_stage = {Final},
 source = {Scopus},
 title = {Moving object detection by mobile Stereo Omni-directional System (SOS) using spherical depth image},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/33749332118?origin=resultslist},
 volume = {9},
 year = {2006}
}
