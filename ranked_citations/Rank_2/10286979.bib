@article{10286979,
 abstract = {With the development of bioinformatics technology, there is an increasing demand for gene sequence alignment. Gene sequence alignment can determine the homology between sequences and plays an increasingly prominent role in the traceback of species, the construction of phylogenetic trees and the diagnosis of human diseases. So far, gene sequence alignment schemes usually do not consider the privacy of participants, which could cause the disclosure of sensitive information, thus there is an urgent need for secure gene sequence alignment schemes. In this paper, we model genomic data from the perspective of privacy protection. On this basis, we design a scheme of gene sequence alignment for the analysis of homologous genopathy. Genopathy private query is realized by adding redundant query conditions, and secure gene sequence alignment is realized by using garbled circuit. And we propose merging truth table to implement a garbled equality gate circuit that only needs to send ciphertext once. The times of encryption and decryption reduced to a third of the general garbled equality gate circuit. Consequently, the scheme can protect the data privacy, query privacy and output privacy of both participants and has better practicability.},
 author = {Jiang, Yatong and Shang, Tao and Liu, Jianwei},
 doi = {10.1109/TSC.2023.3324976},
 issn = {1939-1374},
 journal = {IEEE Transactions on Services Computing},
 keyword = {Bioinformatics;Genomics;Data privacy;DNA;Privacy;Data models;Logic gates;Edit distance;garbled circuit;gene sequence alignment;privacy protection},
 month = {Nov},
 number = {6},
 pages = {4456-4466},
 title = {Secure Gene Sequence Alignment Based on Garbled Circuit},
 volume = {16},
 year = {2023}
}
