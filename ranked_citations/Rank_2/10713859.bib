@article{10713859,
 abstract = {A broadband flat response high sensitivity fiber Bragg grating (FBG) acceleration sensor is reported to solve the problem that the sensitivity of a vibration sensor is normally constrained by its measurement frequency range. Two sets of cantilever beams with different resonance frequencies and one set of cross beams are used to construct a unique multiresonant structure with a range of different resonance frequencies. A damping liquid is added to make the resonance peaks broaden and merge to realize a broadband flat response. The effects of the dimensional parameters of the resonant structure and the viscosity of the damping liquid on the frequency response curve of the FBG acceleration sensor are analyzed using a finite element simulation, and the optimization of each parameter is achieved. The resonant structure was fabricated and the overall package of the FBG acceleration sensor was completed using methyl silicone oil as the damping fluid. A vibration test system was built to test and analyze the frequency response characteristics of the sensor, and the results show that the sensor has a sensitivity of 203.4 pm/g and the frequency range of the flat region with an unevenness of less than 3 dB is 250~800 Hz, which is about three times better than existing reported state of the art devices.},
 author = {Duan, Chao and Xin, Sen and Tan, Tao and Wang, Xixin and Tian, Ye and Lewis, Elfed and Zhang, Jianzhong},
 doi = {10.1109/TIM.2024.3472871},
 issn = {1557-9662},
 journal = {IEEE Transactions on Instrumentation and Measurement},
 keyword = {Resonant frequency;Damping;Vibrations;Sensitivity;Fiber gratings;Accelerometers;Resonance;Frequency measurement;Structural beams;Frequency response;Bandpass;fiber Bragg grating (FBG) acceleration sensor;high sensitive;high-frequency;multiresonant structure},
 month = {},
 number = {},
 pages = {1-7},
 title = {Broadband Flat Response High Sensitivity FBG Accelerometer Based on Multiresonance Structure},
 volume = {74},
 year = {2025}
}
