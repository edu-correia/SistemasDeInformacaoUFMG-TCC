@article{ZHOU2025110814,
 abstract = {Given the intricate nature of grape picking conditions and the close proximity of adjacent grape bunches, which affects the accuracy of picking point localization, this study proposes a multi-task perception and three-dimensional picking point localization method for grapes based on structural constraints and geometric analysis. The objective is to minimize the risks associated with collisions between the end-effector and bearing branches, as well as grape clusters, while reducing the potential for inadvertent damage, harvesting failures, and fruit detachment, ultimately preserving fruit integrity and commercial value. Firstly, an improved PG-YOLACT++ network has been developed by integrating the SimAM attention mechanism and the Mish efficient activation function, facilitating the simultaneous recognition of grape key structures. A subordinate judgment and merging method has been devised to merge key structures of the same grape bunch. Additionally, a selection method for the peduncle region of interest (RoI) based on range reselection has been designed, and five preliminary peduncle models have been constructed. This study integrates the end-effector structure with key points of the entire peduncle region within the RoI (EPWR) to establish picking point constraint rules and decision-making solutions for various peduncle types, including 3D picking point positioning. Experimental results show that the mean average precision of bounding-box object detection and mask segmentation achieved by PG-YOLACT++ is 81.6 % and 74.3 %, respectively, which represents increases of 2.2 and 2.6 percentage points compared to the original YOLACT++. The accuracy of the subordinate judgment and merging algorithm is 94.2 %. Compared to selecting the midpoint between the leftmost and rightmost points of the entire peduncle at its vertical midpoint as harvesting points, using the midpoint of the EPWR’s leftmost and rightmost points at its vertical midpoint achieves a 67.1 % improvement in secure positioning success. By eliminating bunches whose EPWR does not satisfy the end-effector harvesting criteria, the constraint rules and decision solutions effectively reduce instances where the picking location falls below the bifurcation point of the peduncle. The median error of depth measurement for picking point localization under indoor and outdoor conditions is calculated as 0.746 and −1.192 mm, and the median absolute deviation under indoor and outdoor conditions is calculated as 0.6710 and 0.9525 mm, respectively. This research lays the foundation for low-damage harvesting of cluster fruits in unstructured environments.},
 author = {Xinzhao Zhou and Xiangjun Zou and Hewei Meng and Fengyun Wu and Shang Chen and Xiwen Luo},
 doi = {https://doi.org/10.1016/j.compag.2025.110814},
 issn = {0168-1699},
 journal = {Computers and Electronics in Agriculture},
 keyword = {Machine vision, Picking robot, Key structures merging, Picking point constraint rules, Localization and decision-making},
 pages = {110814},
 title = {Multi-task perception and three-dimensional picking point localization method for grapes based on structural constraints and geometric analysis},
 url = {https://www.sciencedirect.com/science/article/pii/S0168169925009202},
 volume = {238},
 year = {2025}
}
