@inproceedings{11069783,
 abstract = {The research introduces a fresh model architecture that integrates Vision Transformer (ViT) with VGG-16 for a precise papaya leaf disease identification system because deep learning requires innovative early detection solutions. The classification contains five distinct groups depicted in the figure as RingSpot (533 samples), Curl (585 samples), Anthracnose (355 samples), Bacterial Spot (458 samples), and Healthy (228 samples) leaves. Both traditional CNN-based models fail to display global features, and transformers face limitations when processing small datasets because of difficulty capturing local details. We suggest building an integrated network design that merges VGG-16’s hierarchical feature extraction capabilities with the global attention properties delivered by Vision Transformers. The VGG-16 network first picks up local features, and then these features are passed to transformer layers to identify both long-range connections between elements and their context. The combined model structure improves its capability to recognize very slight disease patterns. The experimental research achieves 95% classification precision, which surpasses single models and existing benchmark benchmarks. This model demonstrates advanced precision as well as operational stability for all five classes in circumstances of dataset imbalance. The study demonstrates the diagnostic advantages of combining deep learning algorithms to create improved technology that will enhance systems for monitoring remote papaya diseases.},
 author = {Arekar, Mugdha and Patel, Shrina and Velani, Nisha},
 booktitle = {2025 3rd International Conference on Inventive Computing and Informatics (ICICI)},
 doi = {10.1109/ICICI65870.2025.11069783},
 issn = {},
