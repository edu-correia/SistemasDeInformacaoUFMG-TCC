@inproceedings{9959251,
 abstract = {Magnetic integration effectively reduces the total magnetic volume for a converter with multiple magnetic components. However, the existing solutions still face some problems, such as large core cross-sectional area due to the small effective inductor winding number or low PCB utilization due to unreasonable winding structure design. This paper proposed an integrated magnetic structure for the resonant inductor and transformer with a small core volume. By the proper winding arrangement, the integrated resonant inductor is constructed by both side of the transformer windings, which not only increases the effective inductor winding number but also improves the utilization of the PCB. What is more, the inductor core plate and the transformer core plate are integrated, which furtherly reduce the core size. Finally, a 2kW CLLC prototype is established to verify the performance of the proposed integrated magnetics (IM) and its design methodology.},
 author = {Yang, Jinxu and Wu, Xinke},
 booktitle = {2022 IEEE International Power Electronics and Application Conference and Exposition (PEAC)},
 doi = {10.1109/PEAC56338.2022.9959251},
 issn = {},
 keyword = {Windings;Magnetic resonance;Prototypes;Transformer cores;Transformers;Frequency conversion;Power electronics;High frequency;magnetic integration;high PCB utilization;on-board charger;resonant converter},
 month = {Nov},
 number = {},
 pages = {828-832},
 title = {High Density Planar Integrated Magnetics with Two-sided Merged Inductor Windings and Cores for Resonant DC/DC Converter},
 volume = {},
 year = {2022}
}
