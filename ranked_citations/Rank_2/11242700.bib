@inproceedings{11242700,
 abstract = {Semantic segmentation of high-resolution UAV images is critical for online environmental awareness and rapid emergency response. However, many current network models are over-parameterized and require massive computational resources, making it difficult to balance segmentation accuracy and inference efficiency for large-scale and high-resolution UAV images. To address this issue, we proposed an efficient semantic segmentation network that employs the Local-Global-Local information exchange mechanism to achieve local information aggregation, global sparse attention, and local information propagation, which optimizes the processing efficiency of local-wise semantic information and global-wise contextual dependencies. In addition, we observed that many local-wise tokens extracted from high-resolution UAV images are highly similar. To exploit this property, we introduced an adaptive local-wise token merge strategy to further reduce the computational complexity of full matrix multiplications for the feed-forward layers. Compared to other lightweight semantic segmentation methods, our model achieved a better balance between segmentation accuracy and inference efficiency with an image size of 1024 × 2048. Experiments show that our network outperforms existing models on two high-resolution UAV image datasets, UAVid and FloodNet, achieving mean intersection over union (mIoU) of 69.62% and 77.37%, respectively.},
 author = {Deng, Changjian and Zhou, Zijing and Yang, Zhiguo and Zhang, Yijie and Xia, Ziying and Cheng, Jian},
 booktitle = {IGARSS 2025 - 2025 IEEE International Geoscience and Remote Sensing Symposium},
 doi = {10.1109/IGARSS55030.2025.11242700},
 issn = {2153-7003},
 keyword = {Adaptation models;Visualization;Accuracy;Semantic segmentation;Computational modeling;Merging;Semantics;Autonomous aerial vehicles;Computational efficiency;Information exchange;Efficient semantic segmentation;High-resolution images;Adaptive token merging;Unmanned aerial vehicle},
 month = {Aug},
 number = {},
 pages = {8024-8028},
 title = {Efficient Local-Global-Local Information Exchange with Adaptive Token Merging for High-Resolution UAV Image Semantic Segmentation},
 volume = {},
