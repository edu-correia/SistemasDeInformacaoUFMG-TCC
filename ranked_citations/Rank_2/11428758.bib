@inproceedings{11428758,
 abstract = {Artificial light-emitting synaptic devices, serving as the fundamental hardware foundation for building brain-inspired computers and artificial intelligence systems, have made significant strides in achieving high-efficiency, low-power neuromorphic computing by emulating the optoelectronic cooperative plasticity of biological synapses. These devices integrate the high-speed transmission and parallel processing advantages of optical signals with the precise modulation capabilities of electrical signals, offering a revolutionary solution to overcome the “memory wall” bottleneck inherent in traditional von Neumann architectures. This review summarizes the latest research progress in artificial light-emitting synaptic devices, with a focus on analyzing the design principles and performance characteristics of representative devices, including long-afterglow organic light-emitting transistors (LAOLETs), light-emitting electrochemical artificial synapses (LEEASs), quantum dot-based light-emitting synapses, and lightemitting memristors (LEMs). These devices not only successfully replicate core synaptic functionalities such as short-term/long-term plasticity and spike-timing-dependent plasticity (STDP) but also enable integrated information processing and display through dual optoelectronic outputs, laying the hardware groundwork for braininspired intelligent systems that merge sensing, memory, computing, and display functions. Although challenges remain in device stability, large-scale integration, and inhibitory synaptic emulation, artificial lightemitting synaptic devices have demonstrated immense potential in applications such as biomimetic vision and neuromorphic displays. Future advancements in material optimization, structural innovation, and system integration, along with the development of optically reconfigurable synapses and multimodal cooperative modulation technologies, will drive brain-inspired computing hardware toward higher levels of intelligence and adaptability, providing core hardware support for next-generation artificial intelligence systems.},
 author = {Luo, Zibin and Zhang, Yiping and Liu, Baiquan},
 booktitle = {2025 International Conference on Energy, Materials, and Photonics (EMP)},
 doi = {10.1109/EMP67345.2025.11428758},
 issn = {},
 keyword = {Integrated optics;Biomedical optical imaging;Neuromorphic engineering;Artificial light;Hardware;Optical sensors;Optical modulation;Transistors;Synapses;High-speed optical techniques;artificial light-emitting synaptic;neuromorphic computing;LAOLET;LEEAS;LEM;QLED},
 month = {Aug},
 number = {},
 pages = {1-11},
 title = {Principles and Research Progress of Artificial Lightemitting Synaptic Devices},
 volume = {},
