@article{9399104,
 abstract = {Achieving the attractive error-correcting capability with a simple decoder structure, the polar code using successive cancellation (SC) decoding is now expected to be installed at the resource-limited IoT or embedded communications. However, the existing SC decoders normally suffer from the long processing latency caused by the serialized processing steps, limiting the practical applications of polar codes. In this article, to solve this latency problem, we present a new low-complexity merging operation that can increase the number of parallel factors for realizing the tree-level parallelism. We also modify the previous pruning method to further reduce the number of visited nodes at the parallel SC decoding scenario. In addition, a novel parallel partial-sum calculator (PSC) architecture is introduced to update partial-sum registers with multiple decoded bits by taking only one processing cycle. Implementation results show that the proposed 8-parallel SC polar decoder in 28-nm CMOS requires only 0.140  $\mu \text{s}$  to decode a (1024, 512) codeword of 5G system, remarkably reducing the decoding latency when compared to the state-of-the-art designs.},
 author = {Kam, Dongyun and Yoo, Hoyoung and Lee, Youngjoo},
 doi = {10.1109/TVLSI.2021.3068965},
 issn = {1557-9999},
 journal = {IEEE Transactions on Very Large Scale Integration (VLSI) Systems},
 keyword = {Maximum likelihood decoding;Polar codes;Merging;Parallel processing;Computer architecture;5G mobile communication;Very large scale integration;5G communications;low-latency processing;parallel decoder;polar codes;successive-cancellation decoding},
 month = {June},
 number = {6},
 pages = {1083-1094},
 title = {Ultralow-Latency Successive Cancellation Polar Decoding Architecture Using Tree-Level Parallelism},
 volume = {29},
 year = {2021}
}
