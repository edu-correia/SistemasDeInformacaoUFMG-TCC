@inproceedings{11415126,
 abstract = {The substation monitoring information point lists (SMIPLs) serve as a core foundational document that standardizes the naming, coding, and attributes of monitoring data, enabling real-time equipment status monitoring, rapid fault localization, and coordinated dispatching operations. To address challenges in manual compilation such as time-consuming processes, inconsistent output quality, and quality assurance issues, an automatic generation method of SMIPLs is proposed based on logical relation description model. Firstly, a common template library (CTL) is created through modular, structured, and sequential organization of SMIPLs. Secondly, based on the system topology description model, the system automatically matches data from the substation with the CTL to generate preliminary SMIPLs. Finally, by comparing and merging data from the preliminary teleindication information point list with the data in substation physical description model, the complete SMIPLs are generated. Application results demonstrate that the proposed method significantly enhances the efficiency of compilation and review, providing technical support for subsequent software development in substation monitoring system.},
 author = {Wang, Xiaoxu and Li, Zehui and Wu, Congying and Guo, Yachang and Zhai, Tao and Cao, Xiaoxia},
 booktitle = {2025 7th International Academic Exchange Conference on Science and Technology Innovation (IAECST)},
 doi = {10.1109/IAECST68792.2025.11415126},
 issn = {},
 keyword = {Technological innovation;Substations;Quality assurance;Reviews;Standards organizations;Data models;Libraries;Topology;Monitoring;Software development management;Substation monitoring information point lists;common template library;system topology description;substation physical description;synonym matching library;cosine similarity},
 month = {Dec},
 number = {},
 pages = {726-738},
 title = {Automatic Generation Method of Substation Monitoring Information Point Lists Based on Logical Relation Description Model},
 volume = {},
