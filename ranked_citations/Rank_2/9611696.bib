@inproceedings{9611696,
 abstract = {With the continuous development of life science, the 21st century has become an era of biological big data. In the post-genome era, the focus of research begins to shift to large-scale genome analysis and the comparison and integration of various data, resulting in the emergence of genome-wide association analysis (GWAS). It uses single nucleotide polymorphisms (SNPs) as molecular genetic markers to analyze them at the genome-wide level to find genetic variations that affect complex traits. However, due to the differences in research methods, sample sizes and other factors, multiple GWAs for the same research problem often have different research results. An effective and comprehensive solution is to use Meta-analysis to conduct quantitative and comprehensive evaluation of these results, so as to identify significant variations more accurately. With the increasing application of meta-analysis in clinical medicine and genetic research, a large number of relevant theoretical algorithms have been studied, but higher sensitivity and lower type I error rate are still the goals of scholars. Based on this, this paper studied the existing Meta-analysis methods in depth, and proposed a MRSF algorithm based on random symbol flip to solve the defect that conventional statistical hypothesis might lead to higher false solidity in the traditional method, and compared the other four p-value combination methods on the triglyceride gene data set. The experimental results showed that, The MRSF approach overall has a better ability to identify valid variants.},
 author = {Tong, Chunyan and Zhang, Zhaogong},
 booktitle = {2021 International Conference on Machine Learning and Intelligent Systems Engineering (MLISE)},
 doi = {10.1109/MLISE54096.2021.00036},
 issn = {},
 keyword = {Sensitivity;Error analysis;Merging;Genomics;Machine learning;Probability;Life sciences;Biological big data;GWAS;SNP;Meta-analysis;p-value},
 month = {July},
 number = {},
 pages = {161-166},
 title = {MRSF: A Meta-analysis Method Based on Random Sign Flip},
 volume = {},
 year = {2021}
