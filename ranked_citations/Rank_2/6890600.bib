@inproceedings{6890600,
 abstract = {This paper presents our system designed for MSR-Bing Image Retrieval Challenge @ ICME 2014. The core of our system is formed by a text processing module combined with a module performing PCA-assisted perceptron regression with random sub-space selection (P2R2S2). P2R2S2 uses Over-Feat features as a starting point and transforms them into more descriptive features via unsupervised training. The relevance score for each query-image pair is obtained by comparing the transformed features of the query image and the relevant training images. We also use a face bank, duplicate image detection, and optical character recognition to boost our evaluation accuracy. Our system achieves 0.5099 in terms of DCG25 on the development set and 0.5116 on the test set.},
 author = {Raitoharju, J. and Zhang, H. and Ozan, E.C. and Waris, M.A. and Faisal, M. and Cao, G. and Roininen, M. and Ahmad, I. and Shetty, R. and S. P.C. and Uhlmann, S. and Samiee, K. and Kiranyaz, S. and Gabbouj, M.},
 booktitle = {2014 IEEE International Conference on Multimedia and Expo Workshops (ICMEW)},
 doi = {10.1109/ICMEW.2014.6890600},
 issn = {1945-7871},
 keyword = {Training;Face;Vectors;Optical character recognition software;Reliability;Feature extraction;Detectors;Image Retrieval;Relevance Evaluation;Data Partitioning;Face Bank},
 month = {July},
 number = {},
 pages = {1-6},
 title = {Tut MUVIS image retrieval system proposal for MSR-Bing challenge 2014},
 volume = {},
 year = {2014}
}
