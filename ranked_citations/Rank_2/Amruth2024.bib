@conference{Amruth2024,
 abstract = {String matching plays a crucial role in applications, such involving retrieval of information, data mining, natural language processing, and biology with computation. However, existing string-matching algorithms, including the Naïve Method, KMP Algorithm, Rabin-Karp Algorithm, and Suffix Array, often suffer from limitations in terms of time complexity or space complexity. Considering these shortcomings, this paper presents a novel string-searching algorithm that harnesses Merge sort and binary search techniques to optimize time complexity, while maintaining the same space complexity as traditional approaches. Drawing on compiler analysis, the proposed algorithm demonstrates a major improvement in computational time, The proposed algorithm demonstrates a major improvement in time complexity, outperforming sophisticated methods by up to 50% in the best-case scenario and matches the other algorithms in terms of speed in the worst case scenario. This advancement makes the proposed algorithm -Fastrack-StringSearch-suited for large-scale text processing. © 2024 IEEE.},
 author = {Amruth, A. and Ramanan, R. and Paul, Rhea and Vimal, C. and Belwal, Meena},
 doi = {10.1109/ICCCNT61001.2024.10724792},
 journal = {2024 15th International Conference on Computing Communication and Networking Technologies, ICCCNT 2024},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Advancements in String-Searching Algorithms Fastrack-StringSearch: A Novel Approach},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85211187487?origin=resultslist},
 year = {2024}
}
