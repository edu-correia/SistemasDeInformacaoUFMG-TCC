@inproceedings{5565722,
 abstract = {GIS as a new technology and subject has merged into everyday life. While based on the rapid development of modern technologies, many new type of information has been playing an important role as well, such as pictures, audio and video information. More and more multimedia information have been integrated with GIS for virtual tour, driving simulator and traffic alter. The trends of GIS development have been more obvious that GIS should involve not only spatial data, attribute data of spatial entities but also the related pictures, description, audio and video files for overall impressions. Due to the rapid development of DBMS, ORDBMS has come into being for complicate information management. This paper introduced how to use ORDBMS to integrate GIS database and multi-media information. The result shows that by pseudo-pyramid model and video segmentation the mixed database can be used in digital oil and other related fields.},
 author = {Luo, Mingliang},
 booktitle = {2010 2nd International Conference on Industrial and Information Systems},
 doi = {10.1109/INDUSIS.2010.5565722},
 issn = {},
 keyword = {Computational modeling;Multimedia communication;Buffer storage;Geology;GIS;Integration framewok;database;ORDBMS},
 month = {July},
 number = {},
 pages = {345-347},
 title = {Integration framework of GIS database and multimedia information ORDBMS based},
 volume = {2},
 year = {2010}
}
