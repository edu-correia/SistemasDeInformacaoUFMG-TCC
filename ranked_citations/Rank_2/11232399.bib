@inproceedings{11232399,
 abstract = {Extracting structured tables from full-page document images remains a persistent challenge in document understanding—especially when dealing with rotated layouts, multilingual text, and visually dense structures. Many current approaches rely on pre-cropped inputs and struggle to generate semantically meaningful outputs compatible with downstream models. We present a novel deep learning framework, named EASTER, which performs holistic table recognition by directly converting full-page documents into structured Hypertext Markup Language (HTML). A key innovation is the Intersection over Union (IoU) Trick, a technique for polygon regression that leverages the Complete IoU (CIoU) loss to enable efficient, stable learning of rotated and skewed layouts without requiring customized loss formulations. To support robust training, we design a hybrid dataset pipeline that merges synthetic and real document templates with rule-based validation. Additionally, EASTER infers fine-grained cell properties such as alignment and border styles, boosting visual fidelity. Experimental evaluation highlights its strong accuracy, fast inference, and enhanced compatibility with large language models—particularly in multilingual scenarios.},
 author = {Nassar, Mohamed Ahmed and Ahmed Nasr, Omar},
 booktitle = {2025 7th Novel Intelligent and Leading Emerging Sciences Conference (NILES)},
 doi = {10.1109/NILES68063.2025.11232399},
 issn = {},
 keyword = {Training;Visualization;Technological innovation;Text analysis;Layout;Semantics;Benchmark testing;HTML;Real-time systems;Multilingual;table detection;structure recognition;IoU optimization;document analysis;layout understanding},
 month = {Oct},
 number = {},
 pages = {129-133},
 title = {EASTER: End-to-End Alignment and Style-Aware Table Extraction and Recognition},
 volume = {},
 year = {2025}
}
