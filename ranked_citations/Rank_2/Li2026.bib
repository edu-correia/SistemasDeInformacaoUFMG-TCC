@article{Li2026,
 abstract = {When Internet of Things (IoTs) devices operate in the dense 2.4 GHz band, severe cross-interference with incumbent networks like Wi-Fi degrades total throughput. While cognitive radio (CR) can replace short-term contention with predictive access to improve long-term performance, existing designs ignore system delays, causing decision-execution mismatch and impractical deployment. We propose Hi-MAC, a gateway-assisted spectrum sharing system that uses machine learning for long-term channel access decisions. It generates an opportunity times list for future devices' transmissions, allowing devices to skip outdated slots and use valid ones despite delays. Key contributions include a low-latency end-to-end neural network with incremental learning, a signaling synchronization mechanism, and coordinated end-edge operations to mitigate hidden/exposed nodes. Implemented on software-defined radio-based gateways and IoT devices, Hi-MAC realizes at least 15% higher packet reception rate and 1.42-7.4× better delivery-loss ratio than other access solutions, demonstrating fewer transmission attempts and less interference to coexisting networks. It not only delivers near-optimal own throughput for IoT but also minimizes its impact on the throughput of incumbent networks. In two evaluated cases, the total throughput achieved by Hi-MAC is 131% and 121% of that of other methods with comparable performance. Besides, the prototype performs fast inference only in 1.93 ms, with > 95% time utilization per inference cycle. © 2002-2012 IEEE.},
 author = {Li, Wenhui and Deng, Yibin and Zhu, Fengyuan and Lei, Jiazhen and Zhong, Linling and Yang, Zeming and Wang, Bingbing and Tian, Xiaohua},
 doi = {10.1109/TMC.2026.3686394},
 journal = {IEEE Transactions on Mobile Computing},
