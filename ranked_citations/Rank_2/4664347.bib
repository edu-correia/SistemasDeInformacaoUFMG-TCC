@inproceedings{4664347,
 abstract = {Retrieving specific information becomes an important issue, especially in XML Information Retrieval (XML-IR). Indexing XML components (elements) rather than the entire XML document allows to target more effectively the relevant elements. In this paper, we consider the problem of ranking the relevant components returned in response to a user query. As opposed to ranking documents, ranking XML elements introduces new criteria to take into account in determining the degree of relevance of a component, as for example the granularity of an XML component or the proximity of query keywords within the XML structure. Our aim is to answer two questions : Which criteria reflect best the relevance of an XML component ? and how can these criteria be combined to obtain an efficient scoring function in order to calculate the degree of relevance of an XML component ?},
 author = {Abbaci, Faiza and Francq, Pascal},
 booktitle = {2008 First International Conference on the Applications of Digital Information and Web Technologies (ICADIWT)},
 doi = {10.1109/ICADIWT.2008.4664347},
 issn = {},
 keyword = {XML;Information retrieval;Computational modeling;Indexes;Hands;Frequency measurement;Automobiles;Structured Query Language;Strips;Q measurement},
 month = {Aug},
 number = {},
 pages = {216-222},
 title = {XML components ranking : Which relevant ranking criteria ? Which relevant criteria merging ?},
 volume = {},
 year = {2008}
}
