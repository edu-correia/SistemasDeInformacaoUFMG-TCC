@inproceedings{5745851,
 abstract = {Mobile terminals like smart phones, mobile phones are becoming more and more popular and increasing day by day in recent years in India. However, the data on them is still managed in a way similar to that for traditional databases. This study proposes a method of file structure specifications in a fuzzy query database system which supports a search engine for component selection and which performs efficient and accurate queries. In this paper, we have developed a fuzzy database file structure frame work for mobile environment for solving transition between the terminals. A key requirement in such an environment is to support frequent connection and disconnection of database sites. We start with the overall architecture of the Fuzzy database, which is followed with some specific design issues like query, schema and transactions.},
 author = {Rao, N. Mallikharjuna and Naidu, M. M and Seetharam, P.},
 booktitle = {13th International Conference on Advanced Communication Technology (ICACT2011)},
 doi = {},
 issn = {1738-9445},
 keyword = {Mobile communication;Mobile computing;Organizing;Indexing;Distributed databases;Fuzzy Query;Fuzzy Database;Mobile network},
 month = {Feb},
 number = {},
 pages = {447-452},
 title = {An intelligent data structure approaches for mobile devices},
 volume = {},
 year = {2011}
}
