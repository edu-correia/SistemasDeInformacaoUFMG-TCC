@conference{El-Helw2014295,
 abstract = {The impact and significance of parallel computing techniques is continuously increasing given the current trend of incorporating more cores in new processor designs. However, many Big Data systems fail to exploit the abundant computational power of multicore CPUs and GPUs to their full potential. We present Glasswing, a scalable MapReduce framework that employs a configurable mixture of coarse- and fine-grained parallelism to achieve high performance on multi-core CPUs and GPUs. We experimentally evaluated the performance of five MapReduce applications and show that Glasswing outperforms Hadoop on a 64-node multi-core CPU cluster by a factor between 1.8 and 4, and by a factor from 20 to 30 on a 16-node GPU cluster. Copyright © 2014 ACM.},
 author = {El-Helw, Ismail and Hofman, Rutger and Bal, Henri E.},
 doi = {10.1145/2600212.2600706},
 journal = {HPDC 2014 - Proceedings of the 23rd International Symposium on High-Performance Parallel and Distributed Computing},
 note = {Cited by: 12},
 pages = {295 - 298},
 publication_stage = {Final},
 source = {Scopus},
 title = {Glasswing: Accelerating MapReduce on multi-core and many-core clusters},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84904431076?origin=resultslist},
 year = {2014}
}
