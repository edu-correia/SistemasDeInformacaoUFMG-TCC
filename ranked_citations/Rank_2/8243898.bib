@inproceedings{8243898,
 abstract = {In order to improve picking efficiency of the automatic picking system with preparatory picking buffer and solve the adaptation problem between order structure and equipment, a mathematical model of picking efficiency is established. The model is based on parallel picking. To solve the model, a heuristic algorithm is proposed for allocating picking tasks. The correlation between single order picking quantity and preparatory picking slide capacity is built by simulating and analyzing the influence of these two factors on the picking efficiency. On this basis, the optimal preparatory picking slide capacity can be selected according to order structure of the distribution center. Simulation experiments of a distribution center showed that optimizing preparatory picking slide capacity could increase picking efficiency by 5.05%.},
 author = {Cao, Weijie and Wu, Yaohua and Xiao, Jiwei and Wu, Yingying},
 booktitle = {2017 Chinese Automation Congress (CAC)},
 doi = {10.1109/CAC.2017.8243898},
 issn = {},
 keyword = {Merging;Heuristic algorithms;Algorithm design and analysis;Resource management;Sorting;Simulation;automatic picking system;picking efficiency;single order picking quantity;preparatory picking slide capacity},
 month = {Oct},
 number = {},
 pages = {6223-6227},
 title = {The equipment optimization of automatic picking system based on preparatory picking buffer},
 volume = {},
 year = {2017}
}
