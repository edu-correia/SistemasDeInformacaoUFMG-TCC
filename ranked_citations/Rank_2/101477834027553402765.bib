@article{10.14778/3402755.3402765,
 abstract = {Tenzing is a query engine built on top of MapReduce [9] for ad hoc analysis of Google data. Tenzing supports a mostly complete SQL implementation (with several extensions) combined with several key characteristics such as heterogeneity, high performance, scalability, reliability, metadata awareness, low latency, support for columnar storage and structured data, and easy extensibility. Tenzing is currently used internally at Google by 1000+ employees and serves 10000+ queries per day over 1.5 petabytes of compressed data. In this paper, we describe the architecture and implementation of Tenzing, and present benchmarks of typical analytical queries.},
 author = {Chattopadhyay, Biswapesh and Lin, Liang and Liu, Weiran and Mittal, Sagar and Aragonda, Prathyusha and Lychagina, Vera and Kwon, Younghee and Wong, Michael},
 doi = {10.14778/3402755.3402765},
 issn = {2150-8097},
 issue_date = {August 2011},
 journal = {Proc. VLDB Endow.},
 month = {August},
 number = {12},
 numpages = {10},
 pages = {1318–1327},
 publisher = {VLDB Endowment},
 title = {Tenzing a SQL implementation on the MapReduce framework},
 url = {https://doi.org/10.14778/3402755.3402765},
 volume = {4},
 year = {2011}
}
