@inproceedings{1410202,
 abstract = {This paper describes batching, a novel technique in order to improve the throughput of an information filter (e.g. message broker or publish & subscribe system). Rather than processing each message individually, incoming messages are reordered, grouped and a whole group of similar messages is processed. This paper presents alternative strategies to do batching. Extensive performance experiments are conducted on those strategies in order to compare their tradeoffs.},
 author = {Fischer, P.M. and Kossmann, D.},
 booktitle = {21st International Conference on Data Engineering (ICDE'05)},
 doi = {10.1109/ICDE.2005.25},
 issn = {2375-026X},
 keyword = {Information filters;Indexing;Information filtering;Throughput;Scalability;Delay;Databases;Connectors;Query processing;XML},
 month = {April},
 number = {},
 pages = {902-913},
 title = {Batched processing for information filters},
 volume = {},
 year = {2005}
}
