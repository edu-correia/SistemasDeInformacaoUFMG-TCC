@inproceedings{4217464,
 abstract = {Nonnegative matrix factorization (NMF) is a widely-used method for multivariate nonnegative data analysis, due to its ability to learn a parts-based representation. However, the standard NMF algorithm does not always find spatially localized basis images in practice, unless sparseness constraints are employed. In this paper we present a method of structured initialization which enables the standard NMF algorithm to find spatially localized basis images. The initialization method is based on the hierarchical clustering of attributes through a similarity measure reflecting 'closeness to rank-one'. Numerical experiments with face image data, confirm the validity of our initialization method.},
 author = {Kim, Yong-Deok and Choi, Seungjin},
 booktitle = {2007 IEEE International Conference on Acoustics, Speech and Signal Processing - ICASSP '07},
 doi = {10.1109/ICASSP.2007.366291},
 issn = {2379-190X},
 keyword = {Clustering algorithms;Matrix decomposition;Convergence;Data analysis;Principal component analysis;Independent component analysis;Computer science;Feature extraction;Pattern clustering;Pattern classification;Feature extraction;matrix decomposition;pattern clustering methods;pattern classification;unsupervised learning},
 month = {April},
 number = {},
 pages = {II-537-II-540},
 title = {A Method of Initialization for Nonnegative Matrix Factorization},
 volume = {2},
 year = {2007}
}
