@conference{Li2014535,
 abstract = {There are rare index techniques that can index massive continuously incoming data and archive it in an efficient way. To solve this problem, we proposed B+- tree-based index techniques named AO-Tree (Append-Only Tree), we revise its rightmost children and set no restriction to the members of a nodes. Toward the monotonic attribute of the data which need add to the existing index structure, the indexing of this attribute are occurs in the rightmost children of the root node. Therefore there are no node split during the data insertion. After above revision, the AO-Tree become efficiently in append the fast incoming monotonic data into the existing data archive. Further, we propose a strategy to combine AO-Tree with HBase for distributed indexing and store of continuously incoming massive data sets. The experimental results demonstrated the efficiency of the proposed techniques. © 2014 WIT Press.},
 author = {Li, Hui and Chen, Mei},
 doi = {10.2495/ICACC130691},
 journal = {WIT Transactions on Information and Communication Technologies},
 note = {Cited by: 0},
 pages = {535 - 541},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Append-Efficient index for continuous arriving massive data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84908027688?origin=resultslist},
 volume = {59},
 year = {2014}
}
