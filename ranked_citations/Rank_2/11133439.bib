@article{11133439,
 abstract = {This paper presents a novel broadband single-fed circularly polarized (CP) patch antenna that achieves unprecedented bandwidth performance by leveraging the interaction between dominant (TM10, TM01) and second-order (TM20, TM02) modes. Unlike conventional designs, this antenna achieves simultaneous excitation and mode merging by strategically increasing the air gap between a suspended radiator and the ground plane. This alignment transforms the typical dual-beam radiation of second-order modes into a desirable single-beam broadside pattern. To achieve CP, a square slot, corner truncations, and feed displacement are used to excite orthogonal modes with appropriate phase shifts. Further, the integration of a capacitive probe feed and a capacitive shorting pin significantly enhances impedance bandwidth (IBW) and axial ratio bandwidth (ARBW), respectively. Measured results confirm the effectiveness of the proposed design, demonstrating an exceptional 71.8% IBW and 48.1% ARBW—the widest reported for a single-feed CP patch antenna to date. This work introduces a new strategy for mode control and polarization synthesis in compact patch antennas, offering a structurally simple yet high-performance solution for next-generation wireless communication systems.},
 author = {Ardekani, Mohammad Hadi Moradi and Dastranj, Aliakbar and Pashangeh, Shima},
 doi = {10.1109/OJAP.2025.3601195},
 issn = {2637-6431},
 journal = {IEEE Open Journal of Antennas and Propagation},
 keyword = {Patch antennas;Resonant frequency;Broadband antennas;Substrates;Q-factor;Broadband communication;Electric fields;Impedance;Polarization;Circular polarization (CP);patch antenna;single-fed;modes;fringing field},
 month = {Dec},
 number = {6},
 pages = {1787-1798},
 title = {Integration of Modified Degenerate Second-Order and Dominant Modes to Design a Broadband Single-Fed Circularly Polarized Patch Antenna},
 volume = {6},
 year = {2025}
}
