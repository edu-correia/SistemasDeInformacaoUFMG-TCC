@inproceedings{4631599,
 abstract = {There are many approaches in model transformation. In this paper metamodel transformation approach is used to transform elements in Object Constraint Language (OCL) and Unified Modeling Language (UML) metamodel to elements in Prototype Verification System (PVS) metamodel. The mappings of individual elements in the source metamodels to elements in the target metamodel are discussed. This paper also proposed a metamodel for PVS specification language.},
 author = {Rahim, Lukman Ab.},
 booktitle = {2008 International Symposium on Information Technology},
 doi = {10.1109/ITSIM.2008.4631599},
 issn = {2155-899X},
 keyword = {Unified modeling language;Transforms;Merging;Navigation;Specification languages;Libraries;Guidelines},
 month = {Aug},
 number = {},
 pages = {1-8},
 title = {Mapping from OCL/UML metamodel to PVS metamodel},
 volume = {1},
 year = {2008}
}
