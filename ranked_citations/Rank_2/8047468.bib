@inbook{8047468,
 abstract = {Sorting is a major example of a computation. In addition to having many applications, sorting helps to explain some fundamental concepts of computer science. First, different sorting algorithms with different runtime and space requirements illustrate the impact of efficiency in deciding how to solve a problem computationally. Second, sorting is a problem for which a minimal complexity is known. In other words, we know a lower bound on the number of steps that any sorting algorithm must take.},
 author = {Erwig, Martin},
