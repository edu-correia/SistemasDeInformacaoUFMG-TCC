@conference{Groppe20101373,
 abstract = {Today's Semantic Web datasets become increasingly larger containing up to several hundred million triples. The performance of index construction is a crucial factor for the success of large Semantic Web databases. In this paper, we propose two new approaches for RDF index construction: External chunks merge sort and Distribution Sort for RDF. The former stores and retrieves chunks from a special chunks heap to speed up replacement selection. The latter leverages the RDF-specific properties to construct RDF indices and significantly improves the performance. Our experimental results show that our approaches significantly speed up RDF index construction, and are important techniques for large Semantic Web databases. © 2010 ACM.},
 author = {Groppe, Sven and Groppe, Jinghua},
 doi = {10.1145/1774088.1774382},
 journal = {Proceedings of the ACM Symposium on Applied Computing},
 note = {Cited by: 3},
 pages = {1373 - 1380},
 publication_stage = {Final},
 source = {Scopus},
 title = {External sorting for index construction of large semantic web databases},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/77954713981?origin=resultslist},
 year = {2010}
}
