@conference{Wang201269,
 abstract = {Industrialization is a pivotal process to enhance the competition of country. With the development of industry in China, the traditional industrialization path which focuses on the enlarge of inputs of energy and human resource expressed more disadvantages. To keep the high speed of development in industry and enhance the competitive capability in China, we should accept more information technology to support and guarantee the development of industrialization. The PCA (principle component analysis) method is applied to extract main factors in the process of industrialization and informationization separately. By using statistic correlation method, we can prove the relationship between industrialization and informationization. Based on the inner correlation of industrialization and informationization, we applied DEA models to calculate the integration level of 17 cities in Shandong province and proposed corresponding measures on develop the type of industrialization. ©2012 IEEE.},
 author = {Wang, Keyu and Li, Ning},
 journal = {Proceeding of 2012 International Conference on Information Management, Innovation Management and Industrial Engineering, ICIII 2012},
 note = {Cited by: 0},
 pages = {69 - 72},
 publication_stage = {Final},
 source = {Scopus},
 title = {Inner correlation and mutual interaction between industrulization and informationization in China},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84870747080?origin=resultslist},
 volume = {3},
 year = {2012}
}
