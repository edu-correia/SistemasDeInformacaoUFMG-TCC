@inproceedings{6009602,
 abstract = {Problems occur in the models integration and particularly, in the comparison phase of the integration. Previous approaches have not correctly handled the semantic integration. We propose a complete approach for integrating of UML models. First, we provide a comparison approach incorporating syntactic, structural and semantic aspects in order to detect any correspondence between the models to compare, and secondly, a semantic approach to integrate the compared models. For this purpose, we use domain ontology. In this paper, our contribution is the proposition of the different metamodels needed in the comparison and the integration phases.},
 author = {Chaouni, Samia Benabdellah and Fredj, Mounia and Mouline, Salma},
 booktitle = {2011 IEEE International Conference on Information Reuse & Integration},
 doi = {10.1109/IRI.2011.6009602},
 issn = {},
 keyword = {Unified modeling language;Semantics;Computational modeling;Syntactics;Merging;Dictionaries;Ontologies;integration;fusion;comparison;metamodels},
 month = {Aug},
 number = {},
 pages = {496-497},
 title = {Metamodels for models complete integration},
 volume = {},
 year = {2011}
}
