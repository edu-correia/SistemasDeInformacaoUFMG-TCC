@article{Broilo20103,
 abstract = {The focus of this chapter is to present a survey on the most recent advances in representation and analysis of video object trajectories, with application to indexing and retrieval systems. We will review the main methodologies for the description of motion trajectories, as well as the indexing techniques and similarity metrics used in the retrieval process. Strengths and weaknesses of different solutions will be discussed through a comparative analysis, taking into account performance and implementation issues. In order to provide a deeper insight on the exploitation of these technologies in real world products, a selection of exampleswill be introduced and examined. The set of possible applications is very wide and includes (but it is not limited to) generic browsing of video databases, as well as more specific and context-dependent scenarios such as indexing and retrieval in visual surveillance, traffic monitoring, sport events analysis, video-on-demand, and video broadcasting. © 2010 Springer-Verlag Berlin Heidelberg.},
 author = {Broilo, Mattia and Piotto, Nicola and Boato, Giulia and Conci, Nicola and De Natale, Francesco G.B.},
 doi = {10.1007/978-3-642-12900-1_1},
 journal = {Studies in Computational Intelligence},
 note = {Cited by: 22},
 pages = {3 - 32},
 publication_stage = {Final},
 source = {Scopus},
 title = {Object trajectory analysis in video indexing and retrieval applications},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/77951752675?origin=resultslist},
 volume = {287},
 year = {2010}
}
