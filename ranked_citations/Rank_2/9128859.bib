@inproceedings{9128859,
 abstract = {One of the prime reasons which is leading to the drift of the potential users from the offline to the online market is, the development and the ever emerging trend in the digital technology.This paper proposes a secure, user friendly and economic platform for people to bring in a change in the way they shop by adding in the advantages of both an online and an offline market and promoting O2O business strategy.Entire shopping process can be made handy for the end user with a mobile application along with the use of NFC (Near Field Communication). To define an inter-connectivity and suffice the needs of the user to make a shopping a whole-new experience of a Smart Shopping System for the end-user, various modules like the web module, user android application, and physical interaction with the items in the market have been discussed.This paper also proposes the solution to avoid long queues for payments with the use of NFC and/or QR Code scanning technology embedded in the smart phones and to find the product location for the item list to be bought using Shortest Path Algorithm(A* Algorithm).},
 author = {Kurle, Samidha and Meena, Mamta and Sankhe, Amruta},
 booktitle = {2019 5th International Conference On Computing, Communication, Control And Automation (ICCUBEA)},
 doi = {10.1109/ICCUBEA47591.2019.9128859},
 issn = {},
 keyword = {Economics;Technological innovation;Schedules;Merging;QR codes;Near field communication;Routing;Market research;Mobile applications;Smart phones;NFC;QR Code;Shortest Path Algorithm (A* Algorithm)},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Deployment of NFC Technology in SuperMarket: Merging of Offline and Online Markets with Routing Suggestion},
 volume = {},
 year = {2019}
}
