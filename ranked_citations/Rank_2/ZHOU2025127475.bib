@article{ZHOU2025127475,
 abstract = {As an important carrier of information transmission, the use of efficient and intelligent encryption algorithms to ensure the privacy and security of images during data transmission has always been a hot topic in interdisciplinary fields. In this paper, an encryption strategy for multi-image on account of two-dimensional hyperchaotic model and cyclic shift coding of deoxyribonucleic acid (DNA) is proposed. By addressing the deficiencies for the general chaotic mappings with two dimensions, a cross-coupling chaotic model is devised. This model can not only produce various types of chaotic systems but also reduce its design complexity. The experimental analyses on phase diagram, bifurcation diagrams, and sample entropy demonstrate that the produced chaotic model outperform the existing two-dimensional chaotic systems. Then based on it, an encryption strategy for multi-image, in which the key is relevant with the plaintext image, capable of encrypting different types and scales of images, is designed. By combining the characteristics of pixel binary bits and DNA encoding rules, a DNA cyclic shift encoding strategy is devised, which can not only increase the complexity of encoding but also enhance the safety of image. The encoded pixels are merged into DNA strands, and in the stage of confusion-diffusion, the global exchange permutation and multi-directional DNA diffusion are applied to reduce the relevance of neighboring pixels. Simulation outcomes imply that the encrypted images can achieve an NPCR of 99.6097%. The relevant simulation analysis indicates that the put forward strategy has sufficient security against differential attacks.},
 author = {Lili Zhou and Zeqin Lin and Fei Tan and Pengyu Chen},
 doi = {https://doi.org/10.1016/j.eswa.2025.127475},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 keyword = {Multiple image encryption, New hyperchaotic model, Cycle shift encoding of deoxyribonucleic acid, Image security},
 pages = {127475},
 title = {Multi-image encryption based on new two-dimensional hyperchaotic model via cyclic shift coding of deoxyribonucleic acid},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417425010978},
 volume = {281},
 year = {2025}
}
