@inproceedings{1223711,
 abstract = {We introduce a new architecture designed by applying a recently-developed mathematical model of neural network semantics using category theory. The new design has multiple subnetworks associated with different sensors and association regions. The subnetworks form individual, hierarchical representations of a body of knowledge. Subnetwork interconnections adapt to link the individual concept representations appropriately and provide knowledge coherence, representing a single knowledge hierarchy across the multi-sensor network.},
 author = {Healy, M.J. and Caudell, T.P. and Yunhai Xiao},
 booktitle = {Proceedings of the International Joint Conference on Neural Networks, 2003.},
 doi = {10.1109/IJCNN.2003.1223711},
 issn = {1098-7576},
 keyword = {Neural networks;Mathematical model;USA Councils;Coherence;Sensor phenomena and characterization;Tail;Equations;Merging},
 month = {July},
 number = {},
 pages = {1981-1986 vol.3},
 title = {From categorical semantics to neural network design},
 volume = {3},
 year = {2003}
}
