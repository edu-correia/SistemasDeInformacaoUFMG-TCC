@conference{Shen2023,
 abstract = {To improve the accuracy of tracking method and the stability of landing algorithm for UAV on the dynamic platform, a two-stage vision-based autonomous tracking and landing algorithm is proposed. The first stage is target tracking. To complete this purpose, a visual coordinate detection method based on AprilTag is used. And then K-Nearest Neighbors anomaly detection method is used to eliminate the abnormal data to improve the accuracy of velocity estimation approach. After that, the Attenuated Memory Cubature Kalman Filter (AMCKF) is applied on trajectory prediction. The second stage is autonomous landing. In this stage, a multi-sensor data adaptive fusion method is used to obtain the more accurate altitude information. The experiments show that the proposed algorithm can reduce the deviations of position and make the UAV landing process on the platform more accurately. © 2023 IEEE.},
 author = {Shen, Kaichuan and Geng, Keke and Ma, Tianxiao and Cheng, Xiaolong and Liu, Zhichao and Li, Ang},
 doi = {10.1109/CVCI59596.2023.10397339},
 journal = {Proceedings of the 2023 7th CAA International Conference on Vehicular Control and Intelligence, CVCI 2023},
 note = {Cited by: 1},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Vision-based Autonomous Tracking and Landing Method for UAV on a Dynamic Platform},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85185384774?origin=resultslist},
 year = {2023}
}
