@article{LI2025114919,
 abstract = {Conjugated metal–organic frameworks (cMOFs) represent an emergent class of compounds that integrate the properties of metal–organic frameworks (MOFs) and conjugated molecular architectures. Unlike conventional MOFs, cMOFs synergistically merge ‌tailored porosity‌ and ‌long-range charge delocalization‌, which makes them exhibit certain conductivity. However, compared to conventional electrochemical materials, the redox activity and stability of cMOFs have a large room for improvement. Here, a series of M-HHTP@NiO species (M = Co, Ni and NiCo-bimetals) were obtained through anchoring cMOFs on 2D NiO nanosheets via self-assembly. It was found that M-HHTP@NiO composites exhibited improved redox activity and electrochemical stability compared with pure cMOFs. Among them, Co-HHTP@NiO, as the positive electrode material of supercapacitors (SCs), exhibits the highest specific capacitance and cycle stability. In addition, the Co-HHTP@NiO heterostructure exhibited exceptional electrocatalytic activity for the oxygen evolution reaction (OER), requiring only 283 mV overpotential to drive 10 mA cm−2. Therefore, M-HHTP@NiO composites display great potential as bi-functional electrode materials for energy storage and conversion (ESC).},
 author = {Sijin Li and Limei Liu and Bing Li and Huan Pang and Rongmei Zhu},
 doi = {https://doi.org/10.1016/j.inoche.2025.114919},
 issn = {1387-7003},
 journal = {Inorganic Chemistry Communications},
 keyword = {Conjugated metal–organic framework, In-situ growth, Supercapacitor, Oxygen evolution reaction},
 pages = {114919},
 title = {Synergistic hybridization of conjugated metal–organic frameworks with metal oxide nanostructures: advancing electrochemical energy storage and conversion},
 url = {https://www.sciencedirect.com/science/article/pii/S1387700325010366},
 volume = {180},
 year = {2025}
}
