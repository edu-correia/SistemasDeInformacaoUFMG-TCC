@conference{Yamazawa2024272,
 abstract = {Today, the development of computer technology has led to the execution of programs using multiple threads. A context switch occurs when the operating system switches from one thread to another. The context switch saves the information necessary for the computation (context) to memory and restores the context of the next thread from memory. In real-time systems where tasks must be executed within strict time constraints, the overhead of context switches can significantly impact overall system performance. The context cache is a special cache for contexts, used as a way to reduce the overhead of context switches.In this paper, we designed and implemented a context cache for multicore RISC-V processors. This design aims to accelerate context switches within a core and thread migrations between cores, improving system responsiveness and efficiency. Our evaluation shows a substantial reduction of context switch overhead by 99% with context cache. Furthermore, when running on a single core, the performance of parallel programs using the context cache approaches the performance of single-threaded programs because the context switch overhead is negligibly small. © 2024 IEEE.},
 author = {Yamazawa, Akira and Itou, Tsutomu and Suito, Kazutoshi and Yamasaki, Nobuyuki},
 doi = {10.1109/CANDAR64496.2024.00043},
 journal = {Proceedings - 2024 12th International Symposium on Computing and Networking, CANDAR 2024},
 note = {Cited by: 2},
 pages = {272 - 278},
 publication_stage = {Final},
 source = {Scopus},
 title = {Context Cache for Multicore RISC-V Processor},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85216929323?origin=resultslist},
 year = {2024}
}
