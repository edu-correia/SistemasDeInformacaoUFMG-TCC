@inproceedings{6620336,
 abstract = {The sum-capacity of a 2-user linear deterministic interference channel (LDIC) can always be achieved with simple deterministic codes. The existence and design of such codes has been shown to be related to an underlying combinatorial structure of the channel. This is used here to explore the capacity of parallel or ergodic LDICs and LDICs with output feedback. We present simple algorithms that generate sum-rate optimal schemes in these cases. In the case of parallel LDICs this approach gives insight into when the channels are separable, i.e. when coding over component channels is not required. We further demonstrate that output feedback can change the separability of such channels.},
 author = {Saha, Suvarup and Berry, Randall A.},
 booktitle = {2013 IEEE International Symposium on Information Theory},
 doi = {10.1109/ISIT.2013.6620336},
 issn = {2157-8117},
 keyword = {Output feedback;Interference channels;Encoding;Receivers;Merging},
 month = {July},
 number = {},
 pages = {799-803},
 title = {Parallel linear deterministic interference channels with feedback: Combinatorial structure and separability},
 volume = {},
 year = {2013}
}
