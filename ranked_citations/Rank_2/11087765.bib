@inproceedings{11087765,
 abstract = {Heart disease, specifically coronary artery disease (CAD), is one of the biggest health issues globally, which calls for accurate and reliable methods in diagnosis. This study utilizes data from several CAD-related sources: Cleveland, V.A., Hungarian, and Statlog datasets, with the goal of maximizing accuracy using machine learning techniques. The applied techniques include Fast Decision Tree and pruned C4.5 decision trees on individual sources and on the combined database with key features obtained using entropy-based methods. Other models, such as Logistic Regression, k-Nearest Neighbors, Random Forest, and Neural Networks, were also tested on the integrated data. By merging datasets, this paper addresses common challenges like missing or inconsistent data, thus achieving better performance. In particular, the Random Forest model delivered the best results with a 91.75% accuracy rate. This approach demonstrates how merging datasets and utilizing advanced algorithms may lead to more reliable diagnoses while also pointing out the differences that can arise when analyzing separate data sources.},
 author = {Ahlawat, Chanchal and Dornala, Siddhanth N and Tufchi, Shivani and Vardhan Reddy, Baddam VamshPal},
 booktitle = {2025 Seventh International Conference on Computational Intelligence andCommunication Technologies (CCICT)},
 doi = {10.1109/CCICT65753.2025.00096},
 issn = {},
 keyword = {Solid modeling;Accuracy;Soft sensors;Merging;Decision trees;Reliability;Arteries;Random forests;Optimization;Diseases;Coronary Artery Disease (CAD);Machine Learning;Decision Tree;Feature Integration},
 month = {April},
 number = {},
 pages = {601-607},
 title = {Feature Integration and Decision Tree Optimization for Improved Coronary Artery Disease Classification},
 volume = {},
 year = {2025}
}
