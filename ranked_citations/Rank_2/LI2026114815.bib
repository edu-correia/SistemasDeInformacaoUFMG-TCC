@article{LI2026114815,
 abstract = {Investigation of shock-induced combustion in non-uniform mixtures is essential for advanced propulsion systems. In this work, the interaction between a shock wave and a reactive bubble containing a stratified hydrogen-oxygen mixture are numerically investigated, employing detailed chemistry and adaptive mesh refinement. By radially varying the local equivalence ratio ϕ within the bubble, this study examines how different ϕ distributions impact ignition and reaction wave propagation during shock bubble interactions. Six radial equivalence ratio distributions ϕ = 0.15/0.5/1.0→2.0 and ϕ = 2.0→0.15/0.5/1.0 (arrows indicate the change from bubble center to interface) are analysed in detail. For lean-to-rich bubbles, ignition initiates in the upstream. Double-corner vortex structures are observed when the central equivalence ratio is 0.15 or 0.5. A central equivalence ratio of 1.0 results in the coexistence of upstream detonation and downstream deflagration. For rich-to-lean bubbles, outer equivalence ratios of 0.15, 0.5, and 1.0 correspond to upstream, double, and downstream ignition modes, respectively. Large-scale vortices induced by wave interactions are prominent in bubbles with an outer equivalence ratio of 0.15. Detonation ignition in non-uniform equivalence ratio bubbles depends on the accumulation of free radicals. Non-uniform fuel/oxygen distributions affect H radical runaway dominated regions. The region with ϕ > 1.15 is governed by HO2 radical runaway. Reaction wave propagation shows anisotropy, especially the propagation velocity decreases after merging with the transmitted wave. Downstream ignition propagates more slowly than upstream ignition but achieves enhanced fuel consumption due to increased bubble compression. Additionally, interactions between reaction waves and interfaces suppress vorticity growth.},
 author = {Xin Li and Shumeng Xie and Shangpeng Li and Chaoyang Liu and Yu Pan and Huangwei Zhang},
 doi = {https://doi.org/10.1016/j.combustflame.2026.114815},
 issn = {0010-2180},
 journal = {Combustion and Flame},
 keyword = {Shock bubble interaction, Detonation, Shock-induced flame, Hydrogen, Equivalence ratio},
 pages = {114815},
 title = {Shock-induced ignition and reaction wave propagation in a stratified hydrogen bubble},
 url = {https://www.sciencedirect.com/science/article/pii/S0010218026000519},
 volume = {286},
 year = {2026}
}
