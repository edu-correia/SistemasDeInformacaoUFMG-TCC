@inproceedings{11283509,
 abstract = {As manufacturing accelerates its evolution toward intelligent and digital transformation, digital twin technology has emerged as a core enabler for merging virtual and physical domains and driving intelligent decision-making. However, it faces challenges in knowledge modeling, including weak multi-scale correlations and difficulties in integrating multi-source heterogeneous data. To address this, a five-layer digital twin control system framework was first designed, covering the entire lifecycle from data acquisition to intelligent decision-making. Subsequently, a multi-scale modeling approach based on ontologies and knowledge graphs was proposed. By employing hierarchical knowledge representation, three-tier ontology models and knowledge graphs were constructed at the equipment, process, and system levels, enabling reasoning and optimization of knowledge related to equipment status, process flows, and system resources. Using metal cutting process monitoring as an application demonstration, cutting force analysis and chip thickness prediction were performed to validate the method’s effectiveness. This approach provides robust support for twin knowledge integration and control system decision-making.},
 author = {Wang, Wei and Ji, Lixia and Chen, Yunfeng and Zhang, Han},
 booktitle = {2025 5th International Conference on Electronic Information Engineering and Computer Science (EIECS)},
 doi = {10.1109/EIECS67708.2025.11283509},
 issn = {},
 keyword = {Decision making;Semantics;Metals;Knowledge graphs;Ontologies;Control systems;Data models;Cognition;Digital twins;Optimization;Digital twin;multi-level ontology;knowledge graph;intelligent system;metal cutting},
 month = {Sep.},
 number = {},
 pages = {758-764},
 title = {Research on Multi-Scale Knowledge Modeling Method Based on Digital Twin Control System},
 volume = {},
 year = {2025}
}
