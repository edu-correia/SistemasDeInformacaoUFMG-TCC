@article{LI2025114081,
 abstract = {Edge extraction pivotal in applications ranging from biomedical diagnosis to autonomous systems, yet conventional methods struggle in scenarios where direct imaging is infeasible, such as through multimode fibers (MMFs) that scatter light into speckle patterns due to mode dispersion. While existing efforts focus on reconstructing images from speckles, direct edge extraction, which is critical for real-time diagnosis and resource-constrained environments, remains unaddressed. Here we introduce a novel approach, transmission matrix-improved spiral phase filters (TM-ISPF), to achieve single-shot, direction-controllable spiral phase contrast imaging (SPCI) directly from MMF-generated speckle patterns, bypassing conventional image reconstruction. By synergizing a pre-calibrated transmission matrix with a dual-topological-charge spiral phase filter (+1/-1) and adaptive amplitude masking, our approach overcomes persistent challenges of noise, non-uniform edge intensity, and pixel discontinuity inherent in prior methods. Experiments demonstrate markedly enhanced edge clarity and contrast, enabling robust edge extraction for both amplitude (e.g., resolution targets) and phase objects (e.g., transparent UV-glue droplet) with minimal background interference. This breakthrough opens avenues for minimally invasive endoscopic imaging by integrating with reflective MMF probes, as well as industrial applications like defect detection in optically scattering environments. By merging computational robustness with optical simplicity, TM-ISPF establishes a new paradigm for edge-enhanced imaging through complex media, with transformative potential in precision medicine, robotics, and intelligent manufacturing.},
 author = {Haoran Li and Zhiyuan Wang and Chi Man Woo and Shengfu Cheng and Ziyang Chen and Zhihai Qiu and Zhipeng Yu and Tianting Zhong and Puxiang Lai},
 doi = {https://doi.org/10.1016/j.optlastec.2025.114081},
 issn = {0030-3992},
 journal = {Optics & Laser Technology},
 keyword = {Spiral phase contrast imaging, Multimode fiber, Speckle, Edge detection, Wavefront shaping},
 pages = {114081},
 title = {Direct edge-enhanced imaging through multimode fibers via transmission matrix-improved spiral phase contrast},
 url = {https://www.sciencedirect.com/science/article/pii/S003039922501672X},
 volume = {192},
 year = {2025}
}
