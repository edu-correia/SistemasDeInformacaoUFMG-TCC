@article{PENG2025104754,
 abstract = {Reliable wind speed prediction is key to integrate wind power into sustainable energy systems, yet the inherently chaotic and nonstationary dynamics of wind series pose a significant modelling challenge. To tackle this, we introduce a new hybrid approach that merges fractal-guided signal decomposition with an optimized gated recurrent unit neural network. We propose fractal-enhanced complementary ensemble empirical mode decomposition (FE-CEEMD), which utilizes fractal dimension analysis to adaptively determine optimal decomposition parameters, thereby achieving a more effective separation of the wind speed signal into distinct sub-series. We then employ gated recurrent unit (GRU) network to forecast each component, which is intelligently optimized in two stages: the Akaike information criterion is used to determine the appropriate input dimension, and the secretary bird optimization algorithm (SBOA) meticulously fine-tunes key GRU hyperparameters for each sub-series. The final forecasting is reconstructed from these individual predictions. Evaluated using four groups of hourly wind speed data, the proposed model reduced the root mean square error by 1.79% to 27.79% compared to three hybrid models. It achieved superior results across other metrics, with improvements confirmed by statistical tests. Overall, this framework offers a dependable tool for short-term wind forecasting, aiding smoother integration of wind energy into grids and supporting broader sustainable energy goals.},
 author = {Tao Peng and Ji Jin and Dongwei Wang},
 doi = {https://doi.org/10.1016/j.seta.2025.104754},
 issn = {2213-1388},
 journal = {Sustainable Energy Technologies and Assessments},
 keyword = {Wind speed prediction, Fractal-enhanced CEEMD, Gated recurrent unit, Hyperparameter optimization},
 pages = {104754},
 title = {Enhanced wind speed forecasting using fractal-guided signal decomposition and optimized gated recurrent unit for wind energy integration},
 url = {https://www.sciencedirect.com/science/article/pii/S2213138825005855},
 volume = {84},
 year = {2025}
}
