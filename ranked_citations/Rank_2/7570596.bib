@inproceedings{7570596,
 abstract = {A pipelined analog to digital converter which is suitable for low power applications incorporating merged capacitor sharing (MCS) technique is presented. The resolution of the pipelined ADC is improved by sharing an op-amp between two pipelined stages and removing the front end Sample-and-Hold amplifier (SHA). The proposed technique reduces the aperture error due to the absence of SHA and op-amp sharing. The proposed ADC is implemented in 0.18 μm CMOS technology which occupies a die area of 1.3 mm2. The differential and integral non-linearity of the pipelined ADC is +0.32/-0.32LSB and +0.67/-0.67LSB respectively. The ADC achieves an SNDR of 55.67dB and exhibits an FOM of 0.49 pJ/conversion-step while drawing 9.77mW from a 1.8V power supply.},
 author = {Shylu, D. S. and Moni, D. Jackuline and Pearlin, T. Renita},
 booktitle = {2016 3rd International Conference on Devices, Circuits and Systems (ICDCS)},
 doi = {10.1109/ICDCSyst.2016.7570596},
 issn = {},
 keyword = {Capacitors;Power demand;Switches;Switching circuits;Analog-digital conversion;Gain;Pipelined ADC;Merged Capacitor Sharing(MCS);Op-amp Sharing;Low power;Miller op-amp},
 month = {March},
 number = {},
 pages = {309-313},
 title = {A 10-bit 40MS/s low power SHA-less pipelined ADC for system-on-chip digital TV application},
 volume = {},
 year = {2016}
}
