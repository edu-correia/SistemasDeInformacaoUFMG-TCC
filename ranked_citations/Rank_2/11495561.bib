@article{11495561,
 abstract = {Coordinating connected and autonomous vehicles (CAVs) in off-road conflict areas, such as unsignalized intersections and merging zones, faces constraints from uneven terrain and slopes. Thus, this paper proposes an adaptive trust region optimization approach to ensure CAVs satisfy kinematic constraints imposed by uneven terrain while achieving collision avoidance in conflict areas. A vehicle-terrain coupled 3D kinematic model is first formulated, incorporating a terrain mapping function via surface fitting to explicitly characterize the motion patterns of CAVs over uneven surfaces in an optimal control framework. To mitigate inevitable approximation errors in terrain fitting, we propose an adaptive trust-region optimization algorithm, which substitutes global terrain mapping with local approximations in the collision-free trust region along the reference trajectory, and iteratively shrinks the trust region to refine local terrain constraints. Furthermore, a 3D kinematically feasible trajectory generator is developed to construct the initial trust region and warm-start the solver, thereby improving real-time performance and robustness. Comparative experiments validate the robustness and operational efficiency of our method in the typical off-road conflict areas.},
 author = {Bu, Fan and Chen, Peng and Yu, Guizhen and Wang, Yunpeng},
 doi = {10.1109/TVT.2026.3688508},
 issn = {1939-9359},
 journal = {IEEE Transactions on Vehicular Technology},
 keyword = {Radio broadcasting;Frequency modulation;Central Processing Unit;Electronic circuits;Radio access networks;Regional area networks;Communication systems;Modulation;Radio broadcasting;Electronic mail;3D terrains;trajectory planning;cooperative driving;adaptive trust region},
 month = {},
 number = {},
 pages = {1-15},
 title = {Terrain-Aware Coordination of Multiple CAVs in Off-Road Conflict Areas via an Adaptive Trust Region Optimization Approach},
 volume = {},
 year = {2026}
}
