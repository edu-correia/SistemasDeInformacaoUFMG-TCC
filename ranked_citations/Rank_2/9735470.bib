@inproceedings{9735470,
 abstract = {Based on the latest developing trends of smart substation key technologies and equipment, a new generation of smart substation is presented in this paper. The smart substation core equipment and key technologies are first introduced. An integration technique is illustrated, and the primary topics relating to the smart substation mechanical reliability, insulating tolerance, and electronic current transducer electromagnetic anti-interference are discussed. Secondly, with a focus on device integration, function optimization, and circuit-loop simplification, the bay level, which adopts highly integrated multi-functional intelligent electronic devices, is described. Then, the security efficiency cost model was introduced to compare the similar sizes of the new generation smart substation and the conventional substation. It can be proved that the new generation of the smart substation has better technical economics based on the conditions of safety, efficiency, and cost factors.},
 author = {Wang, Wei and Wang, Yanbo and Wang, Dawei},
 booktitle = {2021 IEEE Sustainable Power and Energy Conference (iSPEC)},
