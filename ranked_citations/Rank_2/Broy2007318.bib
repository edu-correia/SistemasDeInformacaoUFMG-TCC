@article{Broy2007318,
 abstract = {The purpose of this symposium, held in conjunction with MoDELS 2006, was to present the current state of research of the UML 2 Semantics Project. Equally important to receiving feedback from an audience of experts was the opportunity to invite researchers in the field to discuss their own work related to a formal semantics for the Unified Modeling Language. This symposium is a follow-on to our first workshop, held in conjunction with ECMDA 2005. © Springer-Verlag Berlin Heidelberg 2007.},
 author = {Broy, Manfred and Crane, Michelle L. and Dingel, Juergen and Hartman, Alan and Rumpe, Bernhard and Selic, Bran},
