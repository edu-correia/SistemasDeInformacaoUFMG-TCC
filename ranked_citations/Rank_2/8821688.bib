@inproceedings{8821688,
 abstract = {A distributed line (DL) graph is a directed graph based on a regular graph. It enables to construct overlay networks, from a regular graph as an initial graph, by considering node splitting and node merging. DL graphs have some excellent properties, such as constant out-degree, fault tolerance and the scalability. Furthermore, they are known to have an explicit routing scheme and optimal diameters, therefore, they indeed possess desirable characteristics for structures overlay networks. On the other hand, since they are constructed without considering proximity between nodes in the underlying network, their lookup latency turns out to be serious. In this paper, we propose proximity-aware distributed line (PDL) graphs, a method for designing proximity-aware regular graph-based structured overlay networks. More precisely, we focus on communication delays between nodes in an underlying network when splitting or merging nodes in an overlay network topology, with an aim to reduce lookup latency. Simulation results show that the overlay networks based on our proposed scheme reduces lookup latency by 10% compared with the ones based on original DL graphs.},
 author = {Shiraishi, Youki and Manada, Akiko and Taenaka, Yuzo and Kadobayashi, Youki},
 booktitle = {2019 IEEE 4th International Conference on Computer and Communication Systems (ICCCS)},
 doi = {10.1109/CCOMS.2019.8821688},
 issn = {},
 keyword = {Overlay networks;Peer-to-peer computing;Measurement;Routing;Network topology;Merging;Topology;distributed hash tables;structured overlay networks;peer-to-peer computing;proximity-aware routing},
 month = {Feb},
 number = {},
 pages = {430-435},
 title = {A Method for Designing Proximity-Aware Regular Graph-Based Structured Overlay Networks},
 volume = {},
 year = {2019}
}
