@inproceedings{11194578,
 abstract = {In this paper, we propose FrSAM, a channel structure-aware merging method in the fractional Fourier domain (FrFD) for single-input multiple-output (SIMO) underwater acoustic communication systems. Unlike conventional maximum ratio combining (MRC) methods that rely on peak-based matching, the proposed method leverages channel structure features to guide the merging process and achieve phase-level alignment. By utilizing the energy concentration property of the fractional Fourier transform (FrFT) for linear frequency modulation (LFM) signals, FrSAM performs position, linear phase, and constant phase alignment in the FrFD. This structure-aware approach effectively mitigates peak misalignment and peak shift problems caused by multipath propagation in traditional methods. Experimental results based on real lake trial data at different distances demonstrate that FrSAM achieves superior performance compared to traditional MRC and FrFT-based MRC, especially in complex multipath environments. The proposed method provides a promising solution for robust and efficient signal combining in practical underwater acoustic communication scenarios.},
 author = {Chen, Mai and Ge, Wei and Yin, Jingwei and Han, Xiao and Zhang, Jiaheng},
 booktitle = {2025 IEEE 15th International Conference on Signal Processing, Communications and Computing (ICSPCC)},
 doi = {10.1109/ICSPCC66825.2025.11194578},
 issn = {2837-116X},
 keyword = {Underwater communication;Fourier transforms;Chirp modulation;Accuracy;Merging;Communication channels;Signal processing;Underwater acoustics;SIMO;Periodic structures;Fractional Fourier transform;single-input multiple-output;underwater acoustic communication;channel structure},
 month = {July},
 number = {},
 pages = {1-6},
 title = {FrSAM: A Channel Structure-Aware Merging Method in the Fractional Domain for SIMO Underwater Communication Systems},
 volume = {},
 year = {2025}
}
