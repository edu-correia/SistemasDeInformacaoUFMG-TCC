@article{Huang2012285,
 abstract = {Ontology construction is a complex and time-consuming process. It is extremely difficult for human experts to discover ontology from given data or texts. In this paper, we present an ontology based user model, called user ontology, for providing personalized information service. Furthermore, we present a method for user ontology construction which based on Formal Concept Analysis. We extract two formal contexts-original query formal context and expanded query formal context, then using the approach of concept similarity to optimize the expanded query formal context, merging the two formal contexts and constructing the pruned concept lattice, finally, generating the ontology instance from the pruned concept lattice and using WordNet to optimize our ontology instance, and calculating the weight of each concept to determine the importance of each concept in the ontology instance. It can be concluded that the method is guided by specific concepts of the given data. Although it isn't an automated way of ontology construction, the experiment proves that the user ontology can be achieved effectively by merging formal contexts, extracting ontology instance from the pruned concept lattice and providing the semantic relations more precisely than just keywords. Copyright © 2012 Binary Information Press.},
 author = {Huang, Xiaoping and Du, Yajun and Ren, Yuyan},
 journal = {Journal of Information and Computational Science},
 note = {Cited by: 1},
 number = {2},
 pages = {285 - 292},
 publication_stage = {Final},
 source = {Scopus},
 title = {Research on automatic user ontology construction},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84856617769?origin=resultslist},
 volume = {9},
 year = {2012}
}
