@conference{Ksiazek2018545,
 abstract = {Parallel programming is a field of science with a great potential nowadays due to the development of advanced computers architectures. Appropriate usage of this tool can be therefore highly beneficial in multimedia applications and significantly decreases the time of calculations. In this article, we analyze how the speed of calculations is influenced by the usage of parallel algorithms in image filtering processes. We present a method based on multithreading and the division of the image for rectangles. The filter is applied parallel on each part of the image. Results show that in some cases our proposition can bring over 90 % benefit when compared to the classical approach. © 2018 Polish Information Processing Society.},
 author = {Ksiazek, Kamil and Marszałek, Zbigniew and Capizzi, Giacomo and Napoli, Christian and Połapl, Dawid and Woźniak, Marcin},
 doi = {10.15439/2018F71},
 journal = {Proceedings of the 2018 Federated Conference on Computer Science and Information Systems, FedCSIS 2018},
 note = {Cited by: 5; All Open Access; Gold Open Access; Green Open Access},
 pages = {545 - 550},
 publication_stage = {Final},
 source = {Scopus},
 title = {The impact of parallel programming on faster image filtering},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85057224725?origin=resultslist},
 year = {2018}
}
