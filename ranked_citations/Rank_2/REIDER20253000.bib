@article{REIDER20253000,
 abstract = {A key reason for the failure of urban infrastructure projects and political measures in the tourism sector is the lack of engagement from stakeholders and decision-makers across various sectors and technical backgrounds. While digital planning applications and participation platforms can support individual aspects of the planning process, they are often restricted to their own domains. To address this challenge, an effective approach is to merge the capabilities of these systems by integrating and exchanging planning results to enhance collaboration. This paper presents the design and implementation of a Geospatial Data Integration Service (GeoDIS) that uses a Service-Oriented Architecture (SOA) with three layers to integrate and exchange data across various distributed applications, including a virtual reality (VR) platform, a spatial decision support system (SDSS), and a logistics simulation model. To meet diverse data requirements, it uses a mediator layer to integrate data from heterogeneous sources and deliver it in the required granularity, spatiality, and format. This interdisciplinary approach demonstrates the potential of advanced data integration services to elevate urban planning and logistics in the tourism sector.},
 author = {Richard Reider and Vasu Dev Mukku and Marcel Müller and Tobias Reggelin and Fred Barış Ernst and Sebastian Lang},
 doi = {https://doi.org/10.1016/j.procs.2025.02.024},
 issn = {1877-0509},
 journal = {Procedia Computer Science},
 keyword = {Data Integration, Service Oriented Architecture, Web Service, Urban Planning, Tourism},
 note = {6th International Conference on Industry 4.0 and Smart Manufacturing},
 pages = {3000-3006},
 title = {Design of a Data Integration and Exchange Service for Touristic City and Logistics Planning in Şanlıurfa, Turkey},
 url = {https://www.sciencedirect.com/science/article/pii/S1877050925003679},
 volume = {253},
 year = {2025}
}
