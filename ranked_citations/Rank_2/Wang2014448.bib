@conference{Wang2014448,
 abstract = {In order to overcome the limitation of existing data cleansing methods working on massive data, in this paper, we propose a generic semantic-based framework using parallelized processing model for effective big data cleansing. We also use an improved Semantic-Based Keyword Matching Algorithm to deal with duplicate data. Experimental results show that this parallelized framework with improved Semantic-Based Keyword Matching Algorithm can identify duplicates with high recall and precision and have a good performance for big data cleansing. © 2014 IEEE.},
 author = {Wang, Jia and Song, Zhijun and Li, Qian and Yu, Jun and Chen, Fei},
 doi = {10.1109/SPAC.2014.6982731},
 journal = {Proceedings 2014 IEEE International Conference on Security, Pattern Analysis, and Cybernetics, SPAC 2014},
 note = {Cited by: 4},
 pages = {448 - 453},
 publication_stage = {Final},
 source = {Scopus},
 title = {Semantic-based intelligent data clean framework for big data},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/84920732044?origin=resultslist},
 year = {2014}
}
