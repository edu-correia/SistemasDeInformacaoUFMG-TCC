@inproceedings{9407482,
 abstract = {The von Neumann computer architectures have a bottleneck of data transfer between memory and processing unit. This degrades performance and increases power consumption for data-intensive applications. Memristor is an alternative building block for designing non-volatile memory. The universal NOR logic gate can be realized on a memristor based crossbar memory array. Hence complex arithmetic and logic operations can be performed within the memory. This work introduces in-memory sorting of non-negative integers on memristor crossbar. An instruction set for memristor based in-memory computation is introduced. In-memory sorting algorithms are implemented with these instructions. For a maximum input size of 1.0E+ 12 64-bit unsigned integers the in-memory selection, merge and radix sort achieve power savings of 78 %, 28 % and 35 %, respectively because the elements to be sorted are not fetched in the cache memory. The high delay of an in-memory compare operation degrades the performance of in-memory comparison sort. The traditional processor based selection and merge sort run 31x and 4x faster, respectively. In-memory radix sort is 2% faster.},
 author = {Pyne, Sumanta},
 booktitle = {2021 34th International Conference on VLSI Design and 2021 20th International Conference on Embedded Systems (VLSID)},
 doi = {10.1109/VLSID51830.2021.00019},
 issn = {2380-6923},
 keyword = {Power demand;Nonvolatile memory;Instruction sets;Memristors;Very large scale integration;Logic gates;Delays},
 month = {Feb},
 number = {},
 pages = {82-87},
 title = {Instruction Controlled In-memory Sorting on Memristor Crossbars},
 volume = {},
 year = {2021}
}
