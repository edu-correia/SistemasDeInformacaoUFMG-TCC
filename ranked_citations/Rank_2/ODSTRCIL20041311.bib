@article{ODSTRCIL20041311,
 abstract = {Coupling of coronal and heliospheric magnetohydrodynamic (MHD) codes represents an efficient modular approach to numerical simulations of physical phenomena occurring on different spatial and temporal scales. Using specialized models makes it possible to: (1) treat efficiently the very different physics relevant in coronal and interplanetary regimes; (2) deal with different time-step constraints for coronal and heliospheric simulations; and (3) optimize and update individual system components with the latest understanding. We present results on the coupling of coronal and heliospheric numerical MHD codes developed within the Center for Integrated Space weather Modeling. We discuss 2-D parametric studies conducted to verify the computational coupling procedure and to assess the accuracy of merging physically and numerically different models.},
 author = {Dusan Odstrcil and Victor J. Pizzo and Jon A. Linker and Pete Riley and Roberto Lionello and Zoran Mikic},
 doi = {https://doi.org/10.1016/j.jastp.2004.04.007},
 issn = {1364-6826},
 journal = {Journal of Atmospheric and Solar-Terrestrial Physics},
 keyword = {Solar corona, Heliosphere, Solar wind, Coronal mass ejection, Interplanetary shock, Magnetohydrodynamic model, Numerical simulation},
 note = {Towards an Integrated Model of the Space Weather System},
 number = {15},
 pages = {1311-1320},
 title = {Initial coupling of coronal and heliospheric numerical magnetohydrodynamic codes},
 url = {https://www.sciencedirect.com/science/article/pii/S1364682604001415},
 volume = {66},
 year = {2004}
}
