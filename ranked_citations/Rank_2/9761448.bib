@inproceedings{9761448,
 abstract = {The problem of prostate segmentation from Magnetic Resonance Imaging (MRI) is an intense research area, due to the increased use of MRI in the diagnosis and treatment planning of prostate cancer. The lack of clear boundaries and huge variation of texture and shapes between patients makes the task very challenging, and the 3D nature of the data makes 2D segmentation algorithms suboptimal for the task. With this paper, we propose a novel architecture to fill the gap be-tween the most recent advances in 2D computer vision and 3D semantic segmentation. In particular, the designed model retrieves multi-scale 3D features with dilated convolutions and makes use of a self-attention transformer to gain a global field of view. The proposed Long-Range 3D Self-Attention block allows the convolutional neural network to build significant features by merging together contextual information collected at various scales. Experimental results show that the proposed method improves the state-of-the-art segmentation accuracy on MRI prostate segmentation.},
 author = {Pollastri, Federico and Cipriano, Marco and Bolelli, Federico and Grana, Costantino},
 booktitle = {2022 IEEE 19th International Symposium on Biomedical Imaging (ISBI)},
 doi = {10.1109/ISBI52829.2022.9761448},
 issn = {1945-8452},
 keyword = {Convolutional codes;Training;Image segmentation;Three-dimensional displays;Magnetic resonance imaging;Merging;Computer architecture;Prostate MRI;3D Segmentation;Self-Attention},
 month = {March},
 number = {},
 pages = {1-5},
 title = {Long-Range 3D Self-Attention for MRI Prostate Segmentation},
 volume = {},
 year = {2022}
}
