@article{CHEN2026108704,
 abstract = {Failure time forecast is critical for landslide risk management, but the spatiotemporal variability of deformation, the presence of multi-source observational data, and the inherent limitations of failure forecast methods (FFMs) create persistent challenges for obtaining a reliable estimate of failure time. Therefore, an ensemble probabilistic forecasting (EPF) model is developed. Initially, an MBOCD-TDT algorithm is introduced by combining multivariate Bayesian online changepoint detection with a typical dimensionless trend model to dynamically determine the onset of acceleration (OOA). Bayesian inference is then used for time-to-failure probabilistic analysis through the integration of multi-source observations and multiple FFMs. A Gaussian mixture model with the Jensen-Shannon divergence is applied, for the first time, to merge multivariate forecasting information and construct an ensemble probabilistic failure forecast method. In addition, a new forecasting criterion is proposed. The reliability of the proposed methods is validated using three case studies. Results showed that the EPF model effectively identifies OOA in real-time monitoring and that ensemble probabilistic forecasts considerably outperform forecasts derived from single models or single datasets. At the same time, the proposed forecasting criterion provides dependable support for decisions related to imminent failure. Generality analysis indicates that the EPF model provides a universal online probabilistic framework for OOA identification and failure forecasts, demonstrating substantial potential for enhancing early warning systems.},
 author = {Mingxi Chen and Penghui Lin and Jie Jiang and Xiaoduo Ou and Qinghui Jiang and Xiaojie Tan},
 doi = {https://doi.org/10.1016/j.enggeo.2026.108704},
 issn = {0013-7952},
 journal = {Engineering Geology},
 keyword = {Landslide failure time, Ensemble probabilistic forecasting model, Onset of acceleration identification, Multi-source data fusion, Bayesian inference, Forecasting criterion},
 pages = {108704},
 title = {Online probabilistic forecast of landslide failure time via multi-information fusion},
 url = {https://www.sciencedirect.com/science/article/pii/S0013795226001638},
 year = {2026}
}
