@conference{Fein2022,
 abstract = {The recent trend of embedding source code for machine learning applications also enables new opportunities in learning analytics in programming education, but which code embedding approach is most suitable for learning analytics remains an open question. A common approach to embedding source code lies in extracting syntactic information from a program’s syntax tree and learning to merge these into continuous distributed vectors (e.g., code2vec). Code2vec has been predominantly investigated in the context of professional programming languages, but learning analytics are particularly important in the context of educational programming languages such as Scratch. In this paper, we therefore instantiate the popular embedding approach code2vec for Scratch programs, create three different classification tasks with corresponding datasets, and empirically evaluate code2vec on them. Our experiments demonstrate that a transfer of code2vec to the educational environment of Scratch is feasible. Our findings serve as a basis to apply code embeddings to further educational tasks such as automated detection of misconceptions of programming concepts in Scratch programs. © 2022 Copyright is held by the author(s).},
 author = {Fein, Benedikt and Graßl, Isabella and Beck, Florian and Fraser, Gordon},
 doi = {10.5281/zenodo.6853103},
 journal = {Proceedings of the 15th International Conference on Educational Data Mining, EDM 2022},
 note = {Cited by: 6},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {An Evaluation of code2vec Embeddings for Scratch},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85172106857?origin=resultslist},
 year = {2022}
}
