@article{5109736,
 abstract = {Mergers and acquisitions of small- to medium-size manufacturing firms often result in an inefficient system of operations. A major issue is how to integrate existing operations from different business processes to streamline service and exploit economy of scales. Standard methodologies are often not adequate in these situations and there is a need for a new methodology to focus on consolidation of processes. We develop a mathematical model of the problem and show that the integration problem can be solved by quantitative techniques such as optimization and Monte Carlo simulation. We study general properties of the model and apply it to the consolidation of the contract review system of a particular company. We show that our approach not only improved the overall performance of this company but also can be used for other companies in similar situation.},
 author = {Chen, Li and Nunez, Manuel},
 doi = {10.1109/TEM.2009.2023109},
 issn = {1558-0040},
 journal = {IEEE Transactions on Engineering Management},
 keyword = {Companies;Time factors;Business;Book reviews;Biological system modeling;Approximation methods;Servers;Centralized control;merging;process control;queuing analysis;simulation},
 month = {Aug},
 number = {3},
 pages = {502-512},
 title = {Business Process Integration of Multiple Customer Order Review Systems},
 volume = {57},
 year = {2010}
}
