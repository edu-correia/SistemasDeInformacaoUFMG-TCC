@article{7583648,
 abstract = {Quadtree-based partitioning (i.e., recursively dividing a picture into square blocks) is one of the most popular partitioning-based image coding schemes because of its computational simplicity and efficient representation of partitioning. However, the rate-distortion performance of quadtree-based partitioning reaches a limit because the dependence between child blocks of different parents is not exploited. In this paper, a new bottom-up-based block partitioning method called split-and-merge is proposed. This method splits an image into multiple square blocks and merges them into nonsquare blocks to exploit the dependence between split blocks. Moreover, a modification of the conventional intra prediction and transform is employed for nonsquare blocks. The experimental results indicate that the proposed method results in an average and maximum bit rate reduction of 3.1% and 8.3%, respectively, relative to High Efficiency Video Coding intra coding.},
 author = {Choi, Byeong-Doo and Ko, Sung-Jea},
 doi = {10.1109/TCSVT.2016.2615498},
 issn = {1558-2205},
 journal = {IEEE Transactions on Circuits and Systems for Video Technology},
 keyword = {Encoding;Image coding;Transforms;Copper;Rate-distortion;Optimization;Block merge;high efficiency image coding;High Efficiency Video Coding (HEVC);image partitioning;nonsquare image transform;nonsquare intra prediction;quadtree partitioning;rate-distortion optimization (RDO)},
 month = {Feb},
 number = {2},
 pages = {540-549},
 title = {Split-and-Merge-Based Block Partitioning for High Efficiency Image Coding},
 volume = {28},
 year = {2018}
}
