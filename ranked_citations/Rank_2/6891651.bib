@inproceedings{6891651,
 abstract = {A method for stabilization of known equilibria in recurrent fuzzy systems is presented, which particularly accounts for model uncertainties. Since the dynamics of recurrent fuzzy systems are defined over a rectangular grid, it is first observed that for stability analysis, only gradient conditions at grid points have to be considered given that the inputs are piecewise constant. Therefore, a robust structure variable controller is proposed, switching between constant inputs. In order to prevent the system from deadlock phenomena due to the switching of the system, the structure variable control is augmented by a piecewise polynomial controller, guaranteeing asymptotic stability. The proposed method is applied to the example of an inverted pendulum.},
 author = {Gering, Stefan and Krippner, Wolfgang and Adamy, Jürgen},
 booktitle = {2014 IEEE International Conference on Fuzzy Systems (FUZZ-IEEE)},
 doi = {10.1109/FUZZ-IEEE.2014.6891651},
 issn = {1098-7584},
 keyword = {Fuzzy systems;Uncertainty;Vectors;System recovery;Asymptotic stability;Switches},
 month = {July},
 number = {},
 pages = {1867-1874},
 title = {Robust stabilization of recurrent fuzzy systems via switching control},
 volume = {},
 year = {2014}
}
