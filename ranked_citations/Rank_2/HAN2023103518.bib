@article{HAN2023103518,
 abstract = {Many people have suffered and even died from infectious diseases every year, especially in cities with relatively high population density, which will no doubt jeopardize the society. In order to predict the spread of and further prevent urban infectious diseases in advance, this paper proposes an urban grid infectious disease area prediction model based on deep learning. The model first builds an urban grid based on longitude and latitude, and analyzes the spatiotemporal data and additional impact data of infectious diseases under the premise of urban grids. Then we construct a spatiotemporal fusion prediction model good at processing temporal and spatial features, using Residual Network (ResNet). Moving forward, the spatial dimension data and the temporal dimension data are processed using Long Short-Term Memory (LSTM). Finally, the two models are merged to incorporate weather, age structure and other additional factor data into the fully connected layer. Taking Quzhou, Zhejiang Province as an example, we obtained data from the Quzhou CDC and imported it into a model to study the regional spread of infectious diseases. The experimental results show that the prediction accuracy of the spatiotemporal fusion model is higher than 94.7%, helpful for predicting infectious diseases. In the follow-up research, we suggest that if the group activity data in the study area can be obtained, the data can be added to the spatiotemporal fusion model, beneficial for improving the prediction accuracy of the model.},
 author = {Bing Han and Yan Mao and Zhenghong Liu and Lina Wang},
 doi = {https://doi.org/10.1016/j.seta.2023.103518},
 issn = {2213-1388},
 journal = {Sustainable Energy Technologies and Assessments},
 keyword = {Deep learning, Infectious disease prediction, Spatio-temporal model, ResNet, LSTM},
 pages = {103518},
 title = {Research on the regional prediction model of urban raster infectious diseases based on deep learning},
 url = {https://www.sciencedirect.com/science/article/pii/S2213138823005118},
 volume = {60},
 year = {2023}
}
