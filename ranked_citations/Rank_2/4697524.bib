@inproceedings{4697524,
 abstract = {In this paper, we have proposed a bandwidth efficient turbo trellis-coded modulation scheme for the non-coherent multiple-antenna Rayleigh fading channel, where the channel state information is not necessary both at the transmitter and the receiver. In this scheme, we merge the unitary space-time modulation as constellations with the turbo trellis-coded modulation, resulting in the turbo trellis-coded USTM.. with the trellis-coded USTM encoder as the component encoders. We have also derived the iterative maximum a posteriori algorithm. Through computer simulations, we demonstrated that without bandwidth expansion, turbo trellis-coded USTM produces significant coding gains over its uncoded counterparts.},
 author = {Jin Wang},
 booktitle = {2008 9th International Conference on Signal Processing},
 doi = {10.1109/ICOSP.2008.4697524},
 issn = {2164-523X},
 keyword = {Fading;Bandwidth;Transmitters;Turbo codes;Iterative decoding;Iterative algorithms;Bit error rate;Channel state information;Computer simulation;Signal mapping},
 month = {Oct},
 number = {},
 pages = {1947-1950},
 title = {Improved unitary space-time modulation for multiple-antenna rayleigh fading channel},
 volume = {},
 year = {2008}
}
