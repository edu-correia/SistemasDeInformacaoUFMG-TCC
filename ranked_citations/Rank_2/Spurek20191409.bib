@article{Spurek20191409,
 abstract = {Gaussian mixture models have many applications in density estimation and data clustering. However, the model does not adapt well to curved and strongly nonlinear data, since many Gaussian components are typically needed to appropriately fit the data that lie around the nonlinear manifold. To solve this problem, the active function cross-entropy clustering (afCEC) method was constructed. In this article, we present an online afCEC algorithm. Thanks to this modification, we obtain a method which is able to remove unnecessary clusters very fast and, consequently, we obtain lower computational complexity. Moreover, we obtain a better minimum (with a lower value of the cost function). The modification allows to process data streams. © 2018, The Author(s).},
 author = {Spurek, Przemysław and Byrski, Krzysztof and Tabor, Jacek},
 doi = {10.1007/s10044-018-0701-8},
 journal = {Pattern Analysis and Applications},
 note = {Cited by: 4; All Open Access; Green Open Access; Hybrid Gold Open Access},
 number = {4},
 pages = {1409 - 1425},
 publication_stage = {Final},
 source = {Scopus},
 title = {Online updating of active function cross-entropy clustering},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85045068517?origin=resultslist},
 volume = {22},
 year = {2019}
}
