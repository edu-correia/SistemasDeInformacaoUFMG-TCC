@inproceedings{10695584,
 abstract = {A seismic data reconstruction method based on a fused feature residual network is proposed to address the limitations of existing interpolation methods for randomly missing seismic traces. The network structure in this study consists of three sub-networks: the missing estimation sub-network, comprising a five-layer convolutional neural network for preprocessing seismic data to avoid interference from prior knowledge; the data reconstruction sub-network, used to restore seismic data, which is composed of an improved U-Net with convolutional operators, batch normalization, and leaky rectified linear units in the encoder, and bilinear interpolation in upsampling; and the texture restoration sub-network, which shares the same structure as the missing estimation sub-network to recover fine texture information. Feature fusion is introduced by concatenating vectors to merge the original missing seismic data, enhancing effective information while avoiding overfitting caused by excessive network depth. The residual structure is introduced to preserve effective information in the original non-missing parts. The feasibility and effectiveness of the proposed algorithm are validated using both synthetic and real seismic data. Experimental results demonstrate that under different degrees of seismic trace missingness, the proposed algorithm outperforms Wavelet, CNN, and U-Net algorithms in effectively restoring missing signals, achieving higher signal-to-noise ratio and peak signal-to-noise ratio.},
 author = {Li, Hongyan and Gao, Yuxiang},
 booktitle = {2024 3rd International Joint Conference on Information and Communication Engineering (JCICE)},
 doi = {10.1109/JCICE61382.2024.00030},
 issn = {},
 keyword = {Knowledge engineering;Interpolation;PSNR;Neural networks;Estimation;Vectors;Signal reconstruction;Robustness;Convolutional neural networks;Residual neural networks;seismic signal;reconstruction;feature fusion;residual network;convolutional neural network},
 month = {May},
 number = {},
 pages = {102-106},
 title = {Reconstruction of Seismic Signals Based on Fusion Feature Residual Network},
