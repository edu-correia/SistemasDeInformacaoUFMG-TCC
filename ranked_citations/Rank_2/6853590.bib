@inproceedings{6853590,
 abstract = {This paper considers the transcription of the widely observed yet less investigated bilingual code-switched speech: the words or phrases of the guest language are inserted within the utterances of the host language, so the languages are switched back and forth within an utterance, and much less data are available for the guest language. Two approaches utilizing the deep neural network (DNN) were tested and analyzed, including using DNN bottleneck features in HMM/GMM (BF-HMM/GMM) and modeling context-dependent HMM senones by DNN (CD-DNN-HMM). In both cases the unit merging (and recovery) techniques in acoustic modeling were used to handle the data imbalance problem. Improved recognition accuracies were observed with unit merging (and recovery) for the two approaches under different conditions.},
 author = {Yeh, Ching-Feng and Lee, Lin-Shan},
 booktitle = {2014 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP.2014.6853590},
 issn = {2379-190X},
 keyword = {Hidden Markov models;Merging;Speech recognition;Acoustics;Speech;Accuracy;Neural networks;Code-switching;Deep Neural Networks;Bilingual;Speech Recognition;Unit Merging},
 month = {May},
 number = {},
 pages = {220-224},
 title = {Transcribing code-switched bilingual lectures using deep neural networks with unit merging in acoustic modeling},
 volume = {},
 year = {2014}
}
