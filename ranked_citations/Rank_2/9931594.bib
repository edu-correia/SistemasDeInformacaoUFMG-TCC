@inproceedings{9931594,
 abstract = {This work conducts a comparative investigation of two architectures in the domain of Spoken Language Understanding (SLU), which were evaluated on a synthesized corpus of three languages: Modern Standard Arabic (MSA), French, and English. The first architecture employs a simple SLU system based on classical machine learning algorithms (E2E SLU), whereas the second architecture (Pipeline SLU) merges the textual output of a speech recognition system (ASR) with that of a textual classification system by transmitting it to a ”Natural Language Understanding” (NLU) model, allowing us to compare the predictions of the two systems. The obtained results were encouraging where we found that the Pipeline approach has given us better results than the E2E approach},
 author = {Lichouri, Mohamed and Lounnas, Khaled and Djeradi, Rachid and Djeradi, Amar},
 booktitle = {2022 International Conference on Advanced Aspects of Software Engineering (ICAASE)},
 doi = {10.1109/ICAASE56196.2022.9931594},
 issn = {},
 keyword = {Machine learning algorithms;Pipelines;Speech recognition;Computer architecture;Predictive models;Natural language processing;Standards;End-to-End;ASR;NLU;SLU;Pipeline;Transliteration;Synthetic},
 month = {Sep.},
 number = {},
 pages = {1-6},
 title = {Performance of End-to-End vs Pipeline Spoken Language Understanding Models on Multilingual Synthetic Voice},
 volume = {},
 year = {2022}
}
