@inproceedings{1047790,
 abstract = {An empirical characterization of a family of condensing algorithms for the 1-nearest neighbor (NN) rule with regard to the different learning vector quantization (LVQ) schemes is presented. In particular, generalized prototypes merging based on consistency on the one hand and adaptive placement of a prespecified number of prototypes on the other, are considered. Both families of the methods have advantages and drawbacks. Basically, LVQ methods tend to be more robust and efficient but they strongly depend on initialization and parameter setting, while consistency-based merging methods have no initialization and parameter setting, but tend to be very dependent on the particular training data.},
 author = {Ferri, F.J. and Mollineda, R.A. and Vidal, E.},
 booktitle = {2002 International Conference on Pattern Recognition},
 doi = {10.1109/ICPR.2002.1047790},
 issn = {1051-4651},
 keyword = {Prototypes;Merging;Clustering algorithms;Nearest neighbor searches;Costs;Vector quantization;Databases;Iterative algorithms;Arithmetic},
 month = {Aug},
 number = {},
 pages = {41-44 vol.3},
 title = {An experimental comparison between consistency-based and adaptive prototype replacement schemes},
 volume = {3},
 year = {2002}
}
