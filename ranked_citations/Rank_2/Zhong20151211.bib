@article{Zhong20151211,
 abstract = {In this paper, we introduce a novel framework for text identification and recognition, called tensor representation learning based image patch analysis (TRL-IPA). Unlike most of previous text identification approaches, which can only be applied to binarized images, TRL-IPA can be directly applied to gray level and color images. TRL-IPA is built on a general formulation of the convergent tensor representation learning (CTRL) algorithms. In the implementation of TRL-IPA, image patches are represented in the form of tensors, while low dimensional representations of these tensors are learned via a CTRL algorithm. To identify text regions in new coming document images, a random forest classifier is trained in the learned tensor subspace. Moreover, the TRL-IPA framework can be straightforwardly applied to recognition problems, such as handwritten digits recognition. We conducted extensive experiments on ancient Chinese, Arabic and Cyrillic document images, to evaluate TRL-IPA on text identification tasks. Experimental results demonstrate its effectiveness and robustness. In addition, recognition results on images of handwritten digits show its advantage over state-of-the-art vector and tensor representation based approaches. © 2014 Elsevier Ltd. All rights reserved.},
 author = {Zhong, Guoqiang and Cheriet, Mohamed},
 doi = {10.1016/j.patcog.2014.09.025},
 journal = {Pattern Recognition},
 note = {Cited by: 16},
 number = {4},
 pages = {1211 - 1224},
 publication_stage = {Final},
 source = {Scopus},
 title = {Tensor representation learning based image patch analysis for text identification and recognition},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84920654331?origin=resultslist},
 volume = {48},
 year = {2015}
}
