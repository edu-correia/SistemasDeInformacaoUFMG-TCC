@article{NGUYEN2025111999,
 abstract = {This paper explores the applicability of containerization technology in electrical protection automation, particularly in a highly centralized context. The deployment of up to 400 virtual Intelligent Electronic Devices within a single server is demonstrated, and their performance is analyzed with respect to protection requirements in terms of determinism and rapidity. The potential communication bottlenecks related to sampled value streams from standalone merging units are also considered, along with their potential impacts on the virtual Intelligent Electronic Devices performance. The obtained experimental results highlight the potential of containerization for increased flexibility, scalability, and cost-effectiveness without compromising performance. While this represents a transformative shift in electrical grid protection, extra-technical aspects must be considered for the technology's adoption.},
 author = {Van Hoa Nguyen and Houda Abil and David Ramsey Herrera and Rémi Thomas and Thierry Coste},
 doi = {https://doi.org/10.1016/j.epsr.2025.111999},
 issn = {0378-7796},
 journal = {Electric Power Systems Research},
 keyword = {Virtualization, Containerization, Virtual IED, IEC 61850, Large-scale deployment, Communication bottleneck},
 pages = {111999},
 title = {Containerized IEC 61850-based protection in smart grid – Lab demonstration and performance assessment for large scale deployment},
 url = {https://www.sciencedirect.com/science/article/pii/S0378779625005905},
 volume = {249},
 year = {2025}
}
