@inproceedings{6705078,
 abstract = {In this paper, an improved method is introduced to reduce the insufficiency of Size-constrain Region Merging (SCRM) segmentation method. Because the stop criterion of SCRM is all regions larger than a specific size, two regions which are both larger than the threshold value can never be merged. This will lead to over-segmentation obviously. So we propose an improved region merging method based on the result of SCRM: the merging process will continue with a similarity-constrain on the merging regions. The proposed algorithm has applied on two scenes of high resolution SAR data. The results show that our method can effectively suppress the insufficiency of SCRM method.},
 author = {Zhen, Fengyuan and Fan, Ling and Wang, Chao},
 booktitle = {Conference Proceedings of 2013 Asia-Pacific Conference on Synthetic Aperture Radar (APSAR)},
 doi = {},
 issn = {},
 keyword = {Image segmentation;Merging;Synthetic aperture radar;Transforms;Remote sensing;Algorithm design and analysis;Image resolution},
 month = {Sep.},
 number = {},
 pages = {317-320},
 title = {An improved regional integration method based on Size-constrain Region Merging},
 volume = {},
 year = {2013}
}
