@article{LAMBERTI2025453,
 abstract = {Historic buildings often face discomfort and energy consumption challenges due to their high permeability to external conditions. While Fangerʼs heat balance and adaptive models are widely employed for thermal comfort assessment, recent advancements have introduced adaptive heat balance models aimed at integrating adaptive mechanisms from real environments. While promising for predictive accuracy, the choice of a model can impact both building comfort and energy consumption. However, there is a lack of systematic, long-term application of these models in real case studies, revealing potential differences among models. Thus, through a 1-year campaign in Le Corbusier's Maison Jeanneret, this study aims to: (i) critically assess the evolution of adaptive heat balance models, (ii) quantify differences in comfort prediction, and (iii) analyse the inclusion of adaptive capacities. Results indicate consistent prediction of positive or negative sensations by all models, yet significant discrepancies exist, particularly concerning thermal neutrality. Models like ePMV, aPMV, arPMV, and PTS align closely with the original PMV but slightly extend the predicted thermal neutrality range, while ATHB and ePMVp, reduce discomfort by 30 %. Neutral temperatures varied from 21.5 °C to 23.0 °C, close to PMVʼs 22.3 °C. Upper and lower comfort limits demonstrate differences compared to PMV. Adaptation is integrated differently into each model. Only the ATHB model, including running mean outdoor temperature, shows a significant increase in comfort temperatures with outdoor conditions, albeit less pronounced than in adaptive models. This paper highlights the need for merging objective and subjective measurements to assess the predictive capacities of adaptive heat balance models across various conditions.},
 author = {Giulia Lamberti and Francesca Contrada and Andrea Kindinis and Arnaud Lapertot and Elisabeth Marie-Victoire and Myriam Bouichou and Bénédicte Gandini and Marie Monfort},
 doi = {https://doi.org/10.1016/j.culher.2024.12.009},
 issn = {1296-2074},
 journal = {Journal of Cultural Heritage},
 keyword = {Thermal comfort, Adaptation, PMV, Historic buildings, Le Corbusier},
 pages = {453-464},
 title = {Advancements in adaptive thermal comfort models: Application to the case study of Le Corbusierʼs Maison Jeanneret},
 url = {https://www.sciencedirect.com/science/article/pii/S1296207424002619},
 volume = {71},
 year = {2025}
}
