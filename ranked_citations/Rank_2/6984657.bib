@inproceedings{6984657,
 abstract = {LiDAR (light detection and ranging) 3D points (both terrestrial and airborne) have recently become a prevalent type of geospatial data. However, this large-scale data poses significant technical challenges for efficient access and visualization. One approach is to generate points with different density levels, i.e. Multi-resolution data sets that can be used for various purposes. This paper presents a simple static tree-based approach and discusses implementation alternatives in favour of speeding up tree building and point sampling processes. This approach is generic and can be applied to other geographic data types as well.},
 author = {You, Yu and Fan, Lixin and Roimela, Kimmo and Mattila, Ville Veikko},
 booktitle = {2014 IEEE International Conference on Computer and Information Technology},
 doi = {10.1109/CIT.2014.102},
 issn = {},
 keyword = {Laser radar;Three-dimensional displays;Octrees;Merging;Buildings;Data visualization;Cameras;multi-resolution point cloud;LiDAR;hierarchical tree structure;data down-sampling},
 month = {Sep.},
 number = {},
 pages = {220-225},
 title = {Simple Octree Solution for Multi-resolution LiDAR Processing and Visualisation},
 volume = {},
 year = {2014}
}
