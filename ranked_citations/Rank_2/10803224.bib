@inproceedings{10803224,
 abstract = {Pneumonia is a critical condition that requires early and accurate diagnoses. This paper proposes Fusion-Lite, an economically efficient model that integrates CNN architectures: EfficientNetB0 and MobileNetV2. These architectures are selected because they balance high accuracy and low computational cost, making the model suitable for resource-constrained environments. By merging the feature maps of both models, purposed model improves pneumonia detection accuracy and efficiency. Experimental results indicate a 2–3% increase in accuracy relative to individual models while considerable reduction in processing and training costs for complex models.},
 author = {Yogesh and Singh, Karan},
 booktitle = {2024 International Conference on Cybernation and Computation (CYBERCOM)},
 doi = {10.1109/CYBERCOM63683.2024.10803224},
 issn = {},
 keyword = {Training;Accuracy;Pneumonia;Costs;Computational modeling;Merging;Feature extraction;X-ray imaging;Biomedical imaging;Diseases;Chest X-ray;Radiology;Multi Disease;Feature Integration;CNN},
 month = {Nov},
 number = {},
 pages = {752-755},
 title = {FusionNet-Lite: Dual CNN Feature Integration for Pneumonia Detection in Chest X-rays},
 volume = {},
 year = {2024}
}
