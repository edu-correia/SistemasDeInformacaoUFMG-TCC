@inproceedings{11467729,
 abstract = {This paper shows that the convolutional neural networks information from the inner layers can improve the traditional GradCam results. While current GradCam just focuses on the deepest convolutional layer information, we propose an extended method that effectively combines the information of this layer with the information of the rest of the layers, particularly the shallow ones. Traditional GradCam shows the spatial areas “where” the model focuses, while our proposed additional information, coming from shallow layers, indicates “which” patterns are relevant in the classification task; furthermore, the obtained heatmaps provide more resolution than the traditional ones. By merging these two types of information: “where” and “what”, interpretability in the computer vision area is improved. Both the source code and the results of the experiments are accessible via GitHub.},
 author = {Bobadilla, Jesús and Gutiérrez, Abraham and Alonso, Santiago and Sánchez, José Luis},
 booktitle = {2026 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)},
 doi = {10.1109/ACDSA67686.2026.11467729},
 issn = {},
 keyword = {Filtering;Filters;Circuits and systems;Recommender systems;Information filtering;Location awareness;Telecommunications;Protocols;Mobile communication;HTTP;GradCam;interpretability;deep learning;CNN;heatmap},
 month = {Feb},
 number = {},
 pages = {1-5},
 title = {GradCam Inner Layers Relevancy for Deep Learning Interpretability},
 volume = {},
 year = {2026}
}
