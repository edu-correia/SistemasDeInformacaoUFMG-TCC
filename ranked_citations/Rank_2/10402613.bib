@inproceedings{10402613,
 abstract = {In this paper, we propose a cost-effective way to encode and transmit multi-linear TV channels on IPTV service as one video stream. To overcome the disadvantages of the existing Multiple Program Transport Stream (MPTS) method that requires high terminal specifications and the Cloud Video UI method that incurs high costs, several linear channels are made into tiles using High Efficiency Video Coding (HEVC) standard technology, then merged into one stream and transmitted. Through this approach, it is expected that IPTV customers will be able to greatly solve the difficulty of finding the desired channels and programs as several channels, grouped by genre, are displayed on one screen at the same time. In addition, this method efficiently improves the picture quality when multi-channels in a screen are non-equivalent size. Non-uniform tiled structure is introduced by modifying the HEVC PPS Syntax and Slice Header value for each tile. Experimental results show that the proposed tiled structure can improve the PNSR picture quality compared to the existing uniform tiled structure.},
 author = {Lim, Jang Hyuk and Koo, Ja Ryeong and Lee, Min Hong and Song, Dae Won and Lee, Sang Yeob and Choi, Hyoung Jun},
 booktitle = {2023 IEEE International Conference on Visual Communications and Image Processing (VCIP)},
 doi = {10.1109/VCIP59821.2023.10402613},
 issn = {2642-9357},
 keyword = {TV;Visual communication;Streaming media;Syntactics;IPTV;Standards;High efficiency video coding;HEVC;Slice;Encoding;IPTV;Multi-Linear TV Channels;Non-uniform tiled structure},
 month = {Dec},
 number = {},
 pages = {1-4},
 title = {A Method for Multi-Linear TV Channels Streaming based on Non-uniform Tiled Structure},
 volume = {},
 year = {2023}
}
