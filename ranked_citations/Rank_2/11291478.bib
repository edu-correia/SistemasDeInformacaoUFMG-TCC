@inproceedings{11291478,
 abstract = {Generative models have emerged as a foundation for advanced deep learning, allowing the generation of realistic data across different domains. This paper presents an extensive overview of generative models, starting with the key concepts of Generative Adversarial Networks (GANs) and Variational Autoencoders (VAEs). The latest improvements in GANs are discussed in detail, with a focus on architectural improvements and applications. The structure and importance of VAEs are also covered, followed by a discussion of hybrid models that combine VAEs with GANs, including their types and use cases. Finally, we discussed advanced generative frameworks other than GANs and VAEs, such as autoregressive models and normalising flows, which provide tractable likelihood estimation methods and improve sample quality. This article aims to serve as an overview for researchers interested in learning more about generative modelling and future research directions.},
 author = {Hassan, Ietezaz ul and Panduru, Krishna and Riordan, Daniel and Walsh, Joseph},
 booktitle = {2025 35th Irish Signals and Systems Conference (ISSC)},
 doi = {10.1109/ISSC67739.2025.11291478},
 issn = {2688-1454},
 keyword = {Deep learning;Reviews;Autoencoders;Merging;Estimation;Generative adversarial networks;Hybrid power systems;Data models;Artificial intelligence;Long short term memory;Deep Learning;Generative Adversarial Networks;Variational Auto Encoders;Normalizing flows;Autoregressive models;GANs improvements;GANs applications},
 month = {June},
 number = {},
 pages = {1-6},
 title = {An Overview of Deep Generative Models-Introduction, Applications and Recent Advances},
 volume = {},
 year = {2025}
}
