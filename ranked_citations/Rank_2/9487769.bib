@inproceedings{9487769,
 abstract = {Electricity Act 2003 has emphasized on rationalization of electricity distribution tariffs with the provision of all supportive regulations. In this article, the success of tariff rationalization in Maharashtra State Electric Power Distribution Company Limited (MSEDCL) is analyzed. The tariff rationalization in the High Tension (HT) and Low Tension (LT) consumer category is evaluated for the period 2007–08 to 2015–16 in the Multi-Year Tariff Regime. The tolls of analysis are Product Strategy and Product Rationalization. In the LT category, 33.33% of sub-categories are benefited in tariff rationalization and tariff count increased by 63.15% due to the application of the extension principle in product rationalization. The LT tariff structure is complex, and it requires simplification. In the HT category, tariff count increased by 33.33%, and it indicates the successful realization of the merging principle for HT product rationalization. In product strategy, the ratio of cross-subsidization of the HT category has reduced in the first two control periods. Thus HT tariff is rationalized, and LT tariff is moving towards rationalization in the Multi- Year Tariff period.},
 author = {Totare, Ninad P and S, Bindu},
 booktitle = {2021 4th Biennial International Conference on Nascent Technologies in Engineering (ICNTE)},
 doi = {10.1109/ICNTE51185.2021.9487769},
 issn = {},
 keyword = {Limiting;Merging;Tariffs;Companies;Tools;Power systems;product rationalization;product strategy;tariff rationalisation;electricity distribution firm;multi year tariff},
 month = {Jan},
 number = {},
 pages = {1-5},
 title = {Electricity Distribution Firm Tariff Rationalization in Multi Year Tariff Policy},
 volume = {},
 year = {2021}
}
