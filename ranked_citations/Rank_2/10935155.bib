@inproceedings{10935155,
 abstract = {SUMMARY & CONCLUSIONS This research project conducts a comprehensive examination of the steel shaft manufacturing system, expanding data from Munyai et al. (2019) [1]. The primary objective is to identify process wastes, bottlenecks, and reliability challenges by integrating Value Stream Mapping (VSM) and system simulation using Simio software. VSM is employed to evaluate the current state and envision future improvements in the manufacturing process, while Simio software simulates the system to analyze key metrics such as utilization, input buffer holding time, throughput, and system reliability. This integration provides a robust framework for identifying inefficiencies, bottlenecks, and reliability issues within the steel shaft manufacturing processes. The research highlights the dynamic interplay between process elements and their impact on system performance and reliability. By comparing various scenarios through simulation, the study offers a comprehensive understanding of the system's challenges and proposes actionable solutions for enhancing productivity, efficiency, and reliability. The findings extend beyond identifying inefficiencies; they also address reliability concerns, contributing to a lean methodology aimed at long-term productivity and reliability growth in the steel shaft manufacturing sector. The insights derived from this study are not only applicable to the steel shaft industry but also offer valuable lessons for other manufacturing environments. The ultimate goal is to foster economic expansion, enhance competitiveness, and improve the overall reliability of the steel shaft manufacturing industry. By merging VSM with system simulation, this research delivers meaningful insights that drive positive transformations in manufacturing processes, focusing on enhancing system reliability alongside efficiency. The outcomes are poised to improve the competitiveness, sustainability, and reliability of the industry, paving the way for a more resilient and economically viable manufacturing sector.},
 author = {Chaudhary, Shankey and Elahi, Behin and Thulasi Das, Pooja Varshini and Varotaria, Miral and Jain, Divyansh and Rathod, Meet Kalpesh},
 booktitle = {2025 Annual Reliability and Maintainability Symposium (RAMS)},
 doi = {10.1109/RAMS48127.2025.10935155},
 issn = {2577-0993},
 keyword = {Shafts;Productivity;Manufacturing processes;System performance;Throughput;Software;Systems simulation;Software reliability;Reliability;Steel;value stream mapping;systems simulation;process improvement},
 month = {Jan},
 number = {},
 pages = {1-5},
 title = {Integration of Value Stream Mapping and Simulation for Productivity Enhancement},
