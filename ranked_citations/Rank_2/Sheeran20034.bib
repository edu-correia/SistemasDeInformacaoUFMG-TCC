@article{Sheeran20034,
 abstract = {We demonstrate some simple but powerful methods that ease the problem of describing and generating circuits that exhibit a degree of regularity, but are not as beautifully regular as the text-book examples. Our motivating example is not a circuit, but a piece of C code that is widely used in graphics applications. It is a sequence of compare-and-swap operations that computes the median of 25 inputs. We use the example to illustrate a set of circuit design methods that aid in the writing of sophisticated circuit generators. © Springer-Verlag Berlin Heidelberg 2003.},
 author = {Sheeran, Mary},
 doi = {10.1007/978-3-540-39724-3_4},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 6; All Open Access; Bronze Open Access},
 pages = {4 - 18},
 publication_stage = {Final},
 source = {Scopus},
 title = {Finding regularity: Describing and analysing circuits that are not quite regular},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/0142183311?origin=resultslist},
 volume = {2860},
 year = {2003}
}
