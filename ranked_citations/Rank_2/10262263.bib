@article{10262263,
 abstract = {Line drawing is a form of painting that uses lines as expressive elements and often employs the combination of abstraction and figuration (CAF) technique to enhance artistic expression. However, existing methods tend to focus on generating semantically accurate line drawings, resulting in lackluster images. We observe that by varying the details of lines in the drawing, it is possible to represent the CAF technique and enhance the artistic effect of the line drawing more effectively. Therefore, we propose an optimization method for line drawing rendering based on prior knowledge of depth and edge density, which adaptively adjusts the line details of input images using double estimation. Our method allows generated line drawings to maintain correct semantic information while keeping consistent background structure contours and rich foreground details. The experiments show that compared to existing line drawing generation methods, our algorithm can generate line drawings that are more aesthetically pleasing to human perception.},
 author = {Lu, Qianwen and Lee, Jinho and Endo, Yuki and Kamijo, Shunsuke},
 doi = {10.1109/MMUL.2023.3318856},
 issn = {1941-0166},
 journal = {IEEE MultiMedia},
 keyword = {Image edge detection;Image resolution;Estimation;Rendering (computer graphics);Semantics;Merging;Feature extraction;Painting},
 month = {Oct},
 number = {4},
 pages = {61-70},
 title = {Artistic Line Drawing Rendering With Priors of Depth and Edge Density},
 volume = {30},
 year = {2023}
}
