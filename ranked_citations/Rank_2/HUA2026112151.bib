@article{HUA2026112151,
 abstract = {To address the limited consideration of spatio-temporal coupling in offshore wind power prediction, this paper introduces a novel computational framework that combines a high-dimensional feature selection method with a physically-guided deep learning model, tailored for ultra-short-term power forecasting of offshore wind farm clusters. The framework’s first part is an advanced feature selection module that merges the Maximum Relevance and Minimum Redundancy (mRMR) criterion with Binary Grey Wolf Optimization (BGWO) to efficiently identify the most relevant and non-redundant features from a large dataset of meteorological and operational data. By integrating mRMR-derived feature importance scores into the BGWO algorithm’s initialization and update rules, this approach overcomes local stagnation issues and significantly lowers computational complexity. The second main component is the PhyGNN-LSTM model, designed to capture complex spatio-temporal relationships. It models the wind farm layout and meteorological conditions as a dynamic graph, with a key innovation being the incorporation of physical wake effects as prior knowledge into the edge weight function of the PhyGNN module. This allows the model to adaptively adjust each turbine’s influence based on real-time wake interactions. The improved graph embeddings generated by the PhyGNN are then supplied to an LSTM network to extract temporal dependencies, enabling highly accurate power predictions. Extensive experimental validation shows that the proposed method outperforms traditional data-driven and physical models in prediction accuracy and generalization. Ablation studies further confirm the unique contributions of both the feature selection and physically-guided GNN components, providing a robust and highly adaptable solution for ultra-short-term offshore wind power forecasting task.},
 author = {Hongyi Hua and Yuting Wang and Ke Han and Chang Liu and Ke Zhang and Peng Chen and Yuanyi Bao and Jie Mei},
 doi = {https://doi.org/10.1016/j.epsr.2025.112151},
 issn = {0378-7796},
 journal = {Electric Power Systems Research},
 keyword = {Offshore wind farm cluster, Ultra-short-term power forecasting, Feature selection, PhyGNN-LSTM algorithm, Wake effect},
 pages = {112151},
 title = {Power prediction method of the offshore wind farm considering high-dimensional feature selection and physical guidance},
 url = {https://www.sciencedirect.com/science/article/pii/S0378779625007394},
 volume = {250},
 year = {2026}
}
