@inproceedings{6818353,
 abstract = {Modern enterprise applications generate a mixed workload comprised of short-running transactional queries and long-running analytical queries containing expensive aggregations. Based on the fact that columnar in-memory databases are capable of handling these mixed workloads, we evaluate how existing materialized view maintenance strategies can accelerate the execution of aggregate queries. We contribute by introducing a novel materialized view maintenance approach that leverages the main-delta architecture of columnar storage, outperforming existing strategies for a wide range of workloads. As an optimization, we further propose an approach that adapts the aggregate maintenance strategy based upon the currently monitored workload characteristics.},
 author = {Müller, Stephan},
 booktitle = {2014 IEEE 30th International Conference on Data Engineering Workshops},
 doi = {10.1109/ICDEW.2014.6818353},
 issn = {},
 keyword = {Aggregates;Maintenance engineering;Databases;Switches;Optimization;Data warehouses;Throughput},
 month = {March},
 number = {},
 pages = {345-349},
 title = {Aggregates caching for enterprise applications},
 volume = {},
 year = {2014}
}
