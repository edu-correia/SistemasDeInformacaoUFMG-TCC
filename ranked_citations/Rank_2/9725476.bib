 doi = {10.1109/ICAC3N53548.2021.9725476},
 issn = {},
 keyword = {Proteins;Ciphers;Social networking (online);Shape;DNA;Computer architecture;Very large scale integration;DNA;AES;FPGA;Partial Reconfiguration;Cryptography},
 month = {Dec},
