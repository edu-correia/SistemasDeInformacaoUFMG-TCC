@inproceedings{9436764,
 abstract = {On the basis of the previous research, the organization design of the assembly line is carried out. With constraint conditions, according to the standard time and the considered wide time, assembly line takt time is calculated, and found the bottleneck process with the longest processing time, designed for the assembly line load. According to the process capacity and process rate, calculated each process needs to be completed in the system time of processing task, time quota, interval number, and work time, and drew out the standard work instruction chart. Through hours restructured, station merged, to reduce the bottleneck process and intermittent time, improve the assembly line load, finally the assembly line workplaces are redistributed, and the workers are arranged reasonably, and then the organization structure design of the assembly line is carried out, a production line is formed for the enterprise.},
 author = {Jia, Shuyuan and Wang, Chao and Qing, Xinyu and Ma, Zhien},
 booktitle = {2021 IEEE 8th International Conference on Industrial Engineering and Applications (ICIEA)},
 doi = {10.1109/ICIEA52957.2021.9436764},
 issn = {},
 keyword = {Productivity;Standards organizations;Employment;Transportation;Process control;Production;Industrial engineering;assembly line takt time;assembly line load;assembly line balance},
 month = {April},
 number = {},
 pages = {252-256},
 title = {Organization Design of Production Line for an Enterprise},
 volume = {},
 year = {2021}
}
