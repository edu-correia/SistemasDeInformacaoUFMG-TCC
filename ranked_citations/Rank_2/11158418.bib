@inproceedings{11158418,
 abstract = {This study analyzes the co-evolutionary mechanisms between interdisciplinary reading and generative artificial intelligence (GAI), elucidating their dynamic symbiotic relationship in knowledge fusion and generation, dynamic iteration and optimization, and innovation-driven development. Based on this analysis, a theoretical model of co-evolution is proposed. Practical case studies are then employed to validate the rationality of the theoretical framework. The research demonstrates that the co-evolution of these two domains will reshape the paradigm of knowledge production and enhance students' cognitive abilities. Finally, future research directions for co-evolution are outlined.},
 author = {Xia, Yang and Qufei, Hong},
