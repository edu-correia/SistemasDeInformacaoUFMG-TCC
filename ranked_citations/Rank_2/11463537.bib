@inproceedings{11463537,
 abstract = {Underwater images suffer from significant quality degradation, including color casts and haze, which severely impacts both human perception and the performance of autonomous underwater systems. Existing underwater image enhancement techniques reduce some of these effects but frequently introduce artifacts, highlighting the need for robust quality assessment. This paper proposes a novel dual-stream deep learning framework that integrates ConvNeXt for local structural features and MaxViT for global perceptual cues, fused via a cross-attention module for blind underwater image quality assessment (UIQA). The proposed model effectively merges feature representations from these two streams using a cross-attention mechanism to create a robust, quality-aware representation. The framework is trained end-to-end through a regression head optimized with a hybrid loss function. Extensive experiments on publicly available benchmark datasets (SOTA and SAUD) demonstrate the effectiveness of the proposed method, achieving PLCC scores of 0.92 and 0.86, respectively, along with significant reductions in RMSE over existing approaches. Visual analysis using Grad-CAM also confirms that the model consistently attends to perceptually relevant regions such as coral textures and color-degraded areas. These results establish the framework as a state-of-the-art solution for UIQA, offering strong alignment with human judgment and robust generalization.},
 author = {Vishwakarma, Anish Kumar and Ranjan, Rakesh and Sahana, Bikash Chandra},
 booktitle = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
 doi = {10.1109/ICASSP55912.2026.11463537},
 issn = {2379-190X},
 keyword = {Circuits and systems;Silicon-on-insulator;Videos;Video equipment;Protocols;HTTP;LoRa;Pixel;Data communication;Fuses;Image Quality Assessment (IQA);Underwater Images;Cross-Attention;Hybrid Loss Function;and Feature Fusion},
 month = {May},
 number = {},
 pages = {10552-10556},
 title = {Cross-Attention based Dual-Stream Framework for Blind Underwater Image Quality Assessment},
