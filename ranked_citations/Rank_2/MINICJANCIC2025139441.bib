@article{MINICJANCIC2025139441,
 abstract = {Since Kealy, Pauson, and Miller independently discovered ferrocene in 1951, this breakthrough and ground-breaking work have had a huge impact. It broadened our understanding of chemistry's structure, bonding, and reactivity and thereby prepared the way for the developing discipline of organometallic chemistry. During the past seventy-plus years, ferrocene and ferrocene-based molecules have found use in a wide range of fields (homogeneous catalysis, electrochemistry, as new materials including polymer chemistry, as fuel additives, as anticancer reagents, in bioorganometallic chemistry, etc.). This fact has aided in the explosive proliferation of the compounds’ family and, in turn, the quickly expanding boundaries of the field. As a result, scientists are combining and developing brand-new hybrid molecules with ferrocene cores. Motivated by the numerous applications of ferrocene core and urea moiety independently, research groups have merged them to form a new class of compounds known as Fc-incorporated ureas. A numerous studies report synthesis, characterization, biological evaluation, and application of Fc-incorporated ureas. Moreover, ferrocene core can be attached to urea moiety, thiourea moiety, selenourea moiety or cyclic urea ring, thus, within this paper all examples will be reviewed in detail. Therefore, this review describes the syntheses and applications of ferrocene incorporated ureas, specifically emphasizing their biological activity. Future perspectives in this area of research will also be considered in this brief overview.},
 author = {Aleksandra {Minić Jančić} and Anka Todosijević},
 doi = {https://doi.org/10.1016/j.molstruc.2024.139441},
 issn = {0022-2860},
 journal = {Journal of Molecular Structure},
 keyword = {Fc-incorporated ureas, Synthesis, Structural characterization, Biological activities, Application},
 pages = {139441},
 title = {Synthesis, properties, and application of various ferrocene- incorporated ureas: A comprehensive review},
 url = {https://www.sciencedirect.com/science/article/pii/S0022286024019574},
 volume = {1319},
 year = {2025}
}
