@inproceedings{7529795,
 abstract = {In this paper we present a review of microfluid devices fabricated by inkjet 3D printing technique, developed in our Department of Microinginiering and Photonics (www.memslab.eu). Various microstructures are presented: simple microfluidic structure, lab-on-a-disc device, spectroscopic microfluidic chip, gel electrophoresis chip for DNA separation and molding template for PDMS. It is also show that 3D printed structure may be connected with microfluidics chip. As an example of merged silicon-glass and 3D printed platform we present spectroscopic chip for optical and mechanical characterization of animals oocyte.},
 author = {Adamski, Krzysztof and Kubicki, Wojciech and Walczak, Rafał},
 booktitle = {2016 MIXDES - 23rd International Conference Mixed Design of Integrated Circuits and Systems},
 doi = {10.1109/MIXDES.2016.7529795},
 issn = {},
 keyword = {Microfluidics;Microchannels;Glass;Printers;Lab-on-a-chip;3D printing;rapid prototyping;microfluidics;gelelectrophoris;spectrocopic analisis;lab-on-a-dics;PDMS mold},
 month = {June},
