@article{LU2022109795,
 abstract = {With the development of Internet of Things and cloud computing, intelligent question-answering (QA) has brought great convenience to human’s daily activities. As one of the core technologies, sentence semantic matching (SSM) plays a critical role in a variety of intelligent QA systems. However, existing SSM methods usually first encode sentences on either character or word level, and then model semantic interactions on sentence level. Consequently, they fail to capture the rich interactions on multi-levels (i.e., character, word and sentence levels). In this paper, we propose Chinese sentence semantic matching based on Multi-level Relevance Extraction and Aggregation (MREA) for intelligent QA. MREA can comprehensively capture and aggregate various semantic relevance on character, word and sentence levels respectively based on multiple attention mechanisms. Extensive experiments on two real-world datasets demonstrate that MREA outperforms the best-performing baselines by 0.5% and 0.89% w.r.t. ACC. and F1 respectively, and achieves comparable performance with BERT-based methods.},
 author = {Wenpeng Lu and Pengyu Zhao and Yifeng Li and Shoujin Wang and Heyan Huang and Shumin Shi and Hao Wu},
 doi = {https://doi.org/10.1016/j.asoc.2022.109795},
 issn = {1568-4946},
 journal = {Applied Soft Computing},
 keyword = {Sentence semantic matching, Human–robot interface, Attention mechanism, Feature extraction and aggregation},
 pages = {109795},
 title = {Chinese sentence semantic matching based on multi-level relevance extraction and aggregation for intelligent human–robot interaction},
 url = {https://www.sciencedirect.com/science/article/pii/S1568494622008444},
 volume = {131},
 year = {2022}
}
