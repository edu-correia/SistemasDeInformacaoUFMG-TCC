@conference{Sharma201959,
 abstract = {In this digital era, geospatial data plays vital role in developing various citizen centric services for sustainable development of the society.There are various portals available where people can tag the locations for further use but they are proprietary based. This data is satisfying all three Vs, Volume, velocity and variety of Big data hence to manage such a voluminous data No SQL data bases should be used rather than RDBMS. Main contribution of this paper is to discuss possible approaches of data base design using HBase No SQL data base and analyzing these approaches specifically for crowdsourcing enabled open source Geographical Information portal. © 2019 The Authors. Published by Elsevier Ltd.},
 author = {Sharma, Monika and Bundele, Mahesh},
 doi = {10.1016/j.procs.2019.05.027},
 journal = {Procedia Computer Science},
 note = {Cited by: 5; All Open Access; Gold Open Access},
 pages = {59 - 65},
 publication_stage = {Final},
 source = {Scopus},
 title = {Analysis of NoSQL schema design approaches using HBase for GIS data},
 type = {Conference paper},
