@inproceedings{5572917,
 abstract = {In this paper, a new symmetrical five terms chaotic system is discussed. In comparison with those of existing six-term or seven-term chaotic attractors, the new attractor is simpler and fewer terms. Some basic dynamical properties of the new attractor, such as equilibria, Lyapunov exponents, Poincare map, fractal dimension, bifurcation diagram and continuous spectrum are studied, and the forming mechanism of its compound structure obtained by merging together two simple attractors after performing one mirror operation is also investigated. One of particular interest is the fact that this new non-generalized Lorenz chaotic system has abundant bifurcation.},
 author = {Xu, Yuhua and Zhou, Wuneng and Fang, Jianan},
 booktitle = {Proceedings of the 29th Chinese Control Conference},
 doi = {},
 issn = {2161-2927},
 keyword = {Bifurcation;Chaotic communication;Eigenvalues and eigenfunctions;Mathematical model;Limit-cycles;Control systems;Five-term Chaotic Attractor;Bifurcation;Poincare Map;Lyapunov Exponents;Compound Structure},
 month = {July},
 number = {},
 pages = {610-614},
 title = {On dynamics analysis of a new symmetrical five-term chaotic attractor},
 volume = {},
 year = {2010}
}
