@article{RUI2026111986,
 abstract = {Efficient and high-quality machining process planning is a critical aspect of a manufacturing industry. With the advancement of artificial intelligence, learning-based methods have demonstrated significant potentials in machining process planning, while existing approaches based on limited heuristic rules often struggle to generate the process plans that well align with the actual enterprise practices. Therefore, this paper proposes an effective NC machining process planning method that integrates the and-or graph of working step content and cutter knowledge (CT-AOG) with reinforcement learning. First, a structured 3D CAD model based on machining features is constructed to represent the part to be manufactured, which is composed of part layer, orientation layer, and manufacturing feature layer. Then, the CT-AOG merging with multiple grammar process knowledge is used to represent the feasible solution space of the process plan of the part, where each process plan is a parsed graph of the CT-AOG. Finally, based on the toolpath generation and simulation of the process plan of the part in UG, a heuristic graph search algorithm for CT-AOG based on reinforcement learning is proposed to generate the optimal process plan of the part, which can effectively explore the solution space of the process plan and learn a function to evaluate the optimal value of incomplete process plans, that can be achieved through the expansion of these incomplete process plans. In the heuristic search process, the branches of the solution space with the most promising are preferentially explored. Experimental results demonstrate that the proposed method can effectively generate the optimal process plan that aligns well with the practical manufacturing requirements.},
 author = {Huang Rui and Yu Shilong and Zhang Fan and Huang Bo},
 doi = {https://doi.org/10.1016/j.cie.2026.111986},
 issn = {0360-8352},
 journal = {Computers & Industrial Engineering},
 keyword = {Reinforcement learning, CT-AOG, Heuristic graph search, NC machiningprocessplanning},
 pages = {111986},
 title = {An effective NC machining process planning method for complex parts by integrating CT-AOG and reinforcement learning},
 url = {https://www.sciencedirect.com/science/article/pii/S0360835226001877},
 year = {2026}
}
