@article{Gao2002168,
 abstract = {A program called MVSIS has been developed which optimizes multi-level multi-valued networks (MV networks). We describe what such a network is and the capabilities contained in MVSIS. MVSIS is modeled after SIS, which synthesizes binary multi-level networks, but the logic network of MVSIS is such that all variables can be multi-valued each with its own range. Included in MVSIS are almost all the technology-independent transformations of SIS for combinatorial and sequential logic synthesis as well as transformations specific to multi-valued nodes such as merge, pair_decode, encode. MVSIS can read and write BLIF-MV and BLIF files which describe MV-networks and binary networks respectively.},
 author = {Gao, M. and Jiang, J.-H. and Jiang, Y. and Li, Y. and Mishchenko, A. and Sinha, S. and Villa, T. and Brayton, R.},
 doi = {10.1109/ISMVL.2002.1011086},
 journal = {Proceedings of The International Symposium on Multiple-Valued Logic},
 note = {Cited by: 34},
 pages = {168 - 177},
 publication_stage = {Final},
 source = {Scopus},
 title = {Optimization of multi-valued multi-level networks},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/0036080110?origin=resultslist},
 year = {2002}
}
