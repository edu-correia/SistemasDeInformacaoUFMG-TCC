@article{OLESZAK2025e202401217,
 abstract = {A strategy to combine three standalone aromatic building blocks in one coherent, fully conjugated molecule is presented. Namely, benzene, pyrene, and hexa‐peri‐hexabenzocoronene (HBC) are assembled around a central porphyrin core in an ABAC type of geometry and interconnected under oxidative Scholl conditions to achieve merging of the individual π‐systems. The three asymmetric porphyrin conjugates obtained this way exhibit intriguing absorption features, namely strongly red‐shifted and broadened spectra. The presented series of molecules demonstrates the ability to control and influence these optical properties with high precision by altering the size of the aromatic system in a controlled manner. Density functional theory calculations gave more profound insights into the electronic structure and optical transitions of the investigated fused architectures.},
 author = {Christoph Oleszak and Christian L. Ritterhoff and Bernd Meyer and Norbert Jux},
 doi = {https://doi.org/10.1002/ejoc.202401217},
 issn = {1434-193X},
 journal = {European Journal of Organic Chemistry},
 keyword = {π-extension, porphyrinoids, fusion reaction, Scholl oxidation, post-functionalization},
 number = {2},
 pages = {e202401217},
 title = {Asymmetrically Fused Nanographene‐Porphyrin Architectures},
 url = {https://www.sciencedirect.com/science/article/pii/S1434193X24009241},
 volume = {28},
 year = {2025}
}
