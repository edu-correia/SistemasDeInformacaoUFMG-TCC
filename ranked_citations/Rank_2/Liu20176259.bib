@conference{Liu20176259,
 abstract = {In this paper we propose a unified framework to address multiple realistic image retrieval tasks concerning both category and attributes. Considering the scale of modern datasets, hashing is favorable for its low complexity. However, most existing hashing methods are designed to preserve one single kind of similarity, thus incapable of dealing with the different tasks simultaneously. To overcome this limitation, we propose a new hashing method, named Dual Purpose Hashing (DPH), which jointly preserves the category and attribute similarities by exploiting the convolutional networks (CNN) to hierarchically capture the correlations between category and attributes. Since images with both category and attribute labels are scarce, our method is designed to take the abundant partially labelled images on the Internet as training inputs. With such a framework, the binary codes of new-coming images can be readily obtained by quantizing the network outputs of a binary-like layer, and the attributes can be recovered from the codes easily. Experiments on two large-scale datasets show that our dual purpose hash codes can achieve comparable or even better performance than those state-of-the-art methods specifically designed for each individual retrieval task, while being more compact than the compared methods. © 2017 IEEE.},
 author = {Liu, Haomiao and Wang, Ruiping and Shan, Shiguang and Chen, Xilin},
 doi = {10.1109/CVPR.2017.663},
 journal = {Proceedings - 30th IEEE Conference on Computer Vision and Pattern Recognition, CVPR 2017},
 note = {Cited by: 31},
 pages = {6259 - 6268},
 publication_stage = {Final},
 source = {Scopus},
 title = {Learning multifunctional binary codes for both category and attribute oriented retrieval tasks},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85041546647?origin=resultslist},
