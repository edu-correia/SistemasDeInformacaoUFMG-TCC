@inproceedings{8331514,
 abstract = {This study aimed to detect short-duration Atrial Fibrillation (AF) episodes by studying inter-beat interval time series to reach real-time automatic medical monitoring. Four publicly-accessible sets of clinical data were used for assessment. All time series were segmented in 1-min RR interval windows and then three specific features were calculated, namely, Vector Angular Index, Vector Length Index and Dispersion of points along the perpendicular to the diagonal line. The features of the four databases were merged in order to give rise to huge variability and therefore to better characterize AF rhythm. Principal Component Analysis (PCA) was used to elucidate whether it was possible to discriminate between AF and Normal Sinus Rhythm (NSR) and Learning Vector Quantization (LVQ) neural network has been optimized to develop the classification model. PCA analysis has shown a good discrimination between the studied rhythms. Furthermore, despite its very simple structure, LVQ neural network has performed better on the analysed databases than existing algorithms did, with high sensitivity and specificity respectively of 99.19% and 99.39%.},
 author = {Haddi, Zouhair and Pons, Jean-François and Delliaux, Stéphane and Ananou, Bouchra and Deharo, Jean-Claude and Charaï, Ahmed and Bouchakour, Rachid and Ouladsine, Mustapha},
 booktitle = {2017 Computing in Cardiology (CinC)},
 doi = {10.22489/CinC.2017.097-365},
 issn = {2325-887X},
 keyword = {Principal component analysis;Atrial fibrillation;Time series analysis;Rhythm;Indexes;Entropy},
 month = {Sep.},
 number = {},
 pages = {1-4},
 title = {A robust detection method of short atrial fibrillation episodes},
 volume = {},
 year = {2017}
}
