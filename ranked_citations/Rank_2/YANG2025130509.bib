@article{YANG2025130509,
 abstract = {As personally identifiable information remains central to privacy protection on online platforms, linking a person’s multiple identities across different platforms has emerged as a critical challenge. This problem, pivotal for cross-domain recommendation, behavior analysis, social network alignment, and the like, has garnered significant attention in academia and industry. This study addresses the user identity linkage problem by leveraging user check-in location data, tackling two key challenges: (1) Check-in records for the same physical location often exhibit slight geospatial discrepancies (e.g., coordinate variations), introducing semantic gaps when one-hot encoding is applied since the method inherently fails to capture spatial proximity relationships. (2) Users often exhibit heterogeneous check-in frequencies across platforms (e.g., frequent check-ins on Foursquare vs. sparse activity on Twitter), which complicates cross-platform user alignment and hinders the modeling of their multifaceted temporal–spatial behavioral patterns. To overcome these issues, we propose CS-Fusion (Cross-trajectory Spatiotemporal Fusion), a novel model that integrates two innovative modules. 1. Cross-trajectory Attention: Utilizes spatiotemporal correlations to merge check-ins associated with the same physical location, mitigating semantic gaps. 2. Mutual-Guidance Attention: Identifies inter-trajectory location relevance to enhance trajectory representation learning, enabling robust alignment of users with divergent check-in behaviors. Extensive experiments on three real-world datasets demonstrate that CS-Fusion outperforms state-of-the-art methods, achieving superior generalizability and robustness in cross-platform user identity linkage. The results highlight its effectiveness in capturing nuanced spatiotemporal patterns and resolving frequency disparities, offering practical value for trajectory-based cross-platform analytics.},
 author = {Yue Yang and Yichao Zhang and Jihong Guan and Shuigeng Zhou and Wengen Li},
 doi = {https://doi.org/10.1016/j.neucom.2025.130509},
 issn = {0925-2312},
 journal = {Neurocomputing},
 keyword = {User identity linkage, Social networks, Spatiotemporal correlation, Check-in location, Trajectory},
 pages = {130509},
 title = {Cross-trajectory spatiotemporal fusion for user identity linkage},
 url = {https://www.sciencedirect.com/science/article/pii/S0925231225011816},
 volume = {648},
 year = {2025}
}
