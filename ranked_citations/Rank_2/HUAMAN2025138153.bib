@article{HUAMAN2025138153,
 abstract = {Dynamic analysis of clusters of bubbles and droplets is a novel field of application for computer vision (CV) and machine learning (ML) methods. The traditional study of large sets of similar objects is a time-consuming activity that demands manual annotation of images. We propose an open-source platform DropClust that integrates different algorithms for the analysis of microdroplets and microfluidic image samples providing robust and quick methods to understand droplet interactions. The dynamics of levitating self-assembled microdroplet clusters with red and blue dyes is studied with CV and ML algorithms during the evolution of the cluster from steady to chaotic behavior. Individual droplets are segmented, classified, clustered or tracked in real-time using different ML models according the goals of the user. The Voronoi entropy and continuous symmetry measure are calculated to estimate the degree of orderliness of the cluster. While the main inspiration comes from studying droplet dynamics, the proposed method is not limited to this application. Most of the algorithms gathered here can be useful for different microscopic and microfluidic image samples with similar behavior including bubbles and colloid particles.},
 author = {Israel A. Huaman and Pavel S. Zun and Alexander A. Fedorets and Michael Nosonovsky and Ekaterina V. Skorb},
 doi = {https://doi.org/10.1016/j.colsurfa.2025.138153},
 issn = {0927-7757},
 journal = {Colloids and Surfaces A: Physicochemical and Engineering Aspects},
 keyword = {Microscopy, Image analysis, Droplet cluster, Merging droplets, Machine learning, Clustering algorithms},
 pages = {138153},
 title = {DropClust: A platform for microscopical image and video analysis applied to levitating droplet clusters},
 url = {https://www.sciencedirect.com/science/article/pii/S0927775725020564},
 volume = {727},
 year = {2025}
}
