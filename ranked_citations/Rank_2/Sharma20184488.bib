@conference{Sharma20184488,
 abstract = {In this paper a hybrid CWDM PON architecture is implemented by hybrid WDM network, which is structured to get high performance from the system and reduce the individual demerits of each technique. The multiplexer and demultiplexer are used to transmit Unicast and Multicast traffic on different wavelengths of each Optical Network Unit (ONU). The system uses four conventional WDM-PON's with 10GB/s bit rate and reaches long sharing a common infrastructure. Here we use four different wavelengths for unicasting and multicasting of data. For Unicasting wavelengths are 1290, 1310, 1330 and 1350nm and for multicasting transmission wavelengths are 1490, 1510, 1530 and 1550nm. To merge the benefits and compensate the drawbacks of different optical amplifiers, a hybrid amplifier is used. The hybrid amplifier is a cascaded semiconductor optical amplifier and Raman amplifier. The effect of non-linearity in the output characteristics, are also analyzed with increase in the transmission distance. The system is simulated using the Optisystem tool. Copy Right © INDIACom-2018.},
 author = {Sharma, Yogesh and Bhatia, Richa},
 journal = {12th INDIACom; 5th International Conference on "Computing for Sustainable Global Development", INDIACom 2018},
 note = {Cited by: 0},
 pages = {4488 - 4491},
 publication_stage = {Final},
 source = {Scopus},
 title = {10 Gbps CWDM-PON Architecture for Long Reach Bidirectional Data using Hybrid Amplifier},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105010489363?origin=resultslist},
 year = {2018}
}
