@inproceedings{11030510,
 abstract = {Existing data stream clustering methods struggle to effectively address the issue of cluster boundary overlap caused by concept drift. Moreover, most methods require parameter settings, making them unsuitable for handling continuously evolving data streams. To address these challenges, we incorporate the concept of fuzziness into the granular-ball splitting process to mitigate the impact of cluster boundary overlap. Additionally, we leverage the adaptive splitting and merging process of granularballs to simulate micro-cluster changes in data streams. Finally, self-adaptive clustering is achieved based on the proximity rules between granular-balls. Experimental results on synthetic and real-world datasets demonstrate that, compared to existing methods, our approach achieves efficient and accurate clustering performance.},
 author = {Dai, Minggao and Zhang, Jingjing},
 booktitle = {2025 10th International Conference on Cloud Computing and Big Data Analytics (ICCCBDA)},
 doi = {10.1109/ICCCBDA64898.2025.11030510},
 issn = {2832-3734},
 keyword = {Cloud computing;Accuracy;Shape;High dimensional data;Clustering methods;Concept drift;Merging;Clustering algorithms;Big Data;Faces;granular-ball structure;data stream clustering;self-adaptive},
 month = {April},
 number = {},
 pages = {123-128},
 title = {An Self-Adaptive Data Stream Fuzzy Clustering Based on Granular-Ball Structure},
 volume = {},
 year = {2025}
}
