@inproceedings{9607199,
 abstract = {While travelling on the highway, vehicle platoons can encounter the case in which they have to merge to avoid a possible collision with a fixed obstacle, e.g., a damaged vehicle. This manoeuvre requires team work between platoons, to provide enough space such that each vehicle performs a safe merging. Also, it requires a collaboration at high travel speed between the cooperative adaptive cruise controller, the trajectory planner and the trajectory follower. This paper proposes a control structure, which combines these three types of controllers, and tests its performance in a simulation scenario. Two platoons have to merge in a single platoon in order to avoid a collision with a fixed obstacle. Also, the triangle form in which the vehicles move is used to ensure a fast merging manoeuvre. The simulation results illustrate that the vehicles from the two platoons succeed to merge and to avoid the collision with the detected obstacle.},
 author = {Pauca, Ovidiu and Maxim, Anca and Caruntu, Constantin F.},
 booktitle = {2021 25th International Conference on System Theory, Control and Computing (ICSTCC)},
 doi = {10.1109/ICSTCC52150.2021.9607199},
 issn = {2372-1618},
 keyword = {Road transportation;Space vehicles;Simulation;Merging;Computer architecture;Trajectory;Teamwork;platoon merging;cooperative adaptive cruise control;trajectory planner;trajectory follower},
 month = {Oct},
 number = {},
 pages = {25-30},
 title = {Cooperative Platoons Merging for Obstacle Avoidance on Highways},
 volume = {},
 year = {2021}
}
