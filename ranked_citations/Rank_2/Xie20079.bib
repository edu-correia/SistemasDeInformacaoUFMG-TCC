@article{Xie20079,
 abstract = {This is a common situation that data are commonly corresponds to integrity constraints in a single DBMS. However, data may be inconsistent in several independent data sources. Most of the information is still useful and retrieved when queries are answered. This paper proposes a query approach for inconsistent databases, and uses the output of a tuple matching technique to assign probabilities and clusters to inconsistent data. The work considers the SPJ queries with aggregation to present two rewriting strategies with non-aggregation and aggregation. The approach processes an original query to produce a rewritten query, and efficiently optimized and executed. The experiments use the TPC-H specification to analyze the rewriting strategies, and the results show that the approach is reasonable.},
 author = {Xie, Dong and Yang, Luming},
 journal = {Journal of Computational Information Systems},
 note = {Cited by: 0},
 number = {1},
 pages = {9 - 16},
 publication_stage = {Final},
 source = {Scopus},
 title = {Query answers on inconsistent databases},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/34248679067?origin=resultslist},
 volume = {3},
 year = {2007}
}
