@article{Buradagunta2020113,
 abstract = {Sorting is a huge demand research area in computer science. Sorting is a process of arranging the elements in an order. In practical application computing requires things to be in order. A comparative study is done in this study and performed the comparison for both positive and negative numbers by taking the random numbers as input. In this study, different algorithms like UNH Sort, Selection Sort, Bubble Sort, Insertion Sort, Merge Sort, Quick Sort are considered for the experimentation. From the obtained results we can conclude that, Initially when the input size is less UNH Sort is giving best when it is compared with bubble sort. When the input size increases bubble sort takes long time to perform sorting. And Quick sort takes less time to perform sorting. © 2020 International Information and Engineering Technology Association. All rights reserved.},
 author = {Buradagunta, Suvarna and Bodapati, Jyostna Devi and Mundukur, Nirupama Bhat and Salma, Shaik},
 doi = {10.18280/isi.250115},
 journal = {Ingenierie des Systemes d'Information},
 note = {Cited by: 5; All Open Access; Bronze Open Access},
 number = {1},
 pages = {113 - 117},
 publication_stage = {Final},
 source = {Scopus},
 title = {Performance comparison of sorting algorithms with random numbers as inputs},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85084796869?origin=resultslist},
 volume = {25},
 year = {2020}
}
