@conference{Yoo2024204,
 abstract = {We analyze the compaction I/O characteristics and the resulting I/O time amplification problem in log-structured merge-tree based key-value stores. We also propose an I/O stack refinement using SPDK and NVMe-oF for compaction offloading. Using our proposed I/O stack, preliminary experimental results show a 37.7% improvement in compaction throughput.  © 2024 IEEE.},
 author = {Yoo, Honghyeon and Byun, Hongsu and Park, Sungyong},
 doi = {10.1109/CLUSTERWorkshops61563.2024.00060},
 journal = {Proceedings - 2024 IEEE International Conference on Cluster Computing Workshops, CLUSTER Workshops 2024},
 note = {Cited by: 0},
 pages = {204 - 205},
 publication_stage = {Final},
 source = {Scopus},
 title = {Refining Compaction Offloading I/O Stack for LSM-Based Key-Value Stores with SPDK},
 type = {Conference paper},
