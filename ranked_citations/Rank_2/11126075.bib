@article{11126075,
 abstract = {Frequent lane-changing maneuvers significantly increase the risk of traffic accidents on highways and constitute a critical factor affecting road safety. This study investigates the complex dynamic interactions that occur during vehicle lane changes in highway merging and diverging zones. Based on vehicle trajectory data captured from an autonomous aerial vehicle (AAV) perspective, a conflict prediction modeling approach is proposed that incorporates both trajectory features and spatiotemporal conflict characteristics. The method employs the attention mechanism of a graph attention network (GAT) to dynamically aggregate the spatial features of neighboring vehicles and integrates the self-attention mechanism of a Transformer to capture the temporal evolution of trajectories within a defined time window, thereby uncovering latent patterns and key distinguishing features of lane-changing conflicts in merging and diverging areas. Experimental results indicate that vehicles in merging zones exhibit higher lane-changing frequencies and greater lateral accelerations. Compared with baseline methods, the proposed GAT-Transformer-based conflict prediction model achieves superior performance, reaching a maximum prediction accuracy of 95.49% and an F1 score of 97.64%. These results underscore the model’s effectiveness in balancing predictive precision with comprehensive detection of true conflicts. Furthermore, the model consistently maintains prediction accuracies above 90% under varying penetration rates and demonstrates strong robustness and reliability across different levels of data availability.},
 author = {Liu, Xiaojia and Yang, Jun and Yu, Dexin and Liu, Bowei and Yang, Yu},
 doi = {10.1109/ACCESS.2025.3599104},
 issn = {2169-3536},
 journal = {IEEE Access},
 keyword = {Trajectory;Predictive models;Feature extraction;Merging;Vehicle dynamics;Attention mechanisms;Transformers;Spatiotemporal phenomena;Adaptation models;Accuracy;Lane-change conflict prediction;vehicle trajectory data;highway merging and diverging areas;graph attention network;deep learning},
 month = {},
 number = {},
 pages = {144143-144158},
 title = {A GAT-Transformer-Based Framework for Lane-Change Conflict Prediction in Highway Merging and Diverging Zones},
 volume = {13},
 year = {2025}
}
