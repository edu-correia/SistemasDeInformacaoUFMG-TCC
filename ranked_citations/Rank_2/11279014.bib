@inproceedings{11279014,
 abstract = {The dual carbon strategy has created unprecedented challenges for home energy efficiency management. Current warning systems struggle with modern requirements, necessitating an approach that combines varied data sources with advanced AI. Our work presents a framework merging "Spatiotemporal Graph Meta-learning + Generative Adversarial Detection" built on a multi-agent architecture. At its core, a Data Coordination Agent fuses static knowledge (device topologies, user behaviors) with dynamic network information (weather patterns, electricity pricing) to build comprehensive energy consumption networks. Working together, three specialized agents form our Model Collaboration Agent Group: one handling spatiotemporal analysis through graph reasoning, another enabling quick adaptation to personal energy habits, and a third detecting anomalies without supervision. These collaborate via robust information sharing and decision coordination. Downstream, our Task Execution Agent Group transforms model insights into practical actions, while our Warning Agent Group employs continuous monitoring and signal coordination to minimize false alarms. The theoretical analysis demonstrated how this approach substantially improves prediction performance, speeds up adaptation to new users, and reduces false warnings without depending on rigid thresholds.},
 author = {Chen, Zuowei and Liang, HongHao and Zhang, Zhe and Wang, Qian and Zhang, Tianyi and Wang, Hao and Lin, Lin},
 booktitle = {2025 IEEE 23rd International Conference on Industrial Informatics (INDIN)},
 doi = {10.1109/INDIN64977.2025.11279014},
 issn = {2378-363X},
 keyword = {Metalearning;Adaptation models;Analytical models;Electricity;Data integration;Collaboration;Smart homes;Transforms;Spatiotemporal phenomena;Topology;Smart Home;Heterogeneous Data Fusion;Electricity Prediction;Collaborative Warning;Energy Management;Spatiotemporal Meta-learning},
 month = {July},
 number = {},
 pages = {1-6},
 title = {Smart Home Electricity Dynamics Prediction and Collaborative Warning Mechanism Based on Multi-source Heterogeneous Data Fusion},
 volume = {},
 year = {2025}
}
