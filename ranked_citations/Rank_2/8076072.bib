@inproceedings{8076072,
 abstract = {We propose a new method for segmenting indoor scenes captured with RGBD or depth cameras with a simple and fast iterative CPU segmentation. The segmentation consists of three main steps. In the first stage, regions grow by adding new pixels based on depth information and normal vectors. Next, multiple regions are merged into bigger surfaces based on adjacency and region statistics. The last stage of the method ensures interframe consistency based on a cost function between regions from subsequent frames. The planar segmentation can be used both for identifying indoor objects, which in general have planar faces, as well as for estimating the camera motion and then reconstructing the environment.},
 author = {Morar, Anca and Moldoveanu, Florica and Petrescu, Lucian and Balan, Oana and Moldoveanu, Alin},
 booktitle = {2017 40th International Conference on Telecommunications and Signal Processing (TSP)},
 doi = {10.1109/TSP.2017.8076072},
 issn = {},
 keyword = {Cameras;Three-dimensional displays;Image color analysis;Image segmentation;Merging;Filtering;Robot vision systems;depth map;labeling;normal map;segmentation;structured light},
 month = {July},
 number = {},
 pages = {674-678},
 title = {Time-consistent segmentation of indoor depth video frames},
 volume = {},
 year = {2017}
}
