@article{Hijma2023,
 abstract = {In the past decade, Graphics Processing Units have played an important role in the field of high-performance computing and they still advance new fields such as IoT, autonomous vehicles, and exascale computing. It is therefore important to understand how to extract performance from these processors, something that is not trivial. This survey discusses various optimization techniques found in 450 articles published in the last 14 years. We analyze the optimizations from different perspectives which shows that the various optimizations are highly interrelated, explaining the need for techniques such as auto-tuning.  © 2023 Copyright held by the owner/author(s).},
 author = {Hijma, Pieter and Heldens, Stijn and Sclocco, Alessio and Van Werkhoven, Ben and Bal, Henri E.},
 doi = {10.1145/3570638},
 journal = {ACM Computing Surveys},
 note = {Cited by: 89; All Open Access; Green Open Access; Hybrid Gold Open Access},
 number = {11},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Optimization Techniques for GPU Programming},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/85151091505?origin=resultslist},
 volume = {55},
 year = {2023}
}
