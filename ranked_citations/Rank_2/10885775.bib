@article{10885775,
 abstract = {Wireless power transfer (WPT) systems have been hamstrung by modest energy efficiencies and electromagnetic safety concerns. Conventional electromagnetic shielding devices can reduce the electromagnetic interference (EMI) to the ambient environment but at the same time deteriorate the transfer performance. In this article, a novel hybrid resonance optimization-based passive shielding magnetic structure and the corresponding circuit are proposed. The shielding structure and topological network have the advantage of minimizing electromagnetic fields (EMFs) around the system while guaranteeing transfer performance (PTE, GV, POUT, phase relation) constant. Moreover, a multiobjective genetic algorithm is utilized to optimize the shielded directional coils (SDCs) parameters in consideration of the transfer efficiency, EMF, and shielding structure volume. Finally, a reasonable prototype of the proposed WPT system is designed, fabricated, and tested. Experimental results show that the maximum leakage EMF level in the evaluated area is reduced by 4.18 dBmV (nearly 39.5 µT). Additionally, the PTE changes by only 1.5%, the GV changes by just 9.5%, and the phase relationship remains unaffected under the 80 W output power condition. The presented solution merges design approach, compensation network, and optimization plan. It can be further extended to analyze arrays of arbitrary order and shielding in different orientations, providing useful insights for smart homes.},
 author = {Rong, Cancan and Chen, Mengmeng and Wang, Qiong and Yan, Lihui and Guo, Yingzhou and Gao, Huimin and Wang, Haoyang and Liu, Xu},
 doi = {10.1109/TIE.2024.3515287},
 issn = {1557-9948},
 journal = {IEEE Transactions on Industrial Electronics},
 keyword = {Coils;Magnetic shielding;Magnetic noise;Magnetic resonance;Electromagnetic interference;Couplings;Energy exchange;Wireless communication;Eddy currents;Vectors;Hybrid resonance;passive shielding;wireless power transfer (WPT)},
 month = {Sep.},
 number = {9},
 pages = {8757-8767},
 title = {Optimization Design of Hybrid Resonance-Based Passive Shielding Coils for Low-Electromagnetic Field Leakage and High Efficiency in WPT System},
 volume = {72},
 year = {2025}
}
