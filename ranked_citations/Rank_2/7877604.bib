@inproceedings{7877604,
 abstract = {DSRC (Dedicated Short Range communication) is an emerging technique that permits very high data transmission critical in communications-based active safety applications. DSRC standards usually adopt either FM0 code or Manchester code as a coding technique to enhance signal reliability, to reach dc balance. The code word structure of FM0 and Manchester are different, thus limiting the hardware potential of existing DSRC systems. Similarity oriented logic simplification (SOLS) techniques merges hardware architectures of both FM0 and Manchester and integrated architecture gives better hardware utilization rate (HUR). The performance of this paper is validated on Xilinx ISE design suite 14.7.},
 author = {Nikhade, Rahul N. and Charles, Priya},
 booktitle = {2016 International Conference on Automatic Control and Dynamic Optimization Techniques (ICACDOT)},
 doi = {10.1109/ICACDOT.2016.7877604},
 issn = {},
 keyword = {Encoding;Hardware;Very large scale integration;Clocks;Transistors;Computer architecture;Frequency shift keying;DSRC;SOLS;VLSI;FM0 code;Manchester code;hardware utilization rate (HUR)},
 month = {Sep.},
 number = {},
 pages = {333-338},
 title = {Low Power implementation of FM0/Manchester encoding using SOLS technique},
 volume = {},
 year = {2016}
}
