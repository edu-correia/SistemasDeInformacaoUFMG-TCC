@inproceedings{4537042,
 abstract = {Bluetooth scatternet has become one important research field of ad hoc networking since it potentially has the wide and extensive applications. The special constraints and characteristics of Bluetooth scatternet present great challenges in constructing efficiently the topology of scatternet and routing in the network. In this paper a distributed algorithm for scatternet formation that gives rise to a tree-like but “not true tree” structure is introduced. The algorithm is fully distributed and asynchronous. It can be applied in a multi-hop environment. It can also meet the requirement to dynamically adapt the topology to nodes’ mobility and failures.},
 author = {Jingjing Wang},
 booktitle = {2008 12th International Conference on Computer Supported Cooperative Work in Design},
 doi = {10.1109/CSCWD.2008.4537042},
 issn = {},
 keyword = {Heuristic algorithms;Bluetooth;Scattering;Personal area networks;Bridges;Tree data structures;Spread spectrum communication;Master-slave;Network topology;Ad hoc networks;Bluetooth;Ad hoc network;Scatternet;Multi-hop;Topology construction},
 month = {April},
 number = {},
 pages = {577-581},
 title = {Dynamical algorithm for multi-hop Bluetooth scatternet formation},
 volume = {},
 year = {2008}
}
