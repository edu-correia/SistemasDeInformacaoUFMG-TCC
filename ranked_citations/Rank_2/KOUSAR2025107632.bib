@article{KOUSAR2025107632,
 abstract = {Macropores and mesopores in activated carbon (AC) are important for diminishing steric hindrance in adsorption of organic pollutants of large molecule size. Modifying reaction network in activation to directly generate large pores or through merge of micropores by tailoring formulation of activation agents is a potential method. This was investigated herein by conducting activation of peach wood by K2C2O4 with co-presence of NaSCN or NaOH for creating both micropores and large pores through their synergistic effects. The results indicated that NaSCN and K2C2O4 together enhanced cracking while suppressed gasification, forming more bio-oil but less gases and remarkably increasing specific surface area (1228.9 m2 g−1 versus 169.9 m2 g−1 for AC-NaSCN and 706.1 m2 g−1 for AC-K2C2O4). The resulting AC-NaSCN/K2C2O4 also contained abundant micropores, macropores and mesopores. NaSCN reacted with carbonaceous intermediates, forming N-containing species in form of -NO and -CN in the ACs, retaining more O-containing functionalities and destructing fibrous morphology inherited from peach wood. Co-presence of NaOH and K2C2O4 induced excessive cracking, resulting in merge of micropores while also collapse of macropores, eliminating pores in AC-NaOH/K2C2O4. In-situ IR measurement of activation showed that NaOH could not catalyze effectively deoxygenation of carbonyls to form thermally stable aromatic structures to sustain generated pores. The pristine ACs showed varied adsorption capacity for removal of methylene blue and tetracycline, depending upon the surface properties of ACs.},
 author = {Sobia Kousar and Kanwal Javed and Bushra Begum and Muhammad Mahboob Naeem and Shu Zhang and Xun Hu},
 doi = {https://doi.org/10.1016/j.biombioe.2025.107632},
 issn = {0961-9534},
 journal = {Biomass and Bioenergy},
 keyword = {Activation, NaSCN and NaOH, Activated carbon, Pore characteristics, Adsorption},
 pages = {107632},
 title = {Simultaneous generation of micropores and macropores via synergistic activation of peach wood with K2C2O4 and sodium salts for enlarging pore diameters},
 url = {https://www.sciencedirect.com/science/article/pii/S0961953425000431},
 volume = {194},
 year = {2025}
}
