@conference{Chen2024,
 abstract = {The scale and intensification of poultry production continue to increase, and Internet of Things (IoT) technology has been widely adopted in poultry farming. Along with the increasing IoT adoption comes the need to deal with the issues of real-time processing, analysis and application of massive field data. Time series data in large-scale egg production have the characteristics of multiple collection equipment or sensors, large datasets, and high-speed throughput. This research describes a monitoring and alarm system based on time series database and alarm model. The system uses distributed stream computing technology to process various time series data at high speed. The time series database "OpenTSDB"is used in the system to storage and query the time series data efficiently. The write performance of OpenTSDB is scalable, which can reach a write performance of one million qps, and the query delay is less than 100ms in 99% of the cases. Multiple alarm strategies were developed, allowing the system to alarm as single-indicator or indicator segment and enabling application in more scenarios. The monitoring and alarm system is expected to significantly advance the ability of modern poultry producers in their efficient monitoring and processing of big data and real-time alarm of the flock performance and housing conditions.  © 2024 ACM.},
 author = {Chen, Hongxi and Teng, Guanghui and Qiu, Xiaobin and Liu, Mulin and Jia, Feng and Sun, Xiaohang and Cheng, Yuhan and Li, Xiran and Qiao, Jun and Chen, Xin},
 doi = {10.1145/3653781.3653792},
 journal = {ACM International Conference Proceeding Series},
