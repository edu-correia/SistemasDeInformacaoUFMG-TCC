@article{10.14778/3685800.3685880,
 abstract = {Searching tables from poorly maintained data lakes has long been recognized as a formidable challenge in the realm of data management. There are three pivotal tasks: keyword-based, joinable and unionable table search, which form the backbone of tasks that aim to make sense of diverse datasets, such as machine learning. In this demo, we propose LakeCompass, an end-to-end prototype system that maintains abundant tabular data, supports all above search tasks with high efficacy, and well serves downstream ML modeling. To be specific, LakeCompass manages numerous real tables over which diverse types of indexes are built to support efficient search based on different user requirements. Particularly, LakeCompass could automatically integrate these discovered tables to improve the downstream model performance in an iterative approach. Finally, we provide both Python APIs and Web interface to facilitate flexible user interaction.},
 author = {Chai, Chengliang and Deng, Yuhao and Zhan, Yutong and Cao, Ziqi and Zhang, Yuanfang and Cao, Lei and Wang, Yuping and Zhang, Zhiwei and Yuan, Ye and Wang, Guoren and Tang, Nan},
 doi = {10.14778/3685800.3685880},
 issn = {2150-8097},
 issue_date = {August 2024},
 journal = {Proc. VLDB Endow.},
 month = {August},
 number = {12},
 numpages = {4},
 pages = {4381–4384},
 publisher = {VLDB Endowment},
 title = {LakeCompass: An End-to-End System for Data Maintenance, Search and Analysis in Data Lakes},
 url = {https://doi.org/10.14778/3685800.3685880},
 volume = {17},
 year = {2024}
}
