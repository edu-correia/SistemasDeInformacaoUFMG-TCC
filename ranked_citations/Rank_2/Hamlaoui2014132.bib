@article{Hamlaoui2014132,
 abstract = {The overall goal of our approach is to relate models of a given domain that are created by different actors and thus are generally heterogeneous that is, described in different DSL (Domain Specific Languages). Instead of building a single global model, we propose to organize the different source models as a network of models which provides a global view of the system through a virtual global model. The matching of these models is done in a shared model of correspondences. We focus in this study on the elaboration of the model of correspondences, through a transformation called "refine" . The approach is illustrated by a representative use case (a Bug Tracking System) and supported by a modeling tool called HMS (Heterogeneous Matching Suite). © 2014 Academic Journals Inc.},
 author = {Hamlaoui, Mahmoud El and Ebersold, Sophie and Anwar, Adil and Coulette, Bernard and Nassar, Mahmoud},
 doi = {10.3923/jse.2014.132.151},
 journal = {Journal of Software Engineering},
 note = {Cited by: 3},
 number = {3},
 pages = {132 - 151},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards a framework for heterogeneous models matching},
 type = {Article},
 url = {https://www.scopus.com/pages/publications/84899886336?origin=resultslist},
 volume = {8},
 year = {2014}
}
