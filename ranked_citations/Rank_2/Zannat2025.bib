@conference{Zannat2025,
 abstract = {Muslim university students seek mental health support that coincides with their faith. Islamic digital therapeutics (DTx) merge Islamic practices with psychological methods; however, evidence for user experience is limited. The qualitative research involved 13 Muslim students (from Malaysia and Bangladesh) who used three Islamic mental health apps (MyRuh, Sabr, and Muslim Moodfit) for approximately two weeks and then participated in semi-structured interviews. Thematic analysis based on induction classified the experience into five themes: Therapeutic Impact, Motivation & Engagement, Usability & Interface Design, Integration of Islamic Content, and Perceived Credibility & Trust. The participants experienced immediate emotional relief and spiritual reassurance through the implementation of features such as guided breathing, dhikr, dua, and Qur'anic reflection; the minimal design and reminders supported the routine use; and trust increased when the content was referenced to credible Islamic sources and clinicians. The participants urged the need for deeper personalisation and richer, more relevant Islamic content. The findings indicate that Islamic DTx could be a supportive means for the well-being of students; the future work should be in the direction of the clinical outcomes, retention, and generalizability tests with larger and more diverse samples. © 2025 IEEE.},
 author = {Zannat, Nahreen and Mahmud, Murni and Samsuri, Suhaila Binti},
 doi = {10.1109/ICT4M68001.2025.11363501},
 journal = {Proceedings - 2025 10th International Conference on Information and Communication Technology for the Muslim World, ICT4M 2025},
 note = {Cited by: 0},
