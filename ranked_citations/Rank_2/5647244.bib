@inproceedings{5647244,
 abstract = {In this paper, we propose a new adaptive non-local means algorithm for image denoising based on the region via pixel region growing and merging. For a seed pixel, by employing the pixel region growing and merging technique to the search regions, it lets the search regions cluster under the similar gray and structure adaptively and merge the related neighborhoods. Experiment results demonstrate that this method is efficient and robust not only for Gaussian white noise, but also for salts and peppers noise. Compared with ONL means and NLR means, the proposed method can not only accelerate the computation, but also have a high quality.},
 author = {Zheng, Kelong and Feng, Wenqiang and Chen, Hanlin},
 booktitle = {2010 3rd International Congress on Image and Signal Processing},
 doi = {10.1109/CISP.2010.5647244},
 issn = {},
 keyword = {Pixel;Merging;Noise reduction;Noise measurement;PSNR;Image denoising;Image denoising;non-local means;adaptive nonlocal means;Gaussian noise;salts and peppers noise},
 month = {Oct},
 number = {},
 pages = {621-625},
 title = {An adaptive non-local means algorithm for image denoising via pixel region growing and merging},
 volume = {2},
 year = {2010}
}
