@conference{Wei2002863,
 abstract = {This paper proposes a new application for the use of the hierarchical adaptive structure mesh (HASM) along with edge detection technique. The proposed approach combines still image segmentation and motion segmentation techniques to provide fast processing and higher accuracy of object detection and tracking. The combination of these two techniques reduces the computational cost compared to traditional edge detection approaches and efficiently extracts the moving object edges.},
 author = {Wei, Yankun and Du, Shah and Badawy, Wael},
 journal = {Canadian Conference on Electrical and Computer Engineering},
