@inproceedings{11382231,
 abstract = {NN set similarity search is a fundamental operation across numerous cloud computing applications. However, for security, the sensitive data processed in these searches must typically be encrypted prior to upload to a cloud server. Existing solutions for KNN set similarity search on encrypted datasets primarily rely on hybrid encryption schemes and operate under the assumption that cloud service providers are semi-honest. Yet, malicious actors could potentially infiltrate cloud platforms, representing a threat significantly beyond that posed by the semi-honest model. This paper introduces a novel computational framework leveraging multi-party secret sharing and garbled circuits. Designed to resist single-server compromise within cloud service providers, the scheme provably safeguards both data confidentiality and integrity in adversarial environments. The application scenario we envision is that the server is not regarded as the data owner. Each server can represent an independent party or a subset of data owners. In other words, as long as we ensure that at most one of the three servers is compromised, any number of data owners can merge their data into the framework. Experimental validation confirms our scheme satisfies formal security requirements for data privacy while demonstrating practical feasibility and operational robustness under tested conditions.},
 author = {Liu, Yongheng and Li, Lu},
 booktitle = {2025 6th International Conference on Artificial Intelligence and Computer Engineering (ICAICE)},
 doi = {10.1109/ICAICE68195.2025.11382231},
 issn = {},
 keyword = {Cloud computing;Data privacy;Computational modeling;Resists;Nearest neighbor methods;Robustness;Encryption;Servers;Integrated circuit modeling;Computer security;KNN set similarity search;Encrypted data;Secure 3PC},
 month = {Nov},
 number = {},
 pages = {893-899},
 title = {A Method for Achieving Secure KNN Similarity Set Search with an Honest Majority},
 volume = {},
 year = {2025}
