@inproceedings{1249559,
 abstract = {We present an alternative method to data knowledge representation by using fuzzy conditional statements. The main idea of the proposed methodology is to group together load data in flexible structures which can then be used by conventional or intelligent programs, as well as by power system operators directly. The algorithm to obtain the fuzzy conditional statements is presented together with an example that uses real data for a power system.},
 author = {Lambert-Torres, G. and da Silva, L.E.B.},
 booktitle = {Second IEEE International Workshop on Intelligent Data Acquisition and Advanced Computing Systems: Technology and Applications, 2003. Proceedings},
 doi = {10.1109/IDAACS.2003.1249559},
 issn = {},
 keyword = {Fuzzy systems;Input variables;Power system modeling;Visual databases;Knowledge representation;Flexible structures;Intelligent structures;Fuzzy sets;Merging;Data visualization},
 month = {Sep.},
