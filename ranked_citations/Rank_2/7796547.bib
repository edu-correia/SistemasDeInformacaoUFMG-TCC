@inproceedings{7796547,
 abstract = {With microgrids merging into the distribution network on a large scale, multi-layer microgrids was formed in a certain area, which had flexible operation modes, large quantities of power supplies with different operating characteristics, and complicated control methods. Aimed at multi-layer PV-ESS microgrids which was widely applied, this paper proposed a power coordinated control algorithm based on hierarchical control under islanded mode. The hierarchical control theory was elaborated in detail on the basis of analyzing its structure, and the islanded operation algorithm was proposed considering multi kinds of operation modes. Proved by simulation, the proposed algorithm could maximize the output of renewable energy sources on the basis of balancing its internal power.},
 author = {Yang, Ping and Zheng, Chengli and Xu, Zhirong and He, Ting and Yin, Xu and Shen, Shen},
 booktitle = {2016 IEEE Innovative Smart Grid Technologies - Asia (ISGT-Asia)},
 doi = {10.1109/ISGT-Asia.2016.7796547},
 issn = {2378-8542},
 keyword = {Microgrids;Power supplies;Distributed power generation;Renewable energy sources;Switches;Centralized control;PV-ESS microgrids;Hierarchical control;Coordinated control;Islanded operation;PSCAD simulation},
 month = {Nov},
 number = {},
 pages = {1145-1150},
 title = {Power coordinated control of the islanded multi-layer microgrids},
 volume = {},
 year = {2016}
}
