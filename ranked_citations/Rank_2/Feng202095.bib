@conference{Feng202095,
 abstract = {To summarizes the research hotspot and evolution process of media convergence in China, this paper reviews 2217 relevant papers within the CSSCI database from 2008 to 2018, analyzing the keywords of high-frequency and modeling the relationship network by bibliometric and social network method. By setting the threshold of publication number, the research process of media convergence can be divided into two stages, 2008-2013 and 2014-2018. The results show that: the amount of papers related to media convergence has an upward trend and entering a rapid growth stage. Stage 1: there are few types of research on media convergence, mainly focusing on the transformation of traditional media, convergence theory and technical support; Stage 2: the scale of media convergence research is gradually expanded, mainly including the construction of media convergence content, integration with specific industries, case and application analysis, etc. The two stages have high consistency in the research content of the development path and media technology.  © 2020 IEEE.},
 author = {Feng, Yueyang and Wang, Zongshui and Peng, Yunan and Yang, Shengqin},
 doi = {10.1109/ICCST50977.2020.00024},
 journal = {Proceedings - 2020 International Conference on Culture-Oriented Science and Technology, ICCST 2020},
 note = {Cited by: 3},
 pages = {95 - 100},
 publication_stage = {Final},
 source = {Scopus},
 title = {Bibliometrics-Based Review of the Media Convergence Research Trend in China: 2008-2018},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85099677684?origin=resultslist},
 year = {2020}
}
