@inproceedings{11496459,
 abstract = {The rapid growth of heterogeneous networks and the increasing sophistication of cyber-attacks have intensified the need for intelligent and adaptive network anomaly identification systems. Traditional signature-based and shallow machine learning approaches struggle to cope with evolving attack behaviors, high-dimensional traffic, and temporal irregularities. The current paper introduces an Experimental Evaluation of a Network Anomaly Identification System on the basis of the Security-Assisted Machine Learning Methodology with the introduction of a new framework called SAGWQHNet. The suggested model merges multi-scale feature representation based on graph-wavelets, contrastive selfsupervised learning with variational information bottleneck, continuous-time temporal modeling with event-driven neural ordinary differential equations, and semantic encoding by considering the security context of its input. On benchmark datasets, experiments have shown that SA-GWQHNet attains an accuracy of 97.86%, F1-score of 97.41% and AUC of 98.32%, which is significantly higher than conventional machine learning, deep learning and hybrid baselines. The results of class-wise evaluations also support strong detection of common and rare types of attacks. These findings indicate the success of integrating structural, temporal and semantic representations in one architecture. The suggested framework provides a scalable and sturdy answer to the real-world network security settings as it allows proper, adaptive, and meaningful detection of anomalies.},
 author = {Satvik and Rangta, Annanay and Faheem, Syed and Ramesh, S},
 booktitle = {2026 International Conference on Electronic Systems and Intelligent Computing (ICESIC)},
 doi = {10.1109/ICESIC67389.2026.11496459},
 issn = {},
 keyword = {Filtering;Filters;Electronic circuits;Circuits and systems;Communication systems;Internet of Things;Telecommunication traffic;Computer networks;Reconnaissance;Protocols;Network anomaly detection;security-assisted machine learning;graph wavelet transform;self-supervised learning;neural ordinary differential equation},
 month = {March},
