@inproceedings{10718593,
 abstract = {Original region filling algorithms for image processing face challenges in computational complexity, limiting their use in real-time and resource-constrained applications. The proposed two-step method priorities efficiency. To streamline clustering, the image preprocessing first removes all-zero rows and columns, focusing the algorithm on informative data for identifying fill regions, without the need for explicit boundary detection. After filling occurs, it reintroduces the initially removed rows and columns to retain the original structure. This temporary zero removal boosts clustering efficiency while preserving data integrity. The proposed algorithm surpasses traditional methods, especially when dealing with large and single hole images, as evidenced by experimental results.},
 author = {Nagarubini, K. Hari and Suthendran, K.},
 booktitle = {2024 Third International Conference on Electrical, Electronics, Information and Communication Technologies (ICEEICT)},
 doi = {10.1109/ICEEICT61591.2024.10718593},
 issn = {},
 keyword = {Image segmentation;Limiting;Noise;Clustering algorithms;Streaming media;Filling;Real-time systems;Information and communication technology;Time complexity;Image reconstruction;Clustering;Computational Complexity;Efficient Algorithm;Image Processing;Region filling},
 month = {July},
 number = {},
 pages = {1-5},
 title = {Beyond Boundaries: Region Filling with Image Data Clustering},
 volume = {},
 year = {2024}
}
