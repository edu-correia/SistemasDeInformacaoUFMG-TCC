@inproceedings{11417509,
 abstract = {In this paper, it is proposed to improve the motion vector prediction techniques of the Versatile Video Coding, the latest standard developed by the Joint Video Experts Team. The proposed method brings changes to the adaptive motion vector prediction and block merging modes, by introducing new motion vector predictor candidates generated from neighboring spatially located source blocks. The new candidates are generated by tracing the motion information of a source block recursively, similar to chained motion vector predictors. The method does not increase the maximum number of motion vector predictors allowed and tracing is limited to one step. In this regard, it provides coding efficiency benefit with small complexity, mainly associated with the fetching of the predictor. The proposed method is implemented in the exploration software Enhanced Compression Model (ECM) version 16.1 and provides -0.05% and -0.08% luma gain in random access (RA) and low-delay (LDB) configurations against the 16.1 anchor, whereas on average -0.10% luma gain against the ECM-17.0 anchor for all inter coding configurations when the template matching based inter coding tools are excluded. Furthermore, the tool demonstrates -0.16% and -0.17% luma coding gain for RA and LDB on the next generation video coding software which was submitted as one of the responses to the call for evidence issued by JVET in 2025.},
 author = {Sansli, Döne Bugdayci and Astola, Pekka},
 booktitle = {2025 Picture Coding Symposium (PCS)},
 doi = {10.1109/PCS65673.2025.11417509},
 issn = {2472-7822},
 keyword = {Video coding;Codecs;Merging;Video compression;Vectors;Encoding;Software;Complexity theory;Next generation networking;Videos;motion vector prediction;VVC;video compression;AMVP;block merging;chain motion vectors},
 month = {Dec},
 number = {},
 pages = {1-5},
 title = {Improvements to Motion Vector Prediction for Future Video Compression},
 volume = {},
 year = {2025}
}
