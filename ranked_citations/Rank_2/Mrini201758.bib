@conference{Mrini201758,
 abstract = {We propose methods to link automatically parsed linguistic data to the WordNet. We apply these methods on a trilingual dictionary in Fula, English and French. Dictionary entry parsing is used to collect the linguistic data. Then we connect it to the Open Multilingual WordNet (OMW) through two attempts, and use confidence scores to quantify accuracy. We obtained 11,000 entries in parsing and linked about 58% to the OMW on the first attempt, and an additional 14% in the second one. These links are due to be validated by Fula speakers before being added to the Kamusi Project's database. © 2017 Incoma Ltd. All rights reserved.},
 author = {Mrini, Khalil and Benjamin, Martin},
 doi = {10.26615/978-954-452-042-7_008},
 journal = {International Conference Recent Advances in Natural Language Processing, RANLP},
 note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access},
 pages = {58 - 64},
 publication_stage = {Final},
 source = {Scopus},
 title = {Towards Producing Human-Validated Translation Resources for the Fula language through WordNet Linking},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/105016005242?origin=resultslist},
 year = {2017}
}
