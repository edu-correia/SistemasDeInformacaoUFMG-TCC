@article{MIAN2025138212,
 abstract = {This research expands the understanding of the wake dynamics of floating offshore wind turbines (FOWTs) subjected to platform motion. Through high-fidelity computational fluid dynamics (CFD) simulation using OpenFOAM, the study investigates the formation of coherent structures in the wake of a model floating wind turbine under low inflow turbulence (TI∞=0.3%). Platform pitch and roll motions are studied separately, and their effects on the development of periodic wake structures are analyzed. This work considers idealized harmonic motion characterized by a platform Strouhal number St=fpD/U with fp the platform motion frequency, D the rotor diameter and U the inflow wind speed. The numerical results show a good agreement with previously published experimental data for velocity deficit, turbulence intensity levels, and wake recovery. For pitching motion, at low Strouhal numbers (St<0.5), the wake exhibits a persistent pulsating behavior, characterized by the periodic formation of vortex rings that undergo rhythmic expansion and shrinking. While, at higher Strouhal numbers (St≈0.7−0.9), the wake transitions from mild pulsation to a large meandering pattern. This transition is initiated by the destabilization of vortex rings in the near-wake, potentially driven by interactions with the hub vortex or by intrinsic small-scale instabilities. The resulting tilting of the rings breaks the symmetry of the flow and triggers the onset of lateral motion. For rolling platform motion, the wake features large-scale meandering structures, whose formation is linked to the rolling-up of the shear layer and is driven by the lateral motion of the platform. For both direction of motion, the findings indicate that the formation of coherent wake structures occurs closer to the rotor for higher oscillation amplitudes, leading to increased turbulence and enhanced wake mixing compared to the fixed wind turbine. The turbulent kinetic energy (TKE) distribution shows that high-TKE regions are concentrated within coherent structures, leading to enhanced wake mixing compared to the less dynamic wake of the fixed wind turbine. A complete 3D wake representation further highlights helical and rotating vortices undergoing stretching and breakdown, thereby accelerating wake recovery.},
 author = {H.H. Mian and T. Messmer and B. Stoevesandt and M.S. Siddiqui},
 doi = {https://doi.org/10.1016/j.energy.2025.138212},
 issn = {0360-5442},
 journal = {Energy},
 keyword = {Floating offshore wind turbine, Coherent structure, Wake, Far-wake, Wake recovery},
 pages = {138212},
 title = {Coherent flow structures in the wake of a model floating wind turbine under pitch and roll motions},
 url = {https://www.sciencedirect.com/science/article/pii/S036054422503854X},
 volume = {335},
 year = {2025}
}
