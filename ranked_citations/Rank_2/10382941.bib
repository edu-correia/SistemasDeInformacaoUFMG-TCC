@inproceedings{10382941,
 abstract = {The objective of landslide detection involves identifying areas that have experienced landslide events, which is crucial for emergency response and the monitoring of natural disasters. This work aims to segment landslides in the landslide4sense dataset obtained from multispectral Sentinel-2 and ALOS PALSAR data. The deep learning semantic segmentation utilizes an encoder-decoder architecture. However, it faces a challenge in feature fusion, especially when dealing with multiple data sources. The fusion of multisource data can enhance the ability of the network to learn. Moreover, merging high-level abstract features with low-level spatial features can improve segmentation accuracy along the borders of target objects. This paper introduces a novel approach called MSLandslide for semantic segmentation by implementing a multisource encoder structure to extract features from various input sources. Additionally, a Fusion Block with attention for multisource data is added to fuse the extracted features. We evaluate the performance of our method using the Landslide4sense dataset and demonstrate its superiority over the current state-of-the-art segmentation methods.},
 author = {Rai, Marwa Chendeb El and Darweesh, Muna},
 booktitle = {2023 30th IEEE International Conference on Electronics, Circuits and Systems (ICECS)},
 doi = {10.1109/ICECS58634.2023.10382941},
 issn = {},
 keyword = {Fuses;Semantic segmentation;Soft sensors;Merging;Feature extraction;Terrain factors;Object recognition;Landslide;Deep Learning;Semantic Segmentation;Slope;DEM;Multispectral;multiSource;Remote Sensing},
 month = {Dec},
 number = {},
 pages = {1-4},
 title = {MSLandslide: A MultiSource Segmentation For Remote Sensing Landslide Images},
 volume = {},
 year = {2023}
}
