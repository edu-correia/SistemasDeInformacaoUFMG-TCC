@inproceedings{1234069,
 abstract = {The paper presents a modified version of the classical split and merge algorithm (Horowitz, S. and Pavlidis, T., 1976). Instead of performing a regular decomposition of the image, it relies on a split at an optimal position that makes a good interregion separation. The implementation of the algorithm uses an initial image preprocessing to speed-up computation. Experimental results show that the number of regions generated by the split phase is largely reduced and that the distortion of the segmented image is smaller, while the execution time is slightly increased.},
 author = {Merigot, A.},
 booktitle = {12th International Conference on Image Analysis and Processing, 2003.Proceedings.},
 doi = {10.1109/ICIAP.2003.1234069},
 issn = {},
 keyword = {Image segmentation;Computational efficiency;Data structures;Merging;Image analysis},
 month = {Sep.},
 number = {},
 pages = {314-319},
 title = {Revisiting image splitting},
 volume = {},
 year = {2003}
}
