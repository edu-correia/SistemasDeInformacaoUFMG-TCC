@inproceedings{11254223,
 abstract = {Flow cytometry is a cornerstone of biomedical research and clinical diagnostics, yet cross-site analysis remains difficult due to variations in instrumentation and protocols. Although incorporating instrument identifiers can aid data integration, such methods often lack generalizability when extended to previously unseen devices or datasets. In this study, we propose a data-driven representation learning strategy that learns compact instrument-specific embeddings within a probabilistic framework, enabling robust cross-site data integration. Our results demonstrate that the approach achieves high classification accuracy, effectively merges data from multiple platforms, and preserves the inherent biological variation of flow cytometry measurements.},
 author = {Chen, Huan-Yu and Chien, Woan-Shiuan and Wang, Yu-Fen and Ko, Bor-Sheng and Lee, Chi-Chun},
 booktitle = {2025 47th Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)},
 doi = {10.1109/EMBC58623.2025.11254223},
 issn = {2694-0604},
 keyword = {Representation learning;Accuracy;Protocols;Instruments;Soft sensors;Data integration;Logic gates;Probabilistic logic;Biology;Object recognition},
 month = {July},
 number = {},
 pages = {1-4},
 title = {Instrument-Aware Representation Learning for Robust Cross-Site Flow Cytometry Integration},
 volume = {},
 year = {2025}
}
