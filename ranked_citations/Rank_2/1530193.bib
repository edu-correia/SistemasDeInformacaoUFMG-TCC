@inproceedings{1530193,
 abstract = {In this paper we propose a rate-distortion optimized multipass algorithm for video encoding. The problem of dependent quantization in a hybrid coding framework is addressed by constructing a trellis from the exponentially growing search tree which is then searched using a Lagrangian cost function. To avoid exponential growth, states with similarly distorted reference frames are merged based on the assumption that similar rate-distortion behavior results for future frames. The goal is to select an optimal quantizer for each frame such that the overall R-D performance is optimized. The algorithm is applied to MPEG-4 SP and typical average PSNR gains of 0.3 dB are achieved. A comparison with the DivX 5.2 codec shows PSNR gains of up to 2 dB.},
 author = {Farber, N. and Mohammed, H. and Thoma, H.},
 booktitle = {IEEE International Conference on Image Processing 2005},
 doi = {10.1109/ICIP.2005.1530193},
 issn = {2381-8549},
 keyword = {Rate-distortion;Encoding;MPEG 4 Standard;Codecs;Lagrangian functions;Quantization;Cost function;PSNR;Rate distortion theory;Constraint optimization},
 month = {Sep.},
 number = {},
 pages = {II-866},
 title = {Rate-distortion optimized multipass video encoding with application to MPEG-4},
 volume = {2},
 year = {2005}
}
