@inproceedings{11409298,
 abstract = {This paper presents a 10b 240Hz digital-PWM CMOS backplane for $\mu \text{LED}$-on-Silicon with a shared, unified memory-in-pixel structure. A unified D-FF chain (UDC) merges the in-pixel register, counter, and comparator into one reconfigurable unit. Hierarchical time-divided PWM (HTD-PWM) with shuffled rolling-shutter (SRS) time-multiplexes an LSB engine across $1 \times 6$ pixel clusters. Fabricated in 28 nm CMOS, the $120 \times 120$ backplane achieves 4042PPI and an 88% active-area, with DNL/INL of 0.9/7.1LSBs.},
 author = {Kim, Kihyun and Lee, Jun-Gi and Kim, Hyun-Sik},
 booktitle = {2026 IEEE International Solid-State Circuits Conference (ISSCC)},
 doi = {10.1109/ISSCC49663.2026.11409298},
 issn = {2376-8606},
 keyword = {Backplanes;Memory architecture;Pulse width modulation;Solid state circuits;Registers;Engines},
 month = {Feb},
 number = {},
 pages = {412-414},
 title = {A 4042-PPI 10b 240Hz Digital-PWM CMOS Backplane for Micro-Led-on-Silicon Displays with a Shared, Unified Memory-in-Pixel Architecture},
 volume = {69},
 year = {2026}
}
