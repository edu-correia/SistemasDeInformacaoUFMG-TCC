@article{WANG2026872,
 abstract = {This study investigates the effects of fuel injection strategies on a solid rocket scramjet (SRSJ) combustor operating in ramjet mode at Mach 6.0 and an altitude of 26 km. Based on the direct-connect experiment results of an all-central injection configuration, a modified scheme incorporating sidewall injection was developed. With the global equivalence ratio fixed at 1.1, six injection schemes were designed by gradually shifting the fuel distribution from the central to the sidewall injection, with the sidewall equivalence ratio (ERSI) increased from 0 to 0.5. Results show that sidewall injection optimizes the fuel-rich gas distribution and intensifies inflow disturbances, forming a positive feedback mechanism that enhances combustion and accelerates flow transition from supersonic to subsonic. A three-jet high-temperature structure emerges upstream and progressively merges toward the center as the ERSI increases, while the downstream region exhibits a similar distribution mode but a markedly more uniform temperature profile compared to the all-central injection. Sidewall injection extends the upstream gas-phase reaction zones and enhances particle combustion downstream, leading to a rise in overall combustion efficiency from 0.588 to 0.655 as the ERSI increases from 0 to 0.5. Remarkably, this improvement occurs without additional total pressure loss, owing to a unique self-balancing mechanism between the shock train and heat release in SRSJ two-phase fuel-rich jet combustion.},
 author = {Jinli Wang and Xiaowei Liu and Jian Fan and Zhixuan Tang},
 doi = {https://doi.org/10.1016/j.actaastro.2025.11.017},
 issn = {0094-5765},
 journal = {Acta Astronautica},
 keyword = {Solid rocket scramjet, Injection strategies, Two-phase combustion, Jet combustion},
 pages = {872-887},
 title = {Investigation of central and sidewall fuel injection strategies in a solid rocket scramjet combustor},
 url = {https://www.sciencedirect.com/science/article/pii/S0094576525007775},
 volume = {240},
 year = {2026}
}
