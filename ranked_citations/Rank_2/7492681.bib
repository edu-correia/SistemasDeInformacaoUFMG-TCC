@inproceedings{7492681,
 abstract = {Digitization and automatic interpretation of document images into editable document format is the primary inclination of optical character recognition systems (OCR). This paper proposes a novel technique for resolution of post processing errors that occurs with respect to Telugu OCR using word level Unicode Approximation Models (UAM) through a mapper module. The mapper module performs the word level one-one mapping of assigning a sequence of recognized class labels to appropriate UAM. The sequence of recognized class labels are related to one particular word and are generated from the classifier as output. The proposed algorithm effectively resolves the problem of segmentation errors, preprocessing errors like cuts and merges in characters, noise, occlusions, semantic ordering and confusing character classes. The proposed UAM models provide adequate and consistent accuracies of around 96.2% for printed words and 91.7% towards handwritten words respectively.},
 author = {Rani, N. Shobha and Vasudev, T.},
 booktitle = {2015 International Conference on Trends in Automation, Communications and Computing Technology (I-TACT-15)},
 doi = {10.1109/ITACT.2015.7492681},
 issn = {},
 keyword = {Optical character recognition software;Character recognition;Error correction;Program processors;Dictionaries;Databases;Computational modeling;Optical Character Recognition;South Indian languages;UAM's;Telugu language;Post-Processing;vowel consonant clusters},
 month = {Dec},
 number = {},
 pages = {1-7},
 title = {Post-processing methodology for word level Telugu character recognition systems using Unicode Approximation Models},
 volume = {},
 year = {2015}
}
