@incollection{TORREGO2025,
 abstract = {This chapter deals with movement, the syntactic operation responsible for the displacement of syntactic units, also called Move. Investigation of a variety of movement phenomena cross-linguistically over the years has shown that Move is subject to strict economy laws. These laws have evolved with the development of linguistic theory, and so has the syntactic operation Move. Understood as Internal Merge, Move is now part of the fundamental structure-building operation Merge of the Minimalist Program. An examination of different instances of movement from the last four decades illustrates the theoretical nature of the evolution.},
 author = {Esther Torrego},
 booktitle = {Reference Module in Social Sciences},
 doi = {https://doi.org/10.1016/B978-0-323-95504-1.00851-6},
 isbn = {978-0-443-15785-1},
 keyword = {Trace/copy, Internal merge, Features, Economy, Infinitives, Raising, Case, Wh-movement, Subjacency, Phase, Head-movement, Minimalist program},
 publisher = {Elsevier},
 title = {Movement},
 url = {https://www.sciencedirect.com/science/article/pii/B9780323955041008516},
 year = {2025}
}
