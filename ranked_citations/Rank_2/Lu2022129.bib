@conference{Lu2022129,
 abstract = {The CPU-Accelerator heterogeneous systems have demonstrated performance and efficiency benefits on DBMSs. However, it is non-trivial to customize efficient domain-specific accelerators. Even if high-performance accelerators are available for DBMS, it is challenge to integrate the software with accelerator non-intrusively. To address these problems, we proposed a hardware-software co-designed system, DOE, which contains hardware accelerator architecture - Conflux for effective SQL operation offloading, and a software programming platform - DP2 for application integration non-intrusively. The experiment results show that DOE achieves more than 100x and 10x performance improvement compared with PostgreSQL and MonetDB respectively.  © 2022 IEEE.},
 author = {Lu, Wenyan and Chen, Yan and Wu, Jingya and Zhang, Yu and Li, Xiaowei and Yan, Guihai},
 doi = {10.1109/ICDEW55742.2022.00026},
 journal = {Proceedings - 2022 IEEE 38th International Conference on Data Engineering Workshops, ICDEW 2022},
 note = {Cited by: 6},
 pages = {129 - 134},
 publication_stage = {Final},
 source = {Scopus},
 title = {DOE: Database Offloading Engine for Accelerating SQL Processing},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85134878603?origin=resultslist},
 year = {2022}
}
