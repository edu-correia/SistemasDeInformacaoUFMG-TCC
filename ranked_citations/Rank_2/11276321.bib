@inproceedings{11276321,
 abstract = {Structural Health Monitoring (SHM) has proven to be a rapidly evolving field with numerous technologies being developed to improve the detectability of defects. Early detection of cracks in various materials and structures is a major focus of SHM. The disproportionate effects of crack propagation can lead to catastrophic structural failure. This paper presents an innovative approach for crack detection using a Defected Ground Structure (DGS)-based radio frequency sensor. A merged twin split ring-based DGS design is investigated. ANSYS Electronic desktop was used to design the resonator. The resonator is then put to use as a sensor to detect crack in PLA. Cracks in horizontal, vertical and 45 degree orientations are considered for each crack width. Detection of cracks as small as 1 mm is achieved, where the DGS design exhibited significant performance, with frequency shifts proportional to crack dimensions. A largely linear relationship between frequency shift and crack width is observed, enabling quantitative crack size estimation. The ability to detect subsurface cracks demonstrates the suitability of the sensor for non-destructive testing. While limitations in sensitivity to environmental factors and crack orientation are noted, the sensor shows potential for further optimization to improve overall performance.},
 author = {Sunil, Sukrith and Sourabh, S. K. and Simson, Simla and Menon, Adithya Krishna and Hariprasad, M. P. and Menon, Sreedevi K.},
 booktitle = {2025 Photonics & Electromagnetics Research Symposium - Spring (PIERS-Spring)},
 doi = {10.1109/PIERS-Spring66516.2025.11276321},
 issn = {2831-5804},
 keyword = {Sensitivity;Resonant frequency;Materials reliability;Environmental factors;Sensor systems;Robustness;Resonance;Springs;Optimization;Monitoring},
 month = {May},
 number = {},
 pages = {1-5},
 title = {Crack Detection in Structural Materials Utilizing DGS-Based Sensor Systems},
 volume = {},
