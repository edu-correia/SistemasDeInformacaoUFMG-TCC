@inproceedings{11283719,
 abstract = {Early and accurate diagnosis of the nature of breast cancer (malignant and benign) is a time race, and early diagnosis can contribute a lot towards survival. Image analysis of medical images (histopathological) assists in the identification of malignancies, but the conventional process is slow and prone to human error. Classical CAD systems have been proposed to aid pathologists, but many are not well-balanced between accuracy and computational time. Methods based on deep learning, particularly CNNs (Convolutional Neural Networks), have shown promise in automatic classification. However, individual deep learning models tend to be poor at capturing fine-grained histological patterns, which has led to hybrid approaches incorporating handcrafted feature extraction with deep learning. Our study introduces a hybrid breast cancer detection model with the deep learning strength and advanced feature engineering techniques. Our approach uses MobileNetV2, which is pre-trained on the BreakHis dataset using 400 x magnification, combined with the help of Thepade's Sorted Block Truncation Code (TSBTC) to enhance feature extraction. The integration enables the model to recognize delicate patterns from histopathological images with great classification accuracy. Experimental results on BreakHis dataset, comprising 9,109 microscopy images, indicate high accuracy, confirming the dominance of hybrid feature fusion in diagnosis. The purpose of this research is to achieve a computationally efficient, highly accurate early detection model of breast cancer for enhancing the application of AI-powered diagnostics. Using feature extraction along with deep learning improves the automated analysis of histopathology reliability through decreased diagnosis faults and faster medical decisions. As medicine and machine learning merge, this research moves us closer to a future where accurate AI-based diagnostics transform cancer detection and treatment.},
 author = {Thepade, Sudeep D. and Patil, Rachana Y. and Fasate, Abhijeet and Patil, Akshay and Padhen, Chetan and Kadam, Pallavi},
 booktitle = {2025 9th International Conference on Computing, Communication, Control and Automation (ICCCBEA)},
 doi = {10.1109/ICCUBEA65967.2025.11283719},
 issn = {2771-1358},
 keyword = {Deep learning;Solid modeling;Accuracy;Translation;Computational modeling;Feature extraction;Breast cancer;Computational efficiency;Convolutional neural networks;Medical diagnostic imaging;BreakHis dataset;breast cancer detection;deep learning;handcrafted feature fusion;medical imaging;MobileNetV2;TSBTC},
 month = {Aug},
 number = {},
 pages = {01-07},
 title = {Improving Breast Cancer Detection Using Hybrid Deep Learning and Handcrafted Features},
