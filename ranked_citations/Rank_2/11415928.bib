@inproceedings{11415928,
 abstract = {Data processing using window functions is important not only in the context of OLAP workloads but also in certain areas of industrial data processing. An example of such areas, in which data processing using window functions is of key importance, is seismic data processing. Traditional approaches to performing window functions for such tasks face inefficient processing: a large amount of data requires a huge amount of RAM, otherwise there is a significant performance decreasing due to the use of spill temporary data to disk. To address this issue, we propose PARWOP, a method that optimizes the execution of window functions for large datasets by executing a preliminary query to the data, obtaining statistics and then searching for the optimal sequence of reading the data. An implementation of the method was developed and experimentally compared with the most popular solutions for processing such data: Clickhouse and Apache Spark. The result obtained demonstrates an execution speed of the queries of up to 2-5 times.},
 author = {Teryoshkin, Sergey and Nasonov, Denis and Butakov, Nikolay},
 booktitle = {2025 IEEE International Conference on Data Mining Workshops (ICDMW)},
 doi = {10.1109/ICDMW69685.2025.00067},
 issn = {2375-9259},
 keyword = {Conferences;Random access memory;Cluster computing;Data processing;Data mining;Optimization;Faces;Window Function;Optimization;Columnar Format;Seismic Dataset},
 month = {Nov},
 number = {},
 pages = {549-558},
 title = {PARWOP: Optimization for Window Functions Partitioning},
 volume = {},
 year = {2025}
}
