@inproceedings{4414525,
 abstract = {Vehicle license plate location is the key of the vehicle plate recognition system. This paper proposes a new method that sufficiently utilizes the color feature such as fixed color collocation, color centers and distribution in the plate region. In this method, firstly, the input image is convolved with 1-D Gaussian filter, and the regions which have the structure and texture are similar to the license plate are extracted. Then improved Fuzzy C-Means (FCM) is used to color clustering in the RGB color space. Finally, according to the clustering center and color distribution, the plate region was chosen from the candidate regions. The experimental results of more than 250 images collected show that the method is more accurate and robust to environment variation, and the rate of location is above 98%.},
 author = {Wang, Haijiao and Wang, Xinnian and Li, Wenju and Jia, Xiaodan},
 booktitle = {Second Workshop on Digital Media and its Application in Museum & Heritages (DMAMH 2007)},
 doi = {10.1109/DMAMH.2007.6},
 issn = {},
 keyword = {License plate recognition;Image edge detection;Vehicles;Flowcharts;Educational institutions;Partial response channels;Filters;Character recognition;Gray-scale;Application software},
 month = {Dec},
 number = {},
 pages = {47-52},
 title = {Color Prior Knowledge-Based License Plate Location Algorithm},
 volume = {},
 year = {2007}
}
