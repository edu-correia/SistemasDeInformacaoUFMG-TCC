@inproceedings{11319758,
 abstract = {MnBi2Te4, the first stoichiometric magnetic-topological insulator, has gained considerable attention for being able to demonstrate several novel phenomena of quantum physics at relatively higher temperatures. Here, an exhaustive investigation of the thin films of MnBi2Te4 and Sb doped MnBi2Te4 has been carried out using time-domain THz spectroscopy. The real THz conductivity displays prominent IR active Eu phonon mode (at ~1.5 THz) merged on top of the Drude-like background contributions from bulk and surface electrons. The extracted parameters from the Drude-Fano-Lorentz model fitting of THz conductivity data, displays change in their temperature dependence around the Neel temperature due to magnetic ordering. This further implies strong coupling between magnetic ordering and electronic band structure in MnBi2Te4. The Eu phonon frequency shows an anomalous blue-shift of ~ 0.1 THz (~7%) for MnBi2Te4 and ~0.2 THz (~13%) for Sb doped MnBi2Te4 as the temperatures increases in the range of 7 K and 250 K. The Eu phonon mode in Sb doped MnBi2Te4 shows asymmetric line-shape compared to that of MnBi2Te4, indicating the emergence of Fano interference between the phonons and the electrons due to the Sb doping. This also suggests that the relatively higher anomalous blue shift of phonons in Sb doped MnBi2Te4 arises from strong electron-phonon coupling. These measurements and analysis provide a comprehensive understanding of the electron and phonon dynamics of MnBi2Te4 and Sb doped MnBi2Te4 in the THz range.},
 author = {Mukherjee, Soumya and NM, Anjan Kumar and Manna, Subhadip and Nath, Sambhu G and Gopal, Radha Krishna and Mitra, Chiranjib and Kamaraju, N.},
 booktitle = {2025 50th International Conference on Infrared, Millimeter, and Terahertz Waves (IRMMW-THz)},
 doi = {10.1109/IRMMW-THz61557.2025.11319758},
 issn = {2162-2035},
 keyword = {Couplings;Temperature distribution;Temperature dependence;Spectroscopy;Phonons;Conductivity;Surface fitting;Time-domain analysis;Terahertz communications;Electrons},
 month = {Aug},
 number = {},
 pages = {1-2},
 title = {Exploring the influence of magnetic order on phonon and electron dynamics in MnBi2Te4 and Sb doped MnBi2Te4 by time-domain THz spectroscopy},
 volume = {},
 year = {2025}
}
