@inproceedings{9654984,
 abstract = {The problem studied in this paper is that of multi-sensor data-fusion for aircraft navigation during approach and landing. Three different sensor groups, namely, Inertial Reference System (IRS), Global Positioning System (GPS) and Instrument Landing System (ILS) are used complementarily to estimate aircraft 3D position in the final approach stage. The methodology takes advantage of set-membership tools and paves the way toward a new and simple online tuning of merging filter. The effectiveness of the proposed scheme is evaluated in terms of validity and accuracy using real flight data provided by Airbus.},
 author = {Ifqir, Sara and Combastel, Christophe and Zolghadri, Ali and Alcalay, Guillaume and Goupil, Philippe and Merlet, Samuel},
 booktitle = {2021 European Control Conference (ECC)},
 doi = {10.23919/ECC54610.2021.9654984},
 issn = {},
 keyword = {Three-dimensional displays;Instruments;Merging;Europe;Data integration;Control systems;Aircraft navigation},
 month = {June},
 number = {},
 pages = {10-16},
 title = {Multi-Sensor Data Fusion For Civil Aircraft IRS/GPS/ILS Integrated Navigation System},
 volume = {},
 year = {2021}
}
