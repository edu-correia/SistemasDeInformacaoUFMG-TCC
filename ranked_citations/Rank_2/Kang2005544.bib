@article{Kang2005544,
 abstract = {The Web is a distributed network of information sources where the individual sources are autonomously created and maintained. Consequently, syntactic and semantic heterogeneity of data among sources abound. Most of the current data cleaning solutions assume that the data values referencing the same object bear some textual similarity. However, this assumption is often violated in practice. "Two-door front wheel drive" can be represented as "2DR-FWD" or "R2FD", or even as "CAR TYPE 3" in different data sources. To address this problem, we propose a novel two-step automated technique that exploits statistical dependency structures among objects which is invariant to the tokens representing the objects. The algorithm achieved a high accuracy in our empirical study, suggesting that it can be a useful addition to the existing information integration techniques. © Springer-Verlag Berlin Heidelberg 2005.},
 author = {Kang, Jaewoo and Lee, Dongwon and Mitra, Prasenjit},
 doi = {10.1007/11581062_46},
 journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
 note = {Cited by: 3},
 pages = {544 - 551},
 publication_stage = {Final},
 source = {Scopus},
 title = {Identifying value mappings for data integration: An unsupervised approach},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/33744788355?origin=resultslist},
 volume = {3806 LNCS},
 year = {2005}
}
