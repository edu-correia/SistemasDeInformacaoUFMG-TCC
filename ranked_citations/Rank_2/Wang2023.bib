@conference{Wang2023,
 abstract = {Various cooperative merging control strategies at on-ramp have been proposed in the last decade. Approximated vehicle longitudinal motion models, e.g., kinematics model, have been broadly adopted for controller synthesis because of their simplicity. However, what appears problematic is that the models used for controller validation remain, in many cases, the same as the ones used for controller design. Indeed, actual vehicle dynamics contain rich behaviors that the simplified models cannot fully cover. In this paper, we first demonstrate that the actual vehicle speed can be dissimilar to the reference from a speed planner once vehicle dynamics is considered. Then, we propose two data-driven speed generators agnostic to vehicle dynamics. SUMO/Simulink joint simulations demonstrate that the proposed reference speed planners can successfully merge vehicles with distinct dynamics characteristics by following the desired sequence, speed, and intervehicle distance at the merging point while avoiding collisions. © 2023 IEEE.},
 author = {Wang, Zejiang and Cook, Adian and Shao, Yunli and Xu, Guanhao and Chen, Jianfei Max},
 doi = {10.1109/IV55152.2023.10186541},
 journal = {IEEE Intelligent Vehicles Symposium, Proceedings},
 note = {Cited by: 13; All Open Access; Green Open Access},
 pages = {},
 publication_stage = {Final},
 source = {Scopus},
 title = {Cooperative Merging Speed Planning: A Vehicle-Dynamics-Free Method},
 type = {Conference paper},
 url = {https://www.scopus.com/pages/publications/85168006786?origin=resultslist},
 volume = {2023-June},
 year = {2023}
}
