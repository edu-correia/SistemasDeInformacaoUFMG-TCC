@inproceedings{10617084,
 abstract = {Machine learning (AI) has gained popularity in the healthcare industry, with a specific emphasis on the usage of AI-based robot systems. These systems become automated talking bots, playing a crucial part in improving health, education spread, and possibly causing behavioral changes. Despite the growing merging of these advances, only a limited study has looked into the acceptance of health robots. This study, combining semi-structured conversations (N-29) and a web-based questionnaire (N-216), aims to explore subjects’ desire to interact with AI-led health apps. The conversations, taped and written exactly, guided the formation of a thorough poll advertised through various online platforms. Analysis of both subjective and numeric data showed a general acceptance among web users toward through health robots. However, reservations surrounding technological advances could impede broad involvement. To handle this, creators of AI-led health apps must take user-centric and theory-based methods. These methods should not only address patients’ worries but also improve user experience and guarantee maximum growth and usage. In the creation and assessment of health robots, knowing patients’ views, goals, and skills is crucial for building successful and widely accepted solutions in the healthcare environment.},
 author = {Edison, D. and Goswami, Sudarshan and Janakiraman, V. and Almusawi, Muntather and Kuppuraj, T. and Ramesh, Azmeera},
 booktitle = {2024 4th International Conference on Advance Computing and Innovative Technologies in Engineering (ICACITE)},
 doi = {10.1109/ICACITE60783.2024.10617084},
 issn = {},
 keyword = {Industries;Service robots;Merging;Oral communication;Machine learning;Chatbots;User experience;Chatbot Services;Healthcare;Artificial Intelligence;Machine Learning;Acceptance;Technology Adoption;Health Robots;Patient Engagement;AI Reluctance;User-centred Methods},
 month = {May},
 number = {},
 pages = {21-26},
 title = {An Intensive Role of Chatbot Services in the field of Healthcare},
 volume = {},
 year = {2024}
}
