@article{10935299,
 abstract = {Traditional real-time object detection networks deployed in autonomous aerial vehicles (AAVs) struggle to extract features from small objects in complex backgrounds with occlusions and overlapping objects. To address this challenge, we propose FM-RTDETR, a real-time object detection algorithm optimized for small object detection. We redesign the encoder of RT-DETRv2 by integrating the Feature Aggregation and Diffusion Network (FADN), improving the algorithm's ability to capture contextual information. Subsequently, we introduce the Parallel Atrous Mamba Feature Fusion Module (PAMFFM), which combines shallow and deep semantic information to better capture small object features. Furthermore, we propose the Cross-stage Enhanced Feature Fusion Module (CEFFM), merging features for small objects to provide richer and more detailed information. Finally, we propose STIoU Loss, which incorporates a penalty term to adjust the scaling of the loss function, improving detection granularity for small objects. FM-RTDETR achieves AP$_{50}$ scores of 54.0% and 56.3% on the VisDrone2019-DET and AI-TOD datasets. Compared with other state-of-the-art methods, our method shows great potential in small object detection from drones.},
 author = {Yang, Yuchuan and Dai, Jiahui and Wang, Yong and Chen, Yafei},
 doi = {10.1109/LSP.2025.3553426},
 issn = {1558-2361},
 journal = {IEEE Signal Processing Letters},
 keyword = {Object detection;Signal processing algorithms;Feature extraction;Transformers;Training;Real-time systems;Accuracy;Decoding;Convolution;Artificial intelligence;Feature fusion;RT-DETRv2;small object detection;VisDrone},
 month = {},
 number = {},
 pages = {1570-1574},
 title = {FM-RTDETR: Small Object Detection Algorithm Based on Enhanced Feature Fusion With Mamba},
 volume = {32},
 year = {2025}
}
