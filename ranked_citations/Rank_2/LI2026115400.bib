@article{LI2026115400,
 abstract = {To investigate the seismic behavior of precast beam-column joints with stainless steel bars, three types of specimens were designed and fabricated: a cast-in-place joint incorporating stainless steel bars and ordinary concrete (XNS-1), a prefabricated joint incorporating stainless steel bars and ordinary concrete (ZNS-2), and a prefabricated joint incorporating stainless steel bars and UHPC (ZUS-3). The test results under low-cycle reversed loading demonstrated the superior performance of the ZUS-3 specimen, with average peak loads 46.09% and 47.75% higher than those of the XNS-1 and ZNS-2 specimens, respectively, and a ductility coefficient of 1.65. The enhanced performance is attributed to the crack-bridging effect of steel fibers in the UHPC, which mitigated stiffness degradation and improved energy dissipation. A finite element model corresponding to the tested joint was developed using ABAQUS software. The comparison results indicate that the simulated hysteresis curves exhibit good agreement with the experimental data. Based on the experimental data, a theoretical model was developed to predict the shear strength of the joint core. The model's predictions align closely with the experimental data and demonstrate improved accuracy over existing design methods. The proposed joint design, integrating stainless steel bars with a cast-in-place UHPC core, adheres to the strong joint-weak member principle and provides a durable solution for prefabricated structures in corrosive environments, effectively merging advanced materials with practical construction techniques.},
 author = {Haiyun Li and Yu Chen and Zhongzheng Guan and Zicong Dai and Jing Wang},
 doi = {https://doi.org/10.1016/j.jobe.2026.115400},
 issn = {2352-7102},
 journal = {Journal of Building Engineering},
 keyword = {UHPC, Stainless steel bars, Prefabricated beam-column joints, Shear capacity, Seismic performance},
 pages = {115400},
 title = {Experimental study on the seismic performance of prefabricated beam-column joints with stainless steel rebars and UHPC},
 url = {https://www.sciencedirect.com/science/article/pii/S2352710226002214},
 volume = {120},
 year = {2026}
}
